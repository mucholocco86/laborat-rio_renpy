# game/scripts/c27/c27.rpy:991
translate german c27s001_EmmVisit_a62ce474:

    # mc "*Risa* Todo el mundo lo asocia menos tú."
    mc "*Gelächter* Alle verbinden es damit, außer dir."

# game/scripts/c27/c27.rpy:995
translate german c27s001_EmmVisit_0fc72b29:

    # emm "No vas a conseguir ponerme de mal humor. ¡Voy a tener un estudio de fotografía en dos días!"
    emm "Du wirst mir nicht die Laune verderben. In zwei Tagen habe ich mein Fotostudio!"

# game/scripts/c27/c27.rpy:996
translate german c27s001_EmmVisit_5b48ef73:

    # mc "Tienes que dejar que la pintura se seque antes de montarlo todo, [emm]."
    mc "Sie müssen die Farbe trocknen lassen, bevor Sie alles zusammenbauen, [emm]."

# game/scripts/c27/c27.rpy:997
translate german c27s001_EmmVisit_ca53a091:

    # emm "Bueno, pues en tres días. Hasta luego, [mc]."
    emm "Okay, dann in drei Tagen. Bis später, [mc]."

# game/scripts/c27/c27.rpy:999
translate german c27s001_EmmVisit_68457195:

    # mc "Hasta luego, [emm]."
    mc "Bis später, [emm]."

# game/scripts/c27/c27.rpy:1003
translate german c27s002_AmaSimSamJam_72562f88:

    # "Mientras tanto, en el piso de los Washington..."
    "Währenddessen auf dem Spielfeld der Washingtons..."

# game/scripts/c27/c27.rpy:1005
translate german c27s002_AmaSimSamJam_6092ea65:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c27/c27.rpy:1006
translate german c27s002_AmaSimSamJam_96c22e11:

    # sam "Ya voy..."
    sam "Ich komme..."

# game/scripts/c27/c27.rpy:1009
translate german c27s002_AmaSimSamJam_72f19745:

    # ama "Buenos días, Sra. Washington. ¿Está la Srta. Washington en casa?"
    ama "Guten Morgen, Mrs. Washington. Ist Miss Washington zu Hause?"

# game/scripts/c27/c27.rpy:1011
translate german c27s002_AmaSimSamJam_b41bd84a:

    # sam "Hola, [ama]. Sí, [sim] está en casa, pasa."
    sam "Hallo, [ama]. Ja, [sim] ist zu Hause, komm herein."

# game/scripts/c27/c27.rpy:1013
translate german c27s002_AmaSimSamJam_4782f10c:

    # ama "Puede llamarme Srta. Gilford..."
    ama "Sie können mich Miss Gilford nennen..."

# game/scripts/c27/c27.rpy:1015
translate german c27s002_AmaSimSamJam_eefbf031:

    # sam "¿A qué vienen tantas formalidades? ¿Pasa algo?"
    sam "Warum all die Formalitäten? Stimmt etwas nicht?"

# game/scripts/c27/c27.rpy:1017
translate german c27s002_AmaSimSamJam_cfcb1c2b:

    # ama "Hoy vengo en... misión de trabajo..."
    ama "Heute bin ich hier im Rahmen einer Arbeitsmission..."

# game/scripts/c27/c27.rpy:1018
translate german c27s002_AmaSimSamJam_5dd29f13:

    # ama "No sé cómo se hace esto. Creo que lo de los apellidos es más... no sé... oficial."
    ama "Ich weiß nicht, wie das genau gemacht wird. Ich glaube, die Sache mit dem Nachnamen ist... ich weiß nicht... offizieller."

# game/scripts/c27/c27.rpy:1020
translate german c27s002_AmaSimSamJam_c21bea45:

    # sam "*Risa* Si alguna vez tienes que venir al hospital, Dios no lo quiera, y me llamas Enfermera Washington, te pondré un enema de ortigas."
    sam "*Gelächter* Falls Sie jemals ins Krankenhaus kommen müssen, Gott bewahre, und mich Schwester Washington nennen, verabreiche ich Ihnen einen Brennnessel-Einlauf."

# game/scripts/c27/c27.rpy:1021
translate german c27s002_AmaSimSamJam_5da0f725:

    # sam "Que sea oficial no quiere decir que nos tengamos que tratar como desconocidas. Siéntate, por favor."
    sam "Nur weil es offiziell ist, heißt das nicht, dass wir uns wie Fremde behandeln müssen. Bitte nehmen Sie Platz."

# game/scripts/c27/c27.rpy:1023
translate german c27s002_AmaSimSamJam_4951757e:

    # ama "¡Menos mal! Se me estaba haciendo rarísimo llamarte por tu apellido..."
    ama "Gott sei Dank! Es fühlte sich schon wirklich seltsam an, dich mit deinem Nachnamen anzusprechen..."

# game/scripts/c27/c27.rpy:1024
translate german c27s002_AmaSimSamJam_898664cf:

    # ama "¿Puedes avisar a [sim], por favor?"
    ama "Könnten Sie bitte [sim] benachrichtigen?"

# game/scripts/c27/c27.rpy:1026
translate german c27s002_AmaSimSamJam_e4bf4017:

    # sim "¿Qué pasa [ama]? ¿Por qué estás tan elegante? ¿Vas a alguna parte?"
    sim "Was gibt's, [ama]? Warum bist du so schick angezogen? Gehst du irgendwohin?"

# game/scripts/c27/c27.rpy:1027
translate german c27s002_AmaSimSamJam_22c68fe0:

    # sam "Viene en misión de trabajo. Creo que ese 'alguna parte' es aquí. Siéntate."
    sam "Er ist beruflich hier. Ich glaube, dieses „Irgendwo“ ist hier. Setzen Sie sich."

# game/scripts/c27/c27.rpy:1029
translate german c27s002_AmaSimSamJam_dd943f91:

    # ama "Bueno, creo que esto se me da muy mal..."
    ama "Tja, ich glaube, ich bin darin wirklich schlecht..."

# game/scripts/c27/c27.rpy:1030
translate german c27s002_AmaSimSamJam_81764b8f:

    # ama "Quería entregarte estos papeles, [sim]. Sólo tienes que firmarlos en la última hoja."
    ama "Ich wollte Ihnen diese Unterlagen geben, [sim]. Sie müssen sie nur noch auf der letzten Seite unterschreiben."

# game/scripts/c27/c27.rpy:1032
translate german c27s002_AmaSimSamJam_1cc80c8a:

    # sim "¿Qué es esto?"
    sim "Was ist das?"

# game/scripts/c27/c27.rpy:1034
translate german c27s002_AmaSimSamJam_7d2f2646:

    # sim "¿Qué? ¿Una beca? ¿Para la universidad?"
    sim "Was? Ein Stipendium? Für die Universität?"

# game/scripts/c27/c27.rpy:1035
translate german c27s002_AmaSimSamJam_9d20ceba:

    # sam "¿Qué? ¿Esto ha sido idea de [mc]? Ayer en el super le dije que no aceptábamos caridad."
    sam "Was? War das [mc]s Idee? Ich habe ihm gestern im Supermarkt gesagt, dass wir keine Spenden annehmen."

# game/scripts/c27/c27.rpy:1037
translate german c27s002_AmaSimSamJam_d17cab04:

    # ama "Bueno, [mc] firmó esos papeles hace unos días. No creo que vuestra conversación de ayer haya tenido nada que ver."
    ama "Nun, [mc] hat diese Papiere vor ein paar Tagen unterschrieben. Ich glaube nicht, dass Ihr gestriges Gespräch damit etwas zu tun hatte."

# game/scripts/c27/c27.rpy:1038
translate german c27s002_AmaSimSamJam_568d7891:

    # ama "Si lo firmas, puedo ir a la universidad a oficializar tu matrícula. Vamos un poco justos de tiempo."
    ama "Wenn Sie unterschreiben, kann ich Sie an der Universität offiziell immatrikulieren. Wir haben etwas wenig Zeit."

# game/scripts/c27/c27.rpy:1040
translate german c27s002_AmaSimSamJam_5bb3075d:

    # sim "¡No puedo aceptar esto! No lo merezco y no vamos a aceptar caridad, como ha dicho mi madre."
    sim "Das kann ich nicht akzeptieren! Ich verdiene das nicht, und wir werden keine Almosen annehmen, wie meine Mutter schon sagte."

# game/scripts/c27/c27.rpy:1042
translate german c27s002_AmaSimSamJam_81ba66f6:

    # ama "Yo no lo considero caridad. NTR ha creado una beca para la que eres la mejor candidata, con lo que no es como si [mc] estuviera pagando tu matriculación."
    ama "Ich sehe das nicht als Wohltätigkeit an. NTR hat ein Stipendium ins Leben gerufen, für das du der beste Kandidat bist, es ist also nicht so, als würden sie deine Studiengebühren übernehmen."

# game/scripts/c27/c27.rpy:1044
translate german c27s002_AmaSimSamJam_1a288648:

    # sim "¡Seguro que hay candidatas mejores! ¡Yo ya no puedo competir!"
    sim "Es gibt definitiv bessere Kandidaten! Ich kann nicht mehr mithalten!"

# game/scripts/c27/c27.rpy:1046
translate german c27s002_AmaSimSamJam_062caa19:

    # ama "En el tiempo que he tenido para evaluar a todas las candidatas no he encontrado a nadie mejor."
    ama "In der mir zur Verfügung stehenden Zeit, alle Kandidaten zu beurteilen, habe ich niemanden Besseren gefunden."

# game/scripts/c27/c27.rpy:1047
translate german c27s002_AmaSimSamJam_d6f1a6f5:

    # ama "Y la beca es para que estudies Ciencias del Deporte, no para que nades. Para que te conviertas en entrenadora."
    ama "Das Stipendium ist für ein Sportwissenschaftsstudium gedacht, nicht fürs Schwimmen. Es soll Sie zum Trainer ausbilden."

# game/scripts/c27/c27.rpy:1049
translate german c27s002_AmaSimSamJam_0ec6aa72:

    # sam "¿Cuándo te encargó [mc] que hicieras esto, [ama]?"
    sam "Wann hat [mc] dich dazu aufgefordert, [ama]?"

# game/scripts/c27/c27.rpy:1051
translate german c27s002_AmaSimSamJam_44b66365:

    # ama "[mc] firmó los papeles el Sábado y..."
    ama "[mc] unterzeichnete die Papiere am Samstag und..."

# game/scripts/c27/c27.rpy:1053
translate german c27s002_AmaSimSamJam_0fb2f8cd:

    # sam "No te he preguntado cuándo lo firmó. Te estoy preguntando cuándo te encargó que estudiaras la creación de la beca."
    sam "Ich habe Sie nicht gefragt, wann er es unterzeichnet hat. Ich frage Sie, wann er Sie mit der Untersuchung der Entstehung des Stipendiums beauftragt hat."

# game/scripts/c27/c27.rpy:1054
translate german c27s002_AmaSimSamJam_768dcbc5:

    # sam "Porque te lo encargó él, ¿no? ¿O ha sido idea tuya? ¿O de alguien más?"
    sam "Weil er dich darum gebeten hat, richtig? Oder war es deine Idee? Oder die von jemand anderem?"

# game/scripts/c27/c27.rpy:1056
translate german c27s002_AmaSimSamJam_57dbe55f:

    # ama "Bueno... Como CEO de NTR, me lo encargó él en cuanto firmó los papeles y..."
    ama "Nun ja... Als CEO von NTR hat er mir die Verantwortung übertragen, sobald er die Papiere unterzeichnet hatte und..."

# game/scripts/c27/c27.rpy:1058
translate german c27s002_AmaSimSamJam_06fc8dc9:

    # sim "Pero esos papeles... ¿los redactó él o se los entregaste tú? ¿O se los entregó alguna otra persona?"
    sim "Aber diese Papiere... hat er sie selbst geschrieben oder haben Sie sie ihm gegeben? Oder hat sie ihm jemand anderes gegeben?"

# game/scripts/c27/c27.rpy:1060
translate german c27s002_AmaSimSamJam_884f0e9f:

    # ama "¿Qué más da quién redactara los requisitos de la beca? Lo importante es que lo firmes."
    ama "Was spielt es für eine Rolle, wer die Stipendienbedingungen verfasst hat? Wichtig ist nur, dass Sie sie unterschreiben."

# game/scripts/c27/c27.rpy:1062
translate german c27s002_AmaSimSamJam_6c1250ef:

    # sam "Está claro que no fue idea de [mc]. Si lo fuera, ella lo habría dicho sin dar tantos rodeos."
    sam "Es ist klar, dass es nicht C4s Idee war. Wäre es ihre gewesen, hätte sie das ohne Umschweife gesagt."

# game/scripts/c27/c27.rpy:1063
translate german c27s002_AmaSimSamJam_7c9c4d16:

    # sam "Apostaría algo a que 'alguien' escuchó tu conversación con [deb.nick] y [mc] sobre entrenar y sobre que hubieras querido estudiar educación deportiva."
    sam "Ich wette, irgendjemand hat euer Gespräch mit [deb.nick] und [mc] über das Training und den Wunsch, Sportpädagogik zu studieren, mitgehört."

# game/scripts/c27/c27.rpy:1065
translate german c27s002_AmaSimSamJam_d36f86f0:

    # sim "Tienes razón. Allí sólo estábamos [deb.nick], [mc], y yo. [deb.nick], pese a que tiene el dinero para hacerlo, no haría una beca a nombre de NTR."
    sim "Du hast recht. Es waren nur ich, F3 und C4 da. F3, obwohl er das Geld dazu hätte, wollte kein Stipendium in NTRs Namen vergeben."

# game/scripts/c27/c27.rpy:1066
translate german c27s002_AmaSimSamJam_b587d91b:

    # sim "Y [mc], como acabas de decir, está claro que no lo ha hecho."
    sim "Und [mc], wie Sie gerade gesagt haben, ist es klar, dass er es nicht getan hat."

# game/scripts/c27/c27.rpy:1068
translate german c27s002_AmaSimSamJam_a1c41572:

    # sim "¿O de [eva]?" (multiple=2)
    sim "Oder [eva]?" (multiple=2)

# game/scripts/c27/c27.rpy:1069
translate german c27s002_AmaSimSamJam_476bab9b:

    # sam "¿Ha sido idea tuya?" (multiple=2)
    sam "War das Ihre Idee?" (multiple=2)

# game/scripts/c27/c27.rpy:1071
translate german c27s002_AmaSimSamJam_8b47d22e:

    # sam "Si hubiera sido de [eva], sería ella la que estuviera aquí."
    sam "Wenn es [eva] gewesen wäre, wäre sie diejenige, die hier ist."

# game/scripts/c27/c27.rpy:1072
translate german c27s002_AmaSimSamJam_a796d1ba:

    # sim "Tienes razón. Además, [eva] no tendría tantos reparos en aceptar que la idea ha sido suya."
    sim "Du hast Recht. Außerdem hätte [eva] wohl keine großen Bedenken, zuzugeben, dass die Idee von ihm stammte."

# game/scripts/c27/c27.rpy:1073
translate german c27s002_AmaSimSamJam_1a69b8d9:

    # sam "Ni en aceptar el agradecimiento por haber tenido la idea."
    sam "Auch nicht, indem man Dank für die Idee annimmt."

# game/scripts/c27/c27.rpy:1075
translate german c27s002_AmaSimSamJam_e6babcf2:

    # ama "¿Agradecimiento? ¿No estáis enfadadas porque le presentara los papeles a [mc]?"
    ama "Dankbarkeit? Bist du nicht wütend, dass er die Unterlagen [mc] vorgelegt hat?"

# game/scripts/c27/c27.rpy:1077
translate german c27s002_AmaSimSamJam_1fb92d4a:

    # sim "¡Has caído en la trampa!" (multiple=2)
    sim "Du bist in die Falle getappt!" (multiple=2)

# game/scripts/c27/c27.rpy:1078
translate german c27s002_AmaSimSamJam_25c95a6b:

    # sam "¡Lo sabía!" (multiple=2)
    sam "Ich wusste es!" (multiple=2)

# game/scripts/c27/c27.rpy:1080
translate german c27s002_AmaSimSamJam_db7734ff:

    # sim "¡Se nota que no te has criado con mi madre! Ni Jamaal ni yo caemos en esas trampas desde hace años."
    sim "Offensichtlich wurdest du nicht von meiner Mutter erzogen! Weder Jamaal noch ich sind seit Jahren auf solche Fallen hereingefallen."

# game/scripts/c27/c27.rpy:1081
translate german c27s002_AmaSimSamJam_9cfb1054:

    # sim "Pero ahora entiendo por qué a mi madre le gustaba tanto tendérnoslas."
    sim "Aber jetzt verstehe ich, warum meine Mutter sie uns so gerne gegeben hat."

# game/scripts/c27/c27.rpy:1083
translate german c27s002_AmaSimSamJam_a5a08d73:

    # ama "Entonces... ¿vas a firmar los papeles ahora que sabéis que no es cosa de [mc], [sim]?"
    ama "Also... werden Sie die Papiere jetzt unterschreiben, da Sie wissen, dass es nicht um [mc], [sim] geht?"

# game/scripts/c27/c27.rpy:1085
translate german c27s002_AmaSimSamJam_a066af1d:

    # sim "¡No! ¡No lo puedo aceptar!" (multiple=2)
    sim "Nein! Das kann ich nicht akzeptieren!" (multiple=2)

# game/scripts/c27/c27.rpy:1086
translate german c27s002_AmaSimSamJam_83a2f811:

    # sam "¡Ya te hemos dicho que no aceptamos caridad!" (multiple=2)
    sam "Wir haben Ihnen bereits mitgeteilt, dass wir keine Spenden annehmen!" (multiple=2)

# game/scripts/c27/c27.rpy:1088
translate german c27s002_AmaSimSamJam_8f2353c6:

    # jam "¿Quieres firmar los putos papeles de una vez, [sim]?"
    jam "Willst du die verdammten Papiere endlich unterschreiben, [sim]?"

# game/scripts/c27/c27.rpy:1089
translate german c27s002_AmaSimSamJam_1a5db2cb:

    # jam "Y ya sé que tengo que poner un dólar en el bote de los tacos, pero es el dólar que menos me va a doler poner en mi vida."
    jam "Und ich weiß, ich muss einen Dollar in das Taco-Glas werfen, aber es ist der Dollar, der mir im Leben am wenigsten weh tun wird."

# game/scripts/c27/c27.rpy:1091
translate german c27s002_AmaSimSamJam_9500304c:

    # jam "[ama] se ha molestado en crear una beca para ti y te pones... os ponéis las dos... hechas una furia."
    jam "[ama] hat sich die Mühe gemacht, ein Stipendium für Sie zu erstellen, und Sie beide sind wütend."

# game/scripts/c27/c27.rpy:1092
translate german c27s002_AmaSimSamJam_9be860db:

    # jam "Una cosa es no aceptar caridad, y otra distinta es no aceptar favores."
    jam "Wohltätigkeit abzulehnen ist eine Sache, Gefälligkeiten abzulehnen eine andere."

# game/scripts/c27/c27.rpy:1094
translate german c27s002_AmaSimSamJam_bdae2aa2:

    # jam "Por cierto, hola, [ama]. Perdona a las irracionales Washington. Yo soy la parte que piensa. Esa beca, ¿te cuesta dinero a ti?"
    jam "Übrigens, hallo [ama]. Verzeih mir die irrationalen Washingtons. Ich bin der Denker. Kostet dich das Stipendium etwas?"

# game/scripts/c27/c27.rpy:1096
translate german c27s002_AmaSimSamJam_037995c1:

    # ama "Hola, Jamaal. No, es dinero de NTR... Y tiene retorno de impuestos."
    ama "Hallo Jamaal. Nein, das ist NTR-Geld... Und es ist versteuert."

# game/scripts/c27/c27.rpy:1098
translate german c27s002_AmaSimSamJam_79fd1ecd:

    # jam "¿Veis? ¡No es una maldita obra de caridad! Sí, otro dólar. Es una empresa haciendo algo que le beneficia a largo plazo."
    jam "Seht ihr? Das ist keine blöde Wohltätigkeitsveranstaltung! Ja, wieder ein Dollar. Aber es ist ein Unternehmen, das etwas tut, das ihm langfristig nützt."

# game/scripts/c27/c27.rpy:1099
translate german c27s002_AmaSimSamJam_5f37ebc4:

    # jam "¿La estaríais rechazando si fuese MocoSoft o FAPple en vez de NTR? Seguro que no pero, como es la empresa de [mc], hay que poner pegas, ¿no?"
    jam "Würden Sie es ablehnen, wenn es sich um MocoSoft oder FAPple anstelle von NTR handeln würde? Sicherlich nicht, aber da es sich um die Firma von [mc] handelt, müssen wir ja etwas auszusetzen haben, nicht wahr?"

# game/scripts/c27/c27.rpy:1100
translate german c27s002_AmaSimSamJam_7a2b6df3:

    # jam "¡Ni siquiera le habéis dado las gracias a [ama]!"
    jam "Du hast dich noch nicht einmal bei [ama] bedankt!"

# game/scripts/c27/c27.rpy:1102
translate german c27s002_AmaSimSamJam_91f72a49:

    # sam "Tiene un poco de razón, ¿no? ¿Estamos siendo un poco irracionales?"
    sam "Er hat recht, nicht wahr? Sind wir vielleicht etwas irrational?"

# game/scripts/c27/c27.rpy:1103
translate german c27s002_AmaSimSamJam_d5fa0ea9:

    # sim "Es posible. ¡Mielda, no me gusta darle la razón a Jamaal!"
    sim "Das ist möglich. Verdammt, ich stimme Jamaal ungern zu!"

# game/scripts/c27/c27.rpy:1105
translate german c27s002_AmaSimSamJam_ea91ad77:

    # jam "Entonces todo arreglado. Vuelvo a mi habitación. He dejado a medias el chat con un cliente."
    jam "Alles ist geklärt. Ich gehe zurück in mein Zimmer. Mein Gespräch mit einem Kunden habe ich nicht beendet."

# game/scripts/c27/c27.rpy:1107
translate german c27s002_AmaSimSamJam_3949f53b:

    # sim "Toma, aquí están los papeles firmados. Y gracias."
    sim "Hier haben Sie die unterschriebenen Dokumente. Vielen Dank."

# game/scripts/c27/c27.rpy:1108
translate german c27s002_AmaSimSamJam_fb9896bb:

    # sim "Pero, ¿cómo lo sabías? Nunca hemos hablado de ello..."
    sim "Aber woher wusstest du das? Wir haben nie darüber gesprochen..."

# game/scripts/c27/c27.rpy:1110
translate german c27s002_AmaSimSamJam_56ba5122:

    # ama "El otro día, cuando estabas en la piscina con [mc] y [deb.nick]..."
    ama "Neulich, als du mit [mc] und [deb.nick] am Pool warst..."

# game/scripts/c27/c27.rpy:1112
translate german c27s002_AmaSimSamJam_c5c40574:

    # "Después de dar las explicaciones de cómo surgió el plan de la beca..."
    "Nachdem ich erklärt hatte, wie das Stipendienprogramm zustande gekommen war..."

# game/scripts/c27/c27.rpy:1113
translate german c27s002_AmaSimSamJam_c1b46714:

    # sim "Gracias, [ama]. No sé si hubiera podido estudiar sin lo que acabas de hacer."
    sim "Vielen Dank, [ama]. Ich weiß nicht, ob ich ohne Ihre Hilfe hätte lernen können."

# game/scripts/c27/c27.rpy:1114
translate german c27s002_AmaSimSamJam_0d63803d:

    # ama "No es sólo mérito mío. [mc] estuvo de acuerdo con la idea y fue quien dio la orden ejecutiva."
    ama "Das ist nicht nur mein Verdienst. [mc] stimmte der Idee zu und war es, der den Erlass erteilte."

# game/scripts/c27/c27.rpy:1115
translate german c27s002_AmaSimSamJam_1a37f0cd:

    # sim "Seguramente no lo hubiera hecho si no hubiera sido por ti. Sabe cómo nos sentimos cuando se nos ofrece... caridad."
    sim "Ich hätte es wahrscheinlich nicht getan, wenn du nicht gewesen wärst. Du weißt ja, wie wir uns fühlen, wenn uns... Almosen angeboten werden."

# game/scripts/c27/c27.rpy:1116
translate german c27s002_AmaSimSamJam_bc5bac69:

    # ama "Yo también lo sé, pero esto no es caridad. Son negocios. Y un favor a una hermana."
    ama "Das weiß ich auch, aber das ist keine Wohltätigkeit. Es ist ein Geschäft. Und ein Gefallen für eine Schwester."

# game/scripts/c27/c27.rpy:1118
translate german c27s002_AmaSimSamJam_12319058:

    # sam "Disculpa por cómo nos hemos comportado. Lo de ser irracional lo llevamos en la sangre."
    sam "Wir entschuldigen uns für unser Verhalten. Unvernünftig zu sein, liegt uns im Blut."

# game/scripts/c27/c27.rpy:1119
translate german c27s002_AmaSimSamJam_f2fb2f00:

    # ama "No hay nada por lo que disculparse."
    ama "Es gibt keinen Grund, sich zu entschuldigen."

# game/scripts/c27/c27.rpy:1120
translate german c27s002_AmaSimSamJam_a63e40e4:

    # sam "¿Has comido ya? ¿Quieres quedarte a comer?"
    sam "Hast du schon gegessen? Möchtest du zum Mittagessen bleiben?"

# game/scripts/c27/c27.rpy:1121
translate german c27s002_AmaSimSamJam_13f2237f:

    # ama "Me encantaría."
    ama "Ich würde gerne."

# game/scripts/c27/c27.rpy:1122
translate german c27s002_AmaSimSamJam_3e16133e:

    # sam "He hecho pierogi para nosotros tres, podemos dividirlos y hacer una ensalada más grande."
    sam "Ich habe Piroggen für uns drei gemacht; wir können sie teilen und einen größeren Salat daraus machen."

# game/scripts/c27/c27.rpy:1123
translate german c27s002_AmaSimSamJam_40ca604f:

    # jam "*Desde su habitación* ¡Noooo!"
    jam "*Aus ihrem Zimmer* Nein!"

# game/scripts/c27/c27.rpy:1132
translate german c27s002_AaronVC_05f06837:

    # "Un par de minutos después de que [emm] se vaya..."
    "Ein paar Minuten nachdem [emm] gegangen ist..."

# game/scripts/c27/c27.rpy:1134
translate german c27s002_AaronVC_f51bd432:

    # "Nada más entrar en tu habitación después de comer..."
    "Sobald Sie nach dem Essen Ihr Zimmer betreten..."

# game/scripts/c27/c27.rpy:1136
translate german c27s002_AaronVC_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c27/c27.rpy:1137
translate german c27s002_AaronVC_307848b4:

    # mcp "(¿Videoconferencia con Aaron? No teníamos nada programado para hoy...)"
    mcp "(Eine Videokonferenz mit Aaron? Wir hatten heute nichts geplant...)"

# game/scripts/c27/c27.rpy:1141
translate german c27s002_AaronVC_12e8a860:

    # mc "Hola, Aaron. ¿Puedo ayudarte en algo?"
    mc "Hallo Aaron. Kann ich dir irgendwie helfen?"

# game/scripts/c27/c27.rpy:1142
translate german c27s002_AaronVC_b015eb34:

    # aar "Bueno, llamaba para un par de cosas. La primera es que quiero asegurarme de que habéis recibido el dinero."
    aar "Ich rief eigentlich wegen zweier Dinge an. Zunächst wollte ich sichergehen, dass Sie das Geld erhalten haben."

# game/scripts/c27/c27.rpy:1143
translate german c27s002_AaronVC_66a28bc0:

    # mc "Sí, fue una sorpresa. Lo esperábamos hacia final de año."
    mc "Ja, es war eine Überraschung. Wir hatten es eher gegen Ende des Jahres erwartet."

# game/scripts/c27/c27.rpy:1145
translate german c27s002_AaronVC_eb8b7b59:

    # aar "Bueno, sobre eso... He descubierto que Daniels maquillaba los libros de contabilidad. [mar] y [nor] sólo estaban recibiendo la mitad de lo que les pertocaba."
    aar "Nun ja, dazu … Ich habe herausgefunden, dass Daniels die Bücher gefälscht hat. [mar] und [nor] erhielten nur die Hälfte dessen, was ihnen zustand."

# game/scripts/c27/c27.rpy:1146
translate german c27s002_AaronVC_f59c8bb0:

    # aar "Una de las transferencias era desviada como gastos. Se quedaba una parte. Richards lo hacía antes que él, con lo que..."
    aar "Eine der Überweisungen wurde als Spesen verbucht. Er behielt einen Teil davon. Richards hatte das vor ihm auch so gemacht, also..."

# game/scripts/c27/c27.rpy:1147
translate german c27s002_AaronVC_758f2346:

    # mc "Le debemos un montón de dinero a [mar] y a [nor]. 20 años a $83,000... alrededor de $1,600,000."
    mc "Wir schulden [mar] und [nor] eine Menge Geld. 20 Jahre à 83.000 $... rund 1.600.000 $."

# game/scripts/c27/c27.rpy:1149
translate german c27s002_AaronVC_71b1055b:

    # aar "Bastante menos. Los primeros años era muy poco dinero, y después fue creciendo. Pero sí, NTR les debe algo menos de $900,000 a cada una."
    aar "Deutlich weniger. In den ersten Jahren war es nur sehr wenig Geld, dann stieg es an. Aber ja, NTR schuldet ihnen jeweils etwas weniger als 900.000 Dollar."

# game/scripts/c27/c27.rpy:1150
translate german c27s002_AaronVC_bbfdd42e:

    # aar "Es algo que tendremos que solucionar, pero habrá tiempo para eso cuando estés aquí."
    aar "Das müssen wir noch klären, aber dafür wird Zeit sein, wenn Sie hier sind."

# game/scripts/c27/c27.rpy:1152
translate german c27s002_AaronVC_79decbe0:

    # aar "¿Cómo ves tu sueldo de CEO? Creo que no habíamos hablado de ello en ningún momento."
    aar "Wie sehen Sie Ihr Gehalt als CEO? Ich glaube nicht, dass wir das jemals besprochen haben."

# game/scripts/c27/c27.rpy:1153
translate german c27s002_AaronVC_83eaadaa:

    # mc "Me sorprendió la cantidad. No esperaba tanto."
    mc "Ich war von der Summe überrascht. Ich hatte nicht mit so viel gerechnet."

# game/scripts/c27/c27.rpy:1154
translate german c27s002_AaronVC_a26866a8:

    # aar "Era lo que cobraba Daniels, con lo que es difícil de justificar bajar tu sueldo."
    aar "Das war Daniels' Gehalt, daher ist es schwer zu rechtfertigen, dass du dein Gehalt senkst."

# game/scripts/c27/c27.rpy:1156
translate german c27s002_AaronVC_a6df5df9:

    # aar "Sobre el tema de los sueldos... tengo que pedirte una cosa..."
    aar "Was die Gehaltsfrage betrifft... ich muss Sie etwas fragen..."

# game/scripts/c27/c27.rpy:1157
translate german c27s002_AaronVC_e42e4e08:

    # mc "Dime. Lo que necesites. Supongo que ahora que tienes el cargo de Director de Operaciones, te habrás subido el sueldo, ¿no?"
    mc "Sagen Sie mir, was immer Sie brauchen. Ich nehme an, jetzt, wo Sie den Titel „Direktor für operative Angelegenheiten“ tragen, haben Sie sich selbst eine Gehaltserhöhung genehmigt, nicht wahr?"

# game/scripts/c27/c27.rpy:1159
translate german c27s002_AaronVC_9aa7c0c5:

    # aar "Bueno, no es que me haya subido el sueldo. He cobrado un sueldo por primera vez en mi vida."
    aar "Nun ja, es geht nicht darum, dass ich eine Gehaltserhöhung bekommen habe. Ich habe zum ersten Mal in meinem Leben ein Gehalt erhalten."

# game/scripts/c27/c27.rpy:1160
translate german c27s002_AaronVC_4de36aed:

    # mc "¿Qué? ¿No cobrabas? ¿Las chicas tampoco?"
    mc "Was? Du wurdest nicht bezahlt? Die Mädchen auch nicht?"

# game/scripts/c27/c27.rpy:1162
translate german c27s002_AaronVC_1b997de3:

    # aar "No. Ninguno de los operativos cobrábamos. Nuestro 'pago' era vivir en la base, alimentación, entrenamiento..."
    aar "Nein. Keiner von uns im Einsatzteam wurde bezahlt. Unsere „Bezahlung“ bestand aus Unterkunft auf dem Stützpunkt, Verpflegung und Ausbildung."

# game/scripts/c27/c27.rpy:1163
translate german c27s002_AaronVC_a8247bb1:

    # aar "Tampoco es que hubiéramos tenido dónde gastarlos. Imagínate 16 clones de la Serie G entrando a la vez en un bar de Oranjestad." id c27s002_AaronVC_a8247bb1
    aar "Wir hätten ja eh keinen Ort gehabt, wo wir sie ausgeben konnten. Stellt euch vor, 16 G-Series-Klone betreten gleichzeitig eine Bar in Oranjestad." id c27s002_AaronVC_a8247bb1

# game/scripts/c27/c27.rpy:1164
translate german c27s002_AaronVC_d56b9c53:

    # mc "Lo entiendo."
    mc "Ich verstehe."

# game/scripts/c27/c27.rpy:1166
translate german c27s002_AaronVC_9493f119:

    # aar "Por eso quiero pedirte el favor del que te hablaba. Las chicas nunca han tenido dinero propio. Ahora tienen más de $50,000 cada una." id c27s002_AaronVC_9493f119
    aar "Deshalb möchte ich Sie um den erwähnten Gefallen bitten. Die Mädchen hatten vorher nie eigenes Geld. Jetzt besitzt jede von ihnen über 50.000 Dollar." id c27s002_AaronVC_9493f119

# game/scripts/c27/c27.rpy:1167
translate german c27s002_AaronVC_6f6582e4:

    # aar "Dudo que [ama] vaya a hacer alguna locura, pero... si pudieras vigilar un poco a [eva], me harías... nos harías un favor a todos."
    aar "Ich bezweifle, dass [ama] irgendetwas Verrücktes anstellen wird, aber... wenn du [eva] ein wenig im Auge behalten könntest, würdest du mir... uns allen einen Gefallen tun."

# game/scripts/c27/c27.rpy:1168
translate german c27s002_AaronVC_43923d2e:

    # mc "Ningún problema. Creo que puedo convencer a [mar] y a [nor] para que les den una charla sobre el dinero."
    mc "Kein Problem. Ich denke, ich kann [mar] und [nor] dazu bringen, mit ihnen über Geld zu reden."

# game/scripts/c27/c27.rpy:1169
translate german c27s002_AaronVC_cc7d56b7:

    # mc "Les dará la oportunidad de pasar más tiempo con ellas a solas y ejercer de madres."
    mc "Dadurch erhalten sie die Möglichkeit, mehr Zeit allein mit ihren Kindern zu verbringen und ihrer Mutterrolle nachzugehen."

# game/scripts/c27/c27.rpy:1171
translate german c27s002_AaronVC_4d156b23:

    # aar "Perfecto. Entonces, creo que ahora viene el tema más complicado."
    aar "Perfekt. Ich glaube, jetzt kommt der komplizierteste Teil."

# game/scripts/c27/c27.rpy:1173
translate german c27s002_AaronVC_98fd59ca:

    # aar "Necesitaría hablar con [bet.full]."
    aar "Ich müsste mit [bet.full] sprechen."

# game/scripts/c27/c27.rpy:1174
translate german c27s002_AaronVC_6e0c7c96:

    # mc "¿Con Tía [bet]? ¿Para qué?"
    mc "Bei Tante [bet]? Warum?"

# game/scripts/c27/c27.rpy:1175
translate german c27s002_AaronVC_b3f8879e:

    # aar "Es por un tema médico que..."
    aar "Das hat einen medizinischen Grund..."

# game/scripts/c27/c27.rpy:1176
translate german c27s002_AaronVC_9683bb47:

    # mc "¿Te pasa algo? ¿Estás bien?"
    mc "Ist etwas nicht in Ordnung? Geht es dir gut?"

# game/scripts/c27/c27.rpy:1178
translate german c27s002_AaronVC_254f7d09:

    # aar "No, tranquilo, no es para mí. Hemos perdido al cirujano que teníamos en NTR y..."
    aar "Nein, keine Sorge, das betrifft mich nicht. Wir haben unseren Chirurgen bei NTR verloren und..."

# game/scripts/c27/c27.rpy:1181
translate german c27s002_AaronVC_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c27/c27.rpy:1182
translate german c27s002_AaronVC_2d7ccd4e:

    # mar "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    mar "*Durch die Tür* Ich bin's. Darf ich hereinkommen?"

# game/scripts/c27/c27.rpy:1183
translate german c27s002_AaronVC_2422e723:

    # mc "Sí, pasa. Estoy en una videoconferencia con Aaron."
    mc "Ja, es findet statt. Ich bin gerade in einer Videokonferenz mit Aaron."

# game/scripts/c27/c27.rpy:1185
translate german c27s002_AaronVC_c61f7c69:

    # mar "¿Hola, Aaron? ¿Qué tal todo por Aruba?"
    mar "Hallo Aaron? Wie läuft's in Aruba?"

# game/scripts/c27/c27.rpy:1187
translate german c27s002_AaronVC_d7bc2045:

    # aar "Todo bien, [mar]. Estaba discutiendo unos temas con [mc]."
    aar "Alles in Ordnung, [mar]. Ich habe gerade ein paar Dinge mit [mc] besprochen."

# game/scripts/c27/c27.rpy:1189
translate german c27s002_AaronVC_86e106ad:

    # mar "Entonces os dejo con vuestros asuntos. Lo que venía a decirle a..."
    mar "Ich überlasse Sie nun Ihren Angelegenheiten. Was ich eigentlich sagen wollte…"

# game/scripts/c27/c27.rpy:1191
translate german c27s002_AaronVC_9bb25db6:

    # mar "... [mc]..."
    mar "... [mc]..."

# game/scripts/c27/c27.rpy:1192
translate german c27s002_AaronVC_3f55ac25:

    # mar "... no es..."
    mar "... das ist es nicht..."

# game/scripts/c27/c27.rpy:1193
translate german c27s002_AaronVC_08ad065f:

    # mar "... urgente..."
    mar "... dringend..."

# game/scripts/c27/c27.rpy:1194
translate german c27s002_AaronVC_316010b6:

    # mc "¿Puedes decirle a Tía [bet] que venga, por favor? Aaron quiere hablar con ella."
    mc "Könntest du bitte Tante [bet] bitten, herzukommen? Aaron möchte mit ihr sprechen."

# game/scripts/c27/c27.rpy:1196
translate german c27s002_AaronVC_dd74f574:

    # mar "Sí... Ahora voy... a avisarla... Está en la piscina..."
    mar "Ja... ich werde es ihr jetzt sagen... Sie ist im Pool..."

# game/scripts/c27/c27.rpy:1198
translate german c27s002_AaronVC_eaef52fa:

    # mc "Gracias, Mamá."
    mc "Danke, Mama."

# game/scripts/c27/c27.rpy:1200
translate german c27s002_AaronVC_73d262ed:

    # mc "Gracias, [mar]."
    mc "Vielen Dank, [mar]."

# game/scripts/c27/c27.rpy:1202
translate german c27s002_AaronVC_c8e89903:

    # mc "Si quieres esperamos que llegue Tía [bet] para seguir hablando de lo que necesitas de ella."
    mc "Wenn Sie möchten, können wir warten, bis Tante [bet] eintrifft, damit wir weiter darüber sprechen können, was Sie von ihr benötigen."

# game/scripts/c27/c27.rpy:1203
translate german c27s002_AaronVC_bd5d5f95:

    # mc "Mientras tanto voy pasando la video conferencia al portátil. Será más cómodo."
    mc "Ich verlege die Videokonferenz derweil auf meinen Laptop. Das ist bequemer."

# game/scripts/c27/c27.rpy:1204
translate german c27s002_AaronVC_e7c51356:

    # mc "¿Qué ha pasado con el cirujano?"
    mc "Was geschah mit dem Chirurgen?"

# game/scripts/c27/c27.rpy:1205
translate german c27s002_AaronVC_1b5a9b9a:

    # aar "El cirujano principal era Daniels."
    aar "Der leitende Chirurg war Daniels."

# game/scripts/c27/c27.rpy:1206
translate german c27s002_AaronVC_7f59aec1:

    # mc "Y supongo que ahora no puede trabajar con nosotros, ¿no?"
    mc "Und ich nehme an, er kann jetzt nicht mehr mit uns zusammenarbeiten, oder?"

# game/scripts/c27/c27.rpy:1208
translate german c27s002_AaronVC_a92cc8e6:

    # aar "Es complicado... Aún tenemos que decidir qué vamos a hacer con él. Pero no me fiaría de que me operara, si fuera necesario."
    aar "Es ist kompliziert... Wir müssen noch entscheiden, was wir tun. Aber ich würde ihm nicht zutrauen, mich zu operieren, selbst wenn es nötig wäre."

# game/scripts/c27/c27.rpy:1209
translate german c27s002_AaronVC_d323c6bf:

    # aar "Y sus ayudantes dan el nivel para operaciones más básicas. No para lo que necesitamos ahora mismo."
    aar "Und ihre Assistenten sind in der Lage, einfachere Aufgaben zu übernehmen. Nicht für das, was wir jetzt brauchen."

# game/scripts/c27/c27.rpy:1210
translate german c27s002_AaronVC_95da287a:

    # mc "Sobre Daniels, ¿qué opciones tenemos?"
    mc "Welche Optionen haben wir hinsichtlich Daniels?"

# game/scripts/c27/c27.rpy:1212
translate german c27s002_AaronVC_6de03863:

    # aar "Como te digo, es complicado. No lo podemos entregar a la justicia de Aruba."
    aar "Wie gesagt, es ist kompliziert. Wir können ihn nicht dem arubanischen Justizsystem ausliefern."

# game/scripts/c27/c27.rpy:1213
translate german c27s002_AaronVC_31a5810a:

    # aar "Ha ordenado asesinatos, pero todo saldría a la luz en un juicio público y eso es lo que menos nos conviene."
    aar "Er hat Morde in Auftrag gegeben, aber alles würde in einem öffentlichen Prozess ans Licht kommen, und das ist das Letzte, was wir wollen."

# game/scripts/c27/c27.rpy:1214
translate german c27s002_AaronVC_7539a30f:

    # mc "Lo entiendo. Nos tocará a nosotros impartir justicia, entonces."
    mc "Ich verstehe. Dann liegt es an uns, für Gerechtigkeit zu sorgen."

# game/scripts/c27/c27.rpy:1216
translate german c27s002_AaronVC_0d52c23f:

    # aar "Justicia. Aunque no sea legal. Quiero consultarlo con las chicas cuando estén aquí. No es algo para tratar en una video conferencia."
    aar "Gerechtigkeit. Auch wenn es nicht legal ist. Ich möchte das mit den Mädchen besprechen, wenn sie da sind. Das ist nichts für eine Videokonferenz."

# game/scripts/c27/c27.rpy:1217
translate german c27s002_AaronVC_461bdae7:

    # aar "De hecho, tenerlo 'prisionero' ya es ilegal. No tenemos ningún derecho legal a hacerlo, pero las autoridades de Aruba van a mirar hacia otro lado."
    aar "Ihn gefangen zu halten ist tatsächlich schon illegal. Wir haben kein Recht dazu, aber die arubanischen Behörden werden einfach wegschauen."

# game/scripts/c27/c27.rpy:1218
translate german c27s002_AaronVC_e867c270:

    # mc "Supongo que tan ilegal como asesinarlo..."
    mc "Ich nehme an, es ist genauso illegal wie ihn zu ermorden..."

# game/scripts/c27/c27.rpy:1220
translate german c27s002_AaronVC_62464051:

    # aar "Por eso lo quiero consultar con las chicas. Si por mi fuera, le dispararía en la cabeza ahora mismo, pero ellas también tienen derecho a decidir qué hacer con él."
    aar "Deshalb möchte ich mit den Mädchen darüber reden. Wenn es nach mir ginge, würde ich ihm jetzt in den Kopf schießen, aber sie haben auch das Recht zu entscheiden, was mit ihm geschehen soll."

# game/scripts/c27/c27.rpy:1221
translate german c27s002_AaronVC_1aa76c3f:

    # aar "Sus hermanas murieron por culpa de Daniels, igual que mi hermano. Tienen el mismo derecho a decidir que yo."
    aar "Seine Schwestern starben wegen Daniels, genau wie mein Bruder. Sie haben dasselbe Recht zu entscheiden wie ich."

# game/scripts/c27/c27.rpy:1231
translate german c27s002_AaronVC_7d323a19:

    # mc "Creo que también deberíamos tener derecho a decidir, aunque gracias a vosotros no perdiéramos a nadie."
    mc "Ich glaube, wir sollten auch das Recht haben, zu entscheiden, selbst wenn wir dank Ihnen niemanden verloren haben."

# game/scripts/c27/c27.rpy:1233
translate german c27s002_AaronVC_f90ff87a:

    # aar "Esperaba que dijeras algo así y lo considero lógico."
    aar "Ich hatte erwartet, dass Sie so etwas sagen würden, und ich halte es für logisch."

# game/scripts/c27/c27.rpy:1234
translate german c27s002_AaronVC_d50e5700:

    # aar "Pienso que, cuando estéis los tres aquí, habrá que decidir."
    aar "Ich denke, wenn ihr drei hier seid, müssen wir eine Entscheidung treffen."

# game/scripts/c27/c27.rpy:1237
translate german c27s002_AaronVC_2d094ad0:

    # mc "Creo que es un tema que deberíais decidir vosotros, gracias a vosotros nosotros no perdimos a nadie, y no creo que debamos intervenir en esa situación."
    mc "Ich denke, das ist eine Angelegenheit, die Sie selbst entscheiden sollten; dank Ihnen haben wir niemanden verloren, und ich denke nicht, dass wir in diese Situation eingreifen sollten."

# game/scripts/c27/c27.rpy:1239
translate german c27s002_AaronVC_aab08895:

    # aar "No esperaba que dijeras algo así... Creía que ibas a querer participar en la decisión, aunque te agradezco que lo dejes en nuestras manos."
    aar "Ich hatte nicht erwartet, dass Sie so etwas sagen würden... Ich dachte, Sie würden in die Entscheidung einbezogen werden wollen, obwohl ich es sehr schätze, dass Sie sie uns überlassen."

# game/scripts/c27/c27.rpy:1240
translate german c27s002_AaronVC_4f6ee7d1:

    # aar "Pienso que, cuando estén las dos aquí, habrá que decidir."
    aar "Ich denke, wenn beide hier sind, müssen wir uns entscheiden."

# game/scripts/c27/c27.rpy:1242
translate german c27s002_AaronVC_34d3bc90:

    # mc "Me parece que no van a coincidir las dos allí. [eva] no está preparada para ver a Gavin todavía, con lo que se quedará aquí el primer mes."
    mc "Ich glaube nicht, dass sie beide gleichzeitig da sein werden. Sie ist noch nicht bereit, Gavin zu sehen, deshalb wird sie den ersten Monat hier bleiben."

# game/scripts/c27/c27.rpy:1243
translate german c27s002_AaronVC_7322ce6c:

    # mc "Después rotarán. [ama] volverá a casa y [eva] estará allí conmigo."
    mc "Dann wechseln sie sich ab. [ama] kehrt nach Hause zurück und [eva] wird dort bei mir sein."

# game/scripts/c27/c27.rpy:1245
translate german c27s002_AaronVC_04ee3015:

    # aar "Entonces, durante la rotación. Habrá que hacer que coincidan las dos aquí para tomar esa decisión."
    aar "Während der Rotation müssen wir also sicherstellen, dass die beiden Faktoren übereinstimmen, um diese Entscheidung treffen zu können."

# game/scripts/c27/c27.rpy:1246
translate german c27s002_AaronVC_f5687c30:

    # mc "Por cierto, ¿cómo está Gavin?"
    mc "Wie geht es eigentlich Gavin?"

# game/scripts/c27/c27.rpy:1247
translate german c27s002_AaronVC_cf05b26f:

    # aar "De eso es de lo que quiero hablar con [bet.full]."
    aar "Genau darüber möchte ich mit [bet.full] sprechen."

# game/scripts/c27/c27.rpy:1248
translate german c27s002_AaronVC_4932b211:

    # mc "Oigo pasos en la escalera. Debe ser ella."
    mc "Ich höre Schritte auf der Treppe. Das muss sie sein."

# game/scripts/c27/c27.rpy:1251
translate german c27s002_AaronVC_dd0461ef_1:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c27/c27.rpy:1252
translate german c27s002_AaronVC_76ad3c97:

    # bet "*A través de la puerta* Soy yo. [mar] me ha dicho que querías verme."
    bet "*Durch die Tür* Ich bin's. [mar] hat mir gesagt, du wolltest mich sehen."

# game/scripts/c27/c27.rpy:1253
translate german c27s002_AaronVC_3e917570:

    # mc "Sí, pasa, Tía [bet]."
    mc "Ja, komm herein, Tante [bet]."

# game/scripts/c27/c27.rpy:1255
translate german c27s002_AaronVC_ffd92977:

    # mc "Siéntate. Aaron quiere hablar contigo. Os presento."
    mc "Setzen Sie sich. Aaron möchte mit Ihnen sprechen. Darf ich Sie vorstellen?"

# game/scripts/c27/c27.rpy:1256
translate german c27s002_AaronVC_b705c9da:

    # bet "Encantada de conocerte, Aaron."
    bet "Schön, dich kennenzulernen, Aaron."

# game/scripts/c27/c27.rpy:1258
translate german c27s002_AaronVC_f2636f38:

    # aar "Lo mismo digo, Sra. [bet.full]."
    aar "Ich stimme zu, Frau [bet.full]."

# game/scripts/c27/c27.rpy:1260
translate german c27s002_AaronVC_82ed1e9d:

    # bet "..."
    bet "..."

# game/scripts/c27/c27.rpy:1261
translate german c27s002_AaronVC_88aef742:

    # mc "¿Qué pasa Tía [bet]?"
    mc "Was gibt's Neues, Tante [bet]?"

# game/scripts/c27/c27.rpy:1263
translate german c27s002_AaronVC_7f1d29ac:

    # bet "Nadie me había dicho que Aaron era un clon tuyo."
    bet "Niemand hatte mir gesagt, dass Aaron ein Klon von dir ist."

# game/scripts/c27/c27.rpy:1264
translate german c27s002_AaronVC_221ba789:

    # mc "¡Mierda, Tía [bet]! No se te puede ocultar nada. No se lo hemos dicho a nadie todavía."
    mc "Verdammt, Tante [bet]! Du kannst uns nichts verheimlichen. Wir haben es noch niemandem erzählt."

# game/scripts/c27/c27.rpy:1265
translate german c27s002_AaronVC_27a325bb:

    # bet "Veros a la vez lo hace obvio. Seguramente no lo hubiera notado si os viera por separado. Como mucho hubiera pensado que tenéis un cierto parecido."
    bet "Als ich euch beide zusammen sah, wurde es deutlich. Hätte ich euch getrennt gesehen, wäre es mir wahrscheinlich nicht aufgefallen. Höchstens hätte ich gedacht, ihr sähet euch etwas ähnlich."

# game/scripts/c27/c27.rpy:1266
translate german c27s002_AaronVC_0b02bf49:

    # mc "Ni Mamá ni Tía [nor] lo notaron durante la reunión que tuvimos con él..."
    mc "Weder meine Mutter noch meine Tante haben es während unseres Treffens mit ihm bemerkt..."

# game/scripts/c27/c27.rpy:1268
translate german c27s002_AaronVC_a01aaafe:

    # bet "*Risa* Supongo que sólo tenían ojos para [ama] y [eva]."
    bet "*Lacht* Ich schätze, sie hatten nur Augen für [ama] und [eva]."

# game/scripts/c27/c27.rpy:1269
translate german c27s002_AaronVC_ab8af0b0:

    # bet "Además, la diferencia de edad aparente hace que el cerebro no os relacione. Nuestro cerebro no está preparado para procesar algo así."
    bet "Zudem erschwert der offensichtliche Altersunterschied dem Gehirn, eine Verbindung zwischen Ihnen beiden herzustellen. Unser Gehirn ist nicht darauf ausgelegt, so etwas zu verarbeiten."

# game/scripts/c27/c27.rpy:1270
translate german c27s002_AaronVC_697acc41:

    # mc "Excepto el tuyo, por lo que parece..."
    mc "Außer bei Ihrem, wie es scheint..."

# game/scripts/c27/c27.rpy:1272
translate german c27s002_AaronVC_9a01a595:

    # aar "Le agradecería que no les dijera nada al resto de su familia, ni a [ama] y a [eva]."
    aar "Ich würde es begrüßen, wenn Sie es weder dem Rest Ihrer Familie noch [ama] und [eva] erzählen würden."

# game/scripts/c27/c27.rpy:1273
translate german c27s002_AaronVC_c806bbff:

    # aar "No quiero que se sientan obligados a considerarme parte de la familia sólo porque compartamos genes."
    aar "Ich möchte nicht, dass sie sich verpflichtet fühlen, mich als Teil der Familie zu betrachten, nur weil wir die gleichen Gene haben."

# game/scripts/c27/c27.rpy:1274
translate german c27s002_AaronVC_17ef67ef:

    # aar "Y se lo quiero decir a mis chicas en persona."
    aar "Und ich möchte es meinen Töchtern persönlich sagen."

# game/scripts/c27/c27.rpy:1276
translate german c27s002_AaronVC_f39fbdc6:

    # bet "Lo entiendo, aunque no lo comparta. Pero voy a ponerte una condición, Aaron. Deja de llamarme Sra. [bet.full] y llámame [bet]."
    bet "Ich verstehe, auch wenn ich nicht einverstanden bin. Aber ich stelle eine Bedingung, Aaron: Nenn mich nicht mehr Frau [bet.full], sondern [bet]."

# game/scripts/c27/c27.rpy:1277
translate german c27s002_AaronVC_21b8e252:

    # bet "*Risa* No eres mi sobrino, pero eres el clon de [mc] y me siento rara viendo a su cara llamándome así."
    bet "*Lacht* Du bist zwar nicht mein Neffe, aber du bist der Klon von [mc] und es fühlt sich komisch an, sein Gesicht zu sehen, wenn er mich so nennt."

# game/scripts/c27/c27.rpy:1279
translate german c27s002_AaronVC_ca2214ee:

    # aar "Me parece una condición que puedo cumplir. Mientras no me obligue a llamarla Tía [bet]..."
    aar "Ich denke, das ist eine Bedingung, die ich erfüllen kann. Solange sie mich nicht zwingt, sie Tante zu nennen."

# game/scripts/c27/c27.rpy:1280
translate german c27s002_AaronVC_9f143587:

    # aar "Pero no quiero entretenerla más de lo necesario, con lo que, si no le importa, voy a ir al grano."
    aar "Ich möchte Sie aber nicht länger als nötig aufhalten, deshalb komme ich, wenn es Ihnen nichts ausmacht, gleich zur Sache."

# game/scripts/c27/c27.rpy:1281
translate german c27s002_AaronVC_a39c3339:

    # aar "No sé si se acuerda de Gavin..."
    aar "Ich weiß nicht, ob du dich an Gavin erinnerst..."

# game/scripts/c27/c27.rpy:1283
translate german c27s002_AaronVC_e17e8f7f:

    # bet "Sí, el chico que perdió el brazo por lo que pasó en nuestra cocina. ¿Qué le pasa?"
    bet "Ja, der Junge, der seinen Arm wegen des Vorfalls in unserer Küche verloren hat. Was stimmt nicht mit ihm?"

# game/scripts/c27/c27.rpy:1285
translate german c27s002_AaronVC_0ac571ae:

    # aar "Necesita una operación, y no tenemos un neurocirujano disponible. Creo que usted podría ser una buena opción."
    aar "Sie braucht eine Operation, und wir haben keinen Neurochirurgen zur Verfügung. Ich denke, Sie wären eine gute Alternative."

# game/scripts/c27/c27.rpy:1286
translate german c27s002_AaronVC_44514949:

    # aar "Como además... no es demasiado legal en los Estados Unidos... debería hacerse aquí."
    aar "Da es in den Vereinigten Staaten nicht ganz legal ist... sollte es hier gemacht werden."

# game/scripts/c27/c27.rpy:1288
translate german c27s002_AaronVC_301f5ad1:

    # bet "¿De qué tipo de operación estamos hablando, Aaron? ¿Por qué no es legal aquí?"
    bet "Um welche Art von Operation handelt es sich, Aaron? Warum ist sie hier nicht legal?"

# game/scripts/c27/c27.rpy:1290
translate german c27s002_AaronVC_7ec91e4c:

    # "Aaron pasa alrededor de 10 minutos explicando la operación a un nivel que incluso tú puedes entender."
    "Aaron erklärt die Funktionsweise in etwa 10 Minuten so, dass selbst Sie sie verstehen können."

# game/scripts/c27/c27.rpy:1291
translate german c27s002_AaronVC_e06644f0:

    # "Lo entiendes tan bien que, cuando acaba con la explicación, tienes la boca abierta por la sorpresa."
    "Du verstehst es so gut, dass du vor Überraschung den Mund offen stehen hast, als er seine Erklärung beendet hat."

# game/scripts/c27/c27.rpy:1292
translate german c27s002_AaronVC_47d34dd9:

    # mcp "(¡Oh, Dios mío! ¡Eso es pura ciencia ficción!)"
    mcp "(Oh mein Gott! Das ist reine Science-Fiction!)"

# game/scripts/c27/c27.rpy:1294
translate german c27s002_AaronVC_59639f94:

    # bet "Parece una operación complicada y no sé si tengo los conocimientos para hacerla. No creo que NADIE tenga los conocimientos para hacerla."
    bet "Es scheint eine komplizierte Angelegenheit zu sein, und ich weiß nicht, ob ich das nötige Wissen dafür habe. Ich glaube, niemand hat das nötige Wissen dafür."

# game/scripts/c27/c27.rpy:1295
translate german c27s002_AaronVC_792505a9:

    # bet "Mándame toda la documentación de la que has hablado y lo estudiaré. ¿Cuándo se debería hacer?"
    bet "Senden Sie mir bitte alle erwähnten Unterlagen, ich werde sie prüfen. Bis wann sollte das erledigt sein?"

# game/scripts/c27/c27.rpy:1297
translate german c27s002_AaronVC_90efe756:

    # aar "Por lo que me han dicho los cirujanos que tenemos aquí, cuanto antes mejor."
    aar "Nach dem, was mir die Chirurgen hier gesagt haben, gilt: je früher, desto besser."

# game/scripts/c27/c27.rpy:1298
translate german c27s002_AaronVC_f2ecd04f:

    # aar "Lo ideal sería que, si decide hacerlo, acompañe a [mc] a Aruba cuando él venga."
    aar "Idealerweise sollten Sie, falls Sie sich dazu entscheiden, [mc] nach Aruba begleiten, wenn er kommt."

# game/scripts/c27/c27.rpy:1299
translate german c27s002_AaronVC_55699a5f:

    # aar "Una vez esté aquí, tendrá tiempo de comentar todo el proceso junto con el equipo."
    aar "Sobald Sie hier sind, haben Sie Zeit, den gesamten Ablauf mit dem Team zu besprechen."

# game/scripts/c27/c27.rpy:1301
translate german c27s002_AaronVC_25fba1cb:

    # bet "Suena a un buen plan. Aún quedan unos días para que [mc] vaya y tendré tiempo de estudiar la documentación y confirmarte si me veo preparada para hacer esa operación."
    bet "Das klingt nach einem guten Plan. Bis zu meiner Abreise sind es noch ein paar Tage, und ich habe Zeit, die Unterlagen durchzulesen und dir Bescheid zu geben, ob ich mich bereit dafür fühle."

# game/scripts/c27/c27.rpy:1302
translate german c27s002_AaronVC_d6328777:

    # bet "Si decidimos hacerlo, quiero tener el control absoluto en el proceso."
    bet "Wenn wir uns dafür entscheiden, möchte ich die vollständige Kontrolle über den Prozess haben."

# game/scripts/c27/c27.rpy:1303
translate german c27s002_AaronVC_c22ae55b:

    # bet "No quiero algo a medias tintas que pueda poner en peligro la vida del chico."
    bet "Ich will nichts Halbfertiges, das das Leben des Jungen gefährden könnte."

# game/scripts/c27/c27.rpy:1305
translate german c27s002_AaronVC_90466345:

    # aar "Me parece bien. Voy a pedirle al equipo que le mande toda la documentación lo antes posible."
    aar "Das klingt gut. Ich werde das Team bitten, Ihnen die gesamte Dokumentation so schnell wie möglich zuzusenden."

# game/scripts/c27/c27.rpy:1306
translate german c27s002_AaronVC_b0dea3e0:

    # aar "Y ahora les tengo que dejar. Debo entrar en otra reunión."
    aar "Und jetzt muss ich los. Ich muss zu einem anderen Termin."

# game/scripts/c27/c27.rpy:1307
translate german c27s002_AaronVC_afd0d15c:

    # aar "Gracias, Sra. ... Gracias, [bet]."
    aar "Vielen Dank, gnädige Frau... Vielen Dank, [bet]."

# game/scripts/c27/c27.rpy:1309
translate german c27s002_AaronVC_411eccb5:

    # bet "¡Es increíble! Ya me parecía increíble lo de las pruebas de embarazo, pero esto..."
    bet "Das ist unglaublich! Ich dachte ja schon, Schwangerschaftstests wären unglaublich, aber das hier..."

# game/scripts/c27/c27.rpy:1310
translate german c27s002_AaronVC_af4552c0:

    # mc "Aún estoy asombrado. ¿Te ves preparada para hacerlo?"
    mc "Ich bin immer noch erstaunt. Fühlst du dich bereit dafür?"

# game/scripts/c27/c27.rpy:1312
translate german c27s002_AaronVC_0cb66e63:

    # bet "No hay nadie preparado para hacerlo en el mundo, excepto el tal Daniels, quizás. Ha tenido años para familiarizarse con cerebros que envejecen aceleradamente."
    bet "Niemand auf der Welt ist dazu bereit, außer vielleicht Daniels. Er hatte jahrelang Zeit, sich mit dem raschen Altern des Gehirns vertraut zu machen."

# game/scripts/c27/c27.rpy:1313
translate german c27s002_AaronVC_12e76d7a:

    # bet "Y estoy segura de que no soy la mejor opción para hacer esa operación, pero dudo que otros cirujanos con más reputación estuvieran dispuestos a hacerla."
    bet "Und ich bin mir sicher, dass ich nicht die beste Wahl für diese Operation bin, aber ich bezweifle, dass andere, angesehenere Chirurgen dazu bereit wären."

# game/scripts/c27/c27.rpy:1314
translate german c27s002_AaronVC_e59d24df:

    # mc "Es comprensible. Por lo ilegal y porque habría que darles una información que no creo que NTR esté preparada para dar aún."
    mc "Das ist verständlich. Denn es ist illegal, und wir müssten ihnen Informationen geben, die NTR meiner Meinung nach noch nicht preisgeben will."

# game/scripts/c27/c27.rpy:1316
translate german c27s002_AaronVC_25231bcf:

    # bet "*Risa* Decirle a alguien '¿Quieres hacer una operación ilegal en alguien que no debería existir?' no es la mejor forma de establecer un primer contacto."
    bet "*Lacht* Jemanden zu fragen: „Willst du eine illegale Operation an jemandem durchführen, der eigentlich gar nicht existieren sollte?“, ist nicht gerade die beste Art, Kontakt aufzunehmen."

# game/scripts/c27/c27.rpy:1317
translate german c27s002_AaronVC_cc2bcafa:

    # mc "*Risa* Desde luego que no."
    mc "*Lacht* Natürlich nicht."

# game/scripts/c27/c27.rpy:1319
translate german c27s002_AaronVC_f5e9527a:

    # mc "Hablando de cosas que no deberían existir... ¿Quieres hacerte la prueba de embarazo?"
    mc "Wo wir gerade von Dingen sprechen, die es eigentlich nicht geben sollte... Möchtest du einen Schwangerschaftstest machen?"

# game/scripts/c27/c27.rpy:1321
translate german c27s002_AaronVC_36f8ec43:

    # bet "No hace falta. Tengo una edad y..."
    bet "Das ist nicht nötig. Ich bin in einem gewissen Alter und..."

# game/scripts/c27/c27.rpy:1322
translate german c27s002_AaronVC_772dccd7:

    # mc "Y me dijiste que las mujeres de la familia son fértiles hasta edades muy avanzadas..."
    mc "Und Sie sagten mir, dass die Frauen in der Familie bis ins hohe Alter fruchtbar sind..."

# game/scripts/c27/c27.rpy:1324
translate german c27s002_AaronVC_d0baac51:

    # bet "Sí, pero no es lo que iba a decir. Mañana por la mañana me voy a Florida. Si hiciéramos la prueba ahora, no estaría lista cuando me fuera."
    bet "Ja, aber das wollte ich eigentlich nicht sagen. Ich fliege morgen früh nach Florida. Wenn wir den Test jetzt machen würden, wäre ich bei meiner Abreise nicht bereit."

# game/scripts/c27/c27.rpy:1325
translate german c27s002_AaronVC_a9a4d97a:

    # bet "Si me hiciera la prueba, querría ver el resultado contigo. Habrá tiempo cuando vuelva de Florida, especialmente si voy a Aruba contigo."
    bet "Falls ich mich testen lasse, möchte ich die Ergebnisse gerne mit dir zusammen ansehen. Dafür wird es Zeit geben, wenn ich aus Florida zurück bin, besonders wenn ich mit dir nach Aruba fahre."

# game/scripts/c27/c27.rpy:1326
translate german c27s002_AaronVC_f5271567:

    # mc "Me parece una buena idea."
    mc "Ich finde das eine gute Idee."

# game/scripts/c27/c27.rpy:1329
translate german c27s002_AaronVC_1717c583:

    # bet "Voy a mi habitación a coger el móvil. Tengo ganas de recibir la información y empezar a estudiarla."
    bet "Ich gehe in mein Zimmer, um mein Handy zu holen. Ich bin gespannt auf die Informationen und möchte sie mir dann sofort ansehen."

# game/scripts/c27/c27.rpy:1330
translate german c27s002_AaronVC_b8fcea38:

    # bet "Te veo luego, [mc]."
    bet "Bis später, [mc]."

# game/scripts/c27/c27.rpy:1333
translate german c27s002_AaronVC_0eb93267:

    # mc "Te veo luego, [bet]."
    mc "Bis später, [bet]."

# game/scripts/c27/c27.rpy:1335
translate german c27s002_AaronVC_9f881016:

    # mc "Te veo luego, Tía [bet]."
    mc "Bis später, Tante [bet]."

# game/scripts/c27/c27.rpy:1342
translate german c27s002_KiaEilNor_02f19c98:

    # "Mientras tanto, en el salón de [nor]..."
    "Währenddessen in der [nor] Lounge..."

# game/scripts/c27/c27.rpy:1344
translate german c27s002_KiaEilNor_2835e1d0:

    # kia "Lo siento, [nor], pero ya lo hemos decidido."
    kia "Es tut mir leid, [nor], aber wir haben uns bereits entschieden."

# game/scripts/c27/c27.rpy:1345
translate german c27s002_KiaEilNor_dbe376fe:

    # eil "No digas 'hemos decidido', Mamá. Di 'has decidido'. Yo no quiero irme. [eri] incluso me ha ofrecido compartir habitación cuando lleguen las chicas nuevas."
    eil "Sag nicht „Wir haben uns entschieden“, Mama. Sag „Du hast dich entschieden“. Ich will nicht weg. [eri] Sie hat mir sogar angeboten, eine Mitbewohnerin zu haben, wenn die neuen Mädchen kommen."

# game/scripts/c27/c27.rpy:1346
translate german c27s002_KiaEilNor_83b58739:

    # nor "No quiero meterme entre vosotras dos, pero si [eil] quiere quedarse en casa, es bienvenida."
    nor "Ich möchte mich nicht in eure Angelegenheiten einmischen, aber wenn [eil] lieber zu Hause bleiben möchte, ist sie herzlich willkommen."

# game/scripts/c27/c27.rpy:1348
translate german c27s002_KiaEilNor_b3d68f5a:

    # kia "Es nuestra casa. Deberíamos vivir allí una vez Solomon se vaya y podamos volver."
    kia "Es ist unser Zuhause. Wir sollten dort wohnen, sobald Solomon weg ist und wir zurückkehren können."

# game/scripts/c27/c27.rpy:1349
translate german c27s002_KiaEilNor_c13f6344:

    # kia "Quiero dejar de ser una carga para ti. Suficiente trabajo tendrás una vez lleguen las chicas nuevas."
    kia "Ich möchte dir nicht länger zur Last fallen. Du wirst genug zu tun haben, sobald die neuen Mädchen da sind."

# game/scripts/c27/c27.rpy:1351
translate german c27s002_KiaEilNor_680bf2d7:

    # nor "No dais ningún trabajo, [kia]. ¿Comida? Viváis donde viváis espero que vengáis a comer o cenar todos los días."
    nor "Du arbeitest ja gar nicht, [kia]. Essen? Wo auch immer du wohnst, ich erwarte, dass du jeden Tag zum Mittag- oder Abendessen kommst."

# game/scripts/c27/c27.rpy:1352
translate german c27s002_KiaEilNor_94bf2c09:

    # nor "Me fastidia que [sam] y [sim], [oma], [mad.nick], o [meg] sólo vengan un par de días por semana, tres como mucho, pero ellas nunca han vivido aquí."
    nor "Es ärgert mich, dass [sam] und [sim], [oma], [mad.nick] oder [meg] nur ein paar Mal pro Woche vorkommen, höchstens dreimal, aber sie sind hier nie heimisch gewesen."

# game/scripts/c27/c27.rpy:1353
translate german c27s002_KiaEilNor_adfdc780:

    # nor "Si lo hicierais vosotras después de estas dos semanas... Sería como si la casa estuviera vacía."
    nor "Wenn Sie es nach diesen zwei Wochen tun würden... wäre es, als ob das Haus leer wäre."

# game/scripts/c27/c27.rpy:1355
translate german c27s002_KiaEilNor_ad86e822:

    # eil "Bueno, más trabajo sí que damos. Hay más lavadoras que poner..."
    eil "Nun ja, wir schaffen dadurch auf jeden Fall mehr Arbeit. Es gibt deutlich mehr Abwasch..."

# game/scripts/c27/c27.rpy:1357
translate german c27s002_KiaEilNor_201ecad1:

    # nor "¿Cuántas lavadoras has puesto en la última semana, [eil]? ¿Cuántas ha puesto tu madre?"
    nor "Wie viele Waschladungen hast du in der letzten Woche gewaschen, [eil]? Wie viele hat deine Mutter gewaschen?"

# game/scripts/c27/c27.rpy:1358
translate german c27s002_KiaEilNor_501253ad:

    # nor "¡Desde que vivís aquí, pongo menos lavadoras que nunca! Entre vosotras y mi madre me estáis quitando un montón de trabajo."
    nor "Seit du hier wohnst, wasche ich so wenig Wäsche wie nie zuvor! Du und meine Mutter nehmt mir eine Menge Arbeit ab."

# game/scripts/c27/c27.rpy:1360
translate german c27s002_KiaEilNor_89ee9a5f:

    # kia "Pero los gastos... La factura de la luz, del agua... la comida... todo eso te tiene que ocasionar gastos..."
    kia "Aber die Ausgaben... Die Stromrechnung, die Wasserrechnung... Lebensmittel... all das kostet Geld..."

# game/scripts/c27/c27.rpy:1362
translate german c27s002_KiaEilNor_20ae6ea4:

    # nor "Aún no ha llegado ninguna factura desde que estáis aquí, pero no creo que sea mucho el incremento, por mucho rato que os paséis con el secador."
    nor "Seit Sie hier sind, ist noch keine Rechnung angekommen, aber ich glaube nicht, dass die Erhöhung groß sein wird, egal wie lange Sie den Föhn benutzen."

# game/scripts/c27/c27.rpy:1363
translate german c27s002_KiaEilNor_81f0583b:

    # nor "¿Quieres pagar por esos gastos? No seas ridícula, [kia]. No sois inquilinas. Sois familia."
    nor "Wollt ihr diese Kosten übernehmen? Das ist doch lächerlich! Ihr seid keine Mieter, ihr seid Familie."

# game/scripts/c27/c27.rpy:1366
translate german c27s002_KiaEilNor_a908e873:

    # nor "Hablando de familia. ¿Ya le has dicho a [mc] lo del divorcio?"
    nor "Wo wir gerade von Familie sprechen, haben Sie [mc] schon von der Scheidung erzählt?"

# game/scripts/c27/c27.rpy:1368
translate german c27s002_KiaEilNor_9eedc9e1:

    # kia "No, y le pedí a [oma] que no le dijera nada. No quiero decirle nada hasta no haber decidido dónde vamos a vivir."
    kia "Nein, und ich habe [oma] gebeten, ihr nichts zu sagen. Ich möchte ihr nichts sagen, bis wir uns entschieden haben, wo wir wohnen werden."

# game/scripts/c27/c27.rpy:1369
translate german c27s002_KiaEilNor_169a5014:

    # kia "Si lo supiera, seguro que me presionaría para que nos quedáramos aquí."
    kia "Wenn er es wüsste, würde er mich bestimmt unter Druck setzen, hier zu bleiben."

# game/scripts/c27/c27.rpy:1371
translate german c27s002_KiaEilNor_14da87d0:

    # eil "Aún no conoces a [mc] lo suficiente, Mamá. Él buscaría soluciones y argumentos para que no te fueras."
    eil "Du kennst [mc] noch nicht gut genug, Mama. Er würde Lösungen und Argumente finden, um dich vom Gehen abzuhalten."

# game/scripts/c27/c27.rpy:1372
translate german c27s002_KiaEilNor_482ce281:

    # eil "Pero no te presionaría. La decisión es tuya y él la aceptará. Sólo te propondrá alternativas."
    eil "Aber ich würde dich nicht unter Druck setzen. Die Entscheidung liegt bei dir, und er wird sie akzeptieren. Er wird dir lediglich Alternativen vorschlagen."

# game/scripts/c27/c27.rpy:1374
translate german c27s002_KiaEilNor_0ccef5d8:

    # kia "¿Y crees que eso no sería una forma de presión? Llevamos juntos diez días y le digo que me voy de casa para vivir en nuestra casa."
    kia "Und du glaubst nicht, dass das eine Form von Druck wäre? Wir sind seit zehn Tagen zusammen und ich sage ihm, dass ich von zu Hause ausziehe, um in unserem Haus zu wohnen."

# game/scripts/c27/c27.rpy:1375
translate german c27s002_KiaEilNor_f398d692:

    # kia "Si empieza a proponer alternativas y las rechazo todas... parecerá que no quiero vivir en la misma casa que él..."
    kia "Wenn er anfängt, Alternativen vorzuschlagen, und ich sie alle ablehne... dann wird es so aussehen, als wolle ich nicht mit ihm unter einem Dach wohnen..."

# game/scripts/c27/c27.rpy:1376
translate german c27s002_KiaEilNor_d384f096:

    # kia "Por eso es mejor hacerlo ahora que lo hemos decidido."
    kia "Deshalb ist es besser, es jetzt zu tun, da wir uns entschieden haben."

# game/scripts/c27/c27.rpy:1379
translate german c27s002_KiaEilNor_e37e927c:

    # kia "Bueno, da lo mismo. Nos iremos de casa para vivir en nuestra casa. Ya te he dicho que lo hemos decidido."
    kia "Nun ja, das spielt keine Rolle. Wir ziehen aus unserem Haus aus und wohnen in unserer eigenen Wohnung. Ich habe dir ja schon gesagt, dass wir uns entschieden haben."

# game/scripts/c27/c27.rpy:1381
translate german c27s002_KiaEilNor_e30ee04a:

    # eil "Y yo te he dicho que no 'hemos decidido' nada. Tú has tomado tu decisión. Yo la mía."
    eil "Und ich habe dir doch gesagt, dass wir noch gar nichts „entschieden“ haben. Du hast deine Entscheidung getroffen. Ich habe meine getroffen."

# game/scripts/c27/c27.rpy:1382
translate german c27s002_KiaEilNor_83a18851:

    # eil "[nor] ha dicho que soy bienvenida, con lo que me voy a quedar aquí."
    eil "[nor] sagte, ich sei willkommen, also werde ich hier bleiben."

# game/scripts/c27/c27.rpy:1384
translate german c27s002_KiaEilNor_298ea3bb:

    # nor "¿De verdad quieres volver a vivir en esa casa? ¿Tú sola?"
    nor "Willst du wirklich wieder in diesem Haus wohnen? Ganz allein?"

# game/scripts/c27/c27.rpy:1385
translate german c27s002_KiaEilNor_24e69273:

    # nor "Lo único que te va a traer son malos recuerdos. Si [eil] fuera contigo, podríais crear recuerdos nuevos."
    nor "Es wird dir nur schlechte Erinnerungen bringen. Wenn [eil] bei dir wäre, könntest du neue Erinnerungen schaffen."

# game/scripts/c27/c27.rpy:1386
translate german c27s002_KiaEilNor_18f3a71a:

    # nor "Pero le he ofrecido quedarse, ha aceptado, y no voy a retirar la invitación."
    nor "Aber ich habe ihm eine Unterkunft angeboten, er hat angenommen, und ich werde die Einladung nicht zurückziehen."

# game/scripts/c27/c27.rpy:1388
translate german c27s002_KiaEilNor_d378074d:

    # kia "Lo sé, pero no es que quiera. Es que debo. Me estáis haciendo sentir incómoda con tanta amabilidad."
    kia "Ich weiß, aber es ist nicht so, dass ich es will. Ich muss es. Deine ganze Freundlichkeit macht mich unruhig."

# game/scripts/c27/c27.rpy:1389
translate german c27s002_KiaEilNor_dc33e4a4:

    # kia "Una vez Solomon se vaya de casa, las circunstancias que os obligaron a acogernos habrán desaparecido."
    kia "Sobald Solomon sein Zuhause verlässt, werden die Umstände, die euch gezwungen haben, uns aufzunehmen, verschwunden sein."

# game/scripts/c27/c27.rpy:1391
translate german c27s002_KiaEilNor_f5ed110f:

    # nor "*Risa* ¿Obligado? ¿Te has dado un golpe en la cabeza?"
    nor "*Lacht* Gezwungen? Hast du dir den Kopf gestoßen?"

# game/scripts/c27/c27.rpy:1392
translate german c27s002_KiaEilNor_f21ef800:

    # nor "Que viváis aquí es una de las mejores cosas que le han pasado a esta familia."
    nor "Dass du hier wohnst, ist eines der besten Dinge, die dieser Familie je passiert sind."

# game/scripts/c27/c27.rpy:1393
translate german c27s002_KiaEilNor_da6f0423:

    # nor "¡Entre vosotras, las estudiantes, mi madre y mi tía, la casa está más viva que nunca!"
    nor "Zwischen euch Studenten, meiner Mutter und meiner Tante ist das Haus lebendiger denn je!"

# game/scripts/c27/c27.rpy:1395
translate german c27s002_KiaEilNor_5744ade3:

    # bet "He oído que alguien me nombraba... ¿Qué estáis discutiendo, si puedo preguntarlo?"
    bet "Ich habe gehört, wie jemand mich erwähnt hat... Worüber sprechen Sie, wenn ich fragen darf?"

# game/scripts/c27/c27.rpy:1397
translate german c27s002_KiaEilNor_a7808cc3:

    # nor "Hola, Tía [bet]."
    nor "Hallo, Tante [bet]."

# game/scripts/c27/c27.rpy:1398
translate german c27s002_KiaEilNor_a2fa1dd8:

    # eil "Mi madre se ha vuelto idiota y quiere volver a nuestra casa..."
    eil "Meine Mutter ist total verrückt geworden und will wieder in unser Haus zurückkommen..."

# game/scripts/c27/c27.rpy:1399
translate german c27s002_KiaEilNor_503cd810:

    # kia "¡[eil]!"
    kia "[eil]!"

# game/scripts/c27/c27.rpy:1401
translate german c27s002_KiaEilNor_5974aad6:

    # bet "Desde luego que te has vuelto idiota. ¿Quieres volver a vivir con Solomon?"
    bet "Du bist echt zum Idioten geworden. Willst du wieder bei Salomo wohnen?"

# game/scripts/c27/c27.rpy:1403
translate german c27s002_KiaEilNor_a45339fc:

    # bet "¿Ahora que estás con [mc]? ¿Estás loca?"
    bet "Jetzt, wo du bei [mc] bist? Bist du verrückt?"

# game/scripts/c27/c27.rpy:1405
translate german c27s002_KiaEilNor_a8f10047:

    # kia "No, no sería vivir con Solomon. Me ha pedido el divorcio y me cede la casa. Se irá... no sé cuándo se irá."
    kia "Nein, ich würde nicht mit Solomon zusammenleben. Er hat die Scheidung eingereicht und will mir das Haus überlassen. Er wird ausziehen... ich weiß nur nicht, wann."

# game/scripts/c27/c27.rpy:1407
translate german c27s002_KiaEilNor_798b8523:

    # nor "Y como [kia] ya era idiota de antes, cree que es una carga en casa y por eso quiere volver allí."
    nor "Und da [kia] schon vorher ein Idiot war, glaubt er, dass er zu Hause eine Last ist, und deshalb will er dorthin zurück."

# game/scripts/c27/c27.rpy:1408
translate german c27s002_KiaEilNor_56a3b283:

    # kia "*Risa* ¡[nor]! ¿Todo el mundo va a llamarme idiota hoy?"
    kia "*Lacht* [nor]! Werden mich heute alle einen Idioten nennen?"

# game/scripts/c27/c27.rpy:1409
translate german c27s002_KiaEilNor_9cf97917:

    # eil "*Risa* Tiene razón. No en que seas una carga, claro. Ya querías irte antes de la fiesta de cumpleaños."
    eil "*Lacht* Sie hat Recht. Nicht, dass du eine Last wärst, natürlich. Du wolltest ja vor der Geburtstagsfeier weg."

# game/scripts/c27/c27.rpy:1410
translate german c27s002_KiaEilNor_e37d0cb8:

    # eil "Si todo el mundo te llama idiota, por algo será..."
    eil "Wenn dich alle einen Idioten nennen, muss das einen Grund haben..."

# game/scripts/c27/c27.rpy:1412
translate german c27s002_KiaEilNor_6ec5ceb3:

    # bet "¿Puedo hacerte una propuesta, [kia]?"
    bet "Darf ich Ihnen einen Vorschlag machen, [kia]?"

# game/scripts/c27/c27.rpy:1413
translate german c27s002_KiaEilNor_959b35cb:

    # bet "Conseguirías lo que quieres y todas conseguiríamos que sigas viviendo 'en casa', que es lo que queremos el resto."
    bet "Du würdest bekommen, was du willst, und wir alle würden dafür sorgen, dass du weiterhin \"zu Hause\" wohnst, was wir anderen auch wollen."

# game/scripts/c27/c27.rpy:1414
translate german c27s002_KiaEilNor_63f50414:

    # bet "¿Cuántas habitaciones tiene tu casa?"
    bet "Wie viele Zimmer hat Ihr Haus?"

# game/scripts/c27/c27.rpy:1416
translate german c27s002_KiaEilNor_cb585557:

    # kia "Cuatro, pero no lo entiendo. Son cosas incompatibles. O vivo aquí o no vivo aquí."
    kia "Vier, aber ich verstehe es nicht. Das schließt sich gegenseitig aus. Entweder ich lebe hier oder ich lebe nicht hier."

# game/scripts/c27/c27.rpy:1417
translate german c27s002_KiaEilNor_f44a2ca6:

    # kia "¿Y qué tiene que ver el número de habitaciones?"
    kia "Und was hat die Anzahl der Zimmer damit zu tun?"

# game/scripts/c27/c27.rpy:1419
translate german c27s002_KiaEilNor_922dfd9c:

    # bet "[eri] y yo tenemos un plan. ¿Nos acogerías a [mee] y a mí durante unos meses?"
    bet "[eri] und ich haben einen Plan. Würden Sie [mee] und mich für ein paar Monate aufnehmen?"

# game/scripts/c27/c27.rpy:1420
translate german c27s002_KiaEilNor_be97a80a:

    # bet "¿Y estarías interesada en vender tu casa y que construyéramos una aquí cerca si podemos comprar la parcela y construir en ella?"
    bet "Und wären Sie daran interessiert, Ihr Haus zu verkaufen und uns ein Haus in der Nähe bauen zu lassen, wenn wir das Grundstück kaufen und darauf bauen können?"

# game/scripts/c27/c27.rpy:1422
translate german c27s002_KiaEilNor_a16bddfb:

    # eil "¿Qué?" (multiple=2)
    eil "Das?" (multiple=2)

# game/scripts/c27/c27.rpy:1423
translate german c27s002_KiaEilNor_6fbc6d77:

    # kia "*Jadeo* ¿QUÉ?" (multiple=2)
    kia "*Schnappatmung* WAS?" (multiple=2)

# game/scripts/c27/c27.rpy:1424
translate german c27s002_KiaEilNor_3d5b5aa0:

    # nor "¿Qué? ¿Qué parcela, Tía [bet]?"
    nor "Was? Welche Handlung, Tante [bet]?"

# game/scripts/c27/c27.rpy:1426
translate german c27s002_KiaEilNor_fe3866ab:

    # bet "Una de las que hay al otro lado de la carretera, o la de más allá de casa de [mar]."
    bet "Einer von denen auf der anderen Straßenseite oder der hinter dem Haus von [mar]."

# game/scripts/c27/c27.rpy:1427
translate german c27s002_KiaEilNor_2f0196e1:

    # bet "Si conseguimos comprarla, voy a proponerle a [mee] que, en vez de comprar o alquilar algo en el centro, construyamos una casa ahí."
    bet "Wenn wir es schaffen, es zu kaufen, werde ich [mee] vorschlagen, dass wir dort ein Haus bauen, anstatt etwas in der Innenstadt zu kaufen oder zu mieten."

# game/scripts/c27/c27.rpy:1428
translate german c27s002_KiaEilNor_7093ea9b:

    # bet "Si [kia] quiere, puede unirse a la iniciativa y podemos construir una casa más grande."
    bet "Wenn [kia] möchte, kann er sich der Initiative anschließen und wir können ein größeres Haus bauen."

# game/scripts/c27/c27.rpy:1430
translate german c27s002_KiaEilNor_e8b9b26a:

    # eil "¡Di que sí, Mamá!"
    eil "Sag ja, Mama!"

# game/scripts/c27/c27.rpy:1431
translate german c27s002_KiaEilNor_c139524e:

    # kia "¡Me encantaría!"
    kia "Ich würde gerne!"

# game/scripts/c27/c27.rpy:1433
translate german c27s002_KiaEilNor_adfd03f6:

    # bet "¡Estupendo! Tendríamos que saber quiénes son los dueños de la parcela que elijamos, y saber si podremos construir."
    bet "Großartig! Wir müssten wissen, wem das Grundstück gehört, das wir auswählen, und ob wir dort bauen dürfen."

# game/scripts/c27/c27.rpy:1434
translate german c27s002_KiaEilNor_b27cf8bf:

    # bet "Supongo que después habrá que pedir permisos de construcción, pero de eso se ocupará [mee] si la convenzo..."
    bet "Ich nehme an, wir müssen anschließend Baugenehmigungen beantragen, aber [mee] wird sich darum kümmern, wenn ich sie überzeugen kann..."

# game/scripts/c27/c27.rpy:1436
translate german c27s002_KiaEilNor_bf87f68f:

    # nor "*Risa*"
    nor "*Lachen*"

# game/scripts/c27/c27.rpy:1438
translate german c27s002_KiaEilNor_f2d2447c:

    # bet "¿De qué te ríes, [nor]?"
    bet "Worüber lachst du, [nor]?"

# game/scripts/c27/c27.rpy:1440
translate german c27s002_KiaEilNor_63896659:

    # nor "Las tres parcelas que hay al otro lado de la carretera, las tres de detrás de las casas, y la que hay más allá de casa de [mar] no las podréis comprar."
    nor "Sie werden nicht in der Lage sein, die drei Grundstücke auf der anderen Straßenseite, die drei hinter den Häusern und das eine hinter dem Haus von [mar] zu kaufen."

# game/scripts/c27/c27.rpy:1441
translate german c27s002_KiaEilNor_41086b3d:

    # nor "La propietaria es una bruja que no os las va a vender."
    nor "Die Besitzerin ist eine Hexe, die sie dir nicht verkaufen wird."

# game/scripts/c27/c27.rpy:1442
translate german c27s002_KiaEilNor_2328c337:

    # nor "¡Son mías desde hace años! Las compró Mike para que nadie pudiera construir cerca nuestro."
    nor "Die gehören mir schon seit Jahren! Mike hat sie gekauft, damit niemand in unserer Nähe bauen kann."

# game/scripts/c27/c27.rpy:1443
translate german c27s002_KiaEilNor_b6a58c0b:

    # nor "Os las cederé gustosa, con un par de condiciones."
    nor "Ich gebe sie Ihnen gerne, allerdings unter ein paar Bedingungen."

# game/scripts/c27/c27.rpy:1445
translate german c27s002_KiaEilNor_ecbc4eeb:

    # nor "La primera es que mientras dure la construcción, vendréis todos los días a comer y a cenar."
    nor "Erstens werden Sie, während die Bauarbeiten laufen, jeden Tag zum Mittag- und Abendessen kommen."

# game/scripts/c27/c27.rpy:1446
translate german c27s002_KiaEilNor_3e7ede50:

    # nor "La segunda es que te unas al proyecto de mi madre y mi tía."
    nor "Die zweite Möglichkeit ist, dass du dich dem Projekt meiner Mutter und Tante anschließt."

# game/scripts/c27/c27.rpy:1447
translate german c27s002_KiaEilNor_9b067bcf:

    # nor "Y no vas a dejar que dos ancianitas se tengan que ir lejos de su familia por no unirte a ellas, ¿verdad?"
    nor "Und Sie werden doch nicht zulassen, dass zwei alte Damen weit weg von ihrer Familie gehen müssen, nur weil Sie nicht mitkommen wollen, oder?"

# game/scripts/c27/c27.rpy:1449
translate german c27s002_KiaEilNor_dac768f2:

    # eil "¿Qué? ¿Son tuyas?" (multiple=2)
    eil "Was? Gehören sie dir?" (multiple=2)

# game/scripts/c27/c27.rpy:1450
translate german c27s002_KiaEilNor_96439efb:

    # kia "¿Qué? ¡Claro que me uniría!" (multiple=2)
    kia "Was? Natürlich würde ich mitmachen!" (multiple=2)

# game/scripts/c27/c27.rpy:1452
translate german c27s002_KiaEilNor_92cfab91:

    # bet "¿Qué?"
    bet "Das?"

# game/scripts/c27/c27.rpy:1454
translate german c27s002_KiaEilNor_13a3db2e:

    # nor "*Risa* ¿Por qué creéis que mi parcela es más pequeña que la de [mar] y no tiene piscina?"
    nor "*Gelächter* Warum glaubst du, ist mein Grundstück kleiner als das von [mar] und hat keinen Pool?"

# game/scripts/c27/c27.rpy:1455
translate german c27s002_KiaEilNor_b3bb7bc0:

    # nor "Mike se dejó un dineral en esas parcelas. Siempre quiso que las usara alguien de la familia cuando se quisiera independizar."
    nor "Mike gab ein Vermögen für diese Grundstücke aus. Er wollte immer, dass jemand aus der Familie sie nutzen könnte, wenn er ausziehen wollte."

# game/scripts/c27/c27.rpy:1456
translate german c27s002_KiaEilNor_f7d79988:

    # nor "Creo que estaría contento de que seáis vosotras, aunque nunca le cayó muy bien Mamá."
    nor "Ich glaube, er wäre glücklich, wenn du es wärst, obwohl er Mama nie wirklich mochte."

# game/scripts/c27/c27.rpy:1458
translate german c27s002_KiaEilNor_c2c8a80f:

    # bet "*Risa* Esto parece el inicio del 'Barrio Marks'."
    bet "*Gelächter* Das sieht aus wie der Anfang von „Marks Neighborhood“."

# game/scripts/c27/c27.rpy:1460
translate german c27s002_KiaEilNor_85364476:

    # "Las cuatro mujeres empiezan a hacer planes sobre la construcción de la casa."
    "Die vier Frauen beginnen, Pläne für den Bau des Hauses zu schmieden."

# game/scripts/c27/c27.rpy:1461
translate german c27s002_KiaEilNor_e452ac4f:

    # "Son castillos en el aire, ya que ni siquiera [nor] sabe qué hay que hacer para construir en esas parcelas."
    "Es sind Luftschlösser, da nicht einmal [nor] weiß, was getan werden muss, um auf diesen Grundstücken zu bauen."

# game/scripts/c27/c27.rpy:1462
translate german c27s002_KiaEilNor_9ab84de7:

    # "Pero la ilusión de no separar a la familia es mayor que la posibilidad de que surjan problemas."
    "Doch der Wunsch, die Familie zusammenzuhalten, ist größer als die Möglichkeit, dass Probleme entstehen könnten."

# game/scripts/c27/c27.rpy:1468
translate german c27s002_AmaAtCollege1_325ec4ea:

    # "Pocos minutos después de que [bet] se haya ido..."
    "Wenige Minuten nachdem [bet] gegangen war..."

# game/scripts/c27/c27.rpy:1470
translate german c27s002_AmaAtCollege1_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c27/c27.rpy:1473
translate german c27s002_AmaAtCollege1_feac9063:

    # mc "Hola, [ama]. ¿Cómo ha ido?"
    mc "Hallo [ama]. Wie geht's?"

# game/scripts/c27/c27.rpy:1476
translate german c27s002_AmaAtCollege1_2389a3ff:

    # ama "¡Horrible! ¡Odio a los Washington!"
    ama "Furchtbar! Ich hasse die Washingtons!"

# game/scripts/c27/c27.rpy:1477
translate german c27s002_AmaAtCollege1_29714f61:

    # mc "¿Qué ha pasado?"
    mc "Was ist passiert?"

# game/scripts/c27/c27.rpy:1479
translate german c27s002_AmaAtCollege1_ded31857:

    # ama "¡[sam] me ha hecho comer dos raciones de pierogi!"
    ama "[sam] Er hat mich gezwungen, zwei Portionen Piroggen zu essen!"

# game/scripts/c27/c27.rpy:1480
translate german c27s002_AmaAtCollege1_82e20e44:

    # ama "¡Casi no puedo moverme! Voy a tener que correr muchos kilómetros en la cinta para quemar todas esas calorías."
    ama "Ich kann mich kaum bewegen! Ich muss viele Kilometer auf dem Laufband zurücklegen, um all die Kalorien zu verbrennen."

# game/scripts/c27/c27.rpy:1481
translate german c27s002_AmaAtCollege1_d1ca4ed9:

    # mc "*Risa* Los pierogi de [sam.nick] están buenísimos."
    mc "*Lacht* Die Piroggen von [sam.nick] sind köstlich."

# game/scripts/c27/c27.rpy:1483
translate german c27s002_AmaAtCollege1_61725a62:

    # ama "¡Están deliciosos! Pero después de los primeros diez..."
    ama "Sie sind köstlich! Aber nach den ersten zehn..."

# game/scripts/c27/c27.rpy:1484
translate german c27s002_AmaAtCollege1_8d2ab383:

    # ama "Ahora mismo estoy mirando por el retrovisor con miedo de que salga con una bandeja para que me la lleve a la base."
    ama "Im Moment schaue ich in den Rückspiegel und habe Angst, dass er mit einem Tablett herauskommt, um mich zurück zur Basis zu bringen."

# game/scripts/c27/c27.rpy:1485
translate german c27s002_AmaAtCollege1_a34d9996:

    # mc "¿Te has comido diez pierogis? No me extraña que no puedas moverte."
    mc "Hast du zehn Piroggen gegessen? Kein Wunder, dass du dich nicht bewegen kannst."

# game/scripts/c27/c27.rpy:1487
translate german c27s002_AmaAtCollege1_99f222e0:

    # ama "He dicho los primeros diez... [sam.nick] me ha obligado a seguir comiendo..."
    ama "Ich sagte, die ersten zehn... [sam.nick] haben mich gezwungen, weiterzuessen..."

# game/scripts/c27/c27.rpy:1488
translate german c27s002_AmaAtCollege1_2a9865b8:

    # mc "*Risa* ¿Qué hacía Jamaal mientras tanto?"
    mc "*Gelächter* Was hat Jamaal in der Zwischenzeit gemacht?"

# game/scripts/c27/c27.rpy:1490
translate german c27s002_AmaAtCollege1_2f2c36d8:

    # ama "Fingía llorar en un rincón porque me estaba comiendo sus pierogis. Pero finge muy mal. Se le escapaba la risa."
    ama "Sie tat so, als würde sie in einer Ecke weinen, weil ich ihre Piroggen aß. Aber sie ist eine furchtbare Schauspielerin. Sie konnte sich vor Lachen nicht mehr halten."

# game/scripts/c27/c27.rpy:1491
translate german c27s002_AmaAtCollege1_58c545e8:

    # ama "Había comida para alimentar un regimiento de soldados hambrientos."
    ama "Es gab genug Essen, um ein Regiment hungernder Soldaten zu ernähren."

# game/scripts/c27/c27.rpy:1492
translate german c27s002_AmaAtCollege1_1d179161:

    # mc "Acostúmbrate a las comidas de [sam]."
    mc "Gewöhnen Sie sich an die Mahlzeiten von [sam]."

# game/scripts/c27/c27.rpy:1493
translate german c27s002_AmaAtCollege1_6cb4d253:

    # mc "¿Y el otro tema? ¿Cómo ha ido?"
    mc "Und die andere Frage? Wie ist sie ausgegangen?"

# game/scripts/c27/c27.rpy:1495
translate german c27s002_AmaAtCollege1_7354ada8:

    # ama "Igual de mal. Pero al final ha firmado."
    ama "Genauso schlimm. Aber am Ende hat er unterschrieben."

# game/scripts/c27/c27.rpy:1496
translate german c27s002_AmaAtCollege1_a0eb44d1:

    # mc "Si ha firmado no habrá ido tan mal, ¿no?"
    mc "Wenn er unterschrieben hat, kann es ja nicht allzu schlecht gelaufen sein, oder?"

# game/scripts/c27/c27.rpy:1497
translate german c27s002_AmaAtCollege1_ee7272f3:

    # ama "Jamaal les ha hecho entrar en razón, aunque parezca mentira."
    ama "Jamaal hat sie zur Vernunft gebracht, auch wenn es unglaublich erscheint."

# game/scripts/c27/c27.rpy:1498
translate german c27s002_AmaAtCollege1_9dce10b0:

    # mc "A veces Jam es el más racional de esa familia. Algunas veces. De vez en cuando. En extrañas ocasiones."
    mc "Manchmal ist Jam der Vernünftigste in der Familie. Manchmal. Gelegentlich. Nur in seltenen Fällen."

# game/scripts/c27/c27.rpy:1500
translate german c27s002_AmaAtCollege1_fda6152b:

    # ama "No esperes agradecimiento de [sim], por cierto. Me han sacado que había sido idea mía."
    ama "Erwarte übrigens keinen Dank von [sim]. Sie haben mir gesagt, es sei meine Idee gewesen."

# game/scripts/c27/c27.rpy:1501
translate german c27s002_AmaAtCollege1_9dff03c6:

    # mc "¿Te han tendido una trampa y has caído? ¿En plan 'No te va a pasar nada si dices que la idea ha sido tuya'?"
    mc "Wurdest du hereingelegt und bist darauf hereingefallen? Nach dem Motto: „Dir passiert nichts, wenn du sagst, es war deine Idee“?"

# game/scripts/c27/c27.rpy:1503
translate german c27s002_AmaAtCollege1_604b1170:

    # ama "¡Exactamente eso! O más bien 'Estaríamos agradecidas si nos dices que has sido tú'."
    ama "Genau! Oder besser gesagt: „Wir wären Ihnen dankbar, wenn Sie uns sagen würden, dass Sie es sind.“"

# game/scripts/c27/c27.rpy:1504
translate german c27s002_AmaAtCollege1_6a084b8d:

    # ama "A veces odio a los civiles. ¡Estáis llenos de estratagemas traicioneras!"
    ama "Manchmal hasse ich Zivilisten. Ihr seid voller hinterhältiger Intrigen!"

# game/scripts/c27/c27.rpy:1505
translate german c27s002_AmaAtCollege1_15cb9e7b:

    # mc "*Risa* Eso es lo que se siente cuando tienes una madre, [ama]. Le acabarás cogiendo el gusto."
    mc "*Lacht* So fühlt es sich also an, eine Mutter zu haben, [ama]. Du wirst dich schon daran gewöhnen."

# game/scripts/c27/c27.rpy:1507
translate german c27s002_AmaAtCollege1_53243ded:

    # ama "Bueno, voy a ir a la universidad a formalizar la inscripción de [sim]."
    ama "Nun ja, ich gehe zur Universität, um die Registrierung von [sim] zu formalisieren."

# game/scripts/c27/c27.rpy:1508
translate german c27s002_AmaAtCollege1_cc7f096d:

    # mc "Ya que vas, ¿me puedes hacer un favor?"
    mc "Da du ja gehst, könntest du mir einen Gefallen tun?"

# game/scripts/c27/c27.rpy:1509
translate german c27s002_AmaAtCollege1_63831521:

    # ama "Sí, dime qué necesitas."
    ama "Ja, sagen Sie mir, was Sie benötigen."

# game/scripts/c27/c27.rpy:1510
translate german c27s002_AmaAtCollege1_25177f8c:

    # mc "Matricula a [eil] también. En este caso, que lo cobren de mi cuenta."
    mc "Die Anmeldegebühr für [eil] ist ebenfalls zu entrichten. Bitte belasten Sie in diesem Fall mein Konto."

# game/scripts/c27/c27.rpy:1512
translate german c27s002_AmaAtCollege1_d6403d39:

    # ama "¿[eil]? No tengo su expediente. No sé en qué carrera tengo que matricularla..."
    ama "[eil]? Ich habe ihre Akte nicht. Ich weiß nicht, in welches Programm ich sie einschreiben muss..."

# game/scripts/c27/c27.rpy:1513
translate german c27s002_AmaAtCollege1_cf25dae0:

    # mc "No te preocupes. Tienen el expediente en la universidad. Dejó la carrera el año pasado por culpa de Solomon."
    mc "Keine Sorge. Ihre Akte ist an der Universität. Sie hat letztes Jahr wegen Solomon das Studium abgebrochen."

# game/scripts/c27/c27.rpy:1514
translate german c27s002_AmaAtCollege1_9472e3ca:

    # mc "Ahora que he cobrado el primer sueldo, puedo pagarle la inscripción para su último año. No tiene por qué pagar los errores de su padre."
    mc "Jetzt, wo ich meinen ersten Lohn erhalten habe, kann ich ihre Einschreibung für das letzte Schuljahr bezahlen. Sie sollte nicht für die Fehler ihres Vaters büßen müssen."

# game/scripts/c27/c27.rpy:1516
translate german c27s002_AmaAtCollege1_f25db8ed:

    # ama "Es muy generoso por tu parte, pero no sé si podré hacerlo. Me costó conseguir una plaza para [sim], y..."
    ama "Das ist sehr großzügig von Ihnen, aber ich weiß nicht, ob ich das schaffen werde. Es war schwierig, einen Platz für [sim] zu bekommen, und..."

# game/scripts/c27/c27.rpy:1517
translate german c27s002_AmaAtCollege1_3c7d659d:

    # mc "Si te ponen algún problema, pide ver al Decano Jonas y dile que vas de mi parte."
    mc "Falls es zu Schwierigkeiten kommt, bitten Sie darum, Dean Jonas zu sprechen, und sagen Sie ihm, dass Sie in meinem Auftrag da sind."

# game/scripts/c27/c27.rpy:1519
translate german c27s002_AmaAtCollege1_b3e3dff0:

    # ama "Lo haré. Voy a ir yendo, antes de que se haga más tarde. Te veo luego."
    ama "Ja, werde ich. Ich mache mich jetzt auf den Weg, bevor es zu spät wird. Bis später."

# game/scripts/c27/c27.rpy:1521
translate german c27s002_AmaAtCollege1_ec8c6a24:

    # mc "Hasta luego, [ama]."
    mc "Bis später, [ama]."

# game/scripts/c27/c27.rpy:1536
translate german c27s002_LisShopping_63770401:

    # "Pasas un rato leyendo los informes financieros que te ha enviado Aaron. La contabilidad de Daniels era como mínimo 'creativa'."
    "Sie verbringen einige Zeit damit, die Finanzberichte zu lesen, die Aaron Ihnen geschickt hat. Daniels' Buchführung war, gelinde gesagt, „kreativ“."

# game/scripts/c27/c27.rpy:1537
translate german c27s002_LisShopping_0ff8066f:

    # "La doble contabilidad es para novatos. Lo de Daniels, o lo de sus contables para ser más exactos, es verdadero arte para ocultar ingresos."
    "Doppelte Buchführung ist etwas für Amateure. Was Daniels macht, oder besser gesagt, was seine Buchhalter machen, ist wahre Kunst, Einnahmen zu verbergen."

# game/scripts/c27/c27.rpy:1540
translate german c27s002_LisShopping_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c27/c27.rpy:1541
translate german c27s002_LisShopping_45867f07:

    # lis "*A través de la puerta* Soy yo, ¿puedo pasar?"
    lis "*Durch die Tür* Ich bin's, darf ich hereinkommen?"

# game/scripts/c27/c27.rpy:1542
translate german c27s002_LisShopping_8bd4ab17:

    # mc "Entra, [lis]."
    mc "Geben Sie [lis] ein."

# game/scripts/c27/c27.rpy:1547
translate german c27s002_LisShopping_f23fa279:

    # lis "Hola, [mc]."
    lis "Hallo, [mc]."

# game/scripts/c27/c27.rpy:1549
translate german c27s002_LisShopping_b6034917:

    # mc "Hola, Princesa. ¿Puedo ayudarte en algo?"
    mc "Hallo, Prinzessin. Kann ich Ihnen irgendwie helfen?"

# game/scripts/c27/c27.rpy:1551
translate german c27s002_LisShopping_dad9dfe9:

    # mc "Hola, [lis]. ¿Puedo ayudarte en algo?"
    mc "Hallo [lis]. Kann ich Ihnen irgendwie helfen?"

# game/scripts/c27/c27.rpy:1553
translate german c27s002_LisShopping_31d57116:

    # lis "Venía a ver la cama nueva. ¡Es enorme! Van a ser geniales los abrazos de los domingos."
    lis "Ich bin gekommen, um mir das neue Bett anzusehen. Es ist riesig! Die Kuscheleinheiten am Sonntag werden toll sein."

# game/scripts/c27/c27.rpy:1554
translate german c27s002_LisShopping_2513e8f2:

    # mc "*Risa* En el momento en que se corra la voz sobre los abrazos, estaremos 23 ahí. No sé si cabremos."
    mc "*Gelächter* Sobald sich die Nachricht von den Umarmungen rumspricht, werden wir 23 Leute sein. Ich weiß nicht, ob wir alle da reinpassen."

# game/scripts/c27/c27.rpy:1555
translate german c27s002_LisShopping_251565a1:

    # mc "Creo que será mejor mover los abrazos al jardín de [nor]. Allí se podría unir incluso Jamaal. *Risa* Aquí no va a subir."
    mc "Ich glaube, es wäre besser, die Umarmungen in den Garten von [nor] zu verlegen. Sogar Jamaal könnte da mitmachen. *Lacht* Er kommt nicht hierher."

# game/scripts/c27/c27.rpy:1557
translate german c27s002_LisShopping_8aadbf33:

    # lis "Hablando de Jamaal..."
    lis "Wo wir gerade von Jamaal sprechen..."

# game/scripts/c27/c27.rpy:1558
translate german c27s002_LisShopping_fcd7fd98:

    # mc "¿Qué pasa con él?"
    mc "Was stimmt nicht mit ihm?"

# game/scripts/c27/c27.rpy:1560
translate german c27s002_LisShopping_43b3e756:

    # lis "Esta mañana he visto a Anthony en la universidad. Me ha dicho que los viste juntos..."
    lis "Ich habe Anthony heute Morgen an der Universität gesehen. Er sagte mir, er habe sie zusammen gesehen..."

# game/scripts/c27/c27.rpy:1561
translate german c27s002_LisShopping_68b347b2:

    # mc "Sí. No sabía que él me había visto."
    mc "Ja. Ich wusste nicht, dass er mich gesehen hatte."

# game/scripts/c27/c27.rpy:1562
translate german c27s002_LisShopping_a9ef2025:

    # lis "Bueno, por lo visto se lo ha dicho Jamaal... Y que te ha dicho que salen juntos..."
    lis "Nun ja, anscheinend hat Jamaal es ihr erzählt... Und sie sagte, sie seien ein Paar..."

# game/scripts/c27/c27.rpy:1563
translate german c27s002_LisShopping_fb2bf9d3:

    # mc "¿Y hay algún problema con eso? Supongo que tú no tienes ningún problema con que salgan juntos."
    mc "Und ist das etwa ein Problem? Ich nehme an, Sie haben kein Problem damit, dass sie ein Paar sind."

# game/scripts/c27/c27.rpy:1565
translate german c27s002_LisShopping_e004ddcd:

    # mc "Tú sales conmigo y Anthony con Jamaal. No veo que haya ningún problema."
    mc "Du gehst mit mir aus und Anthony geht mit Jamaal aus. Ich sehe da kein Problem."

# game/scripts/c27/c27.rpy:1567
translate german c27s002_LisShopping_2780200c:

    # lis "No lo digo por mí. Lo digo por ti."
    lis "Ich sage das nicht für mich selbst. Ich sage es für dich."

# game/scripts/c27/c27.rpy:1568
translate german c27s002_LisShopping_2fd84506:

    # mc "¿Por mí? Yo me alegro mucho por Jamaal. Anthony es un tipo afortunado si está saliendo con él."
    mc "Warum ich? Ich freue mich wirklich für Jamaal. Anthony kann sich glücklich schätzen, wenn er mit ihm zusammen ist."

# game/scripts/c27/c27.rpy:1569
translate german c27s002_LisShopping_9c1b2634:

    # mc "*Risa* Y negaré haber dicho eso si alguna vez Jamaal me pregunta."
    mc "*Lacht* Und ich werde abstreiten, das gesagt zu haben, falls Jamaal mich jemals fragt."

# game/scripts/c27/c27.rpy:1571
translate german c27s002_LisShopping_eb66a83e:

    # lis "Espera... ¿qué te ha contado Jamaal sobre Anthony?"
    lis "Moment mal... was hat Jamaal dir über Anthony erzählt?"

# game/scripts/c27/c27.rpy:1572
translate german c27s002_LisShopping_9bfad9b5:

    # mc "Todo. Cómo se conocieron, que tenía dudas sobre su sexualidad cuando estaba intentándolo contigo, cómo empezaron a salir cuando por fin se decidió..."
    mc "Alles. Wie sie sich kennengelernt haben, wie sie Zweifel an ihrer Sexualität hatte, als sie es mit dir versucht hat, wie sie angefangen haben, sich zu treffen, als sie sich endlich entschieden hat..."

# game/scripts/c27/c27.rpy:1573
translate german c27s002_LisShopping_518fd08d:

    # mc "¿Por qué lo preguntas?"
    mc "Warum fragst du?"

# game/scripts/c27/c27.rpy:1575
translate german c27s002_LisShopping_ad2d1023:

    # lis "Me parece raro que no hagas ninguna broma ingeniosa sobre que Jamaal ha acabado saliendo con una chica."
    lis "Ich finde es seltsam, dass du keine witzigen Bemerkungen darüber machst, dass Jamaal am Ende mit einem Mädchen ausgeht."

# game/scripts/c27/c27.rpy:1576
translate german c27s002_LisShopping_e4ee6cd0:

    # lis "Aunque Anthony ya no es una chica, claro. Pero ya sabes... hay gente que no acepta a los trans o que hacen bromas de mal gusto."
    lis "Anthony ist natürlich kein Mädchen mehr. Aber du weißt ja... es gibt Leute, die Transmenschen nicht akzeptieren oder geschmacklose Witze machen."

# game/scripts/c27/c27.rpy:1577
translate german c27s002_LisShopping_4f2d4076:

    # mc "¿Ves? Eso no me lo había contado."
    mc "Siehst du? Das hatte er mir nicht gesagt."

# game/scripts/c27/c27.rpy:1579
translate german c27s002_LisShopping_c0728b24:

    # lis "¡Oops! ¡Acabo de meter la pata!"
    lis "Oh je! Da habe ich Mist gebaut!"

# game/scripts/c27/c27.rpy:1581
translate german c27s002_LisShopping_b54e7bab:

    # lis "Cuando has dicho que te lo había contado todo y lo de sus dudas..."
    lis "Als du sagtest, sie habe dir alles erzählt, auch von ihren Zweifeln..."

# game/scripts/c27/c27.rpy:1582
translate german c27s002_LisShopping_191e4e86:

    # mc "Bueno, parece que me ha contado todo lo que creía que yo debía saber en ese momento."
    mc "Nun, anscheinend hat er mir alles erzählt, was ich seiner Meinung nach zu diesem Zeitpunkt wissen sollte."

# game/scripts/c27/c27.rpy:1583
translate german c27s002_LisShopping_4e762e96:

    # mc "Me dijo que había cosas que no tenía el derecho a contarme. Supongo que se refería a esto."
    mc "Er sagte mir, es gäbe Dinge, die er mir nicht erzählen dürfe. Ich nehme an, er meinte Folgendes."

# game/scripts/c27/c27.rpy:1584
translate german c27s002_LisShopping_25464f9e:

    # mc "Pero me da lo mismo. Jamaal está contento y supongo que Anthony también. Es suficiente para mí."
    mc "Aber das ist mir egal. Jamaal ist glücklich, und ich nehme an, Anthony auch. Das genügt mir."

# game/scripts/c27/c27.rpy:1586
translate german c27s002_LisShopping_88a8e731:

    # lis "Sí. Está muy contento. Lo ha pasado mal y estaba... confuso."
    lis "Ja. Er ist sehr glücklich. Er hatte eine schwere Zeit und war... verwirrt."

# game/scripts/c27/c27.rpy:1587
translate german c27s002_LisShopping_fd2a5197:

    # lis "Cuando me lo explicó se sentía avergonzado, tanto por nuestra situación como por lo que ha tenido que pasar."
    lis "Als er es mir erklärte, schämte er sich, sowohl wegen unserer Situation als auch wegen dem, was er durchmachen musste."

# game/scripts/c27/c27.rpy:1588
translate german c27s002_LisShopping_8faabc56:

    # lis "Me hizo prometer que no se lo contaría a nadie que lo conociera..."
    lis "Er ließ mich versprechen, niemandem, der ihn kannte, davon zu erzählen..."

# game/scripts/c27/c27.rpy:1589
translate german c27s002_LisShopping_73d90374:

    # mc "*Risa* Y me lo has contado a mí por error. ¡Me encantan esos malentendidos!"
    mc "*Lacht* Und das hast du mir versehentlich erzählt! Ich liebe solche Missverständnisse!"

# game/scripts/c27/c27.rpy:1591
translate german c27s002_LisShopping_b732c400:

    # lis "*Risa* ¡Me has dicho que te lo había explicado todo!"
    lis "*lacht* Du hast mir doch gesagt, ich hätte dir alles erklärt!"

# game/scripts/c27/c27.rpy:1592
translate german c27s002_LisShopping_671594a4:

    # mc "*Risa* Yo creía que me lo había explicado todo."
    mc "*lacht* Ich dachte, er hätte mir alles erklärt."

# game/scripts/c27/c27.rpy:1593
translate german c27s002_LisShopping_2379b883:

    # mc "Pero no te preocupes. A mí no se me escapará."
    mc "Aber keine Sorge. Es wird mir nicht entgleiten."

# game/scripts/c27/c27.rpy:1595
translate german c27s002_LisShopping_43773600:

    # lis "¡Eres un capullo!"
    lis "Du bist ein Idiot!"

# game/scripts/c27/c27.rpy:1596
translate german c27s002_LisShopping_aae7dd80:

    # mc "Es posible. *Risa* Me lo dicen mucho."
    mc "Das ist möglich. *lacht* Das höre ich oft."

# game/scripts/c27/c27.rpy:1598
translate german c27s002_LisShopping_b623dc96:

    # mc "Pero soy tu capullo."
    mc "Aber ich bin dein Idiot."

# game/scripts/c27/c27.rpy:1601
translate german c27s002_LisShopping_9f913e33:

    # lis "En eso tienes razón."
    lis "Da haben Sie Recht."

# game/scripts/c27/c27.rpy:1602
translate german c27s002_LisShopping_263518b6:

    # lis "Bueno, me voy, que tengo que coger el bus para ir a la tienda de [mad.nick]."
    lis "So, ich muss dann mal los, ich muss den Bus zum [mad.nick]-Laden erwischen."

# game/scripts/c27/c27.rpy:1603
translate german c27s002_LisShopping_aea36704:

    # mc "¿Vas a comprar más ropa? ¿No tienes suficientes con las cuatro maletas que trajiste?"
    mc "Wirst du noch mehr Kleidung kaufen? Reichen die vier Koffer, die du mitgebracht hast, nicht aus?"

# game/scripts/c27/c27.rpy:1604
translate german c27s002_LisShopping_04d73e84:

    # mc "Mas todo lo que después trajeron los transportistas, claro. Tienes suerte de que tu habitación sea tan grande como la de [emm]."
    mc "Aber natürlich auch alles, was die Lieferanten später brachten. Du hast Glück, dass dein Zimmer so groß ist wie das von [emm]."

# game/scripts/c27/c27.rpy:1607
translate german c27s002_LisShopping_b5799758:

    # lis "*Risa* ¿Vas a decirle a tu princesa cuánta ropa tiene que tener?"
    lis "*lacht* Wirst du deiner Prinzessin etwa vorschreiben, wie viele Kleider sie haben muss?"

# game/scripts/c27/c27.rpy:1609
translate german c27s002_LisShopping_2e1ef9f2:

    # lis "*Risa* ¿Vas a decirle a una chica cuánta ropa tiene que tener?"
    lis "*lacht* Willst du einem Mädchen etwa vorschreiben, wie viele Kleidungsstücke sie besitzen sollte?"

# game/scripts/c27/c27.rpy:1610
translate german c27s002_LisShopping_b71b8e6f:

    # lis "Parece mentira que te hayas criado rodeado de mujeres."
    lis "Es ist unglaublich, dass du von Frauen umgeben aufgewachsen bist."

# game/scripts/c27/c27.rpy:1611
translate german c27s002_LisShopping_e042d083:

    # mc "No me atrevería nunca a decir algo así. *Risa* Sólo preguntaba."
    mc "Ich würde mich nie trauen, so etwas zu sagen. *lacht* Ich habe ja nur gefragt."

# game/scripts/c27/c27.rpy:1612
translate german c27s002_LisShopping_eb84c7af:

    # mc "Pero no hace falta que cojas el bus. Tengo que ir al centro a comprar unas cosas yo también."
    mc "Aber du musst nicht den Bus nehmen. Ich muss auch noch in die Innenstadt, um ein paar Sachen einzukaufen."

# game/scripts/c27/c27.rpy:1613
translate german c27s002_LisShopping_08226d17:

    # mc "Las iba a comprar ayer, pero al encontrarme con Jamaal se me hizo tarde y me olvidé."
    mc "Ich wollte sie eigentlich gestern kaufen, aber als ich Jamaal traf, wurde es spät und ich habe es vergessen."

# game/scripts/c27/c27.rpy:1615
translate german c27s002_LisShopping_e8aab443:

    # lis "¡Genial! Voy a coger el bolso y te espero abajo."
    lis "Super! Ich hole meine Tasche und warte unten auf dich."

# game/scripts/c27/c27.rpy:1616
translate german c27s002_LisShopping_2cbcdd4a:

    # mc "¿Vas a ir así?"
    mc "Willst du das so machen?"

# game/scripts/c27/c27.rpy:1618
translate german c27s002_LisShopping_a4d0d076:

    # lis "¿No te gusta?"
    lis "Gefällt es dir nicht?"

# game/scripts/c27/c27.rpy:1619
translate german c27s002_LisShopping_fa5a65c6:

    # mc "¡Me encanta! Pero me sorprende que quieras ir así fuera de casa. Hace unas semanas te hubieras preocupado por si te veía algún conocido."
    mc "Ich finde es toll! Aber ich bin überrascht, dass du so ausgehen willst. Vor ein paar Wochen hättest du dir bestimmt Sorgen gemacht, dass dich jemand, den du kennst, sieht."

# game/scripts/c27/c27.rpy:1621
translate german c27s002_LisShopping_d9877bfa:

    # lis "Hace unas semanas no sabía lo que era ser libre de todas esas tonterías."
    lis "Vor ein paar Wochen wusste ich noch nicht, wie es ist, von all diesem Unsinn befreit zu sein."

# game/scripts/c27/c27.rpy:1622
translate german c27s002_LisShopping_60799f78:

    # lis "No voy a renunciar a ello."
    lis "Ich werde es nicht aufgeben."

# game/scripts/c27/c27.rpy:1627
translate german c27s002_LisShopping_fb4ba3d1:

    # lis "Hasta ahora mismo. No me canso de besarte."
    lis "Auch jetzt noch. Ich werde nie müde, dich zu küssen."

# game/scripts/c27/c27.rpy:1628
translate german c27s002_LisShopping_b93fdca1:

    # mc "Hasta ahora mismo. Espero que no lo hagas nunca."
    mc "Bis jetzt. Ich hoffe, das passiert nie."

# game/scripts/c27/c27.rpy:1630
translate german c27s002_LisShopping_a25a8417:

    # lis "Hasta ahora mismo."
    lis "Bis jetzt."

# game/scripts/c27/c27.rpy:1631
translate german c27s002_LisShopping_a11fc49b:

    # mc "Te veo en un momento."
    mc "Wir sehen uns gleich."

# game/scripts/c27/c27.rpy:1634
translate german c27s002_LisShopping_c851925d:

    # "Conduces hasta la tienda de [mad.nick] y decides entrar a saludar."
    "Sie fahren zum [mad.nick]-Laden und beschließen, hineinzugehen und Hallo zu sagen."

# game/scripts/c27/c27.rpy:1637
translate german c27s002_LisShopping_0c800e50:

    # "Al llegar a la tienda, [mad.nick] está atendiendo a una clienta."
    "Bei seiner Ankunft im Geschäft bedient [mad.nick] gerade einen Kunden."

# game/scripts/c27/c27.rpy:1638
translate german c27s002_LisShopping_0db051fb:

    # mad "Buenas tardes, [lis] y [mc]. Dadme un segundo para que acabe una cosa."
    mad "Guten Tag, [lis] und [mc]. Geben Sie mir einen Moment, um etwas zu beenden."

# game/scripts/c27/c27.rpy:1639
translate german c27s002_LisShopping_64f9baa0:

    # mc "No te preocupes."
    mc "Mach dir keine Sorge."

# game/scripts/c27/c27.rpy:1640
translate german c27s002_LisShopping_82c8f35a:

    # lis "Voy a ir mirando algo de ropa mientras acabas."
    lis "Ich schaue mir in der Zwischenzeit ein paar Kleidungsstücke an, während du fertig bist."

# game/scripts/c27/c27.rpy:1642
translate german c27s002_LisShopping_5b55aa52:

    # lis "Deberíamos haber venido antes. Cada vez que la madre de [mad.nick] viene, la pone de mal humor."
    lis "Wir hätten früher kommen sollen. Jedes Mal, wenn [mad.nick]s Mutter kommt, ist sie schlecht gelaunt."

# game/scripts/c27/c27.rpy:1643
translate german c27s002_LisShopping_fa0df493:

    # mc "¿Es su madre?"
    mc "Ist sie deine Mutter?"

# game/scripts/c27/c27.rpy:1645
translate german c27s002_LisShopping_9326a7d2:

    # lis "Sí, y su jefa. Tienen varias tiendas en el condado. Ella es la encargada de la tienda de Atascadero."
    lis "Ja, und ihre Chefin. Sie haben mehrere Filialen im Landkreis. Sie leitet die Filiale in Atascadero."

# game/scripts/c27/c27.rpy:1647
translate german c27s002_LisShopping_d8306e1e:

    # mcp "(Ahora entiendo por qué no quería que le mandara las pruebas del chantaje a su jefe.)"
    mcp "(Jetzt verstehe ich, warum er nicht wollte, dass ich die Erpressungsbeweise an seinen Chef weiterleite.)"

# game/scripts/c27/c27.rpy:1648
translate german c27s002_LisShopping_9adfb6ba:

    # mcp "(Hubiera sido malo si sólo hubiera sido su jefe, pero si además es su madre...)"
    mcp "(Es wäre schon schlimm genug gewesen, wenn sie nur seine Chefin wäre, aber wenn sie auch noch seine Mutter ist...)"

# game/scripts/c27/c27.rpy:1649
translate german c27s002_LisShopping_de51f75b:

    # mc "No tenía ni idea."
    mc "Ich hatte keine Ahnung."

# game/scripts/c27/c27.rpy:1651
translate german c27s002_LisShopping_7d909430:

    # lis "Cuando se trata de trabajo, la Sra. Chang no trata a [mad.nick] como a una hija sino como a una empleada."
    lis "Wenn es um die Arbeit geht, behandelt Frau Chang [mad.nick] nicht wie eine Tochter, sondern wie eine Angestellte."

# game/scripts/c27/c27.rpy:1652
translate german c27s002_LisShopping_a8f4664c:

    # lis "Y para dar ejemplo al resto de dependientas, es especialmente estricta con ella. Para que nadie la acuse de favoritismo."
    lis "Und um ein Exempel für die anderen Verkäuferinnen zu statuieren, ist sie besonders streng mit ihr. Damit ihr niemand Vetternwirtschaft vorwerfen kann."

# game/scripts/c27/c27.rpy:1653
translate german c27s002_LisShopping_6f8e1b0f:

    # mc "Que la trate como a una empleada me parece lógico. Lo otro, no tanto."
    mc "Sie wie eine Angestellte zu behandeln, erscheint mir logisch. Der andere Teil eher nicht."

# game/scripts/c27/c27.rpy:1655
translate german c27s002_LisShopping_4b061d2f:

    # lis "Y si como jefa es mala, como madre es de las que están encima permanentemente."
    lis "Und wenn sie schon eine schlechte Chefin ist, so gehört sie als Mutter zu denen, die ständig über ihren Kindern kreisen."

# game/scripts/c27/c27.rpy:1656
translate german c27s002_LisShopping_bbfccba4:

    # lis "Ella y su padre se mudaron a Atascadero hace unos años y [mad.nick] se quedó aquí. No les sentó bien."
    lis "Sie und ihr Vater zogen vor einigen Jahren nach Atascadero und blieben dort. Es gefiel ihnen nicht."

# game/scripts/c27/c27.rpy:1657
translate german c27s002_LisShopping_8edc108f:

    # lis "Desde entonces está encima de ella permanentemente. Intenta fiscalizar cómo vive, si tiene novio..."
    lis "Seitdem ist er ihr ständig auf den Fersen. Er versucht, ihren Lebensstil zu überwachen, ob sie einen Freund hat..."

# game/scripts/c27/c27.rpy:1659
translate german c27s002_LisShopping_df7d90bf:

    # mc "Lo que me da a entender que no le ha dicho que estamos juntos."
    mc "Das lässt mich vermuten, dass er ihr noch nicht gesagt hat, dass wir zusammen sind."

# game/scripts/c27/c27.rpy:1661
translate german c27s002_LisShopping_5a3493eb:

    # mc "Ni que hay un harén por en medio."
    mc "Nicht, dass ein Harem involviert wäre."

# game/scripts/c27/c27.rpy:1663
translate german c27s002_LisShopping_b14d78a4:

    # lis "Exacto. ¿Te imaginas contarle a alguien así que compartes novio con otras mujeres?"
    lis "Genau. Können Sie sich vorstellen, jemandem wie Ihnen zu sagen, dass Sie einen Freund mit anderen Frauen teilen?"

# game/scripts/c27/c27.rpy:1665
translate german c27s002_LisShopping_ad103400:

    # mc "*Risa* Lo imagino perfectamente. Lo viví cuando Meemaw se enteró."
    mc "*Lacht* Ich kann es mir total vorstellen. Ich habe es selbst erlebt, als Meemaw es herausgefunden hat."

# game/scripts/c27/c27.rpy:1667
translate german c27s002_LisShopping_152bf4f7:

    # mc "*Risa* Es normal que quiera ocultárselo a su madre si es así."
    mc "*Lacht* Wenn das der Fall ist, ist es verständlich, dass er es vor seiner Mutter verheimlichen will."

# game/scripts/c27/c27.rpy:1668
translate german c27s002_LisShopping_945a50b5:

    # lis "No todas las madres son como [mar]."
    lis "Nicht alle Mütter sind wie [mar]."

# game/scripts/c27/c27.rpy:1671
translate german c27s002_LisShopping_3c1a0638:

    # lis "Exacto. Quiere ahorrarse las charlas. No todas las madres son como [mar]."
    lis "Genau. Sie will den Vorträgen aus dem Weg gehen. Nicht alle Mütter sind so [mar]."

# game/scripts/c27/c27.rpy:1672
translate german c27s002_LisShopping_43a9c5db:

    # lis "Si le dice que sale contigo, va a tener que pasar por un interrogatorio."
    lis "Wenn du ihm sagst, dass du mit ihm ausgehst, muss er sich einem Verhör unterziehen."

# game/scripts/c27/c27.rpy:1674
translate german c27s002_LisShopping_8ec801d4:

    # mc "Y es normal que [mad.nick] no quiera decirle nada, supongo."
    mc "Und es ist wohl normal, dass [mad.nick] nichts sagen will."

# game/scripts/c27/c27.rpy:1676
translate german c27s002_LisShopping_fe35a080:

    # lis "Exacto. Cuanto más encima está de ella, más evita [mad.nick] decirle nada. No todas las madres son como [mar]."
    lis "Genau. Je mehr er auf ihr liegt, desto weniger sagt sie ihm etwas. Nicht alle Mütter sind so."

# game/scripts/c27/c27.rpy:1678
translate german c27s002_LisShopping_2815e486:

    # lis "Ya sé que no es tu madre, pero es difícil verla de otra manera."
    lis "Ich weiß, sie ist nicht deine Mutter, aber es ist schwer, sie anders zu sehen."

# game/scripts/c27/c27.rpy:1679
translate german c27s002_LisShopping_a5a0c903:

    # mc "La verdad es que tengo mucha suerte."
    mc "Die Wahrheit ist, dass ich sehr viel Glück habe."

# game/scripts/c27/c27.rpy:1681
translate german c27s002_LisShopping_b5cfcca3:

    # mc "Hablando de madres... ¿Les has dicho algo a tus padres sobre nosotros?"
    mc "Wo wir gerade von Müttern sprechen... Habt ihr euren Eltern schon etwas über uns erzählt?"

# game/scripts/c27/c27.rpy:1683
translate german c27s002_LisShopping_951a1c91:

    # lis "Todavía no. Si lo hiciera, al día siguiente estarían aquí para conocerte. O en el mismo día, si se lo digo por la mañana."
    lis "Noch nicht. Wenn ich es täte, wären sie am nächsten Tag hier, um dich zu treffen. Oder noch am selben Tag, wenn ich es ihnen morgens sagen würde."

# game/scripts/c27/c27.rpy:1684
translate german c27s002_LisShopping_b0b7191c:

    # lis "No quiero ponerte en ese compromiso sin antes consultarlo contigo."
    lis "Ich möchte Sie nicht in diese Lage bringen, ohne Sie vorher zu konsultieren."

# game/scripts/c27/c27.rpy:1685
translate german c27s002_LisShopping_4de3387b:

    # mc "Si no te avergüenzas de mí o de nuestra relación, no tengo ningún problema en conocerlos."
    mc "Wenn du dich weder für mich noch für unsere Beziehung schämst, habe ich kein Problem damit, sie kennenzulernen."

# game/scripts/c27/c27.rpy:1687
translate german c27s002_LisShopping_7b42a386:

    # mc "Pero quedaría el tema de [deb.nick]. No sé si estarían muy contentos de que salga con sus dos princesas."
    mc "Aber da ist noch das Problem mit [deb.nick]. Ich weiß nicht, ob sie sehr erfreut wären, wenn ich mit ihren beiden Prinzessinnen ausgehen würde."

# game/scripts/c27/c27.rpy:1689
translate german c27s002_LisShopping_86f99448:

    # lis "*Risa* Creía que la princesa era yo."
    lis "*lacht* Ich dachte, ich wäre die Prinzessin."

# game/scripts/c27/c27.rpy:1690
translate german c27s002_LisShopping_d7ce8473:

    # mc "No sé si las dos sois sus princesas, pero las dos sois las mías."
    mc "Ich weiß nicht, ob ihr beide seine Prinzessinnen seid, aber ihr seid beide meine."

# game/scripts/c27/c27.rpy:1692
translate german c27s002_LisShopping_3bd9dca0:

    # lis "Seguramente si les dijéramos que las dos salimos contigo vendrían igual, pero con las escopetas de caza. *Risa*"
    lis "Ich bin mir sicher, wenn wir ihnen erzählen würden, dass wir beide mit dir ausgegangen sind, würden sie trotzdem kommen – aber dann mit Jagdgewehren. *Gelächter*"

# game/scripts/c27/c27.rpy:1693
translate german c27s002_LisShopping_2b3da418:

    # mc "Un enfrentamiento a tiros entre tus padres y [ama] y [eva]... *Risa* Interesante."
    mc "Eine Schießerei zwischen deinen Eltern und [ama] und [eva]... *Lacht* Interessant."

# game/scripts/c27/c27.rpy:1695
translate german c27s002_LisShopping_0804bb63:

    # mc "Pero quedaría el tema del harén. No sé si estarían muy contentos de que salgas con alguien que sale con otras mujeres."
    mc "Aber dann ist da noch das Problem mit dem Harem. Ich weiß nicht, ob sie sehr erfreut wären, wenn du mit jemandem zusammen wärst, der auch andere Frauen trifft."

# game/scripts/c27/c27.rpy:1697
translate german c27s002_LisShopping_61fddefa:

    # lis "Seguramente si se lo dijera vendrían igual, pero con las escopetas de caza. *Risa*"
    lis "Ich bin mir sicher, wenn ich es ihnen sagen würde, würden sie trotzdem kommen – aber dann mit Jagdgewehren. *Gelächter*"

# game/scripts/c27/c27.rpy:1698
translate german c27s002_LisShopping_2b3da418_1:

    # mc "Un enfrentamiento a tiros entre tus padres y [ama] y [eva]... *Risa* Interesante."
    mc "Eine Schießerei zwischen deinen Eltern und [ama] und [eva]... *Lacht* Interessant."

# game/scripts/c27/c27.rpy:1700
translate german c27s002_LisShopping_88a51c21:

    # lis "Pero, en serio, no me avergüenzo de nada, con lo que lo tendrán que aceptar. Pero prefiero dejar pasar un tiempo antes de decírselo."
    lis "Aber ehrlich gesagt schäme ich mich für nichts, also müssen sie es akzeptieren. Ich würde aber lieber noch etwas warten, bevor ich es ihnen sage."

# game/scripts/c27/c27.rpy:1701
translate german c27s002_LisShopping_f8a615ba:

    # lis "Lo de 'Mamá, llevo tres semanas aquí y estoy saliendo con alguien' no quedaría muy bien a los ojos de mis padres."
    lis "Wenn ich sagen würde: „Mama, ich bin seit drei Wochen hier und habe einen Freund“, käme das bei meinen Eltern nicht gut an."

# game/scripts/c27/c27.rpy:1702
translate german c27s002_LisShopping_e0425937:

    # mc "Se lo diremos cuando quieras. Cuenta conmigo para ello."
    mc "Wir sagen ihm Bescheid, sobald du bereit bist. Ich bin dabei."

# game/scripts/c27/c27.rpy:1704
translate german c27s002_LisShopping_85e69441:

    # lis "Pienso que, como en el caso de [mad.nick], no tienen que tener voz ni voto en con quien salgo. Soy una adulta y es mi decisión."
    lis "Ich finde, dass sie, genau wie im Fall von [mad.nick], kein Mitspracherecht bei meinen Partnerwahlen haben sollten. Ich bin erwachsen und es ist meine Entscheidung."

# game/scripts/c27/c27.rpy:1705
translate german c27s002_LisShopping_312796d9:

    # mc "Estoy de acuerdo, pero supongo que quieren cuidar de ti y evitar que cometas errores."
    mc "Ich stimme zu, aber ich nehme an, sie wollen sich um dich kümmern und dich vor Fehlern bewahren."

# game/scripts/c27/c27.rpy:1708
translate german c27s002_LisShopping_737cb19d:

    # mad "Ya hemos acabado, chicos. ¿En qué puedo ayudaros?"
    mad "Wir sind fertig, Leute. Wie kann ich euch helfen?"

# game/scripts/c27/c27.rpy:1710
translate german c27s002_LisShopping_38896d65:

    # mad "[mc], ven. Quiero presentarte a mi madre, Rose."
    mad "[mc], komm her. Ich möchte dir meine Mutter Rose vorstellen."

# game/scripts/c27/c27.rpy:1712
translate german c27s002_LisShopping_8c8a1cab:

    # mc "Encantado de conocerla, Sra. Chang."
    mc "Es freut mich, Sie kennenzulernen, Frau Chang."

# game/scripts/c27/c27.rpy:1713
translate german c27s002_LisShopping_e8bf7152:

    # "Sra. Chang" "Igualmente. ¿Eres amigo de mi hija?"
    "Sra. Chang" "Ebenso. Sind Sie eine Freundin meiner Tochter?"

# game/scripts/c27/c27.rpy:1714
translate german c27s002_LisShopping_bf617666:

    # mc "Sí, somos buenos amigos."
    mc "Ja, wir sind gute Freunde."

# game/scripts/c27/c27.rpy:1716
translate german c27s002_LisShopping_de7ec540:

    # "Sra. Chang" "Y no tendrás un amigo soltero, ¿verdad? Porque tú estás con [lis], ¿verdad?"
    "Sra. Chang" "Und du wirst keinen einzigen Freund haben, oder? Weil du ja mit [lis] zusammen bist, richtig?"

# game/scripts/c27/c27.rpy:1717
translate german c27s002_LisShopping_71569921:

    # "Sra. Chang" "A este paso, [mad] va a parecer un meme. Llegará a los 30 sola y con su piso lleno de gatos. Ya ha empezado."
    "Sra. Chang" "Bei dem Tempo wird [mad] bald wie ein Meme aussehen. Sie wird mit 30 ganz allein in ihrer Wohnung voller Katzen leben. Es hat schon angefangen."

# game/scripts/c27/c27.rpy:1718
translate german c27s002_LisShopping_71b56c4c:

    # "Te cae mal inmediatamente. Sabes que [mad.nick] odia que la llamen [mad] y, pese a todo, su madre usa ese nombre. Te enfadas inmediatamente."
    "Du magst sie auf Anhieb nicht. Du weißt, dass [mad.nick] es hasst, [mad] genannt zu werden, und trotzdem benutzt ihre Mutter diesen Namen. Du wirst sofort wütend."

# game/scripts/c27/c27.rpy:1719
translate german c27s002_LisShopping_219b4e47:

    # "Además, tiene una de esas sonrisas que no llegan a los ojos. Una sonrisa tan falsa como un billete naranja de 100 dólares."
    "Außerdem hat sie so ein Lächeln, das ihre Augen nicht erreicht. Ein Lächeln so unecht wie ein Hunderter."

# game/scripts/c27/c27.rpy:1720
translate german c27s002_LisShopping_c8725dbd:

    # mcp "(¿Quién eres tú para decidir cómo tiene que vivir su vida [mad.nick]?)"
    mcp "(Wer bist du, dass du entscheidest, wie sie ihr Leben leben soll?)"

# game/scripts/c27/c27.rpy:1721
translate german c27s002_LisShopping_fd49d41c:

    # mcp "(Si quiere tener diez gatos, ¿qué más da?)"
    mcp "(Wenn er zehn Katzen haben will, was macht das schon für einen Unterschied?)"

# game/scripts/c27/c27.rpy:1722
translate german c27s002_LisShopping_cca94157:

    # "Tu enfado evita que pase por tu mente la idea de que, con diez gatos, vas a gastar un montón de dinero en camas."
    "Deine Wut hindert dich daran, darüber nachzudenken, dass du mit zehn Katzen viel Geld für Betten ausgeben wirst."

# game/scripts/c27/c27.rpy:1723
translate german c27s002_LisShopping_d2df6d5f:

    # mc "Tengo amigos solteros..."
    mc "Ich habe Single-Freunde..."

# game/scripts/c27/c27.rpy:1724
translate german c27s002_LisShopping_1530b853:

    # "La sangre empieza a hervirte en las venas. Nunca has podido soportar este tipo de madre, y menos aún con lo que te ha dicho [lis]."
    "Dein Blut kocht in deinen Adern. Du konntest diese Art von Mutter noch nie ausstehen, und erst recht nicht nach dem, was [lis] zu dir gesagt hat."

# game/scripts/c27/c27.rpy:1727
translate german c27s002_LisShopping_6ab204f3:

    # "Miras a [mad.nick], que entiende tu pregunta y da su aprobación con un ligero asentimiento."
    "Du schaust [mad.nick] an, der deine Frage versteht und mit einem leichten Nicken seine Zustimmung gibt."

# game/scripts/c27/c27.rpy:1729
translate german c27s002_LisShopping_d92193b9:

    # mc "Pero no se preocupe. No va a llegar sola ni a los 30 ni a los 27."
    mc "Aber keine Sorge. Sie wird nicht allein 30 oder 27 Jahre alt werden."

# game/scripts/c27/c27.rpy:1733
translate german c27s002_LisShopping_41f36e33:

    # "Rodeas a la diminuta mujer pese a su cara de perplejidad y besas dulcemente a [mad.nick]."
    "Du umkreist die kleine Frau trotz ihres verwirrten Gesichtsausdrucks und küsst sie zärtlich."

# game/scripts/c27/c27.rpy:1734
translate german c27s002_LisShopping_eaf682cd:

    # "Al principio se tensa un poco por la sorpresa, quizás has malinterpretado su asentimiento."
    "Zunächst zuckt er vor Überraschung etwas zusammen; vielleicht haben Sie sein Nicken falsch gedeutet."

# game/scripts/c27/c27.rpy:1735
translate german c27s002_LisShopping_aa25d2fb:

    # "No tarda en devolverte el beso. Abrazándote con fuerza. Como un náufrago agarrándose a una madera en medio de una tormenta."
    "Er zögert nicht, den Kuss zu erwidern. Er hält dich fest. Wie ein Schiffbrüchiger, der sich inmitten eines Sturms an ein Stück Holz klammert."

# game/scripts/c27/c27.rpy:1737
translate german c27s002_LisShopping_7b9f2754:

    # "Cuando vuelves a mirar a la odiosa mujer, su cara de sorpresa es genuina. Ya no hay falsedad en ella."
    "Als man die hasserfüllte Frau erneut ansah, war ihr überraschter Gesichtsausdruck echt. Da war keine Heuchelei mehr zu erkennen."

# game/scripts/c27/c27.rpy:1738
translate german c27s002_LisShopping_7d6cecab:

    # mc "Va a llegar a los 30, a los 60, o a los 90 conmigo, si ella quiere."
    mc "Sie wird mit mir 30, 60 oder 90 Jahre alt, wenn sie will."

# game/scripts/c27/c27.rpy:1739
translate german c27s002_LisShopping_bb4942ae:

    # "Sra. Chang" "¿Qué? ¿Cuándo? ¿Desde cuándo?"
    "Sra. Chang" "Was? Wann? Seit wann?"

# game/scripts/c27/c27.rpy:1740
translate german c27s002_LisShopping_b58a242e:

    # "Sabes que enemistarte con tu futura suegra nada más conocerla no es una buena idea. Pero tienes que dejarle las cosas claras desde el principio."
    "Du weißt, dass es keine gute Idee ist, sich gleich beim ersten Treffen mit deiner zukünftigen Schwiegermutter zu verfeinden. Aber du musst ihr von Anfang an die Dinge klar machen."

# game/scripts/c27/c27.rpy:1741
translate german c27s002_LisShopping_db7d7c16:

    # mc "Si [mad.nick] no se lo ha querido contar, pregúntese por qué."
    mc "Wenn [mad.nick] es Ihnen nicht sagen wollte, fragen Sie sich, warum."

# game/scripts/c27/c27.rpy:1742
translate german c27s002_LisShopping_fccbb515:

    # mc "Adiós, Sra. Chang. Yo que usted, empezaría a llamar a [mad.nick] por el nombre que ella prefiere."
    mc "Auf Wiedersehen, Frau Chang. An Ihrer Stelle würde ich [mad.nick] mit dem Namen ansprechen, den sie bevorzugt."

# game/scripts/c27/c27.rpy:1744
translate german c27s002_LisShopping_5fa20d9d:

    # mc "Te espero en el café en el que te esperé la primera vez que fuimos a tu piso."
    mc "Ich werde in dem Café auf dich warten, in dem ich auch schon beim ersten Besuch in deiner Wohnung auf dich gewartet habe."

# game/scripts/c27/c27.rpy:1745
translate german c27s002_LisShopping_2aa284cc:

    # "Falta menos de una hora para que cierre la tienda."
    "Bis Ladenschluss ist es weniger als eine Stunde."

# game/scripts/c27/c27.rpy:1746
translate german c27s002_LisShopping_fcab085b:

    # mad "Hasta luego, [mc]."
    mad "Bis später, [mc]."

# game/scripts/c27/c27.rpy:1750
translate german c27s002_LisShopping_d3295029:

    # "Rodeas a la diminuta mujer pese a su cara de perplejidad y abrazas fuertemente a [mad.nick]."
    "Du umkreist die kleine Frau trotz ihres verwirrten Gesichtsausdrucks und umarmst [mad.nick] fest."

# game/scripts/c27/c27.rpy:1751
translate german c27s002_LisShopping_ecb4615c:

    # "Su sorpresa no evita que te devuelva el abrazo. Con fuerza. Como un náufrago agarrándose a una madera en medio de una tormenta."
    "Seine Überraschung hindert ihn nicht daran, die Umarmung zu erwidern. Fest. Wie ein Schiffbrüchiger, der sich inmitten eines Sturms an ein Stück Treibholz klammert."

# game/scripts/c27/c27.rpy:1752
translate german c27s002_LisShopping_e1686f81:

    # mc "*Susurro* No estás sola."
    mc "*Flüstern* Du bist nicht allein."

# game/scripts/c27/c27.rpy:1754
translate german c27s002_LisShopping_7b9f2754_1:

    # "Cuando vuelves a mirar a la odiosa mujer, su cara de sorpresa es genuina. Ya no hay falsedad en ella."
    "Als man die hasserfüllte Frau erneut ansah, war ihr überraschter Gesichtsausdruck echt. Da war keine Heuchelei mehr zu erkennen."

# game/scripts/c27/c27.rpy:1755
translate german c27s002_LisShopping_30bafe72:

    # mc "Va a llegar a los 30, a los 60, o a los 90 con una familia que no se mete en cómo vive su vida."
    mc "Er wird 30, 60 oder 90 Jahre alt werden und eine Familie haben, die sich nicht in seine Lebensweise einmischt."

# game/scripts/c27/c27.rpy:1756
translate german c27s002_LisShopping_48ffa719:

    # mcp "(Y si por eso entiendes que estamos juntos, es tu problema.)"
    mcp "(Und falls du deswegen denkst, wir wären zusammen, ist das dein Problem.)"

# game/scripts/c27/c27.rpy:1757
translate german c27s002_LisShopping_bb4942ae_1:

    # "Sra. Chang" "¿Qué? ¿Cuándo? ¿Desde cuándo?"
    "Sra. Chang" "Was? Wann? Seit wann?"

# game/scripts/c27/c27.rpy:1758
translate german c27s002_LisShopping_db7d7c16_1:

    # mc "Si [mad.nick] no se lo ha querido contar, pregúntese por qué."
    mc "Wenn [mad.nick] es Ihnen nicht sagen wollte, fragen Sie sich, warum."

# game/scripts/c27/c27.rpy:1759
translate german c27s002_LisShopping_fccbb515_1:

    # mc "Adiós, Sra. Chang. Yo que usted, empezaría a llamar a [mad.nick] por el nombre que ella prefiere."
    mc "Auf Wiedersehen, Frau Chang. An Ihrer Stelle würde ich [mad.nick] mit dem Namen ansprechen, den sie bevorzugt."

# game/scripts/c27/c27.rpy:1761
translate german c27s002_LisShopping_1eaba6f4:

    # mc "Te espero para tomar un café en las galerías cuando cierres, [mad.nick]."
    mc "Ich warte, bis du in den Galerien einen Kaffee getrunken hast, wenn du schließt, [mad.nick]."

# game/scripts/c27/c27.rpy:1762
translate german c27s002_LisShopping_2aa284cc_1:

    # "Falta menos de una hora para que cierre la tienda."
    "Bis Ladenschluss ist es weniger als eine Stunde."

# game/scripts/c27/c27.rpy:1763
translate german c27s002_LisShopping_2d9ac33c:

    # mad "Me parece una idea genial, [mc]."
    mad "Ich finde das eine tolle Idee, [mc]."

# game/scripts/c27/c27.rpy:1765
translate german c27s002_LisShopping_eeaa46a4:

    # "Te diriges a despedirte de [lis]."
    "Du wirst dich von [lis] verabschieden."

# game/scripts/c27/c27.rpy:1767
translate german c27s002_LisShopping_89ccbad9:

    # "Hay algo en su mirada que te dice que no es buena idea besarla para despedirte."
    "Irgendetwas in ihrem Blick sagt einem, dass es keine gute Idee ist, sie zum Abschied zu küssen."

# game/scripts/c27/c27.rpy:1768
translate german c27s002_LisShopping_883f391b:

    # mc "¿Necesitas que te lleve a casa luego?"
    mc "Soll ich Sie anschließend nach Hause bringen?"

# game/scripts/c27/c27.rpy:1769
translate german c27s002_LisShopping_4cab6c6e:

    # lis "*Susurrando* No hace falta, gracias. Voy a quedarme aquí hasta que [mad.nick] cierre para evitar que su madre la bombardee a preguntas."
    lis "*Flüsternd* Nein, danke. Ich bleibe hier, bis [mad.nick] schließt, damit ihre Mutter sie nicht mit Fragen bombardiert."

# game/scripts/c27/c27.rpy:1771
translate german c27s002_LisShopping_2d45dde2:

    # lis "*Susurrando* Después cogeré un Under para volver a casa y os dejo solos tomando ese café."
    lis "*Flüsternd* Dann nehme ich ein Under, gehe nach Hause und lasse euch zwei allein, damit ihr euren Kaffee trinken könnt."

# game/scripts/c27/c27.rpy:1773
translate german c27s002_LisShopping_57f7bd9a:

    # lis "*Susurrando* Después la acompañaré a ese café, si no te importa."
    lis "*flüstert* Ich begleite sie später in das Café, wenn es Ihnen nichts ausmacht."

# game/scripts/c27/c27.rpy:1774
translate german c27s002_LisShopping_82347b9c:

    # mc "Para nada. Eres bienvenida a ese café."
    mc "Keineswegs. Sie sind in diesem Café herzlich willkommen."

# game/scripts/c27/c27.rpy:1776
translate german c27s002_LisShopping_7b54a79b:

    # lis "*Susurrando* ¡Eso ha sido increíble!"
    lis "*Flüsternd* Das war fantastisch!"

# game/scripts/c27/c27.rpy:1777
translate german c27s002_LisShopping_8deaffbb:

    # "No podías imaginar que [lis] pudiera saltar tanto."
    "Man konnte sich nicht vorstellen, dass [lis] so weit springen konnte."

# game/scripts/c27/c27.rpy:1778
translate german c27s002_LisShopping_d8907418:

    # lis "*Susurrando* Cómo has dejado a su madre con la boca abierta... No mires, pero sigue con la boca abierta."
    lis "*Flüsternd* Wie du ihre Mutter sprachlos gemacht hast... Schau nicht hin, aber lass den Mund offen."

# game/scripts/c27/c27.rpy:1780
translate german c27s002_LisShopping_e18668d3:

    # lis "*Susurrando* Empiezo a estar un poco menos asustada porque conozcas a mis padres."
    lis "*flüsternd* Ich fange an, etwas weniger Angst davor zu haben, dass du meine Eltern kennenlernst."

# game/scripts/c27/c27.rpy:1781
translate german c27s002_LisShopping_bdfb1a38:

    # mc "*Susurrando* ¿Estabas asustada por mí? *Risa*"
    mc "*flüstert* Hattest du Angst vor mir? *lacht*"

# game/scripts/c27/c27.rpy:1782
translate german c27s002_LisShopping_6223ac9c:

    # lis "*Susurrando* Un poco. Pero ahora empiezo a estar asustada por ellos. *Risa*"
    lis "*flüstert* Ein bisschen. Aber jetzt fange ich an, Angst vor ihnen zu bekommen. *lacht*"

# game/scripts/c27/c27.rpy:1784
translate german c27s002_LisShopping_9d61532f:

    # mc "*Risa* Te veo en casa."
    mc "*Lacht* Wir sehen uns zu Hause."

# game/scripts/c27/c27.rpy:1786
translate german c27s002_LisShopping_ea439639:

    # mc "*Risa* Te veo en el café."
    mc "*Lacht* Wir sehen uns im Café."

# game/scripts/c27/c27.rpy:1788
translate german c27s002_LisShopping_de647f73:

    # "Te vas de la tienda sin una palabra más. Sintiéndote un como un personaje de una serie policiaca mala ambientada en Miami."
    "Du verlässt den Laden wortlos. Du fühlst dich wie eine Figur in einer schlechten Krimiserie, die in Miami spielt."

# game/scripts/c27/c27.rpy:1789
translate german c27s002_LisShopping_fd996490:

    # "Sólo te falta ser pelirrojo y tener unas gafas de sol."
    "Man muss nur rothaarig sein und eine Sonnenbrille tragen."

# game/scripts/c27/c27.rpy:1791
translate german c27s002_LisShopping_4c5c7d99:

    # "Y una explosión detrás tuyo. Casi esperas escuchar la cabeza de la madre de [mad.nick] explotar en cualquier momento."
    "Und hinter dir eine Explosion. Man erwartet fast, dass jeden Moment der Kopf von [mad.nick]s Mutter explodiert."

# game/scripts/c27/c27.rpy:1797
translate german c27s002_AmaAtCollege2_1bb26e2a:

    # "Nada más salir de la tienda..."
    "Sobald ich den Laden verlassen hatte..."

# game/scripts/c27/c27.rpy:1799
translate german c27s002_AmaAtCollege2_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c27/c27.rpy:1802
translate german c27s002_AmaAtCollege2_3b5b6806:

    # mc "Hola, [ama]. ¿Algún problema en la universidad?"
    mc "Hallo [ama]. Gibt es irgendwelche Probleme an der Uni?"

# game/scripts/c27/c27.rpy:1804
translate german c27s002_AmaAtCollege2_ef4f1672:

    # ama "Ya he hecho lo de [sim]. Pero hay un problema con lo de [eil]."
    ama "Den Teil mit [sim] habe ich schon gemacht. Aber es gibt ein Problem mit dem Teil mit [eil]."

# game/scripts/c27/c27.rpy:1805
translate german c27s002_AmaAtCollege2_29714f61:

    # mc "¿Qué ha pasado?"
    mc "Was ist passiert?"

# game/scripts/c27/c27.rpy:1807
translate german c27s002_AmaAtCollege2_93cc5a15:

    # ama "Alguien ha pagado su matrícula. Se te han adelantado."
    ama "Jemand hat seine Studiengebühren bereits bezahlt. Er war schneller als du."

# game/scripts/c27/c27.rpy:1808
translate german c27s002_AmaAtCollege2_087a9f9f:

    # mc "¿Quién ha sido? ¿Lo has podido averiguar?"
    mc "Wer war es? Konntest du es herausfinden?"

# game/scripts/c27/c27.rpy:1810
translate german c27s002_AmaAtCollege2_7f9e2ed4:

    # ama "Me ha atendido Anthony y no me ha querido decir quién lo ha hecho, pero me lo puedo imaginar. [lis] y [deb.nick]."
    ama "Anthony hat mir geholfen und wollte mir nicht verraten, wer es war, aber ich kann es mir vorstellen. [lis] und [deb.nick]."

# game/scripts/c27/c27.rpy:1811
translate german c27s002_AmaAtCollege2_06df0aab:

    # mc "Tiene lógica. Hasta ayer eran las únicas a las que les sobraba el dinero para hacerlo."
    mc "Das leuchtet ein. Bis gestern waren sie die Einzigen, die genug Geld dafür hatten."

# game/scripts/c27/c27.rpy:1812
translate german c27s002_AmaAtCollege2_c6a16c9b:

    # mc "Me extraña que no hayan hecho lo mismo con [sim]."
    mc "Ich bin überrascht, dass sie das nicht auch mit [sim] gemacht haben."

# game/scripts/c27/c27.rpy:1814
translate german c27s002_AmaAtCollege2_790b0888:

    # ama "Sobre eso, a Anthony se le ha escapado algo. Ha dicho, 'Ellas lo intentaron, pero no teníamos su expediente'."
    ama "Anthony ließ dabei etwas durchblicken. Er sagte: „Sie haben es versucht, aber wir hatten ihre Akte nicht.“"

# game/scripts/c27/c27.rpy:1815
translate german c27s002_AmaAtCollege2_21ef7a27:

    # ama "Ese 'Ellas' deja muy claro quiénes son."
    ama "Dass „Sie“ verwendet wird, macht sehr deutlich, wer gemeint ist."

# game/scripts/c27/c27.rpy:1816
translate german c27s002_AmaAtCollege2_14280410:

    # mc "*Risa* Por suerte no lo consiguieron, o te hubieras quedado sin los pierogis de agradecimiento."
    mc "*Lacht* Zum Glück ist es ihnen nicht gelungen, sonst hättest du die Dankeschön-Pierogi verpasst."

# game/scripts/c27/c27.rpy:1818
translate german c27s002_AmaAtCollege2_7137c4fb:

    # ama "*Risa* ¡No me hables de pierogis! Se me remueven en el estómago y a la vez tengo una sensación de antojo."
    ama "*Lacht* Sprich mich bloß nicht auf Piroggen an! Davon wird mir ganz übel und ich bekomme plötzlich Heißhunger darauf."

# game/scripts/c27/c27.rpy:1819
translate german c27s002_AmaAtCollege2_5c8c93f4:

    # mc "*Risa* ¿Sabes que cada vez estoy más orgulloso de todas vosotras?"
    mc "*lacht* Wisst ihr, ich bin immer stolzer auf euch alle?"

# game/scripts/c27/c27.rpy:1821
translate german c27s002_AmaAtCollege2_61a8b7ac:

    # ama "¿Por hacer lo que ibas a hacer tú? ¿No te sientes cómo si te hubieran robado la oportunidad de hacer algo por [eil]?"
    ama "Weil du das getan hast, was du vorhattest? Hast du nicht das Gefühl, dass dir die Gelegenheit genommen wurde, etwas für [eil] zu tun?"

# game/scripts/c27/c27.rpy:1822
translate german c27s002_AmaAtCollege2_678d7865:

    # mc "No lo hacía por 'hacer algo por ella'. El objetivo era que ella volviera a estudiar, no que nadie me lo agradeciera."
    mc "Ich tat es nicht, um „etwas für sie zu tun“. Mein Ziel war, dass sie ihr Studium wieder aufnimmt, nicht, dass mir irgendjemand dankt."

# game/scripts/c27/c27.rpy:1823
translate german c27s002_AmaAtCollege2_3d693cf9:

    # mc "Da lo mismo si el objetivo se ha cumplido gracias a las hermanas o a mí. Lo importante es que [eil] va a poder volver a la universidad."
    mc "Ob das Ziel dank der Schwestern oder mir erreicht wurde, ist unerheblich. Wichtig ist nur, dass [eil] wieder an die Universität zurückkehren kann."

# game/scripts/c27/c27.rpy:1825
translate german c27s002_AmaAtCollege2_f1f6e6e7:

    # ama "Al menos, a ti no te engordarán con una tonelada de pierogis."
    ama "Zumindest wird man nicht dick, wenn man Unmengen an Piroggen isst."

# game/scripts/c27/c27.rpy:1826
translate german c27s002_AmaAtCollege2_8ae1333a:

    # mc "Tienes que aprender que incluso a [sam.nick] le puedes decir que no quieres más."
    mc "Du musst lernen, dass du sogar [sam.nick] sagen kannst, dass du nichts mehr willst."

# game/scripts/c27/c27.rpy:1828
translate german c27s002_AmaAtCollege2_8c8535bb:

    # ama "Pero estaban tan buenos..."
    ama "Aber sie waren so gut..."

# game/scripts/c27/c27.rpy:1829
translate german c27s002_AmaAtCollege2_cbf18df4:

    # mc "Y es agradable sentir el agradecimiento, ¿verdad?"
    mc "Und es ist schön, diese Dankbarkeit zu spüren, nicht wahr?"

# game/scripts/c27/c27.rpy:1831
translate german c27s002_AmaAtCollege2_1d834f65:

    # ama "Es una pasada. No por el agradecimiento en sí, sino por lo bien que me estaba sintiendo yo por haber pensado en una forma de ayudar."
    ama "Es ist erstaunlich. Nicht wegen der Dankbarkeit an sich, sondern weil ich mich so gut fühlte, weil ich eine Möglichkeit gefunden hatte zu helfen."

# game/scripts/c27/c27.rpy:1832
translate german c27s002_AmaAtCollege2_1308f261:

    # ama "Ver la alegría de [sim] porque por fin va a poder ir a la universidad ha sido increíble."
    ama "Die Freude von [sim] darüber zu sehen, dass sie endlich an die Universität gehen kann, war unglaublich."

# game/scripts/c27/c27.rpy:1833
translate german c27s002_AmaAtCollege2_fbe1e849:

    # ama "Saber que la idea que ha propiciado esa alegría ha sido mía... No sé... Produce una sensación de calor en el estómago."
    ama "Zu wissen, dass die Idee, die diese Freude ausgelöst hat, von mir stammt... ich weiß nicht... es erzeugt ein warmes Gefühl in meinem Bauch."

# game/scripts/c27/c27.rpy:1834
translate german c27s002_AmaAtCollege2_24ef719a:

    # mc "*Risa* ¡Eso eran los pierogis!"
    mc "*Gelächter* Genau das waren Piroggen!"

# game/scripts/c27/c27.rpy:1836
translate german c27s002_AmaAtCollege2_7b8555d9:

    # ama "*Risa* ¡Capullo! ¡No voy a comer en dos días!"
    ama "*Lacht* Du Idiot! Ich werde zwei Tage lang nichts essen!"

# game/scripts/c27/c27.rpy:1837
translate german c27s002_AmaAtCollege2_d2e0dce1:

    # mc "¿No vienes a cenar a casa hoy?"
    mc "Kommst du heute Abend nicht zum Abendessen vorbei?"

# game/scripts/c27/c27.rpy:1838
translate german c27s002_AmaAtCollege2_4dbefcfe:

    # ama "*Risa* Sí. Por eso no he dicho en qué dos días. Seguramente me ponga a dieta cuando lleguemos a Aruba."
    ama "*Lacht* Ja. Deshalb habe ich ja noch nicht gesagt, welche zwei Tage. Ich werde wahrscheinlich eine Diät machen, wenn wir auf Aruba sind."

# game/scripts/c27/c27.rpy:1839
translate german c27s002_AmaAtCollege2_f6149705:

    # mc "*Risa* ¿Entiendes ahora por qué estaba gordo?"
    mc "*lacht* Verstehst du jetzt, warum ich dick war?"

# game/scripts/c27/c27.rpy:1841
translate german c27s002_AmaAtCollege2_cfacdf2c:

    # ama "Lo que no entiendo es cómo no te deprimiste cuando fuiste a Portland y tuviste que dejar de comer los platos de [mar], [nor], y [sam.nick]."
    ama "Was ich nicht verstehe, ist, wie du nicht deprimiert wurdest, als du nach Portland gefahren bist und aufhören musstest, die Gerichte aus [mar], [nor] und [sam.nick] zu essen."

# game/scripts/c27/c27.rpy:1842
translate german c27s002_AmaAtCollege2_27082def:

    # mc "*Risa* Busqué un jefe que era un gourmet. Comer con él varios días por semana sirvió como sustituto."
    mc "*lacht* Ich habe nach einem Chef gesucht, der ein Feinschmecker ist. Mehrmals pro Woche mit ihm zu essen, diente als Ersatz."

# game/scripts/c27/c27.rpy:1844
translate german c27s002_AmaAtCollege2_f9d36ec2:

    # ama "Bueno, [mc]. Te voy a dejar. Quiero ir a la base a ducharme antes de ir a casa a cenar. ¿Te veo luego?"
    ama "Okay, [mc]. Ich verabschiede mich jetzt. Ich möchte zurück zur Basis, um zu duschen, bevor ich zum Abendessen nach Hause fahre. Bis später?"

# game/scripts/c27/c27.rpy:1846
translate german c27s002_AmaAtCollege2_29bccd48:

    # mc "No lo sé. Acabo de salir de la tienda de [mad.nick] y he tenido un encontronazo con su madre."
    mc "Ich weiß es nicht. Ich habe gerade den [mad.nick]-Laden verlassen und bin seiner Mutter begegnet."

# game/scripts/c27/c27.rpy:1847
translate german c27s002_AmaAtCollege2_dd8fe5c9:

    # mc "Le he dicho que esperaré a que cierre para tomar un café. No sé qué haremos luego."
    mc "Ich sagte ihr, ich warte, bis sie schließt, damit wir noch einen Kaffee trinken können. Was wir danach machen, weiß ich noch nicht."

# game/scripts/c27/c27.rpy:1849
translate german c27s002_AmaAtCollege2_b2f6b87d:

    # ama "Vete a cenar con ella. Por lo que he oído, la madre es una bruja y seguro que [mad.nick] necesita un poco de apoyo."
    ama "Geh mit ihr essen. Soweit ich gehört habe, ist ihre Mutter eine Hexe und sie braucht unbedingt Unterstützung."

# game/scripts/c27/c27.rpy:1850
translate german c27s002_AmaAtCollege2_409b418b:

    # ama "O tráela a cenar a casa y le damos apoyo todas."
    ama "Oder wir bringen sie zum Abendessen nach Hause, dann unterstützen wir sie alle."

# game/scripts/c27/c27.rpy:1851
translate german c27s002_AmaAtCollege2_a7082e58:

    # mc "Mi idea era ir a cenar. Hace días que no hemos tenido tiempo a solas y..."
    mc "Meine Idee war, essen zu gehen. Wir hatten seit Tagen keine Zeit mehr allein zusammen und..."

# game/scripts/c27/c27.rpy:1853
translate german c27s002_AmaAtCollege2_ff878bcc:

    # ama "Hazlo. Le diré a [mar] que no vienes ni a cenar ni a dormir."
    ama "Mach es. Ich werde [mar] ausrichten, dass du weder zum Abendessen noch zum Schlafen kommst."

# game/scripts/c27/c27.rpy:1854
translate german c27s002_AmaAtCollege2_9834909d:

    # mc "Yo no he dicho nada de no ir a dormir."
    mc "Ich habe nichts davon gesagt, dass ich nicht schlafen gehen würde."

# game/scripts/c27/c27.rpy:1856
translate german c27s002_AmaAtCollege2_82471ece:

    # ama "Bueno, esta vez soy yo la que toma la decisión por ti. ¿Cómo sienta cuando se cambian las tornas?"
    ama "Nun, dieses Mal treffe ich die Entscheidung für dich. Wie fühlt es sich an, wenn sich die Rollen vertauschen?"

# game/scripts/c27/c27.rpy:1857
translate german c27s002_AmaAtCollege2_c1cd5e10:

    # mc "*Risa* Sienta genial. Te veo mañana, [ama]."
    mc "*Lacht* Fühlt sich super an. Bis morgen, [ama]."

# game/scripts/c27/c27.rpy:1858
translate german c27s002_AmaAtCollege2_185999e3:

    # ama "Te veo mañana. Pasáoslo bien."
    ama "Wir sehen uns morgen. Viel Spaß!"

# game/scripts/c27/c27.rpy:1860
translate german c27s002_AmaAtCollege2_be5f40e8:

    # mc "Sí. Acabo de salir de la tienda de [mad.nick] y he tenido un encontronazo con su madre."
    mc "Ja. Ich habe gerade den [mad.nick]-Laden verlassen und bin seiner Mutter begegnet."

# game/scripts/c27/c27.rpy:1861
translate german c27s002_AmaAtCollege2_c824ab6a:

    # mc "Le he dicho que esperaré a que cierre para tomar un café. Después iré a casa."
    mc "Ich sagte ihm, ich würde warten, bis er schließt, um einen Kaffee zu trinken. Dann würde ich nach Hause gehen."

# game/scripts/c27/c27.rpy:1863
translate german c27s002_AmaAtCollege2_a0692074:

    # ama "Parece una buena idea. Por lo que he oído, la madre es una bruja y seguro que [mad.nick] necesita un poco de apoyo."
    ama "Das klingt nach einer guten Idee. Soweit ich gehört habe, ist die Mutter eine Hexe und braucht unbedingt Unterstützung."

# game/scripts/c27/c27.rpy:1864
translate german c27s002_AmaAtCollege2_409b418b_1:

    # ama "O tráela a cenar a casa y le damos apoyo todas."
    ama "Oder wir bringen sie zum Abendessen nach Hause, dann unterstützen wir sie alle."

# game/scripts/c27/c27.rpy:1865
translate german c27s002_AmaAtCollege2_d2a4b3c3:

    # mc "Se lo propondré, a ver qué le parece. Te veo luego."
    mc "Ich werde es ihm vorschlagen, mal sehen, was er davon hält. Bis später."

# game/scripts/c27/c27.rpy:1866
translate german c27s002_AmaAtCollege2_fb8c89e8:

    # ama "Hasta luego, [mc]."
    ama "Bis später, [mc]."

# game/scripts/c27/c27.rpy:1872
translate german c27s003_NoMad_7be8d16a:

    # "Llegas al café y, tras pedir un zumo de piña, juegas un rato a My Residence."
    "Du kommst im Café an und spielst, nachdem du einen Ananassaft bestellt hast, eine Weile My Residence."

# game/scripts/c27/c27.rpy:1873
translate german c27s003_NoMad_ed1bea5a:

    # "Tienes una tórrida escena con Dee-Dee en su piso."
    "Es gibt eine heiße Szene mit Dee-Dee in ihrer Wohnung."

# game/scripts/c27/c27.rpy:1874
translate german c27s003_NoMad_554b84ed:

    # "Su perro no está en casa, con lo que, según el narrador, evitas tener que estar vigilando los muebles."
    "Sein Hund ist nicht zu Hause, daher müssen Sie sich laut Erzähler nicht um die Möbel kümmern."

# game/scripts/c27/c27.rpy:1875
translate german c27s003_NoMad_dd9f14bc:

    # mcp "(*Risa mental* ¡Ni que fuera Zeus!)"
    mcp "(*Innerliches Lachen* Als wäre ich Zeus!)"

# game/scripts/c27/c27.rpy:1879
translate german c27s003_MadLis_25c8db59:

    # "La escena es más larga si no estás en ruta con [mad.nick]."
    "Die Szene ist länger, wenn Sie nicht auf der Route mit [mad.nick] sind."

# game/scripts/c27/c27.rpy:1884
translate german c27s003_MadLis_2d92c013:

    # "Llegas al café y, tras pedir un zumo de piña, pasas un rato leyendo noticias en el móvil."
    "Sie kommen im Café an und bestellen einen Ananassaft, während Sie einige Zeit damit verbringen, Nachrichten auf Ihrem Handy zu lesen."

# game/scripts/c27/c27.rpy:1886
translate german c27s003_MadLis_ec526522:

    # "Al cabo de un rato llegan las chicas."
    "Nach einer Weile treffen die Mädchen ein."

# game/scripts/c27/c27.rpy:1890
translate german c27s003_MadLis_ec0d1036:

    # "[mad.nick] es la primera en besarte."
    "[mad.nick] ist der Erste, der dich küsst."

# game/scripts/c27/c27.rpy:1892
translate german c27s003_MadLis_dab8c711:

    # mad "Gracias por lo que has hecho en la tienda."
    mad "Vielen Dank für Ihre Arbeit im Geschäft."

# game/scripts/c27/c27.rpy:1893
translate german c27s003_MadLis_4d1b716b:

    # mc "¿Te ha bombardeado tu madre mucho a preguntas?"
    mc "Hat deine Mutter dich mit Fragen bombardiert?"

# game/scripts/c27/c27.rpy:1894
translate german c27s003_MadLis_4c269159:

    # mad "No ha podido gracias a [lis]."
    mad "Dank [lis] war ihm dies nicht möglich."

# game/scripts/c27/c27.rpy:1898
translate german c27s003_MadLis_30e728af:

    # "[lis] también quiere su beso. Te lo da en cuanto la dependienta se sienta."
    "[lis] möchte auch ihren Kuss. Sie gibt ihn dir, sobald die Verkäuferin sich hingesetzt hat."

# game/scripts/c27/c27.rpy:1900
translate german c27s003_MadLis_802dc70a:

    # "[lis] te besa en cuanto la dependienta se sienta."
    "[lis] küsst dich, sobald sich die Verkäuferin hingesetzt hat."

# game/scripts/c27/c27.rpy:1902
translate german c27s003_MadLis_bf79a8ee:

    # lis "Puedo convertirme en una Karen en cualquier momento, y ese ha sido el momento perfecto."
    lis "Ich kann jederzeit zur Karen werden, und das war der perfekte Moment."

# game/scripts/c27/c27.rpy:1903
translate german c27s003_MadLis_063b558b:

    # lis "*Risa* Mi faceta de clienta odiosa que quiere que le enseñen todo puede ser muy útil."
    lis "*Lacht* Meine nervige Kundenseite, die alles gezeigt bekommen möchte, kann sehr nützlich sein."

# game/scripts/c27/c27.rpy:1904
translate german c27s003_MadLis_0dd65c5f:

    # mc "*Risa* Y como la jefa ya estaba ahí, no podías pedir hablar con ella."
    mc "*Gelächter* Und da die Chefin schon da war, konntest du nicht fragen, ob du mit ihr sprechen darfst."

# game/scripts/c27/c27.rpy:1906
translate german c27s003_MadLis_8f7d65e4:

    # lis "Exacto, aparta y déjame sitio."
    lis "Genau, geh beiseite und gib mir etwas Platz."

# game/scripts/c27/c27.rpy:1907
translate german c27s003_MadLis_b8721c04:

    # mc "Lo hago porque te lo has ganado. *Risa*"
    mc "Ich mache es, weil du es dir verdient hast. *lacht*"

# game/scripts/c27/c27.rpy:1909
translate german c27s003_MadLis_3ca18231:

    # mad "La verdad es que hacía mucho que no veía a mi madre tan sorprendida. Normalmente todo el mundo hace lo que ella quiere."
    mad "Ehrlich gesagt hatte ich meine Mutter schon lange nicht mehr so überrascht gesehen. Normalerweise macht jeder, was sie will."

# game/scripts/c27/c27.rpy:1911
translate german c27s003_MadLis_84f12b5c:

    # mc "Pues creo que, si alguna vez me invita a una reunión familiar, no voy a ser su yerno favorito."
    mc "Nun ja, ich glaube, wenn sie mich jemals zu einem Familientreffen einlädt, werde ich nicht ihr Lieblingsschwiegersohn sein."

# game/scripts/c27/c27.rpy:1913
translate german c27s003_MadLis_00cb27fe:

    # mc "Pues creo que ha encontrado un rival en mí."
    mc "Nun, ich glaube, er hat in mir einen Rivalen gefunden."

# game/scripts/c27/c27.rpy:1914
translate german c27s003_MadLis_bca0b992:

    # mc "No me estaba gustando cómo estaba hablando de ti con un tipo al que acaba de conocer. Ni que te llamara [mad], sabiendo lo poco que te gusta."
    mc "Mir gefiel nicht, wie sie mit einem Mann, den sie gerade erst kennengelernt hatte, über dich geredet hat. Oder dass sie dich [mad] genannt hat, obwohl sie wusste, wie wenig du das magst."

# game/scripts/c27/c27.rpy:1916
translate german c27s003_MadLis_80683035:

    # mad "Lo de [mad] nunca me ha gustado, pero lo entiendo. Es el nombre con el que ella siempre ha pensado en mí."
    mad "Ich mochte das mit dem \"[mad]\" nie, aber ich verstehe es. Es ist der Name, mit dem sie mich immer bezeichnet hat."

# game/scripts/c27/c27.rpy:1917
translate german c27s003_MadLis_2bb432be:

    # mad "Pero no me gusta que quiera avergonzarme con lo de acabar siendo una solterona que acaba sola con la casa llena de gatos."
    mad "Aber mir gefällt nicht, dass sie mich bloßstellen will, indem sie sagt, ich würde am Ende als alte Jungfer mit einem Haus voller Katzen enden."

# game/scripts/c27/c27.rpy:1919
translate german c27s003_MadLis_a08a2d9a:

    # mc "Bueno, no vas a ser una solterona ni a estar sola. Y lo de los gatos... Si alguna vez tienes más de uno..."
    mc "Nun, du wirst weder eine alte Jungfer noch allein sein. Und was die Katzen angeht … falls du jemals mehr als eine haben solltest …"

# game/scripts/c27/c27.rpy:1921
translate german c27s003_MadLis_d90d66e2:

    # mc "Bueno, no vas a estar sola. Y lo de los gatos... Si alguna vez tienes más de uno..."
    mc "Nun, du wärst nicht allein. Und was die Katzen angeht … falls du jemals mehr als eine haben solltest …"

# game/scripts/c27/c27.rpy:1923
translate german c27s003_MadLis_19da3e06:

    # lis "Evitaremos que entren en tu habitación. *Risa* Espero que esa cama dure mucho."
    lis "Wir werden sie aus deinem Zimmer fernhalten. *lacht* Hoffentlich hält das Bett lange."

# game/scripts/c27/c27.rpy:1924
translate german c27s003_MadLis_621dd6f9:

    # lis "La próxima vez tenemos que sustituir a Zeus por [mad.nick]."
    lis "Nächstes Mal müssen wir Zeus durch [mad.nick] ersetzen."

# game/scripts/c27/c27.rpy:1925
translate german c27s003_MadLis_b92bee6f:

    # mc "*Risa* Podemos poner una lata de una tonelada de atún al lado de la piscina para evitar que se mueva de ahí."
    mc "*Gelächter* Wir können eine Tonne Thunfisch in einer Dose neben den Pool stellen, damit er sich nicht bewegt."

# game/scripts/c27/c27.rpy:1927
translate german c27s003_MadLis_64785b21:

    # mad "No os metáis con el pobre Zeus. Suficiente tiene con llevar dos días en el veterinario."
    mad "Lass den armen Zeus in Ruhe. Er hat schon genug zu tun, nachdem er zwei Tage beim Tierarzt verbracht hat."

# game/scripts/c27/c27.rpy:1928
translate german c27s003_MadLis_bc09297b:

    # mc "¿Qué? ¿Qué le pasa?"
    mc "Was? Was stimmt nicht mit ihm?"

# game/scripts/c27/c27.rpy:1930
translate german c27s003_MadLis_b5bbce20:

    # mad "Algunas de las chicas le dieron de comer más de lo debido y se ha puesto enfermo."
    mad "Einige der Mädchen gaben ihm mehr zu essen, als er sollte, und er ist krank geworden."

# game/scripts/c27/c27.rpy:1931
translate german c27s003_MadLis_2b4af40a:

    # mad "Como, a pesar de eso, sigue siendo un comilón, el veterinario me sugirió que lo dejara allí, donde lo pueden controlar mejor."
    mad "Da er trotz allem immer noch ein guter Fresser ist, schlug der Tierarzt vor, ihn dort zu lassen, wo man ihn besser im Auge behalten kann."

# game/scripts/c27/c27.rpy:1933
translate german c27s003_MadLis_4c1b6750:

    # mad "Me paso el día fuera de casa y no podría controlar si abre algún armario para coger comida."
    mad "Ich bin den ganzen Tag nicht zu Hause und könnte nicht kontrollieren, ob er irgendwelche Schränke öffnet, um sich etwas zu essen zu holen."

# game/scripts/c27/c27.rpy:1934
translate german c27s003_MadLis_abc95beb:

    # mc "*Risa* Deberías poner candados en todas las puertas donde haya comida."
    mc "*lacht* Du solltest alle Türen abschließen, hinter denen sich Lebensmittel befinden."

# game/scripts/c27/c27.rpy:1935
translate german c27s003_MadLis_92574c69:

    # mc "Aunque visto lo listo que es, sería capaz de aprender a usar una ganzúa."
    mc "Angesichts seiner Intelligenz wäre er jedoch in der Lage, den Umgang mit einem Dietrich zu erlernen."

# game/scripts/c27/c27.rpy:1937
translate german c27s003_MadLis_938f9629:

    # lis "[mad.nick], te aseguro que yo sólo le di un trozo pequeño de bacon."
    lis "[mad.nick], ich versichere Ihnen, dass ich ihm nur ein kleines Stück Speck gegeben habe."

# game/scripts/c27/c27.rpy:1938
translate german c27s003_MadLis_3c14d331:

    # mc "Creo que el problema es que tú le diste bacon, [nor] salchichas, [dap] jamón, [eil] una lata de atún, [eri] varias latas..."
    mc "Ich glaube, das Problem ist, dass du ihm Speck, Würstchen, Schinken, eine Dose Thunfisch und mehrere Dosen gegeben hast..."

# game/scripts/c27/c27.rpy:1939
translate german c27s003_MadLis_08f64b1c:

    # mc "La próxima vez os deberíais poner de acuerdo en quién le da qué."
    mc "Nächstes Mal solltet ihr euch einigen, wer was gibt."

# game/scripts/c27/c27.rpy:1941
translate german c27s003_MadLis_47650983:

    # mad "Bueno, creo que lo que ha pasado nos servirá de lección a todos. Zeus incluido. Ha aprendido que, si come mucho, se pone malo."
    mad "Ich denke, das Geschehene wird uns allen eine Lehre sein. Auch Zeus. Er hat gelernt, dass er krank wird, wenn er zu viel isst."

# game/scripts/c27/c27.rpy:1942
translate german c27s003_MadLis_fd9b3788:

    # mad "Solo faltará que lo recuerde la próxima vez que tenga comida delante."
    mad "Jetzt muss er sich nur noch daran erinnern, wenn er das nächste Mal Essen vor sich hat."

# game/scripts/c27/c27.rpy:1943
translate german c27s003_MadLis_fbd300d8:

    # mc "Eso va a ser más difícil. Pese a que parece bastante listo, me da la impresión de que, cuando hay comida por en medio, no piensa demasiado."
    mc "Das wird schwieriger. Obwohl er recht intelligent wirkt, habe ich den Eindruck, dass er, wenn es ums Essen geht, nicht besonders viel von sich selbst hält."

# game/scripts/c27/c27.rpy:1946
translate german c27s003_MadLis_a861bcf7:

    # lis "Bueno, parejita, yo os voy a dejar y voy a volver a casa."
    lis "Okay, ihr zwei, ich werde euch jetzt allein lassen und nach Hause gehen."

# game/scripts/c27/c27.rpy:1947
translate german c27s003_MadLis_3ecea66a:

    # mc "¿Al final no has comprado nada? No veo bolsas..."
    mc "Du hast also letztendlich nichts gekauft? Ich sehe keine Taschen..."

# game/scripts/c27/c27.rpy:1949
translate german c27s003_MadLis_97038187:

    # lis "Sí que he comprado, pero [mad.nick] lo enviará a casa. No quería ir cargada en el Under."
    lis "Ja, ich habe es gekauft, aber [mad.nick] lässt es nach Hause schicken. Ich wollte es nicht im Under mit mir herumtragen."

# game/scripts/c27/c27.rpy:1950
translate german c27s003_MadLis_89b0a1b8:

    # mc "*Risa* ¿Tanto has comprado?"
    mc "*Gelächter* Hast du so viel gekauft?"

# game/scripts/c27/c27.rpy:1952
translate german c27s003_MadLis_41fa6133:

    # mad "No lo quieras saber. *Risa* Creo que [lis] se ha convertido en una de mis mejores clientas en estas semanas."
    mad "Das willst du gar nicht wissen. *lacht* Ich glaube, [lis] ist in den letzten Wochen zu einem meiner besten Kunden geworden."

# game/scripts/c27/c27.rpy:1953
translate german c27s003_MadLis_fc692fce:

    # mc "*Risa* Al final va a tener que echar a [deb.nick] de la habitación para meter toda la ropa."
    mc "*Lacht* Am Ende wird er [deb.nick] aus dem Zimmer werfen müssen, damit alle Klamotten reinpassen."

# game/scripts/c27/c27.rpy:1957
translate german c27s003_MadLis_a85e51db:

    # lis "No hace falta echarla. *Risa* Con ocupar sus armarios tengo suficiente."
    lis "Sie muss man nicht rausschmeißen. *lacht* Es reicht mir schon, wenn ich ihre Schränke vollmache."

# game/scripts/c27/c27.rpy:1959
translate german c27s003_MadLis_4dea7428:

    # lis "Te veo en casa, [mc]. Hasta mañana, [mad.nick]."
    lis "Wir sehen uns zu Hause, [mc]. Bis morgen, [mad.nick]."

# game/scripts/c27/c27.rpy:1962
translate german c27s003_MadLis_f6134b6e:

    # lis "¿No le vas a contar a [mc] la gran noticia, [mad.nick]?"
    lis "Wirst du [mc] die große Neuigkeit nicht erzählen, [mad.nick]?"

# game/scripts/c27/c27.rpy:1963
translate german c27s003_MadLis_330754fc:

    # mc "¿Qué gran noticia? ¿Me he perdido algo?"
    mc "Was für tolle Neuigkeiten! Habe ich etwas verpasst?"

# game/scripts/c27/c27.rpy:1965
translate german c27s003_MadLis_458c8cb9:

    # mad "Bueno, la iba a contar la próxima vez que fuera a casa..."
    mad "Nun ja, ich wollte es dir eigentlich beim nächsten Mal erzählen, wenn ich nach Hause komme..."

# game/scripts/c27/c27.rpy:1966
translate german c27s003_MadLis_c779c6c9:

    # mad "¡Mis diseños de vestidos han sido aceptados para el concurso al que los mandé! ¡Están en la fase final!"
    mad "Meine Kleiderentwürfe wurden für den Wettbewerb angenommen, bei dem ich sie eingereicht habe! Sie befinden sich in der Endphase!"

# game/scripts/c27/c27.rpy:1967
translate german c27s003_MadLis_c97518fe:

    # mc "¡Eso es fantástico, [mad.nick]! ¿Cuándo sabrás si has ganado?"
    mc "Das ist fantastisch! Wann erfahren Sie, ob Sie gewonnen haben?"

# game/scripts/c27/c27.rpy:1969
translate german c27s003_MadLis_98f13275:

    # mad "A finales del mes que viene. Tendré que ir a San Francisco un día para la gala de entrega de premios."
    mad "Ende nächsten Monats muss ich für einen Tag nach San Francisco zur Preisverleihung fahren."

# game/scripts/c27/c27.rpy:1970
translate german c27s003_MadLis_8713c2da:

    # mad "¡Estoy super nerviosa!"
    mad "Ich bin total nervös!"

# game/scripts/c27/c27.rpy:1971
translate german c27s003_MadLis_11f71e6d:

    # mc "Me alegro muchísimo por ti."
    mc "Ich freue mich so für dich."

# game/scripts/c27/c27.rpy:1973
translate german c27s003_MadLis_c617c737:

    # lis "Yo me he pedido acompañarla si le llega una invitación de 'Srta. Chang +1'."
    lis "Ich habe darum gebeten, sie begleiten zu dürfen, falls sie eine Einladung von „Miss Chang +1“ erhält."

# game/scripts/c27/c27.rpy:1974
translate german c27s003_MadLis_683b2274:

    # lis "Yo seré el +1. *Risita* Me encantan las entregas de premios. Sobre todo si gana una amiga."
    lis "Ich bin die Begleitung. *Kichern* Ich liebe Preisverleihungen. Vor allem, wenn ein Freund gewinnt."

# game/scripts/c27/c27.rpy:1976
translate german c27s003_MadLis_92bcab57:

    # mad "Bueno, aún no sabemos si voy a ganar..."
    mad "Nun, wir wissen immer noch nicht, ob ich gewinnen werde..."

# game/scripts/c27/c27.rpy:1977
translate german c27s003_MadLis_7bd92cbf:

    # mc "Llegar a la final ya es un paso muy importante, reconocen que tienes talento."
    mc "Das Erreichen des Finales ist bereits ein sehr wichtiger Schritt; sie erkennen Ihr Talent an."

# game/scripts/c27/c27.rpy:1979
translate german c27s003_MadLis_fdc9d9a8:

    # lis "Bueno, deberíamos volver a casa, ¿no? Tengo ganas de ver las caras de las chicas cuando se enteren de lo de [mad.nick]."
    lis "Dann sollten wir wohl nach Hause fahren, oder? Ich kann es kaum erwarten, die Gesichter der Mädchen zu sehen, wenn sie von [mad.nick] erfahren."

# game/scripts/c27/c27.rpy:1980
translate german c27s003_MadLis_3ecea66a_1:

    # mc "¿Al final no has comprado nada? No veo bolsas..."
    mc "Du hast also letztendlich nichts gekauft? Ich sehe keine Taschen..."

# game/scripts/c27/c27.rpy:1982
translate german c27s003_MadLis_2956d957:

    # lis "Sí que he comprado, pero [mad.nick] lo enviará a casa. No quería ir cargada."
    lis "Ja, ich habe es gekauft, aber [mad.nick] lässt es mir nach Hause liefern. Ich wollte es nicht mit mir herumtragen."

# game/scripts/c27/c27.rpy:1983
translate german c27s003_MadLis_89b0a1b8_1:

    # mc "*Risa* ¿Tanto has comprado?"
    mc "*Gelächter* Hast du so viel gekauft?"

# game/scripts/c27/c27.rpy:1985
translate german c27s003_MadLis_41fa6133_1:

    # mad "No lo quieras saber. *Risa* Creo que [lis] se ha convertido en una de mis mejores clientas en estas semanas."
    mad "Das willst du gar nicht wissen. *lacht* Ich glaube, [lis] ist in den letzten Wochen zu einem meiner besten Kunden geworden."

# game/scripts/c27/c27.rpy:1986
translate german c27s003_MadLis_fc692fce_1:

    # mc "*Risa* Al final va a tener que echar a [deb.nick] de la habitación para meter toda la ropa."
    mc "*Lacht* Am Ende wird er [deb.nick] aus dem Zimmer werfen müssen, damit alle Klamotten reinpassen."

# game/scripts/c27/c27.rpy:1988
translate german c27s003_MadLis_a85e51db_1:

    # lis "No hace falta echarla. *Risa* Con ocupar sus armarios tengo suficiente."
    lis "Sie muss man nicht rausschmeißen. *lacht* Es reicht mir schon, wenn ich ihre Schränke vollmache."

# game/scripts/c27/c27.rpy:1989
translate german c27s003_MadLis_d243e6e8:

    # lis "¿Nos vamos? [mad.nick] también viene a cenar, ¿verdad?"
    lis "Sollen wir gehen? [mad.nick] Er kommt doch auch zum Abendessen, oder?"

# game/scripts/c27/c27.rpy:1990
translate german c27s003_MadLis_16347631:

    # mc "Claro. Le tiene que dar la noticia al resto de la familia."
    mc "Natürlich. Er muss es dem Rest der Familie erzählen."

# game/scripts/c27/c27.rpy:1992
translate german c27s003_MadLis_8f7a6cb1:

    # mad "No sé, había sacado comida del congelador para hacerme esta noche..."
    mad "Ich weiß nicht, ich hatte mir Essen aus dem Gefrierschrank geholt, um mir heute Abend etwas zu kochen..."

# game/scripts/c27/c27.rpy:1993
translate german c27s003_MadLis_39e455e8:

    # mc "Y va a seguir estando ahí mañana, con lo que evitarás tener que sacarla."
    mc "Und es wird auch morgen noch da sein, sodass Sie es nicht herausnehmen müssen."

# game/scripts/c27/c27.rpy:1994
translate german c27s003_MadLis_16a93b4d:

    # mc "Mejor estar en casa que sola en tu apartamento, teniendo en cuenta que no está Zeus."
    mc "Es ist besser, zu Hause zu sein als allein in der Wohnung, vorausgesetzt, Zeus ist nicht da."

# game/scripts/c27/c27.rpy:1995
translate german c27s003_MadLis_805008b2:

    # mc "Además, deberías ser tú quién les cuente a las chicas lo del concurso. Todos sabemos que [lis] no es buena guardando secretos."
    mc "Außerdem solltest du den Mädchen von dem Wettbewerb erzählen. Wir wissen ja alle, dass [lis] nicht gut im Geheimnissebewahren ist."

# game/scripts/c27/c27.rpy:1996
translate german c27s003_MadLis_ff3e9756:

    # "Puedes oír cómo [lis] se remueve al lado tuyo. No te atreves a mirarla."
    "Du hörst, wie sich [lis] neben dir rührt. Du wagst es nicht, sie anzusehen."

# game/scripts/c27/c27.rpy:1998
translate german c27s003_MadLis_596a0ed0:

    # mad "Me has convencido. Creo que voy a ir con vosotros."
    mad "Du hast mich überzeugt. Ich glaube, ich werde mit dir gehen."

# game/scripts/c27/c27.rpy:2000
translate german c27s003_MadLis_12d99d03:

    # "Conduces a casa mientras las dos chicas empiezan a hablar de lo que se van a poner para la gala de entrega de premios."
    "Während du nach Hause fährst, unterhalten sich die beiden Mädchen darüber, was sie zur Preisverleihung tragen werden."

# game/scripts/c27/c27.rpy:2001
translate german c27s003_MadLis_8d4f05cb:

    # mcp "(¡Por el amor de Dios! ¡Quedan casi dos meses y ya están planificando el vestuario!)"
    mcp "(Um Himmels willen! Es sind noch fast zwei Monate, und sie planen schon die Kostüme!)"

# game/scripts/c27/c27.rpy:2003
translate german c27s003_MadLis_9534ce4f:

    # "Prefieres guardar silencio sobre el tema. Sabes que las dos van a lucir fantásticas lleven lo que lleven."
    "Du ziehst es vor, zu dem Thema zu schweigen. Du weißt, dass sie beide fantastisch aussehen werden, egal was sie tragen."

# game/scripts/c27/c27.rpy:2006
translate german c27s003_MadLis_77f17d01:

    # "Al llegar a casa, la noticia de la visita de la madre de [mad.nick] ha corrido como la pólvora."
    "Als sie nach Hause kam, hatte sich die Nachricht vom Besuch von [mad.nick]s Mutter wie ein Lauffeuer verbreitet."

# game/scripts/c27/c27.rpy:2007
translate german c27s003_MadLis_cf84d77b:

    # "Todo el mundo quiere apoyar a la dependienta."
    "Alle möchten die Verkäuferin unterstützen."

# game/scripts/c27/c27.rpy:2009
translate german c27s003_MadLis_6b52bcaa:

    # "No pasa mucho tiempo antes de que [lis] explique la lección que le has dado a la Sra. Chang. Entonces las felicitaciones son para ti."
