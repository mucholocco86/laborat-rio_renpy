    mc "Aber..."

# game/scripts/c25/c25.rpy:2114
translate german c25s003_Meg_682e7671:

    # meg "¿Dónde está el problema? ¿Sólo tú tienes derecho a mirar cómo se desnuda una mujer? Yo también quiero hacerlo."
    meg "Wo liegt das Problem? Hast nur du das Recht, einer Frau beim Ausziehen zuzusehen? Ich will das auch."

# game/scripts/c25/c25.rpy:2115
translate german c25s003_Meg_03352925:

    # mc "*Risa* Puedo avisar a alguna mujer para que se desnude para ti."
    mc "*Lacht* Ich kann eine Frau dazu bringen, sich für Sie auszuziehen."

# game/scripts/c25/c25.rpy:2117
translate german c25s003_Meg_129e8e75:

