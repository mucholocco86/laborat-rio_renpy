    mc "Nein, [ama]. Das ist es nicht."

# game/scripts/c25/c25.rpy:3725
translate german c25s006_AmaCuddle_d1a60d81:

    # ama "¿Y si no me gusta? ¿Y si no te gusta... conmigo?"
    ama "Was, wenn es mir nicht gefällt? Was, wenn es dir nicht gefällt... mit mir?"

# game/scripts/c25/c25.rpy:3726
translate german c25s006_AmaCuddle_fb267559:

    # mc "Ese puente lo cruzaremos cuando toque. Pero estoy dispuesto a tener una relación basada en abrazos, si es necesario."
    mc "Wir werden uns damit befassen, wenn die Zeit reif ist. Aber ich bin notfalls auch bereit, eine Beziehung auf Umarmungen aufzubauen."

# game/scripts/c25/c25.rpy:3727
translate german c25s006_AmaCuddle_00b5973a:

    # mc "Y en besos. Muchos besos. Y quiero uno ahora."
    mc "Und Küsse. Viele Küsse. Und ich will jetzt einen."

# game/scripts/c25/c25.rpy:3729
translate german c25s006_AmaCuddle_68dd5088:

