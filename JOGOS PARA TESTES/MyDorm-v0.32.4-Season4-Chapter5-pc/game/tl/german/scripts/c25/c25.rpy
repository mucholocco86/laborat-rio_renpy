    mc "Ich dachte, alle Spione würden darauf trainiert..."

# game/scripts/c25/c25.rpy:3707
translate german c25s006_AmaCuddle_8a16de32:

    # mc "Me sorprendió con [eva], pero me la podía imaginar estrangulando al instructor que se lo propusiera."
    mc "Ich war überrascht von [eva], aber ich konnte mir vorstellen, dass sie jeden Ausbilder erwürgen würde, der es wagen würde, es zu versuchen."

# game/scripts/c25/c25.rpy:3709
translate german c25s006_AmaCuddle_7be4a361:

    # ama "*Risa* Eso solo pasa en las películas sobre el KGB. Yo no tuve que hacer la fase avanzada del entrenamiento de seducción." id c25s006_AmaCuddle_7be4a361
    ama "*Lacht* Sowas gibt's nur in KGB-Filmen. Ich musste keine fortgeschrittene Verführungsausbildung absolvieren." id c25s006_AmaCuddle_7be4a361

# game/scripts/c25/c25.rpy:3711
translate german c25s006_AmaCuddle_7afc5846:

