    # meg "¡Los tíos sois la hostia! ¿Realmente creéis que si a una chica le rompéis la lencería que se ha comprado para vosotros va a tener ganas de sexo?"
    meg "Ihr seid ja unglaublich! Glaubt ihr wirklich, dass ein Mädchen Lust auf Sex hat, wenn ihr ihre Dessous zerreißt, die sie euch gekauft hat?"

# game/scripts/c25/c25.rpy:2093
translate german c25s003_Meg_e4dce264:

    # mc "*Risa* Creo que ningún tío se lo ha planteado nunca así."
    mc "*lacht* Ich glaube nicht, dass jemals ein Mann so darüber nachgedacht hat."

# game/scripts/c25/c25.rpy:2096
translate german c25s003_Meg_aa0d1d9a:

    # meg "*Risa* Pues ya es hora de que te lo plantees antes de que rompas la lencería de alguna de las otras chicas."
    meg "*Lacht* Na, das wurde aber auch Zeit, dass du darüber nachdenkst, bevor du einer der anderen Mädchen die Unterwäsche zerreißt."

# game/scripts/c25/c25.rpy:2097
translate german c25s003_Meg_d63743ba:

    # meg "Algunas mujeres pueden ser tan inocentes como para no advertirte antes."
    meg "Manche Frauen sind so unschuldig, dass sie einen nicht vorher warnen."

# game/scripts/c25/c25.rpy:2099
translate german c25s003_Meg_f58a3b1a:

