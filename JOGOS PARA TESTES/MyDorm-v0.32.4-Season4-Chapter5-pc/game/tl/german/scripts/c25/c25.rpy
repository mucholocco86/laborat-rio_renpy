    nor "Und nun können Sie gehen. Diese Sitzung diente der Stärkung der Mutter-Tochter-Bindung und nicht dazu, dass Sie uns hier unterbrechen."

# game/scripts/c25/c25.rpy:2701
translate german c25s004_IceCream_375664da:

    # mc "Vale, ya me voy."
    mc "Okay, ich gehe jetzt."

# game/scripts/c25/c25.rpy:2704
translate german c25s004_IceCream_c24fdb5a:

    # nor "No sin antes darme un beso."
    nor "Nicht bevor er mich geküsst hat."

# game/scripts/c25/c25.rpy:2706
translate german c25s004_IceCream_acb20522:

    # "Rodeas la isla de la cocina y besas a [nor]."
    "Du gehst um die Kücheninsel herum und küsst [nor]."

# game/scripts/c25/c25.rpy:2708
translate german c25s004_IceCream_f4fbec9f:

    # "Hace unos días, [mee] hubiera puesto el grito en el cielo. Ahora ya lo ha aceptado." id c25s004_IceCream_f4fbec9f
    "Vor ein paar Tagen wäre [mee] empört gewesen. Jetzt hat er es akzeptiert." id c25s004_IceCream_f4fbec9f

# game/scripts/c25/c25.rpy:2710
translate german c25s004_IceCream_f4e13850:

    # "Estás tentado de hacer lo mismo con [mee], pero no podrás hacerlo hasta saber el resultado de la cita de esta noche." id c25s004_IceCream_f4e13850
    "Du bist versucht, das Gleiche mit [mee] zu tun, aber das wirst du erst können, wenn du das Ergebnis des heutigen Dates kennst." id c25s004_IceCream_f4e13850

# game/scripts/c25/c25.rpy:2712
translate german c25s004_IceCream_e1f59b84:

    # mc "Os veo luego, chicas."
    mc "Bis später, Mädels."

# game/scripts/c25/c25.rpy:2714
translate german c25s004_IceCream_f69aff6e:

    # mc "Guardadme una porción de helado."
    mc "Heb mir eine Portion Eis auf."

# game/scripts/c25/c25.rpy:2715
translate german c25s004_IceCream_37856727:

    # nor "Hasta luego, [mc]." id c25s004_IceCream_37856727 (multiple=2)
    nor "Bis später, [mc]." id c25s004_IceCream_37856727 (multiple=2)

# game/scripts/c25/c25.rpy:2716
translate german c25s004_IceCream_9aac5377:

    # mee "Hasta luego, cielo." (multiple=2)
    mee "Bis später, Liebling." (multiple=2)

# game/scripts/c25/c25.rpy:2719
translate german c25s004_IceCream_52ce966b:

    # "Vuelves hacia tu habitación, quieres trabajar un poco en la contabilidad antes de la hora de comer."
    "Du gehst zurück in dein Zimmer; du willst vor dem Mittagessen noch ein paar Buchhaltungsarbeiten erledigen."

# game/scripts/c25/c25.rpy:2728
translate german c25s004_KimDebLisaSai_04238738:

    # "Cuando estás a punto de llegar a la planta de las estudiantes escuchas voces..."
    "Als du fast das Studentengeschoss erreicht hast, hörst du Stimmen..."

# game/scripts/c25/c25.rpy:2729
translate german c25s004_KimDebLisaSai_9d2b88cf:

    # sai "... Yo nunca lo llevaría a un restaurante vegetariano. Sería un fracaso anunciado."
    sai "Ich würde ihn niemals in ein vegetarisches Restaurant mitnehmen. Das wäre garantiert eine Katastrophe."

# game/scripts/c25/c25.rpy:2730
translate german c25s004_KimDebLisaSai_f01d9416:

    # eil "*Risa* Estoy de acuerdo. Se pasaría la cena protestando por todo."
    eil "*Lacht* Da stimme ich zu. Sie würde das ganze Abendessen damit verbringen, sich über alles zu beschweren."

# game/scripts/c25/c25.rpy:2732
translate german c25s004_KimDebLisaSai_6c9a0363:

    # kim "¿Entonces dónde es un buen sitio para ir a comer con él? No quiero meter la pata el día que tengamos nuestra primera cita."
    kim "Wo könnte man denn gut mit ihm zu Mittag essen gehen? Ich will bei unserem ersten Date nichts vermasseln."

# game/scripts/c25/c25.rpy:2734
translate german c25s004_KimDebLisaSai_1c1169f9:

    # deb "¿Entonces dónde es un buen sitio para ir a comer con él? No quiero meter la pata el día que tengamos nuestra primera cita."
    deb "Wo könnte man denn gut mit ihm zu Mittag essen gehen? Ich will bei unserem ersten Date nichts vermasseln."

# game/scripts/c25/c25.rpy:2736
translate german c25s004_KimDebLisaSai_964413f7:

    # lis "¿Entonces dónde es un buen sitio para ir a comer con él? Yo soy vegana y..."
    lis "Wo könnte man denn gut mit ihm essen gehen? Ich bin Veganerin und..."

# game/scripts/c25/c25.rpy:2738
translate german c25s004_KimDebLisaSai_3fa729f3:

    # kat "¿Entonces dónde lo llevaríais? No es que yo vaya a ir a cenar con él, pero..."
    kat "Also, wohin würdest du ihn mitnehmen? Ich werde jetzt nicht mit ihm essen gehen, aber..."

# game/scripts/c25/c25.rpy:2739
translate german c25s004_KimDebLisaSai_b83b6ea0:

    # mcp "([sai] y [eil] hablando de mí. Será mejor que no me oigan.)"
    mcp "([sai] und [eil] reden über mich. Hör mir besser nicht zu.)"

# game/scripts/c25/c25.rpy:2741
translate german c25s004_KimDebLisaSai_19450c90:

    # mcp "(Desde aquí sólo puedo ver a [kat].)"
    mcp "(Von hier aus kann ich nur [kat] sehen.)"

# game/scripts/c25/c25.rpy:2755
translate german c25s004_KimDebLisaSai_b767da69:

    # "Haces un poco de ruido en la escalera, forzando las pisadas en los escalones."
    "Du machst ein bisschen Lärm auf der Treppe, indem du deine Schritte auf den Stufen abstützt."

# game/scripts/c25/c25.rpy:2756
translate german c25s004_KimDebLisaSai_e9ed4afb:

    # mc "Hola, [kat]."
    mc "Hallo, [kat]."

# game/scripts/c25/c25.rpy:2758
translate german c25s004_KimDebLisaSai_6ee89dd5:

    # kat "*Jadeo* ¿Qué? ¡Oh, hola [mc]!"
    kat "*Schnappatmung* Was? Oh, hallo [mc]!"

# game/scripts/c25/c25.rpy:2759
translate german c25s004_KimDebLisaSai_d2e03d80:

    # "Oyes ruido de gente moviéndose."
    "Man hört die Geräusche von Menschen, die sich bewegen."

# game/scripts/c25/c25.rpy:2760
translate german c25s004_KimDebLisaSai_b4e0fc81:

    # mc "¿Qué tal, [kat]? ¿Estás sola?"
    mc "Wie geht es dir, [kat]? Bist du allein?"

# game/scripts/c25/c25.rpy:2763
translate german c25s004_KimDebLisaSai_6e734612:

    # "*Blam*"
    "*Bumm*"

# game/scripts/c25/c25.rpy:2764
translate german c25s004_KimDebLisaSai_c535d765:

    # "Oyes cerrarse la habitación de [sai]."
    "Sie hören, wie die Tür zu Zimmer [sai] zufällt."

# game/scripts/c25/c25.rpy:2766
translate german c25s004_KimDebLisaSai_e4a8b87d:

    # kat "No, estoy con [eil]. Estábamos charlando."
    kat "Nein, ich bin mit [eil] zusammen. Wir haben uns unterhalten."

# game/scripts/c25/c25.rpy:2767
translate german c25s004_KimDebLisaSai_12067155:

    # mc "Ah, okay. No os molesto. Iba de camino a mi habitación."
    mc "Ah, okay. Ich werde dich nicht stören. Ich war gerade auf dem Weg in mein Zimmer."

# game/scripts/c25/c25.rpy:2769
translate german c25s004_KimDebLisaSai_8810d176:

    # "Subes hasta el rellano."
    "Sie gehen hinauf zum Treppenabsatz."

# game/scripts/c25/c25.rpy:2770
translate german c25s004_KimDebLisaSai_6a00cd21:

    # mc "Hola, [eil]. ¿No trabajas hoy?"
    mc "Hallo [eil]. Arbeitest du heute nicht?"

# game/scripts/c25/c25.rpy:2771
translate german c25s004_KimDebLisaSai_67dc9595:

    # eil "Esta tarde. [eri] y yo entramos tarde hoy."
    eil "Heute Nachmittag. [eri] und ich kamen heute spät nach Hause."

# game/scripts/c25/c25.rpy:2772
translate german c25s004_KimDebLisaSai_46ff96f9:

    # mcp "(Conozco esa sonrisa. Ella sabe que yo sé que oculta algo.)"
    mcp "(Ich kenne dieses Lächeln. Sie weiß, dass ich weiß, dass sie etwas verbirgt.)"

# game/scripts/c25/c25.rpy:2773
translate german c25s004_KimDebLisaSai_eac49f44:

    # mc "Okay. Decídmelo si necesitáis que os lleve. Estaré en mi habitación trabajando un poco hasta la hora de comer."
    mc "Okay. Sag Bescheid, wenn du eine Mitfahrgelegenheit brauchst. Ich arbeite bis zum Mittagessen in meinem Zimmer."

# game/scripts/c25/c25.rpy:2775
translate german c25s004_KimDebLisaSai_e1f59b84:

    # mc "Os veo luego, chicas."
    mc "Bis später, Mädels."

# game/scripts/c25/c25.rpy:2776
translate german c25s004_KimDebLisaSai_6ad62d0c:

    # kat "Hasta luego, [mc]." (multiple=2)
    kat "Bis später, [mc]." (multiple=2)

# game/scripts/c25/c25.rpy:2777
translate german c25s004_KimDebLisaSai_a9c1d0ed:

    # eil "Hasta luego, [mc]." (multiple=2)
    eil "Bis später, [mc]." (multiple=2)

# game/scripts/c25/c25.rpy:2779
translate german c25s004_KimDebLisaSai_2fdb8487:

    # "Abres la puerta de tu habitación para dejar el móvil antes de ir al lavabo."
    "Du öffnest deine Schlafzimmertür, um dein Handy wegzuräumen, bevor du ins Badezimmer gehst."

# game/scripts/c25/c25.rpy:2780
translate german c25s004_KimDebLisaSai_8fbaa740:

    # "En el momento en que cierras tu puerta, oyes cómo se abre la de [sai]."
    "Sobald du deine Tür schließt, hörst du, wie sich die Tür von [sai] öffnet."

# game/scripts/c25/c25.rpy:2781
translate german c25s004_KimDebLisaSai_5a4dd715:

    # sai "[kat], te tenías que ocupar de vigilar que no viniera nadie. Y menos aún [mc]."
    sai "[kat], du musstest dafür sorgen, dass niemand kam. Und erst recht [mc]."

# game/scripts/c25/c25.rpy:2782
translate german c25s004_KimDebLisaSai_767591b8:

    # kat "Lo siento. La conversación estaba interesante y no lo he oído llegar."
    kat "Es tut mir leid. Das Gespräch war interessant und ich habe Ihre Ankunft nicht mitbekommen."

# game/scripts/c25/c25.rpy:2783
translate german c25s004_KimDebLisaSai_359ef0e4:

    # deb "A mí me ha pasado lo mismo. Estaba tan atenta a lo que decíais que no lo he oído llegar."
    deb "Mir ist genau dasselbe passiert. Ich war so auf das konzentriert, was du gesagt hast, dass ich es gar nicht kommen hörte."

# game/scripts/c25/c25.rpy:2785
translate german c25s004_KimDebLisaSai_143d600b:

    # deb "Y eso teniendo en cuenta que dudo que alguna vez vaya a cenar a solas con él."
    deb "Und das setzt voraus, dass ich bezweifle, jemals allein mit ihm zu Abend zu essen."

# game/scripts/c25/c25.rpy:2786
translate german c25s004_KimDebLisaSai_5a72e6b1:

    # lis "Estoy en la misma situación que [deb.nick]."
    lis "Ich befinde mich in der gleichen Situation wie [deb.nick]."

# game/scripts/c25/c25.rpy:2788
translate german c25s004_KimDebLisaSai_3882306f:

    # lis "Y eso teniendo en cuenta que dudo que alguna vez vaya a cenar a solas con él."
    lis "Und das setzt voraus, dass ich bezweifle, jemals allein mit ihm zu Abend zu essen."

# game/scripts/c25/c25.rpy:2789
translate german c25s004_KimDebLisaSai_3fce954d:

    # kim "Es que lo explicáis de tal forma que es casi como estar ahí, en vuestras citas."
    kim "Du erklärst es so, dass es sich fast so anfühlt, als wärst du selbst dabei, bei euren Verabredungen."

# game/scripts/c25/c25.rpy:2791
translate german c25s004_KimDebLisaSai_256bcef7:

    # kim "Aunque dudo que me vayan a servir de mucho esos conocimientos."
    kim "Ich bezweifle allerdings, dass mir dieses Wissen viel nützen wird."

# game/scripts/c25/c25.rpy:2792
translate german c25s004_KimDebLisaSai_f3e4baaa:

    # eil "Chicas, no sé si nos ha oído, pero sabe que estaba pasando algo. Se lo he leído en la cara."
    eil "Mädchen, ich weiß nicht, ob sie uns gehört hat, aber sie merkte, dass etwas los war. Ich konnte es an ihrem Gesichtsausdruck sehen."

# game/scripts/c25/c25.rpy:2794
translate german c25s004_KimDebLisaSai_daa8d239:

    # mcp "(Será mejor que continúe con lo que iba a hacer. Si no las he querido escuchar antes, mejor será no hacerlo ahora.)"
    mcp "(Ich sollte besser mit dem weitermachen, was ich gerade tue. Wenn ich ihnen vorher schon nicht zuhören wollte, ist es jetzt besser, es auch nicht zu tun.)"

# game/scripts/c25/c25.rpy:2796
translate german c25s004_KimDebLisaSai_a446b3de:

    # kat "Bueno, ya se ha ido. Ibas a hablar del columpio, [eil]."
    kat "Nun, er ist weg. Du wolltest doch über die Schaukel sprechen, [eil]."

# game/scripts/c25/c25.rpy:2797
translate german c25s004_KimDebLisaSai_a1fc8034:

    # mcp "(Será mejor que continúe con lo que iba a hacer. Si van a empezar a hablar de [eil] y de mí en el columpio...)"
    mcp "(Ich sollte besser mit dem weitermachen, was ich gerade tat. Wenn sie jetzt anfangen, über [eil] und mich auf der Schaukel zu reden...)"

# game/scripts/c25/c25.rpy:2800
translate german c25s004_KimDebLisaSai_9bf43002:

    # "Vas al lavabo y trabajas durante una hora, hasta que empieza a entrarte sed. Sigues sin acordarte de coger una botella de agua."
    "Du gehst auf die Toilette und arbeitest eine Stunde lang, bis du Durst bekommst. Du denkst immer noch nicht daran, eine Flasche Wasser mitzunehmen."

# game/scripts/c25/c25.rpy:2801
translate german c25s004_KimDebLisaSai_0e4aee02:

    # "Bajas a la cocina a beber algo."
    "Du gehst in die Küche, um dir etwas zu trinken zu holen."

# game/scripts/c25/c25.rpy:2805
translate german c25s004_Listen_e330979f:

    # "Por sus voces las puedes imaginar sentadas en el suelo, alrededor de las dos maestras."
    "An ihren Stimmen konnte man sich vorstellen, wie sie auf dem Boden saßen, um die beiden Lehrer herum."

# game/scripts/c25/c25.rpy:2806
translate german c25s004_Listen_3d3682ee:

    # "Casi se te escapa la risa y delatas tu presencia."
    "Du müsstest beinahe in schallendes Gelächter ausbrechen und dich verraten."

# game/scripts/c25/c25.rpy:2808
translate german c25s004_Listen_4ebdddd8:

    # kim "¿Dónde lo llevaste a cenar en tu primera cita, [sai]?"
    kim "Wohin hast du ihn bei eurem ersten Date zum Abendessen ausgeführt, [sai]?"

# game/scripts/c25/c25.rpy:2810
translate german c25s004_Listen_1e00e275:

    # sai "Bueno, fue él quien me llevó a comer a mí, no a cenar. Fue en un restaurante escandinavo. Pero no fue la primera cita. Esa había sido en la cafetería de la que os he hablado."
    sai "Also, er hat mich zum Mittagessen eingeladen, nicht zum Abendessen. Wir waren in einem skandinavischen Restaurant. Aber es war nicht unser erstes Date. Das war in dem Café, von dem ich dir erzählt habe."

# game/scripts/c25/c25.rpy:2811
translate german c25s004_Listen_41f2ece9:

    # sai "Por si os interesa, pidió albóndigas suecas y smorrebrod, o como se diga."
    sai "Falls es Sie interessiert: Er bestellte schwedische Fleischbällchen und Smørrebrød, oder wie auch immer das heißt."

# game/scripts/c25/c25.rpy:2813
translate german c25s004_Listen_1ec9791d:

    # eil "*Risa* Me lo imaginaba. Lo que me hubiera sorprendido es que hubiese pedido arenque."
    eil "*Lacht* Das dachte ich mir schon. Was mich überrascht hätte, wäre, wenn er Hering bestellt hätte."

# game/scripts/c25/c25.rpy:2815
translate german c25s004_Listen_26125ae6:

    # deb "¿Y tú, [eil]? ¿Cómo fue vuestra primera cita?"
    deb "Und du, [eil]? Wie war dein erstes Date?"

# game/scripts/c25/c25.rpy:2817
translate german c25s004_Listen_da3bec1c:

    # eil "Te va a parecer gracioso, pero nunca tuvimos una 'primera cita'. Nos veíamos todos los días en el instituto, la cosa entre nosotros surgió poco a poco."
    eil "Du wirst das lustig finden, aber wir hatten nie ein richtiges „erstes Date“. Wir haben uns jeden Tag in der Schule gesehen, und die Beziehung hat sich nach und nach entwickelt."

# game/scripts/c25/c25.rpy:2818
translate german c25s004_Listen_bc26e0c0:

    # eil "Para cuando nos dimos cuenta, estábamos saliendo y no habíamos tenido una cita. La mayoría de las veces comíamos con Jamaal. Imaginaos qué romántico era todo. *Risa*"
    eil "Ehe wir uns versahen, trafen wir uns, obwohl wir noch nicht einmal ein richtiges Date hatten. Meistens aßen wir einfach nur mit Jamaal zu Mittag. Stellt euch vor, wie romantisch das war! *lacht*"

# game/scripts/c25/c25.rpy:2821
translate german c25s004_Listen_92ed8ad3:

    # lis "A mí me gustaría tener una primera cita. Sería algo que recordar siempre y... no sé... como una fecha para nuestro aniversario de salir juntos."
    lis "Ich würde so gerne ein erstes Date haben. Das wäre etwas, an das man sich immer erinnern würde und... ich weiß nicht... so etwas wie ein Date zu unserem Jahrestag."

# game/scripts/c25/c25.rpy:2823
translate german c25s004_Listen_ce44d423:

    # lis "Cuando salga con alguien, me gustaría tener una primera cita. Sería algo que recordar siempre y como una fecha para nuestro aniversario de salir juntos."
    lis "Wenn ich anfange, jemanden zu daten, möchte ich ein erstes Date haben. Es soll etwas sein, an das man sich immer erinnern kann, wie ein Date zu unserem Jahrestag."

# game/scripts/c25/c25.rpy:2824
translate german c25s004_Listen_283ad907:

    # lis "*Risita* Al menos hasta que pueda sustituírlo por el aniversario de boda."
    lis "*Kichern* Zumindest so lange, bis ich es durch den Hochzeitstag ersetzen kann."

# game/scripts/c25/c25.rpy:2827
translate german c25s004_Listen_8aa32af2:

    # deb "No digas tonterías, [lis]. Tienes marcado en tu diario el día que te besó por primera vez, cuando os encerré en nuestra habitación."
    deb "Rede keinen Unsinn, [lis]. Du hast in deinem Tagebuch den Tag markiert, an dem er dich zum ersten Mal geküsst hat, als ich dich in unserem Zimmer eingesperrt habe."

# game/scripts/c25/c25.rpy:2828
translate german c25s004_Listen_afa4cd12:

    # deb "Creo que, cuando se cumpla un año de ese beso, lo celebrarás más que cuando se cumpla un año de vuestra futura primera cita."
    deb "Ich glaube, wenn der Jahrestag dieses Kusses kommt, wirst du ihn mehr feiern als den Jahrestag eures zukünftigen ersten Dates."

# game/scripts/c25/c25.rpy:2830
translate german c25s004_Listen_64db342a:

    # deb "No digas tonterías, [lis]. Si te hubiera besado cuando os encerré en nuestra habitación, tendrías ese día marcado en tu diario."
    deb "Red keinen Unsinn, [lis]. Wenn ich dich geküsst hätte, als ich dich in unserem Zimmer eingesperrt habe, würdest du diesen Tag in deinem Tagebuch vermerken."

# game/scripts/c25/c25.rpy:2831
translate german c25s004_Listen_7eb04199:

    # deb "Creo que, cuando se cumpla un año de tu primer beso cuando salgas con alguien, lo celebrarás más que cuando se cumpla un año de vuestra futura primera cita."
    deb "Ich glaube, dass man den Jahrestag des ersten Kusses mit jemandem mehr feiern wird als den Jahrestag des ersten Dates in der Zukunft."

# game/scripts/c25/c25.rpy:2833
translate german c25s004_Listen_77282ea8:

    # deb "A mí me gustaría celebrar como nuestro aniversario el día que nos besamos en el lago por primera vez."
    deb "Ich möchte den Tag, an dem wir uns zum ersten Mal am See geküsst haben, als unseren Jahrestag feiern."

# game/scripts/c25/c25.rpy:2835
translate german c25s004_Listen_7d823dbe:

    # kat "Pero eso es porque tú y [kim] sois unas románticas. *Risa* La mayoría de la gente celebra la boda."
    kat "Aber das liegt daran, dass du und [kim] so romantisch seid. *Lacht* Die meisten Leute feiern die Hochzeit."

# game/scripts/c25/c25.rpy:2836
translate german c25s004_Listen_261a1a24:

    # kat "Pero la pregunta importante es... ¿Lees el diario de tu hermana, [deb.nick]?"
    kat "Aber die wichtige Frage ist... Liest du das Tagebuch deiner Schwester, [deb.nick]?"

# game/scripts/c25/c25.rpy:2838
translate german c25s004_Listen_60629825:

    # sai "Chicas, guardad vuestros diarios bajo llave. *Risa* Tenemos una espía."
    sai "Mädels, verschließt eure Tagebücher! *Gelächter* Wir haben eine Spionin."

# game/scripts/c25/c25.rpy:2839
translate german c25s004_Listen_2f6e62de:

    # mcp "(*Risa mental* Sí, pero no tiene que ver con los diarios.)"
    mcp "(*Innerliches Lachen* Ja, aber das hat nichts mit Tagebüchern zu tun.)"

# game/scripts/c25/c25.rpy:2841
translate german c25s004_Listen_9f506759:

    # lis "*Risa* Siempre se lo he dejado leer. Es un diario online y tiene permiso para leerlo... al menos tiene permisos para ver algunas entradas."
    lis "*Lacht* Ich habe ihn es immer lesen lassen. Es ist ein Online-Tagebuch und er hat die Erlaubnis, es zu lesen... zumindest darf er einige Einträge sehen."

# game/scripts/c25/c25.rpy:2842
translate german c25s004_Listen_a958c3d2:

    # lis "Nos ha ido muy bien algunas veces. Ya sabéis que a veces me pongo muy estúpida sin venir a cuento."
    lis "Wir haben uns manchmal echt gut geschlagen. Du weißt ja, wie ich manchmal ohne jeden Grund total blöd werde."

# game/scripts/c25/c25.rpy:2843
translate german c25s004_Listen_0e536994:

    # todas "*Risa* Sí."
    todas "*Lacht* Ja."

# game/scripts/c25/c25.rpy:2845
translate german c25s004_Listen_7dcc2caf:

    # kim "*Risa* Somos unas malas amigas... Tendríamos que haberle dicho, 'No, [lis], siempre que te pones estúpida es por una razón justificada.'"
    kim "*lacht* Wir sind schlechte Freunde... Wir hätten ihr sagen sollen: „Nein, [lis], wenn du dich dumm anstellst, hat das einen triftigen Grund.“"

# game/scripts/c25/c25.rpy:2846
translate german c25s004_Listen_3e51f1da:

    # kim "*Risa* Pero mentir también es de malas amigas... Estoy en una encrucijada."
    kim "*Lacht* Aber Lügen ist auch schlechte Gesellschaft... Ich stehe vor einer schwierigen Entscheidung."

# game/scripts/c25/c25.rpy:2847
translate german c25s004_Listen_b3b94564:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c25/c25.rpy:2849
translate german c25s004_Listen_23de23e2:

    # lis "*Risa* Te robaré el pintalabios como venganza por lo que acabas de decir."
    lis "*Lacht* Zur Rache für das, was du gerade gesagt hast, werde ich dir deinen Lippenstift stehlen."

# game/scripts/c25/c25.rpy:2850
translate german c25s004_Listen_63251888:

    # lis "Es broma. Me encanta que me digáis lo que hago mal. Hasta ahora sólo se atrevía [deb.nick]."
    lis "Nur Spaß. Ich freue mich immer, wenn du mir sagst, was ich falsch mache. Bisher hat sich das nur [deb.nick] getraut."

# game/scripts/c25/c25.rpy:2852
translate german c25s004_Listen_f25147f6:

    # kat "Chicas, nos estamos desviando del tema. Estábamos hablando de [mc]."
    kat "Mädels, wir schweifen vom Thema ab. Wir haben über [mc] gesprochen."

# game/scripts/c25/c25.rpy:2853
translate german c25s004_Listen_972239aa:

    # kat "[eil], la última vez estabas diciendo algo de un columpio."
    kat "[eil], letztes Mal hast du etwas über eine Schaukel gesagt."

# game/scripts/c25/c25.rpy:2855
translate german c25s004_Listen_6c13d4f7:

    # eil "Bueno, ha habido varias veces en un columpio, pero..."
    eil "Nun ja, das ist schon mehrmals auf einer Schaukel passiert, aber..."

# game/scripts/c25/c25.rpy:2856
translate german c25s004_Listen_1e77ac63:

    # mcp "(Creo que es el momento de hacerme notar. Si empiezan a hablar de sexo y me descubren escuchando se van a enfadar.)"
    mcp "(Ich glaube, es ist an der Zeit, mich bemerkbar zu machen. Wenn sie anfangen, über Sex zu reden und mich beim Zuhören erwischen, werden sie wütend sein.)"

# game/scripts/c25/c25.rpy:2857
translate german c25s004_Listen_1fa64ca7:

    # mcp "(Especialmente si hablan de sexo conmigo.)"
    mcp "(Besonders wenn sie mit mir über Sex reden.)"

# game/scripts/c25/c25.rpy:2918
translate german c25s004_MarPickles_edd270a7:

    # "Llegas a la cocina y ves a [mar] con la cabeza metida en la nevera."
    "Du kommst in die Küche und siehst [mar], dessen Kopf im Kühlschrank steckt."

# game/scripts/c25/c25.rpy:2919
translate german c25s004_MarPickles_956ec74f:

    # mc "¿Estás preparando la comida?"
    mc "Bereitest du das Essen zu?"

# game/scripts/c25/c25.rpy:2922
translate german c25s004_MarPickles_71094ac0:

    # mom "No, aún no. Me han apetecido pepinillos con helado de chocolate, pero no nos quedan pepinillos."
    mom "Nein, noch nicht. Ich hätte so Lust auf Essiggurken mit Schokoladeneis, aber wir haben keine Essiggurken mehr."

# game/scripts/c25/c25.rpy:2923
translate german c25s004_MarPickles_84f35fa2:

    # mc "¡Aargh! *Risa* ¡Eso tiene que tener un gusto horrendo! No te he visto nunca comer algo así."
    mc "Igitt! *lacht* Das muss ja furchtbar schmecken! Ich habe dich noch nie so etwas essen sehen."

# game/scripts/c25/c25.rpy:2924
translate german c25s004_MarPickles_7613b351:

    # mc "¿Es posible que sea un antojo del embarazo?"
    mc "Könnte es sich um ein Schwangerschaftsgelüst handeln?"

# game/scripts/c25/c25.rpy:2927
translate german c25s004_MarPickles_7c51ff83:

    # mom "No lo creo. No tuve antojos cuando estuve embarazada de ti ni de [emm]. Siempre he pensado que los antojos son una tontería para explotar a los pobres padres."
    mom "Ich glaube nicht. Ich hatte weder in deiner noch in der Schwangerschaft mit [emm] irgendwelche Gelüste. Ich fand Gelüste schon immer eine alberne Ausrede, um arme Eltern auszunutzen."

# game/scripts/c25/c25.rpy:2929
translate german c25s004_MarPickles_28435bd9:

    # mom "No lo creo. Siempre he pensado que los antojos son una tontería para explotar a los pobres padres."
    mom "Ich glaube nicht. Ich habe immer gedacht, dass Heißhungerattacken eine dumme Art sind, arme Eltern auszunutzen."

# game/scripts/c25/c25.rpy:2930
translate german c25s004_MarPickles_14bc9b06:

    # mom "Pero es posible... ahora que lo dices, suena asqueroso."
    mom "Aber es ist möglich... jetzt, wo Sie es erwähnen, klingt es widerlich."

# game/scripts/c25/c25.rpy:2931
translate german c25s004_MarPickles_139ace68:

    # mc "¿Quieres que vaya a comprar pepinillos?"
    mc "Soll ich ein paar Essiggurken kaufen gehen?"

# game/scripts/c25/c25.rpy:2933
translate german c25s004_MarPickles_59520599:

    # mom "Si no te importa... Pese a que suena asqueroso, me siguen apeteciendo."
    mom "Wenn es Ihnen nichts ausmacht... Auch wenn es ekelhaft klingt, möchte ich sie trotzdem haben."

# game/scripts/c25/c25.rpy:2934
translate german c25s004_MarPickles_3a59328e:

    # mc "No te preocupes, ahora voy a comprarlos."
    mc "Keine Sorge, ich kaufe sie jetzt."

# game/scripts/c25/c25.rpy:2936
translate german c25s004_MarPickles_f88ea23f:

    # mom "Estaba empezando a prepararla, pero no hay suficiente pollo."
    mom "Ich hatte gerade mit den Vorbereitungen begonnen, aber es ist nicht genug Hühnchen da."

# game/scripts/c25/c25.rpy:2937
translate german c25s004_MarPickles_ee07af24:

    # mc "¿Quieres que vaya a comprar?"
    mc "Soll ich einkaufen gehen?"

# game/scripts/c25/c25.rpy:2939
translate german c25s004_MarPickles_2dfd3d61:

    # mom "Si no te importa... Iba a hacer paella, aunque seguramente algún español me mataría si probase mi receta de paella."
    mom "Wenn es Ihnen nichts ausmacht... Ich wollte Paella machen, obwohl ich mir sicher bin, dass mich irgendein Spanier umbringen würde, wenn er mein Paella-Rezept ausprobieren würde."

# game/scripts/c25/c25.rpy:2940
translate german c25s004_MarPickles_2efe82ef:

    # mc "*Risa* Ningún problema. Y seguramente ese español cambiaría la receta tradicional por la tuya en cuanto la probara. Tu paella está buenísima."
    mc "*Lacht* Kein Problem. Und ich bin mir sicher, der Spanier würde das traditionelle Rezept sofort gegen deins eintauschen, sobald er es probiert hat. Deine Paella ist köstlich."

# game/scripts/c25/c25.rpy:2943
translate german c25s004_MarPickles_70958b08:

    # mom "Gracias, mi amor."
    mom "Danke meine Liebe."

# game/scripts/c25/c25.rpy:2945
translate german c25s004_MarPickles_4724458f:

    # mom "¿Puedes pasar a buscar a [mad.nick] también? Así le ahorras tener que coger un Under para venir a comer."
    mom "Kannst du auch [mad.nick] aufheben? So sparst du ihm die Notwendigkeit, einen Under zu nehmen, um essen zu kommen."

