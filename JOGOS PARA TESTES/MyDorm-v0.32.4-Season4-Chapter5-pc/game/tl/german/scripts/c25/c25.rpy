    mc "Und du hast Angst, nicht wahr?"

# game/scripts/c25/c25.rpy:3718
translate german c25s006_AmaCuddle_cd9bbd02:

    # ama "Es imposible no tenerlo. Claire se volvió adicta al sexo. Diana lo odió cada minuto. ¿Qué me va a pasar a mí?"
    ama "Es ist unmöglich, es nicht zu haben. Claire wurde sexsüchtig. Diana hasste jede Minute. Was wird nur aus mir?"

# game/scripts/c25/c25.rpy:3719
translate german c25s006_AmaCuddle_06e300a4:

