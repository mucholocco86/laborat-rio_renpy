    ama "Ja... Abgesehen von den gelegentlichen vorgetäuschten Küssen während Operationen..."

# game/scripts/c25/c25.rpy:3716
translate german c25s006_AmaCuddle_629dfe10:

    # ama "De hecho, eres el primer chico a quien he besado de verdad..."
    ama "Tatsächlich bist du der erste Junge, den ich jemals geküsst habe..."

# game/scripts/c25/c25.rpy:3717
translate german c25s006_AmaCuddle_de1b5658:

