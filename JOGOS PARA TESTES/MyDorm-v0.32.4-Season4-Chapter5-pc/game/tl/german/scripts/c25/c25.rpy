# game/scripts/c25/c25.rpy:3183
translate german c25s004_OmaPickles_5ba5a3df:

    # oma "Pero es posible... ahora que lo dices, suena asqueroso."
    oma "Aber es ist möglich... jetzt, wo Sie es erwähnen, klingt es widerlich."

# game/scripts/c25/c25.rpy:3184
translate german c25s004_OmaPickles_139ace68:

    # mc "¿Quieres que vaya a comprar pepinillos?"
    mc "Soll ich ein paar Essiggurken kaufen gehen?"

# game/scripts/c25/c25.rpy:3186
translate german c25s004_OmaPickles_92844311:

    # oma "Si no te importa... Pese a que suena asqueroso, me siguen apeteciendo."
    oma "Wenn es Ihnen nichts ausmacht... Auch wenn es ekelhaft klingt, möchte ich sie trotzdem haben."

# game/scripts/c25/c25.rpy:3187
translate german c25s004_OmaPickles_3a59328e:

    # mc "No te preocupes, ahora voy a comprarlos."
    mc "Keine Sorge, ich kaufe sie jetzt."

# game/scripts/c25/c25.rpy:3189
translate german c25s004_OmaPickles_3270d59a:

    # oma "Gracias, mi amor."
    oma "Danke meine Liebe."

# game/scripts/c25/c25.rpy:3191
translate german c25s004_OmaPickles_4ad2d412:

    # oma "¿Puedes pasar a buscar a [mad.nick] también? Así le ahorras tener que coger un Under para venir a comer."
    oma "Kannst du auch [mad.nick] aufheben? So sparst du ihm die Notwendigkeit, einen Under zu nehmen, um zum Essen zu kommen."

# game/scripts/c25/c25.rpy:3192
translate german c25s004_OmaPickles_693d082e:

    # mc "Ningún problema. ¿La avisas tú de que voy a por ella?"
    mc "Kein Problem. Könntest du ihr ausrichten, dass ich sie abholen komme?"

# game/scripts/c25/c25.rpy:3209
translate german c25s004_GetMad_64444bd1:

    # "Conduces hasta la tienda y compras los pepinillos. También compras una lata de atún para el pequeño dictador."
    "Du fährst zum Laden und kaufst die Essiggurken. Außerdem kaufst du eine Dose Thunfisch für den kleinen Diktator."

# game/scripts/c25/c25.rpy:3210
translate german c25s004_GetMad_18de90a7:

    # "Empiezas a estar un poco preocupado por si los antojos son reales."
    "Man beginnt sich ein wenig Sorgen zu machen, ob die Gelüste real sind."

# game/scripts/c25/c25.rpy:3212
translate german c25s004_GetMad_c910e8e2:

    # "Conduces hasta la tienda y compras el pollo que te ha pedido [mar]. También compras una lata de atún para el pequeño dictador."
    "Du fährst zum Laden und kaufst das gewünschte Hähnchen. Außerdem kaufst du eine Dose Thunfisch für den kleinen Diktator."

# game/scripts/c25/c25.rpy:3215
translate german c25s004_GetMad_c913ca08:

    # "Una vez hechas las compras, vas a casa de [mad.nick]."
    "Sobald du deine Einkäufe erledigt hast, gehst du zu [mad.nick] nach Hause."

# game/scripts/c25/c25.rpy:3216
translate german c25s004_GetMad_b9f6f9e6:

    # mc "Buenos días, [mad.nick]. ¿Estás lista para irnos?"
    mc "Guten Morgen, [mad.nick]. Sind Sie bereit loszufahren?"

# game/scripts/c25/c25.rpy:3217
translate german c25s004_GetMad_55e1cd45:

    # mad "Aún no, tengo que hacer algunas cosas."
    mad "Noch nicht, ich habe noch einiges zu erledigen."

# game/scripts/c25/c25.rpy:3220
translate german c25s004_GetMad_a268053a:

    # "La preciosa modista te besa apasionadamente. Hace demasiado tiempo que no habéis estado a solas."
    "Die schöne Schneiderin küsst dich leidenschaftlich. Es ist schon viel zu lange her, dass ihr allein zusammen wart."

# game/scripts/c25/c25.rpy:3222
translate german c25s004_GetMad_0b0eee98:

    # mad "*Risita* Una cosa menos que hacer."
    mad "*Kichern* Eine Sache weniger zu tun."

# game/scripts/c25/c25.rpy:3225
translate german c25s004_GetMad_ebd3c8be:

    # mad "Estaba a punto de prepararme unos pepinillos con helado de pistacho cuando has llegado, creía que ibas a tardar más. ¿Quieres?"
    mad "Ich wollte mir gerade eingelegte Gurken mit Pistazieneis zubereiten, als du ankamst; ich dachte, du würdest länger bleiben. Möchtest du etwas davon?"

# game/scripts/c25/c25.rpy:3227
translate german c25s004_GetMad_6e76e73d:

    # mc "No sé lo que os ha dado hoy con los pepinillos, pero no, gracias. Suena bastante asqueroso."
    mc "Ich weiß nicht, was heute mit euch allen los ist mit den Essiggurken, aber nein, danke. Das klingt ziemlich ekelhaft."

# game/scripts/c25/c25.rpy:3229
translate german c25s004_GetMad_95b10980:

    # mc "No, gracias. Suena bastante asqueroso."
    mc "Nein, danke. Das klingt ziemlich ekelhaft."

# game/scripts/c25/c25.rpy:3230
translate german c25s004_GetMad_58f9a322:

    # mad "Entonces, dame un momento para prepararle la comida a Zeus y nos podemos ir."
    mad "Dann gib mir einen Moment, um Zeus' Essen vorzubereiten, und dann können wir los."

# game/scripts/c25/c25.rpy:3232
translate german c25s004_GetMad_839c0696:

    # mad "Dame un momento para prepararle la comida a Zeus y nos podemos ir."
    mad "Gib mir einen Moment Zeit, um Zeus' Essen vorzubereiten, dann können wir los."

# game/scripts/c25/c25.rpy:3236
translate german c25s004_GetMad_de9248c8:

    # zeu "*¿Miau?* (¿He oído algo sobre comida?)" id c25s004_GetMad_de9248c8
    zeu "*Miau?* (Habe ich da etwa etwas über Futter gehört?)" id c25s004_GetMad_de9248c8

# game/scripts/c25/c25.rpy:3238
translate german c25s004_GetMad_6bd709cd:

    # zeu "*¡Miau!* *Miau...* (¡Otra vez tú! Pero esta vez hueles a lata de atún... lata de atún cerrada...)" id c25s004_GetMad_6bd709cd
    zeu "*Miau!* *Miau...* (Du bist es wieder! Aber diesmal riechst du wie eine Thunfischdose... eine verschlossene Thunfischdose...)" id c25s004_GetMad_6bd709cd

# game/scripts/c25/c25.rpy:3239
translate german c25s004_GetMad_ebcc9aec:

    # mc "Hola, Pequeñajo. ¿Me has echado de menos?"
    mc "Hey, Kleiner. Hast du mich vermisst?"

# game/scripts/c25/c25.rpy:3241
translate german c25s004_GetMad_832eb124:

    # zeu "*¿Miau?* *¡Miau!* (¿Pequeñajo? ¡Para ti, es Lord Simba!)" id c25s004_GetMad_832eb124
    zeu "*Miau?* *Miau!* (Kleiner? Für dich ist er Lord Simba!)" id c25s004_GetMad_832eb124

# game/scripts/c25/c25.rpy:3243
translate german c25s004_GetMad_73bdd14d:

    # zeu "*Miau* *Purr* (Pero si me rascas así, puedes llamarme como quieras.)" id c25s004_GetMad_73bdd14d
    zeu "*Miau* *Schnurr* (Aber wenn du mich so kraulst, kannst du mich nennen, wie du willst.)" id c25s004_GetMad_73bdd14d

# game/scripts/c25/c25.rpy:3245
translate german c25s004_GetMad_e0122449:

    # mad "Me encanta ver lo bien que se lleva contigo. *Risa* Más aún teniendo en cuenta que no le traes comida."
    mad "Ich finde es toll zu sehen, wie gut er sich mit dir versteht. *lacht* Vor allem, wenn man bedenkt, dass du ihm kein Futter mitbringst."

# game/scripts/c25/c25.rpy:3246
translate german c25s004_GetMad_be2a8125:

    # mc "Le he comprado una lata de atún, pero me la he dejado en la camioneta."
    mc "Ich habe ihm eine Dose Thunfisch gekauft, aber ich habe sie im LKW gelassen."

# game/scripts/c25/c25.rpy:3247
translate german c25s004_GetMad_dbd50b39:

    # mc "Te iba a proponer que lo trajeras a casa, estoy seguro de que a las chicas les va a encantar conocerlo."
    mc "Ich wollte dir vorschlagen, ihn mit nach Hause zu bringen; ich bin sicher, die Mädchen werden es lieben, ihn kennenzulernen."

# game/scripts/c25/c25.rpy:3249
translate german c25s004_GetMad_2665f6a9:

    # zeu "*Miau* *Purr* (Normal, soy adorable... Especialmente una vez me coma esa lata que has olvidado.)" id c25s004_GetMad_2665f6a9
    zeu "*Miau* *Schnurr* (Normalerweise bin ich total süß... Vor allem, wenn ich die Dose gegessen habe, die du vergessen hast.)" id c25s004_GetMad_2665f6a9

# game/scripts/c25/c25.rpy:3251
translate german c25s004_GetMad_0e6853e8:

    # mad "No sé, [mc]. Aunque contigo se lleve bien, no es muy sociable. No sé si arañará a alguna de las chicas."
    mad "Ich weiß nicht, [mc]. Obwohl er sich gut mit dir versteht, ist er nicht besonders gesellig. Ich weiß nicht, ob er mit einem der Mädchen flirten wird."

# game/scripts/c25/c25.rpy:3252
translate german c25s004_GetMad_c851fea0:

    # mc "Bueno, es tu gato. Tu lo conoces mejor que nadie."
    mc "Nun ja, es ist deine Katze. Du kennst sie besser als jeder andere."

# game/scripts/c25/c25.rpy:3254
translate german c25s004_GetMad_0a4d1a18:

    # zeu "*Purr divertido* *¡Miau!* (*Risa* ¡Su gato! Estos humanos son tan graciosos... ¡Mascotas creyéndose los amos!)" id c25s004_GetMad_0a4d1a18
    zeu "*Schnurren (lustig)* *Miau!* (*Lacht* Ihre Katze! Diese Menschen sind so komisch... Haustiere, die denken, sie wären der Boss!)" id c25s004_GetMad_0a4d1a18

# game/scripts/c25/c25.rpy:3255
translate german c25s004_GetMad_3ecd5704:

    # mcp "(¿El gato se ha reido? Deben ser imaginaciones mías...)"
    mcp "(Hat die Katze gelacht? Das muss wohl Einbildung sein...)"

# game/scripts/c25/c25.rpy:3257
translate german c25s004_GetMad_d68064d0:

    # mad "Zeus, ¿quieres venir a conocer a las chicas? ¿Te vas a portar bien? Seguro que hay comida para ti."
    mad "Zeus, möchtest du mitkommen und die Mädchen kennenlernen? Wirst du dich benehmen? Ich bin sicher, es gibt etwas zu essen für dich."

# game/scripts/c25/c25.rpy:3258
translate german c25s004_GetMad_e0079f15:

    # mc "*Risa* Le hablas como si te entendiera."
    mc "*Lacht* Du redest mit ihm, als ob er dich verstehen würde."

# game/scripts/c25/c25.rpy:3259
translate german c25s004_GetMad_88233d1e:

    # mad "Te sorprenderías de lo mucho que parece entender..."
    mad "Sie wären überrascht, wie viel er zu verstehen scheint..."

# game/scripts/c25/c25.rpy:3261
translate german c25s004_GetMad_dbcaa708:

    # mc "¡Ostias! ¿Dónde ha ido?"
    mc "Heilige Scheiße! Wo ist er hin?"

# game/scripts/c25/c25.rpy:3262
translate german c25s004_GetMad_a465a5d3:

    # mad "*Risa* Te he dicho que te sorprenderías."
    mad "*lacht* Ich hab's dir ja gesagt, du würdest staunen."

# game/scripts/c25/c25.rpy:3264
translate german c25s004_GetMad_70cbe712:

    # zeu "*¿Miau?* (¿Nos podemos ir a conocer a esas chicas que regalan comida?)" id c25s004_GetMad_70cbe712
    zeu "*Miau?* (Können wir die Mädchen treffen, die Essen verschenken?)" id c25s004_GetMad_70cbe712

# game/scripts/c25/c25.rpy:3266
translate german c25s004_GetMad_8a261ec7:

    # mad "*Risa* Ya está en la puerta esperando. No hay como decirle que hay comida en algún sitio."
    mad "*Lacht* Er wartet schon an der Tür. Man kann ihm nicht sagen, dass es irgendwo Essen gibt."

# game/scripts/c25/c25.rpy:3267
translate german c25s004_GetMad_45d1dbca:

    # mad "Dame un momento para que coja el bolso y nos podemos ir. También tengo que coger otra cosa..."
    mad "Gib mir einen Moment, um meine Tasche zu holen, dann können wir los. Ich muss auch noch etwas anderes besorgen..."

# game/scripts/c25/c25.rpy:3268
translate german c25s004_GetMad_326d9f1b:

    # mc "*Risa* Te espero acariciando a Zeus."
    mc "*Lachen* Ich warte darauf, dass du Zeus streichelst."

# game/scripts/c25/c25.rpy:3270
translate german c25s004_GetMad_b9015529:

    # zeu "*¡Miau!* (¡Sí, caricias para Lord Simba!)" id c25s004_GetMad_b9015529
    zeu "*Miau!* (Ja, ich streichle Lord Simba!)" id c25s004_GetMad_b9015529

# game/scripts/c25/c25.rpy:3272
translate german c25s004_GetMad_df76e855:

    # "Os ponéis en camino unos minutos después. Zeus se pasa todo el viaje con la cabeza dentro de la bolsa donde está la lata de atún."
    "Wenige Minuten später brechen Sie auf. Zeus verbringt die gesamte Reise mit dem Kopf in der Tasche, in der sich die Thunfischdose befindet."

# game/scripts/c25/c25.rpy:3274
translate german c25s004_GetMad_8c466a7c:

    # "Por suerte, no sabe abrirla... O es demasiado vago para hacerlo y está esperando que sus sirvientes humanos lo hagan por él."
    "Zum Glück weiß er nicht, wie man es öffnet... Oder er ist zu faul dazu und wartet darauf, dass seine menschlichen Diener es für ihn erledigen."

# game/scripts/c25/c25.rpy:3331
translate german c25s005_ZeusAtHome_c1e656bf:

    # "Al llegar a casa, vais directos a la cocina de [nor]."
    "Wenn du nach Hause kommst, gehst du direkt in die Küche von [nor]."

# game/scripts/c25/c25.rpy:3332
translate german c25s005_ZeusAtHome_ef64a4e3:

    # mc "Te dejo los pepinillos que me has pedido en la nevera."
    mc "Ich habe die von Ihnen gewünschten Essiggurken in den Kühlschrank gestellt."

# game/scripts/c25/c25.rpy:3333
translate german c25s005_ZeusAtHome_b1c907a2:

    # nor "Gracias, [mc]."
    nor "Vielen Dank, [mc]."

# game/scripts/c25/c25.rpy:3334
translate german c25s005_ZeusAtHome_7549b2ae:

    # nor "Hola, [mad.nick]."
    nor "Hallo, [mad.nick]."

# game/scripts/c25/c25.rpy:3337
translate german c25s005_ZeusAtHome_9c50a15a:

    # "Al llegar a casa, dejas el pollo que te ha pedido [mar] en la nevera y vais a la cocina de [nor]."
    "Wenn du nach Hause kommst, lässt du das Huhn, das [mar] bestellt hat, im Kühlschrank und gehst in die Küche von [nor]."

# game/scripts/c25/c25.rpy:3339
translate german c25s005_ZeusAtHome_d6cfd815:

    # "Al llegar a casa, dejas los pepinillos en la nevera, le mandas un mensaje a [whoPickles], y vais a la cocina de [nor]."
    "Wenn du nach Hause kommst, stellst du die Essiggurken in den Kühlschrank, schickst eine Nachricht an [whoPickles] und gehst in die Küche von [nor]."

# game/scripts/c25/c25.rpy:3340
translate german c25s005_ZeusAtHome_7c234c8f:

    # nor "Hola, [mad.nick]. Hola de nuevo, [mc]."
    nor "Hallo, [mad.nick]. Hallo nochmal, [mc]."

# game/scripts/c25/c25.rpy:3342
translate german c25s005_ZeusAtHome_71b1c336:

    # nor "¿Llevas un gato en la bolsa, [mad.nick]?"
    nor "Hast du eine Katze in deiner Tasche, [mad.nick]?"

# game/scripts/c25/c25.rpy:3344
translate german c25s005_ZeusAtHome_57a99d67:

    # mad "Hola, [nor]. *Risa* Sí, es Zeus. Creo que está intentando abrir la lata de atún que [mc] le ha comprado."
    mad "Hallo, [nor]. *Lacht* Ja, ich bin's, Zeus. Ich glaube, er versucht gerade, die Thunfischdose zu öffnen, die [mc] ihm gekauft hat."

# game/scripts/c25/c25.rpy:3345
translate german c25s005_ZeusAtHome_0ca02bc7:

    # mc "Es un pequeño glotón. Te lo ganarás si le das comida."
    mc "Er ist ein kleiner Vielfraß. Du wirst ihn für dich gewinnen, wenn du ihn fütterst."

# game/scripts/c25/c25.rpy:3347
translate german c25s005_ZeusAtHome_41f59f42:

    # zeu "*Miau* (¿He oído que esta señora reparte comida?)"
    zeu "*Miau* (Habe ich da etwa gehört, dass diese Dame Essen ausliefert?)"

# game/scripts/c25/c25.rpy:3348
translate german c25s005_ZeusAtHome_3b938227:

    # mc "*Risa* A veces creo que nos entiende. Oye la palabra 'comida' y se olvida de lo que estaba haciendo."
    mc "*lacht* Manchmal glaube ich, er versteht uns. Er hört das Wort „Essen“ und vergisst, was er gerade getan hat."

# game/scripts/c25/c25.rpy:3350
translate german c25s005_ZeusAtHome_07ff799a:

    # mad "¿Quieres que lo deje en algún sitio donde no moleste? Está bien educado, y no va a hacer sus cosas en el suelo ni a arañar los muebles."
    mad "Soll ich ihn irgendwohin bringen, wo er nicht im Weg ist? Er ist wohlerzogen und macht weder auf den Boden noch zerkratzt er die Möbel."

# game/scripts/c25/c25.rpy:3352
translate german c25s005_ZeusAtHome_6a2f5e12:

    # nor "Si está bien educado lo puedes dejar suelto. ¿Le puedo dar un trozo de salchicha?"
    nor "Wenn er sich gut benimmt, können Sie ihn von der Leine lassen. Darf ich ihm ein Stück Wurst geben?"

# game/scripts/c25/c25.rpy:3354
translate german c25s005_ZeusAtHome_99acdd36:

    # zeu "*Miau* (Si dices que no, sé dónde duermes. Mi cola puede meterse en tu boca sin que yo pueda, o quiera, hacer nada por evitarlo.)"
    zeu "*Miau* (Wenn du Nein sagst, weiß ich, wo du schläfst. Mein Schwanz kann in dein Maul wandern und ich kann oder will nichts dagegen tun.)"

# game/scripts/c25/c25.rpy:3356
translate german c25s005_ZeusAtHome_fbb3b9ff:

    # mad "Creo que no habrá ningún problema. Come de todo."
    mad "Ich glaube nicht, dass es irgendwelche Probleme geben wird. Iss alles auf."

# game/scripts/c25/c25.rpy:3357
translate german c25s005_ZeusAtHome_7f2d48c2:

    # mc "*Risa* Además, Zeus tendrá una nueva mejor amiga."
    mc "*Gelächter* Außerdem wird Zeus einen neuen besten Freund haben."

# game/scripts/c25/c25.rpy:3358
translate german c25s005_ZeusAtHome_8df3ef23:

    # mc "Dame la bolsa, [mad.nick], voy a guardar las cosas en la nevera."
    mc "Gib mir die Tasche, [mad.nick], ich werde die Sachen in den Kühlschrank stellen."

# game/scripts/c25/c25.rpy:3360
translate german c25s005_ZeusAtHome_308493de:

    # "El gato, como siempre, parece entender lo que estáis diciendo y salta ágilmente de la bolsa a la isla de la cocina."
    "Die Katze scheint wie immer zu verstehen, was man sagt, und springt flink von der Tasche auf die Kücheninsel."

# game/scripts/c25/c25.rpy:3361
translate german c25s005_ZeusAtHome_d7055b23:

    # zeu "*Miau* (Tienes mi autorización para alimentarme, humana.)"
    zeu "*Miau* (Du hast meine Erlaubnis, mich zu füttern, Mensch.)"

# game/scripts/c25/c25.rpy:3363
translate german c25s005_ZeusAtHome_8a4f2de9:

    # mad "¡Zeus! ¡Baja de ahí ahora mismo! Acabo de decirles que estás bien educado."
    mad "Zeus! Komm sofort da runter! Ich habe ihnen doch gerade gesagt, dass du wohlerzogen bist."

# game/scripts/c25/c25.rpy:3365
translate german c25s005_ZeusAtHome_f49740ea:

    # zeu "*Miau lastimero* (Pero el tipo feo le ha dicho a la Alimentadora Suprema que si hay comida por en medio me olvido de todo...)"
    zeu "*Mitleidser Miau* (Aber der hässliche Kerl sagte dem Obersten Fütterer, dass ich alles vergesse, wenn es ums Essen geht...)"

# game/scripts/c25/c25.rpy:3367
translate german c25s005_ZeusAtHome_e98194c3:

    # mad "Zeeeeus..."
    mad "Zeeeus..."

# game/scripts/c25/c25.rpy:3369
translate german c25s005_ZeusAtHome_0690a050:

    # zeu "*Miaaaau* (Vaaaaale.)"
    zeu "*Miau* (Okay.)"

# game/scripts/c25/c25.rpy:3371
translate german c25s005_ZeusAtHome_ebb7109f:

    # "Baja del mostrador tan ágilmente como ha subido, aunque por alguna razón te parece que lo hace con cara de pena."
    "Sie steigt genauso flink vom Tresen herunter, wie sie hinaufgestiegen ist, obwohl es Ihnen aus irgendeinem Grund so vorkommt, als täte sie es mit einem traurigen Gesichtsausdruck."

# game/scripts/c25/c25.rpy:3372
translate german c25s005_ZeusAtHome_94415e2c:

    # "Rodea la isla de la cocina para ir a los pies de [nor]."
    "Gehe um die Kücheninsel herum, um zu den Füßen von [nor] zu gelangen."

# game/scripts/c25/c25.rpy:3374
translate german c25s005_ZeusAtHome_4fb1d052:

    # nor "Realmente lo has educado muy bien. Felicidades, [mad.nick]. Siempre he oído que los gatos son más difíciles de educar que los perros."
    nor "Du hast ihn wirklich gut trainiert. Herzlichen Glückwunsch! Ich habe immer gehört, dass Katzen schwieriger zu trainieren sind als Hunde."

# game/scripts/c25/c25.rpy:3375
translate german c25s005_ZeusAtHome_800adf8b:

    # mc "*Risa* A mí siempre me han parecido más listos que los perros."
    mc "*Gelächter* Ich habe immer gedacht, sie wären schlauer als Hunde."

# game/scripts/c25/c25.rpy:3376
translate german c25s005_ZeusAtHome_eece51dd:

    # mc "Un perro es como un niño pequeño, siempre haciendo ruido, necesitando atención, y emocionándose por todo."
    mc "Ein Hund ist wie ein kleines Kind, er macht ständig Lärm, braucht Aufmerksamkeit und ist von allem begeistert."

# game/scripts/c25/c25.rpy:3377
translate german c25s005_ZeusAtHome_f710df82:

    # mc "Un gato es como un jubilado. *Risa* Se deja alimentar y sólo te presta atención cuando a él le da la gana."
    mc "Eine Katze ist wie ein Rentner. *lacht* Sie lässt sich füttern und beachtet einen nur, wenn sie Lust dazu hat."

# game/scripts/c25/c25.rpy:3379
translate german c25s005_ZeusAtHome_6a8e89aa:

    # zeu "*Miau* (Escuchad a este tío. Sabe de lo que habla.)"
    zeu "*Miau* (Hört euch diesen Kerl an. Er weiß, wovon er spricht.)"

# game/scripts/c25/c25.rpy:3380
translate german c25s005_ZeusAtHome_c30791f8:

    # zeu "*Miau?* (¿Dónde está mi salchicha?)" id c25s005_ZeusAtHome_c30791f8
    zeu "*Miau?* (Wo ist meine Wurst?)" id c25s005_ZeusAtHome_c30791f8

# game/scripts/c25/c25.rpy:3382
translate german c25s005_ZeusAtHome_5247916e:

    # nor "¿Quieres un trozo de salchicha, chiquitín?"
    nor "Möchtest du ein Stück Wurst, Kleiner?"

# game/scripts/c25/c25.rpy:3383
translate german c25s005_ZeusAtHome_4917eeff:

    # zeu "*Miau* (¡Sí! ¡Alimenta a tu Señor!)"
    zeu "*Miau* (Ja! Füttere deinen Herrn!)"

# game/scripts/c25/c25.rpy:3385
translate german c25s005_ZeusAtHome_903b361d:

    # "La salchicha desaparece en un momento en la boca del felino."
    "Die Wurst verschwindet im Nu im Maul der Katze."

# game/scripts/c25/c25.rpy:3386
translate german c25s005_ZeusAtHome_bf052574:

    # zeu "*Miau* (He puesto mi sagrada zarpa sobre ti. Ahora eres mía.)"
    zeu "*Miau* (Ich habe meine heilige Pfote auf dich gelegt. Jetzt gehörst du mir.)"

# game/scripts/c25/c25.rpy:3388
translate german c25s005_ZeusAtHome_023ef6eb:

    # nor "*Risa* Es super bonito. Y muy simpático."
    nor "*lacht* Er ist total süß. Und sehr nett."

# game/scripts/c25/c25.rpy:3389
translate german c25s005_ZeusAtHome_d1866030:

    # mc "*Risa* Mientras le des comida seguirá siendo simpático, no lo dudes."
    mc "*Lacht* Solange du ihn fütterst, wird er immer noch süß sein, daran kannst du keinen Zweifel haben."

# game/scripts/c25/c25.rpy:3391
translate german c25s005_ZeusAtHome_766bb000:

    # mad "[mc], ¿podrías enseñarle la casa a Zeus mientras yo ayudo a [nor] con la comida? Sobre todo, enséñale dónde están los lavabos."
    mad "[mc], könntest du Zeus das Haus zeigen, während ich [nor] beim Essen helfe? Zeig ihm vor allem, wo die Toiletten sind."

# game/scripts/c25/c25.rpy:3392
translate german c25s005_ZeusAtHome_948d1c75:

    # mc "Estás de broma, ¿no?"
    mc "Das ist doch nicht dein Ernst, oder?"

# game/scripts/c25/c25.rpy:3393
translate german c25s005_ZeusAtHome_5f5eb2ec:

    # mad "No, le he enseñado a hacer sus cosas en el retrete. Hay que dejar la puerta abierta y la tapa levantada."
    mad "Nein, ich habe ihm beigebracht, sein Geschäft auf der Toilette zu verrichten. Man muss die Tür offen und den Deckel oben lassen."

# game/scripts/c25/c25.rpy:3395
translate german c25s005_ZeusAtHome_f4b4206c:

    # nor "Eso lo he visto en varias películas y en videos de internet. Parece que es algo común. Cada vez más gente vive en apartamentos."
    nor "Ich habe das in mehreren Filmen und Online-Videos gesehen. Es scheint recht verbreitet zu sein. Immer mehr Menschen leben in Wohnungen."

# game/scripts/c25/c25.rpy:3396
translate german c25s005_ZeusAtHome_7b8b0137:

    # mc "Vamos, Zeus. Voy a enseñarte la casa y a presentarte al resto de la familia."
    mc "Komm schon, Zeus. Ich zeige dir das Haus und stelle dich dem Rest der Familie vor."

# game/scripts/c25/c25.rpy:3398
translate german c25s005_ZeusAtHome_e240b5d7:

    # "Antes de que te dé tiempo de irte con el gato aparecen las dos primeras chicas nuevas. Al menos nuevas para Zeus."
    "Bevor du mit der Katze gehen kannst, tauchen die ersten beiden neuen Mädchen auf. Zumindest neu für Zeus."

# game/scripts/c25/c25.rpy:3399
translate german c25s005_ZeusAtHome_b7c47a1e:

    # dap "¿Has traído a Zeus, [mad.nick]?"
    dap "Hast du Zeus mitgebracht, [mad.nick]?"

# game/scripts/c25/c25.rpy:3400
translate german c25s005_ZeusAtHome_660e4f31:

    # mad "Sí, [mc] me ha dicho que os gustaría conocerlo."
    mad "Ja, [mc] hat mir gesagt, dass du ihn gerne kennenlernen würdest."

# game/scripts/c25/c25.rpy:3401
translate german c25s005_ZeusAtHome_9d2f8ab2:

    # eri "No se ha equivocado. Tanto oír hablar de él, ya tenía ganas de verlo."
    eri "Er hatte Recht. Nachdem ich so viel über ihn gehört hatte, war ich gespannt darauf, ihn zu sehen."

# game/scripts/c25/c25.rpy:3403
translate german c25s005_ZeusAtHome_e3998c0a:

    # zeu "*Miau* (Vuestro color de pelo me confunde. Pero ahora sois mías.)"
    zeu "*Miau* (Deine Haarfarbe verwirrt mich. Aber jetzt gehörst du mir.)"

# game/scripts/c25/c25.rpy:3404
translate german c25s005_ZeusAtHome_8c047715:

    # mad "Creo que le habéis caído bien."
    mad "Ich glaube, er mochte dich."

# game/scripts/c25/c25.rpy:3406
translate german c25s005_ZeusAtHome_f80ebe80:

    # eri "¡Es precioso!"
    eri "Es ist wunderschön!"

# game/scripts/c25/c25.rpy:3407
translate german c25s005_ZeusAtHome_c51120b9:

    # dap "¡Y se deja tocar por desconocidos! Me encanta."
    dap "Und sie lässt sich von Fremden berühren! Ich liebe es."

# game/scripts/c25/c25.rpy:3408
translate german c25s005_ZeusAtHome_84ce6875:

    # zeu "*Miau* (Rascad, esclavas, rascad.)"
    zeu "*Miau* (Kratzt, Sklaven, kratzt.)"

# game/scripts/c25/c25.rpy:3411
translate german c25s005_ZeusAtHome_6c0166bf:

    # dap "Hola, [mc]. Nos tienes que explicar lo que pasó en el barco. [kim] nos ha explicado algo, pero hay partes que no sabe."
    dap "Hallo, [mc]. Du musst erklären, was auf dem Schiff passiert ist. [kim] hat schon einiges erklärt, aber es gibt Teile, die sie nicht weiß."

# game/scripts/c25/c25.rpy:3412
translate german c25s005_ZeusAtHome_2f307c20:

    # mc "Luego os lo explico."
    mc "Ich erkläre es dir später."

# game/scripts/c25/c25.rpy:3415
translate german c25s005_ZeusAtHome_3a916b49:

    # eri "Hola, cielo. Antes, durante el yoga, has desaparecido antes de que te saludara."
    eri "Hallo, Schatz. Vorhin, beim Yoga, bist du verschwunden, bevor ich Hallo sagen konnte."

# game/scripts/c25/c25.rpy:3416
translate german c25s005_ZeusAtHome_6c43b663:

    # mc "Hola, preciosa."
    mc "Hallo, du Schöne."

# game/scripts/c25/c25.rpy:3420
translate german c25s005_ZeusAtHome_ac96826c:

    # zeu "*Miau* (Me confundes. Creía que estabas con mi sirvienta...)"
    zeu "*Miau* (Du verwirrst mich. Ich dachte, du wärst mit meinem Dienstmädchen zusammen...)"

# game/scripts/c25/c25.rpy:3422
translate german c25s005_ZeusAtHome_8dca6ede:

    # zeu "*Miau* (¿Pero también estás con estas dos chicas? ¡Debes ser el equivalente a un semental humano!)"
    zeu "*Miau* (Aber du bist auch mit diesen beiden Mädchen zusammen? Du musst ja ein regelrechter Hengst sein!)"

# game/scripts/c25/c25.rpy:3424
translate german c25s005_ZeusAtHome_f1082c23:

    # zeu "*Miau* (¿Pero también esta chica? ¡Debes ser el equivalente a un semental humano!)"
    zeu "*Miau* (Aber dieses Mädchen auch? Du musst ja ein regelrechter Hengst sein!)"

# game/scripts/c25/c25.rpy:3425
translate german c25s005_ZeusAtHome_9af538dc:

    # mc "Sí, Zeus, voy a enseñarte la casa. No me metas prisa."
    mc "Ja, Zeus, ich zeige dir das Haus. Dräng mich nicht."

# game/scripts/c25/c25.rpy:3428
translate german c25s005_ZeusAtHome_4346f707:

    # zeu "*Miau* (¿Estás con las dos chicas? ¡Debes ser el equivalente a un semental humano!)"
    zeu "*Miau* (Bist du mit beiden Mädels zusammen? Du musst ja ein regelrechter Hengst sein!)"

# game/scripts/c25/c25.rpy:3429
translate german c25s005_ZeusAtHome_9af538dc_1:

    # mc "Sí, Zeus, voy a enseñarte la casa. No me metas prisa."
    mc "Ja, Zeus, ich zeige dir das Haus. Dräng mich nicht."

# game/scripts/c25/c25.rpy:3430
translate german c25s005_ZeusAtHome_f2dd6715:

    # mc "Os veo luego. Vamos, Zeus."
    mc "Bis später. Los, Zeus."

# game/scripts/c25/c25.rpy:3432
translate german c25s005_ZeusAtHome_10a86f4b:

    # "La primera parada es la sala de estar, donde están [kat] y [kim]."
    "Die erste Station ist das Wohnzimmer, wo sich [kat] und [kim] befinden."

# game/scripts/c25/c25.rpy:3433
translate german c25s005_ZeusAtHome_4c34e75e:

    # mc "Hola, chicas. Traigo visita."
    mc "Hallo Mädels. Ich habe Besuch."

# game/scripts/c25/c25.rpy:3435
translate german c25s005_ZeusAtHome_d625f10a:

    # kim "¡Qué bonito! Supongo que este debe de ser Zeus."
    kim "Wie schön! Ich nehme an, das muss Zeus sein."

# game/scripts/c25/c25.rpy:3436
translate german c25s005_ZeusAtHome_b5e1ca31:

    # zeu "*Miau* (¡Mi fama me precede! Me gustas. Una vez conocí a una gata con la piel como la tuya. Ella era más guapa. Y más peluda.)"
    zeu "*Miau* (Mein Ruf eilt mir voraus! Ich mag dich. Ich kannte mal eine Katze mit Fell wie deinem. Sie war hübscher. Und flauschiger.)"

# game/scripts/c25/c25.rpy:3438
translate german c25s005_ZeusAtHome_ce9eba37:

    # zeu "*Miau* (Mía.)"
    zeu "*Miau* (Meins.)"

# game/scripts/c25/c25.rpy:3440
translate german c25s005_ZeusAtHome_fc52ad29:

    # kat "¡Es precioso!"
    kat "Es ist wunderschön!"

# game/scripts/c25/c25.rpy:3441
translate german c25s005_ZeusAtHome_f52acb1f:

    # zeu "*Miau* (Tú también eres mía. Tienes pinta de ser mullida para echarme una siesta encima tuyo. Me entra sueño sólo de pensarlo.)"
    zeu "*Miau* (Du gehörst auch mir. Du siehst so flauschig aus, ich könnte auf dir ein Nickerchen machen. Ich werde schon beim bloßen Gedanken daran müde.)"

# game/scripts/c25/c25.rpy:3442
translate german c25s005_ZeusAtHome_7f60e2da:

    # mc "Chicas, os tengo que dejar. Voy a seguir enseñándole la casa."
    mc "Mädels, ich muss los. Ich zeige ihr aber noch das Haus."

# game/scripts/c25/c25.rpy:3445
translate german c25s005_ZeusAtHome_b2764ae8:

    # kim "Me encanta poder hacer esto ahora."
    kim "Ich liebe es, das jetzt tun zu können."

# game/scripts/c25/c25.rpy:3446
translate german c25s005_ZeusAtHome_0b02ff88:

    # mc "A mí también, cielo."
    mc "Ich auch, Schatz."

# game/scripts/c25/c25.rpy:3448
translate german c25s005_ZeusAtHome_1456d3b7:

    # kim "Hasta luego, [mc]. ¿Vendrás a la clase de tiro de [eva]?"
    kim "Bis später, [mc]. Wirst du zum Schießkurs von [eva] kommen?"

# game/scripts/c25/c25.rpy:3449
translate german c25s005_ZeusAtHome_ab5ca70d:

    # mc "No, tuve suficiente con la de ayer y tengo algunas cosas que hacer."
    mc "Nein, ich hatte genug von gestern und ich habe noch einiges zu erledigen."

# game/scripts/c25/c25.rpy:3450
translate german c25s005_ZeusAtHome_6e024dc1:

    # kat "Bueno, entonces seremos solo chicas y armas."
    kat "Okay, dann geht es eben nur noch um Mädchen und Waffen."

# game/scripts/c25/c25.rpy:3452
translate german c25s005_ZeusAtHome_c36c1d98:

    # "La siguiente parada es el baño de la planta baja, dónde nada más levantar la tapa del retrete, Zeus se sube a él."
    "Die nächste Station ist das Badezimmer im Erdgeschoss, wo Zeus, sobald der Toilettensitz hochgeklappt wird, darauf klettert."

# game/scripts/c25/c25.rpy:3453
translate german c25s005_ZeusAtHome_89fd84b0:

    # zeu "*¿Miau?* (¿Vas a quedarte ahí mirando?)" id c25s005_ZeusAtHome_89fd84b0
    zeu "*Miau?* (Willst du da einfach nur stehen und starren?)" id c25s005_ZeusAtHome_89fd84b0

# game/scripts/c25/c25.rpy:3454
translate german c25s005_ZeusAtHome_09c64d23:

    # "Por alguna razón te sientes raro mirando cómo el gato hace sus cosas."
    "Aus irgendeinem Grund fühlt es sich komisch an, der Katze bei ihren Aktivitäten zuzusehen."

# game/scripts/c25/c25.rpy:3456
translate german c25s005_ZeusAtHome_a98c077a:

    # "Te giras hasta que acaba, para darle un poco de intimidad. No tienes ni idea de si los gatos necesitan intimidad."
    "Du wendest dich ab, bis es vorbei ist, um der Katze etwas Privatsphäre zu geben. Du hast keine Ahnung, ob Katzen Privatsphäre brauchen."

# game/scripts/c25/c25.rpy:3457
translate german c25s005_ZeusAtHome_758c4ae1:

    # "No sabe tirar de la cadena en este retrete y lo haces tú."
    "Er weiß nicht, wie man die Toilette spült, also machst du es für ihn."

# game/scripts/c25/c25.rpy:3459
translate german c25s005_ZeusAtHome_36109bc7:

    # "Al llegar a la habitación de [dap]..."
    "Nach der Ankunft in [dap]s Zimmer..."

# game/scripts/c25/c25.rpy:3460
translate german c25s005_ZeusAtHome_daabbe21:

    # sca "Mira que gracioso. Ha ido en seguida a ver el cuadro que [mad.nick] hizo de él."
    sca "Wie witzig. Er ging direkt zu dem Gemälde, das [mad.nick] von ihm angefertigt hatte."

# game/scripts/c25/c25.rpy:3461
translate german c25s005_ZeusAtHome_b8eb4aca:

    # zeu "*Miau* (Mia. Te nombro Protectora del Sagrado Retrato del Gato Inteligente.)"
    zeu "*Miau* (Miau. Ich ernenne dich zum Beschützer des heiligen Porträts der intelligenten Katze.)"

# game/scripts/c25/c25.rpy:3462
translate german c25s005_ZeusAtHome_43b6b919:

    # sca "De pequeña quería tener un gato, pero mi madre no me hubiera dejado nunca."
    sca "Als Kind wünschte ich mir eine Katze, aber meine Mutter hätte mir das niemals erlaubt."

# game/scripts/c25/c25.rpy:3463
translate german c25s005_ZeusAtHome_13721b2f:

    # zeu "*¿Miau?* *Miau* (¿Tener? Voy a tener que educarte. Está claro quién es el inteligente aquí.)" id c25s005_ZeusAtHome_13721b2f
    zeu "*Miau?* *Miau* (Haben? Da muss ich dich wohl aufklären. Es ist doch klar, wer hier der Klügere ist.)" id c25s005_ZeusAtHome_13721b2f

# game/scripts/c25/c25.rpy:3466
translate german c25s005_ZeusAtHome_f12d5351:

    # mc "Le podemos preguntar a [nor] si te dejaría tener uno."
    mc "Wir können [nor] fragen, ob er dir einen geben würde."

# game/scripts/c25/c25.rpy:3467
translate german c25s005_ZeusAtHome_386cbb86:

    # sca "No hace falta. Creo que Zeus va a venir mucho por casa."
    sca "Das ist nicht nötig. Ich glaube, Zeus wird viel im Haus sein."

# game/scripts/c25/c25.rpy:3468
translate german c25s005_ZeusAtHome_4ff0b71f:

    # zeu "*Miau* (Depende. De momento sólo me han dado un trozo de salchicha.)"
    zeu "*Miau* (Kommt drauf an. Im Moment haben sie mir nur ein Stück Wurst gegeben.)"

# game/scripts/c25/c25.rpy:3470
translate german c25s005_ZeusAtHome_ee3410c3:

    # "Salta del armario y sube con curiosidad al regazo de [oma]."
    "Sie springt aus dem Schrank und klettert neugierig auf [oma]s Schoß."

# game/scripts/c25/c25.rpy:3471
translate german c25s005_ZeusAtHome_c19e3ac0:

    # zeu "*Miau* (Por alguna razón huelo a algo peludo aquí, pero esta chica está perfectamente depilada. Bueno, ahora es mía.)"
    zeu "*Miau* (Aus irgendeinem Grund rieche ich hier etwas Felliges, aber dieses Mädchen ist völlig haarlos. Nun, sie gehört jetzt mir.)"

# game/scripts/c25/c25.rpy:3472
translate german c25s005_ZeusAtHome_e7bf0abd:

    # oma "Parece que tiene curiosidad por mí. *Risa* Los cachorros son tan monos..."
    oma "Er scheint neugierig auf mich zu sein. *lacht* Welpen sind so süß..."

# game/scripts/c25/c25.rpy:3473
translate german c25s005_ZeusAtHome_c3c3ec4e:

    # mc "*Risa* Creo que le atraen las novedades. Vamos, Zeus. Te tengo que acabar de enseñar la casa."
    mc "*Lacht* Ich glaube, er ist neugierig auf Neues. Komm schon, Zeus. Ich muss dir noch das Haus zeigen."

# game/scripts/c25/c25.rpy:3475
translate german c25s005_ZeusAtHome_d89e55e2:

    # "Cuando os cruzáis con [bet] en la planta superior..."
    "Wenn Sie im Obergeschoss auf [bet] stoßen..."

# game/scripts/c25/c25.rpy:3476
translate german c25s005_ZeusAtHome_09e3044b:

    # zeu "*Bufido* (No me caes bien. Me parece que eres una rival por la comida.)"
    zeu "*Schnaub* (Ich mag dich nicht. Ich glaube, du bist ein Konkurrent um Essen.)"

# game/scripts/c25/c25.rpy:3478
translate german c25s005_ZeusAtHome_0058df62:

    # bet "Parece que no le gusto."
    bet "Anscheinend mag er mich nicht."

# game/scripts/c25/c25.rpy:3479
translate german c25s005_ZeusAtHome_a6206542:

    # mc "Es extraño. Eres la primera con la que reacciona así."
    mc "Das ist seltsam. Du bist die erste Person, auf die er so reagiert hat."

# game/scripts/c25/c25.rpy:3480
translate german c25s005_ZeusAtHome_8082c2f6:

    # mc "A lo mejor ya está cansado de pasear por toda la casa."
    mc "Vielleicht hat er es schon satt, im ganzen Haus herumzuwandern."

# game/scripts/c25/c25.rpy:3482
translate german c25s005_ZeusAtHome_46078c94:

    # bet "Puedo llevármelo a la cocina y darle algo de comer si quieres."
    bet "Wenn Sie möchten, kann ich ihn in die Küche bringen und ihm etwas zu essen geben."

# game/scripts/c25/c25.rpy:3483
translate german c25s005_ZeusAtHome_77fa34b1:

    # mc "*Risa* Creo que eso le va a hacer muy feliz."
    mc "*lacht* Ich glaube, das wird sie sehr freuen."

# game/scripts/c25/c25.rpy:3485
translate german c25s005_ZeusAtHome_fc660de9:

    # zeu "*Miau* (La había juzgado mal. Alguien como ella seguro que sabe dónde está la mejor comida. Ahora es mía.)"
    zeu "*Miau* (Ich habe sie falsch eingeschätzt. Jemand wie sie weiß bestimmt, wo es das beste Futter gibt. Jetzt gehört sie mir.)"

# game/scripts/c25/c25.rpy:3486
translate german c25s005_ZeusAtHome_9a7a48ca:

    # mc "*Risa* Creo que ya es tu amigo."
    mc "*Lacht* Ich glaube, er ist jetzt dein Freund."

# game/scripts/c25/c25.rpy:3487
translate german c25s005_ZeusAtHome_230baf06:

    # bet "*Risa* Sí. Los gatos son tan básicos..."
    bet "*lacht* Ja. Katzen sind so unkompliziert..."

# game/scripts/c25/c25.rpy:3489
translate german c25s005_ZeusAtHome_6115ac07:

    # "Durante la comida, Zeus hace nuevas amigas."
    "Während des Essens knüpft Zeus neue Freundschaften."

# game/scripts/c25/c25.rpy:3491
translate german c25s005_ZeusAtHome_d229ff39:

    # "Todas quieren darle de comer algo."
    "Sie alle wollen ihm etwas zu essen geben."

# game/scripts/c25/c25.rpy:3493
translate german c25s005_ZeusAtHome_fb055bc9:

    # "[mad.nick] da por perdida la batalla por que no se suba a los muebles. El resto de las chicas lo están empezando a malcriar."
    "[mad.nick] betrachtet den Kampf als verloren, weil er sie daran hindert, auf die Möbel zu klettern. Die anderen Mädchen fangen an, sie zu verwöhnen."

# game/scripts/c25/c25.rpy:3494
translate german c25s005_ZeusAtHome_0c3fbf91:

    # "Al menos está lo suficientemente bien educado como para no coger la comida directamente de los platos."
    "Zumindest ist er höflich genug, sich nicht direkt vom Teller zu bedienen."

# game/scripts/c25/c25.rpy:3495
translate german c25s005_ZeusAtHome_773d5a9c:

    # "O es lo suficientemente vago como para esperar a que se la den."
    "Oder er ist faul genug, darauf zu warten, dass es ihm geschenkt wird."

# game/scripts/c25/c25.rpy:3497
translate german c25s005_ZeusAtHome_b419ad78:

    # "Al único que no se acerca es a Jamaal. De todas formas ninguno de los dos iba a compartir su comida con el otro."
    "Nur Jamaal geht er nicht an. Ohnehin hatte keiner von beiden vor, sein Essen mit dem anderen zu teilen."

# game/scripts/c25/c25.rpy:3499
translate german c25s005_ZeusAtHome_e5f1f834:

    # "Supones que, si los gatos tienen un calendario, Zeus estará deseando que lleguen los domingos a partir de ahora."
    "Man könnte meinen, wenn Katzen einen Kalender hätten, würde Zeus sich von nun an auf die Sonntage freuen."

# game/scripts/c25/c25.rpy:3501
translate german c25s005_ZeusAtHome_f3d76e69:

    # "Al acabar de comer..."
    "Nach dem Essen..."

# game/scripts/c25/c25.rpy:3502
translate german c25s005_ZeusAtHome_207aa8fa:

    # mad "Chicas, creo que es el momento de darle nuestro regalo a [mc]. Ha llegado esta mañana."
    mad "Mädels, ich glaube, es ist an der Zeit, [mc] unser Geschenk zu überreichen. Es ist heute Morgen angekommen."

# game/scripts/c25/c25.rpy:3503
translate german c25s005_ZeusAtHome_34bc92a6:

    # mc "¿Un regalo? ¿Para mí?"
    mc "Ein Geschenk? Für mich?"

# game/scripts/c25/c25.rpy:3505
translate german c25s005_ZeusAtHome_cbca8d35:

    # mad "Es una tontería que les propuse a algunas de las chicas el viernes y les pareció una buena idea."
    mad "Es ist eine alberne Idee, die ich am Freitag einigen Mädchen vorgeschlagen habe, und sie fanden sie gut."

# game/scripts/c25/c25.rpy:3506
translate german c25s005_ZeusAtHome_fd0be7c6:

    # mad "La he mandado a imprimir y me la han entregado poco antes de que llegaras a mi apartamento."
    mad "Ich habe es ausdrucken lassen und es wurde mir kurz vor Ihrer Ankunft in meiner Wohnung zugestellt."

# game/scripts/c25/c25.rpy:3507
translate german c25s005_ZeusAtHome_d41497fe:

    # mc "Pero no es mi cumpleaños ni nada por el estilo..."
    mc "Aber es ist ja nicht mein Geburtstag oder so etwas..."

# game/scripts/c25/c25.rpy:3509
translate german c25s005_ZeusAtHome_d5efef94:

    # nor "Pero te lo mereces más ahora que si lo fuese."
    nor "Aber du verdienst es jetzt mehr als sonst."

# game/scripts/c25/c25.rpy:3510
translate german c25s005_ZeusAtHome_aa82bc75:

    # bet "Estoy de acuerdo con [nor]. Ha sido una gran idea por parte de [mad.nick]."
    bet "Ich stimme [nor] zu. Das war eine großartige Idee von [mad.nick]."

# game/scripts/c25/c25.rpy:3511
translate german c25s005_ZeusAtHome_e9575096:

    # mc "Dame ese paquete, [mad.nick]." id c25s005_ZeusAtHome_e9575096
    mc "Gib mir das Paket, [mad.nick]." id c25s005_ZeusAtHome_e9575096

# game/scripts/c25/c25.rpy:3513
translate german c25s005_ZeusAtHome_87a29028:

    # mc "¡Oh! ¿Una camiseta?"
    mc "Oh! Ein T-Shirt?"

# game/scripts/c25/c25.rpy:3514
translate german c25s005_ZeusAtHome_02f708a9:

    # mc "*Risa* ¿A quién se le ha ocurrido la frase?"
    mc "*Gelächter* Wer hat sich diesen Ausdruck ausgedacht?"

# game/scripts/c25/c25.rpy:3515
translate german c25s005_ZeusAtHome_fce971d3:

    # eri "Fue cosa de [mad.nick]. Nos pareció muy graciosa."
    eri "Das war [mad.nick]s Werk. Wir fanden es urkomisch."

# game/scripts/c25/c25.rpy:3516
translate german c25s005_ZeusAtHome_3091e53e:

    # dap "Póntela. Queremos ver cómo te queda."
    dap "Zieh es an. Wir wollen sehen, wie es an dir aussieht."

# game/scripts/c25/c25.rpy:3518
translate german c25s005_ZeusAtHome_21b666b0:

    # mc "*Risa* ¡Me encanta!"
    mc "*lacht* Ich liebe es!"

# game/scripts/c25/c25.rpy:3519
translate german c25s005_ZeusAtHome_7e8ba433:

    # mc "'Desafié a la Iglesia y lo único que conseguí fue esta camiseta y un finiquito para mi tía.'"
    mc "„Ich habe mich gegen die Kirche aufgelehnt und alles, was ich dafür bekam, war dieses T-Shirt und eine Abfindung für meine Tante.“"

# game/scripts/c25/c25.rpy:3520
translate german c25s005_ZeusAtHome_3b3c29dd:

    # mc "Bien hecho, [mad.nick]. Y gracias a todas."
    mc "Gut gemacht, [mad.nick]. Und vielen Dank an alle."

# game/scripts/c25/c25.rpy:3522
translate german c25s005_ZeusAtHome_b551a62a:

    # todas "*Risa* No hay de qué."
    todas "*Lacht* Gern geschehen."

# game/scripts/c25/c25.rpy:3523
translate german c25s005_ZeusAtHome_9e8be2bd:

    # lis "[mad.nick] es una artista con buenas ideas."
    lis "[mad.nick] ist ein Künstler mit guten Ideen."

# game/scripts/c25/c25.rpy:3524
translate german c25s005_ZeusAtHome_8a5e80eb:

    # mad "Chicas... me vais a hacer ruborizar."
    mad "Mädels... ihr bringt mich noch zum Erröten."

# game/scripts/c25/c25.rpy:3526
translate german c25s005_ZeusAtHome_396433db:

    # "Después de unas cuantas risas y de que todos consigáis que [mad.nick] se ruborice, vas a tu habitación."
    "Nach ein paar Lachern und nachdem es euch allen gelungen ist, [mad.nick] zum Erröten zu bringen, geht ihr in euer Zimmer."

# game/scripts/c25/c25.rpy:3527
translate german c25s005_ZeusAtHome_7336d122:

    # "Zeus vuelve a ser el centro de atención después de la pequeña interrupción por la camiseta."
    "Zeus steht nach der kurzen Unterbrechung durch das T-Shirt wieder im Rampenlicht."

# game/scripts/c25/c25.rpy:3529
translate german c25s005_ZeusAtHome_83af6113:

    # "Ir a comprar los pepinillos no te ha dejado acabar lo que estabas haciendo con la contabilidad del Dormitorio."
    "Der Einkauf der Essiggurken hat dich daran gehindert, deine Arbeit an den Schlafzimmer-Accounts zu beenden."

# game/scripts/c25/c25.rpy:3531
translate german c25s005_ZeusAtHome_ed8271c6:

    # "Ir a comprar el pollo no te ha dejado acabar lo que estabas haciendo con la contabilidad del Dormitorio."
    "Der Einkauf des Huhns hat dich daran gehindert, das zu beenden, womit du dich gerade beschäftigt hast, nämlich mit den Schlafzimmerkonten."

# game/scripts/c25/c25.rpy:3533
translate german c25s005_ZeusAtHome_a42c4d50:

    # "[nor] te dice que el helado no está listo todavía. Prepararlo con la leche de [mee] ha sido más lento de lo esperado."
    "[nor] teilt Ihnen mit, dass das Eis noch nicht fertig ist. Die Zubereitung mit der Milch aus [mee] hat länger gedauert als erwartet."

# game/scripts/c25/c25.rpy:3548
translate german c25s006_AmaCuddle_aeca0d27:

    # "Al cabo de un rato..."
    "Nach einer Weile..."

# game/scripts/c25/c25.rpy:3550
translate german c25s006_AmaCuddle_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c25/c25.rpy:3552
translate german c25s006_AmaCuddle_46915100:

    # ama "*A través de la puerta* Soy yo, ¿puedo pasar?"
    ama "*Durch die Tür* Ich bin's, darf ich hereinkommen?"

# game/scripts/c25/c25.rpy:3553
translate german c25s006_AmaCuddle_4d601f0e:

    # mc "Sí, pasa."
    mc "Ja, das kommt vor."

# game/scripts/c25/c25.rpy:3555
translate german c25s006_AmaCuddle_d9f612d1:

    # mc "¿Te has cansado ya del gato?"
    mc "Sind Sie der Katze schon überdrüssig?"

# game/scripts/c25/c25.rpy:3556
translate german c25s006_AmaCuddle_730c3bf8:

    # ama "*Risa* No, pero están todas ocupadas con él, con lo que sabía que estarías solo."
    ama "*Lacht* Nein, aber alle sind mit ihm beschäftigt, deshalb wusste ich, dass du allein sein würdest."

# game/scripts/c25/c25.rpy:3557
translate german c25s006_AmaCuddle_98dd9003:

    # mc "¿Quieres hablar de algo?"
    mc "Möchtest du über etwas reden?"

# game/scripts/c25/c25.rpy:3560
translate german c25s006_AmaCuddle_8e4413bb:

    # ama "Bueno, quería besarte. *Risita*"
    ama "Ich wollte dich küssen. *Kichern*"

# game/scripts/c25/c25.rpy:3561
translate german c25s006_AmaCuddle_fb98d4e8:

    # mc "Me parece una buena forma de empezar."
    mc "Ich denke, das ist ein guter Anfang."

# game/scripts/c25/c25.rpy:3563
translate german c25s006_AmaCuddle_4c1488fc:

    # ama "Y quería darte las gracias por lo que hiciste ayer en el barco."
    ama "Und ich wollte Ihnen für Ihren Einsatz gestern auf dem Boot danken."

# game/scripts/c25/c25.rpy:3566
translate german c25s006_AmaCuddle_611a8c6e:

    # ama "Quería darte las gracias por lo que hiciste ayer en el barco."
    ama "Ich wollte Ihnen für Ihren Einsatz gestern auf dem Boot danken."

# game/scripts/c25/c25.rpy:3567
translate german c25s006_AmaCuddle_f6d18e4d:

    # mc "Es lo menos que podía hacer. Me pasé la mitad del tiempo que estuve allí queriendo darle un puñetazo en la cara a Ichigo."
    mc "Das war das Mindeste, was ich tun konnte. Die Hälfte der Zeit, die ich dort war, wollte ich Ichigo am liebsten ins Gesicht schlagen."

# game/scripts/c25/c25.rpy:3569
translate german c25s006_AmaCuddle_f437c1d3:

    # ama "Siempre tienes que sacar el caballero de brillante armadura, ¿no?"
    ama "Man muss ja immer den Ritter in glänzender Rüstung hervorholen, nicht wahr?"

# game/scripts/c25/c25.rpy:3571
translate german c25s006_AmaCuddle_b64f279c:

    # mc "Anoche lo retuve bastante. Lo que me extraña es que Alejandra nos apoyara."
    mc "Ich habe ihn gestern Abend ziemlich zurückgehalten. Was mich überrascht, ist, dass Alejandra uns unterstützt hat."

# game/scripts/c25/c25.rpy:3573
translate german c25s006_AmaCuddle_91ba4451:

    # mc "Anoche lo retuve bastante. Fuiste tú quien intervino con lo de [kim] cuando yo me quedé paralizado. Lo que me extraña es que Alejandra nos apoyara."
    mc "Ich habe mich gestern Abend ziemlich zurückgehalten. Du warst es, der mit der [kim]-Sache eingegriffen hat, als ich wie gelähmt war. Was mich überrascht, ist, dass Alejandra uns unterstützt hat."

# game/scripts/c25/c25.rpy:3575
translate german c25s006_AmaCuddle_0c8268ed:

    # ama "Alejandra estaba allí por negocios. Por suficiente dinero, o en su caso cuando no hay otra opción, se puede aceptar cualquier insulto."
    ama "Alejandra war geschäftlich dort. Für genug Geld, oder in ihrem Fall, wenn es keine andere Möglichkeit gibt, ist jede Beleidigung in Kauf zu nehmen."

# game/scripts/c25/c25.rpy:3577
translate german c25s006_AmaCuddle_dde97603:

    # ama "Y fue tu discurso junto con el apoyo de Alejandra lo que me permitió sacar a [kim] de allí."
    ama "Und es war Ihre Rede zusammen mit Alejandras Unterstützung, die es mir ermöglichte, [kim] von dort wegzubringen."

# game/scripts/c25/c25.rpy:3578
translate german c25s006_AmaCuddle_a54cb1f4:

    # ama "De todas formas, que no reaccionaras tan rápido como yo, no significa que no lo fueras a hacer. O eso quiero pensar."
    ama "Nun ja, nur weil du nicht so schnell reagiert hast wie ich, heißt das nicht, dass du es nicht getan hättest. Zumindest möchte ich das glauben."

# game/scripts/c25/c25.rpy:3579
translate german c25s006_AmaCuddle_a70383bf:

    # mc "¿Dónde vas? ¿Se ha acabado el abrazo?"
    mc "Wohin gehst du? Ist die Umarmung vorbei?"

# game/scripts/c25/c25.rpy:3581
translate german c25s006_AmaCuddle_e75ae730:

    # ama "No, pero quiero quitarme las botas para continuarlo en la cama, si no te importa."
    ama "Nein, aber ich möchte meine Stiefel ausziehen, damit wir im Bett weitermachen können, wenn es dir nichts ausmacht."

# game/scripts/c25/c25.rpy:3582
translate german c25s006_AmaCuddle_f26db8d2:

    # mc "*Risa* No me importa."
    mc "*Lacht* Ist mir egal."

# game/scripts/c25/c25.rpy:3584
translate german c25s006_AmaCuddle_dc888c21:

    # mc "¿Sólo las botas?"
    mc "Nur die Stiefel?"

# game/scripts/c25/c25.rpy:3586
translate german c25s006_AmaCuddle_2018f5e4:

    # ama "*Risa* Sí, sólo las botas. No estás pensando que tengo segundas intenciones, ¿verdad? Tan solo quiero un abrazo muy largo."
    ama "*Lacht* Ja, nur die Stiefel. Du denkst doch nicht etwa, ich hätte Hintergedanken, oder? Ich will einfach nur eine ganz lange Umarmung."

# game/scripts/c25/c25.rpy:3588
translate german c25s006_AmaCuddle_c8c9b586:

    # ama "Y si cae algún beso no voy a decir que no, pero ya está."
    ama "Und wenn es zu einem Kuss kommt, werde ich nicht nein sagen, aber das war's dann auch schon."

# game/scripts/c25/c25.rpy:3589
translate german c25s006_AmaCuddle_d8b96890:

    # mc "Abrazos y besos me sirve."
    mc "Umarmungen und Küsse helfen."

# game/scripts/c25/c25.rpy:3591
translate german c25s006_AmaCuddle_76bee679:

    # ama "¿Vienes?"
    ama "Kommst du?"

# game/scripts/c25/c25.rpy:3592
translate german c25s006_AmaCuddle_617dfb78:

    # mc "Déjame quitarme las zapatillas."
    mc "Ich ziehe meine Schuhe aus."

# game/scripts/c25/c25.rpy:3594
translate german c25s006_AmaCuddle_2a766e47:

    # ama "Se está bien aquí."
    ama "Es ist schön hier."

# game/scripts/c25/c25.rpy:3595
translate german c25s006_AmaCuddle_faafae77:

    # mc "¿Pasa algo, [ama]? Hoy estás más dulce de lo normal. No es que tenga ninguna queja, pero..."
    mc "Ist etwas nicht in Ordnung, [ama]? Du bist heute besonders liebenswürdig. Nicht, dass ich etwas zu beanstanden hätte, aber..."

# game/scripts/c25/c25.rpy:3597
translate german c25s006_AmaCuddle_69801c5e:

    # mc "¿Tiene algo que ver que ayer tuviera la cita-entrenamiento con [eva]?"
    mc "Hat das etwas damit zu tun, dass ich gestern die Trainingseinheit mit [eva] hatte?"

# game/scripts/c25/c25.rpy:3599
translate german c25s006_AmaCuddle_ba8a0e6b:

    # ama "No, me he alegrado mucho por ella. Por vosotros dos. Cuando llegué a la base, estaba exultante."
    ama "Nein, ich habe mich sehr für sie gefreut. Für euch beide. Als ich auf dem Stützpunkt ankam, war ich überglücklich."

# game/scripts/c25/c25.rpy:3600
translate german c25s006_AmaCuddle_254f81c9:

    # ama "*Risa* Y si tuvieras alguna queja porque hoy estoy más dulce, te ibas a tener que aguantar."
    ama "*Lacht* Und falls du irgendwelche Beschwerden hättest, weil ich heute etwas süßer drauf bin, müsstest du das einfach hinnehmen."

# game/scripts/c25/c25.rpy:3603
translate german c25s006_AmaCuddle_76520bf3:

    # ama "*Risa* Si tuvieras alguna queja porque hoy estoy más dulce, te ibas a tener que aguantar."
    ama "*Lacht* Falls du irgendwelche Beschwerden hättest, weil ich heute etwas süßer drauf bin, müsstest du das einfach hinnehmen."

# game/scripts/c25/c25.rpy:3605
translate german c25s006_AmaCuddle_0562a6f7:

    # ama "Tan solo quiero pasar un rato a solas con mi novio, sin hacer nada. No hemos tenido mucho tiempo desde... aquel beso. Siempre estamos hablando de trabajo."
    ama "Ich möchte einfach mal Zeit mit meinem Freund allein verbringen und nichts tun. Seit dem Kuss hatten wir kaum Zeit dafür. Wir reden immer nur über die Arbeit."

# game/scripts/c25/c25.rpy:3607
translate german c25s006_AmaCuddle_2275ad91:

    # ama "Tan solo quiero pasar un rato a solas con mi hermano, sin hacer nada. No hemos tenido muchas oportunidades de pasar tiempo juntos si no era por trabajo."
    ama "Ich möchte einfach mal etwas Zeit mit meinem Bruder verbringen, ganz ohne etwas zu tun. Wir hatten in letzter Zeit nicht viele Gelegenheiten, Zeit miteinander zu verbringen, außer beruflich."

# game/scripts/c25/c25.rpy:3608
translate german c25s006_AmaCuddle_7f377dcb:

    # mc "Un día tenemos que ir tú y yo a comer, o a cenar. Nada en plan cita. Sólo tú y yo pasando un rato juntos."
    mc "Wir sollten mal zusammen Mittag- oder Abendessen gehen, nur du und ich. Nichts geht über ein Date. Einfach Zeit zu zweit verbringen."

# game/scripts/c25/c25.rpy:3610
translate german c25s006_AmaCuddle_b19eddd6:

    # mc "Tenemos que tener tú y yo también una cita algún día."
    mc "Wir müssen uns mal verabreden, du und ich."

# game/scripts/c25/c25.rpy:3612
translate german c25s006_AmaCuddle_33be946b:

    # ama "Estaría bien, pero vas a estar muy ocupado antes de que vayamos a Aruba. Una vez allí te llevaré a mi restaurante favorito."
    ama "Das wäre schön, aber du wirst vor unserer Reise nach Aruba noch sehr beschäftigt sein. Sobald wir dort sind, nehme ich dich mit in mein Lieblingsrestaurant."

# game/scripts/c25/c25.rpy:3613
translate german c25s006_AmaCuddle_019feb62:

    # mc "¿Vendrás tú conmigo? ¿[eva] se quedará aquí protegiendo a la familia?"
    mc "Kommst du mit mir? Wird [eva] hier bleiben und die Familie beschützen?"

# game/scripts/c25/c25.rpy:3615
translate german c25s006_AmaCuddle_615741e7:

    # ama "Aún no está preparada para ver a Gavin. Aún está muy afectada por lo que pasó, con que perdiera el brazo. Estaré yo contigo el primer mes."
    ama "Sie ist noch nicht bereit, Gavin zu sehen. Sie ist immer noch sehr mitgenommen von dem, was passiert ist, vom Verlust ihres Arms. Ich werde den ersten Monat bei dir sein."

# game/scripts/c25/c25.rpy:3616
translate german c25s006_AmaCuddle_a02ed068:

    # ama "Después iremos rotando, un mes cada una allí mientras la otra está aquí."
    ama "Dann wechseln wir uns ab, einer von uns ist einen Monat dort, während der andere hier ist."

# game/scripts/c25/c25.rpy:3617
translate german c25s006_AmaCuddle_36a0b53c:

    # mc "Me parece una buena idea. ¿Estará preparada dentro de un mes?"
    mc "Das klingt nach einer guten Idee. Wird es in einem Monat fertig sein?"

# game/scripts/c25/c25.rpy:3620
translate german c25s006_AmaCuddle_4fc1e6b9:

    # ama "Eso espero. No tengo ganas de estar lejos de las chicas más de ese tiempo."
    ama "Ich hoffe es. Ich möchte nicht länger als so lange von den Mädchen getrennt sein."

# game/scripts/c25/c25.rpy:3622
translate german c25s006_AmaCuddle_f4f04ed7:

    # ama "Eso espero. Se va a tener que enfrentar a ese tema tarde o temprano."
    ama "Ich hoffe es. Er wird sich diesem Problem früher oder später stellen müssen."

# game/scripts/c25/c25.rpy:3624
translate german c25s006_AmaCuddle_642c555e:

    # ama "Y, después de lo de ayer, dudo que ella quiera estar lejos de ti más de un mes."
    ama "Und nach dem, was gestern passiert ist, bezweifle ich, dass sie länger als einen Monat von dir getrennt sein möchte."

# game/scripts/c25/c25.rpy:3625
translate german c25s006_AmaCuddle_855b4530:

    # mc "¿Cómo te sientes tú por tener que volver a Aruba?"
    mc "Wie fühlen Sie sich bei dem Gedanken, nach Aruba zurückkehren zu müssen?"

# game/scripts/c25/c25.rpy:3627
translate german c25s006_AmaCuddle_3d1a5af3:

    # ama "Tengo sentimientos conflictivos. Quiero enseñarte dónde crecimos, pero hay sitios que me traerán recuerdos tristes."
    ama "Ich habe gemischte Gefühle. Ich möchte dir zeigen, wo wir aufgewachsen sind, aber es gibt Orte, die traurige Erinnerungen wecken werden."

# game/scripts/c25/c25.rpy:3628
translate german c25s006_AmaCuddle_d56b9c53:

    # mc "Lo entiendo."
    mc "Ich verstehe."

# game/scripts/c25/c25.rpy:3630
translate german c25s006_AmaCuddle_973951c8:

    # ama "Y descubrirás una parte... monstruosa de mí."
    ama "Und du wirst einen monströsen Teil von mir entdecken."

# game/scripts/c25/c25.rpy:3631
translate german c25s006_AmaCuddle_85c68686:

    # mc "No creo que haya ninguna parte monstruosa en ti, [ama]. Te obligaron a hacer cosas monstruosas, pero no eres un monstruo."
    mc "Ich glaube nicht, dass irgendetwas Monströses an dir ist, [ama]. Du wurdest zwar gezwungen, monströse Dinge zu tun, aber du bist kein Monster."

# game/scripts/c25/c25.rpy:3633
translate german c25s006_AmaCuddle_e5fd6cf2:

    # ama "No me refiero a eso. Te enseñaré mi posesión más preciada, y a lo mejor entonces piensas que estoy mal de la cabeza."
    ama "So meine ich das nicht. Ich zeige dir meinen wertvollsten Besitz, und dann wirst du mich wahrscheinlich für verrückt halten."

# game/scripts/c25/c25.rpy:3634
translate german c25s006_AmaCuddle_f5b226b8:

    # mc "¿Qué es?"
    mc "Was ist das?"

# game/scripts/c25/c25.rpy:3636
translate german c25s006_AmaCuddle_f3609450:

    # ama "No sé si decírtelo... no me corresponde sólo a mí."
    ama "Ich weiß nicht, ob ich es dir sagen soll... es liegt nicht nur an mir."

# game/scripts/c25/c25.rpy:3637
translate german c25s006_AmaCuddle_811f780f:

    # mc "No te preocupes. Ya llegará el momento de hacerlo."
    mc "Keine Sorge. Die Zeit wird kommen."

# game/scripts/c25/c25.rpy:3638
translate german c25s006_AmaCuddle_321ec4e6:

    # ama "Gracias..."
    ama "Danke schön..."

# game/scripts/c25/c25.rpy:3639
translate german c25s006_AmaCuddle_30e9b407:

    # mc "Como supongo que tiene que ver con [eva], ¿le has dicho que me lo enseñarás cuando estemos allí?"
    mc "Da ich annehme, dass es etwas mit [eva] zu tun hat, hast du ihm gesagt, dass du es mir zeigen würdest, wenn wir dort sind?"

# game/scripts/c25/c25.rpy:3641
translate german c25s006_AmaCuddle_a860af8f:

    # ama "No, aún no... Me da un poco de miedo decírselo."
    ama "Nein, noch nicht... Ich habe ein bisschen Angst, es ihm zu sagen."

# game/scripts/c25/c25.rpy:3642
translate german c25s006_AmaCuddle_f777227d:

    # mc "No le des más vueltas. Si es una cosa vuestra, obviamente me gustaría saberlo, pero habrá tiempo, siempre y cuando [eva] acepte contármelo."
    mc "Mach dir nicht so viele Gedanken. Wenn es etwas zwischen euch beiden ist, würde ich es natürlich gerne wissen, aber dafür ist noch Zeit, solange [eva] einverstanden ist, es mir zu sagen."

# game/scripts/c25/c25.rpy:3643
translate german c25s006_AmaCuddle_87cc63f9:

    # ama "Gracias. Para nosotras es muy especial. Para otras personas sería algo... macabro."
    ama "Vielen Dank. Es bedeutet uns sehr viel. Für andere mag es... makaber sein."

# game/scripts/c25/c25.rpy:3645
translate german c25s006_AmaCuddle_bb3f24f8:

    # mc "Hablando de cosas especiales. ¿Qué tiene de especial el collar de [eva]?"
    mc "Wo wir gerade von besonderen Dingen sprechen: Was ist denn so besonders an der Halskette von [eva]?"

# game/scripts/c25/c25.rpy:3647
translate german c25s006_AmaCuddle_ad683714:

    # mc "Le he visto ese corazón puesto cada vez que ha hecho algo... nuevo, por decirlo de alguna forma."
    mc "Ich habe sein Engagement jedes Mal gespürt, wenn er etwas Neues, sozusagen, unternommen hat."

# game/scripts/c25/c25.rpy:3648
translate german c25s006_AmaCuddle_003e478f:

    # mc "La primera visita con la familia, lo de ayer, y alguna vez más."
    mc "Der erste Besuch bei der Familie, der gestrige Besuch und ein anderes Mal."

# game/scripts/c25/c25.rpy:3650
translate german c25s006_AmaCuddle_31f6a996:

    # ama "No te lo puedo decir, [mc]. Se lo deberías preguntar a ella..."
    ama "Das kann ich dir nicht sagen, [mc]. Du solltest sie fragen..."

# game/scripts/c25/c25.rpy:3651
translate german c25s006_AmaCuddle_c34ef301:

    # mc "No te preocupes. Espero que no sea nada... ¿cómo has dicho? Ah, sí. Macabro."
    mc "Keine Sorge. Hoffentlich ist es nichts Schlimmes... was hast du gesagt? Ach ja. Gruselig."

# game/scripts/c25/c25.rpy:3655
translate german c25s006_AmaCuddle_2c8733c9:

    # mc "Cambiando de tema. ¿Hay alguien a quien quieras evitar en Aruba?"
    mc "Um auf ein anderes Thema zurückzukommen: Gibt es jemanden, den Sie in Aruba lieber meiden würden?"

# game/scripts/c25/c25.rpy:3657
translate german c25s006_AmaCuddle_947dcd6f:

    # ama "Especialmente a Daniels. Por su culpa murieron tres de mis hermanas y Arnau, el hermano de Aaron."
    ama "Insbesondere Daniels. Seinetwegen sind drei meiner Schwestern und Arnau, Aarons Bruder, gestorben."

# game/scripts/c25/c25.rpy:3658
translate german c25s006_AmaCuddle_9c96c333:

    # mc "Lo entiendo. No tienes por qué verlo. Aaron y yo nos podemos ocupar de hacer lo que sea necesario."
    mc "Ich verstehe. Du musst es dir nicht ansehen. Aaron und ich kümmern uns um alles Notwendige."

# game/scripts/c25/c25.rpy:3661
translate german c25s006_AmaCuddle_58cc0162:

    # ama "Gracias. ¿Por qué no te callas y me dejas disfrutar de este abrazo en paz? No quiero pensar en trabajo."
    ama "Danke. Könntest du bitte still sein und mich diese Umarmung in Ruhe genießen lassen? Ich möchte nicht an die Arbeit denken."

# game/scripts/c25/c25.rpy:3664
translate german c25s006_AmaCuddle_b9c8e4f9:

    # ama "Gracias. Sois muy parecidos y no me vais a dejar hacer nada que me haga daño."
    ama "Danke. Du bist mir sehr ähnlich und du würdest mich nichts tun lassen, was mir schaden könnte."

# game/scripts/c25/c25.rpy:3665
translate german c25s006_AmaCuddle_f05d1af5:

    # mc "En eso consiste protegerte, ¿no? Me encanta que, alguna vez, podamos ser otros los que te protegemos a ti."
    mc "Darum geht es doch beim Schutz der anderen, nicht wahr? Ich finde es toll, dass wir manchmal diejenigen sein können, die sie beschützen."

# game/scripts/c25/c25.rpy:3667
translate german c25s006_AmaCuddle_4c9ecae2:

    # ama "*Risa* El caballero de brillante armadura ha vuelto."
    ama "*Gelächter* Der Ritter in glänzender Rüstung ist zurückgekehrt."

# game/scripts/c25/c25.rpy:3668
translate german c25s006_AmaCuddle_d9a20a23:

    # mc "*Risa* Ni siquiera me había dado cuenta."
    mc "*Lacht* Das war mir gar nicht aufgefallen."

# game/scripts/c25/c25.rpy:3669
translate german c25s006_AmaCuddle_67a4ac62:

    # mc "Pero no querías que habláramos de trabajo..."
    mc "Aber du wolltest ja nicht, dass wir über die Arbeit reden..."

# game/scripts/c25/c25.rpy:3671
translate german c25s006_AmaCuddle_31c71ae0:

    # ama "No, quería disfrutar de un abrazo en silencio. *Risa* Pero eso contigo es imposible."
    ama "Nein, ich wollte eine stille Umarmung genießen. *lacht* Aber das ist bei dir unmöglich."

# game/scripts/c25/c25.rpy:3672
translate german c25s006_AmaCuddle_cb0ba765:

    # mc "*Risa* ¿Hablo demasiado?"
    mc "*lacht* Rede ich zu viel?"

# game/scripts/c25/c25.rpy:3673
translate german c25s006_AmaCuddle_0e7ec165:

    # ama "*Risa* La mayoría del tiempo."
    ama "*Lacht* Meistens."

# game/scripts/c25/c25.rpy:3674
translate german c25s006_AmaCuddle_dc2bd698:

    # mc "*Risa* Déjame hacerte una última pregunta y me callaré."
    mc "*lacht* Erlauben Sie mir noch eine letzte Frage, dann halte ich den Mund."

# game/scripts/c25/c25.rpy:3676
translate german c25s006_AmaCuddle_a30458cd:

    # ama "*Risa* Me das miedo. Haz esa pregunta."
    ama "*lacht* Du machst mir Angst. Stell diese Frage."

# game/scripts/c25/c25.rpy:3677
translate german c25s006_AmaCuddle_3e88635e:

    # mc "Dices que tengo que esperar a llegar a Aruba para una cita contigo. ¿Por qué no podemos ir a cenar mañana, por ejemplo?"
    mc "Du sagst, ich müsse warten, bis ich in Aruba bin, um mit dir auszugehen. Warum können wir zum Beispiel nicht morgen zusammen essen gehen?"

# game/scripts/c25/c25.rpy:3679
translate german c25s006_AmaCuddle_aa536e84:

    # ama "Porque no soy como [sai]."
    ama "Weil ich nicht wie [sai] bin."

# game/scripts/c25/c25.rpy:3680
translate german c25s006_AmaCuddle_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "Worüber redest du?"

# game/scripts/c25/c25.rpy:3681
translate german c25s006_AmaCuddle_ef86d131:

    # ama "Sabes que [sai] estuvo planificando vuestra primera vez juntos desde vuestra primera cita, ¿no?"
    ama "Du weißt doch, dass [sai] euer erstes gemeinsames Mal seit eurem ersten Date plant, oder?"

# game/scripts/c25/c25.rpy:3682
translate german c25s006_AmaCuddle_af008da4:

    # mc "Sí, lo ha comentado varias veces. Siempre me pareció gracioso que se pasara una semana planeándolo para que fuera perfecto."
    mc "Ja, er hat es schon mehrmals erwähnt. Ich fand es immer amüsant, dass er eine Woche lang geplant hat, um sicherzustellen, dass alles perfekt wird."

# game/scripts/c25/c25.rpy:3683
translate german c25s006_AmaCuddle_6ce0b2fd:

    # mc "¿Quieres decir que no quieres planearlo?"
    mc "Meinst du, du willst es nicht planen?"

# game/scripts/c25/c25.rpy:3685
translate german c25s006_AmaCuddle_d5dec225:

    # ama "Quiero decir que no quiero pensar en ello. A diferencia de [sai], no considero el sexo importante."
    ama "Ich meine, ich will gar nicht darüber nachdenken. Anders als [sai] halte ich Sex nicht für wichtig."

# game/scripts/c25/c25.rpy:3686
translate german c25s006_AmaCuddle_56833dc0:

    # ama "Sé que para ti sí que lo es, pero yo me podría pasar los próximos meses haciendo solo esto, abrazándonos."
    ama "Ich weiß, es ist für dich, aber ich könnte die nächsten Monate nichts anderes tun, als uns gegenseitig zu umarmen."

# game/scripts/c25/c25.rpy:3688
translate german c25s006_AmaCuddle_f2aba790:

    # ama "Y esto."
    ama "Und das."

# game/scripts/c25/c25.rpy:3690
translate german c25s006_AmaCuddle_dd444808:

    # ama "Estar así, abrazados, es suficiente para mí ahora mismo."
    ama "So wie es jetzt ist, mit Umarmungen, genügt mir im Moment."

# game/scripts/c25/c25.rpy:3691
translate german c25s006_AmaCuddle_2ef475ba:

    # mc "¿Y qué tiene eso que ver con que salgamos a cenar?"
    mc "Und was hat das damit zu tun, dass wir zum Abendessen ausgehen?"

# game/scripts/c25/c25.rpy:3693
translate german c25s006_AmaCuddle_820a937f:

    # ama "*Risa* Si planificamos una salida a cenar, los dos sabemos qué pasará después."
    ama "*Lacht* Wenn wir ein Abendessen planen, wissen wir beide, was danach passieren wird."

# game/scripts/c25/c25.rpy:3694
translate german c25s006_AmaCuddle_f4dac36c:

    # mc "Sólo pasará lo que tú quieras que pase, [ama]."
    mc "Nur das, was du willst, wird geschehen, [ama]."

# game/scripts/c25/c25.rpy:3696
translate german c25s006_AmaCuddle_456bd3ac:

    # ama "La diferencia es que, entonces, querré que pase."
    ama "Der Unterschied besteht darin, dass ich es dann wollen werde."

# game/scripts/c25/c25.rpy:3697
translate german c25s006_AmaCuddle_52027a02:

    # ama "Mientras nos veamos un ratito aquí, un ratito allá, sin planificar nada... no hay expectativas. Ni tiempo para que pase nada."
    ama "Solange wir uns ab und zu kurz sehen, ohne etwas zu planen … gibt es keine Erwartungen. Und auch keine Zeit, dass irgendetwas passiert."

# game/scripts/c25/c25.rpy:3698
translate german c25s006_AmaCuddle_9fb1ee18:

    # mc "Pero es que no es necesario que pase nada. Abrazarte me encanta."
    mc "Aber es muss nichts passieren. Ich umarme dich so gern."

# game/scripts/c25/c25.rpy:3700
translate german c25s006_AmaCuddle_7caf1c9a:

    # ama "Pero tarde o temprano querrás sexo. No me malinterpretes. Lo entiendo."
    ama "Aber früher oder später wirst du Sex wollen. Versteh mich nicht falsch. Ich verstehe das."

# game/scripts/c25/c25.rpy:3701
translate german c25s006_AmaCuddle_6dc40a64:

    # ama "Pero quiero que mi... nuestra primera vez sea especial. Estar preparada."
    ama "Aber ich möchte, dass unser erstes Mal etwas Besonderes wird. Dass wir vorbereitet sind."

# game/scripts/c25/c25.rpy:3702
translate german c25s006_AmaCuddle_e1eb3a86:

