    # ama "*En la radio* Ya sabes que [emm] no es tu hermana, [mc]."
    ama "*Im Radio* Du weißt, dass [emm] nicht deine Schwester ist, [mc]."

# game/scripts/c16/c16.rpy:2214
translate german c16s003_ShootingLessons_a8e4d38f:

    # mc "No es para [emm]. Y me gusta saber cosas que vosotras ignoráis por una vez. *Risa*"
    mc "Das ist nichts für [emm]. Und ich freue mich, ausnahmsweise mal Dinge zu wissen, die ihr alle nicht wisst. *lacht*"

# game/scripts/c16/c16.rpy:2216
translate german c16s003_ShootingLessons_b66e6c38:

    # eva "No se lo tengas en cuenta, Am. Hoy está haciéndose el difícil."
    eva "Nimm's ihm nicht übel, Am. Er gibt sich heute nur etwas rar."

# game/scripts/c16/c16.rpy:2217
translate german c16s003_ShootingLessons_b05b9b31:

    # ama "*En la radio* Déjame mirar en el ordenador un momento, [mc]."
    ama "*Über Funk* Ich schaue kurz auf dem Computer nach, [mc]."

# game/scripts/c16/c16.rpy:2218
translate german c16s003_ShootingLessons_a20cefa7:

    # "..."
    "..."

# game/scripts/c16/c16.rpy:2219
translate german c16s003_ShootingLessons_243601e6:

    # ama "*En la radio* Sí, NTR fabrica tests de ADN, pero son bastante similares a los del mercado. Nada tan revolucionario como los tests de embarazo."
    ama "*Im Radio* Ja, NTR stellt DNA-Tests her, aber die sind den handelsüblichen Tests ziemlich ähnlich. Nichts so Revolutionäres wie Schwangerschaftstests."

# game/scripts/c16/c16.rpy:2220
translate german c16s003_ShootingLessons_46b96be8:

    # ama "*En la radio* Estoy viendo que los de mercado son muy rápidos de por sí. Si quieres, puedo comprar uno y llevártelo esta noche."
    ama "*Im Radio* Ich höre, dass die auf dem Markt sehr schnell weg sind. Wenn du willst, kann ich eins kaufen und es dir heute Abend bringen."

# game/scripts/c16/c16.rpy:2221
translate german c16s003_ShootingLessons_230a7573:

    # ama "*En la radio* Hay un laboratorio en Atascadero. El martes podrías tener el resultado."
    ama "*Im Radio* Es gibt ein Labor in Atascadero. Die Ergebnisse könnten Sie am Dienstag erhalten."

# game/scripts/c16/c16.rpy:2222
translate german c16s003_ShootingLessons_268b789b:

    # mc "Gracias, Amanda. Me iría muy bien algo así. No sabía ni por dónde empezar con esto."
    mc "Danke, Amanda. So etwas wäre wirklich hilfreich. Ich wusste gar nicht, wo ich anfangen sollte."

# game/scripts/c16/c16.rpy:2223
translate german c16s003_ShootingLessons_30688660:

    # ama "*En la radio* Ningún problema. Luego te lo llevo."
    ama "*Über Funk* Kein Problem. Ich bringe es Ihnen später."

# game/scripts/c16/c16.rpy:2226
translate german c16s003_ShootingLessons_0b079e9e:

    # eva "Un momento, [mc]. Amanda quiere saludarte."
    eva "Einen Moment bitte, [mc]. Amanda möchte hallo sagen."

# game/scripts/c16/c16.rpy:2227
translate german c16s003_ShootingLessons_05b026d9:

    # ama "*En la radio* Tan solo quería darte las gracias de nuevo por lo de ayer. Y por darnos la oportunidad de comer con vosotros hoy."
    ama "*Im Radio* Ich wollte mich noch einmal für gestern bedanken. Und dafür, dass Sie uns heute die Gelegenheit zum gemeinsamen Mittagessen gegeben haben."

# game/scripts/c16/c16.rpy:2228
translate german c16s003_ShootingLessons_8aee4596:

    # ama "*En la radio* Eva no te lo va a agradecer, pero va también de su parte."
    ama "*Im Radio* Eva wird sich nicht bedanken, aber es kommt auch von ihr."

# game/scripts/c16/c16.rpy:2230
translate german c16s003_ShootingLessons_0243511a:

    # eva "¡Amanda!"
    eva "Amanda!"

# game/scripts/c16/c16.rpy:2231
translate german c16s003_ShootingLessons_54090982:

    # mc "*Risa* Gracias, pero no hace falta. Fue cosa de [mar] y [nor]. No tuve nada que ver."
    mc "*Lacht* Danke, aber das ist nicht nötig. Das war das Werk von [mar] und [nor]. Ich hatte damit nichts zu tun."

# game/scripts/c16/c16.rpy:2233
translate german c16s003_ShootingLessons_3457f2fc:

    # eva "¿Me lo puedo llevar ya? ¡No me va a dar tiempo de enseñarle nada!"
    eva "Kann ich ihn jetzt mitnehmen? Ich werde keine Zeit mehr haben, ihm etwas beizubringen!"

# game/scripts/c16/c16.rpy:2234
translate german c16s003_ShootingLessons_24631180:

    # ama "*En la radio* *Risa* Sí, llévatelo. Y piensa que, si no acabáis hoy, habrá más lecciones..."
    ama "*Im Radio* *Gelächter* Ja, nimm es. Und denk dran: Wenn du heute nicht fertig wirst, gibt es noch weitere Lektionen..."

# game/scripts/c16/c16.rpy:2236
translate german c16s003_ShootingLessons_2ec21748:

    # eva "¿Y...?"
    eva "UND...?"

# game/scripts/c16/c16.rpy:2238
translate german c16s003_ShootingLessons_faee8d18:

    # ama "*En la radio* Que ya sabes como acaban las lecciones con [mc]. *Risa*"
    ama "*Im Radio* Ihr wisst ja, wie die Unterrichtsstunden mit [mc] enden. *Gelächter*"

# game/scripts/c16/c16.rpy:2240
translate german c16s003_ShootingLessons_ab7ad892:

    # ama "*En la radio* *Risa* Más oportunidades para conoceros durante las lecciones..."
    ama "*Im Radio* *Gelächter* Mehr Gelegenheiten, Sie während des Unterrichts kennenzulernen..."

# game/scripts/c16/c16.rpy:2241
translate german c16s003_ShootingLessons_b026f744:

    # mc "Amanda, ¿eres consciente de que aún no le he devuelto el auricular a Eva?"
    mc "Amanda, ist dir bewusst, dass ich das Headset noch immer nicht an Eva zurückgegeben habe?"

# game/scripts/c16/c16.rpy:2242
translate german c16s003_ShootingLessons_8c1b8908:

    # ama "*En la radio* ¡Oh, mierda! Devuélveselo ya... Hasta la cena, [mc]."
    ama "*Im Radio* Oh, Mist! Gib's sofort zurück... Wir sehen uns beim Abendessen, [mc]."

# game/scripts/c16/c16.rpy:2243
translate german c16s003_ShootingLessons_79582e9b:

    # mc "Hasta la cena, Amanda."
    mc "Wir sehen uns beim Abendessen, Amanda."

# game/scripts/c16/c16.rpy:2245
translate german c16s003_ShootingLessons_1363b7d9:

    # eva "Amanda estaba bromeando..."
    eva "Amanda hat nur gescherzt..."

# game/scripts/c16/c16.rpy:2246
translate german c16s003_ShootingLessons_10febebe:

    # mc "Sí, ya me lo imagino. Como tú el día que te disfrazaste de [eri]..."
    mc "Ja, das kann ich mir vorstellen. So wie du an dem Tag, als du dich als [eri] verkleidet hast..."

# game/scripts/c16/c16.rpy:2248
translate german c16s003_ShootingLessons_adc67db5:

    # eva "Sobre eso..."
    eva "Darüber..."

# game/scripts/c16/c16.rpy:2249
translate german c16s003_ShootingLessons_3def96d5:

    # mc "¿Por qué no hablamos sobre eso cuando bajemos? Se nos va a hacer tarde para aprender a disparar."
    mc "Warum reden wir nicht darüber, wenn wir dort unten sind? Sonst lernen wir zu spät, wie man schießt."

# game/scripts/c16/c16.rpy:2250
translate german c16s003_ShootingLessons_27820783:

    # mc "Aunque no me importará si tenemos que hacer varias lecciones. Y no {b}solo{/b} por lo que ha dicho Amanda."
    mc "Ich hätte nichts dagegen, wenn wir mehrere Unterrichtsstunden nehmen müssten. Und das nicht nur wegen dem, was Amanda gesagt hat."

# game/scripts/c16/c16.rpy:2252
translate german c16s003_ShootingLessons_87ff4708:

    # eva "¡Me parece genial! ¡Vamos! Ya estamos llegando."
    eva "Das klingt super! Los geht's! Wir sind fast da."

# game/scripts/c16/c16.rpy:2253
translate german c16s003_ShootingLessons_c9b98326:

    # mc "Las damas primero."
    mc "Damen zuerst."

# game/scripts/c16/c16.rpy:2255
translate german c16s003_ShootingLessons_540f7bd2:

    # "Llegáis al \"campo de tiro\" y Eva te lo muestra orgullosa."
    "Du kommst am \"Schießstand\" an und Eva zeigt ihn dir voller Stolz."

# game/scripts/c16/c16.rpy:2256
translate german c16s003_ShootingLessons_71da2111:

    # eva "He traído unas latas y unos botes. No me gustan las botellas, si llegas a darles no son reutilizables. Además, algún animal se podría cortar con los cristales."
    eva "Ich habe Dosen und Gläser mitgebracht. Flaschen mag ich nicht; wenn man sie Tieren gibt, sind sie nicht wiederverwendbar. Außerdem könnten sich manche Tiere am Glas schneiden."

# game/scripts/c16/c16.rpy:2257
translate german c16s003_ShootingLessons_1e566a4d:

    # mc "Me gusta descubrir esa faceta de ti, Eva. No me imaginaba que te preocuparan los animales del bosque."
    mc "Ich freue mich, diese Seite an dir zu entdecken, Eva. Ich hätte nie gedacht, dass du dich für Waldtiere interessierst."

# game/scripts/c16/c16.rpy:2259
translate german c16s003_ShootingLessons_ba2328f7:

    # eva "¿Preocupada por los animales? ¿Yo?"
    eva "Besorgt um Tiere? Ich?"

# game/scripts/c16/c16.rpy:2260
translate german c16s003_ShootingLessons_a795668c:

    # eva "Es que... si algún animal se hiriese en una pata... mmmm.... dejaría un rastro de sangre... sí, exactamente eso..."
    eva "Nun ja... wenn sich ein Tier am Bein verletzen würde... mmm... würde es eine Blutspur hinterlassen... ja, genau das..."

# game/scripts/c16/c16.rpy:2261
translate german c16s003_ShootingLessons_69dbaf90:

    # eva "Y podría ponérmelo más difícil si alguna vez... no sé... tengo que seguir la pista a uno de mis objetivos a los que haya herido... Sí. Es por eso."
    eva "Und es könnte die Sache für mich noch schwieriger machen, falls ich jemals... ich weiß nicht... eines meiner Ziele, die ich verletzt habe, aufspüren muss... Ja. Genau deshalb."

# game/scripts/c16/c16.rpy:2263
translate german c16s003_ShootingLessons_51dbdf0d:

    # eva "*Mascullando* Como que uno de mis objetivos iba a poder andar si le disparo..."
    eva "*Gemurmelt* Als ob eines meiner Ziele noch laufen könnte, wenn ich es erschieße..."

# game/scripts/c16/c16.rpy:2264
translate german c16s003_ShootingLessons_5afb7f67:

    # mc "Vale. Fingiré que te creo. *Risa*"
    mc "Okay. Ich werde so tun, als ob ich dir glaube. *lacht*"

# game/scripts/c16/c16.rpy:2265
translate german c16s003_ShootingLessons_709983fe:

    # mc "¿Empezamos a disparar?"
    mc "Sollen wir mit den Dreharbeiten beginnen?"

# game/scripts/c16/c16.rpy:2267
translate german c16s003_ShootingLessons_78a959a1:

    # eva "¡No! Primero la clase teórica. Tienes que aprenderte las cinco leyes de las armas de fuego."
    eva "Nein! Zuerst der Theorieunterricht. Sie müssen die fünf Waffengesetze lernen."

# game/scripts/c16/c16.rpy:2268
translate german c16s003_ShootingLessons_0afa9162:

    # mc "¿Una clase sobre leyes?"
    mc "Ein Kurs über Recht?"

# game/scripts/c16/c16.rpy:2270
translate german c16s003_ShootingLessons_d1c5adfa:

    # eva "No, idiota. *Risa* Es sobre cómo usar un arma y lo que nunca debes hacer con ella."
    eva "Nein, Idiot. *lacht* Es geht darum, wie man eine Waffe benutzt und was man niemals damit tun sollte."

# game/scripts/c16/c16.rpy:2271
translate german c16s003_ShootingLessons_e0ce829f:

    # mc "Ah, vale. ¿Tipo \"nunca mires por el cañón de un arma\" y cosas así?"
    mc "Ah, okay. Sowas wie „Schau niemals in den Lauf einer Pistole“ und so weiter?"

# game/scripts/c16/c16.rpy:2272
translate german c16s003_ShootingLessons_7ad5a606:

    # eva "Esa es solo para idiotas. Para ti van a ser las cinco leyes básicas. *Risa* Bueno seis."
    eva "Das ist doch nur was für Idioten. Für dich gelten die fünf Grundgesetze. *Lacht* Na ja, sechs."

# game/scripts/c16/c16.rpy:2273
translate german c16s003_ShootingLessons_42ce3c2b:

    # mc "Adelante. Soy todo oídos."
    mc "Nur zu. Ich bin ganz Ohr."

# game/scripts/c16/c16.rpy:2275
translate german c16s003_ShootingLessons_a9dc3613:

    # eva "Uno. Nunca apuntes tu arma a algo a lo que no tengas intención de dispararle."
    eva "Erstens: Richten Sie Ihre Waffe niemals auf etwas, das Sie nicht beschießen wollen."

# game/scripts/c16/c16.rpy:2276
translate german c16s003_ShootingLessons_30aa421a:

    # mc "O lo que es lo mismo, no juegues con ella."
    mc "Oder mit anderen Worten: Leg dich nicht mit ihr an."

# game/scripts/c16/c16.rpy:2277
translate german c16s003_ShootingLessons_02b71c6e:

    # eva "Exacto. Te sorprendería la cantidad de civiles que os matáis en accidentes idiotas."
    eva "Genau. Sie wären überrascht, wie viele Zivilisten man durch dumme Unfälle tötet."

# game/scripts/c16/c16.rpy:2278
translate german c16s003_ShootingLessons_d3381c5a:

    # eva "Dos. No acerques tu dedo al gatillo hasta que estés listo para disparar."
    eva "Zweitens. Legen Sie Ihren Finger erst dann in die Nähe des Abzugs, wenn Sie bereit sind zu schießen."

# game/scripts/c16/c16.rpy:2279
translate german c16s003_ShootingLessons_0c9a95d1:

    # mc "Una buena forma de evitar accidentes."
    mc "Eine gute Möglichkeit, Unfälle zu vermeiden."

# game/scripts/c16/c16.rpy:2281
translate german c16s003_ShootingLessons_1ffae699:

    # eva "Las leyes para ti acaban de convertirse en siete."
    eva "Die Anzahl der Gesetze für Sie beträgt nun sieben."

# game/scripts/c16/c16.rpy:2283
translate german c16s003_ShootingLessons_1e5248f2:

    # eva "Tres. Sé consciente de tu objetivo y de lo que hay más allá."
    eva "Drittens. Sei dir deines Ziels und dessen, was dahinter liegt, bewusst."

# game/scripts/c16/c16.rpy:2284
translate german c16s003_ShootingLessons_a7be44d7:

    # mc "No te entiendo."
    mc "Ich verstehe Sie nicht."

# game/scripts/c16/c16.rpy:2286
translate german c16s003_ShootingLessons_dcc952f3:

    # eva "Una bala va en línea recta. Realmente no, pero para el ejemplo piensa que sí. Tienes que saber dónde está tu objetivo, pero también que pasa más allá de él."
    eva "Eine Kugel fliegt geradlinig. Nicht ganz, aber für dieses Beispiel nehmen wir es einmal an. Man muss wissen, wo sich das Ziel befindet, aber auch, was dahinter liegt."

# game/scripts/c16/c16.rpy:2287
translate german c16s003_ShootingLessons_f3af7099:

    # eva "No quieres que, si fallas o la bala atraviesa el objetivo, haya una niña pequeña detrás a la que puedas matar, ¿verdad? O a [dap]. O a mí."
    eva "Du willst doch nicht, dass ein kleines Mädchen hinter dir steht, das du womöglich tötest, wenn du verfehlst oder die Kugel direkt durch das Ziel geht, oder? Oder [dap]. Oder mich."

# game/scripts/c16/c16.rpy:2288
translate german c16s003_ShootingLessons_e9602af6:

    # mc "Tienes razón, no se me habría ocurrido nunca. Sigue, por favor."
    mc "Sie haben Recht, darauf wäre ich nie gekommen. Bitte fahren Sie fort."

# game/scripts/c16/c16.rpy:2290
translate german c16s003_ShootingLessons_34b79ed1:

    # eva "Cuatro. Nunca bebas alcohol o consumas drogas antes de disparar o mientras lo haces."
    eva "Viertens. Vor und während des Schießens niemals Alkohol trinken oder Drogen konsumieren."

# game/scripts/c16/c16.rpy:2291
translate german c16s003_ShootingLessons_6bec7215:

    # mc "Esa tiene lógica."
    mc "Das macht Sinn."

# game/scripts/c16/c16.rpy:2292
translate german c16s003_ShootingLessons_31216bdc:

    # eva "Cinco. Manipula cualquier arma como si estuviera cargada."
    eva "Fünftens. Behandeln Sie jede Waffe so, als wäre sie geladen."

# game/scripts/c16/c16.rpy:2293
translate german c16s003_ShootingLessons_02112f7a:

    # mc "También es lógica."
    mc "Es ist auch logisch."

# game/scripts/c16/c16.rpy:2295
translate german c16s003_ShootingLessons_bdf9310d:

    # eva "Ahora llegan las específicas para ti."
    eva "Jetzt treffen Ihre speziell für Sie bestimmten Exemplare ein."

# game/scripts/c16/c16.rpy:2296
translate german c16s003_ShootingLessons_a250f8e2:

    # mc "¿Algo sobre cómo disparar desde la terraza o algo así?"
    mc "Irgendwas mit Schießen von der Terrasse oder so was in der Art?"

# game/scripts/c16/c16.rpy:2297
translate german c16s003_ShootingLessons_f362f41f:

    # eva "Seis: Siempre sé puntual cuando quedes con alguien. Especialmente si lo has pedido tú."
    eva "Sechstens: Sei immer pünktlich, wenn du dich mit jemandem triffst. Vor allem, wenn du selbst darum gebeten hast."

# game/scripts/c16/c16.rpy:2298
translate german c16s003_ShootingLessons_a1e21fce:

    # eva "Y más especialmente todavía cuando ese alguien esté armado."
    eva "Und das gilt umso mehr, wenn diese Person bewaffnet ist."

# game/scripts/c16/c16.rpy:2299
translate german c16s003_ShootingLessons_e4c61d0d:

    # mc "Eva, lo siento..."
    mc "Eva, es tut mir leid..."

# game/scripts/c16/c16.rpy:2301
translate german c16s003_ShootingLessons_ebc8279d:

    # eva "¡Hush!"
    eva "Stille!"

# game/scripts/c16/c16.rpy:2302
translate german c16s003_ShootingLessons_d0074ed3:

    # eva "Siete: Cuando te esté instruyendo puedes hacer preguntas, pero te puedes ahorrar los comentarios obvios."
    eva "Sieben: Wenn er Sie anweist, können Sie Fragen stellen, sollten aber offensichtliche Kommentare vermeiden."

# game/scripts/c16/c16.rpy:2304
translate german c16s003_ShootingLessons_093731fb:

    # eva "Ini bini firmi di ivitir iccidintis..."
    eva "Ich bin keine Firma für Ivitir Iccidintis..."

# game/scripts/c16/c16.rpy:2306
translate german c16s003_ShootingLessons_0cab2a59:

    # eva "Eso sobra. Claro que es por eso. Por eso te estoy enseñando. Pero no puedes estar callado un segundo."
    eva "Das ist unnötig. Natürlich ist das der Grund. Deshalb bringe ich es dir ja bei. Aber du kannst jetzt nicht eine Sekunde schweigen."

# game/scripts/c16/c16.rpy:2307
translate german c16s003_ShootingLessons_2529e0cb:

    # mc "Lo siento, Eva. No quería interrumpirte. Tan solo quería saber la lógica detrás de cada ley."
    mc "Tut mir leid, Eva. Ich wollte dich nicht unterbrechen. Ich wollte nur die Logik hinter jedem einzelnen Gesetz verstehen."

# game/scripts/c16/c16.rpy:2309
translate german c16s003_ShootingLessons_267d8b68:

    # eva "Vale. Si tienes dudas, pregunta. No hagas comentarios."
    eva "Okay. Bei Fragen einfach fragen. Keine Kommentare bitte."

# game/scripts/c16/c16.rpy:2310
translate german c16s003_ShootingLessons_55120abd:

    # mc "¡A sus órdenes! *Risa*"
    mc "Zu Ihren Diensten! *Gelächter*"

# game/scripts/c16/c16.rpy:2312
translate german c16s003_ShootingLessons_0fee774d:

    # eva "*Risa* ¡Y déjate de payasadas! No soy tu superior en rango."
    eva "*Lacht* Und hör auf mit dem Herumalbern! Ich bin nicht dein Vorgesetzter."

# game/scripts/c16/c16.rpy:2313
translate german c16s003_ShootingLessons_68a61123:

    # eva "Vamos a por las armas. Hoy dispararás con pistola y con balas de práctica. Tienen menos potencia y no expulsa el casquillo automáticamente."
    eva "Kommen wir nun zu den Waffen. Heute schießt ihr mit einer Pistole und Übungsmunition. Diese hat weniger Durchschlagskraft und wirft die Hülse nicht automatisch aus."

# game/scripts/c16/c16.rpy:2314
translate german c16s003_ShootingLessons_0e592995:

    # eva "Depende de como te vaya, el próximo día puede que te permita disparar con balas de verdad."
    eva "Je nachdem, wie es läuft, lasse ich dich beim nächsten Mal vielleicht mit echten Kugeln schießen."

# game/scripts/c16/c16.rpy:2315
translate german c16s003_ShootingLessons_57d4b6c8:

    # mc "¡Vamos!"
    mc "Aufleuchten!"

# game/scripts/c16/c16.rpy:2317
translate german c16s003_ShootingLessons_9334e9d2:

    # eva "Esto es una pistola y..."
    eva "Das ist eine Pistole und..."

# game/scripts/c16/c16.rpy:2318
translate german c16s003_ShootingLessons_36c91770:

    # "Eva empieza a darte explicaciones sobre como cogerla, el seguro, la introducción del cargador, y un montón de cosas más."
    "Eva erklärt Ihnen dann, wie man es hält, wie die Sicherheitsvorkehrungen sind, wie man das Ladegerät einsteckt und vieles mehr."

# game/scripts/c16/c16.rpy:2319
translate german c16s003_ShootingLessons_d81891fb:

    # "Siempre con la recámara vacía y el cargador extraído. Eva pone mucho énfasis en la seguridad y te va repitiendo las leyes hasta que puedes recitarlas de memoria."
    "Immer mit leerer Kammer und entferntem Magazin. Eva legt großen Wert auf Sicherheit und wiederholt die Regeln so lange, bis man sie auswendig kann."

# game/scripts/c16/c16.rpy:2321
translate german c16s003_ShootingLessons_8f989143:

    # eva "Vale, eso es lo más básico. Otro día te enseñaré a desmontar y limpiar tu arma. Vamos a lo divertido. Casi estás listo para tu primer disparo."
    eva "Okay, das waren die Grundlagen. Ein anderes Mal zeige ich euch, wie man die Waffe zerlegt und reinigt. Jetzt zum spannenden Teil: Ihr seid fast bereit für euren ersten Schuss."

# game/scripts/c16/c16.rpy:2322
translate german c16s003_ShootingLessons_c95a51fc:

    # mc "Eso, desde luego, suena más divertido que la teoría."
    mc "Das klingt auf jeden Fall spannender als die Theorie."

# game/scripts/c16/c16.rpy:2323
translate german c16s003_ShootingLessons_49b1896a:

    # eva "Ponte en posición para disparar. Coge el arma con las dos manos y apunta a una lata. Dedo fuera del gatillo."
    eva "Nehmen Sie Schussposition ein. Halten Sie die Waffe mit beiden Händen und zielen Sie auf eine Dose. Finger vom Abzug."

# game/scripts/c16/c16.rpy:2325
translate german c16s003_ShootingLessons_1e9e90ba:

    # "Te pones en tu mejor imitación de las poses que usan los actores en las películas."
    "Du imitierst so gut wie möglich die Posen, die Schauspieler in Filmen einnehmen."

# game/scripts/c16/c16.rpy:2326
translate german c16s003_ShootingLessons_6d27e1bc:

    # "Pies separados y las rodillas un poco flexionadas. Lo has visto tantas veces en las películas que casi parece una postura natural."
    "Füße auseinander, Knie leicht gebeugt. Man hat es schon so oft in Filmen gesehen, dass es fast wie eine natürliche Haltung wirkt."

# game/scripts/c16/c16.rpy:2328
translate german c16s003_ShootingLessons_1d1a89a9:

    # eva "Casi bien. Para un civil. Énfasis en casi. En esa postura no le darás ni a un elefante. No es que el elefante tenga la culpa, claro."
    eva "Fast. Für einen Zivilisten. Betonung auf fast. In dieser Position würde man nicht mal einen Elefanten anfahren. Nicht, dass der Elefant etwas dafür könnte, natürlich."

# game/scripts/c16/c16.rpy:2329
translate german c16s003_ShootingLessons_c22a84a4:

    # mc "¿Qué estoy haciendo mal?"
    mc "Was mache ich falsch?"

# game/scripts/c16/c16.rpy:2331
translate german c16s003_ShootingLessons_7fa6dd90:

    # eva "Esto. Los pies."
    eva "Das. Die Füße."

# game/scripts/c16/c16.rpy:2332
translate german c16s003_ShootingLessons_091cbf26:

    # "Eva da un golpe seco en el cañón del arma descargada que te desequilibra."
    "Eva versetzt dem Lauf der ungeladenen Pistole einen heftigen Schlag, der dich aus dem Gleichgewicht bringt."

# game/scripts/c16/c16.rpy:2334
translate german c16s003_ShootingLessons_2fbb26e9:

    # eva "Tal como tienes los pies, paralelos al arma y entre sí, el retroceso hará que pierdas el equilibrio."
    eva "Wenn Ihre Füße parallel zur Waffe und zueinander stehen, wird der Rückstoß Sie aus dem Gleichgewicht bringen."

# game/scripts/c16/c16.rpy:2335
translate german c16s003_ShootingLessons_6c79fc2e:

    # eva "Solo ha sido un pequeño empujón, menor que el que te dará la munición de práctica. El arma te dará una pequeña coz cuando uses munición de verdad."
    eva "Es war nur ein leichter Stoß, geringer als der von Übungsmunition. Mit scharfer Munition gibt die Waffe einen spürbaren Rückstoß."

# game/scripts/c16/c16.rpy:2336
translate german c16s003_ShootingLessons_7b63615a:

    # eva "Y esta es solo una 9mm. Si disparas con una .45 será peor. Te caerías de culo encima de esa roca."
    eva "Und das ist nur eine 9-mm-Pistole. Mit einer .45er wäre es noch schlimmer. Da würdest du glatt auf den Rücken fallen."

# game/scripts/c16/c16.rpy:2337
translate german c16s003_ShootingLessons_6eba0262:

    # eva "Vuelve a ponerte en la misma posición."
    eva "Kehren Sie zur Ausgangsposition zurück."

# game/scripts/c16/c16.rpy:2339
translate german c16s003_ShootingLessons_8e36ee80:

    # eva "¿Ves? Este pie lo tienes bien. Apuntando al objetivo."
    eva "Siehst du? Dieser Fuß ist rechts. Er zeigt auf das Ziel."

# game/scripts/c16/c16.rpy:2341
translate german c16s003_ShootingLessons_4c718521:

    # eva "Este muévelo un poco hacia atrás y gíralo. 45 o 60° respecto al otro, lo que te sea más cómodo."
    eva "Schieben Sie dieses Teil etwas zurück und drehen Sie es. Um 45 oder 60° relativ zum anderen, je nachdem, was für Sie bequemer ist."

# game/scripts/c16/c16.rpy:2343
translate german c16s003_ShootingLessons_4d0846ed:

    # eva "Así mucho mejor. Ahora que sabes la teoría busca una posición cómoda para ti."
    eva "Das ist viel besser. Jetzt, wo du die Theorie kennst, such dir eine bequeme Position."

# game/scripts/c16/c16.rpy:2345
translate german c16s003_ShootingLessons_16ecc6ac:

    # eva "¿Ves? Mucho más firme y equilibrado."
    eva "Sehen Sie? Viel fester und ausgewogener."

# game/scripts/c16/c16.rpy:2346
translate german c16s003_ShootingLessons_d73d1ed7:

    # mc "Sí, tienes razón. Pero he visto en muchas películas que se ponen así."
    mc "Ja, da hast du recht. Aber ich habe sie schon in vielen Filmen so handeln sehen."

# game/scripts/c16/c16.rpy:2348
translate german c16s003_ShootingLessons_7ecf0af1:

    # eva "Nunca te fíes de lo que ves en las películas. Y menos aún en lo referido a las armas."
    eva "Traue niemals dem, was du in Filmen siehst. Und das gilt umso mehr, wenn es um Waffen geht."

# game/scripts/c16/c16.rpy:2349
translate german c16s003_ShootingLessons_fe2d5191:

    # eva "Yo crecí pensando que todo el mundo tenía armas y vivía en casas enormes en Estados Unidos. Y que las calles estarían llenas de Brad Pits y Charlize Terons."
    eva "Ich bin mit dem Glauben aufgewachsen, dass in Amerika jeder Waffen besitzt und in riesigen Häusern wohnt. Und dass die Straßen voller Brad Pitt und Charlize Theron wären."

# game/scripts/c16/c16.rpy:2350
translate german c16s003_ShootingLessons_a02d352a:

    # mc "Y la realidad te debió decepcionar un poco. Por cierto, Charlize es sudafricana."
    mc "Und die Realität hat dich wohl etwas enttäuscht. Übrigens, Charlize ist Südafrikanerin."

# game/scripts/c16/c16.rpy:2352
translate german c16s003_ShootingLessons_a3ad98b6:

    # eva "Lo sé, pero no lo sabía entonces. Hasta que no estudiamos acentos y dialectos no lo supe."
    eva "Ich weiß, aber damals wusste ich es noch nicht. Ich wusste es erst, als wir Akzente und Dialekte behandelten."

# game/scripts/c16/c16.rpy:2353
translate german c16s003_ShootingLessons_0fc8bc3f:

    # mc "¿Acentos y dialectos?"
    mc "Akzente und Dialekte?"

# game/scripts/c16/c16.rpy:2355
translate german c16s003_ShootingLessons_ef782ed4:

    # eva "Soy capaz de hablar 17 idiomas, y usar localismos en varios de ellos. Mientras tu jugabas a la Play, nuestros juegos eran hablar en Árabe, con acento de Libia o de Yemen."
    eva "Ich spreche 17 Sprachen und verwende in einigen davon lokale Ausdrücke. Während du PlayStation gespielt hast, haben wir in unseren Spielen Arabisch gesprochen, mit libyschem oder jemenitischem Akzent."

# game/scripts/c16/c16.rpy:2356
translate german c16s003_ShootingLessons_ec601d26:

    # mc "Tiene que haber sido difícil."
    mc "Das muss schwierig gewesen sein."

# game/scripts/c16/c16.rpy:2358
translate german c16s003_ShootingLessons_574806c6:

    # eva "No lo era. No conocíamos nada más, para nosotras era normal. Lo echábamos de menos tanto como echas tú de menos ser Spiderman."
    eva "Nein, das war es nicht. Wir kannten es nicht anders; für uns war es normal. Wir haben es genauso vermisst, wie man es vermisst, Spiderman zu sein."

# game/scripts/c16/c16.rpy:2359
translate german c16s003_ShootingLessons_870ff905:

    # eva "Lo que veíamos en la TV no existía. Era ciencia ficción para nosotras. Las niñas no disparaban y no morían en la TV."
    eva "Was wir im Fernsehen sahen, existierte nicht. Für uns war das Science-Fiction. Kleine Mädchen schossen nicht mit Waffen und starben nicht im Fernsehen."

# game/scripts/c16/c16.rpy:2361
translate german c16s003_ShootingLessons_b146110d:

    # eva "Pero dejemos de hablar de nosotras. Carga el arma y mete una bala en la recámara."
    eva "Aber hören wir auf, über uns zu reden. Lade die Waffe und führe eine Kugel ins Patronenlager ein."

# game/scripts/c16/c16.rpy:2362
translate german c16s003_ShootingLessons_984f4a1a:

    # eva "Dedo lejos del gatillo. Sin apuntar en mi dirección o en la de tus pies."
    eva "Finger weg vom Abzug. Nicht in meine Richtung oder auf deine Füße zeigen."

# game/scripts/c16/c16.rpy:2363
translate german c16s003_ShootingLessons_8f911973:

    # mc "¡A sus órdenes!"
    mc "Zu Ihren Diensten!"

# game/scripts/c16/c16.rpy:2365
translate german c16s003_ShootingLessons_b9e3210a:

    # eva "Ahora apunta con una mano y dispara a la lata que menos te guste."
    eva "Nun ziele mit einer Hand und schieße auf die Dose, die dir am wenigsten gefällt."

# game/scripts/c16/c16.rpy:2366
translate german c16s003_ShootingLessons_b1a93e78:

    # eva "Recuerda. Vas a disparar con munición de práctica. No expulsa el casquillo y no recarga automáticamente. Tienes que amartillarla manualmente."
    eva "Denk daran: Du verschießt Übungsmunition. Die Hülse wird nicht ausgeworfen und die Waffe lädt nicht automatisch nach. Du musst sie manuell spannen."

# game/scripts/c16/c16.rpy:2367
translate german c16s003_ShootingLessons_a645c1e2:

    # mc "Será mejor que te apartes, ¿no?"
    mc "Du solltest besser Platz machen, nicht wahr?"

# game/scripts/c16/c16.rpy:2368
translate german c16s003_ShootingLessons_4d2f0adf:

    # eva "No te preocupes. No me puedes dar aquí. Mi instructor se pondría detrás tuyo, con su arma apuntando a tu cabeza, pero yo prefiero estar aquí. Dispara tres veces."
    eva "Keine Sorge. Hier können Sie mich nicht treffen. Mein Ausbilder würde hinter Ihnen stehen und Ihnen die Pistole an den Kopf halten, aber ich bleibe lieber hier. Dreimal feuern."

# game/scripts/c16/c16.rpy:2371
translate german c16s003_ShootingLessons_ee71ee81:

    # "*Bang*"
    "*Knall*"

# game/scripts/c16/c16.rpy:2372
translate german c16s003_ShootingLessons_25a15966:

    # "No tienes ni idea de dónde va el primer disparo. La pequeña coz de la que ha hablado Eva es más fuerte de lo que esperabas y el retroceso ha hecho que el cañón se levante."
    "Du hast keine Ahnung, wo der erste Schuss einschlägt. Der kleine Rückstoß, von dem Eva sprach, ist stärker als erwartet, und der Rückstoß hat den Lauf angehoben."

# game/scripts/c16/c16.rpy:2373
translate german c16s003_ShootingLessons_697265d2:

    # eva "Ningún pato muerto de momento. Las latas están mucho más abajo. *Risa* Otra vez."
    eva "Noch keine toten Enten. Die Dosen hängen viel tiefer. *Lacht* Schon wieder."

# game/scripts/c16/c16.rpy:2374
translate german c16s003_ShootingLessons_d9fcd1cc:

    # eva "Por cierto, pareces salido del Doomfenstein cogiendo la pistola así. *Risa*"
    eva "Übrigens, mit der Waffe in der Hand siehst du aus, als wärst du direkt aus Doomfenstein entsprungen. *lacht*"

# game/scripts/c16/c16.rpy:2376
translate german c16s003_ShootingLessons_a37b6d3e:

    # mcp "(No me importaría disparar a Eric en un videojuego.)"
    mcp "(Ich hätte nichts dagegen, Eric in einem Videospiel zu erschießen.)"

# game/scripts/c16/c16.rpy:2379
translate german c16s003_ShootingLessons_ee71ee81_1:

    # "*Bang*"
    "*Knall*"

# game/scripts/c16/c16.rpy:2380
translate german c16s003_ShootingLessons_c819ef3f:

    # "Esta vez el retroceso no te sorprende y eres capaz de controlarlo. Esta vez sí que ves donde impacta la bala. En el árbol que hay detras del bote al que apuntabas."
    "Diesmal überrascht dich der Rückstoß nicht, und du kannst ihn kontrollieren. Diesmal siehst du tatsächlich, wo die Kugel einschlägt: im Baum hinter dem Boot, auf das du gezielt hattest."

# game/scripts/c16/c16.rpy:2381
translate german c16s003_ShootingLessons_2da7ca91:

    # eva "Nos vamos acercando. Si el bote devolviera el fuego, ya estarías muerto. Porque estás apuntando al bote, ¿verdad? *Risa* Al menos no has matado ninguna ardilla."
    eva "Wir kommen näher. Wenn das Boot zurückschießen würde, wärst du tot. Du zielst ja schließlich auf das Boot, oder? *lacht* Wenigstens hast du noch keine Eichhörnchen erwischt."

# game/scripts/c16/c16.rpy:2384
translate german c16s003_ShootingLessons_ee71ee81_2:

    # "*Bang*"
    "*Knall*"

# game/scripts/c16/c16.rpy:2385
translate german c16s003_ShootingLessons_50a5cf56:

    # "Intentas compensar más todavía el retroceso. Esta vez levantas un poco de polvo delante de la lata. Lo has compensado en exceso, pero la dirección era buena."
    "Du versuchst, den Rückstoß noch stärker auszugleichen. Diesmal wirbelst du etwas Staub vor der Dose auf. Du hast überkompensiert, aber die Lenkung war gut."

# game/scripts/c16/c16.rpy:2386
translate german c16s003_ShootingLessons_95d2920f:

    # eva "¡Ese ha sido casi bueno! Hay un topo teniendo un ataque de ansiedad ahora mismo. *Risa* Pero ha sido el mejor disparo."
    eva "Das war fast perfekt! Da hat wohl einer von uns gerade einen Panikanfall. *lacht* Aber es war der beste Schuss."

# game/scripts/c16/c16.rpy:2388
translate german c16s003_ShootingLessons_886f2a3d:

    # eva "Saca la bala de la recámara, ponle el seguro, saca el cargador, y dame el arma."
    eva "Entnehmen Sie die Patrone aus dem Patronenlager, sichern Sie die Waffe, nehmen Sie das Magazin heraus und geben Sie mir die Pistole."

# game/scripts/c16/c16.rpy:2389
translate german c16s003_ShootingLessons_8cc59136:

    # mc "Es más difícil de lo que parece. En las películas lo pillan en seguida."
    mc "Es ist schwieriger, als es aussieht. In den Filmen merken sie es sofort."

# game/scripts/c16/c16.rpy:2390
translate german c16s003_ShootingLessons_dbc49818:

    # eva "¿Qué te he dicho sobre Spiderman hace un rato? No te creas nada de lo que veas en una película."
    eva "Was habe ich dir vorhin über Spiderman gesagt? Glaube nicht alles, was du in einem Film siehst."

# game/scripts/c16/c16.rpy:2391
translate german c16s003_ShootingLessons_8fb1373c:

    # eva "Si esto fuera una película habrías acertado a la primera y estaríamos follando contra un árbol."
    eva "Wenn das ein Film wäre, hättest du es schon beim ersten Mal erraten und wir würden an einem Baum vögeln."

# game/scripts/c16/c16.rpy:2392
translate german c16s003_ShootingLessons_1c09825e:

    # mc "*Risa* Antes me vas a tener que invitar a cenar. *Risa*"
    mc "*Lacht* Du musst mich erst mal zum Abendessen einladen. *Lacht*"

# game/scripts/c16/c16.rpy:2394
translate german c16s003_ShootingLessons_3ae0c5f5:

    # eva "Tú crees que eres gracioso, ¿verdad? No hace falta que contestes."
    eva "Du denkst wohl, du bist witzig, was? Du musst nicht antworten."

# game/scripts/c16/c16.rpy:2395
translate german c16s003_ShootingLessons_83ba66b2:

    # eva "Tu problema es que tiras del gatillo."
    eva "Dein Problem ist, dass du den Abzug betätigst."

# game/scripts/c16/c16.rpy:2396
translate german c16s003_ShootingLessons_7e0d352a:

    # mc "Eso es lo que hay que hacer, ¿no? Si no, no dispara."
    mc "Genau das musst du tun, richtig? Sonst zündet es nicht."

# game/scripts/c16/c16.rpy:2397
translate german c16s003_ShootingLessons_4d2a88ea:

    # eva "No, si tiras del gatillo estás desequilibrando el arma. Hacia abajo, como ahora. Eso si eres capaz de controlar el retroceso, que lo estás empezando a hacer bien."
    eva "Nein, wenn du den Abzug betätigst, gerät die Waffe aus dem Gleichgewicht. Nach unten, so wie jetzt. Vorausgesetzt natürlich, du kannst den Rückstoß kontrollieren, was dir ja immer besser gelingt."

# game/scripts/c16/c16.rpy:2398
translate german c16s003_ShootingLessons_61279e7e:

    # eva "Lo que tienes que hacer es estrujar con toda la mano. Empuñadura y gatillo. Como si fuera una pelota antiestrés. ¿Ves?"
    eva "Du musst es mit der ganzen Hand zusammendrücken. Zupacken und auslösen. Wie bei einem Stressball. Verstehst du?"

# game/scripts/c16/c16.rpy:2399
translate german c16s003_ShootingLessons_c97c5a04:

    # mc "Vale, lo veo. Déjame probar otra vez"
    mc "Okay, ich sehe es. Ich versuche es noch einmal."

# game/scripts/c16/c16.rpy:2402
translate german c16s003_ShootingLessons_ee71ee81_3:

    # "*Bang*"
    "*Knall*"

# game/scripts/c16/c16.rpy:2403
translate german c16s003_ShootingLessons_49e3887e:

    # "La teoría de estrujar empuñadura y gatillo a la vez es fácil. La práctica no."
    "Die Theorie hinter dem gleichzeitigen Drücken von Griff und Abzug ist einfach. Die Praxis ist es nicht."

# game/scripts/c16/c16.rpy:2404
translate german c16s003_ShootingLessons_c55629c2:

    # eva "Casi. El topo acaba de reservar unas vacaciones en Florida. *Risa* Prefiere los caimanes. Controla un poco más como estrujas el conjunto y casi lo tendrás."
    eva "Fast. Der Maulwurf hat gerade Urlaub in Florida gebucht. *Lacht* Er bevorzugt Alligatoren. Wenn du beim Zusammendrücken noch etwas vorsichtiger bist, hast du ihn fast."

# game/scripts/c16/c16.rpy:2407
translate german c16s003_ShootingLessons_ee71ee81_4:

    # "*Bang*"
    "*Knall*"

# game/scripts/c16/c16.rpy:2408
translate german c16s003_ShootingLessons_261480da:

    # "Esta vez sí que impactas en el bote. La sensación de alegría es inmensa."
    "Diesmal hast du wirklich den Jackpot geknackt. Die Freude ist unbeschreiblich."

# game/scripts/c16/c16.rpy:2409
translate german c16s003_ShootingLessons_01891b38:

    # mc "¡Sí!"
    mc "Ja!"

# game/scripts/c16/c16.rpy:2410
translate german c16s003_ShootingLessons_9f9ce441:

    # eva "¡Muy bien, [mc]! Un último disparo para comprobar que no ha sido casualidad."
    eva "Sehr gut, [mc]! Ein letzter Versuch, um sicherzugehen, dass es kein Zufall war."

# game/scripts/c16/c16.rpy:2413
translate german c16s003_ShootingLessons_ee71ee81_5:

    # "*Bang*"
    "*Knall*"

# game/scripts/c16/c16.rpy:2414
translate german c16s003_ShootingLessons_9aa56c1a:

    # "La lata salta por los aires. ¡Estás aprendiendo a disparar!"
    "Die Dose fliegt durch die Luft. Du lernst schießen!"

# game/scripts/c16/c16.rpy:2415
translate german c16s003_ShootingLessons_65608ae9:

    # eva "¡Genial!"
    eva "Genial!"

# game/scripts/c16/c16.rpy:2416
translate german c16s003_ShootingLessons_d11b853e:

    # eva "Te quedan 11 balas y cuatro objetivos. A ver cuántos puedes derribar."
    eva "Du hast noch 11 Kugeln und vier Ziele. Mal sehen, wie viele du treffen kannst."

# game/scripts/c16/c16.rpy:2419
translate german c16s003_ShootingLessons_61d2f1fa:

    # "*Bang* *Bang* *Bang*"
    "*Peng* *Peng* *Peng*"

# game/scripts/c16/c16.rpy:2420
translate german c16s003_ShootingLessons_2dd5869c:

    # "Disparas tres veces a la botella de gel de manos. No hay suerte. Dirías que le has dado, pero no ha saltado por los aires. Ocho balas. Cuatro objetivos todavía."
    "Du feuerst drei Schüsse auf die Flasche mit dem Handdesinfektionsmittel ab. Kein Erfolg. Du denkst, du hättest getroffen, aber sie ist nicht explodiert. Acht Kugeln. Immer noch vier Ziele."

# game/scripts/c16/c16.rpy:2421
translate german c16s003_ShootingLessons_f27f9b21:

    # eva "Esa botella no quiere morir. *Risa*"
    eva "Diese Flasche will einfach nicht sterben. *lacht*"

# game/scripts/c16/c16.rpy:2424
translate german c16s003_ShootingLessons_54c88ec6:

    # "*Bang* *Bang*"
    "*Peng* *Peng*"

# game/scripts/c16/c16.rpy:2425
translate german c16s003_ShootingLessons_dfb9a365:

    # "La siguiente lata salta volando al segundo disparo. Seis balas. Tres objetivos."
    "Die nächste Dose fliegt beim zweiten Schuss weg. Sechs Kugeln. Drei Ziele."

# game/scripts/c16/c16.rpy:2426
translate german c16s003_ShootingLessons_ab282110:

    # eva "¡Muy bien!"
    eva "Sehr gut!"

# game/scripts/c16/c16.rpy:2429
translate german c16s003_ShootingLessons_ee71ee81_6:

    # "*Bang*"
    "*Knall*"

# game/scripts/c16/c16.rpy:2430
translate german c16s003_ShootingLessons_71cea6f0:

    # "La siguiente al primero. Cinco balas. Dos objetivos."
    "Die nächste nach der ersten. Fünf Kugeln. Zwei Ziele."

# game/scripts/c16/c16.rpy:2431
translate german c16s003_ShootingLessons_21c9233d:

    # eva "¡Alucinante!"
    eva "Halluzinatorisch!"

# game/scripts/c16/c16.rpy:2432
translate german c16s003_ShootingLessons_2a0ec6bb:

    # "Cambias de objetivo."
    "Du änderst dein Ziel."

# game/scripts/c16/c16.rpy:2435
translate german c16s003_ShootingLessons_61d2f1fa_1:

    # "*Bang* *Bang* *Bang*"
    "*Peng* *Peng* *Peng*"

# game/scripts/c16/c16.rpy:2436
translate german c16s003_ShootingLessons_c6603222:

    # "Te cuesta tres balas acabar con la siguiente lata. Últimas dos balas. Solo queda la botella de gel de manos."
    "Drei Kugeln reichen, um die nächste Dose zu leeren. Die letzten beiden Kugeln. Nur noch die Flasche mit dem Händedesinfektionsmittel ist übrig."

# game/scripts/c16/c16.rpy:2437
translate german c16s003_ShootingLessons_f3699c6d:

    # eva "Esa se ha resistido, pero bien. A por la última."
    eva "Das war knifflig, aber gut. Weiter zur letzten."

# game/scripts/c16/c16.rpy:2440
translate german c16s003_ShootingLessons_54c88ec6_1:

    # "*Bang* *Bang*"
    "*Peng* *Peng*"

# game/scripts/c16/c16.rpy:2441
translate german c16s003_ShootingLessons_16e68d53:

    # "Vuelves a la botella. Disparas. Volverías a jurar que le has dado, pero la botella sigue ahí. No has fallado porque sea transparente, ¿verdad?"
    "Du gehst zurück zur Flasche. Du schießst. Du würdest schwören, du hättest sie wieder getroffen, aber die Flasche ist immer noch da. Du hast nicht verfehlt, weil sie durchsichtig ist, oder?"

# game/scripts/c16/c16.rpy:2443
translate german c16s003_ShootingLessons_785266c5:

    # eva "Muy bien, [mc]."
    eva "Sehr gut, [mc]."

# game/scripts/c16/c16.rpy:2444
translate german c16s003_ShootingLessons_4e17dc40:

    # mc "Muy bien no. La botella se ha resistido."
    mc "Nicht besonders gut. Die Flasche hat mir Probleme bereitet."

# game/scripts/c16/c16.rpy:2445
translate german c16s003_ShootingLessons_84d67cbf:

    # eva "¿Estás seguro? Ve a verla."
    eva "Bist du sicher? Dann schau es dir an."

# game/scripts/c16/c16.rpy:2447
translate german c16s003_ShootingLessons_a3d8938e:

    # mc "¿Has clavado la botella al suelo? *Risa*"
    mc "Hast du die Flasche in die Erde gesteckt? *lacht*"

# game/scripts/c16/c16.rpy:2449
translate german c16s003_ShootingLessons_485a1eef:

    # eva "*Risa* ¡Sí! Ha sido divertido ver cómo te frustrabas. Se me saltan las lágrimas."
    eva "*Lacht* Ja! Es war echt witzig, dich so frustriert zu sehen. Mir kommen fast die Tränen."

# game/scripts/c16/c16.rpy:2450
translate german c16s003_ShootingLessons_11f2057b:

    # mc "Muy graciosa... *Risa*"
    mc "Sehr witzig... *lacht*"

# game/scripts/c16/c16.rpy:2451
translate german c16s003_ShootingLessons_5449829a:

    # mc "Pero no sé cuántas veces le he dado. No sé ni cuántas le he disparado..."
    mc "Aber ich weiß nicht, wie oft ich es getroffen habe. Ich weiß nicht einmal, wie oft ich darauf geschossen habe..."

# game/scripts/c16/c16.rpy:2453
translate german c16s003_ShootingLessons_3a0f7938:

    # eva "Le has disparado cinco veces y le has dado dos. No está nada mal para tu primera vez. 17 balas y siete aciertos."
    eva "Du hast fünfmal auf ihn geschossen und ihn zweimal getroffen. Nicht schlecht fürs erste Mal. 17 Kugeln, sieben Treffer."

# game/scripts/c16/c16.rpy:2454
translate german c16s003_ShootingLessons_90d53fbc:

    # eva "Mi primera vez fue bastante peor. Y fui la mejor de todas."
    eva "Mein erstes Mal war viel schlimmer. Und ich war die Beste von allen."

# game/scripts/c16/c16.rpy:2457
translate german c16s003_ShootingLessons_6ef6c4c4:

    # eva "Sí, lo sé Amanda, conseguí la misma puntuación que tú, pero más dieces."
    eva "Ja, ich weiß, Amanda, ich habe die gleiche Punktzahl wie du, aber mit mehr Zehnern."

# game/scripts/c16/c16.rpy:2459
translate german c16s003_ShootingLessons_feb7a9e4:

    # mc "¿Qué edad tenías?"
    mc "Wie alt waren Sie?"

# game/scripts/c16/c16.rpy:2461
translate german c16s003_ShootingLessons_7316c5b5:

    # eva "6 años. Aquellas pistolas fueron nuestro regalo de cumpleaños."
    eva "6 Jahre alt. Diese Spielzeugpistolen waren unser Geburtstagsgeschenk."

# game/scripts/c16/c16.rpy:2462
translate german c16s003_ShootingLessons_ee6d7077:

    # mc "Eso es muy triste. ¿Ni una muñeca? ¿Ni un juguete?"
    mc "Das ist so traurig. Nicht mal eine Puppe? Nicht mal ein Spielzeug?"

# game/scripts/c16/c16.rpy:2464
translate german c16s003_ShootingLessons_61687f98:

    # eva "Es tan triste como que a ti nunca te regalaran un sable laser que funcionara."
    eva "Das ist genauso traurig, als würde man nie ein funktionierendes Lichtschwert geschenkt bekommen."

# game/scripts/c16/c16.rpy:2465
translate german c16s003_ShootingLessons_61df8865:

    # mc "No existen, Eva."
    mc "Die gibt es nicht, Eva."

# game/scripts/c16/c16.rpy:2467
translate german c16s003_ShootingLessons_307d9685:

    # eva "Igual que en nuestro mundo no existían juguetes o muñecas."
    eva "Genau wie es in unserer Welt keine Spielzeuge oder Puppen gab."

# game/scripts/c16/c16.rpy:2468
translate german c16s003_ShootingLessons_dc077a5f:

    # eva "Nuestros juguetes eran armas y dispositivos de vigilancia. Era lo normal. Y espiarnos entre nosotras era divertido."
    eva "Unser Spielzeug waren Waffen und Überwachungsgeräte. Das war normal. Und es machte Spaß, uns gegenseitig auszuspionieren."

# game/scripts/c16/c16.rpy:2469
translate german c16s003_ShootingLessons_8944a074:

    # eva "Con el tiempo, los A nos empezaron a traer cosas de sus misiones. Bolas de nieve y cosas así."
    eva "Mit der Zeit brachten uns die A's immer mehr Dinge von ihren Einsätzen mit. Schneebälle und so was."

# game/scripts/c16/c16.rpy:2470
translate german c16s003_ShootingLessons_d46f30be:

    # eva "Era casi como sentirse en una película. Eran casi como nuestros tíos favoritos."
    eva "Es war fast wie in einem Film. Sie waren fast wie unsere Lieblingsonkel."

# game/scripts/c16/c16.rpy:2471
translate german c16s003_ShootingLessons_7e47bbdd:

    # mc "Joder, Eva. ¿Puedo abrazarte?"
    mc "Verdammt, Eva. Darf ich dich umarmen?"

# game/scripts/c16/c16.rpy:2473
translate german c16s003_ShootingLessons_7a266f30:

    # eva "{b}¿Qué? ¿A mí? ¿Por qué?{/b}"
    eva "{b}Was? Ich? Warum?{/b}"

# game/scripts/c16/c16.rpy:2474
translate german c16s003_ShootingLessons_5a9dce8e:

    # mc "*Risa* Costumbre familiar. Cuando alguien explica algo triste, nos abrazamos. Nos consolamos."
    mc "*Lachen* Familienbrauch. Wenn jemand etwas Trauriges erzählt, umarmen wir uns. Wir trösten uns gegenseitig."

# game/scripts/c16/c16.rpy:2476
translate german c16s003_ShootingLessons_5df147c8:

    # eva "¿Te ha puesto triste?"
    eva "Hat es dich traurig gemacht?"

# game/scripts/c16/c16.rpy:2477
translate german c16s003_ShootingLessons_65178f3d:

    # mc "Me pone triste que no hayas tenido una infancia normal."
    mc "Es macht mich traurig, dass du keine normale Kindheit hattest."

# game/scripts/c16/c16.rpy:2478
translate german c16s003_ShootingLessons_dc77e864:

    # eva "No tienes que ponerte triste por eso. Para mí... para nosotras, era normal. No echábamos nada de menos."
    eva "Du musst deswegen nicht traurig sein. Für mich... für uns war es normal. Wir haben nichts vermisst."

# game/scripts/c16/c16.rpy:2479
translate german c16s003_ShootingLessons_3c24a76c:

    # mc "¿Estás intentando consolarme? ¿Tú a mí?"
    mc "Willst du mich trösten? Willst du mich trösten?"

# game/scripts/c16/c16.rpy:2481
translate german c16s003_ShootingLessons_66f22b48:

    # eva "En eso consiste, ¿no? Has dicho que cuando algo os pone tristes, os consoláis. ¿O lo he entendido mal?"
    eva "Darum geht es doch, oder? Du sagtest, dass ihr euch gegenseitig tröstet, wenn euch etwas traurig macht. Oder habe ich das falsch verstanden?"

# game/scripts/c16/c16.rpy:2482
translate german c16s003_ShootingLessons_0d0f1f21:

    # mc "No, lo has entendido perfectamente."
    mc "Nein, du hast es vollkommen verstanden."

# game/scripts/c16/c16.rpy:2484
translate german c16s003_ShootingLessons_18706471:

    # "Vuelves a abrazarla. Ya no sabes si para consolarla a ella o a ti mismo. Ella parece no necesitar consuelo, pero ayer demostró que necesita cariño."
    "Du umarmst sie erneut. Du weißt nicht mehr, ob du sie oder dich selbst trösten willst. Sie scheint keinen Trost zu brauchen, aber gestern hat sie gezeigt, dass sie Zuneigung braucht."

# game/scripts/c16/c16.rpy:2485
translate german c16s003_ShootingLessons_8a720530:

    # mcp "(¡Qué difícil va a ser esto! Ni siquiera entiende lo triste que es su situación.)"
    mcp "(Das wird so schwierig! Er versteht ja gar nicht, wie traurig seine Lage ist.)"

# game/scripts/c16/c16.rpy:2486
translate german c16s003_ShootingLessons_5a621af3:

    # eva "Si este es el premio por ponerte triste, tengo un montón de historias para contar."
    eva "Wenn das der Lohn für Traurigkeit ist, habe ich viele Geschichten zu erzählen."

# game/scripts/c16/c16.rpy:2487
translate german c16s003_ShootingLessons_512d67f8:

    # mc "Las quiero oír todas, Eva."
    mc "Ich möchte sie alle hören, Eva."

# game/scripts/c16/c16.rpy:2488
translate german c16s003_ShootingLessons_6822f159:

    # mc "Y en casa también querrán hacerlo. Prepárate para muchos abrazos."
    mc "Und das werden sie auch zu Hause tun wollen. Macht euch auf viele Umarmungen gefasst."

# game/scripts/c16/c16.rpy:2490
translate german c16s003_ShootingLessons_e14b574a:

    # eva "¡Oh, mierda! ¿Qué hora es? ¿A qué hora me esperan para comer?"
    eva "Oh, Mist! Wie spät ist es? Wann erwarten sie mich zum Mittagessen?"

# game/scripts/c16/c16.rpy:2491
translate german c16s003_ShootingLessons_0f00cee4:

    # mc "A la una y media. No sé qué hora es. Tengo el móvil en la mochila."
    mc "Um 1:30 Uhr. Ich weiß nicht, wie spät es ist. Mein Handy ist im Rucksack."

# game/scripts/c16/c16.rpy:2493
translate german c16s003_ShootingLessons_59346b24:

    # eva "Por eso llegas tarde a los sitios. *Risa* Vamos a recoger las latas y empecemos a bajar. A mí no me gusta llegar tarde."
    eva "Deshalb kommst du immer zu spät. *lacht* Lass uns die Dosen holen und losgehen. Ich hasse es, zu spät zu kommen."

# game/scripts/c16/c16.rpy:2494
translate german c16s003_ShootingLessons_02e83dae:

    # mc "¿Cuánto tiempo me lo vas a echar en cara?"
    mc "Wie lange willst du das Thema noch immer ansprechen?"

# game/scripts/c16/c16.rpy:2495
translate german c16s003_ShootingLessons_9cc61597:

    # eva "Hasta que llegues puntual. *Risita*"
    eva "Bis du pünktlich ankommst. *Kichern*"

# game/scripts/c16/c16.rpy:2498
translate german c16s003_ShootingLessons_db5b72df:

    # "Recogéis el campo de tiro. Eva hace hincapié en no dejaros ningún casquillo. Las balas son irrecuperables en su mayoría."
    "Du räumst den Schießstand auf. Eva betont, dass keine leeren Patronenhülsen zurückgelassen werden dürfen. Die meisten Kugeln sind nicht mehr zu bergen."

# game/scripts/c16/c16.rpy:2499
translate german c16s003_ShootingLessons_339de07e:

    # "Se hace una cola y empezáis a bajar hacia casa. Ella es mucho más rápida y ágil que tú. También tiene más prisa. Ni una gota de sudor perla su frente."
    "Eine Schlange bildet sich, und ihr geht beide nach Hause. Sie ist viel schneller und wendiger als du. Sie hat es auch eiliger. Kein Schweißtropfen rinnt ihr über die Stirn."

# game/scripts/c16/c16.rpy:2502
translate german c16s003_ShootingLessons_46540fd2:

    # eva "Venga, tortuguilla. Vamos a llegar tarde por tu culpa."
    eva "Komm schon, kleine Schildkröte. Wegen dir kommen wir zu spät."

# game/scripts/c16/c16.rpy:2503
translate german c16s003_ShootingLessons_238c4bb3:

    # mc "Hay tiempo de sobra, Eva."
    mc "Es ist noch genügend Zeit, Eva."

# game/scripts/c16/c16.rpy:2504
translate german c16s003_ShootingLessons_6362713e:

    # eva "No tanto. Me tengo que cambiar de ropa. No quiero que la primera impresión que tenga la familia de mí sea vestida así."
    eva "Nicht wirklich. Ich muss mich umziehen. Ich möchte nicht, dass meine Familie mich so angezogen zum ersten Mal sieht."

# game/scripts/c16/c16.rpy:2505
translate german c16s003_ShootingLessons_6c9962db:

    # mc "¿Por eso te has hecho la coleta?"
    mc "Ist das der Grund, warum du deine Haare zu einem Pferdeschwanz bindest?"

# game/scripts/c16/c16.rpy:2507
translate german c16s003_ShootingLessons_fb1c88a0:

    # eva "Tengo más pinta de buena chica con ella, ¿no? *Risita*"
    eva "Ich sehe für sie eher wie ein nettes Mädchen aus, nicht wahr? *Kichert*"

# game/scripts/c16/c16.rpy:2508
translate german c16s003_ShootingLessons_aae332f6:

    # mc "Eva, la primera impresión que se van a llevar es que eres una buena chica. Porque lo eres."
    mc "Eva, der erste Eindruck, den sie von dir bekommen werden, ist, dass du ein gutes Mädchen bist. Weil du es auch bist."

# game/scripts/c16/c16.rpy:2509
translate german c16s003_ShootingLessons_7bc3e73a:

    # mc "Ahora vas a decirme que llevas un vestido en la mochila."
    mc "Jetzt willst du mir also erzählen, dass du ein Kleid in deinem Rucksack trägst?"

# game/scripts/c16/c16.rpy:2511
translate german c16s003_ShootingLessons_ce4ddcbd:

    # eva "¿Un vestido? ¿Qué tiene de malo un vestido? ¿No sería apropiado?"
    eva "Ein Kleid? Was spricht gegen ein Kleid? Wäre das nicht angemessen?"

# game/scripts/c16/c16.rpy:2512
translate german c16s003_ShootingLessons_40705795:

    # mc "Puedes ponerte lo que quieras, pero apuesto a que [dap] y [emm] van a ir con shorts. Ya las habéis visto. Ante todo, quieren estar cómodas en casa."
    mc "Du kannst tragen, was du willst, aber ich wette, [dap] und [emm] werden Shorts tragen. Du hast sie ja schon gesehen. Vor allem wollen sie es zu Hause gemütlich haben."

# game/scripts/c16/c16.rpy:2513
translate german c16s003_ShootingLessons_61ec2cf1:

    # eva "¿Shorts? Perfecto. También llevo."
    eva "Shorts? Perfekt. Die trage ich auch."

# game/scripts/c16/c16.rpy:2514
translate german c16s003_ShootingLessons_8e2099cf:

    # mcp "(¿Está tan nerviosa que se ha traído todo su guardarropa?)"
    mcp "(Ist sie so nervös, dass sie ihre gesamte Garderobe mitgebracht hat?)"

# game/scripts/c16/c16.rpy:2515
translate german c16s003_ShootingLessons_9871aeb0:

    # mc "El vestido iría mejor para una cena. O para la comida del domingo."
    mc "Das Kleid wäre besser für ein Abendessen mit Freunden oder für ein Sonntagsessen geeignet."

# game/scripts/c16/c16.rpy:2517
translate german c16s003_ShootingLessons_58a403c5:

    # eva "El domingo también me toca ir a comer a mí, ¿no?"
    eva "Ich muss ja auch sonntags essen gehen, richtig?"

# game/scripts/c16/c16.rpy:2518
translate german c16s003_ShootingLessons_a12c28ce:

    # mc "Claro. Hoy y el domingo vienes a comer. Mañana a cenar."
    mc "Klar. Du kommst heute und Sonntag zum Mittagessen. Morgen zum Abendessen."

# game/scripts/c16/c16.rpy:2520
translate german c16s003_ShootingLessons_0333a8e4:

    # eva "Lo digo porque vais a celebrar el cumpleaños de las chicas. A lo mejor queréis que sea algo familiar."
    eva "Ich sage das, weil ihr ja die Geburtstage der Mädchen feiern wollt. Vielleicht möchtet ihr daraus ein Familienfest machen."

# game/scripts/c16/c16.rpy:2521
translate german c16s003_ShootingLessons_6a7e79ec:

    # mc "Será familiar. Te lo dije en la playa. De alguna forma formáis parte de esta familia. Hoy lo terminarás de descubrir."
    mc "Es wird dir vertraut vorkommen. Ich habe es dir am Strand gesagt. In gewisser Weise gehörst du zu dieser Familie. Das wirst du heute ganz sicher erfahren."

# game/scripts/c16/c16.rpy:2522
translate german c16s003_ShootingLessons_65de1a0d:

    # mc "Amanda. El domingo ven tú también a comer. Y antes de que preguntes quién va a vigilar, la respuesta es vosotras mientas coméis."
    mc "Amanda, du solltest am Sonntag auch zum Mittagessen kommen. Und bevor du fragst, wer die Aufsicht übernimmt: Ihr beide, während ihr esst."

# game/scripts/c16/c16.rpy:2524
translate german c16s003_ShootingLessons_8ac9bed3:

    # eva "Dice que OK."
    eva "Er sagt: Okay."

# game/scripts/c16/c16.rpy:2525
translate german c16s003_ShootingLessons_55637707:

    # eva "Sois raros. Celebráis los tres cumpleaños juntos. Hoy es el de [emm], el lunes el de [dap] y [eri]... y lo celebráis el domingo... raros."
    eva "Ihr seid echt komisch. Ihr feiert alle drei Geburtstage zusammen. Heute hat [emm] Geburtstag, am Montag haben [dap] und [eri] Geburtstag … und ihr feiert am Sonntag … seltsam."

# game/scripts/c16/c16.rpy:2527
translate german c16s003_ShootingLessons_7d2ca042:

    # mc "Se llevan tres días de diferencia."
    mc "Zwischen ihnen liegen drei Tage."

# game/scripts/c16/c16.rpy:2529
translate german c16s003_ShootingLessons_32797ee1:

    # mc "Se llevan tres días de diferencia. Al menos por lo que sabemos."
    mc "Zwischen ihnen liegen drei Tage. Zumindest soweit wir wissen."

# game/scripts/c16/c16.rpy:2530
translate german c16s003_ShootingLessons_9cc74fde:

    # mc "Celebrar el cumpleaños de [emm] y tres días después los otros dos hubiera sido agotador. [nor] y [mar] las educaron para que la celebración fuera el domingo más cercano."
    mc "Den Geburtstag von [emm] und dann die beiden anderen drei Tage später zu feiern, wäre anstrengend gewesen. [nor] und [mar] haben sie so erzogen, dass sie am nächstgelegenen Sonntag feiern."

# game/scripts/c16/c16.rpy:2532
translate german c16s003_ShootingLessons_a3fa256e:

    # eva "No parece algo que [emm] aceptara de buen grado."
    eva "Es scheint nicht so, als ob [emm] das ohne Weiteres akzeptieren würde."

# game/scripts/c16/c16.rpy:2533
translate german c16s003_ShootingLessons_a1391750:

    # mc "Para cuando fue consciente de su cumpleaños estaba acostumbrada a hacerlo así. Nunca supuso un problema. Hoy recibe los besos y abrazos. El domingo los regalos."
    mc "Als sie merkte, dass sie Geburtstag hatte, war sie es schon gewohnt. Es war nie ein Problem gewesen. Heute bekommt sie Küsse und Umarmungen. Am Sonntag die Geschenke."

# game/scripts/c16/c16.rpy:2535
translate german c16s003_ShootingLessons_af2c0fe4:

    # eva "¿Ves, Amanda? Te lo dije. No hacía falta que trajéramos nada hoy."
    eva "Siehst du, Amanda? Ich hab's dir doch gesagt. Wir brauchten heute nichts mitzubringen."

# game/scripts/c16/c16.rpy:2536
translate german c16s003_ShootingLessons_c53b4e30:

    # mc "Bueno, vosotras vais a ser un regalo especial para ella. Seguro. También para [dap] y [eri]."
    mc "Ihr zwei werdet ein ganz besonderes Geschenk für sie sein. Ganz bestimmt. Und auch für [dap] und [eri]."

# game/scripts/c16/c16.rpy:2537
translate german c16s003_ShootingLessons_c9dfce51:

    # mc "Hablando de [eri]... tenemos una conversación pendiente sobre el día que te disfrazaste."
    mc "Wo wir gerade von [eri] sprechen... wir haben ein hervorragendes Gespräch über den Tag, an dem du dich so schick gemacht hast."

# game/scripts/c16/c16.rpy:2539
translate german c16s003_ShootingLessons_620a9dc4:

    # eva "Amanda, corto la comunicación."
    eva "Amanda, ich habe den Kontakt abgebrochen."

# game/scripts/c16/c16.rpy:2540
translate german c16s003_ShootingLessons_ef47d46b:

    # eva "¿Qué quieres saber?"
    eva "Was möchten Sie wissen?"

# game/scripts/c16/c16.rpy:2541
translate german c16s003_ShootingLessons_fbcdae8f:

    # mc "¿Por qué lo hiciste? ¿Qué querías?"
    mc "Warum hast du das getan? Was wolltest du damit erreichen?"

# game/scripts/c16/c16.rpy:2543
translate german c16s003_ShootingLessons_01b145ef:

    # eva "Ahora te va a parecer ridículo. A mí también me lo parece. Anoche le estuve dando vueltas. Sabía que querrías tener esta conversación."
    eva "Du wirst das jetzt für lächerlich halten. Ich finde es auch lächerlich. Ich habe gestern Abend darüber nachgedacht. Ich wusste, dass du dieses Gespräch führen wolltest."

# game/scripts/c16/c16.rpy:2544
translate german c16s003_ShootingLessons_f6f66c34:

    # mc "Prueba a explicármelo y después decidimos si es ridículo."
    mc "Versuche es mir zu erklären, und dann entscheiden wir, ob es lächerlich ist."

# game/scripts/c16/c16.rpy:2545
translate german c16s003_ShootingLessons_92304697:

    # eva "Piensa que no entraba en nuestros planes que llegáramos a conocerte nunca."
    eva "Er glaubt, es war nicht geplant, dass wir dich jemals treffen würden."

# game/scripts/c16/c16.rpy:2546
translate german c16s003_ShootingLessons_6ca0a4be:

    # eva "Me quedé atrapada en la habitación de Saira mientras ponía las cámaras. Me empecé a disfrazar de [eri] para matar el rato mientras os dormíais todos."
    eva "Ich saß in Sairas Zimmer fest, während ich die Kameras installierte. Um mir die Zeit zu vertreiben, während ihr alle eingeschlafen seid, habe ich mich als [eri] verkleidet."

# game/scripts/c16/c16.rpy:2547
translate german c16s003_ShootingLessons_4cd55467:

    # eva "Mi disfraz de [eri] estaba allí, era una habitación que no se iba a usar durante un tiempo. Y se me ocurrió una idea."
    eva "Mein [eri]-Kostüm war dort; es war ein Raum, der eine Weile nicht genutzt werden sollte. Und da kam mir eine Idee."

# game/scripts/c16/c16.rpy:2548
translate german c16s003_ShootingLessons_8ce0712b:

    # mc "Me das miedo."
    mc "Du machst mir Angst."

# game/scripts/c16/c16.rpy:2550
translate german c16s003_ShootingLessons_302f2f3a:

    # eva "Mira... estás bueno, ¿vale?"
    eva "Hör mal... du siehst gut aus, okay?"

# game/scripts/c16/c16.rpy:2551
translate german c16s003_ShootingLessons_39810c93:

    # mc "Ermmm... gracias, supongo..."
    mc "Ähm... danke, nehme ich an..."

# game/scripts/c16/c16.rpy:2554
translate german c16s003_ShootingLessons_a18290a8:

    # eva "Después de lo de la sauna, tarde o temprano ibas a tener sexo con [eri], y parecía que necesitabas un empujón con todo eso de \"cuando estés lista\"."
    eva "Nach dem Sauna-Vorfall war es nur eine Frage der Zeit, bis du mit [eri] Sex haben würdest, und es schien, als bräuchtest du einen kleinen Anstoß bei all dem \"wenn du bereit bist\"."

# game/scripts/c16/c16.rpy:2555
translate german c16s003_ShootingLessons_cc79a3a1:

    # eva "Y pensé... ¿por qué no catarlo yo antes y a la vez darte ese empujón? Ya lo sé, estúpido y ridículo."
    eva "Und da dachte ich mir... warum probiere ich es nicht erst selbst und gebe dir den nötigen Anstoß? Ich weiß, dumm und lächerlich."

# game/scripts/c16/c16.rpy:2556
translate german c16s003_ShootingLessons_6c5fbb10:

    # mc "Aparte de todo lo que hay de malo en ese plan, no se te ocurrió pensar que, cuando tuviéramos sexo por primera vez, yo me sorprendería de que siguiera siendo virgen, ¿verdad?"
    mc "Abgesehen von all den Fehlern an diesem Plan, ist dir nicht in den Sinn gekommen, dass ich überrascht sein würde, als ich beim ersten Mal Sex feststellte, dass ich noch Jungfrau war, oder?"

# game/scripts/c16/c16.rpy:2558
translate german c16s003_ShootingLessons_3b39a5ec:

    # eva "Después de lo de la sauna, creí que necesitabas un empujón en la dirección de [eri]."
    eva "Nach dem Sauna-Vorfall dachte ich, du bräuchtest einen kleinen Anstoß in Richtung [eri]."

# game/scripts/c16/c16.rpy:2559
translate german c16s003_ShootingLessons_2aaf23b4:

    # eva "A la chica le gustas mucho."
    eva "Das Mädchen mag dich sehr."

# game/scripts/c16/c16.rpy:2560
translate german c16s003_ShootingLessons_93064ed0:

    # eva "Y pensé... que si podía llevarme una alegría mientras ayudaba un poco a [eri], ¿por qué no? Ya lo sé, estúpido y ridículo."
    eva "Und ich dachte... wenn ich dabei etwas Freude empfinden und [eri] ein wenig helfen könnte, warum nicht? Ich weiß, dumm und lächerlich."

# game/scripts/c16/c16.rpy:2561
translate german c16s003_ShootingLessons_0965790e:

    # mc "Aparte de todo lo que hay de malo en ese plan, no se te ocurrió que, si hubiera funcionado, yo me hubiera sorprendido de que siguiera siendo virgen, ¿verdad?"
    mc "Abgesehen von all den Fehlern dieses Plans, ist dir nicht in den Sinn gekommen, dass ich, wenn er funktioniert hätte, überrascht gewesen wäre, dass ich noch Jungfrau wäre, oder?"

# game/scripts/c16/c16.rpy:2562
translate german c16s003_ShootingLessons_5cdd8eba:

    # mc "Podrías haber arruinado nuestra relación con ese plan tuyo. Nuestra primera vez juntos no hubiera significado lo mismo."
    mc "Mit deinem Plan hättest du unsere Beziehung zerstören können. Unser erstes Mal zusammen hätte nicht dasselbe bedeutet."

# game/scripts/c16/c16.rpy:2564
translate german c16s003_ShootingLessons_975add47:

    # eva "Ya te he dicho que fue estúpido. Parece uno de los planes de [emm]. A veces me parezco más a [emm] que a [dap] o a [eri]."
    eva "Ich hab's dir doch schon gesagt, dass es dumm ist. Klingt nach einem von [emm]s Plänen. Manchmal bin ich eher wie [emm] als wie [dap] oder [eri]."

# game/scripts/c16/c16.rpy:2565
translate german c16s003_ShootingLessons_9d2dc00a:

    # eva "Espero que no me odies por ello. Me arrepiento mucho de haberlo intentado."
    eva "Ich hoffe, du hasst mich deswegen nicht. Ich bereue es zutiefst, es überhaupt versucht zu haben."

# game/scripts/c16/c16.rpy:2566
translate german c16s003_ShootingLessons_1ab31e72:

    # mc "No, Eva. Ayer me sentí estúpido cuando até cabos. Pero no te odio."
    mc "Nein, Eva. Ich kam mir gestern dumm vor, als mir das klar wurde. Aber ich hasse dich nicht."

# game/scripts/c16/c16.rpy:2567
translate german c16s003_ShootingLessons_321b543c:

    # mc "Es algo que yo no hubiera hecho nunca... Y sí. Es ridículo. Quiero que me prometas que no se volverá a repetir."
    mc "So etwas hätte ich nie getan... Und ja, es ist absurd. Versprich mir, dass es nicht wieder vorkommt."

# game/scripts/c16/c16.rpy:2569
translate german c16s003_ShootingLessons_0cb1f14a:

    # eva "Ahora no tiene sentido que se repita. Ahora me caes bien y no creo que tu relación con [eri] vaya a cambiar mucho. O con [dap]."
    eva "Es hat keinen Sinn, das jetzt zu wiederholen. Ich mag dich jetzt, und ich glaube nicht, dass sich deine Beziehung zu [eri] groß ändern wird. Oder zu [dap]."

# game/scripts/c16/c16.rpy:2570
translate german c16s003_ShootingLessons_512d083c:

    # mc "¿Ahora te caigo bien? ¿Antes no?"
    mc "Magst du mich jetzt? Mochtest du mich vorher nicht?"

# game/scripts/c16/c16.rpy:2572
translate german c16s003_ShootingLessons_29db94d3:

    # eva "¡Oops! ¿Ves como me parezco a [emm]? No sé tener la boca cerrada."
    eva "Ups! Seht ihr, wie ich aussehe? Ich kann einfach nicht den Mund halten."

# game/scripts/c16/c16.rpy:2573
translate german c16s003_ShootingLessons_431475a2:

    # eva "La verdad es que con lo que veía cuando llegaste... me parecías un poco manipulador."
    eva "Die Wahrheit ist, dass Sie, so wie ich Sie bei Ihrer Ankunft gesehen habe, einen etwas manipulativen Eindruck machten."

# game/scripts/c16/c16.rpy:2575
translate german c16s003_ShootingLessons_3491d572:

    # eva "Tienes que entenderlo. Llevábamos dos meses vigilando a tu familia. Son bastante adorables y nos salió el instinto protector."
    eva "Sie müssen das verstehen. Wir beobachten Ihre Familie schon seit zwei Monaten. Sie sind wirklich sehr lieb, und unser Beschützerinstinkt ist erwacht."

# game/scripts/c16/c16.rpy:2576
translate german c16s003_ShootingLessons_43725223:

    # eva "Llegas tú y todo empezó a cambiar. Empiezaron a haber secretos y... No, no me caías bien... pero estabas bueno."
    eva "Dann kamst du und alles begann sich zu verändern. Geheimnisse kamen ans Licht und... Nein, ich mochte dich nicht... aber du warst attraktiv."

# game/scripts/c16/c16.rpy:2577
translate german c16s003_ShootingLessons_be678b85:

    # mc "Puedo entenderlo. Y me alegra que no se vaya a repetir. Y de que tengas ese instinto hacia las chicas."
    mc "Das kann ich verstehen. Und ich bin froh, dass es nicht wieder vorkommt. Und dass du dieses Gespür für Mädchen hast."

# game/scripts/c16/c16.rpy:2578
translate german c16s003_ShootingLessons_1184be89:

    # mc "Bueno, estamos a cinco minutos de casa. ¿Quieres pasar por mi casa a cambiarte de ropa? La comida será en casa de [nor]."
    mc "Okay, wir sind in fünf Minuten zu Hause. Möchtest du zu mir kommen, um dich umzuziehen? Mittagessen gibt es bei [nor]."

# game/scripts/c16/c16.rpy:2580
translate german c16s003_ShootingLessons_0b327004:

    # eva "No hace falta. Puedo cambiarme aquí mismo. Ya me has visto en bragas..."
    eva "Das ist nicht nötig. Ich kann mich gleich hier umziehen. Du hast mich ja schon in Unterwäsche gesehen..."

# game/scripts/c16/c16.rpy:2581
translate german c16s003_ShootingLessons_fdbe4c73:

    # mc "Voy a girarme para darte un poco de privacidad."
    mc "Ich drehe mich um, um Ihnen etwas Privatsphäre zu geben."

# game/scripts/c16/c16.rpy:2582
translate german c16s003_ShootingLessons_94150bce:

    # eva "Como quieras."
    eva "Was immer du willst."

# game/scripts/c16/c16.rpy:2584
translate german c16s003_ShootingLessons_b312a52c:

    # mc "Avísame cuando acabes."
    mc "Sag mir Bescheid, wenn du fertig bist."

# game/scripts/c16/c16.rpy:2585
translate german c16s003_ShootingLessons_8e06d8d6:

    # eva "¿Top rosa o blanco? Rosa es el color de [emm] y blanco el de [dap]. No quiero mostrar preferencias."
    eva "Rosa oder weißes Oberteil? Rosa ist die Farbe von [emm] und Weiß die Farbe von [dap]. Ich möchte keine Präferenz erkennen lassen."

# game/scripts/c16/c16.rpy:2586
translate german c16s003_ShootingLessons_9f95b0a6:

    # mc "No creo que tomen los colores que vistes como una preferencia."
    mc "Ich glaube nicht, dass sie die Farben, die du trägst, als Geschmacksfrage betrachten."

# game/scripts/c16/c16.rpy:2587
translate german c16s003_ShootingLessons_41a224ea:

    # eva "¡Qué poco conoces a tu propia familia! *Risa*"
    eva "Du kennst deine eigene Familie gar nicht richtig! *lacht*"

# game/scripts/c16/c16.rpy:2601
translate german c16s003_ShootingLessons_c333b7a5:

    # mcp "(¿Otra vez este gato?)"
    mcp "(Schon wieder diese Katze?)"

# game/scripts/c16/c16.rpy:2603
translate german c16s003_ShootingLessons_226ea6cc:

    # eva "Sabía que no podrías resistirte a mirar. *Risa*"
    eva "Ich wusste, du könntest nicht widerstehen, hinzuschauen. *lacht*"

# game/scripts/c16/c16.rpy:2604
translate german c16s003_ShootingLessons_2a5e1c73:

    # mc "¡Lo siento, Eva!"
    mc "Es tut mir leid, Eva!"

# game/scripts/c16/c16.rpy:2605
translate german c16s003_ShootingLessons_a867bac8:

    # eva "Ya te he dicho que no hacía falta que te giraras. No ibas a ver nada que no hayas visto."
    eva "Ich habe dir doch schon gesagt, dass du dich nicht umdrehen musst. Du würdest nichts sehen, was du nicht schon gesehen hättest."

# game/scripts/c16/c16.rpy:2606
translate german c16s003_ShootingLessons_553fbcff:

    # eva "Y toda mi vida me he cambiado delante de otros hombres. Solo éramos seis chicas en la base. No había vestuarios exclusivos para nosotras."
    eva "Mein ganzes Leben lang habe ich mich vor anderen Männern umgezogen. Wir waren nur sechs Mädchen auf dem Stützpunkt. Es gab keine Umkleidekabinen nur für uns."

# game/scripts/c16/c16.rpy:2607
translate german c16s003_ShootingLessons_5db79a5b:

    # mc "Voy a volver a girarme mientras acabas de cambiarte."
    mc "Ich werde mich wieder umdrehen, während du dich umziehst."

# game/scripts/c16/c16.rpy:2612
translate german c16s003_ShootingLessons_dec27729:

    # "Un minuto después..."
    "Eine Minute später..."

# game/scripts/c16/c16.rpy:2613
translate german c16s003_ShootingLessons_e49f56df:

    # eva "Ya estoy. Ya podemos irnos."
    eva "Ich bin da. Wir können jetzt gehen."

# game/scripts/c16/c16.rpy:2619
translate german c16s003_ShootingLessons_1af62638:

    # mc "¡Wow! Estás preciosa."
    mc "Wow! Du siehst umwerfend aus."

# game/scripts/c16/c16.rpy:2620
translate german c16s003_ShootingLessons_e18035b9:

    # eva "Gr-gracias... supongo..."
    eva "D-danke... denke ich..."

# game/scripts/c16/c16.rpy:2621
translate german c16s003_ShootingLessons_ff4ee2af:

    # eva "¿N-nos podemos ir? N-no quiero llegar tarde."
    eva "Können wir gehen? Ich möchte nicht zu spät kommen."

# game/scripts/c16/c16.rpy:2622
translate german c16s003_ShootingLessons_b2830286:

    # mcp "(No hace falta preguntarle si está nerviosa. Salta a la vista. La chica dura capaz de disparar a alguien en la cocina de [nor] está histérica por conocer a la familia.)"
    mcp "(Man muss nicht fragen, ob sie nervös ist. Es ist offensichtlich. Das taffe Mädchen, das in der Lage ist, jemanden in der Küche von [nor] zu erschießen, ist völlig aus dem Häuschen, als es darum geht, die Familie kennenzulernen.)"

# game/scripts/c16/c16.rpy:2623
translate german c16s003_ShootingLessons_9dddc0e5:

    # mc "Vamos, sígueme."
    mc "Komm schon, folge mir."

# game/scripts/c16/c16.rpy:2676
translate german c16s003_LunchWithEva_abbe3ee7:

    # mc "¿Preparada para un montón de abrazos?"
    mc "Bereit für ganz viele Umarmungen?"

# game/scripts/c16/c16.rpy:2677
translate german c16s003_LunchWithEva_3133566c:

    # eva "No me asustes... creo que en estos últimos dos días he dado y recibido más abrazos que en los últimos dos años."
    eva "Erschreck mich nicht... Ich glaube, in den letzten zwei Tagen habe ich mehr Umarmungen gegeben und bekommen als in den letzten zwei Jahren."

# game/scripts/c16/c16.rpy:2678
translate german c16s003_LunchWithEva_92f2cb10:

    # mc "Pues ve haciéndote a la idea de que no ha sido nada comparado con lo que te espera."
    mc "Nun, gewöhnen Sie sich besser an den Gedanken, dass dies nichts war im Vergleich zu dem, was Sie erwartet."

# game/scripts/c16/c16.rpy:2680
translate german c16s003_LunchWithEva_0bfb42cf:

    # eva "No me vas a dejar sola con... ellas, ¿verdad?"
    eva "Du wirst mich doch nicht mit ihnen allein lassen... oder?"

# game/scripts/c16/c16.rpy:2681
translate german c16s003_LunchWithEva_331053db:

    # mc "Creo que sí. Todo el mundo va a querer conocerte, hablar contigo. Van a decir que yo te he tenido para mí solo durante una hora y media y que quieren su ración de Eva."
    mc "Ich denke schon. Jeder wird dich kennenlernen und mit dir reden wollen. Sie werden sagen: „Ich hatte dich anderthalb Stunden ganz für mich allein“ und dass sie auch etwas von Eva abhaben wollen."

# game/scripts/c16/c16.rpy:2683
translate german c16s003_LunchWithEva_ee2f2538:

    # eva "Tal como lo has dicho, parece que me vayan a descuartizar. *Risita*"
    eva "Ganz wie du gesagt hast, klingt es, als würden sie mich in Stücke reißen. *Kichern*"

# game/scripts/c16/c16.rpy:2684
translate german c16s003_LunchWithEva_2c06f8da:

    # mc "No era mi intención que sonara así, pero si te ha sacado una sonrisa, ha valido la pena."
    mc "Ich wollte nicht, dass es so klingt, aber wenn es dich zum Lächeln gebracht hat, hat es sich gelohnt."

# game/scripts/c16/c16.rpy:2685
translate german c16s003_LunchWithEva_0d9c56aa:

    # eva "No te vayas muy lejos. No tengo ningún plan de extracción excepto tú. *Risa*"
    eva "Geh nicht zu weit. Ich habe keinen anderen Plan B, außer dich. *lacht*"

# game/scripts/c16/c16.rpy:2686
translate german c16s003_LunchWithEva_15d4f1de:

    # mc "Vamos dentro, creo que llegamos unos minutos antes de la hora."
    mc "Lasst uns hineingehen, ich glaube, wir sind ein paar Minuten zu früh angekommen."

# game/scripts/c16/c16.rpy:2688
translate german c16s003_LunchWithEva_5cf5ce24:

    # mc "Ven, Eva, te voy a presentar a parte de la familia."
    mc "Komm, Eva, ich werde dich einigen Familienmitgliedern vorstellen."

# game/scripts/c16/c16.rpy:2689
translate german c16s003_LunchWithEva_a1a418ef:

    # eva "*Susurrando* ¡Joder! Parecen un pelotón de fusilamiento."
    eva "*Flüsternd* Verdammt! Die sehen ja aus wie ein Erschießungskommando."

# game/scripts/c16/c16.rpy:2691
translate german c16s003_LunchWithEva_9f2d08a7:

    # mc "Ya conoces a [mar] y a [nor]."
    mc "Du kennst [mar] und [nor] bereits."

# game/scripts/c16/c16.rpy:2693
translate german c16s003_LunchWithEva_18682c9d:

    # nor "Bienvenida a casa de nuevo, Eva." (multiple=2)
    nor "Willkommen zurück zu Hause, Eva." (multiple=2)

# game/scripts/c16/c16.rpy:2694
translate german c16s003_LunchWithEva_ebfc8a31:

    # mom "Me alegra volver a verte." (multiple=2)
    mom "Ich freue mich, Sie wiederzusehen." (multiple=2)

# game/scripts/c16/c16.rpy:2695
translate german c16s003_LunchWithEva_175caa16:

    # eva "Gracias, estoy ansiosa de conocer a todo el mundo... en persona."
    eva "Vielen Dank, ich freue mich darauf, alle persönlich kennenzulernen."

# game/scripts/c16/c16.rpy:2697
translate german c16s003_LunchWithEva_f254efc2:

    # mc "[eri]."
    mc "[eri]."

# game/scripts/c16/c16.rpy:2699
translate german c16s003_LunchWithEva_24257049:

    # eri "Encantada de conocerte, Eva. Bienvenida a la familia."
    eri "Schön, dich kennenzulernen, Eva. Willkommen in der Familie."

# game/scripts/c16/c16.rpy:2700
translate german c16s003_LunchWithEva_d5e3a528:

    # eva "Ermmm... gracias... igualmente..."
    eva "Ähm... danke... ebenso..."

# game/scripts/c16/c16.rpy:2702
translate german c16s003_LunchWithEva_dc7f1402:

    # mc "[emm]."
    mc "[emm]."

# game/scripts/c16/c16.rpy:2703
translate german c16s003_LunchWithEva_d569303d:

    # emm "..."
    emm "..."

# game/scripts/c16/c16.rpy:2704
translate german c16s003_LunchWithEva_43d03600:

    # mc "[emm]..."
    mc "[emm]..."

# game/scripts/c16/c16.rpy:2706
translate german c16s003_LunchWithEva_83cdd92b:

    # emm "*Susurrando* Tú y yo tenemos que hablar..."
    emm "*flüsternd* Du und ich müssen reden..."

# game/scripts/c16/c16.rpy:2709
translate german c16s003_LunchWithEva_bf3c2a7e:

    # emm "Bienvenida a la familia, Eva, conocerte es uno de los mejores regalos de cumpleaños que podía recibir hoy, aunque mi hermano te haya tenido escondida."
    emm "Willkommen in der Familie, Eva. Dich kennenzulernen ist eines der schönsten Geburtstagsgeschenke, die ich heute bekommen konnte, auch wenn mein Bruder dich versteckt gehalten hat."

# game/scripts/c16/c16.rpy:2711
translate german c16s003_LunchWithEva_f09b861b:

    # emm "Bienvenida a la familia, Eva, conocerte es uno de los mejores regalos de cumpleaños que podía recibir hoy, aunque mi {b}\"hermano\"{/b} te haya tenido escondida."
    emm "Willkommen in der Familie, Eva, dich kennenzulernen ist eines der schönsten Geburtstagsgeschenke, die ich heute bekommen könnte, auch wenn mein \"Bruder\" dich versteckt gehalten hat."

# game/scripts/c16/c16.rpy:2712
translate german c16s003_LunchWithEva_1f7c9060:

    # eva "Gracias, [emm]. Me alegra mucho conocerte. Mi... hermana... dice que nos parecemos mucho."
    eva "Vielen Dank, [emm]. Es ist so schön, Sie kennenzulernen. Meine... Schwester... sagt, wir sehen uns sehr ähnlich."

# game/scripts/c16/c16.rpy:2714
translate german c16s003_LunchWithEva_28dd339d:

    # eva "*Susurrando* Y [mc] es tu hermano quieras o no quieras. No sabes la suerte que tienes..."
    eva "*Flüsternd* Und [mc] ist dein Bruder, ob du willst oder nicht. Du weißt gar nicht, wie viel Glück du hast …"

# game/scripts/c16/c16.rpy:2715
translate german c16s003_LunchWithEva_0ede7797:

    # mc "No la he tenido escondida, [emm]. Su trabajo..."
    mc "Ich habe es nicht geheim gehalten, [emm]. Ihre Arbeit..."

# game/scripts/c16/c16.rpy:2717
translate german c16s003_LunchWithEva_c4592f90:

    # emm "¡Hush! ¡Estoy hablando con Eva!"
    emm "Pst! Ich spreche mit Eva!"

# game/scripts/c16/c16.rpy:2718
translate german c16s003_LunchWithEva_22900572:

    # eva "[emm]..."
    eva "[emm]..."

# game/scripts/c16/c16.rpy:2720
translate german c16s003_LunchWithEva_9886c259:

    # mc "[dap]."
    mc "[dap]."

# game/scripts/c16/c16.rpy:2722
translate german c16s003_LunchWithEva_5ebc4f44:

    # dap "Bienvenida a casa. Tenemos que hablar de mil cosas. Quiero saberlo todo de ti."
    dap "Willkommen zu Hause. Wir haben so viel zu besprechen. Ich möchte alles über dich erfahren."

# game/scripts/c16/c16.rpy:2723
translate german c16s003_LunchWithEva_e256be10:

    # eva "Gracias, [dap]... no hay mucho que explicar... pero gracias..."
    eva "Vielen Dank, [dap]... es gibt nicht viel zu erklären... aber vielen Dank..."

# game/scripts/c16/c16.rpy:2725
translate german c16s003_LunchWithEva_fd2c9d89:

    # mc "Scarlett."
    mc "Scarlett."

# game/scripts/c16/c16.rpy:2726
translate german c16s003_LunchWithEva_fb87bb02:

    # sca "No soy oficialmente de la familia, pero... ¿puedo?"
    sca "Ich gehöre zwar nicht offiziell zur Familie, aber... kann ich?"

# game/scripts/c16/c16.rpy:2727
translate german c16s003_LunchWithEva_476f8e55:

    # mc "*Risa* No vas a ser la primera en no abrazarla, ¿verdad?"
    mc "*Lacht* Du wirst doch nicht der Erste sein, der sie nicht umarmt, oder?"

# game/scripts/c16/c16.rpy:2728
translate german c16s003_LunchWithEva_f2981733:

    # eva "*Susurrando* Capullo."
    eva "*Flüsternd* Bud."

# game/scripts/c16/c16.rpy:2730
translate german c16s003_LunchWithEva_8dc4ccd8:

    # sca "Bienvenida a casa. Espero que les des la oportunidad de mostrarte lo maravillosos que son."
    sca "Willkommen zu Hause. Ich hoffe, Sie geben ihnen die Chance, Ihnen zu zeigen, wie wundervoll sie sind."

# game/scripts/c16/c16.rpy:2731
translate german c16s003_LunchWithEva_4916abe3:

    # eva "Me hago una idea. *Susurrando* ¿Cómo estás tú?"
    eva "Ich habe eine Idee. *flüstert* Wie geht es dir?"

# game/scripts/c16/c16.rpy:2732
translate german c16s003_LunchWithEva_a9968549:

    # sca "Genial, gracias a vosotras dos, a [mc], y a esta familia."
    sca "Großartig, vielen Dank euch beiden, an [mc], diese Familie ist bereits da."

# game/scripts/c16/c16.rpy:2734
translate german c16s003_LunchWithEva_cb798274:

    # mc "Tía Betty."
    mc "Tante Betty."

# game/scripts/c16/c16.rpy:2735
translate german c16s003_LunchWithEva_e4075752:

    # bet "¿Puedo abrazarte también?"
    bet "Darf ich dich auch umarmen?"

# game/scripts/c16/c16.rpy:2736
translate german c16s003_LunchWithEva_ce6b59a8:

    # mc "Estoy seguro que lo agradecerá, Tía Betty."
    mc "Ich bin sicher, du wirst es zu schätzen wissen, Tante Betty."

# game/scripts/c16/c16.rpy:2737
translate german c16s003_LunchWithEva_ba53055b:

    # eva "*Susurrando* Sabes que me las vas a pagar, ¿verdad?"
    eva "*Flüsternd* Du weißt, dass du dafür bezahlen wirst, oder?"

# game/scripts/c16/c16.rpy:2739
translate german c16s003_LunchWithEva_0731ba3f:

    # bet "Encantada de conocerte, cariño. Por lo que he oído de ti vamos a ser buenas amigas."
    bet "Schön, dich kennenzulernen, Liebling. Nach allem, was ich über dich gehört habe, werden wir gute Freunde werden."

# game/scripts/c16/c16.rpy:2740
translate german c16s003_LunchWithEva_b9ea2f92:

    # eva "Pero yo sigo una dieta equilibrada..."
    eva "Aber ich ernähre mich ausgewogen..."

# game/scripts/c16/c16.rpy:2742
translate german c16s003_LunchWithEva_1246f4b1:

    # eva "¡Oops! Eso no ha sido muy educado, ¿verdad?"
    eva "Oh je! Das war nicht sehr höflich, oder?"

# game/scripts/c16/c16.rpy:2743
translate german c16s003_LunchWithEva_7e02db21:

    # bet "No pasa nada, cariño. Me invitas a cenar una pizza y todo queda perdonado. *Risa* Tú puedes comer una ensalada, si quieres."
    bet "Schon gut, Schatz. Du kannst mich auf eine Pizza einladen, dann ist alles vergeben. *lacht* Du kannst auch einen Salat haben, wenn du möchtest."

# game/scripts/c16/c16.rpy:2745
translate german c16s003_LunchWithEva_ecdaee51:

    # eva "Ningún problema, tienes que cuidar ese brazo de batear. *Risita*"
    eva "Kein Problem, du musst nur auf deinen Schlagarm aufpassen. *Kichert*"

# game/scripts/c16/c16.rpy:2746
translate german c16s003_LunchWithEva_85f3d124:

    # eva "*Susurrando* Y me encanta que me lleven a cenar, aunque tenga que pagar yo."
    eva "*flüstert* Und ich liebe es, wenn sie mich zum Essen ausführen, auch wenn ich bezahlen muss."

# game/scripts/c16/c16.rpy:2748
translate german c16s003_LunchWithEva_1697e9f8:

    # mc "Y por último, Olivia, mi Meemaw."
    mc "Und schließlich Olivia, meine Oma."

# game/scripts/c16/c16.rpy:2749
translate german c16s003_LunchWithEva_c4b9fb2f:

    # mee "Yo no voy a pedir permiso para abrazarte, lo siento."
    mee "Ich werde dich nicht um Erlaubnis bitten, dich zu umarmen, tut mir leid."

# game/scripts/c16/c16.rpy:2751
translate german c16s003_LunchWithEva_ce680862:

    # mee "Llevas mis genes, con lo que eres mi nieta de alguna forma."
    mee "Du trägst meine Gene, bist also in gewisser Weise meine Enkelin."

# game/scripts/c16/c16.rpy:2753
translate german c16s003_LunchWithEva_d211a36f:

    # mee "Además, no tuve la oportunidad de darte las gracias por todo lo que hicisteis durante el secuestro."
    mee "Außerdem hatte ich keine Gelegenheit, Ihnen für alles zu danken, was Sie während der Entführung getan haben."

# game/scripts/c16/c16.rpy:2754
translate german c16s003_LunchWithEva_43fc1e90:

    # eva "Era trabajo, pero fue un placer. Cuando unes trabajo y placer..."
    eva "Es war zwar Arbeit, aber es hat mir Spaß gemacht. Wenn man Arbeit und Vergnügen verbindet..."

# game/scripts/c16/c16.rpy:2755
translate german c16s003_LunchWithEva_db01e51d:

    # mc "Bueno, creo que ya está, ¿no?"
    mc "Ich denke, das war's, oder?"

# game/scripts/c16/c16.rpy:2757
translate german c16s003_LunchWithEva_464e23da:

    # nor "A mí me ha sabido a poco ese abrazo triple, ¿a tí no?"
    nor "Diese dreifache Umarmung war mir nicht genug, dir etwa nicht?"

# game/scripts/c16/c16.rpy:2758
translate german c16s003_LunchWithEva_9bddd3ad:

    # mom "Sí, pero ¿no crees que ya ha tenido suficientes abrazos por ahora?"
    mom "Ja, aber meinst du nicht, sie hat jetzt erst mal genug Umarmungen bekommen?"

# game/scripts/c16/c16.rpy:2760
translate german c16s003_LunchWithEva_ade859cc:

    # nor "¡Nunca!"
    nor "Niemals!"

# game/scripts/c16/c16.rpy:2761
translate german c16s003_LunchWithEva_e7c1e077:

    # eva "Gracias por esta recepción, [nor]."
    eva "Vielen Dank für diesen Empfang, [nor]."

# game/scripts/c16/c16.rpy:2762
translate german c16s003_LunchWithEva_1ebbeb7a:

    # nor "Es un placer tenerte en casa otra vez."
    nor "Es ist schön, Sie wieder zu Hause zu haben."

# game/scripts/c16/c16.rpy:2764
translate german c16s003_LunchWithEva_6a4639b4:

    # mom "No dejes que te agobiemos demasiado con los abrazos."
    mom "Lass dich nicht von uns mit Umarmungen erdrücken."

# game/scripts/c16/c16.rpy:2765
translate german c16s003_LunchWithEva_52b3fd0e:

    # eva "No te preocupes, [mar]. Creo que acabaré acostumbrándome."
    eva "Keine Sorge, [mar]. Ich denke, ich werde mich irgendwann daran gewöhnen."

# game/scripts/c16/c16.rpy:2767
translate german c16s003_LunchWithEva_9146849b:

    # nor "Hemos preparado una comida de pie. Todas querían sentarse a tu lado y acapararte."
    nor "Wir haben ein Essen im Stehen zubereitet. Jeder wollte neben dir sitzen und dich für sich beanspruchen."

# game/scripts/c16/c16.rpy:2768
translate german c16s003_LunchWithEva_c8c48c80:

    # nor "¿Te va bien así? Si quieres puedes coger un taburete si estás cansada, o sentarte a la mesa..."
    nor "Ist das so in Ordnung? Wenn Sie müde sind, können Sie einen Hocker nehmen oder sich an den Tisch setzen..."

# game/scripts/c16/c16.rpy:2769
translate german c16s003_LunchWithEva_7f5fe307:

    # eva "No te preocupes, [nor], de verdad. Estaré bien de pie."
    eva "Keine Sorge, [nor], wirklich. Ich komme schon klar auf den Beinen."

# game/scripts/c16/c16.rpy:2771
translate german c16s003_LunchWithEva_ce20c6d7:

    # mom "Le va a explotar la cabeza a la pobre chica. ¿Cómo ha ido?"
    mom "Dem armen Mädchen wird der Kopf explodieren. Wie ist es ausgegangen?"

# game/scripts/c16/c16.rpy:2772
translate german c16s003_LunchWithEva_87f4593a:

    # mc "Muy bien. Me ha enseñado a disparar... un poco. Y hemos estado charlando. Ya te contaré. Ha tenido una infancia... diferente."
    mc "Sehr gut. Er hat mir das Schießen beigebracht … ein bisschen. Und wir haben uns unterhalten. Ich erzähle dir später davon. Er hatte eine … etwas andere Kindheit."

# game/scripts/c16/c16.rpy:2774
translate german c16s003_LunchWithEva_70b91aa6:

    # mom "¿Por qué no te vas a cambiar? No vas a comer con la ropa de correr, ¿verdad?"
    mom "Warum ziehst du dich nicht um? Du willst doch nicht in deinen Laufklamotten essen, oder?"

# game/scripts/c16/c16.rpy:2775
translate german c16s003_LunchWithEva_0807a31c:

    # mc "¿Quieres que la deje sola con vosotras? Piensa que yo tengo que subir más días al lago con ella y su venganza puede ser cruél. *Risa*"
    mc "Soll ich sie mit dir allein lassen? Denk daran, dass ich noch einige Tage mit ihr zum See fahren muss und ihre Rache grausam ausfallen könnte. *lacht*"

# game/scripts/c16/c16.rpy:2777
translate german c16s003_LunchWithEva_389258af:

    # mom "No somos tan malas. *Risa* Abrumadoras sí, pero malas no. Además, apestas un poco."
    mom "So schlimm sind wir gar nicht. *lacht* Überwältigend, ja, aber nicht schlecht. Außerdem bist du ziemlich mies."

# game/scripts/c16/c16.rpy:2778
translate german c16s003_LunchWithEva_9af0ee6f:

    # mc "Vale, voy a darme una ducha rápida y ahora vuelvo. *Risa*"
    mc "Okay, ich gehe kurz duschen und bin gleich wieder da. *lacht*"

# game/scripts/c16/c16.rpy:2781
translate german c16s003_LunchWithEva_75866e1d:

    # mom "*Susurrando* Por cierto, he dejado mi... *Susurrando más aún* prueba de embarazo... en tu habitación, en el armario grande. Ahí estará más segura."
    mom "*Flüsternd* Übrigens, ich habe meinen... *Noch leiser flüsternd* Schwangerschaftstest... in deinem Zimmer im großen Schrank gelassen. Dort ist er sicherer."

# game/scripts/c16/c16.rpy:2783
translate german c16s003_LunchWithEva_4f5334ff:

    # mom "*Susurrando* [nor] me ha dicho que [dap] casi la encuentra esta mañana mientras buscaba un top que ponerse. ¡Como que [dap] iba a llenar un top de [nor]!"
    mom "*flüsternd* [nor] erzählte mir, dass [dap] ihr heute Morgen beinahe über den Weg gelaufen wäre, als sie nach einem Oberteil suchte. Als ob [dap] ein Oberteil mit [nor] füllen wollte!"

# game/scripts/c16/c16.rpy:2785
translate german c16s003_LunchWithEva_ebbd1574:

    # mom "*Susurrando* [emm] casi la encuentra esta mañana mientras buscaba algo que ponerse en mi armario."
    mom "*Flüsternd* [emm] Ich hätte es heute Morgen fast gefunden, als ich in meinem Kleiderschrank nach etwas zum Anziehen gesucht habe."

# game/scripts/c16/c16.rpy:2786
translate german c16s003_LunchWithEva_dd23c706:

    # mc "*Susurrando* Perfecto, [mar.mc!t]. En mi armario nadie va a buscar nada. Cuando llegue la hora sube y lo comprobamos."
    mc "*Flüsternd* Perfekt, [mar.mc!t]. Niemand wird in meinen Kleiderschrank schauen. Wenn es soweit ist, komm hoch, dann sehen wir nach."

# game/scripts/c16/c16.rpy:2787
translate german c16s003_LunchWithEva_049594b2:

    # mc "Voy a darme esa ducha antes de que me dejen sin comida. *Risa* Voy a decírselo a Eva."
    mc "Ich werde noch schnell duschen, bevor sie mich ohne Essen zurücklassen. *lacht* Ich werde es Eva erzählen."

# game/scripts/c16/c16.rpy:2789
translate german c16s003_LunchWithEva_2ad7dba9:

    # mc "Eva, ¿puedo hablar un momento contigo?"
    mc "Eva, kann ich dich kurz sprechen?"

# game/scripts/c16/c16.rpy:2790
translate german c16s003_LunchWithEva_b3661827:

    # emm "¡No puedes llevártela ahora! ¡Acaba de llegar!"
    emm "Du kannst es jetzt nicht nehmen! Es ist gerade erst angekommen!"

# game/scripts/c16/c16.rpy:2791
translate german c16s003_LunchWithEva_db315a44:

    # eri "Ha dicho que es un momento, [emm]."
    eri "Er sagte, es sei ein Moment, [emm]."

# game/scripts/c16/c16.rpy:2792
translate german c16s003_LunchWithEva_07a7b5da:

    # dap "Nos la devuelves en seguida, ¿verdad?"
    dap "Sie geben es uns sofort zurück, richtig?"

# game/scripts/c16/c16.rpy:2793
translate german c16s003_LunchWithEva_40e50bb5:

    # eva "Ahora vuelvo, chicas. No voy a dejar que me secuestre. *Risita*"
    eva "Ich bin gleich wieder da, Mädels. Ich lasse mich nicht von ihm entführen. *Kichert*"

# game/scripts/c16/c16.rpy:2795
translate german c16s003_LunchWithEva_c0579bb2:

    # eva "Dime."
    eva "Sag mir."

# game/scripts/c16/c16.rpy:2796
translate german c16s003_LunchWithEva_feab26bb:

    # mc "¿Cómo lo llevas? ¿Te estamos agobiando mucho?"
    mc "Wie kommen Sie damit zurecht? Sind Sie überfordert?"

# game/scripts/c16/c16.rpy:2797
translate german c16s003_LunchWithEva_c9f22343:

    # eva "Más que agobiando, abrumando un poco. Pero todo está bien. Raro, pero bien."
    eva "Es ist mehr als überwältigend, es wirkt auch ein wenig beängstigend. Aber alles ist gut. Seltsam, aber gut."

# game/scripts/c16/c16.rpy:2798
translate german c16s003_LunchWithEva_fda0182f:

    # mc "Voy a dejarte un momento en sus manos. Me acaban de decir que apesto un poco y voy a darme una ducha y a cambiarme."
    mc "Ich überlasse dich jetzt kurz ihnen. Mir wurde gerade gesagt, ich rieche etwas unangenehm, deshalb gehe ich duschen und ziehe mich um."

# game/scripts/c16/c16.rpy:2800
translate german c16s003_LunchWithEva_9401856e:

    # eva "¿No vas a quedarte a comer?"
    eva "Bleibst du nicht zum Mittagessen?"

# game/scripts/c16/c16.rpy:2801
translate german c16s003_LunchWithEva_8dd9ea08:

    # mc "Sí, va a ser una ducha rápida y vuelvo en un momento. ¿Estarás bien?"
    mc "Ja, ich dusche nur kurz und bin gleich wieder da. Geht es dir gut?"

# game/scripts/c16/c16.rpy:2803
translate german c16s003_LunchWithEva_d97b00b1:

    # eva "C-creo que sí... creo que estaba más preocupada de lo necesario."
    eva "Ich glaube schon... Ich glaube, ich habe mir mehr Sorgen gemacht als nötig."

# game/scripts/c16/c16.rpy:2804
translate german c16s003_LunchWithEva_b7c8d2a4:

    # mc "Si necesitas algún plan de extracción, habla con [mar] o [nor]. Ellas te ayudarán."
    mc "Falls Sie einen Extraktionsplan benötigen, wenden Sie sich bitte an [mar] oder [nor]. Man wird Ihnen dort weiterhelfen."

# game/scripts/c16/c16.rpy:2806
translate german c16s003_LunchWithEva_ca7d62e0:

    # eva "¡Gracias!"
    eva "Danke schön!"

# game/scripts/c16/c16.rpy:2807
translate german c16s003_LunchWithEva_7b1f4816:

    # mc "¡Hey! ¿A qué viene ese abrazo?"
    mc "Hey! Was soll diese Umarmung?"

# game/scripts/c16/c16.rpy:2809
translate german c16s003_LunchWithEva_92824df2:

    # eva "Costumbres familiares, dijiste. Me pone triste haber sido tan tonta. Haberte prejuzgado..."
    eva "„Familienbräuche“, sagtest du. Es macht mich traurig, dass ich so töricht war. Dass ich dich so hart verurteilt habe…"

# game/scripts/c16/c16.rpy:2810
translate german c16s003_LunchWithEva_176fdc2a:

    # eva "No eres manipulador, solo un idiota que no sabe que no debe preocuparse tanto por las chicas de la familia. Sabemos... saben cuidarse solas."
    eva "Du bist nicht manipulativ, du bist einfach nur ein Idiot, der nicht merkt, dass er sich nicht so viele Sorgen um die Mädchen in der Familie machen sollte. Wir wissen doch, dass sie auf sich selbst aufpassen können."

# game/scripts/c16/c16.rpy:2811
translate german c16s003_LunchWithEva_fca1fa8c:

    # mc "¿Acabas de decir \"sabemos\"? *Risa*"
    mc "Hast du gerade „wir wissen“ gesagt? *lacht*"

# game/scripts/c16/c16.rpy:2813
translate german c16s003_LunchWithEva_92380e41:

    # eva "¡Joder! Hacéis muy difícil no sentirse aceptada. Me han dicho \"bienvenida a la familia\" quince veces en cinco minutos."
    eva "Verdammt! Ihr macht es einem echt schwer, sich nicht akzeptiert zu fühlen. Ich habe in fünf Minuten fünfzehn Mal „Willkommen in der Familie“ gehört."

# game/scripts/c16/c16.rpy:2814
translate german c16s003_LunchWithEva_e0f693e3:

    # mc "Ya te lo dije. Ahora solo hace falta que te lo termines de creer."
    mc "Ich hab's dir doch schon gesagt. Jetzt musst du es nur noch glauben."

# game/scripts/c16/c16.rpy:2816
translate german c16s003_LunchWithEva_3babefea:

    # "Eva te abraza un poco más fuerte durante un segundo, apoyando su cabeza contra tu cuello."
    "Eva drückt dich einen Moment lang etwas fester an sich und legt ihren Kopf an deinen Hals."

# game/scripts/c16/c16.rpy:2817
translate german c16s003_LunchWithEva_77a2abd6:

    # eva "Bueno, vete ya. Al final tu peste se me va a pegar a la ropa."
    eva "Okay, verschwinde jetzt. Dein Gestank wird sich noch in meiner Kleidung festsetzen."

# game/scripts/c16/c16.rpy:2818
translate german c16s003_LunchWithEva_ff158c35:

    # mc "Bonita forma de decir que prefieres estar con las chicas a estar conmigo. *Risa*"
    mc "Eine nette Umschreibung dafür, dass du lieber mit den Mädels zusammen wärst als mit mir. *lacht*"

# game/scripts/c16/c16.rpy:2819
translate german c16s003_LunchWithEva_241ddbc7:

    # mc "Vuelvo en un rato. No dejes que te agobien demasiado."
    mc "Ich bin gleich wieder da. Lass dich nicht zu sehr von ihnen überwältigen."

# game/scripts/c16/c16.rpy:2821
translate german c16s003_LunchWithEva_7fabacc8:

    # mc "Hola, Saira. Hola, Kate. ¿Habéis comido ya?"
    mc "Hallo Saira. Hallo Kate. Habt ihr schon gegessen?"

# game/scripts/c16/c16.rpy:2822
translate german c16s003_LunchWithEva_5b29a970:

    # sai "Sí, Lisa y Kim tenían clase esta tarde y hemos comido todas juntas antes de que se fueran."
    sai "Ja, Lisa und Kim hatten heute Nachmittag Unterricht und wir haben alle zusammen gegessen, bevor sie gegangen sind."

# game/scripts/c16/c16.rpy:2823
translate german c16s003_LunchWithEva_5c9c51b9:

    # kat "Después de tener La Conversación. Por cierto, una oportunidad perdida de llamarla... *Voz profunda* \"La Clonversación\". *Risa*"
    kat "Nach dem Gespräch. Übrigens, eine verpasste Gelegenheit, es... *Tiefe Stimme* „Das Klongespräch“ zu nennen. *Lacht*"

# game/scripts/c16/c16.rpy:2824
translate german c16s003_LunchWithEva_5e013d06:

    # mc "*Risa* No se me había ocurrido"
    mc "*lacht* Daran hatte ich gar nicht gedacht."

# game/scripts/c16/c16.rpy:2825
translate german c16s003_LunchWithEva_3df6fa10:

    # mc "¿No vais a ir a la comida con Eva?"
    mc "Gehst du nicht mit Eva zum Mittagessen?"

# game/scripts/c16/c16.rpy:2827
translate german c16s003_LunchWithEva_a194e8af:

    # kat "[mar] nos ha dicho que fuéramos, pero hemos pensado que era mejor dejaros un rato en familia. Pasaremos luego a conocerla."
    kat "[mar] hat uns gebeten zu kommen, aber wir dachten, es wäre besser, dich erst einmal bei deiner Familie zu lassen. Wir kommen später, um sie zu treffen."

# game/scripts/c16/c16.rpy:2828
translate german c16s003_LunchWithEva_5f367032:

    # sai "Y tú deberías estar allí, ¿no?"
    sai "Und du solltest dort sein, nicht wahr?"

# game/scripts/c16/c16.rpy:2829
translate german c16s003_LunchWithEva_98e156c0:

    # mc "Voy a ducharme y a cambiarme."
    mc "Ich werde duschen und mich umziehen."

# game/scripts/c16/c16.rpy:2831
translate german c16s003_LunchWithEva_85b0831c:

    # sai "No te entretenemos más entonces. Por cierto, buenos días."
    sai "Dann halten wir Sie nicht länger auf. Übrigens, guten Morgen."

# game/scripts/c16/c16.rpy:2832
translate german c16s003_LunchWithEva_35324926:

    # mc "Buenos días, Saira. *Risa*"
    mc "Guten Morgen, Saira. *lacht*"

# game/scripts/c16/c16.rpy:2833
translate german c16s003_LunchWithEva_3e841c14:

    # mc "Luego tengo que hablar contigo."
    mc "Ich muss später mit dir sprechen."

# game/scripts/c16/c16.rpy:2834
translate german c16s003_LunchWithEva_ea965c45:

    # sai "OK."
    sai "OK."

# game/scripts/c16/c16.rpy:2837
translate german c16s003_LunchWithEva_741044eb:

    # kat "Buenos días, [mc]."
    kat "Guten Morgen, [mc]."

# game/scripts/c16/c16.rpy:2838
translate german c16s003_LunchWithEva_f5d23c52:

    # mc "Buenos días, Kate."
    mc "Guten Morgen, Kate."

# game/scripts/c16/c16.rpy:2840
translate german c16s003_LunchWithEva_d4eeb63f:

    # kat "Vete a duchar antes de que nos aromatizes la planta con Eau de Sobac. *Risa* ¡Apestas!"
    kat "Geh duschen, bevor du die Pflanze mit Eau de Sobac besprühst. *Lacht* Du stinkst!"

# game/scripts/c16/c16.rpy:2841
translate german c16s003_LunchWithEva_597d90d7:

    # sai "¡Es verdad! *Risa* Yo notaba un olor conocido y no lo localizaba."
    sai "Ganz genau! *lacht* Mir ist ein bekannter Geruch aufgefallen, aber ich konnte ihn nicht zuordnen."

# game/scripts/c16/c16.rpy:2842
translate german c16s003_LunchWithEva_74cf13bd:

    # mc "A lo mejor es por la costumbre de Kate de ir descalza. *Risa* Eau de Rochefort."
    mc "Vielleicht liegt es an Kates Angewohnheit, barfuß zu laufen. *lacht* Eau de Rochefort."

# game/scripts/c16/c16.rpy:2843
translate german c16s003_LunchWithEva_4c4d2b0d:

    # mc "Me voy antes de que empecéis a deprimirme. *Risa*"
    mc "Ich gehe jetzt, bevor ihr mich alle deprimiert. *lacht*"

# game/scripts/c16/c16.rpy:2845
translate german c16s003_LunchWithEva_4923eed1:

    # "Vuelves a la cocina de [nor] después de ducharte y, tal como te imaginabas, Eva es el centro de atención de las chicas. Las mujeres se mantienen apartadas, hablando entre ellas."
    "Du kehrst nach dem Duschen in die Küche von [nor] zurück und, wie erwartet, steht Eva im Mittelpunkt der Aufmerksamkeit der Mädchen. Die Frauen unterhalten sich angeregt untereinander."

# game/scripts/c16/c16.rpy:2846
translate german c16s003_LunchWithEva_6e78f223:

    # eva "... y entonces Amanda me avisó por radio y..."
    eva "...und dann funkte Amanda mich an und..."

# game/scripts/c16/c16.rpy:2848
translate german c16s003_LunchWithEva_ad2c1764:

    # eva "Ya ha vuelto la mofeta. *Risa*"
    eva "Das Stinktier ist wieder da. *Gelächter*"

# game/scripts/c16/c16.rpy:2849
translate german c16s003_LunchWithEva_b3b94564:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c16/c16.rpy:2850
translate german c16s003_LunchWithEva_c0c00b97:

    # mc "Parece que ya te estás integrando en la familia. *Risa* El deporte familiar es reírse de mí."
    mc "Du scheinst dich ja schon gut in der Familie eingelebt zu haben. *lacht* Der Familiensport lacht mich aus."

# game/scripts/c16/c16.rpy:2851
translate german c16s003_LunchWithEva_c8490af3:

    # emm "Porque te lo mereces. Siempre haces algo para que nos riamos contigo y de ti."
    emm "Weil du es verdienst. Du bringst uns immer wieder zum Lachen – sowohl mit als auch über dich."

# game/scripts/c16/c16.rpy:2852
translate german c16s003_LunchWithEva_220d4b3f:

    # eri "No como tú, ¿verdad, [emm]? *Risa*"
    eri "Ganz anders als du, oder, [emm]? *lacht*"

# game/scripts/c16/c16.rpy:2853
translate german c16s003_LunchWithEva_f758be34:

    # dap "Al menos él lo suele hacer a propósito. *Risa*"
    dap "Zumindest macht er es meistens absichtlich. *lacht*"

# game/scripts/c16/c16.rpy:2854
translate german c16s003_LunchWithEva_46ca4104:

    # sca "*Risa* Y nadie le suele prohibir ningún color."
    sca "*Gelächter* Und normalerweise verbietet ihm niemand irgendeine Farbe."

# game/scripts/c16/c16.rpy:2856
translate german c16s003_LunchWithEva_13a76ecd:

    # emm "Ni siquiera en mi cumpleaños me vais a dejar tranquila, ¿verdad?"
    emm "Du lässt mich nicht einmal an meinem Geburtstag in Ruhe, oder?"

# game/scripts/c16/c16.rpy:2857
translate german c16s003_LunchWithEva_962e612f:

    # mc "Elige. No nos reímos de ti hoy o el domingo."
    mc "Entscheide dich. Wir werden dich weder heute noch am Sonntag auslachen."

# game/scripts/c16/c16.rpy:2858
translate german c16s003_LunchWithEva_e64c798e:

    # emm "*Gruñido* El domingo. Es el cumpleaños de verdad."
    emm "*Grunzen* Sonntag. Das ist der wahre Geburtstag."

# game/scripts/c16/c16.rpy:2859
translate german c16s003_LunchWithEva_b3b94564_1:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c16/c16.rpy:2861
translate german c16s003_LunchWithEva_8024e8af:

    # mom "Ve a comer algo. Es tarde y todo el mundo estaba hambriento. Si [nor] y yo no llegamos a intervenir no te hubieran dejado nada."
    mom "Geh und iss etwas. Es ist spät und alle hatten Hunger. Wenn [nor] und ich nicht eingegriffen hätten, hätten sie dir nichts übrig gelassen."

# game/scripts/c16/c16.rpy:2862
translate german c16s003_LunchWithEva_a935706d:

    # mc "Gracias, [mar.mc!t]."
    mc "Danke, [mar.mc!t]."

# game/scripts/c16/c16.rpy:2863
translate german c16s003_LunchWithEva_5f6e293a:

    # mom "Te he dejado un plato con pato, salmon, rollitos, carne con gambas, y falafel al lado del fregadero. No sabíamos que le gustaría a Eva."
    mom "Ich habe einen Teller mit Ente, Lachs, Frühlingsrollen, Rindfleisch mit Garnelen und Falafel neben die Spüle gestellt. Wir wussten nicht, was Eva mögen würde."

# game/scripts/c16/c16.rpy:2865
translate german c16s003_LunchWithEva_0678140b:

    # "Ver esta reunión y cómo Eva se siente más cómoda de lo que nunca hubiera pensado te llena de alegría de alguna forma."
    "Zu sehen, wie sich Eva bei diesem Treffen wohler fühlt, als sie es je für möglich gehalten hätte, erfüllt einen auf gewisse Weise mit Freude."

# game/scripts/c16/c16.rpy:2866
translate german c16s003_LunchWithEva_91a4b366:

    # "Después de lo que ha contado sobre su infancia... sí, como diría ella, te sientes como un idiota con ganas de protegerla."
    "Nach dem, was sie über ihre Kindheit erzählt hat... ja, wie sie selbst sagen würde, fühlt man sich wie ein Idiot, wenn man sie beschützen will."

# game/scripts/c16/c16.rpy:2869
translate german c16s003_LunchWithEva_2516780d:

    # "Proteger. A Eva. La protectora. Quizás la tengas que proteger de cosas que ni siquiera sabe que existen. De las amenazas de una vida normal."
    "Beschütze. Eva. Die Beschützerin. Vielleicht musst du sie vor Dingen beschützen, von denen sie gar nichts ahnt. Vor den Gefahren eines normalen Lebens."

# game/scripts/c16/c16.rpy:2871
translate german c16s003_LunchWithEva_be289a5c:

    # eri "Es especial, ¿verdad?"
    eri "Es ist etwas Besonderes, nicht wahr?"

# game/scripts/c16/c16.rpy:2873
translate german c16s003_LunchWithEva_a18e2524:

    # mc "¡Oh, [eri]! No te había visto. Estaba inmerso en mis pensamientos."
    mc "Oh, [eri]! Ich hatte dich gar nicht gesehen. Ich war in Gedanken versunken."

# game/scripts/c16/c16.rpy:2874
translate german c16s003_LunchWithEva_bbad04e8:

    # mc "Sí, lo es. Ha tenido una vida tan diferente de lo que estamos acostumbrados que llamarla especial es quedarse corto."
    mc "Ja, das ist sie. Ihr Leben hat sich so sehr von dem unterschieden, was wir gewohnt sind, dass es eine Untertreibung wäre, sie als etwas Besonderes zu bezeichnen."

# game/scripts/c16/c16.rpy:2875
translate german c16s003_LunchWithEva_81778c0a:

    # eri "Cuando te has ido parecía un animalillo acorralado. Hasta que mi madre le ha dado un abrazo y..."
    eri "Als du gegangen bist, sah er aus wie ein in die Enge getriebenes kleines Tier. Bis meine Mutter ihn umarmte und..."

# game/scripts/c16/c16.rpy:2878
translate german c16s003_LunchWithEva_a3f86bb8:

    # eri "Hasta cierto punto también es su madre, ¿no?"
    eri "In gewisser Hinsicht ist sie doch auch seine Mutter, nicht wahr?"

# game/scripts/c16/c16.rpy:2880
translate german c16s003_LunchWithEva_3c9b0d23:

    # eri "Mi madre..."
    eri "Meine Mutter..."

# game/scripts/c16/c16.rpy:2881
translate german c16s003_LunchWithEva_213694ad:

    # mc "¿Cómo ha ido La Conversación?"
    mc "Wie verlief das Gespräch?"

# game/scripts/c16/c16.rpy:2883
translate german c16s003_LunchWithEva_8f8ae0f8:

    # eri "Aún la estoy asimilando. No sé como sentirme..."
    eri "Ich verarbeite das noch. Ich weiß nicht, was ich davon halten soll..."

# game/scripts/c16/c16.rpy:2885
translate german c16s003_LunchWithEva_9c448045:

    # eri "Saber que tengo una segunda gemela... y que perdí dos por el camino a quien nunca conoceré... es raro... y duro..."
    eri "Zu wissen, dass ich einen zweiten Zwilling habe... und dass ich auf dem Weg zwei verloren habe, die ich nie kennenlernen werde... ist seltsam... und schwer..."

# game/scripts/c16/c16.rpy:2886
translate german c16s003_LunchWithEva_c102ed34:

    # eri "El mismo día que gano una hermana me entero que he perdido a dos."
    eri "Am selben Tag, an dem ich eine Schwester dazugewinne, erfahre ich, dass ich zwei verloren habe."

# game/scripts/c16/c16.rpy:2888
translate german c16s003_LunchWithEva_37872221:

    # eri "Pero he ganado una hermana y ganaré una prima esta noche. No me puedo quejar demasiado... ¿verdad?"
    eri "Aber ich habe eine Schwester dazugewonnen und bekomme heute Abend noch eine Cousine. Ich kann mich also nicht groß beschweren... oder?"

# game/scripts/c16/c16.rpy:2890
translate german c16s003_LunchWithEva_3bb3cddf:

    # eri "Saber que mi madre no es mi madre biológica... que no tengo madre biológica... es raro... y duro..."
    eri "Zu wissen, dass meine Mutter nicht meine leibliche Mutter ist... dass ich keine leibliche Mutter habe... ist seltsam... und schwer..."

# game/scripts/c16/c16.rpy:2891
translate german c16s003_LunchWithEva_ea86602e:

    # eri "Mi madre siempre será mi madre. No importa que no lleve sus genes... pero es difícil de asimilar."
    eri "Meine Mutter wird immer meine Mutter bleiben. Es spielt keine Rolle, dass ich ihre Gene nicht in mir trage... aber es ist schwer zu akzeptieren."

# game/scripts/c16/c16.rpy:2893
translate german c16s003_LunchWithEva_d0630f8b:

    # eri "Pero he ganado una hermana y no pienso perder a mi madre, con lo que, en el fondo, no me puedo quejar demasiado... ¿verdad?"
    eri "Aber ich habe eine Schwester dazugewonnen und ich habe nicht vor, meine Mutter zu verlieren, also kann ich mich im Grunde nicht allzu sehr beschweren... oder?"

# game/scripts/c16/c16.rpy:2894
translate german c16s003_LunchWithEva_5148d458:

    # mc "¿Un abrazo?"
    mc "Eine Umarmung?"

# game/scripts/c16/c16.rpy:2895
translate german c16s003_LunchWithEva_389e215f:

    # eri "Sí, por favor..."
    eri "Ja, bitte..."

# game/scripts/c16/c16.rpy:2897
translate german c16s003_LunchWithEva_d24d96d7:

    # "Os abrazáis en silencio durante unos minutos. Conoces lo suficientemente bien a [eri] como para saber que solo necesita el abrazo. No necesita, no quiere, que hables en ese momento."
    "Ihr umarmt euch einige Minuten lang schweigend. Du kennst [eri] gut genug, um zu wissen, dass sie nur die Umarmung braucht. Sie braucht und will in diesem Moment nicht, dass du redest."

# game/scripts/c16/c16.rpy:2899
translate german c16s003_LunchWithEva_d4bc4005:

    # eri "Ya está, gracias..."
    eri "Das war's, danke..."

# game/scripts/c16/c16.rpy:2900
translate german c16s003_LunchWithEva_03bcbd68:

    # mc "Ya sabes que me encanta abrazarte. No deberías dar las gracias por ello."
    mc "Du weißt doch, dass ich dich so gerne umarme. Dafür brauchst du mir nicht zu danken."

# game/scripts/c16/c16.rpy:2903
translate german c16s003_LunchWithEva_baba7214:

    # eri "El día que no le de las gracias a mi novio por un abrazo..."
    eri "Der Tag, an dem ich meinem Freund nicht für eine Umarmung danke..."

# game/scripts/c16/c16.rpy:2904
translate german c16s003_LunchWithEva_14ded962:

    # eri "Hablando de novios... mi madre me ha hablado de las pruebas de embarazo. Me gustaría hacérmela."
    eri "Wo wir gerade von Freunden sprechen … meine Mutter hat mir von Schwangerschaftstests erzählt. Ich würde gern einen machen."

# game/scripts/c16/c16.rpy:2905
translate german c16s003_LunchWithEva_82f87563:

    # mc "Las tengo en mi habitación. Después de comer si quieres vamos a hacerla, y mañana sabremos el resultado."
    mc "Ich habe sie in meinem Zimmer. Nach dem Mittagessen können wir sie zubereiten, wenn du magst, und wir erfahren morgen das Ergebnis."

# game/scripts/c16/c16.rpy:2906
translate german c16s003_LunchWithEva_13ff2faa:

    # mc "¿Has notado algún síntoma?"
    mc "Haben Sie irgendwelche Symptome bemerkt?"

# game/scripts/c16/c16.rpy:2908
translate german c16s003_LunchWithEva_a4814f99:

    # eri "No, pero me gustaría saber si mi novio me ha dejado embarazada el mismo día que me desvirgó. *Risita*"
    eri "Nein, aber ich würde gern wissen, ob mein Freund mich am selben Tag geschwängert hat, an dem er mich entjungfert hat. *Kichert*"

# game/scripts/c16/c16.rpy:2909
translate german c16s003_LunchWithEva_df33eba7:

    # mc "A mí también me gustaría. Eso sería casi un record, ¿no?"
    mc "Das würde mir auch gefallen. Das wäre ein beachtlicher Rekord, nicht wahr?"

# game/scripts/c16/c16.rpy:2910
translate german c16s003_LunchWithEva_6e5dd189:

    # eri "Entonces, cuando acabe la comida te secuestro y vamos a tu habitación. A solas."
    eri "Und wenn wir mit dem Essen fertig sind, werde ich dich entführen und wir gehen in dein Zimmer. Allein."

# game/scripts/c16/c16.rpy:2911
translate german c16s003_LunchWithEva_ebffbfc7:

    # eri "Ahora voy ir al lavabo y a volver con Eva antes de que [emm] le pregunte a cuanta gente ha matado. Hasta ahora, cielo."
    eri "Ich gehe jetzt aufs Klo und bin wieder bei Eva, bevor [emm] sie fragt, wie viele Leute sie umgebracht hat. Bis später, Schatz."

# game/scripts/c16/c16.rpy:2912
translate german c16s003_LunchWithEva_a84b9718:

    # mc "Hasta ahora, mi amor."
    mc "Bis jetzt, meine Liebe."

# game/scripts/c16/c16.rpy:2915
translate german c16s003_LunchWithEva_2d375889:

    # eri "Debería ir al lavabo y volver con Eva antes de que [emm] le pregunte a cuanta gente ha matado."
    eri "Ich sollte auf die Toilette gehen und zu Eva zurückkommen, bevor [emm] sie fragt, wie viele Menschen sie getötet hat."

# game/scripts/c16/c16.rpy:2916
translate german c16s003_LunchWithEva_f16f0b17:

    # mc "Hasta ahora, [eri]."
    mc "Bis jetzt, [eri]."

# game/scripts/c16/c16.rpy:2919
translate german c16s003_LunchWithEva_d27faf05:

    # "Continúas comiendo mientras observas como se va desarrollando la reunión. Al cabo de un rato, [dap] y Scarlett se dirigen hacia ti."
    "Du isst weiter, während du das Geschehen beobachtest. Nach einer Weile kommen [dap] und Scarlett auf dich zu."

# game/scripts/c16/c16.rpy:2922
translate german c16s003_LunchWithEva_525cc9aa:

    # mc "¿Qué tal, chicas?"
    mc "Hey Mädels!"

# game/scripts/c16/c16.rpy:2923
translate german c16s003_LunchWithEva_790aa11e:

    # dap "Bien, Eva es fantástica."
    dap "Nun ja, Eva ist fantastisch."

# game/scripts/c16/c16.rpy:2924
translate german c16s003_LunchWithEva_5fd4bf20:

    # sca "Es muy divertida. Y tiene fijación en hacer bromas sobre ti."
    sca "Sie ist sehr witzig. Und sie macht ständig Witze über dich."

# game/scripts/c16/c16.rpy:2925
translate german c16s003_LunchWithEva_a83f03fe:

    # dap "Nos ha explicado tu cacería del topo en las lecciones de hoy. *Risa*"
    dap "Er hat uns heute im Unterricht von eurer Maulwurfssuche erzählt. *lacht*"

# game/scripts/c16/c16.rpy:2926
translate german c16s003_LunchWithEva_47633bb5:

    # mc "Y, aparte de eso..."
    mc "Und abgesehen davon..."

# game/scripts/c16/c16.rpy:2928
translate german c16s003_LunchWithEva_3fbff912:

    # dap "Aparte de eso... quiero ir a Aruba."
    dap "Abgesehen davon... möchte ich nach Aruba reisen."

# game/scripts/c16/c16.rpy:2929
translate german c16s003_LunchWithEva_ce705018:

    # mc "¿Qué? ¿Por qué?"
    mc "Was? Warum?"

# game/scripts/c16/c16.rpy:2930
translate german c16s003_LunchWithEva_f25d7f31:

    # dap "Bueno, ahora soy accionista de una empresa de tecnología punta. Quiero aprender todo lo posible sobre como funciona."
    dap "Nun bin ich Anteilseigner eines innovativen Technologieunternehmens. Ich möchte alles darüber lernen, wie es funktioniert."

# game/scripts/c16/c16.rpy:2931
translate german c16s003_LunchWithEva_1a25afb3:

    # dap "Incluso trabajar en NTR cuando acabe la carrera."
    dap "Ich werde sogar bei NTR arbeiten, wenn ich mein Studium abgeschlossen habe."

# game/scripts/c16/c16.rpy:2933
translate german c16s003_LunchWithEva_71d808a4:

    # sca "A mí tampoco me importaría trabajar allí. Me encanta la medicina, pero no sé si estoy hecha para tratar con pacientes."
    sca "Ich würde dort auch gerne arbeiten. Ich liebe die Medizin, aber ich weiß nicht, ob ich für den Umgang mit Patienten geeignet bin."

# game/scripts/c16/c16.rpy:2934
translate german c16s003_LunchWithEva_4a04d38c:

    # sca "Espero que me contratéis para hacer investigación médica."
    sca "Ich hoffe, Sie werden mich für medizinische Forschungsarbeiten einstellen."

# game/scripts/c16/c16.rpy:2935
translate german c16s003_LunchWithEva_2be33e05:

    # mc "Chicas, esperad. Acabáis de enteraros que NTR existe y ya estáis pensando en cambiar vuestros planes de futuro."
    mc "Mädels, wartet mal. Ihr habt gerade erst erfahren, dass es NTR gibt, und denkt schon darüber nach, eure Zukunftspläne zu ändern."

# game/scripts/c16/c16.rpy:2937
translate german c16s003_LunchWithEva_0e2731a9:

    # dap "Es lógico hacerlo. Las circunstancias han cambiado y es una oportunidad increíble."
    dap "Es macht Sinn, es zu tun. Die Umstände haben sich geändert, und es ist eine unglaubliche Gelegenheit."

# game/scripts/c16/c16.rpy:2938
translate german c16s003_LunchWithEva_681ec9ba:

    # sca "No es cambiar los planes, sino adaptarlos a la nueva realidad. Clonación, nuevos dispositivos médicos... es el sueño de cualquier investigador."
    sca "Es geht nicht darum, die Pläne zu ändern, sondern sie an die neue Realität anzupassen. Klonen, neue medizinische Geräte … davon träumt jeder Forscher."

# game/scripts/c16/c16.rpy:2939
translate german c16s003_LunchWithEva_7b9baae8:

    # dap "Y una legislación que no pone demasiados impedimentos." (multiple=2)
    dap "Und eine Gesetzgebung, die nicht zu viele Hindernisse in den Weg legt." (multiple=2)

# game/scripts/c16/c16.rpy:2940
translate german c16s003_LunchWithEva_37efe932:

    # sca "En un pais donde todo eso es legal." (multiple=2)
    sca "In einem Land, in dem all das legal ist." (multiple=2)

# game/scripts/c16/c16.rpy:2941
translate german c16s003_LunchWithEva_46a6680d:

    # mc "Por suerte os quedan años para acabar vuestras carreras... aún os quedan meses para empezarla..."
    mc "Zum Glück haben Sie noch Jahre Zeit, Ihr Studium abzuschließen... Sie haben noch Monate Zeit, um Ihres zu beginnen..."

# game/scripts/c16/c16.rpy:2942
translate german c16s003_LunchWithEva_a071d4be:

    # mc "Aparte de eso, ¿como ha ido La Conversación?"
    mc "Abgesehen davon, wie läuft das Gespräch bisher?"

# game/scripts/c16/c16.rpy:2944
translate german c16s003_LunchWithEva_c31717ed:

    # dap "Ha sido extraño. Saber que mi madre... y el resto... nos habéis ocultado algo tan importante como esto..."
    dap "Es war seltsam. Zu wissen, dass meine Mutter... und ihr alle... uns etwas so Wichtiges wie dieses verschwiegen habt..."

# game/scripts/c16/c16.rpy:2947
translate german c16s003_LunchWithEva_a4c92c6a:

    # dap "Una empresa de tecnología punta, clonación, espionaje, secuestros... ¡Me encanta! Pero me hubiera gustado saberlo antes."
    dap "Eine Firma, die sich auf Spitzentechnologie, Klonen, Spionage, Entführungen spezialisiert hat... Ich liebe es! Aber ich wünschte, ich hätte früher davon gewusst."

# game/scripts/c16/c16.rpy:2949
translate german c16s003_LunchWithEva_dbe632d6:

    # dap "Creía que [eri] y yo éramos adoptadas. Ahora resulta que somos clones de Eva. ¡Mola mucho más!"
    dap "Ich dachte, [eri] und ich wären adoptiert. Jetzt stellt sich heraus, dass wir Klone von Eve sind. Das ist ja viel cooler!"

# game/scripts/c16/c16.rpy:2950
translate german c16s003_LunchWithEva_1cc99e46:

    # dap "Y tener a Eva delante es como mirarse en un espejo. Un espejo más musculoso de lo que yo nunca seré, pero un espejo."
    dap "Und Eva vor mir zu haben, ist wie in einen Spiegel zu schauen. Ein Spiegel, der muskulöser ist, als ich es je sein werde, aber dennoch ein Spiegel."

# game/scripts/c16/c16.rpy:2952
translate german c16s003_LunchWithEva_0b68b1b2:

    # dap "Sé que los genes no tienen nada que ver en cómo somos, aparte de físicamente, pero llevo toda la comida estudiándola esperando que reaccione de una forma... o ponga una expresión..."
    dap "Ich weiß, dass Gene, abgesehen von unserem Aussehen, nichts mit unserem Wesen zu tun haben, aber ich habe meine ganze Zeit damit verbracht, Lebensmittel zu studieren, in der Hoffnung, dass sie auf eine bestimmte Weise reagieren oder einen bestimmten Gesichtsausdruck hervorrufen..."

# game/scripts/c16/c16.rpy:2953
translate german c16s003_LunchWithEva_4006a498:

    # dap "Y la mayoría de veces actúa de una forma distinta de como lo haría yo."
    dap "Und meistens verhält er sich anders, als ich es tun würde."

# game/scripts/c16/c16.rpy:2955
translate german c16s003_LunchWithEva_d7401d97:

    # sca "Es raro ver como crece la familia. Y más aún creciendo de esta forma."
    sca "Es ist seltsam, eine Familie wachsen zu sehen. Und noch seltsamer, wenn sie so wächst."

# game/scripts/c16/c16.rpy:2956
translate german c16s003_LunchWithEva_f864bf12:

    # sca "No todos los días te enteras de que la clonación humana existe, ni de que tu mejor amiga es accionista de una empresa que la lleva a cabo."
    sca "Man erfährt ja nicht jeden Tag, dass es Menschenklonen gibt oder dass der beste Freund Anteilseigner eines Unternehmens ist, das diese Technik anwendet."

# game/scripts/c16/c16.rpy:2957
translate german c16s003_LunchWithEva_65956472:

    # mc "Últimamente están pasando muchas cosas, y aún pueden pasar muchas cosas con la empresa."
    mc "In letzter Zeit ist viel passiert, und es kann noch viel mehr im Unternehmen passieren."

# game/scripts/c16/c16.rpy:2960
