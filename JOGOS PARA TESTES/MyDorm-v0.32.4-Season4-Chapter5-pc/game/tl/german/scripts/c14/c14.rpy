# game/scripts/c14/c14.rpy:3330
translate german c14s006_Christmas_8bd32490:

    # meg "No puedo, [mc]. Hoy trabajo aquí, en Westport, y tengo el coche en el mecánico. No podía ir y volver, y no voy a hacer que dejes a tu familia para venir a buscarme y traerme de nuevo."
    meg "Das geht nicht. Ich arbeite heute hier in Westport, und mein Auto ist in der Werkstatt. Ich könnte nicht extra hinfahren und wiederkommen, und ich werde dich nicht dazu zwingen, deine Familie zu verlassen, um mich abzuholen."

# game/scripts/c14/c14.rpy:3331
translate german c14s006_Christmas_201b907b:

    # mc "Vaya, qué lástima. ¿Cómo vendrás a trabajar el fin de semana a Newport?"
    mc "Oh, wie schade. Wie kommst du denn dieses Wochenende nach Newport zur Arbeit?"

# game/scripts/c14/c14.rpy:3333
translate german c14s006_Christmas_868a5958:

    # meg "Si aún no tengo el coche arreglado, cogeré el autobús y me quedaré en un motel las tres noches."
    meg "Wenn mein Auto noch nicht repariert ist, werde ich den Bus nehmen und die drei Nächte in einem Motel verbringen."

# game/scripts/c14/c14.rpy:3334
translate german c14s006_Christmas_d8a35f62:

    # mc "¡De eso nada! Ya iré a buscarte y te quedas a dormir en casa."
    mc "Auf keinen Fall! Ich hole dich ab und du kannst bei mir übernachten."

# game/scripts/c14/c14.rpy:3337
translate german c14s006_Christmas_a89ec603:

    # mc "Recuerda que mi madre te dijo que vinieras a dormir a casa cuando estuvieras en la ciudad."
    mc "Denk daran, dass meine Mutter dir gesagt hat, du sollst zu Hause übernachten, wenn du in der Stadt bist."

# game/scripts/c14/c14.rpy:3339
translate german c14s006_Christmas_c29256e0:

    # mc "Recuerda que [mar] te dijo que vinieras a dormir a casa cuando estuvieras en la ciudad."
    mc "Denk daran, dass [mar] dir gesagt hat, du sollst zu Hause übernachten, wenn du in der Stadt bist."

# game/scripts/c14/c14.rpy:3341
translate german c14s006_Christmas_2a6f06d9:

    # meg "No quiero ser una molestia, [mc]."
    meg "Ich möchte nicht zur Last fallen, [mc]."

# game/scripts/c14/c14.rpy:3342
translate german c14s006_Christmas_295f48aa:

    # mc "No lo vas a ser. Seguro que a todo el mundo le encanta conocerte, y así conoces a toda la familia."
    mc "Das wird nicht so sein. Ich bin mir sicher, dass sich alle freuen werden, dich kennenzulernen, und so lernst du die ganze Familie kennen."

# game/scripts/c14/c14.rpy:3344
translate german c14s006_Christmas_f51c0f83:

    # meg "Haces muy difícil rechazar la oferta. Perfecto entonces, ¿nos vemos el viernes? ¿Me podrás recoger en la estación de autobuses si no me han arreglado el coche?"
    meg "Du machst es mir wirklich schwer, das Angebot abzulehnen. Perfekt, treffen wir uns dann am Freitag? Könntest du mich vom Busbahnhof abholen, falls mein Auto noch nicht repariert ist?"

# game/scripts/c14/c14.rpy:3345
translate german c14s006_Christmas_076bae3d:

    # mc "Espera un momento... ¿tienes algo para beber ahí?"
    mc "Moment mal... haben Sie dort etwas zu trinken?"

# game/scripts/c14/c14.rpy:3346
translate german c14s006_Christmas_5a2c8d4f:

    # meg "Sí, tengo un refresco."
    meg "Ja, ich habe ein Erfrischungsgetränk."

# game/scripts/c14/c14.rpy:3347
translate german c14s006_Christmas_7c4397f4:

    # mc "Espera un momento."
    mc "Einen Moment bitte."

# game/scripts/c14/c14.rpy:3349
translate german c14s006_Christmas_e3c1f393:

    # "Vas a buscar una cerveza a las neveras y reanudas la videoconferencia."
    "Du holst dir ein Bier aus dem Kühlschrank und setzt die Videokonferenz fort."

# game/scripts/c14/c14.rpy:3351
translate german c14s006_Christmas_1b75356b:

    # meg "¿Por qué preguntabas lo de la bebida?"
    meg "Warum hast du nach dem Getränk gefragt?"

# game/scripts/c14/c14.rpy:3352
translate german c14s006_Christmas_c72be5ec:

    # mc "Ya te he dicho que estamos haciendo una fiesta Navideña, y no quería colgar sin brindar contigo."
    mc "Ich hatte dir ja schon gesagt, dass wir eine Weihnachtsfeier veranstalten, und ich wollte nicht auflegen, ohne mit dir anzustoßen."

# game/scripts/c14/c14.rpy:3355
translate german c14s006_Christmas_bb25a559:

    # mc "¡Feliz Navidad, cariño!"
    mc "Frohe Weihnachten, Liebling!"

# game/scripts/c14/c14.rpy:3356
translate german c14s006_Christmas_a8a44c57:

    # meg "¡Estás loco, pero me encanta! ¡Feliz Navidad, cielo!"
    meg "Du bist verrückt, aber ich liebe es! Frohe Weihnachten, Liebling!"

# game/scripts/c14/c14.rpy:3358
translate german c14s006_Christmas_665f1f7d:

    # mc "¡Feliz Navidad, Megan!"
    mc "Frohe Weihnachten, Megan!"

# game/scripts/c14/c14.rpy:3359
translate german c14s006_Christmas_0990ae72:

    # meg "¡Estás loco! ¡Feliz Navidad, cielo!"
    meg "Du bist verrückt! Frohe Weihnachten, Schatz!"

# game/scripts/c14/c14.rpy:3361
translate german c14s006_Christmas_29d1b83f:

    # mc "Te recojo el viernes en la estación de autobuses si no tienes el coche. Avísame a qué hora llegas."
    mc "Ich hole dich am Freitag am Busbahnhof ab, falls du kein Auto hast. Sag mir bitte Bescheid, wann du ankommst."

# game/scripts/c14/c14.rpy:3363
translate german c14s006_Christmas_2f7b3cad:

    # meg "¡Perfecto! Hasta el viernes. Te quiero."
    meg "Perfekt! Wir sehen uns am Freitag. Ich hab dich lieb."

# game/scripts/c14/c14.rpy:3364
translate german c14s006_Christmas_d6600aae:

    # mc "¡Yo más!"
    mc "Ich mache mehr!"

# game/scripts/c14/c14.rpy:3366
translate german c14s006_Christmas_faa27fb2:

    # mc "¡Perfecto! Hasta el viernes. Y gracias."
    mc "Perfekt! Wir sehen uns am Freitag. Und vielen Dank."

# game/scripts/c14/c14.rpy:3367
translate german c14s006_Christmas_a98bd78d:

    # meg "Nos vemos el viernes."
    meg "Wir sehen uns am Freitag."

# game/scripts/c14/c14.rpy:3370
translate german c14s006_Christmas_0910a363:

    # mc "Ya está. Alexia se unirá a nosotros en la comida."
    mc "Das war's. Alexia wird zum Mittagessen dazustoßen."

# game/scripts/c14/c14.rpy:3372
translate german c14s006_Christmas_fe5f82b1:

    # nor "¡Genial! Parece una buena chica."
    nor "Super! Sie scheint ein nettes Mädchen zu sein."

# game/scripts/c14/c14.rpy:3374
translate german c14s006_Christmas_55bb34ed:

    # bet "Y muy guapa..."
    bet "Und sehr hübsch..."

# game/scripts/c14/c14.rpy:3375
translate german c14s006_Christmas_299959ce:

    # mee "Sí, si la hubierais visto en el aeropuerto... Iba un poco arreglada y estaba guapísima. Lástima que sea un poco mayor para nuestro [mc]."
    mee "Ja, wenn du sie am Flughafen gesehen hättest … Sie war elegant gekleidet und sah umwerfend aus. Schade, dass sie für unser Alter etwas zu alt ist."

# game/scripts/c14/c14.rpy:3378
translate german c14s006_Christmas_397f5c3f:

    # mar "*Risa*" (multiple=2)
    mar "*Lachen*" (multiple=2)

# game/scripts/c14/c14.rpy:3379
translate german c14s006_Christmas_2bfa1cf4:

    # nor "*Carcajada*" (multiple=2)
    nor "*Lachen*" (multiple=2)

# game/scripts/c14/c14.rpy:3383
translate german c14s006_Christmas_bf87f68f:

    # nor "*Risa*"
    nor "*Lachen*"

# game/scripts/c14/c14.rpy:3387
translate german c14s006_Christmas_ffb1a49f:

    # mom "*Risa*"
    mom "*Lachen*"

# game/scripts/c14/c14.rpy:3389
translate german c14s006_Christmas_f057ccd6:

    # mc "*Risa*"
    mc "*Lachen*"

# game/scripts/c14/c14.rpy:3391
translate german c14s006_Christmas_5e846fc9:

    # mee "¿He dicho algo gracioso?"
    mee "Habe ich etwas Lustiges gesagt?"

# game/scripts/c14/c14.rpy:3392
translate german c14s006_Christmas_18b90fc2:

    # mc "Un poco, Meemaw. Siempre decís que parezco más mayor de mi edad. Sería injusto que yo juzgase a las mujeres por la suya."
    mc "Ein bisschen, Meemaw. Du sagst immer, ich sehe älter aus, als ich bin. Es wäre unfair von mir, Frauen nach ihrem Alter zu beurteilen."

# game/scripts/c14/c14.rpy:3394
translate german c14s006_Christmas_60566bfc:

    # mee "Pero tienes que salir con chicas de tu edad. ¿Qué harías con dos viejas como Betty o yo?"
    mee "Aber du musst mit Mädchen in deinem Alter ausgehen. Was würdest du denn mit zwei alten Damen wie Betty oder mir anfangen?"

# game/scripts/c14/c14.rpy:3395
translate german c14s006_Christmas_8c0e4406:

    # mc "Un trío con mucho cuidado por si os rompéis. *Risa*"
    mc "Ein Dreiergespann, seid bloß vorsichtig, falls was kaputtgeht. *Gelächter*"

# game/scripts/c14/c14.rpy:3396
translate german c14s006_Christmas_2013a020:

    # _("Todas menos Meemaw") "*Risa*"
    _("Todas menos Meemaw") ""

# game/scripts/c14/c14.rpy:3398
translate german c14s006_Christmas_4c7eee92:

    # mee "¡Ni se te ocurra bromear con eso!"
    mee "Mach bloß keine Witze darüber!"

# game/scripts/c14/c14.rpy:3399
translate german c14s006_Christmas_b488a032:

    # bet "Me parece que no está bromeando, Olivia. *Risa* Creo que nuestro chico tiene razón..."
    bet "Ich glaube nicht, dass er scherzt, Olivia. *lacht* Ich glaube, unser Mann hat Recht..."

# game/scripts/c14/c14.rpy:3401
translate german c14s006_Christmas_28914a20:

    # mee "Pero nosotras somos... somos..."
    mee "Aber wir sind... wir sind..."

# game/scripts/c14/c14.rpy:3402
translate german c14s006_Christmas_9f5f0860:

    # mc "Dos mujeres preciosas a las que quiero mucho y que me quieren a mí. Si fuera posible... Pero tranquilízate, estaba de broma. Sé que tú nunca aceptarías, Meemaw."
    mc "Zwei wunderschöne Frauen, die ich sehr liebe und die mich lieben. Wenn es doch nur möglich wäre … Aber keine Sorge, ich habe nur gescherzt. Ich weiß, du würdest mir sowieso nie zustimmen, Oma."

# game/scripts/c14/c14.rpy:3404
translate german c14s006_Christmas_6f81fbaa:

    # mee "¿Yo? ¿Y Betty sí?"
    mee "Ich? Und Betty, ja?"

# game/scripts/c14/c14.rpy:3405
translate german c14s006_Christmas_e32d0ef3:

    # bet "Quizás no con [mc], pero en otras circunstancias, ¿quién sabe qué hubiera pasado?"
    bet "Vielleicht nicht mit [mc], aber unter anderen Umständen, wer weiß, was passiert wäre?"

# game/scripts/c14/c14.rpy:3407
translate german c14s006_Christmas_6dbdc625:

    # mom "Tía Betty nos ha salido pícara. *Risa*" (multiple=2)
    mom "Tante Betty entpuppte sich als ganz schöner Schelm. *Gelächter*" (multiple=2)

# game/scripts/c14/c14.rpy:3408
translate german c14s006_Christmas_09e5deb6:

    # nor "*Risa* Tía, me acabas de sorprender mucho." (multiple=2)
    nor "*lacht* Tante, du hast mich wirklich überrascht." (multiple=2)

# game/scripts/c14/c14.rpy:3409
translate german c14s006_Christmas_d68ee34c:

    # mc "Yo solo veo cinco mujeres hermosas. No veo la edad que sumáis entre todas."
    mc "Ich sehe nur fünf wunderschöne Frauen. Ich kann euer Gesamtalter nicht einschätzen."

# game/scripts/c14/c14.rpy:3411
translate german c14s006_Christmas_f831008e:

    # kia "Porque te has dejado la calculadora en casa. *Risa*"
    kia "Weil du deinen Taschenrechner zu Hause vergessen hast. *lacht*"

# game/scripts/c14/c14.rpy:3412
translate german c14s006_Christmas_b3b94564_1:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c14/c14.rpy:3413
translate german c14s006_Christmas_18e1c939:

    # mc "Mamá, pásame otra cerveza, por favor."
    mc "Mama, gib mir bitte noch ein Bier."

# game/scripts/c14/c14.rpy:3415
translate german c14s006_Christmas_f0264c1b:

    # mom "¿Ya te has acabado la que te acabas de llevar? Deberías frenar un poco con el alcohol, ¿no?"
    mom "Hast du das Getränk, das du gerade hattest, schon ausgetrunken? Du solltest etwas weniger Alkohol trinken, nicht wahr?"

# game/scripts/c14/c14.rpy:3416
translate german c14s006_Christmas_b94bc6f7:

    # mc "No, tranquila. Creo que acabo de ver a alguien y voy a saludarla."
    mc "Nein, keine Sorge. Ich glaube, ich habe gerade jemanden gesehen und werde ihn begrüßen."

# game/scripts/c14/c14.rpy:3417
translate german c14s006_Christmas_71d7e15c:

    # mom "¿Alguien?"
    mom "Jemand?"

# game/scripts/c14/c14.rpy:3419
translate german c14s006_Christmas_ba3f445a:

    # mc "Cosas mías, Mamá."
    mc "Meine eigenen Sachen, Mama."

# game/scripts/c14/c14.rpy:3428
translate german c14s006_Christmas_da16b24b:

    # mc "Buenos días, Eva. No es un buen sitio para esconderse, ¿no?"
    mc "Guten Morgen, Eva. Das ist kein guter Ort zum Verstecken, oder?"

# game/scripts/c14/c14.rpy:3429
translate german c14s006_Christmas_2217a33d:

    # eva "Buenos días, [mc]. Es difícil esconderse en una playa casi vacía."
    eva "Guten Morgen, [mc]. Es ist schwierig, sich an einem fast leeren Strand zu verstecken."

# game/scripts/c14/c14.rpy:3431
translate german c14s006_Christmas_a625d38b:

    # eva "Y más aún si vienes aquí y llamas la atención sobre mí."
    eva "Und das gilt umso mehr, wenn Sie hierherkommen und die Aufmerksamkeit auf mich lenken."

# game/scripts/c14/c14.rpy:3432
translate german c14s006_Christmas_0606b398:

    # mc "Lo siento, pero estamos de celebración navideña y os quería incluír. ¿Amanda está por aquí?"
    mc "Tut mir leid, aber wir feiern Weihnachten und ich wollte dich einbeziehen. Ist Amanda da?"

# game/scripts/c14/c14.rpy:3434
translate german c14s006_Christmas_b91f8a88:

    # eva "¿Incluirnos? ¿A nosotras? ¿Por qué?"
    eva "Sollen wir mitein? Wir? Warum?"

# game/scripts/c14/c14.rpy:3435
translate german c14s006_Christmas_0a43cdf1:

    # mc "Es fácil. Es una celebración familiar. Y sois parte de la famila. De una forma rara, pero lo sois."
    mc "Es ist ganz einfach. Es ist ein Familienfest. Und du gehörst zur Familie. Auf eine etwas ungewöhnliche Art und Weise, aber du gehörst dazu."

# game/scripts/c14/c14.rpy:3437
translate german c14s006_Christmas_883516cc:

    # mc "Sois los clones de mi hermana y de mis primas. Por raro que parezca, desde que ayer le vi la cara a Amanda, no puedo evitar pensar en vosotras como parte de la familia."
    mc "Du siehst meiner Schwester und meinen Cousins zum Verwechseln ähnlich. So seltsam es auch klingen mag, seit ich gestern Amandas Gesicht gesehen habe, betrachte ich dich einfach als Teil der Familie."

# game/scripts/c14/c14.rpy:3439
translate german c14s006_Christmas_9215dc47:

    # mc "Mi hermana y mis primas son clones vuestros. Por raro que parezca, desde que ayer le vi la cara a Amanda, no puedo evitar pensar en vosotras como parte de la familia."
    mc "Meine Schwester und meine Cousinen sehen dir zum Verwechseln ähnlich. So seltsam es auch klingen mag, seit ich gestern Amandas Gesicht gesehen habe, betrachte ich dich immer wieder als Teil der Familie."

# game/scripts/c14/c14.rpy:3441
translate german c14s006_Christmas_46c421fa:

    # eva "No somos {b}tu{/b} familia. Amanda es {b}mi{/b} familia. No vosotros."
    eva "Wir sind nicht deine Familie. Amanda ist meine Familie. Du nicht."

# game/scripts/c14/c14.rpy:3443
translate german c14s006_Christmas_0469219c:

    # eva "Ni siquiera tu \"hermana\" y tus \"primas\" son tu familia."
    eva "Nicht einmal deine „Schwester“ und deine „Cousins“ gehören zu deiner Familie."

# game/scripts/c14/c14.rpy:3444
translate german c14s006_Christmas_db123823:

    # mc "Te equivocas en eso, Eva. Yo decido quién es mi familia, no la sangre que corre por nuestras venas."
    mc "Da irrst du dich, Eva. Ich bestimme, wer meine Familie ist, nicht das Blut, das durch unsere Adern fließt."

# game/scripts/c14/c14.rpy:3445
translate german c14s006_Christmas_b8b37c13:

    # mc "Puede que tu no me consideres parte de tu familia, pero yo si que os considero familia a vosotras dos. No puedo mirarte a la cara y no ver a [dap] o a [eri]."
    mc "Ihr betrachtet mich vielleicht nicht als Teil eurer Familie, aber ich betrachte euch beide als Familie. Ich kann euch nicht in die Augen sehen, ohne [dap] oder [eri] zu erkennen."

# game/scripts/c14/c14.rpy:3447
translate german c14s006_Christmas_e3b24e4a:

    # eva "Lo que tú digas..."
    eva "Was auch immer du sagst..."

# game/scripts/c14/c14.rpy:3448
translate german c14s006_Christmas_a96613df:

    # mc "Pero no me has respondido, ¿Amanda también está por aquí?"
    mc "Aber du hast mir noch nicht geantwortet, ist Amanda auch hier?"

# game/scripts/c14/c14.rpy:3450
translate german c14s006_Christmas_fc5eb797:

    # eva "No... está en la base. ¿Por qué?"
    eva "Nein... es befindet sich im Sockel. Warum?"

# game/scripts/c14/c14.rpy:3451
translate german c14s006_Christmas_97efceca:

    # mc "Porque, aunque te parezca ridículo después de lo que acabas de decirme, quiero felicitaros la Navidad a las dos. La Navidad es para pasarla en familia, ¿no?"
    mc "Denn auch wenn es nach dem, was du mir gerade erzählt hast, vielleicht absurd klingt, möchte ich euch beiden ein frohes Weihnachtsfest wünschen. Weihnachten ist doch dazu da, Zeit mit der Familie zu verbringen, nicht wahr?"

# game/scripts/c14/c14.rpy:3453
translate german c14s006_Christmas_6913f80f:

    # eva "Pero... ¿tú eres tonto? ¡No es Navidad! ¡Y ya te he dicho que no somos tu familia!"
    eva "Bist du blöd? Es ist nicht Weihnachten! Und ich hab dir doch schon gesagt, dass wir nicht deine Familie sind!"

# game/scripts/c14/c14.rpy:3454
translate german c14s006_Christmas_e5e4d666:

    # mc "Y yo te he dicho que tu concepto de familia y el mío son diferentes. ¿Puedes llamarla?"
    mc "Und ich habe dir doch gesagt, dass unsere Familienvorstellungen unterschiedlich sind. Kannst du sie anrufen?"

# game/scripts/c14/c14.rpy:3456
translate german c14s006_Christmas_2903d95e:

    # mc "Te he traído una cerveza si sirve de algo..."
    mc "Ich habe dir ein Bier mitgebracht, falls das hilft..."

# game/scripts/c14/c14.rpy:3457
translate german c14s006_Christmas_15cb36bd:

    # eva "Gracias... supongo... Aquí tienes a Amanda..."
    eva "Danke... denke ich... Hier ist Amanda..."

# game/scripts/c14/c14.rpy:3459
translate german c14s006_Christmas_50b7caf2:

    # mc "Hola, Amanda. ¿Qué te pasa?"
    mc "Hallo Amanda. Was ist los?"

# game/scripts/c14/c14.rpy:3460
translate german c14s006_Christmas_c49fda70:

    # ama "Nada, nada... se me ha metido algo en el ojo..."
    ama "Nichts, nichts... Ich habe etwas im Auge..."

# game/scripts/c14/c14.rpy:3461
translate german c14s006_Christmas_5b1a03f0:

    # mc "¿Nos estabas escuchando?"
    mc "Haben Sie uns zugehört?"

# game/scripts/c14/c14.rpy:3463
translate german c14s006_Christmas_0e4ab121:

    # ama "Sí, Eva siempre tiene el micro abierto..."
    ama "Ja, Eva hat ihr Mikrofon immer eingeschaltet..."

# game/scripts/c14/c14.rpy:3464
translate german c14s006_Christmas_2c21f765:

    # mc "Pues debes saber que lo que le he dicho a ella, también se aplica a ti."
    mc "Nun, du solltest wissen, dass das, was ich ihr gesagt habe, auch für dich gilt."

# game/scripts/c14/c14.rpy:3465
translate german c14s006_Christmas_b63f1bae:

    # mc "Espero que un día os podáis sentar en la mesa con nosotros en Navidad o en Acción de Gracias. O en cumpleaños. O cuando sea."
    mc "Ich hoffe, dass du eines Tages mit uns an Weihnachten oder Thanksgiving am Tisch sitzen kannst. Oder an Geburtstagen. Oder wann immer du willst."

# game/scripts/c14/c14.rpy:3467
translate german c14s006_Christmas_5971d798:

    # ama "Gracias, pero no será posible. Nuestra misión con vosotros casi ha acabado... dudo que nos veamos demasiado después. "
    ama "Vielen Dank, aber das wird nicht möglich sein. Unsere Mission mit Ihnen ist fast beendet... Ich bezweifle, dass wir uns viel später wiedersehen werden."

# game/scripts/c14/c14.rpy:3468
translate german c14s006_Christmas_13159d92:

    # ama "De todas formas, eso levantaría demasiadas liebres. No sé cómo se lo tomarían [emm], [dap] y [eri]."
    ama "Das würde jedenfalls zu viele Fragen aufwerfen. Ich weiß nicht, wie [emm], [dap] und [eri] das aufnehmen würden."

# game/scripts/c14/c14.rpy:3469
translate german c14s006_Christmas_b0917ed2:

    # mc "Seguramente fliparian al principio. Después os recibirían con los brazos abiertos. Es posible que os debamos la vida..."
    mc "Sie wären wohl zunächst verblüfft. Dann würden sie dich mit offenen Armen empfangen. Wir könnten dir unser Leben verdanken …"

# game/scripts/c14/c14.rpy:3471
translate german c14s006_Christmas_72c0baf5:

    # eva "*Susurrando* ¿Solo posible?"
    eva "*Flüsternd* Ist das die einzige Möglichkeit?"

# game/scripts/c14/c14.rpy:3472
translate german c14s006_Christmas_b579a18c:

    # ama "¡Eva!"
    ama "Vorabend!"

# game/scripts/c14/c14.rpy:3473
translate german c14s006_Christmas_9ea4742e:

    # mc "¿Qué? No te he entendido..."
    mc "Was? Ich habe dich nicht verstanden..."

# game/scripts/c14/c14.rpy:3475
translate german c14s006_Christmas_9e423c2d:

    # eva "No... nada..."
    eva "Nein, nichts..."

# game/scripts/c14/c14.rpy:3477
translate german c14s006_Christmas_1fd7b00f:

    # mc "¿Eso es un arma? ¿Has traído un arma a la playa?"
    mc "Ist das eine Waffe? Haben Sie eine Waffe mit an den Strand gebracht?"

# game/scripts/c14/c14.rpy:3479
translate german c14s006_Christmas_5803d896:

    # eva "A menos que quieras que proteja a {b}tu{/b} familia tirandoles conchas de almeja a los tipos malos... la tengo que llevar encima."
    eva "Es sei denn, Sie wollen, dass ich Ihre Familie beschütze, indem ich Muschelschalen auf die Bösewichte werfe... dann muss ich es mit mir herumtragen."

# game/scripts/c14/c14.rpy:3481
translate german c14s006_Christmas_9553a853:

    # mc "Bueno, pues entonces creo que me llevaré la cerveza. Armas y alcohol..."
    mc "Na gut, dann nehme ich wohl das Bier. Waffen und Alkohol..."

# game/scripts/c14/c14.rpy:3484
translate german c14s006_Christmas_ca5f15c7:

    # eva "Si se te ocurre tocar mi cerveza, me obligarás a usar la pistola. *Risa*"
    eva "Wenn du auch nur daran denkst, mein Bier anzurühren, zwingst du mich, meine Waffe zu benutzen. *lacht*"

# game/scripts/c14/c14.rpy:3485
translate german c14s006_Christmas_4047a438:

    # mc "¡Coño! Sabes reírte y hacer bromas..."
    mc "Verdammt! Du verstehst es, zu lachen und Witze zu machen..."

# game/scripts/c14/c14.rpy:3487
translate german c14s006_Christmas_9a174d02:

    # mc "Creía que más que un clon eras un robot."
    mc "Ich dachte, du wärst eher ein Roboter als ein Klon."

# game/scripts/c14/c14.rpy:3489
translate german c14s006_Christmas_55c837bd:

    # ama "Ahí te ha pillado, Eva. *Risa*"
    ama "Na also, Eva. *lacht*"

# game/scripts/c14/c14.rpy:3491
translate german c14s006_Christmas_5d4e8276:

    # eva "*Gruñido*"
    eva "*Knurren*"

# game/scripts/c14/c14.rpy:3493
translate german c14s006_Christmas_06fca160:

    # ama "[mc], deberías irte ya. [emm], [eri], y Eileen se acercan a vuestra posición y si te ven descubrirán a Eva."
    ama "[mc], du solltest jetzt gehen. [emm], [eri] und Eileen nähern sich deiner Position, und wenn sie dich sehen, werden sie Eva entdecken."

# game/scripts/c14/c14.rpy:3494
translate german c14s006_Christmas_08fdf717:

    # mc "Bueno, chicas, entonces tan solo desearos Feliz Navidad."
    mc "Nun, Mädels, dann wollte ich euch nur ein frohes Weihnachtsfest wünschen."

# game/scripts/c14/c14.rpy:3496
translate german c14s006_Christmas_48fe6d84:

    # ama "Feliz Navidad, [mc]."
    ama "Frohe Weihnachten, [mc]."

# game/scripts/c14/c14.rpy:3497
translate german c14s006_Christmas_4bc1e65c:

    # mc "Feliz Navidad, Amanda."
    mc "Frohe Weihnachten, Amanda."

# game/scripts/c14/c14.rpy:3498
translate german c14s006_Christmas_e62105b5:

    # mc "Eva, ¿brindas conmigo o me tengo que llevar la cerveza?"
    mc "Eva, stößt du mit mir an oder soll ich das Bier mitbringen?"

# game/scripts/c14/c14.rpy:3500
translate german c14s006_Christmas_5604323f:

    # eva "Feliz Navidad, [mc]."
    eva "Frohe Weihnachten, [mc]."

# game/scripts/c14/c14.rpy:3501
translate german c14s006_Christmas_b22be3eb:

    # mc "Feliz Navidad, Eva."
    mc "Frohe Weihnachten, Eva."

# game/scripts/c14/c14.rpy:3502
translate german c14s006_Christmas_7c45520f:

    # mc "Espero volver a veros pronto."
    mc "Ich hoffe, wir sehen uns bald wieder."

# game/scripts/c14/c14.rpy:3504
translate german c14s006_Christmas_bf009481:

    # ama "Nos verás. Vete ya. Hacia el noreste para interceptar a las chicas."
    ama "Ihr werdet uns sehen. Geht jetzt. Fahrt nach Nordosten, um die Mädchen abzufangen."

# game/scripts/c14/c14.rpy:3505
translate german c14s006_Christmas_b7825201:

    # mc "No seas como mi GPS, no tengo una brújula en el reloj. ¿Dónde coño está el noreste?"
    mc "Sei nicht wie mein GPS, ich habe keinen Kompass an meiner Uhr. Wo zum Teufel liegt Nordosten?"

# game/scripts/c14/c14.rpy:3506
translate german c14s006_Christmas_c043cac7:

    # ama "*Risa* Hacia el merendero..."
    ama "*Gelächter* Richtung Picknickplatz..."

# game/scripts/c14/c14.rpy:3507
translate german c14s006_Christmas_d0cb31d2:

    # mc "Hasta otra, chicas."
    mc "Bis später, Mädels."

# game/scripts/c14/c14.rpy:3509
translate german c14s006_Christmas_2cfd03ff:

    # ama "Te dije que no era mal tipo. Ha sido muy bonito lo que ha dicho."
    ama "Ich hab's dir doch gesagt, dass er kein schlechter Kerl ist. Was er gesagt hat, war wirklich nett."

# game/scripts/c14/c14.rpy:3510
translate german c14s006_Christmas_db943ceb:

    # eva "*Susurrando* Y ha traído cerveza. Sin querer meterse en mis bragas por ello."
    eva "*Flüsternd* Und er hat Bier mitgebracht. Wegen dem wollte er nicht in meine Unterwäsche."

# game/scripts/c14/c14.rpy:3511
translate german c14s006_Christmas_e5c1f31a:

    # ama "¿Te puedes imaginar teniendo una familia como esa?"
    ama "Können Sie sich vorstellen, so eine Familie zu haben?"

# game/scripts/c14/c14.rpy:3512
translate german c14s006_Christmas_6d44ce54:

    # eva "*Susurrando* Estaría bien pasar una Navidad con una familia de verdad por una vez."
    eva "*flüstert* Es wäre schön, Weihnachten endlich einmal mit einer richtigen Familie zu verbringen."

# game/scripts/c14/c14.rpy:3514
translate german c14s006_Christmas_93674dee:

    # eva "*Susurrando* Aunque viendo como trata a la familia, no me extrañaría que realmente quisiera meterse en nuestras bragas. *Risa*"
    eva "*flüstert* Wenn ich sehe, wie er mit der Familie umgeht, würde es mich nicht wundern, wenn er wirklich Lust auf uns hätte. *lacht*"

# game/scripts/c14/c14.rpy:3516
translate german c14s006_Christmas_863d97b4:

    # eva "*Susurrando* Aunque viendo como trata a lo que llama familia, no me extrañaría que realmente quisiera meterse en nuestras bragas. *Risa*"
    eva "*flüstert* Wenn ich sehe, wie er mit seiner sogenannten Familie umgeht, würde es mich nicht wundern, wenn er wirklich Lust auf unsere Unterwäsche hätte. *lacht*"

# game/scripts/c14/c14.rpy:3517
translate german c14s006_Christmas_2c481062:

    # ama "Sé que eso no te importaría demasiado. *Risa*"
    ama "Ich weiß, das würde dir nicht allzu viel ausmachen. *lacht*"

# game/scripts/c14/c14.rpy:3518
translate german c14s006_Christmas_d7db2251:

    # eva "*Susurrando* Yo tengo suficiente contigo, hermanita. Y que conste que hablo de la Navidad."
    eva "*Flüsternd* Ich habe genug von dir, kleine Schwester. Und nur damit du es weißt: Ich spreche von Weihnachten."

# game/scripts/c14/c14.rpy:3519
translate german c14s006_Christmas_53a020dc:

    # ama "También sé que eso es mentira. *Risa*"
    ama "Ich weiß auch, dass das eine Lüge ist. *lacht*"

# game/scripts/c14/c14.rpy:3520
translate german c14s006_Christmas_79022e2b:

    # eva "*Gruñido* Te acabas de ganar que te cuelgue. Hasta luego. Feliz Navidad."
    eva "*Grunzen* Du hast dir gerade einen Auflegetermin eingehandelt. Tschüss. Frohe Weihnachten."

# game/scripts/c14/c14.rpy:3521
translate german c14s006_Christmas_ae5d4fea:

    # ama "Feliz Navidad, Eva."
    ama "Frohe Weihnachten, Eva."

# game/scripts/c14/c14.rpy:3524
translate german c14s006_Christmas_08b9f087:

    # "Te diriges hacia el merendero (sí, sí, hacia el jodido noreste), con la esperanza de interceptar a las chicas a tiempo."
    "Du machst dich auf den Weg zum Picknickplatz (ja, ja, in Richtung Nordosten), in der Hoffnung, die Mädchen noch rechtzeitig abzufangen."

# game/scripts/c14/c14.rpy:3535
translate german c14s006_Christmas_210fc8d5:

    # mc "Hola, chicas. ¿Qué tal el paseo?"
    mc "Hallo Mädels. Wie war der Spaziergang?"

# game/scripts/c14/c14.rpy:3536
translate german c14s006_Christmas_ef5396b5:

    # eri "Bien, hemos estado charlando y poniéndonos al día."
    eri "Okay, wir haben uns unterhalten und Neuigkeiten ausgetauscht."

# game/scripts/c14/c14.rpy:3542
translate german c14s006_Christmas_01d95318:

    # emm "¿Nos hemos perdido algo?"
    emm "Haben wir etwas übersehen?"

# game/scripts/c14/c14.rpy:3543
translate german c14s006_Christmas_c5ee7190:

    # mc "Una partida de Verdad o Reto con las chicas..."
    mc "Eine Runde Wahrheit oder Pflicht mit den Mädchen..."

# game/scripts/c14/c14.rpy:3545
translate german c14s006_Christmas_44bc1b70:

    # mc "Qué se ha ido un poco de las manos. No aprenderemos nunca."
    mc "Die Dinge sind etwas außer Kontrolle geraten. Wir werden es nie lernen."

# game/scripts/c14/c14.rpy:3547
translate german c14s006_Christmas_920e32e6:

    # emm "¿[dap] haciendo de las suyas?"
    emm "[dap]Wieder zu ihren alten Tricks zurückgekehrt?"

# game/scripts/c14/c14.rpy:3548
translate german c14s006_Christmas_18d545f0:

    # mc "No, esta vez ha sido Kate, pero no ha habido malos rollos."
    mc "Nein, diesmal war es Kate, aber es gab keinen Groll."

# game/scripts/c14/c14.rpy:3558
translate german c14s006_Christmas_c46936de:

    # eil "¿Dónde están ahora?"
    eil "Wo sind sie jetzt?"

# game/scripts/c14/c14.rpy:3559
translate german c14s006_Christmas_17a90bd3:

    # mc "Han ido a por hielo a la gasolinera. Tenemos una nevera con una fuga."
    mc "Sie sind zur Tankstelle gefahren, um Eis zu holen. Unser Kühlschrank hat ein Leck."

# game/scripts/c14/c14.rpy:3560
translate german c14s006_Christmas_11555ef9:

    # mc "Y de paso a ver si os encontraban."
    mc "Und wenn wir schon dabei sind, schauen wir doch mal, ob sie dich finden können."

# game/scripts/c14/c14.rpy:3562
translate german c14s006_Christmas_5fc40a5b:

    # eri "Ah, pues podemos ir a la gasolinera a buscarlas y las ayudamos..."
    eri "Ah, nun ja, wir können zur Tankstelle gehen, um sie zu finden und ihnen zu helfen..."

# game/scripts/c14/c14.rpy:3563
translate german c14s006_Christmas_a109c1cd:

    # mc "Así os enteráis de lo que ha pasado en la partida, ¿no? *Risa*"
    mc "So erfährt man, was im Spiel passiert ist, richtig? *lacht*"

# game/scripts/c14/c14.rpy:3566
translate german c14s006_Christmas_ea75c01d:

    # emm "¿Puedo hablar un momento contigo antes de irnos?"
    emm "Kann ich kurz mit Ihnen sprechen, bevor wir gehen?"

# game/scripts/c14/c14.rpy:3567
translate german c14s006_Christmas_e0dc6594:

    # mc "Sí, claro. ¿Nos perdonáis un momento?"
    mc "Ja, selbstverständlich. Würden Sie uns einen Moment entschuldigen?"

# game/scripts/c14/c14.rpy:3569
translate german c14s006_Christmas_92357e5f:

    # eil "Por supuesto." (multiple=2)
    eil "Natürlich." (multiple=2)

# game/scripts/c14/c14.rpy:3570
translate german c14s006_Christmas_fcde78ae:

    # eri "No tengáis prisa." (multiple=2)
    eri "Lass dir Zeit." (multiple=2)

# game/scripts/c14/c14.rpy:3572
translate german c14s006_Christmas_23a92444:

    # mc "¿Qué pasa, [emm]?"
    mc "Was geht, [emm]?"

# game/scripts/c14/c14.rpy:3573
translate german c14s006_Christmas_fa3d3b61:

    # emm "Bueno... sé que querías que hiciéramos público lo nuestro... y creo que [eri] lo debería saber."
    emm "Nun ja... ich weiß, dass du wolltest, dass wir unsere Beziehung öffentlich machen... und ich denke, [eri] sollte das wissen."

# game/scripts/c14/c14.rpy:3574
translate german c14s006_Christmas_5004e101:

    # mc "Cuando quieras. El día de Verdad o Reto querías restregárselo por la cara..."
    mc "Wann immer du willst. Am Tag der Wahrheit oder Pflicht wolltest du es ihm unter die Nase reiben..."

# game/scripts/c14/c14.rpy:3576
translate german c14s006_Christmas_e7735ec0:

    # emm "Y me dijiste que no lo hiciera porque lo de Jack estaba muy reciente. Me acuerdo."
    emm "Und du hast mir gesagt, ich solle es nicht tun, weil das, was mit Jack passiert ist, noch nicht lange her ist. Ich erinnere mich."

# game/scripts/c14/c14.rpy:3577
translate german c14s006_Christmas_a7424214:

    # emm "Entonces ¿no te importaría que lo supiera?"
    emm "Es würde dich also nicht stören, wenn ich es wüsste?"

# game/scripts/c14/c14.rpy:3578
translate german c14s006_Christmas_600871e5:

    # mc "No, cuando estés preparada, se lo decimos."
    mc "Nein, wenn du bereit bist, werden wir es ihm sagen."

# game/scripts/c14/c14.rpy:3580
translate german c14s006_Christmas_7a085273:

    # emm "¡Genial! Porque se me ha escapado... Ahora no te puedes enfadar."
    emm "Super! Weil es dir rausgerutscht ist... Jetzt kannst du dich nicht mehr ärgern."

# game/scripts/c14/c14.rpy:3581
translate german c14s006_Christmas_391eb16b:

    # emm "Chicas, no le importa que se me haya escapado. ¡Uff!"
    emm "Mädels, es ist ihr egal, dass ich entkommen bin. Puh!"

# game/scripts/c14/c14.rpy:3582
translate german c14s006_Christmas_b2ce9547:

    # mc "{b}¿QUÉ?{/b}"
    mc "{b}WAS?{/b}"

# game/scripts/c14/c14.rpy:3584
translate german c14s006_Christmas_11967536:

    # eil "Estábamos hablando de chicos..."
    eil "Wir sprachen über Jungen..."

# game/scripts/c14/c14.rpy:3586
translate german c14s006_Christmas_43cf2b28:

    # eri "Y [emm] estaba todo el rato \"mi chico esto, mi chico aquello\"..."
    eri "Und [emm] sagte ständig \"mein Freund dies, mein Freund das\"..."

# game/scripts/c14/c14.rpy:3588
translate german c14s006_Christmas_b546f41a:

    # emm "Y una de las veces he dicho \"[mc] esto, [mc] aquello\". Lo siento, supongo que querías estar cuando se lo dijésemos."
    emm "Und einmal sagte ich „dies, das“. Tut mir leid, ich glaube, du wolltest dabei sein, als wir es ihm sagten."

# game/scripts/c14/c14.rpy:3589
translate german c14s006_Christmas_2f0af520:

    # emm "Tenías que haberles visto las caras..."
    emm "Du hättest ihre Gesichter sehen sollen..."

# game/scripts/c14/c14.rpy:3590
translate german c14s006_Christmas_d673f2f0:

    # mc "Pues sí. Me hubiera gustado estar... Sólo me puedo imaginar su sorpresa... lástima que no la pueda ver ya."
    mc "Ja, wirklich. Ich wäre so gerne dabei gewesen... Ich kann mir ihre Überraschung nur vorstellen... Schade, dass ich sie jetzt nicht mehr sehen kann."

# game/scripts/c14/c14.rpy:3593
translate german c14s006_Christmas_59e544f5:

    # "[eri] capta el sentido de tus palabras y te mira inquisitivamente. Asientes con la cabeza."
    "[eri] versteht die Bedeutung deiner Worte und sieht dich fragend an. Du nickst."

# game/scripts/c14/c14.rpy:3595
translate german c14s006_Christmas_d8ef1cb1:

    # eri "Bueno, no puedes ver la mía, pero puedes ver la de [emm]."
    eri "Nun, meine können Sie nicht sehen, aber die von [emm] schon."

# game/scripts/c14/c14.rpy:3597
translate german c14s006_Christmas_30b72e36:

    # emm "¿La mía? ¿Por qué? Yo ya sabía que salía con él."
    emm "Meins? Warum? Ich wusste doch schon, dass sie mit ihm zusammen ist."

# game/scripts/c14/c14.rpy:3599
translate german c14s006_Christmas_26771490:

    # eri "Porque yo también salgo con él, [emm]."
    eri "Weil ich auch mit ihm zusammen bin, [emm]."

# game/scripts/c14/c14.rpy:3601
translate german c14s006_Christmas_8a79acca:

    # emm "{b}¿Qué?{/b}"
    emm "{b}Was?{/b}"

# game/scripts/c14/c14.rpy:3602
translate german c14s006_Christmas_14711e51:

    # emm "¡No me jodáis! ¡Con eso no se bromea!"
    emm "Leg dich nicht mit mir an! Das ist kein Scherz!"

# game/scripts/c14/c14.rpy:3603
translate german c14s006_Christmas_e975c650:

    # emm "¿Me lo estáis diciendo en serio?"
    emm "Meinst du das ernst?"

# game/scripts/c14/c14.rpy:3604
translate german c14s006_Christmas_d1adefff:

    # emm "¡Por el amor de Dios! ¡Decid algo!"
    emm "Um Gottes Willen! Sag doch etwas!"

# game/scripts/c14/c14.rpy:3605
translate german c14s006_Christmas_2fde6581:

    # mc "Sí, [emm]. Estamos saliendo juntos."
    mc "Ja, [emm]. Wir sind ein Paar."

# game/scripts/c14/c14.rpy:3607
translate german c14s006_Christmas_48447efd:

    # emm "¡Joder, [eri]! No quiero saber lo mal que lo has pasado..."
    emm "Verdammt, [eri]! Ich will gar nicht wissen, wie sehr du gelitten hast..."

# game/scripts/c14/c14.rpy:3608
translate german c14s006_Christmas_033cb142:

    # eri "¿Qué? ¿Yo? ¿Mal? ¡No te entiendo!"
    eri "Was? Ich? Schlecht? Ich verstehe dich nicht!"

# game/scripts/c14/c14.rpy:3610
translate german c14s006_Christmas_47e165fb:

    # emm "Con lo mal que se te da guardar secretos, tenerme que ocultar algo así..."
    emm "Bei deiner Unfähigkeit, Geheimnisse zu bewahren, ist es ärgerlich, dass du so etwas vor mir verheimlichen musst..."

# game/scripts/c14/c14.rpy:3611
translate german c14s006_Christmas_5065c013:

    # mc "[emm], a quien se le da mal guardarlos es a ti..."
    mc "[emm], du bist derjenige, der sie nicht beschützt..."

# game/scripts/c14/c14.rpy:3614
translate german c14s006_Christmas_5020f681:

    # emm "No me digas eso, que bien he guardado el de..."
    emm "Sag mir das nicht, ich habe das eine von... behalten."

# game/scripts/c14/c14.rpy:3615
translate german c14s006_Christmas_99af6d99:

    # mc "¡[emm]!"
    mc "[emm]!"

# game/scripts/c14/c14.rpy:3617
translate german c14s006_Christmas_3f2ec84d:

    # emm "¡Oops! ¡Casi!"
    emm "Hoppla! Fast!"

# game/scripts/c14/c14.rpy:3620
translate german c14s006_Christmas_da2dc271:

    # emm "No me digas eso. Siempre he guardado tus secretos... bueno... casi siempre..."
    emm "Sag mir das nicht. Ich habe deine Geheimnisse immer bewahrt... nun ja... fast immer..."

# game/scripts/c14/c14.rpy:3622
translate german c14s006_Christmas_1448a3a1:

    # eri "¿Algún secreto más que quieras compartir con nosotros, [mc]?"
    eri "Gibt es sonst noch Geheimnisse, die Sie mit uns teilen möchten, [mc]?"

# game/scripts/c14/c14.rpy:3624
translate german c14s006_Christmas_53966c96:

    # mc "Yo no, pero..."
    mc "Nicht ich, aber..."

# game/scripts/c14/c14.rpy:3626
translate german c14s006_Christmas_c83ad9cb:

    # eil "Yo también salgo con él, [emm]."
    eil "Ich bin auch mit ihm zusammen, [emm]."

# game/scripts/c14/c14.rpy:3628
translate german c14s006_Christmas_fb563225:

    # emm "Bueno, de ti ya me lo imaginaba..."
    emm "Nun, das hatte ich bei dir schon herausgefunden..."

# game/scripts/c14/c14.rpy:3630
translate german c14s006_Christmas_a5d7bb60:

    # eil "¿Qué? ¿Desde cuando?"
    eil "Was? Seit wann?"

# game/scripts/c14/c14.rpy:3632
translate german c14s006_Christmas_4251c24c:

    # emm "Desde que me dijo que estaría con otras chicas."
    emm "Seitdem er mir gesagt hat, dass er mit anderen Mädchen zusammen sein würde."

# game/scripts/c14/c14.rpy:3633
translate german c14s006_Christmas_c58fde1c:

    # emm "A ver, si estaba conmigo y quería estar con otras... tú tenías que ser una de las otras."
    emm "Hör mal, wenn er mit mir zusammen war und auch mit anderen zusammen sein wollte... dann musstest du eine von den anderen sein."

# game/scripts/c14/c14.rpy:3634
translate german c14s006_Christmas_4caf16ce:

    # emm "Además, eso de llevar a [eri] cada día al café... pero claro, si también sale con ella..."
    emm "Außerdem nimmt er [eri] jeden Tag mit ins Café... aber natürlich geht er auch mit ihr aus..."

# game/scripts/c14/c14.rpy:3635
translate german c14s006_Christmas_223e504d:

    # emm "Todos os veíamos antes de que se fuera a Portland y erais la pareja perfecta. Yo incluso lloré un poquito cuando rompisteis."
    emm "Wir haben euch alle gesehen, bevor er nach Portland ging, und ihr wart das perfekte Paar. Ich habe sogar ein bisschen geweint, als ihr euch getrennt habt."

# game/scripts/c14/c14.rpy:3637
translate german c14s006_Christmas_69c3d218:

