# game/scripts/c14/c14.rpy:3881
translate german c14s006_Christmas_1fa169a9:

    # mc "Y no tenemos por qué defender nuestra relación delante de nadie, Meemaw. Ni necesitamos la autorización de nadie."
    mc "Und wir müssen unsere Beziehung vor niemandem verteidigen, Meemaw. Wir brauchen auch niemandes Erlaubnis."

# game/scripts/c14/c14.rpy:3883
translate german c14s006_Christmas_ff186d88:

    # bet "*Risa* Sigue así, hermanita. Si sigues protestando, los vas a unir más todavía."
    bet "*Lacht* Mach weiter so, kleine Schwester. Wenn du weiter protestierst, bringst du sie nur noch näher zusammen."

# game/scripts/c14/c14.rpy:3886
translate german c14s006_Christmas_e21f8a91:

    # mee "¿Tú no ves que sea una locura?"
    mee "Siehst du denn nicht, dass das verrückt ist?"

# game/scripts/c14/c14.rpy:3888
translate german c14s006_Christmas_c65e3e94:

    # bet "Claro que sí. Igual de locura que nuestros padres vieron que te casaras con John. Y eso os unió aún más."
    bet "Natürlich. Genauso verrückt, wie unsere Eltern es fanden, als du John geheiratet hast. Und das hat euch noch enger zusammengeschweißt."

# game/scripts/c14/c14.rpy:3890
translate german c14s006_Christmas_16d0abd3:

    # mee "¡Pero eso es porque eran unos clasistas y John estaba sin blanca! ¿Tú ves esto normal?"
    mee "Aber das lag daran, dass sie Klassenfanatiker waren und John pleite war! Findest du das normal?"

# game/scripts/c14/c14.rpy:3892
translate german c14s006_Christmas_85a1caa0:

    # mee "¡Son familia, por el amor de Dios!"
    mee "Das ist doch Familie, um Himmels willen!"

# game/scripts/c14/c14.rpy:3894
translate german c14s006_Christmas_d5e2b20e:

    # mee "¡La diferencia de edad es enorme!"
    mee "Der Altersunterschied ist enorm!"

# game/scripts/c14/c14.rpy:3896
translate german c14s006_Christmas_c507a76b:

    # bet "Y cuantos más impedimentos pongas, más fuerte se va a hacer su relación. ¿No lo puedes ver?"
    bet "Und je mehr Hindernisse man ihnen in den Weg legt, desto stärker wird ihre Beziehung. Siehst du das nicht ein?"

# game/scripts/c14/c14.rpy:3897
translate german c14s006_Christmas_ad5eff57:

    # bet "En África he visto relaciones de todo tipo. Las que tú consideras normales y las que no. De los dos tipos han funcionado y de los dos tipos se han roto."
    bet "In Afrika habe ich alle Arten von Beziehungen gesehen. Die, die man für normal hält, und die, die man nicht für normal hält. Beide Arten haben funktioniert, und beide sind gescheitert."

# game/scripts/c14/c14.rpy:3898
translate german c14s006_Christmas_176835aa:

    # bet "Esto parece especial, ¿no?"
    bet "Das wirkt etwas Besonderes, nicht wahr?"

# game/scripts/c14/c14.rpy:3900
translate german c14s006_Christmas_aaf505d1:

    # mee "*Gruñido* Especial es una forma suave de llamarlo."
    mee "*Grunzen* „Spezial“ ist noch eine Untertreibung."

# game/scripts/c14/c14.rpy:3902
translate german c14s006_Christmas_aa190cb1:

    # bet "Y nuestro [mc] también es especial, ¿no?"
    bet "Und unser [mc] ist auch etwas Besonderes, nicht wahr?"

# game/scripts/c14/c14.rpy:3904
translate german c14s006_Christmas_d2a724d6:

    # mee "*Gruñido* Sí, ya se ve que es especial."
    mee "*Grunzen* Ja, man merkt, dass er etwas Besonderes ist."

# game/scripts/c14/c14.rpy:3906
translate german c14s006_Christmas_60017145:

    # bet "¿Por qué no le das un voto de confianza a ver que sale de esta relación?"
    bet "Warum gibst du der Beziehung nicht eine Chance und schaust, was daraus wird?"

# game/scripts/c14/c14.rpy:3908
translate german c14s006_Christmas_7391561a:

    # mee "*Gruñido* ¡Qué fácil es para ti decirlo!"
    mee "*Grunzen* Wie leicht dir das doch fällt!"

# game/scripts/c14/c14.rpy:3910
translate german c14s006_Christmas_e646a744:

    # kia "Sé que me voy a meter en un asunto familiar en el que no pinto nada, pero escuchadme un momento, por favor."
    kia "Ich weiß, ich mische mich in eine Familienangelegenheit ein, die mich eigentlich nichts angeht, aber bitte hören Sie mir einen Moment zu."

# game/scripts/c14/c14.rpy:3911
translate german c14s006_Christmas_46fff3ea:

    # kia "Cuando [mc] empezó a salir con mi Eileen, no veía ningún futuro a esa relación. Me parecía que [mc] no era lo suficientemente bueno para mi hija."
    kia "Als er mit meiner Eileen zusammenkam, sah ich keine Zukunft in dieser Beziehung. Ich hatte das Gefühl, dass er nicht gut genug für meine Tochter war."

# game/scripts/c14/c14.rpy:3913
translate german c14s006_Christmas_fc9b7e22:

    # mee "¿Qué? ¿Estás diciendo que mi nieto no era lo suficientemente bueno?"
    mee "Was? Wollen Sie damit sagen, dass mein Enkel nicht gut genug war?"

# game/scripts/c14/c14.rpy:3915
translate german c14s006_Christmas_ab6f5705:

    # bet "Déjala acabar, por Dios, Olivia."
    bet "Lass sie doch ausreden, um Gottes Willen, Olivia."

# game/scripts/c14/c14.rpy:3917
translate german c14s006_Christmas_684fb2d6:

    # kia "Gracias, Betty."
    kia "Danke, Betty."

# game/scripts/c14/c14.rpy:3918
translate german c14s006_Christmas_7d17a230:

    # kia "Si me hubiera opuesto a su relación, la hubiera hecho más fuerte artificialmente. Y el tiempo me demostró que estaba equivocada."
    kia "Hätte ich mich gegen ihre Beziehung ausgesprochen, hätte ich sie künstlich gestärkt. Und die Zeit hat mir das Gegenteil bewiesen."

# game/scripts/c14/c14.rpy:3919
translate german c14s006_Christmas_715381ec:

    # kia "Si hay alguien capaz de sacar adelante esta relación, por diferente que sea, es [mc]."
    kia "Wenn es jemanden gibt, der diese Beziehung zum Funktionieren bringen kann, so unterschiedlich sie auch sein mag, dann ist es [mc]."

# game/scripts/c14/c14.rpy:3920
translate german c14s006_Christmas_887f84c9:

    # mc "Gracias, Kiara."
    mc "Danke, Kiara."

# game/scripts/c14/c14.rpy:3921
translate german c14s006_Christmas_76045841:

    # mc "Por cierto, las chicas no saben nada y solo es decisión nuestra cuándo y dónde decírselo, con lo que cuento con vuestra discrección."
    mc "Übrigens, die Mädchen wissen von nichts und es liegt allein in unserer Entscheidung, wann und wo wir es ihnen erzählen, deshalb zähle ich auf Ihre Diskretion."

# game/scripts/c14/c14.rpy:3923
translate german c14s006_Christmas_afc07c9b:

    # kia "Ningún problema. Estoy totalmente de acuerdo y es un asunto vuestro."
    kia "Kein Problem. Ich stimme vollkommen zu, und das ist Ihre Angelegenheit."

# game/scripts/c14/c14.rpy:3924
translate german c14s006_Christmas_6869a41f:

    # mee "*Gruñido* Vale."
    mee "*Grunzen* Okay."

# game/scripts/c14/c14.rpy:3925
translate german c14s006_Christmas_94723c11:

    # bet "Es lo lógico. La noticia puede caer como una bomba."
    bet "Das ist logisch. Die Nachricht könnte wie eine Bombe einschlagen."

# game/scripts/c14/c14.rpy:3927
translate german c14s006_Christmas_67f94806:

    # mc "Perfecto, porque por allí vienen con el hielo. Espero que tengamos la fiesta en paz y no le amargues la Navidad a nadie, Meemaw."
    mc "Perfekt, denn sie bringen ja das Eis mit. Ich hoffe, wir können friedlich feiern und du verdirbst niemandem das Weihnachtsfest, Meemaw."

# game/scripts/c14/c14.rpy:3929
translate german c14s006_Christmas_e3a2a239:

    # mee "*Gruñido* Vale. Pero tú y yo vamos a tener que hablar cuando lleguemos a casa."
    mee "*Grunzen* Okay. Aber wir beide müssen reden, wenn wir zu Hause sind."

# game/scripts/c14/c14.rpy:3932
translate german c14s006_Christmas_83f290af:

    # mee "No estoy protestando. Tan solo creía que era una cosa que hacía dentro de la familia."
    mee "Ich protestiere nicht. Ich dachte nur, es sei etwas, das ich innerhalb der Familie getan hätte."

# game/scripts/c14/c14.rpy:3934
translate german c14s006_Christmas_e6315368:

    # mc "Por allí vienen las chicas con el hielo."
    mc "Da kommen die Mädchen mit dem Eis."

# game/scripts/c14/c14.rpy:3938
translate german c14s006_Christmas_e6315368_1:

    # mc "Por allí vienen las chicas con el hielo."
    mc "Da kommen die Mädchen mit dem Eis."

# game/scripts/c14/c14.rpy:3940
translate german c14s006_Christmas_e91e0cfe:

    # mc "Ya solo faltan por llegar Alexia y Saira, y podremos ir a comer."
    mc "Nur Alexia und Saira sind noch nicht da, dann können wir essen gehen."

# game/scripts/c14/c14.rpy:3942
translate german c14s006_Christmas_12de1401:

    # "Mientras esperáis a Alexia y Saira, se van formando grupitos de conversación."
    "Während ihr auf Alexia und Saira wartet, bilden sich kleine Gruppen von Menschen."

# game/scripts/c14/c14.rpy:3945
translate german c14s006_Christmas_978b03ad:

    # "[mar] y [nor] se apartan para discutir lo que acaba de pasar tras lanzarte una mirada indicándote que no te acerques."
    "[mar] und [nor] treten beiseite, um zu besprechen, was gerade passiert ist, nachdem sie Ihnen einen Blick zugeworfen haben, der Ihnen signalisiert, dass Sie nicht näher kommen sollten."

# game/scripts/c14/c14.rpy:3947
translate german c14s006_Christmas_1ba577de:

    # "[mar] y [nor] se apartan para charlar después de indicarte con una mirada que no te acerques."
    "[mar] und [nor] treten beiseite, um sich zu unterhalten, nachdem sie mit einem Blick signalisiert haben, dass man sich ihnen nicht nähern sollte."

# game/scripts/c14/c14.rpy:3950
translate german c14s006_Christmas_f7e19f40:

    # "Samantha y Kiara empiezan a charlar. Supones por los gestos que la conversación va tanto sobre el brazo como sobre el beso."
    "Samantha und Kiara kommen ins Gespräch. An ihren Gesten erkennt man, dass es in dem Gespräch sowohl um den Arm als auch um den Kuss geht."

# game/scripts/c14/c14.rpy:3951
translate german c14s006_Christmas_e1fc02fa:

    # "Tienes que darle las gracias a Kiara en algún momento, pero prefieres no acercarte."
    "Irgendwann musst du Kiara danken, aber du willst sie lieber nicht ansprechen."

# game/scripts/c14/c14.rpy:3953
translate german c14s006_Christmas_86266bc7:

    # "Samantha y Kiara empiezan a charlar sobre el brazo."
    "Samantha und Kiara unterhalten sich über den Arm."

# game/scripts/c14/c14.rpy:3955
translate german c14s006_Christmas_0888e985:

    # "[dap] y Scarlett han secuestrado a Simone y ha empezado a presentarles a las chicas. Hasta ahora solo conocía a Debbie."
    "[dap] und Scarlett haben Simone entführt und stellen sie nun den anderen Mädchen vor. Bis jetzt kannte sie nur Debbie."

# game/scripts/c14/c14.rpy:3957
translate german c14s006_Christmas_7f47eb10:

    # "[emm] y Eileen se quedan apartadas. Parece que tienen cosas que decirse."
    "[emm] und Eileen stehen abseits. Es scheint, als hätten sie einander etwas zu sagen."

# game/scripts/c14/c14.rpy:3959
translate german c14s006_Christmas_f7f18243:

    # "Tan solo esperas que a [emm] no se le escapen más secretos de los necesarios."
    "Man kann nur hoffen, dass [emm] nicht mehr Geheimnisse durchsickern lässt als unbedingt nötig."

# game/scripts/c14/c14.rpy:3962
translate german c14s006_Christmas_35ac3e9e:

    # "[eri] acude a hacer compañía a Meemaw y Betty, que parecían a punto de tener una discusión."
    "[eri] leistet Meemaw und Betty Gesellschaft, die kurz davor zu stehen schienen, sich zu streiten."

# game/scripts/c14/c14.rpy:3973
translate german c14s006_Christmas_102ac85a:

    # "A lo lejos ves aparecer a Saira. Parece que se ha cambiado nada más bajar del taxi que la ha traído de la universidad."
    "In der Ferne taucht Saira auf. Offenbar hat sie sich verändert, sobald sie aus dem Taxi gestiegen ist, das sie von der Universität gebracht hat."

# game/scripts/c14/c14.rpy:3975
translate german c14s006_Christmas_9457da45:

    # "[emm] te hace señas para que te acerques mientras llama a Saira."
    "[emm] signalisiert Ihnen, näher zu kommen, während Sie Saira anrufen."

# game/scripts/c14/c14.rpy:3976
translate german c14s006_Christmas_d276daf7:

    # emm "¡Saira! Ven aquí, quiero presentarte a alguien."
    emm "Saira! Komm her, ich möchte dich jemandem vorstellen."

# game/scripts/c14/c14.rpy:3978
translate german c14s006_Christmas_135d3b44:

    # sai "Hola, [emm]. Gracias por mandarme la ubicación. Como Lisa se ha ido antes, no sabía donde era."
    sai "Hallo [emm]. Danke, dass du mir den Standort mitgeteilt hast. Da Lisa vorhin gegangen ist, wusste ich nicht, wo er ist."

# game/scripts/c14/c14.rpy:3981
translate german c14s006_Christmas_0a337b23:

    # emm "No pasa nada, lo mejor para nuestras clientas, ¿no?"
    emm "Das ist in Ordnung, es ist das Beste für unsere Kunden, richtig?"

# game/scripts/c14/c14.rpy:3984
translate german c14s006_Christmas_f77bdc26:

    # emm "No pasa nada, para eso estamos las amigas, ¿no?"
    emm "Das ist schon okay, dafür sind Freunde doch da, oder?"

# game/scripts/c14/c14.rpy:3985
translate german c14s006_Christmas_c3f90b4c:

    # emm "Por cierto, te presento a Eileen. Eileen, esta es Saira."
    emm "Übrigens, darf ich Ihnen Eileen vorstellen? Eileen, das ist Saira."

# game/scripts/c14/c14.rpy:3988
translate german c14s006_Christmas_156b44f1:

    # sai "Así que tú eres la famosa Eileen, con la que {b}rompió{/b} antes de estar conmigo, ¿no? Encantada. de. conocerte."
    sai "Du bist also die berühmte Eileen, mit der er Schluss gemacht hat, bevor er mit mir zusammen war, richtig? Freut mich, dich kennenzulernen."

# game/scripts/c14/c14.rpy:3990
translate german c14s006_Christmas_e64a05aa:

    # sai "Así que tú eres la famosa Eileen, la {b}ex-novia{/b} del instituto, ¿no? Encantada. de. conocerte."
    sai "Du bist also die berühmte Eileen, die Ex-Freundin aus der Highschool, richtig? Freut mich, dich kennenzulernen."

# game/scripts/c14/c14.rpy:3992
translate german c14s006_Christmas_92867534:

    # eil "Y tú eres la ex-novia de Portland... Ah, no, perdona... la {b}follamiga{/b} de Portland. No sé si puedo decir lo mismo sobre conocerte."
    eil "Und du bist Portlands Ex-Freundin... Oh, nein, Entschuldigung... Portlands Bettgefährtin. Ich weiß nicht, ob ich das Gleiche über dich sagen kann."

# game/scripts/c14/c14.rpy:3994
translate german c14s006_Christmas_9c321a78:

    # emm "Bueno, os dejo aquí a los tres para que os pongáis al día. Voy a hablar con la abuela antes de que muerda a Tía Betty."
    emm "Okay, ich lasse euch drei jetzt hier, damit ihr euch unterhalten könnt. Ich werde noch mit Oma reden, bevor sie Tante Betty beißt."

# game/scripts/c14/c14.rpy:3995
translate german c14s006_Christmas_b45e6e58:

    # mc "*Susurrando* Sabes que la puedes haber liado, ¿no?"
    mc "*Flüsternd* Du weißt, dass du vielleicht Mist gebaut hast, oder?"

# game/scripts/c14/c14.rpy:3996
translate german c14s006_Christmas_617af5c0:

    # emm "Tarde o temprano se tenían que conocer. Las dos viven en casa... Suerte con las fieras. *Risa*"
    emm "Es war ja klar, dass sie sich früher oder später begegnen würden. Sie leben ja beide zu Hause... Viel Glück mit den wilden Tieren. *lacht*"

# game/scripts/c14/c14.rpy:3998
translate german c14s006_Christmas_12cb9bdf:

    # sai "Me alegra conocerte por fin. Solo había visto fotos tuyas. Estabas mejor en las fotos."
    sai "Ich freue mich, dich endlich kennenzulernen. Ich kannte dich bisher nur von Fotos. Auf den Fotos sahst du besser aus."

# game/scripts/c14/c14.rpy:3999
translate german c14s006_Christmas_caa48aef:

    # eil "Bueno, al menos de mí estaba lo suficientemente orgulloso como para enseñar fotos. Yo no sabía el aspecto que tenías. No me sorprende."
    eil "Nun ja, zumindest war ich stolz genug auf mich, um Fotos zu zeigen. Ich wusste ja nicht, wie du aussiehst. Das überrascht mich nicht."

# game/scripts/c14/c14.rpy:4000
translate german c14s006_Christmas_dda9ef10:

    # mc "Chicas..."
    mc "Mädchen..."

# game/scripts/c14/c14.rpy:4002
translate german c14s006_Christmas_cfa05590:

    # sai "Bueno, a lo mejor no quería enseñarte fotos mías para que no te sintieras mal."
    sai "Vielleicht wollte ich dir keine Bilder von mir zeigen, damit du dich nicht schlecht fühlst."

# game/scripts/c14/c14.rpy:4003
translate german c14s006_Christmas_694d9386:

    # eil "O es posible que sea por que se avergonzaba de haber salido... perdón, haberse acostado contigo."
    eil "Oder vielleicht schämte er sich dafür, mit dir ausgegangen zu sein... Entschuldigung, mit dir geschlafen zu haben."

# game/scripts/c14/c14.rpy:4004
translate german c14s006_Christmas_09a87050:

    # mc "Chicas, dejadlo ya, por favor."
    mc "Mädels, hört endlich damit auf."

# game/scripts/c14/c14.rpy:4006
translate german c14s006_Christmas_a9e4b562:

    # sai "Al menos yo no me lié con nadie una vez lo dejamos, putón."
    sai "Wenigstens habe ich nach unserer Trennung nichts mit irgendjemandem angefangen, du Schlampe."

# game/scripts/c14/c14.rpy:4007
translate german c14s006_Christmas_19030c30:

    # eil "¿Quién coño querría liarse contigo? Si le tuviste que dejar la puerta abierta a que se liara con otras... Fea."
    eil "Wer zum Teufel würde denn mit dir anbandeln wollen? Du hast ihm ja quasi die Möglichkeit gegeben, mit anderen Frauen anzubändeln... Widerlich."

# game/scripts/c14/c14.rpy:4009
translate german c14s006_Christmas_8f27b491:

    # sai "¿Ya se ha ido?" (multiple=2)
    sai "Ist er schon abgereist?" (multiple=2)

# game/scripts/c14/c14.rpy:4010
translate german c14s006_Christmas_146f3b81:

    # eil "¿No nos ve?" (multiple=2)
    eil "Könnt ihr uns nicht sehen?" (multiple=2)

# game/scripts/c14/c14.rpy:4011
translate german c14s006_Christmas_3b396030:

    # mc "¿Qué? ¿Quién?"
    mc "Was? Wer?"

# game/scripts/c14/c14.rpy:4013
translate german c14s006_Christmas_bd8cfe57:

    # sai "Tu hermana." (multiple=2)
    sai "Deine Schwester." (multiple=2)

# game/scripts/c14/c14.rpy:4014
translate german c14s006_Christmas_4392ef66:

    # eil "[emm]." (multiple=2)
    eil "[emm]." (multiple=2)

# game/scripts/c14/c14.rpy:4015
translate german c14s006_Christmas_3f59ed2d:

    # mc "Sí... ya se ha ido. ¿Por qué?"
    mc "Ja... er ist schon weg. Warum?"

# game/scripts/c14/c14.rpy:4018
translate german c14s006_Christmas_0d78fc0a:

    # eil "¿Qué tal el primer día de clase?"
    eil "Wie war dein erster Schultag?"

# game/scripts/c14/c14.rpy:4019
translate german c14s006_Christmas_3e91fc64:

    # sai "Muy pesado, pero por fin ha acabado y me puedo relajar con vosotras."
    sai "Es war wirklich hart, aber jetzt ist es endlich vorbei und ich kann mich mit euch allen entspannen."

# game/scripts/c14/c14.rpy:4020
translate german c14s006_Christmas_db98c677:

    # mc "¿Qué? ¿Qué está pasando aquí? No entiendo nada."
    mc "Was? Was ist hier los? Ich verstehe gar nichts."

# game/scripts/c14/c14.rpy:4022
translate german c14s006_Christmas_3602adb2:

    # eil "Saira y yo nos conocimos anoche, nos presentó [eri]."
    eil "Saira und ich haben uns gestern Abend kennengelernt, sie hat uns einander vorgestellt [eri]."

# game/scripts/c14/c14.rpy:4023
translate german c14s006_Christmas_a02bac1e:

    # sai "Estaba en la piscina tomando el aire después de cenar. Tenía que digerir la conversación contigo. Entonces llegaron las dos."
    sai "Ich saß nach dem Abendessen am Pool und genoss die frische Luft. Ich musste unser Gespräch erst einmal verarbeiten. Dann kamen die beiden an."

# game/scripts/c14/c14.rpy:4025
translate german c14s006_Christmas_63d8eaa0:

    # eil "Digamos que la conversación empezó más o menos como la de ahora, pero [eri] puso paz."
    eil "Sagen wir, das Gespräch begann mehr oder weniger so wie jetzt, aber [eri] hat Frieden geschlossen."

# game/scripts/c14/c14.rpy:4026
translate german c14s006_Christmas_13bf4b37:

    # sai "Bueno, fue un poco más suave..."
    sai "Nun ja, es war etwas milder..."

# game/scripts/c14/c14.rpy:4028
translate german c14s006_Christmas_c0dbabff:

    # eil "Sí, te has pasado con lo de putón. Además tú eso no lo debías saber... y solo fueron un par de citas, no me acosté con nadie."
    eil "Ja, du bist zu weit gegangen, als du mich eine Schlampe genannt hast. Außerdem hättest du das gar nicht wissen können … und es waren ja nur ein paar Dates, ich habe mit niemandem geschlafen."

# game/scripts/c14/c14.rpy:4029
translate german c14s006_Christmas_102e2bcb:

    # sai "¿Y lo de llamarme fea? ¿Tenemos 10 años, Eileen? *Risa*"
    sai "Und was ist mit dem „Ich bin hässlich“? Sind wir zehn Jahre alt, Eileen? *lacht*"

# game/scripts/c14/c14.rpy:4030
translate german c14s006_Christmas_311c06b0:

    # mc "Estoy flipando..."
    mc "Ich flippe aus..."

# game/scripts/c14/c14.rpy:4032
translate german c14s006_Christmas_164be0b6:

    # eil "[eri] nos dijo que no nos sorprendiéramos si [emm] intentaba enfrentarnos hoy de alguna forma."
    eil "[eri] sagte uns, wir sollten uns nicht wundern, wenn [emm] heute versuchen würde, uns in irgendeiner Weise zu konfrontieren."

# game/scripts/c14/c14.rpy:4034
translate german c14s006_Christmas_3824816c:

    # eil "{i}(Y ahora que sé que está contigo, la entiendo perfectamente. Si peleábamos delante tuyo nos ridiculizaríamos a nosotras mismas.){/i}"
    eil "{i}(Und jetzt, wo ich weiß, dass sie bei dir ist, verstehe ich sie vollkommen. Wenn wir vor dir gestritten hätten, hätten wir uns lächerlich gemacht.){/i}"

# game/scripts/c14/c14.rpy:4035
translate german c14s006_Christmas_726c3f15:

    # eil "Supongo que tener a dos ex-novias en la misma comida navideña podía ser un riesgo."
    eil "Ich nehme an, dass es ein Risiko darstellen könnte, zwei Ex-Freundinnen beim selben Weihnachtsessen zu haben."

# game/scripts/c14/c14.rpy:4037
translate german c14s006_Christmas_076eb4a7:

    # sai "¿Ya no soy la follamiga? *Risa* ¿He ascendido a ex-novia?"
    sai "Bin ich etwa nicht mehr der/die Sexpartner/in? *lacht* Wurde ich zur Ex-Freundin befördert?"

# game/scripts/c14/c14.rpy:4039
translate german c14s006_Christmas_b8cfd6a9:

    # sai "Después de lo que dijo [eri], Eileen y yo estuvimos hablando largo y tendido."
    sai "Nach dem, was [eri] gesagt hatte, führten Eileen und ich ein langes Gespräch."

# game/scripts/c14/c14.rpy:4041
translate german c14s006_Christmas_aa265f5d:

    # sai "Tú me habías dicho que estabas con Eileen. Era raro estar hablando con ella en la piscina, después de un mes comiéndome la cabeza."
    sai "Du hast mir gesagt, dass du mit Eileen zusammen bist. Es war seltsam, nach einem Monat, in dem ich von ihr besessen war, mit ihr am Pool zu sprechen."

# game/scripts/c14/c14.rpy:4043
translate german c14s006_Christmas_d4423745:

    # sai "Tú me habías dicho que no habías vuelto con Eileen, pero era raro estar hablando con ella en la piscina después de un mes comiéndome la cabeza."
    sai "Du hattest mir gesagt, dass du nicht wieder mit Eileen zusammengekommen bist, aber es war seltsam, nach einem Monat, in dem sie mich in den Wahnsinn getrieben hatte, mit ihr im Pool zu sprechen."

# game/scripts/c14/c14.rpy:4045
translate german c14s006_Christmas_234e5c34:

    # eil "Empezamos como dos perras celosas, especialmente Saira, y acabamos contándonos los mejores momentos que hemos pasado contigo."
    eil "Wir fingen an wie zwei eifersüchtige Zicken, vor allem Saira, und am Ende erzählten wir uns gegenseitig von den schönsten Momenten, die wir mit dir erlebt haben."

# game/scripts/c14/c14.rpy:4047
translate german c14s006_Christmas_340c7610:

    # eil "Parece que vuelves a estar con las dos... sí, a Saira se le escapó. Haces bien, Saira será una buena incorporación al harén."
    eil "Sieht so aus, als wärst du wieder mit beiden zusammen... ja, Saira hat es ausgeplaudert. Gut für dich, Saira wird eine tolle Bereicherung für den Harem sein."

# game/scripts/c14/c14.rpy:4049
translate german c14s006_Christmas_96103bf0:

    # eil "Parece que vuestro reencuentro fue más frío que el nuestro, pero deberías pensártelo. Saira sería una buena incorporación al harén."
    eil "Eure Wiedervereinigung war wohl etwas kühler als unsere, aber ihr solltet es euch noch einmal überlegen. Saira wäre eine gute Ergänzung für den Harem."

# game/scripts/c14/c14.rpy:4051
translate german c14s006_Christmas_8147fbdd:

    # eil "Parece que vuestro reencuentro no fue tan frío como el nuestro... sí, a Saira se le escapó. Haces bien, Saira será una buena incorporación al harén."
    eil "Eure Wiedervereinigung war wohl nicht so kühl wie unsere … ja, Saira hat es ausgeplaudert. Gut für dich, Saira wird eine tolle Bereicherung für den Harem sein."

# game/scripts/c14/c14.rpy:4053
translate german c14s006_Christmas_16813b17:

    # eil "Parece que nuestros reencuentros contigo fueron igual de frío, pero deberías pensártelo. Saira sería una buena incorporación al harén."
    eil "Unsere Wiedersehen mit dir waren offenbar genauso kühl, aber du solltest es dir noch einmal überlegen. Saira wäre eine gute Ergänzung für den Harem."

# game/scripts/c14/c14.rpy:4054
translate german c14s006_Christmas_583e6a89:

    # mc "¿Qué? ¿Le has dicho lo del harén?"
    mc "Was? Hast du ihm von dem Harem erzählt?"

# game/scripts/c14/c14.rpy:4056
translate german c14s006_Christmas_ef0f64a8:

    # mc "No hay harén, solo estoy saliendo con Saira."
    mc "Es gibt keinen Harem, ich bin nur mit Saira zusammen."

# game/scripts/c14/c14.rpy:4059
translate german c14s006_Christmas_0a11ba44:

    # mc "No hay harén, solo estoy saliendo contigo."
    mc "Es gibt keinen Harem, ich bin einfach nur mit dir zusammen."

# game/scripts/c14/c14.rpy:4061
translate german c14s006_Christmas_a8320589:

    # mc "No hay harén, solo estoy saliendo con una chica."
    mc "Ich habe keinen Harem, ich bin einfach nur mit einem Mädchen zusammen."

# game/scripts/c14/c14.rpy:4063
translate german c14s006_Christmas_e1841300:

    # sai "Después de hablar bastante rato..."
    sai "Nach einem längeren Gespräch..."

# game/scripts/c14/c14.rpy:4065
translate german c14s006_Christmas_1e128303:

    # sai "Nos dimos cuenta de que si estás con las dos es porque te metimos en la cabeza la relación abierta y el haren."
    sai "Uns ist klar geworden, dass, wenn ihr mit beiden zusammen seid, das daran liegt, dass wir euch die Idee einer offenen Beziehung und eines Harems in den Kopf gesetzt haben."

# game/scripts/c14/c14.rpy:4067
translate german c14s006_Christmas_62551a4f:

    # sai "Nos dimos cuenta de que si estás con Eileen y yo puedo tener una oportunidad, es porque te metimos en la cabeza la relación abierta y el haren."
    sai "Uns wurde klar, dass, wenn du mit Eileen zusammen bist und ich eine Chance habe, das daran liegt, dass wir dir die Idee einer offenen Beziehung und eines Harems in den Kopf gesetzt haben."

# game/scripts/c14/c14.rpy:4070
translate german c14s006_Christmas_d23144e1:

    # sai "Me dí cuenta que Eileen proponiendote el harén, quizá me haya dado la oportunidad que necesitaba para volver contigo."
    sai "Mir wurde klar, dass Eileens Vorschlag, dir den Harem zu schenken, mir vielleicht die Gelegenheit gegeben hat, die ich brauchte, um wieder bei dir anzukommen."

# game/scripts/c14/c14.rpy:4072
translate german c14s006_Christmas_6fd24c25:

    # sai "Me dí cuenta que Eileen proponiendote el harén, quizá me de la oportunidad que necesitaba para volver contigo en el futuro."
    sai "Mir wurde klar, dass Eileens Vorschlag, dir den Harem zu geben, mir die Gelegenheit bieten könnte, die ich brauche, um in Zukunft wieder mit dir zusammenzukommen."

# game/scripts/c14/c14.rpy:4074
translate german c14s006_Christmas_56102810:

    # sai "Después nos pasamos un rato riendo." (multiple=2)
    sai "Danach haben wir eine Weile gelacht." (multiple=2)

# game/scripts/c14/c14.rpy:4075
translate german c14s006_Christmas_bf25048c:

    # eil "Y comparando notas. *Risa*" (multiple=2)
    eil "Und dann vergleichen wir unsere Erfahrungen. *lacht*" (multiple=2)

# game/scripts/c14/c14.rpy:4076
translate german c14s006_Christmas_3c1a15a5:

    # sai "Descubrimos que no somos rivales." (multiple=2)
    sai "Wir haben festgestellt, dass wir keine Konkurrenten sind." (multiple=2)

# game/scripts/c14/c14.rpy:4077
translate german c14s006_Christmas_12db876d:

    # eil "Y decidimos hacernos amigas." (multiple=2)
    eil "Und wir beschlossen, Freunde zu werden." (multiple=2)

# game/scripts/c14/c14.rpy:4079
translate german c14s006_Christmas_f9ce5a32:

    # eil "Saira no podía creerse que [emm] fuera a intentar algo como lo que ha hecho, pero yo la conozco mejor."
    eil "Saira konnte nicht glauben, dass [emm] so etwas versuchen würde, aber ich kenne sie besser."

# game/scripts/c14/c14.rpy:4081
translate german c14s006_Christmas_7dad870f:

    # sai "Traté poco con ella ayer, parecía enfadada, pero creía que tenía que ver con la situación de Scarlett."
    sai "Ich habe gestern nicht viel mit ihr gesprochen; sie wirkte wütend, aber ich dachte, das hätte etwas mit Scarletts Situation zu tun."

# game/scripts/c14/c14.rpy:4083
translate german c14s006_Christmas_e55bb51d:

    # sai "Traté poco con ella ayer, parecía una chica muy agradable."
    sai "Ich habe gestern nicht viel mit ihr gesprochen, sie machte einen sehr netten Eindruck."

# game/scripts/c14/c14.rpy:4084
translate german c14s006_Christmas_e29c8e39:

    # mc "Es muy agradable... cuando quiere. Supongo que querrá después de que le de unos azotes. *Risa*"
    mc "Er ist sehr nett … wenn er will. Ich nehme an, das wird er wollen, nachdem ich ihm ein paar Klapse gegeben habe. *Lacht*"

# game/scripts/c14/c14.rpy:4086
translate german c14s006_Christmas_2a35a010:

    # eil "Déjale creer que nos hemos peleado. Será una pequeña victoria en su cabeza."
    eil "Soll er doch glauben, wir hätten gestritten. Das wird für ihn ein kleiner Sieg sein."

# game/scripts/c14/c14.rpy:4087
translate german c14s006_Christmas_11c00290:

    # sai "Y nos dará tiempo de planear nuestra venganza. *Risa*"
    sai "Und es gibt uns Zeit, unsere Rache zu planen. *lacht*"

# game/scripts/c14/c14.rpy:4089
translate german c14s006_Christmas_2891af26:

    # mc "Haced que parezca un accidente. Por allí viene la última invitada y sospecharía enseguida de vosotras."
    mc "Sorge dafür, dass es wie ein Unfall aussieht. Die letzte Gästin kommt gleich hierher und würde dich sofort verdächtigen."

# game/scripts/c14/c14.rpy:4100
translate german c14s006_Christmas_00d216ac:

    # mc "Alexia, ven. Quiero presentarte a alguien."
    mc "Alexia, komm her. Ich möchte dich jemandem vorstellen."

# game/scripts/c14/c14.rpy:4101
translate german c14s006_Christmas_14e3d577:

    # mc "Alexia, Saira. Saira, Alexia."
    mc "Alexia, Saira. Saira, Alexia."

# game/scripts/c14/c14.rpy:4103
translate german c14s006_Christmas_8777e192:

    # oma "Encantada de conocerte, Saira. ¿Eres la última estudiante?"
    oma "Schön, dich kennenzulernen, Saira. Bist du die letzte Schülerin?"

# game/scripts/c14/c14.rpy:4104
translate german c14s006_Christmas_042239fa:

    # sai "Sí, llegué ayer. ¿Eres amiga de la familia?"
    sai "Ja, ich bin gestern angekommen. Sind Sie ein Freund der Familie?"

# game/scripts/c14/c14.rpy:4105
translate german c14s006_Christmas_fe99e360:

    # oma "Más o menos. He tenido que ayudar a [mc] en algunas cosas."
    oma "Mehr oder weniger. Ich musste [mc] bei einigen Dingen helfen."

# game/scripts/c14/c14.rpy:4106
translate german c14s006_Christmas_874d55fb:

    # oma "Hola, Eileen. Tenemos que hablar."
    oma "Hallo Eileen, wir müssen reden."

# game/scripts/c14/c14.rpy:4108
translate german c14s006_Christmas_a68d3962:

    # mc "¿Qué tal el viaje, Alexia?"
    mc "Wie war deine Reise, Alexia?"

# game/scripts/c14/c14.rpy:4109
translate german c14s006_Christmas_f915a04a:

    # oma "Muy pesado, pero al menos ya estoy aquí."
    oma "Es war ein langer Weg, aber wenigstens bin ich jetzt hier."

# game/scripts/c14/c14.rpy:4110
translate german c14s006_Christmas_716d306f:

    # oma "Me tienes que contar qué querías el lunes cuando me llamaste."
    oma "Du musst mir sagen, was du am Montag wolltest, als du mich angerufen hast."

# game/scripts/c14/c14.rpy:4111
translate german c14s006_Christmas_325f881f:

    # mc "Te tengo que contar muchas cosas, Alexia, pero habrá tiempo."
    mc "Ich habe dir viel zu erzählen, Alexia, aber dafür wird es noch Zeit geben."

# game/scripts/c14/c14.rpy:4112
translate german c14s006_Christmas_caa9a5c2:

    # mc "Creo que te estaban esperando para comer. A estas alturas Tía Betty se tiene que estar muriendo de hambre."
    mc "Ich glaube, sie haben darauf gewartet, dass du isst. Tante Betty muss jetzt total ausgehungert sein."

# game/scripts/c14/c14.rpy:4115
translate german c14s006_Christmas_3f8bae97:

    # "Recogéis las sombrillas y las sillas y os dirigís al merendero."
    "Sie sammeln die Sonnenschirme und Stühle ein und begeben sich zum Picknickplatz."

# game/scripts/c14/c14.rpy:4117
translate german c14s006_Christmas_171f3852:

    # "Emma y Scarlett reparten gorros navideños para todos."
    "Emma und Scarlett verteilen Weihnachtsmützen an alle."

# game/scripts/c14/c14.rpy:4119
translate german c14s006_Christmas_6d2bc954:

    # "Después de lo que ha pasado durante la mañana, no te extraña que los grupos se entremezclen."
    "Nach dem, was heute Morgen passiert ist, ist es kein Wunder, dass sich die Gruppen vermischen."

# game/scripts/c14/c14.rpy:4121
translate german c14s006_Christmas_007c3147:

    # "No parece haber diferencia entre familia, estudiantes, y las chicas de la ciudad."
    "Es scheint keinen Unterschied zwischen Familien, Studentinnen und Stadtmädchen zu geben."

# game/scripts/c14/c14.rpy:4123
translate german c14s006_Christmas_06c9ac7f:

    # "Todo el mundo parece dispuesto a pasárselo bien y disfrutar de la comida."
    "Alle scheinen in Feierlaune zu sein und das Essen zu genießen."

# game/scripts/c14/c14.rpy:4125
translate german c14s006_Christmas_1d87fb41:

    # "Algunos gorros duran poco en las cabezas y acaban encima de la mesa. Hace demasiado calor para llevarlos en pleno verano."
    "Manche Hüte bleiben nicht lange auf dem Kopf und landen am Ende auf dem Tisch. Im Hochsommer sind sie einfach zu heiß."

# game/scripts/c14/c14.rpy:4127
translate german c14s006_Christmas_a9208bfb:

    # "Es vuestra primera Navidad juntos. ¿Quién sabe cómo será la próxima, la de verdad?"
    "Dies ist euer erstes gemeinsames Weihnachtsfest. Wer weiß, wie das nächste, das richtige Weihnachtsfest, sein wird?"

# game/scripts/c14/c14.rpy:4136
translate german c14s006_Christmas_b2b9fa2b:

    # "Hay más gente que te gustaría que estuviera aquí. Y todavía faltan por llegar las últimas estudiantes. En la Navidad de verdad estarán."
    "Es gibt noch weitere Leute, die Sie hier gerne sehen würden. Und die letzten Studenten sind noch nicht da. Sie werden erst zu Weihnachten hier sein."

# game/scripts/c14/c14.rpy:4137
translate german c14s006_Christmas_2031e2a1:

    # "¿Pero habrá vuelto Meemaw a Florida por entonces? ¿Tía Betty estará en algún hospital de África?"
    "Aber wird Meemaw bis dahin wieder in Florida sein? Wird Tante Betty in irgendeinem Krankenhaus in Afrika liegen?"

# game/scripts/c14/c14.rpy:4139
translate german c14s006_Christmas_b3eee4f3:

    # "La sonrisa de Scarlett te saca de tus ensoñaciones."
    "Scarletts Lächeln reißt dich aus deinen Tagträumen."

# game/scripts/c14/c14.rpy:4140
translate german c14s006_Christmas_4b9e4cd6:

    # sca "¿Pasa algo, [mc]? Te veo ausente..."
    sca "Ist etwas nicht in Ordnung, [mc]? Du wirkst so abwesend..."

# game/scripts/c14/c14.rpy:4141
translate german c14s006_Christmas_85f4e9f8:

    # mc "No, cielo, no pasa nada. Solo estaba pensando en la próxima Navidad, la de verdad."
    mc "Nein, Schatz, schon gut. Ich habe nur an das nächste Weihnachtsfest gedacht, das richtige."

# game/scripts/c14/c14.rpy:4143
translate german c14s006_Christmas_0a62ee21:

    # sca "La verdad es que ésta ha salido un poco sosa, ¿cierto? Al final es un día de playa comiendo con ridículos gorros navideños."
    sca "Ehrlich gesagt, war das Ganze etwas langweilig, nicht wahr? Im Endeffekt ist es doch nur ein Tag am Strand, an dem man isst und dabei alberne Weihnachtsmützen trägt."

# game/scripts/c14/c14.rpy:4144
translate german c14s006_Christmas_007ebe11:

    # mc "¡Hey! No es nada sosa. No había visto nunca a 19 personas pasándoselo bien juntos sin malos rollos. Y menos habiendo familia en la mezcla."
    mc "Hey! Langweilig ist das hier überhaupt nicht. Ich habe noch nie 19 Leute gesehen, die so viel Spaß zusammen hatten, ohne dass es zu irgendwelchen Streitereien kam. Vor allem, wenn die Familie mitspielt."

# game/scripts/c14/c14.rpy:4146
translate german c14s006_Christmas_bcfa7996:

    # sca "La verdad es que tienes una familia increíble. Gracias por acogerme, [mc]. A [nor], a [mar] y a las chicas las he inundado de gracias, pero si no hubiera sido por ti..."
    sca "Ehrlich gesagt, ihr habt eine wundervolle Familie. Vielen Dank für den herzlichen Empfang, [mc]. Ich habe mich bereits bei den Mädchen, [nor] und [mar], überschwänglich bedankt, aber ohne euch…"

# game/scripts/c14/c14.rpy:4147
translate german c14s006_Christmas_12abece5:

    # mc "No hace falta que des las gracias. Y te equivocas en una cosa, no tengo una familia increíble. La tenemos. Tú, yo, las chicas..."
    mc "Du brauchst mir nicht zu danken. Und in einem Punkt irrst du dich: Ich habe keine tolle Familie. Doch, haben wir. Du, ich, die Mädchen …"

# game/scripts/c14/c14.rpy:4148
translate german c14s006_Christmas_a9087ca8:

    # mc "Mira lo que has conseguido que hagamos y dime que no parecemos una gran familia."
    mc "Schau dir an, was du uns angetan hast, und sag mir dann, dass wir nicht wie eine große Familie aussehen."

# game/scripts/c14/c14.rpy:4149
translate german c14s006_Christmas_f015529a:

    # sca "*Risa* Nada que ver con mi concepto de familia. No hay nadie discutiendo. Me podría acostumbrar a esto."
    sca "*Lacht* Das hat nichts mit meinem Familienverständnis zu tun. Niemand streitet. Daran könnte ich mich gewöhnen."

# game/scripts/c14/c14.rpy:4150
translate german c14s006_Christmas_6d4d214a:

    # mc "Lo harás. No pensamos dejarte escapar. *Risa*"
    mc "Das wirst du. Wir lassen dich nicht entkommen. *lacht*"

# game/scripts/c14/c14.rpy:4152
translate german c14s006_Christmas_b110a990:

    # sca "¡Vamos a hacernos una foto juntos!"
    sca "Lasst uns zusammen ein Foto machen!"

# game/scripts/c14/c14.rpy:4153
translate german c14s006_Christmas_7e57e035:

    # mc "¿Una selfie?"
    mc "Ein Selfie?"

# game/scripts/c14/c14.rpy:4154
translate german c14s006_Christmas_f81b7379:

    # sca "No, tonto, una foto de toda la familia junta."
    sca "Nein, Quatsch, ein Foto von der ganzen Familie zusammen."

# game/scripts/c14/c14.rpy:4155
translate german c14s006_Christmas_57d4b6c8:

    # mc "¡Vamos!"
    mc "Aufleuchten!"

# game/scripts/c14/c14.rpy:4157
translate german c14s006_Christmas_d54ed7b9:

    # "Scarlett propone la foto y todo el mundo responde entusiasmado."
    "Scarlett schlägt das Foto vor und alle reagieren begeistert."

# game/scripts/c14/c14.rpy:4159
translate german c14s006_Christmas_2117895e:

    # todas "¡Feliz Navidad!"
    todas "Frohe Weihnachten!"

# game/scripts/c14/c14.rpy:4160
translate german c14s006_Christmas_71f0ba30:

    # "Con el paso del tiempo, los que salís en la foto consideraréis ese momento como el pistoletazo de salida para vuestra familia."
    "Mit der Zeit werden diejenigen von Ihnen, die auf dem Foto zu sehen sind, diesen Moment als den Startschuss für Ihre Familie betrachten."

# game/scripts/c14/c14.rpy:4161
translate german c14s006_Christmas_1eb8fe7c:

    # "Las chicas que se unirán a la familia en los próximos meses mirarán la foto deseando haber estado allí, haber formado parte de la familia desde el primer día."
    "Die Mädchen, die in den kommenden Monaten zur Familie stoßen werden, werden sich das Foto ansehen und sich wünschen, sie wären dabei gewesen, dass sie vom ersten Tag an Teil der Familie gewesen wären."

# game/scripts/c14/c14.rpy:4162
translate german c14s006_Christmas_6299b99f:

    # "Nadie lo sabe en ese momento, pero esa foto acabará en el despacho de la primera Gobernadora de California muchos años después."
    "Damals ahnte es noch niemand, aber viele Jahre später wird dieses Foto im Büro der ersten Gouverneurin Kaliforniens landen."

# game/scripts/c14/c14.rpy:4163
translate german c14s006_Christmas_0b08f94d:

    # "Y más años después todavía, estará encima del escritorio Resolute, en el despacho Oval. Pero esa es otra historia."
    "Und noch viele Jahre später wird es auf dem Resolute Desk im Oval Office stehen. Aber das ist eine andere Geschichte."

# game/scripts/c14/c14.rpy:4165
translate german c14s006_Christmas_d79c5293:

    # "Después de la foto todo el mundo sigue con sus conversaciones. Si la conversación era animada antes, ahora lo es incluso más."
    "Nach dem Foto setzen alle ihre Gespräche fort. Wenn die Unterhaltung vorher schon lebhaft war, ist sie jetzt noch lebhafter."

# game/scripts/c14/c14.rpy:4167
translate german c14s006_Christmas_7dbeec67:

    # dap "Nos deberiamos ir yendo, [mc]."
    dap "Wir sollten anfangen zu gehen, [mc]."

# game/scripts/c14/c14.rpy:4168
translate german c14s006_Christmas_1384af00:

    # mc "¿A dónde?"
    mc "Wohin?"

# game/scripts/c14/c14.rpy:4170
translate german c14s006_Christmas_845213ff:

    # dap "No te acuerdas, ¿verdad? Tenemos que ir a la tienda de Maddie para hacer vuestros personajes de DnD."
    dap "Du erinnerst dich nicht, oder? Wir müssen zu Maddies Laden gehen, um eure D&D-Charaktere zu erstellen."

# game/scripts/c14/c14.rpy:4171
translate german c14s006_Christmas_feeb53b3:

    # mc "Pues no, no me acordaba para nada."
    mc "Nein, ich konnte mich überhaupt nicht erinnern."

# game/scripts/c14/c14.rpy:4172
translate german c14s006_Christmas_d0ab2d02:

    # mc "Vamos a despedirnos de todo el mundo, cogemos unos gorros, y vamos para allí. Voy a ver si queda alguna botella de cava."
    mc "Lasst uns von allen verabschieden, ein paar Hüte schnappen und rübergehen. Ich schaue mal, ob noch Flaschen Cava da sind."

# game/scripts/c14/c14.rpy:4174
translate german c14s006_Christmas_b05ff61a:

    # dap "¿Cava? ¿Gorros?"
    dap "Cava? Hüte?"

# game/scripts/c14/c14.rpy:4175
translate german c14s006_Christmas_1c1f91b1:

    # mc "No querrás dejar a Maddie sin celebrar la Navidad, ¿verdad? *Risa*"
    mc "Du willst Maddie doch nicht ohne Weihnachtsfeier zurücklassen, oder? *lacht*"

# game/scripts/c14/c14.rpy:4181
translate german c14s006_KissMartha_774bc444:

    # mom "¿Te importa?"
    mom "Ist es Ihnen wichtig?"

# game/scripts/c14/c14.rpy:4182
translate german c14s006_KissMartha_98a2015f:

    # mc "No, hace tiempo que lo estaba deseando."
    mc "Nein, ich wollte das schon lange machen."

# game/scripts/c14/c14.rpy:4185
translate german c14s006_KissMartha_142cd168:

    # "Tal como ha pasado con [nor], el mundo vuelve a desaparecer. Sabes que la voz de Meemaw está subiendo de tono, pero decides no escucharla."
    "Genau wie bei [nor] verschwindet die Welt wieder. Du weißt, dass Meemaws Stimme höher wird, aber du beschließt, nicht zuzuhören."

# game/scripts/c14/c14.rpy:4187
translate german c14s006_KissMartha_7eb6706a:

    # "El mundo desaparece a vuestro alrededor. Sabes que la voz de Meemaw está subiendo de tono, pero decides no escucharla."
    "Die Welt um dich herum verschwindet. Du weißt, dass Meemaws Stimme immer höher wird, aber du beschließt, nicht zuzuhören."

# game/scripts/c14/c14.rpy:4189
translate german c14s006_KissMartha_fc4dea53:

    # mom "No sabes que peso de encima me he quitado."
    mom "Du kannst dir nicht vorstellen, was für eine Erleichterung mir dadurch entstanden ist."

# game/scripts/c14/c14.rpy:4190
translate german c14s006_KissMartha_6b85ac1c:

    # mc "Lo sé. Salir a la luz es una sensación increíble."
    mc "Ich weiß. Sich der Öffentlichkeit zu öffnen, ist ein unglaubliches Gefühl."

# game/scripts/c14/c14.rpy:4191
translate german c14s006_KissMartha_f7ae8057:

    # mom "Ahora viene el problema. ¿Nos giramos y las escuchamos?"
    mom "Nun liegt das Problem darin. Sollen wir uns umdrehen und ihnen zuhören?"

# game/scripts/c14/c14.rpy:4193
translate german c14s006_KissMartha_0e30a3fb:

    # mee "¿Estáis todos locos? ¿Sabéis lo que estáis haciendo?"
    mee "Seid ihr alle verrückt? Wisst ihr überhaupt, was ihr tut?"

# game/scripts/c14/c14.rpy:4225
translate german c14s007_MaddieDnD_4c84d95a:

    # "Llegáis a la tienda de ropa y Maddie está sola, no hay ningún cliente."
    "Du kommst im Bekleidungsgeschäft an und Maddie ist allein, es sind keine Kunden da."

# game/scripts/c14/c14.rpy:4228
translate german c14s007_MaddieDnD_061e2002:

    # mad "Buenas tardes, [dap]. [mc]."
    mad "Guten Tag, [dap]. [mc]."

# game/scripts/c14/c14.rpy:4229
translate german c14s007_MaddieDnD_7b78d6ee:

    # mc "Hola, Maddie. ¿No tienes clientes hoy?"
    mc "Hallo Maddie. Hast du heute keine Kunden?"

# game/scripts/c14/c14.rpy:4230
translate german c14s007_MaddieDnD_ad0568c2:

    # mad "No suele haber clientes a esta hora en los días laborables. Un poco más tarde quizás."
    mad "An Wochentagen sind um diese Zeit normalerweise keine Kunden da. Vielleicht etwas später."

# game/scripts/c14/c14.rpy:4232
translate german c14s007_MaddieDnD_f23f573a:

    # dap "Entonces genial. Podemos hacer vuestros personajes sin interrupción."
    dap "Super! Wir können ungestört an Ihren Charakteren arbeiten."

# game/scripts/c14/c14.rpy:4233
translate german c14s007_MaddieDnD_42961c19:

    # mc "Pero antes vamos a brindar, ¿no?"
    mc "Aber zuerst lasst uns anstoßen, ja?"

# game/scripts/c14/c14.rpy:4235
translate german c14s007_MaddieDnD_f5d43592:

    # mad "¿Brindar? ¿Por qué?"
    mad "Ein Toast? Warum?"

# game/scripts/c14/c14.rpy:4236
translate german c14s007_MaddieDnD_4901a442:

    # mc "Hemos celebrado una fiesta navideña en la playa y te hemos traído un poco de cava... sin alcohol, que tú estás trabajando y yo tengo que conducir luego."
    mc "Wir haben eine Weihnachtsfeier am Strand veranstaltet und dir etwas Cava mitgebracht... ohne Alkohol, weil du arbeitest und ich danach noch fahren muss."

# game/scripts/c14/c14.rpy:4237
translate german c14s007_MaddieDnD_fbc35e0b:

    # mad "¿Navidad? ¿En Julio? ¿Para eso queríais los gorros de Santa ayer?"
    mad "Weihnachten? Im Juli? Wolltest du gestern etwa Weihnachtsmannmützen dafür?"

# game/scripts/c14/c14.rpy:4239
translate german c14s007_MaddieDnD_3bc0af21:

    # dap "Sí, por lo visto es una costumbre italiana y Scarlett, mi amiga, leyo sobre ella. Lo propuso y lo hemos hecho. *Risa*"
    dap "Ja, anscheinend ist das ein italienischer Brauch, und meine Freundin Scarlett hat darüber gelesen. Sie hat es vorgeschlagen, und wir haben es gemacht. *lacht*"

# game/scripts/c14/c14.rpy:4240
translate german c14s007_MaddieDnD_fe055228:

    # mc "Ha sido divertido. Un dia de playa normal y comida con los gorros. Mucho espíritu navideño sin que nadie discutiera."
    mc "Es war schön. Ein ganz normaler Tag am Strand mit Mittagessen und Hüten. Viel Weihnachtsstimmung und niemand hat gestritten."

# game/scripts/c14/c14.rpy:4242
translate german c14s007_MaddieDnD_995e76bd:

    # dap "Y sin regalos..."
    dap "Und ohne Geschenke..."

# game/scripts/c14/c14.rpy:4243
translate german c14s007_MaddieDnD_a11e50be:

    # mc "¿Quieres un regalo? Estás en una tienda de ropa... corre de mi cuenta. *Risa*"
    mc "Brauchst du ein Geschenk? Du bist in einem Bekleidungsgeschäft... geht auf mich. *lacht*"

# game/scripts/c14/c14.rpy:4245
translate german c14s007_MaddieDnD_cfb16629:

    # mad "Estáis locos, pero trae ese champagne. *Risa*"
    mad "Ihr seid alle verrückt, aber bringt den Champagner mit. *lacht*"

# game/scripts/c14/c14.rpy:4246
translate german c14s007_MaddieDnD_06553e8d:

    # mc "Es cava..."
    mc "Es ist Sekt..."

# game/scripts/c14/c14.rpy:4247
translate german c14s007_MaddieDnD_2dca0aea:

    # mad "Bueno, lo que sea. *Risa*"
    mad "Na ja, egal. *lacht*"

# game/scripts/c14/c14.rpy:4249
translate german c14s007_MaddieDnD_003746c6:

    # mc "Feliz Navidad, Maddie."
    mc "Frohe Weihnachten, Maddie."

# game/scripts/c14/c14.rpy:4250
translate german c14s007_MaddieDnD_04b7c815:

    # dap "¡Feliz Navidad!" (multiple=2)
    dap "Frohe Weihnachten!" (multiple=2)

# game/scripts/c14/c14.rpy:4251
translate german c14s007_MaddieDnD_0c9ede57:

    # mad "¡Feliz Navidad, chicos!" (multiple=2)
    mad "Frohe Weihnachten, Leute!" (multiple=2)

# game/scripts/c14/c14.rpy:4253
translate german c14s007_MaddieDnD_482f9740:

    # dap "¿Podemos hacer los personajes ya? He traído la tablet para apuntar los datos. En casa, [emm] hará una ilustración de vuestros personajes y tendréis la hoja de personaje en papel."
    dap "Können wir jetzt mit der Charaktererstellung beginnen? Ich habe das Tablet mitgebracht, um die Informationen aufzuschreiben. Zuhause zeichnet [emm] eine Illustration eurer Charaktere, und ihr bekommt den Charakterbogen ausgedruckt."

# game/scripts/c14/c14.rpy:4254
translate german c14s007_MaddieDnD_074455aa:

    # mc "Me vas a tener que explicar como funciona todo."
    mc "Du musst mir erklären, wie das alles funktioniert."

# game/scripts/c14/c14.rpy:4255
translate german c14s007_MaddieDnD_1241d032:

    # dap "Ningún problema. Ya te expliqué el mundo. Ahora te enseñaré las reglas."
    dap "Kein Problem. Ich habe dir die Welt ja schon erklärt. Jetzt bringe ich dir die Regeln bei."

# game/scripts/c14/c14.rpy:4257
translate german c14s007_MaddieDnD_1511a305:

    # mad "Deberías explicarme el mundo a mí también."
    mad "Du solltest mir auch die Welt erklären."

# game/scripts/c14/c14.rpy:4258
translate german c14s007_MaddieDnD_2029f14a:

    # mc "Es super original, al menos para alguien que nunca ha jugado a esto."
    mc "Das ist super originell, zumindest für jemanden, der dieses Spiel noch nie zuvor gespielt hat."

# game/scripts/c14/c14.rpy:4266
translate german c14s007_MaddieDnD_6f7a6ac9:

    # dap "Imagínate nuestro mundo a finales del Siglo II. El Imperio Romano está en su auge. Entonces se abren una serie de portales a otros mundos y entran los diferentes seres de fantasía."
    dap "Stellt euch unsere Welt am Ende des 2. Jahrhunderts vor. Das Römische Reich steht auf seinem Höhepunkt. Plötzlich öffnen sich Portale zu anderen Welten, und verschiedene Fantasiewesen betreten sie."

# game/scripts/c14/c14.rpy:4267
translate german c14s007_MaddieDnD_7e12dd88:

    # dap "Elfos, orcos, enanos, dragones... Pero no solo entran ellos, sino que además sus Dioses les acompañan. Y también la magia."
    dap "Elfen, Orks, Zwerge, Drachen … Doch sie sind nicht die Einzigen, die eintreten; ihre Götter begleiten sie. Und auch Magie."

# game/scripts/c14/c14.rpy:4269
translate german c14s007_MaddieDnD_9bc0bac6:

    # mad "Pobres romanos. Les va a caer la del pulpo."
    mad "Die armen Römer. Sie werden bekommen, was sie verdienen."

# game/scripts/c14/c14.rpy:4270
translate german c14s007_MaddieDnD_c1d3dfb0:

    # mc "Yo pensé lo mismo, pero espera..."
    mc "Ich dachte dasselbe, aber warte mal..."

# game/scripts/c14/c14.rpy:4272
translate german c14s007_MaddieDnD_be5d83ef:

    # dap "Esos pueblos aparecen muy al norte y muy al sur. Elfos, Enanos y Medianos en Escandinavia, los pueblos faericos en las Islas Británicas, y los Orcos y Goblins en Siberia."
    dap "Diese Völker tauchen weit im Norden und weit im Süden auf. Elfen, Zwerge und Halblinge in Skandinavien, die Feenvölker auf den Britischen Inseln und Orks und Goblins in Sibirien."

# game/scripts/c14/c14.rpy:4273
translate german c14s007_MaddieDnD_7e3d5ef7:

    # dap "Hay otras razas en otras partes del planeta de las que vuestros personajes no han oído hablar, con lo que no entraré en ello."
    dap "Es gibt noch andere Völker in anderen Teilen des Planeten, von denen eure Charaktere noch nie gehört haben, deshalb werde ich darauf nicht näher eingehen."

# game/scripts/c14/c14.rpy:4274
translate german c14s007_MaddieDnD_333a7a0c:

    # dap "La parte que nos interesa es Europa. La partida se desarrolla en lo que hoy en día es Austria."
    dap "Uns interessiert vor allem Europa. Das Spiel findet im heutigen Österreich statt."

# game/scripts/c14/c14.rpy:4276
translate german c14s007_MaddieDnD_99bcbc7b:

    # mad "Déjame adivinar, los pueblos que llegan se pelan a los Germanos y los Alpes se convierten en la frontera."
    mad "Lass mich raten, die ankommenden Völker bekämpfen die Deutschen und die Alpen werden zur Grenze."

# game/scripts/c14/c14.rpy:4278
translate german c14s007_MaddieDnD_48023f27:

    # dap "Más o menos. Los Germanos desaparecen, son absorbidos, o se refugian en el Imperio, y los Enanos fundan sus reinos en la cara norte de los Alpes."
    dap "So ungefähr. Die Germanen verschwinden, werden assimiliert oder suchen Zuflucht im Imperium, und die Zwerge gründeten ihre Königreiche auf der Nordseite der Alpen."

# game/scripts/c14/c14.rpy:4279
translate german c14s007_MaddieDnD_fda8cec8:

    # dap "Los elfos atraviesan la Galia y se establecen en lo que sería España, Portugal y el sur de Francia."
    dap "Die Elfen durchqueren Gallien und siedeln sich in dem Gebiet an, das später Spanien, Portugal und Südfrankreich werden sollte."

# game/scripts/c14/c14.rpy:4280
translate german c14s007_MaddieDnD_5218815c:

    # dap "Los romanos no tienen nada que hacer sin magia en ese momento y reciben hostias en todos lados. En menos de un siglo han perdido toda Europa Occidental."
    dap "Die Römer waren zu diesem Zeitpunkt ohne Magie hilflos und wurden von allen Seiten bedrängt. In weniger als einem Jahrhundert hatten sie ganz Westeuropa verloren."

# game/scripts/c14/c14.rpy:4281
translate german c14s007_MaddieDnD_4d42de70:

    # dap "Pero junto con las razas invasoras también han llegado Dioses que no son adorados por ninguna raza. Esos Dioses se identifican con el Panteón Romano y empiezan a dar poderes a sus sacerdotes."
    dap "Doch mit den einfallenden Völkern kamen auch Götter, die von keinem Volk verehrt werden. Diese Götter identifizieren sich mit dem römischen Pantheon und verleihen ihren Priestern Macht."

# game/scripts/c14/c14.rpy:4283
translate german c14s007_MaddieDnD_a5917141:

    # mad "Y eso equilibra la balanza. Las legiones con clérigos curándolas pueden ser un espectáculo."
    mad "Und das gleicht die Sache aus. Legionen, die von Klerikern geheilt werden, können ein beeindruckender Anblick sein."

# game/scripts/c14/c14.rpy:4284
translate german c14s007_MaddieDnD_aef893fb:

    # mad "¿Qué hay del Cristianismo?"
    mad "Und das Christentum?"

# game/scripts/c14/c14.rpy:4286
translate german c14s007_MaddieDnD_84736935:

    # dap "Prácticamente desaparece, igual que el judaísmo. En un mundo con múltiples Dioses dando poderes a sus clérigos, el precepto del único Dios verdadero no se sustenta."
    dap "Es verschwindet praktisch, genau wie das Judentum. In einer Welt mit mehreren Göttern, die ihren Klerikern Macht verleihen, lässt sich das Gebot des einen wahren Gottes nicht aufrechterhalten."

# game/scripts/c14/c14.rpy:4287
translate german c14s007_MaddieDnD_37ed1056:

    # dap "Y ningún Dios quiere dar poderes a los sacerdotes de esos Dioses. Si lo hacen, estarían negando la existencia de otros Dioses que está muy clara."
    dap "Und kein Gott will den Priestern dieser Götter Macht verleihen. Denn wenn sie es täten, würden sie die Existenz anderer Götter leugnen, was völlig klar ist."

# game/scripts/c14/c14.rpy:4289
translate german c14s007_MaddieDnD_b5d4dd59:

    # mad "Me gusta, tiene lógica. Pero aún queda la magia de los magos... Los elfos tienen y los romanos no."
    mad "Ich mag es, es ergibt Sinn. Aber da ist immer noch die Magie der Zauberer... Elfen besitzen sie, Römer nicht."

# game/scripts/c14/c14.rpy:4291
translate german c14s007_MaddieDnD_6c90460d:

    # dap "Los humanos no somos tontos del todo y en el primer siglo de luchas la gente aprende cómo funciona la magia. Los nuevos Dioses les ayudan a entenderlo."
    dap "Die Menschen sind nicht völlig dumm, und im ersten Jahrhundert der Kämpfe lernen sie, wie Magie funktioniert. Die neuen Götter helfen ihnen dabei, sie zu verstehen."

# game/scripts/c14/c14.rpy:4293
translate german c14s007_MaddieDnD_c1eab4a3:

    # dap "Total que la paz se establece al cabo de un siglo y medio. El norte de los Alpes y de los Cárpatos son los Reinos Enanos."
    dap "So kehrte nach anderthalb Jahrhunderten endlich Frieden ein. Das Land nördlich der Alpen und der Karpaten wurde zu den Zwergenkönigreichen."

# game/scripts/c14/c14.rpy:4294
translate german c14s007_MaddieDnD_a89899b3:

    # dap "España, Portugal y el sur de Francia es territorio elfo. Italia, los Balcanes, Turquía, y toda la costa del Mediterraneo menos lo que tienen los elfos es Romano."
    dap "Spanien, Portugal und Südfrankreich sind Elfengebiet. Italien, der Balkan, die Türkei und die gesamte Mittelmeerküste, mit Ausnahme der Elfengebiete, sind römisch."

# game/scripts/c14/c14.rpy:4296
translate german c14s007_MaddieDnD_25678638:

    # dap "Pasan los siglos y los Enanos empiezan a expandirse echando a los Elfos de sus territorios. El Macizo Central de Francia, los Pirineos, y al final toda España."
    dap "Jahrhunderte vergehen, und die Zwerge beginnen, ihr Gebiet auszudehnen und die Elfen aus ihren Regionen zu vertreiben. Das Zentralmassiv in Frankreich, die Pyrenäen und schließlich ganz Spanien."

# game/scripts/c14/c14.rpy:4297
translate german c14s007_MaddieDnD_52fceac4:

    # dap "En este mundo la enemistad de Elfos y Enanos nace ahí. Los Elfos que quedan tienen que pedir asilo en el Imperio Romano, que se parece más al final de la Edad Media."
    dap "In dieser Welt hat die Feindschaft zwischen Elfen und Zwergen ihren Ursprung dort. Die verbliebenen Elfen müssen im Römischen Reich Asyl suchen, das eher dem späten Mittelalter ähnelt."

# game/scripts/c14/c14.rpy:4298
translate german c14s007_MaddieDnD_e61e64b8:

    # dap "Ahí empieza el equivalente del Renacimiento en este mundo. Algunos siglos antes. En lo que sería nuestro Siglo X, pero sin Cristianismo nadie le llama así."
    dap "Dort beginnt das Äquivalent zur Renaissance in dieser Welt. Einige Jahrhunderte früher. Im heutigen 10. Jahrhundert, aber ohne das Christentum – niemand nennt es so."

# game/scripts/c14/c14.rpy:4300
translate german c14s007_MaddieDnD_52dd91f2:

    # mad "Me gusta. ¿Y qué pasa en Asia? Querría hacerme un personaje que viniera de allí, si es posible."
    mad "Das gefällt mir. Und wie sieht es mit Asien aus? Ich würde gerne eine Figur erschaffen, die von dort stammt, wenn möglich."

# game/scripts/c14/c14.rpy:4302
translate german c14s007_MaddieDnD_2ca7a2ec:

    # dap "Ningún problema. Los Orcos le han dado de hostias a los Chinos. No hay ningún Dios que les quiera ayudar porque ponen a su Emperador al mismo nivel que los Dioses."
    dap "Kein Problem. Die Orks haben die Chinesen vernichtend geschlagen. Kein Gott will ihnen helfen, weil sie ihren Kaiser auf eine Stufe mit den Göttern stellen."

# game/scripts/c14/c14.rpy:4303
translate german c14s007_MaddieDnD_8894c41e:

    # mc "Creo que yo eso no lo tengo que saber, ¿no? Mientras se lo explicas voy al lavabo. ¿Dónde está, Maddie?"
    mc "Ich glaube nicht, dass ich das wissen muss, oder? Während du es ihr erklärst, gehe ich auf die Toilette. Wo ist Maddie?"

# game/scripts/c14/c14.rpy:4305
translate german c14s007_MaddieDnD_dc7a102f:

    # mad "La puerta de la izquierda de los probadores da a un pasillo. Ahí está el lavabo."
    mad "Die Tür links neben den Umkleidekabinen führt in einen Flur. Dort befindet sich das Waschbecken."

# game/scripts/c14/c14.rpy:4306
translate german c14s007_MaddieDnD_0d2bbdb7:

    # mc "OK, Ahora vuelvo."
    mc "Okay, ich bin gleich wieder da."

# game/scripts/c14/c14.rpy:4308
translate german c14s007_MaddieDnD_be862ec1:

    # "Acabas de lavarte las manos después de hacer eso que solo puedes hacer sentado, cuando..."
    "Du hast dir gerade die Hände gewaschen, nachdem du diese Sache erledigt hast, die man nur im Sitzen tun kann, als..."

# game/scripts/c14/c14.rpy:4310
translate german c14s007_MaddieDnD_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c14/c14.rpy:4311
translate german c14s007_MaddieDnD_75924a45:

    # mad "*A través de la puerta* ¿Te encuentras bien? Ya hemos acabado mi personaje."
    mad "*Durch die Tür* Alles in Ordnung? Wir haben meine Figur fertiggestellt."

# game/scripts/c14/c14.rpy:4312
translate german c14s007_MaddieDnD_e617c3f5:

    # mc "Si, ahora salgo. Habéis sido muy rápidas."
    mc "Ja, ich komme jetzt raus. Du warst sehr schnell."

# game/scripts/c14/c14.rpy:4313
translate german c14s007_MaddieDnD_474d4131:

    # mad "*A través de la puerta* Con la aplicación que tiene [dap] en la tablet el personaje se hace muy rápido."
    mad "*Durch die Tür* Mit der Anwendung, die [dap] auf dem Tablet hat, wird die Figur sehr schnell erstellt."

# game/scripts/c14/c14.rpy:4315
translate german c14s007_MaddieDnD_f3c3dd4b:

    # mc "¿Qué te has hecho?"
    mc "Was hast du dir selbst angetan?"

# game/scripts/c14/c14.rpy:4316
translate german c14s007_MaddieDnD_d0c83c5b:

    # mad "*Risa* Tendrás que esperar a la partida para descubrirlo. Puede ser muy divertido."
    mad "*lacht* Das erfährst du erst im Spiel. Es könnte ein Riesenspaß werden."

# game/scripts/c14/c14.rpy:4319
translate german c14s007_MaddieDnD_fe3a1791:

    # mad "Tenía ganas de estar a solas contigo. Feliz Navidad."
    mad "Ich hatte mich darauf gefreut, mit dir allein zu sein. Frohe Weihnachten."

# game/scripts/c14/c14.rpy:4320
translate german c14s007_MaddieDnD_87b0ef7f:

    # mc "Feliz Navidad, preciosa."
    mc "Frohe Weihnachten, meine Schöne."

# game/scripts/c14/c14.rpy:4322
translate german c14s007_MaddieDnD_ab09920f:

    # mad "¿Quieres que volvamos a quedar el viernes en mi casa?"
    mad "Möchtest du dich am Freitag wieder bei mir zu Hause treffen?"

# game/scripts/c14/c14.rpy:4323
translate german c14s007_MaddieDnD_f6b4a967:

    # mc "Por mí genial. ¿Otra película?"
    mc "Das klingt toll. Noch ein Film?"

# game/scripts/c14/c14.rpy:4325
translate german c14s007_MaddieDnD_ffb66364:

    # mad "Para no acabar de verla, mejor no empezarla, ¿no?"
    mad "Wenn man es sowieso nicht zu Ende schauen will, sollte man es besser gar nicht erst anfangen, oder?"

# game/scripts/c14/c14.rpy:4326
translate german c14s007_MaddieDnD_34a4903f:

    # mc "Tienes razón. ¿Te recojo a las 6 como la semana pasada?"
    mc "Du hast Recht. Soll ich dich wie letzte Woche um 6 Uhr abholen?"

# game/scripts/c14/c14.rpy:4328
translate german c14s007_MaddieDnD_6bebe949:

    # mad "Perfecto. A ver si esta vez no te tienes que ir con prisas."
    mad "Perfekt. Hoffentlich musst du dich diesmal nicht beeilen."

# game/scripts/c14/c14.rpy:4329
translate german c14s007_MaddieDnD_d272b675:

    # mc "¡Mierda! Me acabo de acordar que es posible que tenga que recoger a una amiga en Westport el viernes. Pero no sé a que hora, ni siquiera si tendré que ir a buscarla."
    mc "Mist! Mir ist gerade eingefallen, dass ich am Freitag vielleicht eine Freundin in Westport abholen muss. Aber ich weiß nicht, wann genau, oder ob ich sie überhaupt abholen muss."

# game/scripts/c14/c14.rpy:4331
translate german c14s007_MaddieDnD_b7d653e7:

    # mad "Lástima. Si no puedes venir a recogerme, podemos quedar directamente en mi casa."
    mad "Das ist schade. Falls du mich nicht abholen kannst, können wir uns direkt bei mir zu Hause treffen."

# game/scripts/c14/c14.rpy:4332
translate german c14s007_MaddieDnD_c7ee817a:

    # mc "En cuanto sepa algo te lo digo. Espero poder venir."
    mc "Ich melde mich, sobald ich etwas weiß. Ich hoffe, ich kann kommen."

# game/scripts/c14/c14.rpy:4335
translate german c14s007_MaddieDnD_eeb50fb2:

    # mad "Quería hacer esto, pero no quería dejarte en evidencia delante de tu prima. Feliz Navidad, [mc]."
    mad "Ich wollte das eigentlich tun, aber ich wollte dich nicht vor deinem Cousin blamieren. Frohe Weihnachten, [mc]."

# game/scripts/c14/c14.rpy:4336
translate german c14s007_MaddieDnD_6e590a76:

    # mc "Feliz Navidad, Ama."
    mc "Frohe Weihnachten, Ama."

# game/scripts/c14/c14.rpy:4338
translate german c14s007_MaddieDnD_b13729ad:

    # mad "Pásame a buscar el viernes a las 6 como la semana pasada e iremos a mi casa."
    mad "Hol mich am Freitag um 6 Uhr ab, wie letzte Woche, und wir fahren zu mir nach Hause."

# game/scripts/c14/c14.rpy:4339
translate german c14s007_MaddieDnD_6f38d93e:

    # mc "Como quieras. ¿Otra película?"
    mc "Ganz wie du willst. Noch ein Film?"

# game/scripts/c14/c14.rpy:4341
translate german c14s007_MaddieDnD_40be0102:

    # mad "Para no acabar de verla, mejor no empezarla. Tengo otros planes para ti."
    mad "Wenn du es nicht zu Ende schauen willst, fang es lieber gar nicht erst an. Ich habe andere Pläne mit dir."

# game/scripts/c14/c14.rpy:4342
translate german c14s007_MaddieDnD_e69ff576:

    # mc "Espero que esos planes incluyan hablar de lo nuestro... si quieres."
    mc "Ich hoffe, diese Pläne beinhalten auch ein Gespräch über uns... wenn Sie das möchten."

# game/scripts/c14/c14.rpy:4344
translate german c14s007_MaddieDnD_99c2d079:

    # mad "Si te portas bien, sí, podremos hablar. Quedamos a las 6 entonces."
    mad "Wenn du dich benimmst, ja, dann können wir reden. Treffen wir uns dann um 6."

# game/scripts/c14/c14.rpy:4345
translate german c14s007_MaddieDnD_d272b675_1:

    # mc "¡Mierda! Me acabo de acordar que es posible que tenga que recoger a una amiga en Westport el viernes. Pero no sé a que hora, ni siquiera si tendré que ir a buscarla."
    mc "Mist! Mir ist gerade eingefallen, dass ich am Freitag vielleicht eine Freundin in Westport abholen muss. Aber ich weiß nicht, wann genau, oder ob ich sie überhaupt abholen muss."

# game/scripts/c14/c14.rpy:4346
translate german c14s007_MaddieDnD_8012d214:

    # mc "En cuanto sepa algo te lo digo."
    mc "Ich melde mich, sobald ich etwas weiß."

# game/scripts/c14/c14.rpy:4348
translate german c14s007_MaddieDnD_0a3fe072:

    # mad "¿Antepones a una amiga antes que a mí?"
    mad "Stellst du einen Freund vor mich?"

# game/scripts/c14/c14.rpy:4349
translate german c14s007_MaddieDnD_21c2f1d4:

    # mc "Antepongo a cualquiera que me necesite antes que cualquier otra cosa. Espero que no te moleste."
    mc "Ich stelle diejenigen, die mich brauchen, an erste Stelle. Ich hoffe, das stört dich nicht."

# game/scripts/c14/c14.rpy:4351
translate german c14s007_MaddieDnD_cd1f66c5:

    # mad "¿Y si yo te necesitara en ese mismo momento?"
    mad "Was wäre, wenn ich dich genau in diesem Moment bräuchte?"

# game/scripts/c14/c14.rpy:4352
translate german c14s007_MaddieDnD_475476e3:

    # mc "Si fuera algo que no puede esperar, tendrías preferencia... Ama."
    mc "Wenn es etwas wäre, das nicht warten könnte, hättest du Priorität... Liebe."

# game/scripts/c14/c14.rpy:4354
translate german c14s007_MaddieDnD_82a65c03:

    # mad "Respuesta adecuada."
    mad "Richtige Antwort."

# game/scripts/c14/c14.rpy:4357
translate german c14s007_MaddieDnD_4d7e8205:

    # mc "Tenía ganas de hacer esto desde que he entrado. Feliz Navidad, Maddie"
    mc "Das wollte ich schon machen, seit ich hier bin. Frohe Weihnachten, Maddie!"

# game/scripts/c14/c14.rpy:4358
translate german c14s007_MaddieDnD_97b3ea06:

    # mad "Gracias. Feliz Navidad, [mc]."
    mad "Vielen Dank. Frohe Weihnachten, [mc]."

# game/scripts/c14/c14.rpy:4359
translate german c14s007_MaddieDnD_b444f459:

    # mcp "(¿Gracias? ¿Por el beso o por celebrar la Navidad con ella?)"
    mcp "(Danke? Für den Kuss oder dafür, dass ich Weihnachten mit ihr gefeiert habe?)"

# game/scripts/c14/c14.rpy:4361
translate german c14s007_MaddieDnD_55d59c4e:

    # mad "¿Querrías que volvamos a quedar el viernes en mi casa?"
    mad "Hättest du Lust, dich am Freitag wieder bei mir zu Hause zu treffen?"

# game/scripts/c14/c14.rpy:4362
translate german c14s007_MaddieDnD_c49a89f2:

    # mc "Sí, podemos ver otra película o continuar donde lo dejamos."
    mc "Ja, wir können einen anderen Film ansehen oder dort weitermachen, wo wir aufgehört haben."

# game/scripts/c14/c14.rpy:4364
translate german c14s007_MaddieDnD_3bae63de:

    # mad "Como quieras. Aún tenemos mas de media película por ver. Y mucho que continuar si quieres hacerlo."
    mad "Ganz wie du willst. Wir haben noch mehr als die Hälfte des Films vor uns. Und es gibt noch viel mehr zu sehen, wenn du weiterschauen möchtest."

# game/scripts/c14/c14.rpy:4365
translate german c14s007_MaddieDnD_e440230d:

    # mc "Ya veremos. Te recojeré a las 6 como la semana pasada."
    mc "Wir werden sehen. Ich hole dich wie letzte Woche um 6 Uhr ab."

# game/scripts/c14/c14.rpy:4367
translate german c14s007_MaddieDnD_5f2ea2a1:

    # mad "Como queras. A ver si esta vez tenemos suerte y no te tienes que ir con prisas."
    mad "Ganz wie du willst. Hoffen wir, dass wir dieses Mal Glück haben und du nicht so schnell weg musst."

# game/scripts/c14/c14.rpy:4368
translate german c14s007_MaddieDnD_d272b675_2:

    # mc "¡Mierda! Me acabo de acordar que es posible que tenga que recoger a una amiga en Westport el viernes. Pero no sé a que hora, ni siquiera si tendré que ir a buscarla."
    mc "Mist! Mir ist gerade eingefallen, dass ich am Freitag vielleicht eine Freundin in Westport abholen muss. Aber ich weiß nicht, wann genau, oder ob ich sie überhaupt abholen muss."

# game/scripts/c14/c14.rpy:4370
translate german c14s007_MaddieDnD_b7d653e7_1:

    # mad "Lástima. Si no puedes venir a recogerme, podemos quedar directamente en mi casa."
    mad "Das ist schade. Falls du mich nicht abholen kannst, können wir uns direkt bei mir zu Hause treffen."

# game/scripts/c14/c14.rpy:4371
translate german c14s007_MaddieDnD_00e7cef4:

    # mcp "(¿Lástima? ¿Tiene ganas de que vaya? ¿De ser dominada?)"
    mcp "(Mitleid? Will sie, dass ich gehe? Mich unterwerfen lasse?)"

# game/scripts/c14/c14.rpy:4372
translate german c14s007_MaddieDnD_8012d214_1:

    # mc "En cuanto sepa algo te lo digo."
    mc "Ich melde mich, sobald ich etwas weiß."

# game/scripts/c14/c14.rpy:4374
translate german c14s007_MaddieDnD_46335a4a:

    # mad "Si no volvemos ya, [dap] empezará a sospechar."
    mad "Wenn wir nicht bald zurückkehren, wird [dap] Verdacht schöpfen."

# game/scripts/c14/c14.rpy:4376
translate german c14s007_MaddieDnD_1e0ca9ac:

    # mad "Si has acabado, [dap] te está esperando."
    mad "Wenn du fertig bist, wartet [dap] auf dich."

# game/scripts/c14/c14.rpy:4377
translate german c14s007_MaddieDnD_9e86395f:

    # mc "Entonces vamos, aún tengo que hacer mi personaje."
    mc "Ich muss also noch meinen Charakter erstellen."

# game/scripts/c14/c14.rpy:4379
translate german c14s007_MaddieDnD_673d7782:

    # "Ciertamente, con la aplicación diseñáis a Vilfredo il Bisteccone muy rápido."
    "Mit der Anwendung können Sie Vilfredo il Bisteccone sicherlich sehr schnell gestalten."

# game/scripts/c14/c14.rpy:4380
translate german c14s007_MaddieDnD_618305e2:

    # "Teniendo en cuenta que te tiene que explicar las normas, tardáis bastante más de lo que ha tardado Maddie, pero menos de lo que hubieras pensado."
    "Wenn man bedenkt, dass er dir die Regeln erklären muss, brauchst du deutlich länger als Maddie, aber weniger, als du gedacht hättest."

# game/scripts/c14/c14.rpy:4382
translate german c14s007_MaddieDnD_fbc99e4a:

    # dap "Bueno, pues ya hemos acabado. El domingo jugaremos la partida. ¡Qué ganas tengo!"
    dap "So, das war's, wir sind fertig. Wir spielen am Sonntag. Ich freue mich schon riesig!"

# game/scripts/c14/c14.rpy:4383
translate german c14s007_MaddieDnD_a645ca67:

    # mad "¿Me mandáis un mensaje con vuestra dirección? No sé dónde vivís."
    mad "Könnten Sie mir bitte Ihre Adresse schicken? Ich weiß nicht, wo Sie wohnen."

# game/scripts/c14/c14.rpy:4384
translate german c14s007_MaddieDnD_14063c9a:

    # mc "No te preocupes, ya te pasaré a buscar."
    mc "Keine Sorge, ich hole dich ab."

# game/scripts/c14/c14.rpy:4386
translate german c14s007_MaddieDnD_bb7de64f:

    # dap "Hasta el domingo, Maddie."
    dap "Wir sehen uns am Sonntag, Maddie."

# game/scripts/c14/c14.rpy:4387
translate german c14s007_MaddieDnD_fde3f076:

    # mad "Nos vemos, [dap]."
    mad "Bis dann, [dap]."

# game/scripts/c14/c14.rpy:4389
translate german c14s007_MaddieDnD_88500629:

    # mad "Avísame cuando vengas a buscarme. Te veo el domingo, [mc]."
    mad "Sag mir Bescheid, wann du mich abholst. Wir sehen uns am Sonntag, [mc]."

# game/scripts/c14/c14.rpy:4390
translate german c14s007_MaddieDnD_c5897877:

    # mc "Te llamo cuando esté llegando a tu casa... mándame un mensaje con la dirección."
    mc "Ich rufe dich an, wenn ich fast bei dir bin... schick mir vorher eine Nachricht mit der Adresse."

# game/scripts/c14/c14.rpy:4393
translate german c14s007_MaddieDnD_a32623b7:

    # "De nuevo en la camioneta..."
    "Zurück im LKW..."

# game/scripts/c14/c14.rpy:4394
translate german c14s007_MaddieDnD_904416c3:

    # dap "¿Preparado para empezar nuestra cita?"
    dap "Bereit für unser Date?"

# game/scripts/c14/c14.rpy:4395
translate german c14s007_MaddieDnD_fb26c3ee:

    # mc "¿Sin pasar por casa a ducharnos o cambiarnos?"
    mc "Ohne nach Hause gehen zu können, um zu duschen oder sich umzuziehen?"

# game/scripts/c14/c14.rpy:4397
translate german c14s007_MaddieDnD_6b656016:

    # dap "No te preocupes. Te podrás duchar y cambiarte donde vamos."
    dap "Keine Sorge. Du kannst duschen und dich umziehen, wo wir hinfahren."

# game/scripts/c14/c14.rpy:4398
translate german c14s007_MaddieDnD_a669ee8d:

    # mc "¿Cambiarme? No he traído ropa..."
    mc "Wechselgeld? Ich habe keine Kleidung mitgebracht..."

# game/scripts/c14/c14.rpy:4400
translate german c14s007_MaddieDnD_8517d94b:

    # dap "No sabes nada, [mc] Marks. Todo está planeado."
    dap "Du weißt gar nichts, Marks. Das ist alles geplant."

# game/scripts/c14/c14.rpy:4403
translate german c14s007_MaddieDnD_e5c78f6d:

    # "Volvéis a casa y las chicas aún no han llegado. La playa siempre te ha agotado, por mucho que te guste disfrutarla en familia."
    "Du kommst nach Hause und die Mädchen sind immer noch nicht da. Der Strand hat dich schon immer erschöpft, egal wie sehr du ihn mit deiner Familie genießt."

# game/scripts/c14/c14.rpy:4404
translate german c14s007_MaddieDnD_498183ac:

