

# game/scripts/c14/c14.rpy:217
translate german c14s001_ContinuationSam_0ea9a9e3:

    # sim "¿Qué estás haciendo, Mamá?"
    sim "Was machst du da, Mama?"

# game/scripts/c14/c14.rpy:222
translate german c14s001_ContinuationSam_be6bfd53:

    # sam "No es lo que parece..."
    sam "Es ist nicht so, wie es scheint..."

# game/scripts/c14/c14.rpy:226
translate german c14s001_ContinuationSam_5b29bcfb:

    # sim "No, claro. Estar desnuda sentada encima de la polla de mi novio en el sofá no es lo que parece."
    sim "Nein, natürlich nicht. Nackt auf dem Schwanz meines Freundes auf dem Sofa zu sitzen, ist nicht das, was es aussieht."

# game/scripts/c14/c14.rpy:228
translate german c14s001_ContinuationSam_82aaae6f:

    # sim "No, claro. Estar desnuda sentada encima de la polla de [mc] en el sofá no es lo que parece."
    sim "Nein, natürlich nicht. Nackt auf <c4s Schwanz auf dem Sofa zu sitzen, ist nicht das, was es aussieht."

# game/scripts/c14/c14.rpy:231
translate german c14s001_ContinuationSam_86bdc33a:

    # sim "Si hasta te has depilado..."
    sim "Du hast dich sogar gewachst..."

# game/scripts/c14/c14.rpy:236
translate german c14s001_ContinuationSam_94976363:

    # sam "Simone, puedo explicarlo..."
    sam "Simone, ich kann es erklären..."

# game/scripts/c14/c14.rpy:238
translate german c14s001_ContinuationSam_00b0e3ae:

    # sim "Por supuesto, que puedes. [mc] ha venido a tomar té y pastitas, os habéis tirado el té por encima y os habéis tenido que desnudar, ¿verdad?"
    sim "Natürlich kannst du das. [mc] kam zum Tee und Kekse vorbei, ihr habt euch gegenseitig mit Tee bekleckert und musstet euch ausziehen, richtig?"

# game/scripts/c14/c14.rpy:239
translate german c14s001_ContinuationSam_e22da03f:

    # sim "Estoy en shock... tu sabías lo que [mc] significaba para mí..."
    sim "Ich bin geschockt... du wusstest, was [mc] mir bedeutete..."

# game/scripts/c14/c14.rpy:241
translate german c14s001_ContinuationSam_201f5dd5:

    # mc "Simone, ya te dije que..."
    mc "Simone, das habe ich dir doch schon gesagt..."

# game/scripts/c14/c14.rpy:243
translate german c14s001_ContinuationSam_5f487485:

    # sim "¿Y tú? ¿Tú lo sabías...?"
    sim "Und du? Wusstest du das...?"

# game/scripts/c14/c14.rpy:244
translate german c14s001_ContinuationSam_7d2c4615:

    # sim "Claro que lo sabías, que tonterías estoy diciendo... tienes que pasártelo de puta madre follándonos a las dos..."
    sim "Natürlich wusstest du das, was für einen Unsinn rede ich da... du musst ja einen verdammten Spaß daran haben, uns beide zu vögeln..."

# game/scripts/c14/c14.rpy:245
translate german c14s001_ContinuationSam_48378cc2:

    # mc "Simone, te dije que podía haber otras chicas..."
    mc "Simone, ich hab dir doch gesagt, dass es auch andere Mädchen geben könnte..."

# game/scripts/c14/c14.rpy:247
translate german c14s001_ContinuationSam_7f9c9723:

    # sim "Sí, pero no me dijiste que una de ellas era mi madre..."
    sim "Ja, aber du hast mir nicht gesagt, dass eine von ihnen meine Mutter war..."

# game/scripts/c14/c14.rpy:252
translate german c14s001_ContinuationSam_a2c28566:

    # sam "Espera... espera... ¿Tu novio? ¿Estáis saliendo?"
    sam "Moment mal... Moment mal... Dein Freund? Seid ihr zwei zusammen?"

# game/scripts/c14/c14.rpy:254
translate german c14s001_ContinuationSam_e0235614:

    # sim "Sí, Mamá, o lo estábamos hasta hace dos minutos..."
    sim "Ja, Mama, oder zumindest waren wir das bis vor zwei Minuten..."

# game/scripts/c14/c14.rpy:256
translate german c14s001_ContinuationSam_b52a0e3d:

    # sam "¿Y qué es eso de que te estás follando a las dos?"
    sam "Und was soll das mit der Sache, dass du mit beiden geschlafen hast?"

# game/scripts/c14/c14.rpy:261
translate german c14s001_ContinuationSam_c7f51d82:

    # sam "{b}¿Te estás follando a mi niña?{/b}"
    sam "{b}Fickst du meine Freundin?{/b}"

# game/scripts/c14/c14.rpy:262
translate german c14s001_ContinuationSam_84c97c36:

    # mc "Sam..."
    mc "Sam..."

# game/scripts/c14/c14.rpy:267
translate german c14s001_ContinuationSam_d54af1d1:

    # sam "{b}¡Fuera de mi casa!{/b}"
    sam "{b}Raus aus meinem Haus!{/b}"

# game/scripts/c14/c14.rpy:268
translate german c14s001_ContinuationSam_8c90346f:

    # mc "Sam, déjame hablar..."
    mc "Sam, lass mich sprechen..."

# game/scripts/c14/c14.rpy:273
translate german c14s001_ContinuationSam_189750c7:

    # sam "¡No quiero oírte! Nos has engañado a las dos, a la una con la otra... no quiero volver a verte aquí..."
    sam "Ich will nichts mehr von dir hören! Du hast uns beide getäuscht, einen mit dem anderen... Ich will dich hier nie wieder sehen..."

# game/scripts/c14/c14.rpy:274
translate german c14s001_ContinuationSam_c47ae3eb:

    # sam "¡Y además te has aprovechado de mi niña!"
    sam "Und du hast meine kleine Tochter ausgenutzt!"

# game/scripts/c14/c14.rpy:275
translate german c14s001_ContinuationSam_7f896c98:

    # mc "Sam, no os he engañado a ninguna..."
    mc "Sam, ich habe keinen von euch getäuscht..."

# game/scripts/c14/c14.rpy:280
translate german c14s001_ContinuationSam_e7d3f9ba:

    # sam "{b}¡Fuera... de... mi... puta... casa!{/b}"
    sam "{b}Raus... aus... meinem... verdammten... Haus!{/b}"

# game/scripts/c14/c14.rpy:282
translate german c14s001_ContinuationSam_4d72310e:

    # sim "No. También es mi casa y quiero que se quede."
    sim "Nein. Es ist auch mein Haus, und ich möchte, dass sie bleibt."

# game/scripts/c14/c14.rpy:287
translate german c14s001_ContinuationSam_c32b4214:

    # sam "No sabes lo que estás diciendo, Simone. ¡Nos ha engañado a las dos! ¡Lo quiero fuera de aquí! {b}¡Ya!{/b}"
    sam "Du weißt nicht, was du sagst, Simone. Er hat uns beide getäuscht! Ich will ihn hier raus haben! Sofort!"

# game/scripts/c14/c14.rpy:289
translate german c14s001_ContinuationSam_9976b665:

    # sim "A mí no. A mí me dijo que podía ser que saliera con otras mujeres."
    sim "Ich nicht. Er sagte mir, dass er möglicherweise andere Frauen trifft."

# game/scripts/c14/c14.rpy:294
translate german c14s001_ContinuationSam_e3b3cfb3:

    # sam "¿Y tú lo aceptaste?"
    sam "Und du hast es akzeptiert?"

# game/scripts/c14/c14.rpy:296
translate german c14s001_ContinuationSam_e6e21b58:

    # sim "¡Sí, lo acepté! Y hasta que no hablemos de lo que acabo de ver, sigue siendo mi novio. No tienes derecho a echarlo."
    sim "Ja, ich habe es akzeptiert! Und solange wir nicht über das Gesehene gesprochen haben, ist er immer noch mein Freund. Du hast kein Recht, ihn rauszuschmeißen."

# game/scripts/c14/c14.rpy:301
translate german c14s001_ContinuationSam_3c8fc4f0:

    # sam "Pero..."
    sam "Aber..."

# game/scripts/c14/c14.rpy:303
translate german c14s001_ContinuationSam_d02a3030:

    # sim "Mamá, siempre me has dicho que si tenía novio podría traerlo a casa sin problemas. Pues aquí está, aunque lo hayas traído tú para follártelo. No voy a dejar que lo eches."
    sim "Mama, du hast mir immer gesagt, wenn ich einen Freund hätte, könnte ich ihn problemlos mit nach Hause bringen. Nun, da ist er ja, obwohl du ihn nur mitgebracht hast, um bei ihm zu schlafen. Ich lasse dich ihn nicht rausschmeißen."

# game/scripts/c14/c14.rpy:308
translate german c14s001_ContinuationSam_ddfb43c6:

    # sam "Pero... a mí sí que me ha engañado..."
    sam "Aber... er hat mich getäuscht..."

# game/scripts/c14/c14.rpy:309
translate german c14s001_ContinuationSam_2d56d47b:

    # mc "No, Samantha. Tú me dijiste que habías hablado con [mar] y que no te importaba compartir..."
    mc "Nein, Samantha. Du hast mir gesagt, dass du mit [mar] gesprochen hast und dass es dir nichts ausmacht, es weiterzugeben..."

# game/scripts/c14/c14.rpy:311
translate german c14s001_ContinuationSam_50ed2fc1:

    # sim "¿Qué? ¿Estás saliendo también con tu madre?"
    sim "Was? Bist du etwa auch mit deiner Mutter zusammen?"

# game/scripts/c14/c14.rpy:316
translate german c14s001_ContinuationSam_7dccb779:

    # sam "No, fue una conversación hipotética. En aquel momento yo no pensaba que acabaría así... aquí... delante de mi hija..."
    sam "Nein, es war ein hypothetisches Gespräch. In dem Moment hätte ich nie gedacht, dass es so enden würde … hier … vor meiner Tochter …"

# game/scripts/c14/c14.rpy:318
translate german c14s001_ContinuationSam_98f66496:

    # sim "¡Ufff! Me había asustado..."
    sim "Puh! Das hat mich erschreckt..."

# game/scripts/c14/c14.rpy:319
translate german c14s001_ContinuationSam_4bc9d2f5:

    # mc "Sam, no te dije que estaba con otras mujeres por que tú me dijiste eso... lo tomé como que no te importaba..."
    mc "Sam, ich habe dir nicht erzählt, dass ich mit anderen Frauen zusammen war, weil du mir das gesagt hast... Ich habe es so aufgefasst, als wäre es dir egal..."

# game/scripts/c14/c14.rpy:324
translate german c14s001_ContinuationSam_8788c55c:

    # sam "¿Cómo no me va a importar? ¿Cómo crees que me puedo sentir sabiendo que sales con mi hija?"
    sam "Wie könnte mir das egal sein? Wie soll ich mich denn fühlen, wenn ich weiß, dass du mit meiner Tochter ausgehst?"

# game/scripts/c14/c14.rpy:325
translate german c14s001_ContinuationSam_b4b10eb3:

    # sam "Hace un momento decías que no las preferías jóvenes..."
    sam "Vorhin sagten Sie noch, Sie bevorzugen sie nicht jung..."

# game/scripts/c14/c14.rpy:326
translate german c14s001_ContinuationSam_7281e1d0:

    # mc "Y no las prefiero jóvenes, Sam. ¿Todo esto es por el tema de la edad otra vez?"
    mc "Und ich bevorzuge sie nicht jung, Sam. Geht es hier wieder nur ums Alter?"

# game/scripts/c14/c14.rpy:327
translate german c14s001_ContinuationSam_1fccad41:

    # mc "Me gusta Simone y estoy con ella, no por la edad que tiene, sino por quién es. Por cómo es. Y tú me gustas por cómo eres. Me da lo mismo la edad que tengas. Sólo parece importarte a ti."
    mc "Ich mag Simone und bin mit ihr zusammen, nicht wegen ihres Alters, sondern wegen ihrer Persönlichkeit. Und ich mag dich, weil du so bist, wie du bist. Dein Alter ist mir egal. Scheint nur für dich wichtig zu sein."

# game/scripts/c14/c14.rpy:330
translate german c14s001_ContinuationSam_8de1d9b7:

    # sim "*Risa*"
    sim "*Lachen*"

# game/scripts/c14/c14.rpy:335
translate german c14s001_ContinuationSam_73e751ed:

    # mc "¿Qué pasa?" (multiple=2)
    mc "Was passiert?" (multiple=2)

# game/scripts/c14/c14.rpy:336
translate german c14s001_ContinuationSam_99d3d593:

    # sam "¿De qué te ríes?" (multiple=2)
    sam "Worüber lachst du?" (multiple=2)

# game/scripts/c14/c14.rpy:338
translate german c14s001_ContinuationSam_87930fcc:

    # sim "Me acabo de dar cuenta de lo ridículo de la situación..."
    sim "Mir ist gerade erst klar geworden, wie absurd die Situation ist..."

# game/scripts/c14/c14.rpy:344
translate german c14s001_ContinuationSam_6278532a:

    # mc "No te entiendo" (multiple=2)
    mc "Ich verstehe Sie nicht" (multiple=2)

# game/scripts/c14/c14.rpy:345
translate german c14s001_ContinuationSam_a2b96805:

    # sam "¿Qué te parece ridículo de todo esto?" (multiple=2)
    sam "Was finden Sie an all dem lächerlich?" (multiple=2)

# game/scripts/c14/c14.rpy:347
translate german c14s001_ContinuationSam_26fc2ba9:

    # sim "Primero que los dos estáis en pelotas en medio del salón."
    sim "Zunächst einmal seid ihr beide nackt mitten im Wohnzimmer."

# game/scripts/c14/c14.rpy:352
translate german c14s001_ContinuationSam_cd99faad:

    # sam "¡Oops! ¡[mc], tápate!"
    sam "Hoppla! Decke dich ab!"

# game/scripts/c14/c14.rpy:353
translate german c14s001_ContinuationSam_60170bca:

    # mc "No es nada que no hayáis visto antes las dos, no quiero interrumpir a Simone antes de saber el resto de los puntos por lo que la situación le parece ridícula."
    mc "Das ist nichts, was ihr beide nicht schon einmal gesehen hättet. Ich möchte Simone nicht unterbrechen, bevor sie die restlichen Punkte kennt, weshalb ihr die Situation lächerlich erscheint."

# game/scripts/c14/c14.rpy:355
translate german c14s001_ContinuationSam_b11b492d:

    # sim "Os dais cuenta de que soy yo quien os ha pillado, ¿verdad?"
    sim "Dir ist schon klar, dass ich dich erwischt habe, oder?"

# game/scripts/c14/c14.rpy:360
translate german c14s001_ContinuationSam_db5df92a:

    # sam "Sí, claro, pero no veo qué tiene que ver con que sea ridículo."
    sam "Ja, natürlich, aber ich sehe nicht, was das damit zu tun hat, dass es lächerlich ist."

# game/scripts/c14/c14.rpy:361
translate german c14s001_ContinuationSam_3ba08259:

    # mc "Yo creo que sé por dónde va."
    mc "Ich glaube, ich weiß, worauf das hinausläuft."

# game/scripts/c14/c14.rpy:363
translate german c14s001_ContinuationSam_2075b658:

    # sim "Os he pillado yo y me he enfadado, pero parece que la más ofendida seas tú, Mamá. Y estás aquí en pelotas, gesticulando y enfadada..."
    sim "Ich habe dich erwischt und bin wütend, aber du scheinst am meisten beleidigt zu sein, Mama. Und da stehst du nun, splitternackt, gestikulierst wild und bist wütend..."

# game/scripts/c14/c14.rpy:364
translate german c14s001_ContinuationSam_45019296:

    # sim "Es gracioso. Quieres echar de {b}nuestra{/b} casa a {b}nuestro{/b} novio, sin tener en cuenta mi opinión. Tan solo porque las dos salimos con él."
    sim "Das ist ja witzig. Du willst unseren Freund aus unserem Haus werfen, ohne meine Meinung zu berücksichtigen. Nur weil wir beide mit ihm zusammen sind."

# game/scripts/c14/c14.rpy:369
translate german c14s001_ContinuationSam_fa3dff8a:

    # sam "Y porque nos ha engañado..."
    sam "Und weil er uns getäuscht hat..."

# game/scripts/c14/c14.rpy:371
translate german c14s001_ContinuationSam_47ccd05f:

    # sim "A mí no, Mamá. Me lo dijo antes de aceptar salir conmigo, o de que yo aceptara salir con él. Y si lo he entendido bien, tú también le diste autorización."
    sim "Nicht ich, Mama. Er hat es mir gesagt, bevor er mit mir ausgegangen ist, oder bevor ich mit ihm ausgegangen bin. Und wenn ich es richtig verstanden habe, hast du ihm auch deine Erlaubnis gegeben."

# game/scripts/c14/c14.rpy:376
translate german c14s001_ContinuationSam_698d45b5:

    # sam "Pero era en un caso hipotético..."
    sam "Das war aber nur ein hypothetischer Fall..."

# game/scripts/c14/c14.rpy:378
translate german c14s001_ContinuationSam_81f0c9d0:

    # sim "Y la hipótesis se convirtió en realidad. ¿Estarías igual si en vez de conmigo se estuviera acostando con [mar]? Dejemos de lado lo raro que sería. ¿Te enfadaría igual?"
    sim "Und die Hypothese wurde Realität. Würdest du genauso empfinden, wenn er statt mir mit [mar] schlafen würde? Mal abgesehen davon, wie seltsam das wäre. Wärst du genauso wütend?"

# game/scripts/c14/c14.rpy:383
translate german c14s001_ContinuationSam_1df0ebb0:

    # sam "Supongo que no..."
    sam "Ich nehme an, nicht..."

# game/scripts/c14/c14.rpy:385
translate german c14s001_ContinuationSam_66b3d6ee:

    # sim "Y si hubiera vuelto con Eileen tampoco, ¿verdad?"
    sim "Und wenn ich zu Eileen zurückgekehrt wäre, wäre das auch nicht passiert, nicht wahr?"

# game/scripts/c14/c14.rpy:390
translate german c14s001_ContinuationSam_b7361115:

    # sam "No sé... quizás un poco más..."
    sam "Ich weiß nicht... vielleicht ein bisschen mehr..."

# game/scripts/c14/c14.rpy:392
translate german c14s001_ContinuationSam_e6f009fc:

    # sim "Entonces si saliera con [mar] no te enfadarías, con Eileen un poco, y porque sale conmigo te pones hecha una furia."
    sim "Wenn ich also mit [mar] zusammen wäre, würdest du nicht wütend werden, bei Eileen ein bisschen, und weil sie mit mir zusammen ist, bist du wütend."

# game/scripts/c14/c14.rpy:393
translate german c14s001_ContinuationSam_c34e9336:

    # sim "¿Puedes ver el patrón? Cuanto más joven sea la chica más te enfadas. Creo que el problema está en que te sientes amenazada por chicas más jóvenes."
    sim "Erkennst du das Muster? Je jünger das Mädchen, desto wütender wirst du. Ich glaube, das Problem ist, dass du dich von jüngeren Mädchen bedroht fühlst."

# game/scripts/c14/c14.rpy:398
translate german c14s001_ContinuationSam_0a979f5e:

    # sam "{b}¡No es eso!{/b} Con [mar] lo habíamos hablado, aunque solo fuera en broma. Si volviera con Eileen... todos lo esperábamos..."
    sam "{b}Das ist es nicht!{/b} Ich hatte mit [mar] darüber gesprochen, auch wenn es nur im Scherz war. Wenn er wieder mit Eileen zusammenkäme … hätten wir es alle erwartet …"

# game/scripts/c14/c14.rpy:399
translate german c14s001_ContinuationSam_9a83ba9b:

    # sam "¿Pero tú? ¡Tú eres mi niña! No puedo dejar que nadie se aproveche de ti..."
    sam "Aber du? Du bist mein kleines Mädchen! Ich kann nicht zulassen, dass dich irgendjemand ausnutzt..."

# game/scripts/c14/c14.rpy:401
translate german c14s001_ContinuationSam_9d1e9d37:

    # sim "Nadie se está aprovechando, Mamá. Yo estuve de acuerdo. No me imaginaba que también estuviera contigo, pero estuve de acuerdo."
    sim "Niemand nutzt das aus, Mama. Ich habe zugestimmt. Ich hätte nicht gedacht, dass ich auch mit dir zusammen sein würde, aber ich habe zugestimmt."

# game/scripts/c14/c14.rpy:402
translate german c14s001_ContinuationSam_ab0868b9:

    # sim "Y posiblemente siga estándolo una vez acabemos esta conversación y tenga un momento para hablar con mi novio."
    sim "Und wahrscheinlich wird es auch dann noch so sein, wenn wir dieses Gespräch beendet haben und ich Zeit habe, mit meinem Freund zu sprechen."

# game/scripts/c14/c14.rpy:407
translate german c14s001_ContinuationSam_b6699f85:

    # sam "{b}Nuestro{/b}."
    sam "{b}Unser{/b}."

# game/scripts/c14/c14.rpy:409
translate german c14s001_ContinuationSam_7b66c460:

    # sim "Hace un momento lo querías echar de casa. ¿Ahora vuelve a ser nuestro novio?"
    sim "Du wolltest ihn doch nur aus dem Haus werfen. Und jetzt ist er wieder unser Freund?"

# game/scripts/c14/c14.rpy:414
translate german c14s001_ContinuationSam_cd9adbf4:

    # sam "Tu novio. Mi hombre. Yo también voy a tener que hablar con él, pero aún no he roto con él... ni le he roto la cara a hostias."
    sam "Dein Freund. Mein Mann. Ich muss auch mit ihm reden, aber ich habe noch nicht mit ihm Schluss gemacht... oder ihm ins Gesicht geschlagen."

# game/scripts/c14/c14.rpy:415
translate german c14s001_ContinuationSam_4b63743d:

    # sam "Supongo que tiene mucho que ver con que... haya mantenido la boca cerrada este rato..."
    sam "Ich nehme an, das hat viel damit zu tun, dass... ich die ganze Zeit geschwiegen habe..."

# game/scripts/c14/c14.rpy:417
translate german c14s001_ContinuationSam_1da127aa:

    # sim "Es que es un tipo listo... sale con las dos..."
    sim "Er ist ein cleverer Kerl... er ist mit beiden zusammen..."

# game/scripts/c14/c14.rpy:422
translate german c14s001_ContinuationSam_1f1deb53:

    # sam "Sí... "
    sam "Ja..."

# game/scripts/c14/c14.rpy:424
translate german c14s001_ContinuationSam_05f53ef6:

    # sim "Y ahora que está arreglado..."
    sim "Und jetzt, wo es repariert ist..."

# game/scripts/c14/c14.rpy:429
translate german c14s001_ContinuationSam_de214aa7:

    # sam "¡No hay nada arreglado! ¡Tú y yo tenemos que hablar de muchas cosas!"
    sam "Nichts ist entschieden! Wir beide haben noch viel zu besprechen!"

# game/scripts/c14/c14.rpy:431
translate german c14s001_ContinuationSam_1e0487b3:

    # sim "Sí, pero preferiría no hacerlo delante de [mc]. ¿Por qué no vas a ponerte algo mientras yo hablo con él un momento?"
    sim "Ja, aber ich möchte das lieber nicht vor [mc] tun. Könntest du dir in der Zwischenzeit etwas anziehen, während ich kurz mit ihm spreche?"

# game/scripts/c14/c14.rpy:436
translate german c14s001_ContinuationSam_30459373:

    # sim "Ver esto botando cada vez que te alteras me está desconcentrando."
    sim "Dass das jedes Mal auf und ab hüpft, wenn du dich aufregst, lenkt mich ab."

# game/scripts/c14/c14.rpy:441
translate german c14s001_ContinuationSam_1af4d505:

    # sam "¡Simone!"
    sam "Simone!"

# game/scripts/c14/c14.rpy:442
translate german c14s001_ContinuationSam_fbad18a5:

    # mc "¿Puedo ir yo también a ponerme algo?"
    mc "Kann ich auch mitkommen und etwas erledigen?"

# game/scripts/c14/c14.rpy:444
translate german c14s001_ContinuationSam_58a05077:

    # sim "No, tu quédate aquí."
    sim "Nein, du bleibst hier."

# game/scripts/c14/c14.rpy:449
translate german c14s001_ContinuationSam_8f26ab3a:

    # sam "Cuidado con lo que hacéis. No me gustaría pillaros haciendo algo inapropiado... *Risa*"
    sam "Pass auf, was du tust. Ich möchte dich nicht bei etwas Unangemessenem erwischen... *lacht*"

# game/scripts/c14/c14.rpy:451
translate german c14s001_ContinuationSam_79a4ad17:

    # mc "Tú dirás, pero quiero que quede claro que no te he engañado en ningún momento."
    mc "Du kannst sagen, was du willst, aber ich möchte klarstellen, dass ich dich zu keiner Zeit getäuscht habe."

# game/scripts/c14/c14.rpy:452
translate german c14s001_ContinuationSam_472edd16:

    # sim "Lo sé."
    sim "Ich weiß."

# game/scripts/c14/c14.rpy:454
translate german c14s001_ContinuationSam_be678842:

    # sim "¿Cuánto tiempo llevas con mi madre?"
    sim "Wie lange bist du schon mit meiner Mutter zusammen?"

# game/scripts/c14/c14.rpy:455
translate german c14s001_ContinuationSam_554ee6dc:

    # mc "Desde el día que fui a la comisaría."
    mc "Seit dem Tag, an dem ich zur Polizeiwache ging."

# game/scripts/c14/c14.rpy:457
translate german c14s001_ContinuationSam_cfcfc58d:

    # sim "Es decir, antes de salir conmigo... mmmm..."
    sim "Ich meine, bevor du mit mir ausgehst... mmm..."

# game/scripts/c14/c14.rpy:458
translate german c14s001_ContinuationSam_61c1538a:

    # sim "¿Hay más chicas? ¿Cuántas?"
    sim "Gibt es noch mehr Mädchen? Wie viele?"

# game/scripts/c14/c14.rpy:460
translate german c14s001_ContinuationSam_e517e5ab:

    # mc "Sí, las hay."
    mc "Ja, die gibt es."

# game/scripts/c14/c14.rpy:462
translate german c14s001_ContinuationSam_aa235da0:

    # sim "¿Cuántas?"
    sim "Wie viele?"

# game/scripts/c14/c14.rpy:463
translate german c14s001_ContinuationSam_a13d45a6:

    # mc "No sé si debería decirlo..."
    mc "Ich weiß nicht, ob ich das sagen sollte..."

# game/scripts/c14/c14.rpy:465
translate german c14s001_ContinuationSam_5380c9eb:

    # sim "Te acabo de pillar con mi madre. Dame algo de información, la voy a necesitar cuando hable con ella."
    sim "Ich habe dich gerade mit meiner Mutter erwischt. Gib mir ein paar Informationen; ich werde sie brauchen, wenn ich mit ihr spreche."

# game/scripts/c14/c14.rpy:466
translate german c14s001_ContinuationSam_598822b0:

    # sim "No te estoy preguntando quienes son, tan solo cuantas aparte de mi madre y de mí."
    sim "Ich frage nicht, wer sie sind, sondern nur, wie viele es außer meiner Mutter und mir sind."

# game/scripts/c14/c14.rpy:468
translate german c14s001_ContinuationSam_0f22c1f0:

    # mc "OK, estoy con otra chica aparte de vosotras."
    mc "Okay, ich bin mit einem anderen Mädchen zusammen als mit dir."

# game/scripts/c14/c14.rpy:470
translate german c14s001_ContinuationSam_247713a3:

    # sim "¿Sólo una? No me parece una mala cifra. Casi esperaba 10 u 11."
    sim "Nur einer? Das klingt für mich gar nicht so schlecht. Ich hatte fast mit 10 oder 11 gerechnet."

# game/scripts/c14/c14.rpy:473
translate german c14s001_ContinuationSam_01e1b9cb:

    # mc "OK, estoy con [Aux] chicas aparte de vosotras."
    mc "Okay, ich bin mit anderen [Aux]-Mädchen als dir zusammen."

# game/scripts/c14/c14.rpy:475
translate german c14s001_ContinuationSam_9620be00:

    # sim "¿[Aux] más? Eres insaciable..."
    sim "Mehr? Du bist unersättlich..."

# game/scripts/c14/c14.rpy:477
translate german c14s001_ContinuationSam_1ac19d67:

    # mc "No, no hay ninguna más aparte de vosotras."
    mc "Nein, außer dir gibt es niemanden sonst."

# game/scripts/c14/c14.rpy:479
translate german c14s001_ContinuationSam_a98f2837:

    # sim "¿Va a haber más?"
    sim "Wird es noch mehr geben?"

# game/scripts/c14/c14.rpy:480
translate german c14s001_ContinuationSam_8183cb53:

    # mc "Te dije cuál era la situación y lo aceptaste. Tu madre lo aceptó implícitamente al decir que no le importaría compartirme."
    mc "Ich habe dir die Situation erklärt, und du hast sie akzeptiert. Deine Mutter hat sie implizit akzeptiert, indem sie sagte, es würde ihr nichts ausmachen, mich zu teilen."

# game/scripts/c14/c14.rpy:481
translate german c14s001_ContinuationSam_d2b4e4bb:

    # mc "No puedo saber si va a haber más, Simone. No puedo saber si al salir al rellano voy a encontrar otra chica que me guste tanto como vosotras."
    mc "Ich weiß nicht, ob es noch mehr geben wird, Simone. Ich weiß nicht, ob ich, wenn ich auf den Treppenabsatz trete, ein anderes Mädchen finden werde, das ich so sehr mag wie euch beide."

# game/scripts/c14/c14.rpy:482
translate german c14s001_ContinuationSam_9c300746:

    # mc "¿Qué querrías que hiciera en ese caso?"
    mc "Was soll ich in diesem Fall tun?"

# game/scripts/c14/c14.rpy:484
translate german c14s001_ContinuationSam_fcdb244f:

    # sim "Ignorarla..."
    sim "Ignoriere sie..."

# game/scripts/c14/c14.rpy:485
translate german c14s001_ContinuationSam_8aa83788:

    # mc "Pero..."
    mc "Aber..."

# game/scripts/c14/c14.rpy:487
translate german c14s001_ContinuationSam_b36ec734:

    # sim "Pero entonces también hubieras tenido que ignorarme a mí porque ya estabas con mi madre."
    sim "Aber dann hättest du mich ja auch ignorieren müssen, weil du ja schon bei meiner Mutter warst."

# game/scripts/c14/c14.rpy:488
translate german c14s001_ContinuationSam_1c64ea5b:

    # mc "Exacto. Nuestra relación es diferente de las habituales, no es mejor ni peor."
    mc "Genau. Unsere Beziehung ist anders als die üblichen; sie ist weder besser noch schlechter."

# game/scripts/c14/c14.rpy:490
translate german c14s001_ContinuationSam_29f0f833:

    # mc "Mientras nos haga felices a los tres y a quien sea que esté también en esta relación, la podemos continuar. Lo que menos quiero es que alguien salga herido."
    mc "Solange es uns alle drei glücklich macht, und auch alle anderen Beteiligten, können wir die Beziehung fortsetzen. Ich möchte auf keinen Fall, dass jemand verletzt wird."

# game/scripts/c14/c14.rpy:492
translate german c14s001_ContinuationSam_7260d9ce:

    # mc "Mientras nos haga felices a los tres la podemos continuar. Lo que menos quiero es que alguien salga herido."
    mc "Solange es uns alle drei glücklich macht, können wir weitermachen. Ich möchte auf keinen Fall, dass jemand verletzt wird."

# game/scripts/c14/c14.rpy:494
translate german c14s001_ContinuationSam_3f90d1fe:

    # sim "Lo dices como si los tres estuviéramos en una relación poliamorosa. Espero que no quieras hacer un trío conmigo y con mi madre."
    sim "Du sagst es so, als ob wir drei in einer polyamoren Beziehung wären. Ich hoffe, du willst keinen Dreier mit mir und meiner Mutter."

# game/scripts/c14/c14.rpy:495
translate german c14s001_ContinuationSam_15410ddb:

    # mc "Si pensara que eso os iba a hacer felices, os lo propondría. Pero creo que hay líneas rojas que no deberíamos cruzar, creo que solo con proponerlo te incomodaría a ti."
    mc "Wenn ich glaubte, es würde dich glücklich machen, würde ich es vorschlagen. Aber ich denke, es gibt Grenzen, die wir nicht überschreiten sollten; ich glaube, allein der Vorschlag würde dich verunsichern."

# game/scripts/c14/c14.rpy:497
translate german c14s001_ContinuationSam_3ada1db0:

    # sim "¿A mí? ¿No a mi madre?"
    sim "Ich? Nicht meine Mutter?"

# game/scripts/c14/c14.rpy:498
translate german c14s001_ContinuationSam_5faaf4a7:

    # mc "Creo que tu madre podría estar más abierta a la idea de un trío que tú, aunque no si tú estás involucrada. Pero con la persona correcta..."
    mc "Ich glaube, deine Mutter wäre einer Dreierbeziehung gegenüber aufgeschlossener als du, allerdings nicht, wenn du selbst beteiligt bist. Aber mit der richtigen Person..."

# game/scripts/c14/c14.rpy:500
translate german c14s001_ContinuationSam_87ec4d53:

    # sim "{b}¿Qué?{/b} ¿Mi madre en un trío? Estás loco..."
    sim "{b}Was?{/b} Meine Mutter in einem Dreier? Du spinnst wohl..."

# game/scripts/c14/c14.rpy:502
translate german c14s001_ContinuationSam_e00638a7:

    # sim "¿Y de dónde has sacado la idea de que yo no estaría dispuesta? Con la persona adecuada..."
    sim "Und woher nehmen Sie die Idee, dass ich nicht dazu bereit wäre? Mit der richtigen Person..."

# game/scripts/c14/c14.rpy:503
translate german c14s001_ContinuationSam_1c8e0ffd:

    # mc "¿Y quién sería esa persona adecuada, Simone? Y no digas ninguna actriz famosa a quien no conocemos."
    mc "Und wer wäre diese geeignete Person, Simone? Und nenne jetzt bitte keine berühmte Schauspielerin, die wir nicht kennen."

# game/scripts/c14/c14.rpy:505
translate german c14s001_ContinuationSam_24dcce7f:

    # sim "{i}(¡Mielda! ¡Piensa, Simone! Alguien con quién él nunca tendría sexo...){/i}"
    sim "{i}(Verdammt! Denk nach, Simone! Jemand, mit dem er niemals Sex haben würde...){/i}"

# game/scripts/c14/c14.rpy:507
translate german c14s001_ContinuationSam_b4d2c42c:

    # sim "[mar], por ejemplo. O [nor]. [emm], [dap], o [eri]. Incluso con tu abuela también serviría..."
    sim "Zum Beispiel [mar]. Oder [nor]. [emm], [dap] oder [eri]. Selbst Ihre Großmutter würde es schaffen..."

# game/scripts/c14/c14.rpy:508
translate german c14s001_ContinuationSam_574a2760:

    # sim "{i}(¡Uff! Resuelto...){/i}"
    sim "{i}(Puh! Gelöst...){/i}"

# game/scripts/c14/c14.rpy:509
translate german c14s001_ContinuationSam_674b981e:

    # mc "Veo que tienes un fetiche con mi familia. *Risa*"
    mc "Ich sehe, du hast eine Schwäche für meine Familie. *lacht*"

# game/scripts/c14/c14.rpy:511
translate german c14s001_ContinuationSam_c241f862:

    # sim "{b}¿Qué? ¡No!{/b} No es eso..."
    sim "{b}Was? Nein!{/b} Das ist es nicht..."

# game/scripts/c14/c14.rpy:512
translate german c14s001_ContinuationSam_241751b0:

    # mc "Bueno, si surge la oportunidad les preguntaré si están interesadas en un trío contigo. *Risa*"
    mc "Nun, falls sich die Gelegenheit ergibt, frage ich sie, ob sie Lust auf einen Dreier mit dir hätten. *Lacht*"

# game/scripts/c14/c14.rpy:515
translate german c14s001_ContinuationSam_659165b0:

    # sim "{b}¿Qué?{/b} ¿Estás con alguna de ellas? ¿Con todas?"
    sim "{b}Was?{/b} Bist du mit einem von ihnen zusammen? Mit allen?"

# game/scripts/c14/c14.rpy:517
translate german c14s001_ContinuationSam_3d3489af:

    # sim "{b}¿Qué?{/b} ¿Estás con alguna de ellas?"
    sim "{b}Was?{/b} Bist du mit einem von ihnen zusammen?"

# game/scripts/c14/c14.rpy:518
translate german c14s001_ContinuationSam_6ada8b21:

    # mc "Ya sabes la respuesta a eso. Tan solo he dicho que les preguntaré si surge la oportunidad."
    mc "Die Antwort darauf kennst du ja schon. Ich habe lediglich gesagt, dass ich sie fragen werde, falls sich die Gelegenheit ergibt."

# game/scripts/c14/c14.rpy:520
translate german c14s001_ContinuationSam_6b0bc833:

    # sim "Bueno, la próxima vez que te vea y estén ellas delante, te besaré y las observaré para comprobar si ponen la misma cara que tenía yo hace unos minutos."
    sim "Nun, wenn ich dich das nächste Mal sehe und sie auch da sind, werde ich dich küssen und sie beobachten, um zu sehen, ob sie das gleiche Gesicht machen wie ich vor ein paar Minuten."

# game/scripts/c14/c14.rpy:521
translate german c14s001_ContinuationSam_66b7953b:

    # mc "*Risa* Eso podría ser muy divertido. Ahora que tu madre ya sabe lo nuestro, parece que no te importa hacerlo público."
    mc "*Lacht* Das könnte echt lustig werden. Jetzt, wo deine Mutter von uns weiß, scheint es dir ja nichts auszumachen, es öffentlich zu machen."

# game/scripts/c14/c14.rpy:523
translate german c14s001_ContinuationSam_cc13c2d8:

    # sim "No quiero parecer una perra celosa, pero sería una forma de marcar territorio si alguna de ellas tiene ideas... controvertidas. *Risa*"
    sim "Ich will ja nicht wie eine eifersüchtige Zicke klingen, aber es wäre eine Möglichkeit, mein Revier zu markieren, falls einer von ihnen... kontroverse Ideen hat. *lacht*"

# game/scripts/c14/c14.rpy:524
translate german c14s001_ContinuationSam_4e7df14c:

    # mc "¿Controvertidas?"
    mc "Umstritten?"

# game/scripts/c14/c14.rpy:526
translate german c14s001_ContinuationSam_c6b1927e:

    # sim "Es tu familia... no sé cómo llamar a que te estuvieras acostando con tus primas... ya me cuesta saber cómo llamar a que te acuestes con mi madre y conmigo..."
    sim "Das ist deine Familie... Ich weiß nicht, wie ich es nennen soll, dass du mit deinen Cousins schläfst... Ich habe schon Schwierigkeiten, zu wissen, wie ich es nennen soll, dass du mit meiner Mutter und mir schläfst..."

# game/scripts/c14/c14.rpy:527
translate german c14s001_ContinuationSam_8ce5c22c:

    # mc "¿Un hombre feliz? *Risa*"
    mc "Ein glücklicher Mann? *lacht*"

# game/scripts/c14/c14.rpy:529
translate german c14s001_ContinuationSam_edbb98cd:

    # sim "*Risa* ¡Capullo!"
    sim "*lacht* Idiot!"

# game/scripts/c14/c14.rpy:530
translate german c14s001_ContinuationSam_f259e62d:

    # mc "Pero volviendo al tema de tu madre. ¿Estamos bien?"
    mc "Aber zurück zu deiner Mutter. Ist alles in Ordnung?"

# game/scripts/c14/c14.rpy:532
translate german c14s001_ContinuationSam_51fdc84c:

    # sim "Sí, estamos bien. Verla tan enfadada y azorada al mismo tiempo me ha hecho darme cuenta de una cosa..."
    sim "Ja, alles in Ordnung. Sie gleichzeitig so wütend und verlegen zu sehen, hat mir etwas klar gemacht..."

# game/scripts/c14/c14.rpy:533
translate german c14s001_ContinuationSam_06833430:

    # sim "Lleva una semana cantando mientras cocina. Canta fatal, pero canta. Y haciendo cuentas, empezó a hacerlo cuando... empezasteis lo vuestro..."
    sim "Sie singt jetzt schon seit einer Woche beim Kochen. Sie singt furchtbar, aber sie singt. Und wenn man es genau betrachtet, hat sie damit angefangen, als... ihr zwei zusammengekommen seid..."

# game/scripts/c14/c14.rpy:534
translate german c14s001_ContinuationSam_faa4a11d:

    # sim "No había cantado desde que murió mi padre. ¿Quién soy yo para negarle eso?"
    sim "Ich hatte seit dem Tod meines Vaters nicht mehr gesungen. Wer bin ich, ihm das zu verweigern?"

# game/scripts/c14/c14.rpy:535
translate german c14s001_ContinuationSam_1caf40a3:

    # mc "Te entiendo. Sabes que lo único que quiero es haceros felices. A las dos."
    mc "Ich verstehe. Du weißt, dass ich nichts weiter will, als euch beide glücklich zu machen. Euch beide."

# game/scripts/c14/c14.rpy:537
translate german c14s001_ContinuationSam_679cb55e:

    # sim "Nunca me atrevería a hacerte elegir entre las dos."
    sim "Ich würde es niemals wagen, dich vor die Wahl zwischen den beiden zu stellen."

# game/scripts/c14/c14.rpy:538
translate german c14s001_ContinuationSam_ff542e68:

    # mc "Haces bien. No me gusta que me pongan entre la espada y la pared."
    mc "Du hast Recht. Ich mag es nicht, in eine schwierige Lage gebracht zu werden."

# game/scripts/c14/c14.rpy:540
translate german c14s001_ContinuationSam_abeadc17:

    # sim "Lo sé, hace 10 años que te conozco. Seguro que quién te dé a elegir no es la elegida. No soy tan tonta como para caer en esa trampa."
    sim "Ich weiß, ich kenne dich seit zehn Jahren. Ich bin mir sicher, dass derjenige, der dir die Wahl lässt, nicht derjenige ist, den du auswählst. So dumm bin ich nicht, darauf hereinzufallen."

# game/scripts/c14/c14.rpy:542
translate german c14s001_ContinuationSam_e8b9e2b9:

    # sam "¿Trampa? ¿Qué trampa?"
    sam "Eine Falle? Welche Falle?"

# game/scripts/c14/c14.rpy:544
translate german c14s001_ContinuationSam_caf1916a:

    # sim "En la que caería quien intentase hacer que [mc] eligiera entre dos cosas. Ya sean amigos... o chicas."
    sim "Genau das würde jedem passieren, der versuchen würde, [mc] vor die Wahl zwischen zwei Dingen zu stellen. Ob Freunde oder Mädchen."

# game/scripts/c14/c14.rpy:546
translate german c14s001_ContinuationSam_4cf055e0:

    # sam "Ninguna de las dos vamos a hacerlo, ¿verdad?"
    sam "Keiner von uns wird es tun, richtig?"

# game/scripts/c14/c14.rpy:547
translate german c14s001_ContinuationSam_97fb0a95:

    # sam "Es una elección que debemos tomar nosotras. Él puede elegir seguir con las dos o con ninguna."
    sam "Wir müssen diese Entscheidung treffen. Er kann entscheiden, ob er die Beziehung mit uns beiden fortsetzen möchte oder mit keinem von uns."

# game/scripts/c14/c14.rpy:549
translate german c14s001_ContinuationSam_4999fe3f:

    # sim "Entonces va a ser con las dos. Una vez pasada la sorpresa, no pienso renunciar a él. Tú puedes hacerlo si quieres."
    sim "Dann wird es mit beiden so sein. Sobald der erste Schock nachgelassen hat, habe ich nicht vor, ihn aufzugeben. Du kannst es tun, wenn du willst."

# game/scripts/c14/c14.rpy:551
translate german c14s001_ContinuationSam_dc9041b7:

    # sam "Entonces dejémoslo en que tú y yo vamos a tener que hablar para ver cómo nos organizamos."
    sam "Sagen wir einfach, wir beide müssen miteinander reden, um zu sehen, wie wir das organisieren können."

# game/scripts/c14/c14.rpy:552
translate german c14s001_ContinuationSam_c23167d6:

    # sam "Y para ver como se lo decimos a Jamaal..."
    sam "Und um herauszufinden, wie man es Jamaal sagt..."

# game/scripts/c14/c14.rpy:554
translate german c14s001_ContinuationSam_44276223:

    # sim "Eso va a ser lo más difícil. Se va a estar riendo de nosotras por compartir hombre. Y además {b}este{/b} hombre."
    sim "Das wird das Schwierigste sein. Er wird uns auslachen, weil wir uns einen Mann teilen. Und außerdem, dieser Mann..."

# game/scripts/c14/c14.rpy:555
translate german c14s001_ContinuationSam_faa8e77a:

    # mc "Hey, que estoy aquí..."
    mc "Hey, ich bin da..."

# game/scripts/c14/c14.rpy:557
translate german c14s001_ContinuationSam_66e33ffc:

    # sam "Pero vas a estarlo por poco tiempo. Creo que es hora de que te vayas, tengo mucho que hablar con mi hija y no va a ser agradable si tú estás delante."
    sam "Aber du wirst nicht lange hier sein. Ich denke, es ist Zeit für dich zu gehen; ich muss viel mit meiner Tochter besprechen, und das wird nicht angenehm, wenn du dabei bist."

# game/scripts/c14/c14.rpy:558
translate german c14s001_ContinuationSam_45228cb4:

    # mc "¿Estás bien, Samantha?"
    mc "Alles in Ordnung, Samantha?"

# game/scripts/c14/c14.rpy:560
translate german c14s001_ContinuationSam_7920aae5:

    # sam "Sí y no. No puedo estar bien sabiendo que no soy suficiente para ti."
    sam "Ja und nein. Ich kann nicht damit leben, zu wissen, dass ich dir nicht genüge."

# game/scripts/c14/c14.rpy:561
translate german c14s001_ContinuationSam_62dfc4f2:

    # sam "Por otro lado... no te enfades, Simone... saber que tampoco es suficiente para ti mi niña de 19 años... lo suaviza un poco..."
    sam "Andererseits... reg dich nicht auf, Simone... die Tatsache, dass dir meine 19-jährige Tochter auch nicht genügt... mildert die Sache etwas..."

# game/scripts/c14/c14.rpy:563
translate german c14s001_ContinuationSam_ea4a8556:

    # sim "¡Mamá! Empezó a salir conmigo después de ti. Él no podía saber si yo sería suficiente."
    sim "Mama! Er hat angefangen, mich zu treffen, nachdem du es getan hast. Er war sich nicht sicher, ob ich ihm genügen würde."

# game/scripts/c14/c14.rpy:564
translate german c14s001_ContinuationSam_925e88e6:

    # mc "¡Chicas, parad!"
    mc "Mädels, hört auf!"

# game/scripts/c14/c14.rpy:565
translate german c14s001_ContinuationSam_6d87e007:

    # mc "Cualquiera de las dos sería suficiente para cualquier hombre."
    mc "Einer von beiden würde jedem Mann genügen."

# game/scripts/c14/c14.rpy:567
translate german c14s001_ContinuationSam_f308f316:

    # mc "Si para vosotras es un problema que esté con las dos a la vez..."
    mc "Falls es für dich ein Problem darstellt, dass ich gleichzeitig mit beiden zusammen bin..."

# game/scripts/c14/c14.rpy:569
translate german c14s001_ContinuationSam_73d5a7de:

    # mc "Si para vosotras es un problema que esté con las dos a la vez y con la otra chica..."
    mc "Wenn es für dich ein Problem ist, dass er gleichzeitig mit beiden und auch mit dem anderen Mädchen zusammen ist..."

# game/scripts/c14/c14.rpy:571
translate german c14s001_ContinuationSam_feca9bf2:

    # mc "Si para vosotras es un problema que esté con las dos a la vez y con el resto de las chicas..."
    mc "Wenn es für dich ein Problem darstellt, dass er gleichzeitig mit euch beiden und mit den anderen Mädchen zusammen ist..."

# game/scripts/c14/c14.rpy:572
translate german c14s001_ContinuationSam_29a68f3d:

    # mc "Si sois capaces de decidir, cívicamente, cual corta conmigo..."
    mc "Wenn Sie in der Lage sind, auf zivilisierte Weise zu entscheiden, welches Gerät mich unterbricht..."

# game/scripts/c14/c14.rpy:574
translate german c14s001_ContinuationSam_72ebd1f2:

    # sam "¿Qué? ¡No! ¡No podríamos!" (multiple=2)
    sam "Was? Nein! Das konnten wir nicht!" (multiple=2)

# game/scripts/c14/c14.rpy:575
translate german c14s001_ContinuationSam_994715e2:

    # sim "¡Las dos te querríamos para nosotras!" (multiple=2)
    sim "Wir würden dich beide für uns allein haben wollen!" (multiple=2)

# game/scripts/c14/c14.rpy:576
translate german c14s001_ContinuationSam_1c81ceec:

    # mc "Entonces la decisión la habéis tomado vosotras."
    mc "Du hast also die Entscheidung getroffen."

# game/scripts/c14/c14.rpy:579
translate german c14s001_ContinuationSam_d166b3ec:

    # sam "Imagínate cómo se quedaría la otra. Prefiero compartirte a tener que cederte, aunque sea a mi hija."
    sam "Stell dir vor, wie sich die andere fühlen würde. Ich würde dich lieber teilen, als dich aufgeben zu müssen, selbst wenn es meine Tochter wäre."

# game/scripts/c14/c14.rpy:581
translate german c14s001_ContinuationSam_8f38c44e:

    # sim "Yo tampoco querría cederte. Y ser la que se queda contigo sería casi peor..."
    sim "Ich würde dich auch nicht aufgeben wollen. Und für mich wäre es fast noch schlimmer, bei dir zu bleiben…"

# game/scripts/c14/c14.rpy:583
translate german c14s001_ContinuationSam_d166b3ec_1:

