    sca "Es könnte nicht besser sein."

# game/scripts/c14/c14.rpy:2999
translate german c14s005_KissKim_a0b72761:

    # "Te acercas a Kim que después de su beso, te espera expectante."
    "Du gehst auf Kim zu, die nach deinem Kuss erwartungsvoll auf dich wartet."

# game/scripts/c14/c14.rpy:3001
translate german c14s005_KissKim_5adf9ee2:

    # "Te acercas a Kim. Ella no te ha besado, y no sabes cómo va a reaccionar."
    "Du gehst auf Kim zu. Sie hat dich noch nicht geküsst, und du weißt nicht, wie sie reagieren wird."

# game/scripts/c14/c14.rpy:3002
