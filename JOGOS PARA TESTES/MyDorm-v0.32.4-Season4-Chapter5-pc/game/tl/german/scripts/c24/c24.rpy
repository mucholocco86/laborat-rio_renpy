# game/scripts/c24/c24.rpy:2887
translate german c24s004_kiaOnMC_07bd7913:

    # "Te tumbas en el suelo mientras la bellísima pelirroja pone un pie a cada lado de tu cuerpo."
    "Du legst dich auf den Boden, während die schöne Rothaarige jeweils einen Fuß auf jede Seite deines Körpers stellt."

# game/scripts/c24/c24.rpy:2888
translate german c24s004_kiaOnMC_5dd2bafb:

    # kia "¿Preparado?"
    kia "Vorbereitet?"

# game/scripts/c24/c24.rpy:2889
translate german c24s004_kiaOnMC_937a60fc:

    # mc "*Risa* No muy convencido, pero preparado."
    mc "*Lacht* Nicht ganz überzeugt, aber vorbereitet."

# game/scripts/c24/c24.rpy:2891
translate german c24s004_kiaOnMC_c9783400:

    # kia "Si quieres lo podemos dejar, si no estás muy seguro."
    kia "Wenn Sie möchten, können wir es dabei belassen, falls Sie sich nicht ganz sicher sind."

# game/scripts/c24/c24.rpy:2892
translate german c24s004_kiaOnMC_3f4124af:

    # mc "No te preocupes. Quiero probarlo. Hoy es día de descubrimientos."
    mc "Keine Sorge. Ich möchte es ausprobieren. Heute ist ein Tag der Entdeckungen."

# game/scripts/c24/c24.rpy:2893
translate german c24s004_kiaOnMC_4873ef6e:

    # kia "Voy entonces..."
    kia "Dann gehe ich..."

# game/scripts/c24/c24.rpy:2895
translate german c24s004_kiaOnMC_2d070b65:

    # "La bibliotecaria deja caer un chorro que impacta en tu pecho. Se siente muy caliente mientras el agua de la ducha elimina la orina nada más tocarte."
    "Die Bibliothekarin lässt einen Wasserstrahl auf deine Brust fließen. Es fühlt sich sehr heiß an, da das Duschwasser den Urin sofort abwäscht, sobald es dich berührt."

# game/scripts/c24/c24.rpy:2896
translate german c24s004_kiaOnMC_e3667a29:

    # mc "Está muy caliente."
    mc "Es ist sehr heiß."

# game/scripts/c24/c24.rpy:2897
translate german c24s004_kiaOnMC_ad9a03e7:

    # kia "¿Te gusta?"
    kia "Gefällt es dir?"

# game/scripts/c24/c24.rpy:2899
translate german c24s004_kiaOnMC_3b9c8a65:

    # mc "Me gusta, es un descubrimiento interesante. Y tórrido. ¿Qué tal por ahí arriba?"
    mc "Ich mag es, eine interessante Entdeckung. Und heiß. Wie ist es da oben?"

# game/scripts/c24/c24.rpy:2900
translate german c24s004_kiaOnMC_5d36c1ec:

    # kia "Es una sensación... de poder. Me gusta."
    kia "Es ist ein Gefühl... von Macht. Ich mag es."

# game/scripts/c24/c24.rpy:2901
translate german c24s004_kiaOnMC_e43aa32d:

    # kia "Sin embargo, al haberlo pedido tú, no me siento como si te estuviera humillando. Eso me gusta aún más."
    kia "Da du aber darum gebeten hast, habe ich nicht das Gefühl, dich zu demütigen. Das gefällt mir sogar noch besser."

# game/scripts/c24/c24.rpy:2903
translate german c24s004_kiaOnMC_22e6ad9b:

    # mc "Te estás poniendo cachonda, ¿verdad?"
    mc "Du wirst erregt, nicht wahr?"

# game/scripts/c24/c24.rpy:2904
translate german c24s004_kiaOnMC_3aaff82b:

    # kia "No te puedes imaginar cuánto."
    kia "Sie können sich nicht vorstellen, wie viel."

# game/scripts/c24/c24.rpy:2905
translate german c24s004_kiaOnMC_804770bd:

    # kia "Lo malo es que no dura mucho..."
    kia "Das Schlimme daran ist, dass es nicht lange anhält..."

# game/scripts/c24/c24.rpy:2906
translate german c24s004_kiaOnMC_46698566:

    # mc "Lo podremos repetir en otro momento, si quieres."
    mc "Wir können es gerne ein anderes Mal wiederholen."

# game/scripts/c24/c24.rpy:2908
translate german c24s004_kiaOnMC_e4a948f1:

    # "El chorro acaba inesperadamente. Casi lo echas de menos."
    "Der Stream bricht unerwartet ab. Man verpasst es fast."

# game/scripts/c24/c24.rpy:2909
translate german c24s004_kiaOnMC_57759d02:

    # kia "Me parece una idea excelente. Ya me estoy imaginando escenarios..."
    kia "Ich finde das eine hervorragende Idee. Ich male mir schon verschiedene Szenarien aus..."

# game/scripts/c24/c24.rpy:2910
translate german c24s004_kiaOnMC_06dd01f1:

    # mc "*Risa* Voy a acabar de limpiarme y te espero en la habitación. Me tienes que contar esos escenarios."
    mc "*Lacht* Ich räume noch schnell fertig auf und warte dann im Zimmer auf dich. Du musst mir unbedingt von diesen Szenarien erzählen."

# game/scripts/c24/c24.rpy:2912
translate german c24s004_kiaOnMC_54e794a2:

    # "Vuelves a la habitación después de limpiarte y secarte. Esperas que [kia] termine la ducha mirando la chimenea."
    "Du kehrst nach dem Waschen und Abtrocknen ins Zimmer zurück. Du wartest, bis [kia] mit dem Duschen fertig ist, und blickst dabei in den Kamin."

# game/scripts/c24/c24.rpy:2916
translate german c24s004_kiaOnFloor_6d537bfa:

    # kia "¿Cómo va a importarme que mires? Eso era lo más interesante de mi petición..."
    kia "Warum sollte es mich kümmern, ob du zuschaust? Das war der interessanteste Teil meiner Anfrage..."

# game/scripts/c24/c24.rpy:2917
translate german c24s004_kiaOnFloor_bd03522c:

    # mc "Eres mucho más traviesa de lo que imaginaba. Me encanta..."
    mc "Du bist viel frecher, als ich dachte. Ich liebe es..."

# game/scripts/c24/c24.rpy:2919
translate german c24s004_kiaOnFloor_2408be39:

    # kia "¿Vas a mirar desde ahí arriba?"
    kia "Wirst du von dort oben herunterschauen?"

# game/scripts/c24/c24.rpy:2920
translate german c24s004_kiaOnFloor_9b21b8ce:

    # mc "Voy a mirar desde todos los ángulos. No es algo que quiera perderme."
    mc "Ich werde es von allen Seiten betrachten. Das ist nichts, was ich verpassen möchte."

# game/scripts/c24/c24.rpy:2921
translate german c24s004_kiaOnFloor_852a656d:

    # kia "Ahí voy, entonces."
    kia "Na dann mal los."

# game/scripts/c24/c24.rpy:2923
translate german c24s004_kiaOnFloor_bbfbdeee:

    # "Un potente chorro amarillento hace su aparición en un momento. Es hipnótico."
    "Ein kräftiger, gelblicher Strahl erscheint augenblicklich. Er hat eine hypnotische Wirkung."

# game/scripts/c24/c24.rpy:2924
translate german c24s004_kiaOnFloor_5b30cf74:

    # kia "Me está poniendo cómo me miras..."
    kia "Deine Art, mich anzusehen, erregt mich..."

# game/scripts/c24/c24.rpy:2925
translate german c24s004_kiaOnFloor_b875b0be:

    # mc "A mí me está poniendo mirarte..."
    mc "Ich werde erregt, wenn ich dich ansehe..."

# game/scripts/c24/c24.rpy:2927
translate german c24s004_kiaOnFloor_3947b7fb:

    # "Se forma un pequeño charco en el suelo que lucha por no ser lavado por el agua de la ducha."
    "Auf dem Boden bildet sich eine kleine Pfütze, die sich dagegen wehrt, vom Duschwasser weggespült zu werden."

# game/scripts/c24/c24.rpy:2928
translate german c24s004_kiaOnFloor_bc241615:

    # kia "¿Te pongo yo o verme mear?"
    kia "Soll ich es dir geben oder mir beim Pinkeln zusehen?"

# game/scripts/c24/c24.rpy:2929
translate german c24s004_kiaOnFloor_b65ed262:

    # mc "Las dos cosas... que seas tú quién mee. Que seas tú quién lo ha propuesto."
    mc "Beides... dass du diejenige bist, die uriniert. Dass du diejenige bist, die es vorgeschlagen hat."

# game/scripts/c24/c24.rpy:2931
translate german c24s004_kiaOnFloor_dfa67c31:

    # "Cambias de ángulo, no queriendo perderte nada del espectáculo. [kia] cambia de posición para darte una mejor visión."
    "Du änderst deinen Blickwinkel, um nichts zu verpassen. [kia] Ändere deine Position, um eine bessere Sicht zu erhalten."

# game/scripts/c24/c24.rpy:2932
translate german c24s004_kiaOnFloor_01ab4c6d:

    # kia "Ya se está acabando..."
    kia "Es ist fast vorbei..."

# game/scripts/c24/c24.rpy:2933
translate german c24s004_kiaOnFloor_25bda972:

    # mc "Habrá que disfrutar las vistas hasta el último momento, entonces."
    mc "Dann müssen wir die Aussicht bis zum allerletzten Moment genießen."

# game/scripts/c24/c24.rpy:2935
translate german c24s004_kiaOnFloor_caed8249:

    # "El chorro desaparece casi de golpe y el charco un par de segundos después."
    "Der Jet verschwindet fast augenblicklich, die Pfütze ein paar Sekunden später."

# game/scripts/c24/c24.rpy:2936
translate german c24s004_kiaOnFloor_a36448f8:

    # mc "Ha durado menos de lo que esperaba... pero ha valido la pena."
    mc "Es hat kürzer gedauert als erwartet... aber es hat sich gelohnt."

# game/scripts/c24/c24.rpy:2937
translate german c24s004_kiaOnFloor_4a613eab:

    # kia "Una experiencia nueva para los dos."
    kia "Eine neue Erfahrung für uns beide."

# game/scripts/c24/c24.rpy:2939
translate german c24s004_kiaOnFloor_2201430b:

    # kia "Ahora mismo estoy cachondísima. Hacer esto delante tuyo ha sido super caliente."
    kia "Ich bin gerade so geil. Das vor dir zu tun, war unglaublich heiß."

# game/scripts/c24/c24.rpy:2940
translate german c24s004_kiaOnFloor_b406bea8:

    # kia "Y veo que a ti también te ha puesto igual de cachondo. Mjolnir vuelve a estar enorme."
    kia "Und ich sehe, es hat dich genauso begeistert. Mjölnir ist wieder riesig."

# game/scripts/c24/c24.rpy:2941
translate german c24s004_kiaOnFloor_d3071c47:

    # mc "*Risa* ¿Quieres el cuarto asalto? Te estás volviendo avariciosa..."
    mc "*lacht* Du willst eine vierte Runde? Du wirst aber gierig..."

# game/scripts/c24/c24.rpy:2943
translate german c24s004_kiaOnFloor_9f1dbd4c:

    # kia "No creo que pudiera. Ahora quiero acabar de ducharme e ir a la cama a darnos abrazos antes de dormir."
    kia "Ich glaube, das könnte ich nicht. Jetzt möchte ich nur noch schnell duschen und ins Bett gehen, damit wir uns vor dem Einschlafen noch einmal kuscheln können."

# game/scripts/c24/c24.rpy:2944
translate german c24s004_kiaOnFloor_f5fd80b6:

    # mc "Me parece una idea estupenda. Déjame aclararme y te espero en la cama mientras acabas de ducharte."
    mc "Das klingt nach einer tollen Idee. Lass mich kurz darüber nachdenken, und ich warte dann im Bett auf dich, während du duschst."

# game/scripts/c24/c24.rpy:2946
translate german c24s004_kiaOnFloor_3935088c:

    # "Vuelves a la habitación después de aclararte y secarte. Esperas que [kia] termine la ducha mirando la chimenea."
    "Nachdem du dich abgeduscht und abgetrocknet hast, kehrst du ins Zimmer zurück. Du wartest, bis die Dusche fertig ist, und blickst dabei in den Kamin."

# game/scripts/c24/c24.rpy:2954
translate german c24s004_Deb_Sim_f573cf4a:

    # "Después de comer, algunas de las chicas te preguntan si te vas a unir a ellas en la piscina."
    "Nach dem Essen fragen dich einige der Mädchen, ob du mit ihnen in den Pool kommen willst."

# game/scripts/c24/c24.rpy:2955
translate german c24s004_Deb_Sim_0b862711:

    # "Subes a tu habitación a ponerte el bañador. Quieres relajarte un rato antes de la reunión con Iron Fist de la noche."
    "Du gehst in dein Zimmer, um deinen Badeanzug anzuziehen. Du möchtest dich vor deinem Treffen mit Iron Fist heute Abend noch etwas entspannen."

# game/scripts/c24/c24.rpy:2957
translate german c24s004_Deb_Sim_69ea716e:

    # "Cuando bajas a la piscina, encuentras a [deb.nick] y a [sim] charlando animadamente en el agua."
    "Wenn du zum Pool hinuntergehst, findest du [deb.nick] bereits [sim] angeregt im Wasser plaudernd vor."

# game/scripts/c24/c24.rpy:2959
translate german c24s004_Deb_Sim_9262c7af:

    # mc "¿Qué tal, chicas? ¿Cómo están las dos sirenas?"
    mc "Hey Mädels! Wie geht es den beiden Meerjungfrauen?"

# game/scripts/c24/c24.rpy:2960
translate german c24s004_Deb_Sim_b368d369:

    # sim "Genial. Después de ver a un montón de niños nadando esta mañana, tenía ganas de nadar un rato. Y no hay nadie mejor que [deb.nick] para hacerlo."
    sim "Super. Nachdem ich heute Morgen so viele Kinder schwimmen gesehen habe, hatte ich selbst auch Lust auf ein Bad. Und dafür gibt es niemanden Besseren als [deb.nick]."

# game/scripts/c24/c24.rpy:2961
translate german c24s004_Deb_Sim_e7d1088a:

    # deb "No exageres, [sim]."
    deb "Übertreib nicht, [sim]."

# game/scripts/c24/c24.rpy:2962
translate german c24s004_Deb_Sim_8db86fd1:

    # mc "¿Hacéis carreras entre vosotras?"
    mc "Macht ihr Wettrennen gegeneinander?"

# game/scripts/c24/c24.rpy:2964
translate german c24s004_Deb_Sim_a7c2f323:

    # sim "*Risa* ¡Qué va! [deb.nick] es demasiado buena para mí."
    sim "*Lacht* Auf keinen Fall! [deb.nick] Sie ist viel zu gut für mich."

# game/scripts/c24/c24.rpy:2965
translate german c24s004_Deb_Sim_4e273363:

    # sim "Hicimos una amistosa y no tuvo que esforzarse para darme una paliza."
    sim "Wir hatten ein Freundschaftsspiel, und er musste sich nicht sonderlich anstrengen, um mich zu besiegen."

# game/scripts/c24/c24.rpy:2967
translate german c24s004_Deb_Sim_74c39d65:

    # deb "No le hagas caso. Está exagerando y está desentrenada."
    deb "Hör nicht auf sie. Sie übertreibt und ist aus der Übung."

# game/scripts/c24/c24.rpy:2968
translate german c24s004_Deb_Sim_be167096:

    # mc "Bueno, lleva tiempo sin nadar. Es lógico."
    mc "Nun ja, er ist schon länger nicht mehr geschwommen. Das ist verständlich."

# game/scripts/c24/c24.rpy:2970
translate german c24s004_Deb_Sim_72045934:

    # sim "Llevo un año sin nadar en una competición y ni siquiera entonces llegué a los campeonatos nacionales."
    sim "Ich bin seit einem Jahr nicht mehr geschwommen, und selbst da habe ich es nicht zu den nationalen Meisterschaften geschafft."

# game/scripts/c24/c24.rpy:2971
translate german c24s004_Deb_Sim_0d68806d:

    # sim "Ella llegó y los ganó. Creo que la diferencia está clara, ¿no?"
    sim "Sie kam rein und gewann. Ich denke, der Unterschied ist deutlich, nicht wahr?"

# game/scripts/c24/c24.rpy:2973
translate german c24s004_Deb_Sim_164b1d20:

    # deb "Ya sabes por qué fue. No tienes el cuerpo adecuado para ser nadadora competitiva."
    deb "Du weißt, warum. Du hast nicht den richtigen Körperbau, um Leistungsschwimmer zu sein."

# game/scripts/c24/c24.rpy:2974
translate german c24s004_Deb_Sim_b60a4e8e:

    # deb "Te desarrollaste donde no me desarrollé yo, y eso te quita centésimas en cada brazada."
    deb "Du hast dich dort weiterentwickelt, wo ich es nicht getan habe, und das spart Hundertstelsekunden bei jedem Schlag."

# game/scripts/c24/c24.rpy:2976
translate german c24s004_Deb_Sim_abcd2cb9:

    # sim "A veces odio estas tetas..."
    sim "Manchmal hasse ich diese Brüste..."

# game/scripts/c24/c24.rpy:2978
translate german c24s004_Deb_Sim_2b71414e:

    # mc "A mí me encantan..."
    mc "Ich liebe sie..."

# game/scripts/c24/c24.rpy:2981
translate german c24s004_Deb_Sim_cd85f167:

    # sim "También te encantan las de [deb.nick]. *Risa* Tu opinión es bienvenida, pero eres poco quisquilloso en cuanto a tetas."
    sim "Du magst also auch die von [deb.nick]. *Lacht* Deine Meinung ist willkommen, aber du bist nicht sehr wählerisch, wenn es um Brüste geht."

# game/scripts/c24/c24.rpy:2982
translate german c24s004_Deb_Sim_a140637f:

    # mc "Tienes razón, ¿para qué negarlo? *Risa*"
    mc "Du hast recht, warum solltest du es leugnen? *lacht*"

# game/scripts/c24/c24.rpy:2983
translate german c24s004_Deb_Sim_9f4a647f:

    # mc "Todos tenemos que aceptar el cuerpo que nos toca, [sim]."
    mc "Wir alle müssen den Körper akzeptieren, der uns gegeben ist, [sim]."

# game/scripts/c24/c24.rpy:2985
translate german c24s004_Deb_Sim_6e665169:

    # mc "Y a mí me gustan los vuestros. Los de las dos."
    mc "Und ich mag deine. Beide."

# game/scripts/c24/c24.rpy:2987
translate german c24s004_Deb_Sim_52e20141:

    # deb "¿Sí?" (multiple=2)
    deb "Ja?" (multiple=2)

# game/scripts/c24/c24.rpy:2988
translate german c24s004_Deb_Sim_5a8cda6f:

    # sim "¡Sí!" (multiple=2)
    sim "Ja!" (multiple=2)

# game/scripts/c24/c24.rpy:2989
translate german c24s004_Deb_Sim_4761ff8d:

    # mc "Sí, ¿sobre qué?"
    mc "Ja, worüber denn?"

# game/scripts/c24/c24.rpy:2992
translate german c24s004_Deb_Sim_7010c693:

    # sim "¡Ahora!"
    sim "Jetzt!"

# game/scripts/c24/c24.rpy:2993
translate german c24s004_Deb_Sim_5e482cd8:

    # mc "¿QUÉ?"
    mc "DAS?"

# game/scripts/c24/c24.rpy:2995
translate german c24s004_Deb_Sim_d0b5fe9c:

    # mc "*Risa* ¿A qué ha venido eso?"
    mc "*Gelächter* Was war denn das denn?"

# game/scripts/c24/c24.rpy:2996
translate german c24s004_Deb_Sim_9d5b35df:

    # sim "*Risa* Me estaba entrando tortícolis de mirar tan arriba."
    sim "*lacht* Ich bekam einen steifen Nacken vom vielen Hochschauen."

# game/scripts/c24/c24.rpy:2997
translate german c24s004_Deb_Sim_bab7afa5:

    # deb "*Risa* Y a ti te ha tocado un cuerpo poco ágil que no ha podido esquivar nuestros ataques."
    deb "*Gelächter* Und du hast das Pech gehabt, einen ungeschickten Körper zu haben, der unseren Angriffen nicht ausweichen konnte."

# game/scripts/c24/c24.rpy:3000
translate german c24s004_Deb_Sim_e83606cc:

    # sim "Además, tenía ganas de hacer esto."
    sim "Außerdem wollte ich das unbedingt machen."

# game/scripts/c24/c24.rpy:3001
translate german c24s004_Deb_Sim_f953d662:

    # mc "Entonces no me voy a quejar del ataque a traición."
    mc "Dann werde ich mich auch nicht über den Überraschungsangriff beschweren."

# game/scripts/c24/c24.rpy:3004
translate german c24s004_Deb_Sim_ff0a09ef:

    # deb "Yo también tenía ganas de besarte."
    deb "Ich wollte dich auch küssen."

# game/scripts/c24/c24.rpy:3005
translate german c24s004_Deb_Sim_fe762c04:

    # mc "*Risa* Podéis atacarme cuando queráis si la recompensa es esta."
    mc "*Lacht* Du kannst mich jederzeit angreifen, wenn das die Belohnung ist."

# game/scripts/c24/c24.rpy:3008
translate german c24s004_Deb_Sim_229a9d02:

    # deb "Además, tenía ganas de besarte."
    deb "Außerdem wollte ich dich küssen."

# game/scripts/c24/c24.rpy:3009
translate german c24s004_Deb_Sim_fe762c04_1:

    # mc "*Risa* Podéis atacarme cuando queráis si la recompensa es esta."
    mc "*Lacht* Du kannst mich jederzeit angreifen, wenn das die Belohnung ist."

# game/scripts/c24/c24.rpy:3011
translate german c24s004_Deb_Sim_0393a250:

    # mc "Y, aparte de atacar a pobres hombres que pasaban por aquí, ¿de qué estabais hablando?"
    mc "Und abgesehen davon, dass du arme Männer angegriffen hast, die vorbeikamen, worüber hast du gesprochen?"

# game/scripts/c24/c24.rpy:3013
translate german c24s004_Deb_Sim_371b629d:

    # deb "Precisamente estábamos hablando de nadar."
    deb "Wir haben uns gerade übers Schwimmen unterhalten."

# game/scripts/c24/c24.rpy:3014
translate german c24s004_Deb_Sim_179d63bb:

    # deb "Le estaba diciendo a [sim] que quizás pudiera convencer al entrenador de la universidad para que la dejara entrenar algunos días con nosotras."
    deb "Ich sagte [sim], dass ich vielleicht den Universitätstrainer davon überzeugen könnte, sie für ein paar Tage bei uns trainieren zu lassen."

# game/scripts/c24/c24.rpy:3015
translate german c24s004_Deb_Sim_0cb3e1bd:

    # mc "¿Puedes hacer eso?"
    mc "Können Sie das tun?"

# game/scripts/c24/c24.rpy:3017
translate german c24s004_Deb_Sim_ea14bc84:

    # sim "¡Claro que puede! ¡Es la estrella de la universidad! Seguro que no le niegan nada."
    sim "Natürlich kann sie das! Sie ist der Star der Universität! Ich bin sicher, man wird ihr nichts verweigern."

# game/scripts/c24/c24.rpy:3019
translate german c24s004_Deb_Sim_1ce3d555:

    # sim "Pero prefiero que no lo haga. Sería como... no sé... probar cómo hubiera sido mi vida en otras circunstancias pero no poder vivirla del todo."
    sim "Aber lieber nicht. Es wäre, als würde ich mir vorstellen, wie mein Leben unter anderen Umständen verlaufen wäre, es aber nicht vollständig erleben können."

# game/scripts/c24/c24.rpy:3021
translate german c24s004_Deb_Sim_bf03d1c9:

    # deb "¡Es tan cabezota como su hermano!"
    deb "Er ist genauso stur wie sein Bruder!"

# game/scripts/c24/c24.rpy:3022
translate german c24s004_Deb_Sim_52bdc56e:

    # deb "Aprendería técnicas nuevas y cómo se entrena en la universidad. Sólo por eso ya valdría la pena."
    deb "Ich würde neue Techniken erlernen und sehen, wie die Ausbildung an der Universität abläuft. Allein das wäre es schon lohnenswert."

# game/scripts/c24/c24.rpy:3023
translate german c24s004_Deb_Sim_b8aabfc3:

    # mc "Creo que tienes razón, pero también comprendo a [sim]."
    mc "Ich glaube, du hast Recht, aber ich verstehe auch [sim]."

# game/scripts/c24/c24.rpy:3025
translate german c24s004_Deb_Sim_5a84b9a5:

    # sim "¿Ves? ¡El me entiende!"
    sim "Siehst du? Er versteht mich!"

# game/scripts/c24/c24.rpy:3026
translate german c24s004_Deb_Sim_4ea9139c:

    # mc "Te entiendo, pero no comparto tu decisión."
    mc "Ich verstehe dich, aber ich stimme deiner Entscheidung nicht zu."

# game/scripts/c24/c24.rpy:3028
translate german c24s004_Deb_Sim_2e41f7dc:

    # sim "¿Qué?"
    sim "Das?"

# game/scripts/c24/c24.rpy:3029
translate german c24s004_Deb_Sim_1c685b6d:

    # mc "Siempre te ha gustado nadar y ahora tienes que ver cómo otros lo hacen y esperar a que se ahoguen para salvarlos."
    mc "Du hast das Schwimmen immer geliebt, und jetzt musst du anderen dabei zusehen und darauf warten, dass sie ertrinken, damit du sie retten kannst."

# game/scripts/c24/c24.rpy:3031
translate german c24s004_Deb_Sim_c2dd440a:

    # sim "*Risa* ¡No se ahoga nadie en mi guardia!"
    sim "*lacht* Bei mir ertrinkt niemand!"

# game/scripts/c24/c24.rpy:3032
translate german c24s004_Deb_Sim_e2a3c315:

    # mc "[sim], hablo en serio. Entiendo cómo te sientes, pero creo que deberías aceptar la oferta de [deb.nick]."
    mc "[sim], ich meine es ernst. Ich verstehe, wie du dich fühlst, aber ich denke, du solltest [deb.nick]s Angebot annehmen."

# game/scripts/c24/c24.rpy:3033
translate german c24s004_Deb_Sim_fb51b049:

    # mc "Entrenarías con las mejores de la ciudad y, aunque no vuelvas a competir, aprenderás muchísimo."
    mc "Du würdest mit den Besten der Stadt trainieren und, selbst wenn du nie wieder an Wettkämpfen teilnehmen würdest, würdest du viel lernen."

# game/scripts/c24/c24.rpy:3035
translate german c24s004_Deb_Sim_a9a18e0c:

    # deb "Es lo que le he dicho. Además, nuestro entrenador es muy bueno y aprenderá cómo entrenar a otros."
    deb "Das habe ich ihm auch gesagt. Außerdem ist unser Trainer sehr gut und er wird lernen, wie man andere trainiert."

# game/scripts/c24/c24.rpy:3037
translate german c24s004_Deb_Sim_df1264f7:

    # deb "Es lo que querías estudiar, ¿no?"
    deb "Das wolltest du doch studieren, oder?"

# game/scripts/c24/c24.rpy:3039
translate german c24s004_Deb_Sim_142d4e09:

    # sim "Sí, pero sin la beca, no voy a ir nunca a la universidad. Dudo que nunca sea entrenadora."
    sim "Ja, aber ohne das Stipendium werde ich nie studieren. Ich bezweifle, dass ich jemals Trainer werde."

# game/scripts/c24/c24.rpy:3040
translate german c24s004_Deb_Sim_cb3953ee:

    # sim "Y con mis récords, nunca voy a conseguir una beca."
    sim "Und mit meinen Leistungen werde ich nie ein Stipendium bekommen."

# game/scripts/c24/c24.rpy:3041
translate german c24s004_Deb_Sim_f7506dbb:

    # mc "Pero aprenderás mucho igualmente. Y seguirás nadando, que es lo que importa."
    mc "Aber du wirst trotzdem viel lernen. Und du wirst weiterschwimmen, und das ist es, was zählt."

# game/scripts/c24/c24.rpy:3043
translate german c24s004_Deb_Sim_0f43e16d:

    # deb "Creo que no la vas a convencer. Como he dicho, es casi peor que intentar convencer a Jamaal para que suelte un plato de comida."
    deb "Ich glaube nicht, dass du sie überzeugen kannst. Wie gesagt, es ist fast noch schwieriger, als Jamaal dazu zu bringen, dir einen Teller Essen abzugeben."

# game/scripts/c24/c24.rpy:3044
translate german c24s004_Deb_Sim_58e478ce:

    # mc "Siempre he dicho que se parecen mucho. No sé cuál de los dos es más terco."
    mc "Ich habe immer gesagt, dass sie sich sehr ähnlich sind. Ich weiß nicht, welches von beiden sturer ist."

# game/scripts/c24/c24.rpy:3046
translate german c24s004_Deb_Sim_9e085d60:

    # sim "¡Hey! Estoy aquí, ¿sabéis?"
    sim "Hey! Ich bin da, weißt du?"

# game/scripts/c24/c24.rpy:3047
translate german c24s004_Deb_Sim_188127f9:

    # "[deb.nick] y tú la ignoráis. Habéis encontrado su punto débil."
    "[deb.nick] und du ignorierst sie. Du hast ihre Schwachstelle gefunden."

# game/scripts/c24/c24.rpy:3049
translate german c24s004_Deb_Sim_30cf8c66:

    # deb "No creas que no la entiendo. Con esos dos flotadores tiene que ser incómodo nadar. En eso se diferencia de Jamaal."
    deb "Glaubt nicht, ich würde sie nicht verstehen. Mit diesen zwei Schwimmflügeln zu schwimmen, muss unbequem sein. Das unterscheidet sie von Jamaal."

# game/scripts/c24/c24.rpy:3050
translate german c24s004_Deb_Sim_c021f347:

    # mc "*Risa* Sí, creo que Jamaal tiene poca flotabilidad con la silla de ruedas."
    mc "*Lacht* Ja, ich glaube, Jamaal hat im Rollstuhl wenig Auftrieb."

# game/scripts/c24/c24.rpy:3051
translate german c24s004_Deb_Sim_31753902:

    # mc "Pero, ¿sabes en lo que sí que se parecen? A los dos les cuesta aceptar retos."
    mc "Aber wissen Sie, was sie gemeinsam haben? Beide tun sich schwer damit, Herausforderungen anzunehmen."

# game/scripts/c24/c24.rpy:3052
translate german c24s004_Deb_Sim_de0144ff:

    # mc "Jamaal tardó tiempo en descubrir que, aunque tuviera que vivir una vida diferente, podía hacer lo que le gustaba."
    mc "Es dauerte eine Weile, bis Jamaal erkannte, dass er, obwohl er ein anderes Leben führen musste, das tun konnte, was er liebte."

# game/scripts/c24/c24.rpy:3054
translate german c24s004_Deb_Sim_903a7b4e:

    # sim "¡Tenía once años! ¡Era un niño!"
    sim "Er war erst elf Jahre alt! Er war doch nur ein Kind!"

# game/scripts/c24/c24.rpy:3055
translate german c24s004_Deb_Sim_866a67f9:

    # "Seguís ignorándola."
    "Du ignorierst sie weiterhin."

# game/scripts/c24/c24.rpy:3057
translate german c24s004_Deb_Sim_f9147568:

    # deb "Y es una lástima que [sim] se comporte como una niña de once años, ¿verdad?"
    deb "Und es ist wirklich schade, dass [sim] sich wie ein elfjähriges Mädchen benimmt, nicht wahr?"

# game/scripts/c24/c24.rpy:3058
translate german c24s004_Deb_Sim_a34fa9e3:

    # mc "Sí, una verdadera lástima. Va a dejar de hacer lo que le gusta porque no puede hacerlo al nivel que le gustaría."
    mc "Ja, das ist wirklich schade. Sie wird aufhören müssen, das zu tun, was sie liebt, weil sie es nicht mehr auf dem Niveau ausüben kann, das sie sich wünscht."

# game/scripts/c24/c24.rpy:3059
translate german c24s004_Deb_Sim_ce1a8e38:

    # deb "*Risa* Justo como su hermano." (multiple=2)
    deb "*Lacht* Genau wie sein Bruder." (multiple=2)

# game/scripts/c24/c24.rpy:3060
translate german c24s004_Deb_Sim_c7beffad:

    # mc "*Risa* Justo como Jamaal." (multiple=2)
    mc "*Lacht* Genau wie Jamaal." (multiple=2)

# game/scripts/c24/c24.rpy:3061
translate german c24s004_Deb_Sim_def7e49a:

    # mc "¿Sabes que Jam estuvo a punto de no ir al baile de graduación?"
    mc "Wusstest du, dass Jam beinahe nicht zum Abschlussball gegangen wäre?"

# game/scripts/c24/c24.rpy:3063
translate german c24s004_Deb_Sim_28bc3de6:

    # sim "¡Porque le dejó su novio dos semanas antes del baile!"
    sim "Weil ihr Freund sie zwei Wochen vor dem Tanz verlassen hat!"

# game/scripts/c24/c24.rpy:3065
translate german c24s004_Deb_Sim_fad15be1:

    # "[deb.nick] continúa como si no hubiera escuchado nada."
    "[deb.nick] fährt fort, als hätte er nichts gehört."

# game/scripts/c24/c24.rpy:3066
translate german c24s004_Deb_Sim_14558884:

    # deb "¿Porque no podía bailar?"
    deb "Warum konnte sie nicht tanzen?"

# game/scripts/c24/c24.rpy:3067
translate german c24s004_Deb_Sim_78320f97:

    # mc "No, le encanta bailar y hace unas cosas tremendas con las ruedas. Pero no quería porque no podía bailar con quién él hubiera querido bailar."
    mc "Nein, er tanzt unheimlich gern und vollbringt erstaunliche Dinge mit den Rädern. Aber er wollte nicht, weil er nicht mit der Person tanzen konnte, mit der er tanzen wollte."

# game/scripts/c24/c24.rpy:3068
translate german c24s004_Deb_Sim_bd261694:

    # mc "Es como su hermana. Ella no quiere nadar porque no puede nadar en competiciones."
    mc "Sie ist genau wie ihre Schwester. Sie will nicht schwimmen, weil sie nicht mithalten kann."

# game/scripts/c24/c24.rpy:3069
translate german c24s004_Deb_Sim_befe1427:

    # mc "Yo convencí a Jam, pero te tocará a ti convencer a [sim]."
    mc "Ich habe Jam überzeugt, aber es liegt nun an dir, [sim] zu überzeugen."

# game/scripts/c24/c24.rpy:3071
translate german c24s004_Deb_Sim_1039aabf:

    # sim "¡Parad! ¡Vale! ¡Habla con ese entrenador a ver si puedo entrenar con vosotras alguna tarde este verano!"
    sim "Halt! Okay! Sprich mit dem Trainer und frag, ob ich diesen Sommer an einigen Nachmittagen mit euch trainieren kann!"

# game/scripts/c24/c24.rpy:3072
translate german c24s004_Deb_Sim_8821a64c:

    # mc "¡Oh, [sim]! ¿Estabas aquí?"
    mc "Oh, [sim]! Warst du hier?"

# game/scripts/c24/c24.rpy:3073
translate german c24s004_Deb_Sim_46eb31ff:

    # sim "*Grrrr*"
    sim "*Grrrr*"

# game/scripts/c24/c24.rpy:3075
translate german c24s004_Deb_Sim_ebd8990d:

    # deb "*Risa* Si lo hubiéramos planeado no hubiera podido salir mejor."
    deb "*Gelächter* Wenn wir es geplant hätten, hätte es nicht besser laufen können."

# game/scripts/c24/c24.rpy:3076
translate german c24s004_Deb_Sim_a52d9d69:

    # mc "*Risa* Pero es una táctica que siempre funciona con los Washington. Comparar a [sim] y a Jamaal."
    mc "*Lacht* Aber diese Taktik funktioniert bei den Washingtons immer. (Vergleich von [sim] mit Jamaal.)"

# game/scripts/c24/c24.rpy:3078
translate german c24s004_Deb_Sim_721bf2a3:

    # sim "Pues ahora te vamos a expulsar de la piscina."
    sim "So, jetzt werfen wir dich aus dem Pool."

# game/scripts/c24/c24.rpy:3079
translate german c24s004_Deb_Sim_5a242d9e:

    # mc "¿Por qué a mí? ¡Lo hemos hecho [deb.nick] y yo!"
    mc "Warum ich? Wir haben es geschafft [deb.nick] und ich habe es geschafft!"

# game/scripts/c24/c24.rpy:3081
translate german c24s004_Deb_Sim_2e27a1e4:

    # sim "Puedes ir a la otra zona. Esto se acaba de convertir en Zona de Entrenamiento [sim]. Vamos a ponernos bañadores para entrenar. ¡No se puede entrenar en bikini!"
    sim "Du kannst in den anderen Bereich gehen. Dieser wurde gerade in die Trainingszone [sim] umgewandelt. Lasst uns Badeanzüge zum Training anziehen. Kein Training im Bikini!"

# game/scripts/c24/c24.rpy:3082
translate german c24s004_Deb_Sim_00322b59:

    # sim "No puedo hacer el ridículo cuando vaya a esos entrenamientos. Y [deb.nick] lo va a pagar ayudándome a entrenar. *Risa* Se le acabó hacer top-less."
    sim "Ich kann mich bei diesen Trainingseinheiten nicht blamieren. Und sie wird dafür büßen, indem sie mir beim Training hilft. *Lacht* Sie hat es satt, oben ohne herumzulaufen."

# game/scripts/c24/c24.rpy:3083
translate german c24s004_Deb_Sim_6e95e83f:

    # mc "Vale, vale. Ya me voy. Puedes pedirle un bañador a mi madre."
    mc "Okay, okay. Ich gehe jetzt. Du kannst meine Mutter nach einem Badeanzug fragen."

# game/scripts/c24/c24.rpy:3086
translate german c24s004_Deb_Sim_525bacf2:

    # sim "Aunque te bese, me las pagarás por lo que acabas de hacer."
    sim "Selbst wenn ich dich küsse, wirst du für das, was du getan hast, bezahlen."

# game/scripts/c24/c24.rpy:3089
translate german c24s004_Deb_Sim_5d0b2999:

    # sim "Aunque te abrace, me las pagarás por lo que acabas de hacer."
    sim "Selbst wenn ich dich umarme, wirst du für das, was du gerade getan hast, bezahlen."

# game/scripts/c24/c24.rpy:3090
translate german c24s004_Deb_Sim_ba6e11d1:

    # mc "Creo que más que pagártelas, me lo acabarás agradeciendo."
    mc "Ich glaube, dass Sie mir am Ende eher danken werden, als dass Sie dafür bezahlen."

# game/scripts/c24/c24.rpy:3095
translate german c24s004_Deb_Sim_207adb5a:

    # deb "Yo también lo creo. Nos lo acabará agradeciendo, pero ahora debes marcharte, antes de que cambie de opinión."
    deb "Das glaube ich auch. Er wird uns am Ende dafür danken, aber du musst jetzt gehen, bevor er es sich anders überlegt."

# game/scripts/c24/c24.rpy:3098
translate german c24s004_Deb_Sim_55823a68:

    # mc "Os dejo que vayáis a poneros los bañadores. Voy a ver qué están haciendo las otras chicas."
    mc "Ihr könnt jetzt eure Badeanzüge anziehen. Ich schaue mal, was die anderen Mädchen machen."

# game/scripts/c24/c24.rpy:3108
translate german c24s004_Mad_Lis_Emm_516952fc:

    # "Orgulloso de cómo las chicas se están ayudando entre ellas, sales de la piscina y te secas."
    "Stolz darauf, wie die Mädchen sich gegenseitig helfen, steigst du aus dem Pool und trocknest dich ab."

# game/scripts/c24/c24.rpy:3109
translate german c24s004_Mad_Lis_Emm_e2be684a:

    # "Te acercas a [lis], [emm], y [mad.nick], que parecen ocupadas alrededor de unos papeles."
    "Sie nähern sich [lis], [emm] und [mad.nick], die um einige Papiere herum beschäftigt zu sein scheinen."

# game/scripts/c24/c24.rpy:3110
translate german c24s004_Mad_Lis_Emm_525cc9aa:

    # mc "¿Qué tal, chicas?"
    mc "Hey Mädels!"

# game/scripts/c24/c24.rpy:3112
translate german c24s004_Mad_Lis_Emm_a71852af:

    # emm "¡Hola, [mc]!"
    emm "Hallo, [mc]!"

# game/scripts/c24/c24.rpy:3113
translate german c24s004_Mad_Lis_Emm_b1e4a5db:

    # lis "Estamos ayudando a [mad.nick] con sus diseños. A ver si podemos acabar hoy y así puede empezar con la costura."
    lis "Wir helfen [mad.nick] bei ihren Entwürfen. Mal sehen, ob wir heute noch fertig werden, damit sie mit dem Nähen anfangen kann."

# game/scripts/c24/c24.rpy:3114
translate german c24s004_Mad_Lis_Emm_00469f9c:

    # mad "Hay un montón de cosas en las que no había pensado."
    mad "Es gibt viele Dinge, über die ich noch nicht nachgedacht hatte."

# game/scripts/c24/c24.rpy:3115
translate german c24s004_Mad_Lis_Emm_85b9ddbf:

    # mc "Es genial que os estéis ayudando tanto."
    mc "Es ist toll, dass ihr euch gegenseitig so sehr helft."

# game/scripts/c24/c24.rpy:3117
translate german c24s004_Mad_Lis_Emm_41e57a73:

    # mc "¿No hay besos para mí, hoy?"
    mc "Heute keine Küsse für mich?"

# game/scripts/c24/c24.rpy:3121
translate german c24s004_Mad_Lis_Emm_af271d4a:

    # "Tu hermana se lanza a tus brazos para darte un largo beso. Prácticamente no habéis hablado desde que volvisteis de Monterey."
    "Deine Schwester wirft sich dir in die Arme und gibt dir einen langen Kuss. Ihr habt seit eurer Rückkehr aus Monterey kaum miteinander gesprochen."

# game/scripts/c24/c24.rpy:3123
translate german c24s004_Mad_Lis_Emm_9c4f444d:

    # "[emm] se lanza a tus brazos para darte un largo beso. Prácticamente no habéis hablado desde que volvisteis de Monterey."
    "[emm] wirft sich dir in die Arme und gibt dir einen langen Kuss. Ihr habt seit eurer Rückkehr aus Monterey kaum miteinander gesprochen."

# game/scripts/c24/c24.rpy:3125
translate german c24s004_Mad_Lis_Emm_6e1a52bd:

    # emm "Te aseguro que no voy a dejar de darte besos por unos vestidos, por bonitos que sean."
    emm "Ich versichere dir, dass ich dich nicht aufhören werde zu küssen, nur weil dir ein paar Kleider nicht gefallen, egal wie schön sie auch sein mögen."

# game/scripts/c24/c24.rpy:3128
translate german c24s004_Mad_Lis_Emm_113f97cd:

    # "La preciosa asiática te da un apasionado beso."
    "Die wunderschöne Asiatin gibt dir einen leidenschaftlichen Kuss."

# game/scripts/c24/c24.rpy:3130
translate german c24s004_Mad_Lis_Emm_149653a2:

    # mad "Por mucho que me gusten mis diseños, me gusta más esto."
    mad "So sehr ich meine Entwürfe auch mag, dieser hier gefällt mir noch besser."

# game/scripts/c24/c24.rpy:3133
translate german c24s004_Mad_Lis_Emm_f0bc6dec:

    # "[lis] se acerca tímidamente y se dirige a darte un beso en la mejilla. Giras un poco la cara para rozar sus labios. No se aparta."
    "[lis] nähert sich schüchtern und beugt sich vor, um dich auf die Wange zu küssen. Du drehst dein Gesicht leicht, um deine Lippen an seine zu streifen. Er weicht nicht zurück."

# game/scripts/c24/c24.rpy:3134
translate german c24s004_Mad_Lis_Emm_f4e0d435:

    # "Es la primera vez que tiene la oportunidad de demostrar en público que estáis juntos."
    "Dies ist das erste Mal, dass sie die Gelegenheit hat, öffentlich zu demonstrieren, dass ihr zusammen seid."

# game/scripts/c24/c24.rpy:3136
translate german c24s004_Mad_Lis_Emm_26089012:

    # emm "¡Eso no es un beso, [lis]! Estoy segura de que lo puedes hacer mejor."
    emm "Das ist kein Kuss, [lis]! Ich bin sicher, du kannst es besser."

# game/scripts/c24/c24.rpy:3138
translate german c24s004_Mad_Lis_Emm_f28bc6e6:

    # "Tu pequeña princesa parece olvidarse de que las otras dos chicas están alrededor y aumenta la pasión del beso. Un largo beso."
    "Deine kleine Prinzessin scheint zu vergessen, dass die anderen beiden Mädchen da sind, und die Leidenschaft des Kusses wird immer intensiver. Ein langer Kuss."

# game/scripts/c24/c24.rpy:3140
translate german c24s004_Mad_Lis_Emm_a4a11aa1:

    # emm "*Risa* ¡Eso está mejor! Pero, o volvemos a los vestidos, u os buscáis una habitación."
    emm "*Lacht* So ist es besser! Aber entweder wir kehren zu Kleidern zurück, oder ihr sucht euch ein Zimmer."

# game/scripts/c24/c24.rpy:3142
translate german c24s004_Mad_Lis_Emm_7e19a99d:

    # lis "*Risa* Si nos buscamos una habitación, seguro que convences a [mad.nick] para que haga todos los vestidos rosas."
    lis "*Lacht* Wenn wir ein Zimmer finden, bin ich mir sicher, dass du [mad.nick] davon überzeugen wirst, alle Kleider rosa zu machen."

# game/scripts/c24/c24.rpy:3144
translate german c24s004_Mad_Lis_Emm_24ba1971:

    # mad "¡Ni en broma! *Risa* Van a ser blancos. Le van a quedar genial a [kim]."
    mad "Niemals! *lacht* Die werden weiß sein. Die werden an [kim] toll aussehen."

# game/scripts/c24/c24.rpy:3148
translate german c24s004_Mad_Lis_Emm_d5d72893:

    # mad "Y falta [kim], que es quién va a ser la modelo."
    mad "Und [kim] fehlt, wer soll das Modell sein?"

# game/scripts/c24/c24.rpy:3149
translate german c24s004_Mad_Lis_Emm_7dcd21bd:

    # mad "Está probándose el uniforme que le han mandado para el trabajo de esta noche."
    mad "Er probiert die Uniform an, die sie ihm für den heutigen Einsatz geschickt haben."

# game/scripts/c24/c24.rpy:3150
translate german c24s004_Mad_Lis_Emm_efd19175:

    # mc "¿Puedo ayudaros con el tema de los vestidos? No es que sea un experto, pero..."
    mc "Kann ich Ihnen bei der Kleiderauswahl helfen? Ich bin zwar keine Expertin, aber..."

# game/scripts/c24/c24.rpy:3151
translate german c24s004_Mad_Lis_Emm_a8e56f70:

    # mc "Sé lo que queda sexy en una mujer."
    mc "Ich weiß, was an einer Frau sexy aussieht."

# game/scripts/c24/c24.rpy:3154
translate german c24s004_Mad_Lis_Emm_0ec2c031:

    # emm "*Risa* Si tuvieras que elegir lo que queda sexy en [kim], seguro que acababa sólo con un tanga."
    emm "*Lacht* Wenn du entscheiden müsstest, was in [kim] noch sexy ist, würde ich am Ende definitiv nur einen String tragen."

# game/scripts/c24/c24.rpy:3155
translate german c24s004_Mad_Lis_Emm_1f3c663c:

    # mc "Y estoy seguro de que estaría super sexy, pero no creo que sea el estilo que [mad.nick] quiere para sus vestidos."
    mc "Und ich bin mir sicher, es würde super sexy aussehen, aber ich glaube nicht, dass das der Stil ist, den [mad.nick] für ihre Kleider bevorzugt."

# game/scripts/c24/c24.rpy:3156
translate german c24s004_Mad_Lis_Emm_27ad541d:

    # mc "¿Es para otro concurso?"
    mc "Ist es für einen anderen Wettbewerb?"

# game/scripts/c24/c24.rpy:3158
translate german c24s004_Mad_Lis_Emm_30d98925:

    # mad "No, esta vez estamos refinando mi portfolio de diseños. Voy a coser los vestidos para [kim], de tal forma que [emm] pueda hacer las fotos."
    mad "Nein, diesmal verfeinern wir mein Designportfolio. Ich werde die Kleider für [kim] nähen, damit [emm] die Fotos machen kann."

# game/scripts/c24/c24.rpy:3160
translate german c24s004_Mad_Lis_Emm_d415f031:

    # mc "Me parece una idea estupenda. Y supongo que [lis] está para evitar que [emm] te convenza para que los hagas rosas."
    mc "Ich finde das eine tolle Idee. Und ich nehme an, [lis] soll verhindern, dass [emm] dich dazu überredet, sie rosa zu färben."

# game/scripts/c24/c24.rpy:3162
translate german c24s004_Mad_Lis_Emm_31799661:

    # mc "Me parece una idea estupenda. Y, aparte de evitar que [emm] te convenza para que los hagas rosas, ¿cuál es la función de [lis]?"
    mc "Ich finde das eine großartige Idee. Und abgesehen davon, dass es verhindert, dass [emm] dich dazu bringt, sie rosa zu färben, welche Funktion hat [lis]?"

# game/scripts/c24/c24.rpy:3164
translate german c24s004_Mad_Lis_Emm_ac794a80:

    # lis "*Risa* Hay un par de vestidos que están pensados para cenas de gala y eventos sociales."
    lis "*Gelächter* Es gibt ein paar Kleider, die für Galadinner und gesellschaftliche Anlässe entworfen wurden."

# game/scripts/c24/c24.rpy:3165
translate german c24s004_Mad_Lis_Emm_86bf68ab:

    # lis "Esos los va a hacer [mad.nick] también en mi talla y la de [deb.nick], así podemos usarlos cuando vayamos a alguna fiesta con famosos y hacerle un poco de publicidad."
    lis "Er wird die auch in meiner Größe und in F3-Größe anfertigen, damit wir sie auf einer Party mit Prominenten tragen und ihm ein bisschen Publicity verschaffen können."

# game/scripts/c24/c24.rpy:3166
translate german c24s004_Mad_Lis_Emm_e47691d6:

    # mc "Empezáis a dar un poco de miedo. Parece que habéis encontrado una forma en que todas aportáis algo y todas ganáis algo."
    mc "Du wirst langsam etwas unheimlich. Es scheint, als hättest du einen Weg gefunden, bei dem jeder etwas beiträgt und jeder etwas davon hat."

# game/scripts/c24/c24.rpy:3167
translate german c24s004_Mad_Lis_Emm_e122a3d5:

    # mc "Experiencia, publicidad, portfolio, o vestidos."
    mc "Erfahrung, Werbung, Portfolio oder Kleider."

# game/scripts/c24/c24.rpy:3169
translate german c24s004_Mad_Lis_Emm_477f2a47:

    # lis "*Risa* Lo dices como si fuera una transacción comercial, y lo estamos haciendo por ayudar a [mad.nick] con sus diseños y a [kim] con su portfolio."
    lis "*Lacht* Du sagst es so, als wäre es eine Geschäftstransaktion, und wir tun es, um [mad.nick] bei ihren Entwürfen und [kim] bei ihrem Portfolio zu helfen."

# game/scripts/c24/c24.rpy:3170
translate german c24s004_Mad_Lis_Emm_b344721f:

    # lis "Y para que [emm] pueda hacer su primer trabajo semiprofesional... *Risa* Vale, sí. Experiencia, publicidad, portfolio, y vestidos."
    lis "Und damit [emm] ihren ersten halbwegs professionellen Job machen kann... *Lacht* Okay, ja. Erfahrung, Werbung, Portfolio und Kleider."

# game/scripts/c24/c24.rpy:3171
translate german c24s004_Mad_Lis_Emm_d97cdb7b:

    # mc "*Risa* Aunque vuestras acciones sean altruistas, todas ganáis algo. Es la mejor forma de hacerlo."
    mc "*Gelächter* Auch wenn eure Handlungen altruistisch sind, profitiert ihr alle davon. Das ist der beste Weg."

# game/scripts/c24/c24.rpy:3173
translate german c24s004_Mad_Lis_Emm_1b1ee8ed:

    # mad "Sólo nos falta convencer a [deb.nick] para que pose con los vestidos que le voy a hacer."
    mad "Jetzt müssen wir nur noch [deb.nick] davon überzeugen, in den Kleidern zu posieren, die ich für sie anfertigen werde."

# game/scripts/c24/c24.rpy:3174
translate german c24s004_Mad_Lis_Emm_bb28ec00:

    # mad "Siendo tan alta, las fotos quedarían geniales."
    mad "Da er so groß ist, würden die Fotos großartig werden."

# game/scripts/c24/c24.rpy:3175
translate german c24s004_Mad_Lis_Emm_05d04fb6:

    # mcp "(Y le ayudaríais a entender que ser alta puede tener muchas ventajas.)"
    mcp "(Und Sie würden ihr helfen zu verstehen, dass groß sein viele Vorteile haben kann.)"

# game/scripts/c24/c24.rpy:3177
translate german c24s004_Mad_Lis_Emm_fec9e41f:

    # mcp "(Y que no me gusta sólo a mí que sea así.)"
    mcp "(Und nicht nur ich mag es so.)"

# game/scripts/c24/c24.rpy:3178
translate german c24s004_Mad_Lis_Emm_9cf0af5b:

    # mc "Supongo que diferentes vestidos quedarán mejor o peor en diferentes modelos."
    mc "Ich nehme an, dass verschiedene Kleider an verschiedenen Models besser oder schlechter aussehen."

# game/scripts/c24/c24.rpy:3180
translate german c24s004_Mad_Lis_Emm_b12266cc:

    # emm "*Risa* Y si haces un vestido rosa, yo me presto voluntaria para posar con él."
    emm "*Lacht* Und wenn du ein rosa Kleid machst, melde ich mich freiwillig, darin zu posieren."

# game/scripts/c24/c24.rpy:3181
translate german c24s004_Mad_Lis_Emm_980c43f9:

    # emm "Cuantas más modelos diferentes tengas, más profesional quedará tu portfolio."
    emm "Je mehr verschiedene Modelle Sie haben, desto professioneller wirkt Ihr Portfolio."

# game/scripts/c24/c24.rpy:3182
translate german c24s004_Mad_Lis_Emm_a7eac97b:

    # mc "¿Quién sacará las fotos si tú estás posando?"
    mc "Wer macht die Fotos, wenn du posierst?"

# game/scripts/c24/c24.rpy:3184
translate german c24s004_Mad_Lis_Emm_27553ae9:

    # lis "Las puedo sacar yo. No soy tan buena como [emm], pero sé algo de fotografía."
    lis "Ich kann sie selbst machen. Ich bin zwar nicht so gut wie [emm], aber ich kenne mich ein bisschen mit Fotografie aus."

# game/scripts/c24/c24.rpy:3185
translate german c24s004_Mad_Lis_Emm_f1bbd183:

    # mc "Genial ¿Vais a hacer las fotos en la piscina? Podrían quedar muy chulas."
    mc "Super! Wirst du die Fotos im Pool machen? Die könnten echt cool werden."

# game/scripts/c24/c24.rpy:3187
translate german c24s004_Mad_Lis_Emm_8d2b93f9:

    # mad "Haremos algunas aquí y otras en el bosque, quizás algunas en la playa, incluso. Pero, para el portfolio, quedarían mejor en un estudio."
    mad "Wir machen ein paar Fotos hier und andere im Wald, vielleicht sogar welche am Strand. Für die Mappe würden sie aber in einem Studio besser aussehen."

# game/scripts/c24/c24.rpy:3189
translate german c24s004_Mad_Lis_Emm_fd57f5d8:

    # emm "Quiero convencer a Mamá para que me deje usar parte del sótano para montar un estudio de fotografía. No necesito mucha inversión y hay un montón de espacio sin usar."
    emm "Ich möchte meine Mutter davon überzeugen, mir einen Teil des Kellers für mein Fotostudio zur Verfügung zu stellen. Ich brauche keine große Investition und es gibt viel ungenutzten Platz."

# game/scripts/c24/c24.rpy:3190
translate german c24s004_Mad_Lis_Emm_fcf0bd70:

    # emm "¿Crees que me dejará hacerlo?"
    emm "Glaubst du, er wird es mir erlauben?"

# game/scripts/c24/c24.rpy:3191
translate german c24s004_Mad_Lis_Emm_145f4ce8:

    # mc "No creo que ponga ningún impedimento. Siempre dice que deberíamos darle alguna utilidad al sótano."
    mc "Ich glaube nicht, dass er etwas dagegen haben wird. Er meint immer, wir sollten den Keller irgendwie nutzen."

# game/scripts/c24/c24.rpy:3193
translate german c24s004_Mad_Lis_Emm_c3e133e8:

    # mad "Para alguna de las fotos que tengo pensadas... ¿te importaría posar con [kim]?"
    mad "Für einige der Fotos, die ich geplant habe... hättest du etwas dagegen, mit [kim] zu posieren?"

# game/scripts/c24/c24.rpy:3194
translate german c24s004_Mad_Lis_Emm_c128bb2e:

    # mad "Hay algunos vestidos que quedarían genial en poses románticas con un chico."
    mad "Es gibt einige Kleider, die in romantischen Posen mit einem Mann toll aussehen würden."

# game/scripts/c24/c24.rpy:3195
translate german c24s004_Mad_Lis_Emm_5b721e88:

    # mc "*Risa* ¿Quieres que haga de modelo para ti? Por mí no hay ningún problema."
    mc "*Lacht* Soll ich für Sie Modell stehen? Damit hätte ich kein Problem."

# game/scripts/c24/c24.rpy:3197
translate german c24s004_Mad_Lis_Emm_d085e527:

    # emm "*Risa* Podrías hacer del madurito cuarentón seduciendo a una jovencita. Ya sabes que aparentas más edad de la que tienes."
    emm "*Lacht* Du könntest den Mann mittleren Alters in seinen Vierzigern spielen, der eine junge Frau verführt. Du weißt ja, dass du älter aussiehst, als du bist."

# game/scripts/c24/c24.rpy:3199
translate german c24s004_Mad_Lis_Emm_c553849f:

    # mc "*Risa* Contigo funcionó, aunque no tuviera que hacer nada para seducirte."
    mc "*Lacht* Bei dir hat es geklappt, obwohl ich gar nichts tun musste, um dich zu verführen."

# game/scripts/c24/c24.rpy:3201
translate german c24s004_Mad_Lis_Emm_ab9a09cf:

    # mc "*Risa* Podría ser divertido."
    mc "*lacht* Das könnte lustig werden."

# game/scripts/c24/c24.rpy:3202
translate german c24s004_Mad_Lis_Emm_91fefb40:

    # mc "¿También hay trajes para mí?"
    mc "Gibt es auch Anzüge für mich?"

# game/scripts/c24/c24.rpy:3204
translate german c24s004_Mad_Lis_Emm_4cefdcd6:

    # lis "No, [mad.nick] no hace ropa para hombre, al menos aún."
    lis "Nein, [mad.nick] stellt keine Kleidung für Männer her, zumindest noch nicht."

# game/scripts/c24/c24.rpy:3205
translate german c24s004_Mad_Lis_Emm_cd94c3a4:

    # lis "Pero estarías muy bien con el traje que llevaste al Jazz Corner."
    lis "Aber der Anzug, den du im Jazz Corner getragen hast, würde dir hervorragend stehen."

# game/scripts/c24/c24.rpy:3207
translate german c24s004_Mad_Lis_Emm_5b71ce45:

    # mad "*Risa* Sabéis que os odio a veces, ¿verdad?"
    mad "*lacht* Ihr wisst doch, dass ich euch manchmal hasse, oder?"

# game/scripts/c24/c24.rpy:3208
translate german c24s004_Mad_Lis_Emm_b3961c59:

    # mc "¿Por qué?"
    mc "Weil?"

# game/scripts/c24/c24.rpy:3210
translate german c24s004_Mad_Lis_Emm_801f217c:

    # mad "Es una tontería pero, excepto el cumpleaños de las chicas, me he perdido todas las actividades familiares."
    mad "Es klingt vielleicht komisch, aber abgesehen vom Geburtstag der Mädchen habe ich alle Familienaktivitäten verpasst."

# game/scripts/c24/c24.rpy:3211
translate german c24s004_Mad_Lis_Emm_b40dc845:

    # mad "La fiesta en la playa, la noche en el club de Jazz... A veces os ponéis a hablar de esas cosas y estoy un poco fuera de lugar."
    mad "Die Strandparty, der Abend im Jazzclub... Manchmal fangt ihr an, über solche Dinge zu reden, und ich fühle mich ein bisschen fehl am Platz."

# game/scripts/c24/c24.rpy:3212
translate german c24s004_Mad_Lis_Emm_a2ed892b:

    # mad "Me hubiera gustado estar, pero hasta la partida de DnD no me sentía parte de esto..."
    mad "Ich wäre gern dabei gewesen, aber solange D&D dabei waren, hatte ich nicht das Gefühl, dazuzugehören..."

# game/scripts/c24/c24.rpy:3214
translate german c24s004_Mad_Lis_Emm_89c7a297:

    # emm "No te preocupes, [mad.nick]. A partir de ahora vendrás siempre que hagamos algo especial."
    emm "Keine Sorge, [mad.nick]. Von nun an kommst du immer, wenn wir etwas Besonderes machen."

# game/scripts/c24/c24.rpy:3215
translate german c24s004_Mad_Lis_Emm_c4691a62:

    # emm "Estoy pensando que, si tú te sientes así, ¿cómo se van a sentir las chicas que llegan en Septiembre?"
    emm "Ich frage mich, wenn du dich schon so fühlst, wie werden sich dann erst die Mädchen fühlen, die im September ankommen?"

# game/scripts/c24/c24.rpy:3216
translate german c24s004_Mad_Lis_Emm_ea950fdc:

    # mc "Bueno, falta por ver si se integran en la familia tan rápido como..."
    mc "Nun, es bleibt abzuwarten, ob sie sich genauso schnell in die Familie integrieren wie..."

# game/scripts/c24/c24.rpy:3218
translate german c24s004_Mad_Lis_Emm_13336c01:

    # lis "¿Como nosotras? Estoy segura de que lo harán. [sca] me dijo que una de ellas era amiga suya y de [dap] hace años, que vivía en Newport."
    lis "Mögen sie uns? Da bin ich mir sicher. [sca] erzählte mir, dass eine von ihnen eine Freundin von ihr und [dap] aus früheren Zeiten sei, die in Newport wohnte."

# game/scripts/c24/c24.rpy:3219
translate german c24s004_Mad_Lis_Emm_d2bfd7da:

    # lis "Integrarla a ella en la familia será fácil, y a la prima de [sai] también."
    lis "Sie in die Familie zu integrieren wird einfach sein, ebenso wie die Cousine von [sai]."

# game/scripts/c24/c24.rpy:3220
translate german c24s004_Mad_Lis_Emm_73e1891a:

    # mc "¿Quién es la amiga de [dap] y [sca]?"
    mc "Wer ist der Freund von [dap] und [sca]?"

# game/scripts/c24/c24.rpy:3222
translate german c24s004_Mad_Lis_Emm_2006bb97:

    # emm "Patty. No sé si la recuerdas, morena, ojos grandes... era un par de días mayor que [sca]. No era muy amiga mía, pero nos llevábamos bien."
    emm "Patty. Ich weiß nicht, ob du dich an sie erinnerst, brünett, große Augen... sie war ein paar Tage älter als [sca]. Sie war keine sehr enge Freundin von mir, aber wir kamen ganz gut miteinander aus."

# game/scripts/c24/c24.rpy:3223
translate german c24s004_Mad_Lis_Emm_c6e65843:

    # emm "Su madre encontró trabajo en Dallas, y se marcharon un año antes de que tú te graduaras."
    emm "Deine Mutter hat eine Stelle in Dallas gefunden, und sie sind ein Jahr vor deinem Studienabschluss weggezogen."

# game/scripts/c24/c24.rpy:3224
translate german c24s004_Mad_Lis_Emm_9735c5af:

    # mc "Me suena el nombre, pero no le puedo poner cara."
    mc "Der Name kommt mir bekannt vor, aber ich kann mir die Person nicht vorstellen."

# game/scripts/c24/c24.rpy:3225
translate german c24s004_Mad_Lis_Emm_361c0599:

    # emm "Deberías mirar los expedientes de las chicas nuevas y..."
    emm "Sie sollten sich die Akten der neuen Mädchen ansehen und..."

# game/scripts/c24/c24.rpy:3227
translate german c24s004_Mad_Lis_Emm_7e4f81b9:

    # kim "[mad.nick], ¿me puedes ayudar a...?"
    kim "[mad.nick], können Sie mir helfen bei...?"

# game/scripts/c24/c24.rpy:3229
translate german c24s004_Mad_Lis_Emm_1b793e18:

    # kim "¡Oops! Veo que estáis ocupadas. No os preocupéis."
    kim "Oh je! Ich sehe, Sie sind beschäftigt. Keine Sorge."

# game/scripts/c24/c24.rpy:3231
translate german c24s004_Mad_Lis_Emm_92ebf9da:

    # kim "Voy a pedirle ayuda a la Abuela..."
    kim "Ich werde Oma um Hilfe bitten..."

# game/scripts/c24/c24.rpy:3233
translate german c24s004_Mad_Lis_Emm_0cf2d20b:

    # mc "¿Qué le pasa?"
    mc "Was stimmt nicht mit ihm?"

# game/scripts/c24/c24.rpy:3234
translate german c24s004_Mad_Lis_Emm_1312c559:

    # emm "¿No la has oído? Ha visto que [mad.nick] está ocupada y..."
    emm "Hast du sie nicht gehört? Sie sah, dass [mad.nick] beschäftigt war und..."

# game/scripts/c24/c24.rpy:3235
translate german c24s004_Mad_Lis_Emm_4c912813:

    # mad "... Y no ha querido entretenerme por si..."
    mad "...Und er wollte mich nicht behalten, falls..."

# game/scripts/c24/c24.rpy:3236
translate german c24s004_Mad_Lis_Emm_ae12de5d:

    # lis "... Por si estaba haciendo algo importante... supongo..."
    lis "...Falls er gerade etwas Wichtiges zu tun hatte... nehme ich an..."

# game/scripts/c24/c24.rpy:3237
translate german c24s004_Mad_Lis_Emm_8fb9d37f:

    # mc "¿Qué me estáis ocultando, chicas?"
    mc "Was verheimlicht ihr mir, Mädels?"

# game/scripts/c24/c24.rpy:3239
translate german c24s004_Mad_Lis_Emm_82af4742:

    # lis "¿Nosotras?"
    lis "Uns?"

# game/scripts/c24/c24.rpy:3240
translate german c24s004_Mad_Lis_Emm_54273a9a:

    # emm "¿Qué íbamos a querer ocultarte?"
    emm "Was sollten wir vor Ihnen verbergen?"

# game/scripts/c24/c24.rpy:3241
translate german c24s004_Mad_Lis_Emm_c88f9707:

    # mad "Si es algo en lo que puede ayudarle [mee]..." id c24s004_Mad_Lis_Emm_c88f9707
    mad "Falls ich Ihnen in irgendeiner Weise behilflich sein kann..." id c24s004_Mad_Lis_Emm_c88f9707

# game/scripts/c24/c24.rpy:3242
translate german c24s004_Mad_Lis_Emm_926339a4:

    # mc "Vale, no os voy a sacar nada, ¿verdad?"
    mc "Okay, ich kriege eh nichts von dir, oder?"

# game/scripts/c24/c24.rpy:3244
translate german c24s004_Mad_Lis_Emm_358c1155:

    # "Todas" "Nope."
    "Todas" "Nein."

# game/scripts/c24/c24.rpy:3245
translate german c24s004_Mad_Lis_Emm_0d14768e:

    # lis "Además, lo dices como si... en el caso de que le pasara algo a [kim]... nosotras supiéramos qué es."
    lis "Außerdem sagst du es so, als ob... falls [kim] etwas zustoßen sollte... wir wüssten, was es ist."

# game/scripts/c24/c24.rpy:3246
translate german c24s004_Mad_Lis_Emm_e6e01b5f:

    # emm "Y no estamos diciendo que le pase nada..."
    emm "Und wir sagen nicht, dass ihm etwas Schlimmes zustoßen wird..."

# game/scripts/c24/c24.rpy:3247
translate german c24s004_Mad_Lis_Emm_64443da5:

    # mad "Ni que sepamos qué le pasa... si es que le pasa algo. O que te lo fuéramos a decir si lo supiéramos."
    mad "Nicht, dass wir wüssten, was mit ihm los ist ... falls überhaupt etwas mit ihm los ist. Und selbst wenn wir es wüssten, würden wir es Ihnen nicht sagen."

# game/scripts/c24/c24.rpy:3248
translate german c24s004_Mad_Lis_Emm_6245c0df:

    # mc "*Risa* Vale, vale. Pero... ¿ha llamado 'Abuela' a Meemaw?"
    mc "*lacht* Okay, okay. Aber... hat sie Meemaw „Oma“ genannt?"

# game/scripts/c24/c24.rpy:3250
translate german c24s004_Mad_Lis_Emm_d2f469c8:

    # emm "*Risa* Sí. [kim] está llevando lo de integrarse en la familia a un nuevo nivel. Pero aún no se atreve a llamárselo a ella."
    emm "*Lacht* Ja. [kim] treibt die Integration in die Familie auf die Spitze. Aber er traut sich immer noch nicht, sie anzurufen."

# game/scripts/c24/c24.rpy:3251
translate german c24s004_Mad_Lis_Emm_07cfc36c:

    # lis "*Risa* El día menos pensado nos empieza a llamar hermanas a todas."
    lis "*Gelächter* Eines Tages wird er uns alle Schwestern nennen."

# game/scripts/c24/c24.rpy:3252
translate german c24s004_Mad_Lis_Emm_d9c03e82:

    # mad "*Risa* No dejaría de ser divertido que tantas chicas de razas diferentes nos empezásemos a considerar hermanas algún día."
    mad "*lacht* Es wäre lustig, wenn so viele Mädchen unterschiedlicher Herkunft sich eines Tages gegenseitig als Schwestern betrachten würden."

# game/scripts/c24/c24.rpy:3253
translate german c24s004_Mad_Lis_Emm_e2655347:

    # "En ese momento oís una furgoneta y cómo se abre la verja de entrada."
    "In diesem Moment hört man einen Lieferwagen und das Eingangstor öffnet sich."

# game/scripts/c24/c24.rpy:3256
translate german c24s004_Mad_Lis_Emm_d4ec7df7:

    # emm "Creo que esa es [ama]. Debe venir a buscarte para lo de esta noche."
    emm "Ich glaube, das ist [ama]. Er sollte dich heute Abend abholen."

# game/scripts/c24/c24.rpy:3257
translate german c24s004_Mad_Lis_Emm_36dfb3ee:

    # mc "Pero es muy pronto para que venga el helicóptero."
    mc "Aber es ist noch zu früh für den Hubschrauber."

# game/scripts/c24/c24.rpy:3258
translate german c24s004_Mad_Lis_Emm_43266a7a:

    # emm "A lo mejor quiere repasar algunos datos."
    emm "Vielleicht möchte er einige Daten überprüfen."

# game/scripts/c24/c24.rpy:3259
translate german c24s004_Mad_Lis_Emm_605d1430:

    # mc "Voy a ver..."
    mc "Ich werde sehen..."

# game/scripts/c24/c24.rpy:3269
translate german c24s004_Mad_Lis_Emm_66e9c8c2:

    # "Te despides de las chicas y te diriges a la furgoneta."
    "Du verabschiedest dich von den Mädchen und gehst zum Van."

# game/scripts/c24/c24.rpy:3271
translate german c24s004_Mad_Lis_Emm_7a8239e6:

    # "[ama] está sentada dentro, parece que está escribiendo algo."
    "[ama] sitzt drinnen, es sieht so aus, als würde sie etwas schreiben."

# game/scripts/c24/c24.rpy:3273
translate german c24s004_Mad_Lis_Emm_d9be006a:

    # "Te acercas a la furgoneta, dispuesto a golpear en la ventanilla."
    "Du näherst dich dem Lieferwagen, bereit, an das Fenster zu klopfen."

# game/scripts/c24/c24.rpy:3274
translate german c24s004_Mad_Lis_Emm_4671c751:

    # ama "Un momento, [mc], por favor."
    ama "Einen Moment bitte, [mc]."

# game/scripts/c24/c24.rpy:3276
translate german c24s004_Mad_Lis_Emm_f63377ab:

    # "Esperas."
    "Du wartest."

# game/scripts/c24/c24.rpy:3280
translate german c24s004_Kim_Mee_Meg_1657ce25:

    # "Unos minutos antes, en la cocina de [nor]..."
    "Wenige Minuten zuvor, in der Küche von [nor]..."

# game/scripts/c24/c24.rpy:3282
translate german c24s004_Kim_Mee_Meg_c653479e:

    # mee "Un día tengo que ir a oírte cantar. Siempre me ha gustado el jazz."
    mee "Ich muss dich unbedingt mal singen hören. Ich habe Jazz schon immer geliebt."

# game/scripts/c24/c24.rpy:3283
translate german c24s004_Kim_Mee_Meg_af457e4a:

    # meg "Aunque el sitio se llame Jazz Corner, no solo canto jazz. Tenemos un repertorio muy variado."
    meg "Obwohl der Laden Jazz Corner heißt, singe ich nicht nur Jazz. Wir haben ein sehr abwechslungsreiches Repertoire."

# game/scripts/c24/c24.rpy:3285
translate german c24s004_Kim_Mee_Meg_3af7fb04:

    # mee "Bueno, igualmente me gustaría ir. Hace años que no voy a ningún sitio con música en directo."
    mee "Nun ja, ich würde trotzdem gerne hingehen. Es ist schon Jahre her, dass ich irgendwo war, wo Live-Musik gespielt wurde."

# game/scripts/c24/c24.rpy:3287
translate german c24s004_Kim_Mee_Meg_ff447e67:

    # meg "¿Ibas mucho cuando...?"
    meg "Warst du oft dort, als...?"

# game/scripts/c24/c24.rpy:3289
translate german c24s004_Kim_Mee_Meg_1dfbe6a8:

    # mee "*Risa* ¿Cuando era joven?"
    mee "*lacht* Als ich jung war?"

# game/scripts/c24/c24.rpy:3290
translate german c24s004_Kim_Mee_Meg_441cb2fd:

    # mee "Sí, a John y a mí nos gustaba mucho ir, especialmente antes de casarnos, cuando él aún vivía en San Francisco."
    mee "Ja, John und ich sind sehr gerne dorthin gefahren, besonders bevor wir geheiratet haben, als er noch in San Francisco wohnte."

# game/scripts/c24/c24.rpy:3292
translate german c24s004_Kim_Mee_Meg_ee6c2dee:

    # meg "San Francisco siempre ha tenido buenos clubes de jazz. ¿Teníais algún favorito?"
    meg "San Francisco hatte schon immer großartige Jazzclubs. Hattest du irgendwelche Favoriten?"

# game/scripts/c24/c24.rpy:3294
translate german c24s004_Kim_Mee_Meg_19267300:

    # mee "Sí, el Keystone Korner. Un clásico. Incluso estuvimos allí en un par de ocasiones cuando hicieron grabaciones de directos."
    mee "Ja, das Keystone Korner. Ein Klassiker. Wir waren sogar ein paar Mal dort, als sie Live-Shows aufzeichneten."

# game/scripts/c24/c24.rpy:3295
translate german c24s004_Kim_Mee_Meg_fee7d91a:

    # mee "Todavía tengo los vinilos de esas grabaciones."
    mee "Ich besitze noch immer die Schallplatten dieser Aufnahmen."

# game/scripts/c24/c24.rpy:3297
translate german c24s004_Kim_Mee_Meg_add89710:

    # meg "¡Oh! ¡Eso es increíble! ¿De quién son los discos?"
    meg "Oh! Das ist ja fantastisch! Wessen Schallplatten sind das?"

# game/scripts/c24/c24.rpy:3299
translate german c24s004_Kim_Mee_Meg_050b1da4:

    # mee "Uno es de Tete Montoliu y otro de Jaki Byard, los dos en el '79 o el '80. Son fantásticos."
    mee "Das eine ist von Tete Montoliu, das andere von Jaki Byard, beide aus dem Jahr 1979 oder 1980. Sie sind fantastisch."

# game/scripts/c24/c24.rpy:3301
translate german c24s004_Kim_Mee_Meg_90e7cdda:

    # meg "¡Me tienes que dejar escucharlos!"
    meg "Du musst mich sie anhören lassen!"

# game/scripts/c24/c24.rpy:3302
translate german c24s004_Kim_Mee_Meg_c08e7e22:

    # meg "Me das mucha envidia. ¡Estuviste ahí cuando se escribía historia de la música!"
    meg "Ich bin so neidisch auf dich. Du warst dabei, als Musikgeschichte geschrieben wurde!"

# game/scripts/c24/c24.rpy:3304
translate german c24s004_Kim_Mee_Meg_db86b5aa:

    # mee "Bueno, eran otros tiempos. Todo era más artesanal."
    mee "Nun ja, das waren andere Zeiten. Alles war handwerklicher."

# game/scripts/c24/c24.rpy:3305
translate german c24s004_Kim_Mee_Meg_5a09e21b:

    # mee "Los tengo en la casa de Florida. Te los traeré cuando vaya la semana que viene a poner la casa en venta."
    mee "Ich habe sie in meinem Haus in Florida. Ich bringe sie Ihnen nächste Woche mit, wenn ich hinfahre, um das Haus zum Verkauf anzubieten."

# game/scripts/c24/c24.rpy:3307
translate german c24s004_Kim_Mee_Meg_efa5a653:

    # meg "Explícame cosas de aquella época, por favor. Es una de mis épocas favoritas de la música."
    meg "Erzählen Sie mir bitte etwas über diese Ära. Sie gehört zu meinen Lieblingsperioden in der Musikgeschichte."

# game/scripts/c24/c24.rpy:3309
translate german c24s004_Kim_Mee_Meg_a17d78ab:

    # "Las dos mujeres se enzarzan en una conversación sobre una época pasada de clubs de música donde pasaban cosas importantes."
    "Die beiden Frauen unterhalten sich über eine längst vergangene Ära der Musikclubs, in der wichtige Dinge geschahen."

# game/scripts/c24/c24.rpy:3311
translate german c24s004_Kim_Mee_Meg_8015d8a9:

    # "Un tiempo en el que podías coincidir con músicos famosos en clubs que no estaban abarrotados."
    "Eine Zeit, in der man berühmte Musiker in Clubs treffen konnte, die nicht überfüllt waren."

# game/scripts/c24/c24.rpy:3314
translate german c24s004_Kim_Mee_Meg_96cd1768:

    # kim "Hola, [mee]. ¿Qué hay, [meg]?"
    kim "Hallo, [mee]. Was gibt's, [meg]?"

# game/scripts/c24/c24.rpy:3315
translate german c24s004_Kim_Mee_Meg_acb33e75:

    # kim "¿Puedo pedirte un favor, [mee]?"
    kim "Kann ich dich um einen Gefallen bitten, [mee]?"

# game/scripts/c24/c24.rpy:3317
translate german c24s004_Kim_Mee_Meg_566154d1:

    # mee "Lo que quieras, cielo."
    mee "Ganz wie du willst, Liebling."

# game/scripts/c24/c24.rpy:3318
translate german c24s004_Kim_Mee_Meg_f494511a:

    # meg "¿Qué pasa, [kim]?"
    meg "Was geht, [kim]?"

# game/scripts/c24/c24.rpy:3320
translate german c24s004_Kim_Mee_Meg_37bf481f:

    # kim "Al ponerme el uniforme para esta noche lo he roto. Me va un poco apretado..."
    kim "Ich habe meine Uniform zerrissen, als ich sie heute Abend anzog. Sie ist etwas zu eng..."

# game/scripts/c24/c24.rpy:3321
translate german c24s004_Kim_Mee_Meg_551c25ce:

    # kim "He intentado coserlo, pero... estoy muy nerviosa y soy incapaz de enhebrar la aguja."
    kim "Ich habe versucht, es zu nähen, aber... ich bin sehr nervös und kann den Faden nicht einfädeln."

# game/scripts/c24/c24.rpy:3323
translate german c24s004_Kim_Mee_Meg_af0836b9:

    # mee "Dame ese uniforme. Deja que la abuela haga su magia con la aguja."
    mee "Gib mir die Uniform. Lass Oma ihre Nähkünste unter Beweis stellen."

# game/scripts/c24/c24.rpy:3324
translate german c24s004_Kim_Mee_Meg_b57a3de6:

    # mee "¿Hay hilo y aguja en esa bolsa? Siéntate mientras lo coso."
    mee "Sind in der Tasche Nadel und Faden? Setz dich, während ich nähe."

# game/scripts/c24/c24.rpy:3326
translate german c24s004_Kim_Mee_Meg_41d397cb:

    # "Unos minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c24/c24.rpy:3327
translate german c24s004_Kim_Mee_Meg_330d4fd8:

    # mee "Ya está cosido. He reforzado alguna de las costuras que parecían más débiles."
    mee "Es ist bereits genäht. Ich habe einige Nähte verstärkt, die mir schwächer erschienen."

# game/scripts/c24/c24.rpy:3328
translate german c24s004_Kim_Mee_Meg_29f1f78b:

    # mee "Ese uniforme estaba muy mal cosido."
    mee "Die Uniform war sehr schlecht genäht."

# game/scripts/c24/c24.rpy:3330
translate german c24s004_Kim_Mee_Meg_b8c3d049:

    # kim "Gracias, [mee]. No sé qué habría hecho sin ti. Voy a probármelo a ver si no rompo nada esta vez."
    kim "Danke, [mee]. Ich weiß nicht, was ich ohne dich getan hätte. Ich probiere es jetzt mal an und schaue, ob ich diesmal nichts kaputt mache."

# game/scripts/c24/c24.rpy:3332
translate german c24s004_Kim_Mee_Meg_c1aba282:

    # meg "Pruébatelo en el baño si quieres y así te lo vemos puesto."
    meg "Probieren Sie es ruhig im Badezimmer an, und wir werden sehen, wie Sie es tragen."

# game/scripts/c24/c24.rpy:3333
translate german c24s004_Kim_Mee_Meg_5dabd8a1:

    # meg "Y [mee] puede repararlo si se rompe alguna otra costura."
    meg "Und [mee] Sie können es reparieren, falls eine andere Naht reißt."

# game/scripts/c24/c24.rpy:3335
translate german c24s004_Kim_Mee_Meg_7c4a90bf:

    # mee "O puedes subir a mi habitación si quieres. O incluso cambiarte aquí."
    mee "Oder du kannst gerne in mein Zimmer kommen. Oder dich auch hier umziehen."

# game/scripts/c24/c24.rpy:3336
translate german c24s004_Kim_Mee_Meg_7741ec41:

    # mee "*Risa* Esta cocina ya ha visto a mucha gente desnuda últimamente."
    mee "*Gelächter* In letzter Zeit habe ich in dieser Küche viele nackte Menschen gesehen."

# game/scripts/c24/c24.rpy:3338
translate german c24s004_Kim_Mee_Meg_fcd06ab9:

    # meg "¿A quién? Creía que la zona nudista era solo en el jacuzzi."
    meg "Für wen? Ich dachte, der FKK-Bereich befände sich nur im Whirlpool."

# game/scripts/c24/c24.rpy:3340
translate german c24s004_Kim_Mee_Meg_71aa2cba:

    # kim "Oí que [mc] se había desnudado aquí para poner fin a una discusión sobre la desnudez el día del secuestro."
    kim "Ich habe gehört, dass [mc] sich hier am Tag der Entführung nackt ausgezogen hat, um einen Streit über Nacktheit zu beenden."

# game/scripts/c24/c24.rpy:3341
translate german c24s004_Kim_Mee_Meg_393174ef:

    # kim "A veces tiene unos métodos... extraños..."
    kim "Manchmal hat er einige... seltsame Methoden..."

# game/scripts/c24/c24.rpy:3342
translate german c24s004_Kim_Mee_Meg_d05e16a5:

    # kim "Dame la bolsa. [mc] está ocupado en la piscina y el resto somos todas chicas. Voy a cambiarme en ese rincón."
    kim "Gib mir die Tasche. [mc] ist im Pool beschäftigt und wir anderen sind alle Mädchen. Ich werde mich dort in der Ecke umziehen."

# game/scripts/c24/c24.rpy:3344
translate german c24s004_Kim_Mee_Meg_0c47b986:

    # meg "¿Es eso cierto? ¿[mc] se desnudó durante el secuestro?"
    meg "Stimmt das? Hat sie sich während der Entführung entkleidet?"

# game/scripts/c24/c24.rpy:3346
translate german c24s004_Kim_Mee_Meg_9c24b532:

    # mee "*Risa* No, [mc] lo hizo después del secuestro. Me estaba comportando como una idiota y me puso en mi sitio."
    mee "*Lacht* Nein, [mc] hat es nach der Entführung getan. Ich habe mich wie ein Idiot benommen und er hat mich in meine Schranken gewiesen."

# game/scripts/c24/c24.rpy:3347
translate german c24s004_Kim_Mee_Meg_e869658b:

    # mee "*Risa* La que se desnudó durante el secuestro fui yo. O más bien, ya estaba desnuda pero dejé caer la toalla."
    mee "*lacht* Ich war diejenige, die sich während der Entführung ausziehen musste. Oder besser gesagt, ich war schon nackt, aber mir fiel das Handtuch herunter."

# game/scripts/c24/c24.rpy:3349
translate german c24s004_Kim_Mee_Meg_ce6e31d7:

    # kim "Tía [bet] me lo contó. Fuiste muy valiente y sirvió para que los secuestradores se despistaran y [eva] pudiera entrar."
    kim "Tante hat es mir erzählt. Du warst sehr mutig, und das hat geholfen, die Entführer abzuschütteln und mich hereinzulassen."

# game/scripts/c24/c24.rpy:3351
translate german c24s004_Kim_Mee_Meg_5881d1d8:

    # meg "¡Esperad! Había oído lo del secuestro, pero no me había enterado de nada de eso..."
    meg "Moment mal! Ich hatte zwar von der Entführung gehört, aber keine Einzelheiten darüber..."

# game/scripts/c24/c24.rpy:3352
translate german c24s004_Kim_Mee_Meg_0e4a078c:

    # meg "¡Me lo tenéis que explicar todo!"
    meg "Du musst mir alles erklären!"

# game/scripts/c24/c24.rpy:3354
translate german c24s004_Kim_Mee_Meg_435c2cc6:

    # "Mientras [mee] pone en antecedentes a [meg], [kim] se prueba el uniforme para el evento de la noche."
    "Während [mee] den Hintergrund für [meg] festlegt, probiert [kim] die Uniform für die Abendveranstaltung an."

# game/scripts/c24/c24.rpy:3357
translate german c24s004_Kim_Mee_Meg_04f6548a:

    # kim "¡Ha quedado genial, [mee]! ¡Muchas gracias!"
    kim "Es sieht toll aus, [mee]! Vielen Dank!"

# game/scripts/c24/c24.rpy:3359
translate german c24s004_Kim_Mee_Meg_43720c20:

    # meg "¡Estás monísima con ese uniforme!"
    meg "Du siehst in der Uniform entzückend aus!"

# game/scripts/c24/c24.rpy:3360
translate german c24s004_Kim_Mee_Meg_c1f18785:

    # mee "Es super gracioso. Pareces salida de una película de Corea o Vietnam, cuando las actrices y cantantes se vestían de militares para apoyar a las tropas."
    mee "Das ist ja witzig! Du siehst aus, als wärst du direkt aus einem Korea- oder Vietnamkriegsfilm entsprungen, aus einer Zeit, als Schauspielerinnen und Sängerinnen sich als Soldaten verkleideten, um die Truppen zu unterstützen."

# game/scripts/c24/c24.rpy:3362
translate german c24s004_Kim_Mee_Meg_fefc7116:

    # kim "La verdad es que es muy chulo. Tengo ganas de hacer este evento. El yate es increíble."
    kim "Das ist echt cool. Ich freue mich schon sehr auf das Event. Die Yacht ist unglaublich."

# game/scripts/c24/c24.rpy:3364
translate german c24s004_Kim_Mee_Meg_ca9e7bac:

    # kim "Ahora solo necesito llamar a un Under para que me lleve a Westport."
    kim "Jetzt muss ich nur noch auf „Unter“ tippen, um nach Westport zu kommen."

# game/scripts/c24/c24.rpy:3366
translate german c24s004_Kim_Mee_Meg_d27e5cac:

    # meg "¿Dónde de Westport tienes que ir y a qué hora tienes que estar?"
    meg "Wo genau in Westport müssen Sie hin und um welche Uhrzeit müssen Sie dort sein?"

# game/scripts/c24/c24.rpy:3367
translate german c24s004_Kim_Mee_Meg_ef69494f:

    # meg "Te podría llevar yo antes de ir al club."
    meg "Ich könnte dich mitnehmen, bevor wir in den Club gehen."

# game/scripts/c24/c24.rpy:3369
translate german c24s004_Kim_Mee_Meg_75c4ea81:

    # "Las tres mujeres pasan un rato hablando sobre el trabajo de [kim] y geografía de Westport."
    "Die drei Frauen unterhalten sich eine Weile über die Arbeit von [kim] und die Geographie von Westport."

# game/scripts/c24/c24.rpy:3370
translate german c24s004_Kim_Mee_Meg_04244bf3:

    # "También hablan de la familia y de los planes que tiene cada una de ellas."
    "Sie sprechen auch über die Familie und die Pläne, die jeder von ihnen hat."

# game/scripts/c24/c24.rpy:3371
translate german c24s004_Kim_Mee_Meg_2fd41570:

    # "[kim] llama 'Abuela' un par de veces a [mee]."
    "[kim] ruft [mee] 'Oma' ein paar Mal an."

# game/scripts/c24/c24.rpy:3373
translate german c24s004_Kim_Mee_Meg_5b8e52db:

    # "Ninguna de ellas se da cuenta."
    "Keiner von ihnen ahnt es."

# game/scripts/c24/c24.rpy:3381
translate german c24s005_Ama_ee6ec8ff:

    # "De vuelta en la furgoneta..."
    "Zurück im Lieferwagen..."

# game/scripts/c24/c24.rpy:3383
translate german c24s005_Ama_f22882bc:

    # ama "Disculpa, tenía que acabar de escribir algo que tienes que firmar."
    ama "Entschuldigen Sie, ich musste noch etwas fertig schreiben, das Sie unterschreiben müssen."

# game/scripts/c24/c24.rpy:3384
translate german c24s005_Ama_f5b226b8:

    # mc "¿Qué es?"
    mc "Was ist das?"

# game/scripts/c24/c24.rpy:3386
translate german c24s005_Ama_c65a50a2:

    # ama "Aquí no. Te lo explico en tu habitación."
    ama "Nicht hier. Ich erkläre es dir in deinem Zimmer."

# game/scripts/c24/c24.rpy:3387
translate german c24s005_Ama_aed47ba9:

    # mc "¡Qué misteriosa! Pero es muy pronto para que venga el helicóptero ¿no?"
    mc "Wie geheimnisvoll! Aber es ist noch zu früh für den Hubschrauber, nicht wahr?"

# game/scripts/c24/c24.rpy:3389
translate german c24s005_Ama_98187efb:

    # ama "No va a venir aquí. No quieres que Iron Fist sepa dónde vives, ¿verdad?"
    ama "Er kommt nicht hierher. Du willst doch nicht, dass Iron Fist weiß, wo du wohnst, oder?"

# game/scripts/c24/c24.rpy:3390
translate german c24s005_Ama_f29cba8a:

    # mc "Si tienen mi teléfono, supongo que también tienen mi dirección."
    mc "Wenn sie meine Telefonnummer haben, dann haben sie vermutlich auch meine Adresse."

# game/scripts/c24/c24.rpy:3392
translate german c24s005_Ama_13ff6026:

    # ama "En tu ficha de empleado de NTR figura tu teléfono, pero tu dirección es de San Luis Obispo."
    ama "In Ihrer NTR-Mitarbeiterakte ist Ihre Telefonnummer vermerkt, Ihre Adresse befindet sich jedoch in San Luis Obispo."

# game/scripts/c24/c24.rpy:3393
translate german c24s005_Ama_b4118369:

    # ama "*Risa* Vives en el campo de beisbol de la universidad. Por si teníamos algún topo."
    ama "*Lacht* Du wohnst auf dem Baseballfeld der Universität. Nur für den Fall, dass wir einen Maulwurf haben."

# game/scripts/c24/c24.rpy:3394
translate german c24s005_Ama_a01d843a:

    # mc "*Risa* Espero que sea debajo de las gradas o me mojaré cuando llueva."
    mc "*lacht* Hoffentlich ist es unter der Tribüne, sonst werde ich nass, wenn es regnet."

# game/scripts/c24/c24.rpy:3395
translate german c24s005_Ama_e8a1b105:

    # mc "¿Dónde va a ir a buscarnos el helicóptero, entonces?"
    mc "Wo genau wird uns der Hubschrauber abholen?"

# game/scripts/c24/c24.rpy:3397
translate german c24s005_Ama_3cb607a6:

    # ama "Hemos alquilado un campo de tiro todo el fin de semana. Mañana por la tarde [eva] enseñará a disparar a algunas chicas."
    ama "Wir haben für das ganze Wochenende einen Schießstand gemietet. Morgen Nachmittag wird [eva] einigen Mädchen das Schießen beibringen."

# game/scripts/c24/c24.rpy:3398
translate german c24s005_Ama_325b4e17:

    # ama "El helicóptero nos recogerá allí en cuatro horas."
    ama "Der Hubschrauber wird uns in vier Stunden dort abholen."

# game/scripts/c24/c24.rpy:3399
translate german c24s005_Ama_827d0a03:

    # mc "OK. Voy a ducharme."
    mc "Okay. Ich gehe duschen."

# game/scripts/c24/c24.rpy:3401
translate german c24s005_Ama_8f56740e:

    # ama "Voy a saludar a [mar] y te veo en 15 minutos en tu habitación."
    ama "Ich werde [mar] kurz begrüßen und wir sehen uns in 15 Minuten in deinem Zimmer."

# game/scripts/c24/c24.rpy:3402
translate german c24s005_Ama_525112d5:

    # mc "¿15 minutos? Acabo de decir que me tenía que duchar. ¡Tenemos cuatro horas!"
    mc "15 Minuten? Ich hab doch nur gesagt, ich muss duschen. Wir haben vier Stunden!"

# game/scripts/c24/c24.rpy:3403
translate german c24s005_Ama_7deaa528:

    # ama "*Risa* La última vez que te espié duchándote, no eras tan lento como [emm]. ¿Te tienes que maquillar y depilar las piernas?"
    ama "*Lacht* Als ich dich das letzte Mal beim Duschen beobachtet habe, warst du nicht so langsam wie [emm]. Musst du dich schminken und die Beine rasieren?"

# game/scripts/c24/c24.rpy:3404
translate german c24s005_Ama_d1f01a44:

    # mc "*Risa* Vale, 15 minutos ¿Qué llevas en esa bolsa?"
    mc "*Lacht* Okay, 15 Minuten. Was hast du in der Tasche?"

# game/scripts/c24/c24.rpy:3405
translate german c24s005_Ama_1ca49a82:

    # ama "Lo que vas a firmar y lo que te vas a poner."
    ama "Was Sie unterschreiben werden und was Sie tragen werden."

# game/scripts/c24/c24.rpy:3407
translate german c24s005_Ama_738d9a61:

    # "15 minutos después..."
    "15 Minuten später..."

# game/scripts/c24/c24.rpy:3408
translate german c24s005_Ama_2dcb8dae:

    # mc "Ya estoy aquí. ¿Qué querías que firmara? ¿Y por qué tanta prisa?"
    mc "Ich bin jetzt hier. Was sollte ich unterschreiben? Und warum die Eile?"

# game/scripts/c24/c24.rpy:3411
translate german c24s005_Ama_1eadca4e:

    # "[ama] se levanta y te da un tierno beso."
    "[ama] steht auf und gibt dir einen zärtlichen Kuss."

# game/scripts/c24/c24.rpy:3413
translate german c24s005_Ama_a4e24b27:

    # ama "Primero, mis labios..."
    ama "Zuerst meine Lippen..."

# game/scripts/c24/c24.rpy:3414
translate german c24s005_Ama_d9236e6a:

    # mc "Me parece la forma ideal de empezar una reunión de trabajo."
    mc "Ich denke, das ist der ideale Einstieg in eine Arbeitsbesprechung."

# game/scripts/c24/c24.rpy:3416
translate german c24s005_Ama_d0b258b1:

    # ama "*Risa* Espero que no hagas lo mismo con Ichigo esta noche."
    ama "*Lacht* Ich hoffe, du tust Ichigo heute Abend nicht dasselbe an."

# game/scripts/c24/c24.rpy:3417
translate german c24s005_Ama_8d80c347:

    # mc "No, eso solo lo hago con mercenarias rubias."
    mc "Nein, das mache ich nur mit blonden Söldnerinnen."

# game/scripts/c24/c24.rpy:3418
translate german c24s005_Ama_a7fbeadb:

    # ama "*Risa* Que no te oiga [eva]."
    ama "*Lacht* Lass ihn dich bloß nicht hören [eva]."

# game/scripts/c24/c24.rpy:3420
translate german c24s005_Ama_de43ceea:

    # "[ama] se gira para sacar algo de la bolsa de viaje que ha traído."
    "[ama] dreht sich um, um etwas aus ihrer mitgebrachten Reisetasche zu holen."

# game/scripts/c24/c24.rpy:3421
translate german c24s005_Ama_3fef17f8:

    # "Las vistas son excelentes."
    "Die Aussicht ist hervorragend."

# game/scripts/c24/c24.rpy:3423
translate german c24s005_Ama_9b4bf20c:

    # ama "Lo siguiente que tienes que firmar es esto. Hoy es tu primer día como CEO y el primer documento que vas a firmar."
    ama "Als Nächstes müssen Sie Folgendes unterschreiben. Heute ist Ihr erster Tag als CEO und das erste Dokument, das Sie unterzeichnen werden."

# game/scripts/c24/c24.rpy:3426
translate german c24s005_Ama_c3551559:

    # ama "Dame un segundo."
    ama "Einen Moment bitte."

# game/scripts/c24/c24.rpy:3427
translate german c24s005_Ama_85ade774:

    # "[ama] se agacha para sacar algo de la bolsa de viaje que ha traído."
    "[ama] bückt sich, um etwas aus ihrer mitgebrachten Reisetasche zu holen."

# game/scripts/c24/c24.rpy:3429
translate german c24s005_Ama_f3f3881d:

    # ama "Tienes que firmar es esto. Hoy es tu primer día como CEO y el primer documento que vas a firmar."
    ama "Sie müssen dies unterschreiben. Heute ist Ihr erster Tag als CEO und das erste Dokument, das Sie unterschreiben werden."

# game/scripts/c24/c24.rpy:3431
translate german c24s005_Ama_3bca18c7:

    # "[ama] te entrega un papel escrito a mano, con varios tachones."
    "[ama] überreicht Ihnen ein handgeschriebenes Blatt Papier, auf dem mehrere Wörter durchgestrichen sind."

# game/scripts/c24/c24.rpy:3441
translate german c24s005_Ama_15062ef8:

    # "Carta de autorización"
    "Autorisierungsschreiben"

# game/scripts/c24/c24.rpy:3442
translate german c24s005_Ama_92f35414:

    # "Como CEO de NTR, por la presente autorizo a la Srta. Gilford a realizar un estudio exhaustivo de las necesidades"
    "Als CEO von NTR ermächtige ich hiermit Frau Gilford zur Durchführung einer gründlichen Bedarfsanalyse."

# game/scripts/c24/c24.rpy:3443
translate german c24s005_Ama_55b4d0ec:

    # "y requisitos pertinentes para establecer la Beca NTR para el próximo año académico."
    "und die entsprechenden Voraussetzungen für die Einrichtung des NTR-Stipendiums für das nächste Studienjahr."

# game/scripts/c24/c24.rpy:3444
translate german c24s005_Ama_105a3ed5:

    # "Esta beca {s}del programa{/s} tiene como objetivo apoyar a los nadadores de Newport que han decidido abandonar la natación de competición"
    "Mit diesem Stipendium des Programms sollen Schwimmer aus Newport unterstützt werden, die sich entschieden haben, den Leistungssport aufzugeben."

# game/scripts/c24/c24.rpy:3445
translate german c24s005_Ama_7e68bbd5:

    # "y {s}desean{/s} aspiran a convertirse en entrenadores de natación."
    "und {s}wollen{/s} Schwimmtrainer werden wollen."

# game/scripts/c24/c24.rpy:3446
translate german c24s005_Ama_5e0df578:

    # "A la Srta. Gilford se le confían las siguientes responsabilidades:"
    "Miss Gilford sind folgende Aufgaben anvertraut:"

# game/scripts/c24/c24.rpy:3447
translate german c24s005_Ama_f6a40645:

    # "*Realizar una evaluación exhaustiva para determinar los criterios y requisitos específicos para {s}la{/s} esta nueva beca."
    "*Führen Sie eine gründliche Bewertung durch, um die spezifischen Kriterien und Anforderungen für dieses neue Stipendium zu ermitteln."

# game/scripts/c24/c24.rpy:3448
translate german c24s005_Ama_e1fac448:

    # "*Interactuar con posibles {s}estudiantes{/s} candidatos para comprender sus motivaciones, desafíos y aspiraciones en la transición de nadadores a entrenadores."
    "*Interagieren Sie mit potenziellen {s}Studenten{/s}Kandidaten, um deren Motivationen, Herausforderungen und Ziele beim Übergang vom Schwimmer zum Trainer zu verstehen."

# game/scripts/c24/c24.rpy:3449
translate german c24s005_Ama_6f084748:

    # "*Colaborar con clubes de natación locales, instituciones educativas y partes interesadas relevantes para desarrollar un marco de becas sólido."
    "*Zusammenarbeit mit lokalen Schwimmvereinen, Bildungseinrichtungen und relevanten Interessengruppen zur Entwicklung eines soliden Stipendienrahmens."

# game/scripts/c24/c24.rpy:3450
translate german c24s005_Ama_504d1964:

    # "*Asegurarse de que la beca proporcione el apoyo financiero, los recursos y las oportunidades de desarrollo profesional adecuados para los candidatos seleccionados."
    "*Sicherstellen, dass das Stipendium den ausgewählten Kandidaten angemessene finanzielle Unterstützung, Ressourcen und Möglichkeiten zur beruflichen Weiterentwicklung bietet."

# game/scripts/c24/c24.rpy:3451
translate german c24s005_Ama_f54b3c12:

    # "Se espera que la Srta. Gilford presente sus conclusiones y recomendaciones en los próximos tres días,"
    "Frau Gilford wird voraussichtlich innerhalb der nächsten drei Tage ihre Ergebnisse und Empfehlungen präsentieren."

# game/scripts/c24/c24.rpy:3452
translate german c24s005_Ama_bb1971f7:

    # "tras lo cual se desarrollará la estructura final y el plan de implementación de la Beca NTR."
    "Im Anschluss daran werden die endgültige Struktur und der Umsetzungsplan für das NTR-Stipendium entwickelt."

# game/scripts/c24/c24.rpy:3453
translate german c24s005_Ama_0419c24d:

    # "Esta autorización entra en vigor inmediatamente y permanecerá vigente hasta la finalización del proyecto."
    "Diese Genehmigung tritt sofort in Kraft und bleibt bis zum Abschluss des Projekts gültig."

# game/scripts/c24/c24.rpy:3454
translate german c24s005_Ama_29859d0b:

    # "Firmado:"
    "Unterzeichnet:"

# game/scripts/c24/c24.rpy:3455
translate german c24s005_Ama_31adcaef:

    # "[mc] Marks"
    "[mc] Punkte"

# game/scripts/c24/c24.rpy:3456
translate german c24s005_Ama_eae190af:

    # "CEO de NTR"
    "CEO von NTR"

# game/scripts/c24/c24.rpy:3460
translate german c24s005_Ama_220637b1:

    # mc "Esto es la creación de una beca hecha a medida para [sim]. 'Nadadores de Newport que han decidido abandonar la natación de competición y aspiran a convertirse en entrenadores'."
    mc "Hierbei handelt es sich um die Schaffung eines maßgeschneiderten Stipendiums für [sim]. 'Schwimmer aus Newport, die beschlossen haben, den Leistungssport aufzugeben und eine Trainerlaufbahn anzustreben'."

# game/scripts/c24/c24.rpy:3461
translate german c24s005_Ama_1856ed1b:

    # ama "He oído vuestra conversación en la piscina y he creído que, con todo el mal que ha hecho NTR, es hora de que haga algo bueno."
    ama "Ich habe euer Gespräch am Pool mitgehört und dachte mir, angesichts all des Schadens, den NTR angerichtet hat, wäre es an der Zeit, dass er etwas Gutes tut."

# game/scripts/c24/c24.rpy:3462
translate german c24s005_Ama_1fadd701:

    # mc "Pero puedes hacer esto sin mi autorización. Tú también eres accionista."
    mc "Aber das können Sie auch ohne meine Genehmigung tun. Sie sind ja schließlich auch Aktionär."

# game/scripts/c24/c24.rpy:3464
translate german c24s005_Ama_0434ed66:

    # ama "Todavía no tengo un cargo oficial en NTR, con lo que no puedo hacerlo. Tiene que ser todo legal si queremos que la empresa evolucione, [mc]."
    ama "Ich habe noch keine offizielle Position bei NTR, daher kann ich das nicht tun. Alles muss legal sein, wenn wir wollen, dass sich das Unternehmen weiterentwickelt."

# game/scripts/c24/c24.rpy:3465
translate german c24s005_Ama_2ae863ca:

    # ama "La estaba acabando de escribir en la furgoneta. De ahí los tachones."
    ama "Ich habe es gerade im Lieferwagen fertig geschrieben. Daher die durchgestrichenen Wörter."

# game/scripts/c24/c24.rpy:3466
translate german c24s005_Ama_42507974:

    # mc "*Risa* Le quitan un punto de oficialidad, pero supongo que es igual de legal."
    mc "*Lacht* Damit verlieren wir zwar einen Punkt an offiziellem Status, aber ich nehme an, es ist genauso legal."

# game/scripts/c24/c24.rpy:3467
translate german c24s005_Ama_ade9dc87:

    # mc "Y tú vuelves a demostrar que eres una mujer increíble."
    mc "Und du beweist einmal mehr, dass du eine unglaubliche Frau bist."

# game/scripts/c24/c24.rpy:3468
translate german c24s005_Ama_88b0999c:

    # "Firmas el documento."
    "Sie unterzeichnen das Dokument."

# game/scripts/c24/c24.rpy:3470
translate german c24s005_Ama_409b61d4:

    # ama "Gracias, pero no hay nada que no estuviera dispuesta a hacer por esta familia."
    ama "Vielen Dank, aber es gibt nichts, was ich nicht für diese Familie tun würde."

# game/scripts/c24/c24.rpy:3471
translate german c24s005_Ama_8f570b82:

    # ama "Haga lo que haga, nunca os podré devolver lo que me estáis dando vosotros."
    ama "Was auch immer ich tue, ich werde dir niemals das zurückzahlen können, was du mir gibst."

# game/scripts/c24/c24.rpy:3472
translate german c24s005_Ama_38dcce63:

    # mc "La familia no es un negocio, [ama]. No hay que pesar lo que se da o se recibe. Pero tú estás dando mucho."
    mc "Familie ist kein Geschäft. Man sollte nicht abwägen, was man gibt und was man empfängt. Aber du gibst sehr viel."

# game/scripts/c24/c24.rpy:3476
translate german c24s005_Ama_f3231476:

    # ama "Y lo siguiente es lo que te vas a poner esta tarde."
    ama "Und das hier ist, was du heute Nachmittag tragen wirst."

# game/scripts/c24/c24.rpy:3477
translate german c24s005_Ama_4a49ef0b:

    # mcp "(Como siempre, cambiando de tema en el momento en que alguien la alaba. Al menos esta vez sonríe.)"
    mcp "(Wie immer wechselt sie das Thema, sobald sie jemand lobt. Wenigstens lächelt sie diesmal.)"

# game/scripts/c24/c24.rpy:3478
translate german c24s005_Ama_c607143e:

    # mc "¿Mis trajes no son adecuados para la reunión con Iron Fist?"
    mc "Sind meine Anzüge für das Treffen mit Iron Fist ungeeignet?"

# game/scripts/c24/c24.rpy:3480
translate german c24s005_Ama_ce59d6cf:

    # ama "Sí, y ahora me darás uno. El que te pondrás esta noche."
    ama "Ja, und jetzt gibst du mir eins. Das, das du heute Abend tragen wirst."

# game/scripts/c24/c24.rpy:3481
translate german c24s005_Ama_eb603de7:

    # mc "No lo entiendo. ¿Me traes un traje para la tarde y yo te doy uno para la noche? ¿Me voy a cambiar en el yate?"
    mc "Ich verstehe das nicht. Sie bringen mir einen Anzug für den Nachmittag und ich gebe Ihnen einen für den Abend? Soll ich mich etwa auf der Yacht umziehen?"

# game/scripts/c24/c24.rpy:3483
translate german c24s005_Ama_92867519:

    # ama "¿No has hablado con [eva]?"
    ama "Hast du nicht mit [eva] gesprochen?"

# game/scripts/c24/c24.rpy:3484
translate german c24s005_Ama_9e545ae0:

    # mc "Hoy no. ¿Por qué?"
    mc "Nicht heute. Warum?"

# game/scripts/c24/c24.rpy:3485
translate german c24s005_Ama_1ac21101:

    # ama "Te tenía que haber llamado esta mañana."
    ama "Ich hätte dich heute Morgen anrufen sollen."

# game/scripts/c24/c24.rpy:3486
translate german c24s005_Ama_38fa9700:

    # mc "He dormido hasta tarde y me quedé sin batería anoche. Lo he puesto a cargar cuando me he levantado. Ni siquiera lo he encendido aún."
    mc "Ich habe lange geschlafen und der Akku war letzte Nacht leer. Als ich aufwachte, habe ich es zum Aufladen angeschlossen. Eingeschaltet habe ich es noch nicht einmal."

# game/scripts/c24/c24.rpy:3488
translate german c24s005_Ama_7478643a:

    # ama "Eso lo explica todo."
    ama "Das erklärt alles."

# game/scripts/c24/c24.rpy:3489
translate german c24s005_Ama_1b5b5f4b:

    # ama "Vas a hacer prácticas de tiro con [eva] antes de ir a la reunión. Dice que no has practicado más después del primer día en el bosque."
    ama "Du sollst vor dem Treffen noch ein paar Schießübungen mit dem W6 machen. Es heißt, du hättest seit dem ersten Tag im Wald nicht mehr geübt."

# game/scripts/c24/c24.rpy:3490
translate german c24s005_Ama_e2d41494:

    # mc "¿Por eso habéis alquilado el campo de tiro?"
    mc "Haben Sie deshalb den Schießstand gemietet?"

# game/scripts/c24/c24.rpy:3492
translate german c24s005_Ama_147bd032:

    # ama "Por eso, para enseñar a las chicas a disparar, y para que venga el helicóptero a buscarnos."
    ama "Deshalb bringen wir den Mädchen das Schießen bei, damit der Hubschrauber uns abholen kann."

# game/scripts/c24/c24.rpy:3495
translate german c24s005_Ama_8c75a391:

    # ama "[eva] quería pasar un rato a solas contigo. Ella no lo llama cita sino entrenamiento."
    ama "[eva] Ich wollte etwas Zeit allein mit dir verbringen. Sie nennt es nicht Date, sondern Training."

# game/scripts/c24/c24.rpy:3496
translate german c24s005_Ama_26751aa9:

    # ama "Pero no lo dudes. Es una cita. Con armas en vez de con comida o vino."
    ama "Aber lasst euch nicht täuschen. Es ist ein Date. Nur eben mit Waffen statt Essen oder Wein."

# game/scripts/c24/c24.rpy:3497
translate german c24s005_Ama_6c430bd0:

    # mc "¿No crees que me lo debería haber preguntado antes a mí?"
    mc "Findest du nicht, er hätte mich zuerst fragen sollen?"

# game/scripts/c24/c24.rpy:3499
translate german c24s005_Ama_e48042ab:

    # ama "*Risa* Si no te hubieras quedado sin batería o lo hubieras encendido..."
    ama "*lacht* Wenn nur dein Akku nicht leer gewesen wäre oder du es eingeschaltet hättest..."

# game/scripts/c24/c24.rpy:3500
translate german c24s005_Ama_3069ddbb:

    # mc "*Risa* Touché."
    mc "*Gelächter* Touché."

# game/scripts/c24/c24.rpy:3501
translate german c24s005_Ama_28d7ea60:

    # mc "¿Qué tengo que ponerme para la cita?"
    mc "Was soll ich zum Date anziehen?"

# game/scripts/c24/c24.rpy:3503
translate german c24s005_Ama_a580d8cf:

    # ama "Lo que hay en la bolsa. Te espero fuera mientras te cambias."
    ama "Was ist in der Tasche? Ich warte draußen auf dich, während du dich umziehst."

# game/scripts/c24/c24.rpy:3505
translate german c24s005_Ama_0ecf28f9:

    # mc "Sabes que no es necesario, ¿verdad?"
    mc "Du weißt doch, dass es nicht nötig ist, oder?"

# game/scripts/c24/c24.rpy:3507
translate german c24s005_Ama_509365cd:

    # ama "*Risa* Si te desnudas delante mío, es posible que no llegues a la cita con [eva]."
    ama "*Lacht* Wenn du dich vor mir ausziehst, könnte es sein, dass du dein Date mit [eva] verpasst."

# game/scripts/c24/c24.rpy:3508
translate german c24s005_Ama_208599b9:

    # ama "*Risa* Y seguramente me lo haría pagar. De forma dolorosa. Mientras duermo."
    ama "*Lacht* Und wahrscheinlich wird er es mich dafür büßen lassen. Auf schmerzhafte Weise. Während ich schlafe."

# game/scripts/c24/c24.rpy:3510
translate german c24s005_Ama_e79e417a:

    # mc "OK. En dos minutos estaré vestido."
    mc "Okay. Ich bin in zwei Minuten angezogen."

# game/scripts/c24/c24.rpy:3514
translate german c24s005_Ama_1bdbea1e:

    # ama "Ponte lo que hay en la bolsa. Te espero fuera mientras te cambias."
    ama "Zieh an, was in der Tasche ist. Ich warte draußen, während du dich umziehst."

# game/scripts/c24/c24.rpy:3516
translate german c24s005_Ama_0ecf28f9_1:

    # mc "Sabes que no es necesario, ¿verdad?"
    mc "Du weißt doch, dass es nicht nötig ist, oder?"

# game/scripts/c24/c24.rpy:3518
translate german c24s005_Ama_047ab889:

    # ama "*Risa* Si te desnudas delante mío, es posible que no llegues a la clase de tiro con [eva]."
    ama "*Lacht* Wenn du dich vor mir ausziehst, schaffst du es vielleicht nicht zum Schießunterricht mit [eva]."

# game/scripts/c24/c24.rpy:3519
translate german c24s005_Ama_208599b9_1:

    # ama "*Risa* Y seguramente me lo haría pagar. De forma dolorosa. Mientras duermo."
    ama "*Lacht* Und wahrscheinlich wird er es mich dafür büßen lassen. Auf schmerzhafte Weise. Während ich schlafe."

# game/scripts/c24/c24.rpy:3521
translate german c24s005_Ama_e79e417a_1:

    # mc "OK. En dos minutos estaré vestido."
    mc "Okay. Ich bin in zwei Minuten angezogen."

# game/scripts/c24/c24.rpy:3523
translate german c24s005_Ama_dda3e113:

    # ama "Saca el traje que te vas a poner para el yate."
    ama "Hol den Anzug heraus, den du auf der Yacht tragen wirst."

# game/scripts/c24/c24.rpy:3525
translate german c24s005_Ama_0d0a47eb:

    # "Dos minutos después..."
    "Zwei Minuten später..."

# game/scripts/c24/c24.rpy:3526
translate german c24s005_Ama_1a08177b:

    # mc "[ama], ya estoy vestido. Aunque no entiendo para qué necesito esto..."
    mc "[ama], Ich bin schon angezogen. Obwohl ich nicht verstehe, warum ich das brauche..."

# game/scripts/c24/c24.rpy:3528
translate german c24s005_Ama_cac620c4:

    # ama "*Risa* ¡Estás ridículo!"
    ama "*lacht* Du siehst lächerlich aus!"

# game/scripts/c24/c24.rpy:3529
translate german c24s005_Ama_b2246951:

    # mc "*Risa* Lo sé. Más que a practicar tiro, parece que voy a hacer una carrera en Laguna Seca."
    mc "*Lacht* Ich weiß. Es sieht eher so aus, als würde ich zu einem Rennen in Laguna Seca fahren, als zum Schießtraining."

# game/scripts/c24/c24.rpy:3532
translate german c24s005_Ama_027cb8e1:

    # ama "*Risa* Bueno, esa es la otra parte de la cita con [eva]."
    ama "*Lacht* Tja, das ist der andere Teil des Dates mit [eva]."

# game/scripts/c24/c24.rpy:3533
translate german c24s005_Ama_736e1139:

    # ama "¿Has montado en moto alguna vez?"
    ama "Sind Sie schon einmal Motorrad gefahren?"

# game/scripts/c24/c24.rpy:3534
translate german c24s005_Ama_cc761816:

    # mc "No..."
    mc "NEIN..."

# game/scripts/c24/c24.rpy:3536
translate german c24s005_Ama_30e93606:

    # ama "Pues hoy va a ser tu primera vez. [eva] quería que fueras seguro. El traje lo ha elegido ella."
    ama "Nun, heute ist es dein erstes Mal. [eva] Ich wollte sichergehen, dass du dir sicher bist. Sie hat den Anzug ausgesucht."

# game/scripts/c24/c24.rpy:3537
translate german c24s005_Ama_0d907c5a:

    # ama "Es uno de los trajes de skydiving de NTR. Era lo más adecuado que teníamos para ti."
    ama "Das ist einer von NTRs Fallschirmspringeranzügen. Es war der beste, den wir für dich hatten."

# game/scripts/c24/c24.rpy:3538
translate german c24s005_Ama_4058bc50:

    # mc "¿No vamos a ir en la furgoneta al campo de tiro?"
    mc "Fahren wir nicht mit dem Van zum Schießstand?"

# game/scripts/c24/c24.rpy:3540
translate german c24s005_Ama_6c2bceab:

    # ama "No, te lleva [eva]. Yo me quedaré con [mar] y [nor], pasando la tarde hasta que se acerque la hora de que llegue el helicóptero."
    ama "Nein, es braucht [eva]. Ich bleibe bei [mar] und [nor] und vertreibe mir den Nachmittag, bis der Hubschrauber eintrifft."

# game/scripts/c24/c24.rpy:3541
translate german c24s005_Ama_5eda9e51:

    # mc "*Risa* Es decir, motos y armas. ¿Alguna cosa peligrosa más?"
    mc "*lacht* Ich meine, Motorräder und Schusswaffen. Gibt es sonst noch etwas Gefährliches?"

# game/scripts/c24/c24.rpy:3543
translate german c24s005_Ama_e6a8262e:

    # ama "*Risa* [eva]."
    ama "*Gelächter* [eva]."

# game/scripts/c24/c24.rpy:3544
translate german c24s005_Ama_a1e0e3b7:

    # mc "*Risa* No me da miedo. Seguramente porque no soy capaz de imaginar la mitad de las cosas que puede hacerme."
    mc "*Lacht* Ich habe keine Angst. Wahrscheinlich, weil ich mir nicht einmal die Hälfte der Dinge vorstellen kann, die er mir antun könnte."

# game/scripts/c24/c24.rpy:3545
translate german c24s005_Ama_4bcaaf83:

    # mc "Bueno, las armas tampoco después del primer entrenamiento. Y las motos..."
    mc "Nun ja, die Waffen taugen auch nach der ersten Trainingseinheit nichts. Und die Motorräder..."

# game/scripts/c24/c24.rpy:3548
translate german c24s005_Ama_e7521246:

    # "Suena una moto a toda velocidad por la carretera, todavía lejos."
    "Das Geräusch eines Motorrads, das in weiter Ferne die Straße entlangrast, ist zu hören."

# game/scripts/c24/c24.rpy:3549
translate german c24s005_Ama_c629957a:

    # ama "Creo que la tuya está llegando."
    ama "Ich glaube, deine kommt auch bald."

# game/scripts/c24/c24.rpy:3550
translate german c24s005_Ama_83b2b023:

    # mc "Te veo luego, entonces."
    mc "Dann bis später."

# game/scripts/c24/c24.rpy:3551
translate german c24s005_Ama_162ef4fb:

    # ama "Sí, cuando falten 20 minutos para que llegue el helicóptero, iré al campo de tiro. Así tienes tiempo de cambiarte."
    ama "Ja, wenn noch 20 Minuten bis zur Ankunft des Hubschraubers sind, gehe ich zum Schießstand. So hast du noch Zeit, dich umzuziehen."

# game/scripts/c24/c24.rpy:3554
translate german c24s005_Ama_18f5f726:

    # "[ama] se despide de ti con otro tierno beso."
    "[ama] verabschiedet sich mit einem weiteren zärtlichen Kuss von dir."

# game/scripts/c24/c24.rpy:3555
translate german c24s005_Ama_689458b3:

    # ama "Te veo luego."
    ama "Bis später."

# game/scripts/c24/c24.rpy:3558
translate german c24s005_Ama_5b63b58c:

    # "Mientras bajas las escaleras, enciendes el móvil. Tienes 32 llamadas perdidas de [eva]. Y 24 mensajes de texto."
    "Als du die Treppe hinuntergehst, schaltest du dein Handy ein. Du hast 32 verpasste Anrufe von [eva] und 24 SMS."

# game/scripts/c24/c24.rpy:3565
translate german c24s005_Eva_5f0fa22f:

    # "Al salir a la calle, [eva] ya te está esperando."
    "Wenn du nach draußen gehst, wartet [eva] bereits auf dich."

# game/scripts/c24/c24.rpy:3566
translate german c24s005_Eva_3b8ddfb4:

    # mc "Hola, [eva]."
    mc "Hallo, [eva]."

# game/scripts/c24/c24.rpy:3569
translate german c24s005_Eva_6f818418:

    # "[eva] salta a tus brazos buscando tus labios. Hace días que no os habéis besado."
    "[eva] springt dir in die Arme und sucht deine Lippen. Es ist schon Tage her, seit ihr euch das letzte Mal geküsst habt."

# game/scripts/c24/c24.rpy:3571
translate german c24s005_Eva_6c435b77:

    # eva "Hola, [mc]. ¿Preparado para el entrenamiento?"
    eva "Hallo, [mc]. Bereit für das Training?"

# game/scripts/c24/c24.rpy:3572
translate german c24s005_Eva_e69ff49e:

    # mc "*Risa* Para el entrenamiento sí. Para la moto no tanto."
    mc "*Lacht* Zum Training, ja. Zum Radfahren eher nicht."

# game/scripts/c24/c24.rpy:3575
translate german c24s005_Eva_0d100dc8:

    # "[eva] te pega un puñetazo en el hombro. No es un puñetazo suave. Los matones del colegio te pegaban más flojo."
    "[eva] schlägt dir auf die Schulter. Es ist kein sanfter Schlag. Die Schläger in der Schule schlagen dich viel sanfter."

# game/scripts/c24/c24.rpy:3576
translate german c24s005_Eva_eb7708ca:

    # mc "¡Ouch! ¿A qué ha venido eso?"
    mc "Autsch! Was war denn das denn?"

# game/scripts/c24/c24.rpy:3577
translate german c24s005_Eva_81215681:

    # eva "A que así aprenderás a responder a mis llamadas."
    eva "So lernst du, meine Anrufe anzunehmen."

# game/scripts/c24/c24.rpy:3578
translate german c24s005_Eva_6b7cc6ac:

    # mc "¡Me quedé sin batería y no me he acordado de encenderlo hasta hace un momento!"
    mc "Mein Akku war leer und ich habe erst vor einem Moment daran gedacht, ihn wieder einzuschalten!"

# game/scripts/c24/c24.rpy:3580
translate german c24s005_Eva_4f44b872:

    # eva "Seguro que no se te vuelve a olvidar."
    eva "Ich bin sicher, du wirst es nicht wieder vergessen."

# game/scripts/c24/c24.rpy:3582
translate german c24s005_Eva_37099f52:

    # eva "¿Has montado alguna vez en moto?"
    eva "Sind Sie schon einmal Motorrad gefahren?"

# game/scripts/c24/c24.rpy:3583
translate german c24s005_Eva_ce0ec26c:

    # mc "No... ¿Hay algo que deba saber?"
    mc "Nein... Gibt es irgendetwas, das ich wissen sollte?"

# game/scripts/c24/c24.rpy:3584
translate german c24s005_Eva_cb9f023f:

    # eva "Tan solo agárrate fuerte a mí e intenta no moverte demasiado. Actúa como si fueras mi mochila."
    eva "Halt dich einfach gut an mir fest und versuch, dich nicht zu viel zu bewegen. Stell dir vor, du wärst mein Rucksack."

# game/scripts/c24/c24.rpy:3586
translate german c24s005_Eva_45865617:

    # eva "*Risa* Y no grites ni llores en las curvas."
    eva "*Gelächter* Und schreit oder weint nicht in den Kurven."

# game/scripts/c24/c24.rpy:3587
translate german c24s005_Eva_6a83a2b3:

    # mc "*Risa* Lo intentaré, pero no prometo nada."
    mc "*Lacht* Ich werde es versuchen, aber ich verspreche nichts."

# game/scripts/c24/c24.rpy:3588
translate german c24s005_Eva_0619b416:

    # mc "*Risa* ¿En las rectas puedo llorar?"
    mc "*lacht* Darf ich auf der Geraden weinen?"

# game/scripts/c24/c24.rpy:3590
translate german c24s005_Eva_c5e1570a:

    # eva "*Risa* Puedes hacerlo, pero no te voy a oír ni voy a parar."
    eva "*Lacht* Du kannst es tun, aber ich werde dir nicht zuhören und ich werde dich nicht aufhalten."

# game/scripts/c24/c24.rpy:3593
translate german c24s005_Eva_8e46c040:

    # eva "¡Sube en la moto!"
    eva "Steig aufs Motorrad!"

# game/scripts/c24/c24.rpy:3600
translate german c24s005_Eva_2ad01fba:

    # "[eva] arranca para llevarte a la cita más extraña de tu vida."
    "[eva] beginnt, dich zum seltsamsten Date deines Lebens zu führen."

# game/scripts/c24/c24.rpy:3602
translate german c24s005_Eva_08fe7d89:

    # "[eva] arranca para llevarte al entrenamiento más extraño de tu vida."
    "[eva] beginnt, dich zum seltsamsten Workout deines Lebens zu führen."

# game/scripts/c24/c24.rpy:3603
translate german c24s005_Eva_257de6ea:

    # "Consigues no gritar en la primera curva pese al frenazo de [eva]. Te comportas como una buena mochila."
    "Du schaffst es, in der ersten Kurve trotz der starken Bremsung in [eva] nicht aufzuschreien. Du verhältst dich wie ein braver Rucksack."

