# game/scripts/c24/c24.rpy:1123
translate german c24s002_BetNoNun_3d0c881d:

    # mc "No sé cómo funciona esto, pero si la despiden, la expulsan, o como se llame, ¿recibirá algún tipo de indemnización?"
    mc "Ich weiß nicht, wie das genau funktioniert, aber wenn sie gefeuert, entlassen oder wie auch immer das heißt, erhält sie dann irgendeine Entschädigung?"

# game/scripts/c24/c24.rpy:1125
translate german c24s002_BetNoNun_c31dfe3d:

    # "Segismund" "No, por supuesto. La expulsión se debe a desobedecer órdenes del obispo."
    "Segismund" "Nein, natürlich nicht. Der Ausschluss erfolgte aufgrund von Ungehorsam gegenüber den Anweisungen des Bischofs."

# game/scripts/c24/c24.rpy:1126
translate german c24s002_BetNoNun_dda5882e:

    # mc "Órdenes que, para cualquier persona que no pertenezca a la Iglesia, serían como una condena de cárcel o el exilio, ¿no?"
    mc "Anordnungen, die für jeden, der nicht der Kirche angehört, einer Gefängnisstrafe oder Verbannung gleichkämen, nicht wahr?"

# game/scripts/c24/c24.rpy:1128
translate german c24s002_BetNoNun_7ced21c0:

    # "Segismund" "No, Señor..."
    "Segismund" "Nein, Sir..."

# game/scripts/c24/c24.rpy:1129
translate german c24s002_BetNoNun_6a48c801:

    # mc "Marks. Soy el sobrino nieto de [bet]."
    mc "Marks. Ich bin der Großneffe von [bet]."

# game/scripts/c24/c24.rpy:1130
translate german c24s002_BetNoNun_45506cc0:

    # "Segismund" "Como decía, está usted equivocado. Le estamos dando a su tía una oportunidad de seguir sirviendo a la iglesia y la está rechazando."
    "Segismund" "Wie gesagt, Sie irren sich. Wir bieten Ihrer Tante die Möglichkeit, weiterhin in der Kirche mitzuwirken, und sie lehnt sie ab."

# game/scripts/c24/c24.rpy:1131
translate german c24s002_BetNoNun_2fd99f3b:

    # "Segismund" "Todo es legal. La Iglesia siempre actúa de buena fe."
    "Segismund" "Alles ist legal. Die Kirche handelt stets in gutem Glauben."

# game/scripts/c24/c24.rpy:1132
translate german c24s002_BetNoNun_071bbae8:

    # mc "Entonces, no le importaría si yo fuera a la prensa y explicara la situación, ¿verdad?"
    mc "Sie hätten also nichts dagegen, wenn ich mich an die Presse wenden und die Situation erklären würde, richtig?"

# game/scripts/c24/c24.rpy:1133
translate german c24s002_BetNoNun_6ae2b90c:

    # mc "Si todo es legal y hecho de buena fe, no debería haber ningún problema."
    mc "Wenn alles legal und in gutem Glauben abläuft, sollte es keine Probleme geben."

# game/scripts/c24/c24.rpy:1134
translate german c24s002_BetNoNun_872ad6ca:

    # mc "Tampoco en explicar lo que pasó en Tanzania, que es lo que nos ha traído a esta situación."
    mc "Auch nicht bei der Erklärung dessen, was in Tansania geschehen ist und was uns in diese Situation gebracht hat."

# game/scripts/c24/c24.rpy:1136
translate german c24s002_BetNoNun_602e9eff:

    # "Segismund" "¡No puede hacer eso! Ayer acordamos con su tía que si hablaba con la prensa retiraríamos la oferta."
    "Segismund" "Das kann er nicht tun! Gestern haben wir mit seiner Tante vereinbart, dass wir das Angebot zurückziehen, falls er mit der Presse spricht."

# game/scripts/c24/c24.rpy:1137
translate german c24s002_BetNoNun_84d26f25:

    # mc "Y la expulsarían, ¿no?"
    mc "Und sie würden sie rausschmeißen, nicht wahr?"

# game/scripts/c24/c24.rpy:1138
translate german c24s002_BetNoNun_963f1ff6:

    # mc "Si no acepta los conventos también la expulsarán, con lo que nada evita que vayamos a la prensa."
    mc "Wenn sie sich weigert, ins Kloster einzutreten, wird sie dort rausgeworfen, also steht uns nichts im Wege, an die Presse zu gehen."

# game/scripts/c24/c24.rpy:1140
translate german c24s002_BetNoNun_7b4c3d17:

    # bet "[mc], déjalo. La decisión ya estaba tomada."
    bet "[mc], lass es. Die Entscheidung war bereits gefallen."

# game/scripts/c24/c24.rpy:1141
translate german c24s002_BetNoNun_cd05795e:

    # mc "Déjame un momento, por favor."
    mc "Einen Moment bitte."

# game/scripts/c24/c24.rpy:1143
translate german c24s002_BetNoNun_0733a41f:

    # mc "Entonces, una pequeña indemnización por los años de servicio sería lo idóneo y lo justo, ¿no?"
    mc "Eine kleine Entschädigung für langjährige Dienstzeit wäre also ideal und fair, nicht wahr?"

# game/scripts/c24/c24.rpy:1144
translate german c24s002_BetNoNun_38e5141f:

    # "Segismund" "Eso no se ha hecho nunca. Sentaría un precedente."
    "Segismund" "Das hat es noch nie gegeben. Das würde einen Präzedenzfall schaffen."

# game/scripts/c24/c24.rpy:1145
translate german c24s002_BetNoNun_beaa8c9e:

    # mc "Mire, no le estoy diciendo que compre nuestro silencio. Eso sería chantaje. Solo le estoy pidiendo lo que es justo para mi tía."
    mc "Hören Sie, ich verlange nicht, dass Sie uns zum Schweigen bringen. Das wäre Erpressung. Ich bitte Sie lediglich um eine faire Lösung für meine Tante."

# game/scripts/c24/c24.rpy:1146
translate german c24s002_BetNoNun_8be17c10:

    # mc "Ustedes la expulsan y ella tiene que empezar una vida nueva después de 40 años de servicio sin tener un dólar ahorrado."
    mc "Man wirft sie raus, und sie muss nach 40 Dienstjahren ein neues Leben beginnen, ohne einen einzigen Dollar gespart zu haben."

# game/scripts/c24/c24.rpy:1147
translate german c24s002_BetNoNun_271ef249:

    # mc "No es justo, ¿no?"
    mc "Das ist nicht fair, oder?"

# game/scripts/c24/c24.rpy:1149
translate german c24s002_BetNoNun_ca634ae9:

    # "Segismund" "No... pero... es legal."
    "Segismund" "Nein... aber... es ist legal."

# game/scripts/c24/c24.rpy:1150
translate german c24s002_BetNoNun_1abd3170:

    # mc "También es legal ir a la prensa a explicar la situación."
    mc "Es ist auch legal, sich an die Presse zu wenden, um die Situation zu erklären."

# game/scripts/c24/c24.rpy:1151
translate german c24s002_BetNoNun_eb986132:

    # mc "Podrán comprobar como descienden las donaciones cuando se descubra cómo trata esta diócesis a personas que han trabajado 40 años para la Iglesia."
    mc "Sie werden sehen, wie die Spenden zurückgehen, wenn bekannt wird, wie diese Diözese mit Menschen umgeht, die 40 Jahre lang für die Kirche gearbeitet haben."

# game/scripts/c24/c24.rpy:1153
translate german c24s002_BetNoNun_435cc83a:

    # bet "¿Qué haces, [mc]?"
    bet "Was machst du da, [mc]?"

# game/scripts/c24/c24.rpy:1154
translate german c24s002_BetNoNun_66fdf6fa:

    # mc "Tratar a la Iglesia como te ha intentado tratar a ti."
    mc "Behandle die Kirche so, wie sie versucht hat, dich zu behandeln."

# game/scripts/c24/c24.rpy:1155
translate german c24s002_BetNoNun_5210031e:

    # mc "Si ellos pueden usar sus armas, nosotros podemos usar las nuestras."
    mc "Wenn sie ihre Waffen einsetzen können, können wir unsere auch einsetzen."

# game/scripts/c24/c24.rpy:1156
translate german c24s002_BetNoNun_e157e17d:

    # mc "Supongo que no habían pensado que pudieras tener un sobrino abogado laboralista."
    mc "Ich schätze, sie hatten nicht damit gerechnet, dass du einen Neffen haben könntest, der Arbeitsrechtler ist."

# game/scripts/c24/c24.rpy:1158
translate german c24s002_BetNoNun_3b973a9c:

    # "Segismund" "¿Abogado laboralista? Entonces, ¿qué propone?"
    "Segismund" "Ein Arbeitsrechtler? Was schlägt er denn vor?"

# game/scripts/c24/c24.rpy:1159
translate german c24s002_BetNoNun_0a5736cf:

    # mc "Una pequeña indemnización por cada año trabajado."
    mc "Eine kleine Entschädigung für jedes geleistete Arbeitsjahr."

# game/scripts/c24/c24.rpy:1160
translate german c24s002_BetNoNun_3cf6aad0:

    # mc "No le estoy pidiendo que lo haga teniendo en cuenta el sueldo de un cirujano con los años de experiencia de mi tía."
    mc "Ich verlange von ihr nicht, dass sie dies unter Berücksichtigung des Gehalts eines Chirurgen mit der jahrelangen Erfahrung meiner Tante tut."

# game/scripts/c24/c24.rpy:1161
translate german c24s002_BetNoNun_97335d6b:

    # mc "Puede usar su sueldo actual como referencia. Nos conformamos con 30 días de indemnización por año trabajado."
    mc "Sie können Ihr aktuelles Gehalt als Referenz angeben. Wir sind mit einer Abfindung von 30 Tagen pro Dienstjahr einverstanden."

# game/scripts/c24/c24.rpy:1162
translate german c24s002_BetNoNun_6f19be5d:

    # mc "No sé si, en alguno de los países en los que ha trabajado, la indemnización puede llegar a los 40 días por año trabajado. Lo tendría que mirar."
    mc "Ich weiß nicht, ob in einem der Länder, in denen er gearbeitet hat, die Abfindung bis zu 40 Tage pro Beschäftigungsjahr betragen kann. Das müsste ich nachprüfen."

# game/scripts/c24/c24.rpy:1164
translate german c24s002_BetNoNun_56cc5e5f:

    # "Segismund" "¡Eso sería mucho dinero! La Iglesia..."
    "Segismund" "Das wäre eine Menge Geld! Die Kirche..."

# game/scripts/c24/c24.rpy:1165
translate german c24s002_BetNoNun_344c5410:

    # mc "La Iglesia va a perder mucho más en donaciones si esto sale en la prensa."
    mc "Die Kirche wird noch viel mehr Spenden verlieren, wenn das an die Öffentlichkeit gelangt."

# game/scripts/c24/c24.rpy:1166
translate german c24s002_BetNoNun_b220ae06:

    # mc "Son poco más de tres años de sueldo de una monja. Lo acabo de calcular."
    mc "Das entspricht etwas mehr als drei Jahresgehältern einer Nonne. Ich habe es gerade ausgerechnet."

# game/scripts/c24/c24.rpy:1168
translate german c24s002_BetNoNun_d5a797ff:

    # "Segismund" "No puedo autorizar eso. No tengo poder para ello."
    "Segismund" "Das kann ich nicht genehmigen. Ich habe dazu keine Befugnis."

# game/scripts/c24/c24.rpy:1169
translate german c24s002_BetNoNun_7e4db1e6:

    # "Segismund" "¿Podrían volver en un mes y les hacemos una propuesta?"
    "Segismund" "Könnten Sie in einem Monat wiederkommen, dann unterbreiten wir Ihnen ein Angebot?"

# game/scripts/c24/c24.rpy:1170
translate german c24s002_BetNoNun_fca52711:

    # mc "No."
    mc "NEIN."

# game/scripts/c24/c24.rpy:1172
translate german c24s002_BetNoNun_d31c8329:

    # bet "¿No?"
    bet "NEIN?"

# game/scripts/c24/c24.rpy:1173
translate german c24s002_BetNoNun_51d522b1:

    # mc "No, Tía [bet]. En un mes estaré fuera del país, y no quiero que te intenten estafar."
    mc "Nein, Tante [bet]. Ich bin in einem Monat im Ausland und möchte nicht, dass du betrogen wirst."

# game/scripts/c24/c24.rpy:1175
translate german c24s002_BetNoNun_29eb690c:

    # mc "Dice que no tiene poder para tomar esa decisión. Consúltelo con quién lo tenga que consultar y volveremos en tres horas."
    mc "Er sagt, er sei nicht befugt, diese Entscheidung zu treffen. Sprechen Sie mit den zuständigen Stellen, und wir melden uns in drei Stunden wieder."

# game/scripts/c24/c24.rpy:1176
translate german c24s002_BetNoNun_cd0aa0e1:

    # "Segismund" "¿Tres horas? No sé si tendré tiempo de..."
    "Segismund" "Drei Stunden? Ich weiß nicht, ob ich dafür Zeit habe..."

# game/scripts/c24/c24.rpy:1177
translate german c24s002_BetNoNun_a3d0111e:

    # mc "Si en tres horas no tiene una propuesta, en tres días aparecerá en prensa nuestra versión de los hechos."
    mc "Wenn Sie innerhalb von drei Stunden keinen Vorschlag unterbreiten, wird unsere Version der Ereignisse in drei Tagen in der Presse erscheinen."

# game/scripts/c24/c24.rpy:1178
translate german c24s002_BetNoNun_6fc27c56:

    # mc "Para que no puedan adelantarse y mentir, publicaré ahora mismo un twirp indicando el inicio de la historia."
    mc "Damit sie nicht voreilig lügen, werde ich jetzt gleich einen Twirl posten, der den Beginn der Geschichte anzeigt."

# game/scripts/c24/c24.rpy:1179
translate german c24s002_BetNoNun_5eb435dd:

    # mc "Deme un segundo."
    mc "Einen Moment bitte."

# game/scripts/c24/c24.rpy:1181
translate german c24s002_BetNoNun_60f8d2ab:

    # "Después de publicar el twirp..."
    "Nachdem ich den Trottel gepostet hatte..."

# game/scripts/c24/c24.rpy:1182
translate german c24s002_BetNoNun_ec06f76b:

    # mc "Ya está hecho. La historia de una monja maltratada y chantajeada por la iglesia. En tres días sabrán toda la verdad."
    mc "Es ist vollbracht. Die Geschichte einer Nonne, die von der Kirche misshandelt und erpresst wurde. In drei Tagen wird die ganze Wahrheit ans Licht kommen."

# game/scripts/c24/c24.rpy:1183
translate german c24s002_BetNoNun_0dee7c33:

    # mc "Nos vemos en tres horas. Tic-tac."
    mc "Wir sehen uns in drei Stunden. Tick-tack."

# game/scripts/c24/c24.rpy:1185
translate german c24s002_BetNoNun_ae9f9ed3:

    # mc "¿Nos vamos, Tía [bet]?"
    mc "Sollen wir gehen, Tante [bet]?"

# game/scripts/c24/c24.rpy:1186
translate german c24s002_BetNoNun_24af5e07:

    # bet "Sí, vámonos. Creo que el Padre Segismund tiene unas llamadas que hacer."
    bet "Ja, los geht's. Ich glaube, Pater Segismund muss einige Anrufe tätigen."

# game/scripts/c24/c24.rpy:1189
translate german c24s002_BetNoNun_825c2221:

    # "Al salir del edificio de la Iglesia..."
    "Beim Verlassen des Kirchengebäudes..."

# game/scripts/c24/c24.rpy:1191
translate german c24s002_BetNoNun_eccb5103:

    # bet "¿Qué has hecho? Ya habíamos hablado de que venía a informarles de que dejaba de ser monja."
    bet "Was hast du getan? Wir hatten doch schon besprochen, dass ich kommen würde, um dir mitzuteilen, dass ich das Kloster verlasse."

# game/scripts/c24/c24.rpy:1192
translate german c24s002_BetNoNun_5530c9aa:

    # mc "Vas a dejar de ser monja igualmente, no te van a permitir seguir en la Iglesia y moverte libremente. Pero te irás con los bolsillos llenos."
    mc "Du wirst zwar keine Nonne mehr sein; man wird dir nicht erlauben, in der Kirche zu bleiben und dich frei zu bewegen. Aber du wirst mit vollen Taschen gehen."

# game/scripts/c24/c24.rpy:1193
translate german c24s002_BetNoNun_5c16c34c:

    # mc "Podrás pagar la certificación y ayudar a Meemaw con su nueva casa, tal como queréis las dos."
    mc "Sie können die Zertifizierung bezahlen und Meemaw bei ihrem neuen Zuhause helfen, ganz wie Sie beide es wünschen."

# game/scripts/c24/c24.rpy:1195
translate german c24s002_BetNoNun_f72c981a:

    # bet "*Risa* Tienes razón. No se me hubiera ocurrido nunca."
    bet "*Lacht* Stimmt. Darauf wäre ich nie gekommen."

# game/scripts/c24/c24.rpy:1196
translate german c24s002_BetNoNun_7a807ac2:

    # mc "*Risa* Para eso me tienes a mí."
    mc "*Lacht* Genau dafür bin ich ja hier."

# game/scripts/c24/c24.rpy:1198
translate german c24s002_BetNoNun_89b009df:

    # bet "Por cierto, creía que no mentías nunca."
    bet "Übrigens dachte ich, du würdest nie lügen."

# game/scripts/c24/c24.rpy:1199
translate german c24s002_BetNoNun_4190fe76:

    # mc "Y no he mentido."
    mc "Und ich habe nicht gelogen."

# game/scripts/c24/c24.rpy:1200
translate german c24s002_BetNoNun_277eb0a0:

    # bet "¿Abogado laboralista? ¿Desde cuándo eres abogado?"
    bet "Arbeitsrechtler? Wie lange sind Sie schon Anwalt?"

# game/scripts/c24/c24.rpy:1201
translate german c24s002_BetNoNun_1502332f:

    # mc "Yo no he dicho que lo fuera. He dicho que ellos no podían imaginar que tuvieras un sobrino que lo fuera."
    mc "Ich habe nicht gesagt, dass er es wäre. Ich sagte, sie könnten sich nicht vorstellen, dass du einen Neffen hättest, der es wäre."

# game/scripts/c24/c24.rpy:1202
translate german c24s002_BetNoNun_5c2166f5:

    # mc "Yo tampoco. *Risa* Porque no lo tienes."
    mc "Ich auch nicht. *lacht* Weil du es nicht hast."

# game/scripts/c24/c24.rpy:1204
translate german c24s002_BetNoNun_b6d42a34:

    # bet "¿Y lo de las indemnizaciones de 40 días en los países en los que he trabajado?"
    bet "Und wie sieht es mit der 40-tägigen Abfindung in den Ländern aus, in denen ich gearbeitet habe?"

# game/scripts/c24/c24.rpy:1205
translate german c24s002_BetNoNun_57b7c2d1:

    # mc "He dicho que no sabía si alguno de esos países tenía 40 días de indemnización. *Risa*"
    mc "Ich sagte, ich wüsste nicht, ob eines dieser Länder eine Entschädigung von 40 Tagen anbiete. *lacht*"

# game/scripts/c24/c24.rpy:1206
translate german c24s002_BetNoNun_2a5f9b56:

    # mc "He pedido 30 días esperando que nos den 15. Lo de los 40 días de indemnización lo he dicho para ponerlo nervioso."
    mc "Ich bat um 30 Tage in der Hoffnung, dass sie uns 15 geben würden. Die 40 Tage Entschädigung erwähnte ich nur, um ihn nervös zu machen."

# game/scripts/c24/c24.rpy:1207
translate german c24s002_BetNoNun_ee19411c:

    # mc "Tanto él como tú habéis entendido lo que habéis creído oír, pero que yo no he dicho. *Risa* No hay una sola mentira en lo que he dicho."
    mc "Ihr beide habt verstanden, was ihr gehört zu haben glaubtet, was ich aber nicht gesagt habe. *Gelächter* An dem, was ich gesagt habe, ist keine einzige Lüge."

# game/scripts/c24/c24.rpy:1209
translate german c24s002_BetNoNun_7af3c1c9:

    # bet "*Risa* A partir de ahora tendré que analizar todo lo que digas."
    bet "*lacht* Von nun an muss ich alles, was du sagst, analysieren."

# game/scripts/c24/c24.rpy:1210
translate german c24s002_BetNoNun_538d6a77:

    # mc "No hace falta. Esos trucos solo los uso con gente de fuera de la familia."
    mc "Das ist nicht nötig. Solche Tricks wende ich nur bei Leuten außerhalb der Familie an."

# game/scripts/c24/c24.rpy:1211
translate german c24s002_BetNoNun_87171caa:

    # mc "Con la familia tendrían un recorrido muy corto."
    mc "Mit der Familie hätten sie eine sehr kurze Reise."

# game/scripts/c24/c24.rpy:1212
translate german c24s002_BetNoNun_a08b775d:

    # mc "¿Vamos a buscar a [emm]? Tenemos tres horas para hacer turismo antes de tener que volver."
    mc "Sollen wir nach [emm] suchen? Wir haben drei Stunden Zeit für Besichtigungen, bevor wir zurückmüssen."

# game/scripts/c24/c24.rpy:1214
translate german c24s002_BetNoNun_c73d7a39:

    # bet "Eso es otra cosa que no he entendido. ¿Por qué tres horas y no dos o cinco?"
    bet "Das verstehe ich auch nicht. Warum drei Stunden und nicht zwei oder fünf?"

# game/scripts/c24/c24.rpy:1215
translate german c24s002_BetNoNun_5ae5607f:

    # mc "Sonaba bien lo de tres horas para arreglarlo o tres días para publicarlo."
    mc "Drei Stunden für die Reparatur oder drei Tage für die Veröffentlichung klang gut."

# game/scripts/c24/c24.rpy:1216
translate german c24s002_BetNoNun_e04d2764:

    # mc "Hoy es viernes, con el fin de semana por en medio, se publicaría el lunes. No tenían mucho tiempo para reaccionar."
    mc "Heute ist Freitag, und mit dem Wochenende dazwischen würde es am Montag veröffentlicht werden. Sie hatten nicht viel Zeit zu reagieren."

# game/scripts/c24/c24.rpy:1217
translate german c24s002_BetNoNun_3f06bdb9:

    # mc "Además, a ese pobre hombre se le veía muy agobiado, como si no supiera de dónde le venían los golpes."
    mc "Darüber hinaus sah der arme Mann sehr verzweifelt aus, als ob er nicht wüsste, woher die Schläge kamen."

# game/scripts/c24/c24.rpy:1218
translate german c24s002_BetNoNun_0b5eb55b:

    # mc "Y lo del twirp ha sido lo que ha acabado de descolocarlo. Por suerte solo me sigue Jamaal en Twirper."
    mc "Und die Sache mit Twirper hat ihn völlig aus dem Konzept gebracht. Zum Glück folgt mir nur Jamaal auf Twirper."

# game/scripts/c24/c24.rpy:1220
translate german c24s002_BetNoNun_e573a454:

    # bet "*Risa* ¿Y todo eso lo has pensado en un minuto?"
    bet "*lacht* Und das alles ist dir in einer Minute eingefallen?"

# game/scripts/c24/c24.rpy:1221
translate german c24s002_BetNoNun_ba1d33a2:

    # mc "No, ayer estuve pensando en diferentes escenarios, pero hasta que no ha dicho lo de la expulsión no he atado cabos."
    mc "Nein, gestern habe ich über verschiedene Szenarien nachgedacht, aber erst als er den Schulverweis erwähnte, habe ich den Zusammenhang erkannt."

# game/scripts/c24/c24.rpy:1222
translate german c24s002_BetNoNun_27ccb0ee:

    # mc "En mi mente expulsión y despido venía a ser lo mismo, y he ido planeando cosas mientras hablaba."
    mc "Für mich waren Schulverweis und Entlassung im Grunde dasselbe, und ich habe während des Gesprächs schon Pläne geschmiedet."

# game/scripts/c24/c24.rpy:1224
translate german c24s002_BetNoNun_4cfa58a6:

    # bet "Pero les estás haciendo chantaje con lo de ir a la prensa. Podríamos acabar en la cárcel."
    bet "Aber Sie erpressen sie, indem Sie drohen, an die Presse zu gehen. Wir könnten im Gefängnis landen."

# game/scripts/c24/c24.rpy:1225
translate german c24s002_BetNoNun_a710e820:

    # mc "No, no les estoy chantajeando. Son ellos los que intentaron chantajearte a ti diciendo que si ibas a la prensa retiraban su oferta."
    mc "Nein, ich erpresse sie nicht. Sie waren es, die versucht haben, Sie zu erpressen, indem sie sagten, dass sie ihr Angebot zurückziehen würden, wenn Sie an die Presse gehen."

# game/scripts/c24/c24.rpy:1226
translate german c24s002_BetNoNun_ca7e35a8:

    # mc "Yo tan solo les he dicho que pueden retirar la oferta porque vamos a ir a la prensa igualmente."
    mc "Ich habe ihnen einfach gesagt, dass sie das Angebot zurückziehen können, weil wir sowieso an die Presse gehen werden."

# game/scripts/c24/c24.rpy:1227
translate german c24s002_BetNoNun_35aa0b2b:

    # mc "Si no quieren prensa, queremos un trato justo. Tan solo estamos rechazando su chantaje."
    mc "Wenn sie keine Berichterstattung in der Presse wollen, fordern wir eine faire Behandlung. Wir weisen ihre Erpressung schlichtweg zurück."

# game/scripts/c24/c24.rpy:1229
translate german c24s002_BetNoNun_a06661e2:

    # bet "Y si intentaran denunciarnos, tendrían que reconocer que estaban intentando chantajearme."
    bet "Und wenn sie versuchen würden, uns zu verklagen, müssten sie zugeben, dass sie versucht haben, mich zu erpressen."

# game/scripts/c24/c24.rpy:1230
translate german c24s002_BetNoNun_a82b70fa:

    # mc "Exacto. No soy abogado, pero el cura tampoco lo es. El sentido común es lo que me dice, y supongo que a él también."
    mc "Genau. Ich bin kein Jurist, aber der Priester auch nicht. Mein gesunder Menschenverstand sagt mir das, und ich nehme an, ihm sagt er dasselbe."

# game/scripts/c24/c24.rpy:1231
translate german c24s002_BetNoNun_4c6701dc:

    # mc "Por eso le he dado poco tiempo para decidir. No va a poder consultar con mucha gente."
    mc "Deshalb habe ich ihm wenig Zeit zum Entscheiden gegeben. Er wird nicht viele Leute konsultieren können."

# game/scripts/c24/c24.rpy:1233
translate german c24s002_BetNoNun_c944ee30:

    # bet "*Risa* Espero no tenerte nunca de enemigo."
    bet "*lacht* Ich hoffe, ich werde dich nie zum Feind haben."

# game/scripts/c24/c24.rpy:1234
translate german c24s002_BetNoNun_b446b678:

    # mc "No deberías temerme a mí. *Risa* [ama] y [eva] te deberían preocupar más. Especialmente si no tienes un rodillo a mano."
    mc "Du brauchst keine Angst vor mir zu haben. *Lacht* [ama] und [eva] sollten dir eher Sorgen bereiten. Vor allem, wenn du gerade keinen Nudelholz zur Hand hast."

# game/scripts/c24/c24.rpy:1235
translate german c24s002_BetNoNun_2f33abec:

    # mc "Vamos a buscar a [emm] y a hacer un poco de turismo. Solo tenemos tres horas."
    mc "Lasst uns [emm] suchen und ein bisschen Sightseeing machen. Wir haben nur drei Stunden Zeit."

# game/scripts/c24/c24.rpy:1237
translate german c24s002_BetNoNun_3e3e712e:

    # "Pasáis a buscar a [emm] por la heladería y le explicáis el resultado de la reunión."
    "Du holst [emm] aus der Eisdiele ab und erklärst ihm das Ergebnis des Treffens."

# game/scripts/c24/c24.rpy:1238
translate german c24s002_BetNoNun_eb17b87f:

    # emm "Menos mal que no he ido."
    emm "Gott sei Dank bin ich nicht hingegangen."

# game/scripts/c24/c24.rpy:1239
translate german c24s002_BetNoNun_b3961c59:

    # mc "¿Por qué?"
    mc "Weil?"

# game/scripts/c24/c24.rpy:1240
translate german c24s002_BetNoNun_b2a91863:

    # emm "Lo primero que le hubiera dicho al cura hubiese sido 'Mi tía os abandona, gilipollas. Vosotros os lo perdéis.'"
    emm "Das Erste, was ich dem Priester gesagt hätte, wäre gewesen: „Meine Tante verlässt euch, ihr Idioten. Ihr seid diejenigen, die am Ende leer ausgehen.“"

# game/scripts/c24/c24.rpy:1241
translate german c24s002_BetNoNun_7ae3d058:

    # emm "Y no hubiera habido indemnización. *Risa* Además, no se me hubiera ocurrido nunca."
    emm "Und es hätte auch keine Entschädigung gegeben. *lacht* Außerdem wäre mir das nie in den Sinn gekommen."

# game/scripts/c24/c24.rpy:1243
translate german c24s002_BetNoNun_7d2c8bc1:

    # bet "A mí tampoco. Pero [mc] ha pensado muy rápido y no ha dejado un segundo para que el Padre Segismund pudiera pararse a pensar."
    bet "Ich auch nicht. Aber [mc] hat sehr schnell gedacht und Pater Segismund keine Sekunde zum Nachdenken gelassen."

# game/scripts/c24/c24.rpy:1244
translate german c24s002_BetNoNun_8c2de467:

    # mc "Bueno, es una de las técnicas de negociación que me enseñaron en la universidad."
    mc "Nun ja, das ist eine der Verhandlungstechniken, die mir an der Universität beigebracht wurden."

# game/scripts/c24/c24.rpy:1245
translate german c24s002_BetNoNun_74514363:

    # mc "No la recomiendan por ser demasiado agresiva, y normalmente la gente tiene tiempo para pensar después, con lo que se dan cuenta de los fallos que haya cometido."
    mc "Davon wird abgeraten, da es zu aggressiv ist und die Leute im Nachhinein meist Zeit zum Nachdenken haben und so ihre Fehler erkennen."

# game/scripts/c24/c24.rpy:1247
translate german c24s002_BetNoNun_54844984:

    # emm "Lo importante es que está resuelto... a medias."
    emm "Hauptsache ist, dass es geregelt ist... mehr oder weniger."

# game/scripts/c24/c24.rpy:1248
translate german c24s002_BetNoNun_42ea4e89:

    # emm "¿Preparados para que os haga de guía turístico de Monterey?"
    emm "Sind Sie bereit, dass ich Sie durch Monterey führe?"

# game/scripts/c24/c24.rpy:1249
translate german c24s002_BetNoNun_377e71a0:

    # mc "No sabía que habías estado aquí antes."
    mc "Ich wusste nicht, dass du schon einmal hier gewesen warst."

# game/scripts/c24/c24.rpy:1251
translate german c24s002_BetNoNun_eddf0b65:

    # emm "No he estado nunca, pero he tenido tiempo de mirarme unas guías por internet mientras esperaba."
    emm "Ich war noch nie dort, aber ich hatte während des Wartens Zeit, mir einige Reiseführer online anzusehen."

# game/scripts/c24/c24.rpy:1253
translate german c24s002_BetNoNun_5e38cf5d:

    # emm "Y anoche, mientras alguien hacía otras cosas más divertidas."
    emm "Und letzte Nacht, während jemand anderen, lustigeren Dingen nachging."

# game/scripts/c24/c24.rpy:1254
translate german c24s002_BetNoNun_ea8e8ae5:

    # mc "*Risa* Es un buen entrenamiento para ti. Querías ser fotógrafa de guías de viaje."
    mc "*Lacht* Das ist ein gutes Training für dich. Du wolltest ja Reisefotograf werden."

# game/scripts/c24/c24.rpy:1256
translate german c24s002_BetNoNun_aa056308:

    # bet "Nunca me has dicho como [eri] y tú decidisteis que vuestro sueño era algo tan específico y que coincidieseis en lo que queríais ser."
    bet "Du hast mir nie erzählt, wie [eri] und du entschieden hast, dass dein Traum etwas so Spezielles ist und dass ihr euch darauf geeinigt habt, was du werden wolltest."

# game/scripts/c24/c24.rpy:1258
translate german c24s002_BetNoNun_061db69d:

    # emm "Encontramos unas guías de Europa en la biblioteca del instituto, de esas viejas, en papel."
    emm "Wir haben in der Schulbibliothek einige alte Reiseführer für Europa gefunden."

# game/scripts/c24/c24.rpy:1259
translate german c24s002_BetNoNun_5d5079a9:

    # emm "Venecia, París, Roma, Barcelona, Atenas..."
    emm "Venedig, Paris, Rom, Barcelona, Athen..."

# game/scripts/c24/c24.rpy:1260
translate german c24s002_BetNoNun_863ae883:

    # emm "Decidimos que queríamos conocer todas esas ciudades. *Risa* Y que no había mejor forma de hacerlo que si nos pagaban."
    emm "Wir beschlossen, all diese Städte zu besuchen. *lacht* Und dass es keinen besseren Weg gäbe, dies zu tun, als wenn wir dafür bezahlt würden."

# game/scripts/c24/c24.rpy:1261
translate german c24s002_BetNoNun_45cf909a:

    # mc "El plan se le ocurrió a [eri], ¿no?"
    mc "Der Plan stammte von [eri], nicht wahr?"

# game/scripts/c24/c24.rpy:1263
translate german c24s002_BetNoNun_6f9ba524:

    # emm "¿Qué insinúas con eso? ¿Que mis planes no son realistas?"
    emm "Was wollen Sie damit andeuten? Dass meine Pläne unrealistisch sind?"

# game/scripts/c24/c24.rpy:1265
translate german c24s002_BetNoNun_e228ff71:

    # emm "El de anoche funcionó."
    emm "Hat gestern Abend funktioniert."

# game/scripts/c24/c24.rpy:1266
translate german c24s002_BetNoNun_b84309d8:

    # mc "Pero se le ocurrió a [eri], ¿verdad?"
    mc "Aber es war doch die Idee von [eri], oder?"

# game/scripts/c24/c24.rpy:1268
translate german c24s002_BetNoNun_08debe65:

    # emm "Sí. *Risa* Y vámonos a visitar Monterey o al final no podré enseñaros los sitios que he descubierto."
    emm "Ja. *lacht* Und lass uns Monterey besuchen, sonst kann ich dir die Orte, die ich entdeckt habe, nicht zeigen."

# game/scripts/c24/c24.rpy:1269
translate german c24s002_BetNoNun_d9a0c285:

    # mc "Vamos. Tenemos menos de tres horas."
    mc "Los geht's. Wir haben weniger als drei Stunden."

# game/scripts/c24/c24.rpy:1271
translate german c24s002_BetNoNun_2f35927b:

    # "[emm] os lleva por algunos de los sitios más emblemáticos de Monterey, aprovechando para sacar fotografías en cada uno de ellos."
    "[emm] führt Sie durch einige der bekanntesten Sehenswürdigkeiten von Monterey und bietet Ihnen die Möglichkeit, an jeder einzelnen ein Foto zu machen."

# game/scripts/c24/c24.rpy:1272
translate german c24s002_BetNoNun_a4dee4f8:

    # "Os da explicaciones sorprendentemente detalladas sobre cada uno de los lugares que visitáis."
    "Er gibt Ihnen erstaunlich detaillierte Erklärungen zu jedem der Orte, die Sie besuchen."

# game/scripts/c24/c24.rpy:1273
translate german c24s002_BetNoNun_bf6175b6:

    # "Pero esas tres horas se hacen muy cortas y tenéis que dejar muchas cosas en el tintero, para otra visita."
    "Doch diese drei Stunden vergehen sehr schnell, und man muss viele Dinge auf einen späteren Besuch verschieben."

# game/scripts/c24/c24.rpy:1274
translate german c24s002_BetNoNun_5706c58a:

    # "La última parada es la Catedral de Monterey, muy cerca del edificio donde os habéis reunido con el Padre Segismund."
    "Die letzte Station ist die Kathedrale von Monterey, ganz in der Nähe des Gebäudes, in dem Sie Pater Segismund getroffen haben."

# game/scripts/c24/c24.rpy:1275
translate german c24s002_BetNoNun_c926f7ff:

    # emm "Y esta es la catedral más pequeña de los Estados Unidos. Se fundó como la capilla de un presidio español."
    emm "Und dies ist die kleinste Kathedrale in den Vereinigten Staaten. Sie wurde als Kapelle eines spanischen Presidio gegründet."

# game/scripts/c24/c24.rpy:1276
translate german c24s002_BetNoNun_77f2441d:

    # emm "Era como llamaban a sus fuertes."
    emm "So nannten sie ihre Festungen."

# game/scripts/c24/c24.rpy:1277
translate german c24s002_BetNoNun_27596bdb:

    # bet "Muy interesante la visita, [emm]. Nos has dado un montón de información para haber estudiado la ciudad solo unas horas."
    bet "Der Besuch war sehr interessant, [emm]. Sie haben uns viele Informationen gegeben, obwohl Sie die Stadt nur wenige Stunden lang erkundet haben."

# game/scripts/c24/c24.rpy:1278
translate german c24s002_BetNoNun_6c389925:

    # mc "Si lo de hacerte fotógrafa no funciona, tienes futuro como guía turística."
    mc "Sollte es mit der Fotografie nicht klappen, hätten Sie eine Zukunft als Reiseleiter."

# game/scripts/c24/c24.rpy:1280
translate german c24s002_BetNoNun_6b6926e8:

    # emm "Iros antes de que me hagáis ruborizar. No estoy acostumbrada a los elogios."
    emm "Verschwinde, bevor du mich erröten lässt. Ich bin Komplimente nicht gewohnt."

# game/scripts/c24/c24.rpy:1281
translate german c24s002_BetNoNun_c9198b76:

    # emm "Me llevo la camioneta a la heladería y os espero allí. Ya me estoy haciendo amiga de Margaret, la camarera."
    emm "Ich fahre mit dem Wagen zum Eiscafé und warte dort auf dich. Ich verstehe mich schon gut mit Margaret, der Kellnerin."

# game/scripts/c24/c24.rpy:1282
translate german c24s002_BetNoNun_e57e09a3:

    # bet "Déjame un poco de helado. El dónut de antes me ha dejado con hambre."
    bet "Lass mir etwas Eis da. Der Donut von vorhin hat mich hungrig gemacht."

# game/scripts/c24/c24.rpy:1284
translate german c24s002_BetNoNun_733dc6d8:

    # mc "Te vemos en un rato."
    mc "Wir sehen uns gleich."

# game/scripts/c24/c24.rpy:1287
translate german c24s002_BetNoNun_efd32a54:

    # bet "Hola de nuevo, Hermana. Venimos a ver al Padre Segismund de nuevo."
    bet "Hallo nochmal, Schwester. Wir sind wieder hier, um Pater Segismund zu besuchen."

# game/scripts/c24/c24.rpy:1288
translate german c24s002_BetNoNun_e9c67058:

    # "Monja" "Les está esperando. Pasen."
    "Monja" "Er wartet auf dich. Komm herein."

# game/scripts/c24/c24.rpy:1290
translate german c24s002_BetNoNun_61637fb9:

    # "Segismund" "Hola de nuevo. Tengo noticias para ustedes. Siéntense, por favor."
    "Segismund" "Hallo nochmal. Ich habe Neuigkeiten für Sie. Bitte setzen Sie sich."

# game/scripts/c24/c24.rpy:1291
translate german c24s002_BetNoNun_03495d72:

    # "Segismund" "He hablado con mis superiores y, por desgracia, no han aceptado lo de los 30 días de indemnización por año trabajado."
    "Segismund" "Ich habe mit meinen Vorgesetzten gesprochen, und leider haben diese die 30 Tage Entschädigung pro Arbeitsjahr nicht akzeptiert."

# game/scripts/c24/c24.rpy:1292
translate german c24s002_BetNoNun_19bf6c02:

    # mc "Bueno, entonces no nos deja más opciones que ir a la prensa."
    mc "Nun, dann bleibt uns keine andere Wahl, als uns an die Presse zu wenden."

# game/scripts/c24/c24.rpy:1294
translate german c24s002_BetNoNun_d3db4a6b:

    # "Segismund" "No, espere. Me han autorizado a pagarle a la Hermana Beatrix tan solo 20 días de indemnización."
    "Segismund" "Nein, Moment. Ich bin lediglich befugt, Schwester Beatrix eine Entschädigung für 20 Tage zu zahlen."

# game/scripts/c24/c24.rpy:1295
translate german c24s002_BetNoNun_f4c62f42:

    # "Segismund" "Usted tenía razón en que hay países en los que ha trabajado con indemnizaciones de hasta 45, pero otros tienen menos."
    "Segismund" "Sie hatten Recht, es gibt Länder, in denen Sie gearbeitet haben, mit einer Vergütung von bis zu 45, aber in anderen Ländern ist sie geringer."

# game/scripts/c24/c24.rpy:1296
translate german c24s002_BetNoNun_4911aef5:

    # "Segismund" "Sé que no era lo que esperaban, pero..."
    "Segismund" "Ich weiß, es war nicht das, was du erwartet hast, aber..."

# game/scripts/c24/c24.rpy:1297
translate german c24s002_BetNoNun_dc7f482b:

    # mc "Entonces eso sería... algo más de dos años de sueldo."
    mc "Das wären also... etwas mehr als zwei Jahresgehälter."

# game/scripts/c24/c24.rpy:1299
translate german c24s002_BetNoNun_830701cc:

    # "Segismund" "Algo más. He pedido que, al no cumplir con sus peticiones, añadieran algo más por algunos complementos para su tía."
    "Segismund" "Noch etwas. Ich habe darum gebeten, dass sie, da ihre Wünsche nicht erfüllt wurden, ihrer Tante noch ein paar Accessoires dazulegen."

# game/scripts/c24/c24.rpy:1300
translate german c24s002_BetNoNun_61103e94:

    # "Segismund" "Al final, serán 2.64 años de sueldo. Lo siento pero no he podido conseguir más." id c24s002_BetNoNun_61103e94
    "Segismund" "Am Ende entspricht das 2,64 Jahresgehältern. Tut mir leid, aber mehr konnte ich nicht herausholen." id c24s002_BetNoNun_61103e94

# game/scripts/c24/c24.rpy:1301
translate german c24s002_BetNoNun_0f58b44f:

    # "Segismund" "Obviamente tendrá que firmar un acuerdo de confidencialidad sobre todo este asunto."
    "Segismund" "Selbstverständlich müssen Sie in Bezug auf diese ganze Angelegenheit eine Vertraulichkeitsvereinbarung unterzeichnen."

# game/scripts/c24/c24.rpy:1302
translate german c24s002_BetNoNun_d093d5c0:

    # mc "2.64 años y acuerdo de confidencialidad. ¿Cómo lo ves, Tía [bet]?" id c24s002_BetNoNun_d093d5c0
    mc "2,64 Jahre und eine Vertraulichkeitsvereinbarung. Was meinst du, Tante [bet]?" id c24s002_BetNoNun_d093d5c0

# game/scripts/c24/c24.rpy:1304
translate german c24s002_BetNoNun_3c013f7c:

    # bet "Me parece bien..."
    bet "Das scheint mir in Ordnung zu sein..."

# game/scripts/c24/c24.rpy:1306
translate german c24s002_BetNoNun_d957b91c:

    # mc "¿Hay oferta por escrito de todo esto?"
    mc "Liegt hierfür ein schriftliches Angebot vor?"

# game/scripts/c24/c24.rpy:1307
translate german c24s002_BetNoNun_56633b5c:

    # "Segismund" "Sí, también tengo el acuerdo de confidencialidad. Ha llegado todo hace unos minutos. Tres horas era muy poco tiempo."
    "Segismund" "Ja, ich habe auch die Vertraulichkeitsvereinbarung. Alles ist vor wenigen Minuten angekommen. Drei Stunden waren zu kurz."

# game/scripts/c24/c24.rpy:1308
translate german c24s002_BetNoNun_5917cbbf:

    # "Segismund" "La oferta indica que dejará la Iglesia a final de mes, que es cuando se les entregará el dinero. Pero el acuerdo de confidencialidad entra en vigor hoy."
    "Segismund" "Das Angebot sieht vor, dass er die Kirche Ende des Monats verlässt, woraufhin das Geld ausgezahlt wird. Die Vertraulichkeitsvereinbarung tritt jedoch bereits heute in Kraft."

# game/scripts/c24/c24.rpy:1309
translate german c24s002_BetNoNun_987ab9f2:

    # mc "Me parece bien. ¿Firmamos?"
    mc "Das klingt gut. Sollen wir unterschreiben?"

# game/scripts/c24/c24.rpy:1311
translate german c24s002_BetNoNun_e16f9f5e:

    # "Después de firmar todos los papeles..."
    "Nachdem alle Papiere unterschrieben waren..."

# game/scripts/c24/c24.rpy:1312
translate german c24s002_BetNoNun_149060ab:

    # mc "Bueno, Tía [bet], en unos días dejarás de ser monja y tendrás una buena cantidad de dinero en tu cuenta."
    mc "Nun, Tante [bet], in wenigen Tagen wirst du keine Nonne mehr sein und du wirst eine ansehnliche Summe Geld auf deinem Konto haben."

# game/scripts/c24/c24.rpy:1313
translate german c24s002_BetNoNun_fa655e45:

    # bet "Sí. Creo que es lo mejor para todos. Para la Iglesia y para mí."
    bet "Ja. Ich denke, es ist das Beste für alle. Für die Kirche und für mich."

# game/scripts/c24/c24.rpy:1314
translate german c24s002_BetNoNun_48ee1e2b:

    # mc "Creo que, ahora que todo está firmado, le puedes decir al Padre Segismund cuál era tu intención al entrar por esa puerta esta mañana."
    mc "Ich denke, jetzt, wo alles unterschrieben ist, können Sie Pater Segismund mitteilen, was Ihre Absicht war, als Sie heute Morgen durch diese Tür kamen."

# game/scripts/c24/c24.rpy:1316
translate german c24s002_BetNoNun_3938639c:

    # bet "¿Qué? ¿Crees que es necesario?"
    bet "Was? Glaubst du, das ist notwendig?"

# game/scripts/c24/c24.rpy:1317
translate german c24s002_BetNoNun_0f1781b4:

    # mc "Creo que vas a disfrutar cada segundo."
    mc "Ich glaube, du wirst jede Sekunde genießen."

# game/scripts/c24/c24.rpy:1319
translate german c24s002_BetNoNun_d1f08a29:

    # bet "Padre Segismund, primero quiero darle las gracias por hacer las gestiones tan rápido."
    bet "Pater Segismund, zunächst möchte ich Ihnen dafür danken, dass Sie die Angelegenheit so schnell erledigt haben."

# game/scripts/c24/c24.rpy:1321
translate german c24s002_BetNoNun_5165c59d:

    # "Segismund" "Supongo que hay algún pero por lo que ha dicho su sobrino."
    "Segismund" "Ich nehme an, es gibt ein „Aber“, wegen dem, was sein Neffe gesagt hat."

# game/scripts/c24/c24.rpy:1323
translate german c24s002_BetNoNun_97c571f0:

    # bet "Sí. Pero mi intención al venir hoy era abandonar la Iglesia. Nunca pensé en una indemnización ya que era yo la que me iba."
    bet "Ja. Aber meine Absicht, heute hierherzukommen, war, die Kirche zu verlassen. An eine Entschädigung habe ich nie gedacht, da ich ja derjenige war, der ging."

# game/scripts/c24/c24.rpy:1324
translate german c24s002_BetNoNun_492795a5:

    # bet "Gracias por 2.64 años de mi sueldo." id c24s002_BetNoNun_492795a5
    bet "Vielen Dank für 2,64 Jahre meines Gehalts." id c24s002_BetNoNun_492795a5

# game/scripts/c24/c24.rpy:1326
translate german c24s002_BetNoNun_7ed23dc3:

    # "Segismund" "¿Qué?"
    "Segismund" "Das?"

# game/scripts/c24/c24.rpy:1327
translate german c24s002_BetNoNun_f3acb3c7:

    # mc "*Risa* Por suerte, todo está firmado y mi tía ya no se puede echar atrás."
    mc "*Gelächter* Zum Glück ist alles unterschrieben und meine Tante kann jetzt nicht mehr zurücktreten."

# game/scripts/c24/c24.rpy:1328
translate german c24s002_BetNoNun_5cd145b7:

    # mc "Gracias por todo, Padre Segismund."
    mc "Vielen Dank für alles, Pater Segismund."

# game/scripts/c24/c24.rpy:1329
translate german c24s002_BetNoNun_d78cd553:

    # "Abandonáis el edificio de la Iglesia con la cara de sorpresa del Padre Segismund grabada en vuestras retinas."
    "Sie verlassen das Kirchengebäude mit dem überraschten Gesichtsausdruck von Pater Segismund, der sich tief in Ihre Netzhaut eingebrannt hat."

# game/scripts/c24/c24.rpy:1332
translate german c24s002_BetNoNun_b438befd:

    # "Una vez en el exterior..."
    "Draußen angekommen..."

# game/scripts/c24/c24.rpy:1334
translate german c24s002_BetNoNun_3aa48686:

    # bet "Gracias por todo, [mc]. Si no hubiera sido por ti..."
    bet "Vielen Dank für alles, [mc]. Ohne dich wäre das alles nicht möglich gewesen..."

# game/scripts/c24/c24.rpy:1335
translate german c24s002_BetNoNun_5dc15e44:

    # mc "No tienes por qué darlas. He visto una oportunidad y la he aprovechado. Esperaba 15 días y nos han dado 20. No está mal."
    mc "Du musst sie nicht aufgeben. Ich sah eine Chance und habe sie genutzt. Ich hatte mit 15 Tagen gerechnet, und sie gaben uns 20. Nicht schlecht."

# game/scripts/c24/c24.rpy:1336
translate german c24s002_BetNoNun_a0116eca:

    # mc "Ahora tienes dinero suficiente para la recertificación, supongo."
    mc "Jetzt haben Sie wohl genug Geld für die Rezertifizierung."

# game/scripts/c24/c24.rpy:1339
translate german c24s002_BetNoNun_a26a6a4e:

    # bet "Lo que más me jode de no haber dejado de ser monja hoy es que no te puedo besar ahora mismo aquí delante."
    bet "Was mich am meisten daran ärgert, dass ich heute noch nicht aufgehört habe, Nonne zu sein, ist, dass ich dich nicht hier vor dir küssen kann."

# game/scripts/c24/c24.rpy:1340
translate german c24s002_BetNoNun_f2817d0d:

    # bet "Serían capaces de excomulgarme para ahorrarse el dinero. *Risa*"
    bet "Sie wären sogar in der Lage, mich zu exkommunizieren, um sich das Geld zu sparen. *lacht*"

# game/scripts/c24/c24.rpy:1341
translate german c24s002_BetNoNun_5c2c04f5:

    # mc "*Risa* Habrá mucho tiempo para eso. No te preocupes."
    mc "*Lacht* Dafür wird noch genug Zeit sein. Keine Sorge."

# game/scripts/c24/c24.rpy:1342
translate german c24s002_BetNoNun_c72099de:

    # mc "Vamos a buscar a [emm]. Se tiene que estar mordiendo las uñas del nerviosismo."
    mc "Lasst uns [emm] suchen gehen. Er muss vor lauter Nervosität an seinen Nägeln kauen."

# game/scripts/c24/c24.rpy:1344
translate german c24s002_BetNoNun_583d8878:

    # "Después de recoger a [emm] y explicárselo todo..."
    "Nachdem ich [emm] abgeholt und ihm alles erklärt hatte..."

# game/scripts/c24/c24.rpy:1346
translate german c24s002_BetNoNun_7f514a72:

    # emm "Si queréis puedo conducir yo de vuelta a casa. Por si estáis cansados después de la noche de ayer. *Risita*"
    emm "Wenn du möchtest, kann ich dich nach Hause fahren. Falls du nach gestern Abend müde bist. *Kichert*"

# game/scripts/c24/c24.rpy:1347
translate german c24s002_BetNoNun_5321e4ac:

    # mc "Me parece una buena idea. Así podemos echar una siesta mientras tú conduces."
    mc "Das klingt nach einer guten Idee. So können wir ein Nickerchen machen, während du fährst."

# game/scripts/c24/c24.rpy:1348
translate german c24s002_BetNoNun_e7093740:

    # mc "Tu dormiste en el viaje de ida y nosotros en el de vuelta."
    mc "Du hast auf der Hinreise geschlafen und wir auf der Rückreise."

# game/scripts/c24/c24.rpy:1350
translate german c24s002_BetNoNun_e9b48284:

    # emm "Vuelvo a pedirme el asiento de atrás. He dormido poco con los ronquidos de Tía [bet]."
    emm "Ich nehme wieder den Rücksitz ein. Wegen Tantes Schnarchen habe ich kaum geschlafen."

# game/scripts/c24/c24.rpy:1351
translate german c24s002_BetNoNun_5db2a345:

    # emm "¡De vuelta a casa!"
    emm "Wieder zu Hause!"

# game/scripts/c24/c24.rpy:1353
translate german c24s002_BetNoNun_4bdf22d8:

    # "Durante el viaje a casa, Tía [bet] manda varios mensajes al grupo de WhatsUp para informar de cómo ha ido todo."
    "Während der Heimreise schickt Tante [bet] mehrere Nachrichten an die WhatsApp-Gruppe, um zu berichten, wie alles gelaufen ist."

# game/scripts/c24/c24.rpy:1355
translate german c24s002_BetNoNun_ceeade09:

    # "Se queda profundamente dormida después de contestar todos los mensajes del resto de las chicas."
    "Nachdem sie alle Nachrichten der anderen Mädchen beantwortet hat, fällt sie in einen tiefen Schlaf."

# game/scripts/c24/c24.rpy:1366
translate german c24s003_Mar_203aaac2:

    # "Paráis a comer en King City. Pizza para todos. Idea de [bet]."
    "Ihr macht Mittagspause in King City. Pizza für alle. Idee von [bet]."

# game/scripts/c24/c24.rpy:1367
translate german c24s003_Mar_ac4278e6:

    # "Después de charlar un rato y reposar la comida, seguís camino a casa."
    "Nachdem ihr euch eine Weile unterhalten und das Essen sacken lassen habt, setzt ihr euren Heimweg fort."

# game/scripts/c24/c24.rpy:1369
translate german c24s003_Mar_60eee3d4:

    # "Conduces tú después de comer. [emm] ha querido competir con [bet] comiendo pizza y se siente pesada."
    "Du fährst nach dem Essen. [emm] wollte mit [bet] konkurrieren, indem er Pizza aß und fühlt sich jetzt schwer."

# game/scripts/c24/c24.rpy:1372
translate german c24s003_Mar_8d1d0d97:

    # "En cuanto abres la puerta del garaje, aparece [mar] en la puerta de casa. Parece que os ha estado esperando."
    "Sobald du das Garagentor öffnest, erscheint [mar] vor deiner Haustür. Anscheinend hat er auf dich gewartet."

# game/scripts/c24/c24.rpy:1374
translate german c24s003_Mar_1b82c39b:

    # mom "Hola, [emm]. ¿Te lo has pasado bien con el coche?"
    mom "Hallo [emm]. Hattest du viel Spaß mit dem Auto?"

# game/scripts/c24/c24.rpy:1375
translate german c24s003_Mar_6d205f3c:

    # emm "Ha sido fantástico. Incluso hemos tenido un poco de tiempo para hacer turismo en Monterey."
    emm "Es war fantastisch. Wir hatten sogar ein bisschen Zeit für Sightseeing in Monterey."

# game/scripts/c24/c24.rpy:1376
translate german c24s003_Mar_57e1baed:

    # emm "¿Todo bien por aquí?"
    emm "Ist hier alles in Ordnung?"

# game/scripts/c24/c24.rpy:1377
translate german c24s003_Mar_7f0d05a4:

    # mom "Sí, cielo. Os he echado de menos. Déjame abrazar a Tía [bet]."
    mom "Ja, Schatz. Ich habe euch alle vermisst. Lass mich Tante [bet] umarmen."

# game/scripts/c24/c24.rpy:1379
translate german c24s003_Mar_cc2845ff:

    # mom "Felicidades por haberlo resuelto todo, Tía."
    mom "Herzlichen Glückwunsch, dass du alles geregelt hast, Tante."

# game/scripts/c24/c24.rpy:1382
translate german c24s003_Mar_725c9f3b:

    # mom "Y bienvenida al harén."
    mom "Und willkommen im Harem."

# game/scripts/c24/c24.rpy:1384
translate german c24s003_Mar_da4826a4:

    # mom "Y por entrar en el harén de [mc]."
    mom "Und um in den Harem von [mc] einzutreten."

# game/scripts/c24/c24.rpy:1386
translate german c24s003_Mar_2aee896c:

    # mom "Y por lo tuyo con [mc]."
    mom "Und was deine Sache mit [mc] angeht."

# game/scripts/c24/c24.rpy:1387
translate german c24s003_Mar_2d1c0355:

    # bet "Gracias, cielo. Ha sido un viaje muy intenso."
    bet "Danke, Liebling. Es war eine sehr intensive Reise."

# game/scripts/c24/c24.rpy:1388
translate german c24s003_Mar_798c6d0d:

    # bet "Ve a abrazar a [mc]. Te veo ansiosa. [emm] y yo vamos a meter las maletas dentro."
    bet "Geh und umarme [mc]. Du wirkst ängstlich. [emm] und ich bringen jetzt die Koffer hinein."

# game/scripts/c24/c24.rpy:1390
translate german c24s003_Mar_b5bb3a83:

    # emm "¿No nos va a ayudar [mc]? ¡Yo tengo tres maletas!"
    emm "Wollt ihr uns denn nicht helfen? Ich habe drei Koffer!"

# game/scripts/c24/c24.rpy:1392
translate german c24s003_Mar_4307645b:

    # bet "Él las ha bajado de la camioneta."
    bet "Er holte sie aus dem Lastwagen."

# game/scripts/c24/c24.rpy:1393
translate german c24s003_Mar_29b2db10:

    # bet "Si quieres trabajar viajando tendrás que aprender a llevar menos equipaje. Esta es tu primera lección."
    bet "Wer auf Reisen arbeiten möchte, muss lernen, weniger einzupacken. Das ist die erste Lektion."

# game/scripts/c24/c24.rpy:1394
translate german c24s003_Mar_b278f219:

    # bet "Yo subo una y tú otra. Después subes la tercera mientras yo recojo la mía."
    bet "Ich nehme eins, und du nimmst eins. Dann nimmst du das dritte, während ich meins nehme."

# game/scripts/c24/c24.rpy:1396
translate german c24s003_Mar_7ef7b476:

    # "[mar] te da un abrazo que sería la envidia de cualquier mamá oso."
    "[mar] gibt dir eine Umarmung, um die dich jede Bärenmutter beneiden würde."

# game/scripts/c24/c24.rpy:1397
translate german c24s003_Mar_9520bae5:

    # mom "Se me ha hecho muy largo no teneros por aquí."
    mom "Es ist schon lange her, dass ich euch alle hier hatte."

# game/scripts/c24/c24.rpy:1398
translate german c24s003_Mar_9846dfae:

    # mc "Sólo ha sido un día. Pero me alegro de volver, y más con este recibimiento."
    mc "Es ist erst ein Tag vergangen. Aber ich bin froh, wieder hier zu sein, besonders nach diesem herzlichen Empfang."

# game/scripts/c24/c24.rpy:1402
translate german c24s003_Mar_8e84404a:

    # "Tu madre te da un apasionado beso que te deja sin aliento."
    "Deine Mutter gibt dir einen leidenschaftlichen Kuss, der dir den Atem raubt."

# game/scripts/c24/c24.rpy:1404
translate german c24s003_Mar_4f036114:

    # "[mar] te da un apasionado beso que te deja sin aliento."
    "[mar] gibt dir einen leidenschaftlichen Kuss, der dich atemlos macht."

# game/scripts/c24/c24.rpy:1406
translate german c24s003_Mar_c153a469:

    # mom "Ahora todo está mejor. Ya estáis en casa."
    mom "Jetzt ist alles besser. Du bist zu Hause."

# game/scripts/c24/c24.rpy:1409
translate german c24s003_Mar_3f492dcd:

    # "Después de un largo abrazo..."
    "Nach einer langen Umarmung..."

# game/scripts/c24/c24.rpy:1410
translate german c24s003_Mar_fee1222a:

    # mom "Hoy tienes tu primera cita con [kia], no lo olvides."
    mom "Heute ist dein erstes Date mit [kia], vergiss das nicht."

# game/scripts/c24/c24.rpy:1411
translate german c24s003_Mar_3f4dc75d:

    # mc "*Risa* No lo puedo olvidar, aunque para nosotros es la tercera. Salimos a comer y dimos un paseo."
    mc "*lacht* Ich kann es nicht vergessen, obwohl wir schon zum dritten Mal da waren. Wir waren essen und haben einen Spaziergang gemacht."

# game/scripts/c24/c24.rpy:1412
translate german c24s003_Mar_86c2bfee:

    # mom "¿Dónde vais a ir?"
    mom "Wohin gehst du?"

# game/scripts/c24/c24.rpy:1413
translate german c24s003_Mar_c6bff8c9:

    # mc "No tengo ni idea. Me dijo que lo organizaba ella, con lo que es una sorpresa también para mí."
    mc "Ich habe keine Ahnung. Sie sagte mir, sie würde es organisieren, daher ist es auch für mich eine Überraschung."

# game/scripts/c24/c24.rpy:1415
translate german c24s003_Mar_941e8bf1:

    # mom "Ah, por eso me estuvo preguntando por restaurantes bonitos. ¡Seré tonta!"
    mom "Ah, deshalb hat er mich nach guten Restaurants gefragt. Ich bin so ein Dummkopf!"

# game/scripts/c24/c24.rpy:1416
translate german c24s003_Mar_1bbfa337:

    # mom "El único que conozco es el de la cueva al que me llevaste. Parece que hace mil años."
    mom "Die einzige, die ich kenne, ist die in der Höhle, zu der du mich gebracht hast. Es kommt mir vor wie eine Ewigkeit."

# game/scripts/c24/c24.rpy:1418
translate german c24s003_Mar_c696b1b4:

    # mom "Pero ese no se lo voy a recomendar a nadie. Ese es nuestro. Nuestra primera cita, aunque no saliéramos juntos aún."
    mom "Aber ich werde das niemandem empfehlen. Das ist unser eigenes. Unser erstes Date, obwohl wir damals noch gar nicht zusammen waren."

# game/scripts/c24/c24.rpy:1419
translate german c24s003_Mar_7518d039:

    # mc "Un día tenemos que volver a ese sitio. Fue una noche fantástica."
    mc "Wir müssen eines Tages an diesen Ort zurückkehren. Es war eine fantastische Nacht."

# game/scripts/c24/c24.rpy:1421
translate german c24s003_Mar_693f7f38:

    # mom "Estoy segura de que, te lleve donde te lleve [kia] también os lo vais a pasar muy bien."
    mom "Ich bin mir sicher, dass du, wohin dich [kia] auch führt, eine tolle Zeit haben wirst."

# game/scripts/c24/c24.rpy:1422
translate german c24s003_Mar_77981c86:

    # mom "Ayer estaba nerviosa por la cita."
    mom "Gestern war ich wegen des Dates nervös."

# game/scripts/c24/c24.rpy:1423
translate german c24s003_Mar_2f7cf5dc:

    # mc "A lo mejor debería hablar con ella antes..."
    mc "Vielleicht sollte ich zuerst mit ihr reden..."

# game/scripts/c24/c24.rpy:1425
translate german c24s003_Mar_07317058:

    # mom "No creo que tengas mucho tiempo para eso. Está trabajando y supongo que, cuando vuelva a casa, se querrá poner guapa para ti."
    mom "Ich glaube nicht, dass du dafür viel Zeit hast. Sie arbeitet, und ich nehme an, sie wird sich für dich besonders schick machen wollen, wenn sie nach Hause kommt."

# game/scripts/c24/c24.rpy:1426
translate german c24s003_Mar_2bed33bd:

    # mom "Los nervios se le pasarán en cuanto la recojas."
    mom "Ihre Nervosität wird verschwinden, sobald du sie hochhebst."

# game/scripts/c24/c24.rpy:1427
translate german c24s003_Mar_100c80b0:

    # mc "*Risa* Espero que también se me pasen a mí."
    mc "*lacht* Hoffentlich sehe ich die auch bei mir so."

# game/scripts/c24/c24.rpy:1429
translate german c24s003_Mar_5874c68b:

    # mom "*Risa* Bueno, ve a descansar un rato antes de esa cita."
    mom "*lacht* Na ja, dann ruh dich erstmal aus, bevor du dich verabredest."

# game/scripts/c24/c24.rpy:1431
translate german c24s003_Mar_10c61dcb:

    # mom "Será mejor que vayas a descansar un rato antes de la cena."
    mom "Du solltest dich besser erst einmal ausruhen, bevor du zu Abend isst."

# game/scripts/c24/c24.rpy:1432
translate german c24s003_Mar_8bb863a8:

    # mom "Dame la mochila. Bajaré a dejar la ropa en la lavadora."
    mom "Gib mir den Rucksack. Ich gehe runter und stecke die Wäsche in die Waschmaschine."

# game/scripts/c24/c24.rpy:1433
translate german c24s003_Mar_7ce5b618:

    # mom "Veo que al final te has puesto la camisa azul. *Risa*"
    mom "Ich sehe, du hast endlich das blaue Hemd angezogen. *lacht*"

# game/scripts/c24/c24.rpy:1435
translate german c24s003_Mar_03172388:

    # mc "*Risa* Si, te veo luego."
    mc "*Lacht* Ja, bis später."

# game/scripts/c24/c24.rpy:1441
translate german c24s003_NoKia_e8c88a3a:

    # "Subes a tu habitación a dejar tus cosas y aprovechas para jugar un rato a My Residence."
    "Du gehst in dein Zimmer, um deine Sachen abzustellen, und nutzt die Gelegenheit, eine Weile My Residence zu spielen."

# game/scripts/c24/c24.rpy:1442
translate german c24s003_NoKia_55699688:

    # "Hoy toca cita con Claire, la preciosa irlandesa que es la madre de la exnovia del protagonista."
    "Heute haben wir ein Date mit Claire, der schönen Irin, die die Mutter der Ex-Freundin des Protagonisten ist."

# game/scripts/c24/c24.rpy:1443
translate german c24s003_NoKia_c128ba42:

    # "Hay una tórrida escena en la ducha que crees que rejugarás varias veces en la galería."
    "Es gibt eine heiße Duschszene, die man sich in der Galerie bestimmt mehrmals ansehen wird."

# game/scripts/c24/c24.rpy:1445
translate german c24s003_NoKia_90b73b27:

    # "Después de cenar, te retiras a tu habitación, donde lees unos documentos que [ama] te ha enviado sobre Iron Fist."
    "Nach dem Abendessen ziehst du dich in dein Zimmer zurück, wo du einige Dokumente liest, die dir [ama] über Iron Fist geschickt hat."

# game/scripts/c24/c24.rpy:1446
translate german c24s003_NoKia_7c9e814b:

    # "Tienes que estar preparado para la reunión de mañana en el yate."
    "Sie müssen für das morgige Treffen auf der Yacht vorbereitet sein."

# game/scripts/c24/c24.rpy:1447
translate german c24s003_NoKia_14a02826:

    # "Es información muy aburrida y te quedas dormido mientras la lees."
    "Es sind sehr langweilige Informationen, und man schläft beim Lesen ein."

# game/scripts/c24/c24.rpy:1448
translate german c24s003_NoKia_479b95c0:

    # centered "{size=+20}{b}DÍA 26 – SÁBADO{/b}{/size}"
    centered "{size=+20}{b}TAG 26 – SAMSTAG{/b}{/size}"

# game/scripts/c24/c24.rpy:1450
translate german c24s003_NoKia_7e47640e:

    # "Te levantas muy tarde, casi a mediodía. Debías estar más cansado de lo que creías."
    "Du stehst sehr spät auf, fast erst mittags. Du musst müder gewesen sein, als du dachtest."

# game/scripts/c24/c24.rpy:1459
translate german c24s003_KiaDate_2237f21b:

    # "Subes a tu habitación a dejar tus cosas y lees unos documentos que [ama] te ha enviado sobre Iron Fist."
    "Du gehst in dein Zimmer, um deine Sachen wegzuräumen und liest einige Dokumente, die dir [ama] über Iron Fist geschickt hat."

# game/scripts/c24/c24.rpy:1460
translate german c24s003_KiaDate_7c9e814b:

    # "Tienes que estar preparado para la reunión de mañana en el yate."
    "Sie müssen für das morgige Treffen auf der Yacht vorbereitet sein."

# game/scripts/c24/c24.rpy:1461
translate german c24s003_KiaDate_06007255:

    # "Cuando se acerca la hora de tu cita, te das una ducha y te cambias. No sabes dónde vais a ir, con lo que eliges algo que pueda ir bien en casi cualquier sitio."
    "Je näher dein Date rückt, desto schneller gehst du duschen und ziehst dich an. Da du noch nicht weißt, wohin es geht, wählst du etwas, das fast überall passt."

# game/scripts/c24/c24.rpy:1464
translate german c24s003_KiaDate_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c24/c24.rpy:1465
translate german c24s003_KiaDate_93c9ba13:

    # kia "*A través de la puerta* Soy yo, ¿puedo pasar?"
    kia "*Durch die Tür* Ich bin's, darf ich hereinkommen?"

# game/scripts/c24/c24.rpy:1467
translate german c24s003_KiaDate_4d601f0e:

    # mc "Sí, pasa."
    mc "Ja, das kommt vor."

# game/scripts/c24/c24.rpy:1473
translate german c24s003_KiaDate_7cf199b5:

    # mc "¡Wow, [kia]! ¡Estás preciosa!"
    mc "Wow, [kia]! Du siehst umwerfend aus!"

# game/scripts/c24/c24.rpy:1474
translate german c24s003_KiaDate_0018e517:

    # kia "Gracias, [mc]. Tú también estás muy guapo."
    kia "Danke, [mc]. Du siehst auch sehr gut aus."

# game/scripts/c24/c24.rpy:1475
translate german c24s003_KiaDate_0ad25d4f:

    # kia "¿Estás preparado para irnos?"
    kia "Bist du bereit loszulegen?"

# game/scripts/c24/c24.rpy:1476
translate german c24s003_KiaDate_75d3cb24:

    # mc "Cuando tú quieras. ¿Dónde vamos a ir? ¿Voy bien así?"
    mc "Wann immer du willst. Wohin gehen wir? Ist es okay für mich so?"

# game/scripts/c24/c24.rpy:1478
translate german c24s003_KiaDate_8e87288a:

    # kia "Estás perfecto."
    kia "Du siehst perfekt aus."

# game/scripts/c24/c24.rpy:1479
translate german c24s003_KiaDate_85bd524c:

    # kia "Voy a ser la envidia de todas las mujeres."
    kia "Ich werde der Neid aller Frauen sein."

# game/scripts/c24/c24.rpy:1480
translate german c24s003_KiaDate_5ff2e895:

    # mc "Y a mí me van a envidiar todos los hombres vayamos donde vayamos."
    mc "Und alle Männer werden mich beneiden, wohin wir auch gehen."

# game/scripts/c24/c24.rpy:1482
translate german c24s003_KiaDate_bfcf7a77:

    # kia "*Risa* Van a pensar que sales a cenar con tu madre. Nada envidiable."
    kia "*Lacht* Die werden denken, du gehst mit deiner Mutter essen. Gar nicht beneidenswert."

# game/scripts/c24/c24.rpy:1485
translate german c24s003_KiaDate_4930ddd9:

    # kia "¡Oh! No me refería a [mar] y a ti. Hacéis una pareja perfecta."
    kia "Oh! Ich meinte nicht dich. Ihr zwei seid ein perfektes Paar."

# game/scripts/c24/c24.rpy:1486
translate german c24s003_KiaDate_1268706e:

    # mc "Ya lo sé. Entiendo a lo que te refieres y, aunque no seas mi madre, te aseguro que cualquier hombre querría estar en mi posición hoy."
    mc "Ich weiß. Ich verstehe, was du meinst, und auch wenn du nicht meine Mutter bist, versichere ich dir, dass jeder Mann heute gern an meiner Stelle wäre."

# game/scripts/c24/c24.rpy:1487
translate german c24s003_KiaDate_b8ec88c3:

    # mc "Si piensan que eres mi madre y que además estamos saliendo juntos, más hombres aún me van a envidiar. Ya sabes, fetiche con el incesto..." id c24s003_KiaDate_b8ec88c3
    mc "Wenn sie denken, du wärst meine Mutter und wir wären ein Paar, werden mich noch mehr Männer beneiden. Du weißt schon, Inzest-Fetisch..." id c24s003_KiaDate_b8ec88c3

# game/scripts/c24/c24.rpy:1488
translate german c24s003_KiaDate_5bb546fa:

    # mc "La mitad de los hombres del mundo darían lo que fuera por tener una madre como tú y poder hacer esto con ella."
    mc "Die Hälfte aller Männer auf der Welt würde alles dafür geben, eine Mutter wie dich zu haben und das mit ihr erleben zu können."

# game/scripts/c24/c24.rpy:1490
translate german c24s003_KiaDate_33452344:

    # "Sin dejarle reaccionar, la coges entre tus brazos y dejas que tus labios recorran los suyos."
    "Ohne ihr Zeit zum Reagieren zu geben, nimmst du sie in deine Arme und lässt deine Lippen ihre umspielen."

# game/scripts/c24/c24.rpy:1491
translate german c24s003_KiaDate_83561e84:

    # "Tras un segundo de sorpresa, la hermosa pelirroja entreabre su boca y deja que su lengua empiece a jugar con la tuya."
    "Nach einem kurzen Moment der Überraschung öffnet die schöne Rothaarige leicht ihren Mund und lässt ihre Zunge mit deiner spielen."

# game/scripts/c24/c24.rpy:1493
translate german c24s003_KiaDate_721bb120:

    # kia "¡Hey! ¡Para! Tenemos una reserva para cenar, y quiero una cena tranquila."
    kia "Hey! Halt! Wir haben eine Tischreservierung und ich möchte in Ruhe essen."

# game/scripts/c24/c24.rpy:1494
translate german c24s003_KiaDate_09d5b8a8:

    # mc "*Risa* ¿Te pones nerviosa cenando?"
    mc "*lacht* Werden Sie nervös, wenn Sie zu Abend essen?"

# game/scripts/c24/c24.rpy:1496
translate german c24s003_KiaDate_d620db7b:

    # kia "*Risa* No, idiota. Pero si empiezas así antes de que nos vayamos, no voy a poder pensar en otra cosa mientras cenamos."
    kia "*Lacht* Nein, Idiot. Aber wenn du schon so anfängst, bevor wir überhaupt losfahren, kann ich beim Abendessen an nichts anderes mehr denken."

# game/scripts/c24/c24.rpy:1497
translate german c24s003_KiaDate_0d0f8a07:

    # mc "Eres consciente de que, aunque estemos en un restaurante, podemos besarnos, ¿verdad?"
    mc "Du weißt doch, dass wir uns auch in einem Restaurant küssen können, oder?"

# game/scripts/c24/c24.rpy:1499
translate german c24s003_KiaDate_18057fc8:

    # kia "Sí, lo sé. Y seguramente te besaré. Pero no serán besos así."
    kia "Ja, ich weiß. Und ich werde dich wahrscheinlich küssen. Aber es werden keine Küsse dieser Art sein."

# game/scripts/c24/c24.rpy:1500
translate german c24s003_KiaDate_ce099bae:

    # kia "Nunca me han gustado las parejas que se enrollan en público. Son cosas que se tienen que hacer en la intimidad."
    kia "Ich mochte noch nie Paare, die in der Öffentlichkeit rumknutschen. Das sind Dinge, die man im Privaten tun sollte."

# game/scripts/c24/c24.rpy:1501
translate german c24s003_KiaDate_f2bcde51:

    # mc "Me parece bien. A mí nunca me han importado, pero si a ti no te gusta esperaré a disfrutar de tus labios."
    mc "Das ist mir recht. Es war mir immer egal, aber wenn es dir nicht gefällt, warte ich eben, bis ich deine Lippen genießen kann."

# game/scripts/c24/c24.rpy:1503
translate german c24s003_KiaDate_3be31b74:

    # kia "Tengo pensado pedir una ensalada de aguacate, con lo que espero que te siga gustando la combinación con mi pintalabios."
    kia "Ich bestelle mir einen Avocadosalat, deshalb hoffe ich, dass dir die Kombination mit meinem Lippenstift trotzdem gefällt."

# game/scripts/c24/c24.rpy:1504
translate german c24s003_KiaDate_8666bcd5:

    # mc "Me gustaría aunque no llevaras pintalabios. Aunque no comieras aguacate."
    mc "Es würde mir auch gefallen, wenn du keinen Lippenstift tragen würdest. Selbst wenn du keine Avocado essen würdest."

# game/scripts/c24/c24.rpy:1506
translate german c24s003_KiaDate_aafcc2ca:

    # kia "Entonces vámonos antes de que te tenga que volver a besar."
    kia "Dann lass uns gehen, bevor ich dich wieder küssen muss."

# game/scripts/c24/c24.rpy:1507
translate german c24s003_KiaDate_d2aa7bb0:

    # mc "Me tendrás que decir dónde vamos si tengo que conducir hasta allí. ¿O vamos a coger un Under?"
    mc "Du musst mir sagen, wohin wir fahren, wenn ich fahren muss. Oder setzen wir auf „Unter“?"

# game/scripts/c24/c24.rpy:1509
translate german c24s003_KiaDate_606649cc:

    # kia "Conduzco yo. Le he pedido el coche a [mar]. Vamos a un par de sitios donde coger un Under sería complicado."
    kia "Ich fahre. Ich habe mir das Auto von [mar] geliehen. Wir fahren an ein paar Orte, wo es schwierig wäre, einen Under zu bekommen."

# game/scripts/c24/c24.rpy:1510
translate german c24s003_KiaDate_d3f0e0fb:

    # mc "¡Oh! Eso quiere decir que no quieres revelar la sorpresa."
    mc "Oh! Das bedeutet, du willst die Überraschung nicht verraten."

# game/scripts/c24/c24.rpy:1512
translate german c24s003_KiaDate_4f1d7478:

    # kia "Exacto. Ya he dejado la bolsa y el bolso en el coche."
    kia "Genau. Ich habe meine Tasche und mein Portemonnaie bereits im Auto gelassen."

# game/scripts/c24/c24.rpy:1513
translate german c24s003_KiaDate_03682c61:

    # mc "¿Bolsa? ¿Para qué necesitas una bolsa?"
    mc "Eine Tasche? Wozu brauchst du eine Tasche?"

# game/scripts/c24/c24.rpy:1514
translate german c24s003_KiaDate_9171ef72:

    # kia "Esa es la segunda sorpresa de esta noche."
    kia "Das ist die zweite Überraschung des Abends."

# game/scripts/c24/c24.rpy:1516
translate german c24s003_KiaDate_050a880b:

    # "[kia] conduce durante 20 minutos antes de aparcar el coche en lo que parece una viejo edificio."
    "[kia] fährt 20 Minuten, bevor er den Wagen in einem Gebäude parkt, das wie ein altes aussieht."

# game/scripts/c24/c24.rpy:1517
translate german c24s003_KiaDate_36c8bdc3:

    # "Por alguna razón, acabas cargando con su bolso."
    "Aus irgendeinem Grund trägst du am Ende ihre Tasche."

# game/scripts/c24/c24.rpy:1519
translate german c24s003_KiaDate_5dc99045:

    # "Cuando entráis al restaurante está totalmente vacío. Es muy pronto para cenar."
    "Als ich das Restaurant betrat, war es völlig leer. Es war noch zu früh zum Abendessen."

# game/scripts/c24/c24.rpy:1520
translate german c24s003_KiaDate_3220c059:

    # kia "Ya hemos llegado. Creo que no debes conocer este sitio. Lo abrieron mientras estabas en Portland."
    kia "Wir sind da. Ich glaube, du warst noch nie hier. Es hat eröffnet, als du in Portland warst."

# game/scripts/c24/c24.rpy:1521
translate german c24s003_KiaDate_eb55958c:

    # kia "Y ninguna de las chicas lo conocía, con lo que seguramente no habrás venido nunca."
    kia "Und keines der Mädchen kannte ihn, also warst du wahrscheinlich noch nie hier."

# game/scripts/c24/c24.rpy:1522
translate german c24s003_KiaDate_44e12ef9:

    # mc "No, no he venido nunca. No sabía ni que habían hecho un restaurante en este viejo almacén."
    mc "Nein, ich war noch nie hier. Ich wusste gar nicht, dass sie dieses alte Lagerhaus in ein Restaurant umgewandelt hatten."

# game/scripts/c24/c24.rpy:1524
translate german c24s003_KiaDate_e57afa09:

    # kia "Las fotos de internet parecían muy bonitas y le hacen justicia. Espero que te guste."
    kia "Die Fotos, die ich online gefunden habe, sahen wirklich gut aus und geben es gut wieder. Ich hoffe, es gefällt dir."

# game/scripts/c24/c24.rpy:1525
translate german c24s003_KiaDate_e47f72b7:

    # mc "Me gustaría aunque fuera tu carrito de perritos calientes favorito."
    mc "Ich würde es sogar mögen, wenn es dein Lieblings-Hotdog-Wagen wäre."

# game/scripts/c24/c24.rpy:1526
translate german c24s003_KiaDate_94812cb4:

    # mc "Me importa estar aquí contigo. Me da lo mismo dónde sea 'aquí'."
    mc "Mir ist es wichtig, hier bei dir zu sein. Mir ist egal, wo „hier“ ist."

# game/scripts/c24/c24.rpy:1527
translate german c24s003_KiaDate_3e238f06:

    # mc "Pero es pronto para cenar, ¿no?"
    mc "Aber es ist noch zu früh fürs Abendessen, nicht wahr?"

# game/scripts/c24/c24.rpy:1529
translate german c24s003_KiaDate_5c661d6f:

    # kia "Quiero acabar de cenar pronto para llevarte a un sitio."
    kia "Ich möchte früh mit dem Abendessen fertig sein, damit ich dich irgendwohin mitnehmen kann."

# game/scripts/c24/c24.rpy:1530
translate german c24s003_KiaDate_5c4c9c2b:

    # mc "Eso suena interesante. ¿Es para ese sitio la bolsa?"
    mc "Das klingt interessant. Ist das die Börse für diese Website?"

# game/scripts/c24/c24.rpy:1531
translate german c24s003_KiaDate_91ddeff0:

    # kia "Sí, y no preguntes qué hay dentro."
    kia "Ja, und frag bloß nicht, was da drin ist."

# game/scripts/c24/c24.rpy:1532
translate german c24s003_KiaDate_b3621a01:

    # mc "*Risa* Estoy empezando a ponerme nervioso por esa sorpresa."
    mc "*Lacht* Ich werde langsam nervös wegen dieser Überraschung."

# game/scripts/c24/c24.rpy:1534
translate german c24s003_KiaDate_708aa274:

    # kia "No hace falta que te pongas nervioso. Es uno de mis lugares favoritos de Newport. E ir esta noche contigo me apetece mucho."
    kia "Du brauchst nicht nervös zu sein. Es ist einer meiner Lieblingsorte in Newport. Und ich würde wirklich gerne heute Abend mit dir dorthin gehen."

# game/scripts/c24/c24.rpy:1535
translate german c24s003_KiaDate_24fdb8f4:

    # mc "Entonces vamos a cenar. Casi tengo ganas de ir a ver tu sitio favorito."
    mc "Dann lass uns zu Abend essen. Ich hätte fast Lust, dein Lieblingsrestaurant zu besuchen."

# game/scripts/c24/c24.rpy:1538
translate german c24s003_KiaDate_77bca2e2:

    # wai "Buenas noches, perdón por la espera. ¿Tenían reserva?"
    wai "Guten Abend, entschuldigen Sie die Wartezeit. Hatten Sie eine Reservierung?"

# game/scripts/c24/c24.rpy:1539
translate german c24s003_KiaDate_9f4e6521:

    # kia "Sí, a nombre de [kia] Wellesley."
    kia "Ja, im Namen von Wellesley."

# game/scripts/c24/c24.rpy:1540
translate german c24s003_KiaDate_5b089228:

    # wai "Sí, acompáñeme, por favor."
    wai "Ja, bitte kommen Sie mit mir."

# game/scripts/c24/c24.rpy:1542
translate german c24s003_KiaDate_4c334347:

    # "La camarera os acompaña a la mesa y os entrega los menús."
    "Die Kellnerin begleitet Sie zum Tisch und überreicht Ihnen die Speisekarten."

# game/scripts/c24/c24.rpy:1543
translate german c24s003_KiaDate_8ca89980:

    # mc "¿Wellesley?"
    mc "Wellesley?"

# game/scripts/c24/c24.rpy:1544
translate german c24s003_KiaDate_e21185a8:

    # kia "Sí. No pienso usar nunca más el apellido Lamb, si puedo evitarlo. Quiero recuperar mi apellido de soltera."
    kia "Ja. Ich beabsichtige nicht, den Nachnamen Lamb jemals wieder zu verwenden, wenn ich es vermeiden kann. Ich möchte meinen Mädchennamen zurückerhalten."

# game/scripts/c24/c24.rpy:1545
translate german c24s003_KiaDate_79b41575:

    # mc "Me parece una gran idea. Creo que brindaré por ello en cuanto nos traigan el vino."
    mc "Das klingt nach einer tollen Idee. Ich glaube, ich werde darauf anstoßen, sobald wir den Wein bekommen."

# game/scripts/c24/c24.rpy:1547
translate german c24s003_KiaDate_47bed3e8:

    # kia "No voy a beber vino, [mc]. Hoy conduzco yo, y no quiero que la noche acabe con el coche de [mar] en la cuneta o nosotros detenidos."
    kia "Ich werde keinen Wein trinken, [mc]. Ich fahre heute Abend Auto und ich möchte nicht, dass der Abend damit endet, dass [mar]s Auto im Graben landet oder wir von der Polizei angehalten werden."

# game/scripts/c24/c24.rpy:1548
translate german c24s003_KiaDate_8871f35d:

    # kia "Pero tú puedes beber si quieres."
    kia "Aber du kannst trinken, wenn du willst."

# game/scripts/c24/c24.rpy:1549
translate german c24s003_KiaDate_2af4c5b6:

    # mc "No me apetece beber si no lo haces tú pero, si quieres, podemos pedir mosto. Veo que tienen en la carta. No es lo mismo, pero..."
    mc "Ich habe keinen Appetit, solange du nichts trinkst, aber wenn du möchtest, können wir Traubensaft bestellen. Ich sehe, er steht auf der Karte. Es ist nicht dasselbe, aber..."

# game/scripts/c24/c24.rpy:1551
translate german c24s003_KiaDate_1f8250a7:

    # kia "Nunca lo he probado. ¿Sabe a vino?"
    kia "Ich habe es noch nie probiert. Schmeckt es wie Wein?"

# game/scripts/c24/c24.rpy:1552
translate german c24s003_KiaDate_8aa61e12:

    # mc "No. *Risa* Es mucho más dulce. Básicamente es zumo de uva."
    mc "Nein. *lacht* Es ist viel süßer. Es ist im Grunde Traubensaft."

# game/scripts/c24/c24.rpy:1553
translate german c24s003_KiaDate_8eccb780:

    # kia "*Risa* Entonces sí que lo he probado. Bebía mucho zumo de uva cuando era niña. Me gustaba. Y voy a cambiar la ensalada por filete."
    kia "*lacht* Also, ich habe es probiert. Als Kind habe ich viel Traubensaft getrunken. Er hat mir geschmeckt. Und ich werde den Salat gegen Steak tauschen."

# game/scripts/c24/c24.rpy:1554
translate german c24s003_KiaDate_b63d19d6:

    # mc "Entonces no se hable más. Zumo de uva y filete para la señora. Echaré de menos el aguacate."
    mc "Dann ist es beschlossen. Traubensaft und Steak für die Dame. Ich werde die Avocado vermissen."

# game/scripts/c24/c24.rpy:1555
translate german c24s003_KiaDate_514b4ad6:

    # "Miras la carta durante un momento."
    "Du betrachtest den Brief einen Moment lang."

# game/scripts/c24/c24.rpy:1556
translate german c24s003_KiaDate_80a7d886:

    # mc "Y zumo de uva y pollo para mí."
    mc "Und Traubensaft und Hühnchen für mich."

# game/scripts/c24/c24.rpy:1558
translate german c24s003_KiaDate_22e872b3:

    # "Después de que la camarera os tome nota..."
    "Nachdem die Kellnerin Ihre Bestellung aufgenommen hat..."

# game/scripts/c24/c24.rpy:1559
translate german c24s003_KiaDate_ec2f9a24:

    # kia "Llevo desde el día que comimos juntos queriendo salir a cenar contigo."
    kia "Seit dem Tag, an dem wir zusammen zu Mittag gegessen haben, möchte ich unbedingt mit dir zum Abendessen ausgehen."

# game/scripts/c24/c24.rpy:1560
translate german c24s003_KiaDate_9e42db99:

    # mc "Han sido unos días muy ocupados. Siento que no haya podido ser antes."
    mc "Es waren sehr arbeitsreiche Tage. Es tut mir leid, dass es nicht früher möglich war."

# game/scripts/c24/c24.rpy:1561
translate german c24s003_KiaDate_5b3de040:

    # mc "¿Le has dicho a Geneviève que salimos a cenar? ¿Sigue pensando que me quiero aprovechar de ti?"
    mc "Hast du Geneviève gesagt, dass wir zum Abendessen ausgehen? Glaubt sie immer noch, ich versuche, dich auszunutzen?"

# game/scripts/c24/c24.rpy:1563
translate german c24s003_KiaDate_89718c77:

    # kia "No, al menos no me ha dicho nada más. Cuando te fuiste se disculpó por meterse donde no le llamaban."
    kia "Nein, zumindest hat er mir nichts mehr gesagt. Als du gegangen bist, hat er sich dafür entschuldigt, sich in Angelegenheiten eingemischt zu haben, die ihn nichts angingen."

# game/scripts/c24/c24.rpy:1564
translate german c24s003_KiaDate_70432cf4:

    # kia "Pero no hemos vuelto a hablar de ti."
    kia "Aber wir haben seitdem nicht mehr über dich gesprochen."

# game/scripts/c24/c24.rpy:1565
translate german c24s003_KiaDate_a9d6a22b:

    # mc "Cuando me fui pensé que quizás había sido un poco duro con ella. Solo estaba intentando cuidar de ti. Protegerte."
    mc "Als ich ging, dachte ich, ich wäre vielleicht etwas zu hart zu ihr gewesen. Ich wollte mich doch nur um dich kümmern. Dich beschützen."

# game/scripts/c24/c24.rpy:1567
translate german c24s003_KiaDate_3e5fbbb7:

    # kia "Sus intenciones eran buenas, [mc], pero la forma de hacerlo no."
    kia "Seine Absichten waren gut, [mc], aber die Art und Weise, wie er es tat, war es nicht."

# game/scripts/c24/c24.rpy:1568
translate german c24s003_KiaDate_7e77b0fb:

    # kia "No debería juzgarte sin conocerte. Y si te conociera..."
    kia "Ich sollte dich nicht verurteilen, ohne dich zu kennen. Und wenn ich dich kennen würde..."

# game/scripts/c24/c24.rpy:1571
translate german c24s003_KiaDate_7ff36164:

    # kia "*Risa* Si no estuviera recién casada y enamorada de su marido, habría que hacerle un hueco en el harén."
    kia "*Gelächter* Wenn sie nicht frisch verheiratet und in ihren Mann verliebt wäre, müssten wir Platz für sie im Harem schaffen."

# game/scripts/c24/c24.rpy:1573
translate german c24s003_KiaDate_58c340bc:

    # kia "*Risa* Si no estuviera recién casada y enamorada de su marido, seguramente me pediría compartirte."
    kia "*Lacht* Wenn sie nicht frisch verheiratet und verliebt in ihren Mann wäre, würde sie mich bestimmt bitten, dich mit ihr zu teilen."

# game/scripts/c24/c24.rpy:1574
translate german c24s003_KiaDate_4cb32db6:

    # kia "*Risa* Con lo que prefiero que no te conozca a fondo. Nos pasaríamos el día hablando de ti en la biblioteca."
    kia "*Lacht* Deshalb möchte ich dich lieber nicht so gut kennenlernen. Wir würden den ganzen Tag in der Bibliothek über dich reden."

# game/scripts/c24/c24.rpy:1575
translate german c24s003_KiaDate_5067e76e:

    # mc "*Risa* Lo dices como si las mujeres cayeran a mis pies a los cinco minutos de conocerme."
    mc "*Lacht* Du sagst das so, als würden mir die Frauen fünf Minuten nach dem Kennenlernen zu Füßen liegen."

# game/scripts/c24/c24.rpy:1577
translate german c24s003_KiaDate_e8271815:

    # kia "*Risa* Bueno, yo tardé cinco días viviendo en la misma casa. O en la de [nor] para ser más exactos."
    kia "*Lacht* Nun ja, ich habe fünf Tage gebraucht, um im selben Haus zu wohnen. Oder genauer gesagt, im Haus von [nor]."

# game/scripts/c24/c24.rpy:1578
translate german c24s003_KiaDate_13e7e7dc:

    # mc "Tú me conocías de antes. Sabías cómo era."
    mc "Du kanntest mich schon vorher. Du wusstest, wie ich bin."

# game/scripts/c24/c24.rpy:1580
translate german c24s003_KiaDate_edcd5283:

    # "La camarera interrumpe vuestra conversación trayendo vuestro pedido. Continuáis en cuanto se va."
    "Die Kellnerin unterbricht Ihr Gespräch, indem sie Ihre Bestellung bringt. Sobald sie weg ist, fahren Sie fort."

# game/scripts/c24/c24.rpy:1581
translate german c24s003_KiaDate_489d1cf1:

    # kia "Aunque te conociera de antes, nunca me hubiera planteado estar aquí contigo."
    kia "Selbst wenn ich dich vorher gekannt hätte, hätte ich mir nie vorstellen können, einmal hier mit dir zu sein."

# game/scripts/c24/c24.rpy:1582
translate german c24s003_KiaDate_ecaeda33:

    # kia "No, [mc]. No eres el mismo chico que conocí. Hay que ver el hombre en el que te has convertido para entender lo que siento."
    kia "Nein, [mc]. Du bist nicht mehr der Junge, den ich kannte. Du musst den Mann sehen, der du geworden bist, um zu verstehen, wie ich fühle."

# game/scripts/c24/c24.rpy:1583
translate german c24s003_KiaDate_b2516466:

    # mc "Gracias."
    mc "Danke schön."

# game/scripts/c24/c24.rpy:1585
translate german c24s003_KiaDate_7fb94f8f:

    # kia "Y no solo me refiero a cómo eres conmigo o a las dos veces que te enfrentaste a Solomon."
    kia "Und ich beziehe mich damit nicht nur auf dein Verhalten mir gegenüber oder auf die beiden Male, als du Salomo konfrontiert hast."

# game/scripts/c24/c24.rpy:1586
translate german c24s003_KiaDate_4cfeb268:

    # kia "Cómo trataste al Decano para defender a [mar]. Cómo solucionaste el tema con el antiguo novio de [eri]."
    kia "Wie sind Sie mit dem Dekan umgegangen, um [mar] zu verteidigen? Wie haben Sie das Problem mit [eri]s Ex-Freund gelöst?"

# game/scripts/c24/c24.rpy:1587
translate german c24s003_KiaDate_96302297:

    # kia "Cómo actuaste con el novio de la madre de [sca]. O cómo has solucionado lo de [bet]."
    kia "Wie haben Sie sich gegenüber dem Freund der Mutter von [sca] verhalten? Oder wie haben Sie die Situation mit [bet] gelöst?"

# game/scripts/c24/c24.rpy:1589
translate german c24s003_KiaDate_949b0c0b:

    # kia "Todo eso no lo hace un chico. Son cosas que hace un hombre que toma las riendas cuando debe."
    kia "Ein Junge tut so etwas nicht. Das sind Dinge, die ein Mann tut, wenn er die Verantwortung übernimmt."

# game/scripts/c24/c24.rpy:1590
translate german c24s003_KiaDate_baea7e73:

    # mc "*Risa* Me vas a hacer ruborizar."
    mc "*lacht* Du bringst mich noch zum Erröten."

# game/scripts/c24/c24.rpy:1591
translate german c24s003_KiaDate_31c784a3:

    # mc "No lo he hecho todo solo. [mar] ayudó mucho con el Decano. [eva] y [ama] con Solomon y Kevin..."
    mc "Ich habe das nicht alles allein geschafft. [mar] hat mir sehr bei Dean geholfen. [eva] und [ama] bei Solomon und Kevin..."

# game/scripts/c24/c24.rpy:1593
translate german c24s003_KiaDate_a795c765:

    # kia "A eso me refiero. No sólo haces lo que tienes que hacer. Nos das ejemplo a las demás y nos inspiras para que nosotras hagamos lo que debemos."
    kia "Genau das meine ich. Du tust nicht nur, was du tun musst. Du bist ein Vorbild für uns alle und inspirierst uns, das zu tun, was wir tun sollten."

# game/scripts/c24/c24.rpy:1594
translate german c24s003_KiaDate_532f5c8b:

    # mc "*Risa* ¡Joder, [kia]! Haces que parezca el líder de una secta."
    mc "*Lacht* Verdammt, [kia]! Du lässt mich wie den Anführer einer Sekte aussehen."

# game/scripts/c24/c24.rpy:1596
translate german c24s003_KiaDate_cee6e392:

    # kia "Mas o menos. *Risa* Has creado una familia de elección a tu alrededor."
    kia "Mehr oder weniger. *Lacht* Du hast dir eine Wahlfamilie um dich herum geschaffen."

# game/scripts/c24/c24.rpy:1598
translate german c24s003_KiaDate_976b3965:

    # kia "Y no me refiero solo a las mujeres que estamos contigo. No eres el líder de esa familia. Pero eres el centro."
    kia "Und ich meine damit nicht nur die Frauen, die bei dir sind. Du bist nicht das Oberhaupt dieser Familie. Aber du bist ihr Mittelpunkt."

# game/scripts/c24/c24.rpy:1600
translate german c24s003_KiaDate_fab6b4e0:

    # kia "Y aunque no seas el líder de esa familia, pero eres el centro..."
    kia "Und selbst wenn du nicht das Oberhaupt dieser Familie bist, bist du dennoch ihr Mittelpunkt..."

# game/scripts/c24/c24.rpy:1601
translate german c24s003_KiaDate_14d6182a:

    # kia "Eres el factor común para todas nosotras. De [kat] a [mee], pasando por mí o por [mar]."
    kia "Du bist der gemeinsame Faktor für uns alle. Von [kat] nach [mee], durch mich oder [mar] hindurch."

# game/scripts/c24/c24.rpy:1602
translate german c24s003_KiaDate_ef310305:

    # mc "¿[kat]? Ella ya iba a venir a casa antes de que yo volviera de la universidad."
    mc "[kat]? Sie war schon auf dem Heimweg, bevor ich von der Universität zurückkam."

# game/scripts/c24/c24.rpy:1604
translate german c24s003_KiaDate_be7cdbc8:

    # kia "Sí, pero antes de que llegaran las chicas ya habías creado el ambiente que hay ahora."
    kia "Ja, aber bevor die Mädchen ankamen, hatten Sie bereits die Atmosphäre geschaffen, die jetzt herrscht."

# game/scripts/c24/c24.rpy:1605
translate german c24s003_KiaDate_3424a685:

    # kia "Sólo con la familia cercana, pero suficiente para que fuera fácil que ellas se sumaran. Después nos hemos sumado el resto."
    kia "Es begann im engsten Familienkreis, aber das reichte aus, um es ihnen leicht zu machen, mitzumachen. Dann schlossen wir uns alle an."

# game/scripts/c24/c24.rpy:1606
translate german c24s003_KiaDate_e0583063:

    # mc "No hice nada de eso, [kia]. Me encanta que me veas así, pero no me puedo otorgar el mérito."
    mc "Ich habe nichts davon getan, [kia]. Ich freue mich, dass du mich so siehst, aber ich kann mir das nicht anrechnen."

# game/scripts/c24/c24.rpy:1607
translate german c24s003_KiaDate_3391d298:

    # mc "Además, estamos hablando mucho de la familia y poco de nosotros."
    mc "Darüber hinaus reden wir viel über die Familie und sehr wenig über uns selbst."

# game/scripts/c24/c24.rpy:1609
translate german c24s003_KiaDate_320e7130:

    # kia "Me da un poco de miedo hablar de nosotros. Hablar de ello lo hace demasiado real."
    kia "Ich habe ein bisschen Angst, über uns zu sprechen. Wenn ich darüber rede, wird alles nur allzu real."

# game/scripts/c24/c24.rpy:1610
translate german c24s003_KiaDate_7987df6b:

    # mc "¿Es por Solomon? ¿Porque aún sigues casada con él?"
    mc "Liegt es an Salomo? Weil du noch mit ihm verheiratet bist?"

# game/scripts/c24/c24.rpy:1612
translate german c24s003_KiaDate_eba57e1f:

    # kia "En parte sí. Pese a que soy católica, no soy de esas que rechaza el divorcio, pero él sí. Nunca me lo va a dar."
    kia "Teilweise ja. Obwohl ich katholisch bin, gehöre ich nicht zu denen, die die Scheidung ablehnen, er aber schon. Er wird sie mir niemals geben."

# game/scripts/c24/c24.rpy:1614
translate german c24s003_KiaDate_ecbea4c6:

    # kia "Y aunque me lo diera, tú y yo no nos vamos a poder casar nunca."
    kia "Und selbst wenn er es mir geben würde, werden wir beide niemals heiraten können."

# game/scripts/c24/c24.rpy:1615
translate german c24s003_KiaDate_44b2af23:

    # kia "No sería justo que sólo una de nosotras se pudiera casar contigo, con lo que lo hemos hablado entre nosotras y ninguna va a aceptar casarse contigo."
    kia "Es wäre nicht fair, wenn nur eine von uns dich heiraten könnte, deshalb haben wir untereinander darüber gesprochen und keine von uns wird zustimmen, dich zu heiraten."

# game/scripts/c24/c24.rpy:1617
translate german c24s003_KiaDate_a7ce1239:

    # kia "Y eso hace que tú y yo no nos vayamos a casar nunca."
    kia "Und das bedeutet, dass du und ich niemals heiraten werden."

# game/scripts/c24/c24.rpy:1618
translate german c24s003_KiaDate_18a88386:

    # mc "Se puede vivir una vida muy feliz sin estar casados, [kia]."
    mc "Man kann auch ohne Heirat ein sehr glückliches Leben führen, [kia]."

# game/scripts/c24/c24.rpy:1620
translate german c24s003_KiaDate_93e42b6c:

    # kia "Lo sé, pero me educaron para casarme con el hombre de mi vida. Creí que era Solomon y resultó no serlo."
    kia "Ich weiß, aber ich wurde so erzogen, dass ich den Mann meiner Träume heiraten würde. Ich dachte, es wäre Salomo, aber es stellte sich heraus, dass es nicht so war."

# game/scripts/c24/c24.rpy:1621
translate german c24s003_KiaDate_fd166dc8:

    # kia "Y si al final lo eres tú, no podremos hacerlo."
    kia "Und falls du es bist, können wir es nicht tun."

# game/scripts/c24/c24.rpy:1623
translate german c24s003_KiaDate_04a0ca8e:

    # kia "No voy a decir que me entristezca tener una relación contigo sin estar casados, pero..."
    kia "Ich will nicht sagen, dass ich traurig darüber bin, mit dir in einer Beziehung zu sein, ohne verheiratet zu sein, aber..."

# game/scripts/c24/c24.rpy:1624
translate german c24s003_KiaDate_8d55fe6c:

    # mc "Te entiendo. Pero tiene difícil solución."
    mc "Ich verstehe. Aber es ist ein schwieriges Problem."

# game/scripts/c24/c24.rpy:1625
translate german c24s003_KiaDate_d912836c:

    # kia "Lo sé. Pero hablemos de cosas más alegres."
    kia "Ich weiß. Aber lasst uns über erfreulichere Dinge reden."

# game/scripts/c24/c24.rpy:1627
translate german c24s003_KiaDate_34ea56d4:

    # kia "[bet] me ha explicado lo que has hecho con la Iglesia en Monterey."
    kia "[bet] hat mir erklärt, was Sie mit der Kirche in Monterey gemacht haben."

# game/scripts/c24/c24.rpy:1628
translate german c24s003_KiaDate_6753da62:

    # mc "*Risa* Tenías que haber visto la cara del pobre cura al final."
    mc "*lacht* Du hättest das Gesicht des armen Priesters am Ende sehen sollen."

# game/scripts/c24/c24.rpy:1629
translate german c24s003_KiaDate_a2e76ea8:

    # kia "Soy católica, pero no me gustan muchas de las cosas que hace la Iglesia."
    kia "Ich bin katholisch, aber mir gefallen viele Dinge nicht, die die Kirche tut."

# game/scripts/c24/c24.rpy:1630
translate german c24s003_KiaDate_e94bfd37:

    # "Empiezas a explicarle cómo ha ido la reunión. Ella ya lo sabe porque se lo ha explicado [bet], pero te escucha atentamente."
    "Du beginnst ihr zu erklären, wie das Treffen verlaufen ist. Sie weiß es bereits, weil du es ihr erklärt hast, aber sie hört aufmerksam zu."

# game/scripts/c24/c24.rpy:1631
translate german c24s003_KiaDate_3a324a98:

    # "Disfrutando del cambio de conversación."
    "Mir gefällt der Themenwechsel."

# game/scripts/c24/c24.rpy:1633
translate german c24s003_KiaDate_18f9417f:

    # "Cuando estás llegando al final de la explicación entra un grupo de ruidosos chicos, algo mayores que tú."
    "Gerade als du fast am Ende deiner Erklärung angelangt bist, betritt eine Gruppe lärmender Jungen, die etwas älter sind als du, den Raum."

# game/scripts/c24/c24.rpy:1634
translate german c24s003_KiaDate_66f128d6:

    # "Todos se quedan mirando a [kia], que brilla como una estrella en el casi vacío restaurante."
    "Alle Blicke richten sich auf [kia], der in dem fast leeren Restaurant wie ein Stern strahlt."

# game/scripts/c24/c24.rpy:1636
translate german c24s003_KiaDate_ea867ee3:

    # "[kia] se da cuenta de sus miradas y baja la suya."
    "[kia] bemerkt ihre Blicke und senkt seinen Blick."

# game/scripts/c24/c24.rpy:1637
translate german c24s003_KiaDate_2a7c7656:

    # mc "Te he dicho que sería la envidia del restaurante."
    mc "Ich hab's dir ja gesagt, ich wäre der Neid des ganzen Restaurants."

# game/scripts/c24/c24.rpy:1638
translate german c24s003_KiaDate_99b16475:

    # kia "No estoy acostumbrada..."
    kia "Ich bin es nicht gewohnt..."

# game/scripts/c24/c24.rpy:1639
translate german c24s003_KiaDate_87be2d7e:

    # mc "Estoy seguro de que los chicos del instituto te miran igual en la biblioteca que esos de ahí."
    mc "Ich bin mir sicher, dass die Highschool-Schüler dich in der Bibliothek genauso ansehen wie die Jungs da drüben."

# game/scripts/c24/c24.rpy:1641
translate german c24s003_KiaDate_bda69feb:

    # kia "¡Qué va! Miran a Gen. Es mucho más joven que yo."
    kia "Auf keinen Fall! Die schauen sich Gen an. Er ist viel jünger als ich."

# game/scripts/c24/c24.rpy:1642
translate german c24s003_KiaDate_16a2e00a:

    # mc "Puede que sea más joven, pero no te cambiaría por dos Genevièves. Ni siquiera para hacer un trío con ellas dos."
    mc "Sie mag jünger sein, aber ich würde dich nicht gegen zwei Genevièves tauschen. Nicht mal für einen Dreier mit ihnen."

# game/scripts/c24/c24.rpy:1643
translate german c24s003_KiaDate_5c527e8d:

    # mc "Ella es mona. Tú eres preciosa."
    mc "Sie ist süß. Du bist wunderschön."

# game/scripts/c24/c24.rpy:1645
translate german c24s003_KiaDate_e3c79d87:

    # kia "Ellos no deben pensar lo mismo. Nunca me han mirado, y no es que me importe. Casi lo prefiero."
    kia "Sie denken nicht so. Sie haben mich noch nie beachtet, und das ist mir auch egal. Mir ist es fast so lieber."

# game/scripts/c24/c24.rpy:1646
translate german c24s003_KiaDate_e03cdab1:

    # mc "Geneviève va maquillada al trabajo. Cada vez que te he visto ir a la biblioteca, excepto el día que quedamos para comer, ibas sin maquillaje."
    mc "Geneviève trägt Make-up zur Arbeit. Jedes Mal, wenn ich dich in der Bibliothek gesehen habe, außer an dem Tag, als wir uns zum Mittagessen getroffen haben, warst du ungeschminkt."

# game/scripts/c24/c24.rpy:1647
translate german c24s003_KiaDate_7d344cf0:

    # mc "Y no quiero decir que lo necesites para estar preciosa. Pero en igualdad de condiciones, estoy seguro de que nadie miraría a Geneviève."
    mc "Ich will damit nicht sagen, dass man schön aussehen muss. Aber unter sonst gleichen Bedingungen würde wohl niemand Geneviève ansehen."

# game/scripts/c24/c24.rpy:1649
translate german c24s003_KiaDate_4db88899:

    # kia "*Risita* Ahora voy maquillada todos los días. Por si decides pasarte por la biblioteca. Sé que te gusta." id c24s003_KiaDate_4db88899
    kia "*Kichert* Ich trage jetzt jeden Tag Make-up. Nur für den Fall, dass du mal in der Bibliothek vorbeischaust. Ich weiß, es gefällt dir." id c24s003_KiaDate_4db88899

# game/scripts/c24/c24.rpy:1650
translate german c24s003_KiaDate_4c98d145:

    # mc "Tendré que hacerlo más a menudo. Aunque solo sea para hacer esto."
    mc "Ich muss das öfter tun. Schon allein deshalb."

# game/scripts/c24/c24.rpy:1654
translate german c24s003_KiaDate_32860475:

    # "La besas sin avisarla. Lo que empieza como un dulce beso, acaba como el beso que os habéis dado en la habitación."
    "Du küsst sie ohne Vorwarnung. Was als zärtlicher Kuss beginnt, endet wie der Kuss, den ihr im Zimmer ausgetauscht habt."

# game/scripts/c24/c24.rpy:1655
translate german c24s003_KiaDate_29306c14:

    # "No puedes evitar desear abrir los ojos para ver la cara de los ruidosos chicos cuando oyes sus sonidos de sorpresa."
    "Man kann nicht anders, als die Augen öffnen zu wollen, um die Gesichter der lärmenden Jungen zu sehen, wenn man ihre überraschten Laute hört."

# game/scripts/c24/c24.rpy:1656
translate german c24s003_KiaDate_327ef64d:

    # "Pero después del primer segundo, no existen para ti. Tan solo existen vuestros labios y vuestras lenguas rozándose y jugando."
    "Doch nach der ersten Sekunde hören sie für dich auf zu existieren. Nur noch deine Lippen und Zungen existieren, die sich berühren und miteinander spielen."

# game/scripts/c24/c24.rpy:1657
translate german c24s003_KiaDate_5e918d8d:

    # "Escribiendo con saliva una carta de amor."
    "Einen Liebesbrief mit Speichel schreiben."

# game/scripts/c24/c24.rpy:1659
translate german c24s003_KiaDate_c46855bc:

    # mc "Creía que no te gustaban las parejas que se enrollan en público."
    mc "Ich dachte, du magst keine Paare, die in der Öffentlichkeit rumknutschen."

# game/scripts/c24/c24.rpy:1660
translate german c24s003_KiaDate_1f661852:

    # kia "Y no me gustan, pero no sé si has oído al grupo de chicos. Se han sorprendido cuando me has besado."
    kia "Und ich mag sie nicht, aber ich weiß nicht, ob du die Jungs gehört hast. Sie waren überrascht, als du mich geküsst hast."

# game/scripts/c24/c24.rpy:1661
translate german c24s003_KiaDate_65f9676b:

    # mc "Sí..."
    mc "Ja..."

# game/scripts/c24/c24.rpy:1663
translate german c24s003_KiaDate_eadb2922:

    # kia "Pues me ha encantado ese sonido."
    kia "Mir gefiel dieser Klang sehr."

# game/scripts/c24/c24.rpy:1664
translate german c24s003_KiaDate_961be510:

    # mc "*Risa* Por mí pueden sorprenderse todo lo que quieran. Soy el tío más afortunado en el restaurante."
    mc "*Lacht* Die können sich ruhig wundern. Ich bin der glücklichste Kerl im ganzen Restaurant."

# game/scripts/c24/c24.rpy:1665
translate german c24s003_KiaDate_2e8f6f7b:

    # mc "En el mundo."
    mc "In der Welt."

# game/scripts/c24/c24.rpy:1667
translate german c24s003_KiaDate_dbb63d53:

    # kia "Además de eso..."
    kia "Abgesehen davon..."

# game/scripts/c24/c24.rpy:1668
translate german c24s003_KiaDate_a3db9a7f:

    # mc "¿Qué?"
    mc "Das?"

# game/scripts/c24/c24.rpy:1669
translate german c24s003_KiaDate_b22ca392:

    # kia "Hoy he entendido por primera vez a esas parejas. Me daba lo mismo que estuviéramos en público. Era como si sólo existiéramos tú y yo."
    kia "Heute habe ich diese Paare endlich verstanden. Es war mir egal, dass wir in der Öffentlichkeit waren. Es war, als ob nur du und ich existierten."

# game/scripts/c24/c24.rpy:1670
translate german c24s003_KiaDate_a2ab25f7:

    # mc "Es que solo existimos tú y yo, cielo."
    mc "Nur du und ich, Schatz."

# game/scripts/c24/c24.rpy:1672
translate german c24s003_KiaDate_de836a6e:

    # "Vuelves a besarla para demostrárselo."
    "Du küsst sie erneut, um es ihr zu zeigen."

# game/scripts/c24/c24.rpy:1673
translate german c24s003_KiaDate_dc92a470:

    # "Vuelve a besarte para decirte que está de acuerdo."
    "Er küsst dich erneut, um dir zu zeigen, dass er zustimmt."

# game/scripts/c24/c24.rpy:1674
translate german c24s003_KiaDate_23adfe77:

    # "Esta vez no escucháis sonidos de sorpresa. No hay nadie para emitirlos."
    "Diesmal hört man keine Überraschungslaute. Niemand ist da, der sie hervorrufen könnte."

# game/scripts/c24/c24.rpy:1676
translate german c24s003_KiaDate_a23cf46f:

    # kia "Necesito beber algo... y recuperar el aliento."
    kia "Ich muss etwas trinken... und wieder zu Atem kommen."

# game/scripts/c24/c24.rpy:1677
translate german c24s003_KiaDate_319ec1d2:

    # mc "La combinación del filete con tu pintalabios también está deliciosa."
    mc "Die Kombination von Steak und Lippenstift ist auch köstlich."

# game/scripts/c24/c24.rpy:1678
translate german c24s003_KiaDate_be8e3a1f:

    # mc "Ahora me gustaría probarla con el mosto."
    mc "Jetzt möchte ich es mit dem Most ausprobieren."

# game/scripts/c24/c24.rpy:1680
translate german c24s003_KiaDate_1033a2cc:

    # "[kia] bebe un largo sorbo de mosto mientras aparta la mirada. Esperas que acabe para volver a besarla."
    "[kia] Sie nimmt einen langen Schluck Traubensaft und schaut dabei weg. Du wartest, bis sie ausgetrunken hat, damit du sie erneut küssen kannst."

# game/scripts/c24/c24.rpy:1682
translate german c24s003_KiaDate_b838b453:

    # kia "Creo que deberíamos dejar los besos para después. O se nos va a hacer tarde para ir donde te quiero llevar."
    kia "Ich denke, wir sollten das Küssen auf später verschieben. Sonst kommen wir zu spät an dem Ort an, wo ich dich hinbringen möchte."

# game/scripts/c24/c24.rpy:1683
translate german c24s003_KiaDate_f3a3e63d:

    # kia "Allí podremos besarnos todo lo que quieras. No hay nadie nunca."
    kia "Dort können wir uns so viel küssen, wie wir wollen. Es ist nie jemand da."

# game/scripts/c24/c24.rpy:1684
translate german c24s003_KiaDate_86071e2e:

    # mc "¿Pido la cuenta entonces?"
    mc "Soll ich dann nach der Rechnung fragen?"

# game/scripts/c24/c24.rpy:1686
translate german c24s003_KiaDate_eb1388a2:

    # kia "*Risa* ¿Tan ansioso estás? ¿No quieres postre?"
    kia "*lacht* Bist du so nervös? Willst du denn keinen Nachtisch?"

# game/scripts/c24/c24.rpy:1687
translate german c24s003_KiaDate_d117af68:

    # mc "Voy a sonar cursi, pero acabo de besar los labios más dulces. Cualquier postre me sabrá soso."
    mc "Ich weiß, es klingt kitschig, aber ich habe gerade die süßesten Lippen geküsst. Jedes Dessert wird mir jetzt fade schmecken."

# game/scripts/c24/c24.rpy:1689
translate german c24s003_KiaDate_767fc431:

    # kia "*Risa* Pues sí, has sonado cursi. Pero me encanta."
    kia "*Lacht* Ja, das klang kitschig. Aber ich liebe es."

# game/scripts/c24/c24.rpy:1690
translate german c24s003_KiaDate_3957492e:

    # kia "Pide la cuenta mientras voy al lavabo. Seguro que me tengo que retocar el pintalabios."
    kia "Bitten Sie um die Rechnung, während ich auf die Toilette gehe. Ich muss bestimmt meinen Lippenstift nachziehen."

# game/scripts/c24/c24.rpy:1692
translate german c24s003_KiaDate_ff456594:

    # kia "No pagues. Hoy me toca a mí."
    kia "Nicht bezahlen. Ich bin heute dran."

# game/scripts/c24/c24.rpy:1693
translate german c24s003_KiaDate_8aa83788:

    # mc "Pero..."
    mc "Aber..."

# game/scripts/c24/c24.rpy:1695
translate german c24s003_KiaDate_a4273a91:

    # "La preciosa bibliotecaria te da un suave beso indicando que no empieces una discusión que no vas a ganar."
    "Die nette Bibliothekarin gibt dir einen sanften Kuss, um dir zu signalisieren, dass du keinen Streit anfangen solltest, den du sowieso nicht gewinnen wirst."

# game/scripts/c24/c24.rpy:1697
translate german c24s003_KiaDate_31a63462:

    # "Pides la cuenta y te das cuenta de que el restaurante sigue medio vacío. Aunque hayáis acabado de cenar, sigue siendo pronto."
    "Sie bitten um die Rechnung und stellen fest, dass das Restaurant noch halb leer ist. Obwohl Sie bereits gegessen haben, ist es noch früh."

# game/scripts/c24/c24.rpy:1698
translate german c24s003_KiaDate_e9534601:

    # "Siempre te ha gustado hacer figuritas con la capa de estaño que protege el corcho."
    "Du hast es immer gemocht, kleine Figuren aus der Zinnschicht zu basteln, die den Korken schützt."

# game/scripts/c24/c24.rpy:1699
translate german c24s003_KiaDate_1d6014e1:

    # "Empiezas a juguetear con la cápsula del mosto mientras tu mente divaga, pensando en la conversación que habéis tenido."
    "Du beginnst, an der Musselkuppe herumzuspielen, während deine Gedanken abschweifen und du über das Gespräch nachdenkst, das ihr geführt habt."

# game/scripts/c24/c24.rpy:1700
translate german c24s003_KiaDate_0a131c61:

    # "La camarera trae la cuenta al mismo tiempo que [kia] vuelve del lavabo."
    "Die Kellnerin bringt die Rechnung, genau in dem Moment, als [kia] von der Toilette zurückkommt."

# game/scripts/c24/c24.rpy:1702
translate german c24s003_KiaDate_95755e39:

    # "Cuando vuelve [kia]..."
    "Wenn [kia] zurückkehrt..."

# game/scripts/c24/c24.rpy:1703
translate german c24s003_KiaDate_1ec91d72:

    # wai "¿Estaba todo a su gusto?"
    wai "Hat Ihnen alles gefallen?"

# game/scripts/c24/c24.rpy:1704
translate german c24s003_KiaDate_cfcef8ad:

    # mc "Sí, todo perfecto."
    mc "Ja, alles ist perfekt."

# game/scripts/c24/c24.rpy:1705
translate german c24s003_KiaDate_7965fbc1:

    # kia "Un sitio muy bonito y con una calidad excelente. Volveremos."
    kia "Ein wunderschöner Ort mit hervorragender Qualität. Wir kommen wieder."

# game/scripts/c24/c24.rpy:1707
translate german c24s003_KiaDate_6ec69178:

    # "Después de que [kia] pague la cuenta, una vez en el coche..."
    "Nachdem [kia] die Rechnung bezahlt hat, sobald er im Auto sitzt..."

# game/scripts/c24/c24.rpy:1708
translate german c24s003_KiaDate_55c4ae5e:

    # mc "¿Siguiente parada?"
    mc "Nächster Halt?"

# game/scripts/c24/c24.rpy:1709
translate german c24s003_KiaDate_cf0aee0d:

    # kia "Ahí es donde está la sorpresa."
    kia "Genau darin liegt die Überraschung."

# game/scripts/c24/c24.rpy:1710
translate german c24s003_KiaDate_35bb01ce:

    # mc "Tenía que intentarlo."
    mc "Ich musste es versuchen."

# game/scripts/c24/c24.rpy:1712
translate german c24s003_KiaDate_5e17a1ec:

    # kia "Aunque me gustaría explicártelo, no lo podrías entender hasta que lo vieras, con lo que prefiero llevarte allí."
    kia "Obwohl ich es Ihnen gerne erklären würde, würden Sie es erst verstehen, wenn Sie es selbst gesehen hätten, deshalb ziehe ich es vor, Sie dorthin mitzunehmen."

# game/scripts/c24/c24.rpy:1713
translate german c24s003_KiaDate_3937d899:

    # mc "Cada vez estás más misteriosa. *Risa*"
    mc "Du wirst immer geheimnisvoller. *lacht*"

# game/scripts/c24/c24.rpy:1714
translate german c24s003_KiaDate_bbf64fe2:

    # kia "Allí te explicaré por qué me gusta ese sitio. Pero nos tenemos que ir ya o no llegaremos a tiempo."
    kia "Ich werde dir dort erklären, warum mir dieser Ort so gut gefällt. Aber wir müssen jetzt los, sonst schaffen wir es nicht rechtzeitig."

# game/scripts/c24/c24.rpy:1716
translate german c24s003_KiaDate_eb706e74:

    # mc "Entonces vamos. Quiero saberlo todo de ti."
    mc "Dann los. Ich möchte alles über dich wissen."

# game/scripts/c24/c24.rpy:1726
translate german c24s003_KiaBeach_c321fe03:

    # "[kia] conduce diez minutos por una carretera estrecha hasta llegar a un camino sin asfaltar cerca del mar, donde aparca el coche."
    "[kia] Er fährt zehn Minuten lang eine schmale Straße entlang, bis er einen unbefestigten Weg in der Nähe des Meeres erreicht, wo er das Auto parkt."

# game/scripts/c24/c24.rpy:1727
translate german c24s003_KiaBeach_b0d89349:

    # "Ella coge su bolso y te toca cargar con la bolsa del maletero."
    "Sie schnappt sich ihre Tasche und du musst die Tasche aus dem Kofferraum tragen."

# game/scripts/c24/c24.rpy:1728
translate german c24s003_KiaBeach_e1a61012:

    # mc "¿Aquí? ¿En medio de la nada?"
    mc "Hier? Mitten im Nirgendwo?"

# game/scripts/c24/c24.rpy:1729
translate german c24s003_KiaBeach_adb64eac:

    # kia "*Risa* No, tenemos que caminar un par de minutos."
    kia "*Lacht* Nein, wir müssen noch ein paar Minuten laufen."

# game/scripts/c24/c24.rpy:1730
translate german c24s003_KiaBeach_42b7ae76:

    # mc "Déjame llevar la bolsa."
    mc "Ich trage die Tasche."

# game/scripts/c24/c24.rpy:1731
translate german c24s003_KiaBeach_0589cccb:

    # kia "Vale, pero no la abras."
    kia "Okay, aber öffne es nicht."

# game/scripts/c24/c24.rpy:1732
translate german c24s003_KiaBeach_6882bb03:

    # "Más misterios."
    "Weitere Geheimnisse."

# game/scripts/c24/c24.rpy:1734
translate german c24s003_KiaBeach_d153e3b3:

    # "Tras dos minutos andando por el camino de tierra, puedes ver el que supones que es el lugar al que [kia] se refería."
    "Nach zwei Minuten Fußweg auf dem unbefestigten Weg können Sie den Ort sehen, von dem [kia] vermutlich sprach."

# game/scripts/c24/c24.rpy:1735
translate german c24s003_KiaBeach_5ce76cd8:

    # "Con el tiempo perfectamente medido, llegáis cuando el cielo empieza a teñirse de naranja con la puesta de sol."
    "Durch die perfekt abgestimmte Zeitangabe kommen Sie genau dann an, wenn der Himmel sich mit dem Sonnenuntergang orange färbt."

# game/scripts/c24/c24.rpy:1737
translate german c24s003_KiaBeach_5bcc7d86:

    # mc "¡Es precioso! No había estado nunca aquí."
    mc "Es ist wunderschön! Ich war noch nie zuvor hier."

# game/scripts/c24/c24.rpy:1738
translate german c24s003_KiaBeach_17ca26fa:

    # kia "Está escondido. Lo descubrí un día mirando mapas en internet. Marcaba que había un mirador y decidí venir a verlo."
    kia "Es liegt versteckt. Ich habe es eines Tages beim Online-Kartenstudium entdeckt. Es war als Aussichtspunkt eingezeichnet, also beschloss ich, es mir anzusehen."

# game/scripts/c24/c24.rpy:1739
translate german c24s003_KiaBeach_c365e15c:

    # kia "Me gustó el sitio el primer día que vine. Me enamoré de él la primera vez que vine a ver la puesta de sol."
    kia "Mir gefiel der Ort schon am ersten Tag. Ich habe mich sofort in ihn verliebt, als ich das erste Mal den Sonnenuntergang dort erlebte."

# game/scripts/c24/c24.rpy:1740
translate german c24s003_KiaBeach_3e0e061e:

    # kia "Hoy la marea está baja y es menos espectacular, pero sigue siendo muy bonito."
    kia "Heute ist Ebbe und es ist weniger spektakulär, aber trotzdem sehr schön."

# game/scripts/c24/c24.rpy:1741
translate german c24s003_KiaBeach_2eaf27bc:

    # kia "Vamos a aquella punta y déjame sacar una cosa de la bolsa."
    kia "Kommen wir zu diesem Punkt und lassen Sie mich etwas aus der Tasche holen."

# game/scripts/c24/c24.rpy:1743
translate german c24s003_KiaBeach_a87881f2:

    # "Siendo una mujer previsora, ha traído una manta de picnic, en la que se sienta tras extenderla."
    "Da sie eine Frau ist, die vorausplant, hat sie eine Picknickdecke mitgebracht, auf der sie sich nach dem Ausbreiten hinsetzt."

# game/scripts/c24/c24.rpy:1744
translate german c24s003_KiaBeach_d9cb06de:

    # mc "Hay un banco justo ahí detrás..."
    mc "Dort hinten ist eine Bank..."

# game/scripts/c24/c24.rpy:1745
translate german c24s003_KiaBeach_447b9601:

    # kia "*Risa* Siempre está lleno de cacas de gaviota. Por eso vengo con la manta."
    kia "*Lacht* Es ist immer voller Möwenkot. Deshalb bringe ich eine Decke mit."

# game/scripts/c24/c24.rpy:1746
translate german c24s003_KiaBeach_f978bbdc:

    # mc "*Risa* Ni me había fijado. Me hubiera llevado un montón de cacas a casa pegadas en los pantalones."
    mc "*Lacht* Das hatte ich gar nicht bemerkt. Ich hätte mir bestimmt einen Haufen Kot an die Hose geklebt und wäre dann mit nach Hause gekommen."

# game/scripts/c24/c24.rpy:1748
translate german c24s003_KiaBeach_3c569df0:

    # "Te tumbas a su lado. Mirarla desde abajo, por una vez, te da una perspectiva diferente de su belleza."
    "Du legst dich neben sie. Sie von unten zu betrachten, eröffnet dir ausnahmsweise eine ganz andere Perspektive auf ihre Schönheit."

# game/scripts/c24/c24.rpy:1749
translate german c24s003_KiaBeach_24dafdd2:

    # kia "*Risa* Por suerte vienes con una mujer previsora."
    kia "*Lacht* Zum Glück bist du mit einer Frau zusammen, die vorausplant."

# game/scripts/c24/c24.rpy:1750
translate german c24s003_KiaBeach_728c6dcc:

    # mc "Una mujer que me tiene que explicar la historia de este sitio para ella, aparte de encontrarlo en un mapa por casualidad."
    mc "Eine Frau, die mir die Geschichte dieses Ortes erklären muss, anstatt ihn nur zufällig auf einer Karte zu finden."

# game/scripts/c24/c24.rpy:1752
translate german c24s003_KiaBeach_a7c3bcd5:

    # kia "No es una historia alegre..."
    kia "Das ist keine schöne Geschichte..."

# game/scripts/c24/c24.rpy:1753
translate german c24s003_KiaBeach_03418fd9:

    # mc "Pero es tu historia. Quiero escucharla."
    mc "Aber es ist deine Geschichte. Ich möchte sie hören."

# game/scripts/c24/c24.rpy:1755
translate german c24s003_KiaBeach_1c484da6:

    # kia "Lo descubrí el verano de hace seis años. Unos meses antes de que [eil.nick] y tú empezarais a salir."
    kia "Ich habe ihn vor sechs Jahren im Sommer entdeckt. Ein paar Monate bevor du und [eil.nick] angefangen habt, euch zu treffen."

# game/scripts/c24/c24.rpy:1756
translate german c24s003_KiaBeach_714a706b:

    # kia "Ella se fue dos semanas a un campamento de animadoras y estaba en casa sola con Solomon."
    kia "Sie fuhr für zwei Wochen in ein Cheerleading-Camp und war mit Solomon allein zu Hause."

# game/scripts/c24/c24.rpy:1757
translate german c24s003_KiaBeach_83fbd330:

    # kia "Por entonces Solomon bebía y estaba agresivo. No tanto como se puso después."
    kia "Zu dieser Zeit trank Salomo und war aggressiv. Nicht so schlimm wie später."

# game/scripts/c24/c24.rpy:1758
translate german c24s003_KiaBeach_b8ff51ed:

    # mc "Recuerdo como empeoró durante el año siguiente..."
    mc "Ich erinnere mich, wie es im darauffolgenden Jahr noch schlimmer wurde..."

# game/scripts/c24/c24.rpy:1760
translate german c24s003_KiaBeach_2f40382c:

    # kia "Exacto. Él trabajaba en el turno de tarde en la fábrica aquel verano, con lo que yo estaba sola en casa casi todo el día."
    kia "Genau. Er arbeitete in jenem Sommer in der Fabrik in der Nachmittagsschicht, daher war ich fast den ganzen Tag allein zu Hause."

# game/scripts/c24/c24.rpy:1761
translate german c24s003_KiaBeach_401b72ff:

    # kia "Por la mañana él dormía, se levantaba, iba a trabajar, volvía de noche y bebía hasta caer dormido."
    kia "Morgens schlief er, stand auf, ging zur Arbeit, kam abends zurück und trank, bis er einschlief."

# game/scripts/c24/c24.rpy:1762
translate german c24s003_KiaBeach_68db1dba:

    # kia "En los días buenos."
    kia "An guten Tagen."

# game/scripts/c24/c24.rpy:1763
translate german c24s003_KiaBeach_fb61827f:

    # mc "Una vida de mierda que eligió él."
    mc "Ein beschissenes Leben, das er sich ausgesucht hat."

# game/scripts/c24/c24.rpy:1764
translate german c24s003_KiaBeach_46f639b5:

    # kia "Sí, y que nos hacía pagar a [eil.nick] y a mí."
    kia "Ja, und dass er uns und [eil.nick] bezahlen ließ."

# game/scripts/c24/c24.rpy:1766
translate german c24s003_KiaBeach_1b5d6271:

    # kia "Pero a lo que iba... Cuando se iba a trabajar, no quería estar sola en casa. Me parecía opresiva."
    kia "Aber worauf ich hinauswollte … Wenn sie arbeiten ging, wollte sie nicht allein zu Hause sein. Ich empfand das als bedrückend."

# game/scripts/c24/c24.rpy:1767
translate german c24s003_KiaBeach_d5176a34:

    # kia "Empecé a conducir sin rumbo fijo. Después de un par de días, empecé a buscar en internet sitios cerca de Newport donde no hubiera estado nunca."
    kia "Ich fuhr ziellos umher. Nach ein paar Tagen begann ich, online nach Orten in der Nähe von Newport zu suchen, an denen ich noch nie gewesen war."

# game/scripts/c24/c24.rpy:1768
translate german c24s003_KiaBeach_b6967b68:

    # mc "Lo entiendo..."
    mc "Ich verstehe..."

# game/scripts/c24/c24.rpy:1770
translate german c24s003_KiaBeach_5997eb17:

    # kia "Descubrí algunos sitios bonitos, pero ninguno como este. Se convirtió en mi lugar favorito."
    kia "Ich habe einige wunderschöne Orte entdeckt, aber keiner war wie dieser. Er wurde zu meinem Lieblingsplatz."

# game/scripts/c24/c24.rpy:1771
translate german c24s003_KiaBeach_575229bd:

    # kia "Me daba... paz."
    kia "Es gab mir... Frieden."

# game/scripts/c24/c24.rpy:1772
translate german c24s003_KiaBeach_7ee7c847:

    # kia "Aquí me sentía segura. Sola pero segura."
    kia "Ich habe mich hier sicher gefühlt. Allein, aber sicher."

# game/scripts/c24/c24.rpy:1774
translate german c24s003_KiaBeach_87833168:

    # kia "Aquí nadie me decía que era una inútil ni me agarraba del pelo, llevándome por la casa para enseñarme lo que había hecho mal."
    kia "Niemand hier hat mir gesagt, ich sei nutzlos, oder mich an den Haaren gepackt und durchs Haus geschleift, um mir zu zeigen, was ich falsch gemacht habe."

# game/scripts/c24/c24.rpy:1776
translate german c24s003_KiaBeach_6740bf72:

    # kia "Me podía imaginar navegando hacia la puesta de sol en un barco con [eil.nick]. Para no volver nunca."
    kia "Ich könnte mir vorstellen, mit [eil.nick] auf einem Boot in den Sonnenuntergang zu segeln. Für immer."

# game/scripts/c24/c24.rpy:1778
translate german c24s003_KiaBeach_fb35d1b6:

    # kia "Sé que es una tontería. El sueño de un ama de casa infeliz."
    kia "Ich weiß, es ist albern. Der Traum einer unglücklichen Hausfrau."

# game/scripts/c24/c24.rpy:1779
translate german c24s003_KiaBeach_b7bf6898:

    # kia "Pero me daba tranquilidad."
    kia "Aber es gab mir inneren Frieden."

# game/scripts/c24/c24.rpy:1780
translate german c24s003_KiaBeach_b1600ea5:

    # mc "Lo entiendo, pero ¿por qué volver ahora que has dejado eso atrás?"
    mc "Ich verstehe, aber warum jetzt zurückkehren, wo du das hinter dir gelassen hast?"

# game/scripts/c24/c24.rpy:1782
translate german c24s003_KiaBeach_4fb7752b:

    # kia "Porque, aunque sea un sitio que evoca recuerdos oscuros, hace que los recuerdos felices que estamos creando se vean más brillantes."
    kia "Denn obwohl es ein Ort ist, der dunkle Erinnerungen weckt, lässt er die glücklichen Erinnerungen, die wir gerade schaffen, umso heller erscheinen."

# game/scripts/c24/c24.rpy:1783
translate german c24s003_KiaBeach_8a3915a6:

    # kia "Y porque es un lugar precioso que quería compartir contigo."
    kia "Und weil es ein wunderschöner Ort ist, den ich mit Ihnen teilen wollte."

# game/scripts/c24/c24.rpy:1784
translate german c24s003_KiaBeach_cd6b8591:

    # mc "Entonces deberíamos empezar a crear recuerdos felices aquí, ¿no?"
    mc "Wir sollten also anfangen, hier schöne Erinnerungen zu schaffen, nicht wahr?"

# game/scripts/c24/c24.rpy:1786
translate german c24s003_KiaBeach_6dc0e356:

    # kia "Estar aquí hoy, contigo, ya es un recuerdo feliz, aunque lo esté viviendo ahora mismo."
    kia "Dass ich heute hier mit euch sein darf, ist schon jetzt eine schöne Erinnerung, auch wenn ich sie gerade erst erlebe."

# game/scripts/c24/c24.rpy:1787
translate german c24s003_KiaBeach_f93717c6:

    # mc "Pienso lo mismo. Pero me has prometido que habría besos aquí."
    mc "Ich denke genauso. Aber du hast mir versprochen, dass es hier Küsse geben würde."

# game/scripts/c24/c24.rpy:1789
translate german c24s003_KiaBeach_1e80552e:

    # kia "*Risa* Si empezamos a besarnos, nos perderemos la puesta de sol."
    kia "*Lacht* Wenn wir anfangen zu küssen, verpassen wir den Sonnenuntergang."

# game/scripts/c24/c24.rpy:1790
translate german c24s003_KiaBeach_9482bb51:

    # mc "Prefiero mirarte a ti que a la puesta de sol. Además, aún queda mucho."
    mc "Ich schaue dich lieber an als den Sonnenuntergang. Außerdem ist noch genügend Zeit."

# game/scripts/c24/c24.rpy:1792
translate german c24s003_KiaBeach_18249387:

    # kia "A mí me puedes mirar cuando quieras. La puesta de sol sólo dura un segundo."
    kia "Du kannst mich ansehen, wann immer du willst. Der Sonnenuntergang dauert nur eine Sekunde."

# game/scripts/c24/c24.rpy:1793
translate german c24s003_KiaBeach_477b69bf:

    # mc "Entonces déjame hacer algo antes de que se ponga el sol. Sé que puede parecerte una tontería."
    mc "Dann lass mich noch etwas erledigen, bevor die Sonne untergeht. Ich weiß, es klingt vielleicht albern für dich."

# game/scripts/c24/c24.rpy:1795
translate german c24s003_KiaBeach_5d83a112:

    # kia "Ahora soy yo la que tiene curiosidad por lo que vas a hacer."
    kia "Jetzt bin ich es, die neugierig ist, was du tun wirst."

# game/scripts/c24/c24.rpy:1796
translate german c24s003_KiaBeach_e29a6b75:

    # mc "Antes has dicho que tú y yo no nos podríamos casar nunca. Porque Solomon nunca te dará el divorcio."
    mc "Du sagtest vorhin, dass wir beide niemals heiraten könnten. Weil Salomo dir niemals die Scheidung geben würde."

# game/scripts/c24/c24.rpy:1799
translate german c24s003_KiaBeach_5b9f333e:

    # mc "Y porque, aunque te lo diera, sería injusto que solo me casara contigo."
    mc "Und weil es selbst dann, wenn ich es dir geben würde, unfair wäre, wenn ich nur dich heiraten würde."

# game/scripts/c24/c24.rpy:1801
translate german c24s003_KiaBeach_14df12c2:

    # mc "Y, aunque te lo diera, pasarían meses antes de que pudiéramos hacer algo así."
    mc "Und selbst wenn ich es dir geben würde, würde es Monate dauern, bis wir so etwas tun könnten."

# game/scripts/c24/c24.rpy:1802
translate german c24s003_KiaBeach_8ea327c4:

    # kia "Sí. Pero lo entiendo, aunque me hubiera gustado si todo esto hubiera pasado en otras circunstancias."
    kia "Ja. Aber ich verstehe es, obwohl ich es vorgezogen hätte, wenn all dies unter anderen Umständen geschehen wäre."

# game/scripts/c24/c24.rpy:1804
translate german c24s003_KiaBeach_c9956e94:

    # mc "Podemos crear nuestras propias circunstancias."
    mc "Wir können unsere eigenen Umstände schaffen."

# game/scripts/c24/c24.rpy:1805
translate german c24s003_KiaBeach_3952fb47:

    # kia "¿A qué te refieres?"
    kia "Worüber redest du?"

# game/scripts/c24/c24.rpy:1807
translate german c24s003_KiaBeach_fdb6c9c3:

    # mc "[kia] Wellesley, ¿quieres casarte conmigo aunque nunca lo legalicemos?"
    mc "Wellesley, willst du mich heiraten, auch wenn wir es nie legalisieren?"

# game/scripts/c24/c24.rpy:1808
translate german c24s003_KiaBeach_757bfbc7:

    # mc "Estaremos casados a nuestros ojos, aunque no lo estemos a los ojos del mundo."
    mc "Wir werden in unseren eigenen Augen verheiratet sein, auch wenn wir in den Augen der Welt nicht verheiratet sind."

# game/scripts/c24/c24.rpy:1809
translate german c24s003_KiaBeach_adbf85c5:

    # kia "¿QUÉ?"
    kia "DAS?"

# game/scripts/c24/c24.rpy:1810
translate german c24s003_KiaBeach_56304b23:

    # kia "¿De dónde has sacado un anillo?"
    kia "Woher hast du den Ring?"

# game/scripts/c24/c24.rpy:1811
translate german c24s003_KiaBeach_a237cbdb:

    # mc "Del bolsillo..."
    mc "Aus meiner Tasche..."

# game/scripts/c24/c24.rpy:1813
translate german c24s003_KiaBeach_1da5a730:

    # kia "Me refiero... ¿Tenías esto planeado? ¿Has llevado un anillo todo este tiempo?"
    kia "Ich meine... War das geplant? Hast du die ganze Zeit einen Ring getragen?"

# game/scripts/c24/c24.rpy:1814
translate german c24s003_KiaBeach_e6ec41e7:

    # mc "No, cielo. Sé que es un muy cutre, pero lo he hecho con el estaño del tapón del mosto cuando has ido al lavabo."
    mc "Nein, Schatz. Ich weiß, es ist wirklich billig, aber ich habe es aus dem Metall vom Deckel der Mostflasche gemacht, als du auf der Toilette warst."

# game/scripts/c24/c24.rpy:1818
translate german c24s003_KiaBeach_f35fd59b:

    # mc "Mis dedos han empezado a jugar con el metal y ha salido un anillo. Mi subconsciente me ha dicho que tenía que pedirte que te casaras conmigo."
    mc "Meine Finger spielten mit dem Metall, und ein Ring kam zum Vorschein. Mein Unterbewusstsein sagte mir, ich müsse dich fragen, ob du mich heiraten willst."

# game/scripts/c24/c24.rpy:1820
translate german c24s003_KiaBeach_d4001fa4:

    # kia "¡Sí quiero!"
    kia "Ja, ich will!"

# game/scripts/c24/c24.rpy:1821
translate german c24s003_KiaBeach_8162835f:

    # mc "Te prometo cambiarlo por uno de verdad en cuanto pueda."
    mc "Ich verspreche, es so schnell wie möglich durch ein Original zu ersetzen."

# game/scripts/c24/c24.rpy:1823
translate german c24s003_KiaBeach_c774bda3:

    # "Tu prometida se lanza a tus labios con una pasión desconocida hasta ese momento."
    "Deine Verlobte küsst dich mit einer bis zu diesem Moment unbekannten Leidenschaft."

# game/scripts/c24/c24.rpy:1825
translate german c24s003_KiaBeach_63ac09ce:

    # kia "Sí quiero. No te puedes imaginar lo bonito que es lo que acabas de hacer."
    kia "Ja, das tue ich. Du kannst dir nicht vorstellen, wie wunderschön das ist, was du gerade getan hast."

# game/scripts/c24/c24.rpy:1826
translate german c24s003_KiaBeach_d572b899:

    # mc "Sólo es un anillo hecho con el estaño de una botella..."
    mc "Es ist nur ein Ring aus dem Blech einer Flasche..."

# game/scripts/c24/c24.rpy:1827
translate german c24s003_KiaBeach_b8fa6c64:

    # kia "No es el anillo. Es el hecho. Sabías que era importante para mí y lo has hecho."
    kia "Es geht nicht um den Ring. Es geht um die Geste. Du wusstest, wie wichtig es mir war, und du hast es getan."

# game/scripts/c24/c24.rpy:1830
translate german c24s003_KiaBeach_7a750b76:

    # kia "Pero tengo que poner una condición."
    kia "Aber ich muss eine Bedingung stellen."

# game/scripts/c24/c24.rpy:1831
translate german c24s003_KiaBeach_77c47ed2:

    # mc "¿Cuál?"
    mc "Welche?"

# game/scripts/c24/c24.rpy:1832
translate german c24s003_KiaBeach_ab2e544a:

    # kia "Que yo no sea la única a quién se lo pidas."
    kia "Bitte frage nicht nur mich."

# game/scripts/c24/c24.rpy:1833
translate german c24s003_KiaBeach_18f223f2:

    # mc "Me parece una condición que puedo cumplir."
    mc "Ich denke, das ist eine Bedingung, die ich erfüllen kann."

# game/scripts/c24/c24.rpy:1834
translate german c24s003_KiaBeach_3f179b78:

    # mc "Y vuelve a demostrar lo maravillosa que eres."
    mc "Und zeig uns noch einmal, wie wundervoll du bist."

# game/scripts/c24/c24.rpy:1836
translate german c24s003_KiaBeach_2e521197:

    # kia "¿Por qué?"
    kia "Weil?"

# game/scripts/c24/c24.rpy:1837
translate german c24s003_KiaBeach_8b4e3db9:

    # mc "Porque en un momento importante para ti, lo que haces es pensar en otras personas."
    mc "Denn in einem wichtigen Moment für dich denkst du an andere Menschen."

# game/scripts/c24/c24.rpy:1838
translate german c24s003_KiaBeach_0356e1ef:

    # kia "Es lo lógico, ¿no? Somos una familia..."
    kia "Das ist doch das Logische, oder? Wir sind eine Familie..."

# game/scripts/c24/c24.rpy:1839
translate german c24s003_KiaBeach_3672b52e:

    # mc "Sí, es lo lógico. Pero no todo el mundo lo haría en tus circunstancias."
    mc "Ja, das macht Sinn. Aber nicht jeder würde das unter Ihren Umständen tun."

# game/scripts/c24/c24.rpy:1841
translate german c24s003_KiaBeach_b351e505:

    # mc "Lo que es importante para ti, es importante para mí."
    mc "Was dir wichtig ist, ist mir wichtig."

# game/scripts/c24/c24.rpy:1843
translate german c24s003_KiaBeach_1c9399f7:

    # kia "¿Puedo volver a besar a mi prometido?"
    kia "Darf ich meinen Verlobten noch einmal küssen?"

# game/scripts/c24/c24.rpy:1844
translate german c24s003_KiaBeach_33974255:

    # mc "Por supuesto, pero... ¿y la puesta de sol?"
    mc "Natürlich, aber... was ist mit dem Sonnenuntergang?"

# game/scripts/c24/c24.rpy:1845
translate german c24s003_KiaBeach_b1b12e44:

    # kia "Ya la veremos otro día."
    kia "Wir werden sie eines Tages wiedersehen."

# game/scripts/c24/c24.rpy:1847
translate german c24s003_KiaBeach_39520351:

    # "Os empezáis a besar como si no hubiera un mañana, como si el tiempo se hubiera paralizado y el sol no se fuera a poner nunca."
    "Ihr küsst euch, als gäbe es kein Morgen, als stünde die Zeit still und die Sonne würde niemals untergehen."

# game/scripts/c24/c24.rpy:1848
translate german c24s003_KiaBeach_7da5e73a:

    # "No eres capaz de saber cómo es posible que acabarais ese beso con la misma ropa que lo empezasteis."
    "Du kannst unmöglich wissen, wie es möglich ist, dass du den Kuss in denselben Kleidern beendet hast, in denen du ihn begonnen hast."

# game/scripts/c24/c24.rpy:1849
translate german c24s003_KiaBeach_c1073a74:

    # "Tan solo recuerdas que fue uno de los besos más maravillosos de tu vida. Tu primer beso como prometido de alguien."
    "Du erinnerst dich nur noch daran, dass es einer der schönsten Küsse deines Lebens war. Dein erster Kuss als Verlobter."

# game/scripts/c24/c24.rpy:1850
translate german c24s003_KiaBeach_fd099c8e:

    # "Y el sol se puso sin que os dierais cuenta."
    "Und die Sonne ging unter, ohne dass du es bemerkt hast."

# game/scripts/c24/c24.rpy:1852
translate german c24s003_KiaBeach_bef69e4a:

    # "Os da lo mismo."
    "Das ist dir alles egal."

# game/scripts/c24/c24.rpy:1863
translate german c24s004_Eri_Dap_Kat_Nor_8e4c7523:

    # "Después de cenar, en la cocina de [nor]..."
    "Nach dem Abendessen, in der Küche von [nor]..."

# game/scripts/c24/c24.rpy:1865
translate german c24s004_Eri_Dap_Kat_Nor_75401fcb:

    # nor "Estoy muy contenta por Tía [bet]. Era injusto..."
    nor "Ich freue mich so für Tante [bet]. Das war echt unfair..."

# game/scripts/c24/c24.rpy:1866
translate german c24s004_Eri_Dap_Kat_Nor_76f0a7ee:

    # eri "Estoy de acuerdo. Querían aprovecharse de lo que creían que era un momento de vulnerabilidad de la tía."
    eri "Ich stimme zu. Sie wollten einen Moment der vermeintlichen Verletzlichkeit der Tante ausnutzen."

# game/scripts/c24/c24.rpy:1867
translate german c24s004_Eri_Dap_Kat_Nor_b58475de:

    # dap "Pero no contaban con [mc]. *Risita*"
    dap "Aber mit C4 hatten sie nicht gerechnet. *Kichern*"

# game/scripts/c24/c24.rpy:1869
translate german c24s004_Eri_Dap_Kat_Nor_2aa59a1a:

    # nor "¿Tenéis algún plan para el fin de semana?"
    nor "Hast du schon Pläne fürs Wochenende?"

# game/scripts/c24/c24.rpy:1871
translate german c24s004_Eri_Dap_Kat_Nor_d1d3ee28:

    # dap "He quedado con [eva] para que me enseñe a disparar el domingo por la tarde. También vienen varias de las chicas."
    dap "Ich habe mich mit [eva] für Sonntagnachmittag verabredet, um mir das Schießen beizubringen. Einige der Mädchen kommen auch."

# game/scripts/c24/c24.rpy:1873
translate german c24s004_Eri_Dap_Kat_Nor_f0f38756:

    # nor "¿Vas a ir tú también, [eri]?"
    nor "Gehst du auch hin, [eri]?"

# game/scripts/c24/c24.rpy:1875
translate german c24s004_Eri_Dap_Kat_Nor_121141d3:

    # eri "Me hubiera gustado ir. Ha alquilado un campo de tiro y podría haber estado bien, pero trabajo, con lo que quedaremos otro día."
    eri "Ich wäre gern mitgekommen. Er hat einen Schießstand gemietet, das wäre bestimmt schön gewesen, aber ich muss arbeiten, also treffen wir uns ein anderes Mal."

# game/scripts/c24/c24.rpy:1876
translate german c24s004_Eri_Dap_Kat_Nor_e4a29f7f:

    # eri "Iremos al bosque, donde le enseñó a disparar a [mc]."
    eri "Wir gehen in den Wald, wo er ihm beigebracht hat, wie man C4 verschießt."

# game/scripts/c24/c24.rpy:1878
translate german c24s004_Eri_Dap_Kat_Nor_13a3344b:

    # nor "Ir con cuidado con las armas... No son juguetes."
    nor "Seien Sie vorsichtig mit Waffen... Das sind keine Spielzeuge."

# game/scripts/c24/c24.rpy:1880
translate german c24s004_Eri_Dap_Kat_Nor_7ab70709:

    # dap "Lo sabemos, Mamá. Creo que tú también deberías aprender a disparar."
    dap "Wir wissen es, Mama. Ich finde, du solltest auch schießen lernen."

# game/scripts/c24/c24.rpy:1881
translate german c24s004_Eri_Dap_Kat_Nor_742d8287:

    # dap "Nunca puedes saber cuándo se repetirá otro secuestro, y creo que deberíamos tener armas en casa."
    dap "Man weiß nie, wann die nächste Entführung passiert, und ich denke, wir sollten Waffen zu Hause haben."

# game/scripts/c24/c24.rpy:1883
translate german c24s004_Eri_Dap_Kat_Nor_5fb4770a:

    # eri "Yo creo que no son necesarias, pese a lo bien que fue que [eva] tuviera una pistola escondida cuando pasó lo de Solomon."
    eri "Ich glaube nicht, dass sie notwendig sind, so gut es auch war, dass [eva] eine versteckte Waffe hatte, als der Solomon-Vorfall passierte."

# game/scripts/c24/c24.rpy:1885
translate german c24s004_Eri_Dap_Kat_Nor_6c8ae9f0:

    # nor "Yo pienso lo mismo. Yo ya sé disparar pero, si hubiera intentado hacer lo que hizo [eva], lo más probable es que le hubiera dado en la mano a Solomon."
    nor "Ich denke genauso. Ich weiß bereits, wie man schießt, aber wenn ich versucht hätte, das zu tun, was [eva] getan hat, hätte ich Salomo höchstwahrscheinlich in die Hand getroffen."

# game/scripts/c24/c24.rpy:1886
translate german c24s004_Eri_Dap_Kat_Nor_ce7a280b:

    # nor "O incluso sería más probable que hubiera matado a una ardilla en el bosque al otro lado de la calle. *Risa*"
    nor "Oder es wäre noch wahrscheinlicher, dass er ein Eichhörnchen im Wald gegenüber getötet hat. *lacht*"

# game/scripts/c24/c24.rpy:1888
translate german c24s004_Eri_Dap_Kat_Nor_1a092b52:

    # nor "[eva] y [ama] no van a ir a ningún sitio, con lo que creo que es mejor si son ellas las que se ocupan de las armas."
    nor "[eva] und [ama] bleiben ja an Ort und Stelle, deshalb denke ich, es ist besser, wenn sie sich um die Waffen kümmern."

# game/scripts/c24/c24.rpy:1889
translate german c24s004_Eri_Dap_Kat_Nor_ad0b0264:

    # nor "Es bueno que aprendáis, pero no me gustaría tener armas en casa."
    nor "Es ist gut, dass du lernst, aber ich möchte keine Waffen zu Hause haben."

# game/scripts/c24/c24.rpy:1891
translate german c24s004_Eri_Dap_Kat_Nor_02763481:

    # eri "Aparte de las que tiene [eva] escondidas, ¿no? *Risa*"
    eri "Abgesehen von denen, die sie versteckt hat, richtig? *lacht*"

# game/scripts/c24/c24.rpy:1892
translate german c24s004_Eri_Dap_Kat_Nor_fb5e8d29:

    # nor "*Risa* Exacto. Aparte de esas."
    nor "*Lacht* Genau. Abgesehen davon."

# game/scripts/c24/c24.rpy:1893
translate german c24s004_Eri_Dap_Kat_Nor_7be2239a:

    # dap "Bueno, una vez nos enseñe a disparar, nos podría decir dónde están..."
    dap "Nun, wenn Sie uns erst einmal beigebracht haben, wie man schießt, könnten Sie uns sagen, wo sie sind..."

# game/scripts/c24/c24.rpy:1894
translate german c24s004_Eri_Dap_Kat_Nor_7df8a7a2:

    # nor "*Risa* Entonces dejarían de estar escondidas. ¿Te imaginas a [emm] sabiendo dónde están las armas?"
    nor "*Gelächter* Dann wären sie nicht mehr versteckt. Können Sie sich vorstellen, dass [emm] wüsste, wo die Waffen sind?"

# game/scripts/c24/c24.rpy:1896
translate german c24s004_Eri_Dap_Kat_Nor_b711c9e5:

    # kat "Hola, chicas. ¿De qué habláis?"
    kat "Hey Mädels. Worüber redet ihr?"

# game/scripts/c24/c24.rpy:1898
translate german c24s004_Eri_Dap_Kat_Nor_226c8906:

    # "Todas" "De armas."
    "Todas" "Von Waffen."

# game/scripts/c24/c24.rpy:1900
translate german c24s004_Eri_Dap_Kat_Nor_7c813c76:

    # kat "¿Ah, de lo de [eva] el domingo? Va a ser divertido."
    kat "Oh, und die Sache mit dem [eva] am Sonntag? Das wird bestimmt lustig."

# game/scripts/c24/c24.rpy:1901
translate german c24s004_Eri_Dap_Kat_Nor_2fc0434f:

    # kat "Al final [kim] también vendrá."
    kat "Am Ende wird auch [kim] kommen."

# game/scripts/c24/c24.rpy:1903
translate german c24s004_Eri_Dap_Kat_Nor_daefa916:

    # dap "*Risa* Yo que tú iría con cuidado si [kim] está armada cerca de ti."
    dap "*Lacht* An deiner Stelle wäre ich vorsichtig, wenn [kim] bewaffnet in deiner Nähe ist."

# game/scripts/c24/c24.rpy:1905
translate german c24s004_Eri_Dap_Kat_Nor_d8fca8c5:

    # kat "¿Por qué? Le he hecho un favor..."
    kat "Warum? Ich habe ihm einen Gefallen getan..."

# game/scripts/c24/c24.rpy:1907
translate german c24s004_Eri_Dap_Kat_Nor_1bfe855c:

    # eri "Sí, probablemente, pero las formas no han sido las correctas y lo sabes, [kat]."
    eri "Ja, wahrscheinlich, aber die Methoden waren nicht die richtigen, und das weißt du auch, [kat]."

# game/scripts/c24/c24.rpy:1908
translate german c24s004_Eri_Dap_Kat_Nor_d8a5c890:

    # eri "La podías haber puesto en una situación desagradable cuando no estaba preparada."
    eri "Du hättest sie in eine unangenehme Situation bringen können, auf die sie nicht vorbereitet war."

# game/scripts/c24/c24.rpy:1910
translate german c24s004_Eri_Dap_Kat_Nor_75b6556d:

    # kat "Si no lo hubiera hecho, le hubiera estado dando vueltas al mismo tema durante meses..."
    kat "Hätte ich es nicht getan, hätte ich mich monatelang mit demselben Problem auseinandergesetzt..."

# game/scripts/c24/c24.rpy:1912
translate german c24s004_Eri_Dap_Kat_Nor_ea410f3c:

    # nor "Chicas, ¿me podéis dejar a solas con [kat] un momento?"
    nor "Mädels, könnt ihr mich mal kurz mit [kat] allein lassen?"

# game/scripts/c24/c24.rpy:1914
translate german c24s004_Eri_Dap_Kat_Nor_e0a53f01:

    # dap "Sí, quiero acostarme pronto hoy."
    dap "Ja, ich möchte heute Abend früh ins Bett gehen."

# game/scripts/c24/c24.rpy:1915
translate german c24s004_Eri_Dap_Kat_Nor_b88c34fe:

    # eri "No seas muy dura con ella, Mamá."
    eri "Sei nicht zu streng mit ihr, Mama."

# game/scripts/c24/c24.rpy:1917
translate german c24s004_Eri_Dap_Kat_Nor_1c4ddfff:

    # kat "¿Tan malo ha sido lo que he hecho?"
    kat "War das, was ich getan habe, wirklich so schlimm?"

# game/scripts/c24/c24.rpy:1919
translate german c24s004_Eri_Dap_Kat_Nor_fc1e12cb:

    # nor "Solo ha sido malo que lo hicieras sin consultarle a [kim] previamente."
    nor "Das einzig Schlechte war, dass Sie es getan haben, ohne vorher [kim] zu konsultieren."

# game/scripts/c24/c24.rpy:1922
translate german c24s004_Eri_Dap_Kat_Nor_b0d28bba:

    # nor "Cuando ha venido a preguntarme si me importaría que entrara en el harén estaba muy enfadada."
    nor "Als er kam und mich fragte, ob es mir etwas ausmachen würde, wenn er den Harem betrete, war ich sehr wütend."

# game/scripts/c24/c24.rpy:1924
translate german c24s004_Eri_Dap_Kat_Nor_16589389:

    # nor "Cuando ha venido a preguntarme si me importaría que intentara algo con [mc] estaba muy enfadada."
    nor "Als er kam und mich fragte, ob es mir etwas ausmachen würde, wenn er etwas mit [mc] versuchen würde, war ich sehr wütend."

# game/scripts/c24/c24.rpy:1926
translate german c24s004_Eri_Dap_Kat_Nor_0150f8d4:

    # nor "Cuando me ha contado lo que has hecho estaba muy enfadada."
    nor "Als sie mir erzählte, was du getan hast, war ich sehr wütend."

# game/scripts/c24/c24.rpy:1928
translate german c24s004_Eri_Dap_Kat_Nor_8912c844:

    # kat "Lo siento, supongo que debería disculparme..."
    kat "Es tut mir leid, ich sollte mich wohl entschuldigen..."

# game/scripts/c24/c24.rpy:1930
translate german c24s004_Eri_Dap_Kat_Nor_a706ac1f:

    # nor "Como ha dicho [eri], el problema han sido las formas."
    nor "Wie [eri] bereits sagte, lag das Problem in den Methoden."

# game/scripts/c24/c24.rpy:1931
translate german c24s004_Eri_Dap_Kat_Nor_486e0076:

    # nor "Imagínate que yo hago lo mismo contigo."
    nor "Stell dir vor, ich würde dasselbe mit dir machen."

# game/scripts/c24/c24.rpy:1933
translate german c24s004_Eri_Dap_Kat_Nor_a275e1f1:

    # kat "No es lo mismo, [nor]..."
    kat "Es ist nicht dasselbe, [nor]..."

# game/scripts/c24/c24.rpy:1935
translate german c24s004_Eri_Dap_Kat_Nor_84383461:

    # nor "¿Cuál es la diferencia? Tú también vas a darle vueltas al tema durante mucho tiempo, por lo que parece."
    nor "Worin besteht der Unterschied? Auch darüber wirst du wohl noch lange nachdenken müssen."

# game/scripts/c24/c24.rpy:1936
translate german c24s004_Eri_Dap_Kat_Nor_57295e46:

    # nor "Y no me digas que es más complicado."
    nor "Und sag mir nicht, es sei komplizierter."

# game/scripts/c24/c24.rpy:1938
translate german c24s004_Eri_Dap_Kat_Nor_d3d12574:

    # kat "Es que es más complicado..."
    kat "So einfach ist das nicht..."

# game/scripts/c24/c24.rpy:1940
translate german c24s004_Eri_Dap_Kat_Nor_b2ffd429:

    # nor "¿Por qué? ¿Porque incluye a [kim] y a [mc] en tu caso?"
    nor "Warum? Weil es in Ihrem Fall [kim] und [mc] enthält?"

# game/scripts/c24/c24.rpy:1941
translate german c24s004_Eri_Dap_Kat_Nor_3feb4a95:

    # nor "¿Te encierro con los dos en una habitación mañana? ¿O espero a saber si acaban juntos?"
    nor "Soll ich dich und die beiden morgen in einem Zimmer einsperren? Oder soll ich abwarten, ob sie am Ende zusammenkommen?"

# game/scripts/c24/c24.rpy:1943
translate german c24s004_Eri_Dap_Kat_Nor_71da3642:

    # kat "Me moriría de vergüenza..."
    kat "Ich würde vor Scham sterben..."

# game/scripts/c24/c24.rpy:1945
translate german c24s004_Eri_Dap_Kat_Nor_0e9fbcee:

    # nor "Eso es lo que le ha pasado a [kim] esta mañana."
    nor "Genau das ist heute Morgen [kim] passiert."

# game/scripts/c24/c24.rpy:1946
translate german c24s004_Eri_Dap_Kat_Nor_ccee749e:

    # nor "[deb.nick] lo podía hacer con [lis] porque son hermanas. Sabía cómo iba a reaccionar ella saliera lo que saliera de ese encierro."
    nor "[deb.nick] Ich konnte es mit [lis] tun, weil sie Schwestern sind. Ich wusste, wie sie reagieren würde, egal was aus dieser Isolation herauskommen würde."

# game/scripts/c24/c24.rpy:1948
translate german c24s004_Eri_Dap_Kat_Nor_17a5433c:

    # nor "No la has encerrado con [mc], pero sí con [mar], que es casi más importante para ella."
    nor "Du hast es nicht mit [mc] umschlossen, aber mit [mar], was für sie fast noch wichtiger ist."

# game/scripts/c24/c24.rpy:1949
translate german c24s004_Eri_Dap_Kat_Nor_e6ee482d:

    # nor "Y tú te podías imaginar la respuesta que iba a dar [mar], pero pese a todo has forzado una situación que no tenías derecho a forzar."
    nor "Und Sie können sich vorstellen, welche Antwort ich geben wollte [mar], aber trotz allem haben Sie eine Situation erzwungen, zu der Sie kein Recht hatten."

# game/scripts/c24/c24.rpy:1951
translate german c24s004_Eri_Dap_Kat_Nor_117fad36:

    # kat "Pero es que... necesitaba forzarla..."
    kat "Aber... ich musste es erzwingen..."

# game/scripts/c24/c24.rpy:1953
translate german c24s004_Eri_Dap_Kat_Nor_0b9824dc:

    # nor "¿Por qué? ¿Crees que, si [kim] y [mc] acaban juntos, te vas a quitar a los dos de la cabeza?"
    nor "Warum? Glaubst du, dass du [kim] und [mc] aus dem Kopf bekommst, wenn sie zusammenkommen?"

# game/scripts/c24/c24.rpy:1955
translate german c24s004_Eri_Dap_Kat_Nor_c90b7790:

    # kat "Sí, esa es la idea. Matar dos pájaros de un tiro..."
    kat "Ja, genau das ist die Idee. Zwei Fliegen mit einer Klappe schlagen..."

# game/scripts/c24/c24.rpy:1956
translate german c24s004_Eri_Dap_Kat_Nor_6455063e:

    # kat "*Susurrando para sí misma* O dos esperanzas a la vez..."
    kat "*flüstert vor sich hin* Oder zwei Hoffnungen auf einmal..."

# game/scripts/c24/c24.rpy:1958
translate german c24s004_Eri_Dap_Kat_Nor_6e890a8a:

    # nor "Eso no va a funcionar, [kat]."
    nor "Das wird nicht funktionieren, [kat]."

# game/scripts/c24/c24.rpy:1959
translate german c24s004_Eri_Dap_Kat_Nor_0904c7da:

    # nor "Si acaban juntos te empezarás a imaginar las posibilidades."
    nor "Wenn sie am Ende zusammenkommen, fängt man an, sich die Möglichkeiten auszumalen."

# game/scripts/c24/c24.rpy:1960
translate german c24s004_Eri_Dap_Kat_Nor_25c26731:

    # nor "Y si no acaban juntos, seguirás como estás ahora mismo, pero habrás conseguido enfadar a [kim]."
    nor "Und wenn sie nicht zusammenkommen, bleibst du, wie du jetzt bist, aber du hast es geschafft, [kim] zu verärgern."

# game/scripts/c24/c24.rpy:1962
translate german c24s004_Eri_Dap_Kat_Nor_69402303:

    # kat "Pero es que no sabes lo difícil que es compartir habitación con una de las mujeres más bonitas que he visto nunca."
    kat "Aber du hast keine Ahnung, wie schwierig es ist, ein Zimmer mit einer der schönsten Frauen zu teilen, die ich je gesehen habe."

# game/scripts/c24/c24.rpy:1963
translate german c24s004_Eri_Dap_Kat_Nor_bfef32ac:

    # kat "Reír juntas, hacernos amigas... verla desnuda cada día..."
    kat "Gemeinsam lachen, Freunde werden... sie jeden Tag nackt sehen..."

# game/scripts/c24/c24.rpy:1965
translate german c24s004_Eri_Dap_Kat_Nor_7fac8621:

    # nor "¿Y con [mc]? ¿Qué esperas conseguir con él? ¿Ya has conseguido aclararte?"
    nor "Und was ist mit [mc]? Was erhoffen Sie sich davon? Haben Sie es schon herausgefunden?"

# game/scripts/c24/c24.rpy:1967
translate german c24s004_Eri_Dap_Kat_Nor_aebf4443:

    # kat "Ahí está el problema... yo era feliz mientras sólo me gustaban las mujeres..."
    kat "Das ist das Problem... Ich war glücklich, solange ich nur Frauen mochte..."

