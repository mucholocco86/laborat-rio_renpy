

# game/scripts/c24/c24.rpy:37
translate german c24s001_Bet_6854d5fe:

    # mc "Pues sí, creo que nos ha oído."
    mc "Ja, ich glaube, er hat uns gehört."

# game/scripts/c24/c24.rpy:38
translate german c24s001_Bet_bdb3454f:

    # mc "¿Vas a dormir con eso?"
    mc "Willst du damit schlafen?"

# game/scripts/c24/c24.rpy:40
translate german c24s001_Bet_747077f8:

    # bet "No he dormido con un sujetador en mi vida... Esto tiene que ser super incómodo."
    bet "Ich habe noch nie in meinem Leben mit BH geschlafen... Das muss total unbequem sein."

# game/scripts/c24/c24.rpy:41
translate german c24s001_Bet_26f867c8:

    # mc "Te puedo dejar la camiseta que me iba a poner mañana, si quieres."
    mc "Wenn du möchtest, kann ich dir das Hemd leihen, das ich morgen tragen wollte."

# game/scripts/c24/c24.rpy:43
translate german c24s001_Bet_1c3588bf:

    # bet "Sí, por favor..."
    bet "Ja, bitte..."

# game/scripts/c24/c24.rpy:44
translate german c24s001_Bet_b71ed625:

    # mc "Aunque también podrías dormir sin el sujetador. No voy a ver nada que no haya visto en la piscina..."
    mc "Man könnte zwar auch ohne BH schlafen. Ich werde am Pool nichts sehen, was ich nicht schon gesehen hätte..."

# game/scripts/c24/c24.rpy:45
translate german c24s001_Bet_1f50df54:

    # mc "O en la cocina, durante la partida de DnD."
    mc "Oder in der Küche, während einer Runde Dungeons & Dragons."

# game/scripts/c24/c24.rpy:47
translate german c24s001_Bet_7c4deb52:

    # bet "¡[mc]! ¡Es diferente!"
    bet "Es ist anders!"

# game/scripts/c24/c24.rpy:48
translate german c24s001_Bet_e1e7e3f0:

    # bet "No íbamos a compartir cama y no habíamos tenido la conversación que hemos tenido esta mañana en el coche."
    bet "Wir hatten nicht vor, uns ein Bett zu teilen, und wir hatten das Gespräch, das wir heute Morgen im Auto geführt haben, noch nicht geführt."

# game/scripts/c24/c24.rpy:49
translate german c24s001_Bet_6b8e33f0:

    # mc "No te preocupes, te presto mi camiseta."
    mc "Keine Sorge, ich leihe dir mein Hemd."

# game/scripts/c24/c24.rpy:50
translate german c24s001_Bet_3e6d5518:

    # mc "De todas formas, no iba a pasar nada. Te dije que podríamos tener una oportunidad de estar juntos si no eras monja. Y aún lo eres."
    mc "Wie dem auch sei, es wäre sowieso nichts passiert. Ich sagte dir, wir hätten eine Chance, zusammen zu sein, wenn du keine Nonne wärst. Und das bist du immer noch."

# game/scripts/c24/c24.rpy:52
translate german c24s001_Bet_2d289fcf:

    # bet "Lo sé..."
    bet "Ich weiß..."

# game/scripts/c24/c24.rpy:53
translate german c24s001_Bet_190311ff:

    # bet "Dame esa camiseta, por favor."
    bet "Gib mir bitte das Hemd."

# game/scripts/c24/c24.rpy:54
translate german c24s001_Bet_ba2cbe37:

    # mc "Se la presté a [eil] el día que llegó a casa y me parece que ha dado el cuello de sí un poco..."
    mc "Ich habe es [eil] am Tag ihrer Heimkehr geliehen und mir scheint, dass sich der Hals etwas gedehnt hat..."

# game/scripts/c24/c24.rpy:56
translate german c24s001_Bet_a5a52c4a:

    # bet "*Desde el lavabo* ¿En serio? ¿No tenías otra camiseta?"
    bet "*Aus dem Badezimmer* Im Ernst? Hattest du kein anderes Hemd dabei?"

# game/scripts/c24/c24.rpy:57
translate german c24s001_Bet_cc013ef9:

    # mc "*Risa* Lo sé, casi parece hecho a propósito."
    mc "*lacht* Ich weiß, es wirkt fast so, als wäre es mit Absicht geschehen."

# game/scripts/c24/c24.rpy:58
translate german c24s001_Bet_b09f2caa:

    # bet "*Desde el lavabo* ¿Estás seguro de que esto no es un plan tuyo y de [emm]?"
    bet "*Aus dem Badezimmer* Bist du sicher, dass das nicht ein Plan ist, den du und [emm] ausgeheckt habt?"

# game/scripts/c24/c24.rpy:59
translate german c24s001_Bet_6f244a5c:

    # mc "*Risa* No podía haber planeado algo así antes de la conversación de esta mañana."
    mc "*lacht* So etwas hätte ich vor dem Gespräch heute Morgen nicht planen können."

# game/scripts/c24/c24.rpy:60
translate german c24s001_Bet_b9f3d257:

    # mc "[emm] ha tenido tiempo de planearlo si ha fingido estar dormida, pero lo de la camiseta es casualidad. *Risa* Me la regaló Jam hace años."
    mc "[emm] Wenn sie so getan hat, als würde sie schlafen, hatte sie Zeit, das zu planen, aber die Sache mit dem T-Shirt ist reiner Zufall. *Lacht* Jam hat es mir vor Jahren geschenkt."

# game/scripts/c24/c24.rpy:61
translate german c24s001_Bet_ce5e6d01:

    # mc "Y antes de que preguntes, me gustaría recuperarla. Es un préstamo."
    mc "Und bevor Sie fragen: Ich möchte es zurückbekommen. Es ist ein Darlehen."

# game/scripts/c24/c24.rpy:67
translate german c24s001_Bet_38add06f:

    # bet "Al menos es grande. No creo que entrase en una camiseta tuya de ahora. Pero es cortísima..."
    bet "Immerhin ist es groß. Ich glaube nicht, dass es in eines deiner jetzigen T-Shirts passen würde. Aber es ist wirklich kurz..."

# game/scripts/c24/c24.rpy:68
translate german c24s001_Bet_baa147e2:

    # mc "No voy a ver nada que no haya visto hace cinco minutos. *Risa* Porque sigues llevando las bragas, ¿verdad?"
    mc "Ich werde nichts sehen, was ich nicht schon vor fünf Minuten gesehen habe. *Lacht* Weil du ja immer noch deine Unterhose trägst, richtig?"

# game/scripts/c24/c24.rpy:70
translate german c24s001_Bet_5573fb9b:

    # bet "¡Claro que sigo llevándolas!"
    bet "Natürlich trage ich sie immer noch!"

# game/scripts/c24/c24.rpy:71
translate german c24s001_Bet_0a4dd1d1:

    # mc "Sólo bromeaba, Tía [bet]. Vamos a la cama; se está haciendo tarde."
    mc "Ich habe nur gescherzt, Tante [bet]. Lass uns ins Bett gehen; es wird spät."

# game/scripts/c24/c24.rpy:73
translate german c24s001_Bet_67289901:

    # "Tras apagar las luces..."
    "Nachdem ich das Licht ausgeschaltet hatte..."

# game/scripts/c24/c24.rpy:74
translate german c24s001_Bet_aaa1b5a2:

    # mc "Buenas noches, Tía [bet]."
    mc "Guten Abend, Tante [bet]."

# game/scripts/c24/c24.rpy:75
translate german c24s001_Bet_5f3e1bd6:

    # bet "Buenas noches, [mc]."
    bet "Guten Abend, [mc]."

# game/scripts/c24/c24.rpy:77
translate german c24s001_Bet_2b7a1410:

    # "Intentas dormir sin éxito. Te preocupa moverte en sueños y que tu mano acabe en el mismo sitio que acabó con [sca]. Salvando las diferencias de tamaño."
    "Du versuchst zu schlafen, aber es gelingt dir nicht. Du hast Angst, dich im Schlaf zu bewegen und dass deine Hand wieder an derselben Stelle landet wie vorher. Größenunterschiede mal beiseite."

# game/scripts/c24/c24.rpy:79
translate german c24s001_Bet_6dd4bc9d:

    # "Intentas dormir sin éxito. Te preocupa moverte en sueños y hacer algo que incomode a Tía [bet]."
    "Du versuchst zu schlafen, kannst es aber nicht. Du hast Angst, dich im Schlaf zu bewegen und etwas zu tun, was Tante [bet] verärgern könnte."

# game/scripts/c24/c24.rpy:80
translate german c24s001_Bet_aeca0d27:

    # "Al cabo de un rato..."
    "Nach einer Weile..."

# game/scripts/c24/c24.rpy:81
translate german c24s001_Bet_6a5cc46a:

    # bet "*Susurrando* ¿Estás dormido?"
    bet "*Flüsternd* Schläfst du?"

# game/scripts/c24/c24.rpy:82
translate german c24s001_Bet_142b9233:

    # mc "No, no puedo dormir. ¿Tú tampoco?"
    mc "Nein, ich kann nicht schlafen. Du auch nicht?"

# game/scripts/c24/c24.rpy:84
translate german c24s001_Bet_ba16db52:

    # bet "No, estaba pensando en todo lo que ha pasado hoy..."
    bet "Nein, ich habe über alles nachgedacht, was heute passiert ist..."

# game/scripts/c24/c24.rpy:85
translate german c24s001_Bet_2cab15e3:

    # mc "¿Quieres hablarlo?"
    mc "Möchtest du darüber reden?"

# game/scripts/c24/c24.rpy:86
translate german c24s001_Bet_bd85b516:

    # bet "No, no quiero que pierdas horas de sueño. Intenta dormir."
    bet "Nein, ich möchte nicht, dass du schlaflose Nächte hast. Versuche, etwas zu schlafen."

# game/scripts/c24/c24.rpy:87
translate german c24s001_Bet_c250bdf1:

    # mc "No voy a poder. Voy a encender la luz."
    mc "Das wird mir nicht gelingen. Ich werde das Licht einschalten."

# game/scripts/c24/c24.rpy:89
translate german c24s001_Bet_1c55fdce:

    # mc "Sé que es tontería preguntarte qué te preocupa, pero no tienes que tomar la decisión hoy. Tienes dos meses para pensarlo."
    mc "Ich weiß, es ist albern zu fragen, was dich beunruhigt, aber du musst die Entscheidung nicht heute treffen. Du hast zwei Monate Zeit, darüber nachzudenken."

# game/scripts/c24/c24.rpy:90
translate german c24s001_Bet_0d21d4ba:

    # bet "Esa decisión ya la he tomado. No voy a entrar en un convento de clausura ni me voy a ir a Latinoamérica."
    bet "Ich habe diese Entscheidung bereits getroffen. Ich werde weder in ein Kloster eintreten, noch werde ich nach Lateinamerika reisen."

# game/scripts/c24/c24.rpy:91
translate german c24s001_Bet_4845b11d:

    # bet "Las dos cosas significarían perder a la familia, y no estoy dispuesta a ello."
    bet "Beide Optionen würden bedeuten, dass ich meine Familie verliere, und dazu bin ich nicht bereit."

# game/scripts/c24/c24.rpy:92
translate german c24s001_Bet_640320c2:

    # mc "Bueno, volver a África, que era tu plan inicial, también hubiera significado que no nos verías..."
    mc "Nun, die Rückkehr nach Afrika, was ja Ihr ursprünglicher Plan war, hätte auch bedeutet, dass Sie uns nicht mehr gesehen hätten..."

# game/scripts/c24/c24.rpy:94
translate german c24s001_Bet_cb00520d:

    # bet "Es diferente. De allí podría volver una o dos veces al año para veros. De un convento en Perú, no."
    bet "Das ist anders. Von dort aus könnte ich ein- oder zweimal im Jahr zurückkommen, um dich zu besuchen. Von einem Kloster in Peru aus, nein."

# game/scripts/c24/c24.rpy:95
translate german c24s001_Bet_b2431031:

    # mc "Tienes razón, no lo había pensado así. Para mí sería casi igual de duro que te fueras a Perú que a... no sé... un país de África que no fuera Tanzania."
    mc "Du hast recht, so hatte ich das noch gar nicht betrachtet. Für mich wäre es fast genauso schwierig, nach Peru zu reisen, wie in... ich weiß nicht... irgendein anderes afrikanisches Land außer Tansania."

# game/scripts/c24/c24.rpy:96
translate german c24s001_Bet_1d335301:

    # mc "Me he acostumbrado a verte todos los días, y sería difícil si te tuvieras que ir."
    mc "Ich habe mich daran gewöhnt, dich jeden Tag zu sehen, und es wäre schwierig, wenn du gehen müsstest."

# game/scripts/c24/c24.rpy:98
translate german c24s001_Bet_fb7a27b1:

    # bet "Por eso te digo que la decisión está tomada. Por lo que a mí respecta, he dejado de ser monja hace horas, aunque deje de serlo oficialmente en unos meses."
    bet "Deshalb sage ich Ihnen, dass die Entscheidung gefallen ist. Für mich persönlich bin ich seit Stunden keine Nonne mehr, auch wenn ich offiziell erst in einigen Monaten damit aufhören werde."

# game/scripts/c24/c24.rpy:99
translate german c24s001_Bet_c1614e7a:

    # mc "Si tienes la decisión tomada, ¿por qué no hacerlo oficial mañana cuando vayas a por la documentación de los conventos?"
    mc "Wenn Sie Ihre Entscheidung getroffen haben, warum machen Sie sie nicht morgen offiziell, wenn Sie die Unterlagen für die Klöster abholen?"

# game/scripts/c24/c24.rpy:100
translate german c24s001_Bet_44470795:

    # mc "Supongo que la iglesia pensará que tomarás la decisión entre las dos opciones que te han propuesto, no una tercera opción."
    mc "Ich nehme an, die Kirche wird davon ausgehen, dass Sie sich zwischen den beiden von ihr vorgeschlagenen Optionen entscheiden werden, nicht zwischen einer dritten Option."

# game/scripts/c24/c24.rpy:101
translate german c24s001_Bet_5ce4fd71:

    # mc "No sé si tendrán que preparar algún papel para que te des de baja, o como se diga."
    mc "Ich weiß nicht, ob sie irgendwelche Unterlagen für Ihre Abmeldung vorbereiten müssen, oder wie auch immer das heißt."

# game/scripts/c24/c24.rpy:103
translate german c24s001_Bet_7d4ff649:

    # bet "Tienes razón... sería una forma de cerrar todo este asunto, al menos hasta que firme los papeles que seguro que me harán firmar."
    bet "Du hast Recht... das wäre eine Möglichkeit, die ganze Angelegenheit abzuschließen, zumindest bis ich die Papiere unterschreibe, die sie mich sicherlich unterschreiben lassen werden."

# game/scripts/c24/c24.rpy:104
translate german c24s001_Bet_d0033555:

    # mc "Genial. Un tema resuelto. Supongo que lo otro a lo que le estabas dando vueltas era a lo de la certificación, pero eso ya ha quedado resuelto."
    mc "Super. Problem gelöst. Ich nehme an, Sie dachten auch an die Zertifizierung, aber das hat sich ja jetzt erledigt."

# game/scripts/c24/c24.rpy:106
translate german c24s001_Bet_b1035ecd:

    # bet "Me preocupa ponerme a estudiar a mi edad, y empezar a buscar trabajo... Soy una anciana a punto de retirarse, al fin y al cabo."
    bet "Ich mache mir Sorgen darüber, in meinem Alter noch ein Studium zu beginnen und mir einen Job suchen zu müssen... Ich bin schließlich eine alte Frau, die bald in Rente geht."

# game/scripts/c24/c24.rpy:107
translate german c24s001_Bet_1e4e4c73:

    # mc "Eres una mujer con un montón de experiencia. Creo que eso también lo valorarán. ¿Alguna cosa más que te preocupe?"
    mc "Sie sind eine Frau mit viel Erfahrung. Ich denke, das werden sie auch zu schätzen wissen. Gibt es sonst noch etwas, das Ihnen auf dem Herzen liegt?"

# game/scripts/c24/c24.rpy:110
translate german c24s001_Bet_770afeaa:

    # bet "Lo que has dicho antes."
    bet "Das, was Sie vorher gesagt haben."

# game/scripts/c24/c24.rpy:111
translate german c24s001_Bet_17f34aa8:

    # mc "¿Qué he dicho?"
    mc "Was habe ich gesagt?"

# game/scripts/c24/c24.rpy:114
translate german c24s001_Bet_676009a9:

    # bet "Lo de que podríamos tener una oportunidad de estar juntos si no era monja. Y que aún lo era. Aunque solo sea oficialmente..."
    bet "Die Vorstellung, dass wir vielleicht eine Chance hätten, zusammen zu sein, wenn sie keine Nonne wäre. Und dass sie es immer noch war. Selbst wenn es nur offiziell war..."

# game/scripts/c24/c24.rpy:115
translate german c24s001_Bet_2d82726b:

    # mc "¿Y qué te preocupa sobre eso?"
    mc "Und was beunruhigt Sie daran?"

# game/scripts/c24/c24.rpy:117
translate german c24s001_Bet_dcbab1f8:

    # bet "Hace 40 años que no estoy con nadie... Ya no sé qué hacer o cómo hacerlo. Y no me refiero al sexo... me refiero... a esa oportunidad de la que hablabas."
    bet "Seit 40 Jahren war ich mit niemandem mehr zusammen… Ich weiß einfach nicht mehr, was ich tun soll. Und ich meine nicht Sex… ich meine… diese Gelegenheit, von der du gesprochen hast."

# game/scripts/c24/c24.rpy:118
translate german c24s001_Bet_c88be3be:

    # mc "Eso es muy fácil. Se habla todo. Cualquier duda que tengas sobre lo que debes o no debes hacer, solo tienes que hablarlo conmigo."
    mc "Das ist ganz einfach. Wir werden alles besprechen. Wenn du Zweifel hast, was du tun oder lassen solltest, sprich mich einfach an."

# game/scripts/c24/c24.rpy:120
translate german c24s001_Bet_debec0dd:

    # mc "Por ejemplo, yo podría preguntar si puedo hacer esto ahora que sólo eres monja oficialmente pero ya no te consideras una."
    mc "Ich könnte Sie beispielsweise fragen, ob ich das jetzt tun darf, da Sie zwar offiziell Nonne sind, sich aber nicht mehr als solche betrachten."

# game/scripts/c24/c24.rpy:121
translate german c24s001_Bet_57cad9b2:

    # mc "Y tú podrías contestar sí o no, o no contestar y dejarme seguir."
    mc "Sie könnten mit Ja oder Nein antworten oder auch nicht und mich fortfahren lassen."

# game/scripts/c24/c24.rpy:122
translate german c24s001_Bet_09ec5f6e:

    # bet "O podría preguntar qué pretendes con eso..."
    bet "Oder ich könnte fragen, was Sie damit erreichen wollen..."

# game/scripts/c24/c24.rpy:123
translate german c24s001_Bet_46c34fcd:

    # mc "Podrías, pero... ¿lo estás preguntando?"
    mc "Das könntest du, aber... fragst du das wirklich?"

# game/scripts/c24/c24.rpy:125
translate german c24s001_Bet_2fd44d12:

    # bet "No..."
    bet "NEIN..."

# game/scripts/c24/c24.rpy:126
translate german c24s001_Bet_0d02ac2b:

    # mc "Yo tampoco he preguntado si puedo..."
    mc "Ich habe auch nicht gefragt, ob ich das darf..."

# game/scripts/c24/c24.rpy:127
translate german c24s001_Bet_c7bbd3dd:

    # bet "Pero puedes..."
    bet "Aber Sie können..."

# game/scripts/c24/c24.rpy:128
translate german c24s001_Bet_3c1ea0e5:

    # mc "Y si te dijera que quiero recuperar mi camiseta, ¿cuál sería tu respuesta?"
    mc "Und wenn ich Ihnen sagen würde, dass ich mein Hemd zurückhaben möchte, was wäre Ihre Antwort?"

# game/scripts/c24/c24.rpy:130
translate german c24s001_Bet_46c8122d:

    # bet "*Risa* Que te la tendré que devolver porque me la has prestado mientras aún era monja..."
    bet "*lacht* Ich muss es dir zurückgeben, weil du es mir geliehen hast, als ich noch Nonne war..."

# game/scripts/c24/c24.rpy:132
translate german c24s001_Bet_a8f8ea5e:

    # bet "[sca] te enseño cómo funciona esto cuando le prestas ropa a tu pareja, ¿no? Eso no ha cambiado desde mi época."
    bet "[sca] Ich zeige dir, wie das funktioniert, wenn du deinem Partner Kleidung leihst, richtig? Das hat sich seit meiner Zeit nicht geändert."

# game/scripts/c24/c24.rpy:134
translate german c24s001_Bet_bc00184a:

    # bet "Ya sabes cómo funciona esto cuando le prestas ropa a tu pareja, ¿no? Eso no ha cambiado desde mi época."
    bet "Du weißt doch, wie das läuft, wenn man seinem Partner Kleidung leiht, oder? Das hat sich seit meiner Zeit nicht geändert."

# game/scripts/c24/c24.rpy:135
translate german c24s001_Bet_afb45094:

    # mc "*Risa* Creo que gastaré mucho en ropa entonces. Pero de momento, quiero mi camiseta."
    mc "*Lacht* Dann werde ich wohl einiges für Kleidung ausgeben. Aber jetzt will ich erstmal mein T-Shirt."

# game/scripts/c24/c24.rpy:138
translate german c24s001_Bet_20be496e:

    # bet "*Conteniendo la risa mientras finge sorpresa* ¡[mc]! ¿Quieres verle las tetas a tu Tía Abuela?"
    bet "*Unterdrückt Lachen und gibt sich überrascht* [mc]! Möchtest du die Brüste deiner Großtante sehen?"

# game/scripts/c24/c24.rpy:140
translate german c24s001_Bet_03021ef5:

    # bet "*Conteniendo la risa mientras finge sorpresa* ¡[mc]! ¿Quieres verle las tetas a una anciana exmonja?"
    bet "*Unterdrückt Lachen und tut überrascht* [mc]! Du willst die Brüste einer alten Ex-Nonne sehen?"

# game/scripts/c24/c24.rpy:141
translate german c24s001_Bet_aedbe009:

    # mc "No solo verlas. Aunque no me canse de verlas, hoy quiero hacer más que solo mirarlas."
    mc "Nicht nur, um sie anzusehen. Obwohl ich mich nie daran sattsehe, sie anzusehen, möchte ich heute mehr tun, als sie nur zu beobachten."

# game/scripts/c24/c24.rpy:143
translate german c24s001_Bet_0cf9ce16:

    # bet "¿Mejor así, entonces?"
    bet "Ist es so besser?"

# game/scripts/c24/c24.rpy:144
translate german c24s001_Bet_70eac7fa:

    # mc "Mucho mejor... pero antes de continuar quiero preguntarte si estás realmente segura de esto."
    mc "Viel besser... aber bevor wir fortfahren, möchte ich fragen, ob Sie sich da wirklich sicher sind."

# game/scripts/c24/c24.rpy:145
translate german c24s001_Bet_68c35d5c:

    # mc "Aún eres oficialmente una monja y no me gustaría que por la mañana te sintieras mal por lo que pase ahora."
    mc "Du bist offiziell immer noch eine Nonne, und ich möchte nicht, dass du dich morgen früh wegen dem, was jetzt passiert, schlecht fühlst."

# game/scripts/c24/c24.rpy:147
translate german c24s001_Bet_13a4ced8:

    # bet "Estoy segurísima, no te preocupes. No me voy a volver a poner el hábito nunca más."
    bet "Ganz sicher bin ich mir, keine Sorge. Ich werde diese Angewohnheit nie wieder tragen."

# game/scripts/c24/c24.rpy:148
translate german c24s001_Bet_f0e73b0b:

    # mc "En ese caso, creo que necesito acariciarte. *Risa* Y eliminar la camiseta de la ecuación."
    mc "In dem Fall müsste ich dich wohl streicheln. *lacht* Und das mit dem Hemd mal außen vor lassen."

# game/scripts/c24/c24.rpy:149
translate german c24s001_Bet_69b8fde0:

    # bet "En ese caso, creo que estoy de acuerdo en devolverte la camiseta. Por esta vez."
    bet "In diesem Fall werde ich das Hemd zurückgeben. Nur dieses eine Mal."

# game/scripts/c24/c24.rpy:151
translate german c24s001_Bet_007a24b7:

    # bet "¿Así o quieres que me desnude del todo?"
    bet "Soll ich mich also komplett ausziehen?"

# game/scripts/c24/c24.rpy:152
translate german c24s001_Bet_3c378150:

    # mc "Querré, pero todo a su tiempo. Ahora es el momento de entregar las caricias prometidas."
    mc "Das werde ich, aber alles zu seiner Zeit. Jetzt ist der Zeitpunkt gekommen, die versprochenen Zärtlichkeiten zu geben."

# game/scripts/c24/c24.rpy:153
translate german c24s001_Bet_1c7d23d5:

    # mc "Túmbate, por favor, quiero disfrutar de ese cuerpo como es debido."
