    # mc "No lo pongo en duda. Mi hermana es muy lista."
    mc "Ich zweifle nicht daran. Meine Schwester ist sehr klug."

# game/scripts/c24/c24.rpy:840
translate german c24s002_Breakfast_04c53609:

    # emm "Espero que no te enfadaras por lo de la ropa, Tía [bet]."
    emm "Ich hoffe, du warst nicht verärgert über die Kleidung, Tante [bet]."

# game/scripts/c24/c24.rpy:842
translate german c24s002_Breakfast_edbffd56:

    # bet "Al principio me enfadé un poco, pero luego..."
    bet "Zuerst war ich etwas verärgert, aber dann..."

# game/scripts/c24/c24.rpy:843
translate german c24s002_Breakfast_a32e9648:

    # bet "Digamos que te perdono. *Risa*"
    bet "Sagen wir einfach, ich verzeihe dir. *lacht*"

# game/scripts/c24/c24.rpy:845
translate german c24s002_Breakfast_7dddbaac:

    # emm "Entonces vestíos y vamos a desayunar. A menos que queráis un segundo round matutino."
    emm "Also, zieht euch an und lasst uns frühstücken. Es sei denn, ihr wollt heute Morgen noch eine zweite Runde."

# game/scripts/c24/c24.rpy:846
translate german c24s002_Breakfast_b651fb73:

    # mc "No, [emm]. Vamos a vestirnos y a desayunar."
    mc "Nein, [emm]. Lass uns anziehen und frühstücken."

# game/scripts/c24/c24.rpy:848
translate german c24s002_Breakfast_2d06905b:

    # bet "¿Segundo round? Ilusa..."
    bet "Zweite Runde? Naiv..."

# game/scripts/c24/c24.rpy:850
translate german c24s002_Breakfast_99ad4a0a:

    # emm "¿Qué? ¿Follasteis dos veces en vuestra primera vez?"
    emm "Was? Ihr hattet beim ersten Mal zweimal Sex?"

# game/scripts/c24/c24.rpy:852
translate german c24s002_Breakfast_676d0396:

    # emm "Conmigo solo fue una vez..."
    emm "Mir ist das nur einmal passiert..."

# game/scripts/c24/c24.rpy:853
translate german c24s002_Breakfast_71bdf1e5:

    # mc "Tu eras virgen, [emm]. Te pasaste dos días andando como si hubieras dejado el caballo en la puerta del saloon."
    mc "Du warst Jungfrau, [emm]. Du bist zwei Tage lang herumgelaufen, als hättest du dein Pferd vor der Saloontür zurückgelassen."

# game/scripts/c24/c24.rpy:855
translate german c24s002_Breakfast_0c97cee5:

    # emm "¿Qué? ¿Tía [bet] no era virgen? Creía que las monjas..."
    emm "Was? Tante [bet] war keine Jungfrau mehr? Ich dachte, Nonnen..."

# game/scripts/c24/c24.rpy:857
translate german c24s002_Breakfast_c2aea1ca:

    # bet "*Risa* Algún día te lo explicaré. De momento me voy a vestir y vamos a desayunar."
    bet "*Lacht* Ich erkläre es dir irgendwann. Jetzt ziehe ich mich erst mal an und wir frühstücken."

# game/scripts/c24/c24.rpy:858
translate german c24s002_Breakfast_74611842:

    # bet "¡Estoy hambrienta!"
    bet "Ich habe Hunger!"

# game/scripts/c24/c24.rpy:861
translate german c24s002_Breakfast_faa0be63:

    # "Después de desayunar, vais a devolver el coche de [emm] antes de ir a la iglesia."
    "Nach dem Frühstück geben Sie den Mietwagen [emm] zurück, bevor Sie zur Kirche gehen."

# game/scripts/c24/c24.rpy:871
translate german c24s002_Meanwhile_Kim_Mar_Kat_3e742448:

    # "Mientras tanto, en casa..."
    "Währenddessen zu Hause..."

# game/scripts/c24/c24.rpy:874
translate german c24s002_Meanwhile_Kim_Mar_Kat_adb8ee67:

    # mom "Buenos días, [kim] y [kat]."
    mom "Guten Morgen, [kim] und [kat]."

# game/scripts/c24/c24.rpy:875
translate german c24s002_Meanwhile_Kim_Mar_Kat_ebe2be00:

    # mom "¿Cómo fue el trabajo, [kim]? No he tenido oportunidad de preguntarte."
    mom "Wie war der Job, [kim]? Ich hatte noch keine Gelegenheit, dich zu fragen."

# game/scripts/c24/c24.rpy:877
translate german c24s002_Meanwhile_Kim_Mar_Kat_8764505b:

    # kat "Buenos días, [mar]. Voy a preparar el café."
    kat "Guten Morgen, [mar]. Ich werde den Kaffee kochen."

# game/scripts/c24/c24.rpy:878
translate german c24s002_Meanwhile_Kim_Mar_Kat_981a280b:

    # kim "Buenos días, [mar]."
    kim "Guten Morgen, [mar]."

# game/scripts/c24/c24.rpy:879
translate german c24s002_Meanwhile_Kim_Mar_Kat_0e81fe60:

    # kim "Fue muy bien. El yate era increíble, y estuve casi todo el rato en el helipuerto, recibiendo a los invitados."
    kim "Es lief sehr gut. Die Yacht war unglaublich, und ich verbrachte fast die gesamte Zeit auf dem Hubschrauberlandeplatz und begrüßte die Gäste."

# game/scripts/c24/c24.rpy:881
translate german c24s002_Meanwhile_Kim_Mar_Kat_4658f748:

    # mom "¿Un yate con helipuerto? Tenía que ser enorme."
    mom "Eine Yacht mit Hubschrauberlandeplatz? Die musste riesig sein."

# game/scripts/c24/c24.rpy:883
translate german c24s002_Meanwhile_Kim_Mar_Kat_d40564ed:

    # kim "Era gigantesco. Hay otro evento mañana en el mismo yate y me han llamado de la agencia porque me vuelven a contratar."
    kim "Es war gigantisch. Morgen findet eine weitere Veranstaltung auf derselben Yacht statt, und die Agentur hat mich angerufen, weil sie mich wieder engagieren wollen."

# game/scripts/c24/c24.rpy:884
translate german c24s002_Meanwhile_Kim_Mar_Kat_572aa522:

    # kim "Estoy muy contenta. Si me siguen llamando de eventos así, no voy a tener problemas económicos por un tiempo."
    kim "Ich bin so glücklich. Wenn ich weiterhin Anfragen für solche Veranstaltungen bekomme, werde ich erst einmal keine Geldprobleme haben."

# game/scripts/c24/c24.rpy:885
translate german c24s002_Meanwhile_Kim_Mar_Kat_c3af110c:

    # kim "Me daba miedo no encontrar demasiados trabajos en el área de Newport."
    kim "Ich hatte Angst, dass ich in der Gegend um Newport nicht viele Jobs finden würde."

# game/scripts/c24/c24.rpy:887
translate german c24s002_Meanwhile_Kim_Mar_Kat_0ee60a3b:

    # mom "[kim], si en algún momento tuvieras algún tipo de problema de dinero, no te preocupes por pagar la residencia."
    mom "[kim], falls Sie zu irgendeinem Zeitpunkt in finanzielle Schwierigkeiten geraten, brauchen Sie sich keine Sorgen um die Bezahlung der Unterkunft zu machen."

# game/scripts/c24/c24.rpy:888
translate german c24s002_Meanwhile_Kim_Mar_Kat_596f889b:

    # mom "Podemos aplazar los pagos el tiempo que sea necesario."
    mom "Wir können die Zahlungen so lange wie nötig hinauszögern."

# game/scripts/c24/c24.rpy:890
translate german c24s002_Meanwhile_Kim_Mar_Kat_eb9d0edd:

    # kim "Gracias, [mar], pero no creo que sea necesario. Este tipo de eventos paga muy bien."
    kim "Danke, [mar], aber ich glaube nicht, dass es nötig ist. Solche Veranstaltungen sind sehr gut bezahlt."

# game/scripts/c24/c24.rpy:891
translate german c24s002_Meanwhile_Kim_Mar_Kat_51dcb881:

    # kim "Y si la agencia me ha llamado para otro evento del mismo cliente que paga aún mejor, significa que están contentos conmigo."
    kim "Und wenn die Agentur mich für eine weitere Veranstaltung für denselben Kunden anruft, der sogar noch besser zahlt, bedeutet das, dass sie mit mir zufrieden sind."

# game/scripts/c24/c24.rpy:893
translate german c24s002_Meanwhile_Kim_Mar_Kat_b087125c:

    # kat "Aquí tienes tu café, [kim]."
    kat "Hier ist Ihr Kaffee, [kim]."

# game/scripts/c24/c24.rpy:894
translate german c24s002_Meanwhile_Kim_Mar_Kat_4304a774:

    # kim "Gracias, [kat]."
    kim "Vielen Dank, [kat]."

# game/scripts/c24/c24.rpy:896
translate german c24s002_Meanwhile_Kim_Mar_Kat_8adf96a4:

    # kat "¿Tienes algo que hacer ahora mismo, [mar]? ¿Tienes unos minutos libres?"
    kat "Hast du gerade etwas zu erledigen, [mar]? Hast du ein paar Minuten Zeit?"

# game/scripts/c24/c24.rpy:898
translate german c24s002_Meanwhile_Kim_Mar_Kat_8a55e7e1:

    # mom "Para vosotras siempre tengo tiempo libre, ¿por qué? ¿Qué necesitáis?"
    mom "Ich habe immer Zeit für dich, warum? Was brauchst du?"

# game/scripts/c24/c24.rpy:900
translate german c24s002_Meanwhile_Kim_Mar_Kat_9aac37a3:

    # kat "Yo no necesito nada en concreto, pero lo que hizo [deb.nick] el otro día me dio una idea."
    kat "Ich brauche nichts Bestimmtes, aber was [deb.nick] neulich gemacht hat, hat mir eine Idee gegeben."

# game/scripts/c24/c24.rpy:901
translate german c24s002_Meanwhile_Kim_Mar_Kat_d2733ffc:

    # kat "[kim] lleva días queriendo hablar contigo, pero siempre lo retrasa diciendo que estás muy ocupada."
    kat "[kim] möchte schon seit Tagen mit dir sprechen, aber du verschiebst es immer wieder mit der Begründung, du seist sehr beschäftigt."

# game/scripts/c24/c24.rpy:903
translate german c24s002_Meanwhile_Kim_Mar_Kat_0252c9ed:

    # kim "¡[kat]!"
    kim "[kat]!"

# game/scripts/c24/c24.rpy:905
translate german c24s002_Meanwhile_Kim_Mar_Kat_8128c913:

    # kat "Y no os voy a encerrar en la cocina para que habléis, pero si ahora tienes un momento para que lo hagáis..."
    kat "Und ich werde dich jetzt nicht in der Küche einsperren, um mit dir zu reden, aber wenn du jetzt einen Moment Zeit dafür hast..."

# game/scripts/c24/c24.rpy:906
translate german c24s002_Meanwhile_Kim_Mar_Kat_4c5d3b6a:

    # kat "Creo que si nadie fuerza un poco la situación, vamos a acabar nuestras carreras antes de que [kim] se atreva a hacerlo."
    kat "Ich glaube, wenn niemand die Situation ein wenig forciert, werden wir unsere Karrieren beenden, bevor [kim] es überhaupt wagt."

# game/scripts/c24/c24.rpy:908
translate german c24s002_Meanwhile_Kim_Mar_Kat_241a1e06:

    # kim "¡[kat]! ¡No hay prisa en hablarlo!"
    kim "[kat]! Es gibt keine Eile, darüber zu reden!"

# game/scripts/c24/c24.rpy:910
translate german c24s002_Meanwhile_Kim_Mar_Kat_2a9e0064:

    # mom "¿Qué pasa [kim]? ¿Hay algo en la casa que no te guste?"
    mom "Was ist los, [kim]? Gibt es etwas an dem Haus, das dir nicht gefällt?"

# game/scripts/c24/c24.rpy:912
translate german c24s002_Meanwhile_Kim_Mar_Kat_6726d263:

    # kat "*Risa* Más bien al contrario."
    kat "*Lachen* Ganz im Gegenteil."

# game/scripts/c24/c24.rpy:913
translate german c24s002_Meanwhile_Kim_Mar_Kat_396339f7:

    # kat "Bueno, yo os dejo y voy a tomarme el café a mi habitación."
    kat "Nun gut, ich verabschiede mich und gehe in mein Zimmer, um meinen Kaffee zu trinken."

# game/scripts/c24/c24.rpy:915
translate german c24s002_Meanwhile_Kim_Mar_Kat_daffc386:

    # kim "¡[kat], esta me la apunto!"
    kim "[kat], das notiere ich mir!"

# game/scripts/c24/c24.rpy:917
translate german c24s002_Meanwhile_Kim_Mar_Kat_9c97a615:

    # mom "¿Qué pasa, [kim]?"
    mom "Was geht, [kim]?"

# game/scripts/c24/c24.rpy:919
translate german c24s002_Meanwhile_Kim_Mar_Kat_b9c2dae2:

    # kim "No es nada, en serio. Es sólo una tontería."
    kim "Das ist eigentlich nichts. Es ist einfach nur albern."

# game/scripts/c24/c24.rpy:921
translate german c24s002_Meanwhile_Kim_Mar_Kat_a6248df6:

    # mom "Sabes que puedes hablar conmigo de cualquier cosa, ¿verdad?"
    mom "Du weißt, dass du mit mir über alles reden kannst, richtig?"

# game/scripts/c24/c24.rpy:923
translate german c24s002_Meanwhile_Kim_Mar_Kat_33cb449b:

    # mom "*Risa* Acabo de sonar como sonaba cuando hablaba con [emm] cuando era más joven."
    mom "*Lacht* Ich klang genau so, wie ich früher mit [emm] gesprochen habe, als ich jünger war."

# game/scripts/c24/c24.rpy:924
translate german c24s002_Meanwhile_Kim_Mar_Kat_6693b324:

    # mom "Me sale la vena maternal con tantas chicas en casa."
    mom "Bei so vielen Mädchen zu Hause kommen meine Mutterinstinkte zum Vorschein."

# game/scripts/c24/c24.rpy:926
translate german c24s002_Meanwhile_Kim_Mar_Kat_64ee79a9:

    # kim "Precisamente por eso..."
    kim "Genau deshalb..."

# game/scripts/c24/c24.rpy:928
translate german c24s002_Meanwhile_Kim_Mar_Kat_06ebc64d:

    # mom "¿Es por lo del otro día cuando estuviste a punto de llamarme Mamá?"
    mom "Liegt es an dem, was neulich passiert ist, als du mich beinahe Mama genannt hättest?"

# game/scripts/c24/c24.rpy:929
translate german c24s002_Meanwhile_Kim_Mar_Kat_8a940879:

    # mom "No te preocupes por eso. A mí no me importa... Es más, me gusta que te sientas tan cómoda conmigo."
    mom "Mach dir keine Sorgen. Es macht mir nichts aus... Im Gegenteil, ich freue mich, dass du dich bei mir so wohl fühlst."

# game/scripts/c24/c24.rpy:930
translate german c24s002_Meanwhile_Kim_Mar_Kat_5c4ce74c:

    # mom "Ven aquí, dame un abrazo."
    mom "Komm her, umarme mich."

# game/scripts/c24/c24.rpy:932
translate german c24s002_Meanwhile_Kim_Mar_Kat_5de54c7a:

    # kim "Gracias, [mar]. Pero solo tiene que ver parcialmente con eso."
    kim "Danke, [mar]. Aber es steht nur teilweise damit in Zusammenhang."

# game/scripts/c24/c24.rpy:933
translate german c24s002_Meanwhile_Kim_Mar_Kat_666b222d:

    # kim "Me gusta mucho la relación que estamos desarrollando y no quiero estropearla."
    kim "Mir gefällt die Beziehung, die wir aufbauen, sehr gut und ich möchte sie nicht ruinieren."

# game/scripts/c24/c24.rpy:935
translate german c24s002_Meanwhile_Kim_Mar_Kat_7eb4d1d9:

    # mom "¿Por qué ibas a estropearla? Eres una chica fantástica, [kim], y no creo que hayas hecho nada malo desde que has llegado a casa."
    mom "Warum solltest du das ruinieren? Du bist ein fantastisches Mädchen, [kim], und ich glaube nicht, dass du seit deiner Heimkehr etwas falsch gemacht hast."

# game/scripts/c24/c24.rpy:937
translate german c24s002_Meanwhile_Kim_Mar_Kat_daaea5ea:

    # kim "Al final me vas a emocionar. *Risa* Si me pongo a llorar como una tonta será culpa tuya."
    kim "Du bringst mich am Ende noch zum Weinen. *lacht* Wenn ich dann anfange wie eine Idiotin zu heulen, bist du schuld."

# game/scripts/c24/c24.rpy:939
translate german c24s002_Meanwhile_Kim_Mar_Kat_31f1468d:

    # mom "Si necesitas llorar como una tonta, hazlo. Si quieres que lloremos juntas, explícame qué te pasa y lloramos juntas."
    mom "Wenn du hemmungslos weinen musst, nur zu. Wenn du willst, dass wir zusammen weinen, sag mir, was los ist, und wir weinen zusammen."

# game/scripts/c24/c24.rpy:941
translate german c24s002_Meanwhile_Kim_Mar_Kat_bcd80104:

    # kim "Lo pones tan fácil y tan difícil a la vez..."
    kim "Du machst es mir gleichzeitig so einfach und so schwer..."

# game/scripts/c24/c24.rpy:943
translate german c24s002_Meanwhile_Kim_Mar_Kat_1095ab3d:

    # mom "[kim], dime que te pasa. Va a ser muy difícil ayudarte si no me lo explicas."
    mom "[kim], sag mir, was los ist. Es wird sehr schwierig sein, dir zu helfen, wenn du es mir nicht erklärst."

# game/scripts/c24/c24.rpy:945
translate german c24s002_Meanwhile_Kim_Mar_Kat_340e6cf6:

    # kim "Es por [mc]."
    kim "Das liegt an [mc]."

# game/scripts/c24/c24.rpy:947
translate german c24s002_Meanwhile_Kim_Mar_Kat_332a4ee8:

    # mom "¿Qué pasa con él? ¿Ha hecho algo malo? ¿Te ha dicho algo que no te haya gustado?"
    mom "Was ist los mit ihm? Hat er etwas falsch gemacht? Hat er etwas gesagt, was dir nicht gefallen hat?"

# game/scripts/c24/c24.rpy:949
translate german c24s002_Meanwhile_Kim_Mar_Kat_45bba21c:

    # mom "Aparte de la tontería que dijo sobre tu maquillaje corporal, claro."
    mom "Abgesehen von dem Unsinn, den sie über deine Körperzusammensetzung von sich gegeben hat, natürlich."

# game/scripts/c24/c24.rpy:951
translate german c24s002_Meanwhile_Kim_Mar_Kat_b873221a:

    # kim "No. No ha hecho nada malo. Es justo al revés. Es... demasiado bueno conmigo..."
    kim "Nein. Er hat nichts falsch gemacht. Ganz im Gegenteil. Er ist... viel zu gut zu mir..."

# game/scripts/c24/c24.rpy:953
translate german c24s002_Meanwhile_Kim_Mar_Kat_875e2296:

    # mom "Y crees que estás empezando a desarrollar sentimientos por él, ¿no?"
    mom "Und du glaubst, du entwickelst Gefühle für ihn, nicht wahr?"

# game/scripts/c24/c24.rpy:955
translate german c24s002_Meanwhile_Kim_Mar_Kat_c77fa3fa:

    # kim "¿Cómo lo sabes?"
    kim "Woher weißt du das?"

# game/scripts/c24/c24.rpy:957
translate german c24s002_Meanwhile_Kim_Mar_Kat_8c059369:

    # mom "Sólo hace falta verte cuando está cerca, cielo."
    mom "Du brauchst mich nur zu sehen, wenn ich in der Nähe bin, Liebling."

# game/scripts/c24/c24.rpy:958
translate german c24s002_Meanwhile_Kim_Mar_Kat_dd583115:

    # mom "Cuando empezamos a sentir algo por alguien creemos que nadie se da cuenta, y tan solo no se dan cuenta quienes no nos ven... y [mc]."
    mom "Wenn wir anfangen, etwas für jemanden zu empfinden, denken wir, dass es niemand merkt, und nur diejenigen, die uns nicht sehen, bemerken es nicht... und [mc]."

# game/scripts/c24/c24.rpy:959
translate german c24s002_Meanwhile_Kim_Mar_Kat_cfec4b4f:

    # mom "Además, yo pasé por lo mismo, con lo que reconozco los síntomas."
    mom "Außerdem habe ich das Gleiche durchgemacht, daher erkenne ich die Symptome wieder."

# game/scripts/c24/c24.rpy:962
translate german c24s002_Meanwhile_Kim_Mar_Kat_f922bef6:

    # kim "¿Qué? ¿Tú?"
    kim "Was? Du?"

# game/scripts/c24/c24.rpy:965
translate german c24s002_Meanwhile_Kim_Mar_Kat_eb6333b2:

    # mom "Sí. Fue unos días antes de que llegarais. Me sentía confundida y creía que me estaba enamorando de mi propio hijo."
    mom "Ja. Das war ein paar Tage vor deiner Ankunft. Ich war verwirrt und dachte, ich würde mich in meinen eigenen Sohn verlieben."

# game/scripts/c24/c24.rpy:967
translate german c24s002_Meanwhile_Kim_Mar_Kat_86bd4195:

    # mom "Sí. Fue unos días antes de que llegarais. Me sentía confundida y creía que me estaba enamorando de [mc]."
    mom "Ja. Das war ein paar Tage vor deiner Ankunft. Ich war verwirrt und dachte, ich würde mich in [mc] verlieben."

# game/scripts/c24/c24.rpy:968
translate german c24s002_Meanwhile_Kim_Mar_Kat_c3e1e9f9:

    # mom "Por suerte, [mc] tiene la costumbre de hablarlo todo y lo aclaramos muy rápido antes de que nadie saliera herido."
    mom "Zum Glück hat [mc] die Angewohnheit, alles vorher ausführlich zu besprechen, und wir konnten die Angelegenheit sehr schnell klären, bevor jemand verletzt wurde."

# game/scripts/c24/c24.rpy:969
translate german c24s002_Meanwhile_Kim_Mar_Kat_3f4e2da7:

    # mom "Quizás deberías hacer lo mismo. ¿Lo has hecho ya?"
    mom "Vielleicht solltest du das Gleiche tun. Hast du es schon getan?"

# game/scripts/c24/c24.rpy:972
translate german c24s002_Meanwhile_Kim_Mar_Kat_db849359:

    # kim "Por eso es un problema..."
    kim "Deshalb ist es ein Problem..."

# game/scripts/c24/c24.rpy:974
translate german c24s002_Meanwhile_Kim_Mar_Kat_2414f6c0:

    # mom "¿Te preocupa compartir a [mc] conmigo?"
    mom "Hast du Bedenken, [mc] mit mir zu teilen?"

# game/scripts/c24/c24.rpy:976
translate german c24s002_Meanwhile_Kim_Mar_Kat_58a888ab:

    # kim "Me preocupa cómo te vas a sentir tú si intento algo con [mc]. Salís juntos."
    kim "Ich mache mir Sorgen darüber, wie du reagieren wirst, wenn ich etwas mit [mc] versuche. Ihr zwei seid ja zusammen."

# game/scripts/c24/c24.rpy:978
translate german c24s002_Meanwhile_Kim_Mar_Kat_702f9a83:

    # kim "Y es tu hijo."
    kim "Und er ist dein Sohn."

# game/scripts/c24/c24.rpy:981
translate german c24s002_Meanwhile_Kim_Mar_Kat_e11d19e1:

    # mom "Ya sabes que no tenemos una relación exclusiva y que no soy la única mujer con la que sale."
    mom "Du weißt, dass wir keine exklusive Beziehung haben und dass ich nicht die einzige Frau bin, mit der er ausgeht."

# game/scripts/c24/c24.rpy:982
translate german c24s002_Meanwhile_Kim_Mar_Kat_8a03cbc8:

    # mom "No sé por qué me debería importar que una chica tan fantástica como tú se uniera al harén."
    mom "Ich verstehe nicht, warum es mich kümmern sollte, wenn ein so fantastisches Mädchen wie du dem Harem beitritt."

# game/scripts/c24/c24.rpy:984
translate german c24s002_Meanwhile_Kim_Mar_Kat_e1945317:

    # mom "Salimos juntos, pero nunca hemos hablado de exclusividad."
    mom "Wir gehen zusammen aus, aber wir haben nie über Exklusivität gesprochen."

# game/scripts/c24/c24.rpy:985
translate german c24s002_Meanwhile_Kim_Mar_Kat_b53d6dcd:

    # mom "Si alguna vez [mc] se plantea tener un harén, me encantaría que tú formaras parte de él, si quieres."
    mom "Falls [mc] jemals darüber nachdenkt, einen Harem zu haben, würde ich mich freuen, wenn du ein Teil davon wärst, falls du das möchtest."

# game/scripts/c24/c24.rpy:986
translate german c24s002_Meanwhile_Kim_Mar_Kat_79e93dbf:

    # mom "Pero para eso, primero tienes que hablar con él. ¿Lo has hecho ya?"
    mom "Aber dafür musst du zuerst mit ihm sprechen. Hast du das schon getan?"

# game/scripts/c24/c24.rpy:988
translate german c24s002_Meanwhile_Kim_Mar_Kat_1b5d5547:

    # kim "Lo intenté... o para ser más exactos, lo hablé."
    kim "Ich habe es versucht... oder genauer gesagt, ich habe darüber gesprochen."

# game/scripts/c24/c24.rpy:989
translate german c24s002_Meanwhile_Kim_Mar_Kat_198169d6:

    # kim "Se dio cuenta de que me pasaba algo cuando estaba cerca y me preguntó. No pude mentirle."
    kim "Als sie in meiner Nähe war, merkte sie, dass etwas nicht stimmte, und fragte nach. Ich konnte sie nicht anlügen."

# game/scripts/c24/c24.rpy:991
translate german c24s002_Meanwhile_Kim_Mar_Kat_031d8a54:

    # mom "¿Y qué dijo? No estaríamos hablando de esto si no te hubiera dado esperanzas."
    mom "Und was hat er gesagt? Wir würden jetzt nicht darüber reden, wenn er euch nicht Hoffnung gegeben hätte."

# game/scripts/c24/c24.rpy:992
translate german c24s002_Meanwhile_Kim_Mar_Kat_1976cc2f:

    # mom "Y si te dio falsas esperanzas se lo haremos pagar juntas."
    mom "Und wenn er dir falsche Hoffnungen gemacht hat, werden wir ihn gemeinsam dafür büßen lassen."

# game/scripts/c24/c24.rpy:994
translate german c24s002_Meanwhile_Kim_Mar_Kat_b9b815f2:

    # kim "No, se comportó muy bien. Le dije que me preocupaba tu opinión y dijo que no me daría una respuesta... o esperanzas... hasta que no lo hablara contigo."
    kim "Nein, er hat sich sehr gut benommen. Ich sagte ihm, dass ich mir Sorgen um Ihre Meinung mache, und er sagte, er würde mir keine Antwort geben ... oder Hoffnung machen ... bis er mit Ihnen darüber gesprochen hätte."

# game/scripts/c24/c24.rpy:996
translate german c24s002_Meanwhile_Kim_Mar_Kat_c510c23b:

    # mom "Típico de [mc]. Él ya debería saber lo que yo iba a responder."
    mom "Typisch für [mc]. Er sollte eigentlich schon wissen, was ich antworten wollte."

# game/scripts/c24/c24.rpy:998
translate german c24s002_Meanwhile_Kim_Mar_Kat_2874cf78:

    # mom "Me encantaría que salieras con mi hijo si los dos queréis."
    mom "Ich würde mich sehr freuen, wenn Sie mit meinem Sohn ausgehen würden, falls Sie beide das möchten."

# game/scripts/c24/c24.rpy:1000
translate german c24s002_Meanwhile_Kim_Mar_Kat_d18c97e6:

    # mom "Me encantaría que salieras con [mc] si los dos queréis."
    mom "Ich würde mich freuen, wenn du mit [mc] ausgehen würdest, falls ihr beide das möchtet."

# game/scripts/c24/c24.rpy:1001
translate german c24s002_Meanwhile_Kim_Mar_Kat_3ff3fc95:

    # mom "Pero quería que lo solucionaras en tus propios términos sin importar lo que él quisiera o pensara sobre mi respuesta."
    mom "Aber ich wollte, dass du das auf deine eigene Art und Weise regelst, unabhängig davon, was er wollte oder was er von meiner Antwort hielt."

# game/scripts/c24/c24.rpy:1002
translate german c24s002_Meanwhile_Kim_Mar_Kat_d73474a4:

    # mom "Y no te dio esperanzas para que, una vez te diera mi respuesta, todo dependiera de ti."
    mom "Und er hat dir keine Hoffnung gemacht, dass, sobald ich dir meine Antwort gegeben habe, alles von dir abhängen würde."

# game/scripts/c24/c24.rpy:1004
translate german c24s002_Meanwhile_Kim_Mar_Kat_1a8e2c1a:

    # kim "Para lo inocente que es a veces, parece un plan muy taimado. *Risita*"
    kim "So unschuldig er manchmal auch ist, scheint das ein ziemlich raffinierter Plan zu sein. *Kichern*"

# game/scripts/c24/c24.rpy:1006
translate german c24s002_Meanwhile_Kim_Mar_Kat_7b05d62a:

    # mom "Es muy inocente para muchas cosas, y eso me encanta de él, pero creo que está evolucionando mucho."
    mom "Er ist in vielen Dingen sehr naiv, und das liebe ich an ihm, aber ich denke, er entwickelt sich sehr weiter."

# game/scripts/c24/c24.rpy:1007
translate german c24s002_Meanwhile_Kim_Mar_Kat_73363c8b:

    # mom "Cuando volvió de la universidad, seguramente ni siquiera se hubiera dado cuenta de que te pasaba algo con él."
    mom "Als er von der Universität zurückkam, hätte er wahrscheinlich nicht einmal gemerkt, dass du etwas mit ihm hattest."

# game/scripts/c24/c24.rpy:1009
translate german c24s002_Meanwhile_Kim_Mar_Kat_f312157b:

