

# game/scripts/c19/c19.rpy:38
translate german c19s001_JamaalSamantha_5118050b:

    # nor "Pasa a la piscina antes de ir a ponerte el bañador, si tienes curiosidad. Descubrirás que hay alguien con bañador de cuerpo entero."
    nor "Wenn du neugierig bist, geh doch mal zum Pool, bevor du deinen Badeanzug anziehst. Du wirst sehen, dass dort jemand einen Badeanzug trägt."

# game/scripts/c19/c19.rpy:39
translate german c19s001_JamaalSamantha_6d705a83:

    # mc "*Risa* Ya lo supongo. No esperaba que la mayoría fuera como vais tú y [eri]."
    mc "*Lacht* Ich denke schon. Ich hätte nicht erwartet, dass die meisten von ihnen so sind wie du und [eri]."

# game/scripts/c19/c19.rpy:41
translate german c19s001_JamaalSamantha_311ca098:

    # nor "Yo voy a la cocina a por más cosas."
    nor "Ich gehe in die Küche, um noch mehr Sachen zu holen."

# game/scripts/c19/c19.rpy:43
translate german c19s001_JamaalSamantha_dd4c0927:

    # "Levantas una ceja mientras la miras inquisitivamente."
    "Du ziehst fragend eine Augenbraue hoch."

# game/scripts/c19/c19.rpy:45
translate german c19s001_JamaalSamantha_357a6c4c:

    # nor "Vaaale, no voy a coger peso."
    nor "Okay, ich werde nicht zunehmen."

# game/scripts/c19/c19.rpy:46
translate german c19s001_JamaalSamantha_22cabccc:

    # mc "Voy a saludar y a ponerme el bañador. En unos minutos iré a ayudarte."
    mc "Ich werde kurz hallo sagen und meinen Badeanzug anziehen. Ich komme in ein paar Minuten und helfe Ihnen."

# game/scripts/c19/c19.rpy:47
translate german c19s001_JamaalSamantha_2aaf243c:

    # nor "OK. Te espero allí."
    nor "Okay. Ich warte dort auf dich."

# game/scripts/c19/c19.rpy:49
translate german c19s001_JamaalSamantha_fe114f6e:

    # mc "¡Samantha y Jamaal! ¡Ya habéis llegado! ¿Dónde está Simone?"
    mc "Samantha und Jamaal! Ihr seid da! Wo ist Simone?"

# game/scripts/c19/c19.rpy:50
translate german c19s001_JamaalSamantha_e700eaaf:

    # mcp "(Samantha haciendo topless. La primera sorpresa del día.)"
    mcp "(Samantha oben ohne. Die erste Überraschung des Tages.)"

# game/scripts/c19/c19.rpy:56
translate german c19s001_JamaalSamantha_503e55c5:

    # sam "Ha ido a cambiarse a la habitación de [emm]."
    sam "Sie ist in Zimmer [emm] gegangen, um sich umzuziehen."

# game/scripts/c19/c19.rpy:57
translate german c19s001_JamaalSamantha_43126fd6:

    # jam "El más rápido cambiándome he sido yo. *Risa* No tenía que subir a ninguna habitación y he escondido la ropa detrás de un seto."
    jam "Ich war am schnellsten beim Umziehen. *lacht* Ich musste nicht nach oben gehen und habe meine Kleidung hinter einer Hecke versteckt."

# game/scripts/c19/c19.rpy:58
translate german c19s001_JamaalSamantha_cd735ec2:

    # mc "*Risa* ¿Qué llevas puesto?"
    mc "*lacht* Was trägst du denn?"

# game/scripts/c19/c19.rpy:60
translate german c19s001_JamaalSamantha_5db16ac1:

    # jam "Me escribiste que viniera en bikini. *Risa* Me probé uno de mi madre, pero no lo llenaba, con lo que me puse este que compré para una fiesta hace un par de años."
    jam "Du hast mir geschrieben, ich solle im Bikini kommen. *Lacht* Ich habe einen von meiner Mutter anprobiert, aber der hat nicht gepasst, also habe ich diesen hier angezogen, den ich vor ein paar Jahren für eine Party gekauft habe."

# game/scripts/c19/c19.rpy:61
translate german c19s001_JamaalSamantha_83de7a24:

    # mc "*Risa* ¡Estás ridículo! Más incluso de lo habitual."
    mc "*Lacht* Du siehst lächerlich aus! Noch lächerlicher als sonst."

# game/scripts/c19/c19.rpy:63
translate german c19s001_JamaalSamantha_ab0d92b9:

    # jam "Al menos yo no llevo una camiseta con un puerco dibujado. *Risa*"
    jam "Wenigstens trage ich kein T-Shirt mit einem Schwein drauf. *lacht*"

# game/scripts/c19/c19.rpy:64
translate german c19s001_JamaalSamantha_cb3a2f52:

    # mc "¡Me la regalaste tú antes de ir a la universidad! *Risa*"
    mc "Du hast es mir geschenkt, bevor ich an die Uni ging! *lacht*"

# game/scripts/c19/c19.rpy:66
translate german c19s001_JamaalSamantha_51c20bf7:

    # jam "Que yo tenga un gusto pésimo para regalar ropa no significa que te la tengas que poner. *Risa* Además, te la regalé porque entonces estabas hecho un cerdo. Gordo."
    jam "Nur weil ich einen schrecklichen Modegeschmack habe, heißt das nicht, dass du die Sachen tragen musst. *lacht* Außerdem habe ich sie dir geschenkt, weil du damals ein richtiges Schwein warst. Fett."

# game/scripts/c19/c19.rpy:67
translate german c19s001_JamaalSamantha_2528113c:

    # mc "Volviendo a tu monokini... No sé si atreverme a preguntar que has hecho con tus herramientas para que te quepan ahí. *Risa*"
    mc "Um nochmal auf deinen Monokini zurückzukommen … Ich weiß nicht, ob ich mich traue zu fragen, was du mit deinen Werkzeugen angestellt hast, damit sie da reinpassen. *lacht*"

# game/scripts/c19/c19.rpy:69
translate german c19s001_JamaalSamantha_8e03d075:

    # jam "He tomado malas decisiones en mi vida, como regalarte esa camiseta. *Risa* Pero estar sentado encima de mis pelotas todo el día va a ser una de las peores."
    jam "Ich habe in meinem Leben schon ein paar dumme Entscheidungen getroffen, zum Beispiel dir das Hemd zu schenken. *lacht* Aber den ganzen Tag auf meinen Eiern zu sitzen, wird eine der schlimmsten sein."

# game/scripts/c19/c19.rpy:70
translate german c19s001_JamaalSamantha_326f4bd9:

    # mc "También has tomado alguna buena. *Risa* Te hiciste amigo mío."
    mc "Du hattest auch ein paar gute. *lacht* Du bist mein Freund geworden."

# game/scripts/c19/c19.rpy:71
translate german c19s001_JamaalSamantha_5bdfd4aa:

    # jam "Dabas pena, siempre sentado solo, tú, tu panza, y tu caja de donuts. *Risa* Lo mejor de nuestra amistad fueron los donuts."
    jam "Du warst so erbärmlich, immer nur allein da, du, dein Bauch und deine Schachtel Donuts. *Lacht* Das Beste an unserer Freundschaft waren die Donuts."

# game/scripts/c19/c19.rpy:73
translate german c19s001_JamaalSamantha_10777086:

    # sam "No vais a cambiar nunca, ¿verdad?"
    sam "Du wirst dich nie ändern, oder?"

# game/scripts/c19/c19.rpy:74
translate german c19s001_JamaalSamantha_eca07bee:

    # mc "Yo he cambiado. Ya no llevo la panza ni la caja de donuts."
    mc "Ich habe mich verändert. Ich habe keinen Bauch mehr und trage auch keine Schachtel Donuts mehr mit mir herum."

# game/scripts/c19/c19.rpy:76
translate german c19s001_JamaalSamantha_1eddbf8f:

    # jam "Y yo también. *Risa* Sigo siendo su amigo aunque ya no tenga donuts."
    jam "Ich auch. *lacht* Ich bin immer noch sein Freund, obwohl ich keine Donuts mehr esse."

# game/scripts/c19/c19.rpy:77
translate german c19s001_JamaalSamantha_fe6cdaac:

    # mc "Porque soy tu único amigo y no puedes vivir sin mí. *Risa*"
    mc "Weil ich deine einzige Freundin bin und du ohne mich nicht leben kannst. *lacht*"

# game/scripts/c19/c19.rpy:79
translate german c19s001_JamaalSamantha_7e992004:

    # sam "Me han dicho que se ha instaurado una nueva costumbre en esta casa. Algo sobre besos. ¿No me incluye a mí?"
    sam "Man hat mir erzählt, dass es hier im Haus einen neuen Brauch gibt. Irgendwas mit Küssen. Gilt das etwa nicht auch für mich?"

# game/scripts/c19/c19.rpy:80
translate german c19s001_JamaalSamantha_e3d54d03:

    # mc "Por supuesto, a toda la familia. Ven aquí."
    mc "Natürlich die ganze Familie. Kommt her."

# game/scripts/c19/c19.rpy:82
translate german c19s001_JamaalSamantha_71e2ade5:

    # mc "Buenos días, Sam."
    mc "Guten Morgen, Sam."

# game/scripts/c19/c19.rpy:83
translate german c19s001_JamaalSamantha_d7b7ee12:

    # sam "Buenos días, [mc]."
    sam "Guten Morgen, [mc]."

# game/scripts/c19/c19.rpy:85
translate german c19s001_JamaalSamantha_6a9e914a:

    # jam "¡Yo también quiero! *Risa*"
    jam "Ich will auch welche! *lacht*"

# game/scripts/c19/c19.rpy:86
translate german c19s001_JamaalSamantha_ef5f909f:

    # mc "*Risa* Para ti no hay."
    mc "*Gelächter* Da ist nichts für dich dabei."

# game/scripts/c19/c19.rpy:88
translate german c19s001_JamaalSamantha_ac72d3a7:

    # jam "¿Yo no soy de la familia? *Sniff*"
    jam "Bin ich etwa keine Familie? *Schnief*"

# game/scripts/c19/c19.rpy:89
translate german c19s001_JamaalSamantha_ec18faec:

    # mc "Claro que lo eres, pero no quiero que tus herramientas sufran más si te tengo que besar. *Risa*"
    mc "Natürlich bist du das, aber ich will nicht, dass deine Werkzeuge noch mehr leiden, wenn ich dich küssen muss. *lacht*"

# game/scripts/c19/c19.rpy:91
translate german c19s001_JamaalSamantha_6105c928:

    # sam "¡[mc]!"
    sam "[mc]!"

# game/scripts/c19/c19.rpy:92
translate german c19s001_JamaalSamantha_6adc66e8:

    # mc "¿Qué? Mis besos son irresistibles. *Risa* Pueden levantar a un muerto, pero no a Jamaal."
    mc "Was? Meine Küsse sind unwiderstehlich. *lacht* Sie können die Toten auferwecken, aber nicht Jamaal."

# game/scripts/c19/c19.rpy:93
translate german c19s001_JamaalSamantha_6105c928_1:

    # sam "¡[mc]!"
    sam "[mc]!"

# game/scripts/c19/c19.rpy:94
translate german c19s001_JamaalSamantha_2c98e69f:

    # mc "Va a tener que seguir sentado encima de su tesoro más preciado. Y no queremos que se le salga de ese bañador ridículo."
    mc "Er muss wohl weiterhin auf seinem wertvollsten Besitz sitzen bleiben. Und wir wollen ja nicht, dass der aus dieser lächerlichen Badehose raushängt."

# game/scripts/c19/c19.rpy:96
translate german c19s001_JamaalSamantha_96c786d6:

    # jam "¡Hey! Esa es nueva. *Risa* Estaba un poco harto de las bromas sobre morir de pie o vivir de rodillas."
    jam "Hey! Das ist ja mal was Neues. *lacht* Ich hatte die Witze über das Sterben im Stehen oder das Leben auf Knien langsam satt."

# game/scripts/c19/c19.rpy:97
translate german c19s001_JamaalSamantha_f13881dc:

    # mc "A tu servicio. Siempre pensando en nuevas formas de meterme contigo. *Risa*"
    mc "Zu Ihren Diensten. Ich denke mir immer neue Wege aus, Sie zu ärgern. *lacht*"

# game/scripts/c19/c19.rpy:99
translate german c19s001_JamaalSamantha_8199cab3:

    # mc "Voy a tener que llevarme a tu madre un rato."
    mc "Ich muss deine Mutter für eine Weile mitnehmen."

# game/scripts/c19/c19.rpy:101
translate german c19s001_JamaalSamantha_85640f55:

    # sam "¿A dónde? [nor] y [mar] me han dicho que no me acercara a las cocinas. Han dicho que hoy soy una invitada."
    sam "Wohin? [nor] und [mar] sagten mir, ich solle mich von den Küchen fernhalten. Sie sagten, ich sei heute zu Gast."

# game/scripts/c19/c19.rpy:102
translate german c19s001_JamaalSamantha_578f0966:

    # mc "No tiene que ver con la comida, no te preocupes. Quiero enseñarte una cosa que tengo en mi habitación."
    mc "Keine Sorge, es geht nicht ums Essen. Ich möchte dir etwas zeigen, das ich in meinem Zimmer habe."

# game/scripts/c19/c19.rpy:103
translate german c19s001_JamaalSamantha_1d3e8c57:

    # sam "Ah, OK. Vamos entonces."
    sam "Ah, okay. Dann los."

# game/scripts/c19/c19.rpy:105
translate german c19s001_JamaalSamantha_6950d2e0:

    # mc "Voy a subir a ponerme el bañador a mi habitación. Bajo en un momento."
    mc "Ich gehe kurz in mein Zimmer im Obergeschoss, um meinen Badeanzug anzuziehen. Ich komme gleich wieder runter."

# game/scripts/c19/c19.rpy:107
translate german c19s001_JamaalSamantha_bcd2c740:

    # mc "Tú puedes venir también si quieres, Jam."
    mc "Du kannst auch mitkommen, wenn du willst, Jam."

# game/scripts/c19/c19.rpy:108
translate german c19s001_JamaalSamantha_90dab542:

    # jam "Creo que voy a pasar. Ya te he visto desnudo antes y no vale la pena arrastrarme por esas escaleras para volver a hacerlo."
    jam "Ich glaube, ich verzichte. Ich habe dich schon nackt gesehen, und es lohnt sich nicht, diese Treppe noch einmal hinunterzukriechen."

# game/scripts/c19/c19.rpy:109
translate german c19s001_JamaalSamantha_2819466c:

    # jam "Seguro que cuando bajase tu madre había tirado la silla porque molestaba o estaba fuera de su sitio. *Risa*"
    jam "Ich wette, als deine Mutter die Treppe runterkam, hatte sie den Stuhl schon umgestoßen, weil er im Weg stand oder nicht an seinem Platz war. *lacht*"

# game/scripts/c19/c19.rpy:110
translate german c19s001_JamaalSamantha_d49d398e:

    # mc "Entonces te veo luego. Bajo en un momento."
    mc "Dann sehen wir uns später. Ich komme gleich runter."

# game/scripts/c19/c19.rpy:112
translate german c19s001_JamaalSamantha_dac5c695:

    # jam "Hasta ahora. Yo esperaré aquí, al lado de los entremeses que va a bajar [mar]. No sé si quedarán cuando bajes."
    jam "Bis zum nächsten Mal. Ich warte hier neben den Vorspeisen, die du mitbringst. Ich weiß nicht, ob noch etwas übrig sein wird, wenn du herunterkommst."

# game/scripts/c19/c19.rpy:113
translate german c19s001_JamaalSamantha_ff25755d:

    # mc "Ahora mando a Betty para que los proteja. *Risa* Le diré que quiero bendecir la mesa y no dejará que nadie coma hasta que vuelva."
    mc "Ich schicke Betty, um sie zu beschützen. *Lacht* Ich werde ihr sagen, dass ich den Tisch segnen möchte, und sie wird niemanden essen lassen, bis ich zurück bin."

# game/scripts/c19/c19.rpy:114
translate german c19s001_JamaalSamantha_f174f893:

    # jam "Eres un mal amigo... *Risa*"
    jam "Du bist eine schlechte Freundin... *lacht*"

# game/scripts/c19/c19.rpy:117
translate german c19s001_JamaalSamantha_86b6560f:

    # sam "Antes de que te vayas... ¿puedo hablar un momento contigo?"
    sam "Bevor Sie gehen... darf ich kurz mit Ihnen sprechen?"

# game/scripts/c19/c19.rpy:118
translate german c19s001_JamaalSamantha_99e18188:

    # mc "Por supuesto. Hoy va a estar toda la familia y va a ser complicado estar a solas."
    mc "Natürlich. Die ganze Familie wird heute hier sein, und es wird schwierig sein, allein zu sein."

# game/scripts/c19/c19.rpy:120
translate german c19s001_JamaalSamantha_6fc4168e:

    # mc "¿De qué quieres hablar?"
    mc "Worüber möchtest du sprechen?"

# game/scripts/c19/c19.rpy:125
translate german c19s001_JamaalSamantha_55baa74f:

    # sam "Entonces no te entretengo más."
    sam "Dann werde ich Sie nicht länger aufhalten."

# game/scripts/c19/c19.rpy:126
translate german c19s001_JamaalSamantha_5de00e22:

    # mc "Nos vemos en un rato."
    mc "Wir sehen uns gleich."

# game/scripts/c19/c19.rpy:153
translate german c19s001_Samantha_f1bce70a:

    # "Al llegar a tu habitación..."
    "Wenn Sie Ihr Zimmer erreichen..."

# game/scripts/c19/c19.rpy:155
translate german c19s001_Samantha_f46a3ca1:

    # sam "¡Qué difícil se hace mantener el secreto delante de Jamaal y darte solamente un besito!"
    sam "Wie schwer es ist, das Geheimnis vor Jamaal zu bewahren und dir nur einen kleinen Kuss zu geben!"

# game/scripts/c19/c19.rpy:156
translate german c19s001_Samantha_f788e185:

    # sam "¡Ven aquí!"
    sam "Komm her!"

# game/scripts/c19/c19.rpy:157
translate german c19s001_Samantha_f1ade4c5:

    # mc "A tus órdenes."
    mc "Zu Ihren Diensten."

# game/scripts/c19/c19.rpy:159
translate german c19s001_Samantha_53af3091:

    # "Los jugosos labios de Samantha aprisionan los tuyos."
    "Samanthas üppige Lippen umschließen deine."

# game/scripts/c19/c19.rpy:160
translate german c19s001_Samantha_c2df9130:

    # "Sus tetas presionan contra tu pecho."
    "Ihre Brüste drücken gegen deine Brust."

# game/scripts/c19/c19.rpy:161
translate german c19s001_Samantha_946683a0:

    # "Vuestras manos recorren la piel del otro."
    "Eure Hände streichen über die Haut des anderen."

# game/scripts/c19/c19.rpy:162
translate german c19s001_Samantha_37a64a23:

    # "Hasta que Sam se separa de ti."
    "Bis Sam dich verlässt."

# game/scripts/c19/c19.rpy:164
translate german c19s001_Samantha_353e217f:

    # sam "Si quieres llegar a tiempo para la comida, mejor parar, ¿no?"
    sam "Wenn Sie rechtzeitig zum Mittagessen dort sein wollen, ist es am besten, anzuhalten, nicht wahr?"

# game/scripts/c19/c19.rpy:165
translate german c19s001_Samantha_8c9617c3:

    # mc "Es difícil parar. Te veo tan poco que cuando te tengo entre mis brazos se me hace casi imposible."
    mc "Es ist schwer aufzuhören. Ich sehe dich so selten, dass es sich fast unmöglich anfühlt, dich in meinen Armen zu halten."

# game/scripts/c19/c19.rpy:167
translate german c19s001_Samantha_687f7a10:

    # sam "Lo sé... pero con el trabajo tengo muy poco tiempo libre..."
    sam "Ich weiß... aber beruflich habe ich sehr wenig Freizeit..."

# game/scripts/c19/c19.rpy:168
translate german c19s001_Samantha_7f3c1fa3:

    # sam "Y cuando tengo tiempo libre, Jamaal está en casa."
    sam "Und wenn ich Freizeit habe, ist Jamaal zu Hause."

# game/scripts/c19/c19.rpy:169
translate german c19s001_Samantha_659d9eab:

    # mc "No te preocupes, encontraremos tiempo para nosotros."
    mc "Keine Sorge, wir werden Zeit für uns finden."

# game/scripts/c19/c19.rpy:171
translate german c19s001_Samantha_511116f9:

    # sam "¿Qué querías enseñarme?"
    sam "Was wolltest du mir beibringen?"

# game/scripts/c19/c19.rpy:172
translate german c19s001_Samantha_3f736ac8:

    # mc "¿Cuánto te han contado de Amanda y Eva?"
    mc "Wie viel haben sie Ihnen über Amanda und Eva erzählt?"

# game/scripts/c19/c19.rpy:173
translate german c19s001_Samantha_8128d629:

    # "Te pone al día sobre cuánto sabe. Tú la pones al día sobre las pruebas de embarazo."
    "Sie berichtet dir, wie viel sie weiß. Du informierst sie über die Schwangerschaftstests."

# game/scripts/c19/c19.rpy:175
translate german c19s001_Samantha_dce327da:

    # sam "¿Eso existe? Tiene que ser tecnología muy avanzada... no he oído nunca hablar de algo así."
    sam "Gibt es so etwas? Das muss eine sehr fortschrittliche Technologie sein... Ich habe noch nie von so etwas gehört."

# game/scripts/c19/c19.rpy:176
translate german c19s001_Samantha_de67792a:

    # mc "Por lo que me comentó Amanda, mide no-se-qué hormonas de una forma que no se había podido medir hasta ahora, al menos de forma doméstica."
    mc "Laut Amanda misst es einige Hormone auf eine Weise, die bisher nicht möglich war, zumindest nicht zu Hause."

# game/scripts/c19/c19.rpy:177
translate german c19s001_Samantha_642ca2f7:

    # mc "NTR no solo se dedica a lo que todos sabemos, sino que parece ser que tiene una división muy importante de medicina aplicada."
    mc "NTR bietet nicht nur das an, was wir alle kennen, sondern verfügt offenbar auch über eine sehr wichtige Abteilung für angewandte Medizin."

# game/scripts/c19/c19.rpy:179
translate german c19s001_Samantha_598345fc:

    # sam "Y quieres que me haga la prueba, ¿no?"
    sam "Und du willst, dass ich mich testen lasse, richtig?"

# game/scripts/c19/c19.rpy:180
translate german c19s001_Samantha_4be413bb:

    # mc "Sólo si tú quieres. O si has notado algún síntoma. Tenemos los tests, con lo que creo que sería una buena idea saberlo."
    mc "Nur wenn Sie möchten. Oder wenn Sie Symptome bemerkt haben. Wir haben die Tests, daher wäre es sicher gut, Bescheid zu wissen."

# game/scripts/c19/c19.rpy:182
translate german c19s001_Samantha_df3f7f8e:

    # sam "¿Y qué querrías que saliera en el test?"
    sam "Und was würden Sie gerne im Test sehen?"

# game/scripts/c19/c19.rpy:185
translate german c19s001_Samantha_c9913328:

    # mc "No me malinterpretes, no voy a sentirme mal si sale negativo, pero me haría ilusión tener un hijo contigo."
    mc "Versteh mich nicht falsch, ich wäre nicht traurig, wenn der Test negativ ausfällt, aber ich würde sehr gerne ein Kind mit dir haben."

# game/scripts/c19/c19.rpy:187
translate german c19s001_Samantha_71d0efb3:

    # mc "No me malinterpretes, pero hasta que se lo digamos a Jamaal preferiría no enredarlo más."
    mc "Versteht mich nicht falsch, aber bis wir Jamaal Bescheid gesagt haben, möchte ich die Sache nicht noch weiter verkomplizieren."

# game/scripts/c19/c19.rpy:189
translate german c19s001_Samantha_e821820e:

    # mc "Te voy a querer igual salga una cosa o la otra."
    mc "Ich werde dich immer lieben, egal was passiert."

# game/scripts/c19/c19.rpy:190
translate german c19s001_Samantha_43623649:

    # mc "¿Y tú? ¿Qué te gustaría a ti que saliera en el test?"
    mc "Und Sie? Was würden Sie gerne im Test sehen?"

# game/scripts/c19/c19.rpy:192
translate german c19s001_Samantha_a4a61ba3:

    # sam "No lo he pensado aún. Si sale positivo me alegraré, aunque tiene riesgos a mi edad. Ya he pasado de los 40..."
    sam "Ich habe noch nicht darüber nachgedacht. Wenn der Test positiv ausfällt, freue ich mich, auch wenn in meinem Alter Risiken bestehen. Ich bin ja schon über 40…"

# game/scripts/c19/c19.rpy:193
translate german c19s001_Samantha_8f06e46a:

    # sam "Pero si sale negativo no me voy a sentir decepcionada. A mi edad la fertilidad cae considerablemente, con lo que no espero que me dejes embarazada en dos intentos."
    sam "Aber wenn der Test negativ ausfällt, bin ich nicht enttäuscht. In meinem Alter nimmt die Fruchtbarkeit deutlich ab, daher rechne ich nicht damit, beim zweiten Versuch schwanger zu werden."

# game/scripts/c19/c19.rpy:194
translate german c19s001_Samantha_1cd21c74:

    # mc "Lo entiendo. Tomemos la muestra de sangre y lo sabremos mañana a esta hora."
    mc "Ich verstehe. Nehmen wir die Blutprobe, und wir wissen morgen um diese Zeit Bescheid."

# game/scripts/c19/c19.rpy:196
translate german c19s001_Samantha_daaa0540:

    # sam "No. Mañana a esta hora estaré trabajando, y quiero mirarlo contigo. Me lo llevaré a casa y lo miraremos cuando vengas."
    sam "Nein. Ich bin morgen um diese Zeit auf der Arbeit und möchte es mir mit Ihnen zusammen ansehen. Ich nehme es mit nach Hause und wir schauen es uns an, wenn Sie da sind."

# game/scripts/c19/c19.rpy:197
translate german c19s001_Samantha_d3c8a53d:

    # mc "Pero pueden pasar días hasta que pueda ir y coincidamos los dos solos en tu casa..."
    mc "Aber es könnten noch Tage vergehen, bis ich hinfahren kann und wir allein bei dir zu Hause sein können..."

# game/scripts/c19/c19.rpy:199
translate german c19s001_Samantha_67c4b45d:

    # sam "Bueno, no hay prisa. Si sale positivo tenemos tiempo antes de que empiece a engordar, y no tengo ningún síntoma."
    sam "Nun ja, es besteht keine Eile. Falls der Test positiv ausfällt, haben wir noch Zeit, bevor ich an Gewicht zunehme und keine Symptome habe."

# game/scripts/c19/c19.rpy:200
translate german c19s001_Samantha_3097bb4e:

    # mc "Cómo quieras. Trae ese dedo aquí y extraigamos la sangre."
    mc "Ganz wie du willst. Bring den Finger her, dann lassen wir Blut fließen."

# game/scripts/c19/c19.rpy:202
translate german c19s001_Samantha_cc81f510:

    # "Después de tomar la muestra..."
    "Nach der Probenentnahme..."

# game/scripts/c19/c19.rpy:203
translate german c19s001_Samantha_f4001b30:

    # sam "Luego pasaré para coger el test. Cuando tenga el bolso para guardarlo."
    sam "Ich hole den Test später ab. Sobald ich meine Tasche dabei habe."

# game/scripts/c19/c19.rpy:204
translate german c19s001_Samantha_bc6ea0f4:

    # mc "Perfecto, lo dejaré en el cajón debajo de la TV."
    mc "Perfekt, ich lege es in die Schublade unter dem Fernseher."

# game/scripts/c19/c19.rpy:207
translate german c19s001_Samantha_6e43cb46:

    # sam "¿Ya has hecho la prueba con Simone?"
    sam "Hast du es schon mit Simone ausprobiert?"

# game/scripts/c19/c19.rpy:208
translate german c19s001_Samantha_1c8e85a7:

    # mc "No, aún no. No la he visto desde que tenemos los tests. No habéis venido a ninguna de las comidas o cenas familiares estos días."
    mc "Nein, noch nicht. Ich habe sie nicht gesehen, seit wir die Testergebnisse bekommen haben. Du warst in den letzten Tagen bei keinem der Familienessen dabei."

# game/scripts/c19/c19.rpy:209
translate german c19s001_Samantha_70fa9ac7:

    # mc "Luego le diré que suba para hacer la prueba."
    mc "Dann werde ich ihm sagen, dass er nach oben kommen soll, um den Test zu machen."

# game/scripts/c19/c19.rpy:214
translate german c19s001_Samantha_4813dbdc:

    # sam "Entonces voy a bajar. Al final Jamaal va a sospechar."
    sam "Dann gehe ich runter. Jamaal wird irgendwann Verdacht schöpfen."

# game/scripts/c19/c19.rpy:215
translate german c19s001_Samantha_43ddca91:

    # mc "No sin antes dejarme hacer esto."
    mc "Aber nicht, bevor Sie mir das hier erlauben."

# game/scripts/c19/c19.rpy:217
translate german c19s001_Samantha_6105c928:

    # sam "¡[mc]!"
    sam "[mc]!"

# game/scripts/c19/c19.rpy:219
translate german c19s001_Samantha_b9c31c70:

    # mc "No puedes esperar venir a mi habitación con estas maravillas al aire y que no tome medidas, ¿verdad?"
    mc "Du kannst doch nicht erwarten, dass du in mein Zimmer kommst, wo diese Wunder ausgestellt sind, und nichts unternimmst, oder?"

# game/scripts/c19/c19.rpy:220
translate german c19s001_Samantha_a5244623:

    # sam "Pero tenemos que bajar... o van a sospechar..."
    sam "Aber wir müssen runtergehen... sonst werden sie misstrauisch..."

# game/scripts/c19/c19.rpy:221
translate german c19s001_Samantha_fdad9872:

    # mc "No te importó hacerlo público en la playa. Quien tenga que sospechar, que sospeche."
    mc "Es war dir egal, ob du es am Strand öffentlich gemacht hast. Sollen doch alle, die Verdacht schöpfen, verdächtigen."

# game/scripts/c19/c19.rpy:224
translate german c19s001_Samantha_d2533734:

    # "El pezón de Samantha responde a las caricias de tu lengua poniéndose durísimo."
    "Samanthas Brustwarze reagiert auf die Liebkosungen deiner Zunge, indem sie steinhart wird."

# game/scripts/c19/c19.rpy:225
translate german c19s001_Samantha_02a5d2db:

    # sam "[mc], si sigues así, la prueba de embarazo que acabamos de hacer no va a servir de mucho y habrá que hacer otra en un par de días..."
    sam "[mc], wenn du so weitermachst, ist der Schwangerschaftstest, den wir gerade gemacht haben, nicht sehr aussagekräftig und wir müssen in ein paar Tagen einen weiteren machen..."

# game/scripts/c19/c19.rpy:226
translate german c19s001_Samantha_06c7440a:

    # "No te importaría que eso pasara, pero sabes que no es el momento."
    "Es würde dich nicht stören, wenn das passieren würde, aber du weißt, dass es nicht der richtige Zeitpunkt ist."

# game/scripts/c19/c19.rpy:227
translate german c19s001_Samantha_6dee987b:

    # "También sabes que si no paras ahora, va a ser casi imposible hacerlo."
    "Du weißt auch, dass es fast unmöglich sein wird, damit aufzuhören, wenn du jetzt nicht aufhörst."

# game/scripts/c19/c19.rpy:228
translate german c19s001_Samantha_6cff862d:

    # "Pero, por alguna razón, te es muy difícil mantener tu lengua y tus manos quietas."
    "Aber aus irgendeinem Grund fällt es Ihnen sehr schwer, Ihre Zunge und Hände still zu halten."

# game/scripts/c19/c19.rpy:231
translate german c19s001_Samantha_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c19/c19.rpy:232
translate german c19s001_Samantha_0da5fc3c:

    # mcp "(Salvados por la campana... o por unos golpes en la puerta.)"
    mcp "(Gerettet durch den Wecker... oder durch Klopfen an der Tür.)"

# game/scripts/c19/c19.rpy:236
translate german c19s001_Samantha_9c773c51:

    # "Te separas a regañadientes del pezón de Sam."
    "Du ziehst dich widerwillig von Sams Brustwarze zurück."

# game/scripts/c19/c19.rpy:237
translate german c19s001_Samantha_bb9c1f60:

    # mom "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    mom "*Durch die Tür* Ich bin's. Darf ich hereinkommen?"

# game/scripts/c19/c19.rpy:238
translate german c19s001_Samantha_4d601f0e:

    # mc "Sí, pasa."
    mc "Ja, das kommt vor."

# game/scripts/c19/c19.rpy:245
translate german c19s001_Samantha_9a5017d7:

    # mom "¡Oops! Lo siento. No sabía que estabas ocupado."
    mom "Oh, Entschuldigung. Ich wusste nicht, dass Sie beschäftigt waren."

# game/scripts/c19/c19.rpy:246
translate german c19s001_Samantha_cd6c99d1:

    # mc "No te preocupes. ¿Necesitabas alguna cosa?"
    mc "Keine Sorge. Brauchtest du etwas?"

# game/scripts/c19/c19.rpy:247
translate german c19s001_Samantha_026acadb:

    # mom "Saber si ya te habías cambiado y si podías ayudarnos a bajar cosas a la piscina. Pero tranquilos, acabad lo que estuvierais haciendo."
    mom "Wir wollten wissen, ob Sie sich schon umgezogen haben und ob Sie uns helfen könnten, die Sachen zum Pool zu tragen. Aber keine Sorge, machen Sie einfach weiter, was Sie gerade tun."

# game/scripts/c19/c19.rpy:249
translate german c19s001_Samantha_c8f45f07:

    # sam "No te preocupes, [mar]. Ya habíamos acabado."
    sam "Keine Sorge, [mar]. Wir waren schon fertig."

# game/scripts/c19/c19.rpy:251
translate german c19s001_Samantha_dfeb406c:

    # sam "Ahora toca esperar..."
    sam "Nun heißt es abwarten..."

# game/scripts/c19/c19.rpy:252
translate german c19s001_Samantha_aa718c88:

    # mom "¿Prueba de embarazo?"
    mom "Schwangerschaftstest?"

# game/scripts/c19/c19.rpy:253
translate german c19s001_Samantha_8c0c4cb8:

    # sam "Sí..."
    sam "Ja..."

# game/scripts/c19/c19.rpy:256
translate german c19s001_Samantha_0d6a2326:

    # mom "Espero que la tuya TAMBIÉN salga positiva."
    mom "Ich hoffe, dein Testergebnis ist auch positiv."

# game/scripts/c19/c19.rpy:258
translate german c19s001_Samantha_9f4ebb33:

    # mom "Espero que la tuya salga positiva."
    mom "Ich hoffe, dein Testergebnis ist positiv."

# game/scripts/c19/c19.rpy:260
translate german c19s001_Samantha_621e32f6:

    # mom "Espero que tengáis mucha suerte."
    mom "Ich wünsche dir viel Glück."

# game/scripts/c19/c19.rpy:263
translate german c19s001_Samantha_827b5397:

    # sam "¿También? ¿Estás embarazada, [mar]?"
    sam "Und? Bist du schwanger, [mar]?"

# game/scripts/c19/c19.rpy:265
translate german c19s001_Samantha_8dbe922f:

    # mom "Sí... Aparte de [nor] eres la primera en saberlo."
    mom "Ja... Abgesehen von [nor] bist du der Erste, der es erfährt."

# game/scripts/c19/c19.rpy:267
translate german c19s001_Samantha_bf8d467a:

    # sam "Lo estábamos hablando y aún no sé lo que quiero que salga."
    sam "Wir haben darüber gesprochen und ich weiß immer noch nicht, was ich letztendlich sagen will."

# game/scripts/c19/c19.rpy:268
translate german c19s001_Samantha_0c556249:

    # sam "¿Aún no tenéis tus resultados o es que aún no la necesitas?... ¿O ha salido negativa?"
    sam "Haben Sie Ihre Ergebnisse noch nicht erhalten oder benötigen Sie sie noch nicht?... Oder war das Ergebnis negativ?"

# game/scripts/c19/c19.rpy:270
translate german c19s001_Samantha_a35fe303:

    # mom "Negativo, pero eso sólo significa que lo deberemos intentar más."
    mom "Nein, aber das bedeutet nur, dass wir uns mehr anstrengen müssen."

# game/scripts/c19/c19.rpy:272
translate german c19s001_Samantha_e260ca47:

    # sam "Se me hace tan raro esto de que sepas lo nuestro después de que tú y yo bromeáramos sobre compartir a [mc]..."
    sam "Es fühlt sich so seltsam an, dass du von uns weißt, nachdem wir doch noch gescherzt haben, dass wir [mc] teilen würden..."

# game/scripts/c19/c19.rpy:274
translate german c19s001_Samantha_1812753e:

    # mom "Bueno, ahora soy tu suegra, pero no voy a ser una mala suegra. Sé que mi hijo no podría estar con nadie mejor."
    mom "Nun bin ich deine Schwiegermutter, aber ich werde keine schlechte sein. Ich weiß, mein Sohn könnte keine bessere Partnerin haben."

# game/scripts/c19/c19.rpy:277
translate german c19s001_Samantha_7d280582:

    # "Samantha se lanza a los brazos de [mar]. Se encuentran a medio camino."
    "Samantha wirft sich in [mar]s Arme. Sie treffen sich auf halbem Weg."

# game/scripts/c19/c19.rpy:278
translate german c19s001_Samantha_5c96fff1:

    # sam "Se me hace tan raro estar hablando de embarazos a nuestra edad..."
    sam "Es fühlt sich so seltsam an, in unserem Alter über Schwangerschaften zu sprechen..."

# game/scripts/c19/c19.rpy:279
translate german c19s001_Samantha_be72dfa4:

    # mom "Embarazos posiblemente provocados por el mismo hombre..."
    mom "Schwangerschaften, die möglicherweise vom selben Mann verursacht wurden..."

# game/scripts/c19/c19.rpy:280
translate german c19s001_Samantha_a6ced80e:

    # sam "Que además es tu hijo..."
    sam "Und er ist dein Sohn..."

# game/scripts/c19/c19.rpy:281
translate german c19s001_Samantha_caadf414:

    # mom "Nuestros hijos siempre han sido amigos y se han tratado como hermanos... si tenemos más, serán hermanos de verdad..."
    mom "Unsere Kinder waren schon immer Freunde und haben sich wie Geschwister behandelt... wenn wir noch mehr bekommen, werden es richtige Geschwister sein..."

# game/scripts/c19/c19.rpy:282
translate german c19s001_Samantha_bd4aedbb:

    # mc "¡Hey! ¡Jam es mi hermano de verdad!"
    mc "Hey! Jam ist mein richtiger Bruder!"

# game/scripts/c19/c19.rpy:284
translate german c19s001_Samantha_2258fd1a:

    # sam "Nadie lo pone en duda, pero estos serán hermanos del mismo padre..."
    sam "Daran zweifelt niemand, aber das werden Brüder vom selben Vater sein..."

# game/scripts/c19/c19.rpy:285
translate german c19s001_Samantha_c65753d1:

    # mom "Con lo que serán medio-hermanos..."
    mom "Sie werden also Halbgeschwister sein..."

# game/scripts/c19/c19.rpy:286
translate german c19s001_Samantha_52e48ff7:

    # mc "Sí, Mamá, y tú serás la abuela del hijo de Sam, además de su suegra."
    mc "Ja, Mama, und du wirst sowohl die Großmutter von Sams Sohn als auch seine Schwiegermutter sein."

# game/scripts/c19/c19.rpy:287
translate german c19s001_Samantha_ede72e47:

    # mc "Y Sam será la cuñada de tu hijo... que también será tu nieto."
    mc "Und Sam wird die Schwägerin Ihres Sohnes sein... der gleichzeitig Ihr Enkel sein wird."

# game/scripts/c19/c19.rpy:289
translate german c19s001_Samantha_e70c0472:

    # sam "¡Por el amor de Dios! Eso es demasiado lioso para mí."
    sam "Um Himmels willen! Das ist viel zu kompliziert für mich."

# game/scripts/c19/c19.rpy:290
translate german c19s001_Samantha_47df5443:

    # mom "¿Nos vamos antes de que nos explote la cabeza y dejamos que [mc] se cambie de ropa?"
    mom "Sollen wir gehen, bevor uns der Kopf platzt, und [mc] sich umziehen lassen?"

# game/scripts/c19/c19.rpy:291
translate german c19s001_Samantha_5d8e4672:

    # sam "Mejor... me estoy mareando solo de pensar en las implicaciones de lo que acaba de decir."
    sam "Besser... Mir wird schon schwindlig, wenn ich nur an die Tragweite dessen denke, was er gerade gesagt hat."

# game/scripts/c19/c19.rpy:293
translate german c19s001_Samantha_1991e870:

    # mom "Y eso sin pensar en si Simone también está embarazada..."
    mom "Und dabei ist noch gar nicht berücksichtigt, ob Simone ebenfalls schwanger ist..."

# game/scripts/c19/c19.rpy:294
translate german c19s001_Samantha_c0000f96:

    # mc "Haremos la prueba más tarde. Aún no la he visto."
    mc "Wir machen den Test später. Ich habe ihn noch nicht gesehen."

# game/scripts/c19/c19.rpy:296
translate german c19s001_Samantha_61ac67b1:

    # mom "Hasta luego, mi amor."
    mom "Wir sehen uns später, mein Schatz."

# game/scripts/c19/c19.rpy:297
translate german c19s001_Samantha_cb94f014:

    # sam "Te vemos luego, [mc]."
    sam "Bis später, [mc]."

# game/scripts/c19/c19.rpy:298
translate german c19s001_Samantha_382b36f0:

    # mc "¿No hay besos de despedida?"
    mc "Keine Abschiedsküsse?"

# game/scripts/c19/c19.rpy:300
translate german c19s001_Samantha_d905f86a:

    # mom "¿Qué opinas?"
    mom "Was denken Sie?"

# game/scripts/c19/c19.rpy:301
translate german c19s001_Samantha_e01a45ce:

    # sam "Después de la playa... no me voy a avergonzar por besarlo ahora. ¿Tú?"
    sam "Nach dem Strand... werde ich mich jetzt nicht mehr schämen, ihn zu küssen. Und du?"

# game/scripts/c19/c19.rpy:302
translate german c19s001_Samantha_d1d888e7:

    # mom "Creo que nos vamos a tener que acostumbrar a que las dos lo besemos delante de la otra."
    mom "Ich glaube, wir müssen uns daran gewöhnen, dass wir ihn beide voreinander küssen."

# game/scripts/c19/c19.rpy:304
translate german c19s001_Samantha_61ac67b1_1:

    # mom "Hasta luego, mi amor."
    mom "Wir sehen uns später, mein Schatz."

# game/scripts/c19/c19.rpy:305
translate german c19s001_Samantha_fd0b2265:

    # mc "Hasta luego, mi vida."
    mc "Leb wohl, meine Liebe."

# game/scripts/c19/c19.rpy:306
translate german c19s001_Samantha_60981a5d:

    # "Pese a lo que acaban de decir, Samantha se gira para daros privacidad, mientras finge mirar algo en el mueble de la TV."
    "Trotz dessen, was sie eben gesagt haben, wendet sich Samantha ab, um Ihnen Privatsphäre zu gewähren, und tut so, als würde sie etwas auf dem Fernsehständer ansehen."

# game/scripts/c19/c19.rpy:308
translate german c19s001_Samantha_e04243e9:

    # sam "Te vemos abajo, mi vida."
    sam "Wir sehen uns unten, mein Schatz."

# game/scripts/c19/c19.rpy:309
translate german c19s001_Samantha_bb219b64:

    # mc "En un momento bajo y paso por la cocina a recoger cosas."
    mc "Ich habe einen schlechten Tag und gehe in der Küche herum, um ein paar Dinge aufzusammeln."

# game/scripts/c19/c19.rpy:310
translate german c19s001_Samantha_ff146500:

    # "[mar] hace algo parecido, mirando a ninguna parte para daros un poco de espacio."
    "[mar] macht etwas Ähnliches, indem es nirgendwohin schaut, um Ihnen etwas Platz zu geben."

# game/scripts/c19/c19.rpy:312
translate german c19s001_Samantha_1f443637:

    # mc "Por cierto... no solo tenéis unas tetas preciosas ambas sino que también tenéis unos culos increíbles."
    mc "Übrigens... ihr habt nicht nur beide wunderschöne Brüste, sondern auch fantastische Hintern."

# game/scripts/c19/c19.rpy:313
translate german c19s001_Samantha_b8e3d354:

    # mom "*Risita* Creo que nuestro hombre quiere más besos."
    mom "*Kichern* Ich glaube, unser Mann möchte mehr Küsse."

# game/scripts/c19/c19.rpy:314
translate german c19s001_Samantha_b37fbfb7:

    # sam "*Risa* Si por él fuera, tendría mucho más que besos. Pero tenemos unos cumpleaños que organizar."
    sam "*Lacht* Wenn es nach ihm ginge, bekäme ich viel mehr als nur Küsse. Aber wir müssen noch einige Geburtstage organisieren."

# game/scripts/c19/c19.rpy:316
translate german c19s001_Samantha_57966098:

    # mcp "(Y se fueron. La dinámica entre ellas es perfecta. ¿Quién sabe si algún día...?)"
    mcp "(Und sie gingen. Die Dynamik zwischen ihnen ist perfekt. Wer weiß, was eines Tages passiert...?)"

# game/scripts/c19/c19.rpy:318
translate german c19s001_Samantha_a0827c2e:

    # mcp "(Mejor no pensar en eso ahora. Hora de ponerme el bañador.)"
    mcp "(Darüber denke ich jetzt besser nicht nach. Zeit, meinen Badeanzug anzuziehen.)"

# game/scripts/c19/c19.rpy:320
translate german c19s001_Samantha_09f0c2d5:

    # "Las dos avanzan hacia la otra y se funden en un abrazo a medio camino."
    "Die beiden gehen aufeinander zu und verschmelzen auf halbem Weg in einer Umarmung."

# game/scripts/c19/c19.rpy:321
translate german c19s001_Samantha_9ffd3e90:

    # sam "Lo sé. Y yo voy a ser una nuera que no te dará problemas. *Risa*"
    sam "Ich weiß. Und ich werde eine Schwiegertochter sein, die dir keine Probleme bereitet. *lacht*"

# game/scripts/c19/c19.rpy:322
translate german c19s001_Samantha_d72c2eaa:

    # mom "Debería bajar a seguir preparando cosas. Cuando puedas, [mc], ve a la cocina a recoger cosas y bajarlas a la piscina."
    mom "Ich sollte nach unten gehen und die Vorbereitungen fortsetzen. Wenn du kannst, geh in die Küche, hol ein paar Sachen und bring sie zum Pool."

# game/scripts/c19/c19.rpy:323
translate german c19s001_Samantha_1b113a35:

    # sam "Voy a ayudarte mientras tanto. Y no me digas que soy una invitada. Soy tu nuera, al fin y al cabo."
    sam "Ich helfe Ihnen in der Zwischenzeit. Und sagen Sie mir nicht, ich sei nur ein Gast. Ich bin schließlich Ihre Schwiegertochter."

# game/scripts/c19/c19.rpy:324
translate german c19s001_Samantha_0a875130:

    # mc "Dadme dos minutos y bajo. También le he dicho a [nor] que la ayudaría."
    mc "Gib mir zwei Minuten, dann bin ich unten. Ich habe [nor] auch gesagt, dass ich ihr helfen werde."

# game/scripts/c19/c19.rpy:326
translate german c19s001_Samantha_858505fa:

    # sam "Vale, te esperamos en la cocina."
    sam "Okay, wir warten in der Küche auf dich."

# game/scripts/c19/c19.rpy:327
translate german c19s001_Samantha_bf75109c:

    # mom "Si no, no vas a saber lo que tienes que bajar."
    mom "Andernfalls wissen Sie nicht, wie weit Sie es senken müssen."

# game/scripts/c19/c19.rpy:328
translate german c19s001_Samantha_63e0ef84:

    # mc "Sam, ¿y mi beso?"
    mc "Sam, was ist mit meinem Kuss?"

# game/scripts/c19/c19.rpy:330
translate german c19s001_Samantha_7fad5a95:

    # sam "¿Te importa?"
    sam "Ist es Ihnen wichtig?"

# game/scripts/c19/c19.rpy:331
translate german c19s001_Samantha_2d4c68bb:

    # mom "Para nada. Ya te he dicho que no sería una mala suegra. *Risa*"
    mom "Ganz und gar nicht. Ich hab dir doch schon gesagt, dass ich keine schlechte Schwiegermutter wäre. *lacht*"

# game/scripts/c19/c19.rpy:333
translate german c19s001_Samantha_e04243e9_1:

    # sam "Te vemos abajo, mi vida."
    sam "Wir sehen uns unten, mein Schatz."

# game/scripts/c19/c19.rpy:334
