translate german c19s008_LeeroyJenkins_4c91d575:

    # mc "Los puños los guardo para los hombres de verdad."
    mc "Meine Fäuste hebe ich mir für echte Männer auf."

# game/scripts/c19/c19.rpy:4354
translate german c19s008_LeeroyJenkins_7ea246e2:

    # mc "Tú estás lejos de serlo."
    mc "Du bist weit davon entfernt, einer zu sein."

# game/scripts/c19/c19.rpy:4356
translate german c19s008_LeeroyJenkins_1a9ad5a1:

    # sol "¡Pelea como un hombre, capullo!"
    sol "Kämpfe wie ein Mann, Arschloch!"

# game/scripts/c19/c19.rpy:4357
translate german c19s008_LeeroyJenkins_e3a7942a:

    # mc "Hoy no tienes la excusa de estar borracho, gilipollas."
    mc "Heute kannst du deine Trunkenheit nicht als Ausrede benutzen, du Idiot."

# game/scripts/c19/c19.rpy:4358
translate german c19s008_LeeroyJenkins_578f34f3:

    # mc "Si tú empiezas una pelea, la voy a acabar yo."
    mc "Wenn du einen Streit anfängst, werde ich ihn beenden."

# game/scripts/c19/c19.rpy:4360
translate german c19s008_LeeroyJenkins_630b2e1f:

    # kia "No hace falta que le pegues, [mc]."
    kia "Du brauchst ihn nicht zu schlagen, [mc]."

# game/scripts/c19/c19.rpy:4361
translate german c19s008_LeeroyJenkins_bdc91648:

    # kia "No me voy a ir con él. Ni ahora ni nunca."
    kia "Ich gehe nicht mit ihm. Nicht jetzt, nicht jemals."

# game/scripts/c19/c19.rpy:4363
translate german c19s008_LeeroyJenkins_7b5310a4:

    # "Detectas movimiento en la periferia de tu visión."
    "Sie nehmen Bewegungen im peripheren Sichtfeld wahr."

# game/scripts/c19/c19.rpy:4364
translate german c19s008_LeeroyJenkins_4e4f74ea:

    # "Te giras justo a tiempo."
    "Du drehst dich gerade noch rechtzeitig um."

# game/scripts/c19/c19.rpy:4366
translate german c19s008_LeeroyJenkins_5bf09d2d:

    # "La piltrafa humana, como lo ha llamado Eileen, ha intentado un puñetazo a traición."
    "Das Wrack, wie Eileen ihn nannte, versuchte einen heimtückischen Schlag."

# game/scripts/c19/c19.rpy:4367
translate german c19s008_LeeroyJenkins_c89ee1a6:

    # "Esos reflejos que no habías usado desde la segunda pelea con Jack entran en funcionamiento."
    "Deine Reflexe, die du seit dem zweiten Kampf mit Jack nicht mehr benutzt hattest, kommen wieder zum Vorschein."

# game/scripts/c19/c19.rpy:4370
translate german c19s008_LeeroyJenkins_ef88d85c:

    # "Paras su puño con tu mano izquierda. Te queda la derecha libre."
    "Du blockierst seine Faust mit deiner linken Hand. Deine rechte Hand ist frei."

# game/scripts/c19/c19.rpy:4371
translate german c19s008_LeeroyJenkins_946e1d97:

    # "Tu sangre entra en erupción."
    "Dein Blut bricht aus."

# game/scripts/c19/c19.rpy:4381
translate german c19s008_LeeroyJenkins_6af241dd:

    # "Tu puño derecho pasa de estar al lado de tu cintura a estar en la nariz de Solomon. Casi parece que se ha movido solo."
    "Deine rechte Faust wandert von deiner Hüfte zu Salomons Nase. Fast scheint sie sich von selbst bewegt zu haben."

# game/scripts/c19/c19.rpy:4382
translate german c19s008_LeeroyJenkins_1ef4d8c1:

    # mcp "(¡Joder! El capullo tiene la cabeza más dura que Jack.)"
    mcp "(Verdammt! Der Idiot hat einen härteren Kopf als Jack.)"

# game/scripts/c19/c19.rpy:4384
translate german c19s008_LeeroyJenkins_cdcf862e:

    # "Solomon sale volando, dejando un rastro de sangre saliendo a reacción por su nariz."
    "Solomon fliegt davon, wobei eine Blutspur aus seiner Nase spritzt."

# game/scripts/c19/c19.rpy:4385
translate german c19s008_LeeroyJenkins_2b91c97b:

    # "Acabas de hacer un favor a todos los hombres que recibieron como respuesta \"cuando los cerdos vuelen\" al pedirle sexo anal a su mujer."
    "Du hast gerade all den Männern einen Gefallen getan, die auf die Frage ihrer Frauen nach Analsex die Antwort „Wenn Schweine fliegen“ erhielten."

# game/scripts/c19/c19.rpy:4386
translate german c19s008_LeeroyJenkins_76b98c01:

    # "Vuela como un cerdo. Sangra como un cerdo."
    "Es fliegt wie ein Schwein. Es blutet wie ein Schwein."

# game/scripts/c19/c19.rpy:4389
translate german c19s008_LeeroyJenkins_73d69c06:

    # "*Dong*"
    "*Dong*"

# game/scripts/c19/c19.rpy:4390
translate german c19s008_LeeroyJenkins_9fc04637:

    # "Su cabeza al impactar contra la furgoneta suena como un gong."
    "Als sein Kopf gegen den Lieferwagen prallte, klang er wie ein Gong."

# game/scripts/c19/c19.rpy:4392
translate german c19s008_LeeroyJenkins_ee81eee1:

    # mc "No te levantes, Solomon. O mejor aún, levántate para irte."
    mc "Steh nicht auf, Salomo. Oder besser noch, steh auf und geh."

# game/scripts/c19/c19.rpy:4393
translate german c19s008_LeeroyJenkins_1b1dcd26:

    # sol "¡Me has pegado!"
    sol "Du hast mich geschlagen!"

# game/scripts/c19/c19.rpy:4394
translate german c19s008_LeeroyJenkins_a8340ccf:

    # mc "¿Vas a dejar de decir obviedades? Levántate, sube al coche, y vete."
    mc "Hörst du jetzt endlich auf, das Offensichtliche auszusprechen? Steh auf, steig in dein Auto und fahr weg."

# game/scripts/c19/c19.rpy:4395
translate german c19s008_LeeroyJenkins_6e3cd313:

    # mc "O ven a por más."
    mc "Oder kommen Sie für mehr."

# game/scripts/c19/c19.rpy:4397
translate german c19s008_LeeroyJenkins_d2ca2fd2:

    # kia "Solomon, vete a tu casa. No voy a irme contigo."
    kia "Salomo, geh nach Hause. Ich gehe nicht mit dir."

# game/scripts/c19/c19.rpy:4399
translate german c19s008_LeeroyJenkins_638073db:

    # eil "No hagas caso a Mama, Solomon. Levántate e intenta pegarle de nuevo."
    eil "Hör nicht auf Mama, Solomon. Steh auf und versuch ihn nochmal zu schlagen."

# game/scripts/c19/c19.rpy:4400
translate german c19s008_LeeroyJenkins_ba0f98bd:

    # eil "[mc] es mucho más hombre de lo que tú nunca has sido. No es una mujer, que es a lo que estás acostumbrado a pegarle."
    eil "[mc] ist viel männlicher, als du es je warst. Er ist keine Frau, und Frauen bist du ja sonst immer."

# game/scripts/c19/c19.rpy:4402
translate german c19s008_LeeroyJenkins_696e0f70:

    # mc "No tengo ganas de darte una paliza, pero lo haré si es necesario."
    mc "Ich habe keine Lust, dich zu verprügeln, aber ich werde es tun, wenn es nötig ist."

# game/scripts/c19/c19.rpy:4403
translate german c19s008_LeeroyJenkins_5a6c0259:

    # mc "¡Qué coño! Tengo ganas de dártela, pero no quiero fastidiar la fiesta."
    mc "Was soll der Mist! Ich würde es dir ja wirklich gerne geben, aber ich will die Party nicht verderben."

# game/scripts/c19/c19.rpy:4404
translate german c19s008_LeeroyJenkins_1af643d0:

    # sol "No te vas a quedar con mi mujer, hijo de puta."
    sol "Du kriegst meine Frau nicht, du Hurensohn."

# game/scripts/c19/c19.rpy:4416
translate german c19s008_LeeroyJenkins_ab20f4de:

    # mc "Me vas a poner muy difícil lo de no darte una paliza si no dejas de insultar a mi familia."
    mc "Du wirst es mir sehr schwer machen, dich nicht zu verprügeln, wenn du nicht aufhörst, meine Familie zu beleidigen."

# game/scripts/c19/c19.rpy:4418
translate german c19s008_LeeroyJenkins_a0150e17:

    # sol "¿Tu familia? ¡Esa es mi familia! Solo quiero recuperarla."
    sol "Deine Familie? Das ist meine Familie! Ich will sie einfach nur zurück."

# game/scripts/c19/c19.rpy:4420
translate german c19s008_LeeroyJenkins_4c4b2720:

    # eil "¿Recuperarla? ¿Así?"
    eil "Soll ich es zurückbekommen? So?"

# game/scripts/c19/c19.rpy:4421
translate german c19s008_LeeroyJenkins_02e8ee48:

    # eil "Vienes aquí tratando a Mamá como mierda. Como has hecho siempre. Exigiéndole que vuelva a casa..."
    eil "Du kommst hierher und behandelst Mama wie Dreck. Wie immer. Und verlangst, dass sie nach Hause kommt..."

# game/scripts/c19/c19.rpy:4423
translate german c19s008_LeeroyJenkins_113e14c7:

    # kia "Llevo casi una semana aquí, Solomon. En una semana me han mostrado más respeto y cariño que tú en 22 años."
    kia "Ich bin jetzt fast eine Woche hier, Solomon. In dieser einen Woche habe ich mehr Respekt und Zuneigung erfahren als du in 22 Jahren."

# game/scripts/c19/c19.rpy:4424
translate german c19s008_LeeroyJenkins_9069d1ab:

    # kia "Esto es una familia. Lo que nosotros teníamos era una mala imitación de lo que debe ser una familia."
    kia "Das ist eine Familie. Was wir hatten, war nur eine armselige Nachahmung dessen, was eine Familie sein sollte."

# game/scripts/c19/c19.rpy:4426
translate german c19s008_LeeroyJenkins_28d74db7:

    # eil "Mamá es feliz aquí. Nunca volverá contigo."
    eil "Mama ist hier glücklich. Sie wird nie wieder zu dir zurückkommen."

# game/scripts/c19/c19.rpy:4428
translate german c19s008_LeeroyJenkins_66e08abe:

    # sol "¡Estamos casados! ¡Nunca te daré el divorcio!"
    sol "Wir sind verheiratet! Ich werde dich niemals scheiden lassen!"

# game/scripts/c19/c19.rpy:4429
translate german c19s008_LeeroyJenkins_5f892040:

    # sol "¡Estarás viviendo en pecado con este niñato!"
    sol "Mit diesem Bengel lebst du in Sünde!"

# game/scripts/c19/c19.rpy:4430
translate german c19s008_LeeroyJenkins_98593f5b:

    # mc "A mí puedes insultarme. Esta vez."
    mc "Du kannst mich beleidigen. Diesmal."

# game/scripts/c19/c19.rpy:4432
translate german c19s008_LeeroyJenkins_24bbc047:

    # kia "[mc] y yo no estamos juntos, Solomon. Tan solo lo estamos en tu imaginación."
    kia "[mc] Und ich sind nicht zusammen, Salomo. Wir sind nur in deiner Vorstellung zusammen."

# game/scripts/c19/c19.rpy:4433
translate german c19s008_LeeroyJenkins_dd16249f:

    # kia "Vete a tu casa y déjanos en paz. Esta es una fiesta a la que no estás invitado."
    kia "Geh nach Hause und lass uns in Ruhe. Das ist eine Party, zu der du nicht eingeladen bist."

# game/scripts/c19/c19.rpy:4435
translate german c19s008_LeeroyJenkins_a0336692:

    # eil "No están juntos..."
    eil "Sie sind nicht zusammen..."

# game/scripts/c19/c19.rpy:4437
translate german c19s008_LeeroyJenkins_52feb4c8:

    # eil "Pero, si de mí depende, lo van a estar. Yo me ocuparé de ello."
    eil "Aber wenn es nach mir ginge, würden sie es sein. Ich würde mich darum kümmern."

# game/scripts/c19/c19.rpy:4439
translate german c19s008_LeeroyJenkins_6cc920fb:

    # eil "Pero podrían estarlo. [mc] es más y mejor hombre de lo que tú serás nunca."
    eil "Aber das könnten sie sein. [mc] Er ist ein besserer und umfassenderer Mann, als du es jemals sein wirst."

# game/scripts/c19/c19.rpy:4441
translate german c19s008_LeeroyJenkins_2772c22a:

    # kia "¡Calla, Eileen!"
    kia "Halt die Klappe, Eileen!"

# game/scripts/c19/c19.rpy:4442
translate german c19s008_LeeroyJenkins_a50eb134:

    # mc "Puede opinar, Kiara. También es... era su familia."
    mc "Du kannst deine Meinung haben, Kiara. Aber es war schließlich auch... ihre Familie."

# game/scripts/c19/c19.rpy:4444
translate german c19s008_LeeroyJenkins_a05bb931:

    # kia "Puede opinar sobre su padre. No sobre lo que yo haga con mi vida o con quién esté. Es mi vida, no la suya."
    kia "Du kannst eine Meinung über deinen Vater haben. Aber nicht darüber, was ich mit meinem Leben anstelle oder mit wem ich zusammen bin. Es ist mein Leben, nicht deins."

# game/scripts/c19/c19.rpy:4446
translate german c19s008_LeeroyJenkins_e30ddaa0:

    # mcp "(Parece que la conversación entre ellas no ha ido como Eileen esperaba.)"
    mcp "(Offenbar verlief das Gespräch zwischen ihnen nicht so, wie Eileen es erwartet hatte.)"

# game/scripts/c19/c19.rpy:4447
translate german c19s008_LeeroyJenkins_fc0388ef:

    # mc "Tienes razón. Es algo que solo tú puedes decidir."
    mc "Du hast Recht. Das kannst nur du entscheiden."

# game/scripts/c19/c19.rpy:4449
translate german c19s008_LeeroyJenkins_99d5d37c:

    # sol "¿Con quién estés? ¡Tienes que estar conmigo, maldita zorra! ¡Soy tu marido a los ojos de Dios!"
    sol "Mit wem bist du zusammen? Du musst mit mir zusammen sein, du verdammte Hure! Ich bin dein Ehemann vor Gott!"

# game/scripts/c19/c19.rpy:4450
translate german c19s008_LeeroyJenkins_ab7fb63b:

    # mc "Te lo he advertido..."
    mc "Ich habe dich gewarnt..."

# game/scripts/c19/c19.rpy:4452
translate german c19s008_LeeroyJenkins_d1bab443:

    # sol "¡Oh, no!"
    sol "Oh nein!"

# game/scripts/c19/c19.rpy:4462
translate german c19s008_LeeroyJenkins_f5e6587d:

    # "La sensación de tu pie desnudo impactando en sus testículos es desagradable."
    "Das Gefühl, wenn dein nackter Fuß gegen seine Hoden stößt, ist unangenehm."

# game/scripts/c19/c19.rpy:4463
translate german c19s008_LeeroyJenkins_a40dfba0:

    # "La sensación de darle su merecido es increíble."
    "Das Gefühl, ihm das zu geben, was er verdient, ist unglaublich."

# game/scripts/c19/c19.rpy:4465
translate german c19s008_LeeroyJenkins_e2ab98af:

    # sol "*Voz aguda* ¡Cabrón!"
    sol "*Schrille Stimme* Du Mistkerl!"

# game/scripts/c19/c19.rpy:4466
translate german c19s008_LeeroyJenkins_d08ef8bb:

    # mc "No te vuelvas a levantar si no es para subirte al coche e irte."
    mc "Steh nicht wieder auf, es sei denn, du willst in dein Auto steigen und wegfahren."

# game/scripts/c19/c19.rpy:4467
translate german c19s008_LeeroyJenkins_38ec08ab:

    # mc "No vuelvas a abrir la boca. Ni siquiera para despedirte."
    mc "Öffne deinen Mund nicht mehr. Nicht einmal, um dich zu verabschieden."

# game/scripts/c19/c19.rpy:4468
translate german c19s008_LeeroyJenkins_65c209ee:

    # mc "Esto ya está dejando de ser divertido."
    mc "Das macht langsam keinen Spaß mehr."

# game/scripts/c19/c19.rpy:4469
translate german c19s008_LeeroyJenkins_5349938f:

    # mcp "(Nunca he sido un tipo violento, y estoy disfrutando esto demasiado.)"
    mcp "(Ich war nie ein gewalttätiger Mensch, und mir macht das hier viel zu viel Spaß.)"

# game/scripts/c19/c19.rpy:4471
translate german c19s008_LeeroyJenkins_095a2187:

    # "Solomon te hace caso. Se levanta y se dirige al coche, con la cabeza baja, sin decir una palabra."
    "Solomon hört dir zu. Er steht auf und geht mit gesenktem Kopf zum Auto, ohne ein Wort zu sagen."

# game/scripts/c19/c19.rpy:4474
translate german c19s008_LeeroyJenkins_753a8298:

    # "Se sienta en el coche, en silencio, durante unos segundos, antes de encender el motor."
    "Er sitzt einige Sekunden lang schweigend im Auto, bevor er den Motor startet."

# game/scripts/c19/c19.rpy:4477
translate german c19s008_LeeroyJenkins_283f1067:

    # "Kiara te coge de los hombros y te gira hacia ella."
    "Kiara packt dich an den Schultern und dreht dich zu sich um."

# game/scripts/c19/c19.rpy:4478
translate german c19s008_LeeroyJenkins_158d2335:

    # kia "Gracias, [mc]. Tenías razón. No voy a estar mejor que en esta familia en ningún sitio."
    kia "Danke, [mc]. Du hattest Recht. Nirgendwo anders wäre ich besser aufgehoben als bei dieser Familie."

# game/scripts/c19/c19.rpy:4479
translate german c19s008_LeeroyJenkins_891b627e:

    # "Las piernas empiezan a temblarte. La adrenalina empieza a mostrar sus desagradables efectos secundarios."
    "Deine Beine fangen an zu zittern. Das Adrenalin macht sich mit seinen unangenehmen Nebenwirkungen bemerkbar."

# game/scripts/c19/c19.rpy:4480
translate german c19s008_LeeroyJenkins_67d9bfb6:

    # mc "Siempre tendrás tu lugar aquí, Kiara."
    mc "Du wirst hier immer deinen Platz haben, Kiara."

# game/scripts/c19/c19.rpy:4482
translate german c19s008_LeeroyJenkins_b40e2d98:

    # kia "¡Gracias, [mc]! ¡Gracias a todos vosotros!"
    kia "Vielen Dank, [mc]! Vielen Dank an alle!"

# game/scripts/c19/c19.rpy:4483
translate german c19s008_LeeroyJenkins_5471c728:

    # "Tus piernas están temblando. Todo el cuerpo de Kiara tiembla como una hoja en un otoño ventoso."
    "Deine Beine zittern. Kiaras ganzer Körper bebt wie ein Blatt im windigen Herbst."

# game/scripts/c19/c19.rpy:4484
translate german c19s008_LeeroyJenkins_c1aace3c:

    # "La abrazas fuertemente. Te abraza como si su vida dependiera de ello."
    "Du umarmst sie fest. Sie umarmt dich zurück, als hinge ihr Leben davon ab."

# game/scripts/c19/c19.rpy:4485
translate german c19s008_LeeroyJenkins_6f4b263a:

    # "Escuchas un sonido detrás tuyo. La puerta del coche de Solomon abriéndose."
    "Du hörst ein Geräusch hinter dir. Solomons Autotür öffnet sich."

# game/scripts/c19/c19.rpy:4486
translate german c19s008_LeeroyJenkins_714fc161:

    # ama "¡Cuidado!"
    ama "Vorsichtig!"

# game/scripts/c19/c19.rpy:4487
translate german c19s008_LeeroyJenkins_adf0f7a9:

    # eil "¡[mc]!"
    eil "[mc]!"

# game/scripts/c19/c19.rpy:4488
translate german c19s008_LeeroyJenkins_439d3b98:

    # oma "¡Detrás tuyo!"
    oma "Hinter dir!"

# game/scripts/c19/c19.rpy:4489
translate german c19s008_LeeroyJenkins_85fbbe57:

    # todas "*Cacofonía de advertencias*"
    todas "*Kakophonie der Warnungen*"

# game/scripts/c19/c19.rpy:4491
translate german c19s008_LeeroyJenkins_8bdc711a:

    # "Giras la cabeza en el último segundo. Tus brazos aún alrededor de Kiara."
    "Du drehst im letzten Moment den Kopf weg. Deine Arme liegen noch immer um Kiara."

# game/scripts/c19/c19.rpy:4492
translate german c19s008_LeeroyJenkins_337ec51e:

    # sol "¡Hijo de la gran puta!"
    sol "Du Hurensohn!"

# game/scripts/c19/c19.rpy:4493
translate german c19s008_LeeroyJenkins_f08408ee:

    # "Si esquivas el golpe se lo puede llevar Kiara. Te preparas para detener el golpe. Estás en situación de desventaja"
    "Wenn du dem Schlag ausweichst, könnte Kiara ihn abfangen. Du bereitest dich darauf vor, den Schlag abzuwehren. Du bist im Nachteil."

# game/scripts/c19/c19.rpy:4496
translate german c19s008_LeeroyJenkins_ee71ee81:

    # "*Bang*"
    "*Knall*"

# game/scripts/c19/c19.rpy:4497
translate german c19s008_LeeroyJenkins_83dbbdbf:

    # sol "¿Qué?"
    sol "Das?"

# game/scripts/c19/c19.rpy:4502
translate german c19s008_LeeroyJenkins_d5a56970:

    # "Amanda aparece de la nada, saltando la valla, y pegándole una patada a Solomon que parece salida de una película."
    "Amanda taucht wie aus dem Nichts auf, springt über den Zaun und tritt Solomon auf eine Weise, die direkt aus einem Film stammen könnte."

# game/scripts/c19/c19.rpy:4505
translate german c19s008_LeeroyJenkins_af65a8e7:

    # "¿De dónde ha salido el disparo?"
    "Woher kam der Schuss?"

# game/scripts/c19/c19.rpy:4507
translate german c19s008_LeeroyJenkins_755f8aaa:

    # "Eva te mira, con una mezcla de alivio, sonrisa, y disculpa en su cara."
    "Eva blickt dich an, ihr Gesichtsausdruck zeugt von einer Mischung aus Erleichterung, einem Lächeln und Entschuldigung."

# game/scripts/c19/c19.rpy:4508
translate german c19s008_LeeroyJenkins_cf3fbc11:

    # "Sabe que [mar] no quiere armas en casa. ¿La tenía escondida entre las plantas?"
    "Sie weiß, dass [mar] keine Waffen im Haus haben will. Hatte sie sie vielleicht zwischen den Pflanzen versteckt?"

# game/scripts/c19/c19.rpy:4509
translate german c19s008_LeeroyJenkins_7eaf563f:

    # "Por una vez, te alegra que su respeto por las normas sea más bien laxo."
    "Ausnahmsweise ist man froh, dass sie die Regeln eher locker nehmen."

# game/scripts/c19/c19.rpy:4511
translate german c19s008_LeeroyJenkins_8b2fdf10:

    # ama "Sube al coche y vete, pedazo de mierda. A menos que quieras probar a hacer un Leroy Jenkins."
    ama "Steig ins Auto und hau ab, du Dreckskerl. Es sei denn, du willst einen Leroy Jenkins kriegen."

# game/scripts/c19/c19.rpy:4512
translate german c19s008_LeeroyJenkins_00ba3df1:

    # ama "Mi hermana nunca falla. Si vuelves a intentar algo así..."
    ama "Meine Schwester enttäuscht nie. Falls du jemals wieder so etwas versuchst..."

# game/scripts/c19/c19.rpy:4513
translate german c19s008_LeeroyJenkins_b42a3937:

    # ama "Piensa que en este bosque hay mucho terreno donde enterrar un cadáver y que no lo encuentren nunca."
    ama "Er glaubt, dass es in diesem Wald genügend Platz gibt, wo er eine Leiche vergraben könnte und sie niemals finden würde."

# game/scripts/c19/c19.rpy:4514
translate german c19s008_LeeroyJenkins_899e0325:

    # "Habla tan calmadamente que da miedo."
    "Er spricht so ruhig, dass es beängstigend ist."

# game/scripts/c19/c19.rpy:4516
translate german c19s008_LeeroyJenkins_aa925d4b:

    # "Solomon se levanta, cada vez más magullado. Mantiene la puerta de la camioneta entre él y Amanda. Como si le fuese a servir de defensa."
    "Solomon steht auf, zunehmend gezeichnet von blauen Flecken. Er hält die LKW-Tür zwischen sich und Amanda, als ob sie als Schutz dienen sollte."

# game/scripts/c19/c19.rpy:4517
translate german c19s008_LeeroyJenkins_c1ae4f17:

    # sol "¡Os voy a denunciar! ¡Me habéis disparado!"
    sol "Ich werde dich anzeigen! Du hast mich angeschossen!"

# game/scripts/c19/c19.rpy:4518
translate german c19s008_LeeroyJenkins_b95a66f9:

    # mc "Demuéstralo, gilipollas."
    mc "Beweis es, du Idiot."

# game/scripts/c19/c19.rpy:4520
translate german c19s008_LeeroyJenkins_e0428106:

    # ama "Hazlo si quieres. O mejor. Inténtalo."
    ama "Mach es, wenn du willst. Oder noch besser: Probier es aus."

# game/scripts/c19/c19.rpy:4521
translate german c19s008_LeeroyJenkins_ebfd2b74:

    # ama "Vuelve a amenazar a alguien más de mi familia, vuelve a intentar tocarlos, y no podrás contarlo."
    ama "Wenn du noch einmal ein anderes Mitglied meiner Familie bedrohst oder versuchst, ihn anzufassen, wirst du nicht mehr da sein, um davon zu erzählen."

# game/scripts/c19/c19.rpy:4522
translate german c19s008_LeeroyJenkins_50b1e620:

    # "Ahora sí que da miedo."
    "Das ist ja beängstigend."

# game/scripts/c19/c19.rpy:4523
translate german c19s008_LeeroyJenkins_87555f7c:

    # mc "Creo que lo ha entendido, Amanda."
    mc "Ich glaube, sie versteht es, Amanda."

# game/scripts/c19/c19.rpy:4525
translate german c19s008_LeeroyJenkins_dfea3863:

    # mc "No te quiero volver a ver en mi casa."
    mc "Ich will dich nie wieder in meinem Haus sehen."

# game/scripts/c19/c19.rpy:4526
translate german c19s008_LeeroyJenkins_a1c1d637:

    # mc "No quiero volver a escuchar tu voz."
    mc "Ich will deine Stimme nie wieder hören."

# game/scripts/c19/c19.rpy:4527
translate german c19s008_LeeroyJenkins_a8d1d279:

    # mc "No te quiero volver a ver cerca de Kiara ni de Eileen."
    mc "Ich möchte dich nie wieder in der Nähe von Kiara oder Eileen sehen."

# game/scripts/c19/c19.rpy:4528
translate german c19s008_LeeroyJenkins_2f31a434:

    # sol "Me las pagarás..."
    sol "Das wirst du bezahlen..."

# game/scripts/c19/c19.rpy:4529
translate german c19s008_LeeroyJenkins_992d8a38:

    # mc "Te he dicho que no quiero volver a escuchar tu voz."
    mc "Ich habe dir gesagt, dass ich deine Stimme nie wieder hören will."

# game/scripts/c19/c19.rpy:4531
translate german c19s008_LeeroyJenkins_dcf06b9f:

    # "Solomon parece entrar en razón. O quizás su cerebro ha entendido que no le queda ninguna ventaja."
    "Salomo scheint wieder zur Besinnung zu kommen. Oder vielleicht hat sein Verstand erkannt, dass er keinen Vorteil mehr hat."

# game/scripts/c19/c19.rpy:4533
translate german c19s008_LeeroyJenkins_55b2617c:

    # "Entra en el coche sin decir una palabra. Se sienta en silencio, bajo la atenta mirada de Amanda."
    "Er steigt wortlos ins Auto. Schweigend setzt er sich unter Amandas wachsamen Blicken hin."

# game/scripts/c19/c19.rpy:4537
translate german c19s008_LeeroyJenkins_7887c072:

    # eil "Hazlo, Mamá."
    eil "Mach es, Mama."

# game/scripts/c19/c19.rpy:4539
translate german c19s008_LeeroyJenkins_f74dc452:

    # kia "Pero..."
    kia "Aber..."

# game/scripts/c19/c19.rpy:4541
translate german c19s008_LeeroyJenkins_8193ee6f:

    # eil "Hazlo, Mamá. Es el momento."
    eil "Mach es, Mama. Es ist Zeit."

# game/scripts/c19/c19.rpy:4543
translate german c19s008_LeeroyJenkins_b2bf6aaa:

    # kia "Chicas... siento todo esto..."
    kia "Mädels... Es tut mir alles so leid..."

# game/scripts/c19/c19.rpy:4544
translate german c19s008_LeeroyJenkins_8e0d5d9c:

    # kia "Siento que esta situación haya fastidiado la fiesta."
    kia "Es tut mir leid, dass diese Situation die Feier verdorben hat."

# game/scripts/c19/c19.rpy:4545
translate german c19s008_LeeroyJenkins_64882bcd:

    # kia "Pero tengo una cosa que decir..."
    kia "Aber eines möchte ich noch sagen..."

# game/scripts/c19/c19.rpy:4547
translate german c19s008_LeeroyJenkins_b02f5fdb:

    # kia "[mc] y yo hemos estado hablando... y después he hablado con mi hija..."
    kia "[mc] und ich haben uns unterhalten... und dann habe ich mit meiner Tochter gesprochen..."

# game/scripts/c19/c19.rpy:4550
translate german c19s008_LeeroyJenkins_29736878:

    # kia "También he hablado con [mar] y está de acuerdo."
    kia "Ich habe auch mit [mar] gesprochen und er stimmt zu."

# game/scripts/c19/c19.rpy:4552
translate german c19s008_LeeroyJenkins_cab30a92:

    # kia "También he hablado con Saira y está de acuerdo."
    kia "Ich habe auch mit Saira gesprochen und sie stimmt zu."

# game/scripts/c19/c19.rpy:4554
translate german c19s008_LeeroyJenkins_c18db85a:

    # kia "También he hablado con [nor] y está de acuerdo."
    kia "Ich habe auch mit [nor] gesprochen und er stimmt zu."

# game/scripts/c19/c19.rpy:4556
translate german c19s008_LeeroyJenkins_d1d910a8:

    # kia "También he hablado con [emm] y está de acuerdo."
    kia "Ich habe auch mit [emm] gesprochen und er stimmt zu."

# game/scripts/c19/c19.rpy:4558
translate german c19s008_LeeroyJenkins_66e7499e:

    # kia "También he hablado con [eri] y está de acuerdo."
    kia "Ich habe auch mit [eri] gesprochen und er stimmt zu."

# game/scripts/c19/c19.rpy:4560
translate german c19s008_LeeroyJenkins_d8f5783b:

    # kia "También he hablado con [dap] y está de acuerdo."
    kia "Ich habe auch mit [dap] gesprochen und er stimmt zu."

# game/scripts/c19/c19.rpy:4562
translate german c19s008_LeeroyJenkins_12d06e69:

    # kia "También he hablado con Scarlett y está de acuerdo."
    kia "Ich habe auch mit Scarlett gesprochen und sie stimmt zu."

# game/scripts/c19/c19.rpy:4564
translate german c19s008_LeeroyJenkins_1e87bf9b:

    # kia "También he hablado con Sam y está de acuerdo."
    kia "Ich habe auch mit Sam gesprochen und er stimmt zu."

# game/scripts/c19/c19.rpy:4566
translate german c19s008_LeeroyJenkins_e1070de7:

    # kia "También he hablado con Simone y está de acuerdo."
    kia "Ich habe auch mit Simone gesprochen und sie stimmt zu."

# game/scripts/c19/c19.rpy:4568
translate german c19s008_LeeroyJenkins_e7e6c60f:

    # kia "No he tenido la oportunidad de hablar con Alexia, y no sé si estará de acuerdo..."
    kia "Ich hatte noch keine Gelegenheit, mit Alexia zu sprechen, und ich weiß nicht, ob sie zustimmen wird..."

# game/scripts/c19/c19.rpy:4570
translate german c19s008_LeeroyJenkins_76167c06:

    # oma "Si vas a decir lo que me imagino, por mí adelante."
    oma "Wenn du sagen willst, was ich mir vorstelle, nur zu."

# game/scripts/c19/c19.rpy:4572
translate german c19s008_LeeroyJenkins_7b835157:

    # kia "También he hablado con Maddie y está de acuerdo."
    kia "Ich habe auch mit Maddie gesprochen und sie stimmt zu."

# game/scripts/c19/c19.rpy:4574
translate german c19s008_LeeroyJenkins_41e754ec:

    # kia "También he hablado con Debbie y está de acuerdo."
    kia "Ich habe auch mit Debbie gesprochen und sie stimmt zu."

# game/scripts/c19/c19.rpy:4576
translate german c19s008_LeeroyJenkins_46e2f77a:

    # kia "También he hablado con Megan y está de acuerdo."
    kia "Ich habe auch mit Megan gesprochen und sie stimmt zu."

# game/scripts/c19/c19.rpy:4578
translate german c19s008_LeeroyJenkins_5ac4d5c9:

    # kia "No sé si las chicas del harén vais a odiarme o a aceptarme... Espero que sea lo último. Al menos con las que he tenido la oportunidad de hablar así ha sido."
    kia "Ich weiß nicht, ob ihr Mädels im Harem mich hassen oder akzeptieren werdet... Ich hoffe Letzteres. Zumindest war es bei denen, mit denen ich bisher sprechen konnte, so."

# game/scripts/c19/c19.rpy:4580
translate german c19s008_LeeroyJenkins_15ee5a58:

    # kia "Es el momento de que deje de engañarme. De que afronte mis sentimientos..."
    kia "Es ist an der Zeit, dass ich aufhöre, mich selbst zu täuschen. Es ist an der Zeit, dass ich mich meinen Gefühlen stelle..."

# game/scripts/c19/c19.rpy:4581
translate german c19s008_LeeroyJenkins_a0565c6d:

    # kia "Si me aceptas, me gustaría explorar los sentimientos de los que hemos hablado antes. No voy a conseguir que dejen de crecer."
    kia "Wenn du einverstanden bist, würde ich die Gefühle, über die wir schon gesprochen haben, gerne näher erforschen. Ich kann nicht verhindern, dass sie stärker werden."

# game/scripts/c19/c19.rpy:4582
translate german c19s008_LeeroyJenkins_27c7f22c:

    # mc "Kiara, ¿aceptarte? Estaría loco si no lo hiciera. Y ya has hecho tú todo el trabajo..."
    mc "Kiara, dich annehmen? Ich wäre ja verrückt, es nicht zu tun. Und du hast ja schon alles dafür getan..."

# game/scripts/c19/c19.rpy:4584
translate german c19s008_LeeroyJenkins_eabde2c9:

    # "Kiara se lanza a tus brazos otra vez. Esta vez no busca un abrazo, busca tus labios."
    "Kiara wirft sich erneut in deine Arme. Diesmal sucht sie keine Umarmung, sondern deine Lippen."

# game/scripts/c19/c19.rpy:4585
translate german c19s008_LeeroyJenkins_5ee15f04:

    # "Tímidamente al principio. Con más énfasis mientras pasan los segundos..."
    "Zuerst zögerlich. Mit jeder Sekunde, die vergeht, wird es immer deutlicher..."

# game/scripts/c19/c19.rpy:4586
translate german c19s008_LeeroyJenkins_0287327d:

    # "Los dos sabéis que es el primer beso de muchos, que va a hacer de tus labios su hogar."
    "Ihr wisst beide, dass dies der erste von vielen Küssen ist, dass er deine Lippen zu seinem Zuhause machen wird."

# game/scripts/c19/c19.rpy:4587
translate german c19s008_LeeroyJenkins_4565571c:

    # "Un hogar que, obviamente, nunca compartirá con Solomon."
    "Ein Zuhause, das sie offensichtlich niemals mit Solomon teilen wird."

# game/scripts/c19/c19.rpy:4589
translate german c19s008_LeeroyJenkins_d03b200e:

    # "Tan solo Amanda presta atención a la cara de sorpresa de Solomon."
    "Nur Amanda bemerkt Solomons überraschten Gesichtsausdruck."

# game/scripts/c19/c19.rpy:4591
translate german c19s008_LeeroyJenkins_64ced3c3:

    # "Solo ella se da cuenta de que arranca el coche y se va."
    "Nur sie bemerkt, dass er den Wagen startet und wegfährt."

# game/scripts/c19/c19.rpy:4593
translate german c19s008_LeeroyJenkins_b0cdee7e:

    # kia "*Susurrando* Creo que es lo más difícil que he hecho nunca. Pero sienta tan bien..."
    kia "*flüsternd* Ich glaube, das ist das Schwierigste, was ich je getan habe. Aber es fühlt sich so gut an..."

# game/scripts/c19/c19.rpy:4594
translate german c19s008_LeeroyJenkins_05625234:

    # mc "Me alegra que hayas dado este paso, Kiara."
    mc "Ich bin froh, dass du diesen Schritt unternommen hast, Kiara."

# game/scripts/c19/c19.rpy:4596
translate german c19s008_LeeroyJenkins_81b096b8:

    # emm "¡Ha sido tan romántico! ¡Parece el guion de una película romántica mala! Pero ha quedado tan bonito..."
    emm "Es war so romantisch! Klingt wie das Drehbuch eines schlechten Liebesfilms! Aber es war wunderschön..."

# game/scripts/c19/c19.rpy:4599
translate german c19s008_LeeroyJenkins_88eba539:

    # "Kiara se vuelve a lanzar a tus brazos en un abrazo lleno de agradecimiento."
    "Kiara wirft sich dankbar in deine Arme."

# game/scripts/c19/c19.rpy:4601
translate german c19s008_LeeroyJenkins_08bd797a:

    # emm "¡Ha sido alucinante! ¡Parece el guion de una película romántica mala! Sólo ha faltado que os besarais..."
    emm "Es war unglaublich! Wie das Drehbuch eines schlechten Liebesfilms! Es fehlte nur noch der Kuss..."

# game/scripts/c19/c19.rpy:4603
translate german c19s008_LeeroyJenkins_622f6099:

    # "Solo Amanda se da cuenta de que Solomon arranca el coche y se va."
    "Nur Amanda bemerkt, wie Solomon den Wagen startet und wegfährt."

# game/scripts/c19/c19.rpy:4606
translate german c19s008_LeeroyJenkins_d9c3e52d:

    # "Las chicas arrancan a Kiara de tus brazos y se la llevan hacia la piscina. Ellas también quieren consolarla."
    "Die Mädchen ziehen Kiara aus deinen Armen und bringen sie zum Pool. Auch sie wollen sie trösten."

# game/scripts/c19/c19.rpy:4609
translate german c19s008_LeeroyJenkins_122e328a:

    # "O felicitarla por su decisión de dejar completamente atrás su pasado."
    "Oder gratulieren Sie ihr zu ihrer Entscheidung, ihre Vergangenheit vollständig hinter sich zu lassen."

# game/scripts/c19/c19.rpy:4611
translate german c19s008_LeeroyJenkins_07195c57:

    # ama "Nunca más vuelvas a hacerme esto, [mc]."
    ama "Tu mir das nie wieder an, [mc]."

# game/scripts/c19/c19.rpy:4612
translate german c19s008_LeeroyJenkins_bd40a085:

    # ama "Nunca des la espalda a un enemigo, aunque parezca derrotado."
    ama "Wende einem Feind niemals den Rücken zu, selbst wenn er besiegt erscheint."

# game/scripts/c19/c19.rpy:4613
translate german c19s008_LeeroyJenkins_bff1a070:

    # mc "Lo siento... y gracias."
    mc "Es tut mir leid... und vielen Dank."

# game/scripts/c19/c19.rpy:4615
translate german c19s008_LeeroyJenkins_4ec51ccf:

    # eva "Y pídele disculpas a [mar] de mi parte por haber escondido algunas armas en su casa..."
    eva "Und entschuldige dich bitte bei [mar] für mich dafür, dass ich einige Waffen in seinem Haus versteckt habe..."

# game/scripts/c19/c19.rpy:4616
translate german c19s008_LeeroyJenkins_d9b09568:

    # eva "A mí me da vergüenza... nos habéis tratado tan bien que... siento que os he traicionado... un poco."
    eva "Ich schäme mich... du hast uns so gut behandelt, dass... ich das Gefühl habe, dich ein bisschen verraten zu haben."

# game/scripts/c19/c19.rpy:4617
translate german c19s008_LeeroyJenkins_3197866c:

    # mc "No creo que le importe en este caso."
    mc "Ich glaube nicht, dass es ihn in diesem Fall kümmert."

# game/scripts/c19/c19.rpy:4618
translate german c19s008_LeeroyJenkins_1f570604:

    # mc "Y gracias a ti también."
    mc "Und vielen Dank auch."

# game/scripts/c19/c19.rpy:4619
translate german c19s008_LeeroyJenkins_b5724e16:

    # mc "¿Cuántas armas tienes repartidas por la casa?"
    mc "Wie viele Waffen sind bei Ihnen im Haus verstreut?"

# game/scripts/c19/c19.rpy:4621
translate german c19s008_LeeroyJenkins_57e5295a:

    # eva "Siete... no, ocho... Pero nadie las ha encontrado nunca."
    eva "Sieben... nein, acht... Aber niemand hat sie je gefunden."

# game/scripts/c19/c19.rpy:4622
translate german c19s008_LeeroyJenkins_04eb13ec:

    # mc "Creo que sería bueno que las retiraras, o las pusieras en una caja fuerte o algo..."
    mc "Ich denke, es wäre eine gute Idee, sie zu entfernen oder in einem Safe oder Ähnlichem aufzubewahren..."

# game/scripts/c19/c19.rpy:4624
translate german c19s008_LeeroyJenkins_691a5fed:

    # eva "Pero hoy han servido de algo... Si hubiera estado en una caja fuerte, dentro de casa..."
    eva "Aber heute haben sie sich als nützlich erwiesen... Wenn ich in einem Tresor im Haus gewesen wäre..."

# game/scripts/c19/c19.rpy:4625
translate german c19s008_LeeroyJenkins_de5dddd4:

    # mc "Por eso no le va a importar. Pero no va a querer armas por casa al alcance de cualquiera."
    mc "Deshalb ist es ihm egal. Aber er will nicht, dass Waffen im Haus herumliegen und für jeden leicht zugänglich sind."

# game/scripts/c19/c19.rpy:4627
translate german c19s008_LeeroyJenkins_66cce053:

    # ama "No, no le va a hacer ilusión, pero tenemos que tener medios para proteger a la familia."
    ama "Nein, er wird nicht erfreut darüber sein, aber wir müssen die Mittel haben, um die Familie zu schützen."

# game/scripts/c19/c19.rpy:4628
translate german c19s008_LeeroyJenkins_7d371bd8:

    # ama "Aunque hoy lo has hecho muy bien excepto por lo de darle la espalda. La violencia justa y, especialmente, necesaria. No te has excedido."
    ama "Obwohl du dich heute sehr gut geschlagen hast, abgesehen davon, dass du ihm den Rücken zugewandt hast. Die Gewalt war gerechtfertigt und vor allem notwendig. Du bist nicht zu weit gegangen."

# game/scripts/c19/c19.rpy:4630
translate german c19s008_LeeroyJenkins_647239d8:

    # eva "Yo seguramente hubiese dejado su cara hecha pulpa al segundo insulto. Me habría costado contenerme."
    eva "Nach der zweiten Beleidigung hätte ich ihm definitiv das Gesicht zertrümmert. Ich hätte mich kaum beherrschen können."

# game/scripts/c19/c19.rpy:4631
translate german c19s008_LeeroyJenkins_b0c58024:

    # eva "Y me ha costado no fallar cuando he disparado a la llave. Esa cabeza era un blanco tentador."
    eva "Und es war schwer, nicht zu verfehlen, als ich auf den Schlüssel schoss. Dieser Kopf war ein verlockendes Ziel."

# game/scripts/c19/c19.rpy:4632
translate german c19s008_LeeroyJenkins_05535524:

    # mc "*Risa* Ya has dicho antes que un asesinato podía fastidiar la fiesta. Limpiar sangre y esas cosas..."
    mc "*lacht* Du hast ja schon gesagt, dass ein Mord die Party ruinieren könnte. Blut wegwischen und so weiter..."

# game/scripts/c19/c19.rpy:4635
translate german c19s008_LeeroyJenkins_f815701b:

    # ama "Solo tengo una pregunta, [mc]."
    ama "Ich habe nur eine Frage, [mc]."

# game/scripts/c19/c19.rpy:4636
translate german c19s008_LeeroyJenkins_1afe9f90:

    # mc "Dime."
    mc "Sag mir."

# game/scripts/c19/c19.rpy:4638
translate german c19s008_LeeroyJenkins_182b7480:

    # ama "¿Vamos a tener que ponernos en plan damisela en apuros nosotras también para conseguir un beso como ese?"
    ama "Müssen wir etwa auch die hilflose Jungfrau spielen, um so einen Kuss zu bekommen?"

# game/scripts/c19/c19.rpy:4641
translate german c19s008_LeeroyJenkins_b547db77:

    # ama "¿Sabes que por un momento he pensado que Kiara iba besarte?"
    ama "Weißt du, dass ich einen Moment lang dachte, Kiara würde dich küssen?"

# game/scripts/c19/c19.rpy:4642
translate german c19s008_LeeroyJenkins_76361516:

    # ama "He pensado que el modo damisela en apuros iba a forzarte a aceptarla."
    ama "Ich dachte, der Modus der hilflosen Jungfrau würde dich dazu zwingen, es zu akzeptieren."

# game/scripts/c19/c19.rpy:4644
translate german c19s008_LeeroyJenkins_196b4397:

    # ama "Y después he pensado en qué pasaría si nosotras también estuviéramos en esa situación."
    ama "Und dann habe ich darüber nachgedacht, was passieren würde, wenn wir auch in dieser Situation wären."

# game/scripts/c19/c19.rpy:4645
translate german c19s008_LeeroyJenkins_43256da6:

    # mc "*Risa* No os pegaría el papel de damisela en apuros, Amanda. O al menos no como lo estaba Kiara."
    mc "*lacht* Ich wäre nicht die richtige Besetzung für die Rolle der hilflosen Jungfrau, Amanda. Oder zumindest nicht so wie Kiara."

# game/scripts/c19/c19.rpy:4646
translate german c19s008_LeeroyJenkins_4f2b1bc1:

    # mc "Aún no sé si quiero tener una relación con vosotras y no lo voy a saber hasta que no resolváis lo que hablamos anoche."
    mc "Ich weiß immer noch nicht, ob ich eine Beziehung mit dir möchte, und ich werde es erst wissen, wenn du das geklärt hast, worüber wir gestern Abend gesprochen haben."

# game/scripts/c19/c19.rpy:4648
translate german c19s008_LeeroyJenkins_8cb4e257:

    # eva "¿Qué? ¿Aún no lo sabes?"
    eva "Was? Du weißt es immer noch nicht?"

# game/scripts/c19/c19.rpy:4649
translate german c19s008_LeeroyJenkins_106e7b58:

    # mc "No, Eva. Hasta que no me digáis qué condiciones va a tener esa relación... o esas relaciones."
    mc "Nein, Eva. Nicht bevor du mir sagst, wie die Bedingungen dieser Beziehung... oder dieser Beziehungen... aussehen werden."

# game/scripts/c19/c19.rpy:4651
translate german c19s008_LeeroyJenkins_2bfff79d:

    # eva "¡Entonces no hay tiempo que perder, Amanda!"
    eva "Dann gibt es keine Zeit zu verlieren, Amanda!"

# game/scripts/c19/c19.rpy:4653
translate german c19s008_LeeroyJenkins_c4d99572:

    # eva "Nos vamos a algún lugar donde podamos hablar en privado."
    eva "Lass uns irgendwohin gehen, wo wir ungestört reden können."

# game/scripts/c19/c19.rpy:4655
translate german c19s008_LeeroyJenkins_20ce56a9:

    # "Eva y Amanda se van, dejándote solo."
    "Eva und Amanda gehen, und du bist allein."

# game/scripts/c19/c19.rpy:4656
translate german c19s008_LeeroyJenkins_b5e1b84a:

    # "El resto de las chicas están con Kiara."
    "Die übrigen Mädchen sind bei Kiara."

# game/scripts/c19/c19.rpy:4658
translate german c19s008_LeeroyJenkins_5dd83e48:

    # "Solomon no ha conseguido su objetivo de que Kiara se fuera con él."
    "Solomon hat sein Ziel, Kiara dazu zu bringen, mit ihm zu gehen, nicht erreicht."

# game/scripts/c19/c19.rpy:4659
translate german c19s008_LeeroyJenkins_4566a869:

    # "Pero su aparición ha matado el ambiente de la fiesta de cumpleaños."
    "Doch ihr Auftritt hat die Stimmung der Geburtstagsfeier zerstört."

# game/scripts/c19/c19.rpy:4660
translate german c19s008_LeeroyJenkins_8a72d8c4:

    # "El resto de la tarde gira alrededor de su visita. Todo el mundo quiere apoyar a Kiara."
    "Der Rest des Nachmittags dreht sich um ihren Besuch. Alle wollen Kiara unterstützen."

# game/scripts/c19/c19.rpy:4664
translate german c19s008_LeeroyJenkins_e1f3e549:

    # "Que Kiara se haya unido a las revelaciones del día tan solo ayuda a ello."
    "Dass Kiara sich an den Enthüllungen des Tages beteiligt, hilft nur."

# game/scripts/c19/c19.rpy:4666
translate german c19s008_LeeroyJenkins_82bc7200:

    # "Es la primera vez que alguien pide permiso para entrar en el harén, lo cual lo hace especial en cierto modo."
    "Es ist das erste Mal, dass jemand um Erlaubnis bittet, den Harem zu betreten, was die Situation in gewisser Weise besonders macht."

# game/scripts/c19/c19.rpy:4668
translate german c19s008_LeeroyJenkins_24af7778:

    # "Que haya mostrado el respeto suficiente hacia tu relación previa para pedir permiso, lo hace especial en cierto modo."
    "Die Tatsache, dass er eure vorherige Beziehung so sehr respektiert hat, dass er um Erlaubnis gebeten hat, macht sie in gewisser Weise besonders."

# game/scripts/c19/c19.rpy:4670
translate german c19s008_LeeroyJenkins_1fd645c8:

    # "Amanda no es la única que ha pensado que Kiara iba a besarte."
    "Amanda ist nicht die Einzige, die dachte, Kiara würde dich küssen."

# game/scripts/c19/c19.rpy:4672
translate german c19s008_LeeroyJenkins_05ab3366:

    # "Todas las chicas se acercan a ti en algún momento de la tarde, preocupadas por cómo te sientes tras lo que ha pasado."
    "Alle Mädchen kommen im Laufe des Nachmittags irgendwann auf dich zu und erkundigen sich besorgt danach, wie du dich nach dem Vorfall fühlst."

# game/scripts/c19/c19.rpy:4673
translate german c19s008_LeeroyJenkins_1820d88b:

    # "Todas ellas saben que la violencia no va contigo y que has actuado movido por la necesidad."
    "Sie alle wissen, dass Gewalt nicht Ihre Art ist und dass Sie aus Notwendigkeit gehandelt haben."

# game/scripts/c19/c19.rpy:4674
translate german c19s008_LeeroyJenkins_a176d9c9:

    # "Ninguna sabe que has disfrutado cada bofetón, puñetazo, y patada."
    "Keiner von ihnen ahnt, dass du jeden Schlag, jeden Faustschlag und jeden Tritt genossen hast."

# game/scripts/c19/c19.rpy:4675
translate german c19s008_LeeroyJenkins_d74e08bf:

    # "Lo ocultas haciendo bromas sobre la fiesta y los regalos. Evitas hablar de la visita de Solomon."
    "Du überspielst es mit Witzen über die Feier und die Geschenke. Du vermeidest es, über Salomons Besuch zu sprechen."

# game/scripts/c19/c19.rpy:4677
translate german c19s008_LeeroyJenkins_f0df114b:

    # "Amanda y Eva se pasan el resto de la tarde charlando, intentando resolver sus diferencias."
    "Amanda und Eva verbringen den Rest des Nachmittags mit Plaudern und versuchen, ihre Differenzen beizulegen."

# game/scripts/c19/c19.rpy:4679
translate german c19s008_LeeroyJenkins_06942bef:

    # "Prefieres no acercarte demasiado. Aún no estás preparado para tomar una decisión."
    "Sie möchten nicht zu nah herangehen. Sie sind noch nicht bereit, eine Entscheidung zu treffen."

# game/scripts/c19/c19.rpy:4682
translate german c19s008_LeeroyJenkins_5e5a1702:

    # "Cuando el sol deja de calentar, las chicas que viven en la ciudad empiezan a irse."
    "Wenn die Sonne aufhört zu wärmen, beginnen die Mädchen, die in der Stadt leben, diese zu verlassen."

# game/scripts/c19/c19.rpy:4683
translate german c19s008_LeeroyJenkins_4cc0d06b:

    # "Excepto Maddie, que se queda para la partida de DnD."
    "Außer Maddie, die für das Dungeons & Dragons-Spiel zurückbleibt."

# game/scripts/c19/c19.rpy:4684
translate german c19s008_LeeroyJenkins_c0080cf2:

    # "Todas rechazan la invitación a quedarse a cenar, para tristeza de Jamaal."
    "Sehr zum Bedauern von Jamaal lehnen sie alle die Einladung zum Abendessen ab."

# game/scripts/c19/c19.rpy:4685
translate german c19s008_LeeroyJenkins_09b6671c:

    # "Jamaal se lleva sobras para cenar. Sobras con las que cenarían cuatro o cinco personas."
    "Jamaal nimmt die Reste zum Abendessen mit. Genug Reste für vier oder fünf Personen."

# game/scripts/c19/c19.rpy:4687
translate german c19s008_LeeroyJenkins_5792b57a:

    # "Las que viven en casa pasan por la ducha haciendo turnos o duchándose en grupo."
    "Diejenigen, die noch zu Hause wohnen, duschen abwechselnd oder in Gruppen."

# game/scripts/c19/c19.rpy:4688
translate german c19s008_LeeroyJenkins_1458e440:

    # "Tú te duchas en el gimnasio. Nadie intenta pillarte desnudo mientras lo haces."
    "Du duschst im Fitnessstudio. Niemand versucht, dich dabei nackt zu erwischen."

# game/scripts/c19/c19.rpy:4690
translate german c19s008_LeeroyJenkins_49031071:

    # "Una vez rechazadas las invitaciones a cenar, descubrís que nadie tiene hambre. Todos habéis comido demasiado."
    "Nachdem ihr die Einladungen zum Abendessen abgelehnt habt, stellt ihr fest, dass niemand hungrig ist. Ihr habt alle zu viel gegessen."

# game/scripts/c19/c19.rpy:4691
translate german c19s008_LeeroyJenkins_9e204a7d:

    # "Un día entero en la piscina os ha dejado a todos agotados. La mayoría de las chicas se retiran pronto a sus habitaciones."
    "Ein ganzer Tag am Pool hat euch alle erschöpft. Die meisten Mädchen gehen früh zurück in ihre Zimmer."

# game/scripts/c19/c19.rpy:4692
translate german c19s008_LeeroyJenkins_fb9e1b73:

    # "[emm] se queja de que una partida de DnD sin pizza va a ser rara. Alguien comenta que le apetecía pizza con kiwi."
    "[emm] beschwert sich, dass ein D&D-Spiel ohne Pizza komisch wäre. Jemand anderes meint, er hätte gerne Pizza mit Kiwi."

# game/scripts/c19/c19.rpy:4693
translate german c19s008_LeeroyJenkins_af00b4fc:

    # "Es un alivio que todos hayáis comido demasiado y no tengáis que pedir ese crimen contra la humanidad. Si la piña tiene mala fama en la pizza, el kiwi tiene que ser el peor invento de la historia."
    "Zum Glück habt ihr alle zu viel gegessen und müsst dieses Verbrechen gegen die Menschlichkeit nicht bestellen. Wenn Ananas auf Pizza schon einen schlechten Ruf hat, dann ist Kiwi wohl die schlimmste Erfindung aller Zeiten."

# game/scripts/c19/c19.rpy:4697
translate german c19s009_Teaser_df652625:

    # "Te preparas para tu primera partida de DnD. No tienes ni idea de lo que esperar pese a que [dap] y Scarlett te lo han explicado cien veces los últimos días."
    "Du bereitest dich auf deine erste D&D-Runde vor. Du hast keine Ahnung, was dich erwartet, obwohl [dap] und Scarlett es dir in den letzten Tagen schon hundertmal erklärt haben."

# game/scripts/c19/c19.rpy:4700
translate german c19s009_Teaser_1ec36538:

    # "Cuando llegas a la cocina, solo están [dap] y Scarlett. [dap] tiene un montón de cosas extrañas encima de la mesa."
    "Als du in die Küche kommst, sind nur [dap] und Scarlett da. [dap] hat viele seltsame Dinge auf dem Tisch."

# game/scripts/c19/c19.rpy:4701
translate german c19s009_Teaser_0377f5a7:

    # "Deben ser los famosos dados para jugar a rol."
    "Das müssen die berühmten Rollenspielwürfel sein."

# game/scripts/c19/c19.rpy:4702
translate german c19s009_Teaser_07138114:

    # dap "¡Qué puntual! Siéntate a ese lado, en la segunda silla. La primera es de Scarlett."
    dap "Wie pünktlich! Setz dich dort drüben auf den zweiten Stuhl. Der erste ist Scarletts."

# game/scripts/c19/c19.rpy:4704
translate german c19s009_Teaser_156bd6b7:

    # sca "Necesito estar al lado de [dap] para mover las figuras. Ella no llega."
    sca "Ich muss neben [dap] stehen, um die Figuren bewegen zu können. Sie kann nicht herankommen."

# game/scripts/c19/c19.rpy:4705
translate german c19s009_Teaser_43d47f54:

    # mc "Ningún problema. Así también me ayudas a mí. Soy el único novato."
    mc "Kein Problem. Das hilft mir auch. Ich bin der einzige Neuling."

# game/scripts/c19/c19.rpy:4707
translate german c19s009_Teaser_5643f7fe:

    # dap "¿Preparado para la mayor aventura de tu vida?"
    dap "Bereit für das größte Abenteuer deines Lebens?"

# game/scripts/c19/c19.rpy:4708
translate german c19s009_Teaser_306193d8:

    # sca "No te asustes, es posible que no sea tanto como esperas."
    sca "Keine Panik, es ist vielleicht gar nicht so schlimm, wie du befürchtest."

# game/scripts/c19/c19.rpy:4709
translate german c19s009_Teaser_6e42abed:

    # dap "Tendrás que esperar un poco. Tienen que llegar el resto de las chicas."
    dap "Du musst dich noch etwas gedulden. Die anderen Mädchen müssen erst noch eintreffen."

# game/scripts/c19/c19.rpy:4710
translate german c19s009_Teaser_91f128d3:

    # sca "Suelen ser más puntuales, pero [eri] se está cambiando con Maddie. Empezaremos en poco tiempo."
    sca "Normalerweise sind sie pünktlicher, aber das ändert sich mit Maddie. Wir fangen bald an."

