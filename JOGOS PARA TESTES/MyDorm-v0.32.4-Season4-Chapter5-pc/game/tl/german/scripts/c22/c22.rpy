    eri "Ich liebe dich auch."

# game/scripts/c22/c22.rpy:2587
translate german c22s004_EriPregnancy_4b744f6f:

    # eri "Vamos a hacer esa prueba y a comer. Me muero de hambre."
    eri "Lass uns den Test jetzt machen und dann essen. Ich bin total ausgehungert."

# game/scripts/c22/c22.rpy:2589
translate german c22s004_EriPregnancy_f3ab5d3a:

    # eri "Vamos a comer. Me muero de hambre."
    eri "Lasst uns essen. Ich bin am Verhungern."

# game/scripts/c22/c22.rpy:2591
translate german c22s004_EriPregnancy_78454fc4:

