    "Es könnte gar nicht anders sein, das Telefon klingelt nur wenige Minuten, nachdem man sich umgezogen hat."

# game/scripts/c22/c22.rpy:1806
translate german c22s003_AmaCalls_56043ae8:

    # mc "Buenos días, [ama]. ¿Os encontráis mejor?"
    mc "Guten Morgen, [ama]. Geht es Ihnen besser?"

# game/scripts/c22/c22.rpy:1808
translate german c22s003_AmaCalls_638d7011:

    # ama "¿Puedes venir? Es urgente."
    ama "Kannst du kommen? Es ist dringend."

# game/scripts/c22/c22.rpy:1810
translate german c22s003_AmaCalls_ee71ee81:

    # "*Bang*"
    "*Knall*"

# game/scripts/c22/c22.rpy:1811
translate german c22s003_AmaCalls_103a9e52:

    # mc "¿Eso ha sido un disparo? ¿Estáis bien?"
    mc "War das ein Schuss? Geht es Ihnen gut?"

# game/scripts/c22/c22.rpy:1813
translate german c22s003_AmaCalls_ee71ee81_1:

    # "*Bang*"
    "*Knall*"

# game/scripts/c22/c22.rpy:1815
translate german c22s003_AmaCalls_50b640d2:

    # ama "Sí. Es [eva]. Por favor, ven cuanto antes."
    ama "Ja. Es ist [eva]. Bitte kommen Sie so schnell wie möglich."

# game/scripts/c22/c22.rpy:1817
translate german c22s003_AmaCalls_ee71ee81_2:

    # "*Bang*"
    "*Knall*"

# game/scripts/c22/c22.rpy:1818
translate german c22s003_AmaCalls_7a5ede3e:

    # mc "En diez minutos estoy ahí."
    mc "Ich bin in zehn Minuten da."

# game/scripts/c22/c22.rpy:1820
translate german c22s003_AmaCalls_ee71ee81_3:

    # "*Bang*"
    "*Knall*"

# game/scripts/c22/c22.rpy:1822
translate german c22s003_AmaCalls_20acc60e:

    # "Diez minutos después..."
    "Zehn Minuten später..."

# game/scripts/c22/c22.rpy:1823
translate german c22s003_AmaCalls_22ade097:

    # mc "¿Qué pasa [ama]?"
    mc "Was geht ab [ama]?"

# game/scripts/c22/c22.rpy:1824
translate german c22s003_AmaCalls_e67b790b:

    # "No puedes evitar fijarte en la muñeca encima de la mesa."
    "Man kann die Puppe auf dem Tisch einfach nicht übersehen."

# game/scripts/c22/c22.rpy:1825
translate german c22s003_AmaCalls_e99eb1e9:

    # ama "Es [eva]. Está muy jodida desde anoche."
    ama "Es ist [eva]. Sie ist seit letzter Nacht völlig durcheinander."

# game/scripts/c22/c22.rpy:1826
translate german c22s003_AmaCalls_0ad7b85d:

    # mc "¿Qué pasó anoche?"
    mc "Was ist letzte Nacht passiert?"

# game/scripts/c22/c22.rpy:1828
translate german c22s003_AmaCalls_0929a417:

    # ama "Nos llamó Aaron. Gavin ha perdido el brazo."
    ama "Aaron hat uns angerufen. Gavin hat seinen Arm verloren."

# game/scripts/c22/c22.rpy:1829
translate german c22s003_AmaCalls_c0b62619:

    # mc "¿Gavin? ¿Quién es Gavin?"
    mc "Gavin? Wer ist Gavin?"

# game/scripts/c22/c22.rpy:1831
translate german c22s003_AmaCalls_df6f3fe4:

    # ama "Durante el secuestro... en la cocina... El Serie G a quién disparó [eva]."
    ama "Während der Entführung... in der Küche... Die G-Serie, die [eva] erschossen hat."

# game/scripts/c22/c22.rpy:1832
translate german c22s003_AmaCalls_4b65fb16:

    # mc "¡Hostias! ¡Había olvidado su nombre! Recordaba a Erik y a Grant."
    mc "Heilige Scheiße! Ich hatte seinen Namen vergessen! Ich erinnerte mich an Erik und Grant."

# game/scripts/c22/c22.rpy:1833
translate german c22s003_AmaCalls_38938ae3:

    # mc "Parezco tonto... iba a preguntar si está grave."
    mc "Ich sehe albern aus... Ich wollte fragen, ob er ernsthaft krank ist."

# game/scripts/c22/c22.rpy:1835
translate german c22s003_AmaCalls_9ee20603:

    # ama "Sí, está grave. Fuera de peligro, pero grave."
    ama "Ja, sein Zustand ist ernst. Er ist außer Lebensgefahr, aber die Lage ist ernst."

# game/scripts/c22/c22.rpy:1836
translate german c22s003_AmaCalls_1e3e6765:

    # ama "Aunque le hicimos los primeros auxilios y lo evacuamos a Aruba en un avión medicalizado, no le han podido salvar el brazo."
    ama "Obwohl wir ihm Erste Hilfe leisteten und ihn mit einem Ambulanzflugzeug nach Aruba evakuierten, konnten sie seinen Arm nicht retten."

# game/scripts/c22/c22.rpy:1837
translate german c22s003_AmaCalls_4e1bc8fc:

    # ama "[eva] le destrozó los nervios."
    ama "[eva] hat seine Nerven völlig zerstört."

# game/scripts/c22/c22.rpy:1838
translate german c22s003_AmaCalls_c3dc8ad6:

    # mc "Pero eran los malos, no se debería sentir así. Nos salvasteis."
    mc "Aber sie waren die Bösen, du solltest nicht so denken. Du hast uns gerettet."

# game/scripts/c22/c22.rpy:1840
translate german c22s003_AmaCalls_74575155:

    # ama "[mc], parte del entrenamiento de los G lo hicieron [eva] y Diana. Conocíamos a los chicos desde que eran niños..."
    ama "[mc], ein Teil des Trainings der Gs wurde von [eva] und Diana durchgeführt. Wir kannten die Jungs schon seit ihrer Kindheit..."

# game/scripts/c22/c22.rpy:1841
translate german c22s003_AmaCalls_c691fab9:

    # mc "Lo entiendo. ¿Cómo está ella?"
    mc "Ich verstehe. Wie geht es ihr?"

# game/scripts/c22/c22.rpy:1843
translate german c22s003_AmaCalls_5dae45bb:

    # ama "Muy jodida. Después de vaciar seis cargadores se ha metido en su habitación."
    ama "Sie ist völlig durcheinander. Nachdem sie sechs Zeitschriften geleert hatte, ging sie in ihr Zimmer."

# game/scripts/c22/c22.rpy:1844
translate german c22s003_AmaCalls_9d125419:

    # ama "No quiere hablar conmigo. Por eso te he llamado."
    ama "Er will nicht mit mir reden. Deshalb habe ich dich angerufen."

# game/scripts/c22/c22.rpy:1845
translate german c22s003_AmaCalls_8ac27694:

    # mc "¿Y cómo estás tú?"
    mc "Und wie geht es Ihnen?"

# game/scripts/c22/c22.rpy:1847
translate german c22s003_AmaCalls_55ed25ae:

    # ama "Jodida, pero menos. No lo conocía tanto como [eva], y no fui yo quien disparó."
    ama "Es war zwar verfahren, aber nicht so schlimm. Ich kannte ihn nicht so gut wie [eva], und ich war nicht derjenige, der ihn erschossen hat."

# game/scripts/c22/c22.rpy:1848
translate german c22s003_AmaCalls_1450603d:

    # ama "[eva] es quién necesita hablar ahora mismo, no te preocupes por mí."
    ama "[eva] ist diejenige, die jetzt reden muss, mach dir keine Sorgen um mich."

# game/scripts/c22/c22.rpy:1849
translate german c22s003_AmaCalls_ae45af4c:

    # mc "¿Crees que va a querer hablar conmigo?"
    mc "Glaubst du, er wird mit mir reden wollen?"

# game/scripts/c22/c22.rpy:1851
translate german c22s003_AmaCalls_ac09df05:

    # ama "Hasta cierto punto representas la razón por la que disparó."
    ama "In gewisser Hinsicht verkörperst du den Grund, warum er geschossen hat."

# game/scripts/c22/c22.rpy:1852
translate german c22s003_AmaCalls_f4956f9a:

    # ama "No por ti. Por la familia."
    ama "Nicht für dich. Für die Familie."

# game/scripts/c22/c22.rpy:1853
translate german c22s003_AmaCalls_93f7def9:

    # ama "Una familia que ni siquiera sabíamos que teníamos por entonces."
    ama "Eine Familie, von der wir damals noch gar nichts wussten."

# game/scripts/c22/c22.rpy:1855
translate german c22s003_AmaCalls_cc0a482f:

    # mc "Lo entiendo. Déjame intentarlo. Sólo espero que no me dispare."
    mc "Ich verstehe. Lass mich es versuchen. Ich hoffe nur, er erschießt mich nicht."

# game/scripts/c22/c22.rpy:1858
translate german c22s003_AmaCalls_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c22/c22.rpy:1860
translate german c22s003_AmaCalls_7ee1cfab:

    # mc "[eva], soy yo. ¿Puedo pasar?"
    mc "[eva], ich bin's. Darf ich hereinkommen?"

# game/scripts/c22/c22.rpy:1861
translate german c22s003_AmaCalls_913eaf57:

    # eva "*A través de la puerta* ¡No!"
    eva "*Durch die Tür* Nein!"

# game/scripts/c22/c22.rpy:1862
translate german c22s003_AmaCalls_35a4914f:

    # mc "No me voy a ir a menos que salgas con un arma y me eches."
    mc "Ich gehe erst, wenn du mit einer Waffe kommst und mich rauswirfst."

# game/scripts/c22/c22.rpy:1863
translate german c22s003_AmaCalls_96b3f929:

    # eva "*A través de la puerta* No quiero ver a nadie, [mc]."
    eva "*Durch die Tür* Ich möchte niemanden sehen, [mc]."

# game/scripts/c22/c22.rpy:1864
translate german c22s003_AmaCalls_be088dc4:

    # mc "OK. Me voy."
    mc "Okay. Ich gehe."

# game/scripts/c22/c22.rpy:1865
translate german c22s003_AmaCalls_1d338278:

    # eva "*A través de la puerta* Gracias por entenderlo, [mc]."
    eva "*Durch die Tür* Danke für Ihr Verständnis, [mc]."

# game/scripts/c22/c22.rpy:1867
translate german c22s003_AmaCalls_efd3647b:

    # "Esperas un minuto al lado de la puerta antes de volver a llamar."
    "Du wartest eine Minute an der Tür, bevor du erneut klopfst."

# game/scripts/c22/c22.rpy:1869
translate german c22s003_AmaCalls_dd0461ef_1:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c22/c22.rpy:1870
translate german c22s003_AmaCalls_7bb8904d:

    # "No hay respuesta."
    "Es gibt keine Antwort."

# game/scripts/c22/c22.rpy:1872
translate german c22s003_AmaCalls_dd0461ef_2:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c22/c22.rpy:1873
translate german c22s003_AmaCalls_003de099:

    # eva "*A través de la puerta* ¡Vete, [ama]!"
    eva "*Durch die Tür* Verschwinde, [ama]!"

# game/scripts/c22/c22.rpy:1874
translate german c22s003_AmaCalls_e2696b73:

    # mc "*Cambiando la voz* Traigo una entrega para la Srta. [eva] Gilford."
    mc "*Veränderte Stimme* Ich habe eine Lieferung für Miss Gilford."

# game/scripts/c22/c22.rpy:1875
translate german c22s003_AmaCalls_357dc4bd:

    # eva "*A través de la puerta* [mc], no estoy de humor para bromas."
    eva "*Durch die Tür* [mc], ich habe keine Lust auf Witze."

# game/scripts/c22/c22.rpy:1876
translate german c22s003_AmaCalls_8c2a994e:

    # mc "*Cambiando la voz* Es un abrazo del Sr. [mc] Marks."
    mc "*Veränderte Stimme* Es ist eine Umarmung von Herrn [mc] Marks."

# game/scripts/c22/c22.rpy:1877
translate german c22s003_AmaCalls_03d54948:

    # "Pasan unos segundos sin que se oiga nada."
    "Einige Sekunden vergehen ohne jegliche Geräusche."

# game/scripts/c22/c22.rpy:1878
translate german c22s003_AmaCalls_163cb1f9:

    # eva "*A través de la puerta* Pasa..."
    eva "*Durch die Tür* Komm herein..."

# game/scripts/c22/c22.rpy:1880
translate german c22s003_AmaCalls_a9487c9a:

    # mc "¿Cómo estás?"
    mc "Wie geht es dir?"

# game/scripts/c22/c22.rpy:1881
translate german c22s003_AmaCalls_95e2709c:

    # eva "Queriendo estar sola, pero no me dejáis."
    eva "Ich möchte allein sein, aber du lässt mich nicht."

# game/scripts/c22/c22.rpy:1882
translate german c22s003_AmaCalls_c200bccf:

    # mc "¿Quieres ese abrazo?"
    mc "Möchtest du diese Umarmung?"

# game/scripts/c22/c22.rpy:1884
translate german c22s003_AmaCalls_fa05883a:

    # eva "Te he dicho que no estoy de humor para bromas, [mc]."
    eva "Ich hab dir doch gesagt, dass ich keine Lust auf Witze habe, [mc]."

# game/scripts/c22/c22.rpy:1885
translate german c22s003_AmaCalls_3a76a33d:

    # eva "No quiero ponerme borde o maleducada, pero no es el mejor momento."
    eva "Ich möchte nicht unhöflich sein, aber dies ist nicht der beste Zeitpunkt."

# game/scripts/c22/c22.rpy:1886
translate german c22s003_AmaCalls_26e320bf:

    # mc "OK. Te entiendo."
    mc "Okay, ich verstehe."

# game/scripts/c22/c22.rpy:1887
translate german c22s003_AmaCalls_2ce98e3c:

    # mc "¿Te importa si me siento?"
    mc "Darf ich mich setzen?"

# game/scripts/c22/c22.rpy:1889
translate german c22s003_AmaCalls_1efe5fbb:

    # eva "Lo vas a hacer quiera o no quiera yo, ¿verdad?"
    eva "Du wirst es sowieso tun, ob es mir passt oder nicht, richtig?"

# game/scripts/c22/c22.rpy:1890
translate german c22s003_AmaCalls_494a6419:

    # mc "Sí."
    mc "Ja."

# game/scripts/c22/c22.rpy:1891
translate german c22s003_AmaCalls_97a257c1:

    # eva "Entonces siéntate."
    eva "Dann setz dich hin."

# game/scripts/c22/c22.rpy:1893
translate german c22s003_AmaCalls_13d27f07:

    # "Te sientas en silencio durante un rato, mirándola, contagiándote de su tristeza."
    "Du sitzt eine Weile schweigend da, betrachtest sie und nimmst ihre Traurigkeit wahr."

# game/scripts/c22/c22.rpy:1894
translate german c22s003_AmaCalls_8ddd4361:

    # "No puedes sentirlo por Gavin más allá de que sea una persona que ha perdido un brazo. Una persona que ahora es tu responsabilidad."
    "Du kannst für Gavin nichts anderes empfinden, als dass er ein Mensch ist, der einen Arm verloren hat. Ein Mensch, für den du nun verantwortlich bist."

# game/scripts/c22/c22.rpy:1895
translate german c22s003_AmaCalls_b5ce6cb1:

    # "Entraron en casa de tu familia y os amenazaron. Pusieron en peligro a [nor], [bet] y [mee]."
    "Sie brachen in das Haus Ihrer Familie ein und bedrohten Sie. Sie gefährdeten [nor], [bet] und [mee]."

# game/scripts/c22/c22.rpy:1896
translate german c22s003_AmaCalls_478e5cdb:

    # "Ahora conoces su historia a través de las historias de [eva] y [ama]. Notas algo de empatía hacia él creciendo en ti."
    "Nun kennst du seine Geschichte durch die Erzählungen von [eva] und [ama]. Du spürst, wie in dir Mitgefühl für ihn wächst."

# game/scripts/c22/c22.rpy:1897
translate german c22s003_AmaCalls_733dfc17:

    # "Pero lo que te está rompiendo el alma es ver a [eva]."
    "Aber was dir das Herz bricht, ist der Anblick von [eva]."

# game/scripts/c22/c22.rpy:1898
translate german c22s003_AmaCalls_485bae61:

    # "Ver cómo juega con Fee mientras las lágrimas están a punto de asomar a sus ojos."
    "Ihm beim Spielen mit Fee zuzusehen, während ihm die Tränen in die Augen steigen."

# game/scripts/c22/c22.rpy:1899
translate german c22s003_AmaCalls_d38b993d:

    # "Decides levantarte."
    "Du beschließt aufzustehen."

# game/scripts/c22/c22.rpy:1901
translate german c22s003_AmaCalls_355187ae:

    # eva "¿Ya te vas?"
    eva "Gehst du schon?"

# game/scripts/c22/c22.rpy:1903
translate german c22s003_AmaCalls_ed54cc7a:

    # mc "No, no te vas a librar tan rápido de mí."
    mc "Nein, mich werden Sie nicht so schnell los."

# game/scripts/c22/c22.rpy:1906
translate german c22s003_AmaCalls_cda63e2d:

    # mc "El abrazo que traía estaba a punto de caducar."
    mc "Die Umarmung, die ich mitgebracht hatte, war im Begriff zu vergehen."

# game/scripts/c22/c22.rpy:1908
translate german c22s003_AmaCalls_c25fedb0:

    # eva "Gracias..."
    eva "Danke schön..."

# game/scripts/c22/c22.rpy:1909
translate german c22s003_AmaCalls_4559c981:

    # "Os pasáis un rato abrazados en silencio antes de que [eva] diga algo."
    "Ihr umarmt euch eine Weile schweigend, bevor [eva] etwas sagt."

# game/scripts/c22/c22.rpy:1911
translate german c22s003_AmaCalls_742528ea:

    # eva "No te vas a ir hasta que hable contigo de lo que me pasa, ¿verdad?"
    eva "Du gehst erst, wenn ich mit dir darüber gesprochen habe, was los ist, oder?"

# game/scripts/c22/c22.rpy:1912
translate german c22s003_AmaCalls_bfbddfc6:

    # mc "Yo solo estoy disfrutando del abrazo. Si quieres hablar de ello, habla. Si no quieres, podemos seguir en silencio."
    mc "Ich genieße einfach die Umarmung. Wenn du darüber reden möchtest, nur zu. Wenn nicht, können wir schweigend weitermachen."

# game/scripts/c22/c22.rpy:1913
translate german c22s003_AmaCalls_f60662ab:

    # mc "No me voy a ir a ninguna parte. Ni ahora ni nunca."
    mc "Ich gehe nirgendwohin. Nicht jetzt, nicht jemals."

# game/scripts/c22/c22.rpy:1915
translate german c22s003_AmaCalls_bb5ca692:

    # eva "Es que no lo vas a entender..."
    eva "Du wirst es einfach nicht verstehen..."

# game/scripts/c22/c22.rpy:1916
translate german c22s003_AmaCalls_3eeb4099:

    # mc "Dame una oportunidad. No soy tan tonto como parezco."
    mc "Gebt mir eine Chance. Ich bin nicht so dumm, wie ich aussehe."

# game/scripts/c22/c22.rpy:1917
translate german c22s003_AmaCalls_c9516075:

    # mc "Al menos a veces..."
    mc "Zumindest manchmal..."

# game/scripts/c22/c22.rpy:1919
translate german c22s003_AmaCalls_641085b4:

    # eva "*Risa triste* Sólo a veces..."
    eva "*Trauriges Lachen* Nur manchmal..."

# game/scripts/c22/c22.rpy:1920
translate german c22s003_AmaCalls_e634a4df:

    # mc "Bueno, alguna que otra vez. Ahora he sido tan listo como para conseguir entrar en tu fortaleza. *Risa*"
    mc "Nun ja, ab und zu schon. Jetzt war ich schlau genug, um in deine Festung einzudringen. *lacht*"

# game/scripts/c22/c22.rpy:1922
translate german c22s003_AmaCalls_c73f839f:

    # eva "En más de un sentido..."
    eva "In mehr als einer Hinsicht..."

# game/scripts/c22/c22.rpy:1923
translate german c22s003_AmaCalls_628758e0:

    # eva "No sé qué tienes, pero haces que la gente se sienta cómoda hablando."
    eva "Ich weiß nicht, was es an dir ist, aber du schaffst es, dass sich die Leute wohlfühlen, wenn sie mit dir reden."

# game/scripts/c22/c22.rpy:1924
translate german c22s003_AmaCalls_92a69b0a:

    # mc "Será mi don de gentes. A veces puedo ser encantador."
    mc "Es muss an meinem Umgang mit Menschen liegen. Manchmal kann ich charmant sein."

# game/scripts/c22/c22.rpy:1926
translate german c22s003_AmaCalls_e112eb74:

    # eva "Gavin ha perdido el brazo, aunque supongo que [ama] ya te lo ha contado."
    eva "Gavin hat seinen Arm verloren, obwohl [ama] Ihnen das vermutlich schon mitgeteilt hat."

# game/scripts/c22/c22.rpy:1927
translate german c22s003_AmaCalls_36f66786:

    # mc "Sí, me lo ha contado."
    mc "Ja, das hat er mir gesagt."

# game/scripts/c22/c22.rpy:1929
translate german c22s003_AmaCalls_d5ee0b2a:

    # eva "Si hubiera apuntado un par de centímetros a la derecha no hubiera pasado."
    eva "Hätte ich nur ein paar Zentimeter weiter rechts gezielt, wäre ich nicht durchgekommen."

# game/scripts/c22/c22.rpy:1930
translate german c22s003_AmaCalls_e4a5b722:

    # mc "Y si no hubieras disparado, te hubiera disparado él."
    mc "Und wenn du nicht geschossen hättest, hätte er dich erschossen."

# game/scripts/c22/c22.rpy:1932
translate german c22s003_AmaCalls_c4752d40:

    # eva "Gavin tenía la puntería de un stormtrooper. Nunca conseguí que mejorara."
    eva "Gavin hatte die Treffsicherheit eines Sturmtrupplers. Ich habe es nie geschafft, ihn zu verbessern."

# game/scripts/c22/c22.rpy:1933
translate german c22s003_AmaCalls_a438d52d:

    # eva "Sin embargo, era bueno en el cuerpo a cuerpo."
    eva "Im Nahkampf war er jedoch gut."

# game/scripts/c22/c22.rpy:1934
translate german c22s003_AmaCalls_1ac56caf:

    # mc "¿Lo conocías mucho? Me refiero aparte del entrenamiento."
    mc "Kanntest du ihn gut? Ich meine, abgesehen vom Training."

# game/scripts/c22/c22.rpy:1936
translate german c22s003_AmaCalls_a99858d6:

    # eva "Imagínate convivir con 500 personas las 24 horas del día durante 19 años. Cuando no estábamos en misiones, claro."
    eva "Stellen Sie sich vor, Sie würden 19 Jahre lang rund um die Uhr mit 500 Menschen zusammenleben. Natürlich nur, wenn wir nicht auf Missionen waren."

# game/scripts/c22/c22.rpy:1937
translate german c22s003_AmaCalls_1f00698f:

    # eva "Doce o trece años en el caso de los G. Sí, nos conocíamos. No, no éramos amigos, pero nos llevábamos bien."
    eva "Zwölf oder dreizehn Jahre im Fall der Gs. Ja, wir kannten uns. Nein, wir waren keine Freunde, aber wir haben uns gut verstanden."

# game/scripts/c22/c22.rpy:1938
translate german c22s003_AmaCalls_ccb3b460:

    # mc "Entiendo..."
    mc "Ich verstehe..."

# game/scripts/c22/c22.rpy:1940
translate german c22s003_AmaCalls_1aa524a0:

    # eva "No, [mc]. No lo puedes entender. Tenía mis órdenes y las cumplí. Y alguien salió herido en el proceso. Irreversiblemente."
    eva "Nein, [mc]. Du kannst das nicht verstehen. Ich habe meine Befehle erhalten und sie ausgeführt. Dabei wurde jemand verletzt. Unwiderruflich."

# game/scripts/c22/c22.rpy:1941
translate german c22s003_AmaCalls_ebbc4e6f:

    # eva "Pero conocía a ese alguien."
    eva "Aber ich kannte diese Person."

# game/scripts/c22/c22.rpy:1942
translate german c22s003_AmaCalls_f3bec387:

    # eva "He matado a gente, [mc]. Soy una puta asesina. Pero nunca había hecho daño a alguien a quien conociera."
    eva "Ich habe Menschen getötet, [mc]. Ich bin ein verdammter Mörder. Aber ich habe nie jemanden verletzt, den ich kannte."

# game/scripts/c22/c22.rpy:1943
translate german c22s003_AmaCalls_c8af1e5d:

    # eva "O a alguien que no se lo mereciera."
    eva "Oder an jemanden, der es nicht verdient hatte."

# game/scripts/c22/c22.rpy:1944
translate german c22s003_AmaCalls_775b3eb4:

    # mc "¿Nunca?"
    mc "Niemals?"

# game/scripts/c22/c22.rpy:1946
translate german c22s003_AmaCalls_41fe9448:

    # eva "No así, al menos."
    eva "So zumindest nicht."

# game/scripts/c22/c22.rpy:1947
translate german c22s003_AmaCalls_bff6921b:

    # eva "Tu primer domingo aquí, evité que otro serie G os matara, en el bosque."
    eva "Gleich an deinem ersten Sonntag hier habe ich einen anderen G-Series-Typen daran gehindert, dich im Wald umzubringen."

# game/scripts/c22/c22.rpy:1948
translate german c22s003_AmaCalls_316ec7e7:

    # mc "¿Cuando estaba con [eil]?"
    mc "Wann war ich bei [eil]?"

# game/scripts/c22/c22.rpy:1950
translate german c22s003_AmaCalls_490e543a:

    # eva "No, mientras vosotros comíais en casa. En el bosque estábamos él y yo. Él tenía un rifle de francotirador."
    eva "Nein, während du zu Hause gegessen hast. Wir waren allein zu zweit im Wald. Er hatte ein Scharfschützengewehr."

# game/scripts/c22/c22.rpy:1951
translate german c22s003_AmaCalls_9c3c9f68:

    # eva "Sólo necesité un disparo de advertencia para que Gustav bajara el arma y pudiera apresarlo y traerlo a la base."
    eva "Ein einziger Warnschuss reichte mir, damit Gustav seine Waffe senkte, sodass ich ihn festnehmen und zurück zur Basis bringen konnte."

# game/scripts/c22/c22.rpy:1952
translate german c22s003_AmaCalls_1cd0c3fa:

    # eva "Aparte de un ataque de nervios, no recibió más daños."
    eva "Abgesehen von einem Nervenzusammenbruch erlitt sie keinen weiteren Schaden."

# game/scripts/c22/c22.rpy:1953
translate german c22s003_AmaCalls_a1555d01:

    # mc "No sé cómo darte las gracias por eso..."
    mc "Ich weiß nicht, wie ich Ihnen dafür danken soll..."

# game/scripts/c22/c22.rpy:1955
translate german c22s003_AmaCalls_6e623447:

    # eva "No hace falta que me las des. Eran mis órdenes. No lo hacía por ti, ni por la familia."
    eva "Du brauchst sie mir nicht zu geben. Es waren meine Befehle. Ich habe es nicht für dich oder die Familie getan."

# game/scripts/c22/c22.rpy:1956
translate german c22s003_AmaCalls_ef009b77:

    # eva "No erais nuestra familia aún. Ni siquiera lo erais el día del secuestro."
    eva "Du gehörtest noch nicht zu unserer Familie. Du warst nicht einmal am Tag der Entführung Teil unserer Familie."

# game/scripts/c22/c22.rpy:1957
translate german c22s003_AmaCalls_9d40879e:

    # mc "Lo sé..."
    mc "Ich weiß..."

# game/scripts/c22/c22.rpy:1959
translate german c22s003_AmaCalls_44489a93:

    # eva "Nunca he estado en las circunstancias en las que estuvieron Beatrice, Claire, o Diana."
    eva "Ich habe mich nie in einer solchen Lage befunden wie Beatrice, Claire oder Diana."

# game/scripts/c22/c22.rpy:1960
translate german c22s003_AmaCalls_3cda6ecc:

    # eva "Nunca tuve que luchar por mi vida contra nuestra gente."
    eva "Ich musste nie gegen unser eigenes Volk um mein Leben kämpfen."

# game/scripts/c22/c22.rpy:1961
translate german c22s003_AmaCalls_c8563811:

    # eva "Y la primera vez que lo hago, alguien sale herido."
    eva "Und beim ersten Mal, als ich es tat, wurde jemand verletzt."

# game/scripts/c22/c22.rpy:1962
translate german c22s003_AmaCalls_93eff6a9:

    # mc "Ellos querían hacernos daño, [eva]."
    mc "Sie wollten uns verletzen, [eva]."

# game/scripts/c22/c22.rpy:1964
translate german c22s003_AmaCalls_1aa74c76:

    # eva "Lo sé. Y Eric nos hubiese matado si hubiera tenido la oportunidad, como hicieron con mis hermanas."
    eva "Ich weiß. Und Eric hätte uns umgebracht, wenn er die Chance dazu gehabt hätte, genau wie sie es mit meinen Schwestern getan haben."

# game/scripts/c22/c22.rpy:1965
translate german c22s003_AmaCalls_b625d932:

    # eva "Pero Gavin no. Gavin estaba ahí cumpliendo órdenes. Igual que yo. Y no se merecía acabar así..."
    eva "Aber nicht Gavin. Gavin war nur da und hat Befehle befolgt. Genau wie ich. Und er hatte es nicht verdient, so zu enden …"

# game/scripts/c22/c22.rpy:1966
translate german c22s003_AmaCalls_61e87c1d:

    # mc "No quiero sonar insensible, pero prefiero que sea él quien haya acabado así en vez de ser tú."
    mc "Ich will nicht unsensibel klingen, aber mir wäre es lieber, er wäre so geendet als du."

# game/scripts/c22/c22.rpy:1968
translate german c22s003_AmaCalls_7b8f7b14:

    # eva "Gracias. Yo... Gracias..."
    eva "Danke. Ich... Danke..."

# game/scripts/c22/c22.rpy:1970
translate german c22s003_AmaCalls_26d2f151:

    # eva "No te puedes imaginar lo complicado que es todo en mi cabeza."
    eva "Du kannst dir nicht vorstellen, wie kompliziert alles in meinem Kopf ist."

# game/scripts/c22/c22.rpy:1971
translate german c22s003_AmaCalls_9468925e:

    # eva "He herido a una persona a la que aprecio por salvar a una familia a la que quiero."
    eva "Ich habe einen mir nahestehenden Menschen verletzt, um eine Familie zu retten, die ich liebe."

# game/scripts/c22/c22.rpy:1972
translate german c22s003_AmaCalls_6a058b62:

    # eva "No sé qué le voy a decir la próxima vez que le vea..."
    eva "Ich weiß nicht, was ich ihm beim nächsten Mal sagen soll..."

# game/scripts/c22/c22.rpy:1973
translate german c22s003_AmaCalls_e2c467b9:

    # mc "Los dos cumplíais órdenes, y tú estabas en el bando ganador."
    mc "Ihr habt beide Befehle befolgt und wart auf der Gewinnerseite."

# game/scripts/c22/c22.rpy:1974
translate german c22s003_AmaCalls_b201a47a:

    # mc "Tú hiciste que ese bando ganara."
    mc "Du hast dieser Mannschaft zum Sieg verholfen."

# game/scripts/c22/c22.rpy:1976
translate german c22s003_AmaCalls_7f51842a:

    # eva "Pero no se tenía que haber llegado a esto. Ha muerto gente en esta guerra clon. Mis hermanas."
    eva "Aber so weit hätte es nicht kommen dürfen. Menschen sind in diesem Klonkrieg gestorben. Meine Schwestern."

# game/scripts/c22/c22.rpy:1977
translate german c22s003_AmaCalls_5ef9f1ea:

    # eva "Gavin ha perdido el brazo..."
    eva "Gavin hat seinen Arm verloren..."

# game/scripts/c22/c22.rpy:1978
translate german c22s003_AmaCalls_865d5e8f:

    # mc "Y Eric los dientes..."
    mc "Und Erics Zähne..."

# game/scripts/c22/c22.rpy:1980
translate german c22s003_AmaCalls_50c59d76:

    # eva "Eric es quien menos me importa. Los E tenían una vena cruel."
    eva "Eric ist mir am wenigsten wichtig. Die E's hatten eine grausame Ader."

# game/scripts/c22/c22.rpy:1981
translate german c22s003_AmaCalls_73caf2a5:

    # mc "¿Clonamos dientes en NTR? *Risa*"
    mc "Klonen wir bei NTR Zähne? *Gelächter*"

# game/scripts/c22/c22.rpy:1983
translate german c22s003_AmaCalls_edbc953c:

    # eva "*Risa triste* No, y tampoco brazos."
    eva "*Trauriges Lachen* Nein, und Arme auch nicht."

# game/scripts/c22/c22.rpy:1984
translate german c22s003_AmaCalls_f8af6c01:

    # eva "¿Qué va a hacer ahora?"
    eva "Was wird er nun tun?"

# game/scripts/c22/c22.rpy:1985
translate german c22s003_AmaCalls_0dae425a:

    # mc "Supongo que le podemos buscar un puesto donde siga siendo útil con un solo brazo y donde se sienta a gusto."
    mc "Ich denke, wir können ihm eine Position finden, in der er auch mit nur einem Arm noch nützlich sein kann und in der er sich wohlfühlt."

# game/scripts/c22/c22.rpy:1986
translate german c22s003_AmaCalls_283db93c:

    # mc "Ahora soy su jefe y una de las cosas que debe hacer un jefe es conseguir sacar el mejor partido de sus empleados."
    mc "Nun bin ich Ihr Chef, und eine der Aufgaben eines Chefs ist es, das Beste aus seinen Mitarbeitern herauszuholen."

# game/scripts/c22/c22.rpy:1988
translate german c22s003_AmaCalls_19b090fc:

    # eva "No sé qué podría hacer con un solo brazo, la verdad..."
    eva "Ehrlich gesagt, ich wüsste nicht, was ich mit nur einem Arm anfangen könnte..."

# game/scripts/c22/c22.rpy:1989
translate german c22s003_AmaCalls_f1281ea7:

    # eva "No sé qué podría hacer yo si sólo tuviera un brazo."
    eva "Ich weiß nicht, was ich tun könnte, wenn ich nur einen Arm hätte."

# game/scripts/c22/c22.rpy:1990
translate german c22s003_AmaCalls_4f0f86a0:

    # mc "Seguramente patearías culos con un solo brazo, pero ¿sabes una cosa?"
    mc "Du könntest wahrscheinlich auch mit einem Arm ordentlich austeilen, aber weißt du was?"

# game/scripts/c22/c22.rpy:2011
translate german c22s004_EveRoute_2be0c5eb:

    # eva "¿Qué? ¿Pareja? ¿Como si fuera tu novia?"
    eva "Was? Eine Partnerin? So wie deine Freundin?"

# game/scripts/c22/c22.rpy:2012
translate german c22s004_EveRoute_0d9c3d27:

    # mcp "(¡Por Dios! ¡Cómo odio esa palabra!)"
    mcp "(Um Himmels willen! Wie ich dieses Wort hasse!)"

# game/scripts/c22/c22.rpy:2013
translate german c22s004_EveRoute_61ca86f1:

    # mc "Sí, he dicho pareja. Como si fueras novia. ¿Demasiados disparos están afectando a tu audición?"
    mc "Ja, ich sagte Partner. So wie du meine Freundin wärst. Beeinträchtigen zu viele Schüsse dein Gehör?"

# game/scripts/c22/c22.rpy:2015
translate german c22s004_EveRoute_8e994c1b:

    # "[eva] salta como impulsada por un muelle."
    "[eva] springt, als ob er von einer Feder angetrieben würde."

# game/scripts/c22/c22.rpy:2016
translate german c22s004_EveRoute_351f6459:

    # eva "¿Me estás tomando el pelo?"
    eva "Willst du mich verarschen?"

# game/scripts/c22/c22.rpy:2017
translate german c22s004_EveRoute_fca52711:

    # mc "No."
    mc "NEIN."

# game/scripts/c22/c22.rpy:2019
translate german c22s004_EveRoute_b4a622fd:

    # eva "¿Lo estás haciendo porque te doy pena?"
    eva "Tust du das, weil du Mitleid mit mir hast?"

# game/scripts/c22/c22.rpy:2020
translate german c22s004_EveRoute_fca52711_1:

    # mc "No."
    mc "NEIN."

# game/scripts/c22/c22.rpy:2022
translate german c22s004_EveRoute_226cf3ff:

    # eva "¿Entonces por qué? ¿Por qué ahora?"
    eva "Warum also? Warum gerade jetzt?"

# game/scripts/c22/c22.rpy:2023
translate german c22s004_EveRoute_00da5eaf:

    # mc "Porque me gustas desde que te conocí... más o menos."
    mc "Weil ich dich schon immer mochte, seit ich dich kennengelernt habe... mehr oder weniger."

# game/scripts/c22/c22.rpy:2024
translate german c22s004_EveRoute_83dd1981:

    # mc "Y porque ahora [ama] y tú habéis arreglado vuestras diferencias."
    mc "Und weil nun [ama] und du eure Differenzen beigelegt habt."

# game/scripts/c22/c22.rpy:2025
translate german c22s004_EveRoute_01dfadaf:

    # mc "¿No puedes aceptar una buena noticia cuando la escuchas? O lo que para ti es una buena noticia..."
    mc "Können Sie gute Nachrichten nicht annehmen? Oder was sind für Sie gute Nachrichten?"

# game/scripts/c22/c22.rpy:2027
translate german c22s004_EveRoute_125ce26d:

    # eva "¿Y [ama]?"
    eva "Und [ama]?"

# game/scripts/c22/c22.rpy:2028
translate german c22s004_EveRoute_e8df90f5:

    # mc "[ama] no tiene nada que ver con lo que hagamos tú y yo."
    mc "[ama] hat nichts mit dem zu tun, was du und ich tun."

# game/scripts/c22/c22.rpy:2029
translate german c22s004_EveRoute_3b2521e3:

    # eva "¿Crees que se va a enfadar porque me hayas elegido a mí antes que a ella? También vas a querer salir con ella, ¿verdad?"
    eva "Glaubst du, sie wird sauer sein, dass du mich ihr vorgezogen hast? Du willst doch auch mit ihr ausgehen, oder?"

# game/scripts/c22/c22.rpy:2030
translate german c22s004_EveRoute_f150a240:

    # mcp "(No le ha dicho lo que pasó ayer en el café.)"
    mcp "(Sie hat ihm nicht erzählt, was gestern im Café passiert ist.)"

# game/scripts/c22/c22.rpy:2031
translate german c22s004_EveRoute_2833b24b:

    # mc "No, no creo que se enfade."
    mc "Nein, ich glaube nicht, dass er wütend sein wird."

# game/scripts/c22/c22.rpy:2032
translate german c22s004_EveRoute_00c1bef0:

    # mc "Y no te tienes que preocupar por si salgo con ella o no. No sois un pack indivisible como los yogures."
    mc "Und du brauchst dir keine Sorgen darüber zu machen, ob ich mit ihr ausgehe oder nicht. Wir sind ja kein untrennbares Paket wie Joghurt."

# game/scripts/c22/c22.rpy:2034
translate german c22s004_EveRoute_c7fac3f2:

    # eva "Pero..."
    eva "Aber..."

# game/scripts/c22/c22.rpy:2035
translate german c22s004_EveRoute_215caa51:

    # mc "Yo esperaba un beso en vez de un interrogatorio."
    mc "Ich hatte einen Kuss erwartet, nicht ein Verhör."

# game/scripts/c22/c22.rpy:2037
translate german c22s004_EveRoute_cafec592:

    # "La asesina pelirroja se lanza hacia ti, tumbándote en el arcón, y empieza a recorrer tus labios con ansia."
    "Die rothaarige Attentäterin stürzt sich auf dich, wirft dich zu Boden und knallt dir auf die Brust. Dann beginnt sie, eifrig deine Lippen zu küssen."

# game/scripts/c22/c22.rpy:2038
translate german c22s004_EveRoute_161d4452:

    # "Y mucha más torpeza de la que hubieras esperado."
    "Und weitaus mehr Ungeschicklichkeit, als man erwartet hätte."

# game/scripts/c22/c22.rpy:2040
translate german c22s004_EveRoute_34f26697:

    # eva "¿Contento?"
    eva "Froh?"

# game/scripts/c22/c22.rpy:2041
translate german c22s004_EveRoute_a0adf509:

    # mc "Sí. ¿Y tú?"
    mc "Ja, und Sie?"

# game/scripts/c22/c22.rpy:2043
translate german c22s004_EveRoute_6fff242d:

    # eva "Ermmm... Sí..."
    eva "Ähm... Ja..."

# game/scripts/c22/c22.rpy:2044
translate german c22s004_EveRoute_00731f2d:

    # mc "No creo que estés muy convencida."
    mc "Ich glaube nicht, dass du sehr überzeugt bist."

# game/scripts/c22/c22.rpy:2046
translate german c22s004_EveRoute_6b8aa6b2:

    # eva "Me siento rara... hace unos minutos tenía ganas de llorar."
    eva "Ich fühle mich komisch... vor ein paar Minuten hatte ich das Gefühl, weinen zu müssen."

# game/scripts/c22/c22.rpy:2047
translate german c22s004_EveRoute_37b4782c:

    # eva "Ahora tengo ganas de reír. Y de llorar a la vez..."
    eva "Jetzt habe ich das Gefühl, lachen zu müssen. Und gleichzeitig weinen zu müssen..."

# game/scripts/c22/c22.rpy:2048
translate german c22s004_EveRoute_39b5f54e:

    # mc "Supongo que estás en medio de una montaña rusa emocional."
    mc "Ich schätze, du befindest dich mitten in einer emotionalen Achterbahnfahrt."

# game/scripts/c22/c22.rpy:2050
translate german c22s004_EveRoute_a9be9b21:

    # eva "Supongo... No sé cómo actuar ahora..."
    eva "Ich glaube... ich weiß jetzt nicht, wie ich mich verhalten soll..."

# game/scripts/c22/c22.rpy:2051
translate german c22s004_EveRoute_155a73b6:

    # mc "¿Qué tal un largo abrazo? No hace falta que digas nada si no quieres."
    mc "Wie wäre es mit einer langen Umarmung? Du musst nichts sagen, wenn du nicht möchtest."

# game/scripts/c22/c22.rpy:2053
translate german c22s004_EveRoute_59a046a5:

    # eva "Creo que me puedo conformar con eso."
    eva "Damit kann ich mich zufriedengeben."

# game/scripts/c22/c22.rpy:2054
translate german c22s004_EveRoute_45a53858:

    # mc "*Risa* No sé si sentirme como que mis abrazos son un premio menor."
    mc "*Lacht* Ich weiß nicht, ob ich meine Umarmungen als eine Art kleine Belohnung betrachten sollte."

# game/scripts/c22/c22.rpy:2056
translate german c22s004_EveRoute_f3211d1f:

    # eva "No te rías de mí. Lo que sí sé es que quiero tener una cita contigo."
    eva "Lache mich nicht aus. Was ich aber weiß, ist, dass ich mit dir ausgehen möchte."

# game/scripts/c22/c22.rpy:2057
translate german c22s004_EveRoute_e2f99f94:

    # mc "¿Quieres que busque un sitio bonito?"
    mc "Soll ich einen schönen Ort für dich finden?"

# game/scripts/c22/c22.rpy:2059
translate german c22s004_EveRoute_c7e6be72:

    # eva "No. Quiero planear la cita yo."
    eva "Nein. Ich möchte das Date selbst planen."

# game/scripts/c22/c22.rpy:2060
translate german c22s004_EveRoute_f84ba5ae:

    # eva "Estoy segura de que has tenido mil citas y no quiero que sea como ninguna que hayas tenido con anterioridad."
    eva "Ich bin mir sicher, du hattest schon tausend Dates, und ich möchte nicht, dass dieses so wird wie alle deine vorherigen."

# game/scripts/c22/c22.rpy:2061
translate german c22s004_EveRoute_2d00f394:

    # mc "Me parece bien. Sorpréndeme."
    mc "Das klingt gut. Überrasch mich."

# game/scripts/c22/c22.rpy:2063
translate german c22s004_EveRoute_7894efb0:

    # eva "¡Mierda!"
    eva "Scheiße!"

# game/scripts/c22/c22.rpy:2064
translate german c22s004_EveRoute_788fe75f:

    # mc "¿Qué pasa, cielo?"
    mc "Was ist los, Schatz?"

# game/scripts/c22/c22.rpy:2066
translate german c22s004_EveRoute_0c0618a7:

    # eva "Se lo tengo que contar a [ama]. Ahora."
    eva "Ich muss [ama] Bescheid sagen. Jetzt."

# game/scripts/c22/c22.rpy:2067
translate german c22s004_EveRoute_3ed89801:

    # eva "Levántate. Vamos a decírselo. No quiero que piense que se lo estamos ocultando."
    eva "Steh auf. Lass es uns ihm sagen. Ich will nicht, dass er denkt, wir würden es vor ihm verheimlichen."

# game/scripts/c22/c22.rpy:2068
translate german c22s004_EveRoute_48688e12:

    # mc "*Risa* Lo de estar quieta disfrutando del abrazo no se te da muy bien. Vamos."
    mc "*Lacht* Du kannst nicht besonders gut stillsitzen und die Umarmung genießen. Komm schon."

# game/scripts/c22/c22.rpy:2070
translate german c22s004_EveRoute_f9704243:

    # eva "[ama], tenemos algo que decirte."
    eva "[ama], wir haben Ihnen etwas mitzuteilen."

# game/scripts/c22/c22.rpy:2072
translate german c22s004_EveRoute_6cdbd57d:

    # ama "¿Te encuentras mejor?"
    ama "Geht es dir besser?"

# game/scripts/c22/c22.rpy:2074
translate german c22s004_EveRoute_db54e694:

    # eva "Mas o menos. Todavía me siento mal por Gavin..."
    eva "So ungefähr. Gavin tut mir immer noch leid..."

# game/scripts/c22/c22.rpy:2075
translate german c22s004_EveRoute_b33399f4:

    # eva "Pero... queríamos decirte que..."
    eva "Aber... wir wollten Ihnen mitteilen, dass..."

# game/scripts/c22/c22.rpy:2077
translate german c22s004_EveRoute_ac83c3e7:

    # eva "Ayúdame, [mc]..."
    eva "Hilf mir, [mc]..."

# game/scripts/c22/c22.rpy:2078
translate german c22s004_EveRoute_fd12ea1d:

    # mc "Nope. Esto es algo que tienes que hacer tú."
    mc "Nein. Das musst du selbst erledigen."

# game/scripts/c22/c22.rpy:2080
translate german c22s004_EveRoute_a40c1f78:

    # eva "*Grrr* ¡Capullo!"
    eva "*Grrr* Idiot!"

# game/scripts/c22/c22.rpy:2081
translate german c22s004_EveRoute_eef46fb8:

    # eva "¡Vale!"
    eva "Okay!"

# game/scripts/c22/c22.rpy:2083
translate german c22s004_EveRoute_98f390cb:

    # eva "¡[mc] y yo estamos saliendo juntos! Aunque no sé por qué salgo con capullos."
    eva "[mc] und ich sind zusammen! Obwohl ich nicht weiß, warum ich immer wieder mit Idioten ausgehe."

# game/scripts/c22/c22.rpy:2084
translate german c22s004_EveRoute_c1284afa:

    # eva "¡Vamos a tener una cita!"
    eva "Lass uns auf ein Date gehen!"

# game/scripts/c22/c22.rpy:2086
translate german c22s004_EveRoute_9e8efeb1:

    # eva "Y nos hemos besado..."
    eva "Und wir küssten uns..."

# game/scripts/c22/c22.rpy:2088
translate german c22s004_EveRoute_bb654dc4:

    # ama "¡Eso es fantástico, [eva]!"
    ama "Das ist fantastisch, [eva]!"

# game/scripts/c22/c22.rpy:2090
translate german c22s004_EveRoute_90b2909c:

    # ama "Felicidades, [mc]. No podrías salir con nadie mejor."
    ama "Herzlichen Glückwunsch, [mc]. Du könntest mit niemand Besserem zusammen sein."

# game/scripts/c22/c22.rpy:2092
translate german c22s004_EveRoute_f104a946:

    # eva "Ahora solo falta que se decida contigo."
    eva "Jetzt muss er sich nur noch entscheiden, ob er mit dir zusammen sein will."

# game/scripts/c22/c22.rpy:2094
translate german c22s004_EveRoute_9d066684:

    # eva "Obviamente, me ha elegido a mi primero, pero me gustaría que también tú pudieras salir con él."
    eva "Natürlich hat er mich zuerst ausgewählt, aber ich würde mir wünschen, dass du auch mit ihm ausgehen kannst."

# game/scripts/c22/c22.rpy:2096
translate german c22s004_EveRoute_8f8d9b64:

    # mcp "(No sé a qué juega, pero será mejor seguirle el juego. *Risa mental*)"
    mcp "(Ich weiß nicht, was er da treibt, aber am besten spiele ich mit. *Innerliches Lachen*)"

# game/scripts/c22/c22.rpy:2098
translate german c22s004_EveRoute_8ee39ad0:

    # ama "Aunque si [mc] quiere salir conmigo, sabe lo que yo pienso y lo puede decir {b}ahora mismo{/b}."
    ama "Obwohl [mc] mit mir ausgehen will, weiß sie, was ich denke, und sie kann es {b}jetzt{/b} sagen."

# game/scripts/c22/c22.rpy:2099
translate german c22s004_EveRoute_aa92414a:

    # mc "Me encantaría. Estar con las dos sería maravilloso."
    mc "Ich würde es sehr gerne tun. Mit beiden zusammen zu sein, wäre wunderbar."

# game/scripts/c22/c22.rpy:2101
translate german c22s004_EveRoute_cb287e39:

    # eva "¡Felicidades, [ama]!"
    eva "Herzlichen Glückwunsch, [ama]!"

# game/scripts/c22/c22.rpy:2102
translate german c22s004_EveRoute_22901ee7:

    # eva "¡Nuestro primer novio oficial y lo compartimos!"
    eva "Unser erster offizieller Freund und wir teilen ihn!"

# game/scripts/c22/c22.rpy:2103
translate german c22s004_EveRoute_7d0ef333:

    # mc "¿Qué es eso del primer novio oficial?"
    mc "Was hat es mit dem ersten offiziellen Freund auf sich?"

# game/scripts/c22/c22.rpy:2105
translate german c22s004_EveRoute_7af743dd:

    # eva "En una misión en Budapest tuvimos que fingir que salíamos con dos operativos de la serie F."
    eva "Bei einem Einsatz in Budapest mussten wir so tun, als wären wir mit zwei Agenten der F-Serie zusammen."

# game/scripts/c22/c22.rpy:2106
translate german c22s004_EveRoute_6cd56b27:

    # ama "Ellos se hacían pasar por gemelos ricos y nosotras por sus novias."
    ama "Sie gaben sich als reiche Zwillinge aus und wir gaben uns als ihre Freundinnen aus."

# game/scripts/c22/c22.rpy:2108
translate german c22s004_EveRoute_b68d22d1:

    # eva "¡Pero nunca pasó nada entre nosotros!"
    eva "Aber zwischen uns ist nie etwas passiert!"

# game/scripts/c22/c22.rpy:2109
translate german c22s004_EveRoute_aa885f6b:

    # ama "Más allá de algún beso fingido."
    ama "Abgesehen von ein paar vorgetäuschten Küssen."

# game/scripts/c22/c22.rpy:2111
translate german c22s004_EveRoute_4edb2e23:

    # eva "¡Oops! ¡Te he abrazado y no te he dejado besar a tu novio!"
    eva "Ups! Ich habe dich umarmt und dich deinen Freund nicht küssen lassen!"

# game/scripts/c22/c22.rpy:2112
translate german c22s004_EveRoute_f1d23f62:

    # mcp "(Cada vez odio más la palabra. Pero en esto es como una niña, y necesita poner etiquetas.)"
    mcp "(Ich hasse dieses Wort immer mehr. Aber in dieser Hinsicht ist sie wie ein Kind und muss den Dingen Etiketten verpassen.)"

# game/scripts/c22/c22.rpy:2114
translate german c22s004_EveRoute_648e3dbd:

    # ama "¿Puedo?"
    ama "Dürfen?"

# game/scripts/c22/c22.rpy:2115
translate german c22s004_EveRoute_15025985:

    # eva "¡Di que sí!"
    eva "Sag ja!"

# game/scripts/c22/c22.rpy:2116
translate german c22s004_EveRoute_a3a04cea:

    # ama "*Susurrando* Me da un poco de vergüenza delante de [eva]."
    ama "*flüsternd* Mir ist es ein bisschen peinlich vor [eva]."

# game/scripts/c22/c22.rpy:2117
translate german c22s004_EveRoute_6e49d741:

    # mc "Sólo hay una forma de superar la vergüenza, preciosa."
    mc "Es gibt nur einen Weg, die Scham zu überwinden, Liebling."

# game/scripts/c22/c22.rpy:2119
translate german c22s004_EveRoute_069ebbec:

    # "Sin dejarle responder, tu boca se acerca a la suya y le das un tierno beso."
    "Ohne ihm eine Antwort zu ermöglichen, nähern sich deine Lippen seinen und du gibst ihm einen zärtlichen Kuss."

# game/scripts/c22/c22.rpy:2120
translate german c22s004_EveRoute_63fd7115:

    # "Ella responde de forma mucho menos apasionada que el día anterior en el café."
    "Sie reagiert deutlich weniger leidenschaftlich als am Vortag im Café."

# game/scripts/c22/c22.rpy:2121
translate german c22s004_EveRoute_bede44a2:

    # "La vergüenza es una barrera que le cuesta superar."
    "Scham ist ein Hindernis, das sie nur schwer überwinden kann."

# game/scripts/c22/c22.rpy:2123
translate german c22s004_EveRoute_57cd6c62:

    # mc "¿Bien?"
    mc "Gut?"

# game/scripts/c22/c22.rpy:2124
translate german c22s004_EveRoute_350a7b0e:

    # ama "Bien."
    ama "Gut."

# game/scripts/c22/c22.rpy:2126
translate german c22s004_EveRoute_cdfd0960:

    # eva "¿Bien? ¡Ha sido precioso!"
    eva "Gut? Es war wunderbar!"

# game/scripts/c22/c22.rpy:2159
translate german c22s004_EveRoute_2a8de6b7:

    # eva "¡Ha sido como cuando besa a las otras chicas!"
    eva "Es war genau wie bei den Küssen der anderen Mädchen!"

# game/scripts/c22/c22.rpy:2162
translate german c22s004_EveRoute_0ae1c79d:

    # eva "Ha sido como cuando besa a [gf]."
    eva "Es war wie beim Küssen [gf]."

# game/scripts/c22/c22.rpy:2163
translate german c22s004_EveRoute_29959d60:

    # mc "¿Cómo querías que fuera?"
    mc "Wie hättest du es dir gewünscht?"

# game/scripts/c22/c22.rpy:2165
translate german c22s004_EveRoute_e662d2a0:

    # eva "No tengo ni idea... pero presenciar vuestro primer beso me ha hecho sentir especial."
    eva "Ich habe keine Ahnung... aber euren ersten Kuss mitzuerleben, hat mir ein besonderes Gefühl gegeben."

# game/scripts/c22/c22.rpy:2167
translate german c22s004_EveRoute_acabbfe7:

    # eva "¡Tengo que irme!"
    eva "Ich muss gehen!"

# game/scripts/c22/c22.rpy:2168
translate german c22s004_EveRoute_a613997b:

    # mc "¿Dónde?"
    mc "Wo?"

# game/scripts/c22/c22.rpy:2169
translate german c22s004_EveRoute_fa3e71ef:

    # eva "¡Tengo que poner un mensaje en el grupo de WhatsUp! ¡Quiero que todas sepan que las dos estamos contigo!"
    eva "Ich muss eine Nachricht in der WhatsApp-Gruppe posten! Ich möchte, dass alle wissen, dass wir beide bei dir sind!"

# game/scripts/c22/c22.rpy:2171
translate german c22s004_EveRoute_8cb7a7b1:

    # eva "Y tengo que ducharme. Apesto."
    eva "Und ich muss duschen. Ich stinke."

# game/scripts/c22/c22.rpy:2174
translate german c22s004_EveRoute_7980a049:

    # mc "Y se fue."
    mc "Und er ging."

# game/scripts/c22/c22.rpy:2175
translate german c22s004_EveRoute_7ef1027e:

    # ama "Sí. Gracias por seguirme el juego."
    ama "Ja. Danke fürs Mitmachen."

# game/scripts/c22/c22.rpy:2176
translate german c22s004_EveRoute_8b0c6de9:

    # mc "¿A qué venía eso?"
    mc "Worum ging es dabei?"

# game/scripts/c22/c22.rpy:2178
translate german c22s004_EveRoute_f877ba9c:

    # ama "Ayer, cuando llegué, quería contárselo, pero [eva] estaba muy cansada y se fue a dormir en seguida. La tenía que despertar para ir a casa a cenar."
    ama "Gestern, als ich ankam, wollte ich es ihr sagen, aber sie war sehr müde und ist sofort eingeschlafen. Ich musste sie wecken, um mit ihr zum Abendessen nach Hause zu fahren."

# game/scripts/c22/c22.rpy:2179
translate german c22s004_EveRoute_4a174a9a:

    # ama "La despertó la llamada de [aar]. Y se puso como la has visto cuando has llegado."
    ama "Sie wurde durch den Anruf von [aar] geweckt. Und sie sah genauso aus wie du sie bei deiner Ankunft gesehen hast."

# game/scripts/c22/c22.rpy:2180
translate german c22s004_EveRoute_3750bc87:

    # mc "Por eso llamaste para decir que no os encontrabais bien, ¿no?"
    mc "Deshalb haben Sie ja angerufen, um zu sagen, dass es Ihnen nicht gut geht, richtig?"

# game/scripts/c22/c22.rpy:2182
translate german c22s004_EveRoute_77c898c5:

    # ama "Exacto. Ella no estaba de humor para socializar, y yo no quería dejarla sola, por muchas ganas que tuviera de volver a verte. De veros a todos."
    ama "Genau. Sie hatte keine Lust, sich zu unterhalten, und ich wollte sie nicht allein lassen, so sehr ich euch auch wiedersehen wollte. Euch alle wiedersehen wollte."

# game/scripts/c22/c22.rpy:2183
translate german c22s004_EveRoute_bb76bcc2:

    # ama "Después de la llamada, no estaba de humor para nada, menos aún para que se lo contara."
    ama "Nach dem Anruf war sie zu nichts bereit, schon gar nicht, dass ich es ihr erzähle."

# game/scripts/c22/c22.rpy:2185
translate german c22s004_EveRoute_acb231af:

    # ama "Ya has visto lo feliz que le ha hecho que la \"eligieras antes que a mí\"."
    ama "Du hast ja schon gesehen, wie glücklich sie darüber war, dass du dich „für sie und gegen mich entschieden hast“."

# game/scripts/c22/c22.rpy:2186
translate german c22s004_EveRoute_ae2d444e:

    # mc "Si se lo hubieras dicho, se hubiera sentido más miserable aún, sumado a lo de Gavin."
    mc "Wenn du es ihm gesagt hättest, wäre er, zusätzlich zu dem, was mit Gavin passiert war, noch viel unglücklicher gewesen."

# game/scripts/c22/c22.rpy:2188
translate german c22s004_EveRoute_0ce98a1f:

    # ama "Exacto. Por eso envié el mensaje individualmente a todas las chicas."
    ama "Genau. Deshalb habe ich die Nachricht auch an alle Mädchen einzeln geschickt."

# game/scripts/c22/c22.rpy:2189
translate german c22s004_EveRoute_2999362c:

    # mc "Hablando del mensaje. Deberías avisar a [emm] de que no le responda diciendo que ya sabía lo tuyo."
    mc "Apropos Nachricht: Du solltest [emm] warnen, nicht zu antworten, dass er bereits von dir wisse."

# game/scripts/c22/c22.rpy:2190
translate german c22s004_EveRoute_4533066c:

    # mc "Si lo lee en el grupo, es capaz de descubrirte."
    mc "Wenn er es in der Gruppe liest, kann er dich entlarven."

# game/scripts/c22/c22.rpy:2192
translate german c22s004_EveRoute_102790c8:

    # ama "*Risa* No te preocupes."
    ama "*Lacht* Keine Sorge."

# game/scripts/c22/c22.rpy:2193
translate german c22s004_EveRoute_bddecb9f:

    # ama "Llamé a [emm] después de enviar el mensaje y le dije que, hasta que [eva] no dijera algo o yo lo publicara en el grupo, ella no sabía nada."
    ama "Ich habe [emm] angerufen, nachdem ich die Nachricht gesendet hatte, und ihr gesagt, dass sie nichts wissen würde, bis [eva] etwas sagt oder ich es in der Gruppe poste."

# game/scripts/c22/c22.rpy:2194
translate german c22s004_EveRoute_429b41cd:

    # mc "Me sorprende lo mucho que nos conoces, [ama]."
    mc "Ich bin überrascht, wie gut du uns kennst, [ama]."

# game/scripts/c22/c22.rpy:2196
translate german c22s004_EveRoute_55913309:

    # ama "*Risa* Gajes del oficio."
    ama "*Gelächter* Berufsrisiken."

# game/scripts/c22/c22.rpy:2199
translate german c22s004_EveRoute_1c771fe6:

    # mcp "(No sé a qué juega, pero será mejor seguirle el juego.)"
    mcp "(Ich weiß nicht, was er vorhat, aber es ist am besten, mitzuspielen.)"

# game/scripts/c22/c22.rpy:2201
translate german c22s004_EveRoute_1095c513:

    # ama "[mc] y yo decidimos ayer que no vamos a salir juntos de momento."
    ama "[mc] und ich haben gestern beschlossen, dass wir vorerst nicht zusammen ausgehen werden."

# game/scripts/c22/c22.rpy:2202
translate german c22s004_EveRoute_f54fd145:

    # ama "Entre otras cosas, con la preparación del viaje a Aruba y todo lo que hay que hacer, hubiera sido una distracción."
    ama "Unter anderem wäre es angesichts der Vorbereitungen für die Reise nach Aruba und all der damit verbundenen Aufgaben eine Ablenkung gewesen."

# game/scripts/c22/c22.rpy:2203
translate german c22s004_EveRoute_ed5bbd50:

    # mc "Entre otras cosas..."
    mc "Unter anderem..."

# game/scripts/c22/c22.rpy:2205
translate german c22s004_EveRoute_cc99be57:

    # eva "Entonces yo también debería dejar de salir con él, ¿no?"
    eva "Dann sollte ich den Kontakt zu ihm auch abbrechen, richtig?"

# game/scripts/c22/c22.rpy:2206
translate german c22s004_EveRoute_6bc93654:

    # ama "No hace falta. Las preparaciones las estoy llevando a cabo yo."
    ama "Das ist nicht nötig. Ich kümmere mich selbst um die Vorbereitungen."

# game/scripts/c22/c22.rpy:2207
translate german c22s004_EveRoute_ec8a8faf:

    # ama "Tú disfruta de tu novio y yo me ocupo del resto."
    ama "Genieße deinen Freund und ich kümmere mich um den Rest."

# game/scripts/c22/c22.rpy:2209
translate german c22s004_EveRoute_ebaf0c4f:

    # eva "¡Gracias, [ama]! ¡Eres la mejor hermana del mundo!"
    eva "Danke, [ama]! Du bist die beste Schwester der Welt!"

# game/scripts/c22/c22.rpy:2211
translate german c22s004_EveRoute_8b960449:

    # ama "Os voy a dejar solos un rato... Tengo cosas que hacer."
    ama "Ich lasse dich jetzt erst mal allein... Ich habe noch etwas zu erledigen."

# game/scripts/c22/c22.rpy:2213
translate german c22s004_EveRoute_f03c5ad0:

    # eva "¡No hace falta! ¡Tengo que irme!"
    eva "Das ist nicht nötig! Ich muss los!"

# game/scripts/c22/c22.rpy:2214
translate german c22s004_EveRoute_a613997b_1:

    # mc "¿Dónde?"
    mc "Wo?"

# game/scripts/c22/c22.rpy:2215
translate german c22s004_EveRoute_2a59b9b4:

    # eva "¡Tengo que poner un mensaje en el grupo de WhatsUp! ¡Quiero que todas sepan que estamos juntos!"
    eva "Ich muss eine Nachricht in der WhatsApp-Gruppe posten! Ich möchte, dass alle wissen, dass wir das gemeinsam durchstehen!"

# game/scripts/c22/c22.rpy:2217
translate german c22s004_EveRoute_8cb7a7b1_1:

    # eva "Y tengo que ducharme. Apesto."
    eva "Und ich muss duschen. Ich stinke."

# game/scripts/c22/c22.rpy:2220
translate german c22s004_EveRoute_7980a049_1:

    # mc "Y se fue."
    mc "Und er ging."

# game/scripts/c22/c22.rpy:2221
translate german c22s004_EveRoute_7ef1027e_1:

    # ama "Sí. Gracias por seguirme el juego."
    ama "Ja. Danke fürs Mitmachen."

# game/scripts/c22/c22.rpy:2222
translate german c22s004_EveRoute_8b0c6de9_1:

    # mc "¿A qué venía eso?"
    mc "Worum ging es dabei?"

# game/scripts/c22/c22.rpy:2224
translate german c22s004_EveRoute_f877ba9c_1:

    # ama "Ayer, cuando llegué, quería contárselo, pero [eva] estaba muy cansada y se fue a dormir en seguida. La tenía que despertar para ir a casa a cenar."
    ama "Gestern, als ich ankam, wollte ich es ihr sagen, aber sie war sehr müde und ist sofort eingeschlafen. Ich musste sie wecken, um mit ihr zum Abendessen nach Hause zu fahren."

# game/scripts/c22/c22.rpy:2225
translate german c22s004_EveRoute_4a174a9a_1:

    # ama "La despertó la llamada de [aar]. Y se puso como la has visto cuando has llegado."
    ama "Sie wurde durch den Anruf von [aar] geweckt. Und sie sah genauso aus wie du sie bei deiner Ankunft gesehen hast."

# game/scripts/c22/c22.rpy:2226
translate german c22s004_EveRoute_3750bc87_1:

    # mc "Por eso llamaste para decir que no os encontrabais bien, ¿no?"
    mc "Deshalb haben Sie ja angerufen, um zu sagen, dass es Ihnen nicht gut geht, richtig?"

# game/scripts/c22/c22.rpy:2228
translate german c22s004_EveRoute_148ac3b2:

    # ama "Exacto. Ella no estaba de humor para socializar, y yo no quería dejarla sola, por muchas ganas que tuviera de volver a veros a todos."
    ama "Genau. Sie hatte keine Lust, sich zu unterhalten, und ich wollte sie nicht allein lassen, so sehr ich euch alle auch wiedersehen wollte."

# game/scripts/c22/c22.rpy:2229
translate german c22s004_EveRoute_bb76bcc2_1:

    # ama "Después de la llamada, no estaba de humor para nada, menos aún para que se lo contara."
    ama "Nach dem Anruf war sie zu nichts bereit, schon gar nicht, dass ich es ihr erzähle."

# game/scripts/c22/c22.rpy:2231
translate german c22s004_EveRoute_e79836da:

    # ama "Por eso tampoco le he dicho toda la verdad. No quiero estropear su felicidad ahora mismo."
    ama "Deshalb habe ich ihr auch nicht die ganze Wahrheit gesagt. Ich will ihr Glück jetzt nicht zerstören."

# game/scripts/c22/c22.rpy:2232
translate german c22s004_EveRoute_252d779b:

    # ama "Mejor ocultar un poco la verdad, aunque no sea mentira del todo."
    ama "Es ist besser, die Wahrheit ein wenig zu verschleiern, selbst wenn es keine vollständige Lüge ist."

# game/scripts/c22/c22.rpy:2233
translate german c22s004_EveRoute_ed5bbd50_1:

    # mc "Entre otras cosas..."
    mc "Unter anderem..."

# game/scripts/c22/c22.rpy:2235
translate german c22s004_EveRoute_f3a68e37:

    # ama "Exacto. Hubiera sido una distracción empezar a salir contigo ahora, aunque no me importaría tener esa distracción. Hay otras razones, obviamente."
    ama "Genau. Es wäre eine Ablenkung gewesen, jetzt mit dir anzufangen, obwohl ich diese Ablenkung nicht schlimm fände. Es gibt natürlich noch andere Gründe."

# game/scripts/c22/c22.rpy:2236
translate german c22s004_EveRoute_0423e28d:

    # ama "Pero no quiero que se sienta mal porque la hayas elegido a ella y no a mí."
    ama "Aber ich möchte nicht, dass sie sich schlecht fühlt, weil du sie und nicht mich gewählt hast."

# game/scripts/c22/c22.rpy:2237
translate german c22s004_EveRoute_a4bc4165:

    # mc "Ciertamente, eres una muy buena hermana."
    mc "Du bist ganz bestimmt eine sehr gute Schwester."

# game/scripts/c22/c22.rpy:2240
translate german c22s004_EveRoute_952aa276:

    # "En ese momento suena tu teléfono."
    "In diesem Moment klingelt Ihr Telefon."

# game/scripts/c22/c22.rpy:2244
translate german c22s004_Convo_a444a745:

    # ama "No te preocupes por eso, habrá tiempo para decidirnos. Ahora tenéis que disfrutar vosotros."
    ama "Mach dir darüber keine Gedanken, du wirst noch Zeit haben, dich zu entscheiden. Jetzt sollt ihr euch einfach amüsieren."

# game/scripts/c22/c22.rpy:2246
translate german c22s004_Convo_c4e93806:

    # ama "Pero antes, tienes que recoger esas cajas de munición."
    ama "Aber zuerst müssen Sie diese Munitionskisten einsammeln."

# game/scripts/c22/c22.rpy:2248
translate german c22s004_Convo_e5582b0b:

    # eva "¿Qué cajas?"
    eva "Welche Kisten?"

# game/scripts/c22/c22.rpy:2249
translate german c22s004_Convo_fdc2604f:

    # ama "¡Ah, no! Ya las he recogido yo. Me había olvidado..."
    ama "Oh nein! Ich habe sie schon abgeholt. Ich hatte es vergessen..."

# game/scripts/c22/c22.rpy:2256
translate german c22s004_EveNoRoute_cd149d43:

    # eva "Has dicho prima y no novia."
    eva "Du hast Cousine gesagt, nicht Freundin."

# game/scripts/c22/c22.rpy:2260
translate german c22s004_EveNoRoute_66b2c48a:

    # eva "Supongo que no te refieres a lo que haces con [dap.nick] y [eri.nick]..."
    eva "Ich nehme an, Sie beziehen sich nicht auf das, was Sie mit [dap.nick] und [eri.nick] machen..."

# game/scripts/c22/c22.rpy:2262
translate german c22s004_EveNoRoute_380047ea:

    # eva "Supongo que no te refieres a lo que haces con [dap.nick]..."
    eva "Ich nehme an, Sie beziehen sich nicht auf das, was Sie mit [dap.nick] machen..."

# game/scripts/c22/c22.rpy:2265
translate german c22s004_EveNoRoute_76894bd1:

    # eva "Supongo que no te refieres a lo que haces con [eri.nick]..."
    eva "Ich nehme an, Sie beziehen sich nicht auf das, was Sie mit [eri.nick] machen..."

# game/scripts/c22/c22.rpy:2266
translate german c22s004_EveNoRoute_2e706747:

    # mc "[eva], te quiero, pero no de esa forma."
    mc "[eva], Ich liebe dich, aber nicht auf diese Weise."

# game/scripts/c22/c22.rpy:2267
translate german c22s004_EveNoRoute_8d85247c:

    # mc "Quizás no sea el mejor momento para decirte algo así, pero tengo que ser sincero contigo y evitar que te hagas falsas esperanzas."
    mc "Das ist vielleicht nicht der beste Zeitpunkt, um dir so etwas zu sagen, aber ich muss ehrlich zu dir sein und verhindern, dass du dir falsche Hoffnungen machst."

# game/scripts/c22/c22.rpy:2269
translate german c22s004_EveNoRoute_97986df1:

    # "Salta como impulsada por un resorte."
    "Es springt, als würde es von einer Feder angetrieben."

# game/scripts/c22/c22.rpy:2270
translate german c22s004_EveNoRoute_aeb4230e:

    # eva "Pues llegas un poco tarde para eso... ¿Quieres que cambie algo de mí?"
    eva "Nun, dafür ist es etwas spät... Soll ich etwas an mir ändern?"

# game/scripts/c22/c22.rpy:2272
translate german c22s004_EveNoRoute_bff80ff8:

    # eva "Creía que... tengo la cara de [dap.nick]... ¿Quieres que me haga una trenza?"
    eva "Ich dachte... Ich sehe aus wie [dap.nick]... Soll ich mir die Haare flechten?"

# game/scripts/c22/c22.rpy:2274
translate german c22s004_EveNoRoute_0cf10a52:

    # eva "Creía que... tengo la cara de [eri.nick]... ¿Quieres que me haga gótica?"
    eva "Ich dachte... Ich sehe aus wie [eri.nick]... Soll ich etwa zum Gothic werden?"

# game/scripts/c22/c22.rpy:2275
translate german c22s004_EveNoRoute_769a0512:

    # mc "No, [eva]. Eres perfecta tal como eres, pero no siento por ti lo que quieres que sienta."
    mc "Nein, [eva]. Du bist perfekt, so wie du bist, aber ich empfinde nicht das für dich, was du von mir verlangst."

# game/scripts/c22/c22.rpy:2277
translate german c22s004_EveNoRoute_2bdb8f13:

    # eva "¿Entonces por qué no?"
    eva "Warum also nicht?"

# game/scripts/c22/c22.rpy:2278
translate german c22s004_EveNoRoute_fb78d9cd:

    # mc "Porque no le puedo decir al corazón de quién tiene que enamorarse."
    mc "Denn ich kann dem Herzen nicht sagen, in wen es sich verlieben soll."

# game/scripts/c22/c22.rpy:2279
translate german c22s004_EveNoRoute_66f88345:

    # mc "Lo último que quiero es hacerte daño. Eres una mujer maravillosa, pero no siento nada romántico por ti."
    mc "Ich möchte dich auf keinen Fall verletzen. Du bist eine wundervolle Frau, aber ich empfinde nichts Romantisches für dich."

# game/scripts/c22/c22.rpy:2280
translate german c22s004_EveNoRoute_9a87d34e:

    # mc "Lo siento."
    mc "Es tut mir Leid."

# game/scripts/c22/c22.rpy:2282
translate german c22s004_EveNoRoute_d0a757c2:

    # eva "Me siento como una idiota ahora mismo."
    eva "Ich fühle mich gerade wie ein Idiot."

# game/scripts/c22/c22.rpy:2283
translate german c22s004_EveNoRoute_a2081f6a:

    # mc "No tienes que sentirte así. Nadie elige de quién se enamora."
    mc "Du musst dich nicht so fühlen. Niemand sucht sich aus, in wen er sich verliebt."

# game/scripts/c22/c22.rpy:2284
translate german c22s004_EveNoRoute_187e8fe2:

    # eva "No me refiero a eso..."
    eva "Darauf beziehe ich mich nicht..."

# game/scripts/c22/c22.rpy:2285
translate german c22s004_EveNoRoute_39834124:

    # mc "¿Entonces a qué te refieres?"
    mc "Was genau meinen Sie?"

# game/scripts/c22/c22.rpy:2287
translate german c22s004_EveNoRoute_0b7bf467:

    # eva "A que te estoy pidiendo explicaciones sobre algo que no tengo ningún derecho a hacer."
    eva "Warum frage ich Sie nach Erklärungen für etwas, wozu ich kein Recht habe?"

# game/scripts/c22/c22.rpy:2288
translate german c22s004_EveNoRoute_e7791b8c:

    # mc "Eso casi suena como [ama]. Pero siempre me podrás pedir explicaciones sobre lo que quieras."
    mc "Das klingt fast wie [ama]. Aber du kannst mich jederzeit nach Erklärungen zu allem fragen, was du wissen möchtest."

# game/scripts/c22/c22.rpy:2291
translate german c22s004_EveNoRoute_5d9b0e4a:

    # eva "Incluso te he propuesto cambiar físicamente. Es algo que no debería hacer."
    eva "Ich habe dir sogar vorgeschlagen, dein Aussehen zu verändern. Das solltest du nicht tun."

# game/scripts/c22/c22.rpy:2292
translate german c22s004_EveNoRoute_894ebe24:

    # eva "Yo soy yo y no tengo que parecerme a nadie."
    eva "Ich bin ich und ich muss nicht wie irgendjemand anderes aussehen."

# game/scripts/c22/c22.rpy:2293
translate german c22s004_EveNoRoute_9843b2bc:

    # mc "Voy a repetirlo, [eva]. Eres perfecta como eres, pero yo no soy perfecto para ti."
    mc "Ich wiederhole es noch einmal: Du bist perfekt, so wie du bist, aber ich bin nicht perfekt für dich."

# game/scripts/c22/c22.rpy:2295
translate german c22s004_EveNoRoute_6fa08cef:

    # eva "Y además, me he comportado muy mal con [ama] desde ayer."
    eva "Und außerdem habe ich mich seit gestern gegenüber [ama] sehr schlecht benommen."

# game/scripts/c22/c22.rpy:2296
translate german c22s004_EveNoRoute_f9ef55d9:

    # eva "Ella también conocía a Gavin, aunque no había tenido tanto trato con él como yo. También lo debe estar pasando mal."
    eva "Sie kannte Gavin auch, obwohl sie nicht so viel Kontakt zu ihm hatte wie ich. Auch sie muss es schwer haben."

# game/scripts/c22/c22.rpy:2297
translate german c22s004_EveNoRoute_65c96ef7:

    # mc "Deberías hablar con ella y disculparte, si crees que lo has hecho mal."
    mc "Du solltest mit ihr reden und dich entschuldigen, wenn du glaubst, etwas falsch gemacht zu haben."

# game/scripts/c22/c22.rpy:2299
translate german c22s004_EveNoRoute_5e059f15:

    # eva "¿Puedes esperar aquí mientras hablo con ella?"
    eva "Können Sie hier warten, während ich mit ihr spreche?"

# game/scripts/c22/c22.rpy:2300
translate german c22s004_EveNoRoute_e6b42cb7:

    # eva "Me gustaría hablar en privado, si no te molesta."
    eva "Ich würde gerne unter vier Augen sprechen, wenn es Ihnen nichts ausmacht."

# game/scripts/c22/c22.rpy:2301
translate german c22s004_EveNoRoute_97dbc3a2:

    # mc "Ningún problema. Es vuestra conversación y tus disculpas."
    mc "Kein Problem. Es ist dein Gespräch und deine Entschuldigung."

# game/scripts/c22/c22.rpy:2302
translate german c22s004_EveNoRoute_e8cb8c5f:

    # eva "Te veo en cinco minutos."
    eva "Wir sehen uns in fünf Minuten."

# game/scripts/c22/c22.rpy:2304
translate german c22s004_EveNoRoute_4c8540f5:

    # "Nunca te fíes de una mujer hermosa cuando diga cinco minutos."
    "Traue niemals einer schönen Frau, wenn sie sagt, es seien fünf Minuten."

# game/scripts/c22/c22.rpy:2306
translate german c22s004_EveNoRoute_c0f374b2:

    # "Tras quince minutos de mirar el móvil, aparece [eva] de nuevo."
    "Nach fünfzehn Minuten, in denen ich auf das Mobiltelefon geschaut habe, erscheint [eva] wieder."

# game/scripts/c22/c22.rpy:2307
translate german c22s004_EveNoRoute_df2abffe:

    # eva "Ya está. Ya me he disculpado."
    eva "Das war's. Ich habe mich bereits entschuldigt."

# game/scripts/c22/c22.rpy:2308
translate german c22s004_EveNoRoute_1e0bcec0:

    # mc "¿Estás mejor?"
    mc "Geht es dir besser?"

# game/scripts/c22/c22.rpy:2310
translate german c22s004_EveNoRoute_e55d0ee7:

    # eva "Mucho mejor. Sienta bien quitarse ese peso de encima."
    eva "Viel besser. Es tut gut, diese Last von den Schultern genommen zu haben."

# game/scripts/c22/c22.rpy:2313
translate german c22s004_EveNoRoute_a7267a48:

    # eva "Por cierto, felicidades. No vas a encontrar a nadie mejor que mi hermana."
    eva "Übrigens, herzlichen Glückwunsch. Du wirst niemanden Besseren als meine Schwester finden."

# game/scripts/c22/c22.rpy:2315
translate german c22s004_EveNoRoute_572bbbe6:

    # eva "Bueno, sí, pero no quieres salir conmigo. *Risa*"
    eva "Ja, schon, aber du willst ja nicht mit mir ausgehen. *lacht*"

# game/scripts/c22/c22.rpy:2316
translate german c22s004_EveNoRoute_1922a406:

    # mc "No sabía que te lo iba a decir ahora."
    mc "Ich wusste nicht, dass ich es dir jetzt sagen würde."

# game/scripts/c22/c22.rpy:2318
translate german c22s004_EveNoRoute_7c4f0b77:

    # eva "Cuando llegó ayer yo estaba molida. Quería contármelo cuando me despertara, antes de ir a cenar a casa."
    eva "Als er gestern ankam, war ich völlig erschöpft. Er wollte es mir gleich nach dem Aufwachen sagen, bevor er zum Abendessen nach Hause ging."

# game/scripts/c22/c22.rpy:2319
translate german c22s004_EveNoRoute_fdd9098f:

    # eva "Pero me despertó la llamada de Aaron para decirnos lo de Gavin."
    eva "Doch ich wurde durch Aarons Anruf geweckt, in dem er uns von Gavin erzählte."

# game/scripts/c22/c22.rpy:2320
translate german c22s004_EveNoRoute_269fe6c5:

    # eva "Supongo que me puse demasiado borde y no quería contármelo entonces."
    eva "Ich war wohl zu unhöflich, und er wollte es mir deshalb nicht sagen."

# game/scripts/c22/c22.rpy:2321
translate german c22s004_EveNoRoute_d21196a6:

    # mc "Sabes que a mí no me gustan los secretos."
    mc "Du weißt, dass ich Geheimnisse nicht mag."

# game/scripts/c22/c22.rpy:2323
translate german c22s004_EveNoRoute_01e892ae:

    # eva "Lo sé. Y en este caso era justificado. No sé cómo hubiera recibido la noticia antes de que llegaras."
    eva "Ich weiß. Und in diesem Fall war es gerechtfertigt. Ich weiß nicht, wie ich die Nachricht vor deiner Ankunft aufgenommen hätte."

# game/scripts/c22/c22.rpy:2324
translate german c22s004_EveNoRoute_c949557a:

    # eva "Tus abrazos tienen algo de curativo. ¿Te lo han dicho alguna vez?"
    eva "Deine Umarmungen haben eine heilende Wirkung. Hat dir das schon mal jemand gesagt?"

# game/scripts/c22/c22.rpy:2325
translate german c22s004_EveNoRoute_c0c7f532:

    # mc "*Risa* Sí, alguna vez me lo han dicho."
    mc "*Lacht* Ja, das wurde mir schon öfter gesagt."

# game/scripts/c22/c22.rpy:2327
translate german c22s004_EveNoRoute_f28a609b:

    # eva "Ahora vas a tener que irte. Quiero ducharme. Apesto."
    eva "Jetzt musst du gehen. Ich will duschen. Ich stinke."

# game/scripts/c22/c22.rpy:2328
translate german c22s004_EveNoRoute_9ecb9510:

    # eva "[ama] quería hablar contigo sobre algo del viaje a Aruba."
    eva "[ama] Ich wollte mit dir über etwas von der Reise nach Aruba sprechen."

# game/scripts/c22/c22.rpy:2329
translate german c22s004_EveNoRoute_344bf5f0:

    # mc "¿Te veo luego?"
    mc "Bis später?"

# game/scripts/c22/c22.rpy:2330
translate german c22s004_EveNoRoute_362ece90:

    # eva "¡Por supuesto!"
    eva "Natürlich!"

# game/scripts/c22/c22.rpy:2333
translate german c22s004_EveNoRoute_5fa41bfe:

    # "Nada más entrar en la sala de control, suena tu teléfono"
    "Sobald Sie den Kontrollraum betreten, klingelt Ihr Telefon."

# game/scripts/c22/c22.rpy:2341
translate german c22s003_IronFistCalls_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c22/c22.rpy:2343
translate german c22s003_IronFistCalls_9ba0a8c0:

    # mcp "(Número desconocido...)"
    mcp "(Unbekannte Zahl...)"

# game/scripts/c22/c22.rpy:2346
translate german c22s003_IronFistCalls_6c5f241b:

    # mc "Hola, [mc] Marks al habla."
    mc "Hallo, hier spricht Marks."

# game/scripts/c22/c22.rpy:2347
translate german c22s003_IronFistCalls_5d7bf905:

    # mcp "(Acabo de sonar super ridículo.)"
    mcp "(Ich klang gerade total lächerlich.)"

# game/scripts/c22/c22.rpy:2348
translate german c22s003_IronFistCalls_391a3adf:

    # man "Buenos días, Sr. Marks. Le llamo de Iron Fist, soy Jeff Sound, el asistente del Sr. Ichigo, Vicepresidente de Operaciones."
    man "Guten Morgen, Herr Marks. Ich rufe von Iron Fist an, hier spricht Jeff Sound, der Assistent von Herrn Ichigo, Vizepräsident für operative Angelegenheiten."

# game/scripts/c22/c22.rpy:2349
translate german c22s003_IronFistCalls_a40dc997:

    # mc "Un momento, Sr. Sound. Le pongo en manos libres, tengo una persona de mi equipo aquí que va a estar interesada en esta conversación."
    mc "Einen Moment bitte, Herr Tontechniker. Ich schalte auf Lautsprecher; jemand aus meinem Team ist hier, der an diesem Gespräch interessiert sein wird."

# game/scripts/c22/c22.rpy:2351
translate german c22s003_IronFistCalls_dd32dc13:

    # jef "Ningún problema, Sr. Marks."
    jef "Kein Problem, Herr Marks."

# game/scripts/c22/c22.rpy:2353
translate german c22s003_IronFistCalls_ea0ae3a0:

    # ama "Buenos días, Sr. Sound. Soy [ama] Gilford. Le escucho bien."
    ama "Guten Morgen, Herr Sound. Hier spricht Gilford. Ich kann Sie gut hören."

# game/scripts/c22/c22.rpy:2354
translate german c22s003_IronFistCalls_6b91c75d:

    # jef "Encantado de hablar con usted, Srta. Gilford. ¿O es Sra.?"
    jef "Es ist mir ein Vergnügen, mit Ihnen zu sprechen, Miss Gilford. Oder ist es Mrs.?"

# game/scripts/c22/c22.rpy:2356
translate german c22s003_IronFistCalls_1b076072:

    # ama "Srta. está bien."
    ama "Fräulein, alles in Ordnung?"

# game/scripts/c22/c22.rpy:2357
translate german c22s003_IronFistCalls_015cdb0f:

    # mc "Dígame, Sr. Sound."
    mc "Sagen Sie mir, Herr Sound."

# game/scripts/c22/c22.rpy:2358
translate german c22s003_IronFistCalls_6804df4e:

    # jef "Les llamo porque han llegado a nosotros informaciones sobre el cambio de propiedad de NTR y..."
    jef "Ich rufe an, weil wir Informationen über einen Eigentümerwechsel bei NTR erhalten haben und..."

# game/scripts/c22/c22.rpy:2359
translate german c22s003_IronFistCalls_5d519b79:

    # mc "¿Me puede decir de dónde han sacado esa información? ¿Y este número de teléfono?"
    mc "Können Sie mir sagen, woher Sie diese Informationen haben? Und diese Telefonnummer?"

# game/scripts/c22/c22.rpy:2360
translate german c22s003_IronFistCalls_306afe27:

    # jef "Esa es una información reservada, Sr. Marks. No podemos revelar nuestras fuentes."
    jef "Das sind vertrauliche Informationen, Herr Marks. Wir können unsere Quellen nicht preisgeben."

# game/scripts/c22/c22.rpy:2362
translate german c22s003_IronFistCalls_886708b9:

    # ama "Estaba hablando usted del cambio de propiedad de NTR. Siga, por favor."
    ama "Sie sprachen über den Eigentümerwechsel bei NTR. Bitte fahren Sie fort."

# game/scripts/c22/c22.rpy:2363
translate german c22s003_IronFistCalls_2caf15f7:

    # jef "Sí. Nos hemos enterado del cambio de propiedad y de que ésta ha recaído en un grupo representado por el Sr. Marks."
    jef "Ja. Wir haben von dem Eigentümerwechsel erfahren und dass das Unternehmen nun in den Besitz einer von Herrn Marks vertretenen Gruppe übergegangen ist."

# game/scripts/c22/c22.rpy:2364
translate german c22s003_IronFistCalls_3fa127ba:

    # ama "Exacto."
    ama "Genau."

# game/scripts/c22/c22.rpy:2365
translate german c22s003_IronFistCalls_6c01e46a:

    # jef "También nos han llegado noticias de que el Sr. Marks va a ocupar el puesto de CEO en breve."
    jef "Wir haben außerdem die Nachricht erhalten, dass Herr Marks in Kürze die Position des CEO übernehmen wird."

# game/scripts/c22/c22.rpy:2366
translate german c22s003_IronFistCalls_528a8536:

    # ama "Sí. Esas informaciones son exactas."
    ama "Ja. Diese Information ist korrekt."

# game/scripts/c22/c22.rpy:2367
translate german c22s003_IronFistCalls_db3ac24a:

    # jef "¿Me podrían decir quién es ese grupo de accionistas, por favor?"
    jef "Könnten Sie mir bitte sagen, um welche Gruppe von Aktionären es sich handelt?"

# game/scripts/c22/c22.rpy:2369
translate german c22s003_IronFistCalls_2e120bea:

    # mc "Son..."
    mc "Sind..."

# game/scripts/c22/c22.rpy:2370
translate german c22s003_IronFistCalls_19797f13:

    # ama "No creo que sea de su interés, Sr. Sound. Están representados por el Sr. Marks y él es capaz de hablar por ellos."
    ama "Ich glaube nicht, dass es in Ihrem Interesse ist, Herr Sound. Sie werden von Herrn Marks vertreten, und er kann für Sie sprechen."

# game/scripts/c22/c22.rpy:2371
translate german c22s003_IronFistCalls_a6c58ba9:

    # ama "¿Quería algo más?"
    ama "Wollten Sie etwas anderes?"

# game/scripts/c22/c22.rpy:2372
translate german c22s003_IronFistCalls_ae258745:

    # jef "También llamaba porque al Sr. Ichigo le gustaría reunirse con el Sr. Marks."
    jef "Er rief auch deshalb an, weil Herr Ichigo Herrn Marks treffen möchte."

# game/scripts/c22/c22.rpy:2373
translate german c22s003_IronFistCalls_f68c9824:

    # mc "¿Por alguna razón en concreto?"
    mc "Gibt es dafür einen bestimmten Grund?"

# game/scripts/c22/c22.rpy:2374
translate german c22s003_IronFistCalls_b8e36178:

    # jef "Una primera toma de contacto entre dos de las principales empresas del sector. El Sr. Ichigo se había reunido varias veces con el Sr. Daniels."
    jef "Dies war ein erstes Treffen zwischen zwei der führenden Unternehmen der Branche. Herr Ichigo hatte sich bereits mehrmals mit Herrn Daniels getroffen."

# game/scripts/c22/c22.rpy:2376
translate german c22s003_IronFistCalls_6f9ec9b5:

    # ama "*Pone el móvil en mute* Xabier Daniels era el jefe de GILF que empezó la Guerra Clon."
    ama "*Schaltet das Telefon stumm* Xabier Daniels war der Anführer von GILF, der den Klonkrieg auslöste."

# game/scripts/c22/c22.rpy:2377
translate german c22s003_IronFistCalls_c95b64af:

    # "Asientes."
    "Du nickst."

# game/scripts/c22/c22.rpy:2378
translate german c22s003_IronFistCalls_372a491b:

    # mc "Desafortunadamente, el Sr. Daniels ya no trabaja con nosotros, pero si se trata de una visita de cortesía, no tengo ningún problema en conocer al Sr. Ichigo."
    mc "Leider arbeitet Herr Daniels nicht mehr für uns, aber falls es sich um einen Höflichkeitsbesuch handelt, habe ich kein Problem damit, Herrn Ichigo zu treffen."

# game/scripts/c22/c22.rpy:2379
translate german c22s003_IronFistCalls_72b19fea:

    # jef "Muchas gracias, Sr. Marks. El Sr. Ichigo estará en Vandenberg mañana por la tarde, y dará una recepción para algunos clientes en su yate por la noche."
    jef "Vielen Dank, Herr Marks. Herr Ichigo wird morgen Nachmittag in Vandenberg sein und am Abend auf seiner Yacht einen Empfang für einige Kunden geben."

# game/scripts/c22/c22.rpy:2380
translate german c22s003_IronFistCalls_5d55801b:

    # jef "Le gustaría que acudiera."
    jef "Er würde sich freuen, wenn sie käme."

# game/scripts/c22/c22.rpy:2382
translate german c22s003_IronFistCalls_7f58a0aa:

    # ama "Imposible. El Sr. Marks tiene la agenda ocupada hasta el viernes. Debería ser a partir del sábado."
    ama "Unmöglich. Herr Marks ist bis Freitag voll ausgebucht. Es ginge nur ab Samstag."

# game/scripts/c22/c22.rpy:2383
translate german c22s003_IronFistCalls_f359de1c:

    # jef "Déjeme mirar un tema. Un momento..."
    jef "Ich sehe mir etwas an. Einen Moment bitte..."

# game/scripts/c22/c22.rpy:2384
translate german c22s003_IronFistCalls_e8924f49:

    # jef "El sábado es un buen día. Hay un evento más pequeño en el yate frente al puerto de Westport. Tendrán más oportunidades de conocerse."
    jef "Samstag ist ein guter Tag. Es findet eine kleinere Veranstaltung auf der Yacht vor dem Hafen von Westport statt. Dort haben sie mehr Gelegenheit, sich kennenzulernen."

# game/scripts/c22/c22.rpy:2386
translate german c22s003_IronFistCalls_68fcb964:

    # ama "El sábado entonces. ¿Transporte?"
    ama "Dann also Samstag. Transport?"

# game/scripts/c22/c22.rpy:2387
translate german c22s003_IronFistCalls_1337076f:

    # jef "Podemos enviar un helicóptero a recoger al Sr. Marks."
    jef "Wir können einen Hubschrauber schicken, um Herrn Marks abzuholen."

# game/scripts/c22/c22.rpy:2388
translate german c22s003_IronFistCalls_f3ffb496:

    # ama "Y a mí. Iremos juntos."
    ama "Und ich. Wir gehen zusammen."

# game/scripts/c22/c22.rpy:2389
translate german c22s003_IronFistCalls_2135db09:

    # jef "Perfecto. Nos tendrán que indicar dónde quieren que les recojamos."
    jef "Perfekt. Sie müssen uns nur noch mitteilen, wo wir Sie abholen sollen."

# game/scripts/c22/c22.rpy:2391
translate german c22s003_IronFistCalls_647b9adc:

    # "[ama] continúa atando detalles de la reunión, dando indicaciones y detalles, pero sin revelar ninguna información."
    "[ama] verknüpft weiterhin Details des Treffens, gibt Anweisungen und Einzelheiten, ohne jedoch Informationen preiszugeben."

# game/scripts/c22/c22.rpy:2392
translate german c22s003_IronFistCalls_ed693545:

    # "Consigue algunos nombres de las personas que asistirán al evento menor, y el Sr. Sound se compromete a enviarle la lista completa de invitados."
    "Besorgen Sie sich einige Namen der Personen, die an der kleineren Veranstaltung teilnehmen werden, und Herr Sound verspricht, Ihnen die vollständige Gästeliste zuzusenden."

# game/scripts/c22/c22.rpy:2393
translate german c22s003_IronFistCalls_a48b253f:

    # "Aunque vaya vestida de mecánico, es mucho mejor en esto de lo que tú serías con un traje."
    "Auch wenn sie als Mechanikerin verkleidet ist, ist sie darin viel besser als du es in einem Anzug wärst."

# game/scripts/c22/c22.rpy:2394
translate german c22s003_IronFistCalls_fcea9a6f:

    # "Unos minutos después os despedís del Sr. Sound."
    "Ein paar Minuten später verabschieden Sie sich von Herrn Sound."

# game/scripts/c22/c22.rpy:2396
translate german c22s003_IronFistCalls_d96573d6:

    # ama "Ya está. El sábado nos reunimos con Ichigo."
    ama "Das war's. Wir treffen uns am Samstag mit Ichigo."

# game/scripts/c22/c22.rpy:2397
translate german c22s003_IronFistCalls_2d22882c:

    # mc "He estado a punto de meter la pata con lo de los accionistas, ¿verdad?"
    mc "Beinahe hätte ich mit der Aktionärssache ins Fettnäpfchen getreten, nicht wahr?"

# game/scripts/c22/c22.rpy:2399
translate german c22s003_IronFistCalls_180508eb:

    # ama "Sí, un poco. Nunca des información si no es necesario. Si no tienen los nombres de los accionistas tienen que pasar por ti para todo."
    ama "Ja, ein bisschen. Geben Sie Informationen nur dann weiter, wenn es unbedingt notwendig ist. Wenn sie die Namen der Aktionäre nicht haben, müssen sie alles über Sie abwickeln."

# game/scripts/c22/c22.rpy:2400
translate german c22s003_IronFistCalls_3c34a0cb:

    # ama "Es nuestra forma de controlar el flujo de información. Cuánto más anónimas sean las chicas, mejor. No podrán contactarlas directamente."
    ama "So kontrollieren wir den Informationsfluss. Je anonymer die Mädchen sind, desto besser. Sie können nicht direkt kontaktiert werden."

# game/scripts/c22/c22.rpy:2401
translate german c22s003_IronFistCalls_2d2ddaaa:

    # mc "Me viene muy grande todo esto."
    mc "Das ist alles viel zu viel für mich."

# game/scripts/c22/c22.rpy:2403
translate german c22s003_IronFistCalls_6f275ac6:

    # ama "No te preocupes, aprenderás. Esto es nuevo para ti, pero al menos te das cuenta de cuándo estás a punto de cometer un error."
    ama "Keine Sorge, du wirst es lernen. Das ist zwar neu für dich, aber zumindest wirst du merken, wenn du im Begriff bist, einen Fehler zu machen."

# game/scripts/c22/c22.rpy:2404
translate german c22s003_IronFistCalls_070a9693:

    # ama "Lo que tienes que aprender es a darte cuenta antes de cometerlo."
    ama "Man muss lernen, das zu erkennen, bevor man den Fehler macht."

# game/scripts/c22/c22.rpy:2405
translate german c22s003_IronFistCalls_d3ffc09e:

    # mc "Si no hubieras estado aquí... hubiera aceptado la reunión de mañana. ¿Por qué la has rechazado?"
    mc "Wenn du nicht hier gewesen wärst... hätte ich das morgige Treffen angenommen. Warum hast du abgesagt?"

# game/scripts/c22/c22.rpy:2407
translate german c22s003_IronFistCalls_f0a1b841:

    # ama "*Risa* Porque la han propuesto ellos. Si nos negamos a su primera propuesta, se pueden poner ansiosos."
    ama "*Gelächter* Weil sie es vorgeschlagen haben. Wenn wir ihren ersten Vorschlag ablehnen, könnten sie nervös werden."

# game/scripts/c22/c22.rpy:2408
translate german c22s003_IronFistCalls_bcad0b66:

    # ama "Si aceptamos una propuesta así con tan poca antelación, parece que estemos besándoles el culo."
    ama "Wenn wir einen solchen Vorschlag so kurzfristig annehmen, kommt es uns so vor, als würden wir ihnen in den Hintern kriechen."

# game/scripts/c22/c22.rpy:2410
translate german c22s003_IronFistCalls_1f6dad46:

    # ama "De esta forma demostramos que son ellos los que tienen interés y no nosotros."
    ama "Auf diese Weise zeigen wir, dass sie diejenigen sind, die ein Interesse haben, nicht wir."

# game/scripts/c22/c22.rpy:2411
translate german c22s003_IronFistCalls_111d4888:

    # ama "Si no hubieran tenido el evento del sábado, posiblemente se hubieran tenido que inventar algo para forzar esa reunión informal."
    ama "Wenn die Veranstaltung am Samstag nicht stattgefunden hätte, hätten sie sich vielleicht etwas einfallen lassen müssen, um dieses informelle Treffen zu erzwingen."

# game/scripts/c22/c22.rpy:2412
translate german c22s003_IronFistCalls_2d9d8c2c:

    # mc "Que de informal tendrá poco, ¿no?"
    mc "Es kann nicht sehr informell sein, oder?"

# game/scripts/c22/c22.rpy:2414
translate german c22s003_IronFistCalls_51ab4840:

    # ama "Poquísimo. Vandenberg es una base de la Fuerza Aérea, más dedicada al espacio que a algo con lo que Iron Fist tenga algo que ver."
    ama "Sehr wenig. Vandenberg ist ein Luftwaffenstützpunkt, der sich stärker mit Raumfahrt beschäftigt als mit allem, was Iron Fist zu tun hat."

# game/scripts/c22/c22.rpy:2415
translate german c22s003_IronFistCalls_6e0ea7a5:

    # ama "Te querían demostrar que son fuertes y que tienen contactos en todos lados. No te conocen y te quieren impresionar."
    ama "Sie wollten Ihnen zeigen, wie mächtig sie sind und dass sie überall Verbindungen haben. Sie kennen Sie nicht und wollen Sie beeindrucken."

# game/scripts/c22/c22.rpy:2416
translate german c22s003_IronFistCalls_dbeb0dd0:

    # ama "Seguro que al evento en Westport va algún coronel de Fort Hunter Liggett. Está a menos de dos horas."
    ama "Ich bin mir sicher, dass ein Oberst von Fort Hunter Liggett bei der Veranstaltung in Westport anwesend sein wird. Es ist weniger als zwei Stunden entfernt."

# game/scripts/c22/c22.rpy:2417
translate german c22s003_IronFistCalls_e950b2e2:

    # mc "Hay demasiados matices en todo esto y yo no tengo ni idea... Creo que tú, [eva], o [aar] seríais mejores CEO que yo."
    mc "Das Ganze ist mit zu vielen Nuancen verbunden, und ich habe keine Ahnung... Ich glaube, Sie, [eva], oder [aar] wären bessere CEOs als ich."

# game/scripts/c22/c22.rpy:2419
translate german c22s003_IronFistCalls_7b341c6d:

    # ama "Nosotros somos operativos de campo. No tenemos ni idea de cómo gestionar una empresa, pero conocemos el negocio."
    ama "Wir sind Außendienstmitarbeiter. Wir haben keine Ahnung von Unternehmensführung, aber wir kennen das Geschäft."

# game/scripts/c22/c22.rpy:2420
translate german c22s003_IronFistCalls_d110c58d:

    # ama "Nuestro problema es de visión, al menos el mío. Tengo una visión limitada del conjunto."
    ama "Unser Problem ist ein Sehproblem, zumindest meines. Ich habe nur einen begrenzten Blick auf das Gesamtbild."

# game/scripts/c22/c22.rpy:2421
translate german c22s003_IronFistCalls_dd063c89:

    # ama "[aar] no es una figura cómoda en NTR para los que trabajaron bajo las órdenes de Xabier."
    ama "[aar] ist keine angenehme Zahl in NTR für diejenigen, die unter Xabiers Befehlen gearbeitet haben."

# game/scripts/c22/c22.rpy:2422
translate german c22s003_IronFistCalls_5bc7e3dd:

    # ama "Y [eva] tiene el problema del martillo."
    ama "Und [eva] hat das Hammerproblem."

# game/scripts/c22/c22.rpy:2423
translate german c22s003_IronFistCalls_55a23645:

    # mc "¿Martillo?"
    mc "Hammer?"

# game/scripts/c22/c22.rpy:2425
translate german c22s003_IronFistCalls_1b21ec91:

    # ama "Para [eva], sus armas son sus herramientas. Su martillo. Y cualquier problema es un clavo."
    ama "Für [eva] sind seine Waffen seine Werkzeuge. Sein Hammer. Und jedes Problem ist ein Nagel."

# game/scripts/c22/c22.rpy:2426
translate german c22s003_IronFistCalls_aebbd428:

    # ama "Intentaría resolver cualquier problema con la fuerza, y no es la dirección que queremos darle a la empresa, ¿no?"
    ama "Er würde versuchen, jedes Problem mit Gewalt zu lösen, und das ist nicht die Richtung, die wir mit dem Unternehmen einschlagen wollen, oder?"

# game/scripts/c22/c22.rpy:2427
translate german c22s003_IronFistCalls_ab6417a5:

    # mc "No, en eso tienes razón. *Risa* No queremos que hundan el yate de Ichigo."
    mc "Nein, da hast du recht. *lacht* Wir wollen ja nicht, dass Ichigos Yacht sinkt."

# game/scripts/c22/c22.rpy:2429
translate german c22s003_IronFistCalls_a3396ac1:

    # ama "Bueno, tengo que arreglar unos temas para la reunión del sábado y buscar información sobre los asistentes. Te voy a tener que dejar."
    ama "Okay, ich muss noch ein paar Dinge für das Treffen am Samstag vorbereiten und Informationen über die Teilnehmer besorgen. Ich muss jetzt los."

# game/scripts/c22/c22.rpy:2430
translate german c22s003_IronFistCalls_a12fc195:

    # mc "¿Has pensado en pedirle ayuda a [jam]? Creo que os podría ser útil para buscar cosas."
    mc "Hast du schon mal darüber nachgedacht, [jam] um Hilfe zu bitten? Ich denke, das könnte dir bei der Suche nach Dingen helfen."

# game/scripts/c22/c22.rpy:2431
translate german c22s003_IronFistCalls_27c95d9c:

    # ama "No es mala idea. Le llamaré esta tarde, cuando volvamos de comer en casa de [nor]."
    ama "Das ist keine schlechte Idee. Ich rufe ihn heute Nachmittag an, wenn wir vom Mittagessen bei [nor] zurück sind."

# game/scripts/c22/c22.rpy:2433
translate german c22s003_IronFistCalls_e0575fec:

    # ama "Y, por cierto, gracias por lo de [eva]."
    ama "Und übrigens, vielen Dank für das [eva]."

# game/scripts/c22/c22.rpy:2434
translate german c22s003_IronFistCalls_46cea44c:

    # mc "¿Gracias por qué? Es tu hermana, pero es mi prima."
    mc "Wofür soll ich mich bedanken? Sie ist zwar deine Schwester, aber gleichzeitig meine Cousine."

# game/scripts/c22/c22.rpy:2435
translate german c22s003_IronFistCalls_131c04dc:

    # ama "Tienes razón, pero no por ello estoy menos agradecida por lo que has hecho."
    ama "Du hast Recht, aber das macht mich nicht weniger dankbar für das, was du getan hast."

# game/scripts/c22/c22.rpy:2437
translate german c22s003_IronFistCalls_6ed672c4:

    # mc "Y también mi novia, por lo que parece."
    mc "Und meine Freundin anscheinend auch."

# game/scripts/c22/c22.rpy:2439
translate german c22s003_IronFistCalls_31693633:

    # ama "*Risa* ¿Por qué odias tanto esa palabra?"
    ama "*lacht* Warum hasst du dieses Wort so sehr?"

# game/scripts/c22/c22.rpy:2440
translate german c22s003_IronFistCalls_f8cb2d92:

    # mc "Porque cuando se dice tantas veces pierde el significado. Además nunca me han gustado las etiquetas."
    mc "Denn wenn es so oft gesagt wird, verliert es seine Bedeutung. Außerdem habe ich Etiketten noch nie gemocht."

# game/scripts/c22/c22.rpy:2442
translate german c22s003_IronFistCalls_c1490d2d:

    # mc "*Risa* Suena muy raro decir que las dos sois mis novias. Creo que no es el uso que tenían pensado cuando inventaron la puta palabra."
    mc "*Lacht* Es klingt echt komisch zu sagen, dass ihr beide meine Freundinnen seid. Ich glaube nicht, dass die sich das so vorgestellt haben, als sie dieses verdammte Wort erfunden haben."

# game/scripts/c22/c22.rpy:2444
translate german c22s003_IronFistCalls_f45f20b0:

    # ama "Tienes razón. Te veo luego... novio. *Risa*"
    ama "Du hast recht. Bis später... mein Freund. *lacht*"

# game/scripts/c22/c22.rpy:2446
translate german c22s003_IronFistCalls_1cb86906:

    # ama "No te entretengo más."
    ama "Ich werde Sie nicht länger aufhalten."

# game/scripts/c22/c22.rpy:2450
translate german c22s003_IronFistCalls_689458b3:

    # ama "Te veo luego."
    ama "Bis später."

# game/scripts/c22/c22.rpy:2452
translate german c22s003_IronFistCalls_614f43b7:

    # mc "Hasta dentro de un rato."
    mc "Wir sehen uns in Kürze."

# game/scripts/c22/c22.rpy:2459
translate german c22s004_EriPregnancyResult_eb0ace6b:

    # "Conduces a casa esperando que [ama] tenga razón en que vas a aprender rápido el nuevo oficio."
    "Du fährst nach Hause und hoffst, dass [ama] Recht hat und du den neuen Job schnell lernen wirst."

# game/scripts/c22/c22.rpy:2460
translate german c22s004_EriPregnancyResult_38ff4c55:

    # "Estás seguro de que no eres un buen negociador. Ni siquiera sabes que salario vas a tener y ya has aceptado el puesto."
    "Du bist dir sicher, dass du kein guter Verhandler bist. Du weißt noch nicht einmal, wie hoch dein Gehalt sein wird, und du hast die Stelle bereits angenommen."

# game/scripts/c22/c22.rpy:2463
translate german c22s004_EriPregnancyResult_d97e40d3:

    # "Al volver a casa, encuentras a [eri] charlando con [kat] en la planta de las estudiantes."
    "Bei deiner Rückkehr nach Hause findest du [eri] im Gespräch mit [kat] auf dem Studentenflur vor."

# game/scripts/c22/c22.rpy:2464
translate german c22s004_EriPregnancyResult_a9d94cc5:

    # eri "... Creo que deberías unirte. El yoga puede ser divertido."
    eri "Ich finde, du solltest mitmachen. Yoga kann Spaß machen."

# game/scripts/c22/c22.rpy:2465
translate german c22s004_EriPregnancyResult_97b63234:

    # kat "No me vas a convencer, [eri]. Hoy es mi día de descanso de hacer deporte."
    kat "Du wirst mich nicht überzeugen, [eri]. Heute habe ich sportfrei."

# game/scripts/c22/c22.rpy:2466
translate german c22s004_EriPregnancyResult_e2488fb9:

    # kat "Suficiente tengo con despertarme pronto porque [kim] pone la alarma para levantarse en un día que no tengo clase por la mañana."
    kat "Ich habe schon genug damit zu tun, früh aufzustehen, weil [kim] mir den Wecker stellt, obwohl ich morgens keine Vorlesung habe."

# game/scripts/c22/c22.rpy:2467
translate german c22s004_EriPregnancyResult_67e2393e:

    # mc "Hola, chicas, ¿qué tal?"
    mc "Hey Mädels, wie geht's euch?"

# game/scripts/c22/c22.rpy:2469
translate german c22s004_EriPregnancyResult_0d644090:

    # kat "[eri] sigue la tendencia del día de intentar que me una a las sesiones de yoga. *Risa*"
    kat "[eri] Sie versucht schon wieder, mich zum Yoga zu überreden. *lacht*"

# game/scripts/c22/c22.rpy:2470
translate german c22s004_EriPregnancyResult_e2acc59a:

    # mc "Ya les has dicho que no te vas a unir mientras lleven ropa, ¿no?"
    mc "Du hast ihnen doch schon gesagt, dass du nicht mitmachst, solange sie angezogen sind, oder?"

# game/scripts/c22/c22.rpy:2472
translate german c22s004_EriPregnancyResult_20ef6082:

    # kat "*Risa* Ni siquiera entonces. Me sentaría en una tumbona a mirarlas."
    kat "*Lacht* Nicht mal dann. Ich würde mich einfach auf eine Sonnenliege setzen und ihnen zusehen."

# game/scripts/c22/c22.rpy:2473
translate german c22s004_EriPregnancyResult_aaafa764:

    # mc "*Risa* Guárdame un sitio en esa tumbona."
    mc "*Lacht* Reservier mir einen Platz auf der Sonnenliege."

# game/scripts/c22/c22.rpy:2475
translate german c22s004_EriPregnancyResult_4b5d8867:

    # eri "*Risa* Y por eso no haremos nunca yoga desnudas. Queremos que os unáis, y no como público."
    eri "*Gelächter* Und genau deshalb werden wir niemals nackt Yoga machen. Wir möchten, dass ihr mitmacht, nicht nur zuschaut."

# game/scripts/c22/c22.rpy:2476
translate german c22s004_EriPregnancyResult_00ff4d75:

    # mc "*Risa* Ya sabes que la flexibilidad no es lo mío."
    mc "*lacht* Du weißt ja, Flexibilität ist nicht gerade meine Stärke."

# game/scripts/c22/c22.rpy:2478
translate german c22s004_EriPregnancyResult_5870f805:

    # kat "Bueno, yo voy a ir a estudiar un rato. Hoy quería acabar un informe sobre las belugas."
    kat "Nun, ich werde jetzt erst einmal lernen. Heute wollte ich einen Bericht über Belugas fertigstellen."

# game/scripts/c22/c22.rpy:2479
translate german c22s004_EriPregnancyResult_3be3a8ac:

    # mc "Las belugas son primas de las ballenas, ¿no?"
    mc "Belugas sind doch mit den Walen verwandt, oder?"

# game/scripts/c22/c22.rpy:2481
translate german c22s004_EriPregnancyResult_c983b5c7:

    # kat "No son primas de las ballenas. Son ballenas."
    kat "Sie sind nicht mit Walen verwandt. Sie sind Wale."

# game/scripts/c22/c22.rpy:2482
translate german c22s004_EriPregnancyResult_0bbf2f8b:

    # kat "Pero bien hecho, [mc]. Ya era hora que te atrevieras."
    kat "Gut gemacht, [mc]. Es wurde aber auch Zeit, dass du dich getraut hast."

# game/scripts/c22/c22.rpy:2483
translate german c22s004_EriPregnancyResult_7a2136d1:

    # mc "¿Qué he hecho?"
    mc "Was habe ich getan?"

# game/scripts/c22/c22.rpy:2485
translate german c22s004_EriPregnancyResult_2b1883cb:

    # kat "Insinuar que, al ser ballenas, tengo algún tipo de ventaja para escribir el informe. Es un buen chiste de gordos. Un poco cruel, pero es bueno."
    kat "Die Andeutung, dass ich als Wal einen Vorteil beim Verfassen des Berichts hätte, ist ein guter Witz über Dicke. Ein bisschen gemein, aber gut."

# game/scripts/c22/c22.rpy:2486
translate german c22s004_EriPregnancyResult_6dfd96c5:

    # mc "¿Qué? ¡No! ¡No quería decir eso!"
    mc "Was? Nein! So meinte ich das nicht!"

# game/scripts/c22/c22.rpy:2488
translate german c22s004_EriPregnancyResult_47ce2a6e:

    # eri "¡[mc]! ¿Cómo te atreves? No tienes que intentar acomplejar a nadie sobre su cuerpo."
    eri "Wie kannst du es wagen! Du hast es nicht nötig, irgendjemanden wegen seines Körpers zu verunsichern."

# game/scripts/c22/c22.rpy:2489
translate german c22s004_EriPregnancyResult_f2370a05:

    # mc "¡De verdad! ¡No he insinuado nada de eso!"
    mc "Wirklich! Ich habe so etwas überhaupt nicht angedeutet!"

# game/scripts/c22/c22.rpy:2492
translate german c22s004_EriPregnancyResult_ca594ec9:

    # eri "*Risa* Tenías razón..."
    eri "*lacht* Du hattest Recht..."

# game/scripts/c22/c22.rpy:2493
translate german c22s004_EriPregnancyResult_ae4a07a5:

    # kat "*Risa* Nunca falla..."
    kat "*lacht* Es klappt immer wieder..."

# game/scripts/c22/c22.rpy:2494
translate german c22s004_EriPregnancyResult_f8f197a8:

    # mc "¿Qué está pasando aquí?"
    mc "Was ist hier los?"

# game/scripts/c22/c22.rpy:2496
translate german c22s004_EriPregnancyResult_a1697737:

    # eri "*Risa* [kat] me estaba diciendo que si consigue que alguien piense que se ha metido con su físico sin darse cuenta, por norma se ponen incómodos."
    eri "*Lacht* [kat] Er erzählte mir, dass, wenn es ihm gelingt, jemanden glauben zu lassen, er habe sich über dessen Aussehen lustig gemacht, ohne dass dieser es merkt, die Leute sich normalerweise unwohl fühlen."

# game/scripts/c22/c22.rpy:2497
translate german c22s004_EriPregnancyResult_4dbd5471:

    # kat "*Risa* Y diez minutos después llegas tú y me das la oportunidad de demostrarlo. Gracias por ser mi conejillo de indias."
    kat "*Lacht* Und zehn Minuten später kommst du und gibst mir die Gelegenheit, es zu beweisen. Danke, dass du mein Versuchskaninchen warst."

# game/scripts/c22/c22.rpy:2498
translate german c22s004_EriPregnancyResult_6b5bdb3b:

    # mc "Sois malas personas. *Risa* Y yo he caído en vuestra broma. ¡Me voy a mi habitación hasta la hora de comer! Castigado por tonto. *Risa*"
    mc "Ihr seid alle gemein. *lacht* Und ich bin auf euren Witz reingefallen. Ich gehe bis zum Mittagessen in mein Zimmer! Hausarrest, weil ich so dumm war. *lacht*"

# game/scripts/c22/c22.rpy:2503
translate german c22s004_EriPregnancyResult_d2cbeeda:

    # ambas "Hasta luego, [mc]."
    ambas "Bis später, [mc]."

# game/scripts/c22/c22.rpy:2519
translate german c22s004_EriPregnancy_91543177:

    # eri "Ahora subo a verte. Tengo un tema que tratar contigo."
    eri "Ich komme jetzt zu dir hoch. Ich muss etwas mit dir besprechen."

# game/scripts/c22/c22.rpy:2525
translate german c22s004_EriPregnancy_08b5df7f:

    # mc "Ok."
    mc "Okay."

# game/scripts/c22/c22.rpy:2527
translate german c22s004_EriPregnancy_41d397cb:

    # "Unos minutos después..."
    "Ein paar Minuten später..."

# game/scripts/c22/c22.rpy:2529
translate german c22s004_EriPregnancy_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c22/c22.rpy:2531
translate german c22s004_EriPregnancy_fbcb10e3:

    # eri "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    eri "*Durch die Tür* Ich bin's. Darf ich hereinkommen?"

# game/scripts/c22/c22.rpy:2532
translate german c22s004_EriPregnancy_3b55a4ab:

    # mc "Sí, entra."
    mc "Ja, kommen Sie herein."

# game/scripts/c22/c22.rpy:2534
translate german c22s004_EriPregnancy_70251361:

    # mc "Dime. Parecía urgente."
    mc "Sag es mir. Es schien dringend zu sein."

# game/scripts/c22/c22.rpy:2535
translate german c22s004_EriPregnancy_5c69d3c4:

    # eri "No, todo lo contrario que urgente."
    eri "Nein, ganz im Gegenteil von dringend."

# game/scripts/c22/c22.rpy:2536
translate german c22s004_EriPregnancy_9b6f6612:

    # eri "Hace un par de días que la prueba de embarazo tiene que haber dado los resultados..."
    eri "Der Schwangerschaftstest hätte vor ein paar Tagen das Ergebnis liefern sollen..."

