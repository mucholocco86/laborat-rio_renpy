    "*Klopf-Klopf*"

# game/scripts/c22/c22.rpy:2632
translate german c22s004_ScarlettDNA_8666b80b:

    # mc "Soy yo. ¿Puedo pasar?"
    mc "Ich bin's. Darf ich hereinkommen?"

# game/scripts/c22/c22.rpy:2633
translate german c22s004_ScarlettDNA_9e27ff03:

    # dap "*A través de la puerta* Sí, pasa. Nos estábamos acabando de cambiar."
    dap "*Durch die Tür* Ja, kommt herein. Wir haben uns gerade umgezogen."

# game/scripts/c22/c22.rpy:2635
translate german c22s004_ScarlettDNA_e7f6142c:

    # mc "¡Ha llegado la prueba de ADN!"
    mc "Der DNA-Test ist da!"

# game/scripts/c22/c22.rpy:2636
translate german c22s004_ScarlettDNA_ab17e58d:

    # sca "¡Ábrela! ¡Siento como si fuese el regalo de Navidad!"
    sca "Öffne es! Es fühlt sich an wie ein Weihnachtsgeschenk!"

# game/scripts/c22/c22.rpy:2637
translate german c22s004_ScarlettDNA_2a4898f7:

    # dap "Esperad. ¿Queréis que me vaya? Puedo esperaros en la piscina."
    dap "Warte. Soll ich gehen? Ich kann am Pool auf dich warten."

# game/scripts/c22/c22.rpy:2638
translate german c22s004_ScarlettDNA_1ba73269:

    # mc "Por mí no hace falta, ¿[sca]?"
    mc "Das ist nicht nötig, [sca]?"

# game/scripts/c22/c22.rpy:2640
translate german c22s004_ScarlettDNA_36506268:

    # sca "No, quiero que estés aquí. Eres la hermana que nunca tuve y ahora..."
    sca "Nein, ich will dich hier haben. Du bist die Schwester, die ich nie hatte, und jetzt..."

# game/scripts/c22/c22.rpy:2642
translate german c22s004_ScarlettDNA_0f93a04f:

    # mc "Ahora es posible que [emm] sea la hermana que siempre tuviste y nunca supiste."
    mc "Nun ist es möglich, dass [emm] die Schwester ist, die du schon immer hattest, von der du aber nie etwas wusstest."

# game/scripts/c22/c22.rpy:2644
translate german c22s004_ScarlettDNA_9f9bfb51:

    # mc "Ahora es posible que yo sea el hermano que siempre tuviste y nunca supiste."
    mc "Nun ist es möglich, dass ich der Bruder bin, den du immer hattest, aber nie kanntest."

# game/scripts/c22/c22.rpy:2645
translate german c22s004_ScarlettDNA_73b16163:

    # sca "Lo que acaba de decir [mc]. Pero tú siempre serás mi hermana, [dap]. Quiero que estés con nosotros cuando lo abramos."
    sca "Genau das, was [mc] gerade gesagt hat. Aber du wirst immer meine Schwester sein, [dap]. Ich möchte, dass du dabei bist, wenn wir es öffnen."

# game/scripts/c22/c22.rpy:2646
translate german c22s004_ScarlettDNA_c7773dc8:

    # dap "Gracias a los dos. Por confiar en mí y por querer que esté con vosotros en este momento."
    dap "Vielen Dank euch beiden. Danke, dass ihr mir vertraut und mich in dieser Zeit an eurer Seite haben wollt."

# game/scripts/c22/c22.rpy:2647
translate german c22s004_ScarlettDNA_f3fd243e:

    # mc "En este momento y siempre, [dap.nick]."
    mc "In diesem Moment und immerdar, [dap.nick]."

# game/scripts/c22/c22.rpy:2649
translate german c22s004_ScarlettDNA_0345a487:

    # sca "Ábrela ya, por favor. La impaciencia me está matando."
    sca "Öffne es bitte jetzt. Meine Ungeduld bringt mich um."

# game/scripts/c22/c22.rpy:2651
translate german c22s004_ScarlettDNA_0d45b307:

    # mc "Voy, no me metáis prisa. *Risa nerviosa*"
    mc "Ich komme, drängel mich nicht. *Nervöses Lachen*"

# game/scripts/c22/c22.rpy:2655
translate german c22s004_ScarlettDNA_22b43b67:

    # mc "0%% de compatibilidad."
    mc "0%% Kompatibilität."

# game/scripts/c22/c22.rpy:2657
translate german c22s004_ScarlettDNA_285a57ea:

    # mc "Lo siento, [sca]. No somos hermanos."
    mc "Tut mir leid, [sca]. Wir sind keine Brüder."

# game/scripts/c22/c22.rpy:2658
translate german c22s004_ScarlettDNA_57702b7b:

    # sca "Bueno..."
    sca "Also..."

# game/scripts/c22/c22.rpy:2660
translate german c22s004_ScarlettDNA_fe94b7e1:

    # sca "Me siento menos decepcionada de lo que hubiera esperado."
    sca "Ich bin weniger enttäuscht, als ich gehofft hatte."

# game/scripts/c22/c22.rpy:2661
translate german c22s004_ScarlettDNA_c29b1de9:

    # sca "Tenías razón, estaba poniendo mis esperanzas en pruebas circunstanciales tan solo. Había muchas coincidencias, pero eran solo eso. Coincidencias."
    sca "Du hattest Recht, ich hatte meine Hoffnungen allein auf Indizien gesetzt. Es gab viele Zufälle, aber mehr waren sie auch nicht. Zufälle."

# game/scripts/c22/c22.rpy:2662
translate german c22s004_ScarlettDNA_2304f2c3:

    # mc "Ven aquí, cielo."
    mc "Komm her, meine Liebe."

# game/scripts/c22/c22.rpy:2664
translate german c22s004_ScarlettDNA_554fd449:

    # sca "Por un lado tengo ganas de llorar, por otro, tengo ganas de reírme de mí misma."
    sca "Einerseits habe ich das Bedürfnis zu weinen, andererseits möchte ich über mich selbst lachen."

# game/scripts/c22/c22.rpy:2665
translate german c22s004_ScarlettDNA_ebc9c4c4:

    # mc "Sabes que no vamos a dejar de buscar a tu padre, ¿verdad?"
    mc "Du weißt, dass wir nicht aufhören werden, nach deinem Vater zu suchen, richtig?"

# game/scripts/c22/c22.rpy:2666
translate german c22s004_ScarlettDNA_1f8ae512:

    # mc "Y también sabes que, aunque no sea por sangre, ya perteneces a esta familia."
    mc "Und du weißt auch, dass du, selbst wenn du nicht blutsverwandt bist, bereits zu dieser Familie gehörst."

# game/scripts/c22/c22.rpy:2668
translate german c22s004_ScarlettDNA_b4f05b4a:

    # dap "Si por sangre fuera, ninguno perteneceríamos a esta familia, [sca]. Lo que importa es que nos vemos como una familia, no el ADN."
    dap "Wenn es nur um Blutsverwandtschaft ginge, würde keiner von uns zu dieser Familie gehören. Wichtig ist, dass wir uns als Familie sehen, nicht unsere DNA."

# game/scripts/c22/c22.rpy:2669
translate german c22s004_ScarlettDNA_812efafa:

    # mc "Ven aquí, [dap.nick]. No puedes saber lo mucho que te quiero ahora mismo."
    mc "Komm her, [dap.nick]. Du kannst dir nicht vorstellen, wie sehr ich dich gerade liebe."

# game/scripts/c22/c22.rpy:2671
translate german c22s004_ScarlettDNA_113b1ec2:

    # sca "Gracias. Sois maravillosos todos. No podría pertenecer a una familia mejor."
    sca "Vielen Dank. Ihr seid alle wunderbar. Ich könnte keiner besseren Familie angehören."

# game/scripts/c22/c22.rpy:2672
translate german c22s004_ScarlettDNA_cc150b60:

    # "El abrazo dura unos largos minutos en los que os prometéis que no dejaréis de buscar al padre de [sca] ni a tu medio hermana."
    "Die Umarmung dauert mehrere lange Minuten, in denen ihr euch gegenseitig versprecht, nicht aufzuhören, nach [sca]s Vater oder eurer Halbschwester zu suchen."

# game/scripts/c22/c22.rpy:2674
translate german c22s004_ScarlettDNA_50f3bee0:

    # sca "Deberíamos ir bajando a la piscina. Se van a preguntar dónde estamos y no quiero tener que dar explicaciones."
    sca "Wir sollten zum Pool gehen. Die Leute werden sich fragen, wo wir sind, und ich möchte es nicht erklären müssen."

# game/scripts/c22/c22.rpy:2675
translate german c22s004_ScarlettDNA_af514b60:

    # mc "Yo pensaba ir un rato. Tengo que hacer unas cosas después."
    mc "Ich hatte eigentlich vor, nur kurz wegzufahren. Ich habe danach noch ein paar Dinge zu erledigen."

# game/scripts/c22/c22.rpy:2678
translate german c22s004_ScarlettDNA_31c8e57b:

    # "[sca] explota en una carcajada que os deja anonadados a [dap] y a ti."
    "[sca] bricht in ein Lachen aus, das dich und [dap] sprachlos macht."

# game/scripts/c22/c22.rpy:2679
translate german c22s004_ScarlettDNA_52054a89:

    # sca "*Risa*"
    sca "*Lachen*"

# game/scripts/c22/c22.rpy:2680
translate german c22s004_ScarlettDNA_3ef44222:

    # mc "¿Qué pasa, [sca]? ¿Qué has pensado que sea tan gracioso?"
    mc "Was ist los, [sca]? Was fandest du denn so witzig?"

# game/scripts/c22/c22.rpy:2682
translate german c22s004_ScarlettDNA_2a8c1534:

    # sca "*Risa* Que al menos nuestros hijos no serán endogámicos."
    sca "*Gelächter* Wenigstens werden unsere Kinder nicht inzestuös sein."

# game/scripts/c22/c22.rpy:2684
translate german c22s004_ScarlettDNA_6e2b5e6e:

    # sca "Si los tenemos, claro"
    sca "Wenn wir sie natürlich haben."

# game/scripts/c22/c22.rpy:2685
translate german c22s004_ScarlettDNA_0594dbf9:

    # mc "*Risa* No hay mal que por bien no venga."
    mc "*Gelächter* Jede Wolke hat einen Silberstreif am Horizont."

# game/scripts/c22/c22.rpy:2686
translate german c22s004_ScarlettDNA_f753e90a:

    # mc "*Risa* Además, te libras de tener una mierda de padre."
    mc "*Lacht* Und außerdem wird man einen beschissenen Vater los."

# game/scripts/c22/c22.rpy:2687
translate german c22s004_ScarlettDNA_94e0360a:

    # dap "Me alegra que no lleve mis genes. *Risa* Tío Edmund queda expulsado de la familia."
    dap "Ich bin froh, dass er nicht meine Gene hat. *lacht* Onkel Edmund ist jetzt aus der Familie verstoßen."

# game/scripts/c22/c22.rpy:2692
translate german c22s004_ScarlettDNA_5c98cf6d:

    # mc "99.7%% de compatibilidad. ¿Por qué no es un 100%%?"
    mc "99,7%% Kompatibilität. Warum nicht 100%%?"

# game/scripts/c22/c22.rpy:2694
translate german c22s004_ScarlettDNA_207f0e30:

    # sca "{b}¿De verdad?{/b} ¿Somos hermanos?"
    sca "{b}Wirklich?{/b}Sind wir Geschwister?"

# game/scripts/c22/c22.rpy:2695
translate german c22s004_ScarlettDNA_efc06c7f:

    # mc "Bueno, medio-herm..."
    mc "Nun ja, irgendwie schon..."

# game/scripts/c22/c22.rpy:2697
translate german c22s004_ScarlettDNA_f80a7fbe:

    # sca "¡Sí! ¡Sí! ¡Sí!"
    sca "Ja ja ja!"

# game/scripts/c22/c22.rpy:2700
translate german c22s004_ScarlettDNA_abd52fa4:

    # "Tu nueva medio-hermana te besa de forma apasionada. Hay mucho alivio en ese beso."
    "Deine neue Halbschwester küsst dich leidenschaftlich. Dieser Kuss ist so befreiend."

# game/scripts/c22/c22.rpy:2702
translate german c22s004_ScarlettDNA_fa015a3a:

    # "Tu nueva medio-hermana te abraza con fuerza. Hay mucho alivio en ese abrazo."
    "Deine neue Halbschwester umarmt dich fest. Diese Umarmung ist so befreiend."

# game/scripts/c22/c22.rpy:2703
translate german c22s004_ScarlettDNA_0b6ff569:

    # "Alivio por haber encontrado a una familia, aunque ya formara parte de ella."
    "Erleichterung darüber, eine Familie gefunden zu haben, obwohl ich bereits ein Teil von ihr war."

# game/scripts/c22/c22.rpy:2704
translate german c22s004_ScarlettDNA_e8c693b7:

    # "Alivio porque por fin sabe quién es su padre."
    "Erleichterung, weil sie endlich weiß, wer ihr Vater ist."

# game/scripts/c22/c22.rpy:2705
translate german c22s004_ScarlettDNA_7fbb5625:

    # "Alivio por no tener que seguir buscando."
    "Erleichterung darüber, nicht weiter suchen zu müssen."

# game/scripts/c22/c22.rpy:2707
translate german c22s004_ScarlettDNA_e49fc5ca:

    # dap "Felicidades, chicos."
    dap "Herzlichen Glückwunsch, Jungs."

# game/scripts/c22/c22.rpy:2708
translate german c22s004_ScarlettDNA_348cb3a1:

    # mc "Gracias, [dap]."
    mc "Vielen Dank, [dap]."

# game/scripts/c22/c22.rpy:2710
translate german c22s004_ScarlettDNA_b8792cdd:

    # sca "¿No me vas a felicitar por pertenecer a la familia?"
    sca "Wirst du mir nicht dazu gratulieren, dass ich nun zur Familie gehöre?"

# game/scripts/c22/c22.rpy:2711
translate german c22s004_ScarlettDNA_b17bedfa:

    # mc "¿Por pertenecer a esta familia de bichos raros? *Risa* ¿Felicitaciones o condolencias?"
    mc "Weil ich zu dieser Familie von Sonderlingen gehöre? *lacht* Glückwunsch oder Beileid?"

# game/scripts/c22/c22.rpy:2713
translate german c22s004_ScarlettDNA_24b8494c:

    # dap "No, no lo voy a hacer."
    dap "Nein, ich werde es nicht tun."

# game/scripts/c22/c22.rpy:2714
translate german c22s004_ScarlettDNA_6fb843a1:

    # dap "Para mí, ya eras mi hermana. Ya pertenecías a la familia."
    dap "Für mich warst du schon meine Schwester. Du gehörtest schon zur Familie."

# game/scripts/c22/c22.rpy:2716
translate german c22s004_ScarlettDNA_c5c2b4d4:

    # dap "¿Ahora qué eres? ¿Una medio-prima?"
    dap "Was bist du jetzt? Ein Halbcousin?"

# game/scripts/c22/c22.rpy:2717
translate german c22s004_ScarlettDNA_c2c11a9b:

    # dap "*Risa* Eso es casi como una desconocida."
    dap "*lacht* Das ist fast wie bei einem Fremden."

# game/scripts/c22/c22.rpy:2718
translate german c22s004_ScarlettDNA_4a7e6e26:

    # mc "*Risa* Ven aquí, [dap.nick]."
    mc "*Gelächter* Komm her, [dap.nick]."

# game/scripts/c22/c22.rpy:2720
translate german c22s004_ScarlettDNA_a24ca89e:

    # sca "Aunque tienes razón, [dap], es un alivio haber descubierto quién es mi padre después de tantos años."
    sca "Obwohl du Recht hast, [dap], ist es eine Erleichterung, nach so vielen Jahren endlich herausgefunden zu haben, wer mein Vater ist."

# game/scripts/c22/c22.rpy:2721
translate german c22s004_ScarlettDNA_d31d3d82:

    # mc "Aunque sea una mierda de padre. *Risa*"
    mc "Auch wenn er ein mieser Vater ist. *lacht*"

# game/scripts/c22/c22.rpy:2722
translate german c22s004_ScarlettDNA_553322e8:

    # sca "*Risa* Exacto, aunque sea una mierda de padre."
    sca "*Lacht* Genau, auch wenn er ein mieser Vater ist."

# game/scripts/c22/c22.rpy:2723
translate german c22s004_ScarlettDNA_d1d0208a:

    # mc "Te entiendo. Yo solo hace una semana que sé que tengo una medio-hermana y no me quiero imaginar qué hubiera pasado si hubiera salido negativo."
    mc "Ich verstehe. Ich habe erst vor einer Woche erfahren, dass ich eine Halbschwester habe, und ich will mir gar nicht vorstellen, was passiert wäre, wenn der Test negativ ausgefallen wäre."

# game/scripts/c22/c22.rpy:2724
translate german c22s004_ScarlettDNA_9139496e:

    # dap "Habláis demasiado en vez de disfrutar del abrazo."
    dap "Du redest zu viel, anstatt die Umarmung zu genießen."

# game/scripts/c22/c22.rpy:2726
translate german c22s004_ScarlettDNA_78da8826:

    # sca "Habrá que decírselo a la familia, ¿no?"
    sca "Wir müssen es der Familie sagen, nicht wahr?"

# game/scripts/c22/c22.rpy:2727
translate german c22s004_ScarlettDNA_494a6419:

    # mc "Sí."
    mc "Ja."

# game/scripts/c22/c22.rpy:2728
translate german c22s004_ScarlettDNA_a7af273e:

    # sca "No sé ni por dónde empezar. Creo que [mar] es la primera a quién se lo tendríamos que decir."
    sca "Ich weiß gar nicht, wo ich anfangen soll. Ich glaube, [mar] ist die erste Person, der wir es erzählen sollten."

# game/scripts/c22/c22.rpy:2729
translate german c22s004_ScarlettDNA_1bf788a5:

    # mc "Yo le he adelantado algo. Hace unos días se me escapó que había hablado con mi... con nuestro padre, y hoy me ha tirado de la lengua."
    mc "Ich habe ihm schon etwas erzählt. Vor ein paar Tagen habe ich durchblicken lassen, dass ich mit meinem... mit unserem Vater gesprochen hatte, und heute hat er mich dazu gebracht, die ganze Geschichte auszuplaudern."

# game/scripts/c22/c22.rpy:2730
translate german c22s004_ScarlettDNA_04d86e89:

    # mc "No podía explicarle verdades a medias."
    mc "Ich konnte ihm keine Halbwahrheiten erklären."

# game/scripts/c22/c22.rpy:2731
translate german c22s004_ScarlettDNA_919c704a:

    # dap "No me hubiera gustado estar en tu situación cuando has tenido que explicárselo."
    dap "Ich möchte nicht in deiner Lage sein, als du es ihm erklären musstest."

# game/scripts/c22/c22.rpy:2734
translate german c22s004_ScarlettDNA_babaf7a0:

    # sca "No importa. Era quien más miedo me daba, por el daño que le podía hacer."
    sca "Das spielt keine Rolle. Er war derjenige, vor dem ich am meisten Angst hatte, wegen des Schadens, den ich ihm zufügen könnte."

# game/scripts/c22/c22.rpy:2737
translate german c22s004_ScarlettDNA_bab8b048:

    # dap "Vamos a ir la piscina. Se me ha ocurrido una cosa."
    dap "Wir gehen ins Schwimmbad. Ich habe eine Idee."

# game/scripts/c22/c22.rpy:2738
translate german c22s004_ScarlettDNA_13854cce:

    # dap "Os espero allí. Dadme cinco de minutos para organizarlo todo. Necesito que alguien concreto esté allí."
    dap "Ich werde dort auf dich warten. Gib mir fünf Minuten, um alles vorzubereiten. Eine bestimmte Person muss unbedingt dabei sein."

# game/scripts/c22/c22.rpy:2739
translate german c22s004_ScarlettDNA_e8fe7918:

    # dap "Tú también ven, [mc]. La puedes seguir abrazando esos cinco minutos, si quieres."
    dap "Komm du auch mit, [mc]. Du kannst sie die ganzen fünf Minuten lang umarmen, wenn du willst."

# game/scripts/c22/c22.rpy:2752
translate german c22s004_ScarlettReveal_2560e44f:

    # "El abrazo dura cinco minutos que se hacen muy cortos. No necesitáis decir nada más de lo que vuestros brazos rodeando al otro dicen."
    "Die Umarmung dauert fünf Minuten, die wie im Flug vergehen. Man muss nichts weiter sagen als das, was die Arme umeinander aussagen."

# game/scripts/c22/c22.rpy:2754
translate german c22s004_ScarlettReveal_bd25726a:

    # sca "No es que no se esté a gusto aquí, pero ¿vamos a la piscina? [dap.nick] se va a empezar a impacientar."
    sca "Es ist nicht so, dass wir uns hier nicht wohlfühlen, aber sollen wir zum Pool gehen? [dap.nick] Er wird langsam ungeduldig."

# game/scripts/c22/c22.rpy:2755
translate german c22s004_ScarlettReveal_bc8df2f6:

    # mc "Vamos. Tengo curiosidad por ver qué se le ha ocurrido."
    mc "Na los. Ich bin gespannt, was er sich ausgedacht hat."

# game/scripts/c22/c22.rpy:2758
translate german c22s004_ScarlettReveal_7baa2ae0:

    # sca "Te quiero, hermanito."
    sca "Ich liebe dich, kleiner Bruder."

# game/scripts/c22/c22.rpy:2759
translate german c22s004_ScarlettReveal_c02b3e4f:

    # mc "Te quiero, hermanita."
    mc "Ich liebe dich, kleine Schwester."

# game/scripts/c22/c22.rpy:2762
translate german c22s004_ScarlettReveal_4ca99130:

    # sca "Te quiero, [mc]."
    sca "Ich liebe dich, [mc]."

# game/scripts/c22/c22.rpy:2763
translate german c22s004_ScarlettReveal_354ce0f8:

    # mc "Te quiero, [sca]."
    mc "Ich liebe dich, [sca]."

# game/scripts/c22/c22.rpy:2765
translate german c22s004_ScarlettReveal_9b76ba1e:

    # "Cuando llegáis a la piscina os encontráis con una escena un poco caótica."
    "Bei Ihrer Ankunft am Pool erwartet Sie ein eher chaotisches Bild."

# game/scripts/c22/c22.rpy:2768
translate german c22s004_ScarlettReveal_7df829c9:

    # "Poco después de comer, mientras te estás poniendo el bañador para ir al jacuzzi, te llega un mensaje de [dap] diciéndote que te necesita en la piscina."
    "Kurz nachdem du gegessen hast und dich gerade in deinen Badeanzug ziehst, um in den Whirlpool zu gehen, erhältst du eine Nachricht von [dap], in der er dir mitteilt, dass er dich am Pool braucht."

# game/scripts/c22/c22.rpy:2770
translate german c22s004_ScarlettReveal_3fdf7a43:

    # "Cuando llegas a la piscina te encuentras con una escena un poco caótica."
    "Bei Ihrer Ankunft am Pool erwartet Sie ein eher chaotisches Bild."

# game/scripts/c22/c22.rpy:2771
translate german c22s004_ScarlettReveal_ad312d68:

    # dap "[emm], quédate ahí un momento."
    dap "[emm], verweile einen Moment dort."

# game/scripts/c22/c22.rpy:2772
translate german c22s004_ScarlettReveal_bfb987da:

    # emm "Pero, ¿a qué viene esto?"
    emm "Aber was soll das Ganze?"

# game/scripts/c22/c22.rpy:2773
translate german c22s004_ScarlettReveal_f8fa5592:

    # dap "Es una cosa que quiero probar."
    dap "Das möchte ich gerne mal ausprobieren."

# game/scripts/c22/c22.rpy:2774
translate german c22s004_ScarlettReveal_a5e677b1:

