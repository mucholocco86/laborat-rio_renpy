    # deb "Ahora vuelvo a la habitación y me lo explicas todo."
    deb "Ich gehe jetzt zurück ins Zimmer, und du kannst mir alles erklären."

# game/scripts/c22/c22.rpy:4143
translate german c22s008_GroupMessages_5df66893:

    # kim "¿Ya se ha ido?"
    kim "Ist er schon abgereist?"

# game/scripts/c22/c22.rpy:4145
translate german c22s008_GroupMessages_55ea2fd4:

    # kat "¿Eyaculador precoz?"
    kat "Vorzeitiger Samenerguss?"

# game/scripts/c22/c22.rpy:4147
translate german c22s008_GroupMessages_60195a4e:

    # jam "O impotente. :D"
    jam "Oder impotent. :D"

# game/scripts/c22/c22.rpy:4148
translate german c22s008_GroupMessages_176d654c:

    # "Varias chicas se ríen."
    "Mehrere Mädchen lachen."

# game/scripts/c22/c22.rpy:4150
translate german c22s008_GroupMessages_d8fc61d2:

    # sai "Os puedo asegurar que no lo es. ^^"
    sai "Ich kann dir versichern, dass es nicht so ist. ^^"

# game/scripts/c22/c22.rpy:4153
translate german c22s008_GroupMessages_4aa07a86:

    # sai "O no lo era hace dos meses."
    sai "Oder das war vor zwei Monaten noch nicht der Fall."

# game/scripts/c22/c22.rpy:4155
translate german c22s008_GroupMessages_910b52cf:

    # mar "¿Qué es eso de que solo lo crees, [lis]?"
    mar "Was soll das, dass du es einfach glaubst, [lis]?"

# game/scripts/c22/c22.rpy:4157
translate german c22s008_GroupMessages_2c487629:

    # lis "No sé... no lo hemos hablado."
    lis "Ich weiß nicht... wir haben nicht darüber gesprochen."

# game/scripts/c22/c22.rpy:4159
translate german c22s008_GroupMessages_ca3497b3:

    # lis "Tan solo nos hemos besado."
    lis "Wir haben uns nur geküsst."

