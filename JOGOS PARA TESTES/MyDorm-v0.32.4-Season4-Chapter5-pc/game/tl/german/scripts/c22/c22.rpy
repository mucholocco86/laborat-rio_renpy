    # dap "¡Mierda! [lis], lo has mandado al grupo en el que está [mc]."
    dap "Verdammt! [lis], du hast es an die Gruppe geschickt, in der [mc] ist."

# game/scripts/c22/c22.rpy:4176
translate german c22s008_GroupMessages_2365bc78:

    # nor "¡Borrad todos los mensajes!"
    nor "Alle Nachrichten löschen!"

# game/scripts/c22/c22.rpy:4178
translate german c22s008_GroupMessages_dfb1bbce:

    # mee "Con un poco de suerte está durmiendo y no los ha visto."
    mee "Mit etwas Glück schläft er und hat sie nicht gesehen."

# game/scripts/c22/c22.rpy:4180
translate german c22s008_GroupMessages_4106d794:

    # kia "¡Pero no sigáis escribiendo!"
    kia "Aber schreib nicht mehr!"

# game/scripts/c22/c22.rpy:4182
translate german c22s008_GroupMessages_a6f7eb34:

    # eil "Mamá, acabas de escribir para decirnos que no escribamos."
    eil "Mama, du hast uns doch gerade geschrieben, dass wir nicht schreiben sollen."

# game/scripts/c22/c22.rpy:4184
translate german c22s008_GroupMessages_8c68fe08:

    # eil "¿Te das cuenta de la ironía? XD"
    eil "Ist dir die Ironie bewusst? XD"

# game/scripts/c22/c22.rpy:4186
translate german c22s008_GroupMessages_2e77da8d:

    # jam "Alguien habla de [mc] y perdéis el mundo de vista, chicas."
    jam "Wenn jemand [mc] erwähnt, verliert man den Bezug zur Realität, Mädels."

# game/scripts/c22/c22.rpy:4188
translate german c22s008_GroupMessages_e227a042:

    # jam "Si fuera guapo y estuviese en una silla de ruedas lo entendería, pero es [mc]. ;)"
    jam "Wenn er gutaussehend wäre und im Rollstuhl säße, würde ich es ja verstehen, aber er ist [mc]. ;)"

# game/scripts/c22/c22.rpy:4189
translate german c22s008_GroupMessages_fc681839:

    # "Varias se ríen. Los mensajes van desapareciendo."
    "Mehrere lachen. Die Nachrichten verschwinden."

# game/scripts/c22/c22.rpy:4191
translate german c22s008_GroupMessages_290ca1e0:

    # meg "Has dicho guapo, con lo que supongo que no te refieres a ti mismo. XD"
    meg "Du hast „gutaussehend“ gesagt, also nehme ich an, du meinst nicht dich selbst. XD"

# game/scripts/c22/c22.rpy:4192
translate german c22s008_GroupMessages_d5ef6831:

    # "Todas se ríen."
    "Alle lachen."

# game/scripts/c22/c22.rpy:4194
translate german c22s008_GroupMessages_c091406a:

    # jam "Te espero en el otro grupo, [meg]. Has cavado tu propia tumba. :D"
    jam "Wir sehen uns in der anderen Gruppe, [meg]. Du hast dir dein eigenes Grab geschaufelt. :D"

# game/scripts/c22/c22.rpy:4196
translate german c22s008_GroupMessages_755b94b2:

    # eri "Chicas, borrad todo y pasemos al otro grupo."
    eri "Mädels, löscht alles und lasst uns zur anderen Gruppe übergehen."

# game/scripts/c22/c22.rpy:4197
translate german c22s008_GroupMessages_799f8e5b:

    # "No llegan más mensajes."
    "Es treffen keine Nachrichten mehr ein."

# game/scripts/c22/c22.rpy:4198
translate german c22s008_GroupMessages_44e70493:

    # "Dudas si hacerles saber que los has leído."
    "Sie sind sich unsicher, ob Sie ihnen mitteilen sollen, dass Sie sie gelesen haben."

# game/scripts/c22/c22.rpy:4210
translate german c22s008_Sca_25afa3c9:

    # "Te desnudas y te metes en la cama. Después de todas las emociones del día, especialmente lo de [sca], necesitas una noche de descanso."
    "Du ziehst dich aus und legst dich ins Bett. Nach all der Aufregung des Tages, besonders nach dem, was mit [sca] passiert ist, brauchst du eine gute Nachtruhe."

# game/scripts/c22/c22.rpy:4215
translate german c22s008_Sca_dd0461ef:

    # "*Knock-Knock*"
    "*Klopf-Klopf*"

# game/scripts/c22/c22.rpy:4217
translate german c22s008_Sca_6f53ca31:

    # sca "*A través de la puerta* *Susurrando* ¿Estás despierto, [mc]?"
    sca "*Durch die Tür* *Flüsternd* Bist du wach, [mc]?"

# game/scripts/c22/c22.rpy:4218
translate german c22s008_Sca_4d601f0e:

    # mc "Sí, pasa."
    mc "Ja, das kommt vor."

# game/scripts/c22/c22.rpy:4220
translate german c22s008_Sca_31c59a57:

    # sca "¿Ibas a dormir ya? Puedo volver en otro momento."
    sca "Wolltest du schon schlafen gehen? Ich kann ja ein anderes Mal wiederkommen."

# game/scripts/c22/c22.rpy:4221
translate german c22s008_Sca_3ee16fe5:

    # mc "No, no te preocupes, dime."
    mc "Nein, keine Sorge, sag es mir."

# game/scripts/c22/c22.rpy:4223
translate german c22s008_Sca_021db7ac:

    # sca "Me preguntaba si me dejarías dormir contigo."
    sca "Ich wollte fragen, ob ich bei dir schlafen darf."

# game/scripts/c22/c22.rpy:4225
translate german c22s008_Sca_d759b8c0:

    # sca "Solo dormir."
    sca "Schlaf einfach."

# game/scripts/c22/c22.rpy:4226
translate german c22s008_Sca_945baa6f:

    # mc "¿Solo dormir?"
    mc "Einfach nur schlafen?"

# game/scripts/c22/c22.rpy:4230
translate german c22s008_Sca_42604f44:

    # sca "Después de lo emocionante que ha sido esta tarde, quiero dormir con mi hermano."
    sca "Nach diesem aufregenden Nachmittag möchte ich jetzt bei meinem Bruder schlafen."

# game/scripts/c22/c22.rpy:4231
translate german c22s008_Sca_f71822fb:

    # sca "Siempre he querido tener una hermana con quien dormir. Cosas de hija única, supongo..."
    sca "Ich habe mir immer eine Schwester gewünscht, mit der ich schlafen kann. Typisch Einzelkind, schätze ich..."

# game/scripts/c22/c22.rpy:4233
translate german c22s008_Sca_24fedab6:

    # sca "No se lo digas a [emm], pero prefiero dormir contigo. No lo hubiera descubierto sin ti."
    sca "Sag es nicht [emm], aber ich würde lieber mit dir schlafen. Ohne dich wäre ich nie darauf gekommen."

# game/scripts/c22/c22.rpy:4235
translate german c22s008_Sca_67364348:

    # sca "Después de la decepción de esta tarde, ha venido el bonito gesto de [dap.nick] y del resto de chicas."
    sca "Nach der Enttäuschung heute Nachmittag kam die freundliche Geste von [dap.nick] und den anderen Mädchen."

# game/scripts/c22/c22.rpy:4236
translate german c22s008_Sca_531fc3e4:

    # sca "Pero siempre he querido tener una hermana con quien dormir. Cosas de hija única, supongo..."
    sca "Aber ich habe mir immer eine Schwester gewünscht, mit der ich schlafen kann. Typisch Einzelkind eben..."

# game/scripts/c22/c22.rpy:4238
translate german c22s008_Sca_b9e64c6b:

    # sca "Y resulta que llevo días durmiendo con mi nueva hermana."
    sca "Und es stellt sich heraus, dass ich schon seit Tagen mit meiner neuen Schwester schlafe."

# game/scripts/c22/c22.rpy:4239
translate german c22s008_Sca_5634e461:

    # sca "Si hubiera salido positivo, posiblemente estaría en la habitación de [emm] ahora mismo."
    sca "Wenn mein Test positiv ausgefallen wäre, befände ich mich wahrscheinlich jetzt in Zimmer [emm]."

# game/scripts/c22/c22.rpy:4241
translate german c22s008_Sca_dcb58739:

    # sca "Pero estaba tan segura de que el test saldría positivo que ya había planeado dormir contigo también."
    sca "Aber ich war mir so sicher, dass der Test positiv ausfallen würde, dass ich schon geplant hatte, auch mit dir zu schlafen."

# game/scripts/c22/c22.rpy:4243
translate german c22s008_Sca_d759b8c0_1:

    # sca "Solo dormir."
    sca "Schlaf einfach."

# game/scripts/c22/c22.rpy:4245
translate german c22s008_Sca_c29622fd:

    # sca "El día que viniste a casa de mi madre te tuve que echar. Pero me quedé con ganas de dormir contigo."
    sca "An dem Tag, als du zu meiner Mutter kamst, musste ich dich rauswerfen. Aber ich wollte trotzdem mit dir schlafen."

# game/scripts/c22/c22.rpy:4246
translate german c22s008_Sca_45e7038d:

    # sca "He pensado que podríamos continuar donde lo dejamos aquel día. En dormir juntos por primera vez."
    sca "Ich dachte, wir könnten da weitermachen, wo wir an dem Tag aufgehört hatten. Als wir zum ersten Mal zusammen schliefen."

# game/scripts/c22/c22.rpy:4248
translate german c22s008_Sca_4aeaf7d7:

    # mc "Por supuesto. Estoy desnudo bajo las sábanas. ¿Te importa?"
    mc "Natürlich. Ich bin nackt unter der Decke. Stört dich das?"

# game/scripts/c22/c22.rpy:4250
translate german c22s008_Sca_d1413ef0:

    # sca "*Risa* No te preocupes. Creo que podré resistir la tentación."
    sca "*Lacht* Keine Sorge. Ich glaube, ich kann der Versuchung widerstehen."

# game/scripts/c22/c22.rpy:4251
translate german c22s008_Sca_2cc765a6:

    # sca "Yo no me quitaré el pijama para no tentarte. *Risa*"
    sca "Ich ziehe meinen Schlafanzug nicht aus, um dich nicht in Versuchung zu führen. *lacht*"

# game/scripts/c22/c22.rpy:4253
translate german c22s008_Sca_b94af42c:

    # mc "Dame un momento para ponerme algo. Estoy desnudo bajo las sábanas."
    mc "Gib mir einen Moment, um mich anzuziehen. Ich bin nackt unter der Bettdecke."

# game/scripts/c22/c22.rpy:4255
translate german c22s008_Sca_94190516:

    # sca "No te preocupes. No voy a mirar."
    sca "Keine Sorge. Ich werde nicht hinschauen."

# game/scripts/c22/c22.rpy:4257
translate german c22s008_Sca_a8136d8d:

    # mc "¿Estás bien?"
    mc "Alles in Ordnung?"

# game/scripts/c22/c22.rpy:4258
translate german c22s008_Sca_ffd02d04:

    # "Hablas un poco más alto de lo habitual porque [sca] se ha quitado el audífono para dormir."
    "Du sprichst etwas lauter als sonst, weil [sca] sein Hörgerät zum Schlafen abgenommen hat."

# game/scripts/c22/c22.rpy:4259
translate german c22s008_Sca_345021a4:

    # sca "Genial, no te preocupes por mí."
    sca "Wunderbar, mach dir keine Sorgen um mich."

# game/scripts/c22/c22.rpy:4262
translate german c22s008_Sca_5389533f:

    # sca "Desde la última lección que no había venido aquí. Fue el día que llegaron [lis], [deb.nick], [kim], y [kat]."
    sca "Ich war seit der letzten Stunde nicht mehr hier gewesen. Es war der Tag, an dem [lis], [deb.nick], [kim] und [kat] kamen."

# game/scripts/c22/c22.rpy:4263
translate german c22s008_Sca_618fec55:

    # mc "Ha pasado mucho tiempo y las cosas han cambiado mucho. Tú y yo aún no estábamos saliendo cuando entraste por la puerta."
    mc "Es ist lange her und vieles hat sich verändert. Wir waren noch nicht einmal zusammen, als du zur Tür hereinkamst."

# game/scripts/c22/c22.rpy:4265
translate german c22s008_Sca_cfd9c65f:

    # sca "Pero sí cuando salí. Pese a mi metedura de pata aquel día, lo recuerdo como un día feliz."
    sca "Aber ich tat es, als ich ging. Trotz meines Fehlers an diesem Tag erinnere ich mich an ihn als einen glücklichen Tag."

# game/scripts/c22/c22.rpy:4266
translate german c22s008_Sca_fdb5b3c2:

    # sca "He tenido un montón de días felices últimamente. No recuerdo tantos buenos días seguidos en toda mi vida."
    sca "Ich hatte in letzter Zeit viele glückliche Tage. Ich kann mich nicht erinnern, jemals so viele gute Tage hintereinander in meinem ganzen Leben gehabt zu haben."

# game/scripts/c22/c22.rpy:4267
translate german c22s008_Sca_fd799c61:

    # mc "Me alegra mucho que estés aquí, que formes parte de la familia."
    mc "Ich bin so froh, dass du hier bist, dass du zur Familie gehörst."

# game/scripts/c22/c22.rpy:4271
translate german c22s008_Sca_20d3804d:

    # sca "Aunque no compartamos padre..."
    sca "Auch wenn wir keinen gemeinsamen Vater haben..."

# game/scripts/c22/c22.rpy:4272
translate german c22s008_Sca_a64a5d91:

    # mc "Como ha dicho [dap], si por los genes fuera, nadie sería parte de esta familia."
    mc "Wie [dap] schon sagte: Wenn es nach den Genen ginge, wäre niemand Teil dieser Familie."

# game/scripts/c22/c22.rpy:4273
translate german c22s008_Sca_bf92dd6c:

    # mc "Tampoco comparto padres con [emm], y no por ello es menos mi hermana."
    mc "Ich habe zwar nicht die gleichen Eltern wie [emm], aber das macht sie nicht weniger zu meiner Schwester."

# game/scripts/c22/c22.rpy:4275
translate german c22s008_Sca_eea69c2e:

    # sca "Tienes razón. Decidimos ser una familia. Y lo somos."
    sca "Du hast Recht. Wir haben beschlossen, eine Familie zu sein. Und das sind wir auch."

# game/scripts/c22/c22.rpy:4276
translate german c22s008_Sca_d2da67b5:

    # sca "Al final sí que voy a dormir con mi hermano."
    sca "Am Ende werde ich bei meinem Bruder schlafen."

# game/scripts/c22/c22.rpy:4277
translate german c22s008_Sca_2f498449:

    # mc "Esa es la actitud, cariño. Siempre me tendrás aquí."
    mc "Ganz genau so, Liebling. Du kannst dich immer auf mich verlassen."

# game/scripts/c22/c22.rpy:4280
translate german c22s008_Sca_4bfc6e4a:

    # sca "No me puedo imaginar qué hubiera pasado si hubiera salido negativo."
    sca "Ich kann mir gar nicht vorstellen, was passiert wäre, wenn das Ergebnis negativ gewesen wäre."

# game/scripts/c22/c22.rpy:4281
translate german c22s008_Sca_b7b8331c:

    # mc "Que formarías parte de esta familia igual. No comparto padres con [jam] y es mi hermano."
    mc "Dass du sowieso zu dieser Familie gehören würdest. Ich habe nicht die gleichen Eltern wie [jam] und er ist mein Bruder."

# game/scripts/c22/c22.rpy:4283
translate german c22s008_Sca_06ccd97e:

    # sca "Tienes razón. Seríamos familia por elección."
    sca "Du hast Recht. Wir wären eine Familie aus freier Wahl."

# game/scripts/c22/c22.rpy:4284
translate german c22s008_Sca_53570742:

    # sca "Pero por alguna razón, me conforta saber que voy a dormir con mi hermano."
    sca "Aber aus irgendeinem Grund beruhigt es mich, zu wissen, dass ich bei meinem Bruder schlafen werde."

# game/scripts/c22/c22.rpy:4285
translate german c22s008_Sca_56416549:

    # mc "Siempre me tendrás aquí, cariño."
    mc "Du kannst immer auf mich zählen, Liebling."

# game/scripts/c22/c22.rpy:4287
translate german c22s008_Sca_734a2526:

    # sca "Pero como me vuelvas a comparar con un perro callejero, me convertiré en una hermana insoportable. *Risa*"
    sca "Aber wenn du mich jemals wieder mit einem streunenden Hund vergleichst, werde ich eine unerträgliche Schwester. *lacht*"

# game/scripts/c22/c22.rpy:4288
translate german c22s008_Sca_3dab2082:

    # mc "*Risa* ¿Te lo ha dicho? ¿Dónde queda el secreto de confesión de los católicos?"
    mc "*Gelächter* Hat er es dir erzählt? Was ist mit dem Beichtgeheimnis für Katholiken passiert?"

# game/scripts/c22/c22.rpy:4289
translate german c22s008_Sca_b4208e89:

    # sca "*Risa* Creo que eso solo funciona con los curas, no con las monjas."
    sca "*lacht* Ich glaube, das funktioniert nur bei Priestern, nicht bei Nonnen."

# game/scripts/c22/c22.rpy:4291
translate german c22s008_Sca_bf359170:

    # "Pasáis un rato charlando antes de apagar las luces. Dormís plácidamente toda la noche en los brazos del otro."
    "Ihr unterhaltet euch noch eine Weile, bevor ihr das Licht ausmacht. Ihr schlaft die ganze Nacht friedlich in den Armen des anderen."

# game/scripts/c22/c22.rpy:4292
translate german c22s008_Sca_586d8740:

    # "Es una gran sensación dormir con una mujer a la que quieres como si fuera tu hermana."
    "Es ist ein tolles Gefühl, mit einer Frau zu schlafen, die man wie eine Schwester liebt."

# game/scripts/c22/c22.rpy:4294
translate german c22s008_Sca_626d3774:

    # "Porque lo es."
    "Weil es so ist."

# game/scripts/c22/c22.rpy:4296
translate german c22s008_Sca_62c62d5e:

    # "Aunque un estúpido test de ADN diga lo contrario."
    "Selbst wenn ein blöder DNA-Test etwas anderes behauptet."

# game/scripts/c22/c22.rpy:4297
translate german c22s008_Sca_510dfb5b:

    # "No vas a dejar que un maldito papel le quite la ilusión."
    "Du wirst nicht zulassen, dass ein blödes Stück Papier ihm seine Hoffnung raubt."

# game/scripts/c22/c22.rpy:4299
translate german c22s008_Sca_22614fe3:

    # "O al menos la prima en quien [dap] la ha convertido."
    "Oder zumindest die Cousine, die sie in [dap] verwandelt hat."

# game/scripts/c22/c22.rpy:4313
translate german c22s010_eoc_32c3c0e6:

    # "{b}Esto es todo por esta versión. Por favor, graba aquí y nos vemos en la próxima actualización de My Dorm. Gracias por jugar y por tu apoyo. Espero que hayas disfrutado del juego.{/b}"
    "Das war's für diese Version. Bitte speichert hier und wir sehen uns beim nächsten My Dorm-Update wieder. Danke fürs Spielen und für eure Unterstützung. Ich hoffe, euch hat das Spiel gefallen."

