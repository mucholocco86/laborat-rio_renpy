translate german c22s004_ScarlettReveal_20aabfe8:

    # dap "[ama], tú estás bien, a ese lado de [eva]."
    dap "[ama], du bist auf der anderen Seite von [eva] in Ordnung."

# game/scripts/c22/c22.rpy:2777
translate german c22s004_ScarlettReveal_8b2c2551:

    # deb "¿Y yo?"
    deb "Ich auch?"

# game/scripts/c22/c22.rpy:2778
translate german c22s004_ScarlettReveal_24fa0bb8:

    # dap "Quédate ahí, [deb.nick]."
    dap "Bleib da, [deb.nick]."

# game/scripts/c22/c22.rpy:2779
translate german c22s004_ScarlettReveal_e03fa16b:

    # nor "¿Qué hago yo, cielo?"
    nor "Was soll ich tun, Schatz?"

# game/scripts/c22/c22.rpy:2780
translate german c22s004_ScarlettReveal_02898e54:

    # dap "Intercámbiate el sitio con Tía [bet]. Necesito que ella esté al lado de la abuela."
    dap "Tausche die Plätze mit Tante [bet]. Ich brauche sie neben Oma."

# game/scripts/c22/c22.rpy:2782
translate german c22s004_ScarlettReveal_62d94582:

    # bet "¿Es necesario todo esto?"
    bet "Ist das alles notwendig?"

# game/scripts/c22/c22.rpy:2784
translate german c22s004_ScarlettReveal_a41ad14a:

    # dap "Sí, Tía [bet]. Es necesario."
    dap "Ja, Tante [bet]. Es ist notwendig."

# game/scripts/c22/c22.rpy:2785
translate german c22s004_ScarlettReveal_7bf9841a:

    # dap "A ver, [emm], ponte al lado libre de [ama]."
    dap "Okay, [emm], stell dich neben [ama]."

# game/scripts/c22/c22.rpy:2786
translate german c22s004_ScarlettReveal_b0c81fc9:

    # dap "[lis], tu ponte con [deb.nick]."
    dap "[lis], du verwendest [deb.nick]."

# game/scripts/c22/c22.rpy:2787
translate german c22s004_ScarlettReveal_4036b5bd:

    # mc "¿Dónde me pongo yo?"
    mc "Wo stehe ich?"

# game/scripts/c22/c22.rpy:2789
translate german c22s004_ScarlettReveal_6838a9a8:

    # dap "Tú ponte al lado de [emm]."
    dap "Du stehst neben [emm]."

# game/scripts/c22/c22.rpy:2790
translate german c22s004_ScarlettReveal_e01423d2:

    # mc "OK."
    mc "OK."

# game/scripts/c22/c22.rpy:2791
translate german c22s004_ScarlettReveal_f99c8f11:

    # dap "[sca], tú quédate ahí, donde estás."
    dap "[sca], du bleibst dort, wo du bist."

# game/scripts/c22/c22.rpy:2792
translate german c22s004_ScarlettReveal_5c2acc69:

    # dap "Ahora me pongo yo al lado de [eri] y ya está todo."
    dap "Jetzt stelle ich mich neben [eri] und das war's."

# game/scripts/c22/c22.rpy:2794
translate german c22s004_ScarlettReveal_5d1330bb:

    # dap "No sé si os habéis dado cuenta, pero os he puesto por parejas de hermanas, o más o menos."
    dap "Ich weiß nicht, ob es dir aufgefallen ist, aber ich habe euch in Zweiergruppen von Schwestern eingeteilt, oder mehr oder weniger."

# game/scripts/c22/c22.rpy:2797
translate german c22s004_ScarlettReveal_8455646d:

    # "[mar] te mira inquisitivamente."
    "[mar] schaut dich neugierig an."

# game/scripts/c22/c22.rpy:2799
translate german c22s004_ScarlettReveal_c95b64af:

    # "Asientes."
    "Du nickst."

# game/scripts/c22/c22.rpy:2801
translate german c22s004_ScarlettReveal_61f31f30:

    # "Niegas con la cabeza."
    "Du schüttelst den Kopf."

# game/scripts/c22/c22.rpy:2803
translate german c22s004_ScarlettReveal_5fcd9831:

    # dap "La abuela y Tía [bet]."
    dap "Oma und Tante [bet]."

# game/scripts/c22/c22.rpy:2805
translate german c22s004_ScarlettReveal_0ba93bc0:

    # dap "[deb.nick] y [lis]."
    dap "[deb.nick] und [lis]."

# game/scripts/c22/c22.rpy:2808
translate german c22s004_ScarlettReveal_2bf0201f:

    # dap "Mi madre y Tía [mar]."
    dap "Meine Mutter und meine Tante [mar]."

# game/scripts/c22/c22.rpy:2810
translate german c22s004_ScarlettReveal_19e7605e:

    # dap "Y aquí viene lo complicado..."
    dap "Und hier wird es kompliziert..."

# game/scripts/c22/c22.rpy:2811
translate german c22s004_ScarlettReveal_92d427bf:

    # dap "[eri] es mi hermana."
    dap "[eri] ist meine Schwester."

# game/scripts/c22/c22.rpy:2813
translate german c22s004_ScarlettReveal_eb474e35:

    # dap "Le pese a quién le pese."
    dap "Ob es den Leuten gefällt oder nicht."

# game/scripts/c22/c22.rpy:2814
translate german c22s004_ScarlettReveal_cff4f32e:

    # dap "Pero, de alguna forma, también lo es [eva], ¿cierto?"
    dap "Aber in gewisser Weise gilt das auch für [eva], nicht wahr?"

# game/scripts/c22/c22.rpy:2815
translate german c22s004_ScarlettReveal_a7d490f9:

    # todas "Cierto."
    todas "WAHR."

# game/scripts/c22/c22.rpy:2817
translate german c22s004_ScarlettReveal_9f2e2f37:

    # dap "¿Alguien cree que [ama] y [eva] no son hermanas?"
    dap "Glaubt irgendjemand, dass [ama] und [eva] keine Schwestern sind?"

# game/scripts/c22/c22.rpy:2818
translate german c22s004_ScarlettReveal_c868fcce:

    # todas "¡No!"
    todas "NEIN!"

# game/scripts/c22/c22.rpy:2820
translate german c22s004_ScarlettReveal_1221d6bd:

    # dap "Pero, igual que podemos considerar que [eva] es mi hermana y la de [eri], [ama] también lo es de [emm], ¿no?"
    dap "Aber so wie wir [eva] als meine Schwester und die Schwester von [eri] betrachten können, ist [ama] auch die Schwester von [emm], richtig?"

# game/scripts/c22/c22.rpy:2821
translate german c22s004_ScarlettReveal_592779fe:

    # todas "Por supuesto."
    todas "Natürlich."

# game/scripts/c22/c22.rpy:2823
translate german c22s004_ScarlettReveal_86b512fd:

    # dap "Y, obviamente, [emm] es la hermana de [mc]."
    dap "Und natürlich ist [emm] die Schwester von [mc]."

# game/scripts/c22/c22.rpy:2825
translate german c22s004_ScarlettReveal_23fd13bb:

    # dap "Aunque el día que descubrió que no compartían ADN renegase de ello..."
    dap "Obwohl er es an dem Tag, als er herausfand, dass sie keine gemeinsame DNA hatten, noch leugnete..."

# game/scripts/c22/c22.rpy:2827
translate german c22s004_ScarlettReveal_29cbc3b3:

    # emm "¡Hey! ¡Fue un momento de ofuscación! Sabes que nunca renunciaría a ti como hermano."
    emm "Hey! Das war ein kurzer Moment der Verwirrung! Du weißt doch, dass ich dich niemals als Bruder aufgeben würde."

# game/scripts/c22/c22.rpy:2829
translate german c22s004_ScarlettReveal_f0b6dd30:

    # dap "Bueno, a lo que iba... creo que sólo nos faltan [sim] y [jam], pero no les iba a hacer venir para esto."
    dap "Also, was ich eigentlich sagen wollte, ist... Ich glaube, uns fehlen nur noch [sim] und [jam], aber ich wollte sie nicht extra hierherholen."

# game/scripts/c22/c22.rpy:2830
translate german c22s004_ScarlettReveal_74743c16:

    # dap "Lo que quiero decir, es que esta familia cada día es más rara."
    dap "Ich meine damit, dass diese Familie von Tag zu Tag seltsamer wird."

# game/scripts/c22/c22.rpy:2831
translate german c22s004_ScarlettReveal_b3b94564:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c22/c22.rpy:2833
translate german c22s004_ScarlettReveal_a207aab1:

    # lis "Estoy de acuerdo. Me sorprendió la primera vez que llamé Tía [bet] a... Tía [bet]."
    lis "Ich stimme zu. Ich war überrascht, als ich Tante [bet] zum ersten Mal anrief... Tante [bet]."

# game/scripts/c22/c22.rpy:2834
translate german c22s004_ScarlettReveal_214642ab:

    # lis "Ahora ya no puedo pensar en ella de otra forma. No me sale decir sólo [bet]."
    lis "Ich kann sie mir jetzt gar nicht mehr anders vorstellen. Ich kann nicht einfach [bet] sagen."

# game/scripts/c22/c22.rpy:2836
translate german c22s004_ScarlettReveal_7063adb8:

    # nor "Y [oma] ha empezado a llamar Yaya [mee] a mi madre. *Risa*"
    nor "Und er nennt meine Mutter jetzt Yaya. *lacht*"

# game/scripts/c22/c22.rpy:2838
translate german c22s004_ScarlettReveal_d28f6c3e:

    # deb "Y no es la única. *Risa*"
    deb "Und sie ist nicht die Einzige. *lacht*"

# game/scripts/c22/c22.rpy:2842
translate german c22s004_ScarlettReveal_0bccb743:

    # "[sca], obviamente, sabe lo que está haciendo [dap] y está ansiosa por que llegue la revelación."
    "[sca] weiß offensichtlich, was sie tut [dap] und ist gespannt auf die bevorstehende Enthüllung."

# game/scripts/c22/c22.rpy:2845
translate german c22s004_ScarlettReveal_86f45f67:

    # "[sca] está tan perdida como tú, sin saber que se propone [dap]. Si el resultado hubiera sido diferente, lo entenderíais, pero ahora..."
    "[sca] ist genauso ratlos wie du und ahnt nicht, dass [dap] vorgeschlagen wird. Wäre das Ergebnis anders gewesen, würdest du es verstehen, aber jetzt..."

# game/scripts/c22/c22.rpy:2848
translate german c22s004_ScarlettReveal_4fb68c89:

    # "[sca] está tan perdida como tú, sin saber que se propone [dap]. Se ha quedado apartada sin saber qué pinta aquí..."
    "[sca] ist genauso ratlos wie du und ahnt nichts von dem, was vorgeschlagen wird, [dap]. Sie wurde außen vor gelassen und weiß nicht, was sie hier soll..."

# game/scripts/c22/c22.rpy:2849
translate german c22s004_ScarlettReveal_14d5e535:

    # "Crees que nadie sabe qué se propone [dap]."
    "Du glaubst, niemand weiß, was vorgeschlagen wird [dap]."

# game/scripts/c22/c22.rpy:2851
translate german c22s004_ScarlettReveal_fd5b9862:

    # dap "Bueno, pues quería hacer esto para dar la bienvenida a la familia a algunas de las nuevas hermanas."
    dap "Ich wollte das tun, um einige der neuen Schwestern in der Familie willkommen zu heißen."

# game/scripts/c22/c22.rpy:2852
translate german c22s004_ScarlettReveal_85d97a61:

    # dap "Bienvenidas, [eva] y [ama]. Os dimos la bienvenida como individuos, ahora lo hacemos como pareja de hermanas."
    dap "Willkommen, [eva] und [ama]. Wir haben euch als Einzelpersonen begrüßt, nun begrüßen wir euch als Schwesternpaar."

# game/scripts/c22/c22.rpy:2854
translate german c22s004_ScarlettReveal_f2ecf6ea:

    # ama "Gracias, [dap]."
    ama "Vielen Dank, [dap]."

# game/scripts/c22/c22.rpy:2855
translate german c22s004_ScarlettReveal_38ba4e6d:

    # eva "Gracias, supongo... No, no supongo. Gracias, [dap]"
    eva "Danke, nehme ich an... Nein, ich schätze nicht. Danke, [dap]"

# game/scripts/c22/c22.rpy:2857
translate german c22s004_ScarlettReveal_ef2830a7:

    # emm "*Susurrando* Le está quedando un poco cursi, ¿no? Bonito, pero cursi."
    emm "*Flüsternd* Es wird langsam ein bisschen kitschig, nicht wahr? Nett, aber kitschig."

# game/scripts/c22/c22.rpy:2858
translate german c22s004_ScarlettReveal_ea32c771:

    # mc "*Susurrando* Calla y escucha."
    mc "*Flüsternd* Sei still und hör zu."

# game/scripts/c22/c22.rpy:2860
translate german c22s004_ScarlettReveal_15bcca91:

    # dap "También os quiero dar la bienvenida a vosotras, [lis] y [deb.nick]."
    dap "Ich möchte auch Sie, [lis] und [deb.nick], herzlich willkommen heißen."

# game/scripts/c22/c22.rpy:2861
translate german c22s004_ScarlettReveal_67338741:

    # dap "Ya casi os considero unas primas reencontradas."
    dap "Ich betrachte euch zwei fast als wiedervereinigte Cousins."

# game/scripts/c22/c22.rpy:2863
translate german c22s004_ScarlettReveal_6c541dee:

    # deb "Gracias, [dap], es una familia maravillosa."
    deb "Vielen Dank, [dap], es ist eine wundervolle Familie."

# game/scripts/c22/c22.rpy:2864
translate german c22s004_ScarlettReveal_118e1bf7:

    # lis "Lo mismo digo, [dap]."
    lis "Ich stimme zu, [dap]."

# game/scripts/c22/c22.rpy:2866
translate german c22s004_ScarlettReveal_933d324a:

    # dap "Y, como soy idiota, me he olvidado de algo..."
    dap "Und, weil ich so ein Idiot bin, habe ich etwas vergessen..."

# game/scripts/c22/c22.rpy:2869
translate german c22s004_ScarlettReveal_9eafdbc0:

    # dap "Ocupa tu lugar, [sca]."
    dap "Nimm deinen Platz ein, [sca]."

# game/scripts/c22/c22.rpy:2872
translate german c22s004_ScarlettReveal_4b8bd33d:

    # dap "Ven a mi lado, [sca]."
    dap "Komm an meine Seite, [sca]."

# game/scripts/c22/c22.rpy:2878
translate german c22s004_ScaPatch_ae866916:

    # "[sca] se dirige hacia ti y [emm]. Te apartas para dejarle un hueco entre ambos, que ocupa para sorpresa de todo el mundo."
    "[sca] kommt auf dich und [emm] zu. Du gehst zur Seite, um Platz zwischen euch zu schaffen, den er zur Überraschung aller einnimmt."

# game/scripts/c22/c22.rpy:2880
translate german c22s004_ScaPatch_21c2e29a:

    # todas "{b}¿QUÉ?{/b}"
    todas "{b}WAS?{/b}"

# game/scripts/c22/c22.rpy:2881
translate german c22s004_ScaPatch_c1e2b664:

    # "Tan solo [mar] evita la cara de sorpresa."
    "Nur [mar] vermeidet den überraschten Gesichtsausdruck."

# game/scripts/c22/c22.rpy:2882
translate german c22s004_ScaPatch_06b5d63f:

    # "[ama] y [eva] sabían que buscabas a una hermana, pero no sabían quién era."
    "[ama] und [eva] wussten, dass du nach einer Schwester suchtest, aber sie wussten nicht, wer sie war."

# game/scripts/c22/c22.rpy:2884
translate german c22s004_ScaPatch_cc30ddd6:

    # "[dap] ignora la pregunta que está en la boca de casi todas las mujeres y sigue hablando como si nada hubiera pasado."
    "[dap] ignoriert die Frage, die fast jeder Frau auf den Lippen liegt, und redet weiter, als wäre nichts geschehen."

# game/scripts/c22/c22.rpy:2885
translate german c22s004_ScaPatch_27fe9f16:

    # dap "Bienvenida oficialmente a la familia, [sca]. Ahora eres una Marks de pleno derecho."
    dap "Herzlich willkommen in der Familie, [sca]. Du bist jetzt ein vollwertiges Mitglied der Marks-Familie."

# game/scripts/c22/c22.rpy:2887
translate german c22s004_ScaPatch_cad353ae:

    # mom "Ven aquí, cielo."
    mom "Komm her, meine Liebe."

# game/scripts/c22/c22.rpy:2888
translate german c22s004_ScaPatch_cc349d22:

    # "[mar] se acerca a [sca], ignorando las caras de sorpresa del resto de mujeres, y se funde en un abrazo con la chica a medio camino."
    "[mar] nähert sich [sca], ignoriert die überraschten Gesichter der anderen Frauen und geht auf halbem Weg in eine Umarmung mit dem Mädchen über."

# game/scripts/c22/c22.rpy:2889
translate german c22s004_ScaPatch_5409146d:

    # mom "Bienvenida a la familia, cariño."
    mom "Willkommen in der Familie, Liebling."

# game/scripts/c22/c22.rpy:2891
translate german c22s004_ScaPatch_6d953712:

    # mee "¿Qué está pasando aquí?"
    mee "Was ist hier los?"

# game/scripts/c22/c22.rpy:2893
translate german c22s004_ScaPatch_f3b02d0c:

    # "[dap] decide pasar a un segundo plano. Ella ha puesto los cimientos para esta situación."
    "[dap] beschließt, sich zurückzuziehen. Sie hat die Voraussetzungen für diese Situation geschaffen."

# game/scripts/c22/c22.rpy:2894
translate german c22s004_ScaPatch_bd0c6666:

    # "Pero contar la verdad podría ser muy humillante para [mar]. No es algo a lo que tenga derecho."
    "Doch die Wahrheit zu sagen, könnte für [mar] sehr demütigend sein. Dazu hat sie kein Recht."

# game/scripts/c22/c22.rpy:2896
translate german c22s004_ScaPatch_a6a34926:

    # "[sca] está demasiado abrumada para hablar. El desarrollo del \"experimento de [dap]\" la ha dejado con las emociones a flor de piel."
    "[sca] ist zu überwältigt, um zu sprechen. Die Ereignisse des \"[dap]-Experiments\" haben sie emotional sehr aufgewühlt."

# game/scripts/c22/c22.rpy:2897
translate german c22s004_ScaPatch_187b6314:

    # "Tú tampoco puedes dar las explicaciones por las mismas razones que [dap]. Te alegras de haber tenido la conversación con [mar] por la mañana."
    "Auch du kannst keine Erklärungen abgeben, aus denselben Gründen wie [dap]. Du bist froh, dass du heute Morgen das Gespräch mit [mar] geführt hast."

# game/scripts/c22/c22.rpy:2899
translate german c22s004_ScaPatch_b6bed2ee:

    # mar "[sca] es la hija de Edmund. Me engañó hace años y este es el resultado."
    mar "[sca] ist Edmunds Tochter. Er hat mich vor Jahren hereingelegt, und das ist das Ergebnis."

# game/scripts/c22/c22.rpy:2901
translate german c22s004_ScaPatch_c322422b:

    # todas "¿QUÉ?"
    todas "DAS?"

# game/scripts/c22/c22.rpy:2903
translate german c22s004_ScaPatch_cdf1519b:

    # mar "Sí, lleva años siendo un cabrón, por lo visto, pero..."
    mar "Ja, er ist offenbar schon seit Jahren ein Mistkerl, aber..."

# game/scripts/c22/c22.rpy:2904
translate german c22s004_ScaPatch_82f9c8e3:

    # mar "No creía que pudiera pensar esto, pero [sca] es un regalo que ha llegado a casa con retraso, aunque lo hemos tenido delante todos estos años."
    mar "Ich hätte nicht gedacht, dass ich das denken könnte, aber [sca] ist ein Geschenk, das erst spät nach Hause gekommen ist, obwohl wir es all die Jahre vor Augen hatten."

# game/scripts/c22/c22.rpy:2906
translate german c22s004_ScaPatch_75d74da8:

    # mar "Cielo, no eres mi hija, pero... ¿me permitirías ejercer de madre?"
    mar "Schatz, du bist zwar nicht meine Tochter, aber... würdest du mir erlauben, deine Mutterrolle zu übernehmen?"

# game/scripts/c22/c22.rpy:2907
translate german c22s004_ScaPatch_f7b54a42:

    # sca "No podría tener una madre mejor, [mar]."
    sca "Ich könnte mir keine bessere Mutter wünschen, [mar]."

# game/scripts/c22/c22.rpy:2909
translate german c22s004_ScaPatch_c9c66e1d:

    # emm "¿Puedo abrazar a mi nueva hermana?"
    emm "Darf ich meine neue Schwester umarmen?"

# game/scripts/c22/c22.rpy:2911
translate german c22s004_ScaPatch_48d5b831:

    # emm "Dos hermanas nuevas en una semana. Al final me voy a hacer un lío..."
    emm "Zwei neue Schwestern in einer Woche. Ich werde völlig durcheinander sein..."

# game/scripts/c22/c22.rpy:2912
translate german c22s004_ScaPatch_2d7e9c6d:

    # emm "Bienvenida a casa, hermanita."
    emm "Willkommen zu Hause, kleine Schwester."

# game/scripts/c22/c22.rpy:2913
translate german c22s004_ScaPatch_c051dd51:

    # sca "Gracias, [emm]. Me alegra muchísimo que seas mi hermana."
    sca "Danke, [emm]. Ich bin so froh, dass du meine Schwester bist."

# game/scripts/c22/c22.rpy:2915
translate german c22s004_ScaPatch_64313a6f:

    # "El resto os vais turnando para abrazar a [sca]. Dándole la bienvenida a la familia."
    "Die anderen umarmen nacheinander [sca] und heißen ihn so in der Familie willkommen."

# game/scripts/c22/c22.rpy:2917
translate german c22s004_ScaPatch_08a6e81d:

    # "Sienta tan bien quitarse los secretos de encima..."
    "Es fühlt sich so gut an, all seine Geheimnisse loszuwerden..."

# game/scripts/c22/c22.rpy:2918
translate german c22s004_ScaPatch_a6c1761f:

    # "[dap] envía un mensaje al grupo de WhatsUp mientras el resto de las chicas acaban de abrazar a [sca]."
    "[dap] sendet eine Nachricht an die WhatsUp-Gruppe, während die anderen Mädchen gerade [sca] umarmt haben."

# game/scripts/c22/c22.rpy:2919
translate german c22s004_ScaPatch_adfcbf79:

    # "El resto de la familia también tiene derecho a saber la verdad."
    "Auch die übrigen Familienmitglieder haben das Recht, die Wahrheit zu erfahren."

# game/scripts/c22/c22.rpy:2925
translate german c22s004_ScaUnPatch_92dacd4e:

    # sca "¿Qué?"
    sca "Das?"

# game/scripts/c22/c22.rpy:2927
translate german c22s004_ScaUnPatch_3cf8b728:

    # dap "Ven aquí. *Risa* Parezco una gaviota idiota con el ala levantada."
    dap "Komm her. *lacht* Ich sehe aus wie eine blöde Möwe mit erhobenem Flügel."

# game/scripts/c22/c22.rpy:2929
translate german c22s004_ScaUnPatch_c1a59b8a:

    # sca "*Susurrando* ¿De qué va esto?"
    sca "*Flüsternd* Worum geht es hier eigentlich?"

# game/scripts/c22/c22.rpy:2930
translate german c22s004_ScaUnPatch_87041c3e:

    # dap "Calla y escucha."
    dap "Sei still und hör zu."

# game/scripts/c22/c22.rpy:2933
translate german c22s004_ScaUnPatch_4951328c:

    # dap "Os habéis dado cuenta de que, menos con [lis] y [deb.nick], y con Tía [bet] y la abuela, el resto de las parejas de hermanos no lo son de sangre, ¿verdad?"
    dap "Sie haben sicher bemerkt, dass außer [lis] und [deb.nick] sowie Tante [bet] und Oma die übrigen Geschwisterpaare nicht blutsverwandt sind, richtig?"

# game/scripts/c22/c22.rpy:2935
translate german c22s004_ScaUnPatch_03e2ab71:

    # dap "Os habéis dado cuenta con los ejemplos de [eva] y [ama] de que no es necesario compartir genes para ser hermanas."
    dap "Anhand der Beispiele von [eva] und [ama] haben Sie erkannt, dass es nicht notwendig ist, Gene zu teilen, um Schwestern zu sein."

# game/scripts/c22/c22.rpy:2936
translate german c22s004_ScaUnPatch_90b541cb:

    # todas "Sí."
    todas "Ja."

# game/scripts/c22/c22.rpy:2939
translate german c22s004_ScaUnPatch_d42c5c3b:

    # dap "He estado hablando estos días con mi madre sobre nuestro parentesco legal."
    dap "Ich habe in den letzten Tagen mit meiner Mutter über unsere rechtliche Elternschaft gesprochen."

# game/scripts/c22/c22.rpy:2940
translate german c22s004_ScaUnPatch_ccc4a29c:

    # dap "Ni siquiera soy adoptada. Ni siquiera es mi madre legalmente."
    dap "Ich bin nicht einmal adoptiert. Sie ist nicht einmal meine rechtliche Mutter."

# game/scripts/c22/c22.rpy:2941
translate german c22s004_ScaUnPatch_8c7306ee:

    # dap "¿Alguien pone en duda que [nor] sea mi madre?"
    dap "Zweifelt irgendjemand daran, dass [nor] meine Mutter ist?"

# game/scripts/c22/c22.rpy:2943
translate german c22s004_ScaUnPatch_664969f4:

    # dap "Pero nadie duda de que sean hermanas. O de que [eva] sea mi hermana."
    dap "Aber niemand zweifelt daran, dass sie Schwestern sind. Oder dass [eva] meine Schwester ist."

# game/scripts/c22/c22.rpy:2944
translate german c22s004_ScaUnPatch_c425aa82:

    # todas "No."
    todas "NEIN."

# game/scripts/c22/c22.rpy:2947
translate german c22s004_ScaUnPatch_4e4e916b:

    # mee "Yo lo hice durante años. Ya no."
    mee "Ich habe es jahrelang getan. Jetzt nicht mehr."

# game/scripts/c22/c22.rpy:2949
translate german c22s004_ScaUnPatch_29c985f9:

    # mee "Es tu hermana y es mi nieta perdida."
    mee "Sie ist deine Schwester und sie ist meine lange verschollene Enkelin."

# game/scripts/c22/c22.rpy:2952
translate german c22s004_ScaUnPatch_17168897:

    # dap "Bien, Abuela. ¿O debería decir \"Sra. Que Se Hace Pasar Por Mi Abuela\"?"
    dap "Okay, Oma. Oder sollte ich sagen: „Frau, die vorgibt, meine Oma zu sein“?"

# game/scripts/c22/c22.rpy:2954
translate german c22s004_ScaUnPatch_951671e8:

    # dap "Bien, Abuela. ¿O debería decir \"Sra. Que Se Hace Pasar Por La Abuela de [eva] y [ama]\"?"
    dap "Okay, Oma. Oder sollte ich sagen: „Frau, die vorgibt, die Oma von [eva] und [ama] zu sein“?"

# game/scripts/c22/c22.rpy:2957
translate german c22s004_ScaUnPatch_a698cdd3:

    # mee "*Risa* Ni se te ocurra. Soy tu abuela te guste o no."
    mee "*Lacht* Denk gar nicht erst dran. Ich bin deine Großmutter, ob es dir passt oder nicht."

# game/scripts/c22/c22.rpy:2959
translate german c22s004_ScaUnPatch_ea73dd64:

    # mee "*Risa* Ni se te ocurra. Soy su abuela les guste o no."
    mee "*Lacht* Denk gar nicht erst dran. Ich bin ihre Großmutter, ob es ihnen passt oder nicht."

# game/scripts/c22/c22.rpy:2960
translate german c22s004_ScaUnPatch_4a7779fa:

    # mee "Y, si quieren, también puedo serlo para cualquier chica que necesite una abuela."
    mee "Und wenn Sie möchten, kann ich auch für jedes Mädchen da sein, das eine Großmutter braucht."

# game/scripts/c22/c22.rpy:2961
translate german c22s004_ScaUnPatch_c8ee8ea5:

    # mee "No hago galletas, por cierto."
    mee "Ich backe übrigens keine Kekse."

# game/scripts/c22/c22.rpy:2962
translate german c22s004_ScaUnPatch_b3b94564:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c22/c22.rpy:2964
translate german c22s004_ScaUnPatch_550ac64e:

    # dap "¿Puedo continuar? Gracias."
    dap "Darf ich fortfahren? Danke."

# game/scripts/c22/c22.rpy:2965
translate german c22s004_ScaUnPatch_ff63ea89:

    # dap "A lo que me refiero es a que esta familia es rara. Se ha creado a través de mentiras, secretos, y clonaciones."
    dap "Ich meine damit, dass diese Familie seltsam ist. Sie entstand durch Lügen, Geheimnisse und Klonen."

# game/scripts/c22/c22.rpy:2966
translate german c22s004_ScaUnPatch_797171cd:

    # dap "¿Pero alguien duda de que sea una familia?"
    dap "Aber zweifelt irgendjemand daran, dass sie eine Familie sind?"

# game/scripts/c22/c22.rpy:2967
translate german c22s004_ScaUnPatch_c425aa82_1:

    # todas "No."
    todas "NEIN."

# game/scripts/c22/c22.rpy:2969
translate german c22s004_ScaUnPatch_90cb866e:

    # deb "Es una familia increíble, [dap]. Los lazos de sangre importan menos que la voluntad de ser una familia."
    deb "Es ist eine außergewöhnliche Familie. Blutsbande sind weniger wichtig als der Wille, eine Familie zu sein."

# game/scripts/c22/c22.rpy:2970
translate german c22s004_ScaUnPatch_1f3ae072:

    # lis "Si leyera esto en un libro, no me lo creería. Vivirlo es totalmente diferente."
    lis "Wenn ich das in einem Buch lesen würde, würde ich es nicht glauben. Es selbst zu erleben, ist etwas ganz anderes."

# game/scripts/c22/c22.rpy:2972
translate german c22s004_ScaUnPatch_fb14b4c6:

    # dap "Eso es exactamente lo que quiero decir."
    dap "Das ist genau das, was ich meine."

# game/scripts/c22/c22.rpy:2973
translate german c22s004_ScaUnPatch_4901efbe:

    # dap "Me da lo mismo lo que piense la gente de fuera de la familia."
    dap "Mir ist egal, was Leute außerhalb der Familie denken."

# game/scripts/c22/c22.rpy:2974
translate german c22s004_ScaUnPatch_b487daa7:

    # dap "Me da lo mismo lo que digan las leyes."
    dap "Mir ist egal, was die Gesetze sagen."

# game/scripts/c22/c22.rpy:2977
translate german c22s004_ScaUnPatch_49550204:

    # dap "Si [nor] es mi madre porque elegimos que lo sea..."
    dap "Wenn [nor] meine Mutter ist, weil wir sie dazu auserwählt haben..."

# game/scripts/c22/c22.rpy:2978
translate german c22s004_ScaUnPatch_d8503a7a:

    # dap "Si [mee] es mi abuela porque así lo hemos decidido..."
    dap "Wenn [mee] meine Großmutter ist, weil wir das so beschlossen haben..."

# game/scripts/c22/c22.rpy:2980
translate german c22s004_ScaUnPatch_36b275d9:

    # dap "Si [ama] y [eva] son de la familia porque elegimos que lo sean..."
    dap "Wenn [ama] und [eva] eine Familie sind, weil wir sie dazu bestimmt haben..."

# game/scripts/c22/c22.rpy:2981
translate german c22s004_ScaUnPatch_dc19810b:

    # dap "Si la abuela es también su abuela porque así lo han decidido..."
    dap "Wenn die Großmutter auch deshalb ihre Großmutter ist, weil sie das so entschieden haben..."

# game/scripts/c22/c22.rpy:2982
translate german c22s004_ScaUnPatch_35ae7fab:

    # mc "Y porque si no, seguramente sí que nos haría esas galletas y nos obligaría a comerlas como tortura."
    mc "Denn sonst würde er uns diese Kekse bestimmt backen und uns zur Folter zwingen, sie zu essen."

# game/scripts/c22/c22.rpy:2983
translate german c22s004_ScaUnPatch_b3b94564_1:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c22/c22.rpy:2985
translate german c22s004_ScaUnPatch_8364dc4d:

    # dap "Bueno, pues una vez establecida la premisa..."
    dap "Nun, sobald diese Prämisse etabliert ist..."

# game/scripts/c22/c22.rpy:2986
translate german c22s004_ScaUnPatch_6998dd2e:

    # dap "He decidido que [sca] es mi hermana."
    dap "Ich habe beschlossen, dass [sca] meine Schwester ist."

# game/scripts/c22/c22.rpy:2988
translate german c22s004_ScaUnPatch_9d49d5cf:

    # dap "Joder, me ha quedado totalmente anticlimático con tantas interrupciones."
    dap "Verdammt, das Ganze ist durch die vielen Unterbrechungen total enttäuschend geworden."

# game/scripts/c22/c22.rpy:2990
translate german c22s004_ScaUnPatch_7dbc2656:

    # mee "¡Ese lenguaje, señorita! Como tu abuela no te dejo usarlo."
    mee "Diese Ausdrucksweise, junge Dame! Wie Ihre Großmutter erlaube ich Ihnen nicht, sie zu benutzen."

# game/scripts/c22/c22.rpy:2991
translate german c22s004_ScaUnPatch_b3b94564_2:

    # todas "*Risa*"
    todas "*Lachen*"

# game/scripts/c22/c22.rpy:2992
translate german c22s004_ScaUnPatch_f994bd47:

    # mee "Y a ti tampoco, [sca], antes de que preguntes. Quiero que mis nietas hablen como señoritas bien educadas."
    mee "Und du auch nicht, [sca], bevor du fragst. Ich möchte, dass meine Enkelinnen wie wohlerzogene junge Damen sprechen."

# game/scripts/c22/c22.rpy:2994
translate german c22s004_ScaUnPatch_4ebbfbb7:

    # sca "..."
    sca "..."

# game/scripts/c22/c22.rpy:2996
translate german c22s004_ScaUnPatch_490df30a:

    # sca "Gracias, [dap.nick]..."
    sca "Vielen Dank, [dap.nick]..."

# game/scripts/c22/c22.rpy:2997
translate german c22s004_ScaUnPatch_1504d153:

    # dap "Es lo menos que podía hacer. Sabes que te considero mi hermana. Ahora lo saben todos."
    dap "Das ist das Mindeste, was ich tun konnte. Du weißt, dass ich dich als meine Schwester betrachte. Jetzt weiß es jeder."

# game/scripts/c22/c22.rpy:2999
translate german c22s004_ScaUnPatch_61677265:

    # eri "[dap], ¿puedes dejar de monopolizar a mi hermana? Yo también quiero abrazarla."
    eri "[dap], kannst du bitte aufhören, meine Schwester für dich zu beanspruchen? Ich möchte sie auch umarmen."

# game/scripts/c22/c22.rpy:3001
translate german c22s004_ScaUnPatch_b4b3c095:

    # sca "Me vais a hacer llorar..."
    sca "Du bringst mich noch zum Weinen..."

# game/scripts/c22/c22.rpy:3002
translate german c22s004_ScaUnPatch_d31d2ea0:

    # eri "Yo llevaría un rato llorando. Ya sabes que soy muy llorona, y lo que ha dicho [dap] es muy bonito."
    eri "Ich würde eine Weile weinen. Du weißt ja, dass ich eine richtige Heulsuse bin, und was [dap] gesagt hat, war wirklich lieb."

# game/scripts/c22/c22.rpy:3004
translate german c22s004_ScaUnPatch_b851f5fa:

    # "El resto os vais turnando para abrazar a [sca]. Todas dicen algo que la hace sentir querida."
    "Die anderen umarmen nacheinander [sca]. Jeder sagt etwas, wodurch sie sich geliebt fühlt."

# game/scripts/c22/c22.rpy:3006
translate german c22s004_ScaUnPatch_923f197c:

    # "[sca] ha pasado de tener una madre de mierda a tener dos madres y dos abuelas maravillosas. Y un montón de hermanas."
    "[sca] hatte erst eine schreckliche Mutter, jetzt hat sie zwei Mütter und zwei wundervolle Großmütter. Und dazu noch eine ganze Menge Schwestern."

# game/scripts/c22/c22.rpy:3009
translate german c22s004_hugs_d8a24664:

    # "La escena te recuerda mucho a la fiesta de la piscina, cuando [mee] contó su secreto sobre el cáncer."
    "Die Szene erinnert sehr an die Poolparty, als [mee] ihr Geheimnis über ihre Krebserkrankung enthüllte."

# game/scripts/c22/c22.rpy:3010
translate german c22s004_hugs_5dc73603:

    # "No podrías estar más orgulloso de tu familia."
    "Du könntest nicht stolzer auf deine Familie sein."

# game/scripts/c22/c22.rpy:3019
translate german c22s004_BetCallsBishop_bea50ff2:

    # bet "Lo que pasa en esta familia es increíble."
    bet "Was in dieser Familie vor sich geht, ist unglaublich."

# game/scripts/c22/c22.rpy:3020
translate german c22s004_BetCallsBishop_9ef0ffa9:

    # mc "Pero es para sentirse orgulloso de formar parte de ella."
    mc "Aber es ist etwas, worauf man stolz sein kann, ein Teil davon zu sein."

# game/scripts/c22/c22.rpy:3021
translate german c22s004_BetCallsBishop_2e68811e:

    # mc "El día menos pensado, pasará un perro callejero por delante de casa y le diremos \"Tú también eres de la familia\"."
    mc "Eines Tages wird völlig unerwartet ein streunender Hund an unserem Haus vorbeilaufen und wir werden zu ihm sagen: „Du gehörst auch zur Familie.“"

# game/scripts/c22/c22.rpy:3022
translate german c22s004_BetCallsBishop_c0d47adb:

    # mc "Y que conste que no estoy comparando a [sca] con un perro callejero. Se merece formar parte de esta familia."
    mc "Und ich möchte klarstellen, dass ich [sca] nicht mit einem streunenden Hund vergleiche. Er hat es verdient, Teil dieser Familie zu sein."

# game/scripts/c22/c22.rpy:3025
translate german c22s004_BetCallsBishop_dea11c03:

    # bet "Claro que sí. Es tu hermana. Y aunque no lo fuera, esa chica es adorable y necesita una familia que la quiera."
    bet "Natürlich ist sie das. Sie ist deine Schwester. Und selbst wenn sie es nicht wäre, ist dieses Mädchen bezaubernd und braucht eine Familie, die sie liebt."

# game/scripts/c22/c22.rpy:3026
translate german c22s004_BetCallsBishop_13dcbbbf:

    # mc "Sí, es sorprendente lo adorable que es con la mierda de padres que tiene."
    mc "Ja, es ist überraschend, wie liebenswert er ist, wenn man bedenkt, was für beschissene Eltern er hat."

# game/scripts/c22/c22.rpy:3028
translate german c22s004_BetCallsBishop_32aaa9c5:

    # bet "Claro que sí. Es una chica adorable y necesita una familia que la quiera."
    bet "Natürlich. Sie ist ein liebes Mädchen und braucht eine liebevolle Familie."

# game/scripts/c22/c22.rpy:3029
translate german c22s004_BetCallsBishop_65e9f4b0:

    # mc "Sí, es sorprendente lo adorable que es con la madre que tiene."
    mc "Ja, es ist erstaunlich, wie liebenswert er mit seiner Mutter ist."

# game/scripts/c22/c22.rpy:3031
translate german c22s004_BetCallsBishop_b53ef1e8:

    # bet "Quería hablar contigo de una cosa..."
    bet "Ich wollte mit dir über etwas sprechen..."

# game/scripts/c22/c22.rpy:3032
translate german c22s004_BetCallsBishop_7ff9267a:

    # mc "Dime. ¿Tiene algo que ver con lo que ha pasado antes?"
    mc "Sag mir. Hat es etwas mit dem zu tun, was vorher passiert ist?"

# game/scripts/c22/c22.rpy:3034
translate german c22s004_BetCallsBishop_6c7ed6f0:

    # bet "No. No quiero hablar de eso."
    bet "Nein. Ich möchte darüber nicht reden."

# game/scripts/c22/c22.rpy:3035
translate german c22s004_BetCallsBishop_8e7ec810:

    # mc "Quitarse los secretos de encima es liberador, [bet]. Y hablar las cosas también."
    mc "Geheimnisse loszuwerden ist befreiend, [bet]. Und darüber zu reden auch."

# game/scripts/c22/c22.rpy:3037
translate german c22s004_BetCallsBishop_9f6bdc68:

    # bet "Es posible, pero hoy no es el día."
    bet "Es ist möglich, aber heute ist nicht der Tag dafür."

# game/scripts/c22/c22.rpy:3038
translate german c22s004_BetCallsBishop_f7a2d776:

    # mc "Como quieras. ¿De qué querías hablar?"
    mc "Ganz wie du willst. Worüber wolltest du sprechen?"

# game/scripts/c22/c22.rpy:3040
translate german c22s004_BetCallsBishop_425ea172:

    # bet "Me han llamado de Monterey después de comer. Tengo una cita con el secretario del obispo el jueves por la tarde."
    bet "Nach dem Mittagessen erhielt ich einen Anruf aus Monterey. Ich habe am Donnerstagnachmittag einen Termin mit dem Sekretär des Bischofs."

# game/scripts/c22/c22.rpy:3041
translate german c22s004_BetCallsBishop_ffceb4d2:

    # bet "¿Crees que me podrías llevar? Si no puedes, puedo ir en autobús."
    bet "Könntest du mich vielleicht mitnehmen? Wenn nicht, kann ich auch den Bus nehmen."

# game/scripts/c22/c22.rpy:3042
translate german c22s004_BetCallsBishop_5692500e:

    # mc "Ningún problema. Voy a intentar mover el alquiler del coche de [emm] para el jueves, y así matamos dos pájaros de un tiro."
    mc "Kein Problem. Ich versuche, den Mietwagen von [emm] auf Donnerstag zu verschieben, dann schlagen wir zwei Fliegen mit einer Klappe."

# game/scripts/c22/c22.rpy:3044
translate german c22s004_BetCallsBishop_b1e9ff19:

    # bet "Gracias, [mc]. Voy a ir a mi habitación, dime algo si no puedes mover lo de [emm], para sacar los billetes de autobús."
    bet "Danke, [mc]. Ich gehe jetzt auf mein Zimmer. Sag mir Bescheid, falls du das [emm]-Ding nicht wegräumen kannst, damit ich die Bustickets holen kann."

# game/scripts/c22/c22.rpy:3045
translate german c22s004_BetCallsBishop_0716effd:

    # mc "No me he explicado bien. Te voy a llevar el jueves sea como sea, aunque tenga que volver el día siguiente con [emm]."
    mc "Ich habe mich nicht klar ausgedrückt. Ich werde dich am Donnerstag auf jeden Fall mitnehmen, auch wenn ich am nächsten Tag mit [emm] wiederkommen muss."

# game/scripts/c22/c22.rpy:3046
translate german c22s004_BetCallsBishop_6435ce3f:

    # mc "No hemos tenido la oportunidad de pasar mucho tiempo juntos, y me parece un buen plan. No voy a dejar que hagas esto sola."
    mc "Wir hatten in letzter Zeit nicht viel Gelegenheit, Zeit miteinander zu verbringen, und das scheint ein guter Plan zu sein. Ich lasse dich das nicht alleine machen."

# game/scripts/c22/c22.rpy:3048
translate german c22s004_BetCallsBishop_c959b3f2:

    # bet "¡Oh! ¡Gracias!"
    bet "Oh! Vielen Dank!"

# game/scripts/c22/c22.rpy:3049
translate german c22s004_BetCallsBishop_6147dd59:

    # mc "Y cuando quieras hablar de lo que ha pasado antes en el baño, avísame."
    mc "Und wenn du über das sprechen möchtest, was vorhin im Badezimmer passiert ist, sag mir Bescheid."

# game/scripts/c22/c22.rpy:3051
translate german c22s004_BetCallsBishop_55d2a73c:

    # bet "Lo haré. Hasta luego."
    bet "Das werde ich. Bis später."

# game/scripts/c22/c22.rpy:3053
translate german c22s004_BetCallsBishop_457d2405:

    # mc "Hasta luego, Tía [bet]."
    mc "Bis später, Tante [bet]."

# game/scripts/c22/c22.rpy:3062
translate german c22s004_MarChat_990cce59:

    # mom "[dap] es increíble. La que ha montado para dar la noticia..."
    mom "[dap] Es ist unglaublich. Was für ein Aufhebens sie gemacht hat, um die Nachricht zu verkünden..."

# game/scripts/c22/c22.rpy:3063
translate german c22s004_MarChat_db580cbd:

    # mc "No creo que fuera una noticia que se tuviera que dar por el grupo de WhatsUp."
    mc "Ich glaube nicht, dass diese Nachricht in der WhatsApp-Gruppe hätte geteilt werden sollen."

# game/scripts/c22/c22.rpy:3064
translate german c22s004_MarChat_900bf22f:

    # mc "Y necesitaba que tú colaboraras."
    mc "Und ich brauchte Ihre Hilfe."

# game/scripts/c22/c22.rpy:3065
translate german c22s004_MarChat_e383d544:

    # mc "Siento que hayas tenido que dar tu parte de la noticia así."
    mc "Es tut mir leid, dass Sie Ihre Version der Geschichte so erzählen mussten."

# game/scripts/c22/c22.rpy:3067
translate german c22s004_MarChat_b0144f15:

    # mom "No te preocupes. He estado pensando en los dos posibles escenarios después de la conversación de esta mañana."
    mom "Keine Sorge. Ich habe nach unserem Gespräch heute Morgen über beide möglichen Szenarien nachgedacht."

# game/scripts/c22/c22.rpy:3068
translate german c22s004_MarChat_0efd60d4:

    # mom "Si no lo hubiéramos hablado, seguramente me hubiera molestado enterarme de que soy una cornuda delante de todo el mundo."
    mom "Hätten wir nicht darüber gesprochen, wäre ich sehr bestürzt gewesen, herauszufinden, dass ich vor allen betrogen wurde."

# game/scripts/c22/c22.rpy:3069
translate german c22s004_MarChat_d2cee307:

    # mc "Pasó hace 19 años..."
    mc "Es geschah vor 19 Jahren..."

# game/scripts/c22/c22.rpy:3071
translate german c22s004_MarChat_ae18a250:

    # mom "Da lo mismo cuando pasara, [mc]."
    mom "Es spielt keine Rolle, wann es passiert ist, [mc]."

# game/scripts/c22/c22.rpy:3072
translate german c22s004_MarChat_263d60c3:

    # mom "Y realmente, me da lo mismo que pasara. Cada vez que pienso en tu padre, no puedo sentir nada que no sea enfado, pero cada vez menos."
    mom "Und ehrlich gesagt ist es mir egal, was passiert ist. Jedes Mal, wenn ich an deinen Vater denke, empfinde ich nur Wut, aber sie lässt immer mehr nach."

# game/scripts/c22/c22.rpy:3073
translate german c22s004_MarChat_56378a29:

    # mc "Está fuera de nuestras vidas, no creo que volvamos a verlo nunca."
    mc "Er ist nun aus unserem Leben verschwunden, ich glaube nicht, dass wir ihn jemals wiedersehen werden."

# game/scripts/c22/c22.rpy:3075
translate german c22s004_MarChat_7f4e4829:

    # mom "Eso me da lo mismo también. No quiero verlo, pero no me derrumbaría si lo hiciera."
    mom "Das ist mir auch egal. Ich will es nicht sehen, aber ich würde auch nicht zusammenbrechen, wenn ich es täte."

# game/scripts/c22/c22.rpy:3076
translate german c22s004_MarChat_6597b47f:

    # mom "Además, nos ha dejado tres bonitos regalos aquí."
    mom "Darüber hinaus hat er uns hier drei schöne Geschenke hinterlassen."

# game/scripts/c22/c22.rpy:3077
translate german c22s004_MarChat_ea5cf2fb:

    # mc "¿Tres? [emm], [sca], y... ¿la camioneta?"
    mc "Drei? [emm], [sca] und... der Lieferwagen?"

# game/scripts/c22/c22.rpy:3079
translate german c22s004_MarChat_841f1ff9:

    # mom "[emm], [sca], y tú, idiota. *Risa*"
    mom "[emm], [sca], und du, Idiot. *lacht*"

# game/scripts/c22/c22.rpy:3080
translate german c22s004_MarChat_dcfd69e5:

    # mc "*Risa* Al decir \"nos ha dejado\" creía que era a ti y a mí, con lo que no me incluía yo."
    mc "*Gelächter* Als du sagtest „er hat uns verlassen“, dachte ich, es bezöge sich auf dich und mich, also war ich nicht eingeschlossen."

# game/scripts/c22/c22.rpy:3081
translate german c22s004_MarChat_29d1e3db:

    # mc "Estoy un poco denso hoy."
    mc "Ich fühle mich heute etwas begriffsstutzig."

# game/scripts/c22/c22.rpy:3083
translate german c22s004_MarChat_e0cab045:

    # mom "*Risa* ¿Sólo hoy?"
    mom "*lacht* Nur heute?"

# game/scripts/c22/c22.rpy:3084
translate german c22s004_MarChat_46ee4d98:

    # mom "Si no te importa, voy a volver con [sca] antes de que la abrumen demasiado."
    mom "Wenn es Ihnen nichts ausmacht, gehe ich jetzt zurück zu [sca], bevor sie zu überfordert ist."

# game/scripts/c22/c22.rpy:3086
translate german c22s004_MarChat_cad6be42:

    # mom "[dap] es increíble. Ha montado todo esto para que [sca] no se sienta mal por cómo ha salido la prueba de ADN."
    mom "[dap] Es ist unglaublich. Sie hat das alles so eingefädelt, dass [sca] sich wegen des Ergebnisses des DNA-Tests nicht schlecht fühlt."

# game/scripts/c22/c22.rpy:3087
translate german c22s004_MarChat_9e3bffda:

    # mc "[sca] se ha decepcionado un poco cuando ha salido negativa. Creo que [dap.nick] lo ha hecho muy bien."
    mc "[sca] war etwas enttäuscht, als das Ergebnis negativ ausfiel. Ich finde, [dap.nick] hat sehr gut abgeschnitten."

# game/scripts/c22/c22.rpy:3089
translate german c22s004_MarChat_11e3ba30:

    # mom "Y nos hemos ahorrado las explicaciones incómodas si la prueba de ADN hubiera salido diferente."
    mom "Und wir haben uns die peinlichen Erklärungen erspart, die nötig gewesen wären, wenn der DNA-Test ein anderes Ergebnis geliefert hätte."

# game/scripts/c22/c22.rpy:3090
translate german c22s004_MarChat_6ed2c569:

    # mc "Sí, y nos toca seguir buscando a su padre y a mi medio-hermana."
    mc "Ja, und wir müssen immer noch nach ihrem Vater und meiner Halbschwester suchen."

# game/scripts/c22/c22.rpy:3092
translate german c22s004_MarChat_ed7f87ed:

    # mom "Esa es la parte más complicada. ¿Tenéis algún hilo del que tirar?"
    mom "Das ist der kniffligste Teil. Haben Sie irgendwelche Anhaltspunkte, denen wir nachgehen können?"

# game/scripts/c22/c22.rpy:3093
translate german c22s004_MarChat_89e8ea70:

    # mc "No. Los únicos que saben algo, Papá y la madre biológica de [sca] no van a decir nada."
    mc "Nein. Die einzigen, die etwas wissen, Dad und [sca]s leibliche Mutter, werden nichts sagen."

# game/scripts/c22/c22.rpy:3095
translate german c22s004_MarChat_01013c14:

    # mom "Con tu padre no se me ocurre ninguna idea, pero creo que con la madre de [sca] podría pensar en algo."
    mom "Mir fällt nichts ein, was mit deinem Vater zu tun hat, aber ich glaube, mir könnte etwas mit der Mutter von [sca] einfallen."

# game/scripts/c22/c22.rpy:3096
translate german c22s004_MarChat_98586b3e:

    # mom "¿Todavía quedan clones en Newport?"
    mom "Gibt es in Newport noch Klone?"

# game/scripts/c22/c22.rpy:3097
translate german c22s004_MarChat_f8ef9400:

    # mc "Creo que no, pero no tengo ni idea..."
    mc "Ich glaube nicht, aber ich habe keine Ahnung..."

# game/scripts/c22/c22.rpy:3099
translate german c22s004_MarChat_46ee4d98_1:

    # mom "Si no te importa, voy a volver con [sca] antes de que la abrumen demasiado."
    mom "Wenn es Ihnen nichts ausmacht, gehe ich jetzt zurück zu [sca], bevor sie zu überfordert ist."

# game/scripts/c22/c22.rpy:3100
translate german c22s004_MarChat_65eba579:

    # mom "Después hablaré con [ama] y [eva]."
    mom "Ich werde später mit [ama] und [eva] sprechen."

# game/scripts/c22/c22.rpy:3101
translate german c22s004_MarChat_5d587e42:

    # mc "¿No me lo vas a contar?"
    mc "Wirst du es mir nicht sagen?"

# game/scripts/c22/c22.rpy:3103
translate german c22s004_MarChat_cd0cf803:

    # mom "De momento no. Tengo que acabar de pensar en algunas cosas. Cuando lo tenga todo ligado, os lo cuento."
    mom "Im Moment nicht. Ich muss noch ein paar Dinge überdenken. Sobald alles geklärt ist, melde ich mich."

# game/scripts/c22/c22.rpy:3104
translate german c22s004_MarChat_5d75b6da:

    # mc "Ningún problema. Estaré en mi habitación. Tengo algunas cosas que hacer."
    mc "Kein Problem. Ich bin in meinem Zimmer. Ich habe noch etwas zu erledigen."

# game/scripts/c22/c22.rpy:3108
translate german c22s004_BookFerrarini_f4a3cb37:

    # "Subes a tu habitación después de despedirte de todo el mundo y darle un largo abrazo a [sca]."
    "Nachdem du dich von allen verabschiedet und [sca] lange umarmt hast, gehst du auf dein Zimmer."

# game/scripts/c22/c22.rpy:3109
translate german c22s004_BookFerrarini_3200efb7:

    # "Consigues mover la reserva del Ferrarini de [emm] al jueves a mediodía."
    "Es gelingt Ihnen, die Ferrarini-Reservierung von [emm] auf Donnerstagmittag zu verschieben."

# game/scripts/c22/c22.rpy:3110
translate german c22s004_BookFerrarini_d4770799:

    # "Tendréis que pasar la noche en Monterey para devolverlo al día siguiente, con lo que reservas un hotel cerca del aeropuerto."
    "Sie müssen in Monterey übernachten, um das Flugzeug am nächsten Tag zurückzugeben. Buchen Sie daher ein Hotel in der Nähe des Flughafens."

# game/scripts/c22/c22.rpy:3111
translate german c22s004_BookFerrarini_5c0867fa:

    # "Una habitación sencilla para ti y una doble para [bet] y [emm]."
    "Ein Einzelzimmer für Sie und ein Doppelzimmer für [bet] und [emm]."

# game/scripts/c22/c22.rpy:3113
translate german c22s004_BookFerrarini_636dd1f1:

    # "Cuando se lo dices a [emm] se emociona muchísimo y quiere empezar a preparar las maletas."
    "Wenn du es [emm] erzählst, ist er ganz aufgeregt und will sofort anfangen, seine Koffer zu packen."

# game/scripts/c22/c22.rpy:3125
translate german c22s005_SamCall_95a958cf:

    # "Después de pasar un rato en la piscina charlando con todas las chicas, te llama [sam] para invitarte a té con pastas."
    "Nachdem er einige Zeit am Pool mit den Mädchen geplaudert hat, ruft er dich an, um dich auf Tee und Kekse einzuladen."

# game/scripts/c22/c22.rpy:3126
translate german c22s005_SamCall_59db7e02:

    # "Parece empeñada en hacerte engordar otra vez, pero no puedes declinar la invitación."
    "Sie scheint fest entschlossen zu sein, dich wieder zunehmen zu lassen, aber du kannst die Einladung nicht ablehnen."

# game/scripts/c22/c22.rpy:3128
translate german c22s005_SamCall_d9e47835:

    # "La prueba de embarazo hace un día que ha dado el resultado."
    "Der Schwangerschaftstest ergab vor einem Tag das Ergebnis."

# game/scripts/c22/c22.rpy:3129
translate german c22s005_SamCall_9f560e10:

    # "Quedáis para una hora después."
    "Sie vereinbaren, sich eine Stunde später zu treffen."

# game/scripts/c22/c22.rpy:3131
translate german c22s005_SamCall_b7ec94b6:

    # "Llegas puntual a la hora acordada. Puedes oler las pastas desde la puerta. El niño gordo de tu pasado grita por salir."
    "Du kommst pünktlich an. Schon von der Tür aus riecht man die leckeren Backwaren. Dein pummeliges Ich aus der Vergangenheit schreit, es wolle raus."

# game/scripts/c22/c22.rpy:3132
translate german c22s005_SamCall_6092ea65:

    # "*Ding-Dong*"
    "*Ding-Dong*"

# game/scripts/c22/c22.rpy:3134
translate german c22s005_SamCall_d1342aee:

    # sam "Buenas tardes, [mc]. Pasa, acabo de sacar las pastas del horno."
    sam "Guten Tag, [mc]. Kommen Sie herein, ich habe gerade das Gebäck aus dem Ofen geholt."

# game/scripts/c22/c22.rpy:3135
translate german c22s005_SamCall_bc600f6c:

    # mc "¿[jam] y [sim] no están?"
    mc "Sind [jam] und [sim] nicht vorhanden?"

# game/scripts/c22/c22.rpy:3137
translate german c22s005_SamCall_7c97a111:

    # sam "[sim] está trabajando, llegará en un rato, y [jam] ha salido a tomar algo con un amigo."
    sam "[sim] ist bei der Arbeit, er wird in Kürze da sein, und [jam] ist mit einem Freund etwas trinken gegangen."

# game/scripts/c22/c22.rpy:3138
translate german c22s005_SamCall_2669b5cf:

    # mc "¿Qué? ¿[jam] tiene amigos? ¿Quién es el otro pringado?"
    mc "Was? Hat er Freunde? Wer ist der andere Loser?"

# game/scripts/c22/c22.rpy:3139
translate german c22s005_SamCall_f6ca0854:

    # sam "*Risa* No tengo ni idea. Siéntate en el sofá. Ahora llevo las pastas y el té."
    sam "*Lacht* Keine Ahnung. Setz dich aufs Sofa. Ich bringe gleich Gebäck und Tee."

# game/scripts/c22/c22.rpy:3141
translate german c22s005_SamCall_15564aa7:

    # sam "Cuéntame qué novedades hay. Aparte de lo que se ha dicho en el grupo de WhatsUp, claro."
    sam "Erzähl mir, was es Neues gibt. Abgesehen von dem, was in der WhatsApp-Gruppe besprochen wurde, natürlich."

# game/scripts/c22/c22.rpy:3142
translate german c22s005_SamCall_ae4f1a8e:

    # mc "*Risa* Como no me habéis invitado, no sé lo que se ha comentado."
    mc "*Lacht* Da du mich nicht eingeladen hast, weiß ich nicht, was gesagt wurde."

# game/scripts/c22/c22.rpy:3144
translate german c22s005_SamCall_82f7b373:

    # sam "Yo estaba en contra de dejarte fuera al principio, pero ha sido una buena idea. Hay cosas que otras chicas no se sentirían cómodas diciendo si estuvieras dentro."
    sam "Ich war anfangs dagegen, dich auszuschließen, aber es hat sich als gute Idee erwiesen. Es gibt Dinge, die andere Mädchen sich nicht trauen würden zu sagen, wenn du dabei wärst."

# game/scripts/c22/c22.rpy:3145
translate german c22s005_SamCall_cdc063b1:

    # mc "*Risa* Pero se sienten cómodas si está [jam]."
    mc "*Gelächter* Aber sie fühlen sich wohl, wenn [jam] da ist."

# game/scripts/c22/c22.rpy:3147
translate german c22s005_SamCall_d1639da9:

    # sam "Es diferente y lo sabes..."
    sam "Es ist anders, und das weißt du..."

# game/scripts/c22/c22.rpy:3149
translate german c22s005_SamCall_8934fba3:

    # sam "Si una chica con pinta de peligrosa pregunta cuál es tu plato favorito porque quiere preparar una cita, por ejemplo, [jam] puede aportar algo."
    sam "Wenn zum Beispiel ein Mädchen, das gefährlich aussieht, fragt, was dein Lieblingsgericht ist, weil sie ein Date planen möchte, kann [jam] etwas beitragen."

# game/scripts/c22/c22.rpy:3150
translate german c22s005_SamCall_d99a9715:

    # sam "Por cierto, felicidades."
    sam "Übrigens, herzlichen Glückwunsch."

# game/scripts/c22/c22.rpy:3151
translate german c22s005_SamCall_b2516466:

    # mc "Gracias."
    mc "Danke schön."

# game/scripts/c22/c22.rpy:3153
translate german c22s005_SamCall_baadd7ce:

    # sam "Si lo pregunta en un sitio donde tú lo puedes leer..."
    sam "Wenn du die Frage an einem Ort stellst, wo du sie lesen kannst..."

# game/scripts/c22/c22.rpy:3154
translate german c22s005_SamCall_d5508e39:

    # mc "Se perdería la sorpresa."
    mc "Der Überraschungseffekt wäre dahin."

# game/scripts/c22/c22.rpy:3156
translate german c22s005_SamCall_d9f0cf7f:

    # sam "Hay cosas que podemos hablar entre chicas, y que las cohibiría si un chico hetero estuviera en el grupo."
    sam "Es gibt Dinge, über die wir unter Mädchen reden können, und die uns verlegen machen würden, wenn ein heterosexueller Junge in der Gruppe wäre."

# game/scripts/c22/c22.rpy:3157
translate german c22s005_SamCall_d56b9c53:

    # mc "Lo entiendo."
    mc "Ich verstehe."

# game/scripts/c22/c22.rpy:3158
translate german c22s005_SamCall_2c58edf6:

    # mc "Pero un día le cogeré el móvil a [jam] para leer el grupo. *Risa* Aún recuerdo su contraseña."
    mc "Aber eines Tages werde ich [jam]s Handy nehmen, um den Gruppenchat zu lesen. *Lacht* Ich erinnere mich immer noch an ihr Passwort."

# game/scripts/c22/c22.rpy:3160
translate german c22s005_SamCall_182973b2:

    # sam "*Risa* No te lo recomendaría. Seguramente nos mirarías a todas de forma distinta. Se dicen muchas tonterías en ese grupo."
    sam "*Lacht* Ich würde es nicht empfehlen. Du würdest uns wahrscheinlich alle mit anderen Augen sehen. In dieser Gruppe wird viel Unsinn geredet."

# game/scripts/c22/c22.rpy:3161
translate german c22s005_SamCall_63a3cbea:

    # mc "Cada vez tengo más ganas de leerlo. *Risa*"
    mc "Ich freue mich immer mehr darauf, es zu lesen. *lacht*"

# game/scripts/c22/c22.rpy:3164
translate german c22s005_SamCall_caf2b0f7:

    # sam "También cosas serias. Ha sido una sorpresa lo de [sca] y lo de tu padre."
    sam "Auch ernste Dinge. Die Nachricht über [sca] und deinen Vater war eine Überraschung."

# game/scripts/c22/c22.rpy:3165
translate german c22s005_SamCall_58b36681:

    # mc "Ha sido muy emotivo. Todo el mundo veía a [sca] como parte de la familia... menos ella."
    mc "Es war sehr emotional. Alle sahen [sca] als Teil der Familie an... außer ihr."

# game/scripts/c22/c22.rpy:3166
translate german c22s005_SamCall_db262514:

    # mc "Ahora ya no puede negar que es una Marks más."
    mc "Nun kann sie nicht länger leugnen, dass sie nur eine weitere Marks ist."

# game/scripts/c22/c22.rpy:3171
translate german c22s005_SamPregnancyResult_d354f507:

    # mc "Pero hay algo que me preocupa..."
    mc "Aber etwas beunruhigt mich..."

# game/scripts/c22/c22.rpy:3173
translate german c22s005_SamPregnancyResult_32855e72:

    # sam "¿Qué, cielo?"
    sam "Was, Schatz?"

# game/scripts/c22/c22.rpy:3174
translate german c22s005_SamPregnancyResult_19d95003:

    # mc "Que, desde que he llegado, no me has dado ni un simple beso."
    mc "Seit meiner Ankunft hast du mir nicht einmal einen einfachen Kuss gegeben."

# game/scripts/c22/c22.rpy:3178
translate german c22s005_SamPregnancyResult_8c2ac628:

    # sam "*Risa* Te he invitado a comer pastas sabrosas no a besar dulces labios."
    sam "*Lacht* Ich habe dich eingeladen, leckere Pasta zu essen, nicht süße Lippen zu küssen."

# game/scripts/c22/c22.rpy:3179
translate german c22s005_SamPregnancyResult_6f6fe768:

    # mc "Bueno, puedo hacer las dos cosas. *Risa* No son incompatibles."
    mc "Nun, ich kann beides. *lacht* Das schließt sich nicht aus."

# game/scripts/c22/c22.rpy:3181
translate german c22s005_SamPregnancyResult_82725efa:

    # sam "Seguramente te reirás de mí, y tienes que saber que el sexo contigo me encanta..."
    sam "Du wirst mich wahrscheinlich auslachen, aber du solltest wissen, dass ich es liebe, mit dir Sex zu haben..."

# game/scripts/c22/c22.rpy:3182
translate german c22s005_SamPregnancyResult_2282fd71:

    # mc "A mí también, cariño."
    mc "Ich auch, Liebling."

# game/scripts/c22/c22.rpy:3184
translate german c22s005_SamPregnancyResult_63420601:

    # sam "Que me interrumpas no me gusta tanto, sin embargo. *Risa*"
    sam "Ich mag es allerdings nicht, unterbrochen zu werden. *lacht*"

# game/scripts/c22/c22.rpy:3185
translate german c22s005_SamPregnancyResult_6d0743df:

    # sam "Pero a veces echo de menos que nos sentemos a charlar como hacíamos antes, cuando sólo era tu segunda madre."
    sam "Aber manchmal vermisse ich es, dass wir uns zusammensetzten und plauderten, wie früher, als ich noch deine zweite Mutter war."

# game/scripts/c22/c22.rpy:3186
translate german c22s005_SamPregnancyResult_b3105273:

    # mc "[sam], siempre serás mi segunda madre..."
    mc "[sam], du wirst immer meine zweite Mutter sein..."

# game/scripts/c22/c22.rpy:3188
translate german c22s005_SamPregnancyResult_c6cae4ed:

    # mc "O tercera..."
    mc "Oder drittens..."

# game/scripts/c22/c22.rpy:3189
translate german c22s005_SamPregnancyResult_70dbdb15:

    # mc "Y me encanta charlar contigo, pero puedes besarme y podemos charlar. No está reñida una cosa con la otra."
    mc "Ich unterhalte mich sehr gern mit dir, aber du kannst mich auch küssen und wir können uns trotzdem unterhalten. Das eine schließt das andere nicht aus."

# game/scripts/c22/c22.rpy:3191
translate german c22s005_SamPregnancyResult_4cfa02f6:

    # sam "Si empiezo a besarte, no estoy segura de que hubiera podido parar antes de llevarte a la habitación. *Risa*"
    sam "Wenn ich dich erst einmal geküsst hätte, bin ich mir nicht sicher, ob ich hätte aufhören können, bevor ich dich ins Schlafzimmer gebracht hätte. *lacht*"

# game/scripts/c22/c22.rpy:3192
translate german c22s005_SamPregnancyResult_05be563f:

    # sam "Hace muchos días que tú y yo no..."
    sam "Es ist schon viele Tage her, seit du und ich das letzte Mal..."

# game/scripts/c22/c22.rpy:3193
translate german c22s005_SamPregnancyResult_b7bf2663:

    # mc "Lo sé. Estos días atrás han sido complicados."
    mc "Ich weiß. Die letzten Tage waren schwierig."

# game/scripts/c22/c22.rpy:3194
translate german c22s005_SamPregnancyResult_5a9a96be:

    # mc "Y aún tenemos que mirar la prueba de embarazo."
    mc "Und wir müssen uns den Schwangerschaftstest noch ansehen."

# game/scripts/c22/c22.rpy:3196
translate german c22s005_SamPregnancyResult_c91e569d:

    # sam "No te puedes llegar a imaginar lo difícil que ha sido no mirarla cuando empezó a pitar."
    sam "Sie können sich gar nicht vorstellen, wie schwer es war, nicht hinzusehen, als sie anfing zu piepen."

# game/scripts/c22/c22.rpy:3197
translate german c22s005_SamPregnancyResult_33a44060:

    # mc "Sí que me lo imagino."
    mc "Ja, das kann ich mir vorstellen."

# game/scripts/c22/c22.rpy:3199
translate german c22s005_SamPregnancyResult_fc29bedd:

    # sam "*Risa* Y yo tenía ganas de charlar contigo y ahora en lo único que voy a poder pensar es en la prueba."
    sam "*Lacht* Und ich hatte mich so darauf gefreut, mit dir zu plaudern, und jetzt kann ich an nichts anderes mehr denken als an die Prüfung."

# game/scripts/c22/c22.rpy:3200
translate german c22s005_SamPregnancyResult_8188c7d9:

    # mc "Pues la miramos y seguimos charlando. *Risa* Salga lo que salga, tendremos temas nuevos de los que hablar."
    mc "Wir sahen sie also an und unterhielten uns weiter. *lacht* Was auch immer passiert, wir werden immer neue Gesprächsthemen haben."

# game/scripts/c22/c22.rpy:3202
translate german c22s005_SamPregnancyResult_2aec4cf0:

    # sam "Sabes que si entras en esa habitación no vas a salir vestido independientemente del resultado, ¿no?"
    sam "Du weißt doch, dass du, wenn du diesen Raum betrittst, auf keinen Fall angezogen wieder herauskommst, egal wie es ausgeht, oder?"

# game/scripts/c22/c22.rpy:3203
translate german c22s005_SamPregnancyResult_185d17ea:

    # sam "Ya sea para celebrarlo o para buscar una nueva oportunidad, te voy a desnudar. *Risa*"
    sam "Ob zum Feiern oder um nach einer neuen Chance zu suchen, ich werde dich ausziehen. *lacht*"

# game/scripts/c22/c22.rpy:3204
translate german c22s005_SamPregnancyResult_f5fab17c:

    # mc "*Risa* Yo no he dicho que vaya a entrar. Puedes ir tú y traerlo."
    mc "*Lacht* Ich habe nicht gesagt, dass er reinkommt. Du kannst ihn gerne mitbringen."

# game/scripts/c22/c22.rpy:3205
translate german c22s005_SamPregnancyResult_39a8aaa9:

    # mc "Y creía que te daba lo mismo el resultado."
    mc "Und ich dachte, dir wäre das Ergebnis egal."

# game/scripts/c22/c22.rpy:3207
translate german c22s005_SamPregnancyResult_52ae5ee6:

    # sam "Me daba lo mismo, y me sigue dando lo mismo. Si me quedo embarazada de ti me pondré muy contenta pese a los riesgos."
    sam "Es war mir egal, und es ist mir immer noch egal. Wenn ich von dir schwanger werde, freue ich mich trotz der Risiken sehr."

# game/scripts/c22/c22.rpy:3208
translate german c22s005_SamPregnancyResult_6ebdcd20:

    # sam "Si no me quedo embarazada, me pondré muy contenta porque nunca me veras en modo ballena. *Risa* Y podremos seguir intentándolo."
    sam "Wenn ich nicht schwanger werde, bin ich sehr glücklich, denn dann werdet ihr mich nie im Wal-Modus sehen. *lacht* Und wir können es ja weiter versuchen."

# game/scripts/c22/c22.rpy:3209
translate german c22s005_SamPregnancyResult_95292b22:

    # mc "*Risa* Estoy seguro de que serás una ballena preciosa."
    mc "*Lacht* Ich bin sicher, du wirst ein wunderschöner Wal sein."

# game/scripts/c22/c22.rpy:3211
translate german c22s005_SamPregnancyResult_e573fdba:

    # sam "¡Mielda! Me has convencido. Voy a buscar la prueba."
    sam "Verdammt! Du hast mich überzeugt. Ich werde den Beweis finden."

# game/scripts/c22/c22.rpy:3212
translate german c22s005_SamPregnancyResult_427b4919:

    # mc "¿Quieres que te acompañe?"
    mc "Soll ich dich begleiten?"

# game/scripts/c22/c22.rpy:3214
translate german c22s005_SamPregnancyResult_9f87ce78:

    # sam "Claro. La saqué de la caja y la escondí debajo de los calcetines. En el momento en que quite los calcetines sabré el resultado."
    sam "Klar. Ich habe es aus der Schachtel genommen und unter meinen Socken versteckt. Ich werde das Ergebnis sehen, sobald ich die Socken ausziehe."

# game/scripts/c22/c22.rpy:3215
translate german c22s005_SamPregnancyResult_63408026:

    # sam "Llevo dos días sin ponerme calcetines para no verlo. *Risa* No lo quería ver sin ti."
    sam "Ich habe zwei Tage lang keine Socken getragen, damit ich ihn nicht sehen muss. *Lacht* Ich wollte ihn nicht ohne dich sehen."

# game/scripts/c22/c22.rpy:3216
translate german c22s005_SamPregnancyResult_3148bda2:

    # mc "Vamos. *Risa* No hay razón para seguir esperando."
    mc "Los geht's. *lacht* Es gibt keinen Grund mehr zu warten."

# game/scripts/c22/c22.rpy:3218
translate german c22s005_SamPregnancyResult_c8f12dc0:

    # sam "Ahora que estoy aquí, me estoy empezando a poner nerviosa."
    sam "Jetzt, wo ich hier bin, werde ich langsam nervös."

# game/scripts/c22/c22.rpy:3220
translate german c22s005_SamPregnancyResult_5bcf8bfc:

    # mc "Cuanto más lo pienses, más nerviosa te pondrás *Risa* Hazlo como si arrancaras una tirita."
    mc "Je länger du darüber nachdenkst, desto nervöser wirst du. *Lacht* Mach es so, als würdest du ein Pflaster abreißen."

# game/scripts/c22/c22.rpy:3229
translate german c22s005_SamPregnancyResult_8f3dc2e8:

    # mc "Me parece una idea estupenda. *Risa*"
    mc "Das klingt nach einer tollen Idee. *lacht*"

# game/scripts/c22/c22.rpy:3234
translate german c22s005_SamPregnant_a927261c:

    # sam "¡Felicidades, Papá!"
    sam "Alles Gute zum Vatertag!"

# game/scripts/c22/c22.rpy:3235
translate german c22s005_SamPregnant_6f5b75e2:

    # mc "¿Ha salido verde?"
    mc "Ist es grün geworden?"

# game/scripts/c22/c22.rpy:3237
translate german c22s005_SamPregnant_00d9fee7:

    # sam "*Risa* ¿Qué he hecho yo para merecer un hombre así?"
    sam "*lacht* Was habe ich getan, um so einen Mann zu verdienen?"

# game/scripts/c22/c22.rpy:3238
translate german c22s005_SamPregnant_48fed046:

    # sam "Si hubiera salido rojo, ¿te hubiera felicitado y llamado Papá?"
    sam "Wenn das Ergebnis rot gewesen wäre, hätte ich dir dann gratuliert und dich Papa genannt?"

# game/scripts/c22/c22.rpy:3240
translate german c22s005_SamPregnant_bedff5ed:

    # sam "Bueno, de momento podemos ir practicando por si sale niña que no nos pille oxidados, ¿no?"
    sam "Nun ja, für den Fall, dass wir ein Mädchen bekommen, können wir ja schon mal üben, damit wir nicht unvorbereitet sind, richtig?"

# game/scripts/c22/c22.rpy:3245
translate german c22s005_SamNotPregnant_f236ecb8:

    # sam "Pues no vamos a tener un hijo, de momento."
    sam "Nun ja, wir werden vorerst kein Kind bekommen."

# game/scripts/c22/c22.rpy:3247
translate german c22s005_SamNotPregnant_8d29a3a4:

    # sam "No verás mi modo ballena. *Risa*"
    sam "Du wirst meinen Wal-Modus nicht sehen. *lacht*"

# game/scripts/c22/c22.rpy:3248
translate german c22s005_SamNotPregnant_bdb1f20f:

    # mc "¿Ha salido rojo?"
    mc "War es rot?"

# game/scripts/c22/c22.rpy:3250
translate german c22s005_SamNotPregnant_00d9fee7:

    # sam "*Risa* ¿Qué he hecho yo para merecer un hombre así?"
    sam "*lacht* Was habe ich getan, um so einen Mann zu verdienen?"

# game/scripts/c22/c22.rpy:3251
translate german c22s005_SamNotPregnant_e21ea05d:

    # sam "Si hubiera salido verde, ¿te hubiera dicho que no íbamos a tener un hijo?"
    sam "Hätte ich dir gesagt, dass wir kein Kind bekommen würden, wenn der Test positiv ausgefallen wäre?"

# game/scripts/c22/c22.rpy:3253
translate german c22s005_SamNotPregnant_7c01a768:

    # sam "Bueno, de momento hay que repetir el intento para tener el primero, ¿no?"
    sam "Nun, vorerst müssen wir den Versuch wiederholen, das erste Exemplar zu bekommen, richtig?"

# game/scripts/c22/c22.rpy:3256
translate german c22s005_Kid_6fa76e8a:

    # mc "*Risa* ¡Joder, [sam]! Era una forma de hablar..."
    mc "*lacht* Verdammt, [sam]! Das war doch nur eine Redewendung..."

# game/scripts/c22/c22.rpy:3258
translate german c22s005_Kid_00dbb408:

    # sam "¡Vigila esa boca! No voy a permitir que el padre de mi hijo hable así delante del niño."
    sam "Pass auf, was du sagst! Ich werde nicht zulassen, dass der Vater meines Kindes so vor dem Kind redet."

# game/scripts/c22/c22.rpy:3259
translate german c22s005_Kid_7873f0c8:

    # sam "Así que ve acostumbrándote a no decir tacos. No se los permito a mis hijos y no te los voy a permitir a ti."
    sam "Gewöhnt euch also daran, nicht zu fluchen. Ich erlaube es meinen Kindern nicht, und ich werde es euch auch nicht erlauben."

# game/scripts/c22/c22.rpy:3260
translate german c22s005_Kid_dc1bc3f6:

    # mc "¿Hijo? ¿No quieres una niña?"
    mc "Sohn? Willst du denn kein Mädchen?"

# game/scripts/c22/c22.rpy:3262
translate german c22s005_Kid_e182e8ff:

    # sam "Me da lo mismo. Me ha salido hijo en vez de hija sin ninguna razón..."
    sam "Mir ist das egal. Es wurde ohne jeden Grund ein Sohn statt einer Tochter..."

# game/scripts/c22/c22.rpy:3263
translate german c22s005_Kid_bf000c03:

    # sam "Supongo que en el fondo no me da tanto lo mismo."
    sam "Ich glaube, im Grunde ist es mir eigentlich gar nicht so wichtig."

# game/scripts/c22/c22.rpy:3264
translate german c22s005_Kid_a5d7673f:

    # mc "Pues que sea niño. Y si sale niña, hacemos otro intento. *Risa*"
    mc "Hoffentlich wird es ein Junge. Und wenn es ein Mädchen wird, versuchen wir es eben nochmal. *lacht*"

# game/scripts/c22/c22.rpy:3277
translate german c22s005_SamSex_2f7c72da:

    # "[sam] empieza a besarte apasionadamente y, antes de que os deis cuenta, ambos estáis desnudos."
    "[sam] beginnt dich leidenschaftlich zu küssen und ehe du dich versiehst, seid ihr beide nackt."

# game/scripts/c22/c22.rpy:3278
translate german c22s005_SamSex_d3fef910:

    # "La ropa ha pasado mágicamente de estar en vuestros cuerpos a estar en el suelo."
    "Die Kleidung ist auf magische Weise von euren Körpern auf den Boden verschwunden."

# game/scripts/c22/c22.rpy:3280
translate german c22s005_SamSex_0ea7cdf3:

    # mc "Vamos un poco acelerados hoy, ¿no?"
    mc "Wir sind heute etwas zu schnell unterwegs, nicht wahr?"

# game/scripts/c22/c22.rpy:3281
translate german c22s005_SamSex_800949e9:

    # sam "No quiero que pase como la última vez y que a [sim] le dé tiempo a llegar a casa."
    sam "Ich möchte nicht, dass es so läuft wie beim letzten Mal, und [sim] soll genügend Zeit haben, nach Hause zu kommen."

# game/scripts/c22/c22.rpy:3282
translate german c22s005_SamSex_c0c0f805:

    # sam "Aunque ya lo sepa, prefiero tenerte para mí durante un rato."
    sam "Auch wenn ich es schon weiß, möchte ich dich eine Weile für mich allein haben."

# game/scripts/c22/c22.rpy:3283
translate german c22s005_SamSex_94110c19:

    # mc "Me parece perfecto. Yo también quiero tenerte para mí, sin interrupciones."
    mc "Das klingt perfekt. Ich möchte dich auch ganz für mich allein haben, ohne Störungen."

# game/scripts/c22/c22.rpy:3285
translate german c22s005_SamSex_f47a05e2:

    # sam "*Risa* ¿Qué haces?"
    sam "*Gelächter* Was machst du da?"

# game/scripts/c22/c22.rpy:3287
translate german c22s005_SamSex_9cfe0388:

    # sam "*Risa* ¿Me levantas ahora antes de que me ponga hecha una vaca?"
    sam "*Lacht* Würdest du mich jetzt abholen, bevor ich mich in eine Kuh verwandle?"

# game/scripts/c22/c22.rpy:3288
translate german c22s005_SamSex_9e55d71c:

    # mc "Llevarte a un sitio donde te voy a tener sólo para mí."
    mc "Ich nehme dich mit an einen Ort, wo du ganz für mich allein bist."

# game/scripts/c22/c22.rpy:3290
translate german c22s005_SamSex_be364f0c:

    # sam "¿Qué? ¿Aquí? ¿Al lado de la ventana? Nos pueden ver..."
    sam "Was? Hier? Am Fenster? Sie können uns sehen..."

