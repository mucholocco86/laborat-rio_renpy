    # ama "Voy a ir dentro a hablar con ella. Gracias por esta noche, [mc]. Nos vemos mañana."
    ama "I'm going inside to talk to her. Thanks for tonight, [mc]. See you tomorrow."

# game/scripts/c17/c17.rpy:731
translate english c17s001_AmandaDinner_a265333b:

    # mc "Hasta mañana, Amanda."
    mc "See you tomorrow, Amanda."

# game/scripts/c17/c17.rpy:735
translate english c17s001_AlexiaPregnancyResult_6e89f436:

    # "Al volver a la cocina, Alexia, que han llegado mientras estabas con las hermanas, se acercan a ti."
    "As you return to the kitchen, Alexia, who arrived while you were with the sisters, approaches you."

# game/scripts/c17/c17.rpy:736
translate english c17s001_AlexiaPregnancyResult_97700cb7:

    # oma "Hola, guapísimo. Vengo a arrestarte."
    oma "Hello, handsome. I've come to arrest you."

# game/scripts/c17/c17.rpy:737
translate english c17s001_AlexiaPregnancyResult_2f8bc2ad:

    # oma "La máquina debe haber acabado ya."
    oma "The machine must be finished by now."

# game/scripts/c17/c17.rpy:738
translate english c17s001_AlexiaPregnancyResult_2bd9ba35:

    # mc "¿Quieres ir ahora? La cena..."
    mc "Do you want to go now? Dinner..."

# game/scripts/c17/c17.rpy:740
translate english c17s001_AlexiaPregnancyResult_6c4dad34:

    # oma "No te preocupes, he estado hablando con Betty y con [nor]. Si nos vamos ahora, discretamente, nadie se dará cuenta."
    oma "Don't worry, I've been talking to Betty and [nor]. If we leave now, discreetly, no one will notice."

# game/scripts/c17/c17.rpy:741
translate english c17s001_AlexiaPregnancyResult_418d76b4:

    # mc "Vamos entonces."
    mc "Let's go then."

# game/scripts/c17/c17.rpy:743
translate english c17s001_AlexiaPregnancyResult_e507ed3f:

    # "En tu habitación..."
    "In your room..."

# game/scripts/c17/c17.rpy:744
translate english c17s001_AlexiaPregnancyResult_d04d75f6:

    # mc "Tu test está en ese cajón, Alexia. Ve a por él. ¿Nerviosa?"
    mc "Your test is in that drawer, Alexia. Go get it. Nervous?"

# game/scripts/c17/c17.rpy:745
translate english c17s001_AlexiaPregnancyResult_32b6dc71:

    # oma "Un poco. Aún no estoy segura de lo que quiero. Siempre me imaginé teniendo a mi primer hijo a los 30 o así."
    oma "A bit. I'm still not sure what I want. I always pictured myself having my first child at 30 or so."

# game/scripts/c17/c17.rpy:746
translate english c17s001_AlexiaPregnancyResult_f41f1e7a:

    # mc "Yo también. Pero solo hay una forma de saberlo. Ve a por él."
    mc "Me too. But there's only one way to find out. Go get it."

# game/scripts/c17/c17.rpy:748
translate english c17s001_AlexiaPregnancyResult_a20cefa7:

    # "..."
    "..."

# game/scripts/c17/c17.rpy:752
translate english c17s001_AlexiaPregnancyResult_fdb17f59:

    # oma "¡Positivo!"
    oma "Positive!"

# game/scripts/c17/c17.rpy:753
translate english c17s001_AlexiaPregnancyResult_f75dde5b:

    # mc "¡Bien! Parece que has descubierto lo que quieres. Ven aquí."
    mc "Good! Looks like you've figured out what you wanted. Come here."

# game/scripts/c17/c17.rpy:754
translate english c17s001_AlexiaPregnancyResult_e3df2b1e:

    # oma "Lo he descubierto en el momento en que he puesto la mano en el cajón. He descubierto que quería que saliera verde."
    oma "I discovered it the moment I touched the drawer. I discovered that I wanted it to come out green."

# game/scripts/c17/c17.rpy:755
translate english c17s001_AlexiaPregnancyResult_8a8db6a9:

    # mc "Ven aquí. Quiero un abrazo de la futura madre."
    mc "Come here. I want a hug from the mother-to-be."

# game/scripts/c17/c17.rpy:757
translate english c17s001_AlexiaPregnancyResult_3fb99fd3:

    # "Os fundís en un abrazo lleno de alegría y de esperanza en que todo vaya bien durante el embarazo."
    "You melt into an embrace full of joy and hope that everything will go well during the pregnancy."

# game/scripts/c17/c17.rpy:760
translate english c17s001_AlexiaPregnancyResult_c82831ca:

    # oma "Negativo..."
    oma "Negative..."

# game/scripts/c17/c17.rpy:761
translate english c17s001_AlexiaPregnancyResult_9df83427:

    # mc "Oh, Alexia, lo siento..."
    mc "Oh, Alexia, I'm sorry..."

# game/scripts/c17/c17.rpy:762
translate english c17s001_AlexiaPregnancyResult_df158eee:

    # oma "No te preocupes, he descubierto que quería que saliera verde en el momento en que he puesto la mano en el cajón. Pero tendremos más oportunidades."
    oma "Don't worry, I figured out that I wanted it to come out green the moment I put my hand in the drawer. But we'll have more chances."

# game/scripts/c17/c17.rpy:763
translate english c17s001_AlexiaPregnancyResult_64d4a675:

    # oma "Los dos somos jóvenes y tenemos mucho tiempo para seguir intentándolo. Intentarlo es divertido."
    oma "We are both young and have plenty of time to keep trying. Trying is fun."

# game/scripts/c17/c17.rpy:764
translate english c17s001_AlexiaPregnancyResult_7aca4657:

    # mc "Ven aquí. Quiero un abrazo de la futura madre, aunque tardes un poco más."
    mc "Come here. I want a hug from the mother-to-be, even if it takes a little longer."

# game/scripts/c17/c17.rpy:766
translate english c17s001_AlexiaPregnancyResult_c03082a8:

    # "Os fundís en un abrazo lleno de esperanza en que la próxima vez cambie el resultado del siguiente test."
    "You melt into an embrace full of hope that the result of the next test will be different."

# game/scripts/c17/c17.rpy:767
translate english c17s001_AlexiaPregnancyResult_a77c5a71:

    # "Es un abrazo lleno de caricias y besos. Es bueno saber que estáis juntos en esto."
    "It's an embrace full of caresses and kisses. It's good to know you're in this together."

# game/scripts/c17/c17.rpy:769
translate english c17s001_AlexiaPregnancyResult_c8dd4d61:

    # oma "Deberíamos volver a la cena antes de que alguien sospeche de nuestra ausencia."
    oma "We should get back to the kitchen before anyone becomes suspicious of our absence."

# game/scripts/c17/c17.rpy:771
translate english c17s001_AlexiaPregnancyResult_3db44a99:

    # oma "¿Cuándo quieres decírselo a la familia? Porque quieres decírselo, ¿verdad?"
    oma "When do you want to tell the family? Because you want to tell them, don't you?"

# game/scripts/c17/c17.rpy:772
translate english c17s001_AlexiaPregnancyResult_c46eb4fa:

    # mc "Por supuesto que quiero decírselo. Pero este fin de semana siempre ha sido especial para [emm], [dap], y [eri]."
    mc "Of course I want to tell them. But this weekend has always been special for [emm], [dap], and [eri]."

# game/scripts/c17/c17.rpy:773
translate english c17s001_AlexiaPregnancyResult_8713b3b9:

    # mc "La presencia de Eva y Amanda ya les ha robado suficiente protagonismo."
    mc " Eva and Amanda's presence has already taken enough of the spotlight away from them."

# game/scripts/c17/c17.rpy:774
translate english c17s001_AlexiaPregnancyResult_99c3ccbb:

    # mc "¿Te importa si dejamos pasar unos días?"
    mc "Do you mind if we let a few days pass?"

# game/scripts/c17/c17.rpy:776
translate english c17s001_AlexiaPregnancyResult_dab15a46:

    # mc "A lo mejor podemos hacer el test de Eileen y sale positivo tras el columpio. Lo podemos hacer mañana por la tarde y lo sabríamos el lunes."
    mc "Maybe we can test Eileen and see if it comes back positive after the swing. We can do it tomorrow afternoon and we would know on Monday."

# game/scripts/c17/c17.rpy:777
translate english c17s001_AlexiaPregnancyResult_70a743fd:

    # oma "No tengo ningún problema en esperar. No tengo de qué esconderme, pero entiendo lo que dices."
    oma "I have no problem with waiting. I have nothing to hide, but I understand what you're saying."

# game/scripts/c17/c17.rpy:779
translate english c17s001_AlexiaPregnancyResult_29f5aed1:

    # mc "Y sobre lo de seguir trabajando..."
    mc "And about continuing to work..."

# game/scripts/c17/c17.rpy:780
translate english c17s001_AlexiaPregnancyResult_ec3fd0d7:

    # oma "No voy a dejar de trabajar, [mc]. Estoy embarazada, no inválida. Y esto es Newport, no Los Angeles. Aquí no hay peligro de meterme en un tiroteo."
    oma "I'm not going to stop working, [mc]. I'm pregnant, not incapacitated. And this is Newport, not Los Angeles. There's no danger of me getting into a gunfight here."

# game/scripts/c17/c17.rpy:781
translate english c17s001_AlexiaPregnancyResult_5a9ddc43:

    # oma "Cuando el embarazo esté un poco avanzado, quizás pida hacer trabajo de oficina, pero hasta entonces quiero seguir haciendo vida normal."
    oma "When the pregnancy is a little advanced, I may ask to do office work, but until then I want to continue to live a normal life."

# game/scripts/c17/c17.rpy:782
translate english c17s001_AlexiaPregnancyResult_edfb7fb5:

    # mc "Okay, si es lo que te parece bien, no voy a llevarte la contraria."
    mc "Okay, if that's what you want to do, I'm not going to argue with you about it."

# game/scripts/c17/c17.rpy:783
translate english c17s001_AlexiaPregnancyResult_7513947c:

    # oma "Vamos. Tengo ganas de seguir conociendo a Amanda. Me he perdido a Eva esta mañana, pero Amanda me parece muy interesante."
    oma "Let's go. I'm looking forward to getting to know Amanda some more. I missed Eva this morning, but Amanda seems like a very interesting girl."

# game/scripts/c17/c17.rpy:787
translate english c17s001_EileenPregnancyResult_76d77819:

    # "Al volver a la cocina, Eileen, que han llegado mientras estabas con las hermanas, se acercan a ti."
    "As you return to the kitchen, Eileen, who arrived while you were with the sisters, comes up to you."

# game/scripts/c17/c17.rpy:788
translate english c17s001_EileenPregnancyResult_02f256f7:

    # eil "Hola, [mc]. Vengo a secuestrarte."
    eil "Hello, [mc]. I've come to kidnap you."

# game/scripts/c17/c17.rpy:789
translate english c17s001_EileenPregnancyResult_5165c120:

    # eil "Hay una... máquina... que debe haber acabado su proceso."
    eil "There is a... machine... that must have finished its process."

# game/scripts/c17/c17.rpy:790
translate english c17s001_EileenPregnancyResult_2bd9ba35:

    # mc "¿Quieres ir ahora? La cena..."
    mc "Do you want to go now? Dinner..."

# game/scripts/c17/c17.rpy:792
translate english c17s001_EileenPregnancyResult_17e7861c:

    # eil "No te preocupes, he saludado a todo el mundo y están ocupadas con Amanda."
    eil "Don't worry, I've said hello to everyone and they're busy with Amanda."

# game/scripts/c17/c17.rpy:793
translate english c17s001_EileenPregnancyResult_7e3ee87e:

    # eil "Si nos vamos ahora nadie se dará cuenta."
    eil "If we leave now, no one will notice."

# game/scripts/c17/c17.rpy:794
translate english c17s001_EileenPregnancyResult_418d76b4:

    # mc "Vamos entonces."
    mc "Let's go, then."

