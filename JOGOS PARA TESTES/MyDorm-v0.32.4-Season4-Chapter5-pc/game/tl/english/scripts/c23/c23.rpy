    # eil "No me acosté con ninguno de esos chicos."
    eil "I didn't sleep with any of those guys."

# game/scripts/c23/c23.rpy:1369
translate english c23s003_Eil_c8d25e30:

    # eil "Ninguno de aquellos chicos eras tú."
    eil "None of those guys were you."

# game/scripts/c23/c23.rpy:1370
translate english c23s003_Eil_7b06167a:

    # mc "Me lo imagino. Si hubiera yo hubiera sido uno de ellos, lo recordaría."
    mc "I can imagine. If I had been one of them, I would remember it."

# game/scripts/c23/c23.rpy:1372
translate english c23s003_Eil_7c792f56:

    # eil "¡Idiota! ¡Estoy hablando en serio!"
    eil "You idiot! I'm being serious!"

# game/scripts/c23/c23.rpy:1373
translate english c23s003_Eil_e108b29c:

    # mc "Y yo también. ¿Crees que me importaría si te hubieras acostado con alguno de ellos?"
    mc "And so am I. Did you think I would care if you had slept with any of them?"

# game/scripts/c23/c23.rpy:1374
translate english c23s003_Eil_ea8e1c3f:

    # mc "¿Te importa a ti que saliera y me acostara con [sai] mientras tú y yo no estábamos juntos?"
    mc "Does it bother you that I dated and slept with [sai] while you and I weren't together?"

# game/scripts/c23/c23.rpy:1376
translate english c23s003_Eil_bed78a97:

    # eil "No. Y no. Pero con las mujeres es diferente..."
    eil "No. And no. But it's different with women..."

# game/scripts/c23/c23.rpy:1377
translate english c23s003_Eil_d5fb6099:

    # eil "Si un hombre se acuesta con diez mujeres diferentes es un macho."
    eil "If a man sleeps with ten different women, he is a macho man."

# game/scripts/c23/c23.rpy:1378
translate english c23s003_Eil_69d7a2f3:

    # eil "Si una mujer se acuesta con tres hombres, es una puta para muchos hombres."
    eil "If a woman sleeps with three men, she is a whore to many men. And even if I know you aren't one of them..."

# game/scripts/c23/c23.rpy:1379
translate english c23s003_Eil_e8be8f2f:

    # mc "Son esos hombres los que tienen un problema, no la mujer. Sabes que yo no pienso así."
    mc "It's those men who have a problem, not the woman. As you said, I don't think that way."

# game/scripts/c23/c23.rpy:1380
translate english c23s003_Eil_c9d46b3a:

    # mc "Además, no lo hiciste, con lo que no hay más de que hablar."
    mc "Besides, you didn't, so there's nothing more to talk about."

# game/scripts/c23/c23.rpy:1382
translate english c23s003_Eil_36321820:

    # eil "Son por estas cosas por las que te quiero. Lo sabes, ¿verdad?"
    eil "It's because of these things that I love you. You know that, don't you?"

# game/scripts/c23/c23.rpy:1383
translate english c23s003_Eil_656b4a49:

    # mc "Yo creía que sólo me querías porque soy el mejor amante que nadie pueda imaginar. *Risa*"
    mc "I thought you only loved me because I'm the best lover anyone can imagine. *Laugh*"

# game/scripts/c23/c23.rpy:1385
translate english c23s003_Eil_f6938275:

    # eil "A veces eres idiota. Estoy hablando en serio, [mc]."
    eil "Sometimes you're an idiot. I'm being serious, [mc]."

# game/scripts/c23/c23.rpy:1386
translate english c23s003_Eil_daa9aca1:

    # eil "Si fueras diferente no me atrevería a hablarte de todo."
    eil "If you were different, I wouldn't dare to talk to you about those things."

# game/scripts/c23/c23.rpy:1387
translate english c23s003_Eil_b8dd6aac:

    # mc "Lo sé. Yo también te quiero, [eil.nick]. Eres una mujer maravillosa."
    mc "I know, I love you too, [eil.nick]. You're a wonderful woman."

# game/scripts/c23/c23.rpy:1389
translate english c23s003_Eil_efa06021:

    # eil "Pues ahora esta mujer maravillosa se va a tener que ir. Me quiero dar una ducha rápida antes de ir a trabajar."
    eil "Well, now this wonderful woman is going to leave. I want to take a quick shower before heading to the cafe."

# game/scripts/c23/c23.rpy:1390
translate english c23s003_Eil_74edfffa:

    # mc "Puedes coger mi albornoz si quieres y ducharte aquí."
    mc "You can take my bathrobe if you want, and shower here."

# game/scripts/c23/c23.rpy:1392
translate english c23s003_Eil_ed09d202:

    # eil "No hace falta. Me vuelvo a poner el uniforme y voy a casa. Tengo tiempo."
    eil "No need. I'm putting my uniform back on and going home. I have plenty of time."

# game/scripts/c23/c23.rpy:1393
translate english c23s003_Eil_8a4b213f:

    # mc "Como desees."
    mc "As you wish."

# game/scripts/c23/c23.rpy:1395
translate english c23s003_Eil_a882f7fe:

    # "Una vez los dos os habéis vestido..."
    "Once both of you are dressed..."

# game/scripts/c23/c23.rpy:1396
translate english c23s003_Eil_7b478453:

    # eil "Me voy a ir ya. Gracias por ser como eres."
    eil "I'm going now. Thank you for being the way you are."

# game/scripts/c23/c23.rpy:1397
translate english c23s003_Eil_2a5242a9:

    # mc "Gracias a ti por hacerme como soy."
    mc "Thank you for making me the way I am."

# game/scripts/c23/c23.rpy:1399
translate english c23s003_Eil_4092f2d3:

    # eil "¡Oh! ¡Eso es muy bonito! No me lo habías dicho nunca."
    eil "Oh! That's very sweet! You never told me that before."

# game/scripts/c23/c23.rpy:1400
translate english c23s003_Eil_460ad180:

    # mc "Pero te lo he demostrado muchas veces."
    mc "But I proved it to you many times."

# game/scripts/c23/c23.rpy:1404
translate english c23s004_Kia_dd0461ef:

    # "*Knock-Knock*"
    "*Knock-Knock*"

# game/scripts/c23/c23.rpy:1405
translate english c23s004_Kia_999e0f29:

    # kia "*A través de la puerta* [mc], ¿estás ahí? ¿Puedo pasar?"
    kia "*Through the door* [mc], are you there? May I come in?"

# game/scripts/c23/c23.rpy:1406
translate english c23s004_Kia_4d601f0e:

    # mc "Sí, pasa."
    mc "Yes, come in."

# game/scripts/c23/c23.rpy:1408
translate english c23s004_Kia_dd2620e4:

    # kia "¡Oh! No sabía que estabas aquí, [eil.nick]. Precisamente venía a preguntarle a [mc] si te había visto."
    kia "Oh! I didn't know you were here, [eil.nick]. I was just coming to ask [mc] if he knew where you were."

# game/scripts/c23/c23.rpy:1410
translate english c23s004_Kia_f92d1814:

    # eil "Llevo un rato aquí, hemos estado... charlando."
    eil "I've been here for a while, we've been... chatting."

# game/scripts/c23/c23.rpy:1411
translate english c23s004_Kia_fd36aada:

    # mc "¿No estabas trabajando?"
    mc "Weren't you at work?"

# game/scripts/c23/c23.rpy:1413
translate english c23s004_Kia_3c781259:

    # kia "Hoy voy empiezo a mediodía. Por eso estaba buscando a [eil]."
    kia "Hoy voy empiezo a mediodía. Por eso estaba buscando a [eil]."

# game/scripts/c23/c23.rpy:1413
translate english c23s004_Kia_59b23038:

    # kia "Hoy empiezo a mediodía. Por eso estaba buscando a [eil]."
    kia "I start at noon today. That's why I was looking for [eil]."

# game/scripts/c23/c23.rpy:1414
translate english c23s004_Kia_8fe2bb9b:

    # kia "Me ha llamado [oma]. Va a venir a recogerme para llevarme al trabajo, por si querías venir tú también y te dejamos en el café."
    kia "I got a call from [oma]. She's coming to pick me up to take me to work and, in case you wanted to come also, we can drop you off at the cafe."

# game/scripts/c23/c23.rpy:1416
translate english c23s004_Kia_62fd67d7:

    # eil "¡Oh, eso sería fantástico! ¡Voy a cambiarme!"
    eil "Oh, that would be great, I'm going to change!"

# game/scripts/c23/c23.rpy:1419
translate english c23s004_Kia_84ff7fc5:

    # eil "Por cierto, Mamá, sabes que puedes besar a [mc] aunque yo esté delante, ¿verdad?"
    eil "By the way, Mom, you know you can kiss [mc] in front of me, right?"

# game/scripts/c23/c23.rpy:1420
translate english c23s004_Kia_945c30b7:

    # mc "[eil], no tienes que presionarla."
    mc "[eil], you don't have to push her."

# game/scripts/c23/c23.rpy:1422
translate english c23s004_Kia_6b45fe62:

    # kia "*Risa* No me siento presionada, pero prefiero hacerlo cuando te hayas ido."
    kia "*Laugh* I don't feel pushed, but I'd rather do it when you're gone."

# game/scripts/c23/c23.rpy:1424
translate english c23s004_Kia_c2a7821f:

    # eil "Pues me voy y os dejo que os beséis con tranquilidad."
    eil "Well, then I'll leave and let you two kiss without an audience."

# game/scripts/c23/c23.rpy:1427
translate english c23s004_Kia_59fe7813:

    # kia "Esta chica..."
    kia "That girl..."

# game/scripts/c23/c23.rpy:1428
translate english c23s004_Kia_9fcd8d5a:

    # mc "Creo que tenías un beso para mí..."
    mc "I think you had a kiss for me..."

# game/scripts/c23/c23.rpy:1430
translate english c23s004_Kia_d243bc2f:

    # "Sin decir una palabra, sus dulces labios buscan los tuyos."
    "Without saying a word, her sweet lips seek yours."

# game/scripts/c23/c23.rpy:1431
translate english c23s004_Kia_c1e0c57d:

    # "Hoy no saben a aguacate, pero no por ello son menos deliciosos."
    "They don't taste like avocado today, but that doesn't make them any less delicious."

# game/scripts/c23/c23.rpy:1432
translate english c23s004_Kia_5c482df3:

    # "Como siempre, os separáis para recuperar el aliento. Demasiado pronto."
    "As usual, you part to catch your breath. Too soon."

# game/scripts/c23/c23.rpy:1435
translate english c23s004_Kia_e1381dbf:

    # kia "*Respiración entrecortada* ¡Phew! Y por esto prefiero besarte en privado. *Risa*"
    kia "*Shortened breath* Phew! And this is why I'd rather kiss you in private. *Laugh*"

# game/scripts/c23/c23.rpy:1436
translate english c23s004_Kia_b9a14b7b:

    # mc "Llamaremos a estos besos Darth Bader. *Risa* Cada vez que nos separamos respiramos como él."
    mc "We'll call these Darth Bader kisses. *Laugh* Every time we part, we breathe like him."

# game/scripts/c23/c23.rpy:1438
translate english c23s004_Kia_9b46c866:

    # kia "*Risa* A veces me extraña que algo tan de mi época lo hayáis adoptado los jóvenes."
    kia "*Laugh* Sometimes I find it strange that something so much from my era has been adopted by you young people."

# game/scripts/c23/c23.rpy:1439
translate english c23s004_Kia_248258de:

    # mc "*Risa* Con la cantidad de spin offs que han hecho, creo que es de todas las épocas."
    mc "*Laugh* With the amount of spin-offs they've done, I think it's from all eras."

# game/scripts/c23/c23.rpy:1441
translate english c23s004_Kia_c37a601b:

    # kia "*Risa* Tienes razón, han encontrado la gallina de los huevos de oro y no pararán hasta que la maten."
    kia "*Laugh* You're right, they've found the golden goose, and they won't stop until they kill it."

# game/scripts/c23/c23.rpy:1442
translate english c23s004_Kia_1d1af333:

    # mc "Cambiando de tema, ¿hoy no hay vestido morado?"
    mc "Changing the subject, no purple dress today?"

# game/scripts/c23/c23.rpy:1444
translate english c23s004_Kia_60fbe70c:

    # kia "Hoy no he quedado para comer con ningún chico guapo, con lo que no hay nadie a quien impresionar."
    kia "I'm not meeting any cute guys for lunch today, so there's no one to impress."

# game/scripts/c23/c23.rpy:1445
translate english c23s004_Kia_c5e92548:

    # mc "Tú impresionarías a ese chico afortunado llevaras lo que llevaras, o aunque no llevaras nada..."
    mc "You'd impress that lucky guy no matter what you wore, or if you wore nothing at all..."

# game/scripts/c23/c23.rpy:1446
translate english c23s004_Kia_d5096617:

    # mc "Eso ha sonado mejor en mi cabeza..."
    mc "That sounded better in my head..."

# game/scripts/c23/c23.rpy:1448
translate english c23s004_Kia_f6aedbdd:

    # kia "Bueno, espero, si no impresionarte, al menos no decepcionarte cuando no lleve nada."
    kia "Well, I hope, if not to impress you, at least not to disappoint you when I don't wear anything."

# game/scripts/c23/c23.rpy:1449
translate english c23s004_Kia_2321c125:

    # mc "No me podrías decepcionar nunca, [kia]. Estoy deseando poder demostrártelo."
    mc "You could never disappoint me, [kia]. I can't wait to be able to prove it to you."

# game/scripts/c23/c23.rpy:1451
translate english c23s004_Kia_d6ca2621:

    # kia "Si no fuera porque mañana tienes que levantarte temprano... Tenemos una cena pendiente."
    kia "If it weren't for the fact that you have to get up early tomorrow.... We have a pending dinner."

# game/scripts/c23/c23.rpy:1452
translate english c23s004_Kia_a377bd3d:

    # kia "¿Cuándo vuelves? ¿El viernes?"
    kia "When are you coming back? On Friday?"

# game/scripts/c23/c23.rpy:1453
translate english c23s004_Kia_1da55bc6:

    # mc "Sí, el viernes por la tarde espero estar de vuelta."
    mc "Yes, I expect to be back by Friday afternoon."

# game/scripts/c23/c23.rpy:1455
translate english c23s004_Kia_94beec8a:

    # kia "¿Te apetece que vayamos a cenar? Si no estás muy cansado cuando vuelvas, claro."
    kia "Would you like to go to dinner? If you're not too tired when you get back, of course."

# game/scripts/c23/c23.rpy:1456
translate english c23s004_Kia_8d395c57:

    # mc "Apúntalo en la agenda. *Risa* Son poco más de dos horas conduciendo, no voy a estar cansado."
    mc "Put it on the calendar. *Laugh* It's just over two hours driving, I'm not going to be tired."

# game/scripts/c23/c23.rpy:1458
translate english c23s004_Kia_acfffe06:

    # kia "Entonces el viernes. Me apetece mucho tener nuestra tercera cita."
    kia "Friday then. I'm really looking forward to our third date."

# game/scripts/c23/c23.rpy:1459
translate english c23s004_Kia_5daa83ad:

    # mc "A mí también. Me encanta pasar tiempo contigo."
    mc "Me too. I love spending time with you."

# game/scripts/c23/c23.rpy:1461
translate english c23s004_Kia_6dc9d2f6:

    # kia "Eres tan dulce... Pero debería bajar antes de que llegue [oma]."
    kia "You are so sweet... But I should go downstairs before [oma] arrives."

# game/scripts/c23/c23.rpy:1465
translate english c23s004_Kia_dd9d5367:

    # kia "Debería bajar por si [oma] llega pronto."
    kia "I should go downstairs in case [oma] arrives soon."

# game/scripts/c23/c23.rpy:1466
translate english c23s004_Kia_615ebbcf:

    # mc "Vamos. Te acompaño. No he visto a [oma] desde la fiesta de la piscina."
    mc " Let's go. I'll go with you. I haven't seen [oma] since the pool party."

# game/scripts/c23/c23.rpy:1468
translate english c23s004_Kia_590abfbf:

    # mc "Por cierto, sólo te había visto con las gafas en el restaurante."
    mc "By the way, I had only seen you wearing glasses in the restaurant."

# game/scripts/c23/c23.rpy:1470
translate english c23s004_Kia_bcd2c2af:

    # mc "Por cierto, hacía mucho tiempo que no te veía con gafas."
    mc "By the way, it's been a long time since I've seen you wearing glasses."

# game/scripts/c23/c23.rpy:1472
translate english c23s004_Kia_0f258b53:

    # kia "Me las pongo para leer y trabajar. Estas son las de reserva y no tienen funda, con lo que no las quiero llevar sueltas en el bolso para evitar rayarlas."
    kia "I wear them to read and work. These are the backup ones and have no case, so I don't want to carry them loose in my bag to avoid scratching them."

# game/scripts/c23/c23.rpy:1473
translate english c23s004_Kia_fe9e1f12:

    # kia "No sé dónde he dejado las otras gafas. A lo mejor las dejé en la biblioteca."
    kia "I don't know where I left the other glasses. Maybe I forgot them at the library."

# game/scripts/c23/c23.rpy:1474
translate english c23s004_Kia_7992e3ae:

    # mc "Si quieres le puedo pedir una funda a [mar] o a [kim]. Seguro que tienen de sobras."
    mc "If you want, I can ask [mar] or [kim] for a case. I'm sure they have a spare."

# game/scripts/c23/c23.rpy:1476
translate english c23s004_Kia_7557bf5a:

    # kia "No hace falta, son progresivas, puedo ver bien con ellas en cualquier circunstancia. Ya encontraré la funda."
    kia "No need, they are progressives. I can see fine with them in all circumstances. I'll find the case when I find the other glasses."

# game/scripts/c23/c23.rpy:1477
translate english c23s004_Kia_e67890ae:

    # mc "Como quieras. Vamos entonces."
    mc "As you wish. Let's go then."

# game/scripts/c23/c23.rpy:1479
translate english c23s004_Kia_8ef4ccaf:

    # mc "De todas formas, estás guapísima con ellas."
    mc "Anyway, you look gorgeous with them."

# game/scripts/c23/c23.rpy:1481
translate english c23s004_Kia_5a3d2aba:

    # kia "Vamos antes de que te tenga que besar otra vez. *Risa*"
    kia "Let's go before I have to kiss you again. *Laugh*"

# game/scripts/c23/c23.rpy:1486
translate english c23s004_EilKiss_d5eece30:

    # eil "Hasta luego, cielo."
    eil "See you later, honey."

# game/scripts/c23/c23.rpy:1488
translate english c23s004_EilKiss_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c23/c23.rpy:1489
translate english c23s004_EilKiss_c8213c6a:

    # eil "*A través de la puerta* Date prisa, Mamá. En menos de diez minutos estaré lista."
    eil "*Through the door* Hurry up, Mom. I'll be ready in less than ten minutes."

# game/scripts/c23/c23.rpy:1496
translate english c23s004_Oma_79acbd77:

    # "Cuando llegáis abajo, [oma] ya está esperando a [kia]."
    "When you arrive downstairs, [oma] is already waiting for [kia]."

# game/scripts/c23/c23.rpy:1499
translate english c23s004_Oma_14a2700e:

    # oma "Hola, cielo."
    oma "Hi, honey."

# game/scripts/c23/c23.rpy:1500
translate english c23s004_Oma_86b43a6a:

    # mc "Hola, preciosa. ¿No trabajas hoy?"
    mc "Hi, gorgeous. Aren't you working today?"

# game/scripts/c23/c23.rpy:1503
translate english c23s004_Oma_c63c3e9c:

    # oma "Hola, [kia] y [mc]."
    oma "Hi, [kia] and [mc]."

# game/scripts/c23/c23.rpy:1504
translate english c23s004_Oma_45b32b95:

    # mc "Hola, [oma]. ¿No trabajas hoy?"
    mc "Hi, [oma]. Aren't you working today?"

# game/scripts/c23/c23.rpy:1506
translate english c23s004_Oma_025afa94:

    # oma "Acabo de salir. Llevo toda la semana cubriendo el primer turno. Schrute está enfermo y estoy en el mostrador de la comisaría."
    oma "I just got off. I've been covering the first shift since Monday. Schrute is sick and I'm on the counter at the police station."

# game/scripts/c23/c23.rpy:1507
translate english c23s004_Oma_4e4ad102:

    # mc "Ufff. Yo odiaría tener que madrugar tanto."
    mc "Phew. I'd hate to get up so early."

# game/scripts/c23/c23.rpy:1509
translate english c23s004_Oma_e6ca9f9a:

    # kia "*Risa* Todo el mundo sabe que te gusta dormir hasta tarde."
    kia "*Laugh* Everyone knows you like to sleep until late."

# game/scripts/c23/c23.rpy:1510
translate english c23s004_Oma_50206f78:

    # mc "¡Hey! ¡A primera hora de la mañana no tengo nada que hacer!"
    mc "Hey! I have nothing to do first thing in the morning!"

# game/scripts/c23/c23.rpy:1512
translate english c23s004_Oma_5dd58847:

    # oma "Podrías venir a correr conmigo, al menos cuando tengo turno normal."
    oma "You could come run with me, at least when I have my usual shift."

# game/scripts/c23/c23.rpy:1514
translate english c23s004_Oma_15d6cb33:

    # kia "O hacer yoga con las chicas. Me han dicho que lo probaste una vez y no has vuelto."
    kia "Or do yoga with the girls. I heard you tried it once and haven't been back."

# game/scripts/c23/c23.rpy:1515
translate english c23s004_Oma_1cfafede:

    # mc "*Risa* ¿Os dais cuenta de que lo único que proponéis es que haga más ejercicio?"
    mc "*Laugh* Do you realize that all of you are just proposing that I exercise more?"

# game/scripts/c23/c23.rpy:1516
translate english c23s004_Oma_36ca33fd:

    # mc "*Risa* ¿Me estáis soltando indirectas de que me estoy engordando?"
    mc "*Laugh* Are you guys dropping hints that I'm getting fat?"

# game/scripts/c23/c23.rpy:1519
translate english c23s004_Oma_1640c236:

    # oma "No, sabemos que vas a correr al lago a menudo. *Risita* No necesitas más ejercicio."
    oma "No, we know you go running to the lake often. *Giggle* You don't need more exercise."

# game/scripts/c23/c23.rpy:1521
translate english c23s004_Oma_11b1b1a1:

    # oma "No, sabemos que vas a correr al lago a menudo. No necesitas más ejercicio."
    oma "No, we know you go running to the lake often. You don't need more exercise."

# game/scripts/c23/c23.rpy:1522
translate english c23s004_Oma_7b373f76:

    # oma "Pero has dicho que no tienes nada que hacer por las mañanas. *Risa* Sólo te estamos dando opciones."
    oma "But you said you have nothing to do in the mornings. *Laugh* We're just giving you options."

# game/scripts/c23/c23.rpy:1523
translate english c23s004_Oma_5dedd215:

    # mc "Ya, pero lo del yoga... Ufff..."
    mc "Yeah, but the yoga thing.... Phew..."

# game/scripts/c23/c23.rpy:1525
translate english c23s004_Oma_cd68c1c0:

    # kia "Yo quiero apuntarme algún día. Quizás el domingo. ¿Por qué no vienes, [oma]?"
    kia "I want to join sometime. Maybe on Sunday. Why don't you come, [oma]?"

