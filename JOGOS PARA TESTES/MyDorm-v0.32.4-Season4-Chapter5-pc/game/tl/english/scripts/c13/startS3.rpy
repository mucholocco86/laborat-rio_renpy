# game/scripts/c13/startS3.rpy:4
translate english startS3_8b60ce73:

    # "Jamaal" "Veo que quieres empezar una partida nueva. Pero esto es la Temporada 3 de My Dorm."
    "Jamaal" "I see you want to start a new game. But this is My Dorm's Season 4."

# game/scripts/c13/startS3.rpy:5
translate english startS3_17677279:

    # "Jamaal" "Desafortunadamente, todavía no está implementado un cuestionario como en la Temporada 2, si es que alguna vez lo está."
    "Jamaal" "Unfortunately, a questionnaire is not yet implemented as it was in Season 2, if it's ever done."

# game/scripts/c13/startS3.rpy:6
translate english startS3_fd712d46:

    # "Jamaal" "Tropecita y yo creemos que no vas a disfrutar el juego si no has jugado las temporadas previas, ya que no vas a conocer a los personajes."
    "Jamaal" "Tropecita and I believe that you're not going to enjoy the game if you haven't played the previous seasons, since you're not going to get to know the characters."

# game/scripts/c13/startS3.rpy:7
translate english startS3_2738f278:

    # "Jamaal" "Si quieres jugar la Temporada 3, debes haber jugado previamente, como mínimo, la Temporada 2 hasta el final."
    "Jamaal" "If you want to play Season 3, you must have previously played, at a minimum, Season 3 to the end."

# game/scripts/c13/startS3.rpy:8
translate english startS3_017758e4:

    # "Jamaal" "Aunque yo recomiendo que empieces desde el principio. Verás mi bonita cara mucho en las temporadas previas."
    "Jamaal" "Although I recommend you to start from the beginning. You'll see my pretty face a lot in the previous seasons."

# game/scripts/c13/startS3.rpy:9
translate english startS3_534d9fa7:

    # "Jamaal" "Puedes bajar las Temporadas 1 y 2 en los sitios habituales (Patreon, Subscribestar, y Discord)."
    "Jamaal" "You can download Seasons 1 and 2 from the usual sites (Patreon, Subscribestar, and Discord)."

# game/scripts/c13/startS3.rpy:10
translate english startS3_fbcd1a72:

    # "Jamaal" "Encontrarás los enlaces en el menú principal, en la parte inferior izquierda."
    "Jamaal" "You will find the links in the main menu at the bottom left corner."

# game/scripts/c13/startS3.rpy:11
translate english startS3_f4298b66:

    # "Jamaal" "¡Nos vemos en alguna de las temporadas anteriores!"
    "Jamaal" "See you in one of the previous seasons!"

# game/scripts/c13/startS3.rpy:12
translate english startS3_e3d39dbc:

    # "Jamaal" "Oh, no te preocupes. No soy el personaje principal de este juego. No es tan guapo como yo, pero no es mal tipo."
    "Jamaal" "Oh, don't worry. I'm not the main character in this game. He's not as handsome as me, but he's not a bad guy."

# game/scripts/c13/startS3.rpy:13
translate english startS3_bb4adb7c:

    # "Jamaal" "El juego va a salir completamente. No te asustes."
    "Jamaal" "The game is going to close. Don't panic."

# game/scripts/c13/startS3.rpy:18
translate english startS3_5120be79:

    # "Jamaal" "¡Oh! Y no te preocupes. No soy el personaje principal de este juego. No es tan guapo como yo, pero no es mal tipo."
    "Jamaal" "Oh! And don't worry. I'm not the main character in this game. He's not as handsome as me, but he's not a bad guy."

# game/scripts/c13/startS3.rpy:6
translate english startS3_7f917222:

    # "Jamaal" "Hay un cuestionario que vas a tener que rellenar, pero no es la mejor opción."
    "Jamaal" "There is a questionnaire you will have to fill out, but it is not the best option."

# game/scripts/c13/startS3.rpy:9
translate english startS3_658e70dd:

    # "Jamaal" "Si quieres jugar la Temporada 3, lo ideal es haber jugado previamente, como mínimo, la Temporada 2 hasta el final."
    "Jamaal" "If you want to play Season 3, it is best to have previously played at least Season 2 to the end."

# game/scripts/c13/startS3.rpy:15
translate english startS3_e2947f50:

    # "Jamaal" "¡Nos vemos en alguna de las temporadas anteriores! O en esta si no sigues mi consejo."
    "Jamaal" "See you in one of the previous seasons! Or in this one if you don't take my advice."
