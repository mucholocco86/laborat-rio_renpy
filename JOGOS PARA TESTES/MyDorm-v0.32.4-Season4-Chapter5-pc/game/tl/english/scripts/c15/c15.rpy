# game/scripts/c15/c15.rpy:3
translate english c15_32c3c0e6:
    # "{b}Esto es todo por esta versión. Por favor, graba aquí y nos vemos en la próxima actualización de My Dorm. Gracias por jugar y por tu apoyo. Espero que hayas disfrutado del juego.{/b}"
    "{b}That's it for this build. Please save here and see you in the next update of My Dorm. Thank you for playing and for your support. I hope you enjoyed the game.{/b}"

# game/scripts/c15/c15.rpy:185
translate english c15s001_DapDate_9988d3d9:

    # "[dap] introduce en el GPS la dirección del restaurante y conduces hasta allí. Está a poco menos de 20 minutos de la tienda de Maddie."
    "[dap] types the address of the restaurant in the GPS and you drive there. It's just under 20 minutes from Maddie's store."

# game/scripts/c15/c15.rpy:187
translate english c15s001_DapDate_ffd0c998:

    # dap "Ya hemos llegado. No te sorprendas por lo que veas ahí dentro..."
    dap "Here we are. Don't be surprised by what you see in there..."

# game/scripts/c15/c15.rpy:188
translate english c15s001_DapDate_2eb99d0b:

    # dap "O mejor aún, sorpréndete."
    dap "Or better yet, be surprised."

# game/scripts/c15/c15.rpy:189
translate english c15s001_DapDate_34550ae0:

    # mc "Ya estoy sorprendido. Esto antes era un gimnasio, ¿no? ¿Ahora es un restaurante?"
    mc "I'm already surprised. This used to be a gym, right? Now it's a restaurant?"

# game/scripts/c15/c15.rpy:191
translate english c15s001_DapDate_f0a216c1:

    # dap "Son unos cuantos restaurantes... y algo más. Lo abrieron hace unos meses. Tenía ganas de venir, pero no tenía nadie con quién venir hasta que... tú y yo... ya sabes..."
    dap "There are a few restaurants... and then something else. They opened it a few months ago. I really wanted to visit, but I didn't have anybody to come with until... you and I... you know..."

# game/scripts/c15/c15.rpy:192
translate english c15s001_DapDate_267e2c14:

    # mc "[dap], puedes decir hasta que empezamos a salir."
    mc "[dap], you can say until we started dating."

# game/scripts/c15/c15.rpy:193
translate english c15s001_DapDate_6df6d6d0:

    # dap "Lo sé, pero se me hace raro decirlo."
    dap "I know, but it feels weird to say it out loud."

# game/scripts/c15/c15.rpy:195
translate english c15s001_DapDate_5c7d5522:

    # dap "Pues ya estamos aquí."
    dap "So here we are."

# game/scripts/c15/c15.rpy:196
translate english c15s001_DapDate_b14bd407:

    # mc "¿Black Crow? Suena bien, debería haber mirado la página web. Pero es un poco pronto para ir a cenar, ¿no?"
    mc "Black Crow? Sounds good, I should have checked the website. But it's a little early to have dinner, isn't it?"

# game/scripts/c15/c15.rpy:197
translate english c15s001_DapDate_09756934:

    # dap "No creas. Tenemos que ducharnos y pasar por la peluquería. Al menos yo. Contigo no van a poder hacer gran cosa."
    dap "Not really. We have to shower and go to the hairdresser. At least I do. With your hair, they're not going to be able to do wonders."

# game/scripts/c15/c15.rpy:198
translate english c15s001_DapDate_b69e38e4:

    # mc "¿Peluquería? *Risa* ¿Dónde me has traído?"
    mc "Hairdresser? *Laugh* Where have you brought me?"

# game/scripts/c15/c15.rpy:199
translate english c15s001_DapDate_99c55155:

    # dap "Entremos y lo verás."
    dap "Let's go in and you'll discover."

# game/scripts/c15/c15.rpy:201
translate english c15s001_DapDate_117275b9:

    # _("Recepcionista") "Buenas tardes, ¿tienen reserva?"
    _("Receptionist") "Good afternoon, do you have a booking?"

# game/scripts/c15/c15.rpy:202
translate english c15s001_DapDate_0eaa88ba:

    # mc "Sí, a nombre de Marks."
    mc "Yes, my name is Marks."

# game/scripts/c15/c15.rpy:204
translate english c15s001_DapDate_420fa7af:

    # dap "¡[mc] Marks!"
    dap "[mc] Marks!"

# game/scripts/c15/c15.rpy:206
translate english c15s001_DapDate_bf0b72ec:

    # _("Recepcionista") "Ah, vale, perfecto. Tienen reserva en el restaurante Black Crow."
    _("Receptionist") "Ah, okay, perfect. You have a reservation at the Black Crow restaurant."

# game/scripts/c15/c15.rpy:207
translate english c15s001_DapDate_1ce75b02:

    # mc "Exacto."
    mc "Correct."

# game/scripts/c15/c15.rpy:208
translate english c15s001_DapDate_6a4c1705:

    # _("Recepcionista") "Entonces, subiendo por estas escaleras encontrarán el vestuario donde les atenderán mis compañeros."
    _("Receptionist") "Then, up these stairs you will find the dressing room where you will be attended to by my colleagues."

# game/scripts/c15/c15.rpy:209
translate english c15s001_DapDate_b2516466:

    # mc "Gracias."
    mc "Thanks."

# game/scripts/c15/c15.rpy:211
translate english c15s001_DapDate_8bec7690:

    # mc "¿Vestuario? Ahí es donde nos podremos duchar, supongo."
    mc "Dressing room? That's where we can shower, I guess."

# game/scripts/c15/c15.rpy:212
translate english c15s001_DapDate_a768d130:

    # dap "Y cambiarnos. Vas a poder elegir a tu gusto. Tan solo recuerda esto. 14. Para ir a juego."
    dap "And change clothes. You will be able to choose what you want. Just remember this. 14. To be coordinated."

# game/scripts/c15/c15.rpy:213
translate english c15s001_DapDate_0f97df03:

    # mc "Estás siendo muy misteriosa."
    mc "You're being really mysterious."

# game/scripts/c15/c15.rpy:215
translate english c15s001_DapDate_a11aa689:

    # dap "¿Quieres que te lo cuente todo y estropee la sorpresa?"
    dap "Do you want me to tell you everything and spoil the surprise?"

# game/scripts/c15/c15.rpy:216
translate english c15s001_DapDate_4a5ebed8:

    # mc "No, prefiero que me sorprendas, pero sigo pensando que es un poco pronto para cenar."
    mc "No, I'd rather you surprise me, but I still think it's a little early for dinner."

# game/scripts/c15/c15.rpy:217
translate english c15s001_DapDate_90d35b9d:

    # dap "No te preocupes, entre ducha, cambiarme, y peluquería yo voy a tardar cerca de una hora."
    dap "Don't worry, between showering, changing, and hairdressing I'm going to spend about an hour."

# game/scripts/c15/c15.rpy:218
translate english c15s001_DapDate_c476ef12:

    # mc "¿Qué? ¿Una hora?"
    mc "What? An hour?"

# game/scripts/c15/c15.rpy:220
translate english c15s001_DapDate_faf803d9:

    # dap "Querrás que tu novia esté guapa en nuestra primera cita, ¿verdad?"
    dap "You want your girlfriend to look pretty on our first date, don't you?"

# game/scripts/c15/c15.rpy:221
translate english c15s001_DapDate_742b9e83:

    # mc "[dap], tú estás guapa siempre, pero esperaré. Cada vez siento más curiosidad."
    mc "[dap], you always look beautiful, but I'll wait. I'm getting more and more intrigued."

# game/scripts/c15/c15.rpy:222
translate english c15s001_DapDate_89e81213:

    # dap "Bueno, la curiosidad se acabará en cuanto entres por esa puerta. Nos vemos en una hora."
    dap "Well, your curiosity will be over as soon as you walk through that door. See you in an hour."

# game/scripts/c15/c15.rpy:224
translate english c15s001_DapDate_bcb25274:

    # "Es el momento de saber a qué viene tanto secretismo."
    "It's time to find out what all the secrecy is about."

# game/scripts/c15/c15.rpy:226
translate english c15s001_DapDate_02f50975:

    # "Entras en el vestuario y te está esperando alguien de la plantilla vestido como la recepcionista."
    "You walk into the dressing room and someone from the staff is waiting for you, dressed like the receptionist."

# game/scripts/c15/c15.rpy:227
translate english c15s001_DapDate_1c1c93b1:

    # "Elliot" "Buenas tardes, Sr. Marks. Soy Elliot y seré su Ayudante de Vestuario."
    _("Elliot") "Good afternoon, Mr. Marks. I'm Elliot and I'll be your Wardrobe Assistant."

# game/scripts/c15/c15.rpy:228
translate english c15s001_DapDate_14dedc8d:

    # "Elliot" "Tiene las duchas al fondo. Recomendamos su uso antes de cambiarse."
    _("Elliot") "The showers are in the back. We recommend using them before getting dressed."

# game/scripts/c15/c15.rpy:229
translate english c15s001_DapDate_4a8bf992:

    # mc "Perfecto. Venimos de la playa y necesito una ducha. Pero no he traído ropa."
    mc "Great. We just came from the beach and I need a shower. But I didn't bring any clothes."

# game/scripts/c15/c15.rpy:230
translate english c15s001_DapDate_b8a43021:

    # "Elliot" "Veo que es su primera vez en nuestras instalaciones. ¿Quiere que le explique cómo funciona?"
    _("Elliot") "I see this is your first time at our premises - would you like me to explain how it works?"

# game/scripts/c15/c15.rpy:231
translate english c15s001_DapDate_890c041b:

    # mc "Por supuesto."
    mc "Yes, please."

# game/scripts/c15/c15.rpy:233
translate english c15s001_DapDate_4f648d8a:

    # "Elliot" "Lo primero que me tiene que decir es de qué siglo se quiere vestir. Puede ser XIV, XVI, o XVIII. Eso nos ayuda a que las salas sean más homogéneas y a la inmersión de los clientes."
    _("Elliot") "The first thing you have to tell me is what century style you want to dress in. It can be 14th, 16th, or 18th. That helps us make the rooms more homogeneous and immersive for the customers."

# game/scripts/c15/c15.rpy:234
translate english c15s001_DapDate_58e3f529:

    # mc "Mi novia me ha dicho que recuerde el número 14. Supongo que se refería a esto. No sabía que era un restaurante temático."
    mc "My girlfriend told me to remember number 14. I guess she meant this. I didn't know it was a themed restaurant."

# game/scripts/c15/c15.rpy:235
translate english c15s001_DapDate_72269408:

    # "Elliot" "Perfecto. Siendo el Siglo XIV puede escoger entre vestirse de caballero, cortesano, o pícaro. Teníamos un disfraz de campesino, pero no triunfó demasiado."
    _("Elliot") "Perfect. In the 14th Century, you can choose to dress up as a knight, courtier, or rogue. We had a peasant costume, but it didn't succeed too well."

# game/scripts/c15/c15.rpy:236
translate english c15s001_DapDate_4a851eec:

    # mc "¿Caballero con armadura, espada y esas cosas?"
    mc "Knight with armor, sword and stuff?"

# game/scripts/c15/c15.rpy:238
translate english c15s001_DapDate_52998d60:

    # "Elliot" "Sí a la armadura, no a la espada. No proporcionamos armas, lo siento. Pese a que es uno de los más populares, le tengo que avisar que no es el más cómodo."
    _("Elliot") "Yes to armor, no to sword. We do not provide weapons, sorry. Despite being one of the most popular, I have to warn you that it's not the most comfortable."

# game/scripts/c15/c15.rpy:239
translate english c15s001_DapDate_2d013c95:

    # "Elliot" "Estar cenando con armadura, aunque sea falsa, puede resultar un poco incómodo si no está acostumbrado."
    _("Elliot") "Dining in armor, even if it's a fake one, can be a little uncomfortable if you're not used to it."

# game/scripts/c15/c15.rpy:240
translate english c15s001_DapDate_d4e39871:

    # mc "¿Podría probarme los tres y decidir?"
    mc "Could I try on all three and decide?"

# game/scripts/c15/c15.rpy:241
translate english c15s001_DapDate_aa2be2e3:

    # "Elliot" "No lo podemos permitir por un tema de higiene. Todos nuestros disfraces se envían a la lavandería después de cada uso."
    _("Elliot") "Sorry, we can't allow it because of hygiene concerns. All our costumes are sent to the laundry after each use."

# game/scripts/c15/c15.rpy:242
translate english c15s001_DapDate_605879ae:

    # mc "Entonces me disfrazaré de..."
    mc "Then I'll disguise as..."

# game/scripts/c15/c15.rpy:251
translate english c15s001_DapDate_12d962b0:

    # "Elliot" "Perfecto. Pues si quiere pasar a la ducha y le preparo su ropa. Se la dejaré en la taquilla. Aquí tiene la llave. Número 93. La combinación es 23129. Supongo que no quiere servicio de peluquería."
    _("Elliot") "Perfect. If you'd like to step into the shower, I'll get your clothes ready for you. I'll leave them in your locker. Number 93. The combination is 23129. I guess you don't need the hairdresser's service."

# game/scripts/c15/c15.rpy:252
translate english c15s001_DapDate_447ba67f:

    # mc "No, no es necesario. ¿Por qué lo dice?"
    mc "No, it's not needed, why do you say that?"

# game/scripts/c15/c15.rpy:253
translate english c15s001_DapDate_9cc3265b:

    # "Elliot" "Normalmente los clientes masculinos suelen rechazarlo a menos que lleven el pelo largo."
    _("Elliot") "Usually, male clients tend to reject it unless they have long hair."

# game/scripts/c15/c15.rpy:254
translate english c15s001_DapDate_6464cdcf:

    # mc "Entonces seré como el resto. *Risa* Rechazaré el servicio de peluquería."
    mc "Then I'll be like the rest. *Laugh* I'll refuse the hairdressing service."

# game/scripts/c15/c15.rpy:255
translate english c15s001_DapDate_99dbf3ae:

    # "Elliot" "Perfecto. Cuando esté listo, o si necesita ayuda para vestirse, llame a aquel timbre y volveré para acompañarle a la sala de espera."
    _("Elliot") "Perfect. When you're ready, or if you need help getting dressed, ring that bell and I'll be back to escort you to the waiting room."

# game/scripts/c15/c15.rpy:257
translate english c15s001_DapDate_12356f46:

    # "Después de darle tu talla, pasas a la ducha. Está claro que han mantenido las instalaciones del antiguo gimnasio."
    "After you tell Elliot your size, you step into the shower. It's clear they've kept the old gym facilities."

# game/scripts/c15/c15.rpy:258
translate english c15s001_DapDate_fb07d82b:

    # "Al volver tienes tu disfraz en la taquilla. Tienes curiosidad por saber cómo te va a quedar. Y especialmente tienes curiosidad sobre cómo se va a vestir [dap]. Esperas haber acertado."
    "When you finish your shower, the costume is already in the locker. You're intrigued about how it's going to look on you. And you're especially curious about how [dap] is going to dress. You hope you've got it right."

# game/scripts/c15/c15.rpy:261
translate english c15s001_DapDate_1b8f0299:

    # mc "No quedo mal de caballero. Aunque el escudero tenía razón. No es muy cómodo. *Risa* Escudero... ya me estoy metiendo en el papel."
    mc "I don't look bad as a knight. Although the squire was right. It's not very comfortable. *Laugh* Squire... I'm already getting into the role."

# game/scripts/c15/c15.rpy:264
translate english c15s001_DapDate_c35f0399:

    # mc "El disfraz de cortesano es chulo. El tacto es suave. Me alegra haber hecho caso al sirviente y no haber cogido el de caballero. *Risa* Sirviente... ya me estoy metiendo en el papel."
    mc "The courtier costume is cool. The feel is soft. I'm glad I listened to the servant and didn't get the knight one. *laugh* Servant... I'm already getting into the role."

# game/scripts/c15/c15.rpy:267
translate english c15s001_DapDate_2a2c73a7:

    # mc "Creo que Vilfredo vestirá así en la partida de DnD. Me alegra haber hecho caso al tabernero y no haber cogido el de caballero. *Risa* Tabernero... ya me estoy metiendo en el papel."
    mc "I think Vilfredo will dress like this in the DnD game. I'm glad I listened to the innkeeper and didn't pick the knight costume. *Laugh* Innkeeper... I'm already getting into the role."

# game/scripts/c15/c15.rpy:269
translate english c15s001_DapDate_ee7db50a:

    # "Justo cuando vas a pulsar el timbre para llamar a Elliot, te das cuenta de que no estás solo en el vestuario."
    "Just as you go to press the buzzer to call Elliot, you realize you're not alone in the locker room."

# game/scripts/c15/c15.rpy:270
translate english c15s001_DapDate_e6341375:

    # _("Hombre") "Buenas tardes. ¿Siglo XIV?"
    _("Man") "Good afternoon. 14th Century?"

# game/scripts/c15/c15.rpy:271
translate english c15s001_DapDate_fa27330b:

    # mc "Hola, buenas tardes. Sí."
    mc "Good afternoon. Yes, 14th Century. And you?"

# game/scripts/c15/c15.rpy:272
translate english c15s001_DapDate_30081bbe:

    # _("Hombre") "Nosotros estuvimos la semana pasada. Hoy toca cenar en el Siglo XXXII. Lo han abierto esta semana. Supongo que mi mujer se disfrazará de Princesa Laia. ¿De qué se disfrazará su esposa?"
    _("Man") "We were there, or then, last week. Today it's dinner at 33rd Century. They opened it this week. I guess my wife will dress up as Princess Laia. What will your wife dress up as?"

# game/scripts/c15/c15.rpy:273
translate english c15s001_DapDate_9ccdfc53:

    # mc "Mi novia. No lo sé, es la primera vez que venimos y yo ni siquiera sabía qué tipo de restaurante era."
    mc "My girlfriend. I don't know, it's the first time we've been here and I didn't even know what kind of restaurant it was."

# game/scripts/c15/c15.rpy:275
translate english c15s001_DapDate_20d0961c:

    # _("Hombre") "Si es la primera vez, prepárate para esperar. A nosotros nos dan tres o cuatro opciones, dependiendo del restaurante. A ellas les dan seis o siete."
    _("Man") "If it's your first time here, be prepared to wait. We get three or four choices, depending on the restaurant. They get six or seven."

# game/scripts/c15/c15.rpy:276
translate english c15s001_DapDate_9353de80:

    # mc "Pero no pudiéndoselos probar, no tardarán tanto, ¿no?"
    mc "But not being able to try on the dresses, it won't take that long, will it?"

# game/scripts/c15/c15.rpy:278
translate english c15s001_DapDate_a3241e0f:

    # _("Hombre") "No se los pueden probar, pero pueden verlos en la percha. Mi mujer se pasó 20 minutos intentando decidir entre siete vestidos la semana pasada."
    _("Man") "They can't try them on, but they can see them on the hanger. My wife spent 20 minutes trying to decide between seven dresses last week."

# game/scripts/c15/c15.rpy:279
translate english c15s001_DapDate_2ef2849b:

    # _("Hombre") "Y obviamente, una vez deciden el vestido, tienen que decidir qué peinado le pega mejor a ese estilo. Media hora más. Espero que tengas batería en el móvil. *Risa*"
    _("Man") "And, obviously, once they decide on the dress, they have to decide what hairstyle best suits that style. Another half hour. I hope you have enough battery on your cell phone. *Laugh*"

# game/scripts/c15/c15.rpy:280
translate english c15s001_DapDate_0b486eb8:

    # mc "*Risa* Sí, por suerte voy servido de batería."
    mc "*Laughter* Yes, luckily I have a full battery. I charged the phone in the car coming here."

# game/scripts/c15/c15.rpy:282
translate english c15s001_DapDate_3659900c:

    # _("Hombre") "Bueno, te dejo con tu espera. Ahí viene mi copiloto."
    _("Man") "Well, I'll leave you to your wait. Here comes my copilot."

# game/scripts/c15/c15.rpy:283
translate english c15s001_DapDate_021a7a94:

    # mc "Que pase una buena noche."
    mc "Have a nice evening."

# game/scripts/c15/c15.rpy:284
translate english c15s001_DapDate_00c9df17:

    # _("Hombre") "Igualmente, hijo."
    _("Man") "Same, son."

# game/scripts/c15/c15.rpy:286
translate english c15s001_DapDate_6397acfa:

    # "Elliot os lleva a diferentes salas de espera y te sientas a hacer tiempo hasta que [dap] esté preparada. Por lo que ha dicho el hombre en el vestuario, te tocará esperar un rato."
    "Elliot takes you to different waiting rooms and you sit around killing time until [dap] is ready. From what the man in the locker room said, you're in for a bit of a wait."

# game/scripts/c15/c15.rpy:287
translate english c15s001_DapDate_82ffc13f:

    # "Cuando ya has leído todas las noticias locales, internacionales, sobre videojuegos, e incluso sobre la vida de los famosos..."
    "When you've already read all the local and international news, news about video games, and even news about celebrities' lives..."

# game/scripts/c15/c15.rpy:288
translate english c15s001_DapDate_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c15/c15.rpy:289
translate english c15s001_DapDate_33a3ac7f:

    # mcp "(¿Número oculto?)"
    mcp "(A hidden number?)"

# game/scripts/c15/c15.rpy:303
translate english c15s001_DapDate_27e07c02:

    # "Justo al colgar, oyes pasos en las escaleras por las que has bajado."
    "Just as you hang up, you hear footsteps on the stairs you descended so long ago."

# game/scripts/c15/c15.rpy:304
translate english c15s001_DapDate_4c40f33f:

    # dap "¿Llevas mucho tiempo esperándome?"
    dap "Have you been waiting for me for a long time?"

# game/scripts/c15/c15.rpy:314
translate english c15s001_DapDate_f4004887:

    # mc "¡Wow, [dap]! ¡Pareces salida de un cuento de hadas! Estás preciosa."
    mc "Wow, [dap]! You look like something out of a fairy tale! You are gorgeous."

# game/scripts/c15/c15.rpy:315
translate english c15s001_DapDate_4d29251f:

    # dap "¡Gracias, [mc]! Me preocupaba quedar ridícula."
    dap "Thank you, [mc]! I was worried about looking ridiculous."

# game/scripts/c15/c15.rpy:317
translate english c15s001_DapDate_76a5d3f6:

    # dap "Tú también estás muy guapo, pero no sé si va a ser cómodo cenar con la armadura."
    dap "You look handsome too, but I don't know if it's going to be comfortable to dine in armor."

# game/scripts/c15/c15.rpy:318
translate english c15s001_DapDate_8d6b7b9b:

    # mc "Me lo ha comentado el ayudante del vestuario, pero no podía dejarlo pasar."
    mc "The assistant in the dressing room told me about it, but I couldn't let it pass."

# game/scripts/c15/c15.rpy:320
translate english c15s001_DapDate_343db1df:

    # dap "Lástima que no hayas hecho a Vilfredo un guerrero o un paladín. Me hubiera gustado imaginarte así en la partida."
    dap "Too bad you didn't make Vilfredo a warrior or a paladin. I would have liked to imagine you like this in the game."

# game/scripts/c15/c15.rpy:322
translate english c15s001_DapDate_48b8e592:

    # dap "Tú también estás muy guapo, te queda genial el look de... ¿príncipe?"
    dap "You look handsome too, you look great in the... prince role?"

# game/scripts/c15/c15.rpy:323
translate english c15s001_DapDate_d6612785:

    # mc "Oficialmente cortesano, pero si quieres que sea tu príncipe solo tienes que pedirlo."
    mc "Officially a courtier, but if you want me to be your prince, all you have to do is ask."

# game/scripts/c15/c15.rpy:325
translate english c15s001_DapDate_9cc03b0f:

    # dap "Lástima que no hayas hecho a Vilfredo noble. Me hubiera gustado imaginarte así en la partida."
    dap "Too bad you didn't make Vilfredo a nobleman. I would have liked to imagine you like this in the game."

# game/scripts/c15/c15.rpy:327
translate english c15s001_DapDate_ea236d73:

    # dap "Tú también estás muy guapo, te queda genial el look de... ¿espadachín?"
    dap "You look handsome too, you look great in the... swashbuckler role?"

# game/scripts/c15/c15.rpy:328
translate english c15s001_DapDate_994e2502:

    # mc "Me lo han ofrecido como pícaro y, después de generar el personaje de Vilfredo, no podía dejarlo pasar. Quiero que vista parecido a esto, si es posible."
    mc "I've been offered it as a rogue and, after creating Vilfredo's character, I couldn't pass it up. I want him to dress similar to this, if possible."

# game/scripts/c15/c15.rpy:330
translate english c15s001_DapDate_93c0bc47:

    # dap "Ningún problema. No me perdería un pícaro tan guapo por nada del mundo."
    dap "No problem. I wouldn't miss such a handsome rogue for the world."

# game/scripts/c15/c15.rpy:331
translate english c15s001_DapDate_e5242538:

    # mc "Vas a hacer que este pobre pícaro se ruborice. *Risa*"
    mc "You're going to make this poor rogue blush. *Laugh*"

# game/scripts/c15/c15.rpy:333
translate english c15s001_DapDate_ec28650e:

    # dap "¿Pasamos a cenar? Tengo ganas de ver el restaurante."
    dap "Shall we go in for dinner? I'm looking forward to seeing the restaurant."

# game/scripts/c15/c15.rpy:334
translate english c15s001_DapDate_c996350e:

    # mc "Cuando quieras. A mí me ha entrado hambre mientras esperaba. Pero la espera ha valido la pena."
    mc " Whenever you want. I got hungry while I was waiting. But it was worth the wait."

# game/scripts/c15/c15.rpy:337
translate english c15s001_DapDate_08921eec:

    # dap "Gracias, mi amable caballero."
    dap "Thanks, my kind knight."

# game/scripts/c15/c15.rpy:340
translate english c15s001_DapDate_6cada05b:

    # dap "Gracias, mi apuesto príncipe."
    dap "Thanks, my handsome prince."

# game/scripts/c15/c15.rpy:343
translate english c15s001_DapDate_dbf1df63:

    # dap "Gracias, mi pícaro seductor."
    dap "Thank you, my roguish seducer."

# game/scripts/c15/c15.rpy:345
translate english c15s001_DapDate_607ded3e:

    # "Llamáis al timbre y aparece alguien nuevo del personal."
    "You ring the doorbell and someone from the staff shows up."

# game/scripts/c15/c15.rpy:346
translate english c15s001_DapDate_d17bca35:

    # "Mathilda" "Buenas tardes les de Dios a vuesas mercedes. Mi nombre es Mathilda. Si tienen el placer de acompañarme, les guiaré a su mesa para que puedan disfrutar del yantar."
    "Mathilda" "Good afternoon to thee, lady and gentleman. My name is Mathilda. If ye have the pleasure of joining me, I will guide thee to thy table so that ye may enjoy thy repast."

# game/scripts/c15/c15.rpy:348
translate english c15s001_DapDate_e3023a37:

    # dap "Cuando quiera. Estamos listos."
    dap "Anytime. We're ready."

# game/scripts/c15/c15.rpy:349
translate english c15s001_DapDate_23a0c42a:

    # mc "*Susurrando* Ahora pillo lo del acento raro del tipo que me cogió el teléfono. Era este falso acento medieval."
    mc "*Whispering* Now I get the weird accent of the guy who picked up the phone for me. It was this fake medieval accent."

# game/scripts/c15/c15.rpy:351
translate english c15s001_DapDate_f92c238c:

    # dap "De momento me está gustando, y eso que aún no hemos visto el restaurante."
    dap "So far I'm liking it, even though we haven't seen the restaurant yet."

# game/scripts/c15/c15.rpy:352
translate english c15s001_DapDate_35cd64fb:

    # mc "El vestido te queda increíble, y el peinado te hace preciosa... más preciosa de lo habitual."
    mc "The dress looks amazing on you, and the hairstyle makes you gorgeous... even more gorgeous than usual."

# game/scripts/c15/c15.rpy:354
translate english c15s001_DapDate_08e27722:

    # dap "Gracias, pero debería haberme quedado con mi trenza. También pega con el vestido y hubiera estado más cómoda. No me siento demasiado confortable con esto."
    dap "Thank you, but I should have kept my braid. It also matches the dress and I would have been more comfortable. I don't feel too comfortable with this one."

# game/scripts/c15/c15.rpy:355
translate english c15s001_DapDate_b7322079:

    # mc "Bueno, cuando volvamos al vestuario tendrás que devolver todo, incluidos los anillos del pelo. Solo será una hora o dos, ¿no?"
    mc "Well, when we get back to the locker room you'll have to return everything, including the hair rings. It'll only be an hour or two, won't it?"

# game/scripts/c15/c15.rpy:357
translate english c15s001_DapDate_b001bca2:

    # "Atravesáis todo el restaurante y Mathilda os lleva a una zona que parece tranquila. El restaurante parece salido de una película. Al menos es una de aquellas películas donde todo está limpio."
    "You walk through the entire restaurant and Mathilda leads you to an area that looks quiet. The restaurant looks like something out of a movie. At least it's one of those movies where everything is clean."

# game/scripts/c15/c15.rpy:359
translate english c15s001_DapDate_f87f2ef8:

    # "Mathilda" "Hoy está bastante vacío, y esta es la zona más resguardada de miradas ajenas. ¿Les va bien sentarse aquí?"
    "Mathilda" "It's pretty empty today, and this is the area most sheltered from prying eyes. Does it suit thy excellencies to sit here?"

# game/scripts/c15/c15.rpy:360
translate english c15s001_DapDate_39d84591:

    # mc "Gracias, Mathilda, es perfecto."
    mc "Thanks, Mathilda, it's perfect."

# game/scripts/c15/c15.rpy:361
translate english c15s001_DapDate_a8caf72d:

    # "Mathilda" "¿Saben cómo funciona el menú? Si quieren se lo explico."
    "Mathilda" "Do ye know how the menu works? I'll explain it to thee if you want."

# game/scripts/c15/c15.rpy:362
translate english c15s001_DapDate_8b13deee:

    # mc "Sí, por favor."
    mc "Yes, please."

# game/scripts/c15/c15.rpy:363
translate english c15s001_DapDate_a1ac9ffa:

    # "Mathilda" "Nuestros platos son típicos de la Europa medieval, pero con un toque moderno, con lo que pueden encontrar ingredientes como patata o maíz, que no estaban disponibles en la época."
    "Mathilda" "Our dishes are typical of medieval Europe, but with a modern twist, so ye can find ingredients like potato or corn, which were not available at the time."

# game/scripts/c15/c15.rpy:364
translate english c15s001_DapDate_72902248:

    # "Mathilda" "Nosotros recomendamos el menú degustación mixto, de carne, o de pescado, donde podrán disfrutar de algunas de nuestras especialidades. También pueden pedir platos individuales."
    "Mathilda" "We recommend the mixed meat, or fish tasting menus, so ye can enjoy some of our specialties. Ye can also order individual dishes."

# game/scripts/c15/c15.rpy:366
translate english c15s001_DapDate_9603f8f9:

    # dap "Yo querré el menú degustación mixto. Y cerveza tostada para beber."
    dap "I'll have the mixed tasting menu, please. And toasted beer to drink."

# game/scripts/c15/c15.rpy:367
translate english c15s001_DapDate_33d9f672:

    # mc "¿Qué platos individuales tienen? Cosas con carne, por favor."
    mc "What individual dishes do you have? Things with meat, please."

# game/scripts/c15/c15.rpy:369
translate english c15s001_DapDate_8f5494fa:

    # "Mathilda" "Tenemos asado del pastor, que lleva patata sustituyendo al nabo, cazuela del granjero, que lleva maíz para sustituir a la avena, chuletas con salsa de calabaza, o albóndigas de ternera."
    "Mathilda" "We have shepherd's roast, which has potato replacing turnip, farmer's casserole, which has corn replacing oatmeal, chops with pumpkin sauce, or veal meatballs."

# game/scripts/c15/c15.rpy:370
translate english c15s001_DapDate_a9336dad:

    # "Mathilda" "El menú degustación de carne consiste en asado del pastor, cazuela del granjero y las albóndigas de ternera. Normalmente lo recomendamos para compartir entre dos personas."
    "Mathilda" "The meat tasting menu consists of shepherd's roast, farmer's casserole, and veal meatballs. We usually recommend it for two people to share."

# game/scripts/c15/c15.rpy:371
translate english c15s001_DapDate_841d565c:

    # "Mathilda" "Con una ensalada o unas verduras para compartir como complemento."
    "Mathilda" "With a salad or some vegetables to share as a side dish."

# game/scripts/c15/c15.rpy:372
translate english c15s001_DapDate_044c02a7:

    # mc "¿Ensalada? ¿Verduras? *Risa* Esa es la comida de mi comida... Siempre he querido decir esa frase."
    mc "Salad? Vegetables? *Laugh* That's the food that my food eats... I've always wanted to say that sentence."

# game/scripts/c15/c15.rpy:384
translate english c15s001_DapDate_d26cabd8:

    # mc "Pero si algún plato lleva brócoli, no lo ponga, por favor. Soy alérgico."
    mc "But if any dish has broccoli in it, please remove it. I'm allergic to it."

# game/scripts/c15/c15.rpy:385
translate english c15s001_DapDate_0b9b511f:

    # "Mathilda" "Como vuesa merced desee. ¿Para beber, señor?"
    "Mathilda" "As thou wish. To drink, sir?"

# game/scripts/c15/c15.rpy:386
translate english c15s001_DapDate_40c4e7c6:

    # mc "Agua. Tengo que conducir luego."
    mc "Water, please. I have to drive later."

# game/scripts/c15/c15.rpy:388
translate english c15s001_DapDate_f4abf09d:

    # dap "Tráigale una cerveza tostada también a él. Vamos a tardar mucho en coger el coche."
    dap "Bring him a toasted beer too. It's going to be a while before we'll need the car."

# game/scripts/c15/c15.rpy:390
translate english c15s001_DapDate_5663e49e:

    # "Mathilda" "Perfecto. Voy a cursar su pedido y ahora mismo les traigo la bebida."
    "Mathilda" "Perfect. I'll place thine order and bring thee thy drinks right away."

# game/scripts/c15/c15.rpy:392
translate english c15s001_DapDate_ec98a50b:

    # dap "¿Desde cuándo eres alérgico al brócoli? No lo sabía."
    dap "Since when are you allergic to broccoli? I didn't know."

# game/scripts/c15/c15.rpy:393
translate english c15s001_DapDate_f6a5786d:

    # mc "*Risa* No soy alérgico, pero para mí estropea cualquier comida. Siempre digo \"si lleva brócoli no lo pongan\" y la mitad de las veces se olvidan."
    mc "*Laugh* I'm not allergic to it, but it spoils any meal for me. I always say \"if it has broccoli in it don't put it in\" and half the time they forget."

# game/scripts/c15/c15.rpy:394
translate english c15s001_DapDate_4db266ee:

    # mc "Diciendo que soy alérgico, van con cuidado de no ponerlo. No se han olvidado ni una sola vez."
    mc "When I tell them I'm allergic, they're careful not to put it in. They haven't forgotten once."

# game/scripts/c15/c15.rpy:395
translate english c15s001_DapDate_de7990a8:

    # dap "Es una buena idea. Poco honesta, pero buena idea. Aunque si pidiéndolo correctamente no te hacen caso, es la única forma que te queda de hacerlo."
    dap "It's a good idea. Not very honest, but a good idea. Although if you ask for it properly and they don't listen to you, saying you're allergic to them is the way to go."

# game/scripts/c15/c15.rpy:397
translate english c15s001_DapDate_0799ddb5:

    # dap "Cambiando de tema, ¿qué te parece el sitio? Es original, ¿verdad?"
    dap "Changing the subject, what do you think of the place? It's original, isn't it?"

# game/scripts/c15/c15.rpy:398
translate english c15s001_DapDate_71dbec9b:

    # mc "Es muy original, e ir así vestidos le da un giro interesante, es como si tuvieras una inmersión total."
    mc "It's very original and being dressed like this gives it an interesting twist, it's like you have total immersion."

# game/scripts/c15/c15.rpy:399
translate english c15s001_DapDate_6ef36d5e:

    # dap "Yo siempre he querido probar algo así, sentirte dentro de una partida de DnD, aunque solo sea durante la cena."
    dap "I've always wanted to try something like this, to feel like I'm inside a DnD game, even if it's only during dinner."

# game/scripts/c15/c15.rpy:400
translate english c15s001_DapDate_4951d89e:

    # mc "Si en la partida visitamos una taberna o una posada, será difícil imaginársela diferente a esto."
    mc "If in the game we visit a tavern or an inn, it will be hard to imagine it any different than this."

# game/scripts/c15/c15.rpy:402
translate english c15s001_DapDate_4bc16d01:

    # dap "Esa era una de las razones para traerte aquí. *Risa* Quiero que sepas qué cosas me gustan. No hemos tenido mucho tiempo de hablar de hobbies y nimiedades."
    dap "That was one of the reasons for bringing you here. *Laugh* I want you to know what things I like. We haven't had much time to talk about hobbies and trifles."

# game/scripts/c15/c15.rpy:403
translate english c15s001_DapDate_40e70b21:

    # mc "Bueno, sé que te gusta estudiar, leer y aprender, los videojuegos, los juegos de rol... ¿la música pop?"
    mc "Well, I know you like to study, read, and learn, video games, role-playing games, and... pop music?"

# game/scripts/c15/c15.rpy:404
translate english c15s001_DapDate_f77f275c:

    # dap "*Risa* Sí, la música pop. Si llegas a fallar en eso... Te hubiera torturado con los peores discos de Taylor Shift. *Risa*"
    dap "*Laugh* Yes, Pop music. If you ever failed at that... I would have tortured you with the worst Taylor Shift's records. *Laugh*"

# game/scripts/c15/c15.rpy:406
translate english c15s001_DapDate_0ae8448f:

    # dap "Pero a lo que me refiero es a que me encanta este ambiente. Hacer cosas diferentes. No soy tan aventurera como [emm], pero en un sitio así me siento... especial."
    dap "But what I mean is that I love this environment. Doing unusual stuff. I'm not as adventurous as [emm], but in a place like this I feel... special."

# game/scripts/c15/c15.rpy:407
translate english c15s001_DapDate_70fffa0f:

    # mc "[dap], tú eres especial. Nunca se me hubiera ocurrido venir a un restaurante así, con lo que la noche ya es diferente."
    mc "[dap], you are special. I would never have thought of coming to a restaurant like this, so the evening is already different."

# game/scripts/c15/c15.rpy:408
translate english c15s001_DapDate_251aa2ff:

    # mc "Pasarla contigo, vestida así, la hace verdaderamente especial."
    mc "Spending it with you, dressed like that, makes it truly special."

# game/scripts/c15/c15.rpy:410
translate english c15s001_DapDate_7937683b:

    # dap "No creía que vestirme de molinera para una cita fuera lo mejor, lo mismo que de tabernera. Imagínate que las otras mesas empiezan a pedirme cosas. *Risa*"
    dap "I didn't think dressing up as a miller for a date was the best thing to do, the same as a tavern keeper. Imagine if the other tables start ordering stuff from me. *Laugh*"

# game/scripts/c15/c15.rpy:411
translate english c15s001_DapDate_5e2c75b5:

    # mc "Vestida de tabernera seguro que estabas monísima, pero no puedo imaginarme a una molinera sexy. *Risa* Ni siquiera a ti."
    mc "Dressed as a tavern keeper you sure looked cute, but I can't imagine a sexy miller. *Laugh* Not even you."

# game/scripts/c15/c15.rpy:412
translate english c15s001_DapDate_51b8bcd3:

    # dap "Había un disfraz de guerrera, pero seguía la norma de Hollywood para las armaduras femeninas de que cuanto menos cubra más protege. *Risa*"
    dap "There was a warrior costume, but it followed the Hollywood rule for female armor that the less it covers the more it protects. *Laugh*"

# game/scripts/c15/c15.rpy:413
translate english c15s001_DapDate_f95f3509:

    # mc "Interesante. No me hubiera importado verte así. *Risa*"
    mc "Interesting. I wouldn't have minded seeing you like that. *Laugh*"

# game/scripts/c15/c15.rpy:414
translate english c15s001_DapDate_0c601860:

    # dap "No seas impaciente. *Risa* Me verás con menos cobertura hoy... si quieres..."
    dap "Don't be impatient. *Laugh* You'll see me with less on today... if you want to..."

# game/scripts/c15/c15.rpy:415
translate english c15s001_DapDate_a49f5d57:

    # mc "Por supuesto que quiero, si es lo que quieres tú."
    mc "Of course I want to, if that's what you want."

# game/scripts/c15/c15.rpy:417
translate english c15s001_DapDate_8433b02a:

    # dap "Llevo deseándolo desde nuestra segunda lección. Con lo que sí. Es lo que quiero."
    dap "I've been looking forward to it since our second lesson. So yes, it's what I want."

# game/scripts/c15/c15.rpy:418
translate english c15s001_DapDate_7e494062:

    # mc "Yo también llevo tiempo deseándolo."
    mc "I've been looking forward to it for a while, too."

# game/scripts/c15/c15.rpy:419
translate english c15s001_DapDate_9a30c032:

    # "Justo en ese momento, Mathilda trae las cervezas."
    "Just then, Mathilda brings the beers."

# game/scripts/c15/c15.rpy:421
translate english c15s001_DapDate_849e9eb6:

    # dap "Por una noche especial con mi novio. Mi primer novio."
    dap "To a special night with my boyfriend. My first boyfriend."

# game/scripts/c15/c15.rpy:422
translate english c15s001_DapDate_4fab5f29:

    # mc "Por la chica más especial de la noche."
    mc "To the most special girl of the night."

# game/scripts/c15/c15.rpy:424
translate english c15s001_DapDate_f9c75c73:

    # dap "¡Está buenísima!"
    dap "It's very tasty!"

# game/scripts/c15/c15.rpy:425
translate english c15s001_DapDate_f057ccd6:

    # mc "*Risa*"
    mc "*Laugh*"

# game/scripts/c15/c15.rpy:427
translate english c15s001_DapDate_a147bdfe:

    # dap "¿Qué pasa?"
    dap "What's up?"

# game/scripts/c15/c15.rpy:428
translate english c15s001_DapDate_adaea1c1:

    # mc "Que estás super graciosa con el bigote de espuma, aunque no te pega con el vestido. *Risa* Te pegaría más con un uniforme de fontanero y una gorra roja."
    mc "That you look super funny with the foam mustache, although it doesn't suit your dress. *Laugh* It would suit you better if you wore a plumber's uniform and a red cap."

# game/scripts/c15/c15.rpy:430
translate english c15s001_DapDate_55ee868d:

    # dap "¡Oops, perdón! *Risa* Tendré que beber como una princesita."
    dap "Oops, sorry! *Laugh* I should drink like a classy princess."

# game/scripts/c15/c15.rpy:431
translate english c15s001_DapDate_536b041f:

    # mc "*Risa*. Ya te he dicho que estabas muy graciosa."
    mc "*Laugh*. I said you looked very funny."

# game/scripts/c15/c15.rpy:433
translate english c15s001_DapDate_2be763cd:

    # dap "Pero no quiero estar graciosa. Quiero estar guapa y sexy para ti en nuestra primera cita."
    dap "But I don't want to look funny. I want to look pretty and sexy for you on our first date."

# game/scripts/c15/c15.rpy:434
translate english c15s001_DapDate_9b23af18:

    # mc "[dap], ya te he dicho que estabas preciosa. Y lo de estar sexy lo llevas dentro, no tienes que hacer nada especial para estarlo."
    mc "[dap], I told you already. You look beautiful. And you are naturally sexy, you don't have to do anything special to be sexy."

# game/scripts/c15/c15.rpy:436
translate english c15s001_DapDate_7a902e65:

    # dap "Entonces, ¿me harías el amor esta noche, aunque no llevase este vestido?"
    dap "So, would you make love to me tonight? Even if I wasn't wearing this dress?"

# game/scripts/c15/c15.rpy:437
translate english c15s001_DapDate_87bc4363:

    # mc "Espero que cuando hagamos el amor no lo lleves. *Risa* Pero sí, te haría el amor aunque fueras con un saco de patatas en vez de con ese vestido."
    mc "I hope when we make love you won't wear it. *Laugh* But yes, I'd make love to you even if you were wearing a potato sack instead of that dress."

# game/scripts/c15/c15.rpy:439
translate english c15s001_DapDate_b4286511:

    # dap "Perfecto, porque no pienso dejarte escapar esta noche."
    dap " Great, because I'm not going to let you get away tonight."

# game/scripts/c15/c15.rpy:440
translate english c15s001_DapDate_c00e8be0:

    # mc "No tengo intención de escaparme. Esta noche soy todo para ti."
    mc "I have no intention of running away. Tonight I'm all yours."

# game/scripts/c15/c15.rpy:442
translate english c15s001_DapDate_5661754e:

    # dap "Sabes que, si seguimos hablando de esto, voy a estar pensando en lo que pasará después toda la cena, ¿verdad?"
    dap "You know what? If we keep talking about this? I'm going to be thinking about what happens next all through dinner."

# game/scripts/c15/c15.rpy:443
translate english c15s001_DapDate_1c835586:

    # mc "¿Quieres cambiar de tema?"
    mc "Do you want to change topics?"

# game/scripts/c15/c15.rpy:445
translate english c15s001_DapDate_402ecb75:

    # dap "El problema es que ahora mismo solo me apetece hablar sobre nosotros y de nuestra relación."
    dap "The thing is, right now I just feel like talking about us and our relationship."

# game/scripts/c15/c15.rpy:446
translate english c15s001_DapDate_f01e22f5:

    # dap "Sobre qué piensas que va a pasar con nosotros... somos primos..."
    dap "About what do you think is going to happen with us... we are cousins..."

# game/scripts/c15/c15.rpy:447
translate english c15s001_DapDate_8e9f18ea:

    # mc "Me da lo mismo que lo seamos, [dap]."
    mc "I don't give a damn if we are, [dap]."

# game/scripts/c15/c15.rpy:449
translate english c15s001_DapDate_81e21e06:

    # mc "Y más teniendo en cuenta que los dos sabemos que no lo somos."
    mc "And even more so considering that we both know we are not."

# game/scripts/c15/c15.rpy:451
translate english c15s001_DapDate_15000879:

    # dap "Lo sé, pero todo el mundo piensa que sí. Bueno, todo el mundo no. Mi madre lo sabe y lógicamente la tuya también... y la abuela... y Tía Betty, supongo... Y a Scarlett se lo dije yo."
    dap "I know, but everyone thinks so. Well, not everyone. My mother knows and logically so does yours... and Grandma... and Aunt Betty, I guess... And I told Scarlett."

# game/scripts/c15/c15.rpy:454
translate english c15s001_DapDate_cbdc2f5d:

    # dap "Pero ¿qué pensará la gente si lo hacemos público? ¿Mi hermana o la tuya? ¿Eileen o Jamaal? Ya viste las caras de las estudiantes cuando me besaste durante el juego."
    dap "But what will people think if we go public? My sister or yours? Eileen or Jamaal? You saw the students' faces when you kissed me during the game."

# game/scripts/c15/c15.rpy:455
translate english c15s001_DapDate_ec193f05:

    # mc "¿Te soy sincero? No me importa lo que piensen. Lo único que deben pensar es que estoy con una chica maravillosa que me hace feliz."
    mc "Can I be honest with you? I don't care what they think. All they need to think is that I'm with a wonderful girl who makes me happy."

# game/scripts/c15/c15.rpy:456
translate english c15s001_DapDate_4b28ab0d:

    # mc "Quiero pasar el resto de mi vida contigo, [dap]. Quiero que envejezcamos juntos. Quiero que sepas lo importante que eres para mí. Y quiero que todo el mundo lo sepa también."
    mc "I want to spend the rest of my life with you, [dap]. I want us to grow old together. I want you to know how important you are to me. And I want the whole world to know it too."

# game/scripts/c15/c15.rpy:457
translate english c15s001_DapDate_6e91adb8:

    # mc "¿Y a ti? ¿Te importa lo que piensen los demás?"
    mc "And you? Do you care about what others think about us?"

# game/scripts/c15/c15.rpy:459
translate english c15s001_DapDate_b25e09cd:

    # dap "Después de lo que acabas de decir... no debería decir que me importe... pero me importa. No sé cómo decírselo a mi hermana. O al resto de la familia."
    dap "After what you just said... I shouldn't say I care... but I do. I don't know how to tell my sister. Or the rest of the family."

# game/scripts/c15/c15.rpy:460
translate english c15s001_DapDate_da0cbb2a:

    # dap "Quiero hacerlo, pero no sé cómo... cualquier escenario que en el que puedo pensar acaba en discusión... con mi madre, con la tuya, con la abuela..."
    dap "I want to do it, but I don't know how... any scenario I can think of ends up in an argument... with my mother, with your mother, with grandma..."

# game/scripts/c15/c15.rpy:461
translate english c15s001_DapDate_0962fc03:

    # mc "Se lo puedes decir con un beso..."
    mc "You can tell them with a kiss..."

# game/scripts/c15/c15.rpy:463
translate english c15s001_DapDate_5d11e3dd:

    # dap "¡[mc]! ¡Ya te dije que no beso a chicas! ¡Lo de Scarlett fue solo para aprender!"
    dap "[mc]! I told you I don't kiss girls! Scarlett's thing was just to learn!"

# game/scripts/c15/c15.rpy:464
translate english c15s001_DapDate_56c18a7f:

    # mc "*Risa* No me refería a que las besaras a ellas, sino a que me besaras a mí delante de ellas."
    mc "*Laugh* I didn't mean you kissing them, I meant you kissing me in front of them."

# game/scripts/c15/c15.rpy:466
translate english c15s001_DapDate_7d70a208:

    # "La conversación es interrumpida por Mathilda, que llega con la comida."
    "The conversation is interrupted by Mathilda, who arrives with the food."

# game/scripts/c15/c15.rpy:467
translate english c15s001_DapDate_c957812e:

    # "Mathilda" "Aquí traigo su yantar. Disfruten de nuestros manjares. ¿Puedo ofrecerles algo más a vuesas mercedes?"
    "Mathilda" "Here I bring thee thy repast. Enjoy our delicacies. May I offer thy lordships anything else?"

# game/scripts/c15/c15.rpy:469
translate english c15s001_DapDate_370648d3:

    # dap "Por mí no, gracias. Esto tiene una pinta deliciosa."
    dap "Not for me, thanks. This looks delicious."

# game/scripts/c15/c15.rpy:470
translate english c15s001_DapDate_7abb4579:

    # mc "Por mí tampoco, gracias."
    mc "Not for me either, thanks."

# game/scripts/c15/c15.rpy:472
translate english c15s001_DapDate_0871ec30:

    # dap "Esto tiene una pinta excelente. ¿Qué tal lo tuyo?"
    dap "This looks excellent. How about yours?"

# game/scripts/c15/c15.rpy:483
translate english c15s001_DapDate_3d866d0f:

    # mc "Tiene muy buena pinta. Cuidan hasta el mínimo detalle, fíjate en los platos."
    mc "It looks very good. They take care of even the smallest detail, look at the tableware."

# game/scripts/c15/c15.rpy:485
translate english c15s001_DapDate_e06be625:

    # dap "Ya te he dicho que tenía ganas de venir. Los comentarios en ThreeSquare eran muy buenos para un sitio que lleva tan poco tiempo abierto. ¿Empezamos?"
    dap "I told you I was looking forward to coming here. The reviews on ThreeSquare were very good for a place that's been open for such a short time. Shall we get started?"

# game/scripts/c15/c15.rpy:486
translate english c15s001_DapDate_e8380814:

    # mc "Sí, pero estábamos hablando de hacer público lo nuestro."
    mc "Yes, but we were talking about going public."

# game/scripts/c15/c15.rpy:488
translate english c15s001_DapDate_8dc912e1:

    # dap "Sí, y tú has dicho que te bese delante de mi madre o de [eri]. *Risa* Estás loco. ¿O crees que soy tonta?"
    dap "Yes, and you said for me to kiss you in front of my mother or [eri]. *Laugh* You're crazy. Or do you think I'm a fool?"

# game/scripts/c15/c15.rpy:490
translate english c15s001_DapDate_ac41c310:

    # mc "No es tan mala idea. Ha funcionado con anterioridad."
    mc "It's not such a bad idea. It has worked before."

# game/scripts/c15/c15.rpy:492
translate english c15s001_DapDate_1faf8f84:

    # dap "{b}¿Qué? ¿Quién? ¿Cuándo?{/b} ¿Cómo se lo tomaron?"
    dap "{b}What? Who? When? {/b} How did they take it?"

# game/scripts/c15/c15.rpy:493
translate english c15s001_DapDate_6f4149b0:

    # mc "Sigo vivo, con lo que la cosa no acabó mal. *Risa*"
    mc "I'm still alive, so it didn't end badly. *Laugh*"

# game/scripts/c15/c15.rpy:495
translate english c15s001_DapDate_9273e56e:

    # mc "No me parece una mala idea. Eres tú quien tiene que decidir si quieres que lo sepan y cuando quieres que lo sepan."
    mc "I don't think it's a bad idea. It's up to you to decide if and when you want them to know."

# game/scripts/c15/c15.rpy:497
translate english c15s001_DapDate_f6f171e5:

    # dap "Yo no podría hacerlo. Sabes que soy más de hablar que de actuar."
    dap "I couldn't do it. You know I'm more of a talker than an actor."

# game/scripts/c15/c15.rpy:498
translate english c15s001_DapDate_8adad7a1:

    # mc "Entonces tendremos que buscar el momento correcto para explicarlo. O puedo besarte yo."
    mc "Then we'll have to find the right time to explain it. Or I can kiss you."

# game/scripts/c15/c15.rpy:499
translate english c15s001_DapDate_f1a13d58:

    # dap "Prefiero hablarlo, a ser posible de una en una. Primero [eri], después mi madre. Con un poco de suerte cuando le toque a la abuela ya estará de nuevo en Florida."
    dap "I prefer to talk about it, if possible one at a time. First [eri], then my mother. Hopefully, by the time it's grandma's turn she'll be back in Florida."

# game/scripts/c15/c15.rpy:500
translate english c15s001_DapDate_2ee09558:

    # mc "¡Cuánto miedo le tenéis todas a Meemaw!"
    mc "You are all so afraid of Meemaw!"

# game/scripts/c15/c15.rpy:502
translate english c15s001_DapDate_fcd16a07:

    # dap "¿Le tenemos? ¿Todas? ¿Quién más?"
    dap "We are? All of us? Who else?"

# game/scripts/c15/c15.rpy:503
translate english c15s001_DapDate_9eeedcfb:

    # mc "Ermmm... tu madre, por ejemplo. Desde que sabemos que venía, ha estado preocupada sobre lo que diría sobre la casa... y esas cosas..."
    mc "Ermmm... your mother, for example. Ever since we knew she was coming, she's been worried about what Meemaw would say about the house... and that sort of thing..."

# game/scripts/c15/c15.rpy:505
translate english c15s001_DapDate_743b8e3d:

    # dap "Ah, vale, te refieres a eso. ¡Qué susto! Creía que te referías a que estabas con alguien más de la familia... y no estoy preguntando porque sé que no vas a contestar."
    dap "Ah, okay, you mean that. What a scare! I thought you meant you were with someone else in the family... and I'm not asking because I know you're not going to answer."

# game/scripts/c15/c15.rpy:507
translate english c15s001_DapDate_6b4a6a87:

    # dap "Pero volviendo al tema encima de la mesa. Tú querrías hacerlo público y yo no estoy preparada. ¿Te importa que nos lo tomemos con calma?"
    dap "But back to the topic. You'd want to go public and I'm not ready - do you mind if we take it slow?"

# game/scripts/c15/c15.rpy:508
translate english c15s001_DapDate_a38cc4aa:

    # mc "Mientras me sigas dejando disfrutar de tu compañía, mientras me dejes seguir besándote y acariciándote, no me importa quién lo sepa."
    mc "As long as you keep letting me enjoy your company, as long as you let me keep kissing and caressing you, I don't care who knows."

# game/scripts/c15/c15.rpy:509
translate english c15s001_DapDate_0920fe51:

    # mc "¿Pereferiría poder llegar a casa y decírselo a todo el mundo? Por supuesto, pero no te voy a forzar a ello."
    mc "Would I rather be able to come home and tell everyone? Of course, but I'm not going to force you to."

# game/scripts/c15/c15.rpy:511
translate english c15s001_DapDate_4816d419:

    # dap "Gracias, [mc]."
    dap "Thanks, [mc]."

# game/scripts/c15/c15.rpy:512
translate english c15s001_DapDate_f47336a7:

    # dap "Cambiando de tema, ¿como nos ves en cinco años?"
    dap "Changing the topic, how do you see us in five years?"

# game/scripts/c15/c15.rpy:513
translate english c15s001_DapDate_66e93671:

    # mc "Eso es más una pregunta para una entrevista de trabajo que para una cita. *Risa* Pero es fácil de contestar."
    mc "That's more of a job interview question than a date question. *Laugh* But it's easy to answer."

# game/scripts/c15/c15.rpy:516
translate english c15s001_DapDate_58ea6be9:

    # mc "Me gustaría tener, como mínimo, una pequeña [dap] correteando por casa."
    mc "I would like to have, at the very least, a little [dap] running or crawling around the house."

# game/scripts/c15/c15.rpy:517
translate english c15s001_DapDate_49e13e06:

    # mc "Me gustaría que hubieras acabado tus estudios y encontrases algún trabajo que te llenara en un sitio donde pudieramos estar juntos."
    mc "I wish you had finished your studies and found some fulfilling work in a place where we could be together."

# game/scripts/c15/c15.rpy:519
translate english c15s001_DapDate_9d7a54d2:

    # mc "Me gustaría que mirásemos hacia atras, a esta noche, y pensáramos \"¿Ya han pasado cinco años?\" y nos sorprendiéramos."
    mc "I'd like us to look back at tonight and think, \"It's been five years already?\", and be surprised."

# game/scripts/c15/c15.rpy:521
translate english c15s001_DapDate_664e0fa8:

    # mc "Me gustaría que de lo único que nos arrepintiéramos fuera de no haber empezado antes, de haber desperdiciado unos preciosos días juntos."
    mc "I wish the only thing we regretted was not starting sooner, wasting a few precious days together."

# game/scripts/c15/c15.rpy:523
translate english c15s001_DapDate_7928fb23:

    # dap "¡Joder, [mc]! ¡No podías haber dicho algo más bonito!"
    dap "Fuck, [mc]! You couldn't have said something nicer!"

# game/scripts/c15/c15.rpy:524
translate english c15s001_DapDate_00a4148f:

    # mc "No se lo podía haber dicho a alguien más bonita."
    mc "I couldn't have told anyone prettier."

# game/scripts/c15/c15.rpy:526
translate english c15s001_DapDate_bea64e0a:

    # dap "¡Un brindis por que todo lo que has dicho se cumpla!"
    dap "A toast to everything you have said coming true!"

# game/scripts/c15/c15.rpy:527
translate english c15s001_DapDate_299c3501:

    # mc "¡Brindo por ello!"
    mc "I'll drink to that!"

# game/scripts/c15/c15.rpy:529
translate english c15s001_DapDate_4f20587c:

    # dap "Veo que lo de beber como una princesa no se me da bien. A lo mejor puedo trabajar aquí de tabernera. *Risa*"
    dap "I can see I'm not good at drinking like a princess. Maybe I can work here as a tavernmaid. *Laugh*"

# game/scripts/c15/c15.rpy:530
translate english c15s001_DapDate_c5a66d6b:

    # mc "Es posible. *Risa* Pero siempre serás mi princesa. Tengo una duda."
    mc "It's possible. *Laugh* But you'll always be my princess. However, I have a doubt."

# game/scripts/c15/c15.rpy:531
translate english c15s001_DapDate_031bfa8a:

    # dap "Dime."
    dap "Tell me."

# game/scripts/c15/c15.rpy:533
translate english c15s001_DapDate_fc56b344:

    # mc "Has brindado por que se cumpla todo. ¿Todo? ¿Incluída la pequeña [dap]?"
    mc "You've toasted to everything being fulfilled - everything? Including Little [dap]?"

# game/scripts/c15/c15.rpy:535
translate english c15s001_DapDate_86dccfc6:

    # dap "*Susurrando* ¿Tu has traído condones? Porque yo no estoy con la pastilla, nunca la he necesitado, y no voy a empezar ahora."
    dap "*Whispering* Did you bring condoms? Because I'm not on the pill, I've never needed it, and I'm not going to start now."

# game/scripts/c15/c15.rpy:536
translate english c15s001_DapDate_d1122d1c:

    # mc "No, no he traído."
    mc "No, I haven't."

# game/scripts/c15/c15.rpy:538
translate english c15s001_DapDate_31abef77:

    # dap "Entonces podemos ir a comprarlos cuando acabemos de cenar, o podemos hacer el primer intento de hacer a la pequeña [dap]."
    dap "Then we can go buy them when we finish dinner, or we can make the first attempt to make Little [dap]."

# game/scripts/c15/c15.rpy:539
translate english c15s001_DapDate_d61cf959:

    # dap "Hoy quiero hacer el amor contigo, si quieres con condón, si quieres sin. No me da miedo quedarme embarazada. Sé que voy a pasar el resto de mi vida contigo."
    dap "Today I want to make love with you, if you want with a condom, if you want without. I'm not afraid of getting pregnant. I know I'm going to spend the rest of my life with you."

# game/scripts/c15/c15.rpy:540
translate english c15s001_DapDate_18521f31:

    # dap "Y no quiero que, dentro de cinco años, cuando miremos hacia atras, a esta noche, nos arrepintamos de no haberlo hecho."
    dap "And I don't want us, five years from now, when we look back on this night, to regret that we didn't do it."

# game/scripts/c15/c15.rpy:541
translate english c15s001_DapDate_81d9ec17:

    # dap "La pequeña [dap] va a tener una gran familia. Quiero que la disfrute el máximo de tiempo posible."
    dap "Little [dap] is going to have a great family. I want her to enjoy it for as long as possible."

# game/scripts/c15/c15.rpy:542
translate english c15s001_DapDate_cb2a79b5:

    # mc "Sabes que ahora mismo me podría levantar y besarte, ¿verdad?"
    mc "You know I could get up and kiss you right now, right?"

# game/scripts/c15/c15.rpy:544
translate english c15s001_DapDate_9f80b391:

    # dap "Después del discurso que acabo de soltar, me están temblando las piernas. Pero si te levantas y me besas, nos vamos a tener que ir sin acabar de cenar. Dudo que pudiera parar."
    dap "After the speech I just made, my legs are shaking. But if you get up and kiss me, we're going to have to leave without finishing dinner. I doubt I could stop."

# game/scripts/c15/c15.rpy:545
translate english c15s001_DapDate_14cf106f:

    # dap "Mejor guarda esos besos para cuando estemos solos. Los vas a necesitar."
    dap "Better save those kisses for when we're alone. You're going to need them."

# game/scripts/c15/c15.rpy:546
translate english c15s001_DapDate_f393e816:

    # mc "No te preocupes, no se agotan."
    mc "Don't worry, I have plenty to give."

# game/scripts/c15/c15.rpy:547
translate english c15s001_DapDate_02d88677:

    # mc "¿Tienes pensado algún nombre para la pequeña [dap]?"
    mc "Do you have a name in mind for Little [dap]?"

# game/scripts/c15/c15.rpy:549
translate english c15s001_DapDate_a53f9b89:

    # dap "Sí. Me gustan Maeve y Claire. También me gusta Hope, pero es un nombre que [eri] siempre ha querido ponerle a nuestra hermana, si mi madre encontraba a alguien."
    dap "Yes. I like Maeve and Claire. I also like Hope, but it's a name [eri] has always wanted to name our sister, if my mother found someone."

# game/scripts/c15/c15.rpy:550
translate english c15s001_DapDate_995bee38:

    # dap "Supongo que con la edad que tiene mi madre, ese nombre pasará a la hija de [eri] cuando ella encuentre un chico que valga la mitad de lo que vales tú."
    dap "With the age my mother is, I guess that name will pass to [eri]'s daughter when she finds a guy worth half as much as you."

# game/scripts/c15/c15.rpy:551
translate english c15s001_DapDate_5c01de9c:

    # mc "Me gustan los dos nombres. *Risa* Podemos seguir tu tradición familiar y tener gemelas."
    mc "I like both names. *Laugh* We can follow your family tradition and have twins."

# game/scripts/c15/c15.rpy:553
translate english c15s001_DapDate_f9bc189f:

    # dap "Si pudiera elegirlo, las tendría. *Risa* Pero no es algo que se elija."
    dap "If I could choose it, I would have them. *Laugh* But it's not something you can pick and choose."

# game/scripts/c15/c15.rpy:554
translate english c15s001_DapDate_33851ada:

    # mc "Lo sé, pero sería bonito tener dos pequeñas [dap] correteando por casa en vez de solo una."
    mc "I know, but it would be nice to have two Little [dap] running around the house instead of just one."

# game/scripts/c15/c15.rpy:555
translate english c15s001_DapDate_d208f71f:

    # dap "Sí, sería bonito... pero todo se andará."
    dap "Yes, it would be nice... and if it’s meant to be? It will happen."

# game/scripts/c15/c15.rpy:556
translate english c15s001_DapDate_cb7cbdfc:

    # mc "Sobre lo del trabajo, sé que vas a estudiar Química. ¿De qué quieres trabajar? ¿Qué posibilidades laborales tienes en Newport?"
    mc "About the job thing, I know you're going to study chemistry. But what do you want to work in? What are your job prospects in Newport?"

# game/scripts/c15/c15.rpy:558
translate english c15s001_DapDate_3e2a869e:

    # dap "Enseñar en la NWU o en algún instituto. O investigación, que es lo que me gustaría, en la NWU o en la Cal Poly."
    dap "Teaching at NWU or some high school. Or research, which is what I'd like, at NWU or Cal Poly."

# game/scripts/c15/c15.rpy:559
translate english c15s001_DapDate_a728b97d:

    # dap "En San Luís, en Paso Robles, o en Atascadero hay algunas empresas donde también podría trabajar. Pero vete a saber como estará el tema laboral en cuatro años."
    dap "In San Luis, in Paso Robles, or in Atascadero there are some companies where I could also work. But who knows how the labor market will be in four years."

# game/scripts/c15/c15.rpy:560
translate english c15s001_DapDate_b1336de6:

    # mc "Con lo que podrías seguir viviendo en Newport, ¿no?"
    mc "So you could still live in Newport, couldn't you?"

# game/scripts/c15/c15.rpy:562
translate english c15s001_DapDate_96e39944:

    # dap "No lo sé. Me tendrían que contratar en alguno de esos sitios. Pero nunca había pensado en mudarme. Me gustaría vivir en Newport siempre. ¿Qué opinas?"
    dap "I don't know. I'd have to get hired at one of those places. But I've never thought about moving. I'd like to live in Newport forever - what do you think?"

# game/scripts/c15/c15.rpy:563
translate english c15s001_DapDate_09dc82f3:

    # mc "Que me da lo mismo donde vivamos. Pero a mí también me gustaría quedarme en Newport."
    mc "I don't care where we live. But I'd like to stay in Newport, too."

# game/scripts/c15/c15.rpy:564
translate english c15s001_DapDate_d5379c54:

    # dap "¿Y tú? ¿Qué planes tienes para el futuro? Una vez el Dormitorio esté totalmente en marcha, vas a tener muy poco trabajo."
    dap "What about you? What are your plans for the future? Once the Dorm is fully up and running, you're going to have very little work."

# game/scripts/c15/c15.rpy:565
translate english c15s001_DapDate_5bfdc0cd:

    # mc "He estado haciendo números, y no pintan bien. Con lo que pagan 12 chicas, y una vez se acabe la subvención extra que nos da la NWU, los números salen muy justos."
    mc "I've been crunching numbers, and they don't look good. With what 12 girls pay, and once the extra grant we get from NWU runs out, the numbers are looking very tight."

# game/scripts/c15/c15.rpy:567
translate english c15s001_DapDate_e871c428:

    # dap "¿Tan mal estamos?"
    dap "Is it that bad?"

# game/scripts/c15/c15.rpy:568
translate english c15s001_DapDate_263a5054:

    # mc "Entre impuestos y los costes operativos estimados, quedarán un par de sueldos medianos. Somos tres personas trabajando, con lo que seguramente tendré que buscar algo. En Newport o alrededores."
    mc "Between taxes and estimated operating costs, there will be a couple of medium-sized salaries left over. There are three of us working, so I'll probably have to look for something. In or around Newport."

# game/scripts/c15/c15.rpy:569
translate english c15s001_DapDate_f9099e9b:

    # mc "La NWU nos subvenciona este año y el que viene, con lo que tengo tiempo para buscar algo."
    mc "NWU is subsidizing us this and next year, so I have time to find something."

# game/scripts/c15/c15.rpy:571
translate english c15s001_DapDate_62428f0a:

    # dap "Mierda. Si fueran cuatro años, yo podría aportar mis ingresos en vez de generar gastos, pero en dos años..."
    dap "Shit. If it were four years, I could contribute with my income instead of generating expenses, but in two years..."

# game/scripts/c15/c15.rpy:572
translate english c15s001_DapDate_a790315f:

    # mc "No es una noche para que te preocupes, cielo. Los dos primeros años estaremos bien, y después ya se verá. Pero no tendré problemas en encontrar trabajo en Newport o los alrededores."
    mc "It's not a night for you to worry, honey. We'll be fine for the first two years, and then we'll see. But I'll have no trouble finding work in Newport or the surrounding area."

# game/scripts/c15/c15.rpy:574
translate english c15s001_DapDate_36bb7a11:

    # "En ese momento llega Mathilda..."
    "At that moment Mathilda arrives..."

# game/scripts/c15/c15.rpy:575
translate english c15s001_DapDate_2918b3d8:

    # "Mathilda" "¿Han disfrutado de la comida? ¿Puedo ofrecerles algún dulce?"
    "Mathilda" "Did ye enjoy thy meal? May I offer ye some sweets?"

# game/scripts/c15/c15.rpy:576
translate english c15s001_DapDate_d2efded5:

    # mc "Estaba todo muy bueno, pero yo voy a tener que renunciar al postre."
    mc "Everything was very good, but I'm going to pass on dessert."

# game/scripts/c15/c15.rpy:578
translate english c15s001_DapDate_46f7365e:

    # dap "Todo estaba exquisito, pero yo también voy a pasar. ¿Nos puede cargar la cuenta a la habitación?"
    dap "Everything was exquisite, but I'm going to pass too. Can you charge the bill to our room?"

# game/scripts/c15/c15.rpy:579
translate english c15s001_DapDate_26666239:

    # mc "¿Qué habitación?"
    mc "What room?"

# game/scripts/c15/c15.rpy:581
translate english c15s001_DapDate_2419419d:

    # dap "¡Hush, [mc]!"
    dap "Hush, [mc]!"

# game/scripts/c15/c15.rpy:582
translate english c15s001_DapDate_3bb8e5d7:

    # dap "La habitación está a nombre de Marks, [dap] Marks."
    dap "The room is under the name of Marks, [dap] Marks."

# game/scripts/c15/c15.rpy:584
translate english c15s001_DapDate_d994c62a:

    # "Mathilda" "Sin ningún problema. No olviden recoger sus cosas de los vestuarios, por la mañana estarán cerrados. Los disfraces los pueden dejar en la habitación."
    "Mathilda" "No problem. Don't forget to collect thy things from the dressing rooms, they will be closed in the morning. Ye can leave thy costumes in the room."

# game/scripts/c15/c15.rpy:585
translate english c15s001_DapDate_eb5b17f9:

    # "Mathilda" "Esperamos verles de nuevo en nuestras instalaciones."
    "Mathilda" "We look forward to seeing ye again at our facilities."

# game/scripts/c15/c15.rpy:586
translate english c15s001_DapDate_ef11e901:

    # mc "Gracias, Mathilda. Creo que volveremos."
    mc "Thank you, Mathilda. I think we'll return."

# game/scripts/c15/c15.rpy:588
translate english c15s001_DapDate_381c9caa:

    # dap "Es probable que volvamos. Ha sido una experiencia muy buena. Gracias, Mathilda."
    dap "We will probably come back. It has been a very good experience. Thank you, Mathilda."

# game/scripts/c15/c15.rpy:590
translate english c15s001_DapDate_8594335b:

    # dap "¿Vamos?"
    dap "Let's go?"

# game/scripts/c15/c15.rpy:591
translate english c15s001_DapDate_81d08733:

    # mc "¿Qué es eso de la habitación?"
    mc "What's that about the room?"

# game/scripts/c15/c15.rpy:592
translate english c15s001_DapDate_4fa2926c:

    # dap "Ya te he dicho que había varios restaurantes. El Black Crow es éste, el Pitch Raven es el de ciencia ficción, y el Nigrum Corvus es el de la era clásica, romanos, griegos, y esas cosas."
    dap "I told you there were several restaurants. The Black Crow is this one, the Pitch Raven is the futuristic one, and the Nigrum Corvus is the classical era one; Romans, Greeks, and stuff."

# game/scripts/c15/c15.rpy:593
translate english c15s001_DapDate_e7b6e193:

    # dap "Y después tienen la Red Crow Inn, con habitaciones temáticas. Tenemos una habitación medieval, aunque seguramente no se parezca en nada a como dormían entonces."
    dap "And then they have the Red Crow Inn, with themed rooms. We have a medieval room, although it's probably nothing like how they slept back then."

# game/scripts/c15/c15.rpy:594
translate english c15s001_DapDate_dd6716bd:

    # mc "Así que la otra reserva a nombre de \"otros\" Marks era tuya, ¿no?"
    mc "So the other reservation for the \"other\" Marks was yours, was it?"

# game/scripts/c15/c15.rpy:596
translate english c15s001_DapDate_d9aef484:

    # dap "Sí. Te hice reservar el restaurante por si querías meterte en la web y cambiar la época. La habitación la tenía elegida yo. Me parece más romántica la medieval que la de ciencia ficción."
    dap "Yes. I had you book the restaurant in case you wanted to get on the web and change the period. The room was my choice. I find medieval more romantic than sci-fi."

# game/scripts/c15/c15.rpy:597
translate english c15s001_DapDate_82d9a650:

    # mc "Me ha encantado el Black Crow, con lo que me alegro de no haberlo hecho. La próxima vez, podemos probar uno de los otros."
    mc "I loved the Black Crow, so I'm glad I didn't change it. Next time, we can try one of the others."

# game/scripts/c15/c15.rpy:599
translate english c15s001_DapDate_42533991:

    # dap "Mejor no..."
    dap "Better not..."

# game/scripts/c15/c15.rpy:600
translate english c15s001_DapDate_90696e73:

    # mc "¿Pasa algo, [dap]?"
    mc "What's the matter, [dap]?"

# game/scripts/c15/c15.rpy:601
translate english c15s001_DapDate_d46383ba:

    # dap "Si estamos mal de dinero, me conformo con que la próxima vez sea en un Burger Prince y durmamos en un motel. Si es contigo, me da lo mismo el sitio."
    dap "If we're short of money, I'll be happy if next time it's at a Burger Prince and we sleep in a motel. If it's with you, I don't care what the place is."

# game/scripts/c15/c15.rpy:602
translate english c15s001_DapDate_66412d2f:

    # mc "Es caro, ¿verdad?"
    mc "It's expensive, right?"

# game/scripts/c15/c15.rpy:603
translate english c15s001_DapDate_32ccc251:

    # dap "Un poco, pero no te preocupes. La habitación ya está pagada. Solo me falta pagar la cena."
    dap "A little, but don't worry. The room is already paid for. I just need to pay for dinner."

# game/scripts/c15/c15.rpy:604
translate english c15s001_DapDate_818816ed:

    # mc "¿De dónde has sacado el dinero, [dap]?"
    mc "Where did you get the money from, [dap]?"

# game/scripts/c15/c15.rpy:606
translate english c15s001_DapDate_36039b3d:

    # dap "Había estado ahorrando la paga para comprarme un nuevo portátil gaming. He invertido parte de ese dinero en la habitación y en la cena."
    dap "I had been saving my allowance for some months to buy a new gaming laptop. I used some of that money in the room and dinner."

# game/scripts/c15/c15.rpy:607
translate english c15s001_DapDate_03ebce68:

    # mc "De eso nada, cielo. No puedo hacer nada con la habitación, pero no voy a permitirte pagar la cena. Igual que tú no vas a permitirme devolverte el dinero de la habitación, ¿verdad?"
    mc "No way, honey. I can't do anything about the room, but I'm not going to let you pay for dinner. Just like you're not going to let me pay you back for the room, are you?"

# game/scripts/c15/c15.rpy:609
translate english c15s001_DapDate_aa71adc3:

    # dap "¡Ni de coña! Ha sido elección mía y lo pago yo todo."
    dap "No fracking way! It was my choice and I'm paying for it all."

# game/scripts/c15/c15.rpy:610
translate english c15s001_DapDate_51cd79e3:

    # mc "Eso no va a pasar. La cena corre de mi cuenta. Tú has ahorrado para ese portátil y te lo mereces."
    mc "That's not going to happen. Dinner is on me. You saved up for that laptop and you deserve it."

# game/scripts/c15/c15.rpy:612
translate english c15s001_DapDate_767f581f:

    # dap "Bueno, ya lo hablaremos mañana. Es el momento de ver la habitación."
    dap "Well, we'll talk about it tomorrow. It's time to see our room."

# game/scripts/c15/c15.rpy:613
translate english c15s001_DapDate_57d4b6c8:

    # mc "¡Vamos!"
    mc "Let's go!"

# game/scripts/c15/c15.rpy:616
translate english c15s001_AmandaCall_76586480:

    # mc "¿Hola? ¿Quién es?"
    mc "Hello? Who is it?"

# game/scripts/c15/c15.rpy:618
translate english c15s001_AmandaCall_09b3092f:

    # ama "Hola, [mc]. No quiero molestarte demasiado."
    ama "Hello, [mc]. I don't want to bother you too much."

# game/scripts/c15/c15.rpy:619
translate english c15s001_AmandaCall_25bb6224:

    # mc "No molestas, Amanda. ¿Puedo ayudarte en algo?"
    mc "You're no bother, Amanda. Can I help you with anything?"

# game/scripts/c15/c15.rpy:622
translate english c15s001_AmandaCall_2d2c711f:

    # ama "Me iba a acostar cuando he recibido una llamada y te tenía que avisar."
    ama "I was going to bed when I got a call and I had to let you know."

# game/scripts/c15/c15.rpy:623
translate english c15s001_AmandaCall_1b04504d:

    # ama "Aaron, nuestro supervisor, llega mañana por la mañana y él querría reunirse con vosotros por la tarde para explicaros la situación."
    ama "Aaron, our supervisor, arrives tomorrow morning and he would like to meet with you in the afternoon at [nor]'s house to explain the situation."

# game/scripts/c15/c15.rpy:625
translate english c15s001_AmandaCall_88603816:

    # ama "Me acaban de despertar con una llamada y te tenía que avisar."
    ama "I was just woken up by a phone call and I had to let you know."

# game/scripts/c15/c15.rpy:626
translate english c15s001_AmandaCall_e6912b06:

    # ama "Aaron, nuestro supervisor, acaba de aterrizar y él querría reunirse con vosotros esta tarde para explicaros la situación."
    ama "Aaron, our supervisor, has just landed and he would like to meet with you this afternoon at [nor]'s house to explain the situation."

# game/scripts/c15/c15.rpy:627
translate english c15s001_AmandaCall_1cb46252:

    # mc "¿Nosotros? ¿[mar], [nor], [emm], [eri], [dap] y yo?"
    mc "Meet us? [mar], [nor], [emm], [eri], [dap] and me?"

# game/scripts/c15/c15.rpy:629
translate english c15s001_AmandaCall_3e162582:

    # ama "De momento solo con [mar], [nor] y contigo. Eva y yo también vamos a estar ahí, y las chicas podrían flipar un poco."
    ama "At the moment only with [mar], [nor], and you. Eva and I are going to be there too, and the girls might freak out a little bit."

# game/scripts/c15/c15.rpy:630
translate english c15s001_AmandaCall_12d46e7b:

    # ama "Además, no es cosa nuestra decirles la verdad, sino de sus madres."
    ama "Besides, it's not up to us to tell them the truth, it's up to their mothers."

# game/scripts/c15/c15.rpy:632
translate english c15s001_AmandaCall_8f92426d:

    # ama "Y tuya."
    ama "And to you."

# game/scripts/c15/c15.rpy:633
translate english c15s001_AmandaCall_c431475a:

    # mc "Lo entiendo. No me gusta ocultarles la verdad, pero hablaré con [mar] y con [nor]. ¿A qué hora os esperamos?"
    mc "I understand. I don't like to hide the truth from them, but I'll talk to [mar] and [nor]. What time shall we expect you?"

# game/scripts/c15/c15.rpy:635
translate english c15s001_AmandaCall_095f53d4:

    # ama "A las 1700. Aaron volará fuera del país por la noche."
    ama "At 1700. Aaron will fly out of the country in the evening."

# game/scripts/c15/c15.rpy:636
translate english c15s001_AmandaCall_a022ff35:

    # mc "Intentaré que las chicas no estén en casa a esa hora. ¿Cuánto tiempo necesitáis que estén fuera?"
    mc "I'll try to keep the girls out of the house at that time. How long do you need them to be gone?"

# game/scripts/c15/c15.rpy:638
translate english c15s001_AmandaCall_90a0d55c:

    # ama "No más de una hora, supongo. Depende de las preguntas que tengáis. Por eso es mejor que sólo estéis [nor], [mar], y tú. Nada de Olivia o Betty."
    ama "No more than an hour, I guess. It depends on how many questions you have. That's why it's best if it's just [nor], [mar], and you. No Olivia or Betty either."

# game/scripts/c15/c15.rpy:639
translate english c15s001_AmandaCall_3fbaf73d:

    # mc "Van a querer estar. También sufrieron el... *Susurro* secuestro."
    mc "They will want to be there. They also suffered the... *Whisper* kidnapping."

# game/scripts/c15/c15.rpy:641
translate english c15s001_AmandaCall_aa3f445e:

    # ama "Es posible que sea la última vez que nos veamos. Nuestra misión con vosotros ya está acabando."
    ama "This may be the last time we will see each other. Our mission with you is already ending."

# game/scripts/c15/c15.rpy:642
translate english c15s001_AmandaCall_14a8e762:

    # mc "¿Aaron se os va a llevar? ¿A alguna base de NTR?"
    mc "Is Aaron going to take you away? To some NTR base?"

# game/scripts/c15/c15.rpy:644
translate english c15s001_AmandaCall_4b11cc55:

    # ama "Aaron solo quiere hablar con vosotros de momento. El resto ya se verá."
    ama "Aaron only wants to talk to you for the time being. The rest? We'll see."

# game/scripts/c15/c15.rpy:645
translate english c15s001_AmandaCall_5493f95e:

    # ama "Por cierto, deberíais informar a [mar] de lo que pasó el lunes con Eric y los demás. Nos ahorraremos preguntas incómodas."
    ama "By the way, you should let [mar] know what happened on Monday with Eric and the others. It will save some awkward questions."

# game/scripts/c15/c15.rpy:646
translate english c15s001_AmandaCall_f53c18eb:

    # mc "No te preocupes, hablaré con ella antes de que lleguéis."
    mc "Don't worry, I'll talk to her before you get there."

# game/scripts/c15/c15.rpy:649
translate english c15s001_AmandaCall_9fe47f69:

    # ama "Perfecto. Entonces nos vemos mañana por la tarde. Feliz Navidad de nuevo, [mc]."
    ama "Perfect. I'll see you tomorrow afternoon then. Merry Christmas again, [mc]."

# game/scripts/c15/c15.rpy:650
translate english c15s001_AmandaCall_4bb39419:

    # mc "Hasta mañana. No sé si es un poco tarde para seguir celebrando la Navidad, pero Feliz Navidad de nuevo, Amanda."
    mc "See you tomorrow. I don't know if it's a little late to still be celebrating Christmas, but Merry Christmas again, Amanda."

# game/scripts/c15/c15.rpy:652
translate english c15s001_AmandaCall_a8d9df18:

    # ama "Perfecto. Entonces nos vemos esta tarde. A las 1700."
    ama "Perfect. Then I'll see you this afternoon. At 1700."

# game/scripts/c15/c15.rpy:653
translate english c15s001_AmandaCall_f2240889:

    # mc "Hasta luego, Amanda."
    mc "See you later, Amanda"

# game/scripts/c15/c15.rpy:656
translate english c15s001_WakeUp_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c15/c15.rpy:657
translate english c15s001_WakeUp_0e03d86c:

    # "Suena el teléfono y te saca de tus sueños, si es que los has tenido. Despertarse tan de golpe ha hecho que olvides lo que estabas soñando."
    "The phone rings and pulls you out of your dreams, if you've had any. Waking up so suddenly has made you forget what you were dreaming about."

# game/scripts/c15/c15.rpy:658
translate english c15s001_WakeUp_33a3ac7f:

    # mcp "(¿Número oculto?)"
    mcp "(Hidden number?)"

# game/scripts/c15/c15.rpy:661
translate english c15s001_WakeUp_032240cf:

    # "Cuando cuelgas te das cuenta de que has dormido hasta tarde. Casi no vale la pena bajar a desayunar."
    "When you hang up you realize you've overslept. It's almost not worth going down for breakfast."

# game/scripts/c15/c15.rpy:663
translate english c15s001_WakeUp_ff52f651:

    # "Decides jugar un rato a My Residence, El MC por fin lleva a Laura a una cita, aunque es ella la que elige restaurante."
    "You decide to play My Residence for a while. The MC finally takes Laura on a date, although she is the one who chooses the restaurant."

# game/scripts/c15/c15.rpy:664
translate english c15s001_WakeUp_e049b78d:

    # "Como ella es fan de las novelas de fantasía, elige un restaurante temático medieval en el que pueden disfrazarse. Laura cada vez te recuerda más a [dap]."
    "Since she's a fan of fantasy novels, she chooses a medieval themed restaurant where they can dress up. Laura reminds you more and more of [dap]."

# game/scripts/c15/c15.rpy:669
translate english c15s001_WakeUp_32c3c0e6:

    # "{b}Esto es todo por esta versión. Por favor, graba aquí y nos vemos en la próxima actualización de My Dorm. Gracias por jugar y por tu apoyo. Espero que hayas disfrutado del juego.{/b}"
    "{b}This is all for this release. Please, save here and see you in the next release of My Dorm. Thanks for playing and for your support. I hope you've enjoyed the game.{/b}"

