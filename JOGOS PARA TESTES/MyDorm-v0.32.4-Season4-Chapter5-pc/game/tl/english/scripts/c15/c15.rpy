translate english c15s003_PickUpEileen_f6878a68:

    # mc "Cuando quieras."
    mc "Sure."

# game/scripts/c15/c15.rpy:1381
translate english c15s003_PickUpEileen_7882f242:

    # mc "Te quiero."
    mc "I love you."

# game/scripts/c15/c15.rpy:1382
