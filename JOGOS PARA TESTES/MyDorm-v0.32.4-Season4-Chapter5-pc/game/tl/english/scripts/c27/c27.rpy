    lis "I'm not going to give up on that."

# game/scripts/c27/c27.rpy:1566
translate english c27s002_LisShopping_fb4ba3d1:

    # lis "Hasta ahora mismo. No me canso de besarte."
    lis "See you in a minute. I never tire of kissing you."

# game/scripts/c27/c27.rpy:1567
translate english c27s002_LisShopping_b93fdca1:

    # mc "Hasta ahora mismo. Espero que no lo hagas nunca."
    mc "Make it two minutes. I hope you never do."

# game/scripts/c27/c27.rpy:1569
translate english c27s002_LisShopping_a25a8417:

