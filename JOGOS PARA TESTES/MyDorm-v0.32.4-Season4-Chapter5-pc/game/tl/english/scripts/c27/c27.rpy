translate english c27s006_OmaHouse_cd0aac55:

    # oma "Déjame coger los pijamas y el uniforme y vamos a casa."
    oma "Let me get my pajamas and uniform, and we'll go home."

# game/scripts/c27/c27.rpy:3411
translate english c27s006_OmaHouse_52721442:

