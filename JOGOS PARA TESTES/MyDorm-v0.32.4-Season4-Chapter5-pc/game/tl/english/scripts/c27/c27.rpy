    "[mad.nick] is the first to kiss you."

# game/scripts/c27/c27.rpy:1849
translate english c27s003_MadLis_dab8c711:

    # mad "Gracias por lo que has hecho en la tienda."
    mad "Thank you for what you did at the store."

# game/scripts/c27/c27.rpy:1850
translate english c27s003_MadLis_4d1b716b:

    # mc "¿Te ha bombardeado tu madre mucho a preguntas?"
    mc "Has your mother barraged you with questions?"

# game/scripts/c27/c27.rpy:1851
translate english c27s003_MadLis_4c269159:

