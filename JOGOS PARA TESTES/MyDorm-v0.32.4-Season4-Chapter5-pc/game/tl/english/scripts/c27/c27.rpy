    # nor "He intercambiado algunos correos con ellas, y parecen buenas chicas."
    nor "I've exchanged a few emails with them, and they seem like nice girls."

# game/scripts/c27/c27.rpy:3227
translate english c27s005_PaintBasement_de3aa4eb:

