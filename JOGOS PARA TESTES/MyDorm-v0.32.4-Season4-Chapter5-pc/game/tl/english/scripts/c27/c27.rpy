translate english c27s003_MadLis_330754fc:

    # mc "¿Qué gran noticia? ¿Me he perdido algo?"
    mc "What big news? Did I miss something?"

# game/scripts/c27/c27.rpy:1921
translate english c27s003_MadLis_458c8cb9:

    # mad "Bueno, la iba a contar la próxima vez que fuera a casa..."
    mad "Well, I was going to tell everyone the next time I went home..."

# game/scripts/c27/c27.rpy:1922
translate english c27s003_MadLis_c779c6c9:

    # mad "¡Mis diseños de vestidos han sido aceptados para el concurso al que los mandé! ¡Están en la fase final!"
    mad "My dress designs have been accepted for the contest I submitted them to! They're in the final round!"

# game/scripts/c27/c27.rpy:1923
translate english c27s003_MadLis_c97518fe:

    # mc "¡Eso es fantástico, [mad.nick]! ¿Cuándo sabrás si has ganado?"
    mc "That's fantastic, [mad.nick]! When will you find out if you won?"

# game/scripts/c27/c27.rpy:1925
translate english c27s003_MadLis_98f13275:

    # mad "A finales del mes que viene. Tendré que ir a San Francisco un día para la gala de entrega de premios."
    mad "At the end of next month. I'll have to go to San Francisco for a day for the awards gala."

# game/scripts/c27/c27.rpy:1926
translate english c27s003_MadLis_8713c2da:

    # mad "¡Estoy super nerviosa!"
    mad "I'm so nervous!"

# game/scripts/c27/c27.rpy:1927
translate english c27s003_MadLis_11f71e6d:

    # mc "Me alegro muchísimo por ti."
    mc "I'm very happy for you."

# game/scripts/c27/c27.rpy:1929
translate english c27s003_MadLis_c617c737:

    # lis "Yo me he pedido acompañarla si le llega una invitación de 'Srta. Chang +1'."
    lis "I have called dibs on accompanying her if she receives an invitation for 'Miss Chang +1.'"

# game/scripts/c27/c27.rpy:1930
translate english c27s003_MadLis_683b2274:

    # lis "Yo seré el +1. *Risita* Me encantan las entregas de premios. Sobre todo si gana una amiga."
    lis "I'll be the +1. *Giggle* I love award ceremonies. Especially when a friend wins."

