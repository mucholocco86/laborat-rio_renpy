# game/scripts/c27/c27.rpy:34
translate english c27s001_DebDate_6e671808:

    # deb "Gracias, pero no intentes ruborizarme. Creo que ya lo has hecho suficiente con [kat] esta mañana."
    deb "Thanks, but don't try to make me blush. I think you've done enough of that with [kat] this morning."

# game/scripts/c27/c27.rpy:35
translate english c27s001_DebDate_0d4c2f91:

    # mc "No lo digo por ruborizarte, lo digo porque es verdad. Además, me encanta cómo te queda ese vestido."
    mc "I'm not saying it to embarrass you, I'm saying it because it's true. Besides, I love how that dress looks on you."

# game/scripts/c27/c27.rpy:37
translate english c27s001_DebDate_81172e04:

    # deb "[kim] me ha dicho que... como tengo las piernas tan largas... un vestido asimétrico las realzaría."
    deb "[kim] told me that... since I have such long legs... an asymmetrical dress would emphasize them."

# game/scripts/c27/c27.rpy:38
translate english c27s001_DebDate_51301f4a:

    # deb "No sé si creerla. Siempre he pensado que tengo las piernas {b}demasiado{/b} largas. No es una cosa que me guste realzar."
    deb "I don't know whether to believe her. I've always thought my legs were {b}too{/b} long. It's not something I like to emphasize."

# game/scripts/c27/c27.rpy:39
translate english c27s001_DebDate_ef669374:

    # mc "Cielo, no existen 'piernas {b}demasiado{/b} largas'."
    mc "Honey, there's no such thing as legs that are {b}'too long'{/b}."

# game/scripts/c27/c27.rpy:40
translate english c27s001_DebDate_20b041d4:

    # mc "Como se suele decir, las tuyas son tan largas que, al recorrerlas, apetece hacer un descanso a medio camino."
    mc "As they say, yours are so long that when you travel along them, you feel like taking a break at the halfway point."

# game/scripts/c27/c27.rpy:42
translate english c27s001_DebDate_a513a08c:

    # deb "¡[mc]! ¡Eso ha sonado más travieso de lo que creo que querías sonar!"
    deb "[mc]! That sounded more naughty than I think you meant it to!"

# game/scripts/c27/c27.rpy:43
translate english c27s001_DebDate_442b68f3:

    # mc "*Risa* No te imaginas lo travieso que quería sonar."
    mc "*Laugh* You can't imagine how naughty I wanted to sound."

# game/scripts/c27/c27.rpy:44
translate english c27s001_DebDate_f5cc2b81:

    # mc "Pero, ¿puedo besar a mi cita?"
    mc "But, can I kiss my date?"

# game/scripts/c27/c27.rpy:46
translate english c27s001_DebDate_a10869e9:

    # "La sirena no te contesta y toma la iniciativa por sí misma, besándote dulcemente. Los tacones y la diferencia de altura te hacen sentirte pequeño."
    "The mermaid doesn't answer you and takes the initiative herself, kissing you sweetly. The heels and the difference in height make you feel tiny."

# game/scripts/c27/c27.rpy:47
translate english c27s001_DebDate_72f51c6f:

    # "¡Cómo ha cambiado la nadadora! Ha pasado de inventarse juegos para robarte un beso a tomar la iniciativa."
    "How much the swimmer has changed! She's gone from coming up with games to steal a kiss to taking the initiative."

# game/scripts/c27/c27.rpy:48
translate english c27s001_DebDate_db44b796:

    # "Es un beso que te dejará con ganas de más cuando termine. Da lo mismo que dure un segundo o una hora."
    "It's a kiss that will leave you wanting more when it's over. It doesn't matter if it lasts a second or an hour."

# game/scripts/c27/c27.rpy:50
translate english c27s001_DebDate_4b388357:

    # "Cuando separa sus labios de los tuyos sientes una sensación de pérdida."
    "When she pulls her lips away from yours, you feel a sense of loss."

# game/scripts/c27/c27.rpy:51
translate english c27s001_DebDate_b763e483:

    # deb "Vámonos antes de que tenga que llevarte a tu habitación a probar esa cama nueva."
    deb "Let's go before I have to take you to your room to try out the new bed."

# game/scripts/c27/c27.rpy:52
translate english c27s001_DebDate_e4ee9aa0:

    # mc "*Risa* Ahora eres tú la que has sonado traviesa..."
    mc "*Laugh* Now you're the one who sounded naughty..."

# game/scripts/c27/c27.rpy:54
translate english c27s001_DebDate_151de55f:

    # deb "*Risa* Pero no más de lo que quería sonar."
    deb "*Laugh* But not more than I wanted to sound."

# game/scripts/c27/c27.rpy:55
translate english c27s001_DebDate_4730b6b0:

    # deb "Tengo intención de que me enseñes esa cama cuando volvamos de comer."
    deb "I want you to show me that bed when we get back from lunch."

# game/scripts/c27/c27.rpy:56
translate english c27s001_DebDate_9e51209c:

    # "Otra vez te maravillas de lo mucho que ha evolucionado la siempre tímida [deb.nick]."
    "Once again, you marvel at how much the ever-shy [deb.nick] has evolved."

# game/scripts/c27/c27.rpy:57
translate english c27s001_DebDate_e9d72f3f:

    # mc "Entonces será mejor que nos vayamos. [emm] quería ser la primera en probar la cama."
    mc "Then we'd better go. [emm] wanted to be the first to try out the bed."

# game/scripts/c27/c27.rpy:59
translate english c27s001_DebDate_e8b5c3db:

    # deb "Ya veremos..."
    deb "We'll see about that..."

# game/scripts/c27/c27.rpy:60
translate english c27s001_DebDate_04df0c90:

    # mc "Me gusta esa nueva [deb.nick]. Pero espera..."
    mc "I like this new [deb.nick]. But wait..."

# game/scripts/c27/c27.rpy:62
translate english c27s001_DebDate_9b1b27ed:

    # deb "¿Qué pasa?"
    deb "What's up?"

# game/scripts/c27/c27.rpy:63
translate english c27s001_DebDate_dc5fdda3:

    # mc "Quiero un beso antes de irnos."
    mc "I want a kiss before we leave."

# game/scripts/c27/c27.rpy:65
translate english c27s001_DebDate_0d0a276b:

    # deb "¡Soy idiota! ¡Estaba tan nerviosa por si te gustaría el vestido que ni he pensado en el beso!"
    deb "I'm such an idiot! I was so nervous about whether you would like the dress that I didn't even think about the kiss!"

# game/scripts/c27/c27.rpy:66
translate english c27s001_DebDate_29ea87c7:

    # mc "Y sigues nerviosa. Ya nos hemos besado."
    mc "And you're still nervous. We already kissed."

# game/scripts/c27/c27.rpy:67
translate english c27s001_DebDate_8ca2a38c:

    # deb "¿Qué? ¿Cuándo?"
    deb "What? When?"

# game/scripts/c27/c27.rpy:68
translate english c27s001_DebDate_e9fe48bf:

    # mc "*Risa* Hace un minuto. Ven aquí."
    mc "*Laugh* A minute ago. Come here."

# game/scripts/c27/c27.rpy:70
translate english c27s001_DebDate_e23c623f:

    # "Las tres pulgadas que [deb.nick] es más alta que tú, más los tacones suplen el escalón que ella está más abajo."
    "The three inches that [deb.nick] is taller than you, plus the heels, make up for the lower step she is on."

# game/scripts/c27/c27.rpy:71
translate english c27s001_DebDate_792ce7a8:

    # "Por primera vez no tienes que inclinar tu cabeza hacia atrás para besarla. Lo echas de menos. Adoras la altura de la nadadora."
    "For the first time, you don't have to tilt your head back to kiss her. You miss that. You love the swimmer's height."

# game/scripts/c27/c27.rpy:73
translate english c27s001_DebDate_9cb06c4d:

    # deb "Si me besas así, se me van a pasar los nervios. Pero creo que entonces podré pasar de la comida e ir directamente a ver esa cama."
    deb "If you kiss me like that, I'll stop being so nervous. But then I think I'll be able to skip lunch and go straight to that bed."

# game/scripts/c27/c27.rpy:74
translate english c27s001_DebDate_8cc92cfd:

    # mc "Entonces dejaré de besarte hasta que acabemos de comer. Tengo muchas ganas de ir a comer contigo."
    mc "Then I'll stop kissing you until we finish our meal. I'm really looking forward to having lunch with you."

# game/scripts/c27/c27.rpy:76
translate english c27s001_DebDate_dc12975b:

    # deb "Besar o comer. *Risa* Me pones entre la espada y la pared. Vámonos antes de que haga una locura."
    deb "Kiss or eat. *Laugh* You're putting me between a rock and a hard place. Let's go before I do something crazy."

# game/scripts/c27/c27.rpy:77
translate english c27s001_DebDate_765d6b56:

    # mc "Cualquier locura compartida me parecería bien. Pero podemos esperar a después de comer."
    mc "Any shared madness would be fine with me. But we can wait until after lunch."

# game/scripts/c27/c27.rpy:79
translate english c27s001_DebDate_cec05883:

    # "Una vez llegáis al restaurante..."
    "Once you arrive at the restaurant..."

# game/scripts/c27/c27.rpy:80
translate english c27s001_DebDate_2a2dd50a:

    # deb "Es bonito. Me recuerda a un sitio en el que estuvimos hace un par de años, en Verona."
    deb "It's beautiful. It reminds me of a place we visited a couple of years ago in Verona."

# game/scripts/c27/c27.rpy:81
translate english c27s001_DebDate_2c8bb01b:

    # deb "Se nota que es un decorado, pero está muy logrado."
    deb "You can tell it's fake, but it's very well done."

# game/scripts/c27/c27.rpy:82
translate english c27s001_DebDate_9a611046:

    # mc "¿Has viajado mucho fuera de Estados Unidos?"
    mc "Have you traveled a lot outside the US?"

# game/scripts/c27/c27.rpy:84
translate english c27s001_DebDate_844704a1:

    # deb "Un poco. Creo que este año es el primer verano que recuerdo sin ningún viaje al extranjero en los últimos 13 o 14 años."
    deb "A bit. I think this is the first summer I can remember in the last 13 or 14 years without any trips outside the country."

# game/scripts/c27/c27.rpy:85
translate english c27s001_DebDate_ebd54c03:

    # mc "¿En qué países has estado?"
    mc "Which countries have you been to?"

# game/scripts/c27/c27.rpy:86
translate english c27s001_DebDate_eb037365:

    # deb "Italia, Reino Unido, Portugal, España, Francia, Dinamarca, Suecia, Noruega, Suiza, Alemania, Grecia, Turquía, Japón, China, Australia, Nueva Zelanda, India, Vietnam..."
    deb "Italy, United Kingdom, Portugal, Spain, France, Denmark, Sweden, Norway, Switzerland, Germany, Greece, Turkey, Japan, China, Australia, New Zealand, India, Vietnam..."

# game/scripts/c27/c27.rpy:88
translate english c27s001_DebDate_57e9a0d2:

    # deb "¿Cuánto rato me vas a seguir dejando decir países?"
    deb "How long are you going to let me name countries?"

# game/scripts/c27/c27.rpy:89
translate english c27s001_DebDate_fb7527d3:

    # mc "Pensaba dejarte hasta que recorrieras la ONU al completo. *Risa*"
    mc "I was going to let you keep going until you had gone through the entire UN. *Laugh*"

# game/scripts/c27/c27.rpy:91
translate english c27s001_DebDate_ee968cba:

    # deb "*Risa* No, qué va. En África sólo he estado en Marruecos, Túnez y Egipto. En Latino América sólo en México, Perú, Guatemala, Ecuador, Brasil y Colombia."
    deb "*Laugh* No, not at all. In Africa, I've only been to Morocco, Tunisia, and Egypt. In Latin America, I've only been to Mexico, Peru, Guatemala, Ecuador, Brazil, and Colombia."

# game/scripts/c27/c27.rpy:92
translate english c27s001_DebDate_79a6b884:

    # deb "La Unión Europea la he recorrido entera, y de Asia me quedaban por decir Camboya y Tailandia. Creo que no me dejo ningún país de la lista..."
    deb "I've traveled all over the European Union and, in Asia, I didn't say Cambodia and Thailand. I don't think I'm missing any countries on my list..."

# game/scripts/c27/c27.rpy:93
translate english c27s001_DebDate_d5f11554:

    # mc "Es decir... unos 50 países en 13 o 14 años... es impresionante. Pero casi te daba tiempo a aterrizar y poco más, ¿no?"
    mc "That is... about 50 countries in 13 or 14 years... that's impressive. But you barely had time to land, right?"

# game/scripts/c27/c27.rpy:95
translate english c27s001_DebDate_02eeb9de:

    # deb "Bueno, en verano hacíamos viajes de un mes con mi madre cuando acababan las clases. Y después un par de semanas extras con mi padre en Agosto."
    deb "Well, in the summer we used to go on month-long trips with my mother when school ended. And then a couple of extra weeks with my father in August."

# game/scripts/c27/c27.rpy:96
translate english c27s001_DebDate_f42e0d10:

    # deb "Suma a eso Acción de Gracias, Navidad... Quizás eran un par de meses viajando cada año. Y no son 50 países, sólo 48."
    deb "Add to that Thanksgiving, Christmas... Maybe it was a couple of months of traveling each year. And it's not 50 countries, only 48."

# game/scripts/c27/c27.rpy:97
translate english c27s001_DebDate_96ed9f61:

    # mc "Sigue siendo impresionante."
    mc "It continues to be impressive."

# game/scripts/c27/c27.rpy:99
translate english c27s001_DebDate_e5b3767a:

    # deb "Hay países que me hubiera gustado ver más en profundidad. De algunos sólo he estado en una o dos ciudades."
    deb "There are countries I would have liked to see more of. I've only been to one or two cities in some of them."

# game/scripts/c27/c27.rpy:100
translate english c27s001_DebDate_24a624ac:

    # deb "Y hay otros a los que he ido varias veces, como Italia, Francia, España, Canadá..."
    deb "And there are others I've been to several times, such as Italy, France, Spain, Canada..."

# game/scripts/c27/c27.rpy:101
translate english c27s001_DebDate_9b15654d:

    # mc "¿Tienes algún país favorito?"
    mc "Do you have a favorite country?"

# game/scripts/c27/c27.rpy:103
translate english c27s001_DebDate_9ff5f84b:

    # deb "Muchos. No podría elegir uno. Cada país tiene su encanto, su cultura... Por norma mi país favorito es en el que estoy en ese momento."
    deb "Many. I couldn't choose just one. Every country has its charm, its culture... As a rule, my favorite country is the one I'm in at that moment."

# game/scripts/c27/c27.rpy:104
translate english c27s001_DebDate_0559c921:

    # deb "Si empiezas a pensar cosas como 'esto era más bonito, o estaba más bueno, en otro sitio' no disfrutas lo que estás viviendo."
    deb "If you start thinking things like, 'This was nicer, or it was better somewhere else', you won't enjoy what you're experiencing."

# game/scripts/c27/c27.rpy:105
translate english c27s001_DebDate_5dc520e9:

    # deb "Me encanta viajar, y cuando estoy en un sitio sólo existe ese sitio. No puedo compararlo con otros."
    deb "I love traveling, and when I'm in a place, only that place exists. I can't compare it to other places I've been to."

# game/scripts/c27/c27.rpy:106
translate english c27s001_DebDate_97045e27:

    # mc "Nunca lo había visto así. Siempre he oído a gente decir 'Estoy enamorado de Japón, Italia, o España'."
    mc "That's an interesting perspective. I've always heard people say, 'I'm in love with Japan, Italy, or Spain'."

# game/scripts/c27/c27.rpy:107
translate english c27s001_DebDate_120ee616:

    # mc "Tiene mucha más lógica cómo lo dices tú."
    mc "It makes much more sense the way you put it."

# game/scripts/c27/c27.rpy:109
translate english c27s001_DebDate_c9ea9070:

    # deb "¿Y tú? ¿En qué países has estado?"
    deb "And you? Which countries have you been to?"

# game/scripts/c27/c27.rpy:110
translate english c27s001_DebDate_2998f279:

    # mc "De toda tu lista, sólo en Canadá. Fui a un concierto en Vancouver cuando estaba en Portland, el primer año."
    mc "From your entire list, only to Canada. I went to a concert in Vancouver when I was living in Portland, the first year."

# game/scripts/c27/c27.rpy:111
translate english c27s001_DebDate_1eb823d3:

    # deb "¿Y sitios que no estén en mi lista?"
    deb "What about countries that aren't on my list?"

# game/scripts/c27/c27.rpy:112
translate english c27s001_DebDate_dbbd4c94:

    # mc "*Risa* Ninguno. No hemos viajado mucho, ni dentro ni fuera de Estados Unidos."
    mc "*Laugh* None. We haven't traveled much, either within the United States or abroad."

# game/scripts/c27/c27.rpy:113
translate english c27s001_DebDate_64d51d8f:

    # mc "Pero estaré en Aruba, que no está en tu lista. *Risa*"
    mc "But I'll be in Aruba, which isn't on your list. *Laugh*"

# game/scripts/c27/c27.rpy:115
translate english c27s001_DebDate_2553ffcc:

    # deb "Bueno, el status de Aruba como país es diferente a lo que estamos acostumbrados los americanos."
    deb "Well, Aruba's status as a country is different from what we Americans are used to."

# game/scripts/c27/c27.rpy:116
translate english c27s001_DebDate_cd1fe8ab:

    # deb "Casi sería como hablar de un estado de los Países Bajos. Como si habláramos de Virginia respecto a Estados Unidos."
    deb "It would almost be like talking about a state in the Netherlands. Like talking about Virginia in relation to the United States."

# game/scripts/c27/c27.rpy:117
translate english c27s001_DebDate_7b3ff11f:

    # mc "Siempre he pensado que era un país independiente."
    mc "I always thought it was an independent country."

# game/scripts/c27/c27.rpy:119
translate english c27s001_DebDate_c9eceb4a:

    # deb "Yo también. Nunca había leído nada sobre él hasta que decidiste irte allí."
    deb "Me too. I had never read anything about it until you decided to go there."

# game/scripts/c27/c27.rpy:120
translate english c27s001_DebDate_e8dc22b4:

    # deb "Conozco gente que ha ido a hacer turismo, pero no sabía nada del país."
    deb "I know people who have gone there as tourists, but I didn't know anything about the country."

# game/scripts/c27/c27.rpy:121
translate english c27s001_DebDate_af3ebf53:

    # mc "Es conmovedor que te preocupes así por mí."
    mc "It's touching that you care so much about me."

# game/scripts/c27/c27.rpy:123
translate english c27s001_DebDate_7f378831:

    # deb "*Risa* Tenía que comprobar si iban a secuestrar a mi novio o algo así."
    deb "*Laugh* I had to check if someone was going to kidnap my boyfriend or something like that."

# game/scripts/c27/c27.rpy:124
translate english c27s001_DebDate_acd21027:

    # mc "Creo que el riesgo de secuestro es más alto por parte de la empresa que del país."
    mc "I believe that the risk of kidnapping is higher from the company than from the country."

# game/scripts/c27/c27.rpy:125
translate english c27s001_DebDate_43673dbb:

    # mc "*Risa* Y que me protejan de un posible secuestro también."
    mc "*Laugh* And that they protect me from possible kidnapping too."

# game/scripts/c27/c27.rpy:126
translate english c27s001_DebDate_a7f8dac3:

    # deb "*Risa* Tienes razón. Yo no intentaría secuestrarte con [ama] o [eva] cerca. *Susurrando* Y un ejército de clones."
    deb "*Laugh* You're right. I wouldn't try to kidnap you with [ama] or [eva] around. *Whispering* And an army of clones."

# game/scripts/c27/c27.rpy:128
translate english c27s001_DebDate_69705291:

    # deb "Por suerte hoy no están en casa..."
    deb "Luckily, they're not home today... And I could kidnap you."

# game/scripts/c27/c27.rpy:129
translate english c27s001_DebDate_c5aaca27:

    # mc "Te noto muy traviesa hoy. *Risa* No me lo esperaba."
    mc "You seem very mischievous today. *Laugh* I wasn't expecting that."

# game/scripts/c27/c27.rpy:131
translate english c27s001_DebDate_91aa1172:

    # deb "Empecé a hacer bromas con [lis] anoche para ocultar lo insegura que me sentía."
    deb "I started joking around with [lis] last night, to hide how insecure I was feeling."

# game/scripts/c27/c27.rpy:132
translate english c27s001_DebDate_e927e82f:

    # deb "¿Sabes lo de fingir una sonrisa hasta que sea real? Pues con las bromas sobre sexo funcionó. Tras varias bromas, dejé de preocuparme."
    deb "You know what they say about faking a smile until it becomes real? Well, it worked with the sex jokes. After a few jokes, I stopped worrying."

# game/scripts/c27/c27.rpy:133
translate english c27s001_DebDate_073c9c8e:

    # deb "Empecé a verlo como la continuación de lo que hicimos en el lago. Se que es un paso más, y un paso muy importante, pero..."
    deb "I started to see it as a continuation of what we did at the lake. I know it's another step, and a very important one, but..."

# game/scripts/c27/c27.rpy:134
translate english c27s001_DebDate_c1a5986e:

    # mc "Pero lo ves natural ahora, ¿no?"
    mc "But you see it as a natural step now, don't you?"

# game/scripts/c27/c27.rpy:136
translate english c27s001_DebDate_1fc4c21d:

    # deb "Lo veo el paso más natural del mundo. No es que no hayamos hecho cosas tórridas ya, con lo que el siguiente paso parece menos grande."
    deb "I see it as the most natural step in the world. It's not like we haven't done anything steamy already, so the next step seems less daunting."

# game/scripts/c27/c27.rpy:137
translate english c27s001_DebDate_8244b8f2:

    # deb "Y bromear anoche... y seguir bromeando contigo, hace que dé menos miedo."
    deb "And joking around last night... and continuing to joke around with you makes it less scary."

# game/scripts/c27/c27.rpy:138
translate english c27s001_DebDate_0b3f517b:

    # mc "Si tienes miedo..."
    mc "If you're afraid..."

# game/scripts/c27/c27.rpy:140
translate english c27s001_DebDate_00f1240c:

    # deb "De lo único que tengo miedo es de hacerte daño. *Risa* ¡Mis músculos son de acero!"
    deb "The only thing I'm afraid of is hurting you. *Laugh* My muscles are made of steel!"

# game/scripts/c27/c27.rpy:141
translate english c27s001_DebDate_29b7bf87:

    # mc "Preciosos músculos, por cierto."
    mc "Nice muscles, by the way."

# game/scripts/c27/c27.rpy:143
translate english c27s001_DebDate_1aa8bd84:

    # deb "Pero no adelantemos acontecimientos y sigamos como si fuera una cita normal. ¿Cuál es tu libro favorito?"
    deb "But let's not get ahead of ourselves. Let's continue as if this were a normal date. What's your favorite book?"

# game/scripts/c27/c27.rpy:144
translate english c27s001_DebDate_db8e0778:

    # mc "¡Ufff! Esa es una pregunta complicada. Hay muchísimos libros que me gustan, pero si tuviera que elegir un favorito..."
    mc "Phew! That's a tough question. There are so many books I like, but if I had to choose a favorite..."

# game/scripts/c27/c27.rpy:145
translate english c27s001_DebDate_38165e76:

    # mc "Seguramente sería el tercero del Círculo del Tiempo. ¿Y el tuyo?"
    mc "It would probably be the third one in the Circle of Time. What about yours?"

# game/scripts/c27/c27.rpy:147
translate english c27s001_DebDate_f9ee2129:

    # deb "Yo lo tengo muy fácil. Orgullo y Prejuicio. Es el libro que me hizo amar los libros. Y por eso empecé a estudiar Literatura Inglesa."
    deb "It's easy for me. Pride and Prejudice. It's the book that made me love books. And that's why I started studying English Literature."

# game/scripts/c27/c27.rpy:148
translate english c27s001_DebDate_3e25f0ac:

    # deb "He leído libros mejores, pero Orgullo y Prejuicio siempre tendrá un lugar especial en mi cabeza."
    deb "I've read better books, but Pride and Prejudice will always have a special place in my heart."

# game/scripts/c27/c27.rpy:149
translate english c27s001_DebDate_82b97cbd:

    # mc "Suena a una relación especial con un libro. Yo también tengo un libro así, pero en sentido opuesto."
    mc "It sounds like a special relationship with a book. I have a book like that too, but in the opposite sense."

# game/scripts/c27/c27.rpy:150
translate english c27s001_DebDate_7f2176e2:

    # mc "Estadística Avanzada (III) del último año de carrera. *Risa* Odié ese libro en cada una de sus páginas."
    mc "Advanced Statistics (III) in my final year at college. *Laugh* I hated every single page of that book."

# game/scripts/c27/c27.rpy:152
translate english c27s001_DebDate_2ac0b655:

    # deb "*Risa* Puedo entenderlo. Hay libros académicos que parecen ser escritos para que odies cada momento que pasas estudiando esa asignatura."
    deb "*Laugh* I can understand that. There are textbooks that seem to be written to make you hate every moment you spend studying that subject."

# game/scripts/c27/c27.rpy:153
translate english c27s001_DebDate_ec400438:

    # mc "Sí, hay profesores que deberían tener prohibido escribir libros."
    mc "Yes, there are teachers who should be banned from writing books."

# game/scripts/c27/c27.rpy:154
translate english c27s001_DebDate_76358196:

    # mc "Pero hablando de estudios, ¿por qué elegiste Newport?"
    mc "But talking about studies, why did you choose Newport?"

# game/scripts/c27/c27.rpy:156
translate english c27s001_DebDate_9cc8bb8e:

    # deb "Después de meses de chatear con Anthony, [lis] quería venir un fin de semana a conocerlo."
    deb "After months of chatting with Anthony, [lis] wanted to come visit him for a weekend."

# game/scripts/c27/c27.rpy:157
translate english c27s001_DebDate_7acc7880:

    # deb "Cuando le dije que quería irme de Phoenix, empezó a planearlo todo para hacer el traslado aquí."
    deb "When I told her I wanted to leave Phoenix, she started planning everything for the move here."

# game/scripts/c27/c27.rpy:158
translate english c27s001_DebDate_ce183507:

    # deb "Tienen un buen programa de Literatura Inglesa y un entrenador conocido de natación, con lo que me pareció bien."
    deb "They have a good English Literature program and a well-known swimming coach, so I thought it was a good fit."

# game/scripts/c27/c27.rpy:159
translate english c27s001_DebDate_3a584d81:

    # mc "¿Cambiasteis de universidad por Anthony?"
    mc "Did you change universities because of Anthony?"

# game/scripts/c27/c27.rpy:161
translate english c27s001_DebDate_18f5ef8b:

    # deb "No, Anthony fue lo que hizo que [lis] se interesara por la NWU. Es una universidad pequeña que ni siquiera conocíamos."
    deb "No, Anthony was what got [lis] interested in NWU. It's a small university that we didn't even know about."

# game/scripts/c27/c27.rpy:162
translate english c27s001_DebDate_e2c60607:

    # deb "Si no hubiera sido por él, habríamos acabado en alguna otra universidad. [lis] quería que estuviera en la costa."
    deb "If it hadn't been for him, we would have ended up at some other university. [lis] wanted us to be on the coast."

# game/scripts/c27/c27.rpy:163
translate english c27s001_DebDate_5f59394e:

    # deb "De todas formas, sólo nos matriculamos para el curso de verano, con lo que era una decisión poco arriesgada para probar."
    deb "In any case, we only enrolled for the summer course, so it was a low-risk choice to try it out."

# game/scripts/c27/c27.rpy:164
translate english c27s001_DebDate_0e5eaaf0:

    # mc "¿Sólo el curso de verano? Creía que os quedabais en septiembre también."
    mc "Just the summer course? I thought you were staying for the Fall term as well."

# game/scripts/c27/c27.rpy:166
translate english c27s001_DebDate_2691dc9a:

    # deb "Nos quedamos. Pero queríamos probar la universidad antes de decidir."
    deb "We're staying. But we wanted to try the university before deciding."

# game/scripts/c27/c27.rpy:167
translate english c27s001_DebDate_eda4a3fc:

    # deb "La universidad nos ha convencido lo suficiente. Y de todas formas yo no querría irme. Al menos no para volver a Phoenix."
    deb "The university has convinced us enough. And anyway, I wouldn't want to leave. At least not to go back to Phoenix."

# game/scripts/c27/c27.rpy:168
translate english c27s001_DebDate_51bef97d:

    # mc "Si quería costa, ¿cómo acabasteis en Phoenix en primer lugar?"
    mc "If you wanted to live by the coast, how did you end up in Phoenix in the first place?"

# game/scripts/c27/c27.rpy:170
translate english c27s001_DebDate_cef27452:

    # deb "Ella quería una universidad lejos de casa, para poder vivir su vida lejos donde nadie la conociera y lejos de la influencia de mi padre."
    deb "She wanted to go to a university far from home so she could live her life away from everyone who knew her, and away from my father's influence."

# game/scripts/c27/c27.rpy:171
translate english c27s001_DebDate_284c3d14:

    # deb "Cuando me tocó elegir universidad a mí, fui con ella."
    deb "When it was my turn to choose a university, I went with her."

# game/scripts/c27/c27.rpy:172
translate english c27s001_DebDate_ff408941:

    # mc "Y después de un año, decidiste que querías irte de allí. ¿El clima?"
    mc "And after a year, you decided you wanted to leave. Was it the weather?"

# game/scripts/c27/c27.rpy:174
translate english c27s001_DebDate_4f5affb8:

    # deb "No, un asistente de entrenador... demasiado cariñoso. Yo me sentía muy incómoda con él."
    deb "No. A... too affectionate coach's assistant... I felt very uncomfortable around him."

# game/scripts/c27/c27.rpy:175
translate english c27s001_DebDate_4a05a759:

    # deb "[lis] quería que lo denunciara, pero no tenía ninguna prueba, con lo que irme era lo mejor."
    deb "[lis] wanted me to report him, but I didn't have any proof, so leaving was the best thing to do."

# game/scripts/c27/c27.rpy:176
translate english c27s001_DebDate_bc5966e7:

    # mc "Cuando dices cariñoso..."
    mc "When you say affectionate..."

# game/scripts/c27/c27.rpy:178
translate english c27s001_DebDate_deabdb51:

    # deb "Una mano que se escapa y toca donde no debe a la hora de corregir una postura. Abrazos que duran demasiado para celebrar victorias..."
    deb "A hand that slips and touches where it shouldn't when correcting a posture. Hugs that last too long to celebrate victories..."

# game/scripts/c27/c27.rpy:179
translate english c27s001_DebDate_2bc39e06:

    # deb "Cosas así. Cosas que, visto desde fuera, pueden parecer que no son nada, pero cuando las vas sumando... te hacen sentir incómoda."
    deb "Things like that. Things that, seen from the outside, may seem insignificant, but when you add them up... they make you feel uncomfortable."

# game/scripts/c27/c27.rpy:180
translate english c27s001_DebDate_d19a604f:

    # mc "Es normal. ¿Cómo empezó? ¿Lo hacía con otras chicas también?"
    mc "That's normal. How did it start? Did he do it with other girls as well?"

# game/scripts/c27/c27.rpy:182
translate english c27s001_DebDate_e46d8acf:

    # deb "Cuando llegué, era muy simpático y me hizo sentir integrada en el equipo. Fue el primero que empezó a llamarme 'Deb'."
    deb "When I arrived, he was very friendly and made me feel part of the team. He was the first one to start calling me 'Deb'."

# game/scripts/c27/c27.rpy:184
translate english c27s001_DebDate_ea46801a:

    # deb "Por eso me molestó cuando me lo llamaste tú. Sólo mi abuela me llama así y, si alguien aparte de ella lo hace, lo voy a asociar con ese entrenador."
    deb "That's why it bothered me when you called me that. Only my grandmother and [lis] call me that, and if anyone else does, I'm going to associate it with that coach."

# game/scripts/c27/c27.rpy:186
translate english c27s001_DebDate_a42fff8c:

    # deb "Por eso no me gusta que me llamen así. Sólo mi abuela me llama así y, si alguien aparte de ella lo hace, lo voy a asociar con ese entrenador."
    deb "That's why I don't like being called that. Only my grandmother and [lis] call me that, and if anyone else does, I'll associate them with that coach."

# game/scripts/c27/c27.rpy:188
translate english c27s001_DebDate_554cc2f4:

    # deb "Poco a poco la cosa se fue poniendo más incómoda, pero como veía que con algunas de las otras chicas hacía lo mismo, pensé que era normal."
    deb "Little by little, things got more uncomfortable, but since I saw that he was doing the same thing with some of the other girls, I thought it was normal."

# game/scripts/c27/c27.rpy:189
translate english c27s001_DebDate_7148f2b7:

    # deb "A ellas no parecía importarles. Era guapo y ellas se lo consentían. Pero a mí me molestaba. Intenté hablarlo con él, pero negó estar haciendo nada incorrecto."
    deb "They didn't seem to mind. He was handsome, and they indulged him. But it bothered me. I tried to talk to him about it, but he denied doing anything wrong."

# game/scripts/c27/c27.rpy:190
translate english c27s001_DebDate_3dbcc7d5:

    # mc "Y decidiste irte. Si puedo hacer algo..."
    mc "And you decided to leave. If there's anything I can do..."

# game/scripts/c27/c27.rpy:192
translate english c27s001_DebDate_7e4b3d06:

    # deb "Gracias, pero no. Yéndome ha quedado resuelto."
    deb "Thanks, but no. It's been resolved now that I'm gone."

# game/scripts/c27/c27.rpy:193
translate english c27s001_DebDate_b9d7f0f7:

    # deb "Mis tiempos se resintieron. No iba a gusto a entrenar y se notaba. En dos años hay Juegos Olímpicos en París y me gustaría estar ahí."
    deb "My times suffered. I wasn't enjoying training, and it showed. The Olympics are in Paris in two years, and I'd like to be there."

# game/scripts/c27/c27.rpy:194
translate english c27s001_DebDate_2faf6ea9:

    # deb "Al menos intentarlo. Si seguía en Phoenix no iba a poder hacerlo. Con lo que el cambio es bienvenido."
    deb "At least I want to try. If I stayed in Phoenix, I wouldn't be able to do it. So, the change is welcome."

# game/scripts/c27/c27.rpy:195
translate english c27s001_DebDate_07b6ae05:

    # mc "¿Juegos Olímpicos? Entonces [sim] tenía razón. ¡Eres buenísima!"
    mc "The Olympics? Then [sim] was right. You're really good!"

# game/scripts/c27/c27.rpy:197
translate english c27s001_DebDate_59776c96:

    # deb "Ahora mismo no me clasificaría, pero si trabajo duro... Tengo una posibilidad. Quedan casi dos años para los Trials y sólo necesitaría unos meses para ponerme en forma."
    deb "Right now, I wouldn't qualify for the Games, but if I work hard... I have a chance. There are almost two years until the Trials, and I would only need a few months to get in shape."

# game/scripts/c27/c27.rpy:198
translate english c27s001_DebDate_0cf8fd2b:

    # deb "Si Dara Vollmer y Dana Torres pudieron ganar medallas en las olimpiadas después de dar a luz... "
    deb "If Dara Vollmer and Dana Torres were able to win medals at the Olympics after giving birth..."

# game/scripts/c27/c27.rpy:199
translate english c27s001_DebDate_36a2a20e:

    # mc "No sé quiénes son. Supongo que nadadoras que han tenido hijos."
    mc "I don't know who they are. I guess they're swimmers who've had children."

# game/scripts/c27/c27.rpy:201
translate english c27s001_DebDate_921c2fc2:

    # deb "Sí, las dos compitieron después de sus embarazos y las dos ganaron medallas en las olimpiadas. En Pekín y en Rio."
    deb "Yes, both competed after their pregnancies, and both won medals at the Olympics. In Beijing and Rio."

# game/scripts/c27/c27.rpy:202
translate english c27s001_DebDate_6345e182:

    # deb "Pero claro, ellas eran mejores de lo que yo soy ahora antes de quedarse embarazadas..."
    deb "But of course, they were better than I am now, before they got pregnant..."

# game/scripts/c27/c27.rpy:203
translate english c27s001_DebDate_a6de434a:

    # mc "Te iba a preguntar si querías tener hijos, pero viendo que has investigado..."
    mc "I was going to ask you if you wanted to have children, but seeing that you've done your research..."

# game/scripts/c27/c27.rpy:208
translate english c27s001_DebDate_80342353:

    # deb "Todas las que se han hecho la prueba han salido positivas. Eso significa que quieres tener muchos hijos."
    deb "All the girls who have taken the test have tested positive. That means you want to have many children."

# game/scripts/c27/c27.rpy:209
translate english c27s001_DebDate_b32708d1:

    # deb "No me gustaría ser la única con la que no los tienes."
    deb "I wouldn't want to be the only one you don't have them with."

# game/scripts/c27/c27.rpy:211
translate english c27s001_DebDate_87cec64c:

    # deb "Sabiendo que quieres tener hijos, me gustaría que los tuviéramos."
    deb "Knowing that you want to have children, I would like us to have some."

# game/scripts/c27/c27.rpy:213
translate english c27s001_DebDate_0ccba3b9:

    # deb "No sé si quieres tener hijos o no, pero a mí no me importaría."
    deb "I don't know if you want to have children or not, but I wouldn't mind."

# game/scripts/c27/c27.rpy:214
translate english c27s001_DebDate_5e145226:

    # deb "Dentro de un año me afectaría más para mi carrera de nadadora. Si los quieres tener, ahora o justo después de unas olimpiadas serían los mejores momentos."
    deb "In a year's time, it would affect my swimming career more. If you want to have them, now or just after the Olympics would be the best time."

# game/scripts/c27/c27.rpy:215
translate english c27s001_DebDate_da88ba8b:

    # mc "No había pensado en cómo te podría afectar en tu carrera. Me gusta que lo hayas hecho tú por los dos."
    mc "I hadn't thought about how it might affect your career. I'm glad you did it for both of us."

# game/scripts/c27/c27.rpy:217
translate english c27s001_DebDate_7b849e5f:

    # deb "Sé que quizás suene muy frío dicho así, pero uno de mis sueños es participar en unas olimpiadas. Y no quiero renunciar a él."
    deb "I know it may sound very cold when I say it like that, but one of my dreams is to participate in the Olympics. And I don't want to give up on it."

# game/scripts/c27/c27.rpy:218
translate english c27s001_DebDate_2c0460ba:

    # mc "No te preocupes. No me ha sonado frío. Son cosas en las que, los que sólo hacemos deporte en los videojuegos, no solemos pensar."
    mc "Don't worry. It didn't sound cold to me. It's just something that those of us who only play sports in video games don't usually think about."

# game/scripts/c27/c27.rpy:219
translate english c27s001_DebDate_5543d3d8:

    # mc "Y, teniendo todo el tiempo del mundo para tener hijos, no tienes por qué renunciar a tus sueños."
    mc "And, with all the time in the world to have children, you don't have to give up on your dreams."

# game/scripts/c27/c27.rpy:220
translate english c27s001_DebDate_0d4449b2:

    # mc "Lo que me extraña es tu elección de estudios. ¿Literatura Inglesa en vez de algo relacionado con el deporte?"
    mc "What surprises me is your choice of studies. English literature instead of something related to sports?"

# game/scripts/c27/c27.rpy:222
translate english c27s001_DebDate_670ba289:

    # deb "Mi segunda opción era Ciencias del Deporte, pero no estaba segura de si querría dedicarme a entrenar a otras nadadoras cuando dejase de nadar."
    deb "My second choice was Sports Science, but I wasn't sure if I wanted to coach other swimmers when I stopped swimming."

# game/scripts/c27/c27.rpy:223
translate english c27s001_DebDate_94666eeb:

    # deb "Sería una forma de seguir ligada al mundo de la natación, pero aún no estoy segura de querer hacerlo."
    deb "It would be a way to stay connected to the world of swimming, but I'm not sure I want to do it yet."

# game/scripts/c27/c27.rpy:224
translate english c27s001_DebDate_5fde71bc:

    # mc "¿Prefieres ser una profesora de literatura en un instituto?"
    mc "Would you rather be a literature teacher at a high school?"

# game/scripts/c27/c27.rpy:226
translate english c27s001_DebDate_7f8f4c84:

    # deb "*Risa* Dudo que alguna vez pueda ser profesora de instituto. Los alumnos me tomarían el pelo. Hay que ser más dura de lo que soy yo para manejar un grupo de 20 adolescentes."
    deb "*Laugh* I doubt I could ever be a high school teacher. The students would make fun of me. You have to be tougher than I am to handle a group of 20 teenagers."

# game/scripts/c27/c27.rpy:227
translate english c27s001_DebDate_b197bbe0:

    # deb "Elegí la carrera porque me encanta la literatura, no para ejercer. Ya sabes..."
    deb "I chose this degree because I love literature, not to work in the field. You know..."

# game/scripts/c27/c27.rpy:228
translate english c27s001_DebDate_6862479b:

    # mc "Sí, dinero viejo y falta de necesidad de trabajar."
    mc "Yes, old money and no need to work."

# game/scripts/c27/c27.rpy:230
translate english c27s001_DebDate_2575181e:

    # deb "Mas o menos. No somos dinero MUY viejo, pero lo suficiente. A principios del siglo pasado mi tatarabuelo era un pequeño granjero en Aurora."
    deb "More or less. We're not VERY old money, but we're old enough. At the beginning of the 20th century, my great-great-grandfather was a small farmer in Aurora."

# game/scripts/c27/c27.rpy:231
translate english c27s001_DebDate_06f581e8:

    # mc "De granjero a familia rica..."
    mc "From farmer to wealthy family..."

# game/scripts/c27/c27.rpy:233
translate english c27s001_DebDate_989e8c07:

    # deb "En la Gran Depresión y durante el Dust Bowl compró un montón de tierras a bajo precio en Illinois y Missouri. También algunas minas de plomo."
    deb "During the Great Depression and the Dust Bowl, he bought a lot of land at low prices in Illinois and Missouri. He also bought some lead mines."

# game/scripts/c27/c27.rpy:234
translate english c27s001_DebDate_3a0c2978:

    # deb "Él y mi bisabuelo diversificaron la fortuna durante la Segunda Guerra Mundial. Industria, investigación, contratos con el ejército..."
    deb "He and my great-grandfather diversified the business during World War II. Industry, research, contracts with the army..."

# game/scripts/c27/c27.rpy:235
translate english c27s001_DebDate_98584c64:

    # deb "Nunca he sabido la lista completa de empresas en las que tenemos participación. Ni me interesa."
    deb "I have never known the complete list of companies in which we have a stake. Nor am I interested in it."

# game/scripts/c27/c27.rpy:236
translate english c27s001_DebDate_049fbf8d:

    # mc "Supongo que tiene que ser complicado."
    mc "I guess it must be complicated."

# game/scripts/c27/c27.rpy:238
translate english c27s001_DebDate_8d14cd96:

    # deb "Complicado y aburrido. Nunca me ha interesado el dinero. Quizás porque nunca me ha faltado."
    deb "Complicated and boring. I've never been interested in money. Maybe because I've never had a shortage of it."

# game/scripts/c27/c27.rpy:239
translate english c27s001_DebDate_e38dd30a:

    # deb "A [lis], aunque tampoco le interese, siempre le ha gustado más todo lo que rodea el dinero. Alta sociedad, famosos, y todo eso."
    deb "Even though she's not interested in it, [lis] has always liked the glitz and glamour that surrounds money. High society, celebrities, and all that."

# game/scripts/c27/c27.rpy:240
translate english c27s001_DebDate_f43cd1ef:

    # deb "Pero a mí no. El dinero tiene que servir para cubrir las necesidades propias y de la familia."
    deb "But not me. Money has to be used to cover your own needs and those of your family."

# game/scripts/c27/c27.rpy:241
translate english c27s001_DebDate_a94459db:

    # mc "Es normal. En el fondo es para lo único que sirve. Una vez cubiertas las necesidades, el resto son caprichos."
    mc "It's normal. Deep down, that's all it's good for. Once your needs are met, the rest is just whims."

# game/scripts/c27/c27.rpy:243
translate english c27s001_DebDate_de64881b:

    # deb "Por suerte, mis caprichos son relativamente baratos. *Risa* Libros, videojuegos, música..."
    deb "Luckily, my whims are relatively inexpensive. *Laugh* Books, video games, music..."

# game/scripts/c27/c27.rpy:244
translate english c27s001_DebDate_f92bf164:

    # mc "Hemos hablado de libros y videojuegos, pero nunca de música. ¿Qué música te gusta?"
    mc "We've talked about books and video games, but never about music. What kind of music do you like?"

# game/scripts/c27/c27.rpy:245
translate english c27s001_DebDate_02794b27:

    # deb "Tengo gustos muy variados y que [lis] dice que no pegan demasiado. Pop, Folk, Blues, Metal, Rock, Clásica..."
    deb "I have very eclectic tastes, which [lis] says don't really go together. Pop, folk, blues, metal, rock, classical..."

# game/scripts/c27/c27.rpy:246
translate english c27s001_DebDate_b12523bf:

    # mc "*Risa* Es cierto que no pegan demasiado."
    mc "*Laugh* It's true, they don't really go together."

# game/scripts/c27/c27.rpy:248
translate english c27s001_DebDate_549d5b2a:

    # deb "*Risa* Imagíname con una peluca barroca haciendo así. ¡Yeahhh!"
    deb "*Laugh* Imagine me wearing a baroque wig and doing this. Yeahhh!"

# game/scripts/c27/c27.rpy:249
translate english c27s001_DebDate_34fc4868:

    # mc "*Risa* Puedo hacerlo. Además, oliendo a pachuli, con un bolso de diseño y con una chaqueta de cuero."
    mc "*Laugh* I can do that. Besides, smelling like patchouli, with a designer handbag and a leather jacket."

# game/scripts/c27/c27.rpy:251
translate english c27s001_DebDate_b01b50cd:

    # deb "¡Ni siquiera yo iría así! *Risa* ¡[lis] no me dejaría salir de mi habitación! Bueno, de nuestra habitación."
    deb "Not even I would go out like that! *Laugh* [lis] wouldn't let me leave my room! Well, our room."

# game/scripts/c27/c27.rpy:252
translate english c27s001_DebDate_d4dec132:

    # deb "Pero sea la música que sea, me gusta escucharla, no bailarla."
    deb "But whatever the music, I like listening to it, not dancing to it."

# game/scripts/c27/c27.rpy:253
translate english c27s001_DebDate_9ccbcedc:

    # mc "Bueno, en el Jazz Corner bailamos."
    mc "Well, we danced at the Jazz Corner."

# game/scripts/c27/c27.rpy:255
translate english c27s001_DebDate_c56d3f1b:

    # deb "No bailamos. Me hiciste volar."
    deb "We didn't dance. You made me fly."

# game/scripts/c27/c27.rpy:256
translate english c27s001_DebDate_6f9af9ef:

    # mc "La próxima vez te dejaré poner los pies en el suelo."
    mc "Next time, I'll let you put your feet on the floor."

# game/scripts/c27/c27.rpy:257
translate english c27s001_DebDate_4c81d3ec:

    # deb "¿A riesgo de que te pise?"
    deb "At the risk of getting stepped on?"

# game/scripts/c27/c27.rpy:258
translate english c27s001_DebDate_d65ffcb1:

    # mc "Aceptaré ese riesgo. Aunque dudo que lo hagas. Deberías tener más seguridad en ti misma."
    mc "I'll accept that risk. Although I doubt you'll do it. You should have more confidence in yourself."

# game/scripts/c27/c27.rpy:259
translate english c27s001_DebDate_047876a6:

    # mc "No eres [kim] y no vas a tropezarte con tus propios pies. Y ni siquiera ella me pisó."
    mc "You're not [kim], and you're not going to trip over your own feet. And she didn't even step on me."

# game/scripts/c27/c27.rpy:261
translate english c27s001_DebDate_0359da27:

    # deb "¡No te metas con [kim]! Yo sería incapaz de andar por una pasarela como lo hace ella."
    deb "Don't mess with [kim]! I would never be able to walk down a catwalk like she does."

# game/scripts/c27/c27.rpy:262
translate english c27s001_DebDate_98cbb0ea:

    # mc "No me estoy metiendo con ella. *Risa* Tan solo estoy haciendo una constatación de hechos."
    mc "I'm not messing with her. *Laugh* I'm just stating facts."

