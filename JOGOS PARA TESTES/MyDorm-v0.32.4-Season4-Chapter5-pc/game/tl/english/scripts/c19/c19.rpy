# game/scripts/c19/c19.rpy:1464
translate english c19s004_PhoneMessage_57adc882:

    # deb "Una más aquí..."
    deb "One more here..."

# game/scripts/c19/c19.rpy:2460
translate english c19s005_Kiara_4435680a:

    # "{color=#ff0000}Stop here and roll back."
    "{color=#ff0000}Stop here and roll back."

# game/scripts/c19/c19.rpy:2464
translate english c19s005_KateNorah_d20194c0:

    # "Buscas a Eileeen con la mirada, pero no la ves por ningún lado. Supones que estará en el juego del jacuzzi."
    "You look around for Eileen, but she's nowhere to be seen. You assume she'll be at the hot tub game with the rest of the girls."

# game/scripts/c19/c19.rpy:2465
translate english c19s005_KateNorah_792c99e6:

    # "Cada vaz quedan menos chicas en la piscina. Te acercas a Kate y a [nor]."
    "There are fewer and fewer girls left in the pool. You approach Kate and [nor]."

# game/scripts/c19/c19.rpy:2468
translate english c19s005_KateNorah_79127472:

    # kat "Aquí llega mi héroe. *Risa* Salir con una de las preciosidades de esta familia ya es un triunfo. Tú lo haces con más de una."
    kat "Here comes my hero. *Laugh* Dating one of the cuties in this family is already a feat. You are dating more than one!"

# game/scripts/c19/c19.rpy:2469
translate english c19s005_KateNorah_734d98ae:

    # mc "No es heroísmo. *Risa* Es suerte."
    mc "It's not heroism. *Laugh* It's sheer luck."

# game/scripts/c19/c19.rpy:2471
translate english c19s005_KateNorah_180c6917:

    # mc "Y me refiero a suerte por mi parte. Estar con alguien como [nor] es increíble."
    mc "And I mean luck on my part. To be with someone like [nor] is amazing."

# game/scripts/c19/c19.rpy:2472
translate english c19s005_KateNorah_979b2ad2:

    # nor "Gracias, mi amor."
    nor "Thank you, my love."

# game/scripts/c19/c19.rpy:2474
translate english c19s005_KateNorah_ee6e34cd:

    # mc "Y me refiero a suerte por mi parte."
    mc "And I mean luck on my part."

# game/scripts/c19/c19.rpy:2475
translate english c19s005_KateNorah_7f7a7a24:

    # nor "Por tu parte y por la de ellas."
    nor "On your part and on theirs."

# game/scripts/c19/c19.rpy:2477
translate english c19s005_KateNorah_15f32294:

    # kat "Aquí llega el hombre del día. *Risa* Que hayas conseguido una relación en esta familia es para felicitarte."
    kat "Here comes the man of the day. *Laugh* That you got a relationship in this family of cuties is to congratulate you."

# game/scripts/c19/c19.rpy:2479
translate english c19s005_KateNorah_aa1ff343:

    # mc "Gracias. No podría estar con nadie mejor. *Risa* Y no lo digo porque esté delante."
    mc "Thank you. I couldn't be with anyone better. *Laugh* And I'm not just saying that because I'm in front of her."

# game/scripts/c19/c19.rpy:2480
translate english c19s005_KateNorah_979b2ad2_1:

    # nor "Gracias, mi amor."
    nor "Thank you, my love."

# game/scripts/c19/c19.rpy:2482
translate english c19s005_KateNorah_d5bd004d:

    # mc "Gracias, Kate. Soy un hombre con suerte."
    mc "Thank you, Kate. I'm a lucky man."

# game/scripts/c19/c19.rpy:2483
translate english c19s005_KateNorah_196f9628:

    # nor "Y ella también, [mc]. No lo olvides."
    nor "And so is she, [mc]. Don't forget that."

# game/scripts/c19/c19.rpy:2485
translate english c19s005_KateNorah_84bdcf3b:

    # kat "Aquí llega el hombre más desafortunado del mundo. *Risa* La única mujer que le escribe y es un número equivocado."
    kat "Here comes the unluckiest man in the world. *Laugh* The only woman who writes to him and it's a wrong number."

# game/scripts/c19/c19.rpy:2486
translate english c19s005_KateNorah_10c75dbb:

    # mc "No sabemos si escribía una mujer o un hombre. *Risa*"
    mc "We don't know whether it was a woman or a man writing. *Laugh*"

# game/scripts/c19/c19.rpy:2487
translate english c19s005_KateNorah_53ec85ae:

    # nor "En eso tienes razón, pero todas hemos pensado que era una chica."
    nor "You're right about that, but we all thought it was a girl."

# game/scripts/c19/c19.rpy:2489
translate english c19s005_KateNorah_301b109c:

    # kat "Desde La Revelación te he visto hablar con Tía Betty, Amanda, Olivia, y Kiara."
    kat "Since The Reveal I've seen you talking to Aunt Betty, Amanda, Olivia, and Kiara."

# game/scripts/c19/c19.rpy:2491
translate english c19s005_KateNorah_716518ff:

    # kat "Ninguna está en tu harén..."
    kat "None of them are in your harem..."

# game/scripts/c19/c19.rpy:2493
translate english c19s005_KateNorah_d0ffcda4:

    # kat "Supongo que te han ametrallado a preguntas, con lo que no lo voy a hacer yo."
    kat "I guess you've been strafed with questions, so I'm not going to do it myself."

# game/scripts/c19/c19.rpy:2495
translate english c19s005_KateNorah_1147508f:

    # kat "Supongo que lo de Meemaw se ha convertido en la comidilla del día."
    kat "I guess that Meemaw's situation has become the talk of the day."

# game/scripts/c19/c19.rpy:2496
translate english c19s005_KateNorah_50e84a49:

    # mc "El tema de conversación ha salido, pero hemos hablado de otros temas que teníamos pendientes. No todo gira alrededor de La Revelación."
    mc "The topic of conversation has come up, but we talked about other issues we had pending. Not everything revolves around The Reveal."

# game/scripts/c19/c19.rpy:2498
translate english c19s005_KateNorah_e129b40a:

    # nor "Son estas cosas por las que no se deberían soltar noticias bomba en una fiesta familiar. Absorven las conversaciones."
    nor "It's these things why you shouldn't drop bombshell news at a family party. They suck up conversations."

# game/scripts/c19/c19.rpy:2499
translate english c19s005_KateNorah_cc688986:

    # mc "Por otro lado, es el mejor momento. Ahora ya lo sabe todo el mundo."
    mc "On the other hand, it's the best time. Now everybody knows about it."

# game/scripts/c19/c19.rpy:2501
translate english c19s005_KateNorah_ccb9c144:

    # mc "Pero cambiemos de tema y volvamos a la fiesta. ¿Qué tal tu primera experiencia con una fiesta con toda la familia?"
    mc "But let's change the topic and get back to the party. How was your first experience of a party with the whole family?"

# game/scripts/c19/c19.rpy:2502
translate english c19s005_KateNorah_70c9a0e6:

    # kat "Te recuerdo que estuve en la playa en Navidad. *Risa*"
    kat "I remind you that I was at the beach for Christmas. *Laugh*"

# game/scripts/c19/c19.rpy:2503
translate english c19s005_KateNorah_c98ca203:

    # mc "*Risa* Lo sé, pero ahora la familia ha crecido. Al menos hasta que lleguen las chichas nuevas, creo que no van a aparecer nuevos miembros."
    mc "*Laugh* I know, but now the family has grown. At least until the new girls arrive, I don't think any new members are going to show up."

# game/scripts/c19/c19.rpy:2505
translate english c19s005_KateNorah_201b9f35:

    # kat "En eso tienes razón. Megan, Amanda, Eva... No estuvieron en la playa, pero son parte de esto."
    kat "You're right about that. Megan, Amanda, Eva... They weren't on the beach, but they're part of this."

# game/scripts/c19/c19.rpy:2507
translate english c19s005_KateNorah_7c8a4812:

    # kat "Y Maddie supongo que también, saliendo contigo... pero se la ve cohibida aún."
    kat "And Maddie I guess too, dating you... but she still looks a bit shy."

# game/scripts/c19/c19.rpy:2509
translate english c19s005_KateNorah_c404829b:

    # kat "Y creo que Maddie también podría unirse si le damos la oportunidad. Es muy buena chica."
    kat "And I think Maddie could join too if we give her the chance. She's a very nice girl."

# game/scripts/c19/c19.rpy:2511
translate english c19s005_KateNorah_2ef2993a:

    # nor "No la conocía mucho, más allá de comprarle ropa, pero es una chica muy agradable."
    nor "I didn't know her very well, beyond buying clothes from her, but she's a really lovely girl."

# game/scripts/c19/c19.rpy:2512
translate english c19s005_KateNorah_69e25ce6:

    # mc "Lo es. Y creo que se está integrando bien hoy. Al menos para ser su primera vez."
    mc " She is. And I think she's integrating nicely today. At least for her first time around."

# game/scripts/c19/c19.rpy:2514
translate english c19s005_KateNorah_14313d0e:

    # kat "Cambiando de tema, cuando te vayas a Aruba, ¿quién se ocupará de lo que haces tú en el Dormitorio?"
    kat "Changing the subject, when you go to Aruba, who will take care of what you do in the Dorm?"

# game/scripts/c19/c19.rpy:2515
translate english c19s005_KateNorah_7289dceb:

    # kat "Creo que entre todas podríamos ayudar para que [mar] y [nor] no tengan demasiado trabajo."
    kat "I think that, between all of us, we could help so that [mar] and [nor] don't have too much work."

# game/scripts/c19/c19.rpy:2516
translate english c19s005_KateNorah_d0a890d9:

    # mc "No te preocupes. La contabilidad la puedo seguir haciendo desde allí. No lleva mucho tiempo."
    mc "Don't worry. I can keep the bookkeeping going from there. It doesn't take a lot of time."

# game/scripts/c19/c19.rpy:2518
translate english c19s005_KateNorah_b5cc84c6:

    # mc "Ahora mismo es mi trabajo principal. Bueno, y hacer de taxista. *Risa*"
    mc "Right now, it's my main job. Well, and playing cab driver. *Laugh*"

# game/scripts/c19/c19.rpy:2520
translate english c19s005_KateNorah_6b3d961f:

    # kat "¿Puedo preguntar cómo empezásteis a salir juntos? ¿Y cómo habéis conseguido ocultarlo?"
    kat "May I ask how you started dating? And how did you manage to hide it?"

# game/scripts/c19/c19.rpy:2521
translate english c19s005_KateNorah_6794e850:

    # kat "Si me hubieran dicho que salías con una de las chicas Marks, seguramente [nor] hubiera sido mi última elección."
    kat "If I had been told you were dating one of the Marks girls, surely [nor] would have been my last choice."

# game/scripts/c19/c19.rpy:2522
translate english c19s005_KateNorah_1c1f2c26:

