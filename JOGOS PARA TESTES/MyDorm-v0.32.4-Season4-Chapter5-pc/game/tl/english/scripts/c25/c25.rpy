    # lis "¿Entonces dónde es un buen sitio para ir a comer con él? Yo soy vegana y..."
    lis "So, where's a good place to take him out to eat? I'm a vegan and.."

# game/scripts/c25/c25.rpy:2666
translate english c25s004_KimDebLisaSai_3fa729f3:

    # kat "¿Entonces dónde lo llevaríais? No es que yo vaya a ir a cenar con él, pero..."
    kat "So, where would you take him? It's not like I'm going to go out to dinner with him, but..."

# game/scripts/c25/c25.rpy:2667
translate english c25s004_KimDebLisaSai_b83b6ea0:

    # mcp "([sai] y [eil] hablando de mí. Será mejor que no me oigan.)"
    mcp "([sai] and [eil] talking about me. It'd be better if they'd didn't hear me.)"

# game/scripts/c25/c25.rpy:2669
translate english c25s004_KimDebLisaSai_19450c90:

    # mcp "(Desde aquí sólo puedo ver a [kat].)"
    mcp "(From here, I can only see [kat].)"

# game/scripts/c25/c25.rpy:2683
translate english c25s004_KimDebLisaSai_b767da69:

    # "Haces un poco de ruido en la escalera, forzando las pisadas en los escalones."
    "You make a little noise on the stairs, forcing your footsteps on the risers."

# game/scripts/c25/c25.rpy:2684
translate english c25s004_KimDebLisaSai_e9ed4afb:

    # mc "Hola, [kat]."
    mc "Hey, [kat]."

# game/scripts/c25/c25.rpy:2686
translate english c25s004_KimDebLisaSai_6ee89dd5:

    # kat "*Jadeo* ¿Qué? ¡Oh, hola [mc]!"
    kat "*Gasp* What? Oh, hi [mc]!"

# game/scripts/c25/c25.rpy:2687
translate english c25s004_KimDebLisaSai_d2e03d80:

    # "Oyes ruido de gente moviéndose."
    "You hear the noise of people moving around."

# game/scripts/c25/c25.rpy:2688
translate english c25s004_KimDebLisaSai_b4e0fc81:

    # mc "¿Qué tal, [kat]? ¿Estás sola?"
    mc "How's it going, [kat]? Are you alone?"

# game/scripts/c25/c25.rpy:2690
translate english c25s004_KimDebLisaSai_6e734612:

    # "*Blam*"
    "*Blam*"

# game/scripts/c25/c25.rpy:2691
translate english c25s004_KimDebLisaSai_c535d765:

    # "Oyes cerrarse la habitación de [sai]."
    "You hear [sai]'s bedroom door closing."

# game/scripts/c25/c25.rpy:2693
translate english c25s004_KimDebLisaSai_e4a8b87d:

    # kat "No, estoy con [eil]. Estábamos charlando."
    kat "No, I'm with [eil]. We were just chatting."

# game/scripts/c25/c25.rpy:2694
translate english c25s004_KimDebLisaSai_12067155:

    # mc "Ah, okay. No os molesto. Iba de camino a mi habitación."
    mc "Ah, okay. I won't bother you. I was on my way to my room."

# game/scripts/c25/c25.rpy:2696
translate english c25s004_KimDebLisaSai_8810d176:

    # "Subes hasta el rellano."
    "You go up to the landing."

# game/scripts/c25/c25.rpy:2697
translate english c25s004_KimDebLisaSai_6a00cd21:

    # mc "Hola, [eil]. ¿No trabajas hoy?"
    mc "Hello, [eil]. Not working today?"

# game/scripts/c25/c25.rpy:2698
translate english c25s004_KimDebLisaSai_67dc9595:

    # eil "Esta tarde. [eri] y yo entramos tarde hoy."
    eil "This afternoon. [eri] and I are going in late today."

# game/scripts/c25/c25.rpy:2699
translate english c25s004_KimDebLisaSai_46ff96f9:

    # mcp "(Conozco esa sonrisa. Ella sabe que yo sé que oculta algo.)"
    mcp "(I know that smile. She knows that I know she's hiding something.)"

# game/scripts/c25/c25.rpy:2700
translate english c25s004_KimDebLisaSai_eac49f44:

    # mc "Okay. Decídmelo si necesitáis que os lleve. Estaré en mi habitación trabajando un poco hasta la hora de comer."
    mc "Okay. Let me know if you need a ride. I'll be in my room working a bit until lunchtime."

# game/scripts/c25/c25.rpy:2702
translate english c25s004_KimDebLisaSai_e1f59b84:

    # mc "Os veo luego, chicas."
    mc "See you later, girls."

# game/scripts/c25/c25.rpy:2703
translate english c25s004_KimDebLisaSai_6ad62d0c:

    # kat "Hasta luego, [mc]." (multiple=2)
    kat "See you later, [mc]." (multiple=2)

# game/scripts/c25/c25.rpy:2704
translate english c25s004_KimDebLisaSai_a9c1d0ed:

    # eil "Hasta luego, [mc]." (multiple=2)
    eil "See you later, [mc]." (multiple=2)

# game/scripts/c25/c25.rpy:2706
translate english c25s004_KimDebLisaSai_2fdb8487:

    # "Abres la puerta de tu habitación para dejar el móvil antes de ir al lavabo."
    "You open your bedroom door to put your cell phone down before going to the bathroom."

# game/scripts/c25/c25.rpy:2707
translate english c25s004_KimDebLisaSai_8fbaa740:

    # "En el momento en que cierras tu puerta, oyes cómo se abre la de [sai]."
    "The moment you close your door, you hear [sai]'s door open."

# game/scripts/c25/c25.rpy:2708
translate english c25s004_KimDebLisaSai_5a4dd715:

    # sai "[kat], te tenías que ocupar de vigilar que no viniera nadie. Y menos aún [mc]."
    sai "[kat], you were supposed to keep an eye out, so no one could interrupt us. And even less so [mc]."

# game/scripts/c25/c25.rpy:2709
translate english c25s004_KimDebLisaSai_767591b8:

    # kat "Lo siento. La conversación estaba interesante y no lo he oído llegar."
    kat "I'm sorry. The conversation was interesting, and I didn't hear him coming."

# game/scripts/c25/c25.rpy:2710
translate english c25s004_KimDebLisaSai_359ef0e4:

    # deb "A mí me ha pasado lo mismo. Estaba tan atenta a lo que decíais que no lo he oído llegar."
    deb "The same thing happened to me. I was so focused on what you were saying that I didn't hear him coming."

# game/scripts/c25/c25.rpy:2712
translate english c25s004_KimDebLisaSai_143d600b:

    # deb "Y eso teniendo en cuenta que dudo que alguna vez vaya a cenar a solas con él."
    deb "And that's taking into account that I doubt I'll ever go out to dinner alone with him."

# game/scripts/c25/c25.rpy:2713
translate english c25s004_KimDebLisaSai_5a72e6b1:

    # lis "Estoy en la misma situación que [deb.nick]."
    lis "I'm in the same boat as [deb.nick]."

# game/scripts/c25/c25.rpy:2715
translate english c25s004_KimDebLisaSai_3882306f:

    # lis "Y eso teniendo en cuenta que dudo que alguna vez vaya a cenar a solas con él."
    lis "And that's considering that I doubt I'll ever go out to dinner alone with him."

# game/scripts/c25/c25.rpy:2716
translate english c25s004_KimDebLisaSai_3fce954d:

    # kim "Es que lo explicáis de tal forma que es casi como estar ahí, en vuestras citas."
    kim "You explain it in such a way that it's almost like being there, on your dates."

# game/scripts/c25/c25.rpy:2718
translate english c25s004_KimDebLisaSai_256bcef7:

    # kim "Aunque dudo que me vayan a servir de mucho esos conocimientos."
    kim "Although I doubt that knowledge will be of much use to me."

# game/scripts/c25/c25.rpy:2719
translate english c25s004_KimDebLisaSai_f3e4baaa:

    # eil "Chicas, no sé si nos ha oído, pero sabe que estaba pasando algo. Se lo he leído en la cara."
    eil "Girls, I don't know if he heard us, but he knows something was going on. I could see it on his face."

# game/scripts/c25/c25.rpy:2721
translate english c25s004_KimDebLisaSai_daa8d239:

    # mcp "(Será mejor que continúe con lo que iba a hacer. Si no las he querido escuchar antes, mejor será no hacerlo ahora.)"
    mcp "(It would be best to continue with what I was doing. If I didn't want to eavesdrop on them earlier, it would be better not to do so now.)"

# game/scripts/c25/c25.rpy:2723
translate english c25s004_KimDebLisaSai_a446b3de:

    # kat "Bueno, ya se ha ido. Ibas a hablar del columpio, [eil]."
    kat "Well, he's gone now. You were going to talk about the swing, [eil]."

# game/scripts/c25/c25.rpy:2724
translate english c25s004_KimDebLisaSai_a1fc8034:

    # mcp "(Será mejor que continúe con lo que iba a hacer. Si van a empezar a hablar de [eil] y de mí en el columpio...)"
    mcp "(I'd better get back to what I was doing. If they start talking about [eil] and me on the swing...)"

# game/scripts/c25/c25.rpy:2726
translate english c25s004_KimDebLisaSai_9bf43002:

    # "Vas al lavabo y trabajas durante una hora, hasta que empieza a entrarte sed. Sigues sin acordarte de coger una botella de agua."
    "You go to the bathroom and then work for an hour, until you start to feel thirsty. You still don't remember to grab a bottle of water when you come upstairs."

# game/scripts/c25/c25.rpy:2727
translate english c25s004_KimDebLisaSai_0e4aee02:

    # "Bajas a la cocina a beber algo."
    "You go down to the kitchen to get something to drink."

# game/scripts/c25/c25.rpy:2731
translate english c25s004_Listen_e330979f:

    # "Por sus voces las puedes imaginar sentadas en el suelo, alrededor de las dos maestras."
    "From their voices, you can imagine them sitting on the floor, surrounding the two teachers."

# game/scripts/c25/c25.rpy:2732
translate english c25s004_Listen_3d3682ee:

    # "Casi se te escapa la risa y delatas tu presencia."
    "You almost let out a laugh and gave away your location."

# game/scripts/c25/c25.rpy:2734
translate english c25s004_Listen_4ebdddd8:

    # kim "¿Dónde lo llevaste a cenar en tu primera cita, [sai]?"
    kim "Where did you take him for dinner on your first date, [sai]?"

# game/scripts/c25/c25.rpy:2736
translate english c25s004_Listen_1e00e275:

    # sai "Bueno, fue él quien me llevó a comer a mí, no a cenar. Fue en un restaurante escandinavo. Pero no fue la primera cita. Esa había sido en la cafetería de la que os he hablado."
    sai "Well, he was the one who took me out to lunch, not dinner. It was at a Scandinavian restaurant. But it wasn't our first date. That was at the café I told you about."

# game/scripts/c25/c25.rpy:2737
translate english c25s004_Listen_41f2ece9:

    # sai "Por si os interesa, pidió albóndigas suecas y smorrebrod, o como se diga."
    sai "In case you're interested, he ordered Swedish meatballs and smorrebrod, or whatever it's called."

# game/scripts/c25/c25.rpy:2739
translate english c25s004_Listen_1ec9791d:

    # eil "*Risa* Me lo imaginaba. Lo que me hubiera sorprendido es que hubiese pedido arenque."
    eil "*Laugh* I figured as much. What would have surprised me is if he had ordered herring."

# game/scripts/c25/c25.rpy:2741
translate english c25s004_Listen_26125ae6:

    # deb "¿Y tú, [eil]? ¿Cómo fue vuestra primera cita?"
    deb "And you, [eil]? How was your first date?"

# game/scripts/c25/c25.rpy:2743
translate english c25s004_Listen_da3bec1c:

    # eil "Te va a parecer gracioso, pero nunca tuvimos una 'primera cita'. Nos veíamos todos los días en el instituto, la cosa entre nosotros surgió poco a poco."
    eil "You're going to find this funny, but we never really had a 'first date'. We saw each other every day at school, and things just happened naturally."

# game/scripts/c25/c25.rpy:2744
translate english c25s004_Listen_bc26e0c0:

    # eil "Para cuando nos dimos cuenta, estábamos saliendo y no habíamos tenido una cita. La mayoría de las veces comíamos con Jamaal. Imaginaos qué romántico era todo. *Risa*"
    eil "By the time we realized it, we were dating, but hadn't been on an actual date. Most of the time we had lunch with Jamaal. Imagine how romantic that was. *Laugh*"

# game/scripts/c25/c25.rpy:2747
translate english c25s004_Listen_92ed8ad3:

    # lis "A mí me gustaría tener una primera cita. Sería algo que recordar siempre y... no sé... como una fecha para nuestro aniversario de salir juntos."
    lis "I would like to go on a first date. It should be something to remember forever and... I don't know... like a special date for our anniversary of dating."

# game/scripts/c25/c25.rpy:2749
translate english c25s004_Listen_ce44d423:

    # lis "Cuando salga con alguien, me gustaría tener una primera cita. Sería algo que recordar siempre y como una fecha para nuestro aniversario de salir juntos."
    lis "When I start dating someone, I would like to go on a first date. It should be something to remember forever and a special date to celebrate our anniversary."

# game/scripts/c25/c25.rpy:2750
translate english c25s004_Listen_283ad907:

    # lis "*Risita* Al menos hasta que pueda sustituírlo por el aniversario de boda."
    lis "*Giggle* At least until I can replace it with our wedding anniversary."

# game/scripts/c25/c25.rpy:2753
translate english c25s004_Listen_8aa32af2:

    # deb "No digas tonterías, [lis]. Tienes marcado en tu diario el día que te besó por primera vez, cuando os encerré en nuestra habitación."
    deb "Don't be silly, [lis]. You marked the day he kissed you for the first time in your diary. When I locked you in our room."

# game/scripts/c25/c25.rpy:2754
translate english c25s004_Listen_afa4cd12:

    # deb "Creo que, cuando se cumpla un año de ese beso, lo celebrarás más que cuando se cumpla un año de vuestra futura primera cita."
    deb "I think that, when a year has passed since that kiss, you'll celebrate it more than when a year has passed since your first date."

# game/scripts/c25/c25.rpy:2756
translate english c25s004_Listen_64db342a:

    # deb "No digas tonterías, [lis]. Si te hubiera besado cuando os encerré en nuestra habitación, tendrías ese día marcado en tu diario."
    deb "Don't be silly, [lis]. If he had kissed you when I locked you in our room, you would have marked that day in your diary."

# game/scripts/c25/c25.rpy:2757
translate english c25s004_Listen_7eb04199:

    # deb "Creo que, cuando se cumpla un año de tu primer beso cuando salgas con alguien, lo celebrarás más que cuando se cumpla un año de vuestra futura primera cita."
    deb "I think that when it's been a year since your first kiss with someone you're dating, you'll celebrate it more than when it's been a year since your first date."

# game/scripts/c25/c25.rpy:2759
translate english c25s004_Listen_77282ea8:

    # deb "A mí me gustaría celebrar como nuestro aniversario el día que nos besamos en el lago por primera vez."
    deb "I would like to celebrate the day we kissed at the lake for the first time as our anniversary."

# game/scripts/c25/c25.rpy:2761
translate english c25s004_Listen_7d823dbe:

    # kat "Pero eso es porque tú y [kim] sois unas románticas. *Risa* La mayoría de la gente celebra la boda."
    kat "But that's because you and [kim] are hopeless romantics. *Laugh* Most people celebrate their wedding anniversary."

# game/scripts/c25/c25.rpy:2762
translate english c25s004_Listen_261a1a24:

    # kat "Pero la pregunta importante es... ¿Lees el diario de tu hermana, [deb.nick]?"
    kat "But the important question is... Do you read your sister's diary, [deb.nick]?"

# game/scripts/c25/c25.rpy:2764
translate english c25s004_Listen_60629825:

    # sai "Chicas, guardad vuestros diarios bajo llave. *Risa* Tenemos una espía."
    sai "Girls, keep your diaries locked up. *Laugh* We have a spy."

# game/scripts/c25/c25.rpy:2765
translate english c25s004_Listen_2f6e62de:

    # mcp "(*Risa mental* Sí, pero no tiene que ver con los diarios.)"
    mcp "(*Mental laughter* Yes, but it has nothing to do with diaries.)"

# game/scripts/c25/c25.rpy:2767
translate english c25s004_Listen_9f506759:

    # lis "*Risa* Siempre se lo he dejado leer. Es un diario online y tiene permiso para leerlo... al menos tiene permisos para ver algunas entradas."
    lis "*Laugh* I've always let her read it. It's an online diary and she has my permission to read it... at least she has access to some of the entries."

# game/scripts/c25/c25.rpy:2768
translate english c25s004_Listen_a958c3d2:

    # lis "Nos ha ido muy bien algunas veces. Ya sabéis que a veces me pongo muy estúpida sin venir a cuento."
    lis "It's worked out really well for us sometimes. You know how I can sometimes act really stupid for no reason."

# game/scripts/c25/c25.rpy:2769
translate english c25s004_Listen_0e536994:

    # todas "*Risa* Sí."
    todas "*Laugh* Yes."

# game/scripts/c25/c25.rpy:2771
translate english c25s004_Listen_7dcc2caf:

    # kim "*Risa* Somos unas malas amigas... Tendríamos que haberle dicho, 'No, [lis], siempre que te pones estúpida es por una razón justificada.'"
    kim "*Laugh* We're bad friends... We should have said, 'No, [lis], whenever you act stupid, it's for a good reason.'"

# game/scripts/c25/c25.rpy:2772
translate english c25s004_Listen_3e51f1da:

    # kim "*Risa* Pero mentir también es de malas amigas... Estoy en una encrucijada."
    kim "*Laugh* But lying is also wrong between friends. I'm caught between a rock and a hard place."

# game/scripts/c25/c25.rpy:2773
translate english c25s004_Listen_b3b94564:

    # todas "*Risa*"
    todas "*Laugh*"

# game/scripts/c25/c25.rpy:2775
translate english c25s004_Listen_23de23e2:

    # lis "*Risa* Te robaré el pintalabios como venganza por lo que acabas de decir."
    lis "*Laugh* I'm going to steal your lipstick as revenge for what you just said."

# game/scripts/c25/c25.rpy:2776
translate english c25s004_Listen_63251888:

    # lis "Es broma. Me encanta que me digáis lo que hago mal. Hasta ahora sólo se atrevía [deb.nick]."
    lis "Just kidding. I love it when you tell me what I'm doing wrong. Until now, only [deb.nick] dared to do so."

# game/scripts/c25/c25.rpy:2778
translate english c25s004_Listen_f25147f6:

    # kat "Chicas, nos estamos desviando del tema. Estábamos hablando de [mc]."
    kat "Girls, we're getting off topic. We were talking about [mc]."

# game/scripts/c25/c25.rpy:2779
translate english c25s004_Listen_972239aa:

    # kat "[eil], la última vez estabas diciendo algo de un columpio."
    kat "[eil], last time you were mentioning something about a swing."

# game/scripts/c25/c25.rpy:2781
translate english c25s004_Listen_6c13d4f7:

    # eil "Bueno, ha habido varias veces en un columpio, pero..."
    eil "Well, there have been a few times on a swing, but..."

# game/scripts/c25/c25.rpy:2782
translate english c25s004_Listen_1e77ac63:

    # mcp "(Creo que es el momento de hacerme notar. Si empiezan a hablar de sexo y me descubren escuchando se van a enfadar.)"
    mcp "(I think it's time to announce myself. If they start talking about sex and they find out I'm listening, they're going to get angry.)"

# game/scripts/c25/c25.rpy:2783
translate english c25s004_Listen_1fa64ca7:

    # mcp "(Especialmente si hablan de sexo conmigo.)"
    mcp "(Especially if they talk about sex with me.)"

# game/scripts/c25/c25.rpy:2842
translate english c25s004_MarPickles_edd270a7:

    # "Llegas a la cocina y ves a [mar] con la cabeza metida en la nevera."
    "You walk into the kitchen and see [mar] with her head stuck in the fridge."

# game/scripts/c25/c25.rpy:2843
translate english c25s004_MarPickles_956ec74f:

    # mc "¿Estás preparando la comida?"
    mc "Are you preparing lunch?"

# game/scripts/c25/c25.rpy:2846
translate english c25s004_MarPickles_71094ac0:

    # mom "No, aún no. Me han apetecido pepinillos con helado de chocolate, pero no nos quedan pepinillos."
    mom "No, not yet. I felt like having pickles with chocolate ice cream, but we don't have any pickles left."

# game/scripts/c25/c25.rpy:2847
translate english c25s004_MarPickles_84f35fa2:

    # mc "¡Aargh! *Risa* ¡Eso tiene que tener un gusto horrendo! No te he visto nunca comer algo así."
    mc "Aargh! *Laugh* That must taste awful! I never saw you eat anything like that before."

# game/scripts/c25/c25.rpy:2848
translate english c25s004_MarPickles_7613b351:

    # mc "¿Es posible que sea un antojo del embarazo?"
    mc "Could it be a pregnancy craving?"

# game/scripts/c25/c25.rpy:2851
translate english c25s004_MarPickles_7c51ff83:

    # mom "No lo creo. No tuve antojos cuando estuve embarazada de ti ni de [emm]. Siempre he pensado que los antojos son una tontería para explotar a los pobres padres."
    mom "I don't think so. I didn't have any cravings when I was pregnant with you or [emm]. I've always thought cravings were a silly way to manipulate poor dads to be."

# game/scripts/c25/c25.rpy:2853
translate english c25s004_MarPickles_28435bd9:

    # mom "No lo creo. Siempre he pensado que los antojos son una tontería para explotar a los pobres padres."
    mom "I don't think so. I always thought cravings were a silly way to manipulate poor dads to be."

# game/scripts/c25/c25.rpy:2854
translate english c25s004_MarPickles_14bc9b06:

    # mom "Pero es posible... ahora que lo dices, suena asqueroso."
    mom "But it's possible... now that you mention it, it sounds disgusting."

# game/scripts/c25/c25.rpy:2855
translate english c25s004_MarPickles_139ace68:

    # mc "¿Quieres que vaya a comprar pepinillos?"
    mc "Would you like me to go buy some pickles?"

# game/scripts/c25/c25.rpy:2857
translate english c25s004_MarPickles_59520599:

    # mom "Si no te importa... Pese a que suena asqueroso, me siguen apeteciendo."
    mom "If you don't mind... Even though it sounds disgusting, I still want them."

# game/scripts/c25/c25.rpy:2858
translate english c25s004_MarPickles_3a59328e:

    # mc "No te preocupes, ahora voy a comprarlos."
    mc "Don't worry, I'll go buy them now."

# game/scripts/c25/c25.rpy:2860
translate english c25s004_MarPickles_f88ea23f:

    # mom "Estaba empezando a prepararla, pero no hay suficiente pollo."
