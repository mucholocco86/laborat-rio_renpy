    # zeu "¿Miau? ¡Miau! (¿Pequeñajo? ¡Para ti, es Lord Simba!)"
    zeu "*Meow?* *Meow!* (Little one? For you, it's Lord Simba!)"

# game/scripts/c25/c25.rpy:3164
translate english c25s004_GetMad_73bdd14d:

    # zeu "Miau *Purr* (Pero si me rascas así, puedes llamarme como quieras.)"
    zeu "*Meow* *Purr* (But if you scratch me like that, you can call me whatever you want.)"

# game/scripts/c25/c25.rpy:3166
translate english c25s004_GetMad_e0122449:

    # mad "Me encanta ver lo bien que se lleva contigo. *Risa* Más aún teniendo en cuenta que no le traes comida."
    mad "I love seeing how well he gets along with you. *Laugh* Even more so considering you don't bring him food."

# game/scripts/c25/c25.rpy:3167
