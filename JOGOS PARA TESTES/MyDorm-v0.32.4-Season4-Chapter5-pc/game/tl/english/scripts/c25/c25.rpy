# game/scripts/c25/c25.rpy:1447
translate english c25s002_KimRoute_1f5fafdf:

    # mc "*Risa* He tenido suerte. No querría ser el protagonista del titular 'Pierde un ojo por culpa de una chocolatina'."
    mc "*Laugh* I was lucky then. I wouldn't want to be in a headline saying 'Man loses an eye after being hit by a chocolate.'"

