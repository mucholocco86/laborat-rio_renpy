    mc "If I only had to see the bright side of things, I could never take my eyes off the way your eyes sparkle right now."

# game/scripts/c25/c25.rpy:1460
translate english c25s002_KimRoute_59d67c2c:

    # kim "Es lo más bonito que me han dicho nunca, [mc]."
    kim "That's the nicest thing anyone has ever said to me, [mc]."

# game/scripts/c25/c25.rpy:1462
translate english c25s002_KimRoute_71648375:

    # mc "Este trozo en tu muslo me recuerda a un mapa medieval de Irlanda que vi una vez."
    mc "This shape on your thigh reminds me of a medieval map of Ireland I once saw."

# game/scripts/c25/c25.rpy:1463
