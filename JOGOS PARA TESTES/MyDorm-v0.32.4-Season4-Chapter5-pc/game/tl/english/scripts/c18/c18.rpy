# game/scripts/c18/c18.rpy:2816
translate english c18s005_BirthdayOne_38c4b1bc:

    # mcp "(¿Perfecto saber si está embarazada o perfecto tener el resultado antes de las 120 horas?)"
    mcp "(Perfect to know if you are pregnant or perfect to have the result before the 120 hours?)"

# game/scripts/c18/c18.rpy:2817
translate english c18s005_BirthdayOne_9c1607e9:

    # mc "¿Nos vamos entonces?"
    mc "Shall we go then?"

# game/scripts/c18/c18.rpy:2818
translate english c18s005_BirthdayOne_a47a73e8:

    # mad "Cuando quieras."
    mad "Whenever you want."

# game/scripts/c18/c18.rpy:2821
translate english c18s005_BirthdayOne_504931a2:

    # "Maddie está silenciosa durante todo el trayecto, hasta que al final hace una pregunta que no esperabas, sin atreverse a mirarte."
    "Maddie is silent for the whole ride, until, at the end, she asks a question you weren't expecting, not daring to look at you."

# game/scripts/c18/c18.rpy:2822
translate english c18s005_BirthdayOne_cd9d2088:

    # mad "Si sale positivo... ¿quieres que me tome la píldora del día después?"
    mad "If it comes out positive... do you want me to take the morning after pill?"

# game/scripts/c18/c18.rpy:2823
translate english c18s005_BirthdayOne_6be55c78:

    # mc "Es algo que tienes que decidir tú, Maddie."
    mc "That's for you to decide, Maddie."

# game/scripts/c18/c18.rpy:2824
translate english c18s005_BirthdayOne_2a66c432:

    # mc "Si estabas tomando la píldora, supongo que no querías quedarte embarazada."
    mc "If you were on the pill, I guess you didn't want to get pregnant."

# game/scripts/c18/c18.rpy:2826
translate english c18s005_BirthdayOne_4cc00931:

    # mad "Habíamos estado juntos sólo una vez..."
    mad "We had only been together once..."

# game/scripts/c18/c18.rpy:2828
translate english c18s005_BirthdayOne_72ce68d1:

    # mad "Aparte del día en el probador."
    mad "Besides the day in the fitting room."

# game/scripts/c18/c18.rpy:2829
translate english c18s005_BirthdayOne_c39b627c:

    # mad "No quería quedarme embarazada."
    mad "I didn't want to get pregnant."

# game/scripts/c18/c18.rpy:2831
translate english c18s005_BirthdayOne_7b1ecf43:

    # mc "A mí tampoco me gustaría que te quedaras embarazada. No con el tipo de relación que tenemos."
    mc "I wouldn't want you to get pregnant either. Not with the kind of relationship we have."

# game/scripts/c18/c18.rpy:2845
translate english c18s005_BirthdayOne_647f0e29:

    # mc "Pero ya te digo que es una decisión que debes tomar tú. Y me gustaría que lo habláramos si se da el caso."
    mc "But I'm telling you, you should make that decision. And I'd like to talk it over if it comes up."

# game/scripts/c18/c18.rpy:2848
translate english c18s005_BirthdayOne_233aabe1:

    # mad "Lo entiendo. Es demasiado pronto en la relación..."
    mad "I understand. It's too early in the relationship..."

# game/scripts/c18/c18.rpy:2849
translate english c18s005_BirthdayOne_203490d0:

    # mc "No es sólo eso. No querías quedarte embarazada por alguna razón y decidiste tomar la píldora."
    mc "It's not just that. You didn't want to get pregnant for some reason and decided to go on the pill."

# game/scripts/c18/c18.rpy:2850
translate english c18s005_BirthdayOne_e7640f75:

    # mc "No creo que sólo por habernos acostado tenga que cambiar nada."
    mc "I don't think just because we slept together you have to change something like that."

# game/scripts/c18/c18.rpy:2852
translate english c18s005_BirthdayOne_972fc1d4:

    # mad "Lo entiendo. Tampoco es el tipo de relación que querría tener con el padre de mis hijos."
    mad "I understand. It's also not the kind of relationship I would want to have with the father of my children."

# game/scripts/c18/c18.rpy:2853
translate english c18s005_BirthdayOne_b244384b:

    # mc "Entonces no hay mucho más que hablar."
    mc "Then there's not much more to talk about."

# game/scripts/c18/c18.rpy:2855
translate english c18s005_BirthdayOne_356ea90c:

    # mad "Tienes razón..."
    mad "You are right..."

# game/scripts/c18/c18.rpy:2856
translate english c18s005_BirthdayOne_3a172439:

    # "Maddie se sume en un silencio incómodo hasta llegar a casa."
    "Maddie lapses into an uncomfortable silence until you get home."

# game/scripts/c18/c18.rpy:2858
translate english c18s005_BirthdayOne_f4535e48:

    # "Llegas a casa y metes el coche en el garaje."
    "You arrive home and put the car in the garage."

# game/scripts/c18/c18.rpy:2860
translate english c18s005_BirthdayOne_bf617c46:

    # "Al salir del garaje te encuentras con [nor] y [eri], que están llevando comida hacia la piscina."
    "As you leave the garage you meet [nor] and [eri], who are carrying drinks toward the pool."

# game/scripts/c18/c18.rpy:2861
translate english c18s005_BirthdayOne_f7c8156c:

    # nor "¿Ya habéis llegado? Bienvenida a casa, Maddie."
    nor "You're here! Welcome home, Maddie."

# game/scripts/c18/c18.rpy:2862
translate english c18s005_BirthdayOne_abb26421:

    # eri "Hola, Maddie. Hacía mucho que no nos veíamos."
    eri "Hi, Maddie. It's been a long time since we've seen each other."

# game/scripts/c18/c18.rpy:2863
translate english c18s005_BirthdayOne_548a10c0:

    # eri "[mc], ¿puedes ayudar a mi madre a llevar esto a la piscina?"
    eri "[mc], can you help my mother carry this to the pool?"

# game/scripts/c18/c18.rpy:2864
translate english c18s005_BirthdayOne_37097a7f:

    # mc "Sí, ningún problema."
    mc "Yes, no problem."

# game/scripts/c18/c18.rpy:2866
translate english c18s005_BirthdayOne_cbfa9667:

    # eri "Yo me llevo a Maddie a mi habitación para que se cambie. ¿Vamos?"
    eri "I'm taking Maddie to my room so she can change. Shall we go?"

# game/scripts/c18/c18.rpy:2867
translate english c18s005_BirthdayOne_1fec026a:

    # mad "Yo he traído un bañador... de cuerpo entero..."
    mad "I've brought a swimsuit... full body..."

# game/scripts/c18/c18.rpy:2869
translate english c18s005_BirthdayOne_8052db9f:

    # eri "Si quieres llevarlo no hay ningún problema. Si quieres ir como mi madre o yo, te puedo prestar algo."
    eri "If you want to wear it there is no problem. If you want to go as my mother or me, I can lend you something."

# game/scripts/c18/c18.rpy:2870
translate english c18s005_BirthdayOne_476ddc1f:

    # mad "[mc], ¿puedes dejar los paquetes en la pick up? Ya los cogeré luego..."
    mad "[mc], can you leave the boxes in the pick up? I'll get them later..."

# game/scripts/c18/c18.rpy:2873
translate english c18s005_BirthdayOne_347ce1a9:

    # mc "Dame esa bandeja. Me prometiste no llevar peso."
    mc "Give me that tray. You promised me not to carry any weight."

# game/scripts/c18/c18.rpy:2874
translate english c18s005_BirthdayOne_cc39d83d:

    # nor "Es solo una bandeja de vasos de plastico, no pesa."
    nor "It's just a tray of plastic cups, it's not heavy."

# game/scripts/c18/c18.rpy:2875
translate english c18s005_BirthdayOne_6af48414:

    # mc "Da lo mismo. Yo tengo dos manos y puedo llevar las dos bandejas."
    mc "It doesn't matter. I have two hands and can carry both trays."

# game/scripts/c18/c18.rpy:2876
translate english c18s005_BirthdayOne_e98d1abb:

    # nor "Vaaaale..."
    nor "Okaaay..."

# game/scripts/c18/c18.rpy:2878
translate english c18s005_BirthdayOne_c4ed2934:

    # mc "Ya me imaginaba que vosotras dos haríais topless. [eri] porque lo pidió, y tú porque ella lo pidió por ti."
    mc "I figured you two would go topless. [eri] because she asked for it, and you because she asked because of you."

# game/scripts/c18/c18.rpy:2879
translate english c18s005_BirthdayOne_0d06c783:

    # nor "Lo sé. Ella no quería dejarme sola siendo la única que hace topless."
    nor "I know. She didn't want to leave me alone being the only one topless."

# game/scripts/c18/c18.rpy:2880
translate english c18s005_BirthdayOne_0e8412a9:

    # mc "¿Sólo sois vosotras dos?"
    mc "Is it just the two of you?"

# game/scripts/c18/c18.rpy:2882
translate english c18s005_BirthdayOne_ea11ff01:

    # nor "*Risa* Casi suenas decepcionado."
    nor "*Laugh* You almost sound disappointed."

# game/scripts/c18/c18.rpy:2883
translate english c18s005_BirthdayOne_0e3e9be1:

    # mc "No, no, creía que al menos una o dos más se iban a unir. ¿Nadie más se ha atrevido?"
    mc "No, no, I thought at least one or two more were going to join. No one else dared?"

# game/scripts/c18/c18.rpy:2885
translate english c18s005_BirthdayOne_412373d2:

    # nor "Eso lo descubrirás en breve."
    nor "You'll find that out soon enough."

