translate english c18s001_Dinner_f680e991:

    # kat "¡Eres muy exagerada! Tú apenas tienes. *Risa* Yo necesitaría la pantalla gigante del Acrisure Stadium."
    kat "You are exaggerating! You barely have any. *Laugh* I'd need the giant screen at Heins Stadium to fit mine."

# game/scripts/c18/c18.rpy:428
translate english c18s001_Dinner_4000027e:

    # mc "Nunca he conocido una mujer que no se queje de que le sobran un par de kilos. *Risa* O de que le falten."
    mc "I've never met a woman who didn't complain about having a couple of kilos to spare. *Laugh* Or that she needs those same two kilos."

# game/scripts/c18/c18.rpy:430
translate english c18s001_Dinner_be5770f7:

    # meg "Yo os tengo que dejar, tengo que acabar de aclarar unas cosas con el jefe antes de la actuación."
    meg "I have to leave you, I have to finish clearing up some things with the boss before the performance."

# game/scripts/c18/c18.rpy:431
translate english c18s001_Dinner_8b0d388f:

    # meg "Volveré entre actuaciones. Os veo luego."
    meg "I'll be back between performances. See you later."

# game/scripts/c18/c18.rpy:432
translate english c18s001_Dinner_da73a3e0:

    # todas "Hasta luego, Megan."
    todas "See you later, Megan."

# game/scripts/c18/c18.rpy:434
translate english c18s001_Dinner_82928684:

    # sca "Id pensando que queréis beber, ya me ocupo yo de tomar nota."
    sca "Think about what you want to drink, I'll take everyone's order."

# game/scripts/c18/c18.rpy:435
translate english c18s001_Dinner_05f3dd36:

    # "Scarlett toma nota en su móvil de las bebidas que quiere cada una y te da el móvil."
    "Scarlett makes a note on her cell phone of which drinks each of you wants and hands you the cell phone."

# game/scripts/c18/c18.rpy:437
translate english c18s001_Dinner_155a3fa5:

    # sca "Lisa y yo vamos al lavabo y te vemos en la barra. ¿Puedes ir pidiendo?"
    sca "Lisa and I are going to the restroom. We'll meet you at the bar. Can you go ahead and order?"

# game/scripts/c18/c18.rpy:438
translate english c18s001_Dinner_8e72b860:

    # lis "Viendo lo bonito que es el local tengo ganas de ver el lavabo. Este sitio tiene una imagen años 30 muy cuidada."
    lis "Seeing how nice the place is, I'm looking forward to seeing the restroom. This place has a very cool 1930's image."

# game/scripts/c18/c18.rpy:439
translate english c18s001_Dinner_47891da4:

    # mc "¿Vas a hacer turismo en el lavabo? *Risa*"
    mc "Are you going sightseeing in the restroom? *Laugh*"

# game/scripts/c18/c18.rpy:441
translate english c18s001_Dinner_f88b4eec:

    # lis "No solo turismo..."
    lis "Not only sightseeing..."

# game/scripts/c18/c18.rpy:442
translate english c18s001_Dinner_ad7f4de5:

    # sca "*Risa* Esas cosas no se le preguntan a una dama, [mc]. *Risa*"
    sca "You don't ask a lady those things, [mc]. *Laugh*"

# game/scripts/c18/c18.rpy:443
translate english c18s001_Dinner_e639c88f:

    # mc "*Risa* No tardéis o empezará a fundirse el hielo."
    mc "*Laugh* Don't be long or the ice will start to melt."

# game/scripts/c18/c18.rpy:445
translate english c18s001_Dinner_41d2ad96:

    # sca "No tardamos nada. No es que Lisa les vaya a dejar un regalito apestoso. *Risa*"
    sca "It won't take long. It's not like Lisa is going to leave them a stinky little present. *Laugh*"

# game/scripts/c18/c18.rpy:446
translate english c18s001_Dinner_ae703262:

    # lis "¡Scarlett! *Risa* Las señoritas no hacemos eso. Dejamos rosas y arcoíris. *Risa*"
    lis "Scarlett! *laugh* We ladies don't do that. We leave roses and rainbows. *Laugh*"

# game/scripts/c18/c18.rpy:447
translate english c18s001_Dinner_fc7f2961:

    # mc "Bueno, os espero en la barra. No voy a poder traer doce bebidas yo solo."
    mc "Well, I'll wait for you at the bar. I'm not going to be able to bring twelve drinks by myself."

# game/scripts/c18/c18.rpy:449
translate english c18s001_Dinner_2cd1b34c:

    # "En cuanto entras en la sala principal, te encuentras con una cara conocida."
    "As soon as you walk into the main room, you meet a familiar face."

# game/scripts/c18/c18.rpy:450
translate english c18s001_Dinner_5c865492:

    # mc "¿Dra. Milk?"
    mc "Dr. Milk?"

# game/scripts/c18/c18.rpy:452
translate english c18s001_Dinner_7c596da7:

    # hm "¡Oh, Sr. Marks! Puede llamarme Harley cuando no estoy en el hospital."
    hm "Oh, Mr. Marks! You can call me Harley when I'm not in the hospital."

# game/scripts/c18/c18.rpy:453
translate english c18s001_Dinner_20e77c57:

    # mc "Sólo si usted me llama [mc]."
    mc "Only if you call me [mc]."

# game/scripts/c18/c18.rpy:458
translate english c18s001_Dinner_382909a1:

    # har "De acuerdo, [mc]. ¿Qué tal los masajes con la Sra. Pitt?"
    har "Okay, [mc]. How did the massages with Mrs. Pitt go?"

# game/scripts/c18/c18.rpy:459
translate english c18s001_Dinner_66f69349:

    # mc "Bien, gracias. Hoy le he explicado a mi tía cómo hacerlos. Parece que han ido bien."
    mc " Fine, thank you. I explained to my aunt today how to do them. They seem to have gone well."

# game/scripts/c18/c18.rpy:460
translate english c18s001_Dinner_914e290b:

    # mc "Un segundo, por favor."
    mc "Just one second, please."

# game/scripts/c18/c18.rpy:462
translate english c18s001_Dinner_acf64506:

    # "Le entregas el móvil de Scarlett al camarero con la lista de las bebidas."
    "You hand Scarlett's cell phone with the drinks list to the bartender."

# game/scripts/c18/c18.rpy:463
translate english c18s001_Dinner_d5840e9d:

    # mc "¿Puede prepararme esto, por favor?"
    mc "Can you prepare this for me, please?"

# game/scripts/c18/c18.rpy:467
translate english c18s001_Dinner_c3fc428a:

    # bam "Sí, ahora mismo."
    bam "Yes, right away."

# game/scripts/c18/c18.rpy:469
translate english c18s001_Dinner_bc3f3dfe:

    # har "¿Ha venido solo?"
    har "Did you come alone?"

# game/scripts/c18/c18.rpy:470
translate english c18s001_Dinner_2d8ebafa:

    # mc "No, con parte de la familia. ¿Y usted?"
    mc "No, with part of the family. And you?"

# game/scripts/c18/c18.rpy:472
translate english c18s001_Dinner_2c50782e:

    # har "Tampoco. He venido con mi marido, Jeff, y mi herm... ano."
    har "Same. I've come with my husband, Jeff, and my si... bling."

# game/scripts/c18/c18.rpy:473
translate english c18s001_Dinner_a2a3934b:

    # mc "Ahora veo las tres bebidas. ¿Quiere que le ayude a llevárselas a la mesa mientras preparan mi pedido?"
    mc "I see the three drinks now. Do you need me to help you bring them to the table while the bartender prepares my order?"

# game/scripts/c18/c18.rpy:475
translate english c18s001_Dinner_8ee079a8:

    # har "No hace falta. Mi hermano ha ido al lavabo un momento y tiene que estar a punto de volver."
    har "No need. My brother has gone to the restroom and should be back shortly."

# game/scripts/c18/c18.rpy:476
translate english c18s001_Dinner_d7c52f77:

    # har "Oh, hablando del Rey de Roma, por ahí viene."
    har "Oh, speaking of the devil, here he comes."

# game/scripts/c18/c18.rpy:481
translate english c18s001_Dinner_979ef219:

    # har "[mc], te presento a mi hermano Anthony."
    har "[mc], meet my brother Anthony."

# game/scripts/c18/c18.rpy:482
translate english c18s001_Dinner_ae996fcb:

    # ant "Ya nos conocemos, Harley. Es el casero de Lisa, del que te hablé."
    ant "We've met before, Harley. He's Lisa's landlord, the one I told you about."

# game/scripts/c18/c18.rpy:483
translate english c18s001_Dinner_6cdb73dc:

    # mc "Hola Anthony, ¿qué tal?"
    mc "Hello, Anthony, how are you doing?"

# game/scripts/c18/c18.rpy:485
translate english c18s001_Dinner_c35965dd:

    # ant "Hola, [mc], ¿Ha venido Lisa contigo?"
    ant "Hello, [mc], did Lisa come with you?"

# game/scripts/c18/c18.rpy:486
translate english c18s001_Dinner_b90af8a9:

    # mc "Sí, ahora vendrá a ayudarme a llevar las copas."
    mc "Yes, she'll be here in a moment to help me carry the drinks."

# game/scripts/c18/c18.rpy:487
translate english c18s001_Dinner_fb962fee:

    # ant "Cuídala. Es una chica fantástica."
    ant "Take care of her. She's a wonderful girl."

# game/scripts/c18/c18.rpy:488
translate english c18s001_Dinner_5eb610ee:

    # mc "Sí que lo es."
    mc "Yes, she is indeed."

# game/scripts/c18/c18.rpy:490
translate english c18s001_Dinner_fabd217c:

    # lis "Hola, Anthony."
    lis "Hi, Anthony."

# game/scripts/c18/c18.rpy:491
translate english c18s001_Dinner_a5356373:

    # "Se suceden las presentaciones al llegar las chicas."
    "The introductions follow one after the other when the girls arrive."

# game/scripts/c18/c18.rpy:492
translate english c18s001_Dinner_2556ab00:

    # "La interacción entre Lisa y Anthony se ve más amistosa de lo que podrías haber esperado tras lo que te explicó Lisa ayer."
    "The interaction between Lisa and Anthony looks friendlier than you might have expected after what Lisa explained to you yesterday."

# game/scripts/c18/c18.rpy:494
translate english c18s001_Dinner_7a11e38a:

    # har "Yo voy a llevar las bebidas a la mesa. Jeff debe estar preguntándose por qué tardamos tanto."
    har "I'll get the drinks to the table. Jeff must be wondering what took us so long."

# game/scripts/c18/c18.rpy:495
translate english c18s001_Dinner_3452f087:

    # har "Anthony, si te quieres quedar con tus amigos, por nosotros no hay problema."
    har "Anthony, if you want to stay with your friends, that's fine with us."

# game/scripts/c18/c18.rpy:496
translate english c18s001_Dinner_b5b30d3f:

    # ant "Bueno... creo que será lo mejor si me voy contigo. He venido con vosotros al fin y al cabo."
    ant "Well... I think it will be best if I go with you. I came with you after all."

# game/scripts/c18/c18.rpy:497
translate english c18s001_Dinner_af68f0d2:

    # mc "Si cambias de opinión, avisa a Lisa. Estamos en la sala privada y tendríamos que venir a buscarte."
    mc "If you change your mind, let Lisa know. We're in the private room and we'd have to come get you."

# game/scripts/c18/c18.rpy:499
translate english c18s001_Dinner_158ff277:

    # lis "Sí, hazlo. Vamos cortas de chicos con los que bailar y las chicas van a querer conocerte."
    lis "Yes, please do. We're short on guys to dance with, and the girls are going to want to meet you."

# game/scripts/c18/c18.rpy:500
translate english c18s001_Dinner_2abefeef:

    # lis "Les he hablado mucho de ti."
    lis "I've told them a lot about you."

# game/scripts/c18/c18.rpy:501
translate english c18s001_Dinner_28083649:

    # sca "Y, antes de que preguntes, todo lo que ha dicho ha sido bueno."
    sca "And, before you ask, everything she said about you was good."

# game/scripts/c18/c18.rpy:503
translate english c18s001_Dinner_09c04153:

    # ant "Bueno, hoy quería pasar un rato con mi hermana y mi cuñado. Hacía mucho que no salíamos."
    ant "Well, today I wanted to spend some time with my sister and brother-in-law. It has been a long time since we went out for a drink."

# game/scripts/c18/c18.rpy:504
translate english c18s001_Dinner_e954b2bc:

    # har "Pero nosotros no estaremos mucho rato. Seguramente después de la primera actuación de Megan, la chica que canta, nos vayamos. Tiene una voz increíble."
    har "But we won't be here long. Probably after Megan's, the girl who sings, first performance, we'll leave. She has an amazing voice."

# game/scripts/c18/c18.rpy:505
translate english c18s001_Dinner_3fe983af:

    # har "Con lo que os podemos prestar a Anthony después. *Risa* Así no se siente mal por habernos abandonado y pasa un rato con esas chicas que parecen tan ansiosas por conocerlo."
    har "So we can lend Anthony to you guys later. *Laugh* That way he doesn't feel bad about ditching us and hanging out with those girls who seem so eager to meet him."

# game/scripts/c18/c18.rpy:506
translate english c18s001_Dinner_4c8c0375:

    # ant "Bueno, ya veremos..."
    ant "Well, we'll see..."

# game/scripts/c18/c18.rpy:508
translate english c18s001_Dinner_1ade258c:

    # sca "No vas a dejar a once damiselas en apuros con sólo un caballero con el que bailar, ¿no?"
    sca "You're not going to leave eleven damsels in distress with only one gentleman to dance with, are you?"

# game/scripts/c18/c18.rpy:509
translate english c18s001_Dinner_96949d21:

    # lis "No te presionamos más. Tienes mi número. Mándame un mensaje o llámame si quieres venir. Me gustaría que lo hicieras."
    lis "We won't pressure you anymore. You have my number. Text me or call me if you want to come. I'd like you to."

# game/scripts/c18/c18.rpy:510
translate english c18s001_Dinner_e46e5975:

    # mc "Anthony, no estás obligado. Ven sólo si quieres. Pero espero verte luego."
    mc "Anthony, don't feel obligated. Come only if you want to. But I hope to see you later."

# game/scripts/c18/c18.rpy:512
translate english c18s001_Dinner_206dfa64:

    # ant "Bueno, si Harley y Jeff deciden irse pronto, te aviso."
    ant "Well, if Harley and Jeff decide to leave soon, I'll let you know."

# game/scripts/c18/c18.rpy:513
translate english c18s001_Dinner_d42cd077:

    # lis "Espero tu mensaje."
    lis "I'll be waiting for your call."

# game/scripts/c18/c18.rpy:514
translate english c18s001_Dinner_3ab75698:

    # mcp "(Este abrazo es mucho más cálido que el que se dieron cuando aún estaban descubriendo si querían salir juntos o no.)"
    mcp "(That hug is much warmer than the one they gave each other when they were still figuring out whether or not they wanted to date.)"

# game/scripts/c18/c18.rpy:516
translate english c18s001_Dinner_91156551:

    # har "Encantada de conoceros, chicas. Y de verte a ti otra vez, [mc]. Ahora nos tenemos que ir antes de que mi marido se preocupe."
    har "Nice to meet you girls. And to see you again, [mc]. Now we have to go before my husband gets worried."

# game/scripts/c18/c18.rpy:517
translate english c18s001_Dinner_a98d298e:

    # mc "Igualmente, Harley."
    mc "Likewise, Harley."

# game/scripts/c18/c18.rpy:519
translate english c18s001_Dinner_7a374f64:

    # lis "¡Qué casualidad que la hermana de Anthony sea la médico de Olivia! Sabía que su hermana mayor era médico, pero esto es mucha casualidad."
    lis "What a coincidence that Anthony's sister is Olivia's doctor! I knew his older sister was a doctor, but this is staggering."

# game/scripts/c18/c18.rpy:521
translate english c18s001_Dinner_d0194107:

    # mc "Y por curiosidad, tiene otra hermana, ¿verdad?"
    mc "And, just out of curiosity, he has another sister, doesn't he?"

# game/scripts/c18/c18.rpy:522
translate english c18s001_Dinner_59840597:

    # lis "¿Cómo lo sabes? Olga es un par de años más joven que Harley y un año mayor que Anthony. Es con quién más unido está."
    lis "How did you know? Olga is a couple of years younger than Harley and a year older than Anthony. She's the one he's closest to."

# game/scripts/c18/c18.rpy:523
translate english c18s001_Dinner_892335e9:

    # mc "Has dicho su hermana mayor. He intuido que debía haber una intermedia."
    mc "You said his older sister. I sensed there must have been an in-between or a younger one."

# game/scripts/c18/c18.rpy:524
translate english c18s001_Dinner_f6e26917:

    # lis "Se mudó a San Francisco hace un par de semanas, el mismo día que llegamos nosotras aquí. Antes vivía en Seattle."
    lis "She moved to San Francisco a week ago, the same day we got here. She used to live in Seattle."

# game/scripts/c18/c18.rpy:525
translate english c18s001_Dinner_c8c9ae20:

    # mc "El mundo es un pañuelo..."
    mc "The world is a small place..."

# game/scripts/c18/c18.rpy:528
translate english c18s001_Dinner_33310525:

    # "Volvéis con las bebidas a la sala privada. La seguridad con que Scarlett lleva la bandeja contrasta con lo torpes que os sentís Lisa y tú."
    "You return with the drinks to the private room. The confidence with which Scarlett carries the tray contrasts with how awkward you and Lisa feel."

# game/scripts/c18/c18.rpy:529
translate english c18s001_Dinner_14b65676:

    # "Suena música suave para entrar en ambiente antes de que la actuación de Megan comience."
    "Soft music plays to get in the mood before Megan's performance begins."

# game/scripts/c18/c18.rpy:531
translate english c18s001_Dinner_6c5051cc:

    # sai "Un brindis por las chicas del cumpleaños."
    sai "A toast to the birthday lasses."

# game/scripts/c18/c18.rpy:532
translate english c18s001_Dinner_fe38e22c:

    # todas "¡Sí!"
    todas "Yes!"

# game/scripts/c18/c18.rpy:533
translate english c18s001_Dinner_8a435623:

    # sai "¡Brindo porque este año os traiga mucha felicidad!"
    sai "Here's to this year bringing you much happiness!"

# game/scripts/c18/c18.rpy:534
translate english c18s001_Dinner_f9d3ccfd:

    # todas "¡Salud!"
    todas "Cheers!"

# game/scripts/c18/c18.rpy:536
translate english c18s001_Dinner_cb123a3b:

    # "Después de los brindis, todas empiezan a hablar con todas sobre los planes del próximo año."
    "After the toast, they all start talking to each other about next year's plans."

# game/scripts/c18/c18.rpy:538
translate english c18s001_Dinner_2ccdce99:

    # "Casi parece que sea el cumpleaños de todas."
    "It almost feels like it's every one of them's birthday."

# game/scripts/c18/c18.rpy:543
translate english c18s001_Scarlett_35d28430:

    # sca "¿Bailas? La última vez no pude bailar contigo por culpa de aquellos dos chicos."
    sca "Do you want to dance? Last time I couldn't dance with you because of those two boys."

# game/scripts/c18/c18.rpy:544
translate english c18s001_Scarlett_f7744f06:

    # mc "¡Por supuesto!"
    mc "Of course!"

# game/scripts/c18/c18.rpy:546
translate english c18s001_Scarlett_b6ef6e84:

    # "Os separáis un poco del grupo de chicas, para poder hablar en privado mientras bailáis."
    "You break away a little from the group of girls, so you can talk privately while you dance."

# game/scripts/c18/c18.rpy:547
translate english c18s001_Scarlett_0d480b65:

    # sca "Están super emocionadas con lo de mañana."
    sca "They are super excited about tomorrow."

# game/scripts/c18/c18.rpy:548
translate english c18s001_Scarlett_3a78b0cc:

    # mc "Es normal. Siempre se han puesto así en sus cumpleaños. Me fastidia no haber podido estar en los tres últimos."
    mc "It's normal. They've always been like that on their birthdays. I'm bummed I wasn't here for the last three."

# game/scripts/c18/c18.rpy:550
translate english c18s001_Scarlett_36b988ac:

    # sca "No es eso. Desde lo que dijiste en la cena de ayer sobre Amanda formando parte de la familia, no hacen más que hablar de ello."
    sca "It's not that. Ever since what you said at dinner yesterday... about Amanda being part of the family, they've done nothing but talk about it."

# game/scripts/c18/c18.rpy:551
translate english c18s001_Scarlett_4a09d2b2:

    # mc "No creo que dijera nada que no pensáramos todos. Y vuestras respuestas lo confirmaron."
    mc "I don't think I said anything we didn't all think. And your answers just confirmed it."

# game/scripts/c18/c18.rpy:553
translate english c18s001_Scarlett_7cdab485:

    # sca "Sí, tienes razón. Pero ninguna de nosotras lo había verbalizado previamente."
    sca "Yes, you're right. But neither of us had verbalized it previously."

# game/scripts/c18/c18.rpy:554
translate english c18s001_Scarlett_5830ba57:

    # sca "Todas nos sentíamos parte de la familia, pero decirlo en alto y saber lo que pensaban las demás... ¡Phew!"
    sca "We all felt we were part of the family, but to say it out loud and know what the others thought... Phew!"

# game/scripts/c18/c18.rpy:556
translate english c18s001_Scarlett_4db29d44:

    # sca "Mientras hablabas con Amanda fuera, nosotras nos quedamos mirándonos las unas a las otras."
    sca "While you were talking to Amanda outside, we were just staring at each other."

# game/scripts/c18/c18.rpy:557
translate english c18s001_Scarlett_47d41948:

    # sca "Después vinieron un montón de abrazos. No era necesario decir nada. Lo habíamos dicho todas sobre Amanda."
    sca "Then came a lot of hugs. There was no need to say anything. We had all said it about Amanda."

# game/scripts/c18/c18.rpy:559
translate english c18s001_Scarlett_cb1ac273:

    # sca "Y en ese momento todas fuimos Amanda."
    sca "And, at that moment, we were all Amanda."

# game/scripts/c18/c18.rpy:560
translate english c18s001_Scarlett_b983afd4:

    # sca "A algunas de nosotras se nos escaparon algunas lágrimas."
    sca "Some of us even had a few tears running down our cheeks."

# game/scripts/c18/c18.rpy:561
translate english c18s001_Scarlett_19b12ff6:

    # mc "Les tengo que pedir ese video a Amanda y a Eva. *Risa*"
    mc "I have to ask Amanda and Eva for that video. *Laugh*"

# game/scripts/c18/c18.rpy:563
translate english c18s001_Scarlett_2cdb75c3:

    # sca "Puedes reírte si quieres, pero fue muy emocionante. Y después Olivia dijo que sólo a ti se te podría ocurrir ponernos en esa situación."
    sca "You can laugh if you want, but it was very emotional. And then Olivia said only you could think of putting us in that situation."

# game/scripts/c18/c18.rpy:564
translate english c18s001_Scarlett_b1d47099:

    # sca "Y las caras de todas decían que pensaban que tenía razón."
    sca "And everyone's faces said they thought she was right."

# game/scripts/c18/c18.rpy:565
translate english c18s001_Scarlett_61af3e7e:

    # mc "*Risa* ¡La culpa es de [mc]!"
    mc "*Laugh* Blame [mc]!"

# game/scripts/c18/c18.rpy:567
translate english c18s001_Scarlett_cdf76c28:

    # sca "*Risa* No estaban buscando culpables. Cada una de nosotras estaba contenta sintiéndose parte de algo sin hablarlo con el resto."
    sca "*Laugh* They weren't looking for someone to blame. Each of us was happy feeling part of something without talking about it with each other."

# game/scripts/c18/c18.rpy:568
translate english c18s001_Scarlett_2edcdcf6:

    # sca "Gracias a ti, nos hemos dado cuenta de que el resto sienten lo mismo. Nadie te culpa. Todo el mundo te lo agradece."
    sca "Thanks to you, we have realized that everyone else feels the same way. No one blames you. Everyone thanks you for forcing us to notice it."

# game/scripts/c18/c18.rpy:569
translate english c18s001_Scarlett_8c4a4cd4:

    # mc "Creo que te lo deberían agradecer a ti."
    mc "I think they should thank you for that, not me."

# game/scripts/c18/c18.rpy:571
translate english c18s001_Scarlett_8135b027:

    # sca "¿A mí? ¿Qué he hecho yo ahora?"
    sca "Me? What did I do now?"

# game/scripts/c18/c18.rpy:572
translate english c18s001_Scarlett_433961ca:

    # mc "Proponer la Navidad en la playa. Este sentimiento empezó allí."
    mc "Propose the Christmas on the beach day. This feeling started there."

# game/scripts/c18/c18.rpy:574
translate english c18s001_Scarlett_90218ce0:

    # sca "Pero yo solo quise proponer algo divertido..."
    sca "But I just wanted to propose something fun..."

# game/scripts/c18/c18.rpy:575
translate english c18s001_Scarlett_1ad2f5ca:

    # mc "Y fue divertido. Pero estar todos juntos también creó este sentimiento. Es tan culpa tuya como mía."
    mc "And it was fun. But being all together also created this feeling. It's as much your fault as it is mine."

# game/scripts/c18/c18.rpy:576
translate english c18s001_Scarlett_599c1cf9:

    # sca "No lo había visto así..."
    sca "I didn't see it like that..."

# game/scripts/c18/c18.rpy:578
translate english c18s001_Scarlett_ce9dbd34:

    # sca "Pero cambiando de tema antes de que me ruborice... ¿Sabes que Eva y Amanda también usan lengua de signos?"
    sca "But changing the topic before I blush... Did you know that Eva and Amanda also use sign language?"

# game/scripts/c18/c18.rpy:579
translate english c18s001_Scarlett_a4c50100:

    # mc "No, no lo sabía. Supongo que tiene que ser útil para ellas poderse comunicar en silencio."
    mc "No, I didn't know. I guess it must be helpful for them to be able to communicate silently."

# game/scripts/c18/c18.rpy:581
translate english c18s001_Scarlett_48a06b30:

    # sca "Supongo... no les entiendo la mayoría de lo que señalan, pero está claro que son gestos rápidos y deliberados."
    sca "I guess... I don't understand most of what they're signaling, but it's clear that they're quick and deliberate movements."

# game/scripts/c18/c18.rpy:582
translate english c18s001_Scarlett_2d3d95bb:

    # sca "No mires, pero están discutiendo por algo."
    sca "Don't look, but they're arguing about something."

# game/scripts/c18/c18.rpy:584
translate english c18s001_Scarlett_d9234634:

    # sca "Son gestos enfadados, y ni siquiera se están mirando directamente."
    sca "They're angry signs, and they're not even looking directly at each other."

# game/scripts/c18/c18.rpy:586
translate english c18s001_Scarlett_5050edf6:

    # sca "Deben usar un lenguaje diferente del ASL."
    sca "They must use a language different from ASL."

# game/scripts/c18/c18.rpy:587
translate english c18s001_Scarlett_f2821762:

    # mc "Bueno, se criaron en Aruba, no sé qué hablarán allí."
    mc "Well, they grew up in Aruba, I don't know what language they speak... sign there."

# game/scripts/c18/c18.rpy:589
translate english c18s001_Scarlett_b40818c2:

    # "Suena un móvil en algún sitio."
    "A cell phone rings somewhere."

# game/scripts/c18/c18.rpy:591
translate english c18s001_Scarlett_f71d8e27:

    # sca "Se lo puedes preguntar a Eva. Viene hacia aquí, creo que se ha acabado nuestro baile."
    sca "You can ask Eva. She's on her way over here. I think our dance is over."

# game/scripts/c18/c18.rpy:592
translate english c18s001_Scarlett_d0b7ddd8:

    # sca "Todas van a querer bailar contigo. Eres el único chico."
    sca "Everyone will want to dance with you. You're the only guy."

# game/scripts/c18/c18.rpy:593
translate english c18s001_Scarlett_37c7001e:

    # mc "Bailamos luego otra vez. La noche es larga."
    mc " Let's dance again later. The night is long."

# game/scripts/c18/c18.rpy:596
translate english c18s001_Scarlett_99def1ae:

    # "Scarlett te hace los gestos de \"Te Quiero\", pero lo hace diferente."
    "Scarlett makes the \"I love you\" signs, but she does it differently than what you studied."

# game/scripts/c18/c18.rpy:597
translate english c18s001_Scarlett_2b5a9c81:

    # mc "Eso se ha visto diferente de como lo hice yo."
    mc "That looked different than how I did it."

# game/scripts/c18/c18.rpy:599
translate english c18s001_Scarlett_1cdb8ec2:

    # sca "*Risita* Es que no lo hiciste bien del todo. Mira, el \"Yo\" se hace así."
    sca "*Chuckle* It's just that you didn't do it completely right. Look, the \"I\" is done like this."

# game/scripts/c18/c18.rpy:603
translate english c18s001_Scarlett_2669ca66:

    # sca "Lo que tú hiciste se parece más a \"A mí\". Dijiste algo como \"A mí te quiero\"."
    sca "What you did was more like \"To me\". You said something like \"To me love you\"."

# game/scripts/c18/c18.rpy:604
translate english c18s001_Scarlett_559d3b13:

    # mc "¿Por qué no me lo dijiste?"
    mc "Why didn't you tell me?"

# game/scripts/c18/c18.rpy:606
translate english c18s001_Scarlett_bdd695b0:

    # sca "¿Y fastidiar el momento? ¡No!"
    sca "And spoil the moment? Never!"

# game/scripts/c18/c18.rpy:607
translate english c18s001_Scarlett_5f29e1e4:

    # sca "Te tomaste el esfuerzo y entendí lo que querías decir. Era suficiente para mí. Era el gesto más bonito que habían hecho nunca por mí."
    sca "You took the effort to learn, and I understood what you meant. It was enough for me. It was the nicest gesture anyone had ever done for me."

# game/scripts/c18/c18.rpy:608
translate english c18s001_Scarlett_6676f26b:

    # mc "Pero lo podía haber hecho mejor."
    mc "But I could have done it better."

# game/scripts/c18/c18.rpy:610
translate english c18s001_Scarlett_988f984e:

    # sca "No, mi amor. No podías."
    sca "No, my love. You couldn't."

# game/scripts/c18/c18.rpy:614
translate english c18s001_Eva_470231be:

    # eva "¿Interrumpo algo? ¿Puedo robarte a [mc] por una canción, Scarlett?"
    eva "Am I interrupting something? Can I steal [mc] from you for a song, Scarlett?"

# game/scripts/c18/c18.rpy:616
translate english c18s001_Eva_5bc304ce:

    # sca "No interrumpes. Precisamente le estaba diciendo que todas íbamos a querer bailar con él."
    sca "You're not interrupting. I was just telling him that we all want to dance with him."

# game/scripts/c18/c18.rpy:617
translate english c18s001_Eva_2d394a22:

    # sca "Pasáoslo bien."
    sca "Have a good time."

# game/scripts/c18/c18.rpy:619
translate english c18s001_Eva_3ddd83ca:

    # eva "Gracias, Scarlett."
    eva "Thanks, Scarlett."

# game/scripts/c18/c18.rpy:620
translate english c18s001_Eva_a0458336:

    # sca "Lo que necesites, guapísima."
    sca "Whatever you need, gorgeous."

# game/scripts/c18/c18.rpy:622
translate english c18s001_Eva_09f04e38:

    # eva "Me encanta este sitio, pero tenías razón. Voy demasiado vestida para esto."
    eva "I love this place, but you were right. I'm overdressed for this."

# game/scripts/c18/c18.rpy:623
translate english c18s001_Eva_3d6ea348:

    # mc "No creo. Ya te he dicho antes que estás preciosa. Puede que no sea una embajada, como ha dicho Amanda, pero si estás cómoda con ese vestido, nadie se va a quejar."
    mc "I don't think so. I told you earlier that you look beautiful. It may not be an embassy, as Amanda said, but if you're comfortable in that dress, no one's going to grumble."

# game/scripts/c18/c18.rpy:624
translate english c18s001_Eva_96ee0478:

    # mc "¿De qué estabais discutiendo? ¿Hay algún problema entre vosotras?"
    mc "What were you arguing about? Is there a problem between you?"

# game/scripts/c18/c18.rpy:626
translate english c18s001_Eva_470c137b:

    # eva "¿Cómo sabes que estábamos discutiendo? Creía que solo sabias unas pocas palabras en lengua de signos."
    eva "How did you know we were arguing? I thought you only knew a few words in sign language."

# game/scripts/c18/c18.rpy:627
translate english c18s001_Eva_24b4818f:

    # mc "Me lo ha dicho Scarlett. No os entendía, pero por vuestros gestos dice que quedaba claro que era una discusión."
    mc "Scarlett told me. She didn't understand you but, from your gestures, she says it was clear that it was a discussion."

# game/scripts/c18/c18.rpy:629
translate english c18s001_Eva_e2fb139e:

    # eva "Me estaba acusando de algo y... la cosa se ha calentado..."
    eva "She was accusing me of something and... it got heated..."

# game/scripts/c18/c18.rpy:630
translate english c18s001_Eva_ac64cb72:

    # mc "¿Puedo saber de qué te estaba acusando? ¿O es algo entre vosotras?"
    mc "May I know what she was accusing you of? Or is it something between you?"

# game/scripts/c18/c18.rpy:632
translate english c18s001_Eva_db7bd9f4:

    # eva "Ningún problema. Se está comportando como una niña celosa. Me acusaba de haberme puesto este vestido para ti."
    eva "No problem. She's acting like a jealous child. She was accusing me of wearing this dress for you."

# game/scripts/c18/c18.rpy:633
translate english c18s001_Eva_53534287:

    # eva "Como ella se ha tenido que poner uno de los vestidos de [emm]..."
    eva "Since she had to wear one of [emm]'s dresses..."

# game/scripts/c18/c18.rpy:634
translate english c18s001_Eva_692ea280:

    # mc "¿Para mí? ¿Por qué?"
    mc "For me? Why?"

# game/scripts/c18/c18.rpy:635
translate english c18s001_Eva_c7374d8d:

    # mc "¿Tiene algo que ver con que ayer la acusaras de flirtear conmigo?"
    mc "Does it have anything to do with you accusing her of flirting with me yesterday?"

# game/scripts/c18/c18.rpy:637
translate english c18s001_Eva_0f9deee0:

    # eva "¡Chivata!"
    eva "Snitch!"

# game/scripts/c18/c18.rpy:638
translate english c18s001_Eva_fb49920c:

    # mc "Igual de chivata que tú ahora mismo, Eva. *Risa*"
    mc "Just as much of a snitch as you are right now, Eva. *Laugh*"

# game/scripts/c18/c18.rpy:640
translate english c18s001_Eva_8fbb2f82:

    # eva "Tienes razón..."
    eva "You are right..."

# game/scripts/c18/c18.rpy:641
translate english c18s001_Eva_5aab5dbc:

    # mc "Y... ¿realmente te lo has puesto para mí?"
    mc "And... did you really wear it for me?"

# game/scripts/c18/c18.rpy:642
translate english c18s001_Eva_876fd190:

    # eva "Me lo he puesto porque quería estar guapa."
    eva "I wore it because I wanted to look pretty."

# game/scripts/c18/c18.rpy:644
translate english c18s001_Eva_5003db39:

    # eva "Además, no tendría mucho sentido querer seducirte con un vestido si ya me has visto solo con las bragas... ¿no?"
    eva "Moreover, it wouldn't make much sense to seduce you with a dress if you've already seen me in just my panties... would it?"

# game/scripts/c18/c18.rpy:645
translate english c18s001_Eva_9632f557:

    # mc "*Risa* No me recuerdes ese día. No sabía que eras tú."
    mc "*Laugh* Don't remind me of that day. I didn't know it was you."

# game/scripts/c18/c18.rpy:646
translate english c18s001_Eva_505beb96:

    # mc "Pero creo que sabes poco de la mentalidad masculina. *Risa*"
    mc "But I think you know very little about the male mentality. *Laugh*"

# game/scripts/c18/c18.rpy:648
translate english c18s001_Eva_2283a464:

    # eva "¿A qué te refieres? ¿No te gusta el vestido?"
    eva "What do you mean? Don't you like the dress?"

# game/scripts/c18/c18.rpy:649
translate english c18s001_Eva_326e0be4:

    # mc "Me encanta."
    mc "I love it."

# game/scripts/c18/c18.rpy:650
translate english c18s001_Eva_2640c7a4:

    # mc "Me refiero a que la mayoría de los hombres prefieren ganarse el derecho a ver una chica desnuda. Un poco de coqueteo, que te dejen queriendo más..."
    mc "I mean most men would rather earn the right to see a girl naked. A little flirting, leave you wanting more..."

# game/scripts/c18/c18.rpy:651
translate english c18s001_Eva_631f85af:

    # mc "Si consiguen el premio sin esfuerzo, no le dan el valor que tiene. No digo que no lo valoren, pero no lo hacen lo suficiente."
    mc "If they get the prize without effort, they don't give it the value it has. I'm not saying they don't value it, but they don't value it enough."

# game/scripts/c18/c18.rpy:653
translate english c18s001_Eva_84a8b471:

    # eva "Mmmm... tomo nota. Es decir... si quiero algo con un chico... debería dejarle con ganas de más, ¿no?"
    eva "Mmmm... I'll take note. I mean... if I want something with a guy... I should leave him wanting more, right?"

# game/scripts/c18/c18.rpy:654
translate english c18s001_Eva_c21d463d:

    # mc "Sí, pero ve con cuidado. Si se lo haces muchas veces, puede pensar que eres una calienta pollas y perder el interés. Tienes que medir cuántas veces puedes o debes hacerlo."
    mc "Yes, but be careful. If you do it to him too many times, he may think you're a tease and lose interest. You have to gauge how many times you can or should do it."

# game/scripts/c18/c18.rpy:656
translate english c18s001_Eva_5c976d1f:

    # eva "OK. Primera vez."
    eva "OK. First time."

# game/scripts/c18/c18.rpy:657
translate english c18s001_Eva_a3db9a7f:

    # mc "¿Qué?"
    mc "What?"

# game/scripts/c18/c18.rpy:659
translate english c18s001_Eva_f057ccd6:

    # mc "*Risa*"
    mc "*Laugh*"

# game/scripts/c18/c18.rpy:660
translate english c18s001_Eva_ce10b6af:

    # mcp "(Tía Betty estaría orgullosa de mí ahora mismo. Esta vez no hace falta que le pregunte a Eva si el chico al que se refiere soy yo.)"
    mcp "(Aunt Betty would be proud of me right now. This time I didn't need to ask Eva if I'm the guy she's referring to.)"

# game/scripts/c18/c18.rpy:661
translate english c18s001_Eva_02bf18ee:

    # mcp "(Y sí, me ha dejado con ganas de más. ¿Qué voy a hacer con esta chica?)"
    mcp "(And yes, she left me wanting more. What am I going to do with this girl?)"

# game/scripts/c18/c18.rpy:665
translate english c18s001_Kate_7103f663:

    # "Te diriges a la mesa donde están las bebidas. Apenas has tenido tiempo de probar tu zumo de piña."
    "You head to the table where the drinks are. You've barely had time to taste your pineapple juice."

# game/scripts/c18/c18.rpy:666
translate english c18s001_Kate_9de0f56d:

    # mc "¿Qué tal, Kate? ¿No bailas?"
    mc "What's up Kate? Don't you like to dance?"

# game/scripts/c18/c18.rpy:667
translate english c18s001_Kate_c6d1c6c8:

    # kat "No puedo bailar mientras te odio. *Risa*"
    kat "I can't dance while I hate you. *Laugh*"

# game/scripts/c18/c18.rpy:668
translate english c18s001_Kate_e1dffb5b:

    # mc "¿Qué? ¿Por qué? ¿Qué he hecho yo ahora? ¿Puedo sentarme?"
    mc "What? Why? What have I done now? Can I sit down?"

# game/scripts/c18/c18.rpy:670
translate english c18s001_Kate_58e58e6a:

    # kat "Convencerme para hacer más deporte. *Risa* Tengo agujetas en las agujetas."
    kat "You convinced me to do more sports. *Laugh* My sore muscles have sore muscles themselves."

# game/scripts/c18/c18.rpy:671
translate english c18s001_Kate_c4cc1884:

    # kat "Yoga a primera hora, después Debbie me ha tenido media mañana nadando. Ayer Kim me sacó a correr 30 minutos por la carretera."
    kat "Yoga first thing in the morning, then Debbie had me swimming until lunchtime. Kim took me out for a 30 minute run on the road yesterday."

# game/scripts/c18/c18.rpy:674
translate english c18s001_Kate_dfab0e8e:

    # kat "Y para ponerlo peor, me he tenido que retener de comer todas las cosas deliciosas que han preparado [mar] y [nor]."
    kat "And to make it worse, I have had to withhold myself from eating all the delicious things that [mar] and [nor] have cooked."

# game/scripts/c18/c18.rpy:675
translate english c18s001_Kate_8720d35f:

    # kat "Y tengo que beber un cocktail sin alcohol. ¡Puagh! ¡Necesito mi azúcar intravenoso!"
    kat "And I have to drink a non-alcoholic cocktail. Puagh! I need my intravenous sugar!"

# game/scripts/c18/c18.rpy:676
translate english c18s001_Kate_23cbe36d:

    # mc "Comer saludable es bueno. [mar] y [nor] cocinan muy saludable, con lo que podrás comer de todo, pero quizás en menos cantidad de lo que lo hacías antes."
    mc "Eating healthy is good. [mar] and [nor] cook very healthy, so you'll be able to eat everything, but maybe in less quantity than you did before."

# game/scripts/c18/c18.rpy:677
translate english c18s001_Kate_fae3d1b3:

    # mc "Piensa que es por tu bien. Y hacer deporte es bueno. Te dará más resistencia."
    mc "Think of it as being for your own good. And doing sports is good. It will give you more stamina."

# game/scripts/c18/c18.rpy:679
translate english c18s001_Kate_c586d63e:

    # kat "Lo sé, y todas me están ayudando mucho, pero duermo en la tercera planta."
    kat "I know, and they're all helping me a lot, but I sleep on the third floor."

# game/scripts/c18/c18.rpy:680
translate english c18s001_Kate_7ebda716:

    # kat "Ayer casi tuve que subir el último tramo de escaleras a gatas. Las piernas se quejaban a cada escalón."
    kat "I almost had to crawl up the last flight of stairs yesterday. My legs were complaining at every step."

# game/scripts/c18/c18.rpy:681
translate english c18s001_Kate_e1ccb57e:

    # mc "No hace falta que te esfuerces demasiado. Es mejor hacer las cosas bien y poco a poco que quemarte."
    mc "You don't have to try too hard. It's better to do things right and slowly than to burn yourself out."

# game/scripts/c18/c18.rpy:691
translate english c18s001_Kate_a7d6e7ab:

    # mc "Cuando hayas cogido un poco de resistencia, te llevaré a un lago precioso que hay en las colinas. Ya verás como vale la pena."
    mc "When you've built up some stamina, I'll take you to a beautiful lake in the hills. You'll see it's worth it."

# game/scripts/c18/c18.rpy:693
translate english c18s001_Kate_bf442a18:

    # kat "Oh, eso sería genial. Debbie y Kim me han dicho que es precioso."
    kat "Oh, that would be great. Debbie and Kim told me the lake is beautiful."

# game/scripts/c18/c18.rpy:695
translate english c18s001_Kate_938700eb:

    # kat "Kim me ha dicho de subir un día corriendo al lago. Cuando haya conseguido que dar dos pasos no duela."
    kat "Kim told me to run up to the lake one day. If I ever get to take two steps back-to-back without any pain."

# game/scripts/c18/c18.rpy:696
translate english c18s001_Kate_5c552fee:

    # mc "Cuando subáis avisadme y me apunto si puedo."
    mc "When you go up there, let me know and I'll join if I can."

# game/scripts/c18/c18.rpy:698
translate english c18s001_Kate_6418e5c1:

    # kat "Kim ya me ha dicho que las llevaste a ella y a Debbie y que es precioso."
    kat "Kim told me already that you took her and Debbie there and that it's beautiful."

# game/scripts/c18/c18.rpy:700
translate english c18s001_Kate_9cd6998c:

    # kat "También has estado allí con Eileen y Alexia... y Eva..."
    kat "You've also been there with Eileen and Alexia... and Eva..."

# game/scripts/c18/c18.rpy:702
translate english c18s001_Kate_c3b75b83:

    # kat "*Risa* ¡Y todas han estado contigo allí!"
    kat "*Laugh* And they've all been with you there!"

# game/scripts/c18/c18.rpy:703
translate english c18s001_Kate_b86819b7:

    # kat "¿Es como tu terreno de caza particular? ¿El sitio donde llevas a las chicas para deslumbrarlas con la belleza del lugar?"
    kat "Is it like your particular hunting ground? The place where you take the girls to dazzle them with the beauty of the place?"

# game/scripts/c18/c18.rpy:704
translate english c18s001_Kate_e0e21fce:

    # mc "*Risa* No es eso, Kate."
    mc "*Laugh* It's not that, Kate."

# game/scripts/c18/c18.rpy:714
translate english c18s001_Kate_abaf66fa:

    # mc "Pero si te llevase a ti, el deslumbrado sería el lago. Y sí, sé que suena cursi."
    mc "But if I took you, the dazzled one would be the lake. And yes, I know it sounds corny."

# game/scripts/c18/c18.rpy:716
translate english c18s001_Kate_a56fa9d4:

    # kat "Y ahora quieres que me ruborice otra vez con tus piropos cursis."
    kat "And now you want me to blush again with your cheesy compliments."

# game/scripts/c18/c18.rpy:717
translate english c18s001_Kate_6ce54d32:

    # mc "Ya te dije que, si querías, podía dejar de hacerlo."
    mc "I already told you that, if you wanted me to, I would stop doing it."

# game/scripts/c18/c18.rpy:719
translate english c18s001_Kate_9347f805:

    # kat "Y yo te dije ayer que no me molestan."
    kat "And I told you yesterday that they don't bother me."

# game/scripts/c18/c18.rpy:720
translate english c18s001_Kate_e27514af:

    # mc "Por lo que yo recuerdo, dijiste que no me atreviera a dejar de hacerlo. *Risa*"
    mc "From what I remember, you said \"don't you dare stop doing it\". *Laugh*"

# game/scripts/c18/c18.rpy:721
translate english c18s001_Kate_fc19720f:

    # kat "Es bonito que un chico me diga esas cosas de vez en cuando, aunque sea en broma."
    kat "It's nice to have a guy say those things to me once in a while, even if it's in jest."

# game/scripts/c18/c18.rpy:723
translate english c18s001_Kate_a9759c75:

    # "Suena un móvil, pero ella lo ignora."
    "A cell phone rings, but she brushes it off."

# game/scripts/c18/c18.rpy:724
translate english c18s001_Kate_57bc9e5a:

    # mc "¿Quién ha dicho que sea en broma?"
    mc "Who said it was in jest?"

# game/scripts/c18/c18.rpy:726
translate english c18s001_Kate_a0b49c3a:

    # kat "¿Qué? ¿Lo dices en serio?"
    kat "What? Are you serious?"

# game/scripts/c18/c18.rpy:731
translate english c18s001_Kate_7334a868:

    # emm "Hola, chicos. Kate, ¿te molesta que me lleve a mi hermano para bailar con él?"
    emm "Hi, guys. Kate, do you mind if I borrow my brother to dance with him?"

# game/scripts/c18/c18.rpy:733
translate english c18s001_Kate_c00df548:

    # kat "No, para nada. Todo tuyo. Llévatelo o al final me va a convencer para ir a correr. *Risa*"
    kat "No, not at all. He's all yours. Take him away or he's going to convince me to go running eventually. *Laugh*"

# game/scripts/c18/c18.rpy:734
translate english c18s001_Kate_9ac5dc0a:

    # mc "Te veo luego, Kate, y, si quieres, seguimos la conversación. *Risa*"
    mc "I'll see you later, Kate, and, if you want, we'll continue the conversation. *Laugh*"

# game/scripts/c18/c18.rpy:738
translate english c18s001_Emma_780c398b:

    # emm "Ha sido una gran idea venir aquí. Una sala solo para nosotros es genial. Sin problemas con idiotas como en el Twins."
    emm "It was a great idea to come here. A room just for us is great. No problems with idiots like at the Twins."

# game/scripts/c18/c18.rpy:739
translate english c18s001_Emma_21917f11:

    # mc "Y sin que todas me tengáis que besar para quitárnoslos de encima."
    mc "And without all of you having to kiss me to get them off your backs."

# game/scripts/c18/c18.rpy:741
translate english c18s001_Emma_62347b9d:

    # emm "Bueno... yo no tuve oportunidad de besarte."
    emm "Well... I didn't get a chance to kiss you."

# game/scripts/c18/c18.rpy:742
translate english c18s001_Emma_ca2fd263:

    # mc "Pero lo hiciste luego en mi habitación."
    mc "But you did it later in my bedroom."

# game/scripts/c18/c18.rpy:745
translate english c18s001_Emma_f6d7a818:

    # emm "Y me muero de ganas de hacerlo aquí ahora. Pero, por una vez, no quiero ser el centro de atención."
    emm "And I'm dying to do it here now. But, for once, I don't want to be the focus of attention."

# game/scripts/c18/c18.rpy:746
translate english c18s001_Emma_b92bbdee:

    # emm "[eri] lo sabe, pero [dap] no. También es su cumpleaños y no me gustaría que se sintiera mal."
    emm "[eri] knows about us, but [dap] does not. It's also her birthday and I wouldn't want her to feel bad."

# game/scripts/c18/c18.rpy:747
translate english c18s001_Emma_7405b48f:

    # mc "¿Por qué iba a sentirse mal?"
    mc "Why would she feel bad?"

# game/scripts/c18/c18.rpy:750
translate english c18s001_Emma_71cbd563:

    # emm "Creo que a ella también le gustas, y no me refiero como primo."
    emm "I think she likes you too, and I don't mean as a cousin."

# game/scripts/c18/c18.rpy:751
translate english c18s001_Emma_3bb7dffc:

    # emm "Besarte aquí sería restregarle por la cara que yo estoy contigo y ella no."
    emm "Kissing you here would be rubbing it in her face that I'm with you and she's not."

# game/scripts/c18/c18.rpy:753
translate english c18s001_Emma_211c0cea:

    # mcp "(Tu memoria es muy interesante, [emm]. Ya no recuerdas que, durante la primera comida con Meemaw y Tía Betty, dijo que salía con alguien.)"
    mcp "(Your memory is very interesting, [emm]. You no longer remember that, during the first lunch with Meemaw and Aunt Betty, she said she was seeing someone.)"

# game/scripts/c18/c18.rpy:755
translate english c18s001_Emma_5262424c:

    # mcp "(Eres muy lista, [emm]. Seguro que recuerdas que, durante la primera comida con Meemaw y Tía Betty, dijo que había un chico que le interesaba y seguro que lo has relacionado conmigo.)"
    mcp "(You are very clever, [emm]. I'm sure you remember that, during the first lunch with Meemaw and Aunt Betty, she said there was a guy she was interested in, and I'm sure you've linked him to me.)"

# game/scripts/c18/c18.rpy:756
translate english c18s001_Emma_3ac08a88:

    # mc "Si no te equivocas, y es un \"si\" muy grande, tienes razón. La harías sentir mal. Es el problema de no querer hacerlo público, [emm]."
    mc "If you're not wrong, and it's a very big IF, you're right. You'd make her feel bad. That's the problem with not wanting to go public, [emm]."

# game/scripts/c18/c18.rpy:759
translate english c18s001_Emma_c580d8ea:

    # emm "No creo que me equivoque. Ni siquiera [eri] le ha dicho que estáis juntos. Supongo que será porque ella también lo ha notado."
    emm "I don't think I'm wrong. Even [eri] hasn't told her that you're together. I guess it will be because she has noticed it too."

# game/scripts/c18/c18.rpy:760
translate english c18s001_Emma_0f7534a6:

    # mc "O porque quiere dejar pasar los cumpleaños para hacer el anuncio a toda la familia."
    mc "Or because she wants the birthdays to pass to make the announcement to the whole family."

# game/scripts/c18/c18.rpy:761
translate english c18s001_Emma_03d2c26a:

    # mc "Pero deberíamos empezar a pensar cuándo quieres hacer público lo tuyo y lo mío."
    mc "But we should start thinking about when you want to go public with our relationship."

# game/scripts/c18/c18.rpy:764
translate english c18s001_Emma_a989a2a8:

    # emm "También es su fin de semana y sería un bombazo para todo el mundo."
    emm "It's also her weekend and it would be a blast for everyone."

# game/scripts/c18/c18.rpy:766
translate english c18s001_Emma_78568af6:

    # emm "Y si [eri] también lo hiciera público..."
    emm "And if [eri] also went public..."

# game/scripts/c18/c18.rpy:767
translate english c18s001_Emma_bb143c4c:

    # mc "Tienes razón. Deberíamos pensar en cuándo quieres hacerlo público."
    mc "You're right. We should think about when you want to go public."

# game/scripts/c18/c18.rpy:769
translate english c18s001_Emma_b1e4ce5f:

    # mc "Mamá, [eri], y Eileen ya lo saben. Tienes que decidir cuándo quieres decírselo al resto."
    mc "Mom, [eri], and Eileen already know. You have to decide when you want to tell the rest of them."

# game/scripts/c18/c18.rpy:771
translate english c18s001_Emma_88c6df49:

    # mc "[eri], y Eileen ya lo saben. Tienes que decidir cuándo quieres decírselo al resto."
    mc "[eri], and Eileen already know. You have to decide when you want to tell the rest of them."

# game/scripts/c18/c18.rpy:773
translate english c18s001_Emma_01c142b5:

    # emm "¿Prometes no enfadarte?"
    emm "Do you promise not to get angry?"

# game/scripts/c18/c18.rpy:774
translate english c18s001_Emma_1742a8e9:

    # mc "¿Qué has hecho ahora? ¿Delante de quién más se te ha escapado?"
    mc "What have you done now? In front of whom else did you spill the beans?"

# game/scripts/c18/c18.rpy:775
translate english c18s001_Emma_78aa2d2f:

    # emm "No es eso... Hoy me he levantado con nauseas. No sé si es porque ayer comí como una cerda o... Hace nueve días de nuestra primera vez, y si estuviera embarazada..."
    emm "It's not that... I woke up feeling nauseous today. I don't know if it's because I ate like a pig yesterday or... It's been nine days since our first time, and if I were pregnant..."

# game/scripts/c18/c18.rpy:777
translate english c18s001_Emma_21f4ac1e:

    # emm "El fin de semana que viene podría hacerme una prueba de embarazo."
    emm "I might take a pregnancy test next weekend."

# game/scripts/c18/c18.rpy:778
translate english c18s001_Emma_26027b19:

    # mc "¡Oh, mierda!"
    mc "Oh, shit!"

# game/scripts/c18/c18.rpy:780
translate english c18s001_Emma_64a6cd98:

    # emm "¿Qué pasa? ¿No quieres tener un hijo conmigo?"
    emm "What's the matter? Don't you want to have a child with me?"

# game/scripts/c18/c18.rpy:781
translate english c18s001_Emma_ea1a62df:

    # "Le explicas lo de las pruebas rápidas de embarazo."
    "You explain to her about the quick pregnancy tests."

# game/scripts/c18/c18.rpy:783
translate english c18s001_Emma_d18754b4:

    # emm "¿Por qué no me lo habías dicho antes?"
    emm "Why didn't you tell me about it earlier?"

# game/scripts/c18/c18.rpy:784
translate english c18s001_Emma_f96b81cf:

    # mc "Estabas tan enfadada el día de la comida con Eva que... me olvidé. Creía habértelo dicho."
    mc "You were so angry yesterday, during Eva's lunch, that... I forgot. I thought I told you already."

# game/scripts/c18/c18.rpy:786
translate english c18s001_Emma_fc57eead:

    # emm "En cuanto lleguemos a casa me la hago. Cubrirá nuestras dos veces y mañana lo podríamos saber."
    emm "As soon as we get home, I'll take the test. It will cover our two times and tomorrow we might know the result."

# game/scripts/c18/c18.rpy:787
translate english c18s001_Emma_b656199d:

    # mc "24 horas después de hacer la prueba estaremos jugando a DnD. ¿Serás capaz de aguantar sin mirarlo hasta que acabe la partida?"
    mc "24 hours after taking the test we will be playing DnD. Will you be able to hold on without looking at it until the game is over?"

# game/scripts/c18/c18.rpy:789
translate english c18s001_Emma_882c93d1:

    # emm "Mierda, tienes razón. Y decirles a las chicas que nos tenemos que ir los dos a la vez... mejor no."
    emm " Crap, you're right. And telling the girls that we both have to leave at the same time... better not."

# game/scripts/c18/c18.rpy:790
translate english c18s001_Emma_8c761108:

    # emm "Mejor la hacemos mañana por la mañana y lo sabremos el lunes."
    emm "We'd better do it tomorrow morning, and we'll know on Monday."

# game/scripts/c18/c18.rpy:791
translate english c18s001_Emma_349c7006:

    # mc "Me parece una buena idea. Me paso por tu habitación cuando me despierte."
    mc "Sounds like a good idea. I'll stop by your room when I wake up."

# game/scripts/c18/c18.rpy:794
translate english c18s001_Emma_29ab53e7:

    # emm "No me lo recuerdes... ¡Qué vergüenza!"
    emm "Don't remind me... So embarrassing!"

# game/scripts/c18/c18.rpy:795
translate english c18s001_Emma_9da35e94:

    # mc "No pasa nada. Ya lo hablamos y todo quedó aclarado."
    mc "It's okay. We talked about it, and everything was cleared up."

# game/scripts/c18/c18.rpy:797
translate english c18s001_Emma_6c33ef89:

    # "Suena un móvil justo en el momento en que se enciende el proyector y aparece Megan en la pantalla gigante."
    "A cell phone rings just as the projector turns on and Megan appears on the giant screen."

# game/scripts/c18/c18.rpy:800
translate english c18s001_Emma_530f61fd:

    # meg "Buenas noches a todos. Voy a empezar con mi primera actuación de la noche."
    meg "Good evening everyone. I'm going to start with my first performance of the evening."

# game/scripts/c18/c18.rpy:801
translate english c18s001_Emma_9c1b3477:

    # meg "Esta noche tengo a un grupo de amigos... a mi familia... en el local, con lo que hoy es muy emotivo para mí."
    meg "Tonight I have a group of friends... my family... at the venue, so today is very emotional for me."

# game/scripts/c18/c18.rpy:802
translate english c18s001_Emma_6b288041:

    # meg "Tan solo espero que disfrutéis estas canciones. ¡Vamos allá!"
    meg "I just hope you enjoy these songs. Here we go!"

# game/scripts/c18/c18.rpy:807
translate english c18s001_Saira_c73c0060:

    # sai "Creo que es mi turno de un baile contigo, ¿no?"
    sai "I think it's my turn for a dance with you, isn't it?"

# game/scripts/c18/c18.rpy:808
translate english c18s001_Saira_affd4dab:

    # mc "Por supuesto, además esta canción me encanta."
    mc "Of course, I love this song."

# game/scripts/c18/c18.rpy:810
translate english c18s001_Saira_792c3b3e:

    # mc "¿Qué tal te lo estás pasando?"
    mc "Are you having a good time?"

# game/scripts/c18/c18.rpy:811
translate english c18s001_Saira_9955125c:

    # sai "Genial, la sala privada está muy bien y podemos bailar sin tener que luchar por el espacio."
    sai "It's great, the private room is very nice, and we can dance without competing for the floor."

# game/scripts/c18/c18.rpy:812
translate english c18s001_Saira_f7d55e1d:

    # sai "Ni siquiera tenemos que luchar por ti..."
    sai "We don't even need to compete for you..."

# game/scripts/c18/c18.rpy:813
translate english c18s001_Saira_9eed75b0:

    # mc "¿A qué te refieres?"
    mc "What do you mean?"

# game/scripts/c18/c18.rpy:815
translate english c18s001_Saira_5519520e:

    # sai "A que [dap] es muy lista. Eres el único chico que hay, con lo que todas vamos a bailar contigo."
    sai "I mean [dap] is very smart. You're the only male around, so we're all going to dance with you."

# game/scripts/c18/c18.rpy:816
translate english c18s001_Saira_bb8c4abd:

    # sai "En vez de pelearnos por ver a quién le toca, ha montado un sistema de turnos."
    sai "Instead of fighting over whose turn it is, she has set up a shift system."

# game/scripts/c18/c18.rpy:817
translate english c18s001_Saira_1048adb6:

    # mc "*Risa* Algo así sólo se le podía haber ocurrido a [dap]."
    mc "*Laugh* Only [dap] could have come up with something like that."

# game/scripts/c18/c18.rpy:819
translate english c18s001_Saira_5fe1c336:

    # sai "Scarlett también participó haciendo la app que cada una tenemos en el móvil."
    sai "Scarlett also contributed by making the app we each have on our mobile phones."

# game/scripts/c18/c18.rpy:820
translate english c18s001_Saira_e10704bc:

    # mc "¿Qué? ¿Tenéis una app para saber cuándo os toca bailar conmigo?"
    mc "What? Do you have an app to know when it's your turn to dance with me?"

# game/scripts/c18/c18.rpy:822
translate english c18s001_Saira_b626d4a0:

    # sai "*Risa* Sí, pero no me mires así, Scarlett tenía la app medio hecha para otra cosa y la ha adaptado para esta noche."
    sai "*Laugh* Yes, but don't look at me like that, Scarlett had the app half made for something else, and she adapted it for tonight."

# game/scripts/c18/c18.rpy:823
translate english c18s001_Saira_9315f609:

    # mc "¿Cómo ha funcionado cuando he ido a hablar con Kate?"
    mc "How did it work out when I went to talk to Kate?"

# game/scripts/c18/c18.rpy:825
translate english c18s001_Saira_e84a1e7f:

    # sai "Scarlett y [dap] te conocen muy bien y sabían que pasaría algo así. Tienen una opción para mover los turnos. Pero sólo los pueden mover ellas"
    sai "Scarlett and [dap] know you very well and they knew something like that would happen. They have an option to move the turns. But only they can move them."

# game/scripts/c18/c18.rpy:826
translate english c18s001_Saira_80f41837:

    # mc "*Risa* Y todas vosotras confiáis de ellas para que los muevan sin hacer trampas, ¿no?"
    mc "*Laugh* And you all trust them to move them without cheating, don't you?"

# game/scripts/c18/c18.rpy:828
translate english c18s001_Saira_4534c409:

    # sai "También han pensado en eso. Nos llega una notificación a todas con los cambios. No pueden moverlos sin que nos enteremos."
    sai "They have also thought about it. We all get a notification on our phones about the changes. They can't move them without us knowing about it."

# game/scripts/c18/c18.rpy:829
translate english c18s001_Saira_1f7ef1eb:

    # sai "Así se fomenta la confianza, ¿no? *Risa*"
    sai "That's how you build trust, isn't it? *Laugh*"

# game/scripts/c18/c18.rpy:830
translate english c18s001_Saira_6ebc3eab:

    # mc "*Risa* Sois tremendas."
    mc "*Laugh* You girls are awesome."

# game/scripts/c18/c18.rpy:833
translate english c18s001_Saira_7e6135bc:

    # sai "Estoy pensando en que deberíamos montar algo parecido a esta app para saber cuándo podemos tener tiempo a solas contigo cada una de las chicas de tu harén. *Risa*"
    sai "I'm thinking we should set up something like this app, so we know when each of the girls in your harem can have alone time with you. *Laugh*"

# game/scripts/c18/c18.rpy:835
translate english c18s001_Saira_c7df6ada:

    # sai "Estoy pensando en pedirle que haga una adaptación de la app para saber cuándo estás libre para tener tiempo a solas contigo. *Risa*"
    sai "I'm thinking of asking her to make an adaptation of the app, so I know when you're free to have alone time with me. *Laugh*"

# game/scripts/c18/c18.rpy:837
translate english c18s001_Saira_f0d9c50c:

    # sai "Si hubiéramos vuelto a lo que teníamos en Portland, hubiese sido algo muy útil. Especialmente si estás con otras mujeres."
    sai "If we had gone back to what we had in Portland, it would have been a very useful thing. Especially if you're with other women."

# game/scripts/c18/c18.rpy:838
translate english c18s001_Saira_a60320f7:

    # mc "Sí, no hubiera estado mal tener algo así. *Risa*"
    mc "Yeah, it wouldn't have been bad to have something like that. *Laugh*"

# game/scripts/c18/c18.rpy:839
translate english c18s001_Saira_e5903d6d:

    # mc "Aunque habría que poner algún botón para imprevistos que me llenasen la agenda por un par de días porque nadie más quiere o puede resolverlos."
    mc "Although there should be some contingency button to fill my schedule for a couple of days, just in case something arises that no one else wants to or can solve."

# game/scripts/c18/c18.rpy:841
translate english c18s001_Saira_6ef7dc9d:

    # mc "*Risa* No creo que sea tan difícil tener tiempo a solas conmigo, ¿no?"
    mc "*Laugh* I don't think it's that hard to get alone time with me, is it?"

# game/scripts/c18/c18.rpy:843
translate english c18s001_Saira_7397e24e:

    # sai "¿Lo estás diciendo en serio? ¡Llevo cuatro días aquí y me están saliendo telarañas esperándote! *Risa*"
    sai "Are you serious? I've been here for four days and I'm getting cobwebs waiting for you! *Laugh*"

# game/scripts/c18/c18.rpy:844
translate english c18s001_Saira_d890795a:

    # mc "*Risa* Sabes que no hace falta que me esperes y que tú puedes tomar la iniciativa cuando quieras, ¿no?"
    mc "*Laugh* You know you don't have to wait for me and that you can take the initiative whenever you want, right?"

# game/scripts/c18/c18.rpy:845
translate english c18s001_Saira_af651527:

    # mc "No es que estemos en los 70 o en una película. Las chicas podéis decidir pasar a la acción y nadie os va a juzgar. *Risa*"
    mc "It's not like we're in the '70s or a movie. You girls can decide to take action, and no one is going to judge you. *Laugh*"

# game/scripts/c18/c18.rpy:846
translate english c18s001_Saira_29cab2db:

    # mc "Además, somos tú y yo. Nunca has estado esperando a que yo actuara."
    mc "Besides, it's you and me. You never waited for me to act before."

# game/scripts/c18/c18.rpy:848
translate english c18s001_Saira_ae40e5f5:

    # sai "Mmmm... Tienes razón. Lo pensaré... "
    sai "Mmmm... You're right. I'll think about it... "

# game/scripts/c18/c18.rpy:849
translate english c18s001_Saira_5b4dd07e:

    # mc "Una vez pase esta locura de fin de semana estaré mucho más libre. Al menos hasta que surja el siguiente problema que nadie más que yo pueda resolver. *Risa*"
    mc "Once we get through this crazy weekend, I'll have more free time. At least until the next problem arises that no one but me can solve. *Laugh*"

# game/scripts/c18/c18.rpy:851
translate english c18s001_Saira_a39cdc47:

    # sai "Te estamos exigiendo mucho entre todas, ¿no?"
    sai "We're all putting a lot of demands on you, aren't we?"

# game/scripts/c18/c18.rpy:852
translate english c18s001_Saira_b4d27d30:

    # mc "No, Saira. Eso es lo mejor de todo. No exigís nada. Lo hago todo porque me apetece y me siento a gusto haciéndolo por vosotras."
    mc "No, Saira. That's the best thing of all. You don't demand anything. I do it all because I feel like it, and I'm happy doing it for you."

# game/scripts/c18/c18.rpy:853
translate english c18s001_Saira_7df3672e:

    # mc "Pero sois un montón, y siempre hay una urgencia, a alguien a quien llevar a algún sitio, algo que comprar, o algo en lo que ayudar."
    mc "But there's a lot of you, and there's always an emergency, someone to take somewhere, something to buy, or something to help with."

# game/scripts/c18/c18.rpy:855
translate english c18s001_Saira_4d932e57:

    # sai "Sabes que casi todas tenemos carnet de conducir, ¿verdad? Las labores de taxista nos las podemos repartir entre nosotras y así tendrás más tiempo libre."
    sai "You know that almost all of us have driving licences, right? We can divide the taxi driver's duties between us and you'll have more free time."

# game/scripts/c18/c18.rpy:856
translate english c18s001_Saira_9a2f5a3b:

    # mc "Lo sé, pero si me pides que te lleve a algún sitio, lo voy a hacer. No te voy a decir \"toma las llaves del coche y ve tú sola\"."
    mc "I know, but if you ask me to take you somewhere, I'm going to do it. I'm not going to say \"take the car keys and go by yourself\"."

# game/scripts/c18/c18.rpy:858
translate english c18s001_Saira_dfb23f1f:

    # mc "Además, ya te digo que disfruto haciéndolo. Hacer cosas con y para vosotras es pasar tiempo con vosotras."
    mc "Besides, I'm telling you I enjoy doing it. Doing things with and for you is spending time with you."

# game/scripts/c18/c18.rpy:860
translate english c18s001_Saira_1b4c9e02:

    # "Suena un móvil en algún lugar."
    "A cell phone rings somewhere."

# game/scripts/c18/c18.rpy:862
translate english c18s001_Saira_32ad5170:

    # sai "Mi turno ha acabado. Te dejo en buenas manos."
    sai "My turn is over. I leave you in good hands."

# game/scripts/c18/c18.rpy:863
translate english c18s001_Saira_e202c819:

    # mc "*Risa* ¿Ves lo que te decía? Al final decidís mi agenda por mí."
    mc "*Laugh* See what I was saying? You guys finally decide my schedule for me."

# game/scripts/c18/c18.rpy:870
translate english c18s001_Erika_fa2c8d21:

    # eri "¿Bailas?"
    eri "Do you want to dance?"

# game/scripts/c18/c18.rpy:871
translate english c18s001_Erika_54ccd33d:

    # mc "Claro, es tu turno, ¿no? *Risa*"
    mc "Sure, it's your turn, isn't it? *Laugh*"

# game/scripts/c18/c18.rpy:873
translate english c18s001_Erika_400259f7:

    # eri "*Risa* Sí, ahora me toca a mí."
    eri "*Laugh* Yes, now it's my round."

# game/scripts/c18/c18.rpy:874
translate english c18s001_Erika_917019cb:

    # eri "¿Quién te lo ha dicho?"
    eri "Who told you?"

# game/scripts/c18/c18.rpy:875
translate english c18s001_Erika_164415bf:

    # mc "Se dice el pecado, pero no el pecador."
    mc "Are you saying I'm a snitch?"

# game/scripts/c18/c18.rpy:877
translate english c18s001_Erika_7a1bda8d:

    # eri "Tampoco importa. No es que lo quisiéramos guardar en secreto."
    eri "It doesn't matter either. It's not like we wanted to keep it a secret."

# game/scripts/c18/c18.rpy:878
translate english c18s001_Erika_450f1508:

    # eri "Pero ha sido una buena idea por parte de [dap] y Scarlett."
    eri "But it was a good idea on [dap] and Scarlett's side."

# game/scripts/c18/c18.rpy:879
translate english c18s001_Erika_00e0e961:

    # eri "Si te tenemos que compartir, mejor hacerlo de forma ordenada."
    eri "If we have to share you, better to do it in an orderly fashion."

# game/scripts/c18/c18.rpy:880
translate english c18s001_Erika_ef96eebc:

    # mc "Ha sido una buena idea, pero con fallos. ¿Qué pasaría si quiero bailar cuatro canciones seguidas contigo?"
    mc "It was a good idea, but flawed. What if I want to dance with you for four songs in a row?"

# game/scripts/c18/c18.rpy:882
translate english c18s001_Erika_2eb52358:

    # eri "*Risa* Me vería obligada a rechazarte durante el resto de la noche."
    eri "*Laugh* I would be forced to turn you down for the rest of the night."

# game/scripts/c18/c18.rpy:883
translate english c18s001_Erika_cb8060d2:

    # eri "Pero todas sabemos que no lo harás. No querrías que el resto de las chicas se sintieran mal."
    eri "But we all know you won't do it. You wouldn't want the rest of the girls to feel left out."

# game/scripts/c18/c18.rpy:884
translate english c18s001_Erika_f490b78b:

    # mc "¡Joder, [eri]! *Risa* Me conocéis demasiado bien."
    mc "Fuck, [eri]! *Laugh* You guys know me too well."

# game/scripts/c18/c18.rpy:886
translate english c18s001_Erika_6da28eef:

    # eri "No se lo digas a nadie, pero creo que mi hermana y Scarlett están haciendo un experimento social contigo. *Risa*"
    eri "Don't tell anyone, but I think my sister and Scarlett are doing a social experiment on you. *Laugh*"

# game/scripts/c18/c18.rpy:888
translate english c18s001_Erika_cf8c89f2:

    # eri "Bueno... mi hermana desde siempre... ahora tengo otra."
    eri "Well... my sister since forever... now I have a new one."

# game/scripts/c18/c18.rpy:889
translate english c18s001_Erika_d77c1542:

    # eri "Y Scarlett casi lo es también."
    eri "And Scarlett almost is as well."

# game/scripts/c18/c18.rpy:891
translate english c18s001_Erika_b5f98137:

    # mcp "(No vas desencaminada, pero creo que, como mucho, será prima)"
    mcp "(You're not off track, but I think it will be a cousin at best)"

# game/scripts/c18/c18.rpy:893
translate english c18s001_Erika_eb1f4371:

    # eri "Y el resto de las chicas... en un par de semanas nos vamos a empezar a llamar \"hermana\" las unas a las otras."
    eri "And the rest of the girls... in a couple of weeks we're going to start calling each other \"sis\"."

# game/scripts/c18/c18.rpy:894
translate english c18s001_Erika_a2e6cde6:

    # eri "Antes Kim estaba hablando con Tía Betty y con Kiara. Ya es normal que la llamen \"Tía Betty\", pero es que ha llamado a Kiara \"Tía Kiara\"."
    eri "Earlier Kim was talking to Aunt Betty and Kiara. It's normal to call her \"Aunt Betty\", we introduced her like that, but she called Kiara \"Aunt Kiara\"."

# game/scripts/c18/c18.rpy:895
translate english c18s001_Erika_043f8beb:

    # mc "¿Se nos está yendo de las manos?"
    mc "Is this getting out of hand?"

# game/scripts/c18/c18.rpy:897
translate english c18s001_Erika_821c56f5:

    # eri "No, justo lo contrario. Es fantástico. Cuando mi madre me dijo que íbamos a tener chicas en casa, nunca me podría haber imaginado esto."
    eri "No, just the opposite. It's fantastic. When my mother told me we were going to have girls at home, I could never have imagined this."

# game/scripts/c18/c18.rpy:899
translate english c18s001_Erika_e2977d0a:

    # eri "Si ese test sale positivo... Hope va a tener muchas más tías de lo que podría haber esperado."
    eri "If that test turns out positive... Hope is going to get a lot more aunts than I could have ever expected."

# game/scripts/c18/c18.rpy:900
translate english c18s001_Erika_514c80bf:

    # mc "Seguro que se pelean por cambiarle los pañales. *Risa* Y eso nos dejará tiempo libre para nosotros."
    mc "I'm sure they'll fight over changing her diapers. *Laugh* And that will leave free time for us."

# game/scripts/c18/c18.rpy:903
translate english c18s001_Erika_e127d7bd:

    # eri "Eso teniendo en cuenta que alguna de ellas tenga sus propios hijos."
    eri "That's taking into account that none of them have children of their own."

# game/scripts/c18/c18.rpy:904
translate english c18s001_Erika_036d1fa2:

    # mc "Entonces dejaremos que Meemaw cambie los pañales de todos. *Risa* Ya sabes que está pidiendo bisnietos."
    mc "Then we'll let Meemaw change everyone's diapers. *Laugh* You know she's begging for great-grandchildren."

# game/scripts/c18/c18.rpy:906
translate english c18s001_Erika_c5327877:

    # eri "Podemos usar la app de Scarlett para que se organicen los turnos de cambio pañales. *Risa*"
    eri "We can use Scarlett's app to get diaper changing shifts organized. *Laugh*"

# game/scripts/c18/c18.rpy:907
translate english c18s001_Erika_ac53c2f1:

    # mc "Meemaw va a querer cambiarlos todos. *Risa* Ya sabes que está pidiendo bisnietos."
    mc "Meemaw is going to want to change them all. *Laugh* You know she's begging for great-grandchildren."

# game/scripts/c18/c18.rpy:908
translate english c18s001_Erika_95703ae4:

    # mc "Si los pide, debe tomar responsabilidad sobre ellos."
    mc "If she asks for them, she must take responsibility for them."

# game/scripts/c18/c18.rpy:910
translate english c18s001_Erika_c3606cad:

    # eri "Solo de pensar que vamos a tener que decírselo... me da miedo cómo se lo va a tomar. Esté embarazada o no lo esté."
    eri "Just thinking that we're going to have to tell her... I'm afraid of how she's going to take it. Whether I'm pregnant or not."

# game/scripts/c18/c18.rpy:912
translate english c18s001_Erika_99c24a15:

    # mc "Ya sabe que estoy con tu madre. Ladró un poco, pero tuvo que aceptarlo."
    mc "She already knows I'm with your mother. She barked a little, but she had to accept it."

# game/scripts/c18/c18.rpy:914
translate english c18s001_Erika_5e6fedba:

