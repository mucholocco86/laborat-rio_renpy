translate english c24s004_Mad_Lis_Emm_bb28ec00:

    # mad "Siendo tan alta, las fotos quedarían geniales."
    mad "Being so tall, the pictures would look amazing."

# game/scripts/c24/c24.rpy:3047
translate english c24s004_Mad_Lis_Emm_05d04fb6:

