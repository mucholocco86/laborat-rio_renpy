# game/scripts/c24/c24.rpy:2888
translate english c24s004_Deb_Sim_fe762c04_1:

    # mc "*Risa* Podéis atacarme cuando queráis si la recompensa es esta."
    mc "*Laugh* You can attack me whenever you want if this is the reward."

# game/scripts/c24/c24.rpy:2890
translate english c24s004_Deb_Sim_0393a250:

