    mc "*Laugh* What was that for?"

# game/scripts/c24/c24.rpy:2875
translate english c24s004_Deb_Sim_9d5b35df:

    # sim "*Risa* Me estaba entrando tortícolis de mirar tan arriba."
    sim "*Laugh* I was getting a crick in my neck from looking up so much."

# game/scripts/c24/c24.rpy:2876
translate english c24s004_Deb_Sim_bab7afa5:

    # deb "*Risa* Y a ti te ha tocado un cuerpo poco ágil que no ha podido esquivar nuestros ataques."
    deb "*Laugh* And you have a not very agile body that couldn't dodge our attacks."
