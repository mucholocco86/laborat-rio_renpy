# game/scripts/c24/c24.rpy:1388
translate english c24s003_NoKia_479b95c0:

    # centered "{size=+20}{b}DÍA 26 – SÁBADO{/b}{/size}"
    centered "{size=+20}{b}DAY 26 – SATURDAY{/b}{/size}"

# game/scripts/c24/c24.rpy:1389
translate english c24s003_NoKia_7e47640e:

    # "Te levantas muy tarde, casi a mediodía. Debías estar más cansado de lo que creías."
    "You get up very late, almost at noon. You must have been more tired than you thought."

# game/scripts/c24/c24.rpy:1782
translate english c24s004_Eri_Dap_Kat_Nor_8e4c7523:

    # "Después de cenar, en la cocina de [nor]..."
    "After dinner, at [nor]'s kitchen..."

# game/scripts/c24/c24.rpy:1783
translate english c24s004_Eri_Dap_Kat_Nor_75401fcb:

    # nor "Estoy muy contenta por Tía [bet]. Era injusto..."
    nor "I'm really happy for Aunt [bet]. It was unfair..."

# game/scripts/c24/c24.rpy:1784
translate english c24s004_Eri_Dap_Kat_Nor_76f0a7ee:

    # eri "Estoy de acuerdo. Querían aprovecharse de lo que creían que era un momento de vulnerabilidad de la tía."
    eri "I agree. They wanted to take advantage of what they thought was a moment of vulnerability for Auntie."

# game/scripts/c24/c24.rpy:1785
translate english c24s004_Eri_Dap_Kat_Nor_b58475de:

    # dap "Pero no contaban con [mc]. *Risita*"
    dap "But they didn't count on [mc]. *Giggle*"

# game/scripts/c24/c24.rpy:1787
translate english c24s004_Eri_Dap_Kat_Nor_2aa59a1a:

    # nor "¿Tenéis algún plan para el fin de semana?"
    nor "Do you have any plans for the weekend?"

# game/scripts/c24/c24.rpy:1789
translate english c24s004_Eri_Dap_Kat_Nor_d1d3ee28:

    # dap "He quedado con [eva] para que me enseñe a disparar el domingo por la tarde. También vienen varias de las chicas."
    dap "I'm meeting [eva] on Sunday afternoon to learn how to shoot. Several of the girls are coming also."

# game/scripts/c24/c24.rpy:1791
translate english c24s004_Eri_Dap_Kat_Nor_f0f38756:

    # nor "¿Vas a ir tú también, [eri]?"
    nor "Are you going too, [eri]?"

# game/scripts/c24/c24.rpy:1793
translate english c24s004_Eri_Dap_Kat_Nor_121141d3:

    # eri "Me hubiera gustado ir. Ha alquilado un campo de tiro y podría haber estado bien, pero trabajo, con lo que quedaremos otro día."
    eri "I would have liked to. She rented a shooting range, and it could have been fun, but I'm working, so I'll do it another day."

# game/scripts/c24/c24.rpy:1794
translate english c24s004_Eri_Dap_Kat_Nor_e4a29f7f:

    # eri "Iremos al bosque, donde le enseñó a disparar a [mc]."
    eri "We'll go to the forest, where she taught [mc] how to shoot."

# game/scripts/c24/c24.rpy:1796
translate english c24s004_Eri_Dap_Kat_Nor_13a3344b:

    # nor "Ir con cuidado con las armas... No son juguetes."
    nor "Be careful with the guns... They're not toys."

# game/scripts/c24/c24.rpy:1798
translate english c24s004_Eri_Dap_Kat_Nor_7ab70709:

    # dap "Lo sabemos, Mamá. Creo que tú también deberías aprender a disparar."
    dap "We know, Mom. I think you should learn how to shoot too."

# game/scripts/c24/c24.rpy:1799
translate english c24s004_Eri_Dap_Kat_Nor_742d8287:

    # dap "Nunca puedes saber cuándo se repetirá otro secuestro, y creo que deberíamos tener armas en casa."
    dap "You never know when another kidnapping will happen, and I think we should have guns at home."

# game/scripts/c24/c24.rpy:1801
translate english c24s004_Eri_Dap_Kat_Nor_5fb4770a:

    # eri "Yo creo que no son necesarias, pese a lo bien que fue que [eva] tuviera una pistola escondida cuando pasó lo de Solomon."
    eri "I don't think they're needed, despite how useful it was that [eva] had a hidden gun when Solomon had his madness moment."

# game/scripts/c24/c24.rpy:1803
translate english c24s004_Eri_Dap_Kat_Nor_6c8ae9f0:

    # nor "Yo pienso lo mismo. Yo ya sé disparar pero, si hubiera intentado hacer lo que hizo [eva], lo más probable es que le hubiera dado en la mano a Solomon."
    nor "I think the same. I already know how to shoot but, if I had tried to do what [eva] did, it's most likely that I would have hit Solomon's hand."

# game/scripts/c24/c24.rpy:1804
translate english c24s004_Eri_Dap_Kat_Nor_ce7a280b:

    # nor "O incluso sería más probable que hubiera matado a una ardilla en el bosque al otro lado de la calle. *Risa*"
    nor "Or even more likely, I would have killed a squirrel in the woods across the street. *Laugh*"

# game/scripts/c24/c24.rpy:1806
translate english c24s004_Eri_Dap_Kat_Nor_1a092b52:

    # nor "[eva] y [ama] no van a ir a ningún sitio, con lo que creo que es mejor si son ellas las que se ocupan de las armas."
    nor "[eva] and [ama] aren't going anywhere, so I think it's better if they're the ones to take care of the weapons."

# game/scripts/c24/c24.rpy:1807
translate english c24s004_Eri_Dap_Kat_Nor_ad0b0264:

    # nor "Es bueno que aprendáis, pero no me gustaría tener armas en casa."
    nor "It's good for you to learn, but I wouldn't want to have firearms at home."

# game/scripts/c24/c24.rpy:1809
translate english c24s004_Eri_Dap_Kat_Nor_02763481:

    # eri "Aparte de las que tiene [eva] escondidas, ¿no? *Risa*"
    eri "Besides the ones [eva] is hiding around the house, right? *Laugh*"

# game/scripts/c24/c24.rpy:1810
translate english c24s004_Eri_Dap_Kat_Nor_fb5e8d29:

    # nor "*Risa* Exacto. Aparte de esas."
    nor "*Laugh* Exactly. Besides those."

# game/scripts/c24/c24.rpy:1811
translate english c24s004_Eri_Dap_Kat_Nor_7be2239a:

    # dap "Bueno, una vez nos enseñe a disparar, nos podría decir dónde están..."
    dap "Well, once she's taught us how to shoot, she could tell us where they are..."

# game/scripts/c24/c24.rpy:1812
translate english c24s004_Eri_Dap_Kat_Nor_7df8a7a2:

    # nor "*Risa* Entonces dejarían de estar escondidas. ¿Te imaginas a [emm] sabiendo dónde están las armas?"
    nor "*Laugh* Then they would stop being hidden. Can you imagine [emm] knowing where the guns are?"

# game/scripts/c24/c24.rpy:1814
translate english c24s004_Eri_Dap_Kat_Nor_b711c9e5:

    # kat "Hola, chicas. ¿De qué habláis?"
    kat "Hi, girls. What are you talking about?"

# game/scripts/c24/c24.rpy:1816
translate english c24s004_Eri_Dap_Kat_Nor_226c8906:

    # "Todas" "De armas."
    "All of them" "About guns."

# game/scripts/c24/c24.rpy:1818
translate english c24s004_Eri_Dap_Kat_Nor_7c813c76:

    # kat "¿Ah, de lo de [eva] el domingo? Va a ser divertido."
    kat "Oh, [eva]'s thing on Sunday? It's going to be fun."

# game/scripts/c24/c24.rpy:1819
translate english c24s004_Eri_Dap_Kat_Nor_2fc0434f:

    # kat "Al final [kim] también vendrá."
    kat "FYI, [kim] is also coming."

# game/scripts/c24/c24.rpy:1821
translate english c24s004_Eri_Dap_Kat_Nor_daefa916:

    # dap "*Risa* Yo que tú iría con cuidado si [kim] está armada cerca de ti."
    dap "*Laugh* If I were you, I'd be careful if [kim] is armed near you."

# game/scripts/c24/c24.rpy:1823
translate english c24s004_Eri_Dap_Kat_Nor_d8fca8c5:

    # kat "¿Por qué? Le he hecho un favor..."
    kat "Why? I've done her a favor..."

# game/scripts/c24/c24.rpy:1825
