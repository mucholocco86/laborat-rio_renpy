translate english c24s004_Mad_Lis_Emm_b1e4a5db:

    # lis "Estamos ayudando a [mad.nick] con sus diseños. A ver si podemos acabar hoy y así puede empezar con la costura."
    lis "We are helping [mad.nick] with her designs. Let's see if we can finish today so she can start sewing."

# game/scripts/c24/c24.rpy:2985
translate english c24s004_Mad_Lis_Emm_00469f9c:

