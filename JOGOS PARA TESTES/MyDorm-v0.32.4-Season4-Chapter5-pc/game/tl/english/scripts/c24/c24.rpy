# game/scripts/c24/c24.rpy:3065
translate english c24s004_Mad_Lis_Emm_c3e133e8:

    # mad "Para alguna de las fotos que tengo pensadas... ¿te importaría posar con [kim]?"
    mad "For some of the photos I have in mind... would you mind posing with [kim]?"

# game/scripts/c24/c24.rpy:3066
translate english c24s004_Mad_Lis_Emm_c128bb2e:

