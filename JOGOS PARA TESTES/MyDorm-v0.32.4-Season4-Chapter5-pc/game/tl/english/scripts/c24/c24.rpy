    # mc "Ha durado menos de lo que esperaba... pero ha valido la pena."
    mc "It lasted less than I expected... but it was worth it."

# game/scripts/c24/c24.rpy:2821
translate english c24s004_kiaOnFloor_4a613eab:

    # kia "Una experiencia nueva para los dos."
    kia "A new experience for both of us."

# game/scripts/c24/c24.rpy:2823
translate english c24s004_kiaOnFloor_2201430b:

    # kia "Ahora mismo estoy cachondísima. Hacer esto delante tuyo ha sido super caliente."
    kia "Right now, I'm so horny. Doing this in front of you has been super hot."

# game/scripts/c24/c24.rpy:2824
translate english c24s004_kiaOnFloor_b406bea8:

    # kia "Y veo que a ti también te ha puesto igual de cachondo. Mjolnir vuelve a estar enorme."
    kia "And I can see that it's made you just as horny. Mjolnir is hard again."

# game/scripts/c24/c24.rpy:2825
translate english c24s004_kiaOnFloor_d3071c47:

    # mc "*Risa* ¿Quieres el cuarto asalto? Te estás volviendo avariciosa..."
    mc "*Laugh* Do you want the fourth round? You're getting greedy..."

# game/scripts/c24/c24.rpy:2827
translate english c24s004_kiaOnFloor_9f1dbd4c:

    # kia "No creo que pudiera. Ahora quiero acabar de ducharme e ir a la cama a darnos abrazos antes de dormir."
    kia "I don't think I could. Now I want to finish showering and go to bed to cuddle before going to sleep."

# game/scripts/c24/c24.rpy:2828
translate english c24s004_kiaOnFloor_f5fd80b6:

    # mc "Me parece una idea estupenda. Déjame aclararme y te espero en la cama mientras acabas de ducharte."
    mc "I think it's a great idea. Let me get cleaned up and I'll wait for you in bed while you finish your shower."

# game/scripts/c24/c24.rpy:2830
translate english c24s004_kiaOnFloor_3935088c:

    # "Vuelves a la habitación después de aclararte y secarte. Esperas que [kia] termine la ducha mirando la chimenea."
    "You return to the room after washing and drying yourself. You wait for [kia] to finish her shower, looking at the fireplace."

# game/scripts/c24/c24.rpy:2834
translate english c24s004_Deb_Sim_f573cf4a:

    # "Después de comer, algunas de las chicas te preguntan si te vas a unir a ellas en la piscina."
    "After lunch, some of the girls ask you if you're going to join them in the pool."

# game/scripts/c24/c24.rpy:2835
translate english c24s004_Deb_Sim_0b862711:

    # "Subes a tu habitación a ponerte el bañador. Quieres relajarte un rato antes de la reunión con Iron Fist de la noche."
    "You go up to your room to put on your swimming trunks. You want to relax for a while before the Iron Fist meeting in the evening."

# game/scripts/c24/c24.rpy:2837
translate english c24s004_Deb_Sim_69ea716e:

    # "Cuando bajas a la piscina, encuentras a [deb.nick] y a [sim] charlando animadamente en el agua."
    "When you go downstairs to the pool, you find [deb.nick] and [sim] chatting animatedly in the pool."

# game/scripts/c24/c24.rpy:2839
translate english c24s004_Deb_Sim_9262c7af:

    # mc "¿Qué tal, chicas? ¿Cómo están las dos sirenas?"
    mc "What's up, girls? How are the two mermaids?"

# game/scripts/c24/c24.rpy:2840
translate english c24s004_Deb_Sim_b368d369:

    # sim "Genial. Después de ver a un montón de niños nadando esta mañana, tenía ganas de nadar un rato. Y no hay nadie mejor que [deb.nick] para hacerlo."
    sim "Great. After seeing a bunch of kids swimming this morning, I felt like going for a swim. And there's no one better than [deb.nick] to do it with."

# game/scripts/c24/c24.rpy:2841
translate english c24s004_Deb_Sim_e7d1088a:

    # deb "No exageres, [sim]."
    deb "Don't exaggerate, [sim]."

# game/scripts/c24/c24.rpy:2842
translate english c24s004_Deb_Sim_8db86fd1:

    # mc "¿Hacéis carreras entre vosotras?"
    mc "Did you race each other?"

# game/scripts/c24/c24.rpy:2844
translate english c24s004_Deb_Sim_a7c2f323:

    # sim "*Risa* ¡Qué va! [deb.nick] es demasiado buena para mí."
    sim "*Laugh* No way! [deb.nick] is too good for me."

# game/scripts/c24/c24.rpy:2845
translate english c24s004_Deb_Sim_4e273363:

    # sim "Hicimos una amistosa y no tuvo que esforzarse para darme una paliza."
    sim "We had a friendly race, and she didn't have to try hard to beat me."

# game/scripts/c24/c24.rpy:2847
translate english c24s004_Deb_Sim_74c39d65:

    # deb "No le hagas caso. Está exagerando y está desentrenada."
    deb "Don't listen to her. She's exaggerating and she's also just out of practice."

# game/scripts/c24/c24.rpy:2848
translate english c24s004_Deb_Sim_be167096:

    # mc "Bueno, lleva tiempo sin nadar. Es lógico."
    mc "Well, it's been a while since she swam competitively. It makes sense."

# game/scripts/c24/c24.rpy:2850
translate english c24s004_Deb_Sim_72045934:

    # sim "Llevo un año sin nadar en una competición y ni siquiera entonces llegué a los campeonatos nacionales."
    sim "It's been a year since I last swam in a competition and even then I didn't make it to the national championships."

# game/scripts/c24/c24.rpy:2851
translate english c24s004_Deb_Sim_0d68806d:

    # sim "Ella llegó y los ganó. Creo que la diferencia está clara, ¿no?"
    sim "She made it and won them. I think the difference is clear, don't you?"

# game/scripts/c24/c24.rpy:2853
translate english c24s004_Deb_Sim_164b1d20:

    # deb "Ya sabes por qué fue. No tienes el cuerpo adecuado para ser nadadora competitiva."
    deb "You know why that happened. You don't have the right body to be a competitive swimmer."

# game/scripts/c24/c24.rpy:2854
translate english c24s004_Deb_Sim_b60a4e8e:

    # deb "Te desarrollaste donde no me desarrollé yo, y eso te quita centésimas en cada brazada."
    deb "You developed where I didn't, and that takes hundredths off your time with every stroke."

# game/scripts/c24/c24.rpy:2856
translate english c24s004_Deb_Sim_abcd2cb9:

    # sim "A veces odio estas tetas..."
    sim "Sometimes I hate these boobs..."

# game/scripts/c24/c24.rpy:2858
translate english c24s004_Deb_Sim_2b71414e:

    # mc "A mí me encantan..."
    mc "I love them..."

# game/scripts/c24/c24.rpy:2861
translate english c24s004_Deb_Sim_cd85f167:

    # sim "También te encantan las de [deb.nick]. *Risa* Tu opinión es bienvenida, pero eres poco quisquilloso en cuanto a tetas."
    sim "You also love [deb.nick]’s. *Laugh* Your opinion is welcome, but you're not very picky when it comes to boobs."

# game/scripts/c24/c24.rpy:2862
translate english c24s004_Deb_Sim_a140637f:

    # mc "Tienes razón, ¿para qué negarlo? *Risa*"
    mc "You're right. Why deny it? *Laugh*"

# game/scripts/c24/c24.rpy:2863
translate english c24s004_Deb_Sim_9f4a647f:

