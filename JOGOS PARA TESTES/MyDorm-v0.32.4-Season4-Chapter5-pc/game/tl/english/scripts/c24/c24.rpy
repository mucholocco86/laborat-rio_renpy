translate english c24s004_Deb_Sim_4ea9139c:

    # mc "Te entiendo, pero no comparto tu decisión."
    mc "I understand you, but I don't agree with your decision."

# game/scripts/c24/c24.rpy:2907
translate english c24s004_Deb_Sim_2e41f7dc:

