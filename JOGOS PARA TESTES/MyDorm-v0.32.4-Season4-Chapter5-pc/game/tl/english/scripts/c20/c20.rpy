# game/scripts/c20/c20.rpy:2653
translate english c20s005_GivingMaddieARide_338ebfc4:

    # mc "Y la gente a la que le gusta la dominación también son normales. Con otros gustos, pero normales."
    mc "And people who like domination are normal too. With different tastes, but normal."

# game/scripts/c20/c20.rpy:2655
translate english c20s005_GivingMaddieARide_3f0c4ec5:

