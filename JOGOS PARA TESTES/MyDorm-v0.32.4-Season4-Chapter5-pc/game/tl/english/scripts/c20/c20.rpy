    thi "They went out of town this morning, to the East Woods. They haven't returned yet."

# game/scripts/c20/c20.rpy:229
translate english c20s001_Setup_a3af59c3:

    # thi "¿Vienes antes de que hagan daño a alguien?"
    thi "Are you coming before they hurt anyone?"

# game/scripts/c20/c20.rpy:231
translate english c20s001_Setup_24484333:

    # marziad "Sí, voy."
    marziad "Yes, on my way."

# game/scripts/c20/c20.rpy:232
translate english c20s001_Setup_da93f8e6:

