    mc "Open it. I'm starting to get nervous..."

# game/scripts/c16/c16.rpy:3414
translate english c16s007_NorPregnant_68e900c7:

    # nor "Después del resultado de [mar], tengo aún más miedo. ¿Y si el nuestro sale negativo también?"
    nor "After [mar]'s result, I'm even more afraid. What if ours turns out negative too?"

# game/scripts/c16/c16.rpy:3416
translate english c16s007_NorPregnant_ab2d4f3b:

    # nor "Después del resultado de [mar], tengo aún más miedo. ¿Y si el nuestro sale negativo?"
    nor "After [mar]'s result, I'm even more afraid. What if ours turns out negative?"

