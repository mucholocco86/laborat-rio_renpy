    mc "Tell me."

# game/scripts/c16/c16.rpy:2924
translate english c16s004_ConvoSairaAboutMegan_31b4d99c:

    # sai "La principal es que, de momento, no quiero que nadie sepa que estamos juntos."
    sai "The main thing is that, for the moment, I don't want anyone to know that we are together."

# game/scripts/c16/c16.rpy:2928
translate english c16s004_ConvoSairaAboutMegan_890a79e2:

