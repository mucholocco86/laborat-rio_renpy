# game/scripts/c16/c16.rpy:3380
translate english c16s007_NorPregnant_51094879:

    # mc "Creía que lo ibas a mantener en secreto unos días al menos..."
    mc "I thought you were going to keep it a secret at least for a few days..."

# game/scripts/c16/c16.rpy:3385
translate english c16s007_NorPregnant_b8ebee90:

