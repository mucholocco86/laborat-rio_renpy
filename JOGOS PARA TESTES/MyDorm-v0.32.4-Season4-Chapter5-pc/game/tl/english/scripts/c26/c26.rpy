    # "Las 7:30 en punto."
    "7:30 sharp."

# game/scripts/c26/c26.rpy:3132
translate english c26s006_KatBreakfast_2a33719d:

    # mc "*Risa* Ese lenguaje, señorita. En la piscina de mi madre no se dicen tacos. Se pueden enseñar las tetas, pero no decir tacos."
    mc "*Laugh* Watch your language, young lady. There's no swearing at my mother's swimming pool. You can show your tits, but not swear."

# game/scripts/c26/c26.rpy:3134
translate english c26s006_KatBreakfast_75511d85:

    # mc "*Risa* Ese lenguaje, señorita. En la piscina de [mar] no se dicen tacos. Se pueden enseñar las tetas, pero no decir tacos."
    mc "*Laugh* Watch your language, young lady. There's no swearing at [mar]'s swimming pool. You can show your tits, but not swear."

# game/scripts/c26/c26.rpy:3136
translate english c26s006_KatBreakfast_50ff5830:

    # kim "Os dejo solos. Disfrutad de vuestra cit... de vuestro desayuno. *Risa*"
    kim "I'll leave you alone. Enjoy your dat... your breakfast. *Chuckle*"

# game/scripts/c26/c26.rpy:3137
translate english c26s006_KatBreakfast_097aed10:

    # kat "*Grrrr*"
    kat "*Grrrr*"

# game/scripts/c26/c26.rpy:3138
translate english c26s006_KatBreakfast_8903df61:

    # mc "Gracias, [kim]."
    mc "Thanks, [kim]."

# game/scripts/c26/c26.rpy:3140
translate english c26s006_KatBreakfast_909cd86f:

    # kat "¿Desayunamos antes de que se enfríe?"
    kat "Shall we have breakfast before it gets cold?"

# game/scripts/c26/c26.rpy:3141
translate english c26s006_KatBreakfast_399ea7bb:

    # mc "Estás muy guapa, [kat]."
    mc "You look very pretty, [kat]."

# game/scripts/c26/c26.rpy:3143
translate english c26s006_KatBreakfast_e25357ba:

    # kat "¡No empieces con eso! No vas a conseguir ruborizarme."
    kat "Don't start with that! You're not going to make me blush."

# game/scripts/c26/c26.rpy:3144
translate english c26s006_KatBreakfast_9387efdf:

    # mc "*Risa* Pues es una lástima. Estás más guapa todavía cuando te ruborizas."
    mc "*Laugh* Well, that's a shame. You're even prettier when you blush."

# game/scripts/c26/c26.rpy:3146
translate english c26s006_KatBreakfast_adc489fc:

    # kat "¡Ya está! ¡Ya lo has conseguido! ¿Contento?"
    kat "That's it! You did it! Are you happy?"

# game/scripts/c26/c26.rpy:3147
translate english c26s006_KatBreakfast_18382e05:

    # mc "*Risa* Sí."
    mc "*Laugh* Yes."

# game/scripts/c26/c26.rpy:3149
translate english c26s006_KatBreakfast_a6021928:

    # kat "Pero gracias..."
    kat "But thank you..."

# game/scripts/c26/c26.rpy:3151
translate english c26s006_KatBreakfast_76c78675:

    # kat "Mira a ver si te gusta lo que hemos preparado para desayunar..."
    kat "See if you like what we've prepared for breakfast..."

# game/scripts/c26/c26.rpy:3153
translate english c26s006_KatBreakfast_59d93a1a:

    # kat "Tu bandeja es la de los huevos fritos."
    kat "Your tray is the one with the fried eggs."

# game/scripts/c26/c26.rpy:3154
translate english c26s006_KatBreakfast_69b9f1b7:

    # mc "¡[kat]! ¡Has hecho que [mar] haga demasiada comida!"
    mc "[kat]! You made [mar] cook too much food!"

# game/scripts/c26/c26.rpy:3156
translate english c26s006_KatBreakfast_d40ca763:

    # kat "¿[mar]? ¡Ella ha hecho los croissants! ¡El resto lo he hecho yo!"
    kat "[mar]? She made the croissants! I took care of the rest!"

# game/scripts/c26/c26.rpy:3157
translate english c26s006_KatBreakfast_b8f86014:

    # kat "No quería darle más trabajo del que tiene habitualmente porque tú y yo tengamos una... {i}(¡No digas cita, no digas cita!){/i} reunión para desayunar."
    kat "I didn't want to give her more work than she usually has because you and I have a... {i}(Don't say date, don't say date!){/i} meeting for breakfast."

# game/scripts/c26/c26.rpy:3158
translate english c26s006_KatBreakfast_0a5857e8:

    # kat "{i}(¡Ufff!){/i}"
    kat "{i}(Phew!){/i}"

# game/scripts/c26/c26.rpy:3160
translate english c26s006_KatBreakfast_9904656b:

    # kat "Aunque me ha ayudado con la masa de los gofres... Y diciéndome qué te gusta desayunar."
    kat "Although she helped me with the waffle batter... And by telling me what you like for breakfast."

# game/scripts/c26/c26.rpy:3161
translate english c26s006_KatBreakfast_d88cda53:

    # mc "Pues te has lucido. ¡Es un desayuno impresionante!"
    mc "Well, you've outdone yourself. That's an impressive breakfast!"

# game/scripts/c26/c26.rpy:3163
translate english c26s006_KatBreakfast_f6a38840:

    # mc "¿Nos sentamos?"
    mc "Shall we sit down?"

# game/scripts/c26/c26.rpy:3165
translate english c26s006_KatBreakfast_b1338a4f:

    # kat "Hemos quedado en que no es una cita, [mc]. No hace falta que me apartes la silla."
    kat "We agreed that it's not a date, [mc]. You don't have to pull out my chair."

# game/scripts/c26/c26.rpy:3166
translate english c26s006_KatBreakfast_27dae548:

    # mc "Es lo menos que puedo hacer viendo el trabajo que te has tomado."
    mc "It's the least I can do considering all the work you've put in."

# game/scripts/c26/c26.rpy:3167
translate english c26s006_KatBreakfast_c4fe07ab:

    # mc "Puedes sentarte o nos podemos quedar aquí de pie. No pienso soltar la silla."
    mc "You can sit down, or we can stay standing here. I'm not letting go of the chair."

# game/scripts/c26/c26.rpy:3169
translate english c26s006_KatBreakfast_dacb0b21:

    # kat "Gracias..."
    kat "Thanks..."

# game/scripts/c26/c26.rpy:3170
translate english c26s006_KatBreakfast_c5f43237:

    # mc "Gracias a ti por este desayuno fantástico."
    mc "Thank you for this amazing breakfast."

# game/scripts/c26/c26.rpy:3171
translate english c26s006_KatBreakfast_c383f707:

    # mc "Aunque te tengo que informar de que no estaré aquí para Acción de Gracias. Estaré en Aruba."
    mc "Although I have to let you know that I won't be here for Thanksgiving. I'll be in Aruba."

# game/scripts/c26/c26.rpy:3173
translate english c26s006_KatBreakfast_dbd04ad3:

    # kat "Lo sé, pero no entiendo a qué te refieres."
    kat "I know, but I don't understand what you mean."

# game/scripts/c26/c26.rpy:3174
translate english c26s006_KatBreakfast_cb8eebf4:

    # mc "No hace falta que me cebes como a un pavo. *Risa*"
    mc "No need to fatten me up like a turkey. *Laugh*"

# game/scripts/c26/c26.rpy:3176
translate english c26s006_KatBreakfast_d5e8f347:

    # kat "*Risa* ¿He hecho demasiada comida?"
    kat "*Laugh* Did I prepare too much food?"

# game/scripts/c26/c26.rpy:3177
translate english c26s006_KatBreakfast_4e025963:

    # mc "A menos que se nos vayan a unir un par de personas más, sí."
    mc "Unless a couple more people are joining us, yes."

# game/scripts/c26/c26.rpy:3178
translate english c26s006_KatBreakfast_2aba5e81:

    # mc "Has hecho demasiada comida para mí y veo poca para ti."
    mc "You've made too much food for me, and I don't see much for you."

# game/scripts/c26/c26.rpy:3180
translate english c26s006_KatBreakfast_3aeb0d7b:

    # kat "Me he levantado sin hambre... [mar] me ha convencido de que me pusiera más comida de la que me iba a poner."
    kat "I woke up not feeling hungry... {i}(Fucking nerves){/i} [mar] convinced me to put more food on my tray than I was going to eat."

# game/scripts/c26/c26.rpy:3182
translate english c26s006_KatBreakfast_e4be509f:

    # kat "Además, me convencisteis para que comiera más sano. Fruta, huevo duro... Aún no me he acostumbrado del todo."
    kat "What's more, you convinced me to eat healthier. Fruit, hard-boiled eggs... I'm still not quite used to it yet."

# game/scripts/c26/c26.rpy:3184
translate english c26s006_KatBreakfast_8067a82e:

    # kat "Aunque miro a tus gofres y me dan ganas de robártelos. *Risa*"
    kat "Although I look at your waffles and I want to steal them from you. *Laugh*"

# game/scripts/c26/c26.rpy:3185
translate english c26s006_KatBreakfast_fb191d7f:

    # mc "Podemos compartirlos. Yo no me voy a acabar toda esta comida."
    mc "We can share them. I'm not going to finish all this food."

# game/scripts/c26/c26.rpy:3186
translate english c26s006_KatBreakfast_0787713c:

    # kat "Mejor no. *Risa* No sé si podría parar si empiezo a robarte comida ¿Empezamos antes de que se enfríe?"
    kat "Better not. *Laugh* I don't know if I could stop if I started stealing your food. Shall we start before it gets cold?"

# game/scripts/c26/c26.rpy:3187
translate english c26s006_KatBreakfast_a1dd7856:

    # mc "Empecemos."
    mc "Let's get started."

# game/scripts/c26/c26.rpy:3189
translate english c26s006_KatBreakfast_e4d0d423:

    # mc "El bacon está en su punto. Felicidades."
    mc "The bacon is cooked to perfection. Congratulations."

# game/scripts/c26/c26.rpy:3190
translate english c26s006_KatBreakfast_4d487cdb:

    # kat "Gracias. [mar] me ha dicho el punto en el que te gusta."
    kat "Thanks. [mar] told me how you like it."

# game/scripts/c26/c26.rpy:3191
translate english c26s006_KatBreakfast_4bd1c26e:

    # mc "¿Te han hecho muchas bromas sobre la no-cita?"
    mc "Have you been teased a lot about the no-date?"

# game/scripts/c26/c26.rpy:3193
translate english c26s006_KatBreakfast_d21b6771:

    # kat "*Risa* Llevan dos días con las bromas. Les comenté {b}que me había equivocado de palabra{/b} delante de [meg]."
    kat "*Laugh* They've been joking about it for two days. I told them {b}that I used the wrong word{/b} in front of [meg]."

# game/scripts/c26/c26.rpy:3194
translate english c26s006_KatBreakfast_c63270a9:

    # kat "Esa chica es un hueso duro de roer y tiene una mente rápida para las bromas."
    kat "That girl is a tough nut to crack and has a quick wit for jokes."

# game/scripts/c26/c26.rpy:3195
translate english c26s006_KatBreakfast_6b6c24e3:

    # mc "Lo sé. Creo que es la única que ha conseguido dejar callado a Jamaal."
    mc "I know. I think she's the only one who's ever managed to shut Jamaal up."

# game/scripts/c26/c26.rpy:3197
translate english c26s006_KatBreakfast_7d0160f0:

    # kat "Jamaal también es rápido, pero [meg] lo es más."
    kat "Jamaal is also quick, but [meg] is quicker."

# game/scripts/c26/c26.rpy:3198
translate english c26s006_KatBreakfast_aa6e25e2:

    # kat "A partir de que ella hizo la primera broma, el resto no han parado. Se han puesto un poco pesadas."
    kat "Ever since she made the first joke, the rest haven't stopped. They've gotten a little annoying."

# game/scripts/c26/c26.rpy:3199
translate english c26s006_KatBreakfast_42202a68:

    # mc "Y eso que ellas no te tenían que devolver la broma de las belugas..."
    mc "And that's even though they didn't have to get revenge for the beluga joke..."

# game/scripts/c26/c26.rpy:3201
translate english c26s006_KatBreakfast_86a3ce4c:

    # kat "*Risa* Bueno, creo que la mayoría de ellas tenía alguna broma guardada que devolverme..."
    kat "*Laugh* Well, I think most of them had some joke they wanted to get back at me for..."

# game/scripts/c26/c26.rpy:3202
translate english c26s006_KatBreakfast_e9c2fb56:

    # kat "Pero se han aliado las 21 contra mí. *Risa* Ni siquiera yo puedo contra eso. ¡Incluso [ama] me hizo una broma!"
    kat "But all 21 of them have ganged up on me. *Laugh* Even I can't fight that. Even the always serious [ama] played a joke on me!"

# game/scripts/c26/c26.rpy:3203
translate english c26s006_KatBreakfast_dc8ba32a:

    # mc "Da gusto ver lo bien que os lleváis. Incluso con [lis]. No lo hubiera pensado el día que llegasteis."
    mc "It's nice to see how well you get along with everyone. Even with [lis]. I wouldn't have thought so the day you arrived."

# game/scripts/c26/c26.rpy:3205
translate english c26s006_KatBreakfast_2ff687d5:

    # kat "Las dos teníamos un concepto equivocado de la otra. Nunca nos hubiéramos hecho amigas en un dormitorio normal."
    kat "We both had the wrong idea about each other. We would never have become friends in a normal dorm room."

# game/scripts/c26/c26.rpy:3206
translate english c26s006_KatBreakfast_a4231144:

    # kat "Ya sabes, la reina del gallinero y esas cosas. [lis] hubiera luchado por la posición y yo la hubiera intentado sabotear."
    kat "You know, the queen of the henhouse and all that. [lis] would have fought for the position and I would have tried to sabotage her."

# game/scripts/c26/c26.rpy:3207
translate english c26s006_KatBreakfast_59337bf2:

    # kat "Aquí es diferente. Las reinas del gallinero son [mar] y [nor], con lo que [lis] y yo no tenemos conflictos."
    kat "Here it's different. The queens of the henhouse are [mar] and [nor], so [lis] and I don't have any conflicts."

# game/scripts/c26/c26.rpy:3208
translate english c26s006_KatBreakfast_11370a26:

    # mc "Anoche parecíais casi amigas."
    mc "Last night you seemed almost like friends."

# game/scripts/c26/c26.rpy:3210
translate english c26s006_KatBreakfast_4eaffdac:

    # kat "El 'casi' es la parte importante de esa frase. Nos llevamos bien, pero no creo que ninguna elija a la otra como la madrina de sus hijos."
    kat "The 'almost' is the important part in that sentence. We get along well, but I don't think either of us would choose the other as a godmother for our children."

# game/scripts/c26/c26.rpy:3211
translate english c26s006_KatBreakfast_d77a8335:

    # mc "Ser amigas no significa ser las mejores amigas, [kat]."
    mc "Being friends doesn't mean being best friends, [kat]."

# game/scripts/c26/c26.rpy:3212
translate english c26s006_KatBreakfast_4a824095:

    # mc "Yo tenía amigos en Portland, pero el padrino de mis hijos será Jamaal. Solo puede haber un padrino, pero muchos amigos."
    mc "I had friends in Portland, but Jamaal will be my children's godfather. There can only be one godfather per kid, but many friends."

# game/scripts/c26/c26.rpy:3214
translate english c26s006_KatBreakfast_1dde2415:

    # kat "Visto así... Creo que tienes razón. Posiblemente seamos amigas ahora."
    kat "Looking at it that way... I think you're right. We might be friends now."

# game/scripts/c26/c26.rpy:3215
translate english c26s006_KatBreakfast_3540cdd2:

    # kat "Aunque en nuestras respectivas listas la otra esté en el puesto 21, si solo contamos a las chicas de la familia, claro."
    kat "Although, in our respective lists, the other one is in 21st place, if we only count the girls in the family, of course."

# game/scripts/c26/c26.rpy:3216
translate english c26s006_KatBreakfast_a231af6c:

    # mc "Es un paso muy importante. Hace tres semanas no hubierais estado en la lista de la otra."
    mc "It's a very important step. Three weeks ago, you wouldn't have even been on each other's list."

# game/scripts/c26/c26.rpy:3218
translate english c26s006_KatBreakfast_f9c933bc:

    # kat "Pero sólo estamos hablando de mí..."
    kat "But we're only talking about me..."

# game/scripts/c26/c26.rpy:3219
translate english c26s006_KatBreakfast_ff1295b4:

    # mc "*Risa* No estamos hablando de ti. Estás hablando de las otras chicas y cómo te llevas con ellas."
    mc "*Laugh* We're not talking about you. You're talking about the other girls and how you get along with them."

# game/scripts/c26/c26.rpy:3220
translate english c26s006_KatBreakfast_de0077c0:

    # mc "En cinco minutos has nombrado a [meg], [mar], [nor], [ama], y [lis]. Incluso a Jamaal."
    mc "In five minutes you've mentioned [meg], [mar], [nor], [ama], and [lis]. Even Jamaal."

# game/scripts/c26/c26.rpy:3222
translate english c26s006_KatBreakfast_3c782462:

    # kat "*Risa* ¡A Jamaal lo has metido tú en la conversación, no yo! Yo sólo he respondido."
    kat "*Laugh* You brought Jamaal into the conversation, not me! I was just answering."

# game/scripts/c26/c26.rpy:3223
translate english c26s006_KatBreakfast_f4061ca2:

    # mc "*Risa* Bueno, no recuerdo exactamente cómo ha sido. Pero lo importante es que no estás hablando de ti."
    mc "*Laugh* Well, I don't remember exactly how it was. But the important thing is that you're not talking about yourself."

# game/scripts/c26/c26.rpy:3225
translate english c26s006_KatBreakfast_41383d91:

    # kat "Pero habíamos quedado para desayunar y hablar de las chicas mientras hacían yoga. No para hablar de mí."
    kat "But we had planned to have breakfast to discuss the girls during their yoga session. Not to discuss me."

# game/scripts/c26/c26.rpy:3226
translate english c26s006_KatBreakfast_b254339c:

    # mc "Pero cómo no hay chicas haciendo yoga, los planes pueden cambiar."
    mc "But since there are no girls doing yoga, plans have changed."

# game/scripts/c26/c26.rpy:3227
translate english c26s006_KatBreakfast_e4d89fdf:

    # mc "Cuéntame algo sobre ti."
    mc "Tell me something about yourself."

# game/scripts/c26/c26.rpy:3229
translate english c26s006_KatBreakfast_3e16595c:

    # kat "*Risa* ¿Entrevista estándar? Soy de Pittsburgh y tengo dos hermanos. Kevin es actor, o lo intenta, y vive en Los Angeles."
    kat "*Laugh* Standard interview? I'm from Pittsburgh and I have two brothers. Kevin is an actor, or at least he tries to be, and he lives in Los Angeles."

# game/scripts/c26/c26.rpy:3230
translate english c26s006_KatBreakfast_37d02084:

    # kat "Randall es agente de comercio y vive en 'Burgh. Mi madre sigue viva, Randall vive con ella, pero mi padre murió en un incendio."
    kat "Randall is a sales agent and lives in The 'Burgh. My mother is still alive, Randall lives with her, but my father died in a fire."

# game/scripts/c26/c26.rpy:3231
translate english c26s006_KatBreakfast_9e70af18:

    # mc "[kat], te cuesta hablar de ti, ¿verdad? Antes, en vez de hablar de ti hablabas de las chicas. Ahora hablas de tu familia."
    mc "[kat], it's hard for you to talk about yourself, isn't it? A moment ago, instead of talking about yourself, you talked about the girls. Now you're talking about your family."

# game/scripts/c26/c26.rpy:3233
translate english c26s006_KatBreakfast_83083d42:

    # kat "Es que no sé qué puede interesarte sobre mí. Lo más interesante que me había pasado antes de llegar aquí ya te lo conté."
    kat "I just don't know what you might find interesting about me. I already told you the most interesting thing that happened to me before I got here."

# game/scripts/c26/c26.rpy:3234
translate english c26s006_KatBreakfast_e9b36589:

    # kat "Y no fue agradable. No me refiero a contártelo, sino a vivirlo. Ya sabes, el chico aquel..."
    kat "And it wasn't pleasant. I don't mean telling you about it, but experiencing it. You know, that guy..."

# game/scripts/c26/c26.rpy:3235
translate english c26s006_KatBreakfast_67c204bd:

    # mc "Estoy seguro de que tienes mil cosas interesantes que contar. ¿Por qué estudias Oceanografía?"
    mc "I'm sure you have a thousand interesting things to tell me. Why are you studying Oceanography?"

# game/scripts/c26/c26.rpy:3236
translate english c26s006_KatBreakfast_7cdf25ee:

    # mc "Y no me digas que es porque consideras a las ballenas y a las focas tus primas."
    mc "And don't tell me it's because you consider whales and seals your cousins."

# game/scripts/c26/c26.rpy:3238
translate english c26s006_KatBreakfast_fb383ec7:

    # kat "*Risa* ¡Esa ha sido buena! ¡Serías buena competencia para...! Vale, no voy a nombrar a la cantante otra vez."
    kat "*Laugh* That's a good one! You'd be a good rival for...! Okay, I'm not going to name that singer again."

# game/scripts/c26/c26.rpy:3240
translate english c26s006_KatBreakfast_5edeed90:

    # kat "Pero ya he perdido ocho libras desde que empecé a comer más sano, con lo que mis primas me van a echar de la familia. *Risa*"
    kat "But I've already lost eight pounds since I started eating healthier, so my cousins are going to kick me out of the family. *Laugh*"

# game/scripts/c26/c26.rpy:3242
translate english c26s006_KatBreakfast_8a6cc9ee:

    # kat "Me gusta el mar. Tengo un buen recuerdo de cuando fuimos con mis padres un par de años antes de que mi padre muriera."
    kat "I like the sea. I have fond memories of when we went with my parents a couple of years before my father died."

# game/scripts/c26/c26.rpy:3243
translate english c26s006_KatBreakfast_d00dd15b:

    # kat "Como no me apetecía trabajar en una plataforma petrolífera ni ser pescadora, decidí estudiar oceanografía."
    kat "Since I didn't want to work on an oil rig or be a fisherwoman, I decided to study oceanography."

# game/scripts/c26/c26.rpy:3244
translate english c26s006_KatBreakfast_2b6e0bb5:

    # mc "¿Ves cómo hay historias interesantes?"
    mc "See, you do have interesting stories."

# game/scripts/c26/c26.rpy:3246
translate english c26s006_KatBreakfast_d274cfc7:

    # kat "¿Y tú? ¿Por qué estudiaste Administración de Empresas?"
    kat "And you? Why did you study Business Administration?"

# game/scripts/c26/c26.rpy:3247
translate english c26s006_KatBreakfast_209d7c85:

    # mc "*Risa* Lo mío es mucho menos emotivo. Quería ganar mucho dinero y no tener un trabajo físico. Administración de Empresas cumplía los requisitos."
    mc "*Laugh* Mine is much less emotional. I wanted to make a lot of money and not have a physical job. Business Administration fit the bill."

# game/scripts/c26/c26.rpy:3249
translate english c26s006_KatBreakfast_f7c31845:

    # kat "Una buena razón. Y justo cuando acabas la carrera heredas una empresa millonaria y tienes más dinero del que podrás gastar en tu vida."
    kat "A good reason. And just when you finish your degree, you inherit a multimillion-dollar company and have more money than you could ever spend in your lifetime."

# game/scripts/c26/c26.rpy:3250
translate english c26s006_KatBreakfast_4d810566:

    # mc "Pero alguien tiene que administrar esa empresa. *Risa* Al final haré lo que quería hacer, pero trabajando para mí, para la empresa familiar."
    mc "But someone has to run that company. *Laugh* In the end, I'll do what I wanted to do, but by working for myself and for the family business."

# game/scripts/c26/c26.rpy:3251
translate english c26s006_KatBreakfast_c617e901:

    # mc "En el fondo es lo que elegí hacer cuando vine aquí. Tenía ofertas de trabajo, pero trabajar con [mar] y [nor] me apetecía más."
    mc "Deep down, that's what I chose to do when I came here. I had job offers, but working with [mar] and [nor] appealed more to me."

# game/scripts/c26/c26.rpy:3252
translate english c26s006_KatBreakfast_695af772:

    # mc "Podrías decir que soy un tipo familiar."
    mc "You could say I'm a family man."

# game/scripts/c26/c26.rpy:3254
translate english c26s006_KatBreakfast_e97a969e:

    # kat "¿No te da miedo? Yo estaría histérica. Ir a un país nuevo, a una empresa que no conozco, donde la mayoría de la gente son asesinos entrenados..."
    kat "Aren't you scared? I'd be hysterical. Going to a new country, to a company I don't know, where most of the people are trained killing machines..."

# game/scripts/c26/c26.rpy:3255
translate english c26s006_KatBreakfast_9b28632f:

    # kat "A una empresa donde ha habido facciones literalmente matándose entre ellos. Estaría cruzando los dedos para que nadie decidiera asesinarme."
    kat "To a company where there have been factions literally killing each other. I would be crossing my fingers that no one decided to assassinate me."

# game/scripts/c26/c26.rpy:3256
translate english c26s006_KatBreakfast_80d93cba:

    # mc "Bueno, [ama] y [eva] van a estar conmigo allí. Además, el tema de las facciones está más o menos resuelto."
    mc "Well, [ama] and [eva] will be with me. Besides, the issue with the factions has been more or less settled."

# game/scripts/c26/c26.rpy:3257
translate english c26s006_KatBreakfast_33d228de:

    # mc " Y Aaron, uno de los primeros clones, me está enviando muchísima información. No voy a ir a ciegas ni a estar en riesgo. Es un reto nuevo, pero no uno que me asuste."
    mc "And Aaron, one of the first clones, is sending me a lot of information. I'm not going in blind or taking any risks. It's a new challenge, but not one that scares me."

# game/scripts/c26/c26.rpy:3258
translate english c26s006_KatBreakfast_aae21db7:

    # mc "*Risa* Aunque conociendo a [eva] y a [ama], seguro que me hacen hacer mucho trabajo físico."
    mc "*Laugh* Although, knowing [eva] and [ama], I'm sure they'll make me do a lot of physical work there."

# game/scripts/c26/c26.rpy:3259
translate english c26s006_KatBreakfast_951d3d89:

    # mc "Y otra vez has desviado la atención de ti."
    mc "And once again, you diverted attention away from yourself."

# game/scripts/c26/c26.rpy:3261
translate english c26s006_KatBreakfast_a3757967:

    # kat "Es posible que a ti te interese que yo hable de mí, pero a mí me interesa que tú hables de ti. *Risa* Tenemos un conflicto de intereses."
    kat "You may be interested in me talking about myself, but I'm interested in you talking about yourself. *Laugh* We have a conflict of interest."

# game/scripts/c26/c26.rpy:3262
translate english c26s006_KatBreakfast_7ef3a5eb:

    # mc "Tenemos suerte de que esto no sea una primera cita. *Risa* Sería una conversación rarísima en la que ninguno querría hablar de sí mismo."
    mc "We're lucky this isn't a first date. *Laugh* It would be a really weird conversation where neither of us would want to talk about ourselves."

# game/scripts/c26/c26.rpy:3263
translate english c26s006_KatBreakfast_fb8265df:

    # kat "*Risa* ¡Tienes razón! Hablaríamos del menú, del camarero, del tiempo... pero no hablaríamos de nosotros."
    kat "*Laugh* You're right! We would talk about the menu, the waiter, the weather... but we wouldn't talk about ourselves."

# game/scripts/c26/c26.rpy:3264
translate english c26s006_KatBreakfast_2e07868a:

    # mc "Bueno, creo que de nosotros, sí que hablaríamos. No cada uno de sí mismo, sino de nosotros como pareja."
    mc "Well, I think we would talk about ourselves. Not about ourselves individually, but about us as a couple."

# game/scripts/c26/c26.rpy:3266
translate english c26s006_KatBreakfast_b1c29bde:

    # kat "No te entiendo."
    kat "I don't get it."

# game/scripts/c26/c26.rpy:3267
translate english c26s006_KatBreakfast_e1ad2df6:

    # mc "Tú querrías saber si quiero tener hijos, por ejemplo. Pero querrías saberlo para saber si mi respuesta es la misma que darías tú si te lo preguntara yo."
    mc "You would want to know if I want to have children, for example. But you would want to know so that you could compare my answer to the one you would give if I asked you the same question."

# game/scripts/c26/c26.rpy:3268
translate english c26s006_KatBreakfast_312829d9:

    # mc "No serían preguntas al azar, sino que serían preguntas para saber si lo nuestro puede funcionar."
    mc "The questions wouldn't be random, but rather questions to find out if our relationship could work."

# game/scripts/c26/c26.rpy:3270
translate english c26s006_KatBreakfast_58137ea2:

    # kat "*Risa* Creo que has tenido más primeras citas que yo. No creo que haya tenido una primera cita al uso, de esas que sirven para conocerse."
    kat "*Laugh* I think you've been on more first dates than I have. I don't think I've ever been on a typical first date, the kind where you get to know each other."

# game/scripts/c26/c26.rpy:3271
translate english c26s006_KatBreakfast_619ea128:

    # kat "Cuando tenía una cita, solía ser con chicas con las que ya había tenido algo..."
    kat "When I had a date, it was usually with girls I had already had something with..."

# game/scripts/c26/c26.rpy:3272
translate english c26s006_KatBreakfast_efa57e36:

    # mc "Bueno, pero estamos empatados en no-citas, ¿no? Esta es mi primera no-cita."
    mc "Well, but we're tied in no-dates, right? This is my first no-date."

# game/scripts/c26/c26.rpy:3273
translate english c26s006_KatBreakfast_121c43e1:

    # kat "*Risa* ¿Vas a volver con ese tema?"
    kat "*Laugh* Are you going to bring that up again?"

# game/scripts/c26/c26.rpy:3274
translate english c26s006_KatBreakfast_b66d93c3:

    # mc "Tengo que intentar que te ruborices de nuevo. Estás monísima cuando lo haces."
    mc "I have to try to make you blush again. You look so cute when you do."

# game/scripts/c26/c26.rpy:3276
translate english c26s006_KatBreakfast_6e58ab54:

    # kat "*Risita* Pues creo que lo acabas de conseguir. ¡Odio ruborizarme! ¡Parezco un personaje de anime!"
    kat "*Giggle* Well, I think you just did that. I hate blushing! I look like an anime character!"

# game/scripts/c26/c26.rpy:3277
translate english c26s006_KatBreakfast_db133ed6:

    # mc "Nota mental: Decirle que está monísima la ruboriza."
    mc "Mental note: Telling her she's cute makes her blush."

# game/scripts/c26/c26.rpy:3279
translate english c26s006_KatBreakfast_58dbe1cd:

    # kat "*Risa* ¡[mc]! ¡Para o tendré que robarte gofres!"
    kat "*Laugh* [mc]! Stop it, or I'll have to steal your waffles!"

# game/scripts/c26/c26.rpy:3280
translate english c26s006_KatBreakfast_ce415e78:

    # mc "¿Qué tienen que ver los gofres en esto?"
    mc "What do waffles have to do with this?"

# game/scripts/c26/c26.rpy:3282
translate english c26s006_KatBreakfast_c03d0f62:

    # kat "Cuando me pongo nerviosa, como. Cuanto más dulce mejor."
    kat "When I get nervous, I eat. The sweeter, the better. Or I don't eat at all."

# game/scripts/c26/c26.rpy:3283
translate english c26s006_KatBreakfast_4f04f5f2:

    # kat "Y algo como ruborizarme, sobre lo que no tengo ningún control, me pone nerviosa."
    kat "And something like blushing, which I have no control over, makes me nervous."

# game/scripts/c26/c26.rpy:3284
translate english c26s006_KatBreakfast_494160cc:

    # mc "Vale, entonces dejaré de hacerlo. Al menos por hoy."
    mc "Okay, then I'll stop doing it. At least for today."

# game/scripts/c26/c26.rpy:3286
translate english c26s006_KatBreakfast_f10cf259:

    # kat "Gracias. Eres todo un caballero."
    kat "Thank you. You're a real gentleman."

# game/scripts/c26/c26.rpy:3287
translate english c26s006_KatBreakfast_55befe6c:

    # mc "Tendré que esperar a que no haya comida cerca para decirte que estás monísima. *Risa*"
    mc "I'll have to wait until there's no food around to tell you how cute you are. *Laugh*"

# game/scripts/c26/c26.rpy:3289
translate english c26s006_KatBreakfast_29092183:

    # kat "¡Eres un capullo! *Risa* ¡Retiro lo de caballero!"
    kat "You're a jerk! *Laugh* I take back the gentleman part!"

# game/scripts/c26/c26.rpy:3290
translate english c26s006_KatBreakfast_f1f79118:

    # mc "Sólo bromeaba. Pese a que ahora tengo el contraataque perfecto para tus bromas, intentaré no usarlo demasiado."
    mc "I was just kidding. Even though I now have the perfect comeback for your jokes, I'll try not to use it too much."

# game/scripts/c26/c26.rpy:3292
translate english c26s006_KatBreakfast_a79ab05c:

    # kat "¿Por si me vuelvo inmune? ¡Visto lo visto, no creo que pase!"
    kat "In case I become immune? Given what I've seen, I don't think that will happen!"

# game/scripts/c26/c26.rpy:3293
translate english c26s006_KatBreakfast_196e4b31:

    # mc "No, [kat]. Porque parece incomodarte y ponerte nerviosa."
    mc "No, [kat]. Because it seems to make you uncomfortable and nervous."

# game/scripts/c26/c26.rpy:3294
translate english c26s006_KatBreakfast_c268070a:

    # mc "Si vamos a tener más no-citas para desayunar, no quiero que tengas miedo de sentirte incómoda."
    mc "If we're going to have more no-dates for breakfast, I don't want you to be afraid of feeling uncomfortable."

# game/scripts/c26/c26.rpy:3296
translate english c26s006_KatBreakfast_81e0de3b:

    # kat "¡Por Dios, [mc]! ¿Puedes dejar de hacerme ruborizar de una puta vez?"
    kat "For God's sake, [mc]! Can you stop making me blush so fucking much?"

# game/scripts/c26/c26.rpy:3297
translate english c26s006_KatBreakfast_ecedbe45:

    # mc "¿Qué he hecho ahora? Precisamente he dicho que no quiero que te sientas incómoda..."
    mc "What have I done now? I just said I didn't want you to feel uncomfortable..."

# game/scripts/c26/c26.rpy:3298
translate english c26s006_KatBreakfast_d5232afb:

    # kat "¡Precisamente eso! ¿Por qué tienes que preocuparte por mí?"
    kat "Just that! Why do you have to worry about me?"

# game/scripts/c26/c26.rpy:3313
translate english c26s006_KatBreakfast_4d632618:

    # mc "Toma un poco de gofre."
    mc "Here, have a piece of waffle."

# game/scripts/c26/c26.rpy:3315
translate english c26s006_KatBreakfast_a6ef33fe:

    # kat "Mmmmm... ¡Me han quedado buenísimos!"
    kat "Mmmmm... They turned out great!"

# game/scripts/c26/c26.rpy:3316
translate english c26s006_KatBreakfast_1e0bcec0:

    # mc "¿Estás mejor?"
    mc "Are you feeling better?"

# game/scripts/c26/c26.rpy:3318
translate english c26s006_KatBreakfast_0b1b8e04:

    # kat "Sí. Perdona por lo de..."
    kat "Yes. Sorry about..."

# game/scripts/c26/c26.rpy:3319
translate english c26s006_KatBreakfast_d1465d4c:

    # mc "¿Lo de... qué?"
    mc "About... what?"

# game/scripts/c26/c26.rpy:3321
translate english c26s006_KatBreakfast_bda43590:

    # mc "¿Qué pasa, [kat]?"
    mc "What's happening, [kat]?"

# game/scripts/c26/c26.rpy:3323
translate english c26s006_KatBreakfast_8698aa7e:

    # kat "¿Me acabas de dar de comer en la boca?"
    kat "Did you just feed me?"

# game/scripts/c26/c26.rpy:3324
translate english c26s006_KatBreakfast_c0e4ceff:

    # mc "Sí... creía que necesitabas un trozo de gofre. Te estabas poniendo un poco... irracional..."
    mc "Yes... I thought you needed a piece of waffle. You were getting a little... irrational..."

# game/scripts/c26/c26.rpy:3326
translate english c26s006_KatBreakfast_e1afdb5a:

    # kat "¡Joder, [mc]! ¡No soy tu novia! ¡No puedes hacer esas cosas!"
    kat "Damn it, [mc]! I'm not your girlfriend! You can't do that!"

# game/scripts/c26/c26.rpy:3327
translate english c26s006_KatBreakfast_10069e8a:

    # mc "Perdona... no quería que pareciera algo así..."
    mc "Sorry... I didn't mean it to come across like that..."

# game/scripts/c26/c26.rpy:3330
translate english c26s006_KatBreakfast_f43d88af:

    # mc "Porque me caes bien, [kat]. Y quiero que estés relajada cuando estés conmigo, no que estés nerviosa esperando cuándo voy a hacer que te ruborices."
    mc "Because I like you, [kat]. And I want you to be relaxed when you're with me, not be nervous waiting for me to make you blush."

# game/scripts/c26/c26.rpy:3331
translate english c26s006_KatBreakfast_5fd41252:

    # mc "Si vas a estar incómoda, pese a que no me guste, deberíamos dejar de tener estas no-citas."
    mc "If you're going to be uncomfortable, even though I don't like the idea, we should stop having these no-dates."

# game/scripts/c26/c26.rpy:3333
translate english c26s006_KatBreakfast_f3e8e220:

    # kat "¡Joder! ¡No sé por qué coño dije cita!"
    kat "Damn it! I don't know why the hell I said 'date'!"

# game/scripts/c26/c26.rpy:3336
translate english c26s006_KatBreakfast_3bfcbca3:

    # kat "¡Hemos dicho que esto no era una puta cita!"
    kat "We said this wasn't a fucking date!"

# game/scripts/c26/c26.rpy:3337
translate english c26s006_KatBreakfast_015eb319:

    # kat "¡No tienes por qué comportarte como si fueras mi puto novio ni preocuparte por mí!"
    kat "You don't have to act like you're my fucking boyfriend or worry about me!"

# game/scripts/c26/c26.rpy:3338
translate english c26s006_KatBreakfast_c98dd182:

    # mc "¡[kat]!"
    mc "[kat]!"

# game/scripts/c26/c26.rpy:3339
translate english c26s006_KatBreakfast_b82dc00d:

    # "Desaparece tras la esquina."
    "She disappears around the corner."

# game/scripts/c26/c26.rpy:3340
translate english c26s006_KatBreakfast_2a077204:

    # "Si algo te ha enseñado crecer rodeado de mujeres es que no es el momento de seguirla."
    "If growing up surrounded by women has taught you anything, it's that now is not the time to follow her."

# game/scripts/c26/c26.rpy:3341
translate english c26s006_KatBreakfast_58d18a2d:

    # "Cuando se le pase el disgusto que no entiendes qué has hecho para provocar, ya habrá tiempo de hablar."
    "When she gets over being upset, and you don't understand what you did to provoke her, there will be time to talk."

# game/scripts/c26/c26.rpy:3342
translate english c26s006_KatBreakfast_7fac7a03:

    # mcp "(Quizás he ido demasiado lejos con lo de ruborizarla. Soy idiota. A veces no sé cuándo parar con una broma.)"
    mcp "(Maybe I went too far with making her blush. I'm an idiot. Sometimes I don't know when to stop with a joke.)"

# game/scripts/c26/c26.rpy:3344
translate english c26s006_KatBreakfast_a9172c33:

    # "Recoges los restos del desayuno y los subes a la cocina."
    "You pick up the breakfast leftovers and take them to the kitchen."

# game/scripts/c26/c26.rpy:3345
translate english c26s006_KatBreakfast_c5cf82d1:

    # "De alguna forma, el resto de las chicas con las que te cruzas saben que algo ha salido mal."
    "Somehow, the other girls you come across know that something has gone wrong."

# game/scripts/c26/c26.rpy:3346
translate english c26s006_KatBreakfast_23c8d43f:

    # "Ninguna te pregunta por la no-cita."
    "None of them asks you about the no-date."

# game/scripts/c26/c26.rpy:3347
translate english c26s006_KatBreakfast_0ba34238:

    # "Supones que han visto a [kat] subir a su habitación con cara de pocos amigos."
    "You assume they saw [kat] go up to her room looking rather upset."

# game/scripts/c26/c26.rpy:3348
translate english c26s006_KatBreakfast_1de81d9e:

    # "Vas a tu habitación y pasas una par de horas leyendo unos correos de Aaron sobre la empresa."
    "You go to your room and spend an hour reading some emails from Aaron about the company."

# game/scripts/c26/c26.rpy:3351
translate english c26s006_KatBreakfast_54ecfdcb:

    # "Mientras recoges el desayuno, en la cocina de [nor]..."
    "While you're picking up the breakfast leftovers, in [nor]'s kitchen..."

# game/scripts/c26/c26.rpy:3353
translate english c26s006_KatBreakfast_b3d98258:

    # nor "¿Qué pasa, [kat]?"
    nor "What's wrong, [kat]?"

# game/scripts/c26/c26.rpy:3354
translate english c26s006_KatBreakfast_6c40f3f3:

    # nor "¿Ha ido mal la cita?"
    nor "Did the date go badly?"

# game/scripts/c26/c26.rpy:3355
translate english c26s006_KatBreakfast_e33bd1de:

    # kat "*Sollozo* ¡No era una puta cita!"
    kat "*Sob* It wasn't a fucking date!"

# game/scripts/c26/c26.rpy:3356
translate english c26s006_KatBreakfast_95f13893:

    # nor "¿Entonces dime qué te pasa? Pareces molesta. ¿Qué ha ido mal?"
    nor "So, tell me what's bothering you. You seem upset. What went wrong?"

# game/scripts/c26/c26.rpy:3358
translate english c26s006_KatBreakfast_39f7cb52:

    # kat "¿Por qué me tiene que tratar como si fuera una chica normal?"
    kat "Why does he have to treat me like a normal girl?"

# game/scripts/c26/c26.rpy:3359
translate english c26s006_KatBreakfast_9e5da404:

    # kat "Creo que me estoy enamorando..."
    kat "I think I'm falling in love..."

# game/scripts/c26/c26.rpy:3365
translate english c26s007_Bet_dd0461ef:

    # "*Knock-Knock*"
    "*Knock-Knock*"

# game/scripts/c26/c26.rpy:3366
translate english c26s007_Bet_7e4c68d2:

    # "Tu lectura de la documentación de NTR se ve interrumpida por unos golpes en la puerta."
    "Your reading of the NTR documentation is interrupted by someone knocking at your door."

# game/scripts/c26/c26.rpy:3367
translate english c26s007_Bet_e9f141de:

    # "Lo agradeces. Parece que, mires donde mires, hay un exceso de NTR en el mundo."
    "You appreciate it. It seems like, everywhere you look, there's an excess of NTR in the world."

# game/scripts/c26/c26.rpy:3368
translate english c26s007_Bet_7d0384af:

    # bet "*A través de la puerta* Soy yo, ¿puedo pasar?"
    bet "*Through the door* It's me, can I come in?"

# game/scripts/c26/c26.rpy:3369
translate english c26s007_Bet_2b0b1100:

    # mc "Adelante."
    mc "Yes, come in."

# game/scripts/c26/c26.rpy:3371
translate english c26s007_Bet_d2de998c:

    # bet "¡[mc]! ¡Ya no soy monja! ¡Oficialmente! Acabo de recibir un correo electrónico del Obispado. Y también la transferencia bancaria."
    bet "[mc]! I'm not a nun anymore! Officially! I just got an email from the Bishopric. And the bank transfer too."

# game/scripts/c26/c26.rpy:3372
translate english c26s007_Bet_876c0a63:

    # mc "¡Eso son grandes noticias! ¡Dame un abrazo!"
    mc "That's great news! Give me a hug!"

# game/scripts/c26/c26.rpy:3374
translate english c26s007_Bet_d7c6a786:

    # bet "Gracias, [mc]. No lo hubiera conseguido sin ti. O al menos, no lo hubiera conseguido en estas condiciones."
    bet "Thanks, [mc]. I couldn't have done it without you. Or at least, I couldn't have done it under these conditions."

# game/scripts/c26/c26.rpy:3375
translate english c26s007_Bet_5ec7e275:

    # mc "La decisión fue tuya. Yo solo negocié el dinero. Y eso es mucho menos importante que sentirte libre."
    mc "The choice was yours. I just negotiated the money. And that's much less important than feeling free."

# game/scripts/c26/c26.rpy:3377
translate english c26s007_Bet_dbbeb1b6:

    # bet "Nos va a venir muy bien. [eri] me ha hecho una propuesta..."
    bet "This will be very useful. [eri] made me a proposal..."

# game/scripts/c26/c26.rpy:3378
translate english c26s007_Bet_6e97b541:

    # mc "Lo sé, me lo ha explicado. ¿Qué le ha parecido a Meemaw?"
    mc "I know, she explained it to me. What did Meemaw think?"

# game/scripts/c26/c26.rpy:3380
translate english c26s007_Bet_b6eb2e36:

    # bet "Aún no se lo he dicho. Aprovecharé el viaje de mañana para comentárselo. Creo que, si es posible, le parecerá bien."
    bet "I haven't told her yet. I'll take advantage of tomorrow's trip to mention it to her. I think she'll be fine with it, if it's possible to do it."

# game/scripts/c26/c26.rpy:3381
translate english c26s007_Bet_6a9fbad4:

    # mc "¿Viaje? ¿Mañana?"
    mc "A trip? Tomorrow?"

# game/scripts/c26/c26.rpy:3383
translate english c26s007_Bet_4ca312d8:

    # bet "¿No te acuerdas? Vamos a Florida, a poner la casa en venta."
    bet "Don't you remember? We're going to Florida to put [mee]'s house up for sale."

# game/scripts/c26/c26.rpy:3384
translate english c26s007_Bet_25f2bc46:

    # mc "No sabía que era mañana. Creía que iba a ir Meemaw una vez yo estuviera en Aruba."
    mc "I didn't know it was tomorrow. I thought Meemaw was going to go once I was in Aruba."

# game/scripts/c26/c26.rpy:3385
translate english c26s007_Bet_862f884e:

    # bet "Ese era el plan inicial, pero lo hemos adelantado y yo voy a acompañarla para ayudarle a empaquetar las cosas."
    bet "That was the initial plan, but we've moved it up, and I'm going to go with her to help her pack."

# game/scripts/c26/c26.rpy:3386
translate english c26s007_Bet_e258c28e:

    # mc "¿Cuánto tiempo vais a estar allí? ¿Os veré antes de irme a Aruba?"
    mc "How long are you going to be there? Will I see you before I leave for Aruba?"

# game/scripts/c26/c26.rpy:3388
translate english c26s007_Bet_e84ee525:

    # bet "No lo sabemos, pero no te preocupes, si no hemos acabado para cuando te vayas, vendremos aquí a despedirte."
    bet "I don't know, but don't worry, if we haven't finished by the time you leave, we'll come here to say goodbye."

# game/scripts/c26/c26.rpy:3389
translate english c26s007_Bet_31d7e23e:

    # mc "Te veo ilusionada, entre lo del final de tu relación con la iglesia y lo de la casa, estás exultante."
    mc "You look excited. Between the end of your relationship with the church and the house, you're elated."

# game/scripts/c26/c26.rpy:3391
translate english c26s007_Bet_b3626312:

    # bet "No es para menos. Hace menos de una semana mis opciones eran irme a Latinoamérica a un convento o meterme en un convento de clausura."
    bet "Not surprising. Less than a week ago, my options were to go to Latin America to a convent or join a cloistered convent."

# game/scripts/c26/c26.rpy:3392
translate english c26s007_Bet_1d50b572:

    # bet "Ahora voy a vivir al lado de mi familia para siempre. Si esos terrenos están en venta y se puede construir en ellos, claro."
    bet "Now I'm going to live next door to my family forever. If those plots are for sale and we can build on them, of course."

# game/scripts/c26/c26.rpy:3393
translate english c26s007_Bet_d209aa05:

    # mc "Creo que Meemaw es la que más sabe de eso, con lo que es la persona idónea para hacerlo."
    mc "I think Meemaw knows the most about that, so she's the best person to do it."

# game/scripts/c26/c26.rpy:3394
translate english c26s007_Bet_b5092d4e:

    # mc "Además, a las estudiantes de casa de [nor] les queda más de un mes para llegar."
    mc "In addition, the students staying at [nor]'s house won't be arriving for another month."

# game/scripts/c26/c26.rpy:3396
translate english c26s007_Bet_8195cfc9:

    # bet "Sí, pero no tengo ni idea de cuánto tiempo tardarán la venta, los permisos de construcción, la construcción en sí misma..."
    bet "Yes, but I have no idea how long the sale, building permits, and construction itself will take..."

# game/scripts/c26/c26.rpy:3397
translate english c26s007_Bet_d9c544a0:

    # bet "Es un mundo del que no sé nada, pero es imposible que todo esté listo antes de que lleguen las chicas nuevas."
    bet "It's a world I know nothing about, but there's no way everything will be ready before the new girls arrive."

# game/scripts/c26/c26.rpy:3398
translate english c26s007_Bet_0d8be9ec:

    # mc "Deberíais alquilar algo durante ese periodo. O usar mi habitación."
    mc "You should rent something during that time. Or use my room."

# game/scripts/c26/c26.rpy:3400
translate english c26s007_Bet_f2c789f4:

    # bet "Lo he pensado. [mee] puede dormir con [nor] y yo con [mar]. [kia] y [eil] pueden usar tu habitación mientras tú estés en Aruba..."
    bet "I've thought about it. [mee] can sleep with [nor] and I'll sleep with [mar]. [kia] and [eil] can use your room while you're in Aruba..."

# game/scripts/c26/c26.rpy:3401
translate english c26s007_Bet_ee7c4f23:

    # mc "*Risa* Las cuatro podríais dormir en mi habitación si quisierais. Hoy llega la cama nueva. No es anti gatos, pero hay espacio para cuatro personas."
    mc "*Laugh* The four of you could sleep in my room if you wanted to when the new bed arrives. It's not cat-proof, but there's room for four people."

# game/scripts/c26/c26.rpy:3402
translate english c26s007_Bet_f2272200:

    # mc "Y [eri] y [emm] aún tienen sus habitaciones para ellas solas. Si es necesario, podrían compartir una y quedaría una habitación libre."
    mc "And [eri] and [emm] still have their own rooms. If needed, they could share one, and there would still be a spare room."

# game/scripts/c26/c26.rpy:3404
translate english c26s007_Bet_3fd3204b:

    # bet "Hay muchas opciones, pero ninguna servirá de nada si no convenzo a [mee] o si no se puede construir en esos terrenos."
    bet "There are many options, but none of them will be of any use if I cannot convince [mee], or if it is not possible to build on that plot of land."

# game/scripts/c26/c26.rpy:3405
translate english c26s007_Bet_df389955:

    # mc "Estoy seguro de que lo descubriréis antes de que lleguen las nuevas estudiantes, no te preocupes por ello."
    mc "I'm sure you'll find out before the new students arrive, don't worry about it."

# game/scripts/c26/c26.rpy:3406
translate english c26s007_Bet_5fb5ea1b:

    # mc "¿Sabes algo sobre tu recertificación?"
    mc "Do you know anything about your recertification?"

# game/scripts/c26/c26.rpy:3408
translate english c26s007_Bet_4ee32a1d:

    # bet "Lo estuve mirando por internet. No es demasiado complicado y lo podría tener resuelto a finales de septiembre o principios de octubre como muy pronto."
    bet "I looked it up online. It's not too complicated, and I could have it sorted by the end of September or early October at the earliest."

# game/scripts/c26/c26.rpy:3409
translate english c26s007_Bet_16db17d0:

    # bet "Una vez recertificada, podría empezar a buscar trabajo. ¡Podría estar trabajando antes de acabar el año!"
    bet "Once recertified, I could start looking for work. I could be working before the end of the year!"

# game/scripts/c26/c26.rpy:3410
translate english c26s007_Bet_3d23c2ea:

    # mc "Esa es una noticia increíble. Sé que te hace mucha ilusión volver a trabajar."
    mc "That's amazing news. I know you're really excited to get back to work."

# game/scripts/c26/c26.rpy:3412
translate english c26s007_Bet_057bf677:

    # bet "Todo eso si es que apruebo la recertificación, claro. Pero no parece difícil."
    bet "That's if I pass the recertification, of course. But it doesn't look too challenging."

# game/scripts/c26/c26.rpy:3413
translate english c26s007_Bet_74bd754c:

    # mc "Me alegro. Si lo hubieras visto muy difícil, había pensado en darte trabajo en NTR, si se necesitan médicos allí."
    mc "I'm glad to hear it. If you thought it would be too difficult, I had thought about offering you a job at NTR, if they need surgeons there."

# game/scripts/c26/c26.rpy:3414
translate english c26s007_Bet_0f23b341:

    # mc "Incluso había pensado, cuando salimos de la primera reunión en Monterey, en contratarte y que NTR pagara la certificación si no nos daban lo que pedíamos."
    mc "I had even thought, after we left the first meeting in Monterey, about hiring you and having NTR pay for the certification if they didn't give us what we asked for."

# game/scripts/c26/c26.rpy:3415
translate english c26s007_Bet_b6a638ae:

    # mc "*Risa* ¡No llevo ni un mes como CEO y ya estoy pensando en usar el nepotismo para contratar a mi tía abuela!"
    mc "*Laugh* I haven't even been CEO for a month and I'm already thinking about using nepotism to hire my great-aunt!"

# game/scripts/c26/c26.rpy:3417
translate english c26s007_Bet_101cbe2e:

    # bet "*Risa* Esa mentalidad corrupta te iría muy bien en algunos sitios en los que he trabajado."
    bet "*Laugh* That corrupt mentality would serve you well in some places I've worked."

# game/scripts/c26/c26.rpy:3418
translate english c26s007_Bet_71756d90:

    # mc "Creo que para el negocio de NTR una mentalidad que no siga las normas al 100\% puede ser buena, pero intentaré usarla sólo cuando sea necesario."
    mc "I think that, for NTR's business, a mindset that doesn't follow the rules 100\% can be good, but I'll try to use it only when absolutely necessary."

# game/scripts/c26/c26.rpy:3420
translate english c26s007_Bet_c1ea551c:

    # bet "Por cierto, ¿cuándo llega tu cama? Yo he dormido muchas veces en el suelo, pero no sé si tú estás acostumbrado."
    bet "By the way, when is your bed arriving? I've slept on the floor many times, but I don't know if you're used to it."

# game/scripts/c26/c26.rpy:3421
translate english c26s007_Bet_ecf08426:

    # mc "Llega en una hora o así. Me han llamado para confirmar la entrega hace un rato."
    mc "It'll be here in an hour or so. They called to confirm the delivery a little while ago."

# game/scripts/c26/c26.rpy:3422
translate english c26s007_Bet_4a149387:

    # mc "No he notado nada por dormir en el suelo. El colchón es bueno. Lo voy a echar de menos."
    mc "I didn't notice anything bad about sleeping on the floor. The mattress is good. I'm going to miss it."

# game/scripts/c26/c26.rpy:3424
translate english c26s007_Bet_5131ee0f:

    # bet "¿Necesitas ayuda para retirar el colchón o algo?"
    bet "Do you need help taking out the mattress or anything else?"

# game/scripts/c26/c26.rpy:3425
translate english c26s007_Bet_bbf32eae:

    # mc "No, gracias. El colchón lo voy a dejar en el gimnasio por ahora. Y el resto se va a quedar como está."
    mc "No, thank you. I'm going to leave the mattress at the gym for now. And the rest will stay as it is."

# game/scripts/c26/c26.rpy:3426
translate english c26s007_Bet_fc33460c:

    # mc "Seguramente acabe bajándolo al sótano. A lo mejor a [emm] le va bien para el estudio de fotografía."
    mc "I'll probably end up moving it down to the basement. Maybe [emm] could use it for her photography studio."

# game/scripts/c26/c26.rpy:3427
translate english c26s007_Bet_55c9428f:

    # mc "Quizás mueva un poco el sofá depende cómo quede la habitación con la cama montada, pero eso lo puedo hacer yo."
    mc "I might move the couch a little, depending on how the room looks with the bed assembled, but I can do that myself."

# game/scripts/c26/c26.rpy:3429
translate english c26s007_Bet_6e175db4:

    # bet "Entonces te voy a dejar y voy a ir a hacer la maleta."
    bet "Then I'll leave you and go pack my suitcase."

# game/scripts/c26/c26.rpy:3430
translate english c26s007_Bet_b5dc51e7:

    # mc "¿Necesitaréis que os lleve al aeropuerto mañana?"
    mc "Will you need a ride to the airport tomorrow?"

# game/scripts/c26/c26.rpy:3432
translate english c26s007_Bet_b670f072:

    # bet "No hace falta. [nor] se ha ofrecido a llevarnos. Hace unos días que [mee] y ella se han vuelto casi inseparables."
    bet "No need. [nor] has offered to take us. For the past few days, [mee] and she have become almost inseparable."

# game/scripts/c26/c26.rpy:3433
translate english c26s007_Bet_2f02ca8e:

    # mc "Me alegra mucho que haya pasado eso. [nor] estaba muy tensa los días antes de que llegarais."
    mc "I'm so glad that happened. [nor] was very anxious the days before you arrived."

# game/scripts/c26/c26.rpy:3435
translate english c26s007_Bet_d9dfbd01:

    # bet "*Risa* Yo también lo hubiera estado. [mee] puede ser un poco bruja a veces. Especialmente con [nor]."
    bet "*Laugh* I would have been too. [mee] can be a bit of a bitch sometimes. Especially with [nor]."

# game/scripts/c26/c26.rpy:3436
translate english c26s007_Bet_1ea8b3e5:

    # bet "Pero eso parece que forma parte del pasado, al menos hasta que encuentre una nueva víctima."
    bet "But that seems to be a thing of the past, at least until she finds a new victim."

# game/scripts/c26/c26.rpy:3440
translate english c26s007_Bet_82c399db:

    # bet "Bueno, me voy ya o, si no, no voy a hacer la maleta nunca."
    bet "Well, I'm leaving now, or else I'll never get my packing done."

# game/scripts/c26/c26.rpy:3442
translate english c26s007_Bet_0eb93267:

    # mc "Te veo luego, [bet]."
    mc "See you later, [bet]."

# game/scripts/c26/c26.rpy:3444
translate english c26s007_Bet_9f881016:

    # mc "Te veo luego, Tía [bet]."
    mc "See you later, Aunt [bet]."

# game/scripts/c26/c26.rpy:3451
translate english c26s007_Bed_e77cc028:

    # "El transportista de la cama llega un par de horas antes de tu cita con [deb.nick]. Te asegura que habrá acabado antes de que tengas que ir a buscarla."
    "The bed delivery guys arrive a couple of hours before your appointment with [deb.nick]. They assure you that they will be finished before you have to go and pick her up."

# game/scripts/c26/c26.rpy:3453
translate english c26s007_Bed_1faeb4c5:

    # "El transportista de la cama llega un par de horas antes de la hora de comer. Te asegura que habrá acabado antes de que tengas que la comida esté preparada."
    "The bed delivery guys arrive a couple of hours before lunchtime. They assure you that they'll be done before lunch is ready."

# game/scripts/c26/c26.rpy:3454
translate english c26s007_Bed_5e2b4f70:

    # "Eso es antes de ver las escaleras por las que tendrán que subir la cama."
    "That's before seeing the stairs they'll have to carry the bed up."

# game/scripts/c26/c26.rpy:3455
translate english c26s007_Bed_2cead7cd:

    # "Una vez han subido las cajas con las piezas de la cama y el colchón, empiezan a montarlo todo tras mover los muebles que les molestan."
    "Once the boxes containing the bed parts and the mattress have been brought upstairs, they begin to assemble everything after moving any furniture that is in the way."

# game/scripts/c26/c26.rpy:3456
translate english c26s007_Bed_60e48ea3:

    # "Te quedas en el descansillo, por si los montadores necesitan alguna cosa. Aceptan que les subas una jarra de agua fría."
    "You stay on the landing in case they need anything. They ask if you can bring them a jug of cold water."

# game/scripts/c26/c26.rpy:3458
translate english c26s007_Bed_9e41e546:

    # "Las mujeres de la casa no tardan en empezar a subir para ver el nuevo mueble."
    "The women in the house quickly start coming upstairs to see the new piece of furniture."

# game/scripts/c26/c26.rpy:3459
translate english c26s007_Bed_35320bbc:

    # mom "Deberías haberla centrado con la cortina. Así queda rara."
    mom "You should have centered it with the blinds. It looks weird like that."

# game/scripts/c26/c26.rpy:3460
translate english c26s007_Bed_f8cc4a36:

    # mc "Si la centro con la cortina, quedaría demasiado pegada al sofá y no se podría usar. Tengo que pegar el sofá al escritorio para que siga siendo útil."
    mc "If I centered it with the blinds, it would be too close to the couch, and it couldn't be used. I'll have to push the couch up against the desk so I can still sit on it."

# game/scripts/c26/c26.rpy:3462
translate english c26s007_Bed_b8a0e365:

    # mom "Es una buena razón, pero no me acaba de gustar. No queda simétrica dentro de la habitación."
    mom "That's a good reason, but I don't really like it. It doesn't look symmetrical inside the room."

# game/scripts/c26/c26.rpy:3463
translate english c26s007_Bed_3a3f6368:

    # mc "¿Crees que importará mucho para los abrazos familiares que no esté simétrica?"
    mc "Do you think it will matter much for the family hugs that it's not symmetrical?"

# game/scripts/c26/c26.rpy:3465
translate english c26s007_Bed_bb4960a1:

    # mom "*Risa* No, no importará. Y creo que ahí cabremos unas cuantas más."
    mom "*Laugh* No, it won't matter. And I think there's room for a few more."

# game/scripts/c26/c26.rpy:3466
translate english c26s007_Bed_12d1e4d0:

    # mc "Tengo que comprar una trampa anti gatos, para evitar que vuelva a romperse."
    mc "I have to buy a cat trap to prevent Zeus from breaking my bed again."

# game/scripts/c26/c26.rpy:3468
translate english c26s007_Bed_12bd3430:

    # mom "Bueno, te voy a dejar con los chicos. Voy a seguir haciendo la comida."
    mom "Well, I'll leave you with the guys. I'm going to get back to cooking."

# game/scripts/c26/c26.rpy:3469
translate english c26s007_Bed_fc61d62c:

    # mc "Perfecto. Puedes pasar a verla acabada después de comer."
    mc "Perfect. You can come and see it when it's finished after lunch."

# game/scripts/c26/c26.rpy:3471
translate english c26s007_Bed_78f925bc:

    # mom "Lo haré, no te preocupes. Y criticaré tu elección de colores para la ropa de cama. *Risa*"
    mom "I will, don't worry. And I'll criticize your choice of sheet colors. *Laugh*"

# game/scripts/c26/c26.rpy:3473
translate english c26s007_Bed_bc25da9e:

    # emm "¿He oído que Mamá va a criticar tu elección de colores? ¿Has elegido algo rosa? Mamá tiene mal gusto para los colores, ya lo sabes."
    emm "Did I hear that Mom is going to criticize your choice of colors? Did you choose something pink? Mom has bad taste in colors, you know that."

# game/scripts/c26/c26.rpy:3474
translate english c26s007_Bed_4a48fd2b:

    # mc "No, [emm], lo siento. Nada rosa en mi habitación, excepto cuando estás tú."
    mc "No, [emm], I'm sorry. Nothing pink in my room, except when you're there."

# game/scripts/c26/c26.rpy:3476
translate english c26s007_Bed_0a073dd4:

    # emm "Veo que tú has heredado el mal gusto de Mamá. Déjame ver..."
    emm "I see you've inherited Mom's bad taste. Let me see..."

# game/scripts/c26/c26.rpy:3480
translate english c26s007_Bed_98360f34:

    # emm "¡Es enorme! Cuando acaben de montarla quiero ser la primera en probarla."
    emm "It's huge! When they finish assembling it, I want to be the first one to try it out."

# game/scripts/c26/c26.rpy:3481
translate english c26s007_Bed_798a9eba:

    # mc "Creo que debería ser yo el primero en probarla, ¿no?"
    mc "I think I should be the first to try it, shouldn't I?"

# game/scripts/c26/c26.rpy:3483
translate english c26s007_Bed_2eeafc83:

    # emm "Bueno, después de ti, claro. Vamos a caber un montón de chicas ahí."
    emm "Well, after you, of course. We're going to fit a lot of girls in there."

# game/scripts/c26/c26.rpy:3484
translate english c26s007_Bed_9b3a8fb9:

    # emm "Los abrazos familiares van a ser épicos."
    emm "The family hugs are going to be epic."

# game/scripts/c26/c26.rpy:3485
translate english c26s007_Bed_1b48d1a1:

    # mc "*Risa* Por eso la he comprado tan grande. Si lo instauramos como costumbre vamos a necesitar el espacio."
    mc "*Laugh* That's why I bought it so big. If we make it a habit, we're going to need the space."

# game/scripts/c26/c26.rpy:3487
translate english c26s007_Bed_a69b8637:

    # emm "¿Me puedo mudar aquí cuando estés en Aruba? Creo que me va a encantar esa cama."
    emm "Can I move here when you're in Aruba? I think I'm going to love that bed."

# game/scripts/c26/c26.rpy:3488
translate english c26s007_Bed_9f45ffe0:

    # mc "Tus sábanas serán pequeñas con ese colchón, no tendrás nada rosa en la habitación."
    mc "Your sheets will be too small for that mattress, and you won't have anything pink in this room."

# game/scripts/c26/c26.rpy:3490
translate english c26s007_Bed_effaa45a:

    # emm "Entonces no. Seguramente me levantaría deprimida todas las mañanas."
    emm "Then no. I'd probably wake up depressed every morning."

# game/scripts/c26/c26.rpy:3491
translate english c26s007_Bed_a0feff72:

    # emm "Y no solo porque te vuelvas a ir. Ya tuve que pasar por eso cuando te fuiste a Portland."
    emm "And not just because you're leaving again. I already had to go through that when you went to Portland."

# game/scripts/c26/c26.rpy:3493
translate english c26s007_Bed_3fb9d2d7:

    # eri "¿Ya está montada?"
    eri "Is it assembled yet?"

# game/scripts/c26/c26.rpy:3494
translate english c26s007_Bed_e09abdaa:

    # mc "Aún no. Les queda poco."
    mc "Not yet. They don't have long left."

# game/scripts/c26/c26.rpy:3498
translate english c26s007_Bed_16aa5044:

    # eri "¡Es gigantesca! Si la última cama aguantó a ocho personas, creo que esta puede aguantar a diez o doce."
    eri "It's gigantic! If the last bed held eight people, I think this one could hold ten or twelve."

# game/scripts/c26/c26.rpy:3499
translate english c26s007_Bed_81bbf718:

    # mc "*Risa* Y a un gato."
    mc "*Laugh* And a cat."

# game/scripts/c26/c26.rpy:3501
translate english c26s007_Bed_a20bba32:

    # eri "*Risa* No, con el gato no pudo."
    eri "*Laugh* No, it couldn't manage the cat."

# game/scripts/c26/c26.rpy:3502
translate english c26s007_Bed_a818cf2b:

    # mc "*Risa* Tienes razón. Si no le hubierais dado tantas latas de atún..."
    mc "*Laugh* You're right. If you hadn't given him so many cans of tuna..."

# game/scripts/c26/c26.rpy:3504
translate english c26s007_Bed_6e6d30ce:

    # eri "No hubieras comprado una cama nueva enorme. Le tienes que dar gracias a Zeus y a su Secta de Alimentadoras. *Risa*"
    eri "You wouldn't have bought a huge new bed. You have Zeus and his Cult of Feeders to thank for that. *Laugh*"

# game/scripts/c26/c26.rpy:3505
translate english c26s007_Bed_979487e2:

    # mc "¿Ya habéis montado una secta?"
    mc "Have you started a cult yet?"

# game/scripts/c26/c26.rpy:3507
translate english c26s007_Bed_e9efb349:

    # eri "Es broma, pero no es mala idea. Nombraríamos a [mad.nick] Suma Sacerdotisa y así nadie le dará más comida de la debida al gatito."
    eri "Just kidding, but it's not a bad idea. We would name [mad.nick] High Priestess, and then no one would give the kitten more food than it was supposed to have."

# game/scripts/c26/c26.rpy:3508
translate english c26s007_Bed_1b9104cd:

    # eri "Nadie quiere que coja un empacho y se ponga enfermo."
    eri "No one wants him to overeat and get sick."

# game/scripts/c26/c26.rpy:3509
translate english c26s007_Bed_ccdd9f0d:

    # mc "¡Estáis todas locas!"
    mc "You're all crazy!"

# game/scripts/c26/c26.rpy:3511
translate english c26s007_Bed_ada1c689:

    # eri "Por cierto, viendo esa cama, creo que el problema de espacio para la abuela, Tía [bet], [kia] y [eil] cuando lleguen las chicas nuevas podría estar resuelto."
    eri "By the way, seeing that bed, I think the space problem for Grandma, Aunt [bet], [kia], and [eil] when the new girls arrive could be solved."

# game/scripts/c26/c26.rpy:3512
translate english c26s007_Bed_e5666411:

    # eri "Podrían dormir todas en tu cama. Aunque [eil] también podría dormir en la mía."
    eri "They could all sleep in your bed. Although [eil] could also sleep in mine."

# game/scripts/c26/c26.rpy:3513
translate english c26s007_Bed_88189be7:

    # mc "Bueno, creo que habrá tiempo de hablar de eso. He estado hablando con Tía [bet] antes y..."
    mc "Well, I think there will be time to talk about that. I was talking to Aunt [bet] earlier and..."

# game/scripts/c26/c26.rpy:3515
translate english c26s007_Bed_4ac54e3c:

    # "Transportista" "Señor, ya está acabada. ¿Quiere pasar a verla y a probarla?"
    "Assembler" "Sir, it's finished. Would you like to see it and try it out?"

# game/scripts/c26/c26.rpy:3516
translate english c26s007_Bed_f9999dc0:

    # "Transportista" "También debería firmar la entrega."
    "Assembler" "You should also sign the delivery note."

# game/scripts/c26/c26.rpy:3518
translate english c26s007_Bed_cfcad35e:

    # eri "Te dejo con estos señores. Voy a ver si Tía [mar] necesita ayuda con la comida."
    eri "I'll leave you with these guys. I'm going to see if Aunt [mar] needs help with lunch."

# game/scripts/c26/c26.rpy:3520
translate english c26s007_Bed_79956606:

    # "Pruebas la cama y todo parece estar en orden. Firmas la entrega y acompañas a los transportistas a la salida."
    "You check the bed, and everything seems to be in order. You sign the delivery note and accompany the delivery guys to the exit."

# game/scripts/c26/c26.rpy:3521
translate english c26s007_Bed_c883ac1f:

    # "Vuelves a subir a tu habitación para poner las sábanas y el edredón."
    "You go back up to your room to put the sheets and duvet on the bed."

# game/scripts/c26/c26.rpy:3523
translate english c26s007_Bed_533f311d:

    # mcp "(Una cama enorme. Espero que resista unos cuantos abrazos familiares.)"
    mcp "(A massive bed. I hope it can withstand a few family hugs.)"

# game/scripts/c26/c26.rpy:3527
translate english c26s008_DebTeaser_019a933f:

    # "Cuando se acerca la hora de ir a buscar a [deb.nick] vas a darte una ducha rápida y a cambiarte."
    "When it's almost time to pick up [deb.nick], you go take a quick shower and get changed."

# game/scripts/c26/c26.rpy:3528
translate english c26s008_DebTeaser_9348b1b4:

    # "Ya has tenido una no-cita con la ropa que llevas y la cita que vas a tener ahora es demasiado especial como para repetir vestuario."
    "You've already had a no-date with the outfit you're wearing, and the date you're going on now is too special to repeat the same outfit."

# game/scripts/c26/c26.rpy:3529
translate english c26s008_DebTeaser_64656ef3:

    # mcp "(Parezco [eil] eligiendo el vestido para nuestro baile de promoción.) *Risa mental*"
    mcp "(I feel like [eil] choosing a dress for our prom.) *Mental laughter*"

# game/scripts/c26/c26.rpy:3530
translate english c26s008_DebTeaser_5888bb9e:

    # mcp "(¿Es tan importante [deb.nick] para mí?)"
    mcp "(Is [deb.nick] that important to me?)"

# game/scripts/c26/c26.rpy:3531
translate english c26s008_DebTeaser_aa5fd0b9:

    # mcp "(Creo que es una de las preguntas más tontas que me he hecho nunca. La respuesta es, obviamente, sí.)"
    mcp "(I think that's one of the silliest questions I've ever asked myself. The answer is obviously yes.)"

# game/scripts/c26/c26.rpy:3533
translate english c26s008_DebTeaser_cdee2f84:

    # "Bajas una planta hasta la habitación que [deb.nick] comparte con [lis] y llamas a la puerta."
    "You go down one floor to the room that [deb.nick] shares with [lis] and knock on the door."

# game/scripts/c26/c26.rpy:3534
translate english c26s008_DebTeaser_dd0461ef:

    # "*Knock-Knock*"
    "*Knock-Knock*"

# game/scripts/c26/c26.rpy:3535
translate english c26s008_DebTeaser_8666b80b:

    # mc "Soy yo. ¿Puedo pasar?"
    mc "It's me. Can I come in?"

# game/scripts/c26/c26.rpy:3536
translate english c26s008_DebTeaser_d580105d:

    # deb "*A través de la puerta* Dame dos minutos. Espérame en los sofás, por favor."
    deb "*Through the door* Give me two minutes. Wait for me on the sofa, please."

# game/scripts/c26/c26.rpy:3538
translate english c26s008_DebTeaser_6beb74e3:

    # "Te sientas en el sofá y esperas."
    "You sit on the sofa and wait."

# game/scripts/c26/c26.rpy:3539
translate english c26s008_DebTeaser_4e50b405:

    # "¿Dos minutos para estar lista? A veces desearías que la sirena no se hubiera feminizado tanto."
    "Two minutes to get ready? Sometimes you wish the Mermaid hadn't been feminized so much."

# game/scripts/c26/c26.rpy:3540
translate english c26s008_DebTeaser_813dc740:

    # "Seguramente la [deb.nick] que bajó de aquel avión habría cumplido con los dos minutos exactos."
    "Surely the [deb.nick] who got off that plane would have complied with the exact two minutes."

# game/scripts/c26/c26.rpy:3542
translate english c26s008_DebTeaser_f825ca7b:

    # "Cuando ha pasado un minuto, para tu sorpresa, oyes cómo se abre la puerta de las hermanas Selden."
    "When a minute has passed, to your surprise, you hear the Selden sisters' door open."

# game/scripts/c26/c26.rpy:3546
translate english c26s008_DebTeaser_f6232f77:

    # mcp "(¿[kim] ayudando a mi cita con algo? ¿Maquillaje quizás? No es que [deb.nick] lo necesite para estar preciosa, pero...)"
    mcp "([kim] helping my date with something? Makeup perhaps? Not that [deb.nick] needs it to look beautiful, but...)"

# game/scripts/c26/c26.rpy:3547
translate english c26s008_DebTeaser_97fdfd24:

    # "Ni siquiera ha mirado en tu dirección. Sigues esperando."
    "She hasn't even looked in your direction. You keep waiting."

# game/scripts/c26/c26.rpy:3549
translate english c26s008_DebTeaser_ac5f570e:

    # "Cuando han pasado los dos minutos exactos, la puerta vuelve a abrirse."
    "When exactly two minutes have passed, the door opens again."

# game/scripts/c26/c26.rpy:3555
translate english c26s008_DebTeaser_03f3e60e:

    # deb "¿Nos vamos?"
    deb "Shall we go?"

# game/scripts/c26/c26.rpy:3556
translate english c26s008_DebTeaser_5785b392:

    # "Te quedas sin palabras por un momento. No te hubiera importado esperar dos horas en vez de dos minutos."
    "You are speechless for a moment. You wouldn't have minded waiting two hours instead of two minutes."

# game/scripts/c26/c26.rpy:3557
translate english c26s008_DebTeaser_117c4497:

    # mc "Cuando quieras. Estás preciosa, [deb.nick]."
    mc "Whenever you want. You look beautiful, [deb.nick]."

