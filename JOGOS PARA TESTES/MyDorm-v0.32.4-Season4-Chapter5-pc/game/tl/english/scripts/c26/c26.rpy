# game/scripts/c26/c26.rpy:2784
translate english c26s005_LisDebKat_28ed141c:

    # lis "La elegiste a ella primero, con lo que ella va a ser la primera en tener una cita contigo."
    lis "You chose her first, so she will be the first to have a date with you."

# game/scripts/c26/c26.rpy:2785
