# game/scripts/c26/c26.rpy:1534
translate english c26s002_Solomon_2404cc94:

    # oma "Pero no te preocupes. No tienes ninguna oportunidad. Por primera vez es libre y está descubriendo lo que es vivir. Sin ti."
    oma "But don't worry. You don't stand a chance. For the first time, she's free and discovering what it's like to live. Without you."

# game/scripts/c26/c26.rpy:1536
translate english c26s002_Solomon_01e35e09:

    # sol "No he sido tan malo... Los hay peores."
    sol "I haven't been such a bad husband... There are worse ones out there."

# game/scripts/c26/c26.rpy:1538
translate english c26s002_Solomon_6675abed:

