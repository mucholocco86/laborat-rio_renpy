    # mee "Todo parecía evolucionar de forma natural. Conocernos, casarnos, tener hijos..."
    mee "Everything seemed to evolve naturally. Getting to know each other, getting married, having children..."

# game/scripts/c26/c26.rpy:188
translate english c26s001_MeeDate_45784042:

    # mee "Todo parecía evolucionar de forma natural. Conocernos, casarnos, tener a [nor]..."
    mee "Everything seemed to evolve naturally. Getting to know each other, getting married, having [nor]..."

