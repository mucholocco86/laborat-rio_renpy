    lis "It doesn't matter to you. It matters to me. [deb.nick] has always felt that she was beneath me in many ways."

# game/scripts/c26/c26.rpy:2780
translate english c26s005_LisDebKat_9b84fca1:

    # lis "Equivocadamente, pero ella se siente así."
    lis "Wrongly, but that's how she feels."

# game/scripts/c26/c26.rpy:2781
