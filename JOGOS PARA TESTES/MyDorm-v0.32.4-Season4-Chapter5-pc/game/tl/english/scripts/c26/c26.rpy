# game/scripts/c26/c26.rpy:2848
translate english c26s005_LisDebKat_de7ea21e:

    # mc "*Risa* Si no te hubiera llevado a la tienda, no hubieras tenido ropa. Le hubieras tenido que coger ropa a [kim] o a [emm]."
    mc "*Laugh* If I hadn't taken you to the store, you wouldn't have had any clothes. You would have had to borrow clothes from [kim] or [emm]."

