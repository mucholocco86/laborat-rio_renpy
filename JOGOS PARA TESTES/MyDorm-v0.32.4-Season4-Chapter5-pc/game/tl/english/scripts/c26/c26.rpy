    # kim "Acabándose de cambiar. No creo que quisiera venir a la cita manchada de harina."
    kim "Just finishing getting changed. I don't think she wanted to come to the date covered in flour."

# game/scripts/c26/c26.rpy:3129
translate english c26s006_KatBreakfast_37691743:

    # kat "¡JODER! ¡NO ES UNA PUTA CITA!"
    kat "DAMN IT! IT'S NOT A FUCKING DATE!"

# game/scripts/c26/c26.rpy:3130
