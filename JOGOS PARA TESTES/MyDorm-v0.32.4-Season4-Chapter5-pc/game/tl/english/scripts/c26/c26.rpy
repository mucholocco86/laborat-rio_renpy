# game/scripts/c26/c26.rpy:2833
translate english c26s005_LisDebKat_d7468372:

    # mc "Tengo muchas ganas de que tengamos la primera cita, [deb.nick]. Al menos la primera cita oficial."
    mc "I'm really looking forward to our first date, [deb.nick]. At least the first official date."

# game/scripts/c26/c26.rpy:2834
translate english c26s005_LisDebKat_56aa1561:

