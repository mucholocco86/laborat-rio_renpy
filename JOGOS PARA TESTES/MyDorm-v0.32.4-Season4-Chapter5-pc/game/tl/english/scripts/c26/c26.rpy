translate english c26s005_LisDebKat_ee01caef:

    # deb "Gracias, [mc]... Aún me sorprende que te guste, pero es una de las cosas que no quiero que cambies."
    deb "Thanks, [mc]... I'm still surprised you like me, but it's one of the things I don't want you to change."

# game/scripts/c26/c26.rpy:2860
translate english c26s005_LisDebKat_c4a758f1:

    # deb "Y creo que nunca me cansaré de oírtelo decir."
    deb "And I don't think I'll ever get tired of hearing you say it."

# game/scripts/c26/c26.rpy:2861
translate english c26s005_LisDebKat_8b4ee1d0:

