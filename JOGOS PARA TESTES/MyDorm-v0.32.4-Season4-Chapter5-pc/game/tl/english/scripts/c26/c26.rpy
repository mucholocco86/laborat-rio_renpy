translate english c26s005_LisDebKat_3d8d9210:

    # mc "*Risa* Mejor no lo hagas."
    mc "*Laugh* Better not do it."

# game/scripts/c26/c26.rpy:2866
translate english c26s005_LisDebKat_1ff75647:

    # deb "Debería ir a mi habitación... a elegir ropa y a pedirle consejo a [lis]. Mañana no tendré tiempo..."
    deb "I should go to my room... to choose clothes and ask [lis] for advice. I won't have time tomorrow..."

# game/scripts/c26/c26.rpy:2867
translate english c26s005_LisDebKat_08c189e3:

    # deb "¿A qué hora es la reserva?"
    deb "What time is the reservation?"

# game/scripts/c26/c26.rpy:2868
translate english c26s005_LisDebKat_24786556:

    # mc "A la 1:00 PM."
    mc "At 1:00 PM."

# game/scripts/c26/c26.rpy:2870
translate english c26s005_LisDebKat_b01be8cd:

    # deb "Perfecto. Me dará tiempo de venir a casa a cambiarme después de la última clase. ¿Me pasas a buscar por mi habitación a las 12:30?"
    deb "Perfect. That will give me time to come home and change after my last class. Will you pick me up at my room at 12:30?"

