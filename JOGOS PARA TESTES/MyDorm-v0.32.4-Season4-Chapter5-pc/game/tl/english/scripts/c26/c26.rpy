    mc "See you tomorrow, gorgeous."

# game/scripts/c26/c26.rpy:2879
translate english c26s005_LisDebKat_7829bd13:

    # lis "Se me ha ocurrido una idea. A lo mejor me meto donde no me llaman, pero después de unas semanas aquí... ¿Aceptáis sugerencias sobre cómo mejorar el dormitorio?"
    lis "I've had an idea. Maybe I'm getting in over my head, but after a few weeks here... Would you accept suggestions on how to improve the dorm?"

