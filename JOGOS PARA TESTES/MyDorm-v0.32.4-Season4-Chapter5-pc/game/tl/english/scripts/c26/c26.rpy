    mee "You're right. I worry too much, but I haven't been with anyone since John..."

# game/scripts/c26/c26.rpy:251
translate english c26s001_MeeDate_91f7a39a:

    # mc "Si te sirve de algo, Tía [bet] dijo que me parecía mucho a él. A lo mejor las discusiones son parecidas."
