    # mc "No he mirado el teléfono hoy..."
    mc "I haven't checked my phone today..."

# game/scripts/c26/c26.rpy:1230
translate english c26s002_EriDapSca_5f2b857f:

    # emm "¡Soy rica!"
    emm "I'm rich!"

# game/scripts/c26/c26.rpy:1231
translate english c26s002_EriDapSca_0f443fe9:

    # mc "Hola, [emm]. ¿Tú también has recibido el mensaje?"
    mc "Hello, [emm]. Did you get the message too?"

# game/scripts/c26/c26.rpy:1233
translate english c26s002_EriDapSca_abacfdf8:

    # emm "¿Vosotros también? ¿No soy la única rica de la familia?"
    emm "You too? I'm not the only rich one in the family?"

# game/scripts/c26/c26.rpy:1234
translate english c26s002_EriDapSca_7bdb7347:

    # mc "Al menos [dap] y [eri] lo han recibido. ¿Scarlett?"
    mc "At least [dap] and [eri] got it. [sca]?"

# game/scripts/c26/c26.rpy:1236
translate english c26s002_EriDapSca_6958b6b3:

    # sca "No, yo no he recibido nada."
    sca "No, I haven't received anything."

# game/scripts/c26/c26.rpy:1237
translate english c26s002_EriDapSca_2dc92f51:

    # mc "[emm], ¿tú sabes qué es?"
    mc "[emm], do you know what it is?"

# game/scripts/c26/c26.rpy:1239
translate english c26s002_EriDapSca_4f0cd8ff:

    # emm "No tengo ni idea, pero voy a poder comprarme un montón de ropa, y un coche, y..."
    emm "I have no idea, but I'll be able to buy lots of clothes, and a car, and..."

# game/scripts/c26/c26.rpy:1240
translate english c26s002_EriDapSca_c0c1f2f7:

    # mc "No empieces a gastar el dinero antes de saber de dónde viene."
    mc "Don't start spending that money before you know where it's coming from."

# game/scripts/c26/c26.rpy:1242
translate english c26s002_EriDapSca_0318ce09:

    # eri "Voy a llamar a [ama]. Es posible que venga de NTR. Si lo hemos recibido [emm], [dap], y yo, pero no [sca]..."
    eri "I'm going to call [ama]. It might be coming from NTR. If [emm], [dap], and I got it, but not [sca]..."

# game/scripts/c26/c26.rpy:1243
translate english c26s002_EriDapSca_5ae3a440:

    # mc "Sí, hazlo, por favor. Yo tengo el móvil en la habitación."
    mc "Yes, please, do it. My phone is in my room."

# game/scripts/c26/c26.rpy:1245
translate english c26s002_EriDapSca_dec27729:

    # "Un minuto después..."
    "A minute later..."

# game/scripts/c26/c26.rpy:1246
translate english c26s002_EriDapSca_2dc356de:

    # eri "Sí, es de NTR. Es nuestra parte de los beneficios, por las acciones..."
    eri "Yes, it's from NTR. It's our share of the profits, from our shares..."

# game/scripts/c26/c26.rpy:1247
translate english c26s002_EriDapSca_f5eaf0e9:

    # mc "Bueno, ahora somos accionistas de una empresa millonaria. Hay que enterarse bien de cómo funciona."
    mc "Well, now we're shareholders in a multimillion-dollar company. We need to learn how it works."

# game/scripts/c26/c26.rpy:1248
translate english c26s002_EriDapSca_ae41bba9:

    # eri "[ama] me ha dicho que es un pago anual."
    eri "[ama] told me it's an annual payment."

# game/scripts/c26/c26.rpy:1250
translate english c26s002_EriDapSca_9cd46d22:

    # sca "Entonces, ya no necesitarás trabajar en el café, ¿verdad?"
    sca "So, you won't need to work at the cafe anymore, right?"

# game/scripts/c26/c26.rpy:1251
translate english c26s002_EriDapSca_290c19e8:

    # sca "¿Podrías recomendarme para coger tu puesto?"
    sca "Could you recommend me for your position?"

# game/scripts/c26/c26.rpy:1252
translate english c26s002_EriDapSca_2be61814:

    # mc "¿Quieres trabajar en el café, [sca]?"
    mc "Would you like to work at the cafe, [sca]?"

# game/scripts/c26/c26.rpy:1254
translate english c26s002_EriDapSca_364dd5da:

    # sca "Quiero contribuir en algo a la familia. Estoy aquí sin hacer nada hasta que empiecen las clases..."
    sca "I want to contribute in some way to the family. I'm here doing nothing until classes start..."

# game/scripts/c26/c26.rpy:1255
translate english c26s002_EriDapSca_4648c288:

    # mc "Pero [dap] y tú ibais a venir a Aruba conmigo, ¿no?"
    mc "But [dap] and you are coming to Aruba with me, aren't you?"

# game/scripts/c26/c26.rpy:1257
translate english c26s002_EriDapSca_f4920ea7:

    # sca "Si encuentro un trabajo, no podré ir. Ya habrá más oportunidades más tarde."
    sca "If I find a job, I won't be able to go. There will be more opportunities later."

# game/scripts/c26/c26.rpy:1258
translate english c26s002_EriDapSca_be042856:

    # mc "No creo que sea necesario que contribuyas económicamente, [sca]."
    mc "I don't think it's necessary for you to contribute financially, [sca]."

# game/scripts/c26/c26.rpy:1259
translate english c26s002_EriDapSca_b1d2bfba:

    # mc "Eres de la familia y no tienes que pagar alquiler. Si [emm] no lo paga..."
    mc "You're part of the family and you don't have to pay rent. If [emm] doesn't pay it..."

# game/scripts/c26/c26.rpy:1261
translate english c26s002_EriDapSca_c05896e6:

    # emm "*Risa* Ahora podría pagarlo."
    emm "*Laugh* I could afford it now."

# game/scripts/c26/c26.rpy:1263
translate english c26s002_EriDapSca_52127a86:

    # emm "[lis], [deb], [kat], [sai], y [kim] también son de la familia y pagan por su alojamiento."
    emm "[lis], [deb.nick], [kat], [sai], and [kim] are also family members and pay for their lodging."

# game/scripts/c26/c26.rpy:1264
translate english c26s002_EriDapSca_4cbc63a0:

    # emm "No sé si deberíamos hacer algo al respecto."
    emm "I don't know if we should do something about it."

# game/scripts/c26/c26.rpy:1265
translate english c26s002_EriDapSca_af63fdad:

    # mc "Creo que eso lo deberíamos comentar con Mamá y con Tía [nor]. La verdad es que es raro..."
    mc "I think we should talk about it with Mom and Aunt [nor]. It's really weird..."

# game/scripts/c26/c26.rpy:1267
translate english c26s002_EriDapSca_e954a25a:

    # eri "De todas formas, [sca], no voy a dejar el trabajo en el café hasta que empiecen las clases."
    eri "Anyway, [sca], I'm not going to quit my job at the cafe until college starts."

# game/scripts/c26/c26.rpy:1268
translate english c26s002_EriDapSca_796b9b79:

    # mc "¿Por qué? Ahora no necesitas el dinero..."
    mc "Why? You don't need the salary anymore..."

# game/scripts/c26/c26.rpy:1270
translate english c26s002_EriDapSca_8cca8bf3:

    # eri "Creo que ya sé en qué voy a gastar ese dinero, con lo que voy a estar en la misma situación."
    eri "I think I already know what I'm going to spend that money on, which will leave me in the same situation."

# game/scripts/c26/c26.rpy:1271
translate english c26s002_EriDapSca_9bd83e03:

    # mc "¿En qué?"
    mc "What are you going to spend so much money on??"

# game/scripts/c26/c26.rpy:1272
translate english c26s002_EriDapSca_e3047add:

    # eri "Lo tengo que confirmar todavía. Pero, de momento, no voy a dejar mi trabajo."
    eri "I still have to confirm it. But for now, I'm not going to quit my job."

# game/scripts/c26/c26.rpy:1274
translate english c26s002_EriDapSca_2996b4c3:

    # eri "[sca], igualmente le puedo decir a mi jefe que buscas trabajo para un mes. El chico que contrató para sustituir a Jack no está funcionando bien."
    eri "[sca], I can also tell my boss that you are looking for a job for a month or so. The guy he hired to replace Jack isn't performing well."

# game/scripts/c26/c26.rpy:1275
translate english c26s002_EriDapSca_31fc7bbf:

    # eri "Si al final lo despide, podríamos trabajar juntas [eil], tú, y yo."
    eri "If my boss ends up firing him, [eil], you and I could work together."

# game/scripts/c26/c26.rpy:1277
translate english c26s002_EriDapSca_b11f4e4e:

    # sca "¡Oh! ¡Eso sería fantástico!"
    sca "Oh! That would be fantastic!"

# game/scripts/c26/c26.rpy:1279
translate english c26s002_EriDapSca_07a07b95:

    # sca "Bueno, no por el pobre chico, pero..."
    sca "Well, not for the poor guy, but..."

# game/scripts/c26/c26.rpy:1280
translate english c26s002_EriDapSca_6d1b050d:

    # mc "*Risa* Creo que te hemos entendido."
    mc "*Laugh* I think we get it."

# game/scripts/c26/c26.rpy:1282
translate english c26s002_EriDapSca_af5d598b:

    # dap "¿Crees que podemos gastar algo de ese dinero, [mc]?"
    dap "Do you think we can spend some of that money, [mc]?"

# game/scripts/c26/c26.rpy:1283
translate english c26s002_EriDapSca_48644824:

    # mc "Una vez que [ama] ha confirmado que viene de NTR, creo que sí. Pero no os lo gastéis todo."
    mc "Since [ama] has confirmed that it comes from NTR, I think so. But don't spend it all."

# game/scripts/c26/c26.rpy:1284
translate english c26s002_EriDapSca_99e2867d:

    # mc "Es un pago anual, con lo que os lo vais a tener que administrar durante un año."
    mc "It is an annual payment, so you will have to administer it yourselves for a year."

# game/scripts/c26/c26.rpy:1286
translate english c26s002_EriDapSca_9b64bd31:

    # emm "¿Quieres decir que Mamá dejará de darme la paga semanal?"
    emm "You mean Mom won't give me my weekly allowance anymore?"

# game/scripts/c26/c26.rpy:1287
translate english c26s002_EriDapSca_e30ad040:

    # mc "No es que lo crea. Le voy a proponer que deje de hacerlo. Ahora tienes tu propio dinero y tienes que aprender a administrarlo."
    mc "I don't know what she will do. But I'm going to suggest that she stop doing it. You have your own money now, and you need to learn how to manage it."

# game/scripts/c26/c26.rpy:1289
translate english c26s002_EriDapSca_5b2e29e9:

    # emm "¡Pero eso es injusto! Ella seguramente también lo ha cobrado..."
    emm "But that's unfair! She must have gotten the message too..."

# game/scripts/c26/c26.rpy:1290
translate english c26s002_EriDapSca_b29874c5:

    # mc "Y ella se ocupa de todos los gastos de la casa. No seas egoísta, [emm]."
    mc "And she takes care of all the household expenses. Don't be selfish, [emm]."

# game/scripts/c26/c26.rpy:1292
translate english c26s002_EriDapSca_f8be4405:

    # emm "Tienes razón. Le preguntaré si necesita algo..."
    emm "You're right. I'll ask her if she needs anything..."

# game/scripts/c26/c26.rpy:1293
translate english c26s002_EriDapSca_ebd8fc29:

    # emm "Voy a buscarla para darle la noticia."
    emm "I'm going to find her to tell her the news."

# game/scripts/c26/c26.rpy:1295
translate english c26s002_EriDapSca_53462aa3:

    # dap "[sca], vamos a nuestra habitación. Creo que tenemos que renovar tu portátil."
    dap "[sca], let's go to our room. I think we need to replace your laptop."

# game/scripts/c26/c26.rpy:1296
translate english c26s002_EriDapSca_e03687a5:

    # mcp "(La primera compra que hace es para [sca]. [dap] es maravillosa.)"
    mcp "(The first purchase she makes is for [sca]. [dap] is lovely.)"

# game/scripts/c26/c26.rpy:1298
translate english c26s002_EriDapSca_c6c43322:

    # sca "¿Qué? ¿Por qué? El mío aún puede durar..."
    sca "What? Why? Mine still works..."

# game/scripts/c26/c26.rpy:1299
translate english c26s002_EriDapSca_e050b987:

    # mc "[sca], tu portátil todavía tiene Doors 8. Creo que ya es hora de jubilarlo, y no digas que no a un regalo."
    mc "[sca], your laptop still runs Doors 8. I think it's time to upgrade. And don't reject a gift."

# game/scripts/c26/c26.rpy:1300
translate english c26s002_EriDapSca_d29d73d6:

    # mc "Creo que le va a hacer más ilusión a [dap] comprártelo que a ti recibirlo."
    mc "I think [dap] will be more excited to buy it for you than you will be to receive it."

# game/scripts/c26/c26.rpy:1302
translate english c26s002_EriDapSca_bafa982c:

    # eri "Yo voy a hablar con Tía [bet] sobre unas cosas..."
    eri "I'm going to talk to Aunt [bet] about a few things..."

# game/scripts/c26/c26.rpy:1304
translate english c26s002_EriDapSca_2ad05f94:

    # "Todas desaparecen y te quedas solo en la cocina."
    "They all disappear and you're left alone in the kitchen."

# game/scripts/c26/c26.rpy:1305
translate english c26s002_EriDapSca_e290d77b:

    # "Solo con tu hambre. Aún no has desayunado."
    "Alone with your hunger. You haven't had breakfast yet."

# game/scripts/c26/c26.rpy:1306
translate english c26s002_EriDapSca_adf250ce:

    # "Pones remedio a esa situación."
    "You do something about it."

# game/scripts/c26/c26.rpy:1314
translate english c26s003_Sai_2736c66c:

    # "Al acabar de desayunar, de camino a tu habitación."
    "After breakfast, on the way to your room..."

# game/scripts/c26/c26.rpy:1315
translate english c26s003_Sai_aef5aca0:

    # mc "Hola, [sai], ¿qué haces tan sola?"
    mc "Hi, [sai], what are you doing here alone?"

# game/scripts/c26/c26.rpy:1316
translate english c26s003_Sai_4be64632:

    # sai "Les he mandado a mis padres unas fotos de la clase de tiro de ayer y estábamos chateando."
    sai "I sent my parents some photos from yesterday's shooting class and we were chatting."

# game/scripts/c26/c26.rpy:1317
translate english c26s003_Sai_9a12bdab:

    # sai "Tenías que haber venido. Fue muy divertido."
    sai "You should have come. It was great fun."

# game/scripts/c26/c26.rpy:1318
translate english c26s003_Sai_31a2af1a:

    # mc "Me tienes que enseñar esas fotos."
    mc "You have to show me those pictures."

# game/scripts/c26/c26.rpy:1320
translate english c26s003_Sai_88877976:

    # sai "Siéntate conmigo un momento y te las enseño."
    sai "Sit down with me for a moment and I'll show you."

# game/scripts/c26/c26.rpy:1321
translate english c26s003_Sai_872c8558:

    # mc "¿No estabas chateando con tus padres?"
    mc "Weren't you chatting with your parents?"

# game/scripts/c26/c26.rpy:1323
translate english c26s003_Sai_6f0d13aa:

    # sai "Me había despedido justo antes de que llegaras."
    sai "I said goodbye to them just before you arrived."

# game/scripts/c26/c26.rpy:1324
translate english c26s003_Sai_7ca76543:

    # mc "Enséñame esas fotos, entonces."
    mc "Show me those pics, then."

# game/scripts/c26/c26.rpy:1326
translate english c26s003_Sai_a2fe9454:

    # sai "Mira, aquí estamos disparando las del primer turno. [eva] fue super estricta con la seguridad."
    sai "Look, here we are shooting the first turn girls. [eva] was super strict about safety."

# game/scripts/c26/c26.rpy:1327
translate english c26s003_Sai_0c7c59e8:

    # mc "Sí que lo es. Es parte de su entrenamiento. Al menos no os hizo poneros trajes raros como a mí."
    mc "Yes, she is. It's part of their training. At least she didn't make you wear weird uniforms like she did to me."

# game/scripts/c26/c26.rpy:1329
translate english c26s003_Sai_7188f673:

    # sai "¿Cómo tuviste que vestirte?"
    sai "How did you have to dress?"

# game/scripts/c26/c26.rpy:1330
translate english c26s003_Sai_3ddc6c80:

    # mc "Me llevó en la moto y me hizo ponerme un traje de skydiving. Era bastante incómodo."
    mc "She took me on her motorcycle and made me put on a skydiving suit. It was pretty uncomfortable."

# game/scripts/c26/c26.rpy:1332
translate english c26s003_Sai_45b01f20:

    # sai "*Risa* Lástima que no haya fotos de eso. Nosotras disparamos con la ropa que llevábamos."
    sai "*Laugh* Too bad there are no photos of that. We shot with the clothes we were wearing."

# game/scripts/c26/c26.rpy:1333
translate english c26s003_Sai_a427effe:

    # mc "No sé si os gustaría verme con ese traje. *Risa* A menos que fuera para reíros de mí, claro."
    mc "I don't know if you'd like to see me in that outfit. *Laugh* Unless it was to laugh at me, of course."

# game/scripts/c26/c26.rpy:1334
translate english c26s003_Sai_3f66c9f4:

    # mc "Vosotras estáis mucho mejor. Pero quiero ver más fotos."
    mc "You look much better. But I want to see more photos."

# game/scripts/c26/c26.rpy:1336
translate english c26s003_Sai_35b1678f:

    # sai "Estas son las del segundo turno. Había seis puestos de tiro, y éramos diez, más [ama] y [eva], con lo que dos turnos fueron bien."
    sai "These are from the second round. There were six shooting stations, and there were ten of us, plus [ama] and [eva], so two shifts worked well."

# game/scripts/c26/c26.rpy:1337
translate english c26s003_Sai_c0ee93f2:

    # mc "¿Competíais entre vosotras?"
    mc "Did you compete against each other?"

# game/scripts/c26/c26.rpy:1339
translate english c26s003_Sai_30964fc6:

    # sai "Quisimos hacerlo. [ama] dijo que no estaba bien para la primera lección, que era para aprender."
    sai "We wanted to do it. [ama] said it wasn't right for the first lesson, since it was for learning the basics."

# game/scripts/c26/c26.rpy:1340
translate english c26s003_Sai_a85d5a98:

    # sai "[emm] y yo insistimos, que era competir solo por diversión entre la familia."
    sai "[emm] and I insisted that it was just for fun, a friendly competition between family."

# game/scripts/c26/c26.rpy:1341
translate english c26s003_Sai_ecc79721:

    # sai "[eva] fue al último puesto de tiro, disparó siete veces, y dijo algo como '¿Estáis seguras de que queréis competir?'"
    sai "[eva] went to the last shooting station, fired seven times, and said something like, 'Are you sure you want to compete?'"

# game/scripts/c26/c26.rpy:1342
translate english c26s003_Sai_942f5934:

    # mc "*Risa* Y se acabó la discusión."
    mc "*Laugh* And that was the end of that discussion."

# game/scripts/c26/c26.rpy:1344
translate english c26s003_Sai_aef86f6a:

    # sai "*Risa* Seis tiros dieron en el 10 y uno en el 9. 69 puntos."
    sai "*Laugh* Six shots hit the 10 and one hit the 9. 69 points."

# game/scripts/c26/c26.rpy:1345
translate english c26s003_Sai_28be29c9:

    # mc "Es extraño que fallara uno."
    mc "It's weird that she missed one."

# game/scripts/c26/c26.rpy:1347
translate english c26s003_Sai_c58cbc6d:

    # sai "[ama] nos dijo luego que lo había hecho a propósito. Así, si alguien quería competir, tendría una oportunidad de superarla."
    sai "[ama] later told us that she had done it on purpose. That way, if anyone wanted to compete, they would have a chance to beat her."

# game/scripts/c26/c26.rpy:1348
translate english c26s003_Sai_c2df0add:

    # mc "*Risa* Eso suena tan a... [eva]..."
    mc "*Laugh* That sounds so much like... [eva]..."

# game/scripts/c26/c26.rpy:1350
translate english c26s003_Sai_2b19abc7:

    # sai "Totalmente [eva]. Dejó clara su posición, pero dejó margen por si alguien quería competir de verdad."
    sai "Totally [eva]. She made her position clear, but left room for anyone who really wanted to compete."

# game/scripts/c26/c26.rpy:1351
translate english c26s003_Sai_9784ae30:

    # sai "Las que más se aceraron a su puntuación fueron [sam] y [kat], con 51 y 54 puntos. Ya habían disparado antes. Son muy buenas."
    sai "The closest to her score were [sam] and [kat], with 51 and 54 points. They are experienced shooters. They are very good."

# game/scripts/c26/c26.rpy:1352
translate english c26s003_Sai_dfd35ebf:

    # mc "¿Cuál fue tu puntuación?"
    mc "What was your score?"

# game/scripts/c26/c26.rpy:1354
translate english c26s003_Sai_364cea9c:

    # sai "*Risa* Unos horribles 23 puntos con siete disparos en mi mejor ronda. Y no fui la peor, pero no te diré quién fue."
    sai "*Laugh* A horrible 23 points with seven shots in my best round. And I wasn't the worst, but I won't tell you who was."

# game/scripts/c26/c26.rpy:1355
translate english c26s003_Sai_4cd5359e:

    # mc "*Risa* Deberías decírmelo, para salir corriendo si alguna vez la veo con un arma."
    mc "*Laugh* You should tell me, so I can run away if I ever see her with a gun."

# game/scripts/c26/c26.rpy:1357
translate english c26s003_Sai_fd7bd295:

    # sai "Mira, esta es la última foto, cuando habíamos acabado."
    sai "Look, this is the last photo, when we were done."

# game/scripts/c26/c26.rpy:1358
translate english c26s003_Sai_6259fe7c:

    # mc "Me extraña mucho que [eva] y [ama] os dejaran posar con las pistolas..."
    mc "I'm really surprised that [eva] and [ama] let you pose with the guns..."

# game/scripts/c26/c26.rpy:1359
translate english c26s003_Sai_de78cf99:

    # sai "[emm] y [dap] querían que nos hiciéramos una foto en plan malotas. Tu madre insistió en que [ama] y [eva] revisaran todas las armas antes de la foto."
    sai "[emm] and [dap] wanted us to take a photo looking tough. Your mother insisted that [ama] and [eva] check all the weapons before the photo."

# game/scripts/c26/c26.rpy:1360
translate english c26s003_Sai_1d1ba706:

    # mc "Pero no parecéis malotas. Estáis sonriendo todas. Quizás tú eres la que pareces más seria."
    mc "But you don't look like badass girls. You're all smiling. Maybe you're the one who looks the most serious."

# game/scripts/c26/c26.rpy:1362
translate english c26s003_Sai_67daa2f2:

    # sai "*Risa* Eso es porque en la foto en plan malotas... parecíamos unas drogadictas con el mono."
    sai "*Laugh* That's because in the other photo we didn't look like badasses... we looked like drug addicts with withdrawal symptoms."

# game/scripts/c26/c26.rpy:1363
translate english c26s003_Sai_acd3668e:

    # sai "Las únicas que quedaron bien fueron [kim] y [lis]. Es imposible que esas chicas queden mal en ninguna foto."
    sai "The only ones who looked good were [kim] and [lis]. It's impossible for those girls to look bad in any photo."

# game/scripts/c26/c26.rpy:1364
translate english c26s003_Sai_d4533b0a:

    # mc "*Risa* Quiero verla."
    mc "*Laugh* I want to see it."

# game/scripts/c26/c26.rpy:1366
translate english c26s003_Sai_9684e979:

    # sai "*Risa* ¿No nos conoces aún? Esa foto fue borrada una milésima de segundo después de verla."
    sai "*Laugh* Don't you know us yet? That photo was deleted a millisecond after we saw it."

# game/scripts/c26/c26.rpy:1367
translate english c26s003_Sai_e7b1479f:

    # sai "Somos mujeres. No vamos a conservar una foto en la que salimos mal. Ni siquiera [lis] o [kim] la quisieron conservar."
    sai "We are women. We are not going to keep a photo in which we look bad. Not even [lis] or [kim] wanted to keep it."

# game/scripts/c26/c26.rpy:1368
translate english c26s003_Sai_bb21b568:

    # mc "¡Qué consideradas! *Risa* Les tendré que preguntar a [ama] y a [eva] si había cámaras de seguridad."
    mc "How thoughtful! *Laugh* I'll have to ask [ama] and [eva] if there were any security cameras."

# game/scripts/c26/c26.rpy:1370
translate english c26s003_Sai_9ed8bf3d:

    # sai "Aunque las hubiera, no te enseñarían las grabaciones."
    sai "Even if there were, they wouldn't show you the recordings."

# game/scripts/c26/c26.rpy:1371
translate english c26s003_Sai_b3961c59:

    # mc "¿Por qué?"
    mc "Why?"

# game/scripts/c26/c26.rpy:1373
translate english c26s003_Sai_7f6d57b6:

    # sai "Primero porque era una cosa entre chicas. Segundo porque protegernos incluye destruir cualquier prueba de la existencia de esa foto. *Risa*"
    sai "Firstly, because it was a girls' thing. Secondly, because protecting us includes destroying any evidence of the existence of that photo. *Laugh*"

# game/scripts/c26/c26.rpy:1374
translate english c26s003_Sai_4a345483:

    # sai "Y, por último, porque ellas también quedaron mal. Pueden dar miedo cuando se ponen serias, pero cuando {b}fingen{/b} ser malotas... Quedaron horribles."
    sai "And finally, because they also looked bad. They can be scary when they get serious, but when they pretend to be tough... They looked awful."

# game/scripts/c26/c26.rpy:1375
translate english c26s003_Sai_6dab2001:

    # mc "*Risa* Lo entiendo."
    mc "*Laugh* I get it."

# game/scripts/c26/c26.rpy:1377
translate english c26s003_Sai_5fe243aa:

    # sai "Seguramente hace una semana no les hubiera importado. ¿Ahora? Se están volviendo tan femeninas como el resto."
    sai "A week ago, they probably wouldn't have cared. Now? They're becoming as feminine as the rest of us."

# game/scripts/c26/c26.rpy:1378
translate english c26s003_Sai_d20aaa59:

    # sai "[eva] incluso está empezando a pedir consejos de belleza, aunque no los necesite. Me encanta esa evolución."
    sai "[eva]'s even starting to ask for beauty advice, even though she doesn't need it. I love that development."

# game/scripts/c26/c26.rpy:1379
translate english c26s003_Sai_b225fbf4:

    # mc "Es cierto. Sentirse arropadas por todas vosotras está haciendo que se abran más."
    mc "That's true. Feeling supported by all of you is helping them to open up more."

# game/scripts/c26/c26.rpy:1381
translate english c26s003_Sai_10a6266c:

    # "Te diriges a la cámara que sabes que una de las dos está mirando ahora mismo."
    "You look at the camera that you know one of them is watching right now."

# game/scripts/c26/c26.rpy:1382
translate english c26s003_Sai_62d979c0:

    # mc "Bien hecho, chicas. Estoy orgulloso de vosotras."
    mc "Well done, girls. I'm proud of you."

# game/scripts/c26/c26.rpy:1383
translate english c26s003_Sai_6aba5db1:

    # "Te puedes imaginar que, en algún lugar de la base, suena una risita."
    "You can imagine that somewhere at the base, someone is giggling."

# game/scripts/c26/c26.rpy:1385
translate english c26s003_Sai_a0e077e5:

    # sai "A veces me olvido de que ven y escuchan todo lo que hacemos fuera de las habitaciones y los baños."
    sai "Sometimes I forget that they see and hear everything we do outside the bedrooms and bathrooms."

# game/scripts/c26/c26.rpy:1386
translate english c26s003_Sai_38d5c048:

    # mc "Es fácil olvidarse. Pero de todas formas, no importa. Creo que, cuando nos escuchan hablar de ellas, tienen que pasar la mitad del tiempo ruborizándose."
    mc "It's easy to forget. But anyway, it doesn't matter. I think when they hear us talk about them, they must spend half the time blushing."

# game/scripts/c26/c26.rpy:1387
translate english c26s003_Sai_06cb7834:

    # mc "Aún no he oído a nadie decir nada malo de ellas."
    mc "I haven't heard anyone say anything bad about them yet."

# game/scripts/c26/c26.rpy:1389
translate english c26s003_Sai_2f99dfee:

    # sai "Si alguien dijera algo malo de ellas, no sobreviviría hasta que llegaran a casa para vengarse."
    sai "If anyone said anything bad about them, she wouldn't survive until they got home to take revenge."

# game/scripts/c26/c26.rpy:1390
translate english c26s003_Sai_c3830c33:

    # sai "Destrozaríamos entre todas a quien osara decir algo de nuestras chicas."
    sai "We would all tear apart anyone who dared to say anything about our girls."

# game/scripts/c26/c26.rpy:1392
translate english c26s003_Sai_2124d16f:

    # "Ahora es cuando [sai] se dirige a la cámara."
    "Now it's [sai] who addresses the camera."

# game/scripts/c26/c26.rpy:1393
translate english c26s003_Sai_8ae61518:

    # sai "Y sabéis que lo digo en serio. Todas os queremos."
    sai "And you know I mean it. We love you all."

# game/scripts/c26/c26.rpy:1394
translate english c26s003_Sai_4eaf4fb0:

    # "Estás seguro de que quien esté escuchando se habrá ruborizado, o quizás se le hayan saltado unas lágrimas. No están muy acostumbradas a recibir cariño."
    "You can be sure that whoever is listening is blushing, or perhaps even shedding a tear. They are not used to receiving so much affection."

# game/scripts/c26/c26.rpy:1395
translate english c26s003_Sai_52810f24:

    # "Se van a acostumbrar muy rápido."
    "They'll get used to it very quickly."

# game/scripts/c26/c26.rpy:1397
translate english c26s003_Sai_8de79da5:

    # mc "¿Vais a hacer más lecciones de tiro?"
    mc "Are you going to have more shooting lessons?"

# game/scripts/c26/c26.rpy:1398
translate english c26s003_Sai_47238ed4:

    # sai "[eri] tiene que hacer una, pero será en el bosque. Creo que [eil] también se apuntará, y alguna de las de ayer también."
    sai "[eri] has to take one, but it will be in the forest. I think [eil] will also join, and some of the others from yesterday, too."

# game/scripts/c26/c26.rpy:1399
translate english c26s003_Sai_04baaa1b:

    # sai "Fue muy divertido, y queremos repetirlo. Además, algunas queremos aprender a disparar con otras armas."
    sai "It was great fun, and we want to do it again. Plus, some of us want to learn how to shoot other types of guns."

# game/scripts/c26/c26.rpy:1400
translate english c26s003_Sai_9c72feea:

    # mc "Además es una actividad en grupo para estrechar lazos entre vosotras."
    mc "It is also a group activity that helps strengthen bonds between you."

# game/scripts/c26/c26.rpy:1402
translate english c26s003_Sai_072d9792:

    # sai "*Risa* ¿Estrechar lazos aún más? Vamos a parecer piezas de un corsé a este paso."
    sai "*Laugh* Strengthen bonds between us? We'll look like pieces of a corset at this rate."

# game/scripts/c26/c26.rpy:1404
translate english c26s003_Sai_511e6c4d:

    # sai "En dos semanas aquí he estrechado más lazos de lo que hice el primer año en Portland, cuando vivía en el dormitorio."
    sai "In two weeks here, I've strengthened more bonds than I did in my first year in Portland, when I was living in a dorm."

# game/scripts/c26/c26.rpy:1405
translate english c26s003_Sai_14fc3e69:

    # sai "Incluso con las chicas que no viven en casa, como [sam], [meg], o [oma]."
    sai "Even with girls who don't live at home, like [sam], [meg], or [oma]."

# game/scripts/c26/c26.rpy:1406
translate english c26s003_Sai_91ffeca8:

    # mc "Entonces, ¿no te arrepientes de haber venido?"
    mc "So, you don't regret coming?"

# game/scripts/c26/c26.rpy:1409
translate english c26s003_Sai_5c77a558:

    # sai "No me arrepiento en absoluto. Vine por ti, pero aunque no hubiéramos vuelto a estar juntos, hubiera valido la pena por las chicas."
    sai "I don't regret it at all. I came for you, but even if we hadn't gotten back together, it would have been worth it for the girls."

# game/scripts/c26/c26.rpy:1410
translate english c26s003_Sai_db77d33c:

    # sai "Aunque no hubiera salido bien lo nuestro, la convivencia con esas chicas me hubiera hecho quedarme."
    sai "Even if things hadn't worked out between us, living with those girls would have made me stay."

# game/scripts/c26/c26.rpy:1412
translate english c26s003_Sai_d3dd32b2:

    # sai "No me arrepiento en absoluto. Vine por ti, pero aunque no hemos vuelto a estar juntos, vale la pena por las chicas."
    sai "I don't regret it at all. I came for you, but even though we're not together again, coming was worth it for the girls."

# game/scripts/c26/c26.rpy:1413
translate english c26s003_Sai_433d5145:

    # sai "Tenías razón cuando me dijiste que no centrara mi vida en ti cuando no volvimos juntos, tenía que probar la convivencia con esas chicas para entenderlo."
    sai "You were right when you told me not to focus my life on you when we didn't get back together. I had to experience living with these girls to understand that."

# game/scripts/c26/c26.rpy:1414
translate english c26s003_Sai_8c61827e:

    # mc "Me alegra mucho que seas feliz aquí."
    mc "I'm really glad you're happy here."

# game/scripts/c26/c26.rpy:1416
translate english c26s003_Sai_153f750d:

    # sai "Lo soy. Mucho. Cuando en Portland me hablabas de tu familia no me podía imaginar algo así. Creía que exagerabas y resulta que te quedabas corto."
    sai "I am. Very much so. When you told me about your family back in Portland, I didn't imagine anything like this. I thought you were exaggerating, but it turns out you were understating it."

# game/scripts/c26/c26.rpy:1417
translate english c26s003_Sai_f22ce30f:

    # mc "*Risa* Yo tampoco me podía imaginar algo así. No era así cuando me marché, pero me alegra que lo sea ahora."
    mc "*Laugh* I couldn't imagine that either. It wasn't like this when I left, but I'm glad it is now."

# game/scripts/c26/c26.rpy:1418
translate english c26s003_Sai_815f4a4e:

    # mc "¿Y qué tal con [meg]? A veces me sabe mal haberte pedido que compartas tu habitación con ella."
    mc "And how about [meg]? Sometimes I feel bad for asking you to share your room with her."

# game/scripts/c26/c26.rpy:1420
translate english c26s003_Sai_40d3ff6c:

    # sai "Me lo pediste la semana pasada y no hubo ningún problema. Esta semana ya tiene el coche arreglado y quería volver a su piso después de trabajar."
    sai "You asked me last week, and there was no problem. This week her car was repaired and she wanted to go back to her flat after work."

# game/scripts/c26/c26.rpy:1421
translate english c26s003_Sai_e81e5b4e:

    # sai "No le dejé hacerlo. Para mí, es una más y no me importa compartir la habitación con ella tres días por semana."
    sai "I didn't let her do it. To me, she's just another family girl, and I don't mind sharing a room with her three days a week."

# game/scripts/c26/c26.rpy:1422
translate english c26s003_Sai_6b2bb13f:

    # sai "O aunque fueran todos los días. Es un cielo y si volviera a su piso después de trabajar seguramente no vendría a las comidas. Y no hubiera conocido a Zeus."
    sai "Or even if it was every day. She's a dear, and if she went back to her flat after work, she probably wouldn't have come to lunch. And she wouldn't have met Zeus."

# game/scripts/c26/c26.rpy:1423
translate english c26s003_Sai_7c54ac31:

    # mc "*Risa* Te estás convirtiendo en una Marks por derecho propio."
    mc "*Laugh* You're becoming a Marks in your own right."

# game/scripts/c26/c26.rpy:1425
translate english c26s003_Sai_8e4c9f11:

    # sai "*Risa* He sonado como [eri], ¿verdad?"
    sai "*Laugh* I sounded like [eri], didn't I?"

# game/scripts/c26/c26.rpy:1426
translate english c26s003_Sai_88166954:

    # mc "*Risa* Un poco."
    mc "*Laugh* A little bit."

# game/scripts/c26/c26.rpy:1427
translate english c26s003_Sai_3adc1161:

    # sai "Es un ejemplo que deberíamos seguir todas. Creo que es la persona menos egoísta que he conocido en mi vida."
    sai "She is an example we should all follow. I think she is the least selfish person I have ever met in my life."

# game/scripts/c26/c26.rpy:1428
translate english c26s003_Sai_77f618f8:

    # mc "Tienes razón. Creo que esa sería una buena definición de [eri]."
    mc "You're right. I think that would be a good definition of [eri]."

# game/scripts/c26/c26.rpy:1430
translate english c26s003_Sai_0d9207df:

    # sai "Tener a personas como ella alrededor hace que el resto queramos ser mejores personas."
    sai "Having people like her around makes the rest of us want to be better."

# game/scripts/c26/c26.rpy:1431
translate english c26s003_Sai_9d236609:

    # mc "Será mejor que ella no te oiga decir eso o empezará a justificarse diciendo que lo que ella hace es lo normal en una familia."
    mc "It's best she doesn't hear you say that, or she'll start justifying herself by saying that what she does is normal in a family."

# game/scripts/c26/c26.rpy:1433
translate english c26s003_Sai_05050b7a:

    # "En ese momento sale [meg] de la habitación que comparte con [sai]."
    "At that moment, [meg] leaves the room she shares with [sai]."

# game/scripts/c26/c26.rpy:1434
translate english c26s003_Sai_57953a1b:

    # meg "Bueno, ya he recogido todo y he cambiado las sábanas."
    meg "Well, I've tidied up and changed the sheets."

# game/scripts/c26/c26.rpy:1436
translate english c26s003_Sai_7b197454:

    # sai "No hacía falta que lo hicieras. Me podía ocupar yo de todo."
    sai "You didn't have to do that. I would have taken care of everything myself."

# game/scripts/c26/c26.rpy:1437
translate english c26s003_Sai_5d9bb139:

    # mc "¿Ya vuelves a casa?"
    mc "Are you heading home already?"

# game/scripts/c26/c26.rpy:1439
translate english c26s003_Sai_a3f0c0f9:

    # meg "Ya sabes, hoy es mi día libre y tengo que hacer la colada para que los vestidos estén listos para mañana."
    meg "Yes, today is my day off, and I have to do the laundry so the dresses are ready for tomorrow."

# game/scripts/c26/c26.rpy:1440
translate english c26s003_Sai_ad4e91da:

    # mc "Déjame llevarte la maleta hasta el coche."
    mc "Let me take your suitcase to your car."

# game/scripts/c26/c26.rpy:1442
translate english c26s003_Sai_ea69b5c5:

    # meg "No hace falta. No pesa demasiado."
    meg "That won't be necessary. It's not too heavy."

# game/scripts/c26/c26.rpy:1443
translate english c26s003_Sai_3b674b4d:

    # mc "Insisto. ¿Lo tienes en el garaje de [nor]?"
    mc "I insist. Is it in [nor]'s garage?"

# game/scripts/c26/c26.rpy:1444
translate english c26s003_Sai_f51e1f39:

    # meg "Sí, y gracias."
    meg "Yes, and thank you."

# game/scripts/c26/c26.rpy:1447
translate english c26s003_Sai_65478830:

    # sai "Cuando dejes la maleta de [meg], ¿podrías venir a mi habitación? Necesito tu ayuda con algo."
    sai "After you drop off [meg]'s suitcase, could you come to my room? I need your help with something."

# game/scripts/c26/c26.rpy:1448
translate english c26s003_Sai_07d76d02:

    # mc "Ningún problema. En unos minutos paso a verte."
    mc "No problem. I'll stop by in a few minutes."

# game/scripts/c26/c26.rpy:1450
translate english c26s003_Sai_7609062c:

    # meg "Chicos, puedo bajar la maleta yo sola. Tú tienes que ir a clase en un par de horas y..."
    meg "Guys, I can carry my suitcase myself. You have to go to class in a couple of hours and..."

# game/scripts/c26/c26.rpy:1451
translate english c26s003_Sai_be286a38:

    # mc "[meg], no creo que a [sai] le venga de cinco minutos, ¿verdad?"
    mc "[meg], I don't think [sai] would mind waiting five minutes, would she?"

# game/scripts/c26/c26.rpy:1453
translate english c26s003_Sai_a1ef25a1:

    # sai "Ni de cinco ni de diez. No hay prisa."
    sai "Not five, not ten. There's no rush."

# game/scripts/c26/c26.rpy:1454
translate english c26s003_Sai_b8d733a1:

    # mc "¿Ves?"
    mc "See?"

# game/scripts/c26/c26.rpy:1456
translate english c26s003_Sai_9a580e0c:

    # "Las chicas se despiden con un abrazo y acompañas a [meg] hasta el garaje de [nor]."
    "The girls say goodbye with a hug, and you walk [meg] to [nor]'s garage."

# game/scripts/c26/c26.rpy:1457
translate english c26s003_Sai_6db0a5fe:

    # "Los abrazos se repiten con cada chica que os encontráis por el camino."
    "The hugs are repeated with every girl you meet along the way."

# game/scripts/c26/c26.rpy:1463
translate english c26s003_Sai2_930cdfaf:

    # "Al llegar al garaje de [nor], una vez metida la maleta de [meg] en su coche."
    "When you arrive at [nor]'s garage, after putting [meg]'s suitcase in her car..."

# game/scripts/c26/c26.rpy:1464
translate english c26s003_Sai2_9a071f80:

    # mc "¿Te lo has pasado bien el fin de semana?"
    mc "Did you have a good weekend?"

# game/scripts/c26/c26.rpy:1465
translate english c26s003_Sai2_16039695:

    # meg "Ha sido fantástico. Con Zeus me reí muchísimo ayer."
    meg "It was fantastic. I laughed so much with Zeus yesterday."

# game/scripts/c26/c26.rpy:1466
translate english c26s003_Sai2_d6c49a42:

    # mc "*Risa* No me hables del gato destructor de camas."
    mc "*Laugh* Don't mention the bed-destroying cat."

# game/scripts/c26/c26.rpy:1468
translate english c26s003_Sai2_d4660c91:

    # meg "*Risa* No le eches la culpa al pobre gato. Me han dicho que estabais ocho personas en esa cama."
    meg "*Laugh* Don't blame the poor cat. I've been told there were eight people in that bed."

# game/scripts/c26/c26.rpy:1469
translate english c26s003_Sai2_18754fc0:

    # mc "Sí, pero aguantó bien y no se rompió hasta que no subió Zeus."
    mc "Yes, but it held up well and didn't break until Zeus climbed on it."

# game/scripts/c26/c26.rpy:1474
translate english c26s003_Sai2_243c2fa6:

    # meg "Bueno, me tengo que ir. Debo hacer la colada e ir al supermercado."
    meg "Well, I have to go. I have to do laundry and go to the supermarket."

# game/scripts/c26/c26.rpy:1475
translate english c26s003_Sai2_fc6ca869:

    # mc "Creo que deberías dejar ropa aquí la próxima vez que vengas. No me refiero a los vestidos para el trabajo, pero algo de ropa casual."
    mc "I think you should leave some clothes here next time you come over. I don't mean your work clothes, but some casual clothes."

# game/scripts/c26/c26.rpy:1476
translate english c26s003_Sai2_102a9a67:

    # mc "Cuando vuelvas la semana siguiente, estará limpia, y así sólo necesitas ir y venir con lo que necesites para trabajar."
    mc "When you come back the following week, they will be clean, and then you just need to come and go with whatever you need for work."

# game/scripts/c26/c26.rpy:1478
translate english c26s003_Sai2_85793322:

    # meg "[mar] me dijo lo mismo, pero no quiero darle más trabajo del necesario."
    meg "[mar] told me the same, but I don't want to give her more work than necessary."

# game/scripts/c26/c26.rpy:1479
translate english c26s003_Sai2_3709b1e4:

    # mc "Si ella te lo propuso, es porque no le importa. Piénsalo."
    mc "If she suggested it, it's because she doesn't mind. Think about it."

# game/scripts/c26/c26.rpy:1482
translate english c26s003_Sai2_ea0b53a4:

    # meg "Lo pensaré. Si decido hacerlo antes de que vengas a verme a Westport, quizá te dé un poco de ropa para que la traigas."
    meg "I'll think about it. If I decide to do it before you come to see me in Westport, maybe I'll give you some clothes to bring with you."

# game/scripts/c26/c26.rpy:1483
translate english c26s003_Sai2_17c67712:

    # meg "Así podré venir con una maleta más pequeña, solo con los vestidos. Y no tendrás que cargarla arriba y abajo."
    meg "That way I can bring a smaller suitcase, just with the dresses. And you won't have to carry it up and down."

# game/scripts/c26/c26.rpy:1485
translate english c26s003_Sai2_c03768b0:

    # meg "Lo pensaré. Si decido hacerlo, podré venir con una maleta más pequeña dentro de dos semanas, solo con los vestidos."
    meg "I'll think about it. If I decide to do it, I can come back in two weeks with a smaller suitcase, just with the dresses."

# game/scripts/c26/c26.rpy:1486
translate english c26s003_Sai2_3b48fe12:

    # meg "Y no tendrás que ir arriba y abajo con ella."
    meg "And you won't have to go up and down with it."

# game/scripts/c26/c26.rpy:1487
translate english c26s003_Sai2_f5271567:

    # mc "Me parece una buena idea."
    mc "That sounds like a good idea."

# game/scripts/c26/c26.rpy:1490
translate english c26s003_Sai2_0045e65e:

    # meg "Te veo el fin de semana, o cuando quieras pasar por mi apartamento."
    meg "I'll see you on the weekend, or whenever you want to drop by my apartment."

# game/scripts/c26/c26.rpy:1492
translate english c26s003_Sai2_6f25a080:

    # meg "Te veo el fin de semana que viene."
    meg "See you next weekend."

# game/scripts/c26/c26.rpy:1493
translate english c26s003_Sai2_f19a724f:

    # mc "Conduce con cuidado."
    mc "Drive carefully."

# game/scripts/c26/c26.rpy:1495
translate english c26s003_Sai2_4abe6172:

