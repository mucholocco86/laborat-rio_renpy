    "[mar], [sam], and [bet] insist on slathering you all with sunscreen."

# game/scripts/c32/c32.rpy:4264
translate english c32s006_AmaSecTeam_13a39637:

    # "[aar] te mira como preguntándote si siempre lo van a tratar como a un niño. Te encojes de hombros. Algún día se acostumbrará."
