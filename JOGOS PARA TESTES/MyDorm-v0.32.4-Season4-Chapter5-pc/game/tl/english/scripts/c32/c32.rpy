    # mc "Y yo espero que ocupes el lugar de mi madre mientras ella abraza a [bet] y a [ama]."
    mc "And I hope you take my mother's place while she hugs [bet] and [ama]."

# game/scripts/c32/c32.rpy:2886
translate english c32s004_MarSamArrival_1142ab69:

    # mc "Y yo espero que ocupes el lugar de [mar] mientras ella abraza a [bet] y a [ama]."
    mc "And I hope you take [mar]'s place while she hugs [bet] and [ama]."

# game/scripts/c32/c32.rpy:2889
