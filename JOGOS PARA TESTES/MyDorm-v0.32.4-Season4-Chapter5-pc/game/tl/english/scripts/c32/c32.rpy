    mar "Will the eighth one be [gav]?"

# game/scripts/c32/c32.rpy:4315
translate english c32s006_AmaSecTeam_550257c5:

    # mc "Si todo va como está planeado, sí. Aún está en proceso de recuperación."
    mc "If everything goes as planned, yes. He's still in the recovery process."

# game/scripts/c32/c32.rpy:4317
translate english c32s006_AmaSecTeam_27b38a31:

