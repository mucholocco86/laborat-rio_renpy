    centered "{size=+20}{b}DAY 47 – SATURDAY{/b}{/size}"

# game/scripts/c32/c32.rpy:1926
translate english c32s003_JamPics_b6bfd682:

    # "Al día siguiente, en casa, después de un día de reuniones..."
    "The next day, at home, after a day of meetings..."

# game/scripts/c32/c32.rpy:1927
translate english c32s003_JamPics_da4e93b4:

    # ama "Hoy he pasado a ver a [gav], parece que está muy ilusionado con el encendido del brazo mañana."
    ama "I stopped by to see [gav] today, he seems really excited about the arm being turned on tomorrow."

# game/scripts/c32/c32.rpy:1928
translate english c32s003_JamPics_15682a8e:

    # bet "Se está recuperando mejor de lo que esperaba."
    bet "He's recovering better than I expected."

# game/scripts/c32/c32.rpy:1929
translate english c32s003_JamPics_535588ed:

    # bet "Uno de los cirujanos me ha dicho que es posible que tenga que ver con el envejecimiento acelerado de los clones."
    bet "One of the surgeons told me it might have something to do with the accelerated aging of the clones."

# game/scripts/c32/c32.rpy:1930
translate english c32s003_JamPics_ff9bbd2a:

    # mc "¿Es eso posible?"
    mc "Is that possible?"

# game/scripts/c32/c32.rpy:1932
translate english c32s003_JamPics_5d108e28:

    # bet "No solo es posible, sino que hay muchas probabilidades de que esté influyendo positivamente."
    bet "Not only is it possible, but it's highly likely that it's having a positive influence."

# game/scripts/c32/c32.rpy:1933
translate english c32s003_JamPics_723e38ce:

    # bet "Me sorprendió el estado del muñón cuando lo examiné por primera vez."
    bet "I was surprised by the condition of the stump when I first examined it."

# game/scripts/c32/c32.rpy:1934
translate english c32s003_JamPics_f5d74ae8:

    # bet "No parecía el resultado de una amputación que se hubiera llevado a cabo hace menos de un mes. La cicatrización estaba avanzada."
    bet "It didn't look like the result of an amputation that had taken place less than a month ago. The healing was advanced."

# game/scripts/c32/c32.rpy:1935
translate english c32s003_JamPics_efd02cbc:

    # mc "¡Eso es increíble!"
    mc "That's incredible!"

# game/scripts/c32/c32.rpy:1937
translate english c32s003_JamPics_01018e67:

    # ama "Si los clones masculinos envejecen más rápido, supongo que tiene lógica que se curen más rápido también."
    ama "If male clones age faster, I guess it makes sense that they heal faster too."

# game/scripts/c32/c32.rpy:1938
translate english c32s003_JamPics_3659106d:

    # bet "He pasado los últimos días mirando informes de cirugías y parece que es así casi siempre."
    bet "I've spent the last few days looking at surgery reports, and it seems to be the case almost always."

# game/scripts/c32/c32.rpy:1939
translate english c32s003_JamPics_d1859b2d:

    # mc "¿Casi siempre?"
    mc "Almost always?"

# game/scripts/c32/c32.rpy:1941
translate english c32s003_JamPics_a95f9e48:

    # bet "Los tiempos de recuperación para una herida suelen ser más rápidos en el tejido muscular y óseo."
    bet "Recovery times for a wound are usually faster in muscle and bone tissue."

# game/scripts/c32/c32.rpy:1942
translate english c32s003_JamPics_30646272:

    # bet "Pero no con los órganos internos. Una herida en un pulmón o en el hígado tiende a curarse al mismo ritmo que en..."
    bet "But not with internal organs. A wound to a lung or the liver tends to heal at the same rate as in..."

# game/scripts/c32/c32.rpy:1943
translate english c32s003_JamPics_43dc707d:

    # mc "No digas 'una persona normal'."
    mc "Don't say 'a normal person'."

# game/scripts/c32/c32.rpy:1945
translate english c32s003_JamPics_8846a775:

    # bet "*Risa* Iba a decir 'una persona con envejecimiento estándar.'"
    bet "*Laugh* I was going to say 'a person with standard aging.'"

# game/scripts/c32/c32.rpy:1946
translate english c32s003_JamPics_86f45a26:

    # mc "Tenemos que buscar algún término más apropiado. Y más corto."
    mc "We need to find a more appropriate term. And a shorter one."

# game/scripts/c32/c32.rpy:1948
translate english c32s003_JamPics_9d448dc8:

    # bet "Lo que quería decir es que tengo muchos más datos de heridas en músculos y huesos que en órganos internos."
    bet "What I meant is that I have a lot more data on muscle and bone injuries than on internal organs."

# game/scripts/c32/c32.rpy:1949
translate english c32s003_JamPics_97efaa43:

    # bet "No sé si es un tema del tamaño reducido de la muestra o si es lo que está pasando en realidad."
    bet "I don't know if it's an issue with the small sample size or if that's what is actually happening."

# game/scripts/c32/c32.rpy:1950
translate english c32s003_JamPics_ceb87502:

    # mc "¿Has probado a hablar con [mael] sobre el tema?"
    mc "Have you tried talking to [mael] about it?"

# game/scripts/c32/c32.rpy:1952
translate english c32s003_JamPics_d7ed914d:

    # bet "Todavía no. Seguramente lo haga después de encender el brazo de [gav]."
    bet "Not yet. I'll probably do it after powering up [gav]'s arm."

# game/scripts/c32/c32.rpy:1953
translate english c32s003_JamPics_49e84a7b:

    # bet "Eso me proporcionará más datos. La operación combina tejido muscular, huesos, y tejido nervioso."
    bet "That will provide me with more data. The surgery combines muscle tissue, bone, and nerve tissue."

# game/scripts/c32/c32.rpy:1954
translate english c32s003_JamPics_f326d78f:

    # mc "Lo entiendo. Si ves cómo se recupera cada uno de ellos..."
    mc "I get it. If you see how each of them recovers..."

# game/scripts/c32/c32.rpy:1956
translate english c32s003_JamPics_6d556482:

    # ama "¿Se podría reproducir ese efecto?"
    ama "Could that effect be reproduced?"

# game/scripts/c32/c32.rpy:1957
translate english c32s003_JamPics_64733fed:

    # ama "Me puedo imaginar a [flo] vendiéndoselo a deportistas de élite para curar sus lesiones más rápidamente."
    ama "I can imagine [flo] selling it to elite athletes to heal their injuries faster."

# game/scripts/c32/c32.rpy:1958
translate english c32s003_JamPics_a7de8f72:

    # mc "No lo había pensado... ¿Es posible?"
    mc "I hadn't thought of that... Is it possible?"

# game/scripts/c32/c32.rpy:1960
translate english c32s003_JamPics_c9b6b3cf:

    # bet "Dudo mucho que se pueda reproducir sin acelerar el envejecimiento. Es algo que está en los genes de los chicos."
    bet "I highly doubt it can be reproduced without accelerating aging. It's something in the boys' genes."

# game/scripts/c32/c32.rpy:1961
translate english c32s003_JamPics_50599d7f:

    # bet "Y no creo que nadie acepte si le dices que se va a recuperar en tres meses de una lesión que tardaría seis."
    bet "And I don't think anyone would accept it if you tell them they'll recover in three months from an injury that would normally take six."

# game/scripts/c32/c32.rpy:1962
translate english c32s003_JamPics_75e340f7:

    # bet "Pero que va a perder dos meses de vida con ello. Me estoy inventando los números, antes de que preguntéis."
    bet "But that they'll lose two months of their life in the process. I'm just making up the numbers, before you ask."

# game/scripts/c32/c32.rpy:1963
translate english c32s003_JamPics_f4640ff6:

    # mc "Hay deportistas que están muy locos y que querrían exprimir al máximo su tiempo en la élite."
    mc "There are some crazy athletes out there who would want to squeeze the most out of their time in the elite."

# game/scripts/c32/c32.rpy:1964
translate english c32s003_JamPics_652471e8:

    # mc "Pero no creo que me sintiera cómodo si [deb.nick] lo usara..."
    mc "But I don't think I'd feel comfortable if [deb.nick] used it..."

# game/scripts/c32/c32.rpy:1966
translate english c32s003_JamPics_f7840f1e:

    # ama "Sería su decisión. [deb.nick] es una chica inteligente y dudo que aceptara pagar ese precio."
    ama "It would be her decision. [deb.nick] is a smart girl and I doubt she'd agree to pay that price."

# game/scripts/c32/c32.rpy:1967
translate english c32s003_JamPics_c53f565b:

    # ama "Pero mientras [bet] hablaba, mi cabeza estaba dando vueltas..."
    ama "But while [bet] was talking, my head was spinning..."

# game/scripts/c32/c32.rpy:1968
translate english c32s003_JamPics_4e4b056d:

    # mc "Sorpréndenos."
    mc "Surprise us."

# game/scripts/c32/c32.rpy:1970
translate english c32s003_JamPics_1b1104d8:

    # ama "Parece que la curación funciona diferente según los órganos."
    ama "It seems healing works differently depending on the organs."

# game/scripts/c32/c32.rpy:1971
translate english c32s003_JamPics_79e44b54:

    # ama "Imagina que se pudiera aislar el componente que hace que la piel se cure más rápido."
    ama "Imagine if we could isolate the component that makes skin heal faster."

# game/scripts/c32/c32.rpy:1972
translate english c32s003_JamPics_efa56c08:

    # ama "Envejecería más rápido, pero las heridas se cerrarían antes, previniendo infecciones. Y tener una piel más vieja no va a matar a nadie."
    ama "It would age faster, but wounds would close sooner, preventing infections. And having an older skin isn't going to kill anyone."

## game/scripts/c32/c32.rpy:1974
translate english c32s003_JamPics_6b6bb70a:

    # bet "*Risa* Yo soy una muestra de ello. Aún estoy viva."
    bet "*Laugh* I'm proof of that. I'm still alive."

# game/scripts/c32/c32.rpy:1975
translate english c32s003_JamPics_a556eab7:

    # bet "Pero tienes razón. Si se acelerara la curación de órganos independientes, como la piel, sería un avance increíble."
    bet "But you're right. If the healing of independent organs, like the skin, could be accelerated, it would be an incredible breakthrough."

# game/scripts/c32/c32.rpy:1977
translate english c32s003_JamPics_31a133aa:

    # bet "Por un momento he pensado en algunos lugares de África donde apenas hay antibióticos."
    bet "For a moment I thought about some places in Africa where there are barely any antibiotics."

# game/scripts/c32/c32.rpy:1978
translate english c32s003_JamPics_2f16d33d:

    # bet "Pero sería difícil que ese tipo de tecnología llegara a sitios donde no llega un simple antibiótico."
    bet "But it would be difficult for that kind of technology to reach places where a simple antibiotic can't."

# game/scripts/c32/c32.rpy:1979
translate english c32s003_JamPics_5604c904:

    # mc "¿Creéis que debería hablar con [mael] sobre el tema? Yo pienso que podría ser una buena dirección para la investigación."
    mc "Do you think I should talk to [mael] about it? I think it could be a good direction for the research."

# game/scripts/c32/c32.rpy:1981
translate english c32s003_JamPics_26105e2f:

    # bet "Desde luego." (multiple=2)
    bet "Absolutely." (multiple=2)

# game/scripts/c32/c32.rpy:1982
translate english c32s003_JamPics_91516e54:

    # ama "Sí." (multiple=2)
    ama "Yes." (multiple=2)

# game/scripts/c32/c32.rpy:1983
translate english c32s003_JamPics_0677ebd6:

    # mc "No esperaba otra respuesta... Tengo una reunión con él la semana que viene. Se lo comentaré."
    mc "I didn't expect any other answer... I have a meeting with him next week. I'll mention it to him."

# game/scripts/c32/c32.rpy:1984
translate english c32s003_JamPics_b2085af1:

    # mc "Supongo que a los clones femeninos no se les aplica, ¿cierto?"
    mc "I guess that doesn't apply to female clones, right?"

# game/scripts/c32/c32.rpy:1986
translate english c32s003_JamPics_f33a8b2e:

    # bet "No tienen envejecimiento acelerado, con lo que dudo que se curen más rápido."
    bet "They don't have accelerated aging, so I doubt they heal faster."

# game/scripts/c32/c32.rpy:1988
translate english c32s003_JamPics_24a51902:

    # ama "Nosotras no hemos notado nunca nada. Pero tampoco teníamos con qué comparar."
    ama "We've never noticed anything. But we didn't have anything to compare it with either."

# game/scripts/c32/c32.rpy:1990
translate english c32s003_JamPics_1c135af5:

    # ama "Supongo que habríais notado algo raro en [eri], [dap], o [emm]. Aunque es algo que puede pasar desapercibido."
    ama "I guess you would have noticed something weird with [eri], [dap], or [emm]. Although it's something that can go unnoticed."

# game/scripts/c32/c32.rpy:1991
translate english c32s003_JamPics_7d334e1e:

    # mc "Tenéis razón."
    mc "You guys are right."

# game/scripts/c32/c32.rpy:1993
translate english c32s003_JamPics_aed981fe:

    # bet "*Risa* ¿Nos compramos una camiseta que ponga eso?"
    bet "*Laugh* Should we buy a t-shirt that says that?"

# game/scripts/c32/c32.rpy:1994
translate english c32s003_JamPics_784adad9:

    # ama "*Risa* Sería divertido que nosotras tuviéramos la camiseta y [mc] no la tuviera."
    ama "*Laugh* It would be funny if we had the t-shirt and [mc] didn't."

# game/scripts/c32/c32.rpy:1995
translate english c32s003_JamPics_3ac578d5:

    # mc "*Risa* Creo que [geo], de informática, se nos ha adelantado con lo de la camiseta."
    mc "*Laugh* I think [geo], from IT, beat us to it with the t-shirt thing."

# game/scripts/c32/c32.rpy:1997
translate english c32s003_JamPics_d6424525:

    # bet "*Risa* Tiene un gusto... discutible para la vestimenta."
    bet "*Laugh* He has... questionable taste in clothing."

# game/scripts/c32/c32.rpy:1998
translate english c32s003_JamPics_1846047d:

    # ama "No había hablado nunca con él antes, pero es un tipo tan divertido como sus camisetas."
    ama "I had never talked to him before, but he's as funny as his t-shirts."

# game/scripts/c32/c32.rpy:1999
translate english c32s003_JamPics_1ff74519:

    # ama "En la de hoy ponía 'Si estoy comiendo, no soy de Soporte Técnico. Abre un ticket.'"
    ama "Today's shirt said 'If I'm eating, I'm not Tech Support. Open a ticket.'"

# game/scripts/c32/c32.rpy:2000
translate english c32s003_JamPics_1d8cc47c:

    # mc "Hablando de informática..."
    mc "Speaking of IT..."

# game/scripts/c32/c32.rpy:2001
translate english c32s003_JamPics_ecb12898:

    # mc "[ama], ¿me podrías dejar las fotos de las chicas mañana?"
    mc "[ama], could you lend me the photos of the girls tomorrow?"

# game/scripts/c32/c32.rpy:2003
translate english c32s003_JamPics_7b15896d:

    # ama "¿Qué? ¿Por qué?"
    ama "What? Why?"

# game/scripts/c32/c32.rpy:2004
translate english c32s003_JamPics_7d098f3b:

    # mc "Son las únicas que tienes y no querría que se dañaran más aún."
    mc "They're the only ones you have and I wouldn't want them to get damaged any further."

# game/scripts/c32/c32.rpy:2005
translate english c32s003_JamPics_94d60f6f:

    # mc "Están bastante desvaídas. Una polaroid no es el mejor sistema para mantener algo a largo plazo."
    mc "They're pretty faded. A polaroid isn't the best way to preserve something long-term."

# game/scripts/c32/c32.rpy:2006
translate english c32s003_JamPics_5256d2cf:

    # mc "He pensado en digitalizarlas y mandárselas a Jamaal para ver si puede arreglarlas un poco. Hacer los colores más vivos y esas cosas."
    mc "I thought about digitizing them and sending them to Jamaal to see if he can fix them up a bit. Make the colors more vibrant and stuff."

# game/scripts/c32/c32.rpy:2007
translate english c32s003_JamPics_b6d7f8e8:

    # mc "Solo si tú quieres, claro."
    mc "Only if you want to, of course."

# game/scripts/c32/c32.rpy:2009
translate english c32s003_JamPics_aa9da374:

    # ama "¡Eso sería fantástico! No sé cómo no lo había pensado antes."
    ama "That would be fantastic! I don't know how I didn't think of that before."

# game/scripts/c32/c32.rpy:2011
translate english c32s003_JamPics_bb707e10:

    # bet "Es lógico que no lo hubieras pensado. En tu cabeza, esas fotos están ligadas al formato que tienen."
    bet "It makes sense that you didn't think of it. In your head, those photos are tied to the format they're in."

# game/scripts/c32/c32.rpy:2012
translate english c32s003_JamPics_82a599b1:

    # bet "Y, si eres como yo en esto, no sabrías por dónde empezar a mejorar esas fotos."
    bet "And, if you're like me with this stuff, you wouldn't know where to start to improve those photos."

# game/scripts/c32/c32.rpy:2013
translate english c32s003_JamPics_6fe9ad0f:

    # mc "Yo tampoco soy un genio del PaintStore, pero la broma de [emm] de ayer me dio la idea."
    mc "I'm no PaintStore genius either, but [emm]'s joke yesterday gave me the idea."

# game/scripts/c32/c32.rpy:2015
translate english c32s003_JamPics_ac814da3:

    # ama "¿Qué broma?"
    ama "What joke?"

# game/scripts/c32/c32.rpy:2017
translate english c32s003_JamPics_bd677ef2:

    # "Les explicas la ocurrencia de [emm] con tu camioneta."
    "You explain [emm]'s stunt with your truck."

# game/scripts/c32/c32.rpy:2018
translate english c32s003_JamPics_79664ecc:

    # "[ama] se sorprende de lo poco que llamas a casa. Ella hace doce o trece llamadas diarias."
    "[ama] is surprised by how little you call home. She makes twelve or thirteen calls a day."

# game/scripts/c32/c32.rpy:2019
translate english c32s003_JamPics_8a2afdc4:

    # "A veces hablando con varias de las chicas a la vez."
    "Sometimes talking to several of the girls at once."

# game/scripts/c32/c32.rpy:2020
translate english c32s003_JamPics_3ce79dc8:

    # "Te empiezas a sentir mal porque el trabajo te está absorbiendo demasiado."
    "You start to feel bad because work is absorbing you too much."

# game/scripts/c32/c32.rpy:2024
translate english c32s003_GavArm_10c8f21b:

    # centered "{size=+20}{b}DÍA 48 – DOMINGO{/b}{/size}"
    centered "{size=+20}{b}DAY 48 – SUNDAY{/b}{/size}"

# game/scripts/c32/c32.rpy:2026
translate english c32s003_GavArm_7350183e:

    # bet "¿Estás listo?"
    bet "Are you ready?"

# game/scripts/c32/c32.rpy:2027
translate english c32s003_GavArm_62b2a051:

    # gav "Estoy nervioso."
    gav "I'm nervous."

# game/scripts/c32/c32.rpy:2028
translate english c32s003_GavArm_b724a123:

    # mc "Es normal que lo estés."
    mc "It's normal that you are."

# game/scripts/c32/c32.rpy:2030
translate english c32s003_GavArm_72da5f61:

    # gav "También estoy ansioso. Cuando la Srta. [bet] me dijo que evolucionaba bien, creí que lo podríamos encender antes."
    gav "I'm also anxious. When Ms. [bet] told me I was progressing well, I thought we could turn it on sooner."

# game/scripts/c32/c32.rpy:2031
translate english c32s003_GavArm_f9bd5a44:

    # bet "He preferido mantener la prudencia. Te has curado mejor de lo que esperaba en una semana, pero no tenemos todos los datos aún."
    bet "I preferred to be cautious. You've healed better than I expected in a week, but we don't have all the data yet."

# game/scripts/c32/c32.rpy:2032
translate english c32s003_GavArm_90a13bad:

    # bet "Vamos a quitar el cabestrillo. Intenta mantener el hombro quieto hasta que llegue [cal]."
    bet "Let's take off the sling. Try to keep your shoulder still until [cal] arrives."

# game/scripts/c32/c32.rpy:2034
translate english c32s003_GavArm_85c4b47d:

    # gav "Entiendo que hayas querido ser prudente, pero odio estar encerrado aquí."
    gav "I understand you wanted to be cautious, but I hate being locked up in here."

# game/scripts/c32/c32.rpy:2035
translate english c32s003_GavArm_3a04f4da:

    # bet "No te preocupes. En cuanto llegue [cal] lo encenderemos. Debería estar aquí en unos minutos."
    bet "Don't worry. As soon as [cal] arrives, we'll turn it on. He should be here in a few minutes."

# game/scripts/c32/c32.rpy:2036
translate english c32s003_GavArm_259c2215:

    # mc "Por lo que me ha dicho, iba a revisar los últimos parámetros antes del encendido."
    mc "From what he told me, he was going to check some final parameters before powering it up."

# game/scripts/c32/c32.rpy:2037
translate english c32s003_GavArm_2c240e5b:

    # mc "Piensa que también es importante para él."
    mc "Keep in mind that it's important to him too."

# game/scripts/c32/c32.rpy:2039
translate english c32s003_GavArm_ed482c82:

    # gav "Lo sé, y no quiero sonar desagradecido, pero ver la línea de meta tan cerca, pero que no se acerca, es complicado."
    gav "I know, and I don't want to sound ungrateful, but seeing the finish line so close, yet not getting any closer, is tough."

# game/scripts/c32/c32.rpy:2040
translate english c32s003_GavArm_372ddeac:

    # mc "Lo entiendo. Una vez estuve ingresado en el hospital y los médicos, un día por la mañana, me dijeron que me darían el alta."
    mc "I get it. I was in the hospital once, and one morning the doctors told me I'd be discharged."

# game/scripts/c32/c32.rpy:2041
translate english c32s003_GavArm_20755a4e:

    # mc "El alta no llegó hasta la tarde, y esas horas se hicieron eternas. Sé que no es lo mismo, pero..."
    mc "The discharge didn't come until the afternoon, and those hours dragged on forever. I know it's not the same, but..."

# game/scripts/c32/c32.rpy:2043
translate english c32s003_GavArm_b5d684b5:

    # gav "¿Qué te pasó para que te ingresaran en el hospital?"
    gav "What happened to you to end up in the hospital?"

# game/scripts/c32/c32.rpy:2044
translate english c32s003_GavArm_c4a2e13a:

    # mc "Por aquel entonces era demasiado goloso, y me empaché con los postres de [sam.nick]."
    mc "Back then I had too much of a sweet tooth, and I made myself sick eating [sam.nick]'s desserts."

# game/scripts/c32/c32.rpy:2046
translate english c32s003_GavArm_c7406647:

    # bet "*Risa* Es difícil dejar de comer los postres de [sam.nick]. O los de [mar], o los de [nor]."
    bet "*Laugh* It's hard to stop eating [sam.nick]'s desserts. Or [mar]'s, or [nor]'s."

# game/scripts/c32/c32.rpy:2047
translate english c32s003_GavArm_21945001:

    # mc "Lo sé. Pero tú nunca te has empachado."
    mc "I know. But you've never eaten yourself sick."

# game/scripts/c32/c32.rpy:2048
translate english c32s003_GavArm_3da607c3:

    # bet "*Risa* Yo siempre dejo un hueco en mi barriga por si alguien ha hecho pizza de chocolate y plátano..."
    bet "*Laugh* I always leave a little room in my stomach in case someone made chocolate and banana pizza..."

# game/scripts/c32/c32.rpy:2050
translate english c32s003_GavArm_6f89ce60:

    # gav "Es muy raro..."
    gav "That's really weird..."

# game/scripts/c32/c32.rpy:2051
translate english c32s003_GavArm_49fb39a3:

    # mc "¿Qué te parece tan raro? Aparte de ser una bomba calórica, la pizza de chocolate y plátano está buena."
    mc "What do you find so weird? Aside from being a calorie bomb, chocolate and banana pizza is good."

# game/scripts/c32/c32.rpy:2052
translate english c32s003_GavArm_2bafb0e6:

    # gav "No me refiero a eso. Cuando os vigilábamos erais... no sé... el enemigo."
    gav "I don't mean that. When we were watching you, you were... I don't know... the enemy."

# game/scripts/c32/c32.rpy:2054
translate english c32s003_GavArm_5e2aca3a:

    # gav "Ahora que os empiezo a conocer... Tengo ganas de conocer de nuevo a [nor] y a [mee]. Y pedirles disculpas por lo que pasó."
    gav "Now that I'm starting to get to know you... I'm looking forward to meeting [nor] and [mee] again. And apologizing to them for what happened."

# game/scripts/c32/c32.rpy:2055
translate english c32s003_GavArm_da865680:

    # gav "Y de probar todos esos postres de los que me ha hablado la Srta. [bet]."
    gav "And trying all those desserts Ms. [bet] told me about."

# game/scripts/c32/c32.rpy:2057
translate english c32s003_GavArm_73910ee0:

    # bet "A mí ya me las pediste y te dije que no era necesario. Cumplías órdenes."
    bet "You already apologized to me, and I told you it wasn't necessary. You were following orders."

# game/scripts/c32/c32.rpy:2058
translate english c32s003_GavArm_01cdd2e2:

    # bet "El problema está en quien daba esas órdenes."
    bet "The problem lies with whoever gave those orders."

# game/scripts/c32/c32.rpy:2059
translate english c32s003_GavArm_eba8b333:

    # gav "Lo sé, pero..."
    gav "I know, but..."

# game/scripts/c32/c32.rpy:2060
translate english c32s003_GavArm_17f6d309:

    # bet "Y el siguiente problema es que sigues llamándome 'Srta. [bet].' Pero de eso ya hablaremos."
    bet "And the next problem is that you keep calling me 'Ms. [bet].' But we'll talk about that later."

# game/scripts/c32/c32.rpy:2061
translate english c32s003_GavArm_04274168:

    # mc "A quien vas a tener que pedirle disculpas es a [emm]."
    mc "The one you're going to have to apologize to is [emm]."

# game/scripts/c32/c32.rpy:2063
translate english c32s003_GavArm_0df9484f:

    # gav "¿Por qué? ¡Nunca le hicimos nada!"
    gav "Why? We never did anything to her!"

# game/scripts/c32/c32.rpy:2064
translate english c32s003_GavArm_96da2808:

    # mc "*Risa* Has dicho que tienes ganas de conocer a [nor] y a [mee]. No has dicho nada de ella."
    mc "*Laugh* You said you're looking forward to meeting [nor] and [mee]. You didn't say anything about her."

# game/scripts/c32/c32.rpy:2065
translate english c32s003_GavArm_4d54b127:

    # mc "Pero tranquilo, guardaremos tu secreto."
    mc "But don't worry, we'll keep your secret."

# game/scripts/c32/c32.rpy:2067
translate english c32s003_GavArm_3e3662d8:

    # gav "*Risa* Es una de las principales razones por las que quiero que esto salga bien."
    gav "*Laugh* It's one of the main reasons I want this to go well."

# game/scripts/c32/c32.rpy:2068
translate english c32s003_GavArm_26d360c7:

    # gav "Obviamente, volver a sentirme completo es la principal razón, pero..."
    gav "Obviously, feeling whole again is the main reason, but..."

# game/scripts/c32/c32.rpy:2070
translate english c32s003_GavArm_47c81d0d:

    # gav "Devolverle a vuestra familia parte de lo que os intentamos quitar es una razón importante para mí también."
    gav "Giving your family back part of what we tried to take from you is an important reason for me too."

# game/scripts/c32/c32.rpy:2071
translate english c32s003_GavArm_63da6de0:

    # gav "Sé que me dijiste que, si esto no salía bien, podría ocuparme de la vigilancia, pero..."
    gav "I know you told me that if this didn't work out, I could take care of surveillance, but..."

# game/scripts/c32/c32.rpy:2072
translate english c32s003_GavArm_10d517b8:

    # gav "No sé... veros a través de cámaras no sería lo mismo. Y menos aún con lo que me ha contado la Srta. [bet]."
    gav "I don't know... watching you through cameras wouldn't be the same. And even less so with what Miss [bet] has told me."

# game/scripts/c32/c32.rpy:2073
translate english c32s003_GavArm_5aead583:

    # mc "*Risa* No le hagas demasiado caso a Tía [bet], exagera un poco cuando habla de la familia."
    mc "*Laugh* Don't pay too much attention to Aunt [bet], she exaggerates a bit when she talks about the family."

# game/scripts/c32/c32.rpy:2075
translate english c32s003_GavArm_add21243:

    # bet "¡No he exagerado NI UN ÁPICE! Todo lo que le he contado es verdad."
    bet "I haven't exaggerated ONE BIT! Everything I've told him is true."

# game/scripts/c32/c32.rpy:2076
translate english c32s003_GavArm_565ea2b9:

    # mc "Pero seguro que sólo le has contado las cosas buenas."
    mc "But I'm sure you've only told him the good things."

# game/scripts/c32/c32.rpy:2077
translate english c32s003_GavArm_822e7378:

    # bet "¡Claro! El resto ya lo descubrirá por sí mismo."
    bet "Of course! He'll discover the rest for himself."

# game/scripts/c32/c32.rpy:2079
translate english c32s003_GavArm_f6da07a6:

    # mc "¿Hay alguien a quién tengas ganas de conocer especialmente?"
    mc "Is there anyone you're especially looking forward to meeting?"

# game/scripts/c32/c32.rpy:2080
translate english c32s003_GavArm_15888eb9:

    # gav "A todas las chicas, a Jamaal, a Zeus... Pero creo que, por la información que tengo, a [sca] y a [dap]."
    gav "All the girls, Jamaal, Zeus... But I think, from the information I have, [sca] and [dap]."

# game/scripts/c32/c32.rpy:2081
translate english c32s003_GavArm_6e6f6c12:

    # gav "Y obviamente a [emm], en caso de que esto se esté grabando y el archivo acabe en sus manos."
    gav "And obviously [emm], in case this is being recorded and the file ends up in her hands."

# game/scripts/c32/c32.rpy:2082
translate english c32s003_GavArm_a99a1a6d:

    # mc "*Risa* Buenas elecciones todas. Especialmente lo de [emm]. Nunca sabes qué puede hacerle a tu camioneta si se enfada."
    mc "*Laugh* Good choices all around. Especially [emm]. You never know what she might do to your truck if she gets mad."

# game/scripts/c32/c32.rpy:2084
translate english c32s003_GavArm_522acbfe:

    # cal "Disculpad el retraso. Había algunos ajustes de última hora que tenía que hacer en el servidor."
    cal "Sorry for the delay. There were some last-minute adjustments I had to make on the server."

# game/scripts/c32/c32.rpy:2085
translate english c32s003_GavArm_01eb8a1e:

    # mc "No te preocupes, íbamos a empezar a mordernos las uñas en unos minutos."
    mc "Don't worry, we were going to start biting our nails in a few minutes."

# game/scripts/c32/c32.rpy:2086
translate english c32s003_GavArm_7be86d31:

    # mc "¿Los ajustes han ido bien?"
    mc "Did the adjustments go well?"

# game/scripts/c32/c32.rpy:2088
translate english c32s003_GavArm_9dd41f19:

    # cal "Como el músculo se ha curado mejor de lo que esperábamos, podemos encenderlo con un poco más de potencia."
    cal "Since the muscle has healed better than we expected, we can turn it on with a little more power than planned."

# game/scripts/c32/c32.rpy:2089
translate english c32s003_GavArm_8dc67954:

    # cal "Aproximadamente la misma que tendría un brazo biológico. Creo que será una prueba mejor que con un brazo de potencia reducida."
    cal "Roughly the same as a biological arm would have. I think it will be a better test than with a reduced-power arm."

# game/scripts/c32/c32.rpy:2090
translate english c32s003_GavArm_66f6e46a:

    # cal "El cuerpo y el cerebro de [gav] podrán adaptarse más rápidamente."
    cal "[gav]'s body and brain will be able to adapt more quickly."

# game/scripts/c32/c32.rpy:2091
translate english c32s003_GavArm_66baa76d:

    # mc "Es tu creación. Confío en ti totalmente para esto."
    mc "It's your creation. I trust you completely with this."

# game/scripts/c32/c32.rpy:2092
translate english c32s003_GavArm_6fa062ba:

    # mc "¿Alguna pregunta, [gav]?"
    mc "Any questions, [gav]?"

# game/scripts/c32/c32.rpy:2094
translate english c32s003_GavArm_dee17e91:

    # gav "¿Qué tengo que hacer cuando lo enciendas?"
    gav "What do I have to do when you turn it on?"

# game/scripts/c32/c32.rpy:2095
translate english c32s003_GavArm_f336953f:

    # gav "¿Tengo que dejar la mente en blanco o algo así?"
    gav "Do I have to clear my mind or something like that?"

# game/scripts/c32/c32.rpy:2096
translate english c32s003_GavArm_897fea52:

    # cal "Justo lo contrario. Tienes que pensar lo que quieres hacer con el brazo, como harías con el izquierdo."
    cal "Just the opposite. You have to think about what you want to do with the arm, just like you would with your left one."

# game/scripts/c32/c32.rpy:2097
translate english c32s003_GavArm_4ff43c89:

    # cal "Empezaremos con pruebas sencillas, como tocarte la frente, primero con el brazo biológico y después con la prótesis."
    cal "We'll start with simple tests, like touching your forehead, first with your biological arm and then with the prosthesis."

# game/scripts/c32/c32.rpy:2098
translate english c32s003_GavArm_1c928c5b:

    # cal "Con la prótesis, intenta hacer los movimientos lentamente. No queremos que tu dedo atraviese tu cráneo si lo haces demasiado rápido."
    cal "With the prosthesis, try to make the movements slowly. We don't want your finger to pierce your skull if you do it too fast."

# game/scripts/c32/c32.rpy:2099
translate english c32s003_GavArm_672b0293:

    # mc "*Sorprendido* ¿Puede hacer eso?"
    mc "*Surprised* Can it do that?"

# game/scripts/c32/c32.rpy:2101
translate english c32s003_GavArm_1a2e1b91:

    # cal "Seguramente ahora mismo no, con la potencia que le he asignado. En funcionamiento completo, podría hacerlo."
    cal "Probably not right now, with the power I've assigned to it. But at full capacity, it could."

# game/scripts/c32/c32.rpy:2102
translate english c32s003_GavArm_c1d95887:

    # cal "Pero para cuando subamos la potencia al máximo, [gav] ya estará acostumbrado al peso y a la velocidad de reacción."
    cal "But by the time we turn the power up to the max, [gav] will already be used to the weight and reaction speed."

# game/scripts/c32/c32.rpy:2104
translate english c32s003_GavArm_2e3372dd:

    # bet "No te preocupes, cielo. No vas a romperte ningún hueso hoy. Iremos subiendo la potencia en los próximos días."
    bet "Don't worry, sweetie. You're not going to break any bones today. We'll gradually increase the power over the next few days."

# game/scripts/c32/c32.rpy:2105
translate english c32s003_GavArm_2afa93cd:

    # gav "OK. Entendido. Pensar qué gesto quiero hacer y esperar que el brazo lo entienda y lo haga a una velocidad normal."
    gav "OK. Got it. Think about what gesture I want to make and hope the arm understands it and does it at a normal speed."

# game/scripts/c32/c32.rpy:2106
translate english c32s003_GavArm_2b493bc2:

    # bet "Normal no. Más lento de lo normal. No te puedes romper el cráneo, pero te podrías sacar un ojo."
    bet "Not normal. Slower than normal. You won't break your skull, but you could poke an eye out."

# game/scripts/c32/c32.rpy:2107
translate english c32s003_GavArm_a36fb724:

    # gav "Entendido. Cuando queráis."
    gav "Understood. Whenever you're ready."

# game/scripts/c32/c32.rpy:2109
translate english c32s003_GavArm_38c4a54f:

    # cal "En cuanto lo encienda, notarás un hormigueo en el hombro y la sensación de miembro fantasma al cabo de unos segundos."
    cal "As soon as I turn it on, you'll feel a tingling in your shoulder and a phantom limb sensation after a few seconds."

# game/scripts/c32/c32.rpy:2110
translate english c32s003_GavArm_b47e3fce:

    # cal "A diferencia de un miembro fantasma de verdad, el brazo reaccionará a tus pensamientos porque realmente está ahí."
    cal "Unlike a real phantom limb, the arm will react to your thoughts because it's actually there."

# game/scripts/c32/c32.rpy:2111
translate english c32s003_GavArm_e88c9348:

    # cal "¿Preparado?"
    cal "Ready?"

# game/scripts/c32/c32.rpy:2112
translate english c32s003_GavArm_d8c0d925:

    # gav "Acojonado, pero preparado."
    gav "Scared shitless, but ready."

# game/scripts/c32/c32.rpy:2114
translate english c32s003_GavArm_920b6c07:

    # cal "Ya está. En cuanto sientas el hormigueo piensa en el movimiento que quieres hacer. Aunque empezaremos con el brazo biológico."
    cal "There you go. As soon as you feel the tingling, think about the movement you want to make. Although we'll start with the biological arm."

# game/scripts/c32/c32.rpy:2115
translate english c32s003_GavArm_8c0fd058:

    # cal "De momento es mejor que no pienses en moverlo. Moverás el izquierdo, y después intentarás repetir el movimiento con el derecho."
    cal "For now, it's best you don't think about moving it. You'll move the left one, and then try to repeat the movement with the right one."

# game/scripts/c32/c32.rpy:2116
translate english c32s003_GavArm_6b826ef0:

    # cal "Al principio tiene que ser un pensamiento consciente o tu subconsciente tomará el control."
    cal "At first, it has to be a conscious thought, or your subconscious will take control."

# game/scripts/c32/c32.rpy:2117
translate english c32s003_GavArm_a788a8e6:

    # cal "Poco a poco deberías acostumbrarte a la sensación y lo acabarás notando como el otro brazo."
    cal "Step by step, you should get used to the sensation and you'll end up feeling it just like the other arm."

# game/scripts/c32/c32.rpy:2118
translate english c32s003_GavArm_a88810b9:

    # gav "Ya empiezo a notar el hormigueo. Es como si tuviera el brazo entumecido. Pero lo noto."
    gav "I'm already starting to feel the tingling. It's like my arm is numb. But I feel it."

# game/scripts/c32/c32.rpy:2119
translate english c32s003_GavArm_dcd32898:

    # cal "Genial. Eso es lo que esperábamos. Ahora cierra la mano izquierda y..."
    cal "Great. That's what we expected. Now close your left hand and..."

# game/scripts/c32/c32.rpy:2121
translate english c32s003_GavArm_d3fb0ca3:

    # "El brazo salta de golpe y empieza a moverse en un gesto que conoces muy bien de tus tiempos de adolescente."
    "The arm suddenly jerks and starts moving in a gesture you know very well from your teenage years."

# game/scripts/c32/c32.rpy:2122
translate english c32s003_GavArm_04aaece0:

    # gav "¿Qué? ¡Para eso! ¡No es eso lo que quería hacer!"
    gav "What? Stop that! That's not what I wanted to do!"

# game/scripts/c32/c32.rpy:2123
translate english c32s003_GavArm_8770cab2:

    # cal "Dame un segundo. Intenta mantener el brazo quieto."
    cal "Give me a second. Try to keep the arm still."

# game/scripts/c32/c32.rpy:2125
translate english c32s003_GavArm_f5d9d106:

    # cal "Hecho. Desconectado. Déjame mirar unos parámetros."
    cal "Done. Disconnected. Let me check some parameters."

# game/scripts/c32/c32.rpy:2126
translate english c32s003_GavArm_4ae4dbe7:

    # bet "¿Qué ha pasado? ¿Cómo lo has notado?"
    bet "What happened? How did it feel?"

# game/scripts/c32/c32.rpy:2127
translate english c32s003_GavArm_54dc25cc:

    # gav "Lo notaba como si hubiera dormido encima del brazo durante horas, pero como si fuera mío."
    gav "It felt like I'd slept on my arm for hours, but like it was mine."

# game/scripts/c32/c32.rpy:2129
translate english c32s003_GavArm_76b4d919:

    # gav "No sé por qué ha hecho... esos movimientos... No he pensado en moverlo. [cal] ha dicho que los primeros movimientos serían con el de verdad."
    gav "I don't know why it made... those movements... I didn't think about moving it. [cal] said the first movements would be with the real one."

# game/scripts/c32/c32.rpy:2130
translate english c32s003_GavArm_6bce648b:

    # mc "[cal] ha dicho que. si no lo controlabas con un pensamiento consciente, tu subconsciente tomaría el control..."
    mc "[cal] said that if you didn't control it with a conscious thought, your subconscious would take over..."

# game/scripts/c32/c32.rpy:2132
translate english c32s003_GavArm_4c36d11f:

    # gav "Pero no estaba pensando en... eso..."
    gav "But I wasn't thinking about... that..."

# game/scripts/c32/c32.rpy:2133
translate english c32s003_GavArm_3aee887d:

    # mc "El subconsciente puede ser un auténtico hijo de puta, [gav]. Y si eres diestro, supongo que llevas semanas sin..."
    mc "The subconscious can be a real son of a bitch, [gav]. And if you're right-handed, I guess you've gone weeks without..."

# game/scripts/c32/c32.rpy:2134
translate english c32s003_GavArm_37aae690:

    # gav "Pero no hubiese querido hacerlo... y menos aún aquí delante de la Srta. [bet], de ti, y de [cal]..."
    gav "But I wouldn't have wanted to do it... let alone here in front of Miss [bet], you, and [cal]..."

# game/scripts/c32/c32.rpy:2136
translate english c32s003_GavArm_33c9f972:

    # bet "Incluso no te lo recomendaría en las primeras semanas, hasta que tengas control del brazo."
    bet "I wouldn't even recommend it in the first few weeks, until you have control of the arm."

# game/scripts/c32/c32.rpy:2137
translate english c32s003_GavArm_762cdd70:

    # bet "Recuerda que es más fuerte que el brazo original. No quieres acabar con tus tesoros espachurrados entre plástico y titanio."
    bet "Remember that it's stronger than your original arm. You don't want to end up with your family jewels squashed between plastic and titanium."

# game/scripts/c32/c32.rpy:2138
translate english c32s003_GavArm_5e5c9dc1:

    # mc "¡Que poco tacto tienes, Tía [bet]!"
    mc "You're so tactless, Aunt [bet]!"

# game/scripts/c32/c32.rpy:2140
translate english c32s003_GavArm_e7a03cc8:

    # bet "Si el chico no lo ha pensado conscientemente y lo intenta esta noche, podría tener un accidente."
    bet "If the kid hasn't consciously thought about it and tries it tonight, he could have an accident."

# game/scripts/c32/c32.rpy:2141
translate english c32s003_GavArm_f53b0e63:

    # "[bet] no abre el puño, ilustrando en la mente de los tres hombres alrededor de la mesa un dolor que os podéis imaginar perfectamente."
    "[bet] keeps her fist closed, illustrating in the minds of the three men around the table a pain you can perfectly imagine."

# game/scripts/c32/c32.rpy:2142
translate english c32s003_GavArm_c6f6b944:

    # bet "Mejor que esté sobre aviso. Además, no sé cómo de agradable será el tacto en una zona sensible."
    bet "It's better if he's warned. Besides, I don't know how pleasant the touch will be in a sensitive area."

# game/scripts/c32/c32.rpy:2143
translate english c32s003_GavArm_ddb08430:

    # mc "Creo que yo puedo pasar sin esa información."
    mc "I think I can do without that information."

# game/scripts/c32/c32.rpy:2145
translate english c32s003_GavArm_56a556e3:

    # cal "Hecho. He ajustado algún parámetro. ¿Probamos a encenderlo otra vez?"
    cal "Done. I've adjusted a parameter. Shall we try turning it on again?"

# game/scripts/c32/c32.rpy:2146
translate english c32s003_GavArm_8c65d973:

    # mc "¿Puedes gestionar los pensamientos subconscientes?"
    mc "Can you manage subconscious thoughts?"

# game/scripts/c32/c32.rpy:2147
translate english c32s003_GavArm_2c36f5c7:

    # cal "No. Lo que he hecho es introducir un retraso en la respuesta."
    cal "No. What I've done is introduce a delay in the response."

# game/scripts/c32/c32.rpy:2148
translate english c32s003_GavArm_5add1a99:

    # cal "Si un pensamiento subconsciente intenta tomar el control y [gav] se da cuenta, podrá rectificar con un pensamiento consciente."
    cal "If a subconscious thought tries to take control and [gav] realizes it, he can rectify it with a conscious thought."

# game/scripts/c32/c32.rpy:2149
translate english c32s003_GavArm_ac38b695:

    # cal "¿Puedes ayudar a [gav] a poner el brazo encima de la mesa?"
    cal "Can you help [gav] put his arm on the table?"

# game/scripts/c32/c32.rpy:2151
translate english c32s003_GavArm_bd9861b3:

    # cal "Ahora notarás que el brazo tarda un poco en reaccionar a lo que le ordenes. Iremos gestionando eso tal como te adaptes."
    cal "Now you'll notice that the arm takes a little while to react to what you command it. We'll manage that as you adapt."

# game/scripts/c32/c32.rpy:2152
translate english c32s003_GavArm_e88c9348_1:

    # cal "¿Preparado?"
    cal "Ready?"

# game/scripts/c32/c32.rpy:2153
translate english c32s003_GavArm_7c5c6ada:

    # gav "Estoy más acojonado que antes, pero estoy preparado."
    gav "I'm even more scared shitless than before, but I'm ready."

# game/scripts/c32/c32.rpy:2154
translate english c32s003_GavArm_916d8ecb:

    # cal "Piensa en mantener la mano sobre la mesa. Las dos manos sobre la mesa."
    cal "Think about keeping your hand on the table. Both hands on the table."

# game/scripts/c32/c32.rpy:2156
translate english c32s003_GavArm_5e77f1ba:

    # cal "Hecho."
    cal "Done."

# game/scripts/c32/c32.rpy:2157
translate english c32s003_GavArm_0b8b462a:

    # "Todos miráis fijamente el brazo de titanio. Se empieza a mover con ligeros espasmos. Pero nada que ver con los movimientos anteriores."
    "You all stare at the titanium arm. It starts to move with slight twitches. But nothing like the previous movements."

# game/scripts/c32/c32.rpy:2158
translate english c32s003_GavArm_e6173868:

    # gav "Juro que estoy pensando en mantenerlo quieto."
    gav "I swear I'm thinking about keeping it still."

# game/scripts/c32/c32.rpy:2159
translate english c32s003_GavArm_841dc95d:

    # bet "Lo estás haciendo muy bien, cielo."
    bet "You're doing great, honey."

# game/scripts/c32/c32.rpy:2160
translate english c32s003_GavArm_a25d3cb7:

    # cal "Dale al brazo un poco de tiempo para entender cómo piensas."
    cal "Give the arm a little time to understand how you think."

# game/scripts/c32/c32.rpy:2161
translate english c32s003_GavArm_d60f5ece:

    # cal "Recuerda que hemos introducido un pequeño retraso entre lo que piensas y lo que el brazo hace."
    cal "Remember that we've introduced a slight delay between what you think and what the arm does."

# game/scripts/c32/c32.rpy:2162
translate english c32s003_GavArm_4895d3ae:

    # mc "Y no sé si servirá de algo, pero relájate. Como diría [emm], es jodido tener que pensar en todo momento."
    mc "And I don't know if it'll do any good, but relax. As [emm] would say, it's a bitch having to think all the time."

# game/scripts/c32/c32.rpy:2164
translate english c32s003_GavArm_3b1579f9:

    # "Al cabo de unos minutos, el brazo se queda totalmente inmóvil."
    "After a few minutes, the arm goes completely still."

# game/scripts/c32/c32.rpy:2166
translate english c32s003_GavArm_b8746d3c:

    # gav "¡Lo he hecho! Está quieto."
    gav "I did it! It's still."

# game/scripts/c32/c32.rpy:2167
translate english c32s003_GavArm_426fc2c6:

    # mc "Te he dicho que podrías hacerlo."
    mc "I told you, you could do it."

# game/scripts/c32/c32.rpy:2168
translate english c32s003_GavArm_ac25214a:

    # bet "¡Muy bien, cielo!"
    bet "Great job, sweetie!"

# game/scripts/c32/c32.rpy:2169
translate english c32s003_GavArm_e42d1294:

    # cal "Bueno, realmente se han acabado las baterías..."
    cal "Well, the batteries actually died..."

# game/scripts/c32/c32.rpy:2171
translate english c32s003_GavArm_0e48af55:

    # bet "¿Tan rápido?" (multiple=2)
    bet "That fast?" (multiple=2)

# game/scripts/c32/c32.rpy:2172
translate english c32s003_GavArm_82e95baf:

    # gav "¿Qué? ¿Ya?" (multiple=2)
    gav "What? Already?" (multiple=2)

# game/scripts/c32/c32.rpy:2173
translate english c32s003_GavArm_9d363c81:

    # mc "Creía que durarían más de un par de minutos. ¿O es porque estamos con carga de pruebas?"
    mc "I thought they'd last more than a couple of minutes. Or is it because we're using a test charge?"

# game/scripts/c32/c32.rpy:2174
translate english c32s003_GavArm_c5728af2:

    # cal "Es broma. Duran más de una semana con este nivel de carga. Alrededor de diez días con carga completa."
    cal "Just kidding. They last over a week on this charge level. Around ten days on a full charge."

# game/scripts/c32/c32.rpy:2175
translate english c32s003_GavArm_78bf9afd:

    # cal "Pero mirad."
    cal "But look."

# game/scripts/c32/c32.rpy:2177
translate english c32s003_GavArm_55d8c126:

    # "En el momento en que [gav] ha dejado de pensar en mantener el brazo quieto, su subconsciente ha tomado el mando."
    "The moment [gav] stopped thinking about keeping his arm still, his subconscious took over."

# game/scripts/c32/c32.rpy:2178
translate english c32s003_GavArm_4697f8e8:

    # "Ha hecho el mismo gesto que hubiera hecho con su brazo biológico."
    "He made the exact same gesture he would have made with his biological arm."

# game/scripts/c32/c32.rpy:2179
translate english c32s003_GavArm_d968e801:

    # gav "¡Funciona!"
    gav "It works!"

# game/scripts/c32/c32.rpy:2180
translate english c32s003_GavArm_dad22c5f:

    # mc "Parece que [cal] es un cabrón astuto."
    mc "Looks like [cal] is a crafty bastard."

# game/scripts/c32/c32.rpy:2181
translate english c32s003_GavArm_9ae3de6e:

    # bet "Te ha hecho dejar de pensar en el brazo por un segundo."
    bet "He made you stop thinking about the arm for a second."

# game/scripts/c32/c32.rpy:2182
translate english c32s003_GavArm_8ab09fce:

    # cal "Sabía que sería difícil que se relajara si estaba pensando en el brazo..."
    cal "I knew it would be hard for him to relax if he was thinking about the arm..."

# game/scripts/c32/c32.rpy:2183
translate english c32s003_GavArm_22479201:

    # mc "Lo has hecho bien, [cal]."
    mc "You did good, [cal]."

# game/scripts/c32/c32.rpy:2184
translate english c32s003_GavArm_89abc18e:

    # mc "¿Cuál es el siguiente paso?"
    mc "What's the next step?"

# game/scripts/c32/c32.rpy:2186
translate english c32s003_GavArm_da8f30a4:

    # cal "Tenemos un montón de pruebas y de entrenamiento por delante."
    cal "We have a lot of testing and training ahead of us."

# game/scripts/c32/c32.rpy:2187
translate english c32s003_GavArm_f71a2802:

    # cal "Los parámetros que muestran los gráficos están dentro de lo esperado."
    cal "The parameters shown on the graphs are within what I expected."

# game/scripts/c32/c32.rpy:2188
translate english c32s003_GavArm_e5c9dfdc:

    # cal "Habrá que hacer ajustes, pero vamos en el buen camino."
    cal "We'll have to make adjustments, but we're on the right track."

# game/scripts/c32/c32.rpy:2189
translate english c32s003_GavArm_3731ac97:

    # mc "Tu prioridad absoluta ahora mismo es que ese brazo funcione tal y como lo diseñaste."
    mc "Your absolute priority right now is to get that arm working exactly as you designed it."

# game/scripts/c32/c32.rpy:2191
translate english c32s003_GavArm_4affd92c:

    # cal "Pero [mael]..."
    cal "But [mael]..."

# game/scripts/c32/c32.rpy:2192
translate english c32s003_GavArm_918d8213:

    # mc "Si [mael] tiene alguna duda sobre mi orden de prioridades, dile que la puerta de mi despacho está abierta."
    mc "If [mael] has any doubts about my priorities, tell him the door to my office is open."

# game/scripts/c32/c32.rpy:2194
translate english c32s003_GavArm_51ad5f10:

    # bet "*Risa* Si [car] le deja entrar, claro."
    bet "*Laugh* If [car] lets him in, of course."

# game/scripts/c32/c32.rpy:2195
translate english c32s003_GavArm_a4678617:

    # gav "[car] es una buena mujer, Srta. [bet]."
    gav "[car] is a good woman, Miss [bet]."

# game/scripts/c32/c32.rpy:2196
translate english c32s003_GavArm_74bf70db:

    # cal "Sí, pero puede dar miedo y ser sobreprotectora con... Bueno, con sus prerrogativas como secretaria."
    cal "Yeah, but she can be scary and overprotective with... Well, with her prerogatives as a secretary."

# game/scripts/c32/c32.rpy:2197
translate english c32s003_GavArm_8fba4473:

    # mc "¿Podemos seguir con las pruebas? Me gustaría ver algún progreso antes de mi siguiente reunión."
    mc "Can we continue with the tests? I'd like to see some progress before my next meeting."

# game/scripts/c32/c32.rpy:2198
translate english c32s003_GavArm_afb76904:

    # mc "Me refiero al progreso planificado. Que [gav] se esté cruzando de brazos me indica que todo va a ir bien."
    mc "I mean the planned progress. The fact that [gav] is crossing his arms tells me everything is going to be fine."

# game/scripts/c32/c32.rpy:2200
translate english c32s003_GavArm_f8bcad4c:

    # "Durante los siguientes minutos, [gav] hace ejercicios básicos, como abrir y cerrar ambas manos a la vez o levantarlas de la mesa."
    "For the next few minutes, [gav] does basic exercises, like opening and closing both hands at the same time or lifting them off the table."

# game/scripts/c32/c32.rpy:2201
translate english c32s003_GavArm_7db94244:

    # "El brazo mecánico tarda un poco en reaccionar, tal y como esperabais."
    "The mechanical arm takes a bit to react, just as you expected."

# game/scripts/c32/c32.rpy:2203
translate english c32s003_GavArm_20e68520:

    # cal "Dadme un segundo para que retoque los parámetros de retraso. Creo que vamos por el buen camino."
    cal "Give me a second to tweak the delay parameters. I think we're on the right track."

# game/scripts/c32/c32.rpy:2204
translate english c32s003_GavArm_0a7083da:

    # mc "¿Cómo te sientes, [gav]? Recuerda que es el primer día y no creo que sea bueno que fuerces demasiado."
    mc "How are you feeling, [gav]? Remember it's the first day and I don't think it's a good idea to push yourself too hard."

# game/scripts/c32/c32.rpy:2205
translate english c32s003_GavArm_66f06a31:

    # bet "[mc] tiene razón. Tus músculos no están curados del todo."
    bet "[mc] is right. Your muscles aren't completely healed."

# game/scripts/c32/c32.rpy:2206
translate english c32s003_GavArm_1a1bbf51:

    # gav "No me duele nada ni me siento cansado..."
    gav "Nothing hurts and I don't feel tired..."

# game/scripts/c32/c32.rpy:2208
translate english c32s003_GavArm_e12aa78b:

    # gav "Hablando de eso... ¿El brazo nuevo puede cansarse? ¿Cómo lo notaré?"
    gav "Speaking of which... Can the new arm get tired? How will I notice?"

# game/scripts/c32/c32.rpy:2209
translate english c32s003_GavArm_50d54b4d:

    # cal "Es complicado de explicar. Hay dos tipos de fatiga. Periférica y central."
    cal "It's complicated to explain. There are two types of fatigue. Peripheral and central."

# game/scripts/c32/c32.rpy:2211
translate english c32s003_GavArm_cacee1d5:

    # cal "La fatiga periférica se debe a el exceso o defecto de algunos compuestos químicos. Esa no la notarás, al menos en el brazo, pero sí en el hombro."
    cal "Peripheral fatigue is due to an excess or lack of certain chemical compounds. You won't notice that, at least not in the arm, but you will in the shoulder."

# game/scripts/c32/c32.rpy:2212
translate english c32s003_GavArm_a048237b:

    # cal "La fatiga central se produce porque tu cerebro sabe que deberías estar llegando a tu límite de ejercicio."
    cal "Central fatigue occurs because your brain knows you should be reaching your exercise limit."

# game/scripts/c32/c32.rpy:2213
translate english c32s003_GavArm_ece65c24:

    # cal "Reduce la frecuencia y la intensidad de las señales eléctricas que manda a los músculos."
    cal "It reduces the frequency and intensity of the electrical signals it sends to the muscles."

# game/scripts/c32/c32.rpy:2215
translate english c32s003_GavArm_786b3dd3:

    # cal "También hay un cambio de balance en los compuestos químicos, como serotonina o dopamina."
    cal "There's also a change in the balance of chemical compounds, like serotonin or dopamine."

# game/scripts/c32/c32.rpy:2216
translate english c32s003_GavArm_6234604c:

    # cal "Eso hace que TÚ te notes cansado."
    cal "That makes YOU feel tired."

# game/scripts/c32/c32.rpy:2217
translate english c32s003_GavArm_41548868:

    # cal "Como tu hombro sigue siendo biológico y tu cerebro cree que tu brazo también lo es, es posible que sientas ese tipo de fatiga, aunque reducida."
    cal "Since your shoulder is still biological and your brain thinks your arm is too, it's possible you'll feel that kind of fatigue, although reduced."

# game/scripts/c32/c32.rpy:2218
translate english c32s003_GavArm_85a77c27:

    # cal "Aunque creo que eso te lo podrá explicar mejor la Srta. [bet]."
    cal "Although I think Ms. [bet] will be able to explain that better than me."

# game/scripts/c32/c32.rpy:2219
translate english c32s003_GavArm_0c1ec4f5:

    # cal "Ya he reajustado el retraso. Prueba a repetir los ejercicios ahora."
    cal "I've readjusted the delay. Try repeating the exercises now."

# game/scripts/c32/c32.rpy:2221
translate english c32s003_GavArm_24d6121a:

    # "[gav] repite los ejercicios de nuevo. Esta vez no se aprecia retraso en la copia de los movimientos."
    "[gav] repeats the exercises again. This time there is no noticeable delay in copying the movements."

# game/scripts/c32/c32.rpy:2222
translate english c32s003_GavArm_f8a2fb37:

    # cal "Sigue habiendo unos milisegundos de retraso, pero lo iremos corrigiendo."
    cal "There are still a few milliseconds of delay, but we'll keep fixing it."

# game/scripts/c32/c32.rpy:2223
translate english c32s003_GavArm_eac86c48:

    # gav "Ahora se nota más natural... Es casi como si el brazo fuera mío."
    gav "It feels more natural now... It's almost as if the arm were mine."

# game/scripts/c32/c32.rpy:2224
translate english c32s003_GavArm_5c5a6a8d:

    # gav "Tengo ganas de probarlo en el campo de tiro."
    gav "I can't wait to try it at the shooting range."

# game/scripts/c32/c32.rpy:2225
translate english c32s003_GavArm_1e16ffdd:

    # bet "Para eso aún faltan algunos días, cielo. Acabas de aprender a cerrar las dos manos a la vez."
    bet "That's still a few days away, sweetie. You just learned to close both hands at the same time."

# game/scripts/c32/c32.rpy:2227
translate english c32s003_GavArm_0d9d7253:

    # mc "Me alegro mucho por ti, [gav]. Y por ti, [cal]. Buen trabajo."
    mc "I'm really happy for you, [gav]. And for you, [cal]. Great job."

# game/scripts/c32/c32.rpy:2228
translate english c32s003_GavArm_e71f44d7:

    # mc "Ahora os tengo que dejar; tengo una reunión en unos minutos. Gracias a todos por esto."
    mc "I have to leave you guys now; I have a meeting in a few minutes. Thank you all for this."

# game/scripts/c32/c32.rpy:2230
translate english c32s003_GavArm_e3922a20:

    # gav "Gracias a ti, [mc]."
    gav "Thank you, [mc]."

# game/scripts/c32/c32.rpy:2231
translate english c32s003_GavArm_bed27aab:

    # "El tacto del brazo mecánico se nota raro durante el inesperado abrazo. La ternura del abrazo compensa su extrañeza."
    "The touch of the mechanical arm feels weird during the unexpected hug. The tenderness of the embrace makes up for its strangeness."

# game/scripts/c32/c32.rpy:2232
translate english c32s003_GavArm_76f7c807:

    # "Por un momento, antes de devolver el abrazo, entiendes cómo se siente [aar]."
    "For a moment, before returning the hug, you understand how [aar] feels."

# game/scripts/c32/c32.rpy:2233
translate english c32s003_GavArm_790b6cbf:

    # mc "*Risa* Creo que pasas demasiado tiempo con Tía [bet]."
    mc "*Laugh* I think you spend too much time with Aunt [bet]."

# game/scripts/c32/c32.rpy:2236
translate english c32s003_GavArm_20eda20b:

    # gav "¡Perdón, Señor! Me he extralimitado."
    gav "Sorry, Sir! I overstepped."

# game/scripts/c32/c32.rpy:2237
translate english c32s003_GavArm_317a2055:

    # mc "No lo has hecho, [gav]. Si me río por algo que haga alguien, significa que no me molesta."
    mc "You didn't, [gav]. If I laugh at something someone does, it means it doesn't bother me."

# game/scripts/c32/c32.rpy:2238
translate english c32s003_GavArm_3ff9ae72:

    # mc "Al menos sabemos que puedes dar abrazos sin partirle las costillas a nadie."
    mc "At least we know you can give hugs without breaking anyone's ribs."

# game/scripts/c32/c32.rpy:2240
translate english c32s003_GavArm_92e17f17:

    # cal "*Risa por lo bajo* Seguramente podrá hacerlo cuando el brazo tenga la potencia definitiva."
    cal "*Chuckles* He'll probably be able to do that when the arm is at its final power."

# game/scripts/c32/c32.rpy:2241
translate english c32s003_GavArm_e77af221:

    # mc "Entonces será mejor que aprenda a controlar la fuerza para entonces. *Risa* O no voy a dejarle que vuelva a abrazarme."
    mc "Then he better learn to control his strength by then. *Laugh* Or I'm not going to let him hug me again."

# game/scripts/c32/c32.rpy:2242
translate english c32s003_GavArm_d0379337:

    # mc "Seguid con las pruebas, por favor. [cal], mándame un informe cada día con los progresos... por email."
    mc "Keep up with the tests, please. [cal], send me a daily report with the progress... by email."

# game/scripts/c32/c32.rpy:2243
translate english c32s003_GavArm_be1396cf:

    # mc "No creo que pueda asistir a todas las pruebas."
    mc "I don't think I'll be able to attend all the tests."

# game/scripts/c32/c32.rpy:2245
translate english c32s003_GavArm_fe1ff717:

    # "Te giras hacia la puerta cuando un pensamiento te asalta antes de abrirla."
    "You turn towards the door when a thought strikes you before opening it."

# game/scripts/c32/c32.rpy:2246
translate english c32s003_GavArm_b29bbb93:

    # mcp "(Espero que los informes de [cal] no sean tan exhaustivos como los de [aar].)"
    mcp "(I hope [cal]'s reports aren't as exhaustive as [aar]'s.)"

# game/scripts/c32/c32.rpy:2247
translate english c32s003_GavArm_a0b1e474:

    # mc "Informe ejecutivo, [cal]."
    mc "An executive report, [cal]."

# game/scripts/c32/c32.rpy:2251
translate english c32s003_redecor_31d3fd93:

    # centered "{size=+20}{b}DÍA 50 – MARTES{/b}{/size}"
    centered "{size=+20}{b}DAY 50 – TUESDAY{/b}{/size}"

# game/scripts/c32/c32.rpy:2253
translate english c32s003_redecor_238acad7:

    # "Algunos días después, tras tener que insistirle a [ama] varias veces para que te preste las fotos..."
    "A few days later, after having to insist to [ama] several times to let you borrow the photos..."

# game/scripts/c32/c32.rpy:2254
translate english c32s003_redecor_e45b1c18:

    # mc "Buenos días, [car]."
    mc "Good morning, [car]."

# game/scripts/c32/c32.rpy:2255
translate english c32s003_redecor_c13d31a6:

    # car "Buenos días, Sr. Marks."
    car "Good morning, Mr. Marks."

# game/scripts/c32/c32.rpy:2256
translate english c32s003_redecor_bd7d9df9:

    # mc "[mc]."
    mc "[mc]."

# game/scripts/c32/c32.rpy:2257
translate english c32s003_redecor_f1983638:

    # "Sabes que parece una batalla perdida, pero has ganado alguna batalla en tu vida por ser muy insistente."
    "You know it seems like a losing battle, but you've won a few battles in your life by being very persistent."

# game/scripts/c32/c32.rpy:2258
translate english c32s003_redecor_380e9a9f:

    # car "¿Puedo ayudarle en algo?"
    car "Can I help you with anything?"

# game/scripts/c32/c32.rpy:2259
translate english c32s003_redecor_88cda85d:

    # mc "Tengo una pregunta sobre mi despacho. ¿Hay alguna razón por la que parece sacado de un documental de la Segunda Guerra Mundial?"
    mc "I have a question about my office. Is there any reason why it looks like something out of a World War II documentary?"

# game/scripts/c32/c32.rpy:2261
translate english c32s003_redecor_23f9e468:

    # car "El Sr. Daniels lo mandó redecorar cuando el Sr. Richards murió."
    car "Mr. Daniels had it redecorated when Mr. Richards died."

# game/scripts/c32/c32.rpy:2262
translate english c32s003_redecor_f8242671:

    # car "Hizo tapiar la habitación auxiliar y darle ese aspecto."
    car "He had the side room walled off and gave it that look."

# game/scripts/c32/c32.rpy:2263
translate english c32s003_redecor_c3a63e61:

    # mc "¿Habitación auxiliar?"
    mc "Side room?"

# game/scripts/c32/c32.rpy:2265
translate english c32s003_redecor_e5f0c54b:

    # car "Detrás de la pared que hay tras su silla hay un dormitorio. El Sr. Richards lo usaba cuando tenía que quedarse a dormir en las instalaciones."
    car "Beyond the wall behind your chair there is a bedroom. Mr. Richards used it when he had to stay overnight on the premises."

# game/scripts/c32/c32.rpy:2266
translate english c32s003_redecor_b3868a15:

    # car "El Sr. Daniels dijo que no era necesario. Inicialmente tenía pensado usarlo como archivo extra, pero al final decidió tapiarlo."
    car "Mr. Daniels said it wasn't necessary. Initially he planned to use it as an extra filing room, but in the end, he decided to wall it off."

# game/scripts/c32/c32.rpy:2268
translate english c32s003_redecor_0b2f3354:

    # car "¿Querría usted recuperar la habitación con la reforma del despacho?"
    car "Would you like to recover the room with the office renovation?"

# game/scripts/c32/c32.rpy:2269
translate english c32s003_redecor_49413162:

    # mc "No había pensado en reformarlo, tan solo había pensado en una mano de pintura y mobiliario... del Siglo XXI."
    mc "I hadn't thought about renovating it, I just thought about a coat of paint and furniture... from the 21st century."

# game/scripts/c32/c32.rpy:2270
translate english c32s003_redecor_c70365a8:

    # mc "A veces me siento como si fuera el General Eisenhower en ese despacho."
    mc "Sometimes I feel like General Eisenhower in that office."

# game/scripts/c32/c32.rpy:2272
translate english c32s003_redecor_45c1e533:

    # car "Ese era el efecto que buscaba el Sr. Daniels. Aunque él dijo General MacArthur."
    car "That was the effect Mr. Daniels was looking for. Although he said General MacArthur."

# game/scripts/c32/c32.rpy:2273
translate english c32s003_redecor_40f73263:

    # car "Puedo encargarme de la pintura y de los muebles si quiere."
    car "I can take care of the painting and the furniture if you want."

# game/scripts/c32/c32.rpy:2274
translate english c32s003_redecor_c868a26a:

    # car "Y destapiar la habitación no sería demasiado problema si se hace antes de la pintura."
    car "And opening up the room wouldn't be too much of a problem if it's done before painting."

# game/scripts/c32/c32.rpy:2275
translate english c32s003_redecor_4fa9b471:

    # mc "Me parece una buena idea. Creo que es un desperdicio de espacio tener una habitación tapiada."
    mc "Sounds like a good idea to me. I think it's a waste of space to have a walled-off room."

# game/scripts/c32/c32.rpy:2277
translate english c32s003_redecor_723ce434:

    # car "No se preocupe, entonces. Haré unas llamadas y lo tendrá hecho en menos de una semana."
    car "Don't worry, then. I'll make a few calls and have it done in less than a week."

# game/scripts/c32/c32.rpy:2278
translate english c32s003_redecor_da378e55:

    # mc "Gracias, [car]."
    mc "Thank you, [car]."

# game/scripts/c32/c32.rpy:2279
translate english c32s003_redecor_28091c3e:

    # mc "Aparte de eso, ¿puedo pedirte un favor?"
    mc "Other than that, can I ask you a favor?"

# game/scripts/c32/c32.rpy:2281
translate english c32s003_redecor_75ac0b65:

    # "La diminuta mujer casi se siente ofendida, pero te cuesta leer sus expresiones."
    "The tiny woman almost seems offended, but you find it hard to read her expressions."

# game/scripts/c32/c32.rpy:2282
translate english c32s003_redecor_c7b34bf9:

    # car "Si es trabajo, no es un favor, soy su secretaria."
    car "If it's work, it's not a favor. I am your secretary."

# game/scripts/c32/c32.rpy:2283
translate english c32s003_redecor_2227724b:

    # mc "He intentado escanear un par de fotos con el escáner que tengo en el despacho, pero no consigo que tengan la resolución que quiero."
    mc "I've tried scanning a couple of photos with the scanner in my office, but I can't get the resolution I want."

# game/scripts/c32/c32.rpy:2284
translate english c32s003_redecor_b27a59ef:

    # mc "¿Hay algún escáner de mayor resolución que pueda usar?"
    mc "Is there a higher resolution scanner I could use?"

# game/scripts/c32/c32.rpy:2286
translate english c32s003_redecor_7409ba52:

    # car "El escáner de su despacho tiene varios años y... no es muy bueno. Los CEOs anteriores no lo usaban nunca."
    car "The scanner in your office is several years old and... it's not very good. The previous CEOs never used it."

# game/scripts/c32/c32.rpy:2287
translate english c32s003_redecor_3c0196bf:

    # "Es la primera vez que no los nombra por sus apellidos. A lo mejor no es una batalla perdida al fin y al cabo."
    "It's the first time she hasn't referred to them by their last names. Maybe it's not a lost cause after all."

# game/scripts/c32/c32.rpy:2288
translate english c32s003_redecor_28f6891b:

    # car "Si me deja las fotos, puedo enviar a alguien a escanearlas en el escáner de alta resolución del despacho de [mael]."
    car "If you leave the photos with me, I can send someone to scan them on the high-resolution scanner in [mael]'s office."

# game/scripts/c32/c32.rpy:2289
translate english c32s003_redecor_3a2aaf61:

    # "Un escalofrío te recorre de arriba a abajo. No estás dispuesto a desprenderte de las fotos y a que [car] se las de a alguien."
    "A shiver runs down your spine. You're not willing to part with the photos and let [car] give them to someone."

# game/scripts/c32/c32.rpy:2290
translate english c32s003_redecor_512c21ab:

    # "Son las únicas copias que existen y no quisieras que les pasara nada."
    "They are the only existing copies and you wouldn't want anything to happen to them."

# game/scripts/c32/c32.rpy:2292
translate english c32s003_redecor_63f9c6de:

    # "La anciana capta tus dudas, aunque las malinterpreta."
    "The old woman catches your hesitation, though she misinterprets it."

# game/scripts/c32/c32.rpy:2293
translate english c32s003_redecor_ae0636cd:

    # car "Aunque si es algo demasiado privado... Puedo decirle a [mael] que usted mismo irá a escanearlas."
    car "Although if it's something too private... I can tell [mael] that you'll go scan them yourself."

# game/scripts/c32/c32.rpy:2294
translate english c32s003_redecor_0e6edf94:

    # mc "No es que sea privado, sino que... no me gustaría que les pasara nada a estas fotos. Son únicas y no hay más copias."
    mc "It's not that it's private, but... I wouldn't want anything to happen to these photos. They're unique and there are no other copies."

# game/scripts/c32/c32.rpy:2295
translate english c32s003_redecor_e5f0650e:

    # mc "No me sentiría cómodo si se las dieras a alguien para escanearlas y se dañaran."
    mc "I wouldn't feel comfortable if you gave them to someone to scan and they got damaged."

# game/scripts/c32/c32.rpy:2297
translate english c32s003_redecor_52498c2f:

    # "La secretaria se relaja visiblemente."
    "The secretary visibly relaxes."

# game/scripts/c32/c32.rpy:2298
translate english c32s003_redecor_bd286382:

    # car "Si quiere, puedo ocuparme personalmente de escanearlas. Le prometo que no les pasará nada."
    car "If you want, I can personally take care of scanning them. I promise nothing will happen to them."

# game/scripts/c32/c32.rpy:2299
translate english c32s003_redecor_590c887f:

    # mc "No quisiera ser una molestia. No es un asunto de trabajo precisamente."
    mc "I wouldn't want to be a bother. It's not exactly a work matter."

# game/scripts/c32/c32.rpy:2300
translate english c32s003_redecor_0583db68:

    # car "No es una molestia. Tan solo son un par de fotos..."
    car "It's no bother. It's just a couple of photos..."

# game/scripts/c32/c32.rpy:2301
translate english c32s003_redecor_e04f1e3e:

    # mc "De acuerdo. Muchas gracias, [car]."
    mc "Alright. Thank you very much, [car]."

# game/scripts/c32/c32.rpy:2303
translate english c32s003_redecor_1f05ae37:

    # "Tras entregarle un sobre con las dos polaroids vas a tu despacho a leer informes de [aar] y [vin]."
    "After handing her an envelope with the two polaroids, you go to your office and start reading reports from [aar] and [vin]."

# game/scripts/c32/c32.rpy:2304
translate english c32s003_redecor_9c4fc14b:

    # "Al cabo de unos minutos..."
    "After a few minutes..."

# game/scripts/c32/c32.rpy:2305
translate english c32s003_redecor_4df7da16:

    # car "*A través de la pared* *SUSPIRO DE SORPRESA*"
    car "*Through the wall* *SURPRISED GASP*"

# game/scripts/c32/c32.rpy:2307
translate english c32s003_redecor_88e7e3af:

    # "Sales de la habitación rápidamente y la encuentras mirando la foto de Fiona. Casi temiendo tocarla."
    "You quickly leave the room and find her looking at Fiona's photo. Almost afraid to touch it."

# game/scripts/c32/c32.rpy:2308
translate english c32s003_redecor_231bd4d0:

    # mc "¿Estás bien, [car]?"
    mc "Are you okay, [car]?"

# game/scripts/c32/c32.rpy:2309
translate english c32s003_redecor_b801e032:

    # car "No."
    car "No."

# game/scripts/c32/c32.rpy:2311
translate english c32s003_redecor_3536ec54:

    # car "No sabía que existiera ninguna foto de Fiona..."
    car "I didn't know any photos of Fiona existed..."

# game/scripts/c32/c32.rpy:2312
translate english c32s003_redecor_8cd60998:

    # mc "[ama] las tenía escondidas por miedo a que alguien se las quitara."
    mc "[ama] had them hidden for fear that someone would take them from her."

# game/scripts/c32/c32.rpy:2314
translate english c32s003_redecor_eb74dd5d:

    # car "Si Daniels o Richards lo hubieran sabido, seguro que se la hubieran quitado."
    car "If Daniels or Richards had known, they surely would have taken it from her."

# game/scripts/c32/c32.rpy:2315
translate english c32s003_redecor_c935a5ce:

    # "No puedes dejar de notar la ausencia del 'Sr.' en su frase."
    "You can't help but notice the absence of 'Mr.' in her sentence."

# game/scripts/c32/c32.rpy:2316
translate english c32s003_redecor_b6f5f1d9:

    # mc "Ahora nadie se las va a quitar. Pero son las únicas copias y quiero tenerlas en formato digital, para intentar repararlas."
    mc "Now, no one is going to take them away. But they are the only copies and I want to have them in digital format, to try to enhance them."

# game/scripts/c32/c32.rpy:2318
translate english c32s003_redecor_22422a74:

    # car "¿Le importa si hago una copia para mí? De las dos fotos. Por favor."
    car "Do you mind if I make a copy for myself? Of both photos. Please."

# game/scripts/c32/c32.rpy:2319
translate english c32s003_redecor_497f5eba:

    # "El tono lastimero en su voz hace que te sea muy difícil negarte. Pero no son tus fotos."
    "The pitiful tone in her voice makes it very hard for you to refuse. But they aren't your photos."

# game/scripts/c32/c32.rpy:2320
translate english c32s003_redecor_9c795e23:

    # mc "Supongo que no habrá problema, pero déjame consultarlo con [ama]. Las fotos no son mías y..."
    mc "I guess there won't be a problem, but let me check with [ama]. The photos aren't mine and..."

# game/scripts/c32/c32.rpy:2322
translate english c32s003_redecor_86c8a592:

    # car "Gracias, Sr. Marks."
    car "Thank you, Mr. Marks."

# game/scripts/c32/c32.rpy:2323
translate english c32s003_redecor_702cd021:

    # "La sorpresa por el inapropiado abrazo hace que te olvides de recordarle que debe llamarte [mc]. Una oportunidad perdida para decantar la batalla a tu favor."
    "The surprise of the inappropriate hug makes you forget to remind her to call you [mc]. A missed opportunity to tip the battle in your favor."

# game/scripts/c32/c32.rpy:2324
translate english c32s003_redecor_064d56ed:

    # mc "Las chicas te importan, ¿verdad?"
    mc "You care about the girls, don't you?"

# game/scripts/c32/c32.rpy:2326
translate english c32s003_redecor_5a861ad9:

    # car "He visto nacer a cada una de las series, Sr Marks. Me importan todos."
    car "I've seen every one of the series born, Mr. Marks. I care about all of them."

# game/scripts/c32/c32.rpy:2327
translate english c32s003_redecor_6876b3f1:

    # car "Pero con las chicas... no sé... el sentimiento es un poco diferente."
    car "But with the girls... I don't know... the feeling is a bit different."

# game/scripts/c32/c32.rpy:2329
translate english c32s003_redecor_48ebb23a:

    # car "Las acuné a todas cuando nacieron. Fueron las únicas con las que me dejaron hacerlo."
    car "I cradled them all when they were born. They were the only ones they let me do that with."

# game/scripts/c32/c32.rpy:2331
translate english c32s003_redecor_228c02bc:

    # car "Me alegro mucho de que [ama] y [eva] hayan encontrado a su familia después de todos estos años."
    car "I'm so glad that [ama] and [eva] have found their family after all these years."

# game/scripts/c32/c32.rpy:2332
translate english c32s003_redecor_ccb117ab:

    # car "Me alegré cuando me enteré de que habían conocido a [mar] y a [nor]. También por [aar]."
    car "I was happy when I found out they had met [mar] and [nor]. Also for [aar]."

# game/scripts/c32/c32.rpy:2333
translate english c32s003_redecor_ffe26750:

    # mc "Parece que ellas lo han disfrutado más que [aar]."
    mc "It seems they've enjoyed it more than [aar]."

# game/scripts/c32/c32.rpy:2335
translate english c32s003_redecor_9614a4a5:

    # car "[aar] es de la primera serie. Albert y Arnau eran su familia. Después 'adoptaron' a las chicas."
    car "[aar] is from the first series. Alfred and Arnau were his family. Later they 'adopted' the girls."

# game/scripts/c32/c32.rpy:2336
translate english c32s003_redecor_5b93ff25:

    # car "Las chicas crecieron siendo seis, y teniendo a los A como si fueran sus primos mayores."
    car "The girls grew up as a group of six, and the A's were like their older cousins."

# game/scripts/c32/c32.rpy:2337
translate english c32s003_redecor_8148a000:

    # car "También los B y los C estaban ahí, y después llegaron el resto de las series. Tienen un concepto más amplio de familia."
    car "The B's and C's were also there, and then the rest of the series arrived. They have a broader concept of family."

# game/scripts/c32/c32.rpy:2338
translate english c32s003_redecor_d56b9c53:

    # mc "Lo entiendo."
    mc "I understand."

# game/scripts/c32/c32.rpy:2340
translate english c32s003_redecor_0a0ecd13:

    # car "Algún día, me gustaría poder conocer a [emm], [dap] y [eri]. Para ver de dónde salieron mis chicas."
    car "Someday, I'd like to be able to meet [emm], [dap], and [eri]. To see where my girls came from."

# game/scripts/c32/c32.rpy:2341
translate english c32s003_redecor_ae3d316b:

    # mc "Estoy seguro de que lo harás. Las tres están deseando venir a conocer la empresa."
    mc "I'm sure you will. The three of them are looking forward to coming to see the company."

# game/scripts/c32/c32.rpy:2342
translate english c32s003_redecor_9dabb949:

    # mc "Sabiendo lo que sientes respecto a ellas, estoy seguro de que vendrán incluso antes de lo planeado."
    mc "Knowing how you feel about them, I'm sure they'll come even sooner than planned."

# game/scripts/c32/c32.rpy:2344
translate english c32s003_redecor_86c8a592_1:

    # car "Gracias, Sr. Marks."
    car "Thank you, Mr. Marks."

# game/scripts/c32/c32.rpy:2345
translate english c32s003_redecor_42cfac64:

    # mc "[mc]. O tendré que decirles que no vengan a la isla."
    mc "[mc]. Or I'll have to tell them not to come to the island."

# game/scripts/c32/c32.rpy:2347
translate english c32s003_redecor_d559e15b:

    # car "Yo busqué a sus madres. En parte están aquí por culpa mía."
    car "I looked for their mothers. They're partly here because of me."

# game/scripts/c32/c32.rpy:2348
translate english c32s003_redecor_0d668228:

    # car "Y, algún día, me gustaría poder conocer a [emm], [dap] y [eri]."
    car "And, someday, I'd like to be able to meet [emm], [dap], and [eri]."

# game/scripts/c32/c32.rpy:2349
translate english c32s003_redecor_353b3527:

    # mc "Espera... ¿Has dicho que buscaste a sus madres?"
    mc "Wait... Did you say you looked for their mothers?"

# game/scripts/c32/c32.rpy:2351
translate english c32s003_redecor_1b13cfa0:

    # car "Sí. Mujeres sin recursos de la ciudad. Mujeres que querían abortar."
    car "Yes. Low-income women from the city. Women who wanted abortions."

# game/scripts/c32/c32.rpy:2352
translate english c32s003_redecor_74d945ef:

    # car "No fue difícil pedirles que se las dieran a la empresa en adopción. A cambio de una compensación económica."
    car "It wasn't hard to ask them to give them up to the company for adoption. In exchange for financial compensation."

# game/scripts/c32/c32.rpy:2353
translate english c32s003_redecor_11dc2b83:

    # mc "¿Mantenemos contacto con ellas? ¿Sabemos dónde están?"
    mc "Do we keep in touch with them? Do we know where they are?"

# game/scripts/c32/c32.rpy:2355
translate english c32s003_redecor_ad4624d6:

    # car "La empresa nunca ha tenido ningún interés en ellas después de pagarles. Y, sin recursos, les perdí la pista a la mayoría."
    car "The company never had any interest in them after paying them. And, without resources, I lost track of most of them."

# game/scripts/c32/c32.rpy:2356
translate english c32s003_redecor_fe480c24:

    # car "Sé que las madres de Clarice y de [eva] murieron. Drogas... Pero del resto no tengo ninguna información."
    car "I know Clarice and [eva]'s mothers died. Drugs... But I don't have any information about the rest."

# game/scripts/c32/c32.rpy:2357
translate english c32s003_redecor_a31a153d:

    # mc "¿Quieres una nueva tarea?"
    mc "Do you want a new assignment?"

# game/scripts/c32/c32.rpy:2359
translate english c32s003_redecor_f4f918b4:

    # car "¿Qué? ¿En serio?"
    car "What? Really?"

# game/scripts/c32/c32.rpy:2360
translate english c32s003_redecor_dc610d7b:

    # mc "Creo que [ama] debe tener el derecho a conocer a su madre biológica, si es posible y si ella quiere."
    mc "I think [ama] should have the right to meet her biological mother, if it's possible and if she wants to."

# game/scripts/c32/c32.rpy:2362
translate english c32s003_redecor_579c675a:

    # car "Gracias, Sr. Marks. Me pondré a ello en seguida."
    car "Thank you, Mr. Marks. I'll get on it right away."

# game/scripts/c32/c32.rpy:2363
translate english c32s003_redecor_2067cae6:

    # mc "[mc]. O tendré que cancelar la tarea."
    mc "[mc]. Or I'll have to cancel the assignment."

# game/scripts/c32/c32.rpy:2364
translate english c32s003_redecor_9845723d:

    # car "Gracias, [mc]."
    car "Thank you, [mc]."

# game/scripts/c32/c32.rpy:2365
translate english c32s003_redecor_1bc7d8fc:

    # "Parece que el nombre se le atraganta al decirlo. Pero es una pequeña victoria."
    "It seems like the name gets stuck in her throat when she says it. But it's a small victory."

# game/scripts/c32/c32.rpy:2370
translate english c32s003_MaelDrug_58586704:

    # "Unas horas después, durante la reunión con [mael], tras explicarle la idea sobre aislar el gen del envejecimiento..."
    "A few hours later, during the meeting with [mael], after explaining the idea of isolating the aging gene..."

# game/scripts/c32/c32.rpy:2371
translate english c32s003_MaelDrug_9712c73b:

    # mael "¡Eso es imposible!"
    mael "That's impossible!"

# game/scripts/c32/c32.rpy:2372
translate english c32s003_MaelDrug_509403a1:

    # mc "No te voy a decir qué es posible y qué no lo es en tu campo, [mael]."
    mc "I'm not going to tell you what is and isn't possible in your field, [mael]."

# game/scripts/c32/c32.rpy:2373
translate english c32s003_MaelDrug_f4408e3a:

    # mc "Pero fuiste tú el que habló sobre investigaciones de frontera. Creo que es una oportunidad."
    mc "But you were the one who talked about frontier research. I think this is an opportunity."

# game/scripts/c32/c32.rpy:2375
translate english c32s003_MaelDrug_eb57254e:

    # mael "Pero ¿aislar el gen de envejecimiento acelerado órgano a órgano?"
    mael "But isolating the accelerated aging gene organ by organ?"

# game/scripts/c32/c32.rpy:2376
translate english c32s003_MaelDrug_18d740f1:

    # mael "Eso es decididamente una locura. No se puede hacer."
    mael "That is decidedly insane. It can't be done."

# game/scripts/c32/c32.rpy:2377
translate english c32s003_MaelDrug_efda01e9:

    # mc "Tan solo te pido que le eches una ojeada al asunto y pienses en qué puedes necesitar para hacerlo."
    mc "I'm just asking you to take a look into it and think about what you might need to do it."

# game/scripts/c32/c32.rpy:2378
translate english c32s003_MaelDrug_4edf14e6:

    # mc "O para hacer las pruebas necesarias para descartarlo del todo."
    mc "Or to run the necessary tests to rule it out completely."

# game/scripts/c32/c32.rpy:2380
translate english c32s003_MaelDrug_f84d661f:

    # mael "No hace falta hacer ninguna prueba. Ya las hicimos hace años cuando investigamos como parar el envejecimiento a partir de cierta edad."
    mael "There's no need to run any tests. We already did them years ago when we were researching how to stop aging after a certain age."

# game/scripts/c32/c32.rpy:2381
translate english c32s003_MaelDrug_ba2ba4d9:

    # mael "O lo aceleras todo o lo ralentizas todo. No puedes hacer envejecer el cerebro sin envejecer los pulmones."
    mael "You either accelerate everything or slow everything down. You can't make the brain age without aging the lungs."

# game/scripts/c32/c32.rpy:2382
translate english c32s003_MaelDrug_a243cd23:

    # mael "Y no puedes ralentizar el crecimiento de los huesos sin ralentizar el crecimiento del hígado."
    mael "And you can't slow down bone growth without slowing down liver growth."

# game/scripts/c32/c32.rpy:2383
translate english c32s003_MaelDrug_ea336610:

    # mc "Espera. ¿Se hicieron pruebas para eliminar el envejecimiento acelerado?"
    mc "Wait. Were there tests done to eliminate accelerated aging?"

# game/scripts/c32/c32.rpy:2385
translate english c32s003_MaelDrug_df37c1a0:

    # mael "No para eliminarlo, sino para ralentizarlo. Para que los clones envejecieran a una velocidad... más o menos normal."
    mael "Not to eliminate it, but to slow it down. So the clones would age at a... more or less normal rate."

# game/scripts/c32/c32.rpy:2386
translate english c32s003_MaelDrug_ccada870:

    # mc "Supongo que fracasasteis. Siguen envejeciendo a ritmo acelerado. Excepto las chicas, claro."
    mc "I guess you failed. They still age at an accelerated rate. Except for the girls, of course."

# game/scripts/c32/c32.rpy:2388
translate english c32s003_MaelDrug_7e865ac5:

    # mael "¡No fracasamos! El experimento fue un éxito. ¡Conseguimos ralentizar el envejecimiento hasta 1.064!"
    mael "We didn't fail! The experiment was a success. We managed to slow down aging to 1.064!"

# game/scripts/c32/c32.rpy:2389
translate english c32s003_MaelDrug_a12ae5a8:

    # mael "Y es independiente de la serie. Da lo mismo que sea un A, que envejece a 3x, o un J, que envejece a 1.7x."
    mael "And it's independent of the series. It doesn't matter if it's an A, which ages at 3x, or a J, which ages at 1.7x."

# game/scripts/c32/c32.rpy:2390
translate english c32s003_MaelDrug_22ed5e2e:

    # mc "¿Entonces por qué [aar] parece mi abuelo?"
    mc "Then why does [aar] look like my grandpa?"

# game/scripts/c32/c32.rpy:2392
translate english c32s003_MaelDrug_3c96a823:

    # mael "Porque es caro y ni Richards ni Daniels veían ningún beneficio en ello."
    mael "Because it's expensive and neither Richards nor Daniels saw any benefit in it."

# game/scripts/c32/c32.rpy:2393
translate english c32s003_MaelDrug_561d5c00:

    # mael "Si tienes recambios para los clones que, eventualmente, tengas que retirar por ser demasiado viejos... Es más barato."
    mael "If you have replacements for the clones that you eventually have to retire for being too old... It's cheaper."

# game/scripts/c32/c32.rpy:2394
translate english c32s003_MaelDrug_3e7eeba9:

    # mc "¿Me estás diciendo que les estamos quitando años de vida a los chicos por una cuestión de dinero?"
    mc "Are you telling me we're taking years of life away from the guys over money?"

# game/scripts/c32/c32.rpy:2395
translate english c32s003_MaelDrug_23349408:

    # mc "¿Tú crees que eso es normal? ¿De cuánto dinero estamos hablando?"
    mc "Do you think that's normal? How much money are we talking about?"

# game/scripts/c32/c32.rpy:2397
translate english c32s003_MaelDrug_90a456b8:

    # mael "Sí. Fue una decisión económica."
    mael "Yes. It was an economic decision."

# game/scripts/c32/c32.rpy:2398
translate english c32s003_MaelDrug_2c48e42c:

    # mael "Pero no es una decisión que tuviera que tomar yo. Eso lo tiene que decidir la persona que se sienta tras esta mesa."
    mael "But it's not a decision I had to make. That has to be decided by the person sitting behind this desk."

# game/scripts/c32/c32.rpy:2399
translate english c32s003_MaelDrug_ace6a4ce:

    # mc "Vale, pero ¿de cuánto dinero estamos hablando?"
    mc "Okay, but how much money are we talking about?"

# game/scripts/c32/c32.rpy:2401
translate english c32s003_MaelDrug_1845bfe5:

    # mael "Los experimentos fueron 'caros', pero si se implementara la fabricación en serie de la droga, unos $5,000 o $6,000 anuales por clon."
    mael "The experiments were 'expensive', but if mass production of the drug were implemented, about $5,000 or $6,000 a year per clone."

# game/scripts/c32/c32.rpy:2402
translate english c32s003_MaelDrug_e055ccbb:

    # "Haces unos cálculos mentales rápidos..."
    "You do some quick mental math..."

# game/scripts/c32/c32.rpy:2403
translate english c32s003_MaelDrug_0cf5685b:

    # mc "¡Eso son menos de 3 millones al año para los 426 clones! Tú gastas mucho más cada mes en equipo de investigación."
    mc "That's less than 3 million a year for the 426 clones! You spend way more than that every month on research equipment."

# game/scripts/c32/c32.rpy:2405
translate english c32s003_MaelDrug_ec54a8bd:

    # mael "El equipo de investigación es necesario."
    mael "The research equipment is necessary."

# game/scripts/c32/c32.rpy:2406
translate english c32s003_MaelDrug_8cd2bc9c:

    # mc "Y darles una vida a nuestros chicos también es necesario. Ya no son recambios, ni son prescindibles."
    mc "And giving our boys a life is also necessary. They're not spare parts anymore, nor are they expendable."

# game/scripts/c32/c32.rpy:2407
translate english c32s003_MaelDrug_eddf5070:

    # mc "Buscaré de dónde sacar los 3 millones para destinarlos a la fabricación y distribución de la droga."
    mc "I'll find where to get the 3 million to allocate to the manufacturing and distribution of the drug."

# game/scripts/c32/c32.rpy:2409
translate english c32s003_MaelDrug_89557db6:

    # mael "Siempre y cuando no toques mis gastos en equipo de investigación."
    mael "As long as you don't touch my research equipment expenses."

# game/scripts/c32/c32.rpy:2410
translate english c32s003_MaelDrug_f8b9c421:

    # mael "Si recortas en eso, no podré clonar tu páncreas."
    mael "If you cut back on that, I won't be able to clone your pancreas."

# game/scripts/c32/c32.rpy:2411
translate english c32s003_MaelDrug_6b40592f:

    # mc "¿Mi páncreas?"
    mc "My pancreas?"

# game/scripts/c32/c32.rpy:2413
translate english c32s003_MaelDrug_22c35b07:

    # mael "Me pediste que clonara órganos sueltos y que empezara por un páncreas."
    mael "You asked me to clone individual organs and to start with a pancreas."

# game/scripts/c32/c32.rpy:2414
translate english c32s003_MaelDrug_04dd84a9:

    # mc "*Risa* No te pedí que empezaras con un páncreas. Era un ejemplo. Me da lo mismo que sea un riñón o un corazón."
    mc "*Laugh* I didn't ask you to start with a pancreas. It was an example. I don't care if it's a kidney or a heart."

# game/scripts/c32/c32.rpy:2415
translate english c32s003_MaelDrug_ef0f5b2f:

    # mc "Quiero que investigues cómo clonar órganos sueltos. Y quiero que se puedan clonar de un donante de cualquier edad."
    mc "I want you to research how to clone individual organs. And I want to be able to clone them from a donor of any age."

# game/scripts/c32/c32.rpy:2417
translate english c32s003_MaelDrug_df4f15f3:

    # mael "Eso lo complica todo. Nuestro proceso parte de tejido embrionario, no de órganos totalmente formados."
    mael "That complicates everything. Our process starts from embryonic tissue, not fully formed organs."

# game/scripts/c32/c32.rpy:2418
translate english c32s003_MaelDrug_e68efedd:

    # mc "¿Se puede hacer?"
    mc "Can it be done?"

# game/scripts/c32/c32.rpy:2420
translate english c32s003_MaelDrug_79de1b96:

    # mael "Con el suficiente dinero... Se puede investigar, si hay un órgano que clonar. Al menos al principio."
    mael "With enough money and time... We can research it, if there's an organ to clone. At least at first."

# game/scripts/c32/c32.rpy:2421
translate english c32s003_MaelDrug_2b384a36:

    # mael "No creo que pudiéramos clonar el brazo derecho de [gav], porque ya no existe. Ni siquiera si partiéramos de su brazo izquierdo."
    mael "I don't think we could clone [gav]'s right arm, because it doesn't exist anymore. Not even if we started with his left arm."

# game/scripts/c32/c32.rpy:2422
translate english c32s003_MaelDrug_a0bec804:

    # "En ese momento te das cuenta de que, por alguna razón, esperabas una respuesta diferente."
    "At that moment you realize that, for some reason, you were expecting a different answer."

# game/scripts/c32/c32.rpy:2423
translate english c32s003_MaelDrug_b56402af:

    # "El útero de [mee] te viene a la mente por un segundo. Es una lástima que no sea ni siquiera una posibilidad."
    "[mee]'s uterus comes to mind for a second. It's a shame that it's not even a possibility."

# game/scripts/c32/c32.rpy:2424
translate english c32s003_MaelDrug_3614ef2c:

    # mc "De acuerdo, no recortaré tu presupuesto de investigación."
    mc "Alright, I won't cut your research budget."

# game/scripts/c32/c32.rpy:2425
translate english c32s003_MaelDrug_a953d617:

    # mc "Tengo otra pregunta. ¿La droga para parar el envejecimiento...?"
    mc "I have another question. The drug to stop aging...?"

# game/scripts/c32/c32.rpy:2427
translate english c32s003_MaelDrug_d43a98dc:

    # mael "Ralentizarlo para que sea casi normal."
    mael "To slow it down so it's almost normal."

# game/scripts/c32/c32.rpy:2428
translate english c32s003_MaelDrug_361a803d:

    # mc "Vale. La droga para ralentizar el envejecimiento para que sea casi normal, ¿sería aplicable a personas que envejecen a un ritmo normal?"
    mc "Okay. The drug to slow down aging so it's almost normal, would it be applicable to people who age at a normal rate?"

# game/scripts/c32/c32.rpy:2429
translate english c32s003_MaelDrug_19b471f4:

    # mc "Podría ser la crema anti edad definitiva y [flo] estaría muy feliz de poder venderla."
    mc "It could be the ultimate anti-aging cream and [flo] would be very happy to sell it."

# game/scripts/c32/c32.rpy:2431
translate english c32s003_MaelDrug_ae84133e:

    # mael "¿Te has mirado alguna vez en un espejo? Aparentas más edad de la que tienes."
    mael "Have you ever looked in a mirror? You look older than you are."

# game/scripts/c32/c32.rpy:2432
translate english c32s003_MaelDrug_d10adfea:

    # mc "Lo sé. ¿Pero qué tiene que ver eso?"
    mc "I know. But what does that have to do with anything?"

# game/scripts/c32/c32.rpy:2434
translate english c32s003_MaelDrug_d451e3f6:

    # mael "Tú eres el donante cero."
    mael "You are donor zero."

# game/scripts/c32/c32.rpy:2435
translate english c32s003_MaelDrug_bc8b02ab:

    # mael "Por entonces no lo sabíamos, pero esos genes que te hacen parecer más mayor se amplificaron accidentalmente en la clonación de los A."
    mael "We didn't know it back then, but those genes that make you look older were accidentally amplified in the cloning of the A's."

# game/scripts/c32/c32.rpy:2436
translate english c32s003_MaelDrug_babe3941:

    # mael "Hemos ido ajustando esos genes durante años para que produzcan un crecimiento acelerado, pero no tanto como en los A."
    mael "We've been tweaking those genes for years so they produce accelerated growth, but not as much as in the A's."

# game/scripts/c32/c32.rpy:2438
translate english c32s003_MaelDrug_6bd563ed:

    # mael "Desde los G es 1.7. La anterior dirección lo consideró el valor adecuado."
    mael "Since the G's, it's 1.7. The previous management considered it the appropriate value."

# game/scripts/c32/c32.rpy:2439
translate english c32s003_MaelDrug_3a6b2480:

    # mc "¿Esos genes? ¿Me estás diciendo que todos los clones tienen esos genes que son míos?"
    mc "Those genes? Are you telling me that all the clones have those genes that are mine?"

# game/scripts/c32/c32.rpy:2441
translate english c32s003_MaelDrug_d5865521:

    # mael "Sí. Creía que lo sabías..."
    mael "Yes. I thought you knew..."

# game/scripts/c32/c32.rpy:2442
translate english c32s003_MaelDrug_661f5220:

    # mc "¡No tenía ni idea! ¡Joder! ¡De alguna forma soy el padre de todos ellos!"
    mc "I had no idea! Fuck! Somehow I'm the father to all of them!"

# game/scripts/c32/c32.rpy:2444
translate english c32s003_MaelDrug_423dd648:

    # mael "No. No funciona así."
    mael "No. It doesn't work like that."

# game/scripts/c32/c32.rpy:2445
translate english c32s003_MaelDrug_94d8e2c6:

    # mc "Explícamelo como si fuera idiota."
    mc "Explain it to me like I'm an idiot."

# game/scripts/c32/c32.rpy:2447
translate english c32s003_MaelDrug_3a93b443:

    # "La cara que pone el científico te indica que es lo que ha estado haciendo hasta ahora."
    "The look on the scientist's face tells you that's what he's been doing up until now."

# game/scripts/c32/c32.rpy:2448
translate english c32s003_MaelDrug_7731bf2a:

    # mael "Un humano tiene unos 19,500 genes con su código genético y alrededor de 40,000 genes RNA, que producen alrededor de tres mil millones de 'letras'."
    mael "A human has about 19,500 genes with their genetic code and around 40,000 RNA genes, which produce about three billion 'letters'."

# game/scripts/c32/c32.rpy:2449
translate english c32s003_MaelDrug_99cf7892:

    # mael "Los genes del envejecimiento acelerado son un grupo de quince 'letras'."
    mael "The accelerated aging genes are a group of fifteen 'letters'."

# game/scripts/c32/c32.rpy:2451
translate english c32s003_MaelDrug_088a8879:

    # mael "Si coges dos humanos cualesquiera, comparten el 99.9%% de su ADN. 2,997,000,000 'letras'."
    mael "If you take any two humans, they share 99.9%% of their DNA. 2,997,000,000 'letters'."

# game/scripts/c32/c32.rpy:2452
translate english c32s003_MaelDrug_0da02c49:

    # mael "Si coges un padre y un hijo, comparten el 99.95%% de su ADN. 2,998,500,000 'letras'."
    mael "If you take a father and a child, they share 99.95%% of their DNA. 2,998,500,000 'letters'."

# game/scripts/c32/c32.rpy:2453
translate english c32s003_MaelDrug_8cdc2f2c:

    # mael "Tu compartes con los clones 2,997,000,015 'letras'. 99.9000005%%. Excepto con [aar], obviamente."
    mael "You share 2,997,000,015 'letters' with the clones. 99.9000005%%. Except with [aar], obviously."

# game/scripts/c32/c32.rpy:2455
translate english c32s003_MaelDrug_724e339c:

    # mael "En cualquier caso, no eres su 'padre'. Y eso sería simplificándolo mucho y explicado para idiotas."
    mael "In any case, you're not their 'father'. And that would be oversimplifying it a lot, and explaining it for idiots."

# game/scripts/c32/c32.rpy:2456
translate english c32s003_MaelDrug_2a13f622:

    # mael "Escogerte a ti como donante cero y la amplificación de ese grupo de genes hizo que los planes originales de la empresa fracasaran."
    mael "Choosing you as donor zero and the amplification of that gene cluster caused the company's original plans to fail."

# game/scripts/c32/c32.rpy:2457
translate english c32s003_MaelDrug_5fef4978:

    # mael "Por otro lado, hizo que entendiéramos mucho mejor el envejecimiento acelerado."
    mael "On the other hand, it made us understand accelerated aging much better."

# game/scripts/c32/c32.rpy:2458
translate english c32s003_MaelDrug_58644b62:

    # mc "Todo eso lo entiendo... más o menos. Pero qué tiene que ver con usar la droga antienvejecimiento contigo o conmigo."
    mc "I understand all that... more or less. But what does it have to do with using the anti-aging drug on you or me?"

# game/scripts/c32/c32.rpy:2460
translate english c32s003_MaelDrug_f2280a52:

    # mael "Contigo podría funcionar porque tienes ese grupo de genes, aunque no lo tengas amplificado. Pero el resultado sería casi imperceptible."
    mael "It could work on you because you have that gene cluster, even if it's not amplified. But the result would be almost unnoticeable."

# game/scripts/c32/c32.rpy:2461
translate english c32s003_MaelDrug_614d0f95:

    # mael "En ti, la piel 'envejece' más rápido, pero el resto de tu cuerpo tiene tu edad. Por eso pareces mayor, pero tienes la energía que corresponde con tu edad."
    mael "In your case, your skin 'ages' faster, but the rest of your body is your age. That's why you look older, but you have the energy that corresponds to your age."

# game/scripts/c32/c32.rpy:2462
translate english c32s003_MaelDrug_70ca4754:

    # mael "Como te he dicho, hemos reducido el envejecimiento a 1.064. Excepto por tu piel, el resto de tu cuerpo no envejece a esa velocidad."
    mael "Like I told you, we've reduced the aging to 1.064. Except for your skin, the rest of your body doesn't age at that speed."

# game/scripts/c32/c32.rpy:2464
translate english c32s003_MaelDrug_fc765629:

    # mael "Si la usara yo, seguramente no tendría ningún efecto. No tengo ese grupo de genes, con lo que la droga no haría nada en mí."
    mael "If I used it, it probably wouldn't have any effect. I don't have that gene cluster, so the drug wouldn't do anything to me."

# game/scripts/c32/c32.rpy:2466
translate english c32s003_MaelDrug_26a42c84:

    # "Ves cómo se le ilumina la cara por un momento cuando se da cuenta de las implicaciones."
    "You see his face light up for a moment when he realizes the implications."

# game/scripts/c32/c32.rpy:2467
translate english c32s003_MaelDrug_79d9cb53:

    # mael "Pero con el presupuesto adecuado, podría intentar replicarlo para personas sin ese grupo de genes..."
    mael "But with the right budget, I could try to replicate it for people without that gene cluster..."

# game/scripts/c32/c32.rpy:2468
translate english c32s003_MaelDrug_951e9630:

    # mc "*Risa* Casi puedo ver los símbolos de dólar en tus ojos, [mael]. No seas avaricioso."
    mc "*Laugh* I can almost see the dollar signs in your eyes, [mael]. Don't be greedy."

# game/scripts/c32/c32.rpy:2469
translate english c32s003_MaelDrug_8b95871e:

    # mc "De momento, he aceptado no recortar tu presupuesto. Aún tengo que encontrar tres millones anuales para las drogas de los clones."
    mc "For now, I've agreed not to cut your budget. I still have to find three million a year for the clones' drugs."

# game/scripts/c32/c32.rpy:2471
translate english c32s003_MaelDrug_30294f0f:

    # mael "Tenía que intentarlo..."
    mael "I had to try..."

# game/scripts/c32/c32.rpy:2472
translate english c32s003_MaelDrug_938f5ab1:

    # mc "Y, en esta ocasión, yo tengo que negarme a aceptarlo. Quizás más adelante."
    mc "And, this time, I have to refuse to accept it. Maybe later."

# game/scripts/c32/c32.rpy:2473
translate english c32s003_MaelDrug_3ba3848f:

    # mc "Pero sigamos. Tenemos un montón de trabajo pendiente."
    mc "But let's move on. We have a ton of work pending."

# game/scripts/c32/c32.rpy:2477
translate english c32s004_Eric_9bc69a25:

    # centered "{size=+20}{b}DÍA 52 – JUEVES{/b}{/size}"
    centered "{size=+20}{b}DAY 52 – THURSDAY{/b}{/size}"

# game/scripts/c32/c32.rpy:2478
translate english c32s004_Eric_b23037c6:

    # "Los días pasan demasiado rápido entre reuniones y diferentes tareas."
    "The days go by too fast between meetings and various tasks."

# game/scripts/c32/c32.rpy:2479
translate english c32s004_Eric_8fb6f876:

    # "La remodelación de tu despacho empieza dos días después de hablar de ella con [car]."
    "The remodeling of your office starts two days after talking about it with [car]."

# game/scripts/c32/c32.rpy:2480
translate english c32s004_Eric_497491b6:

    # "Jamaal ya tiene las fotos de [ama]."
    "Jamaal already has the photos of [ama]."

# game/scripts/c32/c32.rpy:2482
translate english c32s004_Eric_87a0871e:

    # "Y llega el día de enfrentarte a [erc]."
    "And the day comes to face [erc]."

# game/scripts/c32/c32.rpy:2483
translate english c32s004_Eric_7907732e:

    # "[ama], [aar] y tú le visitáis en una sala habilitada para el interrogatorio. NTR no tiene una sala de interrogatorios como tal."
    "[ama], [aar], and you visit him in a room set up for the interrogation. NTR doesn't have an interrogation room as such."

# game/scripts/c32/c32.rpy:2484
translate english c32s004_Eric_96f93eda:

    # "[eva] participa por videoconferencia."
    "[eva] participates via video conference."

# game/scripts/c32/c32.rpy:2485
translate english c32s004_Eric_e3e3223f:

    # "El plan es que tú lleves el interrogatorio y ellos aporten preguntas que a ti se te puedan pasar. Están demasiado implicados emocionalmente."
    "The plan is for you to lead the interrogation and for them to provide questions you might miss. They're too emotionally involved."

# game/scripts/c32/c32.rpy:2486
translate english c32s004_Eric_d8fed5e9:

    # erc "*Risa* ¿Ez mi comité de ejecución?"
    erc "*Laugh* Iz thiz my execution committee?"

# game/scripts/c32/c32.rpy:2487
translate english c32s004_Eric_d4a6c7aa:

    # "Su pronunciación, agravada por la falta de dientes, provoca un sonido siseante."
    "His pronunciation, aggravated by the lack of teeth, causes a hissing sound."

# game/scripts/c32/c32.rpy:2488
translate english c32s004_Eric_be8b7233:

    # aar "Cállate, [erc]."
    aar "Shut up, [erc]."

# game/scripts/c32/c32.rpy:2489
translate english c32s004_Eric_93a93dc0:

    # mc "Esto es una comisión de investigación. Aún no hay una sentencia."
    mc "This is an investigative commission. There is no sentence yet."

# game/scripts/c32/c32.rpy:2491
translate english c32s004_Eric_6a5ad07a:

    # erc "Ezo no me lo ezperaba. Bueno, no me ezperaba zeguir vivo a eztaz alturaz."
    erc "I wazn't expecting that. Well, I wazn't expecting to ztill be alive at thiz point."

# game/scripts/c32/c32.rpy:2492
translate english c32s004_Eric_bfa337e5:

    # "Su mirada desafiante y su actitud de darle lo mismo lo que hagáis te congela la sangre en las venas."
    "His defiant look and his attitude of not giving a shit about what you do freezes the blood in your veins."

# game/scripts/c32/c32.rpy:2493
translate english c32s004_Eric_3047510e:

    # "Al mismo tiempo, hace que sientas un calor desagradable. Amenazó a tu familia. Posiblemente os hubiera matado si no hubiera sido por [ama] y [eva]."
    "At the same time, it makes you feel an unpleasant heat. He threatened your family. He probably would have killed you all if it hadn't been for [ama] and [eva]."

# game/scripts/c32/c32.rpy:2494
translate english c32s004_Eric_9672b112:

    # mc "Lo que tú esperaras es lo de menos. La empresa ya no se rige por los mismos principios que antes."
    mc "What you expected is the least of it. The company is no longer governed by the same principles as before."

# game/scripts/c32/c32.rpy:2495
translate english c32s004_Eric_689d9711:

    # mc "Estamos aquí para escuchar tu versión de lo que pasó en Newport. Tus compañeros lo han pedido y nosotros hemos aceptado."
    mc "We are here to listen to your version of what happened in Newport. Your colleagues asked for it and we accepted."

# game/scripts/c32/c32.rpy:2497
translate english c32s004_Eric_cb3604ca:

    # "Mira, risueño, a las cámaras apagadas en la pared, al fondo de la sala."
    "He looks, smiling, at the turned-off cameras on the wall at the back of the room."

# game/scripts/c32/c32.rpy:2498
translate english c32s004_Eric_cf9fe9ff:

    # erc "¿Ezoz perdedorez han pedido ezto? Eztoy muy zorprendido."
    erc "Thoze lozerz azked for thiz? I'm very zurprized."

# game/scripts/c32/c32.rpy:2499
translate english c32s004_Eric_6e39e87a:

    # erc "No zon capacez de atarze laz botaz zin que ze lo ordenen."
    erc "They aren't capable of tying their bootz unlez they're ordered to."

# game/scripts/c32/c32.rpy:2501
translate english c32s004_Eric_e22c802c:

    # eva "¿Le podemos disparar ya? Ha abierto la boca lo suficiente como para tener ganas de estar ahí y apretar yo misma el gatillo."
    eva "Can we shoot him already? He's opened his mouth enough to make me want to be there and pull the trigger myself."

# game/scripts/c32/c32.rpy:2502
translate english c32s004_Eric_38a95589:

    # mc "[eva], prometí una revisión justa del caso. No vamos a disparar a nadie. Aún."
    mc "[eva], I promised a fair review of the case. We're not going to shoot anyone. Yet."

# game/scripts/c32/c32.rpy:2504
translate english c32s004_Eric_d5fdca53:

    # aar "¿Qué sabes de la operación de Portland?"
    aar "What do you know about the Portland operation?"

# game/scripts/c32/c32.rpy:2505
translate english c32s004_Eric_ff63967d:

    # aar "Los operativos que sobrevivieron sólo sabían lo que les había contado Enzo."
    aar "The operatives who survived only knew what Enzo had told them."

# game/scripts/c32/c32.rpy:2507
translate english c32s004_Eric_ba605928:

    # erc "Yo no zé nada. Yo zólo cumplía órdenez."
    erc "I don't know anything. I waz juzt following orderz."

# game/scripts/c32/c32.rpy:2508
translate english c32s004_Eric_817263a7:

    # erc "Las órdenez noz fueron dadaz verbalmente a Enzo y a mí. No hay regiztro de ellaz."
    erc "The orderz were given verbally to Enzo and me. There'z no record of them."

# game/scripts/c32/c32.rpy:2509
translate english c32s004_Eric_1b76cdb6:

    # mc "Con lo que tenemos que creer en tu palabra, ¿no?"
    mc "So we just have to take your word for it, right?"

# game/scripts/c32/c32.rpy:2511
translate english c32s004_Eric_5cde44cb:

    # ama "¿De verdad le vas a creer?"
    ama "Are you really going to believe him?"

# game/scripts/c32/c32.rpy:2512
translate english c32s004_Eric_f2b4dd52:

    # mc "De momento tengo que creerle."
    mc "For now, I have to believe him."

# game/scripts/c32/c32.rpy:2514
translate english c32s004_Eric_2da1df79:

    # "[ama] se tensa, reteniéndose de saltar la mesa y estrangular al mercenario que tiene delante."
    "[ama] tenses up, holding herself back from jumping across the table and strangling the mercenary in front of her."

# game/scripts/c32/c32.rpy:2515
translate english c32s004_Eric_7d4e9da7:

    # ama "¿Por qué los E estabais al mando de la operación?"
    ama "Why were the E's in charge of the operation?"

# game/scripts/c32/c32.rpy:2517
translate english c32s004_Eric_0a3e5299:

    # erc "¿A quién iba a poner el Zr. Danielz al mando?"
    erc "Who waz Mr. Danielz going to put in charge?"

# game/scripts/c32/c32.rpy:2518
translate english c32s004_Eric_f4f6b103:

    # erc "Los C zon viejoz. Los D zon idiotaz. Los F... digamoz que zon demaziado jóvenez para una mizión azí."
    erc "The Cz are old. The Dz are idiotz. The Fz... let'z juzt zay they're too young for a mizzion like that."

# game/scripts/c32/c32.rpy:2519
translate english c32s004_Eric_f0a0a51d:

    # erc "Loz únicoz que podíamoz llevar a cabo el trabajo éramoz loz E."
    erc "The only onez who could get the job done were the Ez."

# game/scripts/c32/c32.rpy:2520
translate english c32s004_Eric_0e2cd135:

    # mc "¿Sabíais que la misión atentaba contra los principios fundacionales de NTR? ¿Contra la voluntad de los fundadores?"
    mc "Did you know the mission went against the founding principles of NTR? Against the founders' will?"

# game/scripts/c32/c32.rpy:2522
translate english c32s004_Eric_61d3c119:

