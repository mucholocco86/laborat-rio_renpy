# game/scripts/c22/c22.rpy:2179
translate english c22s004_EveNoRoute_7c4f0b77:

    # eva "Cuando llegó ayer yo estaba molida. Quería contármelo cuando me despertara, antes de ir a cenar a casa."
    eva "When she arrived yesterday, I was exhausted. She wanted to tell me about it when I woke up, before we went home for dinner."

# game/scripts/c22/c22.rpy:2180
translate english c22s004_EveNoRoute_fdd9098f:

    # eva "Pero me despertó la llamada de Aaron para decirnos lo de Gavin."
    eva "But I was awakened by [aar]'s call to tell us about Gavin."

# game/scripts/c22/c22.rpy:2181
translate english c22s004_EveNoRoute_269fe6c5:

    # eva "Supongo que me puse demasiado borde y no quería contármelo entonces."
    eva "I guess I got too sour and she didn't want to tell me about it then."

# game/scripts/c22/c22.rpy:2182
translate english c22s004_EveNoRoute_d21196a6:

    # mc "Sabes que a mí no me gustan los secretos."
    mc "You know I don't like secrets."

# game/scripts/c22/c22.rpy:2184
translate english c22s004_EveNoRoute_01e892ae:

    # eva "Lo sé. Y en este caso era justificado. No sé cómo hubiera recibido la noticia antes de que llegaras."
    eva "I know. And, in this case, it was justified. I don't know how I would have received the news before you arrived."

# game/scripts/c22/c22.rpy:2185
translate english c22s004_EveNoRoute_c949557a:

    # eva "Tus abrazos tienen algo de curativo. ¿Te lo han dicho alguna vez?"
    eva "There's something curative in your hugs. Has anyone ever told you that?"

# game/scripts/c22/c22.rpy:2186
translate english c22s004_EveNoRoute_c0c7f532:

    # mc "*Risa* Sí, alguna vez me lo han dicho."
    mc "*Laugh* Yeah, I've been told that before."

# game/scripts/c22/c22.rpy:2188
translate english c22s004_EveNoRoute_f28a609b:

    # eva "Ahora vas a tener que irte. Quiero ducharme. Apesto."
    eva "I need you to leave now. I want to shower. I stink."

# game/scripts/c22/c22.rpy:2189
translate english c22s004_EveNoRoute_9ecb9510:

    # eva "[ama] quería hablar contigo sobre algo del viaje a Aruba."
    eva "[ama] wanted to talk to you about something on the Aruba trip."

# game/scripts/c22/c22.rpy:2190
translate english c22s004_EveNoRoute_344bf5f0:

    # mc "¿Te veo luego?"
    mc "Will I see you later?"

# game/scripts/c22/c22.rpy:2191
translate english c22s004_EveNoRoute_362ece90:

    # eva "¡Por supuesto!"
    eva "Of course!"

# game/scripts/c22/c22.rpy:2193
translate english c22s004_EveNoRoute_5fa41bfe:

    # "Nada más entrar en la sala de control, suena tu teléfono"
    "As soon as you enter the control room, your phone rings."

# game/scripts/c22/c22.rpy:2196
translate english c22s003_IronFistCalls_7dda0259:

    # "*Ring-Ring*"
    "*Ring-Ring*"

# game/scripts/c22/c22.rpy:2197
translate english c22s003_IronFistCalls_9ba0a8c0:

    # mcp "(Número desconocido...)"
    mcp "(Unknown number...)"

# game/scripts/c22/c22.rpy:2199
translate english c22s003_IronFistCalls_6c5f241b:

    # mc "Hola, [mc] Marks al habla."
    mc "Hello, [mc] Marks speaking."

# game/scripts/c22/c22.rpy:2200
translate english c22s003_IronFistCalls_5d7bf905:

    # mcp "(Acabo de sonar super ridículo.)"
    mcp "(I just sounded super ridiculous. Someday I'll think of a funny line to answer the phone with.)"

# game/scripts/c22/c22.rpy:2201
translate english c22s003_IronFistCalls_391a3adf:

    # man "Buenos días, Sr. Marks. Le llamo de Iron Fist, soy Jeff Sound, el asistente del Sr. Ichigo, Vicepresidente de Operaciones."
    man "Good morning, Mr. Marks. I'm calling from Iron Fist, this is Jeff Sound, Mr. Ichigo's assistant, Vice President of Operations."

# game/scripts/c22/c22.rpy:2202
translate english c22s003_IronFistCalls_a40dc997:

    # mc "Un momento, Sr. Sound. Le pongo en manos libres, tengo una persona de mi equipo aquí que va a estar interesada en esta conversación."
    mc "Just a moment, Mr. Sound. I'm putting you on speaker, I have one person from my team here who's going to be interested in this conversation."

# game/scripts/c22/c22.rpy:2204
translate english c22s003_IronFistCalls_dd32dc13:

    # jef "Ningún problema, Sr. Marks."
    jef "No problem, Mr. Marks."

# game/scripts/c22/c22.rpy:2206
translate english c22s003_IronFistCalls_ea0ae3a0:

    # ama "Buenos días, Sr. Sound. Soy [ama] Gilford. Le escucho bien."
    ama "Good morning, Mr. Sound. I am [ama] Gilford. I can hear you."

# game/scripts/c22/c22.rpy:2207
translate english c22s003_IronFistCalls_6b91c75d:

    # jef "Encantado de hablar con usted, Srta. Gilford. ¿O es Sra.?"
    jef "Nice talking to you, Ms. Gilford. Or is it Mrs.?"

# game/scripts/c22/c22.rpy:2209
translate english c22s003_IronFistCalls_1b076072:

    # ama "Srta. está bien."
    ama "Ms. is fine."

# game/scripts/c22/c22.rpy:2210
translate english c22s003_IronFistCalls_015cdb0f:

    # mc "Dígame, Sr. Sound."
    mc "Tell us, Mr. Sound."

# game/scripts/c22/c22.rpy:2211
translate english c22s003_IronFistCalls_6804df4e:

    # jef "Les llamo porque han llegado a nosotros informaciones sobre el cambio de propiedad de NTR y..."
    jef "I am calling because information has reached us about the change of ownership of NTR and..."

# game/scripts/c22/c22.rpy:2212
translate english c22s003_IronFistCalls_5d519b79:

    # mc "¿Me puede decir de dónde han sacado esa información? ¿Y este número de teléfono?"
    mc "Can you tell me where you got this information? And this phone number?"

# game/scripts/c22/c22.rpy:2213
translate english c22s003_IronFistCalls_306afe27:

    # jef "Esa es una información reservada, Sr. Marks. No podemos revelar nuestras fuentes."
    jef "That is confidential information, Mr. Marks. We can't reveal our sources."

# game/scripts/c22/c22.rpy:2215
translate english c22s003_IronFistCalls_886708b9:

    # ama "Estaba hablando usted del cambio de propiedad de NTR. Siga, por favor."
    ama "You were talking about the change of ownership of NTR. Go on, please."

# game/scripts/c22/c22.rpy:2216
translate english c22s003_IronFistCalls_2caf15f7:

    # jef "Sí. Nos hemos enterado del cambio de propiedad y de que ésta ha recaído en un grupo representado por el Sr. Marks."
    jef "Yes. We have learned of the change in ownership and that it has shifted to a group represented by Mr. Marks."

# game/scripts/c22/c22.rpy:2217
translate english c22s003_IronFistCalls_3fa127ba:

    # ama "Exacto."
    ama "Exactly."

# game/scripts/c22/c22.rpy:2218
translate english c22s003_IronFistCalls_6c01e46a:

    # jef "También nos han llegado noticias de que el Sr. Marks va a ocupar el puesto de CEO en breve."
    jef "We have also received word that Mr. Marks will be taking over the CEO position shortly."

# game/scripts/c22/c22.rpy:2219
translate english c22s003_IronFistCalls_528a8536:

    # ama "Sí. Esas informaciones son exactas."
    ama "Yes. That information is accurate."

# game/scripts/c22/c22.rpy:2220
translate english c22s003_IronFistCalls_db3ac24a:

    # jef "¿Me podrían decir quién es ese grupo de accionistas, por favor?"
    jef "Could you tell me who this group of shareholders is, please?"

# game/scripts/c22/c22.rpy:2222
translate english c22s003_IronFistCalls_2e120bea:

    # mc "Son..."
    mc "They are..."

# game/scripts/c22/c22.rpy:2223
translate english c22s003_IronFistCalls_19797f13:

    # ama "No creo que sea de su interés, Sr. Sound. Están representados por el Sr. Marks y él es capaz de hablar por ellos."
    ama "I don't think it's in their best interest, Mr. Sound. They are represented by Mr. Marks, and he is able to speak for them. Confidenciality, you know."

# game/scripts/c22/c22.rpy:2224
translate english c22s003_IronFistCalls_a6c58ba9:

    # ama "¿Quería algo más?"
    ama "Did you want anything else?"

# game/scripts/c22/c22.rpy:2225
translate english c22s003_IronFistCalls_ae258745:

    # jef "También llamaba porque al Sr. Ichigo le gustaría reunirse con el Sr. Marks."
    jef "I was also calling because Mr. Ichigo would like to meet with Mr. Marks."

# game/scripts/c22/c22.rpy:2226
translate english c22s003_IronFistCalls_f68c9824:

    # mc "¿Por alguna razón en concreto?"
    mc "For any specific reason?"

# game/scripts/c22/c22.rpy:2227
translate english c22s003_IronFistCalls_b8e36178:

    # jef "Una primera toma de contacto entre dos de las principales empresas del sector. El Sr. Ichigo se había reunido varias veces con el Sr. Daniels."
    jef "A first contact between two of the leading companies in the industry. Mr. Ichigo met with Mr. Daniels several times."

# game/scripts/c22/c22.rpy:2229
translate english c22s003_IronFistCalls_6f9ec9b5:

    # ama "*Pone el móvil en mute* Xabier Daniels era el jefe de GILF que empezó la Guerra Clon."
    ama "*Puts cell phone on mute* Xabier Daniels was the GILF boss who started the Clone War."

# game/scripts/c22/c22.rpy:2230
translate english c22s003_IronFistCalls_c95b64af:

    # "Asientes."
    "You nod."

# game/scripts/c22/c22.rpy:2231
translate english c22s003_IronFistCalls_372a491b:

    # mc "Desafortunadamente, el Sr. Daniels ya no trabaja con nosotros, pero si se trata de una visita de cortesía, no tengo ningún problema en conocer al Sr. Ichigo."
    mc "Unfortunately, Mr. Daniels no longer works with us, but if it is a courtesy visit, I have no problem meeting Mr. Ichigo."

# game/scripts/c22/c22.rpy:2232
translate english c22s003_IronFistCalls_72b19fea:

    # jef "Muchas gracias, Sr. Marks. El Sr. Ichigo estará en Vandenberg mañana por la tarde, y dará una recepción para algunos clientes en su yate por la noche."
    jef "Thank you very much, Mr. Marks. Mr. Ichigo will be in Vandenberg tomorrow afternoon, and will be giving a reception for some customers on his yacht in the evening."

# game/scripts/c22/c22.rpy:2233
translate english c22s003_IronFistCalls_5d55801b:

    # jef "Le gustaría que acudiera."
    jef "He would like you to attend."

# game/scripts/c22/c22.rpy:2235
translate english c22s003_IronFistCalls_7f58a0aa:

    # ama "Imposible. El Sr. Marks tiene la agenda ocupada hasta el viernes. Debería ser a partir del sábado."
    ama "Impossible. Mr. Marks has a busy schedule until Friday. It has to be from Saturday onwards."

# game/scripts/c22/c22.rpy:2236
translate english c22s003_IronFistCalls_f359de1c:

    # jef "Déjeme mirar un tema. Un momento..."
    jef "Let me look at Mr. Ichigo's schedule. One moment, please..."

# game/scripts/c22/c22.rpy:2237
translate english c22s003_IronFistCalls_e8924f49:

    # jef "El sábado es un buen día. Hay un evento más pequeño en el yate frente al puerto de Westport. Tendrán más oportunidades de conocerse."
    jef "Saturday is a good day. There's a smaller event on the yacht in front of Westport Harbor. You'll have more opportunities to get to know each other."

# game/scripts/c22/c22.rpy:2239
translate english c22s003_IronFistCalls_68fcb964:

    # ama "El sábado entonces. ¿Transporte?"
    ama "Saturday then. Transportation?"

# game/scripts/c22/c22.rpy:2240
translate english c22s003_IronFistCalls_1337076f:

    # jef "Podemos enviar un helicóptero a recoger al Sr. Marks."
    jef "We can send a helicopter to pick up Mr. Marks."

# game/scripts/c22/c22.rpy:2241
translate english c22s003_IronFistCalls_f3ffb496:

    # ama "Y a mí. Iremos juntos."
    ama "And me too. We'll go together."

# game/scripts/c22/c22.rpy:2242
translate english c22s003_IronFistCalls_2135db09:

    # jef "Perfecto. Nos tendrán que indicar dónde quieren que les recojamos."
    jef "Perfect. You'll have to tell us where you want us to pick you up."

# game/scripts/c22/c22.rpy:2244
translate english c22s003_IronFistCalls_647b9adc:

    # "[ama] continúa atando detalles de la reunión, dando indicaciones y detalles, pero sin revelar ninguna información."
    "[ama] continues to tie up details about the meeting, giving hints and details, but without revealing any sensible information."

# game/scripts/c22/c22.rpy:2245
translate english c22s003_IronFistCalls_ed693545:

    # "Consigue algunos nombres de las personas que asistirán al evento menor, y el Sr. Sound se compromete a enviarle la lista completa de invitados."
    "She gets a few names of the people who will be attending the smaller event, and Mr. Sound agrees to send her the complete guest list."

# game/scripts/c22/c22.rpy:2246
translate english c22s003_IronFistCalls_a48b253f:

    # "Aunque vaya vestida de mecánico, es mucho mejor en esto de lo que tú serías con un traje."
    "Even if she's dressed as a mechanic, she's a lot better at this than you'd be in a suit."

# game/scripts/c22/c22.rpy:2247
translate english c22s003_IronFistCalls_fcea9a6f:

    # "Unos minutos después os despedís del Sr. Sound."
    "A few minutes later you say goodbye to Mr. Sound."

# game/scripts/c22/c22.rpy:2249
translate english c22s003_IronFistCalls_d96573d6:

    # ama "Ya está. El sábado nos reunimos con Ichigo."
    ama "That's it. We'll meet with Ichigo on Saturday."

# game/scripts/c22/c22.rpy:2250
translate english c22s003_IronFistCalls_2d22882c:

    # mc "He estado a punto de meter la pata con lo de los accionistas, ¿verdad?"
    mc "I almost screwed up with the shareholder thing, didn't I?"

# game/scripts/c22/c22.rpy:2252
translate english c22s003_IronFistCalls_180508eb:

    # ama "Sí, un poco. Nunca des información si no es necesario. Si no tienen los nombres de los accionistas tienen que pasar por ti para todo."
    ama "Yes, a bit. Never give out any information if you don't have to. If they don't have the names of the shareholders they have to go through you for everything."

# game/scripts/c22/c22.rpy:2253
translate english c22s003_IronFistCalls_3c34a0cb:

    # ama "Es nuestra forma de controlar el flujo de información. Cuánto más anónimas sean las chicas, mejor. No podrán contactarlas directamente."
    ama "It's our way of controlling the information flow. The more anonymous the girls are, the better. They won't be able to contact them directly."

# game/scripts/c22/c22.rpy:2254
translate english c22s003_IronFistCalls_2d2ddaaa:

    # mc "Me viene muy grande todo esto."
    mc "This is all too big for me."

# game/scripts/c22/c22.rpy:2256
translate english c22s003_IronFistCalls_6f275ac6:

    # ama "No te preocupes, aprenderás. Esto es nuevo para ti, pero al menos te das cuenta de cuándo estás a punto de cometer un error."
    ama "Don't worry, you'll learn. This is new to you, but at least you let me step in to answer the question. I’m sorry for that."

# game/scripts/c22/c22.rpy:2257
translate english c22s003_IronFistCalls_070a9693:

    # ama "Lo que tienes que aprender es a darte cuenta antes de cometerlo."
    ama "What you have to learn, is to consider your responses more before you talk."

# game/scripts/c22/c22.rpy:2258
translate english c22s003_IronFistCalls_d3ffc09e:

    # mc "Si no hubieras estado aquí... hubiera aceptado la reunión de mañana. ¿Por qué la has rechazado?"
    mc "If you hadn't been here...I would have accepted the meeting tomorrow. Why did you turn it down?"

# game/scripts/c22/c22.rpy:2260
translate english c22s003_IronFistCalls_f0a1b841:

    # ama "*Risa* Porque la han propuesto ellos. Si nos negamos a su primera propuesta, se pueden poner ansiosos."
    ama "*Laugh* Because they proposed it. If we refuse their first proposal, they might get anxious."

# game/scripts/c22/c22.rpy:2261
translate english c22s003_IronFistCalls_bcad0b66:

    # ama "Si aceptamos una propuesta así con tan poca antelación, parece que estemos besándoles el culo."
    ama "If we accept a proposal like that, on such a short notice, it feels like we're kissing their asses."

# game/scripts/c22/c22.rpy:2263
translate english c22s003_IronFistCalls_1f6dad46:

    # ama "De esta forma demostramos que son ellos los que tienen interés y no nosotros."
    ama "This way, we show that they are the ones who are interested. Not us."

# game/scripts/c22/c22.rpy:2264
translate english c22s003_IronFistCalls_111d4888:

    # ama "Si no hubieran tenido el evento del sábado, posiblemente se hubieran tenido que inventar algo para forzar esa reunión informal."
    ama "If they hadn't had the Saturday event, they possibly would have had to come up with something to force that informal meeting."

# game/scripts/c22/c22.rpy:2265
translate english c22s003_IronFistCalls_2d9d8c2c:

    # mc "Que de informal tendrá poco, ¿no?"
    mc "That meeting will be anything but informal, won't it?"

# game/scripts/c22/c22.rpy:2267
translate english c22s003_IronFistCalls_51ab4840:

    # ama "Poquísimo. Vandenberg es una base de la Fuerza Aérea, más dedicada al espacio que a algo con lo que Iron Fist tenga algo que ver."
    ama "Exactly. Vandenberg is an Air Force base, more dedicated to space than anything Iron Fist has something to do with."

# game/scripts/c22/c22.rpy:2268
translate english c22s003_IronFistCalls_6e0ea7a5:

    # ama "Te querían demostrar que son fuertes y que tienen contactos en todos lados. No te conocen y te quieren impresionar."
    ama "They wanted to show you that they are strong and have contacts everywhere. They don't know you and they want to impress you."

# game/scripts/c22/c22.rpy:2269
translate english c22s003_IronFistCalls_dbeb0dd0:

    # ama "Seguro que al evento en Westport va algún coronel de Fort Hunter Liggett. Está a menos de dos horas."
    ama "I'm sure the event in Westport is attended by some colonel from Fort Hunter Liggett. It's less than two hours away."

# game/scripts/c22/c22.rpy:2270
translate english c22s003_IronFistCalls_e950b2e2:

    # mc "Hay demasiados matices en todo esto y yo no tengo ni idea... Creo que tú, [eva], o [aar] seríais mejores CEO que yo."
    mc "There are too many nuances to all of this, and I have no idea... I think you, [eva], or [aar] would be a better CEO than me."

# game/scripts/c22/c22.rpy:2272
translate english c22s003_IronFistCalls_7b341c6d:

    # ama "Nosotros somos operativos de campo. No tenemos ni idea de cómo gestionar una empresa, pero conocemos el negocio."
    ama "We are field operatives. We have no idea how to run a company, but we know the business."

# game/scripts/c22/c22.rpy:2273
translate english c22s003_IronFistCalls_d110c58d:

    # ama "Nuestro problema es de visión, al menos el mío. Tengo una visión limitada del conjunto."
    ama "Our problem is one of vision, at least mine. I have a limited view of the whole picture."

# game/scripts/c22/c22.rpy:2274
translate english c22s003_IronFistCalls_dd063c89:

    # ama "[aar] no es una figura cómoda en NTR para los que trabajaron bajo las órdenes de Xabier."
    ama "[aar] is not a comfortable figure in NTR for those who worked under Xabier."

# game/scripts/c22/c22.rpy:2275
translate english c22s003_IronFistCalls_5bc7e3dd:

    # ama "Y [eva] tiene el problema del martillo."
    ama "And [eva] has the hammer problem."

# game/scripts/c22/c22.rpy:2276
translate english c22s003_IronFistCalls_55a23645:

    # mc "¿Martillo?"
    mc "Hammer problem?"

# game/scripts/c22/c22.rpy:2278
translate english c22s003_IronFistCalls_1b21ec91:

    # ama "Para [eva], sus armas son sus herramientas. Su martillo. Y cualquier problema es un clavo."
    ama "For [eva], her weapons are her tools. Her hammer. And any problem is a nail."

# game/scripts/c22/c22.rpy:2279
translate english c22s003_IronFistCalls_aebbd428:

    # ama "Intentaría resolver cualquier problema con la fuerza, y no es la dirección que queremos darle a la empresa, ¿no?"
    ama "She would try to solve any problem with force, and that's not the direction we want to take the company, is it?"

# game/scripts/c22/c22.rpy:2280
translate english c22s003_IronFistCalls_ab6417a5:

    # mc "No, en eso tienes razón. *Risa* No queremos que hundan el yate de Ichigo."
    mc "No, you're right about that. *Laugh* We don't want anyone to sink Ichigo's yacht."

# game/scripts/c22/c22.rpy:2282
translate english c22s003_IronFistCalls_a3396ac1:

    # ama "Bueno, tengo que arreglar unos temas para la reunión del sábado y buscar información sobre los asistentes. Te voy a tener que dejar."
    ama "Well, I have to arrange some issues for Saturday's meeting and look for information about the attendees. I'm going to leave you."

# game/scripts/c22/c22.rpy:2283
translate english c22s003_IronFistCalls_fc619746:

    # mc "¿Has pensado en pedirle ayuda a Jamaal? Creo que os podría ser útil para buscar cosas."
    mc "Have you thought about asking Jamaal for help? I think he could be useful to you guys in helping to do research."

# game/scripts/c22/c22.rpy:2284
translate english c22s003_IronFistCalls_27c95d9c:

    # ama "No es mala idea. Le llamaré esta tarde, cuando volvamos de comer en casa de [nor]."
    ama "That's not a bad idea. I'll call him this afternoon, when we get back from lunch at [nor]'s house."

# game/scripts/c22/c22.rpy:2286
translate english c22s003_IronFistCalls_e0575fec:

    # ama "Y, por cierto, gracias por lo de [eva]."
    ama "And, by the way, thanks for how you managed [eva]'s issue."

# game/scripts/c22/c22.rpy:2287
translate english c22s003_IronFistCalls_46cea44c:

    # mc "¿Gracias por qué? Es tu hermana, pero es mi prima."
    mc "Thanks for what? She's your sister, but she's my cousin."

# game/scripts/c22/c22.rpy:2288
translate english c22s003_IronFistCalls_131c04dc:

    # ama "Tienes razón, pero no por ello estoy menos agradecida por lo que has hecho."
    ama "You're right, but that doesn't make me any less grateful for what you've done."

# game/scripts/c22/c22.rpy:2290
translate english c22s003_IronFistCalls_6ed672c4:

    # mc "Y también mi novia, por lo que parece."
    mc "And now she's also my girlfriend, by the looks of it."

# game/scripts/c22/c22.rpy:2292
translate english c22s003_IronFistCalls_31693633:

    # ama "*Risa* ¿Por qué odias tanto esa palabra?"
    ama "*Laugh* Why do you hate that word so much?"

# game/scripts/c22/c22.rpy:2293
translate english c22s003_IronFistCalls_f8cb2d92:

    # mc "Porque cuando se dice tantas veces pierde el significado. Además nunca me han gustado las etiquetas."
    mc "Because when it's said so many times it loses its meaning. Plus, I've never liked labels."

# game/scripts/c22/c22.rpy:2295
translate english c22s003_IronFistCalls_c1490d2d:

    # mc "*Risa* Suena muy raro decir que las dos sois mis novias. Creo que no es el uso que tenían pensado cuando inventaron la puta palabra."
