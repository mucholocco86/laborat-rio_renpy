translate english c22s003_AmaCalls_20acc60e:

    # "Diez minutos después..."
    "Ten minutes later..."

# game/scripts/c22/c22.rpy:1697
translate english c22s003_AmaCalls_22ade097:

    # mc "¿Qué pasa [ama]?"
    mc "What's the matter [ama]?"

# game/scripts/c22/c22.rpy:1698
translate english c22s003_AmaCalls_e67b790b:

    # "No puedes evitar fijarte en la muñeca encima de la mesa."
    "You can't help but notice the doll on top of the table."

# game/scripts/c22/c22.rpy:1699
translate english c22s003_AmaCalls_e99eb1e9:

    # ama "Es [eva]. Está muy jodida desde anoche."
    ama "It's [eva]. She's really been fucked up since last night."

# game/scripts/c22/c22.rpy:1700
translate english c22s003_AmaCalls_0ad7b85d:

    # mc "¿Qué pasó anoche?"
    mc "What happened last night?"

# game/scripts/c22/c22.rpy:1702
translate english c22s003_AmaCalls_0929a417:

    # ama "Nos llamó Aaron. Gavin ha perdido el brazo."
    ama "We got a call from [aar]. Gavin has lost his arm."

# game/scripts/c22/c22.rpy:1703
translate english c22s003_AmaCalls_c0b62619:

    # mc "¿Gavin? ¿Quién es Gavin?"
    mc "Gavin? Who is Gavin?"

# game/scripts/c22/c22.rpy:1705
translate english c22s003_AmaCalls_df6f3fe4:

    # ama "Durante el secuestro... en la cocina... El Serie G a quién disparó [eva]."
    ama "During the kidnapping... in the kitchen... The G Series who [eva] shot in the shoulder."

# game/scripts/c22/c22.rpy:1706
translate english c22s003_AmaCalls_4b65fb16:

    # mc "¡Hostias! ¡Había olvidado su nombre! Recordaba a Erik y a Grant."
    mc "Damn! I'd forgotten his name! I remembered Eric and Grant."

# game/scripts/c22/c22.rpy:1707
translate english c22s003_AmaCalls_38938ae3:

    # mc "Parezco tonto... iba a preguntar si está grave."
    mc "I am dumb... I was going to ask if he's gravely injured."

# game/scripts/c22/c22.rpy:1709
translate english c22s003_AmaCalls_9ee20603:

    # ama "Sí, está grave. Fuera de peligro, pero grave."
    ama "Yes, he's hurt badly. Out of danger, but grave."

# game/scripts/c22/c22.rpy:1710
translate english c22s003_AmaCalls_1e3e6765:

    # ama "Aunque le hicimos los primeros auxilios y lo evacuamos a Aruba en un avión medicalizado, no le han podido salvar el brazo."
    ama "Although we gave him first aid and evacuated him to Aruba in a medicalized plane, they couldn't save his arm."

# game/scripts/c22/c22.rpy:1711
translate english c22s003_AmaCalls_4e1bc8fc:

    # ama "[eva] le destrozó los nervios."
    ama "[eva] shattered his nerves and bones."

# game/scripts/c22/c22.rpy:1712
translate english c22s003_AmaCalls_c3dc8ad6:

    # mc "Pero eran los malos, no se debería sentir así. Nos salvasteis."
    mc "But they were the bad guys, she shouldn't feel that way. You saved us."

# game/scripts/c22/c22.rpy:1714
translate english c22s003_AmaCalls_74575155:

    # ama "[mc], parte del entrenamiento de los G lo hicieron [eva] y Diana. Conocíamos a los chicos desde que eran niños..."
    ama "[mc], some of the G's training was done by [eva] and Diana. We knew the guys since they were kids..."

# game/scripts/c22/c22.rpy:1715
translate english c22s003_AmaCalls_c691fab9:

    # mc "Lo entiendo. ¿Cómo está ella?"
    mc "I understand. How is she doing?"

# game/scripts/c22/c22.rpy:1717
translate english c22s003_AmaCalls_5dae45bb:

    # ama "Muy jodida. Después de vaciar seis cargadores se ha metido en su habitación."
    ama "She's fucked up. After emptying six magazines, she went into her room."

# game/scripts/c22/c22.rpy:1718
translate english c22s003_AmaCalls_9d125419:

    # ama "No quiere hablar conmigo. Por eso te he llamado."
    ama "She doesn't want to talk to me. That's why I called you."

# game/scripts/c22/c22.rpy:1719
translate english c22s003_AmaCalls_8ac27694:

    # mc "¿Y cómo estás tú?"
    mc "And how are you doing?"

# game/scripts/c22/c22.rpy:1721
translate english c22s003_AmaCalls_55ed25ae:

    # ama "Jodida, pero menos. No lo conocía tanto como [eva], y no fui yo quien disparó."
    ama "Fucked up, but less so. I didn't know him as well as [eva], and I wasn't the one who fired."

# game/scripts/c22/c22.rpy:1722
translate english c22s003_AmaCalls_1450603d:

    # ama "[eva] es quién necesita hablar ahora mismo, no te preocupes por mí."
    ama "[eva] is the one who needs to talk right now, don't worry about me."

# game/scripts/c22/c22.rpy:1723
translate english c22s003_AmaCalls_ae45af4c:

    # mc "¿Crees que va a querer hablar conmigo?"
    mc "Do you think she's going to want to talk to me?"

# game/scripts/c22/c22.rpy:1725
translate english c22s003_AmaCalls_ac09df05:

    # ama "Hasta cierto punto representas la razón por la que disparó."
    ama "To some extent, you represent the reason she shot him."

# game/scripts/c22/c22.rpy:1726
translate english c22s003_AmaCalls_f4956f9a:

    # ama "No por ti. Por la familia."
    ama "Not because of you. Because of the family."

# game/scripts/c22/c22.rpy:1727
translate english c22s003_AmaCalls_93f7def9:

    # ama "Una familia que ni siquiera sabíamos que teníamos por entonces."
    ama "A family we didn't even know we had at the time."

# game/scripts/c22/c22.rpy:1728
translate english c22s003_AmaCalls_cc0a482f:

    # mc "Lo entiendo. Déjame intentarlo. Sólo espero que no me dispare."
    mc "I understand. Let me give it a try. I just hope she doesn't shoot me."

# game/scripts/c22/c22.rpy:1730
translate english c22s003_AmaCalls_dd0461ef:

    # "*Knock-Knock*"
    "*Knock-Knock*"

# game/scripts/c22/c22.rpy:1731
translate english c22s003_AmaCalls_7ee1cfab:

    # mc "[eva], soy yo. ¿Puedo pasar?"
    mc "[eva], it's me. May I come in?"

# game/scripts/c22/c22.rpy:1732
translate english c22s003_AmaCalls_913eaf57:

    # eva "*A través de la puerta* ¡No!"
    eva "*Through the door* No!"

# game/scripts/c22/c22.rpy:1733
translate english c22s003_AmaCalls_35a4914f:

    # mc "No me voy a ir a menos que salgas con un arma y me eches."
    mc "I'm not leaving unless you come out with a gun and kick me out."

# game/scripts/c22/c22.rpy:1734
translate english c22s003_AmaCalls_96b3f929:

    # eva "*A través de la puerta* No quiero ver a nadie, [mc]."
    eva "*Through the door* I don't want to see anyone, [mc]."

# game/scripts/c22/c22.rpy:1735
translate english c22s003_AmaCalls_be088dc4:

    # mc "OK. Me voy."
    mc "OK. I'm going."

# game/scripts/c22/c22.rpy:1736
translate english c22s003_AmaCalls_1d338278:

    # eva "*A través de la puerta* Gracias por entenderlo, [mc]."
    eva "*Through the door* Thanks for understanding, [mc]."

# game/scripts/c22/c22.rpy:1738
translate english c22s003_AmaCalls_efd3647b:

    # "Esperas un minuto al lado de la puerta antes de volver a llamar."
    "You wait for a minute by the door before you knock again."

# game/scripts/c22/c22.rpy:1739
translate english c22s003_AmaCalls_dd0461ef_1:

    # "*Knock-Knock*"
    "*Knock-Knock*"

# game/scripts/c22/c22.rpy:1740
translate english c22s003_AmaCalls_7bb8904d:

    # "No hay respuesta."
    "There's no answer."

# game/scripts/c22/c22.rpy:1741
translate english c22s003_AmaCalls_dd0461ef_2:

    # "*Knock-Knock*"
    "*Knock-Knock*"

# game/scripts/c22/c22.rpy:1742
translate english c22s003_AmaCalls_003de099:

    # eva "*A través de la puerta* ¡Vete, [ama]!"
    eva "*Through the door* Go away, [ama]!"

# game/scripts/c22/c22.rpy:1743
translate english c22s003_AmaCalls_e2696b73:

    # mc "*Cambiando la voz* Traigo una entrega para la Srta. [eva] Gilford."
    mc "*Changing voices* I bring a delivery for Miss [eva] Gilford."

# game/scripts/c22/c22.rpy:1744
translate english c22s003_AmaCalls_357dc4bd:

    # eva "*A través de la puerta* [mc], no estoy de humor para bromas."
    eva "*Through the door* [mc], I'm not in the mood for jokes."

# game/scripts/c22/c22.rpy:1745
translate english c22s003_AmaCalls_8c2a994e:

    # mc "*Cambiando la voz* Es un abrazo del Sr. [mc] Marks."
    mc "*Changing voice* It's a hug from Mr. [mc] Marks."

# game/scripts/c22/c22.rpy:1746
translate english c22s003_AmaCalls_03d54948:

    # "Pasan unos segundos sin que se oiga nada."
    "A few seconds go by with no sound coming from inside the room."

# game/scripts/c22/c22.rpy:1747
translate english c22s003_AmaCalls_163cb1f9:

    # eva "*A través de la puerta* Pasa..."
    eva "*Through the door* Come in..."

# game/scripts/c22/c22.rpy:1749
translate english c22s003_AmaCalls_a9487c9a:

    # mc "¿Cómo estás?"
    mc "How are you doing?"

# game/scripts/c22/c22.rpy:1750
translate english c22s003_AmaCalls_95e2709c:

    # eva "Queriendo estar sola, pero no me dejáis."
    eva "Wanting to be alone, but you won't let me."

# game/scripts/c22/c22.rpy:1751
translate english c22s003_AmaCalls_c200bccf:

    # mc "¿Quieres ese abrazo?"
    mc "Do you want that hug?"

# game/scripts/c22/c22.rpy:1753
translate english c22s003_AmaCalls_fa05883a:

    # eva "Te he dicho que no estoy de humor para bromas, [mc]."
    eva "I told you I'm not in the mood for jokes, [mc]."

# game/scripts/c22/c22.rpy:1754
translate english c22s003_AmaCalls_3a76a33d:

    # eva "No quiero ponerme borde o maleducada, pero no es el mejor momento."
    eva "I don't want to get rude or bitchy, but it's not the best time for joking."

# game/scripts/c22/c22.rpy:1755
translate english c22s003_AmaCalls_26e320bf:

    # mc "OK. Te entiendo."
    mc "OK. I hear you."

# game/scripts/c22/c22.rpy:1756
translate english c22s003_AmaCalls_2ce98e3c:

    # mc "¿Te importa si me siento?"
    mc "Do you mind if I sit down?"

# game/scripts/c22/c22.rpy:1758
translate english c22s003_AmaCalls_1efe5fbb:

    # eva "Lo vas a hacer quiera o no quiera yo, ¿verdad?"
    eva "You're going to do it whether I want you to or not, aren't you?"

# game/scripts/c22/c22.rpy:1759
translate english c22s003_AmaCalls_494a6419:

    # mc "Sí."
    mc "Yes."

# game/scripts/c22/c22.rpy:1760
translate english c22s003_AmaCalls_97a257c1:

    # eva "Entonces siéntate."
    eva "Then sit down."

# game/scripts/c22/c22.rpy:1762
translate english c22s003_AmaCalls_13d27f07:

    # "Te sientas en silencio durante un rato, mirándola, contagiándote de su tristeza."
    "You sit quietly for a while, watching her, being infected by her sadness."

# game/scripts/c22/c22.rpy:1763
translate english c22s003_AmaCalls_8ddd4361:

    # "No puedes sentirlo por Gavin más allá de que sea una persona que ha perdido un brazo. Una persona que ahora es tu responsabilidad."
    "You can't feel sorry for Gavin beyond the fact that he's a person who lost an arm. A person who is now your responsibility."

# game/scripts/c22/c22.rpy:1764
translate english c22s003_AmaCalls_b5ce6cb1:

    # "Entraron en casa de tu familia y os amenazaron. Pusieron en peligro a [nor], [bet] y [mee]."
    "They broke into your family's house and threatened you. They endangered [nor], [bet], and [mee]."

# game/scripts/c22/c22.rpy:1765
translate english c22s003_AmaCalls_478e5cdb:

    # "Ahora conoces su historia a través de las historias de [eva] y [ama]. Notas algo de empatía hacia él creciendo en ti."
    "Now you know his story through [eva] and [ama]'s stories. You notice some empathy for him growing in you."

# game/scripts/c22/c22.rpy:1766
translate english c22s003_AmaCalls_733dfc17:

    # "Pero lo que te está rompiendo el alma es ver a [eva]."
    "But what's breaking your soul is seeing [eva]."

# game/scripts/c22/c22.rpy:1767
translate english c22s003_AmaCalls_485bae61:

    # "Ver cómo juega con Fee mientras las lágrimas están a punto de asomar a sus ojos."
    "Watching her play with Fee as tears are about to well up in her eyes."

# game/scripts/c22/c22.rpy:1768
translate english c22s003_AmaCalls_d38b993d:

    # "Decides levantarte."
    "You decide to get up."

# game/scripts/c22/c22.rpy:1770
translate english c22s003_AmaCalls_355187ae:

    # eva "¿Ya te vas?"
    eva "Are you leaving already?"

# game/scripts/c22/c22.rpy:1771
translate english c22s003_AmaCalls_ed54cc7a:

    # mc "No, no te vas a librar tan rápido de mí."
    mc "No, you're not getting rid of me that fast."

# game/scripts/c22/c22.rpy:1773
translate english c22s003_AmaCalls_cda63e2d:

    # mc "El abrazo que traía estaba a punto de caducar."
    mc "The hug I was bringing was about to expire."

# game/scripts/c22/c22.rpy:1775
translate english c22s003_AmaCalls_c25fedb0:

    # eva "Gracias..."
    eva "Thank you..."

# game/scripts/c22/c22.rpy:1776
translate english c22s003_AmaCalls_4559c981:

    # "Os pasáis un rato abrazados en silencio antes de que [eva] diga algo."
    "You spend a while hugging in silence before [eva] says something."

# game/scripts/c22/c22.rpy:1778
translate english c22s003_AmaCalls_742528ea:

    # eva "No te vas a ir hasta que hable contigo de lo que me pasa, ¿verdad?"
    eva "You're not going to leave until I talk to you about what's wrong with me, are you?"

# game/scripts/c22/c22.rpy:1779
translate english c22s003_AmaCalls_bfbddfc6:

    # mc "Yo solo estoy disfrutando del abrazo. Si quieres hablar de ello, habla. Si no quieres, podemos seguir en silencio."
    mc "I'm just enjoying the hug. If you want to talk about it, go ahead. If you don't want to, we can continue in silence."

# game/scripts/c22/c22.rpy:1780
translate english c22s003_AmaCalls_f60662ab:

    # mc "No me voy a ir a ninguna parte. Ni ahora ni nunca."
    mc "I'm not going anywhere. Not now, not ever."

# game/scripts/c22/c22.rpy:1782
translate english c22s003_AmaCalls_bb5ca692:

    # eva "Es que no lo vas a entender..."
    eva "You're not going to understand..."

# game/scripts/c22/c22.rpy:1783
translate english c22s003_AmaCalls_3eeb4099:

    # mc "Dame una oportunidad. No soy tan tonto como parezco."
    mc "Give me a chance. I'm not as dumb as I look."

# game/scripts/c22/c22.rpy:1784
translate english c22s003_AmaCalls_c9516075:

    # mc "Al menos a veces..."
    mc "At least sometimes..."

# game/scripts/c22/c22.rpy:1786
translate english c22s003_AmaCalls_641085b4:

    # eva "*Risa triste* Sólo a veces..."
    eva "*Sad laughter* Only sometimes..."

# game/scripts/c22/c22.rpy:1787
translate english c22s003_AmaCalls_e634a4df:

    # mc "Bueno, alguna que otra vez. Ahora he sido tan listo como para conseguir entrar en tu fortaleza. *Risa*"
    mc "Well, once in a while. Now I've been smart enough to get into your fortress. *Laugh*"

# game/scripts/c22/c22.rpy:1789
translate english c22s003_AmaCalls_c73f839f:

    # eva "En más de un sentido..."
    eva "In more than one way..."

# game/scripts/c22/c22.rpy:1790
translate english c22s003_AmaCalls_628758e0:

    # eva "No sé qué tienes, pero haces que la gente se sienta cómoda hablando."
    eva "I don't know what it is about you, but you make people feel comfortable talking."

# game/scripts/c22/c22.rpy:1791
translate english c22s003_AmaCalls_92a69b0a:

    # mc "Será mi don de gentes. A veces puedo ser encantador."
    mc "It must be my people skills. I can be charming at times."

# game/scripts/c22/c22.rpy:1793
translate english c22s003_AmaCalls_e112eb74:

    # eva "Gavin ha perdido el brazo, aunque supongo que [ama] ya te lo ha contado."
    eva "Gavin has lost his arm, although I guess [ama] has already told you about it."

# game/scripts/c22/c22.rpy:1794
translate english c22s003_AmaCalls_36f66786:

    # mc "Sí, me lo ha contado."
    mc "Yes, she told me."

# game/scripts/c22/c22.rpy:1796
translate english c22s003_AmaCalls_d5ee0b2a:

    # eva "Si hubiera apuntado un par de centímetros a la derecha no hubiera pasado."
    eva "If I had aimed a couple of centimeters to the right it wouldn't have happened."

# game/scripts/c22/c22.rpy:1797
translate english c22s003_AmaCalls_e4a5b722:

    # mc "Y si no hubieras disparado, te hubiera disparado él."
    mc "And if you hadn't shot, he would have shot at you."

# game/scripts/c22/c22.rpy:1799
translate english c22s003_AmaCalls_c4752d40:

    # eva "Gavin tenía la puntería de un stormtrooper. Nunca conseguí que mejorara."
    eva "Gavin had the shooting skills of a stormtrooper. I never got him to improve."

# game/scripts/c22/c22.rpy:1800
translate english c22s003_AmaCalls_a438d52d:

    # eva "Sin embargo, era bueno en el cuerpo a cuerpo."
    eva "However, he was good in close quarters."

# game/scripts/c22/c22.rpy:1801
translate english c22s003_AmaCalls_1ac56caf:

    # mc "¿Lo conocías mucho? Me refiero aparte del entrenamiento."
    mc "Did you know him well? I mean aside from training."

# game/scripts/c22/c22.rpy:1803
translate english c22s003_AmaCalls_a99858d6:

    # eva "Imagínate convivir con 500 personas las 24 horas del día durante 19 años. Cuando no estábamos en misiones, claro."
    eva "Imagine living with 500 people 24 hours a day for 19 years. When we weren't on missions, of course."

# game/scripts/c22/c22.rpy:1804
translate english c22s003_AmaCalls_1f00698f:

    # eva "Doce o trece años en el caso de los G. Sí, nos conocíamos. No, no éramos amigos, pero nos llevábamos bien."
    eva "Twelve or thirteen years in the case of the G's. Yes, we knew each other. No, we weren't friends, but we got along well."

# game/scripts/c22/c22.rpy:1805
translate english c22s003_AmaCalls_ccb3b460:

    # mc "Entiendo..."
    mc "I understand..."

# game/scripts/c22/c22.rpy:1807
translate english c22s003_AmaCalls_1aa524a0:

    # eva "No, [mc]. No lo puedes entender. Tenía mis órdenes y las cumplí. Y alguien salió herido en el proceso. Irreversiblemente."
    eva "No, [mc]. You can't understand. I had my orders, and I carried them out. And someone got hurt in the process. Irreversibly."

# game/scripts/c22/c22.rpy:1808
translate english c22s003_AmaCalls_ebbc4e6f:

    # eva "Pero conocía a ese alguien."
    eva "But, this time. I knew that someone."

# game/scripts/c22/c22.rpy:1809
translate english c22s003_AmaCalls_f3bec387:

    # eva "He matado a gente, [mc]. Soy una puta asesina. Pero nunca había hecho daño a alguien a quien conociera."
    eva "I killed people, [mc]. I'm a fucking assassin. But I never hurt anyone I knew before."

# game/scripts/c22/c22.rpy:1810
translate english c22s003_AmaCalls_c8af1e5d:

    # eva "O a alguien que no se lo mereciera."
    eva "Or someone who didn't deserve it."

# game/scripts/c22/c22.rpy:1811
translate english c22s003_AmaCalls_775b3eb4:

    # mc "¿Nunca?"
    mc "Never?"

# game/scripts/c22/c22.rpy:1813
translate english c22s003_AmaCalls_41fe9448:

    # eva "No así, al menos."
    eva "Not like that, at least."

# game/scripts/c22/c22.rpy:1814
translate english c22s003_AmaCalls_bff6921b:

    # eva "Tu primer domingo aquí, evité que otro serie G os matara, en el bosque."
    eva "Your first Sunday here, I stopped another G-series from killing you, in the woods."

# game/scripts/c22/c22.rpy:1815
translate english c22s003_AmaCalls_316ec7e7:

    # mc "¿Cuando estaba con [eil]?"
    mc "When I was with [eil]?"

# game/scripts/c22/c22.rpy:1817
translate english c22s003_AmaCalls_490e543a:

    # eva "No, mientras vosotros comíais en casa. En el bosque estábamos él y yo. Él tenía un rifle de francotirador."
    eva "No, while you were having lunch at home. He and I were in the woods, he had a sniper rifle."

# game/scripts/c22/c22.rpy:1818
translate english c22s003_AmaCalls_9c3c9f68:

    # eva "Sólo necesité un disparo de advertencia para que Gustav bajara el arma y pudiera apresarlo y traerlo a la base."
    eva "It only took one warning shot for Gustav to put the gun down and I was able to apprehend him and bring him back to the base."

# game/scripts/c22/c22.rpy:1819
translate english c22s003_AmaCalls_1cd0c3fa:

    # eva "Aparte de un ataque de nervios, no recibió más daños."
    eva "Other than a nervous breakdown, he received no further damage."

# game/scripts/c22/c22.rpy:1820
translate english c22s003_AmaCalls_a1555d01:

    # mc "No sé cómo darte las gracias por eso..."
    mc "I don't know how to thank you for that..."

# game/scripts/c22/c22.rpy:1822
translate english c22s003_AmaCalls_6e623447:

    # eva "No hace falta que me las des. Eran mis órdenes. No lo hacía por ti, ni por la familia."
    eva "You don't have to thank me for that. They were my orders. I wasn't doing it for you or the family."

# game/scripts/c22/c22.rpy:1823
translate english c22s003_AmaCalls_ef009b77:

    # eva "No erais nuestra familia aún. Ni siquiera lo erais el día del secuestro."
    eva "You weren't our family yet. You weren't even on the day of the kidnapping."

# game/scripts/c22/c22.rpy:1824
translate english c22s003_AmaCalls_9d40879e:

    # mc "Lo sé..."
    mc "I know..."

# game/scripts/c22/c22.rpy:1826
translate english c22s003_AmaCalls_44489a93:

    # eva "Nunca he estado en las circunstancias en las que estuvieron Beatrice, Claire, o Diana."
    eva "I have never been in the circumstances that Beatrice, Claire, or Diana were in."

# game/scripts/c22/c22.rpy:1827
translate english c22s003_AmaCalls_3cda6ecc:

    # eva "Nunca tuve que luchar por mi vida contra nuestra gente."
    eva "I never needed to fight for my life against our people."

# game/scripts/c22/c22.rpy:1828
translate english c22s003_AmaCalls_c8563811:

    # eva "Y la primera vez que lo hago, alguien sale herido."
    eva "And the first time I do it, someone gets hurt."

# game/scripts/c22/c22.rpy:1829
translate english c22s003_AmaCalls_93eff6a9:

    # mc "Ellos querían hacernos daño, [eva]."
    mc "They wanted to hurt us, [eva]."

# game/scripts/c22/c22.rpy:1831
translate english c22s003_AmaCalls_1aa74c76:

    # eva "Lo sé. Y Eric nos hubiese matado si hubiera tenido la oportunidad, como hicieron con mis hermanas."
    eva "I know, and Eric would have killed us if he'd had the chance, like they did with my sisters."

# game/scripts/c22/c22.rpy:1832
translate english c22s003_AmaCalls_b625d932:

    # eva "Pero Gavin no. Gavin estaba ahí cumpliendo órdenes. Igual que yo. Y no se merecía acabar así..."
    eva "But not Gavin. Gavin was there following orders. So was I. And he didn't deserve to end up like that..."

# game/scripts/c22/c22.rpy:1833
translate english c22s003_AmaCalls_61e87c1d:

    # mc "No quiero sonar insensible, pero prefiero que sea él quien haya acabado así en vez de ser tú."
    mc "I don't want to sound coldhearted, but I'd rather it was him who ended up like this than you."

# game/scripts/c22/c22.rpy:1835
translate english c22s003_AmaCalls_7b8f7b14:

    # eva "Gracias. Yo... Gracias..."
    eva "Thank you. I... Thank you..."

# game/scripts/c22/c22.rpy:1837
translate english c22s003_AmaCalls_26d2f151:

    # eva "No te puedes imaginar lo complicado que es todo en mi cabeza."
    eva "You can't imagine how complicated everything is in my head."

# game/scripts/c22/c22.rpy:1838
translate english c22s003_AmaCalls_9468925e:

    # eva "He herido a una persona a la que aprecio por salvar a una familia a la que quiero."
    eva "I hurt a person I appreciate to save a family I love."

# game/scripts/c22/c22.rpy:1839
translate english c22s003_AmaCalls_6a058b62:

    # eva "No sé qué le voy a decir la próxima vez que le vea..."
    eva "I don't know what I'm going to say to him the next time I see him..."

# game/scripts/c22/c22.rpy:1840
translate english c22s003_AmaCalls_e2c467b9:

    # mc "Los dos cumplíais órdenes, y tú estabas en el bando ganador."
    mc "You were both following orders, and you were on the winning side."

# game/scripts/c22/c22.rpy:1841
translate english c22s003_AmaCalls_b201a47a:

    # mc "Tú hiciste que ese bando ganara."
    mc "You put us on the winning side."

# game/scripts/c22/c22.rpy:1843
translate english c22s003_AmaCalls_7f51842a:

    # eva "Pero no se tenía que haber llegado a esto. Ha muerto gente en esta guerra clon. Mis hermanas."
    eva "But it shouldn't have come to this. People have died in this Clone War. My sisters."

# game/scripts/c22/c22.rpy:1844
translate english c22s003_AmaCalls_5ef9f1ea:

    # eva "Gavin ha perdido el brazo..."
    eva "Gavin lost his arm..."

# game/scripts/c22/c22.rpy:1845
translate english c22s003_AmaCalls_865d5e8f:

    # mc "Y Eric los dientes..."
    mc "And Eric his teeth..."

# game/scripts/c22/c22.rpy:1847
translate english c22s003_AmaCalls_50c59d76:

    # eva "Eric es quien menos me importa. Los E tenían una vena cruel."
    eva "Eric is the one I couldn't care less about. The E's had a cruel streak."

# game/scripts/c22/c22.rpy:1848
translate english c22s003_AmaCalls_73caf2a5:

    # mc "¿Clonamos dientes en NTR? *Risa*"
    mc "Do we clone teeth at NTR? *Laugh*"

# game/scripts/c22/c22.rpy:1850
translate english c22s003_AmaCalls_edbc953c:

    # eva "*Risa triste* No, y tampoco brazos."
    eva "*Sad laughter* No, and no arms either."

# game/scripts/c22/c22.rpy:1851
translate english c22s003_AmaCalls_f8af6c01:

    # eva "¿Qué va a hacer ahora?"
    eva "What is he going to do now?"

# game/scripts/c22/c22.rpy:1852
translate english c22s003_AmaCalls_0dae425a:

    # mc "Supongo que le podemos buscar un puesto donde siga siendo útil con un solo brazo y donde se sienta a gusto."
    mc "I guess we can find him a position where he can still be useful with one arm and where he feels comfortable."

# game/scripts/c22/c22.rpy:1853
translate english c22s003_AmaCalls_283db93c:

    # mc "Ahora soy su jefe y una de las cosas que debe hacer un jefe es conseguir sacar el mejor partido de sus empleados."
    mc "I'm his boss now, and one of the things a boss has to do is to get the best out of his employees."

# game/scripts/c22/c22.rpy:1855
translate english c22s003_AmaCalls_19b090fc:

    # eva "No sé qué podría hacer con un solo brazo, la verdad..."
    eva "I don't know what he could do with only one arm, to tell you the truth..."

# game/scripts/c22/c22.rpy:1856
translate english c22s003_AmaCalls_f1281ea7:

    # eva "No sé qué podría hacer yo si sólo tuviera un brazo."
    eva "I don't know what I could do if I only had one arm."

# game/scripts/c22/c22.rpy:1857
translate english c22s003_AmaCalls_4f0f86a0:

    # mc "Seguramente patearías culos con un solo brazo, pero ¿sabes una cosa?"
    mc "You'd probably kick ass with one arm, but you know what?"

# game/scripts/c22/c22.rpy:1876
translate english c22s004_EveRoute_2be0c5eb:

    # eva "¿Qué? ¿Pareja? ¿Como si fuera tu novia?"
    eva "What? Partner? As in girlfriend?"

# game/scripts/c22/c22.rpy:1877
translate english c22s004_EveRoute_0d9c3d27:

    # mcp "(¡Por Dios! ¡Cómo odio esa palabra!)"
    mcp "(For God's sake! How I hate that word!)"

# game/scripts/c22/c22.rpy:1878
translate english c22s004_EveRoute_61ca86f1:

    # mc "Sí, he dicho pareja. Como si fueras novia. ¿Demasiados disparos están afectando a tu audición?"
    mc "Yes, I said partner. Like as in girlfriend. Too much gunfire is affecting your hearing?"

# game/scripts/c22/c22.rpy:1880
translate english c22s004_EveRoute_8e994c1b:

    # "[eva] salta como impulsada por un muelle."
    "[eva] jumps as if impelled by a spring."

# game/scripts/c22/c22.rpy:1881
translate english c22s004_EveRoute_351f6459:

    # eva "¿Me estás tomando el pelo?"
    eva "Are you pulling my leg?"

# game/scripts/c22/c22.rpy:1882
translate english c22s004_EveRoute_fca52711:

    # mc "No."
    mc "No."

# game/scripts/c22/c22.rpy:1884
translate english c22s004_EveRoute_b4a622fd:

    # eva "¿Lo estás haciendo porque te doy pena?"
    eva "Are you doing it because you feel pity for me?"

# game/scripts/c22/c22.rpy:1885
translate english c22s004_EveRoute_fca52711_1:

    # mc "No."
    mc "No."

# game/scripts/c22/c22.rpy:1887
translate english c22s004_EveRoute_226cf3ff:

    # eva "¿Entonces por qué? ¿Por qué ahora?"
    eva "Then why? Why now?"

# game/scripts/c22/c22.rpy:1888
translate english c22s004_EveRoute_00da5eaf:

    # mc "Porque me gustas desde que te conocí... más o menos."
    mc "Because I have liked you ever since I first met you... sort of."

# game/scripts/c22/c22.rpy:1889
translate english c22s004_EveRoute_83dd1981:

    # mc "Y porque ahora [ama] y tú habéis arreglado vuestras diferencias."
    mc "And because now [ama] and you have settled your differences."

# game/scripts/c22/c22.rpy:1890
translate english c22s004_EveRoute_01dfadaf:

    # mc "¿No puedes aceptar una buena noticia cuando la escuchas? O lo que para ti es una buena noticia..."
    mc "Can't you accept good news when you hear it? Or what is good news to you?"

# game/scripts/c22/c22.rpy:1892
translate english c22s004_EveRoute_125ce26d:

    # eva "¿Y [ama]?"
    eva "And [ama]?"

# game/scripts/c22/c22.rpy:1893
translate english c22s004_EveRoute_e8df90f5:

    # mc "[ama] no tiene nada que ver con lo que hagamos tú y yo."
    mc "[ama] has nothing to do with what you and I do."

# game/scripts/c22/c22.rpy:1894
translate english c22s004_EveRoute_3b2521e3:

    # eva "¿Crees que se va a enfadar porque me hayas elegido a mí antes que a ella? También vas a querer salir con ella, ¿verdad?"
    eva " Do you think she's going to be mad because you chose me ahead of her? You want to date her too, don't you?"

# game/scripts/c22/c22.rpy:1895
translate english c22s004_EveRoute_f150a240:

    # mcp "(No le ha dicho lo que pasó ayer en el café.)"
    mcp "(She didn't tell her what happened yesterday at the cafe.)"

# game/scripts/c22/c22.rpy:1896
translate english c22s004_EveRoute_2833b24b:

    # mc "No, no creo que se enfade."
    mc "No, I don't think she'll be upset."

# game/scripts/c22/c22.rpy:1897
translate english c22s004_EveRoute_00c1bef0:

    # mc "Y no te tienes que preocupar por si salgo con ella o no. No sois un pack indivisible como los yogures."
    mc "And you don't have to worry about whether I will date her or not. You're not an indivisible pack like a pack of socks."

# game/scripts/c22/c22.rpy:1899
translate english c22s004_EveRoute_c7fac3f2:

    # eva "Pero..."
    eva "But..."

# game/scripts/c22/c22.rpy:1900
translate english c22s004_EveRoute_215caa51:

    # mc "Yo esperaba un beso en vez de un interrogatorio."
    mc "I was expecting a kiss instead of an interrogation."

# game/scripts/c22/c22.rpy:1902
translate english c22s004_EveRoute_cafec592:

    # "La asesina pelirroja se lanza hacia ti, tumbándote en el arcón, y empieza a recorrer tus labios con ansia."
    "The red-haired assassin lunges toward you, laying you down on the ark, and begins to lustfully trace your lips."

# game/scripts/c22/c22.rpy:1903
translate english c22s004_EveRoute_161d4452:

    # "Y mucha más torpeza de la que hubieras esperado."
    "Lustfully and a lot more clumsily than you would ever expected."

# game/scripts/c22/c22.rpy:1905
translate english c22s004_EveRoute_34f26697:

    # eva "¿Contento?"
    eva "Happy?"

# game/scripts/c22/c22.rpy:1906
translate english c22s004_EveRoute_a0adf509:

    # mc "Sí. ¿Y tú?"
    mc "Yes. And you?"

# game/scripts/c22/c22.rpy:1908
translate english c22s004_EveRoute_6fff242d:

    # eva "Ermmm... Sí..."
    eva "Ermmm... Yes..."

# game/scripts/c22/c22.rpy:1909
translate english c22s004_EveRoute_00731f2d:

    # mc "No creo que estés muy convencida."
    mc "I don't think you're quite convinced."

# game/scripts/c22/c22.rpy:1911
translate english c22s004_EveRoute_6b8aa6b2:

    # eva "Me siento rara... hace unos minutos tenía ganas de llorar."
    eva "I feel weird... a few minutes ago I felt like crying."

# game/scripts/c22/c22.rpy:1912
translate english c22s004_EveRoute_37b4782c:

    # eva "Ahora tengo ganas de reír. Y de llorar a la vez..."
    eva "Now I feel like laughing. And crying at the same time..."

# game/scripts/c22/c22.rpy:1913
translate english c22s004_EveRoute_39b5f54e:

    # mc "Supongo que estás en medio de una montaña rusa emocional."
    mc "I guess you're in the middle of an emotional rollercoaster."

# game/scripts/c22/c22.rpy:1915
translate english c22s004_EveRoute_a9be9b21:

    # eva "Supongo... No sé cómo actuar ahora..."
    eva "I guess... I don't know how to proceed now..."

# game/scripts/c22/c22.rpy:1916
translate english c22s004_EveRoute_155a73b6:

    # mc "¿Qué tal un largo abrazo? No hace falta que digas nada si no quieres."
    mc "How about a long hug? No need to say anything if you don't want to."

# game/scripts/c22/c22.rpy:1918
translate english c22s004_EveRoute_59a046a5:

    # eva "Creo que me puedo conformar con eso."
    eva "I think I can settle for that."

# game/scripts/c22/c22.rpy:1919
translate english c22s004_EveRoute_45a53858:

    # mc "*Risa* No sé si sentirme como que mis abrazos son un premio menor."
    mc "*Laugh* I don't know if feeling like my hugs are a lesser prize."

# game/scripts/c22/c22.rpy:1921
translate english c22s004_EveRoute_f3211d1f:

    # eva "No te rías de mí. Lo que sí sé es que quiero tener una cita contigo."
    eva "Don't laugh at me. What I do know is that I want to go on a date with you."

# game/scripts/c22/c22.rpy:1922
translate english c22s004_EveRoute_e2f99f94:

    # mc "¿Quieres que busque un sitio bonito?"
    mc "Do you want me to find a nice place?"

# game/scripts/c22/c22.rpy:1924
translate english c22s004_EveRoute_c7e6be72:

    # eva "No. Quiero planear la cita yo."
    eva "No. I want to plan the date myself."

# game/scripts/c22/c22.rpy:1925
translate english c22s004_EveRoute_f84ba5ae:

    # eva "Estoy segura de que has tenido mil citas y no quiero que sea como ninguna que hayas tenido con anterioridad."
    eva "I'm sure you've been on a thousand dates, and I don't want it to be like any you've been on before."

# game/scripts/c22/c22.rpy:1926
translate english c22s004_EveRoute_2d00f394:

    # mc "Me parece bien. Sorpréndeme."
    mc "Sounds good to me. Surprise me."

# game/scripts/c22/c22.rpy:1928
translate english c22s004_EveRoute_7894efb0:

    # eva "¡Mierda!"
    eva "Shit!"

# game/scripts/c22/c22.rpy:1929
translate english c22s004_EveRoute_788fe75f:

    # mc "¿Qué pasa, cielo?"
    mc "What's wrong, honey?"

# game/scripts/c22/c22.rpy:1931
translate english c22s004_EveRoute_0c0618a7:

    # eva "Se lo tengo que contar a [ama]. Ahora."
    eva "I have to tell [ama]. Now."

# game/scripts/c22/c22.rpy:1932
translate english c22s004_EveRoute_3ed89801:

    # eva "Levántate. Vamos a decírselo. No quiero que piense que se lo estamos ocultando."
    eva "Get up. Let's go tell her. I don't want her to think we're hiding it from her."

# game/scripts/c22/c22.rpy:1933
translate english c22s004_EveRoute_48688e12:

    # mc "*Risa* Lo de estar quieta disfrutando del abrazo no se te da muy bien. Vamos."
    mc "*Laugh* Being still enjoying cuddling doesn't suit you very well. Come on, let's go."

# game/scripts/c22/c22.rpy:1935
translate english c22s004_EveRoute_f9704243:

    # eva "[ama], tenemos algo que decirte."
    eva "[ama], we have something to tell you."

# game/scripts/c22/c22.rpy:1937
translate english c22s004_EveRoute_6cdbd57d:

    # ama "¿Te encuentras mejor?"
    ama "Are you feeling better?"

# game/scripts/c22/c22.rpy:1939
translate english c22s004_EveRoute_db54e694:

    # eva "Mas o menos. Todavía me siento mal por Gavin..."
    eva "Sort of. I still feel bad for Gavin..."

# game/scripts/c22/c22.rpy:1940
translate english c22s004_EveRoute_b33399f4:

    # eva "Pero... queríamos decirte que..."
    eva "But... we wanted to tell you that..."

# game/scripts/c22/c22.rpy:1942
translate english c22s004_EveRoute_ac83c3e7:

    # eva "Ayúdame, [mc]..."
    eva "Help me, [mc]..."

# game/scripts/c22/c22.rpy:1943
translate english c22s004_EveRoute_fd12ea1d:

    # mc "Nope. Esto es algo que tienes que hacer tú."
    mc "Nope. This is something you have to do yourself."

# game/scripts/c22/c22.rpy:1945
translate english c22s004_EveRoute_a40c1f78:

    # eva "*Grrr* ¡Capullo!"
    eva "*Grrr* Asshole!"

# game/scripts/c22/c22.rpy:1946
translate english c22s004_EveRoute_eef46fb8:

    # eva "¡Vale!"
    eva "OK!"

# game/scripts/c22/c22.rpy:1948
translate english c22s004_EveRoute_98f390cb:

    # eva "¡[mc] y yo estamos saliendo juntos! Aunque no sé por qué salgo con capullos."
    eva "[mc] and I are dating! I don't know why I date assholes, though."

# game/scripts/c22/c22.rpy:1949
translate english c22s004_EveRoute_c1284afa:

    # eva "¡Vamos a tener una cita!"
    eva "We're going on a date!"

# game/scripts/c22/c22.rpy:1951
translate english c22s004_EveRoute_9e8efeb1:

    # eva "Y nos hemos besado..."
    eva "And we kissed..."

# game/scripts/c22/c22.rpy:1953
translate english c22s004_EveRoute_bb654dc4:

    # ama "¡Eso es fantástico, [eva]!"
    ama "That's great, [eva]!"

# game/scripts/c22/c22.rpy:1955
translate english c22s004_EveRoute_90b2909c:

    # ama "Felicidades, [mc]. No podrías salir con nadie mejor."
    ama "Congratulations, [mc]. You couldn't date anyone better."

# game/scripts/c22/c22.rpy:1957
translate english c22s004_EveRoute_f104a946:

    # eva "Ahora solo falta que se decida contigo."
    eva "Now all that's left is for him to make up his mind about you."

# game/scripts/c22/c22.rpy:1959
translate english c22s004_EveRoute_9d066684:

    # eva "Obviamente, me ha elegido a mi primero, pero me gustaría que también tú pudieras salir con él."
    eva "Obviously, he chose me first, but I wish you could also date him."

# game/scripts/c22/c22.rpy:1961
translate english c22s004_EveRoute_8f8d9b64:

    # mcp "(No sé a qué juega, pero será mejor seguirle el juego. *Risa mental*)"
    mcp "(I don't know what she's playing at, but I'd better play along *Mental laughter*)."

# game/scripts/c22/c22.rpy:1963
translate english c22s004_EveRoute_8ee39ad0:

    # ama "Aunque si [mc] quiere salir conmigo, sabe lo que yo pienso y lo puede decir {b}ahora mismo{/b}."
    ama "Although if [mc] wants to date me, he knows what I think and he can say it {b}right now{/b}."

# game/scripts/c22/c22.rpy:1964
translate english c22s004_EveRoute_aa92414a:

    # mc "Me encantaría. Estar con las dos sería maravilloso."
    mc "I would love to. And to be with both of you would be wonderful."

# game/scripts/c22/c22.rpy:1966
translate english c22s004_EveRoute_cb287e39:

    # eva "¡Felicidades, [ama]!"
    eva "Congratulations, [ama]!"

# game/scripts/c22/c22.rpy:1967
translate english c22s004_EveRoute_22901ee7:

    # eva "¡Nuestro primer novio oficial y lo compartimos!"
    eva "Our first official boyfriend and we're sharing him!"

# game/scripts/c22/c22.rpy:1968
translate english c22s004_EveRoute_7d0ef333:

    # mc "¿Qué es eso del primer novio oficial?"
    mc "What's that about the first official boyfriend?"

# game/scripts/c22/c22.rpy:1970
translate english c22s004_EveRoute_7af743dd:

    # eva "En una misión en Budapest tuvimos que fingir que salíamos con dos operativos de la serie F."
    eva "We had to pretend we were dating two F-series operatives on a mission in Budapest."

# game/scripts/c22/c22.rpy:1971
translate english c22s004_EveRoute_6cd56b27:

    # ama "Ellos se hacían pasar por gemelos ricos y nosotras por sus novias."
    ama "They pretended to be rich twins, and we pretended to be their girlfriends."

# game/scripts/c22/c22.rpy:1973
translate english c22s004_EveRoute_b68d22d1:

    # eva "¡Pero nunca pasó nada entre nosotros!"
    eva "But nothing ever happened between us!"

# game/scripts/c22/c22.rpy:1974
translate english c22s004_EveRoute_aa885f6b:

    # ama "Más allá de algún beso fingido."
    ama "Beyond some feigned kiss."

# game/scripts/c22/c22.rpy:1976
translate english c22s004_EveRoute_4edb2e23:

    # eva "¡Oops! ¡Te he abrazado y no te he dejado besar a tu novio!"
    eva "Oops! I hugged you and didn't let you kiss your boyfriend!"

# game/scripts/c22/c22.rpy:1977
translate english c22s004_EveRoute_f1d23f62:

    # mcp "(Cada vez odio más la palabra. Pero en esto es como una niña, y necesita poner etiquetas.)"
    mcp "(I hate the word more and more. But, in this, she's like a child and she needs to put labels on it.)"

# game/scripts/c22/c22.rpy:1979
translate english c22s004_EveRoute_648e3dbd:

    # ama "¿Puedo?"
    ama "May I?"

# game/scripts/c22/c22.rpy:1980
translate english c22s004_EveRoute_15025985:

    # eva "¡Di que sí!"
    eva "Say yes!"

# game/scripts/c22/c22.rpy:1981
translate english c22s004_EveRoute_a3a04cea:

    # ama "*Susurrando* Me da un poco de vergüenza delante de [eva]."
    ama "*Whispering* I'm a little embarrassed to do it in front of [eva]."

# game/scripts/c22/c22.rpy:1982
translate english c22s004_EveRoute_6e49d741:

    # mc "Sólo hay una forma de superar la vergüenza, preciosa."
    mc "There's only one way to overcome embarrassment, gorgeous."

# game/scripts/c22/c22.rpy:1984
translate english c22s004_EveRoute_069ebbec:

    # "Sin dejarle responder, tu boca se acerca a la suya y le das un tierno beso."
    "Without letting her answer, your mouth moves to hers and you give her a tender kiss."

# game/scripts/c22/c22.rpy:1985
translate english c22s004_EveRoute_63fd7115:

    # "Ella responde de forma mucho menos apasionada que el día anterior en el café."
    "She responds much less passionately than she did the day before at the cafe."

# game/scripts/c22/c22.rpy:1986
translate english c22s004_EveRoute_bede44a2:

    # "La vergüenza es una barrera que le cuesta superar."
    "Embarrassment is a barrier that she struggles to overcome."

# game/scripts/c22/c22.rpy:1988
translate english c22s004_EveRoute_57cd6c62:

    # mc "¿Bien?"
    mc "Good?"

# game/scripts/c22/c22.rpy:1989
translate english c22s004_EveRoute_350a7b0e:

    # ama "Bien."
    ama "Good."

# game/scripts/c22/c22.rpy:1991
translate english c22s004_EveRoute_cdfd0960:

    # eva "¿Bien? ¡Ha sido precioso!"
    eva "Good? It's been beautiful!"

# game/scripts/c22/c22.rpy:2024
translate english c22s004_EveRoute_2a8de6b7:

