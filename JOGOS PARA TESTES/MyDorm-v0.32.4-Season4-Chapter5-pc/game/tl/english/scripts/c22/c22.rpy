translate english c22s004_ScaUnPatch_8c7306ee:

    # dap "¿Alguien pone en duda que [nor] sea mi madre?"
    dap "Does anyone doubt that [nor] is my mother?"

# game/scripts/c22/c22.rpy:2821
translate english c22s004_ScaUnPatch_c425aa82:

    # todas "No."
    todas "No."

# game/scripts/c22/c22.rpy:2823
translate english c22s004_ScaUnPatch_4e4e916b:

    # mee "Yo lo hice durante años. Ya no."
    mee "I did it for years. Not anymore."

# game/scripts/c22/c22.rpy:2825
translate english c22s004_ScaUnPatch_17168897:

    # dap "Bien, Abuela. ¿O debería decir \"Sra. Que Se Hace Pasar Por Mi Abuela\"?"
    dap "Okay, Grandma. Or should I say \"Lady Impersonating My Grandmother\"?"

# game/scripts/c22/c22.rpy:2827
translate english c22s004_ScaUnPatch_a698cdd3:

    # mee "*Risa* Ni se te ocurra. Soy tu abuela te guste o no."
    mee "*Laugh* Don't even think about it. I'm your grandmother whether you like it or not."

# game/scripts/c22/c22.rpy:2828
translate english c22s004_ScaUnPatch_4a7779fa:

    # mee "Y, si quieren, también puedo serlo para cualquier chica que necesite una abuela."
    mee "And, if they want, I can also be a grandma for any girl who needs a grandmother."

# game/scripts/c22/c22.rpy:2829
translate english c22s004_ScaUnPatch_c8ee8ea5:

    # mee "No hago galletas, por cierto."
    mee "I don't bake cookies, by the way."

# game/scripts/c22/c22.rpy:2830
translate english c22s004_ScaUnPatch_b3b94564:

    # todas "*Risa*"
    todas "*Laugh*"

# game/scripts/c22/c22.rpy:2832
translate english c22s004_ScaUnPatch_550ac64e:

    # dap "¿Puedo continuar? Gracias."
    dap "May I continue? Thank you."

# game/scripts/c22/c22.rpy:2833
translate english c22s004_ScaUnPatch_ff63ea89:

    # dap "A lo que me refiero es a que esta familia es rara. Se ha creado a través de mentiras, secretos, y clonaciones."
    dap "What I mean is that this family is weird. It has been created through lies, secrets, and cloning."

# game/scripts/c22/c22.rpy:2834
translate english c22s004_ScaUnPatch_797171cd:

    # dap "¿Pero alguien duda de que sea una familia?"
    dap "But does anyone doubt that it is a family?"

# game/scripts/c22/c22.rpy:2835
translate english c22s004_ScaUnPatch_c425aa82_1:

    # todas "No."
    todas "No."

# game/scripts/c22/c22.rpy:2837
translate english c22s004_ScaUnPatch_90cb866e:

    # deb "Es una familia increíble, [dap]. Los lazos de sangre importan menos que la voluntad de ser una familia."
    deb "It's an amazing family, [dap]. Blood ties matter less than the willingness to be a family."

# game/scripts/c22/c22.rpy:2838
translate english c22s004_ScaUnPatch_1f3ae072:

    # lis "Si leyera esto en un libro, no me lo creería. Vivirlo es totalmente diferente."
    lis "If I read this in a book, I wouldn't believe it. Living it is totally different."

# game/scripts/c22/c22.rpy:2840
translate english c22s004_ScaUnPatch_fb14b4c6:

    # dap "Eso es exactamente lo que quiero decir."
    dap "That's exactly what I mean."

# game/scripts/c22/c22.rpy:2841
translate english c22s004_ScaUnPatch_4901efbe:

    # dap "Me da lo mismo lo que piense la gente de fuera de la familia."
    dap "I don't care what people outside the family think."

# game/scripts/c22/c22.rpy:2842
translate english c22s004_ScaUnPatch_b487daa7:

    # dap "Me da lo mismo lo que digan las leyes."
    dap "I don't care what the laws say."

# game/scripts/c22/c22.rpy:2844
translate english c22s004_ScaUnPatch_49550204:

    # dap "Si [nor] es mi madre porque elegimos que lo sea..."
    dap "If [nor] is my mother because we chose for her to be..."

# game/scripts/c22/c22.rpy:2845
translate english c22s004_ScaUnPatch_d8503a7a:

    # dap "Si [mee] es mi abuela porque así lo hemos decidido..."
    dap "If [mee] is my grandmother because that's what we decided..."

# game/scripts/c22/c22.rpy:2846
translate english c22s004_ScaUnPatch_35ae7fab:

    # mc "Y porque si no, seguramente sí que nos haría esas galletas y nos obligaría a comerlas como tortura."
    mc "And because if not, surely she would indeed bake us those cookies and force us to eat them as torture."

# game/scripts/c22/c22.rpy:2847
translate english c22s004_ScaUnPatch_b3b94564_1:

    # todas "*Risa*"
    todas "*Laugh*"

# game/scripts/c22/c22.rpy:2849
translate english c22s004_ScaUnPatch_8364dc4d:

    # dap "Bueno, pues una vez establecida la premisa..."
    dap "Well, once the premise has been established..."

# game/scripts/c22/c22.rpy:2850
translate english c22s004_ScaUnPatch_6998dd2e:

    # dap "He decidido que [sca] es mi hermana."
    dap "I decided that [sca] is my sister."

# game/scripts/c22/c22.rpy:2852
translate english c22s004_ScaUnPatch_9d49d5cf:

    # dap "Joder, me ha quedado totalmente anticlimático con tantas interrupciones."
    dap "Fuck, it looked totally anticlimactic to me with so many interruptions."

# game/scripts/c22/c22.rpy:2854
translate english c22s004_ScaUnPatch_7dbc2656:

    # mee "¡Ese lenguaje, señorita! Como tu abuela no te dejo usarlo."
    mee "That language, young lady! Like your grandmother I won't let you use it."

# game/scripts/c22/c22.rpy:2855
translate english c22s004_ScaUnPatch_b3b94564_2:

    # todas "*Risa*"
    todas "*Laugh*"

# game/scripts/c22/c22.rpy:2856
translate english c22s004_ScaUnPatch_f994bd47:

    # mee "Y a ti tampoco, [sca], antes de que preguntes. Quiero que mis nietas hablen como señoritas bien educadas."
    mee "And neither to you, [sca], before you ask. I want my granddaughters to talk like well-mannered ladies."

# game/scripts/c22/c22.rpy:2858
translate english c22s004_ScaUnPatch_4ebbfbb7:

    # sca "..."
    sca "..."

# game/scripts/c22/c22.rpy:2860
translate english c22s004_ScaUnPatch_490df30a:

    # sca "Gracias, [dap.nick]..."
    sca "Thanks, [dap.nick]..."

# game/scripts/c22/c22.rpy:2861
translate english c22s004_ScaUnPatch_1504d153:

    # dap "Es lo menos que podía hacer. Sabes que te considero mi hermana. Ahora lo saben todos."
    dap "It's the least I could do. You know I consider you my sister. Everyone knows now."

# game/scripts/c22/c22.rpy:2863
translate english c22s004_ScaUnPatch_61677265:

    # eri "[dap], ¿puedes dejar de monopolizar a mi hermana? Yo también quiero abrazarla."
    eri "[dap], can you stop monopolizing my sister? I want to hug her too."

# game/scripts/c22/c22.rpy:2865
translate english c22s004_ScaUnPatch_b4b3c095:

    # sca "Me vais a hacer llorar..."
    sca "You're going to make me cry..."

# game/scripts/c22/c22.rpy:2866
translate english c22s004_ScaUnPatch_d31d2ea0:

    # eri "Yo llevaría un rato llorando. Ya sabes que soy muy llorona, y lo que ha dicho [dap] es muy bonito."
    eri "I would have been crying for a while. You know I'm such a crier, and what [dap] said is so beautiful."

# game/scripts/c22/c22.rpy:2868
translate english c22s004_ScaUnPatch_b851f5fa:

    # "El resto os vais turnando para abrazar a [sca]. Todas dicen algo que la hace sentir querida."
    "The rest of you take turns hugging [sca]. You all say something that makes her feel loved."

# game/scripts/c22/c22.rpy:2870
translate english c22s004_ScaUnPatch_923f197c:

    # "[sca] ha pasado de tener una madre de mierda a tener dos madres y dos abuelas maravillosas. Y un montón de hermanas."
    "[sca] has gone from having one crappy mother to having two wonderful mothers and two grandmothers. And a bunch of sisters."

# game/scripts/c22/c22.rpy:2873
translate english c22s004_hugs_d8a24664:

    # "La escena te recuerda mucho a la fiesta de la piscina, cuando [mee] contó su secreto sobre el cáncer."
    "The scene reminds you a lot of the pool party, when [mee] told her secret about cancer."

# game/scripts/c22/c22.rpy:2874
translate english c22s004_hugs_5dc73603:

    # "No podrías estar más orgulloso de tu familia."
    "You couldn't be more proud of your family."

# game/scripts/c22/c22.rpy:2878
translate english c22s004_BetCallsBishop_bea50ff2:

    # bet "Lo que pasa en esta familia es increíble."
    bet "What's happening in this family is unbelievable."

# game/scripts/c22/c22.rpy:2879
translate english c22s004_BetCallsBishop_9ef0ffa9:

    # mc "Pero es para sentirse orgulloso de formar parte de ella."
    mc "But it makes me feel proud to be part of it."

# game/scripts/c22/c22.rpy:2880
translate english c22s004_BetCallsBishop_2e68811e:

    # mc "El día menos pensado, pasará un perro callejero por delante de casa y le diremos \"Tú también eres de la familia\"."
    mc "The day you least expect it, a stray dog will walk in front of the house and we'll say, \" You are also a member of this family\"."

# game/scripts/c22/c22.rpy:2881
translate english c22s004_BetCallsBishop_c0d47adb:

    # mc "Y que conste que no estoy comparando a [sca] con un perro callejero. Se merece formar parte de esta familia."
    mc "And for the record, I'm not comparing [sca] to a stray dog. She deserves to be part of this family."

# game/scripts/c22/c22.rpy:2884
translate english c22s004_BetCallsBishop_dea11c03:

    # bet "Claro que sí. Es tu hermana. Y aunque no lo fuera, esa chica es adorable y necesita una familia que la quiera."
    bet "Of course she does. She's your sister. And even if she wasn't, that girl is adorable and needs a family that loves her."

# game/scripts/c22/c22.rpy:2885
translate english c22s004_BetCallsBishop_13dcbbbf:

    # mc "Sí, es sorprendente lo adorable que es con la mierda de padres que tiene."
    mc "Yeah, it's amazing how adorable she is with the shitty parents she has."

# game/scripts/c22/c22.rpy:2887
translate english c22s004_BetCallsBishop_32aaa9c5:

    # bet "Claro que sí. Es una chica adorable y necesita una familia que la quiera."
    bet "Of course she does. She's a lovely girl and needs a family that loves her."

# game/scripts/c22/c22.rpy:2888
translate english c22s004_BetCallsBishop_65e9f4b0:

    # mc "Sí, es sorprendente lo adorable que es con la madre que tiene."
    mc "Yes, it's surprising how adorable she is with the crappy mother she has."

# game/scripts/c22/c22.rpy:2890
translate english c22s004_BetCallsBishop_b53ef1e8:

    # bet "Quería hablar contigo de una cosa..."
    bet "I wanted to talk to you about something..."

# game/scripts/c22/c22.rpy:2891
translate english c22s004_BetCallsBishop_7ff9267a:

    # mc "Dime. ¿Tiene algo que ver con lo que ha pasado antes?"
    mc "Yes? Does it have anything to do with what happened earlier?"

# game/scripts/c22/c22.rpy:2893
translate english c22s004_BetCallsBishop_6c7ed6f0:

    # bet "No. No quiero hablar de eso."
    bet "No. I don't want to talk about that."

# game/scripts/c22/c22.rpy:2894
translate english c22s004_BetCallsBishop_8e7ec810:

    # mc "Quitarse los secretos de encima es liberador, [bet]. Y hablar las cosas también."
    mc "Getting secrets off your chest is liberating, [bet]. And talking things out, too."

# game/scripts/c22/c22.rpy:2896
translate english c22s004_BetCallsBishop_9f6bdc68:

    # bet "Es posible, pero hoy no es el día."
    bet "It's possible, but today is not the day."

# game/scripts/c22/c22.rpy:2897
translate english c22s004_BetCallsBishop_f7a2d776:

    # mc "Como quieras. ¿De qué querías hablar?"
    mc "As you wish. What did you want to talk about?"

# game/scripts/c22/c22.rpy:2899
translate english c22s004_BetCallsBishop_425ea172:

    # bet "Me han llamado de Monterey después de comer. Tengo una cita con el secretario del obispo el jueves por la tarde."
    bet "I got a call from Monterey after lunch. I have an appointment with the bishop's secretary on Thursday afternoon."

# game/scripts/c22/c22.rpy:2900
translate english c22s004_BetCallsBishop_ffceb4d2:

    # bet "¿Crees que me podrías llevar? Si no puedes, puedo ir en autobús."
    bet "Do you think you could give me a ride? If you can't, I can go by bus."

# game/scripts/c22/c22.rpy:2901
translate english c22s004_BetCallsBishop_5692500e:

    # mc "Ningún problema. Voy a intentar mover el alquiler del coche de [emm] para el jueves, y así matamos dos pájaros de un tiro."
    mc "No problem. I'll try to move [emm]'s car rental to Thursday, and we'll kill two birds with one stone."

# game/scripts/c22/c22.rpy:2903
translate english c22s004_BetCallsBishop_b1e9ff19:

    # bet "Gracias, [mc]. Voy a ir a mi habitación, dime algo si no puedes mover lo de [emm], para sacar los billetes de autobús."
    bet "Thank you, [mc]. I'm going to go to my room, tell me if you can't move [emm]'s thing, so I can buy the bus tickets."

# game/scripts/c22/c22.rpy:2904
translate english c22s004_BetCallsBishop_0716effd:

    # mc "No me he explicado bien. Te voy a llevar el jueves sea como sea, aunque tenga que volver el día siguiente con [emm]."
    mc "I didn't make myself clear. I'm going to drive you on Thursday no matter what, even if I have to come back the next day with [emm]."

# game/scripts/c22/c22.rpy:2905
translate english c22s004_BetCallsBishop_6435ce3f:

    # mc "No hemos tenido la oportunidad de pasar mucho tiempo juntos, y me parece un buen plan. No voy a dejar que hagas esto sola."
    mc "We haven't had a chance to spend much time together, and it sounds like a good plan to me. I'm not going to let you do this alone."

# game/scripts/c22/c22.rpy:2907
translate english c22s004_BetCallsBishop_c959b3f2:

    # bet "¡Oh! ¡Gracias!"
    bet "Oh! Thank you!"

# game/scripts/c22/c22.rpy:2908
translate english c22s004_BetCallsBishop_6147dd59:

    # mc "Y cuando quieras hablar de lo que ha pasado antes en el baño, avísame."
    mc "And when you want to talk about what happened earlier in the bathroom, let me know."

# game/scripts/c22/c22.rpy:2910
translate english c22s004_BetCallsBishop_55d2a73c:

    # bet "Lo haré. Hasta luego."
    bet "I will. See you later."

# game/scripts/c22/c22.rpy:2911
translate english c22s004_BetCallsBishop_457d2405:

    # mc "Hasta luego, Tía [bet]."
    mc "See you later, Aunt [bet]."

# game/scripts/c22/c22.rpy:2916
translate english c22s004_MarChat_990cce59:

    # mom "[dap] es increíble. La que ha montado para dar la noticia..."
    mom "[dap] is incredible. What she's done to break the news..."

# game/scripts/c22/c22.rpy:2917
translate english c22s004_MarChat_db580cbd:

    # mc "No creo que fuera una noticia que se tuviera que dar por el grupo de WhatsUp."
    mc "I didn't think it was news that should be broken by the WhatsUp group."

# game/scripts/c22/c22.rpy:2918
translate english c22s004_MarChat_900bf22f:

    # mc "Y necesitaba que tú colaboraras."
    mc "And she needed you to collaborate."

# game/scripts/c22/c22.rpy:2919
translate english c22s004_MarChat_e383d544:

    # mc "Siento que hayas tenido que dar tu parte de la noticia así."
    mc "I'm sorry you had to deliver your part of the news like that."

# game/scripts/c22/c22.rpy:2921
translate english c22s004_MarChat_b0144f15:

    # mom "No te preocupes. He estado pensando en los dos posibles escenarios después de la conversación de esta mañana."
    mom "Don't worry. I'd been thinking about the two possible scenarios after this morning's talk."

# game/scripts/c22/c22.rpy:2922
translate english c22s004_MarChat_0efd60d4:

    # mom "Si no lo hubiéramos hablado, seguramente me hubiera molestado enterarme de que soy una cornuda delante de todo el mundo."
    mom "If we hadn't talked about it, I probably would have been upset to find out that your father cheated on me in front of everyone."

# game/scripts/c22/c22.rpy:2923
translate english c22s004_MarChat_d2cee307:

    # mc "Pasó hace 19 años..."
    mc "It happened 19 years ago..."

# game/scripts/c22/c22.rpy:2925
translate english c22s004_MarChat_ae18a250:

    # mom "Da lo mismo cuando pasara, [mc]."
    mom "It doesn't matter when it happened, [mc]."

# game/scripts/c22/c22.rpy:2926
translate english c22s004_MarChat_263d60c3:

    # mom "Y realmente, me da lo mismo que pasara. Cada vez que pienso en tu padre, no puedo sentir nada que no sea enfado, pero cada vez menos."
    mom "And really, I don't care what happened. Every time I think about your dad, I can't feel anything but anger, but less every day."

# game/scripts/c22/c22.rpy:2927
translate english c22s004_MarChat_56378a29:

    # mc "Está fuera de nuestras vidas, no creo que volvamos a verlo nunca."
    mc "He's out of our lives. I don't think we'll ever see him again."

# game/scripts/c22/c22.rpy:2929
translate english c22s004_MarChat_7f4e4829:

    # mom "Eso me da lo mismo también. No quiero verlo, pero no me derrumbaría si lo hiciera."
    mom "I don't care about that, either. I don't want to see him, but I wouldn't break down if I did."

# game/scripts/c22/c22.rpy:2930
translate english c22s004_MarChat_6597b47f:

    # mom "Además, nos ha dejado tres bonitos regalos aquí."
    mom "Besides, he left us three nice gifts here."

# game/scripts/c22/c22.rpy:2931
translate english c22s004_MarChat_ea5cf2fb:

    # mc "¿Tres? [emm], [sca], y... ¿la camioneta?"
    mc "Three? [emm], [sca], and... the pickup truck?"

# game/scripts/c22/c22.rpy:2933
translate english c22s004_MarChat_841f1ff9:

    # mom "[emm], [sca], y tú, idiota. *Risa*"
    mom "[emm], [sca], and you, idiot. *Laugh*"

# game/scripts/c22/c22.rpy:2934
translate english c22s004_MarChat_dcfd69e5:

    # mc "*Risa* Al decir \"nos ha dejado\" creía que era a ti y a mí, con lo que no me incluía yo."
    mc "*Laugh* When you said \"he left us\" I thought it was to you and me, so that didn't include me."

# game/scripts/c22/c22.rpy:2935
translate english c22s004_MarChat_29d1e3db:

    # mc "Estoy un poco denso hoy."
    mc "I'm a bit dense today."

# game/scripts/c22/c22.rpy:2937
translate english c22s004_MarChat_e0cab045:

    # mom "*Risa* ¿Sólo hoy?"
    mom "*Laugh* Only today?"

# game/scripts/c22/c22.rpy:2938
translate english c22s004_MarChat_46ee4d98:

    # mom "Si no te importa, voy a volver con [sca] antes de que la abrumen demasiado."
    mom "If you don't mind, I'm going to go back to [sca] before she gets too overwhelmed."

# game/scripts/c22/c22.rpy:2940
translate english c22s004_MarChat_cad6be42:

    # mom "[dap] es increíble. Ha montado todo esto para que [sca] no se sienta mal por cómo ha salido la prueba de ADN."
    mom "[dap] is unbelievable. She set this whole thing up so [sca] wouldn't feel bad about how the DNA test came out."

# game/scripts/c22/c22.rpy:2941
translate english c22s004_MarChat_9e3bffda:

    # mc "[sca] se ha decepcionado un poco cuando ha salido negativa. Creo que [dap.nick] lo ha hecho muy bien."
    mc "[sca] was a little disappointed when it came out negative. I think [dap.nick] performed the stunt very well."

# game/scripts/c22/c22.rpy:2943
translate english c22s004_MarChat_11e3ba30:

    # mom "Y nos hemos ahorrado las explicaciones incómodas si la prueba de ADN hubiera salido diferente."
    mom "And we have been spared from having to give the awkward explanations we would need to give if the DNA test had come out differently."

# game/scripts/c22/c22.rpy:2944
translate english c22s004_MarChat_6ed2c569:

    # mc "Sí, y nos toca seguir buscando a su padre y a mi medio-hermana."
    mc "Yes, and it's up to us to keep looking for her father and my half-sister."

# game/scripts/c22/c22.rpy:2946
translate english c22s004_MarChat_ed7f87ed:

    # mom "Esa es la parte más complicada. ¿Tenéis algún hilo del que tirar?"
    mom "That's the trickiest part. Do you have any threads to pull on?"

# game/scripts/c22/c22.rpy:2947
translate english c22s004_MarChat_89e8ea70:

    # mc "No. Los únicos que saben algo, Papá y la madre biológica de [sca] no van a decir nada."
    mc "No. The only people who know anything, Dad and [sca]'s bio mother aren't going to say anything."

# game/scripts/c22/c22.rpy:2949
translate english c22s004_MarChat_01013c14:

    # mom "Con tu padre no se me ocurre ninguna idea, pero creo que con la madre de [sca] podría pensar en algo."
    mom "I can't think of anything about your father, but I think I can pull something with [sca]'s mother."

# game/scripts/c22/c22.rpy:2950
translate english c22s004_MarChat_98586b3e:

    # mom "¿Todavía quedan clones en Newport?"
    mom "Are there still clones left in Newport?"

# game/scripts/c22/c22.rpy:2951
translate english c22s004_MarChat_f8ef9400:

    # mc "Creo que no, pero no tengo ni idea..."
    mc "I don't think so, but I have no idea..."

# game/scripts/c22/c22.rpy:2953
translate english c22s004_MarChat_46ee4d98_1:

    # mom "Si no te importa, voy a volver con [sca] antes de que la abrumen demasiado."
    mom "If you don't mind, I'm going to go back to [sca] before she gets too overwhelmed."

# game/scripts/c22/c22.rpy:2954
translate english c22s004_MarChat_65eba579:

    # mom "Después hablaré con [ama] y [eva]."
    mom "After that, I will speak to [ama] and [eva]."

# game/scripts/c22/c22.rpy:2955
translate english c22s004_MarChat_5d587e42:

    # mc "¿No me lo vas a contar?"
    mc "Aren't you going to tell me?"

# game/scripts/c22/c22.rpy:2957
translate english c22s004_MarChat_cd0cf803:

    # mom "De momento no. Tengo que acabar de pensar en algunas cosas. Cuando lo tenga todo ligado, os lo cuento."
    mom "Not at the moment. I need to finish thinking about some things. When I have it all tied together, I'll tell you about it."

# game/scripts/c22/c22.rpy:2958
translate english c22s004_MarChat_5d75b6da:

    # mc "Ningún problema. Estaré en mi habitación. Tengo algunas cosas que hacer."
    mc "No problem. I'll be in my room. I have some things to do."

