translate english c28s004_ScaGetsJob_076e168c:

    # mc "Creo que me estoy volviendo demasiado previsible. *Risa*"
    mc "I think I'm becoming too predictable. *Laugh*"

# game/scripts/c28/c28.rpy:1865
translate english c28s004_ScaGetsJob_76d00537:

    # dap "¿Con un dónut? Es un poco cutre, ¿no?"
    dap "With a doughnut? That's a bit lame, isn't it?"

# game/scripts/c28/c28.rpy:1867
translate english c28s004_ScaGetsJob_8e18d505:

    # sca "No le hagas caso. Yo creo que es super dulce."
    sca "Don't listen to her, I think it's super sweet."

# game/scripts/c28/c28.rpy:1868
translate english c28s004_ScaGetsJob_8227305e:

    # sca "¡Felicidades! Supongo que ha dicho que sí, viendo su reacción con el dónut."
    sca "Congratulations! I guess she said yes, judging by her reaction to the doughnut."

# game/scripts/c28/c28.rpy:1869
translate english c28s004_ScaGetsJob_1eaf07be:

    # mc "Sí, ha dicho que sí."
    mc "Yes, she said yes."

# game/scripts/c28/c28.rpy:1871
translate english c28s004_ScaGetsJob_4fc35d44:

    # dap "*Risa* Yo creía que Tía [mar] era la lista de la familia."
    dap "*Laugh* I thought Aunt [mar] was the smart one in the family."

# game/scripts/c28/c28.rpy:1873
translate english c28s004_ScaGetsJob_bc779088:

    # mc "*Risa* Supongo que eso quiere decir que no quieres que te lo pida a ti cuando tenga la ocasión."
    mc "*Laugh* I guess that means you don't want me to propose to you when I get the chance."

# game/scripts/c28/c28.rpy:1875
translate english c28s004_ScaGetsJob_215596e5:

    # dap "*Risa* Si soy la única a la que no se lo pides, tu personaje de DnD tendrá una vida muuuuy corta."
    dap "*Laugh* If I'm the only one you don't ask, your DnD character will have a very short life."

# game/scripts/c28/c28.rpy:1876
translate english c28s004_ScaGetsJob_6b29ff29:

    # dap "Ya sabes... un rayo que cae en tu saco de dormir, una caída que acaba con tu propia daga en tu garganta... Esas cosas que pasan cuando no le pides matrimonio al DM..."
    dap "You know... a lightning bolt striking your sleeping bag, a fall that ends with your own dagger in your throat... Those things that happen when you don't propose to the DM..."

# game/scripts/c28/c28.rpy:1878
translate english c28s004_ScaGetsJob_0c9c70d0:

    # mc "*Risa* Precisamente porque es la lista de la familia es por lo que ha aceptado."
    mc "*Laugh* It is precisely because she is the smartest in the family that she accepted."

# game/scripts/c28/c28.rpy:1879
translate english c28s004_ScaGetsJob_8b79702b:

    # dap "Felicidades a los dos."
    dap "Congratulations to both of you."

