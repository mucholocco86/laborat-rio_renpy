translate english c28s004_ScaGetsJob_3b916da8:

    # mc "¿Qué pasa?"
    mc "What's going on?"

# game/scripts/c28/c28.rpy:1890
translate english c28s004_ScaGetsJob_cc10cf6f:

    # todas "Nada, nada. No te preocupes."
    todas "Nothing, nothing. Don't worry."

