# game/scripts/c21/c21.rpy:1398
translate english c21s002_AaronCall_e11ef6ad:

    # aar "No quisieron decirme a qué se referían. ¿Le han puesto un mote a alguna de tus chicas?"
    aar "They didn't want to tell me what they meant. Have they given one of your girls a nickname?"

# game/scripts/c21/c21.rpy:1399
translate english c21s002_AaronCall_87f7cf83:

