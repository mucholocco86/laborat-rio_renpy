translate english c21s002_AaronCall_0cf727f2:

    # aar "Por todo el mundo... te refieres a ti, a [mar] y a [nor], ¿verdad?"
    aar "When you say everyone... you mean you, [mar] and [nor], don't you?"

# game/scripts/c21/c21.rpy:1405
translate english c21s002_AaronCall_62e249b3:

