translate english c21s002_PoliceStation_253a0e78:

    # oma "No quiero su dinero, pero quiero otras cosas de usted. Va a empezar por..."
    oma "Oh! I don't want your money, but I want other things from you. You're going to start with..."

# game/scripts/c21/c21.rpy:1209
translate english c21s002_BettyMassageAndDrivingLicense_7228b7b0:

    # "Mientras tanto, en tu habitación..."
    "Meanwhile, in your room..."

# game/scripts/c21/c21.rpy:1212
translate english c21s002_BettyMassageAndDrivingLicense_dd0461ef:

    # "*Knock-Knock*"
    "*Knock-Knock*"

# game/scripts/c21/c21.rpy:1213
translate english c21s002_BettyMassageAndDrivingLicense_a56b75d9:

    # bet "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    bet "*Through the door* It's me. May I come in?"

# game/scripts/c21/c21.rpy:1214
translate english c21s002_BettyMassageAndDrivingLicense_f9c18ad4:

    # mc "Un momento, Tía [bet]."
    mc "Just a moment, Aunt [bet]."

# game/scripts/c21/c21.rpy:1216
translate english c21s002_BettyMassageAndDrivingLicense_cf8cd174:

    # dap "*Susurrando* ¡Nos hemos quedado dormidas!"
    dap "*Whispering* We've overslept!"

# game/scripts/c21/c21.rpy:1218
translate english c21s002_BettyMassageAndDrivingLicense_3fc27f7b:

    # eri "*Susurrando* Danos un momento para vestirnos."
    eri "*Whispering* Give us a moment to get dressed."

# game/scripts/c21/c21.rpy:1220
translate english c21s002_BettyMassageAndDrivingLicense_8208b241:

    # emm "Pasa, Tía [bet]."
    emm "Come in, Aunt [bet]."

# game/scripts/c21/c21.rpy:1221
translate english c21s002_BettyMassageAndDrivingLicense_586a8abe:

    # emm "*Susurrando* ¿Creéis que aunque nos vistamos no va a saber lo que ha pasado?"
    emm "*Whispering* Do you think that, even if we get dressed, she won't know what happened?"

# game/scripts/c21/c21.rpy:1223
translate english c21s002_BettyMassageAndDrivingLicense_2f8f0326:

    # bet "*Suspiro de sorpresa* ¡Oh!"
    bet "*Sigh of surprise* Oh!"

# game/scripts/c21/c21.rpy:1224
translate english c21s002_BettyMassageAndDrivingLicense_a089bd75:

    # mc "Buenos días, Tía [bet]. ¿Te puedo... te podemos ayudar en algo?"
    mc "Good morning, Aunt [bet]. Can I... can we help you with anything?"

# game/scripts/c21/c21.rpy:1226
translate english c21s002_BettyMassageAndDrivingLicense_34482b3e:

    # bet "No... venía por lo del carnet de conducir, pero si estás... estáis ocupados... ya volveré más tarde."
    bet "No... I came for the driver's license issue, but if you're... you're busy... I'll come back later."

# game/scripts/c21/c21.rpy:1228
translate english c21s002_BettyMassageAndDrivingLicense_57c35b93:

    # eri "No te preocupes, Tía [bet]. Nosotras ya nos íbamos."
    eri "Don't worry, Aunt [bet]. We were just leaving."

# game/scripts/c21/c21.rpy:1229
translate english c21s002_BettyMassageAndDrivingLicense_54c2425e:

    # mcp "(No se atreve a mirarla directamente. Pese a lo que ha dicho [emm] se tienen que sentir un poco avergonzadas.)"
    mcp "(She doesn't dare look directly at her. Despite what [emm] said, they must feel a little embarrassed.)"

# game/scripts/c21/c21.rpy:1230
translate english c21s002_BettyMassageAndDrivingLicense_8c898c2f:

    # mc "Siéntate un momento, Tía [bet]."
    mc "Sit down for a moment, Aunt [bet]."

# game/scripts/c21/c21.rpy:1232
translate english c21s002_BettyMassageAndDrivingLicense_21057d78:

    # dap "Sí, quiero darme una ducha..."
    dap "Yes, I want to take a shower..."

# game/scripts/c21/c21.rpy:1234
translate english c21s002_BettyMassageAndDrivingLicense_9f93c98b:

    # emm "*Risa* ¿Quieres quitarte todo el sudor de anoche?"
    emm "*Laugh* Do you want to wash off all the sweat from last night?"

# game/scripts/c21/c21.rpy:1236
translate english c21s002_BettyMassageAndDrivingLicense_088efb80:

    # eri "Ya os dejamos solos, Tía [bet]."
    eri "We'll leave you alone now, Aunt [bet]."

# game/scripts/c21/c21.rpy:1237
translate english c21s002_BettyMassageAndDrivingLicense_f83f9f91:

    # dap "Si puedes... no se lo cuentes a nadie."
    dap "If you can... don't tell anyone, please."

# game/scripts/c21/c21.rpy:1238
translate english c21s002_BettyMassageAndDrivingLicense_9d188053:

    # mc "¿Vamos a volver a los secretos después de lo de ayer?"
    mc "Are we going back to having secrets after yesterday?"

# game/scripts/c21/c21.rpy:1239
translate english c21s002_BettyMassageAndDrivingLicense_af6c42bd:

    # emm "Por lo que a mí respecta, se lo puedes contar a quien quieras. Estoy orgullosa de que mi novio haya podido complacer a tres mujeres a la vez."
    emm "As far as I'm concerned, you can tell anyone you want. I'm proud that my boyfriend was able to please three women at once."

# game/scripts/c21/c21.rpy:1241
translate english c21s002_BettyMassageAndDrivingLicense_c409a293:

    # emm "No sabes lo que te pierdes siendo monja. *Risa*"
    emm "You don't know what you're missing by being a nun. *Laugh*"

# game/scripts/c21/c21.rpy:1243
translate english c21s002_BettyMassageAndDrivingLicense_6ae4d506:

    # bet "No era lo que esperaba encontrarme... Pero no os preocupéis. No es algo que salga en una conversación normal."
    bet "This is not what I was expecting to find... But don't worry. It's not something that comes up in normal conversation."

# game/scripts/c21/c21.rpy:1245
translate english c21s002_BettyMassageAndDrivingLicense_5c9f488e:

    # "Las chicas abandonan la habitación. Ninguna de ellas te da un beso de buenos días."
    "The girls leave the room. None of them kiss you good morning."

# game/scripts/c21/c21.rpy:1246
translate english c21s002_BettyMassageAndDrivingLicense_9be5cfb5:

    # bet "¿Te va bien que miremos lo del carnet de conducir ahora?"
    bet "Is it okay with you if we look at the driver's license thing now?"

# game/scripts/c21/c21.rpy:1247
translate english c21s002_BettyMassageAndDrivingLicense_5066a30e:

    # mcp "(Es mejor que nos pongamos a hacer lo que ha venido a hacer antes de que quiera meter la nariz en lo que acaba de ver.)"
    mcp "(We'd better get on with what she came here to do before she wants to stick her nose into what she just saw.)"

# game/scripts/c21/c21.rpy:1250
translate english c21s002_BettyMassageAndDrivingLicense_dd0461ef_1:

    # "*Knock-Knock*"
    "*Knock-Knock*"

# game/scripts/c21/c21.rpy:1251
translate english c21s002_BettyMassageAndDrivingLicense_a56b75d9_1:

    # bet "*A través de la puerta* Soy yo. ¿Puedo pasar?"
    bet "*Through the door* It's me. May I come in?"

# game/scripts/c21/c21.rpy:1252
translate english c21s002_BettyMassageAndDrivingLicense_6b5f1a00:

    # mc "Pasa, Tía [bet]."
    mc "Come in, Aunt [bet]."

# game/scripts/c21/c21.rpy:1254
translate english c21s002_BettyMassageAndDrivingLicense_e24dad1b:

    # bet "Venía a ver si te iba bien que mirásemos lo del carnet de conducir."
    bet "I came to see if it was okay if we looked into the driver's license issue."

# game/scripts/c21/c21.rpy:1255
translate english c21s002_BettyMassageAndDrivingLicense_b39b71f0:

    # mc "Siéntate, voy a coger el portátil."
    mc "Sit down, I'm going to get the laptop."

# game/scripts/c21/c21.rpy:1256
translate english c21s002_BettyMassageAndDrivingLicense_ba0312a1:

    # bet "Aunque supongo que no has desayunado aún."
    bet "Although I guess you haven't had breakfast yet."

# game/scripts/c21/c21.rpy:1257
translate english c21s002_BettyMassageAndDrivingLicense_cc4bdecf:

    # mc "No hay ningún problema, hacemos esto y después voy a desayunar. No tengo demasiada hambre, y eso teniendo en cuenta que ayer no cené."
    mc "No problem, I'll have breakfast when we finish with this. I'm not too hungry, even if I didn't have dinner yesterday."

# game/scripts/c21/c21.rpy:1259
translate english c21s002_BettyMassageAndDrivingLicense_10fae0aa:

    # bet "¿Te vas a poner algo de ropa?"
    bet "Are you going to put some clothes on?"

# game/scripts/c21/c21.rpy:1260
translate english c21s002_BettyMassageAndDrivingLicense_fce2d567:

    # mc "No sabía que te molestara, después de lo de aquel día."
    mc "I didn't know it bothered you, after what happened a few days ago."

# game/scripts/c21/c21.rpy:1262
translate english c21s002_BettyMassageAndDrivingLicense_cfbf5915:

    # bet "Aquel día no tenías media erección matutina. Es un poco... desconcertante."
    bet "You didn't have a morning woody that day. It's a little... baffling."

# game/scripts/c21/c21.rpy:1263
translate english c21s002_BettyMassageAndDrivingLicense_7b5c86ed:

    # mc "Espérame un momento mientras me pongo unos shorts o algo."
    mc "Wait for a minute while I put on some shorts or something."

# game/scripts/c21/c21.rpy:1265
translate english c21s002_BettyMassageAndDrivingLicense_41d397cb:

    # "Unos minutos después..."
    "Some minutes later..."

# game/scripts/c21/c21.rpy:1266
translate english c21s002_BettyMassageAndDrivingLicense_fe659aee:

    # mc "Pues ya hemos acabado. En una semana deberíamos ir a San Luis para recoger tu nuevo carnet."
    mc "Well, we're done. In a week we should be going to San Luis to pick up your new license."

# game/scripts/c21/c21.rpy:1267
translate english c21s002_BettyMassageAndDrivingLicense_a905b39e:

    # bet "Muchas gracias, [mc]. No hubiera sabido hacerlo si no me hubieras ayudado. No lo ponen fácil para los viejos."
    bet "Thank you very much, [mc]. I wouldn't have known how to do it if you hadn't helped me. They don't make it easy for old people."

# game/scripts/c21/c21.rpy:1268
translate english c21s002_BettyMassageAndDrivingLicense_6b879e9c:

    # mc "No eres vieja, Tía [bet]. *Risa* Eres vintage."
    mc "You're not old, Aunt [bet]. *Laugh* You're vintage."

# game/scripts/c21/c21.rpy:1270
translate english c21s002_BettyMassageAndDrivingLicense_c45170b9:

    # bet "*Risa* ¡Sí, de la época hippy! Me tenías que haber visto con mi caravana rosa. Seguro que Olivia guarda alguna foto."
    bet "*Laugh* Yeah, from the hippy era! You should have seen me with my pink camper. I'm sure Olivia kept some pictures."

# game/scripts/c21/c21.rpy:1271
translate english c21s002_BettyMassageAndDrivingLicense_91bb1da6:

    # mc "¡Esas fotos quiero verlas! ¿Eran de cuando ibas a la universidad?"
    mc "I want to see those pictures! Were they from when you were in college?"

# game/scripts/c21/c21.rpy:1273
translate english c21s002_BettyMassageAndDrivingLicense_feafc7ae:

    # bet "Sí, en vez de alquilar un piso o dormir en una residencia, compré una caravana destartalada que tenía \"Amor Libre\" pintado en un costado."
    bet "Yes, instead of renting an apartment or sleeping in a dorm, I bought a rickety camper that had Free Love painted on the side."

# game/scripts/c21/c21.rpy:1274
translate english c21s002_BettyMassageAndDrivingLicense_b4aa366f:

    # bet "Eran los 70 y la aparqué fuera del campus. No te puedes llegar a imaginar la de gente que llamaba a la puerta de la caravana. *Risa*"
    bet "It was the 1970s and I parked it outside the campus. You can't even imagine how many people knocked on the camper's door. *Laugh*"

# game/scripts/c21/c21.rpy:1275
translate english c21s002_BettyMassageAndDrivingLicense_660d29c9:

    # mc "La pregunta es si les abrías la puerta. *Risa*"
    mc "The real question is whether you opened the door for them. *Laugh*"

# game/scripts/c21/c21.rpy:1277
translate english c21s002_BettyMassageAndDrivingLicense_2318a23c:

    # bet "La dejé cerrada muchas más veces de las que la abrí. *Risa* Era una chica bastante decente... o bastante tonta."
    bet "I left it closed many more times than I opened it. *Laugh* I was a pretty good girl then... or pretty dumb."

# game/scripts/c21/c21.rpy:1278
translate english c21s002_BettyMassageAndDrivingLicense_335c1cad:

    # mc "*Risa* Hubiera sido irónico que durmieras en una residencia a los 18 y volvieras a hacerlo ahora."
    mc "*Laugh* It would have been ironic if you slept in a dorm at 18 and are back to doing it now."

# game/scripts/c21/c21.rpy:1281
translate english c21s002_BettyMassageAndDrivingLicense_7e909199:

    # bet "Tus bisabuelos estaban preocupados. Hacía poco que habían estrenado una película sobre universitarios que tenían sexo todo el día."
    bet "Your great-grandparents were worried. A movie about college kids having sex all day was released the year before I went to college."

# game/scripts/c21/c21.rpy:1283
translate english c21s002_BettyMassageAndDrivingLicense_57020f66:

    # bet "Mis padres estaban preocupados. Hacía poco que habían estrenado una película sobre universitarios que tenían sexo todo el día."
    bet "My parents were worried. A movie about college kids having sex all day was released the year before I went to college."

# game/scripts/c21/c21.rpy:1284
translate english c21s002_BettyMassageAndDrivingLicense_b99f4d8f:

    # bet "Todo el mundo pensaba que los dormitorios universitarios eran una orgía continua."
    bet "Everyone thought college dorms were one continuous orgy."

# game/scripts/c21/c21.rpy:1285
translate english c21s002_BettyMassageAndDrivingLicense_4a023661:

    # bet "No es que no lo fueran, pero es que la película ni siquiera iba de eso. Nunca me hubieran dado dinero para alojarme en un dormitorio."
    bet "It's not that they weren't, but that's not even what the movie was about. They would never have given me money to stay in a dorm room."

# game/scripts/c21/c21.rpy:1288
translate english c21s002_BettyMassageAndDrivingLicense_9549a3e5:

    # bet "Aunque si vieran este dormitorio deducirían que no se equivocaban demasiado."
    bet "Although if they saw this dorm they would deduce that they weren't too far off."

# game/scripts/c21/c21.rpy:1290
translate english c21s002_BettyMassageAndDrivingLicense_e1a0bc28:

    # bet "Aunque si vieran lo que acabo de ver, deducirían que no se equivocaban demasiado."
    bet "Although if they saw what I just saw a moment ago, they would deduce that they weren't far off."

# game/scripts/c21/c21.rpy:1293
translate english c21s002_BettyMassageAndDrivingLicense_e6e08c3b:

    # bet "No sé qué pensarían si supieran que sus nietas regentan un dormitorio."
    bet "I don't know what they would think if they knew their granddaughters run a dorm."

# game/scripts/c21/c21.rpy:1295
translate english c21s002_BettyMassageAndDrivingLicense_86c5019c:

    # bet "No sé qué pensarían si supieran que su nieta regenta un dormitorio."
    bet "I don't know what they would think if they knew their granddaughter runs a dorm."

# game/scripts/c21/c21.rpy:1296
translate english c21s002_BettyMassageAndDrivingLicense_4f1990ab:

    # mc "Se darían cuenta de que tienen un montón de bisnietas nuevas. *Risa* Estamos creando una familia enorme."
    mc "They would realize they have a bunch of new great-granddaughters. *Laugh* We're creating a huge family."

# game/scripts/c21/c21.rpy:1297
translate english c21s002_BettyMassageAndDrivingLicense_204d9f2c:

    # mc "Pero volviendo a la caravana... ¿Cómo pasaste de una caravana en la que pone Amor Libre a un convento?"
    mc "But back to the camper... How did you go from a camper that says Free Love on it to a convent?"

# game/scripts/c21/c21.rpy:1299
translate english c21s002_BettyMassageAndDrivingLicense_d54bf5e6:

    # bet "Me enamoré de la persona equivocada en mi primer año. Estuve enamorada de él durante años."
    bet "I fell in love with the wrong person my freshman year. I was in love with him for years."

# game/scripts/c21/c21.rpy:1300
translate english c21s002_BettyMassageAndDrivingLicense_be500193:

    # bet "Cuando acabé la carrera, me metí en la iglesia. Acabé la especialización en neurocirugía allí."
    bet "When I finished my degree, I joined the Church. I finished my neurosurgery internship there."

# game/scripts/c21/c21.rpy:1301
translate english c21s002_BettyMassageAndDrivingLicense_a9b27d2b:

    # bet "Como no dejaba de... encontrármelo, era una forma de evitar las tentaciones y repetir errores."
    bet "Since I kept... running into him, it was a way to avoid temptations and repeating mistakes."

# game/scripts/c21/c21.rpy:1302
translate english c21s002_BettyMassageAndDrivingLicense_773a26a1:

    # bet "Tenía algo de vocación, pero seguramente no me hubiera hecho monja si no hubiera sido por él."
    bet "I had something of a vocation, but I certainly wouldn't have become a nun if it hadn't been for him."

# game/scripts/c21/c21.rpy:1303
translate english c21s002_BettyMassageAndDrivingLicense_486fb2f2:

    # mc "¿Te hizo daño?"
    mc "Did he hurt you?"

# game/scripts/c21/c21.rpy:1305
translate english c21s002_BettyMassageAndDrivingLicense_334e2e3c:

    # bet "No, [mc]. El daño me lo hice yo misma. Él siempre se comportó como la mejor persona que había conocido... hasta entonces."
    bet "No, [mc]. I did the hurting myself. He always behaved like the best person I had ever met... until then."

# game/scripts/c21/c21.rpy:1306
translate english c21s002_BettyMassageAndDrivingLicense_59f034e6:

    # bet "Hubo un par de años después de conocerlo que fueron un desastre para mí a nivel personal."
    bet "There were a couple of years after I met him that were a disaster for me on a personal level."

# game/scripts/c21/c21.rpy:1307
translate english c21s002_BettyMassageAndDrivingLicense_4256b42e:

    # bet "Para intentar olvidarlo hice cosas de las que no me siento orgullosa. Y me junté con gente que no me hizo bien."
    bet "To try to forget him, I did things I'm not proud of. And I hung out with people who didn't do me any good."

# game/scripts/c21/c21.rpy:1308
translate english c21s002_BettyMassageAndDrivingLicense_fa725485:

    # mc "¿Lo has vuelto a ver?"
    mc "Have you seen him again?"

# game/scripts/c21/c21.rpy:1310
translate english c21s002_BettyMassageAndDrivingLicense_a35f4a5f:

    # bet "Sí... mmmm... nos seguimos viendo durante bastante tiempo, lo cual lo empeoraba todo."
    bet "Yes... mmmm... we kept seeing each other for quite some time, which made it all the more worse."

# game/scripts/c21/c21.rpy:1311
translate english c21s002_BettyMassageAndDrivingLicense_268d5c70:

    # bet "Acabé la residencia en el otro lado del país, trabajé en Luisiana un tiempo... no quería quedarme en California..."
    bet "I finished my residency on the other side of the country, then worked in Louisiana for a while... I didn't want to stay in California..."

# game/scripts/c21/c21.rpy:1312
translate english c21s002_BettyMassageAndDrivingLicense_d3ee8e00:

    # bet "Decidí pedir el traslado a Ghana cuando salió una plaza en un hospital de misioneros. De ahí a Angola, Sudán, Zaire... hasta acabar en Tanzania."
    bet "I decided to ask for a transfer to Ghana when a position became available in a missionary hospital. From there to Angola, Sudan, Zaire... until I ended up in Tanzania."

# game/scripts/c21/c21.rpy:1313
translate english c21s002_BettyMassageAndDrivingLicense_c8f4743e:

    # mc "Tuvo que ser duro, irte tan lejos de la familia..."
    mc "It must have been hard, being so far away from family..."

# game/scripts/c21/c21.rpy:1315
translate english c21s002_BettyMassageAndDrivingLicense_a3484d42:

    # bet "Al principio sí. Después se convirtió en una vida de aventuras, cambiando de país cada pocos años, conociendo sitios y gente nueva."
    bet "The first months, yes. Then it became a life of adventure, changing countries every few years, going to new places and meeting new people."

# game/scripts/c21/c21.rpy:1316
translate english c21s002_BettyMassageAndDrivingLicense_3d4c2966:

    # bet "No me arrepiento de haberlo hecho. He tenido una vida que mucha gente no puede ni siquiera soñar."
    bet "I don't regret doing it. I've had a life that a lot of people can't even dream of."

# game/scripts/c21/c21.rpy:1317
translate english c21s002_BettyMassageAndDrivingLicense_569e9dd5:

    # mc "Lejos de la familia y renunciando a muchas cosas..."
    mc "Away from family and giving up on many things..."

# game/scripts/c21/c21.rpy:1319
translate english c21s002_BettyMassageAndDrivingLicense_1283acb7:

    # bet "Todos renunciamos a cosas, [mc]. [mar] me dijo que renunciaste a una buena oferta de trabajo para venir aquí."
    bet "We all give up on things, [mc]. [mar] told me you gave up on a good job offer to come here."

# game/scripts/c21/c21.rpy:1321
translate english c21s002_BettyMassageAndDrivingLicense_68bda792:

    # bet "[mar] renunció a su sueño de tener un restaurante propio cuando se casó con tu padre y llegaste tú."
    bet "[mar] gave up on her dream of owning her own restaurant when she married your father, and you came along."

# game/scripts/c21/c21.rpy:1323
translate english c21s002_BettyMassageAndDrivingLicense_5e6090bd:

    # bet "[mar] renunció a su sueño de tener un restaurante propio cuando murió Dominic y se vio sola con [emm]."
    bet "[mar] gave up on her dream of owning her own restaurant when Dominic died, and she found herself alone with [emm]."

# game/scripts/c21/c21.rpy:1325
translate english c21s002_BettyMassageAndDrivingLicense_262b2ea7:

    # bet "¿Te arrepientes de haber vuelto a casa? ¿Crees que [mar] se arrepiente de haber renunciado a su restaurante?"
    bet "Do you regret returning home? Do you think [mar] regrets giving up her restaurant?"

# game/scripts/c21/c21.rpy:1326
translate english c21s002_BettyMassageAndDrivingLicense_217b23fe:

    # mc "No, tienes razón. Renunciamos a cosas pero encontramos otras cosas que se convierten en nuestra vida gracias a ello."
    mc "No, you're right. We give up things, but we find other things that become our life because of it."

# game/scripts/c21/c21.rpy:1328
translate english c21s002_BettyMassageAndDrivingLicense_e4129e9f:

    # bet "Hasta que deciden apartarte..."
    bet "Until they decide to push you aside..."

# game/scripts/c21/c21.rpy:1329
translate english c21s002_BettyMassageAndDrivingLicense_91de43a3:

    # mc "Aún no lo sabes, Tía [bet]. Esperemos a la visita a Monterey."
    mc "You don't know yet, Aunt [bet]. Let's wait for the visit to Monterey."

# game/scripts/c21/c21.rpy:1331
translate english c21s002_BettyMassageAndDrivingLicense_5bb7878d:

    # bet "Ayer estuve pensando sobre eso cuando me fui a la cama... antes de interrumpir vuestra partida."
    bet "I was thinking about it yesterday, when I went to bed... before I interrupted your game."

# game/scripts/c21/c21.rpy:1332
translate english c21s002_BettyMassageAndDrivingLicense_1e2b294d:

    # bet "Ya sabes que en esto soy como [dap]. Me gusta pensar todos los posibles escenarios."
    bet "You know I'm like [dap] when it comes to overthinking. I like to think through all the possible scenarios."

# game/scripts/c21/c21.rpy:1333
translate english c21s002_BettyMassageAndDrivingLicense_2e8699da:

    # mc "No sirve de nada si no sabes qué te van a decir."
    mc "It's of no use if you don't know what they're going to tell you."

# game/scripts/c21/c21.rpy:1335
