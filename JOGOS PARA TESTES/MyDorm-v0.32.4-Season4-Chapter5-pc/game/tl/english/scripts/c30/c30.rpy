translate english c30s006_atHome_f37b7910:

    # mc "No sé a qué te refieres. ¡No he follado desde que volví a Newport!"
    mc "I don't know what you're talking about. I haven't had sex since I got back to Newport!"

# game/scripts/c30/c30.rpy:2435
translate english c30s006_atHome_f37b7910_1:

    # mc "No sé a qué te refieres. ¡No he follado desde que volví a Newport!"
    mc "I don't know what you're talking about. I haven't had sex since I got back to Newport!"

# game/scripts/c30/c30.rpy:2481
translate english c30s006_wedding_05e357e1:

    # jam "¿Crees que te puedes ir a Aruba sin que tu novia quiera hacer algo especial antes de que os vayáis?"
    jam "Do you think you can go to Aruba without your girlfriend wanting to do something special before you two leave?"

# game/scripts/c30/c30.rpy:2486
translate english c30s006_wedding_953f2014:

    # jam "¿Crees que te puedes ir a Aruba sin que tus novias quieran hacer algo especial antes de que os vayáis?"
    jam "Do you think you can leave for Aruba without your girlfriends wanting to do something special before you go?"

# game/scripts/c30/c30.rpy:2488
translate english c30s006_wedding_f652d3f6:

    # jam "¿Crees que te puedes ir a Aruba sin que la novia que dejas aquí quiera hacer algo especial antes de que os vayáis?"
    jam "Do you think you can go to Aruba and leave your girlfriend here without her wanting to do something special before you leave?"

# game/scripts/c30/c30.rpy:2493
translate english c30s006_wedding_f652d3f6_1:

    # jam "¿Crees que te puedes ir a Aruba sin que la novia que dejas aquí quiera hacer algo especial antes de que os vayáis?"
    jam "Do you think you can go to Aruba and leave your girlfriend here without her wanting to do something special before you leave?"

# game/scripts/c30/c30.rpy:2495
translate english c30s006_wedding_fc06d66f:

    # jam "¿Crees que te puedes ir a Aruba sin que las novias que dejas aquí quieran hacer algo especial antes de que te vayas?"
    jam "Do you think you can go to Aruba without the girlfriends you're leaving behind wanting to do something special before you leave?"

# game/scripts/c30/c30.rpy:2497
translate english c30s006_wedding_fc06d66f_1:

    # jam "¿Crees que te puedes ir a Aruba sin que las novias que dejas aquí quieran hacer algo especial antes de que te vayas?"
    jam "Do you think you can go to Aruba without the girlfriends you're leaving behind wanting to do something special before you leave?"
