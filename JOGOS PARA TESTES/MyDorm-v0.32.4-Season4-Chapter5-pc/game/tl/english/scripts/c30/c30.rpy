    mc "*Laugh* We all hate Jamaal."

# game/scripts/c30/c30.rpy:2921
translate english c30s006_sim_9433cf80:

    # "Vuelves a besar a tu esposa esta vez como despedida por un breve tiempo antes de volver con Jamaal."
