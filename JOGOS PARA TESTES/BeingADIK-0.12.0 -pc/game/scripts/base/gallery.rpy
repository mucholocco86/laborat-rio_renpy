screen gall_char_filter():
   modal True
       
   frame:
         xpos 0.36
         ypos 0.00
         xsize 0.15
         vpgrid:
             xsize 200
             cols 1
             for index,i in enumerate(gall_chars_list):
               vbox:
                 textbutton "[i]" action [SetVariable("wt_gall_char",i),Hide("gall_char_filter")] text_size 27

screen scenes:
    tag menu

    add "rewards_new_bg"
    add "spr_crp1"
    add "spr_crp2"
    add "spr_crp3"
    add "spr_crp4"
    add "spr_crp5"
    add "spr_crp6"
    add "rewards_new_fg3"
    imagebutton:
        idle "rew_x_idle"
        hover "rew_x_hover"
        action Return()
        xalign 0.99
        yalign 0.00
    key "mouseup_2" action Return()
    text "Scenes" style "reward_header_style" xalign 0.02 yalign 0.005
    textbutton "Character Filter" action Show("gall_char_filter") xalign 0.45 yalign 0.005 text_size 40
    vpgrid:
        ypos 0.085
        ysize 0.898
        yoffset 2 * persistent.scale_factor
        cols 5
        spacing 10 * persistent.scale_factor
        draggable True
        mousewheel True

        scrollbars "vertical"
        side_xalign 0.5

