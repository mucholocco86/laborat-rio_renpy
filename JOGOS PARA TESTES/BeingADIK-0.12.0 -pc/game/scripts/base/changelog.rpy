screen changelog_screen:
    tag changelog_screen
    modal True
    add "changelog_bg"
    imagebutton at cl_zoom_style:
        xalign 0.756
        yalign 0.08
        idle "dlc_x_idle"
        hover "dlc_x_hover"
        action (Hide("changelog_screen"))

    if steamConfig:
        text "Changelog - {color=ffffff}Steam Version [config.version!t]{/color}" style "cl_header_style" xalign 0.5 yalign 0.1
    elif nonPatreonConfig:
        text "Changelog - {color=ffffff}GOG Version [config.version!t]{/color}" style "cl_header_style" xalign 0.5 yalign 0.1
    else:
        text "Changelog - {color=ffffff}Patreon Version [config.version!t]{/color}" style "cl_header_style" xalign 0.5 yalign 0.1

    vpgrid:
        xfill True
        yfill True
        xalign 0.511
        yalign 0.538
        xsize 0.523
        ysize 0.65
        cols 1
        spacing 10 * persistent.scale_factor
        draggable True
        mousewheel True
        scrollbars "vertical"
        text "[changelog_list]" style "cl_text_style"

style cl_header_style:
    font "fonts/candara.ttf"
    size 40 * persistent.scale_factor
    color "#ffed00"
    outlines [(2, "#000000", 0, 0)]

style cl_text_style:
    font "fonts/candara.ttf"
    size 20 * persistent.scale_factor
    color "#ffffff"
    outlines [(2, "#000000", 0, 0)]
    xalign 0.0
    xfill True
    xminimum 975 * persistent.scale_factor
    yminimum 350 * persistent.scale_factor
    xmaximum 975 * persistent.scale_factor
    ymaximum 350 * persistent.scale_factor

transform cl_zoom_style:
    zoom 0.7

init python:
    def generateChangelog():
        global changelog_list
        global steamConfig
        global nonPatreonConfig
        changelog_list = ""
        if steamConfig:
            changelog_list += "{color=ffed00}-- Changelog v0.12.0 --{/color}\n{color=4dc9ff}Initial Steam release.{/color}"
        elif nonPatreonConfig:
            changelog_list += "{color=ffed00}-- Changelog v0.12.0 --{/color}\n{color=4dc9ff}Initial GOG release.{/color}"
        else:
            changelog_list += "{color=ffed00}-- Changelog v0.12.0 --{/color}\n{color=4dc9ff}Added Episode 12 that includes\n6782 renders\n432 animations\n7 2D-art pieces\n2 2D-art animations\n37 songs\n55 sound effects{/color}\n\n- Fixed an issue with saving at a scene when a Special Render could be picked up.\n\n- Fixed an issue where the Task list would tell you to take care of your fish, even when they had already died.\n\n- Fixed a bug where the burner sound wouldn't stop after turning it off in the Science class mini-game.\n\n- Fixed a bug where scrolling back and forth in Jacob's Art Shop would rollback the scene.\n\n- Fixed a bug that caused the fish game interface to stay on the screen if you opened the phone during it when playing without mini-games.\n\n- There is now a notification when a new image is added to the phone gallery, as long as the phone gallery doesn't already have an exclamation mark.\n- The middle mouse button can now be used to close the Fish tank mini-game.\n- Moved the main menu version label into the Changelog.\n- Added a Quit button to the main menu.\n- Added a Changelog to the main menu.\n- Fixed a potential issue with the order of the girls in the Stats app, depending on when you first opened that tab in Season 3.\n- Fixed an issue with Camila's Episode 9 lewd scene that caused it not to have the light filter effect when replayed from the gallery.\n- Updated Click to continue text to an outlined screen version.\n- Fixed a bug where Nora was added before Nick in the Bios app.\n- Fixed an issue with the English test that caused \"Quit\" to be filled in when starting the test if you chose to quit the test instead of completing it.\n- Fixed a variable being set erroneously when kissing Sally in Episode 11.\n- If you bought an art piece from the 2D art shop in another playthrough, it will display as the item being SOLD in your current playthrough to help avoid confusion.\n- Fixed an issue with the Episode 10 recap.\n- Fixed an issue with the Chat app that would cause a mismatch between who's sending and receiving the text.\n- Fixed an issue with Bella's lewd scene in Episode 9 that would end prematurely if a choice was selected twice.\n- Fixed an issue where studying for Science lab didn't reset the bonus timer.\n- Fixed the scrollbar in the Bios app for profiles with few entries.\n- Fixed an alignment issue with the Beer Pong mini-game chances text.\n- Fixed a bug with the Math class special render.\n- Fixed an image issue during Josy and Maya's lewd scene in Episode 11.\n- Improved the Music bar on the phone's home screen. The Music bar displays the current song as long as the phone is enabled, and you can also add/remove songs to your favorites.\n- Improved the line spacing in the History screen. Entries have less space between them and more lines fit on the screen.\n- Reordered the gallery chronologically for Episode 11.\n- Fixed an issue with John Boy's scene before the first free roam event in Episode 11.\n- Fixed some minor issues with temporary variables and saving during spots that use them.\n- Added Bella's on-screen text conversation to the chat app.\n- Fixed a bug where you could get a scene without the correct prerequisities at the Christmas party free roam event.\n- Fixed an issue where the new gallery pictures from the Chat app could be set out of bounds in the gallery app.\n- Fixed a bug with the puzzle box that would allow an incorrect solution to side V.\n- Fixed a bug where the final button of the puzzle box could be prematurely unlocked.\n- Fixed an issue with Science - Experiment 1 waiting times that was introduced in v0.11.0.\n- Fixed an issue with the optional task list that didn't remove the \"Take care of your fish\" task if you took care of them from the aquarium instead of your fish bowl.\n- Fixed a variable that was set incorrectly. It won't affect your saves.\n- Fixed the order of Chad's phone number in the Contacts app.\n- Corrected typos.\n\n"
            changelog_list += "{color=ffed00}-- Changelog v0.11.1 --{/color}\n- Improved the display of text in the Party Planner section of the Stats app.\n- Fixed a bug that caused the happiness from the Guess who competition not to count in a particular combination of choices.\n- Fixed a bug that caused the Math scene on Josy and Maya's branch not to play as intended if you didn't get the contracts in Episode 10.\n- Fixed a bug that happened if you chose to leave the party, then ended up staying because of a choice with Zoey.\n- Fixed a bug that happened when calling Magnar during a free roam event at a certain spot.\n- Fixed a bug that caused MC to send a text to Jill after declining Philip's offer.\n- Improved the text alignment in the Stats app.\n- Fixed an issue with a special render that couldn't be clicked during the party free roam event.\n- Fixed a bug with a missing render during the party free roam event in Rusty's room.\n- Fixed a bug where the magnetic stirrer sound would keep playing if the science experiment ended while hearing it.\n- Fixed an issue with the party cutscene animation that happened if the persistent file got bugged.\n- Fixed a bug that caused the Mixed render gallery to crash unless you restarted the game once.\n- Fixed a bug that happened when you visited Madame Rose before sending an optional text message in the final free roam event.\n- Corrected typos.\n\n"
            changelog_list += "{color=ffed00}-- Changelog v0.11.0 --{/color}\n{color=4dc9ff}Added Episode 11 that includes\n7113 renders\n392 animations\n6 2D-art pieces\n2 2D-art animations\n42 songs\n32 sound effects{/color}\n\n- Fixed a bug that caused studying at your desk to fail if you opened the phone while choosing what to study.\n- Added a tracking system for Seen dialogue to the Stats app.\n- Added buttons to cycle the girls in the 2D art app.\n- Reduced the animation times of tiles appearing and disappearing in Triple Tile.\n- Fixed an issue with scrolling while browsing the phone gallery that would cause the phone to close.\n- Fixed an issue with the quick menu that set it to disabled after viewing credits.\n- Menus in Brawler can now be closed using the middle mouse button.\n- Improved the text spacing in the Bios app.\n- Fixed a bug where the final free roam event of Episode 10 didn't end if you failed the main task.\n- Fixed an issue with money messages staying on screen when fast traveling from the desk area.\n- Fixed a missing image error for an animation.\n- Fixed a bug with the on-screen text message conversation that could happen if a game was saved at specific points during these conversations.\n- Fixed an issue that prevented Envy's events from being added to her Bios history.\n- Fixed a rounding issue with the Happiness % in the Party Planner mini-game that caused a mismatch in % gained or lost during evaluation.\n- Fixed an issue with missing text in the Stats app and Party Planner tab when participating in the CUM-petition in Episode 9.\n- Fixed an issue with the Party Planning mini-game that didn't update the emotes correctly according to the happiness level.\n- Fixed an issue with the episode report of Episode 10 that would show a choice that potentially didn't happen for Lily.\n- Slightly increased timer for the English class.\n- Fixed an issue potentially causing a scene with Sage, Maya and Josy to be skipped if the player didn't spend time with Zoey in Episode 10.\n- Corrected typos.\n\n"
            changelog_list += "{color=ffed00}-- Changelog v0.10.1 --{/color}\n- Fixed a bug where a Jill scene could be played twice during the BBQ free roam event.\n- Fixed a bug with an event in the second free roam of Episode 9, where you could trigger a scene before talking to Josy.\n- Added a missing Halloween picture of Jamie to the phone gallery.\n- Tuned the scaling of the Brawler Normal mode timer slightly, to give a slightly increased timer at earlier skill point levels. Hard mode is unaffected by these changes.\n- Added Maya's lewd event from Episode 2 to the Girls tab in the Stats app.\n- Improved the wording of Step 3 in the Science experiment.\n- Fixed a bug with viewing Brawler and Science tutorials.\n- Disabled saving during English, Math and Science mini-games, as it serves no purpose and can potentially cause odd bugs.\n- Fixed an issue with the Mixed Rewards section, causing a traceback if Pack Quest of Episode 10 was unlocked on a fresh persistent file without closing the game once between gaming sessions.\n- Fixed an issue where Josy would erroneously appear in a party free roam event after finding a special render.\n- The quick menu setting to keep it enabled/on hover/disabled is now a persistent variable that you only have to set once for all your saves.\n- Fixed an issue with the Party Planner interface in the Stats app, that got an erroneously updated multiplier in the text. It only affected the text history of the Multiplier bonus.\n- Fixed so that caps lock will not interfere with English class typing.\n- Fixed a bug with missing music during a lewd scene replayed from the gallery.\n- Fixed a clipping hand on a Jill render.\n- Added extra calls to close blood effect screens during gUndead.\n- Added a color blind friendly setting in Preferences>Settings for Math and Science mini-games.\n- Fixed a bug with buying the Query tool from within the math mini-game that caused it to be purchased more than once if clicked continuously.\n- Fixed a bug with a SFW Josy animation missing a starting image.\n- Fixed a couple of variable lookups that affected two lines of dialogue.\n- Fixed two Rooster comments, tagging themselves with their post.\n- Corrected typos.\n\n"
            changelog_list += "{color=ffed00}-- Changelog v0.10.0 --{/color}\n{color=4dc9ff}Added Episode 10 that includes\n5868 renders\n335 animations\n8 2D-art pieces\n4 2D-art animations\n31 songs\n66 sound effects\n\n{/color}- Fixed a bug with using the middle mouse button or the off button during Shuffle.\n- Disabled rolling back and rolling forward while the phone is opened.\n- Fixed a bug where the CHICK response on Elena's cluck would subtract one from the total number of CHICK actions instead of adding one.\n- Fixed a bug with the Below Budget perk, which increased the starting budget of the Halloween party by $5.\n- Fixed an issue with Sarah's and Melanie's optional event in the final free roam event.\n- Fixed an issue with Sarah's optional event in the second free roam event.\n- Fixed an issue with the timer hampering performance during the drawing mini-game in the Interlude.\n- Fixed an issue where a scene with Becky could happen after the first party activity, now it only triggers before this activity, as intended.\n- Fixed a bug where save names sometimes reverted to old save file names.\n- Fixed a bug with the Wallpaper setting in the Settings app during the end of the Interlude that caused a crash.\n- Fixed an issue where Maya's lewd scene was stored incorrectly.\n- Fixed a bug with the truth or dare game that caused an omission of truth when asked how many you've slept with.\n- Fixed an issue with Lily's gallery scene causing an emote to misalign the text chat.\n- Fixed an issue with Lily's lewd scene where her tattoos were missing.\n- Updated the description of the Multiplier Madness perk. It worked as intended but its description was off.\n- Updated the snow effect in Episode 9.\n- Corrected typos.\n\n"
            changelog_list += "{color=ffed00}-- Changelog v0.9.1 --{/color}\n- Fixed a game breaking issue where Importing multiple saves in a row caused duplicated entries of lists such as Contacts and Bios. If your save have duplicates of any Bios, I'd recommend restarting that save file.\n- Fixed an issue where the MC name in the scene gallery wasn't updated to use your MC name.\n- Hid the quick menu during the Party Planner mini-game.\n- Fixed an issue with Rooster that incorrectly indicated that a new cluck was available after a Josy and Maya event.\n- Fixed an issue where you couldn't win the body shot competition with Becky.\n- Fixed an issue with a missing image.\n- Fixed an issue with Rusty's Bios that did the opposite of what was expected with passing the mansion mini-game.\n- Fixed an issue with the fast travel map in the final free roam event.\n- Fixed a lookup on a variable regarding Derek.\n- Fixed a pet name issue.\n- Corrected typos.\n\n"
            changelog_list += "{color=ffed00}-- Changelog v0.9.0 --{/color}\n{color=4dc9ff}Added Episode 9 that includes\n5037 renders\n303 animations\n12 2D-art pieces\n5 2D-art animations\n30 songs\n13 sound effects\n\n{/color}- Fixed an issue where the setting to only show the close button in the rewards app when hovering caused a traceback error.\n- Corrected typos.\n- Added Rollback Side option to the Dialogue tab in Preferences.\n- Removed 6 songs due to a band's wishes. Favorite lists are reset as a result.\n- Overhauled the main menu music player.\n- Your save file will now show if you have minigames enabled or not. You need to save your game once in v0.9.0 for this to show.\n\n"
            changelog_list += "{color=ffed00}-- Changelog Interlude --{/color}\n{color=4dc9ff}Added the Interlude that includes\n794 renders\n36 animations\n2 2D-art pieces\n2 2D-art animations\n19 songs\n18 sound effects{/color}\n\n"
        return
