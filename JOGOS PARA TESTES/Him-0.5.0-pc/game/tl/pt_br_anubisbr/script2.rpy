translate pt_br_anubisbr scene62_3_5a6a2f6a:

#   kat "Thank you too. I swear, I'll find a way to get you out of here one day."
    kat "Obrigada você também. Juro que um dia darei um jeito de te tirar daqui."

# game/script2.rpy:8552
translate pt_br_anubisbr scene62_3_802a75f2:

#   ruby "It's Ruby. And sure, I'll hold you to that. Don't make me rot in here forever, sweetheart."
