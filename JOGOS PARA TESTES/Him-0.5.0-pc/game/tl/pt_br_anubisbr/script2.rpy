    osric "Eu não saberia o que fazer sem ela!"

# game/script2.rpy:7489
translate pt_br_anubisbr scene60_choice01_op2_2e8e6c9a:

#   greta "...Maybe we just need counseling!"
    greta "...Talvez só precisemos de terapia!"

