# ARQUIVO: game/script2.rpy DIALOGOS: 4493


# game/script2.rpy:9
translate pt_br_anubisbr scene42_f5409aa5:

#   perception "The village is brighter than yesterday. The sun is warm, the air smells faintly of soil and woodsmoke."
    perception "A aldeia está mais iluminada do que ontem. O sol está quente, o ar tem um leve cheiro de terra e fumaça de lenha."

# game/script2.rpy:74
translate pt_br_anubisbr scene42_forward_879f2795:

#   mc "Hey. Having some trouble?"
    mc "Olá. Está com algum problema?"

# game/script2.rpy:76
translate pt_br_anubisbr scene42_forward_2b34d24a:

#   villager "Oh, hello! As a matter of fact, I am... This stubborn thing won't budge."
    villager "Ah, olá! Na verdade, eu sou... Essa coisa teimosa não se mexe."

# game/script2.rpy:78
translate pt_br_anubisbr scene42_forward_777b9920:

#   mc "Want me to help?"
    mc "Quer que eu te ajude?"

# game/script2.rpy:80
translate pt_br_anubisbr scene42_forward_6c9a5811:

#   villager "If it's not too much trouble, young one."
    villager "Se não for muito incômodo, meu jovem."

# game/script2.rpy:83
translate pt_br_anubisbr scene42_forward_47a3466a:

#   sensation "The bucket is heavier than expected. The water inside shimmers faintly."
    sensation "O balde é mais pesado do que eu esperava. A água dentro dele brilha levemente."

# game/script2.rpy:84
translate pt_br_anubisbr scene42_forward_7e897f05:

#   mc "What's in this, rocks?"
    mc "O que tem aqui dentro, pedras?"

# game/script2.rpy:85
translate pt_br_anubisbr scene42_forward_d2f98e2d:

#   villager "*laughs*"
    villager "*risos*"

# game/script2.rpy:108
translate pt_br_anubisbr scene42_well_adc97f7e:

#   "Mini-Game Skipped"
    "Minijogo pulado"

# game/script2.rpy:113
translate pt_br_anubisbr scene42_well_d6711af7:

#   villager "My, my... that was impressive."
    villager "Nossa, nossa... isso foi impressionante."

# game/script2.rpy:116
translate pt_br_anubisbr scene42_well_27b45e3f:

#   villager "Nicely done. You've got some strength in you."
    villager "Muito bem. Você tem muita força."

# game/script2.rpy:118
translate pt_br_anubisbr scene42_well_94a10f0c:

#   mc "Hngg!"
    mc "Hngg!"

# game/script2.rpy:119
translate pt_br_anubisbr scene42_well_94c1ded1:

#   villager "Almost. Try nudging it to the side."
    villager "Quase. Tente empurrá-lo para o lado."

# game/script2.rpy:122
translate pt_br_anubisbr scene42_well_7d75d92a:

#   villager "Hmm... Not quite. Try pulling with more control next time."
    villager "Hum... Não exatamente. Tente puxar com mais controle da próxima vez."

# game/script2.rpy:125
translate pt_br_anubisbr scene42_well_e4e1f082:

#   mc "Come on, it wasn't that heavy..."
    mc "Vamos lá, não era tão pesado assim..."

# game/script2.rpy:127
translate pt_br_anubisbr scene42_well_823889b5:

#   villager "Still, I appreciate your help. Maybe I was wrong about you."
    villager "Ainda assim, agradeço sua ajuda. Talvez eu estivesse enganado a seu respeito."

# game/script2.rpy:129
translate pt_br_anubisbr scene42_well_27e27ac8:

#   mc "Wrong about what?"
    mc "Errado sobre o quê?"

# game/script2.rpy:131
translate pt_br_anubisbr scene42_well_9b3fb6da:

#   villager "Don't worry about it. It was a pleasure meeting you, traveler. May the Goddess keep you."
    villager "Não se preocupe. Foi um prazer conhecê-lo(a), viajante. Que a Deusa o(a) proteja."

# game/script2.rpy:133
translate pt_br_anubisbr scene42_well_fa45f281:

#   mc "Thanks..."
    mc "Obrigado..."

# game/script2.rpy:139
translate pt_br_anubisbr scene42_heiter_623c1c05:

#   mc "Hello."
    mc "Olá."

# game/script2.rpy:141
translate pt_br_anubisbr scene42_heiter_01e35a8a:

#   heiter_ "Traveler! The Goddess smiles on your arrival."
    heiter_ "Viajante! A Deusa sorri para você em sua chegada."

# game/script2.rpy:143
translate pt_br_anubisbr scene42_heiter_eef92453:

#   roza_ "He means 'hello'."
    roza_ "Ele quer dizer 'olá'."

# game/script2.rpy:145
translate pt_br_anubisbr scene42_heiter_fc98e304:

#   heiter_ "I'm Heiter, and these are Ada and Roza. They are my—"
    heiter_ "Eu sou Heiter, e estas são Ada e Roza. Elas são minhas—"

# game/script2.rpy:146
translate pt_br_anubisbr scene42_heiter_c1b4e981:

#   villager "Good morning, Heiter!"
    villager "Bom dia, Heiter!"

# game/script2.rpy:148
translate pt_br_anubisbr scene42_heiter_6a4f8988:

#   heiter "Good morning!"
    heiter "Bom dia!"

# game/script2.rpy:150
translate pt_br_anubisbr scene42_heiter_d354d5e6:

#   heiter "Anyway, like I was saying—these two are my—"
    heiter "Enfim, como eu estava dizendo—estes dois são meus—"

# game/script2.rpy:151
translate pt_br_anubisbr scene42_heiter_3c747779:

#   villager "Heiter! Come help me with this!"
    villager "Heiter! Venha me ajudar com isso!"

# game/script2.rpy:153
translate pt_br_anubisbr scene42_heiter_ae10f5bd:

#   heiter "I will in a bit! Just give me a moment!"
    heiter "Já vou fazer isso! Só me dê um minutinho!"

# game/script2.rpy:155
translate pt_br_anubisbr scene42_heiter_52765641:

#   heiter "...So... what was I talking about?"
    heiter "Então... do que eu estava falando mesmo?"

# game/script2.rpy:157
translate pt_br_anubisbr scene42_heiter_310786e9:

#   roza "*sigh* Forget it."
    roza "*suspiro* Esquece."

# game/script2.rpy:159
translate pt_br_anubisbr scene42_heiter_5e3db4c9:

#   mc "Good meeting you all."
    mc "Foi um prazer conhecer todos vocês."

# game/script2.rpy:160
translate pt_br_anubisbr scene42_heiter_bb726399:

#   mc "The place seems livelier than yesterday. When we arrived, it was like a ghost town."
    mc "O lugar parece mais animado do que ontem. Quando chegamos, parecia uma cidade fantasma."

# game/script2.rpy:162
translate pt_br_anubisbr scene42_heiter_9eda9418:

#   heiter "*chuckles* Sorry if we scared you. You must have arrived during the village meeting."
    heiter "*risos* Desculpe se te assustamos. Você deve ter chegado durante a reunião da aldeia."

# game/script2.rpy:164
translate pt_br_anubisbr scene42_heiter_fa336062:

#   mc "A meeting? Must've been important if the entire village was there."
    mc "Uma reunião? Devia ser importante se a aldeia inteira estava lá."

# game/script2.rpy:166
translate pt_br_anubisbr scene42_heiter_5b85eb21:

#   ada "Is that not what you came for? You missed it."
    ada "Não era isso que você queria ver? Você perdeu."

# game/script2.rpy:168
translate pt_br_anubisbr scene42_heiter_3d996037:

#   mc "What are you talking about?"
    mc "O que você está falando?"

# game/script2.rpy:170
translate pt_br_anubisbr scene42_heiter_60bb4265:

#   heiter "The Festival, of course. It usually draws men from all over—though no one showed up this time. Aside from you that is."
    heiter "O Festival, claro. Normalmente atrai homens de todos os lugares — embora ninguém tenha aparecido desta vez. Exceto você, é claro."

# game/script2.rpy:172
translate pt_br_anubisbr scene42_heiter_3e24139e:

#   mc "Festival? Not really what I came here for, I just wanted to treat my friend and maybe trade."
    mc "Festival? Não era bem para isso que eu vim, eu só queria fazer um presente para meu amigo e talvez trocar algumas coisas."

# game/script2.rpy:174
translate pt_br_anubisbr scene42_heiter_49595776:

#   roza "A shame... We could definitely use a fresh man this year. The ones we have are... lacking."
    roza "Uma pena... Definitivamente, poderíamos usar um jogador novo este ano. Os que temos são... fracos."

# game/script2.rpy:176
translate pt_br_anubisbr scene42_heiter_4b5ec264:

#   heiter "Hey! Come on. I'm standing right here."
    heiter "Ei! Vamos lá. Estou bem aqui."

# game/script2.rpy:178
translate pt_br_anubisbr scene42_heiter_db8cab51:

#   ada "*laughs* She's right. You're sweet, Heiter, but you're not exactly a warrior. You almost passed out last time."
    ada "*risos* Ela tem razão. Você é um amor, Heiter, mas não é exatamente um guerreiro. Quase desmaiou da última vez."

# game/script2.rpy:180
translate pt_br_anubisbr scene42_heiter_6c27a95d:

#   heiter "*groan*"
    heiter "*gemido*"

# game/script2.rpy:181
translate pt_br_anubisbr scene42_heiter_c35f884f:

#   mc "Can someone please tell me what's going on?"
    mc "Alguém pode me dizer o que está acontecendo?"

# game/script2.rpy:183
translate pt_br_anubisbr scene42_heiter_98bf6054:

#   heiter "The Goddess's Festival! It's a sacred tradition. Every ten years, the men of the village compete in a series of tests."
    heiter "O Festival da Deusa! É uma tradição sagrada. A cada dez anos, os homens da aldeia competem numa série de provas."

# game/script2.rpy:184
translate pt_br_anubisbr scene42_heiter_278ef283:

#   heiter "The winner is chosen to bless the womb of all birth able women of the village."
    heiter "A vencedora é escolhida para abençoar o ventre de todas as mulheres em idade fértil da aldeia."

# game/script2.rpy:185
translate pt_br_anubisbr scene42_heiter_0411d13a:

#   heiter "It's the highest calling a man can aspire to. The Goddess herself watches over the Trial and blesses the victor with her favor."
    heiter "É a mais elevada vocação a que um homem pode aspirar. A própria Deusa observa a Prova e abençoa o vencedor com seu favor."

# game/script2.rpy:187
translate pt_br_anubisbr scene42_heiter_a5aee42a:

#   empathy "There's no hesitation in his voice. He's stating this as if it's the most natural thing in the world."
    empathy "Ele não hesita em sua voz. Está afirmando isso como se fosse a coisa mais natural do mundo."

# game/script2.rpy:189
translate pt_br_anubisbr scene42_heiter_3e68930f:

#   ada "Exciting, isn't it? It's our first time participating. We're both hoping to be blessed."
    ada "Que emocionante, não é? É a nossa primeira vez participando. Ambos esperamos ser abençoados."

# game/script2.rpy:191
translate pt_br_anubisbr scene42_heiter_902d6958:

#   mc "I... don't know what to say. What happens to the losers?"
    mc "Eu... não sei o que dizer. O que acontece com os perdedores?"

# game/script2.rpy:193
translate pt_br_anubisbr scene42_heiter_e338bbc6:

#   heiter "The winner takes all, friend."
    heiter "O vencedor leva tudo, amigo."

# game/script2.rpy:195
translate pt_br_anubisbr scene42_heiter_7e39fe5b:

#   mc "So nothing? The losers just... go home?"
    mc "Então nada? Os perdedores simplesmente... vão para casa?"

# game/script2.rpy:197
translate pt_br_anubisbr scene42_heiter_301bf14b:

#   ada "Who'd want to breed with a loser, anyway? The Goddess demands the best. Only the strongest seed is worthy."
    ada "Afinal, quem iria querer procriar com um perdedor? A Deusa exige o melhor. Só a semente mais forte é digna."

# game/script2.rpy:199
translate pt_br_anubisbr scene42_heiter_b533c823:

#   mc "This all seems barbaric. Can't you just, you know... choose who to love?"
    mc "Tudo isso parece bárbaro. Você não pode simplesmente... escolher quem amar?"

# game/script2.rpy:201
translate pt_br_anubisbr scene42_heiter_4c5d0ce7:

#   heiter "To outsiders, maybe. But we've followed this tradition for generations."
    heiter "Para quem vê de fora, talvez. Mas nós seguimos essa tradição há gerações."

# game/script2.rpy:202
translate pt_br_anubisbr scene42_heiter_43c2da4c:

#   heiter "The Goddess ordains this. Without strong blood, the blight would've consumed us decades ago. Our harvests thrive because {i}she{/i} thrives. The Trial ensures her favor."
    heiter "A Deusa assim o ordena. Sem sangue forte, a praga teria nos consumido há décadas. Nossas colheitas prosperam porque {i} ela{/i} prospera. O julgamento garante seu favor."

# game/script2.rpy:203
translate pt_br_anubisbr scene42_heiter_f64a4334:

#   heiter "Unfortunately, not all have remained faithful. Some strayed... and the Goddess's wrath was merciless."
    heiter "Infelizmente, nem todos permaneceram fiéis. Alguns se desviaram... e a ira da Deusa foi implacável."

# game/script2.rpy:204
translate pt_br_anubisbr scene42_heiter_f19f94aa:

#   heiter "That is why so few of us remain."
    heiter "É por isso que restam tão poucos de nós."

# game/script2.rpy:206
translate pt_br_anubisbr scene42_heiter_a9cabfba:

#   roza "Why not compete? You're clearly strong—I saw you lift that bucket. *giggles* {size=30}It was a test, by the way.{/size}"
    roza "Por que não competir? Você é claramente forte — eu vi você levantar aquele balde. *risos* {size=30} Aliás, era um teste.{/size}"

# game/script2.rpy:207
translate pt_br_anubisbr scene42_heiter_628f9ee3:

#   roza "I wouldn't mind being blessed by you, traveller."
    roza "Eu não me importaria de receber sua bênção, viajante."

# game/script2.rpy:209
translate pt_br_anubisbr scene42_heiter_f2568dbf:

#   mc "I still don't quite understand some things..."
    mc "Ainda não entendi muito bem algumas coisas..."

# game/script2.rpy:211
translate pt_br_anubisbr scene42_heiter_72afd6f9:

#   heiter "Mother Ysella would be more than happy to explain further."
    heiter "A Madre Ysella ficaria muito feliz em explicar melhor."

# game/script2.rpy:213
translate pt_br_anubisbr scene42_heiter_7430a6ca:

#   mc "Got it. Good seeing you all."
    mc "Entendi. Foi ótimo ver todos vocês."

# game/script2.rpy:234
translate pt_br_anubisbr scene42_free_roam_coin_18823408:

#   mc "Is this yours Alex?"
    mc "Isto é seu, Alex?"

# game/script2.rpy:235
translate pt_br_anubisbr scene42_free_roam_coin_fa093b16:

#   mc "I'm just gonna borrow it for a bit..."
    mc "Vou só pegar emprestado por um tempinho..."

# game/script2.rpy:262
translate pt_br_anubisbr scene42_poster2_7359364c:

#   mc "What's this doing on you, pal?"
    mc "O que isso está fazendo com você, amigo?"

# game/script2.rpy:283
translate pt_br_anubisbr scene42_sigrun_669664cb:

#   mc "Hey."
    mc "Ei."

# game/script2.rpy:285
translate pt_br_anubisbr scene42_sigrun_028844e4:

#   sigrun_ "Oh, traveler. A pleasure to meet you. How is your friend doing?"
    sigrun_ "Oh, viajante. Um prazer conhecê-lo. Como vai seu amigo?"

# game/script2.rpy:287
translate pt_br_anubisbr scene42_sigrun_3066b0da:

#   mc "She's still sleeping, Ymir gave her something for the pain. I hope she gets better soon."
    mc "Ela ainda está dormindo, Ymir deu algo para a dor dela. Espero que ela melhore logo."

# game/script2.rpy:289
translate pt_br_anubisbr scene42_sigrun_5c1c2f1b:

#   sigrun "I hope so too. Ymir's brews are effective—if a little strong. I'm Sigrun, and this is my husband, Aldwin."
    sigrun "Eu também espero que sim. As poções de Ymir são eficazes — embora um pouco fortes. Meu nome é Sigrun, e este é meu marido, Aldwin."

# game/script2.rpy:291
translate pt_br_anubisbr scene42_sigrun_85338605:

#   aldwin "*sigh*"
    aldwin "*suspirar*"

# game/script2.rpy:293
translate pt_br_anubisbr scene42_sigrun_e490b37f:

#   sigrun "Won't you greet our guest, dear?"
    sigrun "Você poderia cumprimentar nosso convidado, querida?"

# game/script2.rpy:295
translate pt_br_anubisbr scene42_sigrun_1299fdac:

#   aldwin "Welcome, traveler. Forgive me, I'm not... in the best health."
    aldwin "Bem-vindo, viajante. Perdoe-me, eu não estou... com a saúde em dia."

# game/script2.rpy:296
translate pt_br_anubisbr scene42_sigrun_700e6051:

#   mc "You alright?"
    mc "Você está bem?"

# game/script2.rpy:297
translate pt_br_anubisbr scene42_sigrun_249161ec:

#   aldwin "Just feeling my years catch up to me, that's all. I used to be strong once."
    aldwin "Só estou sentindo o peso da idade, é tudo. Eu costumava ser forte."

# game/script2.rpy:299
translate pt_br_anubisbr scene42_sigrun_321c7dbf:

#   sigrun "And you still are, love."
    sigrun "E você ainda é, meu amor."

# game/script2.rpy:301
translate pt_br_anubisbr scene42_sigrun_b792aece:

#   aldwin "Not strong enough to fight this time... And now..."
    aldwin "Desta vez não tenho forças para lutar... E agora..."

# game/script2.rpy:302
translate pt_br_anubisbr scene42_sigrun_2f66437d:

#   sigrun "..."
    sigrun "..."

# game/script2.rpy:303
translate pt_br_anubisbr scene42_sigrun_f22eb4b2:

#   aldwin "Twice I fought. Won. Proved myself. Kept you as mine. But now..."
    aldwin "Lutei duas vezes. Venci. Provei meu valor. Mantive você como minha. Mas agora..."

# game/script2.rpy:305
translate pt_br_anubisbr scene42_sigrun_7cd85beb:

#   sigrun "It's tradition, Aldwin. I don't like it any more than you do, but it's what keeps the village alive."
    sigrun "É tradição, Aldwin. Eu não gosto disso mais do que você, mas é o que mantém a vila viva."

# game/script2.rpy:307
translate pt_br_anubisbr scene42_sigrun_8aa81725:

#   aldwin "Easy for you to say."
    aldwin "Fácil para você dizer."

# game/script2.rpy:308
translate pt_br_anubisbr scene42_sigrun_2b35b6fe:

#   mc "..."
    mc "..."

# game/script2.rpy:310
translate pt_br_anubisbr scene42_sigrun_481d5fcf:

#   sigrun "Forgive us, traveler. This has been hard for me... for both of us."
    sigrun "Perdoe-nos, viajante. Isso tem sido difícil para mim... para nós dois."

# game/script2.rpy:311
translate pt_br_anubisbr scene42_sigrun_8b7d4c6b:

#   sigrun "We love each other deeply, but love doesn't always matter when the Goddess calls."
    sigrun "Nós nos amamos profundamente, mas o amor nem sempre importa quando a Deusa chama."

# game/script2.rpy:313
translate pt_br_anubisbr scene42_sigrun_5cb76833:

#   mc "I can tell. Well, I'll leave you two in peace."
    mc "Dá para perceber. Bom, vou deixar vocês dois em paz."

# game/script2.rpy:315
translate pt_br_anubisbr scene42_sigrun_8119087e:

#   sigrun "Thank you. May the goddess watch over you."
    sigrun "Obrigada. Que a deusa te proteja."

# game/script2.rpy:322
translate pt_br_anubisbr scene42_werewolf_villager_547132a0:

#   mc "You... don't look like the others."
    mc "Você... não se parece com os outros."

# game/script2.rpy:324
translate pt_br_anubisbr scene42_werewolf_villager_d54749b3:

#   villager "Ah, you noticed? And here I thought I blended right in with all the pale, golden-haired folk."
    villager "Ah, você percebeu? E eu que pensava que me misturava perfeitamente com toda aquela gente pálida de cabelos dourados."

# game/script2.rpy:326
translate pt_br_anubisbr scene42_werewolf_villager_7c16f3a4:

#   mc "How'd you end up here?"
    mc "Como você veio parar aqui?"

# game/script2.rpy:328
translate pt_br_anubisbr scene42_werewolf_villager_68cbf9b7:

#   villager "Our caravan was attacked... a werewolf. I was lucky—ran as soon as I heard the first scream."
    villager "Nossa caravana foi atacada... por um lobisomem. Eu tive sorte — corri assim que ouvi o primeiro grito."

# game/script2.rpy:329
translate pt_br_anubisbr scene42_werewolf_villager_60225318:

#   villager "The others... I don't know. I try not to think about it."
    villager "Os outros... não sei. Tento não pensar nisso."

# game/script2.rpy:331
translate pt_br_anubisbr scene42_werewolf_villager_7ccbca1c:

#   mc "A werewolf... What happened after?"
    mc "Um lobisomem... O que aconteceu depois?"

# game/script2.rpy:333
translate pt_br_anubisbr scene42_werewolf_villager_48c84f15:

#   villager "The villagers took me in. Kind folks, if a little strange—especially when they start talking about their {i}goddess.{/i}"
    villager "Os moradores me acolheram. Gente gentil, embora um pouco estranha — principalmente quando começam a falar sobre suas origens. {i} deusa.{/i}"

# game/script2.rpy:334
translate pt_br_anubisbr scene42_werewolf_villager_bc2bd1e2:

#   villager "Still, their hearts are in the right place. I think."
    villager "Ainda assim, acho que suas intenções são boas."

# game/script2.rpy:336
translate pt_br_anubisbr scene42_werewolf_villager_47d950a6:

#   mc "Thanks for sharing that."
    mc "Obrigado por compartilhar isso."

# game/script2.rpy:338
translate pt_br_anubisbr scene42_werewolf_villager_ba003425:

#   villager "Not like I'm going anywhere."
    villager "Não que eu vá a algum lugar."

# game/script2.rpy:389
translate pt_br_anubisbr scene42_continue_78419b2b:

#   mc "(I guess I'll ask Ysella about what's going on.)"
    mc "(Acho que vou perguntar à Ysella o que está acontecendo.)"

# game/script2.rpy:392
translate pt_br_anubisbr scene42_continue_0ae9bcd0:

#   ""
    ""

# game/script2.rpy:397
translate pt_br_anubisbr scene42_continue_fe9589d1:

#   ysella "Ah, [mc]. Come here, sit."
    ysella "Ah, [mc] Venha aqui, sente-se."

# game/script2.rpy:399
translate pt_br_anubisbr scene42_continue_4f34c20c:

#   ysella "Good morning, [mc]. I hope you had a restful night. You'll likely need it for what's to come."
    ysella "Bom dia, [mc] Espero que você tenha tido uma noite tranquila. Provavelmente precisará disso para o que está por vir."

# game/script2.rpy:401
translate pt_br_anubisbr scene42_continue_537ce8ea:

#   mc "So... Tell me. What's really going on here?"
    mc "Então... Diga-me. O que realmente está acontecendo aqui?"

# game/script2.rpy:403
translate pt_br_anubisbr scene42_continue_1a381bdf:

#   ysella "I suppose we can't hide it any longer... We are preparing for our tradition that comes around every three years, where the men compete for the right to plant their seed in every willing womb."
    ysella "Acho que não podemos mais esconder... Estamos nos preparando para a nossa tradição que acontece a cada três anos, onde os homens competem pelo direito de plantar sua semente em todo útero receptivo."

# game/script2.rpy:404
translate pt_br_anubisbr scene42_continue_75e488bf:

#   ysella "The winner earns the honor of blessing the families of the defeated. The ritual strengthens us. Unites us."
    ysella "O vencedor conquista a honra de abençoar as famílias dos derrotados. O ritual nos fortalece. Nos une."

# game/script2.rpy:406
translate pt_br_anubisbr scene42_continue_3d5f177d:

#   mc "And when does this festival begin?"
    mc "E quando começa esse festival?"

# game/script2.rpy:408
translate pt_br_anubisbr scene42_continue_019b7211:

#   ysella "At moonrise. We can't afford to delay. I'm sure you've already heard bits of it from the villagers."
    ysella "Ao nascer da lua. Não podemos nos dar ao luxo de atrasar. Tenho certeza de que você já ouviu partes disso dos moradores da vila."

# game/script2.rpy:410
translate pt_br_anubisbr scene42_continue_71e955fb:

#   oswald "Our village was struck by a devastating blight last year. Most of our people fled the village and some even died."
    oswald "Nossa aldeia foi atingida por uma praga devastadora no ano passado. A maioria dos nossos habitantes fugiu da aldeia e alguns até morreram."

# game/script2.rpy:412
translate pt_br_anubisbr scene42_continue_b3c99efe:

#   mc "...Why keep this secret in the first place?"
    mc "...Por que manter esse segredo, afinal?"

# game/script2.rpy:414
translate pt_br_anubisbr scene42_continue_10102e00:

#   ysella "We cannot trust just any traveler. Outsiders must first prove themselves—through their actions, their character."
    ysella "Não podemos confiar em qualquer viajante. Os forasteiros precisam primeiro provar seu valor — por meio de suas ações e seu caráter."

# game/script2.rpy:416
translate pt_br_anubisbr scene42_continue_d2d9f1fb:

#   mc "And I passed?"
    mc "E eu passei?"

# game/script2.rpy:418
translate pt_br_anubisbr scene42_continue_5e2b9e8f:

#   ysella "Yes. Even the smallest acts reveal the soul."
    ysella "Sim. Até os menores atos revelam a alma."

# game/script2.rpy:420
translate pt_br_anubisbr scene42_continue_b1165ee8:

#   mc "What happens if I refuse?"
    mc "O que acontece se eu recusar?"

# game/script2.rpy:422
translate pt_br_anubisbr scene42_continue_694b03ca:

#   oswald "Nothing will happen to you. You're free to walk away."
    oswald "Nada lhe acontecerá. Você tem toda a liberdade de ir embora."

# game/script2.rpy:423
translate pt_br_anubisbr scene42_continue_a7d6c84a:

#   oswald "But... we would very much like for you to join us."
    oswald "Mas... gostaríamos muito que você se juntasse a nós."

# game/script2.rpy:424
translate pt_br_anubisbr scene42_continue_559e9a2a:

#   oswald "As you have seen, our numbers have dwindled. The last two festivals were won by the same man—Aldwin—and he's no longer strong enough to fight. We fear the effects of continued inbreeding."
    oswald "Como vocês puderam ver, nosso número diminuiu. Os dois últimos festivais foram vencidos pelo mesmo homem — Aldwin — e ele já não tem forças para lutar. Tememos os efeitos da consanguinidade contínua."

# game/script2.rpy:426
translate pt_br_anubisbr scene42_continue_159756cc:

#   ysella "It's not just a tradition—it's survival too."
    ysella "Não é apenas uma tradição — é também uma questão de sobrevivência."

# game/script2.rpy:395
translate pt_br_anubisbr scene42_continue_0ae9bcd0_1:

#   ""
    ""

