    ysella "Maravilhoso! Oh, maravilhoso! A Deusa ficará tão satisfeita! Um novo campeão."

# game/script2.rpy:437
translate pt_br_anubisbr scene42_choice01_op1_1b4751fc:

#   oswald "Goddess bless you, [mc]. You have given us hope we haven't felt in years."
    oswald "Que a Deusa te abençoe, [mc] Vocês nos deram uma esperança que não sentíamos há anos."

# game/script2.rpy:439
translate pt_br_anubisbr scene42_choice01_op1_e043ad59:

