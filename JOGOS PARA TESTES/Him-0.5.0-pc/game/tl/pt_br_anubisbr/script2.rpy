#   mc "I ordered her execution."
    mc "Eu ordenei a execução dela."

# game/script2.rpy:8477
translate pt_br_anubisbr scene62_2_96b44095:

#   mc "I ordered life in prison for here."
    mc "Eu condenei este à prisão perpétua."

# game/script2.rpy:8480
translate pt_br_anubisbr scene62_2_68a98e93:

#   avery "A necessary decision. The weight of authority is not always pleasant, is it?"
    avery "Uma decisão necessária. O peso da autoridade nem sempre é agradável, não é?"

