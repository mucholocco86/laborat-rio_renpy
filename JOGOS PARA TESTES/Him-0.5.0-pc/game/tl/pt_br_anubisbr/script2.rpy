    greta "Espírito? Você não me toca há meses!"

# game/script2.rpy:7394
translate pt_br_anubisbr scene60_5d1dd51d:

#   osric "Maybe if you stopped wearing that awful nightgown, I'd feel like it!"
    osric "Talvez se você parasse de usar essa camisola horrível, eu me animaria!"

# game/script2.rpy:7396
translate pt_br_anubisbr scene60_324cbbdb:

#   greta "That was your mother's wedding gift, you insensitive donkey!"
    greta "Esse foi o presente de casamento da sua mãe, seu burro insensível!"

# game/script2.rpy:7398
translate pt_br_anubisbr scene60_e67dbffa:

#   osric "Oh, we're bringing my mother into this now?!"
    osric "Ah, agora vão envolver minha mãe nisso?!"

# game/script2.rpy:7400
translate pt_br_anubisbr scene60_2e17fd2c:

#   greta "She hated me from day one!"
    greta "Ela me odiou desde o primeiro dia!"

# game/script2.rpy:7402
translate pt_br_anubisbr scene60_57633619:

#   osric "Because you never even tried to get along!"
    osric "Porque você nunca nem tentou se dar bem com as pessoas!"

# game/script2.rpy:7404
translate pt_br_anubisbr scene60_38bad4bd:

#   greta "You didn't seem to mind when I was giving you nightly blowjobs every evening!"
    greta "Você não parecia se importar quando eu lhe fazia sexo oral todas as noites!"

# game/script2.rpy:7406
translate pt_br_anubisbr scene60_287fb099:

#   osric "Well, you stopped doing that too!"
    osric "Bom, você também parou de fazer isso!"

# game/script2.rpy:7408
translate pt_br_anubisbr scene60_4813d3e3:

#   greta "Because {i}you{/i} stopped washing your disgusting balls!"
    greta "Porque {i} você{/i} Pare de lavar suas bolas nojentas!"

# game/script2.rpy:7410
translate pt_br_anubisbr scene60_e5f0b9b7:

