#   mc "Kat. Look... about that. I need you to understand something. What I did in there... I only did it to save your life."
    mc "Kat. Olha... sobre isso. Preciso que você entenda uma coisa. O que eu fiz lá dentro... eu só fiz para salvar sua vida."

# game/script2.rpy:8608
translate pt_br_anubisbr scene62_choice02_op1_d576f42e:

#   kat "...Oh."
    kat "...Oh."

# game/script2.rpy:8609
