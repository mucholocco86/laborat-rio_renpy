    osric "Porque VOCÊ quebrou o balde de lavar roupa!"

# game/script2.rpy:7412
translate pt_br_anubisbr scene60_2e9d0421:

#   greta "YOU used it to carve a toy in one of your drunken fits!"
    greta "Você usou isso para esculpir um brinquedo em um dos seus ataques de embriaguez!"

# game/script2.rpy:7414
translate pt_br_anubisbr scene60_f07351ea:

#   osric "I... Wait... Did I really?"
    osric "Eu... Espera... Será que eu fiz mesmo?"

# game/script2.rpy:7416
translate pt_br_anubisbr scene60_d1a73fbc:

#   perception "The shouting echoes through the grand hall, slowly giving way to an awkward silence. You and Avery exchange a glance, both unsure whether to laugh or cry."
    perception "Os gritos ecoam pelo grande salão, dando lugar lentamente a um silêncio constrangedor. Você e Avery trocam um olhar, ambos sem saber se riem ou choram."

# game/script2.rpy:7418
translate pt_br_anubisbr scene60_ad4ae3b1:

#   avery "...Are you two quite finished?"
    avery "...Vocês dois já terminaram mesmo?"

# game/script2.rpy:7420
translate pt_br_anubisbr scene60_e9a6e5e6:

#   greta "..."
    greta "..."

# game/script2.rpy:7421
