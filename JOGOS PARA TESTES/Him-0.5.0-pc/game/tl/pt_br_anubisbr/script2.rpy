    annette "Obrigada... Eu mesma cultivei todas essas."

# game/script2.rpy:2800
translate pt_br_anubisbr scene47_annette_628053ca:

#   mc "Seriously? That's amazing."
    mc "Sério? Isso é incrível."

# game/script2.rpy:2802
translate pt_br_anubisbr scene47_annette_fc5ffbd1:

#   annette "I'm glad you like it."
    annette "Que bom que você gostou."

# game/script2.rpy:2803
translate pt_br_anubisbr scene47_annette_534a7613:

#   annette "So... what do you... think of me, [mc]?"
    annette "Então... o que você... acha de mim? [mc]?"

# game/script2.rpy:2805
translate pt_br_anubisbr scene47_annette_e4ed5194:

#   mc "In what way?"
    mc "De que maneira?"

# game/script2.rpy:2807
translate pt_br_anubisbr scene47_annette_73371911:

#   annette "Just... in general."
    annette "Só... em geral."

# game/script2.rpy:2813
translate pt_br_anubisbr scene47_choice01_op1_e0c9b64c:

#   mc "You're sweet. Gentle. I like that about you."
    mc "Você é doce. Gentil. Gosto disso em você."

# game/script2.rpy:2815
translate pt_br_anubisbr scene47_choice01_op1_f3dd7a71:

#   annette "Thank you... I try to be..."
    annette "Obrigado... Eu tento ser..."

# game/script2.rpy:2819
translate pt_br_anubisbr scene47_choice01_op2_c0341a8a:

#   mc "You're shy, sure. But I bet you're wild once someone gets you alone."
    mc "Você é tímido, com certeza. Mas aposto que você se solta completamente quando alguém te conquista."

# game/script2.rpy:2821
translate pt_br_anubisbr scene47_choice01_op2_3aa0460e:

#   annette "I—! T-That's...! I mean..."
    annette "Eu...! I-Isso é...! Quer dizer..."

# game/script2.rpy:2823
translate pt_br_anubisbr scene47_choice01_op2_f7cb7606:

#   mc "Are you not?"
    mc "Não é?"

# game/script2.rpy:2824
translate pt_br_anubisbr scene47_choice01_op2_302fad04:

#   annette "..."
    annette "..."

# game/script2.rpy:2829
translate pt_br_anubisbr scene47_choice01_op3_cf83d069:

#   mc "You're a little weird sometimes. But... kind of cute, too."
    mc "Você é um pouco esquisito às vezes. Mas... também é meio fofo."

# game/script2.rpy:2831
translate pt_br_anubisbr scene47_choice01_op3_b12fc5a1:

#   annette "*giggle* I'll take that as a compliment."
    annette "*risos* Vou considerar isso um elogio."

# game/script2.rpy:2836
translate pt_br_anubisbr scene47_annette2_fafbd886:

#   annette "*sigh* The villagers... say I'm weird sometimes."
    annette "*suspiro* Os moradores... dizem que eu sou estranho às vezes."

# game/script2.rpy:2838
translate pt_br_anubisbr scene47_annette2_c14c584c:

#   mc "Well..."
    mc "Bem..."

# game/script2.rpy:2840
translate pt_br_anubisbr scene47_annette2_f2725c64:

#   annette "Are they right?"
    annette "Eles têm razão?"

# game/script2.rpy:2842
translate pt_br_anubisbr scene47_annette2_dea00a58:

#   mc "I did wake up to you staring at me the other day... so..."
    mc "Eu acordei com você me encarando outro dia... então..."

# game/script2.rpy:2844
translate pt_br_anubisbr scene47_annette2_82e7dd33:

#   annette "I-I wasn't doing it on purpose! I just... you looked peaceful. I thought maybe... watching you would help me fall asleep too."
    annette "Eu não fiz isso de propósito! Eu só... você parecia em paz. Pensei que talvez... observá-la me ajudasse a dormir também."

# game/script2.rpy:2846
translate pt_br_anubisbr scene47_annette2_5a1b0ae1:

#   mc "That's not how that works, Annette."
    mc "Não é assim que funciona, Annette."

# game/script2.rpy:2848
translate pt_br_anubisbr scene47_annette2_e6a18de1:

#   annette "I know... I just didn't want to be alone in my head."
    annette "Eu sei... eu só não queria ficar sozinha com meus pensamentos."

# game/script2.rpy:2850
translate pt_br_anubisbr scene47_annette2_29401cae:

#   mc "You're not weird. Just... different. In a good way."
    mc "Você não é estranho(a). Apenas... diferente. No bom sentido."

# game/script2.rpy:2852
translate pt_br_anubisbr scene47_annette2_b4f429d8:

#   annette "You really think so?"
    annette "Você realmente acha isso?"

# game/script2.rpy:2854
translate pt_br_anubisbr scene47_annette2_5ce09775:

#   mc "Mhm."
    mc "Hum."

# game/script2.rpy:2856
translate pt_br_anubisbr scene47_annette2_8be99f74:

#   annette "And if something bad happened... Would you protect me?"
    annette "E se algo de ruim acontecesse... Você me protegeria?"

# game/script2.rpy:2858
translate pt_br_anubisbr scene47_annette2_dc76a3ff:

#   mc "From who? The villagers?"
    mc "De quem? Dos aldeões?"

# game/script2.rpy:2860
translate pt_br_anubisbr scene47_annette2_9dfeaa0c:

#   annette "No. They would never dare to... Just protecting me from anyone who tries to harm me."
    annette "Não. Eles jamais ousariam... Só estão me protegendo de quem tentar me fazer mal."

# game/script2.rpy:2865
translate pt_br_anubisbr scene47_choice02_op1_2994a5be:

#   mc "Honestly? I'd turn around a hundred and eighty degrees and run."
    mc "Sinceramente? Eu daria meia-volta cento e oitenta graus e sairia correndo."

# game/script2.rpy:2867
translate pt_br_anubisbr scene47_choice02_op1_c0146252:

#   annette "A hundred and eighty degrees? Doesn't that mean you'd run right back at the danger?"
    annette "Cento e oitenta graus? Isso não significa que você fugiria correndo de volta para o perigo?"

# game/script2.rpy:2869
translate pt_br_anubisbr scene47_choice02_op1_0f82aebb:

#   mc "Oh... right."
    mc "Ah... certo."

# game/script2.rpy:2871
translate pt_br_anubisbr scene47_choice02_op1_ef2e535c:

#   annette "*laughs* You're funny... but that's not very reassuring..."
    annette "*risos* Você é engraçado... mas isso não é muito tranquilizador..."

# game/script2.rpy:2876
translate pt_br_anubisbr scene47_choice02_op2_fab61f3c:

#   mc "I mean... depends on what you did."
    mc "Quer dizer... depende do que você fez."

# game/script2.rpy:2878
translate pt_br_anubisbr scene47_choice02_op2_24cb169f:

#   annette "*giggle* I guess that's fair..."
    annette "*risos* Acho que é justo..."

# game/script2.rpy:2883
translate pt_br_anubisbr scene47_choice02_op3_eacd5b97:

#   mc "Of course. I wouldn't let anyone touch you."
    mc "Claro. Eu não deixaria ninguém te tocar."

# game/script2.rpy:2885
translate pt_br_anubisbr scene47_choice02_op3_0996e6a8:

#   annette "That makes me feel... really safe."
    annette "Isso me faz sentir... realmente segura."

# game/script2.rpy:2890
translate pt_br_anubisbr scene47_annette3_6b21e159:

#   mc "Do you have a {i}something bad{/i} in mind?"
    mc "Você tem um {i} algo ruim{/i} Em mente?"

# game/script2.rpy:2892
translate pt_br_anubisbr scene47_annette3_eb1ed7d6:

#   annette "*nod* A while ago, a group of goblins settled near our village."
    annette "*aceno com a cabeça* Há algum tempo, um grupo de goblins se instalou perto da nossa aldeia."

# game/script2.rpy:2894
translate pt_br_anubisbr scene47_annette3_f37bd3c5:

#   mc "Goblins?"
    mc "Goblins?"

# game/script2.rpy:2895
translate pt_br_anubisbr scene47_annette3_1ebc1b82:

#   annette "Yes. Sometimes they'd come and steal livestock... they took Erie from me."
    annette "Sim. Às vezes eles vinham e roubavam o gado... eles tomaram Erie de mim."

# game/script2.rpy:2896
translate pt_br_anubisbr scene47_annette3_eb3ec642:

#   mc "Erie? Is that... your sister?"
    mc "Erie? Essa é... sua irmã?"

# game/script2.rpy:2897
translate pt_br_anubisbr scene47_annette3_364c47a4:

#   annette "No... my favorite chicken. I raised her from a tiny fluffball."
    annette "Não... minha galinha favorita. Eu a criei desde que era uma bolinha de penugem minúscula."

# game/script2.rpy:2898
translate pt_br_anubisbr scene47_annette3_af7b04e8:

#   mc "Ah... I'm sorry to hear that."
    mc "Ah... Sinto muito por isso."

# game/script2.rpy:2899
translate pt_br_anubisbr scene47_annette3_b7ef50ed:

#   mc "Did the goblins ever come back?"
    mc "Os goblins chegaram a voltar?"

# game/script2.rpy:2900
translate pt_br_anubisbr scene47_annette3_bdfbe3f7:

#   annette "No. Agi and Aldwin found their camp and burned it down. After that, they left."
    annette "Não. Agi e Aldwin encontraram o acampamento deles e o incendiaram. Depois disso, eles foram embora."

# game/script2.rpy:2902
translate pt_br_anubisbr scene47_annette3_8a1ea375:

#   mc "Good. Sounds like they did right by you."
    mc "Ótimo. Parece que eles agiram corretamente com você."

# game/script2.rpy:2904
translate pt_br_anubisbr scene47_annette3_59cffb7c:

#   annette "I just... don't want to feel helpless again. It's a horrible feeling."
    annette "Eu só... não quero me sentir impotente de novo. É uma sensação horrível."

# game/script2.rpy:2906
translate pt_br_anubisbr scene47_annette3_cfcc2293:

#   mc "I know."
    mc "Eu sei."

# game/script2.rpy:2908
translate pt_br_anubisbr scene47_annette3_160f8350:

#   annette "Alright, I think we're almost done here."
    annette "Muito bem, acho que já estamos quase terminando."

# game/script2.rpy:2910
translate pt_br_anubisbr scene47_annette3_2689b56d:

#   mc "That's it?"
    mc "É isso?"

# game/script2.rpy:2912
translate pt_br_anubisbr scene47_annette3_c3b2ae2e:

#   annette "Well... Maybe one last question."
    annette "Bem... talvez uma última pergunta."

# game/script2.rpy:2914
translate pt_br_anubisbr scene47_annette3_f3b5e8c4:

#   mc "Alright, what is it?"
    mc "Certo, o que é isso?"

# game/script2.rpy:2916
translate pt_br_anubisbr scene47_annette3_4a48b52c:

#   annette "After we... um... m-mate... What would you do?"
    annette "Depois que nós... hum... m-cara... O que você faria?"

# game/script2.rpy:2921
translate pt_br_anubisbr scene47_choice03_op1_dbcd23a7:

#   mc "Go for a second round, obviously."
    mc "Obviamente, vamos para uma segunda rodada."

# game/script2.rpy:2923
translate pt_br_anubisbr scene47_choice03_op1_943dd6ae:

#   annette "Y-You're insatiable..."
    annette "Você é insaciável..."

# game/script2.rpy:2928
translate pt_br_anubisbr scene47_choice03_op2_4db8ca95:

#   mc "I'd love to cuddle once we're done. Let you sleep on my chest while I hug you."
    mc "Eu adoraria te abraçar quando terminarmos. Deixar você dormir no meu peito enquanto eu te abraço."

# game/script2.rpy:2930
translate pt_br_anubisbr scene47_choice03_op2_3b5d1761:

#   annette "That sounds... really nice."
    annette "Isso parece... muito bom."

# game/script2.rpy:2935
translate pt_br_anubisbr scene47_choice03_op3_79060687:

#   mc "Say thanks. Then probably knock out immediately."
    mc "Agradeça. E provavelmente apague imediatamente."

# game/script2.rpy:2937
translate pt_br_anubisbr scene47_choice03_op3_2a95e459:

#   annette "*laughs* I guess that's honest."
    annette "*risos* Acho que isso é sincero."

# game/script2.rpy:2938
translate pt_br_anubisbr scene47_choice03_op3_c5d9374d:

#   annette "I assume it takes a great deal of stamina to do... {i}that.{/i}"
    annette "Imagino que seja preciso muita resistência para fazer isso... {i} que.{/i}"

# game/script2.rpy:2940
translate pt_br_anubisbr scene47_choice03_op3_ad31cede:

#   mc "Depends. Do you want me to go slow or fast?"
    mc "Depende. Você quer que eu vá devagar ou rápido?"

# game/script2.rpy:2942
translate pt_br_anubisbr scene47_choice03_op3_7788161e:

#   annette "I-I..."
    annette "II..."

# game/script2.rpy:2946
translate pt_br_anubisbr scene47_annette4_9eaab11c:

#   annette "Actually, [mc]... there's something I should probably tell you."
    annette "Na verdade, [mc]... tem algo que eu provavelmente deveria te contar."

# game/script2.rpy:2948
translate pt_br_anubisbr scene47_annette4_d66c229f:

#   mc "Yeah? What's up?"
    mc "Sim? E aí?"

# game/script2.rpy:2950
translate pt_br_anubisbr scene47_annette4_feec5789:

#   annette "My womb... it's really small. Smaller than normal, they said. It can make things... um... difficult."
    annette "Meu útero... é muito pequeno. Menor que o normal, disseram. Isso pode tornar as coisas... hum... difíceis."

# game/script2.rpy:2952
translate pt_br_anubisbr scene47_annette4_80125f64:

#   mc "Difficult how?"
    mc "Difícil como?"

# game/script2.rpy:2954
translate pt_br_anubisbr scene47_annette4_31e2fec7:

#   annette "It might hurt. Or... not work right. I mean, I want to do this, I do—but I thought you should know."
    annette "Pode doer. Ou... não funcionar direito. Quer dizer, eu quero fazer isso, quero mesmo—mas achei que você deveria saber."

# game/script2.rpy:2956
translate pt_br_anubisbr scene47_annette4_2b35b6fe:

#   mc "..."
    mc "..."

# game/script2.rpy:2962
translate pt_br_anubisbr scene47_choice04_op1_5208bfef:

#   mc "Come here..."
    mc "Venha aqui..."

# game/script2.rpy:2964
translate pt_br_anubisbr scene47_choice04_op1_ea379c13:

#   annette "*gasp* [mc]...?!"
    annette "*suspiro* [mc]...?!"

# game/script2.rpy:2966
translate pt_br_anubisbr scene47_choice04_op1_f5fbe5eb:

#   mc "Thank you for telling me. We'll take it slow. I want this to feel good for you too."
    mc "Obrigada por me contar. Vamos com calma. Quero que você também se sinta bem com isso."

# game/script2.rpy:2968
translate pt_br_anubisbr scene47_choice04_op1_fe100c5e:

#   annette "O-Okay... That means a lot to me."
    annette "O-Okay... Isso significa muito para mim."

# game/script2.rpy:2970
translate pt_br_anubisbr scene47_choice04_op1_a986e4ab:

#   empathy "Her heartbeat thuds through her ribs—nervous, but trusting."
    empathy "Seu coração bate forte nas costelas — nervoso, mas confiante."

# game/script2.rpy:2977
translate pt_br_anubisbr scene47_choice04_op2_c38ea7a8:

#   mc "Then maybe we try... somewhere else instead."
    mc "Então talvez a gente tente... em outro lugar."

# game/script2.rpy:2979
translate pt_br_anubisbr scene47_choice04_op2_5e1d666a:

#   annette "Somewhere else?"
    annette "Em outro lugar?"

# game/script2.rpy:2981
translate pt_br_anubisbr scene47_choice04_op2_07fede17:

#   mc "Yeah. You've got a second hole, don't you?"
    mc "Sim. Você tem um segundo buraco, não é?"

# game/script2.rpy:2983
translate pt_br_anubisbr scene47_choice04_op2_9af146b5:

#   annette "I—! T-That's... y-you—"
    annette "Eu—! I-Isso é... v-você—"

# game/script2.rpy:2984
translate pt_br_anubisbr scene47_choice04_op2_be42b7c3:

#   annette "If that's what you want... I'll try. Just... be gentle."
    annette "Se é isso que você quer... eu tentarei. Só... seja gentil."

# game/script2.rpy:2986
translate pt_br_anubisbr scene47_choice04_op2_596b4c4a:

#   mc "We'll see."
    mc "Veremos."

# game/script2.rpy:2990
translate pt_br_anubisbr scene47_annette5_830c9039:

#   mc "By the way... what's that smell?"
    mc "A propósito... que cheiro é esse?"

# game/script2.rpy:2992
translate pt_br_anubisbr scene47_annette5_5ad6effe:

#   annette "Smell? Which flower are you talking about?"
    annette "Cheiro? De que flor você está falando?"

# game/script2.rpy:2994
translate pt_br_anubisbr scene47_annette5_05970dde:

#   mc "It's... It's coming from you actually."
    mc "É... Na verdade, está vindo de você."

# game/script2.rpy:2996
translate pt_br_anubisbr scene47_annette5_e74577b6:

#   annette "Oh! That's me—um, my vagina."
    annette "Ah! Essa sou eu... hum, minha vagina."

# game/script2.rpy:2998
translate pt_br_anubisbr scene47_annette5_3f9df27f:

#   mc "...What?"
    mc "...O que?"

# game/script2.rpy:3000
translate pt_br_anubisbr scene47_annette5_92770ff3:

#   annette "I didn't wash it. Mother Ysella said the natural scent—my pheromones—might attract you more."
    annette "Eu não lavei. Madre Ysella disse que o cheiro natural — meus feromônios — poderia te atrair mais."

# game/script2.rpy:3007
translate pt_br_anubisbr scene47_choice05_op1_b715c1ad:

#   mc "I think you should... take a shower first."
    mc "Acho que você deveria... tomar um banho primeiro."

# game/script2.rpy:3009
translate pt_br_anubisbr scene47_choice05_op1_6beb359c:

#   annette "Huh? Do I not smell nice, [mc]?"
    annette "Hein? Eu não cheiro bem? [mc]?"

# game/script2.rpy:3011
translate pt_br_anubisbr scene47_choice05_op1_08db0d71:

#   mc "You really don't."
    mc "Na verdade, não."

# game/script2.rpy:3013
translate pt_br_anubisbr scene47_choice05_op1_a0859c82:

#   annette "I-I see... I'll go clean myself right away. Please wait for me!"
    annette "Entendi... Vou me limpar agora mesmo. Por favor, espere por mim!"

# game/script2.rpy:3019
translate pt_br_anubisbr scene47_choice05_op2_6341b0a6:

#   mc "I like it. Don't wash."
    mc "Gostei. Não lave."

# game/script2.rpy:3021
translate pt_br_anubisbr scene47_choice05_op2_74f1cc94:

#   annette "Hehe~ As you wish."
    annette "Hehe~ Como desejar."

# game/script2.rpy:3027
translate pt_br_anubisbr scene47_annette6_21fa0273:

#   annette "I guess we're done here."
    annette "Acho que terminamos por aqui."

# game/script2.rpy:3029
translate pt_br_anubisbr scene47_annette6_7cd37670:

#   mc "How did I do?"
    mc "Como me saí?"

# game/script2.rpy:3032
translate pt_br_anubisbr scene47_annette6_ca08b1e8:

#   annette "You're... really sweet, [mc]."
    annette "Você é... muito gentil, [mc]."

# game/script2.rpy:3033
translate pt_br_anubisbr scene47_annette6_01ee3282:

#   annette "You listened... you didn't laugh at my condition... You even made me feel a little brave."
    annette "Você me ouviu... você não riu da minha situação... Você até me fez sentir um pouco corajoso."

# game/script2.rpy:3034
translate pt_br_anubisbr scene47_annette6_4f07c31e:

#   annette "I'm really happy it's you. I mean that."
    annette "Estou muito feliz que seja você. E digo isso de coração."

# game/script2.rpy:3036
translate pt_br_anubisbr scene47_annette6_2bda79a4:

#   mc "I'm glad."
    mc "Estou feliz."

# game/script2.rpy:3039
translate pt_br_anubisbr scene47_annette6_1f42bf77:

#   annette "I was a little nervous... but I feel okay now."
    annette "Eu estava um pouco nervosa... mas agora me sinto bem."

# game/script2.rpy:3040
translate pt_br_anubisbr scene47_annette6_7b4814b6:

#   annette "You didn't say all the right things, but... you didn't scare me off either."
    annette "Você não disse tudo o que eu queria ouvir, mas... também não me assustou."

# game/script2.rpy:3041
translate pt_br_anubisbr scene47_annette6_ccbcdd46:

#   annette "That's already more than I hoped for."
    annette "Isso já é mais do que eu esperava."

# game/script2.rpy:3043
translate pt_br_anubisbr scene47_annette6_cc853455:

#   mc "Glad I passed... sorta."
    mc "Ainda bem que passei... mais ou menos."

# game/script2.rpy:3046
translate pt_br_anubisbr scene47_annette6_ebe0fc70:

#   annette "Even if you teased me a little..."
    annette "Mesmo que você tenha me provocado um pouco..."

# game/script2.rpy:3047
translate pt_br_anubisbr scene47_annette6_98e9e57c:

#   annette "I still want it to be you."
    annette "Eu ainda quero que seja você."

# game/script2.rpy:3048
translate pt_br_anubisbr scene47_annette6_dcedce27:

#   annette "Maybe I'm silly... but I trust you."
    annette "Talvez eu seja boba... mas confio em você."

# game/script2.rpy:3050
translate pt_br_anubisbr scene47_annette6_414e5dd9:

#   mc "You're not silly. Not at all."
    mc "Você não é bobo(a). De jeito nenhum."

# game/script2.rpy:3053
translate pt_br_anubisbr scene47_annette6_d5c103aa:

#   mc "Wait for you at the cabin then?"
    mc "Então vou te esperar na cabine?"

