# game/script2.rpy:5805
translate pt_br_anubisbr scene54_6eb2f00b:

#   mc "The Queen? Alright... I'm coming."
    mc "A Rainha? Certo... Estou indo."

# game/script2.rpy:5806
translate pt_br_anubisbr scene54_0bfb8eaa:

#   m "Is something wrong, [mx]?"
    m "Há algo errado? [mx]?"

# game/script2.rpy:5807
translate pt_br_anubisbr scene54_a64eba83:

#   mc "Hopefully not. Stay here. I'll be back soon."
    mc "Espero que não. Fique aqui. Já volto."

# game/script2.rpy:5808
translate pt_br_anubisbr scene54_12c486fc:

#   m "As you wish..."
    m "Como desejar..."

# game/script2.rpy:5810
translate pt_br_anubisbr scene54_caf3b667:

#   mc "*yawn* Hmm?"
    mc "*bocejo* Hum?"

# game/script2.rpy:5812
translate pt_br_anubisbr scene54_67beab3a:

#   mc "Someone there?"
    mc "Tem alguém aí?"

# game/script2.rpy:5817
translate pt_br_anubisbr scene54_f5a9e88c:

#   perception "You step into the grand courtroom. Tension crackles in the air. The Queen sits tall upon her throne, her eyes locked on a man standing below—cloaked in foreign colors. A handful of guards watch silently."
    perception "Você entra no imponente salão do tribunal. A tensão é palpável no ar. A Rainha senta-se imponente em seu trono, com os olhos fixos em um homem de pé abaixo dela — envolto em vestes de cores estrangeiras. Um pequeno grupo de guardas observa em silêncio."

# game/script2.rpy:5819
translate pt_br_anubisbr scene54_00ae7812:

#   amb "Someone must answer for this— now!"
    amb "Alguém precisa responder por isso — agora!"

# game/script2.rpy:5821
translate pt_br_anubisbr scene54_58af426e:

#   q "I understand your frustration, Ambassador, but you will mind your tone in {i}my{/i} throne room."
    q "Compreendo sua frustração, Embaixador, mas peço que modere seu tom. {i} meu{/i} sala do trono."

# game/script2.rpy:5822
translate pt_br_anubisbr scene54_8da9c295:

#   q "[mc]. Approach."
    q "[mc]. Abordagem."

# game/script2.rpy:5823
translate pt_br_anubisbr scene54_2b35b6fe:

#   mc "..."
    mc "..."

# game/script2.rpy:5825
translate pt_br_anubisbr scene54_383f2774:

#   mc "Yes, Your Majesty?"
    mc "Sim, Vossa Majestade?"

# game/script2.rpy:5827
translate pt_br_anubisbr scene54_44fa962f:

#   q "A terrible incident has taken place, [mc]. The manor of the Queen of pleasure has been burned to the ground. Many lives were lost."
    q "Ocorreu um incidente terrível. [mc] A mansão da Rainha do Prazer foi completamente destruída por um incêndio. Muitas vidas foram perdidas."

# game/script2.rpy:5829
translate pt_br_anubisbr scene54_e39b556c:

#   mc "That's... tragic. But forgive me, I don't see how this involves your kingdom directly?"
    mc "Isso é... trágico. Mas me perdoe, não vejo como isso envolve diretamente o seu reino?"

# game/script2.rpy:5831
translate pt_br_anubisbr scene54_4f63b91e:

#   q "It seems she was under the protection of our neighbors in Nahraya."
    q "Parece que ela estava sob a proteção de nossos vizinhos em Nahraya."

# game/script2.rpy:5833
translate pt_br_anubisbr scene54_4449c3bb:

#   amb "Am I invisible here, Your Majesty?! Must I stand idly while you whisper amongst yourselves?"
    amb "Sou invisível aqui, Vossa Majestade?! Devo ficar aqui parada enquanto vocês cochicham entre si?"

# game/script2.rpy:5835
translate pt_br_anubisbr scene54_6f330aeb:

#   amb "I shall reiterate—King Hod is enraged beyond words!"
    amb "Vou reiterar: o Rei Hod está furioso além das palavras!"

# game/script2.rpy:5837
translate pt_br_anubisbr scene54_f279fa7e:

#   q "I will address this, Ambassador. I have already taken action against those involved."
    q "Vou tratar disso, Embaixador. Já tomei medidas contra os envolvidos."

# game/script2.rpy:5839
translate pt_br_anubisbr scene54_93d1ff16:

#   amb "That will not suffice! The King demands their heads delivered to him on horseback!"
    amb "Isso não basta! O Rei exige que suas cabeças lhe sejam entregues a cavalo!"

# game/script2.rpy:5841
translate pt_br_anubisbr scene54_8feac360:

#   q "Silence! You do not command me. I have stated my position. Inform your king that I am handling it. Let him keep his patience—for both our sakes."
    q "Silêncio! Você não me dá ordens. Já expressei minha posição. Informe ao seu rei que estou cuidando disso. Que ele tenha paciência — para o bem de ambos."

# game/script2.rpy:5843
translate pt_br_anubisbr scene54_46c0ac28:

#   amb "Your Majesty, neither I nor my king wish for any conflict. But you know his temper well."
    amb "Majestade, nem eu nem o meu rei desejamos qualquer conflito. Mas a senhora conhece bem o temperamento dele."

# game/script2.rpy:5845
translate pt_br_anubisbr scene54_2e8d3ece:

#   q "Grant me time. I will resolve this, personally."
    q "Me dê um tempo. Eu mesmo resolverei isso."

# game/script2.rpy:5847
translate pt_br_anubisbr scene54_1a7ad8a2:

#   amb "Why do you protect the identities of these criminals? Reveal them and we end this {i}now.{/i}"
    amb "Por que vocês protegem a identidade desses criminosos? Revele-as e acabaremos com isso. {i} agora.{/i}"

# game/script2.rpy:5849
translate pt_br_anubisbr scene54_67ab756e:

#   q "It is not so simple. And I will not repeat myself. You may take your leave, Ambassador. I appreciate your visit."
    q "Não é tão simples. E não vou me repetir. Pode se retirar, Embaixador. Agradeço sua visita."

# game/script2.rpy:5851
translate pt_br_anubisbr scene54_02348376:

#   amb "We are watching, Your Majesty."
    amb "Estamos observando, Vossa Majestade."

# game/script2.rpy:5853
translate pt_br_anubisbr scene54_cb50914f:

#   q "*sigh* Just when I thought fortune had finally favored us... it all threatens to unravel."
    q "*Suspiro* Justo quando eu pensava que a sorte finalmente estava ao nosso lado... tudo ameaça desmoronar."

# game/script2.rpy:5854
translate pt_br_anubisbr scene54_97054f4c:

#   q "[mc]."
    q "[mc]."

# game/script2.rpy:5858
translate pt_br_anubisbr scene54_09f544f4:

#   q "We have interrogated a mercenary—Kathrine. Darius informed me she returned with you."
    q "Interrogamos uma mercenária, Kathrine. Darius me informou que ela voltou com vocês."

# game/script2.rpy:5860
translate pt_br_anubisbr scene54_69bea1a5:

#   mc "That's-"
    mc "Isso é-"

# game/script2.rpy:5862
translate pt_br_anubisbr scene54_6dfba55b:

#   q "Do {i}not{/i} interrupt me."
    q "Fazer {i} não{/i} me interrompa."

# game/script2.rpy:5866
translate pt_br_anubisbr scene54_9fe12e33:

#   q "She confessed everything. How Lord Reiner coerced her and Gaius into carrying out that massacre."
    q "Ela confessou tudo. Como Lorde Reiner a coagiu, juntamente com Gaius, a realizar aquele massacre."

# game/script2.rpy:5867
translate pt_br_anubisbr scene54_53e858a8:

#   q "You have no idea how relieved I was when she spoke nothing of your involvement, [mc]."
    q "Você não faz ideia do alívio que senti quando ela não mencionou nada sobre o seu envolvimento. [mc]."

# game/script2.rpy:5869
translate pt_br_anubisbr scene54_18b61483:

#   mc "Thank you. And if I may ask... what about Gaius?"
    mc "Obrigado. E se me permite perguntar... e quanto a Gaio?"

# game/script2.rpy:5871
translate pt_br_anubisbr scene54_56da65f1:

#   q "*sigh* As much as I hate to admit it... he's too important right now, [mc]."
    q "*Suspiro* Por mais que eu deteste admitir... ele é muito importante agora. [mc]."

# game/script2.rpy:5873
translate pt_br_anubisbr scene54_add703f5:

#   mc "...Isn't that unfair?"
    mc "...Isso não é injusto?"

# game/script2.rpy:5875
translate pt_br_anubisbr scene54_f334614a:

#   q "Yes. Deeply unfair. But I need his protection more than ever. So for now, he'll get off lightly."
    q "Sim. Profundamente injusto. Mas preciso da proteção dele mais do que nunca. Então, por enquanto, ele vai se safar impunemente."

# game/script2.rpy:5876
translate pt_br_anubisbr scene54_d84eb9c2:

#   q "But only for now. I promise, I'll deal with him when the time is right."
    q "Mas só por agora. Prometo que lidarei com ele quando chegar a hora certa."

# game/script2.rpy:5878
translate pt_br_anubisbr scene54_abb96135:

#   mc "That's good to hear."
    mc "Que bom ouvir isso."

# game/script2.rpy:5880
translate pt_br_anubisbr scene54_2e02d464:

#   q "Regardless, you've continued to prove yourself—far beyond what I ever expected."
    q "Independentemente disso, você continuou a provar o seu valor — muito além do que eu jamais esperava."

# game/script2.rpy:5881
translate pt_br_anubisbr scene54_160335bc:

#   q "As you witnessed—this kingdom teeters on the edge... again. And now, I must depart to confront Reiner directly."
    q "Como vocês testemunharam, este reino está à beira do colapso... novamente. E agora, devo partir para confrontar Reiner pessoalmente."

# game/script2.rpy:5882
translate pt_br_anubisbr scene54_91716b8a:

#   q "We need their resources, yes. But I will not allow this alliance to drag us into war. That price is too high."
    q "Precisamos dos recursos deles, sim. Mas não permitirei que essa aliança nos arraste para a guerra. Esse preço é alto demais."

# game/script2.rpy:5884
translate pt_br_anubisbr scene54_612ac98d:

#   q "Tell me, [mc]. If you were in my place... what would you do?"
    q "Diga-me, [mc] Se você estivesse no meu lugar... o que você faria?"

# game/script2.rpy:5886
translate pt_br_anubisbr scene54_44045f3f:

#   mc "Me? Well..."
    mc "Eu? Bem..."

# game/script2.rpy:5813
translate pt_br_anubisbr scene54_c5e6d17b_1:

#   guard "I apologize for the intrusion, sir. The Queen requests your presence immediately."
    guard "Peço desculpas pela intromissão, senhor. A Rainha solicita sua presença imediatamente."

# game/script2.rpy:5814
translate pt_br_anubisbr scene54_6eb2f00b_1:

#   mc "The Queen? Alright... I'm coming."
    mc "A Rainha? Certo... Estou indo."

# game/script2.rpy:5856
translate pt_br_anubisbr scene54_383f2774_1:

#   mc "Yes, Your Majesty?"
    mc "Sim, Vossa Majestade?"

# game/script2.rpy:5864
translate pt_br_anubisbr scene54_2b35b6fe_1:

#   mc "..."
    mc "..."

# game/script2.rpy:5891
translate pt_br_anubisbr scene54_choice01_op2_cbf2605e:

#   mc "Reiner directly mocked you, Your Majesty. This should not go unanswered."
    mc "Reiner zombou diretamente de Vossa Majestade. Isso não deve ficar sem resposta."

# game/script2.rpy:5892
translate pt_br_anubisbr scene54_choice01_op2_f7b294b0:

#   mc "If I were in your position, I'd march to war."
    mc "Se eu estivesse no seu lugar, marcharia para a guerra."

# game/script2.rpy:5894
translate pt_br_anubisbr scene54_choice01_op2_9e025553:

#   q "*chuckles* You truly have no grasp of the full weight of this, do you, [mc]?"
    q "*risos* Você realmente não tem noção da gravidade disso, não é? [mc]?"

# game/script2.rpy:5895
translate pt_br_anubisbr scene54_choice01_op2_32278fc1:

#   q "Even if we scraped together every able-bodied man, armed peasants with pitchforks and hope... we wouldn't make it to their gates."
    q "Mesmo que reuníssemos todos os homens aptos, camponeses armados com forcados e muita esperança... não conseguiríamos chegar aos portões deles."

# game/script2.rpy:5897
translate pt_br_anubisbr scene54_choice01_op2_a7bcf340:

#   mc "I see..."
    mc "Eu vejo..."

# game/script2.rpy:5902
translate pt_br_anubisbr scene54_choice01_op1_fba2f0af:

#   mc "Like you said yourself—things are fragile enough as they are. A war would break what little remains of this kingdom."
    mc "Como você mesmo disse, as coisas já estão bastante frágeis. Uma guerra destruiria o pouco que resta deste reino."

# game/script2.rpy:5904
translate pt_br_anubisbr scene54_choice01_op1_1f24a6b3:

#   q "Indeed. But sadly, it's never as simple as shaking hands and parting ways."
    q "De fato. Mas, infelizmente, nunca é tão simples quanto apertar as mãos e seguir caminhos diferentes."

# game/script2.rpy:5905
translate pt_br_anubisbr scene54_choice01_op1_a84011d2:

#   q "Reiner's pride. Nahraya's demands. Every path forward is lined with thorns."
    q "O orgulho de Reiner. As exigências de Nahraya. Cada caminho adiante está repleto de espinhos."

# game/script2.rpy:5907
translate pt_br_anubisbr scene54_choice01_op1_3c8b4abe:

#   mc "I trust your judgment, Your Majesty. If anyone can do this, it's you."
    mc "Confio no seu julgamento, Majestade. Se alguém pode fazer isso, é o senhor."

# game/script2.rpy:5909
translate pt_br_anubisbr scene54_choice01_op1_3bd741a9:

#   q "Oh my... careful with such flattery, [mc]. You're raising my expectations of you."
    q "Nossa... cuidado com tantos elogios! [mc] Você está aumentando minhas expectativas em relação a você."

# game/script2.rpy:5914
translate pt_br_anubisbr scene54_choice01_op3_f4d8f3f7:

#   mc "Use Reiner's guilt to your advantage. Control him. Let him serve us even more while he desperately tries to avoid exposure."
    mc "Use a culpa de Reiner a seu favor. Controle-o. Deixe-o nos servir ainda mais enquanto ele tenta desesperadamente evitar ser descoberto."

# game/script2.rpy:5915
translate pt_br_anubisbr scene54_choice01_op3_17b53af9:

#   mc "Placate Nahraya, preserve the alliance, and strengthen your grip."
    mc "Apazigue Nahraya, preserve a aliança e fortaleça seu poder."

# game/script2.rpy:5917
translate pt_br_anubisbr scene54_choice01_op3_830c9f8d:

#   q "Oh? I didn't expect such cunning from you, [mc]. Coerce the coerced, is that it?"
    q "Ah? Não esperava tanta astúcia da sua parte. [mc] Coagir os coagidos, é isso?"

# game/script2.rpy:5918
translate pt_br_anubisbr scene54_choice01_op3_edffb90b:

#   q "You would make quite the ruler someday..."
    q "Você seria um ótimo governante um dia..."

# game/script2.rpy:5920
translate pt_br_anubisbr scene54_choice01_op3_75a25d68:

#   mc "We resolve tensions with Nahraya, and extract even more from Eurina at the same time."
    mc "Resolvemos as tensões com Nahraya e, ao mesmo tempo, conseguimos extrair ainda mais de Eurina."

# game/script2.rpy:5922
translate pt_br_anubisbr scene54_choice01_op3_1c5f9a06:

#   q "Now that... is real power. Sometimes, those who owe you serve far better than those you punish."
    q "Isso sim é poder de verdade. Às vezes, quem te deve um favor é muito melhor do que quem você pune."

# game/script2.rpy:5928
translate pt_br_anubisbr scene54_2_0e2711f6:

#   q "*sigh* I suppose time will tell how this all unfolds."
    q "*Suspiro* Acho que só o tempo dirá como tudo isso vai se desenrolar."

# game/script2.rpy:5929
translate pt_br_anubisbr scene54_2_fc8e9ab1:

#   q "But for now, my course is set. Regarding your position, [mc], I need you here in Irda."
    q "Mas, por agora, meu rumo está definido. Quanto à sua posição, [mc], Preciso de você aqui em Irda."

# game/script2.rpy:5930
translate pt_br_anubisbr scene54_2_a1debaa9:

#   q "I can think of no one better to serve as temporary steward in my absence."
    q "Não consigo pensar em ninguém melhor para servir como administrador temporário na minha ausência."

# game/script2.rpy:5932
translate pt_br_anubisbr scene54_2_d91ea72a:

#   mc "Steward? Your Majesty, that's a big responsibility..."
    mc "Mordomo? Majestade, essa é uma grande responsabilidade..."

# game/script2.rpy:5934
translate pt_br_anubisbr scene54_2_eff3cfa7:

#   q "It is. And one you will bear. But that is not all."
    q "É sim. E você terá que suportar uma. Mas isso não é tudo."

# game/script2.rpy:5935
translate pt_br_anubisbr scene54_2_85fb9171:

#   q "Our discussion yesterday was not mere contemplation. I will be wedding you to my daughter, Rebecca."
    q "Nossa conversa de ontem não foi mera contemplação. Vou celebrar seu casamento com minha filha, Rebecca."

# game/script2.rpy:5937
translate pt_br_anubisbr scene54_2_e70ee604:

#   mc "You... you were actually serious?"
    mc "Você... você estava falando sério mesmo?"

# game/script2.rpy:5939
translate pt_br_anubisbr scene54_2_35ff4b93:

#   q "Yes."
    q "Sim."

# game/script2.rpy:5941
translate pt_br_anubisbr scene54_2_d7204dd1:

#   mc "...Are you sure, Your Majesty? This is... sudden"
    mc "...Tem certeza, Majestade? Isto é... repentino"

# game/script2.rpy:5943
translate pt_br_anubisbr scene54_2_98ab358a:

#   q "I am certain. Trust is a rarer currency than gold, and there are few in this court I trust as I have come to trust you."
    q "Tenho certeza. A confiança é uma moeda mais rara que o ouro, e são poucos neste tribunal em quem confio tanto quanto confio em você."

# game/script2.rpy:5944
translate pt_br_anubisbr scene54_2_0f5ee368:

#   q "Beyond that... she is isolated here. Her personality makes it difficult for her to form connections, and others are often too intimidated or irritated to try."
    q "Além disso... ela está isolada aqui. Sua personalidade dificulta a formação de laços, e os outros muitas vezes se sentem intimidados ou irritados demais para tentar."

# game/script2.rpy:5945
translate pt_br_anubisbr scene54_2_5cf1603c:

#   q "Other than Maia, she barely has anyone else to speak to."
    q "Além de Maia, ela quase não tem mais ninguém com quem conversar."

# game/script2.rpy:5947
translate pt_br_anubisbr scene54_2_38df46df:

#   q "I am not just giving you her hand. I am asking you to be her shield."
    q "Não estou apenas lhe estendendo a mão dela. Estou pedindo que você seja o escudo dela."

# game/script2.rpy:5948
translate pt_br_anubisbr scene54_2_2ba1e61d:

#   q "With Nahrayan spies likely to become more bold in my absence, I need to know she has a man she can rely on. A man who will protect her with his life."
    q "Com a possibilidade de os espiões de Nahrayan se tornarem mais ousados ​​na minha ausência, preciso saber que ela tem um homem em quem possa confiar. Um homem que a protegerá com a própria vida."

# game/script2.rpy:5951
translate pt_br_anubisbr scene54_2_ebb4953d:

#   mc "Thank you, Your Majesty. I... will."
    mc "Obrigado, Vossa Majestade. Eu... irei."

# game/script2.rpy:5953
translate pt_br_anubisbr scene54_2_c58050a8:

#   q "Think nothing of it. Preparations will be made. I will part at dawn."
    q "Não se preocupe. Os preparativos serão feitos. Partirei ao amanhecer."

# game/script2.rpy:5955
translate pt_br_anubisbr scene54_2_ae304bb5:

#   mc "Who will oversee Irda while you're gone?"
    mc "Quem ficará responsável por Irda enquanto você estiver fora?"

# game/script2.rpy:5957
translate pt_br_anubisbr scene54_2_274feb01:

#   q "My younger sister, Avery. You have yet to meet her, I believe."
    q "Minha irmã mais nova, Avery. Acho que você ainda não a conheceu."

# game/script2.rpy:5959
translate pt_br_anubisbr scene54_2_77820249:

#   mc "You have a sister?"
    mc "Você tem uma irmã?"

# game/script2.rpy:5961
translate pt_br_anubisbr scene54_2_a4bebc2c:

#   q "The most capable in Irda. Behind me of course."
    q "A mais competente em Irda. Atrás de mim, claro."

# game/script2.rpy:5962
translate pt_br_anubisbr scene54_2_6e250b90:

#   q "You'll work with her closely."
    q "Você trabalhará em estreita colaboração com ela."

# game/script2.rpy:5964
translate pt_br_anubisbr scene54_2_83495ed0:

#   mc "I understand."
    mc "Eu entendo."

# game/script2.rpy:5966
translate pt_br_anubisbr scene54_2_ad249b4a:

#   q "I will handle the marriage contracts. In the meantime, visit Rebecca in her quarters. I already talked to her about you but speak with her. Reassure her."
    q "Eu cuidarei dos contratos de casamento. Enquanto isso, visite Rebecca em seus aposentos. Já conversei com ela sobre você, mas fale com ela. Tranquilize-a."

# game/script2.rpy:5968
translate pt_br_anubisbr scene54_2_d62e9113:

#   q "But, [mc]... do not lie with her yet."
    q "Mas, [mc]... não se deite com ela ainda."

# game/script2.rpy:5970
translate pt_br_anubisbr scene54_2_cc279de1:

#   mc "May I ask why, Your Majesty?"
    mc "Posso perguntar porquê, Vossa Majestade?"

# game/script2.rpy:5972
translate pt_br_anubisbr scene54_2_8828cd75:

#   q "What would the people say if they saw their future princess with child before the wedding? No, [mc], we must make this union public first, properly."
    q "O que as pessoas diriam se vissem sua futura princesa grávida antes do casamento? Não, [mc] Primeiro, precisamos tornar essa união pública, da maneira correta."

# game/script2.rpy:5973
translate pt_br_anubisbr scene54_2_de96f143:

#   q "Once it is done, you'll have my blessing in full."
    q "Assim que estiver concluído, você terá minha total bênção."

# game/script2.rpy:5975
translate pt_br_anubisbr scene54_2_a8c12b6b:

#   mc "As you wish, Your Majesty."
    mc "Como desejar, Vossa Majestade."

# game/script2.rpy:5978
translate pt_br_anubisbr scene54_2_2d1d54ac:

#   "*knock* *knock*"
    "*toc toc*"

# game/script2.rpy:5980
translate pt_br_anubisbr scene54_2_29ac18fd:

#   r "What? Who is it?"
    r "O quê? Quem é?"

# game/script2.rpy:5981
translate pt_br_anubisbr scene54_2_4cf00179:

#   mc "Rebecca, it's me. [mc]."
    mc "Rebecca, sou eu. [mc]."

# game/script2.rpy:5982
translate pt_br_anubisbr scene54_2_d4fcb187:

#   r "What do you want?"
    r "O que você quer?"

# game/script2.rpy:5983
translate pt_br_anubisbr scene54_2_8f8b661a:

#   mc "Could you open the door? It's hard to talk through solid wood."
    mc "Você poderia abrir a porta? É difícil falar através de madeira maciça."

# game/script2.rpy:5984
translate pt_br_anubisbr scene54_2_b7cf5ee0:

#   r "Why should I? State your business."
    r "Por que eu deveria? Descreva o seu negócio."

# game/script2.rpy:5985
translate pt_br_anubisbr scene54_2_af698f75:

#   mc "Please..."
    mc "Por favor..."

# game/script2.rpy:5987
translate pt_br_anubisbr scene54_2_9c667ce5:

#   r "Well?"
    r "Bem?"

# game/script2.rpy:5989
translate pt_br_anubisbr scene54_2_885c402a:

#   mc "Hey. Your mo... *ahem* Her Majesty, she—"
    mc "Ei. Sua mãe... *cof cof* Sua Majestade, ela—"

# game/script2.rpy:5991
translate pt_br_anubisbr scene54_2_636df02d:

#   r "I know. She told me."
    r "Eu sei. Ela me contou."

# game/script2.rpy:5993
translate pt_br_anubisbr scene54_2_21f90331:

#   mc "Great! So..."
    mc "Ótimo! Então..."

# game/script2.rpy:5994
translate pt_br_anubisbr scene54_2_b9b755e5:

#   r "..."
    r "..."

# game/script2.rpy:5995
translate pt_br_anubisbr scene54_2_1a5b0212:

#   mc "May I come in?"
    mc "Posso entrar?"

# game/script2.rpy:5998
translate pt_br_anubisbr scene54_2_bc18cb52:

#   r "Can you?"
    r "Você pode?"

# game/script2.rpy:6000
translate pt_br_anubisbr scene54_2_2b35b6fe:

#   mc "..."
    mc "..."

# game/script2.rpy:6002
translate pt_br_anubisbr scene54_2_bb97dd3c:

#   r "*sigh* ...Fine. Just... come in."
    r "*suspiro* ...Tudo bem. Só... entre."

# game/script2.rpy:6018
translate pt_br_anubisbr scene54_2_f8706107:

#   r "Come on, you weirdo."
    r "Vamos lá, seu esquisito."

# game/script2.rpy:6020
translate pt_br_anubisbr scene54_2_92a2c39d:

#   mc "Weirdo?"
    mc "Esquisito?"

# game/script2.rpy:6022
translate pt_br_anubisbr scene54_2_98729858:

#   r "You kissed my foot, remember?"
    r "Você beijou meu pé, lembra?"

# game/script2.rpy:6024
translate pt_br_anubisbr scene54_2_23b3a667:

#   mc "Ah, right..."
    mc "Ah, certo..."

# game/script2.rpy:6029
translate pt_br_anubisbr scene54_2_49e3c717:

#   r "You refused my request last time. Why should I let you in now?"
    r "Você recusou meu pedido da última vez. Por que eu deveria deixar você entrar agora?"

# game/script2.rpy:6031
translate pt_br_anubisbr scene54_2_46f149cb:

#   mc "Are you still holding onto that?"
    mc "Você ainda está se apegando a isso?"

# game/script2.rpy:6033
translate pt_br_anubisbr scene54_2_a25f1691:

#   r "I am."
    r "Eu sou."

# game/script2.rpy:6035
translate pt_br_anubisbr scene54_2_2e32696f:

#   mc "But you said we were friends... *sigh* Is there anything I can do that... doesn't involve me kissing your foot?"
    mc "Mas você disse que éramos amigos... *suspiro* Tem alguma coisa que eu possa fazer que... não envolva beijar seu pé?"

# game/script2.rpy:6037
translate pt_br_anubisbr scene54_2_c46fdadc:

#   r "*sigh* Times have changed, so... here."
    r "*suspiro* Os tempos mudaram, então... aqui está."

# game/script2.rpy:6039
translate pt_br_anubisbr scene54_2_e17279cd:

#   mc "Alright! This is much more reasonable."
    mc "Muito bem! Isso é bem mais razoável."

# game/script2.rpy:6008
translate pt_br_anubisbr scene54_2_bc18cb52_1:

#   r "Can you?"
    r "Você pode?"

# game/script2.rpy:6010
translate pt_br_anubisbr scene54_2_2b35b6fe_1:

#   mc "..."
    mc "..."

# game/script2.rpy:6012
translate pt_br_anubisbr scene54_2_bb97dd3c_1:

#   r "*sigh* ...Fine. Just... come in."
    r "*suspiro* ...Tudo bem. Só... entre."

# game/script2.rpy:6044
translate pt_br_anubisbr scene54_choice00_op2_c324d659:

#   mc "I'll protect her. I'll be her ally or friend. But... I don't want to marry her."
    mc "Eu a protegerei. Serei seu aliado ou amigo. Mas... eu não quero me casar com ela."

# game/script2.rpy:6046
translate pt_br_anubisbr scene54_choice00_op2_910333bb:

#   q "You don't? The princess of Irda. The second heir to the throne. And you refuse her hand?"
    q "Você não aceita? A princesa de Irda. A segunda herdeira do trono. E você recusa a mão dela em casamento?"

# game/script2.rpy:6048
translate pt_br_anubisbr scene54_choice00_op2_085f8817:

#   mc "I don't refuse {i}her{/i}. I refuse the marriage."
    mc "Eu não me recuso {i} dela{/i}Eu recuso o casamento."

# game/script2.rpy:6049
translate pt_br_anubisbr scene54_choice00_op2_4414e65a:

#   mc "I can protect her without a ring on her finger. I can love her without some contract binding us together. At least... I think I can."
    mc "Posso protegê-la sem um anel no dedo. Posso amá-la sem nenhum contrato que nos prenda. Pelo menos... acho que posso."

# game/script2.rpy:6051
translate pt_br_anubisbr scene54_choice00_op2_a2c26044:

#   q "Hmm... It's true that the weight of a crown has a way of turning love into obligation."
    q "Hum... É verdade que o peso de uma coroa tem o poder de transformar o amor em obrigação."

# game/script2.rpy:6052
translate pt_br_anubisbr scene54_choice00_op2_a7fbfb97:

#   q "I wanted something different for her, but if you can't give her that, then I won't force it."
    q "Eu queria algo diferente para ela, mas se você não pode dar isso a ela, então não vou forçar."

# game/script2.rpy:6054
translate pt_br_anubisbr scene54_choice00_op2_a3263ee6:

#   q "But your loyalty and protection are still expected, [mc]. Can you promise me that, at least?"
    q "Mas sua lealdade e proteção ainda são esperadas. [mc] Você pode me prometer isso, pelo menos?"

# game/script2.rpy:6056
translate pt_br_anubisbr scene54_choice00_op2_c3d4d230:

#   mc "I can. I'll keep her safe."
    mc "Posso. Vou protegê-la."

# game/script2.rpy:6058
translate pt_br_anubisbr scene54_choice00_op2_b19657b4:

#   q "Then that will have to be enough. For now."
    q "Então isso terá que ser suficiente. Por enquanto."

# game/script2.rpy:6059
translate pt_br_anubisbr scene54_choice00_op2_9cace83c:

#   q "You may return to your room."
    q "Você pode retornar ao seu quarto."

# game/script2.rpy:6066
translate pt_br_anubisbr scene54_choice00_op3_14b83832:

#   mc "Can I just have a coin reward instead?"
    mc "Posso receber apenas moedas como recompensa?"

# game/script2.rpy:6068
translate pt_br_anubisbr scene54_choice00_op3_0d323725:

#   q "Hm? What's wrong, [mc]? I'm wedding you to my daughter—the princess of Irda, the second heir to my throne, and you're asking for coin?"
    q "Hum? O que houve? [mc] — Estou te casando com a minha filha — a princesa de Irda, a segunda herdeira do meu trono — e você está pedindo dinheiro?"

# game/script2.rpy:6070
translate pt_br_anubisbr scene54_choice00_op3_6b029960:

#   mc "I am. Don't get me wrong, I appreciate the... offer. But I don't want anything to do with that girl."
    mc "Sim, eu sou. Não me entenda mal, eu agradeço a... oferta. Mas não quero ter nada a ver com aquela garota."

# game/script2.rpy:6072
translate pt_br_anubisbr scene54_choice00_op3_01225bab:

#   q "{i}'That girl'{/i}. You speak of my daughter as if she were a burden... I see."
    q "{i}'Aquela garota'{/i}Você fala da minha filha como se ela fosse um fardo... Entendo."

# game/script2.rpy:6073
translate pt_br_anubisbr scene54_choice00_op3_917b1125:

#   q "Return to your room, [mc]. This conversation is over."
    q "Volte para o seu quarto, [mc] Esta conversa terminou."

# game/script2.rpy:6075
translate pt_br_anubisbr scene54_choice00_op3_8a0c7772:

#   mc "Huh? What about my reward?"
    mc "Hein? E a minha recompensa?"

# game/script2.rpy:6077
translate pt_br_anubisbr scene54_choice00_op3_9758f6d2:

#   q "You won't be receiving any reward. Neither coin nor my daughter's hand. Perhaps someone out there is more deserving of this gratitude."
    q "Você não receberá nenhuma recompensa. Nem moedas, nem a mão da minha filha. Talvez alguém por aí mereça mais essa gratidão."

# game/script2.rpy:6078
translate pt_br_anubisbr scene54_choice00_op3_0c88a73f:

#   q "You will remain steward for now. I won't strip you of your duties, but we will talk more about your disobedience once I return."
    q "Por enquanto, você continuará sendo o mordomo. Não vou destituí-lo de suas funções, mas conversaremos mais sobre sua desobediência quando eu retornar."

# game/script2.rpy:6079
translate pt_br_anubisbr scene54_choice00_op3_5efedcb0:

#   q "You may leave. I have nothing more to say to you."
    q "Pode ir. Não tenho mais nada a lhe dizer."

# game/script2.rpy:6081
translate pt_br_anubisbr scene54_choice00_op3_2b35b6fe:

#   mc "..."
    mc "..."

# game/script2.rpy:6089
translate pt_br_anubisbr scene54_choice02_op1_0ae9bcd0:

#   ""
    ""

# game/script2.rpy:6091
translate pt_br_anubisbr scene54_choice02_op1_d11cb88b:

#   mc "Are we good?"
    mc "Estamos bem?"

# game/script2.rpy:6093
translate pt_br_anubisbr scene54_choice02_op1_5d215e18:

#   r "For now."
    r "Por agora."

# game/script2.rpy:6095
translate pt_br_anubisbr scene54_choice02_op1_1a5b0212:

#   mc "May I come in?"
    mc "Posso entrar?"

# game/script2.rpy:6097
translate pt_br_anubisbr scene54_choice02_op1_ff3b95b1:

#   r "Yes, fine."
    r "Sim, tudo bem."

# game/script2.rpy:6108
translate pt_br_anubisbr scene54_choice02_op2_734cfc59:

#   mc "Princess."
    mc "Princesa."

# game/script2.rpy:6109
translate pt_br_anubisbr scene54_choice02_op2_2f1fbf70:

#   r "*gasp*"
    r "*suspiro*"

# game/script2.rpy:6111
translate pt_br_anubisbr scene54_choice02_op2_4fe10d23:

#   r "Oh... Well... That was unexpected."
    r "Ah... Bem... Isso foi inesperado."

# game/script2.rpy:6113
translate pt_br_anubisbr scene54_choice02_op2_1a5b0212:

#   mc "May I come in?"
    mc "Posso entrar?"

# game/script2.rpy:6115
translate pt_br_anubisbr scene54_choice02_op2_90825b44:

#   r "Yes, come in."
    r "Sim, entre."

# game/script2.rpy:6121
translate pt_br_anubisbr scene54_3_7feeeb5e:

#   perception "The room is littered with books. A faint smell of floarl perfume hangs in the air."
    perception "O quarto está repleto de livros. Um leve aroma de perfume floral paira no ar."

# game/script2.rpy:6123
translate pt_br_anubisbr scene54_3_a57632f0:

#   mc "So... How've you been? It's been a while."
    mc "Então... Como você tem passado? Faz tempo que não nos falamos."

# game/script2.rpy:6125
translate pt_br_anubisbr scene54_3_4ed44e88:

#   r "Fine. Nothing's changed since you left."
    r "Ótimo. Nada mudou desde que você foi embora."

# game/script2.rpy:6127
translate pt_br_anubisbr scene54_3_7757ecb1:

#   mc "I expected you to be happier to see me."
    mc "Eu esperava que você ficasse mais feliz em me ver."

# game/script2.rpy:6129
translate pt_br_anubisbr scene54_3_75a1dd9c:

#   r "Why the hell would I? It's not like we're best friends."
    r "Por que diabos eu faria isso? Não é como se fôssemos melhores amigos."

# game/script2.rpy:6131
translate pt_br_anubisbr scene54_3_0880ceb8:

#   mc "We aren't? After everything we've been through, I thought we'd moved a little closer."
    mc "Não estamos? Depois de tudo o que passamos, pensei que tivéssemos nos aproximado um pouco mais."

# game/script2.rpy:6133
translate pt_br_anubisbr scene54_3_6df7e1b8:

#   r "...You did kind of save the kingdom. And you saved that idiot's daughter."
    r "...Você meio que salvou o reino. E salvou a filha daquele idiota."

# game/script2.rpy:6135
translate pt_br_anubisbr scene54_3_fe15e53f:

#   mc "Was that a compliment?"
    mc "Isso foi um elogio?"

# game/script2.rpy:6137
translate pt_br_anubisbr scene54_3_4aabfabd:

#   r "Don't push your luck."
    r "Não abuse da sorte."

# game/script2.rpy:6139
translate pt_br_anubisbr scene54_3_7f7302dc:

#   mc "Rebecca... how do you feel about all of this? The marriage talk. The Queen making decisions for you."
    mc "Rebecca... como você se sente em relação a tudo isso? Essa conversa sobre casamento. A Rainha tomando decisões por você."

# game/script2.rpy:6141
translate pt_br_anubisbr scene54_3_b64a684f:

#   r "...I don't know. I knew I'd eventually be married off to someone... but I thought I'd have more time. More say."
    r "...Não sei. Eu sabia que eventualmente me casaria com alguém... mas pensei que teria mais tempo. Mais voz na minha decisão."

# game/script2.rpy:6143
translate pt_br_anubisbr scene54_3_1cf73851:

#   mc "You should have a say."
    mc "Você deveria ter voz."

# game/script2.rpy:6145
translate pt_br_anubisbr scene54_3_b4287a72:

#   r "Maybe. But this is how it works here. Duty first."
    r "Talvez. Mas é assim que funciona por aqui. O dever vem em primeiro lugar."

# game/script2.rpy:6146
translate pt_br_anubisbr scene54_3_82cd288d:

#   r "...I didn't expect it would be {i}you{/i}, though."
    r "...Eu não esperava que fosse assim. {i} você{/i}, no entanto."

# game/script2.rpy:6148
translate pt_br_anubisbr scene54_3_f8b813e6:

#   mc "Is that a good or bad thing?"
    mc "Isso é bom ou ruim?"

# game/script2.rpy:6150
translate pt_br_anubisbr scene54_3_6a867a5a:

#   r "Hmm... I haven't decided."
    r "Hum... ainda não me decidi."

# game/script2.rpy:6152
translate pt_br_anubisbr scene54_3_a6cdf918:

#   mc "Well, I'll try not to make your life too miserable."
    mc "Bem, vou tentar não tornar sua vida muito miserável."

# game/script2.rpy:6154
translate pt_br_anubisbr scene54_3_8323f1c2:

#   r "Oh, you'd better."
    r "Ah, é melhor que sim."

# game/script2.rpy:6156
translate pt_br_anubisbr scene54_3_c05cf120:

#   mc "You know, I think we might actually make a good couple."
    mc "Sabe, acho que nós poderíamos formar um bom casal."

# game/script2.rpy:6158
translate pt_br_anubisbr scene54_3_694a44d9:

#   r "That depends... Are you good at listening?"
    r "Isso depende... Você sabe ouvir?"

# game/script2.rpy:6160
translate pt_br_anubisbr scene54_3_a76a359d:

#   mc "I'm learning."
    mc "Estou aprendendo."

# game/script2.rpy:6162
translate pt_br_anubisbr scene54_3_4a9ce12c:

#   r "If that's the case then here are my demands."
    r "Se for esse o caso, então aqui estão as minhas exigências."

# game/script2.rpy:6164
translate pt_br_anubisbr scene54_3_0b6cd4f2:

#   mc "Demands?"
    mc "Exigências?"

# game/script2.rpy:6166
translate pt_br_anubisbr scene54_3_13a36bdf:

#   r "*ahem*. First—you can't be away from me for more than three days."
    r "*cof cof*. Primeiro, você não pode ficar longe de mim por mais de três dias."

# game/script2.rpy:6168
translate pt_br_anubisbr scene54_3_73364daa:

#   mc "Uh... I mean, sometimes it isn't my choi—"
    mc "Hum... quer dizer, às vezes não é minha escolha—"

# game/script2.rpy:6170
translate pt_br_anubisbr scene54_3_17ccc3b6:

#   r "Second—When we dine, you sit beside me. Not across. Beside."
    r "Segundo—Quando jantarmos, você se senta ao meu lado. Não em frente a mim. Ao lado."

# game/script2.rpy:6172
translate pt_br_anubisbr scene54_3_63cc92f4:

#   mc "Okay, a little odd but... sure."
    mc "Ok, um pouco estranho, mas... tudo bem."

# game/script2.rpy:6174
translate pt_br_anubisbr scene54_3_0e4a4b76:

#   r "Third—I get to pick the name of our first child."
    r "Terceiro — eu escolho o nome do nosso primeiro filho."

# game/script2.rpy:6176
translate pt_br_anubisbr scene54_3_5a1b2bde:

#   mc "Shouldn't we at least wait until after we—"
    mc "Não deveríamos pelo menos esperar até depois de nós—"

# game/script2.rpy:6178
translate pt_br_anubisbr scene54_3_69ca2433:

#   r "Fourth—if you want to have other mistresses or wives then you must tell me beforehand. If you cheat on me, I will gut you and leave your corpse on the castle's walls."
    r "Quarto: se você quiser ter outras amantes ou esposas, deve me avisar com antecedência. Se você me trair, eu o estriparei e deixarei seu cadáver nas muralhas do castelo."

# game/script2.rpy:6180
translate pt_br_anubisbr scene54_3_b12907fb:

#   mc "Alright..."
    mc "Tudo bem..."

# game/script2.rpy:6182
translate pt_br_anubisbr scene54_3_4f01f308:

#   r "Fifth—when I wake up grumpy, you bring me honey pastries. No questions asked."
    r "Quinto: quando eu acordo mal-humorado, você me traz doces de mel. Sem perguntas."

# game/script2.rpy:6184
translate pt_br_anubisbr scene54_3_2b35b6fe:

#   mc "..."
    mc "..."

# game/script2.rpy:6186
translate pt_br_anubisbr scene54_3_3d562bf7:

#   r "Sixth—no sending me to the countryside whenever politics get messy. I stay here."
    r "Sexto — nada de me mandarem para o interior sempre que a política ficar complicada. Eu fico aqui."

# game/script2.rpy:6188
translate pt_br_anubisbr scene54_3_42d3094e:

#   mc "Of course..."
    mc "Claro..."

# game/script2.rpy:6190
translate pt_br_anubisbr scene54_3_5e42e7fd:

#   r "Seventh—if we argue, you always apologize first."
    r "Sétimo—se discutirmos, você sempre pede desculpas primeiro."

# game/script2.rpy:6192
translate pt_br_anubisbr scene54_3_04dbf6b6:

#   mc "Alright, alright. Anything else, your highness?"
    mc "Muito bem, muito bem. Mais alguma coisa, alteza?"

# game/script2.rpy:6194
translate pt_br_anubisbr scene54_3_90efcf29:

#   r "...For now, that'll do."
    r "...Por agora, isso basta."

# game/script2.rpy:6196
translate pt_br_anubisbr scene54_3_8be1278b:

#   mc "(God...)"
    mc "(Deus...)"

# game/script2.rpy:6198
translate pt_br_anubisbr scene54_3_e9aa72d0:

#   r "You'll thank me later."
    r "Você vai me agradecer depois."

# game/script2.rpy:6199
translate pt_br_anubisbr scene54_3_fbeb23b7:

#   r "You know... I'm kind of hungry right now."
    r "Sabe... estou com um pouco de fome agora."

# game/script2.rpy:6201
translate pt_br_anubisbr scene54_3_b8953038:

#   mc "(Must be from all that talking.)"
    mc "(Deve ser por causa de tanta conversa.)"

# game/script2.rpy:6203
translate pt_br_anubisbr scene54_3_628f4eab:

#   r "You know what to do."
    r "Você sabe o que fazer."

# game/script2.rpy:6205
translate pt_br_anubisbr scene54_3_d799b4a3:

#   mc "Yes, Your Highness. Your personal slave— *ahem* husband will retrieve your royal meal."
    mc "Sim, Alteza. Seu escravo pessoal— *cof cof* marido irá buscar sua refeição real."

# game/script2.rpy:6207
translate pt_br_anubisbr scene54_3_fe198c46:

#   r "Chop chop! Hehe~"
    r "Rápido, rápido! Hehe~"

# game/script2.rpy:6210
translate pt_br_anubisbr scene54_3_5d624deb:

#   mc "(I don't know about this anymore...)"
    mc "(Já não sei mais o que pensar disso...)"

# game/script2.rpy:6213
translate pt_br_anubisbr scene54_3_623c1c05:

#   mc "Hello."
    mc "Olá."

# game/script2.rpy:6215
translate pt_br_anubisbr scene54_3_eee3d71d:

#   ren "Oh! Sir, it's a pleasure to see you again."
    ren "Oh! Senhor, é um prazer vê-lo novamente."

# game/script2.rpy:6217
translate pt_br_anubisbr scene54_3_64fac802:

#   mc "Been a while. How are things? I didn't wake you up, did I?"
    mc "Faz tempo, né? Como vão as coisas? Eu não te acordei, né?"

# game/script2.rpy:6219
translate pt_br_anubisbr scene54_3_248568d8:

#   ren "All good, sir. I'm usually most active at these hours. How may I help?"
