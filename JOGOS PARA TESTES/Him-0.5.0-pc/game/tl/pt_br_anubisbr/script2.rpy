# game/script2.rpy:8578
translate pt_br_anubisbr scene62_3_20685ae6:

#   kat "You too. Try not to miss me too much."
    kat "Você também. Tente não sentir muita saudade."

# game/script2.rpy:8581
translate pt_br_anubisbr scene62_3_c15266ff:

#   mc "(Alright... now this time I'm taking my damn rest.)"
    mc "(Muito bem... agora sim, vou descansar.)"

