#   greta "Shut up!"
    greta "Cale-se!"

# game/script2.rpy:7461
translate pt_br_anubisbr scene60_choice01_op1_73a78295:

#   greta "*sigh* I apologize for wasting your time."
    greta "*Suspiro* Peço desculpas por ter feito você perder seu tempo."

# game/script2.rpy:7463
translate pt_br_anubisbr scene60_choice01_op1_79dba188:

#   mc "Shit..."
    mc "Merda..."

# game/script2.rpy:7465
translate pt_br_anubisbr scene60_choice01_op1_c8952ba1:

#   avery "Don't worry, [mc]. I'm sure you did your best there. These... things can be quite complicated."
    avery "Não se preocupe, [mc] Tenho certeza de que você fez o seu melhor. Essas... coisas podem ser bem complicadas."

# game/script2.rpy:7466
translate pt_br_anubisbr scene60_choice01_op1_7fdd9881:

#   avery "I will send for a counselor to visit them tomorrow. Hopefully they don't kill each other by then."
    avery "Vou mandar chamar um conselheiro para visitá-los amanhã. Espero que eles não se matem até lá."

# game/script2.rpy:7473
translate pt_br_anubisbr scene60_choice01_op2_ec46af9a:

#   mc "Maybe you two should just separate. Divorce."
    mc "Talvez vocês dois devessem se separar. Divórcio."

# game/script2.rpy:7475
translate pt_br_anubisbr scene60_choice01_op2_e7a53c28:

#   greta "Divorce?!"
    greta "Divórcio?!"

# game/script2.rpy:7477
translate pt_br_anubisbr scene60_choice01_op2_a68ec7c4:

#   osric "Y-You mean... split up for good?"
    osric "Você quer dizer... se separar de vez?"

# game/script2.rpy:7479
translate pt_br_anubisbr scene60_choice01_op2_766ad801:

#   mc "It might be the best for both of you."
    mc "Pode ser o melhor para ambos."

# game/script2.rpy:7481
translate pt_br_anubisbr scene60_choice01_op2_a7eeb2ec:

#   greta "But then... who would feed him after he comes home drunk and battered?!"
    greta "Mas aí... quem o alimentaria depois que ele chegasse em casa bêbado e machucado?!"

# game/script2.rpy:7483
translate pt_br_anubisbr scene60_choice01_op2_11c33941:

#   osric "And who'd remind me to wear clean pants before I leave the house?!"
    osric "E quem me lembraria de vestir calças limpas antes de sair de casa?!"

# game/script2.rpy:7485
translate pt_br_anubisbr scene60_choice01_op2_a3f527a0:

#   greta "He would be hopeless without me!"
    greta "Ele estaria perdido sem mim!"

# game/script2.rpy:7487
translate pt_br_anubisbr scene60_choice01_op2_2465585f:

