# game/script2.rpy:8566
translate pt_br_anubisbr scene62_3_397f5876:

#   kat "But you better come visit sometime, you know... since we're married and all."
    kat "Mas é melhor você vir nos visitar qualquer dia desses, sabe... já que somos casados ​​e tudo mais."

