translate pt_br_anubisbr scene60_a0aa7509:

#   greta "You wouldn't have any sorrows if you actually did something useful with your life!"
    greta "Você não teria nenhuma tristeza se realmente fizesse algo útil com a sua vida!"

# game/script2.rpy:7382
translate pt_br_anubisbr scene60_5847f553:

#   osric "I did plenty! Before you nagged me into quitting everything!"
    osric "Eu fiz muita coisa! Antes de você me convencer a desistir de tudo!"

# game/script2.rpy:7384
translate pt_br_anubisbr scene60_d1e18f5f:

#   greta "You call carving wooden toys plenty?!"
    greta "Você chama de entalhar brinquedos de madeira o suficiente?!"

# game/script2.rpy:7386
