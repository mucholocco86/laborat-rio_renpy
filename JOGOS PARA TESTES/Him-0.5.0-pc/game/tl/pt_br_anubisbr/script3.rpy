# game/script3.rpy:601
translate pt_br_anubisbr s72_dLEFT_LEFT_50945076:

#   r "There are two chambers here. Should we explore them?"
    r "Existem duas câmaras aqui. Devemos explorá-las?"

# game/script3.rpy:615
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_677dbdde:

#   r "Looks like there's a chest here."
    r "Parece que tem um baú aqui."

# game/script3.rpy:622
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_chest_0f019e11:

#   dm "Sitting in the corner is an oak chest. It's covered in a thick layer of dust, and its iron latch appears to be unlocked."
    dm "Num canto, encontra-se um baú de carvalho. Está coberto por uma espessa camada de pó e a sua tranca de ferro parece estar destrancada."

# game/script3.rpy:625
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_chest_04a7d8f1:

#   mc "Let's crack it open."
    mc "Vamos abrir."

# game/script3.rpy:626
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_chest_d5cf561f:

#   r "Hold on, brute force isn't always best. I can attempt a minor blessing of fortune on it. It might... persuade the chest to offer up its best treasures."
    r "Calma aí, força bruta nem sempre é a melhor opção. Posso tentar uma pequena bênção da sorte. Talvez... isso convença o baú a revelar seus melhores tesouros."

# game/script3.rpy:627
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_chest_a6c45683:

#   mc "You can do that?"
    mc "Você consegue fazer isso?"

# game/script3.rpy:628
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_chest_aa2dba85:

#   r "I'm a mage, remember?"
    r "Eu sou um mago, lembra?"

# game/script3.rpy:629
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_chest_6632a6c0:

#   r "If I roll well, we get better loot. If I fail... the magic could backfire, and we might get nothing. Or worse."
    r "Se eu tiver sorte nos dados, conseguimos itens melhores. Se eu falhar... a magia pode se voltar contra nós e podemos não conseguir nada. Ou pior."

# game/script3.rpy:631
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_chest_59c3654c:

#   r "Should I roll it?"
    r "Devo enrolá-lo?"

# game/script3.rpy:636
translate pt_br_anubisbr scene72_choice01_op1_38337f79:

#   perception "Rebecca rolls the dice..."
    perception "Rebecca joga os dados..."

# game/script3.rpy:639
translate pt_br_anubisbr scene72_choice01_op1_175c385d:

#   perception "The dice lands on [dice_number]!"
    perception "O dado cai em [dice_number]!"

# game/script3.rpy:644
translate pt_br_anubisbr scene72_choice01_op1_8082ef71:

#   r "Yes! The weave of fortune favors us!"
    r "Sim! A sorte está ao nosso lado!"

# game/script3.rpy:645
translate pt_br_anubisbr scene72_choice01_op1_58e82970:

#   dm "A golden light shimmers over the chest. With a gentle, inviting click, the lid rises on its own, as if welcoming you."
    dm "Uma luz dourada cintila sobre o baú. Com um clique suave e convidativo, a tampa se abre sozinha, como se lhe desse as boas-vindas."

# game/script3.rpy:646
translate pt_br_anubisbr scene72_choice01_op1_befc59be:

#   dm "Inside, nestled on velvet, are two items: a small potion of healing and a masturfully crafted bronze bracers. The Warrior's max vitality has increased to 25!"
    dm "Lá dentro, acomodados sobre veludo, encontram-se dois itens: uma pequena poção de cura e um bracelete de bronze habilmente trabalhado. A vitalidade máxima do Guerreiro aumentou para 25!"

# game/script3.rpy:648
translate pt_br_anubisbr scene72_choice01_op1_173f5f4d:

#   mc "Nice work, Becky."
    mc "Bom trabalho, Becky."

# game/script3.rpy:650
translate pt_br_anubisbr scene72_choice01_op1_1b25cb35:

#   r "Oh, no..."
    r "Oh não..."

# game/script3.rpy:652
translate pt_br_anubisbr scene72_choice01_op1_ac4b8349:

#   dm "A sickly green aura envelops the chest. It begins to quiver violently, its wood groaning and splintering before your eyes."
    dm "Uma aura verde doentia envolve o baú. Ele começa a tremer violentamente, sua madeira rangendo e se estilhaçando diante dos seus olhos."

# game/script3.rpy:653
translate pt_br_anubisbr scene72_choice01_op1_95028eb5:

#   dm "The entire chest collapses in on itself, disintegrating into a pile of worthless, charred splinters and dust."
    dm "O baú inteiro desaba sobre si mesmo, desintegrando-se em uma pilha de estilhaços carbonizados e pó sem valor."

# game/script3.rpy:654
translate pt_br_anubisbr scene72_choice01_op1_86a43d1c:

#   mc "Shit... There goes our loot."
    mc "Merda... Lá se foi nosso saque."

# game/script3.rpy:655
translate pt_br_anubisbr scene72_choice01_op1_a2d69939:

#   r "Sorry..."
    r "Desculpe..."

# game/script3.rpy:660
translate pt_br_anubisbr scene72_choice01_op2_c67609de:

#   mc "Let's just loot it."
    mc "Vamos saquear tudo."

# game/script3.rpy:661
translate pt_br_anubisbr scene72_choice01_op2_48f02b1d:

#   dm "Inside, nestled on velvet, is a single small potion of healing."
    dm "Lá dentro, aninhada sobre veludo, encontra-se uma pequena poção de cura."

# game/script3.rpy:663
translate pt_br_anubisbr scene72_choice01_op2_f7f5bfbc:

#   mc "Alright, this might help us later on."
    mc "Certo, isso pode nos ajudar mais tarde."

# game/script3.rpy:693
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_RIGHT_RIGHT_LEFT_chest_48671785:

#   mc "A chest! Let's crack it open."
    mc "Um baú! Vamos abri-lo."

# game/script3.rpy:694
translate pt_br_anubisbr s72_dLEFT_LEFT_LEFT_RIGHT_RIGHT_LEFT_chest_d5cf561f:

#   r "Hold on, brute force isn't always best. I can attempt a minor blessing of fortune on it. It might... persuade the chest to offer up its best treasures."
    r "Calma aí, força bruta nem sempre é a melhor opção. Posso tentar uma pequena bênção da sorte. Talvez... isso convença o baú a revelar seus melhores tesouros."

