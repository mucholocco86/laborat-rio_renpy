translate pt_br_anubisbr scene79_2_a0d451a3:

#   avery "My dear sister tragically died at sea. A storm, they say. A terrible accident. I will assume the role of Queen from now on."
    avery "Minha querida irmã faleceu tragicamente no mar. Uma tempestade, dizem. Um terrível acidente. A partir de agora, assumirei o papel de Rainha."

# game/script3.rpy:4756
translate pt_br_anubisbr scene79_2_e448bb6b:

#   mc "Good for you."
    mc "Que bom para você."

# game/script3.rpy:4758
