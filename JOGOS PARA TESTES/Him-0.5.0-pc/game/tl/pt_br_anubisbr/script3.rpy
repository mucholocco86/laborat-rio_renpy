    mc "Abra a porta! Preciso falar com a Avery! Agora!"

# game/script3.rpy:4731
translate pt_br_anubisbr scene79_2_8797ab50:

#   guard "I apologize, sir, but we cannot allow anyone to enter this room. The same goes for leaving it."
    guard "Peço desculpas, senhor, mas não podemos permitir que ninguém entre nesta sala. O mesmo vale para a saída."

# game/script3.rpy:4733
translate pt_br_anubisbr scene79_2_c31a9b30:

#   mc "Are you fucking kidding me!? Do you expect me to stay in here with a... with a body!?"
    mc "Você está de brincadeira?! Você espera que eu fique aqui dentro com um... com um corpo?!"

# game/script3.rpy:4736
