    yuuhi "Seu idiota! Por que você não mandou mensagem? Eu estava morrendo de preocupação!"

# game/script3.rpy:10816
translate pt_br_anubisbr scene89_choice01_op2_834f912d:

#   yuuhi "And that's how you say hello now? Pervert."
    yuuhi "E é assim que você diz olá agora? Pervertido."

# game/script3.rpy:10818
translate pt_br_anubisbr scene89_choice01_op2_fab30b87:

#   mc "Missed me that much?"
    mc "Sentiram tanto a minha falta assim?"

