# game/script3.rpy:894
translate pt_br_anubisbr scene72_rnr_shrine1_op1_5bc796a7:

#   dm "The Warrior attempt to do a wide theatrical swing but the axe accedintly slips from his fingers. The goblin, untouched, skids to a halt and pokes you in the thigh with its rusty dagger."
    dm "O guerreiro tenta dar um golpe teatral amplo, mas o machado escorrega acidentalmente de seus dedos. O goblin, ileso, para bruscamente e te cutuca na coxa com sua adaga enferrujada."

# game/script3.rpy:895
translate pt_br_anubisbr scene72_rnr_shrine1_op1_f432aa4a:

#   dm "The Warrior's vitality decreases by 3!"
    dm "A vitalidade do Guerreiro diminui em 3!"

# game/script3.rpy:900
translate pt_br_anubisbr scene72_rnr_shrine1_op1_3d76abe8:

#   r "You ran out of vitality!"
    r "Você ficou sem energia!"

# game/script3.rpy:901
translate pt_br_anubisbr scene72_rnr_shrine1_op1_6f88802d:

#   mc "Shit. So that's it? I lost?"
    mc "Droga. Então é isso? Eu perdi?"

# game/script3.rpy:902
translate pt_br_anubisbr scene72_rnr_shrine1_op1_94119df4:

#   r "Wait, no you don't. You have the ring of second heart, remember? It shatters, and your warrior groggily gets back to his feet."
    r "Espere, não, você não tem. Você tem o anel do segundo coração, lembra? Ele se estilhaça, e seu guerreiro se levanta cambaleando."

# game/script3.rpy:903
translate pt_br_anubisbr scene72_rnr_shrine1_op1_da93fe24:

#   mc "Phew... Alright, let's continue then."
    mc "Ufa... Muito bem, vamos continuar então."

# game/script3.rpy:913
translate pt_br_anubisbr scene72_rnr_shrine1_op2_0b50ccce:

#   mc "Hold on! I try to reason with it. 'We don't have to do this, little guy! We can get out of here together!'"
    mc "Calma aí! Eu tento argumentar com ele. 'Não precisamos fazer isso, amiguinho! Podemos sair daqui juntos!'"

# game/script3.rpy:914
translate pt_br_anubisbr scene72_rnr_shrine1_op2_abd65157:

#   r "You're trying to... negotiate... with a goblin?"
    r "Você está tentando... negociar... com um goblin?"

# game/script3.rpy:915
translate pt_br_anubisbr scene72_rnr_shrine1_op2_482f9850:

#   dm "The goblin seizes the opportunity, leaps forward, and bites you hard on the hand before scrambling away."
    dm "O goblin aproveita a oportunidade, salta para a frente e morde sua mão com força antes de fugir às pressas."

# game/script3.rpy:916
translate pt_br_anubisbr scene72_rnr_shrine1_op2_f432aa4a:

#   dm "The Warrior's vitality decreases by 3!"
    dm "A vitalidade do Guerreiro diminui em 3!"

