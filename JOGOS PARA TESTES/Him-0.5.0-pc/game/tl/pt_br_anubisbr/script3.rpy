    mc "Acho que ela está aqui! Ei! O que diabos eu faço!?"

# game/script3.rpy:4695
translate pt_br_anubisbr scene79_2_00a359f9:

#   alex "Ahh... Hahh... Fuck. Made it."
    alex "Ahh... Hahh... Droga. Consegui."

