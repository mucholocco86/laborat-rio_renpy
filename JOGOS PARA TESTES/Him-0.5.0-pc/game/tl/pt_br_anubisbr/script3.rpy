#   reham "Maia? Are you alright? You look... winded."
    reham "Maia? Você está bem? Você parece... sem fôlego."

# game/script3.rpy:9447
translate pt_br_anubisbr scene84_maia5_0a878066:

#   m "Huh!? I-I'm... Umm... I..."
    m "Hã!? Eu... eu... hum... eu..."

# game/script3.rpy:9449
translate pt_br_anubisbr scene84_maia5_63b929e2:

#   mc "She's fine. She tripped over a branch. Gave her a scare is all."
    mc "Ela está bem. Tropeçou num galho. Só levou um susto."

# game/script3.rpy:9451
translate pt_br_anubisbr scene84_maia5_bcf9db0f:

#   reham "I see. Well, come over here."
    reham "Entendi. Bem, venha para cá."

# game/script3.rpy:9453
translate pt_br_anubisbr scene84_maia5_c35777c0:

#   reham "I'll take a look, make sure nothing's sprained."
    reham "Vou dar uma olhada para garantir que não haja nenhuma entorse."

# game/script3.rpy:9454
translate pt_br_anubisbr scene84_maia5_6760fd7d:

#   m "T-Thank you, Reham! But, I just need to take a seat! Right here! On this very hard, very normal chair!"
    m "O-Obrigada, Reham! Mas eu preciso me sentar! Bem aqui! Nesta cadeira bem dura e bem normal!"

# game/script3.rpy:9455
translate pt_br_anubisbr scene84_maia5_8531b7b7:

#   reham "Are you sure?"
    reham "Tem certeza?"

# game/script3.rpy:9456
translate pt_br_anubisbr scene84_maia5_424fdc9a:

#   m "Yes!"
    m "Sim!"

# game/script3.rpy:9457
translate pt_br_anubisbr scene84_maia5_b2040589:

#   reham "You're acting weird."
    reham "Você está agindo de forma estranha."

# game/script3.rpy:9459
translate pt_br_anubisbr scene84_maia5_9d86122f:

#   reham "Hmm? *sniff* *sniff*"
    reham "Hum? *cheira* *cheira*"

# game/script3.rpy:9461
translate pt_br_anubisbr scene84_maia5_b6d83f9c:

#   reham "{size=30}This scent... I-It's your semen, [mc]...{/size}"
    reham "{size=30}Esse cheiro... É o seu sêmen. [mc]...{/size}"

# game/script3.rpy:9462
translate pt_br_anubisbr scene84_maia5_21189d5f:

#   mc "Shhhh..."
    mc "Shhhh..."

# game/script3.rpy:9477
translate pt_br_anubisbr scene84_maia5_522d8d9e:

