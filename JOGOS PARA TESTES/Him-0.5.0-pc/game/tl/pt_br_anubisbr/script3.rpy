#   r "[mc]..."
    r "[mc]..."

# game/script3.rpy:2788
translate pt_br_anubisbr scene74_3_a3031a38:

#   mc "You should sleep it off instead."
    mc "Você deveria dormir para ver se passa."

# game/script3.rpy:2790
translate pt_br_anubisbr scene74_3_aa2d2015:

#   mc "Trust me. A massage, especially when you're this horny... it won't help. Not a bit."
    mc "Acredite em mim. Uma massagem, especialmente quando você está tão excitada... não vai ajudar. Nem um pouco."

# game/script3.rpy:2791
translate pt_br_anubisbr scene74_3_693cfcb8:

#   r "*sigh* Maybe you're right..."
    r "*suspiro* Talvez você tenha razão..."

# game/script3.rpy:2792
