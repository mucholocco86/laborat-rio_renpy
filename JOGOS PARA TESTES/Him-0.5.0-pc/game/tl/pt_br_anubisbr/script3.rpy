# game/script3.rpy:881
translate pt_br_anubisbr s72_dLEFT_LEFT_shrine_fight_006636c5:

#   dm "The goblin, tired of waiting, lets out a pathetic snarl and charges at you in a wobbly, unsteady run!"
    dm "O goblin, cansado de esperar, solta um rosnado patético e avança em sua direção numa corrida cambaleante e instável!"

# game/script3.rpy:882
translate pt_br_anubisbr s72_dLEFT_LEFT_shrine_fight_095df756:

#   r "Alright, warrior. What's your move?"
    r "Muito bem, guerreiro. Qual é o seu próximo passo?"

