    mc "Você não disse que precisava dela viva!?"

# game/script3.rpy:4722
translate pt_br_anubisbr scene79_2_8ec893de:

#   assassin "Confirmed."
    assassin "Confirmado."

# game/script3.rpy:4725
translate pt_br_anubisbr scene79_2_351fff3e:

#   mc "...H-Hey! Where are you going!?"
    mc "Ei! Aonde você vai!?"

