translate pt_br_anubisbr scene87_choice02_op1_f4192d57:

#   lena "Alright, alright! I surrender."
    lena "Muito bem, muito bem! Eu me rendo."

# game/script3.rpy:10355
translate pt_br_anubisbr scene87_choice02_op1_e4024099:

#   lena "I wasn't trying to hurt you. I promise."
    lena "Eu não estava tentando te machucar. Prometo."

# game/script3.rpy:10356
translate pt_br_anubisbr scene87_choice02_op1_93069802:

#   mc "You're doing a terrible job of showing that."
    mc "Você está fazendo um péssimo trabalho ao demonstrar isso."

# game/script3.rpy:10357
translate pt_br_anubisbr scene87_choice02_op1_d85c36f6:

#   lena "Like I said, I only wanted to a conversation. I just needed to make sure you'd actually have it."
    lena "Como eu disse, eu só queria conversar. Só precisava ter certeza de que você realmente aceitaria a conversa."

# game/script3.rpy:10358
translate pt_br_anubisbr scene87_choice02_op1_05124d50:

#   lena "And damn... I'm impressed so far. That punch would've easily knocked me out if you didn't hold back."
    lena "E caramba... estou impressionado até agora. Esse soco teria me nocauteado facilmente se você não tivesse se segurado."

# game/script3.rpy:10359
translate pt_br_anubisbr scene87_choice02_op1_24575857:

#   mc "You better start talking."
    mc "É melhor você começar a falar."

# game/script3.rpy:10361
translate pt_br_anubisbr scene87_choice02_op1_a41c9e71:

#   lena "*ahem* A girl works here. Serena. You met her. Sweet girl, terrible judge of character. She was sure you'd come back for your horse."
    lena "*cof cof* Uma garota trabalha aqui. Serena. Você a conheceu. Uma querida, péssima juíza de caráter. Ela tinha certeza de que você voltaria para buscar seu cavalo."

# game/script3.rpy:10365
translate pt_br_anubisbr scene87_choice02_op2_4c399587:

#   mc "*cough* ...You said you were waiting for me. How? Start talking."
    mc "*tosse* ...Você disse que estava me esperando. Como? Comece a falar."

# game/script3.rpy:10366
translate pt_br_anubisbr scene87_choice02_op2_ce242e9e:

#   mc "I don't think you're here to arrest me. Otherwise I feel like I'd have been long gone."
    mc "Acho que você não está aqui para me prender. Se não estivesse, eu já teria ido embora há muito tempo."

# game/script3.rpy:10368
translate pt_br_anubisbr scene87_choice02_op2_5d02a310:

#   lena "Like I said, I want a conversation. But I needed to make sure you'd actually have it."
    lena "Como eu disse, quero conversar. Mas precisava ter certeza de que você realmente aceitaria conversar."

# game/script3.rpy:10370
translate pt_br_anubisbr scene87_choice02_op2_37dd8aa4:

#   mc "You could've just asked instead of trying to break my neck..."
    mc "Você poderia simplesmente ter perguntado em vez de tentar quebrar meu pescoço..."

# game/script3.rpy:10372
translate pt_br_anubisbr scene87_choice02_op2_167896f1:

#   lena "Where's the fun in that? Besides—I wanted to see if you were as tough as they say."
    lena "Onde está a graça nisso? Além disso, eu queria ver se você era tão durão quanto dizem."

# game/script3.rpy:10373
translate pt_br_anubisbr scene87_choice02_op2_a28c3c63:

#   lena "Color me disappointed, but you held out longer than most. That counts for something."
    lena "Estou um pouco decepcionado, mas você aguentou mais do que a maioria. Isso já é alguma coisa."

# game/script3.rpy:10374
translate pt_br_anubisbr scene87_choice02_op2_97697c11:

#   lena "Anyway, a girl works here. Serena. You met her. Sweet girl, terrible judge of character. She was sure you'd come back for your horse."
    lena "Enfim, uma garota trabalha aqui. Serena. Você a conheceu. Uma querida, péssima juíza de caráter. Ela tinha certeza de que você voltaria para buscar seu cavalo."

# game/script3.rpy:10378
translate pt_br_anubisbr scene87_3_02ef9a30:

#   lena "She's been hiding it, moving it, falsifying the logs. For you."
    lena "Ela tem escondido, mudado de lugar, falsificado os registros. Tudo por sua causa."

# game/script3.rpy:10380
translate pt_br_anubisbr scene87_3_0b326139:

#   mc "Serena? Why would she do that?"
    mc "Serena? Por que ela faria isso?"

# game/script3.rpy:10382
translate pt_br_anubisbr scene87_3_910632a4:

#   lena "Because she's a kind person. A trait that's currently getting her crushed."
    lena "Porque ela é uma pessoa gentil. Uma característica que está, no momento, destruindo sua vida."

# game/script3.rpy:10383
translate pt_br_anubisbr scene87_3_4aec7e61:

#   lena "Follow me. Let's get in inside."
    lena "Sigam-me. Vamos entrar."

# game/script3.rpy:10388
translate pt_br_anubisbr scene87_3_3c513e0c:

#   lena "Serena! Come on out, sweetheart. Don't make me yell twice."
    lena "Serena! Apareça, querida. Não me faça gritar duas vezes."

# game/script3.rpy:10397
translate pt_br_anubisbr scene87_3_2e4dc2f7:

#   selene "Yes, mother? ...Wh-What's with the bruise?"
    selene "Sim, mãe? ...O que é esse hematoma?"

# game/script3.rpy:10398
translate pt_br_anubisbr scene87_3_323917e2:

#   lena "This guy's work. It's gonna sting for a while."
    lena "O trabalho desse cara. Vai doer por um tempo."

# game/script3.rpy:10400
translate pt_br_anubisbr scene87_3_1412804b:

#   selene "Yes, mother?"
    selene "Sim, mãe?"

# game/script3.rpy:10402
translate pt_br_anubisbr scene87_3_e6faad8f:

#   selene "[mc]! He's here!"
    selene "[mc] Ele está aqui!"

# game/script3.rpy:10403
translate pt_br_anubisbr scene87_3_2b35b6fe:

#   mc "..."
    mc "..."

# game/script3.rpy:10404
translate pt_br_anubisbr scene87_3_57c8075f:

#   lena "[mc]?"
    lena "[mc]?"

# game/script3.rpy:10406
translate pt_br_anubisbr scene87_3_f387f67f:

#   mc "Yes, I'm here! ...Wait, did she just call you mother!?"
    mc "Sim, estou aqui! ...Espere, ela acabou de te chamar de mãe!?"

# game/script3.rpy:10408
translate pt_br_anubisbr scene87_3_2e6f06c6:

#   lena "*laughs* I know, right? Shocking. I don't look a day over ninety, do I?"
    lena "*risos* Pois é, né? Chocante. Não aparento ter mais de noventa anos, né?"

# game/script3.rpy:10411
translate pt_br_anubisbr scene87_3_78535e1a:

#   lena "Well, there he is, hon. He's similar to what you described, except you missed the part where he liked getting crushed between women's thighs."
    lena "Pois bem, aí está ele, querida. Ele é parecido com o que você descreveu, exceto pela parte em que ele gostava de ser esmagado entre as coxas das mulheres."

# game/script3.rpy:10413
translate pt_br_anubisbr scene87_3_d056901d:

#   lena "Well, there he is, hon. Tell him your plan."
    lena "Bom, aí está ele, querida. Conte a ele o seu plano."

# game/script3.rpy:10415
translate pt_br_anubisbr scene87_3_8182fc04:

#   mc "...Serena. Your mother has an interesting way of introducing herself."
    mc "...Serena. Sua mãe tem um jeito interessante de se apresentar."

# game/script3.rpy:10417
translate pt_br_anubisbr scene87_3_cae72056:

#   selene "I'm so sorry. She's very serious about safety and all that. She means well. Really."
    selene "Sinto muito. Ela leva a segurança muito a sério e tudo mais. Ela tem boas intenções. De verdade."

# game/script3.rpy:10419
translate pt_br_anubisbr scene87_3_dd3e255d:

#   mc "Serena, you look..."
    mc "Serena, você parece..."

# game/script3.rpy:10421
translate pt_br_anubisbr scene87_3_7198ee5f:

#   lena "Miserable? Right. You're not wrong. Doesn't suit her at all."
    lena "Infeliz? Exatamente. Você não está errado. Não combina nada com ela."

# game/script3.rpy:10422
translate pt_br_anubisbr scene87_3_0728bda2:

#   lena "She's usually the most annoyingly cheerful person you'll ever meet. It's honestly exhausting."
    lena "Ela geralmente é a pessoa mais irritantemente alegre que você vai conhecer. É sinceramente exaustivo."

# game/script3.rpy:10424
translate pt_br_anubisbr scene87_3_8eed3186:

#   mc "What's gotten her so down? What's going on?"
    mc "O que a deixou tão triste? O que está acontecendo?"

# game/script3.rpy:10427
translate pt_br_anubisbr scene87_3_dccecdb5:

#   selene "..."
    selene "..."

# game/script3.rpy:10430
translate pt_br_anubisbr scene87_3_40bd7886:

#   lena "What's going on is that under Avery's new 'labor reforms,' servants with debt can be bound to their masters. Indefinitely."
    lena "O que está acontecendo é que, sob as novas \"reformas trabalhistas\" de Avery, os empregados com dívidas podem ser obrigados a servir seus patrões indefinidamente."

# game/script3.rpy:10431
translate pt_br_anubisbr scene87_3_6d268dd6:

#   lena "Serena's old contract got burned. Now she belongs to the master of these stables. Can't leave, can't refuse any work, can't even keep a single copper of her own wages."
    lena "O antigo contrato de Serena foi queimado. Agora ela pertence ao dono desses estábulos. Não pode ir embora, não pode recusar nenhum trabalho, não pode ficar nem com um centavo do próprio salário."

# game/script3.rpy:10433
translate pt_br_anubisbr scene87_3_bcec978b:

#   mc "That's... horrible. He basically owns her now."
    mc "Isso é... horrível. Basicamente, ela pertence a ele agora."

# game/script3.rpy:10435
translate pt_br_anubisbr scene87_3_179aee79:

#   lena "Call it what it is, then. She's a slave. And I'm getting her out."
    lena "Vamos chamar as coisas pelos seus nomes, então. Ela é uma escrava. E eu vou tirá-la de lá."

# game/script3.rpy:10436
translate pt_br_anubisbr scene87_3_30b7f145:

#   lena "Otherwise, travelling to this city in particular would've been for nothing."
    lena "Do contrário, viajar até esta cidade em particular teria sido em vão."

# game/script3.rpy:10438
translate pt_br_anubisbr scene87_3_a41fc042:

#   mc "So what do you need from me?"
    mc "Então, o que você precisa de mim?"

# game/script3.rpy:10440
translate pt_br_anubisbr scene87_3_02770a51:

#   lena "*scoff* Look, [mc]. I ain't gonna sugarcoat it. my plan is straightforward. I find the man who holds her papers. I kill him. Then everything's good again."
    lena "*bufa* Olha, [mc] Não vou dourar a pílula. Meu plano é simples. Encontro o homem que está com os documentos dela. Eu o mato. E aí tudo volta ao normal."

# game/script3.rpy:10442
translate pt_br_anubisbr scene87_3_ad198ff5:

#   selene "It's not a plan, it's a death wish! Idiot! Idiot! Idiot!"
    selene "Isso não é um plano, é um desejo de morte! Idiota! Idiota! Idiota!"

# game/script3.rpy:10443
translate pt_br_anubisbr scene87_3_ad76715b:

#   selene "You can't come back into my life so suddenly and leave!"
    selene "Você não pode simplesmente voltar para a minha vida e ir embora!"

# game/script3.rpy:10445
translate pt_br_anubisbr scene87_3_58c703d9:

#   mc "She's right. I wouldn't call that a plan."
    mc "Ela tem razão. Eu não chamaria isso de plano."

# game/script3.rpy:10447
translate pt_br_anubisbr scene87_3_66e2d001:

#   lena "Ahuh. She ain't too fond of my idea, as you can see. But..."
    lena "Aham. Ela não gostou muito da minha ideia, como você pode ver. Mas..."

# game/script3.rpy:10448
translate pt_br_anubisbr scene87_3_0be0aca6:

#   lena "She's been clinging to this idea that you might be the alternative. The man who faced down Gaius and walked away. The man who's got Avery's people nervous."
    lena "Ela tem se agarrado à ideia de que você pode ser a alternativa. O homem que enfrentou Gaius e saiu ileso. O homem que deixou a equipe de Avery nervosa."

# game/script3.rpy:10449
translate pt_br_anubisbr scene87_3_bb22ad6f:

#   lena "She basically thinks you have nothing else to loose."
    lena "Basicamente, ela acha que você não tem mais nada a perder."

# game/script3.rpy:10451
translate pt_br_anubisbr scene87_3_30f1547b:

#   mc "I have plenty to lose, Serena."
    mc "Tenho muito a perder, Serena."

# game/script3.rpy:10453
translate pt_br_anubisbr scene87_3_d8c8a1aa:

#   selene "I'm not asking for a... a murder. I'm asking for a solution. Mother sees everything as a nail because she only has a hammer."
    selene "Não estou pedindo um... um assassinato. Estou pedindo uma solução. Minha mãe vê tudo como um prego porque só tem um martelo."

# game/script3.rpy:10454
translate pt_br_anubisbr scene87_3_ab26be9d:

#   selene "I hid your horse because I saw that. I thought... maybe you could see a way here, too."
    selene "Escondi seu cavalo porque vi aquilo. Pensei... talvez você também pudesse encontrar uma saída por aqui."

# game/script3.rpy:10456
translate pt_br_anubisbr scene87_3_14311bee:

#   lena "You hold too much faith in people, hon."
    lena "Você deposita muita fé nas pessoas, querida."

# game/script3.rpy:10457
translate pt_br_anubisbr scene87_3_48879ad5:

#   lena "Let me do it my way. We don't need to ask anyone for help."
    lena "Deixa eu fazer do meu jeito. Não precisamos pedir ajuda a ninguém."

# game/script3.rpy:10459
translate pt_br_anubisbr scene87_3_cd514177:

#   mc "And if you die? She'd be worse off than before. You said you wanted a favor. What, exactly, are you asking me for?"
    mc "E se você morrer? Ela ficaria em situação pior do que antes. Você disse que queria um favor. O que exatamente você está me pedindo?"

# game/script3.rpy:10461
translate pt_br_anubisbr scene87_3_8f261cfb:

#   lena "I... don't know anymore. I'm at my wits' end. If she hadn't stopped me, I'd already be out there with a sword."
    lena "Eu... já não sei mais. Estou no meu limite. Se ela não tivesse me impedido, eu já estaria lá fora com uma espada na mão."

# game/script3.rpy:10463
translate pt_br_anubisbr scene87_3_5ae7d315:

#   selene "Please, [mc]. I don't want Mother hurt. She's rough... she left when I was young... but she's still my mother."
    selene "Por favor, [mc] Não quero que minha mãe se machuque. Ela é durona... foi embora quando eu era pequeno... mas ainda é minha mãe."

# game/script3.rpy:10465
translate pt_br_anubisbr scene87_3_a71480a1:

#   lena "I didn't leave, sweetheart. Elves... time moves different for us. A 'walk' for me was years for you. I thought you'd be safer without a wandering rogue for a mother."
    lena "Eu não fui embora, querida. Elfos... o tempo passa de forma diferente para nós. Um \"passeio\" para mim foram anos para você. Achei que você estaria mais segura sem uma mãe errante e desonesta."

# game/script3.rpy:10467
translate pt_br_anubisbr scene87_3_7a0e8f01:

#   selene "I don't want to hear anymore of that. Besides... it doesn't matter now. What happened has happened."
    selene "Não quero mais ouvir falar disso. Além disso... não importa mais. O que aconteceu, aconteceu."

# game/script3.rpy:10469
translate pt_br_anubisbr scene87_3_17c3171c:

#   mc "Are you going to tell the guards about me if I don't help?"
    mc "Você vai contar aos guardas sobre mim se eu não ajudar?"

# game/script3.rpy:10471
translate pt_br_anubisbr scene87_3_35396c51:

#   lena "I ain't no filthy snitch. Fuck Avery—I'd burn the city down to see her fall."
    lena "Eu não sou nenhum dedo-duro imundo. Que se dane a Avery — eu incendiaria a cidade inteira só para vê-la cair."

# game/script3.rpy:10475
translate pt_br_anubisbr scene87_3_d6bc9089:

#   lena "Doesn't matter to me anyway. I'll gut that pig myself, with or without help. Either I kill him or die trying."
    lena "Tanto faz para mim. Eu mesmo vou estripar aquele porco, com ou sem ajuda. Ou eu o mato ou morro tentando."

# game/script3.rpy:10477
translate pt_br_anubisbr scene87_3_da5afe41:

#   selene "No! Stop saying that, please! I... I need you."
    selene "Não! Pare de dizer isso, por favor! Eu... eu preciso de você."

# game/script3.rpy:10473
translate pt_br_anubisbr scene87_3_2b35b6fe_1:

#   mc "..."
    mc "..."

# game/script3.rpy:10484
translate pt_br_anubisbr scene87_choice03_op1_f2b88f66:

#   mc "Both of you, just... calm down. I'll think about it."
    mc "Vocês dois, por favor... se acalmem. Vou pensar no assunto."

# game/script3.rpy:10485
translate pt_br_anubisbr scene87_choice03_op1_df4a106b:

#   mc "What happened to Serena was terrible and unjust but I can't rush into danger with my current circumstances."
    mc "O que aconteceu com Serena foi terrível e injusto, mas não posso me colocar em perigo dadas as minhas circunstâncias atuais."

# game/script3.rpy:10487
translate pt_br_anubisbr scene87_choice03_op1_799739b1:

#   lena "Think about it? This ain't a philosophy debate. It's a yes or no."
    lena "Pense bem: isto não é um debate filosófico. É uma questão de sim ou não."

# game/script3.rpy:10489
translate pt_br_anubisbr scene87_choice03_op1_7834d659:

#   mc "I don't even know where the man lives. If I'm even considering it, I need to know what I'm walking into."
    mc "Eu nem sei onde o homem mora. Se eu sequer considerar essa possibilidade, preciso saber no que estou me metendo."

# game/script3.rpy:10491
translate pt_br_anubisbr scene87_choice03_op1_047679fc:

#   lena "Fine, ask away."
    lena "Ótimo, pode perguntar."

# game/script3.rpy:10497
translate pt_br_anubisbr scene87_choice04_op1_fae0b682:

#   mc "Where does he live? Not just the district. The house, the streets around it."
    mc "Onde ele mora? Não apenas o bairro. A casa, as ruas ao redor."

# game/script3.rpy:10499
translate pt_br_anubisbr scene87_choice04_op1_1feb1a95:

#   lena "Greyleaf. Big stone manor with a wrought-iron fence shaped like vines. I never expected someone with that wealth to live in that shithole of a district."
    lena "Greyleaf. Uma grande mansão de pedra com uma cerca de ferro forjado em forma de trepadeiras. Nunca imaginei que alguém com tanta riqueza pudesse morar naquele buraco de bairro."

# game/script3.rpy:10501
translate pt_br_anubisbr scene87_choice04_op1_c388ed1e:

#   mc "Security?"
    mc "Segurança?"

# game/script3.rpy:10503
translate pt_br_anubisbr scene87_choice04_op1_240b4ab6:

#   lena "Two at the front gate, lazy-looking but armed. A patrol walks the perimeter every half-hour. More inside, I'd wager. But the back garden wall... there's barely anyone that goes there."
    lena "Dois no portão da frente, com ar preguiçoso, mas armados. Uma patrulha percorre o perímetro a cada meia hora. Aposto que há mais lá dentro. Mas o muro do jardim dos fundos... quase ninguém vai lá."

# game/script3.rpy:10505
translate pt_br_anubisbr scene87_choice04_op1_c8418cd5:

#   mc "How do you know all this?"
    mc "Como você sabe de tudo isso?"

# game/script3.rpy:10507
translate pt_br_anubisbr scene87_choice04_op1_7417341d:

#   lena "I've been watching. For about a week."
    lena "Estou acompanhando. Há cerca de uma semana."

# game/script3.rpy:10513
translate pt_br_anubisbr scene87_choice04_op2_63036005:

#   mc "Describe him to me."
    mc "Descreva-o para mim."

# game/script3.rpy:10515
translate pt_br_anubisbr scene87_choice04_op2_068bf9ec:

#   lena "He's a bloated tick of a man. With a beard he thinks makes him look dignified. It doesn't."
    lena "Ele é um homem inchado e disforme. Com essa barba, ele acha que isso o deixa com uma aparência digna. Não deixa."

# game/script3.rpy:10516
translate pt_br_anubisbr scene87_choice04_op2_c56f6c9c:

#   lena "Trust me, you'll know him when you see him."
    lena "Acredite em mim, você o reconhecerá quando o vir."

# game/script3.rpy:10518
translate pt_br_anubisbr scene87_choice04_op2_9617cae8:

#   selene "He always... smiles weirdly at me. It makes my skin crawl."
    selene "Ele sempre... me dá um sorriso estranho. Isso me dá arrepios."

# game/script3.rpy:10524
translate pt_br_anubisbr scene87_choice04_op3_669590ee:

#   mc "What's in this for me? If I help, what's my prize?"
    mc "O que eu ganho com isso? Se eu ajudar, qual será a minha recompensa?"

# game/script3.rpy:10526
translate pt_br_anubisbr scene87_choice04_op3_2fb1bef2:

#   lena "Straight to the price tag, huh? I don't blame you. His manor will be full of valuables. You can take your pick after he's dead. Coin, jewels, whatever you can carry."
    lena "Direto ao preço, né? Não te culpo. A mansão dele estará cheia de objetos de valor. Você pode escolher o que quiser depois que ele morrer. Moedas, joias, o que você conseguir carregar."

# game/script3.rpy:10528
translate pt_br_anubisbr scene87_choice04_op3_3605084d:

#   selene "Mother!"
    selene "Mãe!"

# game/script3.rpy:10530
translate pt_br_anubisbr scene87_choice04_op3_a5b4b3e2:

#   lena "What? He asked. Besides, he gets to be the hero who saved a poor girl from slavery. That's worth something, ain't it?"
    lena "\"O quê?\", perguntou ele. \"Além disso, ele vai ser o herói que salvou uma pobre garota da escravidão. Isso vale alguma coisa, não vale?\""

# game/script3.rpy:10532
translate pt_br_anubisbr scene87_choice04_op3_d1a60bf7:

#   lena "Or does your conscience only speak gold?"
    lena "Ou será que sua consciência só fala em ouro?"

# game/script3.rpy:10537
translate pt_br_anubisbr scene87_choice04_op4_5eeec857:

#   mc "That's all I need to know for now."
    mc "Isso é tudo que preciso saber por enquanto."

# game/script3.rpy:10540
translate pt_br_anubisbr scene87_choice04_op4_65cd3300:

#   lena "Really? You won't ask about something in return?"
    lena "Sério? Você não vai me perguntar nada em troca?"

# game/script3.rpy:10542
translate pt_br_anubisbr scene87_choice04_op4_cd5cd0e6:

#   mc "I won't. Seeing Serena happy again is prize enough."
    mc "Não vou. Ver a Serena feliz de novo já é prêmio suficiente."

# game/script3.rpy:10544
translate pt_br_anubisbr scene87_choice04_op4_ed1ec73a:

#   lena "Hah! Alright, hero. I'm sorry I judged you terribly before. You really are a good person."
    lena "Ah! Tudo bem, herói. Me desculpe por ter te julgado tão mal antes. Você é realmente uma boa pessoa."

# game/script3.rpy:10546
translate pt_br_anubisbr scene87_choice04_op4_e1a5ee9c:

#   selene "You're really going to help?"
    selene "Você vai mesmo ajudar?"

# game/script3.rpy:10552
translate pt_br_anubisbr scene87_choice04_op4_cf9f908e:

#   mc "I'm not promising anything. But I'll try my best."
    mc "Não estou prometendo nada. Mas farei o meu melhor."

# game/script3.rpy:10553
translate pt_br_anubisbr scene87_choice04_op4_a434771a:

#   mc "For now I need my horse. And I have to be somewhere by midnight."
    mc "Por agora preciso do meu cavalo. E tenho que estar em algum lugar antes da meia-noite."

# game/script3.rpy:10555
translate pt_br_anubisbr scene87_choice04_op4_11c17f6c:

#   lena "You want us to wait?"
    lena "Você quer que a gente espere?"

# game/script3.rpy:10557
translate pt_br_anubisbr scene87_choice04_op4_aa9260ac:

#   mc "Yes. Can you wait till at least tomorrow or after, Serena?"
    mc "Sim. Você pode esperar pelo menos até amanhã ou depois, Serena?"

# game/script3.rpy:10559
translate pt_br_anubisbr scene87_choice04_op4_480e6d80:

#   selene "I can!"
    selene "Eu posso!"

# game/script3.rpy:10561
translate pt_br_anubisbr scene87_choice04_op4_cfad6fb5:

#   mc "Good. Keep your mother on a leash, she's the one I'm worried about."
    mc "Ótimo. Mantenha sua mãe sob controle, é com ela que estou preocupado."

# game/script3.rpy:10563
translate pt_br_anubisbr scene87_choice04_op4_1973e160:

#   lena "*chuckles* Fine. I'll wait. Your horse is in the last stall on the right. Saddled and ready."
    lena "*risos* Tudo bem. Eu espero. Seu cavalo está na última baia à direita. Selado e pronto."

# game/script3.rpy:10565
translate pt_br_anubisbr scene87_choice04_op4_15f75a6f:

#   selene "Thank you, [mc]. Just for listening."
    selene "Obrigado, [mc] Apenas para ouvir."

# game/script3.rpy:10567
translate pt_br_anubisbr scene87_choice04_op4_195d265f:

#   mc "Don't thank me yet. Get some rest, Serena. You look like you need it."
    mc "Não me agradeça ainda. Descanse um pouco, Serena. Você parece precisar."

# game/script3.rpy:10568
translate pt_br_anubisbr scene87_choice04_op4_9ff8c9c6:

#   mc "If everything goes well, I'll meet you two here tommorrow or after at dawn. Sounds good?"
    mc "Se tudo correr bem, encontro vocês dois aqui amanhã ou depois, ao amanhecer. Combinado?"

# game/script3.rpy:10570
translate pt_br_anubisbr scene87_choice04_op4_6a68359f:

#   lena "Don't make me regret this, [mc]."
    lena "Não me faça me arrepender disso, [mc]."

# game/script3.rpy:10573
translate pt_br_anubisbr scene87_choice04_op4_b7c66adf:

#   perception "As you turn to leave, you see Serena offer you a small, fragile smile, the first spark of hope you've seen in her eyes today."
    perception "Ao se virar para ir embora, você vê Serena lhe oferecer um sorriso pequeno e frágil, a primeira faísca de esperança que você viu em seus olhos hoje."

# game/script3.rpy:10549
translate pt_br_anubisbr scene87_choice04_op4_e1a5ee9c_1:

#   selene "You're really going to help?"
    selene "Você vai mesmo ajudar?"

# game/script3.rpy:10578
translate pt_br_anubisbr scene87_choice03_op2_41522819:

#   mc "I can't afford to attract more trouble right now. My plate is already overflowing, and people are depending on me."
    mc "Não posso me dar ao luxo de atrair mais problemas agora. Já estou sobrecarregado e as pessoas dependem de mim."

# game/script3.rpy:10579
translate pt_br_anubisbr scene87_choice03_op2_dccecdb5:

#   selene "..."
    selene "..."

# game/script3.rpy:10581
translate pt_br_anubisbr scene87_choice03_op2_83d05c24:

#   selene "I... I understand. Thank you for listening, [mc]."
    selene "Eu... eu entendo. Obrigado por me ouvir. [mc]."

# game/script3.rpy:10583
translate pt_br_anubisbr scene87_choice03_op2_37bddf63:

#   mc "I'm sorry, Serena. What's happening to you is wrong."
    mc "Sinto muito, Serena. O que está acontecendo com você está errado."

# game/script3.rpy:10585
translate pt_br_anubisbr scene87_choice03_op2_26818518:

#   lena "Sorry doesn't fill a belly or buy freedom. Your horse is in the last stall. Just take it and go."
    lena "Pedir desculpas não enche a barriga nem compra a liberdade. Seu cavalo está na última baia. Simplesmente pegue-o e vá embora."

# game/script3.rpy:10587
translate pt_br_anubisbr scene87_choice03_op2_94469365:

#   mc "You two should think more about it. Especially you, Lena. Don't leave your daughter alone."
    mc "Vocês duas deveriam pensar melhor sobre isso. Principalmente você, Lena. Não deixe sua filha sozinha."

# game/script3.rpy:10588
translate pt_br_anubisbr scene87_choice03_op2_31e7e40e:

#   lena "..."
    lena "..."

# game/script3.rpy:10590
translate pt_br_anubisbr scene87_choice03_op2_25757ab0:

#   empathy "As you turn to leave, Lena places a firm but comforting hand on Serena's trembling shoulder. The conversation is over."
    empathy "Ao se virar para sair, Lena coloca uma mão firme, porém reconfortante, no ombro trêmulo de Serena. A conversa terminou."

# game/script3.rpy:10598
translate pt_br_anubisbr scene87_4_907289a5:

#   mc "Miss me, girl?"
    mc "Sentiu minha falta, garota?"

# game/script3.rpy:10599
translate pt_br_anubisbr scene87_4_5db04f77:

#   mc "Let's get you out of here before any guards come wandering in."
    mc "Vamos tirar você daqui antes que algum guarda apareça."

# game/script3.rpy:10604
translate pt_br_anubisbr scene87_4_39cc24dd:

#   mc "Stay here. I'll be back for you soon."
    mc "Fique aqui. Voltarei em breve para te buscar."

# game/script3.rpy:10605
translate pt_br_anubisbr scene87_4_4f294868:

#   horse "Neigh!"
    horse "Relinchar!"

# game/script3.rpy:10606
translate pt_br_anubisbr scene87_4_ad80a68f:

#   mc "Ah, right... I'm sorry for leaving you so long, [horse]. I'll make it up to you, promise."
    mc "Ah, certo... Desculpe por ter te deixado tanto tempo longe. [horse] Eu vou compensar você, prometo."

# game/script3.rpy:10608
translate pt_br_anubisbr scene87_4_f3750d56:

#   mc "Would you look at that... It's still here after all this time."
    mc "Olha só... Ainda está aqui depois de todo esse tempo."

# game/script3.rpy:10609
translate pt_br_anubisbr scene87_4_46e92562:

#   mc "I got a brand new sword now so I don't need it. Alex or Reham will make better use of it. Hold on to it a bit longer, alright? I'm supposed to do this quietly afterall."
    mc "Agora tenho uma espada novinha em folha, então não preciso dela. Alex ou Reham farão melhor uso dela. Guarde-a mais um pouco, está bem? Afinal, eu deveria fazer isso em silêncio."

# game/script3.rpy:10615
translate pt_br_anubisbr scene88_ca575690:

#   mc "(Dammit, of course the gate's going to be crawling with guards. What was I thinking?)"
    mc "(Droga, é claro que o portão vai estar cheio de guardas. O que eu estava pensando?)"

# game/script3.rpy:10616
translate pt_br_anubisbr scene88_06edc0ea:

#   mc "(What now?)"
    mc "(E agora?)"

# game/script3.rpy:10619
translate pt_br_anubisbr scene88_3f5edc7d:

#   mc "(Perfect timing.)"
    mc "(Momento perfeito.)"

# game/script3.rpy:10623
translate pt_br_anubisbr scene88_02cd6c2e:

#   mc "(The carriage stopped, now's my chance!)"
    mc "(A carruagem parou, agora é a minha chance!)"

# game/script3.rpy:10627
translate pt_br_anubisbr scene88_35e9cb71:

#   mc "(Phew. I'm getting some flashbacks...)"
    mc "(Ufa. Estou tendo alguns flashbacks...)"

# game/script3.rpy:10629
translate pt_br_anubisbr scene88_fd3602d0:

#   guard "Halt!"
    guard "Pare!"

# game/script3.rpy:10631
translate pt_br_anubisbr scene88_ef33a858:

#   guard "What's the load?"
    guard "Qual é a carga?"

# game/script3.rpy:10632
translate pt_br_anubisbr scene88_b96a9a42:

#   merchant "Grapes and wines galore, sir. And a few barrels of last season's red. A fine vintage, care for a taste?"
    merchant "Uvas e vinhos em abundância, senhor. E alguns barris do tinto da safra passada. Uma excelente safra, gostaria de provar?"

# game/script3.rpy:10633
translate pt_br_anubisbr scene88_6a620ec1:

#   guard "Open that one."
    guard "Abra essa."

# game/script3.rpy:10635
translate pt_br_anubisbr scene88_991718e4:

#   mc "(Shit!)"
    mc "(Merda!)"

# game/script3.rpy:10636
translate pt_br_anubisbr scene88_bffac97c:

#   merchant "All these new rules... pain in the arse, if you'll pardon me saying."
    merchant "Todas essas novas regras... um saco, se me permitem dizer."

# game/script3.rpy:10638
translate pt_br_anubisbr scene88_667b2159:

#   guard "Clear. Move on."
    guard "Limpo. Siga em frente."

# game/script3.rpy:10640
translate pt_br_anubisbr scene88_4c391e7a:

#   merchant "Tch. City's gone mad, I tell ya."
    merchant "Puxa. A cidade enlouqueceu, eu te digo."

# game/script3.rpy:10642
translate pt_br_anubisbr scene88_05f94f90:

#   guard "Move along. Now."
    guard "Circulem. Agora."

# game/script3.rpy:10645
translate pt_br_anubisbr scene88_0ae9bcd0:

#   ""
    ""

# game/script3.rpy:10648
translate pt_br_anubisbr scene88_1bce3e5e:

#   merchant "Delivery for Relis Winery!"
    merchant "Entrega para a Vinícola Relis!"

# game/script3.rpy:10649
translate pt_br_anubisbr scene88_01effc97:

#   merchant "Haulers'll be right with you."
    merchant "Os transportadores chegarão em breve."

# game/script3.rpy:10650
translate pt_br_anubisbr scene88_7d5a1c1e:

#   mc "(Far enough. Time to go.)"
    mc "(Já fui longe o suficiente. Hora de ir.)"

# game/script3.rpy:10655
translate pt_br_anubisbr scene88_4b439ce9:

#   mc "(Hmm? There's a huge crowd gathered here.)"
    mc "(Hum? Tem uma multidão enorme reunida aqui.)"

# game/script3.rpy:10657
translate pt_br_anubisbr scene88_5061824a:

#   storyteller "And there he stood—the wanderer fallen from grace, facing none other than Gaius the Unbroken! Champion of a hundred wars!"
    storyteller "E lá estava ele — o andarilho caído em desgraça, encarando ninguém menos que Caio, o Inquebrável! Campeão de cem guerras!"

# game/script3.rpy:10659
translate pt_br_anubisbr scene88_8b748a8c:

#   grumpy_dwarf "*snort* Gaius? {i}The{/i} Gaius? No one messes with him and lives to talk about it. Man's cracked in the head."
    grumpy_dwarf "*bufa* Gaius? {i} O{/i} Gaius? Ninguém se mete com ele e sai vivo para contar a história. O cara é maluco da cabeça."

# game/script3.rpy:10661
translate pt_br_anubisbr scene88_9fd32d04:

#   storyteller "Aye, the very same! He towered over the wanderer like an oak over a sapling, his greatsword longer than a man is tall, the sun flashing off his dented armor!"
    storyteller "Sim, exatamente o mesmo! Ele se erguia sobre o andarilho como um carvalho sobre uma muda, sua espada longa mais comprida que a altura de um homem, o sol refletindo em sua armadura amassada!"

# game/script3.rpy:10663
translate pt_br_anubisbr scene88_2ba7cf0c:

#   storyteller "Gaius charged like thunder, blade whistling death! But the wanderer! Oh, the wanderer danced aside like autumn leaves in a gale! And struck true! First blood staining the flowers, painting them crimson!"
    storyteller "Caio investiu como um trovão, a lâmina assobiando a morte! Mas o andarilho! Oh, o andarilho desviou-se como folhas de outono em uma tempestade! E acertou em cheio! O primeiro sangue manchando as flores, pintando-as de carmesim!"

# game/script3.rpy:10665
translate pt_br_anubisbr scene88_9d75c244:

#   grumpy_dwarf "First blood? Against Gaius? Stop talking outta your ass."
    grumpy_dwarf "Primeiro sangue? Contra Gaius? Pare de falar besteira."

# game/script3.rpy:10667
translate pt_br_anubisbr scene88_12af38f4:

#   storyteller "By my mother's honor! Again and again they clashed! Sparks flying, steel biting steel! Gaius roared, a sound fit to shake the mountains themselves! But the wanderer pressed on, relentless, a storm wearing a man's skin!"
    storyteller "Pela honra de minha mãe! Eles se chocaram repetidas vezes! Faíscas voando, aço cortando aço! Gaius rugiu, um som capaz de fazer as montanhas tremerem! Mas o andarilho prosseguiu, implacável, uma tempestade vestindo a pele de um homem!"

# game/script3.rpy:10669
translate pt_br_anubisbr scene88_afc6a5eb:

#   snarky_dwarf "And then he flew off on a dragon, yeah?"
    snarky_dwarf "E então ele voou para longe montado em um dragão, né?"

# game/script3.rpy:10671
translate pt_br_anubisbr scene88_4d1574e8:

#   perception "Laughter ripples through the crowd. A few people shake their heads as they drift away."
    perception "Risos ecoam pela multidão. Algumas pessoas balançam a cabeça enquanto se dispersam."

# game/script3.rpy:10673
translate pt_br_anubisbr scene88_f972b92a:

#   storyteller "Nay, my lady! With one final slash, the wanderer was driven back... wounded, but alive! And Gaius... Gaius still stands unbroken, his title intact."
    storyteller "Não, minha senhora! Com um golpe final, o andarilho foi repelido... ferido, mas vivo! E Caio... Caio permanece inabalável, seu título intacto."

# game/script3.rpy:10675
translate pt_br_anubisbr scene88_ba69fd2d:

#   orym "That 'wanderer' is probably rotting in a ditch somewhere. No way he was let go that easily."
    orym "Esse \"andarilho\" provavelmente está apodrecendo em alguma vala. De jeito nenhum ele foi solto tão facilmente."

# game/script3.rpy:10676
translate pt_br_anubisbr scene88_31617a3f:

#   orym "Regardless, with that fool gone, the princess is open for marriage again. Grieving. In desperate need of a man's touch. A {i}real{/i} man."
    orym "De qualquer forma, com aquele tolo fora de cena, a princesa está solteira novamente. De luto. Precisando desesperadamente do toque de um homem. {i} real{/i} homem."

# game/script3.rpy:10678
translate pt_br_anubisbr scene88_e3f4322a:

#   snarky_dwarf "*laughs* As if she'd ever look twice at a knife-eared browless fuck like you."
    snarky_dwarf "*risos* Como se ela fosse dar uma segunda olhada num idiota sem sobrancelhas e com orelhas pontudas como você."

# game/script3.rpy:10680
translate pt_br_anubisbr scene88_749fe8da:

#   orym "Shut it, gnome! Watch your tongue or I'll cut it off."
    orym "Cala a boca, gnomo! Cuidado com a língua ou eu corto fora!"

# game/script3.rpy:10682
translate pt_br_anubisbr scene88_599cb859:

#   grumpy_dwarf "Bah! What a load of ogre-piss. Shoulda listened to that lusty lady bard."
    grumpy_dwarf "Bah! Que monte de besteira! Devia ter escutado aquela barda lasciva."

# game/script3.rpy:10683
translate pt_br_anubisbr scene88_4248e1ca:

#   perception "The crowd slowly dissipates until only you and the storyteller remain."
    perception "A multidão vai se dispersando aos poucos até que restem apenas você e o contador de histórias."

# game/script3.rpy:10652
translate pt_br_anubisbr scene88_0ae9bcd0_1:

#   ""
    ""

# game/script3.rpy:10694
translate pt_br_anubisbr scene88_choice01_op1_e0595471:

#   perception "You toss a copper coin into the small wooden box with a genuine smile."
    perception "Você joga uma moeda de cobre na pequena caixa de madeira com um sorriso genuíno."

# game/script3.rpy:10696
translate pt_br_anubisbr scene88_choice01_op1_0bb569df:

#   storyteller "Ah! A connoisseur of the arts! You, sir, have the soul of a poet!"
    storyteller "Ah! Um conhecedor das artes! O senhor tem alma de poeta!"

# game/script3.rpy:10700
translate pt_br_anubisbr scene88_choice01_op1_818c2b96:

#   mc "I enjoyed the story. Don't let them get to you."
    mc "Gostei da história. Não deixe que eles te afetem."

# game/script3.rpy:10702
translate pt_br_anubisbr scene88_choice01_op1_29eb864b:

#   storyteller "But of course. Tis the life of a storyteller. Folks laugh, scoff, walk away—but the stories remain, even when they don't."
    storyteller "Mas é claro. Essa é a vida de um contador de histórias. As pessoas riem, zombam, vão embora — mas as histórias permanecem, mesmo quando elas não desaparecem."

# game/script3.rpy:10704
translate pt_br_anubisbr scene88_choice01_op1_e51ddbca:

#   storyteller "May the road be kind to you, sir!"
    storyteller "Que a estrada lhe seja favorável, senhor!"

# game/script3.rpy:10710
translate pt_br_anubisbr scene88_choice01_op2_a876b0a3:

#   mc "That's quite a story, how did you hear about it?"
    mc "Que história interessante! Como você ficou sabendo dela?"

# game/script3.rpy:10712
translate pt_br_anubisbr scene88_choice01_op2_a55348e8:

#   storyteller "Tales travel, my friend. On the breath of the wind, in the whispers of traders, in the excuses of soldiers trying to explain the inexplicable."
    storyteller "As histórias viajam, meu amigo. No sopro do vento, nos sussurros dos comerciantes, nas desculpas dos soldados que tentam explicar o inexplicável."

# game/script3.rpy:10714
translate pt_br_anubisbr scene88_choice01_op2_da2ed740:

#   mc "I couldn't help but notice that some of your details are off."
    mc "Não pude deixar de notar que alguns dos seus dados estão incorretos."

# game/script3.rpy:10716
translate pt_br_anubisbr scene88_choice01_op2_766fca80:

#   storyteller "Of course they are. It is my rule—as a storyteller, nay, as an {i}artist{/i}, to fill the gaps. To give shape where memory falters."
    storyteller "Claro que sim. É a minha regra — como contador de histórias, aliás, como um... {i} artista{/i}Para preencher as lacunas. Para dar forma onde a memória falha."

# game/script3.rpy:10717
translate pt_br_anubisbr scene88_choice01_op2_48bd64d4:

#   storyteller "To turn an event into a legend meant to outlive those who witnessed it."
    storyteller "Transformar um evento em uma lenda que sobreviva àqueles que a testemunharam."

# game/script3.rpy:10719
translate pt_br_anubisbr scene88_choice01_op2_8e21acf3:

#   mc "So it isn't completely true."
    mc "Portanto, não é totalmente verdade."

# game/script3.rpy:10721
translate pt_br_anubisbr scene88_choice01_op2_6d1f6959:

#   storyteller "Is a river true? It changes with every bend, yet it remains the same river. A man defied a giant and the giant bled. I merely built the cathedral around it."
    storyteller "Um rio é verdadeiro? Ele muda a cada curva, mas continua sendo o mesmo rio. Um homem desafiou um gigante e o gigante sangrou. Eu apenas construí a catedral ao redor dele."

# game/script3.rpy:10723
translate pt_br_anubisbr scene88_choice01_op2_8d2bac67:

#   mc "I see. I should be going. Good luck to you."
    mc "Entendi. Eu já vou indo. Boa sorte para você."

# game/script3.rpy:10725
translate pt_br_anubisbr scene88_choice01_op2_6f3964a7:

#   storyteller "Farewell, sir!"
    storyteller "Adeus, senhor!"

# game/script3.rpy:10731
translate pt_br_anubisbr scene88_choice01_op3_1cfe0583:

#   mc "(At least someone's finding joy in my misery.)"
    mc "(Pelo menos alguém está encontrando alegria na minha miséria.)"

# game/script3.rpy:10733
translate pt_br_anubisbr scene88_choice01_op3_1aa177f3:

#   perception "You shake your head, the storyteller's vivid words echoing in your mind as you continue moving through the empty allyways."
    perception "Você balança a cabeça, as palavras vívidas do contador de histórias ecoando em sua mente enquanto você continua caminhando pelos becos vazios."

# game/script3.rpy:10741
translate pt_br_anubisbr scene89_10774e79:

#   mc "(Good thing it's tucked away like that.)"
    mc "(Ainda bem que está escondido assim.)"

# game/script3.rpy:10744
translate pt_br_anubisbr scene89_88f9c9b0:

#   dean "Bring me two iron billets and a sack of charcoal. Be careful with both. They're heavy."
    dean "Traga-me dois lingotes de ferro e um saco de carvão. Tenha cuidado com ambos. São pesados."

# game/script3.rpy:10745
translate pt_br_anubisbr scene89_68a01240:

#   yuuhi "Would you please stop treating me like I'm still ten? I've got it."
    yuuhi "Você poderia parar de me tratar como se eu ainda tivesse dez anos? Eu já entendi."

# game/script3.rpy:10747
translate pt_br_anubisbr scene89_3bedfae7:

#   yuuhi "Execuse me."
    yuuhi "Com licença."

# game/script3.rpy:10748
translate pt_br_anubisbr scene89_2b35b6fe:

#   mc "..."
    mc "..."

# game/script3.rpy:10750
translate pt_br_anubisbr scene89_a841b39a:

#   yuuhi "Two iron billets... and one sack of charcoal."
    yuuhi "Dois lingotes de ferro... e um saco de carvão."

# game/script3.rpy:10755
translate pt_br_anubisbr scene89_choice01_op1_12a534a9:

#   mc "Hey, Yuuhi."
    mc "Ei, Yuuhi."

# game/script3.rpy:10757
translate pt_br_anubisbr scene89_choice01_op1_99c66b2e:

#   yuuhi "Ahh!"
    yuuhi "Ahh!"

# game/script3.rpy:10758
translate pt_br_anubisbr scene89_choice01_op1_ef2f3395:

#   yuuhi "Who—?"
    yuuhi "Quem-?"

# game/script3.rpy:10760
translate pt_br_anubisbr scene89_choice01_op1_db1fa5b8:

#   yuuhi "[mc]! Y-You're... you're alive!"
    yuuhi "[mc]! V-Você... você está vivo!"

# game/script3.rpy:10766
translate pt_br_anubisbr scene89_choice01_op1_1dd4d00b:

#   sensation "She drops whatever she's holding and throws her arms around you, hugging tight as she kisses you. The warmth of her lips quickly chases the cold from your skin."
    sensation "Ela larga o que estiver segurando e te abraça forte, te beijando com paixão. O calor dos lábios dela rapidamente dissipa o frio da sua pele."

# game/script3.rpy:10768
translate pt_br_anubisbr scene89_choice01_op1_2efea69d:

#   yuuhi "I thought... everyone said you were dead, or captured, or..."
    yuuhi "Eu pensei... que todos diziam que você estava morto, ou capturado, ou..."

# game/script3.rpy:10770
translate pt_br_anubisbr scene89_choice01_op1_d5f2af96:

#   mc "It would take more than that to keep me down."
    mc "Seria preciso mais do que isso para me derrubar."

# game/script3.rpy:10772
translate pt_br_anubisbr scene89_choice01_op1_1bf0d76c:

#   yuuhi "You idiot! Why didn't you send word? I've been worried sick!"
    yuuhi "Seu idiota! Por que você não mandou mensagem? Eu estava morrendo de preocupação!"

# game/script3.rpy:10773
translate pt_br_anubisbr scene89_choice01_op1_7cf7643a:

#   yuuhi "Don't ever scare me like that again!"
    yuuhi "Nunca mais me assuste assim!"

# game/script3.rpy:10775
translate pt_br_anubisbr scene89_choice01_op1_4bcfc617:

#   mc "I'm afraid I'll be giving you lots of scares from now on."
    mc "Receio que, de agora em diante, vou lhe dar muitos sustos."

# game/script3.rpy:10781
translate pt_br_anubisbr scene89_choice01_op1_106f04da:

#   yuuhi "You got into some awfully serious trouble. Why are you coming back here? It's not safe."
    yuuhi "Você se meteu em uma encrenca muito séria. Por que está voltando para cá? Não é seguro."

# game/script3.rpy:10782
translate pt_br_anubisbr scene89_choice01_op1_93ad455a:

#   yuuhi "D-Don't worry, I won't tell on you. Whatever you did, I'm sure you did it for a good reason. You're not a bad person as the guards say."
    yuuhi "Não se preocupe, eu não vou te dedurar. Seja lá o que você tenha feito, tenho certeza de que foi por um bom motivo. Você não é uma pessoa má como os guardas dizem."

# game/script3.rpy:10777
translate pt_br_anubisbr scene89_choice01_op1_2efea69d_1:

#   yuuhi "I thought... everyone said you were dead, or captured, or..."
    yuuhi "Eu pensei... que todos diziam que você estava morto, ou capturado, ou..."

# game/script3.rpy:10779
translate pt_br_anubisbr scene89_choice01_op1_d5f2af96_1:

#   mc "It would take more than that to keep me down."
    mc "Seria preciso mais do que isso para me derrubar."

# game/script3.rpy:10789
translate pt_br_anubisbr scene89_choice01_op2_34ebd24d:

#   perception "You move silently, heart racing with mischief. The angle is perfect, her guard down, focused on the crates."
    perception "Você se move silenciosamente, o coração acelerado pela malícia. O ângulo é perfeito, ela está desprevenida, concentrada nas caixas."

# game/script3.rpy:10790
translate pt_br_anubisbr scene89_choice01_op2_83ec8ffb:

#   yuuhi "*whisteling*"
    yuuhi "*assobiando*"

# game/script3.rpy:10793
translate pt_br_anubisbr scene89_choice01_op2_97de0bc2:

#   sensation "Your palm connects with a firm smack, sharp sound echoing off the stone wall, her body jolting forward in surprise."
    sensation "Sua palma se choca com um estalo firme, o som agudo ecoando na parede de pedra, e o corpo dela se projeta para a frente em surpresa."

# game/script3.rpy:10794
translate pt_br_anubisbr scene89_choice01_op2_a0674120:

#   yuuhi "Ahhn!"
    yuuhi "Ahhn!"

# game/script3.rpy:10796
translate pt_br_anubisbr scene89_choice01_op2_ef215ffd:

#   yuuhi "What the-!?"
    yuuhi "Que diabos?!"

# game/script3.rpy:10798
translate pt_br_anubisbr scene89_choice01_op2_3a5428bf:

#   yuuhi "S-Stupid pervert! I will let you know that I already have a boyfriend and he'll beat you up!"
    yuuhi "Seu pervertido idiota! Vou te avisar que eu já tenho namorado e ele vai te dar uma surra!"

# game/script3.rpy:10800
translate pt_br_anubisbr scene89_choice01_op2_15ae8b5e:

#   yuuhi "S-Stupid pervert! My pops will make short work of you once I call him!"
    yuuhi "Seu pervertido estúpido! Meu pai vai acabar com você rapidinho assim que eu ligar para ele!"

# game/script3.rpy:10802
translate pt_br_anubisbr scene89_choice01_op2_d4439682:

#   yuuhi "You! You... You?"
    yuuhi "Você! Você... Você?"

# game/script3.rpy:10803
