#   mc "Stay back!"
    mc "Fique para trás!"

# game/script3.rpy:4701
translate pt_br_anubisbr scene79_2_8db00fbd:

#   alex "Why are you backing away? It's me, Alex!"
    alex "Por que você está se afastando? Sou eu, Alex!"

# game/script3.rpy:4703
translate pt_br_anubisbr scene79_2_507406c9:

#   mc "Why?! You're here to kill me, aren't you? Avery told me!"
    mc "Por quê?! Você veio aqui para me matar, não é? Avery me contou!"

# game/script3.rpy:4705
translate pt_br_anubisbr scene79_2_cb03a78c:

#   alex "Kill you!? What are you—?"
    alex "Te matar!? O que você é—?"

# game/script3.rpy:4706
translate pt_br_anubisbr scene79_2_84a677bb:

#   alex "Look, there's no time! The Queen, she's dead! My father and Av—"
    alex "Olha, não há tempo! A Rainha está morta! Meu pai e Av—"

# game/script3.rpy:4712
