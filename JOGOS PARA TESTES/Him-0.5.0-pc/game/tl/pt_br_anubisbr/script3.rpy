translate pt_br_anubisbr scene89_choice01_op2_424aeb2e:

#   yuuhi "Shut up..."
    yuuhi "Cale-se..."

# game/script3.rpy:10827
translate pt_br_anubisbr scene89_choice01_op2_b36cc547:

