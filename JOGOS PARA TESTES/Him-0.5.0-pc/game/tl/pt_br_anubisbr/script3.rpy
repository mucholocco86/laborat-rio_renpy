translate pt_br_anubisbr scene91_choice04_op1_01b43309:

#   tom_ "Who the hell are you? The doorman?"
    tom_ "Quem diabos é você? O porteiro?"

# game/script3.rpy:12110
translate pt_br_anubisbr scene91_choice04_op1_50c931e1:

#   tom_ "Or what? You gonna make me, masked boy?"
    tom_ "Ou o quê? Vai me obrigar, garoto mascarado?"

# game/script3.rpy:12113
translate pt_br_anubisbr scene91_choice04_op1_2b054b1b:

#   tom_ "..."
    tom_ "..."

# game/script3.rpy:12115
translate pt_br_anubisbr scene91_choice04_op1_9e2ec032:

#   tom_ "Fine! Shithole smithy. I'll take my business to someone who appreciates it!"
    tom_ "Ótimo! Ferraria de quinta categoria. Vou levar meu negócio para alguém que o valorize!"

# game/script3.rpy:12117
translate pt_br_anubisbr scene91_choice04_op1_4aa16d63:

#   tom_ "*sniff* It just had to burn down... where the hell am I ever going to find a job now..."
    tom_ "*snif* Tinha que pegar fogo mesmo... onde diabos vou arranjar emprego agora...?"

# game/script3.rpy:12120
translate pt_br_anubisbr scene91_choice04_op1_5cf236ff:

#   yuuhi "*sigh* ...Thank you. He was... awful."
    yuuhi "*suspiro* ...Obrigada. Ele foi... péssimo."

# game/script3.rpy:12122
translate pt_br_anubisbr scene91_choice04_op1_4cd61d06:

#   mc "You don't have to thank me. You were professional and he wasn't a customer."
    mc "Não precisa me agradecer. Você foi profissional e ele não era um cliente."

# game/script3.rpy:12124
translate pt_br_anubisbr scene91_choice04_op1_c64b1f83:

#   yuuhi "I know. But I always feel like I should try... that maybe I'm not being understanding enough. He was clearly in a bad way."
    yuuhi "Eu sei. Mas sempre sinto que deveria tentar... que talvez eu não esteja sendo compreensiva o suficiente. Ele claramente estava em uma situação difícil."

# game/script3.rpy:12126
translate pt_br_anubisbr scene91_choice04_op1_c5cb828e:

#   mc "Being drunk isn't a license to be cruel. Protecting your shop and your peace isn't a failure. It's sense."
    mc "Estar bêbado não é licença para ser cruel. Proteger sua loja e sua paz não é fracasso. É sensato."

# game/script3.rpy:12128
translate pt_br_anubisbr scene91_choice04_op1_958db99e:

#   yuuhi "You're right, it is. Thanks again, [mc]."
    yuuhi "Você tem razão, é mesmo. Obrigado novamente. [mc]."

# game/script3.rpy:12131
translate pt_br_anubisbr scene91_choice04_op1_550b86d2:

#   mc "I always protect my girl."
    mc "Eu sempre protejo minha garota."

# game/script3.rpy:12132
translate pt_br_anubisbr scene91_choice04_op1_256eefef:

#   yuuhi "Hehe~"
    yuuhi "Hehe~"

# game/script3.rpy:12104
translate pt_br_anubisbr scene91_choice04_op1_5b626532_1:

#   mc "You heard her. She gave you the terms. You don't like them? The door's right there."
    mc "Você a ouviu. Ela lhe apresentou as condições. Não gostou? A porta está ali."

# game/script3.rpy:12108
translate pt_br_anubisbr scene91_choice04_op1_86b47452_1:

#   mc "Right now, I am. You don't talk to her like that. Not here. Pick up your pig-iron and leave."
    mc "Neste momento, sim. Não se fala assim com ela. Não aqui. Pegue seu ferro de passar e vá embora."

# game/script3.rpy:12112
translate pt_br_anubisbr scene91_choice04_op1_60870026_1:

#   mc "You have three seconds to be gone before I help you through the door. I won't be gentle."
    mc "Você tem três segundos para sair antes que eu te ajude a passar pela porta. Não serei gentil."

# game/script3.rpy:12138
translate pt_br_anubisbr scene91_choice04_op2_5a46b34e:

#   mc "We can have it serviceable by tomorrow. Fifteen silver. Non-negotiable."
    mc "Podemos deixá-lo pronto para uso amanhã. Quinze moedas de prata. Não negociável."

# game/script3.rpy:12140
translate pt_br_anubisbr scene91_choice04_op2_9b9d26b7:

#   tom "Serviceable? What's that mean?"
    tom "Em condições de uso? O que isso significa?"

# game/script3.rpy:12142
translate pt_br_anubisbr scene91_choice04_op2_c529ff55:

#   mc "It means sharp, not pretty. It won't be a masterpiece, and it won't hold that edge for long, but it'll cut. That's the deal."
    mc "Significa afiado, não bonito. Não será uma obra-prima, e não manterá esse fio por muito tempo, mas cortará. É isso aí."

# game/script3.rpy:12144
translate pt_br_anubisbr scene91_choice04_op2_3cb69cb4:

#   tom "*scoff* ...Fine, dat's what I wanted anyway. Fifteen. Tomorrow before noon."
    tom "*bufa* ...Tudo bem, era isso que eu queria mesmo. Quinze. Amanhã antes do meio-dia."

# game/script3.rpy:12148
translate pt_br_anubisbr scene91_choice04_op2_c4a5ef83:

#   tom_ "Serviceable? What's that mean?"
    tom_ "Em condições de uso? O que isso significa?"

# game/script3.rpy:12152
translate pt_br_anubisbr scene91_choice04_op2_d833503d:

#   tom_ "*scoff* ...Fine, dat's I wanted anyway. Fifteen. Tomorrow before noon."
    tom_ "*bufa* ...Tudo bem, era isso que eu queria mesmo. Quinze. Amanhã antes do meio-dia."

# game/script3.rpy:12155
translate pt_br_anubisbr scene91_choice04_op2_35c861cb:

#   mc "Agreed. Leave it."
    mc "Concordo. Deixe assim."

# game/script3.rpy:12157
translate pt_br_anubisbr scene91_choice04_op2_b5cc81aa:

#   perception "The man grunts, shoves the sword further across the counter, and fumbles a handful of coins from his purse, dropping them. He turns and leaves without another word."
    perception "O homem resmunga, empurra a espada mais para o outro lado do balcão e tira um punhado de moedas da bolsa, deixando-as cair. Ele se vira e sai sem dizer mais nada."

# game/script3.rpy:12159
translate pt_br_anubisbr scene91_choice04_op2_80ec91c4:

#   yuuhi "*sigh* I'm glad you handled him. But this... it's a butcher's job. It goes against everything Pops works for."
    yuuhi "*Suspiro* Que bom que você lidou com ele. Mas isso... é um trabalho de açougueiro. Vai contra tudo o que o Pops representa."

# game/script3.rpy:12161
translate pt_br_anubisbr scene91_choice04_op2_58a0e450:

#   mc "Not every customer deserves your best work. Just give him a quick fix."
    mc "Nem todo cliente merece o seu melhor trabalho. Dê a ele apenas um conserto rápido."

# game/script3.rpy:12163
translate pt_br_anubisbr scene91_choice04_op2_6ee66609:

#   yuuhi "Y-You're right. I'll tell Pops to get the grinding wheel ready."
    yuuhi "É verdade. Vou dizer ao papai para preparar a rebolo."

# game/script3.rpy:12146
translate pt_br_anubisbr scene91_choice04_op2_5a46b34e_1:

#   mc "We can have it serviceable by tomorrow. Fifteen silver. Non-negotiable."
    mc "Podemos deixá-lo pronto para uso amanhã. Quinze moedas de prata. Não negociável."

# game/script3.rpy:12150
translate pt_br_anubisbr scene91_choice04_op2_c529ff55_1:

#   mc "It means sharp, not pretty. It won't be a masterpiece, and it won't hold that edge for long, but it'll cut. That's the deal."
    mc "Significa afiado, não bonito. Não será uma obra-prima, e não manterá esse fio por muito tempo, mas cortará. É isso aí."

# game/script3.rpy:12170
translate pt_br_anubisbr scene91_4_5ad2232b:

#   yuuhi "Do you read, [mc]? I've been reading this novel... well, more like an illustrated one. It's about a girl blessed with strange powers."
    yuuhi "Você lê? [mc] Eu estava lendo um romance... bem, na verdade, uma versão ilustrada. É sobre uma garota que tem poderes estranhos."

# game/script3.rpy:12171
translate pt_br_anubisbr scene91_4_b252a346:

#   yuuhi "It's really dark at first because she can't control them, she even accidentally kills her own lover ...wait. I shouldn't have said that. Dammit!"
    yuuhi "No começo é tudo muito sombrio porque ela não consegue controlá-los, ela até mata acidentalmente o próprio amante... espera. Eu não devia ter dito isso. Droga!"

# game/script3.rpy:12174
translate pt_br_anubisbr scene91_4_0f925d10:

#   perception "The door doesn't so much open as it is dominated. A mountain of a man ducks beneath the frame, then straightens to his full, imposing height, filling the smithy with his presence."
    perception "A porta não se abre propriamente, ela é dominada. Um homem enorme se abaixa sob o batente, depois se endireita, revelando toda a sua imponência, e preenche a forja com sua presença."

# game/script3.rpy:12176
translate pt_br_anubisbr scene91_4_59f2dad6:

#   mc "...Whoa."
    mc "...Uau."

# game/script3.rpy:12178
translate pt_br_anubisbr scene91_4_b3276aa3:

#   yuuhi "O-Oh! Welcome, sir! Can I help you with something?"
    yuuhi "Oh! Bem-vindo, senhor! Posso ajudá-lo em algo?"

# game/script3.rpy:12181
translate pt_br_anubisbr scene91_4_9117a941:

#   thulkin "By all the Gods, I hope so! The fellows at the tavern said, 'Thulkin, if you want an edge that'll last, you go to the forge with the intersecting swords on the sign!' So here I am!"
    thulkin "Por todos os deuses, espero que sim! Os caras da taverna disseram: \"Thulkin, se você quer uma lâmina afiada que dure, vá à forja com as espadas entrelaçadas na placa!\" Então aqui estou eu!"

# game/script3.rpy:12183
translate pt_br_anubisbr scene91_4_be77015a:

#   yuuhi "Th-Then you came to the right place! What can we do for you, Sir Thulkin?"
    yuuhi "Então você veio ao lugar certo! O que podemos fazer por você, Sir Thulkin?"

# game/script3.rpy:12185
translate pt_br_anubisbr scene91_4_75fd2f3a:

#   thulkin "Take a look at this. The love of my life... wounded."
    thulkin "Dê uma olhada nisso. O amor da minha vida... ferido."

# game/script3.rpy:12187
translate pt_br_anubisbr scene91_4_defc1303:

#   perception "He lifts his great-axe with surprising tenderness. A deep, ugly chip mars the blade on the edge, metal torn away as if bitten."
    perception "Ele ergue seu machado com uma delicadeza surpreendente. Uma lasca profunda e feia marca a lâmina na borda, metal arrancado como se tivesse sido mordido."

# game/script3.rpy:12189
translate pt_br_anubisbr scene91_4_2b728421:

#   thulkin "Had a disagreement with an ogre's skull about thirty miles north of here. My swing was true, but his skull was harder than I gave it credit for!"
    thulkin "Tive um desentendimento com o crânio de um ogro a uns cinquenta quilômetros daqui. Meu golpe foi certeiro, mas o crânio dele era mais duro do que eu imaginava!"

# game/script3.rpy:12191
translate pt_br_anubisbr scene91_4_745f5b87:

#   yuuhi "A-An ogre!?"
    yuuhi "Um ogro!?"

# game/script3.rpy:12193
translate pt_br_anubisbr scene91_4_9692e3b0:

#   thulkin "Came charging out of the treeline at dusk, all froth and fury. Thought I'd make a fine supper!"
    thulkin "Surgiu da linha das árvores ao entardecer, furioso e cheio de espuma. Pensou que eu seria um belo jantar!"

# game/script3.rpy:12195
translate pt_br_anubisbr scene91_4_da7b89b0:

#   thulkin "*laughs* He learned otherwise, but he left his mark on my favorite girl here."
    thulkin "*risos* Ele aprendeu da outra forma, mas deixou sua marca na minha garota favorita aqui."

# game/script3.rpy:12197
translate pt_br_anubisbr scene91_4_fde9c232:

#   mc "You travel alone? Through the wilds with ogres?"
    mc "Você viaja sozinho? Pelas terras selvagens com ogros?"

# game/script3.rpy:12199
translate pt_br_anubisbr scene91_4_651578ff:

#   thulkin "Best way to travel! Company slows you down, and you miss all the best conversations! Though that one was more of a listener."
    thulkin "A melhor maneira de viajar! Companhia te atrasa e você perde as melhores conversas! Embora essa pessoa fosse mais ouvinte."

# game/script3.rpy:12200
translate pt_br_anubisbr scene91_4_be89ff4c:

#   thulkin "So! Can you fix her? I'd do it myself, but I'm a guest in your fine city."
    thulkin "Então! Você pode consertá-la? Eu mesmo faria isso, mas sou um convidado em sua bela cidade."

# game/script3.rpy:12202
translate pt_br_anubisbr scene91_4_d18be740:

#   yuuhi "This is a severe chip... We'll need to reforge the damaged section, then re-temper the entire blade to keep its balance. Anything less would weaken it."
    yuuhi "Essa lasca é grave... Precisaremos reforjar a seção danificada e, em seguida, refazer o revenimento de toda a lâmina para manter o equilíbrio. Qualquer coisa menos que isso a enfraqueceria."

# game/script3.rpy:12203
translate pt_br_anubisbr scene91_4_1925b137:

#   yuuhi "It's a full day's work, and it will require a master's hand."
    yuuhi "É um trabalho para o dia todo, e exigirá a mão de um mestre."

# game/script3.rpy:12205
translate pt_br_anubisbr scene91_4_cf534038:

#   thulkin "Excellent! I love a craftsman who doesn't mince words. A full day's honest work for a full day's honest pay! What's the damage?"
    thulkin "Excelente! Adoro um profissional que não usa meias palavras. Um dia inteiro de trabalho honesto por um dia inteiro de pagamento honesto! Qual o prejuízo?"

# game/script3.rpy:12207
translate pt_br_anubisbr scene91_4_e3b4f125:

#   yuuhi "Given the quality of the steel... one gold."
    yuuhi "Considerando a qualidade do aço... uma medalha de ouro."

# game/script3.rpy:12209
translate pt_br_anubisbr scene91_4_f6e7288c:

#   thulkin "*laughs* A fair price for saving my lady! Done!"
    thulkin "*risos* Um preço justo por salvar minha dama! Feito!"

# game/script3.rpy:12211
translate pt_br_anubisbr scene91_4_c1974310:

#   mc "By the accent, I assume you're not from here."
    mc "Pelo sotaque, presumo que você não seja daqui."

# game/script3.rpy:12213
translate pt_br_anubisbr scene91_4_720dd8f1:

#   thulkin "Sharp ears, my one-handed friend! Born and raised in the Valdrun fjords."
    thulkin "Ouvidos aguçados, meu amigo de uma só mão! Nascido e criado nos fiordes de Valdrun."

# game/script3.rpy:12214
translate pt_br_anubisbr scene91_4_e528c221:

#   thulkin "I came south with my sister, crossing the snowy mountains nearby. We've been tracking an elusive tribe of goblins who did unspeakable things back home."
    thulkin "Vim para o sul com minha irmã, atravessando as montanhas nevadas próximas. Estávamos rastreando uma tribo esquiva de goblins que cometeu atrocidades indizíveis em sua terra natal."

# game/script3.rpy:12215
translate pt_br_anubisbr scene91_4_2e3fc875:

#   thulkin "But before that... rumors! Lots of them from wandering traders."
    thulkin "Mas antes disso... rumores! Muitos deles vindos de comerciantes ambulantes."

# game/script3.rpy:12217
translate pt_br_anubisbr scene91_4_e896a4f0:

#   yuuhi "Rumors, sir?"
    yuuhi "Rumores, senhor?"

# game/script3.rpy:12219
translate pt_br_anubisbr scene91_4_dd425e7e:

#   thulkin "A queen dies at sea—a tragedy! Her sister takes the throne—politics! Then, boom! An explosion that shakes the very stones, they say big as a dragon's sigh!"
    thulkin "Uma rainha morre no mar — uma tragédia! Sua irmã assume o trono — política! Então, bum! Uma explosão que sacode as próprias pedras, dizem que tão grande quanto o suspiro de um dragão!"

# game/script3.rpy:12220
translate pt_br_anubisbr scene91_4_705ec971:

#   thulkin "That's a story! And when I hear a story that loud, my feet start moving by themselves. I had to come see the characters and the set-dressing for myself!"
    thulkin "Que história! E quando ouço uma história tão emocionante, meus pés começam a se mexer sozinhos. Eu precisava ver os personagens e o cenário com meus próprios olhos!"

# game/script3.rpy:12222
translate pt_br_anubisbr scene91_4_aea69fc4:

#   mc "It's a dangerous story to be part of."
    mc "É uma história perigosa da qual fazer parte."

# game/script3.rpy:12224
translate pt_br_anubisbr scene91_4_cd877fa5:

#   thulkin "All the best ones are! A safe story is a boring story. So, you're in the thick of it, are you? The quiet man in the smithy. You have the look about you."
    thulkin "Todas as melhores são assim! Uma história sem graça é uma história chata. Então, você está no meio da confusão, não é? O homem quieto na ferraria. Você tem aquele ar."

# game/script3.rpy:12226
translate pt_br_anubisbr scene91_4_f636c242:

#   yuuhi "He's, um, our new apprentice!"
    yuuhi "Ele é, hum, nosso novo aprendiz!"

# game/script3.rpy:12228
translate pt_br_anubisbr scene91_4_cacc44ee:

#   thulkin "Is he now? Well, every story needs a few mysterious fellows. Very well! I'll be back by tommorrow."
    thulkin "Será mesmo? Bem, toda história precisa de alguns personagens misteriosos. Muito bem! Volto amanhã."

# game/script3.rpy:12230
translate pt_br_anubisbr scene91_4_3a5b3eb0:

#   mc "Thank you for your business."
    mc "Agradecemos a sua preferência."

# game/script3.rpy:12232
translate pt_br_anubisbr scene91_4_ba41593e:

#   thulkin "Farewell, friends! Take good care of her."
    thulkin "Adeus, amigos! Cuidem bem dela."

# game/script3.rpy:12234
translate pt_br_anubisbr scene91_4_e961219e:

#   yuuhi "Phew..."
    yuuhi "Ufa..."

# game/script3.rpy:12236
translate pt_br_anubisbr scene91_4_298316fa:

#   mc "An interesting fellow. He talked like danger was a hobby, sounded a little crazy."
    mc "Um sujeito interessante. Falava como se o perigo fosse um passatempo, parecia um pouco maluco."

# game/script3.rpy:12238
translate pt_br_anubisbr scene91_4_eea6ddb5:

#   yuuhi "For sure. On the bright side, maybe Gaius finally found his match."
    yuuhi "Com certeza. Pelo lado bom, talvez Gaius finalmente tenha encontrado alguém à sua altura."

# game/script3.rpy:12240
translate pt_br_anubisbr scene91_4_41c37bde:

#   mc "You think they'd clash?"
    mc "Você acha que eles entrariam em conflito?"

# game/script3.rpy:12242
translate pt_br_anubisbr scene91_4_b9a079ae:

#   yuuhi "Probably not, but who knows? Two mountains like that in the same kingdom... bound to rumble eventually."
    yuuhi "Provavelmente não, mas quem sabe? Duas montanhas assim no mesmo reino... inevitavelmente irão ruir eventualmente."

# game/script3.rpy:12248
translate pt_br_anubisbr scene91_choice05_op1_82f54de0:

#   mc "If Gaius falls, it'll be by my blade."
    mc "Se Gaius cair, será pela minha espada."

# game/script3.rpy:12250
translate pt_br_anubisbr scene91_choice05_op1_ba73b61b:

#   yuuhi "*giggles* Whoa... listen to you~"
    yuuhi "*risinhos* Uau... escuta só você~"

# game/script3.rpy:12251
translate pt_br_anubisbr scene91_choice05_op1_488e1259:

#   yuuhi "If only I had half the confidence you do. You say that like it's already written in the stars."
    yuuhi "Quem me dera ter metade da confiança que você tem. Você fala como se já estivesse escrito nas estrelas."

# game/script3.rpy:12253
translate pt_br_anubisbr scene91_choice05_op1_10dfa120:

#   mc "It's personal."
    mc "É algo pessoal."

# game/script3.rpy:12255
translate pt_br_anubisbr scene91_choice05_op1_0f28d953:

#   yuuhi "Personal, hmm? Gaius took your hand... and you take his life? Sounds like a ballad waiting to happen."
    yuuhi "Pessoal, hein? Gaius pegou na sua mão... e você tira a vida dele? Parece uma balada prestes a acontecer."

# game/script3.rpy:12256
translate pt_br_anubisbr scene91_choice05_op1_55faf393:

#   yuuhi "Just... promise me you won't be so direct about it."
    yuuhi "Só... me prometa que você não será tão direto(a) sobre isso."

# game/script3.rpy:12258
translate pt_br_anubisbr scene91_choice05_op1_7d678d27:

#   mc "*chuckles* Promise."
    mc "*risos* Prometo."

# game/script3.rpy:12263
translate pt_br_anubisbr scene91_choice05_op2_489d55e9:

#   mc "I was actually hoping to recruit Gaius."
    mc "Na verdade, eu esperava recrutar Gaius."

# game/script3.rpy:12265
translate pt_br_anubisbr scene91_choice05_op2_5b7f31e0:

#   yuuhi "You really did hit your head somewhere, didn't you?"
    yuuhi "Você realmente bateu a cabeça em algum lugar, não é?"

# game/script3.rpy:12266
translate pt_br_anubisbr scene91_choice05_op2_1b51835c:

#   yuuhi "Gaius has been serving the royal family longer than you and I have been alive. He's loyal as a warhound, probably sleeps with the crown's seal under his pillow."
    yuuhi "Gaius serve a família real há mais tempo do que você e eu estamos vivos. Ele é leal como um cão de guerra, provavelmente dorme com o selo da coroa debaixo do travesseiro."

# game/script3.rpy:12268
translate pt_br_anubisbr scene91_choice05_op2_29fb8f95:

#   mc "Loyalty can change. Men like that... they might appreciate strength more than politics."
    mc "A lealdade pode mudar. Homens assim... talvez valorizem mais a força do que a política."

# game/script3.rpy:12270
translate pt_br_anubisbr scene91_choice05_op2_38ce46f4:

#   yuuhi "I say go for it. Gaius on your... {i}our{/i} side? *laughs* Avery wouldn't be able to sleep at all!"
    yuuhi "Eu digo, vá em frente. Gaius, no seu... {i} nosso{/i} De lado? *risos* Avery não conseguiria dormir de jeito nenhum!"

# game/script3.rpy:12271
translate pt_br_anubisbr scene91_choice05_op2_69d81537:

#   yuuhi "But if he says no... are you going to challenge him to a rematch right there?"
    yuuhi "Mas se ele disser não... você vai desafiá-lo para uma revanche ali mesmo?"

# game/script3.rpy:12273
translate pt_br_anubisbr scene91_choice05_op2_9eb43346:

#   mc "*chuckles* Maybe."
    mc "*risos* Talvez."

# game/script3.rpy:12275
translate pt_br_anubisbr scene91_choice05_op2_b16987dc:

#   yuuhi "I'm betting on you then~"
    yuuhi "Então eu aposto em você~"

# game/script3.rpy:12281
translate pt_br_anubisbr scene91_choice05_op3_a1fe36a7:

#   mc "Good. Let them tear each other apart."
    mc "Ótimo. Que se destruam mutuamente."

# game/script3.rpy:12283
translate pt_br_anubisbr scene91_choice05_op3_7587b671:

#   yuuhi "*chuckles* Two monsters fighting? We just sit back and watch the castle burn."
    yuuhi "*risos* Dois monstros lutando? Nós só ficamos sentados assistindo o castelo pegar fogo."

# game/script3.rpy:12285
translate pt_br_anubisbr scene91_choice05_op3_cf0ec677:

#   mc "Mhm. Saves us the trouble."
    mc "Hum. Isso nos poupa trabalho."

# game/script3.rpy:12287
translate pt_br_anubisbr scene91_choice05_op3_b1e20a04:

#   yuuhi "Just don't get caught in the crossfire when the big dogs clash."
    yuuhi "Só não fique no fogo cruzado quando os figurões entrarem em confronto."

# game/script3.rpy:12294
translate pt_br_anubisbr scene91_5_4b044f00:

#   yuuhi "*yawn* I think that's all for today. Time to close up-"
    yuuhi "*bocejo* Acho que é tudo por hoje. Hora de fechar."

# game/script3.rpy:12297
translate pt_br_anubisbr scene91_5_a040fe4c:

#   perception "The door opens softly. A young woman stands hesitantly in the doorway, a simple but well-cared-for bow slung across her back."
    perception "A porta se abre suavemente. Uma jovem está parada, hesitante, na entrada, com um arco simples, porém bem cuidado, pendurado nas costas."

# game/script3.rpy:12298
translate pt_br_anubisbr scene91_5_2388746f:

#   yuuhi "*sigh* Never mind, I guess..."
    yuuhi "*suspiro* Deixa pra lá, acho..."

# game/script3.rpy:12300
translate pt_br_anubisbr scene91_5_dc8b1670:

#   elara "Hello. Is... is the smithy open? I didn't mean to intrude. I can come back tomorrow if it's too late."
    elara "Olá. A ferraria está aberta? Não queria incomodar. Posso voltar amanhã se for muito tarde."

# game/script3.rpy:12302
translate pt_br_anubisbr scene91_5_cbf9e1a2:

#   yuuhi "Not at all. Please, come in. How can we help?"
    yuuhi "De forma alguma. Por favor, entre. Como podemos ajudar?"

# game/script3.rpy:12307
translate pt_br_anubisbr scene91_5_a03d32a7:

#   elara "Thank you. I was hoping you might fix my bow. The string snapped during... training. Is it possible to repair?"
    elara "Obrigado. Eu esperava que você pudesse consertar meu arco. A corda arrebentou durante o treino. É possível consertá-lo?"

# game/script3.rpy:12309
translate pt_br_anubisbr scene91_5_c16a6926:

#   yuuhi "Let me see."
    yuuhi "Deixe-me ver."

# game/script3.rpy:12311
translate pt_br_anubisbr scene91_5_505c0d8a:

#   yuuhi "Oh, this is nothing serious. I get adventurers in here with the same issue every week. I can have it good as new for you by tomorrow morning!"
    yuuhi "Ah, não é nada sério. Toda semana recebo aventureiros aqui com o mesmo problema. Posso deixar tudo como novo para você amanhã de manhã!"

# game/script3.rpy:12312
translate pt_br_anubisbr scene91_5_2b23c24d:

#   elara "Thank you. I... I appreciate it. But I wasn't talking about just fixing the string, I could have done it myself, I want the same material."
    elara "Obrigado. Eu... eu agradeço. Mas eu não estava falando apenas de consertar a corda, eu mesmo poderia ter feito isso, eu quero o mesmo material."

# game/script3.rpy:12314
translate pt_br_anubisbr scene91_5_88528cb1:

#   mc "How did it snap? That's a sturdy looking bow."
    mc "Como é que quebrou? Esse arco parece bem resistente."

# game/script3.rpy:12316
translate pt_br_anubisbr scene91_5_d5d7916a:

#   elara "Too much pressure, I think. I've been pushing myself. Training non-stop since I joined the guild."
    elara "Acho que é muita pressão. Tenho me esforçado bastante. Treino sem parar desde que entrei na guilda."

# game/script3.rpy:12318
translate pt_br_anubisbr scene91_5_3a9e27ef:

#   yuuhi "It happens to the best of us. Really, no shame in it."
    yuuhi "Acontece com os melhores. Na verdade, não há vergonha nenhuma nisso."

# game/script3.rpy:12320
translate pt_br_anubisbr scene91_5_209ac165:

#   elara "It shouldn't have happened at all. They always told me to take care of my gear. That it was the only thing between me and a quick death."
    elara "Isso não deveria ter acontecido. Sempre me disseram para cuidar do meu equipamento. Que era a única coisa que me separava de uma morte rápida."

# game/script3.rpy:12322
translate pt_br_anubisbr scene91_5_0e422eae:

#   mc "You seem upset. Did something happen? Is Eireen being too hard on you?"
    mc "Você parece chateado(a). Aconteceu alguma coisa? Será que a Eireen está sendo muito dura com você?"

# game/script3.rpy:12324
translate pt_br_anubisbr scene91_5_ff1626e8:

#   elara "No. It's not Eireen. It's... my old party. The one I was with before the guild."
    elara "Não. Não é a Eireen. É... meu antigo grupo. Aquele com quem eu estava antes da guilda."

# game/script3.rpy:12325
translate pt_br_anubisbr scene91_5_bf0f81bd:

#   elara "We had a job lined up. Skitter-Maws in the quarry. Very risky, but the pay... it was life-changing. Eireen found out and immedietly declined me from going."
    elara "Tínhamos um emprego garantido. Skitter-Maws na pedreira. Muito arriscado, mas o pagamento... mudaria minha vida. Eireen descobriu e imediatamente me proibiu de ir."

# game/script3.rpy:12326
translate pt_br_anubisbr scene91_5_dcfa89c5:

#   elara "She said I wasn't ready. She was... firm. I was furious. I thought she was holding me back."
    elara "Ela disse que eu não estava pronto. Ela foi... firme. Fiquei furioso. Achei que ela estava me impedindo."

# game/script3.rpy:12328
translate pt_br_anubisbr scene91_5_889ba623:

#   mc "And your party... they went without you?"
    mc "E a sua festa... eles foram sem você?"

# game/script3.rpy:12330
translate pt_br_anubisbr scene91_5_05cdde6c:

#   elara "Mhm. I found out three days later from the recovery team, they brought them back, or what was left of them. The Skitter-Maws... they don't just kill you. They wrap you up. Leave you for later."
    elara "Sim. Descobri três dias depois, pela equipe de resgate, que eles os trouxeram de volta, ou o que restou deles. Os Skitter-Maws... eles não apenas te matam. Eles te envolvem. Te deixam para depois."

# game/script3.rpy:12331
translate pt_br_anubisbr scene91_5_f3bd7257:

#   elara "Eireen saved my life by not allowing me to go. I owe her for that. And I hate her for it a little, too. Because every night, I wonder if I could have made the difference. If I'd been there, maybe..."
    elara "Eireen salvou minha vida ao não me deixar ir. Devo isso a ela. E também a odeio um pouco por isso. Porque todas as noites me pergunto se eu poderia ter feito a diferença. Se eu estivesse lá, talvez..."

# game/script3.rpy:12333
translate pt_br_anubisbr scene91_5_df512003:

#   mc "You'd be dead. And you wouldn't be wondering anything."
    mc "Você estaria morto. E não teria mais dúvidas sobre nada."

# game/script3.rpy:12335
translate pt_br_anubisbr scene91_5_a91d755b:

#   elara "*sigh* I know. It just doesn't feel like a victory. It feels like I survived a shipwreck and now I'm just... sitting alone on the shore."
    elara "*Suspiro* Eu sei. Não parece uma vitória. Parece que sobrevivi a um naufrágio e agora estou... sentada sozinha na praia."

# game/script3.rpy:12336
translate pt_br_anubisbr scene91_5_2fabac27:

#   elara "Sorry... you didn't ask for all that. I just needed the bow fixed."
    elara "Desculpe... você não pediu tudo isso. Eu só precisava que o arco fosse consertado."

# game/script3.rpy:12338
translate pt_br_anubisbr scene91_5_78a52aee:

#   yuuhi "It's no trouble at all. I'll take good care of it. It should be ready by tomorrow morning."
    yuuhi "Não tem problema nenhum. Vou cuidar bem disso. Deve estar pronto amanhã de manhã."

# game/script3.rpy:12340
translate pt_br_anubisbr scene91_5_84c017a5:

#   elara "Thank you."
    elara "Obrigado."

# game/script3.rpy:12343
translate pt_br_anubisbr scene91_5_3e2193d5:

#   yuuhi "...Gods. That's... a horrible way to lose people."
    yuuhi "...Meu Deus. Essa é... uma maneira horrível de perder pessoas."

# game/script3.rpy:12345
translate pt_br_anubisbr scene91_5_8ecd0d0c:

#   mc "Eireen was right to stop her."
    mc "Eireen fez bem em impedi-la."

# game/script3.rpy:12347
translate pt_br_anubisbr scene91_5_8163a056:

#   yuuhi "She did. But still... all her friends are gone. I can't imagine the weight of that. I hope the guild is looking after her."
    yuuhi "Sim, ela fez isso. Mas mesmo assim... todos os amigos dela se foram. Não consigo imaginar o peso disso. Espero que a guilda esteja cuidando dela."

# game/script3.rpy:12355
translate pt_br_anubisbr scene91_5_73d581e3:

#   elara "Thank you. I was hoping you might sell... elemental arrows. Fire-tipped ones, or even blessed arrows, if you have any."
    elara "Obrigado. Eu estava esperando que você vendesse... flechas elementais. Flechas com ponta de fogo, ou até mesmo flechas abençoadas, se você tiver alguma."

# game/script3.rpy:12357
translate pt_br_anubisbr scene91_5_127d4348:

#   yuuhi "I'm really sorry, but we don't carry those."
    yuuhi "Sinto muito, mas não temos esses produtos em estoque."

# game/script3.rpy:12358
translate pt_br_anubisbr scene91_5_24ef621c:

#   yuuhi "Those are specialist items. Usually commissioned through the Alchemists' Guild, or occasionally stocked by the Adventurers' Guild for larger expeditions."
    yuuhi "Esses são itens especializados. Geralmente encomendados através da Guilda dos Alquimistas, ou ocasionalmente estocados pela Guilda dos Aventureiros para expedições maiores."

# game/script3.rpy:12360
translate pt_br_anubisbr scene91_5_a864e3bf:

#   elara "Oh. I see. Of course."
    elara "Ah, entendi. Claro."

# game/script3.rpy:12362
translate pt_br_anubisbr scene91_5_60234de1:

#   mc "That's very specific equipment. What are you hunting?"
    mc "Esse equipamento é bem específico. O que você está caçando?"

# game/script3.rpy:12364
translate pt_br_anubisbr scene91_5_d734aaee:

#   elara "It's... not exactly hunting. It's a task. My party, they... they heard about a job. Clearing out a nest of Skitter-Maws in the old quarry tunnels."
    elara "Não é exatamente uma caçada. É uma tarefa. Meu grupo... eles ouviram falar de um trabalho. Limpar um ninho de Skitter-Maws nos antigos túneis da pedreira."

# game/script3.rpy:12365
translate pt_br_anubisbr scene91_5_d7acdd4d:

#   elara "Somehow a group of them migrated here all the way from the south."
    elara "De alguma forma, um grupo deles migrou para cá vindo do sul."

# game/script3.rpy:12367
translate pt_br_anubisbr scene91_5_cd5ed68e:

#   yuuhi "Skitter-Maws?! But those are very dangerous!"
    yuuhi "Skitter-Maws?! Mas esses são muito perigosos!"

# game/script3.rpy:12368
translate pt_br_anubisbr scene91_5_765a0128:

#   mc "You're not even in the guild, why take a such a risky job?"
    mc "Você nem faz parte da guilda, por que aceitar um trabalho tão arriscado?"

# game/script3.rpy:12370
translate pt_br_anubisbr scene91_5_68083d0b:

#   elara "Huh?! H-How did you know that I'm in not the guild?"
    elara "Hã?! C-Como você sabia que eu não faço parte da guilda?"

# game/script3.rpy:12372
translate pt_br_anubisbr scene91_5_afbfde3d:

#   mc "...Call it intuition. You have the look of someone waiting for their chance. So why this job?"
    mc "...Chame isso de intuição. Você tem o olhar de alguém que está esperando a sua chance. Então, por que este emprego?"

# game/script3.rpy:12374
translate pt_br_anubisbr scene91_5_451aa47f:

#   elara "They said... they said we could manage. That it's a quick job. The payout is supposed to be huge. Enough to pay my guild initiation fee three times over."
    elara "Disseram... disseram que daríamos conta. Que seria um trabalho rápido. O pagamento seria enorme. Suficiente para pagar minha taxa de iniciação na guilda três vezes."

# game/script3.rpy:12375
translate pt_br_anubisbr scene91_5_e54363f8:

#   elara "It all feels... terrifying. They were supposed to go a few days ago, but they waited for me. Now they're saying I'm holding them back."
    elara "Tudo isso parece... aterrorizante. Eles deveriam ter ido há alguns dias, mas esperaram por mim. Agora estão dizendo que eu os estou atrasando."

# game/script3.rpy:12376
translate pt_br_anubisbr scene91_5_6366c849:

#   elara "This is my chance to prove I'm not just a liability. If I don't go... I might not have a party anymore."
    elara "Esta é a minha chance de provar que não sou apenas um estorvo. Se eu não for... talvez eu não tenha mais festa."

# game/script3.rpy:12377
translate pt_br_anubisbr scene91_5_c7bf50a0:

#   elara "I don't know what to do. If I back out now, they'll never trust me again. But if I go..."
    elara "Não sei o que fazer. Se eu desistir agora, eles nunca mais confiarão em mim. Mas se eu for..."

# game/script3.rpy:12382
translate pt_br_anubisbr scene91_choice06_op1_3965654e:

#   mc "Don't go. A real team doesn't call you a liability for having sane fears. They listen to them."
    mc "Não vá. Uma equipe de verdade não te considera um problema por ter medos justificados. Ela te ouve."

# game/script3.rpy:12383
translate pt_br_anubisbr scene91_choice06_op1_e5a12c49:

#   mc "Go to the Adventurers' Guild tomorrow. Speak to Eireen herself and tell her about this 'task'. She'll send better suited people for it."
    mc "Vá à Guilda dos Aventureiros amanhã. Fale com a própria Eireen e conte a ela sobre essa \"tarefa\". Ela enviará pessoas mais adequadas para realizá-la."

# game/script3.rpy:12384
translate pt_br_anubisbr scene91_choice06_op1_c78a6e42:

#   mc "She'd also rather have a live applicant than a dead one."
    mc "Ela também prefere um candidato vivo a um morto."

# game/script3.rpy:12386
translate pt_br_anubisbr scene91_choice06_op1_51539701:

#   elara "You sound just like her. Like Eireen. 'Train harder. Wait your turn.' I followed the rules!"
    elara "Você fala igualzinha a ela. Igualzinha à Eireen. \"Treine mais. Espere a sua vez.\" Eu segui as regras!"

# game/script3.rpy:12387
translate pt_br_anubisbr scene91_choice06_op1_d04e3a83:

#   elara "No one thinks I'm good enough. Not the guild, not my party. And now not you. You all think I'm too scared to make my own choices."
    elara "Ninguém acha que eu sou bom o suficiente. Nem a guilda, nem meu grupo. E agora nem você. Todos vocês acham que eu tenho muito medo de tomar minhas próprias decisões."

# game/script3.rpy:12389
translate pt_br_anubisbr scene91_choice06_op1_29f54517:

#   mc "This isn't about being scared, it's about-"
    mc "Não se trata de ter medo, trata-se de-"

# game/script3.rpy:12391
translate pt_br_anubisbr scene91_choice06_op1_b9709589:

#   elara "I'm done talking. If I wanted advice, I would have asked for it. Goodbye."
    elara "Já falei tudo o que tinha para falar. Se eu quisesse conselhos, teria pedido. Adeus."

# game/script3.rpy:12394
translate pt_br_anubisbr scene91_choice06_op1_4e647459:

#   yuuhi "That was... the right thing to say. You tried. If anything happens to her, it isn't your fault."
    yuuhi "Isso foi... a coisa certa a dizer. Você tentou. Se algo acontecer com ela, não será culpa sua."

# game/script3.rpy:12396
translate pt_br_anubisbr scene91_choice06_op1_2f2329e7:

#   mc "I don't know... I was the one who didn't let her into the guild in the first place. Maybe if she were... Eireen could've stopped her."
    mc "Não sei... fui eu quem a impediu de entrar na guilda. Talvez se ela tivesse... Eireen poderia tê-la impedido."

# game/script3.rpy:12398
translate pt_br_anubisbr scene91_choice06_op1_21816c6b:

#   yuuhi "Then... I hope she sees reason before it's too late. Sometimes trying is all you can do."
    yuuhi "Então... espero que ela caia na real antes que seja tarde demais. Às vezes, tentar é tudo o que você pode fazer."

# game/script3.rpy:12403
translate pt_br_anubisbr scene91_choice06_op2_683379df:

#   mc "Maybe this is your chance. Maybe they're right. Confidence counts for a lot out there."
    mc "Talvez esta seja a sua chance. Talvez eles estejam certos. Confiança conta muito lá fora."

# game/script3.rpy:12404
translate pt_br_anubisbr scene91_choice06_op2_a05519b1:

#   mc "If you've trained, if you trust your aim... going might be what seals your place with them. Just be smart. Watch each other's backs."
    mc "Se você treinou, se confia na sua mira... ir em frente pode ser o que garante seu lugar com eles. Só seja esperto. Protejam-se mutuamente."

# game/script3.rpy:12406
translate pt_br_anubisbr scene91_choice06_op2_fe5758b8:

#   elara "You... you really think I can do it?"
    elara "Você... você realmente acha que eu consigo fazer isso?"

# game/script3.rpy:12408
translate pt_br_anubisbr scene91_choice06_op2_1a03f836:

#   mc "I think the only way to know is to try. Sometimes you have to take the leap."
    mc "Acho que a única maneira de saber é tentando. Às vezes, é preciso dar o salto."

# game/script3.rpy:12410
translate pt_br_anubisbr scene91_choice06_op2_54c4b840:

#   elara "You're right. I've trained hard. I can do this. Thank you for the encouragement!"
    elara "Você tem razão. Eu treinei muito. Eu consigo. Obrigada pelo incentivo!"

# game/script3.rpy:12413
translate pt_br_anubisbr scene91_choice06_op2_7f7a61d2:

#   yuuhi "Not sure about this, [mc]... she looked terrified. I hope she stays safe."
    yuuhi "Não tenho certeza sobre isso. [mc]...ela parecia apavorada. Espero que ela fique bem."

# game/script3.rpy:12415
translate pt_br_anubisbr scene91_choice06_op2_7ae452f9:

#   mc "I gave her what she asked for: a push. Some lessons have to be learned firsthand."
    mc "Eu lhe dei o que ela pediu: um empurrão. Algumas lições precisam ser aprendidas na prática."

# game/script3.rpy:12417
translate pt_br_anubisbr scene91_choice06_op2_302ce6e7:

#   yuuhi "I hope that push doesn't send her off a cliff."
    yuuhi "Espero que esse empurrão não a faça cair de um penhasco."

# game/script3.rpy:12424
translate pt_br_anubisbr scene91_6_49c50fb7:

#   yuuhi "I doubt anyone else is coming. Hahh... I'm ready to drop."
    yuuhi "Duvido que mais alguém venha. Hahh... Estou pronto para desistir."

# game/script3.rpy:12426
translate pt_br_anubisbr scene91_6_8e50f181:

#   mc "The hammering stopped. Your dad must be finished."
    mc "As marteladas pararam. Seu pai deve ter terminado."

# game/script3.rpy:12428
translate pt_br_anubisbr scene91_6_b89b0996:

#   yuuhi "Before we go see, here. This is for you."
    yuuhi "Antes de irmos ver, aqui está. Isto é para você."

# game/script3.rpy:12429
translate pt_br_anubisbr scene91_6_876fda9d:

#   mc "What's this?"
    mc "O que é isto?"

# game/script3.rpy:12430
translate pt_br_anubisbr scene91_6_ab026e1b:

#   yuuhi "Your share. For today."
    yuuhi "Sua parte. Por hoje."

# game/script3.rpy:12431
translate pt_br_anubisbr scene91_6_d9676392:

#   mc "You're paying me? I was just helping."
    mc "Você está me pagando? Eu só estava ajudando."

# game/script3.rpy:12433
translate pt_br_anubisbr scene91_6_d564e474:

#   yuuhi "Helping? You sold that armor to Dana and even agreed to help that rude man. That's more than helping. You earned this."
    yuuhi "Ajudar? Você vendeu aquela armadura para a Dana e ainda concordou em ajudar aquele homem grosseiro. Isso é mais do que ajudar. Você mereceu isso."

# game/script3.rpy:12435
translate pt_br_anubisbr scene91_6_95ec1a16:

#   yuuhi "Of course I'm paying you. You handled yourself well, even if it wasn't perfect. A fair day's work."
    yuuhi "É claro que estou te pagando. Você se saiu bem, mesmo que não tenha sido perfeito. Um dia de trabalho justo."

# game/script3.rpy:12437
translate pt_br_anubisbr scene91_6_90a29eec:

#   yuuhi "You still showed up and tried. That counts for something around here. It's not much, but it's honest."
    yuuhi "Você ainda apareceu e tentou. Isso conta para alguma coisa por aqui. Não é muito, mas é sincero."

# game/script3.rpy:12441
translate pt_br_anubisbr scene91_choice07_op1_8db27e97:

#   mc "Thank you. I won't pretend it isn't needed."
    mc "Obrigado. Não vou fingir que não é necessário."

# game/script3.rpy:12445
translate pt_br_anubisbr scene91_choice07_op1_3babc112:

#   yuuhi "Three silver. Don't spend it all in one place. Unless that place is our smithy. Now, come on. I'm dying to see what he's made!"
    yuuhi "Três moedas de prata. Não gaste tudo de uma vez. A menos que esse lugar seja a nossa ferraria. Vamos lá. Estou louco para ver o que ele fez!"

# game/script3.rpy:12448
translate pt_br_anubisbr scene91_choice07_op1_d224920d:

#   yuuhi "Two silver. It's a start. Now let's go see if Father's work puts ours to shame."
    yuuhi "Duas medalhas de prata. É um começo. Agora vamos ver se a obra do Pai supera a nossa."

# game/script3.rpy:12451
translate pt_br_anubisbr scene91_choice07_op1_d524397c:

#   yuuhi "One silver. Every journey starts with a single step, right? Let's go see yours."
    yuuhi "Uma prata. Toda jornada começa com um único passo, certo? Vamos ver o seu."

# game/script3.rpy:12457
translate pt_br_anubisbr scene91_choice07_op2_7184fafb:

#   mc "Thank you, Yuuhi. That's kind. But you should keep it."
    mc "Obrigada, Yuuhi. Que gentil. Mas você deveria ficar com ele."

# game/script3.rpy:12464
translate pt_br_anubisbr scene91_choice07_op2_564a6ea2:

#   yuuhi "What? Why? You earned it."
    yuuhi "O quê? Por quê? Você mereceu."

# game/script3.rpy:12466
translate pt_br_anubisbr scene91_choice07_op2_28116a38:

#   mc "Get a decent meal for you and your father instead. You've done more for me today than coin can repay."
    mc "Em vez disso, providencie uma refeição decente para você e seu pai. Você fez mais por mim hoje do que qualquer dinheiro pode retribuir."

# game/script3.rpy:12470
translate pt_br_anubisbr scene91_choice07_op2_777c5cb1:

#   yuuhi "[mc]... I can't just—"
    yuuhi "[mc]... Eu não posso simplesmente—"

# game/script3.rpy:12472
translate pt_br_anubisbr scene91_choice07_op2_cc0e6d6c:

#   mc "You can. Please. Buy yourself something that isn't coal or steel for a change."
    mc "Você pode. Por favor. Compre algo que não seja carvão ou aço, para variar."

# game/script3.rpy:12474
translate pt_br_anubisbr scene91_choice07_op2_86793d98:

#   yuuhi "You're a stubborn one, you know that? Fine. But I'm buying you a sweetroll next time you're here. No arguments."
    yuuhi "Você é teimosa, sabia? Tudo bem. Mas da próxima vez que você vier aqui, eu te compro um pão doce. Sem discussão."

# game/script3.rpy:12476
translate pt_br_anubisbr scene91_choice07_op2_52da7e4f:

#   mc "*chuckles* Deal. Now, let's see this masterpiece."
    mc "*risos* Combinado. Agora, vamos ver essa obra-prima."

# game/script3.rpy:12482
translate pt_br_anubisbr scene91_7_1aa5f5dc:

#   mc "How's the work going?"
    mc "Como está indo o trabalho?"

# game/script3.rpy:12483
translate pt_br_anubisbr scene91_7_d1eb9cd0:

#   dean "It is done."
    dean "Está feito."

# game/script3.rpy:12485
translate pt_br_anubisbr scene91_7_c12f0415:

#   perception "He unfolds the cloth. Beneath it rests the prosthetic, black and silver steel. It doesn't shine; it waits."
    perception "Ele desdobra o pano. Por baixo dele repousa a prótese, de aço preto e prateado. Ela não brilha; permanece inerte."

# game/script3.rpy:12486
translate pt_br_anubisbr scene91_7_0bc69af2:

#   dean "Take it."
    dean "Aceite."

# game/script3.rpy:12489
translate pt_br_anubisbr scene91_7_38031a09:

#   sensation "You fit the prosthetic against the stump. It slides into place as if it was always meant to be there. A strange sensation follows, not pain. Not comfort."
    sensation "Você encaixa a prótese no coto. Ela desliza para o lugar como se sempre tivesse pertencido àquele espaço. Uma sensação estranha surge em seguida, não dor. Nem conforto."

# game/script3.rpy:12491
translate pt_br_anubisbr scene91_7_01ab713e:

#   desire "Purpose."
    desire "Propósito."

# game/script3.rpy:12493
translate pt_br_anubisbr scene91_7_b00ffe61:

#   mc "...This is beyond anything I imagined."
    mc "...Isto supera tudo o que eu imaginava."

# game/script3.rpy:12495
translate pt_br_anubisbr scene91_7_34a88c60:

#   dean "Adamantite core, hardened steel plating. You could block a warhammer with this and not find a dent."
    dean "Núcleo de adamantita, revestimento de aço endurecido. Você poderia bloquear um martelo de guerra com isso e não encontraria um arranhão."

# game/script3.rpy:12496
translate pt_br_anubisbr scene91_7_aad2f23e:

#   dean "But as I said, it's just a beautiful paperweight. Its true purpose must be woven into it by another."
    dean "Mas, como eu disse, é apenas um belo peso de papel. Seu verdadeiro propósito deve ser intrínseco a ele por meio de outra coisa."

# game/script3.rpy:12498
translate pt_br_anubisbr scene91_7_0f149d10:

#   mc "I'll find someone. Thank you. But this... this can't be a gift."
    mc "Encontrarei alguém. Obrigada. Mas isto... isto não pode ser um presente."

# game/script3.rpy:12500
translate pt_br_anubisbr scene91_7_cbfe7cd1:

#   dean "It isn't. The adamantite alone cost a fortune, it was actually meant for a different commission. A new weapon for Gaius, the Queen's lapdog."
    dean "Não é. Só a adamantita custou uma fortuna, e na verdade era destinada a outra encomenda: uma nova arma para Gaius, o lacaio da rainha."

# game/script3.rpy:12501
translate pt_br_anubisbr scene91_7_010a9be4:

#   dean "*chuckles* The idiot lost his sword somehow."
    dean "*risos* O idiota perdeu a espada dele de alguma forma."

# game/script3.rpy:12503
translate pt_br_anubisbr scene91_7_e77f0895:

#   mc "You used his materials?! For me?"
    mc "Você usou o material dele?! Para mim?"

# game/script3.rpy:12505
translate pt_br_anubisbr scene91_7_4bbf614d:

#   dean "The order came from the Magistrate's office. After what you told me? To hell with them. I'd rather see this metal empower a man fighting a tyrant than the tyrant's favorite attack dog."
    dean "A ordem veio do gabinete do magistrado. Depois do que você me disse? Que se danem. Prefiro ver este metal fortalecer um homem lutando contra um tirano do que o cão de ataque favorito do tirano."

# game/script3.rpy:12507
translate pt_br_anubisbr scene91_7_720f3d62:

#   yuuhi "Pops... if they find out..."
    yuuhi "Papai... se eles descobrirem..."

# game/script3.rpy:12509
translate pt_br_anubisbr scene91_7_d4676cfe:

#   dean "They won't. I'll tell them a flaw was found in the smelting, that it shattered under the hammer."
    dean "Eles não vão. Vou dizer que foi encontrada uma falha na fundição, que o metal se quebrou sob o martelo."

# game/script3.rpy:12510
translate pt_br_anubisbr scene91_7_3dcb91d6:

#   dean "They'll rage, they'll threaten, but what will they do? Find another smith of my skill overnight? They need me more than I need their guilt-ridden coin."
    dean "Eles vão se enfurecer, vão ameaçar, mas o que farão? Encontrarão outro ferreiro com a minha habilidade da noite para o dia? Eles precisam mais de mim do que eu preciso do dinheiro deles, carregado de culpa."

# game/script3.rpy:12512
translate pt_br_anubisbr scene91_7_ec7b417d:

#   mc "You're gambling your entire livelihood."
    mc "Você está arriscando todo o seu sustento."

# game/script3.rpy:12514
translate pt_br_anubisbr scene91_7_aa73206e:

#   dean "I am investing in a principle. One I should have invested in sooner. But make no mistake, this is a debt. Fifty gold pieces."
    dean "Estou investindo em um princípio. Um princípio no qual eu deveria ter investido antes. Mas não se enganem, isso é uma dívida. Cinquenta moedas de ouro."

# game/script3.rpy:12515
translate pt_br_anubisbr scene91_7_9139f9e0:

#   sensation "The number settles in your chest like a stone. You don't fully grasp the currency yet, but you understand weight."
    sensation "O número se instala no seu peito como uma pedra. Você ainda não compreende totalmente a moeda, mas entende o seu peso."

# game/script3.rpy:12549
translate pt_br_anubisbr scene91_choice08_op2_cb2e4838:

#   mc "Fifty gold. It's a fair price for the risk you took and the craft you put into this. You have my word, it may take time, but you will be paid."
    mc "Cinquenta moedas de ouro. É um preço justo pelo risco que você correu e pela habilidade que você dedicou a isso. Dou minha palavra, pode demorar um pouco, mas você será pago."

# game/script3.rpy:12551
translate pt_br_anubisbr scene91_choice08_op2_7a6078e7:

#   dean "Good. A man who recognizes a debt is a man who intends to survive long enough to settle it. See that you do. Now, go. The night won't last forever."
    dean "Ótimo. Um homem que reconhece uma dívida é um homem que pretende sobreviver o tempo suficiente para quitá-la. Certifique-se de fazê-lo. Agora, vá. A noite não durará para sempre."

# game/script3.rpy:12557
translate pt_br_anubisbr scene91_choice08_op1_a4b8446a:

#   mc "Fifty gold is a price placed on an object. What you've given me is a tool for a cause."
    mc "Cinquenta moedas de ouro são um preço atribuído a um objeto. O que você me deu é uma ferramenta para uma causa."

# game/script3.rpy:12558
translate pt_br_anubisbr scene91_choice08_op1_0e7e3a86:

#   mc "I will repay you, Dean, but not with coin. I'll repay you with a city freed, with justice dragged back into the light. Your metal will be part of the hand that tears down Avery's lies. That is the contract I offer."
    mc "Eu te recompensarei, Dean, mas não com dinheiro. Recompensarei com uma cidade libertada, com a justiça trazida de volta à luz. Seu metal fará parte da mão que desmascarará as mentiras de Avery. Esse é o contrato que eu ofereço."

# game/script3.rpy:12560
translate pt_br_anubisbr scene91_choice08_op1_cecbda7d:

#   dean "...Ha. Bold words. I've little use for grand promises. But I find I've even less use for safe men with quiet hearts."
    dean "...Ha. Palavras ousadas. Não me dou muita importância a grandes promessas. Mas acho que me dou ainda menos importância a homens seguros e de coração tranquilo."

# game/script3.rpy:12561
translate pt_br_anubisbr scene91_choice08_op1_128b110c:

#   dean "Very well. Let your actions be the currency, then. *chuckles* Now get out of my smithy before I change my mind and decide to charge you interest."
    dean "Muito bem. Que suas ações sejam a moeda de troca, então. *risos* Agora saia da minha forja antes que eu mude de ideia e decida cobrar juros."

# game/script3.rpy:12566
translate pt_br_anubisbr scene91_choice08_op1_2_ec71cecf:

#   empathy "You hesitate before uttering the words. You know you can't promise such a thing. Not yet, at least."
    empathy "Você hesita antes de pronunciar as palavras. Sabe que não pode prometer tal coisa. Pelo menos não ainda."

# game/script3.rpy:12572
translate pt_br_anubisbr scene91_8_fd6106f3:

#   mc "Yuuhi... can I keep the mask? I may need it."
    mc "Yuuhi... posso ficar com a máscara? Talvez eu precise dela."

# game/script3.rpy:12574
translate pt_br_anubisbr scene91_8_9d13175c:

#   yuuhi "Of course. Though I should ask how much you're planning to pay for it—"
    yuuhi "Claro. Mas devo perguntar quanto você pretende pagar por isso—"

# game/script3.rpy:12575
translate pt_br_anubisbr scene91_8_87805f62:

#   yuuhi "...Just kidding. You can have it."
    yuuhi "...Brincadeirinha. Pode ficar com ele."

# game/script3.rpy:12576
translate pt_br_anubisbr scene91_8_819196db:

#   yuuhi "But promise me one thing. If you ever find out it's the real thing, return it. Something like that belongs in a museum, not lost in an alley or soaked in blood."
    yuuhi "Mas me prometa uma coisa. Se você descobrir que é autêntico, devolva. Uma coisa dessas pertence a um museu, não a um beco perdido ou ensanguentado."

# game/script3.rpy:12578
translate pt_br_anubisbr scene91_8_7e1c053e:

#   mc "*chuckles* Fair enough."
    mc "*risos* Justo."

# game/script3.rpy:12580
translate pt_br_anubisbr scene91_8_be1929c6:

#   mc "Oh, and before I go, do you have a pen and paper? I'm most likely not making my deadline, so I should leave a note behind."
    mc "Ah, e antes de ir, você tem caneta e papel? É bem provável que eu não consiga cumprir o prazo, então devo deixar um bilhete."

# game/script3.rpy:12581
translate pt_br_anubisbr scene91_8_59bac807:

#   mc "I don't want my friend to start frantically looking for me."
    mc "Não quero que meu amigo comece a me procurar freneticamente."

# game/script3.rpy:12583
translate pt_br_anubisbr scene91_8_8657650a:

#   yuuhi "Of course."
    yuuhi "Claro."

# game/script3.rpy:12587
translate pt_br_anubisbr scene91_8_5d696cd3:

#   env "Lanternlight spills across the cracked pavement, dull gold against cold stone. Somewhere nearby, a couple sits in silence, shoulder to shoulder, watching the moon as if it might answer something they're afraid to ask."
    env "A luz da lanterna se espalha pelo pavimento rachado, um dourado opaco contra a pedra fria. Em algum lugar próximo, um casal senta-se em silêncio, ombro a ombro, observando a lua como se ela pudesse responder a alguma pergunta que eles têm medo de fazer."

# game/script3.rpy:12589
translate pt_br_anubisbr scene91_8_ca306865:

#   yuuhi "So. You're leaving again."
    yuuhi "Então. Você vai embora de novo."

# game/script3.rpy:12590
translate pt_br_anubisbr scene91_8_21d60d8b:

#   mc "I am."
    mc "Eu sou."

# game/script3.rpy:12591
translate pt_br_anubisbr scene91_8_c54c9149:

#   yuuhi "..."
    yuuhi "..."

# game/script3.rpy:12598
translate pt_br_anubisbr scene91_choice09_op1_0ae9bcd0:

#   ""
    ""

# game/script3.rpy:12601
translate pt_br_anubisbr scene91_choice09_op1_159d13e4:

#   yuuhi "...That's not a goodbye."
    yuuhi "...Isso não é um adeus."

# game/script3.rpy:12603
translate pt_br_anubisbr scene91_choice09_op1_443afcff:

#   mc "It's not. It's a 'wait for me'."
    mc "Não é. É um \"espere por mim\"."

# game/script3.rpy:12605
translate pt_br_anubisbr scene91_choice09_op1_b1690a2b:

#   yuuhi "I will. I always do."
    yuuhi "Sim, eu vou. Sempre faço isso."

# game/script3.rpy:12606
translate pt_br_anubisbr scene91_choice09_op1_79832549:

#   yuuhi "*sigh* Now go, before I decide to chain you to the anvil."
    yuuhi "*suspiro* Agora vá, antes que eu decida acorrentá-lo à bigorna."

# game/script3.rpy:12609
translate pt_br_anubisbr scene91_choice09_op1_764fedc5:

#   sensation "You nod then melt back into the shadows of the alley, the weight of the new metal hand heavy."
    sensation "Você acena com a cabeça e então desaparece nas sombras do beco, o peso da nova mão de metal pesado demais."

# game/script3.rpy:12614
translate pt_br_anubisbr scene91_choice09_op1_8caa5481:

#   yuuhi "...Wha... Why did you..."
    yuuhi "...O quê... Por que você..."

# game/script3.rpy:12616
translate pt_br_anubisbr scene91_choice09_op1_0163a555:

#   mc "I don't know. Maybe because I might not get another chance to be foolish."
    mc "Não sei. Talvez porque eu não tenha outra chance de ser tolo."

# game/script3.rpy:12618
translate pt_br_anubisbr scene91_choice09_op1_f6a2521f:

#   yuuhi "That was... foolish. ...You don't get to do that and then disappear."
    yuuhi "Isso foi... tolice. ...Você não pode fazer isso e depois desaparecer."

# game/script3.rpy:12620
translate pt_br_anubisbr scene91_choice09_op1_cfcc2293:

#   mc "I know."
    mc "Eu sei."

# game/script3.rpy:12622
translate pt_br_anubisbr scene91_choice09_op1_236fbd46:

#   yuuhi "Just don't make it the last thing I remember about you."
    yuuhi "Só não faça com que essa seja a última coisa que eu me lembre de você."

# game/script3.rpy:12625
translate pt_br_anubisbr scene91_choice09_op1_764fedc5_1:

#   sensation "You nod then melt back into the shadows of the alley, the weight of the new metal hand heavy."
    sensation "Você acena com a cabeça e então desaparece nas sombras do beco, o peso da nova mão de metal pesado demais."

# game/script3.rpy:12633
translate pt_br_anubisbr scene91_choice09_op2_152edac7:

#   mc "Goodbye, Yuuhi. Thank you. For everything."
    mc "Adeus, Yuuhi. Obrigada. Por tudo."

# game/script3.rpy:12634
translate pt_br_anubisbr scene91_choice09_op2_44326c8f:

#   yuuhi "Don't thank me. Just... come back. In one piece. Preferably with both hands this time."
    yuuhi "Não precisa agradecer. Só... volte. Inteiro(a). De preferência, com as duas mãos dessa vez."

# game/script3.rpy:12635
translate pt_br_anubisbr scene91_choice09_op2_06eb03ff:

#   mc "I'll do my best."
    mc "Farei o meu melhor."

# game/script3.rpy:12637
translate pt_br_anubisbr scene91_choice09_op2_764fedc5:

#   sensation "You nod then melt back into the shadows of the alley, the weight of the new metal hand heavy."
    sensation "Você acena com a cabeça e então desaparece nas sombras do beco, o peso da nova mão de metal pesado demais."

# game/script3.rpy:12647
translate pt_br_anubisbr scene92_d424936f:

#   mc "Come on, girl. You've had your rest. Time to move. We can reach the swamp in a few hours if we're quick enough."
    mc "Vamos lá, garota. Você já descansou o suficiente. Hora de ir. Podemos chegar ao pântano em algumas horas se formos rápidas o bastante."

# game/script3.rpy:12651
translate pt_br_anubisbr scene92_17d77562:

#   mc "(Hopefully she's still here. And damn this place smells worse than I remember.)"
    mc "(Espero que ela ainda esteja aqui. E, nossa, este lugar cheira pior do que eu me lembrava.)"

# game/script3.rpy:12653
translate pt_br_anubisbr scene92_8249f5ff:

#   mc "(Shit. How do I even start this? 'Sorry I ghosted you, need a favor'?)"
    mc "(Droga. Como é que eu começo isso? 'Desculpa por ter te ignorado, preciso de um favor'?)"

# game/script3.rpy:12654
translate pt_br_anubisbr scene92_dcf069b8:

#   logic "Directness. Apology. Then the request."
    logic "Direção. Pedido de desculpas. E então, o pedido."

# game/script3.rpy:12655
translate pt_br_anubisbr scene92_0e9c6ca1:

#   mc "Here goes..."
    mc "Vamos lá..."

# game/script3.rpy:12657
translate pt_br_anubisbr scene92_b175fff3:

#   amelia "Are you just going to stand there? The door is open."
    amelia "Vai ficar aí parado? A porta está aberta."

# game/script3.rpy:12658
translate pt_br_anubisbr scene92_f0815a60:

#   mc "(Wha—!? What was that?)"
    mc "(O quê?! O que foi isso?)"

# game/script3.rpy:12659
translate pt_br_anubisbr scene92_9adcfeba:

#   mc "(Is she in my head? Right. Of course she is...)"
    mc "(Ela está na minha cabeça? É claro que está...)"

# game/script3.rpy:12663
translate pt_br_anubisbr scene92_d7890ffa:

#   mc "*ahem* Hey, Amelia. Been a while, huh?"
    mc "*cof cof* Oi, Amelia. Faz tempo, né?"

# game/script3.rpy:12664
translate pt_br_anubisbr scene92_597a37bf:

#   mc "Seriously, if you knew the kind of shit I've been through."
    mc "Sério, se você soubesse a merda que eu passei."

# game/script3.rpy:12665
translate pt_br_anubisbr scene92_40a5ab0e:

#   mc "And, uh... sorry for not stopping by. For tea. Or anything."
    mc "E, hum... desculpe por não ter aparecido. Para um chá. Ou qualquer outra coisa."

# game/script3.rpy:12669
translate pt_br_anubisbr scene92_29262f47:

#   amelia "You fool! Do you have any concept of time? Of a promise?"
    amelia "Seu tolo! Você tem alguma noção de tempo? De promessa?"

# game/script3.rpy:12672
translate pt_br_anubisbr scene92_029af4ba:

#   sensation "Something unseen closes around your throat, hard and merciless, stealing your breath mid-word."
    sensation "Algo invisível se fecha em torno da sua garganta, duro e impiedoso, roubando-lhe o fôlego no meio da palavra."

# game/script3.rpy:12673
translate pt_br_anubisbr scene92_bbb29614:

#   mc "Ghhk! Amelia! I need— help!"
    mc "Ghhk! Amelia! Eu preciso de... ajuda!"

# game/script3.rpy:12675
translate pt_br_anubisbr scene92_19d4501c:

#   amelia "We had a pact! You would check in. You would be my anchor. In exchange, I spared your precious city folk from my... hungers."
    amelia "Tínhamos um pacto! Você se manteria informado. Você seria minha âncora. Em troca, eu pouparia seus preciosos habitantes da cidade da minha... fome."

# game/script3.rpy:12676
translate pt_br_anubisbr scene92_0d6c339f:

#   amelia "Yet you vanished. And now you come back, without your pretty resistant armor, so terribly, terribly vulnerable."
    amelia "Mas você desapareceu. E agora retorna, sem sua bela e resistente armadura, tão terrivelmente vulnerável."

# game/script3.rpy:12678
translate pt_br_anubisbr scene92_3c50f24b:

#   mc "I know! I'm sorry! Just... let me down! Can't... breathe!"
    mc "Eu sei! Me desculpe! Só... me decepcione! Não consigo... respirar!"

# game/script3.rpy:12680
translate pt_br_anubisbr scene92_fff7e59e:

#   amelia "..."
    amelia "..."

# game/script3.rpy:12683
translate pt_br_anubisbr scene92_cd8afb2c:

#   mc "Hahh! Ahhh... *cough* *cough*"
    mc "Hahh! Ahhh... *tosse* *tosse*"

# game/script3.rpy:12685
translate pt_br_anubisbr scene92_79c655a5:

#   amelia "*sigh* Forgive the dramatics, darling. But solitude does terrible things to a woman's temperament. This swamp is so very quiet without someone to... talk to."
    amelia "*Suspiro* Perdoe o drama, querida. Mas a solidão faz coisas terríveis com o temperamento de uma mulher. Este pântano é tão silencioso sem alguém para... conversar."

# game/script3.rpy:12686
translate pt_br_anubisbr scene92_b1f1ce20:

#   mc "*cough* *cough* Right. I can see that."
    mc "*tosse* *tosse* Certo. Consigo ver isso."

# game/script3.rpy:12688
translate pt_br_anubisbr scene92_23076d51:

#   amelia "We have catching up to do."
    amelia "Temos muito o que recuperar."

# game/script3.rpy:12690
translate pt_br_anubisbr scene92_c0591e7b:

#   mc "Yeah... about that."
    mc "Sim... sobre isso."

# game/script3.rpy:12692
translate pt_br_anubisbr scene92_94a76701:

#   amelia "First, pants off."
    amelia "Primeiro, tire as calças."

# game/script3.rpy:12694
translate pt_br_anubisbr scene92_635091ea:

#   mc "Wait! I'm serious. I need your help. Look."
    mc "Espere! Estou falando sério. Preciso da sua ajuda. Veja."

# game/script3.rpy:12696
translate pt_br_anubisbr scene92_82568a8e:

#   amelia "Hm?"
    amelia "Hum?"

# game/script3.rpy:12698
translate pt_br_anubisbr scene92_838db6e3:

#   amelia "A new toy? Charming. What of it?"
    amelia "Um brinquedo novo? Que encanto. E daí?"

# game/script3.rpy:12700
translate pt_br_anubisbr scene92_0d925d4e:

#   mc "*sigh* It's a prosthetic. The smith who forged it said it needs a powerful enchantment to become real. To work like a real hand. You're the strongest sorcerer I know."
    mc "*Suspiro* É uma prótese. O ferreiro que a forjou disse que precisa de um encantamento poderoso para se tornar real. Para funcionar como uma mão de verdade. Você é o feiticeiro mais forte que eu conheço."

# game/script3.rpy:12701
translate pt_br_anubisbr scene92_bdd62be8:

#   mc "With two hands, things will be easier. I can act faster. I can take down Avery... She's unlawfully—"
    mc "Com as duas mãos, tudo fica mais fácil. Posso agir mais rápido. Posso derrubar a Avery... Ela está ilegalmente—"

# game/script3.rpy:12703
translate pt_br_anubisbr scene92_45a18f96:

#   amelia "Do not bore me."
    amelia "Não me aborreça."

# game/script3.rpy:12704
translate pt_br_anubisbr scene92_c895d6db:

#   amelia "I do not care about your crusade against the false queen, or your missing limb. Irrelevant, all of it. I care about our agreement."
    amelia "Não me importo com sua cruzada contra a falsa rainha, nem com o membro que lhe falta. Tudo isso é irrelevante. O que me importa é o nosso acordo."

# game/script3.rpy:12706
translate pt_br_anubisbr scene92_6923a49a:

#   mc "...Alright. That saves me repeating myself."
    mc "...Certo. Isso evita que eu me repita."

# game/script3.rpy:12708
translate pt_br_anubisbr scene92_5d996f21:

#   amelia "You still have that 'limb' down there, yes?"
    amelia "Você ainda tem aquele 'membro' lá embaixo, não é?"

# game/script3.rpy:12710
translate pt_br_anubisbr scene92_53912868:

#   mc "I do. And believe me, it would've been a tragedy to lose {i}that{/i} as well."
    mc "Sim, eu sei. E acredite, teria sido uma tragédia perdê-lo. {i} que{/i} também."

# game/script3.rpy:12711
translate pt_br_anubisbr scene92_94ee8061:

#   mc "*ahem* No offense, but can you actually do it? Enchanting my prosthetic?"
    mc "*cof cof* Sem ofensa, mas você realmente consegue fazer isso? Encantar minha prótese?"

# game/script3.rpy:12713
translate pt_br_anubisbr scene92_88f70086:

#   amelia "Oh, my sweet fool. I'm not the same person you met last time. I have spent every silent day and starless night studying, consuming, growing. My power would but shatter the mind of the woman you met."
    amelia "Oh, meu doce tolo. Eu não sou a mesma pessoa que você conheceu da última vez. Passei cada dia silencioso e cada noite sem estrelas estudando, absorvendo, crescendo. Meu poder apenas destruiria a mente da mulher que você conheceu."

# game/script3.rpy:12714
translate pt_br_anubisbr scene92_e27f9d65:

#   amelia "My crows told me you were a nobody then. A novice. To be defeated by such a one... it was a lesson. I have learned."
    amelia "Meus corvos me disseram que você não era ninguém naquela época. Um novato. Ser derrotado por alguém assim... foi uma lição. Eu aprendi."

# game/script3.rpy:12716
translate pt_br_anubisbr scene92_134b7ced:

#   mc "And you're using this power for... what, exactly?"
    mc "E você está usando esse poder para... o quê, exatamente?"

# game/script3.rpy:12718
translate pt_br_anubisbr scene92_7e76d3d3:

#   amelia "For whatever I please. Unless, of course, someone were foolish enough to keep me... occupied."
    amelia "Para o que eu quiser. A menos, é claro, que alguém seja tolo o suficiente para me manter... ocupado."

# game/script3.rpy:12720
translate pt_br_anubisbr scene92_896a4e7c:

#   mc "So, you want to have your way with me in exchange for your help?"
    mc "Então, você quer fazer o que quer comigo em troca da sua ajuda?"

# game/script3.rpy:12722
translate pt_br_anubisbr scene92_046905d1:

#   amelia "Look at you, my sweetling is so, so smart!"
    amelia "Olha só você, meu amor, é tão, tão inteligente!"

# game/script3.rpy:12724
translate pt_br_anubisbr scene92_df190eab:

#   mc "Will you tie me up to the same device... thingy? I'd rather know what I'm walking into."
    mc "Você vai me amarrar naquele mesmo dispositivo... aquela coisa? Eu prefiro saber no que estou me metendo."

# game/script3.rpy:12726
translate pt_br_anubisbr scene92_1211371c:

#   amelia "No. That."
    amelia "Não. Isso."

# game/script3.rpy:12728
translate pt_br_anubisbr scene92_03a9ed92:

#   perception "She gestures towards strange contraption against the wall. The user lies on their waist, limbs secured. Something designed for prolonged extraction."
    perception "Ela gesticula em direção a um estranho dispositivo encostado na parede. O usuário está deitado de costas, com os membros presos. Algo projetado para extração prolongada."

# game/script3.rpy:12729
translate pt_br_anubisbr scene92_2e74f0ed:

#   mc "You're certainly creative. Did you make this for me?"
    mc "Você é realmente criativo(a). Você fez isso para mim?"

# game/script3.rpy:12731
translate pt_br_anubisbr scene92_e0f608d1:

#   amelia "Mhm. The way your squirmed last time, it inspired me!"
    amelia "Hum. O jeito como você se contorceu da última vez me inspirou!"

# game/script3.rpy:12732
translate pt_br_anubisbr scene92_1394383d:

#   amelia "Lie down on it~ I've missed this so very much—hearing the whines and cries of a man at my mercy... Ah! It gives me the shivers already."
    amelia "Deite-se sobre isso~ Senti tanta falta disso—ouvir os gemidos e gritos de um homem à minha mercê... Ah! Só de pensar já me dá arrepios."

# game/script3.rpy:12734
translate pt_br_anubisbr scene92_da95c40a:

#   mc "How... how long would this take? I'm on the clock here."
    mc "Quanto... quanto tempo isso levaria? Estou com o tempo contado."

# game/script3.rpy:12736
translate pt_br_anubisbr scene92_7bf1b218:

#   amelia "I suppose I can't keep you forever... for my pleasure alone."
    amelia "Imagino que não posso te manter para sempre... apenas para meu prazer."

# game/script3.rpy:12737
translate pt_br_anubisbr scene92_11e932b6:

#   amelia "Let me look for something."
    amelia "Deixe-me procurar algo."

# game/script3.rpy:12740
translate pt_br_anubisbr scene92_23b2b67e:

#   amelia "Hmm..."
    amelia "Hum..."

# game/script3.rpy:12741
translate pt_br_anubisbr scene92_2b35b6fe:

#   mc "..."
    mc "..."

# game/script3.rpy:12743
translate pt_br_anubisbr scene92_2f14ebbe:

#   amelia "Aha! How about this? You'll fill this entire chalice with your seed. Not a drop less, until it overflows."
    amelia "Ahá! Que tal isso? Você encherá este cálice inteiro com sua semente. Nem uma gota a menos, até transbordar."

# game/script3.rpy:12745
translate pt_br_anubisbr scene92_b1140d46:

#   mc "T-That's huge!"
    mc "I-Isso é enorme!"

# game/script3.rpy:12747
translate pt_br_anubisbr scene92_2d0ae897:

#   amelia "Mhm~ And once you get in, no matter how much you beg, whine, or plead, I won't stop. I'll tease, pleasure, milk you until this chalice is full."
    amelia "Hum... E quando você entrar, não importa o quanto implore, chore ou suplique, eu não vou parar. Vou te provocar, te dar prazer, te ordenhar até que este cálice esteja cheio."

# game/script3.rpy:12754
translate pt_br_anubisbr scene92_choice01_op1_1fce7e70:

#   mc "Do what you wish to me!"
    mc "Faça comigo o que quiser!"

# game/script3.rpy:12756
translate pt_br_anubisbr scene92_choice01_op1_08198b4c:

#   amelia "*giggles* Oh, wonderful! Let's hope you don't swallow those words later."
    amelia "*risinhos* Oh, maravilhoso! Espero que você não engula essas palavras depois."

# game/script3.rpy:12757
translate pt_br_anubisbr scene92_choice01_op1_5551f4ed:

#   amelia "Wait here like a good boy. I'll just do a quick change to something more... suitable for our game."
    amelia "Fique aqui, como um bom menino. Vou só trocar rapidinho para algo mais... adequado para o nosso jogo."

# game/script3.rpy:12762
translate pt_br_anubisbr scene92_choice01_op1_74fd5fc3:

#   mc "(I might as well look around until she returns.)"
    mc "(Acho que vou dar uma olhada por aí até ela voltar.)"

# game/script3.rpy:12766
translate pt_br_anubisbr scene92_choice01_op1_1236fd60:

#   mc "(Hm, it's been a while since I checked my Irda ID card... It's pretty much useless and outdated now.)"
    mc "(Hum, faz tempo que não verifico meu cartão de identificação da Irda... Ele está praticamente inútil e desatualizado agora.)"

# game/script3.rpy:12805
translate pt_br_anubisbr scene92_choice01_op2_4e4e0a8e:

#   mc "Wait... this was a mistake. I changed my mind."
    mc "Espere... isso foi um erro. Mudei de ideia."

# game/script3.rpy:12807
translate pt_br_anubisbr scene92_choice01_op2_833a4cee:

#   amelia "You... changed your mind!?"
    amelia "Você... mudou de ideia!?"

# game/script3.rpy:12808
translate pt_br_anubisbr scene92_choice01_op2_014bbac3:

#   amelia "Have you forgotten our pact? I refrain from hunting your precious city folk... as long as you offer yourself to me."
    amelia "Você se esqueceu do nosso pacto? Eu me abstenho de caçar seus preciosos habitantes da cidade... contanto que você se ofereça a mim."

# game/script3.rpy:12809
translate pt_br_anubisbr scene92_choice01_op2_93491529:

#   amelia "Are you truly going back on your word? If so... I'll have no choice but to seek entertainment elsewhere."
    amelia "Você realmente vai voltar atrás na sua palavra? Se sim... não terei outra escolha a não ser procurar entretenimento em outro lugar."

# game/script3.rpy:12811
translate pt_br_anubisbr scene92_choice01_op2_2b35b6fe:

#   mc "..."
    mc "..."

# game/script3.rpy:12817
translate pt_br_anubisbr scene92_choice02_op1_8f0b7adf:

#   mc "Come on, Amelia... I was joking."
    mc "Vamos lá, Amelia... Eu estava brincando."

# game/script3.rpy:12818
translate pt_br_anubisbr scene92_choice02_op1_1dd722cb:

#   mc "Of course I'll do it. Haha..."
    mc "Claro que farei isso. Haha..."

# game/script3.rpy:12820
translate pt_br_anubisbr scene92_choice02_op1_0d4b4002:

#   amelia "I see. You're not entirely stupid after all."
    amelia "Entendi. Afinal, você não é totalmente estúpido."

# game/script3.rpy:12821
translate pt_br_anubisbr scene92_choice02_op1_5551f4ed:

#   amelia "Wait here like a good boy. I'll just do a quick change to something more... suitable for our game."
    amelia "Fique aqui, como um bom menino. Vou só trocar rapidinho para algo mais... adequado para o nosso jogo."

# game/script3.rpy:12826
translate pt_br_anubisbr scene92_choice02_op1_74fd5fc3:

#   mc "(I might as well look around until she returns.)"
    mc "(Acho que vou dar uma olhada por aí até ela voltar.)"

# game/script3.rpy:12830
translate pt_br_anubisbr scene92_choice02_op1_1236fd60:

#   mc "(Hm, it's been a while since I checked my Irda ID card... It's pretty much useless and outdated now.)"
    mc "(Hum, faz tempo que não verifico meu cartão de identificação da Irda... Ele está praticamente inútil e desatualizado agora.)"

# game/script3.rpy:12869
translate pt_br_anubisbr scene92_choice02_op2_5a78e80c:

#   mc "Find someone else. I'm still leaving."
    mc "Procure outra pessoa. Eu ainda vou embora."

# game/script3.rpy:12871
translate pt_br_anubisbr scene92_choice02_op2_5c9ed9e6:

#   amelia "Then consider our pact dissolved. Begone."
    amelia "Então considerem nosso pacto desfeito. Sumam daqui."

# game/script3.rpy:12872
translate pt_br_anubisbr scene92_choice02_op2_54ca7563:

#   amelia "And never show your face to me again... next time you and I meet, I won't be so merciful."
    amelia "E nunca mais mostre seu rosto para mim... da próxima vez que nos encontrarmos, não serei tão misericordioso."

# game/script3.rpy:12876
translate pt_br_anubisbr scene92_choice02_op2_1151d600:

#   mc "(Dammit... Almost an entire day wasted.)"
    mc "(Droga... Quase um dia inteiro perdido.)"

# game/script3.rpy:12877
translate pt_br_anubisbr scene92_choice02_op2_52ef36f8:

#   mc "Hurry up, girl. We can't waste more time."
    mc "Anda logo, garota. Não podemos perder mais tempo."

# game/script3.rpy:12883
translate pt_br_anubisbr scene92_choice02_op3_b5303eae:

#   mc "I should've captured you last time!"
    mc "Eu devia ter te capturado da última vez!"

# game/script3.rpy:12886
translate pt_br_anubisbr scene92_choice02_op3_a56a4d96:

#   sensation "Before your fist connects, the invisible force clamps your neck again even harder and more vicious this time. You sense intense hatred around you."
    sensation "Antes que seu punho acerte o alvo, a força invisível aperta seu pescoço novamente com ainda mais força e violência. Você sente um ódio intenso ao seu redor."

# game/script3.rpy:12887
translate pt_br_anubisbr scene92_choice02_op3_28dce375:

#   mc "Ghkn!"
    mc "Ghkn!"

# game/script3.rpy:12888
translate pt_br_anubisbr scene92_choice02_op3_7556f3fa:

#   amelia "Tsk, tsk. Wrong move, darling."
    amelia "Tsc, tsc. Péssima ideia, querida."

# game/script3.rpy:12889
translate pt_br_anubisbr scene92_choice02_op3_795756a1:

#   amelia "You see, I never actually removed my spell. It was still there... just hidden."
    amelia "Veja bem, eu nunca removi o feitiço de fato. Ele ainda estava lá... apenas oculto."

# game/script3.rpy:12890
translate pt_br_anubisbr scene92_choice02_op3_f4dc4346:

#   sensation "The grip shifts from your neck to your head, twisting sideways with unnatural strength. Bones creak, vision blac—"
    sensation "A pressão passa do seu pescoço para a sua cabeça, girando para os lados com uma força sobrenatural. Ossos estalam, visão turva—"

# game/script3.rpy:12893
translate pt_br_anubisbr scene92_choice02_op3_3518c7aa:

#   amelia "What a shame. Such potential... wasted."
    amelia "Que pena. Tanto potencial... desperdiçado."

# game/script3.rpy:12909
translate pt_br_anubisbr scene93_free_roam_pixie_1c5f76fe:

#   mc "What the—? Is someone in there?"
    mc "Que diabos?! Tem alguém aí dentro?"

# game/script3.rpy:12910
translate pt_br_anubisbr scene93_free_roam_pixie_7b42f3d1:

#   perception "Suspended among dried herbs and nondescript vials, is a small iron cage. Inside, something faintly luminous lies curled and utterly still."
    perception "Suspenso entre ervas secas e frascos sem qualquer descrição, encontra-se uma pequena gaiola de ferro. Dentro dela, algo levemente luminoso jaz encolhido e completamente imóvel."

# game/script3.rpy:12911
translate pt_br_anubisbr scene93_free_roam_pixie_bb2b1a96:

#   mc "H-Hello?"
    mc "O-Olá?"

# game/script3.rpy:12913
translate pt_br_anubisbr scene93_free_roam_pixie_44df62b6:

#   perception "As you lean closer, you realize it's not a doll, nor a corpse. Tiny wings, translucent like cracked glass are folded tight against a frail, glowing form."
    perception "Ao se aproximar, você percebe que não é uma boneca, nem um cadáver. Pequenas asas, translúcidas como vidro rachado, estão dobradas firmemente contra uma forma frágil e brilhante."

# game/script3.rpy:12914
translate pt_br_anubisbr scene93_free_roam_pixie_be5c9cb8:

#   mc "...A pixie?"
    mc "...Uma fada?"

# game/script3.rpy:12915
translate pt_br_anubisbr scene93_free_roam_pixie_6d52bb5f:

#   mc "Hey. Can you hear me?"
    mc "Ei. Você consegue me ouvir?"

# game/script3.rpy:12916
translate pt_br_anubisbr scene93_free_roam_pixie_810d911e:

#   pixie "Hnnm?"
    pixie "Hum?"

# game/script3.rpy:12918
translate pt_br_anubisbr scene93_free_roam_pixie_7f16a471:

#   perception "The creature stirs, a dim pulse of light rippling weakly through her body. Slowly, she lifts her head, eyes like polished dew fixing on you."
    perception "A criatura se mexe, um pulso tênue de luz ondulando fracamente por seu corpo. Lentamente, ela levanta a cabeça, os olhos como orvalho polido fixando-se em você."

# game/script3.rpy:12920
translate pt_br_anubisbr scene93_free_roam_pixie_5e7c80b4:

#   pixie "Oh. You are... new here."
    pixie "Ah. Você é... novo por aqui."

# game/script3.rpy:12922
translate pt_br_anubisbr scene93_free_roam_pixie_f9d4946c:

#   mc "Y-You can talk?"
    mc "V-Você consegue falar?"

# game/script3.rpy:12924
translate pt_br_anubisbr scene93_free_roam_pixie_45fcde74:

#   pixie "Once, I sang."
    pixie "Certa vez, eu cantei."

# game/script3.rpy:12925
translate pt_br_anubisbr scene93_free_roam_pixie_059d68ab:

#   pixie "Now I am kept."
    pixie "Agora estou preso."

# game/script3.rpy:12927
translate pt_br_anubisbr scene93_free_roam_pixie_405801d3:

#   mc "Are you... okay?"
    mc "Você está... bem?"

# game/script3.rpy:12928
translate pt_br_anubisbr scene93_free_roam_pixie_5aa51ed7:

#   pixie "Hmm."
    pixie "Hum."

# game/script3.rpy:12930
translate pt_br_anubisbr scene93_free_roam_pixie_3fa623ae:

#   pixie "Great tragedy has befallen you."
    pixie "Uma grande tragédia aconteceu com você."

# game/script3.rpy:12932
translate pt_br_anubisbr scene93_free_roam_pixie_3f9df27f:

#   mc "...What?"
    mc "...O que?"

# game/script3.rpy:12934
translate pt_br_anubisbr scene93_free_roam_pixie_1bda4b47:

#   pixie "Something old has brushed against you and found you... suitable."
    pixie "Algo antigo roçou em você e te achou... adequado."

# game/script3.rpy:12936
translate pt_br_anubisbr scene93_free_roam_pixie_1b9e82e9:

#   mc "I don't know what you're talking about."
    mc "Não sei do que você está falando."

# game/script3.rpy:12937
translate pt_br_anubisbr scene93_free_roam_pixie_6fccec47:

#   pixie "..."
    pixie "..."

# game/script3.rpy:12938
translate pt_br_anubisbr scene93_free_roam_pixie_eacce05a:

#   mc "Do you want to be free?"
    mc "Você quer ser livre?"

# game/script3.rpy:12940
translate pt_br_anubisbr scene93_free_roam_pixie_1ce8df70:

#   perception "For a moment, her glow flickers, hesitant, uncertain. Then the light fades, her small form curling in on itself once more."
    perception "Por um instante, seu brilho oscila, hesitante, incerto. Então a luz se dissipa, sua pequena forma se encolhendo sobre si mesma mais uma vez."

# game/script3.rpy:12949
translate pt_br_anubisbr scene93_free_roam_right_device_67cc062b:

#   mc "(So that's where I'm meant to lie. Strapped down like an animal...)"
    mc "(Então é aí que eu devo ficar. Amarrado como um animal...)"

# game/script3.rpy:12958
translate pt_br_anubisbr scene93_free_roam_up_door_493f59f1:

#   mc "(Amelia went in there to change, as if modesty matters now. I've already seen her naked before.)"
    mc "(Amélia entrou lá para se trocar, como se a modéstia importasse agora. Eu já a vi nua antes.)"

# game/script3.rpy:12977
translate pt_br_anubisbr scene93_free_roam_up_right_could_77956b58:

#   perception "The liquid inside the cauldron is too thick to be water, too alive to be stew, rising in lazy blisters. Strangely, it carries no scent at all."
    perception "O líquido dentro do caldeirão é denso demais para ser água, vivo demais para ser ensopado, subindo em bolhas preguiçosas. Estranhamente, não tem cheiro nenhum."

# game/script3.rpy:12980
translate pt_br_anubisbr scene93_free_roam_up_right_skull_7a910475:

#   mc "(That's... real. I wonder if it belonged to one of her previous 'toys'.)"
    mc "(Isso é... real. Será que pertencia a um dos seus \"brinquedos\" anteriores?)"

# game/script3.rpy:12988
translate pt_br_anubisbr scene93_free_roam_up_left_ball_ef2e109f:

#   mc "(A glass sphere. Strange... I can't see my reflection in there.)"
    mc "(Uma esfera de vidro. Estranho... Não consigo ver meu reflexo nela.)"

# game/script3.rpy:12991
translate pt_br_anubisbr scene93_free_roam_up_left_chalice_272149dd:

#   mc "(This is way too big! There's no way I'm filling this whole thing up... right?)"
    mc "(Isso é muito grande! Não tem como eu preencher tudo isso... né?)"

# game/script3.rpy:12995
translate pt_br_anubisbr scene93_free_roam_up_left_book_08a6b26f:

#   perception "A heavy book rests open on her desk, its script written in a language you don't understand. The margins are crowded with sketches, circles and bodies. It appears to be instructions for pulling something back from the grave."
    perception "Um livro pesado está aberto sobre a mesa dela, com a escrita em uma língua que você não entende. As margens estão repletas de esboços, círculos e figuras humanas. Parece ser um manual de instruções para ressuscitar algo dos mortos."

# game/script3.rpy:12996
translate pt_br_anubisbr scene93_free_roam_up_left_book_43da9c6e:

#   mc "(Some of these 'instructions' are crossed out. Was she really trying to bring someone from the dead?)"
    mc "(Algumas dessas 'instruções' estão riscadas. Será que ela estava mesmo tentando trazer alguém de volta dos mortos?)"

# game/script3.rpy:13021
translate pt_br_anubisbr scene94_0be1543f:

#   amelia "I'm ready. Follow me, darling. And don't forget to bring my contraption with you."
    amelia "Estou pronta. Siga-me, querida. E não se esqueça de trazer meu aparato com você."

# game/script3.rpy:13025
translate pt_br_anubisbr scene94_b77bd565:

#   amelia "Assume the position. Let's begin our arrangement~"
