    dm "Um santuário se ergue diante de você, mas bloqueando o caminho está um goblin solitário segurando uma adaga enferrujada."

# game/script3.rpy:860
translate pt_br_anubisbr s72_dLEFT_LEFT_shrine_ea4bf2b5:

#   mc "D-Does the goblin have a penis?"
