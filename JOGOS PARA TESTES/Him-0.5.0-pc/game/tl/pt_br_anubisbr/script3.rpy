    mc "Não. Preciso que você se acalme."

# game/script3.rpy:15011
translate pt_br_anubisbr scene100_b6a3c518:

#   perception "Her struggles grow weaker, not from lack of hatred, but from a dawning, crushing exhaustion. The fight bleeds out of her, replaced by tremors."
    perception "Seus esforços diminuem, não por falta de ódio, mas por um cansaço avassalador que se abate sobre ela. A luta se esvai, substituída por tremores."

# game/script3.rpy:15013
