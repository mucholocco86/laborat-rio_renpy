translate pt_br_anubisbr scene134_choice02_op3_505b5ecb:

#   mc "You need take better care of yourself. You're pregnant."
    mc "Você precisa cuidar melhor de si mesma. Você está grávida."

# game/script5.rpy:7112
translate pt_br_anubisbr scene134_choice02_op3_e301c43b:

#   mc "Your body is doing something exhausting, and yet you're here, fitting armor onto a stranger instead of feeding children or resting. That's not right."
    mc "Seu corpo está fazendo algo exaustivo, e mesmo assim você está aqui, colocando armadura em um estranho em vez de alimentar crianças ou descansar. Isso não está certo."

# game/script5.rpy:7119
translate pt_br_anubisbr scene134_choice02_op3_83480f52:

#   miralith "Master, I... This is my duty. This is what I was trained for."
    miralith "Mestre, eu... Este é o meu dever. Foi para isso que fui treinado."

# game/script5.rpy:7121
translate pt_br_anubisbr scene134_choice02_op3_c81422b7:

#   mc "Your needs matter, not just as a concubine, not just as a... baby-maker. As a person. You're not a piece of furniture."
    mc "Suas necessidades importam, não apenas como concubina, não apenas como... reprodutora. Como pessoa. Você não é um móvel."

# game/script5.rpy:7124
translate pt_br_anubisbr scene134_choice02_op3_5eb0d8fe:

#   miralith "..."
    miralith "..."

# game/script5.rpy:7126
translate pt_br_anubisbr scene134_choice02_op3_1dc2c426:

#   miralith "Thank you, Master. I will... I will think about what you said."
    miralith "Obrigado, Mestre. Eu vou... vou pensar no que o senhor disse."

# game/script5.rpy:7128
translate pt_br_anubisbr scene134_choice02_op3_7b471f6f:

#   mc "Good."
    mc "Bom."

# game/script5.rpy:7130
translate pt_br_anubisbr scene134_choice02_op3_4294d544:

#   aylin "I told you. He really is kind."
    aylin "Eu te disse. Ele é realmente gentil."

# game/script5.rpy:7131
translate pt_br_anubisbr scene134_choice02_op3_1485ee4e:

#   aylin "He kissed Nimah out of nowhere. She talked about a lot in the closet room."
    aylin "Ele beijou Nimah do nada. Ela falou muito no quarto do closet."

# game/script5.rpy:7132
translate pt_br_anubisbr scene134_choice02_op3_8365e0ce:

#   miralith "Yes~"
    miralith "Sim~"

# game/script5.rpy:7134
translate pt_br_anubisbr scene134_choice02_op3_aa447bd3:

#   aylin "You're really kind, Master."
    aylin "O senhor é muito gentil, Mestre."

# game/script5.rpy:7135
translate pt_br_anubisbr scene134_choice02_op3_93d57efa:

#   mc "You two deserve better. Look how hard you're working."
    mc "Vocês dois merecem coisa melhor. Vejam o quanto vocês estão se esforçando."

# game/script5.rpy:7137
translate pt_br_anubisbr scene134_choice02_op3_ea66671f:

#   miralith "*chuckles* Thank you."
    miralith "*risos* Obrigada."

# game/script5.rpy:7139
translate pt_br_anubisbr scene134_choice02_op3_6ea94333:

#   aylin "*giggles* Mhm~"
    aylin "*risinhos* Hum~"

# game/script5.rpy:7145
translate pt_br_anubisbr scene134_2_21330c37:

#   miralith "I feel a lot lighter now. That was... that was much needed. The pressure was becoming unbearable. I didn't realize how much I'd been holding in."
    miralith "Me sinto muito mais leve agora. Isso... isso era muito necessário. A pressão estava se tornando insuportável. Eu não tinha me dado conta de quanta coisa eu estava reprimindo."

# game/script5.rpy:7147
translate pt_br_anubisbr scene134_2_03114818:

#   mc "You had so much milk in you, it was probably weighing you down."
    mc "Você tinha tanto leite no corpo que provavelmente estava te deixando pesada."

# game/script5.rpy:7149
translate pt_br_anubisbr scene134_2_c6d9d67e:

#   aylin "*giggles* you had us working extra, Master. Fitting armor is one thing. What came after... that was beyond our usual duties."
    aylin "*risos* O senhor nos fez trabalhar mais do que o esperado, Mestre. Ajustar armaduras é uma coisa. O que veio depois... isso foi além das nossas obrigações normais."

# game/script5.rpy:7151
translate pt_br_anubisbr scene134_2_e0ecf094:

#   mc "I did. And I'll be sure to repay you. I'll tell Flint that you both went above and beyond."
    mc "Sim, fiz. E com certeza vou te recompensar. Vou dizer ao Flint que vocês dois foram além do esperado."

# game/script5.rpy:7153
translate pt_br_anubisbr scene134_2_e3c2f903:

#   miralith "Thank you. We don't often receive recognition. The king notices me, but only in certain ways."
    miralith "Obrigado. Não costumamos receber reconhecimento. O rei me nota, mas apenas de certas maneiras."

# game/script5.rpy:7155
translate pt_br_anubisbr scene134_2_741d50ad:

#   aylin "Good luck out there, Master. We will be waiting for your return~"
    aylin "Boa sorte lá fora, Mestre. Estaremos aguardando seu retorno."

# game/script5.rpy:7158
translate pt_br_anubisbr scene134_2_81f8c592:

#   mc "(It feels bulky and heavy. Oh well, I'll get used to it. Time to go. Negumi's probably already at the gate.)"
    mc "(Parece volumoso e pesado. Ah, bem, eu me acostumo. Hora de ir. Negumi provavelmente já está no portão.)"

# game/script5.rpy:7162
translate pt_br_anubisbr scene134_2_c9665f12:

#   aylin "How does it look, Master? I think it looks good on you."
    aylin "Como ficou, Mestre? Acho que ficou bem em você."

# game/script5.rpy:7164
translate pt_br_anubisbr scene134_2_09b402b7:

#   mc "Thank you. It feels a lot sturdier than my other armor."
    mc "Obrigado. Parece muito mais resistente do que minha outra armadura."

# game/script5.rpy:7165
translate pt_br_anubisbr scene134_2_0515757a:

#   mc "I feel safe. Safer than I have in weeks, or months, even."
    mc "Eu me sinto segura. Mais segura do que me senti nas últimas semanas, ou até mesmo nos últimos meses."

# game/script5.rpy:7167
translate pt_br_anubisbr scene134_2_5b00a847:

#   miralith "The blacksmiths deserve the credit for the craftsmanship."
    miralith "Os ferreiros merecem o crédito pela habilidade artesanal."

# game/script5.rpy:7168
translate pt_br_anubisbr scene134_2_5a871faf:

#   miralith "But I'm glad we could be of help anyway. Even in this small way."
    miralith "Mas fico feliz que tenhamos podido ajudar de alguma forma. Mesmo que seja de uma maneira pequena."

# game/script5.rpy:7169
translate pt_br_anubisbr scene134_2_23708428:

#   aylin "Good luck out there, Master. We will be waiting for your return."
    aylin "Boa sorte lá fora, Mestre. Estaremos aguardando seu retorno."

# game/script5.rpy:7173
translate pt_br_anubisbr scene134_2_ac3e683f:

#   mc "(Phew, there. That took a lot longer than I expected.)"
    mc "(Ufa, pronto. Isso demorou muito mais do que eu esperava.)"

# game/script5.rpy:7174
translate pt_br_anubisbr scene134_2_14b84cb6:

#   mc "(I look a lot better now. Not to mention safer. But it feels bulky and heavy. Oh well, I'll get used to it.)"
    mc "(Estou com uma aparência muito melhor agora. Sem falar que me sinto mais segura. Mas parece volumosa e pesada. Ah, bem, vou me acostumar.)"

# game/script5.rpy:7175
translate pt_br_anubisbr scene134_2_666d28f5:

#   mc "(Alright. Time to go. Negumi's probably already at the gate.)"
    mc "(Certo. Hora de ir. Negumi provavelmente já está no portão.)"

# game/script5.rpy:7183
translate pt_br_anubisbr scene135_0ae9bcd0:

#   ""
    ""

# game/script5.rpy:7185
translate pt_br_anubisbr scene135_657a13c2:

#   flint "[mc]! Hold on."
    flint "[mc]! Aguentar."

# game/script5.rpy:7187
translate pt_br_anubisbr scene135_45137a95:

#   mc "Flint. I was supposed to meet you. The ambassador said you'd brief me. Do you have any info on what I'm up against?"
    mc "Flint. Eu deveria me encontrar com você. O embaixador disse que você me daria informações. Você tem alguma ideia do que estou enfrentando?"

# game/script5.rpy:7189
translate pt_br_anubisbr scene135_87c5ad19:

#   flint "I do. What little there is. Listen, [mc]... I—"
    flint "Sim. O pouco que existe. Escute, [mc]... EU-"

# game/script5.rpy:7191
translate pt_br_anubisbr scene135_f35c6294:

#   mc "Please. I already felt the horror from Sanoud. He practically held a funeral for me in the corridor. I know this may as well be a death sentence."
    mc "Por favor. Eu já senti o horror vindo de Sanoud. Ele praticamente fez um funeral para mim no corredor. Sei que isso pode muito bem ser uma sentença de morte."

# game/script5.rpy:7192
translate pt_br_anubisbr scene135_ad99029c:

#   mc "But I'd rather hear whatever might help me."
    mc "Mas eu prefiro ouvir qualquer coisa que possa me ajudar."

# game/script5.rpy:7194
translate pt_br_anubisbr scene135_97f259b5:

#   flint "I understand. I'm happy to see you're accepting so well."
    flint "Entendo. Fico feliz em ver que você está aceitando tão bem."

# game/script5.rpy:7195
translate pt_br_anubisbr scene135_9a14afb4:

#   flint "Alright. Here's what we know. You're facing giants—two of them. A pair of brothers. And, if the legends are to be believed, they might be immortal."
    flint "Muito bem. Eis o que sabemos. Vocês estão enfrentando gigantes — dois deles. Dois irmãos. E, se as lendas forem verdadeiras, eles podem ser imortais."

# game/script5.rpy:7197
translate pt_br_anubisbr scene135_aae929c6:

#   mc "Immortal? The Zentian mentioned they sleep for decades. But immortal? As in... can't be killed? At all?"
    mc "Imortais? O Zentiano mencionou que eles dormem por décadas. Mas imortais? Como assim... não podem ser mortos? De jeito nenhum?"

# game/script5.rpy:7199
translate pt_br_anubisbr scene135_6e61a2e7:

#   flint "They have been here longer than you and I have lived. Even before our kingdom was established."
    flint "Eles estão aqui há mais tempo do que você e eu vivemos. Mesmo antes do nosso reino ser estabelecido."

# game/script5.rpy:7200
translate pt_br_anubisbr scene135_b30046aa:

#   flint "These two have somewhat of a pattern. The scholars have been tracking it for centuries. Generations of scholars, all recording the same thing."
    flint "Esses dois fenômenos apresentam um padrão em comum. Os estudiosos vêm investigando esse padrão há séculos. Gerações de estudiosos, todos registrando a mesma coisa."

# game/script5.rpy:7202
translate pt_br_anubisbr scene135_6e1c7e68:

#   flint "They sleep for about a decade. A full ten years of dormancy. Then they wake up for another decade."
    flint "Eles dormem por cerca de uma década. Dez anos completos de dormência. Depois, despertam por mais uma década."

# game/script5.rpy:7203
translate pt_br_anubisbr scene135_62424f5f:

#   flint "During this decade, they raise hell. They roam and eat whatever their fingers catch."
    flint "Durante essa década, eles causam o caos. Eles vagam e comem tudo o que suas garras apanham."

# game/script5.rpy:7205
translate pt_br_anubisbr scene135_a2a93e71:

#   mc "But they began inching closer and closer? The Zentian said they only recently blocked the trade route."
    mc "Mas eles começaram a se aproximar cada vez mais? O zentiano disse que eles só bloquearam a rota comercial recentemente."

# game/script5.rpy:7207
translate pt_br_anubisbr scene135_1024bda5:

#   flint "Exactly. It's only very recently that they've fully blocked the northeastern trade route with the Zentians."
    flint "Exatamente. Foi só muito recentemente que eles bloquearam completamente a rota comercial do nordeste com os Zentianos."

# game/script5.rpy:7208
translate pt_br_anubisbr scene135_9c67d4bc:

#   flint "Of course, we knew this would happen eventually. The scholars predicted it decades ago, but... what would we even do about it?"
    flint "É claro que sabíamos que isso acabaria acontecendo. Os estudiosos previram isso décadas atrás, mas... o que poderíamos fazer a respeito?"

# game/script5.rpy:7210
translate pt_br_anubisbr scene135_2e9d88a3:

#   mc "Yeah. Those soldiers you guys sent weren't much help."
    mc "É. Aqueles soldados que vocês enviaram não foram de muita ajuda."

# game/script5.rpy:7212
translate pt_br_anubisbr scene135_58cd2a47:

#   flint "Unfortunately... yes. So many good soldiers lost. Sanoud was underestimating the numbers, he always say thousands were lost, but that's only during our lifetimes."
    flint "Infelizmente... sim. Tantos bons soldados perdidos. Sanoud subestimou os números; ele sempre dizia que milhares foram perdidos, mas isso só aconteceu durante a nossa vida."

# game/script5.rpy:7213
translate pt_br_anubisbr scene135_bbbc46de:

#   flint "The total since our kingdom was established is... in the tens of thousands."
    flint "O total desde a fundação do nosso reino é... na casa das dezenas de milhares."

# game/script5.rpy:7215
translate pt_br_anubisbr scene135_eb81c569:

#   mc "What hope do I even have, then? Do they have a weakness? Something... anything?"
    mc "Que esperança me resta, então? Será que eles têm alguma fraqueza? Algo... qualquer coisa?"

# game/script5.rpy:7217
translate pt_br_anubisbr scene135_24e92359:

#   flint "Not as far as we know. They tower over us regular humans—they're as tall as our city walls."
    flint "Que saibamos, não. Eles são muito maiores que nós, humanos comuns — tão altos quanto as muralhas da nossa cidade."

# game/script5.rpy:7219
translate pt_br_anubisbr scene135_60dc975a:

#   mc "That tall?!"
    mc "Tão alto assim?!"

# game/script5.rpy:7221
translate pt_br_anubisbr scene135_d0f950a2:

#   flint "Yes. And those are just estimates from the survivors. The ones who got close enough to see them clearly."
    flint "Sim. E essas são apenas estimativas dos sobreviventes. Daqueles que chegaram perto o suficiente para vê-los claramente."

# game/script5.rpy:7223
translate pt_br_anubisbr scene135_80bf8243:

#   mc "You're not making this easy, Flint. You're really, really not making this easy."
    mc "Você não está facilitando as coisas, Flint. Você realmente não está facilitando as coisas."

# game/script5.rpy:7225
translate pt_br_anubisbr scene135_f4b32508:

#   flint "I'm sorry, [mc]. I'm not here to fill you with false hope."
    flint "Desculpe, [mc] Não estou aqui para lhe dar falsas esperanças."

# game/script5.rpy:7226
translate pt_br_anubisbr scene135_6d050626:

#   flint "My job is to prepare you. To give you the truth. And the truth is... is as close to impossible as anything I've ever seen."
    flint "Meu trabalho é prepará-los. Dizer-lhes a verdade. E a verdade é... é tão próxima do impossível quanto qualquer coisa que eu já tenha visto."

# game/script5.rpy:7227
translate pt_br_anubisbr scene135_f7b5fef0:

#   flint "I think Ambassador Sanoud already told you. You don't really have to fight. The king's orders were given in anger. He doesn't actually expect you to succeed."
    flint "Acho que o embaixador Sanoud já lhe disse. Você não precisa lutar. As ordens do rei foram dadas em um momento de raiva. Ele não espera que você tenha sucesso."

# game/script5.rpy:7229
translate pt_br_anubisbr scene135_521ea90f:

#   mc "So he expects me to run, even if it means abandoning the mission?"
    mc "Então ele espera que eu fuja, mesmo que isso signifique abandonar a missão?"

# game/script5.rpy:7231
translate pt_br_anubisbr scene135_ec790eb2:

#   flint "Yes."
    flint "Sim."

# game/script5.rpy:7233
translate pt_br_anubisbr scene135_2b35b6fe:

#   mc "..."
    mc "..."

# game/script5.rpy:7234
translate pt_br_anubisbr scene135_92d05acb:

#   mc "We'll see what happens. Point me to where they are."
    mc "Veremos o que acontece. Indique-me onde eles estão."

# game/script5.rpy:7236
translate pt_br_anubisbr scene135_587e7ad9:

#   flint "Give me your map. I'll mark the location. The pass is northeast, a two day's ride from here."
    flint "Me dê seu mapa. Vou marcar a localização. A passagem fica a nordeste, a dois dias de viagem daqui."

# game/script5.rpy:7238
translate pt_br_anubisbr scene135_3a613e01:

#   empathy "His expression is serious as he marks the location. His hand is steady, but his eyes betray him—haunted, almost vacant. He's already mourning you."
    empathy "Sua expressão é séria enquanto marca o local. Sua mão é firme, mas seus olhos o traem — assombrados, quase vazios. Ele já está de luto por você."

# game/script5.rpy:7240
translate pt_br_anubisbr scene135_8ac9fde0:

#   flint "There. I pray to the Gods that you come back alive, [mc]."
    flint "Pronto. Rezo aos deuses para que você volte vivo. [mc]."

# game/script5.rpy:7241
translate pt_br_anubisbr scene135_17eb8dfb:

#   flint "I heard from Alexandria that you already have a weapon. Adamantite, correct?"
    flint "Ouvi dizer em Alexandria que você já tem uma arma. Adamantita, correto?"

# game/script5.rpy:7243
translate pt_br_anubisbr scene135_38ca9f63:

#   mc "Shit! It's on the carriage we arrived with, and I don't know where it is!"
    mc "Droga! Está na carruagem em que chegamos, e eu não sei onde está!"

# game/script5.rpy:7245
translate pt_br_anubisbr scene135_bdaf1100:

#   flint "Relax. She brought it to the palace before dawn arrived. We have it with us."
    flint "Relaxem. Ela trouxe para o palácio antes do amanhecer. Nós temos conosco."

# game/script5.rpy:7246
translate pt_br_anubisbr scene135_c68ed6d3:

#   flint "It's outside with the guards, attached to your horse."
    flint "Fica lá fora, com os guardas, preso ao seu cavalo."

# game/script5.rpy:7248
translate pt_br_anubisbr scene135_48125bca:

#   mc "Phew... good. And yes, it's adamantite. Made by the best smith in Irda."
    mc "Ufa... que bom. E sim, é adamantita. Feito pelo melhor ferreiro de Irda."

# game/script5.rpy:7250
translate pt_br_anubisbr scene135_d716d63e:

#   flint "I see. Adamantite is the bare minimum to even fight them. Regular steel shatters against their skin."
    flint "Entendo. Adamantita é o mínimo necessário para sequer lutar contra eles. Aço comum se estilhaça contra a pele deles."

# game/script5.rpy:7251
translate pt_br_anubisbr scene135_ae99ad00:

#   flint "Even advanced magic spells wouldn't work. I hope your friend, Negumi, is powerful enough."
    flint "Nem mesmo feitiços mágicos avançados funcionariam. Espero que seu amigo, Negumi, seja poderoso o suficiente."

# game/script5.rpy:7253
translate pt_br_anubisbr scene135_bd3b8857:

#   mc "I'll be off, Flint. That... that wasn't really helpful, but thank you anyway."
    mc "Vou indo, Flint. Isso... isso não foi muito útil, mas obrigado mesmo assim."

# game/script5.rpy:7255
translate pt_br_anubisbr scene135_177f8700:

#   flint "I'm sorry. That's all I seem to be able to offer these days."
    flint "Sinto muito. Parece que é tudo o que consigo oferecer ultimamente."

# game/script5.rpy:7256
translate pt_br_anubisbr scene135_ba50e50b:

#   flint "Not many people get back alive from that pass. And those who do... they usually come back missing several limbs, or their full mental capapilites."
    flint "Poucas pessoas voltam vivas daquela passagem. E aquelas que voltam... geralmente retornam sem vários membros ou com as capacidades mentais comprometidas."

# game/script5.rpy:7258
translate pt_br_anubisbr scene135_8c7f2f5c:

#   mc "(Goddammit... just what have you put me through, Negumi?)"
    mc "(Droga... o que você me fez passar, Negumi?)"

# game/script5.rpy:7260
translate pt_br_anubisbr scene135_0d832ecd:

#   shiver "You feel a knot in your throat. There's a grip on your stomach, cold and tight, like a fist squeezing from the inside."
    shiver "Você sente um nó na garganta. Há um aperto no estômago, frio e forte, como um punho apertando por dentro."

# game/script5.rpy:7262
translate pt_br_anubisbr scene135_16c7cd04:

#   mc "I don't know if I should punch you or not, Negumi."
    mc "Não sei se devo te dar um soco ou não, Negumi."

# game/script5.rpy:7264
translate pt_br_anubisbr scene135_0b3229b8:

#   negumi "...I'm sorry, [mc]. I know I put you in this position. I know this is my fault. But... but this is finally my chance to prove myself!"
    negumi "...Desculpe, [mc] Eu sei que te coloquei nessa situação. Eu sei que a culpa é minha. Mas... mas esta é finalmente a minha chance de provar meu valor!"

# game/script5.rpy:7265
translate pt_br_anubisbr scene135_39b0e5cc:

#   negumi "It's my chance to show the world what I can do! My chance to—"
    negumi "É a minha chance de mostrar ao mundo o que eu posso fazer! Minha chance de—"

# game/script5.rpy:7267
translate pt_br_anubisbr scene135_d9911515:

#   mc "Prove yourself to what?! To who?!"
    mc "Provar o seu valor a quê?! A quem?!"

# game/script5.rpy:7268
translate pt_br_anubisbr scene135_1ee52368:

#   mc "What is so important that you'd volunteer us both for a suicide mission without even asking me first?!"
    mc "O que é tão importante que você nos ofereceria como voluntários para uma missão suicida sem nem mesmo me consultar primeiro?!"

# game/script5.rpy:7270
translate pt_br_anubisbr scene135_f315c4c5:

#   negumi "To everyone!"
    negumi "Para todos!"

# game/script5.rpy:7271
translate pt_br_anubisbr scene135_082c9199:

#   negumi "To everyone who ever doubted me! To everyone who ever called me a mistake, a joke!"
    negumi "A todos que um dia duvidaram de mim! A todos que um dia me chamaram de erro, de piada!"

# game/script5.rpy:7272
translate pt_br_anubisbr scene135_f4feb06a:

#   negumi "To the mages who said I'd never amount to anything! To my family, who told me I was wasting my life! To everyone who ever looked at me and saw nothing but an idiot playing pretend!"
    negumi "Aos magos que disseram que eu nunca seria ninguém na vida! À minha família, que me disse que eu estava desperdiçando minha vida! A todos que um dia olharam para mim e não viram nada além de um idiota fingindo!"

# game/script5.rpy:7275
translate pt_br_anubisbr scene135_a05ce7b1:

#   negumi "..."
    negumi "..."

# game/script5.rpy:7277
translate pt_br_anubisbr scene135_6da04608:

#   negumi "Sorry. I... it's a promise from my childhood. Something I swore I'd do."
    negumi "Desculpe. Eu... é uma promessa da minha infância. Algo que jurei que faria."

# game/script5.rpy:7278
translate pt_br_anubisbr scene135_adf06b09:

#   negumi "Pulling you along wasn't my intention. I don't think, I just act. That's all I've ever done."
    negumi "Não era minha intenção te arrastar. Eu não penso, eu apenas ajo. É tudo o que sempre fiz."

# game/script5.rpy:7280
translate pt_br_anubisbr scene135_f16e7a20:

#   mc "*sigh* We're already past that now. The king gave his orders."
    mc "*Suspiro* Já passamos dessa fase. O rei deu suas ordens."

# game/script5.rpy:7281
translate pt_br_anubisbr scene135_517c22b9:

#   mc "There's no going back now. So let's just survive, alright?"
    mc "Agora não tem mais volta. Então vamos só sobreviver, tá bom?"

# game/script5.rpy:7274
translate pt_br_anubisbr scene135_2b35b6fe_1:

#   mc "..."
    mc "..."

# game/script5.rpy:7282
translate pt_br_anubisbr scene135_a05ce7b1_1:

#   negumi "..."
    negumi "..."

# game/script5.rpy:7289
translate pt_br_anubisbr scene135_choice01_op1_5f3f580d:

#   mc "You know what? Let's do it! Let's kill those giants! Let's give the bards something to sing about for the next thousand years!"
    mc "Sabe de uma coisa? Vamos lá! Vamos matar esses gigantes! Vamos dar aos bardos algo sobre o que cantar pelos próximos mil anos!"

# game/script5.rpy:7291
translate pt_br_anubisbr scene135_choice01_op1_a05ce7b1:

#   negumi "..."
    negumi "..."

# game/script5.rpy:7293
translate pt_br_anubisbr scene135_choice01_op1_2750654c:

#   negumi "...Y-You're right! We got this, [mc]!"
    negumi "...Você tem razão! Nós conseguimos! [mc]!"

# game/script5.rpy:7294
translate pt_br_anubisbr scene135_choice01_op1_6728b673:

#   negumi "Let's go! To glory! And if we die, then at least we'll die together! At least we'll die as legends!"
    negumi "Vamos lá! Rumo à glória! E se morrermos, pelo menos morreremos juntos! Pelo menos morreremos como lendas!"

# game/script5.rpy:7295
translate pt_br_anubisbr scene135_choice01_op1_b35e4f01:

#   mc "*chuckles* That's the spirit."
    mc "*risos* É isso aí!"

# game/script5.rpy:7301
translate pt_br_anubisbr scene135_choice01_op2_58b21a6d:

#   mc "That's enough sulking, Negumi. Let's move."
    mc "Chega de birra, Negumi. Vamos embora."

# game/script5.rpy:7302
translate pt_br_anubisbr scene135_choice01_op2_74312f10:

#   mc "You put me through this. You put us both through this. The least you could do is own up to it."
    mc "Você me fez passar por isso. Você nos fez passar por isso. O mínimo que você poderia fazer é assumir a responsabilidade."

# game/script5.rpy:7304
translate pt_br_anubisbr scene135_choice01_op2_1e169f26:

#   negumi "*sigh* ...You're right. I don't blame you for hating me. I'd hate me too, if I were in your place."
    negumi "*suspiro* ...Você tem razão. Não te culpo por me odiar. Eu também me odiaria se estivesse no seu lugar."

# game/script5.rpy:7305
translate pt_br_anubisbr scene135_choice01_op2_46257611:

#   negumi "Let's go. I'll try to be out of your way. And if I fail, then... run."
    negumi "Vamos lá. Vou tentar não te atrapalhar. E se eu não conseguir, então... corro."

# game/script5.rpy:7306
translate pt_br_anubisbr scene135_choice01_op2_26fe70bc:

#   negumi "And if you'd rather run away right now... that's fine by me."
    negumi "E se você preferir fugir agora mesmo... por mim, tudo bem."

# game/script5.rpy:7314
translate pt_br_anubisbr scene135_2_12fe0698:

#   env "The city walls draw nearer, then further. The sandstone buildings of Nahraya shrink, replaced by rocky outcroppings and sparse desert scrub."
    env "As muralhas da cidade se aproximam, depois se afastam. Os edifícios de arenito de Nahraya diminuem, substituídos por afloramentos rochosos e vegetação rasteira esparsa do deserto."

# game/script5.rpy:7316
translate pt_br_anubisbr scene135_2_bb0faef5:

#   negumi "Can we rest for a little? An exhausted mage is a dead mage."
    negumi "Podemos descansar um pouco? Um mago exausto é um mago morto."

# game/script5.rpy:7318
translate pt_br_anubisbr scene135_2_0fb7425c:

#   mc "Yeah, you're right. We've been riding for a while."
    mc "Sim, você tem razão. Já faz um tempo que estamos nessa jornada."

# game/script5.rpy:7320
translate pt_br_anubisbr scene135_2_4d9f4797:

#   negumi "Let's set up camp near that oasis."
    negumi "Vamos acampar perto daquele oásis."

# game/script5.rpy:7322
translate pt_br_anubisbr scene135_2_7150109c:

#   mc "Oasis? Where do you see an oasis?"
    mc "Oásis? Onde você vê um oásis?"

# game/script5.rpy:7324
translate pt_br_anubisbr scene135_2_6d79f316:

#   negumi "I can sense water through my mana. It's to the east, about ten minutes' ride."
    negumi "Consigo sentir a presença da água através da minha mana. Fica a leste, a cerca de dez minutos de viagem."

# game/script5.rpy:7325
translate pt_br_anubisbr scene135_2_42dfef93:

#   mc "Whoa. That's actually helpful."
    mc "Uau. Isso é realmente útil."

# game/script5.rpy:7327
translate pt_br_anubisbr scene135_2_856e9dc1:

#   env "Green trees break the monotony of yellow sand and gray rock. A small pond of water sits in the center of the oasis—crystal clear, surrounded by date palms."
    env "Árvores verdes quebram a monotonia da areia amarela e da rocha cinzenta. Um pequeno lago de água cristalina, rodeado por palmeiras, fica no centro do oásis."

# game/script5.rpy:7328
translate pt_br_anubisbr scene135_2_fef0cb64:

#   mc "You were right! There's really an oasis here."
    mc "Você tinha razão! Realmente existe um oásis aqui."

# game/script5.rpy:7329
translate pt_br_anubisbr scene135_2_5abbbd14:

#   negumi "Heh. Of course I was right."
    negumi "Heh. Claro que eu estava certo."

# game/script5.rpy:7331
translate pt_br_anubisbr scene135_2_499527f2:

#   perception "You lead [horse] to the water's edge. She drink greedily. The sun sets through the palm fronds, casting shadows across the pond."
    perception "Você lidera [horse] até a beira da água. Ela bebe avidamente. O sol se põe por entre as folhas das palmeiras, projetando sombras sobre o lago."

# game/script5.rpy:7332
translate pt_br_anubisbr scene135_2_098f433c:

#   negumi "What's your horse's name? He's quite strong for going this distance."
    negumi "Qual o nome do seu cavalo? Ele é bem forte para percorrer essa distância."

# game/script5.rpy:7333
translate pt_br_anubisbr scene135_2_07d42b18:

#   mc "It's [horse]. And it's a she. She's been with me since Irda."
    mc "Isso é [horse] E é uma menina. Ela está comigo desde Irda."

# game/script5.rpy:7335
translate pt_br_anubisbr scene135_2_fc2da4cf:

#   negumi "Hnnngg! There! My humble abode is set. You may enter, [mc]. I have faith in your manhood that you won't touch me inappropriately."
    negumi "Hnnngg! Pronto! Minha humilde morada está posta. Pode entrar. [mc] Tenho fé na sua masculinidade e sei que você não me tocará de forma inapropriada."

# game/script5.rpy:7336
translate pt_br_anubisbr scene135_2_7a243223:

#   negumi "You seem like the honorable type."
    negumi "Você parece ser do tipo honrado."

# game/script5.rpy:7338
translate pt_br_anubisbr scene135_2_c94e8ec6:

#   mc "Hey! Don't get the wrong idea about me!"
    mc "Ei! Não tire conclusões precipitadas sobre mim!"

# game/script5.rpy:7340
translate pt_br_anubisbr scene135_2_966b8512:

#   perception "She pulls off her boots, revealing her feet. A large sum of sand spills from each boot."
    perception "Ela tira as botas, revelando os pés. Uma grande quantidade de areia cai de cada bota."

# game/script5.rpy:7341
translate pt_br_anubisbr scene135_2_745ac692:

#   negumi "Ugh... this sand. It's been driving me insane since the moment I arrived here."
    negumi "Ai... essa areia. Ela está me enlouquecendo desde o momento em que cheguei aqui."

# game/script5.rpy:7342
translate pt_br_anubisbr scene135_2_0768db3a:

#   negumi "How do people live here? How does anyone live here?"
    negumi "Como as pessoas vivem aqui? Como alguém consegue viver aqui?"

# game/script5.rpy:7344
translate pt_br_anubisbr scene135_2_4431db2f:

#   mc "You're not wearing socks? You've been walking around the desert, in boots, with no socks?"
    mc "Você não está usando meias? Você andou pelo deserto de botas, sem meias?"

# game/script5.rpy:7346
translate pt_br_anubisbr scene135_2_6029a82a:

#   negumi "No? Do I have to?"
    negumi "Não? Preciso mesmo?"

# game/script5.rpy:7348
translate pt_br_anubisbr scene135_2_d6c024d2:

#   mc "...You kinda do."
    mc "...Você meio que faz isso."

# game/script5.rpy:7350
translate pt_br_anubisbr scene135_2_f1d38ca5:

#   negumi "I'll just wash them in the pond."
    negumi "Vou lavá-los no lago."

# game/script5.rpy:7351
translate pt_br_anubisbr scene135_2_072e75b6:

#   negumi "As for you, gather some wood. It gets really cold at night."
    negumi "Quanto a você, junte um pouco de lenha. Fica muito frio à noite."

# game/script5.rpy:7358
translate pt_br_anubisbr scene135_choice02_op1_7324a03a:

#   mc "Before I gather anything... do you want help? With your feet? They must be aching."
    mc "Antes de eu pegar qualquer coisa... você quer ajuda? Com ​​os pés? Devem estar doendo."

# game/script5.rpy:7360
translate pt_br_anubisbr scene135_choice02_op1_07c74fb5:

#   negumi "*laughs* What?"
    negumi "*risos* O quê?"

# game/script5.rpy:7361
translate pt_br_anubisbr scene135_choice02_op1_2d5e807a:

#   negumi "You're fine with touching my sweaty feet? Voluntarily? Without being asked?"
    negumi "Você se importaria de tocar nos meus pés suados? Voluntariamente? Sem que eu pedisse?"

# game/script5.rpy:7363
translate pt_br_anubisbr scene135_choice02_op1_0038a923:

#   mc "Yeah. I don't mind."
    mc "Sim. Não me importo."

# game/script5.rpy:7364
translate pt_br_anubisbr scene135_choice02_op1_889672ab:

#   mc "I need you at your best. If that means taking a few minutes to work the tension out of your feet, then it's worth it."
    mc "Preciso que você esteja no seu melhor. Se isso significar dedicar alguns minutos para aliviar a tensão nos pés, então vale a pena."

# game/script5.rpy:7366
translate pt_br_anubisbr scene135_choice02_op1_27424668:

#   negumi "I don't know... I feel embarrassed. I don't even let those boot shiners from the market near me."
    negumi "Não sei... Sinto-me envergonhado. Nem sequer deixo aqueles engraxates do mercado chegarem perto de mim."

# game/script5.rpy:7367
translate pt_br_anubisbr scene135_choice02_op1_69f87b99:

#   negumi "And it's not because I can't afford it! I just... don't want them near me."
    negumi "E não é porque eu não possa pagar! Eu simplesmente... não os quero perto de mim."

# game/script5.rpy:7369
translate pt_br_anubisbr scene135_choice02_op1_34a5e5f1:

#   mc "You can trust being around me. I really want to."
    mc "Você pode confiar em mim. Eu realmente quero isso."

# game/script5.rpy:7371
translate pt_br_anubisbr scene135_choice02_op1_63b72544:

#   negumi "...Alright. Fine. Just... don't make this weird."
    negumi "...Certo. Tudo bem. Só... não torne isso estranho."

# game/script5.rpy:7373
translate pt_br_anubisbr scene135_choice02_op1_06611888:

#   mc "You're usually the one who makes things weird. I'm the normal one here."
    mc "Geralmente é você quem deixa as coisas estranhas. Eu sou o normal aqui."

# game/script5.rpy:7375
translate pt_br_anubisbr scene135_choice02_op1_969a1b69:

#   negumi "Not this time."
    negumi "Desta vez não."

# game/script5.rpy:7378
translate pt_br_anubisbr scene135_choice02_op1_6860ad6c:

#   sensation "You carefully lift one of her feet. The sole is warm, a little dusty. The arch is tight under your thumbs."
    sensation "Você levanta cuidadosamente um dos pés dela. A sola está quente, um pouco empoeirada. O arco do pé está firme sob seus polegares."

# game/script5.rpy:7380
translate pt_br_anubisbr scene135_choice02_op1_e49a04d0:

#   negumi "Ah~ Alright, that's... actually not terrible."
    negumi "Ah, tudo bem... na verdade, não é tão ruim assim."

# game/script5.rpy:7382
translate pt_br_anubisbr scene135_choice02_op1_07cb1299:

#   mc "Just tell me if I press too hard."
    mc "Apenas me avise se eu pressionar com muita força."

# game/script5.rpy:7384
translate pt_br_anubisbr scene135_choice02_op1_cffaf2b3:

#   negumi "You're fine so far. It's just... strange having someone else do this."
    negumi "Até agora, tudo bem. É só... estranho que outra pessoa esteja fazendo isso."

# game/script5.rpy:7385
translate pt_br_anubisbr scene135_choice02_op1_a0c64906:

#   negumi "You really don't mind the sweat? Or the... smell?"
    negumi "Você realmente não se importa com o suor? Ou com o... cheiro?"

# game/script5.rpy:7387
translate pt_br_anubisbr scene135_choice02_op1_46e559f4:

#   mc "Nothing I can't handle."
    mc "Nada que eu não consiga lidar."

# game/script5.rpy:7389
translate pt_br_anubisbr scene135_choice02_op1_c4860675:

#   negumi "Mphmmm~ You're weirdly good at this. Have you done this before?"
    negumi "Hummm... Você é estranhamente bom nisso. Já fez isso antes?"

# game/script5.rpy:7391
translate pt_br_anubisbr scene135_choice02_op1_985ae50c:

#   mc "A couple of times."
    mc "Algumas vezes."

# game/script5.rpy:7393
translate pt_br_anubisbr scene135_choice02_op1_70e260a1:

#   perception "You keep massaging in silence for a short while, only the quiet sound of your hands moving and the desert wind filling the space between you."
    perception "Você continua a massagem em silêncio por um breve momento, apenas o som suave de suas mãos se movendo e o vento do deserto preenchendo o espaço entre vocês."

# game/script5.rpy:7394
translate pt_br_anubisbr scene135_choice02_op1_1a24e6b2:

#   negumi "Ahhh~"
    negumi "Ahhh~"

# game/script5.rpy:7395
translate pt_br_anubisbr scene135_choice02_op1_2b35b6fe:

#   mc "..."
    mc "..."

# game/script5.rpy:7401
translate pt_br_anubisbr scene135_choice03_op1_fa27613c:

#   perception "Without really thinking, you lean in a little closer while your thumbs press into her arch. You draw in a quiet breath near her toes."
    perception "Sem pensar muito, você se inclina um pouco mais para perto enquanto seus polegares pressionam o arco do pé dela. Você inspira suavemente perto dos dedos dos pés dela."

# game/script5.rpy:7402
translate pt_br_anubisbr scene135_choice03_op1_841b85be:

#   negumi "...Are... are you sniffing my foot?"
    negumi "...Você... você está cheirando meu pé?"

# game/script5.rpy:7404
translate pt_br_anubisbr scene135_choice03_op1_9591fca2:

#   mc "I... uhh... I can explain—"
    mc "Eu... hum... posso explicar—"

# game/script5.rpy:7406
translate pt_br_anubisbr scene135_choice03_op1_eb48a929:

#   negumi "You're so weird! What the hell was that?! I specifically told you not to make it weird!"
    negumi "Você é tão estranho! Que diabos foi isso?! Eu disse especificamente para você não fazer nada estranho!"

# game/script5.rpy:7408
translate pt_br_anubisbr scene135_choice03_op1_054dec1c:

#   mc "They don't smell bad! They just smell like... you."
    mc "Eles não têm um cheiro ruim! Eles só têm o seu cheiro."

# game/script5.rpy:7409
translate pt_br_anubisbr scene135_choice03_op1_a4a86a57:

#   mc "I was curious. I'm sorry."
    mc "Eu estava curioso. Me desculpe."

# game/script5.rpy:7411
translate pt_br_anubisbr scene135_choice03_op1_f2a72a3a:

#   negumi "That is not a normal thing to say. Or do."
    negumi "Isso não é algo normal de se dizer. Ou de se fazer."

# game/script5.rpy:7413
translate pt_br_anubisbr scene135_choice03_op1_f4b5f6a5:

#   mc "I know. It just... happened."
    mc "Eu sei. Simplesmente... aconteceu."

# game/script5.rpy:7415
translate pt_br_anubisbr scene135_choice03_op1_c12a8ba7:

#   negumi "'It just happened'? You leaned in and sniffed them on purpose!"
    negumi "\"Aconteceu do nada\"? Você se inclinou e cheirou eles de propósito!"

# game/script5.rpy:7416
translate pt_br_anubisbr scene135_choice03_op1_f3c9cfec:

#   negumi "You're lucky they don't actually stink right now."
    negumi "Você tem sorte de eles não estarem fedendo agora."

# game/script5.rpy:7418
translate pt_br_anubisbr scene135_choice03_op1_21eabfc3:

#   mc "They don't? I beg to differ. But in a good way."
    mc "Não? Discordo. Mas de um jeito bom."

# game/script5.rpy:7420
translate pt_br_anubisbr scene135_choice03_op1_085b3fac:

#   negumi "Alright, that's enough! You made this even weirder."
    negumi "Muito bem, chega! Você deixou tudo ainda mais estranho."

# game/script5.rpy:7422
translate pt_br_anubisbr scene135_choice03_op1_d319395b:

#   mc "*chuckles* Still doesn't smell that bad. Just saying."
    mc "*risos* Ainda não cheira tão mal assim. Só dizendo."

# game/script5.rpy:7424
translate pt_br_anubisbr scene135_choice03_op1_47f7be3b:

#   negumi "*sigh* Whatever. Just go and get some wood already."
    negumi "*suspiro* Tanto faz. Vai logo buscar lenha."

# game/script5.rpy:7425
translate pt_br_anubisbr scene135_choice03_op1_d5d8dbc7:

#   negumi "Thank you for the massage. Before you got weird, it was actually really nice. I'll take care of myself now."
    negumi "Obrigada pela massagem. Antes de você ficar estranho, estava sendo muito boa. Vou me cuidar agora."

# game/script5.rpy:7431
translate pt_br_anubisbr scene135_choice03_op2_e9a92ed4:

#   perception "You pause the massage for a moment. Then, before you can second-guess yourself, you lean down and drag your tongue slowly along her toes."
    perception "Você interrompe a massagem por um instante. Então, antes que possa hesitar, inclina-se e desliza a língua lentamente pelos dedos dos pés dela."

# game/script5.rpy:7432
translate pt_br_anubisbr scene135_choice03_op2_fc710717:

#   negumi "Ah! What are you—[mc], what are you DOING?!"
    negumi "Ah! O que você está—[mc], O que você está fazendo?!"

# game/script5.rpy:7434
translate pt_br_anubisbr scene135_choice03_op2_b0a223c4:

#   mc "I... I don't know. I just wanted to."
    mc "Eu... eu não sei. Eu só queria."

# game/script5.rpy:7436
translate pt_br_anubisbr scene135_choice03_op2_81597db0:

#   negumi "You licked my sweaty foot! Who does that!?"
    negumi "Você lambeu meu pé suado! Quem faz isso!?"

# game/script5.rpy:7437
translate pt_br_anubisbr scene135_choice03_op2_42fa501c:

#   negumi "Did the desert heat cook your brain?!"
    negumi "O calor do deserto fritou seu cérebro?!"

# game/script5.rpy:7439
translate pt_br_anubisbr scene135_choice03_op2_20ce672f:

#   mc "I just... wanted to make you feel good. All of you. Even your feet... {i}especially{/i} your feet."
    mc "Eu só... queria fazer vocês se sentirem bem. Todos vocês. Até os seus pés... {i} especialmente{/i} seus pés."

# game/script5.rpy:7441
translate pt_br_anubisbr scene135_choice03_op2_5a15ba59:

#   negumi "That is not a normal way to make someone feel good!"
    negumi "Essa não é uma maneira normal de fazer alguém se sentir bem!"

# game/script5.rpy:7443
translate pt_br_anubisbr scene135_choice03_op2_e2e91c47:

#   empathy "Her face is burning. She looks equal parts scandalized and confused, as if her brain is still trying to process what just happened."
    empathy "Seu rosto está em chamas. Ela parece igualmente escandalizada e confusa, como se seu cérebro ainda estivesse tentando processar o que acabou de acontecer."

# game/script5.rpy:7445
translate pt_br_anubisbr scene135_choice03_op2_d9cbc155:

#   negumi "You're actually serious right now. You didn't slip or something. You... you did that on purpose!"
    negumi "Você está falando sério mesmo. Você não escorregou nem nada do tipo. Você... você fez isso de propósito!"

# game/script5.rpy:7447
translate pt_br_anubisbr scene135_choice03_op2_ff9c775e:

#   mc "Yeah. I did. And I'd do it again if you wanted me to."
    mc "Sim, eu fiz. E faria de novo se você quisesse."

# game/script5.rpy:7449
translate pt_br_anubisbr scene135_choice03_op2_b07853f2:

#   negumi "I don't even know what to say to that..."
    negumi "Nem sei o que dizer sobre isso..."

# game/script5.rpy:7450
translate pt_br_anubisbr scene135_choice03_op2_37313762:

#   negumi "If you ever do that again, I'm kicking you in the face."
    negumi "Se você fizer isso de novo, eu vou te dar um chute na cara."

# game/script5.rpy:7452
translate pt_br_anubisbr scene135_choice03_op2_69601db0:

#   mc "*chuckles* Fair."
    mc "*risos* Justo."

# game/script5.rpy:7454
translate pt_br_anubisbr scene135_choice03_op2_42ebd20a:

#   negumi "I told you not to make this weird, and you made it werid."
    negumi "Eu te disse para não tornar isso estranho, e você tornou estranho."

# game/script5.rpy:7455
translate pt_br_anubisbr scene135_choice03_op2_7a20e55e:

#   negumi "*sigh* Thank you for the massage, but just go and get some wood already."
    negumi "*suspiro* Obrigada pela massagem, mas vai logo arranjar um pouco de lenha."

# game/script5.rpy:7461
translate pt_br_anubisbr scene135_choice03_op3_31cf9492:

#   mc "There. Do you feel better now?"
    mc "Pronto. Você se sente melhor agora?"

# game/script5.rpy:7463
translate pt_br_anubisbr scene135_choice03_op3_f3eee6da:

#   negumi "Yeessss~ They do feel better. A lot better, actually. The ache is gone."
    negumi "Simmm! Eles estão se sentindo melhor. Muito melhor, na verdade. A dor passou."

# game/script5.rpy:7465
translate pt_br_anubisbr scene135_choice03_op3_73ded4a6:

#   mc "I'm good at these things."
    mc "Sou bom nessas coisas."

# game/script5.rpy:7467
translate pt_br_anubisbr scene135_choice03_op3_ed0f0cb9:

#   negumi "...Thank you, [mc]. For the massage, and for not making it weird."
    negumi "...Obrigado, [mc] Pela massagem e por não tornar a situação estranha."

# game/script5.rpy:7469
translate pt_br_anubisbr scene135_choice03_op3_c641924c:

#   mc "Of course. Now let me go gather some wood."
    mc "Claro. Agora vou buscar um pouco de lenha."

# game/script5.rpy:7475
translate pt_br_anubisbr scene135_choice02_op2_39de506d:

#   mc "On it."
    mc "Nisso."

# game/script5.rpy:7494
translate pt_br_anubisbr scene135_wood1_42f6b96e:

#   mc "(That should be enough wood for tonight.)"
    mc "(Essa quantidade de lenha deve ser suficiente para esta noite.)"

# game/script5.rpy:7521
translate pt_br_anubisbr scene135_wood2_42f6b96e:

#   mc "(That should be enough wood for tonight.)"
    mc "(Essa quantidade de lenha deve ser suficiente para esta noite.)"

# game/script5.rpy:7548
translate pt_br_anubisbr scene135_wood3_42f6b96e:

#   mc "(That should be enough wood for tonight.)"
    mc "(Essa quantidade de lenha deve ser suficiente para esta noite.)"

# game/script5.rpy:7570
translate pt_br_anubisbr scene135_3_088c8d43:

#   negumi "Ahhh~ So warm."
    negumi "Ahhh~ Que quentinho."

# game/script5.rpy:7573
translate pt_br_anubisbr scene135_3_90ba6b87:

#   mc "Go ahead and sleep, I'll keep watch."
    mc "Pode dormir, eu fico de vigia."

# game/script5.rpy:7575
translate pt_br_anubisbr scene135_3_14e9a95c:

#   negumi "Sleep? What's that? I'm a night hawk, [mc]. My eyes pierce the darkness. My senses remain alert while lesser mortals slumber."
    negumi "Dormir? O que é isso? Sou uma pessoa noturna. [mc] Meus olhos penetram a escuridão. Meus sentidos permanecem alertas enquanto os mortais comuns dormem."

# game/script5.rpy:7577
translate pt_br_anubisbr scene135_3_e20fa82a:

#   mc "I think you mean 'night owl'."
    mc "Acho que você quis dizer \"notívago\"."

# game/script5.rpy:7579
translate pt_br_anubisbr scene135_3_65e5f243:

#   negumi "Whatever it is. Hawk. Owl. Some creature that doesn't sleep at night."
    negumi "Seja lá o que for. Gavião. Coruja. Alguma criatura que não dorme à noite."

# game/script5.rpy:7580
translate pt_br_anubisbr scene135_3_1667057f:

#   negumi "The point is, I'll stay awake with you. You won't have to face the darkness alone. That's what comrades do."
    negumi "A questão é que ficarei acordado com você. Você não terá que enfrentar a escuridão sozinho. É isso que os camaradas fazem."

# game/script5.rpy:7582
translate pt_br_anubisbr scene135_3_c11c3341:

#   mc "Comrades, huh? Is that what we are now?"
    mc "Camaradas, é isso? É isso que somos agora?"

# game/script5.rpy:7585
translate pt_br_anubisbr scene135_3_c8ec4a6c:

#   negumi "Don't make it weird again. I'm still recovering from you licking my toes. Eugh."
    negumi "Não torne isso estranho de novo. Ainda estou me recuperando de você lambendo meus dedos do pé. Eca."

# game/script5.rpy:7587
translate pt_br_anubisbr scene135_3_9ab14188:

#   negumi "Don't make it weird again. I'm still recovering from you sniffing my sweaty foot. Eww."
    negumi "Não torne isso estranho de novo. Ainda estou me recuperando de você cheirando meu pé suado. Que nojo."

# game/script5.rpy:7589
translate pt_br_anubisbr scene135_3_1dcd5ea7:

#   negumi "Together. The sorceress of doom and the... you, against everything the world can throw at us. They'll sing songs about us for a thousand years!"
    negumi "Juntos. A feiticeira da destruição e... você, contra tudo que o mundo possa nos lançar. Cantarão canções sobre nós por mil anos!"

# game/script5.rpy:7591
translate pt_br_anubisbr scene135_3_8310f40b:

#   mc "They'd better. If we survive this."
    mc "É melhor que sim. Se sobrevivermos a isso."

# game/script5.rpy:7593
translate pt_br_anubisbr scene135_3_8abe5c12:

#   negumi "And a statue!"
    negumi "E uma estátua!"

# game/script5.rpy:7595
translate pt_br_anubisbr scene135_3_d21060b3:

#   mc "*chuckles* Why not."
    mc "*risos* Por que não?"

# game/script5.rpy:7597
translate pt_br_anubisbr scene135_3_0c926ff6:

#   negumi "Can I ask you something?"
    negumi "Posso te perguntar uma coisa?"

# game/script5.rpy:7599
translate pt_br_anubisbr scene135_3_606e2d02:

#   mc "Sure."
    mc "Claro."

# game/script5.rpy:7601
translate pt_br_anubisbr scene135_3_f0f2e137:

#   negumi "Why are you doing this? You can just walk away and pretend you fought them."
    negumi "Por que você está fazendo isso? Você poderia simplesmente ir embora e fingir que lutou com eles."

# game/script5.rpy:7603
translate pt_br_anubisbr scene135_3_34a670aa:

#   negumi "I'm the reason we're out here, waiting to fight monsters that have killed armies. You don't seem to hate me for putting you in this situation."
    negumi "Eu sou o motivo de estarmos aqui, esperando para lutar contra monstros que dizimaram exércitos. Você não parece me odiar por tê-lo colocado nessa situação."

# game/script5.rpy:7605
translate pt_br_anubisbr scene135_3_fe3114a0:

#   negumi "I'm the reason we're out here, waiting to fight monsters that have killed armies. I know you hate me for it, so why stay?"
    negumi "Eu sou o motivo de estarmos aqui, esperando para lutar contra monstros que dizimaram exércitos. Eu sei que você me odeia por isso, então por que ficar?"

# game/script5.rpy:7607
translate pt_br_anubisbr scene135_3_7aca8b39:

#   mc "Because I kinda understand why you did it. I saw it in the throne room—the fire in your eyes."
    mc "Porque eu meio que entendo por que você fez isso. Eu vi na sala do trono — o fogo nos seus olhos."

# game/script5.rpy:7608
translate pt_br_anubisbr scene135_3_4bd3742e:

#   mc "This wasn't just about glory. This was about something deeper."
    mc "Não se tratava apenas de glória. Era algo mais profundo."

# game/script5.rpy:7610
translate pt_br_anubisbr scene135_3_844fcac8:

#   negumi "...Yeah. A promise."
    negumi "...Sim. Uma promessa."

# game/script5.rpy:7611
translate pt_br_anubisbr scene135_3_300d942b:

#   negumi "To make them remember my name, even after I'm gone. Because if I don't... then what was the point of it all?"
    negumi "Para que se lembrem do meu nome, mesmo depois que eu partir. Porque se eu não me lembrar... então qual foi o sentido de tudo isso?"

# game/script5.rpy:7612
translate pt_br_anubisbr scene135_3_85dcfc43:

#   negumi "What was the point of every humiliation, of every time I had to hide who I really am?"
    negumi "Qual era o sentido de cada humilhação, de cada vez que eu tinha que esconder quem eu realmente era?"

# game/script5.rpy:7614
translate pt_br_anubisbr scene135_3_2d5b1cbc:

#   mc "Hide who you really are? What do you mean?"
    mc "Esconder quem você realmente é? O que você quer dizer com isso?"

# game/script5.rpy:7616
translate pt_br_anubisbr scene135_3_de1161c2:

#   negumi "I'm not human, [mc]. Not entirely."
    negumi "Eu não sou humano, [mc] Não totalmente."

# game/script5.rpy:7618
translate pt_br_anubisbr scene135_3_11455b53:

#   mc "What?"
    mc "O que?"

# game/script5.rpy:7620
translate pt_br_anubisbr scene135_3_21831c43:

#   negumi "I'm a faerie. A half-elf. I was told that my mother was an elf, a high elf, from one of those ancient bloodlines that could live for millenniums. My father was human."
    negumi "Sou uma fada. Meio-elfa. Disseram-me que minha mãe era uma elfa, uma alta elfa, de uma daquelas antigas linhagens que podiam viver por milênios. Meu pai era humano."

# game/script5.rpy:7621
translate pt_br_anubisbr scene135_3_3def3e9e:

#   negumi "I've spent my whole life hiding what I am, because if the wrong people found out... it won't be good for me."
    negumi "Passei a vida inteira escondendo quem eu sou, porque se as pessoas erradas descobrissem... não seria bom para mim."

# game/script5.rpy:7623
translate pt_br_anubisbr scene135_3_a5f5bbeb:

#   mc "Oh... I didn't notice. I mean, I was a bit suspicous of how strong your magic is compared to a regular human, but that's about it."
    mc "Ah... eu não tinha reparado. Quer dizer, eu estava um pouco desconfiado da força da sua magia em comparação com a de um humano comum, mas só isso."

# game/script5.rpy:7625
translate pt_br_anubisbr scene135_3_ea8a6854:

#   negumi "It's on purpose. I've had decades of practice. I have to wear my hair down to hide my ears."
    negumi "É proposital. Tenho décadas de prática. Preciso usar o cabelo solto para esconder as orelhas."

# game/script5.rpy:7626
translate pt_br_anubisbr scene135_3_2d009cb5:

#   negumi "And the mana... well, any mage worth shit can feel it, which is why I always keep it dampened."
    negumi "E a mana... bem, qualquer mago que se preze consegue senti-la, por isso sempre a mantenho amortecida."

# game/script5.rpy:7627
translate pt_br_anubisbr scene135_3_928e3f77:

#   negumi "That's why I need the staff—it helps me focus without letting the full force of my nature leak out."
    negumi "É por isso que preciso da equipe — ela me ajuda a me concentrar sem deixar que toda a minha força interior transpareça."

# game/script5.rpy:7629
translate pt_br_anubisbr scene135_3_a758d49f:

#   mc "But why hide it? I've never heard of anyone being executed for having pointy ears."
    mc "Mas por que esconder isso? Nunca ouvi falar de alguém que tenha sido executado por ter orelhas pontudas."

# game/script5.rpy:7630
translate pt_br_anubisbr scene135_3_dcb23cee:

#   mc "All the elves I've met so far seem to have it fine. Well, most of them."
    mc "Todos os elfos que conheci até agora parecem estar bem. Bem, a maioria deles."

# game/script5.rpy:7632
translate pt_br_anubisbr scene135_3_431dd368:

#   negumi "It's not execution. It's... rejection. Isolation. We fairies sit in a weird spot."
    negumi "Não é execução. É... rejeição. Isolamento. Nós, fadas, estamos numa situação estranha."

# game/script5.rpy:7633
translate pt_br_anubisbr scene135_3_8a71c264:

#   negumi "We aren't accepted in human communities, because we're too 'other'. And the elves... the elves despise us. We're a stain on their 'pure bloodlines'."
    negumi "Não somos aceitos nas comunidades humanas porque somos \"diferentes\" demais. E os elfos... os elfos nos desprezam. Somos uma mancha em sua \"linhagem pura\"."

# game/script5.rpy:7634
translate pt_br_anubisbr scene135_3_f1488748:

#   negumi "It's better to just hide the fact and continue living normally."
    negumi "É melhor simplesmente esconder o fato e continuar vivendo normalmente."

# game/script5.rpy:7636
translate pt_br_anubisbr scene135_3_d394e2a9:

#   mc "People hate half-elves that much?"
    mc "As pessoas odeiam tanto assim os meio-elfos?"

# game/script5.rpy:7638
translate pt_br_anubisbr scene135_3_f8e6d1eb:

#   negumi "No. They hate elves. Humans fear them, see them as arrogant immortals who look down on everyone else. And elves? Elves hate everyone that isn't an elf."
    negumi "Não. Eles odeiam elfos. Os humanos os temem, os veem como imortais arrogantes que desprezam todos os outros. E os elfos? Os elfos odeiam todos que não são elfos."

# game/script5.rpy:7639
translate pt_br_anubisbr scene135_3_308a0f0f:

#   negumi "Even among elves, there's hatred. There are hierarchies. Pure bloodlines versus lesser ones. Elves who live for hundreds of years versus those who live for thousands."
    negumi "Até mesmo entre os elfos, existe ódio. Existem hierarquias. Linhagens puras versus linhagens inferiores. Elfos que vivem centenas de anos versus aqueles que vivem milhares."

# game/script5.rpy:7641
translate pt_br_anubisbr scene135_3_45b4cce0:

#   negumi "*laughs* You can see how I don't fit in either group."
    negumi "*risos* Dá para ver que eu não me encaixo em nenhum dos dois grupos."

# game/script5.rpy:7643
translate pt_br_anubisbr scene135_3_4168d422:

#   mc "Damn. That's... that's a heavy burden to carry."
    mc "Droga. Isso é... isso é um fardo muito pesado para carregar."

# game/script5.rpy:7645
translate pt_br_anubisbr scene135_3_56971d15:

#   negumi "Heh. You get used to anything."
    negumi "Heh. A gente se acostuma com tudo."

# game/script5.rpy:7647
translate pt_br_anubisbr scene135_3_69193dfa:

#   negumi "But that's why I need this mission to succeed. Not just for the alliance. For {i}me{/i}."
    negumi "Mas é por isso que preciso que esta missão seja bem-sucedida. Não apenas pela aliança. Por {i} meu{/i}."

# game/script5.rpy:7648
translate pt_br_anubisbr scene135_3_9c398902:

#   negumi "For the half-elf girl who was told she'd never amount to anything, who had to hide her own ears, eyes, and soul just to survive."
    negumi "Para a garota meio-elfa a quem disseram que ela nunca seria ninguém na vida, que teve que esconder as próprias orelhas, olhos e alma apenas para sobreviver."

# game/script5.rpy:7650
translate pt_br_anubisbr scene135_3_d1be4fec:

#   empathy "She stares at you with a fierce, desperate intensity that burns hotter than the fire between you."
    empathy "Ela te encara com uma intensidade feroz e desesperada que queima mais forte que o fogo entre vocês."

# game/script5.rpy:7652
translate pt_br_anubisbr scene135_3_b5b6a1fa:

#   negumi "I need to prove that I'm more than a mistake. More than the sum of two races that didn't want me."
    negumi "Preciso provar que sou mais do que um erro. Mais do que a soma de duas raças que me rejeitaram."

# game/script5.rpy:7654
translate pt_br_anubisbr scene135_3_2b35b6fe:

#   mc "..."
    mc "..."

# game/script5.rpy:7657
translate pt_br_anubisbr scene135_3_60da3a63:

#   negumi "Oh! And by the way, I have the silver you gave me before. Just remind me to give to you once we're done."
    negumi "Ah! E a propósito, ainda tenho a prata que você me deu antes. Só me lembre de te entregar quando terminarmos."

# game/script5.rpy:7659
translate pt_br_anubisbr scene135_3_27cd5e74:

#   mc "The silver?"
    mc "A prata?"

# game/script5.rpy:7661
translate pt_br_anubisbr scene135_3_5cf5636f:

#   negumi "You gave me a silver coin back when I was on the brink of sleeping on the street."
    negumi "Você me deu uma moeda de prata quando eu estava prestes a dormir na rua."

# game/script5.rpy:7662
translate pt_br_anubisbr scene135_3_1e37ccdf:

#   negumi "That silver bought me three days of food and a night in a real bed. Thank you."
    negumi "Essa prata me garantiu três dias de comida e uma noite em uma cama de verdade. Obrigada."

# game/script5.rpy:7664
translate pt_br_anubisbr scene135_3_bc7ca4db:

#   mc "*chuckles* Don't mention it."
    mc "*risos* Não precisa agradecer."

# game/script5.rpy:7666
translate pt_br_anubisbr scene135_3_8e1cefe7:

#   mc "You know... something's been on my mind for a while now."
    mc "Sabe... tem algo que me incomoda há algum tempo."

# game/script5.rpy:7668
translate pt_br_anubisbr scene135_3_7bb313f7:

#   negumi "What is it?"
    negumi "O que é?"

# game/script5.rpy:7670
translate pt_br_anubisbr scene135_3_5e7b0375:

#   mc "I'm just confused. When we reunited in the market, you dismissed innocent people getting hurt."
    mc "Estou simplesmente confuso. Quando nos reencontramos no mercado, você ignorou o fato de pessoas inocentes terem se machucado."

# game/script5.rpy:7671
translate pt_br_anubisbr scene135_3_b2924353:

#   mc "You were about to rob the adventuteres' guild, and the only reason you didn't is because you sensed something scary inside."
    mc "Você estava prestes a assaltar a guilda dos aventureiros, e a única razão pela qual não o fez foi porque sentiu algo assustador lá dentro."

# game/script5.rpy:7673
translate pt_br_anubisbr scene135_3_787f47f1:

#   negumi "I'm a mage, [mc]. A mercenary. A survivor. I do what needs to be done to get what I want."
    negumi "Eu sou um mago, [mc] Um mercenário. Um sobrevivente. Faço o que for preciso para conseguir o que quero."

# game/script5.rpy:7674
translate pt_br_anubisbr scene135_3_eb1084da:

#   negumi "I'm not a hero or a villain. I'm just... me."
    negumi "Eu não sou um herói nem um vilão. Eu sou apenas... eu."

# game/script5.rpy:7676
translate pt_br_anubisbr scene135_3_acac9866:

#   mc "So why did you help me out back then? You warned me about Maia. You told me what was happening, even came along with me."
    mc "Então, por que você me ajudou naquela época? Você me avisou sobre Maia. Você me contou o que estava acontecendo, e até veio comigo."

# game/script5.rpy:7677
translate pt_br_anubisbr scene135_3_d415bdc3:

#   mc "You had no incentive to do that. No coin or reward waiting for you. You could have gone on with your life, and I would have just stayed there in the castle, oblivious to what truly happened."
    mc "Você não tinha nenhum incentivo para fazer isso. Nenhuma moeda ou recompensa esperando por você. Você poderia ter seguido com a sua vida, e eu teria simplesmente permanecido lá no castelo, alheio ao que realmente aconteceu."

# game/script5.rpy:7679
translate pt_br_anubisbr scene135_3_51c37d2d:

#   negumi "You're right. I barely knew you. You were just a man who worked at the castle. Nothing that should have mattered to me."
    negumi "Você tem razão. Eu mal o conhecia. Você era apenas um homem que trabalhava no castelo. Nada que devesse me importar."

# game/script5.rpy:7680
translate pt_br_anubisbr scene135_3_6b7f29f1:

#   negumi "But... I just felt a strange pull to you. Something I still can't explain. I just... felt like I had to. Like something was guiding me toward you."
    negumi "Mas... eu senti uma estranha atração por você. Algo que ainda não consigo explicar. Eu só... senti que precisava. Como se algo estivesse me guiando em sua direção."

# game/script5.rpy:7682
translate pt_br_anubisbr scene135_3_1f65d415:

#   mc "What does that even mean?"
    mc "O que isso significa, afinal?"

# game/script5.rpy:7684
translate pt_br_anubisbr scene135_3_6c259057:

#   negumi "No clue. Only that I did. I was compelled to do so, and so I did. It wasn't out of the goodness of my heart, if that's what you're wondering."
    negumi "Não faço ideia. Só sei que fiz. Senti-me compelido a fazê-lo, e assim o fiz. Não foi por pura bondade, se é isso que você está pensando."

# game/script5.rpy:7686
translate pt_br_anubisbr scene135_3_8fea2db2:

#   mc "Hmm..."
    mc "Hum..."

# game/script5.rpy:7688
translate pt_br_anubisbr scene135_3_c8193fb3:

#   negumi "I've thought about it a lot. I've wondered if I made a mistake. If I should have never told you."
    negumi "Pensei muito sobre isso. Fiquei pensando se cometi um erro. Se eu nunca deveria ter te contado."

# game/script5.rpy:7690
translate pt_br_anubisbr scene135_3_3f4d55bf:

#   negumi "*chuckles* Maybe things would have turned out better for me if I never met you."
    negumi "*risos* Talvez as coisas tivessem sido melhores para mim se eu nunca tivesse te conhecido."

# game/script5.rpy:7692
translate pt_br_anubisbr scene135_3_950dd4dd:

#   mc "...Why don't we share campfire stories to pass the time? I'd like to know more about you."
    mc "...Que tal compartilharmos histórias ao redor da fogueira para passar o tempo? Gostaria de saber mais sobre você."

# game/script5.rpy:7696
translate pt_br_anubisbr scene135_3_dcf39490:

#   negumi "Oh! That sounds fun! We'll stay up all night!"
    negumi "Oh! Isso parece divertido! Vamos ficar acordados a noite toda!"

# game/script5.rpy:7700
translate pt_br_anubisbr scene135_3_0edfe856:

#   negumi "Sorry, [mc]. But I need to sleep. I told you, a tired mage is a dead mage."
    negumi "Desculpe, [mc] Mas eu preciso dormir. Eu já te disse, um mago cansado é um mago morto."

# game/script5.rpy:7702
translate pt_br_anubisbr scene135_3_fd88a0aa:

#   mc "Alright, I get it."
    mc "Certo, entendi."

# game/script5.rpy:7706
translate pt_br_anubisbr scene135_3_72ff930c:

#   perception "She snores loudly. Drool drips from the corner of her mouth, trailing down onto the sand."
    perception "Ela ronca alto. Baba escorre do canto da boca, caindo na areia."

# game/script5.rpy:7708
translate pt_br_anubisbr scene135_3_56da02ee:

#   mc "Eugh. 'Night hawk' my ass..."
    mc "Eca. \"Falcão noturno\", uma ova..."

# game/script5.rpy:7711
translate pt_br_anubisbr scene135_3_6102c975:

#   mc "*sigh* (Minthra... I might really need your help tomorrow. More than I've ever needed you before.)"
    mc "*suspiro* (Minthra... talvez eu realmente precise da sua ajuda amanhã. Mais do que jamais precisei antes.)"

# game/script5.rpy:7712
translate pt_br_anubisbr scene135_3_f48dda2d:

#   sensation "The fire warms your skin from the right. The cold desert wind blows from your left. Despite what lies ahead, you feel serene."
    sensation "O fogo aquece sua pele pela direita. O vento frio do deserto sopra pela esquerda. Apesar do que está por vir, você se sente sereno."

# game/script5.rpy:7714
translate pt_br_anubisbr scene135_3_fc9c25b3:

#   mc "*yawn* (Nothing's out here. No one will blame me if I take a little nap.)"
    mc "*bocejo* (Não tem nada aqui fora. Ninguém vai me culpar se eu tirar um cochilo.)"

# game/script5.rpy:7715
translate pt_br_anubisbr scene135_3_d21f14ef:

#   mc "(Yeah... Just a few minutes. Then I'll be ready. Then I'll...)"
    mc "(Sim... Só alguns minutos. Aí estarei pronto. Aí eu...)"

# game/script5.rpy:7720
translate pt_br_anubisbr scene135_3_cb077951:

#   negumi "[mc]!"
    negumi "[mc]!"

# game/script5.rpy:7721
translate pt_br_anubisbr scene135_3_311b425e:

#   mc "Unnn..."
    mc "Hum..."

# game/script5.rpy:7723
translate pt_br_anubisbr scene135_3_6d77ba38:

#   negumi "Wake up! Please wake up! [mc], you have to wake up RIGHT NOW!"
    negumi "Acorde! Por favor, acorde! [mc] Você precisa acordar AGORA MESMO!"

# game/script5.rpy:7725
translate pt_br_anubisbr scene135_3_aec79c94:

#   mc "Negumi? Fuck... I overslept. By a lot."
    mc "Negumi? Droga... dormi demais. Muito demais."

# game/script5.rpy:7727
translate pt_br_anubisbr scene135_3_d2374d6b:

#   negumi "Shut up! Don't move a single muscle! Don't make any sudden movements!"
    negumi "Cale-se! Não se mexa! Não faça nenhum movimento brusco!"

# game/script5.rpy:7729
translate pt_br_anubisbr scene135_3_d0442d5d:

#   mc "What's wrong with you?"
    mc "O que você tem?"

# game/script5.rpy:7731
translate pt_br_anubisbr scene135_3_a05ce7b1:

#   negumi "..."
    negumi "..."

# game/script5.rpy:7732
translate pt_br_anubisbr scene135_3_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/script5.rpy:7737
translate pt_br_anubisbr scene135_3_975a073b:

#   negumi "H-He's looking right at us."
    negumi "Ele está olhando diretamente para nós."

# game/script5.rpy:7738
translate pt_br_anubisbr scene135_3_ab44726b:

#   mc "No, that's impossible! They should still be much further ahead! Flint said the pass was another day's ride from here!"
    mc "Não, isso é impossível! Eles ainda devem estar muito mais à frente! Flint disse que a passagem ficava a mais um dia de viagem daqui!"

# game/script5.rpy:7739
translate pt_br_anubisbr scene135_3_7e0f2d41:

#   mc "M-Maybe they're looking at something else? We're tiny compared to them."
    mc "Talvez estejam olhando para outra coisa? Somos minúsculos em comparação a eles."

# game/script5.rpy:7741
translate pt_br_anubisbr scene135_3_8b20f119:

#   negumi "L-L-Let's run, [mc]! Please, let's just run!"
    negumi "LL-Vamos correr, [mc] Por favor, vamos correr!"

# game/script5.rpy:7742
translate pt_br_anubisbr scene135_3_a0e8c479:

#   negumi "I'm sorry! I'm so sorry for putting you into this!"
    negumi "Me desculpe! Me desculpe mesmo por ter te colocado nessa situação!"

# game/script5.rpy:7744
translate pt_br_anubisbr scene135_3_3c7c1dcd:

#   negumi "I just wanted to be someone who mattered, I just wanted to do something big and important and not be forgotten—I didn't want to die!"
    negumi "Eu só queria ser alguém importante, só queria fazer algo grandioso e significativo e não ser esquecido — eu não queria morrer!"

# game/script5.rpy:7745
translate pt_br_anubisbr scene135_3_7f1ce8a7:

#   negumi "I don't want to die! I want to go home now!"
    negumi "Eu não quero morrer! Quero ir para casa agora!"

# game/script5.rpy:7747
translate pt_br_anubisbr scene135_3_984a3670:

#   mc "Calm down! I told you—he's just looking at something else."
    mc "Calma! Eu já disse — ele só está olhando para outra coisa."

# game/script5.rpy:7748
translate pt_br_anubisbr scene135_3_fdd9d1c2:

#   mc "No way he sees us... We're two tiny specks in a massive desert."
    mc "De jeito nenhum ele nos vê... Somos dois pontinhos minúsculos num deserto imenso."

# game/script5.rpy:7750
translate pt_br_anubisbr scene135_3_e6e9db5a:

#   negumi "We're sitting in the only oaises for miles, of course he sees us! But... maybe they aren't in the mood to fight."
    negumi "Estamos sentados nos únicos oásis em quilômetros, é claro que ele nos vê! Mas... talvez eles não estejam com vontade de brigar."

# game/script5.rpy:7751
translate pt_br_anubisbr scene135_3_6afe702c:

#   negumi "Can we please back up slowly?!"
    negumi "Podemos, por favor, recuar devagar?!"

# game/script5.rpy:7753
translate pt_br_anubisbr scene135_3_516d8e65:

#   mc "Alright! Alright! Move slowly... towards [horse]—"
    mc "Muito bem! Muito bem! Mova-se devagar... em direção a [horse] —"

# game/script5.rpy:7756
translate pt_br_anubisbr scene135_3_b91cdc17:

#   perception "The giant suddenly dashes in your direction. One moment it's on the horizon. The next, it's crossed half the distance. The ground shakes with every footstep."
    perception "O gigante surge de repente em sua direção. Num instante está no horizonte. No seguinte, já percorreu metade do caminho. O chão treme a cada passo."

# game/script5.rpy:7758
translate pt_br_anubisbr scene135_3_75bef293:

#   mc "GUHHHHH!"
    mc "GUHHHHH!"

# game/script5.rpy:7759
translate pt_br_anubisbr scene135_3_556b0c9d:

#   negumi "[mc]! No!"
    negumi "[mc]! Não!"

# game/script5.rpy:7761
translate pt_br_anubisbr scene135_3_66ddd92a:

#   mc "NGHNNNN! Negumi!"
    mc "NGHNNNN! Negumi!"

# game/script5.rpy:7762
translate pt_br_anubisbr scene135_3_8683262f:

#   sensation "The giant's grip intensifies. You feel like you're going to puke. Your eyes bulge. Black spots dance at the edges of your vision."
    sensation "O aperto do gigante se intensifica. Você sente que vai vomitar. Seus olhos saltam das órbitas. Pontos pretos dançam nas bordas da sua visão."

# game/script5.rpy:7764
translate pt_br_anubisbr scene135_3_d98fcdf7:

#   mc "Huh?! What are you—Stop! What are you doing?!"
    mc "Hein?! O que você está—Pare! O que você está fazendo?!"

# game/script5.rpy:7767
translate pt_br_anubisbr scene135_3_ac3ea996:

#   mc "AAAAGHHHHHHH!"
    mc "AAAAGHHHHHHH!"

# game/script5.rpy:7768
translate pt_br_anubisbr scene135_3_63576020:

#   mc "I'm... I'm gonna die!"
    mc "Eu... eu vou morrer!"

# game/script5.rpy:7771
translate pt_br_anubisbr scene135_3_34c50615:

#   negumi "Goddess of fire, I beseech thee! Bring flame!"
    negumi "Deusa do fogo, eu te imploro! Traga a chama!"

# game/script5.rpy:7773
translate pt_br_anubisbr scene135_3_8abc0a00:

#   sensation "Flame engulfs the air around you. The heat is unimaginable—your internal water begins bubbling. Your skin sizzles. You feel your very flesh igniting."
    sensation "As chamas envolvem o ar ao seu redor. O calor é inimaginável — a água em seu interior começa a borbulhar. Sua pele crepita. Você sente sua própria carne se incendiando."

# game/script5.rpy:7774
translate pt_br_anubisbr scene135_3_21756111:

#   mc "What are you doing, Negumi?! You'll burn me too! I'm still in his mouth! I'm still—"
    mc "O que você está fazendo, Negumi?! Você vai me queimar também! Eu ainda estou na boca dele! Eu ainda estou—"

# game/script5.rpy:7775
translate pt_br_anubisbr scene135_3_8c7f6926:

#   negumi "I'm sorry! I have no other choice! It's this or watch you die! Please survive! PLEASE!"
    negumi "Me desculpe! Não tenho outra escolha! É isso ou te ver morrer! Por favor, sobreviva! POR FAVOR!"

# game/script5.rpy:7778
translate pt_br_anubisbr scene135_3_3471dcba:

#   mc "NGHAAAAA!"
    mc "NGHAAAAA!"

# game/script5.rpy:7779
translate pt_br_anubisbr scene135_3_d9775f3f:

#   giant "AGHHHH!"
    giant "AHHHH!"

# game/script5.rpy:7781
translate pt_br_anubisbr scene135_3_433bdb53:

#   negumi "It worked! The giant is retreating!"
    negumi "Funcionou! O gigante está recuando!"

# game/script5.rpy:7783
translate pt_br_anubisbr scene135_3_b6c3eebb:

#   negumi "Are you alright?!"
    negumi "Você está bem?!"

# game/script5.rpy:7786
translate pt_br_anubisbr scene135_3_1a79c45d:

#   mc "W... Watch out!"
    mc "Cuidado!"

# game/script5.rpy:7787
translate pt_br_anubisbr scene135_3_38ea098a:

#   negumi "Don't worry, I'll have my shield u—"
    negumi "Não se preocupe, eu terei meu escudo..."

# game/script5.rpy:7790
translate pt_br_anubisbr scene135_3_e6234e5b:

#   mc "No! No, no, no..."
    mc "Não! Não, não, não..."

# game/script5.rpy:7791
translate pt_br_anubisbr scene135_3_ea6c8f89:

#   mc "Negumi... Fuck!"
    mc "Negumi... Porra!"

# game/script5.rpy:7793
translate pt_br_anubisbr scene135_3_d9cc8c75:

#   mc "I'll kill you... I'll fucking kill you! You hear me?! I'll tear you apart! I'll burn what's left! I'll—"
    mc "Eu vou te matar... Eu vou te matar, seu filho da puta! Tá me ouvindo?! Eu vou te despedaçar! Vou queimar o que sobrar! Eu vou—"

# game/script5.rpy:7796
translate pt_br_anubisbr scene135_3_0ae9bcd0:

#   ""
    ""

# game/script5.rpy:7806
translate pt_br_anubisbr scene135_3_38e06aac:

#   minthra "This is most vexing..."
    minthra "Isso é extremamente irritante..."

# game/script5.rpy:7807
translate pt_br_anubisbr scene135_3_90213cb2:

#   minthra "Wake up. You are not permitted to die yet."
    minthra "Acorde. Você ainda não tem permissão para morrer."

# game/script5.rpy:7809
translate pt_br_anubisbr scene135_3_9a3ad537:

#   mc "*gasp* HAHH!"
    mc "*suspiro* HAHH!"

# game/script5.rpy:7810
translate pt_br_anubisbr scene135_3_c8af08fd:

#   mc "I don't feel anything... Why don't I feel anything?"
    mc "Não sinto nada... Por que não sinto nada?"

# game/script5.rpy:7812
translate pt_br_anubisbr scene135_3_7574df01:

#   minthra "Because every bone in your body is shattered. If you felt the full extent of your injuries, you would die immediately. I am protecting you from the truth."
    minthra "Porque todos os ossos do seu corpo estão estilhaçados. Se você sentisse a extensão total dos seus ferimentos, morreria imediatamente. Estou te protegendo da verdade."

# game/script5.rpy:7814
translate pt_br_anubisbr scene135_3_a6d5c316:

#   mc "I can't do it, Minthra... *cough* Not even with your power. Their strength is something else entirely."
    mc "Eu não consigo, Minthra... *tosse* Nem mesmo com o seu poder. A força deles é algo completamente diferente."

# game/script5.rpy:7815
translate pt_br_anubisbr scene135_3_8c10c1e9:

#   mc "It's hopeless."
    mc "É inútil."

# game/script5.rpy:7817
translate pt_br_anubisbr scene135_3_5fea16ef:

#   minthra "Who says this is the extent of my power?"
    minthra "Quem disse que esse é o limite do meu poder?"

# game/script5.rpy:7819
translate pt_br_anubisbr scene135_3_03ad3cca:

#   mc "You're saying... it isn't?"
    mc "Você está dizendo... que não é?"

# game/script5.rpy:7821
translate pt_br_anubisbr scene135_3_a9574751:

#   minthra "Yes. Did you think I would lend you all my power at once? Did you think I would trust a mortal vessel with the full extent of what I am?"
    minthra "Sim. Você achou que eu lhe emprestaria todo o meu poder de uma vez? Achou que eu confiaria a um receptáculo mortal toda a extensão do que sou?"

# game/script5.rpy:7823
translate pt_br_anubisbr scene135_3_d322ffa4:

#   mc "What the hell?! You... I could have done so much if you did! I could have stopped so many things before they got worse!"
    mc "Que droga?! Você... Eu poderia ter feito tanta coisa se você tivesse feito! Eu poderia ter impedido que tantas coisas piorassem!"

# game/script5.rpy:7825
translate pt_br_anubisbr scene135_3_84165969:

#   minthra "It would break your mind if I gave you everything. The mortal psyche is fragile. It was not designed to contain what I am."
    minthra "Você ficaria perturbado se eu lhe contasse tudo. A psique mortal é frágil. Ela não foi feita para conter o que eu sou."

# game/script5.rpy:7827
translate pt_br_anubisbr scene135_3_9979bdc4:

#   minthra "Besides. That was not the only reason I didn't lend you my full strength."
    minthra "Além disso, essa não foi a única razão pela qual não lhe dediquei toda a minha força."

# game/script5.rpy:7829
translate pt_br_anubisbr scene135_3_1d0abf41:

#   mc "What? What are you talking about?"
    mc "O quê? Do que você está falando?"

# game/script5.rpy:7831
translate pt_br_anubisbr scene135_3_d791372f:

#   minthra "It's because of her."
    minthra "É por causa dela."

# game/script5.rpy:7833
translate pt_br_anubisbr scene135_3_71291ff7:

#   mc "Her? *cough* Negumi?"
    mc "Ela? *tosse* Negumi?"

# game/script5.rpy:7835
translate pt_br_anubisbr scene135_3_4b91b308:

#   minthra "You will see."
    minthra "Você verá."

# game/script5.rpy:7837
translate pt_br_anubisbr scene135_3_cc745819:

#   mc "Please... just do it. Whatever you've been holding back. I need to help Negumi, she got hit really bad. She might be... she might be dead."
    mc "Por favor... faça isso. Seja lá o que você esteja guardando. Eu preciso ajudar a Negumi, ela foi atingida com muita gravidade. Ela pode estar... ela pode estar morta."

# game/script5.rpy:7839
translate pt_br_anubisbr scene135_3_90bf03a5:

#   minthra "You shall have what you ask. But remember this moment, my champion. Remember the cost."
    minthra "Você terá o que pediu. Mas lembre-se deste momento, meu campeão. Lembre-se do preço a pagar."

# game/script5.rpy:7841
translate pt_br_anubisbr scene135_3_d38bb35a:

#   mc "I don't care. Whatever it is. Whatever you want. Just give me the power... otherwise, I might just die here."
    mc "Não me importo. Seja o que for. O que você quiser. Só me dê o poder... senão, posso morrer aqui mesmo."

# game/script5.rpy:7843
translate pt_br_anubisbr scene135_3_bbc9a05f:

#   sensation "You suddenly feel invigorated. The pain doesn't vanish, it's still there, but it's a distant scream at the back of your mind."
    sensation "De repente, você se sente revigorado. A dor não desaparece, continua lá, mas é um grito distante no fundo da sua mente."

# game/script5.rpy:7845
translate pt_br_anubisbr scene135_3_ddc9c258:

#   mc "Ahh!"
    mc "Ahh!"

# game/script5.rpy:7846
translate pt_br_anubisbr scene135_3_54c95664:

#   mc "I feel... I feel so powerful! Like I could take on everything! Like nothing in this world or any other could stop me!"
    mc "Eu me sinto... eu me sinto tão poderosa! Como se eu pudesse enfrentar qualquer coisa! Como se nada neste mundo ou em qualquer outro pudesse me deter!"

# game/script5.rpy:7848
translate pt_br_anubisbr scene135_3_9477e3c7:

#   minthra "Do not be reckless. This full communion is lethal for your mortal body if maintained for too long."
    minthra "Não seja imprudente. Esta comunhão plena é letal para o seu corpo mortal se mantida por muito tempo."

# game/script5.rpy:7849
translate pt_br_anubisbr scene135_3_ce06f25b:

#   minthra "Your bones are still broken, your skin still flakes and peels. Your healing will be short, but it will take time to heal fully."
    minthra "Seus ossos ainda estão quebrados, sua pele ainda descama e se solta. Sua recuperação será rápida, mas levará tempo para cicatrizar completamente."

# game/script5.rpy:7851
translate pt_br_anubisbr scene135_3_3b29ab20:

#   mc "Then I'll be quick."
    mc "Então serei rápido."

# game/script5.rpy:7854
translate pt_br_anubisbr scene135_3_0814b2fb:

#   mc "Huh!? My sword!"
    mc "Hein!? Minha espada!"

# game/script5.rpy:7855
translate pt_br_anubisbr scene135_3_37afbc4a:

#   mc "Negumi? Did she do that? Fuck... that giant launched me so far away. I'll have to be quick."
    mc "Negumi? Foi ela que fez isso? Droga... aquele gigante me lançou tão longe. Preciso ser rápida."

# game/script5.rpy:7857
translate pt_br_anubisbr scene135_3_41daf907:

#   mc "Negumi!"
    mc "Negumi!"

# game/script5.rpy:7859
translate pt_br_anubisbr scene135_3_a566134d:

#   mc "Stay up there. I'll handle this."
    mc "Fique aí em cima. Eu cuido disso."

# game/script5.rpy:7861
translate pt_br_anubisbr scene135_3_6fe3b38c:

#   mc "You've lived too long. You've killed too many. And now... now you're going to die."
    mc "Você viveu tempo demais. Você matou gente demais. E agora... agora você vai morrer."

# game/script5.rpy:7865
translate pt_br_anubisbr scene135_3_9e14bee9:

#   giant "GAHHH!?"
    giant "AAAAAAH!?"

# game/script5.rpy:7867
translate pt_br_anubisbr scene135_3_ab19a651:

#   giant "BLAAGHGH!"
    giant "BLAAGHGH!"

# game/script5.rpy:7870
translate pt_br_anubisbr scene135_3_b662d61e:

#   mc "Die already!"
    mc "Morra logo!"

# game/script5.rpy:7874
translate pt_br_anubisbr scene135_3_edf3fce8:

#   giant "*gag* NGHNNNN!"
    giant "*engasgo* NGHNNNN!"

# game/script5.rpy:7876
translate pt_br_anubisbr scene135_3_902d4d18:

#   mc "One down. One to go."
    mc "Um já foi. Falta um."

# game/script5.rpy:7879
translate pt_br_anubisbr scene135_3_aace51e2:

#   giant "ROAAAHHHHHH!"
    giant "ROAAAHHHHHH!"

# game/script5.rpy:7881
translate pt_br_anubisbr scene135_3_647fdd83:

#   mc "Angry that I killed your borther? Imagine how the families of those soldiers felt then."
    mc "Ficou com raiva por eu ter matado seu irmão? Imagine como se sentiram as famílias daqueles soldados naquela época."

# game/script5.rpy:7883
translate pt_br_anubisbr scene135_3_9f671a2d:

#   mc "Angry that I killed your borther? Don't worry, you'll be joining him soon enough."
    mc "Está com raiva por eu ter matado seu irmão? Não se preocupe, você se juntará a ele em breve."

# game/script5.rpy:7887
translate pt_br_anubisbr scene135_3_a01b7ceb:

#   mc "Too slow."
    mc "Muito lento."

# game/script5.rpy:7890
translate pt_br_anubisbr scene135_3_f6fccb80:

#   giant "NGAAHHHH!"
    giant "NGAAHHHH!"

# game/script5.rpy:7892
translate pt_br_anubisbr scene135_3_6792fc09:

#   mc "Nghnn!"
    mc "Nghnn!"

# game/script5.rpy:7896
translate pt_br_anubisbr scene135_3_08cde703:

#   mc "This is for every soldier you crushed. Every family you destroyed. Every life you ended. This is for everyone who ever stood against you and fell."
    mc "Isto é para cada soldado que você esmagou. Para cada família que você destruiu. Para cada vida que você tirou. Isto é para todos que um dia se levantaram contra você e caíram."

# game/script5.rpy:7900
translate pt_br_anubisbr scene135_3_6d052299:

#   perception "Your blade sinks into his skull. The giant goes rigid. The light in his eyes dim. The massive body beneath you shudders once, then goes still."
    perception "Sua lâmina penetra em seu crânio. O gigante enrijece. A luz em seus olhos se apaga. O corpo maciço sob você estremece uma vez e então permanece imóvel."

# game/script5.rpy:7902
translate pt_br_anubisbr scene135_3_a15ce1e8:

#   mc "...It's done."
    mc "...Está feito."

# game/script5.rpy:7904
translate pt_br_anubisbr scene135_3_326711cc:

#   mc "Negumi! It's over! You can come down now!"
    mc "Negumi! Acabou! Pode descer agora!"

# game/script5.rpy:7908
translate pt_br_anubisbr scene135_3_266ab2e6:

#   perception "The barrier around her dissolves into a shower of sparks. She collapses into your hands, limp and broken, blood spilling from the corners of her mouth."
    perception "A barreira ao seu redor se dissolve em uma chuva de faíscas. Ela desaba em suas mãos, inerte e quebrada, com sangue escorrendo dos cantos da boca."

# game/script5.rpy:7910
translate pt_br_anubisbr scene135_3_bcd1f8da:

#   mc "Negumi? Negumi, look at me. Will you be alright?"
    mc "Negumi? Negumi, olhe para mim. Você vai ficar bem?"

# game/script5.rpy:7911
translate pt_br_anubisbr scene135_3_8945f2af:

#   mc "Can you heal yourself? Can you—"
    mc "Você consegue se curar? Você consegue—"

# game/script5.rpy:7913
translate pt_br_anubisbr scene135_3_9ecc4c17:

#   negumi "*cough* Just... just take me back... please. I don't want to die out here."
    negumi "*tosse* Só... só me levem de volta... por favor. Eu não quero morrer aqui."

# game/script5.rpy:7916
translate pt_br_anubisbr scene135_3_61354349:

#   mc "I got you. Let's get you back. You're going to be fine, you hear me?"
    mc "Eu te protejo. Vamos te trazer de volta. Você vai ficar bem, entendeu?"

# game/script5.rpy:7918
translate pt_br_anubisbr scene135_3_5f25a052:

#   mc "I got you."
    mc "Te peguei."

# game/script5.rpy:7920
translate pt_br_anubisbr scene135_3_e29837e8:

#   mc "[horse]! Come here, girl! We need to move!"
    mc "[horse] Vem cá, menina! Precisamos ir!"

# game/script5.rpy:7922
translate pt_br_anubisbr scene135_3_0691417a:

#   mc "(Fuck, I feel so tired. Like I could sleep for a thousand years.)"
    mc "(Caramba, estou tão cansado. Parece que eu poderia dormir por mil anos.)"

# game/script5.rpy:7923
translate pt_br_anubisbr scene135_3_305d9449:

#   minthra "Do not faint just yet. Something is coming."
    minthra "Não desmaie ainda. Algo está para acontecer."

# game/script5.rpy:7924
translate pt_br_anubisbr scene135_3_522d3a0a:

#   mc "(Huh? The giants are dead. We won. What could be worse than—)"
    mc "(Hã? Os gigantes estão mortos. Nós vencemos. O que poderia ser pior do que—)"

# game/script5.rpy:7928
translate pt_br_anubisbr scene135_3_6354bb77:

#   mc "Negumi?! Where are you?! What's happening?!"
    mc "Negumi?! Onde você está?! O que está acontecendo?!"

# game/script5.rpy:7929
translate pt_br_anubisbr scene135_3_d9f3c8d9:

#   minthra "She is here. The one I warned you about. The one I have been hiding from."
    minthra "Ela está aqui. Aquela sobre quem eu te avisei. Aquela de quem eu tenho me escondido."

# game/script5.rpy:7930
translate pt_br_anubisbr scene135_3_083208f7:

#   mc "Who?! Who is—"
    mc "Quem?! Quem é—"

# game/script5.rpy:7931
translate pt_br_anubisbr scene135_3_8688624b:

#   nueleth "So it is true. A devil has entered our realm."
    nueleth "É verdade. Um demônio entrou em nosso reino."

# game/script5.rpy:7932
translate pt_br_anubisbr scene135_3_2ed962a0:

#   nueleth "A fragment of the old darkness, slumbering in the body of a mortal."
    nueleth "Um fragmento da antiga escuridão, adormecido no corpo de um mortal."

# game/script5.rpy:7933
translate pt_br_anubisbr scene135_3_52264ccf:

#   nueleth "And that devil resides inside you. Twisted around your soul like a parasite."
    nueleth "E esse demônio reside dentro de você. Enroscado em sua alma como um parasita."

# game/script5.rpy:7935
translate pt_br_anubisbr scene135_3_6141ba98:

#   mc "W-Who are you?!"
    mc "Q-Quem é você?!"

# game/script5.rpy:7936
translate pt_br_anubisbr scene135_3_582f37ae:

#   nueleth "I don't care about your politics. Your wars. Your petty struggles. Let it all fade into nothing."
    nueleth "Não me importo com a sua política. Suas guerras. Suas pequenas brigas. Que tudo isso se dissipe no nada."

# game/script5.rpy:7937
translate pt_br_anubisbr scene135_3_bc8a529e:

#   nueleth "I exist to keep the balance. Between order and chaos. Between the mortal realm and the powers that would consume it."
    nueleth "Existo para manter o equilíbrio. Entre a ordem e o caos. Entre o reino mortal e os poderes que o consumiriam."

# game/script5.rpy:7938
translate pt_br_anubisbr scene135_3_b2e131ed:

#   nueleth "And your existence, [mc], contradicts that very balance."
    nueleth "E a sua existência, [mc], contradiz esse próprio equilíbrio."

# game/script5.rpy:7940
translate pt_br_anubisbr scene135_3_81d32acc:

#   mc "Where are you hiding?! Reveal yourself! Let's talk!"
    mc "Onde você está se escondendo?! Revele-se! Vamos conversar!"

# game/script5.rpy:7941
translate pt_br_anubisbr scene135_3_d23d2417:

#   shiver "You still feel the remnants of Minthra's full power coursing through your veins, yet it compares nothing gainst the presence around you."
    shiver "Você ainda sente os resquícios do poder total de Minthra percorrendo suas veias, mas isso não se compara em nada à presença que o cerca."

# game/script5.rpy:7942
translate pt_br_anubisbr scene135_3_93dc76aa:

#   nueleth "However, I won't snuff out your life... yet. Perhaps you are exactly where the balance needs you to be. I have not yet decided."
    nueleth "No entanto, não vou acabar com a sua vida... ainda. Talvez você esteja exatamente onde o equilíbrio precisa que você esteja. Eu ainda não decidi."

# game/script5.rpy:7943
translate pt_br_anubisbr scene135_3_89b33cf2:

#   nueleth "If her presence grows—even for a tiny smidgen, then you will meet my wrath."
    nueleth "Se a presença dela aumentar — mesmo que seja apenas um pouquinho —, então você sentirá a minha ira."

# game/script5.rpy:7944
translate pt_br_anubisbr scene135_3_d52fb665:

#   nueleth "I will erase you from existence so completely that even the memory of you will fade from the minds of those who loved you."
    nueleth "Eu te apagarei da existência de forma tão completa que até mesmo a lembrança de você se desvanecerá da mente daqueles que te amaram."

# game/script5.rpy:7947
translate pt_br_anubisbr scene135_3_9965372f:

#   nueleth "You have been warned, [mc]. The choice is yours. The consequences are mine."
    nueleth "Você foi avisado(a), [mc] A escolha é sua. As consequências são minhas."

# game/script5.rpy:7950
translate pt_br_anubisbr scene135_3_73e38385:

#   minthra "Do you understand now? Why I hid myself for so long? Why I did not lend you more strength?"
    minthra "Você entende agora? Por que me escondi por tanto tempo? Por que não te dei mais forças?"

# game/script5.rpy:7951
translate pt_br_anubisbr scene135_3_523cebee:

#   minthra "That is why. She—Nueleth, this planet's finest being, is why."
    minthra "É por isso. Ela — Nueleth, o ser mais sublime deste planeta — é a razão."

# game/script5.rpy:7952
translate pt_br_anubisbr scene135_3_19ca5132:

#   minthra "She is the reason no devils exist anymore in this world."
    minthra "Ela é a razão pela qual não existem mais demônios neste mundo."

# game/script5.rpy:7954
translate pt_br_anubisbr scene135_3_4e32e2b4:

#   minthra "Her power is immense. Vast beyond your comprehension. Strong enough to fully awaken me."
    minthra "O poder dela é imenso. Vasto, muito além da sua compreensão. Forte o suficiente para me despertar completamente."

# game/script5.rpy:7955
translate pt_br_anubisbr scene135_3_a9327897:

#   minthra "That is your final goal, vessel. Let it be cemented in your brain that you will take her on someday. Once you become strong enough."
    minthra "Esse é o seu objetivo final, embarcação. Grave na sua mente que você a enfrentará um dia. Quando você estiver forte o suficiente."

# game/script5.rpy:7956
translate pt_br_anubisbr scene135_3_5c8637b7:

#   minthra "But we will be more discreet from now on. Do not call on me unless there is no other choice. Do not let her feel my presence again."
    minthra "Mas seremos mais discretos daqui para frente. Não me procure a menos que não haja outra opção. Não deixe que ela sinta minha presença novamente."

# game/script5.rpy:7959
translate pt_br_anubisbr scene135_3_2654d5e2:

#   mc "(What the fuck, man!)"
    mc "(Que porra é essa, cara!)"

# game/script5.rpy:7960
translate pt_br_anubisbr scene135_3_2b071dca:

#   mc "(I'm caught between two Gods that can pull my soul apart like taffy!)"
    mc "(Estou presa entre dois deuses que podem despedaçar minha alma como caramelo!)"

# game/script5.rpy:7961
translate pt_br_anubisbr scene135_3_be69038c:

#   mc "(And I'm supposed to... what? Get strong enough to fight a being that makes Minthra look like a candle in the sun?!)"
    mc "(E eu deveria... o quê? Ficar forte o suficiente para lutar contra um ser que faz Minthra parecer uma vela ao sol?!)"

# game/script5.rpy:7962
translate pt_br_anubisbr scene135_3_44681ab8:

#   mc "(Goddammit, I'm starting to believe my old life wasn't so bad after all...)"
    mc "(Droga, estou começando a acreditar que minha vida antiga não era tão ruim assim...)"

# game/script5.rpy:7964
translate pt_br_anubisbr scene135_3_0f89a06a:

#   negumi "[mc]..."
    negumi "[mc]..."

# game/script5.rpy:7965
translate pt_br_anubisbr scene135_3_c78a4a34:

#   mc "Sorry, Negumi. I got distracted. I'll get us back to the palace, just hold on... a... little longer."
    mc "Desculpe, Negumi. Eu me distraí. Vou nos levar de volta ao palácio, só espere... mais um... pouco."

# game/script5.rpy:7968
translate pt_br_anubisbr scene135_3_b5078130:

#   mc "*weeze* W-What's happening? I'm... I'm losing all my strength!"
    mc "*ofegante* O-O que está acontecendo? Eu... eu estou perdendo todas as minhas forças!"

# game/script5.rpy:7969
translate pt_br_anubisbr scene135_3_10081789:

#   minthra "Your body will not be able to sustain my power any longer. It is returning to normal."
    minthra "Seu corpo não será mais capaz de suportar meu poder. Ele está voltando ao normal."

# game/script5.rpy:7970
translate pt_br_anubisbr scene135_3_c810af74:

#   mc "(S-So what now? Do I... die?) *cough* (I... feel so tired... what happens if I... close my eyes?)"
    mc "(E agora? Eu... morro?) *tosse* (Eu... me sinto tão cansado... o que acontece se eu... fechar os olhos?)"

# game/script5.rpy:7972
translate pt_br_anubisbr scene135_3_3fed26a2:

#   minthra "Sleep. Along with my daughter."
    minthra "Dormir. Junto com a minha filha."

# game/script5.rpy:7983
translate pt_br_anubisbr scene135_3_16c2828b:

#   "The ambush caught you off guard, but Thulkin's proposition had your attention from the first word. You agreed to help him and his sister raid the goblin camp. His laughter still rings through your ears."
    "A emboscada te pegou de surpresa, mas a proposta de Thulkin te cativou desde a primeira palavra. Você concordou em ajudá-lo, junto com sua irmã, a invadir o acampamento dos goblins. O riso dele ainda ecoa em seus ouvidos."

# game/script5.rpy:7985
translate pt_br_anubisbr scene135_3_70241192:

#   "After the sudden ambush, you told Thulkin and his sister to leave. Thulkin's expression hardened, but he honored your refusal."
    "Após a emboscada repentina, você disse a Thulkin e sua irmã para irem embora. A expressão de Thulkin endureceu, mas ele acatou sua recusa."

# game/script5.rpy:7990
translate pt_br_anubisbr scene135_3_e0f2121a:

#   "You fought the goblins alongside Alex. Her blade danced with precision, every strike finding its mark, every movement purposeful."
    "Você lutou contra os goblins ao lado de Alex. Sua lâmina dançava com precisão, cada golpe encontrando o alvo, cada movimento intencional."

# game/script5.rpy:7995
translate pt_br_anubisbr scene135_3_5c85dc71:

#   "You kissed Millicent beneath the moonlight, her pointed ears twitching at the contact. Wildflowers clung to the night air, their fragrance mingling with the memory of her lips."
    "Você beijou Millicent sob o luar, e as orelhas pontudas dela se contraíram com o toque. Flores silvestres pairavam no ar noturno, sua fragrância se misturando à lembrança dos lábios dela."

# game/script5.rpy:7999
translate pt_br_anubisbr scene135_3_724e94e4:

#   "You fought the goblins with Millicent. Fire erupted from her palms, consuming them like dry kindling. But as the embers settled, you couldn't shake the feeling that you'd let something slip away."
    "Você lutou contra os goblins com Millicent. Chamas irromperam de suas palmas, consumindo-os como gravetos secos. Mas, enquanto as brasas se acalmavam, você não conseguia se livrar da sensação de que havia deixado algo escapar."

# game/script5.rpy:8006
translate pt_br_anubisbr scene135_3_c1d50e5f:

#   "You refused Minthra's commands and beheaded the goblin chieftain. Ridding the world of one less evil. You felt the presence inside you stir with displeasure."
    "Você recusou as ordens de Minthra e decapitou o chefe goblin, livrando o mundo de um mal a menos. Você sentiu a presença dentro de si agitar-se com desagrado."

# game/script5.rpy:8008
translate pt_br_anubisbr scene135_3_4f9a366c:

#   "You rejected Minthra's bloodlust and reached the chieftain. The goblin's eyes widened with understanding before he slumped forward, forever changed for good."
    "Você rejeitou a sede de sangue de Minthra e alcançou o chefe. Os olhos do goblin se arregalaram em compreensão antes que ele desabasse para a frente, transformado para sempre."

# game/script5.rpy:8010
translate pt_br_anubisbr scene135_3_7e449489:

#   "Minthra's whispers slithered into the chieftain's ear, poison sweet as honey. He bent to her will, his mind no longer his own. A puppet, now, enslaved to your influence."
    "Os sussurros de Minthra penetraram o ouvido do chefe, veneno doce como mel. Ele se curvou à sua vontade, sua mente já não lhe pertencia. Um fantoche, agora, escravizado à sua influência."

# game/script5.rpy:8015
translate pt_br_anubisbr scene135_3_da0000a3:

#   "You told Serena you'd be there for her—no matter what. Her fingers curled around yours, grip tightening as understanding dawned in her eyes. She knew exactly what that promise meant."
    "Você disse à Serena que estaria lá por ela, acontecesse o que acontecesse. Os dedos dela se fecharam em torno dos seus, o aperto se intensificando à medida que a compreensão surgia em seus olhos. Ela sabia exatamente o que aquela promessa significava."

# game/script5.rpy:8017
translate pt_br_anubisbr scene135_3_798e4b30:

#   "When Serena spoke of wanting someone, you said nothing. The moment passed, fragile, and she let it go without a fight."
    "Quando Serena falou que queria alguém, você não disse nada. O momento passou, frágil, e ela deixou ir sem lutar."

# game/script5.rpy:8024
translate pt_br_anubisbr scene135_3_b3c32f22:

#   "You followed Nadia home, listening as she spilled her struggles. Then, after a moment's hesitation, you closed the door. Literally. You made her stay, and promised to be the one who held her up."
    "Você seguiu Nadia até em casa, ouvindo-a desabafar sobre suas dificuldades. Então, após um momento de hesitação, você fechou a porta. Literalmente. Você a fez ficar e prometeu ser quem a ampararia."

# game/script5.rpy:8028
translate pt_br_anubisbr scene135_3_f7b746ed:

#   "You followed Nadia home, and she told you everything—the weight she'd been carrying. But when the moment came, you left the door open. She slipped through. She's gone now, and you'll never know where the road took her."
    "Você seguiu Nadia até em casa, e ela lhe contou tudo — o peso que carregava. Mas, quando chegou a hora, você deixou a porta aberta. Ela escapou. Ela se foi agora, e você nunca saberá para onde a estrada a levou."

# game/script5.rpy:8032
translate pt_br_anubisbr scene135_3_2ac41cd8:

#   "You saw Nadia leaving the city. She walked past you without a word, and you let her. No flinch. No call. Just silence."
    "Você viu Nadia saindo da cidade. Ela passou por você sem dizer uma palavra, e você a deixou passar. Sem hesitar. Sem chamar. Apenas silêncio."

# game/script5.rpy:8040
translate pt_br_anubisbr scene135_3_2b87e511:

#   "You told Diana she would be queen. Your queen. A reward for helping you, for when the time was right."
    "Você disse a Diana que ela seria rainha. Sua rainha. Uma recompensa por ajudá-lo(a), quando chegasse a hora certa."

# game/script5.rpy:8042
translate pt_br_anubisbr scene135_3_41172c2e:

#   "You told Diana she would have a place in your harem as reward for helping you. She didn't refuse."
    "Você disse a Diana que ela teria um lugar em seu harém como recompensa por ajudá-lo. Ela não recusou."

# game/script5.rpy:8044
translate pt_br_anubisbr scene135_3_1470390f:

#   "You told Diana she would be your personal maid. She tilted her head, considering, then smiled. It wasn't the future she'd envisioned—but it was a future where she'd be better off."
    "Você disse a Diana que ela seria sua empregada pessoal. Ela inclinou a cabeça, pensativa, e então sorriu. Não era o futuro que ela havia imaginado, mas era um futuro em que ela estaria melhor."

# game/script5.rpy:8046
translate pt_br_anubisbr scene135_3_d63a8b95:

#   "You shut her down. Diana meant nothing to you. Her help went unrewarded, and the light in her eyes dimmed. But she held her composure, even as something inside her fractured."
    "Você a rejeitou. Diana não significava nada para você. Sua ajuda não foi recompensada, e o brilho em seus olhos se apagou. Mas ela manteve a compostura, mesmo quando algo dentro dela se despedaçou."

# game/script5.rpy:8052
translate pt_br_anubisbr scene135_3_6041a23f:

#   "Lena's face lit up when you offered to help her daughter. She trusted you too quickly. The moment coin entered the equation, you switched sides. She's dead now, and her daughter will never know why."
    "O rosto de Lena se iluminou quando você se ofereceu para ajudar a filha dela. Ela confiou em você rápido demais. No momento em que a moeda entrou na equação, você mudou de lado. Ela está morta agora, e a filha dela nunca saberá o porquê."

# game/script5.rpy:8055
translate pt_br_anubisbr scene135_3_a23b50c5:

#   "In the heat of her rage, you managed to calm Lena. Her sword lowered. Jenny and her father lived to see another day—because of you."
    "Em meio à sua fúria, você conseguiu acalmar Lena. A espada dela baixou. Jenny e o pai dela viveram para ver o dia seguinte — graças a você."

# game/script5.rpy:8057
translate pt_br_anubisbr scene135_3_f4b43480:

#   "In the heat of her rage, you did nothing. The blade fell. The blood pooled. And you watched, silent and still."
    "No calor da sua fúria, você não fez nada. A lâmina caiu. O sangue se acumulou. E você observou, em silêncio e imóvel."

# game/script5.rpy:8062
translate pt_br_anubisbr scene135_3_cd999e27:

#   "You refused to help Lena from the start. Choosing to help Jenny instead. She's dead now, and her daughter will never know why."
    "Você se recusou a ajudar Lena desde o início, optando por ajudar Jenny. Ela está morta agora, e sua filha nunca saberá o porquê."

# game/script5.rpy:8064
translate pt_br_anubisbr scene135_3_88167aa4:

#   "You refused to help Lena from the start. Choosing to help Jenny instead. She walked away, her daughter's future still hanging in the balance."
    "Você se recusou a ajudar Lena desde o início, optando por ajudar Jenny. Ela foi embora, deixando o futuro da filha em risco."

# game/script5.rpy:8071
translate pt_br_anubisbr scene135_3_a079527b:

#   "During your raid on Gheris's house, you found a document bearing Ruby's name. You demanded he revoke his ownership. His hand trembled as he signed her freedom away."
    "Durante sua invasão à casa de Gheris, você encontrou um documento com o nome de Ruby. Você exigiu que ele renunciasse à sua posse. Sua mão tremeu enquanto ele assinava, entregando-lhe a liberdade."

# game/script5.rpy:8079
translate pt_br_anubisbr scene135_3_8d995961:

#   "You calmed lieutenant Alice as she hunted you. Her breathing steadied, and for a moment, she saw you not as a target, but as a person."
    "Você acalmou a tenente Alice enquanto ela o perseguia. A respiração dela se estabilizou e, por um instante, ela o viu não como um alvo, mas como uma pessoa."

# game/script5.rpy:8081
translate pt_br_anubisbr scene135_3_dfd5e657:

#   "You spoke her fears aloud, and lieutenant Alice fled. Terror flickered in her eyes as she vanished into the alleys, swallowed by the shadows."
    "Você expressou seus medos em voz alta, e a tenente Alice fugiu. O terror brilhou em seus olhos enquanto ela desaparecia nos becos, engolida pelas sombras."

# game/script5.rpy:8083
translate pt_br_anubisbr scene135_3_7b891ce5:

#   "You killed lieutenant Alice. Her body crumpled in the alley, and you walked away without looking back."
    "Você matou a tenente Alice. O corpo dela caiu no beco, e você foi embora sem olhar para trás."

# game/script5.rpy:8088
translate pt_br_anubisbr scene135_3_ff98f0e1:

#   "The brothel has a new owner—you. Vera handed over the keys with a smile after you proved yourself capable. [brothel_name] will never be the same."
    "O bordel tem um novo dono: você. Vera lhe entregou as chaves com um sorriso depois que você provou ser capaz. [brothel_name] Nunca mais será a mesma coisa."

# game/script5.rpy:8090
translate pt_br_anubisbr scene135_3_23f1748b:

#   "You stumbled through Vera's questions, and she sent you away. The brothel remains out of reach—a missed opportunity that might have served you well."
    "Você se atrapalhou ao responder às perguntas de Vera, e ela te mandou embora. O bordel continua fora do seu alcance — uma oportunidade perdida que poderia ter lhe sido muito útil."

# game/script5.rpy:8092
translate pt_br_anubisbr scene135_3_2c1d6cd6:

#   "You never learned about the brothel. An opportunity slipped through your fingers—a business that might have anchored you in the city."
    "Você nunca soube da existência do bordel. Uma oportunidade escapou por entre seus dedos — um negócio que poderia ter lhe dado estabilidade na cidade."

# game/script5.rpy:8099
translate pt_br_anubisbr scene135_3_9658bbf9:

#   "After freeing Ruby from Gheris's grip, you hired her as a worker in your new business. Although... not before she proved her enthusiasm in a very personal way."
    "Após libertar Ruby das garras de Gheris, você a contratou como funcionária em seu novo negócio. Mas... não antes que ela demonstrasse seu entusiasmo de uma forma muito pessoal."

# game/script5.rpy:8101
translate pt_br_anubisbr scene135_3_90665e9e:

#   "After freeing Ruby from Gheris's grip, you hired her immediately. She started that same day—sharp-eyed and sharper-tongued, ready to prove herself."
    "Após libertar Ruby das garras de Gheris, você a contratou imediatamente. Ela começou no mesmo dia — de olhar penetrante e língua afiada, pronta para provar seu valor."

# game/script5.rpy:8103
translate pt_br_anubisbr scene135_3_8a4e14d9:

#   "After freeing Ruby from Gheris's grip, she arrived to you seeking help. But you turned her away. Who knows how long till she returns to her previous life and ends up in another trouble."
    "Depois de libertar Ruby das garras de Gheris, ela veio até você em busca de ajuda. Mas você a rejeitou. Quem sabe quanto tempo levará até que ela retorne à sua vida anterior e se meta em outra encrenca."

# game/script5.rpy:8110
translate pt_br_anubisbr scene135_3_95d726a5:

#   "The princess breathes air that isn't tainted by the smell of alcohol. She's free, and the road to Nahraya stretches before her—wide open, full of promise."
    "A princesa respira um ar que não está contaminado pelo cheiro de álcool. Ela é livre, e o caminho para Nahraya se estende diante dela — amplo e promissor."

# game/script5.rpy:8115
translate pt_br_anubisbr scene135_3_f029fafb:

#   "Even before you set out to rescue the princess, you faltered. Not enough allies. Not enough strength. The cellar remains her prison."
    "Mesmo antes de partir para resgatar a princesa, você vacilou. Não havia aliados suficientes. Não havia força suficiente. O porão continua sendo sua prisão."

# game/script5.rpy:8120
translate pt_br_anubisbr scene135_3_a22f152d:

#   "You made the plan. You went through the sewers, saw the princess with your own eyes. But time ran out. You left her there—and because of that, Lewis and Joan still draw breath."
    "Você fez o plano. Você percorreu os esgotos, viu a princesa com seus próprios olhos. Mas o tempo acabou. Você a deixou lá — e por causa disso, Lewis e Joan ainda respiram."

# game/script5.rpy:8130
translate pt_br_anubisbr scene135_3_c81b1f3a:

#   "The clock ran dry. You made a choice that cost Lewis and Joan their lives. They paid for the princess's freedom with everything they had."
    "O tempo acabou. Você fez uma escolha que custou a vida de Lewis e Joan. Eles pagaram pela liberdade da princesa com tudo o que tinham."

# game/script5.rpy:8132
translate pt_br_anubisbr scene135_3_2f867c3f:

#   "You slipped through the sewers without alerting anyone. Lewis and Joan live to fight another day."
    "Você escapou pelos esgotos sem alertar ninguém. Lewis e Joan vivem para lutar outro dia."

# game/script5.rpy:8141
translate pt_br_anubisbr scene135_3_14068928:

#   "Alex finally opened up to you. Her heart poured out—all the fear, all the loneliness, all the things she'd never said aloud. She'll never forget that night."
    "Alex finalmente se abriu com você. Seu coração se desfez — todo o medo, toda a solidão, todas as coisas que ela nunca havia dito em voz alta. Ela jamais esquecerá aquela noite."

# game/script5.rpy:8149
translate pt_br_anubisbr scene135_3_b431da10:

#   "Alex looked away. She trusts you—but not enough to share what's truly in her heart. The distance between you remains."
    "Alex desviou o olhar. Ela confia em você, mas não o suficiente para compartilhar o que realmente sente. A distância entre vocês permanece."

# game/script5.rpy:8156
translate pt_br_anubisbr scene135_3_f6695663:

#   "You left Yasmine to the mercy of those bandits. By doing so, you doomed Reham and her father. The family house now sits quiet. It was your choice. You knew what would happen."
    "Você deixou Yasmine à mercê daqueles bandidos. Ao fazer isso, você condenou Reham e seu pai. A casa da família agora está silenciosa. Foi sua escolha. Você sabia o que aconteceria."

# game/script5.rpy:8158
translate pt_br_anubisbr scene135_3_1cd728ed:

#   "You left Yasmine to the mercy of those bandits, and in doing so, doomed Reham and her father. The family house now sits quiet. Although you say you didn't mean it to happen—as if that matters."
    "Você abandonou Yasmine à mercê daqueles bandidos e, ao fazer isso, condenou Reham e seu pai. A casa da família agora está silenciosa. Embora você diga que não queria que isso acontecesse — como se isso importasse."

# game/script5.rpy:8160
translate pt_br_anubisbr scene135_3_fd54c1be:

#   "You helped Yasmine when the bandits surrounded her. In doing so, you reunited a family. The food was delicious, and for a moment, everything felt right."
    "Você ajudou Yasmine quando os bandidos a cercaram. Ao fazer isso, você reuniu uma família. A comida estava deliciosa e, por um instante, tudo pareceu perfeito."

# game/script5.rpy:8167
translate pt_br_anubisbr scene135_3_fb477d2d:

#   "The princess remains by your side, her affection deepening with every passing day. But the grief of her miscarriage lingers, and its shadow will hang over your relationship for as long as it lasts."
    "A princesa permanece ao seu lado, e seu afeto se intensifica a cada dia que passa. Mas a dor do aborto espontâneo persiste, e sua sombra pairará sobre o relacionamento de vocês enquanto ele durar."

# game/script5.rpy:8169
translate pt_br_anubisbr scene135_3_b08c1883:

#   "The princess stays by your side, her affection deepening with every passing day. For now, all is well between you."
    "A princesa permanece ao seu lado, e seu afeto se intensifica a cada dia que passa. Por enquanto, tudo está bem entre vocês."

# game/script5.rpy:8173
translate pt_br_anubisbr scene135_3_575af240:

#   "Rebecca still looks to you as her protector, trusting you despite the distance between you. But the princess still carries the grief of her miscarriage and the memory of the protector you once were."
    "Rebecca ainda te vê como seu protetor, confiando em você apesar da distância entre vocês. Mas a princesa ainda carrega a dor do aborto espontâneo e a lembrança do protetor que você um dia foi."

# game/script5.rpy:8175
translate pt_br_anubisbr scene135_3_2ce99989:

#   "The princess still looks to you as her protector, trusting you despite the distance between you."
    "A princesa ainda te vê como seu protetor, confiando em você apesar da distância entre vocês."

# game/script5.rpy:8182
translate pt_br_anubisbr scene135_3_ab99ec77:

#   "You stood up and took the Queen's lips. Her surprise at your sudden affection still lingers in your mind. The taste of her, the warmth of her—it was everything you'd imagined and nothing you'd expected."
    "Você se levantou e beijou os lábios da Rainha. A surpresa dela com seu afeto repentino ainda permanece em sua mente. O sabor dela, o calor dela — era tudo o que você havia imaginado e nada do que você esperava."

# game/script5.rpy:8190
translate pt_br_anubisbr scene135_3_42dd2a1b:

#   "You allowed the prince to examine your new metal hand. He inspected it thoroughly, fascination evident in every touch."
    "Você permitiu que o príncipe examinasse sua nova mão de metal. Ele a inspecionou minuciosamente, com fascínio evidente em cada toque."

# game/script5.rpy:8194
translate pt_br_anubisbr scene135_3_f14fe9fc:

#   "The prince flushed when you told him the truth about your erection. He still doesn't know what to make of it, or of you."
    "O príncipe corou quando você lhe contou a verdade sobre sua ereção. Ele ainda não sabe o que pensar disso, nem de você."

# game/script5.rpy:8196
translate pt_br_anubisbr scene135_3_3cfc7f54:

#   "The anger in his eyes softened when you lied about your erection. He told you never to mention it again."
    "A raiva em seus olhos suavizou-se quando você mentiu sobre sua ereção. Ele disse para você nunca mais mencionar isso."

# game/script5.rpy:8198
translate pt_br_anubisbr scene135_3_362b0889:

#   "The prince's curiosity burned even brighter after you refused to let him touch your new hand."
    "A curiosidade do príncipe aumentou ainda mais depois que você se recusou a deixá-lo tocar sua nova mão."

# game/script5.rpy:8205
translate pt_br_anubisbr scene135_3_53b7e2b6:

#   "You finally reached her. The Queen's mind stirs—her city, her daughter, and... you. You live in her thoughts now, perhaps as a new lover."
    "Você finalmente a alcançou. A mente da Rainha se agita — sua cidade, sua filha e... você. Você agora vive em seus pensamentos, talvez como um novo amante."

# game/script5.rpy:8210
translate pt_br_anubisbr scene135_3_1fcf89d2:

#   "The Queen treats you with more respect now, but nothing has fundamentally changed. You're still her recruit, her steward. Nothing more."
    "A Rainha agora te trata com mais respeito, mas nada mudou fundamentalmente. Você ainda é seu recruta, seu mordomo. Nada mais."

# game/script5.rpy:8218
translate pt_br_anubisbr scene135_3_c17495ae:

#   "You reformed the thugs who had been terrorizing the city's people. But not without a price—a consequence for killing one of Vic's men. The ledger is balanced. For now."
    "Você reformou os bandidos que vinham aterrorizando a população da cidade. Mas não sem um preço — uma consequência por ter matado um dos homens de Vic. O balanço está fechado. Por enquanto."

# game/script5.rpy:8220
translate pt_br_anubisbr scene135_3_b77f12ae:

#   "You reformed the thugs who had been terrorizing the city's people. No blood was spilled. The market breathes easier now."
    "Você reformou os bandidos que vinham aterrorizando a população da cidade. Nenhum sangue foi derramado. O mercado respira mais aliviado agora."

# game/script5.rpy:8222
translate pt_br_anubisbr scene135_3_688064c5:

#   "Your metal fingers pierced Vic's throat, killing him instantly. His men followed soon after. Your mind still wonders what truly happened that day."
    "Seus dedos de metal perfuraram a garganta de Vic, matando-o instantaneamente. Seus homens o seguiram logo em seguida. Sua mente ainda se questiona sobre o que realmente aconteceu naquele dia."

# game/script5.rpy:8229
translate pt_br_anubisbr scene135_3_eef548d6:

#   "You took her lips, and she took yours. This budding relationship with Yasmine might prove risky. Perhaps you should keep it hidden for now."
    "Você tomou os lábios dela, e ela tomou os seus. Esse relacionamento nascente com Yasmine pode se provar arriscado. Talvez seja melhor mantê-lo em segredo por enquanto."

# game/script5.rpy:8231
translate pt_br_anubisbr scene135_3_a8d79afb:

#   "You didn't allow Yasmine to be with you. She understood—but it still hurt. You saw it in the way she folded her hands, the way she looked away."
    "Você não permitiu que Yasmine ficasse com você. Ela entendeu, mas ainda assim doeu. Você viu isso no jeito como ela cruzou as mãos, no jeito como desviou o olhar."

# game/script5.rpy:8233
translate pt_br_anubisbr scene135_3_e130f830:

#   "Your terrible attempt at flirtation made things worse. Yasmine is now uncomfortable around you. The warmth you once shared has curdled into awkwardness."
    "Sua péssima tentativa de flerte só piorou as coisas. Yasmine agora se sente desconfortável perto de você. O carinho que vocês compartilhavam antes se transformou em constrangimento."

# game/script5.rpy:8235
translate pt_br_anubisbr scene135_3_06107795:

#   "You let Yasmine go. Perhaps you didn't want to bring more trouble to her failing marriage. Or perhaps you simply weren't interested."
    "Você deixou Yasmine ir. Talvez não quisesse causar mais problemas ao casamento dela, que já estava em crise. Ou talvez simplesmente não tivesse interesse."

# game/script5.rpy:8242
translate pt_br_anubisbr scene135_3_d58736a4:

#   "No longer a servant or a friend. Reham is now your lover, through and through. She'll follow you to the ends of the desert—and beyond."
    "Reham não é mais uma serva ou uma amiga. Agora ela é sua amante, de corpo e alma. Ela o seguirá até os confins do deserto — e além."

# game/script5.rpy:8244
translate pt_br_anubisbr scene135_3_570d11a2:

#   "You confessed your true feelings to Reham. She shut you down—not as a master, but as a lover. The sensible one remains sensible."
    "Você confessou seus verdadeiros sentimentos a Reham. Ela o rejeitou — não como mestre, mas como amante. O sensato permanece sensato."

# game/script5.rpy:8246
translate pt_br_anubisbr scene135_3_aef55fa3:

#   "You never made a move on Reham. When things finally return to normal, she will likely stay with her parents."
    "Você nunca fez nada em relação à Reham. Quando as coisas finalmente voltarem ao normal, ela provavelmente ficará com os pais."

# game/script5.rpy:8253
translate pt_br_anubisbr scene135_3_673a6c31:

#   "You lifted Maia from her gloom and set her atop a mountain where she finally broke free of her fear. She owes you her life, her soul, and... her body."
    "Você tirou Maia de sua escuridão e a colocou no topo de uma montanha onde ela finalmente se libertou de seu medo. Ela lhe deve a vida, a alma e... o corpo."

# game/script5.rpy:8259
translate pt_br_anubisbr scene135_3_e40e7cb2:

#   "You left her to her thoughts. And her thoughts are slowly killing her. The breaking point is near, and you may not be there when it comes."
    "Você a deixou entregue aos seus pensamentos. E esses pensamentos estão lentamente a matando. O ponto de ruptura está próximo, e você pode não estar lá quando ele chegar."

# game/script5.rpy:8268
translate pt_br_anubisbr scene135_3_df8a1c04:

#   "You encouraged Negumi when she faltered. Your words lit a fire in her that even the desert winds couldn't extinguish."
    "Você encorajou Negumi quando ela vacilou. Suas palavras acenderam uma chama nela que nem mesmo os ventos do deserto conseguiram extinguir."

# game/script5.rpy:8270
translate pt_br_anubisbr scene135_3_b23eed6b:

#   "You offered no comfort to Negumi. She rides with you in silence, her shoulders hunched, her fire dimmed."
    "Você não ofereceu nenhum consolo a Negumi. Ela cavalga com você em silêncio, os ombros curvados, o fogo apagado."

# game/script5.rpy:8283
translate pt_br_anubisbr scene135_3_45af595a:

#   "[pregnancies] out of 9 available women are now expecting. Looks like you're single-handedly repopulating the world..."
    "[pregnancies] Das 9 mulheres disponíveis, todas estão grávidas. Parece que você está repovoando o mundo sozinho..."

# game/script5.rpy:8285
translate pt_br_anubisbr scene135_3_536d2965:

#   "You've knocked up [pregnancies] of the 9 available lovely ladies. Leave some for the rest of us, stud!"
    "Você engravidou [pregnancies] Das 9 lindas damas disponíveis. Deixe algumas para o resto de nós, garanhão!"

# game/script5.rpy:8287
translate pt_br_anubisbr scene135_3_412914e3:

#   "[pregnancies] out of 9 available women are carrying your child. Someone's been a busy bee, haven't they?"
    "[pregnancies] Das 9 mulheres disponíveis, uma está grávida do seu filho. Alguém andou trabalhando bastante, não é mesmo?"

# game/script5.rpy:8289
translate pt_br_anubisbr scene135_3_8560482b:

#   "You haven't impregnated a single woman so far. Are you feeling okay? Or just... responsible?"
    "Você ainda não engravidou nenhuma mulher. Está se sentindo bem? Ou apenas... responsável?"

# game/script5.rpy:8293
translate pt_br_anubisbr scene135_3_ec5fc269:

#   "You have [mc_coin] coins to your name, and your honor stands at [mc_karma] out of 10. Whatever that means."
    "Você tem [mc_coin] moedas em seu nome, e sua honra permanece em [mc_karma] De 0 a 10. Seja lá o que isso signifique."

