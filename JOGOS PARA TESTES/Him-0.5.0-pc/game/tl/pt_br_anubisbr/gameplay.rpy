#   mc "Wait—"
    mc "Espere-"

# game/gameplay.rpy:3401
translate pt_br_anubisbr diana_harem_chance2_17b8dbb8:

#   evrart "Shut it! If you're serious about Diana, then you'll prove it the proper way. The old way."
    evrart "Cale-se! Se você está falando sério sobre Diana, então prove isso da maneira correta. Do jeito antigo."

# game/gameplay.rpy:3403
translate pt_br_anubisbr diana_harem_chance2_a23b818f:

#   mc "Proper way? What are you talking about?"
    mc "Forma correta? Do que você está falando?"

# game/gameplay.rpy:3405
translate pt_br_anubisbr diana_harem_chance2_b0cb5ba7:

#   evrart "Arm wrestling."
    evrart "Queda de braço."

# game/gameplay.rpy:3407
translate pt_br_anubisbr diana_harem_chance2_8d4a1241:

#   mc "....Arm wrestling? That's your test of character? {i}Arm wrestling?{/i}"
    mc "...Queda de braço? Esse é o seu teste de caráter? {i} Queda de braço?{/i}"

# game/gameplay.rpy:3409
translate pt_br_anubisbr diana_harem_chance2_c10dd74d:

#   evrart "That's right. Two men. One table. One winner. And if you lose, you walk away from the girl forever!"
    evrart "Isso mesmo. Dois homens. Uma mesa. Um vencedor. E se você perder, se livra da garota para sempre!"

# game/gameplay.rpy:3411
translate pt_br_anubisbr diana_harem_chance2_6fa7bf2d:

#   di "Evrart, you can't just—this isn't some tavern brawl! He's a hero!"
    di "Evrart, você não pode simplesmente... isso não é uma briga de taverna! Ele é um herói!"

# game/gameplay.rpy:3413
translate pt_br_anubisbr diana_harem_chance2_4b815819:

#   evrart "Hush, princess! This is tradition. The ancient art of deciding manliness!"
    evrart "Silêncio, princesa! Isso é tradição. A antiga arte de decidir o que é ser homem!"

# game/gameplay.rpy:3415
translate pt_br_anubisbr diana_harem_chance2_53b8fcd3:

#   mc "Pretty sure that's just called insecurity. And also, I think you're making up that tradition."
    mc "Tenho quase certeza de que isso se chama insegurança. E também acho que você está inventando essa tradição."

# game/gameplay.rpy:3417
translate pt_br_anubisbr diana_harem_chance2_9523b329:

#   evrart "And I'm pretty sure you're about to get your hand crushed."
    evrart "E tenho quase certeza de que sua mão está prestes a ser esmagada."

# game/gameplay.rpy:3418
translate pt_br_anubisbr diana_harem_chance2_54707a95:

#   evrart "Sit down, boy. Let's see what those hands are made of."
    evrart "Sente-se, garoto. Vamos ver do que essas mãos são feitas."

# game/gameplay.rpy:3423
translate pt_br_anubisbr diana_harem_chance2_ea9f6fcf:

#   di "{size=30}[mc], don't be fooled by his age. Evrart was a seasoned knight. He served under Queen Hannah's father.{/size}"
    di "{size=30}[mc] Não se deixe enganar pela idade dele. Evrart era um cavaleiro experiente. Ele serviu sob o comando do pai da Rainha Hannah.{/size}"

# game/gameplay.rpy:3424
translate pt_br_anubisbr diana_harem_chance2_6ef0f873:

#   di "{size=30}No one was ever able to defeat him at arm wrestling during his prime.{/size}"
    di "{size=30}Durante o auge de sua carreira, ninguém jamais conseguiu derrotá-lo em uma queda de braço.{/size}"

# game/gameplay.rpy:3425
translate pt_br_anubisbr diana_harem_chance2_8418730a:

#   mc "{size=30}Seriously!?{/size}"
    mc "{size=30}Seriamente!?{/size}"

# game/gameplay.rpy:3426
translate pt_br_anubisbr diana_harem_chance2_cbdcab94:

#   di "{size=30}Mhm. Don't go easy on him. Well... Don't go too hard either. He's still an old man afterall.{/size}"
    di "{size=30}Hum. Não pegue leve com ele. Bem... também não pegue muito pesado. Afinal, ele ainda é um senhor de idade.{/size}"

# game/gameplay.rpy:3427
translate pt_br_anubisbr diana_harem_chance2_27f2b371:

#   evrart "What's wrong, boy? Too scared to show your girly hands?"
    evrart "Qual é o problema, garoto? Com ​​medo de mostrar suas mãozinhas de menina?"

# game/gameplay.rpy:3429
translate pt_br_anubisbr diana_harem_chance2_484f5d40:

#   mc "Fine, but just so you know—if I win, you'll stop treating me like some scoundrel."
    mc "Tudo bem, mas só para você saber: se eu ganhar, você vai parar de me tratar como um canalha."

# game/gameplay.rpy:3431
translate pt_br_anubisbr diana_harem_chance2_10a0a8f8:

#   evrart "{i}If{/i} you win, boy, I'll start treatin' you like a man. Until then, you're just a stray dog sniffin' after scraps."
    evrart "{i}Se{/i} Se você vencer, garoto, começarei a te tratar como um homem. Até lá, você não passa de um cachorro vira-lata farejando restos de comida."

# game/gameplay.rpy:3437
translate pt_br_anubisbr diana_harem_chance2_bdde0e6a:

#   di "This is ridiculous... but go, go [mc]!"
    di "Isso é ridículo... mas vai, vai [mc]!"

# game/gameplay.rpy:3438
translate pt_br_anubisbr diana_harem_chance2_9c432f7d:

