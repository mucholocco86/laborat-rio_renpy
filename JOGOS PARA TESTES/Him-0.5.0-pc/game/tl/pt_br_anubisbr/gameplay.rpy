translate pt_br_anubisbr diana_harem_chance2_0d7a2499:

#   evrart_ "Over my dead body!"
    evrart_ "Só por cima do meu cadáver!"

# game/gameplay.rpy:3383
translate pt_br_anubisbr diana_harem_chance2_24b577b2:

#   di "Oh, dear..."
    di "Oh céus..."

# game/gameplay.rpy:3386
translate pt_br_anubisbr diana_harem_chance2_ef151be5:

#   di "Please, Evrart... This time it isn't like that!"
    di "Por favor, Evrart... Desta vez não será assim!"

# game/gameplay.rpy:3388
translate pt_br_anubisbr diana_harem_chance2_95482dba:

#   evrart "You don't know nothin', sweetheart. These men are here for only one thing!"
    evrart "Você não sabe de nada, querida. Esses homens estão aqui por um único motivo!"

# game/gameplay.rpy:3389
translate pt_br_anubisbr diana_harem_chance2_a2f6e1ad:

#   evrart "They sweet-talk you, they promise you the moon, and then they're gone before sunrise, leaving you with nothing but a broken heart!"
    evrart "Eles te bajulam com palavras doces, te prometem o mundo e a terra, e depois somem antes do amanhecer, te deixando apenas com o coração partido!"

# game/gameplay.rpy:3391
translate pt_br_anubisbr diana_harem_chance2_b5ea1b7d:

#   di "He isn't like that! And besides, I'm not a child anymore. You can stop with this overprotective guardian act."
    di "Ele não é assim! E além disso, eu não sou mais criança. Pode parar com essa atitude de guardião superprotetor."

# game/gameplay.rpy:3392
translate pt_br_anubisbr diana_harem_chance2_0673bc9e:

#   di "It was charming when I was sixteen. Now it's just... exhausting."
    di "Era encantador quando eu tinha dezesseis anos. Agora é simplesmente... exaustivo."

# game/gameplay.rpy:3395
translate pt_br_anubisbr diana_harem_chance2_51f48941:

#   evrart "Tch! Children always say that right before they get swindled. And what kind of man says 'lover' and then hops in bed before proving his worth?"
    evrart "Tch! As crianças sempre dizem isso antes de serem enganadas. E que tipo de homem diz \"amante\" e depois pula na cama sem provar o seu valor?"

# game/gameplay.rpy:3397
translate pt_br_anubisbr diana_harem_chance2_1abeb59a:

#   evrart "Tch! Children always say that right before they get swindled. And what kind of man says 'friend' and then hops in bed before proving his worth?"
    evrart "Tch! As crianças sempre dizem isso antes de serem enganadas. E que tipo de homem diz \"amigo\" e depois pula na cama sem provar o seu valor?"

# game/gameplay.rpy:3399
