# game/gameplay.rpy:3177
translate pt_br_anubisbr free_roam_reb_talk_diana_9ba4ccec:

#   mc "I don't really care about that."
    mc "Eu realmente não me importo com isso."

# game/gameplay.rpy:3178
translate pt_br_anubisbr free_roam_reb_talk_diana_b9b755e5:

#   r "..."
    r "..."

# game/gameplay.rpy:3180
translate pt_br_anubisbr free_roam_reb_talk_diana_c263d2f3:

#   r "*sigh* Gods... listen to me. I sound just like my mother..."
    r "*suspiro* Deuses... escutem o que eu estou dizendo. Estou igualzinha à minha mãe..."

# game/gameplay.rpy:3181
translate pt_br_anubisbr free_roam_reb_talk_diana_83ce5c78:

#   r "...Whatever. Thanks for telling me, I guess."
    r "...Tanto faz. Obrigado por me avisar, eu acho."

# game/gameplay.rpy:3187
translate pt_br_anubisbr free_roam_market2_4811e03f:

#   mc "(I have enough to buy that servant now. I should go out and see her sometime later.)"
    mc "(Já tenho dinheiro suficiente para contratar aquela empregada. Devo sair e vê-la mais tarde.)"

# game/gameplay.rpy:3189
translate pt_br_anubisbr free_roam_market2_34a3ca74:

#   mc "(No reason to go there for now.)"
    mc "(Não há motivo para ir lá agora.)"

# game/gameplay.rpy:3198
translate pt_br_anubisbr diana_harem_chance_2a67b1d2:

#   mc "Hey, Diana. How are you doing?"
    mc "Olá, Diana. Como você está?"

# game/gameplay.rpy:3200
translate pt_br_anubisbr diana_harem_chance_f8c33510:

#   di "[mc]! You're back."
    di "[mc] Você voltou!"

# game/gameplay.rpy:3202
translate pt_br_anubisbr diana_harem_chance_4f2406b6:

#   mc "Yeah. Why wouldn't I be? I've been here almost everyday now."
    mc "Sim. Por que eu não estaria? Tenho estado aqui quase todos os dias."

# game/gameplay.rpy:3204
translate pt_br_anubisbr diana_harem_chance_3fb721dd:

#   di "I... wasn't sure if you'd want to see me again."
    di "Eu... não tinha certeza se você gostaria de me ver de novo."

# game/gameplay.rpy:3206
translate pt_br_anubisbr diana_harem_chance_419198c1:

#   mc "Why wouldn't I? Did I leave such a bad impression?"
    mc "Por que não faria isso? Será que causei uma impressão tão ruim assim?"

# game/gameplay.rpy:3208
translate pt_br_anubisbr diana_harem_chance_62a8e3b2:

#   di "No! Not bad. Just... intense. I've been replaying it in my head ever since."
    di "Não! Não foi ruim. Só... intenso. Estou repassando a cena na minha cabeça desde então."

# game/gameplay.rpy:3210
translate pt_br_anubisbr diana_harem_chance_64171376:

#   mc "Is that so? Sounds like I left more of a mark than I thought."
    mc "É mesmo? Parece que deixei uma marca maior do que imaginava."

# game/gameplay.rpy:3212
translate pt_br_anubisbr diana_harem_chance_4084d83e:

#   di "[mc]... can I ask you something?"
    di "[mc]... posso te perguntar uma coisa?"

# game/gameplay.rpy:3214
translate pt_br_anubisbr diana_harem_chance_af353eb6:

#   mc "Go ahead."
    mc "Vá em frente."

# game/gameplay.rpy:3216
translate pt_br_anubisbr diana_harem_chance_34bb08c3:

#   di "I know I shouldn't. As a brothel worker, it's... not really my place to ask customers things like this. It's supposed to just be my job."
    di "Eu sei que não deveria. Como funcionária de um bordel, não é bem da minha conta perguntar coisas assim aos clientes. É só o meu trabalho."

# game/gameplay.rpy:3217
translate pt_br_anubisbr diana_harem_chance_dcd99fa3:

#   di "But like I told you before between us, there was never any customers."
    di "Mas, como eu já te disse antes, entre nós nunca houve clientes."

# game/gameplay.rpy:3218
translate pt_br_anubisbr diana_harem_chance_28d0a94b:

#   di "And I know we barely know each other, but that night... when you touched me, when you said those things to me... it felt like it meant something more. And now I can't stop wondering..."
    di "E eu sei que mal nos conhecemos, mas naquela noite... quando você me tocou, quando você me disse aquelas coisas... pareceu que significava algo mais. E agora não consigo parar de pensar..."

# game/gameplay.rpy:3220
translate pt_br_anubisbr diana_harem_chance_754cf7da:

#   di "What are we, [mc]?"
    di "O que somos nós, [mc]?"

# game/gameplay.rpy:3222
translate pt_br_anubisbr diana_harem_chance_2b35b6fe:

#   mc "..."
    mc "..."

# game/gameplay.rpy:3227
translate pt_br_anubisbr scene07_choice01_op1_b91b708f:

#   mc "Lovers."
    mc "Amantes."

# game/gameplay.rpy:3228
translate pt_br_anubisbr scene07_choice01_op1_050f3ab5:

#   di "..."
    di "..."

# game/gameplay.rpy:3229
translate pt_br_anubisbr scene07_choice01_op1_45f4465f:

#   mc "Diana? Did I say something wrong?"
    mc "Diana? Eu disse alguma coisa errada?"

# game/gameplay.rpy:3231
translate pt_br_anubisbr scene07_choice01_op1_029d4bd1:

#   di "Do you... do you really mean it? You're not just saying it because you think I want to hear it?"
    di "Você... você está falando sério mesmo? Você não está dizendo isso só porque acha que eu quero ouvir?"

# game/gameplay.rpy:3233
translate pt_br_anubisbr scene07_choice01_op1_b6b9e0f0:

#   mc "I do. I wouldn't say it if I didn't."
    mc "Sim, eu diria. Se não dissesse, não diria."

# game/gameplay.rpy:3235
translate pt_br_anubisbr scene07_choice01_op1_b655333f:

#   di "Gods... I wasn't sure if you would. When you left, I kept telling myself it was just a night. That I was just... convenient."
    di "Meu Deus... eu não tinha certeza se você faria isso. Quando você foi embora, eu ficava repetindo para mim mesma que era só uma noite. Que eu era só... conveniente."

# game/gameplay.rpy:3237
translate pt_br_anubisbr scene07_choice01_op1_a406d7ed:

#   mc "You weren't."
    mc "Você não estava."

# game/gameplay.rpy:3239
translate pt_br_anubisbr scene07_choice01_op1_4de309ab:

#   di "Then... we're truly lovers? Not just by flesh, but... in heart?"
    di "Então... somos realmente amantes? Não apenas fisicamente, mas... de coração?"

# game/gameplay.rpy:3241
translate pt_br_anubisbr scene07_choice01_op1_9c21e20f:

#   mc "In heart. In flesh. In whatever way matters. You and me."
    mc "No coração. Na carne. Em todos os sentidos que importam. Você e eu."

# game/gameplay.rpy:3243
translate pt_br_anubisbr scene07_choice01_op1_fa2742af:

#   di "*laughs* You don't know how much I needed to hear that. I've been waiting for someone to say those words to me for years."
    di "*risos* Você não imagina o quanto eu precisava ouvir isso. Há anos que espero que alguém me diga essas palavras."

# game/gameplay.rpy:3245
translate pt_br_anubisbr scene07_choice01_op1_48d8a9b0:

#   mc "I'll say it to you everyday."
    mc "Vou te dizer isso todos os dias."

# game/gameplay.rpy:3247
translate pt_br_anubisbr scene07_choice01_op1_4d2dba59:

#   di "Fool... you'll spoil me if you keep saying things like that."
    di "Seu tolo... você vai me mimar se continuar dizendo coisas assim."

# game/gameplay.rpy:3249
translate pt_br_anubisbr scene07_choice01_op1_e165058e:

#   mc "Maybe I want to spoil you. You've been working yourself to the bone, taking care of everyone except yourself. Let someone take care of you for a change."
    mc "Talvez eu queira te mimar. Você tem se matado de trabalhar, cuidando de todos, menos de si mesma. Deixe alguém cuidar de você, para variar."

# game/gameplay.rpy:3251
translate pt_br_anubisbr scene07_choice01_op1_36a65358:

#   di "Then promise me, [mc]... you won't cast me aside."
    di "Então me prometa, [mc]... você não vai me descartar."

# game/gameplay.rpy:3253
translate pt_br_anubisbr scene07_choice01_op1_0a4dbc8d:

#   mc "I promise."
    mc "Eu prometo."

# game/gameplay.rpy:3255
translate pt_br_anubisbr scene07_choice01_op1_496ed821:

#   di "*sigh* Good... then let me tell you something else. Something I've been dreaming about for a long time."
    di "*suspiro* Ótimo... então deixe-me contar outra coisa. Algo com que tenho sonhado há muito tempo."

# game/gameplay.rpy:3257
translate pt_br_anubisbr scene07_choice01_op1_def0ad19:

#   mc "What is it?"
    mc "O que é?"

# game/gameplay.rpy:3259
translate pt_br_anubisbr scene07_choice01_op1_42b65745:

#   di "I've been thinking a lot about my life here. I don't want to stay a working girl forever. Especially now that I have you."
    di "Tenho pensado muito sobre a minha vida aqui. Não quero continuar sendo uma garota de programa para sempre. Principalmente agora que tenho você."

# game/gameplay.rpy:3260
translate pt_br_anubisbr scene07_choice01_op1_d9bfb49b:

#   di "I want to buy this brothel from Vera someday and turn it into a regular tavern."
    di "Um dia quero comprar este bordel da Vera e transformá-lo numa taverna normal."

# game/gameplay.rpy:3262
translate pt_br_anubisbr scene07_choice01_op1_f432b7c4:

#   mc "That's... ambitious."
    mc "Isso é... ambicioso."

# game/gameplay.rpy:3264
translate pt_br_anubisbr scene07_choice01_op1_4f0c1232:

#   di "*laughs* Isn't it? Right now I can barely afford three meals a day."
    di "*risos* Não é mesmo? No momento, mal consigo pagar três refeições por dia."

# game/gameplay.rpy:3265
translate pt_br_anubisbr scene07_choice01_op1_4bd8ac7a:

#   di "I've been saving coppers in a jar under my bed, but at this rate, I'll be sixty before I have enough. But... that's where you come in."
