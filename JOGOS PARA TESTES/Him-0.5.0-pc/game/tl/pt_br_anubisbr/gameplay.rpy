#   di "Three... Two... One... Go!"
    di "Três... Dois... Um... Já!"

# game/gameplay.rpy:3441
translate pt_br_anubisbr diana_harem_chance2_2af40447:

#   evrart "Hnnngh! Not bad... you've got some strength in ya. More than I expected from a pretty boy."
    evrart "Hnnngh! Nada mal... você tem bastante força. Mais do que eu esperava de um rapaz bonito."

# game/gameplay.rpy:3443
translate pt_br_anubisbr diana_harem_chance2_c3f57e32:

#   mc "You're not bad yourself... for a fossil!"
    mc "Você também não é nada mal... para um fóssil!"

# game/gameplay.rpy:3445
