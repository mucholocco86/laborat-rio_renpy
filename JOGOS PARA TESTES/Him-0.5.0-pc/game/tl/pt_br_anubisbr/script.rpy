translate pt_br_anubisbr scene04_brothel2_dd4dd522:

#   mc "Trust me, I thought I was done for."
    mc "Acredite, eu pensei que estava perdido."

# game/script.rpy:1737
translate pt_br_anubisbr scene04_brothel2_d9e85028:

#   d "And yet, you're here. Either the gods favor you... or you have a habit of surviving the impossible. Which is it?"
    d "E, no entanto, você está aqui. Ou os deuses te favorecem... ou você tem o hábito de sobreviver ao impossível. Qual das duas opções é a correta?"

# game/script.rpy:1739
translate pt_br_anubisbr scene04_brothel2_53cf4208:

#   mc "*chuckles* A little bit of both, maybe."
    mc "*risos* Um pouco de ambos, talvez."

# game/script.rpy:1741
translate pt_br_anubisbr scene04_brothel2_3294d3ac:

#   mc "What about you? Do you come to the brothel often? You seem to know the staff pretty well."
    mc "E você? Costuma frequentar o bordel? Parece conhecer bem os funcionários."

# game/script.rpy:1743
translate pt_br_anubisbr scene04_brothel2_aa4c0959:

#   d "Believe it or not, this is my first time actually drinking here."
    d "Acredite ou não, esta é a primeira vez que bebo aqui."

# game/script.rpy:1745
translate pt_br_anubisbr scene04_brothel2_554b6aac:

#   mc "First time, huh? That girl... Diana seemed to know your name."
    mc "Primeira vez, hein? Aquela garota... Diana parecia saber seu nome."

# game/script.rpy:1747
translate pt_br_anubisbr scene04_brothel2_1065c4de:

#   d "{i}*chuckles*{/i} I'm not lying. And of course she knows who I am. I've hauled more drunkards out of here than I can count."
    d "{i}*risos*{/i} Não estou mentindo. E claro que ela sabe quem eu sou. Já tirei mais bêbados daqui do que consigo contar."

# game/script.rpy:1748
translate pt_br_anubisbr scene04_brothel2_069ac2cb:

#   d "The Commander of the Guard is a familiar face in every tavern and brothel in this city. Just not usually as a customer."
    d "O Comandante da Guarda é uma figura conhecida em todas as tabernas e bordéis desta cidade. Só que geralmente não como cliente."

# game/script.rpy:1750
translate pt_br_anubisbr scene04_brothel2_054c5ee0:

#   mc "I see."
    mc "Eu vejo."

# game/script.rpy:1752
translate pt_br_anubisbr scene04_brothel2_959f24e6:

#   d "Diana! Over here!"
    d "Diana! Por aqui!"

# game/script.rpy:1754
translate pt_br_anubisbr scene04_brothel2_935c9dc0:

#   di "Yes, sir Darius?"
    di "Sim, senhor Darius?"

# game/script.rpy:1756
translate pt_br_anubisbr scene04_brothel2_6a8b590d:

#   d "Can you believe it, Diana? I managed to find you a customer at last. You should mark this day on your calendar."
    d "Acredita, Diana? Finalmente consegui um cliente para você. Marque esse dia no seu calendário."

# game/script.rpy:1758
translate pt_br_anubisbr scene04_brothel2_4f812da3:

#   di "Sir Darius, please... You'll give him the wrong impression."
    di "Senhor Darius, por favor... Você vai passar uma impressão errada para ele."

# game/script.rpy:1760
translate pt_br_anubisbr scene04_brothel2_7ca5d6fc:

#   d "Sorry, sorry. Take care of my friend here. He's earned it."
    d "Desculpe, desculpe. Cuide do meu amigo aqui. Ele merece."

# game/script.rpy:1761
translate pt_br_anubisbr scene04_brothel2_b221fb67:

#   mc "Darius?"
    mc "Darius?"

# game/script.rpy:1763
translate pt_br_anubisbr scene04_brothel2_7413732a:

#   di "Follow me, darling. I'll show you to your room."
    di "Siga-me, querida. Vou lhe mostrar o caminho até o seu quarto."

# game/script.rpy:1766
translate pt_br_anubisbr scene04_brothel2_b12907fb:

#   mc "Alright..."
    mc "Tudo bem..."

# game/script.rpy:1768
translate pt_br_anubisbr scene04_brothel2_a26fe8ed:

#   d "Well, friend, I'll leave you to it. Until tomorrow!"
    d "Bem, amigo, vou deixar você em paz. Até amanhã!"

# game/script.rpy:1770
translate pt_br_anubisbr scene04_brothel2_fba44b8d:

#   mc "Take care, Darius. And uh... thanks. For everything."
    mc "Cuide-se, Darius. E... obrigado. Por tudo."

# game/script.rpy:1776
translate pt_br_anubisbr scene05_0_f02a7158:

#   mc "Been working here long?"
    mc "Você trabalha aqui há muito tempo?"

# game/script.rpy:1777
translate pt_br_anubisbr scene05_0_4bc1f1c2:

#   di "Hmm? Maybe. why do you ask?"
    di "Hum? Talvez. Por que você pergunta?"

# game/script.rpy:1778
translate pt_br_anubisbr scene05_0_8212e7e2:

#   di "Let me guess... you fell for me at first glance, and now you want to take me as your own! Sweep me away from this life of sin and labor!"
    di "Deixe-me adivinhar... você se apaixonou por mim à primeira vista e agora quer me tomar para si! Me leve para longe desta vida de pecado e trabalho!"

# game/script.rpy:1779
translate pt_br_anubisbr scene05_0_cefc318d:

#   mc "You've got quite the imagination."
    mc "Você tem muita imaginação."

# game/script.rpy:1780
translate pt_br_anubisbr scene05_0_c10aa9d3:

#   di "*chuckles* I wasn't. I only started about a month ago."
    di "*risos* Não, não estava. Comecei há apenas um mês."

# game/script.rpy:1783
translate pt_br_anubisbr scene05_0_b439dfb4:

#   mc "So... what exactly are we doing here? I mean.... what's the... procedure?"
    mc "Então... o que exatamente estamos fazendo aqui? Quer dizer... qual é o... procedimento?"

# game/script.rpy:1786
translate pt_br_anubisbr scene05_0_4c665ce0:

#   di "Oh! First, we'll fill in our tax documents. Then we'll fix the broken roof tiles, there's a leak in the east wing that's been driving Vera mad."
    di "Ah! Primeiro, vamos preencher os documentos fiscais. Depois, vamos consertar as telhas quebradas; tem um vazamento na ala leste que está deixando a Vera louca."

# game/script.rpy:1787
translate pt_br_anubisbr scene05_0_807ebfb8:

#   di "Then, if there's time, we'll organize the liquor racks."
    di "Depois, se houver tempo, organizaremos as prateleiras de bebidas."

# game/script.rpy:1789
translate pt_br_anubisbr scene05_0_2b35b6fe:

#   mc "..."
    mc "..."

# game/script.rpy:1791
translate pt_br_anubisbr scene05_0_fba6d952:

#   di "What do you think, darling? Sound like a fun evening?"
    di "O que você acha, querida? Parece uma noite divertida?"

# game/script.rpy:1793
translate pt_br_anubisbr scene05_0_4928b666:

#   mc "I think you're messing with me."
    mc "Acho que você está me zoando."

# game/script.rpy:1795
translate pt_br_anubisbr scene05_0_a0ba6bed:

#   di "A little. I couldn't resist. Your face was so serious."
    di "Um pouquinho. Não resisti. Seu rosto estava tão sério."

# game/script.rpy:1796
translate pt_br_anubisbr scene05_0_f3a4c8c6:

#   di "*ahem* That aside—"
    di "*cof cof* Deixando isso de lado—"

# game/script.rpy:1797
translate pt_br_anubisbr scene05_0_b85924a6:

#   di "I overheard your conversation with Sir Darius."
    di "Ouvi por acaso sua conversa com Sir Darius."

# game/script.rpy:1799
translate pt_br_anubisbr scene05_0_a9aea683:

#   mc "Is that part of your job? Eavesdropping on customers?"
    mc "Isso faz parte do seu trabalho? Espionar conversas de clientes?"

# game/script.rpy:1801
translate pt_br_anubisbr scene05_0_0782fbe9:

#   di "It is, actually. A good hostess knows what her guests need before they ask."
    di "Sim, é verdade. Uma boa anfitriã sabe do que seus convidados precisam antes mesmo que eles peçam."

# game/script.rpy:1802
translate pt_br_anubisbr scene05_0_291ae402:

#   di "So... you had a run-in with that ogre, huh? The one that's been terrorizing the farms for months? You're seriously lucky to get out alive. Most don't."
    di "Então... você se deparou com aquele ogro, hein? Aquele que vem aterrorizando as fazendas há meses? Você teve muita sorte de sair vivo. A maioria não consegue."

# game/script.rpy:1803
translate pt_br_anubisbr scene05_0_d22a59a6:

#   di "Tell me—how did you manage it? I love these kinds of stories! The bloodier the better."
    di "Diga-me, como você conseguiu? Adoro esse tipo de história! Quanto mais sangrenta, melhor."

# game/script.rpy:1806
translate pt_br_anubisbr scene05_0_0b731a69:

#   mc "I managed to defeat it. Just me and the beast."
    mc "Eu consegui derrotá-lo. Só eu e a fera."

# game/script.rpy:1808
translate pt_br_anubisbr scene05_0_1e2d307a:

#   di "No way! On your own?!"
    di "De jeito nenhum! Sozinha?!"

# game/script.rpy:1810
translate pt_br_anubisbr scene05_0_85bb1404:

#   mc "Yes. If only you'd been there—our battle was legendary!"
    mc "Sim. Se você estivesse lá... nossa batalha foi lendária!"

# game/script.rpy:1811
translate pt_br_anubisbr scene05_0_050f3ab5:

#   di "..."
    di "..."

# game/script.rpy:1813
translate pt_br_anubisbr scene05_0_68e33f5e:

#   di "*laughs* Pfft! No you didn't!"
    di "*risos* Pfft! Não, você não fez isso!"

# game/script.rpy:1814
translate pt_br_anubisbr scene05_0_48f9a72f:

#   mc "...What's so funny?"
    mc "...O que é tão engraçado?"

# game/script.rpy:1816
translate pt_br_anubisbr scene05_0_57b6cff4:

#   di "It's written all over you, dear. The way your eyes shifted. The way your voice got just a little too dramatic."
    di "Está estampado em você, querida. No jeito que seus olhos se desviaram. No jeito que sua voz ficou um pouco dramática demais."

# game/script.rpy:1817
translate pt_br_anubisbr scene05_0_637b199e:

#   di "{i}You're lying.{/i}"
    di "{i}Você está mentindo.{/i}"

# game/script.rpy:1820
translate pt_br_anubisbr scene05_0_9c2e60aa:

#   mc "Was I that obvious?"
    mc "Será que fui tão óbvio assim?"

# game/script.rpy:1822
translate pt_br_anubisbr scene05_0_38a50d94:

#   di "Only to someone who's been trained to read people. Don't worry, your secret's safe with me."
    di "Só para alguém que tenha sido treinado para ler as pessoas. Não se preocupe, seu segredo está a salvo comigo."

# game/script.rpy:1823
translate pt_br_anubisbr scene05_0_e7d0caac:

#   di "Trust me, I get it. You could get an audience with the Queen with that story. Maybe even get recruited into her service. A lie like that could change your life."
    di "Acredite, eu entendo. Com essa história, você poderia conseguir uma audiência com a Rainha. Talvez até ser recrutado para o serviço dela. Uma mentira dessas poderia mudar sua vida."

# game/script.rpy:1825
translate pt_br_anubisbr scene05_0_e298365b:

#   mc "Recruit me?"
    mc "Você quer me recrutar?"

# game/script.rpy:1827
translate pt_br_anubisbr scene05_0_fd2aae31:

#   di "Is that not your goal? Don't tell me you're planning on marrying the princess instead?"
    di "Não é esse o seu objetivo? Não me diga que você está planejando se casar com a princesa?"

# game/script.rpy:1828
translate pt_br_anubisbr scene05_0_2aebfe53:

#   di "That's the other way to get close to the crown. Though it's a bit more complicated."
    di "Essa é outra maneira de se aproximar da coroa. Embora seja um pouco mais complicada."

# game/script.rpy:1830
translate pt_br_anubisbr scene05_0_2fef28f1:

#   mc "Wait—you're saying I {i}can{/i} marry the princess? Like, that's an actual option?"
    mc "Espere—você está dizendo que eu {i} pode{/i} Casar com a princesa? Tipo, isso é uma opção real?"

# game/script.rpy:1832
translate pt_br_anubisbr scene05_0_853f53df:

#   di "Well... it's a bit more complicated. She has to actually accept you first, but it's a start!"
    di "Bem... é um pouco mais complicado. Ela precisa te aceitar primeiro, mas já é um começo!"

# game/script.rpy:1834
translate pt_br_anubisbr scene05_0_8fea2db2:

#   mc "Hmm..."
    mc "Hum..."

# game/script.rpy:1836
translate pt_br_anubisbr scene05_0_f8b68e76:

#   di "Ooh~ What's going on in that head of yours?"
    di "Ooh~ O que se passa nessa sua cabeça?"

# game/script.rpy:1838
translate pt_br_anubisbr scene05_0_d9685e17:

#   mc "Just... thinking about my options."
    mc "Só... pensando nas minhas opções."

# game/script.rpy:1840
translate pt_br_anubisbr scene05_0_762a119c:

#   di "I still don't understand how it died. It {i}did{/i} die, right?"
    di "Ainda não entendo como morreu. {i} fez{/i} morrer, certo?"

# game/script.rpy:1842
translate pt_br_anubisbr scene05_0_a47747f1:

#   mc "Yes. A cage... well, you already know—a cage fell on its head and killed it."
    mc "Sim. Uma gaiola... bem, você já sabe—uma gaiola caiu na cabeça dele e o matou."

# game/script.rpy:1844
translate pt_br_anubisbr scene05_0_04737ab5:

#   di "Oh..."
    di "Oh..."

# game/script.rpy:1846
translate pt_br_anubisbr scene05_0_b7d218b5:

#   mc "Disappointed?"
    mc "Decepcionado?"

# game/script.rpy:1848
translate pt_br_anubisbr scene05_0_a82faffc:

#   di "Mhm. I was hoping for something more... extravagant."
    di "Hum. Eu esperava algo mais... extravagante."

# game/script.rpy:1850
translate pt_br_anubisbr scene05_0_fee662cc:

#   mc "That's life."
    mc "É a vida."

# game/script.rpy:1852
translate pt_br_anubisbr scene05_0_a30ab3d7:

#   di "*chuckles* Well, I suppose I've talked enough. Shall we?"
    di "*risos* Bom, acho que já falei demais. Vamos?"

# game/script.rpy:1855
translate pt_br_anubisbr scene05_0_3ffb2904:

#   mc "It started attacking me, so I just kept running. Eventually it struck a tree, and that caused a cage to fall down."
    mc "Começou a me atacar, então continuei correndo. Eventualmente, bateu em uma árvore, e isso fez com que uma gaiola caísse."

# game/script.rpy:1857
translate pt_br_anubisbr scene05_0_e5607dbf:

#   di "A cage? Sorry, go on!"
    di "Uma gaiola? Desculpe, continue!"

# game/script.rpy:1859
translate pt_br_anubisbr scene05_0_339b35b6:

#   mc "It was hanging from a branch. I think the ogre kept it there as a trophy or something."
    mc "Estava pendurado num galho. Acho que o ogro o mantinha ali como um troféu ou algo do tipo."

# game/script.rpy:1860
translate pt_br_anubisbr scene05_0_c69276f2:

#   di "Mhm~?"
    di "Hum?"

# game/script.rpy:1861
translate pt_br_anubisbr scene05_0_0260f401:

#   mc "Anyway, it fell on its head and killed it. The sound its neck made... still gives me shivers."
    mc "Enfim, caiu de cabeça e morreu. O som que o pescoço dela fez... ainda me dá arrepios."

# game/script.rpy:1863
translate pt_br_anubisbr scene05_0_25bf6e9a:

#   di "Ouch. Deserved, I'd say. No one's mourning that thing."
    di "Ai! Bem feito, eu diria. Ninguém está de luto por aquilo."

# game/script.rpy:1864
translate pt_br_anubisbr scene05_0_2d9d5fc5:

#   di "What happened after?"
    di "O que aconteceu depois?"

# game/script.rpy:1866
translate pt_br_anubisbr scene05_0_f00655c9:

#   mc "I... kept running until I found a road. I was terrified. I didn't stop until I was sure it wasn't getting up again."
    mc "Eu... continuei correndo até encontrar uma estrada. Estava apavorada. Só parei quando tive certeza de que não ia se levantar de novo."

# game/script.rpy:1867
translate pt_br_anubisbr scene05_0_46fca762:

#   mc "That's where I met Darius. He found me naked on the side of the road"
    mc "Foi lá que conheci Darius. Ele me encontrou nua na beira da estrada."

# game/script.rpy:1869
translate pt_br_anubisbr scene05_0_5fd0add2:

#   di "I see. Then why's he treating you like his newlywed lover if you weren't the one to kill it?"
    di "Entendi. Então por que ele está te tratando como se você fosse a amante recém-casada, se não foi você quem matou a planta?"

# game/script.rpy:1871
translate pt_br_anubisbr scene05_0_6578ef62:

#   mc "He said something like, 'Even luck can set you on the road to greatness'. I think he believes the 'gods' put me there for a reason."
    mc "Ele disse algo como: \"Até a sorte pode te colocar no caminho da grandeza\". Acho que ele acredita que os \"deuses\" me colocaram lá por um motivo."

# game/script.rpy:1873
translate pt_br_anubisbr scene05_0_8593eff1:

#   di "*laughs* That's Darius, alright. I think he's just trying to recruit you as a guard."
    di "*risos* Esse é o Darius, com certeza. Acho que ele só está tentando te recrutar como guarda."

# game/script.rpy:1875
translate pt_br_anubisbr scene05_0_b99aeb8c:

#   mc "Why would he do that?"
    mc "Por que ele faria isso?"

# game/script.rpy:1877
translate pt_br_anubisbr scene05_0_03757c27:

#   di "Why wouldn't he? You look like a capable young man—handsome, muscular... what's not to love?"
    di "Por que não? Você parece um jovem capaz — bonito, musculoso... o que não amar?"

# game/script.rpy:1819
translate pt_br_anubisbr scene05_0_2b35b6fe_1:

#   mc "..."
    mc "..."

# game/script.rpy:1878
translate pt_br_anubisbr scene05_0_a30ab3d7_1:

#   di "*chuckles* Well, I suppose I've talked enough. Shall we?"
    di "*risos* Bom, acho que já falei demais. Vamos?"

# game/script.rpy:1883
translate pt_br_anubisbr scene05_choice05_op2_17ddd2a1:

#   mc "You're really beautiful, Diana."
    mc "Você é realmente linda, Diana."

# game/script.rpy:1885
translate pt_br_anubisbr scene05_choice05_op2_37ff616a:

#   di "Oh~! Trying to get me in the mood, are you? Flattery will get you everywhere, darling."
    di "Oh! Está tentando me deixar no clima, é? Elogios te levam longe, querido."

# game/script.rpy:1887
translate pt_br_anubisbr scene05_choice05_op2_2c375859:

#   mc "Seriously. You're one of the most beautiful women I've ever seen. And I'm not just saying that because of... you know."
    mc "Sério. Você é uma das mulheres mais lindas que eu já vi. E não estou dizendo isso só por causa de... você sabe."

# game/script.rpy:1889
translate pt_br_anubisbr scene05_choice05_op2_f8cee267:

#   di "I see... thank you~ You're not too bad yourself, [mc]."
    di "Entendi... obrigada! Você também não é nada mal. [mc]."

# game/script.rpy:1891
translate pt_br_anubisbr scene05_choice05_op2_b0fbd0c3:

#   mc "This work you do... it's not permanent, is it?"
    mc "Esse trabalho que você faz... não é permanente, né?"

# game/script.rpy:1893
translate pt_br_anubisbr scene05_choice05_op2_c15e4e13:

#   di "I mean... hopefully not. A girl's got dreams."
    di "Quer dizer... espero que não. Uma garota tem sonhos."

# game/script.rpy:1895
translate pt_br_anubisbr scene05_choice05_op2_ce3d465c:

#   mc "Then maybe one day, I'll take you out of here. When things settle. When I figure out what I'm doing in this world."
    mc "Então, talvez um dia, eu te tire daqui. Quando as coisas se acalmarem. Quando eu descobrir o que estou fazendo neste mundo."

# game/script.rpy:1897
translate pt_br_anubisbr scene05_choice05_op2_9acf6f38:

#   di "Careful, [mc]... or I might actually start falling for you. *giggles* And that would be terribly inconvenient for both of us."
    di "Cuidadoso, [mc]...ou eu posso acabar me apaixonando por você. *risos* E isso seria terrivelmente inconveniente para nós dois."

# game/script.rpy:1898
translate pt_br_anubisbr scene05_choice05_op2_9783fd60:

#   di "*ahem* Now, just sit back and relax, darling. No more words."
    di "*cof cof* Agora, sente-se e relaxe, querida. Sem mais palavras."

# game/script.rpy:1902
translate pt_br_anubisbr scene05_choice05_op1_37762913:

#   mc "Do your thing, girl."
    mc "Arrasa, garota."

# game/script.rpy:1904
translate pt_br_anubisbr scene05_choice05_op1_49171fe0:

#   di "*snickers* Straight to the point, fine by me."
    di "*risinhos* Direto ao ponto, perfeito para mim."

# game/script.rpy:1913
translate pt_br_anubisbr scene05_diana_scene_7904acda:

#   di "Hahh... That was... ahh... wonderful, [mc]."
    di "Hahh... Isso foi... ahh... maravilhoso, [mc]."

# game/script.rpy:1914
translate pt_br_anubisbr scene05_diana_scene_12630462:

#   di "Sorry for collapsing on you like this. I guess I'm just so tired from working all day."
    di "Desculpe por ter surtado assim. Acho que estou muito cansada de trabalhar o dia todo."

# game/script.rpy:1919
translate pt_br_anubisbr scene05_choice06_op2_5965d6ec:

#   mc "You should leave, Diana. I think we're finished here."
    mc "Você deveria ir embora, Diana. Acho que terminamos por aqui."

# game/script.rpy:1921
translate pt_br_anubisbr scene05_choice06_op2_257da5b7:

#   di "Oh, come on... can't we at least cuddle first?"
    di "Ah, qual é... não podemos pelo menos nos abraçar primeiro?"

# game/script.rpy:1923
translate pt_br_anubisbr scene05_choice06_op2_122a1e7a:

#   mc "I'd rather sleep."
    mc "Eu prefiro dormir."

# game/script.rpy:1925
translate pt_br_anubisbr scene05_choice06_op2_0c970ca0:

#   di "I... understand."
    di "Eu entendo."

# game/script.rpy:1927
translate pt_br_anubisbr scene05_choice06_op2_994a88a7:

#   di "Sleep well, [mc]."
    di "Durma bem, [mc]."

# game/script.rpy:1929
