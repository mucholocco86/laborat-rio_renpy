translate pt_br_anubisbr scene29_choice05_op1_6fcf12f1:

#   perception "You toss him a coin, and it slips awkwardly between his legs, making a soft clink on the ground."
    perception "Você joga uma moeda para ele, e ela escorrega desajeitadamente entre as pernas dele, fazendo um leve tilintar no chão."

# game/script.rpy:8339
translate pt_br_anubisbr scene29_choice05_op1_c4c29dd6:

#   begger "*cough* Oh, bless you, sir! May fortune follow your steps."
    begger "*tosse* Oh, que Deus o abençoe, senhor! Que a fortuna o acompanhe."

# game/script.rpy:8344
translate pt_br_anubisbr scene29_choice05_op1_ed29c6f2:

#   perception "{color=#4A90E2}You pat your pockets, but they're disappointingly light.{/color}"
    perception "{color=#4A90E2}Você apalpa os bolsos, mas eles estão decepcionantemente vazios.{/color}"

# game/script.rpy:8349
translate pt_br_anubisbr scene29_choice05_op2_4a6b718b:

#   perception "The man falls silent, his eyes cast downward again."
    perception "O homem fica em silêncio, com os olhos voltados para baixo novamente."

# game/script.rpy:8358
translate pt_br_anubisbr scene29_continue_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/script.rpy:8361
translate pt_br_anubisbr scene29_continue_c7a7a2ff:

#   mc "(Didn't Darius say that this isn't allowed in Irda? Or maybe this is something else?)"
    mc "(Darius não disse que isso não é permitido em Irda? Ou talvez seja outra coisa?)"

# game/script.rpy:8363
translate pt_br_anubisbr scene29_continue_207e8307:

#   mc "(I guess that's common around here...)"
    mc "(Acho que isso é comum por aqui...)"

# game/script.rpy:8365
translate pt_br_anubisbr scene29_continue_d2b94940:

#   mc "(And there's Nadia. Hopefully her business is doing better now.)"
    mc "(E ali está a Nadia. Espero que os negócios dela estejam indo melhor agora.)"

# game/script.rpy:8366
translate pt_br_anubisbr scene29_continue_79700be4:

#   mc "(I guess I could check her out... or see what that merchant's about.)"
    mc "(Acho que eu poderia dar uma olhada nela... ou ver do que se trata aquele comerciante.)"

# game/script.rpy:8373
translate pt_br_anubisbr scene29_choice06_op1_34cc10c5:

#   ml "Get your fresh milk right here! Straight from the farm this morning!"
    ml "Adquira seu leite fresco aqui mesmo! Diretamente da fazenda, esta manhã!"

# game/script.rpy:8374
translate pt_br_anubisbr scene29_choice06_op1_f270e279:

#   mc "Hey, Nadia!"
    mc "Olá, Nadia!"

# game/script.rpy:8376
translate pt_br_anubisbr scene29_choice06_op1_301f1705:

#   ml "[mc]! You nearly gave me a heart attack this morning. I woke up and you weren't there."
    ml "[mc] Você quase me matou do coração hoje de manhã. Acordei e você não estava lá."

# game/script.rpy:8378
translate pt_br_anubisbr scene29_choice06_op1_81608c30:

#   mc "Ah, sorry. Had to slip out early."
    mc "Ah, desculpe. Tive que sair mais cedo."

# game/script.rpy:8380
translate pt_br_anubisbr scene29_choice06_op1_57ebada4:

#   ml "Of course. Everyone's got their own path these days."
    ml "Claro. Cada um tem seu próprio caminho hoje em dia."

# game/script.rpy:8381
translate pt_br_anubisbr scene29_choice06_op1_09aa212e:

#   ml "Still... it's good to see you again. I was worried."
    ml "Mesmo assim... é bom te ver de novo. Eu estava preocupado."

# game/script.rpy:8383
translate pt_br_anubisbr scene29_choice06_op1_4168b268:

#   mc "Same here. How've you been? Business treating you any better?"
    mc "Eu também. Como você tem passado? Os negócios estão melhores?"

# game/script.rpy:8385
translate pt_br_anubisbr scene29_choice06_op1_b4358b97:

#   ml "We'll get to that... but first—what about you? Did you find a place to stay, or are you still wandering like a stray cat?"
    ml "Chegaremos lá... mas primeiro, e você? Encontrou um lugar para ficar ou ainda está vagando como um gato de rua?"

# game/script.rpy:8387
translate pt_br_anubisbr scene29_choice06_op1_f1aa30c4:

#   mc "Actually, the Queen herself is letting me stay at the castle. I've got a room and everything."
    mc "Na verdade, a própria Rainha está me permitindo ficar no castelo. Tenho um quarto e tudo mais."

# game/script.rpy:8389
translate pt_br_anubisbr scene29_choice06_op1_c03849a6:

#   ml "T-The Queen!? [mc]... you never told me you had ties to Her Majesty!"
    ml "A Rainha!? [mc]... você nunca me disse que tinha ligações com Sua Majestade!"

# game/script.rpy:8390
translate pt_br_anubisbr scene29_choice06_op1_bf63db5a:

#   ml "I-I let a man connected to the royal court sleep on a bunch of blankets! I hit him with a broom!"
    ml "Deixei um homem ligado à corte real dormir em um monte de cobertores! Bati nele com uma vassoura!"

# game/script.rpy:8392
translate pt_br_anubisbr scene29_choice06_op1_a4f35d4d:

#   mc "*chuckles* It's a long story, but remember the ogre? The one that was terrorizing the farms?"
    mc "*risos* É uma longa história, mas vocês se lembram do ogro? Aquele que estava aterrorizando as fazendas?"

# game/script.rpy:8394
translate pt_br_anubisbr scene29_choice06_op1_a369d55d:

#   ml "Mhm. The whole market was buzzing about it. Even had a celebration."
    ml "Sim. O mercado inteiro estava em polvorosa com isso. Até fizeram uma comemoração."

# game/script.rpy:8397
translate pt_br_anubisbr scene29_choice06_op1_b86c105c:

#   mc "Well, I was the one who brought it down."
    mc "Bem, fui eu quem o derrubou."

# game/script.rpy:8399
translate pt_br_anubisbr scene29_choice06_op1_34cf90d4:

#   mc "I had... something to do with it."
    mc "Eu tive... alguma participação nisso."

# game/script.rpy:8401
translate pt_br_anubisbr scene29_choice06_op1_f645046f:

#   ml "*laughs* Are you serious? Gods above, and to think I was housing the hero of the market this whole time."
    ml "*risos* Você está falando sério? Meu Deus, e pensar que eu estava abrigando o herói do mercado esse tempo todo."

# game/script.rpy:8404
translate pt_br_anubisbr scene29_choice06_op1_28e85426:

#   mc "Thank you. It's a lot to live up to. Everyone expects me to kill something else now..."
    mc "Obrigado. É uma grande responsabilidade. Agora todos esperam que eu mate mais alguma coisa..."

# game/script.rpy:8406
translate pt_br_anubisbr scene29_choice06_op1_4cbd80d9:

#   mc "I'm no hero. Just stupid luck, really. But enough about me."
    mc "Não sou nenhum herói. Só tive sorte, na verdade. Mas chega de falar de mim."

# game/script.rpy:8407
translate pt_br_anubisbr scene29_choice06_op1_cb28d7dc:

#   mc "How's your little shop going?"
    mc "Como vai sua lojinha?"

# game/script.rpy:8409
translate pt_br_anubisbr scene29_choice06_op1_2fa7d042:

#   ml "*sigh* ...Afraid it's the same as always."
    ml "*Suspiro* ...Receio que seja como sempre."

# game/script.rpy:8410
translate pt_br_anubisbr scene29_choice06_op1_4da6aec6:

#   ml "Barely any customers today. My canisters are still full and if they don't get sold soon they might spoil."
    ml "Hoje quase não houve clientes. Meus recipientes ainda estão cheios e, se não forem vendidos logo, podem estragar."

# game/script.rpy:8411
translate pt_br_anubisbr scene29_choice06_op1_48c60c04:

#   ml "I can't afford to lose another batch. The last one I had to throw out cost me a week's earnings."
    ml "Não posso me dar ao luxo de perder outro lote. O último que tive que jogar fora me custou o salário de uma semana."

# game/script.rpy:8414
translate pt_br_anubisbr scene29_choice06_op1_a3e380da:

#   mc "Well, I promised to help, didn't I? Just point me in the direction of this Abel guy."
    mc "Bem, eu prometi ajudar, não prometi? Só me indique onde está esse tal de Abel."

# game/script.rpy:8416
translate pt_br_anubisbr scene29_choice06_op1_34e63392:

#   ml "[mc]... you still remember."
    ml "[mc]... você ainda se lembra."

# game/script.rpy:8418
translate pt_br_anubisbr scene29_choice06_op1_6ad1a838:

#   mc "Of course I do. I don't make promises I don't intend to keep."
    mc "Claro que sim. Não faço promessas que não pretendo cumprir."

# game/script.rpy:8420
translate pt_br_anubisbr scene29_choice06_op1_66ae705b:

#   ml "Thank you. Unfortunately, Able left the city the day after we met—off on some business, I think. But he left one of his goons in charge."
    ml "Obrigado. Infelizmente, Able deixou a cidade no dia seguinte ao nosso encontro — acho que foi a negócios. Mas deixou um de seus capangas no comando."

# game/script.rpy:8421
translate pt_br_anubisbr scene29_choice06_op1_95845124:

#   ml "A man named Viktor. You can find him in the tavern over there. It's the biggest one in this district, can't miss it."
    ml "Um homem chamado Viktor. Você pode encontrá-lo na taverna ali. É a maior deste bairro, impossível não vê-la."

# game/script.rpy:8423
translate pt_br_anubisbr scene29_choice06_op1_f7b0ecc9:

#   mc "Alright. Don't worry, Nadia. I've got this."
    mc "Tudo bem. Não se preocupe, Nadia. Eu resolvo isso."

# game/script.rpy:8425
translate pt_br_anubisbr scene29_choice06_op1_68bf593d:

#   ml "Just... remember, [mc]. Talking. No violence. And if you can somehow bring the price down, I would be forever in your debt."
    ml "Apenas... lembre-se, [mc] Conversa. Sem violência. E se você conseguir baixar o preço de alguma forma, ficarei eternamente em dívida com você."

# game/script.rpy:8427
translate pt_br_anubisbr scene29_choice06_op1_885af7ff:

#   mc "Alright. Sit tight. I'll be back soon."
    mc "Certo. Aguarde um pouco. Já volto."

# game/script.rpy:8430
translate pt_br_anubisbr scene29_choice06_op1_8cdee743:

#   mc "That's rough. That Able guy is still after you, huh?"
    mc "Que barra. Aquele cara, Able, ainda está atrás de você, né?"

# game/script.rpy:8432
translate pt_br_anubisbr scene29_choice06_op1_98564f6a:

#   ml "Mhm... And, um... [mc]? Would you... ould you be so kind as to help me with that? I know it's a lot to ask. You've got your own problems."
    ml "Hum... E, hum... [mc] Você... você seria tão gentil de me ajudar com isso? Eu sei que é muito pedir. Você tem seus próprios problemas."

# game/script.rpy:8433
translate pt_br_anubisbr scene29_choice06_op1_89fdab8a:

#   ml "But Abel's gone from the city for now and he left one of his men in charge. A man named Viktor."
    ml "Mas Abel saiu da cidade por enquanto e deixou um de seus homens no comando. Um homem chamado Viktor."

# game/script.rpy:8434
translate pt_br_anubisbr scene29_choice06_op1_2b4c2cdb:

#   ml "Could you... maybe just go and tell him to stop pressing me? Tell him I'll pay."
    ml "Você poderia... talvez ir lá e dizer para ele parar de me pressionar? Diga a ele que eu pago."

# game/script.rpy:8435
translate pt_br_anubisbr scene29_choice06_op1_a7e0a7fb:

#   ml "I just need him to lower the cut. I can't afford what they're asking, I've barely got enough to feed myself. Please."
    ml "Só preciso que ele abaixe o corte. Não tenho condições de pagar o que estão pedindo, mal tenho o suficiente para me alimentar. Por favor."

# game/script.rpy:8441
translate pt_br_anubisbr scene29_choice00_op1_acf2c0e6:

#   mc "I'll do it."
    mc "Eu farei isso."

# game/script.rpy:8443
translate pt_br_anubisbr scene29_choice00_op1_8b470cf8:

#   ml "Ahh, [mc]... you have no idea how much this means. I've been losing sleep over this."
    ml "Ahh, [mc]...você não faz ideia do quanto isso significa. Tenho perdido o sono por causa disso."

# game/script.rpy:8445
translate pt_br_anubisbr scene29_choice00_op1_739a2a4f:

#   mc "Why not tell him yourself? Cut out the middleman?"
    mc "Por que não contar a ele pessoalmente? Eliminar o intermediário?"

# game/script.rpy:8447
translate pt_br_anubisbr scene29_choice00_op1_3d691b96:

#   ml "I-I can't... I'm too scared, [mc]. The first time they approached, they threatened me so much that I broke down crying..."
    ml "Eu não consigo... Estou com muito medo. [mc] Na primeira vez que se aproximaram, ameaçaram-me tanto que desabei em lágrimas..."

# game/script.rpy:8449
translate pt_br_anubisbr scene29_choice00_op1_9abf0fc3:

#   mc "That's awful!"
    mc "Que horror!"

# game/script.rpy:8451
translate pt_br_anubisbr scene29_choice00_op1_b3b9d1aa:

#   ml "Even after hearing that, [mc]. Talking. No violence. And if you can somehow bring the price down, I would be forever in your debt."
    ml "Mesmo depois de ouvir isso, [mc] Conversa. Sem violência. E se você conseguir baixar o preço de alguma forma, ficarei eternamente em dívida com você."

# game/script.rpy:8453
translate pt_br_anubisbr scene29_choice00_op1_83495ed0:

#   mc "I understand."
    mc "Eu entendo."

# game/script.rpy:8455
translate pt_br_anubisbr scene29_choice00_op1_b27b36a4:

#   ml "Thank you. That tavern is right over there. It's the biggest one in this district, you can't miss it."
    ml "Obrigado. Aquela taverna fica bem ali. É a maior do bairro, impossível não vê-la."

# game/script.rpy:8457
translate pt_br_anubisbr scene29_choice00_op1_885af7ff:

#   mc "Alright. Sit tight. I'll be back soon."
    mc "Certo. Aguarde um pouco. Já volto."

# game/script.rpy:8461
translate pt_br_anubisbr scene29_choice00_op2_8eb153d6:

#   mc "Sorry, Nadia. But I don't want to get involved. I already have so much on my plate."
    mc "Desculpe, Nadia. Mas não quero me envolver. Já tenho muita coisa para fazer."

# game/script.rpy:8463
translate pt_br_anubisbr scene29_choice00_op2_e0404031:

#   ml "...I understand."
    ml "...Eu entendo."

# game/script.rpy:8464
translate pt_br_anubisbr scene29_choice00_op2_fd79eeb0:

#   ml "I shouldn't have asked in the first place. This isn't your burden to carry."
    ml "Eu não deveria ter perguntado desde o início. Esse não é um fardo que você deva carregar."

# game/script.rpy:8466
translate pt_br_anubisbr scene29_choice00_op2_6de264a2:

#   empathy "She forces a small smile to hide her disappointment."
    empathy "Ela força um pequeno sorriso para disfarçar sua decepção."

# game/script.rpy:8468
translate pt_br_anubisbr scene29_choice00_op2_0342c78d:

#   ml "Still... thank you for at least listening."
    ml "Mesmo assim... obrigada por ao menos ter me escutado."

# game/script.rpy:8470
translate pt_br_anubisbr scene29_choice00_op2_76dcd235:

#   mc "Take care of yourself, Nadia. Maybe things will get better on their own."
    mc "Cuide-se, Nadia. Talvez as coisas melhorem por si mesmas."

# game/script.rpy:8472
translate pt_br_anubisbr scene29_choice00_op2_1bcc58ff:

#   ml "You too... [mc]."
    ml "Você também... [mc]."

# game/script.rpy:8482
translate pt_br_anubisbr scene29_choice06_op1_2_ca2c83c3:

#   ml "Actually, wait. Before you go—"
    ml "Na verdade, espere. Antes de ir—"

# game/script.rpy:8484
translate pt_br_anubisbr scene29_choice06_op1_2_25422e14:

#   perception "She reaches for a clean cup and one of her fresh canisters. She pours until the cup nearly brims."
    perception "Ela pega uma xícara limpa e um de seus recipientes novos. Ela despeja o conteúdo até a xícara quase transbordar."

# game/script.rpy:8486
translate pt_br_anubisbr scene29_choice06_op1_2_f7622ed6:

#   ml "Drink. It's on me. I won't take no for an answer!"
    ml "Beba. É por minha conta. Não aceito um não como resposta!"

# game/script.rpy:8493
translate pt_br_anubisbr scene29_choice000_op1_dfbaf511:

#   mc "I can't just take it for free. You're struggling as it is."
    mc "Não posso simplesmente aceitar de graça. Você já está passando por dificuldades."

# game/script.rpy:8495
translate pt_br_anubisbr scene29_choice000_op1_57d3c2da:

#   perception "You slide a bronze coin across the table."
    perception "Você desliza uma moeda de bronze sobre a mesa."

# game/script.rpy:8502
translate pt_br_anubisbr scene29_choice000_op1_cab47912:

#   mc "Here. Is this enough for a cup?"
    mc "Aqui está. Isso é suficiente para uma xícara?"

# game/script.rpy:8504
translate pt_br_anubisbr scene29_choice000_op1_82d7cdda:

#   ml "Aww... you really didn't have to, [mc]."
    ml "Ah... você realmente não precisava, [mc]."

# game/script.rpy:8508
translate pt_br_anubisbr scene29_choice000_op1_dae40a01:

#   mc "It's fine. Gotta support the local businesses somehow."
    mc "Tudo bem. Temos que apoiar os negócios locais de alguma forma."

# game/script.rpy:8511
translate pt_br_anubisbr scene29_choice000_op1_e19db315:

#   mc "*gulps* Ahh..."
    mc "*engole em seco* Ahh..."

# game/script.rpy:8513
translate pt_br_anubisbr scene29_choice000_op1_59cd1e06:

#   ml "What do you think? Be honest."
    ml "O que você acha? Seja sincero."

# game/script.rpy:8515
translate pt_br_anubisbr scene29_choice000_op1_4bf032e5:

#   mc "Pretty good, actually. Would be a shame for it to just sit here and spoil."
    mc "Muito bom, na verdade. Seria uma pena se ficasse aqui parado e estragasse."

# game/script.rpy:8517
translate pt_br_anubisbr scene29_choice000_op1_5ce3fda4:

#   ml "*sigh* Tell me about it... Every day I pour out what doesn't sell. It breaks my heart."
    ml "*suspiro* Nem me fale... Todo dia eu jogo fora o que não vende. Isso me parte o coração."

# game/script.rpy:8519
translate pt_br_anubisbr scene29_choice000_op1_ac046809:

#   mc "Alright, I'm heading over there now. Time to have a chat with this Viktor fellow."
    mc "Certo, estou indo para lá agora. Hora de bater um papo com esse tal de Viktor."

# game/script.rpy:8521
translate pt_br_anubisbr scene29_choice000_op1_eb028aaa:

#   ml "Good luck!"
    ml "Boa sorte!"

# game/script.rpy:8525
translate pt_br_anubisbr scene29_choice000_op1_af73245b:

#   mc "(I don't even have a single coin to give her...)"
    mc "(Não tenho nem uma moeda para lhe dar...)"

# game/script.rpy:8530
translate pt_br_anubisbr scene29_choice000_op2_bb0eeaf4:

#   mc "Thank you."
    mc "Obrigado."

# game/script.rpy:8532
translate pt_br_anubisbr scene29_choice000_op2_e19db315:

#   mc "*gulps* Ahh..."
    mc "*engole em seco* Ahh..."

# game/script.rpy:8534
translate pt_br_anubisbr scene29_choice000_op2_59cd1e06:

#   ml "What do you think? Be honest."
    ml "O que você acha? Seja sincero."

# game/script.rpy:8536
translate pt_br_anubisbr scene29_choice000_op2_4bf032e5:

#   mc "Pretty good, actually. Would be a shame for it to just sit here and spoil."
    mc "Muito bom, na verdade. Seria uma pena se ficasse aqui parado e estragasse."

# game/script.rpy:8538
translate pt_br_anubisbr scene29_choice000_op2_5ce3fda4:

#   ml "*sigh* Tell me about it... Every day I pour out what doesn't sell. It breaks my heart."
    ml "*suspiro* Nem me fale... Todo dia eu jogo fora o que não vende. Isso me parte o coração."

# game/script.rpy:8540
translate pt_br_anubisbr scene29_choice000_op2_ac046809:

#   mc "Alright, I'm heading over there now. Time to have a chat with this Viktor fellow."
    mc "Certo, estou indo para lá agora. Hora de bater um papo com esse tal de Viktor."

# game/script.rpy:8542
translate pt_br_anubisbr scene29_choice000_op2_eb028aaa:

#   ml "Good luck!"
    ml "Boa sorte!"

# game/script.rpy:8549
translate pt_br_anubisbr scene29_choice000_op3_5e9ed5a1:

#   mc "Sorry, Nadia, but no milk for me. Lactose intolerant."
    mc "Desculpe, Nadia, mas nada de leite para mim. Sou intolerante à lactose."

# game/script.rpy:8551
translate pt_br_anubisbr scene29_choice000_op3_76d3ddb7:

#   ml "Lactose... intolerant? I've never heard of that. Is it a curse? A disease?"
    ml "Intolerância à lactose? Nunca ouvi falar disso. É uma maldição? Uma doença?"

# game/script.rpy:8553
translate pt_br_anubisbr scene29_choice000_op3_c2e1bd08:

#   mc "Something like that. My body and milk don't get along."
    mc "Algo assim. Meu corpo e o leite não se dão bem."

# game/script.rpy:8555
translate pt_br_anubisbr scene29_choice000_op3_02c2b813:

#   ml "Oh! Don't even worry about it. I'll remember that for next time."
    ml "Ah! Não se preocupe com isso. Vou me lembrar disso para a próxima vez."

# game/script.rpy:8557
translate pt_br_anubisbr scene29_choice000_op3_ac046809:

#   mc "Alright, I'm heading over there now. Time to have a chat with this Viktor fellow."
    mc "Certo, estou indo para lá agora. Hora de bater um papo com esse tal de Viktor."

# game/script.rpy:8564
translate pt_br_anubisbr scene29_choice06_op1_3_f0e137f7:

#   mc "Hmm? A clown girl?"
    mc "Hum? Uma garota palhaça?"

# game/script.rpy:8566
translate pt_br_anubisbr scene29_choice06_op1_3_c5a0ffc5:

#   perception "She pulls off a few acrobatics that look way too practiced to be just for show. This girl's trained."
    perception "Ela executa algumas acrobacias que parecem muito ensaiadas para serem apenas para exibição. Essa garota é treinada."

# game/script.rpy:8567
translate pt_br_anubisbr scene29_choice06_op1_3_fc2a3846:

#   mc "You're pretty good."
    mc "Você é muito bom."

# game/script.rpy:8569
translate pt_br_anubisbr scene29_choice06_op1_3_4ea5a382:

#   cg "Hahh... Ahhn... Th... thank you. *cough*"
    cg "Hahh... Ahhn... O... obrigado. *tosse*"

# game/script.rpy:8570
translate pt_br_anubisbr scene29_choice06_op1_3_d2ddf62c:

#   mc "Woah, are you sure you can continue like this? Maybe you should take a rest. You look like you're about to collapse."
    mc "Uau, você tem certeza de que consegue continuar assim? Talvez devesse descansar. Você parece prestes a desmaiar."

# game/script.rpy:8571
translate pt_br_anubisbr scene29_choice06_op1_3_7787f821:

#   cg "..."
    cg "..."

# game/script.rpy:8572
translate pt_br_anubisbr scene29_choice06_op1_3_aab5f51a:

#   tom_ "Hey! Can't you see she's working?"
    tom_ "Ei! Você não vê que ela está trabalhando?"

# game/script.rpy:8574
translate pt_br_anubisbr scene29_choice06_op1_3_c8641078:

#   mc "She's tired. Let her rest. Look at her, she can barely stand."
    mc "Ela está cansada. Deixe-a descansar. Olhe para ela, mal consegue ficar de pé."

# game/script.rpy:8576
translate pt_br_anubisbr scene29_choice06_op1_3_8e09d044:

#   tom_ "You tired, girl?"
    tom_ "Você está cansada, garota?"

# game/script.rpy:8578
translate pt_br_anubisbr scene29_choice06_op1_3_912629a2:

#   cg "No, sir! I'm fine. The show must go on."
    cg "Não, senhor! Estou bem. O show tem que continuar."

# game/script.rpy:8579
translate pt_br_anubisbr scene29_choice06_op1_3_0daba760:

#   empathy "Her eyes flicker with fear before hardening into obedience."
    empathy "Seus olhos brilham com medo antes de se endurecerem em obediência."

# game/script.rpy:8581
translate pt_br_anubisbr scene29_choice06_op1_3_2235448b:

#   tom_ "She's fine. See?"
    tom_ "Ela está bem. Viu?"

# game/script.rpy:8582
translate pt_br_anubisbr scene29_choice06_op1_3_f1f907f6:

#   tom_ "Now—what d'you want?"
    tom_ "E agora, o que você quer?"

# game/script.rpy:8584
translate pt_br_anubisbr scene29_choice06_op1_3_71514447:

#   mc "I'm here to see Viktor. I was told he's in charge while Abel's away."
    mc "Vim ver Viktor. Disseram-me que ele está no comando enquanto Abel estiver fora."

# game/script.rpy:8586
translate pt_br_anubisbr scene29_choice06_op1_3_c413eabe:

#   tom_ "Why? Who's asking?"
    tom_ "Por quê? Quem está perguntando?"

# game/script.rpy:8588
translate pt_br_anubisbr scene29_choice06_op1_3_5540ac66:

#   mc "Me. I came on behalf of that woman selling milk. Nadia. The one you've been harassing."
    mc "Eu. Vim em nome daquela mulher que vende leite. Nadia. Aquela que você vem importunando."

# game/script.rpy:8590
translate pt_br_anubisbr scene29_choice06_op1_3_b2bb87f7:

#   tom_ "Her? What, did she finally come to her senses? Took her long enough."
    tom_ "Ela? O quê, finalmente caiu em si? Já estava na hora."

# game/script.rpy:8592
translate pt_br_anubisbr scene29_choice06_op1_3_ddd44dcb:

#   mc "I want you to stop harassing her. She wants to pay. She just needs fair terms."
    mc "Quero que você pare de assediá-la. Ela quer pagar. Ela só precisa de condições justas."

# game/script.rpy:8594
translate pt_br_anubisbr scene29_choice06_op1_3_aea80e20:

#   tom_ "Not here. Follow me."
    tom_ "Não aqui. Siga-me."

# game/script.rpy:8597
translate pt_br_anubisbr scene29_choice06_op1_3_866bd44d:

#   env "The air is thick with the smell of ale, sweat, and smoke clinging to every wooden beam."
    env "O ar está denso com o cheiro de cerveja, suor e fumaça impregnado em cada viga de madeira."

# game/script.rpy:8598
translate pt_br_anubisbr scene29_choice06_op1_3_0df48745:

#   tom_ "Vic, this man wants to talk to you. Says he's here about the milkmaid."
    tom_ "Vic, este homem quer falar com você. Disse que está aqui por causa da leiteira."

# game/script.rpy:8599
translate pt_br_anubisbr scene29_choice06_op1_3_f8377e2b:

#   tom_ "Sit."
    tom_ "Sentar."

# game/script.rpy:8601
translate pt_br_anubisbr scene29_choice06_op1_3_8f86b57e:

#   vic "..."
    vic "..."

# game/script.rpy:8602
translate pt_br_anubisbr scene29_choice06_op1_3_8a8ad37a:

#   mc "I'm—"
    mc "Eu sou-"

# game/script.rpy:8604
translate pt_br_anubisbr scene29_choice06_op1_3_7aa11737:

#   vic "No need. I know who you are, [mc]."
    vic "Não precisa. Eu sei quem você é. [mc]."

# game/script.rpy:8606
translate pt_br_anubisbr scene29_choice06_op1_3_c8cca25d:

#   mc "...Did you know that I was coming here?"
    mc "...Você sabia que eu viria para cá?"

# game/script.rpy:8608
translate pt_br_anubisbr scene29_choice06_op1_3_3c09204f:

#   vic "The market talks. A celebration, an ogre dead. Nobody knew the hand behind it—"
    vic "O mercado fala. Uma celebração, um ogro morto. Ninguém conhecia a mão por trás disso."

# game/script.rpy:8609
translate pt_br_anubisbr scene29_choice06_op1_3_6ce835cd:

#   vic "—until whispers of an outsider under the Queen's roof reached our ears."
    vic "—até que sussurros sobre um forasteiro sob o teto da Rainha chegaram aos nossos ouvidos."

# game/script.rpy:8611
translate pt_br_anubisbr scene29_choice06_op1_3_edc425d8:

#   mc "Did your homework, I see."
    mc "Vejo que você fez a sua lição de casa."

# game/script.rpy:8613
translate pt_br_anubisbr scene29_choice06_op1_3_a06a235b:

#   vic "*chuckles* Nah. The truth always floats to the surface eventually."
    vic "*risos* Não. A verdade sempre acaba vindo à tona."

# game/script.rpy:8614
translate pt_br_anubisbr scene29_choice06_op1_3_01fc3f36:

#   vic "And now here you are, sitting in front of me. My boss, Able, finds you... interesting."
    vic "E agora aqui está você, sentada na minha frente. Meu chefe, Able, te acha... interessante."

# game/script.rpy:8616
translate pt_br_anubisbr scene29_choice06_op1_3_949516be:

#   mc "Me? Why?"
    mc "Eu? Por quê?"

# game/script.rpy:8618
translate pt_br_anubisbr scene29_choice06_op1_3_52bb3093:

#   vic "I just told you why~ *gulp*"
    vic "Eu acabei de te dizer o porquê~ *engole em seco*"

# game/script.rpy:8620
translate pt_br_anubisbr scene29_choice06_op1_3_f6a00878:

#   mc "Well, your boss is mistaken. I didn't kill the ogre. Wrong place, wrong time, nothing more."
    mc "Bem, seu chefe está enganado. Eu não matei o ogro. Lugar errado, hora errada, nada mais."

# game/script.rpy:8622
translate pt_br_anubisbr scene29_choice06_op1_3_d27ef255:

#   vic "Whether you did or didn't, I doubt Able will let such... potential... slip through his fingers."
    vic "Independentemente de você ter feito isso ou não, duvido que Able deixe esse... potencial... escapar por entre os dedos."

# game/script.rpy:8625
translate pt_br_anubisbr scene29_choice06_op1_3_c9faad9c:

#   vic "But enough about that. What is it you truly came here for?"
    vic "Mas chega disso. Afinal, o que te trouxe aqui?"

# game/script.rpy:8627
translate pt_br_anubisbr scene29_choice06_op1_3_c7234a16:

#   mc "I want you to stop harassing that woman selling milk. Nadia. She's terrified."
    mc "Quero que você pare de importunar aquela mulher que está vendendo leite. Nadia. Ela está apavorada."

# game/script.rpy:8628
translate pt_br_anubisbr scene29_choice06_op1_3_69a4f9d1:

#   mc "She can't run her business with your men threatening her customers and spreading lies about her."
    mc "Ela não consegue administrar o negócio dela com os seus homens ameaçando os clientes dela e espalhando mentiras sobre ela."

# game/script.rpy:8630
translate pt_br_anubisbr scene29_choice06_op1_3_5f010125:

#   vic "Nadia? Who...?"
    vic "Nadia? Quem...?"

# game/script.rpy:8631
translate pt_br_anubisbr scene29_choice06_op1_3_37737fe7:

#   vic "Ah! The one with the... interesting outfit. She already refused Able's offer."
    vic "Ah! Aquela com a roupa... interessante. Ela já recusou a oferta de Able."

# game/script.rpy:8633
translate pt_br_anubisbr scene29_choice06_op1_3_b7c9ad55:

#   mc "She'll pay. So leave her be."
    mc "Ela vai pagar. Então deixe-a em paz."

# game/script.rpy:8635
translate pt_br_anubisbr scene29_choice06_op1_3_73010537:

#   vic "Done."
    vic "Feito."

# game/script.rpy:8637
translate pt_br_anubisbr scene29_choice06_op1_3_4c080ad6:

#   mc "And I want you to lower the price for her. She can't afford what you're demanding."
    mc "E eu quero que você baixe o preço para ela. Ela não tem condições de pagar o que você está pedindo."

# game/script.rpy:8639
translate pt_br_anubisbr scene29_choice06_op1_3_eb830d70:

#   vic "*chuckles* Done."
    vic "*risos* Pronto."

# game/script.rpy:8640
translate pt_br_anubisbr scene29_choice06_op1_3_be1bee20:

#   vic "You know what? I feel like you care about her, so... She doesn't have to pay anything anymore."
    vic "Sabe de uma coisa? Eu sinto que você se importa com ela, então... Ela não precisa mais pagar nada."

# game/script.rpy:8642
translate pt_br_anubisbr scene29_choice06_op1_3_3d3b3046:

#   mc "...Really? Just like that?"
    mc "...Sério? Assim, sem mais nem menos?"

# game/script.rpy:8644
translate pt_br_anubisbr scene29_choice06_op1_3_bce7e11f:

#   vic "Why not? You'll find us very... accommodating, [mc]. Despite what the locals say."
    vic "Por que não? Você vai nos achar muito... prestativos. [mc] Apesar do que dizem os moradores locais."

# game/script.rpy:8646
translate pt_br_anubisbr scene29_choice06_op1_3_f95a737c:

#   mc "I don't believe it. No one gives something for nothing. What do you want in return?"
    mc "Não acredito nisso. Ninguém dá nada de graça. O que você quer em troca?"

# game/script.rpy:8648
translate pt_br_anubisbr scene29_choice06_op1_3_c30ff1b9:

#   vic "Sharp. I simply want you to keep your ears open. When my boss returns, there will be work."
    vic "Afiado. Só quero que você fique de ouvidos abertos. Quando meu chefe voltar, haverá trabalho."

# game/script.rpy:8650
translate pt_br_anubisbr scene29_choice06_op1_3_02cb7be4:

#   mc "What kind of work?"
    mc "Que tipo de trabalho?"

# game/script.rpy:8652
translate pt_br_anubisbr scene29_choice06_op1_3_513d6c81:

#   vic "No need to rush. We'll discuss it when the time comes. Nothing binding. Just... a conversation. A handshake between friends."
    vic "Não precisa ter pressa. Conversaremos sobre isso quando chegar a hora. Nada vinculativo. Apenas... uma conversa. Um aperto de mãos entre amigos."

# game/script.rpy:8654
translate pt_br_anubisbr scene29_choice06_op1_3_6049ed30:

#   mc "...Fine. But I'll choose which jobs to take, and which to refuse."
    mc "...Tudo bem. Mas eu vou escolher quais trabalhos aceitar e quais recusar."

# game/script.rpy:8656
translate pt_br_anubisbr scene29_choice06_op1_3_b5f02208:

#   vic "Naturally. No one here deals in chains. Only handshakes."
    vic "Naturalmente. Aqui ninguém usa correntes. Só apertos de mão."

# game/script.rpy:8657
translate pt_br_anubisbr scene29_choice06_op1_3_2b595349:

#   vic "So tell me, [mc]... Are you satisfied?"
    vic "Me conta, [mc]...Você está satisfeito?"

# game/script.rpy:8662
translate pt_br_anubisbr scene29_choice0000_op1_21d60d8b:

#   mc "I am."
    mc "Eu sou."

# game/script.rpy:8664
translate pt_br_anubisbr scene29_choice0000_op1_ca624558:

#   vic "Perfect. Then we'll see each other, sooner or later. The city isn't as large as it seems."
    vic "Perfeito. Então nos veremos, mais cedo ou mais tarde. A cidade não é tão grande quanto parece."

# game/script.rpy:8666
translate pt_br_anubisbr scene29_choice0000_op1_716019b8:

#   mc "Right."
    mc "Certo."

# game/script.rpy:8671
translate pt_br_anubisbr scene29_choice0000_op2_aa58e9d6:

#   mc "The girl outside..."
    mc "A garota lá fora..."

# game/script.rpy:8673
translate pt_br_anubisbr scene29_choice0000_op2_3d477f53:

#   vic "The performer? What about her?"
    vic "A artista? E quanto a ela?"

# game/script.rpy:8675
translate pt_br_anubisbr scene29_choice0000_op2_cd9b3c1a:

#   mc "Yes. She's exhausted. I don't like how she's being treated."
