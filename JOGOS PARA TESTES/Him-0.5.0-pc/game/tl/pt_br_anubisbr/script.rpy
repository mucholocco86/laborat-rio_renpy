translate pt_br_anubisbr scene12_0_68694cb4_1:

#   ava "..."
    ava "..."

# game/script.rpy:4114
translate pt_br_anubisbr scene12_choice01_op1_07b9e472:

#   mc "You're not kidding."
    mc "Você não está brincando."

# game/script.rpy:4115
translate pt_br_anubisbr scene12_choice01_op1_ec81ec9b:

#   adam "Heh. I got a good eye for these things. Twenty years of marriage doesn't make you blind, it just makes you discreet. You learn to appreciate from a distance."
    adam "Heh. Tenho bom olho para essas coisas. Vinte anos de casamento não te deixam cego, apenas te tornam mais discreto. Você aprende a apreciar as coisas à distância."

# game/script.rpy:4117
translate pt_br_anubisbr scene12_choice01_op1_b8c6076f:

#   mc "*chuckles* See you tomorrow, Adam. I gotta... figure out where I'm sleeping tonight."
    mc "*risos* Até amanhã, Adam. Preciso... descobrir onde vou dormir hoje à noite."

# game/script.rpy:4119
translate pt_br_anubisbr scene12_choice01_op1_5179b0d4:

#   adam "Wait, you don't have a place? I thought Her Majesty set you up with that maid... what's her name, Maia?"
    adam "Espere, você não tem um lugar para ficar? Pensei que Sua Majestade tivesse lhe arranjado um emprego com aquela criada... qual o nome dela, Maia?"

# game/script.rpy:4121
translate pt_br_anubisbr scene12_choice01_op1_62a489a8:

#   mc "She did. But we don't have anywhere to actually live. The Queen said we'd 'discuss it later'."
    mc "Sim, ela fez. Mas nós não temos onde morar de fato. A Rainha disse que 'discutiríamos isso mais tarde'."

# game/script.rpy:4123
translate pt_br_anubisbr scene12_choice01_op1_756090ca:

#   adam "Damn... Listen, I'd offer you a bed, but... the wife—yeah, she'd probably have my head. Hope you understand."
    adam "Puxa... Olha, eu te ofereceria uma cama, mas... a esposa... é, ela provavelmente me mataria. Espero que você entenda."

# game/script.rpy:4125
translate pt_br_anubisbr scene12_choice01_op1_7f4736ea:

#   mc "I get it. Don't worry about it, I'll manage."
    mc "Entendo. Não se preocupe, eu dou um jeito."

# game/script.rpy:4127
translate pt_br_anubisbr scene12_choice01_op1_35bc02ab:

#   adam "Well, there's always a tavern. Or a brothel, if you're short on coin and don't mind the company."
    adam "Bem, sempre há uma taverna. Ou um bordel, se você estiver sem dinheiro e não se importar com a companhia."

# game/script.rpy:4128
translate pt_br_anubisbr scene12_choice01_op1_a6b217a9:

#   adam "The Slick Worm is cheap and the beds are somewhat clean. Vera runs a tight ship."
    adam "O Slick Worm é barato e os leitos são relativamente limpos. Vera administra tudo com rigor."

# game/script.rpy:4130
translate pt_br_anubisbr scene12_choice01_op1_f56e3582:

#   mc "Right... I'll keep that in mind."
    mc "Certo... Vou levar isso em consideração."

# game/script.rpy:4132
translate pt_br_anubisbr scene12_choice01_op1_fdf48198:

#   adam "Alright then. Good luck, recruit."
    adam "Muito bem. Boa sorte, recruta."

# game/script.rpy:4137
translate pt_br_anubisbr scene13_0_5ee4a7ac:

#   mc "(Damn my pride... I should've asked him for coin.)"
    mc "(Maldito meu orgulho... Eu devia ter pedido dinheiro a ele.)"

# game/script.rpy:4138
translate pt_br_anubisbr scene13_0_e4a71d3b:

#   mc "(Whatever. I'll just head into town. There's got to be somewhere I can crash.)"
    mc "(Tanto faz. Vou dar um pulo até a cidade. Deve haver algum lugar onde eu possa dormir.)"

# game/script.rpy:4140
translate pt_br_anubisbr scene13_0_d2e081df:

#   perception "The market streets are dimly lit by scattered lanterns, their light flickering across cobblestone slick from a recent rain."
    perception "As ruas do mercado estão tenuemente iluminadas por lanternas espalhadas, cuja luz tremeluzindo sobre o calçamento de pedra escorregadio devido à chuva recente."

# game/script.rpy:4141
translate pt_br_anubisbr scene13_0_88768b6a:

#   mc "(Where to now? *sigh* I could've tried to find Maia, but I don't even know where she sleeps. Some husband I'm turning out to be.)"
    mc "(E agora? *suspiro* Eu poderia ter tentado encontrar Maia, mas nem sei onde ela dorme. Que marido eu estou me tornando.)"

# game/script.rpy:4143
translate pt_br_anubisbr scene13_0_c6282259:

#   begger "Spare a coin for an old soldier, sir?"
    begger "Senhor, teria uma moeda para um velho soldado?"

# game/script.rpy:4144
translate pt_br_anubisbr scene13_0_3c95316e:

#   mc "Me and you both, buddy. I was about to ask you the same thing."
    mc "Eu também, amigo. Eu ia te perguntar a mesma coisa."

# game/script.rpy:4145
translate pt_br_anubisbr scene13_0_9dea87c7:

#   begger "...Huh?"
    begger "...Huh?"

# game/script.rpy:4147
translate pt_br_anubisbr scene13_0_f2555082:

#   mc "This'll do! At least it's not the floor."
    mc "Isso serve! Pelo menos não é o chão."

# game/script.rpy:4149
translate pt_br_anubisbr scene13_0_890aaefd:

#   mc "(I hope Maia gets me a place at the castle... If not, then I'm not sure how I'll survive.)"
    mc "(Espero que Maia consiga um lugar para mim no castelo... Se não, não sei como vou sobreviver.)"

# game/script.rpy:4150
translate pt_br_anubisbr scene13_0_db002b49:

#   mc "(I guess I could wait for the Queen to pay me too. She said I'm working for her now, right?)"
    mc "(Acho que também posso esperar que a Rainha me pague. Ela disse que agora estou trabalhando para ela, certo?)"

# game/script.rpy:4152
translate pt_br_anubisbr scene13_0_8f69cfd0:

#   mc "(I'm so tired... I could sleep for a week.)"
    mc "(Estou tão cansado... que poderia dormir por uma semana.)"

# game/script.rpy:4153
translate pt_br_anubisbr scene13_0_5d005f7b:

#   ml_ "Ahh! A thief!"
    ml_ "Ah! Um ladrão!"

# game/script.rpy:4155
translate pt_br_anubisbr scene13_0_032d5c31:

#   mc "A thief?! Where?!"
    mc "Um ladrão?! Onde?!"

# game/script.rpy:4158
translate pt_br_anubisbr scene13_0_28671acf:

#   mc "Agh!"
    mc "Ah!"

# game/script.rpy:4160
translate pt_br_anubisbr scene13_0_de14397e:

#   mc "What the hell, lady?!"
    mc "Que diabos, senhora?!"

# game/script.rpy:4162
translate pt_br_anubisbr scene13_0_02f792e6:

#   ml_ "Get away from my stall! I've had enough of you thugs trying to rob me blind!"
    ml_ "Saiam da minha barraca! Já chega de vocês, bandidos, tentando me roubar!"

# game/script.rpy:4164
translate pt_br_anubisbr scene13_0_8082005d:

#   mc "Your—? Oh. Sorry, I didn't know."
    mc "Seu—? Ah. Desculpe, eu não sabia."

# game/script.rpy:4166
translate pt_br_anubisbr scene13_0_fe058472:

#   ml_ "Execuse me?"
    ml_ "Com licença?"

# game/script.rpy:4168
translate pt_br_anubisbr scene13_0_dbbdb233:

#   mc "I just wanted to sleep. Didn't realize this... table was yours."
    mc "Eu só queria dormir. Não percebi que esta... mesa era sua."

# game/script.rpy:4169
translate pt_br_anubisbr scene13_0_f0d2fb94:

#   ml_ "..."
    ml_ "..."

# game/script.rpy:4170
translate pt_br_anubisbr scene13_0_aad449db:

#   mc "I'm telling the truth. Check your stuff—I didn't take anything."
    mc "Estou falando a verdade. Verifiquem suas coisas — eu não peguei nada."

# game/script.rpy:4172
translate pt_br_anubisbr scene13_0_e1950957:

#   ml_ "...I-I'm sorry. Are you hurt? I hit you pretty hard."
    ml_ "...Me desculpe. Você se machucou? Eu te bati com bastante força."

# game/script.rpy:4174
translate pt_br_anubisbr scene13_0_28bfe27b:

#   mc "I'm fine. What about you? You're trembling."
    mc "Estou bem. E você? Você está tremendo."

# game/script.rpy:4175
translate pt_br_anubisbr scene13_0_d95df176:

#   ml_ "Mhmm..."
    ml_ "Hum..."

# game/script.rpy:4176
translate pt_br_anubisbr scene13_0_40bd0739:

#   mc "You need to sit, you look like you'll fall over any second."
    mc "Você precisa se sentar, parece que vai cair a qualquer momento."

# game/script.rpy:4179
translate pt_br_anubisbr scene13_0_86a8a9a6:

#   ml "*sigh* I'm Nadia. And you are?"
    ml "*suspiro* Eu sou Nadia. E você é?"

# game/script.rpy:4182
translate pt_br_anubisbr scene13_0_7105127e:

#   mc "[mc]. And, uh... damn. Your outfit. Just noticed."
    mc "[mc] E, nossa... que roupa. Só reparei agora."

# game/script.rpy:4184
translate pt_br_anubisbr scene13_0_696738a0:

#   ml "Lovely, isn't it? Makes me look like a common streetwalker."
    ml "Adorável, não é? Me faz parecer uma prostituta qualquer."

# game/script.rpy:4186
translate pt_br_anubisbr scene13_0_5fe0d44c:

#   mc "Not quite the word I'd use..."
    mc "Não é bem a palavra que eu usaria..."

# game/script.rpy:4188
translate pt_br_anubisbr scene13_0_1d88e352:

#   ml "It's just to draw in customers. A friend suggested it. Said I'd sell more milk if I looked... appealing."
    ml "É só para atrair clientes. Um amigo sugeriu. Disse que eu venderia mais leite se tivesse uma aparência... atraente."

# game/script.rpy:4190
translate pt_br_anubisbr scene13_0_78b9dd1a:

#   mc "You don't say. So, why were you shaking earlier?"
    mc "Não me diga. Então, por que você estava tremendo mais cedo?"

# game/script.rpy:4192
translate pt_br_anubisbr scene13_0_62e9c1f8:

#   ml "Truth is, [mc]... even after I sold my pride and wore this skimpy outfit, my business is failing. I'm barely breaking even. Most days I don't sell a single canister."
    ml "Na verdade, [mc]... mesmo depois de ter vendido meu orgulho e usado essa roupa reveladora, meu negócio está indo mal. Mal consigo cobrir os custos. Na maioria dos dias, não vendo um único frasco."

# game/script.rpy:4194
translate pt_br_anubisbr scene13_0_0dd93717:

#   mc "Why's that?"
    mc "Por que será?"

# game/script.rpy:4196
translate pt_br_anubisbr scene13_0_2d525641:

#   ml "A man named Abel showed up to me a while back. I'm sure you've heard of him—everyone in this district knows his name."
    ml "Há algum tempo, um homem chamado Abel apareceu para mim. Tenho certeza de que você já ouviu falar dele — todos neste distrito conhecem seu nome."

# game/script.rpy:4198
translate pt_br_anubisbr scene13_0_1321c3cf:

#   mc "Haven't, no. I'm new here. Like {i}very{/i} new."
    mc "Não, ainda não. Sou novo por aqui. Tipo {i} muito{/i} novo."

# game/script.rpy:4200
translate pt_br_anubisbr scene13_0_7b5b968e:

#   ml "Really? Abel's the closest thing this market has to a king. And not the benevolent kind."
    ml "Sério? Abel é o mais próximo que este mercado tem de um rei. E não do tipo benevolente."

# game/script.rpy:4202
translate pt_br_anubisbr scene13_0_24d463a5:

#   mc "What's his deal? Is he extorting you?"
    mc "Qual é a dele? Ele está te extorquindo?"

# game/script.rpy:4204
translate pt_br_anubisbr scene13_0_81fbbe29:

#   ml "Not exaggerating—he basically owns this market. He demanded I pay him a cut just for selling my milk here."
    ml "Sem exageros — ele praticamente é dono deste mercado. Ele exigiu que eu lhe pagasse uma comissão só por vender meu leite aqui."

# game/script.rpy:4206
translate pt_br_anubisbr scene13_0_52bb10b1:

#   mc "And you refused?"
    mc "E você se recusou?"

# game/script.rpy:4208
translate pt_br_anubisbr scene13_0_21b7ecde:

#   ml "Exactly. He owns the shops, not the streets. I'm not giving that bastard a single copper for the privilege of standing on public cobblestone."
    ml "Exatamente. Ele é dono das lojas, não das ruas. Não vou dar um centavo sequer para aquele desgraçado pelo privilégio de pisar em paralelepípedos públicos."

# game/script.rpy:4210
translate pt_br_anubisbr scene13_0_327115dd:

#   mc "Good on you for standing up to him."
    mc "Parabéns por ter se posicionado contra ele."

# game/script.rpy:4212
translate pt_br_anubisbr scene13_0_0a40897c:

#   ml "Heh. And look where it's gotten me... haven't sold a single canister since. Three weeks of standing here in this ridiculous outfit"
    ml "Heh. E olha só onde isso me levou... não vendi uma única lata desde então. Três semanas parado aqui com essa roupa ridícula."

# game/script.rpy:4214
translate pt_br_anubisbr scene13_0_4eb1a189:

#   mc "How's that possible? You're still here."
    mc "Como isso é possível? Você ainda está aqui."

# game/script.rpy:4216
translate pt_br_anubisbr scene13_0_b1ce8e25:

#   ml "He has... methods to keep people away. He would tell his goons to spread lies, say that my milk is spoiled and all."
    ml "Ele tem... métodos para manter as pessoas afastadas. Ele mandava seus capangas espalharem mentiras, dizendo que meu leite estava estragado e coisas do tipo."

# game/script.rpy:4217
translate pt_br_anubisbr scene13_0_067d6c7d:

#   ml "He will go even as far to threaten people who come near me."
    ml "Ele chega ao ponto de ameaçar pessoas que se aproximam de mim."

# game/script.rpy:4222
translate pt_br_anubisbr scene13_choice04_op2_60aa0c21:

#   mc "Sounds tough."
    mc "Parece difícil."

# game/script.rpy:4224
translate pt_br_anubisbr scene13_choice04_op2_85681530:

#   ml "*chuckles* It is. Look at me, talking your ear off. You came here to sleep, and I've been dumping my problems on you for ten minutes."
    ml "*risos* É mesmo. Olha só pra mim, falando pelos cotovelos. Você veio aqui pra dormir, e eu já estou despejando meus problemas em você há dez minutos."

# game/script.rpy:4225
translate pt_br_anubisbr scene13_choice04_op2_855e0f04:

#   ml "You must think I'm pathetic. Sometimes you need to vent."
    ml "Você deve me achar patético. Às vezes a gente precisa desabafar."

# game/script.rpy:4227
translate pt_br_anubisbr scene13_choice04_op2_ef37c1e9:

#   mc "Hey, I don't mind it."
    mc "Ei, não me importo."

# game/script.rpy:4229
translate pt_br_anubisbr scene13_choice04_op2_3693d4ff:

#   ml "You know what? I feel better already. Guess I just needed someone to talk to."
    ml "Sabe de uma coisa? Já me sinto melhor. Acho que só precisava conversar com alguém."

# game/script.rpy:4230
translate pt_br_anubisbr scene13_choice04_op2_3524f1f3:

#   ml "Alright then. It's getting late—I should head home. What about you? Where are you staying?"
    ml "Certo. Está ficando tarde — acho que devo ir para casa. E você? Onde vai ficar?"

# game/script.rpy:4232
translate pt_br_anubisbr scene13_choice04_op2_66b28758:

#   mc "Actually... I don't have a place to stay for today. That's why I was sleeping here in the first place."
    mc "Na verdade... eu não tenho onde ficar hoje. Foi por isso que acabei dormindo aqui."

# game/script.rpy:4234
translate pt_br_anubisbr scene13_choice04_op2_518291ef:

#   ml "Oh... I see."
    ml "Oh, eu vejo."

# game/script.rpy:4235
translate pt_br_anubisbr scene13_choice04_op2_34c7b9f0:

#   ml "Well, why don't you come with me? My place isn't much, but it's definitely warmer."
    ml "Então, por que você não vem comigo? Meu apartamento não é grande coisa, mas com certeza é mais quentinho."

# game/script.rpy:4237
translate pt_br_anubisbr scene13_choice04_op2_9b9d409a:

#   mc "Your place? You'd really do that?"
    mc "Na sua casa? Você faria mesmo isso?"

# game/script.rpy:4239
translate pt_br_anubisbr scene13_choice04_op2_3fee0f50:

#   ml "Mhm. Call it payback for hitting you on the head."
    ml "Hum. Digamos que foi uma vingança por ele ter te batido na cabeça."

# game/script.rpy:4241
translate pt_br_anubisbr scene13_choice04_op2_57c9c84d:

#   mc "Thank you, Nadia—you just saved my back."
    mc "Obrigada, Nadia — você acabou de salvar minhas costas."

# game/script.rpy:4243
translate pt_br_anubisbr scene13_choice04_op2_d39136cd:

#   ml "*chuckles* It's not far. Come on."
    ml "*risos* Não é longe. Vamos."

# game/script.rpy:4246
translate pt_br_anubisbr scene13_choice04_op2_0ae9bcd0:

#   ""
    ""

# game/script.rpy:4251
translate pt_br_anubisbr scene13_choice04_op1_82b92309:

#   mc "That's terrible! Where is he? I'll put some sense into him."
    mc "Que horror! Onde ele está? Vou dar um jeito nele."

# game/script.rpy:4253
translate pt_br_anubisbr scene13_choice04_op1_b02dccc1:

#   ml "*laughs* Did you not hear me? He's too powerful. You'd be behind bars before you even got close."
    ml "*risos* Você não me ouviu? Ele é poderoso demais. Você estaria atrás das grades antes mesmo de chegar perto."

# game/script.rpy:4255
translate pt_br_anubisbr scene13_choice04_op1_7dbbccd5:

#   mc "I don't care. People like that make me sick."
    mc "Não me importo. Pessoas assim me dão nojo."

# game/script.rpy:4256
translate pt_br_anubisbr scene13_choice04_op1_8e66c522:

#   mc "They prey on the weak because no one ever fights back. Well, I'm here now. And I've got nothing to lose."
    mc "Eles se aproveitam dos fracos porque ninguém revida. Bem, estou aqui agora. E não tenho nada a perder."

# game/script.rpy:4257
translate pt_br_anubisbr scene13_choice04_op1_7a82bd8d:

#   ml "..."
    ml "..."

# game/script.rpy:4259
translate pt_br_anubisbr scene13_choice04_op1_f0838d55:

#   ml "[mc]... Before you do anything stupid, maybe we try the peaceful way first?"
    ml "[mc]...Antes de fazer qualquer besteira, talvez devêssemos tentar o caminho pacífico primeiro?"

# game/script.rpy:4261
translate pt_br_anubisbr scene13_choice04_op1_61dbcf9e:

#   mc "You mean... talking to him?"
    mc "Você quer dizer... conversar com ele?"

# game/script.rpy:4263
translate pt_br_anubisbr scene13_choice04_op1_5f6967bd:

#   ml "Mhm. I don't mind paying him now, but maybe you could convince him to lower his price. I'm too scared to go myself."
    ml "Sim. Não me importo de pagar agora, mas talvez você possa convencê-lo a baixar o preço. Estou com muito medo de ir pessoalmente."

# game/script.rpy:4264
translate pt_br_anubisbr scene13_choice04_op1_2413bdae:

#   ml "But you... you've got fire in your eyes. He might listen to you."
    ml "Mas você... você tem fogo nos olhos. Ele pode te ouvir."

# game/script.rpy:4266
translate pt_br_anubisbr scene13_choice04_op1_acf2c0e6:

#   mc "I'll do it."
    mc "Eu farei isso."

# game/script.rpy:4268
translate pt_br_anubisbr scene13_choice04_op1_cd4c8d92:

#   ml "Thank you, [mc]. You're too kind. And... I'm really sorry for hitting you earlier."
    ml "Obrigado, [mc] Você é muito gentil. E... eu sinto muito por ter te batido mais cedo."

# game/script.rpy:4270
translate pt_br_anubisbr scene13_choice04_op1_f4237f45:

#   mc "That? I took it like a champ. Don't worry about it."
    mc "Isso? Aguentei numa boa. Não se preocupe com isso."

# game/script.rpy:4272
translate pt_br_anubisbr scene13_choice04_op1_a27c138d:

#   ml "*laughs* Alright then. I'll see you tomorrow? You know where to find me—same stall, same ridiculous outfit."
    ml "*risos* Tudo bem então. Te vejo amanhã? Você sabe onde me encontrar — mesma barraca, mesma roupa ridícula."

# game/script.rpy:4274
translate pt_br_anubisbr scene13_choice04_op1_66b28758:

#   mc "Actually... I don't have a place to stay for today. That's why I was sleeping here in the first place."
    mc "Na verdade... eu não tenho onde ficar hoje. Foi por isso que acabei dormindo aqui."

# game/script.rpy:4276
translate pt_br_anubisbr scene13_choice04_op1_7eee2a5c:

#   ml "Oh... I see. Well, why don't you come with me? I've got a spare blanket or two."
    ml "Ah... entendi. Bem, por que você não vem comigo? Tenho um ou dois cobertores extras."

# game/script.rpy:4278
translate pt_br_anubisbr scene13_choice04_op1_9b9d409a:

#   mc "Your place? You'd really do that?"
    mc "Na sua casa? Você faria mesmo isso?"

# game/script.rpy:4280
translate pt_br_anubisbr scene13_choice04_op1_3ea1e954:

#   ml "Mhm. I trust you."
    ml "Sim. Confio em você."

# game/script.rpy:4282
translate pt_br_anubisbr scene13_choice04_op1_2276bfd7:

#   mc "Thank you, Nadia. You just saved my back."
    mc "Obrigada, Nadia. Você acabou de salvar minhas costas."

# game/script.rpy:4284
translate pt_br_anubisbr scene13_choice04_op1_d39136cd:

#   ml "*chuckles* It's not far. Come on."
    ml "*risos* Não é longe. Vamos."

# game/script.rpy:4288
translate pt_br_anubisbr scene13_choice04_op1_0ae9bcd0:

#   ""
    ""

# game/script.rpy:4293
translate pt_br_anubisbr scene13_00_1038f400:

#   mc "Cozy."
    mc "Aconchegante."

# game/script.rpy:4294
translate pt_br_anubisbr scene13_00_dc58dfe6:

#   ml "You think? It's a mess, really. I keep meaning to organize, but the stall takes all my time."
    ml "Você acha? É uma bagunça, na verdade. Eu vivo querendo organizar, mas a garagem está me tomando todo o tempo."

# game/script.rpy:4295
translate pt_br_anubisbr scene13_00_a7d55c98:

#   mc "You live here alone? No roommate? No... partner?"
    mc "Você mora aqui sozinho(a)? Sem colega de quarto? Sem... parceiro(a)?"

# game/script.rpy:4296
translate pt_br_anubisbr scene13_00_1485857b:

#   ml "Mhm. Still haven't found the one, as they say. Hard to meet people when you spend all day worrying about your failing business."
    ml "Hum. Ainda não encontrei a pessoa certa, como se costuma dizer. É difícil conhecer gente nova quando se passa o dia todo preocupado com o fracasso do negócio."

# game/script.rpy:4298
translate pt_br_anubisbr scene13_00_f3676c88:

#   ml "You can sleep there. Sorry I don't have an extra bed."
    ml "Você pode dormir ali. Desculpe, não tenho uma cama extra."

# game/script.rpy:4299
translate pt_br_anubisbr scene13_00_243ccd72:

#   mc "No, you've done more than enough. Thanks again, Nadia."
    mc "Não, você já fez mais do que o suficiente. Obrigada novamente, Nadia."

# game/script.rpy:4300
translate pt_br_anubisbr scene13_00_b0f37177:

#   ml "Don't mention it."
    ml "Não precisa agradecer."

# game/script.rpy:4302
translate pt_br_anubisbr scene13_00_96191ad6:

#   sensation "The pile of blankets sinks under your weight, its warmth cradling you. Their faint floral scent make your eyelids heavier."
    sensation "O monte de cobertores afunda sob o seu peso, seu calor aconchegando você. Seu leve aroma floral faz suas pálpebras pesarem."

# game/script.rpy:4303
translate pt_br_anubisbr scene13_00_84bd6f17:

#   ml "I'll put out the candles."
    ml "Vou apagar as velas."

# game/script.rpy:4304
translate pt_br_anubisbr scene13_00_6df0df2a:

#   mc "Alright. Good night, Nadia."
    mc "Certo. Boa noite, Nadia."

# game/script.rpy:4306
translate pt_br_anubisbr scene13_00_40d2599b:

#   ml "Good night."
    ml "Boa noite."

# game/script.rpy:4310
translate pt_br_anubisbr scene13_00_2ef0fc23:

#   perception "Sunlight spills through the window, stabbing your eyes awake. The distant chatter of market-goers mingles with the cheerful chirping of birds."
    perception "A luz do sol invade a janela, despertando seus olhos. A conversa distante dos frequentadores do mercado se mistura ao alegre chilrear dos pássaros."

# game/script.rpy:4312
translate pt_br_anubisbr scene13_00_80f9b441:

#   mc "Ahh... *yawn*"
    mc "Ah... *bocejo*"

# game/script.rpy:4314
translate pt_br_anubisbr scene13_00_e180282e:

#   mc "Morning, Nadia."
    mc "Bom dia, Nadia."

# game/script.rpy:4315
translate pt_br_anubisbr scene13_00_0d44fbc4:

#   ml "Mmmm..."
    ml "Hummm..."

# game/script.rpy:4319
translate pt_br_anubisbr scene13_choice05_op1_ee7c77d4:

#   mc "You'll catch a cold like this."
    mc "Você vai pegar um resfriado assim."

# game/script.rpy:4326
translate pt_br_anubisbr scene13_choice05_op1_48dab64f:

#   mc "There you go."
    mc "Pronto."

# game/script.rpy:4333
translate pt_br_anubisbr scene13_choice05_op2_2b35b6fe:

#   mc "..."
    mc "..."

# game/script.rpy:4339
translate pt_br_anubisbr scene13_choice05_op2_bf62eafa:

#   mc "(I should leave before I get any ideas...)"
    mc "(Devo ir embora antes que me surjam ideias...)"

# game/script.rpy:4340
translate pt_br_anubisbr scene13_choice05_op2_35768cb3:

#   impulse "You should start suckling on it like a baby."
    impulse "Você deveria começar a mamar nele como um bebê."

# game/script.rpy:4341
translate pt_br_anubisbr scene13_choice05_op2_c52b377c:

#   mc "(Yeah, like that.)"
    mc "(Sim, assim mesmo.)"

# game/script.rpy:4348
translate pt_br_anubisbr scene13_000_5828e2d4:

#   mc "*yawn*"
    mc "*bocejar*"

# game/script.rpy:4351
translate pt_br_anubisbr scene13_000_84d73742:

#   mc "(I should head back to the castle. Try to make some money from the Queen... and also talk to that Abel guy.)"
    mc "(Devo voltar ao castelo. Tentar ganhar algum dinheiro com a Rainha... e também falar com aquele tal de Abel.)"

# game/script.rpy:4353
translate pt_br_anubisbr scene13_000_b269269f:

#   mc "(I should head back to the castle. Try to make some money from the Queen...)"
    mc "(Devo voltar ao castelo. Tentar ganhar algum dinheiro da Rainha...)"

# game/script.rpy:4355
translate pt_br_anubisbr scene13_000_c8cbecb1:

#   mc "(Ah, I forgot to tell her where I was going. Or leave a note. Or—)"
    mc "(Ah, esqueci de lhe dizer para onde ia. Ou deixar um bilhete. Ou—)"

# game/script.rpy:4357
translate pt_br_anubisbr scene13_000_a2cd135a:

#   "*rustle* *rustle*"
    "*farfalhar* *farfalhar*"

# game/script.rpy:4358
translate pt_br_anubisbr scene13_000_05500ff6:

#   mc "Huh?"
    mc "Huh?"

# game/script.rpy:4361
translate pt_br_anubisbr scene13_000_0ae9bcd0:

#   ""
    ""

# game/script.rpy:4366
translate pt_br_anubisbr scene13_000_2b35b6fe:

#   mc "..."
    mc "..."

# game/script.rpy:4367
translate pt_br_anubisbr scene13_000_443070ba:

#   logic "Run."
    logic "Correr."

# game/script.rpy:4373
translate pt_br_anubisbr scene13_000_aeccaf04:

#   sensation "Before you could even react, your whole body turns numb. Your vision fades to black."
    sensation "Antes mesmo que você pudesse reagir, todo o seu corpo fica dormente. Sua visão escurece."

# game/script.rpy:4380
translate pt_br_anubisbr scene13_000_12185f65:

#   girl "See? He's dead. We should call the guards before someone thinks we did it."
    girl "Viram? Ele está morto. Devemos chamar os guardas antes que alguém pense que fomos nós."

# game/script.rpy:4382
translate pt_br_anubisbr scene13_000_07c90ddc:

#   yuuhi_ "He isn't! I just saw him breathing."
    yuuhi_ "Não está! Acabei de vê-lo respirando."

# game/script.rpy:4384
translate pt_br_anubisbr scene13_000_fb03b98e:

#   mc "Wah!"
    mc "Uau!"

# game/script.rpy:4386
translate pt_br_anubisbr scene13_000_229c96f3:

#   mc "You! What the hell did you do to me?!"
    mc "Você! Que diabos você fez comigo?!"

# game/script.rpy:4387
translate pt_br_anubisbr scene13_000_39db23fb:

#   yuuhi_ "..."
    yuuhi_ "..."

# game/script.rpy:4388
translate pt_br_anubisbr scene13_000_f93078f5:

#   mc "Oh... sorry. You're not... you're not her."
    mc "Ah... desculpe. Você não é... você não é ela."

# game/script.rpy:4390
translate pt_br_anubisbr scene13_000_eef1a3b2:

#   mc "Sorry about that. I thought you were someone else."
    mc "Desculpe. Pensei que você fosse outra pessoa."

# game/script.rpy:4392
translate pt_br_anubisbr scene13_000_f7ea0dc8:

#   yuuhi_ "*cough* It's fine. A-Are you alright? Should we bring a healer? You were just lying there in the middle of the alley."
    yuuhi_ "*tosse* Tudo bem. V-Você está bem? Devemos chamar um curandeiro? Você estava ali deitada no meio do beco."

# game/script.rpy:4394
translate pt_br_anubisbr scene13_000_c01aefb3:

#   mc "There's no need for that. I think I just saw a witch... and she cast a spell on me. Knocked me out cold."
    mc "Não precisa disso. Acho que acabei de ver uma bruxa... e ela me enfeitiçou. Me deixou inconsciente."

# game/script.rpy:4395
translate pt_br_anubisbr scene13_000_d72f9fa8:

#   girl "*laughs* He's weird."
    girl "*risos* Ele é estranho."

# game/script.rpy:4397
translate pt_br_anubisbr scene13_000_57acd552:

#   yuuhi_ "Did you say a witch? But witches aren't allowed here. The Queen banished them from the city."
    yuuhi_ "Você disse bruxa? Mas bruxas não são permitidas aqui. A Rainha as baniu da cidade."

# game/script.rpy:4399
translate pt_br_anubisbr scene13_000_96b0c511:

#   mc "Are they ever allowed anywhere? Seems like the kind of thing people say and witches ignore."
    mc "Será que elas são permitidas em algum lugar? Parece ser o tipo de coisa que as pessoas dizem e as bruxas ignoram."

# game/script.rpy:4400
translate pt_br_anubisbr scene13_000_95b28b14:

#   mc "Anyway, she was dragging some poor guy with her."
    mc "Enfim, ela estava arrastando algum coitado junto."

# game/script.rpy:4402
translate pt_br_anubisbr scene13_000_9074058d:

#   yuuhi_ "If that's really true then you should tell the guards."
    yuuhi_ "Se isso for mesmo verdade, você deve avisar os guardas."

# game/script.rpy:4404
translate pt_br_anubisbr scene13_000_e5171fcf:

#   mc "I will. First thing when I get to the castle. Anyway, thanks for waking me up. What are you two doing out here?"
    mc "Sim, irei. Assim que chegar ao castelo. De qualquer forma, obrigado por me acordar. O que vocês dois estão fazendo aqui fora?"

# game/script.rpy:4406
translate pt_br_anubisbr scene13_000_148a1278:

#   yuuhi_ "I was on my way to deliver a shipment to the castle."
    yuuhi_ "Eu estava a caminho do castelo para entregar uma encomenda."

# game/script.rpy:4408
translate pt_br_anubisbr scene13_000_f804020a:

#   mc "The castle?"
    mc "O castelo?"

# game/script.rpy:4409
translate pt_br_anubisbr scene13_000_ebd98699:

#   mc "I'm going there too! Can I go with you? I still don't know my way around this city."
    mc "Eu também vou! Posso ir com você? Ainda não conheço bem esta cidade."

# game/script.rpy:4412
translate pt_br_anubisbr scene13_000_8d56e4c8:

#   yuuhi_ "A-Alright..."
    yuuhi_ "Tudo bem..."

# game/script.rpy:4415
translate pt_br_anubisbr scene13_000_fe5be4b8:

#   girl "Oooh~ I guess I'll leave you two alone, then. Take care, Yuuhi. Don't let the weird man lure you into any dark alleys."
    girl "Oooh~ Acho que vou deixar vocês duas a sós, então. Se cuida, Yuuhi. Não deixe aquele homem estranho te atrair para becos escuros."

# game/script.rpy:4417
translate pt_br_anubisbr scene13_000_2cd1f12f:

#   yuuhi_ "See you, Ria."
    yuuhi_ "Até logo, Ria."

# game/script.rpy:4420
translate pt_br_anubisbr scene13_000_aeda26e9:

#   yuuhi_ "Thank you for helping me carry all this."
    yuuhi_ "Obrigado por me ajudar a carregar tudo isso."

# game/script.rpy:4421
translate pt_br_anubisbr scene13_000_e1ea6b66:

#   yuuhi_ "But... a-are you sure you want to carry {i}all{/i} of it? I don't mind if we split them up between us. I might not look it, but I can handle myself well."
    yuuhi_ "Mas... você tem certeza de que quer carregar? {i} todos{/i} Do que se trata? Não me importo se dividirmos entre nós. Posso não parecer, mas sei me virar bem."

# game/script.rpy:4422
translate pt_br_anubisbr scene13_000_58dd915b:

#   mc "Yeah... Don't worry. It's—ahh... light... work."
    mc "Sim... Não se preocupe. É... ah... leve... trabalho."

# game/script.rpy:4423
translate pt_br_anubisbr scene13_000_d33113f5:

#   sensation "The crates dig into your arms with every step. Your back aches, but you force a grin."
    sensation "A cada passo, os engradados pressionam seus braços. Suas costas doem, mas você força um sorriso."

# game/script.rpy:4424
translate pt_br_anubisbr scene13_000_c48120f4:

#   yuuhi_ "Hehe~ You're so strong."
    yuuhi_ "Hehe~ Você é tão forte."

# game/script.rpy:4426
translate pt_br_anubisbr scene13_000_6fdd0a2c:

#   yuuhi_ "Thanks again for helping me move this stuff... uhm..."
    yuuhi_ "Obrigado novamente por me ajudar a mover essas coisas... hum..."

# game/script.rpy:4428
translate pt_br_anubisbr scene13_000_8fbcde53:

#   mc "It's [mc]."
    mc "Isso é [mc]."

# game/script.rpy:4430
translate pt_br_anubisbr scene13_000_f265bd3a:

#   yuuhi "Good to meet you, [mc]. I'm Yuuhi, at your service."
    yuuhi "Prazer em conhecê-lo(a), [mc] Sou Yuuhi, ao seu dispor."

# game/script.rpy:4432
translate pt_br_anubisbr scene13_000_192c5ecb:

#   mc "Hey, Yuuhi. What service is that?"
    mc "Ei, Yuuhi. Que serviço é esse?"

# game/script.rpy:4434
translate pt_br_anubisbr scene13_000_020d7cd2:

#   yuuhi "I'm a tailor! If you ever need new clothes, or armor repairs, or anything stitched or hemmed, you come to me."
    yuuhi "Sou alfaiate! Se precisar de roupas novas, consertos de armaduras, costuras ou bainhas, venha falar comigo."

# game/script.rpy:4435
translate pt_br_anubisbr scene13_000_3f7c28df:

#   yuuhi "I'll give you a discount since you helped me with the crates."
    yuuhi "Vou te dar um desconto já que você me ajudou com as caixas."

# game/script.rpy:4437
translate pt_br_anubisbr scene13_000_f22aa2e2:

#   mc "That's good to know. I might visit you one day."
    mc "Que bom saber disso. Talvez eu te visite um dia."

# game/script.rpy:4439
translate pt_br_anubisbr scene13_000_eec8ee58:

#   yuuhi "I look forward to that!"
    yuuhi "Estou ansioso por isso!"

# game/script.rpy:4440
translate pt_br_anubisbr scene13_000_4bd1ce50:

#   yuuhi "And umm... before you go. I saw you yesterday training in the courtyard with Captain Adam."
    yuuhi "E hum... antes de você ir. Eu vi você ontem treinando no pátio com o Capitão Adam."

# game/script.rpy:4442
translate pt_br_anubisbr scene13_000_6651c6dd:

#   mc "Oh... that's embarrassing."
    mc "Oh... que vergonha."

# game/script.rpy:4444
translate pt_br_anubisbr scene13_000_12ee70e0:

#   yuuhi "Why were you so far from the castle? *laughs* Was your fighting so abysmal they kicked you out? Did they throw you over the wall?"
    yuuhi "Por que você estava tão longe do castelo? *risos* Seu desempenho em combate foi tão ruim que te expulsaram? Te jogaram por cima do muro?"

# game/script.rpy:4446
translate pt_br_anubisbr scene13_000_10e8df42:

#   mc "Haha, very funny. But no. I was just... taking a walk."
    mc "Haha, muito engraçado. Mas não. Eu estava apenas... dando uma caminhada."

# game/script.rpy:4448
translate pt_br_anubisbr scene13_000_6a9a6f34:

#   yuuhi "Hehe~ Don't worry, I was only teasing."
    yuuhi "Hehe~ Não se preocupe, eu estava só brincando."

# game/script.rpy:4450
translate pt_br_anubisbr scene13_000_96a10251:

#   mc "Anyway, see you, Yuuhi. I gotta talk to the Queen."
    mc "Enfim, até logo, Yuuhi. Preciso falar com a Rainha."

# game/script.rpy:4452
translate pt_br_anubisbr scene13_000_4aa45670:

#   yuuhi "Farewell! May your stitches never tear and your armor never rust!"
    yuuhi "Adeus! Que seus pontos jamais se rompam e sua armadura jamais enferruje!"

# game/script.rpy:4454
translate pt_br_anubisbr scene13_000_78bf7cac:

#   mc "...That's... oddly specific."
    mc "...Isso é... estranhamente específico."

# game/script.rpy:4456
translate pt_br_anubisbr scene13_000_0dbca9fc:

#   yuuhi "Tailor's blessing! You'll thank me later~"
    yuuhi "A bênção do alfaiate! Você vai me agradecer depois~"

# game/script.rpy:4461
translate pt_br_anubisbr scene13_000_5cca9937:

#   guard "Halt! Beyond this point lies the Queen's inner court. None may pass without leave."
    guard "Pare! Além deste ponto fica o pátio interno da Rainha. Ninguém pode passar sem permissão."

# game/script.rpy:4463
translate pt_br_anubisbr scene13_000_3ec95b81:

#   mc "I need to see the Queen."
    mc "Preciso ver a Rainha."

# game/script.rpy:4465
translate pt_br_anubisbr scene13_000_8af78983:

#   guard "Then show me your identification card and the letter of conduct. It must bear the seal of the royal chancery, approved by the clerk of the household."
    guard "Em seguida, mostre-me seu documento de identidade e a carta de conduta. Ela deve conter o selo da chancelaria real, aprovado pelo escrivão da casa real."

# game/script.rpy:4467
translate pt_br_anubisbr scene13_000_203a5625:

#   mc "Uhh, I have the card but the letter..."
    mc "Hum, eu tenho o cartão, mas a carta..."

# game/script.rpy:4469
translate pt_br_anubisbr scene13_000_7e52551e:

#   alice "Stand down, sergeant. This is the new recruit Her Magesty spoke for."
    alice "Acalme-se, sargento. Este é o novo recruta que Sua Majestade anunciou."

# game/script.rpy:4471
translate pt_br_anubisbr scene13_000_17b98ed5:

#   guard "As you command, Lieutenant. Pass, recruit. And mind your step in the Queen's presence."
    guard "Às suas ordens, tenente. Passe, recruta. E cuidado ao caminhar na presença da Rainha."

# game/script.rpy:4473
translate pt_br_anubisbr scene13_000_3ac5d8b1:

#   mc "Thanks, Alice."
    mc "Obrigada, Alice."

# game/script.rpy:4477
translate pt_br_anubisbr scene13_000_2cb17dbb:

#   q "That district was {i}your{/i} responsibility, Darius."
    q "Aquele distrito era {i} seu{/i} responsabilidade, Darius."

# game/script.rpy:4479
translate pt_br_anubisbr scene13_000_67cb0e5a:

#   d "Yes, Your Majesty. I solemnly apologize. I shall—"
    d "Sim, Vossa Majestade. Peço-lhe as minhas sinceras desculpas. Eu irei—"

# game/script.rpy:4481
translate pt_br_anubisbr scene13_000_44590d62:

#   q "Say it to the poor man who was kidnapped, to his family that are terrified, not me."
    q "Diga isso ao pobre homem que foi sequestrado, à sua família que está apavorada, não a mim."

# game/script.rpy:4482
translate pt_br_anubisbr scene13_000_52d43886:

#   q "I want her found by today. Not a second later. That witch has evaded us for too long."
    q "Quero que a encontrem hoje. Nem um segundo a mais. Essa bruxa nos escapou por tempo demais."

# game/script.rpy:4484
translate pt_br_anubisbr scene13_000_2a203708:

#   q "...Ah. [mc]."
    q "...Ah. [mc]."

# game/script.rpy:4486
translate pt_br_anubisbr scene13_000_8b663e44:

#   mc "Did I arrive at a bad time? I can come back later."
    mc "Cheguei em uma hora ruim? Posso voltar mais tarde."

# game/script.rpy:4487
translate pt_br_anubisbr scene13_000_2e13068f:

#   d "I will do as you command, Your Majesty. The search is already underway."
    d "Farei como Vossa Majestade ordena. As buscas já estão em andamento."

# game/script.rpy:4489
translate pt_br_anubisbr scene13_000_0812c834:

#   q "Halt, Darius."
    q "Pare, Darius."

# game/script.rpy:4490
translate pt_br_anubisbr scene13_000_2af72ba0:

#   q "Adam has informed me of your training performance yesterday, [mc]. He gave me a full report this morning."
    q "Adam me informou sobre seu desempenho no treino de ontem. [mc] Ele me deu um relatório completo esta manhã."

# game/script.rpy:4492
translate pt_br_anubisbr scene13_000_c8d59031:

#   mc "...And what did he say? Please tell me he mentioned the part where I actually hit him."
    mc "...E o que ele disse? Por favor, me diga que ele mencionou a parte em que eu realmente o agredi."

# game/script.rpy:4494
translate pt_br_anubisbr scene13_000_4afa6072:

#   q "That you did well. But I doubt he was fully honest. Adam has a kind heart. Too kind for a man in his position."
    q "Você se saiu bem. Mas duvido que ele tenha sido totalmente honesto. Adam tem um bom coração. Bondade demais para um homem na posição dele."

# game/script.rpy:4495
translate pt_br_anubisbr scene13_000_53fb05a1:

#   q "He also mentioned you were exceptional in hand-to-hand combat. Boxing, he called it."
    q "Ele também mencionou que você era excepcional em combate corpo a corpo. Boxe, como ele chamou."

# game/script.rpy:4497
translate pt_br_anubisbr scene13_000_e2156d1c:

#   mc "I think I might've had experience with boxing before... wherever I came from. It feels very familiar, like muscle memory."
    mc "Acho que já tive alguma experiência com boxe antes... seja lá de onde eu vim. Parece muito familiar, como memória muscular."

# game/script.rpy:4499
translate pt_br_anubisbr scene13_000_fe7751c9:

#   q "Hmm. A useful skill, but not enough. You still need to train with a sword."
    q "Hum. Uma habilidade útil, mas não suficiente. Você ainda precisa treinar com espada."

# game/script.rpy:4501
translate pt_br_anubisbr scene13_000_9ccf36ea:

#   mc "I'm doing my best, Your Majesty."
    mc "Estou fazendo o meu melhor, Vossa Majestade."

# game/script.rpy:4503
translate pt_br_anubisbr scene13_000_7eace131:

#   q "Ava also told me you show no magical potential. None whatsoever."
    q "Ava também me disse que você não demonstra nenhum potencial mágico. Nenhum mesmo."

# game/script.rpy:4505
translate pt_br_anubisbr scene13_000_dad7a8db:

#   mc "That's right..."
    mc "Isso mesmo..."

# game/script.rpy:4507
translate pt_br_anubisbr scene13_000_a5c8f80b:

#   q "However, she did sense something else—an enigma residing deep within you. Something hidden. Immense."
    q "No entanto, ela pressentiu algo mais — um enigma residindo no fundo de você. Algo oculto. Imenso."

# game/script.rpy:4508
translate pt_br_anubisbr scene13_000_6e917b75:

#   q "She couldn't identify it, but she was... unsettled."
    q "Ela não conseguiu identificar o que era, mas estava... inquieta."

# game/script.rpy:4510
translate pt_br_anubisbr scene13_000_46834791:

#   mc "W-What do you mean? She didn't tell me any of this."
    mc "O que você quer dizer? Ela não me disse nada disso."

# game/script.rpy:4512
translate pt_br_anubisbr scene13_000_6faa25ca:

#   q "She couldn't name it, only that it was too powerful to ignore."
    q "Ela não sabia o que era, apenas que era poderoso demais para ser ignorado."

# game/script.rpy:4514
translate pt_br_anubisbr scene13_000_f3dbd388:

#   mc "Then why didn't she tell me that herself?!"
    mc "Então por que ela mesma não me disse isso?!"

# game/script.rpy:4516
translate pt_br_anubisbr scene13_000_7eb6a7be:

#   q "Perhaps she didn't recognize it at the time. Or perhaps she did and was too frightened to speak of it directly."
    q "Talvez ela não tenha percebido na hora. Ou talvez tenha percebido, mas estivesse com muito medo de falar sobre isso diretamente."

# game/script.rpy:4517
translate pt_br_anubisbr scene13_000_00b20b56:

#   q "But it convinces me of one thing—you are indeed too valuable to cast aside."
    q "Mas isso me convence de uma coisa: você é realmente valioso demais para ser descartado."

# game/script.rpy:4519
translate pt_br_anubisbr scene13_000_622449ed:

#   mc "(Would she really have thrown me away if I didn't have that?! I knew there was a catch. This Queen doesn't do charity.)"
    mc "(Será que ela realmente teria me descartado se eu não tivesse isso?! Eu sabia que havia uma pegadinha. Essa rainha não faz caridade.)"

# game/script.rpy:4521
translate pt_br_anubisbr scene13_000_fe75d68f:

#   q "If you haven't heard, a young man was kidnapped recently. A baker's apprentice. The culprit is almost certainly Amelia the Witch."
    q "Caso você não tenha ouvido falar, um jovem foi sequestrado recentemente. Um aprendiz de padeiro. A culpada é quase certamente Amelia, a Bruxa."

# game/script.rpy:4523
translate pt_br_anubisbr scene13_000_a9f5f28e:

#   mc "Wait—I saw her! She attacked me this morning! Right after I stepped outside into the alley."
    mc "Espere—eu a vi! Ela me atacou esta manhã! Logo depois que eu saí para o beco."

# game/script.rpy:4524
translate pt_br_anubisbr scene13_000_d267661a:

#   q "..."
    q "..."

# game/script.rpy:4525
translate pt_br_anubisbr scene13_000_1523fe20:

#   d "..."
    d "..."

# game/script.rpy:4526
translate pt_br_anubisbr scene13_000_6ca34bec:

#   mc "Is something wrong? You're both looking at me like I just grew a second head."
    mc "Tem algo errado? Vocês dois estão me olhando como se eu tivesse acabado de ter duas cabeças."

# game/script.rpy:4528
translate pt_br_anubisbr scene13_000_b9de7ab9:

#   q "Why in the world didn't you stop her, [mc]?!"
    q "Por que diabos você não a impediu? [mc]?!"

# game/script.rpy:4530
translate pt_br_anubisbr scene13_000_eb9d343a:

#   mc "Stop her?! She hit me with a spell before I even moved. I blacked out on the spot."
    mc "Impedir que ela o fizesse?! Ela me atingiu com um feitiço antes mesmo de eu me mexer. Desmaiei na hora."

# game/script.rpy:4531
translate pt_br_anubisbr scene13_000_007e7f5a:

#   mc "I didn't stand a chance."
    mc "Eu não tinha a menor chance."

# game/script.rpy:4533
translate pt_br_anubisbr scene13_000_509832b1:

#   q "*sigh* ...Then the fault is mine."
    q "*suspiro* ...Então a culpa é minha."

# game/script.rpy:4535
translate pt_br_anubisbr scene13_000_731d533f:

#   d "Your Majesty!? The fault fully lies with me—"
    d "Majestade!? A culpa é inteiramente minha—"

# game/script.rpy:4537
translate pt_br_anubisbr scene13_000_4883e647:

#   q "Enough, Darius. He was unprotected. If he'd been properly prepared, things might have gone differently."
    q "Chega, Darius. Ele estava desprotegido. Se estivesse devidamente preparado, as coisas poderiam ter sido diferentes."

# game/script.rpy:4541
translate pt_br_anubisbr scene13_000_806b6bd1:

#   q "That brings me to your first task, [mc]. You will go to the adventurers' guild and meet with Eireen."
    q "Isso me leva à sua primeira tarefa, [mc] Você irá à guilda dos aventureiros e encontrará Eireen."

# game/script.rpy:4543
translate pt_br_anubisbr scene13_000_5541ce96:

#   mc "This is about the witch?"
    mc "Isso tem a ver com a bruxa?"

# game/script.rpy:4545
translate pt_br_anubisbr scene13_000_d1182ac7:

#   q "Yes. I want {i}you{/i} to take responsibility for Amelia. Track her. Stop her, then bring her to justice."
    q "Sim. Eu quero. {i} você{/i} Assumir a responsabilidade por Amelia. Rastreá-la. Impedi-la e, em seguida, levá-la à justiça."

# game/script.rpy:4547
translate pt_br_anubisbr scene13_000_86657ad2:

#   mc "Me? Did you not hear what I just said? She floored me in one second!"
    mc "Eu? Você não ouviu o que eu acabei de dizer? Ela me derrubou em um segundo!"

# game/script.rpy:4549
translate pt_br_anubisbr scene13_000_85335bf2:

#   q "You were caught off guard. Next time, you won't be. And you'll have protection."
    q "Você foi pego de surpresa. Da próxima vez, não será. E você terá proteção."

# game/script.rpy:4551
translate pt_br_anubisbr scene13_000_66fa17ac:

#   mc "Didn't you just say I had some hidden enigma inside me? That I was too valuable to lose? What if I die out there? What if she... turns me into a frog?"
    mc "Você não acabou de dizer que eu tinha um enigma escondido dentro de mim? Que eu era valioso demais para perder? E se eu morrer lá fora? E se ela... me transformar em um sapo?"

# game/script.rpy:4553
translate pt_br_anubisbr scene13_000_206593f3:

#   q "If you fall at the first stone, then the enigma within you was nothing but an illusion. But I don't believe that. Power must be proven, not sheltered."
    q "Se você tropeçar na primeira pedra, então o enigma dentro de você não passava de uma ilusão. Mas eu não acredito nisso. O poder precisa ser provado, não escondido."

# game/script.rpy:4554
translate pt_br_anubisbr scene13_000_91d9d74a:

#   q "What good would it do me if you sat here under our protection?"
    q "Que vantagem teria para mim se você ficasse aqui sob nossa proteção?"

# game/script.rpy:4556
translate pt_br_anubisbr scene13_000_1393f567:

#   mc "...Right. But that doesn't change the fact that she overwhelmed me instantly."
    mc "...Certo. Mas isso não muda o fato de que ela me impressionou instantaneamente."

# game/script.rpy:4558
translate pt_br_anubisbr scene13_000_d3dec034:

#   q "Which is why, after Eireen, you will visit the Dean the blacksmith. His daughter is skilled in forging magic-resistant armor."
    q "Por isso, depois de Eireen, você visitará o Dean, o ferreiro. Sua filha é habilidosa em forjar armaduras resistentes à magia."

# game/script.rpy:4559
translate pt_br_anubisbr scene13_000_02fc3924:

#   q "She will craft you a set. With it, and with guidance, you will not fall so easily again."
    q "Ela vai preparar um conjunto para você. Com ele, e com orientação, você não vai cair tão facilmente de novo."

# game/script.rpy:4561
translate pt_br_anubisbr scene13_000_cc422d0c:

#   mc "I hope it's good enough. For my sake and yours."
    mc "Espero que seja bom o suficiente. Pelo meu bem e pelo seu."

# game/script.rpy:4563
translate pt_br_anubisbr scene13_000_3032bd44:

#   q "That aside, [mc]. Did you bed your wife yet?"
    q "Deixando isso de lado, [mc] Você já foi para a cama com sua esposa?"

# game/script.rpy:4565
translate pt_br_anubisbr scene13_000_88e8737e:

#   mc "...Sorry?"
    mc "...Desculpe?"

# game/script.rpy:4567
translate pt_br_anubisbr scene13_000_bead01c5:

#   q "Have you managed to put a child in her? Maia. The maid I gave you. Is she with child?"
    q "Você conseguiu engravidar ela? Maia. A criada que eu te dei. Ela está grávida?"

# game/script.rpy:4569
translate pt_br_anubisbr scene13_000_87fdd92c:

#   mc "That's... a very strange question. No. I haven't. I barely had time to spend with her."
    mc "Essa é... uma pergunta muito estranha. Não. Eu não tive. Mal tive tempo para passar com ela."

# game/script.rpy:4571
translate pt_br_anubisbr scene13_000_52487b50:

#   q "You kept me waiting so long yesterday. I assumed the two of you were rutting in the baths."
    q "Você me fez esperar tanto ontem. Presumi que vocês dois estivessem transando nos banhos."

# game/script.rpy:4573
translate pt_br_anubisbr scene13_000_09d5e1de:

#   mc "I can't just force myself on her... What if she doesn't even want it yet?"
    mc "Não posso simplesmente me impor a ela... E se ela nem quiser ainda?"

# game/script.rpy:4575
translate pt_br_anubisbr scene13_000_69ca0f84:

#   q "Do not speak to me of want. I gave you that girl for one reason alone: to sire strong heirs."
    q "Não me fale de carência. Eu lhe dei aquela menina por um único motivo: gerar herdeiros fortes."

# game/script.rpy:4576
translate pt_br_anubisbr scene13_000_5cb67ce2:

#   q "Our population dwindles while our enemies multiply. Your wants and hers are secondary to the survival of this kingdom."
    q "Nossa população diminui enquanto nossos inimigos se multiplicam. Seus desejos e os dela são secundários à sobrevivência deste reino."

# game/script.rpy:4577
translate pt_br_anubisbr scene13_000_2a337992:

#   q "Before you leave on your errand, see to her. Get her with child."
    q "Antes de sair para fazer seu recado, veja se ela está bem. Faça com que ela engravide."

# game/script.rpy:4580
translate pt_br_anubisbr scene13_000_a1511048:

#   mc "As you command. But shouldn't I finish my task with the witch first?"
    mc "Como você ordena. Mas não deveria eu terminar minha tarefa com a bruxa primeiro?"

# game/script.rpy:4582
translate pt_br_anubisbr scene13_000_c1897108:

#   q "That witch has unusual ways. She spares her captives, lets them loose after a time... though their minds are broken. A few days will not make a difference."
