#   sl "Thank you for coming, sir! Please, take care."
    sl "Obrigado por ter vindo, senhor! Por favor, cuide-se."

# game/script.rpy:9698
translate pt_br_anubisbr scene29_choice11_ugly_f59ada18:

#   mc "I still have time, might as well check Nadia out."
    mc "Ainda tenho tempo, então posso dar uma olhada no perfil da Nadia."

# game/script.rpy:9706
translate pt_br_anubisbr free_roam_market_4caba414:

#   mc "(Nadia's gone... I guess I could check out that merchant for now.)"
    mc "(Nadia se foi... Acho que posso dar uma olhada naquele comerciante por enquanto.)"

# game/script.rpy:9716
translate pt_br_anubisbr scene30_0ae9bcd0:

#   ""
    ""

# game/script.rpy:9722
translate pt_br_anubisbr scene30_4a4a43dc:

#   mc "(She's always staring through that window...)"
    mc "(Ela está sempre olhando através daquela janela...)"

# game/script.rpy:9718
