# game/script.rpy:12124
translate pt_br_anubisbr scene35_choice04_op2_bb28cb51:

#   r "Huh?! Why?"
    r "Hã?! Por quê?"

# game/script.rpy:12126
translate pt_br_anubisbr scene35_choice04_op2_37bb98b0:

#   mc "Because I want to spend more time with you, duh."
    mc "Porque eu quero passar mais tempo com você, óbvio."

# game/script.rpy:12128
translate pt_br_anubisbr scene35_choice04_op2_d80feae2:

#   r "...Whatever. Do what you want. You made it clear that I can't stop you."
    r "...Tanto faz. Faça o que quiser. Você deixou claro que eu não posso te impedir."

# game/script.rpy:12130
translate pt_br_anubisbr scene35_choice04_op2_5125f6ca:

#   mc "See you, Rebecca!"
    mc "Até logo, Rebecca!"

# game/script.rpy:12131
translate pt_br_anubisbr scene35_choice04_op2_b9b755e5:

#   r "..."
    r "..."

# game/script.rpy:12138
translate pt_br_anubisbr scene35_choice03_op2_9acfd2c0:

#   mc "I'm not gonna do that."
    mc "Eu não vou fazer isso."

# game/script.rpy:12140
translate pt_br_anubisbr scene35_choice03_op2_38c80f10:

#   r "Fine. Then leave."
    r "Ótimo. Então vá embora."

# game/script.rpy:12142
translate pt_br_anubisbr scene35_choice03_op2_c5e3449e:

#   mc "Come on! Is there literally {i}anything{/i} else I can do?"
    mc "Vamos lá! Será que existe mesmo? {i} qualquer coisa{/i} Mais alguma coisa que eu possa fazer?"

# game/script.rpy:12143
translate pt_br_anubisbr scene35_choice03_op2_b9b755e5:

#   r "..."
    r "..."

# game/script.rpy:12145
translate pt_br_anubisbr scene35_choice03_op2_6013738d:

#   r "*sigh* You really don't give up, do you?"
    r "*suspiro* Você realmente não desiste, né?"

# game/script.rpy:12147
translate pt_br_anubisbr scene35_choice03_op2_3fde2ca5:

#   mc "Never. Not until you finally accept me."
    mc "Nunca. Não até que você finalmente me aceite."

# game/script.rpy:12149
translate pt_br_anubisbr scene35_choice03_op2_30a2851e:

#   r "Alright, fine. We're... friends. Happy now?"
    r "Certo, tudo bem. Somos... amigos. Feliz agora?"

# game/script.rpy:12151
translate pt_br_anubisbr scene35_choice03_op2_8c6799b1:

#   mc "Yup! You just made my day, Becky."
    mc "Sim! Você acabou de alegrar meu dia, Becky."

# game/script.rpy:12153
translate pt_br_anubisbr scene35_choice03_op2_69a90b9f:

#   r "Becky? Don't ever call me that again."
    r "Becky? Nunca mais me chame assim."

# game/script.rpy:12155
translate pt_br_anubisbr scene35_choice03_op2_c7a8c34c:

#   mc "Why not? It sounds cute."
    mc "Por que não? Parece uma gracinha."

# game/script.rpy:12157
translate pt_br_anubisbr scene35_choice03_op2_d9f606ef:

#   r "...Just don't. It's... not appropriate."
    r "...Simplesmente não faça isso. Não é apropriado."

# game/script.rpy:12159
translate pt_br_anubisbr scene35_choice03_op2_6ad27adf:

#   mc "Sorry, Becky. But I don't think I will."
    mc "Desculpe, Becky. Mas acho que não vou fazer isso."

# game/script.rpy:12161
translate pt_br_anubisbr scene35_choice03_op2_c8f5b28a:

#   r "Ugh... You're insufferable... I regret this already."
    r "Aff... Você é insuportável... Já me arrependo disso."

# game/script.rpy:12163
translate pt_br_anubisbr scene35_choice03_op2_e204af1a:

#   mc "Heh. Well, I won't annoy you any further. Bye, Becky."
    mc "Heh. Bom, não vou te incomodar mais. Tchau, Becky."

# game/script.rpy:12164
translate pt_br_anubisbr scene35_choice03_op2_b9b755e5_1:

#   r "..."
    r "..."

# game/script.rpy:12175
translate pt_br_anubisbr scene35_part2_01a21285:

#   mc "Eireen, the Queen asked me to talk to you."
    mc "Eireen, a Rainha pediu-me para falar consigo."

# game/script.rpy:12177
translate pt_br_anubisbr scene35_part2_fe457bf3:

#   eireen "Mhm. Listen up."
    eireen "Hum. Escute."

# game/script.rpy:12178
translate pt_br_anubisbr scene35_part2_dfe57fd3:

#   eireen "About a week ago, lord Reiner got his daughter kidnapped by bandits while they were riding in the forest nearby. You may have heard about it."
    eireen "Há cerca de uma semana, a filha do lorde Reiner foi sequestrada por bandidos enquanto cavalgavam na floresta próxima. Talvez você já tenha ouvido falar disso."

# game/script.rpy:12180
translate pt_br_anubisbr scene35_part2_92138d1e:

#   mc "Bandits. Classic."
    mc "Bandidos. Clássico."

# game/script.rpy:12182
translate pt_br_anubisbr scene35_part2_e965ac98:

#   eireen "..."
    eireen "..."

# game/script.rpy:12183
translate pt_br_anubisbr scene35_part2_7cec52a4:

#   mc "Go on..."
    mc "Prossiga..."

# game/script.rpy:12185
translate pt_br_anubisbr scene35_part2_00f6f13c:

#   eireen "Anyway... strange thing is, they didn't take any coin. Just her. Left her father with a nasty gash on his cranium, though."
    eireen "Enfim... o mais estranho é que eles não levaram nenhuma moeda. Só ela. Deixaram o pai dela com um corte feio no crânio, no entanto."

# game/script.rpy:12186
translate pt_br_anubisbr scene35_part2_db6e245c:

#   eireen "We sent out scouts, but they came back with nothing. Not a trace."
    eireen "Enviamos batedores, mas eles voltaram de mãos vazias. Nenhum vestígio."

# game/script.rpy:12188
translate pt_br_anubisbr scene35_part2_ff54bcd6:

#   mc "Weird. No ransom demand?"
    mc "Que estranho. Sem pedido de resgate?"

# game/script.rpy:12190
translate pt_br_anubisbr scene35_part2_7f4172d4:

#   eireen "None so far. Which makes us think it wasn't a standard kidnapping. Someone took her for a reason, and that reason wasn't coin."
    eireen "Até agora, nada. O que nos leva a crer que não foi um sequestro comum. Alguém a levou por algum motivo, e esse motivo não foi dinheiro."

# game/script.rpy:12192
translate pt_br_anubisbr scene35_part2_4b69cdd9:

#   mc "So where do I come in?"
    mc "Então, onde é que eu entro nisso?"

# game/script.rpy:12194
translate pt_br_anubisbr scene35_part2_ae36cd52:

#   eireen "You're going to find her. Lord Reiner isn't the kind of man you want to disappoint."
    eireen "Você vai encontrá-la. Lorde Reiner não é o tipo de homem que você quer decepcionar."

# game/script.rpy:12196
translate pt_br_anubisbr scene35_part2_debc5829:

#   mc "If he's that important then why aren't more people looking for her? Why give it to the new guy?"
    mc "Se ele é tão importante assim, por que mais pessoas não estão procurando por ela? Por que dar o papel para o novato?"

# game/script.rpy:12198
translate pt_br_anubisbr scene35_part2_283dda20:

#   eireen "There are. You're not the only one looking. Half the guards in the city have been assigned to the search."
    eireen "Sim, existem. Você não é o único procurando. Metade dos guardas da cidade foi designada para a busca."

# game/script.rpy:12199
translate pt_br_anubisbr scene35_part2_55f91cb9:

#   eireen "However, if you manage to find her yourself, you'll get the majority of the reward."
    eireen "No entanto, se você conseguir encontrá-la por conta própria, ficará com a maior parte da recompensa."

# game/script.rpy:12201
translate pt_br_anubisbr scene35_part2_bc604ed6:

#   mc "Any leads at least?"
    mc "Alguma pista, pelo menos?"

# game/script.rpy:12203
translate pt_br_anubisbr scene35_part2_cd14dfa7:

#   eireen "Well... no one wants to say it outright, but some folks think she went to see the Queen of Pleasure."
    eireen "Bem... ninguém quer dizer isso abertamente, mas algumas pessoas acham que ela foi visitar a Rainha do Prazer."

# game/script.rpy:12205
translate pt_br_anubisbr scene35_part2_004fed5b:

#   mc "Queen of Pleasure?! That's... that's a real title?"
    mc "Rainha do Prazer?! Isso... isso é um título de verdade?"

# game/script.rpy:12207
translate pt_br_anubisbr scene35_part2_f5b5fc47:

#   eireen "Shhhhh!"
    eireen "Shhhhh!"

# game/script.rpy:12208
translate pt_br_anubisbr scene35_part2_2b35b6fe:

#   mc "..."
    mc "..."

# game/script.rpy:12210
translate pt_br_anubisbr scene35_part2_b1969f49:

#   eireen "But yes... The girl was... let's just say, not your typical noble's daughter. She prefered to stay in the dark."
    eireen "Mas sim... A garota era... digamos que não era a típica filha de um nobre. Ela preferia manter-se na escuridão."

# game/script.rpy:12211
translate pt_br_anubisbr scene35_part2_b1656b5a:

#   eireen "As a matter of fact, it's only recently that we learned he had a daughter."
    eireen "Na verdade, só recentemente ficamos sabendo que ele tinha uma filha."

# game/script.rpy:12213
translate pt_br_anubisbr scene35_part2_be204fa3:

#   mc "Ahuh... So, where do I find this... Queen? And what exactly does she do?"
    mc "Hum... Então, onde eu encontro essa... Rainha? E o que exatamente ela faz?"

# game/script.rpy:12215
translate pt_br_anubisbr scene35_part2_3dd343f3:

#   eireen "Hold on, I have a map of the place somewhere here."
    eireen "Espere um pouco, tenho um mapa do local em algum lugar por aqui."

# game/script.rpy:12217
translate pt_br_anubisbr scene35_part2_83f61c27:

#   eireen "Or was it here?"
    eireen "Ou será que foi aqui?"

# game/script.rpy:12219
translate pt_br_anubisbr scene35_part2_b55f9971:

#   eireen "No, not this one..."
    eireen "Não, não essa..."

# game/script.rpy:12220
translate pt_br_anubisbr scene35_part2_ea1807fd:

#   eireen "There you are!"
    eireen "Aí está!"

# game/script.rpy:12222
translate pt_br_anubisbr scene35_part2_800adc20:

#   eireen "Here. The location is already marked. It's an estate close to our southeastern border. It's a much longer trip than the one to the witch."
    eireen "Aqui. O local já está marcado. É uma propriedade perto da nossa fronteira sudeste. É uma viagem muito mais longa do que a que leva à bruxa."

# game/script.rpy:12224
translate pt_br_anubisbr scene35_part2_55c50e75:

#   mc "Got it. Is there anything I should be worried about?"
    mc "Entendi. Há algo com que eu deva me preocupar?"

# game/script.rpy:12226
translate pt_br_anubisbr scene35_part2_4251f165:

#   eireen "Not really. The Queen of pleasure isn't hostile. She's a businesswoman, first and foremost."
    eireen "Na verdade, não. A Rainha do Prazer não é hostil. Ela é, antes de tudo, uma mulher de negócios."

# game/script.rpy:12227
translate pt_br_anubisbr scene35_part2_a36aab11:

#   eireen "Your job's simple. Go there, ask questions, and find out what she knows. If she's involved, bring the girl back. Alive."
    eireen "Sua tarefa é simples. Vá até lá, faça perguntas e descubra o que ela sabe. Se ela estiver envolvida, traga a garota de volta. Viva."

# game/script.rpy:12229
translate pt_br_anubisbr scene35_part2_fbd0b79c:

#   mc "Bring her alive. Got it."
    mc "Traga-a à vida. Entendido."

# game/script.rpy:12231
translate pt_br_anubisbr scene35_part2_7709a95f:

#   eireen "That's all. Try not to get yourself injured, [mc]."
    eireen "É só isso. Tente não se machucar. [mc]."

# game/script.rpy:12232
translate pt_br_anubisbr scene35_part2_3421a77b:

#   eireen "This task might take longer, but it shouldn't be as dangerous as your hunt for the witch was. Regardless, always proceed with caution."
    eireen "Essa tarefa pode demorar mais, mas não deve ser tão perigosa quanto a sua caçada à bruxa. De qualquer forma, proceda sempre com cautela."

# game/script.rpy:12234
translate pt_br_anubisbr scene35_part2_91cb4ef6:

#   mc "Longer? The witch hunt almost took me two days."
    mc "Mais tempo? A caça às bruxas quase me tomou dois dias."

# game/script.rpy:12235
translate pt_br_anubisbr scene35_part2_980d3d24:

#   mc "Do I have to leave right now? Can I at least say goodbye to a few people first?"
    mc "Preciso ir embora agora? Posso pelo menos me despedir de algumas pessoas antes?"

# game/script.rpy:12237
translate pt_br_anubisbr scene35_part2_5b054b79:

#   eireen "If you want to earn the wrath of Lord Reiner, then by all means."
    eireen "Se você deseja atrair a ira de Lorde Reiner, então vá em frente."

# game/script.rpy:12238
translate pt_br_anubisbr scene35_part2_d8e0f063:

#   eireen "Not to mention that this task is of utmost importance to Her Majesty."
    eireen "Sem mencionar que esta tarefa é da maior importância para Sua Majestade."

# game/script.rpy:12242
translate pt_br_anubisbr scene35_part2_0bbc639f:

#   eireen "*sigh* Oh, don't look at me like that... Fine. Take three days. Prepare yourself if you want."
    eireen "*suspiro* Ah, não me olhe assim... Tudo bem. Leve três dias. Prepare-se se quiser."

# game/script.rpy:12244
translate pt_br_anubisbr scene35_part2_f2a5c6a2:

#   mc "I didn't think you cared about me that much."
    mc "Eu não imaginava que você se importasse tanto comigo."

# game/script.rpy:12246
translate pt_br_anubisbr scene35_part2_025ddb99:

#   eireen "I care about everyone here. I wouldn't be able to sleep at night knowing I sent someone to their death."
    eireen "Eu me importo com todos aqui. Eu não conseguiria dormir à noite sabendo que mandei alguém para a morte."

# game/script.rpy:12247
translate pt_br_anubisbr scene35_part2_989c6fae:

#   eireen "Take three days to rest and prepare yourself... unless, of course, you think you're ready right now?"
    eireen "Tire três dias para descansar e se preparar... a menos, é claro, que você ache que já está pronto agora?"

# game/script.rpy:12240
translate pt_br_anubisbr scene35_part2_2b35b6fe_1:

#   mc "..."
    mc "..."

# game/script.rpy:12252
translate pt_br_anubisbr scene35_choice05_op2_a4888789:

#   mc "I'll take some time first."
    mc "Primeiro, vou precisar de um tempo."

# game/script.rpy:12254
translate pt_br_anubisbr scene35_choice05_op2_0ec0061f:

#   eireen "Alright, I'll postpone your assignment."
    eireen "Muito bem, vou adiar sua tarefa."

# game/script.rpy:12259
translate pt_br_anubisbr scene35_choice05_op1_4c55d73e:

#   mc "I'll go now. I'm ready."
    mc "Vou indo. Estou pronto."

# game/script.rpy:12262
translate pt_br_anubisbr scene35_choice05_op1_cb500041:

#   eireen "I see. This quest shouldn't be as dangerous as the witch's, but still. Take care."
    eireen "Entendo. Essa missão não deve ser tão perigosa quanto a da bruxa, mas mesmo assim... Tome cuidado."

# game/script.rpy:12269
translate pt_br_anubisbr scene35_fin_1ed92865:

#   mc "A river? Why don't we take a little rest, [horse]?"
    mc "Um rio? Que tal descansarmos um pouco? [horse]?"

# game/script.rpy:12271
translate pt_br_anubisbr scene35_fin_b5da96bc:

#   mc "*sigh*"
    mc "*suspirar*"

# game/script.rpy:12275
translate pt_br_anubisbr scene35_choice06_op1_448e1432:

#   logic "You dig deep into your memories, but nothing comes up. It's like your last moments in the previous world has been wiped clean."
    logic "Você mergulha fundo em suas memórias, mas nada vem à tona. É como se seus últimos momentos no mundo anterior tivessem sido apagados."

# game/script.rpy:12276
translate pt_br_anubisbr scene35_choice06_op1_b196b603:

#   empathy "Maybe it's best not to think about it."
    empathy "Talvez seja melhor não pensar nisso."

# game/script.rpy:12279
translate pt_br_anubisbr scene35_choice06_op2_30f25f08:

#   mc "Had enough, [horse]? Come on, let's go."
    mc "Já chega, [horse] Vamos lá, vamos embora."

# game/script.rpy:12282
translate pt_br_anubisbr scene35_choice06_op2_b488965e:

#   "*splash* *splash*"
    "*splash* *splash*"

# game/script.rpy:12284
translate pt_br_anubisbr scene35_choice06_op2_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/script.rpy:12286
translate pt_br_anubisbr scene35_choice06_op2_0ae9bcd0:

#   ""
    ""

# game/script.rpy:12289
translate pt_br_anubisbr scene35_choice06_op2_77e882c8:

#   mc "What the fuck is that!?"
    mc "Que porra é essa!?"

# game/script.rpy:12291
translate pt_br_anubisbr scene35_choice06_op2_988d1289:

#   mc "[horse]! No! Get back here!"
    mc "[horse] Não! Volte aqui!"

# game/script.rpy:12292
translate pt_br_anubisbr scene35_choice06_op2_d51449b1:

#   mc "Goddamnit! Easy quest, my ass!"
    mc "Puta merda! Missão fácil, uma ova!"

# game/script.rpy:12295
translate pt_br_anubisbr scene35_choice06_op2_d11a49ff:

#   mc "Hah! Hahh!"
    mc "Hah! Hahh!"

# game/script.rpy:12299
translate pt_br_anubisbr scene35_choice06_op2_35daba39:

#   mc "Hahh! Hah! Fuck!"
    mc "Hahh! Hah! Foda-se!"

# game/script.rpy:12303
translate pt_br_anubisbr scene35_choice06_op2_6f5184cc:

#   mc "Goddamnit!"
    mc "Droga!"

# game/script.rpy:12312
translate pt_br_anubisbr scene35_choice06_op2_67c3e347:

#   alex_ "Ah!"
    alex_ "Ah!"

# game/script.rpy:12314
translate pt_br_anubisbr scene35_choice06_op2_49559dd3:

#   alex_ "What the—"
    alex_ "Que diabos—"

# game/script.rpy:12315
translate pt_br_anubisbr scene35_choice06_op2_0cdec944:

#   alex_ "Hey! Watch where you're going!"
    alex_ "Ei! Olha por onde anda!"

# game/script.rpy:12316
translate pt_br_anubisbr scene35_choice06_op2_60071d5c:

#   mc "I could say the same to you!"
    mc "Eu poderia dizer o mesmo de você!"

# game/script.rpy:12317
translate pt_br_anubisbr scene35_choice06_op2_1a9cfa38:

#   mc "Wait—no time for that! I need help! There a weird thing chasing me!"
    mc "Espere—não tenho tempo para isso! Preciso de ajuda! Tem uma coisa estranha me perseguindo!"

# game/script.rpy:12319
translate pt_br_anubisbr scene35_choice06_op2_3bf9b0f4:

#   alex_ "A kelpyre? Can you fight?"
    alex_ "Uma alga marinha? Você sabe lutar?"

# game/script.rpy:12320
translate pt_br_anubisbr scene35_choice06_op2_ceb1e0e1:

#   mc "I have a dagger... but my sword is on my horse! She ran off when that thing showed up!"
    mc "Eu tenho uma adaga... mas minha espada está no meu cavalo! Ela fugiu quando aquela coisa apareceu!"

# game/script.rpy:12321
translate pt_br_anubisbr scene35_choice06_op2_c8b1c5fd:

#   alex_ "Shit... Fine. Just stay back."
    alex_ "Merda... Tudo bem. Só fique para trás."

# game/script.rpy:12328
translate pt_br_anubisbr scene35_choice06_op2_5bb04bbc:

#   alex_ "Step back, it's gonna lunge."
    alex_ "Dê um passo para trás, ele vai atacar."

# game/script.rpy:12329
translate pt_br_anubisbr scene35_choice06_op2_3ab180c4:

#   mc "Got it!"
    mc "Entendi!"

# game/script.rpy:12337
translate pt_br_anubisbr scene35_choice06_op2_c85f40c2:

#   mc "...Wow."
    mc "...Uau."

# game/script.rpy:12339
translate pt_br_anubisbr scene35_choice06_op2_1316a4bd:

#   alex_ "Did it get you with its claws? The scratches can fester."
    alex_ "Te arranhou com as garras? Os arranhões podem infeccionar."

# game/script.rpy:12341
translate pt_br_anubisbr scene35_choice06_op2_0bc80bc3:

#   mc "I'm fine. And damn—nice work! I've never seen anyone move that fast."
    mc "Estou bem. E caramba, ótimo trabalho! Nunca vi ninguém se mover tão rápido."

# game/script.rpy:12343
translate pt_br_anubisbr scene35_choice06_op2_f7530331:

#   alex_ "Thanks. They're not very strong, more frightening than dangerous. It was probably chasing your horse, not you."
    alex_ "Obrigado. Eles não são muito fortes, são mais assustadores do que perigosos. Provavelmente estava perseguindo seu cavalo, não você."

# game/script.rpy:12345
translate pt_br_anubisbr scene35_choice06_op2_a31340dd:

#   mc "Really?"
    mc "Realmente?"

# game/script.rpy:12347
translate pt_br_anubisbr scene35_choice06_op2_43af0397:

#   alex_ "They usually go after horses or other animals. Rarely attack humans unless they're desperate."
    alex_ "Eles costumam atacar cavalos ou outros animais. Raramente atacam humanos, a menos que estejam em situação desesperadora."

# game/script.rpy:12349
translate pt_br_anubisbr scene35_choice06_op2_a540e9a4:

#   mc "I see... *sigh* Where did you go, [horse]... I hope she's okay."
    mc "Entendo... *suspiro* Para onde você foi? [horse]... Espero que ela esteja bem."

# game/script.rpy:12351
translate pt_br_anubisbr scene35_choice06_op2_55c6402d:

#   alex_ "So... what are you doing out here? Did you get separated from your group?"
    alex_ "Então... o que você está fazendo aqui fora? Você se separou do seu grupo?"

# game/script.rpy:12353
translate pt_br_anubisbr scene35_choice06_op2_152c91e7:

#   mc "No. I was on my way to—"
    mc "Não. Eu estava a caminho de—"

