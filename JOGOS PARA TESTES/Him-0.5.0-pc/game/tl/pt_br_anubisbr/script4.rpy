translate pt_br_anubisbr scene120_3_c5cb38f4:

#   r "Thank the Gods... Oh mother... I don't know where I would've gone if she was gone."
    r "Graças a Deus... Oh, mãe... Não sei para onde eu teria ido se ela tivesse partido."

# game/script4.rpy:11139
