translate pt_br_anubisbr scene103_choice02_op1_8131ec93:

#   Millicent "Eh. If he loses that easily, he wouldn't have been useful to you anyway."
    Millicent "É. Se ele perde tão facilmente, não teria sido útil para você de qualquer forma."

# game/script4.rpy:398
translate pt_br_anubisbr scene103_choice02_op1_cfde002c:

#   alex "Shut up."
    alex "Cale-se."

# game/script4.rpy:400
translate pt_br_anubisbr scene103_choice02_op1_c617a51c:

#   thulkin "Enough talking! Everyone not involved should move out of our way."
    thulkin "Chega de conversa! Quem não estiver envolvido deve sair do nosso caminho."

# game/script4.rpy:401
translate pt_br_anubisbr scene103_choice02_op1_8b4615d5:

#   thulkin "And you, [mc]. Fight as if you intend to kill."
    thulkin "E você, [mc] Lute como se pretendesse matar."

# game/script4.rpy:406
translate pt_br_anubisbr scene103_4_3e614302:

#   perception "He steps forward, his posture loose but balanced like a predator testing the ground. He hefts his axe, rolling his shoulders."
    perception "Ele avança, com a postura relaxada, mas equilibrada, como um predador testando o terreno. Ele ergue o machado, girando os ombros."

# game/script4.rpy:407
translate pt_br_anubisbr scene103_4_8bbf7770:

#   thulkin "Whenever you're ready."
    thulkin "Quando você estiver pronto."

# game/script4.rpy:410
translate pt_br_anubisbr scene103_4_e4e37fad:

#   mc "HGAHHHH!"
    mc "AAAAAAHHHH!"

# game/script4.rpy:414
translate pt_br_anubisbr scene103_4_d621729a:

#   perception "You lunge forward. Steel meets steel with a sharp clang that echoes through the clearing."
    perception "Você avança com um golpe. Aço encontra aço com um clangor agudo que ecoa pela clareira."

# game/script4.rpy:415
translate pt_br_anubisbr scene103_4_5e8f0d84:

#   thulkin "*laughs* Good! Good!"
    thulkin "*risos* Ótimo! Ótimo!"

# game/script4.rpy:419
translate pt_br_anubisbr scene103_4_49bcf697:

#   thulkin "HANHG!"
    thulkin "HANHG!"

# game/script4.rpy:422
translate pt_br_anubisbr scene103_4_af0a069b:

#   sensation "His swing carries the weight of someone who has fought for decades. Your feel your arms stinging from the impact."
    sensation "Seu golpe carrega o peso de alguém que lutou por décadas. Você sente seus braços arderem com o impacto."

# game/script4.rpy:423
translate pt_br_anubisbr scene103_4_f77ca995:

#   mc "(He's fast but I can... I can read his moves!"
    mc "Ele é rápido, mas eu consigo... consigo prever seus movimentos!"

# game/script4.rpy:425
translate pt_br_anubisbr scene103_4_e22eef87:

#   thulkin "HNGGHHNN!"
    thulkin "HNGGHHNN!"

# game/script4.rpy:429
translate pt_br_anubisbr scene103_4_caa8c8ee:

#   perception "You catch an opening—a split second where his weight shifts too far forward. You twist, redirecting his strike past your shoulder."
    perception "Você aproveita uma brecha — uma fração de segundo em que o peso dele se desloca muito para a frente. Você gira, redirecionando o golpe para além do seu ombro."

# game/script4.rpy:431
translate pt_br_anubisbr scene103_4_4f783bf0:

#   thulkin "Whoa! Almost got me there."
    thulkin "Uau! Quase me enganou."

# game/script4.rpy:433
translate pt_br_anubisbr scene103_4_626eb0dc:

#   mc "You're not taking me seriously."
    mc "Você não está me levando a sério."

# game/script4.rpy:435
translate pt_br_anubisbr scene103_4_0239ac57:

#   thulkin "What makes you say that?"
    thulkin "O que te leva a dizer isso?"

# game/script4.rpy:437
translate pt_br_anubisbr scene103_4_a78ebf28:

#   mc "Your axe... You're holding it with one arm."
    mc "Seu machado... Você está segurando-o com um braço só."

# game/script4.rpy:439
translate pt_br_anubisbr scene103_4_a5713c6e:

#   thulkin "You're also one-armed, aren't you? In a fight, I don't take advantages I wouldn't want used against me. I fight fair even if it kills me."
    thulkin "Você também tem um braço só, não é? Em uma luta, eu não tiro proveito de situações que não gostaria que fossem usadas contra mim. Luto limpo, mesmo que isso me mate."

# game/script4.rpy:440
translate pt_br_anubisbr scene103_4_58fdbf0d:

#   mc "That's... honorable. But you don't have to. This isn't just metal, it's enchanted. I can use it as if it was my real hand."
    mc "Isso é... honroso. Mas você não precisa. Isso não é apenas metal, é encantado. Posso usá-lo como se fosse minha mão de verdade."

# game/script4.rpy:441
translate pt_br_anubisbr scene103_4_036faf8c:

#   thulkin "*chuckles* Would you look at that! Very well then."
    thulkin "*risos* Olha só isso! Muito bem, então."

# game/script4.rpy:443
translate pt_br_anubisbr scene103_4_60c65247:

#   perception "He adjusts his grip, both hands now firmly on the haft. His stance shifts, becoming lower, more solid."
    perception "Ele ajusta a empunhadura, ambas as mãos agora firmemente apoiadas no cabo. Sua postura muda, tornando-se mais baixa e sólida."

# game/script4.rpy:444
translate pt_br_anubisbr scene103_4_f46936d4:

#   thulkin "Two hands it is."
    thulkin "São necessárias duas mãos."

