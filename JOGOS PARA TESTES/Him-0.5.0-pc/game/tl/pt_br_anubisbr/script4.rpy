#   r "Prove it."
    r "Prove isso."

# game/script4.rpy:11183
translate pt_br_anubisbr scene120_3_35dd28f7:

#   mc "Prove it?"
    mc "Prove isso?"

# game/script4.rpy:11185
translate pt_br_anubisbr scene120_3_3317ab80:

#   r "I want to feel something, [mc]. I've been deprived of touch... of a single kind word... for so long."
    r "Quero sentir alguma coisa, [mc] Tenho sido privado de contato... de uma única palavra gentil... por tanto tempo."

# game/script4.rpy:11186
translate pt_br_anubisbr scene120_3_6c518adb:

#   r "I want to feel alive again."
    r "Quero me sentir vivo novamente."

