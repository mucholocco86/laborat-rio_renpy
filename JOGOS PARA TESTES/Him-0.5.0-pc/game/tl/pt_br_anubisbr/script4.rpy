#   alex "Come on. Carry her and follow me, I remember the way back."
    alex "Vamos. Leve-a no colo e siga-me, eu me lembro do caminho de volta."

# game/script4.rpy:8906
translate pt_br_anubisbr scene117_choice01_op1_5536a84c:

