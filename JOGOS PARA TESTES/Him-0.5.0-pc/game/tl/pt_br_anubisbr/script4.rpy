translate pt_br_anubisbr scene111_eaf0818b:

#   jenny2 "Don't. You were a judge during the Guild evaluation. I never forget a face. You escaped after you killed Able and blew up the market."
    jenny2 "Não faça isso. Você era um dos juízes durante a avaliação da Guilda. Nunca me esqueço de um rosto. Você escapou depois de matar Able e explodir o mercado."

# game/script4.rpy:4595
translate pt_br_anubisbr scene111_a073f993:

#   mc "You're confusing me with someone else."
    mc "Você está me confundindo com outra pessoa."

# game/script4.rpy:4597
translate pt_br_anubisbr scene111_135af2f2:

#   jenny2 "Don't play dumb, [mc]. You're a wanted man, and yet here you are, strolling the city like nothing's wrong."
    jenny2 "Não se faça de desentendido, [mc] Você é um homem procurado, e mesmo assim está aqui, passeando pela cidade como se nada tivesse acontecido."

# game/script4.rpy:4598
translate pt_br_anubisbr scene111_bffc0989:

#   jenny2 "Fucking guards can't do anything right lately."
    jenny2 "Esses guardas malditos não conseguem fazer nada direito ultimamente."

# game/script4.rpy:4600
translate pt_br_anubisbr scene111_b97a88c5:

#   jenny2 "Look, my father managed to make a deal with the Guild after you let me join. We have connections now."
    jenny2 "Olha, meu pai conseguiu fazer um acordo com a Guilda depois que você me deixou entrar. Agora temos contatos."

# game/script4.rpy:4601
translate pt_br_anubisbr scene111_10500295:

#   jenny2 "You'll have more coin than you'll know what to do with, enough to leave this city, start over anywhere! Just... please. Help us."
    jenny2 "Você terá mais dinheiro do que jamais imaginou, o suficiente para sair desta cidade e recomeçar em qualquer lugar! Só... por favor. Nos ajude."

# game/script4.rpy:4603
translate pt_br_anubisbr scene111_2a36411a:

#   jenny2 "My father's rich. Stupidly rich. Help me and he'll reward you."
    jenny2 "Meu pai é rico. Ridiculamente rico. Me ajude e ele te recompensará."

# game/script4.rpy:4605
translate pt_br_anubisbr scene111_2b35b6fe:

#   mc "..."
    mc "..."

# game/script4.rpy:4607
translate pt_br_anubisbr scene111_4d214919:

#   jenny2 "*sigh* Not good enough? Well, I won't call the guards on you if you come and help me. Now."
    jenny2 "*suspiro* Não é bom o suficiente? Bem, eu não vou chamar os guardas se você vier me ajudar. Agora."

# game/script4.rpy:4609
translate pt_br_anubisbr scene111_b6082e7a:

#   mc "Jenna, pleas—"
    mc "Jenna, por favor—"

# game/script4.rpy:4611
translate pt_br_anubisbr scene111_1c372cb0:

#   jenny "It's JENNY! J, e, n, n, y."
    jenny "É a JENNY! J, e, n, n, y."

# game/script4.rpy:4612
translate pt_br_anubisbr scene111_2e0dbf76:

#   jenny "This is the second time you said my name wrong."
    jenny "Esta é a segunda vez que você pronuncia meu nome errado."

# game/script4.rpy:4614
translate pt_br_anubisbr scene111_ea7bfc3b:

#   mc "Sorry. I flubbed it."
    mc "Desculpe. Eu errei."

# game/script4.rpy:4616
translate pt_br_anubisbr scene111_cf2010e5:

#   jenny "No way, that was on purpose!"
    jenny "De jeito nenhum, isso foi de propósito!"

# game/script4.rpy:4535
translate pt_br_anubisbr scene111_31e7e40e_1:

#   lena "..."
    lena "..."

# game/script4.rpy:4564
translate pt_br_anubisbr scene111_a83bbf1e_1:

#   mc "Hmph."
    mc "Hum."

# game/script4.rpy:4621
translate pt_br_anubisbr scene111_choice01_op1_8abb54bc:

#   mc "Fine. Show me the way."
    mc "Ótimo. Mostre-me o caminho."

# game/script4.rpy:4622
translate pt_br_anubisbr scene111_choice01_op1_fd1f3b7d:

#   mc "(I have to do this before Avery's guards show up.)"
    mc "(Preciso fazer isso antes que os guardas de Avery apareçam.)"

# game/script4.rpy:4624
translate pt_br_anubisbr scene111_choice01_op1_6cf15d80:

#   jenny "Quickly, follow me."
    jenny "Sigam-me depressa."

# game/script4.rpy:4630
translate pt_br_anubisbr scene111_choice01_op2_95ad9148:

#   mc "I'm not helping you. Go find someone else, Jenny."
    mc "Não estou te ajudando. Procure outra pessoa, Jenny."

# game/script4.rpy:4632
translate pt_br_anubisbr scene111_choice01_op2_4b7a4826:

#   jenny "Oh, sorry. Did you not hear what I said?"
    jenny "Ah, desculpe. Você não ouviu o que eu disse?"

# game/script4.rpy:4633
translate pt_br_anubisbr scene111_choice01_op2_4b9f2754:

#   jenny "You don't have a choice here. Either you help, or I turn you in."
    jenny "Você não tem escolha. Ou você ajuda, ou eu te entrego."

# game/script4.rpy:4635
translate pt_br_anubisbr scene111_choice01_op2_40705a0b:

#   mc "You—"
    mc "Você-"

# game/script4.rpy:4637
translate pt_br_anubisbr scene111_choice01_op2_edc3dca4:

#   jenny "Help! Help! The fugitive is over here!"
    jenny "Socorro! Socorro! O fugitivo está aqui!"

# game/script4.rpy:4639
translate pt_br_anubisbr scene111_choice01_op2_6e4b325b:

#   mc "Shut up! ...Fine. I'll do it."
    mc "Cala a boca! ...Tudo bem. Eu faço isso."

# game/script4.rpy:4640
translate pt_br_anubisbr scene111_choice01_op2_4d4d3556:

#   mc "*sigh* Lead the way."
    mc "*suspiro* Mostre o caminho."

# game/script4.rpy:4648
translate pt_br_anubisbr scene111_2_0775732c:

#   lena "Over there."
    lena "Lá."

# game/script4.rpy:4649
translate pt_br_anubisbr scene111_2_fd308b99:

#   lena "Strange... Usually there's lots of guards circling the place. Gheris doesn't sleep easy without men at his door."
    lena "Que estranho... Normalmente há muitos guardas rondando o local. Gheris não consegue dormir tranquilo sem homens à sua porta."

# game/script4.rpy:4650
translate pt_br_anubisbr scene111_2_2b2a65f4:

#   mc "We're in luck. The attention is all on Avery right now. But we have to be quick. That luck won't hold."
    mc "Estamos com sorte. Todas as atenções estão voltadas para Avery agora. Mas precisamos ser rápidos. Essa sorte não vai durar."

# game/script4.rpy:4652
translate pt_br_anubisbr scene111_2_ab66e1d6:

#   lena "Right. See that window? That's his office. Gheris is a creature of habit—he'll be at his ledgers this time of day."
    lena "Certo. Está vendo aquela janela? É o escritório dele. Gheris é um homem de hábitos — ele estará em seus livros contábeis a essa hora do dia."

# game/script4.rpy:4654
translate pt_br_anubisbr scene111_2_a084578f:

#   lena "You know how to climb? Or better yet, can you do what you did back then?"
    lena "Você sabe escalar? Ou melhor ainda, consegue fazer o que fazia naquela época?"

# game/script4.rpy:4656
translate pt_br_anubisbr scene111_2_e7ace325:

#   mc "Ughn... my poor legs. I'll try."
    mc "Ai... minhas pobres pernas. Vou tentar."

# game/script4.rpy:4657
translate pt_br_anubisbr scene111_2_8fea7d61:

#   mc "Umm... how should I carry you?"
    mc "Hum... como devo te carregar?"

# game/script4.rpy:4659
translate pt_br_anubisbr scene111_2_f2de5909:

#   lena "Aww~ Don't be shy, boy. I'm like your mother."
    lena "Ah, não seja tímido, menino. Eu sou como sua mãe."

# game/script4.rpy:4661
translate pt_br_anubisbr scene111_2_65ad9038:

#   mc "I'd rather not think of it like that."
    mc "Prefiro não pensar nisso dessa forma."

# game/script4.rpy:4663
translate pt_br_anubisbr scene111_2_f9b6640e:

#   lena "*chuckles* You're pretty strong. No wonder my daughter is head over heels for you."
    lena "*risos* Você é bem forte. Não é à toa que minha filha está completamente apaixonada por você."

# game/script4.rpy:4664
translate pt_br_anubisbr scene111_2_44d80acc:

#   lena "Just don't overshoot us into the manor next door. One Gheris is enough for me."
    lena "Só não nos leve para a mansão ao lado. Um Gheris já me basta."

# game/script4.rpy:4668
translate pt_br_anubisbr scene111_2_509450c5:

#   mc "HNNNGG!"
    mc "HNNNGG!"

# game/script4.rpy:4669
translate pt_br_anubisbr scene111_2_38642319:

#   lena "Wooohh! This is insane!"
    lena "Uau! Isso é incrível!"

# game/script4.rpy:4671
translate pt_br_anubisbr scene111_2_5a0384f2:

#   lena "Uhh... [mc]?!"
    lena "Hum... [mc]?!"

# game/script4.rpy:4673
translate pt_br_anubisbr scene111_2_d5fd2370:

#   mc "Shit! Shit! Shit!"
    mc "Merda! Merda! Merda!"

# game/script4.rpy:4678
translate pt_br_anubisbr scene111_2_ef6d6ff9:

#   perception "You smash through the window in a shower of glass. You tumble on top of each other, sending paper everywhere. Lena lands in a tangled heap directly on top of a very startled, very soft man in silk clothing."
    perception "Vocês atravessam a janela num banho de cacos de vidro. Caem uma em cima da outra, espalhando papéis por todo lado. Lena cai em um emaranhado de papéis bem em cima de um homem muito assustado e delicado, vestido com roupas de seda."

# game/script4.rpy:4680
translate pt_br_anubisbr scene111_2_daadd7e0:

#   lena "Oww..."
    lena "Ai..."

# game/script4.rpy:4681
translate pt_br_anubisbr scene111_2_3ee32121:

#   mc "You good?"
    mc "Você está bem?"

# game/script4.rpy:4682
translate pt_br_anubisbr scene111_2_4b646aa2:

#   lena "I'm fine. He broke my fall."
    lena "Estou bem. Ele amorteceu minha queda."

# game/script4.rpy:4684
translate pt_br_anubisbr scene111_2_af84c65c:

#   gheris "What the—!?"
    gheris "Que diabos?!"

# game/script4.rpy:4685
translate pt_br_anubisbr scene111_2_1818d60f:

#   gheris "Who the hell are you two!? Guards! GUARDS!"
    gheris "Quem diabos são vocês dois?! Guardas! GUARDAS!"

# game/script4.rpy:4688
translate pt_br_anubisbr scene111_2_27b01dc5:

#   perception "Lena moves fast. She unsheathes her sword, pressing it flat against his throat. The scream dies in his windpipe."
    perception "Lena se move rapidamente. Ela desembainha a espada, pressionando-a contra a garganta dele. O grito se perde em sua traqueia."

# game/script4.rpy:4690
translate pt_br_anubisbr scene111_2_d93e7955:

#   lena "Shut your mouth, you pig. You should be grateful my blade isn't slitting your throat this instant."
    lena "Cale a boca, seu porco. Você deveria agradecer que minha lâmina não esteja cortando sua garganta neste instante."

# game/script4.rpy:4691
translate pt_br_anubisbr scene111_2_4e00458f:

#   lena "Now. I'm going to ask you this once."
    lena "Agora, vou te perguntar isso apenas uma vez."

# game/script4.rpy:4693
translate pt_br_anubisbr scene111_2_31c56b33:

#   gheris "Wh-What do you want?! Coin? I have coin—"
    gheris "O que você quer?! Moeda? Eu tenho moeda—"

# game/script4.rpy:4695
translate pt_br_anubisbr scene111_2_cc90b65c:

#   lena "The deeds to your slaves. Where are they?"
    lena "As escrituras dos seus escravos. Onde estão?"

# game/script4.rpy:4697
translate pt_br_anubisbr scene111_2_f52606e6:

#   gheris "Th-The drawer! Top drawer of the desk! You want them? Take them! Please, please don't hurt me—"
    gheris "A gaveta! A gaveta de cima da escrivaninha! Você quer? Pegue! Por favor, por favor, não me machuque—"

# game/script4.rpy:4699
translate pt_br_anubisbr scene111_2_153b0a04:

#   mc "Avylin... Eida... Ruby..."
    mc "Avylin... Eida... Ruby..."

# game/script4.rpy:4700
translate pt_br_anubisbr scene111_2_8d6812f4:

#   mc "(Wait, Ruby is here? Is this the noble she angered?)"
    mc "(Espere, Ruby está aqui? Este é o nobre que ela irritou?)"

# game/script4.rpy:4702
translate pt_br_anubisbr scene111_2_6d60dfc6:

#   mc "Serena! I found it."
    mc "Serena! Eu encontrei."

# game/script4.rpy:4703
translate pt_br_anubisbr scene111_2_20fbadb0:

#   mc "Should I rip it up?"
    mc "Devo rasgá-lo?"

# game/script4.rpy:4705
translate pt_br_anubisbr scene111_2_e973e6b3:

#   lena "No. I want him to do it. Get up."
    lena "Não. Quero que ele faça isso. Levante-se."

# game/script4.rpy:4706
translate pt_br_anubisbr scene111_2_6c63cea1:

#   lena "You're going to revoke your ownership of that girl. Right now. In writing."
    lena "Você vai renunciar à sua posse daquela garota. Agora mesmo. Por escrito."

# game/script4.rpy:4708
translate pt_br_anubisbr scene111_2_68c4b8d0:

#   gheris "C-Certainly. Of course. You could have simply asked..."
    gheris "C-Certamente. Claro. Você poderia simplesmente ter perguntado..."

# game/script4.rpy:4710
translate pt_br_anubisbr scene111_2_bd63b571:

#   lena "*scoff* Sure."
    lena "*bufa* Claro."

# game/script4.rpy:4712
translate pt_br_anubisbr scene111_2_d00419a9:

#   perception "Gheris writes his signature with trembling hands, then presses his ring into the wax."
    perception "Gheris assina com as mãos trêmulas e, em seguida, pressiona o anel na cera."

# game/script4.rpy:4714
translate pt_br_anubisbr scene111_2_be049d43:

#   gheris "There. She is mine no longer."
    gheris "Pronto. Ela não me pertence mais."

# game/script4.rpy:4716
translate pt_br_anubisbr scene111_2_fe9f44de:

#   lena "All those unpaid wages, give it to the man."
    lena "Todos esses salários atrasados, deem para o chefe."

# game/script4.rpy:4718
translate pt_br_anubisbr scene111_2_ffbc7a86:

#   gheris "Yes, of course. He can take it."
    gheris "Sim, claro. Ele aguenta."

# game/script4.rpy:4719
translate pt_br_anubisbr scene111_2_dfda7e4f:

#   gheris "A-Anything else... ma'am? And dear sir?"
    gheris "Mais alguma coisa... senhora? E senhor?"

# game/script4.rpy:4732
translate pt_br_anubisbr scene111_choice02_op1_35107345:

#   mc "Not just her. All of them. Every name in those papers. Revoke them now."
    mc "Não só ela. Todos eles. Cada nome naqueles documentos. Revoguem-nos agora."

# game/script4.rpy:4739
translate pt_br_anubisbr scene111_choice02_op1_154f1c43:

#   gheris "But that's my entire work force! Do you have any idea what they're worth?!"
    gheris "Mas essa é toda a minha força de trabalho! Você tem ideia de quanto eles valem?!"

# game/script4.rpy:4741
translate pt_br_anubisbr scene111_choice02_op1_a12f60de:

#   mc "Less than your life, I'd wager. Write."
    mc "Menos que a sua vida, eu diria. Escreva."

# game/script4.rpy:4748
translate pt_br_anubisbr scene111_choice02_op2_ba27c6f3:

#   mc "That's all you have? I don't believe it."
    mc "É só isso que você tem? Não acredito."

# game/script4.rpy:4754
translate pt_br_anubisbr scene111_choice02_op2_6767848f:

#   mc "I want more."
    mc "Quero mais."

# game/script4.rpy:4756
translate pt_br_anubisbr scene111_choice02_op2_26cdd1ae:

#   gheris "There's a pouch filled with coin behind the couch over there. That's all I have that isn't in the bank, I swear."
    gheris "Tem uma bolsinha cheia de moedas atrás do sofá ali. É tudo o que eu tenho que não está no banco, eu juro."

# game/script4.rpy:4764
translate pt_br_anubisbr scene111_choice02_op3_1b266cf0:

#   mc "That's good enough."
    mc "Isso já é suficiente."

# game/script4.rpy:4765
translate pt_br_anubisbr scene111_choice02_op3_4cc978e0:

#   mc "We have what we came for, Lena. Let's not give the guards a reason to find this place before we're gone."
    mc "Conseguimos o que viemos buscar, Lena. Não vamos dar aos guardas motivos para encontrarem este lugar antes de irmos embora."

# game/script4.rpy:4771
translate pt_br_anubisbr scene111_3_43f3db2e:

#   lena "I have no use for you now. Time to meet your Gods, human."
    lena "Não me serve mais nada. Chegou a hora de você conhecer seus deuses, humano."

# game/script4.rpy:4776
translate pt_br_anubisbr scene111_3_30e1605d:

#   gheris "W-Wait, what?! But I did what you asked! The deed is revoked—you saw me sign it!"
    gheris "E-Espere, o quê?! Mas eu fiz o que você pediu! A escritura está revogada — você me viu assiná-la!"

# game/script4.rpy:4778
translate pt_br_anubisbr scene111_3_0823deea:

#   lena "You did. And I'm grateful for that. Truly..."
    lena "Você fez isso. E eu sou grato por isso. De verdade..."

# game/script4.rpy:4779
translate pt_br_anubisbr scene111_3_8f58ef6a:

#   lena "But I'm still not satisfied. I need to make sure you don't refute the documents the moment I turn them in. A dead man can't contest a claim."
    lena "Mas ainda não estou satisfeito. Preciso garantir que você não conteste os documentos assim que eu os entregar. Um morto não pode contestar uma reivindicação."

# game/script4.rpy:4781
translate pt_br_anubisbr scene111_3_a45bdc26:

#   gheris "Please! I don't even own them yet! They're slaves in name only!"
    gheris "Por favor! Eu nem sequer os possuo ainda! Eles são escravos apenas no nome!"

# game/script4.rpy:4783
translate pt_br_anubisbr scene111_3_3a4ccdd0:

#   lena "What are you on about?"
    lena "Do que você está falando?"

# game/script4.rpy:4785
translate pt_br_anubisbr scene111_3_f77821fc:

#   gheris "I haven't turned the papers of ownership yet! I swear!"
    gheris "Eu ainda não entreguei os documentos de propriedade! Juro!"

# game/script4.rpy:4787
translate pt_br_anubisbr scene111_3_a7ea979d:

#   mc "Think this through, Lena. We can just leave."
    mc "Pense bem nisso, Lena. Podemos simplesmente ir embora."

# game/script4.rpy:4790
translate pt_br_anubisbr scene111_3_89b76c08:

#   gheris "Let me go and I promise I'll let that girl go, all of them, every last one. You have my word."
    gheris "Me solte e eu prometo que soltarei aquela garota, todas elas, sem exceção. Pode ter a minha palavra."

# game/script4.rpy:4792
translate pt_br_anubisbr scene111_3_8a709490:

#   gheris "Let me go and I promise I'll let that girl go. You have my word."
    gheris "Me deixe ir e prometo que deixarei aquela garota ir também. Pode confiar em mim."

# game/script4.rpy:4794
translate pt_br_anubisbr scene111_3_d268a270:

#   lena "Heh. Your word. Well, that's all the more reason to kill you. No paperwork to clean up. Just one less noble breathing my air."
    lena "Heh. É a sua palavra. Bom, isso é mais um motivo para te matar. Sem papelada para limpar. Só um nobre a menos respirando o mesmo ar que eu."

# game/script4.rpy:4796
translate pt_br_anubisbr scene111_3_334741e8:

#   gheris "Wait—!"
    gheris "Espere-!"

# game/script4.rpy:4799
translate pt_br_anubisbr scene111_3_ea2f26e5:

#   jenny "What with all this noise, daddy?! I'm trying to—"
    jenny "Papai, que barulho é esse?! Estou tentando—"

# game/script4.rpy:4801
translate pt_br_anubisbr scene111_3_a19c575c:

#   jenny "Huh? What's happening here?"
    jenny "Hã? O que está acontecendo aqui?"

# game/script4.rpy:4802
translate pt_br_anubisbr scene111_3_13cf55b0:

#   lena "What are you standing for?! Get her!"
    lena "O que você está defendendo?! Peguem ela!"

# game/script4.rpy:4804
translate pt_br_anubisbr scene111_3_427d665f:

#   mc "Stop. Stay right where you are. Don't make this worse."
    mc "Pare. Fique exatamente onde está. Não piore a situação."

# game/script4.rpy:4805
translate pt_br_anubisbr scene111_3_5807c3b6:

#   mc "Go sit next to your father."
    mc "Vá sentar-se ao lado do seu pai."

# game/script4.rpy:4807
translate pt_br_anubisbr scene111_3_c3bc9aef:

#   jenny "Daddy, what's happening?! I'm scared!"
    jenny "Papai, o que está acontecendo?! Estou com medo!"

# game/script4.rpy:4809
translate pt_br_anubisbr scene111_3_4c13c4a2:

#   gheris "Calm down, dear. It will be fine. Everything will be fine. Just do as they say."
    gheris "Calma, querida. Vai ficar tudo bem. Tudo vai ficar bem. Apenas faça o que eles dizem."

# game/script4.rpy:4811
translate pt_br_anubisbr scene111_3_a2756edb:

#   mc "Dammit! We could have been gone, Lena. We were done!"
    mc "Droga! Nós podíamos ter ido embora, Lena. Tínhamos terminado!"

# game/script4.rpy:4812
translate pt_br_anubisbr scene111_3_f45a87e7:

#   mc "Why didn't you mention that he had a daughter?!"
    mc "Por que você não mencionou que ele tinha uma filha?!"

# game/script4.rpy:4814
translate pt_br_anubisbr scene111_3_8f77a4cc:

#   lena "It's fine. What's one more? You're all the same to me. Daughter, father... you bleed the same color."
    lena "Está tudo bem. Que diferença faz mais um? Para mim, vocês são todos iguais. Filha, pai... o sangue de vocês é da mesma cor."

# game/script4.rpy:4816
translate pt_br_anubisbr scene111_3_54ccfa24:

#   gheris "Don't hurt her! Please! It's me you want, isn't it?! I'm the one who wronged you. She has nothing to do with this!"
    gheris "Não a machuque! Por favor! É a mim que você quer, não é?! Eu sou quem te magoou. Ela não tem nada a ver com isso!"

# game/script4.rpy:4818
translate pt_br_anubisbr scene111_3_8d517661:

#   lena "Don't blame me, Gheris. This is all your doing. You built this house on the backs of people who hated you. Now it falls on everyone inside it."
    lena "Não me culpe, Gheris. A culpa é toda sua. Você construiu esta casa às custas de pessoas que te odiavam. Agora, ela recai sobre todos que estão dentro dela."

# game/script4.rpy:4820
translate pt_br_anubisbr scene111_3_ceaea617:

#   jenny "You! I know you!"
    jenny "Você! Eu te conheço!"

# game/script4.rpy:4821
translate pt_br_anubisbr scene111_3_ac1988a6:

#   jenny "[mc]!"
    jenny "[mc]!"

# game/script4.rpy:4822
translate pt_br_anubisbr scene111_3_f0cb5a23:

#   jenny "I don't know what's going on, or why you're here, but I can help you! My father has money, lots of it! I'll give you coin, more than you've ever seen!"
    jenny "Não sei o que está acontecendo, nem por que você está aqui, mas posso te ajudar! Meu pai tem dinheiro, muito dinheiro! Vou te dar moedas, mais do que você jamais viu!"

# game/script4.rpy:4825
translate pt_br_anubisbr scene111_3_155d77f4:

#   jenny "My father managed to make a deal with the Guild after you let me join. We have connections now."
    jenny "Meu pai conseguiu fazer um acordo com a Guilda depois que você me deixou entrar. Agora temos contatos."

# game/script4.rpy:4826
translate pt_br_anubisbr scene111_3_25a06340:

#   jenny "You'll have more coin than you'll know what to do with—enough to leave this city, start over anywhere! Just... please. Help us."
    jenny "Você terá mais dinheiro do que jamais imaginou — o suficiente para sair desta cidade e recomeçar em qualquer lugar! Só... por favor. Nos ajude."

# game/script4.rpy:4828
translate pt_br_anubisbr scene111_3_d4c6ad67:

#   jenny "My father's rich. Stupidly rich. Get rid of her and he'll reward you! I swear it!"
    jenny "Meu pai é rico. Ridiculamente rico. Livre-se dela e ele te recompensará! Eu juro!"

# game/script4.rpy:4829
translate pt_br_anubisbr scene111_3_75b937e9:

#   jenny "We'll forget everything here. You walk away a wealthy man and dissapear wherever you want!"
    jenny "Vamos esquecer tudo por aqui. Você sai daqui rico e desaparece onde quiser!"

# game/script4.rpy:4832
translate pt_br_anubisbr scene111_3_d0ba064e:

#   lena "*laughs* The nerve you have, girl. [mc] is here to help {i}me{/i}. We have an understanding. Now... where were we?"
    lena "*risos* Que audácia a sua, garota. [mc] está aqui para ajudar {i} meu{/i}Nós nos entendemos. Agora... onde estávamos?"

# game/script4.rpy:4833
translate pt_br_anubisbr scene111_3_a82fce9b:

#   perception "Cold air flows through the broken window. Jenny sobs once, stifling it. Gheris squeezes his eyes shut. Lena's hand is steady."
    perception "O ar frio entra pela janela quebrada. Jenny soluça uma vez, abafando o choro. Gheris fecha os olhos com força. A mão de Lena está firme."

# game/script4.rpy:4868
translate pt_br_anubisbr scene111_choice03_op2_9809eff9:

#   mc "Lena. Put the sword down."
    mc "Lena. Abaixe a espada."

# game/script4.rpy:4870
translate pt_br_anubisbr scene111_choice03_op2_5fb62d27:

#   lena "Don't."
    lena "Não."

# game/script4.rpy:4872
translate pt_br_anubisbr scene111_choice03_op2_9ac69c1a:

#   mc "We got what we came for. This isn't justice anymore—it's slaughter."
    mc "Conseguimos o que viemos buscar. Isto não é mais justiça — é um massacre."

# game/script4.rpy:4873
translate pt_br_anubisbr scene111_choice03_op2_22b49c72:

#   mc "I can't let you do this. Not with the girl here."
    mc "Não posso deixar você fazer isso. Não com a garota que está aqui."

# game/script4.rpy:4875
translate pt_br_anubisbr scene111_choice03_op2_9b24247c:

#   lena "You think I care about the girl? She's just another noble brat. Given time, she'll grow up to be exactly like him."
    lena "Você acha que eu me importo com a garota? Ela é só mais uma mimada da alta sociedade. Com o tempo, ela vai crescer e ficar exatamente igual a ele."

# game/script4.rpy:4877
translate pt_br_anubisbr scene111_choice03_op2_3da36982:

#   mc "Maybe. But we're not them."
    mc "Talvez. Mas nós não somos eles."

# game/script4.rpy:4878
translate pt_br_anubisbr scene111_choice03_op2_6d98359c:

#   mc "You're a mother, Lena. Look at her. She's terrified. She's exactly what Serena was when I met you—caught in a nightmare she didn't make."
    mc "Você é mãe, Lena. Olha para ela. Ela está apavorada. Ela é exatamente como a Serena era quando eu te conheci — presa em um pesadelo que ela não criou."

# game/script4.rpy:4880
translate pt_br_anubisbr scene111_choice03_op2_bfb6e5a8:

#   lena "Don't you dare use my daughter against me."
    lena "Não ouse usar minha filha contra mim."

# game/script4.rpy:4882
translate pt_br_anubisbr scene111_choice03_op2_03639d83:

#   mc "You risked everything to get Serena back. You didn't do it by becoming the monsters you hate, you did it because you're better than them."
    mc "Você arriscou tudo para ter Serena de volta. Você não fez isso se tornando os monstros que odeia, você fez isso porque é melhor do que eles."

# game/script4.rpy:4890
translate pt_br_anubisbr scene111_choice03_op2_8990f823:

#   empathy "Lena stares at Jenny, who meets her eyes with raw terror. Slowly, as if the weight of her own arm becomes unbearable, Lena lowers the blade."
    empathy "Lena encara Jenny, que retribui o olhar com puro terror. Lentamente, como se o peso do próprio braço se tornasse insuportável, Lena abaixa a lâmina."

# game/script4.rpy:4895
translate pt_br_anubisbr scene111_choice03_op2_6bf25741:

#   lena "If you ever try to claim her, or send anyone after us... I will come back. And I won't stop to talk."
    lena "Se você tentar reivindicá-la ou mandar alguém atrás de nós... eu voltarei. E não vou parar para conversar."

# game/script4.rpy:4897
translate pt_br_anubisbr scene111_choice03_op2_9bd493ed:

#   gheris "You have my word."
    gheris "Você tem a minha palavra."

# game/script4.rpy:4899
translate pt_br_anubisbr scene111_choice03_op2_67553688:

#   mc "Let's go. The window. Now."
    mc "Vamos. A janela. Agora."

# game/script4.rpy:4901
translate pt_br_anubisbr scene111_choice03_op2_31e7e40e:

#   lena "..."
    lena "..."

# game/script4.rpy:4902
translate pt_br_anubisbr scene111_choice03_op2_d628bfa6:

#   jenny "Thank you, [mc]."
    jenny "Obrigado, [mc]."

# game/script4.rpy:4920
translate pt_br_anubisbr scene111_choice03_op1_4849ffc9:

#   mc "...How much coin are we talking, Jenny?"
    mc "...De quanto dinheiro estamos falando, Jenny?"

# game/script4.rpy:4922
translate pt_br_anubisbr scene111_choice03_op1_53d6f0d5:

#   lena "What?! [mc]! You can't be serious!"
    lena "O que?! [mc] Você não pode estar falando sério!"

# game/script4.rpy:4923
translate pt_br_anubisbr scene111_choice03_op1_0f08115b:

#   jenny "Twenty gold coins! No, thirty!"
    jenny "Vinte moedas de ouro! Não, trinta!"

# game/script4.rpy:4925
translate pt_br_anubisbr scene111_choice03_op1_bbe8ec22:

#   lena "You'd sell me out? For coin?"
    lena "Você me venderia? Por dinheiro?"

# game/script4.rpy:4926
translate pt_br_anubisbr scene111_choice03_op1_7182391f:

#   lena "After everything we— After I trusted you?!"
    lena "Depois de tudo que nós... Depois de eu ter confiado em você?!"

# game/script4.rpy:4928
translate pt_br_anubisbr scene111_choice03_op1_b1fb8f3a:

#   mc "I'm sorry, Lena. I have my own war to fight. I need resources, and I'm out of options."
    mc "Sinto muito, Lena. Tenho a minha própria guerra para lutar. Preciso de recursos e estou sem opções."

# game/script4.rpy:4930
translate pt_br_anubisbr scene111_choice03_op1_0a0b0b8f:

#   lena "Then you're out of allies, too."
    lena "Então você também ficará sem aliados."

# game/script4.rpy:4932
translate pt_br_anubisbr scene111_choice03_op1_090f9607:

#   perception "She moves without hesitation, just the flash of steel and the sound of displaced air."
    perception "Ela se move sem hesitar, apenas o brilho do aço e o som do ar deslocado."

# game/script4.rpy:4936
translate pt_br_anubisbr scene111_choice03_op1_9fb8cb3d:

#   perception "Instinct takes over. You twist, the edge slicing air instead of flesh. She fights with the fury of a woman who's lost everything twice."
    perception "O instinto assume o controle. Você se contorce, a lâmina cortando o ar em vez da carne. Ela luta com a fúria de uma mulher que perdeu tudo duas vezes."

# game/script4.rpy:4938
translate pt_br_anubisbr scene111_choice03_op1_ac5c57fd:

#   perception "She overextends. In less than a second, you catche her wrist."
    perception "Ela se estica demais. Em menos de um segundo, você segura o pulso dela."

# game/script4.rpy:4939
translate pt_br_anubisbr scene111_choice03_op1_143d525f:

#   lena "GHNN! LET GO!"
    lena "GHNN! SOLTA!"

# game/script4.rpy:4940
translate pt_br_anubisbr scene111_choice03_op1_9b41cd83:

#   mc "(I'm sorry.)"
    mc "(Desculpe.)"

# game/script4.rpy:4943
translate pt_br_anubisbr scene111_choice03_op1_fa3c4645:

#   lena "Gahn!"
    lena "Gahn!"

# game/script4.rpy:4944
translate pt_br_anubisbr scene111_choice03_op1_96262a72:

#   perception "You twist her hand and drives the blade into her body. A choked gasp escapes her lips. She looks down at the blood blooming across her chest. The fury drains from her face, replaced by surprise and sorrow."
    perception "Você torce a mão dela e crava a lâmina em seu corpo. Um suspiro sufocado escapa de seus lábios. Ela olha para o sangue que se espalha por seu peito. A fúria desaparece de seu rosto, substituída por surpresa e tristeza."

# game/script4.rpy:4947
translate pt_br_anubisbr scene111_choice03_op1_af45b654:

#   lena "Serena..."
    lena "Serena..."

# game/script4.rpy:4948
translate pt_br_anubisbr scene111_choice03_op1_de23dbda:

#   gheris "I-I'll get the gold. Just... please. Don't hurt us."
    gheris "Eu vou pegar o ouro. Só... por favor. Não nos machuque."

# game/script4.rpy:4949
translate pt_br_anubisbr scene111_choice03_op1_2b35b6fe:

#   mc "..."
    mc "..."

# game/script4.rpy:4957
translate pt_br_anubisbr scene111_choice03_op3_1d9d86b2:

#   mc "...Do what you have to do. I won't stop you."
    mc "Faça o que você tem que fazer. Eu não vou te impedir."

# game/script4.rpy:4959
translate pt_br_anubisbr scene111_choice03_op3_3ac49aaf:

#   lena "This is for Serena. For all of the people you wronged."
    lena "Isto é para Serena. Para todas as pessoas a quem você prejudicou."

# game/script4.rpy:4962
translate pt_br_anubisbr scene111_choice03_op3_1dd407e3:

#   perception "Lena's swings her blade. The sound is wet and brief, swallowed by Jenny's scream. Then the scream cuts short, too, collapsing into a gasp."
    perception "Lena brande sua lâmina. O som é úmido e breve, abafado pelo grito de Jenny. Então o grito também cessa abruptamente, transformando-se em um suspiro."

# game/script4.rpy:4963
translate pt_br_anubisbr scene111_choice03_op3_9bad74dd:

#   lena "It's done."
    lena "Está feito."

# game/script4.rpy:4964
translate pt_br_anubisbr scene111_choice03_op3_1894d7af:

#   lena "Let's go."
    lena "Vamos."

# game/script4.rpy:4970
translate pt_br_anubisbr scene111_4_6a4b3b8b:

#   jenny "Here we are! On the third floor!"
    jenny "Chegamos! No terceiro andar!"

# game/script4.rpy:4972
translate pt_br_anubisbr scene111_4_3fbd23b9:

#   jenny "In this room!"
    jenny "Nesta sala!"

# game/script4.rpy:4973
translate pt_br_anubisbr scene111_4_4af11e61:

#   mc "Stay outside. I'll take care of it."
    mc "Fique aí fora. Eu cuido disso."

# game/script4.rpy:4976
translate pt_br_anubisbr scene111_4_87d2f3cb:

#   gheris "H-Help! Please, someone!"
    gheris "Socorro! Por favor, alguém!"

# game/script4.rpy:4978
translate pt_br_anubisbr scene111_4_6112fba2:

#   lena "No one's left, pig. They've all fled or fallen. It's time you met them too."
    lena "Não sobrou ninguém, porco. Todos fugiram ou caíram. É hora de você conhecê-los também."

# game/script4.rpy:4980
translate pt_br_anubisbr scene111_4_4bf1e786:

#   mc "Stop!"
    mc "Parar!"

# game/script4.rpy:4982
translate pt_br_anubisbr scene111_4_256283d1:

#   lena "Another one? Fine. Come here. I'll make it quick."
    lena "Mais uma? Ótimo. Vem cá. Vou fazer rapidinho."

# game/script4.rpy:4983
translate pt_br_anubisbr scene111_4_76462520:

#   lena "Ah... [mc]."
    lena "Ah... [mc]."

# game/script4.rpy:4985
translate pt_br_anubisbr scene111_4_2a457df4:

#   lena "So you don't have time to help me—a woman trying to free her daughter from slavery, but you have time to help a {i}noble{/i}?"
    lena "Então você não tem tempo para me ajudar — uma mulher tentando libertar sua filha da escravidão —, mas tem tempo para ajudar uma... {i} nobre{/i}?"

# game/script4.rpy:4986
translate pt_br_anubisbr scene111_4_4621d0e1:

#   lena "Looks like I was completely wrong about you. And so was my daughter."
    lena "Parece que eu estava completamente enganada a seu respeito. E minha filha também."

# game/script4.rpy:4988
translate pt_br_anubisbr scene111_4_2509742c:

#   mc "We can still talk about this, Lena. It doesn't have to go this way."
    mc "Ainda podemos conversar sobre isso, Lena. Não precisa ser assim."

# game/script4.rpy:4990
translate pt_br_anubisbr scene111_4_a04da352:

#   lena "Talk? You want to talk?"
    lena "Conversar? Você quer conversar?"

# game/script4.rpy:4991
translate pt_br_anubisbr scene111_4_c6158daa:

#   lena "I'm not doing shit until this fucker dies. He doesn't get to walk away, not after what he did."
    lena "Não vou fazer nada até esse desgraçado morrer. Ele não vai sair impune, não depois do que fez."

# game/script4.rpy:4993
translate pt_br_anubisbr scene111_4_c0863294:

#   gheris "I swear to let that girl go free, you have my word!"
    gheris "Juro que vou libertar aquela garota, pode ter a minha palavra!"

# game/script4.rpy:4995
translate pt_br_anubisbr scene111_4_b9c1871f:

#   lena "That's not enough."
    lena "Isso não é suficiente."

# game/script4.rpy:4997
translate pt_br_anubisbr scene111_4_9e6d4bb4:

#   jenny "Do something! She's going to hurt him!"
    jenny "Faça alguma coisa! Ela vai machucá-lo!"

# game/script4.rpy:4998
translate pt_br_anubisbr scene111_4_0e6bfdaa:

#   empathy "Your mind races. You can hear Jenny sobbing and screaming from behind the door."
    empathy "Sua mente está a mil. Você consegue ouvir Jenny soluçando e gritando atrás da porta."

# game/script4.rpy:5005
translate pt_br_anubisbr scene111_choice04_op1_ab8d6d22:

#   mc "Lena. Put the blade down. This isn't justice anymore, it's slaughter."
    mc "Lena. Abaixe a lâmina. Isso não é mais justiça, é um massacre."

# game/script4.rpy:5006
translate pt_br_anubisbr scene111_choice04_op1_c506b27d:

#   mc "I can't let you do this. Not with his daughter here crying and begging."
    mc "Não posso deixar você fazer isso. Não com a filha dele aqui chorando e implorando."

# game/script4.rpy:5008
translate pt_br_anubisbr scene111_choice04_op1_9b24247c:

#   lena "You think I care about the girl? She's just another noble brat. Given time, she'll grow up to be exactly like him."
    lena "Você acha que eu me importo com a garota? Ela é só mais uma mimada da alta sociedade. Com o tempo, ela vai crescer e ficar exatamente igual a ele."

# game/script4.rpy:5010
translate pt_br_anubisbr scene111_choice04_op1_3da36982:

#   mc "Maybe. But we're not them."
    mc "Talvez. Mas nós não somos eles."

# game/script4.rpy:5011
translate pt_br_anubisbr scene111_choice04_op1_9d6e37f4:

#   mc "You're a mother, Lena. His daughter is terrified. She's exactly what Serena was when I met you—caught in a nightmare she didn't make."
    mc "Você é mãe, Lena. A filha dele está apavorada. Ela é exatamente como a Serena era quando eu te conheci — presa em um pesadelo que ela não criou."

# game/script4.rpy:5013
translate pt_br_anubisbr scene111_choice04_op1_5e3e448a:

#   lena "Don't you dare use my daughter against me!"
    lena "Não ouse usar minha filha contra mim!"

# game/script4.rpy:5015
translate pt_br_anubisbr scene111_choice04_op1_379d41ef:

#   mc "You risked everything to get Serena back. You didn't do it by becoming the monsters she hates. You did it because you're better than them."
    mc "Você arriscou tudo para trazer Serena de volta. Você não fez isso se tornando os monstros que ela odeia. Você fez isso porque é melhor do que eles."

# game/script4.rpy:5022
translate pt_br_anubisbr scene111_choice04_op1_444aaf0a:

#   empathy "Lena stares at you for a while. Slowly, as if the weight of her own arm becomes unbearable, Lena lowers the blade."
    empathy "Lena olha para você por um instante. Lentamente, como se o peso do próprio braço se tornasse insuportável, Lena abaixa a lâmina."

# game/script4.rpy:5026
translate pt_br_anubisbr scene111_choice04_op1_18ad7d10:

#   lena "If you ever try to claim her again, or send anyone after us... I will come back. And I won't stop until your head isn't attached to your neck. Do you understand me?"
    lena "Se você tentar reivindicá-la novamente, ou mandar alguém atrás de nós... eu voltarei. E não pararei até que sua cabeça esteja separada do seu pescoço. Entendeu?"

# game/script4.rpy:5028
translate pt_br_anubisbr scene111_choice04_op1_aa88734c:

#   gheris "Y-You have my word. I'll set her free, I swear it on my life."
    gheris "Você tem a minha palavra. Eu a libertarei, juro pela minha vida."

# game/script4.rpy:5030
translate pt_br_anubisbr scene111_choice04_op1_3dcf429c:

#   mc "You have to leave. Now. Guards could be here any second."
    mc "Você precisa ir embora. Agora. Os guardas podem chegar a qualquer segundo."

# game/script4.rpy:5031
translate pt_br_anubisbr scene111_choice04_op1_31e7e40e:

#   lena "..."
    lena "..."

# game/script4.rpy:5040
translate pt_br_anubisbr scene111_choice04_op2_4a4f08e4:

#   mc "You're out of control, Lena. I'm sorry."
    mc "Você está fora de controle, Lena. Me desculpe."

# game/script4.rpy:5042
translate pt_br_anubisbr scene111_choice04_op2_39887d41:

#   lena "You wanna fight, you? A little cub?"
    lena "Você quer brigar, é? Um filhote de cachorro?"

# game/script4.rpy:5043
translate pt_br_anubisbr scene111_choice04_op2_09b31917:

#   lena "I've been cutting throats since before you were in your father's balls. But come. Try your luck."
    lena "Eu corto gargantas desde antes de você estar nos testículos do seu pai. Mas venha. Tente a sua sorte."

# game/script4.rpy:5045
translate pt_br_anubisbr scene111_choice04_op2_21766e5a:

#   jenny "Stop! I didn't want you to fight! You'll... you'll ruin the carpet with your blood!"
    jenny "Pare! Eu não queria que você brigasse! Você vai... você vai estragar o tapete com o seu sangue!"

# game/script4.rpy:5046
translate pt_br_anubisbr scene111_choice04_op2_090f9607:

#   perception "She moves without hesitation, just the flash of steel and the sound of displaced air."
    perception "Ela se move sem hesitar, apenas o brilho do aço e o som do ar deslocado."

