translate pt_br_anubisbr scene111_choice04_op2_9fb8cb3d:

#   perception "Instinct takes over. You twist, the edge slicing air instead of flesh. She fights with the fury of a woman who's lost everything twice."
    perception "O instinto assume o controle. Você se contorce, a lâmina cortando o ar em vez da carne. Ela luta com a fúria de uma mulher que perdeu tudo duas vezes."

# game/script4.rpy:5052
