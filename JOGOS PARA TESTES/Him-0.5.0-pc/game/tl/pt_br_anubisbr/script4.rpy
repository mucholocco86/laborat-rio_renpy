# game/script4.rpy:1634
translate pt_br_anubisbr scene105_2_b214c0bb:

#   perception "Maia sits beside you, tucking her legs under herself. The flames dances in her wide eyes as she stares at you."
    perception "Maia senta-se ao seu lado, encolhendo as pernas. As chamas dançam em seus olhos arregalados enquanto ela olha para você."

# game/script4.rpy:1636
translate pt_br_anubisbr scene105_2_87b92d66:

#   mc "I see that look in your eyes. Don't worry about me, Maia. I'm not even hurt, just tired."
    mc "Vejo esse olhar nos seus olhos. Não se preocupe comigo, Maia. Eu nem estou machucado, só cansado."

# game/script4.rpy:1638
translate pt_br_anubisbr scene105_2_67638b39:

#   m "That is strange. The others said you fought so hard..."
    m "Que estranho. Os outros disseram que você lutou tanto..."

# game/script4.rpy:1640
translate pt_br_anubisbr scene105_2_eda143a8:

#   mc "Guess I'm tougher than I look."
    mc "Acho que sou mais forte do que pareço."

# game/script4.rpy:1642
translate pt_br_anubisbr scene105_2_e4622a8b:

#   m "*giggles* I knew that already. You've always been strong, even when you pretend you're not."
    m "*risos* Eu já sabia disso. Você sempre foi forte, mesmo quando finge que não é."

# game/script4.rpy:1644
translate pt_br_anubisbr scene105_2_7230ba84:

#   mc "What about you? How are you holding up?"
    mc "E você? Como está se sentindo?"

# game/script4.rpy:1646
translate pt_br_anubisbr scene105_2_2429ed4b:

#   m "I'm always fine whenever you're beside me."
    m "Eu sempre fico bem quando você está ao meu lado."

# game/script4.rpy:1647
translate pt_br_anubisbr scene105_2_4aa23fb9:

#   m "...I-I want to tell you something."
    m "...Quero te contar uma coisa."

# game/script4.rpy:1649
translate pt_br_anubisbr scene105_2_99144d56:

#   mc "Tell me what?"
    mc "Diga-me o quê?"

# game/script4.rpy:1651
translate pt_br_anubisbr scene105_2_7289fc32:

#   m "That... you're the only person who ever made me feel safe. Like I matter. Like I'm not just... some girl who was left behind."
    m "Você... você é a única pessoa que já me fez sentir segura. Como se eu importasse. Como se eu não fosse apenas... uma garota que foi deixada para trás."

# game/script4.rpy:1652
translate pt_br_anubisbr scene105_2_e7996366:

#   m "I'm so glad I met you, [mc]."
    m "Que bom que te conheci! [mc]."

# game/script4.rpy:1654
translate pt_br_anubisbr scene105_2_beb40ff0:

#   mc "Ever after all that?"
    mc "Depois de tudo isso?"

# game/script4.rpy:1656
translate pt_br_anubisbr scene105_2_8a915360:

#   m "More so after."
    m "Ainda mais depois."

# game/script4.rpy:1658
translate pt_br_anubisbr scene105_2_bec90435:

#   mc "*chuckles* Thank you."
    mc "*risos* Obrigada."

# game/script4.rpy:1659
translate pt_br_anubisbr scene105_2_e612037c:

#   m "..."
    m "..."

# game/script4.rpy:1661
translate pt_br_anubisbr scene105_2_22697e4c:

#   m "Can I ask you something?"
    m "Posso te perguntar uma coisa?"

# game/script4.rpy:1663
translate pt_br_anubisbr scene105_2_e59abd2a:

#   mc "Anything."
    mc "Qualquer coisa."

# game/script4.rpy:1665
translate pt_br_anubisbr scene105_2_1f9b8710:

#   m "When you're out there... when you're gone, do you think about me like I think about you?"
    m "Quando você está lá fora... quando você se vai, você pensa em mim como eu penso em você?"

# game/script4.rpy:1670
translate pt_br_anubisbr scene105_2_14614475:

#   mc "*sigh* (Fuck, I'm tired as hell. I need to hit the bed.)"
    mc "*suspiro* (Puta merda, estou morrendo de cansaço. Preciso ir para a cama.)"

# game/script4.rpy:1610
translate pt_br_anubisbr scene105_2_3f871f46_1:

#   mc "Hmm?"
    mc "Hum?"

# game/script4.rpy:1632
translate pt_br_anubisbr scene105_2_3f871f46_2:

#   mc "Hmm?"
    mc "Hum?"

# game/script4.rpy:1676
translate pt_br_anubisbr scene105_choice03_op1_d64d5516:

#   mc "No. I'd love to sleep together tonight. I could really use the comforting touch of a beautiful woman."
    mc "Não. Eu adoraria dormir com você esta noite. Eu realmente preciso do toque reconfortante de uma mulher bonita."

# game/script4.rpy:1678
translate pt_br_anubisbr scene105_choice03_op1_e688236c:

#   reham "*giggles* Come. I'll make the bed nice and warm for you."
    reham "*risinhos* Vem. Vou arrumar a cama bem quentinha para você."

# game/script4.rpy:1683
translate pt_br_anubisbr scene105_choice03_op2_33af3804:

#   mc "I think I need some time alone tonight, Reham."
    mc "Acho que preciso de um tempo sozinha esta noite, Reham."

# game/script4.rpy:1685
translate pt_br_anubisbr scene105_choice03_op2_0f72a3ac:

#   reham "I understand."
    reham "Eu entendo."

# game/script4.rpy:1686
translate pt_br_anubisbr scene105_choice03_op2_71d2d4f8:

#   reham "Rest well, okay? I'll be right here if you need anything."
    reham "Descanse bem, está bem? Estarei aqui se precisar de alguma coisa."

# game/script4.rpy:1687
translate pt_br_anubisbr scene105_choice03_op2_5b443f55:

#   reham "Goodnight, [mc]. I'm really proud of you."
    reham "Boa noite, [mc] Estou muito orgulhoso de você."

# game/script4.rpy:1693
translate pt_br_anubisbr scene105_choice04_op2_cd6189a5:

#   mc "Every second. You never leave my mind. Your smile... your cute face."
    mc "A cada segundo. Você nunca sai da minha cabeça. Seu sorriso... seu rostinho lindo."

# game/script4.rpy:1695
translate pt_br_anubisbr scene105_choice04_op2_f95c3939:

#   m "R-Really?"
    m "Sério?"

# game/script4.rpy:1697
translate pt_br_anubisbr scene105_choice04_op2_df628f56:

#   mc "Really. *laughs* A girl like you? Hard to forget."
    mc "Sério? *risos* Uma garota como você? Difícil de esquecer."

# game/script4.rpy:1699
translate pt_br_anubisbr scene105_choice04_op2_b6184183:

#   m "That's... that means more than you know."
    m "Isso... isso significa mais do que você imagina."

# game/script4.rpy:1700
translate pt_br_anubisbr scene105_choice04_op2_b95c2bfa:

#   m "Thank you. For saving me. For everything."
    m "Obrigada. Por me salvar. Por tudo."

# game/script4.rpy:1702
translate pt_br_anubisbr scene105_choice04_op2_0c05f986:

#   reham "It's getting late you two. Leave [mc] alone, Maia. He should rest."
    reham "Está ficando tarde, vocês dois. Vão embora. [mc] Sozinho, Maia. Ele deveria descansar."

# game/script4.rpy:1704
translate pt_br_anubisbr scene105_choice04_op2_7354a041:

#   m "Umm... C-Can we sleep together, [mc]? It's been so long since we shared the same bed."
    m "Hum... P-Podemos dormir juntos? [mc] Já faz tanto tempo que não compartilhamos a mesma cama."

# game/script4.rpy:1710
translate pt_br_anubisbr scene105_choice04_op1_c13eea01:

#   mc "I get what you're saying, Maia. But there's much to think about other than you."
    mc "Entendo o que você está dizendo, Maia. Mas há muito mais em que pensar além de você."

# game/script4.rpy:1712
translate pt_br_anubisbr scene105_choice04_op1_58231912:

#   m "O-Of course. This isn't the time for that... you have a lot depending on you. Right?"
    m "C-Claro. Não é hora para isso... você tem muita coisa dependendo de você. Certo?"

# game/script4.rpy:1714
translate pt_br_anubisbr scene105_choice04_op1_716019b8:

#   mc "Right."
    mc "Certo."

# game/script4.rpy:1716
translate pt_br_anubisbr scene105_choice04_op1_a3ccb7f4:

#   m "Then I shouldn't be sad. You're thinking about all of us. Hehe~"
    m "Então eu não deveria ficar triste. Você está pensando em todos nós. Hehe~"

# game/script4.rpy:1718
translate pt_br_anubisbr scene105_choice04_op1_0c05f986:

#   reham "It's getting late you two. Leave [mc] alone, Maia. He should rest."
    reham "Está ficando tarde, vocês dois. Vão embora. [mc] Sozinho, Maia. Ele deveria descansar."

# game/script4.rpy:1720
translate pt_br_anubisbr scene105_choice04_op1_ef4daa10:

#   m "Can we sleep together, [mc]? It's been so long since we shared the same bed."
    m "Podemos dormir juntos? [mc] Já faz tanto tempo que não compartilhamos a mesma cama."

# game/script4.rpy:1727
translate pt_br_anubisbr scene105_choice05_op1_57ef78c8:

#   mc "Yeah, I want you close tonight."
    mc "Sim, eu quero você por perto esta noite."

# game/script4.rpy:1729
translate pt_br_anubisbr scene105_choice05_op1_3cd84f48:

#   m "I missed this... just being near you."
    m "Senti falta disso... só de estar perto de você."

# game/script4.rpy:1734
translate pt_br_anubisbr scene105_choice05_op2_e7dfc6be:

#   mc "I think I need to be alone tonight, Maia. Just... to think."
    mc "Acho que preciso ficar sozinha esta noite, Maia. Só... para pensar."

# game/script4.rpy:1736
translate pt_br_anubisbr scene105_choice05_op2_d43b02d9:

#   m "A-Alright. I understand."
    m "Certo. Entendi."

# game/script4.rpy:1737
translate pt_br_anubisbr scene105_choice05_op2_f042608d:

#   m "If you change your mind... Just tell me."
    m "Se você mudar de ideia... É só me avisar."

# game/script4.rpy:1738
translate pt_br_anubisbr scene105_choice05_op2_1489fcc2:

#   m "Sleep well, [mc]. I'm glad you're here."
    m "Durma bem, [mc] Que bom que você está aqui."

# game/script4.rpy:1745
translate pt_br_anubisbr scene105_choice02_op1_0a9f7afd:

#   mc "How about a scary story?"
    mc "Que tal uma história de terror?"

# game/script4.rpy:1748
translate pt_br_anubisbr scene105_choice02_op1_633ab03c:

#   m "Ooooh~ I love scary stories!"
    m "Ooooh~ Adoro histórias de terror!"

# game/script4.rpy:1750
translate pt_br_anubisbr scene105_choice02_op1_ca915f16:

#   env "Unseen crows scream from the trees. Flies buzz around the damp, rotting earth. And in the middle of it all stands a crooked, ancient house... alive with shadows."
    env "Corvos invisíveis gritam nas árvores. Moscas zumbem ao redor da terra úmida e apodrecida. E no meio de tudo isso ergue-se uma casa antiga e torta... repleta de sombras."

# game/script4.rpy:1751
translate pt_br_anubisbr scene105_choice02_op1_0d51fa71:

#   env "Inside, a lone woman hunches over a heavy tome, her eyes tracing every line with deep concentration. But there's no hunger in her gaze, only worry... and sadness."
    env "Lá dentro, uma mulher solitária debruça-se sobre um pesado tomo, os olhos percorrendo cada linha com profunda concentração. Mas não há fome em seu olhar, apenas preocupação... e tristeza."

# game/script4.rpy:1753
translate pt_br_anubisbr scene105_choice02_op1_c7d74bb2:

#   reham "She really chooses to live like that? All alone in that horrible place? I'd lose my mind without anyone to talk to."
    reham "Ela realmente escolheu viver assim? Sozinha naquele lugar horrível? Eu enlouqueceria sem ninguém com quem conversar."

# game/script4.rpy:1755
translate pt_br_anubisbr scene105_choice02_op1_b4deed51:

#   mc "Some people prefer the quiet. The isolation."
    mc "Algumas pessoas preferem o silêncio. O isolamento."

# game/script4.rpy:1757
translate pt_br_anubisbr scene105_choice02_op1_a0bd1c1b:

#   m "*giggles* Still... that place must smell awful. All those flies and damp earth..."
    m "*risos* Mesmo assim... aquele lugar deve ter um cheiro horrível. Todas aquelas moscas e a terra úmida..."

# game/script4.rpy:1759
translate pt_br_anubisbr scene105_choice02_op1_8adf8732:

#   reham "Spare us the commentary, castle maiden."
    reham "Poupe-nos dos comentários, donzela do castelo."

# game/script4.rpy:1760
translate pt_br_anubisbr scene105_choice02_op1_c9f83daf:

#   reham "So... what did you do to her?"
    reham "Então... o que você fez com ela?"

# game/script4.rpy:1763
translate pt_br_anubisbr scene105_choice02_op1_2485f494:

#   mc "I..."
    mc "EU..."

# game/script4.rpy:1764
translate pt_br_anubisbr scene105_choice02_op1_e612037c:

#   m "..."
    m "..."

# game/script4.rpy:1765
translate pt_br_anubisbr scene105_choice02_op1_4fa4ac3b:

#   mc "I dealt with her."
    mc "Eu lidei com ela."

# game/script4.rpy:1767
translate pt_br_anubisbr scene105_choice02_op1_358f281c:

#   reham "...I see."
    reham "...Eu vejo."

# game/script4.rpy:1768
translate pt_br_anubisbr scene105_choice02_op1_4184abcc:

#   reham "That must have been difficult."
    reham "Isso deve ter sido difícil."

# game/script4.rpy:1770
translate pt_br_anubisbr scene105_choice02_op1_7abd8e32:

#   mc "She was too dangerous to leave free, so I captured her. She should be locked up in one of Irda's dungeons by now."
    mc "Ela era perigosa demais para ser deixada solta, então eu a capturei. Ela já deve estar trancada em uma das masmorras de Irda."

# game/script4.rpy:1772
translate pt_br_anubisbr scene105_choice02_op1_44ee3b0b:

#   reham "Just like that?"
    reham "Assim, sem mais nem menos?"

# game/script4.rpy:1774
translate pt_br_anubisbr scene105_choice02_op1_e3db7317:

#   mc "Just like that."
    mc "Assim, sem mais nem menos."

# game/script4.rpy:1778
translate pt_br_anubisbr scene105_choice02_op1_23cae7cc:

#   mc "I managed to make her see reason. She won't hurt anyone anymore... and she might even help us in the future."
    mc "Consegui fazê-la enxergar a razão. Ela não vai mais machucar ninguém... e pode até nos ajudar no futuro."

# game/script4.rpy:1780
translate pt_br_anubisbr scene105_choice02_op1_119c9fb4:

#   reham "You convinced a witch to turn good?! How?!"
    reham "Você convenceu uma bruxa a se tornar boa?! Como?!"

# game/script4.rpy:1781
translate pt_br_anubisbr scene105_choice02_op1_d0416113:

#   m "[mc] is good at talking!"
    m "[mc] É bom de papo!"

# game/script4.rpy:1783
translate pt_br_anubisbr scene105_choice02_op1_767854dd:

#   mc "*chuckles* Maybe she wasn't as evil as she seemed. Just... misunderstood."
    mc "*risos* Talvez ela não fosse tão má quanto parecia. Apenas... incompreendida."

# game/script4.rpy:1786
translate pt_br_anubisbr scene105_choice02_op1_aa678508:

#   m "More!"
    m "Mais!"

# game/script4.rpy:1793
translate pt_br_anubisbr scene105_choice02_op2_cc9da077:

#   mc "I was sent on an important mission by the Queen. On the way there, we stumbled upon this strange little village hidden in a valley."
    mc "Fui enviado em uma missão importante pela Rainha. No caminho, nos deparamos com essa pequena e estranha vila escondida em um vale."

# game/script4.rpy:1796
translate pt_br_anubisbr scene105_choice02_op2_7afea051:

#   reham "A haunted one?"
    reham "Uma casa assombrada?"

# game/script4.rpy:1798
translate pt_br_anubisbr scene105_choice02_op2_b71752a5:

#   mc "Not quite. Just... really weird."
    mc "Não exatamente. Só... muito estranho."

# game/script4.rpy:1800
translate pt_br_anubisbr scene105_choice02_op2_13a2508e:

#   env "The village lay quietly in a valley, untouched by any main road. Neat rows of houses with doors left wide open, dark windows, and a single stone well."
    env "A aldeia ficava tranquilamente situada num vale, intocada por qualquer estrada principal. Fileiras arrumadas de casas com portas escancaradas, janelas escuras e um único poço de pedra."

# game/script4.rpy:1802
translate pt_br_anubisbr scene105_choice02_op2_46985cff:

#   m "Where was everyone?"
    m "Onde estavam todos?"

# game/script4.rpy:1804
translate pt_br_anubisbr scene105_choice02_op2_5f537e8b:

#   mc "That's exactly what we wondered. Alex and I found a young girl and tried to ask her, but she took one look at us and ran away."
    mc "Era exatamente isso que nos perguntávamos. Alex e eu encontramos uma menina e tentamos perguntar a ela, mas ela nos olhou e fugiu."

# game/script4.rpy:1806
translate pt_br_anubisbr scene105_choice02_op2_bbf30e99:

#   reham "W-Were they... some kind of cult?"
    reham "Eram... algum tipo de seita?"

# game/script4.rpy:1808
translate pt_br_anubisbr scene105_choice02_op2_fbd96e0a:

#   mc "*laughs* You got it right. And it turns out they were all gathered in the main building... preparing for some festival."
    mc "*risos* Você acertou em cheio. E descobriu-se que eles estavam todos reunidos no prédio principal... se preparando para algum festival."

# game/script4.rpy:1809
translate pt_br_anubisbr scene105_choice02_op2_5a3073d1:

#   m "...That's it?"
    m "...É isso?"

# game/script4.rpy:1811
translate pt_br_anubisbr scene105_choice02_op2_eb5998c1:

#   mc "*ahem* Yeah, that's it."
    mc "*cof cof* É isso aí."

# game/script4.rpy:1813
translate pt_br_anubisbr scene105_choice02_op2_e3866aaf:

#   reham "Oh... how disappointing."
    reham "Ah... que decepção."

# game/script4.rpy:1815
translate pt_br_anubisbr scene105_choice02_op2_f579fdea:

#   mc "(Yeah... better leave out the part about it being a breeding festival.)"
    mc "(É... melhor omitir a parte sobre ser um festival de reprodução.)"

# game/script4.rpy:1817
translate pt_br_anubisbr scene105_choice02_op2_aa678508:

#   m "More!"
    m "Mais!"

# game/script4.rpy:1824
translate pt_br_anubisbr scene105_choice02_op3_490f93e7:

#   mc "Fine. I'll tell you about where I really came from, but I can't promise it'll be a fun story."
    mc "Tudo bem. Vou te contar de onde eu realmente vim, mas não posso prometer que será uma história divertida."

# game/script4.rpy:1827
translate pt_br_anubisbr scene105_choice02_op3_15598e58:

#   reham "Where you came from? You weren't born in Irda?"
    reham "De onde você veio? Você não nasceu em Irda?"

# game/script4.rpy:1829
translate pt_br_anubisbr scene105_choice02_op3_ed80887f:

#   mc "No. I was born somewhere... very far away."
    mc "Não. Eu nasci em algum lugar... muito distante."

# game/script4.rpy:1831
translate pt_br_anubisbr scene105_choice02_op3_231e8a9f:

#   m "Another kingdom?"
    m "Outro reino?"

# game/script4.rpy:1833
translate pt_br_anubisbr scene105_choice02_op3_ff6c0c04:

#   mc "Another world."
    mc "Outro mundo."

# game/script4.rpy:1836
translate pt_br_anubisbr scene105_choice02_op3_2e01646c:

#   env "Raindrops fall on streets lit by every color imaginable. Red, green, blue, yellow. Bright signs glow in the darkness, buzzing softly. People walk beneath umbrellas of all kinds, their footsteps splashing through puddles."
    env "Gotas de chuva caem em ruas iluminadas por todas as cores imagináveis. Vermelho, verde, azul, amarelo. Placas luminosas brilham na escuridão, emitindo um zumbido suave. Pessoas caminham sob guarda-chuvas de todos os tipos, seus passos respingando nas poças."

# game/script4.rpy:1837
translate pt_br_anubisbr scene105_choice02_op3_cef71525:

#   env "One man holds a small, flat rectangle to his ear and speaks quietly. A voice answers from the device. Both of them laugh."
    env "Um homem encosta um pequeno retângulo plano na orelha e fala baixinho. Uma voz responde vinda do aparelho. Os dois riem."

# game/script4.rpy:1838
translate pt_br_anubisbr scene105_choice02_op3_b6682eea:

#   env "A metal carriage without horses glides past, its bright lights cutting through the rain."
    env "Uma carruagem metálica sem cavalos passa deslizando, suas luzes brilhantes cortando a chuva."

# game/script4.rpy:1840
translate pt_br_anubisbr scene105_choice02_op3_3bd9bd15:

#   reham "What... is a 'phone'?"
    reham "O que... é um 'telefone'?"

# game/script4.rpy:1842
translate pt_br_anubisbr scene105_choice02_op3_15b685c7:

#   mc "It's a device that lets you speak to someone who's far away. Like magic... but it isn't magic."
    mc "É um dispositivo que permite falar com alguém que está longe. Como mágica... mas não é mágica."

# game/script4.rpy:1844
translate pt_br_anubisbr scene105_choice02_op3_bef87e0f:

#   m "And that carriage? How does it move without horses?"
    m "E aquela carruagem? Como ela se move sem cavalos?"

# game/script4.rpy:1846
translate pt_br_anubisbr scene105_choice02_op3_84ea92a7:

#   mc "*laughs* They have machines inside called engines. They burn fuel or use electricity. Honestly, I don't fully understand it myself."
    mc "*risos* Eles têm máquinas dentro chamadas motores. Queimam combustível ou usam eletricidade. Honestamente, eu mesmo não entendo completamente."

# game/script4.rpy:1848
translate pt_br_anubisbr scene105_choice02_op3_a66db6e5:

#   reham "They sound so practical."
    reham "Parecem tão práticas."

# game/script4.rpy:1850
translate pt_br_anubisbr scene105_choice02_op3_272d0c5e:

#   mc "They are. You can travel for hundreds of miles without needing to stop."
    mc "Sim, são. Você pode viajar centenas de quilômetros sem precisar parar."

# game/script4.rpy:1853
translate pt_br_anubisbr scene105_choice02_op3_5e00007d:

#   empathy "The fire crackles softly as your voice fades. Their faces shift... doubt, wonder, doubt again."
    empathy "O fogo crepita suavemente enquanto sua voz se dissipa. Os rostos deles mudam... dúvida, admiração, dúvida novamente."

# game/script4.rpy:1855
translate pt_br_anubisbr scene105_choice02_op3_b3748b91:

#   reham "...You're not lying, are you?"
    reham "...Você não está mentindo, está?"

