# game/script4.rpy:11397
translate pt_br_anubisbr scene121_44301a7f:

#   perception "You check Rebecca out of the hospice and make your way further into the city. The streets grow wider, cleaner, the buildings taller and more ornate."
    perception "Você acompanha Rebecca até a saída do centro de cuidados paliativos e segue seu caminho pela cidade. As ruas se tornam mais largas e limpas, os prédios mais altos e ornamentados."

# game/script4.rpy:11398
translate pt_br_anubisbr scene121_339122a5:

#   alex "Through here."
    alex "Por aqui."

# game/script4.rpy:11400
translate pt_br_anubisbr scene121_ccb49f56:

#   perception "You hear Rebecca's stomach grumble. Her cheeks flush in embarrassment."
    perception "Você ouve o estômago de Rebecca roncar. Suas bochechas coram de vergonha."

# game/script4.rpy:11402
translate pt_br_anubisbr scene121_49e90163:

#   r "Oh... *ahem* don't mind me."
    r "Ah... *cof cof* não se importem comigo."

# game/script4.rpy:11404
translate pt_br_anubisbr scene121_9357e8e8:

#   mc "Why don't we stop to eat once we're done with the king? Find the best restaurant in Nahraya and order everything on the menu."
    mc "Que tal pararmos para comer depois de terminarmos com o rei? Encontre o melhor restaurante em Nahraya e peça tudo do cardápio."

# game/script4.rpy:11406
translate pt_br_anubisbr scene121_34802062:

#   r "*chuckles* You're already planning the victory feast?"
    r "*risos* Você já está planejando o banquete da vitória?"

# game/script4.rpy:11408
translate pt_br_anubisbr scene121_a353d2df:

#   mc "What? You don't think you can do it?"
    mc "O quê? Você acha que não consegue?"

# game/script4.rpy:11410
translate pt_br_anubisbr scene121_f0848a0d:

#   r "Well, I'm not exactly good with politics. My mother did all the work. I was just... there."
    r "Bem, eu não entendo muito de política. Minha mãe fazia todo o trabalho. Eu só estava... lá."

# game/script4.rpy:11412
translate pt_br_anubisbr scene121_0617467e:

#   mc "You'll be fine. I trust you."
    mc "Você vai ficar bem. Eu confio em você."

# game/script4.rpy:11415
translate pt_br_anubisbr scene121_ff9b8df8:

#   perception "You reach a massive building with golden arches soaring overhead, colorful ceramic tiles forming intricate mosaic art."
    perception "Você chega a um prédio imponente com arcos dourados que se elevam acima da sua cabeça, e azulejos de cerâmica coloridos que formam uma intrincada arte em mosaico."

# game/script4.rpy:11417
translate pt_br_anubisbr scene121_455b98ac:

#   mc "We're right behind you, Becky. All the way."
    mc "Estamos com você em tudo, Becky. Até o fim."

# game/script4.rpy:11418
translate pt_br_anubisbr scene121_fd29fa74:

#   r "I... ermm..."
    r "Eu... hum..."

# game/script4.rpy:11420
translate pt_br_anubisbr scene121_1ed74d2e:

#   r "*ahem* Excuse me! I want to see the king."
    r "*cof cof* Com licença! Quero ver o rei."

# game/script4.rpy:11421
translate pt_br_anubisbr scene121_e5e33de9:

#   guard "None may enter his presence without leave."
    guard "Ninguém pode entrar em sua presença sem permissão."

# game/script4.rpy:11422
translate pt_br_anubisbr scene121_87bcec2e:

#   r "D-Don't you know who I am? I am Irda's princess! Daughter of Queen Hannah!"
    r "— Você não sabe quem eu sou? Eu sou a princesa de Irda! Filha da Rainha Hannah!"

# game/script4.rpy:11423
translate pt_br_anubisbr scene121_869dee03:

#   guard "None may enter his presence without leave. Stand back!"
    guard "Ninguém pode entrar em sua presença sem permissão. Afastem-se!"

# game/script4.rpy:11424
translate pt_br_anubisbr scene121_874380a2:

#   mc "Maybe you can be a little more... professional? Less shouting, more... authority?"
    mc "Talvez você possa ser um pouco mais... profissional? Menos gritos, mais... autoridade?"

# game/script4.rpy:11425
translate pt_br_anubisbr scene121_db304d5a:

#   alex "I knew it wouldn't be that easy."
    alex "Eu sabia que não seria tão fácil."

# game/script4.rpy:11427
translate pt_br_anubisbr scene121_42b9a2eb:

#   mc "Hmm? Wait..."
    mc "Hum? Espere..."

# game/script4.rpy:11428
translate pt_br_anubisbr scene121_b53bcc4f:

#   amb "Open the gates! I have official business with the king. He's expecting me."
    amb "Abram os portões! Tenho assuntos oficiais a tratar com o rei. Ele está me esperando."

# game/script4.rpy:11429
translate pt_br_anubisbr scene121_c04968ed:

#   guard "Right away, sir."
    guard "Imediatamente, senhor."

# game/script4.rpy:11430
translate pt_br_anubisbr scene121_cb02732e:

#   mc "Wait—I know this guy! He was talking to the Queen back it Irda before all this went down."
    mc "Espere aí—eu conheço esse cara! Ele estava conversando com a Rainha em Irda antes de tudo isso acontecer."

# game/script4.rpy:11432
translate pt_br_anubisbr scene121_7da11808:

#   r "I know him too! Excuse me! Ambassador Sanoud!"
    r "Eu também o conheço! Com licença! Embaixador Sanoud!"

# game/script4.rpy:11434
translate pt_br_anubisbr scene121_850449a0:

#   amb "If you have issues, go to the court, citizen. This is his royal highness's palace, not a public forum. I don't have time for—"
    amb "Se tiver algum problema, dirija-se ao tribunal, cidadão. Este é o palácio de Sua Alteza Real, não um fórum público. Não tenho tempo para—"

# game/script4.rpy:11436
translate pt_br_anubisbr scene121_03635bd5:

#   amb "P-Princess of Irda?! What in the Gods' name are you doing here?"
    amb "Princesa de Irda?! O que você está fazendo aqui, em nome dos deuses?"

# game/script4.rpy:11437
translate pt_br_anubisbr scene121_f4d0ec66:

#   amb "I thought you were... on trial."
    amb "Pensei que você estivesse... sendo julgado."

# game/script4.rpy:11438
translate pt_br_anubisbr scene121_f87fd3b3:

#   amb "In fact, I've seen all three of you before! What's going on here?!"
    amb "Na verdade, eu já vi vocês três antes! O que está acontecendo aqui?!"

# game/script4.rpy:11440
translate pt_br_anubisbr scene121_7bf13600:

#   r "I..."
    r "EU..."

# game/script4.rpy:11442
translate pt_br_anubisbr scene121_8887d7ef:

#   mc "You can do it, Becky."
    mc "Você consegue, Becky."

# game/script4.rpy:11445
translate pt_br_anubisbr scene121_4733dc22:

#   r "*inhale* I was falsely accused. Avery, the current queen, took the throne by force. She orchestrated a coup with Reiner of Eurina."
    r "*Inspira* Fui falsamente acusada. Avery, a atual rainha, tomou o trono à força. Ela orquestrou um golpe de estado com Reiner de Eurina."

# game/script4.rpy:11446
translate pt_br_anubisbr scene121_988326c9:

#   r "My mother, Queen Hannah... she's been killed. Murdered. The ship accident was a lie."
    r "Minha mãe, a Rainha Hannah... ela foi morta. Assassinada. O acidente com o navio foi uma mentira."

# game/script4.rpy:11449
translate pt_br_anubisbr scene121_618a2014:

#   r "My mother, Queen Hannah—she had an attempt on her life, but she survived. She's hiding right now."
    r "Minha mãe, a Rainha Hannah, sofreu uma tentativa de assassinato, mas sobreviveu. Ela está escondida neste momento."

# game/script4.rpy:11451
translate pt_br_anubisbr scene121_4f3bcfd7:

#   r "Please. I must speak to your king. This is of utmost importance to your kingdom as well."
    r "Por favor. Preciso falar com o seu rei. Isso é de suma importância também para o seu reino."

# game/script4.rpy:11452
translate pt_br_anubisbr scene121_8c7aef90:

#   r "Reiner won't stop at Irda. Nahraya might be in danger too."
    r "Reiner não vai parar em Irda. Nahraya também pode estar em perigo."

# game/script4.rpy:11454
translate pt_br_anubisbr scene121_966a6b0a:

#   amb "..."
    amb "..."

# game/script4.rpy:11456
translate pt_br_anubisbr scene121_2efb50aa:

#   amb "Very well. I believe the conviction in your eyes. And I remember your mother. She didn't deserve what happened to her."
    amb "Muito bem. Acredito na convicção em seus olhos. E me lembro da sua mãe. Ela não merecia o que lhe aconteceu."

# game/script4.rpy:11457
translate pt_br_anubisbr scene121_0deac247:

#   amb "Leave any weapons you have with the guards and follow me."
    amb "Deixe suas armas com os guardas e siga-me."

# game/script4.rpy:11459
translate pt_br_anubisbr scene121_c265bda4:

#   r "Thank you."
    r "Obrigado."

# game/script4.rpy:11463
translate pt_br_anubisbr scene121_4f1d3531:

#   mc "You did it."
    mc "Você conseguiu."

# game/script4.rpy:11464
translate pt_br_anubisbr scene121_e631877c:

#   r "Hmm~? Did I hear doubt in your voice earlier?"
    r "Hum...? Percebi alguma dúvida na sua voz mais cedo?"

# game/script4.rpy:11465
translate pt_br_anubisbr scene121_18f5f0d7:

#   mc "Doubting my intelligent, incredibly beautiful princess? Heresy."
    mc "Duvidar da minha princesa inteligente e incrivelmente bela? Heresia."

# game/script4.rpy:11466
translate pt_br_anubisbr scene121_85a3a72c:

#   alex "You two are starting to annoy me."
    alex "Vocês dois estão começando a me irritar."

# game/script4.rpy:11471
translate pt_br_anubisbr scene121_df092cfa:

#   perception "You enter the palace, it's exceptionally beautiful and clean. Every surface polished to a mirror shine, every floor a mosaic of colored tiles depicting the history of Nahraya."
    perception "Ao entrar no palácio, você se depara com uma beleza e limpeza excepcionais. Cada superfície polida brilha como um espelho, cada piso um mosaico de azulejos coloridos que retratam a história de Nahraya."

# game/script4.rpy:11472
translate pt_br_anubisbr scene121_dd6e116f:

#   amb "Please keep with me. Don't go anywhere, don't make any sudden moves, and don't touch anything."
    amb "Por favor, fique comigo. Não vá a lugar nenhum, não faça movimentos bruscos e não toque em nada."

# game/script4.rpy:11473
translate pt_br_anubisbr scene121_bb098ebd:

#   amb "When we reach the king, you kneel. You show respect. And most importantly, you never speak unless—"
    amb "Ao chegarmos ao rei, você se ajoelha. Você demonstra respeito. E, mais importante, você nunca fala a menos que—"

# game/script4.rpy:11474
translate pt_br_anubisbr scene121_c07fb3ef:

#   mc "Unless spoken to. I know. I already went through this before."
    mc "A menos que falem comigo. Eu sei. Já passei por isso antes."

# game/script4.rpy:11475
translate pt_br_anubisbr scene121_7859219a:

#   amb "You're exempt from kneeling, princess of Irda. But that still doesn't mean you don't show proper respect."
    amb "Princesa de Irda, você está dispensada de se ajoelhar. Mas isso não significa que não deva demonstrar o devido respeito."

# game/script4.rpy:11477
translate pt_br_anubisbr scene121_64039ca4:

#   amb "My liege, I have news of the grain bill with the Zents. Progress has been made, though they demand tariffs be lifted."
    amb "Meu senhor, tenho notícias sobre a proposta de lei do grão com os Zents. Houve progresso, embora eles exijam a suspensão das tarifas."

# game/script4.rpy:11478
translate pt_br_anubisbr scene121_77175087:

#   amb "I also have a guest for—"
    amb "Eu também tenho um convidado para—"

# game/script4.rpy:11480
translate pt_br_anubisbr scene121_080117db:

#   king "Shh."
    king "Shh."

# game/script4.rpy:11483
translate pt_br_anubisbr scene121_6afc89d6:

#   amb "{size=30}Kneel!{/size}"
    amb "{size=30}Ajoelhe-se!{/size}"

# game/script4.rpy:11448
translate pt_br_anubisbr scene121_4733dc22_1:

#   r "*inhale* I was falsely accused. Avery, the current queen, took the throne by force. She orchestrated a coup with Reiner of Eurina."
    r "*Inspira* Fui falsamente acusada. Avery, a atual rainha, tomou o trono à força. Ela orquestrou um golpe de estado com Reiner de Eurina."

# game/script4.rpy:11481
translate pt_br_anubisbr scene121_966a6b0a_1:

#   amb "..."
    amb "..."

# game/script4.rpy:11490
translate pt_br_anubisbr scene120_choice08_op1_c4a9e916:

#   perception "You lower yourself to one knee. The marble is cold beneath you. Alex does the same, her movements stiff but obedient."
    perception "Você se ajoelha. O mármore está frio sob você. Alex faz o mesmo, seus movimentos rígidos, mas obedientes."

# game/script4.rpy:11492
translate pt_br_anubisbr scene120_choice08_op1_92436f31:

#   perception "You glance upwards. To the king's left stands a young woman dressed in flowing silks. Likely the princess. She doesn't look at you. Her gaze is fixed on Alex, her expression unreadable, curiosity? Recognition?"
    perception "Você ergue o olhar. À esquerda do rei está uma jovem vestida com sedas esvoaçantes. Provavelmente a princesa. Ela não olha para você. Seu olhar está fixo em Alex, sua expressão indecifrável, curiosidade? Reconhecimento?"

# game/script4.rpy:11494
translate pt_br_anubisbr scene120_choice08_op1_9aaa9b64:

#   perception "To the right of the king is a... man? Likely the prince. His eyes are fixed on you. More specifically, on your metal hand."
    perception "À direita do rei está um... homem? Provavelmente o príncipe. Seus olhos estão fixos em você. Mais especificamente, em sua mão de metal."

# game/script4.rpy:11505
translate pt_br_anubisbr scene120_choice08_op2_1fa0dad2:

#   perception "The ambassador shoots you a look of pure panic as you stay still. Your eyes are fixed on the king."
    perception "O embaixador lança-lhe um olhar de puro pânico enquanto você permanece imóvel. Seus olhos estão fixos no rei."

# game/script4.rpy:11507
translate pt_br_anubisbr scene120_choice08_op2_474da223:

#   perception "You glance left. The young woman, likely the princess, stands beside the king and looks at you with worry. She's seen people defy her father before. She knows how it ends."
    perception "Você olha para a esquerda. A jovem, provavelmente a princesa, está ao lado do rei e olha para você com preocupação. Ela já viu pessoas desafiarem seu pai antes. Ela sabe como isso termina."

# game/script4.rpy:11509
translate pt_br_anubisbr scene120_choice08_op2_f610057e:

#   perception "To the right of the king is a... man? Likely the prince. He looks at you with a smirk as if your defiance is amusing."
    perception "À direita do rei está um... homem? Provavelmente o príncipe. Ele olha para você com um sorriso irônico, como se sua afronta fosse divertida."

# game/script4.rpy:11519
translate pt_br_anubisbr scene121_2_b10c7b34:

#   king "You."
    king "Você."

# game/script4.rpy:11521
translate pt_br_anubisbr scene121_2_70b2c612:

#   alex "M-Me?"
    alex "E-Eu?"

# game/script4.rpy:11523
translate pt_br_anubisbr scene121_2_a7ecf3db:

#   king "You're Reiner's daughter. He said you ran away again. He's been looking for you—sent letters, messengers, even a bounty at one point."
    king "Você é filha do Reiner. Ele disse que você fugiu de novo. Ele está te procurando há tempos — enviou cartas, mensageiros e até ofereceu uma recompensa."

# game/script4.rpy:11524
translate pt_br_anubisbr scene121_2_30489794:

#   king "I remember faces, and yours was described in great detail. Why did you come here?"
    king "Lembro-me de rostos, e o seu foi descrito com muitos detalhes. Por que você veio aqui?"

# game/script4.rpy:11526
translate pt_br_anubisbr scene121_2_9156e602:

#   alex "I..."
    alex "EU..."

# game/script4.rpy:11528
translate pt_br_anubisbr scene121_2_2c5dc546:

#   r "Sir... I mean, my liege? Could I speak to you? Please. Before this goes any further."
    r "Senhor... quer dizer, meu senhor? Poderia falar com o senhor? Por favor. Antes que isso vá mais longe."

# game/script4.rpy:11531
translate pt_br_anubisbr scene121_2_08840dbe:

#   king "Why isn't that man kneeling? Have you no control over your slaves?"
    king "Por que aquele homem não está ajoelhado? Vocês não têm controle sobre seus escravos?"

# game/script4.rpy:11534
translate pt_br_anubisbr scene121_2_50750a7c:

#   r "He's not a slave. He's my husband. Please forgive his disrespect... he's unused to court protocol."
    r "Ele não é um escravo. Ele é meu marido. Por favor, perdoe a falta de respeito dele... ele não está acostumado com o protocolo do tribunal."

# game/script4.rpy:11536
translate pt_br_anubisbr scene121_2_25dd7469:

#   r "Please forgive his disrespect... he's unused to court protocol."
    r "Por favor, perdoe a falta de respeito dele... ele não está acostumado com o protocolo do tribunal."

# game/script4.rpy:11538
translate pt_br_anubisbr scene121_2_6b4f5c8e:

#   king "Have I seen you before? Your face is familiar too."
    king "Já te vi antes? Seu rosto também me é familiar."

# game/script4.rpy:11540
translate pt_br_anubisbr scene121_2_500cc1e6:

#   r "I'm Queen Hannah's daughter. The princess of Irda. Rebecca."
    r "Sou filha da Rainha Hannah. Princesa de Irda. Rebecca."

# game/script4.rpy:11541
translate pt_br_anubisbr scene121_2_cdfb3134:

#   king "..."
    king "..."

# game/script4.rpy:11543
translate pt_br_anubisbr scene121_2_b66e3ed6:

#   empathy "The king's expression suddenly changes. The anger and suspicion melt away, replaced by disbelief."
    empathy "A expressão do rei muda subitamente. A raiva e a suspeita dissipam-se, dando lugar à incredulidade."

# game/script4.rpy:11545
translate pt_br_anubisbr scene121_2_510b9614:

#   king "How? The reports said you were imprisoned. Charged with treason."
    king "Como? Os relatórios diziam que você foi preso. Acusado de traição."

# game/script4.rpy:11547
translate pt_br_anubisbr scene121_2_31ee4b96:

#   r "My aunt... Avery, she orchestrated a plan with Reiner of Eurina."
    r "Minha tia... Avery, ela arquitetou um plano com Reiner para Eurina."

# game/script4.rpy:11549
translate pt_br_anubisbr scene121_2_dfe9468c:

#   r "The plan was to assassinate my mother and have her take the throne. Thankfully, she survived and is now in hiding. She's completely powerless, but alive."
    r "O plano era assassinar minha mãe e fazê-la assumir o trono. Felizmente, ela sobreviveu e agora está escondida. Ela está completamente impotente, mas viva."

# game/script4.rpy:11551
translate pt_br_anubisbr scene121_2_8205c86a:

#   r "The plan was to assassinate my mother and have her take the throne. She murdered her way into power."
    r "O plano era assassinar minha mãe e fazê-la assumir o trono. Ela ascendeu ao poder através de assassinatos."

# game/script4.rpy:11552
translate pt_br_anubisbr scene121_2_8b7ec91b:

#   r "She held me in a cellar for weeks. I was on my way to be executed, but my husband here saved me before it happened."
    r "Ela me manteve presa em um porão por semanas. Eu estava prestes a ser executada, mas meu marido me salvou antes que isso acontecesse."

# game/script4.rpy:11554
translate pt_br_anubisbr scene121_2_475cd202:

#   king "Impossible... Last I heard was that your mother died in a ship accident. I mourned her. I sent condolences to your aunt. I—"
    king "Impossível... A última notícia que tive foi que sua mãe morreu em um acidente de navio. Lamentei muito por ela. Enviei condolências à sua tia. Eu—"

# game/script4.rpy:11556
translate pt_br_anubisbr scene121_2_8e15d4d4:

#   r "It was a lie. All of it. Every word Avery has spoken since the day she took the throne has been a lie."
    r "Foi tudo mentira. Cada palavra que Avery disse desde o dia em que assumiu o trono foi mentira."

# game/script4.rpy:11559
translate pt_br_anubisbr scene121_2_b30ae926:

#   king "Do you have proof for this?! Something beyond your word?"
    king "Você tem provas disso?! Algo além da sua palavra?"

# game/script4.rpy:11561
translate pt_br_anubisbr scene121_2_b00281d0:

#   r "I am telling you this as her only daughter. All I have is what I endured."
    r "Digo isso como sua única filha. Tudo o que me resta é o que suportei."

# game/script4.rpy:11562
translate pt_br_anubisbr scene121_2_fb6cf57d:

#   r "She kept me locked in that cellar while she taunted me almost every night. She told me everything... how she'd planned it, how she'd executed it, how no one would ever know."
    r "Ela me manteve trancada naquele porão enquanto me atormentava quase todas as noites. Ela me contava tudo... como havia planejado, como havia executado, como ninguém jamais descobriria."

# game/script4.rpy:11564
translate pt_br_anubisbr scene121_2_e0d90085:

#   alex "She tells the truth."
    alex "Ela diz a verdade."

# game/script4.rpy:11565
translate pt_br_anubisbr scene121_2_cd70478a:

#   king "Reiner's daughter... and Irda's daughter... both here in my throne room. Both telling the same story."
    king "A filha de Reiner... e a filha de Irda... ambas aqui na minha sala do trono. Ambas contando a mesma história."

# game/script4.rpy:11567
translate pt_br_anubisbr scene121_2_6df5c895:

#   king "It was all too convenient. The 'accident'. The 'treason'. The way everything fell so neatly into place for Avery..."
    king "Tudo foi conveniente demais. O \"acidente\". A \"traição\". A forma como tudo se encaixou perfeitamente para Avery..."

# game/script4.rpy:11568
translate pt_br_anubisbr scene121_2_c41b2db0:

#   king "*cough* I see it now."
    king "*tosse* Agora entendi."

# game/script4.rpy:11570
translate pt_br_anubisbr scene121_2_db85430a:

#   prince "Father?!"
    prince "Pai?!"

# game/script4.rpy:11571
translate pt_br_anubisbr scene121_2_b38602ab:

#   amb "My liege?! Bring water! Quickly!"
    amb "Meu senhor?! Traga água! Rápido!"

# game/script4.rpy:11573
translate pt_br_anubisbr scene121_2_ccf3d53e:

#   king "They lied to me... They played me for a fool."
    king "Eles mentiram para mim... Fizeram-me de tolo."

# game/script4.rpy:11574
translate pt_br_anubisbr scene121_2_dff5b44a:

#   king "Reiner... Avery... I welcomed them. I called them allies."
    king "Reiner... Avery... Eu os recebi de braços abertos. Eu os chamei de aliados."

# game/script4.rpy:11576
translate pt_br_anubisbr scene121_2_478df3e8:

#   king "I will get them back for this. I swear on my life. On my crown."
    king "Eu vou me vingar deles. Juro pela minha vida. Pela minha coroa."

# game/script4.rpy:11578
translate pt_br_anubisbr scene121_2_993b2402:

#   king "I will get them back for this. I swear on my life. On my crown. On the memory of your mother, who deserved none of this."
    king "Eu vou me vingar. Juro pela minha vida. Pela minha coroa. Pela memória da sua mãe, que não merecia nada disso."

# game/script4.rpy:11580
translate pt_br_anubisbr scene121_2_b8c1b50e:

#   amb "M-My liege, please think this thoroughly. We can't lunge into war this quickly."
    amb "Meu senhor, por favor, reflita bem sobre isso. Não podemos nos precipitar em uma guerra tão rapidamente."

# game/script4.rpy:11582
translate pt_br_anubisbr scene121_2_a9b4e722:

#   king "...Yes. They believe I am still blind to it... I can take advantage of that."
    king "Sim. Eles acreditam que eu ainda não percebi isso... Posso tirar proveito disso."

# game/script4.rpy:11583
translate pt_br_anubisbr scene121_2_6a488e6f:

#   king "Just you wait."
    king "Aguarde e verá."

# game/script4.rpy:11585
translate pt_br_anubisbr scene121_2_b549ab6b:

#   king "*sigh* As for now... prepare a bedchamber for the princess! The biggest one!"
    king "*suspiro* Por agora... preparem um quarto para a princesa! O maior de todos!"

# game/script4.rpy:11586
translate pt_br_anubisbr scene121_2_94c304ad:

#   king "And assinge twenty servants for her."
    king "E designem vinte servos para ela."

# game/script4.rpy:11588
translate pt_br_anubisbr scene121_2_6bce3a50:

#   servant "Yes, my liege."
    servant "Sim, meu senhor."

# game/script4.rpy:11590
translate pt_br_anubisbr scene121_2_fe087a89:

#   mc "Great job, Becky."
    mc "Ótimo trabalho, Becky."

# game/script4.rpy:11591
translate pt_br_anubisbr scene121_2_25b0e8df:

#   mc "You might get treated here better than in Irda."
    mc "Você pode ser tratado melhor aqui do que em Irda."

# game/script4.rpy:11593
translate pt_br_anubisbr scene121_2_ac39d644:

#   r "Not complaning~"
    r "Não estou reclamando~"

# game/script4.rpy:11594
translate pt_br_anubisbr scene121_2_17fe9583:

#   r "Come on! Let's check out the room."
    r "Vamos lá! Vamos dar uma olhada no quarto."

# game/script4.rpy:11596
translate pt_br_anubisbr scene121_2_4643ba63:

#   r "They better give us some privacy because I want you~"
    r "É melhor nos darem um pouco de privacidade porque eu quero você~"

# game/script4.rpy:11598
translate pt_br_anubisbr scene121_2_f68b77d9:

#   mc "*chuckles* Coming."
    mc "*risos* Já vou."

# game/script4.rpy:11557
translate pt_br_anubisbr scene121_2_cdfb3134_1:

#   king "..."
    king "..."

# game/script4.rpy:11603
translate pt_br_anubisbr scene122_64fddc49:

#   alex "I don't know... The princess could have gotten us a quick and easy way in."
    alex "Não sei... A princesa poderia ter nos arranjado um jeito fácil e rápido de entrar."

# game/script4.rpy:11605
translate pt_br_anubisbr scene122_06724d39:

#   mc "Enough, Alex. We're already here. Dwelling on it won't change anything."
    mc "Chega, Alex. Já estamos aqui. Ficar remoendo isso não vai mudar nada."

# game/script4.rpy:11608
translate pt_br_anubisbr scene122_0cc92b27:

#   alex "I'm not dwelling. I'm stating facts. Without Rebecca, we're nobody. But no! You had to save those two guards and leave her behind."
    alex "Não estou remoendo o passado. Estou apenas constatando fatos. Sem Rebecca, não somos ninguém. Mas não! Você tinha que salvar aqueles dois guardas e deixá-la para trás."

# game/script4.rpy:11610
translate pt_br_anubisbr scene122_597dbd1c:

#   alex "I'm not dwelling. I'm stating facts. Without Rebecca, we're nobody. *sigh* We couldn't even begin our mission."
    alex "Não estou remoendo o passado. Estou apenas constatando fatos. Sem Rebecca, não somos ninguém. *suspiro* Nem sequer conseguimos começar nossa missão."

# game/script4.rpy:11612
translate pt_br_anubisbr scene122_64c4e3cd:

#   alex "I'm not dwelling. I'm stating facts. Without Rebecca, we're nobody. But no! You had to listen to Reham."
    alex "Não estou remoendo o passado. Estou apenas constatando fatos. Sem Rebecca, não somos ninguém. Mas não! Você tinha que ouvir a Reham."

# game/script4.rpy:11614
translate pt_br_anubisbr scene122_7bedf41e:

#   mc "We'll just have to look more—"
    mc "Teremos que procurar mais—"

# game/script4.rpy:11616
translate pt_br_anubisbr scene122_693efef8:

#   alex "Holy shit!"
    alex "Caramba!"

# game/script4.rpy:11618
translate pt_br_anubisbr scene122_11455b53:

#   mc "What?"
    mc "O que?"

# game/script4.rpy:11620
translate pt_br_anubisbr scene122_faabd764:

#   alex "That carriage!"
    alex "Aquela carruagem!"

# game/script4.rpy:11621
translate pt_br_anubisbr scene122_32188274:

#   mc "What about it?"
    mc "E daí?"

# game/script4.rpy:11623
translate pt_br_anubisbr scene122_4fb69477:

#   whitlaw "Don't come any closer!"
    whitlaw "Não se aproxime mais!"

# game/script4.rpy:11625
translate pt_br_anubisbr scene122_cfd12641:

#   q "It's alright, Witlow. They're with me."
    q "Está tudo bem, Witlow. Eles estão comigo."

# game/script4.rpy:11626
translate pt_br_anubisbr scene122_706c5c40:

#   q "Get in you two. We have much to discuss."
    q "Entrem vocês dois. Temos muito o que conversar."

# game/script4.rpy:11630
translate pt_br_anubisbr scene122_212bf81c:

#   perception "The carriage is cold. A complete contrast to the desert heat outside."
    perception "A carruagem está fria. Um contraste total com o calor do deserto lá fora."

# game/script4.rpy:11631
translate pt_br_anubisbr scene122_2b35b6fe:

#   mc "..."
    mc "..."

# game/script4.rpy:11632
translate pt_br_anubisbr scene122_9995f74b:

#   alex "..."
    alex "..."

# game/script4.rpy:11634
translate pt_br_anubisbr scene122_a2a05660:

#   q "*chuckles* Too stunned to speak?"
    q "*risos* Sem palavras, sem palavras?"

# game/script4.rpy:11636
translate pt_br_anubisbr scene122_ee13fab0:

#   mc "Queen! H-How did you get here?!"
    mc "Rainha! C-Como você chegou aqui?!"

# game/script4.rpy:11637
translate pt_br_anubisbr scene122_0dbe90f0:

#   mc "Alex told me you were hiding!"
    mc "Alex me disse que você estava se escondendo!"

# game/script4.rpy:11639
translate pt_br_anubisbr scene122_8eb3ace6:

#   q "I was hiding. In a rather damp fishing village on the coast of Eurina, to be precise. Until a certain feeling pulled me here."
    q "Eu estava me escondendo. Em uma vila de pescadores bastante úmida na costa de Eurina, para ser mais preciso. Até que um certo sentimento me trouxe para cá."

# game/script4.rpy:11640
translate pt_br_anubisbr scene122_726a58dd:

#   q "I trained in prediction sorcery. It isn't much, but it helps me every now and then."
    q "Treinei feitiçaria de predição. Não é grande coisa, mas me ajuda de vez em quando."

# game/script4.rpy:11641
translate pt_br_anubisbr scene122_25ccdd10:

#   q "When I felt the threads of fate converging on Nahraya, I knew I had to come."
    q "Quando senti os fios do destino convergindo para Nahraya, soube que tinha que vir."

# game/script4.rpy:11643
translate pt_br_anubisbr scene122_45c95e11:

#   alex "Does that mean... you already knew what I was about to do back then? When I—"
    alex "Isso significa que... você já sabia o que eu ia fazer naquela época? Quando eu—"

# game/script4.rpy:11645
translate pt_br_anubisbr scene122_f1818904:

#   q "I did. I sensed your intent the moment you came near me."
    q "Sim, percebi. Senti sua intenção no momento em que você se aproximou de mim."

# game/script4.rpy:11647
translate pt_br_anubisbr scene122_2fb4905d:

#   alex "...Y-You knew. And you still trusted me?"
    alex "...Você sabia. E mesmo assim confiou em mim?"

# game/script4.rpy:11649
translate pt_br_anubisbr scene122_8535477d:

#   q "Indeed. Because I also sensed the desperation in your heart. Or rather seen in through your stoic expression."
    q "Sim. Porque eu também senti o desespero em seu coração. Ou melhor, percebi através de sua expressão estoica."

# game/script4.rpy:11653
translate pt_br_anubisbr scene122_cdfc6fb4:

#   mc "Why is it so chilly in here? It feels... unnatural."
    mc "Por que está tão frio aqui? Parece... anormal."

# game/script4.rpy:11655
translate pt_br_anubisbr scene122_c51b3845:

#   q "Feels good, doesn't it? Journeying through the desert is so much easier when you have convenient magic like this."
    q "É uma sensação boa, não é? Viajar pelo deserto fica muito mais fácil quando se tem uma magia prática como essa."

# game/script4.rpy:11656
translate pt_br_anubisbr scene122_0682fc5c:

#   q "A simple cooling enchantment. It can be sustained for long periods as it drains very little mana."
    q "Um encantamento de resfriamento simples. Pode ser mantido por longos períodos, pois consome muito pouca mana."

# game/script4.rpy:11658
translate pt_br_anubisbr scene122_9ba21841:

#   alex "I-I thought you weren't that good with magic. You told me you knew basic protection spells."
    alex "Eu achava que você não era tão bom em magia. Você me disse que conhecia feitiços básicos de proteção."

# game/script4.rpy:11660
translate pt_br_anubisbr scene122_a76997a7:

#   q "What kind of ruler would lay all her cards on one table? Of course I knew more, little fledgling."
    q "Que tipo de governante revelaria todas as suas cartas de uma só vez? É claro que eu sabia mais, pequena novata."

# game/script4.rpy:11662
translate pt_br_anubisbr scene122_0051ca46:

#   mc "Forget that. Isn't it dangerous for you to show up like this?"
    mc "Esqueça isso. Não é perigoso você aparecer assim?"

# game/script4.rpy:11664
translate pt_br_anubisbr scene122_41b03cb3:

#   q "I won't lie, escaping Eurina's seas was rather gut wrenching, but I couldn't ignore my premonition."
    q "Não vou mentir, escapar dos mares de Eurina foi bastante angustiante, mas não pude ignorar minha premonição."

# game/script4.rpy:11665
translate pt_br_anubisbr scene122_218e4c54:

#   q "My hope was that you two would bring my daughter here. She would have walked into the palace, and the king would have recognized her."
    q "Minha esperança era que vocês dois trouxessem minha filha aqui. Ela teria entrado no palácio e o rei a teria reconhecido."

# game/script4.rpy:11666
translate pt_br_anubisbr scene122_3bcc9faa:

#   q "She would have taken it from there. *chuckles* Perhaps even more. Perhaps she would even be the new ruler of Irda instead of my son."
    q "Ela teria assumido o controle a partir daí. *risos* Talvez até mais. Talvez ela até se tornasse a nova governante de Irda em vez do meu filho."

# game/script4.rpy:11669
translate pt_br_anubisbr scene122_b1c1ef98:

#   mc "I'm sorry, your majesty. We thought we could convince the king without attempting a rescue that might endanger so many people."
    mc "Sinto muito, majestade. Pensávamos que poderíamos convencer o rei sem tentar um resgate que pudesse colocar tantas pessoas em perigo."

# game/script4.rpy:11670
translate pt_br_anubisbr scene122_029a3161:

#   mc "We thought we could somehow get help regardless, but... well. Before we could think of anything else... there you were."
    mc "Pensávamos que de alguma forma conseguiríamos ajuda, mas... bem. Antes que pudéssemos pensar em qualquer outra coisa... lá estava você."

# game/script4.rpy:11673
translate pt_br_anubisbr scene122_645715d8:

#   mc "We tried, your majesty. We planned thoroughly. I even saw her, but... we still couldn't pull it off."
    mc "Tentamos, majestade. Planejamos tudo minuciosamente. Eu até a vi, mas... mesmo assim não conseguimos."

# game/script4.rpy:11675
translate pt_br_anubisbr scene122_e490cbe6:

#   mc "We tried, your majesty. We tried, but... we still couldn't pull it off."
    mc "Tentamos, majestade. Tentamos, mas... ainda não conseguimos."

# game/script4.rpy:11677
translate pt_br_anubisbr scene122_126f09aa:

#   q "I only hope your failure didn't bring down others with you."
    q "Só espero que seu fracasso não tenha arrastado outros consigo."

# game/script4.rpy:11679
translate pt_br_anubisbr scene122_914415a0:

#   mc "Everyone should be fine, we left before any alarms were raised."
    mc "Deve estar tudo bem com todos, saímos antes de qualquer alarme ser acionado."

# game/script4.rpy:11682
translate pt_br_anubisbr scene122_815e679b:

#   q "It doesn't matter now. Hod and I are old friends. He will listen once we arrive to his palace."
    q "Não importa agora. Hod e eu somos velhos amigos. Ele nos ouvirá quando chegarmos ao seu palácio."

# game/script4.rpy:11684
translate pt_br_anubisbr scene122_5e2ddd8a:

#   q "As for my daughter..."
    q "Quanto à minha filha..."

# game/script4.rpy:11686
translate pt_br_anubisbr scene122_d4c853f8:

#   alex "What is it?"
    alex "O que é?"

# game/script4.rpy:11688
translate pt_br_anubisbr scene122_196264b1:

#   q "Marching an army west, declaring war would be a disaster."
    q "Marchar com um exército para o oeste e declarar guerra seria um desastre."

# game/script4.rpy:11689
translate pt_br_anubisbr scene122_49c822d1:

#   q "It's better to play it safe. To continue the oblivious act while we wait for the perfect time to strike."
    q "É melhor jogar pelo seguro. Continuar fingindo despreocupação enquanto esperamos o momento perfeito para atacar."

# game/script4.rpy:11691
translate pt_br_anubisbr scene122_2a90fa48:

#   mc "Your majesty... are you saying that we should forget about Rebecca?"
    mc "Majestade... está dizendo que devemos esquecer Rebecca?"

# game/script4.rpy:11693
translate pt_br_anubisbr scene122_baf1d39d:

#   q "Unfortunately... yes. For the time being."
    q "Infelizmente... sim. Por enquanto."

# game/script4.rpy:11695
translate pt_br_anubisbr scene122_609c304f:

#   mc "How could you say that about your daughter?! She doesn't deserve what's happening to her!"
    mc "Como você pode dizer isso da sua filha?! Ela não merece o que está acontecendo com ela!"

# game/script4.rpy:11697
translate pt_br_anubisbr scene122_3fba431b:

#   q "I didn't say she deserved it, [mc]."
    q "Eu não disse que ela merecia isso, [mc]."

# game/script4.rpy:11698
translate pt_br_anubisbr scene122_6c202e98:

#   q "It's either a full-out war, or we play it smart and have them continue the charade. We will dismantle them from within. Then... and only then will we strike."
    q "Ou é uma guerra total, ou jogamos com inteligência e os deixamos continuar com a farsa. Vamos desmantelá-los por dentro. Então... e somente então atacaremos."

# game/script4.rpy:11702
translate pt_br_anubisbr scene122_c35fdabe:

#   mc "Is... is there really no other choice?"
    mc "Será que... será que realmente não há outra escolha?"

# game/script4.rpy:11704
translate pt_br_anubisbr scene122_4442366a:

#   q "There isn't. It's her... or thousands. Maybe millions. I know who I will pick."
    q "Não existe uma só. É ela... ou milhares. Talvez milhões. Eu sei quem eu vou escolher."

# game/script4.rpy:11705
translate pt_br_anubisbr scene122_fc27686e:

#   q "And she would do the same in my place."
    q "E ela faria o mesmo no meu lugar."

# game/script4.rpy:11706
translate pt_br_anubisbr scene122_0f7c8237:

#   q "Who knows? They might have a change of heart. Maybe they won't go through with it, but I wouldn't count on luck."
    q "Quem sabe? Eles podem mudar de ideia. Talvez não levem adiante, mas eu não contaria com a sorte."

# game/script4.rpy:11707
translate pt_br_anubisbr scene122_5acfd27d:

#   empathy "Your heart stirs. The truth of her words settles into your chest. Going back and trying another rescue would be truly impossible now."
    empathy "Seu coração se agita. A verdade das palavras dela se instala em seu peito. Voltar atrás e tentar outro resgate seria realmente impossível agora."

# game/script4.rpy:11711
translate pt_br_anubisbr scene122_39e4c555:

#   perception "The carriage breaks down time and time again, so you arrive almost a day late at a massive building with golden arches soaring overhead and colorful ceramic tiles forming intricate mosaics."
    perception "A carruagem avaria repetidamente, pelo que chegamos quase um dia atrasados ​​a um edifício imponente com arcos dourados que se elevam sobre a cabeça e azulejos de cerâmica coloridos que formam mosaicos intrincados."

# game/script4.rpy:11712
translate pt_br_anubisbr scene122_76c35009:

#   whitlaw "We have arrived at the destination, your majesty."
    whitlaw "Chegamos ao destino, majestade."

# game/script4.rpy:11713
translate pt_br_anubisbr scene122_7522b5eb:

#   q "Behind me, you two. I will do the talking."
    q "Vocês dois atrás de mim. Eu falarei."

# game/script4.rpy:11715
translate pt_br_anubisbr scene122_50c35eb4:

#   amb "What is the meaning of this? Who are you people? State your—"
    amb "Qual o significado disso? Quem são vocês? Digam quem são vocês—"

# game/script4.rpy:11717
translate pt_br_anubisbr scene122_940da086:

#   q "Open the gates. I'm the rightful ruler of Irda. Queen Hannah."
    q "Abram os portões. Eu sou a legítima governante de Irda. Rainha Hannah."

# game/script4.rpy:11719
translate pt_br_anubisbr scene122_8f537ca8:

#   amb "Q-Queen of Irda?! H-How?! I thought you were dead! The ship accident—"
    amb "Q-Rainha de Irda?! C-Como?! Pensei que você estivesse morta! O acidente de navio—"

# game/script4.rpy:11721
translate pt_br_anubisbr scene122_de28aa5a:

#   q "I seem to have lived. Now, Sanoud—open the doors and let me in. I have urgent matters to discuss with the king."
    q "Parece que sobrevivi. Agora, Sanoud, abra as portas e deixe-me entrar. Tenho assuntos urgentes a tratar com o rei."

# game/script4.rpy:11723
translate pt_br_anubisbr scene122_d7e64be9:

#   amb "Open the doors! Immediately!"
    amb "Abram as portas! Imediatamente!"

# game/script4.rpy:11727
translate pt_br_anubisbr scene122_df092cfa:

#   perception "You enter the palace, it's exceptionally beautiful and clean. Every surface polished to a mirror shine, every floor a mosaic of colored tiles depicting the history of Nahraya."
    perception "Ao entrar no palácio, você se depara com uma beleza e limpeza excepcionais. Cada superfície polida brilha como um espelho, cada piso um mosaico de azulejos coloridos que retratam a história de Nahraya."

# game/script4.rpy:11728
translate pt_br_anubisbr scene122_dd6e116f:

#   amb "Please keep with me. Don't go anywhere, don't make any sudden moves, and don't touch anything."
    amb "Por favor, fique comigo. Não vá a lugar nenhum, não faça movimentos bruscos e não toque em nada."

# game/script4.rpy:11729
translate pt_br_anubisbr scene122_bb098ebd:

#   amb "When we reach the king, you kneel. You show respect. And most importantly, you never speak unless—"
    amb "Ao chegarmos ao rei, você se ajoelha. Você demonstra respeito. E, mais importante, você nunca fala a menos que—"

# game/script4.rpy:11730
translate pt_br_anubisbr scene122_9a5afe46:

#   mc "Unless spoken to. I know. I already went through this once."
    mc "A menos que falem comigo. Eu sei. Já passei por isso uma vez."

# game/script4.rpy:11731
translate pt_br_anubisbr scene122_07b11b0c:

#   amb "You're exempt from kneeling, queen of Irda. But that still doesn't mean you don't show proper respect."
    amb "Você está isenta de se ajoelhar, rainha de Irda. Mas isso não significa que você não deva demonstrar o devido respeito."

# game/script4.rpy:11733
translate pt_br_anubisbr scene122_fe07c324:

#   amb "My liege, I have... I cannot believe I'm saying this, but I have the Queen of Irda with me."
    amb "Meu senhor, eu tenho... Não consigo acreditar que estou dizendo isso, mas tenho a Rainha de Irda comigo."

# game/script4.rpy:11734
translate pt_br_anubisbr scene122_cdfb3134:

#   king "..."
    king "..."

# game/script4.rpy:11735
translate pt_br_anubisbr scene122_6afc89d6:

#   amb "{size=30}Kneel!{/size}"
    amb "{size=30}Ajoelhe-se!{/size}"

# game/script4.rpy:11651
translate pt_br_anubisbr scene122_9995f74b_1:

#   alex "..."
    alex "..."

# game/script4.rpy:11700
translate pt_br_anubisbr scene122_9995f74b_2:

#   alex "..."
    alex "..."

# game/script4.rpy:11680
translate pt_br_anubisbr scene122_029a3161_1:

#   mc "We thought we could somehow get help regardless, but... well. Before we could think of anything else... there you were."
    mc "Pensávamos que de alguma forma conseguiríamos ajuda, mas... bem. Antes que pudéssemos pensar em qualquer outra coisa... lá estava você."

# game/script4.rpy:11741
translate pt_br_anubisbr scene122_2_e3887229:

#   king "How... Who are you?! Are you an impostor who came to fool me?!"
    king "Como... Quem é você?! É um impostor que veio me enganar?!"

# game/script4.rpy:11743
translate pt_br_anubisbr scene122_2_2e821e3e:

#   q "It's me, Hod."
    q "Sou eu, Hod."

# game/script4.rpy:11744
translate pt_br_anubisbr scene122_2_701d5ad8:

#   q "*chuckles* The news of my death has been greatly exaggerated. As you can see."
    q "*risos* A notícia da minha morte foi muito exagerada. Como você pode ver."

# game/script4.rpy:11746
translate pt_br_anubisbr scene122_2_f93bd067:

#   king "I-Impossible! Explain yourself! I mourned you! I—"
    king "Impossível! Explique-se! Eu lamentei sua perda! Eu—"

# game/script4.rpy:11748
translate pt_br_anubisbr scene122_2_2df1938b:

#   q "I had an attempt on my life. Orchestrated by my sister, Avery, and Reiner of Eurina. They wanted the throne."
    q "Sofri uma tentativa de assassinato. Orquestrada por minha irmã, Avery, e Reiner de Eurina. Eles queriam o trono."

# game/script4.rpy:11749
translate pt_br_anubisbr scene122_2_f791d061:

#   q "The one sent to act is right here with me."
    q "A pessoa designada para agir está aqui comigo."

# game/script4.rpy:11750
translate pt_br_anubisbr scene122_2_9995f74b:

#   alex "..."
    alex "..."

# game/script4.rpy:11752
translate pt_br_anubisbr scene122_2_e9b324da:

#   q "Thankfully, she knew better. She refused at the last second after I proposed faking my death."
    q "Felizmente, ela sabia mais do que eu. Recusou no último segundo, depois que propus fingir minha morte."

# game/script4.rpy:11753
translate pt_br_anubisbr scene122_2_16da212b:

#   q "I was thrown onto a vessel with the intention of letting it sink, unmanned and doomed."
    q "Fui jogado em uma embarcação com a intenção de deixá-la afundar, sem tripulação e condenada ao fracasso."

# game/script4.rpy:11754
translate pt_br_anubisbr scene122_2_9afeea8d:

#   q "*chuckles* But all those boating lessons benefited me greatly that day. I steered the ship into a nearby shore, where I—"
    q "*risos* Mas todas aquelas aulas de navegação me foram muito úteis naquele dia. Conduzi o barco até uma costa próxima, onde eu—"

# game/script4.rpy:11756
translate pt_br_anubisbr scene122_2_b569b29a:

#   king "You met Whitlaw."
    king "Você conheceu Whitlaw."

# game/script4.rpy:11758
translate pt_br_anubisbr scene122_2_3c63cfe7:

#   q "Exactly. The stubborn bastard yet lives."
    q "Exatamente. O teimoso continua vivo."

# game/script4.rpy:11760
translate pt_br_anubisbr scene122_2_6e56dcf2:

#   king "Hannah... I—"
    king "Hannah... Eu—"

# game/script4.rpy:11762
translate pt_br_anubisbr scene122_2_b7b88e78:

#   q "It was a lie, Hod. All of it."
    q "Era mentira, Hod. Tudo mentira."

# game/script4.rpy:11764
translate pt_br_anubisbr scene122_2_77834763:

#   king "*cough*"
    king "*tosse*"

# game/script4.rpy:11765
translate pt_br_anubisbr scene122_2_db85430a:

#   prince "Father?!"
    prince "Pai?!"

# game/script4.rpy:11766
translate pt_br_anubisbr scene122_2_b38602ab:

#   amb "My liege?! Bring water! Quickly!"
    amb "Meu senhor?! Traga água! Rápido!"

# game/script4.rpy:11768
translate pt_br_anubisbr scene122_2_ccf3d53e:

#   king "They lied to me... They played me for a fool."
    king "Eles mentiram para mim... Fizeram-me de tolo."

# game/script4.rpy:11769
translate pt_br_anubisbr scene122_2_dff5b44a:

#   king "Reiner... Avery... I welcomed them. I called them allies."
    king "Reiner... Avery... Eu os recebi de braços abertos. Eu os chamei de aliados."

# game/script4.rpy:11770
translate pt_br_anubisbr scene122_2_3f83a455:

#   king "I will get them back for this. I swear on my life."
    king "Eu vou me vingar deles. Juro pela minha vida."

# game/script4.rpy:11772
translate pt_br_anubisbr scene122_2_4447c451:

#   q "Calm yourself. We will play their charade. We will let them believe we're still blind. And we will dismantle them from within."
    q "Acalme-se. Vamos manter a farsa. Vamos deixá-los acreditar que ainda estamos cegos. E vamos desmantelá-los por dentro."

# game/script4.rpy:11774
translate pt_br_anubisbr scene122_2_a9b4e722:

#   king "...Yes. They believe I am still blind to it... I can take advantage of that."
    king "Sim. Eles acreditam que eu ainda não percebi isso... Posso tirar proveito disso."

# game/script4.rpy:11775
translate pt_br_anubisbr scene122_2_6a488e6f:

#   king "Just you wait."
    king "Aguarde e verá."

# game/script4.rpy:11777
translate pt_br_anubisbr scene122_2_3dbaa2be:

#   king "*sigh* As for now... prepare a bedchamber for the Queen and her slave! The biggest one!"
    king "*suspiro* Por agora... preparem um quarto para a Rainha e seu escravo! O maior de todos!"

# game/script4.rpy:11778
translate pt_br_anubisbr scene122_2_202c0d5a:

#   king "And assign twenty servants to her!"
    king "E designem vinte servos para ela!"

# game/script4.rpy:11780
translate pt_br_anubisbr scene122_2_680b49a2:

#   servant "Yes, my liege. Immediately."
    servant "Sim, meu senhor. Imediatamente."

# game/script4.rpy:11782
translate pt_br_anubisbr scene122_2_84367ebf:

#   q "*laughs* You hear that? I guess you are my slave now."
    q "*risos* Ouviu isso? Acho que agora você é meu escravo."

# game/script4.rpy:11784
translate pt_br_anubisbr scene122_2_201e64b3:

#   mc "If it means sleeping on an actual bed and having access to food and water... I don't mind it."
    mc "Se isso significar dormir em uma cama de verdade e ter acesso a comida e água... não me importo."

# game/script4.rpy:11785
translate pt_br_anubisbr scene122_2_e258f453:

#   mc "Incredible, your majesty. We're closer than ever to getting you right back where you belong."
    mc "Incrível, majestade. Estamos mais perto do que nunca de trazê-la de volta para onde pertence."

# game/script4.rpy:11787
translate pt_br_anubisbr scene122_2_4ac3d69f:

#   q "Patience, [mc]. As I said, we will do this smart. It will take a while."
    q "Paciência, [mc] Como eu disse, faremos isso de forma inteligente. Vai levar um tempo."

# game/script4.rpy:11789
translate pt_br_anubisbr scene122_2_0b7d8ac0:

#   mc "Of course. If only Rebecca was... here to see this."
    mc "Claro. Se ao menos Rebecca estivesse aqui para ver isso."

# game/script4.rpy:11791
translate pt_br_anubisbr scene122_2_09d1d6ab:

#   q "Mourn her. I have been mourning her since the start of my journey here. I thought it would be long enough to finish grieving, but..."
    q "Lamento por ela. Estou de luto por ela desde o início da minha jornada aqui. Pensei que seria tempo suficiente para terminar o luto, mas..."

# game/script4.rpy:11792
translate pt_br_anubisbr scene122_2_9336cc44:

#   q "*sigh* But it appears there's not enought time in the world for that."
    q "*Suspiro* Mas parece que não há tempo suficiente no mundo para isso."

# game/script4.rpy:11798
translate pt_br_anubisbr scene123_0b8280c5:

#   alex "Fuck. I'm genuinely out of ideas."
    alex "Puta merda. Estou realmente sem ideias."

# game/script4.rpy:11799
translate pt_br_anubisbr scene123_a8e552cd:

#   alex "If we had the princess, we'd have an easy way inside—but we don't."
    alex "Se tivéssemos a princesa, teríamos uma entrada fácil — mas não a temos."

# game/script4.rpy:11800
translate pt_br_anubisbr scene123_bd7cd163:

#   alex "This might be a long shot, but if the Queen were still alive, she might have been here before we even arrived and sorted things out."
    alex "Isso pode ser uma hipótese remota, mas se a Rainha ainda estivesse viva, ela poderia ter estado aqui antes mesmo de chegarmos e resolvido as coisas."

# game/script4.rpy:11802
translate pt_br_anubisbr scene123_d52f6206:

#   mc "Well, we have neither of those options."
    mc "Bem, não temos nenhuma dessas opções."

# game/script4.rpy:11803
translate pt_br_anubisbr scene123_ea9c74bb:

#   mc "Hmm... The last time I managed to get an audience with royalty... I had to do something for the city. Something big."
    mc "Hum... Da última vez que consegui uma audiência com a realeza... tive que fazer algo pela cidade. Algo grandioso."

# game/script4.rpy:11804
translate pt_br_anubisbr scene123_21bdea8b:

#   mc "Something that would benefit them greatly."
    mc "Algo que lhes seria muito benéfico."

# game/script4.rpy:11806
translate pt_br_anubisbr scene123_695e8424:

#   alex "And? What could we possibly offer Nahraya before the axe falls on the princess?"
    alex "E então? O que poderíamos oferecer a Nahraya antes que o machado caia sobre a princesa?"

# game/script4.rpy:11808
translate pt_br_anubisbr scene123_b5b668ef:

#   mc "I know exactly how we're getting in."
    mc "Eu sei exatamente como vamos entrar."

# game/script4.rpy:11810
translate pt_br_anubisbr scene123_2ad177a5:

#   alex "...And?! Don't keep me hanging."
    alex "...E?! Não me deixe na expectativa."

# game/script4.rpy:11812
translate pt_br_anubisbr scene123_96436ee3:

#   mc "It's you. You're our ticket in."
    mc "É você. Você é a nossa chave de entrada."

# game/script4.rpy:11814
translate pt_br_anubisbr scene123_b5d871f6:

#   alex "Me? What are you—"
    alex "Eu? O que você é—"

# game/script4.rpy:11815
translate pt_br_anubisbr scene123_5c1ee739:

#   alex "Wait, [mc]. Are you talking about that?!"
    alex "Espere, [mc] Você está falando disso?!"

# game/script4.rpy:11817
translate pt_br_anubisbr scene123_2ec1a239:

#   mc "Look. I know you had no part in it, but to them, you were. I heard a Nahrayan ambassador talking about it."
    mc "Olha. Eu sei que você não teve nada a ver com isso, mas para eles, você teve. Eu ouvi um embaixador de Nahrayan falando sobre isso."

# game/script4.rpy:11818
translate pt_br_anubisbr scene123_d75046d1:

#   mc "They still think you had a part in it."
    mc "Eles ainda acham que você teve alguma participação nisso."

# game/script4.rpy:11819
translate pt_br_anubisbr scene123_f8f54849:

#   mc "If I turn you in... I get a direct meeting with the king."
    mc "Se eu te denunciar... terei um encontro direto com o rei."

# game/script4.rpy:11821
translate pt_br_anubisbr scene123_48617d11:

#   alex "What if they imprison me? Execute me? Have you thought that far ahead?!"
    alex "E se me prenderem? Me executarem? Já pensou nisso?!"

# game/script4.rpy:11822
translate pt_br_anubisbr scene123_f779d6a3:

#   alex "Besides, my name was already cleared when their ambassador visited us."
    alex "Além disso, meu nome já havia sido limpo quando o embaixador deles nos visitou."

# game/script4.rpy:11824
translate pt_br_anubisbr scene123_2e3f24e8:

#   mc "Hmm... then I'll say I captuered you, and want to return you back to Eurina. Your father is looking for you afterall."
    mc "Hum... então direi que a capturei e quero devolvê-la a Eurina. Afinal, seu pai está procurando por você."

# game/script4.rpy:11826
translate pt_br_anubisbr scene123_6d78e872:

#   alex "Fuck. We really are desperate, huh?"
    alex "Puta merda. A gente tá mesmo desesperado, né?"

# game/script4.rpy:11828
translate pt_br_anubisbr scene123_6707f4a9:

#   mc "It's the only immediate way I can think of."
    mc "É a única maneira imediata que me ocorre."

# game/script4.rpy:11830
translate pt_br_anubisbr scene123_df3c52fc:

#   alex "Nghnn... How do we even approach this? Just walk up to the guards and say hi?"
    alex "Nghnn... Como é que a gente aborda isso? É só chegar perto dos guardas e dizer oi?"

# game/script4.rpy:11832
translate pt_br_anubisbr scene123_ed073c50:

#   mc "Turn around. I'll cuff you up."
    mc "Vire-se. Vou algemá-lo."

# game/script4.rpy:11833
translate pt_br_anubisbr scene123_f3e14ff3:

#   mc "You know where the palace is, right?"
    mc "Você sabe onde fica o palácio, certo?"

# game/script4.rpy:11835
translate pt_br_anubisbr scene123_743eb7c4:

#   alex "I do. You're just gonna walk me there? Like a prisoner?"
    alex "Sim. Você vai me acompanhar até lá? Como se eu fosse um prisioneiro?"

# game/script4.rpy:11837
translate pt_br_anubisbr scene123_a611c091:

#   mc "Yeah. I come in as the one who captured you."
    mc "Sim. Eu entro como aquele que te capturou."

# game/script4.rpy:11839
translate pt_br_anubisbr scene123_a432bb20:

#   alex "*sigh* I hope we're not walking into our deaths..."
    alex "*suspiro* Espero que não estejamos caminhando para a morte..."

# game/script4.rpy:11841
translate pt_br_anubisbr scene123_3928fe1e:

#   perception "You find a length of rope on the ground, discarded from some merchant's stall. You use it to tie Alex's hands together."
    perception "Você encontra um pedaço de corda no chão, descartado da barraca de algum comerciante. Você o usa para amarrar as mãos de Alex."

# game/script4.rpy:11842
translate pt_br_anubisbr scene123_1f56feb7:

#   mc "Ready?"
    mc "Preparar?"

# game/script4.rpy:11843
translate pt_br_anubisbr scene123_faa67de2:

#   alex "No."
    alex "Não."

# game/script4.rpy:11844
translate pt_br_anubisbr scene123_ea402683:

#   impulse "You have no use for her anymore. You're strong on your own now. Use the king and lie to get rid of her."
    impulse "Você não precisa mais dela. Agora você é forte o suficiente para se virar sozinho. Use o rei e minta para se livrar dela."

# game/script4.rpy:11845
translate pt_br_anubisbr scene123_2b35b6fe:

#   mc "..."
    mc "..."

# game/script4.rpy:11849
translate pt_br_anubisbr scene123_ff9b8df8:

#   perception "You reach a massive building with golden arches soaring overhead, colorful ceramic tiles forming intricate mosaic art."
    perception "Você chega a um prédio imponente com arcos dourados que se elevam acima da sua cabeça, e azulejos de cerâmica coloridos que formam uma intrincada arte em mosaico."

# game/script4.rpy:11850
translate pt_br_anubisbr scene123_27c4eb5c:

#   alex "I have a really bad feeling about this, [mc]..."
    alex "Tenho um pressentimento muito ruim sobre isso. [mc]..."

# game/script4.rpy:11852
translate pt_br_anubisbr scene123_0db26c79:

#   mc "I have a prisoner for the king! Reiner's daughter who ran off!"
    mc "Tenho uma prisioneira para o rei! A filha de Reiner que fugiu!"

# game/script4.rpy:11853
translate pt_br_anubisbr scene123_d08e5678:

#   guard "None may enter his presence presence without leave."
    guard "Ninguém pode entrar em sua presença sem permissão."

# game/script4.rpy:11854
translate pt_br_anubisbr scene123_79752835:

#   mc "Did you not hear me? I said-"
    mc "Você não me ouviu? Eu disse-"

# game/script4.rpy:11856
translate pt_br_anubisbr scene123_4847ac28:

#   amb "Hold on. I know this girl..."
    amb "Espere aí. Eu conheço essa garota..."

# game/script4.rpy:11857
translate pt_br_anubisbr scene123_ede72a1b:

#   amb "You were at the meeting in Eurnia! Y-You're Reiner's daughter!"
    amb "Você estava na reunião em Eurnia! V-Você é a filha do Reiner!"

# game/script4.rpy:11859
translate pt_br_anubisbr scene123_07d8fe1a:

#   alex "Yes, yes. I am."
    alex "Sim, sim. Sou eu."

# game/script4.rpy:11861
translate pt_br_anubisbr scene123_98c04912:

#   amb "You! What is the meaning of this?"
    amb "Você! O que significa isso?"

# game/script4.rpy:11863
translate pt_br_anubisbr scene123_045dd7a0:

#   mc "This girl ran off and her father wants her back. I'm here to deliver her to the king."
    mc "Essa garota fugiu e o pai dela a quer de volta. Estou aqui para entregá-la ao rei."

# game/script4.rpy:11864
translate pt_br_anubisbr scene123_8dee38aa:

#   mc "I'll only hand her over to the king himself. Directly. I have information he needs to hear."
    mc "Só a entregarei ao próprio rei. Diretamente. Tenho informações que ele precisa ouvir."

# game/script4.rpy:11865
translate pt_br_anubisbr scene123_208c5e7f:

#   mc "Reiner has been lying to your king."
    mc "Reiner tem mentido para o seu rei."

# game/script4.rpy:11867
translate pt_br_anubisbr scene123_9880513e:

#   amb "Lying? About what?"
    amb "Mentir? Sobre o quê?"

# game/script4.rpy:11869
translate pt_br_anubisbr scene123_df4c0220:

#   mc "About the death of the Queen of Irda."
    mc "Sobre a morte da Rainha de Irda."

# game/script4.rpy:11870
translate pt_br_anubisbr scene123_966a6b0a:

#   amb "..."
    amb "..."

# game/script4.rpy:11872
translate pt_br_anubisbr scene123_c8cf6148:

#   amb "Follow me. And if this is some sort of trick, you'll both regret it."
    amb "Sigam-me. E se isto for algum tipo de truque, vocês dois vão se arrepender."

# game/script4.rpy:11877
translate pt_br_anubisbr scene123_df092cfa:

#   perception "You enter the palace, it's exceptionally beautiful and clean. Every surface polished to a mirror shine, every floor a mosaic of colored tiles depicting the history of Nahraya."
    perception "Ao entrar no palácio, você se depara com uma beleza e limpeza excepcionais. Cada superfície polida brilha como um espelho, cada piso um mosaico de azulejos coloridos que retratam a história de Nahraya."

# game/script4.rpy:11878
translate pt_br_anubisbr scene123_dd6e116f:

#   amb "Please keep with me. Don't go anywhere, don't make any sudden moves, and don't touch anything."
    amb "Por favor, fique comigo. Não vá a lugar nenhum, não faça movimentos bruscos e não toque em nada."

# game/script4.rpy:11879
translate pt_br_anubisbr scene123_bb098ebd:

#   amb "When we reach the king, you kneel. You show respect. And most importantly, you never speak unless—"
    amb "Ao chegarmos ao rei, você se ajoelha. Você demonstra respeito. E, mais importante, você nunca fala a menos que—"

# game/script4.rpy:11880
translate pt_br_anubisbr scene123_9a5afe46:

#   mc "Unless spoken to. I know. I already went through this once."
    mc "A menos que falem comigo. Eu sei. Já passei por isso uma vez."

# game/script4.rpy:11882
translate pt_br_anubisbr scene123_b40b770a:

#   amb "My liege. This foreigner claims that Reiner of Eurina's daughter was responsible for the attack on the Pleasure Queen."
    amb "Meu senhor. Este estrangeiro afirma que Reiner, filha de Eurina, foi responsável pelo ataque à Rainha do Prazer."

# game/script4.rpy:11883
translate pt_br_anubisbr scene123_9f699082:

#   amb "He demands an audience in exchange for her capture."
    amb "Ele exige uma audiência em troca de sua captura."

# game/script4.rpy:11884
translate pt_br_anubisbr scene123_6afc89d6:

#   amb "{size=30}Kneel!{/size}"
    amb "{size=30}Ajoelhe-se!{/size}"

# game/script4.rpy:11890
translate pt_br_anubisbr scene123_2_9e2888a8:

#   king "You match the description perfectly, daughter of Reiner."
    king "Você se encaixa perfeitamente na descrição, filha de Reiner."

# game/script4.rpy:11891
translate pt_br_anubisbr scene123_2_7cf1dce6:

#   king "I thought her name was already cleared, Sanoud. Reiner himself vouched for her innocence. So what's the meaning of this?"
    king "Pensei que o nome dela já estivesse limpo, Sanoud. O próprio Reiner atestou a inocência dela. Então, o que significa isso?"

# game/script4.rpy:11893
translate pt_br_anubisbr scene123_2_46002bec:

#   amb "My liege, this man claims that Reiner was lying about the death of Irda's queen."
    amb "Meu senhor, este homem afirma que Reiner mentiu sobre a morte da rainha de Irda."

# game/script4.rpy:11895
translate pt_br_anubisbr scene123_2_c01890db:

#   king "Is that true? Is my trusted ally a liar?"
    king "Isso é verdade? Meu aliado de confiança é um mentiroso?"

# game/script4.rpy:11897
translate pt_br_anubisbr scene123_2_38520824:

#   mc "He is. And I want you to hear the truth. The real truth."
    mc "Ele é. E eu quero que você ouça a verdade. A verdadeira verdade."

# game/script4.rpy:11899
translate pt_br_anubisbr scene123_2_9d22a085:

#   king "Go on, then. Make it quick. Afterwards, I can decide to either execute you for wasting my time, or imprison you for kidnapping my friend's daughter."
    king "Vamos lá, então. Seja rápido. Depois, posso decidir se te executo por me fazer perder tempo ou se te prendo por sequestrar a filha do meu amigo."

# game/script4.rpy:11900
translate pt_br_anubisbr scene123_2_f0f94987:

#   king "Choose your words carefully."
    king "Escolha suas palavras com cuidado."

# game/script4.rpy:11902
translate pt_br_anubisbr scene123_2_dea92f0f:

#   mc "I-I was there too. I know who was really behind the attack."
    mc "Eu também estava lá. Eu sei quem realmente estava por trás do ataque."

# game/script4.rpy:11903
translate pt_br_anubisbr scene123_2_3accaeb9:

#   mc "It was all a lie, my liege. All of it. Avery and Reiner orchestrated a coup. They assassinated queen Hannah and imprisoned her children, princess Rebecca and the prince."
    mc "Tudo foi mentira, meu senhor. Tudo. Avery e Reiner orquestraram um golpe. Eles assassinaram a rainha Hannah e aprisionaram seus filhos, a princesa Rebecca e o príncipe."

# game/script4.rpy:11905
translate pt_br_anubisbr scene123_2_12acde3c:

#   king "What madness spills out of your forked tongue? The reports said she died in a ship accident."
    king "Que loucuras saem da sua língua bifurcada? Os relatos dizem que ela morreu em um acidente de navio."

# game/script4.rpy:11907
translate pt_br_anubisbr scene123_2_2b10481c:

#   mc "The reports were lies."
    mc "Os relatórios eram mentiras."

# game/script4.rpy:11908
translate pt_br_anubisbr scene123_2_430da779:

#   alex "He's right. I was there with him. My father sent me to kill the Queen. And I—"
    alex "Ele tem razão. Eu estava lá com ele. Meu pai me mandou matar a Rainha. E eu—"

# game/script4.rpy:11910
translate pt_br_anubisbr scene123_2_1b786ee7:

#   king "You accuse your own father of conspiracy? Of murder?"
    king "Você acusa seu próprio pai de conspiração? De assassinato?"

# game/script4.rpy:11912
translate pt_br_anubisbr scene123_2_e9a9512e:

#   alex "Because it's the truth!"
    alex "Porque é a verdade!"

# game/script4.rpy:11913
translate pt_br_anubisbr scene123_2_dc03d7e7:

#   empathy "The king looks at you with intense hatred, as if he could slice your neck open right there and then."
    empathy "O rei olha para você com um ódio intenso, como se pudesse cortar seu pescoço ali mesmo, naquele instante."

# game/script4.rpy:11914
translate pt_br_anubisbr scene123_2_24aa3157:

#   mc "My liege, you have to trust me!"
    mc "Meu senhor, você precisa confiar em mim!"

# game/script4.rpy:11915
translate pt_br_anubisbr scene123_2_98426992:

#   mc "I know how this sounds, but I'm telling you the truth!"
    mc "Eu sei como isso soa, mas estou lhe dizendo a verdade!"

# game/script4.rpy:11917
translate pt_br_anubisbr scene123_2_d85b1b38:

#   king "You enter my palace. You disrespect my name. You disrespect my friends. You dishonor the memory of a queen that I looked up to."
    king "Você invade meu palácio. Você desrespeita meu nome. Você desrespeita meus amigos. Você desonra a memória de uma rainha que eu admirava."

# game/script4.rpy:11919
translate pt_br_anubisbr scene123_2_102aa7ae:

#   mc "W-What?"
    mc "O quê?"

# game/script4.rpy:11921
translate pt_br_anubisbr scene123_2_4ff245ff:

#   king "I should rip off your head where you stand. But just because Reiner's daughter is watching... I will keep my calm. For her sake."
    king "Eu deveria arrancar sua cabeça aí mesmo. Mas só porque a filha do Reiner está assistindo... vou manter a calma. Por ela."

# game/script4.rpy:11923
translate pt_br_anubisbr scene123_2_83741795:

#   alex "...Run, [mc]! RUN!"
    alex "...Correr, [mc]! CORRER!"

# game/script4.rpy:11925
translate pt_br_anubisbr scene123_2_07f7898f:

#   perception "Before you even think of running, guards surround you from every direction."
    perception "Antes mesmo de você pensar em correr, guardas o cercam por todos os lados."

# game/script4.rpy:11926
translate pt_br_anubisbr scene123_2_eedd2ff6:

#   king "Put this filth in the dungeons! I shall attend his execution myself."
    king "Joguem essa escória nas masmorras! Eu mesmo assistirei à sua execução."

# game/script4.rpy:11928
translate pt_br_anubisbr scene123_2_54f70ad8:

#   mc "Please! You're being manipulated!"
    mc "Por favor! Você está sendo manipulado(a)!"

# game/script4.rpy:11930
translate pt_br_anubisbr scene123_2_9f2e85f0:

#   king "Enough. Take him away."
    king "Chega. Levem-no embora."

# game/script4.rpy:11932
translate pt_br_anubisbr scene123_2_4e5daecf:

#   alex "Get away from him! He's telling the truth! Why won't you listen?!"
    alex "Afaste-se dele! Ele está dizendo a verdade! Por que você não o escuta?!"

# game/script4.rpy:11934
translate pt_br_anubisbr scene123_2_a3e5c89a:

#   king "It appears he planted false ideas in your mind. Stockholm syndrome, perhaps, or some sort of brainwashing magic."
    king "Parece que ele plantou ideias falsas na sua mente. Síndrome de Estocolmo, talvez, ou algum tipo de lavagem cerebral."

# game/script4.rpy:11935
translate pt_br_anubisbr scene123_2_d7bb9a81:

#   king "Don't worry, child. I will send for your father to come and take you home. He will set your thoughts right again."
    king "Não se preocupe, criança. Mandarei chamar seu pai para que ele venha buscá-la e a leve para casa. Ele a ajudará a se acalmar."

# game/script4.rpy:11937
translate pt_br_anubisbr scene123_2_31de435c:

#   minthra "No. No, it cannot end this way. This is wrong. This is all wrong. There must be something I missed..."
    minthra "Não. Não, não pode terminar assim. Isto está errado. Tudo isto está errado. Deve haver alguma coisa que me escapou..."

# game/script4.rpy:11938
translate pt_br_anubisbr scene123_2_753fbe48:

#   minthra "It absolutely cannot end this way!"
    minthra "Isso não pode terminar assim de jeito nenhum!"

# game/script4.rpy:11939
translate pt_br_anubisbr scene123_2_565c745d:

#   mc "(Minthra... what are you saying? You will help me, right?)"
    mc "(Minthra... o que você está dizendo? Você vai me ajudar, não é?)"

# game/script4.rpy:11940
translate pt_br_anubisbr scene123_2_2e57a7e3:

#   minthra "I will not die with you. I shall find another vessel. A thousand years from now... someone who is competent."
    minthra "Não morrerei contigo. Encontrarei outro receptáculo. Daqui a mil anos... alguém competente."

# game/script4.rpy:11941
translate pt_br_anubisbr scene123_2_469439a3:

#   mc "(W-Where are you going?!)"
    mc "(O-Onde você vai?!)"

# game/script4.rpy:11944
translate pt_br_anubisbr scene123_2_a7f14a0f:

#   sensation "You feel your strength slowly sapping away. Your legs shake. Your arms become numb. You vision darkens."
    sensation "Você sente suas forças se esvaindo lentamente. Suas pernas tremem. Seus braços ficam dormentes. Sua visão escurece."

# game/script4.rpy:11945
translate pt_br_anubisbr scene123_2_4009f44e:

#   mc "(You're going to... you're going to kill me... I feel like... sleeping.)"
    mc "(Você vai... você vai me matar... Eu estou com vontade de... dormir.)"

# game/script4.rpy:11947
translate pt_br_anubisbr scene123_2_26f4d492:

#   sensation "As if someone reached into your chest and pulled out your heart. The world tilts."
    sensation "É como se alguém enfiasse a mão no seu peito e arrancasse seu coração. O mundo gira."

# game/script4.rpy:11948
translate pt_br_anubisbr scene123_2_fc77664c:

#   perception "The last thing you hear is Alex screaming your name."
    perception "A última coisa que você ouve é Alex gritando seu nome."

