#   Millicent "..."
    Millicent "..."

# game/script4.rpy:1158
translate pt_br_anubisbr scene104_choice04_op2_94c5336f:

#   Millicent "*sniff* I don't... I don't usually cry in front of people."
    Millicent "*snif* Eu não... eu geralmente não choro na frente das pessoas."

# game/script4.rpy:1159
translate pt_br_anubisbr scene104_choice04_op2_c1125831:

#   mc "I won't tell anyone."
    mc "Não contarei a ninguém."

# game/script4.rpy:1160
translate pt_br_anubisbr scene104_choice04_op2_9bd55e94:

#   Millicent "*hic* You're strange... You don't even know me."
    Millicent "*Soluço* Você é estranho... Você nem me conhece."

# game/script4.rpy:1161
translate pt_br_anubisbr scene104_choice04_op2_b90231cd:

#   mc "*chuckles* Do I have to know you to want to make you feel better?"
    mc "*risos* Preciso te conhecer para querer te fazer sentir melhor?"

# game/script4.rpy:1164
translate pt_br_anubisbr scene104_choice04_op2_cbe10b54:

#   perception "She stays still for a long moment. Then, slowly, she turns and pulls you into a tight hug."
    perception "Ela fica imóvel por um longo momento. Então, lentamente, ela se vira e te puxa para um abraço apertado."

# game/script4.rpy:1166
translate pt_br_anubisbr scene104_choice04_op2_225c650f:

#   Millicent "Thank you... For saving my life. And for this."
    Millicent "Obrigado... por salvar minha vida. E por isso."

# game/script4.rpy:1168
translate pt_br_anubisbr scene104_choice04_op2_bc666b09:

#   mc "Anytime."
    mc "A qualquer momento."

# game/script4.rpy:1170
translate pt_br_anubisbr scene104_choice04_op2_e80a9930:

#   mc "Millicent?"
    mc "Millicent?"

# game/script4.rpy:1172
translate pt_br_anubisbr scene104_choice04_op2_0e7454a9:

#   Millicent "Sorry... Can we stay like this a bit longer? *chuckles* You have no idea how long it's been since I hugged someone."
    Millicent "Desculpe... Podemos ficar assim mais um pouco? *risos* Você não faz ideia de quanto tempo faz que eu não abraço alguém."

# game/script4.rpy:1169
translate pt_br_anubisbr scene104_choice04_op2_921e19b3_1:

#   Millicent "..."
    Millicent "..."

# game/script4.rpy:1177
translate pt_br_anubisbr scene104_choice04_op1_3ee4f63a:

#   mc "You should have been more careful. You knew the ruins were unstable."
    mc "Você deveria ter sido mais cuidadoso. Você sabia que as ruínas eram instáveis."

# game/script4.rpy:1179
translate pt_br_anubisbr scene104_choice04_op1_83a75489:

#   Millicent "I—you're right. I wasn't paying attention. I was... distracted."
    Millicent "Você tem razão. Eu não estava prestando atenção. Eu estava... distraído."

# game/script4.rpy:1181
translate pt_br_anubisbr scene104_choice04_op1_2b258bcc:

#   mc "That distraction almost killed you."
    mc "Essa distração quase te matou."

# game/script4.rpy:1183
translate pt_br_anubisbr scene104_choice04_op1_6799ab58:

#   Millicent "I know."
    Millicent "Eu sei."

# game/script4.rpy:1185
translate pt_br_anubisbr scene104_choice04_op1_2b35b6fe:

#   mc "..."
    mc "..."

# game/script4.rpy:1187
translate pt_br_anubisbr scene104_choice04_op1_54830360:

#   Millicent "*sniff* Let's keep moving. We've wasted enough time."
    Millicent "*cheirando* Vamos continuar. Já perdemos tempo demais."

# game/script4.rpy:1189
translate pt_br_anubisbr scene104_choice04_op1_8f5bd623:

#   perception "She walks past you without another word. The brief moment of connection is gone, buried under stone and silence."
    perception "Ela passa por você sem dizer mais nada. O breve momento de conexão se foi, enterrado sob a pedra e o silêncio."

# game/script4.rpy:1194
translate pt_br_anubisbr scene104_4_4ef53996:

#   perception "You arrive into the deepest chamber. Sunlight streams through a hole in the ceiling, painting yellow streaks across the ancient stone."
    perception "Você chega à câmara mais profunda. A luz do sol penetra por um buraco no teto, pintando listras amarelas na pedra antiga."

# game/script4.rpy:1198
translate pt_br_anubisbr scene104_4_84593e63:

#   alex "Oh, thank God! I thought I was lost."
    alex "Ah, graças a Deus! Pensei que estava perdido."

# game/script4.rpy:1199
translate pt_br_anubisbr scene104_4_2a759d33:

#   alex "By the way, did you come across a goblin archer? It ran away from me."
    alex "A propósito, você se deparou com um arqueiro goblin? Ele fugiu de mim."

# game/script4.rpy:1201
translate pt_br_anubisbr scene104_4_2e92f8bf:

#   mc "So that was you?"
    mc "Então era você?"

# game/script4.rpy:1202
translate pt_br_anubisbr scene104_4_bf379dd4:

#   alex "Hmm?"
    alex "Hum?"

# game/script4.rpy:1203
translate pt_br_anubisbr scene104_4_7d647de2:

#   Millicent "*sigh* Nevermind. Yes, we got him."
    Millicent "*suspiro* Deixa pra lá. Sim, nós o pegamos."

# game/script4.rpy:1206
translate pt_br_anubisbr scene104_4_6ea0abde:

#   Millicent "There you are! This place is a maze."
    Millicent "Pronto! Este lugar é um labirinto."

# game/script4.rpy:1209
translate pt_br_anubisbr scene104_4_2e4ea891:

#   mc "I hear Thulkin's screams through that door, we should hurry up."
    mc "Ouço os gritos de Thulkin através daquela porta, devemos nos apressar."

# game/script4.rpy:1210
translate pt_br_anubisbr scene104_4_e2f6e1ce:

#   alex "I hope he left us something. I barely got to use this sword—"
    alex "Espero que ele tenha nos deixado alguma coisa. Mal consegui usar esta espada—"

# game/script4.rpy:1214
translate pt_br_anubisbr scene104_4_6e7c6ede:

#   thulkin "NGHNNNN!"
    thulkin "NGHNNNN!"

# game/script4.rpy:1215
translate pt_br_anubisbr scene104_4_8bacc0df:

#   Millicent "Thulkin!"
    Millicent "Thulkin!"

# game/script4.rpy:1217
translate pt_br_anubisbr scene104_4_0613f303:

#   thulkin "Took you... *cough* long enough. Saved all the fun... for you."
    thulkin "Demorou... *cof*, tempo suficiente. Guardei toda a diversão... para você."

# game/script4.rpy:1219
translate pt_br_anubisbr scene104_4_7eb379bf:

#   Millicent "You were supposed to wait for the plan, you idiot!"
    Millicent "Você devia ter esperado pelo plano, seu idiota!"

# game/script4.rpy:1220
translate pt_br_anubisbr scene104_4_c05b5012:

#   alex "Forget the plan—what in the hells did this to you?"
    alex "Esqueça o plano — que diabos fizeram isso com você?"

# game/script4.rpy:1222
translate pt_br_anubisbr scene104_4_02e4f13b:

#   thulkin "The chieftain's through there. Big one. Really big. Wasn't too happy about me killing his little minions."
    thulkin "O chefe está por ali. Um grandalhão. Enorme mesmo. Não ficou nada contente por eu ter matado seus capangas."

# game/script4.rpy:1224
translate pt_br_anubisbr scene104_4_3451a920:

#   Millicent "*sigh* Stay here and regain your stamina. We'll deal with it."
    Millicent "*Suspiro* Fique aqui e recupere suas energias. Nós cuidaremos disso."

# game/script4.rpy:1227
translate pt_br_anubisbr scene104_4_85d31088:

#   perception "You step through the doorway into the chieftain's chamber. Smoke hangs thick in the air, stinging your eyes and throat. The aftermath of Thulkin's assault, shattered pillars, deep gouges in the stone floor."
    perception "Você atravessa a porta e entra nos aposentos do chefe. A fumaça densa paira no ar, irritando seus olhos e garganta. As consequências do ataque de Thulkin: pilares destruídos, sulcos profundos no chão de pedra."

# game/script4.rpy:1228
translate pt_br_anubisbr scene104_4_ca5791f3:

#   minthra "He's too strong to face head-on. Break his will first, then you can influence him."
    minthra "Ele é forte demais para ser enfrentado diretamente. Quebre sua resistência primeiro, depois você poderá influenciá-lo."

# game/script4.rpy:1230
translate pt_br_anubisbr scene104_4_15112ed0:

#   perception "Through the haze, a massive silhouette emerges. The goblin chieftain steps forward, his enormous club dragging along the ground."
    perception "Em meio à névoa, surge uma silhueta gigantesca. O chefe goblin avança, seu enorme porrete arrastando-se pelo chão."

# game/script4.rpy:1231
translate pt_br_anubisbr scene104_4_90460be1:

#   alex "What is it? An ogre?"
    alex "O que é isso? Um ogro?"

# game/script4.rpy:1232
translate pt_br_anubisbr scene104_4_85486595:

#   Millicent "That's just how big their chieftains get. The stronger and meaner you are, the higher your chances of ruling the tribe."
    Millicent "É assim que seus chefes ficam poderosos. Quanto mais forte e cruel você for, maiores serão suas chances de governar a tribo."

# game/script4.rpy:1234
translate pt_br_anubisbr scene104_4_222d1af8:

#   thulkin "HAAAAA!"
    thulkin "HAAAAA!"

# game/script4.rpy:1238
translate pt_br_anubisbr scene104_4_ea0c5ba0:

#   chieftain "Akghnn!"
    chieftain "Akghnn!"

# game/script4.rpy:1239
translate pt_br_anubisbr scene104_4_f4779707:

#   perception "The chieftain swipes his club. It connects with Thulkin's side with a shockwave that clears the smoke, sending him flying backward through the same door he entered."
    perception "O chefe golpeia com seu porrete. O golpe atinge o flanco de Thulkin com uma onda de choque que dissipa a fumaça, arremessando-o para trás pela mesma porta por onde entrou."

# game/script4.rpy:1242
translate pt_br_anubisbr scene104_4_363fe51a:

#   Millicent "Dammit, Thulkin! I told you to rest!"
    Millicent "Droga, Thulkin! Eu te disse para descansar!"

# game/script4.rpy:1243
translate pt_br_anubisbr scene104_4_96559ee7:

#   thulkin "I'm... nghn... fine!"
    thulkin "Eu estou... nghn... bem!"

# game/script4.rpy:1245
translate pt_br_anubisbr scene104_4_e9e98f30:

#   alex "[mc], I'll target his legs. Keep him off balance. You go for his hands, try to disarm him if you can."
    alex "[mc] Vou mirar nas pernas dele. Mantenha-o desequilibrado. Você ataca as mãos dele, tente desarmá-lo se puder."

# game/script4.rpy:1246
translate pt_br_anubisbr scene104_4_dc16ebcd:

#   mc "Got it."
    mc "Entendi."

# game/script4.rpy:1250
translate pt_br_anubisbr scene104_4_22ce0f3f:

#   perception "Alex darts forward in a blur. Her blade slices across the chieftain's calf. The giant roars and stomps furiously."
    perception "Alex avança num instante. Sua lâmina corta a panturrilha do chefe. O gigante ruge e pisa forte furiosamente."

# game/script4.rpy:1254
translate pt_br_anubisbr scene104_4_be466bef:

#   perception "You charge in right after, sword raised. Your blade bites deep into his wrist and blood spurts out."
    perception "Você avança logo em seguida, espada em riste. Sua lâmina penetra fundo em seu pulso e o sangue jorra."

# game/script4.rpy:1255
translate pt_br_anubisbr scene104_4_b0b376e6:

#   chieftain "Grahh!"
    chieftain "Grahh!"

# game/script4.rpy:1257
translate pt_br_anubisbr scene104_4_76854e03:

#   Millicent "Clear off, you two. This is going to hurt {i}a lot{/i}."
    Millicent "Saiam daqui, vocês dois. Isso vai doer. {i} bastante{/i}."

# game/script4.rpy:1261
translate pt_br_anubisbr scene104_4_6ce35ef1:

#   chieftain "GRHKHANNN!"
    chieftain "GRHKHANNN!"

# game/script4.rpy:1263
translate pt_br_anubisbr scene104_4_7b4b2ccf:

#   mc "Ouch..."
    mc "Ai..."

# game/script4.rpy:1265
translate pt_br_anubisbr scene104_4_df06c858:

#   alex "Let's end it!"
    alex "Vamos acabar com isso!"

# game/script4.rpy:1268
translate pt_br_anubisbr scene104_4_4e831a19:

#   perception "Despite the pain, the chieftain suddenly snaps and aims his massive club at Alex, who's caught off-guard."
    perception "Apesar da dor, o chefe subitamente perde a cabeça e aponta seu enorme porrete para Alex, que é pego de surpresa."

# game/script4.rpy:1269
translate pt_br_anubisbr scene104_4_1b9c8a2b:

#   Millicent "Back away!"
    Millicent "Afastem-se!"

# game/script4.rpy:1271
translate pt_br_anubisbr scene104_4_96a7931f:

#   minthra "I know what you're trying to do. Don't. You cannot influence the dead. Take the hit, I will shield you."
    minthra "Eu sei o que você está tentando fazer. Não faça. Você não pode influenciar os mortos. Receba o golpe, eu o protegerei."

# game/script4.rpy:1278
translate pt_br_anubisbr scene104_choice06_op1_e6cc4c42:

#   sensation "You jump in front of the chieftain just in time. His club connects with your head and pain explodes behind your eyes. The force is strong enough to send you flying."
    sensation "Você se joga na frente do chefe bem a tempo. O porrete dele acerta sua cabeça e uma dor lancinante explode atrás dos seus olhos. A força do impacto é tanta que te arremessa para longe."

# game/script4.rpy:1282
translate pt_br_anubisbr scene104_choice06_op1_e10a8b65:

#   Millicent "[mc]!"
    Millicent "[mc]!"

# game/script4.rpy:1283
translate pt_br_anubisbr scene104_choice06_op1_c467c612:

#   alex "NO!"
    alex "NÃO!"

# game/script4.rpy:1287
translate pt_br_anubisbr scene104_choice06_op1_2b35b6fe:

#   mc "..."
    mc "..."

# game/script4.rpy:1288
translate pt_br_anubisbr scene104_choice06_op1_3ff75a26:

#   minthra "You're fading."
    minthra "Você está desaparecendo."

# game/script4.rpy:1289
translate pt_br_anubisbr scene104_choice06_op1_ff964275:

#   sensation "Darkness. Then... invigorating warmth. It spreads through your skull, your spine, your limbs."
    sensation "Escuridão. Depois... um calor revigorante. Ele se espalha pelo crânio, pela coluna, pelos membros."

# game/script4.rpy:1291
translate pt_br_anubisbr scene104_choice06_op1_1d47a8d5:

#   mc "(Hnn... huh? I-I should be dead.)"
    mc "(Hnn... hein? Eu deveria estar morto.)"

# game/script4.rpy:1293
translate pt_br_anubisbr scene104_choice06_op1_2c34f468:

#   mc "Hhng!"
    mc "Hhng!"

# game/script4.rpy:1294
translate pt_br_anubisbr scene104_choice06_op1_ff5ac584:

#   alex "How... your head... that should have—"
    alex "Como... sua cabeça... que deveria ter—"

# game/script4.rpy:1296
translate pt_br_anubisbr scene104_choice06_op1_c3fac12f:

#   perception "You move again. Faster now, stronger."
    perception "Você se move novamente. Mais rápido agora, mais forte."

# game/script4.rpy:1300
translate pt_br_anubisbr scene104_choice06_op1_3e3d1739:

#   perception "The chieftain tries to swing, but you're not there. You're behind him, blade plunging deep into his thick skin."
    perception "O chefe tenta desferir um golpe, mas você não está lá. Você está atrás dele, a lâmina penetrando fundo em sua pele grossa."

# game/script4.rpy:1302
translate pt_br_anubisbr scene104_choice06_op1_59fd2fd8:

#   Millicent "What happened to him? Is this normal?"
    Millicent "O que aconteceu com ele? Isso é normal?"

# game/script4.rpy:1304
translate pt_br_anubisbr scene104_choice06_op1_5ea3ebe1:

#   alex "I don't know... but I'm not complaining!"
    alex "Não sei... mas não estou reclamando!"

# game/script4.rpy:1310
translate pt_br_anubisbr scene104_choice06_op1_d3d48f4f:

#   thulkin "RAAGH! Missed me?!"
    thulkin "RAAGH! Sentiram minha falta?!"

# game/script4.rpy:1312
translate pt_br_anubisbr scene104_choice06_op1_69eb1739:

#   thulkin "Let's hit him all at once!"
    thulkin "Vamos atacá-lo todos de uma vez!"

# game/script4.rpy:1316
translate pt_br_anubisbr scene104_choice06_op1_d913010c:

#   perception "The chieftain falters. His swings grow wild, desperate. Alex takes a leg. Millicent focuses her beam. Thulkin plunges his axe into his arm and tackles him, holding him down with sheer mass."
    perception "O chefe vacila. Seus golpes se tornam descontrolados, desesperados. Alex agarra uma perna. Millicent concentra seu raio. Thulkin crava seu machado no braço dele e o derruba, imobilizando-o com sua força bruta."

# game/script4.rpy:1317
translate pt_br_anubisbr scene104_choice06_op1_81f7b838:

#   thulkin "NOW!"
    thulkin "AGORA!"

# game/script4.rpy:1319
translate pt_br_anubisbr scene104_choice06_op1_97c294c3:

#   empathy "The chieftain looks back to you with hateful, defiant eyes. Yet, there's something underneath all the anger. Fear."
    empathy "O chefe olha para você com olhos odiosos e desafiadores. No entanto, há algo por baixo de toda aquela raiva. Medo."

# game/script4.rpy:1320
translate pt_br_anubisbr scene104_choice06_op1_6e9cb8b7:

#   minthra "I will take it from here."
    minthra "Eu assumo o controle a partir daqui."

# game/script4.rpy:1327
translate pt_br_anubisbr scene104_choice07_op1_677957cd:

#   perception "You place your hand on his head. He thrashes, then stills. His eyes go wide, then distant as if looking at something only he can."
    perception "Você coloca a mão na cabeça dele. Ele se debate, depois fica imóvel. Seus olhos se arregalam, depois se distanciam como se estivessem olhando para algo que só ele consegue ver."

# game/script4.rpy:1328
translate pt_br_anubisbr scene104_choice07_op1_4d8bf0fb:

#   chieftain "..."
    chieftain "..."

# game/script4.rpy:1330
translate pt_br_anubisbr scene104_choice07_op1_65a3f23d:

#   Millicent "What are you doing!? Kill him!"
    Millicent "O que você está fazendo!? Mate-o!"

# game/script4.rpy:1333
translate pt_br_anubisbr scene104_choice07_op1_659e0d5b:

#   perception "His struggles cease and he kneels to the ground, the hate is gone and replaced by something else. Awe. Fear. Worship."
    perception "Seus esforços cessam e ele se ajoelha no chão; o ódio se foi, substituído por algo mais. Admiração. Temor. Adoração."

# game/script4.rpy:1339
translate pt_br_anubisbr scene104_choice08_op1_a88d5652:

#   chieftain "Yeeessh, Mashter..."
    chieftain "Nossa, Mestre..."

# game/script4.rpy:1346
translate pt_br_anubisbr scene104_choice08_op1_a6eb4131:

#   thulkin "T-They talk!?"
    thulkin "E-Eles falam!?"

# game/script4.rpy:1348
translate pt_br_anubisbr scene104_choice08_op1_e465439f:

#   minthra "Well done, my vessel. This will not go unrewarded."
    minthra "Muito bem, minha embarcação. Isso não ficará sem recompensa."

# game/script4.rpy:1349
translate pt_br_anubisbr scene104_choice08_op1_cdb9fcb4:

#   minthra "Continue proving your worth, and I shall grant you powers and knowledge far beyond your comprehension."
    minthra "Continue demonstrando seu valor, e eu lhe concederei poderes e conhecimento muito além da sua compreensão."

# game/script4.rpy:1353
translate pt_br_anubisbr scene104_choice08_op1_cb36832a:

#   Millicent "What did you do to him?"
    Millicent "O que você fez com ele?"

# game/script4.rpy:1355
translate pt_br_anubisbr scene104_choice08_op1_50b0cf8e:

#   mc "I gave him a choice."
    mc "Eu lhe dei uma escolha."

# game/script4.rpy:1357
translate pt_br_anubisbr scene104_choice08_op1_6d7100b8:

#   alex "What choice? That didn't look like a choice."
    alex "Que escolha? Aquilo não parecia uma escolha."

# game/script4.rpy:1359
translate pt_br_anubisbr scene104_choice08_op1_a711de6b:

#   Millicent "[mc]! We can't let him live. He'll regroup, find somewhere else, start this all over again!"
    Millicent "[mc] Não podemos deixá-lo viver. Ele vai se reagrupar, encontrar outro lugar e começar tudo de novo!"

# game/script4.rpy:1361
translate pt_br_anubisbr scene104_choice08_op1_ed2307d0:

#   mc "I said let him."
    mc "Eu disse: deixe-o ir."

# game/script4.rpy:1362
translate pt_br_anubisbr scene104_choice08_op1_46b78c6a:

#   thulkin "...If he's under his will, then I assume he won't be hurting anyone anymore. Isn't that right, [mc]?"
    thulkin "...Se ele está sob seu controle, então presumo que não fará mais mal a ninguém. Não é verdade? [mc]?"

# game/script4.rpy:1364
translate pt_br_anubisbr scene104_choice08_op1_e764f44d:

#   mc "We're done here."
    mc "Terminamos por aqui."

# game/script4.rpy:1365
translate pt_br_anubisbr scene104_choice08_op1_f5bb9afe:

#   perception "As you leave the chamber, you glance back once. The chieftain's kneeling form fades into the smoke, still watching you."
    perception "Ao sair da câmara, você olha para trás uma última vez. A figura ajoelhada do chefe desaparece na fumaça, ainda observando você."

# game/script4.rpy:1370
translate pt_br_anubisbr scene104_choice08_op2_a88d5652:

#   chieftain "Yeeessh, Mashter..."
    chieftain "Nossa, Mestre..."

# game/script4.rpy:1376
translate pt_br_anubisbr scene104_choice08_op2_a6eb4131:

#   thulkin "T-They talk!?"
    thulkin "E-Eles falam!?"

# game/script4.rpy:1378
translate pt_br_anubisbr scene104_choice08_op2_1e3b1ff8:

#   minthra "What have you done? This {i}isn't{/i} what I ordered you to do."
    minthra "O que você fez? Isto {i} não é{/i} O que eu ordenei que você fizesse."

# game/script4.rpy:1379
translate pt_br_anubisbr scene104_choice08_op2_11e54739:

#   mc "(I will use your power, but not as you intend.)"
    mc "(Usarei seu poder, mas não da maneira que você pretende.)"

# game/script4.rpy:1383
