    perception "Ela se estica demais. Só um pouquinho. Você segura o pulso dela, torce e crava a lâmina no corpo dela."

# game/script4.rpy:5053
translate pt_br_anubisbr scene111_choice04_op2_143d525f:

#   lena "GHNN! LET GO!"
    lena "GHNN! SOLTA!"

# game/script4.rpy:5054
translate pt_br_anubisbr scene111_choice04_op2_9b41cd83:

#   mc "(I'm sorry.)"
    mc "(Desculpe.)"

# game/script4.rpy:5057
translate pt_br_anubisbr scene111_choice04_op2_fa3c4645:

#   lena "Gahn!"
    lena "Gahn!"

# game/script4.rpy:5064
translate pt_br_anubisbr scene111_choice04_op2_c4bb8b78:

#   perception "You twist her hand and drives the blade into her body. A choked gasp escapes her lips. She looks down at the blood blooming across her tunic. The fury drains from her face, replaced by surprise and sorrow."
    perception "Você torce a mão dela e crava a lâmina em seu corpo. Um suspiro sufocado escapa de seus lábios. Ela olha para o sangue que se espalha por sua túnica. A fúria desaparece de seu rosto, substituída por surpresa e tristeza."

# game/script4.rpy:5069
translate pt_br_anubisbr scene111_choice04_op2_af45b654:

#   lena "Serena..."
    lena "Serena..."

# game/script4.rpy:5071
translate pt_br_anubisbr scene111_choice04_op2_937f2e23:

#   jenny "Dammit... *sigh* I suppose there wasn't any other way."
