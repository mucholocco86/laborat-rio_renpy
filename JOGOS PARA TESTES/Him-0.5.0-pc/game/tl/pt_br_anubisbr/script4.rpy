#   alex "Wait. I think the chain is weakening... or is that just me?"
    alex "Espere. Acho que a corrente está enfraquecendo... ou é só impressão minha?"

# game/script4.rpy:8888
translate pt_br_anubisbr scene117_choice01_op1_39c30f78:

#   lewis "Please let it be weakening. Please, please, please..."
    lewis "Por favor, que esteja enfraquecendo. Por favor, por favor, por favor..."

# game/script4.rpy:8891
translate pt_br_anubisbr scene117_choice01_op1_cf4c671a:

#   mc "FUUUCKK!"
    mc "PORRA!"

# game/script4.rpy:8892
translate pt_br_anubisbr scene117_choice01_op1_4ed09837:

#   alex "I-I think you're actually doing it! One more time!"
    alex "Acho que você está mesmo conseguindo! Mais uma vez!"

# game/script4.rpy:8894
translate pt_br_anubisbr scene117_choice01_op1_ed683915:

#   mc "GET... OFF... OF... HER!"
    mc "SAI DE CIMA DELA!"

