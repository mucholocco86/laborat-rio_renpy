#   mc "..."
    mc "..."

# game/script4.rpy:11197
translate pt_br_anubisbr scene120_choice03_op1_0c4286eb:

#   mc "I want us to have another chance, Becky."
    mc "Quero que tenhamos outra chance, Becky."

# game/script4.rpy:11198
translate pt_br_anubisbr scene120_choice03_op1_36c6bc4c:

#   mc "I ignored you before. I was stupid."
    mc "Eu te ignorei antes. Fui estúpido."

