    lewis "Bem mais seguro daqui, com certeza. Não se preocupem conosco, nós cuidaremos de nós mesmos. Só garantam que a princesa sobreviva."

# game/script4.rpy:8911
translate pt_br_anubisbr scene117_choice01_op1_1a484205:

#   lewis "Go!"
    lewis "Ir!"

# game/script4.rpy:8915
translate pt_br_anubisbr scene117_choice01_op1_02334cc0:

#   joan "Time's out! Get out of there! NOW!"
    joan "O tempo acabou! Saiam daí! AGORA!"

# game/script4.rpy:8917
translate pt_br_anubisbr scene117_choice01_op1_76ba121b:

#   alex "We will. Come on, let's carry her!"
    alex "Vamos sim. Vamos lá, vamos carregá-la!"

# game/script4.rpy:8919
translate pt_br_anubisbr scene117_choice01_op1_71481d6f:

