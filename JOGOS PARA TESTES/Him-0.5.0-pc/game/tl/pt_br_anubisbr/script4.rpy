#   alex "Not even my sword could do it. You really think you can manage with our your hands?"
    alex "Nem mesmo minha espada conseguiria. Você acha mesmo que consegue fazer isso só com as mãos?"

# game/script4.rpy:8882
translate pt_br_anubisbr scene117_choice01_op1_4f437b33:

#   mc "I don't need to break it. Just need to yank it out."
    mc "Não preciso quebrar. Só preciso arrancar."

# game/script4.rpy:8886
translate pt_br_anubisbr scene117_choice01_op1_93e8e32b:

