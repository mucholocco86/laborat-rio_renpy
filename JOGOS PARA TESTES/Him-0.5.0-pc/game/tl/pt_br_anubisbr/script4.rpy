#   r "Please."
    r "Por favor."

# game/script4.rpy:11157
translate pt_br_anubisbr scene120_3_4dacb065_1:

#   r "Do you... love me, [mc]?"
    r "Você me ama, [mc]?"

# game/script4.rpy:11188
