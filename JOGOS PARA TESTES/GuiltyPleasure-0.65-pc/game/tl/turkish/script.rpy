# game/script.rpy:3234
translate turkish V6Act30_5ce31a04:

    # L "I think it’s really just the taboo when thinking about you with them."
    L "Sanırım, seni onlarla düşününce, bunun tabu olması beni cezbetti."

# game/script.rpy:3236
