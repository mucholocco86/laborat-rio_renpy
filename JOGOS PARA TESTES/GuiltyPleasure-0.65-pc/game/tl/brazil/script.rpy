translate brazil V11Act51_ba65a712:

#   MC "Hah, you might be right about that."
    MC "Hah, você pode ter razão."

# game/script.rpy:7716
translate brazil V11Act51_4dab0aff:

#   L "Anyway, I should get back to my room before [RachelName] gets suspicious."
    L "Enfim, eu deveria voltar para o meu quarto antes [RachelName] fica desconfiado."

