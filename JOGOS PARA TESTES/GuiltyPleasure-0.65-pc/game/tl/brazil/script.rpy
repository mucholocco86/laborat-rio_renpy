translate brazil V11Act52_be5dd79d:

#   R "Really?!"
    R "Realmente?!"

# game/script.rpy:7847
translate brazil V11Act52_18885d72:

#   R "Oh thank god, I really needed a vacation."
    R "Graças a Deus, eu realmente precisava de férias."

