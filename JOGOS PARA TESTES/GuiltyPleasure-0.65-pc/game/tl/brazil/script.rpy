# game/script.rpy:7734
translate brazil V11Act51_7e253784:

#   L "What is that supposed to mean?"
    L "O que isso quer dizer?"

# game/script.rpy:7736
translate brazil V11Act51_26dd2cc0:

#   MC "The romantic type."
    MC "O tipo romântico."

# game/script.rpy:7738
translate brazil V11Act51_ee124086:

#   L "I take what I can get."
    L "Aceito o que consigo."

# game/script.rpy:7746
translate brazil V11Act51_40199da3:

#   L "Mwah."
    L "Uau."

# game/script.rpy:7755
translate brazil V11Act51_79b63cdc:

#   L "See you later."
    L "Até mais."

# game/script.rpy:7757
translate brazil V11Act51_998b3b43:

#   MCT "Alright, I guess it’s time to talk to [RachelName]…"
    MCT "Muito bem, acho que está na hora de conversar com [RachelName] …"

