translate brazil V11Act52_f6a7a3f0:

#   MC "How many vacation days do you have?"
    MC "Quantos dias de férias você tem?"

# game/script.rpy:7869
translate brazil V11Act52_d423cc06:

#   R "A lot, I haven’t taken any time off for a long while already."
    R "Bastante, já faz um bom tempo que não tiro férias."

# game/script.rpy:7871
translate brazil V11Act52_06d09aea:

#   R "So it shouldn’t be a problem."
    R "Portanto, não deve haver problema."

# game/script.rpy:7873
translate brazil V11Act52_6a513de4:

#   MC "Glad to hear that."
    MC "Que bom ouvir isso."

# game/script.rpy:7875
translate brazil V11Act52_3729c9ed:

#   MC "Well, I should get going now."
    MC "Bem, eu já devo ir."

# game/script.rpy:7877
translate brazil V11Act52_53a7fbd8:

#   R "[MC], wait."
    R "[MC], espere."

# game/script.rpy:7879
translate brazil V11Act52_0aa8ebcf:

#   R "Sorry about earlier…"
    R "Desculpe pelo ocorrido anteriormente…"

# game/script.rpy:7881
translate brazil V11Act52_803c65fb:

#   R "I might have overreacted a little, I just got overwhelmed by it all…"
    R "Talvez eu tenha exagerado um pouco, fiquei simplesmente sobrecarregado com tudo isso…"

# game/script.rpy:7883
translate brazil V11Act52_c6d9e799:

#   MC "It’s fine, anyone else would react the same way, or worse…"
    MC "Está tudo bem, qualquer outra pessoa reagiria da mesma forma, ou pior…"

# game/script.rpy:7885
translate brazil V11Act52_c58b9bc7:

#   R "Thanks for understanding, see you later."
    R "Obrigado pela compreensão, até mais."

# game/script.rpy:7887
translate brazil V11Act52_4cdc9702:

#   MC "Later!"
    MC "Mais tarde!"

# game/script.rpy:7901
translate brazil V11Act53_f821965b:

#   MC "Ughh…"
    MC "Eca…"

# game/script.rpy:7903
translate brazil V11Act53_a0d51ec3:

#   MCT "Ah fuck, gotta go to the bathroom…"
    MCT "Ah, droga, preciso ir ao banheiro…"

# game/script.rpy:7905
translate brazil V11Act53_a6cb065e:

#   MCT "Huh? [RachelName]’s still awake?"
    MCT "Huh? [RachelName]'s ainda está acordado?"

# game/script.rpy:7907
translate brazil V11Act53_a7936840:

#   MCT "What’s she doing up this late?"
    MCT "O que ela está fazendo acordada a essa hora?"

# game/script.rpy:7916
translate brazil V11Act53_6a4114e6:

#   MCT "Holy shit."
    MCT "Puta merda."

# game/script.rpy:7926
translate brazil V11Act53_7a8267dc:

#   R "Oooh, fuck…"
    R "Ah, que droga…"

# game/script.rpy:7927
translate brazil V11Act53_7fafb0e1:

#   MCT "I can’t believe it."
    MCT "Não consigo acreditar."

# game/script.rpy:7934
translate brazil V11Act53_e28da3b6:

#   R "Mmmmmm…"
    R "Hummm…"

# game/script.rpy:7935
translate brazil V11Act53_a5ca3548:

#   MCT "Fuck, I shouldn’t be watching this…"
    MCT "Puta merda, eu não devia estar assistindo isso…"

# game/script.rpy:7937
translate brazil V11Act53_8bd34909:

#   MCT "With all that’s happened lately, if she catches me now I’m truly fucked."
    MCT "Com tudo o que aconteceu ultimamente, se ela me pegar agora, estou realmente ferrado."

# game/script.rpy:7939
translate brazil V11Act53_95396867:

#   MCT "Gotta leave…"
    MCT "Preciso ir…"

# game/script.rpy:7957
translate brazil V11Act53_fa080655:

#   MC "Good morning."
    MC "Bom dia."

# game/script.rpy:7959
translate brazil V11Act53_171d77b5:

#   M "Good morning!"
    M "Bom dia!"

# game/script.rpy:7961
translate brazil V11Act53_2e3e6c6e:

#   R "Hey, good morning!"
    R "Olá, bom dia!"

# game/script.rpy:7963
translate brazil V11Act53_f22f6713:

#   MC "What were you two talking about?"
    MC "Sobre o que vocês dois estavam conversando?"

# game/script.rpy:7965
translate brazil V11Act53_34257541:

#   M "I was just asking [RachelName] how come she’s in such a good mood today."
    M "Eu só estava perguntando [RachelName] Como é que ela está de tão bom humor hoje?"

