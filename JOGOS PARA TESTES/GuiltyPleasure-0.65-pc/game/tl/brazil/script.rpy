#   MC "So you {i}are{/i} interested."
    MC "Então você {i} são{/i} interessado."

# game/script.rpy:7706
translate brazil V11Act51_efbfcc53:

#   L "Just a little curious…"
    L "Só por curiosidade…"

# game/script.rpy:7708
translate brazil V11Act51_553ad829:

#   MC "Well, we got about as far as you and I got…"
    MC "Bem, nós chegamos mais ou menos até onde você e eu chegamos…"

