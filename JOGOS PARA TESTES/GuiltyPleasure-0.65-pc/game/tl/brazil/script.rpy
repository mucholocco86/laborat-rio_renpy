translate brazil V11Act52_e9e0b9b3:

#   MC "Straight to the point, huh?"
    MC "Direto ao ponto, né?"

# game/script.rpy:7801
translate brazil V11Act52_31759aa7:

#   R "Have to be…"
    R "Tem que ser…"

# game/script.rpy:7803
translate brazil V11Act52_71694a1d:

#   MC "Yeah…"
    MC "Sim…"

# game/script.rpy:7805
translate brazil V11Act52_9818e25b:

#   MC "So I talked to [LillyName], and told her we have to stop."
    MC "Então eu conversei com [LillyName] E disse a ela que tínhamos que parar."

