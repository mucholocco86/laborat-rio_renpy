translate brazil V11Act52_5c22e046:

#   R "We’re going somewhere?"
    R "Vamos a algum lugar?"

# game/script.rpy:7841
translate brazil V11Act52_583ae17d:

#   MC "Yeah, [rel.m] told me this morning."
    MC "Sim, [rel.m] me disse isso esta manhã."

