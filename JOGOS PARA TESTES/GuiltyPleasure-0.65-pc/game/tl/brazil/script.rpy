translate brazil V11Act52_a71bb49d:

#   R "How’d she take it?"
    R "Como ela reagiu?"

# game/script.rpy:7809
translate brazil V11Act52_700228c2:

#   MC "As well as you’d expect."
    MC "Tão bem quanto você esperaria."

# game/script.rpy:7811
translate brazil V11Act52_62dcc6ec:

#   R "And that means…"
    R "E isso significa…"

