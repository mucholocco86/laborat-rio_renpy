translate brazil V11Act52_274f0d95:

#   R "…"
    R "…"

# game/script.rpy:7829
translate brazil V11Act52_09ac9e67:

#   R "Ok, sorry. I just had to be sure…"
    R "Ok, desculpe. Eu só precisava ter certeza…"

