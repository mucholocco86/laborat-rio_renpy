    L "Ah, vai se foder, você sabe o que eu quero dizer."

# game/script.rpy:7702
translate brazil V11Act51_6060a4bc:

#   L "So how far did you two go?"
    L "Então, até onde vocês dois foram?"

# game/script.rpy:7704
