#   R "Yes."
    R "Sim."

# game/script.rpy:7789
translate brazil V11Act52_f006f077:

#   MC "Hey there, again…"
    MC "Olá novamente…"

# game/script.rpy:7791
translate brazil V11Act52_33abc901:

