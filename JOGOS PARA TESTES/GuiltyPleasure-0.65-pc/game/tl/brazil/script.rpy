translate brazil V11Act52_6d182e3b:

#   R "[MC], look at me."
    R "[MC], olhe para mim."

# game/script.rpy:7821
translate brazil V11Act52_1645c2c8:

#   R "And don’t lie to me."
    R "E não minta para mim."

# game/script.rpy:7823
translate brazil V11Act52_47256a3a:

#   R "Are you actually going to stop?"
    R "Você vai mesmo parar?"

# game/script.rpy:7825
translate brazil V11Act52_ce23fefc:

#   MC "Yes [RachelName], we will stop."
    MC "Sim [RachelName], vamos parar."

