translate brazil V30Act128_3e629e2d:

#   MC "I think that went pretty well overall."
    MC "Acho que, no geral, correu muito bem."

# game/script.rpy:18458
translate brazil V30Act128_7df184cb:

#   Y "Yea, for you maybe, ass-kisser."
    Y "É, talvez para você, puxa-saco."

