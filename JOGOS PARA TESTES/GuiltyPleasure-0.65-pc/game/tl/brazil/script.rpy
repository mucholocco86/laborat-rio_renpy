translate brazil V11Act52_13f44d6a:

#   R "Not just from work, but considering everything else too…"
    R "Não apenas no trabalho, mas considerando tudo o mais também…"

# game/script.rpy:7851
translate brazil V11Act52_a22732fa:

#   R "Ugh, sorry , I don’t know why I keep going back to that…"
    R "Ah, desculpe, não sei por que continuo voltando a esse assunto…"

# game/script.rpy:7853
translate brazil V11Act52_3af67082:

#   MC "Don’t worry about it."
    MC "Não se preocupe com isso."

# game/script.rpy:7855
translate brazil V11Act52_4d18c3c7:

#   MC "I get it can be a bit… shocking."
    MC "Entendo que possa ser um pouco... chocante."

# game/script.rpy:7857
translate brazil V11Act52_11ff3889:

#   R "Yeah, to say the least…"
    R "Sim, para dizer o mínimo…"

