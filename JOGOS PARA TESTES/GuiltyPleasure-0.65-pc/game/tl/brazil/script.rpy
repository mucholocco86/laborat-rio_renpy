translate brazil V11Act52_891ac353:

#   MC "She was a little angry, but understands."
    MC "Ela ficou um pouco irritada, mas entendeu."

# game/script.rpy:7815
translate brazil V11Act52_e5bbef02:

#   R "And you are actually going to stop?"
    R "E você vai mesmo parar?"

