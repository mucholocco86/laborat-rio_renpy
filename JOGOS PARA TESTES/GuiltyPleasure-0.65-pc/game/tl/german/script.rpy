    # Y "Well, that explains why you’re so tanned and fit."
    Y "Das erklärt natürlich, wieso du so fit und gebräunt bist."

# game/script.rpy:2087
translate german V4Act21_1de9a5e5:

    # Y "I just thought you were a gym rat."
    Y "Ich hätt' ja eher auf Muckibude getippt."

# game/script.rpy:2089
translate german V4Act21_430d159f:

    # MC "Haha, nah, we actually do have a small home gym though."
    MC "Haha, nein, aber wir haben tatsächlich ein paar Fitnessgeräte zuhause."

# game/script.rpy:2091
translate german V4Act21_c5c6b117:

    # L "But we barely use it."
    L "Die verwendet aber nie wer."

# game/script.rpy:2093
translate german V4Act21_4fcf2f03:

    # MC "[rel.M] does, sometimes."
    MC "[rel.M] schon... manchmal."

# game/script.rpy:2095
translate german V4Act21_f4e328b4:

    # L "Very rarely."
    L "Sehr selten."

# game/script.rpy:2102
translate german V4Act22_d9a6f802:

    # L "Anyway, I think it’s time we get going."
    L "Wie auch immer, wir sollten dann langsam los."

# game/script.rpy:2104
translate german V4Act22_95362d18:

    # Y "Why not hang around a little longer?"
    Y "Könnt ihr nicht noch länger bleiben?"

# game/script.rpy:2106
translate german V4Act22_6be3d8e4:

    # MC "Shouldn’t you finish your talk with the owner though?"
    MC "Solltest du nicht zuerst noch dein Gespräch mit dem Besitzer abschließen?"

# game/script.rpy:2108
translate german V4Act22_862e3a39:

    # L "Oh, right."
    L "Oh, richtig."

# game/script.rpy:2110
translate german V4Act22_bbc3f0f7:

    # L "I’ll be right back."
    L "Bin gleich zurück."

# game/script.rpy:2112
translate german V4Act22_83abf125:

    # Y "Soo…"
    Y "Aaaalso..."

# game/script.rpy:2114
translate german V4Act22_1e7176bc:

    # Y "You and Lilly seem pretty close."
    Y "Du und Lilly, ihr scheint euch ja echt nahe zu stehen."

# game/script.rpy:2116
translate german V4Act22_4a075af6:

    # MC "What do you mean?"
    MC "Wie meinst du das?"

# game/script.rpy:2118
translate german V4Act22_6fc1929e:

    # Y "You kept giving each other looks."
    Y "Na eure Blicke die ganze Zeit."

# game/script.rpy:2120
translate german V4Act22_0088adbd:

    # Y "And you seem to be ‘clicking’ when talking to each other."
    Y "Und ihr scheint auf derselben Wellenlänge zu schwimmen, wenn ihr miteinander redet."

