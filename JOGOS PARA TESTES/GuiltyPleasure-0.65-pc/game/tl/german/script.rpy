translate german V4Act21_54dcec4d:

    # Y "Your [rel.m] really wants you two to start working huh."
    Y "Eure [rel.M] will euch wohl echt dringend Geldverdienen schicken."

# game/script.rpy:2053
translate german V4Act21_e12ec122:

    # MC "Eh, she did something like this last year too."
    MC "Äh, sowas hat sie letztes Jahr auch schon gemacht."

# game/script.rpy:2055
translate german V4Act21_349ca180:

    # L "She could just give us money, but she doesn’t want us to get used to it."
    L "Sie könnte uns ohne Probleme auch einfach so Geld zustecken, aber sie will nicht, dass wir uns daran gewöhnen könnten."

# game/script.rpy:2057
translate german V4Act21_b5fe8a9f:

    # MC "Thinks it might make us spoiled."
    MC "Sie meint das würde uns nur verziehen."

# game/script.rpy:2059
translate german V4Act21_3c14ab95:

    # L "And less ‘independent’."
    L "Und weniger 'unabhängig' machen."

# game/script.rpy:2061
translate german V4Act21_d850fd12:

    # MC "I don’t really mind it though."
    MC "Ich hätt' ja wirklich nichts dagegen."

# game/script.rpy:2063
translate german V4Act21_ab091376:

    # MC "Sure, nobody likes working."
    MC "Keiner geht gerne arbeiten, normalerweise."

# game/script.rpy:2065
translate german V4Act21_a3411abd:

    # MC "But it feels much better when you’re earning your own money."
    MC "Aber es fühlt sich schon toll an, wenn man selber sein eigenes Geld verdient."

# game/script.rpy:2067
translate german V4Act21_2b50622a:

    # L "Even better when you get to spend it."
    L "Vorallem wenn man es dann auch selber ausgeben kann."

# game/script.rpy:2069
translate german V4Act21_7839534d:

    # MC "Exactly."
    MC "Genau."

# game/script.rpy:2071
translate german V4Act21_a66e3030:

    # Y "What did you guys do last year?"
    Y "Und was habt ihr letztes Jahr gemacht?"

# game/script.rpy:2073
translate german V4Act21_b9a1d9ff:

    # L "I was a babysitter for 2 kids."
    L "Ich war zwei Kinder babysitten."

# game/script.rpy:2075
translate german V4Act21_2bc87915:

    # L "They were good kids, so the job was a breeze."
    L "Die waren richtig brav daher war der Job ein Spaziergang."

# game/script.rpy:2077
translate german V4Act21_6dcdb5c6:

    # L "All I had to do was cook and clean."
    L "Ich musste im Grunde nur Kochen und Putzen."

# game/script.rpy:2079
translate german V4Act21_1f34e842:

    # MC "I did some ‘landscaping’ stuff."
    MC "Ich hab' 'Landschaftsgestaltung' gemacht..."

# game/script.rpy:2081
translate german V4Act21_c2de8a53:

    # MC "Mowing lawns, trimming hedgerows, pool cleaning."
    MC "Also Rasenmähen, Hecken schneiden, Schwimmbecken reinigen..."

# game/script.rpy:2083
translate german V4Act21_2f3693b4:

    # MC "Little stuff like that."
    MC "So Zeug eben."

# game/script.rpy:2085
