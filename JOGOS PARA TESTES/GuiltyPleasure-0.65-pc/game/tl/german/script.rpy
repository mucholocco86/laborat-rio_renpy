translate german V4Act22_f64a2a70:

    # MC "Uh, if you say so."
    MC "Äh, wenn du das sagst."

# game/script.rpy:2124
translate german V4Act22_8eb79c35:

    # Y "Aren’t you?"
    Y "Etwa nicht?"

# game/script.rpy:2126
translate german V4Act22_7d01f37e:

    # MC "Clicking?"
    MC "Schwimmen?"

# game/script.rpy:2128
translate german V4Act22_1223fcbc:

    # Y "No, I mean close."
    Y "Nein, euch nahe stehen."

# game/script.rpy:2130
translate german V4Act22_79e46a96:

    # MC "Well, I guess we kind of are."
    MC "Also, glaub' schon, irgendwie."

# game/script.rpy:2132
translate german V4Act22_5645d490:

    # MC "At least lately."
    MC "In letzer Zeit jedenfalls."

# game/script.rpy:2134
translate german V4Act22_3aa3daf3:

    # Y "Just lately?"
    Y "Nur in letzter Zeit?"

# game/script.rpy:2136
translate german V4Act22_52f156f5:

    # MC "Yeah, we weren’t this close before."
    MC "Ja, wir waren bis jetzt nicht so dicke."

# game/script.rpy:2138
translate german V4Act22_fee3d8f7:

    # MC "She had her friends, I had mine, it wasn’t that often that we happened to be in the same group."
    MC "Sie hatte ihre Freunde, ich hatte meine. Es kam nicht oft vor, dass wir in derselben Gruppe unterwegs waren."

# game/script.rpy:2140
translate german V4Act22_9c3bf261:

    # MC "I’m actually closest to Rachel probably, my older [rel.si]."
    MC "Mit Rachel, meiner älteren [rel.Si] sieht das allerdings wieder ganz anders aus."

# game/script.rpy:2142
translate german V4Act22_a980d00c:

    # Y "You have an older [rel.si] too?"
    Y "Du hast sogar noch eine ältere [rel.Si]?"

# game/script.rpy:2144
translate german V4Act22_7f31dd44:

    # MC "Yeah, [rel.m] didn’t tell you?"
    MC "Klar, hat meine [rel.M] das nie erwähnt?"

# game/script.rpy:2146
translate german V4Act22_7179f11d:

    # Y "It’s not like we talk much, I just overhear her talking to my mom sometimes."
    Y "Ist ja nicht so, als hätte ich mich groß mit ihr unterhalten. Hab' wenn überhaupt nur etwas aufgeschnappt, wenn sie mit meiner Mama gequatscht hat."

# game/script.rpy:2148
translate german V4Act22_73ee2208:

    # MC "So eavesdropping. Got it."
    MC "Belauscht hast du sie also, verstehe."

# game/script.rpy:2150
translate german V4Act22_44ac7d1f:

    # Y "Maaaybe…"
    Y "Viieelleicht..."

# game/script.rpy:2152
translate german V4Act22_f4e5b29c:

    # MC "Anyway, me and Rachel are close enough that strangers sometimes think we are a couple."
    MC "Na jedenfalls stehen Rachel und ich uns so nahe, das Aussenstehende uns öfter mal für ein Pärchen halten."

# game/script.rpy:2154
translate german V4Act22_05259e58:

    # Y "Haha."
    Y "Haha."

# game/script.rpy:2156
translate german V4Act22_7bedd08c:

    # Y "What about your father?"
    Y "Und was ist mit deinem Papa?"

# game/script.rpy:2158
translate german V4Act22_8d6904fe:

    # Y "I never hear your [rel.m] talking about him when she comes over." nointeract
    Y "Hab' deine [rel.M] noch nie von ihm reden hören, wenn sie bei uns war." nointeract

# game/script.rpy:2162
translate german V4Act22_72756df5:

    # MC "I’d rather not talk about him to be honest."
    MC "Über den will ich ehrlich gesagt lieber nicht sprechen."

# game/script.rpy:2164
translate german V4Act22_0b8eff20:

    # Y "I get it, that’s fine."
    Y "Versteh' schon, ist okay."

# game/script.rpy:2168
translate german V4Act22_73984a2c:

    # MC "Well… they divorced when I was like 2 or 3 years old, I don’t remember much of him."
    MC "Naja... die haben sich scheiden lassen als ich so 2 oder 3 Jahre alt war. Ich erinner mich an kaum etwas von ihm."

# game/script.rpy:2170
translate german V4Act22_6c3fb05b:

    # MC "[rel.M] had gotten fed up having to work all day, only for him to spend everything on booze."
    MC "[rel.M] hat es irgendwann gereicht, dass sie sich im Job den Arsch aufreißt, nur damit er alles versäuft."

# game/script.rpy:2172
translate german V4Act22_6fc17b98:

    # MC "She was just an assistant at the company back then."
    MC "Damals war sie ja nur eine Assistentin in der Firma."

# game/script.rpy:2174
translate german V4Act22_f86e752e:

    # MC "Had to do a lot more hours, for much less pay."
    MC "Viel mehr Stunden, für deutlich weniger Gehalt."

# game/script.rpy:2176
translate german V4Act22_c3d86c2e:

    # MC "So Rachel was the one taking care of us most of the time."
    MC "Rachel hat sich daher hauptsächlich die meiste Zeit um uns gekümmert."

# game/script.rpy:2178
translate german V4Act22_2f2ea88c:

    # MC "Until [rel.m] got the promotion a few years later."
    MC "Bis [rel.M] dann ein paar Jahre später endlich eine Beförderung bekommen hat."

# game/script.rpy:2180
translate german V4Act22_cd3684e6:

    # Y "That must have been tough."
    Y "Das waren sicher schwere Zeiten."

# game/script.rpy:2182
translate german V4Act22_8a9e8fd1:

    # MC "It’s fine, it’s in the past, things are much better now."
    MC "Schon okay, das ist Vergangenheit. Heute sind die Dinge viel besser."

# game/script.rpy:2184
translate german V4Act22_a0336818:

    # MC "What about you?"
    MC "Was ist mit dir?"

# game/script.rpy:2186
translate german V4Act22_e6eae78d:

    # Y "What do you mean?" nointeract
    Y "Was genau meinst du?" nointeract

# game/script.rpy:2191
translate german V4Act22_81c13546:

    # MC "You don’t really look like Eileen…"
    MC "Du... siehst Eileen nicht wirklich ähnlich..."

# game/script.rpy:2193
translate german V4Act22_f574acad:

    # Y "…"
    Y "..."

# game/script.rpy:2195
translate german V4Act22_d882a6e3:

    # Y "Well… She’s actually my aunt."
    Y "Naja... sie ist ja auch genau genommen meine Tante."

# game/script.rpy:2197
translate german V4Act22_b674667b:

    # Y "My dad’s cousin."
    Y "Die Cousine von meinem Vater."

# game/script.rpy:2199
translate german V4Act22_98e4b021:

    # Y "Look, can we change the subject?"
    Y "Können wir bitte das Thema wechseln?"

# game/script.rpy:2202
translate german V4Act22_6f42cdc3:

    # Y "Sorry, I know you opened up to me and all..."
    Y "Sorry, du hast dich mir anvertraut und so..."

# game/script.rpy:2204
translate german V4Act22_d8ba7fd5:

    # Y "But I’d rather not talk about it."
    Y "Aber ich will da eigentlich nicht darüber reden."

# game/script.rpy:2206
translate german V4Act22_6972b220:

    # MC "Sorry, I didn’t know it was a sensitive subject."
    MC "'Tschuldige, hätt' ich gewusst, wie sensibel das Thema ist..."

# game/script.rpy:2209
translate german V4Act22_1c764e74:

    # Y "I’d rather not talk about it…"
    Y "Will wirklich nicht darüber reden..."

# game/script.rpy:2211
translate german V4Act22_643cff6b:

    # MC "Yeah… sorry for asking."
    MC "Schon klar, vergiss meine Frage."

# game/script.rpy:2213
translate german V4Act22_78b71619:

    # Y "Hey, at least we’re even now."
    Y "Hey, jetzt sind wir zumindest quitt."

# game/script.rpy:2215
translate german V4Act22_120104e8:

    # MC "Haha, yeah…"
    MC "Haha, genau..."

# game/script.rpy:2218
translate german V4Act22_ae7a5baf:

    # MC "Actually nevermind."
    MC "Ach vergiss es."

# game/script.rpy:2220
translate german V4Act22_e0e1a274:

    # L "I’m hired!"
    L "Hab' den Job!"

# game/script.rpy:2222
translate german V4Act22_9f4d1699:

    # MC "I knew you’d get it, good job."
    MC "Ich wusste, du schaffst das, gut gemacht."

# game/script.rpy:2224
translate german V4Act22_05a7fa89:

    # Y "Congratulations."
    Y "Gratuliere."

# game/script.rpy:2226
translate german V4Act22_63f0d37c:

    # L "Thanks, I start tomorrow!"
    L "Danke, ich fang' schon morgen an!"

# game/script.rpy:2228
translate german V4Act22_0afcd97c:

    # L "Are you ready to head out, [MC]?"
    L "Können wir dann los, [MC]?"

# game/script.rpy:2230
translate german V4Act22_55ffa6c9:

    # Y "What’s the rush?"
    Y "Wieso die Eile?"

# game/script.rpy:2232
translate german V4Act22_b22e3115:

    # L "I… have some stuff to do, and it’d take too long to get back on foot."
    L "Ich... hab noch Sachen zu erledigen und ohne Auto ist der Heimweg einfach zu lang."

# game/script.rpy:2234
translate german V4Act22_c089ffa8:

    # MC "I guess it’s time to go."
    MC "Dann muss ich wohl los."

# game/script.rpy:2236
translate german V4Act22_fafc0c4e:

    # Y "Well, see you tomorrow [MC]."
    Y "Tja, dann sehen wir uns morgen, [MC]."

