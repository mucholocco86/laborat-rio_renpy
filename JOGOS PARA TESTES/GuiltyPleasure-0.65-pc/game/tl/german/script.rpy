translate german V4Act22_dabf4ded:

    # MC "See you."
    MC "Bis morgen."

# game/script.rpy:2245
translate german V4Act23_f7739509:

    # MC "So what stuff do you have to do?"
    MC "Und was hast du so dringendes zu erledigen?"

# game/script.rpy:2247
