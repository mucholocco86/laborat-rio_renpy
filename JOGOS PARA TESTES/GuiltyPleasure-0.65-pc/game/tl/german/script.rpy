    # L "I have to try on some clothes for my uniform."
    L "Ich muss mein Outfit für die Arbeit zusammenstellen."

# game/script.rpy:2249
translate german V4Act23_094fe250:

    # L "I could actually use your opinion."
    L "Und da hätte ich gerne deine Meinung dazu."

# game/script.rpy:2251
translate german V4Act23_eb314dba:

    # MC "Sure, let’s go."
    MC "Klar, dann los."

# game/script.rpy:2253
translate german V4Act23_570a0794:

    # L "I need a shower first, so just wait in my room."
