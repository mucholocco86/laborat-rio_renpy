translate brazil G48_f6c33d4f:

#   Character("???", color="#bd334a") "That's normal, yeah..."
    Character("???", color="#bd334a") "Isso é normal, sim..."

# game/chapter_12.rpy:4409
translate brazil G48_d7c76b34:

#   Character("???", color="#fff5d9") "I'm sorry, [mc_name]... I know it's too much at one time... But we have to break you out of it now... That's probably the best chance we have had in months..."
    Character("???", color="#fff5d9") "Me desculpe, [mc_name]... Eu sei que é demais de uma só vez... Mas temos que tirar você dessa agora... Essa é provavelmente a melhor chance que tivemos em meses..."

# game/chapter_12.rpy:4411
translate brazil G48_219855a0:

#   Character("???", color="#bd334a") "We know it's too much to handle... But please try to comprehend this... For Seira..."
    Character("???", color="#bd334a") "Sabemos que é demais para lidar... Mas, por favor, tente compreender isso... Para Seira..."

# game/chapter_12.rpy:4413
translate brazil G48_afa5e877:

#   z "(Do those fuckers think I'll fall for this?!)"
    z "(Esses filhos da puta acham que vou cair nessa?!)"

