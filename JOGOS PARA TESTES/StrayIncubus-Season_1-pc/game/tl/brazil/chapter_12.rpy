# game/chapter_12.rpy:4385
translate brazil G48_e4175d0a:

#   Character("???", color="#bd334a") "Your mind would reject it."
    Character("???", color="#bd334a") "Sua mente iria rejeitá-lo."

# game/chapter_12.rpy:4386
translate brazil G48_b58f36b2:

#   Character("???", color="#bd334a") "And sometimes go as far as creating an alternate version..."
    Character("???", color="#bd334a") "E às vezes chega a criar uma versão alternativa..."

# game/chapter_12.rpy:4388
translate brazil G48_a5367b68:

#   z "The fuck are you-"
    z "Que porra você está-"

# game/chapter_12.rpy:4391
translate brazil G48_209618a8:

#   Character("???", color="#bd334a") "You were the hardest one we ever worked with..."
    Character("???", color="#bd334a") "Você foi a pessoa mais difícil com quem já trabalhamos..."

# game/chapter_12.rpy:4393
translate brazil G48_ad251fd1:

#   Character("???", color="#fff5d9") "Imagining stuff left and right..."
    Character("???", color="#fff5d9") "Imaginando coisas a torto e a direito..."

# game/chapter_12.rpy:4395
translate brazil G48_88781cab:

#   z "Stop... What the fuck are you on about?"
    z "Pare... Que porra você está falando?"

# game/chapter_12.rpy:4397
translate brazil G48_cb1bf05e:

#   Character("???", color="#bd334a") "He's still resisting..."
    Character("???", color="#bd334a") "Ele ainda está resistindo..."

# game/chapter_12.rpy:4399
translate brazil G48_46b56517:

#   Character("???", color="#fff5d9") "I can see that..."
    Character("???", color="#fff5d9") "Eu posso ver isso..."

# game/chapter_12.rpy:4400
translate brazil G48_ce33111c:

#   Character("???", color="#fff5d9") "When we first looked into your mind we saw something, you see..."
    Character("???", color="#fff5d9") "Quando olhamos pela primeira vez em sua mente, vimos algo, você vê..."

# game/chapter_12.rpy:4401
translate brazil G48_03037dc0:

#   Character("???", color="#fff5d9") "Your mind was blocking loads and loads of memor-"
    Character("???", color="#fff5d9") "Sua mente estava bloqueando muitas e muitas memórias"

