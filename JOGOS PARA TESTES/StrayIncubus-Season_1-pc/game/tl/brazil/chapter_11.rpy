translate brazil G42_480326f9:

#   kury "But one room... The kitchen I think... It was lit."
    kury "Mas um quarto... A cozinha, eu acho... Estava iluminada."

# game/chapter_11.rpy:4323
translate brazil G42_7ae4746d:

#   kury "It was faint... Like a candle light or something..."
    kury "Estava fraco... Como a luz de uma vela ou algo assim..."

# game/chapter_11.rpy:4324
translate brazil G42_0dd0115b:

#   kury "Fara wanted to leave. She begged me to just leave..."
    kury "Fara queria ir embora. Ela me implorou para simplesmente ir embora..."

# game/chapter_11.rpy:4325
translate brazil G42_85eb940d:

#   kury "Then we saw a shadow on the floor move in there..."
    kury "Então vimos uma sombra no chão se movendo ali..."

