#   kury "I tried to open it, but it wouldn't budge."
    kury "Tentei abri-lo, mas não se mexeu."

# game/chapter_11.rpy:4344
translate brazil G42_513eccf3:

#   kury "I screamed for help. But there was no one around."
    kury "Gritei por socorro. Mas não havia ninguém por perto."

# game/chapter_11.rpy:4345
translate brazil G42_8d646d23:

#   kury "So I tried the back door..."
    kury "Então tentei pela porta dos fundos..."

# game/chapter_11.rpy:4346
translate brazil G42_7e9607b3:

#   kury "And it was open..."
    kury "E estava aberto..."

# game/chapter_11.rpy:4347
