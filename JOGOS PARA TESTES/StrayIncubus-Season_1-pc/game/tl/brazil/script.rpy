#   tr "Come on! Wake up!"
    tr "Vamos! Acordar!"

# game/script.rpy:23468
translate brazil srsly_last_choice_dream1_4c84e65a:

#   z "Huh?! Torr?!"
    z "Huh?! Torr?!"

