    s "É verdade. Você é um íncubo. O último da sua linhagem, pelo que sabemos."

# game/script.rpy:4201
translate brazil after_menu_81badbfd:

#   z "I am? And you knew this the whole time?"
    z "Eu sou? E você sabia disso o tempo todo?"

