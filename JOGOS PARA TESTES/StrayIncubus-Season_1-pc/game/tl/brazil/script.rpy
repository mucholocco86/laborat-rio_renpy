translate brazil after_menu_952db167:

#   s "No. The ninjas are known to be very good warriors. And they aren't hateful towards the dark races."
    s "Não. Os ninjas são conhecidos por serem ótimos guerreiros. E eles não odeiam as raças sombrias."

