    Character("Jamie, I guess...") "Dois minutos, minha querida."

# game/script.rpy:4587
translate brazil after_menu_cb9d7539:

#   z "Huh?! (What an asshole!)"
    z "Huh?! (Que idiota!)"

# game/script.rpy:4593
translate brazil after_menu_f812cbbc:

#   jnfr "..."
    jnfr "..."

