# game/script.rpy:4631
translate brazil after_menu_245dea0b:

#   z "You don't like him either, huh?"
    z "Você também não gosta dele, né?"

# game/script.rpy:4635
translate brazil after_menu_31618bbc:

#   gbrla "Nah..."
