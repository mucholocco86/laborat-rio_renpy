#   tmra "You think so?"
    tmra "Você acha que sim?"

# game/script.rpy:20040
translate brazil after_nixie_scene_744d5641:

#   tmra "Hm?"
    tmra "Hum?"

# game/script.rpy:20044
translate brazil after_nixie_scene_e20f878d:

#   tmra "Oh? Finished already? Well, the Keres wishes to see you."
    tmra "Oh? Já terminou? Bem, o Keres deseja ver você."

# game/script.rpy:20046
translate brazil after_nixie_scene_26f28b80:

#   z "(I can see that...)"
    z "(Eu posso ver isso...)"

# game/script.rpy:20050
translate brazil after_nixie_scene_d7d78ab2:

#   tmra "Thank you for the pleasant conversation, Keres Seira."
    tmra "Obrigado pela agradável conversa, Keres Seira."

# game/script.rpy:20052
translate brazil after_nixie_scene_ed77f0fa:

#   s "You're quite welcome, honey."
    s "De nada, querido."

# game/script.rpy:20064
translate brazil after_nixie_scene_7e1c9994:

#   s "How is your injury? Are you in pain?"
    s "Como está sua lesão? Você está com dor?"

