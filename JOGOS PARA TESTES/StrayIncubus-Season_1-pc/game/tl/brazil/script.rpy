#   Character("Jamie, I guess...") "An elf?"
    Character("Jamie, I guess...") "Um elfo?"

# game/script.rpy:4581
translate brazil after_menu_0b68ba1a:

#   z "Pleasure to meet you. My name-"
    z "Prazer em conhecê-lo. O meu nome-"

