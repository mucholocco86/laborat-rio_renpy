    z "Merda! (Não vai mudar!)" with vpunch

# game/script.rpy:27742
translate brazil v4night3choice4_a030a12c:

#   z "(Wait! It's not the temple, it's the house behind it.)"
    z "(Espere! Não é o templo, é a casa atrás dele.)"

# game/script.rpy:27746
translate brazil v4night3choice4_4b8d2c1d:

#   z "(Maybe...)"
    z "(Talvez...)"

# game/script.rpy:27750
translate brazil v4night3choice4_b55f078d:

#   z "(Yes! That must be it!)"
    z "(Sim! Deve ser isso!)"

# game/script.rpy:27754
translate brazil v4night3choice4_4b2cf070:

#   z "(Hang in there, Torr...)"
    z "(Aguente firme, Torr...)"

# game/script.rpy:27768
translate brazil v4night3choice4_ccb1e1bf:

#   z "(This is the place, right?)"
    z "(Este é o lugar, certo?)"

# game/script.rpy:27772
translate brazil v4night3choice4_6962ce46:

#   z "(But where's-)"
    z "(Mas onde está-)"

# game/script.rpy:27776
translate brazil v4night3choice4_63189881:

#   z "Torr!"
    z "Torr!"

# game/script.rpy:27780
translate brazil v4night3choice4_75567287:

#   z "Torr?! Are you okay?!"
    z "Torr?! Você está bem?!"

# game/script.rpy:27784
translate brazil v4night3choice4_d77181cd:

#   z "(Shit! Her head is bleeding. But I can see she's breathing, at least.)"
    z "(Merda! A cabeça dela está sangrando. Mas posso ver que ela está respirando, pelo menos.)"

# game/script.rpy:27788
translate brazil v4night3choice4_9c3f0d30:

#   z "(The fury's not here. I'll just untie her and-)"
    z "(A fúria não está aqui. Vou apenas desamarrá-la e-)"

# game/script.rpy:27792
translate brazil v4night3choice4_116fffdd:

#   "I had a feeling you'd come."
    "Tive a sensação de que você viria."

# game/script.rpy:27794
translate brazil v4night3choice4_514b2386:

#   z "Huh?! Who-"
    z "Huh?! Quem-"

# game/script.rpy:27798
translate brazil v4night3choice4_3b07fd29:

#   fry "After our encounter at the trial, I knew you wouldn't just sit there and let your friend die."
    fry "Depois do nosso encontro no julgamento, eu sabia que você não iria simplesmente ficar aí sentado e deixar seu amigo morrer."

# game/script.rpy:27804
translate brazil v4night3choice4_7c320807:

#   z "You!"
    z "Você!"

# game/script.rpy:27808
translate brazil v4night3choice4_5ad5e1af:

#   fry "Yes. It is I, incubus."
    fry "Sim. Sou eu, íncubo."

# game/script.rpy:27812
translate brazil v4night3choice4_dbd2fadb:

#   z "But I passed the trial! You said my friends and I can leave!"
    z "Mas eu passei no teste! Você disse que meus amigos e eu podemos ir embora!"

# game/script.rpy:27816
translate brazil v4night3choice4_2e215db3:

#   fry "Indeed you can. Save for her."
    fry "Na verdade você pode. Economize para ela."

# game/script.rpy:27820
translate brazil v4night3choice4_3f853a54:

#   z "What?! But why?"
    z "O que?! Mas por que?"

# game/script.rpy:27824
translate brazil v4night3choice4_4f3f7227:

#   fry "She broke the rules of the curse. She showed her face to a resident of this town."
    fry "Ela quebrou as regras da maldição. Ela mostrou seu rosto para um morador desta cidade."

# game/script.rpy:27828
translate brazil v4night3choice4_edffd080:

#   z "What?! No she didn't-"
    z "O que?! Não, ela não-"

# game/script.rpy:27842
translate brazil v4night3choice4_d2cf50c3:

#   z "Oh, shit! (The hostess must've seen her!)"
    z "Ah Merda! (A anfitriã deve tê-la visto!)"

# game/script.rpy:27846
translate brazil v4night3choice4_15d43c95:

#   fry "Well, now you can't leave either, I'm afraid. You broke the rule of going into my house."
    fry "Bem, agora você também não pode sair, infelizmente. Você quebrou a regra de entrar na minha casa."

# game/script.rpy:27852
translate brazil v4night3choice4_4710287f:

#   z "I had no intentions on leaving without her."
    z "Eu não tinha intenção de sair sem ela."

# game/script.rpy:27856
translate brazil v4night3choice4_70a14e6e:

#   fry "By Athena, are you brave! Well, it matters not once your head leaves your neck."
    fry "Por Athena, você é corajoso! Bem, isso não importa quando sua cabeça sai do pescoço."

# game/script.rpy:27860
translate brazil v4night3choice4_1eba7ee5:

#   z "... (Can I take on a fury?)"
    z "... (Posso ficar furioso?)"

# game/script.rpy:27862
translate brazil v4night3choice4_f70a827b:

#   z "Let's see what you've got, fury!"
    z "Vamos ver o que você tem, fúria!"

# game/script.rpy:27868
translate brazil v4night3choice4_b3d85bcc:

#   "*Door kicked in."
    "*Porta arrombada."

# game/script.rpy:27870
translate brazil v4night3choice4_eb7f2d97:

#   fry "Huh?!"
    fry "Huh?!"

# game/script.rpy:27882
translate brazil v4night3choice4_054ae130:

#   a "Sorry I'm late, [mc_name]. Struggled to find the place for a few minutes."
    a "Desculpe pelo atraso, [mc_name]. Lutei para encontrar o lugar por alguns minutos."

# game/script.rpy:27886
translate brazil v4night3choice4_7c6f4dad:

#   a "Let the girl go, fury."
    a "Solte a garota, fúria."

# game/script.rpy:27890
translate brazil v4night3choice4_57a6157b:

#   fry "Hah! And who might you be? A human who presumes to command a fury."
    fry "Hah! E quem você pode ser? Um humano que presume comandar uma fúria."

# game/script.rpy:27894
translate brazil v4night3choice4_7e8088b0:

#   a "I am Keres Anabelle of Kalytro, the city of the sun."
    a "Sou Keres Anabelle de Kalytro, a cidade do sol."

# game/script.rpy:27898
translate brazil v4night3choice4_7a775374:

#   fry "A Keres? I must admit I haven't had a challenging fight in a while. You just might be able to provide that."
    fry "Um Keres? Devo admitir que não tenho uma luta desafiadora há algum tempo. Você talvez seja capaz de fornecer isso."

# game/script.rpy:27900
translate brazil v4night3choice4_25ca800b:

#   fry "You and I shall fight after I kill these two weaklings."
    fry "Você e eu lutaremos depois que eu matar esses dois fracos."

# game/script.rpy:27904
translate brazil v4night3choice4_40f83f8f:

#   a "You shan't lay a hand on either of them. By Helios, I shall strike you down here and now."
    a "Você não colocará a mão em nenhum deles. Por Helios, vou acabar com você aqui e agora."

# game/script.rpy:27908
translate brazil v4night3choice4_297d2a80:

#   fry "Heh! Big talk for a mere huma-"
    fry "Ei! Grande conversa para um mero humano"

# game/script.rpy:27912
translate brazil v4night3choice4_c956a386:

#   fry "!"
    fry "!"

# game/script.rpy:27926
translate brazil v4night3choice4_093207cc:

#   z "(Holy fuck! It's Athena!)" with vpunch
    z "(Puta merda! É Atenas!)" with vpunch

# game/script.rpy:27930
translate brazil v4night3choice4_27e7eb69:

#   athna "Rise. I take the form of a mere mortal. You needn't bow."
    athna "Ascender. Assumo a forma de um mero mortal. Você não precisa se curvar."

# game/script.rpy:27934
translate brazil v4night3choice4_759aae45:

#   athna "I did not expect you to cause this much discord here, mortal."
    athna "Eu não esperava que você causasse tanta discórdia aqui, mortal."

# game/script.rpy:27938
translate brazil v4night3choice4_95f3d12b:

#   athna "And I expected to see a Keres challenging the will of the gods even less."
    athna "E eu esperava ver um Keres desafiando ainda menos a vontade dos deuses."

# game/script.rpy:27942
translate brazil v4night3choice4_abc63393:

#   a "W-What?! Athena?!"
    a "O-O que?! Atena?!"

# game/script.rpy:27946
translate brazil v4night3choice4_2b99a5f4:

#   athna "Yes, I know, I know... I did not wish to come down here, believe me."
    athna "Sim, eu sei, eu sei... não queria vir aqui, acredite."

# game/script.rpy:27950
translate brazil v4night3choice4_9f5648c9:

#   athna "But this business needs be finished here, before it grows into an even larger problem."
    athna "Mas este negócio precisa ser encerrado aqui, antes que se torne um problema ainda maior."

# game/script.rpy:27952
translate brazil v4night3choice4_e23cb665:

#   athna "I'll tell you what, incubus. Out of respect for your blood, I'll let you take the elf and leave."
    athna "Vou te dizer uma coisa, íncubo. Por respeito ao seu sangue, deixarei você pegar o elfo e ir embora."

# game/script.rpy:27954
translate brazil v4night3choice4_d85b00f1:

#   athna "I do not wish to spell ichor here. Be it running through the veins of a demon like you or not."
    athna "Não quero soletrar icor aqui. Esteja correndo nas veias de um demônio como você ou não."

# game/script.rpy:27958
translate brazil v4night3choice4_346babcf:

#   z "You'll just let us leave?"
    z "Você vai nos deixar sair?"

# game/script.rpy:27962
translate brazil v4night3choice4_5d42d9b4:

#   athna "Ugh... Father help me. Yes. Did I not make myself clear?"
    athna "Ugh... Pai, me ajude. Sim. Não fui claro?"

# game/script.rpy:27968
translate brazil v4night3choice4_9ddf25ac:

#   z "What about the curse?"
    z "E a maldição?"

# game/script.rpy:27972
translate brazil v4night3choice4_1a8ba970:

#   athna "By Tartarus! Don't start with that again! The curse remains, of course."
    athna "Pelo Tártaro! Não comece com isso de novo! A maldição permanece, é claro."

# game/script.rpy:27974
translate brazil v4night3choice4_97298a13:

#   athna "It was but my fair punishment for what the town that worshipped me had done."
    athna "Foi apenas o meu justo castigo pelo que a cidade que me adorava tinha feito."

# game/script.rpy:27976
translate brazil v4night3choice4_8114f7a3:

#   athna "If the town's folk do not value the lives of their own kind, why should I?"
    athna "Se o povo da cidade não valoriza a vida de sua própria espécie, por que eu deveria?"

# game/script.rpy:27980
translate brazil v4night3choice4_830ddb76:

#   athna "The fury to my left was a human girl once, incubus. She wondered into this town cold and hungry."
    athna "A fúria à minha esquerda já foi uma garota humana, íncubo. Ela entrou nesta cidade com frio e fome."

# game/script.rpy:27982
translate brazil v4night3choice4_c7dfbe96:

#   athna "Every single one of the mortals here could have taken her in their home and shown her a glimpse of grace."
    athna "Cada um dos mortais aqui poderia tê-la levado para sua casa e lhe mostrado um vislumbre de graça."

# game/script.rpy:27984
translate brazil v4night3choice4_b2471a8b:

#   athna "The grace which I once bestowed upon this town. Yet they did not. They let the girl die of cold and hunger."
    athna "A graça que uma vez concedi a esta cidade. No entanto, eles não o fizeram. Deixaram a menina morrer de frio e fome."

# game/script.rpy:27986
translate brazil v4night3choice4_c2b9d5a8:

#   athna "It was only I that let the girl have another chance at life. And thus, she owed her life to me. To serve me."
    athna "Só eu deixei a garota ter outra chance na vida. E assim, ela devia sua vida a mim. Para me servir."

# game/script.rpy:27993
translate brazil v4night3choice4_6fb531ba:

#   athna "But you already know this story, do you not? You've seen it in your dreams."
    athna "Mas você já conhece essa história, não é? Você já viu isso em seus sonhos."

# game/script.rpy:27997
translate brazil v4night3choice4_bbe4e4fd:

#   z "H-Huh? (How did she-)"
    z "H-Huh? (Como ela-)"

# game/script.rpy:28001
translate brazil v4night3choice4_0381add8:

#   athna "Heh! Did you think I would not know about the sleep nymph influencing your dreams? You could not have known where to find your elf friend if it weren't for her."
    athna "Ei! Você achou que eu não saberia que a ninfa do sono influencia seus sonhos? Você não saberia onde encontrar sua amiga elfa se não fosse por ela."

# game/script.rpy:28003
translate brazil v4night3choice4_bf5301c1:

#   athna "You could not have passed the trial if it weren't for her."
    athna "Você não poderia ter passado no julgamento se não fosse por ela."

# game/script.rpy:28007
translate brazil v4night3choice4_4e53e75c:

#   z "Her?! But I don't know any sleep nymphs! I don't know who has been influencing my dreams!"
    z "Dela?! Mas não conheço nenhuma ninfa do sono! Não sei quem tem influenciado meus sonhos!"

# game/script.rpy:28011
translate brazil v4night3choice4_92035173:

#   athna "Sure you do. Who was the one that told you of the monster living in this house to begin with?"
    athna "Claro que sim. Para começar, quem foi quem lhe contou sobre o monstro que mora nesta casa?"

# game/script.rpy:28021
translate brazil v4night3choice4_21c560e9:

#   istla "I once went into the forbidden house and saw the monster that was in there. The temple maidens never allowed me near the place again."
    istla "Certa vez entrei na casa proibida e vi o monstro que estava lá. As donzelas do templo nunca mais me permitiram chegar perto do local."

# game/script.rpy:28029
translate brazil v4night3choice4_081d6687:

#   z "Fuck! It was her!" with vpunch
    z "Porra! Foi ela!" with vpunch

# game/script.rpy:28031
translate brazil v4night3choice4_b0f55f2e:

#   z "She was guiding me all along?!"
    z "Ela estava me guiando o tempo todo?!"

# game/script.rpy:28035
translate brazil v4night3choice4_ad998cac:

#   athna "Indeed, she was. I presume she saw a group of capable individuals and thought you could perhaps kill my fury and put an end to the curse. Once and for all."
    athna "Na verdade, ela estava. Presumo que ela viu um grupo de indivíduos capazes e pensou que talvez você pudesse matar minha fúria e acabar com a maldição. De uma vez por todas."

# game/script.rpy:28045
translate brazil v4night3choice4_ecfe5ed2:

#   athna "She's not the first. Others have tried before, you know."
    athna "Ela não é a primeira. Outros já tentaram antes, você sabe."

# game/script.rpy:28047
translate brazil v4night3choice4_0aede6a3:

#   athna "Some are trying to this very day."
    athna "Alguns estão tentando até hoje."

# game/script.rpy:28053
translate brazil v4night3choice4_06975dac:

#   z "The hostess."
    z "A anfitriã."

# game/script.rpy:28057
translate brazil v4night3choice4_b0bf9b81:

#   athna "Indeed. She believes if she welcomed every guest with grace, the curse will be lifted."
    athna "De fato. Ela acredita que se recebesse todos os convidados com graça, a maldição seria suspensa."

# game/script.rpy:28063
translate brazil v4night3choice4_d7e067f0:

#   z "Will it?"
    z "Será?"

# game/script.rpy:28067
translate brazil v4night3choice4_a2ef98f8:

#   athna "Heh. I must admit I have yet to meet a mortal as daring as you are. Asking a goddess what she'll do and not do."
    athna "Ei. Devo admitir que ainda não conheci um mortal tão ousado quanto você. Perguntar a uma deusa o que ela fará e o que não fará."

# game/script.rpy:28075
translate brazil v4night3choice4_3f1c894a:

#   athna "Your courage will one day be the end of you, mortal."
    athna "Sua coragem um dia será o seu fim, mortal."

# game/script.rpy:28083
translate brazil v4night3choice4_6ce993e4:

#   athna "Now. Make your decision. Will you leave and take the elf? Or will you disobey me and perish, mortal?"
    athna "Agora. Tome sua decisão. Você vai sair e levar o elfo? Ou você vai me desobedecer e morrer, mortal?"

# game/script.rpy:28091
translate brazil v4night3choice4_f7030fe1:

#   z "(What should I do?)"
    z "(O que devo fazer?)"

# game/script.rpy:28095
translate brazil v4night3choice4_7705d315:

#   z "(What does Anabelle thin-)"
    z "(O que Anabelle pensa-)"

# game/script.rpy:28099
translate brazil v4night3choice4_b9ffafea:

#   z "!"
    z "!"

# game/script.rpy:28103
translate brazil v4night3choice4_21ed760f:

#   a "Make the choice, [mc_name]."
    a "Faça a escolha, [mc_name]."

# game/script.rpy:28107
translate brazil v4night3choice4_e1cdb611:

#   z "What?! Are you sure?"
    z "O que?! Tem certeza?"

# game/script.rpy:28111
translate brazil v4night3choice4_d4b908cc:

#   a "Yes. Whatever you decide, I'll support you."
    a "Sim. O que quer que você decida, eu te apoiarei."

# game/script.rpy:28115
translate brazil v4night3choice4_e1438f9a:

#   z "But do we really have a choice here? Can we even beat them?"
    z "Mas será que realmente temos escolha aqui? Podemos até vencê-los?"

# game/script.rpy:28119
translate brazil v4night3choice4_72d8ac1e:

#   a "Leave Athena to me. She's in her human form, so I might be able to take her. But you will have to take the fury."
    a "Deixe Atena comigo. Ela está em sua forma humana, então talvez eu possa levá-la. Mas você terá que aguentar a fúria."

# game/script.rpy:28123
translate brazil v4night3choice4_3be246bb:

#   z "But are you sure about fighting a goddess? You're a Keres. Shouldn't you be loyal to the gods."
    z "Mas você tem certeza de lutar contra uma deusa? Você é um Keres. Você não deveria ser leal aos deuses."

# game/script.rpy:28127
translate brazil v4night3choice4_fcde6ddc:

#   a "My allegiance is only to my siblings, my friends, and the ninja village. And I don't have a great love for Athena of all the gods."
    a "Minha lealdade é apenas para com meus irmãos, meus amigos e a vila ninja. E eu não tenho um grande amor por Atena de todos os deuses."

# game/script.rpy:28131
translate brazil v4night3choice4_fca8a5a6:

#   athna "What are you two conspiring about?! Hurry up and decide!"
    athna "Sobre o que vocês dois estão conspirando?! Apresse-se e decida!"

# game/script.rpy:28139
translate brazil v4night3choice4_73afcd9a:

#   athna "Wait! Now that I look at you this close... I know you."
    athna "Espere! Agora que olho para você tão de perto... eu conheço você."

# game/script.rpy:28141
translate brazil v4night3choice4_977a970f:

#   athna "You are Anabelle. Sirius's little sister, aren't you?"
    athna "Você é Anabela. Irmã mais nova de Sirius, não é?"

# game/script.rpy:28145
translate brazil v4night3choice4_5e5a2f7a:

#   a "Yes. I am."
    a "Sim. Eu sou."

# game/script.rpy:28149
translate brazil v4night3choice4_ac62f9e4:

#   athna "Don't tell me you plan to fight, girl!"
    athna "Não me diga que você planeja lutar, garota!"

# game/script.rpy:28151
translate brazil v4night3choice4_bbf25a6a:

#   athna "Not even your brother could beat me. How would you?"
    athna "Nem mesmo seu irmão poderia me vencer. Como você faria?"

# game/script.rpy:28159
translate brazil v4night3choice4_f405e4ef:

#   z "What's she talking about?! Is this why you said you don't like Athena?"
    z "Do que ela está falando?! É por isso que você disse que não gosta de Athena?"

# game/script.rpy:28163
translate brazil v4night3choice4_31636ccd:

#   a "My brother and Athena have history, yes. This is why I didn't want to make the decision on whether we should fight or not, [mc_name]."
    a "Meu irmão e Athena têm história, sim. É por isso que eu não queria tomar a decisão de lutar ou não, [mc_name]."

# game/script.rpy:28165
translate brazil v4night3choice4_bc504d4b:

#   a "My decision might've been blinded by emotion. Which is why I left the choice to you."
    a "Minha decisão pode ter sido cegada pela emoção. É por isso que deixei a escolha para você."

# game/script.rpy:28173
translate brazil v4night3choice4_dba255ec:

#   z "I..."
    z "EU..."

# game/script.rpy:28181
translate brazil v4night3choice4_db05bf4c:

#   z "Understood."
    z "Entendido."

# game/script.rpy:28185
translate brazil v4night3choice4_8d027533:

#   z "(It's time to choose...)"
    z "(É hora de escolher...)"

# game/script.rpy:28193
translate brazil v4night3choice4_cb817477:

