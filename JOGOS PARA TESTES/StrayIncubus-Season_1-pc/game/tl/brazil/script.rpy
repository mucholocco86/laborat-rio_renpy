translate brazil after_nixie_scene_6ae57fc8:

#   z "(I'd better go see what Gabbie wants.)"
    z "(É melhor eu ver o que Gabbie quer.)"

# game/script.rpy:19650
translate brazil after_nixie_scene_75231388:

#   z "(I see she has made herself at home...)"
    z "(Vejo que ela se sentiu em casa...)"

