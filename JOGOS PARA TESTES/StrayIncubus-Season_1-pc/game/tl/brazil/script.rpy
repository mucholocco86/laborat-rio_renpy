translate brazil after_nixie_scene_6bb5e587:

#   tmra "She's in the lab, the door to your right."
    tmra "Ela está no laboratório, na porta à sua direita."

# game/script.rpy:19594
translate brazil after_nixie_scene_2e892f53:

#   tmra "I'll be right outside. Shout if you feel like you're dying or something. I probably won't be able to help, though."
    tmra "Estarei lá fora. Grite se sentir que está morrendo ou algo assim. Provavelmente não poderei ajudar, no entanto."

# game/script.rpy:19610
translate brazil after_nixie_scene_0acfa346:

#   z "(Just as friendly as ever, I see...)"
    z "(Tão amigável como sempre, pelo que vejo...)"

