translate brazil after_menu_0204e848:

#   jnfr "My betrothed, Jamie Alistor. He's from a really rich family, so he may come across as a bit rude sometimes..."
    jnfr "Minha noiva, Jamie Alistor. Ele vem de uma família muito rica, então às vezes pode parecer um pouco rude..."

# game/script.rpy:4609
translate brazil after_menu_9f2cc047:

#   z "A bit?"
    z "Um pouco?"

# game/script.rpy:4613
translate brazil after_menu_aba1d610:

#   Character("Clearly Jamie") "HURRY UP, JENNY!"
    Character("Clearly Jamie") "Apresse-se, JENNY!"

# game/script.rpy:4617
translate brazil after_menu_11a62a1d:

#   jnfr "I know, I know. Listen I gotta go, [mc_name]. It was really nice to see you again. Let's catch up again okay."
    jnfr "Eu sei, eu sei. Ouça, preciso ir, [mc_name]. Foi muito bom ver você novamente. Vamos conversar novamente, ok."

# game/script.rpy:4619
translate brazil after_menu_bb24d3a4:

#   z "Sure. See you."
    z "Claro. Vê você."

# game/script.rpy:4629
