translate brazil after_nixie_scene_dcf297d1:

#   z "So, how are Torr and Candy?"
    z "Então, como estão Torr e Candy?"

# game/script.rpy:19687
translate brazil after_nixie_scene_19b51e7f:

#   gbrla "They're fine. They were a bit shaken when they dragged you here. But apparently, you were the only one with any injuries."
    gbrla "Eles estão bem. Eles ficaram um pouco abalados quando arrastaram você até aqui. Mas, aparentemente, você foi o único ferido."

# game/script.rpy:19691
translate brazil after_nixie_scene_2beb7a34:

#   z "I see..."
    z "Eu vejo..."

# game/script.rpy:19700
translate brazil after_nixie_scene_18af1927:

#   z "Speaking of Venus. Is she doing alright?"
    z "Falando em Vênus. Ela está bem?"

# game/script.rpy:19704
translate brazil after_nixie_scene_9a04a308:

#   gbrla "Yeah. Nothing to worry about. She just needs rest."
    gbrla "Sim. Nada com que se preocupar. Ela só precisa descansar."

# game/script.rpy:19708
translate brazil after_nixie_scene_0904d205:

#   z "Is she still here? Can I maybe see her?"
    z "Ela ainda está aqui? Posso talvez vê-la?"

