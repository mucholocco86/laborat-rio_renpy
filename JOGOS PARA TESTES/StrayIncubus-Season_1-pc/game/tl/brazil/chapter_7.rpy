#   misty "Yeah. They don't actually work. I can't see anything with them."
    misty "Sim. Na verdade, eles não funcionam. Não consigo ver nada com eles."

# game/chapter_7.rpy:1222
translate brazil ask_misty_ch7_e1824573:

#   misty "I hear it's very common for hybrid creatures to have parts that don't function properly."
    misty "Ouvi dizer que é muito comum criaturas híbridas terem partes que não funcionam corretamente."

# game/chapter_7.rpy:1224
