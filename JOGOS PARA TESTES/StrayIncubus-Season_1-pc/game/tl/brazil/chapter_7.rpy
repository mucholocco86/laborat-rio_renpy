#   z "Your four bottom eyes. I noticed they don't blink..."
    z "Seus quatro olhos inferiores. Notei que eles não piscam..."

# game/chapter_7.rpy:1219
translate brazil ask_misty_ch7_92bcfe11:

#   misty "Oh, those?"
    misty "Ah, aqueles?"

# game/chapter_7.rpy:1221
