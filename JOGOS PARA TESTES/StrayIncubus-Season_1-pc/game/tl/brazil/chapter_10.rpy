# game/chapter_10.rpy:233
translate brazil chapter_10_bb8e4b4e:

#   a "..."
    a "..."

# game/chapter_10.rpy:235
translate brazil chapter_10_fe9a12cf:

#   z "Hey... It's fine if you don't want to talk abo-"
    z "Ei... Tudo bem se você não quiser falar sobre-"

# game/chapter_10.rpy:237
translate brazil chapter_10_9a58adc6:

#   a "No."
    a "Não."

# game/chapter_10.rpy:240
translate brazil chapter_10_1ff1b038:

#   a "I've already decided I was going to tell you..."
    a "Já decidi que ia te contar..."

# game/chapter_10.rpy:241
translate brazil chapter_10_72c7559c:

#   a "I actually have been meaning to talk to you for..."
    a "Na verdade, eu queria falar com você há..."

# game/chapter_10.rpy:245
translate brazil chapter_10_06aaa113:

#   a "...a while now..."
    a "...já faz um tempo..."

# game/chapter_10.rpy:247
translate brazil chapter_10_d22d3dcf:

#   a "Remember when I asked you to come by after class?"
    a "Lembra quando eu pedi para você vir depois da aula?"

# game/chapter_10.rpy:248
translate brazil chapter_10_ba06aac8:

#   a "I was going to tell you something then..."
    a "Eu ia te contar uma coisa então..."

# game/chapter_10.rpy:249
translate brazil chapter_10_c06fa9c9:

#   a "But well, now..."
    a "Mas bem, agora..."

# game/chapter_10.rpy:252
translate brazil chapter_10_a817ecf2:

#   a "It's fine. It's about time you knew anyway..."
    a "Está tudo bem. Já era hora de você saber de qualquer maneira..."

# game/chapter_10.rpy:253
translate brazil chapter_10_0ea750cb:

#   a "You want to know about Sol..."
    a "Você quer saber sobre Sol..."

# game/chapter_10.rpy:255
translate brazil chapter_10_f9babced:

#   a "Remember when we talked about how Venus was vouched for by my brother when she wanted to join?"
    a "Lembra quando conversamos sobre como Vênus foi atestada por meu irmão quando ela quis se juntar?"

# game/chapter_10.rpy:257
translate brazil chapter_10_3db7ae89:

#   a "Well, Sol vouched for her too. She was the one who brought her, after all."
    a "Bem, Sol também atestou por ela. Afinal, foi ela quem a trouxe."

# game/chapter_10.rpy:259
translate brazil chapter_10_5f724f45:

#   a "But Sirius, being a black belt, was the one who convinced Helena to let her join."
    a "Mas Sirius, por ser faixa preta, foi quem convenceu Helena a deixá-la entrar."

# game/chapter_10.rpy:261
translate brazil chapter_10_112c3231:

#   z "Oh."
    z "Oh."

# game/chapter_10.rpy:265
translate brazil chapter_10_5974102d:

#   a "They were inseparable, Sol and Sirius."
    a "Eles eram inseparáveis, Sol e Sirius."

# game/chapter_10.rpy:267
translate brazil chapter_10_af22479e:

#   a "Sol had apparently been a temple maiden at Helios's temple in Kalytro before she became a ninja."
    a "Sol aparentemente era uma donzela do templo de Helios em Kalytro antes de se tornar uma ninja."

# game/chapter_10.rpy:268
translate brazil chapter_10_c7e2c2b8:

#   a "She was crazy about Sirius... Her family should've been sworn to serve Athena's temple there, but she decided to devote herself to Helios's instead."
    a "Ela era louca por Sirius... Sua família deveria ter jurado servir o templo de Atena lá, mas ela decidiu se dedicar ao de Hélio."

# game/chapter_10.rpy:269
translate brazil chapter_10_30116970:

#   a "Weirdly enough, she never even spoke to Sirius there... She was too shy to approach Helios's demi-god son leading the temple. She was just a humble temple maiden there, after all."
    a "Estranhamente, ela nunca falou com Sirius lá... Ela era muito tímida para se aproximar do filho semideus de Helios que liderava o templo. Afinal, ela era apenas uma humilde donzela do templo."

# game/chapter_10.rpy:271
translate brazil chapter_10_1d4d97cd:

#   a "She used to tell me all kinds of stuff like this after she came here... She and I were good friends."
    a "Ela costumava me contar todo tipo de coisa assim depois que veio para cá... Ela e eu éramos bons amigos."

# game/chapter_10.rpy:272
translate brazil chapter_10_031de2f3:

#   a "She was a year older than me, but she never acted like it really..."
    a "Ela era um ano mais velha que eu, mas nunca agiu assim..."

# game/chapter_10.rpy:274
translate brazil chapter_10_ec4fb474:

#   z "..."
    z "..."

# game/chapter_10.rpy:275
translate brazil chapter_10_1a128585:

#   z "What do you mean WERE good friends?"
    z "O que você quer dizer com ERAM bons amigos?"

# game/chapter_10.rpy:276
translate brazil chapter_10_59b9f754:

#   z "Did something happen?"
    z "Aconteceu alguma coisa?"

# game/chapter_10.rpy:279
translate brazil chapter_10_f79c3506:

#   a "Well, yes..."
    a "Bem, sim..."

# game/chapter_10.rpy:281
translate brazil chapter_10_578095e1:

#   a "You see, back when Sol was still in Kalytro working at Helios's temple, Athena had learnt about Sol picking another god's temple over hers..."
    a "Veja bem, quando Sol ainda estava em Kalytro trabalhando no templo de Helios, Atena descobriu que Sol escolheu o templo de outro deus em vez do dela..."

# game/chapter_10.rpy:282
translate brazil chapter_10_e08f21c8:

#   a "In families sworn to care for temples, only one family member had to attend to the temple's needs, and Sol's father was still working at Athena's temple. So Athena had no right to object..."
    a "Nas famílias que juraram cuidar dos templos, apenas um membro da família tinha que atender às necessidades do templo, e o pai de Sol ainda trabalhava no templo de Atena. Então Atena não tinha o direito de se opor..."

# game/chapter_10.rpy:284
translate brazil chapter_10_3c012ecb:

#   a "Rather than punish Sol's family by cursing them or something, she demanded that Sol's father should work twice as much as he used to."
    a "Em vez de punir a família de Sol amaldiçoando-os ou algo assim, ela exigiu que o pai de Sol trabalhasse o dobro do que costumava trabalhar."

# game/chapter_10.rpy:285
translate brazil chapter_10_128156aa:

#   a "But he was just a feeble old man. Even though he told Sol he'd be fine... He wasn't... He got more and more sickly..."
    a "Mas ele era apenas um velho fraco. Mesmo tendo dito a Sol que ficaria bem... Ele não estava... Ele ficou cada vez mais doente..."

# game/chapter_10.rpy:286
translate brazil chapter_10_40b79c5c:

#   a "And a few weeks after Sirius left the temple to join the ninja village, Sol's father died..."
    a "E algumas semanas depois de Sirius deixar o templo para se juntar à vila ninja, o pai de Sol morreu..."

# game/chapter_10.rpy:288
translate brazil chapter_10_b2116565:

#   a "Sol had lost almost everything she cared about. Her father was dead and Sirius was gone."
    a "Sol havia perdido quase tudo com que ela se importava. O pai dela estava morto e Sirius havia desaparecido."

# game/chapter_10.rpy:289
translate brazil chapter_10_43fbbbce:

#   a "Suddenly the life she was longing for faded away."
    a "De repente, a vida que ela ansiava desapareceu."

# game/chapter_10.rpy:292
translate brazil chapter_10_62c32492:

#   a "In vengeance for her father, she burnt down Athena's temple in the night and fled the city."
    a "Em vingança por seu pai, ela incendiou o templo de Atena durante a noite e fugiu da cidade."

# game/chapter_10.rpy:293
translate brazil chapter_10_2f08bb2c:

#   z "She..."
    z "Ela..."

# game/chapter_10.rpy:295
translate brazil chapter_10_b0a3144f:

#   a "Yeah... She came here to the ninja village to find Sirius."
    a "Sim... Ela veio aqui para a vila ninja para encontrar Sirius."

# game/chapter_10.rpy:297
translate brazil chapter_10_93c79f04:

#   a "And she became a ninja. She was very good at it really. Got promoted really fast."
    a "E ela se tornou uma ninja. Ela era muito boa nisso, na verdade. Fui promovido muito rápido."

# game/chapter_10.rpy:299
translate brazil chapter_10_dabf5d36:

#   a "And most importantly, she got to talk to Sirius... Get to know him for the first time..."
    a "E o mais importante, ela conseguiu conversar com Sirius... Conhece-lo pela primeira vez..."

# game/chapter_10.rpy:300
translate brazil chapter_10_600a7d85:

#   a "They became good friends in no time. She worked extra hard to keep up with him, get promoted as fast as she could, so they'd go on missions together."
    a "Eles se tornaram bons amigos em pouco tempo. Ela trabalhou duro para acompanhá-lo, ser promovida o mais rápido que pudesse, para que eles saíssem em missão juntos."

# game/chapter_10.rpy:301
translate brazil chapter_10_3830d108:

#   a "That meant that those two were always together. After a while the two became a couple."
    a "Isso significava que aqueles dois estavam sempre juntos. Depois de um tempo os dois se tornaram um casal."

# game/chapter_10.rpy:303
translate brazil chapter_10_4241743c:

#   a "But you see; Athena hadn't forgotten what Sol had done."
    a "Mas você vê; Atena não havia esquecido o que Sol havia feito."

# game/chapter_10.rpy:304
translate brazil chapter_10_4050bfeb:

#   a "She was apparently plotting to get Sol for it..."
    a "Ela aparentemente estava planejando pegar Sol por isso..."

# game/chapter_10.rpy:305
translate brazil chapter_10_28211690:

#   a "But because Sol was never away from Sirius, she couldn't..."
    a "Mas como Sol nunca esteve longe de Sirius, ela não podia..."

# game/chapter_10.rpy:308
translate brazil chapter_10_5ddb7caa:

#   z "Athena couldn't get to Sol because of Sirius?"
    z "Atena não conseguiu chegar ao Sol por causa de Sirius?"

# game/chapter_10.rpy:310
translate brazil chapter_10_1e1008bf:

#   a "Yes... Sirius was no ordinary man... I don't think he was even an ordinary demi-god."
    a "Sim... Sirius não era um homem comum... Não acho que ele fosse um semideus comum."

# game/chapter_10.rpy:312
translate brazil chapter_10_a71266d2:

#   a "I've never met anyone so strong..."
    a "Nunca conheci ninguém tão forte..."

# game/chapter_10.rpy:322
translate brazil chapter_10_ae4f5a0b:

#   a "I don't think..."
    a "Eu não acho..."

# game/chapter_10.rpy:324
translate brazil chapter_10_7a5a9e08:

#   z "?"
    z "?"

# game/chapter_10.rpy:327
translate brazil chapter_10_d20ce406:

#   a "Well, anyway..."
    a "Bem, de qualquer maneira..."

# game/chapter_10.rpy:328
translate brazil chapter_10_b7656d81:

#   a "Athena and Poseidon plotted to take the both of them down."
    a "Atena e Poseidon conspiraram para derrubar os dois."

# game/chapter_10.rpy:330
translate brazil chapter_10_25bd1272:

#   z "Poseidon?"
    z "Poseidon?"

# game/chapter_10.rpy:332
translate brazil chapter_10_15d45d6c:

#   a "They say Athena and he were having a thing at the time..."
    a "Dizem que Athena e ele estavam tendo um caso naquela época..."

# game/chapter_10.rpy:336
translate brazil chapter_10_ddcc10d6:

#   a "I hear Athena tried to convince her father, Zeus, to work with them, but he wouldn't."
    a "Ouvi dizer que Atena tentou convencer seu pai, Zeus, a trabalhar com eles, mas ele não o fez."

# game/chapter_10.rpy:337
translate brazil chapter_10_a2102feb:

#   a "The other Olympians refused to get involved. Even more so after the massacre caused by Athena having a bad break-up with Elnor."
    a "Os outros atletas olímpicos recusaram-se a se envolver. Ainda mais depois do massacre causado pelo rompimento feio de Atena com Elnor."

# game/chapter_10.rpy:338
translate brazil chapter_10_887c1dc0:

#   a "But she did manage to get some help from Artemis."
    a "Mas ela conseguiu ajuda de Artemis."

# game/chapter_10.rpy:342
translate brazil chapter_10_2a4cfb9a:

#   a "It's only a rumour but they say Athena managed to convince Artemis that a solar eclipse should happen on one day. Or what people call 'day of the black sun'."
    a "É apenas um boato, mas dizem que Atena conseguiu convencer Artemis de que um eclipse solar deveria acontecer um dia. Ou o que as pessoas chamam de “dia do sol negro”."

# game/chapter_10.rpy:343
translate brazil chapter_10_ce9cf3c1:

#   z "A what?"
    z "Um o quê?"

# game/chapter_10.rpy:345
translate brazil chapter_10_265c9971:

#   a "It's when the moon covers the sunlight for a short period during the day. The sun is blocked and looks black."
    a "É quando a lua cobre a luz do sol por um curto período durante o dia. O sol está bloqueado e parece preto."

# game/chapter_10.rpy:346
translate brazil chapter_10_29720488:

#   a "And it'd look as if nightfall suddenly came for several minutes before the moon moves and sunlight emerges again."
    a "E pareceria que o anoitecer de repente chegaria por vários minutos antes que a lua se movesse e a luz do sol surgisse novamente."

# game/chapter_10.rpy:348
translate brazil chapter_10_c182d229:

#   z "Whao..."
    z "Uau..."

# game/chapter_10.rpy:350
translate brazil chapter_10_303ca036:

#   a "Yeah. I'm not surprised you don't remember it. You were probably too young when that one happened."
    a "Sim. Não estou surpreso que você não se lembre disso. Você provavelmente era muito jovem quando isso aconteceu."

# game/chapter_10.rpy:351
translate brazil chapter_10_798861af:

#   a "And not a single one has happened since. Artemis gave up her godhood of the moon and left Olympus after the incident."
    a "E nem um único aconteceu desde então. Artemis desistiu de sua divindade da lua e deixou o Olimpo após o incidente."

# game/chapter_10.rpy:352
translate brazil chapter_10_8ca0d728:

#   a "Or so they say..."
    a "Ou é o que dizem..."

# game/chapter_10.rpy:354
translate brazil chapter_10_5695e563:

#   a "They say the moon hasn't moved after."
    a "Dizem que a lua não se moveu depois."

# game/chapter_10.rpy:357
translate brazil chapter_10_f925a7a2:

#   z "What incident?"
    z "Que incidente?"

# game/chapter_10.rpy:359
translate brazil chapter_10_13f8d7ba:

#   a "On the day of the black sun... Sirius and Sol were on a mission away from the village."
    a "No dia do sol negro... Sirius e Sol estavam em missão longe da vila."

# game/chapter_10.rpy:360
translate brazil chapter_10_3046ed96:

#   a "As soon as Athena convinced her sister to block the sun for an hour, she and Poseidon rushed to Sirius and Sol."
    a "Assim que Atena convenceu sua irmã a bloquear o sol por uma hora, ela e Poseidon correram para Sirius e Sol."

# game/chapter_10.rpy:364
translate brazil chapter_10_0175209f:

#   a "The cowards attacked him when there was no sunlight! He would've been even far weaker than at night! I could feel it! I felt horrible when the sun went black that day."
    a "Os covardes o atacaram quando não havia luz solar! Ele estaria ainda mais fraco do que à noite! Eu pude sentir isso! Eu me senti horrível quando o sol escureceu naquele dia."

# game/chapter_10.rpy:366
translate brazil chapter_10_a46cc0df:

#   z "What happened to him?"
    z "O que aconteceu com ele?"

# game/chapter_10.rpy:368
translate brazil chapter_10_5dad9d23:

#   a "He..."
    a "Ele..."

# game/chapter_10.rpy:369
translate brazil chapter_10_e7f0714c:

#   a "Athena..."
    a "Atena..."

# game/chapter_10.rpy:373
translate brazil chapter_10_44e6b779:

#   a "I..."
    a "EU..."

# game/chapter_10.rpy:374
translate brazil chapter_10_a09906eb:

#   a "I never saw him again after that day..."
    a "Nunca mais o vi depois daquele dia..."

# game/chapter_10.rpy:375
translate brazil chapter_10_a53015f8:

#   a "He never went back to the ninja village..."
    a "Ele nunca mais voltou para a vila ninja..."

# game/chapter_10.rpy:377
translate brazil chapter_10_4b970564:

#   a "I honestly thought he was dead..."
    a "Sinceramente pensei que ele estava morto..."

# game/chapter_10.rpy:379
translate brazil chapter_10_681e3b5f:

#   a "But about a year later, a letter came..."
    a "Mas cerca de um ano depois, chegou uma carta..."

# game/chapter_10.rpy:381
translate brazil chapter_10_77019b2a:

#   a "It was from Sirius."
    a "Era de Sirius."

# game/chapter_10.rpy:383
translate brazil chapter_10_5b26adb5:

#   a "He said he was sorry for not coming back... And that he didn't want Yumi and me to see him the way he was after the fight..."
    a "Ele disse que sentia muito por não ter voltado... E que não queria que Yumi e eu o víssemos do jeito que ele estava depois da luta..."

# game/chapter_10.rpy:384
translate brazil chapter_10_00ecbfc4:

#   a "He said Athena demanded that he swears fealty to her brother Apollo as the true god of the sun that day. And that Sol is to be sold as a slave for what she did."
    a "Ele disse que Atena exigiu que ele jurasse fidelidade ao irmão dela, Apolo, como o verdadeiro deus do sol naquele dia. E que Sol será vendida como escrava pelo que fez."

# game/chapter_10.rpy:386
translate brazil chapter_10_302390c0:

#   a "They had no choice but to fight the two gods..."
    a "Eles não tiveram escolha a não ser lutar contra os dois deuses..."

# game/chapter_10.rpy:388
translate brazil chapter_10_95af5c8e:

#   a "He said that..."
    a "Ele disse isso..."

# game/chapter_10.rpy:390
translate brazil chapter_10_c98264fb:

#   a "That..."
    a "Que..."

# game/chapter_10.rpy:392
translate brazil chapter_10_7a654315:

#   a "Athena killed Sol that day..."
    a "Atena matou Sol naquele dia..."

# game/chapter_10.rpy:394
translate brazil chapter_10_f2568de2:

#   a "And that he failed to protect her..."
    a "E que ele falhou em protegê-la..."

# game/chapter_10.rpy:395
translate brazil chapter_10_344f22df:

#   a "He told me that he was proud of me for becoming a Keres... And that he's sure Yumi would make it to black belt some day..."
    a "Ele me disse que estava orgulhoso de mim por ter me tornado um Keres... E que tinha certeza que Yumi chegaria à faixa preta algum dia..."

# game/chapter_10.rpy:396
translate brazil chapter_10_462f293e:

#   a "And that he had no worth... And that he didn't deserve us..."
    a "E que ele não tinha valor... E que ele não nos merecia..."

# game/chapter_10.rpy:400
translate brazil chapter_10_dcc7dcac:

#   a "My brother is not worthless! He is not!"
    a "Meu irmão não vale nada! Ele não é!"

# game/chapter_10.rpy:409
translate brazil chapter_10_19ea075f:

#   z "Hey..."
    z "Ei..."

# game/chapter_10.rpy:412
translate brazil chapter_10_f9a9e51c:

#   z "(Please don't cry, Anabelle...)"
    z "(Por favor, não chore, Anabelle...)"

# game/chapter_10.rpy:414
translate brazil chapter_10_cbf40827:

#   z "(I wish there was more I could do here... But...)" (multiple=2)
    z "(Eu gostaria que houvesse mais que eu pudesse fazer aqui... Mas...)" (multiple=2)

# game/chapter_10.rpy:415
translate brazil chapter_10_d1ed27a3:

#   a "*Sobbing." (multiple=2)
    a "*Soluçando." (multiple=2)

# game/chapter_10.rpy:417
translate brazil chapter_10_08cc4982:

#   a "Sorry..."
    a "Desculpe..."

# game/chapter_10.rpy:427
translate brazil chapter_10_8490c65d:

#   a "I'm Sorry..."
    a "Desculpe..."

# game/chapter_10.rpy:429
translate brazil chapter_10_36023d6a:

#   a "He didn't send us any letters for over a year after that one..."
    a "Ele não nos enviou nenhuma carta por mais de um ano depois daquela..."

# game/chapter_10.rpy:430
translate brazil chapter_10_840c5391:

#   a "But then he started doing it again."
    a "Mas então ele começou a fazer isso de novo."

# game/chapter_10.rpy:431
translate brazil chapter_10_63fdd0a2:

#   a "Just asking how we were doing and the like..."
    a "Só perguntando como estávamos e coisas do tipo..."

# game/chapter_10.rpy:432
translate brazil chapter_10_a41b7305:

#   a "He'd usually send one every month or so..."
    a "Ele normalmente enviava um por mês ou mais..."

# game/chapter_10.rpy:436
translate brazil chapter_10_046884db:

#   a "But..."
    a "Mas..."

# game/chapter_10.rpy:437
translate brazil chapter_10_beee8a98:

#   a "It's been over six months since he last sent us anything..."
    a "Já se passaram mais de seis meses desde a última vez que ele nos enviou alguma coisa..."

# game/chapter_10.rpy:441
translate brazil chapter_10_7f7774d6:

#   a "I'm worried about him, [mc_name]..."
    a "Estou preocupado com ele, [mc_name]..."

# game/chapter_10.rpy:442
translate brazil chapter_10_10c6aa76:

#   a "And I was about to lose Yumi too a few weeks ago..."
    a "E eu também estava prestes a perder Yumi há algumas semanas..."

# game/chapter_10.rpy:446
translate brazil chapter_10_736195bf:

#   a "Aaaaahh... I don't know what to do! I never do..."
    a "Aaaaahh... não sei o que fazer! Eu nunca faço..."

# game/chapter_10.rpy:451
translate brazil chapter_10_0118289d:

#   a "I'm sorry... It's already late, isn't it?"
    a "Me desculpe... Já é tarde, não é?"

# game/chapter_10.rpy:452
translate brazil chapter_10_c2a4cd37:

#   a "I've kept you up..."
    a "Eu mantive você acordado..."

# game/chapter_10.rpy:454
translate brazil chapter_10_9f6f0856:

#   z "What? No you didn't! It's fine..."
    z "O que? Não, você não fez! Está tudo bem..."

# game/chapter_10.rpy:462
translate brazil chapter_10_4a6634ac:

#   a "Thanks for listening to me..."
    a "Obrigado por me ouvir..."

# game/chapter_10.rpy:463
translate brazil chapter_10_630e3a19:

#   a "I think I feel better now..."
    a "Acho que me sinto melhor agora..."

# game/chapter_10.rpy:478
translate brazil chapter_10_6904b4b1:

#   z "Here, here... I'm always here for you if you need anything..."
    z "Aqui, aqui... estou sempre aqui para você se precisar de alguma coisa..."

# game/chapter_10.rpy:483
translate brazil chapter_10_fe1a617f:

#   a "Okay, enough. I'm the older one here!"
    a "Ok, chega. Eu sou o mais velho aqui!"

# game/chapter_10.rpy:494
