# game/chapter_8.rpy:1485
translate brazil chapter_8_2aba512c:

#   Character("Male Creature", color="#8c8c8c") "One hundred years of solitude... What did she do to deserve this? She's just a child... It was all my fault. Not hers."
    Character("Male Creature", color="#8c8c8c") "Cem anos de solidão... O que ela fez para merecer isso? Ela é apenas uma criança... Foi tudo culpa minha. Não dela."

# game/chapter_8.rpy:1487
translate brazil chapter_8_7dabcc35:

#   Character("Male Creature", color="#8c8c8c") "Not yours either..."
