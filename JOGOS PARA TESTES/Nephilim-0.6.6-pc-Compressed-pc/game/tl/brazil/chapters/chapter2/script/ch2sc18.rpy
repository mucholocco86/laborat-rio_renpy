# ARQUIVO: game/chapters/chapter2/script/ch2sc18.rpy DIALOGOS: 428


# game/chapters/chapter2/script/ch2sc18.rpy:68
translate brazil ch2sc18_295bbea7_1:

#   mct "..."
    mct "..."

# game/chapters/chapter2/script/ch2sc18.rpy:884
translate brazil ch2sc18_885597a0_1:

#   el "..."
    el "..."

# game/chapters/chapter2/script/ch2sc18.rpy:12
translate brazil ch2sc18_fca3ada1:

#   el "[mc]! There you are!"
    el "[mc]! Aí está você!"

# game/chapters/chapter2/script/ch2sc18.rpy:14
translate brazil ch2sc18_63b7cb8e:

#   mc "Hey, I was just searching for you."
    mc "Ei, eu estava justamente procurando por você."

# game/chapters/chapter2/script/ch2sc18.rpy:18
translate brazil ch2sc18_497f93b6:

#   el "Well I found you first!"
    el "Pois eu te encontrei primeiro!"

# game/chapters/chapter2/script/ch2sc18.rpy:21
translate brazil ch2sc18_d6c17dce:

#   mc "*Chuckles* I suppose you did."
    mc "*Risos* Imagino que sim."

# game/chapters/chapter2/script/ch2sc18.rpy:23
translate brazil ch2sc18_64a993c3:

#   el "So are we ready to leave?"
    el "Então, estamos prontos para partir?"

# game/chapters/chapter2/script/ch2sc18.rpy:27
translate brazil ch2sc18_a2898729:

#   mc "Assuming you didn’t sleep in until now and managed to get our supplies, we should be good to leave."
    mc "Supondo que você não tenha dormido demais até agora e tenha conseguido nossos suprimentos, podemos partir."

# game/chapters/chapter2/script/ch2sc18.rpy:31
translate brazil ch2sc18_d1885394:

#   el "Actually, I didn’t get any sleep after you left."
    el "Na verdade, não consegui dormir nada depois que você foi embora."

# game/chapters/chapter2/script/ch2sc18.rpy:33
translate brazil ch2sc18_161861da:

#   el "So I got up, had breakfast downstairs with Clark, helped him clean up a bit, and went to the market."
    el "Então eu me levantei, tomei café da manhã lá embaixo com Clark, ajudei-o a arrumar um pouco e fui ao mercado."

# game/chapters/chapter2/script/ch2sc18.rpy:37
translate brazil ch2sc18_b6de7bad:

#   mc "Oh? I thought your butt needed all the extra rest it could get."
    mc "Ah, é? Pensei que seu traseiro precisasse de todo o descanso extra possível."

# game/chapters/chapter2/script/ch2sc18.rpy:41
translate brazil ch2sc18_a3e8c1b3:

#   el "It does!"
    el "Sim, faz!"

# game/chapters/chapter2/script/ch2sc18.rpy:43
translate brazil ch2sc18_83945a74:

#   el "I mean... well..."
    el "Quer dizer... bem..."

# game/chapters/chapter2/script/ch2sc18.rpy:47
translate brazil ch2sc18_be1636f4:

#   el "*Whispers* {size=-10}{b}It wasn’t the same without you.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Não era a mesma coisa sem você.{/b}{/size}"

# game/chapters/chapter2/script/ch2sc18.rpy:51
translate brazil ch2sc18_f4a5a586:

#   mc "Hmm? Did you say something?"
    mc "Hum? Você disse alguma coisa?"

# game/chapters/chapter2/script/ch2sc18.rpy:55
translate brazil ch2sc18_74214b55:

#   el "Who me? N-Nothing! Not a peep! Time to go!"
    el "Eu? N-Nada! Nem um pio! Hora de ir!"

# game/chapters/chapter2/script/ch2sc18.rpy:59
translate brazil ch2sc18_461261b1:

#   mc "Sure. Let’s get going."
    mc "Claro. Vamos começar."

# game/chapters/chapter2/script/ch2sc18.rpy:61
translate brazil ch2sc18_295bbea7:

#   mct "..."
    mct "..."

# game/chapters/chapter2/script/ch2sc18.rpy:62
translate brazil ch2sc18_fbc22acf:

#   mct "Farewell, Riverside... I’ll see you again one day."
    mct "Adeus, Riverside... Nos veremos novamente um dia."

# game/chapters/chapter2/script/ch2sc18.rpy:64
translate brazil ch2sc18_a4c4e2e5:

#   mct "Take care everyone."
    mct "Cuidem-se todos."

# game/chapters/chapter2/script/ch2sc18.rpy:66
translate brazil ch2sc18_49159a62:

#   mct "Gibbs... Sabrina... Flynn... Alice... Maya..."
    mct "Gibbs... Sabrina... Flynn... Alice... Maya..."

# game/chapters/chapter2/script/ch2sc18.rpy:70
translate brazil ch2sc18_10d1b892:

#   el "You coming?"
    el "Você vem?"

# game/chapters/chapter2/script/ch2sc18.rpy:72
translate brazil ch2sc18_cbebe243:

#   mc "Yeah, I was just... never mind."
    mc "É, eu só estava... deixa pra lá."

# game/chapters/chapter2/script/ch2sc18.rpy:74
translate brazil ch2sc18_91c0a382:

#   el "So, how did it go with your friend?"
    el "E aí, como foi com seu amigo?"

# game/chapters/chapter2/script/ch2sc18.rpy:76
translate brazil ch2sc18_fe07196e:

#   mc "Oh, it was... it was good to see him again."
    mc "Ah, foi... foi bom vê-lo novamente."

# game/chapters/chapter2/script/ch2sc18.rpy:80
translate brazil ch2sc18_b2c35ec8:

#   el "Who is he?"
    el "Quem é ele?"

# game/chapters/chapter2/script/ch2sc18.rpy:88
translate brazil ch2sc18_1feaa80d:

#   mc "Gibson. He was friends with Mama and Papa for decades, even before I was born."
    mc "Gibson. Ele era amigo da mamãe e do papai há décadas, mesmo antes de eu nascer."

# game/chapters/chapter2/script/ch2sc18.rpy:89
translate brazil ch2sc18_c30c3b09:

#   mc "He grew up with my dad in Luxenford, that's where they learned their crafts."
    mc "Ele cresceu com meu pai em Luxenford, foi lá que eles aprenderam seus ofícios."

# game/chapters/chapter2/script/ch2sc18.rpy:90
translate brazil ch2sc18_6973ff22:

#   mc "Papa as a carpenter and Gibson as a blacksmith, Gibson has always been... hmm..."
    mc "Papai como carpinteiro e Gibson como ferreiro, Gibson sempre foi... hmm..."

# game/chapters/chapter2/script/ch2sc18.rpy:92
translate brazil ch2sc18_43d8b79e:

#   mc "Kind of like an uncle, in a way? He always had good advice for me while I was growing up."
    mc "Era como um tio para mim, de certa forma? Ele sempre me deu bons conselhos enquanto eu crescia."

# game/chapters/chapter2/script/ch2sc18.rpy:96
translate brazil ch2sc18_fdc37b8f:

#   el "Awwh, that’s so sweet! It must have felt amazing seeing him after so long."
    el "Ah, que fofo! Deve ter sido maravilhoso vê-lo depois de tanto tempo."

# game/chapters/chapter2/script/ch2sc18.rpy:105
translate brazil ch2sc18_51b2691b:

#   mc "It was. I’m glad I took the time to see him before we left."
    mc "Sim, foi ótimo. Fico feliz por ter reservado um tempo para vê-lo antes de irmos embora."

# game/chapters/chapter2/script/ch2sc18.rpy:107
translate brazil ch2sc18_a3028b25:

#   mc "We didn’t have time to cover everything, but he told me some interesting things about my parents."
    mc "Não tivemos tempo de abordar tudo, mas ele me contou algumas coisas interessantes sobre meus pais."

# game/chapters/chapter2/script/ch2sc18.rpy:113
translate brazil ch2sc18_701c5526:

#   mc "He had information I needed. Aad I managed to get some of it, that’s all."
    mc "Ele tinha informações que eu precisava. E eu consegui obter algumas delas, só isso."

# game/chapters/chapter2/script/ch2sc18.rpy:115
translate brazil ch2sc18_ee6b3a5c:

#   mc "There’s no point dwelling on the past, it will only slow me down."
    mc "Não adianta ficar remoendo o passado, isso só vai me atrasar."

# game/chapters/chapter2/script/ch2sc18.rpy:120
translate brazil ch2sc18_194416f6:

#   el "Either way, I’m happy you did! I can tell it set your head straight for this journey."
    el "De qualquer forma, fico feliz que você tenha feito isso! Percebo que isso te ajudou a se preparar melhor para essa jornada."

# game/chapters/chapter2/script/ch2sc18.rpy:122
translate brazil ch2sc18_62c7be8d:

#   mc "Yeah... I suppose it did. Also, get this..."
    mc "Sim... Acho que sim. E olha só isso..."

# game/chapters/chapter2/script/ch2sc18.rpy:124
translate brazil ch2sc18_7bff33a6:

#   mc "He told me my mother was a sorceress."
    mc "Ele me disse que minha mãe era uma feiticeira."

# game/chapters/chapter2/script/ch2sc18.rpy:127
translate brazil ch2sc18_3b7b564b:

#   el "Woah! Really?!"
    el "Uau! Sério?!"

# game/chapters/chapter2/script/ch2sc18.rpy:129
translate brazil ch2sc18_73293f95:

#   el "I’ve read about them in my mothers books!"
    el "Eu li sobre eles nos livros da minha mãe!"

# game/chapters/chapter2/script/ch2sc18.rpy:131
translate brazil ch2sc18_82556f59:

#   el "[mc], do you realize how big this is?!"
    el "[mc] Você tem noção da dimensão disso?!"

# game/chapters/chapter2/script/ch2sc18.rpy:133
translate brazil ch2sc18_ff9d852e:

#   el "It’s incredibly rare to be born with magic in your blood!"
    el "É extremamente raro nascer com magia no sangue!"

# game/chapters/chapter2/script/ch2sc18.rpy:135
translate brazil ch2sc18_e3ca08a5:

#   el "Most who are gifted with magic live in the capital as a part of the Mages Guild."
    el "A maioria dos que possuem dons mágicos vive na capital, como parte da Guilda dos Magos."

# game/chapters/chapter2/script/ch2sc18.rpy:136
translate brazil ch2sc18_7220d02a:

#   el "Or in other large cities with established schools for magic."
    el "Ou em outras grandes cidades com escolas de magia já estabelecidas."

# game/chapters/chapter2/script/ch2sc18.rpy:140
translate brazil ch2sc18_3244b189:

#   mc "Huh. I never knew about any of that."
    mc "Hum. Eu nunca soube nada disso."

# game/chapters/chapter2/script/ch2sc18.rpy:142
translate brazil ch2sc18_cd749a12:

#   mc "I wonder what else they didn't tell me about?"
    mc "Fico me perguntando o que mais eles não me contaram?"

# game/chapters/chapter2/script/ch2sc18.rpy:144
translate brazil ch2sc18_4fa3b96f:

#   el "Mhm..."
    el "Hum..."

# game/chapters/chapter2/script/ch2sc18.rpy:146
translate brazil ch2sc18_4ba6aefc:

#   el "If you want, we could try to find out more when we reach the capital?"
    el "Se quiser, podemos tentar descobrir mais quando chegarmos à capital?"

# game/chapters/chapter2/script/ch2sc18.rpy:148
translate brazil ch2sc18_99b3eeb0:

#   mc "I suppose we could... wouldn’t you be bored, though?"
    mc "Acho que poderíamos... mas você não ficaria entediado?"

# game/chapters/chapter2/script/ch2sc18.rpy:150
translate brazil ch2sc18_fb48bc20:

#   el "Learning more about you isn’t boring!"
    el "Aprender mais sobre você não é chato!"

# game/chapters/chapter2/script/ch2sc18.rpy:154
translate brazil ch2sc18_6b6ae6fb:

#   el "I’m actually rather excited to find out more!"
    el "Estou bastante animado para descobrir mais!"

# game/chapters/chapter2/script/ch2sc18.rpy:160
translate brazil ch2sc18_874ee5b1:

#   mc "Thank you, Eliza."
    mc "Obrigada, Eliza."

# game/chapters/chapter2/script/ch2sc18.rpy:161
translate brazil ch2sc18_5b0e506f:

#   mc "It... feels good not to be alone in this anymore."
    mc "É... bom não estar mais sozinho nisso."

# game/chapters/chapter2/script/ch2sc18.rpy:163
translate brazil ch2sc18_edd0a4b4:

#   el "You won’t be, not anymore."
    el "Você não será, nunca mais."

# game/chapters/chapter2/script/ch2sc18.rpy:185
translate brazil ch2sc18_dd6b8acd:

#   el "What?"
    el "O que?"

# game/chapters/chapter2/script/ch2sc18.rpy:191
translate brazil ch2sc18_15b5b55c:

#   mc "Just admiring the beauty the divines have bestowed upon you."
    mc "Apenas admirando a beleza que os deuses lhe concederam."

# game/chapters/chapter2/script/ch2sc18.rpy:199
translate brazil ch2sc18_e911c597:

#   el "D-Don’t be silly."
    el "D-Não seja bobo(a)."

# game/chapters/chapter2/script/ch2sc18.rpy:201
translate brazil ch2sc18_bd9e8732:

#   mc "*Chuckles* What? You don't like it when I'm appreciating you?"
    mc "*Risos* O quê? Você não gosta quando eu te elogio?"

# game/chapters/chapter2/script/ch2sc18.rpy:204
translate brazil ch2sc18_b9f0a95a:

#   el "I-I don’t mind when it’s you!"
    el "Não me importo quando é você!"

# game/chapters/chapter2/script/ch2sc18.rpy:205
translate brazil ch2sc18_83575616:

#   "Eliza likes that you complimented her, her trust increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Eliza gostou do elogio, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc18.rpy:209
translate brazil ch2sc18_f37b78d2:

#   mc "Nothing, we better get going."
    mc "Nada, é melhor irmos."

# game/chapters/chapter2/script/ch2sc18.rpy:214
translate brazil ch2sc18_d0fbd36c:

#   el "You know, [mc]. I’m not just here with you for your revenge, but for everything."
    el "Você sabe, [mc] Não estou aqui com você apenas para sua vingança, mas para tudo."

# game/chapters/chapter2/script/ch2sc18.rpy:216
translate brazil ch2sc18_5c87cd99:

#   "You both acknowledge that you’re in this together, for better or worse, with a simple but reassuring smile."
    "Vocês dois reconhecem que estão juntos nessa, na alegria e na tristeza, com um sorriso simples, porém reconfortante."

# game/chapters/chapter2/script/ch2sc18.rpy:219
translate brazil ch2sc18_2826cc21:

#   "The bond the two of you have formed, it's something... unique."
    "O vínculo que vocês dois formaram é algo... único."

# game/chapters/chapter2/script/ch2sc18.rpy:223
translate brazil ch2sc18_0606e2c7:

#   "You walk for several hours, leaving Riverside and familiar faces behind."
    "Você caminha por várias horas, deixando Riverside e rostos familiares para trás."

# game/chapters/chapter2/script/ch2sc18.rpy:227
translate brazil ch2sc18_04285645:

#   mc "Do you think my mother being a sorceress is related to my abilities?"
    mc "Você acha que o fato de minha mãe ser uma feiticeira tem alguma relação com as minhas habilidades?"

# game/chapters/chapter2/script/ch2sc18.rpy:229
translate brazil ch2sc18_088ba0b8:

#   el "There’s definitely a chance of that, magic is usually passed down from parents to their children."
    el "Com certeza existe essa possibilidade, a magia geralmente é transmitida de pais para filhos."

# game/chapters/chapter2/script/ch2sc18.rpy:231
translate brazil ch2sc18_3bdc888c:

#   el "I’ve never seen or encountered magic before."
    el "Nunca vi nem tive contato com magia antes."

# game/chapters/chapter2/script/ch2sc18.rpy:232
translate brazil ch2sc18_658e78dd:

#   el "But from what I’ve read about it in my mothers books, your abilities seem... different."
    el "Mas pelo que li nos livros da minha mãe, suas habilidades parecem... diferentes."

# game/chapters/chapter2/script/ch2sc18.rpy:234
translate brazil ch2sc18_822aa5c3:

#   mc "How so?"
    mc "Como assim?"

# game/chapters/chapter2/script/ch2sc18.rpy:236
translate brazil ch2sc18_49a1f1dd:

#   el "Well, supposedly with magic you usually have to take time to gather energy or even say incantations, depending on your skill."
    el "Bem, supostamente, com magia, geralmente é preciso tempo para reunir energia ou até mesmo recitar encantamentos, dependendo da sua habilidade."

# game/chapters/chapter2/script/ch2sc18.rpy:237
translate brazil ch2sc18_5ada1d7a:

#   el "And mages typically have one natural born elemental affinity, like fire, or water for example."
    el "E os magos normalmente têm uma afinidade elemental inata, como fogo ou água, por exemplo."

# game/chapters/chapter2/script/ch2sc18.rpy:239
translate brazil ch2sc18_85971c0b:

#   mc "I’ve never had to do any of that... also I have an affinity for wind, but..."
    mc "Nunca precisei fazer nada disso... além disso, tenho uma afinidade com o vento, mas..."

# game/chapters/chapter2/script/ch2sc18.rpy:240
translate brazil ch2sc18_11937a53:

#   mc "Gibson claimed my mother was an arcane sorceress."
    mc "Gibson afirmava que minha mãe era uma feiticeira arcana."

# game/chapters/chapter2/script/ch2sc18.rpy:242
translate brazil ch2sc18_c2d0a31e:

#   el "That’s what I’m saying, [mc]."
    el "É isso que estou dizendo, [mc]."

# game/chapters/chapter2/script/ch2sc18.rpy:243
translate brazil ch2sc18_c7423ef5:

#   el "From what you've told me, your magic doesn't seem tied to one specific element."
    el "Pelo que você me contou, sua magia não parece estar ligada a um elemento específico."

# game/chapters/chapter2/script/ch2sc18.rpy:245
translate brazil ch2sc18_37d78e03:

#   el "And you don't even need to say incantations, and without being taught anything about magic?"
    el "E você nem precisa recitar encantamentos, e sem ter aprendido nada sobre magia?"

# game/chapters/chapter2/script/ch2sc18.rpy:247
translate brazil ch2sc18_578892aa:

#   el "Even the most skilled sorceresses practice for years, even decades, before they are able to properly control their magic."
    el "Mesmo as feiticeiras mais habilidosas praticam durante anos, até décadas, antes de conseguirem controlar adequadamente sua magia."

# game/chapters/chapter2/script/ch2sc18.rpy:251
translate brazil ch2sc18_3300677b:

#   el "That’s what makes me think it might be different with you."
    el "É isso que me faz pensar que com você pode ser diferente."

# game/chapters/chapter2/script/ch2sc18.rpy:253
translate brazil ch2sc18_81ca9ef3:

#   el "I-I don’t think it’s just your mothers magic that has passed down to you."
    el "Não acho que seja apenas a magia da sua mãe que foi transmitida para você."

# game/chapters/chapter2/script/ch2sc18.rpy:257
translate brazil ch2sc18_67e297ac:

#   mc "Your father told me a bit about my abilities when I was younger, but even he didn’t know much."
    mc "Seu pai me contou um pouco sobre minhas habilidades quando eu era mais jovem, mas nem ele sabia muito."

# game/chapters/chapter2/script/ch2sc18.rpy:261
translate brazil ch2sc18_97de6a23:

#   el "What did he tell you?"
    el "O que ele te disse?"

# game/chapters/chapter2/script/ch2sc18.rpy:263
translate brazil ch2sc18_4d77fcf9:

#   mc "He said they will grow with time, the more I learn to control them."
    mc "Ele disse que elas vão crescer com o tempo, conforme eu aprender a controlá-las."

# game/chapters/chapter2/script/ch2sc18.rpy:265
translate brazil ch2sc18_cc594c85:

#   mc "He even told me that when I held... Mama... in my arms after I found her, he saw me absorbing her essence."
    mc "Ele até me disse que, quando eu segurei... Mamãe... em meus braços depois que a encontrei, ele me viu absorvendo a essência dela."

# game/chapters/chapter2/script/ch2sc18.rpy:267
translate brazil ch2sc18_362c2cff:

#   mc "And he thought that my parents were murdered because of my... abilities or powers, or whatever they are."
    mc "E ele achava que meus pais foram assassinados por causa das minhas... habilidades ou poderes, ou seja lá o que forem."

# game/chapters/chapter2/script/ch2sc18.rpy:271
translate brazil ch2sc18_11ff09aa:

#   el "Why would someone go to such extremes just because a ten-year-old child has some kind of power?"
    el "Por que alguém se daria ao trabalho de chegar a tais extremos só porque uma criança de dez anos tem algum tipo de poder?"

# game/chapters/chapter2/script/ch2sc18.rpy:273
translate brazil ch2sc18_8b763134:

#   mc "Well, either to kill me, because I could be a threat to the kingdom..."
    mc "Bem, ou para me matar, porque eu poderia ser uma ameaça ao reino..."

# game/chapters/chapter2/script/ch2sc18.rpy:275
translate brazil ch2sc18_c6528d1e:

#   mc "Or to use me in some way that would benefit them."
    mc "Ou para me usar de alguma forma que os beneficie."

# game/chapters/chapter2/script/ch2sc18.rpy:277
translate brazil ch2sc18_4388a5ef:

#   mc "Your father seemed to believe that the person who killed my parents is an important figure in the capital."
    mc "Seu pai parecia acreditar que a pessoa que matou meus pais era uma figura importante na capital."

# game/chapters/chapter2/script/ch2sc18.rpy:281
translate brazil ch2sc18_dde9f013:

#   el "You mean the shady, disgusting, psycho-murderer who ruined both our lives?"
    el "Você está falando daquele psicopata assassino, desprezível e repugnante, que arruinou nossas vidas?"

# game/chapters/chapter2/script/ch2sc18.rpy:285
translate brazil ch2sc18_27481906:

#   mc "Yes. That’s the one."
    mc "Sim. É essa mesma."

# game/chapters/chapter2/script/ch2sc18.rpy:286
translate brazil ch2sc18_d0263b48:

#   "Your fist tightens as you think about the guy."
    "Seu punho se fecha com força ao pensar no rapaz."

# game/chapters/chapter2/script/ch2sc18.rpy:291
translate brazil ch2sc18_d7edd024:

#   "."
    "."

# game/chapters/chapter2/script/ch2sc18.rpy:292
translate brazil ch2sc18_8dabefc6:

#   ".."
    "..."

# game/chapters/chapter2/script/ch2sc18.rpy:300
translate brazil ch2sc18_6302ae72:

#   el "Hey, [mc]."
    el "Ei, [mc]."

# game/chapters/chapter2/script/ch2sc18.rpy:302
translate brazil ch2sc18_e9ec568c:

#   el "We’ll find him. I know it!"
    el "Nós o encontraremos. Eu sei disso!"

# game/chapters/chapter2/script/ch2sc18.rpy:304
translate brazil ch2sc18_a0b09c23:

#   el "And when we do... we’ll have {b}our{/b} revenge."
    el "E quando fizermos isso... teremos {b} nosso{/b} vingança."

# game/chapters/chapter2/script/ch2sc18.rpy:307
translate brazil ch2sc18_f0f1e231:

#   mct "She's right... whoever killed my parents, they also indirectly caused Eliza's life to crumble."
