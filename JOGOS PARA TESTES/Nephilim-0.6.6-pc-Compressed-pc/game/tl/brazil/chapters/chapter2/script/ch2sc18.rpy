# game/chapters/chapter2/script/ch2sc18.rpy:793
translate brazil ch2sc18_d59fc5bb:

#   my "If Asta wants me to show her a bit of how to manage a household, then I will do just that."
    my "Se Asta quiser que eu lhe mostre um pouco de como administrar uma casa, então farei exatamente isso."

# game/chapters/chapter2/script/ch2sc18.rpy:796
translate brazil ch2sc18_611e94fc:

#   sh "Have you no shame woman?"
    sh "Você não tem vergonha, mulher?"

# game/chapters/chapter2/script/ch2sc18.rpy:797
translate brazil ch2sc18_a868e223:

#   sh "You're just using that poor girl as a pretense to see Gibson I bet..."
    sh "Aposto que você está usando aquela pobre garota como pretexto para ver o Gibson..."

# game/chapters/chapter2/script/ch2sc18.rpy:798
translate brazil ch2sc18_f93c1834:

#   sh "You think people won't notice how you're playing mother and wife to them?"
    sh "Você acha que as pessoas não vão perceber como você está desempenhando o papel de mãe e esposa para elas?"

# game/chapters/chapter2/script/ch2sc18.rpy:801
translate brazil ch2sc18_93120e9f:

#   my "Shane! That's enough... you're out of line."
    my "Shane! Já chega... você passou dos limites."

# game/chapters/chapter2/script/ch2sc18.rpy:804
translate brazil ch2sc18_e9c90ff8:

#   sh "No, I think not... you're the one who's crossing lines."
    sh "Não, acho que não... você é quem está ultrapassando os limites."

# game/chapters/chapter2/script/ch2sc18.rpy:805
translate brazil ch2sc18_eb6dddeb:

#   sh "Don't you realise that your actions will have you labeled as the village whore?"
    sh "Você não percebe que suas ações farão com que você seja rotulada como a prostituta da aldeia?"

# game/chapters/chapter2/script/ch2sc18.rpy:808
translate brazil ch2sc18_fc48d93b:

#   my "{b}Shane!{/b}"
    my "{b}Shane!{/b}"

# game/chapters/chapter2/script/ch2sc18.rpy:811
translate brazil ch2sc18_c7458d8a:

#   sh "Not that your reputation matters to me, but we're married, your actions will affect my reputation!"
    sh "Não que sua reputação me importe, mas somos casados, suas ações afetarão a minha reputação!"

# game/chapters/chapter2/script/ch2sc18.rpy:814
translate brazil ch2sc18_eff9bca3:

#   my "Your reputation as what? The village drunk?"
    my "Sua reputação como o quê? O bêbado da aldeia?"

# game/chapters/chapter2/script/ch2sc18.rpy:817
translate brazil ch2sc18_e7fdb09d:

#   sh "What did you just say to me?!"
    sh "O que você acabou de me dizer?!"

# game/chapters/chapter2/script/ch2sc18.rpy:818
translate brazil ch2sc18_899af50c:

#   sh "Maybe it's time you get a firm backhand? You've been a little too snarky as of late!"
    sh "Talvez seja hora de você levar umas boas palmadas? Você anda sendo um pouco sarcástico demais ultimamente!"

# game/chapters/chapter2/script/ch2sc18.rpy:821
translate brazil ch2sc18_b1710e7c:

#   my "{b}LEAVE!{/b} The longer you disturb me, the longer it'll be before dinner is finished!"
    my "{b}DEIXAR!{/b} Quanto mais tempo você me interromper, mais tempo levará para o jantar terminar!"

# game/chapters/chapter2/script/ch2sc18.rpy:822
translate brazil ch2sc18_57097309:

#   sh "*Scoffs* You're lucky I'm starving... otherwise I'd slapped that attitude out of you once and for all."
    sh "*Zomba* Você tem sorte de eu estar morrendo de fome... senão eu já teria te dado uma surra para acabar com essa sua arrogância de uma vez por todas."

# game/chapters/chapter2/script/ch2sc18.rpy:827
translate brazil ch2sc18_86b5eae5:

#   my "*Exhales* That was close... he's getting more aggressive..."
    my "*Suspira* Essa foi por pouco... ele está ficando mais agressivo..."

# game/chapters/chapter2/script/ch2sc18.rpy:828
translate brazil ch2sc18_57ec06a6:

#   my "Flynn and Sabrina have spoken of wanting to go to Luxenford, the capital."
    my "Flynn e Sabrina já falaram sobre o desejo de ir a Luxemburgo, a capital."

# game/chapters/chapter2/script/ch2sc18.rpy:829
translate brazil ch2sc18_0b252ebb:

#   my "As much as I want them to remain in Riverside, I need to encourage them to leave."
    my "Por mais que eu queira que eles permaneçam em Riverside, preciso incentivá-los a ir embora."

# game/chapters/chapter2/script/ch2sc18.rpy:830
translate brazil ch2sc18_38fa29d8:

#   my "I refuse to let them be witness to what their father is becoming... or what he might do."
    my "Recuso-me a deixá-los testemunhar no que seu pai está se tornando... ou no que ele poderá fazer."

# game/chapters/chapter2/script/ch2sc18.rpy:839
translate brazil ch2sc18_784e4547:

#   el "So... is there anything else my father knew about you? He must have known about you before."
    el "Então... há mais alguma coisa que meu pai sabia sobre você? Ele devia saber de você antes."

# game/chapters/chapter2/script/ch2sc18.rpy:841
translate brazil ch2sc18_fdc9462d:

#   el "Why else would he have been ready to take you away?"
    el "Por que mais ele estaria disposto a te levar embora?"

# game/chapters/chapter2/script/ch2sc18.rpy:843
translate brazil ch2sc18_c33ad0bf:

#   mc "Oren... your father, he told me that I’m not human."
    mc "Oren... seu pai, ele me disse que eu não sou humano."

# game/chapters/chapter2/script/ch2sc18.rpy:846
translate brazil ch2sc18_13b79a52:

#   el "{size=+3}{b}WHAT?!{/b}{/size}"
    el "{size=+3}{b}O QUE?!{/b}{/size}"

# game/chapters/chapter2/script/ch2sc18.rpy:848
translate brazil ch2sc18_607b3b1a:

#   mc "I mean-"
    mc "Quero dizer-"

# game/chapters/chapter2/script/ch2sc18.rpy:851
translate brazil ch2sc18_670a7f52:

#   el "N-Not human?! {size=+3}{b}WHaaaAT?!{/b}{/size}"
    el "N-Não humano?! {size=+3}{b}O QUÊÊÊÊ?!{/b}{/size}"

# game/chapters/chapter2/script/ch2sc18.rpy:853
translate brazil ch2sc18_f292fd83:

#   mc "Forget it."
    mc "Esqueça."

# game/chapters/chapter2/script/ch2sc18.rpy:857
translate brazil ch2sc18_9cd02237:

#   el "No! No, I’m sorry... that was just surprising to hear."
    el "Não! Não, desculpe... foi uma surpresa ouvir isso."

# game/chapters/chapter2/script/ch2sc18.rpy:858
translate brazil ch2sc18_29f57440:

#   el "I mean... you look totally human?"
    el "Quer dizer... você parece totalmente humano?"

# game/chapters/chapter2/script/ch2sc18.rpy:860
translate brazil ch2sc18_a7c0494a:

#   mc "You can say it."
    mc "Você pode dizer isso."

# game/chapters/chapter2/script/ch2sc18.rpy:862
translate brazil ch2sc18_13a7a65e:

#   el "Huh? Say what?"
    el "Hã? Como assim?"

# game/chapters/chapter2/script/ch2sc18.rpy:864
translate brazil ch2sc18_ec399bde:

#   mc "That I’m a freak."
    mc "Que eu sou um esquisito."

# game/chapters/chapter2/script/ch2sc18.rpy:866
translate brazil ch2sc18_b5eb48e3:

#   el "*Sigh*"
    el "*Suspirar*"

# game/chapters/chapter2/script/ch2sc18.rpy:868
translate brazil ch2sc18_d2e921bc:

#   el "Do you want me to beat you up?"
    el "Você quer que eu te bata?"

# game/chapters/chapter2/script/ch2sc18.rpy:870
translate brazil ch2sc18_d9af6597:

#   mc "No?"
    mc "Não?"

# game/chapters/chapter2/script/ch2sc18.rpy:873
translate brazil ch2sc18_313404bc:

#   el "Then stop saying such horseshit!"
    el "Então pare de falar tanta besteira!"

# game/chapters/chapter2/script/ch2sc18.rpy:874
translate brazil ch2sc18_47db80d9:

#   el "I will never see you as anything but you."
    el "Eu nunca vou te ver como outra coisa além de você mesma."

# game/chapters/chapter2/script/ch2sc18.rpy:876
translate brazil ch2sc18_107f00e5:

#   el "It’s your actions that matter to me, [mc]."
    el "São as suas ações que me importam. [mc]."

# game/chapters/chapter2/script/ch2sc18.rpy:877
translate brazil ch2sc18_c319de3a:

#   el "Not something that’s out of your control."
    el "Não é algo que esteja fora do seu controle."

# game/chapters/chapter2/script/ch2sc18.rpy:879
translate brazil ch2sc18_cdf3b081:

#   mc "I’m not used to anyone being so... accepting of me."
    mc "Não estou acostumada a que as pessoas sejam tão... receptivas a mim."

# game/chapters/chapter2/script/ch2sc18.rpy:881
translate brazil ch2sc18_2992455e:

#   el "Well, you should know me well enough by now. I’m not like everyone else."
    el "Bom, você já deve me conhecer bem o suficiente. Eu não sou como todo mundo."

# game/chapters/chapter2/script/ch2sc18.rpy:883
translate brazil ch2sc18_e0ea22c7:

#   mc "I’ve noticed."
    mc "Eu percebi."

# game/chapters/chapter2/script/ch2sc18.rpy:886
translate brazil ch2sc18_a2e3b9ef:

#   el "Good."
    el "Bom."

# game/chapters/chapter2/script/ch2sc18.rpy:888
translate brazil ch2sc18_76328dee:

#   el "So, tell me. If you’re not human, what are you?"
    el "Então me diga. Se você não é humano, o que você é?"

# game/chapters/chapter2/script/ch2sc18.rpy:890
translate brazil ch2sc18_4b5ef944:

#   el "Some sort of magical elf? No... your ears aren't pointy enough."
    el "Algum tipo de elfo mágico? Não... suas orelhas não são pontudas o suficiente."

# game/chapters/chapter2/script/ch2sc18.rpy:892
translate brazil ch2sc18_2023ff33:

#   el "Oh! Oh! A merman, perhaps? You know, like a mermaid, but a man?"
    el "Oh! Oh! Um tritão, talvez? Sabe, tipo uma sereia, só que homem?"

# game/chapters/chapter2/script/ch2sc18.rpy:894
translate brazil ch2sc18_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter2/script/ch2sc18.rpy:897
translate brazil ch2sc18_30285378:

#   el "Please don’t be a troll in disguise!"
    el "Por favor, não seja um troll disfarçado!"

# game/chapters/chapter2/script/ch2sc18.rpy:900
translate brazil ch2sc18_b95043de:

#   el "I don’t think I could handle you being a smelly troll."
    el "Acho que não conseguiria lidar com você sendo um troll fedorento."

# game/chapters/chapter2/script/ch2sc18.rpy:902
translate brazil ch2sc18_c766dbe7:

#   mc "Are you done?"
    mc "Você já terminou?"

# game/chapters/chapter2/script/ch2sc18.rpy:904
translate brazil ch2sc18_d5d23cae:

#   el "Hmmm... Mhmm."
    el "Hum... Aham."

# game/chapters/chapter2/script/ch2sc18.rpy:906
translate brazil ch2sc18_1cfdd860:

#   el "Yup! I’m all out of plausible scenarios."
    el "É isso aí! Já esgotei todos os cenários plausíveis."

# game/chapters/chapter2/script/ch2sc18.rpy:908
translate brazil ch2sc18_340b5f20:

#   mc "It’s been truly enlightening listening to your theories. However-"
    mc "Foi realmente esclarecedor ouvir suas teorias. No entanto..."

# game/chapters/chapter2/script/ch2sc18.rpy:910
translate brazil ch2sc18_43808b18:

#   mc "According to Oren, I’m something called a {b}'Nephilim'{/b}."
    mc "Segundo Oren, eu sou algo chamado {b}'Nefilins'{/b}."

# game/chapters/chapter2/script/ch2sc18.rpy:912
translate brazil ch2sc18_9c4a35b0:

#   el "Nephilim?"
    el "Nefilins?"

# game/chapters/chapter2/script/ch2sc18.rpy:914
translate brazil ch2sc18_917609ba:

#   el "What in the blazes is a Nephilim?"
    el "Que diabos é um Nefilim?"

# game/chapters/chapter2/script/ch2sc18.rpy:915
translate brazil ch2sc18_2f76c266:

#   el "You mentioned this once before... at the apple orchards in Riverside."
    el "Você já mencionou isso antes... nos pomares de maçãs em Riverside."

# game/chapters/chapter2/script/ch2sc18.rpy:917
translate brazil ch2sc18_59be159a:

#   el "I haven't heard of a Nephilim before..."
    el "Nunca ouvi falar de um Nefilim antes..."

# game/chapters/chapter2/script/ch2sc18.rpy:918
translate brazil ch2sc18_872cf1ea:

#   el "It certainly wasn't in my mother’s books."
    el "Com certeza não estava nos livros da minha mãe."

# game/chapters/chapter2/script/ch2sc18.rpy:919
translate brazil ch2sc18_bea2c6c9:

#   el "What... is a Nephilim? Will you tell me?"
    el "O que... é um Nefilim? Você pode me dizer?"

# game/chapters/chapter2/script/ch2sc18.rpy:921
translate brazil ch2sc18_0e50e0be:

#   mc "There’s a good reason you haven't heard of them."
    mc "Existe um bom motivo para você nunca ter ouvido falar deles."

# game/chapters/chapter2/script/ch2sc18.rpy:922
translate brazil ch2sc18_e581dabe:

#   mc "Apparently, a Nephilim is the child of a human and an angel."
    mc "Aparentemente, um Nefilim é filho de um humano e um anjo."

# game/chapters/chapter2/script/ch2sc18.rpy:924
translate brazil ch2sc18_b5f2ad84:

#   el "A-Angel?? Are you for real?!"
    el "Um anjo?? Você está falando sério?!"

# game/chapters/chapter2/script/ch2sc18.rpy:926
translate brazil ch2sc18_2156a300:

#   mc "Yes. Your father told me that, other than me, there’s only been one other Nephilim in the history of Midomir."
    mc "Sim. Seu pai me disse que, além de mim, só houve um outro Nefilim na história de Midomir."

# game/chapters/chapter2/script/ch2sc18.rpy:928
translate brazil ch2sc18_41ed951c:

#   mc "Apparently, the other one... Balthazar, he’s the reason the first era ended over five hundred years ago."
    mc "Aparentemente, o outro... Baltazar, é o motivo pelo qual a primeira era terminou há mais de quinhentos anos."

# game/chapters/chapter2/script/ch2sc18.rpy:930
translate brazil ch2sc18_2d1ffbf7:

#   el "Woah, what the actual fuck?"
    el "Nossa, que porra é essa?"

# game/chapters/chapter2/script/ch2sc18.rpy:931
translate brazil ch2sc18_984f50bd:

#   el "Did he turn out to be some kind of evil monster?"
    el "Ele acabou se revelando algum tipo de monstro maligno?"

# game/chapters/chapter2/script/ch2sc18.rpy:933
translate brazil ch2sc18_1f152a1c:

#   mc "Supposedly, he was able to devour the souls of anything that had recently died."
    mc "Supostamente, ele era capaz de devorar as almas de qualquer coisa que tivesse morrido recentemente."

# game/chapters/chapter2/script/ch2sc18.rpy:935
translate brazil ch2sc18_fc4fc174:

#   mc "Which is something I’m also able to do."
    mc "O que é algo que eu também sou capaz de fazer."

# game/chapters/chapter2/script/ch2sc18.rpy:938
translate brazil ch2sc18_cdcd5251:

#   mc "He got so consumed with feeding on souls and the power it gave him, he wanted to lay waste to all of Midomir."
    mc "Ele ficou tão obcecado em se alimentar de almas e no poder que isso lhe dava, que quis devastar todo Midomir."

# game/chapters/chapter2/script/ch2sc18.rpy:941
translate brazil ch2sc18_cc3c9033:

#   el "That’s horrible!"
    el "Que horror!"

# game/chapters/chapter2/script/ch2sc18.rpy:944
translate brazil ch2sc18_b2e6062d:

#   mc "He managed to kill thousands upon thousands during the Abyss wars in the 1st Era."
    mc "Ele conseguiu matar milhares e milhares durante as Guerras do Abismo na 1ª Era."

# game/chapters/chapter2/script/ch2sc18.rpy:945
translate brazil ch2sc18_59d2a1b3:

#   mc "Humans... Animals... Creatures... Dwarves... Elves... Gnomes... Faes... anything he could devour."
    mc "Humanos... Animais... Criaturas... Anões... Elfos... Gnomos... Fadas... qualquer coisa que ele pudesse devorar."

# game/chapters/chapter2/script/ch2sc18.rpy:948
translate brazil ch2sc18_31873884:

#   mc "Eventually he was stopped, though."
    mc "No fim, ele foi detido."

# game/chapters/chapter2/script/ch2sc18.rpy:949
translate brazil ch2sc18_3937ff26:

#   mc "A gathering of the ten strongest wizards and sorceresses sacrificed themselves."
    mc "Um grupo dos dez magos e feiticeiras mais poderosos se sacrificou."

# game/chapters/chapter2/script/ch2sc18.rpy:950
translate brazil ch2sc18_7e2c6ff0:

#   mc "They created a sacred spell known as {b}'Seal of Solomon'{/b}"
    mc "Eles criaram um feitiço sagrado conhecido como {b}'Selo de Salomão'{/b}"

# game/chapters/chapter2/script/ch2sc18.rpy:953
translate brazil ch2sc18_ec51cc50:

#   mc "The mages each had an enchanted ring that they sealed their powers within."
    mc "Cada mago possuía um anel encantado no qual selava seus poderes."

# game/chapters/chapter2/script/ch2sc18.rpy:956
translate brazil ch2sc18_719c371d:

#   mc "Then they linked the ten enchanted rings in a ritual."
    mc "Em seguida, eles uniram os dez anéis encantados em um ritual."

# game/chapters/chapter2/script/ch2sc18.rpy:957
translate brazil ch2sc18_b39076ae:

#   mc "And with the combined power, they were finally able to seal Balthazar away in the depths of the Abyss."
    mc "E com o poder combinado, eles finalmente conseguiram selar Balthazar nas profundezas do Abismo."

# game/chapters/chapter2/script/ch2sc18.rpy:959
translate brazil ch2sc18_39f146f4:

#   mc "But after sealing him away, all of the wizards and sorceresses died within a week of the ritual."
    mc "Mas, após o selamento, todos os bruxos e feiticeiras morreram em uma semana após o ritual."

# game/chapters/chapter2/script/ch2sc18.rpy:960
translate brazil ch2sc18_18f61fa7:

#   mc "It turned out, the rings had also absorbed some of their life essence along with their mana."
    mc "Descobriu-se que os anéis também haviam absorvido parte da essência vital deles, juntamente com sua mana."

# game/chapters/chapter2/script/ch2sc18.rpy:962
translate brazil ch2sc18_c58124a3:

#   mc "Casting such a complicated spell and having their powers drained, they were too weak to continue."
    mc "Após conjurarem um feitiço tão complexo e terem seus poderes drenados, eles ficaram fracos demais para continuar."

# game/chapters/chapter2/script/ch2sc18.rpy:964
translate brazil ch2sc18_caa45cf6:

#   mc "All that, just to banish him."
    mc "Tudo isso, só para bani-lo."

# game/chapters/chapter2/script/ch2sc18.rpy:965
translate brazil ch2sc18_0671915f:

#   mc "Now, five hundred years later and we're here in the 2nd Era of Midomir."
    mc "Agora, quinhentos anos depois, estamos aqui na 2ª Era de Midomir."

# game/chapters/chapter2/script/ch2sc18.rpy:966
translate brazil ch2sc18_9ae13a5c:

#   mc "And Stories of Balthazar have been all but forgotten."
    mc "E as histórias de Baltazar foram praticamente esquecidas."

# game/chapters/chapter2/script/ch2sc18.rpy:967
translate brazil ch2sc18_568eb1e7:

#   mc "Your father had to do some thorough digging for any scriptures from that time period."
    mc "Seu pai teve que fazer uma pesquisa minuciosa para encontrar quaisquer escrituras daquele período."

# game/chapters/chapter2/script/ch2sc18.rpy:969
translate brazil ch2sc18_ef0499b7:

#   el "[mc], if all this is true..."
    el "[mc] Se tudo isso for verdade..."

# game/chapters/chapter2/script/ch2sc18.rpy:970
translate brazil ch2sc18_61dab283:

#   el "That means..."
    el "Isso significa..."

# game/chapters/chapter2/script/ch2sc18.rpy:972
translate brazil ch2sc18_4fe32037:

#   mc "Yeah... I could end up like him, or worse."
    mc "É... eu poderia acabar como ele, ou pior."

# game/chapters/chapter2/script/ch2sc18.rpy:974
translate brazil ch2sc18_69d7822c:

#   el "There’s no chance of that."
    el "Não há a menor chance disso acontecer."

# game/chapters/chapter2/script/ch2sc18.rpy:976
translate brazil ch2sc18_be421fcf:

#   mc "Yes there is-"
    mc "Sim, existe."

# game/chapters/chapter2/script/ch2sc18.rpy:979
translate brazil ch2sc18_afb73379:

#   el "{b}NO!{/b} I won’t let it happen."
    el "{b}NÃO!{/b} Não vou deixar isso acontecer."

# game/chapters/chapter2/script/ch2sc18.rpy:981
translate brazil ch2sc18_3567dea8:

#   mc "You won’t be able to stop it."
    mc "Você não conseguirá impedi-lo."

# game/chapters/chapter2/script/ch2sc18.rpy:984
translate brazil ch2sc18_328e875e:

#   "Eliza grabs you firmly and rests her forehead against your chest."
    "Eliza te agarra com firmeza e encosta a testa no seu peito."

# game/chapters/chapter2/script/ch2sc18.rpy:985
translate brazil ch2sc18_a032cb95:

#   el "Oh, yes I will! There’s absolutely no way that I’m letting you-"
    el "Ah, sim, eu vou! De jeito nenhum vou deixar você fazer isso!"

# game/chapters/chapter2/script/ch2sc18.rpy:986
translate brazil ch2sc18_0b757cac:

#   el "-The only person that matters to me, become like that... Balthazar thing."
    el "-A única pessoa que importa para mim se tornou como aquele... Baltazar."

# game/chapters/chapter2/script/ch2sc18.rpy:988
translate brazil ch2sc18_1f8480c4:

#   el "You won’t become that, I won’t let you."
    el "Você não vai se tornar isso, eu não vou deixar."

# game/chapters/chapter2/script/ch2sc18.rpy:990
translate brazil ch2sc18_52518d56:

#   el "You got that?"
    el "Entendeu?"

# game/chapters/chapter2/script/ch2sc18.rpy:992
translate brazil ch2sc18_0a28ee29:

#   mc "Eliza..."
    mc "Eliza..."

# game/chapters/chapter2/script/ch2sc18.rpy:994
translate brazil ch2sc18_1fa1321d:

#   el "I said-"
    el "Eu disse-"

