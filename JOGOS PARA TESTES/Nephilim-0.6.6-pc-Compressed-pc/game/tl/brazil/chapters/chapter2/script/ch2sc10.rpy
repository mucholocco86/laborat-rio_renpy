# ARQUIVO: game/chapters/chapter2/script/ch2sc10.rpy DIALOGOS: 445


# game/chapters/chapter2/script/ch2sc10.rpy:14
translate brazil ch2sc10_d35136ff:

#   mct "I should see if old man Gibbs is home while there’s still some daylight left."
    mct "Devo ver se o velho Gibbs está em casa enquanto ainda há luz do dia."

# game/chapters/chapter2/script/ch2sc10.rpy:16
translate brazil ch2sc10_17761a35:

#   mct "I wonder what he has been up to all these years?"
    mct "Fico pensando o que ele tem feito todos esses anos?"

# game/chapters/chapter2/script/ch2sc10.rpy:17
translate brazil ch2sc10_cf337133:

#   mct "Probably still making tools for the village, and getting drunk at the tavern."
    mct "Provavelmente ainda fabricando ferramentas para a aldeia e se embriagando na taverna."

# game/chapters/chapter2/script/ch2sc10.rpy:19
translate brazil ch2sc10_e9b9b4d1:

#   mct "Come to think of it, though, we didn’t run into him at the tavern last night."
    mct "Pensando bem, porém, não o encontramos na taverna ontem à noite."

# game/chapters/chapter2/script/ch2sc10.rpy:20
translate brazil ch2sc10_e5435d19:

#   mct "He and father often had a couple of ales there after they were done with work for the day."
    mct "Ele e o pai costumavam tomar umas cervejas ali depois que terminavam o trabalho do dia."

# game/chapters/chapter2/script/ch2sc10.rpy:22
translate brazil ch2sc10_f94c3f0d:

#   fy "Hey Sabby!"
    fy "Olá Sabby!"

# game/chapters/chapter2/script/ch2sc10.rpy:24
translate brazil ch2sc10_5cf209b3:

#   sa "Urrh, Flynn. I’ve told you a million times not to call me that."
    sa "Urrh, Flynn. Eu já te disse um milhão de vezes para não me chamar assim."

# game/chapters/chapter2/script/ch2sc10.rpy:26
translate brazil ch2sc10_eeede785:

#   fy "Isn’t that... ?"
    fy "Não é...?"

# game/chapters/chapter2/script/ch2sc10.rpy:28
translate brazil ch2sc10_3ab4354a:

#   sa "It could be... Alice mentioned he was back."
    sa "Pode ser... Alice mencionou que ele havia voltado."

# game/chapters/chapter2/script/ch2sc10.rpy:31
translate brazil ch2sc10_8c49263a:

#   fy "{b}HEY! [mc]!{/b}"
    fy "{b}EI! [mc]!{/b}"

# game/chapters/chapter2/script/ch2sc10.rpy:35
translate brazil ch2sc10_34e70dbd:

#   fy "Well, well, well. If it isn’t our favorite cousin!"
    fy "Ora, ora, ora! Se não é o nosso primo favorito!"

# game/chapters/chapter2/script/ch2sc10.rpy:37
translate brazil ch2sc10_0af3d8bb:

#   sa "Don’t mind Flynn. His manners are terrible as always. Hi [mc]."
    sa "Não ligue para o Flynn. Os modos dele são péssimos, como sempre. Oi [mc]."

# game/chapters/chapter2/script/ch2sc10.rpy:39
translate brazil ch2sc10_19a15c45:

#   mc "I’m your only cousin, Flynn..."
    mc "Eu sou seu único primo, Flynn..."

# game/chapters/chapter2/script/ch2sc10.rpy:40
translate brazil ch2sc10_93d68ce3:

#   mc "Hi Sabrina."
    mc "Olá Sabrina."

# game/chapters/chapter2/script/ch2sc10.rpy:42
translate brazil ch2sc10_bde6562f:

#   sa "It’s good to see you!"
    sa "Que bom te ver!"

# game/chapters/chapter2/script/ch2sc10.rpy:43
translate brazil ch2sc10_f1f902f9:

#   sa "You're looking... good, real good."
    sa "Você está... ótima, ótima mesmo."

# game/chapters/chapter2/script/ch2sc10.rpy:45
translate brazil ch2sc10_8f9c0488:

#   mc "You don’t seem all that surprised to see me."
    mc "Você não parece muito surpreso(a) em me ver."

# game/chapters/chapter2/script/ch2sc10.rpy:47
translate brazil ch2sc10_3a990561:

#   fy "Alice already told us you were back when we ran into her earlier."
    fy "Alice já nos disse que você tinha voltado quando a encontramos mais cedo."

# game/chapters/chapter2/script/ch2sc10.rpy:48
translate brazil ch2sc10_a626bab6:

#   fy "She had a very... angry expression."
    fy "Ela tinha uma expressão muito... zangada."

# game/chapters/chapter2/script/ch2sc10.rpy:50
translate brazil ch2sc10_a94195db:

#   fy "I didn't dare ask what was upsetting her."
    fy "Não me atrevi a perguntar o que a estava incomodando."

# game/chapters/chapter2/script/ch2sc10.rpy:51
translate brazil ch2sc10_e93cfb6f:

#   fy "As I’m sure you remember, her gut-punch is quite something."
    fy "Como certamente você se lembra, o soco no estômago dela é algo impressionante."

# game/chapters/chapter2/script/ch2sc10.rpy:53
translate brazil ch2sc10_8e31eb27:

#   mc "I already smoothed things over with her."
    mc "Eu já resolvi as coisas com ela."

# game/chapters/chapter2/script/ch2sc10.rpy:54
translate brazil ch2sc10_e46cfa31:

#   mc "She was upset when she first saw me after thinking I had been dead for ten years."
    mc "Ela ficou chateada quando me viu pela primeira vez, depois de pensar que eu estava morto havia dez anos."

# game/chapters/chapter2/script/ch2sc10.rpy:56
translate brazil ch2sc10_4300906d:

#   sa "Yeah, I can imagine. You’re okay, though? We haven’t heard from you in all these years."
    sa "Sim, consigo imaginar. Mas você está bem? Não temos notícias suas há todos esses anos."

# game/chapters/chapter2/script/ch2sc10.rpy:57
translate brazil ch2sc10_1a082676:

#   sa "I'm honestly feeling like giving you a good slap as well!"
    sa "Sinceramente, também estou com muita vontade de te dar um tapa!"

# game/chapters/chapter2/script/ch2sc10.rpy:59
translate brazil ch2sc10_c8b105e7:

#   fy "What’s up with that, hmm?"
    fy "O que será que está acontecendo?"

# game/chapters/chapter2/script/ch2sc10.rpy:60
translate brazil ch2sc10_21562bde:

#   fy "Your parents die and you just vanish off the face of the earth?"
    fy "Seus pais morrem e você simplesmente desaparece da face da Terra?"

# game/chapters/chapter2/script/ch2sc10.rpy:63
translate brazil ch2sc10_2e22e22d:

#   sa "{b}Flynn!{/b}"
    sa "{b}Flynn!{/b}"

# game/chapters/chapter2/script/ch2sc10.rpy:64
translate brazil ch2sc10_acafb4d4:

#   sa "Shut your piehole! You're so insensitive!"
    sa "Cala a boca! Você é tão insensível!"

# game/chapters/chapter2/script/ch2sc10.rpy:66
translate brazil ch2sc10_877e65e2:

#   mc "It’s alright, Sabrina. It wasn’t safe for me to be here."
    mc "Está tudo bem, Sabrina. Não era seguro para mim estar aqui."

# game/chapters/chapter2/script/ch2sc10.rpy:67
translate brazil ch2sc10_8d9af02c:

#   mc "It still isn’t. I’m just passing through the area on my way to Luxenford."
    mc "Ainda não. Estou apenas de passagem pela região a caminho de Luxemburgo."

# game/chapters/chapter2/script/ch2sc10.rpy:69
translate brazil ch2sc10_b2d4fbb5:

#   fy "You’re headed to the capital?"
    fy "Você está indo para a capital?"

# game/chapters/chapter2/script/ch2sc10.rpy:70
translate brazil ch2sc10_3e02ab1f:

#   fy "What for?"
    fy "Para quê?"

# game/chapters/chapter2/script/ch2sc10.rpy:72
translate brazil ch2sc10_de40983b:

#   mc "Yes, it holds answers that I need."
    mc "Sim, contém as respostas que preciso."

# game/chapters/chapter2/script/ch2sc10.rpy:74
translate brazil ch2sc10_83dad1f4:

#   sa "We’re actually headed there ourselves in about two weeks."
    sa "Nós mesmos iremos para lá daqui a cerca de duas semanas."

# game/chapters/chapter2/script/ch2sc10.rpy:76
translate brazil ch2sc10_6b7b907f:

#   sa "Why don’t you stay with us until then?"
    sa "Por que você não fica conosco até lá?"

# game/chapters/chapter2/script/ch2sc10.rpy:77
translate brazil ch2sc10_a6c3fc2f:

#   sa "We could travel to Luxenford together!"
    sa "Poderíamos viajar juntos para Luxemburgo!"

# game/chapters/chapter2/script/ch2sc10.rpy:78
translate brazil ch2sc10_18f8015a:

#   sa "I’m positive Mom and Dad would love to have you over, You’re their nephew too, after all."
    sa "Tenho certeza de que mamãe e papai adorariam que você viesse visitá-los. Afinal, você também é sobrinho deles."

# game/chapters/chapter2/script/ch2sc10.rpy:80
translate brazil ch2sc10_e07f6731:

#   mc "I’m leaving tomorrow at first light, with Eliza. I’ve waited ten years..."
    mc "Partirei amanhã ao amanhecer, com Eliza. Esperei dez anos..."

# game/chapters/chapter2/script/ch2sc10.rpy:82
translate brazil ch2sc10_7b5c669f:

#   mc "And I’m done waiting."
    mc "E chega de esperar."

# game/chapters/chapter2/script/ch2sc10.rpy:84
translate brazil ch2sc10_cca6b2ad:

#   fy "Eliza huh? Is she hot?"
    fy "Eliza, hein? Ela é gata?"

# game/chapters/chapter2/script/ch2sc10.rpy:86
translate brazil ch2sc10_628afe7d:

#   mc "*Exhales* ..."
    mc "*Exala* ..."

# game/chapters/chapter2/script/ch2sc10.rpy:88
translate brazil ch2sc10_5c341a7a:

#   sa "Flynn! How about you keep it in your pants for once?"
    sa "Flynn! Que tal você se controlar dessa vez?"

# game/chapters/chapter2/script/ch2sc10.rpy:90
translate brazil ch2sc10_6c59e1cf:

#   fy "What? I was just curious..."
    fy "O quê? Eu só estava curioso..."

# game/chapters/chapter2/script/ch2sc10.rpy:92
translate brazil ch2sc10_fa004440:

#   sa "You’re hopeless."
    sa "Você é um caso perdido."

# game/chapters/chapter2/script/ch2sc10.rpy:94
translate brazil ch2sc10_d63a1e49:

#   fy "Hopeless romantic!"
    fy "Romântico incurável!"

# game/chapters/chapter2/script/ch2sc10.rpy:96
translate brazil ch2sc10_d3f819ce:

#   sa "No. Just hopeless!"
    sa "Não. Simplesmente sem esperança!"

# game/chapters/chapter2/script/ch2sc10.rpy:98
translate brazil ch2sc10_3c472088:

#   fy "[mc] traveling alone with a young maiden. You can’t blame me for assuming..."
    fy "[mc] Viajando sozinho com uma jovem donzela. Não me culpe por presumir..."

# game/chapters/chapter2/script/ch2sc10.rpy:99
translate brazil ch2sc10_aee97afd:

#   fy "They're probably dating! I think that's safe to assume?"
    fy "Eles provavelmente estão namorando! Acho que posso presumir isso com segurança, não é?"

# game/chapters/chapter2/script/ch2sc10.rpy:101
translate brazil ch2sc10_94e4376f:

#   mc "She’s..."
    mc "Ela é..."

# game/chapters/chapter2/script/ch2sc10.rpy:107
translate brazil ch2sc10_23338fd6:

#   fy "Okay, okay. I won’t make any inappropriate jokes."
    fy "Ok, ok. Não farei nenhuma piada inapropriada."

# game/chapters/chapter2/script/ch2sc10.rpy:109
translate brazil ch2sc10_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter2/script/ch2sc10.rpy:111
translate brazil ch2sc10_91b9e3f3:

#   fy "So, when can we meet this lovely maiden you've found?"
    fy "Então, quando poderemos conhecer essa linda moça que você encontrou?"

# game/chapters/chapter2/script/ch2sc10.rpy:113
translate brazil ch2sc10_5f5a9dac:

#   mc "How about... never?"
    mc "Que tal... nunca?"

# game/chapters/chapter2/script/ch2sc10.rpy:115
translate brazil ch2sc10_31c24099:

#   fy "Oh, come on! If you care about her, she is obviously something special..."
    fy "Ah, qual é! Se você se importa com ela, é óbvio que ela é especial..."

# game/chapters/chapter2/script/ch2sc10.rpy:117
translate brazil ch2sc10_cfa0fa3a:

#   fy "I have a duty to make sure my dear cousin doesn’t get played for a fool by some lady and her feminine charms."
    fy "Tenho o dever de garantir que meu querido primo não seja enganado por alguma dama e seus encantos femininos."

# game/chapters/chapter2/script/ch2sc10.rpy:118
translate brazil ch2sc10_6551026d:

#   fy "Or get lured into devil worship by a succubus!"
    fy "Ou seja seduzido para o culto ao diabo por uma súcubo!"

# game/chapters/chapter2/script/ch2sc10.rpy:120
translate brazil ch2sc10_98eef165:

#   sa "Oh lord, Flynn! As if you'd know anything about ladies or their charms."
    sa "Oh, meu Deus, Flynn! Como se você soubesse alguma coisa sobre mulheres ou seus encantos."

# game/chapters/chapter2/script/ch2sc10.rpy:122
translate brazil ch2sc10_c098a18d:

#   mc "Yeah... I’m with Sabrina on this one."
    mc "Sim... concordo com a Sabrina nesse ponto."

# game/chapters/chapter2/script/ch2sc10.rpy:124
translate brazil ch2sc10_3cea89f6:

#   fy "You two are really teaming up on me, huh?"
    fy "Vocês dois estão mesmo se unindo contra mim, né?"

# game/chapters/chapter2/script/ch2sc10.rpy:126
translate brazil ch2sc10_f549edcc:

#   sa "Just like when we were little!"
    sa "Assim como quando éramos crianças!"

# game/chapters/chapter2/script/ch2sc10.rpy:130
translate brazil ch2sc10_3fe410a3:

#   mc "We’ll be at the tavern later if you want to say hello."
    mc "Estaremos na taverna mais tarde, se quiser dar um oi."

# game/chapters/chapter2/script/ch2sc10.rpy:132
translate brazil ch2sc10_b527bcac:

#   fy "Yes! We’ll be there! Right Sabby?"
    fy "Sim! Estaremos lá! Não é, Sabby?"

# game/chapters/chapter2/script/ch2sc10.rpy:134
translate brazil ch2sc10_b97d4237:

#   sa "Ugh! Don’t call me that."
    sa "Eca! Não me chame assim."

# game/chapters/chapter2/script/ch2sc10.rpy:136
translate brazil ch2sc10_f9e2cd2f:

#   sa "Yes, we’ll be there."
    sa "Sim, estaremos lá."

# game/chapters/chapter2/script/ch2sc10.rpy:138
translate brazil ch2sc10_f8c02439:

#   mc "Word of caution, Flynn. If you insult her..."
    mc "Um aviso, Flynn. Se você a insultar..."

# game/chapters/chapter2/script/ch2sc10.rpy:140
translate brazil ch2sc10_2ed5156d:

#   fy "Yeah, yeah. You’ll feed me to the pigs."
    fy "Sim, sim. Você vai me dar de comida para os porcos."

# game/chapters/chapter2/script/ch2sc10.rpy:142
translate brazil ch2sc10_bed0cb87:

#   mc "No. Eliza will whoop your ass herself. She’s tougher than she looks."
    mc "Não. A Eliza vai te dar uma surra pessoalmente. Ela é mais durona do que parece."

# game/chapters/chapter2/script/ch2sc10.rpy:144
translate brazil ch2sc10_dcd3688d:

#   fy "As if a girl could scare me!"
    fy "Como se uma garota pudesse me assustar!"

# game/chapters/chapter2/script/ch2sc10.rpy:147
translate brazil ch2sc10_0dd9568f:

#   "You share a look with Sabrina, the two of you chuckling at Flynn."
    "Você troca um olhar com Sabrina, e as duas riem baixinho do Flynn."

# game/chapters/chapter2/script/ch2sc10.rpy:150
translate brazil ch2sc10_db392313:

#   sa "*Giggles* ..."
    sa "*Risos* ..."

# game/chapters/chapter2/script/ch2sc10.rpy:152
translate brazil ch2sc10_a063d55b:

#   sa "Well, we've gotta get to Arnstead's farm to buy some flour."
    sa "Bem, precisamos ir até a fazenda de Arnstead para comprar farinha."

# game/chapters/chapter2/script/ch2sc10.rpy:153
translate brazil ch2sc10_79290889:

#   sa "We promised to help Mom prepare the bread for tomorrow’s market day."
    sa "Prometemos ajudar a mamãe a preparar o pão para o dia de feira de amanhã."

# game/chapters/chapter2/script/ch2sc10.rpy:155
translate brazil ch2sc10_0c68b8bc:

#   fy "Do we really have to? I’m sure they can handle it without us."
    fy "Será mesmo necessário? Tenho certeza de que eles conseguem lidar com isso sem nós."

# game/chapters/chapter2/script/ch2sc10.rpy:158
translate brazil ch2sc10_cae5ebdd:

#   sa "Flynn!"
    sa "Flynn!"

# game/chapters/chapter2/script/ch2sc10.rpy:160
translate brazil ch2sc10_1169be77:

#   fy "Coming! See ya, cus!"
    fy "Já vou! Até mais, primo!"

# game/chapters/chapter2/script/ch2sc10.rpy:161
translate brazil ch2sc10_2cb145e6:

#   fy "Oh, you should stop by our house cus! Mom and dad would love to know that you're... well, alive?"
    fy "Ah, você devia dar uma passadinha lá em casa, primo! Mamãe e papai adorariam saber que você está... bem, vivo?"

# game/chapters/chapter2/script/ch2sc10.rpy:163
translate brazil ch2sc10_0586993f:

#   mc "Sure... I guess I could pay them a visit."
    mc "Claro... acho que eu poderia fazer uma visita a eles."

# game/chapters/chapter2/script/ch2sc10.rpy:167
translate brazil ch2sc10_7bc44711:

#   fy "Boring."
    fy "Tedioso."

# game/chapters/chapter2/script/ch2sc10.rpy:171
translate brazil ch2sc10_e991b880:

#   fy "So, when can we meet her?"
    fy "Então, quando poderemos conhecê-la?"

# game/chapters/chapter2/script/ch2sc10.rpy:173
translate brazil ch2sc10_2e1a1d7a:

#   mc "Never?"
    mc "Nunca?"

# game/chapters/chapter2/script/ch2sc10.rpy:175
translate brazil ch2sc10_e9eda82a:

#   fy "Oh, come on! If you’re just friends, you won’t mind if I meet her."
    fy "Ah, qual é! Se vocês são apenas amigos, não vai se importar se eu a conhecer."

# game/chapters/chapter2/script/ch2sc10.rpy:177
translate brazil ch2sc10_14a7fafd:

#   fy "I have a duty to make sure my cousin keeps good company."
    fy "Tenho o dever de garantir que meu primo tenha boas companhias."

# game/chapters/chapter2/script/ch2sc10.rpy:179
translate brazil ch2sc10_45c0e1c5:

#   sa "Pfft Flynn... you wouldn’t know good company if it landed on your face and her name was Aphrodite."
    sa "Pfft Flynn... você não reconheceria uma boa companhia nem se ela pousasse na sua cara e se chamasse Afrodite."

# game/chapters/chapter2/script/ch2sc10.rpy:181
translate brazil ch2sc10_284e3b55:

#   mc "Yeah. I’m with Sabrina on this one."
    mc "Sim. Concordo com a Sabrina."

# game/chapters/chapter2/script/ch2sc10.rpy:185
translate brazil ch2sc10_1cce2aa5:

#   sa "Just like when we were younger!"
    sa "Assim como quando éramos mais jovens!"

# game/chapters/chapter2/script/ch2sc10.rpy:195
translate brazil ch2sc10_83ed1f13:

#   mc "Word of caution, Flynn. If you get on her bad side..."
    mc "Um aviso, Flynn. Se você a irritar..."

# game/chapters/chapter2/script/ch2sc10.rpy:197
translate brazil ch2sc10_8c414125:

#   fy "Yeah, yeah, You’ll hang me upside down a tree and let the birds shit on me."
    fy "Sim, sim, você vai me pendurar de cabeça para baixo numa árvore e deixar os pássaros defecarem em mim."

# game/chapters/chapter2/script/ch2sc10.rpy:199
translate brazil ch2sc10_893a08ae:

#   mc "No. Eliza will handle you herself. She enjoys making a fool out of idiots."
    mc "Não. Eliza vai lidar com você pessoalmente. Ela adora fazer papel de bobo com os idiotas."

# game/chapters/chapter2/script/ch2sc10.rpy:207
translate brazil ch2sc10_94b114bc:

#   sa "Well, we've gotta get to Arnstead's farm to buy some flour. We promised to help Mom and Dad prepare the bread for tomorrow’s market day."
    sa "Bem, precisamos ir à fazenda do Arnstead para comprar farinha. Prometemos ajudar a mamãe e o papai a preparar o pão para o dia de feira de amanhã."

# game/chapters/chapter2/script/ch2sc10.rpy:220
translate brazil ch2sc10_3c0be9f8:

#   mct "I was going to pay Gibson a visit, but he should be closing up for the day."
    mct "Eu ia fazer uma visita ao Gibson, mas ele já deve estar fechando por hoje."

# game/chapters/chapter2/script/ch2sc10.rpy:221
translate brazil ch2sc10_8c6196d7:

#   mct "I guess I might as well pay a visit to uncle Shane and aunt Maya."
    mct "Acho que vou aproveitar para fazer uma visita ao tio Shane e à tia Maya."

# game/chapters/chapter2/script/ch2sc10.rpy:222
translate brazil ch2sc10_7a0dd8e4:

#   mct "It feels weird calling them aunt and uncle, when I know they aren't really..."
    mct "É estranho chamá-los de tia e tio, quando sei que na verdade não são..."

# game/chapters/chapter2/script/ch2sc10.rpy:223
translate brazil ch2sc10_dd4b10a4:

#   mct "As for Gibson... I’ll visit you tomorrow before we leave, old bear."
    mct "Quanto a Gibson... Vou te visitar amanhã antes de irmos embora, meu velho."

# game/chapters/chapter2/script/ch2sc10.rpy:232
translate brazil ch2sc10_ce24efa5:

#   sh "What's this? I thought you'd be halfway done with making the bread for tomorrow?"
    sh "O que é isso? Pensei que você já tivesse feito metade do pão para amanhã."

# game/chapters/chapter2/script/ch2sc10.rpy:233
translate brazil ch2sc10_3e631854:

#   my "*Scoffs* I would've been if you had bought the flour yesterday as I asked you... instead you went for ales."
    my "*Risos* Eu teria ficado feliz se você tivesse comprado a farinha ontem, como eu pedi... em vez disso, você foi comprar cerveja."

# game/chapters/chapter2/script/ch2sc10.rpy:235
translate brazil ch2sc10_517e417c:

#   my "So, I'm setting the table while Flynn and Sabrina are heading to Arnstead for some freshly milled flour."
    my "Então, estou arrumando a mesa enquanto Flynn e Sabrina vão até Arnstead comprar farinha moída na hora."

# game/chapters/chapter2/script/ch2sc10.rpy:237
translate brazil ch2sc10_9d6713d9:

#   sh "Ugh... why do you always give me attitude about grabbing a few ales at the tavern?"
    sh "Puxa... por que você sempre me trata com grosseria quando quero tomar umas cervejas na taverna?"

