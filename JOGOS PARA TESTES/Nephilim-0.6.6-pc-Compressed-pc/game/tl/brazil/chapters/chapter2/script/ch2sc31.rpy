# ARQUIVO: game/chapters/chapter2/script/ch2sc31.rpy DIALOGOS: 129


# game/chapters/chapter2/script/ch2sc31.rpy:10
translate brazil ch2sc31_14e25683:

#   "A few moments later... Outside the Rusty spoon tavern..."
    "Poucos instantes depois... Do lado de fora da taverna Rusty Spoon..."

# game/chapters/chapter2/script/ch2sc31.rpy:13
translate brazil ch2sc31_22452e4d:

#   el "I can't believe I got dressed faster than you."
    el "Não acredito que me vesti mais rápido que você."

# game/chapters/chapter2/script/ch2sc31.rpy:14
translate brazil ch2sc31_43127e87:

#   el "You really are a slowpoke sometimes! *Snickers*"
    el "Você é mesmo muito lerdo às vezes! *Risos*"

# game/chapters/chapter2/script/ch2sc31.rpy:16
translate brazil ch2sc31_a0adf119:

#   mc "*Chuckles* I'm not a morning person."
    mc "*Risos* Eu não sou uma pessoa matutina."

# game/chapters/chapter2/script/ch2sc31.rpy:17
translate brazil ch2sc31_d08384db:

#   "Eliza giggles as you make your excuses."
    "Eliza ri baixinho enquanto você inventa suas desculpas."

# game/chapters/chapter2/script/ch2sc31.rpy:19
translate brazil ch2sc31_558232f4:

#   el "Can you believe it?"
    el "Você acredita nisso?"

# game/chapters/chapter2/script/ch2sc31.rpy:21
translate brazil ch2sc31_0dc643e7:

#   mc "Believe what?"
    mc "Acreditar em quê?"

# game/chapters/chapter2/script/ch2sc31.rpy:23
translate brazil ch2sc31_98ae49f8:

#   el "We’re finally going to see the capital!"
    el "Finalmente vamos conhecer a capital!"

# game/chapters/chapter2/script/ch2sc31.rpy:24
translate brazil ch2sc31_6e473e5a:

#   el "I've heard travelers passing through Whitehills talking about it my whole life."
    el "Ouvi viajantes que passaram por Whitehills falando sobre o lugar durante toda a minha vida."

# game/chapters/chapter2/script/ch2sc31.rpy:25
translate brazil ch2sc31_a94468f7:

#   el "I've always been curious to see it myself."
    el "Sempre tive curiosidade de ver isso com meus próprios olhos."

# game/chapters/chapter2/script/ch2sc31.rpy:27
translate brazil ch2sc31_b8169885:

#   el "Just imagine all the things to see, or the places to visit..."
    el "Imagine só todas as coisas para ver, ou os lugares para visitar..."

# game/chapters/chapter2/script/ch2sc31.rpy:28
translate brazil ch2sc31_21a2a49e:

#   el "All within one large city! Shopkeepers for every item you can imagine."
    el "Tudo isso em uma única cidade enorme! Lojistas que vendem de tudo que você possa imaginar."

# game/chapters/chapter2/script/ch2sc31.rpy:30
translate brazil ch2sc31_5ceca2be:

#   el "Multiple taverns spread across the city."
    el "Diversas tabernas estão espalhadas pela cidade."

# game/chapters/chapter2/script/ch2sc31.rpy:31
translate brazil ch2sc31_5a4ab935:

#   el "Several marketplaces within walking distance!"
    el "Diversos mercados a uma curta distância a pé!"

# game/chapters/chapter2/script/ch2sc31.rpy:32
translate brazil ch2sc31_9951f045:

#   el "Grand buildings and architecture... I want to see it all!"
    el "Prédios grandiosos e arquitetura deslumbrante... Quero ver tudo!"

# game/chapters/chapter2/script/ch2sc31.rpy:34
translate brazil ch2sc31_4ac1585d:

#   el "Grand libraries, bathhouses, gardens, guilds, schools, anything we can imagine!"
    el "Grandes bibliotecas, casas de banho, jardins, guildas, escolas, tudo o que pudermos imaginar!"

# game/chapters/chapter2/script/ch2sc31.rpy:36
translate brazil ch2sc31_3fa8da69:

#   mc "When you say it like that, it does sound promising."
    mc "Dito assim, parece promissor."

# game/chapters/chapter2/script/ch2sc31.rpy:37
translate brazil ch2sc31_4e3b4d7d:

#   mc "But let’s not get ahead of ourselves. Oftentimes, places don’t live up to their reputation."
    mc "Mas não vamos nos precipitar. Muitas vezes, os lugares não correspondem à sua reputação."

# game/chapters/chapter2/script/ch2sc31.rpy:39
translate brazil ch2sc31_f14357d4:

#   el "I’m aware. I only hope it will be, at the very least, a tiny portion of what I’ve been told."
    el "Estou ciente. Só espero que seja, ao menos, uma pequena parte do que me disseram."

# game/chapters/chapter2/script/ch2sc31.rpy:41
translate brazil ch2sc31_84a46232:

#   mc "I’m sure it will be, Eliza."
    mc "Tenho certeza que sim, Eliza."

# game/chapters/chapter2/script/ch2sc31.rpy:42
translate brazil ch2sc31_233bdbdf:

#   mc "Either way, we’ll find out soon enough."
    mc "De qualquer forma, descobriremos em breve."

# game/chapters/chapter2/script/ch2sc31.rpy:44
translate brazil ch2sc31_62ad996c:

#   el "Yes! Let’s gooo!"
    el "Sim! Vamos lá!"

# game/chapters/chapter2/script/ch2sc31.rpy:45
translate brazil ch2sc31_9aff929d:

#   el "Go go go! Luxenford here we come! *Giggling*"
    el "Vamos lá, vamos lá, vamos! Luxenford, aí vamos nós! *Risos*"

# game/chapters/chapter2/script/ch2sc31.rpy:47
translate brazil ch2sc31_adf0ab20:

#   mc "Hey, slow down you weirdo!"
    mc "Ei, calma aí, seu esquisito!"

# game/chapters/chapter2/script/ch2sc31.rpy:48
translate brazil ch2sc31_54e1e8b1:

#   mc "There’s something I wanted to talk to you about."
    mc "Tem algo sobre o qual eu queria conversar com você."

# game/chapters/chapter2/script/ch2sc31.rpy:52
translate brazil ch2sc31_6f6b296c:

#   "Eliza swiftly rushes to you."
    "Eliza corre rapidamente em sua direção."

# game/chapters/chapter2/script/ch2sc31.rpy:56
translate brazil ch2sc31_d2247581:

#   el "Are you finally asking me on a date?"
    el "Você finalmente vai me convidar para sair?"

# game/chapters/chapter2/script/ch2sc31.rpy:58
translate brazil ch2sc31_cc761816:

#   mc "No..."
    mc "Não..."

# game/chapters/chapter2/script/ch2sc31.rpy:59
translate brazil ch2sc31_b57db637:

#   mc "And you might wanna put your wedding dress back in the closet."
    mc "E talvez seja melhor guardar o vestido de noiva no armário."

# game/chapters/chapter2/script/ch2sc31.rpy:61
translate brazil ch2sc31_5ffbb883:

#   el "You been picturing me in a wedding dress, huh?"
    el "Você estava me imaginando de vestido de noiva, né?"

# game/chapters/chapter2/script/ch2sc31.rpy:62
translate brazil ch2sc31_9feae55b:

#   el "Admit it!"
    el "Admita!"

# game/chapters/chapter2/script/ch2sc31.rpy:64
translate brazil ch2sc31_1f84f540:

#   mc "*Chuckles* You wish."
    mc "*Risos* Quem dera."

# game/chapters/chapter2/script/ch2sc31.rpy:65
translate brazil ch2sc31_4bde9e06:

#   mc "Though I'm sure you'd look stunning in one."
    mc "Embora eu tenha certeza de que você ficaria deslumbrante em um deles."

# game/chapters/chapter2/script/ch2sc31.rpy:67
translate brazil ch2sc31_16beb768:

#   elt "You bet I would! Maybe you'll see, one day."
    elt "Pode apostar que sim! Talvez você veja, um dia."

# game/chapters/chapter2/script/ch2sc31.rpy:69
translate brazil ch2sc31_bb6a3445:

#   mc "As I was saying..."
    mc "Como eu estava dizendo..."

# game/chapters/chapter2/script/ch2sc31.rpy:70
translate brazil ch2sc31_93f0320e:

#   mc "You know there are different guilds and factions in the capital, yeah?"
    mc "Você sabe que existem diferentes guildas e facções na capital, né?"

# game/chapters/chapter2/script/ch2sc31.rpy:72
translate brazil ch2sc31_c6580c41:

#   el "Uh, sure? I’ve read about them. Let’s see... there’s the Mages Guild."
    el "Hum, claro? Já li sobre eles. Deixa eu ver... tem a Guilda dos Magos."

# game/chapters/chapter2/script/ch2sc31.rpy:73
translate brazil ch2sc31_a559a372:

#   el "The uhm, Mercenaries Guild. The, the... the Adventurers Guild."
    el "A... Guilda dos Mercenários. A... a Guilda dos Aventureiros."

# game/chapters/chapter2/script/ch2sc31.rpy:74
translate brazil ch2sc31_eae4da3e:

#   el "Uh, err... Oh, yes! The Academy of Learning, for scholars, herbalists and various other studies."
    el "Hum, err... Ah, sim! A Academia de Aprendizagem, para estudiosos, herbalistas e diversas outras áreas de estudo."

# game/chapters/chapter2/script/ch2sc31.rpy:75
translate brazil ch2sc31_a9d31edf:

#   el "Those are the ones I can recall off the top of my head."
    el "Essas são as que me vêm à mente de cabeça."

# game/chapters/chapter2/script/ch2sc31.rpy:77
translate brazil ch2sc31_d741d5b1:

#   mc "Pretty good, Eliza. Most people only know one or two of them. People tend to just focus on the one they want to join."
    mc "Muito bom, Eliza. A maioria das pessoas só conhece uma ou duas delas. As pessoas tendem a se concentrar apenas naquela em que querem entrar."

# game/chapters/chapter2/script/ch2sc31.rpy:79
translate brazil ch2sc31_9ecf0752:

#   el "Thank you! I like knowing about my options before I choose something."
    el "Obrigada! Gosto de conhecer minhas opções antes de escolher algo."

# game/chapters/chapter2/script/ch2sc31.rpy:81
translate brazil ch2sc31_c71653f4:

#   mc "That’s a good way to look at it."
    mc "Essa é uma boa maneira de ver as coisas."

# game/chapters/chapter2/script/ch2sc31.rpy:82
translate brazil ch2sc31_a2d81581:

#   mc "There’s also the Seafarers Guild that Flynn wants to join."
    mc "Existe também a Guilda dos Marinheiros, à qual Flynn deseja se juntar."

# game/chapters/chapter2/script/ch2sc31.rpy:84
translate brazil ch2sc31_c4cd76d8:

#   el "Oh, yeah! Dammit! I totally forgot. *Sigh*"
    el "Ah, é mesmo! Droga! Eu tinha esquecido completamente. *Suspiro*"

# game/chapters/chapter2/script/ch2sc31.rpy:86
translate brazil ch2sc31_68f7a21a:

#   el "He even mentioned it several times when we were at Riverside."
    el "Ele até mencionou isso várias vezes quando estávamos em Riverside."

# game/chapters/chapter2/script/ch2sc31.rpy:88
translate brazil ch2sc31_cde6a65f:

#   mc "I bet. That's been his dream for as long I can remember."
    mc "Acho que sim. Esse é o sonho dele desde que me lembro."

# game/chapters/chapter2/script/ch2sc31.rpy:90
translate brazil ch2sc31_6135bad4:

#   mc "There’s also the Craftsmanship Guild, for people who wish to learn trade skills. Oh, and the last one I know of..."
    mc "Existe também a Guilda de Artesãos, para quem deseja aprender habilidades profissionais. Ah, e a última que eu conheço..."

# game/chapters/chapter2/script/ch2sc31.rpy:91
translate brazil ch2sc31_d04d88a3:

#   mc "The Merchants Guild for anything related to finances."
    mc "A Guilda dos Mercadores para tudo relacionado a finanças."

# game/chapters/chapter2/script/ch2sc31.rpy:93
translate brazil ch2sc31_e3d554e6:

#   el "Heavens! That’s a lot of different choices... which one should we pick?"
    el "Nossa! São muitas opções diferentes... qual devemos escolher?"

# game/chapters/chapter2/script/ch2sc31.rpy:95
translate brazil ch2sc31_9df415c4:

#   mc "We’ll join the Adventurers Guild."
    mc "Vamos nos juntar à Guilda dos Aventureiros."

# game/chapters/chapter2/script/ch2sc31.rpy:97
translate brazil ch2sc31_d8f05838:

#   el "Uh, uh! I was hoping you would say that!"
    el "Ah, ah! Eu esperava que você dissesse isso!"

# game/chapters/chapter2/script/ch2sc31.rpy:98
translate brazil ch2sc31_679c7f27:

#   el "That one definitely appeals the most to me!"
    el "Essa com certeza é a que mais me agrada!"

# game/chapters/chapter2/script/ch2sc31.rpy:100
translate brazil ch2sc31_c456296f:

#   mc "Same, and it also happens to be the guild that your father asked me to seek out."
    mc "Igualmente, e por acaso é a guilda que seu pai me pediu para procurar."

# game/chapters/chapter2/script/ch2sc31.rpy:102
translate brazil ch2sc31_9c2e90d1:

#   el "My father? How come?"
    el "Meu pai? Como assim?"

# game/chapters/chapter2/script/ch2sc31.rpy:103
translate brazil ch2sc31_a60ccdcb:

#   el "Father never mentioned he'd been part of a guild, only that he was a graduate from the Knight's academy."
    el "Meu pai nunca mencionou que havia feito parte de uma guilda, apenas que era formado na academia de cavaleiros."

# game/chapters/chapter2/script/ch2sc31.rpy:105
translate brazil ch2sc31_e14a1c3a:

#   mc "Apparently your father used to be buddies with their leader, a man named Dalen."
    mc "Aparentemente, seu pai era amigo do líder deles, um homem chamado Dalen."

# game/chapters/chapter2/script/ch2sc31.rpy:106
translate brazil ch2sc31_fe446f9b:

#   mc "I think they graduated together as knights."
    mc "Acho que eles se formaram juntos como cavaleiros."

# game/chapters/chapter2/script/ch2sc31.rpy:108
translate brazil ch2sc31_b3a817ef:

#   el "Hmm... Dalen. Dalen... Hmm."
    el "Hum... O vale. O vale... Hum."

# game/chapters/chapter2/script/ch2sc31.rpy:109
translate brazil ch2sc31_426cc14a:

#   el "No, I haven’t heard of him before."
    el "Não, nunca ouvi falar dele."

# game/chapters/chapter2/script/ch2sc31.rpy:111
translate brazil ch2sc31_49666e5a:

#   mc "Maybe he didn’t keep contact after you were born... Settling down with a wife and child so far from the capital..."
    mc "Talvez ele tenha perdido o contato depois que você nasceu... Constituindo família, com esposa e filho, tão longe da capital..."

# game/chapters/chapter2/script/ch2sc31.rpy:112
translate brazil ch2sc31_11069e67:

#   mc "Makes it hard to keep contact. Life just happens."
    mc "Isso dificulta manter contato. A vida simplesmente acontece."

# game/chapters/chapter2/script/ch2sc31.rpy:114
translate brazil ch2sc31_8fa44ad4:

#   el "You’re right."
    el "Você tem razão."

# game/chapters/chapter2/script/ch2sc31.rpy:115
translate brazil ch2sc31_f6777425:

#   el "Father never really talked about his past before he met my mother. All I knew is that he-"
    el "Meu pai nunca falava muito sobre o passado dele antes de conhecer minha mãe. Tudo o que eu sabia era que ele..."

# game/chapters/chapter2/script/ch2sc31.rpy:117
translate brazil ch2sc31_e55f079a:

#   mc "He used to live in the capital, he told me."
    mc "Ele costumava morar na capital, me contou."

# game/chapters/chapter2/script/ch2sc31.rpy:119
translate brazil ch2sc31_ce89b3be:

#   el "Right... Sometimes I feel like you know him better than me."
    el "Certo... Às vezes tenho a impressão de que você o conhece melhor do que eu."

# game/chapters/chapter2/script/ch2sc31.rpy:121
translate brazil ch2sc31_f23dcd22:

#   mc "I think we just knew different sides of him."
    mc "Acho que simplesmente conhecíamos lados diferentes dele."

# game/chapters/chapter2/script/ch2sc31.rpy:122
translate brazil ch2sc31_54ee233d:

#   mc "To you he was a loving father, to me he was a strict mentor."
    mc "Para você ele era um pai amoroso, para mim ele era um mentor rigoroso."

# game/chapters/chapter2/script/ch2sc31.rpy:124
translate brazil ch2sc31_3c42213b:

#   mc "The roles can seem similar, but they are different at the core."
    mc "Os papéis podem parecer semelhantes, mas são diferentes na essência."

# game/chapters/chapter2/script/ch2sc31.rpy:126
translate brazil ch2sc31_50f77baf:

#   elt "Sometimes it surprises me how understanding [mc] is."
    elt "Às vezes me surpreende o quão compreensivo é. [mc] é."

# game/chapters/chapter2/script/ch2sc31.rpy:127
translate brazil ch2sc31_c4a8ee5d:

#   elt "He clearly experienced a lot of different things traveling with father."
    elt "Ele claramente vivenciou muitas coisas diferentes viajando com o pai."

# game/chapters/chapter2/script/ch2sc31.rpy:128
translate brazil ch2sc31_d601f4eb:

#   elt "Maybe that's why he seems so mature for his age? He was thrown off the deep end from early on in life."
    elt "Talvez seja por isso que ele parece tão maduro para a idade? Ele foi jogado na fogueira desde muito cedo na vida."

# game/chapters/chapter2/script/ch2sc31.rpy:130
translate brazil ch2sc31_ca378af5:

#   mc "You listening?"
    mc "Você está me ouvindo?"

# game/chapters/chapter2/script/ch2sc31.rpy:134
translate brazil ch2sc31_16d1c066:

#   el "Huh? Oh, yeah definitely! *Snickers*"
    el "Hã? Ah, sim, com certeza! *Risos*"

# game/chapters/chapter2/script/ch2sc31.rpy:136
translate brazil ch2sc31_6fa4ec7e:

#   mc "So you’re okay with paying for our meals until we get accepted by the guild?"
    mc "Então você concorda em pagar nossas refeições até sermos aceitos pela guilda?"

# game/chapters/chapter2/script/ch2sc31.rpy:139
translate brazil ch2sc31_46d5103d:

#   el "{b}Wait! What!?{/b}"
    el "{b}Espera! O quê!?{/b}"

# game/chapters/chapter2/script/ch2sc31.rpy:140
translate brazil ch2sc31_8dba75b6:

#   el "[mc]-I... you know I don't have any coin!"
    el "[mc]-Eu... você sabe que eu não tenho nenhum dinheiro!"

# game/chapters/chapter2/script/ch2sc31.rpy:142
translate brazil ch2sc31_07cff5a4:

#   mc "Relax, no need to have a meltdown."
    mc "Relaxa, não precisa ter um ataque de nervos."

# game/chapters/chapter2/script/ch2sc31.rpy:143
translate brazil ch2sc31_08ca34ac:

#   mc "It was obvious you weren’t listening."
    mc "Era óbvio que você não estava prestando atenção."

# game/chapters/chapter2/script/ch2sc31.rpy:145
translate brazil ch2sc31_5afbe787:

#   el "Oh, heh-heh! Busted."
    el "Ah, hehe! Fui pego."

# game/chapters/chapter2/script/ch2sc31.rpy:146
translate brazil ch2sc31_99245722:

#   el "So what were you saying?"
    el "Então, o que você estava dizendo?"

# game/chapters/chapter2/script/ch2sc31.rpy:148
translate brazil ch2sc31_d3f5ea12:

#   mc "We’ll sign up with the Adventurers Guild first thing when we reach the capital."
    mc "Assim que chegarmos à capital, nos inscreveremos na Guilda dos Aventureiros."

# game/chapters/chapter2/script/ch2sc31.rpy:149
translate brazil ch2sc31_67cc0c6e:

#   mc "They provide housing for recruits."
    mc "Eles fornecem alojamento para os recrutas."

# game/chapters/chapter2/script/ch2sc31.rpy:151
translate brazil ch2sc31_03348be0:

#   el "Yay! That is music to my butt! Finally a permanent place to sleep."
    el "Eba! Isso é música para os meus ouvidos! Finalmente um lugar permanente para dormir."

# game/chapters/chapter2/script/ch2sc31.rpy:153
translate brazil ch2sc31_008fbb74:

#   mc "One piece of happy butt coming right up."
    mc "Um pedaço de bumbum feliz a caminho."

# game/chapters/chapter2/script/ch2sc31.rpy:156
translate brazil ch2sc31_d80aa774:

#   el "*Giggling* You bet!"
    el "*Risos* Pode apostar!"

# game/chapters/chapter2/script/ch2sc31.rpy:158
translate brazil ch2sc31_71223d5d:

#   mc "Yeah, that didn’t sound right."
    mc "É, isso não soou bem."

# game/chapters/chapter2/script/ch2sc31.rpy:160
translate brazil ch2sc31_9f7cfc6e:

#   el "I appreciate the effort, though!"
    el "Agradeço o esforço!"

# game/chapters/chapter2/script/ch2sc31.rpy:161
translate brazil ch2sc31_e18ecf93:

#   el "You like to call me weird but you're just as weird!"
    el "Você gosta de me chamar de esquisito, mas você é tão esquisito quanto eu!"

# game/chapters/chapter2/script/ch2sc31.rpy:163
translate brazil ch2sc31_04e9f4df:

#   mc "Shut up."
    mc "Cale-se."

# game/chapters/chapter2/script/ch2sc31.rpy:164
translate brazil ch2sc31_e8266003:

#   el "*Giggling* The truth stings like a wasp!"
    el "*Risos* A verdade dói como uma picada de vespa!"

# game/chapters/chapter2/script/ch2sc31.rpy:165
translate brazil ch2sc31_75694f54:

#   mc "*Chuckles* ..."
    mc "*Risos* ..."

# game/chapters/chapter2/script/ch2sc31.rpy:172
translate brazil ch2sc31_ec9961a6:

#   el "[mc]..."
    el "[mc]..."

# game/chapters/chapter2/script/ch2sc31.rpy:176
translate brazil ch2sc31_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/chapters/chapter2/script/ch2sc31.rpy:179
translate brazil ch2sc31_fa2f46f5:

#   el "Look! {b}Look!!{/b}"
    el "Olhar! {b} Olhar!!{/b}"

# game/chapters/chapter2/script/ch2sc31.rpy:187
translate brazil ch2sc31_273fa2d0:

#   mc "Woah."
    mc "Uau."

# game/chapters/chapter2/script/ch2sc31.rpy:188
translate brazil ch2sc31_1a9f952d:

#   el "Yeah... woah."
    el "É... uau."

# game/chapters/chapter2/script/ch2sc31.rpy:190
translate brazil ch2sc31_f6228477:

#   el "We... We made it, [mc]!"
    el "Nós... Nós conseguimos! [mc]!"

# game/chapters/chapter2/script/ch2sc31.rpy:191
translate brazil ch2sc31_43b4012b:

#   el "Together."
    el "Junto."

# game/chapters/chapter2/script/ch2sc31.rpy:193
translate brazil ch2sc31_08b5cfad:

#   mc "We sure did."
    mc "Com certeza."

# game/chapters/chapter2/script/ch2sc31.rpy:195
translate brazil ch2sc31_2a576456:

#   mc "I’m glad you’re here with me, Eliza."
    mc "Que bom que você está aqui comigo, Eliza."

# game/chapters/chapter2/script/ch2sc31.rpy:196
translate brazil ch2sc31_a756c69b:

#   mc "It wouldn't be the same with anyone else."
    mc "Com qualquer outra pessoa, não seria a mesma coisa."

# game/chapters/chapter2/script/ch2sc31.rpy:198
translate brazil ch2sc31_53d70134:

#   el "Me too."
    el "Eu também."

# game/chapters/chapter2/script/ch2sc31.rpy:199
translate brazil ch2sc31_60bf319c:

#   el "I wouldn’t want to experience this with anyone else!"
    el "Eu não gostaria de passar por isso com mais ninguém!"

# game/chapters/chapter2/script/ch2sc31.rpy:205
translate brazil ch2sc31_4fcb465e:

#   "Eliza will remember this moment, Eliza’s trust has increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Eliza se lembrará deste momento, a confiança de Eliza aumentou em {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc31.rpy:207
translate brazil ch2sc31_9ef61fb8:

#   el "We really made it, didn’t we?"
    el "Nós realmente conseguimos, não é?"

# game/chapters/chapter2/script/ch2sc31.rpy:209
translate brazil ch2sc31_7968b2ef:

#   mc "We did. The journey here was quite something... but I enjoyed it, thanks to you."
    mc "Sim, fizemos. A viagem até aqui foi algo e tanto... mas eu gostei, graças a você."

# game/chapters/chapter2/script/ch2sc31.rpy:214
translate brazil ch2sc31_2bcc5f31:

#   el "You’re just saying that 'cause you like kissing me."
    el "Você só está dizendo isso porque gosta de me beijar."

# game/chapters/chapter2/script/ch2sc31.rpy:216
translate brazil ch2sc31_a66faed3:

#   mc "Believe it or not, but you’re not the worst company in the world, Eliza."
    mc "Acredite ou não, mas você não é a pior empresa do mundo, Eliza."

# game/chapters/chapter2/script/ch2sc31.rpy:219
translate brazil ch2sc31_5ad9f0b0:

#   mc "And yes, I do like kissing you."
    mc "E sim, eu gosto de te beijar."

# game/chapters/chapter2/script/ch2sc31.rpy:223
translate brazil ch2sc31_66541155:

#   el "Then what are you waiting for?"
    el "Então, o que você está esperando?"

# game/chapters/chapter2/script/ch2sc31.rpy:224
translate brazil ch2sc31_1ae84c77:

#   el "Give your little kitten a kiss!"
    el "Dê um beijinho no seu gatinho!"

# game/chapters/chapter2/script/ch2sc31.rpy:227
translate brazil ch2sc31_6eb38551:

#   mc "Come here, you little minx."
    mc "Vem cá, sua pestinha."

# game/chapters/chapter2/script/ch2sc31.rpy:228
translate brazil ch2sc31_39f68238:

#   el "*Squeals excitedly* Aiiyh! [mc]!"
    el "*Grita de alegria* Aiiyh! [mc]!"

# game/chapters/chapter2/script/ch2sc31.rpy:230
translate brazil ch2sc31_7746549b:

#   el "Y-You're squeezing my ass."
    el "V-Você está apertando minha bunda."

# game/chapters/chapter2/script/ch2sc31.rpy:231
translate brazil ch2sc31_d782de91:

#   el "MMmhh..."
    el "Hum..."

# game/chapters/chapter2/script/ch2sc31.rpy:233
translate brazil ch2sc31_931c4e81:

#   mc "Guilty as charged. What's your verdict, miss?"
    mc "Culpada, sem sombra de dúvida. Qual é o seu veredicto, senhorita?"

# game/chapters/chapter2/script/ch2sc31.rpy:235
translate brazil ch2sc31_6a48b675:

#   el "It's definitely a serious crime. But in your case..."
    el "É definitivamente um crime grave. Mas no seu caso..."

# game/chapters/chapter2/script/ch2sc31.rpy:236
translate brazil ch2sc31_e414bef5:

#   el "I think a kiss will get you off the hook."
    el "Acho que um beijo vai te livrar dessa enrascada."

# game/chapters/chapter2/script/ch2sc31.rpy:239
translate brazil ch2sc31_d7edd024:

#   "."
    "."

# game/chapters/chapter2/script/ch2sc31.rpy:240
translate brazil ch2sc31_8dabefc6:

#   ".."
    "..."

# game/chapters/chapter2/script/ch2sc31.rpy:262
translate brazil ch2sc31_21ded4bf:

#   "Eliza appreciates the enthusiasm, Eliza’s trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Eliza aprecia o entusiasmo, a confiança de Eliza aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc31.rpy:263
translate brazil ch2sc31_e1833d05:

#   el "I’m so proud of us!"
    el "Estou muito orgulhosa de nós!"

# game/chapters/chapter2/script/ch2sc31.rpy:264
translate brazil ch2sc31_86d58206:

#   mc "We did good. I’m glad to have a friend like you, Eliza."
    mc "Nos saímos bem. Fico feliz por ter uma amiga como você, Eliza."

# game/chapters/chapter2/script/ch2sc31.rpy:265
translate brazil ch2sc31_cc84f89a:

#   el "Me too, [mc]. If you hadn’t come along, I'd still be scrounging around the forest near my village, looking for mushrooms and plants."
    el "Eu também, [mc] Se você não tivesse vindo, eu ainda estaria vasculhando a floresta perto da minha aldeia, procurando cogumelos e plantas."

# game/chapters/chapter2/script/ch2sc31.rpy:266
translate brazil ch2sc31_85e1ba21:

#   mc "And my road here would have been so much more tedious without your company."
    mc "E minha jornada até aqui teria sido muito mais tediosa sem a sua companhia."

# game/chapters/chapter2/script/ch2sc31.rpy:267
translate brazil ch2sc31_30078b57:

#   el "We make a great team!"
    el "Formamos uma ótima equipe!"

# game/chapters/chapter2/script/ch2sc31.rpy:268
translate brazil ch2sc31_838852b0:

#   mc "We sure do."
    mc "Com certeza."

# game/chapters/chapter2/script/ch2sc31.rpy:269
translate brazil ch2sc31_2015de3f:

#   el "Okay, let's go see what Luxenford is all about!"
    el "Ok, vamos ver o que Luxenford tem para oferecer!"

