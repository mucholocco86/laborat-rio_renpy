# ARQUIVO: game/chapters/chapter2/script/ch2sc23.rpy DIALOGOS: 150


# game/chapters/chapter2/script/ch2sc23.rpy:10
translate brazil ch2sc23_32a2f43f:

#   "You head over to investigate the noise."
    "Você se dirige para investigar o barulho."

# game/chapters/chapter2/script/ch2sc23.rpy:12
translate brazil ch2sc23_a7b593ab:

#   uk "Where did I put the bloody thing!"
    uk "Onde foi que eu coloquei essa coisa maldita?!"

# game/chapters/chapter2/script/ch2sc23.rpy:25
translate brazil ch2sc23_21c6e60f:

#   uk "Blasted!"
    uk "Droga!"

# game/chapters/chapter2/script/ch2sc23.rpy:27
translate brazil ch2sc23_5f89e63d:

#   uk "I just had it! A small bump on this rock and it's gone?! Arh!"
    uk "Eu tinha acabado de conseguir! Um pequeno impacto nessa pedra e já era?! Argh!"

# game/chapters/chapter2/script/ch2sc23.rpy:29
translate brazil ch2sc23_9d1ce00a:

#   el "*Whispers* {size=-10}{b}Should we say hi?{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Devemos cumprimentá-lo?{/b}{/size}"

# game/chapters/chapter2/script/ch2sc23.rpy:31
translate brazil ch2sc23_9769f75c:

#   mc "Sure, go for it."
    mc "Claro, vá em frente."

# game/chapters/chapter2/script/ch2sc23.rpy:34
translate brazil ch2sc23_de0696cb:

#   uk "{b}BLASTED!{/b} Tis not here! Me wife will skin me hide for this!"
    uk "{b}DESTRUÍDO!{/b} Não está aqui! Minha esposa vai me matar por isso!"

# game/chapters/chapter2/script/ch2sc23.rpy:36
translate brazil ch2sc23_dbca7a34:

#   el "Uhm... Hi, sir."
    el "Hum... Olá, senhor."

# game/chapters/chapter2/script/ch2sc23.rpy:38
translate brazil ch2sc23_cab3389d:

#   uk "Who are ye? What do ye want?"
    uk "Quem são vocês? O que vocês querem?"

# game/chapters/chapter2/script/ch2sc23.rpy:40
translate brazil ch2sc23_eaf2705e:

#   el "We-"
    el "Nós-"

# game/chapters/chapter2/script/ch2sc23.rpy:43
translate brazil ch2sc23_9a99ab5f:

#   uk "Arrgh! Don’t bother me with yer squabbles!"
    uk "Argh! Não me incomode com suas briguinhas!"

# game/chapters/chapter2/script/ch2sc23.rpy:45
translate brazil ch2sc23_6969fba5:

#   mc "Looks like you lost something?"
    mc "Parece que você perdeu alguma coisa?"

# game/chapters/chapter2/script/ch2sc23.rpy:46
translate brazil ch2sc23_a198e7b3:

#   mc "Maybe we can help?"
    mc "Talvez possamos ajudar?"

# game/chapters/chapter2/script/ch2sc23.rpy:48
translate brazil ch2sc23_4865bfe1:

#   uk "Bloody arse, stick! Ha! Ye help me?"
    uk "Que droga, pau! Ha! Você me ajuda?"

# game/chapters/chapter2/script/ch2sc23.rpy:50
translate brazil ch2sc23_aea3c4a2:

#   uk "I know yer kind, lad! Ye’d just as soon rob me as help me!"
    uk "Eu conheço o seu tipo, rapaz! Você preferiria me roubar a me ajudar!"

# game/chapters/chapter2/script/ch2sc23.rpy:52
translate brazil ch2sc23_53ec9e95:

#   mc "*Sigh* Hey, Eliza... Let’s search the nearby area and see if we can find anything out of the ordinary."
    mc "*Suspiro* Ei, Eliza... Vamos dar uma olhada por perto e ver se encontramos algo fora do comum."

# game/chapters/chapter2/script/ch2sc23.rpy:54
translate brazil ch2sc23_097d2f0d:

#   el "Uh, okay! Anything out of the ordinary... anything."
    el "Ah, ok! Qualquer coisa fora do comum... qualquer coisa."

# game/chapters/chapter2/script/ch2sc23.rpy:58
translate brazil ch2sc23_8132edb7:

#   el "This won’t be easy..."
    el "Isso não será fácil..."

# game/chapters/chapter2/script/ch2sc23.rpy:59
translate brazil ch2sc23_6d082765:

#   el "We don’t even know what to look for!"
    el "Nem sequer sabemos o que procurar!"

# game/chapters/chapter2/script/ch2sc23.rpy:61
translate brazil ch2sc23_30fba48e:

#   el "I’m surprised you even want to help this guy?"
    el "Estou surpreso que você queira ajudar esse cara?"

# game/chapters/chapter2/script/ch2sc23.rpy:62
translate brazil ch2sc23_28bd3406:

#   el "He was very rude to us."
    el "Ele foi muito grosseiro conosco."

# game/chapters/chapter2/script/ch2sc23.rpy:64
translate brazil ch2sc23_f3eb8ab0:

#   mc "I think he's just worked himself up in frustration, dwarves tend to get a little overzealous."
    mc "Acho que ele simplesmente se irritou demais; anões tendem a ser um pouco zelosos demais."

# game/chapters/chapter2/script/ch2sc23.rpy:65
translate brazil ch2sc23_2d97df94:

#   el "Oh, I've never met a dwarf before... have you?"
    el "Ah, eu nunca conheci um anão antes... você já?"

# game/chapters/chapter2/script/ch2sc23.rpy:66
translate brazil ch2sc23_aa37b231:

#   mc "Mmh, just a couple. C'mon, let's search this area."
    mc "Hum, só mais um pouco. Vamos lá, vamos procurar nessa área."

# game/chapters/chapter2/script/ch2sc23.rpy:68
translate brazil ch2sc23_5701d281:

#   "You and Eliza search the area for anything that isn't 'natural'."
    "Você e Eliza vasculham a área em busca de qualquer coisa que não seja 'natural'."

# game/chapters/chapter2/script/ch2sc23.rpy:77
translate brazil ch2sc23_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter2/script/ch2sc23.rpy:78
translate brazil ch2sc23_d1ddaffa:

#   "........"
    "........"

# game/chapters/chapter2/script/ch2sc23.rpy:82
translate brazil ch2sc23_f847abe0:

#   mc "Hey, check this out."
    mc "Ei, dá uma olhada nisso."

# game/chapters/chapter2/script/ch2sc23.rpy:85
translate brazil ch2sc23_0f601c47:

#   mc "You present Eliza with your find, a silver-crested ring."
    mc "Você entrega a Eliza sua descoberta, um anel com brasão de prata."

# game/chapters/chapter2/script/ch2sc23.rpy:88
translate brazil ch2sc23_768990a4:

#   mc "There’s something strange about it, though."
    mc "Há algo de estranho nisso, no entanto."

# game/chapters/chapter2/script/ch2sc23.rpy:89
translate brazil ch2sc23_5dd97c02:

#   mc "I can feel slight magical vibrations from it... it could be enchanted."
    mc "Consigo sentir leves vibrações mágicas emanando dele... talvez esteja encantado."

# game/chapters/chapter2/script/ch2sc23.rpy:90
translate brazil ch2sc23_5cd25ef9:

#   mc "But... this would be expensive, way too expensive for a traveling merchant."
    mc "Mas... isso seria caro, muito caro para um comerciante viajante."

# game/chapters/chapter2/script/ch2sc23.rpy:91
translate brazil ch2sc23_d245b009:

#   el "Not to mention the size of it... that wouldn't fit his dwarven fingers."
    el "Sem falar no tamanho... aquilo não caberia nos dedos anão dele."

# game/chapters/chapter2/script/ch2sc23.rpy:93
translate brazil ch2sc23_2670afe9:

#   el "But that has to be what he’s looking for, right?"
    el "Mas deve ser isso que ele está procurando, certo?"

# game/chapters/chapter2/script/ch2sc23.rpy:94
translate brazil ch2sc23_508f8408:

#   el "No other reason something shiny like this would be laying around, especially right in the area?"
    el "Não há outra razão para algo tão brilhante estar por aí, especialmente nesta área?"

# game/chapters/chapter2/script/ch2sc23.rpy:96
translate brazil ch2sc23_52a85b67:

#   mc "Mhh. That’s what I’m thinking."
    mc "Hum. É exatamente o que eu estou pensando."

# game/chapters/chapter2/script/ch2sc23.rpy:97
translate brazil ch2sc23_fed5905e:

#   mc "Now we have a decision to make... do we keep it or do we return it?"
    mc "Agora temos que tomar uma decisão... ficamos com ele ou o devolvemos?"

# game/chapters/chapter2/script/ch2sc23.rpy:101
translate brazil ch2sc23_702ceed1:

#   el "Uhh... I'm leaning towards returning it to him, but you decide! I'll follow your lead."
    el "Hum... Estou mais inclinado a devolver para ele, mas você decide! Vou seguir sua sugestão."

# game/chapters/chapter2/script/ch2sc23.rpy:108
translate brazil ch2sc23_c85b3559:

#   "{color=#87e1fa}Light morality{/color} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "{color=#87e1fa}Moralidade leve{/color} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc23.rpy:110
translate brazil ch2sc23_123bd152:

#   mc "Hey, listen. We found something. It might be yours."
    mc "Ei, escuta. Encontramos alguma coisa. Pode ser sua."

# game/chapters/chapter2/script/ch2sc23.rpy:112
translate brazil ch2sc23_e18190b5:

#   uk "Hrrm. What? Yer still here?"
    uk "Hum. O quê? Você ainda está aqui?"

# game/chapters/chapter2/script/ch2sc23.rpy:114
translate brazil ch2sc23_963190b0:

#   mc "Just take a look."
    mc "Dê uma olhada."

# game/chapters/chapter2/script/ch2sc23.rpy:116
translate brazil ch2sc23_862c7bf2:

#   uk "This could be a trick! Aye... ye be trying to fool me and rob me!"
    uk "Isso pode ser uma armadilha! É... vocês estão tentando me enganar e me roubar!"

# game/chapters/chapter2/script/ch2sc23.rpy:119
translate brazil ch2sc23_421d5748:

#   el "{size=+5}{b}*Angry*{/b}{/size} {b}Now you listen here, you stubborn stinky man!{/b}"
    el "{size=+5}{b}*Nervoso*{/b}{/size}  {b} Escuta aqui, seu teimoso fedorento!{/b}"

# game/chapters/chapter2/script/ch2sc23.rpy:120
translate brazil ch2sc23_ec5ba3d8:

#   el "We just spent an hour searching around for your stupid ring!"
    el "Acabamos de passar uma hora procurando seu anel idiota!"

# game/chapters/chapter2/script/ch2sc23.rpy:122
translate brazil ch2sc23_5e20f746:

#   el "Even though you were rude to us, we decided to help you out."
    el "Apesar de você ter sido rude conosco, decidimos te ajudar."

# game/chapters/chapter2/script/ch2sc23.rpy:123
translate brazil ch2sc23_c7cdbb3e:

#   el "And now you have the nerve to doubt us still?!"
    el "E agora você ainda tem a audácia de duvidar de nós?!"

# game/chapters/chapter2/script/ch2sc23.rpy:125
translate brazil ch2sc23_524b7dd7:

#   el "Give me one good reason why I shouldn’t just knock some sense and common decency into your stubborn ass right now!"
    el "Me dê um bom motivo para eu não simplesmente te dar uma lição de bom senso e decência agora mesmo!"

# game/chapters/chapter2/script/ch2sc23.rpy:127
translate brazil ch2sc23_53eaf657:

#   mct "Damn... remind me not to get on her bad side."
    mct "Droga... lembre-me de não irritá-la."

# game/chapters/chapter2/script/ch2sc23.rpy:129
translate brazil ch2sc23_0ae45cb4:

#   uk "{b}*Surprised*{/b} Woah, woah, lass!"
    uk "{b}*Surpreso*{/b} Uau, uau, garota!"

# game/chapters/chapter2/script/ch2sc23.rpy:130
translate brazil ch2sc23_4a2641a5:

#   uk "I- arrgh, bloody hell! I’m sorry..."
    uk "Eu-argh, droga! Desculpe..."

# game/chapters/chapter2/script/ch2sc23.rpy:132
translate brazil ch2sc23_500fd4ff:

#   el "Apology accepted."
    el "Pedido de desculpas aceito."

# game/chapters/chapter2/script/ch2sc23.rpy:133
translate brazil ch2sc23_db2fc935:

#   el "Now, please take a look and see if this is the ring you’re looking for?"
    el "Agora, dê uma olhada e veja se este é o anel que você está procurando."

# game/chapters/chapter2/script/ch2sc23.rpy:137
translate brazil ch2sc23_7a9377dc:

#   uk "A-Aye! This is it! I-I can’t believe ye found it!"
    uk "Ah, sim! É isso mesmo! Não acredito que você encontrou!"

# game/chapters/chapter2/script/ch2sc23.rpy:139
translate brazil ch2sc23_7468d820:

#   mc "Well, believe it."
    mc "Pois acredite."

# game/chapters/chapter2/script/ch2sc23.rpy:141
translate brazil ch2sc23_a3dcd02c:

#   uk "Thank ye, lad! I thought I'd lost it fer good."
    uk "Obrigado, rapaz! Pensei que tinha perdido para sempre."

# game/chapters/chapter2/script/ch2sc23.rpy:143
translate brazil ch2sc23_1dc6d904:

#   el "If you don’t mind us asking, what is the meaning behind it?"
    el "Se não for incômodo perguntar, qual é o significado disso?"

# game/chapters/chapter2/script/ch2sc23.rpy:144
translate brazil ch2sc23_c83c807a:

#   el "It must be important, seeing how you reacted to losing it."
    el "Deve ser importante, considerando como você reagiu ao perdê-lo."

# game/chapters/chapter2/script/ch2sc23.rpy:146
translate brazil ch2sc23_b614b011:

#   uk "Aye, lass. It holds no value te anyone else."
    uk "Sim, querida. Não tem valor para mais ninguém."

# game/chapters/chapter2/script/ch2sc23.rpy:147
translate brazil ch2sc23_58eb2c0f:

#   uk "But te me... it’s everything! Ye see, it belonged te me wife... before..."
    uk "Mas para mim... é tudo! Veja bem, pertencia à minha esposa... antes..."

# game/chapters/chapter2/script/ch2sc23.rpy:148
translate brazil ch2sc23_84d0007c:

#   uk "Argh, it's no tale fer a time like this."
    uk "Argh, não é uma história para um momento como este."

# game/chapters/chapter2/script/ch2sc23.rpy:150
translate brazil ch2sc23_47ba90ad:

#   mct "The ring definitely has magical properties."
    mct "O anel definitivamente possui propriedades mágicas."

# game/chapters/chapter2/script/ch2sc23.rpy:151
translate brazil ch2sc23_9f491d36:

#   mct "Either he doesn’t know about it, or he’s not telling us everything."
    mct "Ou ele não sabe disso, ou não está nos contando tudo."

# game/chapters/chapter2/script/ch2sc23.rpy:153
translate brazil ch2sc23_e57e9cfb:

#   el "Oh... I’m sorry, sir."
    el "Oh... me desculpe, senhor."

# game/chapters/chapter2/script/ch2sc23.rpy:154
translate brazil ch2sc23_27d4468a:

#   el "I didn’t mean to pry, the ring clearly holds personal value to you."
    el "Não era minha intenção ser intrometida, o anel claramente tem um valor sentimental para você."

# game/chapters/chapter2/script/ch2sc23.rpy:156
translate brazil ch2sc23_016be7d8:

#   uk "Naye! I shan't accept yer apology lass, I’m sorry fer my behavior."
    uk "Não! Não aceitarei suas desculpas, moça. Lamento pelo meu comportamento."

# game/chapters/chapter2/script/ch2sc23.rpy:157
translate brazil ch2sc23_fe21bb80:

#   uk "Ye see, humans often don’t treat my kind well, te say the least."
    uk "Veja bem, os humanos geralmente não tratam bem a minha espécie, para dizer o mínimo."

# game/chapters/chapter2/script/ch2sc23.rpy:159
translate brazil ch2sc23_5fd4344e:

#   el "You mean dwarves?"
    el "Você quer dizer anões?"

# game/chapters/chapter2/script/ch2sc23.rpy:161
translate brazil ch2sc23_32fd5c51:

#   uk "Aye, we’re often treated as second class citizens."
    uk "Sim, muitas vezes somos tratados como cidadãos de segunda classe."

# game/chapters/chapter2/script/ch2sc23.rpy:163
translate brazil ch2sc23_9d67fe5f:

#   uk "It don’t matter if we’re wealthy, or even if we're scholars from the royal academy!"
    uk "Não importa se somos ricos, ou mesmo se somos acadêmicos da academia real!"

# game/chapters/chapter2/script/ch2sc23.rpy:165
translate brazil ch2sc23_f1c56e6b:

#   el "I didn’t know dwarves had it that bad."
    el "Eu não sabia que os anões passavam por situações tão ruins."

# game/chapters/chapter2/script/ch2sc23.rpy:166
translate brazil ch2sc23_af8d6ddd:

#   el "I’ve never met a dwarf before, you're the first one."
    el "Nunca conheci um anão antes, você é o primeiro."

# game/chapters/chapter2/script/ch2sc23.rpy:168
translate brazil ch2sc23_09292641:

#   mc "I've only met a few, and to be honest..."
    mc "Conheci apenas alguns, e para ser honesto..."

# game/chapters/chapter2/script/ch2sc23.rpy:169
translate brazil ch2sc23_45671ed1:

#   mc "I barely had a conversation with them."
    mc "Eu mal consegui conversar com eles."

# game/chapters/chapter2/script/ch2sc23.rpy:171
translate brazil ch2sc23_983b586a:

#   uk "I suppose I should thank ye properly fer finding this."
    uk "Acho que devo te agradecer devidamente por ter encontrado isso."

# game/chapters/chapter2/script/ch2sc23.rpy:173
translate brazil ch2sc23_90833d0e:

#   mc "There’s really no need."
    mc "Não há realmente necessidade."

# game/chapters/chapter2/script/ch2sc23.rpy:174
translate brazil ch2sc23_77a6af9a:

#   mc "Just remember, not all humans are against you..."
    mc "Lembre-se, nem todos os humanos estão contra você..."

# game/chapters/chapter2/script/ch2sc23.rpy:175
translate brazil ch2sc23_e6a4f1ff:

#   mc "In fact, you can consider us your friends."
    mc "Na verdade, você pode nos considerar seus amigos."

# game/chapters/chapter2/script/ch2sc23.rpy:177
translate brazil ch2sc23_2cfdcd3a:

#   uk "Arrgh, lad! Ye tryin' t’make me cry here?"
    uk "Argh, rapaz! Tá tentando me fazer chorar?"

# game/chapters/chapter2/script/ch2sc23.rpy:179
translate brazil ch2sc23_b9734da4:

#   mc "No, I-"
    mc "Não, eu-"

# game/chapters/chapter2/script/ch2sc23.rpy:182
translate brazil ch2sc23_0271dfa3:

#   br "Names Borri! Happy te meet ye both!"
    br "Meu nome é Borri! Prazer em conhecer vocês dois!"

# game/chapters/chapter2/script/ch2sc23.rpy:184
translate brazil ch2sc23_e5da1b67:

#   el "Happy to meet you Borri! I’m Eliza! And my friend here-"
    el "Prazer em conhecê-lo, Borri! Eu sou a Eliza! E minha amiga está aqui..."

# game/chapters/chapter2/script/ch2sc23.rpy:186
translate brazil ch2sc23_94084adc:

#   mc "[mc]. Good to meet you, Borri."
    mc "[mc] Prazer em conhecê-lo, Borri."

# game/chapters/chapter2/script/ch2sc23.rpy:188
translate brazil ch2sc23_99a0f05a:

#   br "Say, where ye headed to?"
    br "Diga-me, para onde vocês estão indo?"

# game/chapters/chapter2/script/ch2sc23.rpy:190
translate brazil ch2sc23_709ce1ee:

#   mc "We’re going to the capital, traveling from Riverside."
    mc "Vamos para a capital, partindo de Riverside."

# game/chapters/chapter2/script/ch2sc23.rpy:192
translate brazil ch2sc23_fa9b0d72:

#   el "I can’t wait to see the capital! I hope it’s like my mothers books described it."
    el "Mal posso esperar para ver a capital! Espero que seja como os livros da minha mãe a descreviam."

# game/chapters/chapter2/script/ch2sc23.rpy:194
translate brazil ch2sc23_c25ab0be:

#   el "I remember how the books described the busy streets, all the different shops, and the grand library!"
    el "Lembro-me de como os livros descreviam as ruas movimentadas, todas as lojas diferentes e a grande biblioteca!"

# game/chapters/chapter2/script/ch2sc23.rpy:196
translate brazil ch2sc23_319ad6a4:

#   br "Ah, the capital. I’ve been a few times me’self. Grand city."
    br "Ah, a capital. Eu mesmo já estive lá algumas vezes. Uma cidade grandiosa."

# game/chapters/chapter2/script/ch2sc23.rpy:198
translate brazil ch2sc23_ed019d5e:

#   br "But be wary of the people... Not everyone is as kind hearted as ye, m’lady."
    br "Mas tenha cuidado com as pessoas... Nem todos são tão bondosos quanto você, minha senhora."

# game/chapters/chapter2/script/ch2sc23.rpy:200
translate brazil ch2sc23_0ee2d0ba:

#   el "Oh! *giggles* Aren’t you a charmer!"
    el "Oh! *risinhos* Você é um encanto!"

# game/chapters/chapter2/script/ch2sc23.rpy:201
translate brazil ch2sc23_384e419a:

#   el "I’m not a lady, though."
    el "Mas eu não sou uma dama."

# game/chapters/chapter2/script/ch2sc23.rpy:202
translate brazil ch2sc23_5408e770:

#   el "I'm lowborn, a commoner. So just call me Eliza."
    el "Sou de origem humilde, uma plebeia. Então, podem me chamar de Eliza."

# game/chapters/chapter2/script/ch2sc23.rpy:204
translate brazil ch2sc23_490a1d00:

#   br "T’me yer a lady, Eliza."
    br "Você é uma dama, Eliza."

# game/chapters/chapter2/script/ch2sc23.rpy:205
translate brazil ch2sc23_229e13b5:

#   br "Tis not about yer birth, tis about yer actions."
    br "Não se trata do seu nascimento, mas sim das suas ações."

# game/chapters/chapter2/script/ch2sc23.rpy:206
translate brazil ch2sc23_f9a8a1dc:

#   br "As a dwarf, I'll never understand humans desire te put value on people just from birth?"
    br "Como anão, jamais entenderei o desejo humano de atribuir valor às pessoas apenas pelo nascimento."

# game/chapters/chapter2/script/ch2sc23.rpy:207
translate brazil ch2sc23_75053dde:

#   br "Dwarves, we have te earn our place in the world, and the respect that comes with it."
    br "Anões, temos que conquistar nosso lugar no mundo e o respeito que vem com ele."

# game/chapters/chapter2/script/ch2sc23.rpy:208
translate brazil ch2sc23_e1ce7314:

#   br "That's why yer a lady te me lass, yer actions have made it so."
    br "É por isso que você é uma dama para mim, minha querida, suas ações a tornaram assim."

# game/chapters/chapter2/script/ch2sc23.rpy:210
translate brazil ch2sc23_33711298:

#   el "Thank you, Borri."
    el "Obrigado, Borri."

# game/chapters/chapter2/script/ch2sc23.rpy:212
translate brazil ch2sc23_f236337e:

#   mc "Perhaps our paths will cross again someday."
    mc "Talvez nossos caminhos se cruzem novamente algum dia."

# game/chapters/chapter2/script/ch2sc23.rpy:214
translate brazil ch2sc23_b213c4ca:

#   br "Aye lad! I'll be swinging by the capital every now and then."
    br "É isso aí, rapaz! Vou dar uma passada na capital de vez em quando."

# game/chapters/chapter2/script/ch2sc23.rpy:216
translate brazil ch2sc23_8d3e959e:

#   br "The people might be shite, but the ALE! Oooh... the ale!"
    br "As pessoas podem ser uma merda, mas a CERVEJA! Oooh... a cerveja!"

# game/chapters/chapter2/script/ch2sc23.rpy:218
translate brazil ch2sc23_47e0804d:

#   mc "*Chuckles* I guess we’ll look for you whenever there’s ale being served then."
    mc "*Risos* Acho que vamos te procurar sempre que tiver cerveja sendo servida."

# game/chapters/chapter2/script/ch2sc23.rpy:220
translate brazil ch2sc23_b83334a3:

#   br "*Chuckle* Ha! Yer a good lad! Take care of ye girl, [mc]."
    br "*Risos* Ha! Você é um bom rapaz! Cuide bem da sua garota, [mc]."

# game/chapters/chapter2/script/ch2sc23.rpy:221
translate brazil ch2sc23_25e1c858:

#   br "She’s a good one, I tell ye!"
    br "Ela é ótima, eu te digo!"

# game/chapters/chapter2/script/ch2sc23.rpy:223
translate brazil ch2sc23_810561d1:

#   el "*Shy* Uh, We’re jus-"
    el "*Tímida* Ah, nós só estamos..."

# game/chapters/chapter2/script/ch2sc23.rpy:229
translate brazil ch2sc23_0f7a08fb:

#   mc "She's a good one, indeed."
    mc "Ela é realmente muito boa."

# game/chapters/chapter2/script/ch2sc23.rpy:230
translate brazil ch2sc23_b943eb1d:

#   mc "I’ll make sure she’s taken good care of."
    mc "Vou garantir que ela receba os melhores cuidados."

# game/chapters/chapter2/script/ch2sc23.rpy:231
translate brazil ch2sc23_d93d5a7a:

#   "Slightly surprised by your embrace, Eliza can't help but giggle."
    "Ligeiramente surpresa com o seu abraço, Eliza não consegue conter o risinho."

# game/chapters/chapter2/script/ch2sc23.rpy:232
translate brazil ch2sc23_a1d78fc8:

#   "Borri seems to appreciate you being a man, Borri’s trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Borri parece apreciar o fato de você ser um homem, a confiança de Borri aumentou em {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc23.rpy:234
translate brazil ch2sc23_cf816415:

#   elt "He's so sweet."
    elt "Ele é tão doce."

# game/chapters/chapter2/script/ch2sc23.rpy:237
translate brazil ch2sc23_849b9b55:

#   el "*Blushes* ..."
    el "*Cora* ..."

# game/chapters/chapter2/script/ch2sc23.rpy:240
translate brazil ch2sc23_3081fa82:

#   elt "He didn’t correct Borri?! Does that mean-"
    elt "Ele não corrigiu o Borri?! Isso significa que..."

# game/chapters/chapter2/script/ch2sc23.rpy:241
translate brazil ch2sc23_92022c22:

#   "Eliza is happy that you didn't correct Borri, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Eliza está feliz por você não ter corrigido Borri, a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc23.rpy:251
translate brazil ch2sc23_561b8e64:

#   elt "Stop it, Eliza! It probably didn’t mean anything."
    elt "Pare com isso, Eliza! Provavelmente não significou nada."

# game/chapters/chapter2/script/ch2sc23.rpy:252
translate brazil ch2sc23_6502c17c:

#   "You release Eliza and you say your goodbyes."
    "Você liberta Eliza e se despede."

# game/chapters/chapter2/script/ch2sc23.rpy:254
translate brazil ch2sc23_1bc78a14:

#   el "Bye-bye Borri! It was nice meeting you! I hope we run into you in Luxenford!"
    el "Tchau, Borri! Foi um prazer te conhecer! Espero que a gente se encontre em Luxenford!"

# game/chapters/chapter2/script/ch2sc23.rpy:255
translate brazil ch2sc23_6d6ccfef:

#   br "Aye! Yer can search for ol'Borri at the taverns, typically 'The Drunken Rooster' is where I stay!"
    br "Sim! Você pode procurar o velho Borri nas tavernas, geralmente eu fico no \"Galo Bêbado\"!"

# game/chapters/chapter2/script/ch2sc23.rpy:256
translate brazil ch2sc23_8d3b3ff6:

#   el "The Drunken Rooster, noted!"
    el "O Galo Bêbado, anotado!"

# game/chapters/chapter2/script/ch2sc23.rpy:263
translate brazil ch2sc23_145a12fd:

#   mc "Actually, we’re just friends."
    mc "Na verdade, somos apenas amigos."

# game/chapters/chapter2/script/ch2sc23.rpy:269
translate brazil ch2sc23_55de3102:

#   "Borri appreciates you returning his trinket, Borri’s trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Borri agradece por você ter devolvido seu objeto. A confiança de Borri aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc23.rpy:277
translate brazil ch2sc23_7f0a1f54:

#   "{color=#f00}Dark morality{/color} has increased by{size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "{color=#f00}Moralidade sombria{/color} aumentou em{size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc23.rpy:279
translate brazil ch2sc23_b644e139:

#   mc "Eliza, I think this is valuable. We should keep it, and possibly sell it when we reach Luxenford."
    mc "Eliza, acho que isto é valioso. Devemos guardá-lo e, possivelmente, vendê-lo quando chegarmos a Luxemburgo."

# game/chapters/chapter2/script/ch2sc23.rpy:281
translate brazil ch2sc23_22e0787f:

#   el "[mc]! That’s so shameful... But you have a point."
    el "[mc] Que vergonha... Mas você tem razão."

# game/chapters/chapter2/script/ch2sc23.rpy:282
translate brazil ch2sc23_eabaf1ea:

#   el "We barely have any coin left, and we’ll need to pay for food and a room at a tavern."
    el "Quase não temos mais dinheiro e precisaremos pagar pela comida e por um quarto em uma taverna."

# game/chapters/chapter2/script/ch2sc23.rpy:284
translate brazil ch2sc23_107689c8:

#   mc "So you agree?"
    mc "Então você concorda?"

# game/chapters/chapter2/script/ch2sc23.rpy:286
translate brazil ch2sc23_d371b46c:

#   el "Against my better judgment... yes."
    el "Contra o meu bom senso... sim."

# game/chapters/chapter2/script/ch2sc23.rpy:288
translate brazil ch2sc23_71443748:

#   mc "Hey, we looked around the area. Didn’t find anything unusual."
    mc "Olá, demos uma olhada na área. Não encontramos nada de incomum."

# game/chapters/chapter2/script/ch2sc23.rpy:290
translate brazil ch2sc23_0bdf4fc2:

#   uk "Arrh ye still here? I told ye t’leave!"
    uk "Arrh, você ainda está aqui? Eu te disse para ir embora!"

# game/chapters/chapter2/script/ch2sc23.rpy:292
translate brazil ch2sc23_8674e230:

#   el "Hey! We’re just trying to help you, okay?"
    el "Ei! Só estamos tentando te ajudar, tá bom?"

# game/chapters/chapter2/script/ch2sc23.rpy:294
translate brazil ch2sc23_de0264e1:

#   mc "Once again, sorry we couldn’t find it."
    mc "Mais uma vez, lamentamos não termos conseguido encontrar."

# game/chapters/chapter2/script/ch2sc23.rpy:296
translate brazil ch2sc23_1c848869:

#   uk "Oh, bloody hell. Sorry for yelling at ye, lad. Just in a foul mood t’day."
    uk "Puxa vida! Desculpe por ter gritado com você, rapaz. Só estou de mau humor hoje."

# game/chapters/chapter2/script/ch2sc23.rpy:298
translate brazil ch2sc23_aedad408:

#   el "That’s alright, sir. We understand the frustration of losing something."
    el "Não tem problema, senhor. Entendemos a frustração de perder algo."

# game/chapters/chapter2/script/ch2sc23.rpy:300
translate brazil ch2sc23_47be27d8:

#   br "Sir? Phfff! Borri."
    br "Senhor? Phfff! Borri."

# game/chapters/chapter2/script/ch2sc23.rpy:302
translate brazil ch2sc23_04a48c88:

#   mc "[mc]. This is Eliza."
    mc "[mc] Esta é Eliza."

# game/chapters/chapter2/script/ch2sc23.rpy:304
translate brazil ch2sc23_6acc0c60:

#   el "Nice to meet you, Borri!"
    el "Prazer em conhecê-lo, Borri!"

# game/chapters/chapter2/script/ch2sc23.rpy:306
translate brazil ch2sc23_78d059d7:

#   br "Aye. I don’t often meet humans who be willing te help fer nothin' in return."
    br "Sim. Não é comum encontrar pessoas dispostas a ajudar sem esperar nada em troca."

# game/chapters/chapter2/script/ch2sc23.rpy:308
translate brazil ch2sc23_ee5e04d2:

#   elt "Oh heavens! I feel terrible for him. We’re even stealing his trinket."
    elt "Ai, céus! Sinto muito por ele. Estamos até roubando a bugiganga dele."

# game/chapters/chapter2/script/ch2sc23.rpy:310
translate brazil ch2sc23_2c29cb7c:

#   el "S-Sorry we couldn’t be of any help, in the end."
    el "Lamentamos não termos conseguido ajudar no final."

# game/chapters/chapter2/script/ch2sc23.rpy:312
translate brazil ch2sc23_ecb2bbc6:

#   br "Oh, lass. Don’t be blaming ye’self. Anyway, I need te be going."
    br "Oh, querida. Não se culpe. De qualquer forma, preciso ir."

# game/chapters/chapter2/script/ch2sc23.rpy:314
translate brazil ch2sc23_79aaf9a9:

#   mc "Hope to see you under better circumstances, Borri."
    mc "Espero te ver em melhores circunstâncias, Borri."

# game/chapters/chapter2/script/ch2sc23.rpy:316
translate brazil ch2sc23_fb64893b:

#   br "Aye, lad! If ye spend time enough at taverns, we'll be sure t’cross paths!"
    br "Sim, rapaz! Se você passar tempo suficiente nas tavernas, com certeza nossos caminhos se cruzarão!"

# game/chapters/chapter2/script/ch2sc23.rpy:318
translate brazil ch2sc23_fa4aa087:

#   el "Bye, Borri! Don’t be a stranger!"
    el "Tchau, Borri! Não desapareça!"

# game/chapters/chapter2/script/ch2sc23.rpy:322
translate brazil ch2sc23_6c44d679:

#   el "[mc], that was terrible! I feel so guilty."
    el "[mc] Isso foi terrível! Me sinto muito culpada."

# game/chapters/chapter2/script/ch2sc23.rpy:324
translate brazil ch2sc23_25d7b35b:

#   mc "Hey, it was my idea, so let me carry the guilt. We both know we need the coin."
    mc "Ei, a ideia foi minha, então deixa eu arcar com a culpa. Nós dois sabemos que precisamos do dinheiro."

# game/chapters/chapter2/script/ch2sc23.rpy:326
translate brazil ch2sc23_3cb2071e:

#   el "There have to be other ways we can get coin."
    el "Deve haver outras maneiras de conseguirmos dinheiro."

# game/chapters/chapter2/script/ch2sc23.rpy:328
translate brazil ch2sc23_cf6cad6c:

#   mc "We’ll figure something out. Don’t worry."
    mc "Vamos dar um jeito. Não se preocupe."

# game/chapters/chapter2/script/ch2sc23.rpy:330
translate brazil ch2sc23_c7e3d497:

#   el "Urrhh. Okay, let’s just go."
    el "Urrhh. Ok, vamos embora."

# game/chapters/chapter2/script/ch2sc23.rpy:266
translate brazil ch2sc23_1bc78a14_1:

#   el "Bye-bye Borri! It was nice meeting you! I hope we run into you in Luxenford!"
    el "Tchau, Borri! Foi um prazer te conhecer! Espero que a gente se encontre em Luxenford!"

# game/chapters/chapter2/script/ch2sc23.rpy:267
translate brazil ch2sc23_6d6ccfef_1:

#   br "Aye! Yer can search for ol'Borri at the taverns, typically 'The Drunken Rooster' is where I stay!"
    br "Sim! Você pode procurar o velho Borri nas tavernas, geralmente eu fico no \"Galo Bêbado\"!"

# game/chapters/chapter2/script/ch2sc23.rpy:268
translate brazil ch2sc23_8d3b3ff6_1:

#   el "The Drunken Rooster, noted!"
    el "O Galo Bêbado, anotado!"

