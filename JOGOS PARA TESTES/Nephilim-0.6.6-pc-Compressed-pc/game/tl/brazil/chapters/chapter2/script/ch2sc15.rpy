# game/chapters/chapter2/script/ch2sc15.rpy:15
translate brazil ch2sc15_6cd8bc38:

#   el "Look at that."
    el "Olha só isso."

# game/chapters/chapter2/script/ch2sc15.rpy:16
translate brazil ch2sc15_927c8e8a:

#   el "Doesn’t that just look... heavenly!"
    el "Não parece simplesmente... divino?"

# game/chapters/chapter2/script/ch2sc15.rpy:20
translate brazil ch2sc15_55c40125:

#   mc "It’s a tavern bed..."
    mc "É uma cama de taverna..."

# game/chapters/chapter2/script/ch2sc15.rpy:22
translate brazil ch2sc15_d4109b44:

#   el "Still, just thinking about the nights ahead of us, this bed will feel like heaven!"
    el "Mesmo assim, só de pensar nas noites que nos aguardam, essa cama vai parecer um paraíso!"

# game/chapters/chapter2/script/ch2sc15.rpy:24
translate brazil ch2sc15_addfc6b3:

#   mc "You sure get excited about the weirdest things."
    mc "Você se empolga com as coisas mais estranhas."

# game/chapters/chapter2/script/ch2sc15.rpy:26
translate brazil ch2sc15_25bd154f:

#   el "Huuh? Is it so weird that I want my butt to feel comfy in a warm bed, instead of freezing my cheeks off on the cold ground?"
    el "Hã? É tão estranho assim eu querer que meu bumbum fique confortável em uma cama quentinha, em vez de congelar minhas nádegas no chão gelado?"

# game/chapters/chapter2/script/ch2sc15.rpy:28
translate brazil ch2sc15_0da6aec9:

#   mc "When you put it like that..."
    mc "Quando você coloca dessa forma..."

# game/chapters/chapter2/script/ch2sc15.rpy:30
translate brazil ch2sc15_6d007fe7:

#   el "That’s right, even you can’t disagree on this!"
    el "Isso mesmo, nem você pode discordar disso!"

# game/chapters/chapter2/script/ch2sc15.rpy:32
translate brazil ch2sc15_c6fe07e0:

#   el "Now hurry up! Let’s get comfy!"
    el "Depressa! Vamos ficar à vontade!"

# game/chapters/chapter2/script/ch2sc15.rpy:34
translate brazil ch2sc15_606e2d02:

#   mc "Sure."
    mc "Claro."

# game/chapters/chapter2/script/ch2sc15.rpy:48
translate brazil ch2sc15_390ade4e:

#   el "Ahh... so much better! All set!"
    el "Ah... muito melhor! Tudo pronto!"

# game/chapters/chapter2/script/ch2sc15.rpy:52
translate brazil ch2sc15_87915d4d:

#   el "It wasn't that long ago I'd never shared a bed with a boy before."
    el "Não faz muito tempo que eu nunca tinha dividido a cama com um rapaz."

# game/chapters/chapter2/script/ch2sc15.rpy:53
translate brazil ch2sc15_08a4677f:

#   el "Or hugged one, even. Let alone kissed one, now look at me."
    el "Ou até mesmo abracei uma. E quanto mais beijei uma, olhe só para mim agora."

# game/chapters/chapter2/script/ch2sc15.rpy:54
translate brazil ch2sc15_70e0019e:

#   el "Sharing a bed with you... the first person I've done those things with."
    el "Dividir a cama com você... a primeira pessoa com quem fiz essas coisas."

# game/chapters/chapter2/script/ch2sc15.rpy:56
translate brazil ch2sc15_5401c831:

#   el "Longing to be embraced by you... to feel your rough hands on my delicate skin."
    el "Anseio por ser abraçada por você... por sentir suas mãos ásperas em minha pele delicada."

# game/chapters/chapter2/script/ch2sc15.rpy:58
translate brazil ch2sc15_debad9df:

#   el "Why do you have this effect on me, [mc]?"
    el "Por que você tem esse efeito sobre mim? [mc]?"

# game/chapters/chapter2/script/ch2sc15.rpy:59
translate brazil ch2sc15_a750a59b:

#   el "Why can't I stop thinking about you?"
    el "Por que não consigo parar de pensar em você?"

# game/chapters/chapter2/script/ch2sc15.rpy:61
translate brazil ch2sc15_0a28ee29:

#   mc "Eliza..."
    mc "Eliza..."

# game/chapters/chapter2/script/ch2sc15.rpy:62
translate brazil ch2sc15_aa4463bb:

#   mc "I... I feel the same."
    mc "Eu... eu sinto o mesmo."

# game/chapters/chapter2/script/ch2sc15.rpy:64
translate brazil ch2sc15_958a8fec:

#   el "Y-You do?"
    el "S-Sério?"

# game/chapters/chapter2/script/ch2sc15.rpy:66
translate brazil ch2sc15_da0524b9:

#   mc "I do. Being close to you, it calms me."
    mc "Sim. Estar perto de você me acalma."

# game/chapters/chapter2/script/ch2sc15.rpy:67
translate brazil ch2sc15_0c34f24b:

#   mc "And I’m not just talking about my temper..."
    mc "E não estou falando apenas do meu temperamento..."

# game/chapters/chapter2/script/ch2sc15.rpy:69
translate brazil ch2sc15_27356f56:

#   mc "You calm every nerve in my body when you're near... but at the same time, you also excite me."
    mc "Você acalma todos os meus nervos quando está perto... mas, ao mesmo tempo, também me excita."

# game/chapters/chapter2/script/ch2sc15.rpy:71
translate brazil ch2sc15_ec0917af:

#   mc "I’m not certain how to best describe these feelings between us, but I look forward to discovering them with you."
    mc "Não sei bem como descrever esses sentimentos entre nós, mas estou ansioso para descobri-los com você."

# game/chapters/chapter2/script/ch2sc15.rpy:73
translate brazil ch2sc15_19a98073:

#   elt "He’s so cute! No one has ever been this honest with me before."
    elt "Ele é tão fofo! Ninguém nunca foi tão sincero comigo antes."

# game/chapters/chapter2/script/ch2sc15.rpy:75
translate brazil ch2sc15_5315f756:

#   "Eliza appreciates your honesty, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Eliza aprecia sua honestidade, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc15.rpy:77
translate brazil ch2sc15_ff3d8382:

#   el "[mc]?"
    el "[mc]?"

# game/chapters/chapter2/script/ch2sc15.rpy:79
translate brazil ch2sc15_74f342c8:

#   mc "Mh?"
    mc "Hum?"

# game/chapters/chapter2/script/ch2sc15.rpy:82
translate brazil ch2sc15_fbfc11ae:

#   el "Hold me?"
    el "Me segure?"

# game/chapters/chapter2/script/ch2sc15.rpy:88
translate brazil ch2sc15_9f0edb15:

#   mc "Sure, come here."
    mc "Claro, venha aqui."

# game/chapters/chapter2/script/ch2sc15.rpy:90
translate brazil ch2sc15_c9fe2999:

#   "As Eliza turns her back to you, you grab her small waist, pulling her closely against you in a warm embrace."
    "Quando Eliza lhe vira as costas, você a segura pela cintura fina, puxando-a para perto em um abraço caloroso."

# game/chapters/chapter2/script/ch2sc15.rpy:92
translate brazil ch2sc15_b7627aa6:

#   el "Mmhm."
    el "Hum-hum."

# game/chapters/chapter2/script/ch2sc15.rpy:94
translate brazil ch2sc15_57e9758a:

#   el "I needed this."
    el "Eu precisava disso."

# game/chapters/chapter2/script/ch2sc15.rpy:96
translate brazil ch2sc15_d963a723:

#   mc "Honestly, I did too."
    mc "Sinceramente, eu também."

# game/chapters/chapter2/script/ch2sc15.rpy:98
translate brazil ch2sc15_3bd9edbb:

#   el "You know, you can be really sweet when you want to be."
    el "Sabe, você pode ser muito doce quando quer."

# game/chapters/chapter2/script/ch2sc15.rpy:100
translate brazil ch2sc15_e979c9a8:

#   mc "Dont ge-"
    mc "Não ge-"

# game/chapters/chapter2/script/ch2sc15.rpy:102
translate brazil ch2sc15_6905002b:

#   el "'Don’t get used to it.' Yada yada... Too late. I’m used to it, and I like it."
    el "'Não se acostume com isso.' Blá blá blá... Tarde demais. Eu já me acostumei e gosto."

# game/chapters/chapter2/script/ch2sc15.rpy:104
translate brazil ch2sc15_fcbd18e0:

#   mc "*Sigh* ..."
    mc "*Suspirar* ..."

# game/chapters/chapter2/script/ch2sc15.rpy:107
translate brazil ch2sc15_2a7cbbb2:

#   el "*Giggling*"
    el "*Risos*"

# game/chapters/chapter2/script/ch2sc15.rpy:109
translate brazil ch2sc15_c965352e:

#   "Eliza snuggles closely against you, feeling safe in your arms"
    "Eliza se aconchega em você, sentindo-se segura em seus braços."

# game/chapters/chapter2/script/ch2sc15.rpy:111
translate brazil ch2sc15_6ab5deef:

#   el "Hey, [mc]?"
    el "Ei, [mc]?"

# game/chapters/chapter2/script/ch2sc15.rpy:113
translate brazil ch2sc15_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/chapters/chapter2/script/ch2sc15.rpy:115
translate brazil ch2sc15_38b2d0aa:

#   el "Would you mind telling me about your mentor? I feel like there's more to him than you’ve told me."
    el "Você se importaria de me falar sobre seu mentor? Tenho a impressão de que ele é mais complexo do que você me contou."

# game/chapters/chapter2/script/ch2sc15.rpy:117
translate brazil ch2sc15_ea37b6a5:

#   mc "Sure. I think it’s time I told you more about him."
    mc "Claro. Acho que está na hora de eu te contar mais sobre ele."

# game/chapters/chapter2/script/ch2sc15.rpy:119
translate brazil ch2sc15_594226f6:

#   el "So, there is more to it?"
    el "Então, há mais alguma coisa envolvida?"

# game/chapters/chapter2/script/ch2sc15.rpy:121
translate brazil ch2sc15_ec47e1c8:

#   mc "Yes. But I’m not sure you'll like it."
    mc "Sim. Mas não tenho certeza se você vai gostar."

# game/chapters/chapter2/script/ch2sc15.rpy:123
translate brazil ch2sc15_a0d2d651:

#   el "I can handle it. Besides, I want to know more about you and what you had to go through."
    el "Eu consigo lidar com isso. Além disso, quero saber mais sobre você e o que você teve que enfrentar."

# game/chapters/chapter2/script/ch2sc15.rpy:125
translate brazil ch2sc15_7221b529:

#   mc "*You exhale deeply* Alright..."
    mc "*Você expira profundamente* Muito bem..."

# game/chapters/chapter2/script/ch2sc15.rpy:127
translate brazil ch2sc15_0938e53b:

#   mc "I’ll start with his name... Oren."
    mc "Vou começar pelo nome dele... Oren."

# game/chapters/chapter2/script/ch2sc15.rpy:130
translate brazil ch2sc15_8558303d:

#   "{b}!!{/b}"
    "{b}!!{/b}"

# game/chapters/chapter2/script/ch2sc15.rpy:132
translate brazil ch2sc15_aa3e7363:

#   el "Huh? Strange... that was my fathers name."
    el "Hã? Que estranho... esse era o nome do meu pai."

# game/chapters/chapter2/script/ch2sc15.rpy:134
translate brazil ch2sc15_8edeb57c:

#   mc "Not strange."
    mc "Nada de estranho."

# game/chapters/chapter2/script/ch2sc15.rpy:136
translate brazil ch2sc15_629325e6:

#   el "Wait... you’re saying, m-my father was your mentor?"
    el "Espere... você está dizendo que meu pai foi seu mentor?"

# game/chapters/chapter2/script/ch2sc15.rpy:138
translate brazil ch2sc15_afa8e8ed:

#   el "That he was the one who took you away after your parents were ... murdered?"
    el "Que foi ele quem te levou embora depois que seus pais foram... assassinados?"

# game/chapters/chapter2/script/ch2sc15.rpy:140
translate brazil ch2sc15_f800bed0:

#   mc "Yes."
    mc "Sim."

# game/chapters/chapter2/script/ch2sc15.rpy:142
translate brazil ch2sc15_52ff245c:

#   el "It can’t be."
    el "Não pode ser."

# game/chapters/chapter2/script/ch2sc15.rpy:144
translate brazil ch2sc15_392a34f1:

#   el "Why would he have even been there? Why would he have gone to Riverside late at night?"
    el "Por que ele estaria lá? Por que ele teria ido a Riverside tarde da noite?"

# game/chapters/chapter2/script/ch2sc15.rpy:146
translate brazil ch2sc15_bb0a7eba:

#   "Eliza remains silent for a moment before she sits up, turning to face you."
    "Eliza permanece em silêncio por um momento antes de se sentar e se virar para você."

# game/chapters/chapter2/script/ch2sc15.rpy:152
translate brazil ch2sc15_9bbf0d6d:

#   el "He-He left because of you?"
    el "Ele... Ele foi embora por sua causa?"

# game/chapters/chapter2/script/ch2sc15.rpy:156
translate brazil ch2sc15_90a9755d:

#   mc "I know you probably hate me now..."
    mc "Eu sei que você provavelmente me odeia agora..."

# game/chapters/chapter2/script/ch2sc15.rpy:158
translate brazil ch2sc15_5bfb316b:

#   mc "'Why didn't I tell you sooner?' I'm sure you're thinking that."
    mc "\"Por que não te contei antes?\" Tenho certeza que você está pensando isso."

# game/chapters/chapter2/script/ch2sc15.rpy:160
translate brazil ch2sc15_02608d21:

#   mc "'What are the chances I ran into you in the woods?' Slim to none, if I didn't know where to look."
    mc "'Qual a probabilidade de eu te encontrar na floresta?' Mínima, para não dizer nula, se eu não soubesse onde procurar."

# game/chapters/chapter2/script/ch2sc15.rpy:162
translate brazil ch2sc15_c620429b:

#   mc "I didn’t want your father to take me away that night, Eliza. I didn’t ask him to protect me..."
    mc "Eu não queria que seu pai me levasse embora naquela noite, Eliza. Eu não pedi a ele para me proteger..."

# game/chapters/chapter2/script/ch2sc15.rpy:163
translate brazil ch2sc15_0128f71d:

#   mc "I completely understand if you want to remain here tomorrow, when I set out."
    mc "Compreendo perfeitamente se quiser ficar aqui amanhã, quando eu partir."

# game/chapters/chapter2/script/ch2sc15.rpy:166
translate brazil ch2sc15_6eee911d:

#   el "{b}Shut up!{/b}"
    el "{b}Cale-se!{/b}"

# game/chapters/chapter2/script/ch2sc15.rpy:168
translate brazil ch2sc15_d2a84db4:

#   el "[mc], do you still not know me at all?"
    el "[mc] Você ainda não me conhece de jeito nenhum?"

# game/chapters/chapter2/script/ch2sc15.rpy:170
translate brazil ch2sc15_0077b075:

#   mc "What do you-"
    mc "O que você faz-"

# game/chapters/chapter2/script/ch2sc15.rpy:172
translate brazil ch2sc15_1e49f0fe:

#   el "Let me finish."
    el "Deixe-me terminar."

# game/chapters/chapter2/script/ch2sc15.rpy:174
translate brazil ch2sc15_96d9c95b:

#   el "I don’t blame you. You were only ten years old. Your parents just got murdered."
    el "Eu não te culpo. Você tinha apenas dez anos. Seus pais acabaram de ser assassinados."

# game/chapters/chapter2/script/ch2sc15.rpy:176
translate brazil ch2sc15_05c5b333:

#   el "Yes, you could have told me when we met. But would I even have believed you back then?"
    el "Sim, você poderia ter me contado quando nos conhecemos. Mas será que eu teria acreditado em você naquela época?"

# game/chapters/chapter2/script/ch2sc15.rpy:178
translate brazil ch2sc15_73dc9691:

#   el "It wouldn't change anything, either way."
    el "De qualquer forma, não mudaria nada."

# game/chapters/chapter2/script/ch2sc15.rpy:180
translate brazil ch2sc15_cf6d63a8:

#   el "I’m not even mad at my father, either."
    el "Nem estou zangado com meu pai."

# game/chapters/chapter2/script/ch2sc15.rpy:182
translate brazil ch2sc15_247f4ccc:

#   el "Yes, it led to me having a shit upbringing. And to my mother abandoning me to be on my own."
    el "Sim, isso fez com que eu tivesse uma infância péssima. E que minha mãe me abandonasse, me deixando sozinha."

# game/chapters/chapter2/script/ch2sc15.rpy:184
translate brazil ch2sc15_bd57ffff:

#   el "And yes, I wish that I could have had a normal life with my family intact."
    el "E sim, eu gostaria de ter tido uma vida normal com minha família unida."

# game/chapters/chapter2/script/ch2sc15.rpy:186
translate brazil ch2sc15_3d1c9000:

#   el "But then, I wouldn’t have met you."
    el "Mas aí eu não teria te conhecido."

# game/chapters/chapter2/script/ch2sc15.rpy:188
translate brazil ch2sc15_64db6502:

#   el "Meeting you has been the best experience of my life."
    el "Conhecer você foi a melhor experiência da minha vida."

# game/chapters/chapter2/script/ch2sc15.rpy:190
translate brazil ch2sc15_3b0bcf9c:

#   el "We’ve grown a lot closer lately, and I’ve caught myself feeling happy when you’re around."
    el "Nos aproximamos muito ultimamente, e tenho me sentido feliz quando você está por perto."

# game/chapters/chapter2/script/ch2sc15.rpy:192
translate brazil ch2sc15_82448240:

#   el "Because of you, I’m alive and I get to travel and see the world of Midomir..."
    el "Graças a você, estou vivo e posso viajar e conhecer o mundo de Midomir..."

# game/chapters/chapter2/script/ch2sc15.rpy:194
translate brazil ch2sc15_0355256b:

#   el "With a person I care about, respect, and look up to."
    el "Com uma pessoa por quem tenho carinho, respeito e admiro."

# game/chapters/chapter2/script/ch2sc15.rpy:200
translate brazil ch2sc15_1b2801f8:

#   el "You didn’t take anything away from me, okay?"
    el "Você não me tirou nada, tá bom?"

# game/chapters/chapter2/script/ch2sc15.rpy:202
translate brazil ch2sc15_53c06dfb:

#   el "Quite the opposite, actually. You’ve given me so much."
    el "Muito pelo contrário, na verdade. Você me deu tanto."

# game/chapters/chapter2/script/ch2sc15.rpy:204
translate brazil ch2sc15_332a7b79:

#   el "So, if I ever hear you feel guilty about this again, you’ll upset me, okay? You’ll hurt me."
    el "Então, se eu te ouvir se sentindo culpado por isso de novo, você vai me chatear, entendeu? Vai me magoar."

# game/chapters/chapter2/script/ch2sc15.rpy:206
translate brazil ch2sc15_918a9b66:

#   mc "I-I don't deserve this. You’re being too kind towards me after all the turmoil I’ve caused your family."
    mc "Eu não mereço isso. Você está sendo muito gentil comigo depois de toda a confusão que causei à sua família."

# game/chapters/chapter2/script/ch2sc15.rpy:208
translate brazil ch2sc15_043e6318:

#   el "Yes you do, [mc]. I'm the only one who can tell you what you need to hear."
    el "Sim, você tem. [mc] Só eu posso te dizer o que você precisa ouvir."

# game/chapters/chapter2/script/ch2sc15.rpy:210
translate brazil ch2sc15_66ac2e03:

#   el "So I’ll say it just once."
    el "Então, vou dizer isso apenas uma vez."

# game/chapters/chapter2/script/ch2sc15.rpy:212
translate brazil ch2sc15_31ba7a7d:

#   el "I forgive you."
    el "Eu perdôo você."

# game/chapters/chapter2/script/ch2sc15.rpy:214
translate brazil ch2sc15_2e4fffa0:

#   mc "Eliza, I-"
    mc "Eliza, I-"

# game/chapters/chapter2/script/ch2sc15.rpy:217
translate brazil ch2sc15_bd6d8fec:

#   "Before you manage to finish your sentence, Eliza has already wrapped her arms tightly around your neck."
    "Antes que você consiga terminar a frase, Eliza já o abraçou firmemente pelo pescoço."

# game/chapters/chapter2/script/ch2sc15.rpy:218
translate brazil ch2sc15_b74ceed0:

#   "You just barely manage to support the sudden embrace without falling over the edge of the bed."
    "Você mal consegue suportar o abraço repentino sem cair da cama."

# game/chapters/chapter2/script/ch2sc15.rpy:220
translate brazil ch2sc15_eec45d49:

#   "She’s pressing every part of herself against you. You feel your heart racing as you catch the scent of her hair."
    "Ela está pressionando cada parte do seu corpo contra você. Você sente seu coração acelerar ao inalar o perfume dos cabelos dela."

# game/chapters/chapter2/script/ch2sc15.rpy:221
translate brazil ch2sc15_b2fe2619:

#   "With her soft breasts squishing against your chest, you’re able to feel her heart pounding too."
    "Com os seios macios dela pressionando seu peito, você também consegue sentir o coração dela batendo forte."

# game/chapters/chapter2/script/ch2sc15.rpy:223
translate brazil ch2sc15_4b1fed42:

#   el "I forgive you, okay?"
    el "Eu te perdoo, tá bom?"

# game/chapters/chapter2/script/ch2sc15.rpy:224
translate brazil ch2sc15_8c269169:

#   el "I’m here, [mc]. I’m not leaving you."
    el "Estou aqui, [mc] Eu não vou te deixar."

# game/chapters/chapter2/script/ch2sc15.rpy:232
translate brazil ch2sc15_803163c1:

#   mc "I'm not going anywhere either Eliza, I will protect you with everything I've got."
    mc "Eu também não vou a lugar nenhum, Eliza. Vou te proteger com tudo o que tenho."

# game/chapters/chapter2/script/ch2sc15.rpy:233
translate brazil ch2sc15_ed53f904:

#   "Eliza remains silent, but she's squeezing you even tighter than before."
    "Eliza permanece em silêncio, mas está te apertando ainda mais do que antes."

# game/chapters/chapter2/script/ch2sc15.rpy:234
translate brazil ch2sc15_d67d885d:

#   "Eliza feels at peace hearing your words, her trust increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Eliza sente-se em paz ao ouvir suas palavras, e sua confiança aumentou com {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc15.rpy:239
translate brazil ch2sc15_2772b70d:

#   mc "It's too soon to make such promises."
    mc "É muito cedo para fazer tais promessas."

# game/chapters/chapter2/script/ch2sc15.rpy:240
translate brazil ch2sc15_31d9c4be:

#   mc "We don't know what awaits us... but I'm glad you feel this way."
    mc "Não sabemos o que nos espera... mas fico feliz que você se sinta assim."

# game/chapters/chapter2/script/ch2sc15.rpy:241
translate brazil ch2sc15_cb9ef839:

#   el "Take your time. I want you to be sure before making such a promise."
    el "Não tenha pressa. Quero que você tenha certeza antes de fazer essa promessa."

