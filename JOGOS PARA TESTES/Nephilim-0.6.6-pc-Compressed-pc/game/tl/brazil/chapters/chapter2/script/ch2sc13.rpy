# ARQUIVO: game/chapters/chapter2/script/ch2sc13.rpy DIALOGOS: 236


# game/chapters/chapter2/script/ch2sc13.rpy:15
translate brazil ch2sc13_15eda024:

#   mc "Hey, Clark."
    mc "Ei, Clark."

# game/chapters/chapter2/script/ch2sc13.rpy:17
translate brazil ch2sc13_4fe7d612:

#   cl "Hey, [mc]. Welcome Eliza. What can I get you two?"
    cl "Ei, [mc] Bem-vinda, Eliza. O que posso servir para vocês duas?"

# game/chapters/chapter2/script/ch2sc13.rpy:19
translate brazil ch2sc13_76650b47:

#   mc "Couple of ales, thanks."
    mc "Um par de cervejas, por favor."

# game/chapters/chapter2/script/ch2sc13.rpy:21
translate brazil ch2sc13_b0840b60:

#   cl "They’ll be right with you, go ahead and take a seat."
    cl "Eles já vão te atender, pode se sentar."

# game/chapters/chapter2/script/ch2sc13.rpy:23
translate brazil ch2sc13_da7d1f0d:

#   cl_t "It’s good to have him around again, his parents would have been proper happy with how he turned out."
    cl_t "É bom tê-lo por perto novamente, seus pais teriam ficado muito felizes com a pessoa que ele se tornou."

# game/chapters/chapter2/script/ch2sc13.rpy:24
translate brazil ch2sc13_5836e3e2:

#   cl_t "I wonder if he intends to settle down here in Riverside?"
    cl_t "Será que ele pretende se estabelecer aqui em Riverside?"

# game/chapters/chapter2/script/ch2sc13.rpy:30
translate brazil ch2sc13_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter2/script/ch2sc13.rpy:31
translate brazil ch2sc13_5e9fe091:

#   mc "......."
    mc "......."

# game/chapters/chapter2/script/ch2sc13.rpy:33
translate brazil ch2sc13_38ae9ac0:

#   el "...."
    el "..."

# game/chapters/chapter2/script/ch2sc13.rpy:34
translate brazil ch2sc13_202cce04:

#   el "......."
    el "......."

# game/chapters/chapter2/script/ch2sc13.rpy:37
translate brazil ch2sc13_7760e52b:

#   mc "Okay, seriously, is something on my face? You keep staring."
    mc "Ok, falando sério, tem alguma coisa no meu rosto? Você não para de me encarar."

# game/chapters/chapter2/script/ch2sc13.rpy:40
translate brazil ch2sc13_5b1f98b4:

#   el "Oh! Uh n-no."
    el "Oh! Uh n-não."

# game/chapters/chapter2/script/ch2sc13.rpy:41
translate brazil ch2sc13_27262491:

#   el "Y-You look good tonight."
    el "Você está muito bonita esta noite."

# game/chapters/chapter2/script/ch2sc13.rpy:43
translate brazil ch2sc13_f96b7f81:

#   mc "Okay, how many ales did you have before I arrived?"
    mc "Certo, quantas cervejas você tomou antes de eu chegar?"

# game/chapters/chapter2/script/ch2sc13.rpy:45
translate brazil ch2sc13_1723270a:

#   el "None! I swear!"
    el "Nenhuma! Juro!"

# game/chapters/chapter2/script/ch2sc13.rpy:47
translate brazil ch2sc13_5fc2d098:

#   el "You look handsome tonight... I-..."
    el "Você está bonito esta noite... Eu..."

# game/chapters/chapter2/script/ch2sc13.rpy:48
translate brazil ch2sc13_dd7ac31f:

#   el "I just wanted to tell you that."
    el "Eu só queria te dizer isso."

# game/chapters/chapter2/script/ch2sc13.rpy:50
translate brazil ch2sc13_cd8f1a13:

#   mc "Compliment accepted."
    mc "Elogio aceito."

# game/chapters/chapter2/script/ch2sc13.rpy:52
translate brazil ch2sc13_d21020f0:

#   el "It wasn’t a compliment!!"
    el "Não foi um elogio!"

# game/chapters/chapter2/script/ch2sc13.rpy:54
translate brazil ch2sc13_11cd8a0a:

#   el "Hrrh. You’re so annoying!"
    el "Hrrh. Você é tão irritante!"

# game/chapters/chapter2/script/ch2sc13.rpy:56
translate brazil ch2sc13_c7aa9e7a:

#   mc "How was that not a compliment?"
    mc "Como é que isso não foi um elogio?"

# game/chapters/chapter2/script/ch2sc13.rpy:58
translate brazil ch2sc13_c832e453:

#   mc "Also, I’m sure I look the same as I always do."
    mc "Além disso, tenho certeza de que continuo com a mesma aparência de sempre."

# game/chapters/chapter2/script/ch2sc13.rpy:60
translate brazil ch2sc13_604d3f64:

#   el "Just forget it. Men!"
    el "Esquece. Homens!"

# game/chapters/chapter2/script/ch2sc13.rpy:62
translate brazil ch2sc13_8564d14c:

#   mc "I’m just teasing you."
    mc "Estou só brincando com você."

# game/chapters/chapter2/script/ch2sc13.rpy:63
translate brazil ch2sc13_b242b45f:

#   mc "You’re cute when you get flustered."
    mc "Você fica fofo quando se atrapalha."

# game/chapters/chapter2/script/ch2sc13.rpy:65
translate brazil ch2sc13_885597a0:

#   el "..."
    el "..."

# game/chapters/chapter2/script/ch2sc13.rpy:67
translate brazil ch2sc13_050b9746:

#   el "Huh? Wait... I wasn't... I'm not!"
    el "Hã? Espera... Eu não estava... Eu não sou!"

# game/chapters/chapter2/script/ch2sc13.rpy:69
translate brazil ch2sc13_e62fdcc9:

#   mc "See, flustered."
    mc "Veja, confuso."

# game/chapters/chapter2/script/ch2sc13.rpy:71
translate brazil ch2sc13_254e49c1:

#   el "Stop it, before I come over there."
    el "Pare com isso, antes que eu vá aí."

# game/chapters/chapter2/script/ch2sc13.rpy:73
translate brazil ch2sc13_0126645f:

#   mc "Cute."
    mc "Bonitinho."

# game/chapters/chapter2/script/ch2sc13.rpy:75
translate brazil ch2sc13_1fb28865:

#   el "St-Stop!"
    el "Pare!"

# game/chapters/chapter2/script/ch2sc13.rpy:76
translate brazil ch2sc13_0726ee30:

#   el "You can’t say these things to a girl if you don’t mean it."
    el "Você não pode dizer essas coisas para uma garota se não estiver falando sério."

# game/chapters/chapter2/script/ch2sc13.rpy:78
translate brazil ch2sc13_344c1a41:

#   mc "I meant it."
    mc "Eu estava falando sério."

# game/chapters/chapter2/script/ch2sc13.rpy:83
translate brazil ch2sc13_df16f671:

#   el "*Giggles softly* ..."
    el "*Ri baixinho* ..."

# game/chapters/chapter2/script/ch2sc13.rpy:87
translate brazil ch2sc13_0768d23d:

#   fy "Well, well. Look who I found! Hey guys!"
    fy "Ora, ora! Olha quem eu encontrei! Olá, pessoal!"

# game/chapters/chapter2/script/ch2sc13.rpy:89
translate brazil ch2sc13_d01c9b6a:

#   el "Huh, who are you?"
    el "Hum, quem é você?"

# game/chapters/chapter2/script/ch2sc13.rpy:90
translate brazil ch2sc13_0f71a8cc:

#   el "Whatever you're selling, we're not interested."
    el "Seja lá o que você esteja vendendo, não estamos interessados."

# game/chapters/chapter2/script/ch2sc13.rpy:92
translate brazil ch2sc13_8c2ccd62:

#   "You take a deep breath."
    "Você respira fundo."

# game/chapters/chapter2/script/ch2sc13.rpy:94
translate brazil ch2sc13_0ba4c1b1:

#   fy "What? You mean to tell me my dear cousin here hasn't even told you about me?"
    fy "O quê? Quer dizer que minha querida prima aqui nem sequer lhe falou de mim?"

# game/chapters/chapter2/script/ch2sc13.rpy:96
translate brazil ch2sc13_1cb3a55c:

#   "Aaaand breathe..."
    "E respire..."

# game/chapters/chapter2/script/ch2sc13.rpy:98
translate brazil ch2sc13_8babb465:

#   el "No, I can't say that he has."
    el "Não, não posso afirmar que sim."

# game/chapters/chapter2/script/ch2sc13.rpy:101
translate brazil ch2sc13_a94d2606:

#   "Eliza shoots you a glance, clearly intrigued by the family revelation."
    "Eliza lança-lhe um olhar, claramente intrigada com a revelação familiar."

# game/chapters/chapter2/script/ch2sc13.rpy:103
translate brazil ch2sc13_d72ef59f:

#   fy "Let me introduce myself, then. I’m Flynn!"
    fy "Deixe-me apresentar-me, então. Sou Flynn!"

# game/chapters/chapter2/script/ch2sc13.rpy:104
translate brazil ch2sc13_53d3df6c:

#   fy "The greatest adventurer in the region!"
    fy "O maior aventureiro da região!"

# game/chapters/chapter2/script/ch2sc13.rpy:106
translate brazil ch2sc13_eb453aaf:

#   fy "The most heroic man you'll meet in these parts."
    fy "O homem mais heroico que você encontrará por estas bandas."

# game/chapters/chapter2/script/ch2sc13.rpy:108
translate brazil ch2sc13_ba63f110:

#   fy "The things I've seen, places I've been, it would fill up the grand library in the capital!"
    fy "As coisas que vi, os lugares por onde passei, dariam para encher a grande biblioteca da capital!"

# game/chapters/chapter2/script/ch2sc13.rpy:110
translate brazil ch2sc13_d7cbb7da:

#   el "Right..."
    el "Certo..."

# game/chapters/chapter2/script/ch2sc13.rpy:112
translate brazil ch2sc13_3b9135bf:

#   fy "Surely a fair maiden such as yourself would love to hear one of my exciting tales?"
    fy "Certamente uma donzela tão bela como você adoraria ouvir uma das minhas histórias emocionantes?"

# game/chapters/chapter2/script/ch2sc13.rpy:115
translate brazil ch2sc13_8101b623:

#   "Eliza sends you a look telling you to rescue her."
    "Eliza te lança um olhar que diz para você resgatá-la."

# game/chapters/chapter2/script/ch2sc13.rpy:117
translate brazil ch2sc13_fbe0d35c:

#   mc "Flynn, sit your ass down."
    mc "Flynn, senta essa bunda aí."

# game/chapters/chapter2/script/ch2sc13.rpy:118
translate brazil ch2sc13_f359f201:

#   mc "You haven’t even been to a nearby village."
    mc "Você nem sequer visitou uma aldeia próxima."

# game/chapters/chapter2/script/ch2sc13.rpy:120
translate brazil ch2sc13_c2172d61:

#   mc "The most exciting thing you've experienced was nearly drowning when you sank my raft a decade ago."
    mc "A experiência mais emocionante que você já viveu foi quase se afogar quando afundou minha jangada há dez anos."

# game/chapters/chapter2/script/ch2sc13.rpy:124
translate brazil ch2sc13_37ddcee9:

#   fy "Alright, alright."
    fy "Certo, certo."

# game/chapters/chapter2/script/ch2sc13.rpy:125
translate brazil ch2sc13_9262e76c:

#   fy "You didn’t have to go into such vivid detail."
    fy "Você não precisava entrar em tantos detalhes."

# game/chapters/chapter2/script/ch2sc13.rpy:127
translate brazil ch2sc13_bd6e1461:

#   el "So, you’re actually cousins?"
    el "Então, vocês são primos mesmo?"

# game/chapters/chapter2/script/ch2sc13.rpy:129
translate brazil ch2sc13_69a14fa2:

#   fy "Yes! Cousins, best friends, brothers in arms!"
    fy "Sim! Primos, melhores amigos, irmãos de armas!"

# game/chapters/chapter2/script/ch2sc13.rpy:130
translate brazil ch2sc13_fd6f8b29:

#   fy "You could even say [mc] has learned all he knows from me!"
    fy "Você poderia até dizer [mc] Ele aprendeu tudo o que sabe comigo!"

# game/chapters/chapter2/script/ch2sc13.rpy:132
translate brazil ch2sc13_2dc0f61d:

#   mct "Deep breaths, [mc]. Deep breaths."
    mct "Respire fundo, [mc] Respire fundo."

# game/chapters/chapter2/script/ch2sc13.rpy:134
translate brazil ch2sc13_e556d8a5:

#   el "Okay... anyway!"
    el "Ok... enfim!"

# game/chapters/chapter2/script/ch2sc13.rpy:135
translate brazil ch2sc13_158a5143:

#   el "Pleased to meet you, Flynn! It’s nice to meet someone close to [mc]."
    el "Prazer em conhecê-lo, Flynn! É ótimo conhecer alguém próximo. [mc]."

# game/chapters/chapter2/script/ch2sc13.rpy:137
translate brazil ch2sc13_37f1851c:

#   el "I bet you have all sorts of juicy stories to tell."
    el "Aposto que você tem todo tipo de história interessante para contar."

# game/chapters/chapter2/script/ch2sc13.rpy:138
translate brazil ch2sc13_a72e899f:

#   el "Spare no details... paint me a vivid picture!"
    el "Não poupe detalhes... descreva tudo vividamente!"

# game/chapters/chapter2/script/ch2sc13.rpy:142
translate brazil ch2sc13_df24fc92:

#   fy "Oh, you bet I do! And for a pretty lady like you, I would happily share them!"
    fy "Ah, pode apostar que sim! E para uma dama tão bonita como você, eu os compartilharia com o maior prazer!"

# game/chapters/chapter2/script/ch2sc13.rpy:143
translate brazil ch2sc13_492582a6:

#   fy "After all, tales of the past are a sure way to a woman's heart!"
    fy "Afinal, histórias do passado são um caminho certo para o coração de uma mulher!"

# game/chapters/chapter2/script/ch2sc13.rpy:145
translate brazil ch2sc13_bf604c28:

#   mct "Strangling your cousin is wrong, [mc]. There are witnesses..."
    mct "Estrangular seu primo é errado. [mc] Existem testemunhas..."

# game/chapters/chapter2/script/ch2sc13.rpy:146
translate brazil ch2sc13_50376a13:

#   mct "Then again... he's not really my cousin."
    mct "Por outro lado... ele não é realmente meu primo."

# game/chapters/chapter2/script/ch2sc13.rpy:148
translate brazil ch2sc13_27e13db7:

#   el "It would be rude of me to decline such tales of wonder!"
    el "Seria indelicado da minha parte recusar tais histórias maravilhosas!"

# game/chapters/chapter2/script/ch2sc13.rpy:149
translate brazil ch2sc13_8a3106c6:

#   el "Tell me everything!"
    el "Conte-me tudo!"

# game/chapters/chapter2/script/ch2sc13.rpy:153
translate brazil ch2sc13_944cf3f4:

#   mc "Are you two done?"
    mc "Vocês dois já terminaram?"

# game/chapters/chapter2/script/ch2sc13.rpy:155
translate brazil ch2sc13_d147412e:

#   fy "Are you jealous, dear cousin? You know I’ve always been a hit with the ladies."
    fy "Você está com ciúmes, meu querido primo? Você sabe que eu sempre fiz sucesso com as mulheres."

# game/chapters/chapter2/script/ch2sc13.rpy:157
translate brazil ch2sc13_52fc947c:

#   mc "How would I know? I’ve been gone for ten years."
    mc "Como eu saberia? Já faz dez anos que estive fora."

# game/chapters/chapter2/script/ch2sc13.rpy:158
translate brazil ch2sc13_df0ad197:

#   mc "Last time I saw you, we were ten years old."
    mc "A última vez que te vi, tínhamos dez anos."

# game/chapters/chapter2/script/ch2sc13.rpy:160
translate brazil ch2sc13_08585414:

#   fy "You know what I mean."
    fy "Você sabe o que eu quero dizer."

# game/chapters/chapter2/script/ch2sc13.rpy:162
translate brazil ch2sc13_8352dadf:

#   fy "So, Eliza. What are you doing with my cousin?"
    fy "Então, Eliza, o que você está fazendo com meu primo?"

# game/chapters/chapter2/script/ch2sc13.rpy:164
translate brazil ch2sc13_5509d0c7:

#   fy "*Whispers* Did he kidnap you? Knock on the table twice for yes."
    fy "*Sussurrando* Ele te sequestrou? Bata duas vezes na mesa para confirmar."

# game/chapters/chapter2/script/ch2sc13.rpy:166
translate brazil ch2sc13_d99ca6bf:

#   mct "Find your happy place, [mc]."
    mct "Encontre o seu lugar feliz, [mc]."

# game/chapters/chapter2/script/ch2sc13.rpy:167
translate brazil ch2sc13_b055d5f8:

#   mct "We've already established that strangling your cousin in public is bad."
    mct "Já estabelecemos que estrangular seu primo em público é uma coisa ruim."

# game/chapters/chapter2/script/ch2sc13.rpy:169
translate brazil ch2sc13_44c27800:

#   el "Nothing so shameless, I’m afraid. He actually saved my life."
    el "Nada tão vergonhoso, receio. Na verdade, ele salvou minha vida."

# game/chapters/chapter2/script/ch2sc13.rpy:171
translate brazil ch2sc13_2d6ccb27:

#   fy "Oh, really? This I have to hear!"
    fy "Ah, é mesmo? Preciso ouvir isso!"

# game/chapters/chapter2/script/ch2sc13.rpy:173
translate brazil ch2sc13_037bd6ad:

#   el "Well, I was out gathering mushrooms in the forest."
    el "Bem, eu estava colhendo cogumelos na floresta."

# game/chapters/chapter2/script/ch2sc13.rpy:174
translate brazil ch2sc13_dc486b1a:

#   el "I'd ventured a little further than usual..."
    el "Eu me aventurei um pouco mais longe do que o habitual..."

# game/chapters/chapter2/script/ch2sc13.rpy:175
translate brazil ch2sc13_3339b16f:

#   el "Hoping to find some of the spicy hornworts. They're great in a soup.."
    el "Espero encontrar algumas dessas ervas-de-chifre picantes. Elas são ótimas em sopas."

# game/chapters/chapter2/script/ch2sc13.rpy:177
translate brazil ch2sc13_f91a983d:

#   el "That’s when two nasty guys appeared..."
    el "Foi então que apareceram dois caras desagradáveis..."

# game/chapters/chapter2/script/ch2sc13.rpy:178
translate brazil ch2sc13_79404370:

#   el "At first, they asked me what I was doing out there alone."
    el "A princípio, eles me perguntaram o que eu estava fazendo lá fora sozinha."

# game/chapters/chapter2/script/ch2sc13.rpy:180
translate brazil ch2sc13_7166a203:

#   el "But it didn’t take them long to start harassing me, and they refused to leave me alone."
    el "Mas não demorou muito para que começassem a me importunar e se recusavam a me deixar em paz."

# game/chapters/chapter2/script/ch2sc13.rpy:186
translate brazil ch2sc13_4117fe9a:

#   el "That’s when [mc] found me."
    el "Foi então que [mc] me encontrou."

# game/chapters/chapter2/script/ch2sc13.rpy:187
translate brazil ch2sc13_25b89302:

#   el "He took care of them without breaking a sweat."
    el "Ele cuidou deles sem o menor esforço."

# game/chapters/chapter2/script/ch2sc13.rpy:189
translate brazil ch2sc13_3647502b:

#   el "Afterwards he managed to carry me to safety."
    el "Depois, ele conseguiu me levar para um lugar seguro."

# game/chapters/chapter2/script/ch2sc13.rpy:190
translate brazil ch2sc13_da0d9c74:

#   el "You see, I had twisted my ankle, so he offered me a piggyback! It was great!"
    el "Sabe, eu tinha torcido o tornozelo, então ele me ofereceu uma carona nas costas! Foi ótimo!"

# game/chapters/chapter2/script/ch2sc13.rpy:192
translate brazil ch2sc13_446e2b9a:

#   fy "Woah! Saving a damsel in distress, cus? That’s something straight out of a fairy tale!"
    fy "Uau! Salvar uma donzela em perigo, cara? Isso é coisa de conto de fadas!"

# game/chapters/chapter2/script/ch2sc13.rpy:194
translate brazil ch2sc13_45b096bb:

#   el "It really was!"
    el "Foi mesmo!"

# game/chapters/chapter2/script/ch2sc13.rpy:195
translate brazil ch2sc13_e743ee5c:

#   el "He reminded me of one of the gallant heroes from my mother's novels!"
    el "Ele me lembrou um dos heróis galantes dos romances da minha mãe!"

# game/chapters/chapter2/script/ch2sc13.rpy:197
translate brazil ch2sc13_5d5a9c2f:

#   mc "It wasn’t anything special. I just took out a couple of bandits who were harassing a girl."
    mc "Não foi nada de especial. Apenas eliminei dois bandidos que estavam importunando uma garota."

# game/chapters/chapter2/script/ch2sc13.rpy:198
translate brazil ch2sc13_393a2496:

#   mc "In fact, Eliza knocked one of them out herself."
    mc "Na verdade, Eliza nocauteou um deles sozinha."

# game/chapters/chapter2/script/ch2sc13.rpy:200
translate brazil ch2sc13_1d408ad6:

#   el "You were pretty heroic..."
    el "Você foi bastante heroico..."

# game/chapters/chapter2/script/ch2sc13.rpy:201
translate brazil ch2sc13_54aeba3b:

#   el "Not many people would step in and risk getting hurt to help a stranger."
    el "Poucas pessoas se arriscariam a se machucar para ajudar um estranho."

# game/chapters/chapter2/script/ch2sc13.rpy:203
translate brazil ch2sc13_e30e5e66:

#   el "And carrying me to safety!"
    el "E me levando para um lugar seguro!"

# game/chapters/chapter2/script/ch2sc13.rpy:204
translate brazil ch2sc13_1f7a6882:

#   el "You could just have left me after you took care of them."
    el "Você poderia simplesmente ter me deixado depois de cuidar deles."

# game/chapters/chapter2/script/ch2sc13.rpy:208
translate brazil ch2sc13_45059ee5:

#   fy "Yeah, cus!"
    fy "Sim, cara!"

# game/chapters/chapter2/script/ch2sc13.rpy:209
translate brazil ch2sc13_e289055c:

#   fy "That does sound like something a knight from a fairy tale would do!"
    fy "Isso parece algo que um cavaleiro de um conto de fadas faria!"

# game/chapters/chapter2/script/ch2sc13.rpy:211
translate brazil ch2sc13_77946491:

#   fy "Certainly an interesting way to meet each other."
    fy "Sem dúvida, uma forma interessante de se conhecerem."

# game/chapters/chapter2/script/ch2sc13.rpy:212
translate brazil ch2sc13_1ab97500:

#   fy "So now you’re traveling together to Luxenford?"
    fy "Então agora vocês vão viajar juntos para Luxemburgo?"

# game/chapters/chapter2/script/ch2sc13.rpy:214
translate brazil ch2sc13_6d5e43a3:

#   el "Exactly! I’m so excited to see the capital!"
    el "Exatamente! Estou muito animada para conhecer a capital!"

# game/chapters/chapter2/script/ch2sc13.rpy:216
translate brazil ch2sc13_ba4c95d0:

#   mc "That's the gist of it."
    mc "Essa é a essência da questão."

# game/chapters/chapter2/script/ch2sc13.rpy:218
translate brazil ch2sc13_5e6dbd37:

#   mct "We left out some details. Flynn is already nosy enough as it is."
    mct "Deixamos de fora alguns detalhes. Flynn já é intrometido o suficiente."

# game/chapters/chapter2/script/ch2sc13.rpy:219
translate brazil ch2sc13_f3abba7d:

#   mct "He doesn't need to know about Rammus and Irene."
    mct "Ele não precisa saber sobre Rammus e Irene."

# game/chapters/chapter2/script/ch2sc13.rpy:223
translate brazil ch2sc13_13c5aa79:

#   al "Hey, guys! Sorry I couldn't be here earlier. I had to help Mother prepare some things for the upcoming harvest."
    al "Olá, pessoal! Desculpem por não ter chegado mais cedo. Tive que ajudar a mamãe a preparar algumas coisas para a colheita."

# game/chapters/chapter2/script/ch2sc13.rpy:225
translate brazil ch2sc13_a16f2280:

#   fy "Hey Alice! Good to see another pretty face!"
    fy "Olá Alice! Que bom ver outro rosto bonito!"

# game/chapters/chapter2/script/ch2sc13.rpy:227
translate brazil ch2sc13_5aea7ad9:

#   al "Thank you Flynn! You’re full of compliments as usual, I see."
    al "Obrigado, Flynn! Vejo que você está cheio de elogios como sempre."

# game/chapters/chapter2/script/ch2sc13.rpy:228
translate brazil ch2sc13_c7fc31e0:

#   al "But why are you aiming them at me? All the local ladies abandon you already?"
    al "Mas por que você está apontando as balas para mim? Todas as moças da região já te abandonaram?"

# game/chapters/chapter2/script/ch2sc13.rpy:230
translate brazil ch2sc13_9e9d6fc6:

#   fy "Alice, you wound me. I’ve been raised as a gentleman."
    fy "Alice, você me magoa. Fui criado como um cavalheiro."

# game/chapters/chapter2/script/ch2sc13.rpy:232
translate brazil ch2sc13_7e51e17d:

#   al "Sure Flynn, the most earnest gentleman around Riverside!"
    al "Claro, Flynn, o cavalheiro mais sincero de Riverside!"

# game/chapters/chapter2/script/ch2sc13.rpy:236
translate brazil ch2sc13_d46326eb:

#   al "Ahh! You must be Eliza! So sorry for how I stormed off earlier."
    al "Ah! Você deve ser a Eliza! Mil desculpas por ter saído de fininho mais cedo."

# game/chapters/chapter2/script/ch2sc13.rpy:238
translate brazil ch2sc13_42097f08:

#   al "I must have seemed terribly rude to you, with how I reacted to [mc]."
    al "Devo ter parecido terrivelmente rude com você, pela forma como reagi. [mc]."

# game/chapters/chapter2/script/ch2sc13.rpy:240
translate brazil ch2sc13_0f261637:

#   el "You mean how you slapped him?"
    el "Você quer dizer como você o esbofeteou?"

# game/chapters/chapter2/script/ch2sc13.rpy:242
translate brazil ch2sc13_e2dbd60a:

#   al "So embarrassing..."
    al "Que vergonha..."

# game/chapters/chapter2/script/ch2sc13.rpy:243
translate brazil ch2sc13_02991f89:

#   al "I-I normally don’t act like that... I promise!"
    al "Normalmente eu não ajo assim... Prometo!"

# game/chapters/chapter2/script/ch2sc13.rpy:245
translate brazil ch2sc13_f5695897:

#   el "Don’t worry..."
    el "Não se preocupe..."

# game/chapters/chapter2/script/ch2sc13.rpy:246
translate brazil ch2sc13_22d6775d:

#   el "*Snickers* I’ve certainly felt the desire to slap him once or twice."
    el "*Risos* Com certeza já senti vontade de lhe dar um tapa uma ou duas vezes."

# game/chapters/chapter2/script/ch2sc13.rpy:248
translate brazil ch2sc13_3e0c0ef9:

#   mc ".."
    mc "..."

# game/chapters/chapter2/script/ch2sc13.rpy:249
translate brazil ch2sc13_5c090e89:

#   mc "...."
    mc "..."

# game/chapters/chapter2/script/ch2sc13.rpy:250
translate brazil ch2sc13_3b21f354:

#   mc "......"
    mc "......"

# game/chapters/chapter2/script/ch2sc13.rpy:252
translate brazil ch2sc13_89961572:

#   el "But after you did it, I haven’t felt the need for it anymore, so thanks!"
    el "Mas depois que você fez isso, não senti mais necessidade, então, obrigada!"

# game/chapters/chapter2/script/ch2sc13.rpy:254
translate brazil ch2sc13_560c89c9:

#   al "Glad to be of assistance! *Laughs*"
    al "Fico feliz em ajudar! *Risos*"

# game/chapters/chapter2/script/ch2sc13.rpy:256
translate brazil ch2sc13_f512dda6:

#   mc "I’m glad you guys find my suffering amusing."
    mc "Fico feliz que vocês achem meu sofrimento engraçado."

# game/chapters/chapter2/script/ch2sc13.rpy:258
translate brazil ch2sc13_015eedfd:

#   fy "Lords! I would have paid at least five gold coins to see that slap."
    fy "Meu Deus! Eu teria pago pelo menos cinco moedas de ouro para ver aquele tapa."

# game/chapters/chapter2/script/ch2sc13.rpy:260
translate brazil ch2sc13_a50bce21:

#   fy "Knowing Alice, I bet your cheek hurts as if it were stung by a wasp!"
    fy "Conhecendo a Alice, aposto que sua bochecha está doendo como se tivesse sido picada por uma vespa!"

# game/chapters/chapter2/script/ch2sc13.rpy:263
translate brazil ch2sc13_7572c521:

#   al "Hey! What’s that supposed to mean?"
    al "Ei! O que isso quer dizer?"

# game/chapters/chapter2/script/ch2sc13.rpy:265
translate brazil ch2sc13_8dc5a14a:

#   fy "Nothing! Just that you are freakishly strong when you're angry."
    fy "Nada! Só que você fica incrivelmente forte quando está com raiva."

# game/chapters/chapter2/script/ch2sc13.rpy:267
translate brazil ch2sc13_58c20de9:

#   mc "You can say that again... my cheek is still sore."
    mc "Pode crer... minha bochecha ainda está dolorida."

# game/chapters/chapter2/script/ch2sc13.rpy:269
translate brazil ch2sc13_d18998b4:

#   al "Don’t be a baby! It was only a half-effort slap."
    al "Não seja infantil! Foi só um tapa sem muita força."

# game/chapters/chapter2/script/ch2sc13.rpy:270
translate brazil ch2sc13_44c27fb8:

#   al "I couldn't give it my all as I was still in shock..."
    al "Não consegui dar tudo de mim porque ainda estava em choque..."

# game/chapters/chapter2/script/ch2sc13.rpy:272
translate brazil ch2sc13_d82b0e46:

#   bth "*Gulps* ..."
    bth "*Engole em seco* ..."

# game/chapters/chapter2/script/ch2sc13.rpy:274
translate brazil ch2sc13_9dc7dc8a:

#   fy "O-Only half?"
    fy "Só metade?"

# game/chapters/chapter2/script/ch2sc13.rpy:276
translate brazil ch2sc13_79a2e428:

#   el "Hah! They look scared of you Alice."
    el "Hah! Eles parecem estar com medo de você, Alice."

# game/chapters/chapter2/script/ch2sc13.rpy:278
translate brazil ch2sc13_60132315:

#   al "They should be!"
    al "Deveriam ser!"

# game/chapters/chapter2/script/ch2sc13.rpy:279
translate brazil ch2sc13_5bd720d8:

#   al "They know my wrath is endless."
    al "Eles sabem que minha ira é infinita."

# game/chapters/chapter2/script/ch2sc13.rpy:281
translate brazil ch2sc13_527be0fe:

#   al "Better behave boys!"
    al "Comportem-se, meninos!"

# game/chapters/chapter2/script/ch2sc13.rpy:283
translate brazil ch2sc13_606e2d02:

#   mc "Sure."
    mc "Claro."

# game/chapters/chapter2/script/ch2sc13.rpy:286
translate brazil ch2sc13_f4df6a8f:

#   fy "Y-Yes Ma’am!"
    fy "S-Sim, senhora!"

# game/chapters/chapter2/script/ch2sc13.rpy:288
translate brazil ch2sc13_149c24e4:

#   mc "So, Flynn. What are you and Sabrina headed to the capital for?"
    mc "Então, Flynn. O que você e Sabrina estão planejando fazer na capital?"

# game/chapters/chapter2/script/ch2sc13.rpy:290
translate brazil ch2sc13_95ee6b6c:

#   el "Oh, you’re headed to Luxenford also?"
    el "Ah, você também vai para Luxemburgo?"

# game/chapters/chapter2/script/ch2sc13.rpy:292
translate brazil ch2sc13_6859d235:

#   fy "Yes, my sister Sabrina and I are leaving in about two weeks from now."
    fy "Sim, minha irmã Sabrina e eu partiremos daqui a cerca de duas semanas."

# game/chapters/chapter2/script/ch2sc13.rpy:294
translate brazil ch2sc13_273758e6:

#   fy "We offered for [mc] to stay with us until then, but he said you guys are leaving tomorrow."
    fy "Nós oferecemos por [mc] para ficarem conosco até lá, mas ele disse que vocês vão embora amanhã."

# game/chapters/chapter2/script/ch2sc13.rpy:296
translate brazil ch2sc13_c568403f:

#   al_t "To-Tomorrow? He just arrived and now he's leaving again?"
    al_t "Amanhã? Ele acabou de chegar e já está indo embora?"

# game/chapters/chapter2/script/ch2sc13.rpy:298
translate brazil ch2sc13_159eeb54:

#   el "We set out in the morning, Luxenford is far away."
    el "Partimos de manhã, Luxemburgo fica muito longe."

# game/chapters/chapter2/script/ch2sc13.rpy:300
translate brazil ch2sc13_b43ad2b1:

#   el "Since neither of us have been there before, we have no idea how long it will take."
    el "Como nenhum de nós esteve lá antes, não temos ideia de quanto tempo vai demorar."

# game/chapters/chapter2/script/ch2sc13.rpy:302
translate brazil ch2sc13_4fa0c319:

#   mc "Probably about four to seven days."
    mc "Provavelmente de quatro a sete dias."

# game/chapters/chapter2/script/ch2sc13.rpy:303
translate brazil ch2sc13_33bf7bbf:

#   mc "At least that's what traveling merchants have told me."
    mc "Pelo menos foi isso que me disseram os comerciantes viajantes."

# game/chapters/chapter2/script/ch2sc13.rpy:305
translate brazil ch2sc13_2f993bc6:

#   el "Sleeping on the ground... not a fan!"
    el "Dormir no chão... não gosto nada disso!"

# game/chapters/chapter2/script/ch2sc13.rpy:306
translate brazil ch2sc13_7d889070:

#   el "The beds here at the tavern feels like such a luxury."
    el "As camas aqui na taverna são um verdadeiro luxo."

# game/chapters/chapter2/script/ch2sc13.rpy:308
translate brazil ch2sc13_f93b0bca:

#   mc "We’ll keep an eye out for any taverns along the road."
    mc "Vamos ficar de olho em qualquer taverna ao longo da estrada."

# game/chapters/chapter2/script/ch2sc13.rpy:310
translate brazil ch2sc13_7ffafc71:

#   mc "So, Flynn. Back to my question... why are you and Sabrina headed there?"
    mc "Então, Flynn. Voltando à minha pergunta... por que você e Sabrina estão indo para lá?"

# game/chapters/chapter2/script/ch2sc13.rpy:312
translate brazil ch2sc13_f6c98a43:

#   fy "Well, you know how Sabrina always loved messing around with clothes, fixing them right up if anything tore?"
    fy "Você sabe como a Sabrina sempre adorou mexer com roupas, consertando-as rapidinho se alguma coisa rasgasse?"

# game/chapters/chapter2/script/ch2sc13.rpy:313
translate brazil ch2sc13_f8a52322:

#   fy "She wants to learn the craft of tailoring. She hopes one of the shopkeepers could use her expertise."
    fy "Ela quer aprender a arte da costura. Ela espera que algum lojista possa se beneficiar de sua experiência."

# game/chapters/chapter2/script/ch2sc13.rpy:315
translate brazil ch2sc13_9fd9f472:

#   fy "I, on the other hand, plan to sign up with the Seafarer’s guild."
    fy "Eu, por outro lado, planejo me inscrever na guilda dos marinheiros."

# game/chapters/chapter2/script/ch2sc13.rpy:317
translate brazil ch2sc13_0b06a494:

#   mc "Still dreaming of becoming a pirate?"
    mc "Ainda sonha em se tornar um pirata?"

# game/chapters/chapter2/script/ch2sc13.rpy:319
translate brazil ch2sc13_2898d76c:

#   fy "Pirate? Do I look like a lawless criminal to you, dear cousin?"
    fy "Pirata? Por acaso eu pareço um criminoso sem lei para você, meu caro primo?"

# game/chapters/chapter2/script/ch2sc13.rpy:321
translate brazil ch2sc13_fe5540b6:

#   fy "Nothing of the sort! The Seafarer’s guild is mainly about adventuring at sea."
    fy "Nada disso! A guilda dos marinheiros tem como principal objetivo as aventuras no mar."

# game/chapters/chapter2/script/ch2sc13.rpy:323
translate brazil ch2sc13_02a1e027:

#   fy "Exploring the vast ocean of Midomir, discovering new islands, or finding buried treasures long forgotten!"
    fy "Explorando o vasto oceano de Midomir, descobrindo novas ilhas ou encontrando tesouros enterrados há muito esquecidos!"

# game/chapters/chapter2/script/ch2sc13.rpy:324
translate brazil ch2sc13_1ca679b9:

#   fy "Oooohh and the wenches! Don't forget the wenches who will flock to my side to hear my grand tales of the sea!"
    fy "Ah, e as moças! Não se esqueçam das moças que virão em bandos ao meu lado para ouvir minhas histórias maravilhosas do mar!"

# game/chapters/chapter2/script/ch2sc13.rpy:326
translate brazil ch2sc13_350b70ba:

#   el "That does sound exciting! [mc], I hope we get to have some adventures at sea!"
    el "Isso parece emocionante! [mc] Espero que possamos viver algumas aventuras no mar!"

# game/chapters/chapter2/script/ch2sc13.rpy:328
translate brazil ch2sc13_62bc40fa:

#   mc "I prefer my feet on solid ground."
    mc "Prefiro manter os pés em terreno firme."

# game/chapters/chapter2/script/ch2sc13.rpy:330
translate brazil ch2sc13_5e656307:

#   fy "Don’t tell me you’re scared of the ocean just because we nearly drowned ten years ago?"
    fy "Não me diga que você tem medo do oceano só porque quase nos afogamos há dez anos?"

# game/chapters/chapter2/script/ch2sc13.rpy:332
translate brazil ch2sc13_fca52711:

#   mc "No."
    mc "Não."

# game/chapters/chapter2/script/ch2sc13.rpy:334
translate brazil ch2sc13_1993d737:

#   fy "I get it."
    fy "Entendo."

# game/chapters/chapter2/script/ch2sc13.rpy:335
translate brazil ch2sc13_2cccbc72:

#   fy "Being a pi- erhm... seafarer is not for everyone. It requires fortitude, will, and an appetite for adventure!"
    fy "Ser um... errr... marinheiro não é para qualquer um. Requer coragem, força de vontade e um espírito aventureiro!"

# game/chapters/chapter2/script/ch2sc13.rpy:338
translate brazil ch2sc13_fb4958a5:

#   el "Hey! [mc] has all those things! And way more than that."
    el "Ei! [mc] Tem tudo isso! E muito mais do que isso."

# game/chapters/chapter2/script/ch2sc13.rpy:339
translate brazil ch2sc13_f1276708:

#   el "He'd become High-king of the seven seas if he so desired."
    el "Ele se tornaria o Grande Rei dos sete mares se assim o desejasse."

# game/chapters/chapter2/script/ch2sc13.rpy:341
translate brazil ch2sc13_017ba8f2:

#   fy "Woah, cus. She’s fierce!"
    fy "Uau, mana. Ela é feroz!"

# game/chapters/chapter2/script/ch2sc13.rpy:343
translate brazil ch2sc13_77080530:

#   el "Hrrrh."
    el "Hrrr."

# game/chapters/chapter2/script/ch2sc13.rpy:345
translate brazil ch2sc13_3313b0fd:

#   fy "Sorry, Eliza. I didn’t mean to offend anyone."
    fy "Desculpe, Eliza. Não tive a intenção de ofender ninguém."

# game/chapters/chapter2/script/ch2sc13.rpy:347
translate brazil ch2sc13_22c771d8:

#   el "I’m sorry too, Flynn. I don’t know what came over me."
    el "Eu também sinto muito, Flynn. Não sei o que me deu."

# game/chapters/chapter2/script/ch2sc13.rpy:349
translate brazil ch2sc13_6db6f867:

#   fy "You’re clearly fiercely loyal to [mc]. I’m pleased to know you will be watching his back."
    fy "É evidente que você é extremamente leal a [mc] Fico feliz em saber que você estará protegendo-o."

# game/chapters/chapter2/script/ch2sc13.rpy:350
translate brazil ch2sc13_4744bde3:

#   fy "There’s nothing more important than being able to count on your partner."
    fy "Não há nada mais importante do que poder contar com seu parceiro."

# game/chapters/chapter2/script/ch2sc13.rpy:352
translate brazil ch2sc13_ae18584e:

#   mct "Flynn is right on this one. We'll run into situations where we need to depend on each other."
    mct "Flynn tem razão. Vamos nos deparar com situações em que precisaremos depender uns dos outros."

# game/chapters/chapter2/script/ch2sc13.rpy:353
translate brazil ch2sc13_d5b5c5f4:

#   mct "Trust and loyalty is something I rate highly. Eliza has proven both."
    mct "Confiança e lealdade são qualidades que prezo muito. Eliza demonstrou ambas."

# game/chapters/chapter2/script/ch2sc13.rpy:355
translate brazil ch2sc13_908815ce:

#   mc "I agree, Flynn. There’s no one else I would count on for this journey."
    mc "Concordo, Flynn. Não há ninguém mais em quem eu confiaria para esta jornada."

# game/chapters/chapter2/script/ch2sc13.rpy:359
translate brazil ch2sc13_0984df1b:

#   el "I-I feel the same."
    el "Eu sinto o mesmo."

# game/chapters/chapter2/script/ch2sc13.rpy:361
translate brazil ch2sc13_dc7d1f31:

#   al "..."
    al "..."

# game/chapters/chapter2/script/ch2sc13.rpy:363
translate brazil ch2sc13_f25c12ea:

#   al "Flynn, can you walk me home? It’s been a long day, my head is all kinds of fuzzy at the moment."
    al "Flynn, você pode me acompanhar até em casa? Foi um dia longo, minha cabeça está toda confusa agora."

# game/chapters/chapter2/script/ch2sc13.rpy:365
translate brazil ch2sc13_8323c953:

#   fy "Sure Alice, it’s getting late anyways."
    fy "Claro, Alice, já está ficando tarde mesmo."

# game/chapters/chapter2/script/ch2sc13.rpy:367
translate brazil ch2sc13_acf005a3:

#   mc "You good Alice?"
    mc "Você está bem, Alice?"

# game/chapters/chapter2/script/ch2sc13.rpy:369
translate brazil ch2sc13_0893fc1a:

#   al "Yeah. I... I just want to go home and sleep."
    al "Sim. Eu... eu só quero ir para casa e dormir."

# game/chapters/chapter2/script/ch2sc13.rpy:375
translate brazil ch2sc13_be4ae0bc:

#   "Alice liked that you insisted on walking her home. Her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Alice gostou que você insistisse em acompanhá-la até em casa. A confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc13.rpy:377
translate brazil ch2sc13_5bc63199:

#   "Eliza feels overshadowed by your old bonds. Her trust has decreased by {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."
    "Eliza sente-se ofuscada pelos seus antigos laços. A confiança dela diminuiu. {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc13.rpy:380
translate brazil ch2sc13_6f804617:

#   mc "I’ll walk you home."
    mc "Eu te acompanho até em casa."

# game/chapters/chapter2/script/ch2sc13.rpy:382
translate brazil ch2sc13_024361fd:

#   al "No, it’s fine. I know where it is... Flynn is more than capable of escorting me."
    al "Não, está tudo bem. Eu sei onde é... Flynn é mais do que capaz de me escoltar."

# game/chapters/chapter2/script/ch2sc13.rpy:384
translate brazil ch2sc13_af2c1e35:

#   mc "I want to."
    mc "Eu quero."

# game/chapters/chapter2/script/ch2sc13.rpy:386
translate brazil ch2sc13_db62670f:

#   al "."
    al "."

# game/chapters/chapter2/script/ch2sc13.rpy:387
translate brazil ch2sc13_be89f7e4:

#   al ".."
    al "..."

# game/chapters/chapter2/script/ch2sc13.rpy:389
translate brazil ch2sc13_5799d82d:

#   al "Fine! Let's go."
    al "Ótimo! Vamos lá."

# game/chapters/chapter2/script/ch2sc13.rpy:395
translate brazil ch2sc13_5529cb1a:

#   "Eliza liked that you chose to stay with her. Her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Eliza gostou que você tivesse escolhido ficar com ela. A confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc13.rpy:397
translate brazil ch2sc13_e40cbd7e:

#   "Alice noticed you didn't choose her. Her trust has decreased by {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."
    "Alice percebeu que você não a escolheu. A confiança dela diminuiu. {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc13.rpy:400
translate brazil ch2sc13_b02f050a:

#   mc "Get home safely, Alice."
    mc "Volte para casa em segurança, Alice."

# game/chapters/chapter2/script/ch2sc13.rpy:402
translate brazil ch2sc13_0a95ec2e:

#   mc "Flynn, make sure she gets home in one piece. Without stumbling over any rocks..."
    mc "Flynn, certifique-se de que ela chegue em casa inteira. Sem tropeçar em nenhuma pedra..."

# game/chapters/chapter2/script/ch2sc13.rpy:404
translate brazil ch2sc13_a9b7c082:

#   fy "You can count on me cus!"
    fy "Pode contar comigo, mano!"

# game/chapters/chapter2/script/ch2sc13.rpy:406
translate brazil ch2sc13_6fbd7768:

#   al "I don’t need you looking out for me."
    al "Eu não preciso que você fique cuidando de mim."

# game/chapters/chapter2/script/ch2sc13.rpy:408
translate brazil ch2sc13_5c7d8d1a:

#   al "Let’s go, Flynn."
    al "Vamos lá, Flynn."

# game/chapters/chapter2/script/ch2sc13.rpy:410
translate brazil ch2sc13_760f16ba:

#   fy "Later cus!"
    fy "Até mais, cara!"

# game/chapters/chapter2/script/ch2sc13.rpy:412
translate brazil ch2sc13_5e2b7823:

#   el "Is it just me, or did Alice seem a little upset?"
    el "Será que sou só eu, ou a Alice pareceu um pouco chateada?"

# game/chapters/chapter2/script/ch2sc13.rpy:414
translate brazil ch2sc13_d15f5459:

#   mc "Mhmm..."
    mc "Hum..."

# game/chapters/chapter2/script/ch2sc13.rpy:416
translate brazil ch2sc13_d3636939:

#   mc "Something did seem off. But she might've just be tired as she said."
    mc "Parecia haver algo estranho. Mas talvez ela estivesse apenas cansada, como disse."

# game/chapters/chapter2/script/ch2sc13.rpy:417
translate brazil ch2sc13_880d4cee:

#   mc "That could make anyone cranky."
    mc "Isso poderia deixar qualquer um irritado."

# game/chapters/chapter2/script/ch2sc13.rpy:419
translate brazil ch2sc13_ab1a4257:

#   el "I know that better than anyone!"
    el "Eu sei disso melhor do que ninguém!"

# game/chapters/chapter2/script/ch2sc13.rpy:420
translate brazil ch2sc13_6e08c379:

#   el "If I don't get my sleep, one wrong word can make my claws come out."
    el "Se eu não dormir o suficiente, uma palavra errada pode fazer minhas garras aparecerem."

# game/chapters/chapter2/script/ch2sc13.rpy:422
translate brazil ch2sc13_4b23b575:

#   mc "Simmer down, kitten."
    mc "Calma aí, gatinha."

# game/chapters/chapter2/script/ch2sc13.rpy:423
translate brazil ch2sc13_1afbba43:

#   mc "I prefer your claws retracted. At least, around me."
    mc "Prefiro suas garras retraídas. Pelo menos, perto de mim."

# game/chapters/chapter2/script/ch2sc13.rpy:425
translate brazil ch2sc13_695b0a26:

#   el "Mmmh. I have a feeling you would... appreciate my claws."
    el "Hum. Tenho a impressão de que você... apreciaria minhas garras."

# game/chapters/chapter2/script/ch2sc13.rpy:428
translate brazil ch2sc13_dbde3f0d:

#   el "D-Did you call me kit-kitten?"
    el "V-Você me chamou de gatinho?"

# game/chapters/chapter2/script/ch2sc13.rpy:430
translate brazil ch2sc13_f5ab0dc2:

#   el "Err, I mean, scratch that."
    el "Errr, quer dizer, esquece isso."

# game/chapters/chapter2/script/ch2sc13.rpy:431
translate brazil ch2sc13_d3badfba:

#   el "I-I err... forget anything I just said!"
    el "Eu... err... esqueçam tudo o que eu acabei de dizer!"

# game/chapters/chapter2/script/ch2sc13.rpy:434
translate brazil ch2sc13_8088a4ff:

#   mc "Looks like we've found the perfect nickname for you."
    mc "Parece que encontramos o apelido perfeito para você."

# game/chapters/chapter2/script/ch2sc13.rpy:436
translate brazil ch2sc13_22a52cd7:

#   elt "Urgh! Why does he affect me like this?"
    elt "Urgh! Por que ele me afeta assim?"

# game/chapters/chapter2/script/ch2sc13.rpy:437
translate brazil ch2sc13_ad67b696:

#   elt "I've never cared what a boy thinks, even once."
    elt "Eu nunca me importei com o que um garoto pensa, nem uma vez sequer."

# game/chapters/chapter2/script/ch2sc13.rpy:438
translate brazil ch2sc13_ba0f5054:

#   elt "Now I'm constantly getting flustered in his presence, Hnngh..."
    elt "Agora eu fico constantemente nervosa na presença dele, Hnngh..."

# game/chapters/chapter2/script/ch2sc13.rpy:440
translate brazil ch2sc13_7863905f:

#   el "Gaah! Let’s just go upstairs! I-I need sleep."
    el "Ah! Vamos subir! Preciso dormir."

# game/chapters/chapter2/script/ch2sc13.rpy:442
translate brazil ch2sc13_6bc507be:

#   mc "It’s been a long-ass day..."
    mc "Foi um dia longo pra caramba..."

# game/chapters/chapter2/script/ch2sc13.rpy:443
translate brazil ch2sc13_e24792f5:

#   mc "I had hoped to avoid everyone."
    mc "Eu esperava evitar todo mundo."

# game/chapters/chapter2/script/ch2sc13.rpy:445
translate brazil ch2sc13_ea713e3e:

#   mc "Instead we run into everyone from my past."
    mc "Em vez disso, encontramos todas as pessoas do meu passado."

# game/chapters/chapter2/script/ch2sc13.rpy:447
translate brazil ch2sc13_beda50ac:

#   mc "I feel drained."
    mc "Sinto-me esgotado(a)."

# game/chapters/chapter2/script/ch2sc13.rpy:449
translate brazil ch2sc13_d46a2b5b:

#   el "I can imagine. Being by yourself... well, you and your mentor, you get used to being alone."
    el "Imagino. Ficar sozinho... bem, você e seu mentor acabam se acostumando à solidão."

# game/chapters/chapter2/script/ch2sc13.rpy:451
translate brazil ch2sc13_7eda26d9:

#   mc "Yeah. Can’t wait for us to get on the road. Socializing is exhausting."
    mc "Sim. Mal posso esperar para pegarmos a estrada. Socializar é exaustivo."

# game/chapters/chapter2/script/ch2sc13.rpy:453
translate brazil ch2sc13_646d30ae:

#   el "You survived it. I’m proud of you."
    el "Você sobreviveu. Estou orgulhoso de você."

# game/chapters/chapter2/script/ch2sc13.rpy:455
translate brazil ch2sc13_18ddfaff:

#   mc "Thanks, I suppose."
    mc "Obrigado, eu acho."

# game/chapters/chapter2/script/ch2sc13.rpy:457
translate brazil ch2sc13_d39052f5:

#   el "Now, let’s head upstairs! Our bed is calling!"
    el "Vamos subir! Nossa cama está nos chamando!"

# game/chapters/chapter2/script/ch2sc13.rpy:459
translate brazil ch2sc13_01b8d176:

#   elt "Oh God. Did I just say that out loud? Please tell me he didn’t hear that..."
    elt "Meu Deus! Será que eu disse isso em voz alta? Por favor, me diga que ele não ouviu..."

# game/chapters/chapter2/script/ch2sc13.rpy:460
translate brazil ch2sc13_8dabefc6:

#   ".."
    "..."

# game/chapters/chapter2/script/ch2sc13.rpy:461
translate brazil ch2sc13_5f9b772e:

#   "...."
    "..."

# game/chapters/chapter2/script/ch2sc13.rpy:462
translate brazil ch2sc13_0fd4d656:

#   "......"
    "......"

# game/chapters/chapter2/script/ch2sc13.rpy:464
translate brazil ch2sc13_55d436fb:

#   mc "Our-"
    mc "Nosso-"

# game/chapters/chapter2/script/ch2sc13.rpy:466
translate brazil ch2sc13_c690bf3f:

#   el "No! No! Not a word from you!"
    el "Não! Não! Nem uma palavra sua!"

# game/chapters/chapter2/script/ch2sc13.rpy:469
translate brazil ch2sc13_07bdde05:

#   "....."
    "....."

# game/chapters/chapter2/script/ch2sc13.rpy:472
translate brazil ch2sc13_14b3a948:

#   el "Grrr. C’mon!"
    el "Grrr. Vamos lá!"

# game/chapters/chapter2/script/ch2sc13.rpy:433
translate brazil ch2sc13_0126645f_1:

#   mc "Cute."
    mc "Bonitinho."

