# ARQUIVO: game/chapters/chapter2/script/ch2sc17.rpy DIALOGOS: 117


# game/chapters/chapter2/script/ch2sc17.rpy:12
translate brazil ch2sc17_e883b250:

#   mct "I didn’t see Gibs at the tavern last night. Maybe he doesn’t even live here anymore?"
    mct "Não vi o Gibs na taverna ontem à noite. Será que ele nem mora mais aqui?"

# game/chapters/chapter2/script/ch2sc17.rpy:15
translate brazil ch2sc17_47147f72:

#   mct "I wonder how he's doing?"
    mct "Gostaria de saber como ele está."

# game/chapters/chapter2/script/ch2sc17.rpy:16
translate brazil ch2sc17_ea6c2e52:

#   mct "He was always a big softy on the inside... The thing with my parents though..."
    mct "Ele sempre foi um grande sentimental por dentro... Mas o problema com meus pais..."

# game/chapters/chapter2/script/ch2sc17.rpy:18
translate brazil ch2sc17_427395d7:

#   mct "That must have hit him hard."
    mct "Isso deve tê-lo afetado bastante."

# game/chapters/chapter2/script/ch2sc17.rpy:19
translate brazil ch2sc17_11d5e8c4:

#   mct "He and papa were best friends ever since their youth, and he adored mama."
    mct "Ele e o papai eram melhores amigos desde a juventude, e ele adorava a mamãe."

# game/chapters/chapter2/script/ch2sc17.rpy:21
translate brazil ch2sc17_ab3dfe9c:

#   mct "So often I've wanted to visit you and tell you everything Gibs."
    mct "Quantas vezes eu quis te visitar e te contar tudo, Gibs."

# game/chapters/chapter2/script/ch2sc17.rpy:22
translate brazil ch2sc17_4d851f2e:

#   mct "I-I..."
    mct "II..."

# game/chapters/chapter2/script/ch2sc17.rpy:24
translate brazil ch2sc17_fdf0b66d:

#   mct "Arhh! Whatever."
    mct "Ah! Tanto faz."

# game/chapters/chapter2/script/ch2sc17.rpy:25
translate brazil ch2sc17_0eeff25a:

#   mct "What's done is done, nobody can change the past..."
    mct "O que está feito, está feito, ninguém pode mudar o passado..."

# game/chapters/chapter2/script/ch2sc17.rpy:31
translate brazil ch2sc17_e8288f82:

#   mct "*Chuckles* His place still looks the same."
    mct "*Risos* O apartamento dele continua igual."

# game/chapters/chapter2/script/ch2sc17.rpy:33
translate brazil ch2sc17_533f0980:

#   mct "Here goes nothing."
    mct "Vamos lá."

# game/chapters/chapter2/script/ch2sc17.rpy:37
translate brazil ch2sc17_66ee747b:

#   mc "Hey Gibs! Are you here old man?"
    mc "Ei, Gibs! Você está aí, velho?"

# game/chapters/chapter2/script/ch2sc17.rpy:47
translate brazil ch2sc17_dee95575:

#   mct "Rats! I was hoping to speak to him before we left."
    mct "Que droga! Eu esperava falar com ele antes de irmos embora."

# game/chapters/chapter2/script/ch2sc17.rpy:49
translate brazil ch2sc17_b5d3e425:

#   mct "Since he isn’t here... hmm... I’ll go ask Clark if he knows anything."
    mct "Já que ele não está aqui... hum... vou perguntar ao Clark se ele sabe de alguma coisa."

# game/chapters/chapter2/script/ch2sc17.rpy:56
translate brazil ch2sc17_f0562c40:

#   gb "Huh?"
    gb "Huh?"

# game/chapters/chapter2/script/ch2sc17.rpy:57
translate brazil ch2sc17_1e772480:

#   gb "[mc]! It’s really you?"
    gb "[mc] É você mesmo?"

# game/chapters/chapter2/script/ch2sc17.rpy:61
translate brazil ch2sc17_2f46ca84:

#   mc "Hey, Old Bear."
    mc "Ei, Urso Velho."

# game/chapters/chapter2/script/ch2sc17.rpy:64
translate brazil ch2sc17_3be2c998:

#   gb "Come here, you little rascal!"
    gb "Vem cá, seu pestinha!"

# game/chapters/chapter2/script/ch2sc17.rpy:66
translate brazil ch2sc17_213e48d0:

#   mct "Oh no... brace for impact!"
    mct "Oh não... prepare-se para o impacto!"

# game/chapters/chapter2/script/ch2sc17.rpy:69
translate brazil ch2sc17_b50e6c39:

#   gb "Haha! You're just going to stand there!? Give me a hug!"
    gb "Haha! Vai ficar aí parado?! Me dá um abraço!"

# game/chapters/chapter2/script/ch2sc17.rpy:74
translate brazil ch2sc17_2da4d5aa:

#   gb "That’s it! Hah-hah-hah!"
    gb "É isso aí! Hah-hah-hah!"

# game/chapters/chapter2/script/ch2sc17.rpy:75
translate brazil ch2sc17_de2b1eb0:

#   gb "Give old Gibson a good squeeze!"
    gb "Dê um bom aperto no velho Gibson!"

# game/chapters/chapter2/script/ch2sc17.rpy:77
translate brazil ch2sc17_46c78128:

#   mc "Hrrraahh!"
    mc "Hrrraahh!"

# game/chapters/chapter2/script/ch2sc17.rpy:78
translate brazil ch2sc17_1195fb1b:

#   mc "C-Cant brea... breathe."
    mc "C-Não consigo respirar... respirar."

# game/chapters/chapter2/script/ch2sc17.rpy:80
translate brazil ch2sc17_fb080ecd:

#   gb "I can’t believe you’re really here!"
    gb "Não acredito que você está mesmo aqui!"

# game/chapters/chapter2/script/ch2sc17.rpy:81
translate brazil ch2sc17_32acd1bc:

#   gb "I never believed for a second that you were dead! Your aunt Maya was right!"
    gb "Eu nunca acreditei por um segundo que você estivesse morto! Sua tia Maya tinha razão!"

# game/chapters/chapter2/script/ch2sc17.rpy:82
translate brazil ch2sc17_1524cfe1:

#   gb "That gorgeous aunt of yours made sure I never stopped believing... she was convinced you couldn't be dead!"
    gb "Aquela sua tia maravilhosa fez com que eu nunca deixasse de acreditar... ela estava convencida de que você não podia estar morto!"

# game/chapters/chapter2/script/ch2sc17.rpy:84
translate brazil ch2sc17_50827f26:

#   mc "D-Definitely not dead. Hrhhh!"
    mc "D-Definitivamente não está morto. Hrhhh!"

# game/chapters/chapter2/script/ch2sc17.rpy:85
translate brazil ch2sc17_91261e3c:

#   mc "But I will be if you don’t stop squeezing so tightly."
    mc "Mas eu vou ficar se você não parar de apertar com tanta força."

# game/chapters/chapter2/script/ch2sc17.rpy:87
translate brazil ch2sc17_941db07f:

#   gb "Oh! Sorry, sorry! *Chuckles* Heh-heh! I forget my own strength."
    gb "Oh! Desculpe, desculpe! *Risos* Heh-heh! Eu me esqueço da minha própria força."

# game/chapters/chapter2/script/ch2sc17.rpy:89
translate brazil ch2sc17_b42b1271:

#   mc "*Winded* You don’t say."
    mc "*Sem fôlego* Não me diga."

# game/chapters/chapter2/script/ch2sc17.rpy:90
translate brazil ch2sc17_532580bc:

#   mc "What in the five hells have you been eating?"
    mc "Que diabos você andou comendo?"

# game/chapters/chapter2/script/ch2sc17.rpy:92
translate brazil ch2sc17_26ff1b98:

#   gb "What can I say, working with steel at the forge all day gives a man strength!"
    gb "O que posso dizer? Trabalhar com aço na forja o dia todo dá força a um homem!"

# game/chapters/chapter2/script/ch2sc17.rpy:94
translate brazil ch2sc17_2636484a:

#   mc "*Chuckles* It’s good to see you, Gibs... damn, my ribs."
    mc "*Risos* Que bom te ver, Gibs... droga, minhas costelas."

# game/chapters/chapter2/script/ch2sc17.rpy:95
translate brazil ch2sc17_56185c17:

#   gb "Hah! They'll pop back into place soon enough! It's great to see you kid!"
    gb "Ah! Eles vão voltar ao lugar rapidinho! Que bom te ver, garoto!"

# game/chapters/chapter2/script/ch2sc17.rpy:97
translate brazil ch2sc17_dfe765ab:

#   gb "Come, come! I want to hear everything!"
    gb "Venha, venha! Quero ouvir tudo!"

# game/chapters/chapter2/script/ch2sc17.rpy:100
translate brazil ch2sc17_73611f27:

#   gb "I bet a young lad like yourself have got quite the war-stories to tell!"
    gb "Aposto que um rapaz jovem como você tem muitas histórias de guerra para contar!"

# game/chapters/chapter2/script/ch2sc17.rpy:101
translate brazil ch2sc17_62e4b0fa:

#   gb "And by war-stories I mean, details about your female conquests!"
    gb "E por histórias de guerra, quero dizer detalhes sobre suas conquistas amorosas!"

# game/chapters/chapter2/script/ch2sc17.rpy:103
translate brazil ch2sc17_717487b4:

#   gb "Come! I need to sit down, I bet you've already got yourself a harem, oh to be young again!"
    gb "Vamos! Preciso me sentar, aposto que você já tem um harém, ah, como eu queria ser jovem de novo!"

# game/chapters/chapter2/script/ch2sc17.rpy:104
translate brazil ch2sc17_4d2f3e67:

#   mct "What is it with everyone thinking I'm building a harem? I'm just enjoying myself..."
    mct "Por que todo mundo acha que estou formando um harém? Estou apenas me divertindo..."

# game/chapters/chapter2/script/ch2sc17.rpy:107
translate brazil ch2sc17_b0e26fb0:

#   gb "Join me inside, I'm sure we'll need to sit for this!"
    gb "Venha comigo lá dentro, tenho certeza de que precisaremos ficar sentados para isso!"

# game/chapters/chapter2/script/ch2sc17.rpy:109
translate brazil ch2sc17_fcbd18e0:

#   mc "*Sigh* ..."
    mc "*Suspirar* ..."

# game/chapters/chapter2/script/ch2sc17.rpy:112
translate brazil ch2sc17_c0d09f09:

#   gb "Please, take a seat. We have a lot to catch up on."
    gb "Por favor, sente-se. Temos muito o que conversar."

# game/chapters/chapter2/script/ch2sc17.rpy:114
translate brazil ch2sc17_a72f4dfe:

#   gb "So, ten whole summers, huh? Where do we even begin?"
    gb "Então, dez verões inteiros, hein? Por onde começar?"

# game/chapters/chapter2/script/ch2sc17.rpy:116
translate brazil ch2sc17_53c8f6a0:

#   mc "I’ll just start from the night everything happened..."
    mc "Vou começar pela noite em que tudo aconteceu..."

# game/chapters/chapter2/script/ch2sc17.rpy:118
translate brazil ch2sc17_faa73f0f:

#   "You spend a few hours recapping the last ten years, and the recent events after Oren’s death and meeting Eliza."
    "Você passa algumas horas recapitulando os últimos dez anos e os eventos recentes após a morte de Oren e o encontro com Eliza."

# game/chapters/chapter2/script/ch2sc17.rpy:130
translate brazil ch2sc17_45cac942:

#   gb "."
    gb "."

# game/chapters/chapter2/script/ch2sc17.rpy:131
translate brazil ch2sc17_e3e0dc00:

#   gb ".."
    gb "..."

# game/chapters/chapter2/script/ch2sc17.rpy:133
translate brazil ch2sc17_d4a5db5c:

#   gb "Blazes, kid! You’ve been through one hell of a ride."
    gb "Puxa, garoto! Você passou por uma jornada e tanto."

# game/chapters/chapter2/script/ch2sc17.rpy:135
translate brazil ch2sc17_92a11bb4:

#   gb "Being taken away by a stranger, right as Eric & Lily were killed..."
    gb "Serem levados por um estranho, exatamente no momento em que Eric e Lily foram mortos..."

# game/chapters/chapter2/script/ch2sc17.rpy:137
translate brazil ch2sc17_2200e8ad:

#   gb "Spending several moons on the road, traveling to the far east."
    gb "Passando várias luas na estrada, viajando para o extremo oriente."

# game/chapters/chapter2/script/ch2sc17.rpy:139
translate brazil ch2sc17_dd57edaa:

#   gb "Finding this hidden 'Nakajima village' in the middle of a dense tropical forest."
    gb "Descobrir essa vila escondida de 'Nakajima' no meio de uma densa floresta tropical."

# game/chapters/chapter2/script/ch2sc17.rpy:141
translate brazil ch2sc17_3b8d0192:

#   gb "Meeting people from the Sen'ju region... I've never even met anyone from there."
    gb "Conhecer pessoas da região de Sen'ju... Eu nunca tinha conhecido ninguém de lá."

# game/chapters/chapter2/script/ch2sc17.rpy:142
translate brazil ch2sc17_4890a2c2:

#   gb "Except from traveling merchants."
    gb "Exceto comerciantes viajantes."

# game/chapters/chapter2/script/ch2sc17.rpy:144
translate brazil ch2sc17_3b06fc6e:

#   gb "I remember, clear as day, how you'd always pester Eric, your father, about becoming an adventurer."
    gb "Lembro-me, com toda a clareza, de como você sempre importunava Eric, seu pai, para que ele se tornasse um aventureiro."

# game/chapters/chapter2/script/ch2sc17.rpy:146
translate brazil ch2sc17_5e6e1767:

#   gb "It seems adventure found you all on its own."
    gb "Parece que a aventura te encontrou por conta própria."

# game/chapters/chapter2/script/ch2sc17.rpy:148
translate brazil ch2sc17_d6a0a102:

#   mc "It’s only just starting."
    mc "Está apenas começando."

# game/chapters/chapter2/script/ch2sc17.rpy:150
translate brazil ch2sc17_8676d992:

#   gb "You’re not staying?"
    gb "Você não vai ficar?"

# game/chapters/chapter2/script/ch2sc17.rpy:151
translate brazil ch2sc17_53efb045:

#   gb "*Sighs* But... you're finally home, I thought..."
    gb "*Suspiro* Mas... você finalmente está em casa, eu pensei..."

# game/chapters/chapter2/script/ch2sc17.rpy:153
translate brazil ch2sc17_dbf1d93f:

#   mc "No... Eliza and I have a long journey ahead of us."
    mc "Não... Eliza e eu temos uma longa jornada pela frente."

# game/chapters/chapter2/script/ch2sc17.rpy:154
translate brazil ch2sc17_e5d8666f:

#   mc "Lingering here in Riverside any longer won’t do me any good."
    mc "Permanecer aqui em Riverside por mais tempo não me fará bem algum."

# game/chapters/chapter2/script/ch2sc17.rpy:156
translate brazil ch2sc17_77a687ab:

#   gb "You’re a young man now, [mc]."
    gb "Você já é um jovem, [mc]."

# game/chapters/chapter2/script/ch2sc17.rpy:157
translate brazil ch2sc17_a18142e7:

#   gb "Part of that means making your own path in this world. You always went on and on about traveling..."
    gb "Parte disso significa trilhar seu próprio caminho neste mundo. Você sempre falava sem parar sobre viajar..."

# game/chapters/chapter2/script/ch2sc17.rpy:159
translate brazil ch2sc17_03905d21:

#   gb "I guess that part became a reality at least."
    gb "Acho que pelo menos essa parte se tornou realidade."

# game/chapters/chapter2/script/ch2sc17.rpy:161
translate brazil ch2sc17_727849a9:

#   gb "I was hoping you'd be able to stay a while longer. It would be good to have you around."
    gb "Eu esperava que você pudesse ficar mais um pouco. Seria bom ter você por perto."

# game/chapters/chapter2/script/ch2sc17.rpy:162
translate brazil ch2sc17_b3f8a881:

#   gb "*Quietly* {size=-10}{b}Not to mention, I'd love for you to meet Asta... I'm sure you'd be great friends...{/b}{/size}"
    gb "*Em silêncio* {size=-10}{b}Sem falar que eu adoraria que você conhecesse o Asta... Tenho certeza de que vocês seriam ótimos amigos...{/b}{/size}"

# game/chapters/chapter2/script/ch2sc17.rpy:164
translate brazil ch2sc17_f2ac7d91:

#   mc "Sorry to disappoint, Gibs. There’s something I have to do..."
    mc "Sinto muito desapontá-lo, Gibs. Tenho algo a fazer..."

# game/chapters/chapter2/script/ch2sc17.rpy:165
translate brazil ch2sc17_c101d41f:

#   mc "Something I can't achieve here in Riverside."
    mc "Algo que não consigo alcançar aqui em Riverside."

# game/chapters/chapter2/script/ch2sc17.rpy:167
translate brazil ch2sc17_6359501f:

#   gb "Heavens! You’re not seeking revenge are you?"
    gb "Céus! Você não está buscando vingança, está?"

# game/chapters/chapter2/script/ch2sc17.rpy:170
translate brazil ch2sc17_422f61af:

#   gb "Please tell me you aren't that bullheaded..."
    gb "Por favor, me diga que você não é tão teimoso assim..."

# game/chapters/chapter2/script/ch2sc17.rpy:174
translate brazil ch2sc17_c5f9f0cf:

#   mc "I have to. For them."
    mc "Eu preciso. Por eles."

# game/chapters/chapter2/script/ch2sc17.rpy:176
translate brazil ch2sc17_3eefa205:

#   gb "Kid... that’s the last thing they'd want."
    gb "Criança... essa é a última coisa que eles querem."

# game/chapters/chapter2/script/ch2sc17.rpy:177
translate brazil ch2sc17_6274d0be:

#   gb "Eric and Lily, they'd want you to be safe, to live your life."
    gb "Eric e Lily gostariam que você estivesse em segurança, que vivesse sua vida."

# game/chapters/chapter2/script/ch2sc17.rpy:179
translate brazil ch2sc17_8077fb68:

#   mc "It’s not about what they would have wanted, Gibs. I-I need this."
    mc "Não se trata do que eles teriam querido, Gibs. Eu preciso disso."

# game/chapters/chapter2/script/ch2sc17.rpy:181
translate brazil ch2sc17_ebe7c036:

#   mc "It’s the only thing that has kept me going all these years."
    mc "É a única coisa que me manteve firme todos esses anos."

# game/chapters/chapter2/script/ch2sc17.rpy:182
translate brazil ch2sc17_c69873d1:

#   mc "The only thing that has kept me from shattering into pieces..."
    mc "A única coisa que me impediu de me despedaçar..."

# game/chapters/chapter2/script/ch2sc17.rpy:186
translate brazil ch2sc17_2b2580e3:

#   gb "I... I understand. I guess it'd be pointless to ask you to be careful, eh?"
    gb "Eu... eu entendo. Acho que seria inútil pedir para você ter cuidado, né?"

# game/chapters/chapter2/script/ch2sc17.rpy:188
translate brazil ch2sc17_1a3ce239:

#   mc "Pretty much."
    mc "Praticamente isso."

# game/chapters/chapter2/script/ch2sc17.rpy:190
translate brazil ch2sc17_ae75af9a:

#   gb "In that case, I’ll simply ask that you finish what you’ve set out to do."
    gb "Nesse caso, peço simplesmente que você termine o que começou."

# game/chapters/chapter2/script/ch2sc17.rpy:192
translate brazil ch2sc17_f88bb7a1:

#   gb "Just don’t let it consume you... revenge can change a person. Make sure to surround yourself with good people."
    gb "Só não deixe que isso te consuma... a vingança pode mudar uma pessoa. Certifique-se de se cercar de pessoas boas."

# game/chapters/chapter2/script/ch2sc17.rpy:194
translate brazil ch2sc17_3cf91a90:

#   gb "People you can trust, people who will bring joy and light into your life."
    gb "Pessoas em quem você pode confiar, pessoas que trarão alegria e luz para sua vida."

# game/chapters/chapter2/script/ch2sc17.rpy:196
translate brazil ch2sc17_04deaad0:

#   mc "I-I’ll try, Gibs."
    mc "Eu vou tentar, Gibs."

# game/chapters/chapter2/script/ch2sc17.rpy:199
translate brazil ch2sc17_d7f1df72:

#   gb "I swear by the Divines, kid. If this is the last time I see you, I’ll beat you to a pulp!"
    gb "Juro pelos Divinos, garoto. Se esta for a última vez que te vejo, vou te dar uma surra!"

# game/chapters/chapter2/script/ch2sc17.rpy:201
translate brazil ch2sc17_259b7767:

#   mc "*Chuckle* I’ll see you again someday, Old Bear."
    mc "*Risos* Nos veremos novamente algum dia, Velho Urso."

# game/chapters/chapter2/script/ch2sc17.rpy:203
translate brazil ch2sc17_ffb4013d:

#   gb "Blazes... come here, Little Bear!"
    gb "Blazes... vem cá, Ursinho!"

# game/chapters/chapter2/script/ch2sc17.rpy:204
translate brazil ch2sc17_69dc3dd1:

#   mc "No! No more hugs. I'm still recovering from earlier."
    mc "Não! Chega de abraços. Ainda estou me recuperando do que aconteceu mais cedo."

# game/chapters/chapter2/script/ch2sc17.rpy:206
translate brazil ch2sc17_ff3b8a6a:

#   gb "Next time I see you, then!"
    gb "Na próxima vez que eu te vir, então!"

# game/chapters/chapter2/script/ch2sc17.rpy:207
translate brazil ch2sc17_167814cd:

#   mc "Alright, alright."
    mc "Certo, certo."

# game/chapters/chapter2/script/ch2sc17.rpy:209
translate brazil ch2sc17_6be3e009:

#   gb "And don’t underestimate whoever it is. Your father was a capable warrior."
    gb "E não subestime quem quer que seja. Seu pai era um guerreiro capaz."

# game/chapters/chapter2/script/ch2sc17.rpy:210
translate brazil ch2sc17_b4740910:

#   gb "He may have worked as a carpenter here in Riverside, but we both trained with sword and shield during our youth."
    gb "Ele pode ter trabalhado como carpinteiro aqui em Riverside, mas nós dois treinamos com espada e escudo durante nossa juventude."

# game/chapters/chapter2/script/ch2sc17.rpy:211
translate brazil ch2sc17_c75f75e2:

#   gb "And your mother..."
    gb "E sua mãe..."

# game/chapters/chapter2/script/ch2sc17.rpy:213
translate brazil ch2sc17_cd608f34:

#   gb "Lily, she was one of the most powerful arcane sorceresses I’ve ever seen."
    gb "Lily era uma das feiticeiras arcanas mais poderosas que eu já vi."

# game/chapters/chapter2/script/ch2sc17.rpy:214
translate brazil ch2sc17_3cc520dd:

#   gb "A renowned member of the Mage's guild."
    gb "Um membro renomado da guilda dos magos."

# game/chapters/chapter2/script/ch2sc17.rpy:215
translate brazil ch2sc17_d45d4207:

#   gb "Whoever could do that to them... has to be insanely powerful."
    gb "Quem quer que tenha conseguido fazer isso com eles... deve ser incrivelmente poderoso."

# game/chapters/chapter2/script/ch2sc17.rpy:217
translate brazil ch2sc17_e2e3818c:

#   mc "He's the one who should be afraid."
    mc "É ele quem deveria ter medo."

# game/chapters/chapter2/script/ch2sc17.rpy:219
translate brazil ch2sc17_63d7be09:

#   gb "I don’t doubt it kid. Just..."
    gb "Não duvido disso, garoto. Só..."

# game/chapters/chapter2/script/ch2sc17.rpy:221
translate brazil ch2sc17_6555aa52:

#   gb "Just make sure you come back."
    gb "Só não se esqueça de voltar."

# game/chapters/chapter2/script/ch2sc17.rpy:223
translate brazil ch2sc17_8bfa7a1c:

#   mc "I will, Gibs."
    mc "Sim, Gibs."

# game/chapters/chapter2/script/ch2sc17.rpy:224
translate brazil ch2sc17_5f2ec975:

#   mc "I still want to hear all the stories you have about my parents... so you can be sure I’ll return."
    mc "Ainda quero ouvir todas as histórias que você tem sobre meus pais... para que você tenha certeza de que voltarei."

# game/chapters/chapter2/script/ch2sc17.rpy:228
translate brazil ch2sc17_86c33922:

#   gb "Farewell, Little Bear. May the divines light your path."
    gb "Adeus, Ursinho. Que a divindade ilumine seu caminho."

# game/chapters/chapter2/script/ch2sc17.rpy:229
translate brazil ch2sc17_e3251364:

#   gb "And don't do anything foolish!"
    gb "E não faça nenhuma besteira!"

# game/chapters/chapter2/script/ch2sc17.rpy:231
translate brazil ch2sc17_dcb626c5:

#   mct "Goodbye old friend..."
    mct "Adeus, velho amigo..."

# game/chapters/chapter2/script/ch2sc17.rpy:235
translate brazil ch2sc17_4166c1a2:

#   gbt "They would be so proud of you."
    gbt "Eles ficariam muito orgulhosos de você."

# game/chapters/chapter2/script/ch2sc17.rpy:236
translate brazil ch2sc17_d98231d2:

#   gbt "Eric... Lily... are you guys seeing this from the afterlife? Your little boy has become a man."
    gbt "Eric... Lily... vocês estão vendo isso do além? O filhinho de vocês virou homem."

# game/chapters/chapter2/script/ch2sc17.rpy:237
translate brazil ch2sc17_99035c04:

#   gbt "*Sighs* I better head back inside, nails and hinges don't forge themselves."
    gbt "*Suspiro* É melhor eu voltar para dentro, pregos e dobradiças não se fazem sozinhos."

# game/chapters/chapter2/script/ch2sc17.rpy:240
translate brazil ch2sc17_e53cf28e:

#   astt "He's cute."
    astt "Ele é fofo."

# game/chapters/chapter2/script/ch2sc17.rpy:241
translate brazil ch2sc17_8ce4b8d5:

#   astt "Little bear? Hmm?"
    astt "Ursinho? Hum?"

# game/chapters/chapter2/script/ch2sc17.rpy:242
translate brazil ch2sc17_e0cf8699:

#   astt "I wonder who he is? I haven't seen him around Riverside before..."
    astt "Quem será ele? Nunca o vi por Riverside antes..."

# game/chapters/chapter2/script/ch2sc17.rpy:245
translate brazil ch2sc17_d2bf2a39:

#   astt "He was speaking to daddy for quite a while..."
    astt "Ele ficou conversando com o pai por um bom tempo..."

# game/chapters/chapter2/script/ch2sc17.rpy:246
translate brazil ch2sc17_7625645f:

#   astt "Do they know each other? But he's so young... he can't be much older than me? Maybe a year or two."
    astt "Eles se conhecem? Mas ele é tão jovem... não pode ser muito mais velho do que eu, né? Talvez um ou dois anos."

# game/chapters/chapter2/script/ch2sc17.rpy:247
translate brazil ch2sc17_e25bf5cd:

#   astt "I'm turning 19 in two weeks, maybe... maybe daddy could invite him?"
    astt "Vou fazer 19 anos daqui a duas semanas, talvez... talvez papai possa convidá-lo?"

# game/chapters/chapter2/script/ch2sc17.rpy:250
translate brazil ch2sc17_6a5710d1:

#   astt "There's not been any cute boys in Riverside since I arrived from Luxenford..."
    astt "Não apareceu nenhum rapaz bonito em Riverside desde que cheguei de Luxemburgo..."

# game/chapters/chapter2/script/ch2sc17.rpy:251
translate brazil ch2sc17_e804709f:

#   astt "If he's friends with daddy, surely daddy would approve of him? *Giggles* I'm getting ahead of myself!"
    astt "Se ele é amigo do papai, com certeza o papai aprovaria, né? *Risos* Estou me precipitando!"

# game/chapters/chapter2/script/ch2sc17.rpy:252
translate brazil ch2sc17_d078b272:

#   astt "I haven't even met him!"
    astt "Eu nem sequer o conheci!"

# game/chapters/chapter2/script/ch2sc17.rpy:254
translate brazil ch2sc17_ca78d52b:

#   gb "*Calling out* Asta, sweetie? Are you nearby? I could use a bucket of water for dousing the steel."
    gb "*Chamando* Asta, querido? Você está por perto? Eu preciso de um balde d'água para apagar o fogo."

# game/chapters/chapter2/script/ch2sc17.rpy:255
translate brazil ch2sc17_cc6cd144:

#   ast "*Shouts* Yes, I'll go fetch a fresh bucket daddy!"
    ast "*Grita* Sim, vou buscar um balde novo, papai!"

# game/chapters/chapter2/script/ch2sc17.rpy:256
translate brazil ch2sc17_bf2c2621:

#   gb "That's my girl! Don't fill it too much, otherwise you won't be able to carry it."
    gb "Essa é a minha garota! Não a encha demais, senão você não vai conseguir carregá-la."

