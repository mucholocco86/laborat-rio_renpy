# game/chapters/chapter2/script/ch2sc14.rpy:84
translate brazil ch2sc14_d7edd024_1:

#   "."
    "."

# game/chapters/chapter2/script/ch2sc14.rpy:85
translate brazil ch2sc14_8dabefc6_1:

#   ".."
    "..."

# game/chapters/chapter2/script/ch2sc14.rpy:15
translate brazil ch2sc14_825bbb2f:

#   mc "Hey, listen..."
    mc "Ei, escuta..."

# game/chapters/chapter2/script/ch2sc14.rpy:17
translate brazil ch2sc14_f6f5c80c:

#   al "Jerk!"
    al "Idiota!"

# game/chapters/chapter2/script/ch2sc14.rpy:19
translate brazil ch2sc14_05500ff6:

#   mc "Huh?"
    mc "Huh?"

# game/chapters/chapter2/script/ch2sc14.rpy:20
translate brazil ch2sc14_bb9391d2:

#   mc "Hey, what's wrong?"
    mc "Ei, o que houve?"

# game/chapters/chapter2/script/ch2sc14.rpy:22
translate brazil ch2sc14_cec67d77:

#   al "You’re a jerk."
    al "Você é um idiota."

# game/chapters/chapter2/script/ch2sc14.rpy:24
translate brazil ch2sc14_54696dae:

#   mc "What did I do?"
    mc "O que eu fiz?"

# game/chapters/chapter2/script/ch2sc14.rpy:26
translate brazil ch2sc14_9fc4a903:

#   al "It’s what you said."
    al "Foi o que você disse."

# game/chapters/chapter2/script/ch2sc14.rpy:28
translate brazil ch2sc14_7fdbab1b:

#   mc "Alice, you have to be more specific."
    mc "Alice, você precisa ser mais específica."

# game/chapters/chapter2/script/ch2sc14.rpy:30
translate brazil ch2sc14_c1a162d9:

#   al "'There’s no one else I would count on for this journey.'"
    al "'Não há mais ninguém em quem eu confiaria para esta jornada.'"

# game/chapters/chapter2/script/ch2sc14.rpy:31
translate brazil ch2sc14_4fe108e2:

#   al "You said that to Flynn."
    al "Você disse isso para Flynn."

# game/chapters/chapter2/script/ch2sc14.rpy:33
translate brazil ch2sc14_58e39ebb:

#   mct "Oh... she must have felt sidelined."
    mct "Ah... ela deve ter se sentido deixada de lado."

# game/chapters/chapter2/script/ch2sc14.rpy:34
translate brazil ch2sc14_bb72afb0:

#   mct "Thinking back, we always talked about becoming adventurers together."
    mct "Pensando bem, sempre conversávamos sobre nos tornarmos aventureiros juntos."

# game/chapters/chapter2/script/ch2sc14.rpy:36
translate brazil ch2sc14_8ad0e081:

#   mc "Alice... you’re just as silly as you’ve always been."
    mc "Alice... você continua tão boba como sempre foi."

# game/chapters/chapter2/script/ch2sc14.rpy:38
translate brazil ch2sc14_7338c216:

#   al "I’m not in the mood."
    al "Não estou com vontade."

# game/chapters/chapter2/script/ch2sc14.rpy:40
translate brazil ch2sc14_3c6b536d:

#   mc "Listen... I stand by what I said. Because it’s the truth."
    mc "Escute... Eu mantenho o que disse. Porque é a verdade."

# game/chapters/chapter2/script/ch2sc14.rpy:41
translate brazil ch2sc14_dea7eacf:

#   mc "This journey I’m on..."
    mc "Esta jornada em que estou..."

# game/chapters/chapter2/script/ch2sc14.rpy:43
translate brazil ch2sc14_78293d7c:

#   mc "It will be dangerous. I’m going into it mostly blind, to places I’ve never been, searching for answers that will-"
    mc "Vai ser perigoso. Estou entrando nisso praticamente às cegas, em lugares onde nunca estive, em busca de respostas que..."

# game/chapters/chapter2/script/ch2sc14.rpy:45
translate brazil ch2sc14_cd80e478:

#   mc "-Will put those around me in danger, Alice."
    mc "—Isso colocará em perigo as pessoas ao meu redor, Alice."

# game/chapters/chapter2/script/ch2sc14.rpy:47
translate brazil ch2sc14_d5841138:

#   mc "I knew Eliza’s father, and he asked me to look after her."
    mc "Eu conhecia o pai de Eliza, e ele me pediu para cuidar dela."

# game/chapters/chapter2/script/ch2sc14.rpy:48
translate brazil ch2sc14_1347d373:

#   mc "It was the last thing he asked before he..."
    mc "Foi a última coisa que ele perguntou antes de..."

# game/chapters/chapter2/script/ch2sc14.rpy:50
translate brazil ch2sc14_fee5bfa5:

#   mc "Died."
    mc "Morreu."

# game/chapters/chapter2/script/ch2sc14.rpy:52
translate brazil ch2sc14_2056fed7:

#   mc "Eliza is someone I’ve grown to trust. She has saved my life."
    mc "Eliza é alguém em quem aprendi a confiar. Ela salvou minha vida."

# game/chapters/chapter2/script/ch2sc14.rpy:54
translate brazil ch2sc14_31e05e04:

#   mc "She's the person most suited to accompany me currently."
    mc "Ela é a pessoa mais indicada para me acompanhar no momento."

# game/chapters/chapter2/script/ch2sc14.rpy:56
translate brazil ch2sc14_1954cbd2:

#   mc "That doesn't mean that I don’t care for our friendship, okay? We’ve both changed Alice."
    mc "Isso não significa que eu não me importe com a nossa amizade, ok? Nós duas mudamos, Alice."

# game/chapters/chapter2/script/ch2sc14.rpy:58
translate brazil ch2sc14_4e66f8fd:

#   mc "But... as you told me earlier, those two kids we used to be... "
    mc "Mas... como você me disse antes, aqueles dois garotos que éramos... "

# game/chapters/chapter2/script/ch2sc14.rpy:60
translate brazil ch2sc14_78efa74c:

#   mc "They are still a part of us. You will always be important to me."
    mc "Eles ainda fazem parte de nós. Você sempre será importante para mim."

# game/chapters/chapter2/script/ch2sc14.rpy:62
translate brazil ch2sc14_940ba71c:

#   mc "That is exactly why I can’t bring you along on this journey. I won’t lose you. Not again."
    mc "É exatamente por isso que não posso te levar nessa jornada. Não vou te perder. Nunca mais."

# game/chapters/chapter2/script/ch2sc14.rpy:64
translate brazil ch2sc14_def904e6:

#   al "[mc]..."
    al "[mc]..."

# game/chapters/chapter2/script/ch2sc14.rpy:66
translate brazil ch2sc14_8a39b42f:

#   al "I-I just wish you didn’t have to leave so soon."
    al "Eu só queria que você não tivesse que ir embora tão cedo."

# game/chapters/chapter2/script/ch2sc14.rpy:68
translate brazil ch2sc14_582b892e:

#   al "There’s so much I want to talk about ... everything that's happened in the past ten years."
    al "Há tanta coisa que eu quero contar... tudo o que aconteceu nos últimos dez anos."

# game/chapters/chapter2/script/ch2sc14.rpy:70
translate brazil ch2sc14_9eb040a3:

#   al "Everything about now... finding each other again."
    al "Tudo sobre o momento atual... reencontrar um ao outro."

# game/chapters/chapter2/script/ch2sc14.rpy:72
translate brazil ch2sc14_586c7aed:

#   mc "Alice, I promise this isn’t goodbye. We’ll see each other again."
    mc "Alice, prometo que isto não é um adeus. Nós nos veremos novamente."

# game/chapters/chapter2/script/ch2sc14.rpy:74
translate brazil ch2sc14_0003c9a6:

#   al "You promise?"
    al "Você promete?"

# game/chapters/chapter2/script/ch2sc14.rpy:76
translate brazil ch2sc14_25cb6354:

#   mc "Always and forever."
    mc "Sempre e para sempre."

# game/chapters/chapter2/script/ch2sc14.rpy:77
translate brazil ch2sc14_f24d24a8:

#   "You feel Alice’s soft hand rest on yours as she smiles gently."
    "Você sente a mão macia de Alice repousar sobre a sua enquanto ela sorri gentilmente."

# game/chapters/chapter2/script/ch2sc14.rpy:79
translate brazil ch2sc14_809f5dce:

#   al "Always and forever."
    al "Sempre e para sempre."

# game/chapters/chapter2/script/ch2sc14.rpy:81
translate brazil ch2sc14_d7edd024:

#   "."
    "."

# game/chapters/chapter2/script/ch2sc14.rpy:82
translate brazil ch2sc14_8dabefc6:

#   ".."
    "..."

# game/chapters/chapter2/script/ch2sc14.rpy:87
translate brazil ch2sc14_9b89265b:

#   al "W-We should probably get going. Mother won’t let me out of her sight for a week if I’m late."
    al "É melhor irmos. Mamãe não me deixa sair de perto dela por uma semana se eu me atrasar."

# game/chapters/chapter2/script/ch2sc14.rpy:89
translate brazil ch2sc14_dc2e7675:

#   mc "After all the creatures I’ve encountered over the years, your mother still manages to terrify me."
    mc "Depois de todas as criaturas que encontrei ao longo dos anos, sua mãe ainda consegue me aterrorizar."

# game/chapters/chapter2/script/ch2sc14.rpy:91
translate brazil ch2sc14_7e08421c:

#   mc "C’mon, let’s get you home."
    mc "Vamos, vamos te levar para casa."

# game/chapters/chapter2/script/ch2sc14.rpy:99
translate brazil ch2sc14_186b9113:

#   al "Thank you for walking me home. You always did this, even when we were little."
    al "Obrigada por me acompanhar até em casa. Você sempre fazia isso, mesmo quando éramos crianças."

# game/chapters/chapter2/script/ch2sc14.rpy:101
translate brazil ch2sc14_d16169be:

#   mc "Yeah... I do remember someone always being a scaredy cat."
    mc "Sim... eu me lembro de alguém que sempre era medroso."

# game/chapters/chapter2/script/ch2sc14.rpy:103
translate brazil ch2sc14_b2514a72:

#   al "Hey! Y-You never know what could be out there! And it was you who told me about trolls..."
    al "Ei! V-Você nunca sabe o que pode haver lá fora! E foi você quem me falou sobre os trolls..."

# game/chapters/chapter2/script/ch2sc14.rpy:105
translate brazil ch2sc14_6e6f6bcc:

#   mc "Heh. I guess I’m partly to blame."
    mc "Heh. Acho que a culpa é parcialmente minha."

# game/chapters/chapter2/script/ch2sc14.rpy:107
translate brazil ch2sc14_9fff46c0:

#   mc "Anyway, I better get going. Do give my regards to your mother."
    mc "Bem, é melhor eu ir. Mande lembranças para sua mãe."

# game/chapters/chapter2/script/ch2sc14.rpy:109
translate brazil ch2sc14_0dd2941d:

#   al "I’m sure she'll be thrilled to hear that you’re still alive, after all these years."
    al "Tenho certeza de que ela ficará emocionada ao saber que você ainda está vivo, depois de todos esses anos."

# game/chapters/chapter2/script/ch2sc14.rpy:111
translate brazil ch2sc14_c13f86c7:

#   al "Oh, and [mc]..."
    al "Ah, e [mc]..."

# game/chapters/chapter2/script/ch2sc14.rpy:113
translate brazil ch2sc14_389e14e1:

#   al "If you break your promise... not even the Divines could hide you from my wrath."
    al "Se você quebrar sua promessa... nem mesmo os Divinos poderão protegê-lo da minha ira."

# game/chapters/chapter2/script/ch2sc14.rpy:115
translate brazil ch2sc14_864c7974:

#   mc "Alice..."
    mc "Alice..."

# game/chapters/chapter2/script/ch2sc14.rpy:117
translate brazil ch2sc14_4e8d96e0:

#   al "I know. You didn’t intend to break the old promise. Life just happened that way... out of our control."
    al "Eu sei. Você não tinha a intenção de quebrar a antiga promessa. A vida simplesmente aconteceu assim... fora do nosso controle."

# game/chapters/chapter2/script/ch2sc14.rpy:119
translate brazil ch2sc14_7900965f:

#   mc "That’s why I made the promise again. We’re adults now. Life doesn't just happen to us anymore. We can take charge ourselves."
    mc "Por isso, repeti a promessa. Agora somos adultos. A vida não acontece mais por acaso. Podemos assumir o controle."

# game/chapters/chapter2/script/ch2sc14.rpy:121
translate brazil ch2sc14_0a9da87c:

#   al "That makes sense. Wait, when did you become so wise?"
    al "Faz sentido. Espera aí, quando você ficou tão sábio?"

# game/chapters/chapter2/script/ch2sc14.rpy:123
translate brazil ch2sc14_c60099c9:

#   mc "I’ve always been the wise one of the two of us."
    mc "Eu sempre fui a mais sábia entre nós duas."

# game/chapters/chapter2/script/ch2sc14.rpy:125
translate brazil ch2sc14_ee622987:

#   al "As if!"
    al "Como se!"

# game/chapters/chapter2/script/ch2sc14.rpy:127
translate brazil ch2sc14_0674b517:

#   al "Thank you for being here with me. And comforting me. It’s almost as if you never left."
    al "Obrigada por estar aqui comigo. E por me confortar. É quase como se você nunca tivesse ido embora."

# game/chapters/chapter2/script/ch2sc14.rpy:129
translate brazil ch2sc14_9e825388:

#   mc "I don’t know when I will see you again, Alice, but... I look forward to it."
    mc "Não sei quando nos veremos novamente, Alice, mas... estou ansioso por isso."

# game/chapters/chapter2/script/ch2sc14.rpy:132
translate brazil ch2sc14_a6ffb52e:

#   "Before you can react, you feel the warmth of Alice’s lips against your cheek."
    "Antes que você possa reagir, sente o calor dos lábios de Alice contra sua bochecha."

# game/chapters/chapter2/script/ch2sc14.rpy:133
translate brazil ch2sc14_abe4a9d3:

#   "The softness of her lips is unlike anything you've felt before."
    "A maciez dos lábios dela é diferente de tudo que você já sentiu antes."

# game/chapters/chapter2/script/ch2sc14.rpy:134
translate brazil ch2sc14_6cc3f4d3:

#   "She continues to caress your cheek with her lips for a few moments."
    "Ela continua acariciando sua bochecha com os lábios por alguns instantes."

# game/chapters/chapter2/script/ch2sc14.rpy:136
translate brazil ch2sc14_c96642c6:

#   mc "."
    mc "."

# game/chapters/chapter2/script/ch2sc14.rpy:137
translate brazil ch2sc14_3e0c0ef9:

#   mc ".."
    mc "..."

# game/chapters/chapter2/script/ch2sc14.rpy:138
translate brazil ch2sc14_0d467987:

#   mc "What was that for?"
    mc "Para que serviu isso?"

# game/chapters/chapter2/script/ch2sc14.rpy:140
translate brazil ch2sc14_0e7e3dff:

#   al "Just something to remember me by, until we meet again."
    al "Apenas uma lembrança para você guardar de mim, até nos encontrarmos novamente."

# game/chapters/chapter2/script/ch2sc14.rpy:142
translate brazil ch2sc14_a1076557:

#   mc "Heh... silly."
    mc "Heh... bobinho."

# game/chapters/chapter2/script/ch2sc14.rpy:147
translate brazil ch2sc14_00d63777:

#   mc "And that?"
    mc "E isso?"

# game/chapters/chapter2/script/ch2sc14.rpy:149
translate brazil ch2sc14_5f8e7e8f:

#   al "Just 'cause. Goodnight!"
    al "Só porque sim. Boa noite!"

# game/chapters/chapter2/script/ch2sc14.rpy:150
translate brazil ch2sc14_0fcd32b6:

#   "Alice is happy you escorted her home, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Alice está feliz por você tê-la acompanhado até em casa, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc14.rpy:153
translate brazil ch2sc14_515eedd7:

#   mc "Goodnight Alice."
    mc "Boa noite, Alice."

# game/chapters/chapter2/script/ch2sc14.rpy:156
translate brazil ch2sc14_526dc918:

#   "You head back to the tavern, still feeling a faint tingling sensation on your cheek."
    "Você retorna à taverna, ainda sentindo uma leve sensação de formigamento na bochecha."

