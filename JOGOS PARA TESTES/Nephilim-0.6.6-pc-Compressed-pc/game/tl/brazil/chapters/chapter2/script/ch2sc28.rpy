# ARQUIVO: game/chapters/chapter2/script/ch2sc28.rpy DIALOGOS: 46


# game/chapters/chapter2/script/ch2sc28.rpy:15
translate brazil ch2sc28_60c59972:

#   el "*Sigh* We’ve been traveling for days and we still haven't found a tavern!"
    el "*Suspiro* Já faz dias que estamos viajando e ainda não encontramos uma taverna!"

# game/chapters/chapter2/script/ch2sc28.rpy:17
translate brazil ch2sc28_828a61d4:

#   mc "Are you saying you’re too fancy to sleep on the ground?"
    mc "Você está dizendo que é chique demais para dormir no chão?"

# game/chapters/chapter2/script/ch2sc28.rpy:19
translate brazil ch2sc28_bf7e23e2:

#   el "*Giggles* Yes... that's exactly what I’m saying!"
    el "*Risos* Sim... é exatamente isso que estou dizendo!"

# game/chapters/chapter2/script/ch2sc28.rpy:21
translate brazil ch2sc28_0333188f:

#   el "Now, let’s find a tavern! I’m thirsty for any type of ale, and my butt desperately needs the comfort of a bed!"
    el "Vamos encontrar uma taverna! Estou com sede de qualquer tipo de cerveja, e meu traseiro precisa desesperadamente do conforto de uma cama!"

# game/chapters/chapter2/script/ch2sc28.rpy:23
translate brazil ch2sc28_22d3894e:

#   mc "Ales do sound good."
    mc "Cervejas parecem uma boa pedida."

# game/chapters/chapter2/script/ch2sc28.rpy:25
translate brazil ch2sc28_e773ea3f:

#   mc "Alright, let’s see if we can find a tavern."
    mc "Muito bem, vamos ver se conseguimos encontrar uma taverna."

# game/chapters/chapter2/script/ch2sc28.rpy:26
translate brazil ch2sc28_27387c1a:

#   mc "I’ve noticed more travelers on the road the last few miles."
    mc "Notei um aumento no número de viajantes na estrada nos últimos quilômetros."

# game/chapters/chapter2/script/ch2sc28.rpy:28
translate brazil ch2sc28_cc32842a:

#   mc "Are you thinking what I’m thinking?"
    mc "Você está pensando o mesmo que eu?"

# game/chapters/chapter2/script/ch2sc28.rpy:30
translate brazil ch2sc28_939dcbae:

#   el "Hmmm... We’ve seen more travelers recently?"
    el "Hum... Será que temos visto mais viajantes ultimamente?"

# game/chapters/chapter2/script/ch2sc28.rpy:31
translate brazil ch2sc28_06e114cb:

#   el "And more travelers means there’s a place to rest nearby, either a settlement or tavern?"
    el "E mais viajantes significa que há um lugar para descansar por perto, seja um povoado ou uma taverna?"

# game/chapters/chapter2/script/ch2sc28.rpy:33
translate brazil ch2sc28_88d55fc3:

#   mc "Exactly, let’s pick up the pace. I can see a mug with my name on it."
    mc "Exatamente, vamos acelerar o ritmo. Já consigo imaginar uma caneca com meu nome."

# game/chapters/chapter2/script/ch2sc28.rpy:38
translate brazil ch2sc28_ae4acd4c:

#   el "Yes! Let’s go! Before they drink all our ale!"
    el "Sim! Vamos lá! Antes que eles bebam toda a nossa cerveja!"

# game/chapters/chapter2/script/ch2sc28.rpy:40
translate brazil ch2sc28_958869cc:

#   mc "What do you think you’re doing?"
    mc "O que você pensa que está fazendo?"

# game/chapters/chapter2/script/ch2sc28.rpy:42
translate brazil ch2sc28_0badd016:

#   el "I’m mounting you silly!"
    el "Estou te montando, bobinho!"

# game/chapters/chapter2/script/ch2sc28.rpy:43
translate brazil ch2sc28_e8f17212:

#   el "Don't you like having my legs wrapped around you?"
    el "Você não gosta de sentir minhas pernas enroladas em você?"

# game/chapters/chapter2/script/ch2sc28.rpy:45
translate brazil ch2sc28_0da6aec9:

#   mc "When you put it like that..."
    mc "Quando você coloca dessa forma..."

# game/chapters/chapter2/script/ch2sc28.rpy:47
translate brazil ch2sc28_8afe6362:

#   el "That’s what I like to hear!"
    el "É isso que eu gosto de ouvir!"

# game/chapters/chapter2/script/ch2sc28.rpy:48
translate brazil ch2sc28_d4fc5473:

#   el "*Giggling* Now, to the nearest tavern my steed!"
    el "*Risos* Agora, para a taverna mais próxima, meu corcel!"

# game/chapters/chapter2/script/ch2sc28.rpy:50
translate brazil ch2sc28_4a5138ea:

#   mc "Buckle up, kitten. You’re in for a ride!"
    mc "Aperte os cintos, gatinha. Você vai embarcar numa aventura!"

# game/chapters/chapter2/script/ch2sc28.rpy:55
translate brazil ch2sc28_0a9bfe84:

#   mct "*Chuckles* This'll get her heart rate up."
    mct "*Risos* Isso vai acelerar os batimentos cardíacos dela."

# game/chapters/chapter2/script/ch2sc28.rpy:61
translate brazil ch2sc28_77fb37ce:

#   el "{b}Aaaaiiihihaaaa!{/b}"
    el "{b}Aaaaaaaaah!{/b}"

# game/chapters/chapter2/script/ch2sc28.rpy:62
translate brazil ch2sc28_66c37ec8:

#   "You set off at full-speed, the world around you turns to a blur as you zoom through the woods."
    "Você parte em alta velocidade, o mundo ao seu redor se transforma em um borrão enquanto você atravessa a floresta em alta velocidade."

# game/chapters/chapter2/script/ch2sc28.rpy:64
translate brazil ch2sc28_69f6d029:

#   el "{size=+3}{b}*Squeals loudly* OH MY GAWWWHHD!!{/b}{/size}"
    el "{size=+3}{b}*Grita alto* MEU DEUS DO CÉU!!{/b}{/size}"

# game/chapters/chapter2/script/ch2sc28.rpy:65
translate brazil ch2sc28_8097e8ed:

#   el "{size=+3}{b}*Squeals loudly* M-MY EYES CAN'T KEEP UP!! AYYYHH!!{/b}{/size}"
    el "{size=+3}{b}*Grita alto* M-MEUS OLHOS NÃO CONSEGUEM ACOMPANHAR!! AYYYHH!!{/b}{/size}"

# game/chapters/chapter2/script/ch2sc28.rpy:68
translate brazil ch2sc28_20a70026:

#   uk "Hmm, nothing interesting ever happens in these parts..."
    uk "Hum, nada de interessante acontece por estas bandas..."

# game/chapters/chapter2/script/ch2sc28.rpy:74
translate brazil ch2sc28_68f6c49d:

#   el "Aaahh! That was wild!!"
    el "Aaahh! Isso foi incrível!!"

# game/chapters/chapter2/script/ch2sc28.rpy:76
translate brazil ch2sc28_3e60aae6:

#   el "Thank you for the ride, handsome."
    el "Obrigado pela carona, bonitão."

# game/chapters/chapter2/script/ch2sc28.rpy:77
translate brazil ch2sc28_5e085525:

#   el "*Whispers* {size=-10}{b}My legs are trembling.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Minhas pernas estão tremendo.{/b}{/size}"

# game/chapters/chapter2/script/ch2sc28.rpy:80
translate brazil ch2sc28_b295b0b8:

#   el "Mwaaah!"
    el "Uau!"

# game/chapters/chapter2/script/ch2sc28.rpy:81
translate brazil ch2sc28_c1a0a8d1:

#   "Her kiss lingers for several seconds before she breaks away."
    "O beijo dela dura alguns segundos antes que ela se afaste."

# game/chapters/chapter2/script/ch2sc28.rpy:83
translate brazil ch2sc28_c9fd12c2:

#   el "Definitely won’t be the last time I ride you."
    el "Com certeza não será a última vez que eu te monto."

# game/chapters/chapter2/script/ch2sc28.rpy:85
translate brazil ch2sc28_0e138e3d:

#   el "*Mwah* Let's get your eyes back to normal before we head inside... Mmmh."
    el "*Mwah* Vamos fazer seus olhos voltarem ao normal antes de entrarmos... Mmmh."

# game/chapters/chapter2/script/ch2sc28.rpy:89
translate brazil ch2sc28_a3390d94:

#   el "Come, come! I need to sit down before my legs turn to jelly!"
    el "Vamos, vamos! Preciso sentar antes que minhas pernas virem gelatina!"

# game/chapters/chapter2/script/ch2sc28.rpy:90
translate brazil ch2sc28_641e88dc:

#   el "My head is even spinning slightly after that ride..."
    el "Minha cabeça está até girando um pouco depois desse passeio..."

# game/chapters/chapter2/script/ch2sc28.rpy:92
translate brazil ch2sc28_187f2320:

#   mc "Ladies first."
    mc "As damas primeiro."

# game/chapters/chapter2/script/ch2sc28.rpy:94
translate brazil ch2sc28_3bc3d6f0:

#   el "My, my... What a gentleman!"
    el "Nossa, que cavalheiro!"

# game/chapters/chapter2/script/ch2sc28.rpy:95
translate brazil ch2sc28_bec26797:

#   el "*Whispers* {size=-10}{b}I could get used to this...{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Eu poderia me acostumar com isso...{/b}{/size}"

# game/chapters/chapter2/script/ch2sc28.rpy:101
translate brazil ch2sc28_25c84484:

#   "You reach a tavern after a few miles."
    "Após alguns quilômetros, você chega a uma taverna."

# game/chapters/chapter2/script/ch2sc28.rpy:103
translate brazil ch2sc28_e0d52e04:

#   el "Ahh! Would you look at that! I knew a tavern was nearby!"
    el "Ah! Olha só! Eu sabia que havia uma taverna por perto!"

# game/chapters/chapter2/script/ch2sc28.rpy:105
translate brazil ch2sc28_8266d58c:

#   mc "Oh, did you now? So what was all that talk about you never finding a bed again?"
    mc "Ah, é mesmo? Então, o que era tudo aquilo sobre você nunca mais encontrar uma cama?"

# game/chapters/chapter2/script/ch2sc28.rpy:106
translate brazil ch2sc28_1d134fb3:

#   mc "That you would have to make your own bed out of leaves and carry it with you..."
    mc "Que você teria que fazer sua própria cama com folhas e carregá-la consigo..."

# game/chapters/chapter2/script/ch2sc28.rpy:108
translate brazil ch2sc28_221ce8a4:

#   el "Okay. I may have been a bit dramatic... I was desperate, alright?"
    el "Ok. Talvez eu tenha exagerado um pouco... Eu estava desesperada, tá bom?"

# game/chapters/chapter2/script/ch2sc28.rpy:110
translate brazil ch2sc28_c938a0f9:

#   mc "You sure were."
    mc "Com certeza."

# game/chapters/chapter2/script/ch2sc28.rpy:112
translate brazil ch2sc28_80709092:

#   el "Hush! Let’s go inside and enjoy our evening!"
    el "Silêncio! Vamos entrar e aproveitar a nossa noite!"

# game/chapters/chapter2/script/ch2sc28.rpy:114
translate brazil ch2sc28_2221ed82:

#   mc "After you, m’lady."
    mc "Depois de você, minha senhora."

# game/chapters/chapter2/script/ch2sc28.rpy:116
translate brazil ch2sc28_4f6b4563:

#   el "*Giggles* Why thank you. Such a gentleman."
    el "*Risos* Muito obrigada. Um verdadeiro cavalheiro."

