# ARQUIVO: game/chapters/chapter2/script/ch2sc9.rpy DIALOGOS: 172


# game/chapters/chapter2/script/ch2sc9.rpy:14
translate brazil ch2sc9_e071cba8:

#   mct "I think I know where she went."
    mct "Acho que sei para onde ela foi."

# game/chapters/chapter2/script/ch2sc9.rpy:16
translate brazil ch2sc9_dbb7d7cf:

#   mct "She used to come here whenever she felt annoyed or sad."
    mct "Ela costumava vir aqui sempre que se sentia irritada ou triste."

# game/chapters/chapter2/script/ch2sc9.rpy:18
translate brazil ch2sc9_0ba37ca7:

#   mct "There she is."
    mct "Ali está ela."

# game/chapters/chapter2/script/ch2sc9.rpy:19
translate brazil ch2sc9_ec4fa7db:

#   mct "Not exactly the best hiding spot. I'd always find her here."
    mct "Não era exatamente o melhor esconderijo. Eu sempre a encontrava aqui."

# game/chapters/chapter2/script/ch2sc9.rpy:21
translate brazil ch2sc9_eabe5aae:

#   "Alice seems unaware of your approach."
    "Alice parece não ter percebido sua aproximação."

# game/chapters/chapter2/script/ch2sc9.rpy:23
translate brazil ch2sc9_7633ed19:

#   al_t "Hrrr... he's back."
    al_t "Hrrr... ele voltou."

# game/chapters/chapter2/script/ch2sc9.rpy:24
translate brazil ch2sc9_3407e409:

#   al_t "I-I never thought I'd see him again."
    al_t "Eu nunca pensei que o veria novamente."

# game/chapters/chapter2/script/ch2sc9.rpy:26
translate brazil ch2sc9_4ed9c469:

#   al_t "Maybe I was a little harsh on him? I just had no idea how to act..."
    al_t "Talvez eu tenha sido um pouco dura com ele? Eu simplesmente não sabia como agir..."

# game/chapters/chapter2/script/ch2sc9.rpy:28
translate brazil ch2sc9_3a4dbf5b:

#   al_t "Ten long years... half of our lives."
    al_t "Dez longos anos... metade de nossas vidas."

# game/chapters/chapter2/script/ch2sc9.rpy:29
translate brazil ch2sc9_49fd8a71:

#   al_t "And now he just appears without warning... no letters."
    al_t "E agora ele simplesmente aparece sem aviso prévio... sem nenhuma carta."

# game/chapters/chapter2/script/ch2sc9.rpy:32
translate brazil ch2sc9_2c175917:

#   al_t "Does he even care about me at all?!"
    al_t "Ele se importa comigo?!"

# game/chapters/chapter2/script/ch2sc9.rpy:34
translate brazil ch2sc9_19e03056:

#   al_t "I’m so glad he's alive though."
    al_t "Ainda bem que ele está vivo."

# game/chapters/chapter2/script/ch2sc9.rpy:35
translate brazil ch2sc9_424d5877:

#   al_t "He seemed okay... healthy even... attractive."
    al_t "Ele parecia bem... até saudável... atraente."

# game/chapters/chapter2/script/ch2sc9.rpy:37
translate brazil ch2sc9_a02a0235:

#   al_t "What am I even saying? It’s [mc]."
    al_t "O que é que eu estou dizendo? É [mc]."

# game/chapters/chapter2/script/ch2sc9.rpy:39
translate brazil ch2sc9_0f1108c5:

#   al_t "My thoughts are clearly scrambled after seeing him again."
    al_t "Meus pensamentos estão claramente confusos depois de vê-lo novamente."

# game/chapters/chapter2/script/ch2sc9.rpy:41
translate brazil ch2sc9_e6abb694:

#   mc "Alice?"
    mc "Alice?"

# game/chapters/chapter2/script/ch2sc9.rpy:45
translate brazil ch2sc9_7bd05a66:

#   al "!!"
    al "!!"

# game/chapters/chapter2/script/ch2sc9.rpy:47
translate brazil ch2sc9_5b420b46:

#   al "Oh, it’s {b}you{/b}."
    al "Ah, é {b} você{/b}."

# game/chapters/chapter2/script/ch2sc9.rpy:49
translate brazil ch2sc9_ba4a0c2c:

#   mc "Listen Al... I-I’m sorry."
    mc "Escuta, Al... M-Me desculpe."

# game/chapters/chapter2/script/ch2sc9.rpy:51
translate brazil ch2sc9_10c34dae:

#   al "You’re sorry... really? That's the best you can do?"
    al "Você está arrependido... mesmo? É só isso que você consegue fazer?"

# game/chapters/chapter2/script/ch2sc9.rpy:53
translate brazil ch2sc9_fcbd18e0:

#   mc "*Sigh* ..."
    mc "*Suspirar* ..."

# game/chapters/chapter2/script/ch2sc9.rpy:55
translate brazil ch2sc9_435077a4:

#   mc "Alice, you know that doesn’t even begin to come close to how I feel about being gone this long."
    mc "Alice, você sabe que isso nem chega perto de descrever como me sinto por estar fora há tanto tempo."

# game/chapters/chapter2/script/ch2sc9.rpy:57
translate brazil ch2sc9_668b4e4f:

#   mc "You were-... are my best friend."
    mc "Você era... é meu melhor amigo."

# game/chapters/chapter2/script/ch2sc9.rpy:59
translate brazil ch2sc9_a9f29e99:

#   mc "When I promised you always and forever, I meant it."
    mc "Quando eu te prometi \"sempre e para sempre\", eu estava falando sério."

# game/chapters/chapter2/script/ch2sc9.rpy:62
translate brazil ch2sc9_72fdfe40:

#   mc "When Mama, Papa..."
    mc "Quando mamãe, papai..."

# game/chapters/chapter2/script/ch2sc9.rpy:65
translate brazil ch2sc9_9bf92d2d:

#   mc "When that happened, I had no choice but to leave."
    mc "Quando isso aconteceu, não tive outra escolha senão ir embora."

# game/chapters/chapter2/script/ch2sc9.rpy:67
translate brazil ch2sc9_a6b257f2:

#   mc "I-I found them, you know?"
    mc "Eu os encontrei, sabe?"

# game/chapters/chapter2/script/ch2sc9.rpy:69
translate brazil ch2sc9_2ffec222:

#   mc "Lying there, lifeless, covered in their own blood..."
    mc "Ali jaziam, sem vida, cobertos de seu próprio sangue..."

# game/chapters/chapter2/script/ch2sc9.rpy:71
translate brazil ch2sc9_7176b01d:

#   mc "Mama’s skin was so cold to the touch."
    mc "A pele da mamãe estava tão fria ao toque."

# game/chapters/chapter2/script/ch2sc9.rpy:72
translate brazil ch2sc9_59b8cf4b:

#   mc "No matter how much I shouted at her, or shook her... she didn't respond."
    mc "Por mais que eu gritasse com ela ou a sacudisse... ela não reagiu."

# game/chapters/chapter2/script/ch2sc9.rpy:74
translate brazil ch2sc9_d5215142:

#   al "[mc]... I..."
    al "[mc]... EU..."

# game/chapters/chapter2/script/ch2sc9.rpy:76
translate brazil ch2sc9_0555d8df:

#   mc "No, let me finish."
    mc "Não, deixe-me terminar."

# game/chapters/chapter2/script/ch2sc9.rpy:78
translate brazil ch2sc9_60f39d3a:

#   mc "Seeing M-Mama and Papa like that..."
    mc "Ver a mamãe e o papai assim..."

# game/chapters/chapter2/script/ch2sc9.rpy:80
translate brazil ch2sc9_d6fea147:

#   mc "I’m not who I used to be. I’ve changed so much from the boy you knew..."
    mc "Eu não sou mais quem eu era. Mudei muito desde o garoto que você conheceu..."

# game/chapters/chapter2/script/ch2sc9.rpy:82
translate brazil ch2sc9_f880d178:

#   mc "That night, a man named Oren found me."
    mc "Naquela noite, um homem chamado Oren me encontrou."

# game/chapters/chapter2/script/ch2sc9.rpy:85
translate brazil ch2sc9_20fe4e3e:

#   mc "He took me away. We were on the road for at least two to three years traveling from village to village..."
    mc "Ele me levou embora. Ficamos na estrada por pelo menos dois ou três anos, viajando de aldeia em aldeia..."

# game/chapters/chapter2/script/ch2sc9.rpy:86
translate brazil ch2sc9_3afa1052:

#   mc "Until we eventually reached a faraway region of Luxeron."
    mc "Até que finalmente chegamos a uma região distante de Luxeron."

# game/chapters/chapter2/script/ch2sc9.rpy:87
translate brazil ch2sc9_fcb8496a:

#   mc "The Sen'ju region, I had no way of reaching out to you..."
    mc "Na região de Sen'ju, eu não tinha como entrar em contato com vocês..."

# game/chapters/chapter2/script/ch2sc9.rpy:90
translate brazil ch2sc9_1525062e:

#   mc "He... he taught me how to survive, how to become strong."
    mc "Ele... ele me ensinou a sobreviver, a me tornar forte."

# game/chapters/chapter2/script/ch2sc9.rpy:92
translate brazil ch2sc9_db723eb0:

#   mc "I managed to get up the next day, and the day after that, and the day after that..."
    mc "Consegui levantar-me no dia seguinte, e no dia seguinte a esse, e no dia seguinte a esse..."

# game/chapters/chapter2/script/ch2sc9.rpy:94
translate brazil ch2sc9_6174fe24:

#   mc "With one goal in mind."
    mc "Com um objetivo em mente."

# game/chapters/chapter2/script/ch2sc9.rpy:95
translate brazil ch2sc9_f5700bb5:

#   mc "One thing that I had to achieve, no matter the cost."
    mc "Uma coisa que eu tinha que alcançar, não importando o custo."

# game/chapters/chapter2/script/ch2sc9.rpy:97
translate brazil ch2sc9_4d406dcb:

#   mc "{b}Avenging{/b} Mama and Papa. I need to find out who murdered my parents in cold blood that night."
    mc "{b}Vingando{/b} Mamãe e papai. Preciso descobrir quem assassinou meus pais a sangue frio naquela noite."

# game/chapters/chapter2/script/ch2sc9.rpy:101
translate brazil ch2sc9_9171cee3:

#   mc "I often dreamt about what I'd do to him."
    mc "Muitas vezes sonhei com o que faria com ele."

# game/chapters/chapter2/script/ch2sc9.rpy:104
translate brazil ch2sc9_beb140a6:

#   mc "How I would {b}KILL{/b} them, whoever the lowlife scum turns out to be. That was all I cared about, all that I trained for."
    mc "Como eu faria {b} MATAR{/b} Eles, quem quer que seja essa escória. Era só com isso que eu me importava, era para isso que eu treinava."

# game/chapters/chapter2/script/ch2sc9.rpy:106
translate brazil ch2sc9_430244d7:

#   mc "Now, ten summers later, and I'm still on that journey with no end in sight."
    mc "Agora, dez verões depois, e ainda estou nessa jornada sem fim à vista."

# game/chapters/chapter2/script/ch2sc9.rpy:108
translate brazil ch2sc9_2549c5df:

#   mc "Oren passed away two moons ago..."
    mc "Oren faleceu há duas luas..."

# game/chapters/chapter2/script/ch2sc9.rpy:110
translate brazil ch2sc9_505fa3f4:

#   mc "He asked something of me, though, before he went to the afterlife."
    mc "Ele me pediu algo, porém, antes de partir para a vida após a morte."

# game/chapters/chapter2/script/ch2sc9.rpy:111
translate brazil ch2sc9_3f6f72b9:

#   mc "After having saved my life that night, and given me the tools that I would need to avenge them..."
    mc "Depois de terem salvado minha vida naquela noite e me dado as ferramentas necessárias para vingá-los..."

# game/chapters/chapter2/script/ch2sc9.rpy:112
translate brazil ch2sc9_16c056a1:

#   mc "I gladly made my promise to him."
    mc "Com prazer, cumpri minha promessa a ele."

# game/chapters/chapter2/script/ch2sc9.rpy:114
translate brazil ch2sc9_1664808f:

#   mc "He asked of me to find his daughter and look after her."
    mc "Ele me pediu para encontrar sua filha e cuidar dela."

# game/chapters/chapter2/script/ch2sc9.rpy:115
translate brazil ch2sc9_3d54e002:

#   mc "I guess he had some regrets leaving her behind."
    mc "Acho que ele se arrependeu de tê-la deixado para trás."

# game/chapters/chapter2/script/ch2sc9.rpy:117
translate brazil ch2sc9_ab479a59:

#   mc "And that's why I’m here now, with Eliza."
    mc "E é por isso que estou aqui agora, com Eliza."

# game/chapters/chapter2/script/ch2sc9.rpy:118
translate brazil ch2sc9_6943018e:

#   mc "I need to speak to Gibbs. He must have answers about my parents."
    mc "Preciso falar com Gibbs. Ele deve ter respostas sobre meus pais."

# game/chapters/chapter2/script/ch2sc9.rpy:120
translate brazil ch2sc9_06b0bbbd:

#   mc "He knew them for many years."
    mc "Ele os conhecia há muitos anos."

# game/chapters/chapter2/script/ch2sc9.rpy:121
translate brazil ch2sc9_dac9c7dc:

#   mc "Surely he must know something... anything at all."
    mc "Certamente ele deve saber alguma coisa... qualquer coisa."

# game/chapters/chapter2/script/ch2sc9.rpy:125
translate brazil ch2sc9_e8fcc3c4:

#   al "[mc], I’m so sorry."
    al "[mc], Eu sinto muito."

# game/chapters/chapter2/script/ch2sc9.rpy:126
translate brazil ch2sc9_073d6122:

#   al "I-I completely overreacted when I saw you. I thought..."
    al "Eu reagi de forma exagerada quando te vi. Eu pensei..."

# game/chapters/chapter2/script/ch2sc9.rpy:128
translate brazil ch2sc9_797a1e6d:

#   al "I honestly don’t know what I thought..."
    al "Sinceramente, não sei o que pensei..."

# game/chapters/chapter2/script/ch2sc9.rpy:129
translate brazil ch2sc9_073bd27d:

#   al "I wasn't thinking clearly."
    al "Eu não estava pensando com clareza."

# game/chapters/chapter2/script/ch2sc9.rpy:131
translate brazil ch2sc9_f36601d8:

#   mc "I deserved it."
    mc "Eu mereci isso."

# game/chapters/chapter2/script/ch2sc9.rpy:132
translate brazil ch2sc9_e2dbdee2:

#   mc "*Chuckles* I probably deserve a lot more."
    mc "*Risos* Provavelmente mereço muito mais."

# game/chapters/chapter2/script/ch2sc9.rpy:135
translate brazil ch2sc9_e5470d81:

#   al "That we can agree on!"
    al "Nisso podemos concordar!"

# game/chapters/chapter2/script/ch2sc9.rpy:138
translate brazil ch2sc9_166390c3:

#   al "Sorry. I shouldn’t joke at a time like this."
    al "Desculpe. Não deveria fazer piadas numa hora dessas."

# game/chapters/chapter2/script/ch2sc9.rpy:140
translate brazil ch2sc9_0e06b33d:

#   mc "That never stopped you before."
    mc "Isso nunca te impediu antes."

# game/chapters/chapter2/script/ch2sc9.rpy:143
translate brazil ch2sc9_9b8b9d74:

#   al "Don't get smart with me!"
    al "Não tente me desafiar!"

# game/chapters/chapter2/script/ch2sc9.rpy:145
translate brazil ch2sc9_167814cd:

#   mc "Alright, alright."
    mc "Certo, certo."

# game/chapters/chapter2/script/ch2sc9.rpy:153
translate brazil ch2sc9_84863f66:

#   al "Hey, [mc]?"
    al "Ei, [mc]?"

# game/chapters/chapter2/script/ch2sc9.rpy:155
translate brazil ch2sc9_3433bc3c:

#   mc "Mmh?"
    mc "Hum?"

# game/chapters/chapter2/script/ch2sc9.rpy:157
translate brazil ch2sc9_e9a1de21:

#   al "How come you didn’t visit? Or at least write any letters?"
    al "Por que você não veio me visitar? Ou pelo menos não escreveu nenhuma carta?"

# game/chapters/chapter2/script/ch2sc9.rpy:158
translate brazil ch2sc9_efb1be9d:

#   al "I know you said you went to the Sen'ju region, but... don't they have ravens?"
    al "Eu sei que você disse que foi para a região de Sen'ju, mas... eles não têm corvos?"

# game/chapters/chapter2/script/ch2sc9.rpy:160
translate brazil ch2sc9_a34be39d:

#   mc "Oren forbade it."
    mc "Oren proibiu isso."

# game/chapters/chapter2/script/ch2sc9.rpy:161
translate brazil ch2sc9_fed559c0:

#   mc "The man who killed them... he wasn’t after them. He was after me."
    mc "O homem que os matou... ele não estava atrás deles. Ele estava atrás de mim."

# game/chapters/chapter2/script/ch2sc9.rpy:163
translate brazil ch2sc9_552ba573:

#   al "You??"
    al "Você??"

# game/chapters/chapter2/script/ch2sc9.rpy:164
translate brazil ch2sc9_47ac49b6:

#   al "But you were just a child! Who would want to harm a ten year old kid?!"
    al "Mas você era apenas uma criança! Quem iria querer machucar uma criança de dez anos?!"

# game/chapters/chapter2/script/ch2sc9.rpy:166
translate brazil ch2sc9_13edfcd5:

#   mc "I don't know. That's why I had to cut all ties to you... and everyone else here."
    mc "Não sei. É por isso que tive que cortar todos os laços com você... e com todos os outros aqui."

# game/chapters/chapter2/script/ch2sc9.rpy:167
translate brazil ch2sc9_663a8855:

#   mc "I couldn't risk you being hurt... no doubt that man would use anyone I care about to lure me out."
    mc "Eu não podia arriscar que você se machucasse... sem dúvida, aquele homem usaria qualquer pessoa de quem eu gosto para me atrair."

# game/chapters/chapter2/script/ch2sc9.rpy:169
translate brazil ch2sc9_e01e031c:

#   al "Now I feel like a mean bugger for being mad at you."
    al "Agora me sinto um completo idiota por ter ficado bravo com você."

# game/chapters/chapter2/script/ch2sc9.rpy:171
translate brazil ch2sc9_e0c5b8f7:

#   al "You were in the most horrible situation imaginable."
    al "Você estava na situação mais horrível que se possa imaginar."

# game/chapters/chapter2/script/ch2sc9.rpy:172
translate brazil ch2sc9_1f53ae89:

#   al "There was nothing you could do."
    al "Não havia nada que você pudesse fazer."

# game/chapters/chapter2/script/ch2sc9.rpy:174
translate brazil ch2sc9_324f4896:

#   mc "Alice, I want you to know..."
    mc "Alice, quero que você saiba..."

# game/chapters/chapter2/script/ch2sc9.rpy:176
translate brazil ch2sc9_9efa8474:

#   al "I know. You don’t have to say it."
    al "Eu sei. Você não precisa dizer isso."

# game/chapters/chapter2/script/ch2sc9.rpy:177
translate brazil ch2sc9_188cd929:

#   al "You're back now... and you're okay, that's what matters."
    al "Você voltou... e está bem, isso é o que importa."

# game/chapters/chapter2/script/ch2sc9.rpy:179
translate brazil ch2sc9_bb0eeaf4:

#   mc "Thank you."
    mc "Obrigado."

# game/chapters/chapter2/script/ch2sc9.rpy:186
translate brazil ch2sc9_d7edd024:

#   "."
    "."

# game/chapters/chapter2/script/ch2sc9.rpy:187
translate brazil ch2sc9_8dabefc6:

#   ".."
    "..."

# game/chapters/chapter2/script/ch2sc9.rpy:188
translate brazil ch2sc9_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter2/script/ch2sc9.rpy:190
translate brazil ch2sc9_36ce0888:

#   mc "*Chuckles* Can’t believe you slapped me."
    mc "*Risos* Não acredito que você me deu um tapa."

# game/chapters/chapter2/script/ch2sc9.rpy:191
translate brazil ch2sc9_318b882a:

#   mc "My ear is still ringing..."
    mc "Meu ouvido ainda está zumbindo..."

# game/chapters/chapter2/script/ch2sc9.rpy:193
translate brazil ch2sc9_bef484bf:

#   al "*Snickers* It felt good!"
    al "*Risos* Foi bom!"

# game/chapters/chapter2/script/ch2sc9.rpy:195
translate brazil ch2sc9_04c25f28:

#   mc "For one of us, perhaps."
    mc "Talvez para um de nós."

# game/chapters/chapter2/script/ch2sc9.rpy:197
translate brazil ch2sc9_4dd1066d:

#   al "Can I do it again?"
    al "Posso fazer isso de novo?"

# game/chapters/chapter2/script/ch2sc9.rpy:198
translate brazil ch2sc9_8eae491f:

#   al "I feel like I'd need to get the other cheek as well for good measure!"
    al "Acho que também precisaria receber a outra face, só para garantir!"

# game/chapters/chapter2/script/ch2sc9.rpy:200
translate brazil ch2sc9_44e6f968:

#   mc "I don’t know what’s worse, your jokes, or those hair buns."
    mc "Não sei o que é pior, suas piadas ou esses coques de cabelo."

# game/chapters/chapter2/script/ch2sc9.rpy:201
translate brazil ch2sc9_288fd0d1:

#   mc "Actually, I do know, it's definitely the hair buns."
    mc "Na verdade, eu sei sim, com certeza são os coques de cabelo."

# game/chapters/chapter2/script/ch2sc9.rpy:203
translate brazil ch2sc9_4c9e6eb7:

#   al "Heey! Leave my buns out of it! They’re {b}cute!{/b}"
    al "Ei! Deixem meus coques fora disso! Eles são {b} bonitinho!{/b}"

# game/chapters/chapter2/script/ch2sc9.rpy:205
translate brazil ch2sc9_282c1e20:

#   mc "Sure they are."
    mc "Claro que sim."

# game/chapters/chapter2/script/ch2sc9.rpy:207
translate brazil ch2sc9_e4fc4e3c:

#   al "So here we are... ten Summers later."
    al "E aqui estamos nós... dez verões depois."

# game/chapters/chapter2/script/ch2sc9.rpy:209
translate brazil ch2sc9_f8a323c7:

#   mc "Here we are."
    mc "Aqui estamos."

# game/chapters/chapter2/script/ch2sc9.rpy:211
translate brazil ch2sc9_273dd77a:

#   al "All grown up!"
    al "Já está crescido!"

# game/chapters/chapter2/script/ch2sc9.rpy:213
translate brazil ch2sc9_9ad6a62c:

#   mc "Mhmm. I guess I’m not the only one who's changed after all this time."
    mc "Hum. Acho que não sou o único que mudou depois de todo esse tempo."

# game/chapters/chapter2/script/ch2sc9.rpy:215
translate brazil ch2sc9_da16005b:

#   al "We all do. Time... experiences... life, it has that effect on a person."
    al "Todos nós passamos por isso. O tempo... as experiências... a vida, tudo isso tem esse efeito sobre uma pessoa."

# game/chapters/chapter2/script/ch2sc9.rpy:217
translate brazil ch2sc9_d4e91e8e:

#   al "But we don’t lose who we were."
    al "Mas não perdemos quem éramos."

# game/chapters/chapter2/script/ch2sc9.rpy:218
translate brazil ch2sc9_274bacb5:

#   al "We always carry our younger selves with us."
    al "Sempre carregamos conosco nossa versão mais jovem."

# game/chapters/chapter2/script/ch2sc9.rpy:220
translate brazil ch2sc9_f3caa9dd:

#   al "You’ve become strong, [mc]. I can tell."
    al "Você se tornou forte, [mc] Eu consigo perceber."

# game/chapters/chapter2/script/ch2sc9.rpy:221
translate brazil ch2sc9_94665904:

#   al "And not just physically... mentally too."
    al "E não apenas fisicamente... mentalmente também."

# game/chapters/chapter2/script/ch2sc9.rpy:223
translate brazil ch2sc9_1ebb4d23:

#   mc "I suppose I had to, to survive."
    mc "Suponho que eu tive que fazer isso para sobreviver."

# game/chapters/chapter2/script/ch2sc9.rpy:225
translate brazil ch2sc9_f561d48b:

#   al "Handsome too."
    al "Bonito também."

# game/chapters/chapter2/script/ch2sc9.rpy:227
translate brazil ch2sc9_3e4492de:

#   mc "Did you ju-"
    mc "Você acabou de..."

# game/chapters/chapter2/script/ch2sc9.rpy:229
translate brazil ch2sc9_4764d087:

#   al "No, no no no no! I-I didn’t mean to say that! It just came out..."
    al "Não, não, não, não, não! Eu não queria dizer isso! Simplesmente escapou..."

# game/chapters/chapter2/script/ch2sc9.rpy:231
translate brazil ch2sc9_bee69b68:

#   mc "You’re too cute Alice."
    mc "Você é muito fofa, Alice."

# game/chapters/chapter2/script/ch2sc9.rpy:232
translate brazil ch2sc9_31d61d46:

#   mc "Just as I remember you."
    mc "Exatamente como me lembro de você."

# game/chapters/chapter2/script/ch2sc9.rpy:234
translate brazil ch2sc9_1740a11b:

#   al "Grrr! ..."
    al "Grrr! ..."

# game/chapters/chapter2/script/ch2sc9.rpy:238
translate brazil ch2sc9_d3b18efc:

#   mc "You’ve grown up, Alice."
    mc "Você cresceu, Alice."

# game/chapters/chapter2/script/ch2sc9.rpy:240
translate brazil ch2sc9_d6af7f81:

#   al "Hrrm."
    al "Hmmm."

# game/chapters/chapter2/script/ch2sc9.rpy:242
translate brazil ch2sc9_2db55400:

#   al "Huh?"
    al "Huh?"

# game/chapters/chapter2/script/ch2sc9.rpy:244
translate brazil ch2sc9_c26879af:

#   mc "You call me strong, but I can sense you’ve been through a lot over the years."
    mc "Você me chama de forte, mas eu percebo que você passou por muita coisa ao longo dos anos."

# game/chapters/chapter2/script/ch2sc9.rpy:245
translate brazil ch2sc9_322542ed:

#   mc "Being alone with your mom all those years, having to make ends meet..."
    mc "Passar todos esses anos sozinha com sua mãe, tendo que se virar para pagar as contas..."

# game/chapters/chapter2/script/ch2sc9.rpy:247
translate brazil ch2sc9_bc914024:

#   mc "Thinking I'd died... and I can't begin to imagine the rest of it. All of that takes strength."
    mc "Pensar que eu tinha morrido... e nem consigo imaginar o resto. Tudo isso exige muita força."

# game/chapters/chapter2/script/ch2sc9.rpy:249
translate brazil ch2sc9_def904e6:

#   al "[mc]..."
    al "[mc]..."

# game/chapters/chapter2/script/ch2sc9.rpy:255
translate brazil ch2sc9_8324074c:

#   mc "You're beautiful, Alice."
    mc "Você é linda, Alice."

# game/chapters/chapter2/script/ch2sc9.rpy:258
translate brazil ch2sc9_ad10b4bb:

#   al_t "H-He thinks I'm beautiful?"
    al_t "Ele acha que eu sou bonita?"

# game/chapters/chapter2/script/ch2sc9.rpy:259
translate brazil ch2sc9_6beed4a9:

#   al_t "Please don't blush! Please don't blush!"
    al_t "Por favor, não fique vermelha! Por favor, não fique vermelha!"

# game/chapters/chapter2/script/ch2sc9.rpy:260
translate brazil ch2sc9_b16f7e85:

#   "Alice is surprised you find her beautiful. Her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Alice está surpresa por você achá-la bonita. A confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc9.rpy:264
translate brazil ch2sc9_4392e59f:

#   mc "You're such a cutie.."
    mc "Você é tão fofo(a)..."

# game/chapters/chapter2/script/ch2sc9.rpy:267
translate brazil ch2sc9_510d663b:

#   al "Cutie, huh? I guess being cute is a good thing, right?"
    al "Que gracinha, né? Acho que ser gracinha é uma coisa boa, certo?"

# game/chapters/chapter2/script/ch2sc9.rpy:268
translate brazil ch2sc9_9bfa118b:

#   mc "*Chuckles* Sure is."
    mc "*Risos* Com certeza."

# game/chapters/chapter2/script/ch2sc9.rpy:269
translate brazil ch2sc9_57c60164:

#   "Alice likes that you find her cute. Her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Alice gosta que você a ache fofa. A confiança dela aumentou. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc9.rpy:273
translate brazil ch2sc9_f9f2ff6b:

#   mc "You're the most kindhearted person I've known."
    mc "Você é a pessoa mais bondosa que eu já conheci."

# game/chapters/chapter2/script/ch2sc9.rpy:275
translate brazil ch2sc9_82279cc8:

#   al_t "People always tell me I'm kind."
    al_t "As pessoas sempre me dizem que sou gentil."

# game/chapters/chapter2/script/ch2sc9.rpy:276
translate brazil ch2sc9_5cc5562e:

#   al_t "Is that all he sees when he looks at me?"
    al_t "É só isso que ele vê quando olha para mim?"

# game/chapters/chapter2/script/ch2sc9.rpy:279
translate brazil ch2sc9_d87cd383:

#   al "R-Really? You’re not just saying that?"
    al "Sério? Você não está falando isso só por falar?"

# game/chapters/chapter2/script/ch2sc9.rpy:281
translate brazil ch2sc9_1b342136:

#   mc "If I didn’t mean it, I wouldn’t bother saying it."
    mc "Se eu não estivesse falando sério, não me daria ao trabalho de dizer."

# game/chapters/chapter2/script/ch2sc9.rpy:283
translate brazil ch2sc9_aa2cffdb:

#   al "Thank you."
    al "Obrigado."

# game/chapters/chapter2/script/ch2sc9.rpy:284
translate brazil ch2sc9_3f35483f:

#   al "It means a lot coming from you."
    al "Significa muito vindo de você."

# game/chapters/chapter2/script/ch2sc9.rpy:288
translate brazil ch2sc9_ccc3f6c9:

#   al "Stand up."
    al "Ficar de pé."

# game/chapters/chapter2/script/ch2sc9.rpy:290
translate brazil ch2sc9_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/chapters/chapter2/script/ch2sc9.rpy:291
translate brazil ch2sc9_b3fbd530:

#   mc "What are you up to?"
    mc "O que você está fazendo?"

# game/chapters/chapter2/script/ch2sc9.rpy:293
translate brazil ch2sc9_eaee9d3c:

#   al "Come on, stand up already!"
    al "Vamos, levante-se logo!"

# game/chapters/chapter2/script/ch2sc9.rpy:295
translate brazil ch2sc9_12cc0133:

#   mct "It's probably better to go along with whatever plan she has cooked up."
    mct "Provavelmente é melhor aceitar qualquer plano que ela tenha bolado."

# game/chapters/chapter2/script/ch2sc9.rpy:297
translate brazil ch2sc9_a6be913e:

#   mc "So?"
    mc "Então?"

# game/chapters/chapter2/script/ch2sc9.rpy:299
translate brazil ch2sc9_be8df24f:

#   al "There’s something I've wanted to do, ever since I slapped you."
    al "Há algo que eu quero fazer desde que te dei um tapa."

# game/chapters/chapter2/script/ch2sc9.rpy:304
translate brazil ch2sc9_ed8bfd97:

#   al_t "Heavens... It feels good to be near him again."
    al_t "Céus... É tão bom estar perto dele novamente."

# game/chapters/chapter2/script/ch2sc9.rpy:306
translate brazil ch2sc9_9a7b3be6:

#   mct ".."
    mct "..."

# game/chapters/chapter2/script/ch2sc9.rpy:307
translate brazil ch2sc9_7c6e0bb8:

#   mct "...."
    mct "..."

# game/chapters/chapter2/script/ch2sc9.rpy:308
translate brazil ch2sc9_1f3c21c3:

#   mct "Her hair carries the scent of summer... a mix of raspberries and daffodils."
    mct "Seus cabelos exalam o aroma do verão... uma mistura de framboesas e narcisos."

# game/chapters/chapter2/script/ch2sc9.rpy:310
translate brazil ch2sc9_578c8e45:

#   al_t "I've missed you so, so, so much!"
    al_t "Senti tanta, tanta, tanta saudade de você!"

# game/chapters/chapter2/script/ch2sc9.rpy:311
translate brazil ch2sc9_4d0bc7a4:

#   al_t "Can't we just stay like this for the rest of the day?"
    al_t "Não podemos ficar assim pelo resto do dia?"

# game/chapters/chapter2/script/ch2sc9.rpy:313
translate brazil ch2sc9_3b401525:

#   mct "She's squeezing me pretty tightly."
    mct "Ela está me apertando com bastante força."

# game/chapters/chapter2/script/ch2sc9.rpy:318
translate brazil ch2sc9_7c458387:

#   mct "I can't be honest with her yet, it's too risky involving her in these matters."
    mct "Ainda não posso ser sincero com ela, é muito arriscado envolvê-la nesses assuntos."

# game/chapters/chapter2/script/ch2sc9.rpy:319
translate brazil ch2sc9_bbc67828:

#   mct "One day I will tell her how I really feel."
    mct "Um dia direi a ela como realmente me sinto."

# game/chapters/chapter2/script/ch2sc9.rpy:320
translate brazil ch2sc9_e5ec4d73:

#   mct "For now... this is enough."
    mct "Por agora... isto basta."

# game/chapters/chapter2/script/ch2sc9.rpy:324
translate brazil ch2sc9_29889b43:

#   mct "She doesn't understand... there's no room in my life for friends or family."
    mct "Ela não entende... não há espaço na minha vida para amigos ou família."

# game/chapters/chapter2/script/ch2sc9.rpy:325
translate brazil ch2sc9_0f68b638:

#   mct "I have a goal that I must achieve. I must find him."
    mct "Tenho um objetivo que preciso alcançar. Preciso encontrá-lo."

# game/chapters/chapter2/script/ch2sc9.rpy:328
translate brazil ch2sc9_84f88979:

#   al_t "I love you, [mc]."
    al_t "Eu te amo, [mc]."

# game/chapters/chapter2/script/ch2sc9.rpy:329
translate brazil ch2sc9_2100d55f:

#   al_t "Someday I'll be brave enough to tell you, I promise."
    al_t "Um dia terei coragem suficiente para te contar, eu prometo."

# game/chapters/chapter2/script/ch2sc9.rpy:331
translate brazil ch2sc9_0a216086:

#   al "I needed that."
    al "Eu precisava disso."

# game/chapters/chapter2/script/ch2sc9.rpy:333
translate brazil ch2sc9_9f38d6a4:

#   mc "It seems we both did."
    mc "Parece que ambos fizemos isso."

# game/chapters/chapter2/script/ch2sc9.rpy:335
translate brazil ch2sc9_3ddf2c9b:

#   "Alice’s trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "A confiança de Alice aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc9.rpy:338
translate brazil ch2sc9_09321af7:

#   al "I'd better get going now..."
    al "É melhor eu ir agora..."

# game/chapters/chapter2/script/ch2sc9.rpy:339
translate brazil ch2sc9_4b589d31:

#   al "Mother is expecting me to deliver some herbs to the market before nightfall."
    al "Minha mãe espera que eu leve algumas ervas ao mercado antes do anoitecer."

# game/chapters/chapter2/script/ch2sc9.rpy:341
translate brazil ch2sc9_258688a5:

#   mc "Sure, I won't keep you any longer."
    mc "Claro, não vou te atrasar mais."

# game/chapters/chapter2/script/ch2sc9.rpy:342
translate brazil ch2sc9_854b16fe:

#   mc "I definitely don't want to invoke the wrath of Beth, she has enough reason to be cross with me."
    mc "Definitivamente não quero provocar a ira de Beth, ela já tem motivos suficientes para estar chateada comigo."

# game/chapters/chapter2/script/ch2sc9.rpy:344
translate brazil ch2sc9_c368c0d0:

#   al "Don't worry, I won't mention you... I don't feel like being scolded..."
    al "Não se preocupe, não vou mencionar você... Não estou com vontade de levar bronca..."

# game/chapters/chapter2/script/ch2sc9.rpy:345
translate brazil ch2sc9_4c3d4af9:

#   al "I’ll see you at the tavern later?"
    al "Te vejo mais tarde na taverna?"

# game/chapters/chapter2/script/ch2sc9.rpy:347
translate brazil ch2sc9_079b771c:

#   mc "Yeah I’ll be there."
    mc "Sim, estarei lá."

# game/chapters/chapter2/script/ch2sc9.rpy:349
translate brazil ch2sc9_91c93670:

#   al "Great!"
    al "Ótimo!"

# game/chapters/chapter2/script/ch2sc9.rpy:350
translate brazil ch2sc9_e740e240:

#   al "Don’t you dare go disappearing again!"
    al "Nem pense em desaparecer de novo!"

# game/chapters/chapter2/script/ch2sc9.rpy:353
translate brazil ch2sc9_b78d57ea:

#   al "I know a couple of people who would like a reunion!"
    al "Conheço algumas pessoas que gostariam de uma reunião!"

# game/chapters/chapter2/script/ch2sc9.rpy:359
translate brazil ch2sc9_c815905c:

#   mct "Heh.... I’m glad Eliza pushed me to go after her."
    mct "Heh... Fico feliz que Eliza tenha me incentivado a ir atrás dela."

# game/chapters/chapter2/script/ch2sc9.rpy:360
translate brazil ch2sc9_0c6ebee6:

#   mct "We needed this after all these years..."
    mct "Precisávamos disto depois de todos estes anos..."

# game/chapters/chapter2/script/ch2sc9.rpy:361
translate brazil ch2sc9_1350ab1b:

#   mct "I feel better knowing she no longer has to wonder about my fate."
    mct "Me sinto melhor sabendo que ela não precisa mais se perguntar sobre o meu destino."

