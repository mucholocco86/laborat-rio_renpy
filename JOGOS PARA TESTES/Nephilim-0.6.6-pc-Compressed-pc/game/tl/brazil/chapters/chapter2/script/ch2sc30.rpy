translate brazil ch2sc30_8771a205:

#   el "And I, for one, would like to get there before nightfall."
    el "E eu, por exemplo, gostaria de chegar lá antes do anoitecer."

# game/chapters/chapter2/script/ch2sc30.rpy:169
translate brazil ch2sc30_392aa93f:

#   mc "Sure... I suppose we'd better get going."
    mc "Claro... Acho melhor irmos."

# game/chapters/chapter2/script/ch2sc30.rpy:172
translate brazil ch2sc30_885597a0:

#   el "..."
    el "..."

# game/chapters/chapter2/script/ch2sc30.rpy:173
translate brazil ch2sc30_b3bb78cb:

#   "The two of you lock eyes and Eliza seems lost in thought."
    "Vocês duas trocam olhares e Eliza parece perdida em pensamentos."

# game/chapters/chapter2/script/ch2sc30.rpy:175
translate brazil ch2sc30_699cb5fa:

#   mc "It’s not that I don’t appreciate you holding on to me for dear life, but..."
    mc "Não é que eu não aprecie você se agarrando a mim com todas as suas forças, mas..."

# game/chapters/chapter2/script/ch2sc30.rpy:176
translate brazil ch2sc30_4351c258:

#   mc "You’re going to have to release me from your monkey hold if we’re going to go anywhere."
    mc "Você vai ter que me soltar desse seu aperto de macaco se quisermos ir a algum lugar."

# game/chapters/chapter2/script/ch2sc30.rpy:178
translate brazil ch2sc30_1fb2f3ec:

#   el "You love my monkey hold!"
    el "Você adora meu jeito de segurar o macaco!"

# game/chapters/chapter2/script/ch2sc30.rpy:180
translate brazil ch2sc30_c60b37ea:

#   mc "*Laughs*"
    mc "*Risos*"

# game/chapters/chapter2/script/ch2sc30.rpy:181
translate brazil ch2sc30_a8e3c125:

#   el "Can’t you just carry me like this? I’m really comfortable."
    el "Você não pode me carregar assim? Estou muito confortável."

