translate brazil ch2sc30_627c7e09:

#   el "Not just on a surface level, either. You really do care."
    el "E não é só superficialmente. Você realmente se importa."

# game/chapters/chapter2/script/ch2sc30.rpy:140
translate brazil ch2sc30_0a28ee29:

#   mc "Eliza..."
    mc "Eliza..."

