translate brazil ch2sc30_db73ba50:

#   el "Next time I leave you a note it'll read like this..."
    el "Da próxima vez que eu te deixar um bilhete, ele será assim..."

# game/chapters/chapter2/script/ch2sc30.rpy:156
translate brazil ch2sc30_948aa057:

#   el "Morning handsome honey-bun! Your precious kitten has arisen and is now searching for food! *Snickers*"
    el "Bom dia, meu lindo docinho! Seu gatinho precioso acordou e agora está procurando comida! *Risos*"

