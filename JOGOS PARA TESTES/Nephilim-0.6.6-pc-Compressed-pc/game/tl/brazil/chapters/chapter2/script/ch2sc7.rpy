#   mc "You think I’m a freak, right?"
    mc "Você acha que eu sou um esquisito, né?"

# game/chapters/chapter2/script/ch2sc7.rpy:260
translate brazil ch2sc7_4ab49848:

#   mc "You wouldn’t be the first to feel that way."
    mc "Você não seria o primeiro a se sentir assim."

# game/chapters/chapter2/script/ch2sc7.rpy:264
translate brazil ch2sc7_195dda5f:

#   el "You’re wrong."
    el "Você está enganado."

# game/chapters/chapter2/script/ch2sc7.rpy:266
translate brazil ch2sc7_1a0d3127:

#   mc "Yes, you-"
    mc "Sim, você-"

# game/chapters/chapter2/script/ch2sc7.rpy:269
translate brazil ch2sc7_74c5ff9f:

#   el "{b}[mc]!{/b} I swear by the divines! If you don’t shut up, {b}I-I’m really going to punch you.{/b}"
    el "{b}[mc]!{/b} Juro pelos deuses! Se você não calar a boca, {b} Eu... eu vou te dar um soco de verdade.{/b}"

# game/chapters/chapter2/script/ch2sc7.rpy:271
translate brazil ch2sc7_c0052b5c:

#   mc "Okay, okay."
    mc "Ok, ok."

# game/chapters/chapter2/script/ch2sc7.rpy:272
translate brazil ch2sc7_92818420:

#   mc "So my abilities or whatever they are, they don’t bother you?"
    mc "Então, minhas habilidades, ou o que quer que sejam, não te incomodam?"

# game/chapters/chapter2/script/ch2sc7.rpy:274
translate brazil ch2sc7_b5c15d34:

#   el "No, they don't bother me. Do you really think so little of me?"
    el "Não, eles não me incomodam. Você realmente me considera tão pouco?"

# game/chapters/chapter2/script/ch2sc7.rpy:276
translate brazil ch2sc7_6108bc58:

#   mc "No, Eliza. It’s ... it's just not something I've shared with anyone before."
    mc "Não, Eliza. É... é algo que eu nunca compartilhei com ninguém antes."

# game/chapters/chapter2/script/ch2sc7.rpy:277
translate brazil ch2sc7_89e82bea:

#   mct "Rin is the only person who knows and has accepted me..."
    mct "Rin é a única pessoa que me conhece e me aceitou..."

# game/chapters/chapter2/script/ch2sc7.rpy:278
translate brazil ch2sc7_eb7a179a:

#   mc "I'm not sure how people will react to hearing about it."
    mc "Não sei ao certo como as pessoas vão reagir ao saber disso."

# game/chapters/chapter2/script/ch2sc7.rpy:280
translate brazil ch2sc7_795df7fb:

#   mc "I suspect that most would see me as a freak of nature, maybe start shouting 'devil spawn' and try to drag me off to the gallows."
    mc "Suspeito que a maioria me veria como uma aberração da natureza, talvez começasse a gritar \"filho do demônio\" e tentasse me arrastar para a forca."

# game/chapters/chapter2/script/ch2sc7.rpy:282
translate brazil ch2sc7_caeb572d:

#   el "You're not... you're not any of those things."
    el "Você não é... você não é nada disso."

# game/chapters/chapter2/script/ch2sc7.rpy:284
translate brazil ch2sc7_f3a40048:

#   el "You'd better not believe it if someone says anything like that."
    el "É melhor você não acreditar se alguém disser algo assim."

# game/chapters/chapter2/script/ch2sc7.rpy:286
translate brazil ch2sc7_0a28ee29:

#   mc "Eliza..."
    mc "Eliza..."

# game/chapters/chapter2/script/ch2sc7.rpy:287
translate brazil ch2sc7_a0d63cd5:

#   mc "Even I don't fully understand what I am."
    mc "Nem eu entendo completamente o que sou."

# game/chapters/chapter2/script/ch2sc7.rpy:288
translate brazil ch2sc7_c6749fad:

#   mc "What does being a Nephilim really mean?"
    mc "O que realmente significa ser um Nefilim?"

# game/chapters/chapter2/script/ch2sc7.rpy:290
translate brazil ch2sc7_4c087035:

#   el "I can't claim to know anything about being a Nephilim, either."
    el "Eu também não posso afirmar que sei alguma coisa sobre ser um Nefilim."

# game/chapters/chapter2/script/ch2sc7.rpy:291
translate brazil ch2sc7_b2080515:

#   el "I've never even heard that word?"
    el "Eu nunca nem ouvi essa palavra?"

# game/chapters/chapter2/script/ch2sc7.rpy:292
translate brazil ch2sc7_626ae083:

#   el "But I do know you, and you're definitely not a 'devil spawn'."
    el "Mas eu te conheço, e você definitivamente não é um 'demônio'."

# game/chapters/chapter2/script/ch2sc7.rpy:294
translate brazil ch2sc7_43c4697b:

#   mc "You don’t know..."
    mc "Você não sabe..."

# game/chapters/chapter2/script/ch2sc7.rpy:296
translate brazil ch2sc7_a42a64bb:

#   el "I do! I do know. In my eyes, you’re just [mc]... My friend."
    el "Sim! Eu sei. Aos meus olhos, você é apenas [mc]... Meu amigo."

# game/chapters/chapter2/script/ch2sc7.rpy:297
translate brazil ch2sc7_f54bc6b3:

#   el "My... savior."
    el "Meu... salvador."

# game/chapters/chapter2/script/ch2sc7.rpy:300
translate brazil ch2sc7_645a04c6:

#   el "You might be a jerk sometimes. And clearly thickheaded!"
    el "Você pode ser um idiota às vezes. E claramente um cabeça-dura!"

# game/chapters/chapter2/script/ch2sc7.rpy:301
translate brazil ch2sc7_289aa1b7:

#   el "But I trust you completely, if it isn’t obvious by now."
    el "Mas confio plenamente em você, caso ainda não esteja óbvio."

# game/chapters/chapter2/script/ch2sc7.rpy:303
translate brazil ch2sc7_9c643cc7:

#   mc "I trust you too, Eliza."
    mc "Eu também confio em você, Eliza."

# game/chapters/chapter2/script/ch2sc7.rpy:305
translate brazil ch2sc7_ed0b9121:

#   mc "Thank you for the vote of confidence."
    mc "Obrigado pelo voto de confiança."

# game/chapters/chapter2/script/ch2sc7.rpy:307
translate brazil ch2sc7_900fa9e8:

#   el "Anytime. 'Cause I’m not going anywhere."
    el "A qualquer hora. Porque eu não vou a lugar nenhum."

# game/chapters/chapter2/script/ch2sc7.rpy:310
translate brazil ch2sc7_be58f92a:

#   mct "*Chuckles* She... really does accept me as I am."
    mct "*Risos* Ela... realmente me aceita como eu sou."

# game/chapters/chapter2/script/ch2sc7.rpy:313
translate brazil ch2sc7_86591f02:

#   elt "Stop looking at me like that..."
    elt "Pare de me olhar assim..."

# game/chapters/chapter2/script/ch2sc7.rpy:315
translate brazil ch2sc7_75efec1a:

#   el "Uhh... we'd better get back to it."
    el "Hum... é melhor voltarmos ao assunto."

# game/chapters/chapter2/script/ch2sc7.rpy:317
translate brazil ch2sc7_8d9f7be3:

#   mc "I say we’re done for today."
    mc "Eu digo que por hoje terminamos."

# game/chapters/chapter2/script/ch2sc7.rpy:319
translate brazil ch2sc7_c9882527:

#   el "R-Really?"
    el "Sério?"

# game/chapters/chapter2/script/ch2sc7.rpy:321
translate brazil ch2sc7_dd88f1ae:

#   mc "Yeah, you impressed me with how fast you picked up the basics. I think we deserve a break."
    mc "É, você me impressionou com a rapidez com que aprendeu o básico. Acho que merecemos uma pausa."

# game/chapters/chapter2/script/ch2sc7.rpy:323
translate brazil ch2sc7_d9b2e9d7:

#   el "I second that! I’m a big fan of breaks!"
    el "Concordo plenamente! Sou muito fã de pausas!"

# game/chapters/chapter2/script/ch2sc7.rpy:325
translate brazil ch2sc7_13e4da9d:

#   el "Let’s sit over there, by the tree."
    el "Vamos sentar ali, perto da árvore."

# game/chapters/chapter2/script/ch2sc7.rpy:334
translate brazil ch2sc7_982af298:

#   el "Look daisies! *Giggles* Just like back home at Whitehills."
    el "Olha que gracinha! *Risos* Igualzinho lá em casa, em Whitehills."

# game/chapters/chapter2/script/ch2sc7.rpy:337
translate brazil ch2sc7_ce89b727:

#   mc "Yeah, we have daisies near Riverside as well, just not as abundant as Whitehills."
    mc "Sim, também temos margaridas perto de Riverside, só que não em tanta quantidade quanto em Whitehills."

# game/chapters/chapter2/script/ch2sc7.rpy:338
translate brazil ch2sc7_54628906:

#   el "*Giggling joyously* Mh-hm!"
    el "*Risos alegres* Hum-hum!"

# game/chapters/chapter2/script/ch2sc7.rpy:343
translate brazil ch2sc7_185aa3de:

#   "You both lean back, enjoying the rays of sun penetrating the canopy of trees above you."
    "Vocês dois se recostam, apreciando os raios de sol que penetram a copa das árvores acima de vocês."

# game/chapters/chapter2/script/ch2sc7.rpy:350
translate brazil ch2sc7_a7998688:

#   el "What are you thinking about?"
    el "Em que você está pensando?"

# game/chapters/chapter2/script/ch2sc7.rpy:352
translate brazil ch2sc7_5335c83e:

#   mc "Just this place. Brings back memories..."
    mc "Este lugar me traz tantas lembranças..."

# game/chapters/chapter2/script/ch2sc7.rpy:354
translate brazil ch2sc7_76c14e39:

#   el "You used to come here before?"
    el "Você costumava vir aqui antes?"

# game/chapters/chapter2/script/ch2sc7.rpy:356
translate brazil ch2sc7_ac5ae55c:

#   mc "Multiple times a week, with my best friend, Alice... and my cousin, Flynn."
    mc "Várias vezes por semana, com minha melhor amiga, Alice... e meu primo, Flynn."

# game/chapters/chapter2/script/ch2sc7.rpy:357
translate brazil ch2sc7_a6cc14e2:

#   mc "These apple orchards were our hangout spot away from the village. We'd spend hours here messing around."
    mc "Esses pomares de maçãs eram nosso ponto de encontro longe da vila. Passávamos horas lá brincando."

# game/chapters/chapter2/script/ch2sc7.rpy:359
translate brazil ch2sc7_010683c1:

#   mc "Just kids being kids."
    mc "Crianças sendo crianças."

# game/chapters/chapter2/script/ch2sc7.rpy:361
translate brazil ch2sc7_c7ef50af:

#   el "Sounds like some great memories were made here."
    el "Parece que foram criadas ótimas lembranças aqui."

# game/chapters/chapter2/script/ch2sc7.rpy:377
translate brazil ch2sc7_1cad5234:

#   fy "Up high, [mc]!"
    fy "Lá no alto, [mc]!"

# game/chapters/chapter2/script/ch2sc7.rpy:378
translate brazil ch2sc7_89b4533a:

#   mc "Hah! She won’t find us here."
    mc "Hah! Ela não vai nos encontrar aqui."

# game/chapters/chapter2/script/ch2sc7.rpy:380
translate brazil ch2sc7_bb1db4fc:

#   al "There you are! What are you up to?"
    al "Aí está você! O que está aprontando?"

# game/chapters/chapter2/script/ch2sc7.rpy:384
translate brazil ch2sc7_130c032e:

#   fy "Alice! W-What a surprise!"
    fy "Alice! Q-Que surpresa!"

# game/chapters/chapter2/script/ch2sc7.rpy:385
translate brazil ch2sc7_fb71ab97:

#   fy "We weren’t hiding from you or anything..."
    fy "Não estávamos nos escondendo de você nem nada..."

# game/chapters/chapter2/script/ch2sc7.rpy:386
translate brazil ch2sc7_cd2af4b4:

#   mc "Hi Alice. What brings you out here?"
    mc "Olá, Alice. O que te traz aqui?"

# game/chapters/chapter2/script/ch2sc7.rpy:388
translate brazil ch2sc7_2f804ad1:

#   al "Okaay... cut the crap, you two! I know you’re up to something!"
    al "Ok... parem com essa palhaçada, vocês dois! Eu sei que vocês estão aprontando alguma coisa!"

# game/chapters/chapter2/script/ch2sc7.rpy:390
translate brazil ch2sc7_5db78d91:

#   fy "First, you have to promise you won’t tell our parents."
    fy "Primeiro, você tem que prometer que não vai contar para os nossos pais."

# game/chapters/chapter2/script/ch2sc7.rpy:392
translate brazil ch2sc7_8f43bfb1:

#   al "Done! Now tell me!"
    al "Pronto! Agora me diga!"

# game/chapters/chapter2/script/ch2sc7.rpy:394
translate brazil ch2sc7_1e6af5f3:

#   fy "So, you’ll never believe the idea I came up with, Alice."
    fy "Então, você nunca vai acreditar na ideia que eu tive, Alice."

# game/chapters/chapter2/script/ch2sc7.rpy:395
translate brazil ch2sc7_7edcd12b:

#   fy "We’re going to build a boat!"
    fy "Vamos construir um barco!"

# game/chapters/chapter2/script/ch2sc7.rpy:397
translate brazil ch2sc7_6f3d0a38:

#   al "... A boat?"
    al "...Um barco?"

# game/chapters/chapter2/script/ch2sc7.rpy:400
translate brazil ch2sc7_32c7bc15:

#   al "Have you gone mad?! Your parents will kill you, if you don’t drown first!"
    al "Você enlouqueceu?! Seus pais vão te matar, se você não se afogar primeiro!"

# game/chapters/chapter2/script/ch2sc7.rpy:402
translate brazil ch2sc7_e608d6c8:

#   el "Sounds like you and your cousin were up to no good!"
    el "Parece que você e seu primo estavam aprontando alguma coisa!"

# game/chapters/chapter2/script/ch2sc7.rpy:404
translate brazil ch2sc7_c7d60732:

#   mc "That was usually the case."
    mc "Isso geralmente acontecia."

# game/chapters/chapter2/script/ch2sc7.rpy:405
translate brazil ch2sc7_e1011632:

#   mc "Most of it was him coming up with silly ideas."
    mc "Na maioria das vezes, eram ideias bobas dele."

# game/chapters/chapter2/script/ch2sc7.rpy:407
translate brazil ch2sc7_01ab4a0f:

#   el "Let me guess, Alice was the voice of reason in your group?"
    el "Deixe-me adivinhar, Alice era a voz da razão no seu grupo?"

# game/chapters/chapter2/script/ch2sc7.rpy:409
translate brazil ch2sc7_844ef422:

#   mc "I suppose she was."
    mc "Suponho que sim."

# game/chapters/chapter2/script/ch2sc7.rpy:410
translate brazil ch2sc7_898048cf:

#   mc "At the time, it just seemed like she wanted to bust our balls."
    mc "Naquele momento, parecia que ela só queria nos sacanear."

# game/chapters/chapter2/script/ch2sc7.rpy:412
translate brazil ch2sc7_5faa715e:

#   mc "She never told on us, though."
    mc "Mas ela nunca nos dedurou."

# game/chapters/chapter2/script/ch2sc7.rpy:413
translate brazil ch2sc7_26bfc405:

#   mc "She somehow always ended up helping us."
    mc "De alguma forma, ela sempre acabava nos ajudando."

# game/chapters/chapter2/script/ch2sc7.rpy:415
translate brazil ch2sc7_84795cc4:

#   el "Even though your ideas were silly, I’m sure she just wanted to be with you guys."
    el "Mesmo que suas ideias fossem bobas, tenho certeza de que ela só queria estar com vocês."

# game/chapters/chapter2/script/ch2sc7.rpy:417
translate brazil ch2sc7_beef48e0:

#   mc "You might be right."
    mc "Você pode ter razão."

# game/chapters/chapter2/script/ch2sc7.rpy:418
translate brazil ch2sc7_8c8aa860:

#   mc "Anyway, let’s head back and get some long overdue breakfast."
    mc "Enfim, vamos voltar e tomar um café da manhã que já está mais do que na hora."

# game/chapters/chapter2/script/ch2sc7.rpy:420
translate brazil ch2sc7_91e119fc:

#   el "Music to my ears! I’m famished!"
    el "Que maravilha! Estou faminto!"

# game/chapters/chapter2/script/ch2sc7.rpy:422
translate brazil ch2sc7_760b6fee:

#   mc "Don’t be so dramatic."
    mc "Não seja tão dramático."

# game/chapters/chapter2/script/ch2sc7.rpy:423
translate brazil ch2sc7_bfc0c809:

#   mc "You've only gone a few hours without breakfast."
    mc "Você só ficou algumas horas sem tomar café da manhã."

# game/chapters/chapter2/script/ch2sc7.rpy:425
translate brazil ch2sc7_b413a104:

#   el "And I'll remember it for the rest of my days!"
    el "E vou me lembrar disso para o resto da minha vida!"

# game/chapters/chapter2/script/ch2sc7.rpy:427
translate brazil ch2sc7_3c247786:

#   mc "Come on, we'd better get some food in you before you have a meltdown."
    mc "Vamos lá, é melhor você comer alguma coisa antes que tenha um colapso."

# game/chapters/chapter2/script/ch2sc7.rpy:429
translate brazil ch2sc7_7880d93e:

#   el "Finally, you're starting to see reason!"
    el "Finalmente, você está começando a entender a razão!"

# game/chapters/chapter2/script/ch2sc7.rpy:430
translate brazil ch2sc7_0ec54420:

#   el "I'll be ordering double!"
    el "Vou pedir o dobro!"

# game/chapters/chapter2/script/ch2sc7.rpy:431
translate brazil ch2sc7_a8640a01:

#   el "That's what you get for making me workout before breakfast!"
    el "É isso que você ganha por me fazer malhar antes do café da manhã!"

# game/chapters/chapter2/script/ch2sc7.rpy:434
translate brazil ch2sc7_b01ecf80:

#   "You head back towards Riverside."
    "Você retorna em direção a Riverside."

# game/chapters/chapter2/script/ch2sc7.rpy:185
translate brazil ch2sc7_2b35b6fe_1:

#   mc "..."
    mc "..."

# game/chapters/chapter2/script/ch2sc7.rpy:346
translate brazil ch2sc7_2b35b6fe_2:

#   mc "..."
    mc "..."

# game/chapters/chapter2/script/ch2sc7.rpy:348
translate brazil ch2sc7_885597a0_1:

#   el "..."
    el "..."

