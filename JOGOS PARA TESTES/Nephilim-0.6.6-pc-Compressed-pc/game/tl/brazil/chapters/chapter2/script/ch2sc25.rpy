# ARQUIVO: game/chapters/chapter2/script/ch2sc25.rpy DIALOGOS: 57


# game/chapters/chapter2/script/ch2sc25.rpy:18
translate brazil ch2sc25_582359ea:

#   mc "Hm?"
    mc "Hum?"

# game/chapters/chapter2/script/ch2sc25.rpy:20
translate brazil ch2sc25_186f249b:

#   el "I still can’t believe we actually met a dwarf!"
    el "Ainda não consigo acreditar que realmente encontramos um anão!"

# game/chapters/chapter2/script/ch2sc25.rpy:21
translate brazil ch2sc25_c66ac4b7:

#   el "A dwarf! We really are living out an adventure from my mothers books!"
    el "Um anão! Estamos mesmo vivendo uma aventura dos livros da minha mãe!"

# game/chapters/chapter2/script/ch2sc25.rpy:23
translate brazil ch2sc25_0ef01d74:

#   mc "From what Borri said, I don’t think they are that uncommon."
    mc "Pelo que Borri disse, não acho que sejam tão incomuns assim."

# game/chapters/chapter2/script/ch2sc25.rpy:24
translate brazil ch2sc25_65521dfb:

#   mc "I guess we’ve just lived sheltered lives in Riverside and Whitehills."
    mc "Acho que simplesmente vivemos vidas protegidas em Riverside e Whitehills."

# game/chapters/chapter2/script/ch2sc25.rpy:25
translate brazil ch2sc25_6682fd5f:

#   mc "Now that I think about it... I did see a dwarf back in Riverside, at the tavern."
    mc "Agora que penso nisso... eu vi um anão lá em Riverside, na taverna."

# game/chapters/chapter2/script/ch2sc25.rpy:27
translate brazil ch2sc25_1f470c07:

#   el "I wonder if other things from my mothers books are also real?"
    el "Será que outras coisas dos livros da minha mãe também são reais?"

# game/chapters/chapter2/script/ch2sc25.rpy:29
translate brazil ch2sc25_c35aa298:

#   mc "The things I saw while traveling with your father..."
    mc "As coisas que vi enquanto viajava com seu pai..."

# game/chapters/chapter2/script/ch2sc25.rpy:30
translate brazil ch2sc25_6e33644d:

#   mc "I'd say they're all real until proven otherwise."
    mc "Eu diria que todas são reais até que se prove o contrário."

# game/chapters/chapter2/script/ch2sc25.rpy:32
translate brazil ch2sc25_01048bd1:

#   el "Wait, really?! That’s so exciting!"
    el "Espera aí, sério?! Que emocionante!"

# game/chapters/chapter2/script/ch2sc25.rpy:33
translate brazil ch2sc25_889c496f:

#   el "And a little terrifying at the same time..."
    el "E um pouco assustador ao mesmo tempo..."

# game/chapters/chapter2/script/ch2sc25.rpy:35
translate brazil ch2sc25_3e38b0e6:

#   el "There was some pretty dark stuff in some of the books."
    el "Havia algumas coisas bem sombrias em alguns dos livros."

# game/chapters/chapter2/script/ch2sc25.rpy:36
translate brazil ch2sc25_d2cc63d0:

#   el "Black magic, corrupt witches, living dead, trolls kidnapping people, goblins raping wome-"
    el "Magia negra, bruxas corruptas, mortos-vivos, trolls sequestrando pessoas, goblins estuprando mulheres..."

# game/chapters/chapter2/script/ch2sc25.rpy:37
translate brazil ch2sc25_0287e3cf:

#   el "You get the idea... awful stuff."
    el "Você entendeu a ideia... coisas horríveis."

# game/chapters/chapter2/script/ch2sc25.rpy:39
translate brazil ch2sc25_1266d9f4:

#   mc "Hmm, I haven’t encountered any of those things. Except for goblins, that one I can confirm to be true."
    mc "Hum, não me deparei com nenhuma dessas coisas. Exceto pelos goblins, esses eu posso confirmar que existem."

# game/chapters/chapter2/script/ch2sc25.rpy:40
translate brazil ch2sc25_5a72245b:

#   mc "As for the other stuff, stories have to start somewhere, so I’m sure there’s some truth to them."
    mc "Quanto ao resto, as histórias têm que começar em algum lugar, então tenho certeza de que há alguma verdade nelas."

# game/chapters/chapter2/script/ch2sc25.rpy:42
translate brazil ch2sc25_3ab75370:

#   el "Hmm, makes sense."
    el "Hum, faz sentido."

# game/chapters/chapter2/script/ch2sc25.rpy:43
translate brazil ch2sc25_64b891c6:

#   el "At least now we’ve had our first encounter with a non-human!"
    el "Pelo menos agora tivemos nosso primeiro encontro com um ser não humano!"

# game/chapters/chapter2/script/ch2sc25.rpy:45
translate brazil ch2sc25_bcccfbd6:

#   mc "You’re awfully excited about that?"
    mc "Você está muito animado com isso?"

# game/chapters/chapter2/script/ch2sc25.rpy:47
translate brazil ch2sc25_9eb32cda:

#   el "Of course! You should be too!"
    el "Claro! Você também deveria!"

# game/chapters/chapter2/script/ch2sc25.rpy:48
translate brazil ch2sc25_89e611fd:

#   el "It marks the real beginning of our path as adventurers, [mc]!"
    el "Isso marca o verdadeiro início de nossa jornada como aventureiros. [mc]!"

# game/chapters/chapter2/script/ch2sc25.rpy:50
translate brazil ch2sc25_32b80d61:

#   mc "I suppose you’re right."
    mc "Acho que você tem razão."

# game/chapters/chapter2/script/ch2sc25.rpy:51
translate brazil ch2sc25_64ac355e:

#   mc "*Chuckles* Who would’ve thought?"
    mc "*Risos* Quem diria?"

# game/chapters/chapter2/script/ch2sc25.rpy:53
translate brazil ch2sc25_6303409c:

#   el "Thought what?"
    el "Pensou em quê?"

# game/chapters/chapter2/script/ch2sc25.rpy:54
translate brazil ch2sc25_f9a0b045:

#   el "Did you think of something?"
    el "Você pensou em alguma coisa?"

# game/chapters/chapter2/script/ch2sc25.rpy:56
translate brazil ch2sc25_9ff1e48c:

#   mc "Oh, it's nothing."
    mc "Ah, não é nada."

# game/chapters/chapter2/script/ch2sc25.rpy:57
translate brazil ch2sc25_349c6b0b:

#   mc "Just a memory... from a long time ago."
    mc "Apenas uma lembrança... de muito tempo atrás."

# game/chapters/chapter2/script/ch2sc25.rpy:59
translate brazil ch2sc25_b18e2b1a:

#   el "Now you have to tell me."
    el "Agora você tem que me dizer."

# game/chapters/chapter2/script/ch2sc25.rpy:60
translate brazil ch2sc25_69b8b9e3:

#   el "Please?"
    el "Por favor?"

# game/chapters/chapter2/script/ch2sc25.rpy:62
translate brazil ch2sc25_b46161ad:

#   mc "*Sigh* I was just remembering that when I was younger..."
    mc "*Suspiro* Eu estava me lembrando disso quando era mais jovem..."

# game/chapters/chapter2/script/ch2sc25.rpy:63
translate brazil ch2sc25_b0ce624b:

#   mc "I always dreamed of becoming an adventurer."
    mc "Sempre sonhei em me tornar um aventureiro."

# game/chapters/chapter2/script/ch2sc25.rpy:65
translate brazil ch2sc25_85859e6b:

#   elt "Oh! I get it."
    elt "Ah! Entendi."

# game/chapters/chapter2/script/ch2sc25.rpy:67
translate brazil ch2sc25_9a7d2519:

#   elt "It must feel strange to be living his “Dream”..."
    elt "Deve ser uma sensação estranha estar vivendo o seu \"sonho\"..."

# game/chapters/chapter2/script/ch2sc25.rpy:68
translate brazil ch2sc25_b57765ae:

#   elt "But not in the way that he'd imagined."
    elt "Mas não da maneira que ele havia imaginado."

# game/chapters/chapter2/script/ch2sc25.rpy:69
translate brazil ch2sc25_556c87f6:

#   elt "D-Does he think the version we're living is worse than the one from his childhood dreams?"
    elt "Ele acha que a versão que estamos vivendo é pior do que aquela dos seus sonhos de infância?"

# game/chapters/chapter2/script/ch2sc25.rpy:71
translate brazil ch2sc25_b01cd11e:

#   mc "I would always pester Papa about being old enough to travel and train with swords."
    mc "Eu sempre ficava importunando meu pai para que ele me dissesse que eu já tinha idade suficiente para viajar e treinar com espadas."

# game/chapters/chapter2/script/ch2sc25.rpy:73
translate brazil ch2sc25_ced66e48:

#   el "I guess he wasn’t thrilled with the idea?"
    el "Acho que ele não ficou muito entusiasmado com a ideia?"

# game/chapters/chapter2/script/ch2sc25.rpy:74
translate brazil ch2sc25_42a03cd9:

#   el "His son wanting to venture out in the world on his own, every parents worst nightmare."
    el "O filho querendo se aventurar pelo mundo sozinho, o pior pesadelo de qualquer pai."

# game/chapters/chapter2/script/ch2sc25.rpy:76
translate brazil ch2sc25_4007efbc:

#   mc "That’s an understatement."
    mc "Isso é um eufemismo."

# game/chapters/chapter2/script/ch2sc25.rpy:77
translate brazil ch2sc25_caf98be9:

#   mc "Mama wasn’t happy about it either, but she usually took my side."
    mc "Mamãe também não ficou feliz com isso, mas geralmente ficava do meu lado."

# game/chapters/chapter2/script/ch2sc25.rpy:79
translate brazil ch2sc25_1b489bae:

#   mc "She wanted me to stay safe."
    mc "Ela queria que eu ficasse em segurança."

# game/chapters/chapter2/script/ch2sc25.rpy:80
translate brazil ch2sc25_e2497fca:

#   mc "Knowing what I know now, about who... what I am..."
    mc "Sabendo o que sei agora, sobre quem... o que eu sou..."

# game/chapters/chapter2/script/ch2sc25.rpy:82
translate brazil ch2sc25_5f0888b0:

#   el "{size=+3}{b}Who.{/b}{/size} Not 'what'."
    el "{size=+3}{b}Quem.{/b}{/size} Não 'o quê'."

# game/chapters/chapter2/script/ch2sc25.rpy:84
translate brazil ch2sc25_ff10d17b:

#   mc "Who I am now, it made sense they wanted me to stay hidden in Riverside."
    mc "Quem eu sou agora, fazia sentido que eles quisessem que eu permanecesse escondido em Riverside."

# game/chapters/chapter2/script/ch2sc25.rpy:85
translate brazil ch2sc25_b07a4571:

#   mc "A small village with no connections to the capital."
    mc "Uma pequena vila sem qualquer ligação com a capital."

# game/chapters/chapter2/script/ch2sc25.rpy:87
translate brazil ch2sc25_de30a9a8:

#   el "That didn’t stop you from wanting something more, I take it?"
    el "Imagino que isso não te impediu de querer algo mais?"

# game/chapters/chapter2/script/ch2sc25.rpy:89
translate brazil ch2sc25_a9d43480:

#   mc "No, not quite..."
    mc "Não, não exatamente..."

# game/chapters/chapter2/script/ch2sc25.rpy:90
translate brazil ch2sc25_26a5686e:

#   mc "It just made me want it even more."
    mc "Isso só fez com que eu quisesse ainda mais."

# game/chapters/chapter2/script/ch2sc25.rpy:92
translate brazil ch2sc25_ab27933d:

#   el "Despite the circumstances, I think young [mc] would be proud of where you are now."
    el "Apesar das circunstâncias, acho que os jovens [mc] Teria orgulho de onde você está agora."

# game/chapters/chapter2/script/ch2sc25.rpy:93
translate brazil ch2sc25_657ffc20:

#   el "Our lives are only just starting, there's a whole world out there for us to discover."
    el "Nossas vidas estão apenas começando, há um mundo inteiro lá fora para descobrirmos."

# game/chapters/chapter2/script/ch2sc25.rpy:95
translate brazil ch2sc25_3df710f2:

#   mc "Yeah... I think you might be right."
    mc "Sim... acho que você pode ter razão."

# game/chapters/chapter2/script/ch2sc25.rpy:97
translate brazil ch2sc25_de5c6ae6:

#   mc "You know, you’re surprisingly wise when you want to be."
    mc "Sabe, você é surpreendentemente sábio quando quer ser."

# game/chapters/chapter2/script/ch2sc25.rpy:98
translate brazil ch2sc25_0534160a:

#   el "Hrrh??"
    el "Huh??"

# game/chapters/chapter2/script/ch2sc25.rpy:101
translate brazil ch2sc25_a688e7d8:

#   el "Hey!"
    el "Ei!"

# game/chapters/chapter2/script/ch2sc25.rpy:102
translate brazil ch2sc25_1cb45cdc:

#   el "What’s that supposed to mean? I’m wise all the time!"
    el "O que isso quer dizer? Eu sou sábio o tempo todo!"

# game/chapters/chapter2/script/ch2sc25.rpy:104
translate brazil ch2sc25_076d804a:

#   mc "Sure, Eliza. {b}All.{/b} {size=+10}{b}The.{/b}{/size} {size=+20}{b}Time.{/b}{/size}"
    mc "Claro, Eliza. {b} Todos.{/b}  {size=+10}{b}O.{/b}{/size}  {size=+20}{b}Tempo.{/b}{/size}"

# game/chapters/chapter2/script/ch2sc25.rpy:106
translate brazil ch2sc25_35e7c882:

#   el "Hrrh... {b}Jerk!{/b}"
    el "Hrrh... {b} Idiota!{/b}"

