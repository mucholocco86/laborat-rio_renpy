#   mct "He's aware of Eliza."
    mct "Ele tem conhecimento de Eliza."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:167
translate brazil ch2sc19_nz_d26b898b:

#   mct "Threatening her? Bad choice, pal."
