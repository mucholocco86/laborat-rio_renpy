translate brazil ch2sc19_nz_faa2d754:

#   elt "One should be enough. They’re very potent."
    elt "Uma só deve ser suficiente. Elas são muito potentes."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:379
translate brazil ch2sc19_nz_1902d99d:

#   elt "Just hold on, [mc]. It’s my turn to save you!"
    elt "Aguenta firme, [mc] Agora é a minha vez de te salvar!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:383
translate brazil ch2sc19_nz_f57be28a:

#   el "Please, [mc]. You need to chew on these, please!"
    el "Por favor, [mc] Você precisa mastigar isso, por favor!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:385
translate brazil ch2sc19_nz_c20eb2c4:

#   el "When the Liferoot petals are in your system, they'll heal you slowly but effectively."
    el "Quando as pétalas da Raiz da Vida estiverem em seu organismo, elas o curarão de forma lenta, porém eficaz."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:387
translate brazil ch2sc19_nz_d74fb1bd:

#   el "Don’t worry, I’m not going anywhere. I’m staying right here with you til you wake up."
    el "Não se preocupe, eu não vou a lugar nenhum. Vou ficar aqui com você até você acordar."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:389
translate brazil ch2sc19_nz_43349db9:

#   el "*Whispers* {size=-10}{b}Please be okay.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Por favor, fique bem.{/b}{/size}"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:390
translate brazil ch2sc19_nz_1f9a9819:

#   el "*Whispers* {size=-10}{b}Rest... I'll be right here when you wake up.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Descanse... Estarei aqui quando você acordar.{/b}{/size}"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:395
translate brazil ch2sc19_nz_4216bb73:

#   "Several hours later..."
    "Várias horas depois..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:409
translate brazil ch2sc19_nz_84325680:

#   el "You’re awake!"
    el "Você está acordado!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:411
translate brazil ch2sc19_nz_7d010a14:

#   mc "What happened?"
    mc "O que aconteceu?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:413
translate brazil ch2sc19_nz_c0d79f96:

#   el "You collapsed! Almost stopped breathing."
    el "Você desmaiou! Quase parou de respirar."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:414
translate brazil ch2sc19_nz_10142ecf:

#   el "I thought-... but you're awake now!"
    el "Eu pensei... mas você já acordou!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:416
translate brazil ch2sc19_nz_f21b23ab:

#   el "I-I... I’m sorry! I-I couldn’t do more..."
    el "Eu... Sinto muito! Eu não pude fazer mais nada..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:417
translate brazil ch2sc19_nz_9dd8f9da:

#   el "I was just hiding like you told me... I'm sorry!"
    el "Eu estava me escondendo como você me disse... Me desculpe!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:418
translate brazil ch2sc19_nz_8824258b:

#   mct "I can tell she's been worried... I feel completely fine now, stronger than before."
    mct "Percebo que ela estava preocupada... Agora me sinto completamente bem, mais forte do que antes."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:419
translate brazil ch2sc19_nz_0af73c9e:

#   mct "I better get up and distract her."
    mct "É melhor eu me levantar e distraí-la."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:421
translate brazil ch2sc19_nz_93015990:

