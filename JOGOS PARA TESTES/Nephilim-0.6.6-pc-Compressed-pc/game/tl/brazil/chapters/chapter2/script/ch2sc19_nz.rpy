translate brazil ch2sc19_nz_0929f832:

#   mc "Threatening someone I care about? That’s your last mistake."
    mc "Ameaçar alguém de quem eu gosto? Esse é o seu último erro."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:182
translate brazil ch2sc19_nz_496a444a:

#   mc "Your brother was weak. Time to find out if you’re just as pathetic."
