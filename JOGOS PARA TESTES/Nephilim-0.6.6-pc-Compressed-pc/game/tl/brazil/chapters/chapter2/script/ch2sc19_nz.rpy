#   mc "Tell me..."
    mc "Diga-me..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:89
translate brazil ch2sc19_nz_00d6884e:

#   mc "Are you brave?"
    mc "Você é corajoso?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:91
translate brazil ch2sc19_nz_e66e371f:

#   mc "Or just incredibly dumb?"
    mc "Ou simplesmente incrivelmente estúpido?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:93
translate brazil ch2sc19_nz_97209616:

#   mc "I’m guessing it’s the latter."
    mc "Acho que é a segunda opção."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:95
translate brazil ch2sc19_nz_08a2633b:

#   mc "Let's see what you've got then!"
    mc "Vamos ver o que você tem então!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:104
translate brazil ch2sc19_nz_788cd8ae:

