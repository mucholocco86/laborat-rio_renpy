# game/chapters/chapter2/script/ch2sc19_nz.rpy:639
translate brazil ch2sc19_nz_2c2692b5:

#   my "*Giggling* I don't know where you get these lewd ideas from..."
    my "*Risos* Não sei de onde você tira essas ideias indecentes..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:640
translate brazil ch2sc19_nz_40373fbc:

