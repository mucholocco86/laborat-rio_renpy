translate brazil ch2sc19_nz_7b974624:

#   elt "His breathing is so weak, though. What in the five hells happened?"
    elt "A respiração dele está tão fraca. Que diabos aconteceu?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:350
translate brazil ch2sc19_nz_1c40ff78:

#   elt "I need to do something... I can't leave his fate up to chance!"
    elt "Preciso fazer alguma coisa... Não posso deixar o destino dele ao acaso!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:352
translate brazil ch2sc19_nz_df705bdf:

#   elt "Think, Eliza! Think!"
    elt "Pensa, Eliza! Pensa!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:359
translate brazil ch2sc19_nz_33a263dd:

#   elt "That’s right! I saw some Purple Liferoot on the way here!"
    elt "Isso mesmo! Eu vi algumas raízes-da-vida roxas no caminho para cá!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:361
translate brazil ch2sc19_nz_a4002e10:

#   "Eliza gently puts you down and then sprints toward the nearby woods."
    "Eliza coloca você delicadamente no chão e então corre em direção à floresta próxima."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:362
translate brazil ch2sc19_nz_cb434996:

#   el "Be right back! Don’t go anywhere!"
    el "Já volto! Não vá a lugar nenhum!"

