# ARQUIVO: game/chapters/chapter2/script/ch2sc29.rpy DIALOGOS: 451


# game/chapters/chapter2/script/ch2sc29.rpy:11
translate brazil ch2sc29_a2498c0c:

#   mc "I’ll order us some drinks while you find us a spot."
    mc "Vou pedir algumas bebidas enquanto você procura um lugar para nós."

# game/chapters/chapter2/script/ch2sc29.rpy:13
translate brazil ch2sc29_c09bfd95:

#   el "Sure! I’ll grab the best spots!"
    el "Claro! Vou reservar os melhores lugares!"

# game/chapters/chapter2/script/ch2sc29.rpy:14
translate brazil ch2sc29_0abdd2fc:

#   el "You can inform your butt that there's a seat waiting for him!"
    el "Você pode avisar seu traseiro que há um assento esperando por ele!"

# game/chapters/chapter2/script/ch2sc29.rpy:16
translate brazil ch2sc29_5af0b35d:

#   mc "I have the utmost faith in your spot-picking skills."
    mc "Tenho plena confiança na sua capacidade de identificar alvos com precisão."

# game/chapters/chapter2/script/ch2sc29.rpy:18
translate brazil ch2sc29_13784133:

#   el "You'd better! *Giggling*"
    el "É melhor mesmo! *Risos*"

# game/chapters/chapter2/script/ch2sc29.rpy:19
translate brazil ch2sc29_23854871:

#   el "They're amazing! Unmatched even!"
    el "São incríveis! Incomparáveis!"

# game/chapters/chapter2/script/ch2sc29.rpy:21
translate brazil ch2sc29_45fb6249:

#   ik "Welcome to the Rusty spoon!"
    ik "Bem-vindo(a) à colher enferrujada!"

# game/chapters/chapter2/script/ch2sc29.rpy:22
translate brazil ch2sc29_3503c010:

#   ik "What can I get you?"
    ik "O que posso lhe oferecer?"

# game/chapters/chapter2/script/ch2sc29.rpy:24
translate brazil ch2sc29_4be70d5b:

#   mc "*Chuckles* Rusty spoon?"
    mc "*Risos* Colher enferrujada?"

# game/chapters/chapter2/script/ch2sc29.rpy:25
translate brazil ch2sc29_81745b2c:

#   mc "There’s got to be a story behind a name like that."
    mc "Deve haver uma história por trás de um nome como esse."

# game/chapters/chapter2/script/ch2sc29.rpy:27
translate brazil ch2sc29_c135ca60:

#   ik "Nothing eventful, I’m afraid."
    ik "Nada de muito interessante, receio."

# game/chapters/chapter2/script/ch2sc29.rpy:28
translate brazil ch2sc29_4bc08b8e:

#   ik "When I was setting up the tavern, my wife accidentally forgot she left all the spoons in a crate at our house."
    ik "Quando eu estava montando a taverna, minha esposa acidentalmente esqueceu que havia deixado todas as colheres em uma caixa em nossa casa."

# game/chapters/chapter2/script/ch2sc29.rpy:30
translate brazil ch2sc29_f7784110:

#   mc "Outside?"
    mc "Fora?"

# game/chapters/chapter2/script/ch2sc29.rpy:32
translate brazil ch2sc29_e333d37e:

#   ik "Yeah... We were getting ready to move it here, but it started pouring down."
    ik "Sim... Estávamos nos preparando para transferi-lo para cá, mas começou a chover torrencialmente."

# game/chapters/chapter2/script/ch2sc29.rpy:33
translate brazil ch2sc29_6733ff92:

#   ik "The worst rainfall we’ve had in decades!"
    ik "A pior chuva que tivemos em décadas!"

# game/chapters/chapter2/script/ch2sc29.rpy:35
translate brazil ch2sc29_c293efe4:

#   ik "It lasted a full week and we had to crash here for the duration of the storm."
    ik "Durou uma semana inteira e tivemos que ficar aqui durante toda a tempestade."

# game/chapters/chapter2/script/ch2sc29.rpy:37
translate brazil ch2sc29_10ac9d3b:

#   mc "So when you got back to the crate... the spoons were all rusted?"
    mc "Então, quando você voltou para o caixote... as colheres estavam todas enferrujadas?"

# game/chapters/chapter2/script/ch2sc29.rpy:39
translate brazil ch2sc29_7d96bef4:

#   ik "Smart lad! Aye... We managed to scrape the rust off with a remedy my wife bought in Luxenford."
    ik "Garoto esperto! É... Conseguimos remover a ferrugem com um produto que minha esposa comprou em Luxemburgo."

# game/chapters/chapter2/script/ch2sc29.rpy:40
translate brazil ch2sc29_fe7e4fad:

#   ik "However, that’s what led us to the name."
    ik "No entanto, foi isso que nos levou a escolher esse nome."

# game/chapters/chapter2/script/ch2sc29.rpy:42
translate brazil ch2sc29_d3dee951:

#   mc "I like it."
    mc "Eu gosto disso."

# game/chapters/chapter2/script/ch2sc29.rpy:43
translate brazil ch2sc29_3dd792c9:

#   mc "It has a certain charm to it."
    mc "Tem um certo charme."

# game/chapters/chapter2/script/ch2sc29.rpy:45
translate brazil ch2sc29_29fac75a:

#   ik "*Chuckles* Thanks, lad. You’ll still have to pay for your ales, though."
    ik "*Risos* Obrigado, rapaz. Mas você ainda vai ter que pagar pelas suas cervejas."

# game/chapters/chapter2/script/ch2sc29.rpy:47
translate brazil ch2sc29_16e083ab:

#   ik "Tell you what, why don’t you go sit with your girlfriend? I’ll bring the ales over in a moment."
    ik "Sabe de uma coisa? Por que você não vai sentar com a sua namorada? Já trago as cervejas."

# game/chapters/chapter2/script/ch2sc29.rpy:53
translate brazil ch2sc29_1f3cdcde:

#   mc "She’s beautiful, isn’t she?"
    mc "Ela é linda, não é?"

# game/chapters/chapter2/script/ch2sc29.rpy:55
translate brazil ch2sc29_f8a8c47a:

#   ik "She sure is, lad. What I wouldn’t give to be young again."
    ik "Com certeza, rapaz. O que eu não daria para ser jovem de novo."

# game/chapters/chapter2/script/ch2sc29.rpy:56
translate brazil ch2sc29_d1f9e933:

#   ik "How did you land a girl like that?"
    ik "Como você conseguiu conquistar uma garota dessas?"

# game/chapters/chapter2/script/ch2sc29.rpy:58
translate brazil ch2sc29_8118c972:

#   mc "I couldn’t really tell you. I guess we’re alike in some ways."
    mc "Não saberia dizer ao certo. Acho que somos parecidos em alguns aspectos."

# game/chapters/chapter2/script/ch2sc29.rpy:59
translate brazil ch2sc29_3e54738f:

#   mc "Our lives have been intertwined since we were little, although we had no idea at the time."
    mc "Nossas vidas estão entrelaçadas desde que éramos pequenos, embora não tivéssemos ideia disso na época."

# game/chapters/chapter2/script/ch2sc29.rpy:61
translate brazil ch2sc29_e3a3426f:

#   ik "You know what? First round of ales are on me."
    ik "Sabe de uma coisa? A primeira rodada de cervejas é por minha conta."

# game/chapters/chapter2/script/ch2sc29.rpy:62
translate brazil ch2sc29_505b93fd:

#   ik "In the spirit of young love!"
    ik "No espírito do amor jovem!"

# game/chapters/chapter2/script/ch2sc29.rpy:64
translate brazil ch2sc29_ab182d5e:

#   mc "Thank you. I’ll be sure to let her know!"
    mc "Obrigada. Com certeza avisarei a ela!"

# game/chapters/chapter2/script/ch2sc29.rpy:68
translate brazil ch2sc29_8926a288:

#   mc "Oh she’s not my girlfriend, we’re just friends traveling together."
    mc "Ah, ela não é minha namorada, somos apenas amigos viajando juntos."

# game/chapters/chapter2/script/ch2sc29.rpy:70
translate brazil ch2sc29_4b0bba1d:

#   ik "Apologies for assuming. You just seem to have some chemistry."
    ik "Peço desculpas por ter presumido algo. Parece que vocês simplesmente têm uma certa química."

# game/chapters/chapter2/script/ch2sc29.rpy:72
translate brazil ch2sc29_6a4c5e8e:

#   mc "I guess we do. We’ve become close friends in a short amount of time."
    mc "Acho que sim. Nos tornamos amigos íntimos em pouco tempo."

# game/chapters/chapter2/script/ch2sc29.rpy:74
translate brazil ch2sc29_511b85a5:

#   mc "We understand each other, and we've built up a solid amount of trust."
    mc "Nós nos entendemos e construímos uma sólida relação de confiança."

# game/chapters/chapter2/script/ch2sc29.rpy:76
translate brazil ch2sc29_1a80bc59:

#   ik "That’s a great foundation for many things: be it friendship, love, or marriage."
    ik "Essa é uma ótima base para muitas coisas: seja amizade, amor ou casamento."

# game/chapters/chapter2/script/ch2sc29.rpy:78
translate brazil ch2sc29_69ca9eec:

#   mc "I’m starting to see that. How much for the ales?"
    mc "Estou começando a perceber isso. Quanto custam as cervejas?"

# game/chapters/chapter2/script/ch2sc29.rpy:80
translate brazil ch2sc29_aa62b886:

#   ik "I’ve changed my mind. First round is on the house. Just make sure to let others know about the Rusty spoon!"
    ik "Mudei de ideia. A primeira rodada é por conta da casa. Só não se esqueça de avisar os outros sobre a colher enferrujada!"

# game/chapters/chapter2/script/ch2sc29.rpy:82
translate brazil ch2sc29_0c583a10:

#   mc "Thanks! I’ll be sure to mention it to others while we’re on the road."
    mc "Obrigado! Com certeza vou mencionar isso para os outros enquanto estivermos na estrada."

# game/chapters/chapter2/script/ch2sc29.rpy:86
translate brazil ch2sc29_0f2c8eb1:

#   el "*Hums to the ambiance* Hm-hn-hh-hm-hn-hh..."
    el "*Cantarola ao ritmo da música ambiente* Hm-hn-hh-hm-hn-hh..."

# game/chapters/chapter2/script/ch2sc29.rpy:87
translate brazil ch2sc29_532117ed:

#   mc "Hey, you."
    mc "Ei, você aí."

# game/chapters/chapter2/script/ch2sc29.rpy:89
translate brazil ch2sc29_b6c382cc:

#   el "Hi!"
    el "Oi!"

# game/chapters/chapter2/script/ch2sc29.rpy:90
translate brazil ch2sc29_d578cfe0:

#   el "What took you so long?"
    el "Por que demorou tanto?"

# game/chapters/chapter2/script/ch2sc29.rpy:92
translate brazil ch2sc29_1480a2fa:

#   mc "I got to talking with the innkeep."
    mc "Comecei a conversar com o dono da pousada."

# game/chapters/chapter2/script/ch2sc29.rpy:93
translate brazil ch2sc29_731750ad:

#   mc "He was telling me the story behind the name of the tavern, and then he thought you were my girlfriend."
    mc "Ele estava me contando a história por trás do nome da taverna, e aí achou que você era minha namorada."

# game/chapters/chapter2/script/ch2sc29.rpy:96
translate brazil ch2sc29_1b191981:

#   el "!!"
    el "!!"

# game/chapters/chapter2/script/ch2sc29.rpy:98
translate brazil ch2sc29_6ca05526:

#   el "G-Girlfriend? What a silly idea."
    el "Namorada? Que ideia boba."

# game/chapters/chapter2/script/ch2sc29.rpy:100
translate brazil ch2sc29_d1883e9c:

#   el "Just out of curiosity... what did you tell him?"
    el "Só por curiosidade... o que você disse para ele?"

# game/chapters/chapter2/script/ch2sc29.rpy:102
translate brazil ch2sc29_a19aeffa:

#   mc "Wouldn’t you like to know?"
    mc "Você não gostaria de saber?"

# game/chapters/chapter2/script/ch2sc29.rpy:105
translate brazil ch2sc29_6d9728af:

#   el "{b}I WOULD!{/b}"
    el "{b}EU PODERIA!{/b}"

# game/chapters/chapter2/script/ch2sc29.rpy:107
translate brazil ch2sc29_5c45b78a:

#   el "I- mean, I would..."
    el "Quer dizer, eu faria..."

# game/chapters/chapter2/script/ch2sc29.rpy:108
translate brazil ch2sc29_8d5e9322:

#   mc "*Chuckles* You're cute."
    mc "*Risos* Você é fofo(a)."

# game/chapters/chapter2/script/ch2sc29.rpy:109
translate brazil ch2sc29_65e49647:

#   el "It’s rude to keep a lady waiting, you know?"
    el "É falta de educação deixar uma dama esperando, sabe?"

# game/chapters/chapter2/script/ch2sc29.rpy:111
translate brazil ch2sc29_b305efe2:

#   el "Soo?"
    el "E daí?"

# game/chapters/chapter2/script/ch2sc29.rpy:116
translate brazil ch2sc29_abab3f6c:

#   "Eliza’s trust increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "A confiança de Eliza aumentou em {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc29.rpy:120
translate brazil ch2sc29_20572e6e:

#   "!!"
    "!!"

# game/chapters/chapter2/script/ch2sc29.rpy:122
translate brazil ch2sc29_c1dde051:

#   el "Y-You did?"
    el "Você fez isso?"

# game/chapters/chapter2/script/ch2sc29.rpy:124
translate brazil ch2sc29_064b79d7:

#   mc "Mmh, it felt right."
    mc "Hum, pareceu certo."

# game/chapters/chapter2/script/ch2sc29.rpy:125
translate brazil ch2sc29_70d13a59:

#   mc "Why? Shouldn’t I have?"
    mc "Por quê? Eu não deveria ter feito isso?"

# game/chapters/chapter2/script/ch2sc29.rpy:127
translate brazil ch2sc29_a18321f3:

#   el "N-No, it’s okay."
    el "N-Não, tudo bem."

# game/chapters/chapter2/script/ch2sc29.rpy:128
translate brazil ch2sc29_c9883a2a:

#   el "*Whispers quietly* {size=-10}{b}I’m really happy you did.{/b}{/size}"
    el "*Sussurra baixinho* {size=-10}{b}Fico muito feliz que você tenha feito isso.{/b}{/size}"

# game/chapters/chapter2/script/ch2sc29.rpy:130
translate brazil ch2sc29_1573f1f4:

#   elt "Heavens... Girlfriend?"
    elt "Céus... Namorada?"

# game/chapters/chapter2/script/ch2sc29.rpy:131
translate brazil ch2sc29_b218442d:

#   elt "Nyahh! I want to kiss him so badly!"
    elt "Nyahh! Eu quero muito beijá-lo!"

# game/chapters/chapter2/script/ch2sc29.rpy:132
translate brazil ch2sc29_3179ad42:

#   elt "Just jump onto his lap and wrap my legs and arms tightly around him, while our lips intertwine passionately."
    elt "Simplesmente pulo no colo dele e o enrolo com minhas pernas e braços, enquanto nossos lábios se entrelaçam apaixonadamente."

# game/chapters/chapter2/script/ch2sc29.rpy:135
translate brazil ch2sc29_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/chapters/chapter2/script/ch2sc29.rpy:138
translate brazil ch2sc29_74e93029:

#   mc "You're day-dreaming about our future, aren't you? *Chuckles*"
    mc "Você fica sonhando acordado com o nosso futuro, não é? *Risos*"

# game/chapters/chapter2/script/ch2sc29.rpy:140
translate brazil ch2sc29_e3a96c47:

#   el "Hmm?! N-No! I-... that would be crazy... y-yeah... totally crazy..."
    el "Hum?! N-Não! Eu... isso seria loucura... s-sim... totalmente loucura..."

# game/chapters/chapter2/script/ch2sc29.rpy:141
translate brazil ch2sc29_57391501:

#   el "A-Anyway! I’m ready for those ales!"
    el "Enfim! Estou pronto para essas cervejas!"

# game/chapters/chapter2/script/ch2sc29.rpy:143
translate brazil ch2sc29_e5903c6d:

#   mc "Me too, he should be here any moment now."
    mc "Eu também, ele deve chegar a qualquer momento."

# game/chapters/chapter2/script/ch2sc29.rpy:148
translate brazil ch2sc29_8e6c80e7:

#   el "I wonder why he thought we were a couple?"
    el "Eu me pergunto por que ele achou que éramos um casal?"

# game/chapters/chapter2/script/ch2sc29.rpy:150
translate brazil ch2sc29_7055bfc8:

#   mc "He said we had chemistry."
    mc "Ele disse que tínhamos química."

# game/chapters/chapter2/script/ch2sc29.rpy:152
translate brazil ch2sc29_148ab593:

#   el "I suppose we do. I just didn’t know it was obvious to others."
    el "Acho que sim. Só não sabia que era óbvio para os outros."

# game/chapters/chapter2/script/ch2sc29.rpy:154
translate brazil ch2sc29_d8aac7eb:

#   mc "Maybe he's just perceptive."
    mc "Talvez ele seja apenas perspicaz."

# game/chapters/chapter2/script/ch2sc29.rpy:156
translate brazil ch2sc29_c2147ef8:

#   el "Yeah. That’s probably it..."
    el "Sim. Provavelmente é isso..."

# game/chapters/chapter2/script/ch2sc29.rpy:157
translate brazil ch2sc29_92578d50:

#   el "Innkeepers talk to people all the time. They're probably used to picking up on such things."
    el "Os donos de pousadas conversam com as pessoas o tempo todo. Provavelmente estão acostumados a perceber esse tipo de coisa."

# game/chapters/chapter2/script/ch2sc29.rpy:158
translate brazil ch2sc29_5c4aa11e:

#   "Eliza’s trust increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "A confiança de Eliza aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc29.rpy:161
translate brazil ch2sc29_74f6627a:

#   ik "Here you are, do call me if you youngsters need anything else."
    ik "Aqui está, liguem-me se vocês, jovens, precisarem de mais alguma coisa."

# game/chapters/chapter2/script/ch2sc29.rpy:163
translate brazil ch2sc29_47a22870:

#   el "Thank you sir! This is exactly what we need right now!"
    el "Muito obrigado, senhor! É exatamente disso que precisamos neste momento!"

# game/chapters/chapter2/script/ch2sc29.rpy:165
translate brazil ch2sc29_d4a67591:

#   el "Oh! Oh! What should we toast to?"
    el "Oh! Oh! A que devemos fazer um brinde?"

# game/chapters/chapter2/script/ch2sc29.rpy:171
translate brazil ch2sc29_6608fc04:

#   el "To us! Cheers!"
    el "À nossa saúde! Um brinde!"

# game/chapters/chapter2/script/ch2sc29.rpy:174
translate brazil ch2sc29_13cf4476:

#   el "I like it! Cheers!"
    el "Gostei! Saúde!"

# game/chapters/chapter2/script/ch2sc29.rpy:177
translate brazil ch2sc29_4d7a3316:

#   el "The sweet taste of revenge! Cheers!"
    el "O doce sabor da vingança! Saúde!"

# game/chapters/chapter2/script/ch2sc29.rpy:180
translate brazil ch2sc29_c77139ba:

#   mc "You’ve earned it... being on the road for days isn't easy, yet you barely complaim."
    mc "Você merece... ficar na estrada por dias não é fácil, mas você quase não reclama."

# game/chapters/chapter2/script/ch2sc29.rpy:181
translate brazil ch2sc29_bec09ba0:

#   mc "Let’s enjoy ourselves, Cheers!"
    mc "Vamos nos divertir! Saúde!"

# game/chapters/chapter2/script/ch2sc29.rpy:188
translate brazil ch2sc29_598c7d66:

#   el "UUaaaAAaahh! This is so good!"
    el "UUaaaAAaahh! Isso é tão bom!"

# game/chapters/chapter2/script/ch2sc29.rpy:191
translate brazil ch2sc29_06daa561:

#   el "*Gulp, gulp* Hnngh..."
    el "*Engole em seco* Hnngh..."

# game/chapters/chapter2/script/ch2sc29.rpy:193
translate brazil ch2sc29_838c34de:

#   el "You're right! We've earned a little bit of comfort!"
    el "Você tem razão! Merecemos um pouco de conforto!"

# game/chapters/chapter2/script/ch2sc29.rpy:198
translate brazil ch2sc29_74120b8b:

#   el "Is now a good time to ask you about the guy who attacked us at the lake?"
    el "Agora seria um bom momento para te perguntar sobre o cara que nos atacou no lago?"

# game/chapters/chapter2/script/ch2sc29.rpy:200
translate brazil ch2sc29_7ada4607:

#   el "He clearly wasn’t just a regular thug... the way he fought you, on top of the water..."
    el "Ele claramente não era um bandido qualquer... o jeito que ele lutou com você, em cima da água..."

# game/chapters/chapter2/script/ch2sc29.rpy:201
translate brazil ch2sc29_0cf90f2d:

#   el "At one point, I-I thought..."
    el "Em um dado momento, eu pensei..."

# game/chapters/chapter2/script/ch2sc29.rpy:204
translate brazil ch2sc29_d7326957:

#   el "He almost drowned you [mc]!"
    el "Ele quase te afogou. [mc]!"

# game/chapters/chapter2/script/ch2sc29.rpy:205
translate brazil ch2sc29_bbc8fb55:

#   el "That’s not okay! I don’t accept that!"
    el "Isso não está certo! Eu não aceito isso!"

# game/chapters/chapter2/script/ch2sc29.rpy:207
translate brazil ch2sc29_c673afe7:

#   mc "Calm down, you little firecracker."
    mc "Calma, sua danadinha."

# game/chapters/chapter2/script/ch2sc29.rpy:208
translate brazil ch2sc29_2d91fd23:

#   mc "I’ll tell you... you're right, he wasn't a regular thug."
    mc "Vou te dizer... você tem razão, ele não era um bandido comum."

# game/chapters/chapter2/script/ch2sc29.rpy:210
translate brazil ch2sc29_7e6bcd96:

#   mc "The guy who attacked us is... well, was a Shado-jin."
    mc "O cara que nos atacou é... bem, era um Shado-jin."

# game/chapters/chapter2/script/ch2sc29.rpy:211
translate brazil ch2sc29_a8c95f92:

#   mc "They're an elite group within the Mercenaries Guild."
    mc "Eles são um grupo de elite dentro da Guilda dos Mercenários."

# game/chapters/chapter2/script/ch2sc29.rpy:212
translate brazil ch2sc29_8dc1952d:

#   mc "They are technically free-lance, but from what I know, it's mostly that guild who makes use of them."
    mc "Tecnicamente, eles são freelancers, mas pelo que sei, é principalmente essa guilda que os utiliza."

# game/chapters/chapter2/script/ch2sc29.rpy:214
translate brazil ch2sc29_ad723032:

#   mc "Only their best and most hardened members advance to become Shado-jins."
    mc "Apenas seus membros mais fortes e experientes progridem para se tornarem Shado-jins."

# game/chapters/chapter2/script/ch2sc29.rpy:216
translate brazil ch2sc29_92d87359:

#   el "I take it this wasn’t your first run-in with them?"
    el "Imagino que este não tenha sido seu primeiro encontro com eles?"

# game/chapters/chapter2/script/ch2sc29.rpy:217
translate brazil ch2sc29_1a129a86:

#   el "Given you've been on the run and seemed familiar with them."
    el "Considerando que você estava foragido e parecia estar familiarizado com eles."

# game/chapters/chapter2/script/ch2sc29.rpy:219
translate brazil ch2sc29_26a2af42:

#   mc "You’re right about that, apparently he had a brother who was also in that group."
    mc "Você tem razão, aparentemente ele tinha um irmão que também fazia parte desse grupo."

# game/chapters/chapter2/script/ch2sc29.rpy:220
translate brazil ch2sc29_a40d5448:

#   mc "And his brother tracked your father and me down, around two years ago."
    mc "E o irmão dele localizou a mim e ao seu pai, há cerca de dois anos."

# game/chapters/chapter2/script/ch2sc29.rpy:222
translate brazil ch2sc29_cd8abd0e:

#   mc "I wasn’t a match for him, but Oren handled him."
    mc "Eu não era páreo para ele, mas Oren deu conta do recado."

# game/chapters/chapter2/script/ch2sc29.rpy:223
translate brazil ch2sc29_1fafd2a5:

#   mc "The one who attacked us..."
    mc "Aquele que nos atacou..."

# game/chapters/chapter2/script/ch2sc29.rpy:224
translate brazil ch2sc29_d71c7ef8:

#   mc "He was after revenge for his brother, the bounty on me was just a bonus."
    mc "Ele queria vingança pela morte do irmão, a recompensa pela minha cabeça era apenas um bônus."

# game/chapters/chapter2/script/ch2sc29.rpy:227
translate brazil ch2sc29_c43f19e8:

#   elt "Those bastards have been hunting [mc] ever since he was a kid..."
    elt "Aqueles desgraçados andam caçando [mc] desde que ele era criança..."

# game/chapters/chapter2/script/ch2sc29.rpy:229
translate brazil ch2sc29_bd7b14bc:

#   el "What happened after you defeated him at the lake?"
    el "O que aconteceu depois que você o derrotou no lago?"

# game/chapters/chapter2/script/ch2sc29.rpy:230
translate brazil ch2sc29_3233bbe1:

#   el "You absorbed something from him? And then you collapsed, you were out cold for over an hour."
    el "Você absorveu alguma coisa dele? E então você desmaiou, ficou inconsciente por mais de uma hora."

# game/chapters/chapter2/script/ch2sc29.rpy:235
translate brazil ch2sc29_6c307337:

#   mc "I siphoned the mana cells in his body. He’ll live, but he won’t ever be able to use magic again."
    mc "Eu drenei as células de mana do corpo dele. Ele vai sobreviver, mas nunca mais poderá usar magia."

# game/chapters/chapter2/script/ch2sc29.rpy:236
translate brazil ch2sc29_c35df066:

#   mc "He’ll be physically weaker as well."
    mc "Ele também ficará fisicamente mais fraco."

# game/chapters/chapter2/script/ch2sc29.rpy:238
translate brazil ch2sc29_2b2913cb:

#   mc "I don’t gain as much strength from doing that compared to absorbing a soul, but it still makes me stronger."
    mc "Não ganho tanta força fazendo isso em comparação com absorver uma alma, mas ainda assim me torna mais forte."

# game/chapters/chapter2/script/ch2sc29.rpy:241
translate brazil ch2sc29_5a83430c:

#   mc "I absorbed his soul after he died. It increases my strength and allows me to grow my abilities."
    mc "Absorvi a alma dele depois que ele morreu. Isso aumenta minha força e me permite desenvolver minhas habilidades."

# game/chapters/chapter2/script/ch2sc29.rpy:242
translate brazil ch2sc29_314f5cb3:

#   mc "But it’s very painful and it can be overwhelming when it happens."
    mc "Mas é muito doloroso e pode ser avassalador quando acontece."

# game/chapters/chapter2/script/ch2sc29.rpy:246
translate brazil ch2sc29_48c2dd09:

#   mc "I don't have much experience doing... that."
    mc "Não tenho muita experiência nisso."

# game/chapters/chapter2/script/ch2sc29.rpy:248
translate brazil ch2sc29_c26e60db:

#   el "I see... you really had me worried when you collapsed."
    el "Entendi... você realmente me deixou preocupado quando desmaiou."

# game/chapters/chapter2/script/ch2sc29.rpy:249
translate brazil ch2sc29_00b487c8:

#   el "Has that happened before?"
    el "Isso já aconteceu antes?"

# game/chapters/chapter2/script/ch2sc29.rpy:251
translate brazil ch2sc29_7a6177fe:

#   mc "Not that I know of... All this is a learn-as-I-go process for me."
    mc "Que eu saiba, não... Tudo isso é um processo de aprendizado contínuo para mim."

# game/chapters/chapter2/script/ch2sc29.rpy:252
translate brazil ch2sc29_fcf2031c:

#   mc "It’s not like I went around absorbing souls as a kid, you know?"
    mc "Não é como se eu saísse por aí absorvendo almas quando era criança, sabe?"

# game/chapters/chapter2/script/ch2sc29.rpy:254
translate brazil ch2sc29_11c9a63c:

#   mc "Your father always warned me to be careful with it."
    mc "Seu pai sempre me alertava para ter cuidado com isso."

# game/chapters/chapter2/script/ch2sc29.rpy:255
translate brazil ch2sc29_42895ebd:

#   mc "Because power can be corrupting and addictive."
    mc "Porque o poder pode ser corruptor e viciante."

# game/chapters/chapter2/script/ch2sc29.rpy:257
translate brazil ch2sc29_e97acc7f:

#   el "I won’t allow you to end up like Balthazar."
    el "Não permitirei que você acabe como Baltazar."

# game/chapters/chapter2/script/ch2sc29.rpy:259
translate brazil ch2sc29_d777072e:

#   mc "I know you won't. I feel better knowing you have my back."
    mc "Eu sei que não vai. Me sinto melhor sabendo que posso contar com você."

# game/chapters/chapter2/script/ch2sc29.rpy:261
translate brazil ch2sc29_8b5e405c:

#   elt "He really does appreciate me."
    elt "Ele realmente gosta muito de mim."

# game/chapters/chapter2/script/ch2sc29.rpy:263
translate brazil ch2sc29_05519f37:

#   el "I have your back, front, and sides!"
    el "Tenho você de costas, da frente e dos lados!"

# game/chapters/chapter2/script/ch2sc29.rpy:266
translate brazil ch2sc29_eaba4b38:

#   mct "If I have to go through all this with anyone, I'm glad it's her."
    mct "Se eu tiver que passar por tudo isso com alguém, fico feliz que seja com ela."

# game/chapters/chapter2/script/ch2sc29.rpy:268
translate brazil ch2sc29_f9f24c38:

#   mc "Anyway, I think we’ll reach Luxenford tomorrow."
    mc "De qualquer forma, acho que chegaremos a Luxemburgo amanhã."

# game/chapters/chapter2/script/ch2sc29.rpy:270
translate brazil ch2sc29_09d723c6:

#   el "How do you know that?"
    el "Como você sabe disso?"

# game/chapters/chapter2/script/ch2sc29.rpy:271
translate brazil ch2sc29_4d2c37b1:

#   el "*Giggling* Are you going to tell me that being a Nephilim gives you psychic powers?"
    el "*Risos* Você vai me dizer que ser um Nefilim te dá poderes psíquicos?"

# game/chapters/chapter2/script/ch2sc29.rpy:275
translate brazil ch2sc29_4ff1f489:

#   mc "*Chuckles* Not that I’m aware of."
    mc "*Risos* Que eu saiba, não."

# game/chapters/chapter2/script/ch2sc29.rpy:276
translate brazil ch2sc29_606e4835:

#   mc "I overheard someone talking about the capital when I was speaking to the innkeeper."
    mc "Enquanto conversava com o dono da pousada, ouvi alguém falando sobre a capital."

# game/chapters/chapter2/script/ch2sc29.rpy:278
translate brazil ch2sc29_317c6e97:

#   mc "Sounded like they were on a day trip to deliver some goods."
    mc "Parecia que eles estavam em uma viagem de um dia para entregar algumas mercadorias."

# game/chapters/chapter2/script/ch2sc29.rpy:280
translate brazil ch2sc29_fce18f18:

#   el "Then it should be close!"
    el "Então deve estar perto!"

# game/chapters/chapter2/script/ch2sc29.rpy:282
translate brazil ch2sc29_cf165430:

#   mc "Yeah, by the end of tomorrow we should arrive at the gates to the city."
    mc "Sim, até o final de amanhã devemos chegar aos portões da cidade."

# game/chapters/chapter2/script/ch2sc29.rpy:283
translate brazil ch2sc29_26e62116:

#   mc "I’m excited, honestly."
    mc "Estou animado, sinceramente."

# game/chapters/chapter2/script/ch2sc29.rpy:285
translate brazil ch2sc29_36075576:

#   el "Wait, how many ales did you have?"
    el "Espere, quantas cervejas você tomou?"

# game/chapters/chapter2/script/ch2sc29.rpy:287
translate brazil ch2sc29_bff3a6eb:

#   mc "One."
    mc "Um."

# game/chapters/chapter2/script/ch2sc29.rpy:288
translate brazil ch2sc29_6496aded:

#   mc "Why? Do I look drunk or something?"
    mc "Por quê? Será que eu pareço bêbado ou algo assim?"

# game/chapters/chapter2/script/ch2sc29.rpy:290
translate brazil ch2sc29_6032f378:

#   el "No, but-... You don't usually get excited about..."
    el "Não, mas... Você geralmente não se empolga com..."

# game/chapters/chapter2/script/ch2sc29.rpy:291
translate brazil ch2sc29_5ee21f3b:

#   el "Well, anything!"
    el "Bem, qualquer coisa!"

# game/chapters/chapter2/script/ch2sc29.rpy:293
translate brazil ch2sc29_e38632b0:

#   mc "Reaching the capital is the first big step towards my goal."
    mc "Chegar à capital é o primeiro grande passo rumo ao meu objetivo."

# game/chapters/chapter2/script/ch2sc29.rpy:295
translate brazil ch2sc29_5cdd1e87:

#   el "{b}Our{/b} goal."
    el "{b}Nosso{/b} meta."

# game/chapters/chapter2/script/ch2sc29.rpy:299
translate brazil ch2sc29_84f4573f:

#   el "It’s {b}our{/b} goal, [mc]."
    el "Isso é {b} nosso{/b} meta, [mc]."

# game/chapters/chapter2/script/ch2sc29.rpy:300
translate brazil ch2sc29_4a52027f:

#   el "You’re forgetting, the person who killed your parents is also the reason why my father left Mother and me."
    el "Você está se esquecendo de que a pessoa que matou seus pais também é a razão pela qual meu pai abandonou minha mãe e a mim."

# game/chapters/chapter2/script/ch2sc29.rpy:302
translate brazil ch2sc29_b9ae216c:

#   el "And that led to Mother drinking and whoring her sorrows away, and eventually leaving me all alone."
    el "E isso fez com que minha mãe afogasse as mágoas na bebida e na prostituição, e eventualmente me deixasse completamente sozinha."

# game/chapters/chapter2/script/ch2sc29.rpy:303
translate brazil ch2sc29_80c22f63:

#   el "He ruined my childhood as much as he did yours."
    el "Ele arruinou minha infância tanto quanto arruinou a sua."

# game/chapters/chapter2/script/ch2sc29.rpy:305
translate brazil ch2sc29_2b1982b6:

#   mc "You’re right."
    mc "Você tem razão."

# game/chapters/chapter2/script/ch2sc29.rpy:306
translate brazil ch2sc29_6fe78d4e:

#   mc "I’m sorry, Eliza. {b}Our{/b} goal."
    mc "Sinto muito, Eliza. {b} Nosso{/b} meta."

# game/chapters/chapter2/script/ch2sc29.rpy:308
translate brazil ch2sc29_045e3467:

#   el "I’ll drink to that! Cheers!"
    el "Brindo a isso! Saúde!"

# game/chapters/chapter2/script/ch2sc29.rpy:316
translate brazil ch2sc29_4b31d8ec:

#   el "UUaaaAAaahh! *Giggling*"
    el "UUaaaAAaahh! *Risos*"

# game/chapters/chapter2/script/ch2sc29.rpy:318
translate brazil ch2sc29_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter2/script/ch2sc29.rpy:319
translate brazil ch2sc29_0fd4d656:

#   "......"
    "......"

# game/chapters/chapter2/script/ch2sc29.rpy:320
translate brazil ch2sc29_278c7e29:

#   "........."
    "........."

# game/chapters/chapter2/script/ch2sc29.rpy:322
translate brazil ch2sc29_6302ae72:

#   el "Hey, [mc]."
    el "Ei, [mc]."

# game/chapters/chapter2/script/ch2sc29.rpy:324
translate brazil ch2sc29_f49fff8f:

#   mc "Yeah?"
    mc "Sim?"

# game/chapters/chapter2/script/ch2sc29.rpy:326
translate brazil ch2sc29_6d2bd260:

#   el "Why don’t we..."
    el "Por que não fazemos isso...?"

# game/chapters/chapter2/script/ch2sc29.rpy:327
translate brazil ch2sc29_77d60003:

#   el "head upstairs?"
    el "Subir as escadas?"

# game/chapters/chapter2/script/ch2sc29.rpy:329
translate brazil ch2sc29_1c75b444:

#   mc "It's getting a little crowded down here..."
    mc "Está ficando um pouco lotado por aqui..."

# game/chapters/chapter2/script/ch2sc29.rpy:330
translate brazil ch2sc29_3e498f6b:

#   elt "*Giggling softly* Yeah... way too crowded."
    elt "*Risos baixinhos* É... muito cheio."

# game/chapters/chapter2/script/ch2sc29.rpy:332
translate brazil ch2sc29_a365df9e:

#   el "Follow me."
    el "Me siga."

# game/chapters/chapter2/script/ch2sc29.rpy:335
translate brazil ch2sc29_03dad947:

#   mc "Right behind you."
    mc "Logo atrás de você."

# game/chapters/chapter2/script/ch2sc29.rpy:337
translate brazil ch2sc29_30259fba:

#   el "Good, enjoy the view."
    el "Ótimo, aproveite a vista."

# game/chapters/chapter2/script/ch2sc29.rpy:339
translate brazil ch2sc29_47ddf053:

#   mc "We men are simple creatures..."
    mc "Nós, homens, somos criaturas simples..."

# game/chapters/chapter2/script/ch2sc29.rpy:340
translate brazil ch2sc29_bbdd1a29:

#   mc "You know how much I appreciate a good view."
    mc "Você sabe o quanto eu aprecio uma bela vista."

# game/chapters/chapter2/script/ch2sc29.rpy:342
translate brazil ch2sc29_128f48c7:

#   el "*Giggling* I've noticed! And since you've been so sweet recently, I won't even pretend to be upset."
    el "*Risos* Eu percebi! E já que você tem sido tão gentil ultimamente, nem vou fingir que estou chateada."

# game/chapters/chapter2/script/ch2sc29.rpy:349
translate brazil ch2sc29_22d8be6f:

#   el "Woah! This room is so spacious!"
    el "Uau! Este quarto é muito espaçoso!"

# game/chapters/chapter2/script/ch2sc29.rpy:350
translate brazil ch2sc29_ca5a9e0c:

#   el "I think we've been given the master-suit! Don't you?"
    el "Acho que nos deram o traje principal! Você não acha?"

# game/chapters/chapter2/script/ch2sc29.rpy:353
translate brazil ch2sc29_0e26370f:

#   mc "*Chuckles* I wouldn't be surprised."
    mc "*Risos* Não me surpreenderia."

# game/chapters/chapter2/script/ch2sc29.rpy:356
translate brazil ch2sc29_d9219b36:

#   mc "The innkeep seemed like a fan of yours."
    mc "O dono da pousada parecia ser seu fã."

# game/chapters/chapter2/script/ch2sc29.rpy:358
translate brazil ch2sc29_8de4cfd9:

#   el "What are you waiting for?"
    el "O que você está esperando?"

# game/chapters/chapter2/script/ch2sc29.rpy:359
translate brazil ch2sc29_4b338f50:

#   el "This bed literally has our names written on it!"
    el "Essa cama tem literalmente nossos nomes escritos nela!"

# game/chapters/chapter2/script/ch2sc29.rpy:367
translate brazil ch2sc29_3d324fa9:

#   el "It's been a long day, I'm so happy we made it to a tavern."
    el "Foi um dia longo, estou tão feliz que conseguimos chegar a uma taverna."

# game/chapters/chapter2/script/ch2sc29.rpy:370
translate brazil ch2sc29_c1ffe466:

#   el "*Whispers softly* {size=-10}{b}Finally... we're alone.{/b}{/size}"
    el "*Sussurra baixinho* {size=-10}{b}Finalmente... estamos sozinhos.{/b}{/size}"

# game/chapters/chapter2/script/ch2sc29.rpy:371
translate brazil ch2sc29_95649cf2:

#   "She melts against you immediately as your arms wrap around her, as if she's been longing for you to be close."
    "Ela se aconchega em você imediatamente assim que seus braços a envolvem, como se estivesse ansiando por sua proximidade."

# game/chapters/chapter2/script/ch2sc29.rpy:373
translate brazil ch2sc29_29a7f3b9:

#   el "Mmhh... [mc]."
    el "Hum... [mc]."

# game/chapters/chapter2/script/ch2sc29.rpy:374
translate brazil ch2sc29_5ee6237c:

#   "The sound of her soft moans as your bodies rub against each other is a melody you’ve been longing to hear."
    "O som dos seus gemidos suaves enquanto seus corpos se roçam é uma melodia que você ansiava ouvir."

# game/chapters/chapter2/script/ch2sc29.rpy:377
translate brazil ch2sc29_68295728:

#   "Her fingers slowly reach your hips, where she starts squeezing firmly while pressing herself against you."
    "Os dedos dela alcançam lentamente seus quadris, onde ela começa a apertar com firmeza enquanto se pressiona contra você."

# game/chapters/chapter2/script/ch2sc29.rpy:380
translate brazil ch2sc29_6d5073dd:

#   el "Aaaiihh... Mmhmhh."
    el "Aaaiihh... Mmhmhh."

# game/chapters/chapter2/script/ch2sc29.rpy:381
translate brazil ch2sc29_9b773b17:

#   "Leaning back into you, she whimpers as you grab her upper waist, holding onto her firmly."
    "Recostando-se em você, ela geme enquanto você a segura pela cintura, mantendo-a firmemente no colo."

# game/chapters/chapter2/script/ch2sc29.rpy:383
translate brazil ch2sc29_5bc5812a:

#   el "Hi you."
    el "Olá."

# game/chapters/chapter2/script/ch2sc29.rpy:385
translate brazil ch2sc29_471bf062:

#   mc "Hey Gorgeous."
    mc "Olá, linda."

# game/chapters/chapter2/script/ch2sc29.rpy:387
translate brazil ch2sc29_191dff03:

#   elt "Divines! I feel like I'm turning to pudding in his arms!"
    elt "Meu Deus! Sinto que estou virando pudim em seus braços!"

# game/chapters/chapter2/script/ch2sc29.rpy:389
translate brazil ch2sc29_f22f5172:

#   el "*Bites lip* Nnyah... This is just what I needed."
    el "*Morde o lábio* Nnyah... Era exatamente disso que eu precisava."

# game/chapters/chapter2/script/ch2sc29.rpy:391
translate brazil ch2sc29_688f5c68:

#   mc "You didn’t get enough during training earlier?"
    mc "Você não recebeu o suficiente durante o treinamento anterior?"

# game/chapters/chapter2/script/ch2sc29.rpy:393
translate brazil ch2sc29_9459221f:

#   el "Yes-No. It did something to me... You did something to me, [mc]."
    el "Sim-Não. Isso me afetou de alguma forma... Você me afetou de alguma forma. [mc]."

# game/chapters/chapter2/script/ch2sc29.rpy:394
translate brazil ch2sc29_83cad591:

#   el "Our kisses earlier they... ignited something within me."
    el "Nossos beijos mais cedo... despertaram algo dentro de mim."

# game/chapters/chapter2/script/ch2sc29.rpy:395
translate brazil ch2sc29_d47fb7dd:

#   el "I-I can’t stop thinking about your hands on me. How your touch sends pulses through my body..."
    el "Não consigo parar de pensar nas suas mãos em mim. Em como seu toque me causa arrepios..."

# game/chapters/chapter2/script/ch2sc29.rpy:397
translate brazil ch2sc29_e1692be3:

#   mc "Like this?"
    mc "Assim?"

# game/chapters/chapter2/script/ch2sc29.rpy:399
translate brazil ch2sc29_7ec3b5d5:

#   elt "{b}MMhHhH!{/b} His touch is electrifying!"
    elt "{b}MMhHhH!{/b} Seu toque é eletrizante!"

# game/chapters/chapter2/script/ch2sc29.rpy:401
translate brazil ch2sc29_6f95e966:

#   el "Yes! Every time you’ve spoken to me since then..."
    el "Sim! Todas as vezes que você falou comigo desde então..."

# game/chapters/chapter2/script/ch2sc29.rpy:402
translate brazil ch2sc29_549ef7c5:

#   el "I've caught myself looking at your lips, just wanting to feel them on me."
    el "Eu me peguei olhando para seus lábios, desejando senti-los nos meus."

# game/chapters/chapter2/script/ch2sc29.rpy:404
translate brazil ch2sc29_6b778379:

#   mc "Then I shouldn't keep you waiting."
    mc "Então não devo te fazer esperar."

# game/chapters/chapter2/script/ch2sc29.rpy:405
translate brazil ch2sc29_11ea1044:

#   el "Aaah!! Y-Yes... that feels even better than I imagined."
    el "Aaah!! S-Sim... isso é ainda melhor do que eu imaginava."

# game/chapters/chapter2/script/ch2sc29.rpy:407
translate brazil ch2sc29_a2f051c8:

#   mc "*Whispers & Kisses* {size=-10}{b}You’ve been thinking about this?{/b}{/size}"
    mc "*Sussurros e beijos* {size=-10}{b}Você tem pensado nisso?{/b}{/size}"

# game/chapters/chapter2/script/ch2sc29.rpy:408
translate brazil ch2sc29_1ad94ad9:

#   mc "*Whispers & Kisses* {size=-10}{b}About my hands touching your smooth skin, while my lips taste your neck?{/b}{/size}"
    mc "*Sussurros e beijos* {size=-10}{b}E as minhas mãos tocando sua pele macia, enquanto meus lábios saboreiam seu pescoço?{/b}{/size}"

# game/chapters/chapter2/script/ch2sc29.rpy:410
translate brazil ch2sc29_22352dce:

#   el "N-No."
    el "N-Não."

# game/chapters/chapter2/script/ch2sc29.rpy:411
translate brazil ch2sc29_ef429161:

#   el "N-No. Aaah..."
    el "N-Não. Aaah..."

# game/chapters/chapter2/script/ch2sc29.rpy:412
translate brazil ch2sc29_2d13ccf7:

#   el "N-No... Aaah... Yes. Yes I have."
    el "N-Não... Ah... Sim. Sim, eu tenho."

# game/chapters/chapter2/script/ch2sc29.rpy:413
translate brazil ch2sc29_b4a2ac5d:

#   el "Please don’t stop."
    el "Por favor, não pare."

# game/chapters/chapter2/script/ch2sc29.rpy:415
translate brazil ch2sc29_875d8a7d:

