translate brazil ch2sc29_68b4d97e:

#   el "Mfffhh... {b}MmffhH!{/b}"
    el "Mfffhh... {b} MmffhH!{/b}"

# game/chapters/chapter2/script/ch2sc29.rpy:691
translate brazil ch2sc29_5f9708c7:

#   "With her mouth filled with your seed, she looks up into your eyes."
    "Com a boca cheia do seu sêmen, ela olha nos seus olhos."

# game/chapters/chapter2/script/ch2sc29.rpy:692
translate brazil ch2sc29_e9d2a56e:

#   mct "*Chuckles* She's awaiting my approval to swallow?"
    mct "*Risos* Ela está esperando minha aprovação para engolir?"

# game/chapters/chapter2/script/ch2sc29.rpy:693
translate brazil ch2sc29_d7204a6d:

#   mc "Go ahead, Kitten. You've earned it."
    mc "Vai em frente, gatinha. Você merece."

# game/chapters/chapter2/script/ch2sc29.rpy:696
translate brazil ch2sc29_d30124dc:

#   el "{b}*Gulp*{/b}"
    el "{b}*Gole*{/b}"

# game/chapters/chapter2/script/ch2sc29.rpy:699
translate brazil ch2sc29_215ba2c7:

#   el "Aaaaaaaaaaahhhhh."
    el "Aaaaaaaaaahhhhh."

# game/chapters/chapter2/script/ch2sc29.rpy:700
translate brazil ch2sc29_51fc7b33:

#   mct "Five hells... she's letting me see that she swallowed every last drop."
    mct "Pelos cinco infernos... ela está me deixando ver que engoliu até a última gota."

# game/chapters/chapter2/script/ch2sc29.rpy:703
translate brazil ch2sc29_10450a2d:

#   "She kisses you one last time, her gaze still locked onto you..."
    "Ela te beija uma última vez, com o olhar ainda fixo em você..."

# game/chapters/chapter2/script/ch2sc29.rpy:704
translate brazil ch2sc29_a84d4179:

#   "Proudly observing the pleasure you're feeling."
    "Observando com orgulho o prazer que você está sentindo."

# game/chapters/chapter2/script/ch2sc29.rpy:705
translate brazil ch2sc29_92a32f00:

#   mct "This girl!"
    mct "Essa garota!"

# game/chapters/chapter2/script/ch2sc29.rpy:706
translate brazil ch2sc29_bc5018a8:

#   mct "I'm a lucky man."
    mct "Sou um homem de sorte."

# game/chapters/chapter2/script/ch2sc29.rpy:709
translate brazil ch2sc29_3770fa04:

#   elt "The look on his face. I’ve never seen him that happy before."
    elt "A expressão no rosto dele. Nunca o vi tão feliz antes."

# game/chapters/chapter2/script/ch2sc29.rpy:710
translate brazil ch2sc29_02176ff7:

#   elt "I think he loved it as much as I did."
    elt "Acho que ele gostou tanto quanto eu."

# game/chapters/chapter2/script/ch2sc29.rpy:712
translate brazil ch2sc29_501889c2:

#   el "D-Did I do alright?"
    el "Eu me saí bem?"

# game/chapters/chapter2/script/ch2sc29.rpy:714
translate brazil ch2sc29_34815b46:

#   mc "You're kidding, right? You’ve left me speechless."
    mc "Você está brincando, né? Você me deixou sem palavras."

# game/chapters/chapter2/script/ch2sc29.rpy:715
translate brazil ch2sc29_d5fc8451:

#   mc "I've never felt this good, Eliza. You were incredible."
    mc "Nunca me senti tão bem, Eliza. Você foi incrível."

# game/chapters/chapter2/script/ch2sc29.rpy:717
translate brazil ch2sc29_17e5fbf9:

#   el "Hold me? Please."
    el "Me abrace? Por favor."

# game/chapters/chapter2/script/ch2sc29.rpy:718
translate brazil ch2sc29_4b2a19c4:

#   el "I'd like to... be close to you."
    el "Eu gostaria de... estar perto de você."

# game/chapters/chapter2/script/ch2sc29.rpy:720
translate brazil ch2sc29_30a3019d:

#   mc "Anytime, anywhere, Eliza."
    mc "A qualquer hora, em qualquer lugar, Eliza."

# game/chapters/chapter2/script/ch2sc29.rpy:721
translate brazil ch2sc29_d3167096:

#   mc "You belong in my arms."
    mc "Você pertence aos meus braços."

# game/chapters/chapter2/script/ch2sc29.rpy:723
translate brazil ch2sc29_7bae1344:

#   el "That good, huh?"
    el "Isso é bom, né?"

# game/chapters/chapter2/script/ch2sc29.rpy:724
translate brazil ch2sc29_936adc4e:

#   el "I couldn't stop myself... you were delicious."
    el "Eu não consegui me controlar... você estava deliciosa."

# game/chapters/chapter2/script/ch2sc29.rpy:726
translate brazil ch2sc29_39c19984:

#   mc "You were incredible, Eliza."
    mc "Você foi incrível, Eliza."

# game/chapters/chapter2/script/ch2sc29.rpy:727
translate brazil ch2sc29_056056de:

#   mc "That thing you did with your tongue... what was that?"
    mc "Aquela coisa que você fez com a língua... o que foi isso?"

# game/chapters/chapter2/script/ch2sc29.rpy:729
translate brazil ch2sc29_f0ef90ed:

#   el "I have no idea. You just tasted really good, so I wanted to keep licking."
    el "Não faço ideia. Você tinha um gosto muito bom, então eu queria continuar lambendo."

# game/chapters/chapter2/script/ch2sc29.rpy:730
translate brazil ch2sc29_10336d2c:

#   el "Judging by how much you filled my mouth at the end, I think I can safely assume you enjoyed it?"
    el "A julgar pela quantidade que você colocou na minha boca no final, acho que posso presumir com segurança que você gostou?"

# game/chapters/chapter2/script/ch2sc29.rpy:732
translate brazil ch2sc29_0a127774:

#   mc "Enjoyed it?"
    mc "Gostou?"

# game/chapters/chapter2/script/ch2sc29.rpy:733
translate brazil ch2sc29_26f6c8ab:

#   mc "I'm already thinking we should do it again."
    mc "Já estou pensando que deveríamos fazer isso de novo."

# game/chapters/chapter2/script/ch2sc29.rpy:736
translate brazil ch2sc29_e8d17f8e:

#   el "*Giggling* Mh-hm!"
    el "*Risos* Hum-hum!"

# game/chapters/chapter2/script/ch2sc29.rpy:737
translate brazil ch2sc29_7bd732c2:

#   el "Definitely!"
    el "Definitivamente!"

# game/chapters/chapter2/script/ch2sc29.rpy:739
translate brazil ch2sc29_a879312e:

#   el "I loved having you in my mouth... you tasted delicious! I was a little nervous..."
    el "Adorei ter você na minha boca... você estava delicioso! Eu estava um pouco nervoso..."

# game/chapters/chapter2/script/ch2sc29.rpy:740
translate brazil ch2sc29_6ddf8625:

#   el "But that went away as soon as I tasted you, then my instincts to suck and lick took over..."
    el "Mas isso passou assim que te provei, então meus instintos de chupar e lamber tomaram conta..."

# game/chapters/chapter2/script/ch2sc29.rpy:741
translate brazil ch2sc29_dbec6764:

#   el "We just might have to make it a regular thing..."
    el "Talvez tenhamos que tornar isso um hábito..."

# game/chapters/chapter2/script/ch2sc29.rpy:743
translate brazil ch2sc29_c551a6cc:

#   mc "No objection from me."
    mc "Não tenho objeções."

# game/chapters/chapter2/script/ch2sc29.rpy:744
translate brazil ch2sc29_2a02cddf:

#   mc "I'm also looking forward to tasting you."
    mc "Também estou ansioso para te provar."

# game/chapters/chapter2/script/ch2sc29.rpy:746
translate brazil ch2sc29_7913b11e:

#   el "Keeping talking like that, and you'll be having me for dessert soon."
    el "Se continuar falando assim, logo você vai me comer de sobremesa."

# game/chapters/chapter2/script/ch2sc29.rpy:747
translate brazil ch2sc29_d2e7f0f1:

#   el "I really want to kiss you... is that okay-"
    el "Eu realmente quero te beijar... tudo bem?"

# game/chapters/chapter2/script/ch2sc29.rpy:751
translate brazil ch2sc29_3aac8874:

#   el "Mmffhh! Mmfhh... nnhh..."
    el "Mmffhh! Mmfhh... nnhh..."

# game/chapters/chapter2/script/ch2sc29.rpy:752
translate brazil ch2sc29_1b9ce3aa:

#   "You swiftly grab her and pull her close to you, embracing her in an intimate kiss."
    "Você a agarra rapidamente e a puxa para perto, envolvendo-a em um beijo íntimo."

# game/chapters/chapter2/script/ch2sc29.rpy:755
translate brazil ch2sc29_b0f48ecd:

#   el "*Kisses softly* Mmhh... you... don't mind?"
    el "*Beija suavemente* Hum... você... não se importa?"

# game/chapters/chapter2/script/ch2sc29.rpy:758
translate brazil ch2sc29_b5a70201:

#   mc "Mmmh... don't be ridiculous... I'm not a little boy."
    mc "Hum... não seja ridículo... eu não sou um garotinho."

# game/chapters/chapter2/script/ch2sc29.rpy:761
translate brazil ch2sc29_57ae5415:

#   el "*Moans softly* Mmh... no... you're a man, a real man... *Mwaah*"
    el "*Geme baixinho* Mmh... não... você é um homem, um homem de verdade... *Mwaah*"

# game/chapters/chapter2/script/ch2sc29.rpy:762
translate brazil ch2sc29_b2c427bb:

#   el "My... man."
    el "Meu... homem."

# game/chapters/chapter2/script/ch2sc29.rpy:765
translate brazil ch2sc29_81678e5e:

#   mc "Mmhh... my little kitten."
    mc "Hum... meu gatinho."

# game/chapters/chapter2/script/ch2sc29.rpy:767
translate brazil ch2sc29_fd9fe1de:

#   mc "Ready for bed?"
    mc "Pronto para dormir?"

# game/chapters/chapter2/script/ch2sc29.rpy:768
translate brazil ch2sc29_45f72f3e:

#   "Eliza nods whilst caressing the back of your hair."
    "Eliza acena com a cabeça enquanto acaricia a parte de trás do seu cabelo."

# game/chapters/chapter2/script/ch2sc29.rpy:773
translate brazil ch2sc29_d0a33edc:

#   el "These scars... do they hurt?"
    el "Essas cicatrizes... doem?"

# game/chapters/chapter2/script/ch2sc29.rpy:775
translate brazil ch2sc29_b4094839:

#   mc "Not anymore."
    mc "Não mais."

# game/chapters/chapter2/script/ch2sc29.rpy:777
translate brazil ch2sc29_2046e4f5:

#   el "What happened? Who did this to you?"
    el "O que aconteceu? Quem fez isso com você?"

# game/chapters/chapter2/script/ch2sc29.rpy:778
translate brazil ch2sc29_a702791e:

#   el "They'd better be dead already. Otherwise, I'll make sure they are soon enough."
    el "É melhor que já estejam mortos. Caso contrário, vou garantir que isso aconteça em breve."

# game/chapters/chapter2/script/ch2sc29.rpy:780
translate brazil ch2sc29_77757e2a:

#   mc "I... We were attacked by goblins."
    mc "Eu... Nós fomos atacados por goblins."

# game/chapters/chapter2/script/ch2sc29.rpy:781
translate brazil ch2sc29_08cd45d6:

#   mc "About two years ago, your father and I was discovered in the Sen'ju region, by the Shado-jin we spoke of earlier."
    mc "Há cerca de dois anos, seu pai e eu fomos descobertos na região de Sen'ju pelos Shado-jin de que falamos anteriormente."

# game/chapters/chapter2/script/ch2sc29.rpy:782
translate brazil ch2sc29_63926f04:

#   mc "We had been staying at the village {b}'Nakajima'{/b} for five years, we'd been lucky."
    mc "Estávamos hospedados na vila. {b}'Nakajima'{/b} Durante cinco anos, tivemos sorte."

# game/chapters/chapter2/script/ch2sc29.rpy:784
translate brazil ch2sc29_5c721e99:

#   mc "But since we had been found, we had to leave, back to life on the move... Eventually we found a village."
    mc "Mas, como fomos encontrados, tivemos que partir e voltar à vida nômade... Finalmente, encontramos uma aldeia."

# game/chapters/chapter2/script/ch2sc29.rpy:785
translate brazil ch2sc29_66555bec:

#   mc "The village we stayed at, {b}Lakeshire{/b}, was in a rural area."
    mc "A aldeia onde ficamos, {b} Lakeshire{/b}, estava em uma área rural."

# game/chapters/chapter2/script/ch2sc29.rpy:786
translate brazil ch2sc29_c667ed2c:

#   mc "The village was fairly recently established at the time we arrived, perfect spot to lay low."
    mc "A vila tinha sido fundada recentemente quando chegamos, o local perfeito para nos escondermos."

# game/chapters/chapter2/script/ch2sc29.rpy:788
translate brazil ch2sc29_4de00962:

#   mc "But they did have issues with a nearby goblin settlement."
    mc "Mas eles tiveram problemas com um assentamento goblin próximo."

# game/chapters/chapter2/script/ch2sc29.rpy:789
translate brazil ch2sc29_fb21a01e:

#   mc "Apparently, the goblins in the area weren't happy with people settling there."
    mc "Aparentemente, os goblins da região não estavam contentes com a presença de pessoas se instalando ali."

# game/chapters/chapter2/script/ch2sc29.rpy:791
translate brazil ch2sc29_3fbcfa6a:

#   mc "One night I woke up to some women screaming."
    mc "Certa noite, acordei com gritos de algumas mulheres."

# game/chapters/chapter2/script/ch2sc29.rpy:792
translate brazil ch2sc29_412f6faa:

#   mc "I could barely see anything because there was thick dark smoke everywhere."
    mc "Eu mal conseguia enxergar alguma coisa porque havia uma fumaça densa e escura por toda parte."

# game/chapters/chapter2/script/ch2sc29.rpy:793
translate brazil ch2sc29_7f57158a:

#   mc "Huts and buildings were ablaze, and there were goblins charging from all sides."
    mc "Cabanas e edifícios estavam em chamas, e havia goblins atacando de todos os lados."

# game/chapters/chapter2/script/ch2sc29.rpy:795
translate brazil ch2sc29_6ae93b61:

#   mc "The screams of the innocent people being slaughtered by those beasts were deafening."
    mc "Os gritos das pessoas inocentes sendo massacradas por aquelas bestas eram ensurdecedores."

# game/chapters/chapter2/script/ch2sc29.rpy:796
translate brazil ch2sc29_475408e5:

#   mc "Some women were dragged off into the forest, I can only imagine what happened to them..."
    mc "Algumas mulheres foram arrastadas para a floresta, só posso imaginar o que aconteceu com elas..."

# game/chapters/chapter2/script/ch2sc29.rpy:798
translate brazil ch2sc29_53618ba3:

#   mc "In the confusion, I'd left my sword back in the hut."
    mc "Na confusão, deixei minha espada na cabana."

# game/chapters/chapter2/script/ch2sc29.rpy:799
translate brazil ch2sc29_2947f878:

#   mc "And it wasn’t long till I was surrounded by the green-skinned, stinking creatures."
    mc "E não demorou muito para que eu estivesse cercado por aquelas criaturas fedorentas de pele verde."

# game/chapters/chapter2/script/ch2sc29.rpy:800
translate brazil ch2sc29_d354f61b:

#   mc "I was able to fight off the first few. But soon I was overwhelmed by their sheer numbers."
    mc "Consegui repelir os primeiros. Mas logo fui subjugado pela sua superioridade numérica."

# game/chapters/chapter2/script/ch2sc29.rpy:802
translate brazil ch2sc29_f177fcaa:

#   mc "Their claws tore deep, leaving me with these scars all over."
    mc "Suas garras rasgaram fundo, deixando-me com essas cicatrizes por todo o corpo."

# game/chapters/chapter2/script/ch2sc29.rpy:804
translate brazil ch2sc29_57a076f0:

#   elt "He's had to endure such horrors from such a young age."
    elt "Ele teve que suportar tais horrores desde muito jovem."

# game/chapters/chapter2/script/ch2sc29.rpy:805
translate brazil ch2sc29_b7270e2c:

#   elt "His parents... whole villages being destroyed, and innocents dying right in front of his eyes."
    elt "Seus pais... aldeias inteiras sendo destruídas e inocentes morrendo bem diante de seus olhos."

# game/chapters/chapter2/script/ch2sc29.rpy:806
translate brazil ch2sc29_4b70111a:

#   elt "I can't imagine such horror..."
    elt "Não consigo imaginar tamanho horror..."

# game/chapters/chapter2/script/ch2sc29.rpy:808
translate brazil ch2sc29_1bd63dbb:

#   mc "Just as I was about to succumb to the pain, they all suddenly fell to the ground next to me."
    mc "Quando eu estava prestes a sucumbir à dor, todos eles caíram repentinamente no chão ao meu lado."

# game/chapters/chapter2/script/ch2sc29.rpy:810
translate brazil ch2sc29_cb6adeac:

#   el "Huh? How so?"
    el "Hã? Como assim?"

# game/chapters/chapter2/script/ch2sc29.rpy:812
translate brazil ch2sc29_302a55b6:

#   mc "Your father."
    mc "Seu pai."

# game/chapters/chapter2/script/ch2sc29.rpy:813
translate brazil ch2sc29_6feec4e1:

#   mc "Somehow, he slew them all in a whirlwind of slashes from his blade."
    mc "De alguma forma, ele os matou a todos em um turbilhão de golpes de sua espada."

# game/chapters/chapter2/script/ch2sc29.rpy:814
translate brazil ch2sc29_7c806de5:

#   mc "I'd never seen him move like that before... as you know he was rather bulky and strong but..."
    mc "Eu nunca o tinha visto se mover daquele jeito antes... como você sabe, ele era bem corpulento e forte, mas..."

# game/chapters/chapter2/script/ch2sc29.rpy:815
translate brazil ch2sc29_4dc9cd3a:

#   mc "Moving that swiftly for a man of his size, impressive to say the least."
    mc "Mover-se com tanta rapidez para um homem do seu tamanho é, no mínimo, impressionante."

# game/chapters/chapter2/script/ch2sc29.rpy:817
translate brazil ch2sc29_f2041e2f:

#   mc "Next thing I knew, I woke up in a new place."
    mc "De repente, me vi acordando em um lugar novo."

# game/chapters/chapter2/script/ch2sc29.rpy:818
translate brazil ch2sc29_7718887a:

#   mc "I'd been passed out for several days, with a heavy fever from my wounds."
    mc "Eu havia ficado inconsciente por vários dias, com uma febre alta devido aos meus ferimentos."

# game/chapters/chapter2/script/ch2sc29.rpy:819
translate brazil ch2sc29_ec365cb7:

#   mc "Oren told me that anyone else would've been dead, but due to my natural regeneration, I survived."
    mc "Oren me disse que qualquer outra pessoa teria morrido, mas graças à minha regeneração natural, eu sobrevivi."

# game/chapters/chapter2/script/ch2sc29.rpy:823
translate brazil ch2sc29_62e57f28:

#   el "W-What happened to the village? All the civilians and kids?"
    el "O que aconteceu com a aldeia? E com todos os civis e crianças?"

# game/chapters/chapter2/script/ch2sc29.rpy:825
translate brazil ch2sc29_d2239415:

#   mc "They were overrun. According to your father, there was little he could do."
    mc "Eles foram invadidos. Segundo seu pai, havia pouco que ele pudesse fazer."

# game/chapters/chapter2/script/ch2sc29.rpy:826
translate brazil ch2sc29_1a6f11af:

#   mc "His primary concern was to get me to safety."
    mc "Sua principal preocupação era me colocar em segurança."

# game/chapters/chapter2/script/ch2sc29.rpy:827
translate brazil ch2sc29_d9b463aa:

#   mc "If I hadn’t been so weak, we could have stayed and helped them."
    mc "Se eu não estivesse tão fraco, poderíamos ter ficado e ajudado eles."

# game/chapters/chapter2/script/ch2sc29.rpy:828
translate brazil ch2sc29_e263447f:

#   mc "If I had just trained harder... listened to his instructions more attentively... I could've-"
    mc "Se eu tivesse treinado mais... se tivesse prestado mais atenção às suas instruções... eu poderia ter..."

# game/chapters/chapter2/script/ch2sc29.rpy:830
translate brazil ch2sc29_a1bafbda:

#   el "Don’t do that."
    el "Não faça isso."

# game/chapters/chapter2/script/ch2sc29.rpy:831
translate brazil ch2sc29_0dc27bce:

#   el "You're not to blame for the brutal actions of goblins."
    el "Você não tem culpa pelas ações brutais dos goblins."

# game/chapters/chapter2/script/ch2sc29.rpy:832
translate brazil ch2sc29_6c6a4bba:

#   el "The only ones at fault here are the goblins!"
    el "Os únicos culpados aqui são os goblins!"

# game/chapters/chapter2/script/ch2sc29.rpy:833
translate brazil ch2sc29_876dc5cc:

#   el "I'm sure you and my father taking down a chunk of those filth means some of the villagers managed to escape."
    el "Tenho certeza de que o fato de você e meu pai terem eliminado uma boa parte daquela escória significa que alguns dos aldeões conseguiram escapar."

# game/chapters/chapter2/script/ch2sc29.rpy:835
translate brazil ch2sc29_289ca1e9:

#   mc "That’s what I try to tell myself."
    mc "É isso que tento dizer a mim mesmo."

# game/chapters/chapter2/script/ch2sc29.rpy:836
translate brazil ch2sc29_2d2ab80a:

#   mc "That hopefully us being there might've saved a few of them... but I never got to confirm it."
    mc "Espero que nossa presença tenha salvado alguns deles... mas nunca consegui confirmar."

# game/chapters/chapter2/script/ch2sc29.rpy:838
translate brazil ch2sc29_5b0e51cc:

#   el "Is this why you’re always so hard on yourself?"
    el "É por isso que você é sempre tão duro consigo mesmo?"

# game/chapters/chapter2/script/ch2sc29.rpy:839
translate brazil ch2sc29_8cb78fed:

#   el "Why you don't think you deserve to be happy?"
    el "Por que você acha que não merece ser feliz?"

# game/chapters/chapter2/script/ch2sc29.rpy:841
translate brazil ch2sc29_b0266f68:

#   mc "One of my reasons."
    mc "Uma das minhas razões."

# game/chapters/chapter2/script/ch2sc29.rpy:842
translate brazil ch2sc29_ee8d9539:

#   mc "When you’re different... when you can do things that others can’t..."
    mc "Quando você é diferente... quando você consegue fazer coisas que os outros não conseguem..."

# game/chapters/chapter2/script/ch2sc29.rpy:844
translate brazil ch2sc29_b3165680:

#   mc "You have a responsibility to help those in need."
    mc "Você tem a responsabilidade de ajudar aqueles que precisam."

# game/chapters/chapter2/script/ch2sc29.rpy:845
translate brazil ch2sc29_9c8f6411:

#   mc "Something your father taught me, countless times."
    mc "Algo que seu pai me ensinou inúmeras vezes."

# game/chapters/chapter2/script/ch2sc29.rpy:847
translate brazil ch2sc29_3960761a:

#   el "I agree with that line of thinking, in general."
    el "De um modo geral, concordo com essa linha de raciocínio."

# game/chapters/chapter2/script/ch2sc29.rpy:848
translate brazil ch2sc29_910fd7f9:

#   el "But you also need to realize the world isn’t black and white."
    el "Mas você também precisa perceber que o mundo não é preto e branco."

# game/chapters/chapter2/script/ch2sc29.rpy:850
translate brazil ch2sc29_d2e928e6:

#   el "Each situation is unique and you have to act accordingly."
    el "Cada situação é única e você precisa agir de acordo."

# game/chapters/chapter2/script/ch2sc29.rpy:851
translate brazil ch2sc29_7dca8105:

#   el "The best you can do is to use whatever information you have available at the time."
    el "O melhor que você pode fazer é usar qualquer informação que tiver disponível no momento."

# game/chapters/chapter2/script/ch2sc29.rpy:852
translate brazil ch2sc29_86f465b0:

#   el "And make decisions that benefit those who need it."
    el "E tomem decisões que beneficiem aqueles que precisam."

# game/chapters/chapter2/script/ch2sc29.rpy:854
translate brazil ch2sc29_01cf4ded:

#   mc "*Chuckles* You sound a lot like him, you know?"
    mc "*Risos* Você soa muito parecido com ele, sabia?"

# game/chapters/chapter2/script/ch2sc29.rpy:856
translate brazil ch2sc29_a01b26ba:

#   el "He was my father for the first half of my life."
    el "Ele foi meu pai durante a primeira metade da minha vida."

# game/chapters/chapter2/script/ch2sc29.rpy:858
translate brazil ch2sc29_98ff415c:

#   mc "He never stopped."
    mc "Ele nunca parou."

# game/chapters/chapter2/script/ch2sc29.rpy:860
translate brazil ch2sc29_c6545431:

#   el "What-"
    el "O que-"

# game/chapters/chapter2/script/ch2sc29.rpy:862
translate brazil ch2sc29_6eec447b:

#   mc "He always kept track of how you were doing."
    mc "Ele sempre se preocupava em saber como você estava."

# game/chapters/chapter2/script/ch2sc29.rpy:863
translate brazil ch2sc29_ab062634:

#   mc "How do you think I knew where to look for you, even after he'd passed away?"
    mc "Como você acha que eu sabia onde te procurar, mesmo depois que ele havia falecido?"

# game/chapters/chapter2/script/ch2sc29.rpy:865
translate brazil ch2sc29_1273b9c3:

#   elt "I never considered how [mc] actually found me."
    elt "Eu nunca tinha pensado em como [mc] Na verdade, me encontrou."

# game/chapters/chapter2/script/ch2sc29.rpy:866
translate brazil ch2sc29_55170828:

#   elt "It's not like it's easy to find someone in the woods... and they wouldn't have been close to Whitehills or Riverside."
    elt "Não é como se fosse fácil encontrar alguém na floresta... e eles não estariam perto de Whitehills ou Riverside."

# game/chapters/chapter2/script/ch2sc29.rpy:868
translate brazil ch2sc29_78c166a6:

#   mc "He just couldn’t contact you, for your own safety."
    mc "Ele simplesmente não conseguiu entrar em contato com você, para sua própria segurança."

# game/chapters/chapter2/script/ch2sc29.rpy:869
translate brazil ch2sc29_9c42bbf1:

#   mc "With Shado-jins on our tail, seeking you out could have painted a target on you, to lure us out."
    mc "Com os Shado-jins em nosso encalço, procurá-lo poderia ter feito de você um alvo, para nos atrair."

# game/chapters/chapter2/script/ch2sc29.rpy:872
translate brazil ch2sc29_ebefc234:

#   elt "He's right... I've spent so much time being angry with father for abandoning us."
    elt "Ele tem razão... Passei muito tempo com raiva do meu pai por ele ter nos abandonado."

# game/chapters/chapter2/script/ch2sc29.rpy:873
translate brazil ch2sc29_1e62f54c:

#   elt "But now that I know the story and reason... at least some of it, it makes sense."
    elt "Mas agora que conheço a história e o motivo... pelo menos parte dele, faz sentido."

# game/chapters/chapter2/script/ch2sc29.rpy:875
translate brazil ch2sc29_a22e53c3:

#   el "[mc], thank you for telling me..."
    el "[mc] Obrigado por me contar..."

# game/chapters/chapter2/script/ch2sc29.rpy:876
translate brazil ch2sc29_be089dea:

#   el "Somehow, it feels less of a burden going through this with you."
    el "De alguma forma, passar por isso com você parece menos pesado."

# game/chapters/chapter2/script/ch2sc29.rpy:878
translate brazil ch2sc29_5dd61f1d:

#   mc "I'm glad you feel better after hearing some of it."
    mc "Fico feliz que você se sinta melhor depois de ouvir um pouco disso."

# game/chapters/chapter2/script/ch2sc29.rpy:879
translate brazil ch2sc29_68228af5:

#   mc "But yeah, that is how I got most of my scars..."
    mc "Mas sim, foi assim que eu ganhei a maioria das minhas cicatrizes..."

# game/chapters/chapter2/script/ch2sc29.rpy:880
translate brazil ch2sc29_b6e625a1:

#   mc "How about we try and get some sleep, before the sun graces us with it's presence."
    mc "Que tal tentarmos dormir um pouco antes que o sol nos agracie com sua presença?"

# game/chapters/chapter2/script/ch2sc29.rpy:885
translate brazil ch2sc29_1229f79d:

#   mc "I’m sure you do. Ready for bed?"
    mc "Tenho certeza que sim. Pronto para dormir?"

# game/chapters/chapter2/script/ch2sc29.rpy:888
translate brazil ch2sc29_4303e6f8:

#   el "Yes! I have a feeling I’ll sleep like a baby!"
    el "Sim! Tenho a sensação de que vou dormir como um bebê!"

# game/chapters/chapter2/script/ch2sc29.rpy:890
translate brazil ch2sc29_6b8bd521:

#   mc "I wonder why."
    mc "Gostaria de saber porquê."

# game/chapters/chapter2/script/ch2sc29.rpy:892
translate brazil ch2sc29_0410f8a7:

#   el "Keep wondering!"
    el "Continue a se perguntar!"

# game/chapters/chapter2/script/ch2sc29.rpy:893
translate brazil ch2sc29_8418ae94:

#   el "Now, come cuddle and protect me!"
    el "Agora, venha me abraçar e me proteger!"

# game/chapters/chapter2/script/ch2sc29.rpy:895
translate brazil ch2sc29_07a01389:

#   mc "It would be rude to refuse such a beautiful lady."
    mc "Seria uma falta de educação recusar uma dama tão bonita."

# game/chapters/chapter2/script/ch2sc29.rpy:898
translate brazil ch2sc29_1573cc8b:

#   "You pull Eliza close and spoon her under the comfort of the blanket."
    "Você puxa Eliza para perto e a aconchega sob o cobertor."

# game/chapters/chapter2/script/ch2sc29.rpy:899
translate brazil ch2sc29_78547bd1:

#   el "*Giggling happily* Nnnh..."
    el "*Risos felizes* Nnnh..."

# game/chapters/chapter2/script/ch2sc29.rpy:901
translate brazil ch2sc29_8e8eb20c:

#   el "I see my lessons of etiquette have been paying off."
    el "Vejo que minhas lições de etiqueta estão dando resultado."

# game/chapters/chapter2/script/ch2sc29.rpy:902
translate brazil ch2sc29_26b4848d:

#   mc "*Chuckles* You're just lucky..."
    mc "*Risos* Você só tem sorte..."

# game/chapters/chapter2/script/ch2sc29.rpy:904
translate brazil ch2sc29_3b24b1eb:

#   mc "You caught me in a good mood."
    mc "Você me pegou de bom humor."

# game/chapters/chapter2/script/ch2sc29.rpy:905
translate brazil ch2sc29_73ac4d8d:

#   el "Uh-huh? *Giggles*"
    el "Hum-hum? *Risos*"

# game/chapters/chapter2/script/ch2sc29.rpy:907
translate brazil ch2sc29_761d8945:

#   el "More like I put you in a good mood!"
    el "É mais como se eu te deixasse de bom humor!"

# game/chapters/chapter2/script/ch2sc29.rpy:908
translate brazil ch2sc29_6d18d5d2:

#   mc "*Chuckles* Mhm-hm..."
    mc "*Risos* Hum-hum..."

# game/chapters/chapter2/script/ch2sc29.rpy:910
translate brazil ch2sc29_5bad4fc7:

#   mc "If you keep wiggling your ass like that, we won’t get any sleep."
    mc "Se você continuar rebolando desse jeito, a gente não vai conseguir dormir."

# game/chapters/chapter2/script/ch2sc29.rpy:912
translate brazil ch2sc29_30b71b01:

#   el "What do you mean? I’m innocent of that accusation!"
    el "Como assim? Sou inocente dessa acusação!"

# game/chapters/chapter2/script/ch2sc29.rpy:913
translate brazil ch2sc29_7e707a04:

#   "*Continues to wiggle her ass slowly against you.*"
    "*Continua a rebolar lentamente contra você.*"

# game/chapters/chapter2/script/ch2sc29.rpy:914
translate brazil ch2sc29_3ec96dbd:

#   el "T-Toally- mmmh... Ino-... mmh... Innocent."
    el "T-Toally- mmmh... Ino-... mmh... Inocente."

# game/chapters/chapter2/script/ch2sc29.rpy:916
translate brazil ch2sc29_c39935bd:

#   mc "I’m not sure how you always manage to do that."
    mc "Não sei como você sempre consegue fazer isso."

# game/chapters/chapter2/script/ch2sc29.rpy:918
translate brazil ch2sc29_47e1b893:

#   el "Manage to do what?"
    el "Conseguir fazer o quê?"

# game/chapters/chapter2/script/ch2sc29.rpy:920
translate brazil ch2sc29_701ee5c5:

#   mc "More often than not, you manage to take my mind off all the bad things that have happened."
    mc "Na maioria das vezes, você consegue me distrair de todas as coisas ruins que aconteceram."

# game/chapters/chapter2/script/ch2sc29.rpy:922
translate brazil ch2sc29_0b500330:

#   elt "You do the same for me, [mc]... More than you know."
    elt "Você faz o mesmo por mim, [mc]... Mais do que você imagina."

# game/chapters/chapter2/script/ch2sc29.rpy:923
translate brazil ch2sc29_26ccea94:

#   elt "Just being wrapped up in your arms like this... I couldn’t be happier."
    elt "Estar assim, nos seus braços... eu não poderia estar mais feliz."

# game/chapters/chapter2/script/ch2sc29.rpy:925
translate brazil ch2sc29_b9f6f7a0:

#   el "It’s because you care for me as much as I do you, [mc]."
    el "É porque você se importa comigo tanto quanto eu me importo com você. [mc]."

# game/chapters/chapter2/script/ch2sc29.rpy:926
translate brazil ch2sc29_523df258:

#   el "It’s not something you can explain."
    el "Não é algo que se possa explicar."

# game/chapters/chapter2/script/ch2sc29.rpy:927
translate brazil ch2sc29_a532d222:

#   el "It’s a feeling... a bond we share with each other."
    el "É um sentimento... um laço que compartilhamos."

# game/chapters/chapter2/script/ch2sc29.rpy:929
translate brazil ch2sc29_2b810086:

#   mc "I don’t like it when you’re right."
    mc "Não gosto quando você está certo."

# game/chapters/chapter2/script/ch2sc29.rpy:930
translate brazil ch2sc29_e6ae5873:

#   mc "But I can't help but agree..."
    mc "Mas não posso deixar de concordar..."

# game/chapters/chapter2/script/ch2sc29.rpy:932
translate brazil ch2sc29_72ad20e1:

#   el "You should be used to it by now."
    el "Você já deveria estar acostumado com isso."

# game/chapters/chapter2/script/ch2sc29.rpy:933
translate brazil ch2sc29_f64ee345:

#   el "I'm glad you came into my life..."
    el "Que bom que você entrou na minha vida..."

# game/chapters/chapter2/script/ch2sc29.rpy:935
translate brazil ch2sc29_23a1d071:

#   mc "Mmh... me too, goodnight, Kitten."
    mc "Hum... eu também, boa noite, gatinha."

# game/chapters/chapter2/script/ch2sc29.rpy:937
translate brazil ch2sc29_d27d5ec5:

#   el "Night, night, handsome."
    el "Boa noite, lindo."

# game/chapters/chapter2/script/ch2sc29.rpy:939
translate brazil ch2sc29_989e6dc6:

#   "You squeeze her gently in your arms as you both fall asleep."
    "Você a aperta suavemente em seus braços enquanto ambos adormecem."

# game/chapters/chapter2/script/ch2sc29.rpy:947
translate brazil ch2sc29_f5d80d17:

#   "Both of you are exhausted from all that's happened recently and immediately pass out."
    "Ambos estão exaustos com tudo o que aconteceu recentemente e desmaiam imediatamente."

# game/chapters/chapter2/script/ch2sc29.rpy:297
translate brazil ch2sc29_3f871f46_1:

#   mc "Hmm?"
    mc "Hum?"

