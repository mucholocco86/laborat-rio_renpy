# game/chapters/chapter2/script/ch2sc16.rpy:19
translate brazil ch2sc16_3c223cf8:

#   mct "It’s been a while since I've dreamt about those days, about... her father."
    mct "Já faz um tempo que não sonho com aqueles dias, com... o pai dela."

# game/chapters/chapter2/script/ch2sc16.rpy:21
translate brazil ch2sc16_924edbc1:

#   mct "His final words to me were... 'Find her, [mc]. Find her, and watch over her'."
    mct "Suas últimas palavras para mim foram... 'Encontre-a, [mc] Encontre-a e proteja-a."

# game/chapters/chapter2/script/ch2sc16.rpy:23
translate brazil ch2sc16_0f3dc410:

#   mct "Was that just a final plea from a regretful father, or is there more to it?"
    mct "Será que foi apenas um apelo final de um pai arrependido, ou há algo mais por trás disso?"

# game/chapters/chapter2/script/ch2sc16.rpy:25
translate brazil ch2sc16_0870c3a4:

#   mct "Blazes... that old man! Always so cryptic and secretive."
    mct "Puxa... aquele velho! Sempre tão enigmático e misterioso."

# game/chapters/chapter2/script/ch2sc16.rpy:27
translate brazil ch2sc16_e2c9f940:

#   mct "I’ll protect her."
    mct "Eu a protegerei."

# game/chapters/chapter2/script/ch2sc16.rpy:28
translate brazil ch2sc16_e95dacec:

#   mct "Not because you wanted me to, but because... I care about her."
    mct "Não porque você queria que eu fizesse isso, mas porque... eu me importo com ela."

# game/chapters/chapter2/script/ch2sc16.rpy:30
translate brazil ch2sc16_77190618:

#   mct "Heh... she looks peaceful."
    mct "Heh... ela parece tranquila."

# game/chapters/chapter2/script/ch2sc16.rpy:34
translate brazil ch2sc16_ac94ea68:

#   mct "How could someone as delicate and beautiful as Eliza be related to that old skeever?"
    mct "Como alguém tão delicada e bela como Eliza poderia ser parente daquele velho nojento?"

# game/chapters/chapter2/script/ch2sc16.rpy:35
translate brazil ch2sc16_3d513811:

#   mct "Her mother must've carried the gene pool, no doubt."
    mct "Sem dúvida, sua mãe herdou os genes."

# game/chapters/chapter2/script/ch2sc16.rpy:46
translate brazil ch2sc16_3eee2858:

#   el "Nnhh..."
    el "Nnhh..."

# game/chapters/chapter2/script/ch2sc16.rpy:49
translate brazil ch2sc16_df16f671:

#   el "*Giggles softly* ..."
    el "*Ri baixinho* ..."

# game/chapters/chapter2/script/ch2sc16.rpy:53
translate brazil ch2sc16_d5d8118a:

#   el "Hhrrmmm. What was that for?"
    el "Hmmm. Para que foi isso?"

# game/chapters/chapter2/script/ch2sc16.rpy:57
translate brazil ch2sc16_abc2ee09:

#   mc "Just felt like it."
    mc "Simplesmente me deu vontade."

# game/chapters/chapter2/script/ch2sc16.rpy:59
translate brazil ch2sc16_20252f59:

#   el "Is it morning already?"
    el "Já é manhã?"

# game/chapters/chapter2/script/ch2sc16.rpy:61
translate brazil ch2sc16_9a038dd2:

#   mc "Sadly, yes. I slept better than I have in a long time..."
    mc "Infelizmente, sim. Dormi melhor do que há muito tempo..."

# game/chapters/chapter2/script/ch2sc16.rpy:63
translate brazil ch2sc16_200f0beb:

#   el "Mmmh... me too, I haven't felt this comfortable for as long as I can remember."
    el "Hum... eu também, não me sentia tão confortável há muito tempo."

# game/chapters/chapter2/script/ch2sc16.rpy:65
translate brazil ch2sc16_71a45bb1:

#   mc "I could’ve easily slept until noon after yesterday's events."
    mc "Depois dos acontecimentos de ontem, eu poderia facilmente ter dormido até meio-dia."

# game/chapters/chapter2/script/ch2sc16.rpy:67
translate brazil ch2sc16_6a6d713a:

#   el "*Yawns* Yes! Let’s just have a little nap?"
    el "*Boceja* Sim! Vamos tirar um cochilo?"

# game/chapters/chapter2/script/ch2sc16.rpy:69
translate brazil ch2sc16_0a28ee29:

#   mc "Eliza..."
    mc "Eliza..."

# game/chapters/chapter2/script/ch2sc16.rpy:70
translate brazil ch2sc16_572e4b14:

#   mc "I'm afraid you'll have to postpone any naps."
    mc "Receio que você terá que adiar os cochilos."

# game/chapters/chapter2/script/ch2sc16.rpy:72
translate brazil ch2sc16_4f0c0b2f:

#   el "*Sigh* I know, I know."
    el "*Suspiro* Eu sei, eu sei."

# game/chapters/chapter2/script/ch2sc16.rpy:73
translate brazil ch2sc16_c0108438:

#   el "We have errands to run before we leave."
    el "Temos algumas coisas para resolver antes de partirmos."

# game/chapters/chapter2/script/ch2sc16.rpy:75
translate brazil ch2sc16_520d10d6:

#   mc "I have to visit an old family friend."
    mc "Preciso visitar um antigo amigo da família."

# game/chapters/chapter2/script/ch2sc16.rpy:77
translate brazil ch2sc16_05bdfb9b:

#   mc "I suppose you could stay in bed a while longer."
    mc "Imagino que você poderia ficar na cama mais um pouco."

# game/chapters/chapter2/script/ch2sc16.rpy:79
translate brazil ch2sc16_21f36a8f:

#   el "Uhh, can I? It’s just what I need!"
    el "Hum, posso? É exatamente o que eu preciso!"

# game/chapters/chapter2/script/ch2sc16.rpy:81
translate brazil ch2sc16_e75b00f8:

#   el "My butt will love you for it!"
    el "Meu bumbum vai te agradecer por isso!"

# game/chapters/chapter2/script/ch2sc16.rpy:83
translate brazil ch2sc16_25d6a3f1:

#   mc "I’m sure it will... Just don’t nap too long."
    mc "Tenho certeza que sim... Só não tire uma soneca muito longa."

# game/chapters/chapter2/script/ch2sc16.rpy:84
translate brazil ch2sc16_3d82a0e2:

#   mc "You’re in charge of buying supplies from the market before we depart."
    mc "Você ficará responsável por comprar os suprimentos no mercado antes de partirmos."

# game/chapters/chapter2/script/ch2sc16.rpy:86
translate brazil ch2sc16_a278ec54:

#   el "I won’t forget!"
    el "Eu não vou esquecer!"

# game/chapters/chapter2/script/ch2sc16.rpy:88
translate brazil ch2sc16_ad632132:

#   el "I’ll make sure we have plenty of provisions, at least a week’s worth!"
    el "Vou garantir que tenhamos mantimentos suficientes, pelo menos para uma semana!"

# game/chapters/chapter2/script/ch2sc16.rpy:90
translate brazil ch2sc16_4ee7a7cb:

#   mc "Perfect, I’ll find you later."
    mc "Perfeito, te encontro mais tarde."

# game/chapters/chapter2/script/ch2sc16.rpy:92
translate brazil ch2sc16_f901371d:

#   el "Byyee! Oh, say hi to your friend from me!"
    el "Tchau! Ah, mande um oi para seu amigo da minha parte!"

# game/chapters/chapter2/script/ch2sc16.rpy:93
translate brazil ch2sc16_6ecacc71:

#   el "Tell him Eliza is watching your back so he won't have to worry!"
    el "Diga a ele que Eliza está cuidando de você, então ele não precisa se preocupar!"

# game/chapters/chapter2/script/ch2sc16.rpy:95
translate brazil ch2sc16_94cd85d1:

#   mc "He doesn’t know who you are."
    mc "Ele não sabe quem você é."

# game/chapters/chapter2/script/ch2sc16.rpy:97
translate brazil ch2sc16_368469df:

#   el "*Giggles* I’m sure I'll meet him someday!"
    el "*Risos* Tenho certeza que um dia o encontrarei!"

# game/chapters/chapter2/script/ch2sc16.rpy:98
translate brazil ch2sc16_5f080c11:

#   el "So you better put in a good word for me!"
    el "Então é melhor você dar uma boa palavra por mim!"

# game/chapters/chapter2/script/ch2sc16.rpy:100
translate brazil ch2sc16_c2b3307d:

#   mc "*Chuckles* Sure... be ready with the provisions. We’re leaving as soon as I get back!"
    mc "*Risos* Claro... prepare os mantimentos. Partiremos assim que eu voltar!"

# game/chapters/chapter2/script/ch2sc16.rpy:101
translate brazil ch2sc16_a959fd51:

#   mc "We'll want to set out as early as possible to make some proper progress towards Luxenford."
    mc "Queremos partir o mais cedo possível para avançarmos de forma significativa rumo a Luxemburgo."

# game/chapters/chapter2/script/ch2sc16.rpy:103
translate brazil ch2sc16_9bbfbcdf:

#   el "Yes, boss!"
    el "Sim, chefe!"

# game/chapters/chapter2/script/ch2sc16.rpy:121
translate brazil ch2sc16_1a6403dc:

#   el "Hrrhh. What time is it?"
    el "Hrrhh. Que horas são?"

# game/chapters/chapter2/script/ch2sc16.rpy:125
translate brazil ch2sc16_1bea2d55:

#   mc "Time to get up, we have a bunch to do before we leave."
    mc "Hora de levantar, temos muita coisa para fazer antes de irmos embora."

# game/chapters/chapter2/script/ch2sc16.rpy:129
translate brazil ch2sc16_577e9dae:

#   el "But I had such a nice dream!"
    el "Mas eu tive um sonho tão bom!"

# game/chapters/chapter2/script/ch2sc16.rpy:131
translate brazil ch2sc16_5aa6b1ca:

#   mc "All good things come to an end. Let’s go."
    mc "Tudo que é bom chega ao fim. Vamos lá."

# game/chapters/chapter2/script/ch2sc16.rpy:133
translate brazil ch2sc16_061b9e0f:

#   el "Urrh. Alright, alright!"
    el "Urrh. Tudo bem, tudo bem!"

# game/chapters/chapter2/script/ch2sc16.rpy:135
translate brazil ch2sc16_5615ed33:

#   el "*Yaawns*"
    el "*Boceja*"

# game/chapters/chapter2/script/ch2sc16.rpy:137
translate brazil ch2sc16_bd94bb12:

#   mc "You’ll handle getting our provisions at the market, while I meet with an old family friend."
    mc "Você se encarregará de comprar nossos mantimentos no mercado, enquanto eu me encontro com um velho amigo da família."

# game/chapters/chapter2/script/ch2sc16.rpy:139
translate brazil ch2sc16_549b81fd:

#   el "Okay, I’ll make sure we’re well stocked!"
    el "Certo, vou garantir que tenhamos bastante estoque!"

# game/chapters/chapter2/script/ch2sc16.rpy:141
translate brazil ch2sc16_3f93f838:

#   mc "Good, See you later."
    mc "Ótimo, até mais tarde."

