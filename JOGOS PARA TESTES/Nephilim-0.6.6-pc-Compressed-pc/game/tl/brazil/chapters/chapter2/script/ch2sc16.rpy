#   el "Bye bye!"
    el "Bye Bye!"

# game/chapters/chapter2/script/ch2sc16.rpy:147
translate brazil ch2sc16_1e8679d9:

#   mc "Better not find you lazing around when I get back."
    mc "É melhor eu não te encontrar por aí preguiçosamente quando voltar."

# game/chapters/chapter2/script/ch2sc16.rpy:149
translate brazil ch2sc16_e585029a:

#   el "What? Little ol’ me sleeping in? No chance!"
