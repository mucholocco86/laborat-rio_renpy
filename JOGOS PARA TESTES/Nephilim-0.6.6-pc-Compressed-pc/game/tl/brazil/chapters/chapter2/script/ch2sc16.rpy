#   el "Noo! Not my bum!"
    el "Não! Meu traseiro não!"

# game/chapters/chapter2/script/ch2sc16.rpy:157
translate brazil ch2sc16_90ff9638:

#   el "It feels nice and comfy just the way it is!"
    el "É uma sensação agradável e confortável exatamente como está!"

