    mc "..."

# game/chapters/chapter5/script/ch5sc13.rpy:1211
translate brazil ch5sc13_c0d167c6_1:

#   mc "We’re shooting the bottles."
    mc "Estamos filmando as garrafas."

# game/chapters/chapter5/script/ch5sc13.rpy:1218
translate brazil ch5sc13_50f4d46c_1:

#   lu "Exciting! Thrilling! Magnificent! Exhilarating! Can I start?"
    lu "Que emocionante! Que eletrizante! Que magnífico! Que estimulante! Posso começar?"

# game/chapters/chapter5/script/ch5sc13.rpy:1219
translate brazil ch5sc13_1e634429_1:

#   mct "{i}She didn’t take much convincing... Heh, I guess she has a little rebel inside her.{/i}"
    mct "{i}Ela não precisou de muita persuasão... Heh, acho que ela tem um lado rebelde.{/i}"

# game/chapters/chapter5/script/ch5sc13.rpy:1220
translate brazil ch5sc13_bcf9b8d1_1:

#   mc "Sure, go ahead."
    mc "Claro, pode prosseguir."

# game/chapters/chapter5/script/ch5sc13.rpy:1253
translate brazil ch5sc13_41c7b947_1:

#   mc "You got it."
    mc "Você entendeu."

# game/chapters/chapter5/script/ch5sc13.rpy:1325
translate brazil ch5sc13_45186158_1:

#   lu "It sounded like Sylph needs to speak to you, and I've gotta check on mother."
    lu "Parece que Sylph precisa falar com você, e eu preciso ver como está minha mãe."

# game/chapters/chapter5/script/ch5sc13.rpy:1529
translate brazil ch5sc13_f16f7354_1:

#   mc "I love you too, Sylph."
    mc "Eu também te amo, Sylph."

