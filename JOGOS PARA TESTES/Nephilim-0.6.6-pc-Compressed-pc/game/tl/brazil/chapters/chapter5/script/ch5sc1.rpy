# game/chapters/chapter5/script/ch5sc1.rpy:2077
translate brazil ch5sc1_a5186d15:

#   sl "Ugh, you wouldn’t understand... You’re an only child."
    sl "Ah, você não entenderia... Você é filho único."

# game/chapters/chapter5/script/ch5sc1.rpy:2080
translate brazil ch5sc1_b7dff79a:

#   el "Of course I understand! It’s called fucking EMPATHY!"
    el "Claro que entendo! Chama-se EMPATIA, caramba!"

# game/chapters/chapter5/script/ch5sc1.rpy:2082
translate brazil ch5sc1_237d79bd:

#   sl "Okay, okay... Geez, Eliza! Settle down... As for why I’m here-"
    sl "Tá bem, tá bem... Nossa, Eliza! Se acalma... Quanto ao motivo de eu estar aqui..."

# game/chapters/chapter5/script/ch5sc1.rpy:2084
translate brazil ch5sc1_30a1a929:

#   sl "I’ve found a way to bring her back. To bring Samarah back."
    sl "Encontrei um jeito de trazê-la de volta. De trazer Samarah de volta."

# game/chapters/chapter5/script/ch5sc1.rpy:2086
translate brazil ch5sc1_417e3291:

#   sl "I just need [mc]’s help to do it."
    sl "Eu só preciso [mc] com a ajuda de 's para fazer isso."

# game/chapters/chapter5/script/ch5sc1.rpy:2088
translate brazil ch5sc1_412f45e3:

#   el "The fuck you do?!"
    el "Que porra você faz?!"

# game/chapters/chapter5/script/ch5sc1.rpy:2089
translate brazil ch5sc1_6156fed3:

#   el "Do you honestly think you can have it all after what you put us through?!"
    el "Você realmente acha que pode ter tudo depois de tudo o que nos fez passar?!"

# game/chapters/chapter5/script/ch5sc1.rpy:2091
translate brazil ch5sc1_098c45e6:

#   elt "Gods! She makes my blood boil!"
    elt "Meu Deus! Ela me deixa furioso!"

# game/chapters/chapter5/script/ch5sc1.rpy:2093
translate brazil ch5sc1_d372d6ad:

#   sl "You need to check yourself. You’re acting like a total bitch."
    sl "Você precisa se controlar. Está se comportando como uma completa idiota."

# game/chapters/chapter5/script/ch5sc1.rpy:2094
translate brazil ch5sc1_a538da4a:

#   sl "Didn’t you just preach to me about empathy? Then be happy for me!"
    sl "Você não acabou de me dar uma lição sobre empatia? Então fique feliz por mim!"

# game/chapters/chapter5/script/ch5sc1.rpy:2096
translate brazil ch5sc1_a69586c4:

#   sl "You know what? Forget it. You’re being petty..."
    sl "Sabe de uma coisa? Esquece. Você está sendo mesquinho..."

# game/chapters/chapter5/script/ch5sc1.rpy:2100
translate brazil ch5sc1_fd728d23:

#   el "You really think you’ll just get to walk away?"
    el "Você realmente acha que vai sair impune?"

# game/chapters/chapter5/script/ch5sc1.rpy:2101
translate brazil ch5sc1_9745a644:

#   el "After all the trauma and pain you’ve caused?"
    el "Depois de todo o trauma e dor que você causou?"

# game/chapters/chapter5/script/ch5sc1.rpy:2103
translate brazil ch5sc1_7859a502:

#   el "You don't even recognize the months... {b}MONTHS{/b} of torment you caused me and [mc]!"
    el "Você nem reconhece mais os meses... {b} MESES{/b} do tormento que você me causou e [mc]!"

# game/chapters/chapter5/script/ch5sc1.rpy:2104
translate brazil ch5sc1_5550c498:

#   el "All because you were so selfish and wouldn’t trust us!"
    el "Tudo porque você foi tão egoísta e não confiou em nós!"

# game/chapters/chapter5/script/ch5sc1.rpy:2106
translate brazil ch5sc1_36c13daf:

#   sl "Eliza, you’re acting crazy! We can settle this another time-"
    sl "Eliza, você está agindo como uma louca! Podemos resolver isso em outra hora."

# game/chapters/chapter5/script/ch5sc1.rpy:2109
translate brazil ch5sc1_7ac6667a:

#   el "{b}BITCH!{/b} I’m settling this now!"
    el "{b}CADELA!{/b} Estou resolvendo isso agora!"

# game/chapters/chapter5/script/ch5sc1.rpy:2112
translate brazil ch5sc1_d89660be:

#   sl "{b}ARGH!!{/b} Let me go, you psycho!"
    sl "{b}ARGH!!{/b} Me solta, seu psicopata!"

# game/chapters/chapter5/script/ch5sc1.rpy:2114
translate brazil ch5sc1_97719425:

#   el "You’re not going anywhere..."
    el "Você não vai a lugar nenhum..."

# game/chapters/chapter5/script/ch5sc1.rpy:2115
translate brazil ch5sc1_085825b7:

#   el "It's time you felt a fraction of the pain you've caused us."
    el "Já é hora de você sentir uma fração da dor que nos causou."

# game/chapters/chapter5/script/ch5sc1.rpy:2117
translate brazil ch5sc1_40ea96c3:

#   sl "Y-Your eyes?! You’re a freak!"
    sl "S-Seus olhos?! Você é um(a) esquisito(a)!"

# game/chapters/chapter5/script/ch5sc1.rpy:2119
translate brazil ch5sc1_e5a4fd87:

#   el "You have no idea... I’m going to enjoy this!"
    el "Você não faz ideia... Eu vou adorar isso!"

# game/chapters/chapter5/script/ch5sc1.rpy:2121
translate brazil ch5sc1_8bdd6349:

#   el "*Hissing* Hrrhhrhh!"
    el "*Sibilando* Hrrhhrhh!"

# game/chapters/chapter5/script/ch5sc1.rpy:2124
translate brazil ch5sc1_cd1dee92:

#   sl "*Painful Yelp* Aiiiigh!"
    sl "*Grito de dor* Aiiiigh!"

# game/chapters/chapter5/script/ch5sc1.rpy:2126
translate brazil ch5sc1_11ffec0f:

#   elt "Mhm! I was right... She is delicious!"
    elt "Hum! Eu estava certo... Ela é deliciosa!"

# game/chapters/chapter5/script/ch5sc1.rpy:2127
translate brazil ch5sc1_0c918287:

#   elt "I can’t let her get away with what she’s done... I won’t forgive her for betraying [mc]."
    elt "Não posso deixar que ela saia impune pelo que fez... Não a perdoarei por me trair. [mc]."

# game/chapters/chapter5/script/ch5sc1.rpy:2128
translate brazil ch5sc1_2b785f7d:

#   elt "This should scare her enough to make her never return..."
    elt "Isso deveria assustá-la o suficiente para fazê-la nunca mais voltar..."

# game/chapters/chapter5/script/ch5sc1.rpy:2130
translate brazil ch5sc1_a541a8ec:

#   elt "Mmhmm... So warm..."
    elt "Hum... Quentinho..."

# game/chapters/chapter5/script/ch5sc1.rpy:2131
translate brazil ch5sc1_157f0eb2:

#   "Selena’s pulse weakens with every drop of blood drained."
    "O pulso de Selena enfraquece a cada gota de sangue drenada."

# game/chapters/chapter5/script/ch5sc1.rpy:2134
translate brazil ch5sc1_f5a335d1:

#   "Grabbing her head forcefully, Eliza continues sucking eagerly."
    "Agarrando a cabeça dela com força, Eliza continua a sugar avidamente."

# game/chapters/chapter5/script/ch5sc1.rpy:2136
translate brazil ch5sc1_b2bcfad9:

#   el "Ahhh! More! Give me more!!"
    el "Ahhh! Mais! Me dê mais!!"

# game/chapters/chapter5/script/ch5sc1.rpy:2139
translate brazil ch5sc1_06f07237:

#   el "Mmhmm!"
    el "Hummm!"

# game/chapters/chapter5/script/ch5sc1.rpy:2145
translate brazil ch5sc1_a45de37b:

#   elt "That was... exhilarating!"
    elt "Foi... emocionante!"

# game/chapters/chapter5/script/ch5sc1.rpy:2147
translate brazil ch5sc1_2a53eb94:

#   elt "C’mon, get up... I want more."
    elt "Vamos, levanta... Eu quero mais."

# game/chapters/chapter5/script/ch5sc1.rpy:2148
translate brazil ch5sc1_6ddca608:

#   elt "Maybe I was a little eager..."
    elt "Talvez eu estivesse um pouco ansioso..."

# game/chapters/chapter5/script/ch5sc1.rpy:2149
translate brazil ch5sc1_6f8ed268:

#   elt "Dead?"
    elt "Morto?"

# game/chapters/chapter5/script/ch5sc1.rpy:2151
translate brazil ch5sc1_8135b629:

#   elt "Wait... I killed her? I killed Selena?!"
    elt "Espera... Eu a matei? Eu matei a Selena?!"

# game/chapters/chapter5/script/ch5sc1.rpy:2152
translate brazil ch5sc1_1641e104:

#   elt "F-Fuck! No! No-no-no! What do I do?"
    elt "P-Puta merda! Não! Não, não, não! O que eu faço?"

# game/chapters/chapter5/script/ch5sc1.rpy:2153
translate brazil ch5sc1_05c5822f:

#   elt "Even if she deserved to feel pain..."
    elt "Mesmo que ela merecesse sentir dor..."

# game/chapters/chapter5/script/ch5sc1.rpy:2155
translate brazil ch5sc1_0699ae00:

#   elt "I just wanted to scare her! Make her regret her choices... She got me so angry!"
    elt "Eu só queria assustá-la! Fazê-la se arrepender das suas escolhas... Ela me deixou tão irritada!"

# game/chapters/chapter5/script/ch5sc1.rpy:2156
translate brazil ch5sc1_c32efb3f:

#   elt "I wanted to hurt her... But-..."
    elt "Eu queria machucá-la... Mas..."

# game/chapters/chapter5/script/ch5sc1.rpy:2157
translate brazil ch5sc1_d0886987:

#   elt "I-... I killed her! And... I enjoyed it?!"
    elt "Eu... eu a matei! E... gostei disso?!"

# game/chapters/chapter5/script/ch5sc1.rpy:2159
translate brazil ch5sc1_40c88e40:

#   elt "*Trembling* I couldn’t stop! No-no-no-no! Why am I like this?! I’m a killer!"
    elt "*Tremendo* Eu não conseguia parar! Não, não, não, não! Por que sou assim?! Eu sou um assassino!"

# game/chapters/chapter5/script/ch5sc1.rpy:2160
translate brazil ch5sc1_cab25fc8:

#   elt "*Trembling* She called me a freak... And she’s right."
    elt "*Tremendo* Ela me chamou de aberração... E ela tem razão."

# game/chapters/chapter5/script/ch5sc1.rpy:2161
translate brazil ch5sc1_afdaa08f:

#   elt "*Trembling* How can I claim to be a good person? A decent person?"
    elt "*Tremendo* Como posso afirmar ser uma boa pessoa? Uma pessoa decente?"

# game/chapters/chapter5/script/ch5sc1.rpy:2165
translate brazil ch5sc1_0744843a:

#   elt "*Trembling* I’m-... I’m not even human anymore! I’m a disgusting monster!"
    elt "*Tremendo* Eu... eu nem sou mais humano! Sou um monstro repugnante!"

# game/chapters/chapter5/script/ch5sc1.rpy:2175
translate brazil ch5sc1_dc26ac76:

#   el "[mc]? ... Don't look at me!"
    el "[mc]? ... Não olhe para mim!"

# game/chapters/chapter5/script/ch5sc1.rpy:2176
translate brazil ch5sc1_359a9c88:

#   el "I’m a monster! A hideous, disgusting, blood-sucking monster!"
    el "Eu sou um monstro! Um monstro horrendo, repugnante e sedento de sangue!"

# game/chapters/chapter5/script/ch5sc1.rpy:2178
translate brazil ch5sc1_aee2d2ba:

#   mct "She killed Selena? Hmph... Can’t say she didn’t have it coming."
    mct "Ela matou a Selena? Hmph... Não dá para dizer que ela não mereceu."

# game/chapters/chapter5/script/ch5sc1.rpy:2185
translate brazil ch5sc1_ecdac290:

#   "{b}{color=#87e1fa}Light Morality{/color}{/b} increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "{b}{color=#87e1fa}Moralidade Leve{/color}{/b} aumentado por {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc1.rpy:2186
translate brazil ch5sc1_a4103fb3:

#   mc "I know you didn’t intend for her to die. You’re still learning to control your bloodlust."
    mc "Eu sei que você não tinha a intenção de que ela morresse. Você ainda está aprendendo a controlar sua sede de sangue."

# game/chapters/chapter5/script/ch5sc1.rpy:2187
translate brazil ch5sc1_fa3ac03e:

#   mc "Besides, Selena wasn’t exactly innocent."
    mc "Além disso, Selena não era exatamente inocente."

# game/chapters/chapter5/script/ch5sc1.rpy:2189
translate brazil ch5sc1_4bb59e9d:

#   el "I really didn’t! I just wanted her to feel some of the pain she has caused..."
    el "Eu realmente não queria! Eu só queria que ela sentisse um pouco da dor que causou..."

# game/chapters/chapter5/script/ch5sc1.rpy:2190
translate brazil ch5sc1_9bf34445:

#   el "She just got me so angry! In the end, I couldn’t forgive her for hurting you."
    el "Ela me deixou tão irritada! No fim, não consegui perdoá-la por ter te magoado."

# game/chapters/chapter5/script/ch5sc1.rpy:2195
translate brazil ch5sc1_4991cc9c:

#   "{b}{color=#f00}Dark Morality{/color}{/b} increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "{b}{color=#f00}Moralidade Sombria{/color}{/b} aumentado por {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc1.rpy:2197
translate brazil ch5sc1_f3581f1c:

#   mc "You did me a favor by killing her. You saved me the trouble of doing it myself."
    mc "Você me fez um favor ao matá-la. Você me poupou o trabalho de fazer isso eu mesmo."

# game/chapters/chapter5/script/ch5sc1.rpy:2198
translate brazil ch5sc1_c73482dd:

#   mc "Thank you, Eliza. I knew I could count on you."
    mc "Obrigada, Eliza. Eu sabia que podia contar com você."

# game/chapters/chapter5/script/ch5sc1.rpy:2201
translate brazil ch5sc1_ac8aca69:

#   el "Always... I'll do anything for you."
    el "Sempre... farei qualquer coisa por você."

# game/chapters/chapter5/script/ch5sc1.rpy:2204
translate brazil ch5sc1_60a3346a:

#   mc "C'mon let’s get you home and into bed..."
    mc "Vamos lá, vamos te levar para casa e te colocar na cama..."

# game/chapters/chapter5/script/ch5sc1.rpy:2205
translate brazil ch5sc1_b7cd1b5b:

#   mc "We’ll leave her for the guards to find. They’ll just assume it was a mugging."
    mc "Vamos deixá-la para os guardas encontrarem. Eles simplesmente presumirão que foi um assalto."

# game/chapters/chapter5/script/ch5sc1.rpy:2207
translate brazil ch5sc1_0c870b63:

#   el "O-Okay... How did you know where I was?"
    el "Certo... Como você sabia onde eu estava?"

# game/chapters/chapter5/script/ch5sc1.rpy:2209
translate brazil ch5sc1_6559e3e1:

#   mc "I picked up your scent as I was about to turn for the tavern, and I thought I should investigate."
    mc "Senti seu cheiro quando estava prestes a entrar na taverna e pensei que deveria investigar."

# game/chapters/chapter5/script/ch5sc1.rpy:2210
translate brazil ch5sc1_9205a73a:

#   el "I’m glad you did, I-... I don’t know what I would’ve done..."
    el "Que bom que você fez isso, eu... eu não sei o que teria feito..."

# game/chapters/chapter5/script/ch5sc1.rpy:2212
translate brazil ch5sc1_d6aa7a7b:

#   mc "We’ll talk when we get to our room."
    mc "Conversaremos quando chegarmos ao nosso quarto."

# game/chapters/chapter5/script/ch5sc1.rpy:2213
translate brazil ch5sc1_be6d7f33:

#   el "Are you... mad at me?"
    el "Você está... bravo comigo?"

# game/chapters/chapter5/script/ch5sc1.rpy:2215
translate brazil ch5sc1_b3f55724:

#   el "I’m sorry..."
    el "Desculpe..."

# game/chapters/chapter5/script/ch5sc1.rpy:2234
translate brazil ch5sc1_18986e69:

#   irt "Hmm."
    irt "Hum."

# game/chapters/chapter5/script/ch5sc1.rpy:2235
translate brazil ch5sc1_181d8ed8:

#   irt "Interesting..."
    irt "Interessante..."

# game/chapters/chapter5/script/ch5sc1.rpy:2236
translate brazil ch5sc1_ebc4078c:

#   irt "I knew he was heading to the capital... but I didn't imagine I'd actually see him again."
    irt "Eu sabia que ele estava indo para a capital... mas não imaginava que realmente o veria novamente."

# game/chapters/chapter5/script/ch5sc1.rpy:2237
translate brazil ch5sc1_5721bf1b:

#   irt "I wonder... would he recognize me? I had to change my hair after leaving Raden's legion."
    irt "Será que ele me reconheceria? Tive que mudar meu cabelo depois de sair da legião de Raden."

# game/chapters/chapter5/script/ch5sc1.rpy:2238
translate brazil ch5sc1_31e8a605:

#   irt "[mc]... you spared me..."
    irt "[mc]...você me poupou..."

# game/chapters/chapter5/script/ch5sc1.rpy:2239
translate brazil ch5sc1_1953d89a:

#   irt "*Snickers* You're quite handsome..."
    irt "*Risos* Você é muito bonito..."

# game/chapters/chapter5/script/ch5sc1.rpy:2240
translate brazil ch5sc1_32ac2425:

#   irt "*Sighs* Sadly there's no time for games... not even the pleasurable kind."
    irt "*Suspiro* Infelizmente não há tempo para jogos... nem mesmo para os jogos prazerosos."

# game/chapters/chapter5/script/ch5sc1.rpy:2241
translate brazil ch5sc1_8d868db1:

#   irt "This is my initiation test for {b}the society{/b} after all, I need to find my target and... eliminate them."
    irt "Este é o meu teste de iniciação para {b} a sociedade{/b} Afinal, preciso encontrar meu alvo e... eliminá-lo."

# game/chapters/chapter5/script/ch5sc1.rpy:2242
translate brazil ch5sc1_0fa69d60:

#   irt "How hard can it be? A {b}white-haired woman{/b} should stand out, even in a city as crowded as this."
    irt "Quão difícil pode ser? A {b} mulher de cabelos brancos{/b} Deveria se destacar, mesmo em uma cidade tão populosa como esta."

# game/chapters/chapter5/script/ch5sc1.rpy:2243
translate brazil ch5sc1_8a1baabc:

#   irt "I'll have to remain vigilant, according to my intel, she kills indiscriminately, even killed several of our sisters."
    irt "Terei que permanecer vigilante, pois, segundo minhas informações, ela mata indiscriminadamente, tendo inclusive matado várias de nossas irmãs."

# game/chapters/chapter5/script/ch5sc1.rpy:2244
translate brazil ch5sc1_08b1e207:

#   irt "The society wanted her brought back in alive if possible, otherwise I am to at least get a decent amount of her blood."
    irt "A sociedade queria que ela fosse trazida de volta viva, se possível; caso contrário, eu deveria obter pelo menos uma quantidade razoável de seu sangue."

# game/chapters/chapter5/script/ch5sc1.rpy:2245
translate brazil ch5sc1_d4879d35:

#   irt "Why they want something like that... who knows, it's not for me to ask questions if I want to be accepted as a member."
    irt "Por que eles querem algo assim... quem sabe, não cabe a mim fazer perguntas se eu quiser ser aceito como membro."

# game/chapters/chapter5/script/ch5sc1.rpy:2246
translate brazil ch5sc1_f91b55f1:

#   irt "*Sighs* I better get to it... hopefully I get to run into you again someday... [mc]."
    irt "*Suspiro* É melhor eu ir logo... espero te encontrar de novo algum dia... [mc]."

# game/chapters/chapter5/script/ch5sc1.rpy:2260
translate brazil ch5sc1_9791550f:

#   el "Say something... Please? You’ve been quiet the whole way back."
    el "Diga alguma coisa... Por favor? Você ficou em silêncio o caminho todo de volta."

# game/chapters/chapter5/script/ch5sc1.rpy:2263
translate brazil ch5sc1_f76defdb:

#   mc "It upsets me when you call yourself a monster."
    mc "Me incomoda quando você se autodenomina um monstro."

# game/chapters/chapter5/script/ch5sc1.rpy:2264
translate brazil ch5sc1_e3ddda52:

#   mc "Nothing could be further from the truth. If you’re a monster, then so am I."
    mc "Nada poderia estar mais longe da verdade. Se você é um monstro, então eu também sou."

# game/chapters/chapter5/script/ch5sc1.rpy:2266
translate brazil ch5sc1_0f3436f8:

#   el "Don’t say that!! You’re not!"
    el "Não diga isso!! Você não é!"

# game/chapters/chapter5/script/ch5sc1.rpy:2267
translate brazil ch5sc1_f726f488:

#   el "Neither of us are! We’re just trying our best and it doesn’t always go according to plan!"
    el "Nenhum de nós é! Estamos apenas tentando dar o nosso melhor e nem sempre as coisas saem como planejado!"

# game/chapters/chapter5/script/ch5sc1.rpy:2268
translate brazil ch5sc1_66a5117a:

#   mc "*Chuckles*"
    mc "*Risos*"

# game/chapters/chapter5/script/ch5sc1.rpy:2270
translate brazil ch5sc1_e9969f12:

#   el "Why are you laughing?! This isn’t funny!"
    el "Por que você está rindo?! Isso não tem graça!"

# game/chapters/chapter5/script/ch5sc1.rpy:2272
translate brazil ch5sc1_ae2ccc61:

#   mc "*Laughs* It’s a little funny. Getting you worked up to psych yourself out of a bad state seems to be effective."
    mc "*Risos* É um pouco engraçado. Parece que te deixar agitado para te tirar de um estado ruim é eficaz."

# game/chapters/chapter5/script/ch5sc1.rpy:2273
translate brazil ch5sc1_f6f8a0b2:

#   el "Hnnnrh!"
    el "Hnnnrh!"

# game/chapters/chapter5/script/ch5sc1.rpy:2275
translate brazil ch5sc1_72310a9f:

#   mc "Don’t pout... Sylph says it promotes wrinkles."
    mc "Não faça beicinho... Sylph diz que isso causa rugas."

# game/chapters/chapter5/script/ch5sc1.rpy:2276
translate brazil ch5sc1_99669c06:

#   mc "Now, make some room. It's been quite the day and I’m about to pass out."
    mc "Agora, abra espaço. Foi um dia e tanto e estou quase desmaiando."

# game/chapters/chapter5/script/ch5sc1.rpy:2278
translate brazil ch5sc1_fa149e3c:

#   "The two of you finish undressing and crawl under the covers together."
    "Vocês dois terminam de se despir e se aconchegam juntos debaixo das cobertas."

# game/chapters/chapter5/script/ch5sc1.rpy:2280
translate brazil ch5sc1_93ac2ca2:

#   el "This feels nice..."
    el "Isso é bom..."

# game/chapters/chapter5/script/ch5sc1.rpy:2282
translate brazil ch5sc1_fefcb8c4:

#   mc "I’m not much of a holy man but... damn, this surely feels like heaven."
    mc "Não sou lá muito religioso, mas... caramba, isso aqui parece o paraíso."

# game/chapters/chapter5/script/ch5sc1.rpy:2283
translate brazil ch5sc1_789c7a34:

