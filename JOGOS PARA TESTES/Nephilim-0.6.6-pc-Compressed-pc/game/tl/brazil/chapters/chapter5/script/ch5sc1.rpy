#   elt "She has some nerve showing herself in this city after what she’s done."
    elt "Ela tem muita audácia de se mostrar nesta cidade depois do que fez."

# game/chapters/chapter5/script/ch5sc1.rpy:2053
translate brazil ch5sc1_89d13746:

#   elt "[mc] may have killed her sister as punishment, but he said it was up to me to judge Selena."
    elt "[mc] Ele pode ter matado a irmã dela como punição, mas disse que cabia a mim julgar Selena."

