translate brazil ch5sc1_53787d91:

#   al "[mc]! Hi! You’re here!"
    al "[mc] Olá! Você está aqui!"

# game/chapters/chapter5/script/ch5sc1.rpy:194
translate brazil ch5sc1_b2339386:

#   mc "Yeah, I wanted to check to see how you and Luna are progressing with the hex."
    mc "Sim, eu queria saber como você e Luna estão se saindo com o feitiço."

# game/chapters/chapter5/script/ch5sc1.rpy:196
translate brazil ch5sc1_fa959f97:

#   al "And here I thought you'd come to visit your childhood friend..."
    al "E eu que pensava que você viria visitar seu amigo de infância..."

# game/chapters/chapter5/script/ch5sc1.rpy:197
translate brazil ch5sc1_347119d8:

#   mc "Sweet Alice... you should know by now that your pouty face never works on me."
    mc "Querida Alice... você já deveria saber que essa sua carinha emburrada nunca funciona comigo."

# game/chapters/chapter5/script/ch5sc1.rpy:199
translate brazil ch5sc1_0bc75ba7:

#   al "*Puckers lips* Hnnngh..."
    al "*Faz biquinho* Hnnngh..."

# game/chapters/chapter5/script/ch5sc1.rpy:200
translate brazil ch5sc1_a288197d:

#   al "............"
    al "............"

# game/chapters/chapter5/script/ch5sc1.rpy:201
translate brazil ch5sc1_c585dd3c:

#   mc "*Sigh* Okay, fine. The hex check-up is obviously just a cover."
    mc "*Suspiro* Ok, tudo bem. O exame de feitiços é obviamente só uma fachada."

# game/chapters/chapter5/script/ch5sc1.rpy:202
translate brazil ch5sc1_0f7b991f:

#   mc "I’m really here to visit my sweet and dear childhood friend whom I’ve missed so, so much!"
    mc "Estou aqui para visitar minha querida amiga de infância, de quem sinto tanta, tanta falta!"

# game/chapters/chapter5/script/ch5sc1.rpy:204
translate brazil ch5sc1_e858b610:

#   al "I knew it! You really missed me?"
    al "Eu sabia! Você realmente sentiu minha falta?"

# game/chapters/chapter5/script/ch5sc1.rpy:206
translate brazil ch5sc1_41806c86:

#   mc "Sure did!"
    mc "Com certeza!"

# game/chapters/chapter5/script/ch5sc1.rpy:207
translate brazil ch5sc1_9a565335:

#   al "Awwwh! I missed you too! Lots!"
    al "Ahhh! Eu também senti sua falta! Muita!"

# game/chapters/chapter5/script/ch5sc1.rpy:215
translate brazil ch5sc1_a9dee9ae:

#   lu "Alice! There you are. I thought you still had classes going on?"
    lu "Alice! Aí está você. Pensei que você ainda estivesse tendo aulas?"

# game/chapters/chapter5/script/ch5sc1.rpy:218
translate brazil ch5sc1_8a790429:

#   al "I had a short break so I thought I'd quickly get things setup for you."
    al "Tive uma pequena pausa, então pensei em organizar tudo rapidinho para você."

# game/chapters/chapter5/script/ch5sc1.rpy:220
translate brazil ch5sc1_56d3c3df:

#   lu "Thank you, Alice. I appreciate it."
    lu "Obrigada, Alice. Agradeço muito."

# game/chapters/chapter5/script/ch5sc1.rpy:221
translate brazil ch5sc1_1e5fdf0d:

#   lu "And I see you brought [mc] with you... perfect!"
    lu "E vejo que você trouxe [mc] Com você... perfeito!"

# game/chapters/chapter5/script/ch5sc1.rpy:223
translate brazil ch5sc1_2fec3c6a:

#   al "Perfect?"
    al "Perfeito?"

# game/chapters/chapter5/script/ch5sc1.rpy:224
translate brazil ch5sc1_41193554:

#   lu "Yup! Perfect! I need him."
    lu "Sim! Perfeito! Preciso dele."

# game/chapters/chapter5/script/ch5sc1.rpy:226
translate brazil ch5sc1_d6218567:

#   mc "What do you need me for?"
    mc "Para que você precisa de mim?"

# game/chapters/chapter5/script/ch5sc1.rpy:227
translate brazil ch5sc1_04da9ada:

#   lu "It's a secret! *Laughs lightly*"
    lu "É segredo! *Risos discretos*"

# game/chapters/chapter5/script/ch5sc1.rpy:228
translate brazil ch5sc1_de6fef95:

#   lu "You’ll see! Soon."
    lu "Você vai ver! Em breve."

# game/chapters/chapter5/script/ch5sc1.rpy:230
translate brazil ch5sc1_79ef552f:

#   al "Don’t worry, [mc]. You’re in good hands with her! She's really good with magic."
    al "Não se preocupe, [mc] Você está em boas mãos com ela! Ela é realmente muito boa com magia."

# game/chapters/chapter5/script/ch5sc1.rpy:231
translate brazil ch5sc1_e378bfcd:

#   al "I’ve gotta go. My class is about to resume and the professor is already on my ass..."
    al "Preciso ir. Minha aula está prestes a começar e o professor já está me enchendo o saco..."

# game/chapters/chapter5/script/ch5sc1.rpy:233
translate brazil ch5sc1_bd30159d:

#   al "Catch you later?"
    al "Até mais?"

# game/chapters/chapter5/script/ch5sc1.rpy:234
translate brazil ch5sc1_03440f30:

#   mc "Mh-Hm."
    mc "Hum-hum."

# game/chapters/chapter5/script/ch5sc1.rpy:236
translate brazil ch5sc1_cb9b696f:

#   al "*Whispering* {size=-10}{b}Keep those handsome lips ready...{/b}{/size}"
    al "*Sussurrando* {size=-10}{b}Mantenha esses lábios bonitos sempre prontos...{/b}{/size}"

# game/chapters/chapter5/script/ch5sc1.rpy:237
translate brazil ch5sc1_7886f302:

#   al "*Whispering* {size=-10}{b}That was the type of kiss which... needs to be finished.{/b}{/size}"
    al "*Sussurrando* {size=-10}{b}Esse foi o tipo de beijo que... precisa ser finalizado.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc1.rpy:238
translate brazil ch5sc1_5b86a557:

#   mc "*Whispering* {size=-10}{b}You're right, that kiss deserves a proper ending.{/b}{/size}"
    mc "*Sussurrando* {size=-10}{b}Você tem razão, aquele beijo merece um final apropriado.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc1.rpy:241
translate brazil ch5sc1_a88c15d6:

#   al "Take care!"
    al "Tomar cuidado!"

# game/chapters/chapter5/script/ch5sc1.rpy:247
translate brazil ch5sc1_f79b555f:

#   lu "She is totally crushing on you."
    lu "Ela está completamente apaixonada por você."

# game/chapters/chapter5/script/ch5sc1.rpy:248
translate brazil ch5sc1_2bca746c:

#   mc "I’m aware..."
    mc "Estou ciente..."

# game/chapters/chapter5/script/ch5sc1.rpy:250
translate brazil ch5sc1_f1456a82:

#   lu "So... why aren’t you doing something about it?"
    lu "Então... por que você não está fazendo nada a respeito?"

# game/chapters/chapter5/script/ch5sc1.rpy:251
translate brazil ch5sc1_0cfd2f09:

#   lu "All the boys at the academy are fawning over her."
    lu "Todos os rapazes da academia estão babando por ela."

# game/chapters/chapter5/script/ch5sc1.rpy:252
translate brazil ch5sc1_aa87e56c:

#   lu "And yet, you're the only guy she gives any thought? It only makes sense to claim her as yours, no?"
    lu "E, no entanto, você é o único cara em quem ela pensa? Faz todo o sentido reivindicá-la como sua, não é?"

# game/chapters/chapter5/script/ch5sc1.rpy:254
translate brazil ch5sc1_a329ff04:

#   mc "Me and Alice... it’s complicated."
    mc "Eu e Alice... é complicado."

# game/chapters/chapter5/script/ch5sc1.rpy:255
translate brazil ch5sc1_b25127ef:

#   lu "She told me you’ve been friends since childhood?"
    lu "Ela me disse que vocês são amigas desde a infância?"

# game/chapters/chapter5/script/ch5sc1.rpy:256
translate brazil ch5sc1_03b05852:

#   lu "You're afraid you might ruin the friendship or?"
    lu "Você tem medo de arruinar a amizade ou...?"

# game/chapters/chapter5/script/ch5sc1.rpy:258
translate brazil ch5sc1_23416d5f:

#   mc "Yeah... it's definitely crossed my mind."
    mc "Sim... definitivamente já me passou pela cabeça."

# game/chapters/chapter5/script/ch5sc1.rpy:259
translate brazil ch5sc1_aa5ae10b:

#   lu "I’m sorry."
    lu "Desculpe."

# game/chapters/chapter5/script/ch5sc1.rpy:260
translate brazil ch5sc1_72ea42d4:

#   lu "It’s none of my business... Mother always tells me I’m too nosy."
    lu "Não é da minha conta... Minha mãe sempre diz que sou muito intrometida."

# game/chapters/chapter5/script/ch5sc1.rpy:261
translate brazil ch5sc1_be2c1d36:

#   mc "It’s okay. I can understand being curious..."
    mc "Não tem problema. Eu entendo a curiosidade..."

# game/chapters/chapter5/script/ch5sc1.rpy:263
translate brazil ch5sc1_1bf638a1:

#   mc "I used to be curious about everything when I was younger."
    mc "Quando era mais jovem, eu costumava ser curioso sobre tudo."

# game/chapters/chapter5/script/ch5sc1.rpy:264
translate brazil ch5sc1_8a455df9:

#   lu "Really? I’d like to hear about that."
    lu "Sério? Gostaria de saber mais sobre isso."

# game/chapters/chapter5/script/ch5sc1.rpy:265
translate brazil ch5sc1_cb31274c:

#   lu "Let’s go sit by the window?"
    lu "Vamos sentar perto da janela?"

# game/chapters/chapter5/script/ch5sc1.rpy:266
translate brazil ch5sc1_606e2d02:

#   mc "Sure."
    mc "Claro."

# game/chapters/chapter5/script/ch5sc1.rpy:268
translate brazil ch5sc1_95e2ae7b:

#   lu "*Excitedly* Awesome! Fantastic! Magnificent! Splendid! Grand! There's so much I want to know!"
    lu "*Extremamente* Incrível! Fantástico! Magnífico! Esplêndido! Grandioso! Há tanta coisa que eu quero saber!"

# game/chapters/chapter5/script/ch5sc1.rpy:269
translate brazil ch5sc1_63c6741c:

#   mc "Great... what did I just get myself into?"
    mc "Ótimo... em que enrascada eu me meti?"

# game/chapters/chapter5/script/ch5sc1.rpy:270
translate brazil ch5sc1_d47d618e:

#   lu "*Snickers* Nothing you can’t handle, I’m sure."
    lu "*Risos* Nada que você não possa lidar, tenho certeza."

# game/chapters/chapter5/script/ch5sc1.rpy:272
translate brazil ch5sc1_3f8e6175:

#   "Luna observes you carefully as you sit down beside her."
    "Luna observa você atentamente enquanto você se senta ao lado dela."

# game/chapters/chapter5/script/ch5sc1.rpy:273
translate brazil ch5sc1_b0d8b5c6:

#   mct "She seems a little nervous."
    mct "Ela parece um pouco nervosa."

# game/chapters/chapter5/script/ch5sc1.rpy:275
translate brazil ch5sc1_f28b3ab9:

#   mc "Are you alright?"
    mc "Você está bem?"

# game/chapters/chapter5/script/ch5sc1.rpy:277
translate brazil ch5sc1_a01a7dd4:

#   lu "Hmh? Oh, me? Yup! I’m good!"
    lu "Hum? Ah, eu? Sim! Estou bem!"

# game/chapters/chapter5/script/ch5sc1.rpy:278
translate brazil ch5sc1_5378b122:

#   lu "Splendid actually!"
    lu "Simplesmente esplêndido!"

# game/chapters/chapter5/script/ch5sc1.rpy:280
translate brazil ch5sc1_c15cc7d6:

#   lu "..."
    lu "..."

# game/chapters/chapter5/script/ch5sc1.rpy:282
translate brazil ch5sc1_086c2316:

#   lu "It’s just..."
    lu "É que..."

# game/chapters/chapter5/script/ch5sc1.rpy:283
translate brazil ch5sc1_958031f1:

#   lu "It's the first time I’ve been alone with a boy."
    lu "É a primeira vez que fico sozinha com um rapaz."

# game/chapters/chapter5/script/ch5sc1.rpy:285
translate brazil ch5sc1_0153a7ab:

#   lu "I mean- We’ve been alone before... When we first met."
    lu "Quer dizer, nós já ficamos sozinhos antes... Quando nos conhecemos."

# game/chapters/chapter5/script/ch5sc1.rpy:286
translate brazil ch5sc1_8342d6fd:

#   lu "You know- when I almost fireballed you?"
    lu "Sabe, quando eu quase te lancei uma bola de fogo?"

# game/chapters/chapter5/script/ch5sc1.rpy:287
translate brazil ch5sc1_acac6d42:

#   lu "But that was totally different! It wasn’t intentional!"
    lu "Mas aquilo foi totalmente diferente! Não foi intencional!"

# game/chapters/chapter5/script/ch5sc1.rpy:289
translate brazil ch5sc1_1ea260e1:

#   mc "And this is... intentional?"
    mc "E isso é... intencional?"

# game/chapters/chapter5/script/ch5sc1.rpy:291
translate brazil ch5sc1_2247a37b:

#   lu "Uh-huh!"
    lu "Uhum!"

# game/chapters/chapter5/script/ch5sc1.rpy:292
translate brazil ch5sc1_baa02e4b:

#   lu "I mean... I chose to sit here with you."
    lu "Quer dizer... eu escolhi sentar aqui com você."

# game/chapters/chapter5/script/ch5sc1.rpy:294
translate brazil ch5sc1_ed482010:

#   mc "*Chuckles* Does that mean you like me?"
    mc "*Risos* Isso significa que você gosta de mim?"

# game/chapters/chapter5/script/ch5sc1.rpy:296
translate brazil ch5sc1_6e2d8440:

#   lu "L-Like you?"
    lu "Tipo você?"

# game/chapters/chapter5/script/ch5sc1.rpy:297
translate brazil ch5sc1_00381009:

#   lu "{b}UH!{/b} Don’t be silly! I barely know you..."
    lu "{b}UH!{/b} Não seja bobo! Mal te conheço..."

# game/chapters/chapter5/script/ch5sc1.rpy:298
translate brazil ch5sc1_9df4d7dc:

#   mc "You can still feel a connection with someone based upon initial impression."
    mc "Você ainda pode sentir uma conexão com alguém com base na primeira impressão."

# game/chapters/chapter5/script/ch5sc1.rpy:299
translate brazil ch5sc1_8d9de236:

#   lu "True! I felt it too! Uh, I mean... *Sighs*"
    lu "Verdade! Eu também senti isso! Quer dizer... *Suspiros*"

# game/chapters/chapter5/script/ch5sc1.rpy:301
translate brazil ch5sc1_28631dbc:

#   lu "I just- I just really like that you are trying to help free my mom."
    lu "Eu simplesmente... eu realmente gosto que você esteja tentando ajudar a libertar minha mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:302
translate brazil ch5sc1_4b4721a3:

#   lu "That’s all! It’s pretty admirable."
    lu "É só isso! É bastante admirável."

# game/chapters/chapter5/script/ch5sc1.rpy:303
translate brazil ch5sc1_2b3fbd89:

#   lu "And Alice vouches for you."
    lu "E Alice garante por você."

# game/chapters/chapter5/script/ch5sc1.rpy:304
translate brazil ch5sc1_0231fac4:

#   lu "Which means you're great! Uh-huh!"
    lu "Isso significa que você é ótimo! Uhum!"

# game/chapters/chapter5/script/ch5sc1.rpy:306
translate brazil ch5sc1_47560ae1:

#   mct "It’s not as admirable as she thinks... I just can’t allow Taron to have anything he wants."
    mct "Não é tão admirável quanto ela pensa... Eu simplesmente não posso permitir que Taron tenha tudo o que deseja."

# game/chapters/chapter5/script/ch5sc1.rpy:307
translate brazil ch5sc1_327374c8:

#   mct "Although... it could be handy to have a witch as an ally. And she has connections to the Mages Guild."
    mct "Embora... ter uma bruxa como aliada pudesse ser útil. E ela tem ligações com a Guilda dos Magos."

# game/chapters/chapter5/script/ch5sc1.rpy:308
translate brazil ch5sc1_c61793e5:

#   mct "Alice really seems to trust her, and she’s always been a great judge of character. She was best friends with me, after all."
    mct "Alice parece confiar muito nela, e ela sempre teve um ótimo faro para julgamento de pessoas. Afinal, ela era minha melhor amiga."

# game/chapters/chapter5/script/ch5sc1.rpy:309
translate brazil ch5sc1_9e77c7a7:

#   mct "Not to mention, my gut feeling about Luna is that she is genuine to the core."
    mct "Sem falar que, pelo que sinto, a Luna é genuína até a medula."

# game/chapters/chapter5/script/ch5sc1.rpy:310
translate brazil ch5sc1_92aff541:

#   mc "I’m happy to help, Luna."
    mc "Fico feliz em ajudar, Luna."

# game/chapters/chapter5/script/ch5sc1.rpy:311
translate brazil ch5sc1_8a8f7f68:

#   mc "Nobody should have to go through what Taron is doing to you and your mother."
    mc "Ninguém deveria ter que passar pelo que Taron está fazendo com você e sua mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:313
translate brazil ch5sc1_d4de440f:

#   lu "Thank you. It- It means a lot."
    lu "Obrigado. Isso significa muito."

# game/chapters/chapter5/script/ch5sc1.rpy:315
translate brazil ch5sc1_ef195d7c:

#   lu "There's something I wanted to ask you..."
    lu "Há algo que eu queria te perguntar..."

# game/chapters/chapter5/script/ch5sc1.rpy:316
translate brazil ch5sc1_8fa3d797:

#   lu "Did you manage to break the curse on the sword?"
    lu "Você conseguiu quebrar a maldição da espada?"

# game/chapters/chapter5/script/ch5sc1.rpy:318
translate brazil ch5sc1_a5b47daf:

#   mct "Right, Onyx... I wasn't sure if or when I should tell her."
    mct "Certo, Onyx... Eu não tinha certeza se ou quando deveria contar a ela."

# game/chapters/chapter5/script/ch5sc1.rpy:319
translate brazil ch5sc1_aa375e45:

#   mct "Alice is a good judge of character and she trusts Luna."
    mct "Alice tem um bom faro para pessoas e confia em Luna."

# game/chapters/chapter5/script/ch5sc1.rpy:320
translate brazil ch5sc1_d5515e13:

#   mct "If I want to make an ally out of her, I need to try trusting her..."
    mct "Se eu quiser fazer dela minha aliada, preciso tentar confiar nela..."

# game/chapters/chapter5/script/ch5sc1.rpy:322
translate brazil ch5sc1_3eab9c8c:

#   lu "You okay?"
    lu "Você está bem?"

# game/chapters/chapter5/script/ch5sc1.rpy:323
translate brazil ch5sc1_f578edbd:

#   lu "It's okay if you couldn't break the curse-"
    lu "Não tem problema se você não conseguiu quebrar a maldição."

# game/chapters/chapter5/script/ch5sc1.rpy:325
translate brazil ch5sc1_00c98501:

#   mc "I broke the curse."
    mc "Quebrei a maldição."

# game/chapters/chapter5/script/ch5sc1.rpy:326
translate brazil ch5sc1_dd8db2ec:

#   mc "But it wasn't a sword at all. It was a being from the ancient world, a symbiote."
    mc "Mas não era uma espada. Era um ser do mundo antigo, um simbionte."

# game/chapters/chapter5/script/ch5sc1.rpy:329
translate brazil ch5sc1_751b5177:

#   lu "{b}WHAT?!{/b} A S-Symbiote?!"
    lu "{b}O QUE?!{/b} Um simbionte S?!"

# game/chapters/chapter5/script/ch5sc1.rpy:330
translate brazil ch5sc1_e5c668e9:

#   lu "Don't tell me you already bonded with it?"
    lu "Não me diga que você já criou um vínculo com isso?"

# game/chapters/chapter5/script/ch5sc1.rpy:331
translate brazil ch5sc1_7222bac4:

#   mc "I did."
    mc "Eu fiz."

# game/chapters/chapter5/script/ch5sc1.rpy:333
translate brazil ch5sc1_92251dfe:

#   lu "Good grief... You just rushed into it like that?"
    lu "Puxa vida... Você se precipitou assim, sem mais nem menos?"

# game/chapters/chapter5/script/ch5sc1.rpy:334
translate brazil ch5sc1_ff11fe93:

#   lu "By all that's arcane, what compelled you to do such a thing?"
    lu "Por tudo que é misterioso, o que te levou a fazer tal coisa?"

# game/chapters/chapter5/script/ch5sc1.rpy:335
translate brazil ch5sc1_0da38c05:

#   mc "It may have been a little impulsive... but I couldn't risk Taron getting his hands on Onyx."
    mc "Talvez tenha sido um pouco impulsivo... mas eu não podia arriscar que Taron pusesse as mãos em Onyx."

# game/chapters/chapter5/script/ch5sc1.rpy:337
translate brazil ch5sc1_ab7ddf67:

#   lu "Onyx, huh? You do realize bonding with a symbiote is permanent, right?"
    lu "Onyx, hein? Você sabe que a ligação com um simbionte é permanente, né?"

# game/chapters/chapter5/script/ch5sc1.rpy:339
translate brazil ch5sc1_2f6d3aca:

#   mc "Onyx mentioned that, yes."
    mc "Onyx mencionou isso, sim."

# game/chapters/chapter5/script/ch5sc1.rpy:340
translate brazil ch5sc1_88ad2183:

#   mc "She basically gave me the full rundown about symbiosis before I accepted her."
    mc "Basicamente, ela me explicou tudo sobre simbiose antes de eu aceitá-la."

# game/chapters/chapter5/script/ch5sc1.rpy:342
translate brazil ch5sc1_2e2c368b:

#   lu "You'll die, though... A symbiote feeds on their hosts energy! She'll consume your life force."
    lu "Você vai morrer, sim... Um simbionte se alimenta da energia do hospedeiro! Ele consumirá sua força vital."

# game/chapters/chapter5/script/ch5sc1.rpy:343
translate brazil ch5sc1_c7cf61ed:

#   lu "It may take a long time, but in the end their hosts always die."
    lu "Pode demorar muito, mas no final seus hospedeiros sempre morrem."

# game/chapters/chapter5/script/ch5sc1.rpy:345
translate brazil ch5sc1_60532f63:

#   mc "I've got that covered..."
    mc "Isso está resolvido..."

# game/chapters/chapter5/script/ch5sc1.rpy:347
translate brazil ch5sc1_1b6777a2:

#   lu "Okay? Color me intrigued."
    lu "Certo? Estou intrigado."

# game/chapters/chapter5/script/ch5sc1.rpy:348
translate brazil ch5sc1_73f6320e:

#   lu "I'm a little disappointed I didn't get a say in this..."
    lu "Estou um pouco decepcionado por não ter tido voz nessa decisão..."

# game/chapters/chapter5/script/ch5sc1.rpy:350
translate brazil ch5sc1_4046742d:

#   lu "But knowing that this Onyx is out of Taron's reach helps make up for it."
    lu "Mas saber que esse ônix está fora do alcance de Taron ajuda a compensar isso."

# game/chapters/chapter5/script/ch5sc1.rpy:351
translate brazil ch5sc1_5daddcd3:

#   lu "That bastard doesn't deserve to get anything he wants."
    lu "Aquele desgraçado não merece conseguir nada do que quer."

# game/chapters/chapter5/script/ch5sc1.rpy:353
translate brazil ch5sc1_85014c1e:

#   mc "Thank you for taking it so well."
    mc "Obrigada por ter reagido tão bem."

# game/chapters/chapter5/script/ch5sc1.rpy:354
translate brazil ch5sc1_05578ee3:

#   mc "I was half-expecting you to go off on me."
    mc "Eu meio que esperava que você me desse um sermão."

# game/chapters/chapter5/script/ch5sc1.rpy:356
translate brazil ch5sc1_c2d27570:

#   lu "And what exactly would either of us get out of that?"
    lu "E o que exatamente qualquer um de nós ganharia com isso?"

# game/chapters/chapter5/script/ch5sc1.rpy:357
translate brazil ch5sc1_19e2ff79:

#   lu "I want us to be allies, if that wasn't clear."
    lu "Quero que sejamos aliados, caso não tenha ficado claro."

# game/chapters/chapter5/script/ch5sc1.rpy:359
translate brazil ch5sc1_b8b3b58c:

#   lu "Maybe I'm desperate... Maybe it's Alice's high opinion of you?"
    lu "Talvez eu esteja desesperado... Talvez seja a alta opinião que Alice tem de você?"

# game/chapters/chapter5/script/ch5sc1.rpy:360
translate brazil ch5sc1_8455f690:

#   lu "Or maybe I'm just naive..."
    lu "Ou talvez eu seja apenas ingênuo..."

# game/chapters/chapter5/script/ch5sc1.rpy:362
translate brazil ch5sc1_537a5aca:

#   lu "But I feel like I can trust you."
    lu "Mas sinto que posso confiar em você."

# game/chapters/chapter5/script/ch5sc1.rpy:363
translate brazil ch5sc1_6fd5a627:

#   lu "So no, I'm not mad."
    lu "Então não, eu não estou bravo."

# game/chapters/chapter5/script/ch5sc1.rpy:365
translate brazil ch5sc1_59fc5605:

#   lu "Just promise me you'll use Onyx, or whatever other mean's you have, to help my mom."
    lu "Prometa-me apenas que você usará o Onyx, ou qualquer outro meio que você tiver, para ajudar minha mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:366
translate brazil ch5sc1_9ebe58a5:

#   lu "She needs our help."
    lu "Ela precisa da nossa ajuda."

# game/chapters/chapter5/script/ch5sc1.rpy:368
translate brazil ch5sc1_6455c8c1:

#   mc "You can count on it."
    mc "Pode contar com isso."

# game/chapters/chapter5/script/ch5sc1.rpy:371
translate brazil ch5sc1_12fe5cb1:

#   lu "Good! Good, good... goody-good!"
    lu "Bom! Bom, bom... muito bom!"

# game/chapters/chapter5/script/ch5sc1.rpy:372
translate brazil ch5sc1_ccb353b7:

#   lu "Now, tell me something about yourself!"
    lu "Agora, me conte algo sobre você!"

# game/chapters/chapter5/script/ch5sc1.rpy:374
translate brazil ch5sc1_276b40a0:

#   mc "Mhm... Well, I left home at the age of ten."
    mc "Hum... Bem, eu saí de casa aos dez anos de idade."

# game/chapters/chapter5/script/ch5sc1.rpy:377
translate brazil ch5sc1_7d4b9c78:

#   lu "{size=+5}{b}Ten?!{/b}{/size}"
    lu "{size=+5}{b}Dez?!{/b}{/size}"

# game/chapters/chapter5/script/ch5sc1.rpy:378
translate brazil ch5sc1_bccd9e48:

#   lu "By the sage’s balls! What were you thinking?!"
    lu "Pelos testículos do sábio! O que você estava pensando?!"

# game/chapters/chapter5/script/ch5sc1.rpy:379
translate brazil ch5sc1_74b0fd81:

#   lu "Did your parents... beat you? Is that why you ran away?"
    lu "Seus pais... batiam em você? Foi por isso que você fugiu?"

# game/chapters/chapter5/script/ch5sc1.rpy:381
translate brazil ch5sc1_35bb4501:

#   lu "I could fireball them for you, if you want?"
    lu "Eu poderia lançar bolas de fogo neles para você, se quiser?"

# game/chapters/chapter5/script/ch5sc1.rpy:383
translate brazil ch5sc1_1a3e1e61:

#   mc "Settle down, Luna. I appreciate you being willing to fireball someone on my behalf."
    mc "Calma, Luna. Agradeço por você estar disposta a lançar uma bola de fogo em alguém por mim."

# game/chapters/chapter5/script/ch5sc1.rpy:384
translate brazil ch5sc1_7b2a7e8f:

#   mc "But that won’t be necessary. And no, they didn’t beat me. Nor did I run away."
    mc "Mas isso não será necessário. E não, eles não me bateram. Nem eu fugi."

# game/chapters/chapter5/script/ch5sc1.rpy:386
translate brazil ch5sc1_f006eec2:

#   mc "They were the best parents I could have wished for... My father was always pushing me to learn things."
    mc "Eles foram os melhores pais que eu poderia ter desejado... Meu pai sempre me incentivou a aprender coisas."

# game/chapters/chapter5/script/ch5sc1.rpy:387
translate brazil ch5sc1_c6ef6c0a:

#   mc "And my mother showered me with warmth and love."
    mc "E minha mãe me cobriu de carinho e amor."

# game/chapters/chapter5/script/ch5sc1.rpy:388
translate brazil ch5sc1_e9fa526d:

#   mc "I left home because... *Sighs heavily*"
    mc "Saí de casa porque... *Suspiro pesado*"

# game/chapters/chapter5/script/ch5sc1.rpy:390
translate brazil ch5sc1_1710a46f:

#   "Luna noticed the despair in your tone and she moves closer, sliding one of her legs across yours."
    "Luna percebeu o desespero em seu tom de voz e se aproximou, deslizando uma das pernas sobre a sua."

# game/chapters/chapter5/script/ch5sc1.rpy:391
translate brazil ch5sc1_0f267b41:

#   "You hesitate and swallow a lump in your throat as you try to explain."
    "Você hesita e engole em seco enquanto tenta explicar."

# game/chapters/chapter5/script/ch5sc1.rpy:392
translate brazil ch5sc1_bb132644:

#   "Apparently it hasn’t gotten any easier to share your past with people..."
    "Aparentemente, compartilhar o passado com as pessoas não ficou mais fácil..."

# game/chapters/chapter5/script/ch5sc1.rpy:394
translate brazil ch5sc1_ee68552a:

#   lu "It’s okay, [mc]. You can tell me."
    lu "Tudo bem, [mc] Você pode me contar."

# game/chapters/chapter5/script/ch5sc1.rpy:396
translate brazil ch5sc1_f9c67d76:

#   lu "It’s just the two of us here."
    lu "Só estamos nós dois aqui."

# game/chapters/chapter5/script/ch5sc1.rpy:398
translate brazil ch5sc1_fe8d0907:

#   lu "I’m not going anywhere."
    lu "Eu não vou a lugar nenhum."

# game/chapters/chapter5/script/ch5sc1.rpy:400
translate brazil ch5sc1_d47f5b80:

#   mct "Her hand, it’s so... delicate and warm."
    mct "A mão dela é tão... delicada e quente."

# game/chapters/chapter5/script/ch5sc1.rpy:402
translate brazil ch5sc1_845b5030:

#   mc "*Sigh* The day I left home... I spent the day playing with Alice."
    mc "*Suspiro* No dia em que saí de casa... passei o dia brincando com Alice."

# game/chapters/chapter5/script/ch5sc1.rpy:404
translate brazil ch5sc1_39f12ef1:

#   mc "We went exploring in the woods like we'd done many times before. Playing at being adventurers..."
    mc "Fomos explorar a floresta como já tínhamos feito muitas vezes antes. Brincando de aventureiros..."

# game/chapters/chapter5/script/ch5sc1.rpy:406
translate brazil ch5sc1_616dd142:

#   mc "We ended up falling asleep in the woods and when we woke up it was already dark."
    mc "Acabamos adormecendo na floresta e, quando acordamos, já estava escuro."

# game/chapters/chapter5/script/ch5sc1.rpy:409
translate brazil ch5sc1_6c84a0b0:

#   mc "When I finally got home... I realized I couldn’t smell Mother’s stew..."
    mc "Quando finalmente cheguei em casa... percebi que não conseguia sentir o cheiro do ensopado da minha mãe..."

# game/chapters/chapter5/script/ch5sc1.rpy:412
translate brazil ch5sc1_69a9d80a:

#   mc "And I didn’t hear Father complaining about setting the table... or chopping firewood."
    mc "E não ouvi meu pai reclamando de arrumar a mesa... ou de cortar lenha."

# game/chapters/chapter5/script/ch5sc1.rpy:415
translate brazil ch5sc1_7e4515a7:

#   mc "I'd never heard my home be so silent before."
    mc "Nunca tinha ouvido minha casa ficar tão silenciosa antes."

# game/chapters/chapter5/script/ch5sc1.rpy:422
translate brazil ch5sc1_70b5812b:

#   mc "When I went inside... everything was a mess."
    mc "Quando entrei... estava tudo uma bagunça."

# game/chapters/chapter5/script/ch5sc1.rpy:424
translate brazil ch5sc1_2120b151:

#   mc "I started searching the house and-..."
    mc "Comecei a procurar pela casa e..."

# game/chapters/chapter5/script/ch5sc1.rpy:425
translate brazil ch5sc1_8771aff3:

#   mc "As I entered our bedroom, that’s when I saw them..."
    mc "Assim que entrei no nosso quarto, foi quando os vi..."

# game/chapters/chapter5/script/ch5sc1.rpy:427
translate brazil ch5sc1_6ffeab71:

#   mc "That was the instant when my entire life was vaporized."
    mc "Naquele instante, toda a minha vida se evaporou."

# game/chapters/chapter5/script/ch5sc1.rpy:429
translate brazil ch5sc1_eb230f9e:

#   mc "*Memory* Mama..."
    mc "*Memória* Mamãe..."

# game/chapters/chapter5/script/ch5sc1.rpy:431
translate brazil ch5sc1_71d62025:

#   mc "*Memory* Papa..."
    mc "*Memória* Papai..."

# game/chapters/chapter5/script/ch5sc1.rpy:433
translate brazil ch5sc1_79e5a685:

#   mc "No matter how loudly I screamed for them to wake up... they didn’t respond."
    mc "Por mais alto que eu gritasse para que acordassem... eles não respondiam."

# game/chapters/chapter5/script/ch5sc1.rpy:435
translate brazil ch5sc1_da66c7a4:

#   mc "They were... dead. Murdered. Their bodies were covered in blood and bruises."
    mc "Eles estavam... mortos. Assassinados. Seus corpos estavam cobertos de sangue e hematomas."

# game/chapters/chapter5/script/ch5sc1.rpy:437
translate brazil ch5sc1_c02336dc:

#   mc "I couldn’t believe my own eyes... My parents... dead? Right in front of me?"
    mc "Eu não podia acreditar no que via... Meus pais... mortos? Bem na minha frente?"

# game/chapters/chapter5/script/ch5sc1.rpy:439
translate brazil ch5sc1_6f5eadcd:

#   mc "As I was screaming my lungs out, something happened..."
    mc "Enquanto eu gritava a plenos pulmões, algo aconteceu..."

# game/chapters/chapter5/script/ch5sc1.rpy:441
translate brazil ch5sc1_3f7ef17a:

#   mc "A seal between my mother and me broke."
    mc "Um laço entre minha mãe e eu se rompeu."

# game/chapters/chapter5/script/ch5sc1.rpy:443
translate brazil ch5sc1_d2edb855:

#   mc "And that’s when I discovered I wasn’t human."
    mc "E foi aí que descobri que não era humano."

# game/chapters/chapter5/script/ch5sc1.rpy:445
translate brazil ch5sc1_c41a27f1:

#   mc "I didn’t comprehend it at first. It would be years until I really understood what... I am."
    mc "No início, eu não compreendi. Levaria anos até que eu realmente entendesse o que... eu sou."

# game/chapters/chapter5/script/ch5sc1.rpy:447
translate brazil ch5sc1_3bbdc548:

#   mc "And that’s when ‘He’ appeared..."
    mc "E foi então que 'Ele' apareceu..."

# game/chapters/chapter5/script/ch5sc1.rpy:449
translate brazil ch5sc1_a3c1723a:

#   lu "Who? Who appeared?"
    lu "Quem? Quem apareceu?"

# game/chapters/chapter5/script/ch5sc1.rpy:451
translate brazil ch5sc1_3f299df6:

#   mc "The man who'd become my mentor."
    mc "O homem que se tornaria meu mentor."

# game/chapters/chapter5/script/ch5sc1.rpy:452
translate brazil ch5sc1_89ee7eb5:

#   mc "Eliza’s father... Oren."
    mc "O pai de Eliza... Oren."

# game/chapters/chapter5/script/ch5sc1.rpy:454
translate brazil ch5sc1_777ea20d:

#   mc "He told me that if I followed him... I'd be able to avenge my parents one day."
    mc "Ele me disse que se eu o seguisse... eu seria capaz de vingar meus pais um dia."

# game/chapters/chapter5/script/ch5sc1.rpy:455
translate brazil ch5sc1_113f48eb:

#   mc "So, we left that night. I left behind everything familiar to me, everything and everyone I'd ever cared for."
    mc "Então, partimos naquela noite. Deixei para trás tudo o que me era familiar, tudo e todos por quem eu já havia tido carinho."

# game/chapters/chapter5/script/ch5sc1.rpy:456
translate brazil ch5sc1_9480e38f:

#   mc "I swore I'd make Taron pay. And that vow keeps me going against any odds. I push through so that I can keep my oath someday."
    mc "Jurei que faria Taron pagar. E esse juramento me mantém firme contra todas as adversidades. Persisto para que um dia eu possa cumprir minha promessa."

# game/chapters/chapter5/script/ch5sc1.rpy:461
translate brazil ch5sc1_b323bf05:

#   "*Fist tightens*"
    "*Aperta o punho*"

# game/chapters/chapter5/script/ch5sc1.rpy:464
translate brazil ch5sc1_ca4770e4:

#   lu "Hey... come here."
    lu "Ei... venha cá."

# game/chapters/chapter5/script/ch5sc1.rpy:466
translate brazil ch5sc1_2cb373a2:

#   "Luna mounts you without hesitation and wraps her arms and legs around you."
    "Luna monta em você sem hesitar e te envolve com seus braços e pernas."

# game/chapters/chapter5/script/ch5sc1.rpy:467
translate brazil ch5sc1_310c6fb8:

#   lu "Thank you... for sharing that with me."
    lu "Obrigado... por compartilhar isso comigo."

# game/chapters/chapter5/script/ch5sc1.rpy:469
translate brazil ch5sc1_ecbc3d5d:

#   lu "I can tell that it took a lot for you to tell me..."
    lu "Percebo que foi difícil para você me contar isso..."

# game/chapters/chapter5/script/ch5sc1.rpy:470
translate brazil ch5sc1_67375ad9:

#   lu "That those memories hurt you."
    lu "Que essas lembranças te machucam."

# game/chapters/chapter5/script/ch5sc1.rpy:471
translate brazil ch5sc1_7f8f0f24:

#   lu "I promise I won’t betray your trust."
    lu "Prometo que não trairei sua confiança."

# game/chapters/chapter5/script/ch5sc1.rpy:472
translate brazil ch5sc1_3af97e77:

#   lu "We’ll make him pay... together."
    lu "Vamos fazê-lo pagar... juntos."

# game/chapters/chapter5/script/ch5sc1.rpy:473
translate brazil ch5sc1_93c180ed:

#   lu "He'll regret messing with either of our parents."
    lu "Ele vai se arrepender de ter se metido com qualquer um dos nossos pais."

# game/chapters/chapter5/script/ch5sc1.rpy:475
translate brazil ch5sc1_9c082807:

#   mct "Even if we don’t know each other that well... we're bound together by tragedies caused by Taron."
    mct "Mesmo que não nos conheçamos muito bem... estamos unidos por tragédias causadas por Taron."

# game/chapters/chapter5/script/ch5sc1.rpy:476
translate brazil ch5sc1_96925f08:

#   mct "We're... friends, I actually trust her."
    mct "Somos... amigas, na verdade confio nela."

# game/chapters/chapter5/script/ch5sc1.rpy:477
translate brazil ch5sc1_32b725d6:

#   mc "Luna... thank you."
    mc "Luna... obrigada."

# game/chapters/chapter5/script/ch5sc1.rpy:478
translate brazil ch5sc1_8249c766:

#   lu "No need to thank me... I can’t believe I threatened to fireball your parents earlier..."
    lu "Não precisa agradecer... Não acredito que ameacei lançar uma bola de fogo nos seus pais mais cedo..."

# game/chapters/chapter5/script/ch5sc1.rpy:479
translate brazil ch5sc1_7a2e8379:

#   lu "That was so insensitive..."
    lu "Isso foi tão insensível..."

# game/chapters/chapter5/script/ch5sc1.rpy:480
translate brazil ch5sc1_91b47303:

#   mc "You couldn’t have known."
    mc "Você não tinha como saber."

# game/chapters/chapter5/script/ch5sc1.rpy:482
translate brazil ch5sc1_7f554d4b:

#   lu "*Squeezes tightly* Sorry..."
    lu "*Aperta com força* Desculpe..."

# game/chapters/chapter5/script/ch5sc1.rpy:483
translate brazil ch5sc1_de8bc8d8:

#   mct "Damn... This is not a regular hug."
    mct "Caramba... Isso não é um abraço comum."

# game/chapters/chapter5/script/ch5sc1.rpy:484
translate brazil ch5sc1_3b671384:

#   mct "There’s a lot of emotion in it."
    mct "Há muita emoção envolvida."

# game/chapters/chapter5/script/ch5sc1.rpy:486
translate brazil ch5sc1_b8acc091:

#   lu "Thank you... Thank you so much for trying to help my mom."
    lu "Obrigada... Muito obrigada por tentar ajudar minha mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:487
translate brazil ch5sc1_f79efb28:

#   mc "Speaking of... you said you needed me for something?"
    mc "Por falar nisso... você disse que precisava de mim para alguma coisa?"

# game/chapters/chapter5/script/ch5sc1.rpy:490
translate brazil ch5sc1_a8477f33:

#   "Luna reluctantly lets you out of her grasp and sits beside you again."
    "Luna, com relutância, solta você de seu abraço e senta-se ao seu lado novamente."

# game/chapters/chapter5/script/ch5sc1.rpy:492
translate brazil ch5sc1_b999c5ca:

#   lu "{b}OK!{/b}"
    lu "{b}OK!{/b}"

# game/chapters/chapter5/script/ch5sc1.rpy:493
translate brazil ch5sc1_6e45a272:

#   lu "So what I need you for is a simple spell."
    lu "Então, preciso de você para um feitiço simples."

# game/chapters/chapter5/script/ch5sc1.rpy:495
translate brazil ch5sc1_7bfb30c1:

#   lu "Alice and I have been trying to locate the mage who cast the hex on my mom."
    lu "Alice e eu temos tentado localizar o mago que lançou a maldição sobre minha mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:496
translate brazil ch5sc1_f95130f1:

#   lu "Normally a simple locator spell would suffice, but it seems he’s been expecting that-"
    lu "Normalmente, um feitiço de localização simples seria suficiente, mas parece que ele já esperava por isso."

# game/chapters/chapter5/script/ch5sc1.rpy:498
translate brazil ch5sc1_96b71698:

#   lu "He's managed to conceal his presence... most likely with an obscurro incantation."
    lu "Ele conseguiu ocultar sua presença... muito provavelmente com um encantamento obscuro."

# game/chapters/chapter5/script/ch5sc1.rpy:499
translate brazil ch5sc1_50046737:

#   lu "I’ve tried channeling Alice because I wasn’t strong enough to break through on my own..."
    lu "Tentei canalizar Alice porque não era forte o suficiente para romper sozinha..."

# game/chapters/chapter5/script/ch5sc1.rpy:501
translate brazil ch5sc1_87626b71:

#   mc "You’ve been channeling Alice? How does that work?"
    mc "Você tem se inspirado na Alice? Como isso funciona?"

# game/chapters/chapter5/script/ch5sc1.rpy:503
translate brazil ch5sc1_8eb9312a:

#   lu "Basically I link our essences, and that allows me to draw on her magic too."
    lu "Basicamente, eu conecto nossas essências, e isso me permite também usar a magia dela."

# game/chapters/chapter5/script/ch5sc1.rpy:505
translate brazil ch5sc1_ad6abdc4:

#   mc "Magic? Alice doesn’t have any magic..."
    mc "Magia? Alice não tem magia nenhuma..."

# game/chapters/chapter5/script/ch5sc1.rpy:507
translate brazil ch5sc1_44a2093c:

#   lu "Everyone does. Every living being has magic within them."
    lu "Todos têm. Todo ser vivo possui magia dentro de si."

# game/chapters/chapter5/script/ch5sc1.rpy:508
translate brazil ch5sc1_0db66909:

#   lu "Humans, elves, dwarves, goblins, slimes, griffons, dragons, vampires, anything really."
    lu "Humanos, elfos, anões, goblins, slimes, grifos, dragões, vampiros, qualquer coisa, na verdade."

# game/chapters/chapter5/script/ch5sc1.rpy:509
translate brazil ch5sc1_3bf6a0a6:

#   lu "It’s just that most people can't harness it or control it."
    lu "É que a maioria das pessoas não consegue dominá-la ou controlá-la."

# game/chapters/chapter5/script/ch5sc1.rpy:511
translate brazil ch5sc1_a9e65c2b:

#   mct "Hmm. I do recall Oren telling me something similar once."
    mct "Hum. Lembro-me de Oren ter me dito algo parecido uma vez."

# game/chapters/chapter5/script/ch5sc1.rpy:512
translate brazil ch5sc1_4a1a7953:

#   mct "It explains why I'm able to absorb the essences of all beings."
    mct "Isso explica por que sou capaz de absorver a essência de todos os seres."

# game/chapters/chapter5/script/ch5sc1.rpy:513
translate brazil ch5sc1_71bc5af6:

#   mct "I just never really thought about it..."
    mct "Eu simplesmente nunca tinha pensado nisso..."

# game/chapters/chapter5/script/ch5sc1.rpy:515
translate brazil ch5sc1_2abc0248:

#   lu "My mother told me that only about one percent of the population are able to access their magic, wield it like a mage does."
    lu "Minha mãe me disse que apenas cerca de um por cento da população é capaz de acessar sua magia e usá-la como um mago."

# game/chapters/chapter5/script/ch5sc1.rpy:516
translate brazil ch5sc1_ebe95c7b:

#   lu "So it’s not really that common."
    lu "Portanto, não é algo muito comum."

# game/chapters/chapter5/script/ch5sc1.rpy:518
translate brazil ch5sc1_72abee74:

#   mc "I’m assuming that channeling Alice didn’t work?"
    mc "Presumo que canalizar Alice não tenha funcionado?"

# game/chapters/chapter5/script/ch5sc1.rpy:519
translate brazil ch5sc1_562b8c70:

#   mc "Otherwise you wouldn’t need me..."
    mc "Caso contrário, você não precisaria de mim..."

# game/chapters/chapter5/script/ch5sc1.rpy:521
translate brazil ch5sc1_0f29900b:

#   lu "Correct... Alice’s magic is too weak."
    lu "Correto... a magia de Alice é muito fraca."

# game/chapters/chapter5/script/ch5sc1.rpy:522
translate brazil ch5sc1_7408f835:

#   lu "Even with her help, I still couldn’t trace the mage."
    lu "Mesmo com a ajuda dela, ainda não consegui rastrear o mago."

# game/chapters/chapter5/script/ch5sc1.rpy:524
translate brazil ch5sc1_2aab9153:

#   mc "So... you want to channel me?"
    mc "Então... você quer me canalizar?"

# game/chapters/chapter5/script/ch5sc1.rpy:526
translate brazil ch5sc1_0083e7fb:

#   lu "Uh-Huh!"
    lu "Uhum!"

# game/chapters/chapter5/script/ch5sc1.rpy:527
translate brazil ch5sc1_4e5fe8f8:

#   lu "It’s our best shot at breaking through his Obscurro incantation."
    lu "É a nossa melhor chance de decifrar o seu encantamento Obscurro."

# game/chapters/chapter5/script/ch5sc1.rpy:529
translate brazil ch5sc1_5ab143e3:

#   mc "Okay, but as you know, my magic isn’t what you’re used to."
    mc "Certo, mas como você sabe, minha magia não é como você está acostumado."

# game/chapters/chapter5/script/ch5sc1.rpy:530
translate brazil ch5sc1_3a79de7d:

#   mc "You might find it hard to control... assuming you don’t immediately pass out."
    mc "Você pode achar difícil controlar... isso se você não desmaiar imediatamente."

# game/chapters/chapter5/script/ch5sc1.rpy:532
translate brazil ch5sc1_9bb90016:

#   lu "*Snickers* Challenge accepted! You do remember I’m the heir to the Mages Guild, right?"
    lu "*Risos* Desafio aceito! Você se lembra que eu sou o herdeiro da Guilda dos Magos, não é?"

# game/chapters/chapter5/script/ch5sc1.rpy:533
translate brazil ch5sc1_30a6bb10:

#   mc "*Chuckles* That may be so... but I haven’t seen you in action yet."
    mc "*Risos* Pode ser... mas ainda não te vi em ação."

# game/chapters/chapter5/script/ch5sc1.rpy:535
translate brazil ch5sc1_6370b708:

#   mc "Being the child of a powerful sorceress doesn’t mean you are also good."
    mc "Ser filho de uma feiticeira poderosa não significa que você também seja bom."

# game/chapters/chapter5/script/ch5sc1.rpy:537
translate brazil ch5sc1_df2c71ac:

#   lu "Not easily satisfied, are you?"
    lu "Você não se contenta facilmente, não é?"

# game/chapters/chapter5/script/ch5sc1.rpy:538
translate brazil ch5sc1_d2f643fe:

#   lu "Hmh. Guess I’ll have to aim to impress then. Come."
    lu "Hum. Acho que terei que me esforçar para impressionar então. Vamos lá."

# game/chapters/chapter5/script/ch5sc1.rpy:540
translate brazil ch5sc1_c3521315:

#   lu "Stand in the middle of the circle... and lose your shirt."
    lu "Fique no meio do círculo... e tire a camisa."

# game/chapters/chapter5/script/ch5sc1.rpy:542
translate brazil ch5sc1_86965e4f:

#   mc "You could at least buy me dinner first."
    mc "Você podia ao menos me pagar um jantar primeiro."

# game/chapters/chapter5/script/ch5sc1.rpy:543
translate brazil ch5sc1_850b5d1e:

#   lu "*Scoffs lightly*"
    lu "*Risos discretos*"

# game/chapters/chapter5/script/ch5sc1.rpy:545
translate brazil ch5sc1_a19658af:

#   lu "Mh-Hm... Is that what you want?"
    lu "Hum... É isso que você quer?"

# game/chapters/chapter5/script/ch5sc1.rpy:546
translate brazil ch5sc1_49e1e16f:

#   lu "For me to go on a date with you?"
    lu "Para eu sair em um encontro com você?"

# game/chapters/chapter5/script/ch5sc1.rpy:551
translate brazil ch5sc1_27414081:

#   mc "A date with the beautiful and talented heir to the Mages Guild?"
    mc "Um encontro com a bela e talentosa herdeira da Guilda dos Magos?"

# game/chapters/chapter5/script/ch5sc1.rpy:552
translate brazil ch5sc1_11105664:

#   mc "I’d consider myself lucky."
    mc "Eu me consideraria uma pessoa de sorte."

# game/chapters/chapter5/script/ch5sc1.rpy:554
translate brazil ch5sc1_546b6c8a:

#   lu "Didn’t you just question my abilities a few moments ago?"
    lu "Você não questionou minhas habilidades há poucos instantes?"

# game/chapters/chapter5/script/ch5sc1.rpy:556
translate brazil ch5sc1_c43137ff:

#   mc "It feels like a lifetime ago."
    mc "Parece que foi há uma eternidade."

# game/chapters/chapter5/script/ch5sc1.rpy:558
translate brazil ch5sc1_ff081007:

#   lu "*Giggling* Good to know that your faith in me has been restored..."
    lu "*Risos* Que bom saber que sua fé em mim foi restaurada..."

# game/chapters/chapter5/script/ch5sc1.rpy:559
translate brazil ch5sc1_6cdc8eee:

#   lu "And that you think I’m beautiful."
    lu "E que você acha que eu sou bonita."

# game/chapters/chapter5/script/ch5sc1.rpy:561
translate brazil ch5sc1_7ce1c4c3:

#   "Luna enjoyed your flirting, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Luna gostou da sua paquera, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc1.rpy:562
translate brazil ch5sc1_3889debb:

#   lu "Now take off your shirt, loverboy. I’ll be with you in a moment."
    lu "Agora tire a camisa, meu amor. Já volto."

# game/chapters/chapter5/script/ch5sc1.rpy:564
translate brazil ch5sc1_9cb651e4:

#   "You remove your shirt and place yourself in the middle of the circle."
    "Você tira a camisa e se posiciona no centro do círculo."

# game/chapters/chapter5/script/ch5sc1.rpy:568
translate brazil ch5sc1_f4933610:

#   mc "I don’t have the time to be going out on dates... Not until-"
    mc "Não tenho tempo para sair em encontros... Não até que..."

# game/chapters/chapter5/script/ch5sc1.rpy:570
translate brazil ch5sc1_7d08a235:

#   lu "Not until we defeat that bastard."
    lu "Só depois de derrotarmos aquele desgraçado."

# game/chapters/chapter5/script/ch5sc1.rpy:572
translate brazil ch5sc1_cf1adef2:

#   mc "Yeah."
    mc "Sim."

# game/chapters/chapter5/script/ch5sc1.rpy:574
translate brazil ch5sc1_02fb8db7:

#   lu "Okay."
    lu "OK."

# game/chapters/chapter5/script/ch5sc1.rpy:575
translate brazil ch5sc1_150f268c:

#   lu "But I’ll still need you to take your shirt off and stand in the circle."
    lu "Mas ainda precisarei que você tire a camisa e fique em pé no círculo."

# game/chapters/chapter5/script/ch5sc1.rpy:582
translate brazil ch5sc1_1aee64f8:

#   mc "Is this how you want me?"
    mc "É assim que você me quer?"

# game/chapters/chapter5/script/ch5sc1.rpy:583
translate brazil ch5sc1_f12de18f:

#   lu "That... will suffice."
    lu "Isso... será suficiente."

# game/chapters/chapter5/script/ch5sc1.rpy:584
translate brazil ch5sc1_c60b7388:

#   "She eyes you up and down, clearly curious about your physique."
    "Ela te olha de cima a baixo, claramente curiosa sobre seu físico."

# game/chapters/chapter5/script/ch5sc1.rpy:586
translate brazil ch5sc1_da01f04c:

#   lu "Try not to move. And if the pain becomes too much, I implore you to refrain from screaming."
    lu "Tente não se mexer. E se a dor ficar insuportável, peço que não grite."

# game/chapters/chapter5/script/ch5sc1.rpy:587
translate brazil ch5sc1_fe96ca5b:

#   mc "I can handle it."
    mc "Eu consigo lidar com isso."

# game/chapters/chapter5/script/ch5sc1.rpy:588
translate brazil ch5sc1_36866fb7:

#   mc "Wait... Didn’t you say you did this with Alice? If you caused her to suffer-"
    mc "Espere... Você não disse que fez isso com a Alice? Se você a fez sofrer..."

# game/chapters/chapter5/script/ch5sc1.rpy:590
translate brazil ch5sc1_dfeb531d:

#   lu "*Snickers* Gotcha!"
    lu "*Risos* Te peguei!"

# game/chapters/chapter5/script/ch5sc1.rpy:591
translate brazil ch5sc1_f689a07a:

#   lu "You should see your face!"
    lu "Você devia ver a sua cara!"

# game/chapters/chapter5/script/ch5sc1.rpy:592
translate brazil ch5sc1_056a20ed:

#   lu "From overly confident, to confused, to worried, then to protective in just a few moments..."
    lu "De excessivamente confiante a confuso, depois a preocupado e, por fim, a protetor em apenas alguns instantes..."

# game/chapters/chapter5/script/ch5sc1.rpy:594
translate brazil ch5sc1_f398afac:

#   mc "*Relieved sigh* So you didn’t hurt Alice?"
    mc "*Suspiro de alívio* Então você não machucou a Alice?"

# game/chapters/chapter5/script/ch5sc1.rpy:596
translate brazil ch5sc1_fc2cf150:

#   lu "Of course I didn't!"
    lu "É claro que não!"

# game/chapters/chapter5/script/ch5sc1.rpy:597
translate brazil ch5sc1_8c18a2e4:

#   lu "I wouldn’t hurt her, you silly goose! She’s my only-... best friend."
    lu "Eu jamais a machucaria, seu bobinho! Ela é minha única... melhor amiga."

# game/chapters/chapter5/script/ch5sc1.rpy:599
translate brazil ch5sc1_babd8f87:

#   mc "In the future... I’d appreciate it if you refrain from joking about hurting my friends."
    mc "No futuro... eu agradeceria se você evitasse fazer piadas sobre magoar meus amigos."

# game/chapters/chapter5/script/ch5sc1.rpy:600
translate brazil ch5sc1_0a7954bc:

#   mc "I just told you about my parents... But my friends haven’t been unaffected either."
    mc "Acabei de falar sobre meus pais... Mas meus amigos também não ficaram imunes."

# game/chapters/chapter5/script/ch5sc1.rpy:602
translate brazil ch5sc1_2febef0b:

#   lu "[mc]... I know-... I’m sorr-"
    lu "[mc]... Eu sei... Me desculpe..."

# game/chapters/chapter5/script/ch5sc1.rpy:604
translate brazil ch5sc1_f0c4a044:

#   mc "It’s fine. Let’s just get this over with."
    mc "Está tudo bem. Vamos acabar logo com isso."

# game/chapters/chapter5/script/ch5sc1.rpy:607
translate brazil ch5sc1_7f595d9c:

#   lu "I’m sorry. It was distasteful to joke about that."
    lu "Sinto muito. Foi de mau gosto fazer piada disso."

# game/chapters/chapter5/script/ch5sc1.rpy:609
translate brazil ch5sc1_3dff8b51:

#   lu "I do that sometimes... whenever I’m nervous or uncomfortable..."
    lu "Às vezes faço isso... sempre que estou nervoso ou desconfortável..."

# game/chapters/chapter5/script/ch5sc1.rpy:610
translate brazil ch5sc1_6b14862f:

#   lu "I try to make light of a situation..."
    lu "Tento encarar a situação com leveza..."

# game/chapters/chapter5/script/ch5sc1.rpy:613
translate brazil ch5sc1_4c31abdf:

#   "She stops a few feet from you, visibly ashamed of herself."
    "Ela para a poucos metros de você, visivelmente envergonhada."

# game/chapters/chapter5/script/ch5sc1.rpy:614
translate brazil ch5sc1_8af24218:

#   mct "She looks so defeated... I almost feel bad for telling her off."
    mct "Ela parece tão derrotada... Quase me sinto mal por repreendê-la."

# game/chapters/chapter5/script/ch5sc1.rpy:615
translate brazil ch5sc1_54185a62:

#   mct "She said Alice is her only friend. She must be alone a lot of the time."
    mct "Ela disse que Alice é sua única amiga. Ela deve ficar sozinha na maior parte do tempo."

# game/chapters/chapter5/script/ch5sc1.rpy:618
translate brazil ch5sc1_31a83f1f:

#   mc "Sorry I snapped at you."
    mc "Desculpe por ter sido grosseiro com você."

# game/chapters/chapter5/script/ch5sc1.rpy:619
translate brazil ch5sc1_411ea17e:

#   mc "I don’t have the best temper when it comes to stuff like that."
    mc "Não tenho o melhor temperamento para lidar com essas coisas."

# game/chapters/chapter5/script/ch5sc1.rpy:621
translate brazil ch5sc1_13b83ce0:

#   "A subtle smile appears on Luna’s face."
    "Um sorriso discreto surge no rosto de Luna."

# game/chapters/chapter5/script/ch5sc1.rpy:623
translate brazil ch5sc1_05c62a99:

#   lu "It’s okay... I was out of line."
    lu "Tudo bem... eu exagerei."

# game/chapters/chapter5/script/ch5sc1.rpy:624
translate brazil ch5sc1_bb09277e:

#   lu "Try not to move while I’m channeling."
    lu "Tente não se mexer enquanto eu estiver canalizando."

# game/chapters/chapter5/script/ch5sc1.rpy:626
translate brazil ch5sc1_292d3067:

#   lu "If you feel any discomfort let me know, okay?"
    lu "Se você sentir algum desconforto, me avise, ok?"

# game/chapters/chapter5/script/ch5sc1.rpy:628
translate brazil ch5sc1_8b94a709:

#   mc "I feel very comfortable."
    mc "Eu me sinto muito confortável."

# game/chapters/chapter5/script/ch5sc1.rpy:630
translate brazil ch5sc1_6bbf8f71:

#   lu "Me too. You’re astonishingly warm."
    lu "Eu também. Você é incrivelmente carinhoso(a)."

# game/chapters/chapter5/script/ch5sc1.rpy:632
translate brazil ch5sc1_cbd17090:

#   mc "I get that a lot... I’ve been this way ever since I can remember."
    mc "Isso acontece muito comigo... Sou assim desde que me lembro."

# game/chapters/chapter5/script/ch5sc1.rpy:633
translate brazil ch5sc1_97ba9d4c:

#   mc "It’s been handy at times during winter when I’ve had to sleep outside."
    mc "Tem sido útil em alguns momentos durante o inverno, quando precisei dormir ao relento."

# game/chapters/chapter5/script/ch5sc1.rpy:635
translate brazil ch5sc1_003ca6f9:

#   lu "*Mumbles quietly* {size=-10}{b}My bed wouldn’t be cold if you were in it...{/b}{/size}"
    lu "*Murmura baixinho* {size=-10}{b}Minha cama não estaria fria se você estivesse nela...{/b}{/size}"

# game/chapters/chapter5/script/ch5sc1.rpy:637
translate brazil ch5sc1_6046db3b:

#   mc "Huh? Did you say something?"
    mc "Hein? Você disse alguma coisa?"

# game/chapters/chapter5/script/ch5sc1.rpy:641
translate brazil ch5sc1_d06d4319:

#   lu "Your chest... firm... powerful heartbeats throbbing inside it."
    lu "Seu peito... firme... batidas fortes do coração pulsando dentro dele."

# game/chapters/chapter5/script/ch5sc1.rpy:643
translate brazil ch5sc1_a384b35e:

#   lu "I can easily sense your magic... flowing all through your body..."
    lu "Consigo sentir facilmente a sua magia... fluindo por todo o seu corpo..."

# game/chapters/chapter5/script/ch5sc1.rpy:644
translate brazil ch5sc1_e8f09aa1:

#   lu "It’s... incredible. I’m not sure how you can contain it all."
    lu "É... incrível. Não sei como você consegue conter tudo isso."

# game/chapters/chapter5/script/ch5sc1.rpy:646
translate brazil ch5sc1_348fe46d:

#   lu "Even the strongest mage would burst wide open from that..."
    lu "Até mesmo o mago mais poderoso se abriria completamente com isso..."

# game/chapters/chapter5/script/ch5sc1.rpy:647
translate brazil ch5sc1_878543a6:

#   lu "But here you are... right in front of me. Clearly containing it like it’s just a regular Wednesday."
    lu "Mas aqui está você... bem na minha frente. Claramente lidando com isso como se fosse uma quarta-feira qualquer."

# game/chapters/chapter5/script/ch5sc1.rpy:649
translate brazil ch5sc1_f8ddb858:

#   lu "Just... what are you?"
    lu "Afinal... o que você é?"

# game/chapters/chapter5/script/ch5sc1.rpy:651
translate brazil ch5sc1_bdcf5589:

#   mc "I’ll... tell you after we’ve rescued your mom."
    mc "Eu te conto depois que resgatarmos sua mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:653
translate brazil ch5sc1_c69fc510:

#   lut "A week ago I didn’t know him... except from Alice’s stories."
    lut "Há uma semana eu não o conhecia... exceto pelas histórias da Alice."

# game/chapters/chapter5/script/ch5sc1.rpy:654
translate brazil ch5sc1_122763f4:

#   lut "And now I can’t imagine what I'd do without him."
    lut "E agora não consigo imaginar o que faria sem ele."

# game/chapters/chapter5/script/ch5sc1.rpy:655
translate brazil ch5sc1_94cbc3b1:

#   lut "He’s making it possible... to save Mother."
    lut "Ele está tornando isso possível... para salvar a Mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:657
translate brazil ch5sc1_05fa3055:

#   lu "Okay. Let’s begin!"
    lu "Certo. Vamos começar!"

# game/chapters/chapter5/script/ch5sc1.rpy:659
translate brazil ch5sc1_8a75511d:

#   "She takes a step towards you, placing both of her delicate hands on your chest."
    "Ela dá um passo em sua direção, colocando ambas as mãos delicadas em seu peito."

# game/chapters/chapter5/script/ch5sc1.rpy:660
translate brazil ch5sc1_5c62fc8c:

#   "As she traces her fingertips across your skin, you feel your magic respond..."
    "Enquanto ela desliza os dedos pela sua pele, você sente sua magia reagir..."

# game/chapters/chapter5/script/ch5sc1.rpy:661
translate brazil ch5sc1_068878b6:

#   "Surprisingly, the reaction is calm... not chaotic and volatile like usual."
    "Surpreendentemente, a reação é calma... não caótica e volátil como de costume."

# game/chapters/chapter5/script/ch5sc1.rpy:662
translate brazil ch5sc1_ff551f29:

#   mct "She’s... able to calm me? How?"
    mct "Ela... consegue me acalmar? Como?"

# game/chapters/chapter5/script/ch5sc1.rpy:663
translate brazil ch5sc1_8793a3f2:

#   mct "Can my body sense that she has no ill intentions?"
    mct "Será que meu corpo consegue sentir que ela não tem más intenções?"

# game/chapters/chapter5/script/ch5sc1.rpy:665
translate brazil ch5sc1_4d2e2bc9:

#   lut "I’m going to channel him now... I’ve never done this with a man before."
    lut "Vou canalizar as energias dele agora... Nunca fiz isso com um homem antes."

# game/chapters/chapter5/script/ch5sc1.rpy:666
translate brazil ch5sc1_74baaa7b:

#   lut "It’s an... intimate thing for mages and witches..."
    lut "É algo... íntimo para magos e bruxas..."

# game/chapters/chapter5/script/ch5sc1.rpy:668
translate brazil ch5sc1_f9cdc107:

#   lut "Sharing your magical essence with someone else... It’s a sign of enormous trust."
    lut "Compartilhar sua essência mágica com outra pessoa... É um sinal de enorme confiança."

# game/chapters/chapter5/script/ch5sc1.rpy:669
translate brazil ch5sc1_68615470:

#   lut "A connection that nobody else understands."
    lut "Uma conexão que ninguém mais entende."

# game/chapters/chapter5/script/ch5sc1.rpy:670
translate brazil ch5sc1_123788e3:

#   lut "[mc]... I-... Thank you."
    lut "[mc]... Eu... Obrigada."

# game/chapters/chapter5/script/ch5sc1.rpy:671
translate brazil ch5sc1_ebfad2eb:

#   "She spends a few minutes silently channeling you, then your combined magic takes effect."
    "Ela passa alguns minutos canalizando você em silêncio, e então a magia combinada de vocês entra em ação."

# game/chapters/chapter5/script/ch5sc1.rpy:675
translate brazil ch5sc1_ea0278a1:

#   lut "Incredible... I... I feel him."
    lut "Incrível... Eu... Eu o sinto."

# game/chapters/chapter5/script/ch5sc1.rpy:676
translate brazil ch5sc1_bd5d7939:

#   mct "Woah... I can feel every emotion within her, I..."
    mct "Uau... consigo sentir todas as emoções dela, eu..."

# game/chapters/chapter5/script/ch5sc1.rpy:678
translate brazil ch5sc1_9400bda2:

#   "A woman appears in both of your minds."
    "Uma mulher surge na mente de ambos."

# game/chapters/chapter5/script/ch5sc1.rpy:681
translate brazil ch5sc1_04b4d56f:

#   lu "No... It-It can’t be."
    lu "Não... Não pode ser."

# game/chapters/chapter5/script/ch5sc1.rpy:684
translate brazil ch5sc1_ede844a4:

#   mc "Luna, who is that woman?"
    mc "Luna, quem é aquela mulher?"

# game/chapters/chapter5/script/ch5sc1.rpy:687
translate brazil ch5sc1_1e5c6190:

#   lu "It’s... She-..."
    lu "É... Ela..."

# game/chapters/chapter5/script/ch5sc1.rpy:690
translate brazil ch5sc1_7df46f6a:

#   lu "Rose... The Mages Guild’s second-in-command."
    lu "Rose... a segunda em comando da Guilda dos Magos."

# game/chapters/chapter5/script/ch5sc1.rpy:691
translate brazil ch5sc1_9727caed:

#   lu "My mothers closest ally and friend."
    lu "A aliada e amiga mais próxima da minha mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:694
translate brazil ch5sc1_377a2b17:

#   mc "Why would someone like that be involved in hexing your mother?"
    mc "Por que alguém assim se envolveria em amaldiçoar sua mãe?"

# game/chapters/chapter5/script/ch5sc1.rpy:695
translate brazil ch5sc1_bbe8c547:

#   lu "It... It can’t be... I’ve known her my entire life."
    lu "Não... Não pode ser... Eu a conheço desde que nasci."

# game/chapters/chapter5/script/ch5sc1.rpy:698
translate brazil ch5sc1_81058b1a:

#   lu "She’s watched over me countless times when Mother had important guild business."
    lu "Ela cuidou de mim inúmeras vezes quando minha mãe tinha assuntos importantes da guilda."

# game/chapters/chapter5/script/ch5sc1.rpy:699
translate brazil ch5sc1_73ed4bb9:

#   lu "Why... would she do this??"
    lu "Por que... ela faria isso??"

# game/chapters/chapter5/script/ch5sc1.rpy:701
translate brazil ch5sc1_58270ec5:

#   mc "Are you certain the hex comes from her?"
    mc "Tem certeza de que a maldição vem dela?"

# game/chapters/chapter5/script/ch5sc1.rpy:702
translate brazil ch5sc1_eabb5666:

#   lu "There’s no mistaking it. With the power from your magic, the locator spell is working with pinpoint accuracy."
    lu "Não há como se enganar. Com o poder da sua magia, o feitiço de localização está funcionando com precisão cirúrgica."

# game/chapters/chapter5/script/ch5sc1.rpy:704
translate brazil ch5sc1_62362666:

#   lu "Rose is the one who hexed my mom."
    lu "Foi Rose quem enfeitiçou minha mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:705
translate brazil ch5sc1_e66046e8:

#   lu "How could she betray us like this? I don’t... I don’t understand!"
    lu "Como ela pôde nos trair assim? Eu não... eu não entendo!"

# game/chapters/chapter5/script/ch5sc1.rpy:707
translate brazil ch5sc1_0efe6703:

#   mc "Let's not jump to conclusions. We can’t know for certain until we find her..."
    mc "Não vamos tirar conclusões precipitadas. Não podemos ter certeza até encontrá-la..."

# game/chapters/chapter5/script/ch5sc1.rpy:708
translate brazil ch5sc1_91cf9e71:

#   mc "You said she was second only to your mother in the Mages Guild?"
    mc "Você disse que ela era a segunda pessoa mais importante da Guilda dos Magos, perdendo apenas para sua mãe?"

# game/chapters/chapter5/script/ch5sc1.rpy:710
translate brazil ch5sc1_4a15b2df:

#   mc "It could be that she wanted to get out from under your mother's shadow."
    mc "Pode ser que ela quisesse sair da sombra da sua mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:711
translate brazil ch5sc1_bc7a338b:

#   mc "Getting rid of your mother would allow her to become the next guildmaster."
    mc "Livrar-se de sua mãe permitiria que ela se tornasse a próxima mestra da guilda."

# game/chapters/chapter5/script/ch5sc1.rpy:713
translate brazil ch5sc1_17d501a6:

#   mc "Or it could be that Taron has something on her..."
    mc "Ou talvez Taron tenha algo contra ela..."

# game/chapters/chapter5/script/ch5sc1.rpy:714
translate brazil ch5sc1_a220c886:

#   mc "Something precious to her that he is using to get what he wants."
    mc "Algo precioso para ela que ele está usando para conseguir o que quer."

# game/chapters/chapter5/script/ch5sc1.rpy:718
translate brazil ch5sc1_521e04f1:

#   lu "*Groans* Ahhh!"
    lu "*Gemidos* Ahhh!"

# game/chapters/chapter5/script/ch5sc1.rpy:719
translate brazil ch5sc1_874c94b8:

#   lu "Ishai, Ittu, Deto, Mur!"
    lu "Ishai, Ittu, Deto, Mur!"

# game/chapters/chapter5/script/ch5sc1.rpy:721
translate brazil ch5sc1_e3ffedc7:

#   "Luna snaps the two of you out of the channeling, the ambiance in the room returns to normal."
    "Luna tira vocês dois do transe de canalização, e o ambiente no quarto volta ao normal."

# game/chapters/chapter5/script/ch5sc1.rpy:725
translate brazil ch5sc1_ebe1df03:

#   mc "What was that? It felt like she was looking right at us?"
    mc "O que foi aquilo? Parecia que ela estava olhando diretamente para nós."

# game/chapters/chapter5/script/ch5sc1.rpy:729
translate brazil ch5sc1_1d21e261:

#   lu "She detected us."
    lu "Ela nos detectou."

# game/chapters/chapter5/script/ch5sc1.rpy:730
translate brazil ch5sc1_6e42f7fa:

#   lu "She won’t know who was locating her, but she definitely felt our presence."
    lu "Ela não saberá quem a estava localizando, mas certamente sentiu nossa presença."

# game/chapters/chapter5/script/ch5sc1.rpy:732
translate brazil ch5sc1_661227a8:

#   mc "She will be expecting us then."
    mc "Ela estará nos esperando então."

# game/chapters/chapter5/script/ch5sc1.rpy:734
translate brazil ch5sc1_f83a4cfb:

#   lu "I still can’t believe she is actually behind this..."
    lu "Ainda não consigo acreditar que ela esteja realmente por trás disso..."

# game/chapters/chapter5/script/ch5sc1.rpy:735
translate brazil ch5sc1_fcf810c7:

#   lu "Someone I've known my whole life? She-... she was like family."
    lu "Alguém que conheço a vida toda? Ela... ela era como da família."

# game/chapters/chapter5/script/ch5sc1.rpy:736
translate brazil ch5sc1_40f1c5d8:

#   lu "I feel so... alone."
    lu "Eu me sinto tão... sozinha."

# game/chapters/chapter5/script/ch5sc1.rpy:738
translate brazil ch5sc1_db6c394f:

#   mc "Hey... come here."
    mc "Ei... venha cá."

# game/chapters/chapter5/script/ch5sc1.rpy:740
translate brazil ch5sc1_9aa5ad8a:

#   "She wraps her arms closely around you and you're able to feel her shaking slightly."
    "Ela te abraça forte e você consegue sentir o tremor leve em seu rosto."

# game/chapters/chapter5/script/ch5sc1.rpy:741
translate brazil ch5sc1_054c2f92:

#   mc "You’re not alone. I’ll help you figure this out."
    mc "Você não está sozinho(a). Eu vou te ajudar a resolver isso."

# game/chapters/chapter5/script/ch5sc1.rpy:742
translate brazil ch5sc1_d942c2e5:

#   lut "He’s being so kind to me..."
    lut "Ele está sendo tão gentil comigo..."

# game/chapters/chapter5/script/ch5sc1.rpy:744
translate brazil ch5sc1_94d64ed1:

#   lu "[mc]... I-... thank you. Rescuing my mom means everything to me..."
    lu "[mc]... Eu... obrigada. Resgatar minha mãe significa tudo para mim..."

# game/chapters/chapter5/script/ch5sc1.rpy:745
translate brazil ch5sc1_17fba859:

#   lu "It’s all I can think about."
    lu "É tudo em que consigo pensar."

# game/chapters/chapter5/script/ch5sc1.rpy:746
translate brazil ch5sc1_a50b33b8:

#   lu "I’ve felt so isolated... so alone these last couple of months."
    lu "Tenho me sentido tão isolada... tão sozinha nestes últimos meses."

# game/chapters/chapter5/script/ch5sc1.rpy:748
translate brazil ch5sc1_14f722b7:

#   lu "I’ve always been alone, I don’t have any siblings or friends..."
    lu "Sempre estive sozinha, não tenho irmãos nem amigos..."

# game/chapters/chapter5/script/ch5sc1.rpy:749
translate brazil ch5sc1_d76caec0:

#   lu "Every time I thought I'd made a friend in the past, it turned out they just wanted favors from my mom."
    lu "Todas as vezes que pensei ter feito um amigo no passado, descobri que ele só queria favores da minha mãe."

# game/chapters/chapter5/script/ch5sc1.rpy:751
translate brazil ch5sc1_9d9ae0ca:

#   lu "I managed to make friends with Alice all on my own and it’s been great, so so great!"
    lu "Consegui fazer amizade com a Alice sozinha e tem sido ótimo, muito, muito ótimo!"

# game/chapters/chapter5/script/ch5sc1.rpy:752
translate brazil ch5sc1_662c5d11:

#   lu "And now, you as well. You’re willing to risk yourself to help me get my mom back..."
    lu "E agora, você também. Você está disposto a se arriscar para me ajudar a recuperar minha mãe..."

# game/chapters/chapter5/script/ch5sc1.rpy:754
translate brazil ch5sc1_de350f2f:

#   mc "Hey... It’s the least I could do."
    mc "Ei... É o mínimo que eu podia fazer."

# game/chapters/chapter5/script/ch5sc1.rpy:755
translate brazil ch5sc1_2ae88787:

#   mc "Despite all that you’ve had to deal with, you still made friends with Alice."
    mc "Apesar de tudo o que você teve que enfrentar, você ainda fez amizade com Alice."

# game/chapters/chapter5/script/ch5sc1.rpy:756
translate brazil ch5sc1_10710bd4:

#   mc "You found it within yourself to give her a chance, and you clearly care about her. That means a lot to me."
    mc "Você teve a coragem de dar uma chance a ela e claramente se importa com ela. Isso significa muito para mim."

# game/chapters/chapter5/script/ch5sc1.rpy:758
translate brazil ch5sc1_0e80ee71:

#   lu "[mc]..."
    lu "[mc]..."

# game/chapters/chapter5/script/ch5sc1.rpy:759
translate brazil ch5sc1_f8068bcf:

#   mc "Don’t worry Luna. I’ll make sure we get your mom back... safe and sound."
    mc "Não se preocupe, Luna. Eu vou garantir que sua mãe volte... sã e salva."

# game/chapters/chapter5/script/ch5sc1.rpy:760
translate brazil ch5sc1_84016a67:

#   lu "I-... I don’t know what to say..."
    lu "Eu... eu não sei o que dizer..."

# game/chapters/chapter5/script/ch5sc1.rpy:762
translate brazil ch5sc1_51feb827:

#   mc "You don’t have to say a word. The way you’re hugging me right now-"
    mc "Você não precisa dizer uma palavra. O jeito que você está me abraçando agora..."

# game/chapters/chapter5/script/ch5sc1.rpy:763
translate brazil ch5sc1_d2fd5a37:

#   mc "Is telling me everything I need to know. We trust each other."
    mc "Está me dizendo tudo o que preciso saber. Nós confiamos um no outro."

# game/chapters/chapter5/script/ch5sc1.rpy:766
translate brazil ch5sc1_ee87e6f3:

#   mc "Oh?"
    mc "Oh?"

# game/chapters/chapter5/script/ch5sc1.rpy:768
translate brazil ch5sc1_81599845:

#   lu "*Mwaahh!*"
    lu "*Mwaahh!*"

# game/chapters/chapter5/script/ch5sc1.rpy:769
translate brazil ch5sc1_9f52ae70:

#   lu "Just a little thanks..."
    lu "Apenas um pequeno agradecimento..."

# game/chapters/chapter5/script/ch5sc1.rpy:770
translate brazil ch5sc1_8f20642f:

#   "Her lips lingers on your cheek for a few moments before she breaks it off."
    "Os lábios dela permanecem na sua bochecha por alguns instantes antes de ela se afastar."

# game/chapters/chapter5/script/ch5sc1.rpy:772
translate brazil ch5sc1_85670583:

#   mc "Where are you running off to?"
    mc "Para onde você está indo?"

# game/chapters/chapter5/script/ch5sc1.rpy:774
translate brazil ch5sc1_8c03b319:

#   lu "If you want more of that... you’ll have to take me on a proper date."
    lu "Se você quer mais disso... vai ter que me levar para um encontro de verdade."

# game/chapters/chapter5/script/ch5sc1.rpy:775
translate brazil ch5sc1_ae408e53:

#   lu "For now, I've gotta prepare some stuff and meet up with Alice."
    lu "Por agora, preciso preparar algumas coisas e encontrar-me com a Alice."

# game/chapters/chapter5/script/ch5sc1.rpy:777
translate brazil ch5sc1_fa5868ab:

#   lu "Meet me back here tomorrow? We can go see Rose together."
    lu "Podemos nos encontrar aqui amanhã? Podemos ir ver a Rose juntas."

# game/chapters/chapter5/script/ch5sc1.rpy:779
translate brazil ch5sc1_ac02e677:

#   mc "Sure, I’ll probably stop by around noon."
    mc "Claro, provavelmente darei uma passada por volta do meio-dia."

# game/chapters/chapter5/script/ch5sc1.rpy:781
translate brazil ch5sc1_319bc1ed:

#   lu "Great. See you tomorrow then... Loverboy."
    lu "Ótimo. Até amanhã então... Namoradinho."

# game/chapters/chapter5/script/ch5sc1.rpy:794
translate brazil ch5sc1_4304d94d:

#   mc "Hey, Dalen. Eliza said you had something for me?"
    mc "Ei, Dalen. A Eliza disse que você tinha algo para mim?"

# game/chapters/chapter5/script/ch5sc1.rpy:796
translate brazil ch5sc1_ca903660:

#   da "Oh, I’ve got something for you alright."
    da "Ah, tenho uma coisa para você, com certeza."

# game/chapters/chapter5/script/ch5sc1.rpy:797
translate brazil ch5sc1_cd161715:

#   mc "Is it about Eliza? Did you find something about her vampirism?"
    mc "Tem a ver com a Eliza? Você descobriu algo sobre o vampirismo dela?"

# game/chapters/chapter5/script/ch5sc1.rpy:798
translate brazil ch5sc1_b7588548:

#   da "No... Not yet. I’ve put word out to several of my acquaintances that I’m looking for info on vampires."
    da "Não... Ainda não. Já avisei a vários conhecidos que estou procurando informações sobre vampiros."

# game/chapters/chapter5/script/ch5sc1.rpy:799
translate brazil ch5sc1_dc0947c8:

#   da "But I'm afraid vampire history seems to be veiled in mystery. At least on Luxeron..."
    da "Mas receio que a história dos vampiros esteja envolta em mistério. Pelo menos em Luxeron..."

# game/chapters/chapter5/script/ch5sc1.rpy:801
translate brazil ch5sc1_a2d8bd2f:

#   mc "If it isn’t about Eliza, then why did she make it sound so important?"
    mc "Se não se trata de Eliza, por que ela fez parecer tão importante?"

# game/chapters/chapter5/script/ch5sc1.rpy:803
translate brazil ch5sc1_88a8921d:

#   da "We’ve just landed the biggest contract in the Guild’s history."
    da "Acabamos de fechar o maior contrato da história da Guilda."

# game/chapters/chapter5/script/ch5sc1.rpy:805
translate brazil ch5sc1_80fcc985:

#   mc "That big? I knew we were doing better... but this sounds major."
    mc "Tão grande assim? Eu sabia que estávamos melhorando... mas isso parece ser algo muito sério."

# game/chapters/chapter5/script/ch5sc1.rpy:807
translate brazil ch5sc1_7c53057d:

#   mc "What is the contract? Some sort of terrifying monster? A rare species of cave troll?"
    mc "Qual é o contrato? Algum tipo de monstro aterrorizante? Uma espécie rara de troll das cavernas?"

# game/chapters/chapter5/script/ch5sc1.rpy:808
translate brazil ch5sc1_f5188725:

#   mc "Wait... Don't tell me a dragon is terrorising a nearby village?!"
    mc "Espere... Não me diga que um dragão está aterrorizando uma vila próxima?!"

# game/chapters/chapter5/script/ch5sc1.rpy:809
translate brazil ch5sc1_bd8fe3e6:

#   mc "I've always wanted to see a dragon."
    mc "Sempre quis ver um dragão."

# game/chapters/chapter5/script/ch5sc1.rpy:811
translate brazil ch5sc1_9d21d1a8:

#   da "Well... sit down and I'll give you the details."
    da "Bem... sente-se e eu lhe darei os detalhes."

# game/chapters/chapter5/script/ch5sc1.rpy:817
translate brazil ch5sc1_838a450a:

#   "Distant shouting."
    "Gritos distantes."

# game/chapters/chapter5/script/ch5sc1.rpy:820
translate brazil ch5sc1_92d0b707:

#   am "{b}WHAT?!{/b} Daddy no!"
    am "{b}O QUE?!{/b} Papai, não!"

# game/chapters/chapter5/script/ch5sc1.rpy:821
translate brazil ch5sc1_cde10e3c:

#   am "Absolutely not!"
    am "De jeito nenhum!"

# game/chapters/chapter5/script/ch5sc1.rpy:823
translate brazil ch5sc1_1a37213f:

#   am "I don’t need a babysitter! I’m nineteen for heaven's sake!"
    am "Eu não preciso de babá! Eu tenho dezenove anos, pelo amor de Deus!"

# game/chapters/chapter5/script/ch5sc1.rpy:824
translate brazil ch5sc1_166e4763:

#   am "My 20th name day is coming up soon!"
    am "Meu aniversário de 20 anos está chegando!"

# game/chapters/chapter5/script/ch5sc1.rpy:826
translate brazil ch5sc1_1088d404:

#   bn "Darling... he's not a babysitter."
    bn "Querida... ele não é babá."

# game/chapters/chapter5/script/ch5sc1.rpy:827
translate brazil ch5sc1_42818be1:

#   bn "He's a bodyguard, your bodyguard."
    bn "Ele é um guarda-costas, seu guarda-costas."

# game/chapters/chapter5/script/ch5sc1.rpy:829
translate brazil ch5sc1_66ee4a29:

#   am "I don’t need that either! No!"
    am "Eu também não preciso disso! Não!"

# game/chapters/chapter5/script/ch5sc1.rpy:831
translate brazil ch5sc1_d5790a08:

#   am "You’re always trying to control my life!"
    am "Você está sempre tentando controlar minha vida!"

# game/chapters/chapter5/script/ch5sc1.rpy:832
translate brazil ch5sc1_1ba62bc0:

#   am "'Amelia, stay inside the castle' this... 'Amelia, don’t run around the city' that..."
    am "'Amélia, fique dentro do castelo' isto... 'Amélia, não corra pela cidade' aquilo..."

# game/chapters/chapter5/script/ch5sc1.rpy:834
translate brazil ch5sc1_6e96cdf9:

#   bn "Amelia... it’s for your own good."
    bn "Amélia... é para o seu próprio bem."

# game/chapters/chapter5/script/ch5sc1.rpy:835
translate brazil ch5sc1_fe65f3f8:

#   bn "You know full well that the neighbouring lords have been growing bolder."
    bn "Você sabe muito bem que os senhores vizinhos têm se tornado cada vez mais ousados."

# game/chapters/chapter5/script/ch5sc1.rpy:836
translate brazil ch5sc1_2a87d82d:

#   bn "How the kingdom is on the verge of civil-war, making you a prize target."
    bn "Como o reino está à beira de uma guerra civil, tornando você um alvo valioso."

# game/chapters/chapter5/script/ch5sc1.rpy:838
translate brazil ch5sc1_b7e787e3:

#   am "Nuh-Uh! I refuse to listen to that excuse one more time!"
    am "Não, não! Recuso-me a ouvir essa desculpa mais uma vez!"

# game/chapters/chapter5/script/ch5sc1.rpy:839
translate brazil ch5sc1_6bd6aed1:

#   am "I'm always going to be a 'target' because I'm your daughter!"
    am "Eu sempre serei um 'alvo' porque sou sua filha!"

# game/chapters/chapter5/script/ch5sc1.rpy:840
translate brazil ch5sc1_d5f56381:

#   am "But I'm old enough to experience things on my own! I can't live inside the castle my entire life!"
    am "Mas eu já tenho idade suficiente para vivenciar as coisas por conta própria! Não posso viver dentro do castelo a vida inteira!"

# game/chapters/chapter5/script/ch5sc1.rpy:842
translate brazil ch5sc1_0fd0b4fd:

#   bn "*Sigh* Well, since you’re so grown up..."
    bn "*Suspiro* Bem, já que você cresceu tanto..."

# game/chapters/chapter5/script/ch5sc1.rpy:843
translate brazil ch5sc1_58622519:

#   bn "The other nations have been pressuring us to select a suitable marriage candidate."
    bn "As outras nações têm nos pressionado para selecionarmos um(a) candidato(a) adequado(a) para o casamento."

# game/chapters/chapter5/script/ch5sc1.rpy:844
translate brazil ch5sc1_b8e51186:

#   bn "Since your mother and I haven’t been able to produce a male heir..."
    bn "Como sua mãe e eu não conseguimos gerar um herdeiro homem..."

# game/chapters/chapter5/script/ch5sc1.rpy:845
translate brazil ch5sc1_0af27fed:

#   bn "You'll have to marry a highborn son from one of the other four nations."
    bn "Você terá que se casar com um filho de linhagem nobre de uma das outras quatro nações."

# game/chapters/chapter5/script/ch5sc1.rpy:848
translate brazil ch5sc1_0d0b7918:

#   am "{b}WHAT?!{/b} You can’t be serious, Daddy! There’s no way I’ll agree to that!"
    am "{b}O QUE?!{/b} Papai, você não pode estar falando sério! De jeito nenhum vou concordar com isso!"

# game/chapters/chapter5/script/ch5sc1.rpy:849
translate brazil ch5sc1_7020720c:

#   am "You can't just use me as some sort of bargaining chip... for what?!"
    am "Você não pode simplesmente me usar como moeda de troca... para quê?!"

# game/chapters/chapter5/script/ch5sc1.rpy:851
translate brazil ch5sc1_32bc077b:

#   bn "For peace. If we can’t form a strong alliance with the other nations they'll look to overthrow us instead."
    bn "Pela paz. Se não conseguirmos formar uma aliança forte com as outras nações, elas tentarão nos derrubar."

# game/chapters/chapter5/script/ch5sc1.rpy:852
translate brazil ch5sc1_c31eb7eb:

#   bn "I’m not young anymore... They're pressuring me to see if I'll succumb to their demands."
    bn "Eu não sou mais jovem... Eles estão me pressionando para ver se eu vou ceder às exigências deles."

# game/chapters/chapter5/script/ch5sc1.rpy:854
translate brazil ch5sc1_1b819293:

#   am "What does this have to do with me needing a bodyguard?"
    am "O que isso tem a ver com eu precisar de um guarda-costas?"

# game/chapters/chapter5/script/ch5sc1.rpy:856
translate brazil ch5sc1_0c9a100b:

#   bn "I've been dragging my heels on this since your eighteenth nameday... and they're getting impatient."
    bn "Venho adiando isso desde o seu décimo oitavo aniversário... e eles estão ficando impacientes."

# game/chapters/chapter5/script/ch5sc1.rpy:857
translate brazil ch5sc1_8e1d1bad:

#   bn "We've intercepted an increasing number of foreign spies."
    bn "Interceptamos um número crescente de espiões estrangeiros."

# game/chapters/chapter5/script/ch5sc1.rpy:858
translate brazil ch5sc1_cf6986a6:

#   bn "Those we were able to interrogate all had the same objective... you."
    bn "Todos aqueles que conseguimos interrogar tinham o mesmo objetivo... você."

# game/chapters/chapter5/script/ch5sc1.rpy:860
translate brazil ch5sc1_7cbebde2:

#   am "Me? Why would spies be so interested in me?"
    am "Eu? Por que espiões teriam tanto interesse em mim?"

# game/chapters/chapter5/script/ch5sc1.rpy:862
translate brazil ch5sc1_da6b561e:

#   bn "As I just told you, sweetheart, you’re the only heir to Luxeron."
    bn "Como acabei de te dizer, querida, você é a única herdeira de Luxeron."

# game/chapters/chapter5/script/ch5sc1.rpy:863
translate brazil ch5sc1_72c03718:

#   bn "Which means you’re the key to ruling the five kingdoms of Midomir... At least without declaring an all-out war."
    bn "Isso significa que você é a chave para governar os cinco reinos de Midomir... Pelo menos sem declarar uma guerra total."

# game/chapters/chapter5/script/ch5sc1.rpy:864
translate brazil ch5sc1_0a060735:

#   bn "Which is why I have decided... *Sighs heavily*"
    bn "Por isso decidi... *Suspiros profundos*"

# game/chapters/chapter5/script/ch5sc1.rpy:865
translate brazil ch5sc1_33794281:

#   bn "On your 20th nameday we will be hosting an event where suitors from the other kingdoms will come to court you."
    bn "No seu 20º aniversário, realizaremos um evento onde pretendentes de outros reinos virão cortejá-la."

# game/chapters/chapter5/script/ch5sc1.rpy:866
translate brazil ch5sc1_ec6a062c:

#   bn "We'll also invite several noble houses from within Luxeron."
    bn "Também convidaremos diversas casas nobres de Luxeron."

# game/chapters/chapter5/script/ch5sc1.rpy:867
translate brazil ch5sc1_0bed27b2:

#   bn "There could be a potential match with one of them as well."
    bn "Também pode haver uma possível compatibilidade com um deles."

# game/chapters/chapter5/script/ch5sc1.rpy:870
translate brazil ch5sc1_c1489caa:

#   am "Absolutely not! Ugh! Daddy, you can't do this!"
    am "De jeito nenhum! Credo! Papai, você não pode fazer isso!"

# game/chapters/chapter5/script/ch5sc1.rpy:872
translate brazil ch5sc1_45453575:

#   bn "It’s already been put into motion. You will be able to choose an appropriate husband."
    bn "Já está em andamento. Você poderá escolher um marido adequado."

# game/chapters/chapter5/script/ch5sc1.rpy:873
translate brazil ch5sc1_17b4163f:

#   bn "It’s something every royal and noble family goes through. And now it’s your turn."
    bn "É algo pelo qual toda família real e nobre passa. E agora é a sua vez."

# game/chapters/chapter5/script/ch5sc1.rpy:874
translate brazil ch5sc1_063d698d:

#   bn "I know it feels unfair, but it is a burden we carry as the Royal family."
    bn "Sei que parece injusto, mas é um fardo que carregamos como família real."

# game/chapters/chapter5/script/ch5sc1.rpy:876
translate brazil ch5sc1_1020d7bd:

#   am "But... why can’t there be an alliance without marriage?"
    am "Mas... por que não pode haver uma aliança sem casamento?"

# game/chapters/chapter5/script/ch5sc1.rpy:877
translate brazil ch5sc1_1ed6c480:

#   am "Why do I have to be sold off like a piece of meat? The thought alone disgusts me!"
    am "Por que tenho que ser vendido como um pedaço de carne? Só de pensar nisso me dá nojo!"

# game/chapters/chapter5/script/ch5sc1.rpy:878
translate brazil ch5sc1_5e59e8a9:

#   am "I want to meet a proper man, fall in love the genuine way! Not become some object to a stranger!"
    am "Quero conhecer um homem de verdade, me apaixonar de verdade! Não quero me tornar um objeto para um estranho!"

# game/chapters/chapter5/script/ch5sc1.rpy:880
translate brazil ch5sc1_78e48761:

#   bn "I’m sorry, darling. Try to understand... If we fail to form an alliance and war breaks out..."
    bn "Sinto muito, querida. Tente entender... Se não conseguirmos formar uma aliança e a guerra começar..."

# game/chapters/chapter5/script/ch5sc1.rpy:881
translate brazil ch5sc1_ec84a65a:

#   bn "Thousands... if not tens of thousands, will die."
    bn "Milhares... senão dezenas de milhares, morrerão."

# game/chapters/chapter5/script/ch5sc1.rpy:882
translate brazil ch5sc1_1fa77f12:

#   bn "Is that a responsibility you want to take on?"
    bn "É uma responsabilidade que você deseja assumir?"

# game/chapters/chapter5/script/ch5sc1.rpy:884
translate brazil ch5sc1_3b9ce1bb:

#   am "Obviously I don't want war!"
    am "Obviamente eu não quero guerra!"

# game/chapters/chapter5/script/ch5sc1.rpy:885
translate brazil ch5sc1_1aa13e65:

#   am "I don’t want that at all. The stories you've told me are bad enough."
    am "Eu não quero isso de jeito nenhum. As histórias que você me contou já são ruins o suficiente."

# game/chapters/chapter5/script/ch5sc1.rpy:887
translate brazil ch5sc1_9d17ff71:

#   bn "Good. Then you understand why it’s paramount that you find a suitable husband to secure the realm."
    bn "Ótimo. Então você entende por que é fundamental encontrar um marido adequado para garantir a segurança do reino."

# game/chapters/chapter5/script/ch5sc1.rpy:890
translate brazil ch5sc1_e5ea818b:

#   mc "*Sigh* Really? I don’t think this is necessary..."
    mc "*Suspiro* Sério? Acho que isso não é necessário..."

# game/chapters/chapter5/script/ch5sc1.rpy:891
translate brazil ch5sc1_ad707128:

#   cbl "It will have to suffice. Scrub yourself clean, then we’ll make you presentable for His Majesty."
    cbl "Terá de servir. Esfregue-se bem e depois nós o deixaremos apresentável para Sua Majestade."

# game/chapters/chapter5/script/ch5sc1.rpy:892
translate brazil ch5sc1_5875a1bf:

#   mc "Fine..."
    mc "Multar..."

# game/chapters/chapter5/script/ch5sc1.rpy:898
translate brazil ch5sc1_5d397083:

#   mct "Hnngh... I can’t believe I let Dalen and Eliza talk me into this..."
    mct "Hnngh... Não acredito que deixei Dalen e Eliza me convencerem a fazer isso..."

# game/chapters/chapter5/script/ch5sc1.rpy:899
translate brazil ch5sc1_463cfd7b:

#   mct "‘High priority contract’ ... ‘Think of the guild’ ... ‘All the profit it will generate’ ..."
    mct "'Contrato de alta prioridade' ... 'Pense na guilda' ... 'Todo o lucro que isso vai gerar' ..."

# game/chapters/chapter5/script/ch5sc1.rpy:901
translate brazil ch5sc1_80a64e41:

#   mct "Easy for them to say... They aren’t the ones being pampered and forced to clean up..."
    mct "É fácil para eles dizerem... Não são eles que estão sendo mimados e obrigados a limpar..."

# game/chapters/chapter5/script/ch5sc1.rpy:902
translate brazil ch5sc1_f5c62047:

#   mct "The coin better be as ridiculous as Dalen suggested."
    mct "É melhor que a moeda seja tão ridícula quanto Dalen sugeriu."

# game/chapters/chapter5/script/ch5sc1.rpy:903
translate brazil ch5sc1_0e48fdaa:

#   mct "I guess having a member of the guild being employed by the Royal family is quite the reputation boost."
    mct "Imagino que ter um membro da guilda empregado pela família real seja um grande impulso para a reputação."

# game/chapters/chapter5/script/ch5sc1.rpy:904
translate brazil ch5sc1_45f1fb0e:

#   "You hear the door creak open and to your surprise it’s not the chamberlain from earlier."
    "Você ouve a porta ranger ao abrir e, para sua surpresa, não é o camareiro de antes."

# game/chapters/chapter5/script/ch5sc1.rpy:906
translate brazil ch5sc1_046102b1:

#   md2 "..."
    md2 "..."

# game/chapters/chapter5/script/ch5sc1.rpy:908
translate brazil ch5sc1_aa22b690:

#   mct "She looks timid..."
    mct "Ela parece tímida..."

# game/chapters/chapter5/script/ch5sc1.rpy:909
translate brazil ch5sc1_b574f7e1:

#   mct "She probably wants to be here just about as much as myself..."
    mct "Ela provavelmente quer estar aqui tanto quanto eu..."

# game/chapters/chapter5/script/ch5sc1.rpy:910
translate brazil ch5sc1_596773f3:

#   mc "State your business."
    mc "Descreva seu negócio."

# game/chapters/chapter5/script/ch5sc1.rpy:912
translate brazil ch5sc1_6ceeeedb:

#   md2 "Oh... Uh... I’m here to bring you a towel..."
    md2 "Ah... Hum... Vim trazer uma toalha para você..."

# game/chapters/chapter5/script/ch5sc1.rpy:914
translate brazil ch5sc1_a99372be:

#   mc "And here I thought you were sent by his majesty to wash my back."
    mc "E eu que pensava que você tinha sido enviado por Sua Majestade para lavar minhas costas."

# game/chapters/chapter5/script/ch5sc1.rpy:916
translate brazil ch5sc1_fb4a1c6a:

#   md2 "*Stuttering* W-What? ... N-No! H-He wouldn’t ask such a thing!"
    md2 "*Gaguejando* O-O quê? ... N-Não! E-Ele não perguntaria uma coisa dessas!"

# game/chapters/chapter5/script/ch5sc1.rpy:917
translate brazil ch5sc1_b413d631:

#   md2 "*Stuttering* I... I’m Amelia’s p-personal handmaiden!"
    md2 "*Gaguejando* Eu... eu sou a dama de companhia p-pessoal da Amelia!"

# game/chapters/chapter5/script/ch5sc1.rpy:919
translate brazil ch5sc1_a0a6a574:

#   mc "You can relax... I was merely jesting."
    mc "Pode ficar tranquilo... Eu estava apenas brincando."

# game/chapters/chapter5/script/ch5sc1.rpy:921
translate brazil ch5sc1_785df164:

#   md2 "Y-You shouldn’t joke about such matters..."
    md2 "Você não deveria brincar com essas coisas..."

# game/chapters/chapter5/script/ch5sc1.rpy:923
translate brazil ch5sc1_cf038292:

#   mc "*Chuckles* Right, you can leave the towel on the stool and I'll be done shortly."
    mc "*Risos* Certo, pode deixar a toalha no banquinho e já termino."

# game/chapters/chapter5/script/ch5sc1.rpy:926
translate brazil ch5sc1_f2227846:

#   mct "Not gonna lie, it felt great to get cleaned up. The water is even heated."
    mct "Para ser sincera, foi ótimo tomar um banho. A água é até aquecida."

# game/chapters/chapter5/script/ch5sc1.rpy:928
translate brazil ch5sc1_2f2518b0:

#   cbl "Hmm. This must suffice."
    cbl "Hum. Isso deve ser suficiente."

# game/chapters/chapter5/script/ch5sc1.rpy:930
translate brazil ch5sc1_18d31726:

#   mc "Think Bennen cares if I’m clean?"
    mc "Será que o Bennen se importa se eu estou limpo?"

# game/chapters/chapter5/script/ch5sc1.rpy:932
translate brazil ch5sc1_fc090523:

#   cbl "The gentleman will refer to His Imperial Majesty by his full title, or not at all."
    cbl "O cavalheiro se referirá a Sua Majestade Imperial por seu título completo, ou não o usará de forma alguma."

# game/chapters/chapter5/script/ch5sc1.rpy:933
translate brazil ch5sc1_8143fcc7:

#   mct "This guy is so full of himself..."
    mct "Esse cara é muito convencido..."

# game/chapters/chapter5/script/ch5sc1.rpy:934
translate brazil ch5sc1_cf70d176:

#   cbl "If the gentleman will be seated, the shaving and trim will commence shortly."
    cbl "Se o senhor se sentar, o barbear e o corte de cabelo começarão em breve."

# game/chapters/chapter5/script/ch5sc1.rpy:936
translate brazil ch5sc1_d7b9356c:

#   mc "The what now? You’re not cutting my hair."
    mc "O quê? Você não vai cortar meu cabelo."

# game/chapters/chapter5/script/ch5sc1.rpy:938
translate brazil ch5sc1_bbe3869b:

#   cbl "No. Not me, obviously. One of our handmaidens will... *Raised voice* You can enter now."
    cbl "Não. Obviamente não eu. Uma de nossas damas de companhia irá... *Em tom de voz mais alto* Pode entrar agora."

# game/chapters/chapter5/script/ch5sc1.rpy:940
translate brazil ch5sc1_772bcb03:

#   "You sit down in protest and the girl from earlier enters the room."
    "Você se senta em sinal de protesto e a garota de antes entra na sala."

# game/chapters/chapter5/script/ch5sc1.rpy:941
translate brazil ch5sc1_107e13db:

#   cbl "Please see to it that the gentleman is groomed and ready for an audience with His Excellency."
    cbl "Por favor, certifique-se de que o cavalheiro esteja bem arrumado e pronto para uma audiência com Sua Excelência."

# game/chapters/chapter5/script/ch5sc1.rpy:943
translate brazil ch5sc1_ddda4892:

#   "The chamberlain leaves the room and the timid maiden approaches you nervously."
    "O camareiro sai da sala e a jovem tímida se aproxima de você nervosamente."

# game/chapters/chapter5/script/ch5sc1.rpy:945
translate brazil ch5sc1_dce71291:

#   md2 "P-Please... hold still."
    md2 "P-Por favor... fique parado."

# game/chapters/chapter5/script/ch5sc1.rpy:947
translate brazil ch5sc1_e8e968fc:

#   mc "You don’t have to do this. I’m fine the way I am."
    mc "Você não precisa fazer isso. Estou bem do jeito que sou."

# game/chapters/chapter5/script/ch5sc1.rpy:949
translate brazil ch5sc1_459d43d3:

#   md2 "N-No. I... I have to. Otherwise-..."
    md2 "N-Não. Eu... eu preciso. Senão..."

# game/chapters/chapter5/script/ch5sc1.rpy:950
translate brazil ch5sc1_ad8b609c:

#   "The girl manages to stop herself mid sentence."
    "A garota consegue se interromper no meio da frase."

# game/chapters/chapter5/script/ch5sc1.rpy:951
translate brazil ch5sc1_468975d7:

#   md2 "Please... let me do this."
    md2 "Por favor... deixe-me fazer isso."

# game/chapters/chapter5/script/ch5sc1.rpy:952
translate brazil ch5sc1_5d34a533:

#   mct "Sounds like she’s scared of getting into trouble. They are probably pretty strict with the staff."
    mct "Parece que ela tem medo de se meter em encrenca. Provavelmente eles são bem rigorosos com os funcionários."

# game/chapters/chapter5/script/ch5sc1.rpy:953
translate brazil ch5sc1_0456e2b9:

#   mct "She seems sweet... There’s no reason to cause her any trouble."
    mct "Ela parece ser uma pessoa doce... Não há motivo para lhe causar problemas."

# game/chapters/chapter5/script/ch5sc1.rpy:955
translate brazil ch5sc1_c2ffacc1:

#   mc "Okay. But just trim the edges alright? I like my hair the way it is."
    mc "Certo. Mas só apare as pontas, tá bom? Eu gosto do meu cabelo assim."

# game/chapters/chapter5/script/ch5sc1.rpy:957
translate brazil ch5sc1_70243eb5:

#   md2 "Okay! T-Thank you!"
    md2 "Ok! O-Obrigado!"

# game/chapters/chapter5/script/ch5sc1.rpy:958
translate brazil ch5sc1_556a6932:

#   "Her delicate hand guides your chin upwards."
    "Sua mão delicada guia seu queixo para cima."

# game/chapters/chapter5/script/ch5sc1.rpy:960
translate brazil ch5sc1_eaff501d:

#   mc "Sorry if my joke earlier made you uncomfortable."
    mc "Desculpe se minha piada anterior te deixou desconfortável."

# game/chapters/chapter5/script/ch5sc1.rpy:963
translate brazil ch5sc1_b44ee7f4:

#   md2 "It’s okay... It just caught me by surprise."
    md2 "Tudo bem... Só me pegou de surpresa."

# game/chapters/chapter5/script/ch5sc1.rpy:964
translate brazil ch5sc1_d8612c58:

#   md2 "I’m not used to jokes like that..."
    md2 "Não estou acostumado com piadas desse tipo..."

# game/chapters/chapter5/script/ch5sc1.rpy:965
translate brazil ch5sc1_66a783ee:

#   md2 "Usually when men make such comments at me... they’re being serious."
    md2 "Normalmente, quando os homens fazem comentários desse tipo para mim... eles estão falando sério."

# game/chapters/chapter5/script/ch5sc1.rpy:967
translate brazil ch5sc1_9ae6b216:

#   mc "You have to endure those comments often?"
    mc "Você tem que aguentar esses comentários com frequência?"

# game/chapters/chapter5/script/ch5sc1.rpy:968
translate brazil ch5sc1_255daff8:

#   "The girl nods."
    "A garota acena com a cabeça."

# game/chapters/chapter5/script/ch5sc1.rpy:970
translate brazil ch5sc1_9ed97abc:

#   md2 "Luckily, I was picked to be Princess Amelia's personal handmaiden before I came of age."
    md2 "Por sorte, fui escolhida para ser a dama de companhia pessoal da Princesa Amelia antes de atingir a maioridade."

# game/chapters/chapter5/script/ch5sc1.rpy:971
translate brazil ch5sc1_9463bb57:

#   md2 "Now I’m off limits to men."
    md2 "Agora estou fora dos limites para os homens."

# game/chapters/chapter5/script/ch5sc1.rpy:972
translate brazil ch5sc1_be7ea39b:

#   md2 "Even nobles and their... comments and desires."
    md2 "Até mesmo os nobres e seus... comentários e desejos."

# game/chapters/chapter5/script/ch5sc1.rpy:974
translate brazil ch5sc1_e7dd8341:

#   mc "Good..."
    mc "Bom..."

# game/chapters/chapter5/script/ch5sc1.rpy:975
translate brazil ch5sc1_7fbc8012:

#   mc "I can only imagine how bad it must be to be surrounded by rich entitled assholes."
    mc "Só consigo imaginar o quão ruim deve ser estar cercado por riquinhos arrogantes e prepotentes."

# game/chapters/chapter5/script/ch5sc1.rpy:978
translate brazil ch5sc1_e4b2ce45:

#   md2 "*Laughs* Oh my! I’m not supposed to laugh at such vulgar language!"
    md2 "*Risos* Nossa! Não devia rir de uma linguagem tão vulgar!"

# game/chapters/chapter5/script/ch5sc1.rpy:980
translate brazil ch5sc1_33cea6f8:

#   mc "Your secret is safe with me."
    mc "Seu segredo está a salvo comigo."

# game/chapters/chapter5/script/ch5sc1.rpy:981
translate brazil ch5sc1_2015588c:

#   mc "It’s not like I owe these presumptuous pricks anything."
    mc "Não é como se eu devesse alguma coisa a esses idiotas presunçosos."

# game/chapters/chapter5/script/ch5sc1.rpy:983
translate brazil ch5sc1_4da6c60a:

#   md2 "*Laughs* S-Stop! I’ll get in trouble!"
    md2 "*Risos* P-Pare! Vou me meter em encrenca!"

# game/chapters/chapter5/script/ch5sc1.rpy:986
translate brazil ch5sc1_fa4779d2:

#   mct "She has a cute smile."
    mct "Ela tem um sorriso encantador."

# game/chapters/chapter5/script/ch5sc1.rpy:988
translate brazil ch5sc1_3d96c27a:

#   fr "I’m Frida."
    fr "Eu sou Frida."

# game/chapters/chapter5/script/ch5sc1.rpy:990
translate brazil ch5sc1_d4e07393:

#   mc "[mc]. Pleasure to meet you, Frida."
    mc "[mc] Prazer em conhecê-la, Frida."

# game/chapters/chapter5/script/ch5sc1.rpy:991
translate brazil ch5sc1_6b4c6c79:

#   fr "*Nods*"
    fr "*Acena com a cabeça*"

# game/chapters/chapter5/script/ch5sc1.rpy:993
translate brazil ch5sc1_5949a58d:

#   fr "Okay! All done!"
    fr "Ok! Tudo pronto!"

# game/chapters/chapter5/script/ch5sc1.rpy:995
translate brazil ch5sc1_f79e8041:

#   mc "Oh? You’re quick. How do I look?"
    mc "Ah? Você é rápido(a). Como estou?"

# game/chapters/chapter5/script/ch5sc1.rpy:997
translate brazil ch5sc1_cba9de27:

#   fr "Beautiful..."
    fr "Lindo..."

# game/chapters/chapter5/script/ch5sc1.rpy:1000
translate brazil ch5sc1_abd6558d:

#   fr "I-... I mean presentable!"
    fr "Eu... quero dizer, apresentável!"

# game/chapters/chapter5/script/ch5sc1.rpy:1002
translate brazil ch5sc1_8771ae0e:

#   mc "Beautiful, huh? I’ll take it."
    mc "Lindo, né? Eu quero."

# game/chapters/chapter5/script/ch5sc1.rpy:1004
translate brazil ch5sc1_1217334f:

#   fr "*Laughs* You’re trouble!"
    fr "*Risos* Você é uma encrenqueira!"

# game/chapters/chapter5/script/ch5sc1.rpy:1005
translate brazil ch5sc1_f6472114:

#   mct "That tattoo she has, I've seen similar ones back in the Sen'ju region, is she from there?"
    mct "Essa tatuagem que ela tem, eu já vi algumas parecidas na região de Sen'ju, será que ela é de lá?"

# game/chapters/chapter5/script/ch5sc1.rpy:1007
translate brazil ch5sc1_aa1868c4:

#   cbl "How are we doing in here?"
    cbl "Como estamos nos saindo por aqui?"

# game/chapters/chapter5/script/ch5sc1.rpy:1008
translate brazil ch5sc1_a1836f38:

#   cbl "If you’ve got time to fool around, I'll assume the gentleman is ready."
    cbl "Se você tem tempo para brincar, presumo que o cavalheiro esteja pronto."

# game/chapters/chapter5/script/ch5sc1.rpy:1009
translate brazil ch5sc1_23bb9082:

#   cbl "Now leave and return to your duties."
    cbl "Agora, saia e retorne às suas funções."

# game/chapters/chapter5/script/ch5sc1.rpy:1011
translate brazil ch5sc1_760f4992:

#   fr "S-Sorry..."
    fr "D-Desculpe..."

# game/chapters/chapter5/script/ch5sc1.rpy:1012
translate brazil ch5sc1_c059849d:

#   "The girl returns to her timid self and leaves the room."
    "A menina volta a ser tímida e sai da sala."

# game/chapters/chapter5/script/ch5sc1.rpy:1014
translate brazil ch5sc1_a831ea96:

#   mct "Frida... Hmh."
    mct "Frida… Hmh."

# game/chapters/chapter5/script/ch5sc1.rpy:1015
translate brazil ch5sc1_0e303948:

#   mct "She was starting to feel comfortable, but as soon as this asshole entered..."
    mct "Ela estava começando a se sentir confortável, mas assim que aquele idiota entrou..."

# game/chapters/chapter5/script/ch5sc1.rpy:1016
translate brazil ch5sc1_65d0036c:

#   mct "She went straight back to being timid."
    mct "Ela voltou imediatamente a ser tímida."

# game/chapters/chapter5/script/ch5sc1.rpy:1017
translate brazil ch5sc1_08b6ecbd:

#   mc "Was that really necessary? She’s not a puppet."
    mc "Isso era mesmo necessário? Ela não é uma marionete."

# game/chapters/chapter5/script/ch5sc1.rpy:1019
translate brazil ch5sc1_77242ec5:

#   cbl "Commoners- Ugh."
    cbl "Plebeus - Credo."

# game/chapters/chapter5/script/ch5sc1.rpy:1020
translate brazil ch5sc1_b2e67dc9:

#   cbl "We can bathe you, shave you and clothe you, but teaching you manners..."
    cbl "Podemos dar-lhe banho, barbear-lhe e vesti-lo, mas ensinar-lhe boas maneiras..."

# game/chapters/chapter5/script/ch5sc1.rpy:1021
translate brazil ch5sc1_acb10e35:

#   cbl "That is the real challenge."
    cbl "Esse é o verdadeiro desafio."

# game/chapters/chapter5/script/ch5sc1.rpy:1023
translate brazil ch5sc1_35e42ae6:

#   mc "You’re a real peach to be around, you know that?"
    mc "Você é uma pessoa muito agradável, sabia?"

# game/chapters/chapter5/script/ch5sc1.rpy:1025
translate brazil ch5sc1_ad40bc6c:

#   cbl "*Sigh* The gentleman may now dress."
    cbl "*Suspiro* O cavalheiro agora pode se vestir."

# game/chapters/chapter5/script/ch5sc1.rpy:1026
translate brazil ch5sc1_436d8923:

#   cbl "Sadly, I wasn’t able to get your exact measurements."
    cbl "Infelizmente, não consegui obter suas medidas exatas."

# game/chapters/chapter5/script/ch5sc1.rpy:1027
translate brazil ch5sc1_48849ad2:

#   cbl "If the garments chafe, our tailor will adjust them."
    cbl "Se as roupas causarem atrito, nosso alfaiate fará os ajustes necessários."

# game/chapters/chapter5/script/ch5sc1.rpy:1029
translate brazil ch5sc1_12f2fea7:

#   mc "My measurements?"
    mc "Minhas medidas?"

# game/chapters/chapter5/script/ch5sc1.rpy:1032
translate brazil ch5sc1_5eba639f:

#   mc "Where are my clothes?!"
    mc "Onde estão minhas roupas?!"

# game/chapters/chapter5/script/ch5sc1.rpy:1034
translate brazil ch5sc1_861cf559:

#   cbl "Where they should have gone long ago: to the laundress."
    cbl "Para onde deveriam ter ido há muito tempo: para a lavadeira."

# game/chapters/chapter5/script/ch5sc1.rpy:1035
translate brazil ch5sc1_581d8268:

#   cbl "Fret not. They will be returned to you after the audience, clean and starched."
    cbl "Não se preocupe. Elas serão devolvidas a você após a audiência, limpas e engomadas."

# game/chapters/chapter5/script/ch5sc1.rpy:1037
translate brazil ch5sc1_be4e21c7:

#   mc "You’re kidding... right?"
    mc "Você está brincando... né?"

# game/chapters/chapter5/script/ch5sc1.rpy:1039
translate brazil ch5sc1_58580353:

#   cbl "This is no time for jests."
    cbl "Não é hora para brincadeiras."

# game/chapters/chapter5/script/ch5sc1.rpy:1040
translate brazil ch5sc1_a5fbfcbb:

#   cbl "The gentleman will approach me once he has dressed himself."
    cbl "O senhor se aproximará de mim assim que estiver vestido."

# game/chapters/chapter5/script/ch5sc1.rpy:1042
translate brazil ch5sc1_7ecc6bb4:

#   mct "At least they picked black... *Sigh* Let’s get this over with."
    mct "Pelo menos escolheram preto... *Suspiro* Vamos acabar logo com isso."

# game/chapters/chapter5/script/ch5sc1.rpy:1044
translate brazil ch5sc1_d6efd8aa:

#   mct "This is ridiculous... I look like a damn peacock."
    mct "Isso é ridículo... Eu pareço um pavão."

# game/chapters/chapter5/script/ch5sc1.rpy:1045
translate brazil ch5sc1_e544b2bb:

#   mct "Is this really how nobles dress? ... Suddenly being poor doesn’t seem so bad."
    mct "É assim mesmo que os nobres se vestem? ... De repente, ser pobre não parece tão ruim."

# game/chapters/chapter5/script/ch5sc1.rpy:1047
translate brazil ch5sc1_2f18d49f:

#   cbl "Ah. Black suits the gentleman."
    cbl "Ah. O preto fica bem em cavalheiro."

# game/chapters/chapter5/script/ch5sc1.rpy:1048
translate brazil ch5sc1_8d5e6f7e:

#   cbl "Does the outfit satisfy the gentleman?"
    cbl "O traje agrada ao cavalheiro?"

# game/chapters/chapter5/script/ch5sc1.rpy:1050
translate brazil ch5sc1_a678ff66:

#   mc "My own flexible, tried and tested clothes are what would satisfy me. I’m stiff as a board in these..."
    mc "Minhas próprias roupas, flexíveis e testadas, são o que me satisfariam. Nessas..."

# game/chapters/chapter5/script/ch5sc1.rpy:1052
translate brazil ch5sc1_9f55d970:

#   cbl "If the gentleman isn’t pleased, I could fetch him another outfit?"
    cbl "Se o cavalheiro não estiver satisfeito, posso buscar outra roupa para ele?"

# game/chapters/chapter5/script/ch5sc1.rpy:1054
translate brazil ch5sc1_576f4d09:

#   mc "It’s fine... I doubt it would be any better..."
    mc "Está bom... Duvido que pudesse estar melhor..."

# game/chapters/chapter5/script/ch5sc1.rpy:1055
translate brazil ch5sc1_289abc7a:

#   mc "So what now? Powder my nose?"
    mc "E agora? Vou retocar a maquiagem?"

# game/chapters/chapter5/script/ch5sc1.rpy:1057
translate brazil ch5sc1_dacc44d1:

#   cbl "No need. The gentleman’s complexion is light enough."
    cbl "Não precisa. A tez do cavalheiro já é clara o suficiente."

# game/chapters/chapter5/script/ch5sc1.rpy:1058
translate brazil ch5sc1_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter5/script/ch5sc1.rpy:1060
translate brazil ch5sc1_073aecaf:

#   mc "Great. So can we go see Benn- His Majesty now?"
    mc "Ótimo. Então podemos ir ver Benn, Sua Majestade, agora?"

# game/chapters/chapter5/script/ch5sc1.rpy:1062
translate brazil ch5sc1_0b6f9a5d:

#   cbl "Not quite... The gentleman is to stand before the King of Luxeron, Lord Protector of the Realms..."
    cbl "Não exatamente... O cavalheiro deve comparecer perante o Rei de Luxeron, Lorde Protetor dos Reinos..."

# game/chapters/chapter5/script/ch5sc1.rpy:1064
translate brazil ch5sc1_0df74625:

#   cbl "I must confirm that he knows how to bow when meeting His Excellency."
    cbl "Devo confirmar que ele sabe como se curvar ao encontrar Sua Excelência."

# game/chapters/chapter5/script/ch5sc1.rpy:1065
translate brazil ch5sc1_5aaed428:

#   mct "I’m going to kill Dalen..."
    mct "Vou matar Dalen..."

# game/chapters/chapter5/script/ch5sc1.rpy:1070
translate brazil ch5sc1_f6cd280c:

#   mc "Alright... *Sighs heavily*"
    mc "Certo... *Suspira profundamente*"

# game/chapters/chapter5/script/ch5sc1.rpy:1072
translate brazil ch5sc1_1f1cd854:

#   cbl "Please, demonstrate."
    cbl "Por favor, demonstre."

# game/chapters/chapter5/script/ch5sc1.rpy:1076
translate brazil ch5sc1_caaef253:

#   mc "I know how to bow... I’m not some boor you know?"
    mc "Eu sei como me curvar... Não sou nenhum grosseiro, sabe?"

# game/chapters/chapter5/script/ch5sc1.rpy:1078
translate brazil ch5sc1_e4406f79:

#   cbl "Nevertheless, a demonstration is in order before we proceed."
    cbl "No entanto, uma demonstração se faz necessária antes de prosseguirmos."

# game/chapters/chapter5/script/ch5sc1.rpy:1083
translate brazil ch5sc1_575639d1:

#   mc "Happy?"
    mc "Feliz?"

# game/chapters/chapter5/script/ch5sc1.rpy:1085
translate brazil ch5sc1_5ecf23e8:

#   cbl "That, sir, is how you might bow to a common whore on a street corner, not the King of Luxeron."
    cbl "Isso, senhor, é como se curvaria a uma prostituta qualquer na esquina, não ao Rei de Luxeron."

# game/chapters/chapter5/script/ch5sc1.rpy:1086
translate brazil ch5sc1_c65a734a:

#   mct "This fucking guy... He should consider himself lucky I’m not currently drowning him in the washtub."
    mct "Esse cara... Ele devia se considerar sortudo por eu não estar afogando ele na banheira agora."

# game/chapters/chapter5/script/ch5sc1.rpy:1087
translate brazil ch5sc1_366d1bdc:

#   mct "*Sigh* Probably won’t do the guild any favors if I kill a royal servant..."
    mct "*Suspiro* Provavelmente não farei nenhum favor à guilda se eu matar um servo real..."

# game/chapters/chapter5/script/ch5sc1.rpy:1088
translate brazil ch5sc1_d6d69c32:

#   cbl "It goes like this, left leg extended behind, right arm straight, hand flat, head down, chin to chest."
    cbl "A posição é a seguinte: perna esquerda estendida para trás, braço direito esticado, mão espalmada, cabeça baixa, queixo no peito."

# game/chapters/chapter5/script/ch5sc1.rpy:1092
translate brazil ch5sc1_cd57d390:

#   cbl "Hmm, lacking fluidity and grace. But we’ve learned to expect less from commoners."
    cbl "Hum, falta fluidez e graça. Mas aprendemos a esperar menos das pessoas comuns."

# game/chapters/chapter5/script/ch5sc1.rpy:1093
translate brazil ch5sc1_663f184d:

#   cbl "Good, good. Let’s proceed..."
    cbl "Ótimo, ótimo. Vamos prosseguir..."

# game/chapters/chapter5/script/ch5sc1.rpy:1095
translate brazil ch5sc1_64ce73d7:

#   cbl "If the gentleman will follow along."
    cbl "Se o cavalheiro concordar em acompanhar."

# game/chapters/chapter5/script/ch5sc1.rpy:1099
translate brazil ch5sc1_92443fcd:

#   cbl "The gentleman will address his majesty only when spoken to, using the appropriate title of course."
    cbl "O cavalheiro dirigirá a sua majestade apenas quando lhe dirigirem a palavra, utilizando, naturalmente, o título apropriado."

# game/chapters/chapter5/script/ch5sc1.rpy:1101
translate brazil ch5sc1_809aa909:

#   mc "What? His Archexellency? His Holy-Magnificency?"
    mc "O quê? Sua Excelência Suprema? Sua Santa Magnificência?"

# game/chapters/chapter5/script/ch5sc1.rpy:1102
translate brazil ch5sc1_c313d121:

#   cbl "Ah, I see the gentleman is in the mood for jests. I fear His Majesty might not share his disposition."
    cbl "Ah, vejo que o cavalheiro está com vontade de fazer piadas. Receio que Sua Majestade não compartilhe do mesmo humor."

# game/chapters/chapter5/script/ch5sc1.rpy:1104
translate brazil ch5sc1_585eb56b:

#   cbl "'Your Majesty' will suffice. Spoken loudly, clearly, and with respect."
    cbl "'Vossa Majestade' basta. Dito em voz alta, clara e com respeito."

# game/chapters/chapter5/script/ch5sc1.rpy:1105
translate brazil ch5sc1_ae6aa8da:

#   cbl "The gentleman may enter."
    cbl "O senhor pode entrar."

# game/chapters/chapter5/script/ch5sc1.rpy:1110
translate brazil ch5sc1_725b5bce:

#   am "{b}UUURH!{/b} I don’t need or want some lame bodyguard breathing down my neck!"
    am "{b}UUURH!{/b} Eu não preciso nem quero um guarda-costas incompetente respirando no meu cangote!"

# game/chapters/chapter5/script/ch5sc1.rpy:1111
translate brazil ch5sc1_fbb687a1:

#   am "You never understand me! Always trying to keep me in this boring castle!"
    am "Você nunca me entende! Sempre tentando me manter neste castelo tedioso!"

# game/chapters/chapter5/script/ch5sc1.rpy:1113
translate brazil ch5sc1_8edc6200:

#   bn "Sweetheart, we've discussed this at length. I’m doing it for your own good. Please see reason."
    bn "Querida, já conversamos bastante sobre isso. Estou fazendo isso para o seu próprio bem. Por favor, entenda a razão."

# game/chapters/chapter5/script/ch5sc1.rpy:1114
translate brazil ch5sc1_5683bcca:

#   bn "Besides I’ve already arranged for a bodyguard. He’s very capable, I'm told."
    bn "Além disso, já providenciei um guarda-costas. Me disseram que ele é muito competente."

# game/chapters/chapter5/script/ch5sc1.rpy:1115
translate brazil ch5sc1_feb0ce7d:

#   am "Ugh... Who is this bodyguard then? Probably some old guy..."
    am "Eca... Quem é esse guarda-costas então? Provavelmente algum senhor de idade..."

# game/chapters/chapter5/script/ch5sc1.rpy:1117
translate brazil ch5sc1_aba8270d:

#   bn "You can judge for yourself, here he is now."
    bn "Você pode julgar por si mesmo, aqui está ele agora."

# game/chapters/chapter5/script/ch5sc1.rpy:1119
translate brazil ch5sc1_34e15bb5:

#   amt "He looks familiar... Wait-"
    amt "Ele me parece familiar... Espere..."

# game/chapters/chapter5/script/ch5sc1.rpy:1121
translate brazil ch5sc1_dd4ab2d6:

#   amt "It’s the guy from this morning! The knucklehead who bumped into me!"
    amt "É o cara de hoje de manhã! O idiota que esbarrou em mim!"

# game/chapters/chapter5/script/ch5sc1.rpy:1123
translate brazil ch5sc1_84ff15ee:

#   amt "And he had the nerve to call me beautiful after helping me up..."
    amt "E ele ainda teve a audácia de me chamar de bonita depois de me ajudar a levantar..."

# game/chapters/chapter5/script/ch5sc1.rpy:1124
translate brazil ch5sc1_058c6ac4:

#   amt "Ugh! I hope he doesn't expect me to be happy about this!"
    amt "Ai! Espero que ele não espere que eu fique feliz com isso!"

# game/chapters/chapter5/script/ch5sc1.rpy:1127
translate brazil ch5sc1_d6b9c88f:

#   amt "What in the heavens is he doing here!? How is he going to be my bodyguard!?"
    amt "O que ele está fazendo aqui?! Como ele vai ser meu guarda-costas?!"

# game/chapters/chapter5/script/ch5sc1.rpy:1130
translate brazil ch5sc1_d00bae77:

#   mct "So that’s the king... And that’s-"
    mct "Então esse é o rei... E esse é-"

# game/chapters/chapter5/script/ch5sc1.rpy:1131
translate brazil ch5sc1_b6b437eb:

#   cbl "Approach. Don’t keep His Majesty waiting."
    cbl "Aproxime-se. Não faça Sua Majestade esperar."

# game/chapters/chapter5/script/ch5sc1.rpy:1133
translate brazil ch5sc1_83ffb1fa:

#   cbl "Stop at the stairs and bow as we rehearsed."
    cbl "Pare na escada e faça uma reverência, como ensaiamos."

# game/chapters/chapter5/script/ch5sc1.rpy:1135
translate brazil ch5sc1_122831f2:

#   mct "*Sigh* I can’t believe I’m doing this."
    mct "*Suspiro* Não acredito que estou fazendo isso."

# game/chapters/chapter5/script/ch5sc1.rpy:1137
translate brazil ch5sc1_41a8fcdf:

#   "You proceed to bow as instructed by the chamberlain."
    "Você então se curva conforme instruído pelo camareiro."

# game/chapters/chapter5/script/ch5sc1.rpy:1139
translate brazil ch5sc1_8723ce06:

#   "Both the king and the princess seem pleasantly surprised."
    "Tanto o rei quanto a princesa parecem agradavelmente surpresos."

# game/chapters/chapter5/script/ch5sc1.rpy:1140
translate brazil ch5sc1_35b5dd3a:

#   amt "He-... He's bowing?"
    amt "Ele... Ele está se curvando?"

# game/chapters/chapter5/script/ch5sc1.rpy:1142
translate brazil ch5sc1_d88d2717:

#   amt "He... knows how to bow properly?"
    amt "Ele... sabe como se curvar corretamente?"

# game/chapters/chapter5/script/ch5sc1.rpy:1144
translate brazil ch5sc1_d9d11f4d:

#   amt "Ugh! So what? Anyone can learn how to bow..."
    amt "E daí? Qualquer um pode aprender a fazer uma reverência..."

# game/chapters/chapter5/script/ch5sc1.rpy:1145
translate brazil ch5sc1_4d727bdb:

#   amt "In fact, the knucklehead should have bowed to me this morning instead of trampling on me in the market!"
    amt "Na verdade, aquele idiota deveria ter se curvado para mim esta manhã em vez de me atropelar no mercado!"

# game/chapters/chapter5/script/ch5sc1.rpy:1147
translate brazil ch5sc1_a2eb0e8d:

#   am "Don’t come near me, you oaf!"
    am "Não chegue perto de mim, seu idiota!"

# game/chapters/chapter5/script/ch5sc1.rpy:1148
translate brazil ch5sc1_a1f8a8ca:

#   am "If I see you again I'll call the guards on you."
    am "Se eu te vir de novo, vou chamar a guarda."

# game/chapters/chapter5/script/ch5sc1.rpy:1149
translate brazil ch5sc1_264dc3b5:

#   mct "Bitch..."
    mct "Cadela..."

# game/chapters/chapter5/script/ch5sc1.rpy:1151
translate brazil ch5sc1_acfbcf22:

#   bn "Please, excuse my daughter. She isn’t too fond of the idea of being assigned a bodyguard."
    bn "Por favor, desculpe minha filha. Ela não gosta muito da ideia de ter um guarda-costas."

# game/chapters/chapter5/script/ch5sc1.rpy:1152
translate brazil ch5sc1_8cc46576:

#   bn "Now, stand. Your back must be getting sore from holding that dreadful bow."
    bn "Agora, fique de pé. Suas costas devem estar doendo de tanto segurar esse arco horrível."

# game/chapters/chapter5/script/ch5sc1.rpy:1154
translate brazil ch5sc1_8872fdbf:

#   mc "Your Majesty."
    mc "Sua Majestade."

# game/chapters/chapter5/script/ch5sc1.rpy:1156
translate brazil ch5sc1_644443a3:

#   bn "*Chuckles* Hah! First a proper bow and now addressing me correctly? That’s unusual for a commoner."
    bn "*Risos* Hah! Primeiro uma reverência adequada e agora se dirigindo a mim corretamente? Isso é incomum para um plebeu."

# game/chapters/chapter5/script/ch5sc1.rpy:1157
translate brazil ch5sc1_34bcd4c0:

#   mc "I didn’t want to disappoint the chamberlain, we’re friends."
    mc "Eu não queria desapontar o camareiro, somos amigos."

# game/chapters/chapter5/script/ch5sc1.rpy:1158
translate brazil ch5sc1_1fb45d94:

#   bn "*Chuckles* Hah! Nobody's friends with the chamberlain, but I like your attitude."
    bn "*Risos* Hah! Ninguém é amigo do camareiro, mas eu gosto da sua atitude."

# game/chapters/chapter5/script/ch5sc1.rpy:1160
translate brazil ch5sc1_0625dda9:

#   mc "*Scoffs* Yeah... he doesn't seem too fond of me."
    mc "*Risos* É... ele não parece gostar muito de mim."

# game/chapters/chapter5/script/ch5sc1.rpy:1161
translate brazil ch5sc1_5a16bcdf:

#   mc "I take it you didn’t hire me to talk about social etiquette, though?"
    mc "Imagino que você não me contratou para falar sobre etiqueta social, certo?"

# game/chapters/chapter5/script/ch5sc1.rpy:1163
translate brazil ch5sc1_3efcdebd:

#   bn "My daughter... Amelia, she’s in danger."
    bn "Minha filha... Amélia, ela está em perigo."

# game/chapters/chapter5/script/ch5sc1.rpy:1164
translate brazil ch5sc1_d8fb8e53:

#   mc "I presume she's the one who just stormed off, hissing at me?"
    mc "Presumo que seja ela quem acabou de sair furiosa, resmungando para mim?"

# game/chapters/chapter5/script/ch5sc1.rpy:1166
translate brazil ch5sc1_6df2307a:

#   bn "*Chuckles* That'd be the one."
    bn "*Risos* Essa seria a ideal."

# game/chapters/chapter5/script/ch5sc1.rpy:1167
translate brazil ch5sc1_bf052902:

#   bn "I need you to keep an eye on her, protect her with your life if need be."
    bn "Preciso que você fique de olho nela, proteja-a com sua vida se necessário."

# game/chapters/chapter5/script/ch5sc1.rpy:1169
translate brazil ch5sc1_bd46093b:

#   mc "Why do you suspect that she's in danger?"
    mc "Por que você suspeita que ela esteja em perigo?"

# game/chapters/chapter5/script/ch5sc1.rpy:1170
translate brazil ch5sc1_a100299d:

#   mc "I’ll need details if I’m to guard her. I need to know what to be on the lookout for."
    mc "Preciso de detalhes para poder protegê-la. Preciso saber o que devo observar."

# game/chapters/chapter5/script/ch5sc1.rpy:1172
translate brazil ch5sc1_c9caea1a:

#   bn "*Sigh* I suppose you do need some information to go on."
    bn "*Suspiro* Imagino que você precise de algumas informações para prosseguir."

# game/chapters/chapter5/script/ch5sc1.rpy:1173
translate brazil ch5sc1_46d0589f:

#   bn "Come, we’ll discuss the matter further in my office."
    bn "Venha, discutiremos o assunto mais detalhadamente no meu escritório."

# game/chapters/chapter5/script/ch5sc1.rpy:1176
translate brazil ch5sc1_f9e6c056:

#   mct "That ring... It’s hard to tell from this distance but it’s definitely enchanted."
    mct "Aquele anel... É difícil dizer a esta distância, mas com certeza é encantado."

# game/chapters/chapter5/script/ch5sc1.rpy:1177
translate brazil ch5sc1_e0453bf2:

#   mct "Just like his daughter's."
    mct "Assim como a filha dele."

# game/chapters/chapter5/script/ch5sc1.rpy:1183
translate brazil ch5sc1_0c06b295:

#   bn "Before we begin, are you familiar with the Five Kingdoms that make up Midomir?"
    bn "Antes de começarmos, você conhece os Cinco Reinos que compõem Midomir?"

# game/chapters/chapter5/script/ch5sc1.rpy:1184
translate brazil ch5sc1_0e692d75:

#   mc "I’ve heard bits here and there, but I’ve never traveled beyond Luxeron, sir."
    mc "Ouvi falar disso aqui e ali, mas nunca viajei além de Luxeron, senhor."

# game/chapters/chapter5/script/ch5sc1.rpy:1185
translate brazil ch5sc1_9229ef10:

#   bn "I suspected as much. Most people never get to venture beyond the continent they are born on."
    bn "Eu já suspeitava disso. A maioria das pessoas nunca tem a oportunidade de se aventurar além do continente em que nasceu."

# game/chapters/chapter5/script/ch5sc1.rpy:1186
translate brazil ch5sc1_a88a1958:

#   bn "Here, take a look at this. It should help you visualize it as I explain."
    bn "Veja só isso. Deve ajudar você a visualizar enquanto explico."

# game/chapters/chapter5/script/ch5sc1.rpy:1191
translate brazil ch5sc1_6b469b3e:

#   mc "Interesting, I’ve never really seen a map this detailed."
    mc "Interessante, nunca tinha visto um mapa tão detalhado."

# game/chapters/chapter5/script/ch5sc1.rpy:1192
translate brazil ch5sc1_6534bdb6:

#   bn "I’ve had the best explorers travel the continents and write down what they’ve seen."
    bn "Já tive os melhores exploradores que viajaram pelos continentes e registraram o que viram."

# game/chapters/chapter5/script/ch5sc1.rpy:1193
translate brazil ch5sc1_f1cbdd56:

#   bn "There are still unexplored areas though, and many discoveries yet to be made."
    bn "Ainda existem áreas inexploradas e muitas descobertas por fazer."

# game/chapters/chapter5/script/ch5sc1.rpy:1194
translate brazil ch5sc1_0470ca04:

#   bn "As you can see, we have the five main kingdoms of Midomir."
    bn "Como podem ver, temos os cinco principais reinos de Midomir."

# game/chapters/chapter5/script/ch5sc1.rpy:1196
translate brazil ch5sc1_f11f05b3:

#   bn "First we have Luxeron. The continent we live on."
    bn "Primeiro temos Luxoron, o continente onde vivemos."

# game/chapters/chapter5/script/ch5sc1.rpy:1197
translate brazil ch5sc1_a7d25f38:

#   bn "It is the ruling kingdom and the seat of the High-King of Midomir."
    bn "É o reino governante e a sede do Alto Rei de Midomir."

# game/chapters/chapter5/script/ch5sc1.rpy:1198
translate brazil ch5sc1_88273ee1:

#   mc "High-King?"
    mc "Alto-Rei?"

# game/chapters/chapter5/script/ch5sc1.rpy:1199
translate brazil ch5sc1_595f9c07:

#   bn "Each continent has its own King or Queen ruling over it, but ever since the succession wars some 500 years ago-"
    bn "Cada continente tem seu próprio rei ou rainha governando-o, mas desde as guerras de sucessão, há cerca de 500 anos..."

# game/chapters/chapter5/script/ch5sc1.rpy:1200
translate brazil ch5sc1_db816b54:

#   bn "The five kingdoms elected a High-King who would be the protector of all the realms."
    bn "Os cinco reinos elegeram um Alto Rei que seria o protetor de todos os reinos."

# game/chapters/chapter5/script/ch5sc1.rpy:1201
translate brazil ch5sc1_96fe62b1:

#   bn "That duty befell my family, and has been passed down through my lineage to this day."
    bn "Essa responsabilidade recaiu sobre minha família e tem sido transmitida através da minha linhagem até os dias de hoje."

# game/chapters/chapter5/script/ch5sc1.rpy:1202
translate brazil ch5sc1_f8a83c3b:

#   bn "Now, as you can see, Luxeron is the largest kingdom and contains the most diversity."
    bn "Como podem ver, Luxeron é o maior reino e contém a maior diversidade."

# game/chapters/chapter5/script/ch5sc1.rpy:1203
translate brazil ch5sc1_44a17f15:

#   mc "Yeah, I come from a small village north of Luxenford. I don’t see it here, though."
    mc "Sim, venho de uma pequena vila ao norte de Luxemburgo. Mas não a vejo por aqui."

# game/chapters/chapter5/script/ch5sc1.rpy:1204
translate brazil ch5sc1_a6b0a99e:

#   bn "*Chuckles* Not every little detail is mapped, only points of significant value or interest."
    bn "*Risos* Nem todos os detalhes são mapeados, apenas os pontos de valor ou interesse significativos."

# game/chapters/chapter5/script/ch5sc1.rpy:1205
translate brazil ch5sc1_2b4e9b23:

#   bn "For a more detailed layout you'll have to visit the League of Explorers and inquire about more localized maps."
    bn "Para um mapa mais detalhado, você precisará visitar a Liga dos Exploradores e solicitar mapas mais localizados."

# game/chapters/chapter5/script/ch5sc1.rpy:1207
translate brazil ch5sc1_be7fe179:

#   bn "Now let’s turn our attention northwest, to the kingdom of Izentul."
    bn "Agora, voltemos nossa atenção para noroeste, para o reino de Izentul."

# game/chapters/chapter5/script/ch5sc1.rpy:1208
translate brazil ch5sc1_c7e91525:

#   bn "We haven’t explored it completely, as it's not a very hospitable environment to visit."
    bn "Não exploramos completamente o local, pois não é um ambiente muito acolhedor para visitar."

# game/chapters/chapter5/script/ch5sc1.rpy:1210
translate brazil ch5sc1_08a21db1:

#   bn "It’s home to Ice Wyverns: ruthless beasts with an appetite as large as themselves."
    bn "É o lar dos Wyverns de Gelo: feras implacáveis ​​com um apetite tão grande quanto elas mesmas."

# game/chapters/chapter5/script/ch5sc1.rpy:1212
translate brazil ch5sc1_3e81b0a5:

#   bn "Then there are the Frost Giants. Not the friendliest of neighbors to meet."
    bn "E depois há os Gigantes de Gelo. Não são exatamente os vizinhos mais amigáveis."

# game/chapters/chapter5/script/ch5sc1.rpy:1213
translate brazil ch5sc1_f6a1a3bf:

#   bn "Like their regular giant counterparts, they mostly keep to themselves but they'll crush anyone who intrudes on their territory."
    bn "Assim como seus equivalentes gigantes comuns, eles geralmente se mantêm isolados, mas esmagarão qualquer um que invadir seu território."

# game/chapters/chapter5/script/ch5sc1.rpy:1215
translate brazil ch5sc1_a57c1271:

#   bn "And then there’s the faction who controls the kingdom, Sney-dwarves."
    bn "E depois há a facção que controla o reino, os anões da Disney."

# game/chapters/chapter5/script/ch5sc1.rpy:1216
translate brazil ch5sc1_fc2f6b11:

#   bn "We haven’t had much interaction with them over the centuries."
    bn "Não tivemos muita interação com eles ao longo dos séculos."

# game/chapters/chapter5/script/ch5sc1.rpy:1217
translate brazil ch5sc1_247c46d1:

#   bn "They are the same size as regular dwarves but their skin appears like a mixture of ice and gemstones."
    bn "Eles têm o mesmo tamanho que os anões comuns, mas sua pele parece uma mistura de gelo e pedras preciosas."

# game/chapters/chapter5/script/ch5sc1.rpy:1219
translate brazil ch5sc1_c678d2b0:

#   bn "The ruler of Izentul is King Osirion. Not much is known about him and he's never shown much interest in communicating with us."
    bn "O governante de Izentul é o Rei Osirion. Pouco se sabe sobre ele e ele nunca demonstrou muito interesse em se comunicar conosco."

# game/chapters/chapter5/script/ch5sc1.rpy:1220
translate brazil ch5sc1_e48e7b08:

#   mc "I’ll go out on a limb here and assume they're not the people you’re worried about?"
    mc "Vou arriscar um palpite e presumir que não são as pessoas com quem você está preocupado?"

# game/chapters/chapter5/script/ch5sc1.rpy:1222
translate brazil ch5sc1_2a9532f8:

#   bn "You would be correct. They’ve never shown any interest in what lies beyond their own kingdom."
    bn "Você está certo. Eles nunca demonstraram qualquer interesse no que existe além do seu próprio reino."

# game/chapters/chapter5/script/ch5sc1.rpy:1224
translate brazil ch5sc1_c70915ab:

#   bn "Now, let’s move on to Arazalia. It's a land of vast deserts and large mountains."
    bn "Agora, vamos falar sobre Arazalia. É uma terra de vastos desertos e grandes montanhas."

# game/chapters/chapter5/script/ch5sc1.rpy:1225
translate brazil ch5sc1_50badd1a:

#   bn "There are said to be huge cavern networks below the sands that provide refuge from the heat."
    bn "Diz-se que existem enormes redes de cavernas sob as areias que oferecem refúgio do calor."

# game/chapters/chapter5/script/ch5sc1.rpy:1227
translate brazil ch5sc1_33ea3290:

#   bn "It's home to the obscenely large Arazalian lions, ferocious predators."
    bn "É o lar dos leões arazalianos, predadores ferozes e de tamanho obsceno."

# game/chapters/chapter5/script/ch5sc1.rpy:1229
translate brazil ch5sc1_6be77442:

#   bn "Another fierce predator that calls the vast deserts home are Drakehounds."
    bn "Outro predador feroz que habita os vastos desertos são os cães-dragão."

# game/chapters/chapter5/script/ch5sc1.rpy:1230
translate brazil ch5sc1_6e9b0b81:

#   bn "They're slightly smaller than the lions, but their agility and speed make them terrifying foes."
    bn "Eles são ligeiramente menores que os leões, mas sua agilidade e velocidade os tornam inimigos terríveis."

# game/chapters/chapter5/script/ch5sc1.rpy:1231
translate brazil ch5sc1_fd746ddb:

#   bn "Their bodies are covered in hardened scales that serve as protection."
    bn "Seus corpos são cobertos por escamas endurecidas que servem como proteção."

# game/chapters/chapter5/script/ch5sc1.rpy:1233
translate brazil ch5sc1_cf054ca6:

#   bn "If you ever find yourself searching for treasure in the mountains and mines of Arazalia..."
    bn "Se algum dia você se encontrar em busca de tesouros nas montanhas e minas de Arazalia..."

# game/chapters/chapter5/script/ch5sc1.rpy:1234
translate brazil ch5sc1_64180319:

#   bn "You'll want to be on the lookout for Ravagers as well. They are powerful creatures and very territorial."
    bn "Você também deve ficar atento aos Devastadores. Eles são criaturas poderosas e muito territoriais."

# game/chapters/chapter5/script/ch5sc1.rpy:1235
translate brazil ch5sc1_a6e26033:

#   bn "They've been reported to tear limbs off humans who venture too close to their breeding grounds."
    bn "Há relatos de que arrancam membros de humanos que se aventuram muito perto de seus locais de reprodução."

# game/chapters/chapter5/script/ch5sc1.rpy:1237
translate brazil ch5sc1_b83fe0d6:

#   bn "Beneath the sand dunes and mountains you can find the most pure deposits of diamonds and gems."
    bn "Sob as dunas de areia e montanhas, você pode encontrar os depósitos mais puros de diamantes e pedras preciosas."

# game/chapters/chapter5/script/ch5sc1.rpy:1238
translate brazil ch5sc1_1b002dca:

#   bn "That makes it a valuable kingdom and they have vast amounts of wealth."
    bn "Isso faz dele um reino valioso, e eles possuem vastas quantidades de riqueza."

# game/chapters/chapter5/script/ch5sc1.rpy:1240
translate brazil ch5sc1_42a8da05:

#   bn "Their Queen, Sahi. She's the embodiment of ambition... ruthless ambition."
    bn "Sua rainha, Sahi. Ela é a personificação da ambição... uma ambição implacável."

# game/chapters/chapter5/script/ch5sc1.rpy:1241
translate brazil ch5sc1_d8fed5e3:

#   bn "She killed her husband, the previous king on the night of their wedding."
    bn "Ela matou o marido, o rei anterior, na noite do casamento deles."

# game/chapters/chapter5/script/ch5sc1.rpy:1242
translate brazil ch5sc1_a88c86b2:

#   bn "Since then, Arazalia has become a Matriarchy, the first of it's kind."
    bn "Desde então, Arazalia se tornou um matriarcado, o primeiro de seu tipo."

# game/chapters/chapter5/script/ch5sc1.rpy:1243
translate brazil ch5sc1_6d02d198:

#   mc "Ruthless indeed, with wealth, ambition often follows..."
    mc "Sem dúvida alguma, a riqueza muitas vezes leva à ambição..."

# game/chapters/chapter5/script/ch5sc1.rpy:1244
translate brazil ch5sc1_e072ade2:

#   bn "You know your stuff. We’ve already caught several spies from Arazalia."
    bn "Você sabe do que está falando. Já capturamos vários espiões da Arazalia."

# game/chapters/chapter5/script/ch5sc1.rpy:1245
translate brazil ch5sc1_ca26b384:

#   bn "All of whom bit off their own tongues before we could interrogate them."
    bn "Todos eles arrancaram a própria língua com os dentes antes que pudéssemos interrogá-los."

# game/chapters/chapter5/script/ch5sc1.rpy:1247
translate brazil ch5sc1_0a67e9d6:

#   bn "Let’s move on to Elfwyr. As you can probably imagine, it's the homeland of the elves."
    bn "Vamos agora para Elfwyr. Como você provavelmente já imagina, é a terra natal dos elfos."

# game/chapters/chapter5/script/ch5sc1.rpy:1249
translate brazil ch5sc1_e47e5a8b:

#   bn "Unlike the other kingdoms, theirs is ruled by dual leaders: a pair of elven siblings."
    bn "Diferentemente dos outros reinos, o deles é governado por dois líderes: um par de irmãos elfos."

# game/chapters/chapter5/script/ch5sc1.rpy:1250
translate brazil ch5sc1_a50aa87f:

#   bn "Prince Ninthalor and Princess Nuin. They took over after the death of their father half a century ago."
    bn "Príncipe Ninthalor e Princesa Nuin. Eles assumiram o trono após a morte de seu pai, há meio século."

# game/chapters/chapter5/script/ch5sc1.rpy:1251
translate brazil ch5sc1_562c3428:

#   mc "They've been co-ruling for fifty years? I assume Elves live longer than humans?"
    mc "Eles governam juntos há cinquenta anos? Presumo que os elfos vivam mais tempo que os humanos?"

# game/chapters/chapter5/script/ch5sc1.rpy:1252
translate brazil ch5sc1_588faebb:

#   bn "Correct. From what I’ve been able to gather, an elf lives roughly ten times longer than a human."
    bn "Correto. Pelo que pude apurar, um elfo vive aproximadamente dez vezes mais do que um humano."

# game/chapters/chapter5/script/ch5sc1.rpy:1253
translate brazil ch5sc1_ad65927e:

#   bn "Some live to 800, 900, and a few even make it to a 1000 years old."
    bn "Alguns vivem até os 800, 900 anos, e alguns chegam até os 1000 anos de idade."

# game/chapters/chapter5/script/ch5sc1.rpy:1254
translate brazil ch5sc1_c317e639:

#   bn "They’re a noble race who've been our close allies ever since the succession wars."
    bn "Eles são uma raça nobre que tem sido nossa aliada próxima desde as guerras de sucessão."

# game/chapters/chapter5/script/ch5sc1.rpy:1256
translate brazil ch5sc1_bf50ec4b:

#   bn "Their kingdom mostly consists of large serene forests and neverending rivers."
    bn "Seu reino consiste principalmente em grandes florestas serenas e rios intermináveis."

# game/chapters/chapter5/script/ch5sc1.rpy:1257
translate brazil ch5sc1_22ea55db:

#   bn "Large valleys and mountains that reaches the clouds."
    bn "Grandes vales e montanhas que alcançam as nuvens."

# game/chapters/chapter5/script/ch5sc1.rpy:1259
translate brazil ch5sc1_d1cf787e:

#   bn "Besides elves, you'll also find dryads, fairies, centaurs and elementals there."
    bn "Além de elfos, você também encontrará dríades, fadas, centauros e elementais por lá."

# game/chapters/chapter5/script/ch5sc1.rpy:1260
translate brazil ch5sc1_f2a25808:

#   mct "Hmh, I wonder if Sylph is from Elfwyr?"
    mct "Hum, será que Sylph é de Elfwyr?"

# game/chapters/chapter5/script/ch5sc1.rpy:1261
translate brazil ch5sc1_28744cbb:

#   mc "Since you have an alliance with the elves, I’m assuming you aren’t suspecting them of plotting against you?"
    mc "Já que você tem uma aliança com os elfos, presumo que não suspeite que eles estejam tramando contra você?"

# game/chapters/chapter5/script/ch5sc1.rpy:1263
translate brazil ch5sc1_b1ed1f0f:

#   bn "I'd be surprised if that were the case. As I said, they are a noble race."
    bn "Eu ficaria surpreso se fosse esse o caso. Como eu disse, eles são uma raça nobre."

# game/chapters/chapter5/script/ch5sc1.rpy:1265
translate brazil ch5sc1_a7043ecc:

#   bn "Lastly, we have Nerzir. Much like Izentul, we haven’t been able to explore it properly."
    bn "Por último, temos Nerzir. Assim como Izentul, ainda não conseguimos explorá-la adequadamente."

# game/chapters/chapter5/script/ch5sc1.rpy:1266
translate brazil ch5sc1_2c9992c4:

#   bn "It's a land shrouded in mystery, but we know a wide range of beasts and creatures reside there."
    bn "É uma terra envolta em mistério, mas sabemos que uma grande variedade de feras e criaturas reside lá."

# game/chapters/chapter5/script/ch5sc1.rpy:1268
translate brazil ch5sc1_ee44104f:

#   bn "This includes Magma Wyverns. Just like the Ice Wyverns, they’re vicious and won’t hesitate to make a meal out of you."
    bn "Isso inclui os Wyverns de Magma. Assim como os Wyverns de Gelo, eles são ferozes e não hesitarão em fazer de você sua refeição."

# game/chapters/chapter5/script/ch5sc1.rpy:1270
translate brazil ch5sc1_16d6d8a6:

#   bn "Another formidable foe are the Dracobulls..."
    bn "Outro adversário formidável são os Dracobulls..."

# game/chapters/chapter5/script/ch5sc1.rpy:1271
translate brazil ch5sc1_bd419373:

#   bn "The size of Arazalian elephants, they easily trample anyone who gets in their way."
    bn "Do tamanho de elefantes arazalianos, eles facilmente esmagam qualquer um que cruze seu caminho."

# game/chapters/chapter5/script/ch5sc1.rpy:1273
translate brazil ch5sc1_699b7dd5:

#   bn "Their lands are also home to a wide variety of ogres and goblins."
    bn "Suas terras também abrigam uma grande variedade de ogros e goblins."

# game/chapters/chapter5/script/ch5sc1.rpy:1274
translate brazil ch5sc1_87f39d99:

#   mc "I’m familiar with those... nasty creatures."
    mc "Conheço bem essas... criaturas desagradáveis."

# game/chapters/chapter5/script/ch5sc1.rpy:1275
translate brazil ch5sc1_922bf9cb:

#   bn "Sadly, many of them have taken residence in other kingdoms over the years ..."
    bn "Infelizmente, muitos deles se estabeleceram em outros reinos ao longo dos anos..."

# game/chapters/chapter5/script/ch5sc1.rpy:1277
translate brazil ch5sc1_5e139381:

#   bn "It’s ruled by a vicious vampire lord who is known as Ducalion."
    bn "É governado por um cruel senhor vampiro conhecido como Ducalion."

# game/chapters/chapter5/script/ch5sc1.rpy:1278
translate brazil ch5sc1_8ac8d20b:

#   mct "The king knows about vampires? Hmh, maybe once I'm more familiar with him I could ask what more he knows about them."
    mct "O rei sabe sobre vampiros? Hum, talvez quando eu o conhecer melhor, eu possa perguntar o que mais ele sabe sobre eles."

# game/chapters/chapter5/script/ch5sc1.rpy:1279
translate brazil ch5sc1_f2d6a34f:

#   bn "He's rumored to be the oldest among his kind. However, there’s no way to be certain."
    bn "Há rumores de que ele seja o mais velho de sua espécie. No entanto, não há como ter certeza."

# game/chapters/chapter5/script/ch5sc1.rpy:1280
translate brazil ch5sc1_4c71b787:

#   mct "Hmh... I wonder if he's a pure-blooded vampire like Eliza?"
    mct "Hum... Será que ele é um vampiro de sangue puro como a Eliza?"

# game/chapters/chapter5/script/ch5sc1.rpy:1281
translate brazil ch5sc1_0a5794ec:

#   bn "We haven’t had any contact with them for at least a century at this point."
    bn "Não temos tido qualquer contato com eles há pelo menos um século."

# game/chapters/chapter5/script/ch5sc1.rpy:1283
translate brazil ch5sc1_7592faba:

#   bn "But we've caught a few spies from their domain too. None of which leads us to anything concrete."
    bn "Mas também capturamos alguns espiões do domínio deles. Nada disso nos leva a nada concreto."

# game/chapters/chapter5/script/ch5sc1.rpy:1285
translate brazil ch5sc1_be6adede:

#   mc "So, Arazalia and Nerzir are the two suspects who might be plotting against you?"
    mc "Então, Arazalia e Nerzir são os dois suspeitos que podem estar conspirando contra você?"

# game/chapters/chapter5/script/ch5sc1.rpy:1286
translate brazil ch5sc1_f6b1d05a:

#   bn "That's the conclusion I’ve come to. Obviously it would be naive to just rule out Izentul and Elfwyr."
    bn "Essa é a conclusão a que cheguei. Obviamente, seria ingenuidade descartar Izentul e Elfwyr sem mais nem menos."

# game/chapters/chapter5/script/ch5sc1.rpy:1287
translate brazil ch5sc1_be6ac2bd:

#   bn "But it would be highly unlikely that they would be involved."
    bn "Mas seria altamente improvável que eles estivessem envolvidos."

# game/chapters/chapter5/script/ch5sc1.rpy:1289
translate brazil ch5sc1_adb6f7a5:

#   bn "Our alliance with Elfwyr is strong and beneficial to both sides, we have great trade routes there."
    bn "Nossa aliança com Elfwyr é forte e benéfica para ambos os lados, temos ótimas rotas comerciais por lá."

# game/chapters/chapter5/script/ch5sc1.rpy:1290
translate brazil ch5sc1_cdba1af1:

#   bn "As for Izentul, as I said they are secluded and haven’t ever shown any interest in the rest of Midomir."
    bn "Quanto a Izentul, como eu disse, eles são isolados e nunca demonstraram qualquer interesse no resto de Midomir."

# game/chapters/chapter5/script/ch5sc1.rpy:1292
translate brazil ch5sc1_d680667b:

#   mc "Why do you suspect they would be targeting your daughter?"
    mc "Por que você suspeita que eles estariam visando sua filha?"

# game/chapters/chapter5/script/ch5sc1.rpy:1294
translate brazil ch5sc1_591d61e6:

#   bn "It’s the best way for them to gain control over Luxeron. I don’t have a male heir..."
    bn "É a melhor maneira de eles obterem o controle de Luxeron. Eu não tenho um herdeiro homem..."

# game/chapters/chapter5/script/ch5sc1.rpy:1296
translate brazil ch5sc1_a1b90c94:

#   bn "So kidnapping my only heir and forcing a marriage agreement upon us would allow them to-"
    bn "Então, sequestrar meu único herdeiro e nos forçar a um acordo de casamento permitiria que eles..."

# game/chapters/chapter5/script/ch5sc1.rpy:1297
translate brazil ch5sc1_58785225:

#   bn "To become High King of Midomir once my rule is over."
    bn "Para me tornar o Grande Rei de Midomir quando meu reinado terminar."

# game/chapters/chapter5/script/ch5sc1.rpy:1299
translate brazil ch5sc1_8f1a4267:

#   bn "It’s the best and most strategic way for them to acquire the title without an all-out war."
    bn "Essa é a melhor e mais estratégica maneira de eles conquistarem o título sem uma guerra total."

# game/chapters/chapter5/script/ch5sc1.rpy:1301
translate brazil ch5sc1_dc745667:

#   mct "That does make sense."
    mct "Faz sentido."

# game/chapters/chapter5/script/ch5sc1.rpy:1302
translate brazil ch5sc1_23549ce4:

#   mct "The smart play is to go for his daughter and avoid a war."
    mct "A jogada inteligente seria ir atrás da filha dele e evitar uma guerra."

# game/chapters/chapter5/script/ch5sc1.rpy:1304
translate brazil ch5sc1_a4d49de0:

#   mc "What do you need from me, Your Majesty?"
    mc "O que deseja de mim, Vossa Majestade?"

# game/chapters/chapter5/script/ch5sc1.rpy:1306
translate brazil ch5sc1_0c03cef4:

#   bn "My daughter should be safe here in the castle. But she loves to get out and visit the city..."
    bn "Minha filha deve estar segura aqui no castelo. Mas ela adora sair e visitar a cidade..."

# game/chapters/chapter5/script/ch5sc1.rpy:1307
translate brazil ch5sc1_aef6fb42:

#   bn "That’s when I need you to accompany her and make sure she’s protected at all times."
    bn "É nesse momento que preciso que você a acompanhe e garanta que ela esteja protegida o tempo todo."

# game/chapters/chapter5/script/ch5sc1.rpy:1309
translate brazil ch5sc1_d9852dda:

#   mc "How would you like me to handle it, if a situation arises?"
    mc "Como você gostaria que eu lidasse com isso, caso surja alguma situação?"

# game/chapters/chapter5/script/ch5sc1.rpy:1311
translate brazil ch5sc1_22cd2bfc:

#   bn "I will grant you complete authority in such cases. You deal with it however you see fit."
    bn "Concederei a vocês total autoridade nesses casos. Vocês lidarão com isso da maneira que acharem melhor."

# game/chapters/chapter5/script/ch5sc1.rpy:1312
translate brazil ch5sc1_2f5f2baa:

#   bn "I'll alert my guards about you and inform them of your position."
    bn "Avisarei meus guardas sobre você e os informarei sobre sua posição."

# game/chapters/chapter5/script/ch5sc1.rpy:1314
translate brazil ch5sc1_67877fc5:

#   mc "Your daughter's outburst earlier..."
    mc "O acesso de raiva da sua filha mais cedo..."

# game/chapters/chapter5/script/ch5sc1.rpy:1315
translate brazil ch5sc1_d3bd4780:

#   mc "Threatening to set the guards on me if she sees me again. Will that be a problem?"
    mc "Ela ameaçou chamar os guardas se me vir de novo. Isso vai ser um problema?"

# game/chapters/chapter5/script/ch5sc1.rpy:1317
translate brazil ch5sc1_796c1172:

#   bn "No... She just gets like that when she doesn’t get her way ... I’m afraid I’ve spoiled her."
    bn "Não... Ela fica assim quando não consegue o que quer... Receio tê-la mimado."

# game/chapters/chapter5/script/ch5sc1.rpy:1318
translate brazil ch5sc1_5590e071:

#   bn "I'll be sure to let the guards know not to heed her commands when it comes to you."
    bn "Vou garantir que os guardas saibam para não obedecerem às ordens dela quando se tratar de você."

# game/chapters/chapter5/script/ch5sc1.rpy:1320
translate brazil ch5sc1_e6459008:

#   mc "That’s a lot of power and trust you’re placing in me. Why?"
    mc "Isso representa muito poder e confiança que você está depositando em mim. Por quê?"

# game/chapters/chapter5/script/ch5sc1.rpy:1322
translate brazil ch5sc1_04b76a4e:

#   bn "You’ve been recommended to me by someone I trust. And my daughter's safety is on the line."
    bn "Você me foi recomendado por alguém em quem confio. E a segurança da minha filha está em jogo."

# game/chapters/chapter5/script/ch5sc1.rpy:1323
translate brazil ch5sc1_902f3770:

#   bn "I hope to marry Amelia off to a representative from Elfwyr. That would create a strong union-"
    bn "Espero casar Amelia com um representante de Elfwyr. Isso criaria uma união sólida."

# game/chapters/chapter5/script/ch5sc1.rpy:1324
translate brazil ch5sc1_56f30935:

#   bn "-From that point on, she'll be guarded by not just one, but two kingdoms."
    bn "A partir desse momento, ela será protegida não apenas por um, mas por dois reinos."

# game/chapters/chapter5/script/ch5sc1.rpy:1326
translate brazil ch5sc1_87eb5866:

#   mc "That would make her far less vulnerable."
    mc "Isso a tornaria muito menos vulnerável."

# game/chapters/chapter5/script/ch5sc1.rpy:1327
translate brazil ch5sc1_ffac747c:

#   mc "And put her and her future husband in a powerful position."
    mc "E colocar ela e seu futuro marido em uma posição de poder."

# game/chapters/chapter5/script/ch5sc1.rpy:1329
translate brazil ch5sc1_d02d1e2b:

#   bn "Exactly, You've got a good head on your shoulders kid."
    bn "Exatamente, você é muito inteligente, garoto."

# game/chapters/chapter5/script/ch5sc1.rpy:1330
translate brazil ch5sc1_f8302023:

#   bn "None of the other kingdoms would dare move against her."
    bn "Nenhum dos outros reinos ousaria se voltar contra ela."

# game/chapters/chapter5/script/ch5sc1.rpy:1332
translate brazil ch5sc1_97aec3b0:

#   bn "But I need you to protect her until that happens."
    bn "Mas preciso que você a proteja até que isso aconteça."

# game/chapters/chapter5/script/ch5sc1.rpy:1333
translate brazil ch5sc1_b5731ac5:

#   bn "You'll be well compensated for your troubles... 40 silvers each time you're on duty."
    bn "Você será bem recompensado pelos seus esforços... 40 moedas de prata cada vez que estiver de serviço."

# game/chapters/chapter5/script/ch5sc1.rpy:1334
translate brazil ch5sc1_b06348c9:

#   mct "Damn... Dalen wasn't kidding when he said it would pay well."
    mct "Caramba... Dalen não estava brincando quando disse que pagaria bem."

# game/chapters/chapter5/script/ch5sc1.rpy:1335
translate brazil ch5sc1_d82a42e3:

#   bn "You'll be needed once or twice a week to escort Amelia when she visits the city."
    bn "Você será necessário uma ou duas vezes por semana para acompanhar Amelia quando ela visitar a cidade."

# game/chapters/chapter5/script/ch5sc1.rpy:1336
translate brazil ch5sc1_4e421ef7:

#   bn "And for the occasional royal event."
    bn "E para eventos reais ocasionais."

# game/chapters/chapter5/script/ch5sc1.rpy:1338
translate brazil ch5sc1_f17d4c19:

#   mc "I won’t let you down. Amelia will be safe with me, Your Majesty."
    mc "Não vou decepcioná-la. Amelia estará segura comigo, Vossa Majestade."

# game/chapters/chapter5/script/ch5sc1.rpy:1340
translate brazil ch5sc1_a593645f:

#   bn "Good, good. And please... You can skip the formalities when we’re alone."
    bn "Ótimo, ótimo. E por favor... Você pode pular as formalidades quando estivermos a sós."

# game/chapters/chapter5/script/ch5sc1.rpy:1341
translate brazil ch5sc1_63039c77:

#   bn "It all becomes so formal. Tedious if you ask me. But it's tradition."
    bn "Tudo fica tão formal. Tedioso, na minha opinião. Mas é tradição."

# game/chapters/chapter5/script/ch5sc1.rpy:1342
translate brazil ch5sc1_3b61d7b7:

#   bn "Now go. My wife, Queen Merida awaits you in her chambers."
    bn "Agora vá. Minha esposa, a Rainha Mérida, espera por você em seus aposentos."

# game/chapters/chapter5/script/ch5sc1.rpy:1344
translate brazil ch5sc1_f0bfdd7f:

#   mc "Your wife?"
    mc "Sua esposa?"

# game/chapters/chapter5/script/ch5sc1.rpy:1346
translate brazil ch5sc1_a5334d51:

#   bn "Yes, when she found out I was hiring a personal bodyguard for Amelia-"
    bn "Sim, quando ela descobriu que eu estava contratando um guarda-costas pessoal para Amelia-"

# game/chapters/chapter5/script/ch5sc1.rpy:1347
translate brazil ch5sc1_23e12bae:

#   bn "-She demanded an audience once they had been hired."
    bn "-Ela exigiu uma audiência assim que eles foram contratados."

# game/chapters/chapter5/script/ch5sc1.rpy:1348
translate brazil ch5sc1_a42f1bde:

#   mct "Ahh. Makes sense, she probably wants to size me up herself and make sure I’m capable."
    mct "Ah, faz sentido. Ela provavelmente quer me avaliar e ter certeza de que sou capaz."

# game/chapters/chapter5/script/ch5sc1.rpy:1350
translate brazil ch5sc1_e2ec3aab:

#   mc "Alright, Your Majes- Bennen. Where will I find her?"
    mc "Muito bem, Vossas Majestades- Bennen. Onde a encontrarei?"

# game/chapters/chapter5/script/ch5sc1.rpy:1352
translate brazil ch5sc1_217cb432:

#   bn "Her chambers are up the stairs from this office. Take two left turns and it will be at the end of the hallway."
    bn "Os aposentos dela ficam subindo as escadas a partir deste escritório. Vire duas vezes à esquerda e eles estarão no final do corredor."

# game/chapters/chapter5/script/ch5sc1.rpy:1353
translate brazil ch5sc1_1a9ac209:

#   bn "Now go. She doesn’t like to be kept waiting."
    bn "Vá agora. Ela não gosta de ficar esperando."

# game/chapters/chapter5/script/ch5sc1.rpy:1360
translate brazil ch5sc1_77543333:

#   mct "This palace is huge... Bennen made it seem like a short walk from his office..."
    mct "Este palácio é enorme... Bennen fez parecer que era uma curta caminhada do seu escritório..."

# game/chapters/chapter5/script/ch5sc1.rpy:1362
translate brazil ch5sc1_a42bfc19:

#   mct "That must be the Queen’s chambers up ahead."
    mct "Aquilo ali na frente devem ser os aposentos da Rainha."

# game/chapters/chapter5/script/ch5sc1.rpy:1363
translate brazil ch5sc1_5e00d34f:

#   mct "Hopefully it won’t take too long... Eliza is probably getting impatient back at the guild."
    mct "Espero que não demore muito... Eliza provavelmente está ficando impaciente na guilda."

# game/chapters/chapter5/script/ch5sc1.rpy:1366
translate brazil ch5sc1_7c6af936:

#   qm "..."
    qm "..."

# game/chapters/chapter5/script/ch5sc1.rpy:1367
translate brazil ch5sc1_f0b5a267:

#   qm "Are we almost finished? I’m expecting a visitor any moment now."
    qm "Já estamos quase terminando? Estou esperando uma visita a qualquer momento."

# game/chapters/chapter5/script/ch5sc1.rpy:1369
translate brazil ch5sc1_f6361b63:

#   md "Yes, My Queen."
    md "Sim, minha rainha."

# game/chapters/chapter5/script/ch5sc1.rpy:1370
translate brazil ch5sc1_0a77b968:

#   md "Just a few more adjustments and you’re all set."
    md "Só mais alguns ajustes e estará tudo pronto."

# game/chapters/chapter5/script/ch5sc1.rpy:1372
translate brazil ch5sc1_4db3c8d1:

#   qm "What would I do without you?"
    qm "O que seria de mim sem você?"

# game/chapters/chapter5/script/ch5sc1.rpy:1374
translate brazil ch5sc1_c25b3201:

#   md "You would manage just fine."
    md "Você se sairia muito bem."

# game/chapters/chapter5/script/ch5sc1.rpy:1375
translate brazil ch5sc1_14cab953:

#   md "You’re a very capable woman, my Queen."
    md "Você é uma mulher muito capaz, minha Rainha."

# game/chapters/chapter5/script/ch5sc1.rpy:1377
translate brazil ch5sc1_8df4a7b1:

#   qm "That’s kind of you to say, but you don’t have to flatter me... you’re already my favorite maid."
    qm "É muita gentileza sua dizer isso, mas não precisa me bajular... você já é minha empregada favorita."

# game/chapters/chapter5/script/ch5sc1.rpy:1379
translate brazil ch5sc1_84b3fc4b:

#   qm "*Sighs heavily* Where did my youth go?"
    qm "*Suspira profundamente* Para onde foi minha juventude?"

# game/chapters/chapter5/script/ch5sc1.rpy:1381
translate brazil ch5sc1_712aec69:

#   md "My Queen? You’re still young."
    md "Minha rainha? Você ainda é jovem."

# game/chapters/chapter5/script/ch5sc1.rpy:1383
translate brazil ch5sc1_4fe115e4:

#   qm "I wish it were so... I turned 40 last spring."
    qm "Quem me dera fosse assim... Completei 40 anos na primavera passada."

# game/chapters/chapter5/script/ch5sc1.rpy:1384
translate brazil ch5sc1_ee12ff7d:

#   qm "My value as a woman is diminishing with every passing day..."
    qm "Meu valor como mulher está diminuindo a cada dia que passa..."

# game/chapters/chapter5/script/ch5sc1.rpy:1386
translate brazil ch5sc1_7aa25863:

#   md "You’re as beautiful as ever, my Queen."
    md "Você está tão linda como sempre, minha rainha."

# game/chapters/chapter5/script/ch5sc1.rpy:1387
translate brazil ch5sc1_b84a4f6b:

#   qm "I used to be so full of life, you know?"
    qm "Eu costumava ser tão cheia de vida, sabe?"

# game/chapters/chapter5/script/ch5sc1.rpy:1388
translate brazil ch5sc1_38c27dda:

#   qm "My very first time at court was when my family sent me to the capital to attend the prince’s annual ball. "
    qm "Minha primeira vez na corte foi quando minha família me enviou à capital para participar do baile anual do príncipe. "

# game/chapters/chapter5/script/ch5sc1.rpy:1390
translate brazil ch5sc1_072f855e:

#   qm "It was so extravagant! The flowers! The bards and their ballads! The dresses... everything."
    qm "Foi tudo tão extravagante! As flores! Os bardos e suas baladas! Os vestidos... tudo."

# game/chapters/chapter5/script/ch5sc1.rpy:1392
translate brazil ch5sc1_c32d3445:

#   qm "And then, that very same evening... the prince himself asked me for a dance."
    qm "E então, naquela mesma noite... o próprio príncipe me convidou para dançar."

# game/chapters/chapter5/script/ch5sc1.rpy:1394
translate brazil ch5sc1_f35b7ee9:

#   qm "It felt like I was in a dream come true!"
    qm "Parecia que eu estava vivendo um sonho!"

# game/chapters/chapter5/script/ch5sc1.rpy:1395
translate brazil ch5sc1_b6ed1bea:

#   qm "We danced... We went to events together... Everything was perfect."
    qm "Nós dançamos... Fomos a eventos juntos... Tudo foi perfeito."

# game/chapters/chapter5/script/ch5sc1.rpy:1397
translate brazil ch5sc1_24c0ae15:

#   md "Sounds like a fairytale, my Queen."
    md "Parece um conto de fadas, minha rainha."

# game/chapters/chapter5/script/ch5sc1.rpy:1399
translate brazil ch5sc1_c54706a9:

#   qm "Mhh... That it was. It wasn’t until after our wedding that everything became clear."
    qm "Hum... Era mesmo. Só depois do nosso casamento que tudo ficou claro."

# game/chapters/chapter5/script/ch5sc1.rpy:1400
translate brazil ch5sc1_6af9cb77:

#   qm "You see... the wedding was arranged. My family sending me to court was not the happy accident I'd thought."
    qm "Veja bem... o casamento foi arranjado. O fato da minha família me mandar para o tribunal não foi o feliz acaso que eu imaginava."

# game/chapters/chapter5/script/ch5sc1.rpy:1402
translate brazil ch5sc1_2e4b2537:

#   qm "They'd arranged everything with Bennen’s father. Even Bennen knew."
    qm "Eles tinham combinado tudo com o pai de Bennen. Até Bennen sabia."

# game/chapters/chapter5/script/ch5sc1.rpy:1403
translate brazil ch5sc1_4b6747c6:

#   qm "I felt so betrayed... The mirage of my blissful fairytale had all been a lie."
    qm "Senti-me tão traída... A miragem do meu conto de fadas perfeito não passava de uma mentira."

# game/chapters/chapter5/script/ch5sc1.rpy:1405
translate brazil ch5sc1_9e706a38:

#   qm "Every dance... every event... it was all just a facade to keep up appearances."
    qm "Cada dança... cada evento... tudo não passava de uma fachada para manter as aparências."

# game/chapters/chapter5/script/ch5sc1.rpy:1406
translate brazil ch5sc1_ee8b48e8:

#   md "My Queen?"
    md "Minha rainha?"

# game/chapters/chapter5/script/ch5sc1.rpy:1408
translate brazil ch5sc1_345e64d4:

#   qm "Bennen isn’t interested in... well, us, you see? But his father was desperate to bury those rumors."
    qm "Bennen não está interessado em... bem, em nós, entende? Mas o pai dele estava desesperado para abafar esses rumores."

# game/chapters/chapter5/script/ch5sc1.rpy:1409
translate brazil ch5sc1_793b826e:

#   qm "That’s where I came in. A young and beautiful and very naive girl from outside of court life."
    qm "Foi aí que eu entrei. Uma jovem, bonita e muito ingênua, de fora do mundo dos tribunais."

# game/chapters/chapter5/script/ch5sc1.rpy:1411
translate brazil ch5sc1_4d4baf57:

#   qm "A perfect match to throw off unwanted accusations about a soon-to-be king."
    qm "Uma combinação perfeita para afastar acusações indesejadas sobre um futuro rei."

# game/chapters/chapter5/script/ch5sc1.rpy:1412
translate brazil ch5sc1_353573e4:

#   qm "I’ve only ever spent one night with Bennen. Our wedding night, nineteen years ago."
    qm "Passei apenas uma noite com Bennen. Nossa noite de núpcias, há dezenove anos."

# game/chapters/chapter5/script/ch5sc1.rpy:1414
translate brazil ch5sc1_bfd4c6ab:

#   qm "That's when Amelia was conceived. But ever since, we’ve had separate rooms..."
    qm "Foi nessa época que Amelia foi concebida. Mas desde então, temos quartos separados..."

# game/chapters/chapter5/script/ch5sc1.rpy:1415
translate brazil ch5sc1_af036563:

#   qm "We attend events together for the sake of appearances. But as soon as they are over, we part."
    qm "Frequentamos eventos juntos por mera formalidade. Mas, assim que terminam, nos separamos."

# game/chapters/chapter5/script/ch5sc1.rpy:1417
translate brazil ch5sc1_7d34f6af:

#   qm "This big castle... All of the servants and court attendants... And yet I feel so alone."
    qm "Este enorme castelo... Todos os criados e funcionários da corte... E, no entanto, sinto-me tão sozinha."

# game/chapters/chapter5/script/ch5sc1.rpy:1419
translate brazil ch5sc1_747c5a0d:

#   md "My Queen. I didn’t know..."
    md "Minha rainha. Eu não sabia..."

# game/chapters/chapter5/script/ch5sc1.rpy:1421
translate brazil ch5sc1_f3d07259:

#   qm "You’re the only person I’ve told. I guess I’m just feeling a little anxious and I needed to finally tell someone."
    qm "Você é a única pessoa para quem contei. Acho que estou me sentindo um pouco ansiosa e precisava finalmente contar para alguém."

# game/chapters/chapter5/script/ch5sc1.rpy:1423
translate brazil ch5sc1_8bfe2233:

#   md "It will stay with me till I die."
    md "Isso ficará comigo até eu morrer."

# game/chapters/chapter5/script/ch5sc1.rpy:1425
translate brazil ch5sc1_8ee484b8:

#   qm "Heavens, no need to be so dramatic. Even if it were to come out, it wouldn’t matter at this point."
    qm "Nossa, não precisa de tanto drama. Mesmo que viesse à tona, não faria diferença agora."

# game/chapters/chapter5/script/ch5sc1.rpy:1426
translate brazil ch5sc1_35ea9dac:

#   qm "But I would still appreciate it if you would keep it between us."
    qm "Mas eu ainda agradeceria se você mantivesse isso entre nós."

# game/chapters/chapter5/script/ch5sc1.rpy:1428
translate brazil ch5sc1_90337947:

#   qm "There’s no need to sully my husbands reputation just because I didn’t get the happily-ever-after I desired."
    qm "Não há necessidade de manchar a reputação do meu marido só porque eu não tive o final feliz que desejava."

# game/chapters/chapter5/script/ch5sc1.rpy:1430
translate brazil ch5sc1_b92b1e8c:

#   md "All done, my Queen."
    md "Tudo pronto, minha Rainha."

# game/chapters/chapter5/script/ch5sc1.rpy:1432
translate brazil ch5sc1_133b6453:

#   qm "Thank you, you may go now."
    qm "Obrigado, pode ir agora."

# game/chapters/chapter5/script/ch5sc1.rpy:1434
translate brazil ch5sc1_413e5bb9:

#   md "As you wish, my Queen. I’ll head to the kitchens and prepare your dinner."
    md "Como desejar, minha Rainha. Vou até a cozinha preparar o seu jantar."

# game/chapters/chapter5/script/ch5sc1.rpy:1436
translate brazil ch5sc1_ebfea504:

#   qm "Thank you. I hope you know how much I appreciate you."
    qm "Obrigado. Espero que saiba o quanto eu te aprecio."

# game/chapters/chapter5/script/ch5sc1.rpy:1438
translate brazil ch5sc1_37a505c8:

#   md "I do. Because of your kindness, my family has been able to afford a roof over their heads."
    md "Sim, eu acredito. Graças à sua generosidade, minha família conseguiu ter um teto sobre a cabeça."

# game/chapters/chapter5/script/ch5sc1.rpy:1440
translate brazil ch5sc1_970b4883:

#   qm "It’s the least I could do."
    qm "É o mínimo que eu podia fazer."

# game/chapters/chapter5/script/ch5sc1.rpy:1445
translate brazil ch5sc1_f4a090c6:

#   md "Oh! Sorry! I didn’t see you there."
    md "Ah! Desculpe! Não te vi aí."

# game/chapters/chapter5/script/ch5sc1.rpy:1446
translate brazil ch5sc1_ce123398:

#   mc "The fault is mine. I’m looking for the queen’s personal chambers. Am I in the right place?"
    mc "A culpa é minha. Estou procurando os aposentos pessoais da rainha. Estou no lugar certo?"

# game/chapters/chapter5/script/ch5sc1.rpy:1447
translate brazil ch5sc1_a5c01e86:

#   md "So you’re the one she's waiting for? Go on ahead, she’s waiting for you."
    md "Então é você quem ela está esperando? Vá em frente, ela está esperando por você."

# game/chapters/chapter5/script/ch5sc1.rpy:1452
translate brazil ch5sc1_a6fd01c7:

#   mct "That must be her, Queen Merida... High-Queen of Midomir."
    mct "Essa deve ser ela, a Rainha Merida... Alta Rainha de Midomir."

# game/chapters/chapter5/script/ch5sc1.rpy:1454
translate brazil ch5sc1_6698d49a:

#   mct "She does embody a certain charisma. This should be interesting."
    mct "Ela realmente possui um certo carisma. Isso promete ser interessante."

# game/chapters/chapter5/script/ch5sc1.rpy:1456
translate brazil ch5sc1_3bcc3333:

#   qm "Join me... please?"
    qm "Junte-se a mim... por favor?"

# game/chapters/chapter5/script/ch5sc1.rpy:1458
translate brazil ch5sc1_213c0bdf:

#   mc "Certainly, Your Majesty."
    mc "Certamente, Vossa Majestade."

# game/chapters/chapter5/script/ch5sc1.rpy:1460
translate brazil ch5sc1_17058326:

#   mc "I didn’t think a woman of your stature would ever utter the word ‘please’ to a commoner?"
    mc "Nunca imaginei que uma mulher da sua posição fosse dirigir a palavra \"por favor\" a um plebeu."

# game/chapters/chapter5/script/ch5sc1.rpy:1462
translate brazil ch5sc1_6828aff2:

#   qm "I know what you must think."
    qm "Eu sei o que você deve estar pensando."

# game/chapters/chapter5/script/ch5sc1.rpy:1463
translate brazil ch5sc1_76e298a5:

#   qm "It’s what everyone thinks..."
    qm "É o que todo mundo pensa..."

# game/chapters/chapter5/script/ch5sc1.rpy:1464
translate brazil ch5sc1_c3158468:

#   qm "She’s the queen! She must be so noble! I bet she was born right into this!"
    qm "Ela é a rainha! Ela deve ser tão nobre! Aposto que nasceu para isso!"

# game/chapters/chapter5/script/ch5sc1.rpy:1466
translate brazil ch5sc1_749e0eae:

#   qm "But in fact... people don’t know me at all."
    qm "Mas na verdade... as pessoas não me conhecem de jeito nenhum."

# game/chapters/chapter5/script/ch5sc1.rpy:1467
translate brazil ch5sc1_132820b3:

#   qm "They- They don’t see me."
    qm "Eles... Eles não me veem."

# game/chapters/chapter5/script/ch5sc1.rpy:1469
translate brazil ch5sc1_f927bfa0:

#   mc "My apologies. I didn’t mean to offend."
    mc "Peço desculpas. Não tive a intenção de ofender."

# game/chapters/chapter5/script/ch5sc1.rpy:1471
translate brazil ch5sc1_73e44d3b:

#   qm "You didn’t. The reason I asked you politely, as an equal, is because..."
    qm "Você não fez isso. O motivo pelo qual lhe perguntei educadamente, como igual, é porque..."

# game/chapters/chapter5/script/ch5sc1.rpy:1472
translate brazil ch5sc1_2b64a6b4:

#   qm "*Sighs heavily* I was a commoner myself once. Born into poverty, I grew up at my family’s homestead."
    qm "*Suspiro pesado* Eu também já fui um plebeu. Nascido na pobreza, cresci na fazenda da minha família."

# game/chapters/chapter5/script/ch5sc1.rpy:1474
translate brazil ch5sc1_e788e524:

#   qm "Binding hay, shoveling after the pigs, milking the cows, peeling potatoes and pulling weeds..."
    qm "Amarrar feno, limpar a forragem dos porcos, ordenhar as vacas, descascar batatas e arrancar ervas daninhas..."

# game/chapters/chapter5/script/ch5sc1.rpy:1476
translate brazil ch5sc1_b7a58cca:

#   mc "That definitely doesn't sound very queen-like. How did you end up as the queen?"
    mc "Isso definitivamente não soa muito como algo que uma rainha faria. Como você acabou se tornando rainha?"

# game/chapters/chapter5/script/ch5sc1.rpy:1477
translate brazil ch5sc1_8f77b2c9:

#   mc "I mean-... If I may ask, Your Majesty?"
    mc "Quer dizer... Se me permite perguntar, Vossa Majestade?"

# game/chapters/chapter5/script/ch5sc1.rpy:1479
translate brazil ch5sc1_55e66245:

#   qm "Please, let’s drop the formalities. I hear them every day, and quite frankly, I’m tired of them."
    qm "Por favor, vamos deixar as formalidades de lado. Eu as ouço todos os dias e, francamente, estou cansado delas."

# game/chapters/chapter5/script/ch5sc1.rpy:1480
translate brazil ch5sc1_1e08fecb:

#   qm "Besides, I find your boldness... refreshing."
    qm "Além disso, acho sua ousadia... revigorante."

# game/chapters/chapter5/script/ch5sc1.rpy:1482
translate brazil ch5sc1_f421a5cd:

#   qm "We’ll speak as equals here."
    qm "Vamos conversar aqui como iguais."

# game/chapters/chapter5/script/ch5sc1.rpy:1484
translate brazil ch5sc1_2a97ae37:

#   mc "Merida, then."
    mc "Mérida, então."

# game/chapters/chapter5/script/ch5sc1.rpy:1486
translate brazil ch5sc1_38526863:

#   qm "Mhm. There’s that boldness of yours again, assuming it's okay to address me by my first name."
    qm "Hum. Lá está sua audácia de novo, presumindo que não há problema em me chamar pelo primeiro nome."

# game/chapters/chapter5/script/ch5sc1.rpy:1488
translate brazil ch5sc1_87f6f1f4:

#   mc "You wanted to speak as equals, I’m just making sure you get the proper experience... Merida."
    mc "Você queria conversar como iguais, eu só estou me certificando de que você tenha a experiência adequada... Mérida."

# game/chapters/chapter5/script/ch5sc1.rpy:1490
translate brazil ch5sc1_49f35e66:

#   qm "Goodness! *Light giggle* You’re a brazen young man, aren’t you?"
    qm "Nossa! *Risinho discreto* Você é um rapaz atrevido, não é?"

# game/chapters/chapter5/script/ch5sc1.rpy:1491
translate brazil ch5sc1_2fa28e29:

#   qm "I hope you aren’t this much trouble when you watch over Amelia, she'll have a fit."
    qm "Espero que você não dê tanto trabalho assim quando estiver cuidando da Amelia, ela vai ter um ataque."

# game/chapters/chapter5/script/ch5sc1.rpy:1493
translate brazil ch5sc1_807ffe8d:

#   mc "Maybe she needs someone to ruffle her perfect feathers."
    mc "Talvez ela precise de alguém para perturbar suas penas perfeitas."

# game/chapters/chapter5/script/ch5sc1.rpy:1495
translate brazil ch5sc1_bb905981:

#   qm "Now that would be a sight... Bennen and I, we’ve spoiled her for too long."
    qm "Isso sim seria uma visão... Bennen e eu, nós a mimamos demais por tempo demais."

# game/chapters/chapter5/script/ch5sc1.rpy:1497
translate brazil ch5sc1_e2fc21c6:

#   mc "She won’t have that problem with me. I’m horrible at spoiling anyone."
    mc "Comigo ela não terá esse problema. Sou péssimo em mimar as pessoas."

# game/chapters/chapter5/script/ch5sc1.rpy:1499
translate brazil ch5sc1_46315c59:

#   qm "Mh-Hm. I think you might be better at it than you think."
    qm "Hum-hum. Acho que você pode ser melhor nisso do que pensa."

# game/chapters/chapter5/script/ch5sc1.rpy:1500
translate brazil ch5sc1_20287026:

#   qm "Did my husband go over the details with you?"
    qm "Meu marido já explicou os detalhes para você?"

# game/chapters/chapter5/script/ch5sc1.rpy:1502
translate brazil ch5sc1_2849987a:

#   mc "Yes, he explained the situation you’re facing until Amelia is safely married."
    mc "Sim, ele explicou a situação que você enfrentará até que Amelia esteja casada em segurança."

# game/chapters/chapter5/script/ch5sc1.rpy:1504
translate brazil ch5sc1_de8c5585:

#   qm "It's quite the predicament. I myself was tricked into an arranged marriage."
    qm "É uma situação bastante complicada. Eu mesma fui enganada e acabei num casamento arranjado."

# game/chapters/chapter5/script/ch5sc1.rpy:1505
translate brazil ch5sc1_39e54034:

#   qm "I wouldn’t wish it upon anyone. Most especially my own daughter."
    qm "Eu não desejaria isso a ninguém. Principalmente à minha própria filha."

# game/chapters/chapter5/script/ch5sc1.rpy:1507
translate brazil ch5sc1_d1e18336:

#   mc "You were tricked into marrying the king?"
    mc "Você foi enganada e casou-se com o rei?"

# game/chapters/chapter5/script/ch5sc1.rpy:1509
translate brazil ch5sc1_1c34a8d4:

#   qm "*Sigh* I’m afraid so ... It's an odd thing to complain about, I know."
    qm "*Suspiro* Receio que sim... Sei que é uma coisa estranha de se reclamar."

# game/chapters/chapter5/script/ch5sc1.rpy:1510
translate brazil ch5sc1_87adb08a:

#   qm "I’m often reminded how good I have it. How I should be grateful for the life I’ve been given..."
    qm "Frequentemente me lembro de como sou privilegiado. De como devo ser grato pela vida que me foi dada..."

# game/chapters/chapter5/script/ch5sc1.rpy:1512
translate brazil ch5sc1_b4eb5844:

#   qm "But a life spent like a bird trapped in a cage? ... Devoid of love? ... Far from your family?"
    qm "Mas uma vida vivida como um pássaro preso numa gaiola? ... Sem amor? ... Longe da família?"

# game/chapters/chapter5/script/ch5sc1.rpy:1513
translate brazil ch5sc1_c939fc4f:

#   qm "If I hadn't had Amelia, and the sense of joy and love she brought into my life... I don’t know."
    qm "Se eu não tivesse tido Amelia, e a alegria e o amor que ela trouxe para a minha vida... eu não sei."

# game/chapters/chapter5/script/ch5sc1.rpy:1515
translate brazil ch5sc1_f9f40dcd:

#   "She pauses, clearly distraught."
    "Ela faz uma pausa, visivelmente perturbada."

# game/chapters/chapter5/script/ch5sc1.rpy:1516
translate brazil ch5sc1_ad1343a2:

#   mct "She's getting emotional, the pitch in her voice changed."
    mct "Ela está ficando emocionada, o tom de sua voz mudou."

# game/chapters/chapter5/script/ch5sc1.rpy:1519
translate brazil ch5sc1_781a4067:

#   mc "No woman should be made to feel like that. Especially-"
    mc "Nenhuma mulher deveria se sentir assim. Especialmente..."

# game/chapters/chapter5/script/ch5sc1.rpy:1524
translate brazil ch5sc1_6e636a20:

#   mc "A woman as beautiful and strong as you."
    mc "Uma mulher tão bonita e forte como você."

# game/chapters/chapter5/script/ch5sc1.rpy:1525
translate brazil ch5sc1_99a69730:

#   qm "Oh... You don’t have to flatter an old woman like myself."
    qm "Ah... Você não precisa bajular uma velha como eu."

# game/chapters/chapter5/script/ch5sc1.rpy:1526
translate brazil ch5sc1_db8bc5c4:

#   mc "You’re right, I don’t have to. But that’s my honest opinion."
    mc "Você tem razão, eu não preciso. Mas essa é a minha opinião sincera."

# game/chapters/chapter5/script/ch5sc1.rpy:1527
translate brazil ch5sc1_a1e9d234:

#   mc "And who are you calling old? You don’t look a day over 30."
    mc "E quem você está chamando de velho? Você não aparenta ter mais de 30 anos."

# game/chapters/chapter5/script/ch5sc1.rpy:1528
translate brazil ch5sc1_dc2ef9ef:

#   "A slight blush appears in Merida’s cheeks. Whether it's your words or the touch of your hand, you can't say."
    "Um leve rubor surge nas bochechas de Merida. Se foram suas palavras ou o toque de sua mão, você não sabe dizer."

# game/chapters/chapter5/script/ch5sc1.rpy:1529
translate brazil ch5sc1_3d46847e:

#   qm "I... Thank you. I’ll take the compliment then."
    qm "Eu... Obrigada. Aceito o elogio, então."

# game/chapters/chapter5/script/ch5sc1.rpy:1531
translate brazil ch5sc1_b11d3ad2:

#   "Merida is surprised by your boldness to compliment her, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Mérida ficou surpresa com a sua ousadia em elogiá-la, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc1.rpy:1535
translate brazil ch5sc1_eeb43fa3:

#   mc "As the Queen you shouldn’t have to feel like that."
    mc "Como Rainha, você não deveria se sentir assim."

# game/chapters/chapter5/script/ch5sc1.rpy:1536
translate brazil ch5sc1_d8aa76df:

#   qm "Thank you, I appreciate it."
    qm "Obrigado, agradeço."

# game/chapters/chapter5/script/ch5sc1.rpy:1539
translate brazil ch5sc1_1c0eb630:

#   mct "She still hasn’t said anything about my hand... Maybe she finds it comforting."
    mct "Ela ainda não disse nada sobre a minha mão... Talvez ela ache isso reconfortante."

# game/chapters/chapter5/script/ch5sc1.rpy:1540
translate brazil ch5sc1_10bf07d7:

#   mct "Her skin sure is smooth. Softer than I expected."
    mct "A pele dela é mesmo macia. Mais macia do que eu esperava."

# game/chapters/chapter5/script/ch5sc1.rpy:1542
translate brazil ch5sc1_3a55bfed:

#   qm "Where was I?"
    qm "Onde eu estava?"

# game/chapters/chapter5/script/ch5sc1.rpy:1543
translate brazil ch5sc1_3bb49bfe:

#   qm "Oh, right. I was telling you how I came to be Queen."
    qm "Ah, sim. Eu estava te contando como me tornei rainha."

# game/chapters/chapter5/script/ch5sc1.rpy:1545
translate brazil ch5sc1_9f69145e:

#   qm "The former king, Bennen’s father, was looking for a marriage for his son."
    qm "O antigo rei, pai de Bennen, estava procurando um casamento para o filho."

# game/chapters/chapter5/script/ch5sc1.rpy:1546
translate brazil ch5sc1_a529f791:

#   qm "I can’t discuss why, but he was strongly motivated. And my family saw a way for me to live a prosperous life."
    qm "Não posso explicar o porquê, mas ele estava muito motivado. E minha família viu ali uma maneira de eu ter uma vida próspera."

# game/chapters/chapter5/script/ch5sc1.rpy:1548
translate brazil ch5sc1_3120065b:

#   qm "But I wasn’t told anything other than I would be attending court. Long story short..."
    qm "Mas não me disseram nada além de que eu teria que comparecer ao tribunal. Resumindo..."

# game/chapters/chapter5/script/ch5sc1.rpy:1549
translate brazil ch5sc1_35f0b2e1:

#   qm "I fell for the prince. He made me believe we were in love... right up until our wedding night."
    qm "Eu me apaixonei pelo príncipe. Ele me fez acreditar que estávamos apaixonados... até a nossa noite de núpcias."

# game/chapters/chapter5/script/ch5sc1.rpy:1551
translate brazil ch5sc1_aec59598:

#   qm "That’s when the curtains for our ‘romance’ came crashing down."
    qm "Foi aí que as cortinas do nosso 'romance' desabaram."

# game/chapters/chapter5/script/ch5sc1.rpy:1552
translate brazil ch5sc1_9ef9bbda:

#   qm "He didn’t love me, he couldn’t... *Shaken voice* It-it was all just a means to get married."
    qm "Ele não me amava, ele não podia... *Voz trêmula* Tudo isso foi apenas um meio para casar."

# game/chapters/chapter5/script/ch5sc1.rpy:1554
translate brazil ch5sc1_52a5a950:

#   mc "Hey... Merida, it’s alright."
    mc "Ei... Mérida, está tudo bem."

# game/chapters/chapter5/script/ch5sc1.rpy:1555
translate brazil ch5sc1_6c81c5cd:

#   mc "I’m not here to judge you. In fact, if what you’re saying is true, that makes you incredibly strong."
    mc "Não estou aqui para julgá-lo(a). Aliás, se o que você está dizendo é verdade, isso o(a) torna incrivelmente forte."

# game/chapters/chapter5/script/ch5sc1.rpy:1556
translate brazil ch5sc1_a3883085:

#   mc "I doubt many women could have handled that at such a young age."
    mc "Duvido que muitas mulheres teriam conseguido lidar com isso em uma idade tão jovem."

# game/chapters/chapter5/script/ch5sc1.rpy:1558
translate brazil ch5sc1_43809d8f:

#   qm "You’re quite good at this..."
    qm "Você é muito bom nisso..."

# game/chapters/chapter5/script/ch5sc1.rpy:1559
translate brazil ch5sc1_eaae1cc1:

#   mc "At what?"
    mc "Em quê?"

# game/chapters/chapter5/script/ch5sc1.rpy:1560
translate brazil ch5sc1_5ef538f7:

#   qm "Making an old woman forget her age..."
    qm "Fazendo uma senhora idosa esquecer a sua idade..."

# game/chapters/chapter5/script/ch5sc1.rpy:1561
translate brazil ch5sc1_d3440265:

#   mct "I didn’t expect to find myself comforting the Queen today..."
    mct "Eu não esperava me ver consolando a Rainha hoje..."

# game/chapters/chapter5/script/ch5sc1.rpy:1562
translate brazil ch5sc1_e5ce5699:

#   mct "Her scent is incredible... Vanilla-root with a hint of Dawnflower."
    mct "O perfume dela é incrível... Raiz de baunilha com um toque de flor-da-manhã."

# game/chapters/chapter5/script/ch5sc1.rpy:1563
translate brazil ch5sc1_f6752258:

#   qm "Uhh... How long have you been...? Your hand..."
    qm "Hum... Há quanto tempo você está...? Sua mão..."

# game/chapters/chapter5/script/ch5sc1.rpy:1565
translate brazil ch5sc1_1f1bbb89:

#   mc "Sorry, instinct."
    mc "Desculpe, foi instinto."

# game/chapters/chapter5/script/ch5sc1.rpy:1566
translate brazil ch5sc1_40bfb67f:

#   qm "It’s okay... I’m at fault too for allowing it."
    qm "Tudo bem... Eu também tenho culpa por ter permitido isso."

# game/chapters/chapter5/script/ch5sc1.rpy:1568
translate brazil ch5sc1_6a4e9e9a:

#   qm "It... It felt nice. But it can’t happen again, you understand?"
    qm "Foi... Foi bom. Mas não pode acontecer de novo, entende?"

# game/chapters/chapter5/script/ch5sc1.rpy:1570
translate brazil ch5sc1_b194b948:

#   mc "I understand. It would put you in a bad light if anyone saw."
    mc "Entendo. Você ficaria numa situação muito ruim se alguém visse."

# game/chapters/chapter5/script/ch5sc1.rpy:1572
translate brazil ch5sc1_d88b7bc3:

#   qm "You'd best leave, it’s getting late. Your first escort duty is in two days."
    qm "É melhor você ir embora, está ficando tarde. Sua primeira missão de escolta é daqui a dois dias."

# game/chapters/chapter5/script/ch5sc1.rpy:1574
translate brazil ch5sc1_55121a0e:

#   qm "Just announce yourself to the castle guards and they will send for Amelia."
    qm "Basta se apresentar aos guardas do castelo e eles mandarão chamar Amelia."

# game/chapters/chapter5/script/ch5sc1.rpy:1575
translate brazil ch5sc1_d028ae04:

#   qm "I’ll talk to her beforehand and make sure she understands the need for a bodyguard."
    qm "Vou conversar com ela antes e garantir que ela entenda a necessidade de um guarda-costas."

# game/chapters/chapter5/script/ch5sc1.rpy:1577
translate brazil ch5sc1_6256bd92:

#   mc "Thank you. I’ll get out of your hair then."
    mc "Obrigada. Então vou sair do seu caminho."

# game/chapters/chapter5/script/ch5sc1.rpy:1579
translate brazil ch5sc1_b3df76c2:

#   qm "And [mc]? Thank you, for talking to me... I did enjoy our chat."
    qm "E [mc] Obrigada por conversar comigo... Gostei muito do nosso bate-papo."

# game/chapters/chapter5/script/ch5sc1.rpy:1580
translate brazil ch5sc1_e65ce7e6:

#   mc "Anytime, Merida."
    mc "A qualquer hora, Mérida."

# game/chapters/chapter5/script/ch5sc1.rpy:1581
translate brazil ch5sc1_010f7b5c:

#   mc "I hope to be blessed enough to enjoy your company another time."
    mc "Espero ter a sorte de desfrutar da sua companhia outra vez."

# game/chapters/chapter5/script/ch5sc1.rpy:1582
translate brazil ch5sc1_e849b656:

#   qm "*Giggles* Heavens... you're a charmer! Yes, I'd like to talk to you again sometime."
    qm "*Risos* Nossa... você é um encanto! Sim, eu gostaria de conversar com você de novo qualquer dia desses."

# game/chapters/chapter5/script/ch5sc1.rpy:1612
translate brazil ch5sc1_520e6d18:

#   fn "And that, my acolytes... is our lord's will."
    fn "E essa, meus acólitos... é a vontade de nosso Senhor."

# game/chapters/chapter5/script/ch5sc1.rpy:1614
translate brazil ch5sc1_07cb5ed8:

#   fn "His vision, our hands."
    fn "A visão dele, as nossas mãos."

# game/chapters/chapter5/script/ch5sc1.rpy:1615
translate brazil ch5sc1_4694b32c:

#   fn "We will be the ones to bring about the new dawn."
    fn "Seremos nós que traremos o novo amanhecer."

# game/chapters/chapter5/script/ch5sc1.rpy:1617
translate brazil ch5sc1_f48e59dd:

#   fn "No longer will we be looked down upon by our 'betters'."
    fn "Não seremos mais menosprezados por aqueles que nos consideram 'superiores'."

# game/chapters/chapter5/script/ch5sc1.rpy:1619
translate brazil ch5sc1_79a48465:

#   fn "No more poverty! No more injustice!"
    fn "Chega de pobreza! Chega de injustiça!"

# game/chapters/chapter5/script/ch5sc1.rpy:1621
translate brazil ch5sc1_e3b19104:

#   fn "In the new dawn, everything and everyone will be equal! HIS WILL!"
    fn "Na nova aurora, tudo e todos serão iguais! VONTADE DELE!"

# game/chapters/chapter5/script/ch5sc1.rpy:1622
translate brazil ch5sc1_9d578e66:

#   evr "Our hands!"
    evr "Nossas mãos!"

# game/chapters/chapter5/script/ch5sc1.rpy:1624
translate brazil ch5sc1_da308ef1:

#   fn "Ahh, Sister Lux."
    fn "Ah, Irmã Lux."

# game/chapters/chapter5/script/ch5sc1.rpy:1625
translate brazil ch5sc1_2a466f3e:

#   fn "You’re just in time."
    fn "Você chegou na hora certa."

# game/chapters/chapter5/script/ch5sc1.rpy:1626
translate brazil ch5sc1_59b64b6c:

#   fn "I’ve just finished bestowing our lord’s will upon these three."
    fn "Acabei de transmitir a vontade de nosso senhor a esses três."

# game/chapters/chapter5/script/ch5sc1.rpy:1628
translate brazil ch5sc1_11eae348:

#   fn "They’re ready for judgment."
    fn "Eles estão prontos para o julgamento."

# game/chapters/chapter5/script/ch5sc1.rpy:1630
translate brazil ch5sc1_68c971e2:

#   lx "Mh-Hm. A fine selection, Brother Ember."
    lx "Hum-hum. Uma ótima seleção, Irmão Ember."

# game/chapters/chapter5/script/ch5sc1.rpy:1631
translate brazil ch5sc1_8e9794ae:

#   lx "The lord will be pleased with your dedication."
    lx "O Senhor ficará satisfeito com a sua dedicação."

# game/chapters/chapter5/script/ch5sc1.rpy:1633
translate brazil ch5sc1_73af12ee:

#   be "His will, my hands."
    be "Sua vontade, minhas mãos."

# game/chapters/chapter5/script/ch5sc1.rpy:1635
translate brazil ch5sc1_079a2cc8:

#   lx "Are you three ready for enlightenment?"
    lx "Vocês três estão prontos para a iluminação?"

# game/chapters/chapter5/script/ch5sc1.rpy:1637
translate brazil ch5sc1_e94a73bb:

#   evr "His will, our hands."
    evr "A Sua vontade, as nossas mãos."

# game/chapters/chapter5/script/ch5sc1.rpy:1639
translate brazil ch5sc1_15ddec76:

#   lx "Perfect."
    lx "Perfeito."

# game/chapters/chapter5/script/ch5sc1.rpy:1640
translate brazil ch5sc1_654ca09c:

#   lx "Remember... When our lord rises, all those who have served him faithfully will be rewarded."
    lx "Lembrem-se... Quando nosso Senhor ressuscitar, todos aqueles que o serviram fielmente serão recompensados."

# game/chapters/chapter5/script/ch5sc1.rpy:1642
translate brazil ch5sc1_59b79eb3:

#   lx "Your deepest desire... Your greatest wish... Everything will be granted to you."
    lx "Seu desejo mais profundo... Seu maior anseio... Tudo lhe será concedido."

# game/chapters/chapter5/script/ch5sc1.rpy:1643
translate brazil ch5sc1_5c8f0895:

#   lx "But the road to our new world is long and not easily traveled."
    lx "Mas o caminho para o nosso novo mundo é longo e não é fácil de percorrer."

# game/chapters/chapter5/script/ch5sc1.rpy:1644
translate brazil ch5sc1_0326c2e9:

#   lx "It will take more devotion than you can possibly imagine."
    lx "Isso exigirá mais dedicação do que você pode imaginar."

# game/chapters/chapter5/script/ch5sc1.rpy:1646
translate brazil ch5sc1_3bed6982:

#   lx "Only those truly dedicated to our lord will live to see his new world."
    lx "Somente aqueles verdadeiramente dedicados ao nosso Senhor viverão para ver o seu novo mundo."

# game/chapters/chapter5/script/ch5sc1.rpy:1648
translate brazil ch5sc1_9899802c:

#   evr "We will do whatever it takes... His new world is worth any sacrifice."
    evr "Faremos o que for preciso... O seu novo mundo vale qualquer sacrifício."

# game/chapters/chapter5/script/ch5sc1.rpy:1650
translate brazil ch5sc1_83e1af48:

#   lx "Sacrifice... yes."
    lx "Sacrifício... sim."

# game/chapters/chapter5/script/ch5sc1.rpy:1652
translate brazil ch5sc1_a44999e6:

#   lx "Mhm... his will is strong."
    lx "Hum... a sua vontade é forte."

# game/chapters/chapter5/script/ch5sc1.rpy:1653
translate brazil ch5sc1_da523567:

#   lx "You will serve our lord perfectly. He has great things in store for you."
    lx "Você servirá ao nosso Senhor perfeitamente. Ele tem grandes coisas reservadas para você."

# game/chapters/chapter5/script/ch5sc1.rpy:1655
translate brazil ch5sc1_50c03bf1:

#   lx "Let’s see..."
    lx "Vamos ver..."

# game/chapters/chapter5/script/ch5sc1.rpy:1656
translate brazil ch5sc1_0685e1b2:

#   lx "A flower in it's bloom, an unsoiled beauty."
    lx "Uma flor em pleno desabrochar, uma beleza imaculada."

# game/chapters/chapter5/script/ch5sc1.rpy:1657
translate brazil ch5sc1_cc0a68c2:

#   lx "Hmmh... Your will is not fully cemented. Look at me."
    lx "Hum... Sua vontade ainda não está totalmente consolidada. Olhe para mim."

# game/chapters/chapter5/script/ch5sc1.rpy:1659
translate brazil ch5sc1_4bcc76cf:

#   lx "You’re full of anger... A deep rooted, burning desire for vengeance."
    lx "Você está cheio de raiva... Um desejo profundo e ardente de vingança."

# game/chapters/chapter5/script/ch5sc1.rpy:1660
translate brazil ch5sc1_c3072484:

#   lx "Continue to serve faithfully and you will have your vengeance."
    lx "Continue servindo fielmente e você terá sua vingança."

# game/chapters/chapter5/script/ch5sc1.rpy:1662
translate brazil ch5sc1_e879edec:

#   fma "*Nods*"
    fma "*Acena com a cabeça*"

# game/chapters/chapter5/script/ch5sc1.rpy:1664
translate brazil ch5sc1_ebeb1d0d:

#   lx "Hmmh..."
    lx "Hum..."

# game/chapters/chapter5/script/ch5sc1.rpy:1665
translate brazil ch5sc1_4a8a7b97:

#   lx "You don’t have the will of fire within you."
    lx "Você não possui a força de vontade do fogo dentro de si."

# game/chapters/chapter5/script/ch5sc1.rpy:1667
translate brazil ch5sc1_3cf62d5e:

#   ac "What do you mean? I-... I want to serve our lord."
    ac "O que você quer dizer? Eu... eu quero servir ao nosso senhor."

# game/chapters/chapter5/script/ch5sc1.rpy:1668
translate brazil ch5sc1_d6b801d0:

#   lx "No. Our lord won’t accept a flickering flame..."
    lx "Não. Nosso Senhor não aceitará uma chama trêmula..."

# game/chapters/chapter5/script/ch5sc1.rpy:1669
translate brazil ch5sc1_b4e53995:

#   ac "Please! There must be something I can do to earn it, to prove it?"
    ac "Por favor! Deve haver algo que eu possa fazer para merecer isso, para provar que mereço?"

# game/chapters/chapter5/script/ch5sc1.rpy:1671
translate brazil ch5sc1_fb4aa684:

#   lx "There is one thing you could do to serve our lord..."
    lx "Há uma coisa que você pode fazer para servir ao nosso Senhor..."

# game/chapters/chapter5/script/ch5sc1.rpy:1672
translate brazil ch5sc1_c2400678:

#   ac "Anything! Please! I don’t have anywhere else to go."
    ac "Qualquer coisa! Por favor! Não tenho para onde ir."

# game/chapters/chapter5/script/ch5sc1.rpy:1674
translate brazil ch5sc1_d17eff83:

#   lx "Perfect, our lord will be pleased."
    lx "Perfeito, nosso senhor ficará satisfeito."

# game/chapters/chapter5/script/ch5sc1.rpy:1675
translate brazil ch5sc1_df1a5fed:

#   lx "Now, please remove your robes and ascend the altar."
    lx "Agora, por favor, retirem suas vestes e subam ao altar."

# game/chapters/chapter5/script/ch5sc1.rpy:1677
translate brazil ch5sc1_7e8177cc:

#   ac "M-My robes?"
    ac "M-Minhas vestes?"

# game/chapters/chapter5/script/ch5sc1.rpy:1678
translate brazil ch5sc1_81fe0150:

#   ac "I-... I-"
    ac "Eu... Eu..."

# game/chapters/chapter5/script/ch5sc1.rpy:1680
translate brazil ch5sc1_3d12140e:

#   lx "Yes. You will present yourself before our lord as you were made."
    lx "Sim. Você se apresentará diante de nosso Senhor da maneira como foi criado."

# game/chapters/chapter5/script/ch5sc1.rpy:1682
translate brazil ch5sc1_5eb7f5db:

#   "The acolyte undresses nervously then climbs the altar."
    "O acólito se despe nervosamente e então sobe ao altar."

# game/chapters/chapter5/script/ch5sc1.rpy:1683
translate brazil ch5sc1_7d5124e7:

#   "The others watch attentively, following his every movement."
    "Os outros observam atentamente, acompanhando cada movimento seu."

# game/chapters/chapter5/script/ch5sc1.rpy:1689
translate brazil ch5sc1_eaba637e:

#   ac "I-Is this good?"
    ac "Isso está bom?"

# game/chapters/chapter5/script/ch5sc1.rpy:1690
translate brazil ch5sc1_0f563fe1:

#   lx "Yes, our lord will be pleased by your sacrifice."
    lx "Sim, nosso Senhor ficará satisfeito com o seu sacrifício."

# game/chapters/chapter5/script/ch5sc1.rpy:1691
translate brazil ch5sc1_782707e1:

#   ac "S-Sacrifice? What?"
    ac "S-Sacrifício? O quê?"

# game/chapters/chapter5/script/ch5sc1.rpy:1693
translate brazil ch5sc1_0b3ad4db:

#   lx "Acolytes."
    lx "Acólitos."

# game/chapters/chapter5/script/ch5sc1.rpy:1694
translate brazil ch5sc1_df719297:

#   be "I’ll leave you to it, Sister Lux."
    be "Vou deixar você em paz, Irmã Lux."

# game/chapters/chapter5/script/ch5sc1.rpy:1697
translate brazil ch5sc1_7538a591:

#   ac "H-Hey! What are you guys doing?! L-Let go of me!"
    ac "Ei! O que vocês estão fazendo?! M-Me soltem!"

# game/chapters/chapter5/script/ch5sc1.rpy:1698
translate brazil ch5sc1_221047c8:

#   lx "Shh... They are only doing our lord's will."
    lx "Shhh... Eles estão apenas cumprindo a vontade de nosso senhor."

# game/chapters/chapter5/script/ch5sc1.rpy:1699
translate brazil ch5sc1_15262373:

#   lx "It will all be over soon..."
    lx "Tudo isso vai acabar em breve..."

# game/chapters/chapter5/script/ch5sc1.rpy:1701
translate brazil ch5sc1_8142dbcd:

#   ac "{b}GUYS!!{/b} Do something! She’s lost her mind!"
    ac "{b}PESSOAL!!{/b} Faça alguma coisa! Ela perdeu a cabeça!"

# game/chapters/chapter5/script/ch5sc1.rpy:1703
translate brazil ch5sc1_22cee0b1:

#   "The acolytes tighten their grasp on him as he panics."
    "Os acólitos apertam ainda mais o seu abraço enquanto ele entra em pânico."

# game/chapters/chapter5/script/ch5sc1.rpy:1704
translate brazil ch5sc1_b85b708d:

#   lx "My Lord, he who shall bring forth the new dawn upon this accursed world."
    lx "Meu Senhor, aquele que trará a nova aurora a este mundo amaldiçoado."

# game/chapters/chapter5/script/ch5sc1.rpy:1706
translate brazil ch5sc1_03340f2d:

#   lx "He who will wash away all suffering. He who shall judge all those who are unjust."
    lx "Aquele que dissipará todo o sofrimento. Aquele que julgará todos os injustos."

# game/chapters/chapter5/script/ch5sc1.rpy:1707
translate brazil ch5sc1_12cdd990:

#   lx "My Lord, you who were born in flames, please accept this offering!"
    lx "Meu Senhor, tu que nasceste em chamas, por favor, aceita esta oferenda!"

# game/chapters/chapter5/script/ch5sc1.rpy:1708
translate brazil ch5sc1_d857dfbc:

#   lx "Purify this wretched soul in your everburning flames!"
    lx "Purifica esta alma miserável em tuas chamas eternas!"

# game/chapters/chapter5/script/ch5sc1.rpy:1716
translate brazil ch5sc1_4afdb378:

#   ac "*Groans in anguish* Hhrhhck-Hrkrh..."
    ac "*Geme de angústia* Hhrhhck-Hrkrh..."

# game/chapters/chapter5/script/ch5sc1.rpy:1720
translate brazil ch5sc1_2853d360:

#   lx "Take him to the cleansing chamber below and prepare him for the pyre."
    lx "Levem-no para a câmara de purificação abaixo e preparem-no para a pira funerária."

# game/chapters/chapter5/script/ch5sc1.rpy:1723
translate brazil ch5sc1_15391c6b:

#   ac "As you command, Sister."
    ac "Como ordenar, irmã."

# game/chapters/chapter5/script/ch5sc1.rpy:1746
translate brazil ch5sc1_ab6ddc47:

#   ri "..."
    ri "..."

# game/chapters/chapter5/script/ch5sc1.rpy:1795
translate brazil ch5sc1_f0346d50:

#   ri "....."
    ri "....."

# game/chapters/chapter5/script/ch5sc1.rpy:1802
translate brazil ch5sc1_1ca1ab1c:

#   el "Okay guys, I’m heading home for the day!"
    el "Ok, pessoal, estou indo para casa por hoje!"

# game/chapters/chapter5/script/ch5sc1.rpy:1804
translate brazil ch5sc1_55418403:

#   ml "Miss Eliza, do you need anyone to walk you home?"
    ml "Senhorita Eliza, precisa de alguém para acompanhá-la até em casa?"

# game/chapters/chapter5/script/ch5sc1.rpy:1806
translate brazil ch5sc1_300ff976:

#   el "I appreciate that Milton, but I’ll manage. I’m going straight to the tavern."
    el "Agradeço, Milton, mas eu me viro. Vou direto para a taverna."

# game/chapters/chapter5/script/ch5sc1.rpy:1807
translate brazil ch5sc1_41055405:

#   el "I want to make sure they keep a warm meal on hand for [mc]."
    el "Quero garantir que eles tenham uma refeição quente à disposição para [mc]."

# game/chapters/chapter5/script/ch5sc1.rpy:1809
translate brazil ch5sc1_cbf0c2b4:

#   sy "*Busy* Take care, Eliza! Make sure it's a big meal!"
    sy "*Ocupada* Cuide-se, Eliza! Certifique-se de que seja uma refeição farta!"

# game/chapters/chapter5/script/ch5sc1.rpy:1810
translate brazil ch5sc1_55602373:

#   sy "The royals will surely have left him famished! They can be a lot to deal with!"
    sy "Com certeza, os membros da realeza o deixaram faminto! Eles podem ser bem difíceis de lidar!"

# game/chapters/chapter5/script/ch5sc1.rpy:1811
translate brazil ch5sc1_e0c488e1:

#   el "You think so? Would they really work him that hard on his first day?"
    el "Você acha mesmo? Será que eles o fariam trabalhar tanto assim no primeiro dia?"

# game/chapters/chapter5/script/ch5sc1.rpy:1813
translate brazil ch5sc1_c0c8f3f6:

#   br "Aye! Hah! Surely the lad will be exhausted! He will be begging for my old-lady quests soon enough!"
    br "Sim! Hah! Com certeza o rapaz estará exausto! Logo logo estará implorando pelas minhas missões de velhinha!"

# game/chapters/chapter5/script/ch5sc1.rpy:1814
translate brazil ch5sc1_c45948d1:

#   sy "*Laughing*"
    sy "*Rindo*"

# game/chapters/chapter5/script/ch5sc1.rpy:1815
translate brazil ch5sc1_94b4141d:

#   ml "*Chuckles*"
    ml "*Risos*"

# game/chapters/chapter5/script/ch5sc1.rpy:1817
translate brazil ch5sc1_2c8ade89:

#   el "Keep blowing smoke out your ass and I’ll make sure those are the only quests you get!"
    el "Continue a falar pelos cotovelos e eu garanto que essas serão as únicas missões que você receberá!"

# game/chapters/chapter5/script/ch5sc1.rpy:1818
translate brazil ch5sc1_a372e7a8:

#   br "*Nervous* Ye wouldn’t do me like that, would ye lass? Ye know I was jesting!"
    br "*Nervosa* Você não faria isso comigo, faria, moça? Você sabe que eu estava brincando!"

# game/chapters/chapter5/script/ch5sc1.rpy:1819
translate brazil ch5sc1_f4c0d668:

#   el "Byyyeee!"
    el "Tchauzinho!"

# game/chapters/chapter5/script/ch5sc1.rpy:1826
translate brazil ch5sc1_c8826de0:

#   elt "[mc] is quite late today..."
    elt "[mc] Já está bastante tarde hoje..."

# game/chapters/chapter5/script/ch5sc1.rpy:1827
translate brazil ch5sc1_a66b8a06:

#   elt "I suppose the major contract we got is keeping [mc] busy."
    elt "Suponho que o principal contrato que conseguimos seja manter [mc] ocupado."

# game/chapters/chapter5/script/ch5sc1.rpy:1829
translate brazil ch5sc1_fe63fa89:

#   elt "I can’t imagine meeting the royal family! Let alone working for them..."
    elt "Não consigo imaginar conhecer a família real! Muito menos trabalhar para eles..."

# game/chapters/chapter5/script/ch5sc1.rpy:1830
translate brazil ch5sc1_7b35f488:

#   elt "One thing is for sure... [mc] won’t be too thrilled. He hates socializing and nobles."
    elt "Uma coisa é certa... [mc] Não ficará muito entusiasmado. Ele detesta socializar e a nobreza."

# game/chapters/chapter5/script/ch5sc1.rpy:1832
translate brazil ch5sc1_34006921:

#   elt "*Giggling* Heh-heh! I can just imagine the look on his face when he realized what this contract was!"
    elt "*Risos* Hehe! Consigo imaginar a cara dele quando percebeu o que era esse contrato!"

# game/chapters/chapter5/script/ch5sc1.rpy:1834
translate brazil ch5sc1_ed9dbcdb:

#   elt "It’ll be good for him, though. He'll definitely benefit from socializing!"
    elt "Vai ser bom para ele, com certeza. Ele definitivamente se beneficiará da socialização!"

# game/chapters/chapter5/script/ch5sc1.rpy:1835
translate brazil ch5sc1_d91caf42:

#   elt "Besides, a contract this huge will help the guild tremendously."
    elt "Além disso, um contrato tão grande ajudará imensamente a guilda."

# game/chapters/chapter5/script/ch5sc1.rpy:1837
translate brazil ch5sc1_9a1cee46:

#   elt "And spending time with the royal family could lead to them becoming allies."
    elt "E passar um tempo com a família real poderia levar a uma aliança entre eles."

# game/chapters/chapter5/script/ch5sc1.rpy:1838
translate brazil ch5sc1_585d8808:

#   elt "Or at the very least making some valuable connections."
    elt "Ou, no mínimo, estabelecer algumas conexões valiosas."

# game/chapters/chapter5/script/ch5sc1.rpy:1840
translate brazil ch5sc1_15c5a97b:

#   elt "I'd better get to the tavern and make sure the innkeeper keeps a juicy roast warm for [mc]."
    elt "É melhor eu ir até a taverna e garantir que o estalajadeiro mantenha um assado suculento bem quentinho para [mc]."

# game/chapters/chapter5/script/ch5sc1.rpy:1842
translate brazil ch5sc1_8d443ba4:

#   elt "He’s been taking care of me so attentively, it’s time I take care of him."
    elt "Ele tem cuidado de mim com tanta atenção, que chegou a hora de eu cuidar dele."

# game/chapters/chapter5/script/ch5sc1.rpy:1844
translate brazil ch5sc1_423fb847:

#   elt "Hmh... Maybe I could draw a hot bath for him? And maybe follow it with a deep massage?"
    elt "Hum... Talvez eu pudesse preparar um banho quente para ele? E talvez depois fazer uma massagem relaxante?"

# game/chapters/chapter5/script/ch5sc1.rpy:1845
translate brazil ch5sc1_ca566b1c:

#   elt "Yes, he'll definitely like that! He hasn't been able to properly relax since he got back."
    elt "Sim, ele com certeza vai gostar! Ele não consegue relaxar direito desde que voltou."

# game/chapters/chapter5/script/ch5sc1.rpy:1849
translate brazil ch5sc1_9a31a39a:

#   sl "Eliza?"
    sl "Eliza?"

# game/chapters/chapter5/script/ch5sc1.rpy:1850
translate brazil ch5sc1_4f0e9282:

#   elt "That voice... Selena?!"
    elt "Aquela voz... Selena?!"

# game/chapters/chapter5/script/ch5sc1.rpy:1852
translate brazil ch5sc1_362d7a9e:

#   elt "What in the five hells is she doing here?"
    elt "Que diabos ela está fazendo aqui?"

# game/chapters/chapter5/script/ch5sc1.rpy:1853
translate brazil ch5sc1_2fe53e25:

#   elt "Ugh! Whatever..."
    elt "Ah, tanto faz..."

# game/chapters/chapter5/script/ch5sc1.rpy:1855
translate brazil ch5sc1_3c8db32d:

#   sl "..."
    sl "..."

# game/chapters/chapter5/script/ch5sc1.rpy:1857
translate brazil ch5sc1_026d3984:

#   sl "Eliza, please? Can we talk?"
    sl "Eliza, por favor? Podemos conversar?"

# game/chapters/chapter5/script/ch5sc1.rpy:1859
translate brazil ch5sc1_c443cc85:

#   el "I have nothing to say to you."
    el "Não tenho nada a lhe dizer."

# game/chapters/chapter5/script/ch5sc1.rpy:1861
translate brazil ch5sc1_1912180a:

#   sl "That’s fine. You don’t have to say anything, but please... hear me out?"
    sl "Tudo bem. Você não precisa dizer nada, mas por favor... me escute?"

# game/chapters/chapter5/script/ch5sc1.rpy:1863
translate brazil ch5sc1_422045c7:

#   sl "Come, we can talk in private back here."
    sl "Venha, podemos conversar em particular aqui atrás."

# game/chapters/chapter5/script/ch5sc1.rpy:1864
translate brazil ch5sc1_853dc655:

#   elt "After everything she’s put us through, she has the nerve to assume I’m willing to hear her out?"
    elt "Depois de tudo o que ela nos fez passar, ela ainda tem a audácia de presumir que eu estou disposto a ouvi-la?"

# game/chapters/chapter5/script/ch5sc1.rpy:1866
translate brazil ch5sc1_7ac5862f:

#   elt "Gods! She pisses me off!"
    elt "Meu Deus! Ela me irrita profundamente!"

# game/chapters/chapter5/script/ch5sc1.rpy:1867
translate brazil ch5sc1_834de56c:

#   elt "..."
    elt "..."

# game/chapters/chapter5/script/ch5sc1.rpy:1869
translate brazil ch5sc1_329d3209:

#   elt "Her-... Neck, looks so inviting..."
    elt "O pescoço dela... parece tão convidativo..."

# game/chapters/chapter5/script/ch5sc1.rpy:1870
translate brazil ch5sc1_bc46eed7:

#   elt "No... *Inhales deeply* Control..."
    elt "Não... *Inspira profundamente* Controle..."

# game/chapters/chapter5/script/ch5sc1.rpy:1872
translate brazil ch5sc1_496a9ac5:

#   elt "This had better be good... I have to get home and prepare for [mc]."
    elt "Isso tem que ser bom... Preciso chegar em casa e me preparar para... [mc]."

# game/chapters/chapter5/script/ch5sc1.rpy:1874
translate brazil ch5sc1_59dc7251:

#   el "Okay, this is far enough. Start talking."
    el "Ok, já chega. Pode começar a falar."

# game/chapters/chapter5/script/ch5sc1.rpy:1878
translate brazil ch5sc1_51e377dd:

#   sl "I’m-... I’m sorry, okay?"
    sl "Eu... eu sinto muito, tá bem?"

# game/chapters/chapter5/script/ch5sc1.rpy:1880
translate brazil ch5sc1_d3664e0c:

#   sl "You have to understand. Taron, he-... he had my sister!"
    sl "Você precisa entender. Taron... ele... ele estava com a minha irmã!"

# game/chapters/chapter5/script/ch5sc1.rpy:1881
translate brazil ch5sc1_1b92f521:

#   sl "When he asked me to smooch up to two strangers in return for freeing Samarah..."
    sl "Quando ele me pediu para beijar dois estranhos em troca de libertar Samarah..."

# game/chapters/chapter5/script/ch5sc1.rpy:1883
translate brazil ch5sc1_494a27cf:

#   sl "It wasn’t a hard decision to make at that moment."
    sl "Naquele momento, não foi uma decisão difícil de tomar."

# game/chapters/chapter5/script/ch5sc1.rpy:1884
translate brazil ch5sc1_3a5378b2:

#   sl "At first, all he wanted was for me to get close to the two of you and report back to him."
    sl "No início, tudo o que ele queria era que eu me aproximasse de vocês dois e lhe desse notícias."

# game/chapters/chapter5/script/ch5sc1.rpy:1886
translate brazil ch5sc1_547d583c:

#   sl "Then he made me lure you away from [mc]. He said that he just wanted to talk to you..."
    sl "Então ele me fez te atrair para longe de [mc] Ele disse que só queria conversar com você..."

# game/chapters/chapter5/script/ch5sc1.rpy:1887
translate brazil ch5sc1_7aa6c8f3:

#   sl "But clearly that was a lie, as we both found out..."
    sl "Mas claramente isso era mentira, como ambos descobrimos..."

# game/chapters/chapter5/script/ch5sc1.rpy:1894
translate brazil ch5sc1_e36d01b7:

#   el "*Raised voice* Wanting to protect your sister I get, but why not come clean to us? Why betray us!?"
    el "*Em tom de voz mais alto* Entendo que você queira proteger sua irmã, mas por que não nos contar a verdade? Por que nos trair!?"

# game/chapters/chapter5/script/ch5sc1.rpy:1895
translate brazil ch5sc1_c51bb859:

#   el "If only you had told us! We could've helped you break out your sister!"
    el "Se você tivesse nos contado! Poderíamos ter ajudado você a libertar sua irmã!"

# game/chapters/chapter5/script/ch5sc1.rpy:1896
translate brazil ch5sc1_6265d6bd:

#   el "Instead you left me to suffer in that cell!"
    el "Em vez disso, você me deixou sofrer naquela cela!"

# game/chapters/chapter5/script/ch5sc1.rpy:1900
translate brazil ch5sc1_002ada71:

#   sl "I had to..."
    sl "Eu precisei..."

# game/chapters/chapter5/script/ch5sc1.rpy:1901
translate brazil ch5sc1_f3c04a15:

#   sl "Taron is the one who let me in to see you."
    sl "Foi o Taron quem me deixou entrar para te ver."

# game/chapters/chapter5/script/ch5sc1.rpy:1903
translate brazil ch5sc1_fe233d2f:

#   sl "I couldn’t let him hear me trying to comfort you... He was right outside the door."
    sl "Eu não podia deixar que ele me ouvisse tentando te consolar... Ele estava bem na porta."

# game/chapters/chapter5/script/ch5sc1.rpy:1904
translate brazil ch5sc1_d78793dd:

#   sl "I had to keep playing the part."
    sl "Tive que continuar interpretando o papel."

# game/chapters/chapter5/script/ch5sc1.rpy:1905
translate brazil ch5sc1_54070863:

#   sl "I needed to guarantee that he'd keep up his end and free my sister!"
    sl "Eu precisava garantir que ele cumpriria sua parte e libertaria minha irmã!"

# game/chapters/chapter5/script/ch5sc1.rpy:1907
translate brazil ch5sc1_c87531bd:

#   el "As long as your sister got free, it didn’t matter who paid the price... right?"
    el "Contanto que sua irmã fosse libertada, não importava quem pagasse o preço... certo?"

# game/chapters/chapter5/script/ch5sc1.rpy:1908
translate brazil ch5sc1_5dec329d:

#   el "Even if your friends were being hurt, potentially about to die, that didn't matter to you!?"
    el "Mesmo que seus amigos estivessem sendo feridos, potencialmente prestes a morrer, isso não importava para você!?"

# game/chapters/chapter5/script/ch5sc1.rpy:1910
translate brazil ch5sc1_96e70d57:

#   sl "Eliza, wouldn’t you have done the same thing to save [mc]?"
