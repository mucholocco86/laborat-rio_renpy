#   el "That’s what you get for being such a brute!"
    el "É o que você ganha por ser tão bruto!"

# game/chapters/chapter5/script/ch5sc08.rpy:717
translate brazil ch5sc08_5e3fa7b2:

#   mc "What? I didn’t do anything!"
    mc "O quê? Eu não fiz nada!"

# game/chapters/chapter5/script/ch5sc08.rpy:718
translate brazil ch5sc08_a2a41a5b:

#   el "*Giggles* Sure you did! You big oaf!"
    el "*Risos* Claro que sim! Seu bobão!"

# game/chapters/chapter5/script/ch5sc08.rpy:721
translate brazil ch5sc08_e0bd861a:

#   mc "Oaf? Brute? ... Just wait til I get my hands on you!"
    mc "Idiota? Bruto? ... Espere só até eu pôr as mãos em você!"

# game/chapters/chapter5/script/ch5sc08.rpy:722
translate brazil ch5sc08_2095cd7c:

#   el "*Laughing* Oh yeah?! You’ll have to catch me first! Oaf!"
    el "*Risos* Ah, é?! Primeiro você vai ter que me pegar! Bobão!"

# game/chapters/chapter5/script/ch5sc08.rpy:724
translate brazil ch5sc08_ea26b135:

#   el "*Shouts* Is that all you got? Keep up!"
    el "*Grita* É só isso que você tem? Acompanhe!"

# game/chapters/chapter5/script/ch5sc08.rpy:725
translate brazil ch5sc08_7060ff22:

#   mct "{i}She’s fast. But let’s see if she can anticipate this.{/i}"
    mct "{i}Ela é rápida. Mas vamos ver se ela consegue antecipar isso.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:729
translate brazil ch5sc08_62527c57:

#   "She manages to dodge your vortex at the last second."
    "Ela consegue escapar do seu vórtice no último segundo."

# game/chapters/chapter5/script/ch5sc08.rpy:730
translate brazil ch5sc08_0d1124b0:

#   el "Hnngh! Nice try!"
    el "Hnngh! Boa tentativa!"

# game/chapters/chapter5/script/ch5sc08.rpy:731
translate brazil ch5sc08_7ab22438:

#   mct "{i}Her reflexes are on point. Good... but she's bound to get cocky.{/i}"
    mct "{i}Os reflexos dela são perfeitos. Ótimo... mas é inevitável que ela fique arrogante.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:734
translate brazil ch5sc08_2e4fc89e:

#   mct "{i}Damn. Almost had her...{/i}"
    mct "{i}Droga. Quase a peguei...{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:736
translate brazil ch5sc08_110c1c7f:

#   el "*Snickers* Are you even trying? You’re getting slower!"
    el "*Risos* Você está se esforçando? Está ficando mais lento!"

# game/chapters/chapter5/script/ch5sc08.rpy:737
translate brazil ch5sc08_1c0f02d6:

#   el "Should I slow down so you can keep up? Maybe we could find a bench for you? *Giggles*"
    el "Devo diminuir o ritmo para que você consiga acompanhar? Talvez possamos encontrar um banco para você? *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:738
translate brazil ch5sc08_5f65e03e:

#   mct "{i}There it is! She’s filled with confidence, now’s my chance!{/i}"
    mct "{i}Aí está! Ela está cheia de confiança, agora é a minha chance!{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:741
translate brazil ch5sc08_f438f6d7:

#   el "*Shouts* Keep up grandpa!"
    el "*Grita* Continue assim, vovô!"

# game/chapters/chapter5/script/ch5sc08.rpy:742
translate brazil ch5sc08_33e832e8:

#   "You stop for a few moments, looking at her movements, anticipating her direction."
    "Você para por alguns instantes, observando seus movimentos, antecipando a direção que ela tomará."

# game/chapters/chapter5/script/ch5sc08.rpy:745
translate brazil ch5sc08_f4f9e6aa:

#   el "{b}*Squeals* Aiiiyh!!{/b}"
    el "{b}*Gritos de alegria* Aiiiyh!!{/b}"

# game/chapters/chapter5/script/ch5sc08.rpy:746
translate brazil ch5sc08_4c159589:

#   mct "{i}Got her! Hehheh... Let’s give her a taste of what being a bird feels like.{/i}"
    mct "{i}Peguei ela! Hehehe... Vamos dar a ela uma provinha de como é ser um pássaro.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:748
translate brazil ch5sc08_ca0d869d:

#   el "*Squeals* IiiAahh!! Put me down! You- You oaf!! *Giggles*"
    el "*Gritos* Aaahh!! Me põe no chão! Seu... Seu idiota!! *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:750
translate brazil ch5sc08_c7c75c05:

#   mc "Oaf, huh? Seem’s you want to spend some time among the clouds!"
    mc "Bobão, hein? Parece que você quer passar um tempo entre as nuvens!"

# game/chapters/chapter5/script/ch5sc08.rpy:751
translate brazil ch5sc08_79f970d3:

#   mc "Do let me know if they’re as fluffy as they look!"
    mc "Me avise se eles forem tão fofinhos quanto parecem!"

# game/chapters/chapter5/script/ch5sc08.rpy:752
translate brazil ch5sc08_9351017d:

#   el "*Laughing* Nooo! No! I-I didn’t mean iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiit-"
    el "*Risos* Não! Não! Eu não quis dizer isso!"

# game/chapters/chapter5/script/ch5sc08.rpy:755
translate brazil ch5sc08_4c599d34:

#   el "*Screams* {b}AiiiiiyhhhHHH!{/b}"
    el "*Gritos* {b} AiiiiiiyhhhHHH!{/b}"

# game/chapters/chapter5/script/ch5sc08.rpy:757
translate brazil ch5sc08_10b62216:

#   el "{b}*Squals loudly* AiiiiYHhYhhh!{/b} I’m gonna get you for thiiiiiiiiiiiiiiiiiiiiiiiiiiiiissh!"
    el "{b}*Gritos altos* AiiiiYHhYhhh!{/b} Eu vou te pegar por isso!"

# game/chapters/chapter5/script/ch5sc08.rpy:763
translate brazil ch5sc08_3c65ad31:

#   el "*Squeals* Aiiyhh! Hah! HHahah! It-It's making my stomach feel funny!"
    el "*Gritos* Aiiyhh! Hah! HHahah! Isso... Isso está me dando uma sensação estranha no estômago!"

# game/chapters/chapter5/script/ch5sc08.rpy:772
translate brazil ch5sc08_f1585194:

#   bn "*Sighs heavily* How am I supposed to lead Luxeron into peace and prosperity when-"
    bn "*Suspiro pesado* Como vou conseguir conduzir Luxeron à paz e prosperidade quando-"

# game/chapters/chapter5/script/ch5sc08.rpy:773
translate brazil ch5sc08_2c5632cf:

#   bn "-My subjects are at each other's throats at every little dispute?"
    bn "-Meus súditos estão em pé de guerra uns com os outros a cada pequena disputa?"

# game/chapters/chapter5/script/ch5sc08.rpy:775
translate brazil ch5sc08_bfd51ce6:

#   bn "There are more and more reports of uprisings and conflicts between the different lords."
    bn "Há cada vez mais relatos de levantes e conflitos entre os diferentes senhores feudais."

# game/chapters/chapter5/script/ch5sc08.rpy:776
translate brazil ch5sc08_de3d8f7b:

#   bn "One wants more territory, another wants more resources, or political status, while others just want to be left alone..."
    bn "Um quer mais território, outro quer mais recursos ou status político, enquanto outros só querem ser deixados em paz..."

# game/chapters/chapter5/script/ch5sc08.rpy:777
translate brazil ch5sc08_27e74120:

#   bn "Lord Alaric has been constantly pushing his borders out, expanding his hold in the south."
    bn "Lorde Alaric tem vindo constantemente a expandir as suas fronteiras, consolidando o seu domínio no sul."

# game/chapters/chapter5/script/ch5sc08.rpy:779
translate brazil ch5sc08_b724e486:

#   bn "Amelia’s 20th name day is coming up soon."
    bn "O aniversário de 20 anos de Amelia está chegando."

# game/chapters/chapter5/script/ch5sc08.rpy:780
translate brazil ch5sc08_b28e8aa5:

#   bn "It will be a good chance to find her a suitable husband."
    bn "Será uma boa oportunidade para ela encontrar um marido adequado."

# game/chapters/chapter5/script/ch5sc08.rpy:781
translate brazil ch5sc08_dd3fb9e0:

#   bn "But she hasn’t exactly been subtle about her opinions on the matter."
    bn "Mas ela não tem sido exatamente sutil em relação às suas opiniões sobre o assunto."

# game/chapters/chapter5/script/ch5sc08.rpy:783
translate brazil ch5sc08_ebdcd909:

#   bn "Still, she’s now of age, and finding a good match for her is of paramount importance for the future of the kingdom."
    bn "No entanto, ela já atingiu a maioridade, e encontrar um bom partido para ela é de suma importância para o futuro do reino."

# game/chapters/chapter5/script/ch5sc08.rpy:784
translate brazil ch5sc08_7dec4dd8:

#   bn "She’s stubborn as a mule, though. I honestly don’t know where she gets it from."
    bn "Ela é teimosa como uma mula. Sinceramente, não sei de onde ela puxou isso."

# game/chapters/chapter5/script/ch5sc08.rpy:786
translate brazil ch5sc08_7a9f5963:

#   cbl "Your Grace."
    cbl "Vossa Graça."

# game/chapters/chapter5/script/ch5sc08.rpy:787
translate brazil ch5sc08_d4484bee:

#   bn "What is it? I’ve got a lot on my mind currently."
    bn "O que é isso? Estou com muita coisa na cabeça ultimamente."

# game/chapters/chapter5/script/ch5sc08.rpy:788
translate brazil ch5sc08_d10ffd20:

#   cbl "You have a visitor. He claims to be an old acquaintance."
    cbl "Você tem uma visita. Ele alega ser um velho conhecido."

# game/chapters/chapter5/script/ch5sc08.rpy:789
translate brazil ch5sc08_cb07e20e:

#   bn "Send them in."
    bn "Envie-os."

# game/chapters/chapter5/script/ch5sc08.rpy:791
translate brazil ch5sc08_d43e4fef:

#   da "Your Majesty."
    da "Sua Majestade."

# game/chapters/chapter5/script/ch5sc08.rpy:792
translate brazil ch5sc08_309e031b:

#   bn "Dalen, hah! Why don’t we skip the formalities for old time sake?"
    bn "Dalen, hah! Por que não deixamos as formalidades de lado, em nome dos velhos tempos?"

# game/chapters/chapter5/script/ch5sc08.rpy:794
translate brazil ch5sc08_82661962:

#   da "It’s good to see you, Bennen."
    da "Que bom te ver, Bennen."

# game/chapters/chapter5/script/ch5sc08.rpy:795
translate brazil ch5sc08_075a1178:

#   bn "Likewise, old chap! How’s life as a Guildmaster treating you?"
    bn "Igualmente, meu caro! Como está sendo a vida como Mestre de Guilda?"

# game/chapters/chapter5/script/ch5sc08.rpy:797
translate brazil ch5sc08_6c78d57e:

#   da "We’ve had some hurdles over the past couple of years, but things have been looking up lately."
    da "Enfrentamos alguns obstáculos nos últimos dois anos, mas as coisas têm melhorado ultimamente."

# game/chapters/chapter5/script/ch5sc08.rpy:798
translate brazil ch5sc08_1ff9e698:

#   da "Our new batch of recruits has been keeping busy and working hard."
    da "Nossa nova turma de recrutas tem se mantido ocupada e trabalhando duro."

# game/chapters/chapter5/script/ch5sc08.rpy:800
translate brazil ch5sc08_eec41296:

#   bn "Ah, yes. I hired one of them recently, based on the letter of recommandation you sent me."
    bn "Ah, sim. Contratei um deles recentemente, com base na carta de recomendação que você me enviou."

# game/chapters/chapter5/script/ch5sc08.rpy:801
translate brazil ch5sc08_e76bbb72:

#   bn "[mc], I believe. Truth be told, I wasn’t too keen on the idea of hiring from outside the royal guard."
    bn "[mc] Acredito que sim. Para ser sincero, eu não estava muito entusiasmado com a ideia de contratar alguém de fora da guarda real."

# game/chapters/chapter5/script/ch5sc08.rpy:802
translate brazil ch5sc08_d332552c:

#   bn "But knowing he’s one of your men helped me to get comfortable with the idea."
    bn "Mas saber que ele é um dos seus homens me ajudou a me sentir mais confortável com a ideia."

# game/chapters/chapter5/script/ch5sc08.rpy:804
translate brazil ch5sc08_e82b75df:

#   da "You can count on him. That, I can promise you."
    da "Você pode contar com ele. Isso eu posso lhe garantir."

# game/chapters/chapter5/script/ch5sc08.rpy:805
translate brazil ch5sc08_45705c32:

#   da "He may very well be the most capable adventurer I’ve witnessed in all my years."
    da "Ele pode muito bem ser o aventureiro mais capaz que já vi em todos os meus anos."

# game/chapters/chapter5/script/ch5sc08.rpy:807
translate brazil ch5sc08_e7067c26:

#   bn "*Chuckles* That’s certainly high praise coming from one of the legendary knight-trio."
    bn "*Risos* Isso certamente é um grande elogio vindo de um dos membros do lendário trio de cavaleiros."

# game/chapters/chapter5/script/ch5sc08.rpy:809
translate brazil ch5sc08_b6cb1b03:

#   da "You’re flattering me."
    da "Você está me lisonjeando."

# game/chapters/chapter5/script/ch5sc08.rpy:811
translate brazil ch5sc08_7d5441f5:

#   bn "*Chuckles* Not at all, and we both know it. You, Oren and Taron..."
    bn "*Risos* De jeito nenhum, e nós dois sabemos disso. Você, Oren e Taron..."

# game/chapters/chapter5/script/ch5sc08.rpy:812
translate brazil ch5sc08_cc60ab92:

#   bn "The three best knights to ever graduate the academy. The rest of us looked up to you for good reason."
    bn "Os três melhores cavaleiros que já se formaram na academia. Nós, os demais, admirávamos vocês por um bom motivo."

# game/chapters/chapter5/script/ch5sc08.rpy:814
translate brazil ch5sc08_b7421cbe:

#   da "You were a capable fighter yourself, as I recall."
    da "Você também era um lutador competente, se bem me lembro."

# game/chapters/chapter5/script/ch5sc08.rpy:816
translate brazil ch5sc08_0f8dab41:

#   bn "Bah... Sure, I can handle myself. Nothing quite like the three of you, though."
    bn "Bah... Claro, eu sei me virar. Mas nada se compara a vocês três."

# game/chapters/chapter5/script/ch5sc08.rpy:817
translate brazil ch5sc08_254dc208:

#   bn "Which is why I feel confident with your best adventurer guarding Amelia."
    bn "Por isso, sinto-me confiante em ter o seu melhor aventureiro protegendo Amelia."

# game/chapters/chapter5/script/ch5sc08.rpy:819
translate brazil ch5sc08_ac3751ee:

#   da "That’s actually the reason for my visit. I believe your daughter is in imminent danger."
    da "Na verdade, esse é o motivo da minha visita. Acredito que sua filha esteja em perigo iminente."

# game/chapters/chapter5/script/ch5sc08.rpy:820
translate brazil ch5sc08_586c11fb:

#   da "I have nothing concrete right now, but I’ve received reports of some concerning missives that mention the princess."
    da "No momento, não tenho nada concreto, mas recebi relatos de algumas mensagens preocupantes que mencionam a princesa."

# game/chapters/chapter5/script/ch5sc08.rpy:821
translate brazil ch5sc08_c0258585:

#   da "Missives that also mention the line of succession and potential candidates."
    da "Mensagens que também mencionam a linha de sucessão e os potenciais candidatos."

# game/chapters/chapter5/script/ch5sc08.rpy:823
translate brazil ch5sc08_ac6ca797:

#   bn "*Sighs heavily* Then my suspicions were correct. I was hoping I was just being a paranoid father ..."
    bn "*Suspiro pesado* Então minhas suspeitas estavam corretas. Eu esperava estar apenas sendo um pai paranoico..."

# game/chapters/chapter5/script/ch5sc08.rpy:824
translate brazil ch5sc08_c7d9cc91:

#   bn "Keep your eyes and ears peeled for any other information, Dalen, please."
    bn "Dalen, por favor, fique atento a qualquer outra informação."

# game/chapters/chapter5/script/ch5sc08.rpy:826
translate brazil ch5sc08_ab263345:

#   da "You need not ask. I'll do everything in my power to safeguard your rule and the safety of your daughter."
    da "Não precisa pedir. Farei tudo ao meu alcance para salvaguardar o seu governo e a segurança da sua filha."

# game/chapters/chapter5/script/ch5sc08.rpy:828
translate brazil ch5sc08_7a76754a:

#   bn "Amelia’s 20th name day celebrations are coming up soon. Make sure your man is fit for duty."
    bn "As comemorações do 20º aniversário de Amelia estão chegando. Certifique-se de que seu marido esteja em forma para a ocasião."

# game/chapters/chapter5/script/ch5sc08.rpy:829
translate brazil ch5sc08_076fd0e9:

#   bn "I don’t expect anyone will dare make a move on such an occasion, but I’d rather be safe than sorry."
    bn "Não espero que alguém se atreva a fazer uma investida numa ocasião dessas, mas prefiro prevenir do que remediar."

# game/chapters/chapter5/script/ch5sc08.rpy:831
translate brazil ch5sc08_92358b6a:

#   da "He’ll be ready. And I'll be present too, as well as a few others from our ranks."
    da "Ele estará pronto. E eu também estarei presente, assim como alguns outros de nossas fileiras."

# game/chapters/chapter5/script/ch5sc08.rpy:833
translate brazil ch5sc08_f11d939e:

#   bn "Thank you, Dalen. Your efforts will not go unrewarded."
    bn "Obrigado, Dalen. Seus esforços não ficarão sem recompensa."

# game/chapters/chapter5/script/ch5sc08.rpy:841
translate brazil ch5sc08_6b796bce:

#   el "{b}*Screams and laughs combined*{/b} Y-You'd better puuuuut me down! HahH-Hahhah! N-No more!"
    el "{b}*Gritos e risos misturados*{/b} É melhor você me soltar! HahH-Hahhah! N-Chega!"

# game/chapters/chapter5/script/ch5sc08.rpy:844
translate brazil ch5sc08_ba2b79a2:

#   "You dissipate the vortex and catch her as she drops back down."
    "Você dissipa o vórtice e a pega quando ela cai de volta."

# game/chapters/chapter5/script/ch5sc08.rpy:845
translate brazil ch5sc08_364fdfdd:

#   el "*Giggling* I hate you!"
    el "*Risos* Eu te odeio!"

# game/chapters/chapter5/script/ch5sc08.rpy:847
translate brazil ch5sc08_be119f9f:

#   mc "No you don’t."
    mc "Não, você não precisa."

# game/chapters/chapter5/script/ch5sc08.rpy:848
translate brazil ch5sc08_5b978e38:

#   el "Mhm... No, I don’t."
    el "Hum... Não, não tenho."

# game/chapters/chapter5/script/ch5sc08.rpy:850
translate brazil ch5sc08_e9ab92ad:

#   el "I really thought I'd be able to dodge your vortices..."
    el "Eu realmente pensei que conseguiria me esquivar dos seus vórtices..."

# game/chapters/chapter5/script/ch5sc08.rpy:851
translate brazil ch5sc08_5c443c37:

#   mc "You managed to dodge a few. I’d consider that a win."
    mc "Você conseguiu se esquivar de algumas. Eu consideraria isso uma vitória."

# game/chapters/chapter5/script/ch5sc08.rpy:853
translate brazil ch5sc08_4e29c918:

#   el "But... you still got me in the end."
    el "Mas... você ainda me pegou no final."

# game/chapters/chapter5/script/ch5sc08.rpy:854
translate brazil ch5sc08_cebff16f:

#   mc "*Smiling* I still got you."
    mc "*Sorriso* Eu ainda tenho você."

# game/chapters/chapter5/script/ch5sc08.rpy:856
translate brazil ch5sc08_1ac5d76d:

#   el "*Snickers* I suppose you’ll want a reward then?"
    el "*Risos* Imagino que você queira uma recompensa, então?"

# game/chapters/chapter5/script/ch5sc08.rpy:857
translate brazil ch5sc08_891a4277:

#   el "I didn’t bring anything with me. Next round on me at the rooster?"
    el "Não trouxe nada comigo. A próxima rodada é por minha conta no bar do galo?"

# game/chapters/chapter5/script/ch5sc08.rpy:861
translate brazil ch5sc08_010f90f8:

#   mc "Nice try. But I’m collecting now."
    mc "Boa tentativa. Mas agora estou coletando."

# game/chapters/chapter5/script/ch5sc08.rpy:862
translate brazil ch5sc08_9d5e879a:

#   el "What are you-"
    el "O que você está-"

# game/chapters/chapter5/script/ch5sc08.rpy:865
translate brazil ch5sc08_4754bb6d:

#   el "Mh-Mhh!! ... MmhhhH!"
    el "Mh-Mhh!! ... MmhhhH!"

# game/chapters/chapter5/script/ch5sc08.rpy:866
translate brazil ch5sc08_0fb27eae:

#   elt "{i}I knew it was coming, but it still makes my heart race whenever he kisses me!{/i}"
    elt "{i}Eu sabia que isso ia acontecer, mas mesmo assim meu coração dispara toda vez que ele me beija!{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:868
translate brazil ch5sc08_e413c56a:

#   el "*Kiss* Mhhnghh... *Giggles* MhhhH... You're crazy."
    el "*Beijo* Mhhnghh... *Risos* MhhhH... Você é louco."

# game/chapters/chapter5/script/ch5sc08.rpy:870
translate brazil ch5sc08_e8547e68:

#   mc "*Kiss* Crazy about you, my little kitten. Mmhm..."
    mc "*Beijo* Louco por você, meu gatinho. Hum..."

# game/chapters/chapter5/script/ch5sc08.rpy:871
translate brazil ch5sc08_28b6eab7:

#   el "*Licks* Meow! *Giggles*"
    el "*Lambe* Miau! *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:873
translate brazil ch5sc08_a834503c:

#   mc "Now, that’s what I call a prize!"
    mc "Isso sim é que eu chamo de prêmio!"

# game/chapters/chapter5/script/ch5sc08.rpy:874
translate brazil ch5sc08_6c345e4d:

#   el "*Panting* I feel like I was the one getting the reward."
    el "*Ofegante* Sinto que fui eu quem recebeu a recompensa."

# game/chapters/chapter5/script/ch5sc08.rpy:876
translate brazil ch5sc08_8255226b:

#   mc "We both did. C'mon, we'd better get going."
    mc "Nós dois fizemos. Vamos, é melhor irmos."

# game/chapters/chapter5/script/ch5sc08.rpy:881
translate brazil ch5sc08_5ab69780:

#   mc "Music to my ears. I’ll be sure to let Borri know too."
    mc "Que maravilha! Vou avisar o Borri também."

# game/chapters/chapter5/script/ch5sc08.rpy:882
translate brazil ch5sc08_3a29021f:

#   el "Snickers* Meanie! He drinks at least one barrel!"
    el "Snickers* Malvado! Ele bebe pelo menos um barril!"

# game/chapters/chapter5/script/ch5sc08.rpy:883
translate brazil ch5sc08_9d10f79e:

#   mc "Exactly... *Chuckles*"
    mc "Exatamente... *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:887
translate brazil ch5sc08_416f42c5:

#   "Eliza lets out a small moan as she stretches."
    "Eliza solta um pequeno gemido enquanto se espreguiça."

# game/chapters/chapter5/script/ch5sc08.rpy:888
translate brazil ch5sc08_f8f01d37:

#   el "Hnnnghh! How much further? All that running has given me quite the appetite."
    el "Hnnnghh! Quanto falta? Toda essa corrida me deu um apetite danado."

# game/chapters/chapter5/script/ch5sc08.rpy:889
translate brazil ch5sc08_54f8351c:

#   mc "Just past the next clearing and we’ll be at our destination."
    mc "Logo depois da próxima clareira, chegaremos ao nosso destino."

# game/chapters/chapter5/script/ch5sc08.rpy:897
translate brazil ch5sc08_772ff0a5:

#   ri "Dead?"
    ri "Morto?"

# game/chapters/chapter5/script/ch5sc08.rpy:898
translate brazil ch5sc08_7b37ce9d:

#   uk "Just like all the others."
    uk "Assim como todos os outros."

# game/chapters/chapter5/script/ch5sc08.rpy:899
translate brazil ch5sc08_6027587e:

#   ri "Hmm, beat us to it again."
    ri "Hum, nos adiantaram de novo."

# game/chapters/chapter5/script/ch5sc08.rpy:900
translate brazil ch5sc08_22551a7e:

#   ri "Ring? Signs?"
    ri "Anel? Sinais?"

# game/chapters/chapter5/script/ch5sc08.rpy:901
translate brazil ch5sc08_4f6004c9:

#   uk "None."
    uk "Nenhum."

# game/chapters/chapter5/script/ch5sc08.rpy:903
translate brazil ch5sc08_56648cc9:

#   ri "Leaving."
    ri "Saindo."

# game/chapters/chapter5/script/ch5sc08.rpy:904
translate brazil ch5sc08_64ecbc51:

#   ri "Body... yours."
    ri "Corpo... seu."

# game/chapters/chapter5/script/ch5sc08.rpy:905
translate brazil ch5sc08_26cf1bf1:

#   ri "Regroup, usual spot, dusk."
    ri "Reagrupar, local de costume, ao entardecer."

# game/chapters/chapter5/script/ch5sc08.rpy:906
translate brazil ch5sc08_339fff6c:

#   ri "I'll, follow her trail."
    ri "Vou seguir o rastro dela."

# game/chapters/chapter5/script/ch5sc08.rpy:907
translate brazil ch5sc08_5a21c7ac:

#   uk "..."
    uk "..."

# game/chapters/chapter5/script/ch5sc08.rpy:915
translate brazil ch5sc08_39872599:

#   al "What are we going to do about Rose?"
    al "O que vamos fazer em relação à Rose?"

# game/chapters/chapter5/script/ch5sc08.rpy:916
translate brazil ch5sc08_2f1eb39d:

#   al "Why is she helping that scumbag? Could he have something on her?"
    al "Por que ela está ajudando aquele canalha? Será que ele tem algo contra ela?"

# game/chapters/chapter5/script/ch5sc08.rpy:918
translate brazil ch5sc08_548cfef2:

#   lu "Maybe... Or it could be her own venomous ambition."
    lu "Talvez... Ou talvez seja apenas sua ambição venenosa."

# game/chapters/chapter5/script/ch5sc08.rpy:921
translate brazil ch5sc08_603e5e4f:

#   lu "Even if that snake is being pressured by Taron, it doesn’t excuse what she's done, or what she's still putting my mother through!"
    lu "Mesmo que essa cobra esteja sendo pressionada por Taron, isso não justifica o que ela fez, ou o que ela ainda está fazendo minha mãe passar!"

# game/chapters/chapter5/script/ch5sc08.rpy:922
translate brazil ch5sc08_792d459c:

#   lu "Hexing her closest ally... to further her own position?! {b}UGH!!{/b}"
    lu "Enfeitiçar sua aliada mais próxima... para fortalecer sua própria posição?! {b} ECA!!{/b}"

# game/chapters/chapter5/script/ch5sc08.rpy:924
translate brazil ch5sc08_66d96bb2:

#   lu "How dare she?!"
    lu "Como ela se atreve?!"

# game/chapters/chapter5/script/ch5sc08.rpy:925
translate brazil ch5sc08_eef48c1f:

#   lu "Now she’s just sitting there all happy with herself!"
    lu "Agora ela está simplesmente sentada ali, toda feliz consigo mesma!"

# game/chapters/chapter5/script/ch5sc08.rpy:926
translate brazil ch5sc08_3858e2ee:

#   lu "If she thinks she's getting away with this... she's got another thing coming!"
    lu "Se ela pensa que vai se safar dessa... está muito enganada!"

# game/chapters/chapter5/script/ch5sc08.rpy:928
translate brazil ch5sc08_6ac5ad44:

#   al "We need to figure out a way to break that hex. But how? I've heard every spell has a loophole..."
    al "Precisamos descobrir um jeito de quebrar essa maldição. Mas como? Ouvi dizer que toda magia tem uma brecha..."

# game/chapters/chapter5/script/ch5sc08.rpy:929
translate brazil ch5sc08_fc93e50d:

#   al "Right now, she has the advantage. So... we have to do something she isn't anticpating."
    al "Neste momento, ela está em vantagem. Então... temos que fazer algo que ela não esteja prevendo."

# game/chapters/chapter5/script/ch5sc08.rpy:931
translate brazil ch5sc08_60b26d7e:

#   lu "Hmh? What do you mean?"
    lu "Hum? O que você quer dizer?"

# game/chapters/chapter5/script/ch5sc08.rpy:933
translate brazil ch5sc08_0af083ac:

#   al "[mc]. He’s unknown to her. He's our wildcard."
    al "[mc] Ele é um desconhecido para ela. Ele é a nossa carta na manga."

# game/chapters/chapter5/script/ch5sc08.rpy:935
translate brazil ch5sc08_35fa632b:

#   lu "Alice... you’re a genius! A true genius!"
    lu "Alice... você é um gênio! Um verdadeiro gênio!"

# game/chapters/chapter5/script/ch5sc08.rpy:936
translate brazil ch5sc08_d9940804:

#   al "I am? I mean, I am!"
    al "Eu sou? Quer dizer, eu sou!"

# game/chapters/chapter5/script/ch5sc08.rpy:938
translate brazil ch5sc08_d4b04fd6:

#   lu "Why didn’t I think of it sooner? When I felt his magic, it’s was many times more potent than any I’ve felt before!"
    lu "Por que não pensei nisso antes? Quando senti a magia dele, foi muitas vezes mais potente do que qualquer outra que já senti!"

# game/chapters/chapter5/script/ch5sc08.rpy:939
translate brazil ch5sc08_f9f79740:

#   lu "Rose has never dealt with someone like him before. Nobody has."
    lu "Rose nunca lidou com alguém como ele antes. Ninguém lidou."

# game/chapters/chapter5/script/ch5sc08.rpy:941
translate brazil ch5sc08_46defca8:

#   al "What are you doing?"
    al "O que você está fazendo?"

# game/chapters/chapter5/script/ch5sc08.rpy:943
translate brazil ch5sc08_30c5bda2:

#   lu "Rose is guarded by magic inside the guild. So, I’ll put a magical tracker just outside it."
    lu "Rose está protegida por magia dentro da guilda. Então, vou colocar um rastreador mágico bem na entrada."

# game/chapters/chapter5/script/ch5sc08.rpy:944
translate brazil ch5sc08_d016470a:

#   lu "It will identify who’s leaving and latch on to them when they do."
    lu "O sistema identificará quem está saindo e se aproveitará dessas pessoas quando isso acontecer."

# game/chapters/chapter5/script/ch5sc08.rpy:946
translate brazil ch5sc08_25c7b2f1:

#   al "Will it work? You said she’s guarded by magic?"
    al "Vai funcionar? Você disse que ela está protegida por magia?"

# game/chapters/chapter5/script/ch5sc08.rpy:948
translate brazil ch5sc08_862869eb:

#   lu "Only within the guild. She’s put up powerful seals to block out magical interference from outside."
    lu "Somente dentro da guilda. Ela ergueu selos poderosos para bloquear interferências mágicas externas."

# game/chapters/chapter5/script/ch5sc08.rpy:949
translate brazil ch5sc08_f1aa5e2e:

#   lu "But when she leaves ..."
    lu "Mas quando ela for embora..."

# game/chapters/chapter5/script/ch5sc08.rpy:951
translate brazil ch5sc08_a6d3b38e:

#   al "Those seals won't be able to protect her."
    al "Essas focas não serão capazes de protegê-la."

# game/chapters/chapter5/script/ch5sc08.rpy:953
translate brazil ch5sc08_4329e05b:

#   lu "Exactly!! Let’s get to it!"
    lu "Exatamente!! Vamos começar!"

# game/chapters/chapter5/script/ch5sc08.rpy:954
translate brazil ch5sc08_f52685f2:

#   lu "I’ll begin working on the tracking spell, and you’re on [mc] duty!"
    lu "Vou começar a trabalhar no feitiço de rastreamento, e você fica com ele. [mc] obrigação!"

# game/chapters/chapter5/script/ch5sc08.rpy:958
translate brazil ch5sc08_0c5540a0:

#   al_t "[mc] duty... Maybe I’ll get some time alone with him..."
    al_t "[mc] dever... Talvez eu consiga um tempo a sós com ele..."

# game/chapters/chapter5/script/ch5sc08.rpy:960
translate brazil ch5sc08_1f691b57:

#   al_t "Maybe he’ll... touch me again."
    al_t "Talvez ele... me toque de novo."

# game/chapters/chapter5/script/ch5sc08.rpy:961
translate brazil ch5sc08_0f722d9d:

#   al_t "Touch me... down there, b-between my legs."
    al_t "Me toque... lá embaixo, entre as minhas pernas."

# game/chapters/chapter5/script/ch5sc08.rpy:962
translate brazil ch5sc08_79a4dfad:

#   al_t "Heavens! I can feel myself tingling just thinking about it!"
    al_t "Nossa! Só de pensar nisso já me dá um arrepio!"

# game/chapters/chapter5/script/ch5sc08.rpy:964
translate brazil ch5sc08_38d3f678:

#   lu "Alice? Get going!"
    lu "Alice? Vamos lá!"

# game/chapters/chapter5/script/ch5sc08.rpy:965
translate brazil ch5sc08_f1d6cf91:

#   al "Huh? Oh! Right. Going!"
    al "Hã? Ah! Certo. Indo!"

# game/chapters/chapter5/script/ch5sc08.rpy:980
translate brazil ch5sc08_1c9ebd68:

#   el "*Giggling* What is this place? It’s so beautiful!"
    el "*Risos* Que lugar é esse? É tão lindo!"

# game/chapters/chapter5/script/ch5sc08.rpy:982
translate brazil ch5sc08_0bbc09f6:

#   mc "It’s our destination."
    mc "É o nosso destino."

# game/chapters/chapter5/script/ch5sc08.rpy:983
translate brazil ch5sc08_0aa8acde:

#   el "Really? We’re having our date here?"
    el "Sério? Nosso encontro vai ser aqui?"

# game/chapters/chapter5/script/ch5sc08.rpy:985
translate brazil ch5sc08_6f00bc44:

#   mc "Mhm. You don’t like it?"
    mc "Hum. Você não gosta?"

# game/chapters/chapter5/script/ch5sc08.rpy:988
translate brazil ch5sc08_5ef7a86b:

#   "In an instant Eliza appears right in front of you."
    "Num instante, Eliza aparece bem na sua frente."

# game/chapters/chapter5/script/ch5sc08.rpy:990
translate brazil ch5sc08_583a89fe:

#   el "I adore it!"
    el "Eu adorei!"

# game/chapters/chapter5/script/ch5sc08.rpy:992
translate brazil ch5sc08_e203a65b:

#   el "I can’t believe you found such an amazing spot! We have it all to ourselves!"
    el "Não acredito que você encontrou um lugar tão incrível! Temos ele só para nós!"

# game/chapters/chapter5/script/ch5sc08.rpy:994
translate brazil ch5sc08_1a73f505:

#   el "Where is this, even? We’ve walked a few hours to get here from the capital."
    el "Onde é isso, afinal? Caminhamos algumas horas desde a capital para chegar aqui."

# game/chapters/chapter5/script/ch5sc08.rpy:996
translate brazil ch5sc08_11dca62b:

#   mc "It’s our home."
    mc "É a nossa casa."

# game/chapters/chapter5/script/ch5sc08.rpy:1000
translate brazil ch5sc08_f7f6f22e:

#   el "{b}*Gasps* WAIT!{/b} You mean?!"
    el "{b}*Suspiros* ESPERA!{/b} Você quer dizer?!"

# game/chapters/chapter5/script/ch5sc08.rpy:1002
translate brazil ch5sc08_860fa5d4:

#   mc "This is the land granted by our deed."
    mc "Esta é a terra concedida por nossa escritura."

# game/chapters/chapter5/script/ch5sc08.rpy:1004
translate brazil ch5sc08_fa9b5435:

#   el "A-All this is ours? Is it true?!"
    el "Tudo isso é nosso? É verdade?!"

# game/chapters/chapter5/script/ch5sc08.rpy:1006
translate brazil ch5sc08_fcda637b:

#   mc "All that you see, and then some... a small part of it even reaches the shore."
    mc "Tudo isso que você vê, e muito mais... uma pequena parte chega até à costa."

# game/chapters/chapter5/script/ch5sc08.rpy:1007
translate brazil ch5sc08_9598683a:

#   mc "The property is quite sizeable. I thought we could spend our date exploring it."
    mc "A propriedade é bastante grande. Pensei que poderíamos passar nosso encontro explorando-a."

# game/chapters/chapter5/script/ch5sc08.rpy:1010
translate brazil ch5sc08_3b0faefb:

#   el "{b}BEST IDEA EVERRR!!{/b}"
    el "{b}A MELHOR IDEIA DE SEMPRE!!{/b}"

# game/chapters/chapter5/script/ch5sc08.rpy:1011
translate brazil ch5sc08_08695a3b:

#   el "Happy!"
    el "Feliz!"

# game/chapters/chapter5/script/ch5sc08.rpy:1012
translate brazil ch5sc08_e1361057:

#   el "*Squeezes tightly* I'm so happy!"
    el "*Aperta com força* Estou tão feliz!"

# game/chapters/chapter5/script/ch5sc08.rpy:1013
translate brazil ch5sc08_6b4af4ca:

#   mct "{i}I had a feeling she would like this.{/i}"
    mct "{i}Eu tinha a sensação de que ela gostaria disso.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1015
translate brazil ch5sc08_59a14237:

#   el "What should we explore first?!"
    el "O que devemos explorar primeiro?!"

# game/chapters/chapter5/script/ch5sc08.rpy:1017
translate brazil ch5sc08_61058740:

#   mc "I asked Borri about this area, since he has traveled these parts before."
    mc "Perguntei a Borri sobre essa região, já que ele já havia viajado por essas paragens."

# game/chapters/chapter5/script/ch5sc08.rpy:1018
translate brazil ch5sc08_c0db597d:

#   mc "He told me about some nearby spots that are on our land, which I’m sure you’ll like."
    mc "Ele me falou sobre alguns lugares próximos que ficam em nossas terras, que tenho certeza que você vai gostar."

# game/chapters/chapter5/script/ch5sc08.rpy:1020
translate brazil ch5sc08_990f5541:

#   el "Please tell me I’m not dreaming? I feel like this is a dream!"
    el "Por favor, me diga que não estou sonhando? Tenho a sensação de que estou sonhando!"

# game/chapters/chapter5/script/ch5sc08.rpy:1022
translate brazil ch5sc08_59fc871b:

#   mc "*Chuckles* You’re not dreaming..."
    mc "*Risos* Você não está sonhando..."

# game/chapters/chapter5/script/ch5sc08.rpy:1023
translate brazil ch5sc08_afca9248:

#   mc "I’ve also prepared a little something for us to eat later."
    mc "Também preparei algo para comermos mais tarde."

# game/chapters/chapter5/script/ch5sc08.rpy:1025
translate brazil ch5sc08_5e9a6db3:

#   el "But... we didn’t bring anything with us?"
    el "Mas... nós não trouxemos nada conosco?"

# game/chapters/chapter5/script/ch5sc08.rpy:1027
translate brazil ch5sc08_319f5e6e:

#   mc "I came here earlier, after I spoke with Borri."
    mc "Cheguei aqui mais cedo, depois de falar com Borri."

# game/chapters/chapter5/script/ch5sc08.rpy:1028
translate brazil ch5sc08_b5e498ec:

#   mc "I wanted to scout the area so we didn’t just wander aimlessly."
    mc "Eu queria explorar a área para que não ficássemos vagando sem rumo."

# game/chapters/chapter5/script/ch5sc08.rpy:1030
translate brazil ch5sc08_02d4870a:

#   el "H-How? ... Superspeed! Right! *Giggles*"
    el "C-Como? ... Supervelocidade! Isso mesmo! *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:1032
translate brazil ch5sc08_b667a76a:

#   mc "Who would’ve guessed I'd use it to set up dates with a beautiful girl."
    mc "Quem diria que eu usaria isso para marcar encontros com uma garota tão linda?"

# game/chapters/chapter5/script/ch5sc08.rpy:1037
translate brazil ch5sc08_632b037e:

#   el "{b}I love you!{/b}"
    el "{b}Eu te amo!{/b}"

# game/chapters/chapter5/script/ch5sc08.rpy:1038
translate brazil ch5sc08_afa26ae8:

#   mc "And I love you."
    mc "E eu te amo."

# game/chapters/chapter5/script/ch5sc08.rpy:1040
translate brazil ch5sc08_4f906460:

#   mc "Now, let’s get a move on."
    mc "Vamos lá, vamos começar."

# game/chapters/chapter5/script/ch5sc08.rpy:1041
translate brazil ch5sc08_e5e01ad5:

#   mc "There’s plenty for us to see before the sun goes down."
    mc "Há muito para vermos antes do pôr do sol."

# game/chapters/chapter5/script/ch5sc08.rpy:1043
translate brazil ch5sc08_844b3415:

#   el "Lead on! *Giggles*"
    el "Vamos lá! *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:1045
translate brazil ch5sc08_40e19f86:

#   el "I want to see everything!"
    el "Quero ver tudo!"

# game/chapters/chapter5/script/ch5sc08.rpy:1054
translate brazil ch5sc08_25274c0f:

#   ldt "Aaahh... I wonder if he’ll visit me again soon?"
    ldt "Ahhh... Será que ele vai me visitar de novo em breve?"

# game/chapters/chapter5/script/ch5sc08.rpy:1055
translate brazil ch5sc08_9c176461:

#   ldt "Next time, we’ll have some good fun! *Snickers*"
    ldt "Da próxima vez, vamos nos divertir muito! *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:1057
translate brazil ch5sc08_15a2e028:

#   ld "Maybe I’ll finally get to bite him?!"
    ld "Talvez eu finalmente consiga mordê-lo?!"

# game/chapters/chapter5/script/ch5sc08.rpy:1058
translate brazil ch5sc08_61ab9953:

#   ld "It’s only fair that I get to taste him... Mhhh. I've been very generous to him."
    ld "É justo que eu possa prová-lo... Mhhh. Fui muito generosa com ele."

# game/chapters/chapter5/script/ch5sc08.rpy:1060
translate brazil ch5sc08_6618b2b6:

#   ld "It’s my duty to be a good... influence. *Snickers*"
    ld "É meu dever ser uma boa... influência. *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:1061
translate brazil ch5sc08_cf467dda:

#   ld "If he behaves... maybe Mh-hm... I’ll let him have a taste as well?"
    ld "Se ele se comportar... talvez... hum... eu deixe ele provar também?"

# game/chapters/chapter5/script/ch5sc08.rpy:1063
translate brazil ch5sc08_fb26824e:

#   ld "Who am I kidding? I’ll let him taste even if he’s naughty... *Snickers*"
    ld "Quem eu quero enganar? Vou deixar ele provar, mesmo que ele se comporte mal... *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:1064
translate brazil ch5sc08_3abad5f6:

#   ld "I've never mated before... 6000 years is a long time to fly solo."
    ld "Nunca me acasalei antes... 6000 anos é muito tempo para voar sozinho."

# game/chapters/chapter5/script/ch5sc08.rpy:1065
translate brazil ch5sc08_95a3b234:

#   ld "I'll have to be sure [mc] really is suitable."
    ld "Preciso ter certeza. [mc] É realmente adequado."

# game/chapters/chapter5/script/ch5sc08.rpy:1067
translate brazil ch5sc08_f6feaa52:

#   ld "..."
    ld "..."

# game/chapters/chapter5/script/ch5sc08.rpy:1071
translate brazil ch5sc08_4c689009:

#   ld "Oh, joy. Buzzkill is here."
    ld "Ah, que maravilha. Estraga-prazeres à vista."

# game/chapters/chapter5/script/ch5sc08.rpy:1072
translate brazil ch5sc08_b21475a9:

#   ld "Maia! Dearest, what a pleasure. What brings you to these parts?"
    ld "Maia! Querida, que prazer! O que a traz a estas bandas?"

# game/chapters/chapter5/script/ch5sc08.rpy:1074
translate brazil ch5sc08_1c7870ef:

#   mai "Skip the pleasantries, Lucid. You know very well why I’m here!"
    mai "Deixe as formalidades de lado, Lucid. Você sabe muito bem por que estou aqui!"

# game/chapters/chapter5/script/ch5sc08.rpy:1075
translate brazil ch5sc08_0fdb7491:

#   mai "[mc]..."
    mai "[mc]..."

# game/chapters/chapter5/script/ch5sc08.rpy:1077
translate brazil ch5sc08_3800657e:

#   mai "You sent him to me! You know full well what I went through after I was sundered from him!"
    mai "Você o enviou para mim! Você sabe muito bem o que eu passei depois que fui separada dele!"

# game/chapters/chapter5/script/ch5sc08.rpy:1078
translate brazil ch5sc08_f57e8798:

#   mai "You know what his father will do to me if he finds out!"
    mai "Você sabe o que o pai dele vai fazer comigo se descobrir!"

# game/chapters/chapter5/script/ch5sc08.rpy:1080
translate brazil ch5sc08_e39e01bd:

#   ld "I don’t understand why you’re so upset?"
    ld "Não entendo por que você está tão chateado(a)?"

# game/chapters/chapter5/script/ch5sc08.rpy:1081
translate brazil ch5sc08_9572780a:

#   ld "You finally got to be reunited with [mc] after all these years."
    ld "Você finalmente conseguiu se reencontrar com [mc] Depois de todos esses anos."

# game/chapters/chapter5/script/ch5sc08.rpy:1082
translate brazil ch5sc08_d49cbb63:

#   ld "I did you a favor."
    ld "Eu te fiz um favor."

# game/chapters/chapter5/script/ch5sc08.rpy:1084
translate brazil ch5sc08_45e68158:

#   mai "*Scoffs* Favor? You twist things as usual. Once Castiel finds out, I'll cease to exist!"
    mai "*Zomba* Favor? Você distorce as coisas como sempre. Quando Castiel descobrir, eu deixarei de existir!"

# game/chapters/chapter5/script/ch5sc08.rpy:1087
translate brazil ch5sc08_1a4d2599:

#   mai "*Groans* Arrgh!!"
    mai "*Geme* Argh!!"

# game/chapters/chapter5/script/ch5sc08.rpy:1088
translate brazil ch5sc08_f6aee0f5:

#   ld "You forget who you’re talking to, Maia."
    ld "Você se esquece com quem está falando, Maia."

# game/chapters/chapter5/script/ch5sc08.rpy:1090
translate brazil ch5sc08_8e5c4540:

#   ld "Bursting in here with that attitude? Towards me?"
    ld "Entrando aqui com essa atitude? Comigo?"

# game/chapters/chapter5/script/ch5sc08.rpy:1091
translate brazil ch5sc08_45e97578:

#   ld "*Scoffs* I’ve disintegrated others for far less."
    ld "*Risos* Já desintegrei outros por muito menos."

# game/chapters/chapter5/script/ch5sc08.rpy:1092
translate brazil ch5sc08_1cfe410b:

#   ld "You’re lucky I actually like you, Maia."
    ld "Você tem sorte de eu realmente gostar de você, Maia."

# game/chapters/chapter5/script/ch5sc08.rpy:1093
translate brazil ch5sc08_25dafccb:

#   ld "You’re like a little sister to me, which is the only reason you’re still alive."
    ld "Você é como uma irmãzinha para mim, e essa é a única razão pela qual você ainda está viva."

# game/chapters/chapter5/script/ch5sc08.rpy:1095
translate brazil ch5sc08_2c6ed216:

#   ld "Now sit down and listen."
    ld "Agora sente-se e ouça."

# game/chapters/chapter5/script/ch5sc08.rpy:1097
translate brazil ch5sc08_5365a0f0:

#   "Released from Lucid's grasp, Maia makes her way over and takes a seat."
    "Libertada das garras de Lucid, Maia se aproxima e se senta."

# game/chapters/chapter5/script/ch5sc08.rpy:1099
translate brazil ch5sc08_5cb0369c:

#   mai "Forgive my impertinence."
    mai "Perdoe minha impertinência."

# game/chapters/chapter5/script/ch5sc08.rpy:1100
translate brazil ch5sc08_33ab9a2e:

#   mai "My emotions got the better of me."
    mai "Minhas emoções me dominaram."

# game/chapters/chapter5/script/ch5sc08.rpy:1102
translate brazil ch5sc08_8b3548ba:

#   ld "*Snickers* Don’t be so dramatic! All is forgiven."
    ld "*Risos* Não seja tão dramático! Está tudo perdoado."

# game/chapters/chapter5/script/ch5sc08.rpy:1104
translate brazil ch5sc08_05383c47:

#   ld "Now, as for why I sent [mc] to you..."
    ld "Agora, quanto ao motivo pelo qual enviei [mc] para você..."

# game/chapters/chapter5/script/ch5sc08.rpy:1106
translate brazil ch5sc08_ffe27d4e:

#   ld "He came to me asking for help. Help that only you could provide."
    ld "Ele veio até mim pedindo ajuda. Ajuda que só você poderia lhe dar."

# game/chapters/chapter5/script/ch5sc08.rpy:1107
translate brazil ch5sc08_417a3c46:

#   ld "I know full well how broken you were when his father sundered your guardianship."
    ld "Sei perfeitamente o quanto você ficou devastada quando o pai dele rompeu sua guarda."

# game/chapters/chapter5/script/ch5sc08.rpy:1109
translate brazil ch5sc08_800b1cdc:

#   ld "I know how empty you’ve felt since then. Such bonds were never meant to be broken."
    ld "Sei o vazio que você sentiu desde então. Esses laços nunca deveriam ter sido rompidos."

# game/chapters/chapter5/script/ch5sc08.rpy:1111
translate brazil ch5sc08_62195e31:

#   ld "So, when I saw an opportunity for the two of you to reunite?"
    ld "Então, quando surgiu a oportunidade para vocês dois se reencontrarem?"

# game/chapters/chapter5/script/ch5sc08.rpy:1112
translate brazil ch5sc08_b43ac877:

#   ld "For you to see for yourself what a fine young man he’s grown into?"
    ld "Para você ver por si mesmo o jovem exemplar em que ele se tornou?"

# game/chapters/chapter5/script/ch5sc08.rpy:1114
translate brazil ch5sc08_338769aa:

#   ld "It was as much for you, as it was for him."
    ld "Era tanto para você quanto para ele."

# game/chapters/chapter5/script/ch5sc08.rpy:1115
translate brazil ch5sc08_4e20cbc1:

#   ld "You did enjoy the reunion, right? Of course you did."
    ld "Você gostou do reencontro, não é? Claro que sim."

# game/chapters/chapter5/script/ch5sc08.rpy:1116
translate brazil ch5sc08_d3293a5e:

#   ld "You've been lost and emotionless since the sundering."
    ld "Você está perdido e sem emoções desde a separação."

# game/chapters/chapter5/script/ch5sc08.rpy:1117
translate brazil ch5sc08_b136ed1e:

#   ld "But now here you are, bursting into my home, full of anger."
    ld "Mas agora você está aqui, invadindo minha casa, cheio de raiva."

# game/chapters/chapter5/script/ch5sc08.rpy:1118
translate brazil ch5sc08_e346cc95:

#   ld "Meeting with [mc] has brought your heart back to life, hasn't it?"
    ld "Reunião com [mc] Isso trouxe seu coração de volta à vida, não é?"

# game/chapters/chapter5/script/ch5sc08.rpy:1120
translate brazil ch5sc08_2dfb7450:

#   mai "I... *Sigh* I did enjoy it."
    mai "Eu... *Suspiro* Eu gostei."

# game/chapters/chapter5/script/ch5sc08.rpy:1121
translate brazil ch5sc08_6c17646b:

#   mai "It was everything I’ve longed for."
    mai "Era tudo o que eu sempre desejei."

# game/chapters/chapter5/script/ch5sc08.rpy:1123
translate brazil ch5sc08_a8e9dd3b:

#   mai "I felt a cold veil lift from my heart as soon as I saw him."
    mai "Senti um véu frio se dissipar do meu coração assim que o vi."

# game/chapters/chapter5/script/ch5sc08.rpy:1124
translate brazil ch5sc08_0ad760d5:

#   mai "Seeing him in my garden... I was fighting back tears of joy the whole time."
    mai "Ao vê-lo no meu jardim... fiquei lutando contra as lágrimas de alegria o tempo todo."

# game/chapters/chapter5/script/ch5sc08.rpy:1125
translate brazil ch5sc08_5c066e61:

#   mai "He actually saw me! He spoke to me for the first time!"
    mai "Ele realmente me viu! Ele falou comigo pela primeira vez!"

# game/chapters/chapter5/script/ch5sc08.rpy:1127
translate brazil ch5sc08_862dfe9f:

#   ld "See? You were able to help him and finally reconnect with him as you should always have been allowed to do."
    ld "Viu? Você conseguiu ajudá-lo e finalmente se reconectar com ele, como sempre deveria ter sido permitido."

# game/chapters/chapter5/script/ch5sc08.rpy:1128
translate brazil ch5sc08_7f2cb6d4:

#   ld "Win-win, if you ask me!"
    ld "Na minha opinião, é uma situação em que todos saem ganhando!"

# game/chapters/chapter5/script/ch5sc08.rpy:1130
translate brazil ch5sc08_3d89f4e2:

#   mai "But his father-"
    mai "Mas seu pai-"

# game/chapters/chapter5/script/ch5sc08.rpy:1132
translate brazil ch5sc08_39af6846:

#   ld "Ugh. You just let me worry about him."
    ld "Aff. Você só me deixa me preocupar com ele."

# game/chapters/chapter5/script/ch5sc08.rpy:1133
translate brazil ch5sc08_740f8e92:

#   ld "He won’t find out. But even if he does, I won't allow him to erase you from existence."
    ld "Ele não vai descobrir. Mas mesmo que descubra, não permitirei que ele apague você da existência."

# game/chapters/chapter5/script/ch5sc08.rpy:1135
translate brazil ch5sc08_d7f9155f:

#   mai "Lucid... I don’t know what to say."
    mai "Lúcido... Não sei o que dizer."

# game/chapters/chapter5/script/ch5sc08.rpy:1137
translate brazil ch5sc08_dae40174:

#   ld "Please... being a thorn in his father’s side is one of my favorite hobbies. *Snickers*"
    ld "Por favor... ser uma pedra no sapato do pai dele é um dos meus passatempos favoritos. *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:1139
translate brazil ch5sc08_17ae81c5:

#   ld "*Sighs heavily* You know... I've always known he'd eventually become part of our lives."
    ld "*Suspira profundamente* Sabe... eu sempre soube que ele acabaria fazendo parte das nossas vidas."

# game/chapters/chapter5/script/ch5sc08.rpy:1140
translate brazil ch5sc08_11ca3045:

#   ld "But now that I’ve finally met him..."
    ld "Mas agora que finalmente o conheci..."

# game/chapters/chapter5/script/ch5sc08.rpy:1141
translate brazil ch5sc08_cf18b603:

#   ld "I just want to hide him far away and let the rest of the world deal with itself."
    ld "Só quero escondê-lo bem longe e deixar que o resto do mundo se resolva sozinho."

# game/chapters/chapter5/script/ch5sc08.rpy:1143
translate brazil ch5sc08_46c6bf0c:

#   mai "You want to protect him too."
    mai "Você também quer protegê-lo."

# game/chapters/chapter5/script/ch5sc08.rpy:1144
translate brazil ch5sc08_d199b8a7:

#   mai "It’s only natural to want to keep him safe from what’s coming."
    mai "É natural querer protegê-lo do que está por vir."

# game/chapters/chapter5/script/ch5sc08.rpy:1145
translate brazil ch5sc08_0f30266a:

#   mai "I’d be lying if I said I didn’t feel the same. Just hide him away from everything, and be with him always."
    mai "Eu estaria mentindo se dissesse que não sinto o mesmo. Simplesmente o esconda de tudo e fique com ele sempre."

# game/chapters/chapter5/script/ch5sc08.rpy:1147
translate brazil ch5sc08_8a97a4e2:

#   ld "Why don’t we? Two gorgeous goddesses like us? He’d have the time of his life!"
    ld "Por que não? Duas deusas maravilhosas como nós? Ele se divertiria muito!"

# game/chapters/chapter5/script/ch5sc08.rpy:1148
translate brazil ch5sc08_32be6357:

#   ld "We could conjure anything he’d ever wish for... anything at all."
    ld "Poderíamos conjurar qualquer coisa que ele desejasse... absolutamente qualquer coisa."

# game/chapters/chapter5/script/ch5sc08.rpy:1150
translate brazil ch5sc08_684cbcd0:

#   mai "*Sigh* As amazing as that would be, we both know what would happen if we did."
    mai "*Suspiro* Por mais incrível que isso fosse, nós dois sabemos o que aconteceria se fizéssemos isso."

# game/chapters/chapter5/script/ch5sc08.rpy:1151
translate brazil ch5sc08_a8344af5:

#   mai "Instead of fearing for [mc]’s safety, we have to believe in him. Guide him, if need be."
    mai "Em vez de temer por [mc] Para garantir a segurança dele, precisamos acreditar nele. Guiá-lo, se necessário."

# game/chapters/chapter5/script/ch5sc08.rpy:1155
translate brazil ch5sc08_31369184:

#   ld "I hate it when you’re right."
    ld "Eu detesto quando você está certo."

# game/chapters/chapter5/script/ch5sc08.rpy:1157
translate brazil ch5sc08_193eb1af:

#   mai "When he was with me, I felt it. He’s very close to his first Ascension."
    mai "Quando ele estava comigo, eu sentia isso. Ele está muito perto de sua primeira Ascensão."

# game/chapters/chapter5/script/ch5sc08.rpy:1159
translate brazil ch5sc08_44423552:

#   ld "Ooohhh! Now that’s proper interesting!"
    ld "Uau! Isso sim é interessante!"

# game/chapters/chapter5/script/ch5sc08.rpy:1161
translate brazil ch5sc08_bdc6550c:

#   ld "Wait... to sense that, you'd have had to be touching him!"
    ld "Espere... para sentir isso, você teria que tê-lo tocado!"

# game/chapters/chapter5/script/ch5sc08.rpy:1162
translate brazil ch5sc08_c8a090d5:

#   ld "You totally had a lustful encounter with [mc], didn't you?!"
    ld "Você definitivamente teve um encontro lascivo com [mc] Não é mesmo?!"

# game/chapters/chapter5/script/ch5sc08.rpy:1164
translate brazil ch5sc08_03077d2a:

#   mai "L-Lustful? Don’t be ridiculous! He-He was just resting his head in my lap."
    mai "L-Lúcido? Não seja ridículo! Ele-Ele estava apenas descansando a cabeça no meu colo."

# game/chapters/chapter5/script/ch5sc08.rpy:1166
translate brazil ch5sc08_a60258d3:

#   ld "Just resting in your lap, eh? Then why are you blushing! *Snickers* He's not a little boy any more."
    ld "Só descansando no seu colo, né? Então por que você está corando? *Risinhos* Ele não é mais um menininho."

# game/chapters/chapter5/script/ch5sc08.rpy:1167
translate brazil ch5sc08_f721f3f9:

#   mai "..."
    mai "..."

# game/chapters/chapter5/script/ch5sc08.rpy:1168
translate brazil ch5sc08_672edcb7:

#   ld "His head must’ve been close to your breasts! You must have thought about what it would feel like..."
    ld "A cabeça dele devia estar bem perto dos seus seios! Você deve ter imaginado como seria a sensação..."

# game/chapters/chapter5/script/ch5sc08.rpy:1170
translate brazil ch5sc08_d02d14f9:

#   mai "S-Stop! What are you even saying?! I couldn’t possibly! He and I..."
    mai "P-Pare! O que você está dizendo?! Eu jamais faria isso! Ele e eu..."

# game/chapters/chapter5/script/ch5sc08.rpy:1171
translate brazil ch5sc08_30879347:

#   mai "What could have been between us, was lost. The sundering..."
    mai "O que poderia ter existido entre nós, se perdeu. A separação..."

# game/chapters/chapter5/script/ch5sc08.rpy:1173
translate brazil ch5sc08_665113af:

#   ld "You’re still the goddess of fertility."
    ld "Você continua sendo a deusa da fertilidade."

# game/chapters/chapter5/script/ch5sc08.rpy:1174
translate brazil ch5sc08_894d9df8:

#   ld "And his father needed some of your essence to impregnate a mortal woman..."
    ld "E o pai dele precisava de um pouco da sua essência para engravidar uma mulher mortal..."

# game/chapters/chapter5/script/ch5sc08.rpy:1176
translate brazil ch5sc08_3de9d49e:

#   ld "Which means [mc] still carries your essence inside him."
    ld "O que significa [mc] Ele ainda carrega sua essência dentro de si."

# game/chapters/chapter5/script/ch5sc08.rpy:1177
translate brazil ch5sc08_2cbef96c:

#   ld "Your lives are bound, no matter what else was broken during the sundering."
    ld "Suas vidas estão ligadas, não importa o que mais tenha sido quebrado durante a separação."

# game/chapters/chapter5/script/ch5sc08.rpy:1180
translate brazil ch5sc08_89c920be:

#   mai "Okay, stop! Don’t put such thoughts in my head!"
    mai "Ok, pare! Não coloque esses pensamentos na minha cabeça!"

# game/chapters/chapter5/script/ch5sc08.rpy:1182
translate brazil ch5sc08_a1aa63de:

#   ld "Your instinct to nurture him again must’ve been in overdrive."
    ld "Seu instinto de cuidar dele novamente devia estar a mil por hora."

# game/chapters/chapter5/script/ch5sc08.rpy:1183
translate brazil ch5sc08_6174db76:

#   mai "......"
    mai "......"

# game/chapters/chapter5/script/ch5sc08.rpy:1184
translate brazil ch5sc08_798081cc:

#   mait "{i}She’s right... I wanted to nurture him so badly. I remembered how it felt before...{/i}"
    mait "{i}Ela tem razão... Eu queria tanto cuidar dele. Lembrei-me de como era antes...{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1185
translate brazil ch5sc08_48603310:

#   mait "{i}It took everything I had to let him leave. I started missing him again before he even went through my portal.{/i}"
    mait "{i}Custou-me muito deixar que ele partisse. Comecei a sentir saudades dele antes mesmo de ele atravessar o meu portal.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1187
translate brazil ch5sc08_a7713ead:

#   mai "Lucid, enough! I can’t hear this anymore."
    mai "Lucid, chega! Não aguento mais ouvir isso."

# game/chapters/chapter5/script/ch5sc08.rpy:1189
translate brazil ch5sc08_0e2bb2b5:

#   ld "Stop suppressing your instincts, your feelings."
    ld "Pare de reprimir seus instintos, seus sentimentos."

# game/chapters/chapter5/script/ch5sc08.rpy:1190
translate brazil ch5sc08_cf6723bf:

#   ld "Your feelings for [mc] are perfectly valid. His father ruined a sacred bond that he had no business breaking."
    ld "Seus sentimentos por [mc] são perfeitamente válidas. O pai dele destruiu um laço sagrado que não tinha o direito de romper."

# game/chapters/chapter5/script/ch5sc08.rpy:1192
translate brazil ch5sc08_24c2a8ca:

#   ld "He sundered your guardianship... he stole away your protection, your guiding light..."
    ld "Ele rompeu com a sua proteção... ele roubou-lhe a sua segurança, a sua luz guia..."

# game/chapters/chapter5/script/ch5sc08.rpy:1193
translate brazil ch5sc08_bca35eb9:

#   ld "He stole away the nurturing warmth young [mc] needed. "
    ld "Ele roubou o calor acolhedor da jovem. [mc] necessário. "

# game/chapters/chapter5/script/ch5sc08.rpy:1194
translate brazil ch5sc08_99fce70c:

#   ld "And he stole the future you should have shared together."
    ld "E ele roubou o futuro que vocês deveriam ter compartilhado."

# game/chapters/chapter5/script/ch5sc08.rpy:1195
translate brazil ch5sc08_4af929fc:

#   ld "For that, I will never forgive him. But now you have a chance to reclaim what was taken from you both."
    ld "Por isso, jamais o perdoarei. Mas agora você tem a chance de recuperar o que foi tirado de vocês dois."

# game/chapters/chapter5/script/ch5sc08.rpy:1197
translate brazil ch5sc08_0756ee38:

#   ld "To finally be what you were always meant to be. What you’ve longed for."
    ld "Para finalmente ser o que você sempre deveria ter sido. Aquilo que você tanto desejou."

# game/chapters/chapter5/script/ch5sc08.rpy:1199
translate brazil ch5sc08_39543e7d:

#   mai "Why? Why would you care about this? About my feelings?"
    mai "Por quê? Por que você se importaria com isso? Com ​​os meus sentimentos?"

# game/chapters/chapter5/script/ch5sc08.rpy:1201
translate brazil ch5sc08_b6b1b259:

#   ld "It’s not that I care about your feelings. At least, not so much that I'd go to such lengths."
    ld "Não é que eu me importe com seus sentimentos. Pelo menos, não a ponto de chegar a esse ponto."

# game/chapters/chapter5/script/ch5sc08.rpy:1202
translate brazil ch5sc08_6488d742:

#   ld "But I do care about [mc]. Him being reunited with his... with you."
    ld "Mas eu me importo com [mc] Ele se reencontrando com... com você."

# game/chapters/chapter5/script/ch5sc08.rpy:1203
translate brazil ch5sc08_9a2f4ecf:

#   ld "It's because I care about his happiness."
    ld "É porque me preocupo com a felicidade dele."

# game/chapters/chapter5/script/ch5sc08.rpy:1205
translate brazil ch5sc08_4f859246:

#   ld "I believe he deserves it."
    ld "Acredito que ele mereça."

# game/chapters/chapter5/script/ch5sc08.rpy:1206
translate brazil ch5sc08_0ce81e5f:

#   ld "No... Not just deserves it, he's owed it. And I believe he's going to need you."
    ld "Não... Ele não só merece, como tem direito a isso. E acredito que ele vai precisar de você."

# game/chapters/chapter5/script/ch5sc08.rpy:1208
translate brazil ch5sc08_bba79040:

#   mai "Castiel, he... he won't allow this."
    mai "Castiel... ele não vai permitir isso."

# game/chapters/chapter5/script/ch5sc08.rpy:1210
translate brazil ch5sc08_9551b0a8:

#   ld "I told you to leave him to me."
    ld "Eu te disse para deixá-lo comigo."

# game/chapters/chapter5/script/ch5sc08.rpy:1212
translate brazil ch5sc08_75fffd71:

#   ld "The next time you see [mc], I want you to remember all the regret and pain you’ve felt since the sundering."
    ld "Na próxima vez que você vir [mc] Quero que você se lembre de todo o arrependimento e dor que sentiu desde a separação."

# game/chapters/chapter5/script/ch5sc08.rpy:1213
translate brazil ch5sc08_6ba3c13f:

#   ld "All the times you’ve wanted to break free from his father’s will and be reunited with him."
    ld "Todas as vezes que você quis se libertar do testamento do pai dele e se reunir com ele."

# game/chapters/chapter5/script/ch5sc08.rpy:1215
translate brazil ch5sc08_01df5b35:

#   ld "All the years you’ve spent alone? Longing for him to be in your arms?"
    ld "Todos esses anos que você passou sozinha? Ansiando por tê-lo em seus braços?"

# game/chapters/chapter5/script/ch5sc08.rpy:1216
translate brazil ch5sc08_d4a5f548:

#   ld "To watch him grow up into the wonderful man you could love?"
    ld "Ver ele crescer e se tornar o homem maravilhoso que você poderia amar?"

# game/chapters/chapter5/script/ch5sc08.rpy:1217
translate brazil ch5sc08_59228998:

#   ld "Take all of it. All the pain, all the regret, all the hurt, all the memories, and turn them into courage."
    ld "Pegue tudo isso. Toda a dor, todo o arrependimento, toda a mágoa, todas as lembranças, e transforme tudo em coragem."

# game/chapters/chapter5/script/ch5sc08.rpy:1218
translate brazil ch5sc08_aec5be0e:

#   ld "Courage enough to tell [mc] how you feel about him."
    ld "Coragem suficiente para contar [mc] Como você se sente em relação a ele."

# game/chapters/chapter5/script/ch5sc08.rpy:1220
translate brazil ch5sc08_c2b2f543:

#   mai "What if... What if he doesn’t accept me?"
    mai "E se... E se ele não me aceitar?"

# game/chapters/chapter5/script/ch5sc08.rpy:1222
translate brazil ch5sc08_a963dfbc:

#   ld "Bullshit."
    ld "Bobagem."

# game/chapters/chapter5/script/ch5sc08.rpy:1223
translate brazil ch5sc08_852ebbe6:

#   ld "The connection between the two of you may have been sundered, but it still echoes in both your hearts."
    ld "A ligação entre vocês dois pode ter sido rompida, mas ainda ressoa em ambos os corações."

# game/chapters/chapter5/script/ch5sc08.rpy:1225
translate brazil ch5sc08_9a25b979:

#   ld "That bond still matters to him."
    ld "Esse vínculo ainda é importante para ele."

# game/chapters/chapter5/script/ch5sc08.rpy:1226
translate brazil ch5sc08_d72114e8:

#   ld "He’s been alone most of his life..."
    ld "Ele passou a maior parte da vida sozinho..."

# game/chapters/chapter5/script/ch5sc08.rpy:1228
translate brazil ch5sc08_7fc55e83:

#   ld "His human parents were killed by those who wish him harm."
    ld "Seus pais humanos foram mortos por aqueles que desejavam lhe fazer mal."

# game/chapters/chapter5/script/ch5sc08.rpy:1230
translate brazil ch5sc08_beea2005:

#   ld "He longs for that lost connection, even if he doesn’t realize it."
    ld "Ele anseia por essa conexão perdida, mesmo que não se dê conta disso."

# game/chapters/chapter5/script/ch5sc08.rpy:1231
translate brazil ch5sc08_76aa5ec9:

#   ld "And I suspect he felt it again when he was with you."
    ld "E suspeito que ele sentiu isso novamente quando estava com você."

# game/chapters/chapter5/script/ch5sc08.rpy:1233
translate brazil ch5sc08_6b9b275c:

#   mai "You really believe he'll still want me? I abandoned him."
    mai "Você realmente acha que ele ainda vai me querer? Eu o abandonei."

# game/chapters/chapter5/script/ch5sc08.rpy:1234
translate brazil ch5sc08_eed4b825:

#   mai "I don't have any right to come back into his life..."
    mai "Eu não tenho nenhum direito de voltar para a vida dele..."

# game/chapters/chapter5/script/ch5sc08.rpy:1236
translate brazil ch5sc08_41f5827e:

#   ld "Abandoned him?"
    ld "Abandonou-o?"

# game/chapters/chapter5/script/ch5sc08.rpy:1237
translate brazil ch5sc08_4bbf54a2:

#   ld "You'd have been obliterated if you'd defied his father back then."
    ld "Você teria sido aniquilado se tivesse desafiado o pai dele naquela época."

# game/chapters/chapter5/script/ch5sc08.rpy:1239
translate brazil ch5sc08_cbc2b0c5:

#   ld "What would that have achieved?"
    ld "O que isso teria alcançado?"

# game/chapters/chapter5/script/ch5sc08.rpy:1240
translate brazil ch5sc08_d5218adf:

#   ld "By stepping back when you did, you preserved the chance to be together now, to heal."
    ld "Ao recuar no momento certo, você preservou a chance de estarem juntos agora, de se curarem."

# game/chapters/chapter5/script/ch5sc08.rpy:1242
translate brazil ch5sc08_0598c067:

#   ld "Castiel may have taken away the chance for you to fulfill your role as guardian and to nuture him during his youth."
    ld "Castiel pode ter lhe roubado a chance de cumprir seu papel de guardião e de cuidar dele durante sua juventude."

# game/chapters/chapter5/script/ch5sc08.rpy:1243
translate brazil ch5sc08_22c6d1b4:

#   ld "However, after [mc] came of age..."
    ld "No entanto, depois [mc] atingiu a maioridade..."

# game/chapters/chapter5/script/ch5sc08.rpy:1244
translate brazil ch5sc08_8a4d2741:

#   ld "You were supposed to become {b}soulbound{/b}, a union or marriage between gods, as you know."
    ld "Você deveria se tornar {b} almas unidas{/b}, uma união ou casamento entre deuses, como você sabe."

# game/chapters/chapter5/script/ch5sc08.rpy:1246
translate brazil ch5sc08_ee7b82c0:

#   ld "If his father hadn't changed his mind, and sundered your bond, you and [mc] would've been wed by now."
    ld "Se o pai dele não tivesse mudado de ideia e rompido o laço entre vocês, você e [mc] já teriam se casado."

# game/chapters/chapter5/script/ch5sc08.rpy:1248
translate brazil ch5sc08_483ca636:

#   mai "I know... Lucid, I know... I think about it every day."
    mai "Eu sei... Lúcido, eu sei... Penso nisso todos os dias."

# game/chapters/chapter5/script/ch5sc08.rpy:1249
translate brazil ch5sc08_2718c623:

#   mai "It has filled my every thought since I was forced to leave him..."
    mai "Isso tem ocupado todos os meus pensamentos desde que fui obrigada a deixá-lo..."

# game/chapters/chapter5/script/ch5sc08.rpy:1251
translate brazil ch5sc08_6296a1aa:

#   ld "It's not too late, your initial role and bond were broken prematurely, but now you have the chance."
    ld "Ainda não é tarde demais, seu papel e vínculo iniciais foram rompidos prematuramente, mas agora você tem uma nova chance."

# game/chapters/chapter5/script/ch5sc08.rpy:1252
translate brazil ch5sc08_7dd8dbe0:

#   ld "A chance to reconnect with [mc], to grow your bond into what it was meant to be."
    ld "Uma oportunidade para se reconectar com [mc], para que seu vínculo cresça e se torne aquilo que deveria ser."

# game/chapters/chapter5/script/ch5sc08.rpy:1254
translate brazil ch5sc08_e642cca8:

#   ld "Now, go. Await your next reunion and retake control of your life when the chance arises."
    ld "Agora, vá. Aguarde o próximo reencontro e retome o controle da sua vida quando a oportunidade surgir."

# game/chapters/chapter5/script/ch5sc08.rpy:1256
translate brazil ch5sc08_015299ba:

#   mai "Lucid... I *Sighs heavily* Thank you. I really needed this."
    mai "Lúcido... *Suspira profundamente* Obrigada. Eu realmente precisava disso."

# game/chapters/chapter5/script/ch5sc08.rpy:1264
translate brazil ch5sc08_ebde302d:

#   fy "Oh Alice... You should’ve seen them! They were... magnificent!"
    fy "Oh, Alice... Você devia tê-los visto! Eles eram... magníficos!"

# game/chapters/chapter5/script/ch5sc08.rpy:1265
translate brazil ch5sc08_69fb662b:

#   fy "Like the fluffiest pillows, like the best fertilized melons! Like-"
    fy "Como os travesseiros mais fofinhos, como os melões mais bem fertilizados! Como-"

# game/chapters/chapter5/script/ch5sc08.rpy:1267
translate brazil ch5sc08_ece906ba:

#   al "*Laughs* I get it! She has big boobs!"
    al "*Risos* Entendi! Ela tem seios grandes!"

# game/chapters/chapter5/script/ch5sc08.rpy:1269
translate brazil ch5sc08_5d7eb0ba:

#   fy "Mhm! I’m glad you understand me!"
    fy "Hum! Que bom que você me entende!"

# game/chapters/chapter5/script/ch5sc08.rpy:1271
translate brazil ch5sc08_5c505f42:

#   al "I don’t... I really don’t!"
    al "Eu não... Eu realmente não!"

# game/chapters/chapter5/script/ch5sc08.rpy:1273
translate brazil ch5sc08_b00b4be7:

#   fy "She kept pointing them at me and smiling! She must’ve heard what a renowned Deck-Captain I am."
    fy "Ela não parava de apontar para mim e sorrir! Ela deve ter ouvido falar do renomado Capitão de Convés que eu sou."

# game/chapters/chapter5/script/ch5sc08.rpy:1274
translate brazil ch5sc08_6c9f865b:

#   fy "And now... now she wants my mast!"
    fy "E agora... agora ela quer meu mastro!"

# game/chapters/chapter5/script/ch5sc08.rpy:1275
translate brazil ch5sc08_5eef8fad:

#   fy "And it’s perfect! She works at the tavern so she can provide me with ale too!"
    fy "E é perfeito! Ela trabalha na taverna, então também pode me fornecer cerveja!"

# game/chapters/chapter5/script/ch5sc08.rpy:1277
translate brazil ch5sc08_0e6bd552:

#   al "Was [mc] there?"
    al "Era [mc] lá?"

# game/chapters/chapter5/script/ch5sc08.rpy:1279
translate brazil ch5sc08_9e009bb1:

#   fy "Yeah, why?"
    fy "Sim, por quê?"

# game/chapters/chapter5/script/ch5sc08.rpy:1281
translate brazil ch5sc08_76a004b5:

#   al "Then she was smiling and pointing her boobs at him, not you."
    al "Então ela estava sorrindo e apontando os seios para ele, não para você."

# game/chapters/chapter5/script/ch5sc08.rpy:1283
translate brazil ch5sc08_b938d90a:

#   fy "Pssh! You don’t know what you’re talking about."
    fy "Pff! Você não sabe do que está falando."

# game/chapters/chapter5/script/ch5sc08.rpy:1285
translate brazil ch5sc08_e0caf386:

#   al "Trust me, I know."
    al "Acredite em mim, eu sei."

# game/chapters/chapter5/script/ch5sc08.rpy:1287
translate brazil ch5sc08_99d8a8f7:

#   al "Now, can we get back to my question?"
    al "Agora, podemos voltar à minha pergunta?"

# game/chapters/chapter5/script/ch5sc08.rpy:1289
translate brazil ch5sc08_d27f274d:

#   fy "What did you ask again?"
    fy "O que você perguntou mesmo?"

# game/chapters/chapter5/script/ch5sc08.rpy:1291
translate brazil ch5sc08_96656dcd:

#   al "Do you know where [mc] is? Luna and I could use his help."
    al "Você sabe onde [mc] É isso? Luna e eu poderíamos usar a ajuda dele."

# game/chapters/chapter5/script/ch5sc08.rpy:1293
translate brazil ch5sc08_7d83805a:

#   fy "Sure! He’s on a date with Eliza."
    fy "Claro! Ele está num encontro com a Eliza."

# game/chapters/chapter5/script/ch5sc08.rpy:1294
translate brazil ch5sc08_b83324e3:

#   fy "She was looking absolutely ravishing! Her hair was down and she had a sexy new outfit."
    fy "Ela estava absolutamente deslumbrante! Seu cabelo estava solto e ela usava uma roupa nova e sexy."

# game/chapters/chapter5/script/ch5sc08.rpy:1296
translate brazil ch5sc08_9746100d:

#   al "Oh! They’re finally on their date, huh? Eliza has been talking about it forever."
    al "Ah! Eles finalmente estão no encontro, né? A Eliza vem falando disso há séculos."

# game/chapters/chapter5/script/ch5sc08.rpy:1297
translate brazil ch5sc08_f58affc3:

#   al "Her eyes practically beam like stars whenever she mentions it.”"
    al "Os olhos dela praticamente brilham como estrelas sempre que ela menciona isso.\""

# game/chapters/chapter5/script/ch5sc08.rpy:1299
translate brazil ch5sc08_74f8afbb:

#   fy "Hah, you can say that again!"
    fy "Hah, pode crer!"

# game/chapters/chapter5/script/ch5sc08.rpy:1301
translate brazil ch5sc08_96fdfff4:

#   al_t "{i}I’ll wait until tomorrow to talk to [mc], then. If I were ever on a date with him...{/i}"
    al_t "{i}Vou esperar até amanhã para falar com [mc] Então, se eu algum dia saísse em um encontro com ele...{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1302
translate brazil ch5sc08_3f680cb0:

#   al_t "{i}... the last thing I’d want, would be for someone to interrupt us.{/i}"
    al_t "{i}... a última coisa que eu gostaria seria que alguém nos interrompesse.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1304
translate brazil ch5sc08_2232e191:

#   fy "Anyway, as I was saying earlier, she was wearing this blue wench dress. But I could tell her curves were-"
    fy "Enfim, como eu estava dizendo antes, ela estava usando um vestido azul de camponesa. Mas dava para perceber que suas curvas eram..."

# game/chapters/chapter5/script/ch5sc08.rpy:1306
translate brazil ch5sc08_754d358e:

#   sy "Oh goodie! My two favorite adventurers!"
    sy "Que ótimo! Meus dois aventureiros favoritos!"

# game/chapters/chapter5/script/ch5sc08.rpy:1307
translate brazil ch5sc08_e8852eee:

#   al "We’re not-"
    al "Nós não somos-"

# game/chapters/chapter5/script/ch5sc08.rpy:1309
translate brazil ch5sc08_984aee8e:

#   fy "Shhh, Alice! Don’t interrupt the cute fairy!"
    fy "Shhh, Alice! Não interrompa a fada fofa!"

# game/chapters/chapter5/script/ch5sc08.rpy:1311
translate brazil ch5sc08_d54edfae:

#   sy "A quest just arrived this morning, and since everyone else is busy ..."
    sy "Uma missão acabou de chegar esta manhã, e como todos os outros estão ocupados..."

# game/chapters/chapter5/script/ch5sc08.rpy:1312
translate brazil ch5sc08_0c2b5e30:

#   sy "I was hoping that the two of you-"
    sy "Eu esperava que vocês dois..."

# game/chapters/chapter5/script/ch5sc08.rpy:1313
translate brazil ch5sc08_e1d23e8f:

#   fy "We’ll do whatever it takes! Count on us!"
    fy "Faremos o que for preciso! Contem conosco!"

# game/chapters/chapter5/script/ch5sc08.rpy:1315
translate brazil ch5sc08_d77532eb:

#   al "Sylph, we aren’t even official members of the guild."
    al "Sylph, nós nem sequer somos membros oficiais da guilda."

# game/chapters/chapter5/script/ch5sc08.rpy:1317
translate brazil ch5sc08_ffa2d109:

#   sy "Fear not! This quest is unranked. Normally it'd be used to test new recruits, but Milton already passed his initiation."
    sy "Não se preocupe! Esta missão não possui classificação. Normalmente, ela seria usada para testar novos recrutas, mas Milton já passou por sua iniciação."

# game/chapters/chapter5/script/ch5sc08.rpy:1318
translate brazil ch5sc08_2bb802cd:

#   sy "And despite being unranked, this one actually has a decent bounty attached to it."
    sy "E apesar de não ter classificação, esta tem uma recompensa razoável associada a ela."

# game/chapters/chapter5/script/ch5sc08.rpy:1320
translate brazil ch5sc08_d68cd42e:

#   fy "Did you hear that, Alice? Someone needs our help! And there’s a bounty!"
    fy "Você ouviu isso, Alice? Alguém precisa da nossa ajuda! E tem uma recompensa!"

# game/chapters/chapter5/script/ch5sc08.rpy:1322
translate brazil ch5sc08_bbb7b289:

#   sy "Here you go! Apparently there’s a thief on the loose."
    sy "Aqui está! Aparentemente, há um ladrão à solta."

# game/chapters/chapter5/script/ch5sc08.rpy:1323
translate brazil ch5sc08_894b3a50:

#   fy "A thief? What did they steal? Royal diamonds? Treasure from the capital bank?"
    fy "Um ladrão? O que ele roubou? Diamantes da realeza? Tesouro do banco central?"

# game/chapters/chapter5/script/ch5sc08.rpy:1324
translate brazil ch5sc08_d17a9806:

#   sy "Panties."
    sy "Calcinhas."

# game/chapters/chapter5/script/ch5sc08.rpy:1326
translate brazil ch5sc08_2668c6d4:

#   fy "Sylph! Thank you for this gift! Truly!"
    fy "Sylph! Muito obrigada por este presente! De verdade!"

# game/chapters/chapter5/script/ch5sc08.rpy:1327
translate brazil ch5sc08_899d17b3:

#   al "*Giggles* Goodness..."
    al "*Risos* Nossa..."

# game/chapters/chapter5/script/ch5sc08.rpy:1328
translate brazil ch5sc08_9e1d8477:

#   fy "I- We, will do everything in our power to stop this thief! And I’ll confiscate any stolen goods!"
    fy "Nós faremos tudo ao nosso alcance para deter esse ladrão! E confiscarei todos os bens roubados!"

# game/chapters/chapter5/script/ch5sc08.rpy:1330
translate brazil ch5sc08_daff96cd:

#   sy "I knew I could count on you!"
    sy "Eu sabia que podia contar com você!"

# game/chapters/chapter5/script/ch5sc08.rpy:1331
translate brazil ch5sc08_4372c190:

#   sy "As an added bonus, I’ll even bestow a seduction spell on you when the quest is complete!"
    sy "Como bônus adicional, lançarei um feitiço de sedução sobre você quando a missão estiver concluída!"

# game/chapters/chapter5/script/ch5sc08.rpy:1333
translate brazil ch5sc08_a4777925:

#   fy "S-Seduction spell?"
    fy "Feitiço de sedução S?"

# game/chapters/chapter5/script/ch5sc08.rpy:1336
translate brazil ch5sc08_c8b855f6:

#   fy "{b}YIPPIEE!{/b} Let’s go Alice! We’ve got a panty stealing scoundrel to catch!"
    fy "{b}EBA!{/b} Vamos lá, Alice! Temos que pegar um ladrão de calcinhas!"

# game/chapters/chapter5/script/ch5sc08.rpy:1337
translate brazil ch5sc08_dc7d1f31:

#   al "..."
    al "..."

# game/chapters/chapter5/script/ch5sc08.rpy:1339
translate brazil ch5sc08_a7f754b1:

#   al "There’s no seduction spell, is there?"
    al "Não existe feitiço de sedução, existe?"

# game/chapters/chapter5/script/ch5sc08.rpy:1340
translate brazil ch5sc08_3ebe18ad:

#   sy "*Snickers* Heh-heh-heh! Do I look like a succubus to you?"
    sy "*Risos* Heh-heh-heh! Por acaso eu pareço uma súcubo para você?"

# game/chapters/chapter5/script/ch5sc08.rpy:1341
translate brazil ch5sc08_e15d3b81:

#   al "*Laughs* Sylph... you're terrible!"
    al "*Risos* Sylph... você é terrível!"

# game/chapters/chapter5/script/ch5sc08.rpy:1351
translate brazil ch5sc08_a2a41505:

#   el "*Excitedly* I can’t believe my eyes?!"
    el "*Com muita empolgação* Não acredito no que estou vendo?!"

# game/chapters/chapter5/script/ch5sc08.rpy:1352
translate brazil ch5sc08_78ed9cc3:

#   el "What is this place? An oasis? A lagoon? Paradise!?"
    el "Que lugar é este? Um oásis? Uma lagoa? Um paraíso!?"

# game/chapters/chapter5/script/ch5sc08.rpy:1354
translate brazil ch5sc08_9cdcf2da:

#   mc "Honestly, I’m not sure how to categorize it."
    mc "Sinceramente, não sei bem como categorizá-lo."

# game/chapters/chapter5/script/ch5sc08.rpy:1355
translate brazil ch5sc08_28cc5060:

#   mc "But the plants here are similar to those on Inmortui, or Looter’s bay."
    mc "Mas as plantas aqui são semelhantes às de Inmortui, ou Baía dos Saqueadores."

# game/chapters/chapter5/script/ch5sc08.rpy:1357
translate brazil ch5sc08_e856ce35:

#   el "You’re right. The plants are different! I’ve never seen these types of bushes or trees before."
    el "Você tem razão. As plantas são diferentes! Nunca vi esse tipo de arbusto ou árvore antes."

# game/chapters/chapter5/script/ch5sc08.rpy:1358
translate brazil ch5sc08_38a424a5:

#   el "Is this really on our land? If you’re jesting, I’ll be heartbroken."
    el "Isso está mesmo em nossas terras? Se você estiver brincando, ficarei arrasado(a)."

# game/chapters/chapter5/script/ch5sc08.rpy:1360
translate brazil ch5sc08_0fa8d903:

#   mc "*Chuckles* Your heart is safe, we're definitely still on our land."
    mc "*Risos* Seu coração está a salvo, com certeza ainda estamos em nossas terras."

# game/chapters/chapter5/script/ch5sc08.rpy:1361
translate brazil ch5sc08_6a65ad35:

#   mc "I was quite surprised myself, there must be a micro-climate here."
    mc "Eu mesmo fiquei bastante surpreso, deve haver um microclima aqui."

# game/chapters/chapter5/script/ch5sc08.rpy:1363
translate brazil ch5sc08_bafeb551:

#   el "This means... I can?"
    el "Isso significa que... eu posso?"

# game/chapters/chapter5/script/ch5sc08.rpy:1365
translate brazil ch5sc08_bfd371b5:

#   mc "Go on... It’s all ours."
    mc "Vamos lá... É tudo nosso."

# game/chapters/chapter5/script/ch5sc08.rpy:1366
translate brazil ch5sc08_755c1262:

#   el "*Giggling excitedly* Yay!"
    el "*Risos animados* Oba!"

# game/chapters/chapter5/script/ch5sc08.rpy:1372
translate brazil ch5sc08_cdeb78d4:

#   el "I’ll just... be over here..."
    el "Eu vou... ficar por aqui..."

# game/chapters/chapter5/script/ch5sc08.rpy:1373
translate brazil ch5sc08_681adb19:

#   el "Wet and naked."
    el "Molhada e nua."

# game/chapters/chapter5/script/ch5sc08.rpy:1375
translate brazil ch5sc08_f4d82c4b:

#   el "And no peeking!"
    el "E nada de espiar!"

# game/chapters/chapter5/script/ch5sc08.rpy:1380
translate brazil ch5sc08_877fe2ae:

#   mc "*Chuckles* We both know that you getting naked is a surefire way to make me look."
    mc "*Risos* Nós dois sabemos que você ficar nua é uma maneira infalível de me fazer olhar."

# game/chapters/chapter5/script/ch5sc08.rpy:1381
translate brazil ch5sc08_b500db22:

#   el "*Giggles* You could at least pretend to be a gentleman!"
    el "*Risos* Você podia ao menos fingir ser um cavalheiro!"

# game/chapters/chapter5/script/ch5sc08.rpy:1386
translate brazil ch5sc08_3fd8cf65:

#   mc "Sure, just hurry up..."
    mc "Claro, só se apresse..."

# game/chapters/chapter5/script/ch5sc08.rpy:1390
translate brazil ch5sc08_6d6e49f2:

#   elt "{i}This reminds me of the first time he saw me naked...{/i}"
    elt "{i}Isso me lembra da primeira vez que ele me viu nua...{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1396
translate brazil ch5sc08_3e444f17:

#   elt "{i}I was so scared to let him see me back then. But my fear went away after I saw his goofy expression. *Giggles*{/i}"
    elt "{i}Eu estava morrendo de medo de deixar ele me ver naquela época. Mas meu medo passou depois que vi a carinha boba dele. *Risos*{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1400
translate brazil ch5sc08_0ce5482b:

#   elt "{i}I wasn't a girl any more... I was a woman, being watched hungrily by the man she fancied.{/i}"
    elt "{i}Eu não era mais uma menina... eu era uma mulher, sendo observada com desejo pelo homem por quem estava apaixonada.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1404
translate brazil ch5sc08_a65ed05b:

#   el "*Giggles softly* The breeze feels so nice!"
    el "*Risinhos suaves* A brisa é tão agradável!"

# game/chapters/chapter5/script/ch5sc08.rpy:1406
translate brazil ch5sc08_08123b82:

#   elt "{i}I can't believe this is really ours. And we only walked a short distance from the center of our land.{/i}"
    elt "{i}Não consigo acreditar que isto seja realmente nosso. E nós caminhamos apenas uma curta distância do centro de nossas terras.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1407
translate brazil ch5sc08_e179e517:

#   elt "{i}We'll be able to bathe here as often as we like. No more going days between baths because it costs coin.{/i}"
    elt "{i}Poderemos tomar banho aqui quantas vezes quisermos. Chega de ficar dias sem tomar banho porque é preciso pagar.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:1409
translate brazil ch5sc08_89888dec:

#   el "Well? Aren't you going to join me?"
