# game/chapters/chapter5/script/ch5sc08.rpy:9
translate brazil ch5sc08_96a4bb1b:

#   mct "{i}That took longer than expected. Thankfully, Borri was able to lend me a hand.{/i}"
    mct "{i}Isso demorou mais do que o esperado. Felizmente, Borri pôde me ajudar.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:10
translate brazil ch5sc08_5590a48d:

#   mct "{i}I've never organized a surprise for anyone before... hopefully she likes it.{/i}"
    mct "{i}Nunca organizei uma surpresa para ninguém antes... espero que ela goste.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:12
translate brazil ch5sc08_0b0ad901:

#   mct "{i}Oh? She’s already up. I suppose it’s well past noon, after all.{/i}"
    mct "{i}Ah? Ela já está acordada. Acho que já passou do meio-dia, afinal.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:14
translate brazil ch5sc08_46dba5bd:

#   mct "{i}Above me!{/i}"
    mct "{i}Acima de mim!{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:19
translate brazil ch5sc08_74f71254:

#   el "Gotcha! *Giggles*"
    el "Te peguei! *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:20
translate brazil ch5sc08_ea4c6b46:

#   mc "*Groans* Urhh... Eliza..."
    mc "*Gemidos* Urhh... Eliza..."

# game/chapters/chapter5/script/ch5sc08.rpy:22
translate brazil ch5sc08_664728a8:

#   el "What took you so long?! Where have you been?"
    el "O que te atrasou tanto?! Onde você esteve?"

# game/chapters/chapter5/script/ch5sc08.rpy:23
translate brazil ch5sc08_b1c3d1ef:

#   el "You weren’t here when I woke up, so I went looking for you downstairs!"
    el "Você não estava aqui quando eu acordei, então fui te procurar lá embaixo!"

# game/chapters/chapter5/script/ch5sc08.rpy:25
translate brazil ch5sc08_1b6a527b:

#   mc "You went downstairs?"
    mc "Você desceu as escadas?"

# game/chapters/chapter5/script/ch5sc08.rpy:27
translate brazil ch5sc08_9800431c:

#   el "Uh-Huh! And since I couldn’t find you, I decided to have breakfast without you!"
    el "Uhum! E já que não consegui te encontrar, decidi tomar café da manhã sem você!"

# game/chapters/chapter5/script/ch5sc08.rpy:29
translate brazil ch5sc08_d1a1f778:

#   mc "Don’t tell me you ate someone?"
    mc "Não me diga que você comeu alguém?"

# game/chapters/chapter5/script/ch5sc08.rpy:31
translate brazil ch5sc08_e81a04cc:

#   el "Eeuuw! Gross!"
    el "Uau! Enorme!"

# game/chapters/chapter5/script/ch5sc08.rpy:33
translate brazil ch5sc08_c859da1f:

#   el "Bleughh!"
    el "Eca!"

# game/chapters/chapter5/script/ch5sc08.rpy:34
translate brazil ch5sc08_4cfdb85e:

#   mc "You haven’t felt the need to snack on someone? Rip open their neck and drain their blood?"
    mc "Você nunca sentiu vontade de devorar alguém? De rasgar o pescoço dessa pessoa e drenar seu sangue?"

# game/chapters/chapter5/script/ch5sc08.rpy:36
translate brazil ch5sc08_cf7c5479:

#   el "No! What the heck? That’s so gross!"
    el "Não! Que coisa horrível! Que nojo!"

# game/chapters/chapter5/script/ch5sc08.rpy:38
translate brazil ch5sc08_6ae987c8:

#   mct "{i}Looks like the purification worked: the thought of drinking people’s blood repels her.{/i}"
    mct "{i}Parece que a purificação funcionou: a ideia de beber sangue humano a repugna.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:39
translate brazil ch5sc08_a5341985:

#   mct "{i}She still needs my blood to complete the process, though. After that, she'll only be able to nourish herself from my blood.{/i}"
    mct "{i}Ela ainda precisa do meu sangue para completar o processo. Depois disso, ela só poderá se alimentar do meu sangue.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:41
translate brazil ch5sc08_dd6b8acd:

#   el "What?"
    el "O que?"

# game/chapters/chapter5/script/ch5sc08.rpy:43
translate brazil ch5sc08_17611eb1:

#   mc "I know you've already had one breakfast, but how would you feel about a proper breakfast?"
    mc "Eu sei que você já tomou um café da manhã, mas o que você acharia de um café da manhã completo?"

# game/chapters/chapter5/script/ch5sc08.rpy:45
translate brazil ch5sc08_25dc1fcb:

#   el "You mean..."
    el "Você quer dizer..."

# game/chapters/chapter5/script/ch5sc08.rpy:48
translate brazil ch5sc08_d23c379b:

#   el "Yes! {b}YES!{/b} Breakfaaaast! Yum!"
    el "Sim! {b} SIM!{/b} Café da manhã! Que delícia!"

# game/chapters/chapter5/script/ch5sc08.rpy:50
translate brazil ch5sc08_5bc37f0e:

#   el "Yum! Yum! Yummy! Finally! I’m so happy!"
    el "Hum! Hum! Que delícia! Finalmente! Estou tão feliz!"

# game/chapters/chapter5/script/ch5sc08.rpy:51
translate brazil ch5sc08_82138b4f:

#   mc "*Chuckles* Someones excited..."
    mc "*Risos* Alguém está animado..."

# game/chapters/chapter5/script/ch5sc08.rpy:53
translate brazil ch5sc08_f2c0a729:

#   el "Excited is an understatement! Up-Up! It’s breakfast time!"
    el "Dizer que estou animada é pouco! Vamos lá! É hora do café da manhã!"

# game/chapters/chapter5/script/ch5sc08.rpy:54
translate brazil ch5sc08_f40078ff:

#   mc "You’ll have to get off me first."
    mc "Primeiro você terá que sair de cima de mim."

# game/chapters/chapter5/script/ch5sc08.rpy:55
translate brazil ch5sc08_2125cf47:

#   el "R-Right! *Giggles*"
    el "C-Certo! *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:58
translate brazil ch5sc08_cfba01cc:

#   el "So, uhhh... How do we do this? Do I just bite you?"
    el "Então, hum... Como fazemos isso? Eu simplesmente te mordo?"

# game/chapters/chapter5/script/ch5sc08.rpy:59
translate brazil ch5sc08_a7d31f97:

#   mct "{i}Heh, look at her getting all nervous.{/i}"
    mct "{i}Hehe, olha só como ela está ficando nervosa.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:61
translate brazil ch5sc08_3f032140:

#   mc "You must be famished..."
    mc "Você deve estar faminto..."

# game/chapters/chapter5/script/ch5sc08.rpy:62
translate brazil ch5sc08_3c1a0010:

#   el "*Nods*"
    el "*Acena com a cabeça*"

# game/chapters/chapter5/script/ch5sc08.rpy:63
translate brazil ch5sc08_ac4e0b0c:

#   mc "Here, use my wrist."
    mc "Aqui, use meu pulso."

# game/chapters/chapter5/script/ch5sc08.rpy:65
translate brazil ch5sc08_96a12d2e:

#   "You roll up your sleeve and present her with your bare wrist."
    "Você arregaça a manga e mostra a ela seu pulso nu."

# game/chapters/chapter5/script/ch5sc08.rpy:66
translate brazil ch5sc08_1a3812a3:

#   "She whimpers slightly as your arm pushes against her breast."
    "Ela geme baixinho quando seu braço pressiona seu seio."

# game/chapters/chapter5/script/ch5sc08.rpy:68
translate brazil ch5sc08_d0fca21a:

#   elt "{i}Mhm... It’s happening. I’m- I’m going to feed on [mc].{/i}"
    elt "{i}Hum... Está acontecendo. Eu... eu vou me alimentar de [mc].{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:69
translate brazil ch5sc08_42b184ac:

#   elt "{i}He smells divine. His blood is going to be... delicious.{/i}"
    elt "{i}Ele tem um cheiro divino. O sangue dele vai ser... delicioso.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:71
translate brazil ch5sc08_68616c6c:

#   "She gently traces her fingers along your wrist, feeling the warm blood pumping beneath the surface."
    "Ela desliza os dedos delicadamente ao longo do seu pulso, sentindo o sangue quente pulsando sob a superfície."

# game/chapters/chapter5/script/ch5sc08.rpy:72
translate brazil ch5sc08_042acc89:

#   elt "{i}This moment has been on my mind constantly, ever since I awoke as a vampire ...{/i}"
    elt "{i}Esse momento não me sai da cabeça desde que acordei como vampiro...{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:74
translate brazil ch5sc08_6af37051:

#   el "*Inhales* Mmhm..."
    el "*Inspira* Hum..."

# game/chapters/chapter5/script/ch5sc08.rpy:75
translate brazil ch5sc08_73c63d7f:

#   elt "{i}I love him... so much.{/i}"
    elt "{i}Eu o amo... muito.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:77
translate brazil ch5sc08_1f55b463:

#   "She gently licks your wrist, preparing you for her bite."
    "Ela lambe delicadamente seu pulso, preparando você para a mordida."

# game/chapters/chapter5/script/ch5sc08.rpy:78
translate brazil ch5sc08_4a1ae26c:

#   "Her cute little tongue moves back and forth gently, almost soothing you before you feel her sharp fangs pierce your skin."
    "Sua linguinha delicada se move para frente e para trás suavemente, quase te acalmando, antes que você sinta suas presas afiadas perfurarem sua pele."

# game/chapters/chapter5/script/ch5sc08.rpy:80
translate brazil ch5sc08_50e168ea:

#   el "*Soft moan* Mmhm... Mm-Mh..."
    el "*Gemido suave* Mmhm... Mm-Mh..."

# game/chapters/chapter5/script/ch5sc08.rpy:81
translate brazil ch5sc08_743bc364:

#   mct "{i}This completes her purification. Maia said this will change her bloodline from Lucid... to me.{/i}"
    mct "{i}Isso completa sua purificação. Maia disse que isso mudará sua linhagem sanguínea de Lucid... para mim.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:82
translate brazil ch5sc08_8478e937:

#   mct "{i}She’s not a pureblood vampire of Lucid's bloodline any more. She's the first of a new kind instead.{/i}"
    mct "{i}Ela não é mais uma vampira de sangue puro da linhagem de Lucid. Em vez disso, ela é a primeira de uma nova espécie.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:84
translate brazil ch5sc08_1021a90f:

#   mct "{i}A purified vampire... reborn with my blood.{/i}"
    mct "{i}Um vampiro purificado... renascido com meu sangue.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:85
translate brazil ch5sc08_85f0b190:

#   mct "{i}All the benefits she had before, but no more bloodlust. No more loss of control.{/i}"
    mct "{i}Ela tinha todos os benefícios de antes, mas sem mais sede de sangue. Sem mais perda de controle.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:87
translate brazil ch5sc08_ec09277c:

#   el "*Moans softly* Mnhm... *Lick* Nnghh... *Sucks gently* Mh-Mh."
    el "*Geme baixinho* Mnhm... *Lambe* Nnghh... *Suga suavemente* Mh-Mh."

# game/chapters/chapter5/script/ch5sc08.rpy:96
translate brazil ch5sc08_1c1382d5:

#   "Eliza keeps sucking on your wrist for several minutes... gently biting and licking."
    "Eliza continua chupando seu pulso por vários minutos... mordendo e lambendo suavemente."

# game/chapters/chapter5/script/ch5sc08.rpy:98
translate brazil ch5sc08_6bf76391:

#   "She finally retracts her fangs, but her gentle sucking doesn’t stop."
    "Ela finalmente retrai suas presas, mas sua suave sucção não cessa."

# game/chapters/chapter5/script/ch5sc08.rpy:100
translate brazil ch5sc08_072a6184:

#   mct "{i}Heh... It’s like she’s instinctively trying to make me feel better.{/i}"
    mct "{i}Heh... É como se ela estivesse instintivamente tentando me fazer sentir melhor.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:102
translate brazil ch5sc08_4b7bd2dc:

#   "She gently licks the area clean, and to her surprise, the puncture wounds have vanished."
    "Ela lambe delicadamente a área, limpando-a, e para sua surpresa, as perfurações desapareceram."

# game/chapters/chapter5/script/ch5sc08.rpy:104
translate brazil ch5sc08_0bbc91f5:

#   el "Oh? There’s no wound?"
    el "Ah? Não há ferimento?"

# game/chapters/chapter5/script/ch5sc08.rpy:106
translate brazil ch5sc08_0eb3c22c:

#   "She traces her fingers over the area, but your skin is completely healed already."
    "Ela passa os dedos sobre a área, mas sua pele já está completamente cicatrizada."

# game/chapters/chapter5/script/ch5sc08.rpy:107
translate brazil ch5sc08_aed71958:

#   elt "{i}I can’t believe it. He said he'd increased his regeneration abilities on Inmortui, but this...{/i}"
    elt "{i}Não consigo acreditar. Ele disse que havia aumentado suas habilidades de regeneração em Inmortui, mas isso...{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:108
translate brazil ch5sc08_cf82ef27:

#   elt "{i}This means... I can feed and not hurt him!{/i}"
    elt "{i}Isso significa que... posso alimentá-lo sem machucá-lo!{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:110
translate brazil ch5sc08_53293f9a:

#   elt "{i}I did it. And I didn’t lose control. It wasn’t even hard to stop!{/i}"
    elt "{i}Eu consegui. E não perdi o controle. Nem foi difícil parar!{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:111
translate brazil ch5sc08_9186c58b:

#   elt "{i}All I felt was ... bliss. His blood made my mouth and lips tingle. I could feel his warmth and how much he cares for me.{/i}"
    elt "{i}Tudo o que eu sentia era... êxtase. O sangue dele fazia minha boca e meus lábios formigarem. Eu podia sentir seu calor e o quanto ele se importa comigo.{/i}"

# game/chapters/chapter5/script/ch5sc08.rpy:113
translate brazil ch5sc08_97db7366:

#   el "I... I didn’t hurt you?"
    el "Eu... eu não te machuquei?"

# game/chapters/chapter5/script/ch5sc08.rpy:115
translate brazil ch5sc08_550dd025:

#   mc "Don’t be silly. All I felt was something like a bee sting at the start. And it faded away as soon as you started sucking."
    mc "Não seja bobo. No começo, só senti uma espécie de picada de abelha. E passou assim que você começou a chupar."

# game/chapters/chapter5/script/ch5sc08.rpy:116
translate brazil ch5sc08_29bcbfea:

#   mc "How about you? How do you feel? Any cravings? Bloodlust? A desire to bathe in the blood of virgins?"
    mc "E você? Como se sente? Algum desejo específico? Sede de sangue? Vontade de se banhar no sangue de virgens?"

# game/chapters/chapter5/script/ch5sc08.rpy:119
translate brazil ch5sc08_fb08b20f:

#   el "Eeeuuwh!! I don't want to bathe in virgin blood! Gross!"
    el "Eca!! Não quero tomar banho em sangue de virgem! Que nojo!"

# game/chapters/chapter5/script/ch5sc08.rpy:120
translate brazil ch5sc08_6bed98ec:

#   el "Jerk! *Laughs*"
    el "Idiota! *Risos*"

# game/chapters/chapter5/script/ch5sc08.rpy:121
translate brazil ch5sc08_e0f5896a:

#   mc "*Laughs* I’ll take that as a no."
    mc "*Risos* Vou considerar isso como um não."

# game/chapters/chapter5/script/ch5sc08.rpy:123
translate brazil ch5sc08_cddb74b8:

#   el "[mc]... Thank you."
    el "[mc]... Obrigado."

# game/chapters/chapter5/script/ch5sc08.rpy:125
translate brazil ch5sc08_b1fbc875:

#   mc "You never have to thank me. Never."
    mc "Você nunca precisa me agradecer. Nunca."

# game/chapters/chapter5/script/ch5sc08.rpy:126
translate brazil ch5sc08_885597a0:

#   el "..."
    el "..."

# game/chapters/chapter5/script/ch5sc08.rpy:128
translate brazil ch5sc08_b1f881e2:

#   el "I may not have to, but I want to."
    el "Talvez eu não precise, mas quero."

# game/chapters/chapter5/script/ch5sc08.rpy:130
translate brazil ch5sc08_475a102b:

#   el "I can walk again, because of you."
    el "Eu consigo andar novamente, graças a você."

# game/chapters/chapter5/script/ch5sc08.rpy:131
translate brazil ch5sc08_9e739707:

#   el "At first it was a heavy price to pay..."
    el "No início, o preço a pagar era muito alto..."

# game/chapters/chapter5/script/ch5sc08.rpy:133
translate brazil ch5sc08_cf1dda4c:

#   el "But I paid that price willingly."
    el "Mas paguei esse preço de bom grado."

# game/chapters/chapter5/script/ch5sc08.rpy:134
translate brazil ch5sc08_78608edb:

#   el "I didn’t want to be a burden. Or to be left behind again."
    el "Eu não queria ser um fardo. Nem ser deixada para trás de novo."

# game/chapters/chapter5/script/ch5sc08.rpy:136
translate brazil ch5sc08_b582af75:

#   el "You’ve really been there for me, through it all."
    el "Você realmente esteve presente para mim em todos os momentos."

# game/chapters/chapter5/script/ch5sc08.rpy:138
translate brazil ch5sc08_ee607722:

#   el "As much as I've struggled with the whole vampirism thing, I could've accepted it as long as it meant being able to stay by your side."
    el "Por mais que eu tenha tido dificuldades com toda essa coisa de vampirismo, eu poderia ter aceitado, contanto que isso significasse poder ficar ao seu lado."

# game/chapters/chapter5/script/ch5sc08.rpy:140
translate brazil ch5sc08_5077d1a6:

#   el "But you saw how much I was struggling, and took it upon yourself to find a way to make it better."
    el "Mas você viu o quanto eu estava sofrendo e se encarregou de encontrar uma maneira de melhorar a situação."

# game/chapters/chapter5/script/ch5sc08.rpy:141
translate brazil ch5sc08_d40a6520:

#   el "I may not be human anymore... But today is the most human I’ve felt since all this started."
    el "Talvez eu não seja mais humano... Mas hoje foi o dia em que me senti mais humano desde que tudo isso começou."

# game/chapters/chapter5/script/ch5sc08.rpy:142
translate brazil ch5sc08_26f87d11:

#   el "All thanks to you. So... thank you, [mc]."
    el "Tudo graças a você. Então... muito obrigado! [mc]."

# game/chapters/chapter5/script/ch5sc08.rpy:144
translate brazil ch5sc08_0ed0a79f:

#   mc "You’re welcome. You know I’d do anything for you."
    mc "De nada. Você sabe que eu faria qualquer coisa por você."

# game/chapters/chapter5/script/ch5sc08.rpy:146
translate brazil ch5sc08_1a689d75:

#   el "And I, you."
    el "E eu, você."

# game/chapters/chapter5/script/ch5sc08.rpy:148
translate brazil ch5sc08_e9ac44ae:

#   el "*Sighs heavily* I suppose we should get ready and head to the guild?"
    el "*Suspira profundamente* Acho que devemos nos arrumar e ir para a guilda?"

# game/chapters/chapter5/script/ch5sc08.rpy:150
translate brazil ch5sc08_e9aa7950:

#   mc "You’re right. We do need to get ready to go..."
    mc "Você tem razão. Precisamos nos preparar para ir..."

# game/chapters/chapter5/script/ch5sc08.rpy:151
translate brazil ch5sc08_6ca719b4:

#   mc "But we’re not going to the guild."
    mc "Mas nós não vamos à guilda."

# game/chapters/chapter5/script/ch5sc08.rpy:153
translate brazil ch5sc08_34582d60:

#   el "W-What do you mean? Did you already pick up a quest while you were out?"
    el "O que você quer dizer? Você já aceitou alguma missão enquanto estava fora?"

# game/chapters/chapter5/script/ch5sc08.rpy:155
translate brazil ch5sc08_1f468ff2:

#   mc "No. We’re taking the day off. With all we’ve been through since we arrived in Luxenford..."
    mc "Não. Vamos tirar o dia de folga. Com tudo o que passamos desde que chegamos em Luxemburgo..."

# game/chapters/chapter5/script/ch5sc08.rpy:156
translate brazil ch5sc08_822239a4:

#   mc "We both deserve some time off. Besides, I've already planned everything."
    mc "Nós dois merecemos um tempo de folga. Além disso, eu já planejei tudo."

# game/chapters/chapter5/script/ch5sc08.rpy:157
translate brazil ch5sc08_4aab459e:

#   mc "So get that cute butt of yours all dressed up. We’re going out."
    mc "Então, vista esse seu bumbum lindo. Vamos sair."

# game/chapters/chapter5/script/ch5sc08.rpy:160
translate brazil ch5sc08_f79963be:

#   el "We’re going out? Oh. {b}OH!{/b} I have to get dressed!"
    el "Vamos sair? Ah. {b} OH!{/b} Preciso me vestir!"

# game/chapters/chapter5/script/ch5sc08.rpy:161
translate brazil ch5sc08_2eb02db0:

#   el "{b}*Excitedly* Our date! Finally!!{/b}"
    el "{b}*Com muita animação* Nosso encontro! Finalmente!!{/b}"

# game/chapters/chapter5/script/ch5sc08.rpy:163
translate brazil ch5sc08_8450c856:

#   el "You go wait downstairs! Quickly! We’re burning daylight here!"
    el "Vá esperar lá embaixo! Rápido! Estamos perdendo tempo!"

# game/chapters/chapter5/script/ch5sc08.rpy:164
translate brazil ch5sc08_26af3cd4:

#   mc "What? I can't even watch you get dressed for our date?"
    mc "O quê? Nem posso te ver se arrumando para o nosso encontro?"

# game/chapters/chapter5/script/ch5sc08.rpy:165
translate brazil ch5sc08_ec90efc7:

#   el "{b}NO!{/b} While you were away, I bought something just for this occasion."
    el "{b}NÃO!{/b} Enquanto você estava fora, comprei algo especialmente para esta ocasião."

# game/chapters/chapter5/script/ch5sc08.rpy:166
translate brazil ch5sc08_87dd9b68:

#   el "You have to wait downstairs to see it!"
    el "Você terá que esperar lá embaixo para ver!"

# game/chapters/chapter5/script/ch5sc08.rpy:167
translate brazil ch5sc08_ba6482eb:

#   mc "Alright, I’ll leave you to it. Just don’t take too long..."
    mc "Muito bem, vou deixar você em paz. Só não demore muito..."

