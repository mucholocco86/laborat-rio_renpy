translate brazil ch5sc11_0fa7302d:

#   qm "Would you mind if I... if I stayed with you for a little while?"
    qm "Você se importaria se eu... se eu ficasse com você por um tempinho?"

# game/chapters/chapter5/script/ch5sc11.rpy:2141
