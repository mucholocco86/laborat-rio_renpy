    am "Céus!"

# game/chapters/chapter5/script/ch5sc07.rpy:1539
translate brazil ch5sc07_23099635:

#   am "I wasn’t alone, okay?"
    am "Eu não estava sozinha, tá bem?"

# game/chapters/chapter5/script/ch5sc07.rpy:1541
translate brazil ch5sc07_5284e229:

#   bn "What do you mean you weren’t alone?"
    bn "Como assim você não estava sozinho?"

# game/chapters/chapter5/script/ch5sc07.rpy:1542
translate brazil ch5sc07_b968a884:

#   bn "Your handmaiden was still here at the palace."
    bn "Sua criada ainda estava aqui no palácio."

# game/chapters/chapter5/script/ch5sc07.rpy:1545
translate brazil ch5sc07_145f5c3b:

#   am "I was with [mc]."
    am "Eu estava com [mc]."

# game/chapters/chapter5/script/ch5sc07.rpy:1547
