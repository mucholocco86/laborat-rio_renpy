translate brazil ch5sc07_9b7e04d0:

#   fr "{b}EEEEH!{/b} W-W-What are you- you should! Should warn me before doing such thing!"
    fr "{b}EEEEH!{/b} WW-O que você está fazendo? Você deveria! Deveria ter me avisado antes de fazer uma coisa dessas!"

# game/chapters/chapter5/script/ch5sc07.rpy:991
translate brazil ch5sc07_345e4630:

#   mc "*Chuckles* What? Haven't seen a man naked before?"
    mc "*Risos* O quê? Nunca viu um homem nu antes?"

# game/chapters/chapter5/script/ch5sc07.rpy:993
translate brazil ch5sc07_abd752dc:

