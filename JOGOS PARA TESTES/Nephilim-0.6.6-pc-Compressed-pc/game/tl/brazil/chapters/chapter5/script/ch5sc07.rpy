    fr "Posso ser pequeno, mas... minha fúria é poderosa! E pare de balançar essa coisa!"

# game/chapters/chapter5/script/ch5sc07.rpy:1003
translate brazil ch5sc07_2ea85220:

#   fr "You may accidentally knock someone out!"
    fr "Você pode acabar nocauteando alguém sem querer!"

# game/chapters/chapter5/script/ch5sc07.rpy:1004
translate brazil ch5sc07_b0108a3a:

#   mc "*Chuckles* {i}She’s funny.{/i}"
    mc "*Risos* {i} Ela é engraçada.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:1005
translate brazil ch5sc07_8dfe901f:

#   mc "Well, I certainly don’t wish to incur your wrath. I’ll get right in!"
    mc "Bem, certamente não quero atrair sua ira. Vou entrar agora mesmo!"

# game/chapters/chapter5/script/ch5sc07.rpy:1007
translate brazil ch5sc07_0ef11eb2:

#   fr "You'd better! And you'd better behave while I’m washing you!"
    fr "É melhor mesmo! E é melhor você se comportar enquanto eu te lavo!"

# game/chapters/chapter5/script/ch5sc07.rpy:1008
translate brazil ch5sc07_142683e1:

#   mc "I’ll be on my best behavior."
    mc "Vou me comportar da melhor maneira possível."

# game/chapters/chapter5/script/ch5sc07.rpy:1010
translate brazil ch5sc07_4585aa4b:

#   mct "{i}Damn... the water feels amazing. I guess it has been a while since I had a proper bath.{/i}"
    mct "{i}Nossa... a água está uma delícia. Acho que já faz um tempo que não tomo um banho de verdade.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:1011
translate brazil ch5sc07_c56c6a4b:

#   fr "Sit tight and I’ll get to work."
    fr "Aguarde um instante que eu já vou começar a trabalhar."

# game/chapters/chapter5/script/ch5sc07.rpy:1013
translate brazil ch5sc07_170c0355:

#   mct "{i}Her touch is... delicate. Her tiny fingers feel like velvet.{/i}"
    mct "{i}Seu toque é... delicado. Seus dedinhos são macios como veludo.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:1015
translate brazil ch5sc07_42f7177c:

#   fr "Just relax and I’ll sponge you- errr- wash you!"
    fr "Relaxa, que eu vou te dar uma esponja... quer dizer... te lavar!"

# game/chapters/chapter5/script/ch5sc07.rpy:1017
translate brazil ch5sc07_411a60db:

