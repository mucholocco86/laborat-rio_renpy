    frt "{i}Pronto. Temperatura perfeita para relaxar.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:968
translate brazil ch5sc07_bd02bdce:

#   frt "{i}And plenty of bubbles! I hope I didn’t overdo it...{/i}"
