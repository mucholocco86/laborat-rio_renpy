# ARQUIVO: game/chapters/chapter5/script/ch5sc07.rpy DIALOGOS: 989


# game/chapters/chapter5/script/ch5sc07.rpy:9
translate brazil ch5sc07_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter5/script/ch5sc07.rpy:10
translate brazil ch5sc07_b0d097c1:

#   mct "{i}She’s still sound asleep. I suppose her body must still be adapting to the purification.{/i}"
    mct "{i}Ela ainda está dormindo profundamente. Suponho que seu corpo ainda esteja se adaptando à purificação.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:11
translate brazil ch5sc07_d0260238:

#   mct "{i}Her heartbeat is steady and breathing is normal. I'd better get going .. I have a princess to deal with.{/i}"
    mct "{i}O batimento cardíaco dela está estável e a respiração normal. É melhor eu ir... Tenho uma princesa para cuidar.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:13
translate brazil ch5sc07_b5469aee:

#   mct "{i}*Mwah* Sweet dreams.{/i}"
    mct "{i}*Beijinho* Bons sonhos.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:15
translate brazil ch5sc07_4ace7934:

#   mct "{i}*Sigh* Can’t believe I'm getting up before dawn for this...{/i}"
    mct "{i}*Suspiro* Não acredito que vou ter que levantar antes do amanhecer para isso...{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:16
translate brazil ch5sc07_03ed336f:

#   mct "{i}Then again, Amelia didn’t call the guards on me. I suppose I do owe her for that.{/i}"
    mct "{i}Por outro lado, Amelia não chamou os guardas. Acho que devo isso a ela.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:18
translate brazil ch5sc07_a0075882:

#   mct "{i}Sylph is right, though. Playing nice with the royal family could be beneficial for us.{/i}"
    mct "{i}Sylph tem razão. Ser amigável com a família real pode ser benéfico para nós.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:19
translate brazil ch5sc07_58649455:

#   mct "{i}I just wish I wasn’t the one who had to do the schmoozing...{/i}"
    mct "{i}Eu só queria não ser eu quem tivesse que fazer todo o trabalho de bajulação...{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:21
translate brazil ch5sc07_ad4931f1:

#   mct "{i}*Heavy sigh* I could’ve done with a few more hours of sleep, though.{/i}"
    mct "{i}*Suspiro pesado* Bem que eu poderia ter dormido mais algumas horas.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:22
translate brazil ch5sc07_d0cc53cf:

#   mct "{i}Oh well. Better stop moaning about it and get to it. The sooner it's done, the better.{/i}"
    mct "{i}Bom, melhor parar de reclamar e começar logo. Quanto antes estiver pronto, melhor.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:27
translate brazil ch5sc07_4b310b5c:

#   cbl "The gentleman will wait for Her Highness here in the courtyard."
    cbl "O cavalheiro aguardará Sua Alteza aqui no pátio."

# game/chapters/chapter5/script/ch5sc07.rpy:28
translate brazil ch5sc07_b32e4feb:

#   mc "I’m supposed to meet the Princess at the palace entrance."
    mc "Devo encontrar a princesa na entrada do palácio."

# game/chapters/chapter5/script/ch5sc07.rpy:30
translate brazil ch5sc07_fcaedab3:

#   cbl "That simply will not do. The gentleman will comply and await Her Highness outside."
    cbl "Isso simplesmente não vai funcionar. O cavalheiro irá acatar as ordens e aguardar Sua Alteza lá fora."

# game/chapters/chapter5/script/ch5sc07.rpy:31
translate brazil ch5sc07_4ac48eeb:

#   mct "{i}This guy really has a stick up his ass...{/i}"
    mct "{i}Esse cara é muito chato...{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:33
translate brazil ch5sc07_7d107604:

#   cbl "The palace does not open its doors until noon for audiences."
    cbl "O palácio só abre as suas portas ao meio-dia para o público."

# game/chapters/chapter5/script/ch5sc07.rpy:34
translate brazil ch5sc07_1ecde7ff:

#   cbl "Especially for unsophisticated individuals..."
    cbl "Especialmente para pessoas sem muita experiência..."

# game/chapters/chapter5/script/ch5sc07.rpy:36
translate brazil ch5sc07_11216d52:

#   pam "What’s the meaning of this? Answer me at once!"
    pam "O que significa isso? Responda-me imediatamente!"

# game/chapters/chapter5/script/ch5sc07.rpy:38
translate brazil ch5sc07_8b847765:

#   cbl "Your Highness!"
    cbl "Sua Alteza!"

# game/chapters/chapter5/script/ch5sc07.rpy:39
translate brazil ch5sc07_7345cf32:

#   cbl "This scoundrel is attempting to enter the palace grounds."
    cbl "Esse patife está tentando entrar nos jardins do palácio."

# game/chapters/chapter5/script/ch5sc07.rpy:41
translate brazil ch5sc07_88e0af99:

#   pam "He’s here at my request!"
    pam "Ele está aqui a meu pedido!"

# game/chapters/chapter5/script/ch5sc07.rpy:42
translate brazil ch5sc07_f394d9df:

#   pam "That means he is {b}MY{/b} guest. Is this how our guests are treated?"
    pam "Isso significa que ele é {b} MEU{/b} hóspede. É assim que nossos hóspedes são tratados?"

# game/chapters/chapter5/script/ch5sc07.rpy:44
translate brazil ch5sc07_b6b4e1ce:

#   cbl "Your Highness-"
    cbl "Sua Alteza-"

# game/chapters/chapter5/script/ch5sc07.rpy:47
translate brazil ch5sc07_6fb408ab:

#   pam "{b}Leave us!{/b}"
    pam "{b}Deixe-nos!{/b}"

# game/chapters/chapter5/script/ch5sc07.rpy:49
translate brazil ch5sc07_f729f59f:

#   cbl "At once, Your Grace."
    cbl "Imediatamente, Vossa Graça."

# game/chapters/chapter5/script/ch5sc07.rpy:50
translate brazil ch5sc07_c2ab9913:

#   mct "Damn, did Amelia just stand up for me? That's... surprising."
    mct "Caramba, a Amelia acabou de me defender? Isso é... surpreendente."

# game/chapters/chapter5/script/ch5sc07.rpy:52
translate brazil ch5sc07_890bb088:

#   pam "*Sighs* Servants."
    pam "*Suspiro* Servos."

# game/chapters/chapter5/script/ch5sc07.rpy:53
translate brazil ch5sc07_72ab25f6:

#   pam "They mean well, but they can be such a hassle sometimes."
    pam "Eles têm boas intenções, mas às vezes podem ser um grande incômodo."

# game/chapters/chapter5/script/ch5sc07.rpy:54
translate brazil ch5sc07_155ba5d2:

#   pam "I just need a quick word with my handmaiden. I’ll meet you out front in a few."
    pam "Preciso falar rapidinho com minha criada. Encontro você lá fora em alguns instantes."

# game/chapters/chapter5/script/ch5sc07.rpy:58
translate brazil ch5sc07_37c6bb86:

#   pam "Phew! We made it to the market before too many people started showing up."
    pam "Ufa! Conseguimos chegar ao mercado antes que muita gente começasse a aparecer."

# game/chapters/chapter5/script/ch5sc07.rpy:59
translate brazil ch5sc07_bae69d19:

#   mc "I’m not complaining. I’m not one for crowds..."
    mc "Não estou reclamando. Não sou fã de multidões..."

# game/chapters/chapter5/script/ch5sc07.rpy:61
translate brazil ch5sc07_7c0ba0c4:

#   pam "Me either. If you arrive early, you get to pick all the best stuff."
    pam "Eu também não. Se você chegar cedo, consegue escolher as melhores coisas."

# game/chapters/chapter5/script/ch5sc07.rpy:62
translate brazil ch5sc07_432b37e9:

#   pam "The finest clothes, the freshest fruits, and you avoid all the chaos."
    pam "As melhores roupas, as frutas mais frescas, e você evita todo o caos."

# game/chapters/chapter5/script/ch5sc07.rpy:64
translate brazil ch5sc07_ea1931b9:

#   mc "If I may, Princess. Aren’t you a little... under-dressed for venturing outside the palace?"
    mc "Com sua permissão, princesa. A senhora não está um pouco... mal vestida para se aventurar fora do palácio?"

# game/chapters/chapter5/script/ch5sc07.rpy:66
translate brazil ch5sc07_5dc0bfe5:

#   pam "How I dress is none of your concern."
    pam "A forma como me visto não é da sua conta."

# game/chapters/chapter5/script/ch5sc07.rpy:67
translate brazil ch5sc07_e356cdfe:

#   pam "Besides, there's a reason for it. You’ll see later."
    pam "Além disso, existe um motivo para isso. Você verá mais tarde."

# game/chapters/chapter5/script/ch5sc07.rpy:70
translate brazil ch5sc07_d7abecb9:

#   pam "I’m sorry about the Chamberlain earlier. He can be a bit... much."
    pam "Peço desculpas pelo Chamberlain mais cedo. Ele pode ser um pouco... exagerado."

# game/chapters/chapter5/script/ch5sc07.rpy:71
translate brazil ch5sc07_89c02e94:

#   pam "I’ll have him informed about your position as my... bodyguard."
    pam "Vou informá-lo sobre sua posição como meu... guarda-costas."

# game/chapters/chapter5/script/ch5sc07.rpy:73
translate brazil ch5sc07_11bf3892:

#   mc "I’ve dealt with worse..."
    mc "Já lidei com coisas piores..."

# game/chapters/chapter5/script/ch5sc07.rpy:74
translate brazil ch5sc07_cd2d56bf:

#   mc "Besides, I think he likes me."
    mc "Além disso, acho que ele gosta de mim."

# game/chapters/chapter5/script/ch5sc07.rpy:76
translate brazil ch5sc07_20519ddc:

#   pam "*Laughing* Hah-hah-ha! Y-Yes! I can totally see it! Friendship in the making! *Laughs*"
    pam "*Risos* Hah-hah-ha! S-Sim! Consigo imaginar perfeitamente! Uma amizade a caminho! *Risos*"

# game/chapters/chapter5/script/ch5sc07.rpy:77
translate brazil ch5sc07_20fb778e:

#   pam "*Laughs* Before long, you’ll be on a first-name basis and invited to see his shoe collection!"
    pam "*Risos* Em pouco tempo, vocês estarão em contato direto e você será convidado para ver a coleção de sapatos dele!"

# game/chapters/chapter5/script/ch5sc07.rpy:78
translate brazil ch5sc07_648888bb:

#   mc "Are you done...?"
    mc "Você já terminou...?"

# game/chapters/chapter5/script/ch5sc07.rpy:80
translate brazil ch5sc07_2577bada:

#   pam "Phew... "
    pam "Ufa... "

# game/chapters/chapter5/script/ch5sc07.rpy:81
translate brazil ch5sc07_5285ce54:

#   pam "It’s been a while since I had a laugh that deep."
    pam "Já fazia um tempo que eu não dava uma risada tão profunda."

# game/chapters/chapter5/script/ch5sc07.rpy:82
translate brazil ch5sc07_36fa7302:

#   pam "My sides almost cramped a little..."
    pam "Quase tive uma pequena cãibra na barriga..."

# game/chapters/chapter5/script/ch5sc07.rpy:84
translate brazil ch5sc07_06b1d908:

#   mc "Glad my friendship with your chamberlain amuses you."
    mc "Fico feliz que minha amizade com seu camareiro lhe divirta."

# game/chapters/chapter5/script/ch5sc07.rpy:85
translate brazil ch5sc07_f55b6a67:

#   pam "*Snickers* Stop! If you actually made friends, I'd totally give you guys my blessing!"
    pam "*Risos* Parem! Se vocês realmente fizessem amigos, eu daria minha bênção a vocês sem hesitar!"

# game/chapters/chapter5/script/ch5sc07.rpy:87
translate brazil ch5sc07_30c2dbae:

#   mc "*Sigh* What have I gotten myself into today?"
    mc "*Suspiro* Em que enrascada me meti hoje?"

# game/chapters/chapter5/script/ch5sc07.rpy:89
translate brazil ch5sc07_792caf33:

#   pam "I’ll show you!"
    pam "Eu vou te mostrar!"

# game/chapters/chapter5/script/ch5sc07.rpy:90
translate brazil ch5sc07_09df809e:

#   pam "Come, come. We don’t have all day."
    pam "Venha, venha. Não temos o dia todo."

# game/chapters/chapter5/script/ch5sc07.rpy:96
translate brazil ch5sc07_91f16847:

#   cr "Mhm! What a sweet little chicken you are! Heh-heh!"
    cr "Hum! Que galinha mais fofa você é! Hehe!"

# game/chapters/chapter5/script/ch5sc07.rpy:99
translate brazil ch5sc07_94b4fcd3:

#   cc "*Squeeek!*"
    cc "*Squeeek!*"

# game/chapters/chapter5/script/ch5sc07.rpy:100
translate brazil ch5sc07_3a9a0276:

#   ki "Creed! My favorite smuggler-turned-barkeep!"
    ki "Creed! Meu contrabandista favorito que virou dono de bar!"

# game/chapters/chapter5/script/ch5sc07.rpy:101
translate brazil ch5sc07_1e1e4e3a:

#   ki "You’re not still eating the poor chickens, are you?"
    ki "Você ainda não está comendo as pobres galinhas, está?"

# game/chapters/chapter5/script/ch5sc07.rpy:103
translate brazil ch5sc07_25acac6a:

#   cr "Dammit! Have you lost your mind, girl!"
    cr "Droga! Você perdeu a cabeça, garota?!"

# game/chapters/chapter5/script/ch5sc07.rpy:104
translate brazil ch5sc07_f194b121:

#   cr "Do you know how long it took me to catch that one?!"
    cr "Você sabe quanto tempo levei para pegar essa?!"

# game/chapters/chapter5/script/ch5sc07.rpy:106
translate brazil ch5sc07_3d97fb38:

#   ki "Creed, we told you not to eat the chickens."
    ki "Creed, nós te avisamos para não comer as galinhas."

# game/chapters/chapter5/script/ch5sc07.rpy:107
translate brazil ch5sc07_76c4de0d:

#   ki "They need to grow up and produce eggs."
    ki "Elas precisam crescer e produzir ovos."

# game/chapters/chapter5/script/ch5sc07.rpy:109
translate brazil ch5sc07_15281abf:

#   cr "Eck! You eat their eggs! Their unborn children! Eck!"
    cr "Eca! Você come os ovos deles! Os filhos que ainda nem nasceram! Eca!"

# game/chapters/chapter5/script/ch5sc07.rpy:110
translate brazil ch5sc07_8c4c53fd:

#   cr "At least I let them grow up a little before eating them! Anyway, what are you two doing here?"
    cr "Pelo menos deixei eles crescerem um pouco antes de comê-los! Enfim, o que vocês dois estão fazendo aqui?"

# game/chapters/chapter5/script/ch5sc07.rpy:112
translate brazil ch5sc07_f8fef703:

#   cr "Lazy-eye Louie and Boney-Brenda have taken charge of Looter’s Bay."
    cr "Louie Olho-Vadio e Brenda Ossuda assumiram o controle da Baía dos Saqueadores."

# game/chapters/chapter5/script/ch5sc07.rpy:113
translate brazil ch5sc07_d8b2bbe4:

#   cr "You’re both exiled and have bounties. "
    cr "Vocês dois estão exilados e têm recompensas pela cabeça. "

# game/chapters/chapter5/script/ch5sc07.rpy:115
translate brazil ch5sc07_1377a031:

#   pl "Louie and Brenda, really?"
    pl "Louie e Brenda, sério?"

# game/chapters/chapter5/script/ch5sc07.rpy:116
translate brazil ch5sc07_a39aeb73:

#   pl "Who thought that was a good idea?"
    pl "Quem achou que isso era uma boa ideia?"

# game/chapters/chapter5/script/ch5sc07.rpy:118
translate brazil ch5sc07_681fa557:

#   cr "It was pretty chaotic after your father was defeated, everyone fighting for scraps."
    cr "Foi um caos total depois que seu pai foi derrotado, todos brigando por restos."

# game/chapters/chapter5/script/ch5sc07.rpy:119
translate brazil ch5sc07_f4ab00e9:

#   cr "In the end, Louie and Brenda formed an alliance, and together they've squashed anyone who opposed them."
    cr "No fim, Louie e Brenda formaram uma aliança e, juntos, esmagaram qualquer um que se opusesse a eles."

# game/chapters/chapter5/script/ch5sc07.rpy:121
translate brazil ch5sc07_8f41808b:

#   pl "Interesting."
    pl "Interessante."

# game/chapters/chapter5/script/ch5sc07.rpy:123
translate brazil ch5sc07_d7c750bc:

#   ki "Looks like we have some clean-up duty ahead of us."
    ki "Parece que temos um trabalho de limpeza pela frente."

# game/chapters/chapter5/script/ch5sc07.rpy:124
translate brazil ch5sc07_caa459e4:

#   ki "What do you say, sis? Should we liberate Looter's Bay?"
    ki "E aí, maninha? Vamos libertar a Baía dos Saqueadores?"

# game/chapters/chapter5/script/ch5sc07.rpy:126
translate brazil ch5sc07_96fc96f1:

#   pl "Mhm! My body is aching for a good stretch!"
    pl "Hum! Meu corpo está implorando por um bom alongamento!"

# game/chapters/chapter5/script/ch5sc07.rpy:128
translate brazil ch5sc07_7aa028a8:

#   cr "Girls... you can’t take on the entirety of Looter’s Bay by yourselves. That would be madness."
    cr "Meninas... vocês não podem enfrentar toda a Baía dos Saqueadores sozinhas. Isso seria uma loucura."

# game/chapters/chapter5/script/ch5sc07.rpy:129
translate brazil ch5sc07_e807f4b0:

#   ki "Who said anything about doing it all on our own?"
    ki "Quem falou em fazer tudo sozinhos?"

# game/chapters/chapter5/script/ch5sc07.rpy:131
translate brazil ch5sc07_89a4cdce:

#   cr "Wha... No! Absolutely not! They’ll skin me alive!"
    cr "O quê... Não! De jeito nenhum! Vão me esfolar vivo!"

# game/chapters/chapter5/script/ch5sc07.rpy:132
translate brazil ch5sc07_7a0d0861:

#   cr "Girls... I like you. I really do... But this is- well, it’s nuts!"
    cr "Meninas... Eu gosto de vocês. Gosto mesmo... Mas isso é... bem, é uma loucura!"

# game/chapters/chapter5/script/ch5sc07.rpy:133
translate brazil ch5sc07_e0d2e9a6:

#   cr "Even though some of us don't like having Louie and Brenda in charge, we all vowed to never go back to your family."
    cr "Embora alguns de nós não gostemos de ter Louie e Brenda no comando, todos juramos nunca mais voltar para a sua família."

# game/chapters/chapter5/script/ch5sc07.rpy:135
translate brazil ch5sc07_ee8c998d:

#   ki "That is where you come in, Creed. Neither of us wants to be in charge."
    ki "É aí que você entra, Creed. Nenhum de nós quer estar no comando."

# game/chapters/chapter5/script/ch5sc07.rpy:136
translate brazil ch5sc07_4c39fe9b:

#   ki "But we refuse to leave our home in the hands of those two... freaks."
    ki "Mas nos recusamos a deixar nossa casa nas mãos daqueles dois... malucos."

# game/chapters/chapter5/script/ch5sc07.rpy:138
translate brazil ch5sc07_6db3162d:

#   pl "We’ll deal with Louie and Brenda."
    pl "Vamos lidar com Louie e Brenda."

# game/chapters/chapter5/script/ch5sc07.rpy:139
translate brazil ch5sc07_b3ad8e8d:

#   pl "Meanwhile, you start collecting allies who'll support your claim."
    pl "Enquanto isso, você começa a reunir aliados que apoiarão sua reivindicação."

# game/chapters/chapter5/script/ch5sc07.rpy:141
translate brazil ch5sc07_7d88df88:

#   cr "Girls... This is utterly mad. *Sighs heavily* Even if it might just work."
    cr "Meninas... Isso é uma loucura total. *Suspiros profundos* Mesmo que possa funcionar."

# game/chapters/chapter5/script/ch5sc07.rpy:142
translate brazil ch5sc07_712425a7:

#   cr "But why me?"
    cr "Mas por que eu?"

# game/chapters/chapter5/script/ch5sc07.rpy:144
translate brazil ch5sc07_9e1b8815:

#   pl "We believe you’re the best fit to lead Looter’s Bay. You know it inside-out."
    pl "Acreditamos que você é a pessoa ideal para liderar a Baía dos Saqueadores. Você a conhece como a palma da sua mão."

# game/chapters/chapter5/script/ch5sc07.rpy:145
translate brazil ch5sc07_7697ce32:

#   pl "You’ve been the barkeep here for well over a decade now. Everyone likes you!"
    pl "Você trabalha como barman aqui há mais de uma década. Todo mundo gosta de você!"

# game/chapters/chapter5/script/ch5sc07.rpy:147
translate brazil ch5sc07_2323fabb:

#   cr "They like me 'cause I keep the booze flowing and their spirits high."
    cr "Eles gostam de mim porque eu garanto que a bebida não falte e que o ânimo deles esteja sempre alto."

# game/chapters/chapter5/script/ch5sc07.rpy:149
translate brazil ch5sc07_4ef251a6:

#   pl "Keep doing both!"
    pl "Continue fazendo as duas coisas!"

# game/chapters/chapter5/script/ch5sc07.rpy:150
translate brazil ch5sc07_0c63aba5:

#   pl "With you in charge of the bay, people would be treated fairly and you can still run your tavern."
    pl "Com você no comando da baía, as pessoas seriam tratadas com justiça e você ainda poderia administrar sua taverna."

# game/chapters/chapter5/script/ch5sc07.rpy:152
translate brazil ch5sc07_418b286c:

#   ki "And you’ll have the two most renowned pirates backing you. What do you say, Creed?"
    ki "E você terá o apoio dos dois piratas mais renomados. O que me diz, Creed?"

# game/chapters/chapter5/script/ch5sc07.rpy:154
translate brazil ch5sc07_b1c1a1f6:

#   cr "I can’t believe this, girls."
    cr "Meninas, não acredito nisso."

# game/chapters/chapter5/script/ch5sc07.rpy:155
translate brazil ch5sc07_56c9a758:

#   cr "I say.. let’s do it! Let’s make Looter’s Bay great again!"
    cr "Eu digo... vamos lá! Vamos fazer com que a Baía dos Saqueadores volte a ser incrível!"

# game/chapters/chapter5/script/ch5sc07.rpy:156
translate brazil ch5sc07_dbd00b23:

#   bth "Yay! That’s the spirit, Creed! You won’t regret this! So here’s what we’ll do..."
    bth "É isso aí! Essa é a atitude, Creed! Você não vai se arrepender! Então, aqui está o que faremos..."

# game/chapters/chapter5/script/ch5sc07.rpy:162
translate brazil ch5sc07_7854bcbf:

#   merch "Ah, what can I get the lovely couple?"
    merch "Ah, o que posso oferecer a este adorável casal?"

# game/chapters/chapter5/script/ch5sc07.rpy:163
translate brazil ch5sc07_612a6540:

#   merch "Perhaps a peach from the Sen’ju forests? Or a squash from the fields of Luxeron?"
    merch "Talvez um pêssego das florestas de Sen'ju? Ou uma abóbora dos campos de Luxeron?"

# game/chapters/chapter5/script/ch5sc07.rpy:165
translate brazil ch5sc07_5209bfc4:

#   pam "C-Couple?"
    pam "Casal C?"

# game/chapters/chapter5/script/ch5sc07.rpy:168
translate brazil ch5sc07_c1fae737:

#   pam "No. {b}NO!{/b} We are absolutely not a damn couple!"
    pam "Não. {b} NÃO!{/b} Nós definitivamente não somos um casal!"

# game/chapters/chapter5/script/ch5sc07.rpy:170
translate brazil ch5sc07_563365aa:

#   pam "He’s... my... my bodyguard!"
    pam "Ele é... meu... meu guarda-costas!"

# game/chapters/chapter5/script/ch5sc07.rpy:172
translate brazil ch5sc07_d2b0d9d0:

#   merch "Oh. I’m sorry, ma’am. You just looked like a couple in love, that’s all."
    merch "Ah, desculpe, senhora. Vocês só pareciam um casal apaixonado, só isso."

# game/chapters/chapter5/script/ch5sc07.rpy:173
translate brazil ch5sc07_bf402789:

#   merch "What can I get you?"
    merch "O que posso lhe oferecer?"

# game/chapters/chapter5/script/ch5sc07.rpy:175
translate brazil ch5sc07_91539257:

#   pam "Do you only have peaches from Sen’ju? Or do you have Sen’ju apples too?"
    pam "Vocês só têm pêssegos de Sen'ju? Ou também têm maçãs de Sen'ju?"

# game/chapters/chapter5/script/ch5sc07.rpy:177
translate brazil ch5sc07_2552f271:

#   merch "You bet we do, ma’am! They only just arrived yesterday."
    merch "Pode apostar que sim, senhora! Eles chegaram ontem mesmo."

# game/chapters/chapter5/script/ch5sc07.rpy:178
translate brazil ch5sc07_81f933c6:

#   merch "You won’t find a better selection in Luxenford."
    merch "Você não encontrará uma seleção melhor em Luxemburgo."

# game/chapters/chapter5/script/ch5sc07.rpy:179
translate brazil ch5sc07_373ef91b:

#   pam "Great! We'll take two!"
    pam "Ótimo! Vamos levar dois!"

# game/chapters/chapter5/script/ch5sc07.rpy:182
translate brazil ch5sc07_c36c5a3c:

#   pam "Ugh! Can you believe that guy?"
    pam "Credo! Dá para acreditar naquele cara?"

# game/chapters/chapter5/script/ch5sc07.rpy:183
translate brazil ch5sc07_50f76216:

#   pam "Calling me {i}ma’am{/i}? I have at least twenty years left before I’m a {i}ma’am{/i}!"
    pam "Me ligando {i} senhora{/i}Ainda tenho pelo menos vinte anos antes de me tornar um {i} senhora{/i}!"

# game/chapters/chapter5/script/ch5sc07.rpy:185
translate brazil ch5sc07_7510949e:

#   mc "I mean... twenty is... debatable."
    mc "Quer dizer... vinte é... discutível."

# game/chapters/chapter5/script/ch5sc07.rpy:187
translate brazil ch5sc07_ac6fe91e:

#   pam "Seriously!? Don’t you start."
    pam "Sério?! Nem comece."

# game/chapters/chapter5/script/ch5sc07.rpy:188
translate brazil ch5sc07_9123f023:

#   pam "And what was with the whole couple thing? Ugh!"
    pam "E o que foi aquilo de casal? Credo!"

# game/chapters/chapter5/script/ch5sc07.rpy:190
translate brazil ch5sc07_cb711f44:

#   mc "I don’t know."
    mc "Não sei."

# game/chapters/chapter5/script/ch5sc07.rpy:191
translate brazil ch5sc07_8a13a960:

#   mc "Maybe he thought we looked good together?"
    mc "Talvez ele tenha pensado que nós combinávamos bem?"

# game/chapters/chapter5/script/ch5sc07.rpy:193
translate brazil ch5sc07_a2c228b8:

#   pam "That’s crazy... I’m the princess and you’re a commoner."
    pam "Isso é loucura... Eu sou a princesa e você é um plebeu."

# game/chapters/chapter5/script/ch5sc07.rpy:195
translate brazil ch5sc07_a410cc14:

#   mc "He doesn’t know that."
    mc "Ele não sabe disso."

# game/chapters/chapter5/script/ch5sc07.rpy:196
translate brazil ch5sc07_a91dc326:

#   mc "To him, we probably just looked like two young adults on a date?"
    mc "Para ele, provavelmente parecíamos apenas dois jovens adultos em um encontro."

# game/chapters/chapter5/script/ch5sc07.rpy:198
translate brazil ch5sc07_1d79529f:

#   pam "That’s not funny! Hnnrhh!"
    pam "Isso não tem graça! Hnnrhh!"

# game/chapters/chapter5/script/ch5sc07.rpy:199
translate brazil ch5sc07_eb6ae884:

#   mc "*Chuckles* So what was so important about us getting apples?"
    mc "*Risos* Então, o que era tão importante em conseguirmos maçãs?"

# game/chapters/chapter5/script/ch5sc07.rpy:201
translate brazil ch5sc07_1aa8e568:

#   pam "Sen’ju apples are the juiciest and most divine tasting apples I’ve ever had!"
    pam "As maçãs Sen'ju são as mais suculentas e saborosas que já provei!"

# game/chapters/chapter5/script/ch5sc07.rpy:202
translate brazil ch5sc07_559b7a43:

#   pam "They only arrive in Luxenford once a week, which is why we had to come today!"
    pam "Eles só chegam a Luxemburgo uma vez por semana, por isso tivemos que vir hoje!"

# game/chapters/chapter5/script/ch5sc07.rpy:204
translate brazil ch5sc07_9b321c47:

#   mct "{i}I ate lots of Sen’ju apples during the years I spent with Rin, at her village in the forest of Sen’ju.{/i}"
    mct "{i}Comi muitas maçãs Sen'ju durante os anos que passei com Rin, em sua aldeia na floresta de Sen'ju.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:205
translate brazil ch5sc07_06108ee4:

#   mct "{i}Amelia isn’t exaggerating, they’re incredibly delicious.{/i}"
    mct "{i}Amelia não está exagerando, eles são incrivelmente deliciosos.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:207
translate brazil ch5sc07_d1b4748d:

#   pam "Sweet mother nature... Mhmm... I’ve been waiting all week for that."
    pam "Doce Mãe Natureza... Hum... Estive esperando por isso a semana toda."

# game/chapters/chapter5/script/ch5sc07.rpy:208
translate brazil ch5sc07_66a5117a:

#   mc "*Chuckles*"
    mc "*Risos*"

# game/chapters/chapter5/script/ch5sc07.rpy:210
translate brazil ch5sc07_0679787a:

#   pam "Do you..."
    pam "Você..."

# game/chapters/chapter5/script/ch5sc07.rpy:211
translate brazil ch5sc07_204fb743:

#   pam "Want a bite?"
    pam "Quer um pedaço?"

# game/chapters/chapter5/script/ch5sc07.rpy:213
translate brazil ch5sc07_a4838eb8:

#   "You answer by gently grabbing her wrist and taking a bite."
    "Você responde segurando delicadamente o pulso dela e dando uma mordida."

# game/chapters/chapter5/script/ch5sc07.rpy:214
translate brazil ch5sc07_ea3df784:

#   pam "O-Okay. Don’t eat it all..."
    pam "Tudo bem. Não coma tudo..."

# game/chapters/chapter5/script/ch5sc07.rpy:216
translate brazil ch5sc07_9ca005b6:

#   amt "{i}He just grabbed my wrist like it's no big deal...{/i}"
    amt "{i}Ele simplesmente agarrou meu pulso como se não fosse nada demais...{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:217
translate brazil ch5sc07_4b7b0d36:

#   amt "{i}His hand is so... warm... And his- his bottom lip is t-touching my thumb! *Blushing*{/i}"
    amt "{i}A mão dele é tão... quente... E o lábio inferior dele está tocando meu polegar! *Corando*{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:218
translate brazil ch5sc07_7ad7082f:

#   amt "{i}I can’t believe I’m letting a commoner... touch me. *Sigh* He’s really cute, though.{/i}"
    amt "{i}Não acredito que estou deixando um plebeu... me tocar. *Suspiro* Mas ele é muito fofo.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:219
translate brazil ch5sc07_45d781af:

#   amt "Frida really likes him too."
    amt "Frida também gosta muito dele."

# game/chapters/chapter5/script/ch5sc07.rpy:220
translate brazil ch5sc07_d464ebf9:

#   amt "She's been singing his praises... and she's always been a good judge of character."
    amt "Ela não para de elogiá-lo... e sempre teve um bom faro para avaliar pessoas."

# game/chapters/chapter5/script/ch5sc07.rpy:223
translate brazil ch5sc07_3ae31e96:

#   amt "{i}!!! Wait! Wait! Is this... an... indirect kiss?! No! I can’t allow that!{/i}"
    amt "{i}!!! Espera! Espera! Isso é... um... beijo indireto?! Não! Não posso permitir isso!{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:226
translate brazil ch5sc07_9452ce38:

#   "Amelia comes to her senses and practically leaps away from you."
    "Amelia recobra os sentidos e praticamente salta para longe de você."

# game/chapters/chapter5/script/ch5sc07.rpy:227
translate brazil ch5sc07_7063c347:

#   pam "..."
    pam "..."

# game/chapters/chapter5/script/ch5sc07.rpy:229
translate brazil ch5sc07_bc9e40a1:

#   pam "T-That... that was just... I just wanted you to taste something nice."
    pam "I-Isso... isso foi só... eu só queria que você experimentasse algo gostoso."

# game/chapters/chapter5/script/ch5sc07.rpy:230
translate brazil ch5sc07_92bf89d5:

#   pam "A commoner like you has probably never had something like that."
    pam "Uma pessoa comum como você provavelmente nunca teve algo assim."

# game/chapters/chapter5/script/ch5sc07.rpy:232
translate brazil ch5sc07_022b5732:

#   mc "I appreciate it. But I’ve had Sen’ju apples before, when I lived there."
    mc "Agradeço. Mas eu já comi maçãs Sen'ju antes, quando morava lá."

# game/chapters/chapter5/script/ch5sc07.rpy:233
translate brazil ch5sc07_27b4de0a:

#   pam "You lived in the Sen’ju region?"
    pam "Você morava na região de Sen'ju?"

# game/chapters/chapter5/script/ch5sc07.rpy:234
translate brazil ch5sc07_e3638f7c:

#   mc "Yeah, for a few years."
    mc "Sim, por alguns anos."

# game/chapters/chapter5/script/ch5sc07.rpy:235
translate brazil ch5sc07_68903858:

#   amt "{i}Woah... That's pretty amazing. I've always wanted to go see it with my own eyes.{/i}"
    amt "{i}Uau... Isso é incrível. Sempre quis ver com meus próprios olhos.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:236
translate brazil ch5sc07_e022fe9f:

#   pam "Hghh... Whatever! Come, there’s another shop I want to visit."
    pam "Hghh... Tanto faz! Vamos, tem outra loja que eu quero visitar."

# game/chapters/chapter5/script/ch5sc07.rpy:238
translate brazil ch5sc07_acdc4b34:

#   mc "Sure. Lead the way, Princess."
    mc "Claro. Mostre o caminho, princesa."

# game/chapters/chapter5/script/ch5sc07.rpy:240
translate brazil ch5sc07_c938016e:

#   pam "Supposedly, they've recently stocked up with some of the best and most exotic perfumes available."
    pam "Supostamente, eles recentemente fizeram um novo estoque com alguns dos melhores e mais exóticos perfumes disponíveis."

# game/chapters/chapter5/script/ch5sc07.rpy:242
translate brazil ch5sc07_5bce20e2:

#   mc "Looking to expand your collection?"
    mc "Deseja expandir sua coleção?"

# game/chapters/chapter5/script/ch5sc07.rpy:244
translate brazil ch5sc07_a1da607b:

#   pam "Always! As a lady of the court, I can’t exactly walk around smelling like the streets."
    pam "Sempre! Como dama da corte, não posso exatamente andar por aí cheirando a rua."

# game/chapters/chapter5/script/ch5sc07.rpy:246
translate brazil ch5sc07_63622948:

#   mc "You don’t."
    mc "Não."

# game/chapters/chapter5/script/ch5sc07.rpy:249
translate brazil ch5sc07_77df15ef:

#   pam "T-Thank you. Now, let’s go."
    pam "O-Obrigado. Agora, vamos."

# game/chapters/chapter5/script/ch5sc07.rpy:253
translate brazil ch5sc07_3669e23a:

#   al_t "{i}Hmh... I was supposed to meet Luna here. Oh, there she is!{/i}"
    al_t "{i}Hum... Eu ia encontrar a Luna aqui. Ah, lá está ela!{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:254
translate brazil ch5sc07_71f42711:

#   al_t "{i}Who’s that she’s talking to?{/i}"
    al_t "{i}Com quem ela está falando?{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:256
translate brazil ch5sc07_baee3cf0:

#   lu "I know what you did to my mother!"
    lu "Eu sei o que você fez com a minha mãe!"

# game/chapters/chapter5/script/ch5sc07.rpy:257
translate brazil ch5sc07_6b9f9bcc:

#   lu "I demand to know, why?! Why did you betray her!"
    lu "Exijo saber, por quê?! Por que você a traiu?!"

# game/chapters/chapter5/script/ch5sc07.rpy:259
translate brazil ch5sc07_c7696e7e:

#   ro "I haven’t the faintest clue what you’re yapping on about."
    ro "Não tenho a mínima ideia do que você está falando."

# game/chapters/chapter5/script/ch5sc07.rpy:261
translate brazil ch5sc07_e996c4c5:

#   ro "Why don’t you do everyone a favor and scurry off? This is a place for magical education."
    ro "Por que você não faz um favor a todos e vai embora? Este é um lugar para educação mágica."

# game/chapters/chapter5/script/ch5sc07.rpy:263
translate brazil ch5sc07_9dcc26bc:

#   ro "Not for teenagers throwing temper tantrums."
    ro "Não recomendado para adolescentes que fazem birra."

# game/chapters/chapter5/script/ch5sc07.rpy:265
translate brazil ch5sc07_3c58b66c:

#   lu "Look at you. Our guild’s leader goes missing for two months, and you just sit here..."
    lu "Olha só para você. O líder da nossa guilda desaparece por dois meses, e você fica aí sentado..."

# game/chapters/chapter5/script/ch5sc07.rpy:266
translate brazil ch5sc07_21805805:

#   lu "Why, Rose? Why did you betray her? You were friends..."
    lu "Por que, Rose? Por que você a traiu? Vocês eram amigas..."

# game/chapters/chapter5/script/ch5sc07.rpy:268
translate brazil ch5sc07_acd12265:

#   ro "I can assure you, dear Luna, I know nothing of your mother's whereabouts."
    ro "Posso garantir-lhe, querida Luna, que não sei nada sobre o paradeiro de sua mãe."

# game/chapters/chapter5/script/ch5sc07.rpy:270
translate brazil ch5sc07_3539b753:

#   ro "But one thing is clear, she left us. All of us. And this leaves us no choice but to elect a new leader."
    ro "Mas uma coisa é certa: ela nos deixou. A todos nós. E isso não nos deixa outra escolha a não ser eleger um novo líder."

# game/chapters/chapter5/script/ch5sc07.rpy:272
translate brazil ch5sc07_2a62fdd9:

#   lu "That’s what this is about? You didn’t like her leadership?"
    lu "É disso que se trata? Você não gostou da liderança dela?"

# game/chapters/chapter5/script/ch5sc07.rpy:273
translate brazil ch5sc07_7bb65493:

#   lu "You want to have my mother killed for your own ambition?"
    lu "Você quer mandar matar minha mãe para satisfazer sua ambição pessoal?"

# game/chapters/chapter5/script/ch5sc07.rpy:274
translate brazil ch5sc07_4b9b5fd8:

#   ro "..."
    ro "..."

# game/chapters/chapter5/script/ch5sc07.rpy:276
translate brazil ch5sc07_a352e027:

#   ro "I’m growing tired of this conversation."
    ro "Estou ficando cansado desta conversa."

# game/chapters/chapter5/script/ch5sc07.rpy:277
translate brazil ch5sc07_f7798b98:

#   ro "You’re excused."
    ro "Você está dispensado."

# game/chapters/chapter5/script/ch5sc07.rpy:279
translate brazil ch5sc07_c258219b:

#   lu "{b}Bitch!{/b} You will regret this..."
    lu "{b}Cadela!{/b} Você vai se arrepender disso..."

# game/chapters/chapter5/script/ch5sc07.rpy:280
translate brazil ch5sc07_0081347e:

#   ro "Hmph."
    ro "Hum."

# game/chapters/chapter5/script/ch5sc07.rpy:282
translate brazil ch5sc07_3ed06e25:

#   ro "Oh, and Luna? You’ll want to avoid the Mages guild."
    ro "Ah, e Luna? É melhor você evitar a Guilda dos Magos."

# game/chapters/chapter5/script/ch5sc07.rpy:283
translate brazil ch5sc07_96225144:

#   ro "I fear it’s not safe for you any longer."
    ro "Temo que não seja mais seguro para você."

# game/chapters/chapter5/script/ch5sc07.rpy:285
translate brazil ch5sc07_626aa3ef:

#   lu "Rose... If that hex isn’t removed from my mother, I promise you... you will suffer."
    lu "Rose... Se esse feitiço não for removido da minha mãe, eu prometo... você vai sofrer."

# game/chapters/chapter5/script/ch5sc07.rpy:286
translate brazil ch5sc07_e5d7bb0e:

#   lu "You do not want to end up on my bad side. Unlike Mother, I do not forgive or forget."
    lu "Você não quer ficar do meu lado ruim. Ao contrário da mamãe, eu não perdoo nem esqueço."

# game/chapters/chapter5/script/ch5sc07.rpy:288
translate brazil ch5sc07_e220ba2a:

#   lu "Consider yourself warned, Rose."
    lu "Considere-se avisada, Rose."

# game/chapters/chapter5/script/ch5sc07.rpy:291
translate brazil ch5sc07_10f89c39:

#   lu "A-Alice?"
    lu "A-Alice?"

# game/chapters/chapter5/script/ch5sc07.rpy:292
translate brazil ch5sc07_e22169e9:

#   al "Hi Luna. Are you alright?"
    al "Oi Luna. Você está bem?"

# game/chapters/chapter5/script/ch5sc07.rpy:293
translate brazil ch5sc07_8b70d5d8:

#   lu "*Sniffle* N-No... What are you doing here?"
    lu "*Soluço* N-Não... O que você está fazendo aqui?"

# game/chapters/chapter5/script/ch5sc07.rpy:295
translate brazil ch5sc07_75683961:

#   al "We were supposed to meet here and work on a solution to your mothers hex?"
    al "Deveríamos ter nos encontrado aqui para trabalhar em uma solução para a maldição da sua mãe?"

# game/chapters/chapter5/script/ch5sc07.rpy:297
translate brazil ch5sc07_5692cf8a:

#   lu "Oh... right."
    lu "Ah... certo."

# game/chapters/chapter5/script/ch5sc07.rpy:298
translate brazil ch5sc07_ec265a4b:

#   lu "Let’s get out of here. There is nothing here that can help us."
    lu "Vamos sair daqui. Não há nada aqui que possa nos ajudar."

# game/chapters/chapter5/script/ch5sc07.rpy:300
translate brazil ch5sc07_d9e38041:

#   al "We'll put our heads together at the Academy."
    al "Vamos unir nossas ideias na Academia."

# game/chapters/chapter5/script/ch5sc07.rpy:301
translate brazil ch5sc07_d99afa7e:

#   al "I don’t have any classes today."
    al "Não tenho aulas hoje."

# game/chapters/chapter5/script/ch5sc07.rpy:302
translate brazil ch5sc07_8c565bfb:

#   lu "Alice... Thank you. Let’s do that."
    lu "Alice... Obrigada. Vamos fazer isso."

# game/chapters/chapter5/script/ch5sc07.rpy:305
translate brazil ch5sc07_7633d7d8:

#   pam "Uh-uh! Let’s head in here."
    pam "Não, não! Vamos entrar aqui."

# game/chapters/chapter5/script/ch5sc07.rpy:307
translate brazil ch5sc07_8756ad48:

#   mc "Weren’t we going for perfumes?"
    mc "Não íamos comprar perfumes?"

# game/chapters/chapter5/script/ch5sc07.rpy:309
translate brazil ch5sc07_644f0915:

#   pam "We are... But I also need a new outfit and we’re here now!"
    pam "Estamos... Mas eu também preciso de uma roupa nova e já estamos aqui!"

# game/chapters/chapter5/script/ch5sc07.rpy:311
translate brazil ch5sc07_a891be5c:

#   mc "*Sigh* Fine... Let’s see what they have."
    mc "*Suspiro* Tudo bem... Vamos ver o que eles têm."

# game/chapters/chapter5/script/ch5sc07.rpy:313
translate brazil ch5sc07_6a4db48d:

#   "In her excitement, Amelia grabs your hand and starts pulling you towards the shop."
    "Em sua empolgação, Amelia agarra sua mão e começa a puxá-lo em direção à loja."

# game/chapters/chapter5/script/ch5sc07.rpy:314
translate brazil ch5sc07_51adf476:

#   pam "C’mon! It’ll be fun! *Giggling* I bet you’ve never been shopping with a princess before!"
    pam "Vamos lá! Vai ser divertido! *Risos* Aposto que você nunca fez compras com uma princesa antes!"

# game/chapters/chapter5/script/ch5sc07.rpy:317
translate brazil ch5sc07_16f21df2:

#   pam "The dressing room is back here... I won’t be long."
    pam "O camarim é aqui atrás... Já volto."

# game/chapters/chapter5/script/ch5sc07.rpy:318
translate brazil ch5sc07_6d57576d:

#   pam "This is why I went a little under-dressed today!"
    pam "Por isso, hoje me vesti de forma um pouco inadequada!"

# game/chapters/chapter5/script/ch5sc07.rpy:319
translate brazil ch5sc07_0aea69a2:

#   pam "Wait here until I call for you, okay?"
    pam "Espere aqui até que eu te chame, ok?"

# game/chapters/chapter5/script/ch5sc07.rpy:320
translate brazil ch5sc07_2fcc7ac5:

#   mc "Sure..."
    mc "Claro..."

# game/chapters/chapter5/script/ch5sc07.rpy:322
translate brazil ch5sc07_db99f7aa:

#   pam "No peeking!"
    pam "Proibido espiar!"

# game/chapters/chapter5/script/ch5sc07.rpy:323
translate brazil ch5sc07_890d2ca5:

#   mc "Wouldn’t dream of it, Princess."
    mc "Nem pensar, princesa."

# game/chapters/chapter5/script/ch5sc07.rpy:325
translate brazil ch5sc07_2744566f:

#   pam "You don’t have to be so formal..."
    pam "Você não precisa ser tão formal..."

# game/chapters/chapter5/script/ch5sc07.rpy:326
translate brazil ch5sc07_46627277:

#   am "When it’s just the two of us, you can call me Amelia."
    am "Quando estivermos só nós duas, pode me chamar de Amelia."

# game/chapters/chapter5/script/ch5sc07.rpy:327
translate brazil ch5sc07_aa047fc7:

#   mc "Are you sure? You were pretty adamant about me referring to you by your title."
    mc "Tem certeza? Você insistiu bastante para que eu me referisse a você pelo seu título."

# game/chapters/chapter5/script/ch5sc07.rpy:329
translate brazil ch5sc07_d15f1a80:

#   am "I’m sure..."
    am "Tenho certeza..."

# game/chapters/chapter5/script/ch5sc07.rpy:330
translate brazil ch5sc07_751d8dbb:

#   am "But only when we’re alone!"
    am "Mas só quando estamos sozinhos!"

# game/chapters/chapter5/script/ch5sc07.rpy:331
translate brazil ch5sc07_8e8e8732:

#   am "I don’t want anyone thinking I’m chummy with a commoner!"
    am "Não quero que ninguém pense que sou amigo íntimo de um plebeu!"

# game/chapters/chapter5/script/ch5sc07.rpy:333
translate brazil ch5sc07_b4a841da:

#   mc "Right, we wouldn't want your reputation to suffer from being associated with me."
    mc "Certo, não queremos que sua reputação seja prejudicada por estar associada a mim."

# game/chapters/chapter5/script/ch5sc07.rpy:334
translate brazil ch5sc07_dd4f5bd2:

#   am "That’s not... [mc]..."
    am "Isso não é... [mc]..."

# game/chapters/chapter5/script/ch5sc07.rpy:335
translate brazil ch5sc07_b9cbf291:

#   mc "It’s okay, Amelia."
    mc "Está tudo bem, Amelia."

# game/chapters/chapter5/script/ch5sc07.rpy:336
translate brazil ch5sc07_671ecee3:

#   mc "You’re not the first to feel that way about me, and you won’t be the last."
    mc "Você não é a primeira a se sentir assim em relação a mim, e não será a última."

# game/chapters/chapter5/script/ch5sc07.rpy:338
translate brazil ch5sc07_e3e9dacf:

#   amt "{i}[mc]... that’s not it at all. Being close to me will only put you in danger... *Sigh*{/i}"
    amt "{i}[mc]... não é nada disso. Ficar perto de mim só vai te colocar em perigo... *Suspiro*{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:339
translate brazil ch5sc07_84089d40:

#   amt "{i}Urrh! If only I could ask him to escort me to the upcoming celebration of my 20th name day.{/i}"
    amt "{i}Ugh! Quem me dera poder pedir a ele que me acompanhasse à próxima celebração do meu 20º aniversário.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:341
translate brazil ch5sc07_fb661755:

#   am "*Mumbles* Father would never allow it, though. Not to mention, it would paint a target on [mc]’s back."
    am "*Resmunga* Meu pai jamais permitiria. Sem falar que isso me tornaria um alvo fácil. [mc] está de volta."

# game/chapters/chapter5/script/ch5sc07.rpy:342
translate brazil ch5sc07_8be7a0b3:

#   mc "Did you say something?"
    mc "Você disse alguma coisa?"

# game/chapters/chapter5/script/ch5sc07.rpy:345
translate brazil ch5sc07_e6eac60e:

#   am "No! ..."
    am "Não! ..."

# game/chapters/chapter5/script/ch5sc07.rpy:347
translate brazil ch5sc07_57ba92fd:

#   am "Okay, are you ready?"
    am "Ok, você está pronto?"

# game/chapters/chapter5/script/ch5sc07.rpy:348
translate brazil ch5sc07_da15366e:

#   mc "I suppose? I don’t know what you’re up to behind those curtains..."
    mc "Imagino? Não sei o que você anda aprontando por trás dessas cortinas..."

# game/chapters/chapter5/script/ch5sc07.rpy:350
translate brazil ch5sc07_ba8ca7ab:

#   am "This! What do you think? Does it fit properly?"
    am "Isto! O que você acha? Ficou bom?"

# game/chapters/chapter5/script/ch5sc07.rpy:351
translate brazil ch5sc07_fbbd9d4a:

#   mc "Amelia... I..."
    mc "Amélia... Eu..."

# game/chapters/chapter5/script/ch5sc07.rpy:353
translate brazil ch5sc07_c6cc91d6:

#   am "Do you like it? I’ve been waiting a whole month for this dress..."
    am "Você gostou? Eu esperei um mês inteiro por este vestido..."

# game/chapters/chapter5/script/ch5sc07.rpy:358
translate brazil ch5sc07_177c6ee1:

#   mc "Amelia... you look beautiful in that dress."
    mc "Amélia... você está linda nesse vestido."

# game/chapters/chapter5/script/ch5sc07.rpy:360
translate brazil ch5sc07_5de78111:

#   am "Y-You really think so?"
    am "Você realmente acha isso?"

# game/chapters/chapter5/script/ch5sc07.rpy:362
translate brazil ch5sc07_c8fce9ae:

#   mc "You’re stunning. It was definitely worth waiting for."
    mc "Você é deslumbrante. Definitivamente valeu a pena esperar."

# game/chapters/chapter5/script/ch5sc07.rpy:364
translate brazil ch5sc07_8cc2ec1c:

#   am "[mc]... Thank you. I’m glad you like it..."
    am "[mc]... Obrigada. Fico feliz que tenha gostado..."

# game/chapters/chapter5/script/ch5sc07.rpy:366
translate brazil ch5sc07_b46e78f2:

#   mc "How about a little spin?"
    mc "Que tal uma voltinha?"

# game/chapters/chapter5/script/ch5sc07.rpy:368
translate brazil ch5sc07_bf857f27:

#   am "A spin? W-What for?"
    am "Uma volta? P-Para quê?"

# game/chapters/chapter5/script/ch5sc07.rpy:370
translate brazil ch5sc07_e720bbfd:

#   mc "Just to get a proper look at you... and the dress."
    mc "Só para te ver direito... e ver o vestido também."

# game/chapters/chapter5/script/ch5sc07.rpy:371
translate brazil ch5sc07_1c8acf17:

#   am "..."
    am "..."

# game/chapters/chapter5/script/ch5sc07.rpy:373
translate brazil ch5sc07_4f4089ef:

#   am "You’re ridiculous... fine."
    am "Você é ridículo... tudo bem."

# game/chapters/chapter5/script/ch5sc07.rpy:375
translate brazil ch5sc07_87b2055b:

#   am "I can’t believe I’m doing this..."
    am "Não acredito que estou fazendo isso..."

# game/chapters/chapter5/script/ch5sc07.rpy:376
translate brazil ch5sc07_44bf4f10:

#   am "You’re very lucky I’m in a good mood!"
    am "Você tem muita sorte de eu estar de bom humor!"

# game/chapters/chapter5/script/ch5sc07.rpy:378
translate brazil ch5sc07_9076443f:

#   mc "With what I’m seeing, I’d have to agree. Luck is on my side."
    mc "Pelo que estou vendo, tenho que concordar. A sorte está do meu lado."

# game/chapters/chapter5/script/ch5sc07.rpy:379
translate brazil ch5sc07_1dc2fd4c:

#   am "*Blushing* You say the craziest things..."
    am "*Corando* Você diz as coisas mais loucas..."

# game/chapters/chapter5/script/ch5sc07.rpy:381
translate brazil ch5sc07_db81787f:

#   mct "{i}She looks amazing.{/i}"
    mct "{i}Ela está deslumbrante.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:382
translate brazil ch5sc07_24450b89:

#   mc "Let’s put my luck to the test... One more time? Just to make sure we didn’t miss anything."
    mc "Vamos testar minha sorte... Mais uma vez? Só para garantir que não deixamos nada passar."

# game/chapters/chapter5/script/ch5sc07.rpy:385
translate brazil ch5sc07_10bd5255:

#   am "Gosh! You’re relentless. Fine!"
    am "Nossa! Você é implacável. Tudo bem!"

# game/chapters/chapter5/script/ch5sc07.rpy:395
translate brazil ch5sc07_3a4452a0:

#   "Amelia enjoys your compliments, dispute trying to appear standoffish, her trust has increased by {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."
    "Amelia gosta dos seus elogios, apesar de tentar parecer distante, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc07.rpy:396
translate brazil ch5sc07_c3fd40b9:

#   am "Phew! Okay, I'd better get back into my clothes."
    am "Ufa! Ok, é melhor eu me vestir de novo."

# game/chapters/chapter5/script/ch5sc07.rpy:397
translate brazil ch5sc07_9cd72e75:

#   am "I don’t want to wrinkle the dress before it’s time to use it."
    am "Não quero amassar o vestido antes da hora de usá-lo."

# game/chapters/chapter5/script/ch5sc07.rpy:400
translate brazil ch5sc07_befa5e1c:

#   am "D-Did you really mean it when you said... I look beautiful?"
    am "Você realmente quis dizer aquilo quando disse... que eu estou linda?"

# game/chapters/chapter5/script/ch5sc07.rpy:401
translate brazil ch5sc07_46fe1c37:

#   am "It wasn't just a compliment because I'm the princess?"
    am "Não foi apenas um elogio por eu ser a princesa?"

# game/chapters/chapter5/script/ch5sc07.rpy:403
translate brazil ch5sc07_18d27903:

#   mc "Amelia, look at me."
    mc "Amélia, olhe para mim."

# game/chapters/chapter5/script/ch5sc07.rpy:405
translate brazil ch5sc07_61234b3f:

#   am "*Blushing* Y-You're staring..."
    am "*Corando* V-Você está me encarando..."

# game/chapters/chapter5/script/ch5sc07.rpy:407
translate brazil ch5sc07_d9178fe7:

#   mc "I'm gazing."
    mc "Estou olhando fixamente."

# game/chapters/chapter5/script/ch5sc07.rpy:408
translate brazil ch5sc07_46a396ed:

#   mc "It's what a man does when he finds a woman genuinely stunning."
    mc "É o que um homem faz quando acha uma mulher verdadeiramente deslumbrante."

# game/chapters/chapter5/script/ch5sc07.rpy:409
translate brazil ch5sc07_3b273312:

#   amt "Stunning!? Gosh, when he looks at me like that... he really means it!"
    amt "Impressionante!? Nossa, quando ele me olha assim... ele está falando sério!"

# game/chapters/chapter5/script/ch5sc07.rpy:411
translate brazil ch5sc07_31b583a8:

#   am "Okay... I suppose I'll believe you."
    am "Ok... Acho que vou acreditar em você."

# game/chapters/chapter5/script/ch5sc07.rpy:413
translate brazil ch5sc07_8603d20e:

#   mc "Spin for me one last time? Before you go get changed?"
    mc "Dá uma última voltinha pra mim? Antes de você ir se trocar?"

# game/chapters/chapter5/script/ch5sc07.rpy:414
translate brazil ch5sc07_d6e8e671:

#   amt "Heavens! He-... he wants to see me again?"
    amt "Céus! Ele... ele quer me ver de novo?"

# game/chapters/chapter5/script/ch5sc07.rpy:415
translate brazil ch5sc07_ba1c200e:

#   amt "*Sighs* He's been so sweet... I guess I'll... give him what he wants."
    amt "*Suspiro* Ele tem sido tão doce... Acho que vou... dar a ele o que ele quer."

# game/chapters/chapter5/script/ch5sc07.rpy:418
translate brazil ch5sc07_3bac35f6:

#   am "You're impossible!"
    am "Você é impossível!"

# game/chapters/chapter5/script/ch5sc07.rpy:421
translate brazil ch5sc07_c5659e07:

#   mc "So I've been told."
    mc "Foi o que me disseram."

# game/chapters/chapter5/script/ch5sc07.rpy:422
translate brazil ch5sc07_7a9f671f:

#   am "Happy?"
    am "Feliz?"

# game/chapters/chapter5/script/ch5sc07.rpy:425
translate brazil ch5sc07_6907be40:

#   mc "Definitely happy."
    mc "Definitivamente feliz."

# game/chapters/chapter5/script/ch5sc07.rpy:426
translate brazil ch5sc07_0183d6b6:

#   mct "Mmh, she has amazing legs, this dress does a great job of showing just the right amount."
    mct "Hum, ela tem pernas incríveis, esse vestido mostra exatamente a quantidade certa."

# game/chapters/chapter5/script/ch5sc07.rpy:429
translate brazil ch5sc07_54456922:

#   am "Verdict?"
    am "Veredicto?"

# game/chapters/chapter5/script/ch5sc07.rpy:430
translate brazil ch5sc07_aa60b9b3:

#   mc "The dress is beautiful... the woman in the dress?"
    mc "O vestido é lindo... mas a mulher que o veste?"

# game/chapters/chapter5/script/ch5sc07.rpy:431
translate brazil ch5sc07_2a015457:

#   mc "Breathtaking."
    mc "De tirar o fôlego."

# game/chapters/chapter5/script/ch5sc07.rpy:435
translate brazil ch5sc07_75498aa5:

#   am "*Blushing* S-Stop! I'm going to change before you get any further ideas!"
    am "*Corando* P-Pare! Vou me trocar antes que você tenha mais ideias!"

# game/chapters/chapter5/script/ch5sc07.rpy:436
translate brazil ch5sc07_ca7600d0:

#   am "*Softly* T-Thank you for the sweet compliments..."
    am "*Suavemente* O-Obrigada pelos elogios gentis..."

# game/chapters/chapter5/script/ch5sc07.rpy:437
translate brazil ch5sc07_f2d9b980:

#   "Your charisma was high enough to make Amelia believe your compliments are genuine, {b}{color=#87e1fa}Charisma{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Seu carisma era tão grande que fez Amelia acreditar que seus elogios eram genuínos. {b}{color=#87e1fa}Carisma{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc07.rpy:446
translate brazil ch5sc07_70947cee:

#   mc "You're the most beautiful woman I've laid eyes upon."
    mc "Você é a mulher mais linda que meus olhos já viram."

# game/chapters/chapter5/script/ch5sc07.rpy:448
translate brazil ch5sc07_39b3814b:

#   am "Yeah right... you're just saying that."
    am "Ah, claro... você só está dizendo isso."

# game/chapters/chapter5/script/ch5sc07.rpy:450
translate brazil ch5sc07_26eb6d57:

#   am "I'll go change, wait here."
    am "Vou me trocar, espere aqui."

# game/chapters/chapter5/script/ch5sc07.rpy:452
translate brazil ch5sc07_34268ac8:

#   "Your charisma was too low to successfully compliment Amelia."
    "Seu carisma era muito baixo para conseguir elogiar Amelia de forma satisfatória."

# game/chapters/chapter5/script/ch5sc07.rpy:453
translate brazil ch5sc07_783a880a:

#   "Amelia felt you weren't being genuine, her trust has decreased by {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."
    "Amelia sentiu que você não estava sendo sincero, e a confiança dela diminuiu. {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc07.rpy:457
translate brazil ch5sc07_4ee4d05d:

#   mc "I'm not an expert on dresses, but you clean up nicely."
    mc "Não sou especialista em vestidos, mas você fica muito bem de vestido."

# game/chapters/chapter5/script/ch5sc07.rpy:460
translate brazil ch5sc07_f548659a:

#   am "Why, thank you! That almost sounded like a compliment!"
    am "Nossa, muito obrigada! Quase soou como um elogio!"

# game/chapters/chapter5/script/ch5sc07.rpy:461
translate brazil ch5sc07_4269a80d:

#   "Amelia’s trust increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "A confiança de Amelia aumentou em {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc07.rpy:462
translate brazil ch5sc07_d3017a7f:

#   am "Okay, I'd better get back into my clothes. I don’t want to wrinkle the dress before it’s time to use it."
    am "Certo, é melhor eu me vestir de novo. Não quero amassar o vestido antes da hora de usá-lo."

# game/chapters/chapter5/script/ch5sc07.rpy:467
translate brazil ch5sc07_fdd9c401:

#   mc "Why would you wait a month for a dress? Don’t you have plenty...?"
    mc "Por que esperar um mês por um vestido? Você não tem vários...?"

# game/chapters/chapter5/script/ch5sc07.rpy:469
translate brazil ch5sc07_aeef58b1:

#   am "Ugh, men! You wouldn’t understand..."
    am "Ai, homens! Vocês não entenderiam..."

# game/chapters/chapter5/script/ch5sc07.rpy:470
translate brazil ch5sc07_627231e6:

#   am "I’ll just change back. *Sigh*"
    am "Vou voltar ao normal. *Suspiro*"

# game/chapters/chapter5/script/ch5sc07.rpy:475
translate brazil ch5sc07_ee0c51b7:

#   mc "What’s the occasion for such a dress?"
    mc "Qual seria a ocasião para usar um vestido assim?"

# game/chapters/chapter5/script/ch5sc07.rpy:476
translate brazil ch5sc07_d8104ebe:

#   am "A grand celebration... My 20th name day."
    am "Uma grande celebração... Meu 20º aniversário."

# game/chapters/chapter5/script/ch5sc07.rpy:477
translate brazil ch5sc07_2139cad5:

#   am "It’s a whole ordeal in my family, and in most noble houses."
    am "É uma verdadeira provação na minha família, e na maioria das casas nobres."

# game/chapters/chapter5/script/ch5sc07.rpy:479
translate brazil ch5sc07_5a6d84c6:

#   am "A bunch of influential people gather for an evening of food, wine, dancing and courtship."
    am "Um grupo de pessoas influentes se reúne para uma noite de comida, vinho, dança e paquera."

# game/chapters/chapter5/script/ch5sc07.rpy:480
translate brazil ch5sc07_23ec50db:

#   am "And because I'm heir to the throne, I'll have to suffer a bunch of suitors who'll pester me all evening."
    am "E como sou herdeiro do trono, terei que aturar um bando de pretendentes que me importunarão a noite toda."

# game/chapters/chapter5/script/ch5sc07.rpy:481
translate brazil ch5sc07_20b6a344:

#   mc "Judging by your tone, you don’t seem too excited. Even though it’s your own name day."
    mc "Pelo seu tom de voz, você não parece muito animado. Mesmo sendo o seu próprio dia onomástico."

# game/chapters/chapter5/script/ch5sc07.rpy:483
translate brazil ch5sc07_03c3665c:

#   am "I'd like the idea if I got to choose how to celebrate it."
    am "Eu gostaria da ideia se pudesse escolher como comemorá-la."

# game/chapters/chapter5/script/ch5sc07.rpy:484
translate brazil ch5sc07_84ee44ce:

#   am "But really, it’s just a schmooze fest for social climbers..."
    am "Mas, na verdade, é apenas uma festa para bajular pessoas que querem subir na vida..."

# game/chapters/chapter5/script/ch5sc07.rpy:485
translate brazil ch5sc07_e329f3e0:

#   mc "Sounds tedious."
    mc "Parece tedioso."

# game/chapters/chapter5/script/ch5sc07.rpy:486
translate brazil ch5sc07_02a3ba7d:

#   mc "I guess I can see why you aren't too thrilled."
    mc "Acho que consigo entender por que você não está muito entusiasmado."

# game/chapters/chapter5/script/ch5sc07.rpy:488
translate brazil ch5sc07_3007d7b8:

#   am "Imagine it, enduring an entire evening of noblemen and their entitled sons sucking up and trying to win my affection."
    am "Imagine só, ter que aguentar uma noite inteira de nobres e seus filhos mimados bajulando e tentando conquistar meu afeto."

# game/chapters/chapter5/script/ch5sc07.rpy:489
translate brazil ch5sc07_55332467:

#   am "Not because they know me, or like me, but just because they want to join the royal family..."
    am "Não porque me conheçam ou gostem de mim, mas simplesmente porque querem entrar para a família real..."

# game/chapters/chapter5/script/ch5sc07.rpy:491
translate brazil ch5sc07_11c060ec:

#   mc "Hmm. I can imagine. It'd be very annoying to be courted, knowing their intentions aren’t genuine."
    mc "Hum. Consigo imaginar. Seria muito irritante ser cortejada sabendo que as intenções não são genuínas."

# game/chapters/chapter5/script/ch5sc07.rpy:492
translate brazil ch5sc07_d2c3f1e0:

#   am "*Sigh* It’s exhausting, to say the least."
    am "*Suspiro* É exaustivo, para dizer o mínimo."

# game/chapters/chapter5/script/ch5sc07.rpy:493
translate brazil ch5sc07_4b6f7d02:

#   am "And it’s only become worse since I came of age."
    am "E só piorou desde que atingi a maioridade."

# game/chapters/chapter5/script/ch5sc07.rpy:495
translate brazil ch5sc07_6215cc0c:

#   am "Sometimes, I really wish I could just escape."
    am "Às vezes, eu realmente gostaria de poder simplesmente escapar."

# game/chapters/chapter5/script/ch5sc07.rpy:496
translate brazil ch5sc07_a5eaa82d:

#   am "Leave it all and lead a normal life..."
    am "Deixe tudo para trás e leve uma vida normal..."

# game/chapters/chapter5/script/ch5sc07.rpy:497
translate brazil ch5sc07_ec59eef8:

#   am "Get out from under my family's shadow, and escape the superficial bootlicking from the nobility."
    am "Saia da sombra da minha família e escape da bajulação superficial da nobreza."

# game/chapters/chapter5/script/ch5sc07.rpy:499
translate brazil ch5sc07_b4b6753e:

#   mct "I didn't expect her to feel that way."
    mct "Eu não esperava que ela se sentisse assim."

# game/chapters/chapter5/script/ch5sc07.rpy:500
translate brazil ch5sc07_307a6890:

#   mct "I guess it must be overwhelming to be in her position."
    mct "Imagino que deva ser muito difícil estar na posição dela."

# game/chapters/chapter5/script/ch5sc07.rpy:501
translate brazil ch5sc07_35a70e9c:

#   mc "A normal life?"
    mc "Uma vida normal?"

# game/chapters/chapter5/script/ch5sc07.rpy:502
translate brazil ch5sc07_0167ade8:

#   am "Yeah, you know?"
    am "Sim, sabe?"

# game/chapters/chapter5/script/ch5sc07.rpy:503
translate brazil ch5sc07_abeb97db:

#   am "Just dress like a normal farmer's wife, who's going to the market with the goods for the week."
    am "Vista-se como uma típica esposa de fazendeiro, que vai ao mercado com as mercadorias da semana."

# game/chapters/chapter5/script/ch5sc07.rpy:505
translate brazil ch5sc07_0e532530:

#   am "Then return home to the farm, where my husband is hard at work and our kids are playing in the fields."
    am "Depois, volto para casa, para a fazenda, onde meu marido está trabalhando arduamente e nossos filhos estão brincando nos campos."

# game/chapters/chapter5/script/ch5sc07.rpy:506
translate brazil ch5sc07_f4d186cb:

#   am "I'd walk up to him and give him a long hug, a kiss on the cheek, and then head inside to prepare our dinner."
    am "Eu me aproximaria dele, lhe daria um longo abraço, um beijo na bochecha e depois entraria para preparar nosso jantar."

# game/chapters/chapter5/script/ch5sc07.rpy:508
translate brazil ch5sc07_17213a59:

#   mc "You’ve thought about this quite a bit, haven’t you?"
    mc "Você já pensou bastante sobre isso, não é?"

# game/chapters/chapter5/script/ch5sc07.rpy:509
translate brazil ch5sc07_f88bc345:

#   am "Mhm-Hm... It’s just a silly girl's dream."
    am "Hum-hum... É apenas o sonho bobo de uma garota."

# game/chapters/chapter5/script/ch5sc07.rpy:510
translate brazil ch5sc07_db136089:

#   am "Not like it could ever be a reality... not for a princess."
    am "Não que isso pudesse se tornar realidade... não para uma princesa."

# game/chapters/chapter5/script/ch5sc07.rpy:512
translate brazil ch5sc07_9da56252:

#   am "I’m the heir to the throne of Luxeron."
    am "Eu sou o herdeiro do trono de Luxeron."

# game/chapters/chapter5/script/ch5sc07.rpy:513
translate brazil ch5sc07_67961479:

#   mct "She has a lot more depth to her than I initially assumed, a princess... longing for a normal life?"
    mct "Ela tem muito mais profundidade do que eu imaginava inicialmente, uma princesa... ansiando por uma vida normal?"

# game/chapters/chapter5/script/ch5sc07.rpy:514
translate brazil ch5sc07_94ebb64e:

#   am "*Exhales deeply* Okay. All done!"
    am "*Exala profundamente* Ok. Tudo pronto!"

# game/chapters/chapter5/script/ch5sc07.rpy:516
translate brazil ch5sc07_535f76d5:

#   am "Enough about that."
    am "Chega desse assunto."

# game/chapters/chapter5/script/ch5sc07.rpy:517
translate brazil ch5sc07_df37fada:

#   am "We still have to go find some perfume!"
    am "Ainda temos que ir procurar perfume!"

# game/chapters/chapter5/script/ch5sc07.rpy:518
translate brazil ch5sc07_95981b9b:

#   am "Only the best will do, and I happen to know a place with a new assortment."
    am "Só o melhor serve, e por acaso conheço um lugar com uma nova variedade."

# game/chapters/chapter5/script/ch5sc07.rpy:528
translate brazil ch5sc07_4e3e851e:

#   uk "It’s about time we had some new recruits..."
    uk "Já estava na hora de termos novos recrutas..."

# game/chapters/chapter5/script/ch5sc07.rpy:529
translate brazil ch5sc07_09077921:

#   uk "Let’s see how devoted you are."
    uk "Vamos ver o quão dedicado você é."

# game/chapters/chapter5/script/ch5sc07.rpy:530
translate brazil ch5sc07_bda2bbf4:

#   ac "Yes, Mother Ellen."
    ac "Sim, Madre Ellen."

# game/chapters/chapter5/script/ch5sc07.rpy:532
translate brazil ch5sc07_f19b5e53:

#   mell "Now. listen closely. I want you to really get {b}in{/b} there."
    mell "Agora, escute com atenção. Quero que você realmente entenda. {b} em{/b} lá."

# game/chapters/chapter5/script/ch5sc07.rpy:533
translate brazil ch5sc07_6ce53dfc:

#   mell "Don’t let a single spot go untouched by your little virgin tongue."
    mell "Não deixe nenhum cantinho intocado pela sua linguinha virgem."

# game/chapters/chapter5/script/ch5sc07.rpy:538
translate brazil ch5sc07_42739136:

#   mell "*Moans* Oh... Yess... Remember, don’t... don’t miss a spot."
    mell "*Gemidos* Oh... Sim... Lembre-se, não... não deixe nenhum lugar sem pintar."

# game/chapters/chapter5/script/ch5sc07.rpy:539
translate brazil ch5sc07_6529024c:

#   mell "*Moans* Your punishment will be severe if you do... It’s my job to ensure you’re ready for our Lord’s return."
    mell "*Gemidos* Seu castigo será severo se você fizer isso... É meu trabalho garantir que você esteja pronto para o retorno de Nosso Senhor."

# game/chapters/chapter5/script/ch5sc07.rpy:540
translate brazil ch5sc07_2f6e4e89:

#   ac "*Muffled* Yhess Mother. *Lick*"
    ac "*Abafado* Sim, mãe. *Lambe*"

# game/chapters/chapter5/script/ch5sc07.rpy:542
translate brazil ch5sc07_558443e5:

#   mell "*Moan* Such a... Oh... Such a good acolyte. So diligent and eager... Ohhh..."
    mell "*Gemido* Que... Oh... Que bom acólito. Tão diligente e ansioso... Ohhh..."

# game/chapters/chapter5/script/ch5sc07.rpy:543
translate brazil ch5sc07_f8c85384:

#   mell "*Moans* I will personally ensure that you learn... everything."
    mell "*Geme* Eu pessoalmente vou garantir que você aprenda... tudo."

# game/chapters/chapter5/script/ch5sc07.rpy:546
translate brazil ch5sc07_15f6e355:

#   mell "*Moans loudly* {b}OHhH!! YES! THAT’S IT!! GET IN THERE!! OHH!!{/b}"
    mell "*Geme alto* {b} OHHH!! SIM! ISSO MESMO!! ENTRE AÍ!! OHH!!{/b}"

# game/chapters/chapter5/script/ch5sc07.rpy:548
translate brazil ch5sc07_d58a313c:

#   ac "{b}*MUFFLED* MHM!! MHH!! MHMMMH!!!{/b}"
    ac "{b}*abafado* MHM!! Mhhh!! HMMMMH!!!{/b}"

# game/chapters/chapter5/script/ch5sc07.rpy:549
translate brazil ch5sc07_4a7362f0:

#   mell "*Moans* {b}Don’t you fucking stop!{/b} You won’t breathe until I orgasm all over your face!"
    mell "*Gemidos* {b} Não pare, porra!{/b} Você não vai respirar até eu gozar em cima do seu rosto!"

# game/chapters/chapter5/script/ch5sc07.rpy:551
translate brazil ch5sc07_6768c9eb:

#   lx "Lustful as ever, I see. Shouldn’t you find something more productive to do?"
    lx "Vejo que você continua com a mesma lascívia de sempre. Não deveria encontrar algo mais produtivo para fazer?"

# game/chapters/chapter5/script/ch5sc07.rpy:552
translate brazil ch5sc07_aea4e1d2:

#   ac "*Muffled* {b}MH! Mnnhh! Nnhhh!{/b}"
    ac "*Abafado* {b} MH! Mnnhh! Nnhhh!{/b}"

# game/chapters/chapter5/script/ch5sc07.rpy:554
translate brazil ch5sc07_30fb6748:

#   mell "Sister Lux... a pleasure. I'm doing our Lord’s work, ensuring our acolytes are fully devoted."
    mell "Irmã Lux... um prazer. Estou fazendo a obra do nosso Senhor, garantindo que nossos acólitos sejam totalmente devotados."

# game/chapters/chapter5/script/ch5sc07.rpy:556
translate brazil ch5sc07_a1e087ec:

#   lx "I think you have our Lord’s will confused with your own desires..."
    lx "Acho que você está confundindo a vontade de nosso Senhor com seus próprios desejos..."

# game/chapters/chapter5/script/ch5sc07.rpy:558
translate brazil ch5sc07_9a6ec991:

#   ac "*Muffled* {b}MMH! MMHHH!{/b} ... Mhh! Nnnh!"
    ac "*Abafado* {b} MMH! MMHHH!{/b} ... Mhh! Nnnh!"

# game/chapters/chapter5/script/ch5sc07.rpy:560
translate brazil ch5sc07_1e60691c:

#   mell "Nonsense. We have to ensure our acolytes are fully committed to pleasing our Lord."
    mell "Bobagem. Precisamos garantir que nossos acólitos estejam totalmente comprometidos em agradar ao nosso Senhor."

# game/chapters/chapter5/script/ch5sc07.rpy:561
translate brazil ch5sc07_9d95c3d4:

#   mell "Whatever he wishes, whatever he desires... they will be ready."
    mell "O que ele desejar, o que ele almejar... eles estarão prontos."

# game/chapters/chapter5/script/ch5sc07.rpy:563
translate brazil ch5sc07_a21b702a:

#   lx "Whatever. Brother Ember needs this one. So be done with it."
    lx "Tanto faz. O irmão Ember precisa disso. Então, encerre o assunto."

# game/chapters/chapter5/script/ch5sc07.rpy:565
translate brazil ch5sc07_d5c629c4:

#   mell "Sister Lux, you really should join me sometime... your young mind has a lot to learn."
    mell "Irmã Lux, você realmente deveria se juntar a mim algum dia... sua mente jovem tem muito a aprender."

# game/chapters/chapter5/script/ch5sc07.rpy:566
translate brazil ch5sc07_49a43202:

#   mell "You honestly think our Lord will be happy that you saved yourself for him?"
    mell "Você realmente acha que nosso Senhor ficará feliz por você ter se guardado para Ele?"

# game/chapters/chapter5/script/ch5sc07.rpy:567
translate brazil ch5sc07_7ec447ae:

#   mell "He won’t be pleased that you know nothing and our acolytes satisfy him more."
    mell "Ele não ficará satisfeito por você não saber nada e por nossos acólitos o satisfazerem ainda mais."

# game/chapters/chapter5/script/ch5sc07.rpy:568
translate brazil ch5sc07_b8663334:

#   lx "..."
    lx "..."

# game/chapters/chapter5/script/ch5sc07.rpy:595
translate brazil ch5sc07_6949fc58:

#   ta "Lux."
    ta "Lux."

# game/chapters/chapter5/script/ch5sc07.rpy:596
translate brazil ch5sc07_621d5b31:

#   lx "Taron."
    lx "Reunião."

# game/chapters/chapter5/script/ch5sc07.rpy:598
translate brazil ch5sc07_24bcd48b:

#   ta "Don’t you have acolytes to initiate?"
    ta "Você não tem acólitos para iniciar?"

# game/chapters/chapter5/script/ch5sc07.rpy:600
translate brazil ch5sc07_2bd62bdb:

#   lx "Don’t you have a cursed relic to decipher?"
    lx "Você não tem uma relíquia amaldiçoada para decifrar?"

# game/chapters/chapter5/script/ch5sc07.rpy:602
translate brazil ch5sc07_25cb7c61:

#   ta "Heh. Your tongue is as spiteful as ever I see."
    ta "Heh. Vejo que sua língua continua tão maldosa como sempre."

# game/chapters/chapter5/script/ch5sc07.rpy:604
translate brazil ch5sc07_b7c41b9e:

#   lx "You should worry less about my tongue..."
    lx "Você deveria se preocupar menos com a minha língua..."

# game/chapters/chapter5/script/ch5sc07.rpy:605
translate brazil ch5sc07_5a6b5651:

#   lx "And more about what I’ll do to you if you don’t succeed with that relic."
    lx "E mais sobre o que farei com você se não tiver sucesso com essa relíquia."

# game/chapters/chapter5/script/ch5sc07.rpy:607
translate brazil ch5sc07_0a548c99:

#   ta "Tsk, tsk. Lux... Insulting our Lord’s chosen champion? Is that really devotion?"
    ta "Que feio. Lux... Insultar o campeão escolhido por nosso Senhor? Isso é mesmo devoção?"

# game/chapters/chapter5/script/ch5sc07.rpy:608
translate brazil ch5sc07_44396fac:

#   ta "You really should be a smidge more affectionate towards me. We’ll be sharing a bed soon, after all."
    ta "Você deveria ser um pouco mais carinhoso(a) comigo. Afinal, em breve estaremos dividindo a cama."

# game/chapters/chapter5/script/ch5sc07.rpy:610
translate brazil ch5sc07_0e0a9bae:

#   lx "You’re even more delusional than I thought. Did Brother Ember fry your brain?"
    lx "Você é ainda mais delirante do que eu pensava. O Irmão Ember fritou seu cérebro?"

# game/chapters/chapter5/script/ch5sc07.rpy:611
translate brazil ch5sc07_fb5667b6:

#   lx "I am our Lord’s betrothed. If you think I'd ever soil myself by sharing a bed with vermin like you-"
    lx "Sou a prometida de Nosso Senhor. Se você pensa que eu me sujaria compartilhando a cama com vermes como você..."

# game/chapters/chapter5/script/ch5sc07.rpy:613
translate brazil ch5sc07_0c4bb900:

#   ta "Oh, but you will... dear Lux."
    ta "Ah, mas você vai... querida Lux."

# game/chapters/chapter5/script/ch5sc07.rpy:614
translate brazil ch5sc07_96ac1bbb:

#   ta "Our Lord promised me anything I desire upon his return."
    ta "Nosso Senhor me prometeu tudo o que eu desejar quando ele voltar."

# game/chapters/chapter5/script/ch5sc07.rpy:616
translate brazil ch5sc07_1759cb9e:

#   ta "And I think I’ll include that tight, voluptuous body of yours on my list."
    ta "E acho que vou incluir esse seu corpo firme e voluptuoso na minha lista."

# game/chapters/chapter5/script/ch5sc07.rpy:618
translate brazil ch5sc07_5d346b8b:

#   ta "What’s that? No spiteful remarks? Heh."
    ta "O quê? Sem comentários maldosos? Heh."

# game/chapters/chapter5/script/ch5sc07.rpy:620
translate brazil ch5sc07_5f8ba462:

#   ta "You might as well start seeking guidance from Mother Ellen."
    ta "Você bem que poderia começar a buscar orientação com a Madre Ellen."

# game/chapters/chapter5/script/ch5sc07.rpy:621
translate brazil ch5sc07_067009dc:

#   ta "I’m sure she'll be happy to teach you how to be a proper woman."
    ta "Tenho certeza de que ela ficará feliz em te ensinar como ser uma mulher de verdade."

# game/chapters/chapter5/script/ch5sc07.rpy:624
translate brazil ch5sc07_d7fe6efa:

#   lx "Out of my way! {b}Filth!{/b}"
    lx "Sai da minha frente! {b} Sujeira!{/b}"

# game/chapters/chapter5/script/ch5sc07.rpy:625
translate brazil ch5sc07_da684f9f:

#   ta "Keep playing hard to get. It just makes me crave you more."
    ta "Continue se fazendo de difícil. Isso só me faz desejar você ainda mais."

# game/chapters/chapter5/script/ch5sc07.rpy:626
translate brazil ch5sc07_06f9a0fc:

#   ta "I'm going to take my sweet time with you, Lux."
    ta "Vou aproveitar cada momento com você, Lux."

# game/chapters/chapter5/script/ch5sc07.rpy:630
translate brazil ch5sc07_4d459c42:

#   lx "Taron, sweetie... you’re forgetting something."
    lx "Taron, querido... você está se esquecendo de algo."

# game/chapters/chapter5/script/ch5sc07.rpy:634
translate brazil ch5sc07_e264883c:

#   ta "Finally come to your senses, eh?"
    ta "Finalmente caiu em si, hein?"

# game/chapters/chapter5/script/ch5sc07.rpy:635
translate brazil ch5sc07_7ae907b1:

#   lx "You could say that."
    lx "Pode-se dizer isso."

# game/chapters/chapter5/script/ch5sc07.rpy:638
translate brazil ch5sc07_b66f2eec:

#   ta "*Painful groan* {b}Argh!{/b}"
    ta "*Gemido de dor* {b} Argh!{/b}"

# game/chapters/chapter5/script/ch5sc07.rpy:639
translate brazil ch5sc07_f07ff47a:

#   ta "*Stuttering* B-Bitch! You- Arhh! You'll regret this!"
    ta "*Gaguejando* V-Vadia! Você- Argh! Você vai se arrepender disso!"

# game/chapters/chapter5/script/ch5sc07.rpy:642
translate brazil ch5sc07_f8cd4740:

#   lx "It seems you're the one who needs a lesson... in obedience."
    lx "Parece que quem precisa de uma lição... de obediência é você."

# game/chapters/chapter5/script/ch5sc07.rpy:643
translate brazil ch5sc07_9b4ea6bc:

#   ta "*Agonizing groan* {b}Arhghh!!{/b} Stop!"
    ta "*Gemido agonizante* {b} Arghh!!{/b} Parar!"

# game/chapters/chapter5/script/ch5sc07.rpy:644
translate brazil ch5sc07_18b40ce7:

#   lx "Your leadership within the Mercenaries guild, and your position within our faith, has clearly made you arrogant."
    lx "Sua liderança na guilda dos Mercenários e sua posição em nossa fé claramente o tornaram arrogante."

# game/chapters/chapter5/script/ch5sc07.rpy:646
translate brazil ch5sc07_dac8a5bb:

#   lx "I’ve tolerated your advances, your jokes, and that insufferable attitude..."
    lx "Tolerei suas investidas, suas piadas e essa sua atitude insuportável..."

# game/chapters/chapter5/script/ch5sc07.rpy:647
translate brazil ch5sc07_d8c67f03:

#   lx "Only because you have been useful. Yet, now it seems your usefulness and capability are shrinking by the day."
    lx "Só porque você foi útil. No entanto, agora parece que sua utilidade e capacidade estão diminuindo a cada dia."

# game/chapters/chapter5/script/ch5sc07.rpy:650
translate brazil ch5sc07_de2b3747:

#   ta "*Painful groan* {b}Argh! It’s burning!! Ahhhrgh!{/b}"
    ta "*Gemido de dor* {b} Argh! Está queimando!! Ahhhrgh!{/b}"

# game/chapters/chapter5/script/ch5sc07.rpy:651
translate brazil ch5sc07_de56770b:

#   lx "Let me be clear, dearest Taron. Once you’re no longer of use to us, I will personally boil you from the inside... alive."
    lx "Para que fique bem claro, meu querido Taron. Assim que você não nos servir mais de nada, eu mesmo o ferverei por dentro... vivo."

# game/chapters/chapter5/script/ch5sc07.rpy:652
translate brazil ch5sc07_12e4da7f:

#   lx "You'll feel your organs melt, long before I finally show mercy and incinerate you."
    lx "Você sentirá seus órgãos derreterem muito antes de eu finalmente ter misericórdia e incinerá-lo."

# game/chapters/chapter5/script/ch5sc07.rpy:653
translate brazil ch5sc07_eae2fe92:

#   lx "All that will be left of you will be charred bone, once your flesh has been vaporized."
    lx "Tudo o que restará de você serão ossos carbonizados, depois que sua carne tiver sido vaporizada."

# game/chapters/chapter5/script/ch5sc07.rpy:655
translate brazil ch5sc07_4f12001d:

#   lx "This spell will wear off in a few hours."
    lx "Esse feitiço vai passar em algumas horas."

# game/chapters/chapter5/script/ch5sc07.rpy:656
translate brazil ch5sc07_3046dddf:

#   lx "Until then, you can sit here and contemplate your sorry excuse for an existence."
    lx "Até lá, você pode ficar aí sentado contemplando a sua lamentável desculpa de existência."

# game/chapters/chapter5/script/ch5sc07.rpy:664
translate brazil ch5sc07_95ad13c6:

#   mc "This is the place that has your perfumes?"
    mc "É aqui que você encontra seus perfumes?"

# game/chapters/chapter5/script/ch5sc07.rpy:666
translate brazil ch5sc07_ad183718:

#   am "Yes. What about it?"
    am "Sim. E daí?"

# game/chapters/chapter5/script/ch5sc07.rpy:668
translate brazil ch5sc07_296a9ace:

#   mc "Just didn’t expect an alchemy shop to dabble in the perfume market."
    mc "Simplesmente não esperava que uma loja de alquimia se aventurasse no mercado de perfumes."

# game/chapters/chapter5/script/ch5sc07.rpy:670
translate brazil ch5sc07_ecd84389:

#   mer "Why not? Perfumes are quite lucrative and they're simple to brew."
    mer "Por que não? Os perfumes são bastante lucrativos e fáceis de produzir."

# game/chapters/chapter5/script/ch5sc07.rpy:672
translate brazil ch5sc07_1a3a17e7:

#   mer "Hello, handsome. Making friends with the Princess? You don’t sit still for long."
    mer "Olá, bonitão. Fazendo amizade com a princesa? Você não fica parado por muito tempo."

# game/chapters/chapter5/script/ch5sc07.rpy:674
translate brazil ch5sc07_73239a8d:

#   am "We’re not friends, he’s my bodyguard. Father’s wishes."
    am "Não somos amigos, ele é meu guarda-costas. É o desejo do meu pai."

# game/chapters/chapter5/script/ch5sc07.rpy:676
translate brazil ch5sc07_5d096849:

#   mer "Oh, come now. Having such a strapping and capable man by your side must be... exhilarating!"
    mer "Ora, vamos lá. Ter um homem tão forte e capaz ao seu lado deve ser... emocionante!"

# game/chapters/chapter5/script/ch5sc07.rpy:678
translate brazil ch5sc07_2a49a098:

#   mer "I know I'd love to feel protected and cared for by such a... specimen."
    mer "Eu sei que adoraria me sentir protegida e cuidada por um espécime assim..."

# game/chapters/chapter5/script/ch5sc07.rpy:679
translate brazil ch5sc07_9f8e64c4:

#   mct "{i}Subtle, Meredith... subtle.{/i}"
    mct "{i}Sutil, Meredith... sutil.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:681
translate brazil ch5sc07_6dbd9618:

#   am "Well, you can borrow him for a bit while I look at your newest selection of perfumes."
    am "Bem, você pode pegá-lo emprestado por um tempinho enquanto eu dou uma olhada na sua nova seleção de perfumes."

# game/chapters/chapter5/script/ch5sc07.rpy:683
translate brazil ch5sc07_ab01056c:

#   am "He’ll just complain about having to smell each one of them."
    am "Ele vai simplesmente reclamar por ter que sentir o cheiro de cada um deles."

# game/chapters/chapter5/script/ch5sc07.rpy:685
translate brazil ch5sc07_de026640:

#   mer "I won’t refuse such a kindness, Your Grace. The new selection is in the room out back."
    mer "Não recusarei tamanha gentileza, Vossa Graça. A nova seleção está na sala dos fundos."

# game/chapters/chapter5/script/ch5sc07.rpy:686
translate brazil ch5sc07_6265a09b:

#   mer "I’m sure you'll find something delightful that will be perfect for your upcoming big event."
    mer "Tenho certeza de que você encontrará algo encantador que será perfeito para o seu grande evento que se aproxima."

# game/chapters/chapter5/script/ch5sc07.rpy:688
translate brazil ch5sc07_abb4aa64:

#   am "Great! I’ll be back in a while. You can look at some potions or, y'know, do bodyguard stuff."
    am "Ótimo! Já volto. Você pode dar uma olhada em algumas poções ou, sabe, fazer um trabalho de guarda-costas."

# game/chapters/chapter5/script/ch5sc07.rpy:689
translate brazil ch5sc07_a64a069c:

#   mct "{i}Great...{/i}"
    mct "{i}Ótimo...{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:691
translate brazil ch5sc07_9bae7e65:

#   mer "*Whispers* {size=-10}{b}Don’t worry, handsome. I have a feeling we’ll manage just fine while the Princess is busy.{/b}{/size}"
    mer "*Sussurros* {size=-10}{b}Não se preocupe, meu lindo. Tenho a impressão de que nos viraremos muito bem enquanto a princesa estiver ocupada.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc07.rpy:692
translate brazil ch5sc07_73117484:

#   mer "*Whispers* {size=-10}{b}In fact... I have an idea. Why don’t I get down on my knees and show you what I have in mind?{/b}{/size}"
    mer "*Sussurros* {size=-10}{b}Na verdade... tive uma ideia. Que tal eu me ajoelhar e mostrar o que tenho em mente?{/b}{/size}"

# game/chapters/chapter5/script/ch5sc07.rpy:693
translate brazil ch5sc07_1324402c:

#   mct "{i}Is she serious? Amelia is right in the next room...{/i}"
