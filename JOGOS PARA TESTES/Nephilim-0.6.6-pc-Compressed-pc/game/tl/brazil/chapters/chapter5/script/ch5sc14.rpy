# game/chapters/chapter5/script/ch5sc14.rpy:3832
translate brazil ch5sc14_7dc31c2b:

#   mc "You can just leave the food here and I’ll have at it. Thank you."
    mc "Pode deixar a comida aqui que eu me viro. Obrigada."

# game/chapters/chapter5/script/ch5sc14.rpy:3835
translate brazil ch5sc14_647d935c:

#   am "You’re welcome. I’m going to be busy today, so you’re not required at the palace today."
    am "De nada. Estarei ocupado hoje, então sua presença no palácio não é necessária."

# game/chapters/chapter5/script/ch5sc14.rpy:3837
translate brazil ch5sc14_e181a116:

#   mc "Great! See you another time then."
    mc "Ótimo! Até a próxima então."

# game/chapters/chapter5/script/ch5sc14.rpy:3838
translate brazil ch5sc14_39678539:

#   am "Enjoy!"
    am "Aproveitar!"

# game/chapters/chapter5/script/ch5sc14.rpy:3865
translate brazil ch5sc14_fa3e8c51:

#   be "And as such, we must all fulfill the purpose which our Lord eternal has given to us."
    be "E, como tal, todos devemos cumprir o propósito que nosso Senhor eterno nos confiou."

# game/chapters/chapter5/script/ch5sc14.rpy:3867
translate brazil ch5sc14_e4841f77:

#   be "Acolytes, today two of you will be granted the Lord's light. Two of you have served faithfully."
    be "Acólitos, hoje dois de vocês receberão a luz do Senhor. Dois de vocês serviram fielmente."

# game/chapters/chapter5/script/ch5sc14.rpy:3869
translate brazil ch5sc14_479230bf:

#   be "But one of you... one of you has faltered."
    be "Mas um de vocês... um de vocês vacilou."

# game/chapters/chapter5/script/ch5sc14.rpy:3870
translate brazil ch5sc14_e8679e0e:

#   be "The Lord shall feast on his soul and his redemption shall come to pass."
    be "O Senhor se banqueteará com a sua alma e a sua redenção se cumprirá."

# game/chapters/chapter5/script/ch5sc14.rpy:3872
translate brazil ch5sc14_19eb1685:

#   be "Sister Lux has graced us with her presence. She will observe your faith and judge you."
    be "A irmã Lux nos agraciou com sua presença. Ela observará sua fé e o julgará."

# game/chapters/chapter5/script/ch5sc14.rpy:3874
translate brazil ch5sc14_23bef758:

#   be "She is one of the few who has been fully brought into the light, as I myself have been so blessed."
    be "Ela é uma das poucas que foi totalmente trazida à luz, assim como eu mesma fui tão abençoada."

# game/chapters/chapter5/script/ch5sc14.rpy:3876
translate brazil ch5sc14_f90daf5c:

#   lx "May the Lord’s light find you in the darkness, acolytes."
    lx "Que a luz do Senhor vos encontre na escuridão, acólitos."

# game/chapters/chapter5/script/ch5sc14.rpy:3882
translate brazil ch5sc14_d052f0ee:

#   lx "Thank you, Brother Ember."
    lx "Obrigado, irmão Ember."

# game/chapters/chapter5/script/ch5sc14.rpy:3883
translate brazil ch5sc14_8274723b:

#   lx "The hour of reaping is one that pleases our Lord."
    lx "A hora da colheita é uma hora que agrada ao nosso Senhor."

# game/chapters/chapter5/script/ch5sc14.rpy:3885
translate brazil ch5sc14_96d782f3:

#   lx "Uhn, tuh, itoh."
    lx "Hum, bem, é isso."

# game/chapters/chapter5/script/ch5sc14.rpy:3887
translate brazil ch5sc14_16550f1a:

#   evr "Itoh, tuh, Uhn."
    evr "É, é, Uhn."

# game/chapters/chapter5/script/ch5sc14.rpy:3889
translate brazil ch5sc14_ba14c325:

#   lx "Irh, Ikh, Rhu."
    lx "Irh, Ikh, Rhu."

# game/chapters/chapter5/script/ch5sc14.rpy:3891
translate brazil ch5sc14_52ed1586:

#   lx "Mhm... Acolyte Darius, you’ve served Brother Ember faithfully. Your faith has been proven."
    lx "Hum... Acólito Darius, você serviu ao Irmão Ember fielmente. Sua fé foi provada."

# game/chapters/chapter5/script/ch5sc14.rpy:3893
translate brazil ch5sc14_20d39ca0:

#   lx "Acolyte Hanna, You’ve served Mother Ellen faithfully. Your faith has been proven."
    lx "Acólita Hanna, você serviu à Mãe Ellen fielmente. Sua fé foi provada."

# game/chapters/chapter5/script/ch5sc14.rpy:3895
translate brazil ch5sc14_abe9daf3:

#   lx "She’s very pleased with you, I hear."
    lx "Ouvi dizer que ela está muito satisfeita com você."

# game/chapters/chapter5/script/ch5sc14.rpy:3897
translate brazil ch5sc14_f5de2ab9:

#   lx "As for you, Acolyte Mathi."
    lx "Quanto a você, Acólito Mathi."

# game/chapters/chapter5/script/ch5sc14.rpy:3898
translate brazil ch5sc14_de919534:

#   lx "Your faith under Brother Ember has faltered."
    lx "Sua fé sob a liderança do Irmão Ember vacilou."

# game/chapters/chapter5/script/ch5sc14.rpy:3900
translate brazil ch5sc14_5f4f5c3a:

#   ac "W-What?! No! I want to serve the Lord!"
    ac "O quê?! Não! Eu quero servir ao Senhor!"

# game/chapters/chapter5/script/ch5sc14.rpy:3902
translate brazil ch5sc14_bc90473b:

#   lx "Shh... you will serve him, eternally."
    lx "Shhh... você o servirá eternamente."

# game/chapters/chapter5/script/ch5sc14.rpy:3904
translate brazil ch5sc14_c8126ef5:

#   lx "As I just said, the reaping is about to begin and it pleases our Lord greatly. Go on, ascend the altar."
    lx "Como eu disse, a colheita está prestes a começar e isso agrada muito ao nosso Senhor. Continuem, subam ao altar."

# game/chapters/chapter5/script/ch5sc14.rpy:3906
translate brazil ch5sc14_18146049:

#   ac "Uhh... I don’t know about this. Isn’t there something else I-I can do to serve?"
    ac "Hum... Não sei não. Não há outra coisa que eu possa fazer para servir?"

# game/chapters/chapter5/script/ch5sc14.rpy:3907
translate brazil ch5sc14_d71e14a7:

#   lx "Get up acolyte, the Lord awaits you."
    lx "Levanta-te, acólito, o Senhor te espera."

# game/chapters/chapter5/script/ch5sc14.rpy:3909
translate brazil ch5sc14_c99a587a:

#   ac "The Lord will grant me mercy, right?"
    ac "O Senhor terá misericórdia de mim, não é?"

# game/chapters/chapter5/script/ch5sc14.rpy:3910
translate brazil ch5sc14_e39f1c93:

#   ac "His light is supposed to guide us eternally."
    ac "Sua luz deve nos guiar eternamente."

# game/chapters/chapter5/script/ch5sc14.rpy:3912
translate brazil ch5sc14_8add4677:

#   lx "Acolyte Darius... Acolyte Hanna... you know what to do."
    lx "Acólito Darius... Acólita Hanna... vocês sabem o que fazer."

# game/chapters/chapter5/script/ch5sc14.rpy:3913
translate brazil ch5sc14_747f7e6d:

#   be "I’ll leave you to it, Sister Lux. Enjoy the reaping."
    be "Deixo você em paz, Irmã Lux. Aproveite a colheita."

# game/chapters/chapter5/script/ch5sc14.rpy:3915
translate brazil ch5sc14_dbd29564:

#   ac "G-Guys?! What are you doing?! W-We’re in this together!"
    ac "G-Gente?! O que vocês estão fazendo?! E-Estamos juntos nessa!"

# game/chapters/chapter5/script/ch5sc14.rpy:3917
translate brazil ch5sc14_6f211a4d:

#   ac "{b}GUYS!?{/b}"
    ac "{b}PESSOAL!?{/b}"

# game/chapters/chapter5/script/ch5sc14.rpy:3918
translate brazil ch5sc14_a32c5f28:

#   lx "Uhn, Eternah, Eternuh, Roh, Kuh, Mur!"
    lx "Uhn, Eterno, Eterno, Espírito, Kuh, Mur!"

# game/chapters/chapter5/script/ch5sc14.rpy:3920
translate brazil ch5sc14_2d510be0:

#   lx "Blessed be thy blade, oh Lord of light, Lord of the eternal flame, accept this soul as thy own."
    lx "Bendita seja a tua lâmina, ó Senhor da luz, Senhor da chama eterna, aceita esta alma como tua."

# game/chapters/chapter5/script/ch5sc14.rpy:3921
translate brazil ch5sc14_29324964:

#   lx "May his wretched soul grant you strength. Strength to arise with the new dawn!"
    lx "Que sua alma miserável lhe dê forças. Força para ressurgir com o novo amanhecer!"

# game/chapters/chapter5/script/ch5sc14.rpy:3924
translate brazil ch5sc14_15ca858d:

#   ac "Grhghr! Hgrh! Ghrhh..."
    ac "Grrghr! Hgrh! Ghrhh..."

# game/chapters/chapter5/script/ch5sc14.rpy:3926
translate brazil ch5sc14_b8663334:

#   lx "..."
    lx "..."

# game/chapters/chapter5/script/ch5sc14.rpy:3928
translate brazil ch5sc14_5b6a32e6:

#   lx "The reaping is complete. Make sure to clean his body before you burn it."
    lx "A colheita está completa. Certifique-se de limpar o corpo dele antes de queimá-lo."

# game/chapters/chapter5/script/ch5sc14.rpy:3943
translate brazil ch5sc14_199a3248:

#   am "What in the five hells and high heavens were you thinking?!"
    am "Em que diabos você estava pensando?!"

# game/chapters/chapter5/script/ch5sc14.rpy:3944
translate brazil ch5sc14_6fa3bf6f:

#   bn "Daughter-"
    bn "Filha-"

# game/chapters/chapter5/script/ch5sc14.rpy:3946
translate brazil ch5sc14_4348671f:

#   am "Don’t 'daughter' me! You had [mc] suffering in the dungeons! {b}FOR NO REASON!!{/b}"
    am "Não me chame de \"filha\"! Você tinha [mc] Sofrendo nas masmorras! {b} SEM MOTIVO ALGUM!!{/b}"

# game/chapters/chapter5/script/ch5sc14.rpy:3948
translate brazil ch5sc14_f52b9df1:

#   am "He was innocent! He’s protecting me and you just went and locked him up!"
    am "Ele era inocente! Ele estava me protegendo e você simplesmente o prendeu!"

# game/chapters/chapter5/script/ch5sc14.rpy:3950
translate brazil ch5sc14_b4917e82:

#   am "If it wasn’t for him and his friends, I'd be well on the way to Lord Alaric’s manor in the south!"
    am "Se não fosse por ele e seus amigos, eu já estaria a caminho da mansão de Lorde Alaric, no sul!"

# game/chapters/chapter5/script/ch5sc14.rpy:3951
translate brazil ch5sc14_d753b49b:

#   am "Do you have any idea what they were going to do to me?!"
    am "Você tem ideia do que eles iam fazer comigo?!"

# game/chapters/chapter5/script/ch5sc14.rpy:3953
translate brazil ch5sc14_2726e114:

#   bn "Sweetheart, I know... I acted without thinking. But I promise you, their treason will not go unpunished."
    bn "Meu bem, eu sei... agi sem pensar. Mas prometo que a traição deles não ficará impune."

# game/chapters/chapter5/script/ch5sc14.rpy:3954
translate brazil ch5sc14_8561eb3e:

#   bn "As for [mc] and his companions, I’ve granted just about everything he asked for."
    bn "Quanto a [mc] E aos seus companheiros, concedi praticamente tudo o que ele pediu."

# game/chapters/chapter5/script/ch5sc14.rpy:3956
translate brazil ch5sc14_8489b429:

#   am "That is the only reason I’m even speaking to you. I’m going to host a banquet for them."
    am "Essa é a única razão pela qual estou falando com você. Vou oferecer um banquete para eles."

# game/chapters/chapter5/script/ch5sc14.rpy:3957
translate brazil ch5sc14_359be56d:

#   am "I want to meet and thank each and every one of them."
    am "Quero conhecer e agradecer a cada um deles."

# game/chapters/chapter5/script/ch5sc14.rpy:3959
translate brazil ch5sc14_3840a0ef:

#   bn "Honey ... that’s surprisingly mature of you. I think that’s a brilliant idea!"
    bn "Querida... isso é surpreendentemente maduro da sua parte. Acho que é uma ideia brilhante!"

# game/chapters/chapter5/script/ch5sc14.rpy:3960
translate brazil ch5sc14_d6a3eb01:

#   bn "You’re starting to develop a political mind. You’ll have to sharpen it to navigate court once you rule."
    bn "Você está começando a desenvolver uma mente política. Terá que aprimorá-la para se sair bem nos tribunais quando assumir o cargo."

# game/chapters/chapter5/script/ch5sc14.rpy:3962
translate brazil ch5sc14_d45ea4d1:

#   am "I’m not inviting them here for that! I want to personally meet them and show them my appreciation."
    am "Não os estou convidando aqui para isso! Quero conhecê-los pessoalmente e demonstrar meu apreço."

# game/chapters/chapter5/script/ch5sc14.rpy:3964
translate brazil ch5sc14_3c8a1eb1:

#   am "In fact, I don’t even want you or Mother present for the banquet. No guards, no servants either."
    am "Na verdade, eu nem quero você ou a mamãe presentes no banquete. Nem guardas, nem criados."

# game/chapters/chapter5/script/ch5sc14.rpy:3965
translate brazil ch5sc14_2fd89320:

#   am "Just me, meeting [mc] and his friends."
    am "Só eu, em reunião [mc] e seus amigos."

# game/chapters/chapter5/script/ch5sc14.rpy:3966
translate brazil ch5sc14_afcad377:

#   bn "Of course, sweetie ... anything you want."
    bn "Claro, querida... tudo o que você quiser."

# game/chapters/chapter5/script/ch5sc14.rpy:3970
translate brazil ch5sc14_77710eba:

#   qm "Vila, do you think I’m a good person?"
    qm "Vila, você acha que eu sou uma boa pessoa?"

# game/chapters/chapter5/script/ch5sc14.rpy:3972
translate brazil ch5sc14_e7752b51:

#   md "Of course, Your Grace. Why would you ask such a thing?"
    md "Claro, Vossa Graça. Por que perguntaria uma coisa dessas?"

# game/chapters/chapter5/script/ch5sc14.rpy:3974
translate brazil ch5sc14_e670d7a1:

#   qm "I’ve been having thoughts as of late... thoughts that are very... wrong."
    qm "Ultimamente tenho tido pensamentos... pensamentos muito... errados."

# game/chapters/chapter5/script/ch5sc14.rpy:3976
translate brazil ch5sc14_64de02ae:

#   md "What sort of thoughts, Your Grace?"
    md "Que tipo de pensamentos, Vossa Graça?"

# game/chapters/chapter5/script/ch5sc14.rpy:3978
translate brazil ch5sc14_f8823754:

#   qm "*Sighs* I’ve been having desires... desires I didn't even have when I was a young maiden."
    qm "*Suspiro* Tenho tido desejos... desejos que nem sequer tinha quando era uma jovem donzela."

# game/chapters/chapter5/script/ch5sc14.rpy:3980
translate brazil ch5sc14_d3e5ebc7:

#   qm "I’m quite taken aback by it. Having such... feelings for a younger man."
    qm "Fiquei bastante surpresa com isso. Ter esses... sentimentos por um homem mais jovem."

# game/chapters/chapter5/script/ch5sc14.rpy:3982
translate brazil ch5sc14_adc447a7:

#   md "Your Grace, you’re having feelings for someone other than your husband?"
    md "Vossa Graça, a senhora está nutrindo sentimentos por alguém que não seja seu marido?"

# game/chapters/chapter5/script/ch5sc14.rpy:3984
translate brazil ch5sc14_1b7d77ef:

#   qm "Yes... I’ve never had feelings for Bennen."
    qm "Sim... Nunca tive sentimentos por Bennen."

# game/chapters/chapter5/script/ch5sc14.rpy:3985
translate brazil ch5sc14_a7d1b735:

#   qm "I had a crush on him when we first met, but it never developed past that."
    qm "Eu tinha uma queda por ele quando nos conhecemos, mas nunca passou disso."

# game/chapters/chapter5/script/ch5sc14.rpy:3986
translate brazil ch5sc14_d52ff473:

#   qm "As I’ve told you before, after our wedding night... everything went downhill fast."
    qm "Como já lhe disse antes, depois da nossa noite de núpcias... tudo desandou rapidamente."

# game/chapters/chapter5/script/ch5sc14.rpy:3988
translate brazil ch5sc14_26b32632:

#   qm "What little crush I still had quickly crumbled to nothing, and I’ve never felt desire for any man since."
    qm "A pouca paixão que ainda sentia por mim rapidamente se desfez, e nunca mais senti desejo por nenhum homem desde então."

# game/chapters/chapter5/script/ch5sc14.rpy:3989
translate brazil ch5sc14_9b7309d7:

#   qm "Until recently..."
    qm "Até recentemente..."

# game/chapters/chapter5/script/ch5sc14.rpy:3991
translate brazil ch5sc14_802d17e8:

#   md "Your Grace, you married Bennen out of duty, not choice..."
    md "Vossa Graça, a senhora casou-se com Bennen por dever, não por escolha..."

# game/chapters/chapter5/script/ch5sc14.rpy:3992
translate brazil ch5sc14_904c963a:

#   md "And now you’ve met someone who you want to choose of your own accord."
    md "E agora você conheceu alguém que deseja escolher por sua própria vontade."

# game/chapters/chapter5/script/ch5sc14.rpy:3993
translate brazil ch5sc14_b6508cb5:

#   md "Maybe he’s the one you’re meant to be with?"
    md "Talvez ele seja o homem certo para você?"

# game/chapters/chapter5/script/ch5sc14.rpy:3995
translate brazil ch5sc14_88baef63:

#   qm "Maybe... *Sighs* But there’s nothing I can do about it, Vila. You know it as well as I do."
    qm "Talvez... *Suspiro* Mas não há nada que eu possa fazer a respeito, Vila. Você sabe disso tão bem quanto eu."

# game/chapters/chapter5/script/ch5sc14.rpy:3997
translate brazil ch5sc14_5e4501f4:

#   qm "As women, we have little say in the matter."
    qm "Como mulheres, temos pouca voz nessa questão."

# game/chapters/chapter5/script/ch5sc14.rpy:3998
translate brazil ch5sc14_f852dec2:

#   qm "The only way marriages end is if the man wills it so, or if your spouse dies."
    qm "A única maneira de um casamento terminar é se o homem assim o desejar, ou se o cônjuge falecer."

# game/chapters/chapter5/script/ch5sc14.rpy:3999
translate brazil ch5sc14_d4dd0547:

#   qm "I doubt Bennen will ever want to divorce me. I’m still a good match politically."
    qm "Duvido que Bennen algum dia queira se divorciar de mim. Ainda somos uma boa combinação política."

# game/chapters/chapter5/script/ch5sc14.rpy:4001
translate brazil ch5sc14_523c3f17:

#   qm "And gods forbid anything should happen to him. He still has many years ahead of him."
    qm "E que Deus nos livre de que algo lhe aconteça. Ele ainda tem muitos anos pela frente."

# game/chapters/chapter5/script/ch5sc14.rpy:4002
translate brazil ch5sc14_2179ebee:

#   qm "We're a horrible match romantically, but as parents and rulers, we do make a great team."
    qm "Somos um péssimo par romântico, mas como pais e governantes, formamos uma ótima equipe."

# game/chapters/chapter5/script/ch5sc14.rpy:4004
translate brazil ch5sc14_92cba0b2:

#   qm "So, as you can see... I’m stuck."
    qm "Então, como você pode ver... estou sem saída."

# game/chapters/chapter5/script/ch5sc14.rpy:4005
translate brazil ch5sc14_32b53738:

#   qm "Longing for a man I can't be with. The love and care I’ve always wanted almost within reach."
    qm "Ansiando por um homem com quem não posso estar. O amor e o carinho que sempre desejei, quase ao meu alcance."

# game/chapters/chapter5/script/ch5sc14.rpy:4006
translate brazil ch5sc14_c072cde4:

#   qm "But so distant, it feels hopeless."
    qm "Mas tão distante, parece desesperador."

# game/chapters/chapter5/script/ch5sc14.rpy:4008
translate brazil ch5sc14_689a8467:

#   md "Your Grace... it’s not my place... as women, we aren’t allowed to follow our desires outside of marriage."
    md "Vossa Graça... não me cabe... como mulheres, não nos é permitido seguir nossos desejos fora do casamento."

# game/chapters/chapter5/script/ch5sc14.rpy:4009
translate brazil ch5sc14_132dcdb8:

#   md "But... you’re the queen."
    md "Mas... você é a rainha."

# game/chapters/chapter5/script/ch5sc14.rpy:4010
translate brazil ch5sc14_267800d1:

#   md "Isn’t there some way you can have a lover? So many nobles at court have multiple wives and mistresses!"
    md "Não existe alguma maneira de você ter um(a) amante? Muitos nobres na corte têm várias esposas e amantes!"

# game/chapters/chapter5/script/ch5sc14.rpy:4012
translate brazil ch5sc14_f5181dd8:

#   qm "I appreciate your support in this, but I’m afraid not."
    qm "Agradeço seu apoio, mas receio que não."

# game/chapters/chapter5/script/ch5sc14.rpy:4013
translate brazil ch5sc14_866fcce2:

#   qm "It’s how it is for women. I’m just going to have to stay strong."
    qm "É assim que as coisas são para as mulheres. Só me resta manter a força."

# game/chapters/chapter5/script/ch5sc14.rpy:4015
translate brazil ch5sc14_ca6272b4:

#   qm "Which is easier said than done."
    qm "O que é mais fácil dizer do que fazer."

# game/chapters/chapter5/script/ch5sc14.rpy:4016
translate brazil ch5sc14_bfd3c88b:

#   qm "Whenever I’m in his presence... I feel so free that anything seems possible."
    qm "Sempre que estou na presença dele... sinto-me tão livre que tudo parece possível."

# game/chapters/chapter5/script/ch5sc14.rpy:4018
translate brazil ch5sc14_31d84291:

#   qm "It’s dangerous for me to be near him."
    qm "É perigoso para mim ficar perto dele."

# game/chapters/chapter5/script/ch5sc14.rpy:4019
translate brazil ch5sc14_b94abe47:

#   qm "I have a hard time containing myself or my feelings with him around."
    qm "Tenho dificuldade em me controlar ou em controlar meus sentimentos quando ele está por perto."

# game/chapters/chapter5/script/ch5sc14.rpy:4021
translate brazil ch5sc14_029187aa:

#   md "It sounds like he’s everything your mind and heart wants."
    md "Parece que ele é tudo o que sua mente e seu coração desejam."

# game/chapters/chapter5/script/ch5sc14.rpy:4022
translate brazil ch5sc14_2142ba6c:

#   md "If I were you, I’d give in, but keep it a secret."
    md "Se eu fosse você, cederia, mas manteria segredo."

# game/chapters/chapter5/script/ch5sc14.rpy:4024
translate brazil ch5sc14_545f85a6:

#   qm "It’s just not that easy for a queen."
    qm "Não é tão fácil assim para uma rainha."

# game/chapters/chapter5/script/ch5sc14.rpy:4025
translate brazil ch5sc14_908cf78a:

#   qm "There are too many eyes on me. And if it were discovered..."
