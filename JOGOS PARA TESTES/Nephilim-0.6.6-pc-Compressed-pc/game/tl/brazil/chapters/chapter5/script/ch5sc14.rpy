# game/chapters/chapter5/script/ch5sc14.rpy:905
translate brazil ch5sc14_84c3461e:

#   met "{i}I’ll do what the queen asks. But not for her benefit... Mmnm... but so that I can have him all to myself.{/i}"
    met "{i}Farei o que a rainha pedir. Mas não para o benefício dela... Hum... mas para que eu possa tê-lo só para mim.{/i}"

# game/chapters/chapter5/script/ch5sc14.rpy:917
