# game/chapters/chapter5/script/ch5sc14.rpy:1957
translate brazil ch5sc14_aa5c7a42:

#   bn "If they think I’m that naive... they have another thing coming."
    bn "Se eles pensam que sou tão ingênuo assim... estão muito enganados."

