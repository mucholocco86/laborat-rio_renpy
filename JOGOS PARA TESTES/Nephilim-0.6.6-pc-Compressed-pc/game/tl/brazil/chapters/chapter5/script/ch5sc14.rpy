# game/chapters/chapter5/script/ch5sc14.rpy:829
translate brazil ch5sc14_b0e3883d:

#   mc "Don’t worry, my ribs are still recovering from the hug you gave me earlier."
    mc "Não se preocupe, minhas costelas ainda estão se recuperando do abraço que você me deu mais cedo."

# game/chapters/chapter5/script/ch5sc14.rpy:831
translate brazil ch5sc14_5cbe7246:

#   al "They'd better recover fast, cause I’ve got plenty more where that came from! *Giggles*"
    al "É melhor eles se recuperarem logo, porque eu tenho muito mais de onde isso veio! *Risos*"

# game/chapters/chapter5/script/ch5sc14.rpy:833
translate brazil ch5sc14_f108ffa4:

