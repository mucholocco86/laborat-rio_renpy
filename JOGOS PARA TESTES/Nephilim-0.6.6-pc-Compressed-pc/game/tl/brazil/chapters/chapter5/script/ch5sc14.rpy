#   me "O-Okay... I’ll see what I can do, Your Grace."
    me "Certo... Vou ver o que posso fazer, Vossa Graça."

# game/chapters/chapter5/script/ch5sc14.rpy:893
translate brazil ch5sc14_e2e042ac:

#   qm "Thank you, Mei. I’m counting on you."
    qm "Obrigada, Mei. Estou contando com você."

# game/chapters/chapter5/script/ch5sc14.rpy:897
translate brazil ch5sc14_85cdd096:

#   met "{i}Is she jealous? Surely not. But she was so adamant about the maids ...{/i}"
    met "{i}Ela está com ciúmes? Certamente que não. Mas ela foi tão inflexível em relação às empregadas...{/i}"

