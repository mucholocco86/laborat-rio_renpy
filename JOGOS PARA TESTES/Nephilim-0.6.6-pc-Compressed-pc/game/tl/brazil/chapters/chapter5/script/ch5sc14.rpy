    mc "Já estou ansioso por isso."

# game/chapters/chapter5/script/ch5sc14.rpy:834
translate brazil ch5sc14_e3ad3646:

#   mc "Hey, listen... I’m heading over to the tavern to see Eliza and Borri."
    mc "Ei, escuta... Estou indo até a taverna para ver Eliza e Borri."

