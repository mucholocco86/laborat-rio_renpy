    ri "A cidade está infestada deles."

# game/chapters/chapter5/script/ch5sc14.rpy:2022
translate brazil ch5sc14_2827b029:

#   uk "I’m taking this one to the collections office. We could use the coin."
    uk "Vou levar esta para o escritório de cobranças. Precisamos da moeda."

# game/chapters/chapter5/script/ch5sc14.rpy:2023
translate brazil ch5sc14_d0dbbd94:

#   ri "Do as you wish."
    ri "Faça como quiser."

# game/chapters/chapter5/script/ch5sc14.rpy:2032
