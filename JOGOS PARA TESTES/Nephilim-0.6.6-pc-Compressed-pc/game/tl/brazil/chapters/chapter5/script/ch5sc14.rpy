#   bd "If we aren’t able to appease her, she'll lay waste to Looter’s Bay and everyone in it."
    bd "Se não conseguirmos apaziguá-la, ela destruirá a Baía dos Saqueadores e todos que lá habitam."

# game/chapters/chapter5/script/ch5sc14.rpy:936
translate brazil ch5sc14_1926a47b:

#   cr "Hnngh... who? ... who’s coming?"
    cr "Hnngh... quem? ... quem está vindo?"

# game/chapters/chapter5/script/ch5sc14.rpy:938
