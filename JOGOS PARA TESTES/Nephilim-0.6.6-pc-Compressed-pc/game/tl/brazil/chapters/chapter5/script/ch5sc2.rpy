translate brazil ch5sc2_27023dad:

#   mct "{i}If they experience too much emotional distress, they can just shut down and become mindless.{/i}"
    mct "{i}Se eles vivenciarem muito sofrimento emocional, podem simplesmente se desligar e ficar sem raciocínio.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:176
translate brazil ch5sc2_785ae3b6:

#   mc "Listen, I have an idea."
    mc "Escuta, tive uma ideia."

# game/chapters/chapter5/script/ch5sc2.rpy:177
translate brazil ch5sc2_bc4e0c43:

#   mc "It’s a long shot, but I need you to go stay with Sylph and Dalen, okay?"
    mc "É uma possibilidade remota, mas preciso que você vá ficar com Sylph e Dalen, ok?"

# game/chapters/chapter5/script/ch5sc2.rpy:179
translate brazil ch5sc2_df5f681b:

#   el "*Sobs* S-Sylph and Dalen? ... W-Why?"
    el "*Soluços* S-Sylph e Dalen? ... P-Por quê?"

# game/chapters/chapter5/script/ch5sc2.rpy:181
translate brazil ch5sc2_72ab9899:

#   mc "I'm going to try and contact Lucid."
    mc "Vou tentar entrar em contato com a Lucid."

# game/chapters/chapter5/script/ch5sc2.rpy:182
translate brazil ch5sc2_6bb23754:

#   mc "Sylph and Dalen will be able to watch over you."
    mc "Sylph e Dalen poderão cuidar de você."

# game/chapters/chapter5/script/ch5sc2.rpy:184
translate brazil ch5sc2_0e76e7bd:

#   el "*Sobs* O-Okay... W-Will you be long?"
    el "*Soluços* T-Tudo bem... V-Você vai demorar?"

# game/chapters/chapter5/script/ch5sc2.rpy:186
translate brazil ch5sc2_1abaffa8:

#   mc "I’m not sure."
    mc "Eu não tenho certeza."

# game/chapters/chapter5/script/ch5sc2.rpy:187
translate brazil ch5sc2_888736c4:

#   mc "Just promise me you'll stay with them until I return?"
    mc "Prometa-me que ficará com eles até eu voltar?"

# game/chapters/chapter5/script/ch5sc2.rpy:189
translate brazil ch5sc2_f4622f17:

#   el "Okay, I promise."
    el "Ok, eu prometo."

# game/chapters/chapter5/script/ch5sc2.rpy:191
translate brazil ch5sc2_87e26eb2:

#   mc "Good girl."
    mc "Boa menina."

# game/chapters/chapter5/script/ch5sc2.rpy:192
translate brazil ch5sc2_5aafe0a5:

#   mc "Let’s get dressed and I’ll take you there."
    mc "Vamos nos vestir e eu te levo lá."

# game/chapters/chapter5/script/ch5sc2.rpy:194
translate brazil ch5sc2_a2f3f9c4:

#   "You take Eliza to the guild and leave her in the care of Sylph and Dalen."
    "Você leva Eliza para a guilda e a deixa aos cuidados de Sylph e Dalen."

# game/chapters/chapter5/script/ch5sc2.rpy:196
translate brazil ch5sc2_dd6728f0:

#   mct "{i}*Sigh* Hopefully this works.{/i}"
    mct "{i}*Suspiro* Espero que isso funcione.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:198
translate brazil ch5sc2_f8573d6d:

#   mct "{i}Lucid? I need... I need your help.{/i}"
    mct "{i}Lúcido? Eu preciso... eu preciso da sua ajuda.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:200
translate brazil ch5sc2_18e2a053:

#   mct "{i}I’m at a loss and you’re the only one I can think of that can possibly help.{/i}"
    mct "{i}Estou sem saber o que fazer e você é a única pessoa em quem consigo pensar que talvez possa me ajudar.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:201
translate brazil ch5sc2_96781e79:

#   mct "{i}If you can hear me... please... answer me.{/i}"
    mct "{i}Se você puder me ouvir... por favor... responda-me.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:203
translate brazil ch5sc2_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter5/script/ch5sc2.rpy:204
translate brazil ch5sc2_ca389247:

#   mct "{i}*Sigh* What was I expecting?{/i}"
    mct "{i}*Suspiro* O que eu esperava?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:205
translate brazil ch5sc2_073b8f41:

#   mct "{i}It was worth a try. Maybe Dalen can come up with something?{/i}"
    mct "{i}Valeu a tentativa. Talvez o Dalen consiga bolar alguma coisa?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:207
translate brazil ch5sc2_673683a6:

#   mct "{i}Huh?{/i}"
    mct "{i}Huh?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:210
translate brazil ch5sc2_e9dafc80:

#   mct "{i}Somethings happening. She heard me?{/i}"
    mct "{i}Algo está acontecendo. Ela me ouviu?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:211
translate brazil ch5sc2_2ad0bbdc:

#   mct "{i}I feel... light? Weightless... Just like when I touched the Chalice of Vitality.{/i}"
    mct "{i}Eu me sinto... leve? Sem peso... Exatamente como quando toquei no Cálice da Vitalidade.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:219
translate brazil ch5sc2_1373ee8b:

#   mct "*Groans* Urrhh... I don’t think I’ll ever get used to this transportation magic."
    mct "*Geme* Urrhh... Acho que nunca vou me acostumar com essa mágica de transporte."

# game/chapters/chapter5/script/ch5sc2.rpy:221
translate brazil ch5sc2_adefe98a:

#   mct "This looks familiar..."
    mct "Isso me parece familiar..."

# game/chapters/chapter5/script/ch5sc2.rpy:223
translate brazil ch5sc2_d6286e64:

#   mct "It’s definitely her."
    mct "Com certeza é ela."

# game/chapters/chapter5/script/ch5sc2.rpy:224
translate brazil ch5sc2_2d56a052:

#   mct "Is this how she intends to greet me every time?"
    mct "É assim que ela pretende me cumprimentar todas as vezes?"

# game/chapters/chapter5/script/ch5sc2.rpy:226
translate brazil ch5sc2_aa2b4a69:

#   ld "Look who’s finally awake!"
    ld "Olha quem finalmente acordou!"

# game/chapters/chapter5/script/ch5sc2.rpy:227
translate brazil ch5sc2_c7e821fe:

#   ld "About time too! I was getting bored!"
    ld "Já era hora! Eu estava ficando entediado!"

# game/chapters/chapter5/script/ch5sc2.rpy:229
translate brazil ch5sc2_44d4e9a8:

#   mc "Lucid... How long was I out?"
    mc "Lúcido... Quanto tempo fiquei inconsciente?"

# game/chapters/chapter5/script/ch5sc2.rpy:231
translate brazil ch5sc2_919f6ee4:

#   ld "Two minutes! Tsk!"
    ld "Dois minutos! Tsc!"

# game/chapters/chapter5/script/ch5sc2.rpy:233
translate brazil ch5sc2_6944e923:

#   ld "It’s rude to keep a lady waiting, you know?"
    ld "É falta de educação deixar uma dama esperando, sabe?"

# game/chapters/chapter5/script/ch5sc2.rpy:235
translate brazil ch5sc2_2f8cc0d2:

#   mc "A lady? Is that what you are?"
    mc "Uma dama? É isso que você é?"

# game/chapters/chapter5/script/ch5sc2.rpy:236
translate brazil ch5sc2_f6feaa52:

#   ld "..."
    ld "..."

# game/chapters/chapter5/script/ch5sc2.rpy:237
translate brazil ch5sc2_dae7a84e:

#   mc "Do ladies always greet their visitors with that kind of attitude?"
    mc "Será que as mulheres sempre recebem seus visitantes com esse tipo de atitude?"

# game/chapters/chapter5/script/ch5sc2.rpy:239
translate brazil ch5sc2_37a44942:

#   ld "I believe I greeted you with a pleasant view..."
    ld "Creio que lhe ofereci uma vista agradável..."

# game/chapters/chapter5/script/ch5sc2.rpy:241
translate brazil ch5sc2_cb8c3271:

#   mct "That she did."
    mct "Sim, ela fez."

# game/chapters/chapter5/script/ch5sc2.rpy:242
translate brazil ch5sc2_fd8740b7:

#   mc "Sorry. You’re right, it was a pleasant greeting."
    mc "Desculpe. Você tem razão, foi uma saudação agradável."

# game/chapters/chapter5/script/ch5sc2.rpy:244
translate brazil ch5sc2_a14f5ec3:

#   ld "Glad you liked it! I expected you might!"
    ld "Que bom que você gostou! Eu já esperava que gostasse!"

# game/chapters/chapter5/script/ch5sc2.rpy:245
translate brazil ch5sc2_688e212a:

#   ld "Now, tell your au-... Ahem."
    ld "Agora, conte para o seu au-... Ahem."

# game/chapters/chapter5/script/ch5sc2.rpy:246
translate brazil ch5sc2_6d86a6e3:

#   ld "Tell me what can I do for you?"
    ld "Diga-me, o que posso fazer por você?"

# game/chapters/chapter5/script/ch5sc2.rpy:248
translate brazil ch5sc2_f7d798a1:

#   ld "*Sighs* I suspect the view wasn't why you called for my aid."
    ld "*Suspiro* Suspeito que a vista não foi o motivo pelo qual você pediu minha ajuda."

# game/chapters/chapter5/script/ch5sc2.rpy:250
translate brazil ch5sc2_ae23b832:

#   mc "No... Not quite."
    mc "Não... Não exatamente."

# game/chapters/chapter5/script/ch5sc2.rpy:251
translate brazil ch5sc2_566d630c:

#   mc "I need your help."
    mc "Eu preciso de sua ajuda."

# game/chapters/chapter5/script/ch5sc2.rpy:253
translate brazil ch5sc2_f2859f8b:

#   ld "My help?"
    ld "Minha ajuda?"

# game/chapters/chapter5/script/ch5sc2.rpy:255
translate brazil ch5sc2_1fb2f8f2:

#   ld "Come! Let’s go somewhere better suited for talking!"
    ld "Vamos! Vamos para um lugar mais propício para conversar!"

# game/chapters/chapter5/script/ch5sc2.rpy:256
translate brazil ch5sc2_515b25ed:

#   "With a snap of her fingers Lucid transports the two of you."
    "Com um estalar de dedos, Lucid transporta vocês dois."

# game/chapters/chapter5/script/ch5sc2.rpy:265
translate brazil ch5sc2_caf7db5e:

#   ld "Much better! Wouldn’t you agree?"
    ld "Muito melhor! Você não concorda?"

# game/chapters/chapter5/script/ch5sc2.rpy:267
translate brazil ch5sc2_14c1123d:

#   mc "Sure. Where are we, though?"
    mc "Claro. Mas onde estamos?"

# game/chapters/chapter5/script/ch5sc2.rpy:268
translate brazil ch5sc2_b51d2257:

#   mc "I assume we're still in your realm. The Inferno Isles, you called it?"
    mc "Presumo que ainda estejamos no seu reino. As Ilhas do Inferno, como você as chamou?"

# game/chapters/chapter5/script/ch5sc2.rpy:270
translate brazil ch5sc2_85f9ebae:

#   ld "Correct! My own little place in the cosmos."
    ld "Correto! Meu próprio cantinho no cosmos."

# game/chapters/chapter5/script/ch5sc2.rpy:271
translate brazil ch5sc2_0a6439fe:

#   ld "Do you like it?"
    ld "Você gosta disso?"

# game/chapters/chapter5/script/ch5sc2.rpy:273
translate brazil ch5sc2_c6cc7c3a:

#   mc "I haven’t spent enough time here to form an opinion."
    mc "Não passei tempo suficiente aqui para formar uma opinião."

# game/chapters/chapter5/script/ch5sc2.rpy:275
translate brazil ch5sc2_b22f696b:

#   ld "Mhph."
    ld "Mhph."

# game/chapters/chapter5/script/ch5sc2.rpy:277
translate brazil ch5sc2_9af3df31:

#   ld "We’ll just have to change that."
    ld "Teremos que mudar isso."

# game/chapters/chapter5/script/ch5sc2.rpy:278
translate brazil ch5sc2_876f3d54:

#   ld "I’ll take the blame since I practically kicked you out the door last time."
    ld "Eu assumo a culpa, já que praticamente te expulsei pela porta da última vez."

# game/chapters/chapter5/script/ch5sc2.rpy:280
translate brazil ch5sc2_0db8c9bc:

#   ld "But not today! Today there's no rush!"
    ld "Mas hoje não! Hoje não há pressa!"

# game/chapters/chapter5/script/ch5sc2.rpy:281
translate brazil ch5sc2_273dd055:

#   ld "You can stay here with me as long as you desire."
    ld "Você pode ficar aqui comigo o tempo que desejar."

# game/chapters/chapter5/script/ch5sc2.rpy:282
translate brazil ch5sc2_7cc3786f:

#   ld "We're long overdue for some quality time. Mhhm..."
    ld "Já faz tempo que precisamos de um tempo de qualidade juntos. Hum..."

# game/chapters/chapter5/script/ch5sc2.rpy:284
translate brazil ch5sc2_462b814d:

#   mc "I appreciate that."
    mc "Agradeço."

# game/chapters/chapter5/script/ch5sc2.rpy:285
translate brazil ch5sc2_91504794:

#   mc "But I'm facing a difficult situation..."
    mc "Mas estou enfrentando uma situação difícil..."

# game/chapters/chapter5/script/ch5sc2.rpy:288
translate brazil ch5sc2_0f6fcf98:

#   ld "Uh-oh. That face simply won’t do!"
    ld "Ih, rapaz! Essa cara não vai dar certo!"

# game/chapters/chapter5/script/ch5sc2.rpy:289
translate brazil ch5sc2_1b531124:

#   ld "As your au- Goddess! I will help you."
    ld "Como sua au- Deusa! Eu te ajudarei."

# game/chapters/chapter5/script/ch5sc2.rpy:291
translate brazil ch5sc2_ddaa41f5:

#   ld "What do you desire? A feast worthy of a king? The ability to fly as a dragon?"
    ld "O que você deseja? Um banquete digno de um rei? A capacidade de voar como um dragão?"

# game/chapters/chapter5/script/ch5sc2.rpy:292
translate brazil ch5sc2_665f6a61:

#   ld "Chests filled with jewels and gold? Eternal life?"
    ld "Baús repletos de joias e ouro? Vida eterna?"

# game/chapters/chapter5/script/ch5sc2.rpy:294
translate brazil ch5sc2_7d0c3de2:

#   ld "Seven virgins worshiping at your feet, ready to fulfill every desire you could imagine?"
    ld "Sete virgens se prostrando aos seus pés, prontas para realizar todos os desejos que você possa imaginar?"

# game/chapters/chapter5/script/ch5sc2.rpy:295
translate brazil ch5sc2_cb767a0c:

#   ld "Say the word, and I’ll make it so!"
    ld "Diga a palavra, e eu a realizarei!"

# game/chapters/chapter5/script/ch5sc2.rpy:297
translate brazil ch5sc2_b275547a:

#   mc "*Chuckles* Hah, thanks."
    mc "*Risos* Hah, obrigado."

# game/chapters/chapter5/script/ch5sc2.rpy:298
translate brazil ch5sc2_d64c9171:

#   mc "I might take you up on that sometime."
    mc "Talvez eu aceite sua oferta algum dia."

# game/chapters/chapter5/script/ch5sc2.rpy:300
translate brazil ch5sc2_4cea67a4:

#   ld "Mhm-Hm! Which one?"
    ld "Hum-hum! Qual deles?"

# game/chapters/chapter5/script/ch5sc2.rpy:302
translate brazil ch5sc2_021d5db1:

#   mc "Ahem, anyway..."
    mc "Bem, enfim..."

# game/chapters/chapter5/script/ch5sc2.rpy:304
translate brazil ch5sc2_898e00e4:

#   ld "Boooh!"
    ld "Vaia!"

# game/chapters/chapter5/script/ch5sc2.rpy:305
translate brazil ch5sc2_121fbc23:

#   ld "I’ll get it out of you another time."
    ld "Vou conseguir isso de você em outra ocasião."

# game/chapters/chapter5/script/ch5sc2.rpy:307
translate brazil ch5sc2_3468ab34:

#   ldt "He would've totally picked the seven virgins! Heh-heh-heh!"
    ldt "Ele com certeza teria escolhido as sete virgens! Heh-heh-heh!"

# game/chapters/chapter5/script/ch5sc2.rpy:309
translate brazil ch5sc2_2bbe71f3:

#   ld "Tell me, then."
    ld "Então me diga."

# game/chapters/chapter5/script/ch5sc2.rpy:310
translate brazil ch5sc2_b125d228:

#   ld "What's bothering you?"
    ld "O que está te incomodando?"

# game/chapters/chapter5/script/ch5sc2.rpy:312
translate brazil ch5sc2_0a392327:

#   mc "My friend... Eliza."
    mc "Minha amiga... Eliza."

# game/chapters/chapter5/script/ch5sc2.rpy:313
translate brazil ch5sc2_310c27b9:

#   mc "She's the one I wanted to help with your artifact."
    mc "Ela é a pessoa que eu queria para ajudar com o seu artefato."

# game/chapters/chapter5/script/ch5sc2.rpy:314
translate brazil ch5sc2_dcda888f:

#   mc "The transition... her emotions... it’s all overwhelming her."
    mc "A transição... as emoções dela... tudo isso a está sobrecarregando."

# game/chapters/chapter5/script/ch5sc2.rpy:316
translate brazil ch5sc2_3ac96e93:

#   mc "Whenever I think we're making strides towards her gaining control-"
    mc "Sempre que acho que estamos progredindo para que ela assuma o controle-"

# game/chapters/chapter5/script/ch5sc2.rpy:317
translate brazil ch5sc2_10e16c39:

#   mc "-Something happens, and her guilt comes washing over her like a tidal wave."
    mc "-Acontece algo, e a culpa a invade como uma onda gigante."

# game/chapters/chapter5/script/ch5sc2.rpy:319
translate brazil ch5sc2_356aeb89:

#   ld "Vampirism is not to be taken lightly."
    ld "O vampirismo não deve ser encarado levianamente."

# game/chapters/chapter5/script/ch5sc2.rpy:320
translate brazil ch5sc2_aa2fed14:

#   ld "I warned you last time we spoke."
    ld "Eu te avisei da última vez que conversamos."

# game/chapters/chapter5/script/ch5sc2.rpy:321
translate brazil ch5sc2_bc54dce2:

#   ld "Some individuals take to it quickly, they revel in their new found powers."
    ld "Algumas pessoas se adaptam rapidamente, elas se deleitam com seus poderes recém-descobertos."

# game/chapters/chapter5/script/ch5sc2.rpy:323
translate brazil ch5sc2_fb061cda:

#   ld "Others... they are too burdened by their emotions."
    ld "Outros... estão sobrecarregados demais por suas emoções."

# game/chapters/chapter5/script/ch5sc2.rpy:324
translate brazil ch5sc2_241effc0:

#   ld "Vampires are apex predators."
    ld "Os vampiros são predadores de topo."

# game/chapters/chapter5/script/ch5sc2.rpy:325
translate brazil ch5sc2_c573178a:

#   ld "And if a predator feels guilty about their own instincts... about their own survival..."
    ld "E se um predador se sente culpado pelos seus próprios instintos... pela sua própria sobrevivência..."

# game/chapters/chapter5/script/ch5sc2.rpy:327
translate brazil ch5sc2_4feda261:

#   ld "Well, I’m sure you can imagine what inner turmoil and stress that causes."
    ld "Bem, tenho certeza de que você consegue imaginar a turbulência interna e o estresse que isso causa."

# game/chapters/chapter5/script/ch5sc2.rpy:329
translate brazil ch5sc2_f3337617:

#   mc "Mhm..."
    mc "Hum..."

# game/chapters/chapter5/script/ch5sc2.rpy:330
translate brazil ch5sc2_b7da2a87:

#   mct "She's right, I've thought the same thing, Eliza shouldn't feel guilty about having to eat."
    mct "Ela tem razão, eu pensei a mesma coisa, Eliza não deveria se sentir culpada por ter que comer."

# game/chapters/chapter5/script/ch5sc2.rpy:331
translate brazil ch5sc2_8e819aa0:

#   mct "Eliza has such a pure heart, having to hurt others to stay alive is not aligning with who she is."
    mct "Eliza tem um coração tão puro que ter que ferir os outros para sobreviver não condiz com quem ela é."

# game/chapters/chapter5/script/ch5sc2.rpy:333
translate brazil ch5sc2_e4246964:

#   mc "So, that’s it then?"
    mc "Então é isso?"

# game/chapters/chapter5/script/ch5sc2.rpy:334
translate brazil ch5sc2_3a00a5e3:

#   mc "There’s nothing to be done? She’s condemned to this burden forever?"
    mc "Não há nada que se possa fazer? Ela está condenada a esse fardo para sempre?"

# game/chapters/chapter5/script/ch5sc2.rpy:335
translate brazil ch5sc2_69ce174e:

#   mc "I’m assuming you can’t just snap your fingers and undo it?"
    mc "Imagino que não seja possível simplesmente estalar os dedos e desfazer isso, certo?"

# game/chapters/chapter5/script/ch5sc2.rpy:337
translate brazil ch5sc2_98836d3c:

#   ld "Correct... I may be all-powerful, but as I warned you, vampirism is permanent."
    ld "Correto... Posso ser todo-poderoso, mas como avisei, o vampirismo é permanente."

# game/chapters/chapter5/script/ch5sc2.rpy:339
translate brazil ch5sc2_f88e9b7e:

#   ld "All my creations, they’re like... children to me. My children."
    ld "Todas as minhas criações são como... filhos para mim. Meus filhos."

# game/chapters/chapter5/script/ch5sc2.rpy:341
translate brazil ch5sc2_4d17f6a8:

#   ld "During the Abyss wars, some 3000 years ago... I lost so many of my children."
    ld "Durante as guerras do Abismo, há cerca de 3000 anos... perdi muitos dos meus filhos."

# game/chapters/chapter5/script/ch5sc2.rpy:342
translate brazil ch5sc2_1d7d1a36:

#   ld "Succubusses, Imps, Ashspawn, Dragons, Hellhounds, Eyes of the Inferno, and many others..."
    ld "Súcubos, Diabinhos, Filhos de Cinzas, Dragões, Cães Infernais, Olhos do Inferno e muitos outros..."

# game/chapters/chapter5/script/ch5sc2.rpy:344
translate brazil ch5sc2_8d69fca9:

#   ld "They were slaughtered by the thousands, by the Abyss lords."
    ld "Eles foram massacrados aos milhares pelos senhores do Abismo."

# game/chapters/chapter5/script/ch5sc2.rpy:345
translate brazil ch5sc2_f584c36f:

#   ld "And their foul minions."
    ld "E seus asseclas desprezíveis."

# game/chapters/chapter5/script/ch5sc2.rpy:346
translate brazil ch5sc2_71610db3:

#   ld "So I decided to create new children who wouldn’t die so easily... Vampires."
    ld "Então decidi criar novas crianças que não morreriam tão facilmente... Vampiros."

# game/chapters/chapter5/script/ch5sc2.rpy:348
translate brazil ch5sc2_f558284d:

#   ld "Then I'd never have to feel the pain of losing my children again."
    ld "Assim, eu nunca mais teria que sentir a dor de perder meus filhos."

# game/chapters/chapter5/script/ch5sc2.rpy:349
translate brazil ch5sc2_077e0404:

#   ld "And hopefully, the nightmares of hearing their agonized screams would fade."
    ld "E, com sorte, os pesadelos de ouvir seus gritos de agonia desapareceriam."

# game/chapters/chapter5/script/ch5sc2.rpy:351
translate brazil ch5sc2_625d8155:

#   mc "But vampires can still be killed, can't they?"
    mc "Mas os vampiros ainda podem ser mortos, não podem?"

# game/chapters/chapter5/script/ch5sc2.rpy:352
translate brazil ch5sc2_f3747335:

#   mc "Might be difficult, but you said it yourself last time."
    mc "Pode ser difícil, mas você mesmo disse isso da última vez."

# game/chapters/chapter5/script/ch5sc2.rpy:354
translate brazil ch5sc2_dbd7bf0d:

#   ld "My siblings... the other Divines."
    ld "Meus irmãos... os outros Divinos."

# game/chapters/chapter5/script/ch5sc2.rpy:355
translate brazil ch5sc2_5580ddd1:

#   ld "They willed it so..."
    ld "Eles assim o desejaram..."

# game/chapters/chapter5/script/ch5sc2.rpy:357
translate brazil ch5sc2_b1b1444d:

#   ld "*Mimics* ‘Lucid, you’re tampering with mortals, it’s forbidden’..."
    ld "*Imita* \"Lucid, você está mexendo com mortais, isso é proibido\"..."

# game/chapters/chapter5/script/ch5sc2.rpy:360
translate brazil ch5sc2_837eeea8:

#   ld "They didn’t even try to understand my pain!"
    ld "Eles nem sequer tentaram entender a minha dor!"

# game/chapters/chapter5/script/ch5sc2.rpy:361
translate brazil ch5sc2_4f17abf8:

#   ld "All they cared about were their precious rules... Tsk."
    ld "Eles só se importavam com suas preciosas regras... Tsc."

# game/chapters/chapter5/script/ch5sc2.rpy:363
translate brazil ch5sc2_3e3ff9a6:

#   mc "Hey... I’m sorry you had to endure that."
    mc "Ei... Sinto muito que você tenha tido que passar por isso."

# game/chapters/chapter5/script/ch5sc2.rpy:364
translate brazil ch5sc2_961ccc32:

#   mc "I understand the pain of losing family... It never goes away, not truly."
    mc "Compreendo a dor de perder um familiar... Ela nunca desaparece completamente."

# game/chapters/chapter5/script/ch5sc2.rpy:369
translate brazil ch5sc2_5a92dfb8:

#   mc "A mother will do anything to protect her children, it’s your instinct."
    mc "Uma mãe fará qualquer coisa para proteger seus filhos, é instinto."

# game/chapters/chapter5/script/ch5sc2.rpy:370
translate brazil ch5sc2_94c0330b:

#   mc "You just did what you thought would help them survive. I'd do the same."
    mc "Você simplesmente fez o que achou que os ajudaria a sobreviver. Eu faria o mesmo."

# game/chapters/chapter5/script/ch5sc2.rpy:371
translate brazil ch5sc2_c59b884f:

#   mc "In a way, I already did when I gave your artifact to Eliza. I chose for her to live forever."
    mc "De certa forma, eu já fiz isso quando dei seu artefato para Eliza. Eu escolhi que ela vivesse para sempre."

# game/chapters/chapter5/script/ch5sc2.rpy:372
translate brazil ch5sc2_751d3d61:

#   mc "I didn't want to endure a world without her."
    mc "Eu não queria suportar um mundo sem ela."

# game/chapters/chapter5/script/ch5sc2.rpy:374
translate brazil ch5sc2_76d0b654:

#   ld "[mc]... I... Thank you."
    ld "[mc]... Eu... Obrigado."

# game/chapters/chapter5/script/ch5sc2.rpy:375
translate brazil ch5sc2_cdbb01e1:

#   ld "You’re kind... And warm."
    ld "Você é gentil... e carinhoso(a)."

# game/chapters/chapter5/script/ch5sc2.rpy:377
translate brazil ch5sc2_985cf5af:

#   "Lucid is genuinely surprised at how kind you are to her, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Lucid está genuinamente surpresa com a sua gentileza, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc2.rpy:381
translate brazil ch5sc2_a8e50274:

#   mc "You’re one of the mightiest beings in the cosmos: one of the seven divines."
    mc "Você é um dos seres mais poderosos do cosmos: um dos sete divinos."

# game/chapters/chapter5/script/ch5sc2.rpy:382
translate brazil ch5sc2_2de4cd1a:

#   mc "So suck it up. Sitting here moping about it won’t bring them back. Nothing will."
    mc "Então, aceite a situação. Ficar aí se lamentando não vai trazê-los de volta. Nada vai."

# game/chapters/chapter5/script/ch5sc2.rpy:383
translate brazil ch5sc2_65ccc1b4:

#   mc "I had to learn that the hard way myself... and I was just a kid."
    mc "Tive que aprender isso da maneira mais difícil... e eu era apenas uma criança."

# game/chapters/chapter5/script/ch5sc2.rpy:385
translate brazil ch5sc2_0c4ea56c:

#   ld "*Sighs heavily* You’re right..."
    ld "*Suspira profundamente* Você tem razão..."

# game/chapters/chapter5/script/ch5sc2.rpy:388
translate brazil ch5sc2_c69aeb05:

#   "You comfort her a little while until she manages to gather herself."
    "Você a consola por um tempo até que ela consiga se recompor."

# game/chapters/chapter5/script/ch5sc2.rpy:390
translate brazil ch5sc2_7db33b4a:

#   ld "Okay! I think I know something we can do for your Eliza."
    ld "Certo! Acho que sei algo que podemos fazer pela sua Eliza."

# game/chapters/chapter5/script/ch5sc2.rpy:391
translate brazil ch5sc2_872b7fad:

#   ld "Keep in mind, this is just an idea. I have no notion whether it will work or not."
    ld "Lembre-se, isso é apenas uma ideia. Não tenho ideia se vai funcionar ou não."

# game/chapters/chapter5/script/ch5sc2.rpy:393
translate brazil ch5sc2_53537b88:

#   mc "I’ll do it. Whatever it is."
    mc "Eu farei isso. Seja o que for."

# game/chapters/chapter5/script/ch5sc2.rpy:395
translate brazil ch5sc2_90411a69:

#   ld "Nothing like this has been attempted before... But, you’re not exactly ordinary."
    ld "Nada parecido com isto foi tentado antes... Mas você não é exatamente uma pessoa comum."

# game/chapters/chapter5/script/ch5sc2.rpy:396
translate brazil ch5sc2_dfe621e4:

#   ld "You may just be able to do it... if you get some guidance."
    ld "Você pode até conseguir... se receber alguma orientação."

# game/chapters/chapter5/script/ch5sc2.rpy:398
translate brazil ch5sc2_51c77ca9:

#   mc "For some reason, I trust you completely."
    mc "Por algum motivo, confio plenamente em você."

# game/chapters/chapter5/script/ch5sc2.rpy:399
translate brazil ch5sc2_ed0de28e:

#   mc "I'll accept your guidance."
    mc "Aceitarei sua orientação."

# game/chapters/chapter5/script/ch5sc2.rpy:401
translate brazil ch5sc2_c2bbf7e6:

#   ld "It’s simple!"
    ld "É simples!"

# game/chapters/chapter5/script/ch5sc2.rpy:402
translate brazil ch5sc2_fcfdf2e2:

#   ld "You trust me because we’re fam-"
    ld "Você confia em mim porque somos família."

# game/chapters/chapter5/script/ch5sc2.rpy:404
translate brazil ch5sc2_dd729c65:

#   "She stops herself mid-sentence."
    "Ela se interrompe no meio da frase."

# game/chapters/chapter5/script/ch5sc2.rpy:407
translate brazil ch5sc2_d45240d3:

#   ld "Because I’m your goddess."
    ld "Porque eu sou a sua deusa."

# game/chapters/chapter5/script/ch5sc2.rpy:408
translate brazil ch5sc2_0fab4fd9:

#   ld "A-Anyway... I’m not the one who'll be guiding you."
    ld "Enfim... não serei eu quem irá guiá-los."

# game/chapters/chapter5/script/ch5sc2.rpy:410
translate brazil ch5sc2_8fb8ed6b:

#   mc "You’re not? Then who?"
    mc "Você não é? Então quem é?"

# game/chapters/chapter5/script/ch5sc2.rpy:412
translate brazil ch5sc2_77de608f:

#   ld "Maia."
    ld "Maia."

# game/chapters/chapter5/script/ch5sc2.rpy:413
translate brazil ch5sc2_618d0b0b:

#   ld "She's the only one who would be qualified for what I have in mind."
    ld "Ela é a única pessoa qualificada para o que eu tenho em mente."

# game/chapters/chapter5/script/ch5sc2.rpy:415
translate brazil ch5sc2_081e2604:

#   mc "Maia?"
    mc "Maia?"

# game/chapters/chapter5/script/ch5sc2.rpy:417
translate brazil ch5sc2_e2822281:

#   ld "You don’t know about her?"
    ld "Você não sabe nada sobre ela?"

# game/chapters/chapter5/script/ch5sc2.rpy:418
translate brazil ch5sc2_11a711c4:

#   ld "She’s usually quite popular amongst mortals."
    ld "Ela costuma ser bastante popular entre os mortais."

# game/chapters/chapter5/script/ch5sc2.rpy:420
translate brazil ch5sc2_6d0b2999:

#   mc "Never heard of her."
    mc "Nunca ouvi falar dela."

# game/chapters/chapter5/script/ch5sc2.rpy:421
translate brazil ch5sc2_bfd7b2fb:

#   mc "Is she one of the divines?"
    mc "Ela é uma das divindades?"

# game/chapters/chapter5/script/ch5sc2.rpy:424
translate brazil ch5sc2_69c8b32e:

#   ld "Marvelous! *Snickers* Simply brilliant!"
    ld "Maravilhoso! *Risos* Simplesmente genial!"

# game/chapters/chapter5/script/ch5sc2.rpy:426
translate brazil ch5sc2_4f26f895:

#   ld "That was glorious! No, she isn’t one of the divines."
    ld "Foi maravilhoso! Não, ela não é uma das divindades."

# game/chapters/chapter5/script/ch5sc2.rpy:427
translate brazil ch5sc2_4a1ecd33:

#   ld "Maia, Maiden of Purity. She’s a Celestial."
    ld "Maia, Donzela da Pureza. Ela é uma Celestial."

# game/chapters/chapter5/script/ch5sc2.rpy:429
translate brazil ch5sc2_72d9a1ca:

#   mc "Celestial?"
    mc "Celestial?"

# game/chapters/chapter5/script/ch5sc2.rpy:431
translate brazil ch5sc2_ee8f7499:

#   ld "By the inferno!"
    ld "Pelo inferno!"

# game/chapters/chapter5/script/ch5sc2.rpy:432
translate brazil ch5sc2_86f86717:

#   ld "You really don’t know your deities do you?"
    ld "Você realmente não conhece suas divindades, não é?"

# game/chapters/chapter5/script/ch5sc2.rpy:434
translate brazil ch5sc2_6b48cb72:

#   ld "I suppose I can give you a quick rundown of the hierarchy of gods."
    ld "Acho que posso te dar um breve resumo da hierarquia dos deuses."

# game/chapters/chapter5/script/ch5sc2.rpy:435
translate brazil ch5sc2_4530b9f0:

#   ld "You really should know, given who you are..."
    ld "Você realmente deveria saber, considerando quem você é..."

# game/chapters/chapter5/script/ch5sc2.rpy:437
translate brazil ch5sc2_9db800b1:

#   mc "Thank you. I haven’t exactly studied at the academy or anything."
    mc "Obrigado. Eu não estudei exatamente na academia nem nada do tipo."

# game/chapters/chapter5/script/ch5sc2.rpy:438
translate brazil ch5sc2_92b3a976:

#   mc "Been on the road most of my life and fighting for survival. Didn’t leave much time for studying deities."
    mc "Passei a maior parte da minha vida na estrada, lutando pela sobrevivência. Não me sobrou muito tempo para estudar divindades."

# game/chapters/chapter5/script/ch5sc2.rpy:440
translate brazil ch5sc2_dea6f9b4:

#   ld "Yet, here you are, sitting with one."
    ld "E, no entanto, aqui está você, sentado com um deles."

# game/chapters/chapter5/script/ch5sc2.rpy:441
translate brazil ch5sc2_fb34972f:

#   ld "Okay, listen carefully!"
    ld "Certo, escute com atenção!"

# game/chapters/chapter5/script/ch5sc2.rpy:443
translate brazil ch5sc2_1376b385:

#   ld "Hmh... I suppose I’ll start from the top!"
    ld "Hum... Acho que vou começar do início!"

# game/chapters/chapter5/script/ch5sc2.rpy:444
translate brazil ch5sc2_93dc7336:

#   ld "With my siblings and I."
    ld "Eu e meus irmãos."

# game/chapters/chapter5/script/ch5sc2.rpy:447
translate brazil ch5sc2_60d2b1d4:

#   ld "I’ll start with Azir. Mortals often worship him to gain his favor in endeavors concerning wealth."
    ld "Vou começar com Azir. Os mortais frequentemente o veneram para obter seu favor em empreendimentos relacionados à riqueza."

# game/chapters/chapter5/script/ch5sc2.rpy:448
translate brazil ch5sc2_0badf55a:

#   ld "Accordingly, they often refer to him as ‘The Golden One’."
    ld "Por isso, muitas vezes se referem a ele como 'O Dourado'."

# game/chapters/chapter5/script/ch5sc2.rpy:449
translate brazil ch5sc2_dac449ec:

#   ld "He rules over the realm known as 'The Shimmering Sands'."
    ld "Ele governa o reino conhecido como 'As Areias Cintilantes'."

# game/chapters/chapter5/script/ch5sc2.rpy:450
translate brazil ch5sc2_9792060a:

#   ld "It's a vast desert realm, filled with riches hidden beneath its sandy dunes."
    ld "É um vasto reino desértico, repleto de riquezas escondidas sob suas dunas de areia."

# game/chapters/chapter5/script/ch5sc2.rpy:451
translate brazil ch5sc2_ea2b8ca1:

#   mc "Sounds fancy."
    mc "Parece sofisticado."

# game/chapters/chapter5/script/ch5sc2.rpy:452
translate brazil ch5sc2_1c8a4237:

#   ld "Meh! It’s overrated, if you ask me. Besides... what does he even need all that wealth for?"
    ld "Meh! É superestimado, na minha opinião. Além disso... para que ele precisa de toda essa riqueza?"

# game/chapters/chapter5/script/ch5sc2.rpy:454
translate brazil ch5sc2_9bd46873:

#   ld "Okay, let’s move on to Malpheon."
    ld "Certo, vamos passar para Malpheon."

# game/chapters/chapter5/script/ch5sc2.rpy:455
translate brazil ch5sc2_3055b70a:

#   ld "He’s a bit of a grump. He is known as the ‘Guardian of the Deep’"
    ld "Ele é um pouco rabugento. É conhecido como o 'Guardião das Profundezas'."

# game/chapters/chapter5/script/ch5sc2.rpy:456
translate brazil ch5sc2_c85943ae:

#   ld "The realm where he lives is called ‘The Caverns of Life’. It's a vast network of caverns interconnected with thousands of passageways."
    ld "O reino onde ele vive se chama \"As Cavernas da Vida\". É uma vasta rede de cavernas interligadas por milhares de passagens."

# game/chapters/chapter5/script/ch5sc2.rpy:457
translate brazil ch5sc2_91b76d8f:

#   ld "It's said that the crystals from his realm contain potent magical properties."
    ld "Diz-se que os cristais de seu reino contêm poderosas propriedades mágicas."

# game/chapters/chapter5/script/ch5sc2.rpy:458
translate brazil ch5sc2_cdad3408:

#   ld "Dwarves and stonemasons revere him greatly. They hope to gain his favor through digging for gems or building structures."
    ld "Anões e pedreiros o reverenciam muito. Eles esperam ganhar seu favor extraindo pedras preciosas ou construindo estruturas."

# game/chapters/chapter5/script/ch5sc2.rpy:459
translate brazil ch5sc2_a04273ad:

#   mc "Heh... Borri and Gibson would love this guy."
    mc "Heh... Borri e Gibson adorariam esse cara."

# game/chapters/chapter5/script/ch5sc2.rpy:460
translate brazil ch5sc2_456b6252:

#   ld "Who? Anyway... Let’s move on."
    ld "Quem? Enfim... Vamos em frente."

# game/chapters/chapter5/script/ch5sc2.rpy:462
translate brazil ch5sc2_41882aa1:

#   ld "Next we have-... Yours truly!"
    ld "Em seguida, temos... Atenciosamente, eu!"

# game/chapters/chapter5/script/ch5sc2.rpy:463
translate brazil ch5sc2_b9c17c77:

#   ld "Cute as a button! Right?"
    ld "Uma gracinha! Não é?"

# game/chapters/chapter5/script/ch5sc2.rpy:464
translate brazil ch5sc2_c951392b:

#   mc "Definitely."
    mc "Definitivamente."

# game/chapters/chapter5/script/ch5sc2.rpy:465
translate brazil ch5sc2_801c5375:

#   ld "Heh-Hehh-Heheh!"
    ld "Heh-Hehh-Heheh!"

# game/chapters/chapter5/script/ch5sc2.rpy:466
translate brazil ch5sc2_d400bf75:

#   ld "As you know, we're here in my realm called ‘The Inferno Isles’, where I live."
    ld "Como você sabe, estamos aqui no meu reino chamado 'As Ilhas do Inferno', onde eu moro."

# game/chapters/chapter5/script/ch5sc2.rpy:467
translate brazil ch5sc2_db7de9c8:

#   ld "And the title I'm often given is ‘Mother of the Damned’ Tsk! Mortals have no taste."
    ld "E o título que costumo receber é 'Mãe dos Condenados'. Tsc! Os mortais não têm bom gosto."

# game/chapters/chapter5/script/ch5sc2.rpy:468
translate brazil ch5sc2_5888191c:

#   ld "Somehow, they find my children frightening. But I don’t see it! I think they’re cute."
    ld "De alguma forma, eles acham meus filhos assustadores. Mas eu não vejo isso! Acho-os fofos."

# game/chapters/chapter5/script/ch5sc2.rpy:469
translate brazil ch5sc2_abff9091:

#   ld "Vampires... Dragons... Hellhounds... Ashspawns... Imps... Succubuses... and many more!"
    ld "Vampiros... Dragões... Cães Infernais... Criaturas das Cinzas... Diabinhos... Súcubos... e muitos mais!"

# game/chapters/chapter5/script/ch5sc2.rpy:470
translate brazil ch5sc2_5d5d0722:

#   ld "Tell me those aren’t cute and cuddly?"
    ld "Diga-me se eles não são fofos e adoráveis?"

# game/chapters/chapter5/script/ch5sc2.rpy:471
translate brazil ch5sc2_bfda8ca3:

#   mc "Uhm... sure?"
    mc "Hum... claro?"

# game/chapters/chapter5/script/ch5sc2.rpy:472
translate brazil ch5sc2_c360ac49:

#   ld "I knew you'd see it my way!"
    ld "Eu sabia que você concordaria comigo!"

# game/chapters/chapter5/script/ch5sc2.rpy:473
translate brazil ch5sc2_d74cb695:

#   ld "Okay, let’s move on again."
    ld "Ok, vamos prosseguir."

# game/chapters/chapter5/script/ch5sc2.rpy:475
translate brazil ch5sc2_f9fb1ee5:

#   ld "Up next is Raze, ‘Lord of Chaos’. Ugh! He's the black sheep of the family."
    ld "O próximo é Raze, o \"Senhor do Caos\". Credo! Ele é a ovelha negra da família."

# game/chapters/chapter5/script/ch5sc2.rpy:476
translate brazil ch5sc2_04d8c771:

#   ld "I might be a little mischievous at times, but he revels in chaos and trickery!"
    ld "Às vezes posso ser um pouco travessa, mas ele se deleita no caos e nas artimanhas!"

# game/chapters/chapter5/script/ch5sc2.rpy:477
translate brazil ch5sc2_b3ba22d2:

#   ld "He can be so annoying to deal with."
    ld "Ele pode ser muito irritante."

# game/chapters/chapter5/script/ch5sc2.rpy:478
translate brazil ch5sc2_b304e391:

#   ld "Anyway, he lives in ‘The Sunless Realms’. His realm was so dark after its creation that he..."
    ld "Enfim, ele vive nos 'Reinos Sem Sol'. Seu reino era tão sombrio após sua criação que ele..."

# game/chapters/chapter5/script/ch5sc2.rpy:479
translate brazil ch5sc2_13306c54:

#   ld "Created his own sun. It's known as the ‘Chaos star’. Mortals who worship him usually get what they ask for."
    ld "Criou seu próprio sol. É conhecido como a 'Estrela do Caos'. Os mortais que o veneram geralmente conseguem o que pedem."

# game/chapters/chapter5/script/ch5sc2.rpy:480
translate brazil ch5sc2_e6ca7b7e:

#   ld "But often not in the way they'd imagined it. He likes to trick his subjects for his own amusemen..."
    ld "Mas muitas vezes não da maneira que eles imaginavam. Ele gosta de enganar seus súditos para seu próprio divertimento..."

# game/chapters/chapter5/script/ch5sc2.rpy:481
translate brazil ch5sc2_5b3283f5:

#   mc "Sounds like a charmer."
    mc "Parece encantador."

# game/chapters/chapter5/script/ch5sc2.rpy:482
translate brazil ch5sc2_662f20e2:

#   ld "If he tries to trick you, let me know. I’ll happily incinerate him!"
    ld "Se ele tentar te enganar, me avise. Eu o incinerarei com prazer!"

# game/chapters/chapter5/script/ch5sc2.rpy:484
translate brazil ch5sc2_f3da639f:

#   ld "Up next, we have Kinesis, ‘The Eternal’."
    ld "A seguir, temos Kinesis, 'O Eterno'."

# game/chapters/chapter5/script/ch5sc2.rpy:485
translate brazil ch5sc2_40d06479:

#   ld "He rules over a realm known as ‘The Beyond’. It's a vast cosmic realm that constantly moves through space."
    ld "Ele governa um reino conhecido como 'O Além'. É um vasto reino cósmico que se move constantemente pelo espaço."

# game/chapters/chapter5/script/ch5sc2.rpy:486
translate brazil ch5sc2_0d549271:

#   ld "His followers believe that all magic has its roots in 'The Beyond' and, by extension, Kinesis himself."
    ld "Seus seguidores acreditam que toda magia tem suas raízes no 'Além' e, por extensão, no próprio Kinesis."

# game/chapters/chapter5/script/ch5sc2.rpy:487
translate brazil ch5sc2_6bd50f5b:

#   mc "Is it true?"
    mc "É verdade?"

# game/chapters/chapter5/script/ch5sc2.rpy:488
translate brazil ch5sc2_83ded8cb:

#   ld "No. It’s true that his realm is potent in magic and many mortals are able to draw power from it."
    ld "Não. É verdade que seu reino é poderoso em magia e muitos mortais são capazes de extrair poder dele."

# game/chapters/chapter5/script/ch5sc2.rpy:489
translate brazil ch5sc2_b973b666:

#   ld "But there’s magic in all the realms, and it takes many different forms."
    ld "Mas existe magia em todos os reinos, e ela assume muitas formas diferentes."

# game/chapters/chapter5/script/ch5sc2.rpy:490
translate brazil ch5sc2_d022626f:

#   ld "You can probably guess that his followers and worshippers are those who seek advancement in magic."
    ld "Você provavelmente já deve imaginar que seus seguidores e adoradores são aqueles que buscam avanços na magia."

# game/chapters/chapter5/script/ch5sc2.rpy:491
translate brazil ch5sc2_e4b74793:

#   ld "He totally has a magical stick up his bum, though! He's way too serious for my liking!"
    ld "Ele com certeza tem uma varinha mágica enfiada no traseiro! Ele é sério demais para o meu gosto!"

# game/chapters/chapter5/script/ch5sc2.rpy:493
translate brazil ch5sc2_74adfb61:

#   ld "Not once in our 6.000 years has he laughed at my jokes! {b}NOT ONCE!{/b}"
    ld "Em nossos 6.000 anos de história, ele nunca riu das minhas piadas! {b} NEM UMA VEZ!{/b}"

# game/chapters/chapter5/script/ch5sc2.rpy:494
translate brazil ch5sc2_66a5117a:

#   mc "*Chuckles*"
    mc "*Risos*"

# game/chapters/chapter5/script/ch5sc2.rpy:495
translate brazil ch5sc2_baa0aac2:

#   ld "That’s not funny! That's literally since the creation of Midomir itself..."
    ld "Isso não tem graça! Isso acontece literalmente desde a criação do próprio Midomir..."

# game/chapters/chapter5/script/ch5sc2.rpy:496
translate brazil ch5sc2_7043175a:

#   ld "Okay, next..."
    ld "Ok, próximo..."

# game/chapters/chapter5/script/ch5sc2.rpy:498
translate brazil ch5sc2_7a003ea4:

#   ld "My dear sister! Andromeda, ‘Mistress of the Moon’, ‘Sister of the stars’, ‘The Arcane Queen’."
    ld "Minha querida irmã! Andrômeda, 'Senhora da Lua', 'Irmã das Estrelas', 'A Rainha Arcana'."

# game/chapters/chapter5/script/ch5sc2.rpy:499
translate brazil ch5sc2_50d50ea3:

#   ld "Those are just a few of the countless titles her worshippers bestow upon her."
    ld "Esses são apenas alguns dos inúmeros títulos que seus adoradores lhe conferem."

# game/chapters/chapter5/script/ch5sc2.rpy:500
translate brazil ch5sc2_10a34feb:

#   ld "She resides in a realm of cosmic wonder known as Arcanium."
    ld "Ela reside em um reino de maravilhas cósmicas conhecido como Arcanium."

# game/chapters/chapter5/script/ch5sc2.rpy:501
translate brazil ch5sc2_0e0c2b7a:

#   ld "Arcanium is filled with glinting stars, brightly-colored nether-clouds, eternal night, and arcane energy."
    ld "Arcanium está repleto de estrelas cintilantes, nuvens etéreas de cores vivas, noite eterna e energia arcana."

# game/chapters/chapter5/script/ch5sc2.rpy:502
translate brazil ch5sc2_0c26a793:

#   ld "Like Kinesis, she's also a matron to sorceresses, mages and wizards alike."
    ld "Assim como Kinesis, ela também é uma espécie de matriarca para feiticeiras, magos e bruxos."

# game/chapters/chapter5/script/ch5sc2.rpy:503
translate brazil ch5sc2_9ab2a90e:

#   ld "Usually her followers dabble in arcane mysteries or seek cosmic knowledge."
    ld "Geralmente, seus seguidores se dedicam a mistérios arcanos ou buscam conhecimento cósmico."

# game/chapters/chapter5/script/ch5sc2.rpy:504
translate brazil ch5sc2_5f57083e:

#   ld "And she is my favorite sibling! Kind and understanding, she always has my back when Raze gets annoying."
    ld "E ela é minha irmã favorita! Gentil e compreensiva, ela sempre me apoia quando a Raze fica irritante."

# game/chapters/chapter5/script/ch5sc2.rpy:505
translate brazil ch5sc2_14fa6737:

#   ld "*Snickering* One time, she bound him within a star and kept him there for a century!"
    ld "*Risinhos* Certa vez, ela o aprisionou dentro de uma estrela e o manteve lá por um século!"

# game/chapters/chapter5/script/ch5sc2.rpy:506
translate brazil ch5sc2_af03ba1a:

#   ld "All because he was being mean to me."
    ld "Tudo porque ele estava sendo malvado comigo."

# game/chapters/chapter5/script/ch5sc2.rpy:507
translate brazil ch5sc2_1797ce50:

#   mc "A century? ... Remind me not to get on her bad side."
    mc "Um século? ... Lembre-me de não ficar em maus lençóis com ela."

# game/chapters/chapter5/script/ch5sc2.rpy:508
translate brazil ch5sc2_f1388086:

#   ld "Fear not, she doesn’t have one. Only a protective side!"
    ld "Não se preocupe, ela não tem um lado protetor. Apenas um lado protetor!"

# game/chapters/chapter5/script/ch5sc2.rpy:509
translate brazil ch5sc2_a146be15:

#   ld "And with that, you now know a little about ‘{b}The Pantheon of the Divines{/b}’."
    ld "E com isso, agora você sabe um pouco sobre '{b}O Panteão dos Divinos{/b}'."

# game/chapters/chapter5/script/ch5sc2.rpy:510
translate brazil ch5sc2_331cdbb7:

#   mc "That was only six, though? Aren’t there supposed to be seven of you?"
    mc "Mas eram só seis? Não deveriam ser sete?"

# game/chapters/chapter5/script/ch5sc2.rpy:513
translate brazil ch5sc2_5c18539d:

#   mc "Who's the seventh?"
    mc "Quem é o sétimo?"

# game/chapters/chapter5/script/ch5sc2.rpy:515
translate brazil ch5sc2_3a303d31:

#   ld "I can’t... It’s not for me to tell."
    ld "Não posso... Não cabe a mim dizer."

# game/chapters/chapter5/script/ch5sc2.rpy:517
translate brazil ch5sc2_06a2822e:

#   mc "Huh... Well, it’s okay. I'll find out some other time."
    mc "Hum... Bem, tudo bem. Descobrirei em outra ocasião."

# game/chapters/chapter5/script/ch5sc2.rpy:519
translate brazil ch5sc2_6a7ff2c0:

#   ld "Yeah, he doesn’t want you to know just yet..."
    ld "É, ele não quer que você saiba ainda..."

# game/chapters/chapter5/script/ch5sc2.rpy:520
translate brazil ch5sc2_09acc671:

#   ld "Even me talking to you like this... will be frowned upon."
    ld "Até mesmo eu falando com você desse jeito... será malvisto."

# game/chapters/chapter5/script/ch5sc2.rpy:522
translate brazil ch5sc2_811f1a62:

#   mc "Frowned upon? Why wouldn’t you be allowed to talk to me? Aren’t you an almighty divine?"
    mc "Desprezado? Por que você não teria permissão para falar comigo? Você não é uma divindade onipotente?"

# game/chapters/chapter5/script/ch5sc2.rpy:525
translate brazil ch5sc2_039e30fd:

#   ld "Yes... but there are rules."
    ld "Sim... mas existem regras."

# game/chapters/chapter5/script/ch5sc2.rpy:526
translate brazil ch5sc2_bdc9ae5d:

#   ld "He... he doesn’t think you are ready yet."
    ld "Ele... ele acha que você ainda não está pronto."

# game/chapters/chapter5/script/ch5sc2.rpy:528
translate brazil ch5sc2_aa932f9c:

#   mct "{i}Now she’s got me curious. Who in the five hells is ‘he’? And why is she obeying him?{/i}"
    mct "{i}Agora ela me deixou curioso. Quem diabos é \"ele\"? E por que ela está obedecendo a ele?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:529
translate brazil ch5sc2_a456f59a:

#   mct "{i}Aren’t they siblings?{/i}"
    mct "{i}Eles não são irmãos?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:531
translate brazil ch5sc2_7a016fde:

#   ld "Sorry... I’ve tried to tell him you should be included. But no luck."
    ld "Desculpe... tentei dizer a ele que você deveria ser incluído, mas não tive sorte."

# game/chapters/chapter5/script/ch5sc2.rpy:532
translate brazil ch5sc2_c7135096:

#   ld "You’re not mad at me, right?"
    ld "Você não está bravo comigo, está?"

# game/chapters/chapter5/script/ch5sc2.rpy:534
translate brazil ch5sc2_c938b1b3:

#   mc "No, I’m not mad. I’m definitely both curious and disappointed about all the secrecy..."
    mc "Não, não estou zangado. Estou definitivamente curioso e desapontado com todo esse segredo..."

# game/chapters/chapter5/script/ch5sc2.rpy:535
translate brazil ch5sc2_8b049d10:

#   mc "But I don’t hold it against you. You’ve always been welcoming towards me."
    mc "Mas não guardo rancor. Você sempre me acolheu bem."

# game/chapters/chapter5/script/ch5sc2.rpy:537
translate brazil ch5sc2_5cfb8400:

#   ld "Of course!"
    ld "Claro!"

# game/chapters/chapter5/script/ch5sc2.rpy:538
translate brazil ch5sc2_315cc280:

#   ld "We’re fam- friends! We’re friends!"
    ld "Somos fam-amigos! Somos amigos!"

# game/chapters/chapter5/script/ch5sc2.rpy:540
translate brazil ch5sc2_a28f7709:

#   ld "I’m afraid that’s all the deity lessons we have time for today."
    ld "Receio que essas sejam todas as lições sobre divindades para as quais temos tempo hoje."

# game/chapters/chapter5/script/ch5sc2.rpy:541
translate brazil ch5sc2_9fd018b2:

#   ld "Next time, we’ll look further down the hierarchy."
    ld "Na próxima vez, vamos analisar mais a fundo a hierarquia."

# game/chapters/chapter5/script/ch5sc2.rpy:542
translate brazil ch5sc2_cf413c34:

#   ld "For now, I’ll send you to Maia so that you can help your friend."
    ld "Por agora, vou te enviar para Maia para que você possa ajudar seu amigo."

# game/chapters/chapter5/script/ch5sc2.rpy:544
translate brazil ch5sc2_0bdc39f5:

#   ld "*Mwaahh*"
    ld "*Mwaahh*"

# game/chapters/chapter5/script/ch5sc2.rpy:545
translate brazil ch5sc2_8ee94363:

#   "Lucid’s warm, rosy lips rest on your forehead as you slowly doze off..."
    "Os lábios quentes e rosados ​​de Lucid repousam em sua testa enquanto você adormece lentamente..."

# game/chapters/chapter5/script/ch5sc2.rpy:552
translate brazil ch5sc2_a9f18e04:

#   "When you awaken you find yourself in a new location."
    "Ao acordar, você se encontra em um novo local."

# game/chapters/chapter5/script/ch5sc2.rpy:553
translate brazil ch5sc2_e4cb58ad:

#   mct "{i}Ugrh... I’ll never get used to that. Where am I now?{/i}"
    mct "{i}Argh... Nunca vou me acostumar com isso. Onde estou agora?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:557
translate brazil ch5sc2_7465c1ed:

#   mct "{i}Huh, someone's here? Must be her, Maia.{/i}"
    mct "{i}Hum, tem alguém aqui? Deve ser ela, Maia.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:563
translate brazil ch5sc2_caa50125:

#   mct "It’s her."
    mct "É ela."

# game/chapters/chapter5/script/ch5sc2.rpy:564
translate brazil ch5sc2_c3e5d614:

#   mct "She’s the one Lucid wanted me to speak with."
    mct "Ela é a pessoa com quem a Lucid queria que eu falasse."

# game/chapters/chapter5/script/ch5sc2.rpy:572
translate brazil ch5sc2_00130e9f:

#   mct "Definitely her."
    mct "Com certeza, ela."

# game/chapters/chapter5/script/ch5sc2.rpy:573
translate brazil ch5sc2_e78fe9ea:

#   mct "Everything about her is goddess-like."
    mct "Tudo nela é divino."

# game/chapters/chapter5/script/ch5sc2.rpy:575
translate brazil ch5sc2_cbee019f:

#   mc "Maia? I’ve come to-"
    mc "Maia? Eu vim para-"

# game/chapters/chapter5/script/ch5sc2.rpy:577
translate brazil ch5sc2_0c942c29:

#   mai "Lucid sent you."
    mai "Lucid te enviou."

# game/chapters/chapter5/script/ch5sc2.rpy:579
translate brazil ch5sc2_4931eeb1:

#   mc "Yes. How did you-"
    mc "Sim. Como você..."

# game/chapters/chapter5/script/ch5sc2.rpy:581
translate brazil ch5sc2_f2199a1d:

#   mai "Her mischievous scent is all over you."
    mai "O perfume travesso dela está por toda parte em você."

# game/chapters/chapter5/script/ch5sc2.rpy:583
translate brazil ch5sc2_1d0b2910:

#   mai "Approach and I'll cleanse you."
    mai "Aproxima-te e eu te purificarei."

# game/chapters/chapter5/script/ch5sc2.rpy:584
translate brazil ch5sc2_f94bd78f:

#   mct "{i}*Sigh* Guess I'd better do as she wants. I need her help after all.{/i}"
    mct "{i}*Suspiro* Acho melhor fazer o que ela quer. Afinal, preciso da ajuda dela.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:586
translate brazil ch5sc2_c0d03c09:

#   "As you approach her, she rests her palm gently below your chin, looking into your eyes."
    "Ao se aproximar dela, ela coloca a palma da mão delicadamente sob seu queixo, olhando em seus olhos."

# game/chapters/chapter5/script/ch5sc2.rpy:587
translate brazil ch5sc2_d68ecd4e:

#   mai "There’s no mistaking it, you’re {b}‘his’{/b} son."
    mai "Não há como se enganar, você é {b}'dele'{/b} filho."

# game/chapters/chapter5/script/ch5sc2.rpy:589
translate brazil ch5sc2_05abb3b3:

#   mc "Who are you talking about? Whose son?"
    mc "De quem você está falando? Filho de quem?"

# game/chapters/chapter5/script/ch5sc2.rpy:591
translate brazil ch5sc2_b31b0f45:

#   mai "We've met before..."
    mai "Já nos encontramos antes..."

# game/chapters/chapter5/script/ch5sc2.rpy:592
translate brazil ch5sc2_a4204e05:

#   mai "The day you came into this world."
    mai "O dia em que você veio ao mundo."

# game/chapters/chapter5/script/ch5sc2.rpy:594
translate brazil ch5sc2_fcd75213:

#   mc "You... you were there?"
    mc "Você... você estava lá?"

# game/chapters/chapter5/script/ch5sc2.rpy:595
translate brazil ch5sc2_eac839a8:

#   mc "What? ... How? Why?"
    mc "O quê? ... Como? Por quê?"

# game/chapters/chapter5/script/ch5sc2.rpy:597
translate brazil ch5sc2_704a4d4c:

#   mai "I was there at the request of your father."
    mai "Estive lá a pedido do seu pai."

# game/chapters/chapter5/script/ch5sc2.rpy:598
translate brazil ch5sc2_c5e1a136:

#   mai "He wanted me to confirm that you were pure of heart."
    mai "Ele queria que eu confirmasse que você tinha um coração puro."

# game/chapters/chapter5/script/ch5sc2.rpy:599
translate brazil ch5sc2_1128fd49:

#   mai "He was pleased when I affirmed that you were the purest soul I’d ever encountered."
    mai "Ele ficou satisfeito quando afirmei que você era a alma mais pura que eu já havia encontrado."

# game/chapters/chapter5/script/ch5sc2.rpy:601
translate brazil ch5sc2_9c441d26:

#   mai "However... Today, standing before me... I sense turmoil in your emotions."
    mai "Contudo... Hoje, diante de mim... Sinto uma turbulência em suas emoções."

# game/chapters/chapter5/script/ch5sc2.rpy:603
translate brazil ch5sc2_c0e80db9:

#   mai "You are conflicted."
    mai "Você está em conflito."

# game/chapters/chapter5/script/ch5sc2.rpy:604
translate brazil ch5sc2_29983971:

#   mai "You seek balance between what must be done, and what is right."
    mai "Você busca o equilíbrio entre o que precisa ser feito e o que é certo."

# game/chapters/chapter5/script/ch5sc2.rpy:606
translate brazil ch5sc2_dc24e16e:

#   mai "Whether you'll remain the child that was promised..."
    mai "Se você continuará sendo a criança que lhe foi prometida..."

# game/chapters/chapter5/script/ch5sc2.rpy:608
translate brazil ch5sc2_ec6cc773:

#   mai "Or lose yourself to the darkness that enshrouds you... remains to be seen."
    mai "Ou se perder na escuridão que o envolve... só o tempo dirá."

# game/chapters/chapter5/script/ch5sc2.rpy:610
translate brazil ch5sc2_7d621365:

#   mc "The child that was promised? I don’t follow."
    mc "A criança que foi prometida? Não entendi."

# game/chapters/chapter5/script/ch5sc2.rpy:612
translate brazil ch5sc2_9f2d6206:

#   mai "The child of prophecy."
    mai "O filho da profecia."

# game/chapters/chapter5/script/ch5sc2.rpy:613
translate brazil ch5sc2_23baefe6:

#   mai "The one who is destined to either save the world... or bring about its end."
    mai "Aquele que está destinado a salvar o mundo... ou a causar sua destruição."

# game/chapters/chapter5/script/ch5sc2.rpy:615
translate brazil ch5sc2_993acc25:

#   mc "That’s ridiculous."
    mc "Isso é ridículo."

# game/chapters/chapter5/script/ch5sc2.rpy:616
translate brazil ch5sc2_fb4e9e3d:

#   mc "I’m just here to help my friend."
    mc "Estou aqui apenas para ajudar meu amigo."

# game/chapters/chapter5/script/ch5sc2.rpy:618
translate brazil ch5sc2_81e7e2d5:

#   mai "Mh-Hm, for now."
    mai "Hum-hum, por enquanto."

# game/chapters/chapter5/script/ch5sc2.rpy:619
translate brazil ch5sc2_784a2e9f:

#   mai "Come, sit with me."
    mai "Venha, sente-se comigo."

# game/chapters/chapter5/script/ch5sc2.rpy:622
translate brazil ch5sc2_c2447fb4:

#   mct "{i}She knows my father... my actual father?{/i}"
    mct "{i}Ela conhece meu pai... meu pai de verdade?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:624
translate brazil ch5sc2_28224a0d:

#   mct "{i}She certainly lives up to being classified as a goddess...{/i}"
    mct "{i}Ela certamente faz jus ao título de deusa...{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:626
translate brazil ch5sc2_cd42bbd1:

#   mai "Please, join me."
    mai "Por favor, junte-se a mim."

# game/chapters/chapter5/script/ch5sc2.rpy:627
translate brazil ch5sc2_dd4c28c7:

#   mai "We have much to discuss."
    mai "Temos muito o que discutir."

# game/chapters/chapter5/script/ch5sc2.rpy:633
translate brazil ch5sc2_22cc9567:

#   mc "Where are we?"
    mc "Onde estamos?"

# game/chapters/chapter5/script/ch5sc2.rpy:634
translate brazil ch5sc2_113efb74:

#   mc "It’s pretty clear we’re not in Lucid’s realm."
    mc "É bastante óbvio que não estamos no domínio de Lucid."

# game/chapters/chapter5/script/ch5sc2.rpy:636
translate brazil ch5sc2_952878d6:

#   mai "You’re back in Midomir."
    mai "Você está de volta a Midomir."

# game/chapters/chapter5/script/ch5sc2.rpy:637
translate brazil ch5sc2_f2324caa:

#   mai "The highlands of Luxeron, to be specific."
    mai "Mais especificamente, as terras altas de Luxeron."

# game/chapters/chapter5/script/ch5sc2.rpy:639
translate brazil ch5sc2_6ff4f9fd:

#   mai "Well, currently we’re floating above the highlands in one of my gardens of purity."
    mai "Bem, no momento estamos flutuando acima das terras altas em um dos meus jardins de pureza."

# game/chapters/chapter5/script/ch5sc2.rpy:640
translate brazil ch5sc2_6627d4d8:

#   mc "You don’t have your own realm like Lucid?"
    mc "Você não tem seu próprio reino como Lucid?"

# game/chapters/chapter5/script/ch5sc2.rpy:641
translate brazil ch5sc2_65363872:

#   mai "Heavens! No, only the Divines have that luxury."
    mai "Céus! Não, só os Divinos têm esse luxo."

# game/chapters/chapter5/script/ch5sc2.rpy:642
translate brazil ch5sc2_175ac809:

#   mai "The rest of us have to settle for making Midomir our home."
    mai "O resto de nós terá que se contentar em fazer de Midomir o nosso lar."

# game/chapters/chapter5/script/ch5sc2.rpy:644
translate brazil ch5sc2_4b0208a7:

#   mai "We also have access to small pocket realms within the divine realms."
    mai "Também temos acesso a pequenos reinos isolados dentro dos reinos divinos."

# game/chapters/chapter5/script/ch5sc2.rpy:645
translate brazil ch5sc2_10582107:

#   mai "For example I have several sky-gardens in the High-Heavens."
    mai "Por exemplo, tenho vários jardins suspensos nos Altos Céus."

# game/chapters/chapter5/script/ch5sc2.rpy:646
translate brazil ch5sc2_94fe278c:

#   mai "I like it here on Midomir though, and it allows me to be closer to my followers."
    mai "Gosto de estar aqui em Midomir, pois me permite estar mais perto dos meus seguidores."

# game/chapters/chapter5/script/ch5sc2.rpy:648
translate brazil ch5sc2_5fb72b54:

#   mc "Lucid mentioned your worshippers call you ‘Maiden of Purity’?"
    mc "Lucid mencionou que seus fiéis a chamam de 'Donzela da Pureza'?"

# game/chapters/chapter5/script/ch5sc2.rpy:650
translate brazil ch5sc2_da1cc829:

#   mai "That is one of my titles, bestowed upon me by those who follow my teachings."
    mai "Esse é um dos meus títulos, concedido a mim por aqueles que seguem meus ensinamentos."

# game/chapters/chapter5/script/ch5sc2.rpy:651
translate brazil ch5sc2_20d9254a:

#   mai "Usually priests, clerics and healers."
    mai "Geralmente sacerdotes, clérigos e curandeiros."

# game/chapters/chapter5/script/ch5sc2.rpy:653
translate brazil ch5sc2_826e680d:

#   mc "I’ve never really been taught about deities and such."
    mc "Eu nunca aprendi muito sobre divindades e coisas do tipo."

# game/chapters/chapter5/script/ch5sc2.rpy:654
translate brazil ch5sc2_fa30279d:

#   mc "Lucid gave me a quick lesson about the divines."
    mc "Lucid me deu uma rápida aula sobre os divinos."

# game/chapters/chapter5/script/ch5sc2.rpy:655
translate brazil ch5sc2_14eb1de7:

#   mc "But nothing about other deities and gods."
    mc "Mas nada sobre outras divindades e deuses."

# game/chapters/chapter5/script/ch5sc2.rpy:656
translate brazil ch5sc2_c9bf7163:

#   mc "So forgive my ignorance, but how does it work?"
    mc "Então, perdoe minha ignorância, mas como isso funciona?"

# game/chapters/chapter5/script/ch5sc2.rpy:658
translate brazil ch5sc2_2ba0be59:

#   mai "That is most surprising, given who you are."
    mai "Isso é bastante surpreendente, considerando quem você é."

# game/chapters/chapter5/script/ch5sc2.rpy:659
translate brazil ch5sc2_99b9f86b:

#   mai "I’m afraid it’s more complicated than one conversation can convey."
    mai "Receio que seja mais complicado do que uma única conversa possa explicar."

# game/chapters/chapter5/script/ch5sc2.rpy:660
translate brazil ch5sc2_36a64c10:

#   mai "But one of the basics of godhood-"
    mai "Mas um dos princípios básicos da divindade-"

# game/chapters/chapter5/script/ch5sc2.rpy:662
translate brazil ch5sc2_7d74e266:

#   mai "-Is that mortals put their faith in us."
    mai "—É que os mortais depositam sua fé em nós."

# game/chapters/chapter5/script/ch5sc2.rpy:663
translate brazil ch5sc2_e58095b9:

#   mai "They pray to us, believe in us, and they devote themselves to us."
    mai "Eles oram a nós, acreditam em nós e se dedicam a nós."

# game/chapters/chapter5/script/ch5sc2.rpy:665
translate brazil ch5sc2_d65f1765:

#   mai "In return, we use our powers to bestow our blessings, charms, and good fortune on our worshippers."
    mai "Em retribuição, usamos nossos poderes para conceder nossas bênçãos, encantos e boa sorte aos nossos fiéis."

# game/chapters/chapter5/script/ch5sc2.rpy:667
translate brazil ch5sc2_2f331113:

#   mai "And when the time comes for our devotees to part with this world, we claim their soul."
    mai "E quando chegar a hora de nossos devotos partirem deste mundo, reivindicaremos suas almas."

# game/chapters/chapter5/script/ch5sc2.rpy:669
translate brazil ch5sc2_36605ccb:

#   mc "Their soul?"
    mc "A alma deles?"

# game/chapters/chapter5/script/ch5sc2.rpy:670
translate brazil ch5sc2_f0f15e9b:

#   mc "I’ve absorbed souls before..."
    mc "Eu já absorvi almas antes..."

# game/chapters/chapter5/script/ch5sc2.rpy:672
translate brazil ch5sc2_2f84d5b0:

#   mai "Yes, you would have."
    mai "Sim, você teria."

# game/chapters/chapter5/script/ch5sc2.rpy:673
translate brazil ch5sc2_357e9902:

#   mai "Although, we gods are only able to claim the souls of those who belong to our faith."
    mai "Embora nós, deuses, só possamos reivindicar as almas daqueles que pertencem à nossa fé."

# game/chapters/chapter5/script/ch5sc2.rpy:675
translate brazil ch5sc2_e1897238:

#   mc "Interesting. When I absorb a soul, I feel myself become... more?"
    mc "Interessante. Quando absorvo uma alma, sinto que me torno... mais?"

# game/chapters/chapter5/script/ch5sc2.rpy:676
translate brazil ch5sc2_4c4babdf:

#   mc "I'm not exactly sure how to describe it."
    mc "Não sei exatamente como descrever isso."

# game/chapters/chapter5/script/ch5sc2.rpy:677
translate brazil ch5sc2_bf886348:

#   mc "I feel stronger and my senses increase. Sometimes, I even gain new abilities."
    mc "Sinto-me mais forte e meus sentidos se aguçam. Às vezes, até adquiro novas habilidades."

# game/chapters/chapter5/script/ch5sc2.rpy:679
translate brazil ch5sc2_63a5393b:

#   mai "We too grow in power as we gain souls, although we don’t acquire new abilities like you."
    mai "Nós também aumentamos nosso poder à medida que ganhamos almas, embora não adquiramos novas habilidades como vocês."

# game/chapters/chapter5/script/ch5sc2.rpy:681
translate brazil ch5sc2_6b823708:

#   mc "So the more followers a deity has..."
    mc "Portanto, quanto mais seguidores uma divindade tiver..."

# game/chapters/chapter5/script/ch5sc2.rpy:683
translate brazil ch5sc2_d34dd57f:

#   mai "The stronger they become."
    mai "Quanto mais fortes eles se tornam."

# game/chapters/chapter5/script/ch5sc2.rpy:685
translate brazil ch5sc2_7c758bea:

#   mc "I see. What happens if a faith dies out?"
    mc "Entendo. O que acontece se uma fé desaparecer?"

# game/chapters/chapter5/script/ch5sc2.rpy:686
translate brazil ch5sc2_f721f3f9:

#   mai "..."
    mai "..."

# game/chapters/chapter5/script/ch5sc2.rpy:688
translate brazil ch5sc2_d6a4c366:

#   mai "That... results in the deity perishing. They cease to exist."
    mai "Isso... resulta na destruição da divindade. Ela deixa de existir."

# game/chapters/chapter5/script/ch5sc2.rpy:690
translate brazil ch5sc2_f3be376f:

#   mc "Sorry. I didn’t mean to pry."
    mc "Desculpe. Não queria ser intrometida."

# game/chapters/chapter5/script/ch5sc2.rpy:699
translate brazil ch5sc2_93c7c2ff:

#   mc "I know what it's like to lose someone. I won’t press you on the matter."
    mc "Eu sei o que é perder alguém. Não vou insistir nesse assunto."

# game/chapters/chapter5/script/ch5sc2.rpy:700
translate brazil ch5sc2_f3d98e54:

#   mai "I... I appreciate that."
    mai "Eu... eu agradeço."

# game/chapters/chapter5/script/ch5sc2.rpy:702
translate brazil ch5sc2_f2627a5e:

#   mct "{i}Woah? This feeling... It's... familiar to me!{/i}"
    mct "{i}Uau? Essa sensação... É... familiar para mim!{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:703
translate brazil ch5sc2_38821568:

#   mc "Your skin... it’s almost like it’s radiating sunlight."
    mc "Sua pele... é quase como se estivesse irradiando luz solar."

# game/chapters/chapter5/script/ch5sc2.rpy:707
translate brazil ch5sc2_dc0ff26a:

#   mc "Sorry."
    mc "Desculpe."

# game/chapters/chapter5/script/ch5sc2.rpy:708
translate brazil ch5sc2_c01d5b7b:

#   mai "It’s okay."
    mai "Tudo bem."

# game/chapters/chapter5/script/ch5sc2.rpy:709
translate brazil ch5sc2_9290a0ac:

#   mai "It... it felt pleasant."
    mai "Foi... foi agradável."

# game/chapters/chapter5/script/ch5sc2.rpy:711
translate brazil ch5sc2_3a03ff61:

#   "Maia enjoyed your comfort, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Maia gostou do seu conforto, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc2.rpy:712
translate brazil ch5sc2_3ba3ad2f:

#   mai "Where were we? ... Oh, right."
    mai "Onde estávamos? ... Ah, sim."

# game/chapters/chapter5/script/ch5sc2.rpy:716
translate brazil ch5sc2_17fbd41e:

#   mct "{i}It’s clearly a sore spot for her. I'd better let her gather herself.{/i}"
    mct "{i}É evidente que isso é um assunto delicado para ela. É melhor deixá-la se recompor.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:719
translate brazil ch5sc2_e8da9b85:

#   mai "*Sigh* You should know these things."
    mai "*Suspiro* Você deveria saber dessas coisas."

# game/chapters/chapter5/script/ch5sc2.rpy:720
translate brazil ch5sc2_22fa3581:

#   mai "It’s only happened a handful of times throughout the ages."
    mai "Isso só aconteceu algumas vezes ao longo dos tempos."

# game/chapters/chapter5/script/ch5sc2.rpy:721
translate brazil ch5sc2_9d1e6bb0:

#   mai "But it’s always a great loss when it happens."
    mai "Mas é sempre uma grande perda quando isso acontece."

# game/chapters/chapter5/script/ch5sc2.rpy:723
translate brazil ch5sc2_9ab9e76f:

#   mai "Let’s change the subject."
    mai "Vamos mudar de assunto."

# game/chapters/chapter5/script/ch5sc2.rpy:724
translate brazil ch5sc2_eeaabdb1:

#   mai "Why have you sought me out?"
    mai "Por que você me procurou?"

# game/chapters/chapter5/script/ch5sc2.rpy:726
translate brazil ch5sc2_b2e9c1a5:

#   mc "My friend..."
    mc "Meu amigo..."

# game/chapters/chapter5/script/ch5sc2.rpy:727
translate brazil ch5sc2_48908c7f:

#   mc "She recently became a vampire and now her emotions are overwhelming her."
    mc "Ela se tornou vampira recentemente e agora está sendo dominada por suas emoções."

# game/chapters/chapter5/script/ch5sc2.rpy:728
translate brazil ch5sc2_de7ffd9c:

#   mc "Lucid said she couldn’t do anything about it."
    mc "Lucid disse que não podia fazer nada a respeito."

# game/chapters/chapter5/script/ch5sc2.rpy:729
translate brazil ch5sc2_70f32604:

#   mc "But that I could, with your guidance."
    mc "Mas eu poderia, com a sua orientação."

# game/chapters/chapter5/script/ch5sc2.rpy:731
translate brazil ch5sc2_21137749:

#   mai "*Sigh* Typical Lucid."
    mai "*Suspiro* Típico da Lucid."

# game/chapters/chapter5/script/ch5sc2.rpy:732
translate brazil ch5sc2_37855b69:

#   mai "Leaving it up to others to clean up her mess."
    mai "Deixar para os outros a tarefa de limpar a bagunça que ela fez."

# game/chapters/chapter5/script/ch5sc2.rpy:734
translate brazil ch5sc2_faed8d95:

#   mc "Please."
    mc "Por favor."

# game/chapters/chapter5/script/ch5sc2.rpy:735
translate brazil ch5sc2_bea9ccf9:

#   mc "I know I’m asking a lot and that you don’t owe me anything. But it’s important to me."
    mc "Sei que estou pedindo muito e que você não me deve nada. Mas isso é importante para mim."

# game/chapters/chapter5/script/ch5sc2.rpy:737
translate brazil ch5sc2_1c7a04bc:

#   mai "Hmh..."
    mai "Hum..."

# game/chapters/chapter5/script/ch5sc2.rpy:739
translate brazil ch5sc2_7b57b714:

#   mai "Alright! Alright..."
    mai "Muito bem! Muito bem..."

# game/chapters/chapter5/script/ch5sc2.rpy:740
translate brazil ch5sc2_fffbed31:

#   mai "I can’t say no those endearing eyes."
    mai "Não consigo dizer não a esses olhos encantadores."

# game/chapters/chapter5/script/ch5sc2.rpy:742
translate brazil ch5sc2_3fde54dd:

#   mai "I’ll help."
    mai "Eu ajudo."

# game/chapters/chapter5/script/ch5sc2.rpy:743
translate brazil ch5sc2_7a2c96e7:

#   mai "But what you’re asking me to do... what Lucid wants, it hasn't been done before."
    mai "Mas o que você está me pedindo para fazer... o que Lucid quer, nunca foi feito antes."

# game/chapters/chapter5/script/ch5sc2.rpy:744
translate brazil ch5sc2_ed800a8d:

#   mai "I can’t promise that it'll work."
    mai "Não posso prometer que vai funcionar."

# game/chapters/chapter5/script/ch5sc2.rpy:745
translate brazil ch5sc2_82d638d9:

#   mai "And more importantly... you could potentially hurt or even kill your friend trying."
    mai "E, mais importante ainda... você pode acabar machucando ou até mesmo matando seu amigo tentando."

# game/chapters/chapter5/script/ch5sc2.rpy:747
translate brazil ch5sc2_7dddba83:

#   mc "Kill? What exactly do I need to do?"
    mc "Matar? O que exatamente eu preciso fazer?"

# game/chapters/chapter5/script/ch5sc2.rpy:749
translate brazil ch5sc2_80b09f1a:

#   mai "You will have to purify your friend."
    mai "Você terá que purificar seu amigo."

# game/chapters/chapter5/script/ch5sc2.rpy:750
translate brazil ch5sc2_c92bba2f:

#   mai "But purification is usually only performed on mortals who are possessed by dark spirits."
    mai "Mas a purificação geralmente só é realizada em mortais que estão possuídos por espíritos malignos."

# game/chapters/chapter5/script/ch5sc2.rpy:751
translate brazil ch5sc2_8b3190fc:

#   mai "It's not intended for vampires."
    mai "Não é destinado a vampiros."

# game/chapters/chapter5/script/ch5sc2.rpy:752
translate brazil ch5sc2_f77e87bf:

#   mai "We’ll have to modify the purification so that it is specific to a vampire."
    mai "Teremos que modificar a purificação para que seja específica para um vampiro."

# game/chapters/chapter5/script/ch5sc2.rpy:754
translate brazil ch5sc2_fbf70873:

#   mc "Sounds simple enough."
    mc "Parece bastante simples."

# game/chapters/chapter5/script/ch5sc2.rpy:756
translate brazil ch5sc2_6b4fba51:

#   mai "Simple? Altering magic is not something to be taken lightly."
    mai "Simples? Alterar a magia não é algo que deva ser feito levianamente."

# game/chapters/chapter5/script/ch5sc2.rpy:757
translate brazil ch5sc2_0d23e63d:

#   mai "One error, and things will turn grim real quick."
    mai "Um único erro, e as coisas podem ficar muito feias rapidamente."

# game/chapters/chapter5/script/ch5sc2.rpy:758
translate brazil ch5sc2_426edafe:

#   mai "When altering magic, it's usually necessary to practice time and again."
    mai "Ao alterar elementos da magia, geralmente é necessário praticar repetidamente."

# game/chapters/chapter5/script/ch5sc2.rpy:759
translate brazil ch5sc2_9de952ce:

#   mai "And preferably, test it on several test subjects first."
    mai "E, de preferência, teste-o primeiro em vários indivíduos de teste."

# game/chapters/chapter5/script/ch5sc2.rpy:761
translate brazil ch5sc2_a846ede8:

#   mai "I’ll go out on a limb and presume you don’t have a dozen vampires volunteering?"
    mai "Vou arriscar um palpite e presumir que você não tem uma dúzia de vampiros se oferecendo como voluntários?"

# game/chapters/chapter5/script/ch5sc2.rpy:763
translate brazil ch5sc2_2aabd6b2:

#   mc "*Sigh* Not quite... But I do have a natural affinity for magic."
    mc "*Suspiro* Quase... Mas tenho uma afinidade natural com a magia."

# game/chapters/chapter5/script/ch5sc2.rpy:764
translate brazil ch5sc2_507b3836:

#   mc "Given what's at stake, I will only need one attempt."
    mc "Considerando o que está em jogo, precisarei apenas de uma tentativa."

# game/chapters/chapter5/script/ch5sc2.rpy:766
translate brazil ch5sc2_e953b871:

#   "The Goddess remains silent as she contemplates how to proceed."
    "A Deusa permanece em silêncio enquanto pondera sobre como proceder."

# game/chapters/chapter5/script/ch5sc2.rpy:768
translate brazil ch5sc2_4ac69112:

#   mai "Lie down."
    mai "Deitar-se."

# game/chapters/chapter5/script/ch5sc2.rpy:770
translate brazil ch5sc2_56c72db7:

#   mc "What? Right here?"
    mc "O quê? Bem aqui?"

# game/chapters/chapter5/script/ch5sc2.rpy:771
translate brazil ch5sc2_a9c0c10e:

#   mai "*Nods*"
    mai "*Acena com a cabeça*"

# game/chapters/chapter5/script/ch5sc2.rpy:773
translate brazil ch5sc2_90e203db:

#   "She motions for you to rest your head in her lap."
    "Ela faz um gesto para que você apoie a cabeça em seu colo."

# game/chapters/chapter5/script/ch5sc2.rpy:775
translate brazil ch5sc2_e060e49b:

#   "As you lean back and rest, she gently runs her hand through your hair and caresses your chest."
    "Enquanto você se recosta e descansa, ela passa delicadamente a mão pelos seus cabelos e acaricia seu peito."

# game/chapters/chapter5/script/ch5sc2.rpy:777
translate brazil ch5sc2_7723b85f:

#   mai "*Soft voice* That’s it, close your eyes and open your other senses."
    mai "*Voz suave* Isso mesmo, feche os olhos e abra os outros sentidos."

# game/chapters/chapter5/script/ch5sc2.rpy:779
translate brazil ch5sc2_6d2f50bf:

#   mct "I’ve never felt this relaxed before."
    mct "Nunca me senti tão relaxado antes."

# game/chapters/chapter5/script/ch5sc2.rpy:780
translate brazil ch5sc2_1af9aaa2:

#   mct "Everything about her presence is soothing."
    mct "Tudo nela é reconfortante."

# game/chapters/chapter5/script/ch5sc2.rpy:782
translate brazil ch5sc2_49e004a1:

#   mai "*Soft voice* Feel the world around you, let your senses absorb everything."
    mai "*Voz suave* Sinta o mundo ao seu redor, deixe seus sentidos absorverem tudo."

# game/chapters/chapter5/script/ch5sc2.rpy:784
translate brazil ch5sc2_0ff34c74:

#   mc "*Exhales deeply*"
    mc "*Exala profundamente*"

# game/chapters/chapter5/script/ch5sc2.rpy:786
translate brazil ch5sc2_8c9cfbf4:

#   mai "*Soft voice* Now, I’ll share some of my essence with you."
    mai "*Voz suave* Agora, vou compartilhar um pouco da minha essência com você."

# game/chapters/chapter5/script/ch5sc2.rpy:787
translate brazil ch5sc2_ba44d830:

#   mai "*Soft voice* This will allow you to perform purifying magic."
    mai "*Voz suave* Isso lhe permitirá realizar magia de purificação."

# game/chapters/chapter5/script/ch5sc2.rpy:788
translate brazil ch5sc2_190b2a57:

#   mai "*Soft voice* Do you accept this gift? Do you... accept me?"
    mai "*Voz suave* Você aceita este presente? Você... me aceita?"

# game/chapters/chapter5/script/ch5sc2.rpy:790
translate brazil ch5sc2_b4c2b6af:

#   mct "For some reason, I trust her. I feel completely at ease in her presence."
    mct "Por algum motivo, confio nela. Sinto-me completamente à vontade na presença dela."

# game/chapters/chapter5/script/ch5sc2.rpy:791
translate brazil ch5sc2_1245602c:

#   mct "I feel like... I know her somehow? That we're... connected?"
    mct "Sinto que... a conheço de alguma forma? Que estamos... conectadas?"

# game/chapters/chapter5/script/ch5sc2.rpy:792
translate brazil ch5sc2_62c6cb09:

#   mct "{i}Lucid wouldn’t have sent me here if I couldn’t trust Maia.{/i}"
    mct "{i}Lucid não teria me mandado para cá se eu não pudesse confiar em Maia.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:794
translate brazil ch5sc2_88eeb63c:

#   mc "I accept your gift, your guidance... I accept you, Maia."
    mc "Aceito seu presente, sua orientação... Aceito você, Maia."

# game/chapters/chapter5/script/ch5sc2.rpy:796
translate brazil ch5sc2_551f0d7b:

#   mai "*Soft voice* I entrust you with my essence, sacred and pure. May you always use it to protect those in need."
    mai "*Voz suave* Confio-te a minha essência, sagrada e pura. Que a uses sempre para proteger os necessitados."

# game/chapters/chapter5/script/ch5sc2.rpy:798
translate brazil ch5sc2_3f697b2a:

#   mai "*Soft voice* Feel it become one with you. Let it merge with every fiber of your being."
    mai "*Voz suave* Sinta-o tornar-se um com você. Deixe-o fundir-se com cada fibra do seu ser."

# game/chapters/chapter5/script/ch5sc2.rpy:799
translate brazil ch5sc2_a2345d16:

#   mai "*Soft voice* Rest now... I’ll watch over you now as I did when you were but a child."
    mai "*Voz suave* Descanse agora... Eu cuidarei de você agora, como fiz quando você era apenas uma criança."

# game/chapters/chapter5/script/ch5sc2.rpy:802
translate brazil ch5sc2_cff7c854:

#   mai "*Humming* Lay down your head and I’ll sing~"
    mai "*Cantando* Deite a cabeça e eu cantarei~"

# game/chapters/chapter5/script/ch5sc2.rpy:804
translate brazil ch5sc2_c3923abf:

#   mai "*Humming* I’ll sing you to sleep... I’ll sing you awake~"
    mai "*Cantando* Vou cantar para você dormir... Vou cantar para você acordar~"

# game/chapters/chapter5/script/ch5sc2.rpy:806
translate brazil ch5sc2_a3012339:

#   mai "*Humming* Bless your path ahead~"
    mai "*Cantando* Que Deus abençoe seu caminho à frente~"

# game/chapters/chapter5/script/ch5sc2.rpy:808
translate brazil ch5sc2_71d53c5d:

#   mai "*Humming* Bless you with love that only a mother knows~"
    mai "*Cantando* Que Deus te abençoe com o amor que só uma mãe conhece~"

# game/chapters/chapter5/script/ch5sc2.rpy:810
translate brazil ch5sc2_c065b849:

#   mai "*Humming* May you fly... Fly far to the fields of fortune~"
    mai "*Cantando* Que você voe... Voe para longe, até os campos da fortuna~"

# game/chapters/chapter5/script/ch5sc2.rpy:812
translate brazil ch5sc2_dda91e22:

#   mai "*Humming* May you find all that your heart desires~"
    mai "*Cantando* Que você encontre tudo o que seu coração deseja~"

# game/chapters/chapter5/script/ch5sc2.rpy:814
translate brazil ch5sc2_099997f5:

#   mai "*Humming* May you find kindness in all who you meet~"
    mai "*Cantando* Que você encontre bondade em todos que encontrar~"

# game/chapters/chapter5/script/ch5sc2.rpy:816
translate brazil ch5sc2_5bb20b02:

#   mai "*Humming* May there always be angels to watch over you~"
    mai "*Cantando* Que sempre haja anjos para te proteger~"

# game/chapters/chapter5/script/ch5sc2.rpy:818
translate brazil ch5sc2_b48d091b:

#   mai "*Humming* To guard you and keep you safe from harm~"
    mai "*Humming* Para te proteger e te manter a salvo de qualquer mal~"

# game/chapters/chapter5/script/ch5sc2.rpy:821
translate brazil ch5sc2_17708184:

#   mai "My love... My sweet... My everything."
    mai "Meu amor... Minha doçura... Meu tudo."

# game/chapters/chapter5/script/ch5sc2.rpy:824
translate brazil ch5sc2_4216bb73:

#   "Several hours later..."
    "Várias horas depois..."

# game/chapters/chapter5/script/ch5sc2.rpy:826
translate brazil ch5sc2_63e32889:

#   mct "{i}She's so warm. And gentle.{/i}"
    mct "{i}Ela é tão carinhosa. E gentil.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:828
translate brazil ch5sc2_1342570a:

#   mc "Hnh... Was I out for long?"
    mc "Hum... Fiquei desacordado por muito tempo?"

# game/chapters/chapter5/script/ch5sc2.rpy:830
translate brazil ch5sc2_6caac4c0:

#   mai "It’s been a few hours since I shared my essence with you."
    mai "Já se passaram algumas horas desde que compartilhei minha essência com vocês."

# game/chapters/chapter5/script/ch5sc2.rpy:832
translate brazil ch5sc2_a90305e9:

#   mc "Sorry. I didn’t mean to fall asleep on you like that."
    mc "Desculpe. Não queria adormecer assim."

# game/chapters/chapter5/script/ch5sc2.rpy:833
translate brazil ch5sc2_46b3328c:

#   mc "I just felt so... calm? I don’t know."
    mc "Eu me senti tão... calma? Não sei."

# game/chapters/chapter5/script/ch5sc2.rpy:835
translate brazil ch5sc2_25ab32fd:

#   mai "I’ll forgive you."
    mai "Eu te perdoarei."

# game/chapters/chapter5/script/ch5sc2.rpy:837
translate brazil ch5sc2_5c29f68c:

#   mc "Why do I feel so tranquil near you? Is it one of your abilities?"
    mc "Por que me sinto tão tranquilo perto de você? É uma das suas habilidades?"

# game/chapters/chapter5/script/ch5sc2.rpy:838
translate brazil ch5sc2_bee09b04:

#   mc "I feel completely at peace..."
    mc "Sinto-me completamente em paz..."

# game/chapters/chapter5/script/ch5sc2.rpy:840
translate brazil ch5sc2_2ce38bca:

#   mai "I feel it too. It’s exactly the same as when I watched over you as a child."
    mai "Eu também sinto isso. É exatamente igual a quando eu cuidava de você quando criança."

# game/chapters/chapter5/script/ch5sc2.rpy:841
translate brazil ch5sc2_906788de:

#   mai "I was never allowed to interact with you, but I watched over you for the first five years of your life."
    mai "Nunca me foi permitido interagir com você, mas cuidei de você durante os primeiros cinco anos da sua vida."

# game/chapters/chapter5/script/ch5sc2.rpy:845
translate brazil ch5sc2_2013f115:

#   mai "I watched you grow, explore, learn, play. I..."
    mai "Eu vi você crescer, explorar, aprender, brincar. Eu..."

# game/chapters/chapter5/script/ch5sc2.rpy:847
translate brazil ch5sc2_ebcf5d31:

#   "Maia's expression changes as she cuts herself off."
    "A expressão de Maia muda quando ela se interrompe."

# game/chapters/chapter5/script/ch5sc2.rpy:849
translate brazil ch5sc2_10178f6e:

#   mc "You watched over me for five years? Why did you... stop?"
    mc "Você cuidou de mim por cinco anos? Por que você... parou?"

# game/chapters/chapter5/script/ch5sc2.rpy:851
translate brazil ch5sc2_c92132bf:

#   mai "Your father."
    mai "Seu pai."

# game/chapters/chapter5/script/ch5sc2.rpy:852
translate brazil ch5sc2_1150008c:

#   mai "He... He forbade me to continue watching over you."
    mai "Ele... Ele me proibiu de continuar a cuidar de você."

# game/chapters/chapter5/script/ch5sc2.rpy:854
translate brazil ch5sc2_14b5a1a5:

#   mc "Why? ... I remember now. Sometime around my fifth birthday... it was the first time I'd felt cold."
    mc "Por quê? ... Agora me lembro. Mais ou menos no meu quinto aniversário... foi a primeira vez que senti frio."

# game/chapters/chapter5/script/ch5sc2.rpy:855
translate brazil ch5sc2_3c0b9585:

#   mc "Like... like there was something missing. I didn’t pay much attention to it at the time."
    mc "Tipo... como se estivesse faltando alguma coisa. Eu não dei muita atenção a isso na época."

# game/chapters/chapter5/script/ch5sc2.rpy:856
translate brazil ch5sc2_d719b1cf:

#   mc "But now, being close to you... this is the feeling that disappeared back then. A warm, soothing presence."
    mc "Mas agora, estando perto de você... essa é a sensação que desapareceu naquela época. Uma presença calorosa e reconfortante."

# game/chapters/chapter5/script/ch5sc2.rpy:858
translate brazil ch5sc2_22a5407c:

#   mai "My connection to you grew too strong. Your father thought it would be a problem..."
    mai "Minha ligação com você se tornou forte demais. Seu pai achou que isso seria um problema..."

# game/chapters/chapter5/script/ch5sc2.rpy:859
translate brazil ch5sc2_77a6fb5f:

#   mai "Thus, the one who had ordered me to look over you... was also the one to take me away."
    mai "Assim, aquele que me ordenou que cuidasse de você... foi também aquele que me levou embora."

# game/chapters/chapter5/script/ch5sc2.rpy:861
translate brazil ch5sc2_62e9f893:

#   mct "{i}My father... He’s the reason I lost that warmth in my life?{/i}"
    mct "{i}Meu pai... Ele é o motivo de eu ter perdido esse calor na minha vida?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:862
translate brazil ch5sc2_d5842ed0:

#   mct "{i}Maia is clearly upset about the situation too. She also lost something dear to her that day.{/i}"
    mct "{i}Maia também está visivelmente chateada com a situação. Ela também perdeu algo muito querido naquele dia.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:864
translate brazil ch5sc2_8f2aaaa5:

#   mc "Maia, thank you... for watching over me."
    mc "Maia, obrigada... por cuidar de mim."

# game/chapters/chapter5/script/ch5sc2.rpy:865
translate brazil ch5sc2_0f6c5694:

#   "As you acknowledge her, her face brightens once more."
    "Ao cumprimentá-la, o rosto dela se ilumina novamente."

# game/chapters/chapter5/script/ch5sc2.rpy:867
translate brazil ch5sc2_fa34f81d:

#   mai "Oh? You don’t have to thank me. I... I just did what was required of me."
    mai "Ah? Não precisa me agradecer. Eu... eu apenas fiz o que me foi pedido."

# game/chapters/chapter5/script/ch5sc2.rpy:868
translate brazil ch5sc2_0e3545e4:

#   mct "{i}That might have been how it started, but it obviously meant more to her than just a ‘task’.{/i}"
    mct "{i}Talvez tenha sido assim que começou, mas obviamente significava mais para ela do que apenas uma 'tarefa'.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:870
translate brazil ch5sc2_c666350d:

#   mc "No matter what you say, I’m still grateful."
    mc "Independentemente do que você diga, continuo grato."

# game/chapters/chapter5/script/ch5sc2.rpy:872
translate brazil ch5sc2_7c9cf538:

#   mai "What am I to do with you? You’re not supposed to make a goddess blush..."
    mai "O que devo fazer com você? Você não deveria fazer uma deusa corar..."

# game/chapters/chapter5/script/ch5sc2.rpy:873
translate brazil ch5sc2_f3052929:

#   mai "Come, time to get up! I still have to teach you the spell to purify your friend."
    mai "Vamos, hora de levantar! Ainda preciso te ensinar o feitiço para purificar seu amigo."

# game/chapters/chapter5/script/ch5sc2.rpy:876
translate brazil ch5sc2_1387d9c4:

#   mai "Okay, pay attention now."
    mai "Certo, preste atenção agora."

# game/chapters/chapter5/script/ch5sc2.rpy:877
translate brazil ch5sc2_bf78db15:

#   mai "Purifying a person or creature is a demanding process."
    mai "Purificar uma pessoa ou criatura é um processo exigente."

# game/chapters/chapter5/script/ch5sc2.rpy:879
translate brazil ch5sc2_7b61c047:

#   mai "I’ll show you how to create a Purifying sphere. Then it will be your turn to try."
    mai "Vou te mostrar como criar uma esfera purificadora. Depois, será a sua vez de tentar."

# game/chapters/chapter5/script/ch5sc2.rpy:881
translate brazil ch5sc2_ce6b3342:

#   mai "Like this! You have to gather energy in each of your palms. Then you need to activate it and merge it together between your hands."
    mai "Assim! Você precisa reunir energia em cada uma das palmas das mãos. Depois, precisa ativá-la e fundi-la entre as mãos."

# game/chapters/chapter5/script/ch5sc2.rpy:882
translate brazil ch5sc2_834ec922:

#   mai "Each purification is unique. That’s what the runes are for, they determine the effect."
    mai "Cada purificação é única. É para isso que servem as runas, elas determinam o efeito."

# game/chapters/chapter5/script/ch5sc2.rpy:883
translate brazil ch5sc2_83b6b39f:

#   mai "This one will be specific to your situation, purifying a vampire."
    mai "Esta será específica para a sua situação, purificando um vampiro."

# game/chapters/chapter5/script/ch5sc2.rpy:885
translate brazil ch5sc2_917a613f:

#   mc "What will this do exactly? Will it remove her vampirism?"
    mc "O que isso fará exatamente? Vai remover o vampirismo dela?"

# game/chapters/chapter5/script/ch5sc2.rpy:886
translate brazil ch5sc2_6d8727ba:

#   mai "No. She will remain a vampire, a purified vampire. The only one of her kind."
    mai "Não. Ela continuará sendo uma vampira, uma vampira purificada. A única de sua espécie."

# game/chapters/chapter5/script/ch5sc2.rpy:888
translate brazil ch5sc2_24fc839a:

#   mai "Her abilities, strength, speed, everything will remain as before, but it should remove her bloodlust."
    mai "Suas habilidades, força, velocidade, tudo permanecerá como antes, mas isso deverá eliminar sua sede de sangue."

# game/chapters/chapter5/script/ch5sc2.rpy:889
translate brazil ch5sc2_a2511256:

#   mai "She won’t be controlled by her hunger anymore. But she will still have to drink blood to survive, your blood."
    mai "Ela não será mais controlada pela fome. Mas ainda precisará beber sangue para sobreviver, o seu sangue."

# game/chapters/chapter5/script/ch5sc2.rpy:891
translate brazil ch5sc2_141dc0fe:

#   mc "My blood?"
    mc "Meu sangue?"

# game/chapters/chapter5/script/ch5sc2.rpy:892
translate brazil ch5sc2_ecab6194:

#   mai "As the one who purifies her, it will create an unbreakable link between the two of you."
    mai "Como aquele que a purifica, isso criará um vínculo inquebrável entre vocês dois."

# game/chapters/chapter5/script/ch5sc2.rpy:893
translate brazil ch5sc2_b38128ba:

#   mc "What happens if she don't have access to my blood for a while?"
    mc "O que acontece se ela não tiver acesso ao meu sangue por um tempo?"

# game/chapters/chapter5/script/ch5sc2.rpy:895
translate brazil ch5sc2_529c7a60:

#   mai "She will begin to desiccate. It happens to regular vampires as well if they don't feed regularly."
    mai "Ela começará a desidratar. Isso também acontece com vampiros comuns se eles não se alimentarem regularmente."

# game/chapters/chapter5/script/ch5sc2.rpy:896
translate brazil ch5sc2_629c12e4:

#   mai "Basically their bodies shut down slowly, until they finally become immobilized and fall into a deep slumber."
    mai "Basicamente, seus corpos vão se desligando lentamente, até que finalmente fiquem imobilizados e caiam em um sono profundo."

# game/chapters/chapter5/script/ch5sc2.rpy:898
translate brazil ch5sc2_69324f26:

#   mc "So if we're apart for a while, it won't kill her?"
    mc "Então, se ficarmos separados por um tempo, isso não a matará?"

# game/chapters/chapter5/script/ch5sc2.rpy:899
translate brazil ch5sc2_c123961e:

#   mai "No, she won't die. A desiccated vampire can be awoken by feeding them blood, in her case, your blood specifically."
    mai "Não, ela não vai morrer. Um vampiro desidratado pode ser despertado alimentando-o com sangue, no caso dela, especificamente com o seu sangue."

# game/chapters/chapter5/script/ch5sc2.rpy:900
translate brazil ch5sc2_1fe54cb0:

#   mai "Typically the desiccation process takes about a week from the last feeding to begin."
    mai "Normalmente, o processo de dessecação leva cerca de uma semana a partir da última alimentação para começar."

# game/chapters/chapter5/script/ch5sc2.rpy:901
translate brazil ch5sc2_9c681b3f:

#   mct "{i}Hmh, if I have to part with her in the future for more than a week, I'll have to provide her with some vials of my blood.{/i}"
    mct "{i}Hum, se eu tiver que me separar dela no futuro por mais de uma semana, terei que fornecer a ela alguns frascos do meu sangue.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:902
translate brazil ch5sc2_8636d4f2:

#   mct "{i}That way she can continue as normal even if we are seperated for periods of time.{/i}"
    mct "{i}Dessa forma, ela poderá continuar sua vida normalmente, mesmo que fiquemos separados por períodos de tempo.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:903
translate brazil ch5sc2_2d957f00:

#   mc "You say my blood specifically?"
    mc "Você está dizendo meu sangue especificamente?"

# game/chapters/chapter5/script/ch5sc2.rpy:905
translate brazil ch5sc2_e4225b77:

#   mai "She won't crave mortal blood any more. Her body will reject it even if she tries to consume it."
    mai "Ela não sentirá mais desejo por sangue mortal. Seu corpo o rejeitará mesmo que ela tente consumi-lo."

# game/chapters/chapter5/script/ch5sc2.rpy:906
translate brazil ch5sc2_b4f521c3:

#   mai "The only way for her to survive and gain the nourishment she needs, will be from you."
    mai "A única maneira de ela sobreviver e obter o alimento de que precisa será através de você."

# game/chapters/chapter5/script/ch5sc2.rpy:907
translate brazil ch5sc2_3be74963:

#   mct "{i}I didn’t expect this... It would mean that Eliza won’t have to feel guilty about hurting others anymore.{/i}"
    mct "{i}Eu não esperava por isso... Significa que Eliza não precisará mais se sentir culpada por magoar os outros.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:908
translate brazil ch5sc2_8df71711:

#   mct "{i}Feeding from me won’t be an issue, I can easily regenerate. This might work.{/i}"
    mct "{i}Alimentar-me não será um problema, posso me regenerar facilmente. Isso pode funcionar.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:910
translate brazil ch5sc2_b6c48f0e:

#   mai "I like that look of determination in your eyes. Because now it’s your turn to try."
    mai "Gosto desse olhar de determinação nos seus olhos. Porque agora é a sua vez de tentar."

# game/chapters/chapter5/script/ch5sc2.rpy:911
translate brazil ch5sc2_809663c0:

#   mai "It should be rather intuitive for you, now that you've absorbed some of my essence."
    mai "Agora que você absorveu um pouco da minha essência, isso deve ser bastante intuitivo para você."

# game/chapters/chapter5/script/ch5sc2.rpy:913
translate brazil ch5sc2_310141f2:

#   mai "Remember, just let the energy gather in your palms."
    mai "Lembre-se, deixe a energia se acumular nas palmas das suas mãos."

# game/chapters/chapter5/script/ch5sc2.rpy:914
translate brazil ch5sc2_96badd68:

#   mct "{i}Hmh... I can feel the energy, but nothing seems to be happening.{/i}"
    mct "{i}Hum... consigo sentir a energia, mas parece que nada está acontecendo.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:916
translate brazil ch5sc2_6f5ee4f7:

#   mai "Trust your instincts."
    mai "Confie em seus instintos."

# game/chapters/chapter5/script/ch5sc2.rpy:917
translate brazil ch5sc2_392b0a35:

#   mai "When performing purification magic, your mind needs to be in a state of tranquility."
    mai "Ao realizar magia de purificação, sua mente precisa estar em estado de tranquilidade."

# game/chapters/chapter5/script/ch5sc2.rpy:918
translate brazil ch5sc2_73ca94bc:

#   mai "Search within you for something that brings you serenity."
    mai "Busque dentro de si algo que lhe traga serenidade."

# game/chapters/chapter5/script/ch5sc2.rpy:920
translate brazil ch5sc2_0253e664:

#   mai "Do you feel this?"
    mai "Você sente isso?"

# game/chapters/chapter5/script/ch5sc2.rpy:921
translate brazil ch5sc2_f800bed0:

#   mc "Yes."
    mc "Sim."

# game/chapters/chapter5/script/ch5sc2.rpy:922
translate brazil ch5sc2_6ebf5169:

#   mai "That is the feeling you’re looking for. When you find it, focus on manifesting it."
    mai "É essa a sensação que você está procurando. Quando a encontrar, concentre-se em manifestá-la."

# game/chapters/chapter5/script/ch5sc2.rpy:924
translate brazil ch5sc2_521715f7:

#   "A warm tingling sensation builds between your hands, and Maia bites her lip with anticipation."
    "Uma sensação quente e formigante se espalha entre suas mãos, e Maia morde o lábio em antecipação."

# game/chapters/chapter5/script/ch5sc2.rpy:927
translate brazil ch5sc2_112ab7cc:

#   mai "*Excitedly* Yes! That’s it! Good job!"
    mai "*Com entusiasmo* Sim! É isso aí! Bom trabalho!"

# game/chapters/chapter5/script/ch5sc2.rpy:928
translate brazil ch5sc2_d0decd81:

#   mai "It’s beautiful. I’m so proud of you, sweetie!"
    mai "É lindo. Estou tão orgulhosa de você, querida!"

# game/chapters/chapter5/script/ch5sc2.rpy:931
translate brazil ch5sc2_53e63a62:

#   mai "I can’t believe you were able to manifest it that quickly!"
    mai "Não acredito que você conseguiu manifestar isso tão rapidamente!"

# game/chapters/chapter5/script/ch5sc2.rpy:932
translate brazil ch5sc2_25225da6:

#   mai "You were just wonderful! You’ve grown up so... so fast."
    mai "Você foi simplesmente maravilhosa! Você cresceu tão... tão rápido."

# game/chapters/chapter5/script/ch5sc2.rpy:934
translate brazil ch5sc2_e62b814e:

#   mct "{i}She’s hugging me tightly... I’m being hugged by a literal goddess...{/i}"
    mct "{i}Ela está me abraçando forte... Estou sendo abraçada por uma verdadeira deusa...{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:935
translate brazil ch5sc2_aaef044b:

#   mct "{i}She’s not letting go either. Not that I want her to...{/i}"
    mct "{i}Ela também não desiste. Não que eu queira que ela desista...{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:939
translate brazil ch5sc2_ad56d3e1:

#   mc "I take it I did well?"
    mc "Presumo que me saí bem?"

# game/chapters/chapter5/script/ch5sc2.rpy:941
translate brazil ch5sc2_1197844c:

#   mai "Mhm-Hm... Extraordinarily well! It takes years to learn for even the most gifted clerics and priests!"
    mai "Hum-hum... Extraordinariamente bem! Leva anos para aprender, mesmo para os clérigos e sacerdotes mais talentosos!"

# game/chapters/chapter5/script/ch5sc2.rpy:942
translate brazil ch5sc2_8be84655:

#   mai "I’m... very impressed."
    mai "Estou... muito impressionado."

# game/chapters/chapter5/script/ch5sc2.rpy:944
translate brazil ch5sc2_4b83139c:

#   mc "Is that why you’re holding on to me so tightly?"
    mc "É por isso que você está me abraçando com tanta força?"

# game/chapters/chapter5/script/ch5sc2.rpy:946
translate brazil ch5sc2_e4b9be8f:

#   "Maia realizes she’s been hugging you intimately in her excitement."
    "Maia percebe que, em sua empolgação, estava te abraçando de forma muito íntima."

# game/chapters/chapter5/script/ch5sc2.rpy:957
translate brazil ch5sc2_e6681d59:

#   mai "{b}HEAVENS!{/b} What am I doing!?"
    mai "{b}Céus!{/b} O que estou fazendo!?"

# game/chapters/chapter5/script/ch5sc2.rpy:958
translate brazil ch5sc2_219c3531:

#   mai "P-Please, forgive me. It was highly inappropriate for me to do that!"
    mai "P-Por favor, me perdoe. Foi extremamente inapropriado da minha parte fazer isso!"

# game/chapters/chapter5/script/ch5sc2.rpy:960
translate brazil ch5sc2_81b50b34:

#   mc "It’s okay, you didn’t do me any harm. It felt nice... You’re incredibly warm."
    mc "Está tudo bem, você não me fez mal nenhum. Foi uma sensação agradável... Você é incrivelmente quentinho(a)."

# game/chapters/chapter5/script/ch5sc2.rpy:962
translate brazil ch5sc2_651143d7:

#   mc "I enjoyed it. If I hadn't, I would've asked you to stop."
    mc "Gostei. Se não tivesse gostado, teria pedido para você parar."

# game/chapters/chapter5/script/ch5sc2.rpy:964
translate brazil ch5sc2_dfd3cc09:

#   mai "[mc]... Thank you, it’s kind of you to say."
    mai "[mc]... Obrigada, é muita gentileza sua dizer isso."

# game/chapters/chapter5/script/ch5sc2.rpy:965
translate brazil ch5sc2_eea82ee4:

#   mai "I... I'd better send you back now. You have everything you need to help your friend."
    mai "Eu... eu acho melhor te mandar de volta agora. Você tem tudo o que precisa para ajudar seu amigo."

# game/chapters/chapter5/script/ch5sc2.rpy:967
translate brazil ch5sc2_528d9b63:

#   mc "Thank you for your guidance, Maia. I hope I haven’t caused you any trouble..."
    mc "Obrigada pela sua orientação, Maia. Espero não ter lhe causado nenhum problema..."

# game/chapters/chapter5/script/ch5sc2.rpy:969
translate brazil ch5sc2_a1469470:

#   mai "You’re welcome. But now, you must leave."
    mai "De nada. Mas agora, você precisa ir embora."

# game/chapters/chapter5/script/ch5sc2.rpy:971
translate brazil ch5sc2_21abcda2:

#   mai "Here... I’ll make a portal for you."
    mai "Aqui... vou criar um portal para você."

# game/chapters/chapter5/script/ch5sc2.rpy:974
translate brazil ch5sc2_42cee9c4:

#   mai "It will take you back to Luxenford."
    mai "Isso o levará de volta a Luxemburgo."

# game/chapters/chapter5/script/ch5sc2.rpy:976
translate brazil ch5sc2_d6dda5db:

#   mc "Okay... Once more, I apologize for making you feel uncomfortable. That wasn’t my intention."
    mc "Certo... Mais uma vez, peço desculpas por ter te deixado desconfortável. Essa não era minha intenção."

# game/chapters/chapter5/script/ch5sc2.rpy:981
translate brazil ch5sc2_ee17b52d:

#   mai "You could never make me feel uncomfortable."
    mai "Você jamais conseguiria me fazer sentir desconfortável."

# game/chapters/chapter5/script/ch5sc2.rpy:983
translate brazil ch5sc2_e143f008:

#   mai "All these years. How you’ve grown... Strong, willful, beautiful."
    mai "Todos esses anos. Como você cresceu... Forte, determinada, linda."

# game/chapters/chapter5/script/ch5sc2.rpy:984
translate brazil ch5sc2_6fafe3ce:

#   mai "*Sighs heavily* Castiel... I won’t forgive this."
    mai "*Suspira profundamente* Castiel... Eu não vou perdoar isso."

# game/chapters/chapter5/script/ch5sc2.rpy:985
translate brazil ch5sc2_ae5e4bff:

#   mai "Forcing me to... part with him for the second time."
    mai "Me obrigando a... me separar dele pela segunda vez."

# game/chapters/chapter5/script/ch5sc2.rpy:1002
translate brazil ch5sc2_681a6e98:

#   uk "Mommy! Look! A man just appeared out of thin air!"
    uk "Mamãe! Olha! Um homem apareceu do nada!"

# game/chapters/chapter5/script/ch5sc2.rpy:1003
translate brazil ch5sc2_1595ab2b:

#   wo "Sweetie, Mommy doesn’t have time for your fantasies right now."
    wo "Querido(a), a mamãe não tem tempo para as suas fantasias agora."

# game/chapters/chapter5/script/ch5sc2.rpy:1005
translate brazil ch5sc2_45347d3d:

#   mct "{i}Ugh... I feel lightheaded. Don’t imagine I'll be a fan of portals anytime soon.{/i}"
    mct "{i}Ugh... Estou me sentindo tonta. Não acho que vou gostar de portais tão cedo.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1006
translate brazil ch5sc2_28a3ee20:

#   mct "{i}I'd better go find Eliza. The sooner we attempt this purification, the better.{/i}"
    mct "{i}É melhor eu ir encontrar Eliza. Quanto antes tentarmos essa purificação, melhor.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1008
translate brazil ch5sc2_ce5a24eb:

#   uk "Mommy! He really is magic! You never believe me!"
    uk "Mamãe! Ele é mesmo mágico! Você nunca acredita em mim!"

# game/chapters/chapter5/script/ch5sc2.rpy:1013
translate brazil ch5sc2_350e49ef:

#   br "Hah! The bugger really said that?"
    br "Hah! O desgraçado realmente disse isso?"

# game/chapters/chapter5/script/ch5sc2.rpy:1014
translate brazil ch5sc2_e7c76b71:

#   ml "He thought I was there to court his daughter, but I was just trying to deliver a package from Sylph."
    ml "Ele pensou que eu estava lá para cortejar a filha dele, mas eu só estava tentando entregar um pacote da Sylph."

# game/chapters/chapter5/script/ch5sc2.rpy:1015
translate brazil ch5sc2_5253b87a:

#   br "Hah! And he really chased you all the way into the street?"
    br "Hah! E ele realmente te perseguiu até a rua?"

# game/chapters/chapter5/script/ch5sc2.rpy:1016
translate brazil ch5sc2_5def7668:

#   ml "Yeah... I didn't even manage to collect the payment. Fortunately, the daughter caught up to me and paid."
    ml "É... eu nem consegui receber o pagamento. Felizmente, minha filha me alcançou e pagou."

# game/chapters/chapter5/script/ch5sc2.rpy:1018
translate brazil ch5sc2_a07d5c5e:

#   br "Oi, [mc]! Finally yer here! Heard ye got a fancy shmancy contract guardin t’princess?”"
    br "Oi, [mc] Finalmente você chegou! Ouvi dizer que conseguiu um contrato chique pra proteger a princesa?"

# game/chapters/chapter5/script/ch5sc2.rpy:1020
translate brazil ch5sc2_070b3a7e:

#   mc "Hey guys. I’m afraid the princess is less than thrilled about it."
    mc "Olá pessoal. Receio que a princesa não esteja nada satisfeita com isso."

# game/chapters/chapter5/script/ch5sc2.rpy:1021
translate brazil ch5sc2_e2974d8c:

#   mc "Have either of you seen Eliza? I have some news for her."
    mc "Algum de vocês viu a Eliza? Tenho novidades para ela."

# game/chapters/chapter5/script/ch5sc2.rpy:1023
translate brazil ch5sc2_024f7f94:

#   br "Aye, the lass was around just a few moments ago."
    br "Sim, a moça estava por aqui há poucos instantes."

# game/chapters/chapter5/script/ch5sc2.rpy:1024
translate brazil ch5sc2_3cb803da:

#   br "Maybe she went t' Dalen’s office, or maybe she's helping Sylph sort contracts in the next room?"
    br "Talvez ela tenha ido ao escritório de Dalen, ou talvez esteja ajudando Sylph a organizar os contratos na sala ao lado?"

# game/chapters/chapter5/script/ch5sc2.rpy:1032
translate brazil ch5sc2_d29a64ab:

#   el "*Squeals* Aiiiyh! Y-You knew!?"
    el "*Gritos* Aiiiyh! V-Você sabia!?"

# game/chapters/chapter5/script/ch5sc2.rpy:1034
translate brazil ch5sc2_076a0fb6:

#   mc "Mh-Hm. I sensed your devious intentions the moment I walked through the door."
    mc "Hum-hum. Eu pressenti suas intenções maliciosas no momento em que entrei pela porta."

# game/chapters/chapter5/script/ch5sc2.rpy:1037
translate brazil ch5sc2_c7fa1311:

#   el "*Giggles* Oh yeah? Did you also sense this?"
    el "*Risos* Ah, é? Você também sentiu isso?"

# game/chapters/chapter5/script/ch5sc2.rpy:1040
translate brazil ch5sc2_f9176e35:

#   el "Mhmm!"
    el "Hum!"

# game/chapters/chapter5/script/ch5sc2.rpy:1050
translate brazil ch5sc2_c1e979d7:

#   bth "......."
    bth "......."

# game/chapters/chapter5/script/ch5sc2.rpy:1052
translate brazil ch5sc2_781e4dff:

#   br "C’mon lad, Sylph needed our help with... eh... boxes!"
    br "Vamos lá, rapaz, Sylph precisava da nossa ajuda com... eh... caixas!"

# game/chapters/chapter5/script/ch5sc2.rpy:1053
translate brazil ch5sc2_4c9aaaa9:

#   ml "R-Right! Barrels! Let’s go."
    ml "Certo! Barris! Vamos lá."

# game/chapters/chapter5/script/ch5sc2.rpy:1058
translate brazil ch5sc2_ce474a81:

#   el "*Softly moans* Nnnhhh... *Kiss* Mwh... *Lick* Nhnh-Mmnh!"
    el "*Geme baixinho* Nnnhhh... *Beijo* Mwh... *Lambe* Nhnh-Mmnh!"

# game/chapters/chapter5/script/ch5sc2.rpy:1060
translate brazil ch5sc2_577f7c07:

#   mct "{i}Heh... I’ve missed you too, kitten.{/i}"
    mct "{i}Heh... Eu também senti sua falta, gatinha.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1062
translate brazil ch5sc2_0b313105:

#   el "How... How's that for devious intentions?"
    el "Que... Que tal essas intenções ardilosas?"

# game/chapters/chapter5/script/ch5sc2.rpy:1063
translate brazil ch5sc2_355e5b0c:

#   mc "I take it back. Your intentions are pure of heart."
    mc "Retiro o que disse. Suas intenções são puras."

# game/chapters/chapter5/script/ch5sc2.rpy:1065
translate brazil ch5sc2_841a4ca5:

#   el "*Mwah!*"
    el "*Beijinho!*"

# game/chapters/chapter5/script/ch5sc2.rpy:1067
translate brazil ch5sc2_d97249f3:

#   el "*Giggles softly* Missed you!"
    el "*Risos suaves* Senti sua falta!"

# game/chapters/chapter5/script/ch5sc2.rpy:1069
translate brazil ch5sc2_a9a99a38:

#   el "*Mwah!* Sheee... The purest intentions! Mhhm..."
    el "*Mwah!* Sheee... As intenções mais puras! Mhhm..."

# game/chapters/chapter5/script/ch5sc2.rpy:1071
translate brazil ch5sc2_0f0f9966:

#   mc "Speaking of pure, let’s head to the tavern. I’ve learnt something that might help you."
    mc "Falando em pureza, vamos até a taverna. Aprendi algo que pode te ajudar."

# game/chapters/chapter5/script/ch5sc2.rpy:1075
translate brazil ch5sc2_bda68ee9:

#   el "*Giggles* I have the purest of intentions, I’ll have you know!"
    el "*Risos* Tenho as intenções mais puras, pode ter certeza!"

# game/chapters/chapter5/script/ch5sc2.rpy:1080
translate brazil ch5sc2_9e2f658c:

#   el "Wait... So you’re telling me you spent the day with not one... but TWO goddesses?!"
    el "Espera aí... Então você está me dizendo que passou o dia não com uma... mas com DUAS deusas?!"

# game/chapters/chapter5/script/ch5sc2.rpy:1082
translate brazil ch5sc2_03228264:

#   mc "I know... It sounds unbelievable."
    mc "Eu sei... Parece inacreditável."

# game/chapters/chapter5/script/ch5sc2.rpy:1084
translate brazil ch5sc2_017e1e73:

#   el "Yeah... If you weren’t the one telling me directly, I wouldn’t believe it."
    el "É... Se você não tivesse me dito diretamente, eu não acreditaria."

# game/chapters/chapter5/script/ch5sc2.rpy:1085
translate brazil ch5sc2_4a017e4c:

#   el "How did it even happen? What were they like? Did you learn anything?"
    el "Como isso aconteceu? Como eles eram? Você aprendeu alguma coisa?"

# game/chapters/chapter5/script/ch5sc2.rpy:1087
translate brazil ch5sc2_840fb521:

#   mc "*Chuckles* Calm down, one question at a time."
    mc "*Risos* Calma, uma pergunta de cada vez."

# game/chapters/chapter5/script/ch5sc2.rpy:1089
translate brazil ch5sc2_9da25f60:

#   el "Mhph... Okay."
    el "Hum... Ok."

# game/chapters/chapter5/script/ch5sc2.rpy:1090
translate brazil ch5sc2_80b790a1:

#   el "Let’s start with how you managed to meet two... {b}TWO{/b} goddesses?"
    el "Vamos começar por como você conseguiu conhecer dois... {b} DOIS{/b} deusas?"

# game/chapters/chapter5/script/ch5sc2.rpy:1092
translate brazil ch5sc2_b428004f:

#   mc "Well, I had the idea to call out to Lucid, given she was the only one I'd met at the time."
    mc "Bem, eu tive a ideia de chamar a Lucid, já que ela era a única que eu conhecia até então."

# game/chapters/chapter5/script/ch5sc2.rpy:1093
translate brazil ch5sc2_bdb19ce3:

#   mc "And also because she is the one who created vampires in the first place."
    mc "E também porque foi ela quem criou os vampiros, para começo de conversa."

# game/chapters/chapter5/script/ch5sc2.rpy:1094
translate brazil ch5sc2_e6d45115:

#   mc "Of course, I had no idea if it would even work. But seeing the state you were in this morning..."
    mc "É claro que eu não tinha ideia se isso ia funcionar. Mas vendo o estado em que você estava esta manhã..."

# game/chapters/chapter5/script/ch5sc2.rpy:1096
translate brazil ch5sc2_5d1daf68:

#   mc "I was desperate. It was worth a shot. Next thing I knew, I felt something envelop me."
    mc "Eu estava desesperado. Valia a pena tentar. No instante seguinte, senti algo me envolver."

# game/chapters/chapter5/script/ch5sc2.rpy:1097
translate brazil ch5sc2_e1fcc03b:

#   mc "It was like a warm blanket, but light as air. I must’ve passed out, 'cause when I awoke I was with Lucid."
    mc "Era como um cobertor quentinho, mas leve como o ar. Devo ter desmaiado, porque quando acordei estava com Lucid."

# game/chapters/chapter5/script/ch5sc2.rpy:1099
translate brazil ch5sc2_cc2cbbc6:

#   mc "Apparently, she'd heard my plea and decided to transport me to her realm, the Inferno Isles."
    mc "Aparentemente, ela ouviu meu apelo e decidiu me transportar para o seu reino, as Ilhas do Inferno."

# game/chapters/chapter5/script/ch5sc2.rpy:1101
translate brazil ch5sc2_a38f104e:

#   el "A different realm? I... how?"
    el "Um reino diferente? Eu... como?"

# game/chapters/chapter5/script/ch5sc2.rpy:1103
translate brazil ch5sc2_f82af993:

#   mc "I don't know. Let’s just chalk it up to her being an all powerful divine?"
    mc "Não sei. Vamos simplesmente atribuir isso ao fato de ela ser uma divindade onipotente?"

# game/chapters/chapter5/script/ch5sc2.rpy:1104
translate brazil ch5sc2_d14214af:

#   mc "Whenever I’m around her, I get this weird feeling inside me."
    mc "Sempre que estou perto dela, sinto uma sensação estranha dentro de mim."

# game/chapters/chapter5/script/ch5sc2.rpy:1106
translate brazil ch5sc2_f4c263f3:

#   el "Like what?"
    el "Como o que?"

# game/chapters/chapter5/script/ch5sc2.rpy:1108
translate brazil ch5sc2_a1040099:

#   mc "Like... family?"
    mc "Tipo... família?"

# game/chapters/chapter5/script/ch5sc2.rpy:1109
translate brazil ch5sc2_e369a16b:

#   mc "The best way to describe it is how I used to feel when I was at home with my parents."
    mc "A melhor maneira de descrever é como eu me sentia quando estava em casa com meus pais."

# game/chapters/chapter5/script/ch5sc2.rpy:1111
translate brazil ch5sc2_2576db08:

#   el "Really? That is strange."
    el "Sério? Que estranho."

# game/chapters/chapter5/script/ch5sc2.rpy:1112
translate brazil ch5sc2_8285ca26:

#   el "Do you think... you’re related somehow?"
    el "Você acha que... vocês são parentes de alguma forma?"

# game/chapters/chapter5/script/ch5sc2.rpy:1114
translate brazil ch5sc2_cb711f44:

#   mc "I don’t know."
    mc "Não sei."

# game/chapters/chapter5/script/ch5sc2.rpy:1115
translate brazil ch5sc2_2386034f:

#   mc "Anything is possible, I suppose."
    mc "Suponho que tudo seja possível."

# game/chapters/chapter5/script/ch5sc2.rpy:1117
translate brazil ch5sc2_7b53aab7:

#   el "Was she able to help?"
    el "Ela conseguiu ajudar?"

# game/chapters/chapter5/script/ch5sc2.rpy:1119
translate brazil ch5sc2_099dda0f:

#   mc "Not exactly."
    mc "Não exatamente."

# game/chapters/chapter5/script/ch5sc2.rpy:1120
translate brazil ch5sc2_0a65dcd4:

#   mc "She couldn't do anything herself, but she sent me to another goddess, Maia."
    mc "Ela não podia fazer nada sozinha, mas me enviou para outra deusa, Maia."

# game/chapters/chapter5/script/ch5sc2.rpy:1123
translate brazil ch5sc2_1eb0bac2:

#   el "Maia, Maiden of Purity?! Heavens! You’ve actually met her?"
    el "Maia, a Donzela da Pureza?! Céus! Você realmente a conheceu?"

# game/chapters/chapter5/script/ch5sc2.rpy:1124
translate brazil ch5sc2_679e30cb:

#   mc "Judging by your reaction, I assume you know of her?"
    mc "Pela sua reação, presumo que você a conheça?"

# game/chapters/chapter5/script/ch5sc2.rpy:1125
translate brazil ch5sc2_aefb1ee6:

#   el "Of course! Didn’t you?! She's the goddess of purity, love and fertility!"
    el "Claro! Não é mesmo?! Ela é a deusa da pureza, do amor e da fertilidade!"

# game/chapters/chapter5/script/ch5sc2.rpy:1126
translate brazil ch5sc2_0d478b68:

#   el "Mother often prayed at her shrines in hopes of getting pregnant again."
    el "A mãe costumava rezar em seus altares na esperança de engravidar novamente."

# game/chapters/chapter5/script/ch5sc2.rpy:1128
translate brazil ch5sc2_0efe9eac:

#   "Eliza’s interest has been piqued, and she eagerly awaits the continuation of your story."
    "O interesse de Eliza foi despertado e ela aguarda ansiosamente a continuação da sua história."

# game/chapters/chapter5/script/ch5sc2.rpy:1129
translate brazil ch5sc2_84d92416:

#   mct "{i}She’s cute when she gets all excited.{/i}"
    mct "{i}Ela fica uma gracinha quando se empolga toda.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1131
translate brazil ch5sc2_39995017:

#   mc "Okay. So, Lucid sent me to Maia to receive her guidance."
    mc "Certo. Então, Lucid me enviou até Maia para receber sua orientação."

# game/chapters/chapter5/script/ch5sc2.rpy:1133
translate brazil ch5sc2_817999eb:

#   mc "She was surprisingly welcoming."
    mc "Ela foi surpreendentemente receptiva."

# game/chapters/chapter5/script/ch5sc2.rpy:1134
translate brazil ch5sc2_92ea0289:

#   mc "I don’t know what I expected... maybe I imagined she'd be more aloof?"
    mc "Não sei o que eu esperava... talvez imaginasse que ela seria mais distante?"

# game/chapters/chapter5/script/ch5sc2.rpy:1136
translate brazil ch5sc2_eb5b8af8:

#   mc "But as soon as we started talking, I could sense she was genuinely filled with a warm kindness."
    mc "Mas assim que começamos a conversar, pude perceber que ela era genuinamente repleta de uma gentileza calorosa."

# game/chapters/chapter5/script/ch5sc2.rpy:1138
translate brazil ch5sc2_42d6f29e:

#   mc "It turns out, she'd been watching over me from when I was born."
    mc "Acontece que ela estava me protegendo desde que eu nasci."

# game/chapters/chapter5/script/ch5sc2.rpy:1139
translate brazil ch5sc2_c6b2e7a3:

#   mc "At the behest of my father, apparently."
    mc "Aparentemente, a pedido do meu pai."

# game/chapters/chapter5/script/ch5sc2.rpy:1141
translate brazil ch5sc2_d27f795f:

#   el "Y-Your father? Your angel-father?"
    el "Seu pai? Seu anjo da guarda?"

# game/chapters/chapter5/script/ch5sc2.rpy:1143
translate brazil ch5sc2_8b3f691d:

#   mc "Yeah... Apparently she was supposed to keep an eye out for any signs of darkness within me."
    mc "Sim... Aparentemente, ela deveria ficar atenta a qualquer sinal de escuridão dentro de mim."

# game/chapters/chapter5/script/ch5sc2.rpy:1145
translate brazil ch5sc2_c3a453b1:

#   mc "But around my fifth birthday, he ordered her to stop watching over me."
    mc "Mas por volta do meu quinto aniversário, ele ordenou que ela parasse de me vigiar."

# game/chapters/chapter5/script/ch5sc2.rpy:1147
translate brazil ch5sc2_e90d696d:

#   el "W-What?! Why?"
    el "O quê?! Por quê?"

# game/chapters/chapter5/script/ch5sc2.rpy:1148
translate brazil ch5sc2_b2bea639:

#   el "That doesn't seem right."
    el "Isso não me parece certo."

# game/chapters/chapter5/script/ch5sc2.rpy:1150
translate brazil ch5sc2_edada8c3:

#   mc "She wouldn’t say... But I could feel the heaviness of her emotions when she told me."
    mc "Ela não quis dizer... Mas eu pude sentir o peso das suas emoções quando ela me contou."

# game/chapters/chapter5/script/ch5sc2.rpy:1152
translate brazil ch5sc2_a749b1bf:

#   el "Well, yeah. Think about it. If she'd been watching over you since your birth..."
    el "Pois é. Pense bem. Se ela estivesse cuidando de você desde o seu nascimento..."

# game/chapters/chapter5/script/ch5sc2.rpy:1153
translate brazil ch5sc2_20b06874:

#   el "She had probably developed some sort of motherly bond with you, no?"
    el "Ela provavelmente desenvolveu algum tipo de laço maternal com você, não é?"

# game/chapters/chapter5/script/ch5sc2.rpy:1155
translate brazil ch5sc2_f97b8106:

#   mc "Hmh... I didn't think of that."
    mc "Hum... Não tinha pensado nisso."

# game/chapters/chapter5/script/ch5sc2.rpy:1156
translate brazil ch5sc2_895eb95d:

#   mc "But we’re getting off-topic."
    mc "Mas estamos nos desviando do assunto."

# game/chapters/chapter5/script/ch5sc2.rpy:1157
translate brazil ch5sc2_d89c5841:

#   mc "After talking for a while, she shared some of her essence with me."
    mc "Depois de conversarmos um pouco, ela compartilhou um pouco da sua essência comigo."

# game/chapters/chapter5/script/ch5sc2.rpy:1158
translate brazil ch5sc2_8f79dc77:

#   mc "She wanted me to be able to perform purification magic."
    mc "Ela queria que eu fosse capaz de realizar magia de purificação."

# game/chapters/chapter5/script/ch5sc2.rpy:1159
translate brazil ch5sc2_16ad3a9b:

#   mc "And apparently, having her essence makes this much easier."
    mc "E, aparentemente, ter a essência dela torna tudo muito mais fácil."

# game/chapters/chapter5/script/ch5sc2.rpy:1161
translate brazil ch5sc2_3db4f37c:

#   el "You have the essence of a goddess within you now?"
    el "Você possui a essência de uma deusa dentro de si agora?"

# game/chapters/chapter5/script/ch5sc2.rpy:1162
translate brazil ch5sc2_6a7b3738:

#   el "T-That’s... wild."
    el "Isso é... incrível."

# game/chapters/chapter5/script/ch5sc2.rpy:1164
translate brazil ch5sc2_5042daa3:

#   mc "Just a small amount. It helped me to attune to her purification magic in minutes."
    mc "Apenas uma pequena quantidade. Isso me ajudou a sintonizar com a magia de purificação dela em minutos."

# game/chapters/chapter5/script/ch5sc2.rpy:1166
translate brazil ch5sc2_19f35ab2:

#   mc "Even she was surprised. She said it takes even her most devout worshippers years to do."
    mc "Até ela ficou surpresa. Ela disse que até mesmo seus fiéis mais devotos levam anos para fazer isso."

# game/chapters/chapter5/script/ch5sc2.rpy:1168
translate brazil ch5sc2_bf916a76:

#   el "Well... you are pretty amazing."
    el "Bem... você é realmente incrível."

# game/chapters/chapter5/script/ch5sc2.rpy:1170
translate brazil ch5sc2_469e90aa:

#   mc "Heh, thanks. It’s always been easy for me to learn magic, even when I don’t fully understand it."
    mc "Heh, obrigado. Sempre foi fácil para mim aprender magia, mesmo quando não a compreendo completamente."

# game/chapters/chapter5/script/ch5sc2.rpy:1171
translate brazil ch5sc2_f655050c:

#   mc "It’s like my body attunes itself to different types of magic quickly. And then I can intuitively use that magic."
    mc "É como se meu corpo se sintonizasse rapidamente com diferentes tipos de magia. E então eu consigo usar essa magia intuitivamente."

# game/chapters/chapter5/script/ch5sc2.rpy:1173
translate brazil ch5sc2_1c92ebef:

#   el "That’s how you were able to learn wind magic from Rin, right?"
    el "Foi assim que você conseguiu aprender magia do vento com a Rin, certo?"

# game/chapters/chapter5/script/ch5sc2.rpy:1174
translate brazil ch5sc2_3cb69e2e:

#   mc "Yeah. She was quite surprised when I manifested wind during our first session."
    mc "Sim. Ela ficou bastante surpresa quando manifestei o vento durante nossa primeira sessão."

# game/chapters/chapter5/script/ch5sc2.rpy:1177
