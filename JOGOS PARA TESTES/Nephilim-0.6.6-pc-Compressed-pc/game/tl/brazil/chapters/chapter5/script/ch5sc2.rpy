# game/chapters/chapter5/script/ch5sc2.rpy:2211
translate brazil ch5sc2_c7f6fe63:

#   ri "Persistent."
    ri "Persistente."

# game/chapters/chapter5/script/ch5sc2.rpy:2212
translate brazil ch5sc2_b4639ed1:

#   ir "You'll answer for your crimes against the society!"
    ir "Você responderá por seus crimes contra a sociedade!"

# game/chapters/chapter5/script/ch5sc2.rpy:2215
translate brazil ch5sc2_facfd89f:

#   ir "*Groans* Urgh!"
    ir "*Geme* Urgh!"

# game/chapters/chapter5/script/ch5sc2.rpy:2219
translate brazil ch5sc2_2848b735:

#   ri "Had potential."
    ri "Tinha potencial."

# game/chapters/chapter5/script/ch5sc2.rpy:2222
translate brazil ch5sc2_afaaf100:

#   ri "Maybe?"
    ri "Talvez?"

# game/chapters/chapter5/script/ch5sc2.rpy:2224
translate brazil ch5sc2_cf5d0558:

#   ri "Will see."
    ri "Veremos."

# game/chapters/chapter5/script/ch5sc2.rpy:2226
translate brazil ch5sc2_5d098316:

#   ir "*Groans* Hnnghh..."
    ir "*Gemidos* Hnnghh..."

# game/chapters/chapter5/script/ch5sc2.rpy:2227
translate brazil ch5sc2_567cbace:

#   ir "W-What... happened?"
    ir "O que... aconteceu?"

# game/chapters/chapter5/script/ch5sc2.rpy:2229
translate brazil ch5sc2_ff3010b7:

#   ir "She... used magic? Ughh... my head is spinning."
    ir "Ela... usou magia? Ughh... minha cabeça está girando."

# game/chapters/chapter5/script/ch5sc2.rpy:2230
translate brazil ch5sc2_a9bc151c:

#   ir "I was out cold... she could've finished me off easily... why spare me?"
    ir "Eu desmaiei... ela poderia ter acabado comigo facilmente... por que me poupar?"

# game/chapters/chapter5/script/ch5sc2.rpy:2231
translate brazil ch5sc2_b3ea29e2:

#   ir "The society won't be happy with my failure... but I'm clearly outmatched."
    ir "A sociedade não ficará satisfeita com o meu fracasso... mas é evidente que estou em desvantagem."

# game/chapters/chapter5/script/ch5sc2.rpy:2243
translate brazil ch5sc2_6657f58b:

#   mct "{i}Hmh... Sylph’s clue was...{/i}"
    mct "{i}Hum... A pista da Sylph foi...{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2244
translate brazil ch5sc2_7164ca3c:

#   mct "{i}I rest near the sky but I'm afraid of heights. Come rescue me, oh great adventurer, before a gust of wind claims me.{/i}"
    mct "{i}Repouso perto do céu, mas tenho medo de altura. Vem me resgatar, ó grande aventureiro, antes que uma rajada de vento me leve.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2245
translate brazil ch5sc2_ff96fab9:

#   mct "{i}I have an idea about where it might be.{/i}"
    mct "{i}Tenho uma ideia de onde pode estar.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2248
translate brazil ch5sc2_1de9353a:

#   mct "{i}The highest tower in Luxenford. It's part of the east-wing of the royal palace.{/i}"
    mct "{i}A torre mais alta de Luxemburgo. Faz parte da ala leste do palácio real.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2249
translate brazil ch5sc2_b8005e3a:

#   mct "{i}I guess I'd better get climbing...{/i}"
    mct "{i}Acho melhor eu começar a escalar...{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2252
translate brazil ch5sc2_8b2eca59:

#   mct "{i}Who could have guessed that all those tree-climbing adventures with Alice and Flynn would pay off so well?{/i}"
    mct "{i}Quem poderia imaginar que todas aquelas aventuras de escalada em árvores com Alice e Flynn dariam tão certo?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2253
translate brazil ch5sc2_eed790ab:

#   mct "{i}Certainly never expected them to translate into climbing the royal palace!{/i}"
    mct "{i}Certamente nunca imaginei que isso se traduziria em subir ao palácio real!{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2255
translate brazil ch5sc2_8abde946:

#   mct "{i}Okay, let’s see. If I were a troublesome little fae, where would I hide an enchanted egg?{/i}"
    mct "{i}Certo, vejamos. Se eu fosse uma fainha travessa, onde esconderia um ovo encantado?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2257
translate brazil ch5sc2_18167c82:

#   mct "{i}Hmh... No.{/i}"
    mct "{i}Hum... Não.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2259
translate brazil ch5sc2_1c733b29:

#   mct "{i}Only rubble here...{/i}"
    mct "{i}Aqui só restam escombros...{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2261
translate brazil ch5sc2_df8be1e1:

#   mct "{i}Couple of broken bottles. Some rags. Nothing ...{/i}"
    mct "{i}Algumas garrafas quebradas. Alguns trapos. Nada...{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2263
translate brazil ch5sc2_ba723fc1:

#   mct "{i}*Sigh* Where in the five hells is it?{/i}"
    mct "{i}*Suspiro* Onde diabos fica isso?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2265
translate brazil ch5sc2_dfffcafc:

#   mct "{i}Wait... What’s that? There’s a faint glow coming from the rubble over there.{/i}"
    mct "{i}Espere... O que é aquilo? Há um brilho fraco vindo dos escombros ali.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2267
translate brazil ch5sc2_12eded8f:

#   mct "{i}Hah! Found ya.{/i}"
    mct "{i}Hah! Te achei.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2269
translate brazil ch5sc2_e756f0d6:

#   mct "{i}You’re coming with me, buddy.{/i}"
    mct "{i}Você vem comigo, amigo.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2270
translate brazil ch5sc2_9d9c4449:

#   mct "{i}Sylph better have a good reward for sending me all the way up here.{/i}"
    mct "{i}Sylph merece uma boa recompensa por me mandar até aqui.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2273
translate brazil ch5sc2_e7a632cd:

#   pam "What in all that’s holy are {b}YOU{/b} doing here?!"
    pam "O que em tudo que é sagrado são {b} VOCÊ{/b} O que você está fazendo aqui?!"

# game/chapters/chapter5/script/ch5sc2.rpy:2275
translate brazil ch5sc2_a6f32aef:

#   mc "Amelia?"
    mc "Amélia?"

# game/chapters/chapter5/script/ch5sc2.rpy:2276
translate brazil ch5sc2_bb28b4b6:

#   mct "{i}Shit... this looks bad.{/i}"
    mct "{i}Merda... isso parece ruim.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:2278
translate brazil ch5sc2_5e96f1e3:

#   pam "It’s 'Princess Amelia' to you, scoundrel!"
    pam "É 'Princesa Amelia' para você, seu patife!"

# game/chapters/chapter5/script/ch5sc2.rpy:2280
translate brazil ch5sc2_c6c62a99:

#   pam "I knew you were a good-for-nothing, common charlatan!"
    pam "Eu sabia que você era um charlatão inútil e sem escrúpulos!"

# game/chapters/chapter5/script/ch5sc2.rpy:2282
translate brazil ch5sc2_03669612:

#   pam "You may have tricked my parents into thinking you're just a regular bodyguard with good intentions..."
    pam "Você pode ter enganado meus pais, fazendo-os pensar que você é apenas um guarda-costas comum com boas intenções..."

# game/chapters/chapter5/script/ch5sc2.rpy:2284
translate brazil ch5sc2_d4fe6e5c:

#   pam "But I know your kind! Doing anything to get close to the royal family in hopes of gaining our favor."
    pam "Mas eu conheço a sua laia! Fazem de tudo para se aproximar da família real na esperança de ganhar o nosso favor."

# game/chapters/chapter5/script/ch5sc2.rpy:2286
translate brazil ch5sc2_aac817bf:

#   mc "It’s not what it looks like-"
    mc "Não é o que parece."

# game/chapters/chapter5/script/ch5sc2.rpy:2288
translate brazil ch5sc2_a3071f19:

#   pam "Spare me your excuses! You have no business here, especially at this hour!"
    pam "Poupe-me das suas desculpas! Você não tem nada a fazer aqui, especialmente a esta hora!"

# game/chapters/chapter5/script/ch5sc2.rpy:2289
translate brazil ch5sc2_04d9815e:

#   pam "What are your intentions? Stealing from us, maybe? Or perving at the maids while they’re asleep?"
    pam "Quais são as suas intenções? Roubar de nós, talvez? Ou ficar olhando as empregadas enquanto elas dormem?"

# game/chapters/chapter5/script/ch5sc2.rpy:2291
translate brazil ch5sc2_31546c80:

#   pam "Disgusting! Eck!"
    pam "Que nojo! Credo!"

# game/chapters/chapter5/script/ch5sc2.rpy:2293
translate brazil ch5sc2_fadd9a40:

#   pam "I can’t believe I was being nice to you!"
    pam "Não acredito que estava sendo gentil com você!"

# game/chapters/chapter5/script/ch5sc2.rpy:2295
translate brazil ch5sc2_d9299af4:

#   pam "I even allowed my handmaiden to talk me into giving you a chance!"
    pam "Eu até deixei minha criada me convencer a te dar uma chance!"

# game/chapters/chapter5/script/ch5sc2.rpy:2296
translate brazil ch5sc2_af43bc19:

#   pam "Just wait til I summon the guards."
    pam "Aguarde até eu chamar os guardas."

# game/chapters/chapter5/script/ch5sc2.rpy:2299
translate brazil ch5sc2_9fe5136a:

#   mc "{b}Amelia!!{/b}"
    mc "{b}Amélia!!{/b}"

# game/chapters/chapter5/script/ch5sc2.rpy:2300
translate brazil ch5sc2_4868e647:

#   mc "Can I talk now?"
    mc "Posso falar agora?"

# game/chapters/chapter5/script/ch5sc2.rpy:2302
translate brazil ch5sc2_5382af7e:

#   pam "I-I suppose. If you must."
    pam "Suponho que sim. Se for mesmo necessário."

# game/chapters/chapter5/script/ch5sc2.rpy:2303
translate brazil ch5sc2_528ef3be:

#   pam "Explain yourself, oaf."
    pam "Explique-se, seu idiota."

# game/chapters/chapter5/script/ch5sc2.rpy:2305
translate brazil ch5sc2_f704027b:

#   mc "I’m not here to steal from you, or to perv on anyone..."
    mc "Não estou aqui para roubar de você, nem para ficar olhando para ninguém..."

# game/chapters/chapter5/script/ch5sc2.rpy:2307
translate brazil ch5sc2_6e4eb079:

#   mc "I’m here on behalf of my guild."
    mc "Estou aqui em nome da minha guilda."

# game/chapters/chapter5/script/ch5sc2.rpy:2308
translate brazil ch5sc2_2dee474b:

#   mc "I was looking for an object they'd hidden up here."
    mc "Eu estava procurando um objeto que eles haviam escondido aqui em cima."

# game/chapters/chapter5/script/ch5sc2.rpy:2310
translate brazil ch5sc2_f407f1c9:

#   pam "Why would they hide an object here?"
    pam "Por que eles esconderiam um objeto aqui?"

# game/chapters/chapter5/script/ch5sc2.rpy:2311
translate brazil ch5sc2_1d2f4861:

#   pam "The palace is off-limits to commoners without an invitation."
    pam "O palácio é proibido a pessoas comuns sem convite."

# game/chapters/chapter5/script/ch5sc2.rpy:2313
translate brazil ch5sc2_ba1ab64f:

#   mc "It's part of a scavenger hunt. Apparently, it’s a yearly tradition that our members participate in."
    mc "Faz parte de uma caça ao tesouro. Aparentemente, é uma tradição anual da qual nossos membros participam."

# game/chapters/chapter5/script/ch5sc2.rpy:2314
translate brazil ch5sc2_6f114046:

#   mc "We each have an object to find, and mine happened to be hidden up here."
    mc "Cada um de nós tem um objeto para encontrar, e o meu por acaso estava escondido aqui em cima."

# game/chapters/chapter5/script/ch5sc2.rpy:2316
translate brazil ch5sc2_96080d55:

#   pam "So... you’re not here with ill intent?"
    pam "Então... você não está aqui com más intenções?"

# game/chapters/chapter5/script/ch5sc2.rpy:2317
translate brazil ch5sc2_0dbd81a6:

#   pam "You weren't trying to spy on the ladies of court?"
    pam "Você não estava tentando espionar as damas da corte?"

# game/chapters/chapter5/script/ch5sc2.rpy:2319
translate brazil ch5sc2_832c71da:

#   mc "Amelia, I swear I’m not here to cause any trouble."
    mc "Amelia, eu juro que não estou aqui para causar problemas."

# game/chapters/chapter5/script/ch5sc2.rpy:2321
translate brazil ch5sc2_8345ec51:

#   pam "Hmpfh! ..."
    pam "Hum! ..."

# game/chapters/chapter5/script/ch5sc2.rpy:2323
translate brazil ch5sc2_bae88031:

#   pam "It’s Princess Amelia to you!"
    pam "É Princesa Amelia para você!"

# game/chapters/chapter5/script/ch5sc2.rpy:2325
translate brazil ch5sc2_104a1653:

#   mc "Sorry if I frightened you, Princess Amelia."
    mc "Desculpe se a assustei, Princesa Amélia."

# game/chapters/chapter5/script/ch5sc2.rpy:2326
translate brazil ch5sc2_7063c347:

#   pam "..."
    pam "..."

# game/chapters/chapter5/script/ch5sc2.rpy:2328
translate brazil ch5sc2_3fa3b32e:

#   pam "Fine! ... I won’t report you to the guards."
    pam "Ótimo! ... Não vou denunciá-lo aos guardas."

# game/chapters/chapter5/script/ch5sc2.rpy:2329
translate brazil ch5sc2_6ed9d628:

#   pam "But don’t think to make a habit out of this!"
    pam "Mas não pense em fazer disso um hábito!"

# game/chapters/chapter5/script/ch5sc2.rpy:2330
translate brazil ch5sc2_e5508824:

#   pam "It’s only thanks to my kindness that you aren’t being thrown into the dungeon."
    pam "Só graças à minha bondade você não está sendo jogado na masmorra."

# game/chapters/chapter5/script/ch5sc2.rpy:2332
translate brazil ch5sc2_bb0eeaf4:

#   mc "Thank you."
    mc "Obrigado."

# game/chapters/chapter5/script/ch5sc2.rpy:2333
translate brazil ch5sc2_f8442c96:

#   mc "That’s very generous of you."
    mc "Isso é muito generoso da sua parte."

# game/chapters/chapter5/script/ch5sc2.rpy:2335
translate brazil ch5sc2_20fc12ad:

#   pam "If any of the servants or guards had seen you, they wouldn’t have stopped to ask questions."
    pam "Se algum dos criados ou guardas tivesse te visto, não teria parado para fazer perguntas."

# game/chapters/chapter5/script/ch5sc2.rpy:2337
translate brazil ch5sc2_2466fa3e:

#   mc "I know. I owe you one, Am... Princess."
    mc "Eu sei. Te devo uma, Am... Princesa."

# game/chapters/chapter5/script/ch5sc2.rpy:2341
translate brazil ch5sc2_451f76ff:

#   pam "Tomorrow. First light."
    pam "Amanhã. Primeiro raio de sol."

# game/chapters/chapter5/script/ch5sc2.rpy:2343
translate brazil ch5sc2_11455b53:

#   mc "What?"
    mc "O que?"

# game/chapters/chapter5/script/ch5sc2.rpy:2345
translate brazil ch5sc2_2be93892:

#   pam "I want to go shopping before the streets become too busy."
    pam "Quero ir às compras antes que as ruas fiquem muito movimentadas."

# game/chapters/chapter5/script/ch5sc2.rpy:2346
translate brazil ch5sc2_c571c0cb:

#   pam "You’ll accompany me."
    pam "Você me acompanhará."

# game/chapters/chapter5/script/ch5sc2.rpy:2348
translate brazil ch5sc2_061c396a:

#   mc "You want me to... join you?"
    mc "Você quer que eu... me junte a vocês?"

# game/chapters/chapter5/script/ch5sc2.rpy:2350
translate brazil ch5sc2_3f6d1e9a:

#   pam "......."
    pam "......."

# game/chapters/chapter5/script/ch5sc2.rpy:2353
translate brazil ch5sc2_3e9775e2:

#   pam "I don’t {b}‘WANT’{/b} you to join me! That’s ridiculous."
    pam "Eu não {b}'QUERER'{/b} Você quer se juntar a mim? Isso é ridículo."

# game/chapters/chapter5/script/ch5sc2.rpy:2355
translate brazil ch5sc2_5a5aa6ba:

#   pam "I simply need your services..."
    pam "Eu simplesmente preciso dos seus serviços..."

# game/chapters/chapter5/script/ch5sc2.rpy:2356
translate brazil ch5sc2_064380d5:

#   pam "You’re my bodyguard, and I need someone to carry my stuff."
    pam "Você é meu guarda-costas e preciso de alguém para carregar minhas coisas."

# game/chapters/chapter5/script/ch5sc2.rpy:2358
translate brazil ch5sc2_9930ed4b:

#   mc "Great."
    mc "Ótimo."

# game/chapters/chapter5/script/ch5sc2.rpy:2359
translate brazil ch5sc2_79009c8e:

#   mc "So I’m your maid now?"
    mc "Então agora eu sou sua empregada?"

# game/chapters/chapter5/script/ch5sc2.rpy:2361
translate brazil ch5sc2_af4c4878:

#   pam "Keep moaning about it and I'll find you a proper maid outfit to wear."
    pam "Continue reclamando e eu encontro um uniforme de empregada doméstica adequado para você usar."

# game/chapters/chapter5/script/ch5sc2.rpy:2363
translate brazil ch5sc2_cfc694d4:

#   mc "Fine, fine."
    mc "Tudo bem, tudo bem."

# game/chapters/chapter5/script/ch5sc2.rpy:2364
translate brazil ch5sc2_1bee8ec9:

#   mc "I’ll accompany you to the market tomorrow."
    mc "Amanhã irei com você ao mercado."

# game/chapters/chapter5/script/ch5sc2.rpy:2366
translate brazil ch5sc2_ea8f0bdc:

#   pam "At first light."
    pam "Ao amanhecer."

# game/chapters/chapter5/script/ch5sc2.rpy:2367
translate brazil ch5sc2_bb8ffcd8:

#   pam "And don’t be late!"
    pam "E não se atrase!"

# game/chapters/chapter5/script/ch5sc2.rpy:2369
translate brazil ch5sc2_64630e53:

#   pam "You'd best get out of here before someone sees you."
    pam "É melhor você sair daqui antes que alguém te veja."

# game/chapters/chapter5/script/ch5sc2.rpy:2370
translate brazil ch5sc2_21167fd5:

#   pam "Oh, can I trust that you can get down on your own?"
    pam "Ah, posso confiar que você consegue fazer isso sozinho?"

# game/chapters/chapter5/script/ch5sc2.rpy:2371
translate brazil ch5sc2_ebcaf880:

#   pam "I'm not about to allow you to walk through the castle at this hour."
    pam "Não vou permitir que você circule pelo castelo a esta hora."

# game/chapters/chapter5/script/ch5sc2.rpy:2373
translate brazil ch5sc2_fde241e8:

#   mc "Sure, Princess..."
    mc "Claro, princesa..."

# game/chapters/chapter5/script/ch5sc2.rpy:2374
translate brazil ch5sc2_2d154609:

#   mct "She’s a real piece of work. Although, she could have reacted even worse."
    mct "Ela é uma figura e tanto. Embora, ela pudesse ter reagido ainda pior."

# game/chapters/chapter5/script/ch5sc2.rpy:2375
translate brazil ch5sc2_0cfefef6:

#   mct "The fact she was willing to take me on my word shows she trusts me to an extent."
    mct "O fato de ela ter aceitado minha palavra demonstra que ela confia em mim até certo ponto."

# game/chapters/chapter5/script/ch5sc2.rpy:2376
translate brazil ch5sc2_ebea8780:

#   mct "She has a point, though. I'd better get out of here."
    mct "Ela tem razão. É melhor eu ir embora daqui."

# game/chapters/chapter5/script/ch5sc2.rpy:2382
translate brazil ch5sc2_123b8aa2:

#   mc "*Sigh* I’ve never jumped from this far up before. I could soften the landing using wind magic or..."
    mc "*Suspiro* Nunca pulei de tão alto antes. Eu poderia amortecer a aterrissagem usando magia do vento ou..."

# game/chapters/chapter5/script/ch5sc2.rpy:2383
translate brazil ch5sc2_9bc94fa4:

#   mc "Maybe this would be a good opportunity to test some of Onyx’s abilities?"
    mc "Talvez esta seja uma boa oportunidade para testar algumas das habilidades de Onyx?"

# game/chapters/chapter5/script/ch5sc2.rpy:2384
translate brazil ch5sc2_9c9b2d3c:

#   mc "Onyx?"
    mc "Ônix?"

# game/chapters/chapter5/script/ch5sc2.rpy:2385
translate brazil ch5sc2_1bc3070b:

#   ox "Yes, master?"
    ox "Sim, mestre?"

# game/chapters/chapter5/script/ch5sc2.rpy:2386
translate brazil ch5sc2_76579387:

#   mc "Can you handle a landing from this height?"
    mc "Você consegue aterrissar de uma altura dessas?"

# game/chapters/chapter5/script/ch5sc2.rpy:2387
translate brazil ch5sc2_6cedf08f:

#   ox "Hah! Easily! I can’t believe you'd question my abilities like that."
    ox "Hah! Fácil! Não acredito que você questionaria minhas habilidades dessa forma."

# game/chapters/chapter5/script/ch5sc2.rpy:2390
translate brazil ch5sc2_9ea93f8e:

#   mc "Let’s do it then!"
    mc "Então vamos fazer isso!"

# game/chapters/chapter5/script/ch5sc2.rpy:2398
translate brazil ch5sc2_a9ead49d:

#   mc "Good job, Onyx. I didn’t even feel that landing."
    mc "Bom trabalho, Onyx. Nem senti o pouso."

# game/chapters/chapter5/script/ch5sc2.rpy:2399
translate brazil ch5sc2_94892f5d:

#   ox "You’re welcome, master. It's my top priority to keep you unharmed so our symbiosis can continue."
    ox "De nada, mestre. Minha maior prioridade é mantê-lo ileso para que nossa simbiose possa continuar."

# game/chapters/chapter5/script/ch5sc2.rpy:2400
translate brazil ch5sc2_42826909:

#   mc "Right. Will you be able to handle landings from any height?"
    mc "Certo. Você conseguirá realizar pousos de qualquer altura?"

# game/chapters/chapter5/script/ch5sc2.rpy:2401
translate brazil ch5sc2_5e1e1c9c:

#   ox "Yes, my cells will materialize and cushion your landing to varying degrees, depending on your movement speed and weight."
    ox "Sim, minhas células se materializarão e amortecerão seu pouso em diferentes graus, dependendo da velocidade e do peso do seu movimento."

# game/chapters/chapter5/script/ch5sc2.rpy:2402
translate brazil ch5sc2_f102f93c:

#   ox "Of course, your body is already extremely durable compared to other hosts I’ve had."
    ox "Claro, seu corpo já é extremamente resistente em comparação com outros hospedeiros que já tive."

# game/chapters/chapter5/script/ch5sc2.rpy:2404
translate brazil ch5sc2_cb14d5e7:

#   mc "Yeah, I imagine it is. Let’s get this egg back to Sylph."
    mc "Sim, imagino que sim. Vamos devolver este ovo para Sylph."

# game/chapters/chapter5/script/ch5sc2.rpy:2405
translate brazil ch5sc2_8c7b37a7:

#   ox "Right. What do you think your reward will be?"
    ox "Certo. Qual você acha que será sua recompensa?"

# game/chapters/chapter5/script/ch5sc2.rpy:2407
translate brazil ch5sc2_24d56611:

#   mc "I’m not sure. But after all this, it'd better be damn good."
    mc "Não tenho certeza. Mas depois de tudo isso, é melhor que seja muito bom."

# game/chapters/chapter5/script/ch5sc2.rpy:2411
translate brazil ch5sc2_4cc46fd5:

#   "Sylph greets you eagerly as you enter the guild."
    "Sylph te cumprimenta com entusiasmo quando você entra na guilda."

# game/chapters/chapter5/script/ch5sc2.rpy:2415
translate brazil ch5sc2_07a360cf:

#   sy "Finally! You’re back!"
    sy "Finalmente! Você voltou!"

# game/chapters/chapter5/script/ch5sc2.rpy:2417
translate brazil ch5sc2_c3a2c47b:

#   mc "Finally? Did the others finish already?"
    mc "Finalmente? Os outros já terminaram?"

# game/chapters/chapter5/script/ch5sc2.rpy:2419
translate brazil ch5sc2_ebec101a:

#   sy "No, you’re the first one! Now, let’s see it!"
    sy "Não, você é o primeiro! Agora, vamos ver!"

# game/chapters/chapter5/script/ch5sc2.rpy:2421
translate brazil ch5sc2_8b4402ba:

#   mc "Sure, here you go."
    mc "Claro, aqui está."

# game/chapters/chapter5/script/ch5sc2.rpy:2422
translate brazil ch5sc2_ed563caa:

#   "Sylph takes a quick glance at the egg."
    "Sylph lança um olhar rápido para o ovo."

# game/chapters/chapter5/script/ch5sc2.rpy:2424
translate brazil ch5sc2_2cbcf28c:

#   sy "You really found it! Well done!"
    sy "Você realmente encontrou! Parabéns!"

# game/chapters/chapter5/script/ch5sc2.rpy:2426
translate brazil ch5sc2_4fe93af1:

#   mc "You hid it at the top of the royal palace..."
    mc "Você o escondeu no topo do palácio real..."

# game/chapters/chapter5/script/ch5sc2.rpy:2428
translate brazil ch5sc2_8d57cdfb:

#   sy "Did I? I wasn’t too sure which one I hid where..."
    sy "Será que fiz isso? Não tinha muita certeza de qual eu tinha escondido em qual lugar..."

# game/chapters/chapter5/script/ch5sc2.rpy:2429
translate brazil ch5sc2_dcb18857:

#   mc "Sylph..."
    mc "Sílfide..."

# game/chapters/chapter5/script/ch5sc2.rpy:2431
translate brazil ch5sc2_a89c0ca2:

#   sy "The important thing, is that you completed your task and that I had the utmost faith in you!"
    sy "O importante é que você concluiu sua tarefa e que eu tive total confiança em você!"

# game/chapters/chapter5/script/ch5sc2.rpy:2433
translate brazil ch5sc2_01aa4eb1:

#   mc "*Sighs heavily* You do realize I now have to play bodyguard for the princess ... in just a few hours?"
    mc "*Suspiro pesado* Você percebe que agora terei que bancar o guarda-costas da princesa... em apenas algumas horas?"

# game/chapters/chapter5/script/ch5sc2.rpy:2435
translate brazil ch5sc2_26c00361:

#   sy "The princess? Why? I thought you weren’t due to start until later in the week?"
    sy "A princesa? Por quê? Pensei que você só começaria mais tarde nesta semana."

# game/chapters/chapter5/script/ch5sc2.rpy:2437
translate brazil ch5sc2_6fd45bc2:

#   mc "Yeah... Well, she caught me red-handed. So, it was either appease her or spend the night in a cell."
    mc "É... Bem, ela me pegou em flagrante. Então, ou eu a agradava ou passava a noite na cela."

# game/chapters/chapter5/script/ch5sc2.rpy:2439
translate brazil ch5sc2_a8f0f8e9:

#   sy "I suppose I didn’t account for you being caught... Heh-Heh. My bad!"
    sy "Acho que não levei em conta que você seria pego... Heh-Heh. Foi mal!"

# game/chapters/chapter5/script/ch5sc2.rpy:2441
translate brazil ch5sc2_a318cc7a:

#   sy "But look at the bright side! Now you get to spend more time with the princess! Yup!"
    sy "Mas veja pelo lado bom! Agora você vai poder passar mais tempo com a princesa! Sim!"

# game/chapters/chapter5/script/ch5sc2.rpy:2443
translate brazil ch5sc2_e019981f:

#   mc "How is that a bright side? She’s impossible to get along with..."
    mc "Que lado bom isso pode ter? É impossível conviver com ela..."

# game/chapters/chapter5/script/ch5sc2.rpy:2445
translate brazil ch5sc2_9b9d80d2:

#   sy "Well, try to get through to her? I’m sure she can’t be all bad!"
    sy "Bem, tente falar com ela. Tenho certeza de que ela não é totalmente má!"

# game/chapters/chapter5/script/ch5sc2.rpy:2446
translate brazil ch5sc2_09266445:

#   sy "You realize being in the good graces of the royal family comes with a lot of perks, yeah?"
    sy "Você sabe que ter as boas graças da família real traz muitas vantagens, né?"

# game/chapters/chapter5/script/ch5sc2.rpy:2448
translate brazil ch5sc2_5e510fe6:

#   sy "It can open a lot of doors for you personally, and for the overall prosperity of the guild."
    sy "Isso pode abrir muitas portas para você pessoalmente e para a prosperidade geral da guilda."

# game/chapters/chapter5/script/ch5sc2.rpy:2450
translate brazil ch5sc2_7e4c5951:

#   mc "Hmh. I suppose you’ve got a point."
    mc "Hum. Acho que você tem razão."

# game/chapters/chapter5/script/ch5sc2.rpy:2452
translate brazil ch5sc2_1fa4ff76:

#   sy "I knew you’d see reason! Yup!"
    sy "Eu sabia que você ia entender! Sim!"

# game/chapters/chapter5/script/ch5sc2.rpy:2454
translate brazil ch5sc2_af13c005:

#   mc "Yeah, yeah. So, did you want to talk about what’s been bothering you?"
    mc "Sim, sim. Então, você queria falar sobre o que está te incomodando?"

# game/chapters/chapter5/script/ch5sc2.rpy:2456
translate brazil ch5sc2_7b7d9441:

#   sy "Uh-Huh! In fact, I was hoping you’d be the first one back so we could have a moment alone."
    sy "Uhum! Na verdade, eu estava esperando que você fosse o primeiro a voltar para que pudéssemos ter um momento a sós."

# game/chapters/chapter5/script/ch5sc2.rpy:2457
translate brazil ch5sc2_3ee748e4:

#   sy "Follow me!"
    sy "Me siga!"

# game/chapters/chapter5/script/ch5sc2.rpy:2459
translate brazil ch5sc2_67740d68:

#   "Sylph leads you down a hallway with several doors. She opens the one at the end, and you both go downstairs."
    "Sylph te conduz por um corredor com várias portas. Ela abre a última porta e vocês dois descem as escadas."

# game/chapters/chapter5/script/ch5sc2.rpy:2461
translate brazil ch5sc2_f1b87945:

#   sy "*Excitedly* Come! Come! We’re almost there!"
    sy "*Com entusiasmo* Venham! Venham! Já estamos quase lá!"

# game/chapters/chapter5/script/ch5sc2.rpy:2463
translate brazil ch5sc2_5e5bcf23:

#   mc "Sylph... Where are we going? Are you leading me into some sort of dungeon?"
    mc "Sylph... Para onde estamos indo? Você está me levando para algum tipo de masmorra?"

# game/chapters/chapter5/script/ch5sc2.rpy:2465
translate brazil ch5sc2_cb7e0283:

#   sy "*Giggling* Dungeon? Yes! My secret sex dungeon! Heh-heh-heh!"
    sy "*Risos* Masmorra? Sim! Minha masmorra secreta de sexo! Heh-heh-heh!"

# game/chapters/chapter5/script/ch5sc2.rpy:2466
translate brazil ch5sc2_424ac1ce:

#   sy "I've prepared it just for you! Prepare to be my slave! Heh-heh-heh!"
    sy "Preparei isso especialmente para você! Prepare-se para ser meu escravo! Heh-heh-heh!"

# game/chapters/chapter5/script/ch5sc2.rpy:2468
translate brazil ch5sc2_82c082a8:

#   mc "*Sighs* Sylph..."
    mc "*Suspiros* Sylph..."

# game/chapters/chapter5/script/ch5sc2.rpy:2469
translate brazil ch5sc2_826ddcd9:

#   sy "Kidding! Boo! Now, come on. I have something to show you!"
    sy "Brincadeirinha! Buuu! Agora, vamos lá. Tenho algo para te mostrar!"

# game/chapters/chapter5/script/ch5sc2.rpy:2470
translate brazil ch5sc2_c3ed18b0:

#   "You follow Sylph to the back of the room."
    "Você segue Sylph até o fundo da sala."

# game/chapters/chapter5/script/ch5sc2.rpy:2472
translate brazil ch5sc2_45dfc882:

#   sy "Tadaa! Whatcha think?"
    sy "Ta-da! O que você acha?"

# game/chapters/chapter5/script/ch5sc2.rpy:2474
translate brazil ch5sc2_c18bb2ca:

#   sy "Isn’t it cute? Sit, sit!"
    sy "Que gracinha, né? Senta, senta!"

# game/chapters/chapter5/script/ch5sc2.rpy:2476
translate brazil ch5sc2_bdcf6f3d:

#   mc "Sure, it’s... cute? But why down here in the basement?"
    mc "Claro, é... bonitinho? Mas por que aqui embaixo, no porão?"

# game/chapters/chapter5/script/ch5sc2.rpy:2477
translate brazil ch5sc2_bd14eb39:

#   sy "Aiiyh! These stools are pretty cold!"
    sy "Ai, que frio! Esses bancos estão bem gelados!"

# game/chapters/chapter5/script/ch5sc2.rpy:2479
translate brazil ch5sc2_cbcbe44e:

#   mc "Well, we are in a basement... and you aren’t known for excessive clothing, so..."
    mc "Bem, estamos em um porão... e você não é conhecida por usar roupas em excesso, então..."

# game/chapters/chapter5/script/ch5sc2.rpy:2481
translate brazil ch5sc2_0c93ae61:

#   sy "My, my! Been keeping an eye on how I dress, have you? Mhm-Hmm!"
    sy "Nossa! Você anda de olho em como eu me visto, né? Hum-hum!"

# game/chapters/chapter5/script/ch5sc2.rpy:2483
translate brazil ch5sc2_5347c4f5:

#   mc "You know what I mean..."
    mc "Você sabe o que eu quero dizer..."

# game/chapters/chapter5/script/ch5sc2.rpy:2485
translate brazil ch5sc2_81abb7bd:

#   sy "Mhm, I do. I like a man who pays attention."
    sy "Sim, sim. Gosto de homens que prestam atenção."

# game/chapters/chapter5/script/ch5sc2.rpy:2487
translate brazil ch5sc2_3d52ad3a:

#   sy "And to answer your question, I chose the basement 'cause we can be alone here."
    sy "E para responder à sua pergunta, escolhi o porão porque podemos ficar sozinhos aqui."

# game/chapters/chapter5/script/ch5sc2.rpy:2489
translate brazil ch5sc2_bcf6df02:

#   sy "Without being... interrupted."
    sy "Sem ser... interrompido."

# game/chapters/chapter5/script/ch5sc2.rpy:2491
translate brazil ch5sc2_c71993bd:

#   mc "Don’t people come down here to get stuff?"
    mc "As pessoas não vêm aqui para comprar coisas?"

# game/chapters/chapter5/script/ch5sc2.rpy:2493
translate brazil ch5sc2_1cd37fd6:

#   sy "I’m the only one who handles storage in the guild. Besides, ever since the guild declined..."
    sy "Sou o único responsável pelo armazenamento na guilda. Além disso, desde que a guilda entrou em declínio..."

# game/chapters/chapter5/script/ch5sc2.rpy:2494
translate brazil ch5sc2_ac50478f:

#   sy "We've barely used some of our facilities."
    sy "Quase não utilizamos algumas de nossas instalações."

# game/chapters/chapter5/script/ch5sc2.rpy:2496
translate brazil ch5sc2_9b3eea35:

#   mc "Facilities?"
    mc "Instalações?"

# game/chapters/chapter5/script/ch5sc2.rpy:2498
translate brazil ch5sc2_ad7be703:

#   sy "We used to have all sorts of facilities available."
    sy "Antes tínhamos à disposição todo tipo de facilidade."

# game/chapters/chapter5/script/ch5sc2.rpy:2500
translate brazil ch5sc2_518e486e:

#   sy "Like this storage cellar for all sorts of goods, for example."
    sy "Como esta adega para armazenar todo tipo de mercadoria, por exemplo."

# game/chapters/chapter5/script/ch5sc2.rpy:2502
translate brazil ch5sc2_7faea3c5:

#   sy "Or the dining hall we use for feasts, social gatherings, or just keeping our hungry adventurers fed!"
    sy "Ou o refeitório que usamos para banquetes, encontros sociais ou simplesmente para alimentar nossos aventureiros famintos!"

# game/chapters/chapter5/script/ch5sc2.rpy:2504
translate brazil ch5sc2_af5d4a2c:

#   sy "And then there are the dormitories, where ranked members of the guild can stay."
    sy "E depois há os dormitórios, onde os membros graduados da guilda podem ficar."

# game/chapters/chapter5/script/ch5sc2.rpy:2506
translate brazil ch5sc2_e4ab3823:

#   sy "There's even a small yard out back that we used for combat practise."
    sy "Há até um pequeno quintal nos fundos que usávamos para treinamento de combate."

# game/chapters/chapter5/script/ch5sc2.rpy:2507
translate brazil ch5sc2_607281e8:

#   sy "With the way things have been going since you joined, I hope we’ll soon be able to restore those areas eventually."
    sy "Com a forma como as coisas têm ido desde que você entrou, espero que em breve possamos restaurar essas áreas."

# game/chapters/chapter5/script/ch5sc2.rpy:2509
translate brazil ch5sc2_3c62a97b:

#   mc "With all the work everyone's been putting in, I have a feeling we’ll get the guild back in top shape in no time."
    mc "Com todo o trabalho que todos têm feito, tenho a sensação de que vamos colocar a guilda de volta em plena forma em pouco tempo."

# game/chapters/chapter5/script/ch5sc2.rpy:2511
translate brazil ch5sc2_4211d9e6:

#   sy "Yes! You’re right! That’s what I keep telling everyone!"
    sy "Sim! Você tem razão! É isso que eu sempre digo para todo mundo!"

# game/chapters/chapter5/script/ch5sc2.rpy:2512
translate brazil ch5sc2_dd891651:

#   sy "Soon we'll be better than ever before!"
    sy "Em breve estaremos melhores do que nunca!"

# game/chapters/chapter5/script/ch5sc2.rpy:2514
translate brazil ch5sc2_a266f48a:

#   mc "I’ve even noticed a decent increase in non-ranking adventurers taking on the smaller contracts."
    mc "Tenho notado até um aumento considerável no número de aventureiros sem classificação que aceitam contratos menores."

# game/chapters/chapter5/script/ch5sc2.rpy:2516
translate brazil ch5sc2_c56a78f5:

#   sy "Yeah, word has been spreading about the guild's improving health. And that's drawn lots of newcomers!"
    sy "Sim, a notícia de que a guilda está melhorando tem se espalhado. E isso atraiu muitos novatos!"

# game/chapters/chapter5/script/ch5sc2.rpy:2518
translate brazil ch5sc2_d2795cc4:

#   mc "It's nice. Being able to talk with you like this again..."
    mc "É ótimo poder conversar com você assim de novo..."

# game/chapters/chapter5/script/ch5sc2.rpy:2520
translate brazil ch5sc2_c4430d67:

#   mc "I felt like I'd lost a friend when you were avoiding me."
    mc "Senti como se tivesse perdido um amigo quando você começou a me evitar."

# game/chapters/chapter5/script/ch5sc2.rpy:2521
translate brazil ch5sc2_5c2c7bcf:

#   sy "..."
    sy "..."

# game/chapters/chapter5/script/ch5sc2.rpy:2523
translate brazil ch5sc2_eae3f95e:

#   sy "You never lost me... I just needed a little time."
    sy "Você nunca me perdeu... Eu só precisava de um pouco de tempo."

# game/chapters/chapter5/script/ch5sc2.rpy:2524
translate brazil ch5sc2_760c7482:

#   sy "I’m sorry. I should’ve just talked about how I was feeling as soon as you came back."
    sy "Me desculpe. Eu deveria ter falado sobre como eu estava me sentindo assim que você voltou."

# game/chapters/chapter5/script/ch5sc2.rpy:2526
translate brazil ch5sc2_ee50c234:

#   mc "It’s okay. We’re talking now, and that’s what matters."
    mc "Está tudo bem. Estamos conversando agora, e isso é o que importa."

# game/chapters/chapter5/script/ch5sc2.rpy:2527
translate brazil ch5sc2_e9158972:

#   mc "Eliza told me a little about what upset you. But I'd like to hear about it from you."
    mc "Eliza me contou um pouco sobre o que te incomodou. Mas eu gostaria de ouvir isso de você."

# game/chapters/chapter5/script/ch5sc2.rpy:2529
translate brazil ch5sc2_dc4c6609:

#   sy "Mhm. Okay. I suppose we can’t dance around it forever."
    sy "Hum. Certo. Acho que não podemos ficar enrolando para sempre."

# game/chapters/chapter5/script/ch5sc2.rpy:2533
translate brazil ch5sc2_d1116d34:

#   sy "When Eliza told me that you were half-angel..."
    sy "Quando Eliza me disse que você era meio anjo..."

# game/chapters/chapter5/script/ch5sc2.rpy:2537
translate brazil ch5sc2_40db2fff:

#   sy "It triggered some memories and deep emotions within me that I thought I had long-since buried."
    sy "Isso despertou em mim memórias e emoções profundas que eu pensava ter enterrado há muito tempo."

# game/chapters/chapter5/script/ch5sc2.rpy:2539
translate brazil ch5sc2_9686cdb9:

#   sy "But they all came rushing to the surface. The guy I..."
    sy "Mas todos eles vieram à tona de repente. O cara que eu..."

# game/chapters/chapter5/script/ch5sc2.rpy:2541
translate brazil ch5sc2_917c47a9:

#   sy "My friend... turns out to be the same kind of being as one that once caused me so much pain and anguish."
    sy "Meu amigo... acabou sendo o mesmo tipo de ser que me causou tanta dor e angústia."

# game/chapters/chapter5/script/ch5sc2.rpy:2543
translate brazil ch5sc2_386d2649:

#   mc "What happened to cause you such turmoil, Sylph?"
    mc "O que aconteceu para lhe causar tanta angústia, Sylph?"

# game/chapters/chapter5/script/ch5sc2.rpy:2545
translate brazil ch5sc2_7747bd4c:

#   sy "When I was just a young fae, something... terrible happened to my home. To my whole village."
    sy "Quando eu era apenas uma jovem fada, algo... terrível aconteceu com minha casa. Com toda a minha aldeia."

# game/chapters/chapter5/script/ch5sc2.rpy:2546
translate brazil ch5sc2_4f9eeee9:

#   sy "We lived deep in a secluded forest, like most fae communities. We had nothing but peace and an idyllic life for many centuries."
    sy "Vivíamos no coração de uma floresta isolada, como a maioria das comunidades feéricas. Durante muitos séculos, tivemos apenas paz e uma vida idílica."

# game/chapters/chapter5/script/ch5sc2.rpy:2548
translate brazil ch5sc2_5dc0a7ed:

#   sy "But one day, it all changed. One of us became obsessed with dark magic..."
    sy "Mas um dia, tudo mudou. Um de nós ficou obcecado por magia negra..."

# game/chapters/chapter5/script/ch5sc2.rpy:2550
translate brazil ch5sc2_dbe58be7:

#   sy "Chaos magic, to be specific. She became fixated on trying to bring her stillborn child back to life."
    sy "Magia do caos, para ser mais específica. Ela ficou obcecada em tentar trazer seu filho natimorto de volta à vida."

# game/chapters/chapter5/script/ch5sc2.rpy:2552
translate brazil ch5sc2_f6b1b1b7:

#   sy "We all tried to convince her not to go near that type of magic. It only ever brings horror."
    sy "Todos nós tentamos convencê-la a ficar longe desse tipo de magia. Ela só traz horror."

# game/chapters/chapter5/script/ch5sc2.rpy:2554
translate brazil ch5sc2_25bf65d0:

#   sy "But she was so consumed by her grief, and we suspected that she kept practicing the magic in secret."
    sy "Mas ela estava tão consumida pela dor, e suspeitávamos que continuava praticando magia em segredo."

# game/chapters/chapter5/script/ch5sc2.rpy:2556
translate brazil ch5sc2_0c718641:

#   sy "One day, I went exploring and gathering edibles in the surrounding area, as I so often did back then."
    sy "Certo dia, saí para explorar e colher alimentos na área circundante, como costumava fazer naquela época."

# game/chapters/chapter5/script/ch5sc2.rpy:2558
translate brazil ch5sc2_1ee67ac4:

#   sy "And that turned out to be what saved me. Because that was the day... that everything ended."
    sy "E foi isso que acabou me salvando. Porque foi naquele dia... que tudo terminou."

# game/chapters/chapter5/script/ch5sc2.rpy:2559
translate brazil ch5sc2_2033f053:

#   sy "While I was on my way back, I saw a sudden, massive golden explosion in the distance."
    sy "Enquanto eu voltava, vi uma explosão dourada repentina e enorme à distância."

# game/chapters/chapter5/script/ch5sc2.rpy:2560
translate brazil ch5sc2_2302176c:

#   sy "It shook the ground, the trees, and everything in-between."
    sy "O tremor fez o chão, as árvores e tudo o que havia entre eles tremer."

# game/chapters/chapter5/script/ch5sc2.rpy:2562
translate brazil ch5sc2_329d1588:

#   sy "I flew as fast as I could! It felt like my wings would fall off. But when I arrived..."
    sy "Voei o mais rápido que pude! Parecia que minhas asas iam cair. Mas quando cheguei..."

# game/chapters/chapter5/script/ch5sc2.rpy:2564
translate brazil ch5sc2_3bb66e1a:

#   sy "I remember how my heart sank to the bottom of my belly. Everything was just... gone."
    sy "Lembro-me da sensação de aperto no coração. Tudo simplesmente... desapareceu."

# game/chapters/chapter5/script/ch5sc2.rpy:2566
translate brazil ch5sc2_da956fbb:

#   sy "Our houses... the trees... everything had been vaporized. Only a few scattered and charred fragments remained."
    sy "Nossas casas... as árvores... tudo havia sido vaporizado. Restaram apenas alguns fragmentos carbonizados e dispersos."

# game/chapters/chapter5/script/ch5sc2.rpy:2569
translate brazil ch5sc2_50af6dae:

#   sy "Everyone... My friends... M-My family!"
    sy "Todos... Meus amigos... M-Minha família!"

# game/chapters/chapter5/script/ch5sc2.rpy:2570
translate brazil ch5sc2_494f5a11:

#   sy "All that was left were a few smoking husks, unrecognizable, lifeless burned bodies."
