# game/chapters/chapter5/script/ch5sc2.rpy:151
translate brazil ch5sc2_c7548823_1:

#   el "*Sobs* I can’t! I c-can’t! I can’t be like this!"
    el "*Soluços* Eu não consigo! Eu n-não consigo! Eu não posso ser assim!"

# game/chapters/chapter5/script/ch5sc2.rpy:152
translate brazil ch5sc2_8ded998b_1:

#   el "No-n-no-No, no! {b}NO!{/b}"
    el "Não, não, não, não! {b} NÃO!{/b}"

