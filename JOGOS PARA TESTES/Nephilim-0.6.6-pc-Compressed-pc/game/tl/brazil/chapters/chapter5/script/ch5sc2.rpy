translate brazil ch5sc2_21dd774b:

#   fy "What happens if we find someone else’s egg?"
    fy "O que acontece se encontrarmos o ovo de outra pessoa?"

# game/chapters/chapter5/script/ch5sc2.rpy:1518
translate brazil ch5sc2_7b519a26:

#   sy "You’ll be electrocuted!"
    sy "Você vai levar um choque elétrico!"

# game/chapters/chapter5/script/ch5sc2.rpy:1521
translate brazil ch5sc2_173f4676:

#   sy "So don’t even think about any funny business!"
    sy "Então nem pense em fazer nenhuma gracinha!"

# game/chapters/chapter5/script/ch5sc2.rpy:1523
translate brazil ch5sc2_13f85f44:

#   fy "Yikes. She’s pretty scary for such a small thing."
    fy "Nossa! Ela é bem assustadora para uma coisinha tão pequena."

# game/chapters/chapter5/script/ch5sc2.rpy:1525
translate brazil ch5sc2_638c2c38:

#   br "Lass, how do we know which egg is ours?"
    br "Menina, como sabemos qual ovo é nosso?"

# game/chapters/chapter5/script/ch5sc2.rpy:1526
translate brazil ch5sc2_f9303827:

#   sy "The likelihood of you finding someone else’s egg is incredibly low."
    sy "A probabilidade de você encontrar o ovo de outra pessoa é incrivelmente baixa."

# game/chapters/chapter5/script/ch5sc2.rpy:1527
translate brazil ch5sc2_e3c1bb94:

#   sy "You'll each be given your own clue-"
    sy "Cada um de vocês receberá sua própria pista."

# game/chapters/chapter5/script/ch5sc2.rpy:1529
translate brazil ch5sc2_9c8247f9:

#   sy "-Which is specific to your egg only."
    sy "-O que é específico apenas para o seu ovo."

# game/chapters/chapter5/script/ch5sc2.rpy:1531
translate brazil ch5sc2_c3777a73:

#   al "Since this is a scavenger hunt... will there be prizes?"
    al "Já que se trata de uma caça ao tesouro... haverá prêmios?"

# game/chapters/chapter5/script/ch5sc2.rpy:1533
translate brazil ch5sc2_26bd0f7b:

#   fy "Oh, please say it’s a full evening ticket to ‘The Velvet Pearl’ or ‘Midnight’s Delights’!"
    fy "Ah, por favor, diga que é um ingresso para a noite toda para 'The Velvet Pearl' ou 'Midnight's Delights'!"

# game/chapters/chapter5/script/ch5sc2.rpy:1535
translate brazil ch5sc2_4a5c869a:

#   sy "Keep dreaming, junior!"
    sy "Continue sonhando, garoto!"

# game/chapters/chapter5/script/ch5sc2.rpy:1536
translate brazil ch5sc2_5952f126:

#   sy "There won’t be any midnight delights or velvet pearls when I’m through with you."
    sy "Não haverá mais delícias da meia-noite nem pérolas de veludo quando eu terminar com você."

# game/chapters/chapter5/script/ch5sc2.rpy:1538
translate brazil ch5sc2_d63b3113:

#   fy "I was merely jesting..."
    fy "Eu estava apenas brincando..."

# game/chapters/chapter5/script/ch5sc2.rpy:1541
translate brazil ch5sc2_5dba693a:

#   sy "Yes, there will be prizes for anyone who finds their egg. It’s not a race either."
    sy "Sim, haverá prêmios para quem encontrar seu ovo. E não é uma corrida."

# game/chapters/chapter5/script/ch5sc2.rpy:1542
translate brazil ch5sc2_e3c7deef:

#   sy "All that matters is that you find your egg, and bring it back here before dawn for your reward."
    sy "O importante é que você encontre seu ovo e o traga de volta aqui antes do amanhecer para receber sua recompensa."

# game/chapters/chapter5/script/ch5sc2.rpy:1544
translate brazil ch5sc2_d3787c72:

#   sy "Okay. One by one, speak with me at the door as you leave and I’ll give you your clue!"
    sy "Certo. Um por um, falem comigo na porta ao saírem e eu darei a dica para vocês!"

# game/chapters/chapter5/script/ch5sc2.rpy:1547
translate brazil ch5sc2_d6142794:

#   sy "*Inaudible whisper*"
    sy "*Sussurro inaudível*"

# game/chapters/chapter5/script/ch5sc2.rpy:1551
translate brazil ch5sc2_248ab664:

#   al "*Whispers* {size=-10}{b}I’ll wait for you outside, okay?{/b}{/size}"
    al "*Sussurros* {size=-10}{b}Vou te esperar lá fora, tá bom?{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1553
translate brazil ch5sc2_bb4f6954:

#   mc "*Whispers* {size=-10}{b}We aren’t allowed to work together.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Não nos é permitido trabalhar juntos.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1555
translate brazil ch5sc2_1c9b90c4:

#   al "*Whispers* {size=-10}{b}I know, but I have something I want to show you.{/b}{/size}"
    al "*Sussurros* {size=-10}{b}Eu sei, mas tenho algo que quero te mostrar.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1559
translate brazil ch5sc2_032bfb02:

#   sy "Okay, your clue is..."
    sy "Certo, a sua dica é..."

# game/chapters/chapter5/script/ch5sc2.rpy:1561
translate brazil ch5sc2_e8eca17d:

#   sy "I rest near the sky but I'm afraid of heights-"
    sy "Eu descanso perto do céu, mas tenho medo de altura."

# game/chapters/chapter5/script/ch5sc2.rpy:1562
translate brazil ch5sc2_06ed2327:

#   sy "Come rescue me, oh great adventurer, before a gust of wind claims me."
    sy "Vem me resgatar, ó grande aventureiro, antes que uma rajada de vento me leve."

# game/chapters/chapter5/script/ch5sc2.rpy:1564
translate brazil ch5sc2_7e2c247e:

#   mc "You really put a lot of effort into this, huh?"
    mc "Você se esforçou bastante nisso, hein?"

# game/chapters/chapter5/script/ch5sc2.rpy:1565
translate brazil ch5sc2_22d6a0f0:

#   syt "{i}He... He noticed?{/i}"
    syt "{i}Ele... Ele percebeu?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1567
translate brazil ch5sc2_99a79878:

#   sy "Sure did! I’m thrilled beyond belief that we're able to continue our traditions with you guys!"
    sy "Com certeza! Estou extremamente feliz por podermos continuar nossas tradições com vocês!"

# game/chapters/chapter5/script/ch5sc2.rpy:1569
translate brazil ch5sc2_75e8b2b6:

#   sy "Things were looking mighty grim at the start of the year, but then you guys came along."
    sy "As coisas pareciam muito sombrias no início do ano, mas aí vocês apareceram."

# game/chapters/chapter5/script/ch5sc2.rpy:1571
translate brazil ch5sc2_4b12a155:

#   sy "And now, look at how our little family has grown!"
    sy "E agora, veja como nossa pequena família cresceu!"

# game/chapters/chapter5/script/ch5sc2.rpy:1572
translate brazil ch5sc2_0add243e:

#   sy "The guild is prosperous for the first time in a long time!"
    sy "A guilda está prosperando pela primeira vez em muito tempo!"

# game/chapters/chapter5/script/ch5sc2.rpy:1573
translate brazil ch5sc2_5a489ad6:

#   sy "We’ve all come together and put in a lot of work, I’m... I’m really glad you’re back."
    sy "Nos unimos e trabalhamos muito, eu... eu estou muito feliz que você esteja de volta."

# game/chapters/chapter5/script/ch5sc2.rpy:1575
translate brazil ch5sc2_b02d3efc:

#   sy "I should have said that the moment you got back."
    sy "Eu deveria ter dito isso assim que você voltou."

# game/chapters/chapter5/script/ch5sc2.rpy:1576
translate brazil ch5sc2_50dc98d4:

#   sy "Let’s talk once you find the egg? Just the two of us."
    sy "Vamos conversar quando você encontrar o ovo? Só nós dois."

# game/chapters/chapter5/script/ch5sc2.rpy:1578
translate brazil ch5sc2_3c7284fe:

#   mc "Let’s do that."
    mc "Vamos fazer isso."

# game/chapters/chapter5/script/ch5sc2.rpy:1579
translate brazil ch5sc2_f5c11afe:

#   mc "We’re overdue for some one on one time."
    mc "Já faz tempo que precisamos de um tempo a sós."

# game/chapters/chapter5/script/ch5sc2.rpy:1581
translate brazil ch5sc2_6370cf1d:

#   sy "Yes!! I’d like that very much!"
    sy "Sim!! Eu gostaria muito disso!"

# game/chapters/chapter5/script/ch5sc2.rpy:1583
translate brazil ch5sc2_cea62380:

#   sy "Now, go find your egg!"
    sy "Agora, vá encontrar seu ovo!"

# game/chapters/chapter5/script/ch5sc2.rpy:1584
translate brazil ch5sc2_eefaae6a:

#   sy "And I'll make sure to have your reward ready for you."
    sy "E eu vou garantir que sua recompensa esteja pronta para você."

# game/chapters/chapter5/script/ch5sc2.rpy:1593
translate brazil ch5sc2_1aa2db4a:

#   mc "There you are."
    mc "Aqui está."

# game/chapters/chapter5/script/ch5sc2.rpy:1594
translate brazil ch5sc2_77d00809:

#   mc "What did you want to show me?"
    mc "O que você queria me mostrar?"

# game/chapters/chapter5/script/ch5sc2.rpy:1596
translate brazil ch5sc2_045ee19c:

#   al "I won’t be able to show you here. Come with me?"
    al "Não poderei te mostrar aqui. Vem comigo?"

# game/chapters/chapter5/script/ch5sc2.rpy:1598
translate brazil ch5sc2_7356f408:

#   mc "Consider me intrigued..."
    mc "Estou intrigado..."

# game/chapters/chapter5/script/ch5sc2.rpy:1600
translate brazil ch5sc2_dc7d1f31:

#   al "..."
    al "..."

# game/chapters/chapter5/script/ch5sc2.rpy:1601
translate brazil ch5sc2_6e1fa566:

#   mc "I remember that look."
    mc "Eu me lembro daquele olhar."

# game/chapters/chapter5/script/ch5sc2.rpy:1602
translate brazil ch5sc2_61f6f28f:

#   mc "You’re up to something mischievous."
    mc "Você está aprontando alguma travessura."

# game/chapters/chapter5/script/ch5sc2.rpy:1604
translate brazil ch5sc2_4527be04:

#   al "It’s better if I just show you... let’s go!"
    al "É melhor eu te mostrar... vamos lá!"

# game/chapters/chapter5/script/ch5sc2.rpy:1606
translate brazil ch5sc2_80dfb9c5:

#   mc "Where are we going, Alice? Sylph said we have to find the eggs before dawn..."
    mc "Para onde vamos, Alice? Sylph disse que temos que encontrar os ovos antes do amanhecer..."

# game/chapters/chapter5/script/ch5sc2.rpy:1607
translate brazil ch5sc2_ff2ad4ee:

#   al "Exactly! That leaves us with plenty of time for a little detour!"
    al "Exatamente! Isso nos deixa com bastante tempo para um pequeno desvio!"

# game/chapters/chapter5/script/ch5sc2.rpy:1609
translate brazil ch5sc2_b2722ca2:

#   mct "{i}Her hand is a little sweaty, is she... nervous?{/i}"
    mct "{i}A mão dela está um pouco suada, será que ela está... nervosa?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1610
translate brazil ch5sc2_8b31a196:

#   mct "{i}We held hands so often when we were younger... this feels different.{/i}"
    mct "{i}Quando éramos mais jovens, dávamos as mãos com tanta frequência... agora a sensação é diferente.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1612
translate brazil ch5sc2_8e8c05c8:

#   mc "Okay, lead on."
    mc "Certo, vamos em frente."

# game/chapters/chapter5/script/ch5sc2.rpy:1613
translate brazil ch5sc2_693d6a6a:

#   al "Don’t worry. It’s going to be awesome! You’ll see!"
    al "Não se preocupe. Vai ser incrível! Você vai ver!"

# game/chapters/chapter5/script/ch5sc2.rpy:1622
translate brazil ch5sc2_7662266b:

#   al "Tadaa! What do you think?"
    al "Ta-da! O que você acha?"

# game/chapters/chapter5/script/ch5sc2.rpy:1623
translate brazil ch5sc2_947bc759:

#   mc "It’s a nice room... But why are you showing me a room at the academy?"
    mc "É um quarto bonito... Mas por que você está me mostrando um quarto na academia?"

# game/chapters/chapter5/script/ch5sc2.rpy:1625
translate brazil ch5sc2_2ce6b58d:

#   al "Guess! *Giggles softly*"
    al "Adivinha! *Risinhos suaves*"

# game/chapters/chapter5/script/ch5sc2.rpy:1627
translate brazil ch5sc2_e29b4f7b:

#   mc "Wait... Don’t tell me this is-... {b}YOUR ROOM?{/b}"
    mc "Espere... Não me diga que isso é... {b} SEU QUARTO?{/b}"

# game/chapters/chapter5/script/ch5sc2.rpy:1629
translate brazil ch5sc2_27b3612a:

#   al "Winner, winner! Someone buy this man a fancy dinner!"
    al "Vencedor, vencedor! Alguém pague um jantar chique para esse homem!"

# game/chapters/chapter5/script/ch5sc2.rpy:1630
translate brazil ch5sc2_571891e7:

#   al "Isn't it great? It's all mine!"
    al "Não é ótimo? É tudo meu!"

# game/chapters/chapter5/script/ch5sc2.rpy:1633
translate brazil ch5sc2_3c18b379:

#   mc "Alice! This is amazing! I’m... I’m happy for you!"
    mc "Alice! Isso é incrível! Eu... eu estou feliz por você!"

# game/chapters/chapter5/script/ch5sc2.rpy:1634
translate brazil ch5sc2_1b5e0a59:

#   al "*Giggling* Aiiih! [mc]! Careful, hahaha!"
    al "*Risos* Aiiih! [mc] Cuidado, hahaha!"

# game/chapters/chapter5/script/ch5sc2.rpy:1636
translate brazil ch5sc2_83b58197:

#   mc "But... how? There’s no way you can afford this?"
    mc "Mas... como? Não tem como você conseguir pagar isso?"

# game/chapters/chapter5/script/ch5sc2.rpy:1638
translate brazil ch5sc2_39990694:

#   al "My professor, Miss Venetos, she promoted me to assistant student and arranged for me to get this room."
    al "Minha professora, a Srta. Venetos, me promoveu a aluna assistente e providenciou este quarto para mim."

# game/chapters/chapter5/script/ch5sc2.rpy:1639
translate brazil ch5sc2_c5fd2555:

#   al "Pretty cool, huh?"
    al "Bem legal, né?"

# game/chapters/chapter5/script/ch5sc2.rpy:1641
translate brazil ch5sc2_4b01d829:

#   mc "Yeah. I’m proud of you, Alice. Your hard work is paying off."
    mc "Sim. Estou orgulhoso de você, Alice. Seu esforço está valendo a pena."

# game/chapters/chapter5/script/ch5sc2.rpy:1643
translate brazil ch5sc2_18cbbfa8:

#   al_t "{i}I love being in his arms like this...{/i}"
    al_t "{i}Adoro estar em seus braços assim...{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1645
translate brazil ch5sc2_c701ce34:

#   al "Maybe... I could get a reward? You know, for doing so well?"
    al "Talvez... eu pudesse ganhar uma recompensa? Sabe, por ter me saído tão bem?"

# game/chapters/chapter5/script/ch5sc2.rpy:1647
translate brazil ch5sc2_56a5a1a3:

#   mc "You’ve definitely earned it. What would you like?"
    mc "Você definitivamente merece. O que você gostaria?"

# game/chapters/chapter5/script/ch5sc2.rpy:1648
translate brazil ch5sc2_61b8091b:

#   al "......"
    al "......"

# game/chapters/chapter5/script/ch5sc2.rpy:1650
translate brazil ch5sc2_9b6b554d:

#   al "*Blushing* A... kiss?"
    al "*Corando* Um... beijo?"

# game/chapters/chapter5/script/ch5sc2.rpy:1655
translate brazil ch5sc2_eece620b:

#   mc "Come here you little cutie."
    mc "Vem cá, minha gracinha."

# game/chapters/chapter5/script/ch5sc2.rpy:1658
translate brazil ch5sc2_b086bc84:

#   al "MMhhh-... Mh-Mh!"
    al "Mmmhh-... Mh-Mh!"

# game/chapters/chapter5/script/ch5sc2.rpy:1659
translate brazil ch5sc2_5545b12d:

#   mct "{i}Her lips are made for kissing... large and perfectly soft.{/i}"
    mct "{i}Seus lábios são feitos para beijar... grandes e perfeitamente macios.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1661
translate brazil ch5sc2_44d95c03:

#   al "Ahmmm... Mmhh... *Muuawh*"
    al "Ahmmm... Mmhh... *Muuawh*"

# game/chapters/chapter5/script/ch5sc2.rpy:1662
translate brazil ch5sc2_08aad367:

#   mct "{i}She’s so eager... I guess she was hoping I’d kiss her on the lips.{/i}"
    mct "{i}Ela está tão ansiosa... Acho que ela estava esperando que eu a beijasse nos lábios.{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1664
translate brazil ch5sc2_78ed4c80:

#   al "Yum!"
    al "Que delícia!"

# game/chapters/chapter5/script/ch5sc2.rpy:1665
translate brazil ch5sc2_96bed277:

#   mc "Happy with your reward?"
    mc "Ficou satisfeito com sua recompensa?"

# game/chapters/chapter5/script/ch5sc2.rpy:1666
translate brazil ch5sc2_3a848098:

#   al "I think we both know the answer... Come, you have to try the bed!"
    al "Acho que nós dois sabemos a resposta... Venha, você tem que experimentar a cama!"

# game/chapters/chapter5/script/ch5sc2.rpy:1668
translate brazil ch5sc2_98e36371:

#   mc "Alright. But first ... *Mwah*"
    mc "Certo. Mas primeiro... *Beijo*"

# game/chapters/chapter5/script/ch5sc2.rpy:1669
translate brazil ch5sc2_be1c8094:

#   al "*Giggles* H-Hey that tickles!"
    al "*Risos* Ei, isso faz cócegas!"

# game/chapters/chapter5/script/ch5sc2.rpy:1671
translate brazil ch5sc2_5a4e6d8f:

#   "Alice's trust has increased by {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."
    "A confiança de Alice aumentou em {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc2.rpy:1676
translate brazil ch5sc2_fa51e235:

#   mc "*Kiss*"
    mc "*Beijo*"

# game/chapters/chapter5/script/ch5sc2.rpy:1678
translate brazil ch5sc2_c456b00a:

#   al "Let’s lie down on my bed! You have to feel how soft it is!"
    al "Vamos deitar na minha cama! Você precisa sentir como ela é macia!"

# game/chapters/chapter5/script/ch5sc2.rpy:1682
translate brazil ch5sc2_c7090fbd:

#   al "Ahhh... Isn’t this bed amazing?"
    al "Ahhh... Essa cama não é incrível?"

# game/chapters/chapter5/script/ch5sc2.rpy:1684
translate brazil ch5sc2_4d09844b:

#   mc "Sure, it’s pretty comfortable."
    mc "Sim, é bastante confortável."

# game/chapters/chapter5/script/ch5sc2.rpy:1685
translate brazil ch5sc2_edf49bdb:

#   mc "But size-wise... well, I’m halfway off the bed."
    mc "Mas em termos de tamanho... bem, estou com metade do corpo para fora da cama."

# game/chapters/chapter5/script/ch5sc2.rpy:1687
translate brazil ch5sc2_7f031c00:

#   al "Pish-Posh! It could easily fit two people!"
    al "Bobagem! Caberia facilmente duas pessoas!"

# game/chapters/chapter5/script/ch5sc2.rpy:1689
translate brazil ch5sc2_5906ba75:

#   mc "*Chuckles* Suuuure! I bet it doesn’t even fit you and your tiny bum."
    mc "*Risos* Claro! Aposto que nem cabe em você e nesse seu bumbum minúsculo."

# game/chapters/chapter5/script/ch5sc2.rpy:1690
translate brazil ch5sc2_997a74de:

#   mc "You'll probably end up on the floor half the time."
    mc "Você provavelmente vai acabar no chão metade das vezes."

# game/chapters/chapter5/script/ch5sc2.rpy:1693
translate brazil ch5sc2_ba69516f:

#   al "H-Hey! Take that back!"
    al "Ei! Retire o que disse!"

# game/chapters/chapter5/script/ch5sc2.rpy:1694
translate brazil ch5sc2_c46323a2:

#   al "Insulting my lovely bed {b}WHILE{/b} lying on it? Meanie!"
    al "Insultando minha adorável cama {b} ENQUANTO{/b} Deitada em cima? Que malvada!"

# game/chapters/chapter5/script/ch5sc2.rpy:1696
translate brazil ch5sc2_c293d468:

#   mc "Why would I take it back? I’ve only spoken the truth! *Chuckles*"
    mc "Por que eu voltaria atrás? Eu só falei a verdade! *Risos*"

# game/chapters/chapter5/script/ch5sc2.rpy:1699
translate brazil ch5sc2_64ab5c3f:

#   al "Okay! That’s it, mister! You’ve asked for it!"
    al "Certo! É isso aí, senhor! Você pediu por isso!"

# game/chapters/chapter5/script/ch5sc2.rpy:1700
translate brazil ch5sc2_26227a57:

#   al "You’ve clearly forgotten that I was the uncrowned tickle champion back in Riverside!"
    al "Você claramente se esqueceu de que eu era o campeão não coroado de cócegas lá em Riverside!"

# game/chapters/chapter5/script/ch5sc2.rpy:1702
translate brazil ch5sc2_85581354:

#   al "And there will be no mercy for anyone who insults my precious bed!"
    al "E não haverá misericórdia para quem insultar minha preciosa cama!"

# game/chapters/chapter5/script/ch5sc2.rpy:1703
translate brazil ch5sc2_99e0d4ce:

#   al "Not even childhood friends!"
    al "Nem mesmo amigos de infância!"

# game/chapters/chapter5/script/ch5sc2.rpy:1704
translate brazil ch5sc2_62eb0468:

#   mc "*Chuckles* Heyyy! Hahah! Don’t! hahah-"
    mc "*Risos* Ei! Hahah! Não! hahah-"

# game/chapters/chapter5/script/ch5sc2.rpy:1706
translate brazil ch5sc2_ce592075:

#   al "How do you like that? {b}HMM?{/b}"
    al "E aí, gostou? {b} HUM?{/b}"

# game/chapters/chapter5/script/ch5sc2.rpy:1708
translate brazil ch5sc2_96f0d4b2:

#   al "Say you’re sorry! I'm not getting off until you apologize! *Tickles*"
