translate brazil ch2sc27_a84bb0dc:

#   el "We should start looking for taverns to rest at in the future."
    el "Devemos começar a procurar tabernas onde possamos descansar no futuro."

# game/chapters/chapter1_5/script/ch2sc2.rpy:999
translate brazil ch2sc27_8c72f84b:

#   mct "Future..."
    mct "Futuro..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1001
translate brazil ch2sc27_54d19241:

#   el "Let’s get some sleep. You agreed to train me tomorrow, remember?"
    el "Vamos dormir um pouco. Você concordou em me treinar amanhã, lembra?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1003
translate brazil ch2sc27_c5470b31:

#   mc "*Sigh* I really said I would... didn’t I?"
    mc "*Suspiro* Eu realmente disse que faria... não disse?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1005
translate brazil ch2sc27_fabd5166:

#   el "Yes! And I’m already excited to kick your ass!"
    el "Sim! E eu já estou ansioso para te dar uma surra!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1009
translate brazil ch2sc27_e41aecc6:

#   mc "Yeah, yeah. I saw how you moved today."
    mc "Sim, sim. Eu vi como você se movimentou hoje."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1011
translate brazil ch2sc27_8ed64d04:

#   el "Like a panther going for the kill?"
    el "Como uma pantera que parte para o ataque?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1013
translate brazil ch2sc27_f04f9694:

#   mc "More like a log tumbling down a hill."
    mc "Mais parecido com um tronco rolando ladeira abaixo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1016
translate brazil ch2sc27_0d9d4f83:

#   el "*Snickers* A log huh?"
    el "*Risos* Um tronco, hein?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1021
translate brazil ch2sc27_016ba242:

#   mc "Oww! *Chuckles* Guess I earned that one..."
    mc "Ai! *Risos* Acho que mereci essa..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1023
translate brazil ch2sc27_b3adf049:

#   el "Yes. You did."
    el "Sim. Você fez."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1024
translate brazil ch2sc27_3d8bfc62:

#   el "Goodnight, [mc]."
    el "Boa noite, [mc]."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1026
translate brazil ch2sc27_5d23e633:

#   mc "Goodnight Eliza."
    mc "Boa noite, Eliza."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1028
translate brazil ch2sc27_a6c13c78:

#   mct "What a day. Finding Oren’s daughter..."
    mct "Que dia! Encontrar a filha de Oren..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1029
translate brazil ch2sc27_7eea64d8:

#   mct "And I lost control. I can’t let that happen around her again. I don’t trust myself not to harm her."
    mct "E eu perdi o controle. Não posso deixar isso acontecer perto dela de novo. Não confio em mim mesmo para não machucá-la."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1031
translate brazil ch2sc27_3b1dad9a:

#   mct "She managed to calm me, though. I was boiling with rage."
    mct "Mas ela conseguiu me acalmar. Eu estava fervendo de raiva."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1032
translate brazil ch2sc27_54ee925c:

#   mct "It felt as if my blood was on fire... I’m not sure how she got me out of that state."
    mct "Senti como se meu sangue estivesse em chamas... Não sei como ela me tirou desse estado."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1034
translate brazil ch2sc27_d83ca57d:

#   mct "She’s so innocent. But when my life was in danger today, she saved me. No hesitation. Oren, I’ll protect her."
    mct "Ela é tão inocente. Mas quando minha vida estava em perigo hoje, ela me salvou. Sem hesitar. Oren, eu a protegerei."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1036
translate brazil ch2sc27_1aa23a7d:

#   mct "Mama... Papa... I haven’t forgotten."
    mct "Mamãe... Papai... Eu não esqueci."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1042
translate brazil ch2sc27_a73f1c61:

#   uk "Hraraah! Hiiihyaa!"
    uk "Hraraah! Hiihihaa!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1043
translate brazil ch2sc27_623b2e07:

#   mct "What in the heavens are those sounds?"
    mct "Que sons são esses, afinal?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1045
translate brazil ch2sc27_f2049a43:

#   el "Huuyah! Aah! Yaarh!"
    el "Huuyah! Aah! Yaarh!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1047
translate brazil ch2sc27_532bcd06:

#   el "Arrrh! Hihya!"
    el "Arrrr! Hihya!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1055
translate brazil ch2sc27_0aaf9b58:

#   mct "This early? She can't be serious."
    mct "Tão cedo assim? Ela não pode estar falando sério."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1070
translate brazil ch2sc27_0e64c5b3:

#   el "Haarrrh! Take that!"
    el "Haarrr! Toma essa!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1072
translate brazil ch2sc27_b89b4095:

#   mc "What did that tree ever do to you?"
    mc "O que aquela árvore te fez?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1076
translate brazil ch2sc27_10486394:

#   el "Oh! Aaaah!"
    el "Oh! Aaaah!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1081
translate brazil ch2sc27_91f1c205:

#   el "Owhh!"
    el "Ohhh!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1083
translate brazil ch2sc27_a1e2de9e:

#   elt "Shit! That was so embarrassing. I can’t believe he saw me fall like that!"
    elt "Puxa! Que vergonha! Não acredito que ele me viu cair daquele jeito!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1085
translate brazil ch2sc27_67814f30:

#   elt "He probably thinks I’m a total klutz now."
    elt "Ele provavelmente acha que eu sou uma completa desastrada agora."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1087
translate brazil ch2sc27_a7c60a03:

#   el "I err... I was just getting in some practice."
    el "Hum... eu só estava praticando um pouco."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1089
translate brazil ch2sc27_923b74c9:

#   mc "And by practice, you mean: you got beat up by a tree?"
    mc "E por prática, você quer dizer: você apanhou de uma árvore?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1091
translate brazil ch2sc27_d94ebb6f:

#   el "Hey! You startled me! And... I lost my balance."
    el "Ei! Você me assustou! E... eu perdi o equilíbrio."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1093
translate brazil ch2sc27_4e29c4cd:

#   mc "*Chuckles* Alright, alright."
    mc "*Risos* Tudo bem, tudo bem."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1095
translate brazil ch2sc27_c8c8d6ab:

#   el "Are you going to stand there and laugh at me all day?"
    el "Você vai ficar aí parado rindo de mim o dia todo?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1096
translate brazil ch2sc27_1220e8ee:

#   el "Or will you train me like you promised?"
    el "Ou você vai me treinar como prometeu?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1098
translate brazil ch2sc27_61db58ee:

#   mc "Right now?"
    mc "Agora mesmo?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1100
translate brazil ch2sc27_5eaa7b76:

#   el "Uh huh! Come on, we’re wasting daylight here!"
    el "Ah, é mesmo! Vamos lá, estamos perdendo tempo!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1102
translate brazil ch2sc27_4b006945:

#   mc "*Sigh* You’re really not letting it go, huh?"
    mc "*Suspiro* Você realmente não vai deixar isso para lá, né?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1104
translate brazil ch2sc27_30219f7d:

#   el "Not a chance..."
    el "Nem pensar..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1105
translate brazil ch2sc27_2d67387a:

#   el "Not even if a big fat troll was sitting on top of you!"
    el "Nem mesmo se um troll gordo e enorme estivesse sentado em cima de você!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1107
translate brazil ch2sc27_167814cd:

#   mc "Alright, alright."
    mc "Certo, certo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1109
translate brazil ch2sc27_263e85b4:

#   mct "It’s great that she's eager to learn, but does it have to be at such an ungodly hour?"
    mct "É ótimo que ela esteja ansiosa para aprender, mas precisa ser em um horário tão impróprio?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1111
translate brazil ch2sc27_d45bf85a:

#   mc "Okay. We’ll start off with some basic stances today. Go ahead and get ready."
    mc "Certo. Vamos começar com algumas posturas básicas hoje. Podem se preparar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1113
translate brazil ch2sc27_97f0d7ed:

#   el "Like this?"
    el "Assim?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1114
translate brazil ch2sc27_2a622d9e:

#   mc "A decent stance to start off with."
    mc "Uma postura inicial razoável."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1115
translate brazil ch2sc27_46440c6e:

#   el "*Scoffs* You like my stance!"
    el "*Zomba* Você gosta da minha postura!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1117
translate brazil ch2sc27_c97f6201:

#   mc "Right... first you need to practice some footwork."
    mc "Certo... primeiro você precisa praticar alguns movimentos de pés."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1119
translate brazil ch2sc27_cd1a2e9d:

#   el "Don’t I just keep both my feet on the ground?"
    el "Não seria melhor manter os dois pés no chão?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1121
translate brazil ch2sc27_c7045703:

#   mc "No, there's much more to it. Last night when you intercepted his attack, you were quick."
    mc "Não, há muito mais por trás disso. Ontem à noite, quando você interceptou o ataque dele, você foi rápido."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1123
translate brazil ch2sc27_4da1bda3:

#   mc "If you'd had the proper stance, you could even have deflected him and opened him up to a counter."
    mc "Se você tivesse adotado a postura correta, poderia até tê-lo desviado e aberto uma brecha para um contra-ataque."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1125
translate brazil ch2sc27_4b4eb767:

#   el "Woah, seriously? I thought he was just too physically strong for me."
    el "Nossa, sério? Eu achava que ele era simplesmente forte demais fisicamente para mim."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1127
translate brazil ch2sc27_94e960fd:

#   mc "In a fight, your physical strength only makes up a small portion of the battle."
    mc "Em uma luta, sua força física representa apenas uma pequena parte da batalha."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1129
translate brazil ch2sc27_86a9ba34:

#   mc "Technique, speed, agility, and experience; all these things are just as important."
    mc "Técnica, velocidade, agilidade e experiência; todas essas coisas são igualmente importantes."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1131
translate brazil ch2sc27_ebcbfb2c:

#   elt "Mhm, that does make sense, and I am quick like he said."
    elt "Hum, faz sentido, e eu sou rápido como ele disse."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1133
translate brazil ch2sc27_d1eb2d0b:

#   el "Okay [mc], I see what you’re saying! So where do we begin?"
    el "OK [mc] Entendi o que você está dizendo! Então, por onde começamos?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1134
translate brazil ch2sc27_c31cd5b1:

#   el "I want to master all of them!"
    el "Quero dominar todas elas!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1136
translate brazil ch2sc27_7ed3ffac:

#   mc "You’re going to strike at me."
    mc "Você vai me atacar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1138
translate brazil ch2sc27_762a89f4:

#   el "But... what if I hit you?"
    el "Mas... e se eu te bater?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1140
translate brazil ch2sc27_21865877:

#   mc "Then we can proceed to the next stage."
    mc "Em seguida, podemos prosseguir para a próxima etapa."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1142
translate brazil ch2sc27_9578f711:

#   el "Alright! Here I come!"
    el "Muito bem! Lá vou eu!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1149
translate brazil ch2sc27_59ce4eff:

#   el "Arrh!"
    el "Argh!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1151
translate brazil ch2sc27_22abd0c9:

#   elt "How did he catch me like that? He’s holding me up like I’m weightless!"
    elt "Como ele conseguiu me pegar assim? Ele está me segurando como se eu não pesasse nada!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1153
translate brazil ch2sc27_532117ed:

#   mc "Hey, you."
    mc "Ei, você aí."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1155
translate brazil ch2sc27_e9231c41:

#   el "Hi... Y-You."
    el "Oi... V-Você."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1157
translate brazil ch2sc27_ea7c2d77:

#   elt "Heavens... He’s so close!! I can feel the warmth radiating from his chest resting against my back."
    elt "Céus... Ele está tão perto!! Consigo sentir o calor irradiando do seu peito contra as minhas costas."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1159
translate brazil ch2sc27_2198f1b2:

#   elt "This is the first time I’ve been this close to a man."
    elt "Esta é a primeira vez que chego tão perto de um homem."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1161
translate brazil ch2sc27_196d2f3b:

#   elt "His eyes... were they always this blue?"
    elt "Os olhos dele... sempre foram tão azuis?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1163
translate brazil ch2sc27_ac7bc61e:

#   elt "Listen to yourself, Eliza! Swooning over the first guy to hold you in his arms."
    elt "Escuta o que você está dizendo, Eliza! Se derretendo pelo primeiro cara que te abraça."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1165
translate brazil ch2sc27_e8d3816a:

#   elt "He’s not just any guy, though. He’s [mc]. I trust him."
    elt "Mas ele não é um cara qualquer. Ele é [mc] Eu confio nele."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1166
translate brazil ch2sc27_bbc0a0dd:

#   elt "I feel like I know him... that we've met... but I can't remember..."
    elt "Tenho a sensação de que o conheço... de que já nos encontramos... mas não consigo me lembrar..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1168
translate brazil ch2sc27_d13054ea:

#   elt "Stop Eliza! Why are you looking at his lips?!"
    elt "Pare, Eliza! Por que você está olhando para os lábios dele?!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1169
translate brazil ch2sc27_3fbfa819:

#   elt "Would they feel soft against mine? No, no, no, no! Stop it!"
    elt "Será que elas seriam macias contra as minhas? Não, não, não, não! Pare com isso!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1171
translate brazil ch2sc27_6fe828ff:

#   el "Uuh... is this part of my training?"
    el "Hum... isso faz parte do meu treinamento?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1173
translate brazil ch2sc27_84fa653f:

#   mc "I’m improvising."
    mc "Estou improvisando."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1175
translate brazil ch2sc27_c581ef7b:

#   elt "Is-is he going to kiss me?!"
    elt "Ele vai me beijar?!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1176
translate brazil ch2sc27_11995110:

#   elt "Maybe I should... show him that I'd like him to?"
    elt "Talvez eu devesse... mostrar a ele que eu gostaria que ele fizesse isso?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1179
translate brazil ch2sc27_e6c306b9:

#   "Eliza leans back into you, puckering her lips with closed eyes."
    "Eliza se inclina para trás, encostando-se em você, e faz um biquinho com os lábios, de olhos fechados."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1185
translate brazil ch2sc27_df8dbaff:

#   "Eliza's trust has increased by {b}{color=#2bff8b}5{/color}{/b}."
    "A confiança de Eliza aumentou em {b}{color=#2bff8b}5{/color}{/b}."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1189
translate brazil ch2sc27_12b8b048:

#   el "*Soft moans* Mmhm... Mhh."
    el "*Gemidos suaves* Mmhm... Mhh."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1204
translate brazil ch2sc27_848ef713:

#   el "Sorry! I-I don’t know what came over me!! This is embarrassing! Let’s just forget it happened, yeah?"
    el "Desculpe! Não sei o que me deu!! Que vergonha! Vamos fingir que nada aconteceu, tá?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1206
translate brazil ch2sc27_b152a6dd:

#   el "Y-You should probably put me down now..."
    el "É melhor você me soltar agora..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1209
translate brazil ch2sc27_7ce82c6d:

#   elt "Great Eliza. Now he’s going to think you didn’t enjoy it!"
    elt "Ótimo, Eliza! Agora ele vai pensar que você não gostou!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1210
translate brazil ch2sc27_b93b35cc:

#   elt "But I really did! I... I want to do it again..."
    elt "Mas eu realmente fiz! Eu... eu quero fazer de novo..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1212
translate brazil ch2sc27_6f80d1dc:

#   "You put her down and continue training for a few hours."
    "Você a coloca no chão e continua o treinamento por algumas horas."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1228
translate brazil ch2sc27_fb356c9a:

#   el "Owwwh!"
    el "Ai!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1229
translate brazil ch2sc27_d65a511f:

#   mc "I didn’t push you that hard..."
    mc "Eu não te pressionei tanto assim..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1230
translate brazil ch2sc27_269d1786:

#   mc "Here, let me help you up."
    mc "Aqui, deixe-me ajudá-lo(a) a levantar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1232
translate brazil ch2sc27_1df3813b:

#   elt "So sweet..."
    elt "Tão doce..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1233
translate brazil ch2sc27_b487fc13:

#   elt "He's always quick to help me back up after knocking me down."
    elt "Ele sempre me ajuda a levantar depois de me derrubar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1235
translate brazil ch2sc27_bee4fec7:

#   el "Thank you."
    el "Obrigado."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1237
translate brazil ch2sc27_2d9c28c4:

#   el "Pheeew! That was a workout!"
    el "Ufa! Que treino!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1239
translate brazil ch2sc27_4ae4be2d:

#   mc "It’s been a while since anyone could keep up with me, you’re fast Eliza."
    mc "Já faz um tempo que ninguém consegue me acompanhar, você é rápida, Eliza."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1241
translate brazil ch2sc27_742835d2:

#   el "Was that a compliment I just heard?"
    el "Será que ouvi um elogio?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1243
translate brazil ch2sc27_c659c5f9:

#   mc "Don’t get ahead of yourself. I was merely stating a fact."
    mc "Não se precipite. Eu estava apenas constatando um fato."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1245
translate brazil ch2sc27_e95fa528:

#   el "Ah-ah! No take backs!"
    el "Ah-ah! Sem volta!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1246
translate brazil ch2sc27_b7fee382:

#   el "*Snickers* I'm taking that compliment and storing it in memory vault!"
    el "*Risos* Vou guardar esse elogio na memória!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1248
translate brazil ch2sc27_82c5eb04:

#   elt "He’s definitely impressed with my speed."
    elt "Ele definitivamente ficou impressionado com a minha velocidade."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1249
translate brazil ch2sc27_a2cda9a3:

#   elt "I guess that is my edge in combat."
    elt "Acho que essa é a minha vantagem em combate."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1251
translate brazil ch2sc27_136a16b0:

#   mc "Fine, you can have the compliment."
    mc "Tudo bem, pode ficar com o elogio."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1252
translate brazil ch2sc27_5f33e7dc:

#   mc "But don’t let it get to your pretty little head."
    mc "Mas não deixe que isso suba à sua linda cabecinha."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1254
translate brazil ch2sc27_36fd419c:

#   el "Pretty, huh?"
    el "Bonito, né?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1258
translate brazil ch2sc27_15cc9151:

#   mc "You'd better stay focused. You still have a long way till you’re able to protect yourself."
    mc "É melhor você manter o foco. Você ainda tem um longo caminho a percorrer até ser capaz de se proteger."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1260
translate brazil ch2sc27_37f455b8:

#   elt "I’m not doing this for myself, [mc]. I’m doing it to protect you."
    elt "Não estou fazendo isso por mim. [mc] Estou fazendo isso para te proteger."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1261
translate brazil ch2sc27_b9081e67:

#   elt "I want to have his back, the way he has mine."
    elt "Quero protegê-lo da mesma forma que ele me protege."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1263
translate brazil ch2sc27_29d1d762:

#   el "Hah! Just wait, I'll surpass you in no time! The trainee always surpasses the master."
    el "Hah! Espere só, logo te ultrapassarei! O aprendiz sempre supera o mestre."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1265
translate brazil ch2sc27_0f4bf3e7:

#   mc "Master, huh?"
    mc "Mestre, hein?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1267
translate brazil ch2sc27_9b16b5c0:

#   el "Urrh!! {b}Forget I said that!!{/b}"
    el "Urrh!! {b} Esqueça o que eu disse!!{/b}"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1270
translate brazil ch2sc27_39d3a2c0:

#   "You can't help but smile at her fumbling over her words."
    "É impossível não sorrir ao vê-la gaguejar e se atrapalhar com as palavras."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1272
translate brazil ch2sc27_7d7412f7:

#   el "Wipe that smile off your dummy face! We'd better get moving."
    el "Apaga esse sorriso da sua cara de bobo! É melhor a gente ir embora."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1273
translate brazil ch2sc27_599fa894:

#   el "We both know that's not what I meant! Hnngh!"
    el "Nós dois sabemos que não era isso que eu queria dizer! Hnngh!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1286
translate brazil ch2sc27_11455b53:

#   mc "What?"
    mc "O que?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1288
translate brazil ch2sc27_05b4ca3b:

#   el "You still haven't told me why we’re headed to Riverside."
    el "Você ainda não me disse por que estamos indo para Riverside."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1290
translate brazil ch2sc27_d3d0ef5f:

#   mc "It's on the way to Luxenford, going around Riverside would be a waste of time..."
    mc "Fica a caminho de Luxenford, dar a volta por Riverside seria uma perda de tempo..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1292
translate brazil ch2sc27_a5abb875:

#   el "Oh, we're going to Luxenford? Neat! I've never been."
    el "Ah, então vamos para Luxemburgo? Que legal! Nunca fui lá."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1293
translate brazil ch2sc27_b40ae9c9:

#   el "I've always wanted to see the capital."
    el "Sempre quis conhecer a capital."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1295
translate brazil ch2sc27_3af20163:

#   mc "I haven't been either, It's supposedly the largest city in the kingdom."
    mc "Eu também nunca fui. Dizem que é a maior cidade do reino."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1296
translate brazil ch2sc27_d158dd82:

#   mc "With anything you can imagine, from shops to large gardens, various guilds and organizations."
    mc "Com tudo o que você possa imaginar, desde lojas a grandes jardins, passando por diversas guildas e organizações."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1298
translate brazil ch2sc27_fa617b38:

#   el "Sounds nice, I definitely prefer smaller villages and settlements."
    el "Parece ótimo, eu definitivamente prefiro vilas e povoados menores."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1299
translate brazil ch2sc27_7100dc26:

#   el "But living near the capital would have a lot of benefits too."
    el "Mas morar perto da capital também teria muitas vantagens."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1301
translate brazil ch2sc27_ffadb2be:

#   el "Hmmm. Mmhh..."
    el "Hummm. Mmhh..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1303
translate brazil ch2sc27_1acfb52b:

#   el "Do you think you'll encounter anyone in Riverside... you know, old friends or family?"
    el "Você acha que vai encontrar alguém em Riverside... sabe, velhos amigos ou familiares?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1305
translate brazil ch2sc27_f1d1aede:

#   mc "Yeah... I suspect we will, although I'm not sure if they still live there."
    mc "Sim... suspeito que sim, embora não tenha certeza se eles ainda moram lá."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1307
translate brazil ch2sc27_cc866a6a:

#   el "I hope they do, I'd love to meet the people in your life."
    el "Espero que sim, adoraria conhecer as pessoas da sua vida."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1308
translate brazil ch2sc27_a140a4df:

#   el "Even if they haven't been for the last decade..."
    el "Mesmo que não tenham sido assim na última década..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1310
translate brazil ch2sc27_594b763c:

#   elt "Hmm... but I don't want to intrude on his reunions..."
    elt "Hum... mas não quero atrapalhar os reencontros dele..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1311
translate brazil ch2sc27_146091a8:

#   elt "I definitely feel like there's more to us going through Riverside other than logistics."
    elt "Definitivamente, sinto que nossa passagem por Riverside envolve mais do que apenas logística."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1313
translate brazil ch2sc27_c84858e5:

#   el "Wha-"
    el "Quatro-"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1315
translate brazil ch2sc27_e6d64a49:

#   mc "There’s someone I need to see."
    mc "Tem alguém com quem eu preciso falar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1319
translate brazil ch2sc27_95b9b77e:

#   el "Who?"
    el "Quem?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1321
translate brazil ch2sc27_9c7a2e0a:

#   mc "Family friend."
    mc "Amigo da família."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1323
translate brazil ch2sc27_ddb8b84e:

#   el "What are you hoping to find?"
    el "O que você espera encontrar?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1325
translate brazil ch2sc27_5e7d1841:

#   mc "Answers."
    mc "Respostas."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1327
translate brazil ch2sc27_04012024:

#   elt "Clearly something bad happened in his past."
    elt "Claramente, algo ruim aconteceu em seu passado."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1328
translate brazil ch2sc27_7fac2c61:

#   elt "Why else would he have been gone for a decade? He would only have been... ten summers?"
    elt "Por que mais ele teria ficado fora por uma década? Ele teria ficado apenas... dez verões?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1330
translate brazil ch2sc27_6a837626:

#   el "I’ll help!"
    el "Eu ajudo!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1332
translate brazil ch2sc27_fcbd18e0:

#   mc "*Sigh* ..."
    mc "*Suspirar* ..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1334
translate brazil ch2sc27_75e338df:

#   el "So... what family do you have in Riverside?"
    el "Então... que tipo de família você tem em Riverside?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1335
translate brazil ch2sc27_f1ceb8fa:

#   el "Cousins? Grandparents? Siblings?"
    el "Primos? Avós? Irmãos?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1337
translate brazil ch2sc27_28a5c464:

#   mc "My {b}Aunt Maya{/b} and {b}Uncle Shane{/b}. And two cousins ... {b}Flynn{/b} and {b}Sabrina{/b}."
    mc "Meu {b} Tia Maya{/b} e {b} Tio Shane{/b}E dois primos... {b} Flynn{/b} e {b} Sabrina{/b}."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1339
translate brazil ch2sc27_2ad24dc2:

#   elt "He didn’t mention his parents."
    elt "Ele não mencionou seus pais."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1341
translate brazil ch2sc27_fecbd943:

#   el "What abou-"
    el "E quanto a...?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1343
translate brazil ch2sc27_208f6520:

#   mc "{b}Don’t.{/b}"
    mc "{b}Não.{/b}"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1345
translate brazil ch2sc27_f136c947:

#   el "Sorry... I didn’t mean to pry."
    el "Desculpe... Não queria ser intrometida."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1347
translate brazil ch2sc27_0ab1d820:

#   elt "Great, Eliza. Your damn curiosity always lands you in trouble."
    elt "Ótimo, Eliza. Sua maldita curiosidade sempre te mete em encrenca."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1349
translate brazil ch2sc27_f018dd1b:

#   mc "Some other time. Just not now..."
    mc "Em outra ocasião. Mas não agora..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1350
translate brazil ch2sc27_3d6944bd:

#   mc "I'm not... used to sharing."
    mc "Eu não estou... acostumado a compartilhar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1352
translate brazil ch2sc27_13a985cc:

#   el "I understand."
    el "Eu entendo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1353
translate brazil ch2sc27_0d1f613f:

#   el "Whenever you’re ready, I'll listen."
    el "Quando você estiver pronto, eu ouvirei."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1355
translate brazil ch2sc27_92eefa9d:

#   elt "Thank the heavens, he doesn’t seem angry with me."
    elt "Graças a Deus, ele não parece estar zangado comigo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1357
translate brazil ch2sc27_56b0a0ed:

#   mc "Thanks, I appreciate that you're not pushing it."
    mc "Obrigado, agradeço que você não esteja insistindo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1359
translate brazil ch2sc27_5337aa36:

#   el "I wouldnt... so tell me about Riverside, what can we do for fun?"
    el "Eu não faria isso... então me fale sobre Riverside, o que podemos fazer para nos divertir?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1360
translate brazil ch2sc27_c494ab5d:

#   el "All I remember is the market, that's where my father and mother used to take me."
    el "A única coisa de que me lembro é do mercado, era para lá que meu pai e minha mãe costumavam me levar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1362
translate brazil ch2sc27_ebc01fa7:

#   mc "Yeah, it has a weekly market, as for fun, I wouldn’t know."
    mc "Sim, tem um mercado semanal, mas quanto à diversão, não sei dizer."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1363
translate brazil ch2sc27_7e2f742a:

#   mc "I haven’t been back there since I was ten."
    mc "Não volto lá desde que tinha dez anos."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1365
translate brazil ch2sc27_7e3b8133:

#   mc "There used to be this apple plantation where we-..."
    mc "Antigamente existia uma plantação de maçãs onde nós..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1367
translate brazil ch2sc27_00083d85:

#   elt "Looks like he just remembered something from his past."
    elt "Parece que ele acabou de se lembrar de algo do passado."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1368
translate brazil ch2sc27_a708fabe:

#   elt "I wish there was something I could do..."
    elt "Gostaria de poder fazer algo..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1370
translate brazil ch2sc27_180b965a:

#   mc "There also used to be a tavern. The Innkeeper's name is Clark, and he used to be pals with Papa."
    mc "Também havia uma taverna ali. O nome do estalajadeiro é Clark, e ele era amigo do papai."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1371
translate brazil ch2sc27_67805ef2:

#   mc "Maybe it's still up and running, would be nice with a place to stay."
    mc "Talvez ainda esteja funcionando, seria bom ter um lugar para ficar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1373
translate brazil ch2sc27_19fae81e:

#   el "Uwwh Yes!! We desperately need a bed! The cold ground is not exactly kind to our backs."
    el "Ah, sim!! Precisamos desesperadamente de uma cama! O chão frio não está nada bem para as nossas costas."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1375
translate brazil ch2sc27_5445bafe:

#   mc "After your training this morning, you’ll definitely need some rest. I won’t be going easy on you."
    mc "Depois do treino desta manhã, você definitivamente precisará descansar. Não vou pegar leve com você."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1376
translate brazil ch2sc27_4bfc767d:

#   mc "So expect to be sore in places you’re not used to."
    mc "Portanto, espere sentir dores em lugares aos quais você não está acostumado."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1378
translate brazil ch2sc27_5d5fea64:

#   el "Pffft! I’m counting on you giving me everything you’ve got!"
    el "Pffft! Estou contando com você para me dar tudo de si!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1380
translate brazil ch2sc27_aa26c311:

#   el "Otherwise, surpassing you won’t be any fun."
    el "Caso contrário, ultrapassá-lo não terá graça nenhuma."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1382
translate brazil ch2sc27_7129f1ce:

#   mct "*Chuckles* She reminds me of myself back then. Always eager to prove myself."
    mct "*Risos* Ela me lembra de mim mesma naquela época. Sempre ansiosa para provar meu valor."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1389
translate brazil ch2sc27_cda76744:

#   mc "Hey Eliza?"
    mc "Ei, Eliza?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1391
translate brazil ch2sc27_26a904a0:

#   el "Mmh?"
    el "Hum?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1393
translate brazil ch2sc27_94d664a0:

#   mc "Wha- What was your childhood like? Before everything..."
    mc "Como foi sua infância? Antes de tudo..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1395
translate brazil ch2sc27_49a04710:

#   el "Hmm. I’d say it was a pretty standard childhood. You know, two caring parents..."
    el "Hum. Eu diria que foi uma infância bem normal. Sabe, dois pais carinhosos..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1397
translate brazil ch2sc27_9ff150ee:

#   el "Mother always used to read me fairy tales from one of her many books."
    el "Minha mãe sempre lia contos de fadas para mim, de um de seus muitos livros."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1399
translate brazil ch2sc27_a80f7157:

#   el "She was a librarian, so she had some pretty interesting stories."
    el "Ela era bibliotecária, então tinha algumas histórias bem interessantes."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1401
translate brazil ch2sc27_6122dc68:

#   el "She would read them to me for hours, and neither of us would get bored."
    el "Ela lia para mim durante horas, e nenhuma de nós se entediava."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1403
translate brazil ch2sc27_c23501d0:

#   mct "She sounds just like you, Mama."
    mct "Ela é igualzinha a você, mamãe."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1404
translate brazil ch2sc27_ae6e2b3a:

#   mct "You also used to love diving deep into books and grimoires."
    mct "Você também adorava mergulhar nos livros e grimórios."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1406
translate brazil ch2sc27_c0da98b0:

#   mc "Sounds like she loved you."
    mc "Parece que ela te amava."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1408
translate brazil ch2sc27_a3da1bc5:

#   el "She really did."
    el "Ela realmente fez isso."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1409
translate brazil ch2sc27_fc957c5a:

#   el "And father... well father was always a bit rough around the edges."
    el "E o pai... bem, o pai sempre foi um pouco rude."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1411
translate brazil ch2sc27_2a6ec106:

#   el "He was pretty strict, but also cared for us. He just wanted me to grow up disciplined and able to fend for myself."
    el "Ele era bastante rigoroso, mas também se importava conosco. Ele só queria que eu crescesse disciplinada e capaz de me virar sozinha."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1413
translate brazil ch2sc27_96d649ef:

#   el "He'd always say 'You shouldn’t rely on a man to rescue you'."
    el "Ele sempre dizia: 'Você não deve depender de um homem para te resgatar'."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1415
translate brazil ch2sc27_8aaf910c:

#   mct "Heh... that sounds exactly like him."
    mct "Heh... isso soa exatamente como ele."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1419
translate brazil ch2sc27_88d2dd1d:

#   el "Mh, what for?"
    el "Hum, para quê?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1421
translate brazil ch2sc27_b74ccb78:

#   mc "Sharing that with me. It... helps."
    mc "Compartilhar isso comigo... ajuda."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1423
translate brazil ch2sc27_7e6fb313:

#   elt "Huh... is he starting to feel more comfortable around me?"
    elt "Hum... será que ele está começando a se sentir mais à vontade perto de mim?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1425
translate brazil ch2sc27_b9fc9997:

#   el "Hey, don’t go all mushy on me now."
    el "Ei, não fique toda melosa agora."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1426
translate brazil ch2sc27_0251c025:

#   el "We all experience good and bad moments throughout life."
    el "Todos nós vivenciamos momentos bons e ruins ao longo da vida."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1428
translate brazil ch2sc27_bddc2781:

#   el "We just have to make sure the good ones outshine the bad ones."
    el "Só precisamos garantir que os bons se destaquem mais que os ruins."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1434
translate brazil ch2sc27_9956a749:

#   el "Urrh, fine! You can be a little mushy."
    el "Urrh, tudo bem! Você pode ser um pouco sentimental."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1436
translate brazil ch2sc27_c3c10139:

#   el "*Quietly* {size=-10}{b}I don’t mind.{/b}{/size}"
    el "*Em silêncio* {size=-10}{b}Não me importo.{/b}{/size}"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1437
translate brazil ch2sc27_30b290e8:

#   "Eliza enjoys bonding with you, her trust has increased by {b}{color=#2bff8b}1{/color}{/b}."
    "Eliza gosta de criar laços com você, e a confiança dela aumentou. {b}{color=#2bff8b}1{/color}{/b}."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1439
translate brazil ch2sc27_2eafc544:

#   mc "Hmh? You say something?"
    mc "Hum? Você disse alguma coisa?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1441
translate brazil ch2sc27_d960d340:

#   el "N-Nothing!"
    el "N-Nada!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:1443
translate brazil ch2sc27_d952c579:

#   "A few hours go by as you shift between small talk and silence."
    "Passam-se algumas horas enquanto vocês alternam entre conversas banais e silêncio."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1451
translate brazil ch2sc27_0db8ca14:

#   el "Ugh... M-My feet hurt."
    el "Ai... Meus pés doem."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1453
translate brazil ch2sc27_bdfeffb7:

#   mc "We’re almost there."
    mc "Estamos quase lá."

