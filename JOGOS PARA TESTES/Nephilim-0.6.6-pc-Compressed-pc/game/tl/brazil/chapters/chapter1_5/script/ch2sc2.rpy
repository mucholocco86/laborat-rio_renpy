# ARQUIVO: game/chapters/chapter1_5/script/ch2sc2.rpy DIALOGOS: 960


# game/chapters/chapter1_5/script/ch2sc2.rpy:75
translate brazil ch2sc27_0a74ce7b_1:

#   ukt "..."
    ukt "..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:12
translate brazil ch2sc27_45330637:

#   "The girl collapses on the ground, she's clearly exhausted after fighting them off."
    "A garota cai no chão, visivelmente exausta após lutar contra eles."

# game/chapters/chapter1_5/script/ch2sc2.rpy:14
translate brazil ch2sc27_ec23b6f8:

#   uk "*Winded* T... Thank you, sir."
    uk "*Sem fôlego* T... Obrigado, senhor."

# game/chapters/chapter1_5/script/ch2sc2.rpy:16
translate brazil ch2sc27_1d3089af:

#   mc "Your eyes... they’re so blue."
    mc "Seus olhos... são tão azuis."

# game/chapters/chapter1_5/script/ch2sc2.rpy:17
translate brazil ch2sc27_bc1f4562:

#   mct "Could this be... her?"
    mct "Será que é... ela?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:19
translate brazil ch2sc27_6361d9d7:

#   ukt "My... My eyes?"
    ukt "Meus... Meus olhos?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:21
translate brazil ch2sc27_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:23
translate brazil ch2sc27_9ba9c7f8:

#   mc "Err... I mean, are you hurt?"
    mc "Hum... quer dizer, você está machucado?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:25
translate brazil ch2sc27_33514214:

#   uk "I don’t think so. Just a little winded. I'd been dealing with those idiots for a good while when you showed up. Thank you again."
    uk "Acho que não. Só estou um pouco sem fôlego. Já fazia um bom tempo que eu estava lidando com aqueles idiotas quando você apareceu. Muito obrigado novamente."

# game/chapters/chapter1_5/script/ch2sc2.rpy:27
translate brazil ch2sc27_68744a03:

#   mc "I didn’t do it for you. You should learn to be more careful."
    mc "Eu não fiz isso por você. Você deveria aprender a ser mais cuidadoso(a)."

# game/chapters/chapter1_5/script/ch2sc2.rpy:29
translate brazil ch2sc27_bc433e00:

#   ukt "I don't believe him for a second. "
    ukt "Não acredito nele nem por um segundo. "

# game/chapters/chapter1_5/script/ch2sc2.rpy:31
translate brazil ch2sc27_a8f3c685:

#   mc "They were clearly up to no good. I just stopped them ..."
    mc "Eles estavam claramente aprontando alguma coisa. Eu simplesmente os detive..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:33
translate brazil ch2sc27_bdb6b413:

#   uk "We both know what those filth would have done to me, if you hadn’t shown up."
    uk "Nós dois sabemos o que aqueles vermes teriam feito comigo se você não tivesse aparecido."

# game/chapters/chapter1_5/script/ch2sc2.rpy:35
translate brazil ch2sc27_faa46645:

#   mct "They'd have had their way with her and left her for dead, without a doubt."
    mct "Sem dúvida alguma, eles teriam feito o que quisessem com ela e a teriam deixado para morrer."

# game/chapters/chapter1_5/script/ch2sc2.rpy:37
translate brazil ch2sc27_02c5296d:

#   mc "What’s your point?"
    mc "Qual é o seu ponto?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:39
translate brazil ch2sc27_10b90331:

#   ukt "God! He's so annoying!"
    ukt "Meu Deus! Ele é tão irritante!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:41
translate brazil ch2sc27_e8da44aa:

#   uk "I owe you my life, idiot."
    uk "Eu te devo a minha vida, idiota."

# game/chapters/chapter1_5/script/ch2sc2.rpy:43
translate brazil ch2sc27_09460c3a:

#   mc "Well, you’re safe now. I'll be on my way. "
    mc "Bom, agora você está seguro. Vou indo. "

# game/chapters/chapter1_5/script/ch2sc2.rpy:45
translate brazil ch2sc27_4d9a5d86:

#   mc "Bye."
    mc "Tchau."

# game/chapters/chapter1_5/script/ch2sc2.rpy:47
translate brazil ch2sc27_fd508797:

#   uk "*Mumbles* Asshat."
    uk "*Resmunga* Idiota."

# game/chapters/chapter1_5/script/ch2sc2.rpy:49
translate brazil ch2sc27_0a74ce7b:

#   ukt "..."
    ukt "..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:51
translate brazil ch2sc27_566b782e:

#   ukt "Saves my life just to leave me behind. Jerk."
    ukt "Ele me salva só para me abandonar. Idiota."

# game/chapters/chapter1_5/script/ch2sc2.rpy:53
translate brazil ch2sc27_9b6e172b:

#   uk "I better get out of here, I won’t find any mushrooms today."
    uk "É melhor eu ir embora daqui, não vou encontrar nenhum cogumelo hoje."

# game/chapters/chapter1_5/script/ch2sc2.rpy:61
translate brazil ch2sc27_46288ff4:

#   ukt "What a day! Almost killed, or heaven knows what, by bandits."
    ukt "Que dia! Quase fui morto, ou sabe-se lá o quê, por bandidos."

# game/chapters/chapter1_5/script/ch2sc2.rpy:62
translate brazil ch2sc27_f2c45cd8:

#   ukt "Saved by a mysterious guy who also happens to be a jerk!"
    ukt "Salva por um cara misterioso que por acaso também é um idiota!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:64
translate brazil ch2sc27_4f3fdc20:

#   ukt "At least I’m not hurt."
    ukt "Pelo menos não estou ferido."

# game/chapters/chapter1_5/script/ch2sc2.rpy:67
translate brazil ch2sc27_7594c90c:

#   uk "*Painful groans* Urrhh..."
    uk "*Gemidos de dor* Urrhh..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:71
translate brazil ch2sc27_b6dbb211:

#   ukt "Huh? Oh it's him."
    ukt "Hã? Ah, é ele."

# game/chapters/chapter1_5/script/ch2sc2.rpy:73
translate brazil ch2sc27_6471732e:

#   uk "What? You made it pretty clear you don’t give a damn about me."
    uk "O quê? Você deixou bem claro que não se importa comigo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:76
translate brazil ch2sc27_6410872a:

#   uk "Wh-what are you doing?"
    uk "O que você está fazendo?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:78
translate brazil ch2sc27_bbd441c3:

#   mc "Be quiet. Come on, get on my back."
    mc "Fique quieto. Vamos, suba nas minhas costas."

# game/chapters/chapter1_5/script/ch2sc2.rpy:80
translate brazil ch2sc27_19b7305d:

#   uk "Y-Your back?"
    uk "V-Você está de costas?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:82
translate brazil ch2sc27_eb13deec:

#   mc "Yes. You’re clearly in pain. I’ll carry you."
    mc "Sim. Você está claramente com dor. Eu te carrego."

# game/chapters/chapter1_5/script/ch2sc2.rpy:84
translate brazil ch2sc27_dd1a6898:

#   ukt "He’s right. Those guys hit me pretty hard."
    ukt "Ele tem razão. Aqueles caras me bateram muito forte."

# game/chapters/chapter1_5/script/ch2sc2.rpy:86
translate brazil ch2sc27_236b6006:

#   uk "O-Okay"
    uk "Ok"

# game/chapters/chapter1_5/script/ch2sc2.rpy:90
translate brazil ch2sc27_da0f08ee:

#   ukt "Owh... His back feels very muscular. He must have done a lot of fighting."
    ukt "Uau... As costas dele parecem muito musculosas. Ele deve ter lutado bastante."

# game/chapters/chapter1_5/script/ch2sc2.rpy:92
translate brazil ch2sc27_4243852c:

#   uk "Tell me if I’m too heavy."
    uk "Diga-me se estou muito pesado."

# game/chapters/chapter1_5/script/ch2sc2.rpy:94
translate brazil ch2sc27_9c988ce3:

#   mc "Don’t be silly. Hop on."
    mc "Não seja bobo. Suba aí."

# game/chapters/chapter1_5/script/ch2sc2.rpy:98
translate brazil ch2sc27_89b465cf:

#   uk "T-Thank you."
    uk "O-Obrigado."

# game/chapters/chapter1_5/script/ch2sc2.rpy:100
translate brazil ch2sc27_3782a02b:

#   ukt "He’s kinda cute..."
    ukt "Ele é meio bonitinho..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:102
translate brazil ch2sc27_459657df:

#   uk "I’m not too heavy for you?"
    uk "Eu não sou pesado demais para você?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:104
translate brazil ch2sc27_005d53c7:

#   mc "I’ve suffered through worse."
    mc "Já passei por coisas piores."

# game/chapters/chapter1_5/script/ch2sc2.rpy:106
translate brazil ch2sc27_415355da:

#   uk "Jerk!"
    uk "Idiota!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:108
translate brazil ch2sc27_68a28800:

#   ukt "He’s definitely been through a lot, travelling alone isn’t easy."
    ukt "Ele definitivamente passou por muita coisa, viajar sozinho não é fácil."

# game/chapters/chapter1_5/script/ch2sc2.rpy:109
translate brazil ch2sc27_e95fa648:

#   ukt "And he can’t be much older than me, or maybe he's slightly younger?"
    ukt "E ele não pode ser muito mais velho do que eu, ou talvez seja um pouco mais novo?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:110
translate brazil ch2sc27_ac72464e:

#   ukt "He saved me from those bastards with ease, he knocked out the big guy with one punch. Who... who is he?"
    ukt "Ele me salvou daqueles desgraçados com facilidade, nocauteou o grandalhão com um soco só. Quem... quem é ele?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:112
translate brazil ch2sc27_94597e6d:

#   uk "I’m Eliza."
    uk "Meu nome é Eliza."

# game/chapters/chapter1_5/script/ch2sc2.rpy:114
translate brazil ch2sc27_bd7d9df9:

#   mc "[mc]."
    mc "[mc]."

# game/chapters/chapter1_5/script/ch2sc2.rpy:116
translate brazil ch2sc27_90e6fb21:

#   el "Thank you for saving me, [mc]."
    el "Obrigado por me salvar, [mc]."

# game/chapters/chapter1_5/script/ch2sc2.rpy:118
translate brazil ch2sc27_04e56dce:

#   mc "You’re welcome, Eliza."
    mc "De nada, Eliza."

# game/chapters/chapter1_5/script/ch2sc2.rpy:122
translate brazil ch2sc27_dc5979f8:

#   el "So you can be polite!"
    el "Então você pode ser educado!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:124
translate brazil ch2sc27_fb73d75b:

#   mc "Don’t get used to it."
    mc "Não se acostume com isso."

# game/chapters/chapter1_5/script/ch2sc2.rpy:126
translate brazil ch2sc27_0fcb614e:

#   el "Hey... I feel like I've seen you before? You live nearby?"
    el "Ei... tenho a impressão de já ter te visto antes? Você mora por perto?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:128
translate brazil ch2sc27_82cc79a1:

#   mc "No, I mean... I used to, but not for a long time."
    mc "Não, quer dizer... eu costumava fazer isso, mas não faz muito tempo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:129
translate brazil ch2sc27_630f4b1a:

#   mc "I was born in Riverside."
    mc "Eu nasci em Riverside."

# game/chapters/chapter1_5/script/ch2sc2.rpy:131
translate brazil ch2sc27_68261a1e:

#   el "Riverside? That's not too far from here, a couple of days, maybe a week at most."
    el "Riverside? Não é muito longe daqui, uns dois dias, talvez uma semana no máximo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:132
translate brazil ch2sc27_b579e789:

#   el "I grew up in Whitehills, so I've been to Riverside a couple of times during market days."
    el "Eu cresci em Whitehills, então já fui a Riverside algumas vezes durante os dias de feira."

# game/chapters/chapter1_5/script/ch2sc2.rpy:134
translate brazil ch2sc27_0e750404:

#   mc "Whitehills, huh? My mother grew up there, it has hills covered in daisies which led to it's name, right?"
    mc "Whitehills, né? Minha mãe cresceu lá, tem colinas cobertas de margaridas, o que deu origem ao nome, certo?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:136
translate brazil ch2sc27_61336e36:

#   el "That's right! Late spring to early summer all the hills are completely white!"
    el "Isso mesmo! Do final da primavera ao início do verão, todas as colinas ficam completamente brancas!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:137
translate brazil ch2sc27_d3c728e2:

#   el "It's my favorite time of the year, everything feels so peaceful."
    el "É a minha época favorita do ano, tudo parece tão tranquilo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:139
translate brazil ch2sc27_75694f54:

#   mc "*Chuckles* ..."
    mc "*Risos* ..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:147
translate brazil ch2sc27_24d1406f:

#   el "Say, what are you doing out here alone?"
    el "Ei, o que você está fazendo aqui fora sozinha?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:149
translate brazil ch2sc27_b2b9e19d:

#   mc "What do you mean?"
    mc "O que você quer dizer?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:151
translate brazil ch2sc27_278a48b6:

#   el "You can clearly handle yourself, but these woods aren’t exactly safe."
    el "Você claramente sabe se virar, mas essa mata não é exatamente segura."

# game/chapters/chapter1_5/script/ch2sc2.rpy:153
translate brazil ch2sc27_84287b80:

#   mc "I was looking for someone, last I heard they were living near Riverside, which is where I'm heading."
    mc "Eu estava procurando por alguém, a última vez que ouvi falar dessa pessoa, ela estava morando perto de Riverside, que é para onde estou indo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:155
translate brazil ch2sc27_e705d5bc:

#   el "Oh, like a sister? Perhaps a friend?"
    el "Ah, como uma irmã? Talvez uma amiga?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:159
translate brazil ch2sc27_42dd8d9c:

#   el "Oh, oh! A girlfriend?"
    el "Oh, oh! Uma namorada?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:161
translate brazil ch2sc27_31f94900:

#   mc "Do you always talk this much?"
    mc "Você sempre fala tanto assim?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:163
translate brazil ch2sc27_8c6f5efe:

#   el "No, I usually keep to myself."
    el "Não, geralmente prefiro ficar na minha."

# game/chapters/chapter1_5/script/ch2sc2.rpy:165
translate brazil ch2sc27_f1029ffc:

#   el "My father left me and my mother during my tenth summer."
    el "Meu pai nos abandonou, a mim e à minha mãe, durante o meu décimo verão."

# game/chapters/chapter1_5/script/ch2sc2.rpy:166
translate brazil ch2sc27_9f5eb3d7:

#   el "One night, he-... he never returned home."
    el "Certa noite, ele... ele nunca mais voltou para casa."

# game/chapters/chapter1_5/script/ch2sc2.rpy:167
translate brazil ch2sc27_b3fdb684:

#   el "It wasn't uncommon for him to stay out for a few nights when hunting, or going to town for supplies."
    el "Não era incomum que ele passasse algumas noites fora quando ia caçar ou à cidade comprar suprimentos."

# game/chapters/chapter1_5/script/ch2sc2.rpy:168
translate brazil ch2sc27_259c1e9e:

#   el "But without any warning, he just never came back."
    el "Mas, sem qualquer aviso, ele simplesmente nunca mais voltou."

# game/chapters/chapter1_5/script/ch2sc2.rpy:169
translate brazil ch2sc27_87745e36:

#   el "The only thing I can really remember from that day is we had been to the market in Riverside."
    el "A única coisa de que realmente me lembro daquele dia é que tínhamos ido ao mercado em Riverside."

# game/chapters/chapter1_5/script/ch2sc2.rpy:170
translate brazil ch2sc27_7f76ac66:

#   el "But all of the sudden we had to leave in a rush, father's mood had swiftly changed."
    el "Mas de repente tivemos que sair às pressas, o humor do meu pai mudou rapidamente."

# game/chapters/chapter1_5/script/ch2sc2.rpy:172
translate brazil ch2sc27_8000bbd6:

#   mct "Her name is Eliza... Her father left on her tenth summer... Raven hair, blue eyes."
    mct "O nome dela é Eliza... O pai a abandonou no verão em que ela tinha dez anos... Cabelos negros como azeviche, olhos azuis."

# game/chapters/chapter1_5/script/ch2sc2.rpy:173
translate brazil ch2sc27_82a34312:

#   mct "It’s definitely her. Oren, I’ve found your daughter."
    mct "É definitivamente ela. Oren, encontrei sua filha."

# game/chapters/chapter1_5/script/ch2sc2.rpy:175
translate brazil ch2sc27_13b43f53:

#   el "I've spent so many years wondering why? Why didn’t he come home that night?"
    el "Passei tantos anos me perguntando por quê? Por que ele não voltou para casa naquela noite?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:177
translate brazil ch2sc27_63843aa8:

#   mct "She’s talking about the night he found me."
    mct "Ela está falando sobre a noite em que ele me encontrou."

# game/chapters/chapter1_5/script/ch2sc2.rpy:179
translate brazil ch2sc27_5420615c:

#   el "Everything changed after that. Mother didn’t handle it well."
    el "Depois disso, tudo mudou. Minha mãe não lidou bem com a situação."

# game/chapters/chapter1_5/script/ch2sc2.rpy:180
translate brazil ch2sc27_d7572149:

#   el "She began hanging out at the local tavern, seeking comfort in the company of drunk men and ale."
    el "Ela começou a frequentar a taverna local, buscando conforto na companhia de homens bêbados e cerveja."

# game/chapters/chapter1_5/script/ch2sc2.rpy:182
translate brazil ch2sc27_600dbedd:

#   el "A few summers went by with her condition worsening, then a week after my fifteenth summer-"
    el "Passaram-se alguns verões com o estado dela a piorar, e depois, uma semana após o meu décimo quinto verão..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:183
translate brazil ch2sc27_4440f749:

#   el "-Mother didn’t return from her night out."
    el "-Minha mãe não voltou da saída noturna."

# game/chapters/chapter1_5/script/ch2sc2.rpy:184
translate brazil ch2sc27_0ad97455:

#   el "I went looking for her at the tavern, the Innkeeper told me she had left with a man from the capital."
    el "Fui procurá-la na taverna, e o estalajadeiro me disse que ela tinha partido com um homem da capital."

# game/chapters/chapter1_5/script/ch2sc2.rpy:186
translate brazil ch2sc27_26716b95:

#   el "He'd overheard them talking about going to the capital."
    el "Ele os ouviu conversando sobre ir para a capital."

# game/chapters/chapter1_5/script/ch2sc2.rpy:188
translate brazil ch2sc27_88a6e5c3:

#   el "I’ve no idea what happened, but she never came back."
    el "Não faço ideia do que aconteceu, mas ela nunca mais voltou."

# game/chapters/chapter1_5/script/ch2sc2.rpy:190
translate brazil ch2sc27_00b2fd77:

#   mc "I... I’m sorry."
    mc "Eu... eu sinto muito."

# game/chapters/chapter1_5/script/ch2sc2.rpy:192
translate brazil ch2sc27_4df300b4:

#   el "Don’t be silly. It’s not your fault I've had a messed up life."
    el "Não seja bobo. Não é sua culpa que eu tenha tido uma vida complicada."

# game/chapters/chapter1_5/script/ch2sc2.rpy:193
translate brazil ch2sc27_fc4c6af6:

#   el "So I’ve been on my own for five summers now."
    el "Então, já faz cinco verões que estou sozinha."

# game/chapters/chapter1_5/script/ch2sc2.rpy:195
translate brazil ch2sc27_42c0343d:

#   mct "She’s had it rough. It’s my fault, even though she doesn’t realize it."
    mct "Ela passou por momentos difíceis. A culpa é minha, mesmo que ela não se dê conta disso."

# game/chapters/chapter1_5/script/ch2sc2.rpy:196
translate brazil ch2sc27_bcf5373c:

#   mct "If Oren hadn’t taken me away for all those years, she could've had her father."
    mct "Se Oren não tivesse me levado embora por todos esses anos, ela poderia ter tido o pai dela."

# game/chapters/chapter1_5/script/ch2sc2.rpy:198
translate brazil ch2sc27_45f1f317:

#   mc "Why... why would you tell me all this?"
    mc "Por que... por que você me contaria tudo isso?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:200
translate brazil ch2sc27_ad6201a8:

#   el "I... I can’t explain it, really."
    el "Eu... eu realmente não consigo explicar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:201
translate brazil ch2sc27_94e44ee6:

#   el "I don't know if it's because you saved me, but I feel comfortable around you."
    el "Não sei se é porque você me salvou, mas me sinto confortável perto de você."

# game/chapters/chapter1_5/script/ch2sc2.rpy:203
translate brazil ch2sc27_101274ba:

#   el "Even though I barely know you, I still feel like... I can trust you."
    el "Mesmo que eu mal te conheça, ainda sinto que... posso confiar em você."

# game/chapters/chapter1_5/script/ch2sc2.rpy:205
translate brazil ch2sc27_14b5e857:

#   mc "Hmm... I feel it too."
    mc "Hum... Eu também sinto isso."

# game/chapters/chapter1_5/script/ch2sc2.rpy:207
translate brazil ch2sc27_9718fdac:

#   el "*Whispers* Hey, [mc]?"
    el "*Sussurra* Ei, [mc]?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:208
translate brazil ch2sc27_1f067867:

#   mc "Mhh?"
    mc "Hum?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:209
translate brazil ch2sc27_c18dbb9c:

#   el "*Whispers* Thank you."
    el "*Sussurra* Obrigada."

# game/chapters/chapter1_5/script/ch2sc2.rpy:211
translate brazil ch2sc27_02f9d93a:

#   el "*Yawn* Hraahh."
    el "*Bocejo* Hraahh."

# game/chapters/chapter1_5/script/ch2sc2.rpy:213
translate brazil ch2sc27_dab25db5:

#   el "Sorry, I guess I’m a little sleepy."
    el "Desculpe, acho que estou com um pouco de sono."

# game/chapters/chapter1_5/script/ch2sc2.rpy:215
translate brazil ch2sc27_345d2e67:

#   elt "What is it about him that makes me feel so safe? [mc]..."
    elt "O que há nele que me faz sentir tão segura? [mc]..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:218
translate brazil ch2sc27_c27662e4:

#   mct "Heh. She must be exhausted. I'd better find a spot where we can rest up for the night."
    mct "Heh. Ela deve estar exausta. É melhor eu encontrar um lugar onde possamos descansar esta noite."

# game/chapters/chapter1_5/script/ch2sc2.rpy:219
translate brazil ch2sc27_a997fa9d:

#   mct "There're still a few days on the road til we reach Riverside."
    mct "Ainda faltam alguns dias de viagem até chegarmos a Riverside."

# game/chapters/chapter1_5/script/ch2sc2.rpy:223
translate brazil ch2sc27_fb600cd7:

#   mc "This should be a good spot."
    mc "Este deve ser um bom lugar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:225
translate brazil ch2sc27_e057c1e6:

#   el "Huh?"
    el "Huh?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:227
translate brazil ch2sc27_4ce24373:

#   elt "I must’ve fallen asleep."
    elt "Devo ter adormecido."

# game/chapters/chapter1_5/script/ch2sc2.rpy:228
translate brazil ch2sc27_c36383f9:

#   elt "I can’t believe he’s carried me for so long. His back must be sore by now. It’s been hours."
    elt "Não acredito que ele me carregou por tanto tempo. As costas dele devem estar doendo agora. Já se passaram horas."

# game/chapters/chapter1_5/script/ch2sc2.rpy:230
translate brazil ch2sc27_06b6dad5:

#   mct "This spot looks suitable for tonight."
    mct "Este lugar parece adequado para esta noite."

# game/chapters/chapter1_5/script/ch2sc2.rpy:232
translate brazil ch2sc27_690a85cd:

#   mc "We’ll camp here for the night."
    mc "Vamos acampar aqui esta noite."

# game/chapters/chapter1_5/script/ch2sc2.rpy:234
translate brazil ch2sc27_72b4d82e:

#   el "Are you sure it’s safe?"
    el "Tem certeza de que é seguro?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:236
translate brazil ch2sc27_f800bed0:

#   mc "Yes."
    mc "Sim."

# game/chapters/chapter1_5/script/ch2sc2.rpy:238
translate brazil ch2sc27_408cb542:

#   el "Did you check?"
    el "Você verificou?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:240
translate brazil ch2sc27_cc761816:

#   mc "No..."
    mc "Não..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:242
translate brazil ch2sc27_9cf17044:

#   el "Then how can you be sure?"
    el "Então, como você pode ter certeza?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:244
translate brazil ch2sc27_c1e5efc4:

#   mct "This girl..."
    mct "Essa garota..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:246
translate brazil ch2sc27_5c63a388:

#   el "I’ll make a fire while you check the area."
    el "Vou acender uma fogueira enquanto você verifica a área."

# game/chapters/chapter1_5/script/ch2sc2.rpy:248
translate brazil ch2sc27_295bbea7:

#   mct "..."
    mct "..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:249
translate brazil ch2sc27_80f75e78:

#   mct "At least she's not afraid to get her hands dirty, could've been worse."
    mct "Pelo menos ela não tem medo de sujar as mãos, poderia ter sido pior."

# game/chapters/chapter1_5/script/ch2sc2.rpy:251
translate brazil ch2sc27_145ae489:

#   el "Go on. I’m sure you’re starving as well. We'll cook something when you get back."
    el "Vamos lá. Tenho certeza de que você também está morrendo de fome. Vamos cozinhar algo quando você voltar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:253
translate brazil ch2sc27_75476186:

#   mc "I’m going, I’m going..."
    mc "Eu vou, eu vou..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:255
translate brazil ch2sc27_2959bc4b:

#   mct "She’s definitely his daughter. Bossy and annoying, just like him."
    mct "Ela é definitivamente filha dele. Mandona e irritante, exatamente como ele."

# game/chapters/chapter1_5/script/ch2sc2.rpy:257
translate brazil ch2sc27_86f36819:

#   mct "I wonder if this is what he had in mind..."
    mct "Será que era isso que ele tinha em mente...?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:258
translate brazil ch2sc27_9a8a6e21:

#   mct "When he asked me to find her?"
    mct "Quando ele me pediu para encontrá-la?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:260
translate brazil ch2sc27_4cf3c2f2:

#   mct "He never said why... only that he wanted me to watch over her."
    mct "Ele nunca disse porquê... apenas que queria que eu cuidasse dela."

# game/chapters/chapter1_5/script/ch2sc2.rpy:262
translate brazil ch2sc27_568de5e9:

#   mct "What was your plan Oren?"
    mct "Qual era o seu plano, Oren?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:264
translate brazil ch2sc27_4587fa31:

#   mct "Area seems safe. I'll head back."
    mct "A área parece segura. Vou voltar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:272
translate brazil ch2sc27_22061878:

#   mct "Huh, is she... Humming?"
    mct "Hum, será que ela está... cantarolando?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:274
translate brazil ch2sc27_9613262f:

#   el "*Hums* Hm mh hm Mh..."
    el "*Hummm* Hm mh hm Mh..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:276
translate brazil ch2sc27_029170ed:

#   el "*Sings* Our ancient world... Felt newborn in his eyes... "
    el "*Canta* Nosso mundo ancestral... Sentiu-se recém-nascido aos seus olhos... "

# game/chapters/chapter1_5/script/ch2sc2.rpy:277
translate brazil ch2sc27_d65f4fbd:

#   el "*Sings* No place could keep him... As he yearned for the skies."
    el "*Canta* Nenhum lugar poderia retê-lo... Enquanto ele ansiava pelos céus."

# game/chapters/chapter1_5/script/ch2sc2.rpy:279
translate brazil ch2sc27_a6a9bb01:

#   el "*Sings* He abandoned the ways... That the divines foresaw..."
    el "*Canta* Ele abandonou os caminhos... Que os divinos previram..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:280
translate brazil ch2sc27_f7f03f11:

#   el "*Sings* He carved a path of his own... As a wayward soul..."
    el "*Canta* Ele trilhou seu próprio caminho... Como uma alma errante..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:282
translate brazil ch2sc27_a904e80d:

#   el "*Sings* Yet the dreams he sought... Were as distant as ever before..."
    el "*Canta* Mas os sonhos que ele buscava... Estavam tão distantes como sempre..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:284
translate brazil ch2sc27_885597a0:

#   el "..."
    el "..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:286
translate brazil ch2sc27_9399c36b:

#   mct "Her voice... There’s something about it. It feels... soothing."
    mct "A voz dela... Tem algo nela. É... reconfortante."

# game/chapters/chapter1_5/script/ch2sc2.rpy:287
translate brazil ch2sc27_85434d33:

#   mct "Her life has been rough and she lost both her parents, as I did. Yet she's managed to remain pure."
    mct "A vida dela tem sido difícil e ela perdeu os pais, assim como eu. Mesmo assim, ela conseguiu manter-se pura."

# game/chapters/chapter1_5/script/ch2sc2.rpy:289
translate brazil ch2sc27_1602f024:

#   mct "She isn’t consumed by the desire for revenge, like I am."
    mct "Ela não é consumida pelo desejo de vingança, como eu."

# game/chapters/chapter1_5/script/ch2sc2.rpy:290
translate brazil ch2sc27_f29a33ba:

#   mc "*Quietly* {size=-10}{b}Oren... I will keep my promise. I will watch over her.{/b}{/size}"
    mc "*Em silêncio* {size=-10}{b}Oren... Eu cumprirei minha promessa. Eu cuidarei dela.{/b}{/size}"

# game/chapters/chapter1_5/script/ch2sc2.rpy:293
translate brazil ch2sc27_0a172e46:

#   el "Huh? Who’s there?"
    el "Hein? Quem está aí?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:295
translate brazil ch2sc27_1cb8f465:

#   mc "I was wondering how long it would take you to sense me."
    mc "Gostaria de saber quanto tempo levaria para você me perceber."

# game/chapters/chapter1_5/script/ch2sc2.rpy:297
translate brazil ch2sc27_bfdc844e:

#   elt "Did he hear me sing!?"
    elt "Ele me ouviu cantar!?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:299
translate brazil ch2sc27_a12aac9e:

#   el "Did you... ?"
    el "Você fez... ?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:301
translate brazil ch2sc27_b77f9d0c:

#   mc "Did I what?"
    mc "Fiz o quê?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:303
translate brazil ch2sc27_87b4b38d:

#   el "Ugh! Nevermind. Come on, let's eat!"
    el "Ah, deixa pra lá. Vamos comer!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:305
translate brazil ch2sc27_d71c6e4e:

#   mc "I’m not hungry..."
    mc "Não estou com fome..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:308
translate brazil ch2sc27_d6c009ba:

#   mc "*Belly rumbles*..."
    mc "*Barriga roncando*..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:310
translate brazil ch2sc27_fc1fc107:

#   el "You were saying?"
    el "Você estava dizendo?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:312
translate brazil ch2sc27_e7ce7fd3:

#   el "It’s been a while since you had a decent meal. I can tell."
    el "Já faz um tempo que você não come uma refeição decente. Dá para perceber."

# game/chapters/chapter1_5/script/ch2sc2.rpy:314
translate brazil ch2sc27_bd886342:

#   mc "That obvious?"
    mc "Tão óbvio assim?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:316
translate brazil ch2sc27_1150db1b:

#   el "*Giggles* Uh huh! Enjoy!"
    el "*Risos* Uhum! Aproveite!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:325
translate brazil ch2sc27_1caa60d0:

#   el "I didn’t poison it if that’s what you’re thinking..."
    el "Eu não envenenei, se é isso que você está pensando..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:327
translate brazil ch2sc27_854e1f9f:

#   mc "Huh? Oh, I was just thinking it’s been a while since I had something that smelled this savory."
    mc "Hã? Ah, eu estava pensando que já faz um tempo que não como algo com um cheiro tão apetitoso."

# game/chapters/chapter1_5/script/ch2sc2.rpy:329
translate brazil ch2sc27_09b34311:

#   el "Go on... try it!"
    el "Vamos lá... experimente!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:333
translate brazil ch2sc27_fbbfbeb8:

#   mc "D-Delicious!"
    mc "Delicioso!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:335
translate brazil ch2sc27_5bd067cf:

#   "You both finish up eating and spend some time warming by the fire."
    "Vocês dois terminam de comer e passam algum tempo se aquecendo junto à lareira."

# game/chapters/chapter1_5/script/ch2sc2.rpy:337
translate brazil ch2sc27_29b9043d:

#   mc "Your voice... it’s calming."
    mc "Sua voz... é tranquilizante."

# game/chapters/chapter1_5/script/ch2sc2.rpy:339
translate brazil ch2sc27_ed50986a:

#   el "I knew you heard me! Y-You jerk!"
    el "Eu sabia que você tinha me ouvido! Seu idiota!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:341
translate brazil ch2sc27_a0c29a31:

#   el "Hnngh..."
    el "Hnngh..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:343
translate brazil ch2sc27_eff39f15:

#   el "Y-You really think my voice is calming?"
    el "Você realmente acha que minha voz é calmante?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:346
translate brazil ch2sc27_ca68df4f:

#   mc "It reminded me of when Mama used to sing me lullabies."
    mc "Isso me fez lembrar de quando mamãe cantava canções de ninar para mim."

# game/chapters/chapter1_5/script/ch2sc2.rpy:348
translate brazil ch2sc27_393bef40:

#   elt "Why does that make me happy?"
    elt "Por que isso me faz feliz?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:350
translate brazil ch2sc27_12f66dc2:

#   el "Err, well... don’t get used to it, okay?"
    el "Bem... não se acostume com isso, ok?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:352
translate brazil ch2sc27_6afd1bfb:

#   el "*Whispers* {size=-10}{b}I’m glad you liked it...{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Que bom que você gostou...{/b}{/size}"

# game/chapters/chapter1_5/script/ch2sc2.rpy:354
translate brazil ch2sc27_582359ea:

#   mc "Hm?"
    mc "Hum?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:356
translate brazil ch2sc27_119c06d8:

#   el "Nothing!"
    el "Nada!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:358
translate brazil ch2sc27_3b68bfab:

#   "You both watch the enchanting flames of the campfire for a while."
    "Vocês dois ficam observando as chamas encantadoras da fogueira por um tempo."

# game/chapters/chapter1_5/script/ch2sc2.rpy:363
translate brazil ch2sc27_b9a81d6a:

#   uk "Help!! Somebody help!"
    uk "Socorro!! Alguém me ajude!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:365
translate brazil ch2sc27_64ebe44d:

#   el "Did you hear that?"
    el "Você ouviu isso?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:367
translate brazil ch2sc27_69c25b65:

#   mc "Yeah..."
    mc "Sim..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:368
translate brazil ch2sc27_7ae2736b:

#   mc "Sounds like someone is in trouble..."
    mc "Parece que alguém está em apuros..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:370
translate brazil ch2sc27_b2d66e0d:

#   el "We have to help them!"
    el "Temos que ajudá-los!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:372
translate brazil ch2sc27_716e6fed:

#   uk "{b}HELP!{/b}"
    uk "{b}AJUDA!{/b}"

# game/chapters/chapter1_5/script/ch2sc2.rpy:374
translate brazil ch2sc27_3dc0a1a6:

#   mc "*Sigh* I’ll go check it out. You stay here."
    mc "*Suspiro* Vou lá dar uma olhada. Você fica aqui."

# game/chapters/chapter1_5/script/ch2sc2.rpy:376
translate brazil ch2sc27_3424846f:

#   el "What? But I..."
    el "O quê? Mas eu..."

# game/chapters/chapter1_5/script/ch2sc2.rpy:379
translate brazil ch2sc27_b9b1b22e:

#   mc "Eliza!"
    mc "Eliza!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:381
translate brazil ch2sc27_d908aab4:

#   el "Okay, okay. I’ll stay."
    el "Ok, ok. Eu fico."

# game/chapters/chapter1_5/script/ch2sc2.rpy:383
translate brazil ch2sc27_d7ca4980:

#   mc "I’ll be back soon."
    mc "Voltarei em breve."

# game/chapters/chapter1_5/script/ch2sc2.rpy:385
translate brazil ch2sc27_2ded5ccf:

#   elt "Grr! I want to help. But [mc]... I haven't seen him that serious before."
    elt "Grrr! Quero ajudar. Mas [mc]... Nunca o vi tão sério antes."

# game/chapters/chapter1_5/script/ch2sc2.rpy:387
translate brazil ch2sc27_2346aa06:

#   mct "I can’t risk anyone seeing Eliza... just in case."
    mct "Não posso arriscar que alguém veja a Eliza... por precaução."

# game/chapters/chapter1_5/script/ch2sc2.rpy:389
translate brazil ch2sc27_2ccf0a94:

#   mct "The scream came from over here."
    mct "O grito veio daqui."

# game/chapters/chapter1_5/script/ch2sc2.rpy:391
translate brazil ch2sc27_ad6efa7d:

#   mct "That’s gotta be the girl we heard calling for help."
    mct "Essa deve ser a garota que ouvimos pedindo socorro."

# game/chapters/chapter1_5/script/ch2sc2.rpy:393
translate brazil ch2sc27_669664cb:

#   mc "Hey."
    mc "Ei."

# game/chapters/chapter1_5/script/ch2sc2.rpy:396
translate brazil ch2sc27_327a35be:

#   uk "Aaah!!"
    uk "Aaah!!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:398
translate brazil ch2sc27_27f14ab6:

#   mc "Take it easy. I didn’t mean to startle you. I heard your calls for help?"
    mc "Calma. Não queria te assustar. Ouvi seus pedidos de socorro."

# game/chapters/chapter1_5/script/ch2sc2.rpy:399
translate brazil ch2sc27_8c26cb31:

#   mc "What's going on?"
    mc "O que está acontecendo?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:401
translate brazil ch2sc27_73b50f64:

#   uk "Oh, thank the gods! I'm so relieved someone heard me!"
    uk "Oh, graças aos deuses! Estou tão aliviada que alguém me ouviu!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:403
translate brazil ch2sc27_f0a2c3d9:

#   mc "What has you so troubled that you’re running around the woods at night, screaming for help?"
    mc "O que te aflige tanto a ponto de você estar correndo pela floresta à noite, gritando por socorro?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:405
translate brazil ch2sc27_ca3ceb0c:

#   uk "M-My friends and I were attacked by a troll, sir!"
    uk "M-Meus amigos e eu fomos atacados por um troll, senhor!"

# game/chapters/chapter1_5/script/ch2sc2.rpy:407
translate brazil ch2sc27_01880741:

#   uk "I’ve got no idea if any of the others got out alive! We were just looking for a spot to camp."
    uk "Não faço ideia se algum dos outros conseguiu sair com vida! Estávamos apenas procurando um lugar para acampar."

# game/chapters/chapter1_5/script/ch2sc2.rpy:409
translate brazil ch2sc27_b8f5e3a5:

#   uk "I’m so scared! The troll... it was horrible! T-The gut wrenching sounds it made."
    uk "Estou com tanto medo! O troll... foi horrível! Os sons de revirar o estômago que ele fazia."

# game/chapters/chapter1_5/script/ch2sc2.rpy:411
translate brazil ch2sc27_ccae0051:

#   mc "Calm down, We’ll find your friends. What’s your name?"
    mc "Calma, vamos encontrar seus amigos. Qual é o seu nome?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:413
translate brazil ch2sc27_0e7b4a79:

#   ir "I-Irene. What about you?"
    ir "I-Irene. E você?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:415
translate brazil ch2sc27_349a6c2f:

#   mc "I’m [mc]. Nice to meet you, Irene."
    mc "Eu sou [mc] Prazer em conhecê-la, Irene."

# game/chapters/chapter1_5/script/ch2sc2.rpy:417
translate brazil ch2sc27_b4384cf7:

#   ir "Pleasure is all mine, [mc]."
    ir "O prazer é todo meu, [mc]."

# game/chapters/chapter1_5/script/ch2sc2.rpy:418
translate brazil ch2sc27_d6ad26a7:

#   ir "I can’t believe I’m lucky enough to actually find anyone out here in the dark."
    ir "Não consigo acreditar que tive a sorte de encontrar alguém aqui no escuro."

# game/chapters/chapter1_5/script/ch2sc2.rpy:420
translate brazil ch2sc27_eef34edd:

#   ir "I was sure the troll would find me."
    ir "Eu tinha certeza de que o troll me encontraria."

# game/chapters/chapter1_5/script/ch2sc2.rpy:422
translate brazil ch2sc27_e91fc573:

#   mc "It’s alright, Irene. Now why don’t you take me back to where it happened?"
    mc "Está tudo bem, Irene. Agora, por que você não me leva de volta ao lugar onde tudo aconteceu?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:424
translate brazil ch2sc27_2b5101e4:

#   ir "Go back there? A-Are you sure that’s a good idea?"
    ir "Voltar para lá? T-Tem certeza de que é uma boa ideia?"

# game/chapters/chapter1_5/script/ch2sc2.rpy:426
translate brazil ch2sc27_52dd0e10:

#   mc "If we don’t, then we won’t know what happened to your friends."
