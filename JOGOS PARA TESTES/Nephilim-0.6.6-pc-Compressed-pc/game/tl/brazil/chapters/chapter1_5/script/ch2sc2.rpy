#   mc "......."
    mc "......."

# game/chapters/chapter1_5/script/ch2sc2.rpy:1889
translate brazil ch2sc27_183fcd64:

#   el "{size=+20}{b}................{/b}{/size}"
    el "{size=+20}{b}................{/b}{/size}"

