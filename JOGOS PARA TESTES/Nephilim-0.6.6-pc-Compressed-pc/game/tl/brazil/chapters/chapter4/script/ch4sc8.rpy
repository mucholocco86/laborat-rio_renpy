# ARQUIVO: game/chapters/chapter4/script/ch4sc8.rpy DIALOGOS: 313


# game/chapters/chapter4/script/ch4sc8.rpy:11
translate brazil ch4sc8_53ebe255:

#   mc "Hey Flynn."
    mc "Olá, Flynn."

# game/chapters/chapter4/script/ch4sc8.rpy:13
translate brazil ch4sc8_efe04259:

#   fy "Cuz! About time!"
    fy "Porque já era hora!"

# game/chapters/chapter4/script/ch4sc8.rpy:14
translate brazil ch4sc8_c8143fdf:

#   fy "You’ll never believe what I’m seeing right now!"
    fy "Você não vai acreditar no que estou vendo agora!"

# game/chapters/chapter4/script/ch4sc8.rpy:15
translate brazil ch4sc8_94ffeb77:

#   fy "I think I’m in love!"
    fy "Acho que estou apaixonado!"

# game/chapters/chapter4/script/ch4sc8.rpy:17
translate brazil ch4sc8_ef8095bb:

#   mc "*Sigh* I’m going to regret this..."
    mc "*Suspiro* Vou me arrepender disso..."

# game/chapters/chapter4/script/ch4sc8.rpy:18
translate brazil ch4sc8_6724c691:

#   mc "Who are you in love with?"
    mc "Por quem você está apaixonado(a)?"

# game/chapters/chapter4/script/ch4sc8.rpy:20
translate brazil ch4sc8_798573f7:

#   fy "Only the two most beautiful creatures I’ve ever laid eyes on! Look!"
    fy "As duas criaturas mais lindas que meus olhos já viram! Olhem!"

# game/chapters/chapter4/script/ch4sc8.rpy:25
translate brazil ch4sc8_7c9bea07:

#   fy "{b}Pearl{/b} and {b}Kira{/b}... The twin daughters of pirate king, {b}Blackheart{/b}."
    fy "{b}Pérola{/b} e {b} Kira{/b}... As filhas gêmeas do rei pirata, {b} Coração Negro{/b}."

# game/chapters/chapter4/script/ch4sc8.rpy:26
translate brazil ch4sc8_1ac85db0:

#   fy "Princesses of the Cerulean sea."
    fy "Princesas do Mar Cerúleo."

# game/chapters/chapter4/script/ch4sc8.rpy:28
translate brazil ch4sc8_214e9b0d:

#   fy "Pearl is the blonde who dresses in blue. She's known as '{b}The Iridescent Blade{/b}'"
    fy "Pearl é a loira que se veste de azul. Ela é conhecida como '{b}A Lâmina Iridescente{/b}'"

# game/chapters/chapter4/script/ch4sc8.rpy:29
translate brazil ch4sc8_6148fe15:

#   fy "Apparently, she's so quick and precise when she fights that her blades are never stained with blood."
    fy "Aparentemente, ela é tão rápida e precisa em combate que suas lâminas nunca ficam manchadas de sangue."

# game/chapters/chapter4/script/ch4sc8.rpy:31
translate brazil ch4sc8_d1597471:

#   fy "Thus allowing her blades to remain shiny like iridescent jewels."
    fy "Permitindo assim que suas lâminas permaneçam brilhantes como joias iridescentes."

# game/chapters/chapter4/script/ch4sc8.rpy:32
translate brazil ch4sc8_05160d2e:

#   fy "And Kira is the one with scarlet hair. She is known as '{b}The Crimson Dancer{/b}'"
    fy "E Kira é aquela com cabelo escarlate. Ela é conhecida como '{b}A Dançarina Carmesim{/b}'"

# game/chapters/chapter4/script/ch4sc8.rpy:34
translate brazil ch4sc8_db4d5200:

#   fy "Which is also fitting, because they say it's like watching a dancer perform whenever she fights."
    fy "O que também faz sentido, porque dizem que é como assistir a uma dançarina se apresentar sempre que ela luta."

# game/chapters/chapter4/script/ch4sc8.rpy:35
translate brazil ch4sc8_e094c054:

#   fy "Only, instead of bringing joy and smiles to the crowd..."
    fy "Só que, em vez de trazer alegria e sorrisos à multidão..."

# game/chapters/chapter4/script/ch4sc8.rpy:36
translate brazil ch4sc8_6e76a7ba:

#   fy "Her dancing brings a bloody end to her opponents."
    fy "Sua dança traz um fim sangrento aos seus oponentes."

# game/chapters/chapter4/script/ch4sc8.rpy:37
translate brazil ch4sc8_4c2cdcf8:

#   fy "Hence, 'The Crimson Dancer'"
    fy "Portanto, 'A Dançarina Carmesim'"

# game/chapters/chapter4/script/ch4sc8.rpy:39
translate brazil ch4sc8_fcbf50bc:

#   mc "Do I even want to know how you know all this?"
    mc "Será que eu realmente quero saber como você sabe de tudo isso?"

# game/chapters/chapter4/script/ch4sc8.rpy:41
translate brazil ch4sc8_74aa17b8:

#   fy "I’ve wanted to be a pirate... Err... Privateer my entire life, cuz!"
    fy "Sempre quis ser um pirata... Quer dizer... um corsário, meu chapa!"

# game/chapters/chapter4/script/ch4sc8.rpy:43
translate brazil ch4sc8_a613f5a0:

#   fy "And these two aren't just beautiful goddesses, they're two of the most infamous pirates!"
    fy "E essas duas não são apenas belas deusas, elas são duas das piratas mais infames!"

# game/chapters/chapter4/script/ch4sc8.rpy:44
translate brazil ch4sc8_f2b17616:

#   fy "Excluding their father, Blackheart, obviously."
    fy "Excluindo o pai deles, Blackheart, obviamente."

# game/chapters/chapter4/script/ch4sc8.rpy:46
translate brazil ch4sc8_a0cd5e9c:

#   mc "Well, it seems that fate has smiled upon you. You'll get to meet your idols."
    mc "Bem, parece que a sorte lhe sorriu. Você terá a oportunidade de conhecer seus ídolos."

# game/chapters/chapter4/script/ch4sc8.rpy:47
translate brazil ch4sc8_4e5409b3:

#   mc "We’re sailing to Isla de Inmortui with them and their crew."
    mc "Estamos navegando para a Ilha de Inmortui com eles e sua tripulação."

# game/chapters/chapter4/script/ch4sc8.rpy:50
translate brazil ch4sc8_166783d5:

#   fy "{b}*Shouts* Yahoooh!!{/b}"
    fy "{b}*Grita* Uhuuu!!{/b}"

# game/chapters/chapter4/script/ch4sc8.rpy:52
translate brazil ch4sc8_6dce8946:

#   mc "C'mon, let's go meet them..."
    mc "Vamos lá, vamos encontrá-los..."

# game/chapters/chapter4/script/ch4sc8.rpy:56
translate brazil ch4sc8_c89fc0d6:

#   ki "Hey, Pearl. Have you seen Kelly?"
    ki "Ei, Pearl. Você viu a Kelly?"

# game/chapters/chapter4/script/ch4sc8.rpy:58
translate brazil ch4sc8_f02490e5:

#   pl "Sis! Hummmmh... Kelly? No, I haven't seen her since last night."
    pl "Irmã! Hummm... Kelly? Não, não a vejo desde ontem à noite."

# game/chapters/chapter4/script/ch4sc8.rpy:59
translate brazil ch4sc8_4a2f4cd3:

#   pl "She went drinking with the crew I think."
    pl "Acho que ela saiu para beber com a equipe."

# game/chapters/chapter4/script/ch4sc8.rpy:61
translate brazil ch4sc8_742a1f68:

#   ki "Great... another problem to solve before we can set sail."
    ki "Ótimo... mais um problema para resolver antes de podermos zarpar."

# game/chapters/chapter4/script/ch4sc8.rpy:62
translate brazil ch4sc8_87d7aba2:

#   ki "I just want to get back on the water... I hate being docked!"
    ki "Só quero voltar para a água... Odeio ficar atracado!"

# game/chapters/chapter4/script/ch4sc8.rpy:64
translate brazil ch4sc8_5ac35668:

#   pl "Look, Kira! We have visitors."
    pl "Olha, Kira! Temos visitas."

# game/chapters/chapter4/script/ch4sc8.rpy:65
translate brazil ch4sc8_034fcdce:

#   pl "Isn’t that the guy we saw in the city?"
    pl "Não é aquele cara que vimos na cidade?"

# game/chapters/chapter4/script/ch4sc8.rpy:68
translate brazil ch4sc8_428f6bf8:

#   pl "You know? The one you couldn’t take your eyes off!"
    pl "Sabe? Aquela de quem você não conseguia desviar o olhar!"

# game/chapters/chapter4/script/ch4sc8.rpy:71
translate brazil ch4sc8_3ca741a9:

#   ki "{b}Pearl!!{/b} Keep your trap shut or I swear by the sea!"
    ki "{b}Pérola!!{/b} Cale a boca ou eu juro pelo mar!"

# game/chapters/chapter4/script/ch4sc8.rpy:72
translate brazil ch4sc8_b03629a2:

#   ki "Not another peep out of you about this! Understood?"
    ki "Nem mais um pio seu sobre isso! Entendido?"

# game/chapters/chapter4/script/ch4sc8.rpy:73
translate brazil ch4sc8_ef7d1146:

#   pl "*Muffled* Mnhhn! Hnhhnhmm!"
    pl "*Abafado* Mnhhn! Hnhhnhmm!"

# game/chapters/chapter4/script/ch4sc8.rpy:75
translate brazil ch4sc8_7fce88d1:

#   mc "Hey... Is this the 'Bloody Banshee'?"
    mc "Ei... Esta é a 'Banshee Sangrenta'?"

# game/chapters/chapter4/script/ch4sc8.rpy:76
translate brazil ch4sc8_69b32573:

#   pl "*Muffled* Mffh-hm! Hmmh-hhmm!"
    pl "*Abafado* Mffh-hm! Hmmh-hhmm!"

# game/chapters/chapter4/script/ch4sc8.rpy:78
translate brazil ch4sc8_2a0e3f11:

#   ki "So what if it is? You’re trespassing. State your business or I’ll feed you to the sharks."
    ki "E daí? Você está invadindo propriedade privada. Diga o que está fazendo ou eu te jogo aos tubarões."

# game/chapters/chapter4/script/ch4sc8.rpy:79
translate brazil ch4sc8_34279604:

#   ki "We’re not recruiting any new crew, if that’s what you’re hoping for."
    ki "Não estamos contratando novos tripulantes, se é isso que você está esperando."

# game/chapters/chapter4/script/ch4sc8.rpy:81
translate brazil ch4sc8_782d7576:

#   mc "No. That’s not why I’m here..."
    mc "Não. Não é por isso que estou aqui..."

# game/chapters/chapter4/script/ch4sc8.rpy:82
translate brazil ch4sc8_e11d7f20:

#   mc "A friend of mine, Dalen, he arranged transport for me and my cousin."
    mc "Um amigo meu, Dalen, providenciou transporte para mim e para meu primo."

# game/chapters/chapter4/script/ch4sc8.rpy:84
translate brazil ch4sc8_bd9d012e:

#   ki "So you’re the cargo we’re transporting? Figures. Nothing is ever simple with Dalen."
    ki "Então você é a carga que estamos transportando? Faz sentido. Com Dalen, nada é simples."

# game/chapters/chapter4/script/ch4sc8.rpy:86
translate brazil ch4sc8_d37f035c:

#   ki "..."
    ki "..."

# game/chapters/chapter4/script/ch4sc8.rpy:88
translate brazil ch4sc8_3caf0740:

#   ki "*Sigh* We do owe him... But don’t touch anything! You can take your belongings below deck."
    ki "*Suspiro* Nós lhe devemos um favor... Mas não toque em nada! Você pode levar seus pertences para o convés inferior."

# game/chapters/chapter4/script/ch4sc8.rpy:90
translate brazil ch4sc8_3f691d4f:

#   ki "I’m Kira, and this is my sister, Pearl."
    ki "Eu sou Kira, e esta é minha irmã, Pearl."

# game/chapters/chapter4/script/ch4sc8.rpy:91
translate brazil ch4sc8_d5e6d5ca:

#   ki "We’re the Captains of the {b}Bloody Banshee{/b}."
    ki "Nós somos os Capitães dos {b} Banshee Sangrenta{/b}."

# game/chapters/chapter4/script/ch4sc8.rpy:93
translate brazil ch4sc8_847a6e97:

#   ki "On this ship, our word is law."
    ki "Neste navio, nossa palavra é lei."

# game/chapters/chapter4/script/ch4sc8.rpy:94
translate brazil ch4sc8_7a8ffc8c:

#   ki "Step out of line and you’ll be fish food."
    ki "Se você sair da linha, vai virar comida de peixe."

# game/chapters/chapter4/script/ch4sc8.rpy:96
translate brazil ch4sc8_1be34d31:

#   ki "Did I cover everything, Pearl?"
    ki "Abordei tudo, Pearl?"

# game/chapters/chapter4/script/ch4sc8.rpy:98
translate brazil ch4sc8_84248ebc:

#   pl "Hi! Nice to meet you!"
    pl "Olá! Prazer em conhecê-lo(a)!"

# game/chapters/chapter4/script/ch4sc8.rpy:99
translate brazil ch4sc8_c947e005:

#   "The blonde shifts and begins to climb off the railing."
    "A loira se mexe e começa a descer do corrimão."

# game/chapters/chapter4/script/ch4sc8.rpy:101
translate brazil ch4sc8_e02633ea:

#   pl "You’re cute!"
    pl "Você é fofo(a)!"

# game/chapters/chapter4/script/ch4sc8.rpy:103
translate brazil ch4sc8_0796a72b:

#   "She walks over to you, her hips swaying with each step."
    "Ela caminha em sua direção, seus quadris balançando a cada passo."

# game/chapters/chapter4/script/ch4sc8.rpy:106
translate brazil ch4sc8_c8197789:

#   pl "*Whispers* My sister likes you."
    pl "*Sussurrando* Minha irmã gosta de você."

# game/chapters/chapter4/script/ch4sc8.rpy:108
translate brazil ch4sc8_78f3ac32:

#   mc "Likes me? She just threatened to feed me to the sharks..."
    mc "Gosta de mim? Ela acabou de ameaçar me dar de comida para os tubarões..."

# game/chapters/chapter4/script/ch4sc8.rpy:110
translate brazil ch4sc8_99e89ca8:

#   pl "Exactly! If anyone else trespassed on our ship, she'd have cut them down before they had a chance to speak."
    pl "Exatamente! Se alguém mais invadisse nosso navio, ela os teria abatido antes mesmo que tivessem a chance de falar."

# game/chapters/chapter4/script/ch4sc8.rpy:111
translate brazil ch4sc8_2e060df7:

#   pl "But she only threatened you. She definitely likes you!"
    pl "Mas ela só te ameaçou. Ela definitivamente gosta de você!"

# game/chapters/chapter4/script/ch4sc8.rpy:116
translate brazil ch4sc8_6c8d0c20:

#   mc "And what about you? Do you like me?"
    mc "E você? Gosta de mim?"

# game/chapters/chapter4/script/ch4sc8.rpy:118
translate brazil ch4sc8_95dac99e:

#   pl "Oh? You’re a cheeky one, aren’t you?"
    pl "Ah, é mesmo? Você é um atrevido, não é?"

# game/chapters/chapter4/script/ch4sc8.rpy:119
translate brazil ch4sc8_4524cb15:

#   pl "I just told you my sister likes you, and here you are... turning your attention to me?"
    pl "Acabei de te dizer que minha irmã gosta de você, e olha só... você voltando sua atenção para mim?"

# game/chapters/chapter4/script/ch4sc8.rpy:121
translate brazil ch4sc8_a96b32bc:

#   pl "For now, let’s just say... Mhhh..."
    pl "Por agora, digamos apenas... Hum..."

# game/chapters/chapter4/script/ch4sc8.rpy:123
translate brazil ch4sc8_907296b8:

#   pl "The jury is still out on that one! *Giggling softly*"
    pl "Ainda não há consenso sobre isso! *Risinhos discretos*"

# game/chapters/chapter4/script/ch4sc8.rpy:125
translate brazil ch4sc8_a9f4b96b:

#   pl "Play your cards right, and we’ll see..."
    pl "Jogue bem as suas cartas e veremos..."

# game/chapters/chapter4/script/ch4sc8.rpy:127
translate brazil ch4sc8_b47c6801:

#   pl "Play your cards badly... aaaaand I might just kill you! Hm-hm!"
    pl "Jogue mal as suas cartas... e eu posso te matar! Hm-hm!"

# game/chapters/chapter4/script/ch4sc8.rpy:131
translate brazil ch4sc8_2d062637:

#   mc "Does she always threaten guys?"
    mc "Ela sempre ameaça os homens?"

# game/chapters/chapter4/script/ch4sc8.rpy:133
translate brazil ch4sc8_aa6de7da:

#   pl "By the sea! No. She usually kills guys who try to woo her."
    pl "À beira-mar! Não. Ela costuma matar os caras que tentam conquistá-la."

# game/chapters/chapter4/script/ch4sc8.rpy:134
translate brazil ch4sc8_948229ec:

#   pl "As I said. She is totally into you. I’m curious to see why she's so smitten myself."
    pl "Como eu disse, ela está completamente a fim de você. Eu também estou curioso para saber por que ela está tão apaixonada."

# game/chapters/chapter4/script/ch4sc8.rpy:136
translate brazil ch4sc8_7a4dc090:

#   mc "I’ll take your word for it. I still think she hates me, though."
    mc "Acredito em você. Mesmo assim, continuo achando que ela me odeia."

# game/chapters/chapter4/script/ch4sc8.rpy:140
translate brazil ch4sc8_75239b22:

#   mc "I’m not looking for anything... Attachments only lead to pain."
    mc "Não estou à procura de nada... Apegos só levam à dor."

# game/chapters/chapter4/script/ch4sc8.rpy:142
translate brazil ch4sc8_b0c136cd:

#   pl "Boo! That’s no way to look at life. There’s so much beauty out there!"
    pl "Que pena! Essa não é maneira de encarar a vida. Há tanta beleza por aí!"

# game/chapters/chapter4/script/ch4sc8.rpy:143
translate brazil ch4sc8_d5622b91:

#   pl "Closing yourself off from the good emotions doesn’t mean you will become immune to the bad."
    pl "Isolar-se das emoções positivas não significa que você se tornará imune às negativas."

# game/chapters/chapter4/script/ch4sc8.rpy:147
translate brazil ch4sc8_695564ea:

#   mct "I hate to admit it... Flynn was on to something."
    mct "Tenho receio de admitir... Flynn estava certo em algo."

# game/chapters/chapter4/script/ch4sc8.rpy:148
translate brazil ch4sc8_d3dc7c7e:

#   mct "They are ridiculously beautiful..."
    mct "Eles são absurdamente lindos..."

# game/chapters/chapter4/script/ch4sc8.rpy:150
translate brazil ch4sc8_f7657126:

#   mct "You notice a slight movement towards you. But before you can react, Kira has already drawn her sword."
    mct "Você percebe um leve movimento em sua direção. Mas antes que possa reagir, Kira já desembainhou sua espada."

# game/chapters/chapter4/script/ch4sc8.rpy:156
translate brazil ch4sc8_765deedf:

#   ki "Let’s get one thing perfectly clear. I don’t {b}'like'{/b} you."
    ki "Vamos deixar uma coisa bem clara. Eu não {b}'como'{/b} você."

# game/chapters/chapter4/script/ch4sc8.rpy:157
translate brazil ch4sc8_e9507ace:

#   ki "You’re cargo. Nothing more. We drop you off at the agreed upon location."
    ki "Você é carga. Nada mais. Deixamos você no local combinado."

# game/chapters/chapter4/script/ch4sc8.rpy:159
translate brazil ch4sc8_42d96716:

#   ki "From there, you’re on your own. We won’t come back and pick you up."
    ki "A partir daí, você estará por sua conta. Não voltaremos para buscá-lo."

# game/chapters/chapter4/script/ch4sc8.rpy:163
translate brazil ch4sc8_fb97f3b8:

#   ki "I don’t care if you have to swim back to the capital, or ride a whale back."
    ki "Não me importo se você tiver que voltar nadando para a capital ou montado em uma baleia."

# game/chapters/chapter4/script/ch4sc8.rpy:165
translate brazil ch4sc8_043faf37:

#   ki "We’ve killed men that would eat you for breakfast. For a whole lot less."
    ki "Já matamos homens que te devorariam no café da manhã. Por muito menos."

# game/chapters/chapter4/script/ch4sc8.rpy:166
translate brazil ch4sc8_3878cc30:

#   ki "Are we clear?"
    ki "Ficou claro?"

# game/chapters/chapter4/script/ch4sc8.rpy:167
translate brazil ch4sc8_4595cecc:

#   mct "I'll let her believe she holds the power-dynamic here..."
    mct "Vou deixá-la acreditar que detém o poder aqui..."

# game/chapters/chapter4/script/ch4sc8.rpy:168
translate brazil ch4sc8_56976f19:

#   mct "Even though she wouldn't be able to pierce my skin with a normal blade, not since I absorbed the essence of the goblin berzerker."
    mct "Mesmo que ela não conseguisse perfurar minha pele com uma lâmina normal, não desde que absorvi a essência do goblin berserker."

# game/chapters/chapter4/script/ch4sc8.rpy:172
translate brazil ch4sc8_f3748294:

#   mc "We’re clear..."
    mc "Está tudo claro..."

# game/chapters/chapter4/script/ch4sc8.rpy:175
translate brazil ch4sc8_69eb496c:

#   mc "Now let me make one thing clear to you."
    mc "Agora, deixe-me esclarecer uma coisa para você."

# game/chapters/chapter4/script/ch4sc8.rpy:176
translate brazil ch4sc8_dd1a6ee1:

#   mc "You're the captain, I'll happily follow your lead."
    mc "Você é o capitão, e eu seguirei suas ordens com prazer."

# game/chapters/chapter4/script/ch4sc8.rpy:177
translate brazil ch4sc8_e39cb52a:

#   mc "But if you get in my way... I will hurt you."
    mc "Mas se você entrar no meu caminho... eu vou te machucar."

# game/chapters/chapter4/script/ch4sc8.rpy:180
translate brazil ch4sc8_910582d0:

#   "Seemingly taken aback by the balls you have to threaten her, Kira backs down."
    "Aparentemente surpresa com a sua audácia em ameaçá-la, Kira recua."

# game/chapters/chapter4/script/ch4sc8.rpy:181
translate brazil ch4sc8_e0c1bedb:

#   "You successfully managed to intimidate Kira for the time being."
    "Você conseguiu intimidar Kira com sucesso por enquanto."

# game/chapters/chapter4/script/ch4sc8.rpy:184
translate brazil ch4sc8_f9f75380:

#   ki "Hmph... you have balls, I'll give you that."
    ki "Hum... você tem coragem, isso eu admito."

# game/chapters/chapter4/script/ch4sc8.rpy:185
translate brazil ch4sc8_26f52bc8:

#   ki "But... we're clear."
    ki "Mas... está tudo claro."

# game/chapters/chapter4/script/ch4sc8.rpy:187
translate brazil ch4sc8_e732f9e2:

#   mc "I'm glad we managed to come to an understanding."
    mc "Fico feliz que tenhamos conseguido chegar a um entendimento."

# game/chapters/chapter4/script/ch4sc8.rpy:192
translate brazil ch4sc8_f5c25798:

#   mc "But if you get in my way... I will hurt."
    mc "Mas se você entrar no meu caminho... eu vou te machucar."

# game/chapters/chapter4/script/ch4sc8.rpy:195
translate brazil ch4sc8_de7b8995:

#   "Kira is slightly surprised you had the balls to threaten her, yet she doesn't back down."
    "Kira fica um pouco surpresa por você ter tido coragem de ameaçá-la, mas mesmo assim não recua."

# game/chapters/chapter4/script/ch4sc8.rpy:196
translate brazil ch4sc8_e87bea56:

#   "You didn't manage to intimidate Kira as your intimidation skill was too low."
    "Você não conseguiu intimidar Kira porque sua habilidade de intimidação era muito baixa."

# game/chapters/chapter4/script/ch4sc8.rpy:200
translate brazil ch4sc8_9c26775f:

#   ki "I'd love to cut them off and feed them to the sharks for that little stunt you just pulled."
    ki "Eu adoraria cortar seus dentes e dá-los de comida para os tubarões por essa sua pequena façanha."

# game/chapters/chapter4/script/ch4sc8.rpy:201
translate brazil ch4sc8_dd3e3bb1:

#   ki "Sadly I gave Dalen my word... I don't much like the idea of making an enemy of him."
    ki "Infelizmente, dei minha palavra a Dalen... Não gosto muito da ideia de me tornar inimigo dele."

# game/chapters/chapter4/script/ch4sc8.rpy:207
translate brazil ch4sc8_f92d96a2:

#   ki "*Scoffs* Yeah... now, I have a matter we need settled."
    ki "*Risos* É... agora, temos um assunto que precisamos resolver."

# game/chapters/chapter4/script/ch4sc8.rpy:208
translate brazil ch4sc8_1b442294:

#   ki "I have a task for you. Our steward, Kelly, is missing. She hasn’t returned from shore leave."
    ki "Tenho uma tarefa para você. Nossa comissária de bordo, Kelly, está desaparecida. Ela não retornou de sua licença em terra."

# game/chapters/chapter4/script/ch4sc8.rpy:210
translate brazil ch4sc8_1ce7b302:

#   ki "I’m worri- She needs to be found, okay? Being at sea for several moons without a steward isn’t pleasant."
    ki "Estou preocupada... Ela precisa ser encontrada, entendeu? Ficar no mar por várias luas sem um comissário de bordo não é nada agradável."

# game/chapters/chapter4/script/ch4sc8.rpy:212
translate brazil ch4sc8_28382045:

#   ki "Ask around the crew and see if they know anything."
    ki "Pergunte aos membros da tripulação e veja se eles sabem de alguma coisa."

# game/chapters/chapter4/script/ch4sc8.rpy:214
translate brazil ch4sc8_ccc28389:

#   ki "She supposedly went drinking with them last night. They must’ve seen something."
    ki "Ela supostamente saiu para beber com eles ontem à noite. Devem ter visto alguma coisa."

# game/chapters/chapter4/script/ch4sc8.rpy:216
translate brazil ch4sc8_947d8bea:

#   mc "Sure, I’ll help find her."
    mc "Claro, eu ajudo a encontrá-la."

# game/chapters/chapter4/script/ch4sc8.rpy:218
translate brazil ch4sc8_05970ae2:

#   ki "Great! Thank you!"
    ki "Ótimo! Obrigada!"

# game/chapters/chapter4/script/ch4sc8.rpy:220
translate brazil ch4sc8_ce38e7c5:

#   ki "I mean... Get to it! Your cousin can move your stuff into the lower deck where you’ll be sleeping."
    ki "Quer dizer... Mãos à obra! Seu primo pode levar suas coisas para o convés inferior, onde você vai dormir."

# game/chapters/chapter4/script/ch4sc8.rpy:224
translate brazil ch4sc8_8f0500ec:

#   mct "Great... I've become an errand boy for arrogant girls..."
    mct "Ótimo... Me tornei um faz-tudo para garotas arrogantes..."

# game/chapters/chapter4/script/ch4sc8.rpy:225
translate brazil ch4sc8_f3fa7873:

#   mct "I suppose I’ll start off by talking to some of the crew."
    mct "Acho que vou começar conversando com alguns membros da equipe."

# game/chapters/chapter4/script/ch4sc8.rpy:226
translate brazil ch4sc8_a4e62dfd:

#   mct "They were the last to see 'Kelly', after all."
    mct "Afinal, eles foram os últimos a ver 'Kelly'."

# game/chapters/chapter4/script/ch4sc8.rpy:227
translate brazil ch4sc8_998778a4:

#   mct "I’ll start with that old guy over there."
    mct "Vou começar por aquele senhor idoso ali."

# game/chapters/chapter4/script/ch4sc8.rpy:229
translate brazil ch4sc8_33b5032b:

#   mc "Excuse me, sir?"
    mc "Com licença, senhor?"

# game/chapters/chapter4/script/ch4sc8.rpy:231
translate brazil ch4sc8_a9bedf0a:

#   uk "Yes, yes, yes, yes?"
    uk "Sim, sim, sim, sim?"

# game/chapters/chapter4/script/ch4sc8.rpy:232
translate brazil ch4sc8_f2777267:

#   uk "What do you want? Why are you bothering me kid?"
    uk "O que você quer? Por que está me incomodando, garoto?"

# game/chapters/chapter4/script/ch4sc8.rpy:234
translate brazil ch4sc8_aa452d79:

#   mc "I’m looking for one of your crew..."
    mc "Estou procurando um dos membros da sua equipe..."

# game/chapters/chapter4/script/ch4sc8.rpy:235
translate brazil ch4sc8_fd4094ed:

#   mc "Kelly, I believe her name is?"
    mc "Kelly, acho que é esse o nome dela?"

# game/chapters/chapter4/script/ch4sc8.rpy:237
translate brazil ch4sc8_a616e687:

#   uk "Blimey! Is she not on deck yet?!"
    uk "Caramba! Ela ainda não está no convés?!"

# game/chapters/chapter4/script/ch4sc8.rpy:238
translate brazil ch4sc8_394b9c49:

#   uk "She'd better be soon! She's supposed to help me prepare supper before we set sail!"
    uk "É melhor ela chegar logo! Ela precisa me ajudar a preparar o jantar antes de zarparmos!"

# game/chapters/chapter4/script/ch4sc8.rpy:240
translate brazil ch4sc8_9a8bce12:

#   mc "So... I take it you don’t know where she is then?"
    mc "Então... presumo que você não saiba onde ela está?"

# game/chapters/chapter4/script/ch4sc8.rpy:242
translate brazil ch4sc8_5a21c7ac:

#   uk "..."
    uk "..."

# game/chapters/chapter4/script/ch4sc8.rpy:244
translate brazil ch4sc8_499837c1:

#   uk "Do I look like I know where she is?!"
    uk "Por acaso eu pareço saber onde ela está?!"

# game/chapters/chapter4/script/ch4sc8.rpy:246
translate brazil ch4sc8_a871858b:

#   mc "No. I suppose you don’t."
    mc "Não. Acho que não."

# game/chapters/chapter4/script/ch4sc8.rpy:248
translate brazil ch4sc8_52081392:

#   uk "Crikey! Leave me alone then!"
    uk "Puxa! Então me deixe em paz!"

# game/chapters/chapter4/script/ch4sc8.rpy:249
translate brazil ch4sc8_fdc02146:

#   uk "Unless you want to take on Kelly's duty as steward, I suggest you leave at once!"
    uk "A menos que você queira assumir as funções de comissário de bordo que eram de Kelly, sugiro que se retire imediatamente!"

# game/chapters/chapter4/script/ch4sc8.rpy:251
translate brazil ch4sc8_acb189b4:

#   mct "Sheesh... He sure had a temper for an old guy."
    mct "Nossa... Ele tinha um temperamento forte para um senhor de idade."

# game/chapters/chapter4/script/ch4sc8.rpy:252
translate brazil ch4sc8_b364ea31:

#   mct "There doesn’t seem to be anyone else up here."
    mct "Não parece haver mais ninguém aqui em cima."

# game/chapters/chapter4/script/ch4sc8.rpy:253
translate brazil ch4sc8_62165504:

#   mct "I better check the deck below."
    mct "É melhor eu verificar o baralho abaixo."

# game/chapters/chapter4/script/ch4sc8.rpy:257
translate brazil ch4sc8_c0c5eb3a:

#   mct "Flynn’s down here already."
    mct "Flynn já está aqui."

# game/chapters/chapter4/script/ch4sc8.rpy:259
translate brazil ch4sc8_db7f0987:

#   mc "Hey Flynn. Settling in already?"
    mc "E aí, Flynn. Já está se adaptando?"

# game/chapters/chapter4/script/ch4sc8.rpy:261
translate brazil ch4sc8_044ce4e9:

#   fy "Cuz! Look, look! Isn’t this just the greatest thing ever?"
    fy "Porque! Olha, olha! Isso não é simplesmente a coisa mais incrível do mundo?"

# game/chapters/chapter4/script/ch4sc8.rpy:262
translate brazil ch4sc8_2cff4db7:

#   fy "We’ll be sleeping on a ship! On open waters, no less!"
    fy "Vamos dormir num navio! Em mar aberto, nada menos!"

# game/chapters/chapter4/script/ch4sc8.rpy:264
translate brazil ch4sc8_7b7324fa:

#   mc "Dream come true, I take it?"
    mc "Um sonho realizado, suponho?"

# game/chapters/chapter4/script/ch4sc8.rpy:266
translate brazil ch4sc8_08c441d1:

#   fy "You know it! Just wait, this will be a blast!"
    fy "Você sabe disso! Espere só, vai ser incrível!"

# game/chapters/chapter4/script/ch4sc8.rpy:268
translate brazil ch4sc8_10903cf9:

#   fy "Did you see Kira? I think I’m in love!"
    fy "Você viu a Kira? Acho que estou apaixonado!"

# game/chapters/chapter4/script/ch4sc8.rpy:269
translate brazil ch4sc8_f2ef7468:

#   fy "Her crimson hair glistening in the sun's light... Her fiery attitude..."
    fy "Seus cabelos carmesins brilhando à luz do sol... Sua personalidade forte..."

# game/chapters/chapter4/script/ch4sc8.rpy:270
translate brazil ch4sc8_0c5bb2c9:

#   fy "I bet she's a real firecracker in the sheets too!"
    fy "Aposto que ela também é uma verdadeira dinamite na cama!"

# game/chapters/chapter4/script/ch4sc8.rpy:272
translate brazil ch4sc8_d560d9a8:

#   fy "She almost took my head clean off when I asked where to put our belongings!"
    fy "Ela quase me arrancou a cabeça quando perguntei onde colocar nossas coisas!"

# game/chapters/chapter4/script/ch4sc8.rpy:274
translate brazil ch4sc8_716019b8:

#   mc "Right."
    mc "Certo."

# game/chapters/chapter4/script/ch4sc8.rpy:275
translate brazil ch4sc8_52d0fcad:

#   mc "True love... you must really be blessed by the divines, Flynn."
    mc "Amor verdadeiro... você deve ser realmente abençoado pelos deuses, Flynn."

# game/chapters/chapter4/script/ch4sc8.rpy:277
translate brazil ch4sc8_f630fd73:

#   fy "I know, right?!"
    fy "Eu sei direito?!"

# game/chapters/chapter4/script/ch4sc8.rpy:278
translate brazil ch4sc8_b7e9310d:

#   fy "I almost couldn’t believe it when you said we’d be sailing with Kira and Pearl!"
    fy "Quase não acreditei quando você disse que iríamos navegar com Kira e Pearl!"

# game/chapters/chapter4/script/ch4sc8.rpy:280
translate brazil ch4sc8_46fefc78:

#   mc "As much as your infatuation with those women fascinates me, I’m looking for a girl named Kelly."
    mc "Por mais que sua paixão por essas mulheres me fascine, estou procurando uma garota chamada Kelly."

# game/chapters/chapter4/script/ch4sc8.rpy:281
translate brazil ch4sc8_fb6bbfaf:

#   mc "She's part of the crew and has been missing since last night, according to Kira."
    mc "Ela faz parte da tripulação e está desaparecida desde ontem à noite, de acordo com Kira."

# game/chapters/chapter4/script/ch4sc8.rpy:282
translate brazil ch4sc8_90d57f59:

#   mc "Have you seen or heard anything while settling in?"
    mc "Você viu ou ouviu alguma coisa enquanto se instalava?"

# game/chapters/chapter4/script/ch4sc8.rpy:284
translate brazil ch4sc8_338a6f07:

#   fy "Sorry, cuz. I've been occupied with getting our stuff onboard."
    fy "Desculpe, primo. Estive ocupado colocando nossas coisas a bordo."

# game/chapters/chapter4/script/ch4sc8.rpy:286
translate brazil ch4sc8_82d963ba:

#   fy "But there’s a guy in the back, maybe he knows something?"
    fy "Mas tem um cara lá atrás, talvez ele saiba de alguma coisa?"

# game/chapters/chapter4/script/ch4sc8.rpy:287
translate brazil ch4sc8_b0aae802:

#   fy "I’m not sure he likes me."
    fy "Não tenho certeza se ele gosta de mim."

# game/chapters/chapter4/script/ch4sc8.rpy:288
translate brazil ch4sc8_0ee9b157:

#   fy "He just kept licking his lips and staring at me when I tried to introduce myself to him."
    fy "Ele ficou lambendo os lábios e me encarando enquanto eu tentava me apresentar."

# game/chapters/chapter4/script/ch4sc8.rpy:290
translate brazil ch4sc8_a7fae983:

#   mc "Thanks, I’ll go see if he knows something... Catch you later."
    mc "Obrigado, vou ver se ele sabe de alguma coisa... Até mais."

# game/chapters/chapter4/script/ch4sc8.rpy:295
translate brazil ch4sc8_a15d334c:

#   mc "Hey..."
    mc "Ei..."

# game/chapters/chapter4/script/ch4sc8.rpy:297
translate brazil ch4sc8_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter4/script/ch4sc8.rpy:298
translate brazil ch4sc8_c078bcb0:

#   mc "*Sigh* Sir?"
    mc "*Suspiro* Senhor?"

# game/chapters/chapter4/script/ch4sc8.rpy:299
translate brazil ch4sc8_93642aea:

#   uk "Hrrh... sweet Kelly... hrrh..."
    uk "Hrrh... doce Kelly... hrrh..."

# game/chapters/chapter4/script/ch4sc8.rpy:305
translate brazil ch4sc8_e1c57670:

#   mct "I don't have time for this shit..."
    mct "Não tenho tempo para essa merda..."

# game/chapters/chapter4/script/ch4sc8.rpy:308
translate brazil ch4sc8_0c741678:

#   mc "{b}Hey!{/b} I’m talking to you!"
    mc "{b}Ei!{/b} Estou falando com você!"

# game/chapters/chapter4/script/ch4sc8.rpy:310
translate brazil ch4sc8_690104c7:

#   uk "Oh, yeah? What of it! I’m busy here!"
    uk "Ah, é? E daí? Estou ocupado aqui!"

# game/chapters/chapter4/script/ch4sc8.rpy:313
translate brazil ch4sc8_a6a83348:

#   uk "{b}Arrrhhh! Bloody shite!!{/b}"
    uk "{b}Arrrr! Que merda!{/b}"

# game/chapters/chapter4/script/ch4sc8.rpy:315
translate brazil ch4sc8_9bab52a8:

#   uk "Release me!{b} Ahhrrr!!{/b}"
    uk "Solte-me!{b} Ahhrrr!!{/b}"

# game/chapters/chapter4/script/ch4sc8.rpy:317
translate brazil ch4sc8_9d062bd4:

#   mc "I tried asking nicely. So, listen carefully... I hate repeating myself."
    mc "Tentei pedir educadamente. Então, ouça com atenção... Detesto me repetir."

# game/chapters/chapter4/script/ch4sc8.rpy:319
translate brazil ch4sc8_fe9eaef1:

#   mc "The captain has tasked me to find one of your crew who’s been missing since last night, Kelly."
    mc "O capitão me incumbiu de encontrar um dos seus tripulantes que está desaparecido desde ontem à noite, Kelly."

# game/chapters/chapter4/script/ch4sc8.rpy:321
translate brazil ch4sc8_9b06b95d:

#   mc "Now, I don’t care about this Kelly. But your captain is taking me somewhere important."
    mc "Bem, Kelly, eu não me importo com isso. Mas o seu capitão está me levando para um lugar importante."

# game/chapters/chapter4/script/ch4sc8.rpy:323
translate brazil ch4sc8_8a230d42:

#   mc "So, I intend to stay on her good side... assuming she even has one."
    mc "Então, pretendo continuar em boas graças com ela... supondo que ela tenha alguma."

# game/chapters/chapter4/script/ch4sc8.rpy:324
translate brazil ch4sc8_8495805f:

#   mc "But fat idiots with an attitude, like you? You'll find my patience runs low very quickly."
    mc "Mas idiotas gordos e arrogantes como você? Aí você vai ver que minha paciência se esgota rapidinho."

# game/chapters/chapter4/script/ch4sc8.rpy:326
translate brazil ch4sc8_9e6e791c:

#   mc "You have two options. Tell me everything you know about where Kelly is..."
    mc "Você tem duas opções. Conte-me tudo o que você sabe sobre o paradeiro de Kelly..."

# game/chapters/chapter4/script/ch4sc8.rpy:329
translate brazil ch4sc8_a4d679a4:

#   mc "Or I will snap your fat neck like a twig."
    mc "Ou então eu quebro seu pescoço gordo como se fosse um graveto."

# game/chapters/chapter4/script/ch4sc8.rpy:330
translate brazil ch4sc8_551aa1e9:

#   mc "Then toss your corpse out the window, and let the fishes pick your bones clean."
    mc "Depois, atire seu cadáver pela janela e deixe os peixes limparem seus ossos."

# game/chapters/chapter4/script/ch4sc8.rpy:332
translate brazil ch4sc8_8b1b18f5:

#   uk "I-I’ll tell ye! Everything!"
    uk "Eu vou te contar tudo!"

# game/chapters/chapter4/script/ch4sc8.rpy:333
translate brazil ch4sc8_1957e695:

#   uk "{b}SHITE!!{/b} Kelly, I last saw her last night... We were on shore leave, drinking at the drunk chicken tavern!"
    uk "{b}MERDA!!{/b} Kelly, a última vez que a vi foi ontem à noite... Estávamos de folga em terra, bebendo no bar do frango bêbado!"

# game/chapters/chapter4/script/ch4sc8.rpy:335
translate brazil ch4sc8_ed9088a2:

#   mc "Drunk chicken? You mean The Drunken Rooster?"
    mc "Frango bêbado? Você quer dizer o Galo Bêbado?"

# game/chapters/chapter4/script/ch4sc8.rpy:337
translate brazil ch4sc8_94818997:

#   uk "Yes, yes! That one! Last I saw that tease- Kelly, she was outside by herself."
    uk "Sim, sim! Aquela mesma! A última vez que vi aquela provocadora, Kelly, ela estava sozinha lá fora."

# game/chapters/chapter4/script/ch4sc8.rpy:338
translate brazil ch4sc8_1bf777de:

#   uk "I was drunk to the boot! Had to take a piss, ye know how it is."
    uk "Estava bêbado pra caramba! Precisava fazer xixi, sabe como é."

# game/chapters/chapter4/script/ch4sc8.rpy:339
translate brazil ch4sc8_eee0b339:

#   uk "I saw her alone and offered to bring her safely back to the ship!"
    uk "Eu a vi sozinha e me ofereci para levá-la de volta ao navio em segurança!"

# game/chapters/chapter4/script/ch4sc8.rpy:340
translate brazil ch4sc8_cec42faf:

#   uk "But that skank- Erh, she declined, and told me she’d be fine. Hah!"
    uk "Mas aquela vagabunda... Erh, ela recusou e me disse que tudo bem. Hah!"

# game/chapters/chapter4/script/ch4sc8.rpy:341
translate brazil ch4sc8_27f130d1:

#   uk "Fine, eh? Then why is she missing! What a foolish girl..."
    uk "Tudo bem, né? Então por que ela sumiu? Que menina tola..."

# game/chapters/chapter4/script/ch4sc8.rpy:342
translate brazil ch4sc8_655348ab:

#   uk "That’s all I know from last night! Now, let me go! I’ve told ye everything."
    uk "Isso é tudo que sei da noite passada! Agora, me deixem ir! Eu já contei tudo para vocês."

# game/chapters/chapter4/script/ch4sc8.rpy:344
translate brazil ch4sc8_fec8609b:

#   mc "If you’re lying... If I need to come back and talk to you again..."
    mc "Se você estiver mentindo... Se eu precisar voltar e conversar com você de novo..."

# game/chapters/chapter4/script/ch4sc8.rpy:345
translate brazil ch4sc8_5e64eb47:

#   mc "You won’t get the chance to explain. Are we clear?"
    mc "Você não terá a chance de explicar. Ficou claro?"

# game/chapters/chapter4/script/ch4sc8.rpy:348
translate brazil ch4sc8_cecac7df:

#   uk "C-Crystal! I swear on me ma’s life! That's all I know!"
    uk "C-Crystal! Juro pela vida da minha mãe! É tudo o que eu sei!"

# game/chapters/chapter4/script/ch4sc8.rpy:349
translate brazil ch4sc8_24032e3d:

#   "Your intimidation was a success, the man crumbled to your threat, {b}{color=#fc584c}Intimidation{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Sua intimidação foi um sucesso, o homem cedeu à sua ameaça. {b}{color=#fc584c}Intimidação{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc8.rpy:351
translate brazil ch4sc8_cd781a92:

#   "You release him and head back up to the main deck."
    "Você o solta e volta para o convés principal."

# game/chapters/chapter4/script/ch4sc8.rpy:353
translate brazil ch4sc8_7823f600:

#   uk "*Grunts* Hhrr... Kelly... Little Kelly."
    uk "*Grunhidos* Hhrr... Kelly... Pequena Kelly."

# game/chapters/chapter4/script/ch4sc8.rpy:354
translate brazil ch4sc8_c66e6a0d:

#   uk "You belong to me! I will have you and that tight young body of yours hrrh..."
    uk "Você me pertence! Eu terei você e esse seu corpinho jovem e firme... hrrh..."

# game/chapters/chapter4/script/ch4sc8.rpy:357
translate brazil ch4sc8_1ad268df:

#   uk "*Licks*"
    uk "*Lambe*"

# game/chapters/chapter4/script/ch4sc8.rpy:359
translate brazil ch4sc8_ee239d25:

#   "{b}{color=#f00}Dark Morality{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "{b}{color=#f00}Moralidade Sombria{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc8.rpy:366
translate brazil ch4sc8_173709d4:

#   mct "*Sigh* Maybe I can reason with him..."
    mct "*Suspiro* Talvez eu consiga convencê-lo..."

# game/chapters/chapter4/script/ch4sc8.rpy:367
translate brazil ch4sc8_8fc1842d:

#   mc "I’m looking for one of your crew mates. Kelly? Do you have any notion of where she could be?"
    mc "Estou procurando uma das suas tripulantes. Kelly? Você tem alguma ideia de onde ela possa estar?"

# game/chapters/chapter4/script/ch4sc8.rpy:369
translate brazil ch4sc8_4580fe76:

#   uk "Kelly? What of her?! Women. They come and go... fickle little creatures, they are."
    uk "Kelly? E daí?! Mulheres. Elas vêm e vão... criaturinhas volúveis."

# game/chapters/chapter4/script/ch4sc8.rpy:371
translate brazil ch4sc8_f8a1c82d:

#   mc "Okay... sure? What about Kelly, though? Do you know where she is?"
    mc "Certo... claro? Mas e a Kelly? Você sabe onde ela está?"

# game/chapters/chapter4/script/ch4sc8.rpy:373
translate brazil ch4sc8_70854b76:

#   uk "Kelly... Hnnrrh..."
    uk "Kelly... Hnnrrh..."

# game/chapters/chapter4/script/ch4sc8.rpy:375
translate brazil ch4sc8_625f569f:

#   uk "That little tease is probably out there raising some poor fellows mast. If ye catch my wind?"
    uk "Essa pequena provocação provavelmente está por aí animando algum coitado. Se você me entende?"

# game/chapters/chapter4/script/ch4sc8.rpy:376
translate brazil ch4sc8_7ed31dcb:

#   uk "Last I saw, I was taking a piss and she was outside that tavern called the drunken chicken, or something."
    uk "A última vez que a vi, eu estava urinando e ela estava do lado de fora daquela taverna chamada Frango Bêbado, ou algo assim."

# game/chapters/chapter4/script/ch4sc8.rpy:378
translate brazil ch4sc8_c4fa67c7:

#   uk "I offered to take her back to the ship but she wanted to be left alone..."
    uk "Eu me ofereci para levá-la de volta ao navio, mas ela queria ficar sozinha..."

# game/chapters/chapter4/script/ch4sc8.rpy:380
translate brazil ch4sc8_7632811b:

#   uk "If she'd only listened to me... that skank- girl wouldn’t be missing right now."
    uk "Se ela tivesse me escutado... aquela vagabunda não estaria desaparecida agora."

# game/chapters/chapter4/script/ch4sc8.rpy:381
translate brazil ch4sc8_72409148:

#   uk "Now, leave me alone! I need to finish sorting the equipment before we set sail."
    uk "Agora, me deixem em paz! Preciso terminar de organizar o equipamento antes de zarparmos."

# game/chapters/chapter4/script/ch4sc8.rpy:383
translate brazil ch4sc8_305f118c:

#   "You successfully got information from the man, {b}{color=#87e1fa}Charisma{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguiu obter informações do homem, {b}{color=#87e1fa}Carisma{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc8.rpy:385
translate brazil ch4sc8_dd98e6fd:

#   mct "This guy is a major creep... But at least I know where to start looking."
    mct "Esse cara é um tremendo tarado... Mas pelo menos eu sei por onde começar a procurar."

# game/chapters/chapter4/script/ch4sc8.rpy:386
translate brazil ch4sc8_58439ae5:

#   mct "That tavern he mentioned, the 'Drunken chicken', he must mean {b}'The Drunken Rooster'{/b}"
    mct "Aquela taverna que ele mencionou, a \"Frango Bêbado\", ele deve estar se referindo a ela. {b}'O Galo Bêbado'{/b}"

# game/chapters/chapter4/script/ch4sc8.rpy:394
translate brazil ch4sc8_d89b429a:

#   "{b}{color=#87e1fa}Light Morality{/b}{/color} increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "{b}{color=#87e1fa}Moralidade Leve{/b}{/color} aumentado por {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc8.rpy:402
translate brazil ch4sc8_808c081b:

#   elt "Stupid legs! Why won’t you move?"
    elt "Pernas estúpidas! Por que vocês não se mexem?"

# game/chapters/chapter4/script/ch4sc8.rpy:403
translate brazil ch4sc8_d09e198c:

#   elt "If you would just move, he-he would come back."
    elt "Se você se afastasse, ele voltaria."

# game/chapters/chapter4/script/ch4sc8.rpy:405
translate brazil ch4sc8_d773a0c1:

#   sy "Hi... How are you holding up?"
    sy "Olá... Como você está?"

# game/chapters/chapter4/script/ch4sc8.rpy:407
translate brazil ch4sc8_8a831226:

#   el "He left, Sylph..."
    el "Ele partiu, Sylph..."

# game/chapters/chapter4/script/ch4sc8.rpy:408
translate brazil ch4sc8_01ca5cf3:

#   el "He’s gone. And I don’t know when he will be back."
    el "Ele se foi. E eu não sei quando ele voltará."

# game/chapters/chapter4/script/ch4sc8.rpy:410
translate brazil ch4sc8_b95c39cb:

#   sy "I know... But he will be back soon! I just know it!"
    sy "Eu sei... Mas ele vai voltar logo! Eu sei disso!"

# game/chapters/chapter4/script/ch4sc8.rpy:412
translate brazil ch4sc8_d3d4c205:

#   sy "And when he is, you'll see! Miracles do happen!"
    sy "E quando ele chegar, você verá! Milagres acontecem!"

# game/chapters/chapter4/script/ch4sc8.rpy:414
translate brazil ch4sc8_26e0101e:

#   el "I begged him to stay... chasing down some centuries old legend won’t do any good!"
    el "Implorei para que ele ficasse... perseguir uma lenda secular não adiantaria nada!"

# game/chapters/chapter4/script/ch4sc8.rpy:415
translate brazil ch4sc8_a002355c:

#   el "It won’t cure me."
    el "Isso não vai me curar."

# game/chapters/chapter4/script/ch4sc8.rpy:417
translate brazil ch4sc8_7da898a1:

#   sy "You can’t give up hope this easily, Eliza. He’s out there fighting for you."
    sy "Você não pode perder a esperança tão facilmente, Eliza. Ele está lá fora lutando por você."

# game/chapters/chapter4/script/ch4sc8.rpy:419
translate brazil ch4sc8_ac11997f:

#   sy "Not because you asked him to. But because he cares deeply for you."
    sy "Não porque você pediu, mas porque ele se importa muito com você."

# game/chapters/chapter4/script/ch4sc8.rpy:421
translate brazil ch4sc8_370d5188:

#   sy "I know that it’s hard to understand why he couldn’t just stay here and comfort you."
    sy "Eu sei que é difícil entender por que ele não pôde simplesmente ficar aqui e te consolar."

# game/chapters/chapter4/script/ch4sc8.rpy:422
translate brazil ch4sc8_29ccdec8:

#   sy "But trust me. He needs this... He needs to protect you. He blames himself for you getting hurt."
    sy "Mas acredite em mim. Ele precisa disso... Ele precisa te proteger. Ele se culpa por você ter se machucado."

# game/chapters/chapter4/script/ch4sc8.rpy:424
translate brazil ch4sc8_3382f4b9:

#   el "It wasn’t his fault! I don’t blame him!"
    el "Não foi culpa dele! Eu não o culpo!"

# game/chapters/chapter4/script/ch4sc8.rpy:425
translate brazil ch4sc8_6cd0df63:

#   el "Is that what he thinks?!"
    el "É isso que ele pensa?!"

# game/chapters/chapter4/script/ch4sc8.rpy:427
translate brazil ch4sc8_e9ff7199:

#   sy "In his mind, it is. And if he can’t help you... how can he be worthy of your forgiveness?"
    sy "Na cabeça dele, sim. E se ele não pode te ajudar... como pode ser digno do seu perdão?"

# game/chapters/chapter4/script/ch4sc8.rpy:429
translate brazil ch4sc8_0a6443c8:

#   sy "I know that you think there’s nothing to forgive, and so do I."
    sy "Sei que você acha que não há nada a perdoar, e eu também."

# game/chapters/chapter4/script/ch4sc8.rpy:431
translate brazil ch4sc8_ab8d78ea:

#   sy "But you have to view it from his point of view."
    sy "Mas você precisa ver a situação do ponto de vista dele."

# game/chapters/chapter4/script/ch4sc8.rpy:433
translate brazil ch4sc8_5c047bea:

#   el "But... I just want him back here."
    el "Mas... eu só quero ele de volta aqui."

# game/chapters/chapter4/script/ch4sc8.rpy:435
translate brazil ch4sc8_2021898d:

#   sy "He will be. And knowing him, he'll have exactly what we need to make you walk again!"
    sy "Ele vai conseguir. E, conhecendo-o, ele terá exatamente o que precisamos para que você volte a andar!"

# game/chapters/chapter4/script/ch4sc8.rpy:436
translate brazil ch4sc8_d11eb46d:

#   sy "Now, get some rest, okay? Stop by the guild whenever you feel better."
    sy "Agora, descanse um pouco, está bem? Apareça na guilda quando se sentir melhor."

# game/chapters/chapter4/script/ch4sc8.rpy:437
translate brazil ch4sc8_d68d01bf:

#   sy "I have lots of work that I need your help with!"
    sy "Tenho muito trabalho e preciso da sua ajuda!"

# game/chapters/chapter4/script/ch4sc8.rpy:439
translate brazil ch4sc8_1cfe5cbf:

#   el "My help? What use can I possibly be in my current state?"
    el "Minha ajuda? Que utilidade posso ter no meu estado atual?"

# game/chapters/chapter4/script/ch4sc8.rpy:441
translate brazil ch4sc8_b524f7e4:

#   sy "Ahh-Ahh! Just come by whenever you’ve rested up!"
    sy "Ahh-Ahh! Apareça quando estiver descansado!"

# game/chapters/chapter4/script/ch4sc8.rpy:442
translate brazil ch4sc8_510c1b21:

#   sy "Trust me. You won’t regret it!"
    sy "Acredite em mim. Você não vai se arrepender!"

# game/chapters/chapter4/script/ch4sc8.rpy:444
translate brazil ch4sc8_7d482d36:

#   syt "Huh? Is that??"
    syt "Hein? É isso mesmo??"

# game/chapters/chapter4/script/ch4sc8.rpy:446
translate brazil ch4sc8_3b8dec0b:

#   syt "By the Earth Mother! How does she have an Arc-stone?!"
    syt "Pela Mãe Terra! Como ela tem uma Pedra Arcana?!"

# game/chapters/chapter4/script/ch4sc8.rpy:447
translate brazil ch4sc8_828c2f36:

#   syt "They’re incredibly rare and valuable!"
    syt "São incrivelmente raros e valiosos!"

# game/chapters/chapter4/script/ch4sc8.rpy:448
translate brazil ch4sc8_c1efe0b8:

#   syt "Only the highest ranking mages and scholars are rewarded with an Arc-stone."
    syt "Apenas os magos e estudiosos de mais alto escalão são recompensados ​​com uma Pedra Arcana."

# game/chapters/chapter4/script/ch4sc8.rpy:449
translate brazil ch4sc8_40c55e62:

#   syt "Usually as thanks for some service to the kingdom."
    syt "Geralmente como agradecimento por algum serviço prestado ao reino."

# game/chapters/chapter4/script/ch4sc8.rpy:451
translate brazil ch4sc8_0ec5f3bb:

#   syt "[mc]... Of course! He must have given it to her."
    syt "[mc]... Claro! Ele deve ter dado para ela."

# game/chapters/chapter4/script/ch4sc8.rpy:452
translate brazil ch4sc8_ed01c5b0:

#   syt "He sure is full of surprises..."
    syt "Ele é mesmo cheio de surpresas..."

# game/chapters/chapter4/script/ch4sc8.rpy:455
translate brazil ch4sc8_0cdda827:

#   mc "Hey, Captain?"
    mc "Ei, capitão?"

# game/chapters/chapter4/script/ch4sc8.rpy:457
translate brazil ch4sc8_7e8c7004:

#   ki "Hmm? Oh it's you... back so soon?"
    ki "Hum? Ah, é você... voltou tão cedo?"

# game/chapters/chapter4/script/ch4sc8.rpy:458
translate brazil ch4sc8_f1531c9c:

#   ki "Did you find her?"
    ki "Você a encontrou?"

# game/chapters/chapter4/script/ch4sc8.rpy:460
translate brazil ch4sc8_2773e258:

#   mc "No, I’ve just finished talking with your crew."
    mc "Não, acabei de falar com a sua equipe."

# game/chapters/chapter4/script/ch4sc8.rpy:461
translate brazil ch4sc8_1d6865ab:

#   mc "Charming bunch, really."
    mc "Um grupo encantador, sem dúvida."

# game/chapters/chapter4/script/ch4sc8.rpy:463
translate brazil ch4sc8_41e5f886:

#   ki "Charming? *Scoffs* Pffh! That’s one word for it."
    ki "Encantador? *Zomba* Pff! Essa é uma palavra que define isso."

# game/chapters/chapter4/script/ch4sc8.rpy:464
translate brazil ch4sc8_83acf1e9:

#   ki "They would just as soon turn on each other, as help one another."
    ki "Eles prefeririam se voltar uns contra os outros do que se ajudar."

# game/chapters/chapter4/script/ch4sc8.rpy:465
translate brazil ch4sc8_61d6ac5c:

#   ki "The only worthwhile member is Kelly."
    ki "A única integrante que presta é a Kelly."

# game/chapters/chapter4/script/ch4sc8.rpy:467
translate brazil ch4sc8_6d8496e4:

#   mc "Your quartermaster is giving me major creep vibes..."
    mc "Seu intendente está me dando uma sensação muito estranha..."

# game/chapters/chapter4/script/ch4sc8.rpy:469
translate brazil ch4sc8_cd4cb033:

#   ki "Ah, you’ve met Lazy-eye Louie? Calling him a creep is an insult to creeps. But he’s useful..."
    ki "Ah, você já conheceu o Louie Olho-Vagabundo? Chamá-lo de esquisito é um insulto aos esquisitos. Mas ele é útil..."

# game/chapters/chapter4/script/ch4sc8.rpy:470
translate brazil ch4sc8_4628ddcb:

#   ki "If it were up to me, he wouldn't be here. But Father commanded it."
    ki "Se dependesse de mim, ele não estaria aqui. Mas o Pai ordenou."

# game/chapters/chapter4/script/ch4sc8.rpy:471
translate brazil ch4sc8_6a497792:

#   ki "And he knows if he tries anything with me or Pearl, his life will soon come to an abrupt end."
    ki "E ele sabe que se tentar alguma coisa comigo ou com Pearl, sua vida chegará a um fim abrupto em breve."

# game/chapters/chapter4/script/ch4sc8.rpy:473
translate brazil ch4sc8_6e1c7817:

#   mc "Kelly was last seen outside a tavern, according to Louie."
    mc "Segundo Louie, Kelly foi vista pela última vez do lado de fora de uma taverna."

# game/chapters/chapter4/script/ch4sc8.rpy:475
translate brazil ch4sc8_98469f75:

#   ki "A tavern? No, that doesn’t add up. Kelly isn’t a drinker... she hates being intoxicated."
    ki "Uma taverna? Não, isso não faz sentido. Kelly não bebe... ela detesta ficar embriagada."

# game/chapters/chapter4/script/ch4sc8.rpy:477
translate brazil ch4sc8_e322d230:

#   ki "Why would she be at a tavern? Meeting someone, perhaps?"
    ki "Por que ela estaria em uma taverna? Talvez para encontrar alguém?"

# game/chapters/chapter4/script/ch4sc8.rpy:479
translate brazil ch4sc8_1979a6ab:

#   ki "But why meet in secret, then? She could’ve just told me or Pearl what she was up to!"
    ki "Mas então por que se encontrar em segredo? Ela poderia simplesmente ter contado para mim ou para a Pearl o que estava aprontando!"

# game/chapters/chapter4/script/ch4sc8.rpy:481
translate brazil ch4sc8_a3959ee0:

#   mc "I’m heading over there to look for clues."
    mc "Estou indo para lá em busca de pistas."

# game/chapters/chapter4/script/ch4sc8.rpy:484
translate brazil ch4sc8_a8bca9e7:

#   ki "I can’t ask you to do that... We’re setting sail with the midnight tide."
    ki "Não posso te pedir isso... Vamos zarpar com a maré da meia-noite."

# game/chapters/chapter4/script/ch4sc8.rpy:486
translate brazil ch4sc8_bec7a35f:

#   ki "*Sigh* Damnit! We’ll have to leave without her... she knows the rules."
    ki "*Suspiro* Droga! Teremos que ir sem ela... ela conhece as regras."

# game/chapters/chapter4/script/ch4sc8.rpy:487
translate brazil ch4sc8_926405fc:

#   ki "I don't like the idea of leaving her in the city on her own though..."
    ki "Não gosto da ideia de deixá-la sozinha na cidade..."

# game/chapters/chapter4/script/ch4sc8.rpy:492
translate brazil ch4sc8_6e08ea5d:

#   mc "Ki-..."
    mc "Para-..."

# game/chapters/chapter4/script/ch4sc8.rpy:493
translate brazil ch4sc8_6fcee545:

#   mc "Captain, allow me to go find her."
    mc "Capitão, permita-me ir procurá-la."

# game/chapters/chapter4/script/ch4sc8.rpy:494
translate brazil ch4sc8_78610f44:

#   mc "I'll do what I can to bring her back to the Banshee unharmed."
    mc "Farei o que estiver ao meu alcance para trazê-la de volta à Banshee ilesa."

# game/chapters/chapter4/script/ch4sc8.rpy:495
translate brazil ch4sc8_deb44690:

#   mc "I have decent amount of experience with tracking..."
    mc "Tenho uma experiência razoável com rastreamento..."

# game/chapters/chapter4/script/ch4sc8.rpy:497
translate brazil ch4sc8_c3906412:

#   ki "Why? Why would you do this for me?"
    ki "Por quê? Por que você faria isso por mim?"

# game/chapters/chapter4/script/ch4sc8.rpy:498
translate brazil ch4sc8_d7fcd6c0:

#   ki "I haven’t exactly been very welcoming to you or your cousin..."
    ki "Não tenho sido exatamente muito acolhedor com você ou com seu primo..."

# game/chapters/chapter4/script/ch4sc8.rpy:500
translate brazil ch4sc8_550fcf78:

#   mc "I didn't expect a warm welcome, but you make it sound like this 'Kelly' is a decent person."
    mc "Eu não esperava uma recepção calorosa, mas você faz parecer que essa tal de 'Kelly' é uma pessoa decente."

# game/chapters/chapter4/script/ch4sc8.rpy:501
translate brazil ch4sc8_ee9ef296:

#   mc "Not to mention you clearly care about her, otherwise you wouldn't be hesitating."
    mc "Sem mencionar que você claramente se importa com ela, caso contrário não estaria hesitando."

# game/chapters/chapter4/script/ch4sc8.rpy:502
translate brazil ch4sc8_4b6db033:

#   ki "Mhm..."
    ki "Hum..."

# game/chapters/chapter4/script/ch4sc8.rpy:503
translate brazil ch4sc8_db540b50:

#   mc "She could be in danger or hurt, I don't think you'd want that for her? Not when I can find her."
    mc "Ela pode estar em perigo ou ferida, acho que você não gostaria disso para ela, não é? Não quando eu posso encontrá-la."

# game/chapters/chapter4/script/ch4sc8.rpy:504
translate brazil ch4sc8_4d2e97a1:

#   mc "You're not risking anything by sending me, so what's it gonna be?"
    mc "Você não arrisca nada me enviando, então o que vai ser?"

# game/chapters/chapter4/script/ch4sc8.rpy:506
translate brazil ch4sc8_0ca5d7f3:

#   ki "[mc]-... I..."
    ki "[mc]-... EU..."

# game/chapters/chapter4/script/ch4sc8.rpy:508
translate brazil ch4sc8_84310d85:

#   ki "*Exhales* Alright, I'm counting on you."
    ki "*Suspira* Muito bem, conto com você."

# game/chapters/chapter4/script/ch4sc8.rpy:509
translate brazil ch4sc8_86c2f6f3:

#   "You successfully persuaded Kira to letting you help, your {b}{color=#2bff8b}Persuasion{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguiu convencer Kira a deixar você ajudar, seu {b}{color=#2bff8b}Persuasão{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc8.rpy:510
translate brazil ch4sc8_8f501b0e:

#   ki "I'll ask you once more... why?"
    ki "Vou perguntar mais uma vez... por quê?"

# game/chapters/chapter4/script/ch4sc8.rpy:511
translate brazil ch4sc8_c87b9612:

#   ki "Why go to such lengths just to... help me?"
    ki "Por que se dar a tanto trabalho só para... me ajudar?"

# game/chapters/chapter4/script/ch4sc8.rpy:516
translate brazil ch4sc8_bc7096ce:

#   mc "Captain, I’ll find her. And bring her back to the Banshee unharmed."
    mc "Capitão, eu a encontrarei. E a trarei de volta para a Banshee ilesa."

# game/chapters/chapter4/script/ch4sc8.rpy:517
translate brazil ch4sc8_51060d46:

#   mc "I have experience with tracking..."
    mc "Tenho experiência com rastreamento..."

# game/chapters/chapter4/script/ch4sc8.rpy:525
translate brazil ch4sc8_ce037368:

#   mc "I'll go fetch her, and when I do, you can either thank me, or leave it be, I don't care."
    mc "Vou buscá-la, e quando eu for, você pode me agradecer ou deixar para lá, tanto faz."

# game/chapters/chapter4/script/ch4sc8.rpy:530
translate brazil ch4sc8_399e8753:

#   "You successfully took the lead in the discussion with Kira, your {b}{color=#ffee54}Leadership{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você assumiu com sucesso a liderança na discussão com Kira, sua {b}{color=#ffee54}Liderança{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc8.rpy:540
translate brazil ch4sc8_8d92428d:

#   mc "First of all... You intrigue me."
    mc "Em primeiro lugar... Você me intriga."

# game/chapters/chapter4/script/ch4sc8.rpy:541
translate brazil ch4sc8_448bc559:

#   mc "I expected pirates to be rude and obnoxious, which has been true, but..."
    mc "Eu esperava que os piratas fossem rudes e desagradáveis, o que de fato se confirmou, mas..."

# game/chapters/chapter4/script/ch4sc8.rpy:542
translate brazil ch4sc8_6d26bc1d:

#   mc "I can tell that this bothers you more than you're letting on..."
    mc "Percebo que isso te incomoda mais do que você demonstra..."

# game/chapters/chapter4/script/ch4sc8.rpy:543
translate brazil ch4sc8_d4b979a5:

#   mc "Which means there's more to you than this harsh and unfriendly facade you're showing."
    mc "O que significa que você é mais do que essa fachada dura e antipática que está mostrando."

# game/chapters/chapter4/script/ch4sc8.rpy:544
translate brazil ch4sc8_30e1b46c:

#   mc "I suspect that this 'Kelly' isn't just another of your crew. She's more of a friend, perhaps?"
    mc "Suspeito que essa \"Kelly\" não seja apenas mais uma da sua equipe. Ela é mais uma amiga, talvez?"

# game/chapters/chapter4/script/ch4sc8.rpy:546
translate brazil ch4sc8_1253b37b:

#   mc "You might not like me very much, but I won't just stand by while a girl is missing..."
    mc "Você pode não gostar muito de mim, mas eu não vou ficar parado enquanto uma garota estiver desaparecida..."

# game/chapters/chapter4/script/ch4sc8.rpy:547
translate brazil ch4sc8_800ab045:

#   mc "I'll bring your friend back. And then perhaps you'll stop threatening to turn me into sharkbait..."
    mc "Vou trazer seu amigo de volta. E aí talvez você pare de ameaçar me transformar em isca de tubarão..."

# game/chapters/chapter4/script/ch4sc8.rpy:548
translate brazil ch4sc8_2ffcf60f:

#   mc "After all... how often does a man get to meet a breathtaking woman?"
    mc "Afinal... quantas vezes um homem tem a oportunidade de conhecer uma mulher deslumbrante?"

# game/chapters/chapter4/script/ch4sc8.rpy:550
translate brazil ch4sc8_b2944a27:

#   kit "..."
    kit "..."

# game/chapters/chapter4/script/ch4sc8.rpy:551
translate brazil ch4sc8_74f2552d:

#   kit "W-Who does he think he is! Boarding my ship and... And tries to help Kelly!"
    kit "Q-Quem ele pensa que é?! Embarcando no meu navio e... E ainda tenta ajudar a Kelly!"

# game/chapters/chapter4/script/ch4sc8.rpy:553
translate brazil ch4sc8_65837d3d:

#   kit "No... I was the one who asked for his help..."
    kit "Não... fui eu quem pediu a ajuda dele..."

# game/chapters/chapter4/script/ch4sc8.rpy:554
translate brazil ch4sc8_d2cf1baf:

#   kit "I... I intrigue him? Why? Nobody has ever told me something like that..."
    kit "Eu... eu o intrigo? Por quê? Ninguém nunca me disse algo assim..."

# game/chapters/chapter4/script/ch4sc8.rpy:555
translate brazil ch4sc8_41ffdb14:

#   kit "And he had the nerve to call me breathtaking?! Does he mean my presence is suffocating?!"
    kit "E ele teve a audácia de me chamar de deslumbrante?! Será que ele quer dizer que minha presença é sufocante?!"

# game/chapters/chapter4/script/ch4sc8.rpy:557
translate brazil ch4sc8_af4072a3:

#   kit "Or... Does it mean he thinks I'm beautiful? ... Does he find me attractive as well?"
    kit "Ou... Será que significa que ele me acha bonita? ... Será que ele também me acha atraente?"

# game/chapters/chapter4/script/ch4sc8.rpy:559
translate brazil ch4sc8_3cdac310:

#   kit "He's been really sweet so far, despite my threats... He's still willing to help me..."
    kit "Ele tem sido muito gentil até agora, apesar das minhas ameaças... Ele ainda está disposto a me ajudar..."

# game/chapters/chapter4/script/ch4sc8.rpy:560
translate brazil ch4sc8_060ad3f2:

#   kit "I wonder if..."
    kit "Será que...?"

# game/chapters/chapter4/script/ch4sc8.rpy:561
translate brazil ch4sc8_7fd7dcf7:

#   "Kira’s trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "A confiança de Kira aumentou em {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc8.rpy:569
translate brazil ch4sc8_d92abfda:

#   mc "Don’t flatter yourself. I can tell this is weighing on your mind."
    mc "Não se iluda. Percebo que isso está lhe preocupando."

# game/chapters/chapter4/script/ch4sc8.rpy:570
translate brazil ch4sc8_d32693d8:

#   mc "I simply want you focused on getting me to Inmortui. Not on some missing girl."
    mc "Eu só quero que você se concentre em me levar até Inmortui. Não em alguma garota desaparecida."

# game/chapters/chapter4/script/ch4sc8.rpy:572
translate brazil ch4sc8_79193780:

#   mc "See you at midnight."
    mc "Te vejo à meia-noite."

# game/chapters/chapter4/script/ch4sc8.rpy:574
translate brazil ch4sc8_6ecfb19e:

#   kit "Don’t flatter myself? Hmph! Who does he think he’s talking to..."
    kit "Não me iludo? Hmph! Quem ele pensa que é para falar assim...?"

# game/chapters/chapter4/script/ch4sc8.rpy:575
translate brazil ch4sc8_c6db78a9:

#   kit "It’s not like I care what he thinks. He’s just cargo."
    kit "Não é que eu me importe com o que ele pensa. Ele é só carga."

# game/chapters/chapter4/script/ch4sc8.rpy:577
translate brazil ch4sc8_ff3ec1af:

#   kit "Yeah. Just cargo..."
    kit "Sim. Apenas carga..."

# game/chapters/chapter4/script/ch4sc8.rpy:580
translate brazil ch4sc8_6285d349:

#   kit "It's really sweet of him to go out of his way to find Kelly, though."
    kit "É muito gentil da parte dele se dar ao trabalho de encontrar a Kelly."

# game/chapters/chapter4/script/ch4sc8.rpy:581
translate brazil ch4sc8_d928073b:

#   kit "None of the crew has offered to look for her."
    kit "Nenhum membro da tripulação se ofereceu para procurá-la."

# game/chapters/chapter4/script/ch4sc8.rpy:583
translate brazil ch4sc8_7001e7eb:

#   kit "[mc]... Maybe."
    kit "[mc]... Talvez."

# game/chapters/chapter4/script/ch4sc8.rpy:190
translate brazil ch4sc8_69eb496c_1:

#   mc "Now let me make one thing clear to you."
    mc "Agora, deixe-me esclarecer uma coisa para você."

# game/chapters/chapter4/script/ch4sc8.rpy:191
translate brazil ch4sc8_dd1a6ee1_1:

#   mc "You're the captain, I'll happily follow your lead."
    mc "Você é o capitão, e eu seguirei suas ordens com prazer."

# game/chapters/chapter4/script/ch4sc8.rpy:199
translate brazil ch4sc8_f9f75380_1:

#   ki "Hmph... you have balls, I'll give you that."
    ki "Hum... você tem coragem, isso eu admito."

# game/chapters/chapter4/script/ch4sc8.rpy:203
translate brazil ch4sc8_e732f9e2_1:

#   mc "I'm glad we managed to come to an understanding."
    mc "Fico feliz que tenhamos conseguido chegar a um entendimento."

# game/chapters/chapter4/script/ch4sc8.rpy:388
translate brazil ch4sc8_7823f600_1:

#   uk "*Grunts* Hhrr... Kelly... Little Kelly."
    uk "*Grunhidos* Hhrr... Kelly... Pequena Kelly."

# game/chapters/chapter4/script/ch4sc8.rpy:389
translate brazil ch4sc8_c66e6a0d_1:

#   uk "You belong to me! I will have you and that tight young body of yours hrrh..."
    uk "Você me pertence! Eu terei você e esse seu corpinho jovem e firme... hrrh..."

# game/chapters/chapter4/script/ch4sc8.rpy:392
translate brazil ch4sc8_1ad268df_1:

#   uk "*Licks*"
    uk "*Lambe*"

# game/chapters/chapter4/script/ch4sc8.rpy:483
translate brazil ch4sc8_d37f035c_1:

#   ki "..."
    ki "..."

# game/chapters/chapter4/script/ch4sc8.rpy:515
translate brazil ch4sc8_6e08ea5d_1:

#   mc "Ki-..."
    mc "Para-..."

# game/chapters/chapter4/script/ch4sc8.rpy:519
translate brazil ch4sc8_c3906412_1:

#   ki "Why? Why would you do this for me?"
    ki "Por quê? Por que você faria isso por mim?"

# game/chapters/chapter4/script/ch4sc8.rpy:520
translate brazil ch4sc8_d7fcd6c0_1:

#   ki "I haven’t exactly been very welcoming to you or your cousin..."
    ki "Não tenho sido exatamente muito acolhedor com você ou com seu primo..."

# game/chapters/chapter4/script/ch4sc8.rpy:522
translate brazil ch4sc8_550fcf78_1:

#   mc "I didn't expect a warm welcome, but you make it sound like this 'Kelly' is a decent person."
    mc "Eu não esperava uma recepção calorosa, mas você faz parecer que essa tal de 'Kelly' é uma pessoa decente."

# game/chapters/chapter4/script/ch4sc8.rpy:523
translate brazil ch4sc8_ee9ef296_1:

#   mc "Not to mention you clearly care about her, otherwise you wouldn't be hesitating."
    mc "Sem mencionar que você claramente se importa com ela, caso contrário não estaria hesitando."

# game/chapters/chapter4/script/ch4sc8.rpy:524
translate brazil ch4sc8_4b6db033_1:

#   ki "Mhm..."
    ki "Hum..."

# game/chapters/chapter4/script/ch4sc8.rpy:527
translate brazil ch4sc8_0ca5d7f3_1:

#   ki "[mc]-... I..."
    ki "[mc]-... EU..."

# game/chapters/chapter4/script/ch4sc8.rpy:529
translate brazil ch4sc8_84310d85_1:

#   ki "*Exhales* Alright, I'm counting on you."
    ki "*Suspira* Muito bem, conto com você."

# game/chapters/chapter4/script/ch4sc8.rpy:531
translate brazil ch4sc8_8f501b0e_1:

#   ki "I'll ask you once more... why?"
    ki "Vou perguntar mais uma vez... por quê?"

# game/chapters/chapter4/script/ch4sc8.rpy:532
translate brazil ch4sc8_c87b9612_1:

#   ki "Why go to such lengths just to... help me?"
    ki "Por que se dar a tanto trabalho só para... me ajudar?"

# game/chapters/chapter4/script/ch4sc8.rpy:578
translate brazil ch4sc8_b2944a27_1:

#   kit "..."
    kit "..."

