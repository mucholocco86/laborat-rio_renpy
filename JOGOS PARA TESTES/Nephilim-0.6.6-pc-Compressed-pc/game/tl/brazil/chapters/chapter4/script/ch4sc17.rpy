translate brazil ch4sc17_58a93093:

#   ki "*Sensual* Show them no mercy."
    ki "*Sensual* Não tenha piedade deles."

# game/chapters/chapter4/script/ch4sc17.rpy:1189
translate brazil ch4sc17_5a346c51:

#   ki "Hey... How are you feeling?"
    ki "Ei... Como você está se sentindo?"

# game/chapters/chapter4/script/ch4sc17.rpy:1190
translate brazil ch4sc17_e353c3ec:

#   mc "Anxious... Nervous... Apprehensive."
    mc "Ansioso... Nervoso... Apreensivo."

# game/chapters/chapter4/script/ch4sc17.rpy:1191
translate brazil ch4sc17_89f68a3d:

#   "You feel her hand squeezing your shoulder."
    "Você sente a mão dela apertando seu ombro."

# game/chapters/chapter4/script/ch4sc17.rpy:1194
translate brazil ch4sc17_2e19f8d4:

#   ki "Yes, good... If you didn’t have those emotions with what we’re about to do..."
    ki "Sim, ótimo... Se você não sentiu essas emoções com o que estamos prestes a fazer..."

# game/chapters/chapter4/script/ch4sc17.rpy:1196
translate brazil ch4sc17_9d6fbf0a:

#   ki "Now go get 'em. Show them what happens when they fuck with us."
    ki "Agora vão lá e peguem eles. Mostrem a eles o que acontece quando mexem com a gente."

# game/chapters/chapter4/script/ch4sc17.rpy:1200
translate brazil ch4sc17_aeef64c0:

#   mc "Whatever happens... just get Pearl. Get Pearl and get to safety..."
    mc "Aconteça o que acontecer... só pegue a Pearl. Pegue a Pearl e vá para um lugar seguro..."

# game/chapters/chapter4/script/ch4sc17.rpy:1201
translate brazil ch4sc17_b9879fa2:

#   ki "This isn't my first fight. I can handle myself."
    ki "Essa não é minha primeira briga. Sei me defender."

# game/chapters/chapter4/script/ch4sc17.rpy:1202
translate brazil ch4sc17_8cd8d632:

#   mc "Kira. Just do as I ask, okay? I won’t be able to fight with the focus I need if I am worried about your safety."
    mc "Kira. Faça o que eu peço, está bem? Não conseguirei lutar com a concentração necessária se estiver preocupado com a sua segurança."

# game/chapters/chapter4/script/ch4sc17.rpy:1204
translate brazil ch4sc17_eeb4f256:

#   kit "I don’t like this... I want to help him!"
    kit "Eu não gosto disso... Quero ajudá-lo!"

# game/chapters/chapter4/script/ch4sc17.rpy:1205
translate brazil ch4sc17_44a91c23:

#   kit "Hnnghh..."
    kit "Hnnghh..."

# game/chapters/chapter4/script/ch4sc17.rpy:1206
translate brazil ch4sc17_6d1660bf:

#   kit "*Sigh* But if this is what he needs from me. Then that’s what I’ll do."
    kit "*Suspiro* Mas se é isso que ele precisa de mim, então é isso que farei."

# game/chapters/chapter4/script/ch4sc17.rpy:1208
translate brazil ch4sc17_89d66c7c:

#   ki "Okay... I'll do as you say. But I don’t like it one bit..."
    ki "Certo... Farei como você disse. Mas não gosto nem um pouco disso..."

# game/chapters/chapter4/script/ch4sc17.rpy:1209
translate brazil ch4sc17_ca100fb7:

#   ki "I swear... if you get hurt, I'll... stab you myself!"
    ki "Eu juro... se você se machucar, eu... eu mesmo te esfaqueio!"

# game/chapters/chapter4/script/ch4sc17.rpy:1213
translate brazil ch4sc17_56d4afa6:

#   mc "I'd better not get hurt then. Thank you. I'm counting on you."
    mc "É melhor eu não me machucar, então. Obrigada. Estou contando com você."

# game/chapters/chapter4/script/ch4sc17.rpy:1222
translate brazil ch4sc17_3a640b72:

#   mct "Stealing the only way to cure Eliza... bad move."
    mct "Roubar a única forma de curar Eliza... péssima ideia."

# game/chapters/chapter4/script/ch4sc17.rpy:1223
translate brazil ch4sc17_9991aea2:

#   mct "Time to show them the error of their ways."
    mct "Chegou a hora de mostrar a eles o erro que cometeram."

# game/chapters/chapter4/script/ch4sc17.rpy:1232
translate brazil ch4sc17_965105f1:

#   ki "*Sigh* Off he goes..."
    ki "*Suspiro* Lá vai ele..."

# game/chapters/chapter4/script/ch4sc17.rpy:1238
translate brazil ch4sc17_f15f7e1f:

#   ki "Pearl!"
    ki "Pérola!"

# game/chapters/chapter4/script/ch4sc17.rpy:1240
translate brazil ch4sc17_a25a735b:

#   pl "..."
    pl "..."

# game/chapters/chapter4/script/ch4sc17.rpy:1241
translate brazil ch4sc17_dae37c7b:

#   ki "Pearl? You don’t have to do this..."
    ki "Pérola? Você não precisa fazer isso..."

# game/chapters/chapter4/script/ch4sc17.rpy:1242
translate brazil ch4sc17_5306b368:

#   ki "[mc] is your friend! Even after what you did, he still wants you to be safe and back with us."
    ki "[mc] Ele é seu amigo! Mesmo depois do que você fez, ele ainda quer que você esteja segura e volte para nós."

# game/chapters/chapter4/script/ch4sc17.rpy:1244
translate brazil ch4sc17_f54e7a79:

#   ki "He doesn’t blame you... neither of us do. Just work with us... not against us."
    ki "Ele não te culpa... nenhum de nós culpa. Apenas trabalhe conosco... não contra nós."

# game/chapters/chapter4/script/ch4sc17.rpy:1248
translate brazil ch4sc17_9459e44f:

#   cb "Do we understand each other?"
    cb "Nós nos entendemos?"

# game/chapters/chapter4/script/ch4sc17.rpy:1250
translate brazil ch4sc17_025650fe:

#   pl "Y-Yes daddy..."
    pl "S-Sim, papai..."

# game/chapters/chapter4/script/ch4sc17.rpy:1252
translate brazil ch4sc17_4320c7e4:

#   cb "Then repeat it."
    cb "Em seguida, repita."

# game/chapters/chapter4/script/ch4sc17.rpy:1254
translate brazil ch4sc17_9a4e0618:

#   pl "I... have to steal the artifact when we find it and bring it straight to you."
    pl "Eu... preciso roubar o artefato quando o encontrarmos e trazê-lo diretamente para você."

# game/chapters/chapter4/script/ch4sc17.rpy:1256
translate brazil ch4sc17_b8ffde31:

#   cb "Otherwise... ?"
    cb "De outra forma... ?"

# game/chapters/chapter4/script/ch4sc17.rpy:1258
translate brazil ch4sc17_6db068d7:

#   pl "Otherwise... You will kill K-Kira. For betraying you."
    pl "Caso contrário... você matará K-Kira. Por ela ter te traído."

# game/chapters/chapter4/script/ch4sc17.rpy:1260
translate brazil ch4sc17_02c23cc2:

#   cb "And... ?"
    cb "E... ?"

# game/chapters/chapter4/script/ch4sc17.rpy:1262
translate brazil ch4sc17_1e3580dc:

#   pl "And... You will flay [mc] alive while I watch. For turning your daughter against you..."
    pl "E... Você vai esfolar [mc] viva enquanto eu assisto. Por ter colocado sua filha contra você..."

# game/chapters/chapter4/script/ch4sc17.rpy:1264
translate brazil ch4sc17_bea52d2e:

#   cb "Good girl. Now leave. And don’t let them suspect anything. You know I don’t make empty threats."
    cb "Boa menina. Agora vá embora. E não deixe que eles suspeitem de nada. Você sabe que eu não faço ameaças vazias."

# game/chapters/chapter4/script/ch4sc17.rpy:1271
translate brazil ch4sc17_20dfb306:

#   ki "Pearl! Don’t!!"
    ki "Pérola! Não faça isso!!"

# game/chapters/chapter4/script/ch4sc17.rpy:1279
translate brazil ch4sc17_1dec5228:

#   ki "Arrgh! Pearl!?"
    ki "Argh! Pérola!?"

# game/chapters/chapter4/script/ch4sc17.rpy:1280
translate brazil ch4sc17_ed9b7af1:

#   ki "Snap out of it already!"
    ki "Acorda pra vida!"

# game/chapters/chapter4/script/ch4sc17.rpy:1286
translate brazil ch4sc17_fbddb3a1:

#   ki "{b}PEARL!!{/b}"
    ki "{b}PÉROLA!!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1293
translate brazil ch4sc17_f3a50e46:

#   kit "What the hell is going on with her?! I can’t seem to get through to her..."
    kit "Que diabos está acontecendo com ela?! Não consigo falar com ela..."

# game/chapters/chapter4/script/ch4sc17.rpy:1294
translate brazil ch4sc17_7aa81242:

#   kit "I’ve never fought my sister in a real battle before ..."
    kit "Eu nunca lutei com minha irmã em uma batalha de verdade antes..."

# game/chapters/chapter4/script/ch4sc17.rpy:1295
translate brazil ch4sc17_e7598952:

#   kit "I can’t hold back, if I don’t beat her... we might not get her back."
    kit "Não posso me conter, se eu não a derrotar... talvez não a tenhamos de volta."

# game/chapters/chapter4/script/ch4sc17.rpy:1297
translate brazil ch4sc17_c988872c:

#   ki "Okay, sis. Let’s do it your way. Just know I won’t lose. Not with everything that’s at stake!"
    ki "Ok, mana. Vamos fazer do seu jeito. Só saiba que eu não vou perder. Não com tudo o que está em jogo!"

# game/chapters/chapter4/script/ch4sc17.rpy:1299
translate brazil ch4sc17_0cc4e686:

#   ki "*Angrily* I’ve been meaning to kick your ass for betraying us!"
    ki "*Com raiva* Eu estava querendo te dar uma surra por ter nos traído!"

# game/chapters/chapter4/script/ch4sc17.rpy:1306
translate brazil ch4sc17_bd1741c5:

#   ki "Hnngh! It’s been a while since I’ve been tested. Who better than my own sister to push me."
    ki "Hnngh! Faz tempo que não sou testada. Quem melhor do que minha própria irmã para me incentivar?"

# game/chapters/chapter4/script/ch4sc17.rpy:1307
translate brazil ch4sc17_d657931b:

#   ki "Still nothing to say? I'd better knock some words out of you then!"
    ki "Ainda sem nada a dizer? É melhor eu arrancar algumas palavras de você então!"

# game/chapters/chapter4/script/ch4sc17.rpy:1311
translate brazil ch4sc17_1ef2faaa:

#   kit "Yes! [mc] is handling his business as expected. Now it’s up to me to handle my end."
    kit "Sim! [mc] Ele está cuidando dos seus negócios como esperado. Agora cabe a mim cuidar da minha parte."

# game/chapters/chapter4/script/ch4sc17.rpy:1312
translate brazil ch4sc17_0acdbab3:

#   kit "This is my chance!"
    kit "Esta é a minha chance!"

# game/chapters/chapter4/script/ch4sc17.rpy:1316
translate brazil ch4sc17_49ce499f:

#   ki "*Shouting* How dare you?! How dare you hurt him?! He’s been nothing but a friend to us!"
    ki "*Gritando* Como você se atreve?! Como você se atreve a machucá-lo?! Ele sempre foi um amigo para nós!"

# game/chapters/chapter4/script/ch4sc17.rpy:1320
translate brazil ch4sc17_82b1935a:

#   ki "Hrrraah! You will apologize to him! And your apology better be epic!"
    ki "Hrrraah! Você vai se desculpar com ele! E é melhor que seu pedido de desculpas seja épico!"

# game/chapters/chapter4/script/ch4sc17.rpy:1324
translate brazil ch4sc17_23649f38:

#   ki "Aargh!"
    ki "Argh!"

# game/chapters/chapter4/script/ch4sc17.rpy:1329
translate brazil ch4sc17_7912c1c4:

#   ki "*Panting* Pearl... If you don’t say something, anything... I will never speak to you again."
    ki "*Ofegante* Pérola... Se você não disser nada, qualquer coisa... eu nunca mais falarei com você."

# game/chapters/chapter4/script/ch4sc17.rpy:1330
translate brazil ch4sc17_f74d3c8e:

#   ki "Snap out of it already!!"
    ki "Acorda pra vida!!"

# game/chapters/chapter4/script/ch4sc17.rpy:1334
translate brazil ch4sc17_fefdc96f:

#   pl "Leave."
    pl "Deixar."

# game/chapters/chapter4/script/ch4sc17.rpy:1335
translate brazil ch4sc17_747131e9:

#   pl "Leave... You need to leave."
    pl "Vá embora... Você precisa ir embora."

# game/chapters/chapter4/script/ch4sc17.rpy:1336
translate brazil ch4sc17_60c5c8e0:

#   pl "Daddy thinks... thinks you betrayed him, and [mc] has corrupted you against us."
    pl "Papai acha... acha que você o traiu, e [mc] te corrompeu contra nós."

# game/chapters/chapter4/script/ch4sc17.rpy:1338
translate brazil ch4sc17_a57eaf25:

#   ki "Pearl... Father isn’t well. Me and [mc] figured it out. It's his ring! It’s corrupting his mind somehow!"
    ki "Pérola... Papai não está bem. Eu e [mc] Descobri. É o anel dele! Está corrompendo a mente dele de alguma forma!"

# game/chapters/chapter4/script/ch4sc17.rpy:1339
translate brazil ch4sc17_131bb498:

#   ki "Surely you’ve seen it too? Him talking to it when he's alone? How he touches it like its his most prized possession?"
    ki "Você certamente já viu também? Ele conversando com ela quando está sozinho? Como ele a toca como se fosse seu bem mais precioso?"

# game/chapters/chapter4/script/ch4sc17.rpy:1340
translate brazil ch4sc17_4504bec2:

#   ki "All the changes in his behavior over the last few years? How cruel and cold he has become?"
    ki "Todas as mudanças no comportamento dele nos últimos anos? Como ele se tornou cruel e frio?"

# game/chapters/chapter4/script/ch4sc17.rpy:1345
translate brazil ch4sc17_3711c927:

#   ki "Pearl. We aren’t leaving until {b}YOU{/b} and the artifact are with us."
    ki "Pérola. Não vamos embora até {b} VOCÊ{/b} e o artefato estão conosco."

# game/chapters/chapter4/script/ch4sc17.rpy:1349
translate brazil ch4sc17_247d7453:

#   pl "I can’t go with you... [mc], he... I... I betrayed him."
    pl "Não posso ir com você... [mc] Ele... eu... eu o traí."

# game/chapters/chapter4/script/ch4sc17.rpy:1351
translate brazil ch4sc17_4d9d949c:

#   ki "Are you really that dumb? You’re supposed to be the smart one of the two of us!"
    ki "Você é mesmo tão burro assim? Você deveria ser o mais inteligente entre nós dois!"

# game/chapters/chapter4/script/ch4sc17.rpy:1353
translate brazil ch4sc17_0b7cd6b8:

#   ki "[mc] IS the one who insisted on not leaving you behind."
    ki "[mc] É aquela que insistiu em não te deixar para trás."

# game/chapters/chapter4/script/ch4sc17.rpy:1354
translate brazil ch4sc17_0eeb3b3e:

#   ki "He even surprised me. I thought I'd have to beg him not to kill you."
    ki "Ele até me surpreendeu. Pensei que teria que implorar para ele não te matar."

# game/chapters/chapter4/script/ch4sc17.rpy:1356
translate brazil ch4sc17_1179d3ed:

#   ki "But you know what? After you left with the artifact... he stayed calm, and even called you a friend."
    ki "Mas sabe de uma coisa? Depois que você saiu com o artefato... ele manteve a calma e até te chamou de amigo."

# game/chapters/chapter4/script/ch4sc17.rpy:1357
translate brazil ch4sc17_62b68b39:

#   ki "He is hurt by your betrayal, Pearl. But he has already forgiven you."
    ki "Ele está magoado com a sua traição, Pearl. Mas ele já te perdoou."

# game/chapters/chapter4/script/ch4sc17.rpy:1359
translate brazil ch4sc17_571e2ed4:

#   ki "Now it’s up to you to make things right. Show him that you ARE his friend. That you can be trusted again."
    ki "Agora cabe a você consertar as coisas. Mostre a ele que você É amiga dele. Que ele pode confiar em você novamente."

# game/chapters/chapter4/script/ch4sc17.rpy:1360
translate brazil ch4sc17_f561ab5d:

#   ki "Help us get the artifact back and come with us! We’ll leave Looter’s Bay behind. At least for a while."
    ki "Ajude-nos a recuperar o artefato e venha conosco! Deixaremos a Baía dos Saqueadores para trás. Pelo menos por um tempo."

# game/chapters/chapter4/script/ch4sc17.rpy:1361
translate brazil ch4sc17_1fec34db:

#   pl "*Clenches teeth* ..."
    pl "*Aperta os dentes* ..."

# game/chapters/chapter4/script/ch4sc17.rpy:1363
translate brazil ch4sc17_fbfda6f0:

#   pl "*Sobbing* Kira... I’m so sorry! I-I didn’t know what to do! Daddy he-... *Sobs* He wants me to kill you!"
    pl "*Soluços* Kira... Me desculpe! Eu não sabia o que fazer! Papai... *Soluços* Ele quer que eu te mate!"

# game/chapters/chapter4/script/ch4sc17.rpy:1364
translate brazil ch4sc17_c596cb87:

#   pl "*Sobbing* I-I... I didn't know what to do! You know him! I thought if-if I could scare you away-"
    pl "*Soluços* Eu... eu não sabia o que fazer! Você o conhece! Eu pensei que se... se eu conseguisse te assustar e te fazer ir embora..."

# game/chapters/chapter4/script/ch4sc17.rpy:1368
translate brazil ch4sc17_4a25e389:

#   ki "*Squeeze* It’s okay. I know how scared you must’ve been..."
    ki "*Aperta* Está tudo bem. Eu sei o quanto você deve ter ficado assustado(a)..."

# game/chapters/chapter4/script/ch4sc17.rpy:1370
translate brazil ch4sc17_b0c9dcf6:

#   pl "*Sobs* He was terrifying, Kira! H-How could he ask me to kill you?! My own twin sister!"
    pl "*Soluços* Ele era aterrorizante, Kira! C-Como ele pôde me pedir para te matar?! Minha própria irmã gêmea!"

# game/chapters/chapter4/script/ch4sc17.rpy:1371
translate brazil ch4sc17_7e052cd1:

#   pl "*Sobs* We both know Daddy doesn’t make idle threats! I thought if I could scare you off-"
    pl "*Soluços* Nós dois sabemos que o papai não faz ameaças à toa! Pensei que se eu conseguisse te assustar..."

# game/chapters/chapter4/script/ch4sc17.rpy:1372
translate brazil ch4sc17_345948da:

#   ki "Pearl, just shut up and hug me already."
    ki "Pearl, cala a boca e me abraça logo."

# game/chapters/chapter4/script/ch4sc17.rpy:1376
translate brazil ch4sc17_395e9fe9:

#   ki "That’s it... deep breaths. Just like when we were little. Remember?"
    ki "Isso mesmo... respira fundo. Igualzinho a quando éramos crianças. Lembra?"

# game/chapters/chapter4/script/ch4sc17.rpy:1380
translate brazil ch4sc17_c9feba5e:

#   pl "*Sniff* Like when you taught me how to swim?"
    pl "*Snif* Tipo quando você me ensinou a nadar?"

# game/chapters/chapter4/script/ch4sc17.rpy:1381
translate brazil ch4sc17_d78cb040:

#   ki "Exactly. Deep breaths... Just like when you were about to go underwater and swim with the shiny fishes."
    ki "Exatamente. Respire fundo... Igualzinho quando você ia mergulhar e nadar com os peixes brilhantes."

# game/chapters/chapter4/script/ch4sc17.rpy:1383
translate brazil ch4sc17_b0f09490:

#   pl "Heh-heh! They were so shiny, Kira! You would’ve loved to see them."
    pl "Hehe! Eles eram tão brilhantes, Kira! Você teria adorado vê-los."

# game/chapters/chapter4/script/ch4sc17.rpy:1384
translate brazil ch4sc17_3661649f:

#   pl "They were fast too! The way they circled all around me. They were curious what kind of creature I was!"
    pl "Eles também eram rápidos! O jeito como me rodeavam. Estavam curiosos para saber que tipo de criatura eu era!"

# game/chapters/chapter4/script/ch4sc17.rpy:1386
translate brazil ch4sc17_5f139ae8:

#   ki "Maybe you and I could go find some new shiny fishes after all this is over?"
    ki "Talvez você e eu pudéssemos ir procurar alguns peixes novos e brilhantes depois que tudo isso acabar?"

# game/chapters/chapter4/script/ch4sc17.rpy:1387
translate brazil ch4sc17_480b27dc:

#   pl "Yes! I mean... OK, if we absolutely must..."
    pl "Sim! Quer dizer... OK, se for absolutamente necessário..."

# game/chapters/chapter4/script/ch4sc17.rpy:1388
translate brazil ch4sc17_715894e9:

#   pl "Should we go help [mc]?"
    pl "Devemos ir ajudar? [mc]?"

# game/chapters/chapter4/script/ch4sc17.rpy:1389
translate brazil ch4sc17_5a22b249:

#   ki "Not yet. He has to clear father's fleet first. Come, let’s go see our man in action."
    ki "Ainda não. Ele precisa primeiro eliminar a frota do pai. Venha, vamos ver nosso homem em ação."

# game/chapters/chapter4/script/ch4sc17.rpy:1390
translate brazil ch4sc17_9ab7ace6:

#   pl "O-Okay."
    pl "Ok."

# game/chapters/chapter4/script/ch4sc17.rpy:1393
translate brazil ch4sc17_a7b0c72a:

#   pl "He told me about his abilities one night. But this is far beyond what I imagined..."
    pl "Certa noite, ele me contou sobre suas habilidades. Mas isso vai muito além do que eu imaginava..."

# game/chapters/chapter4/script/ch4sc17.rpy:1394
translate brazil ch4sc17_67c77fc6:

#   ki "He’s incredible, Pearl."
    ki "Ele é incrível, Pearl."

# game/chapters/chapter4/script/ch4sc17.rpy:1397
translate brazil ch4sc17_91bb0d9b:

#   ki "Look at him go. Blasting father’s ships as if they were nothing."
    ki "Olha só ele! Destruindo as naves do pai como se não fossem nada."

# game/chapters/chapter4/script/ch4sc17.rpy:1398
translate brazil ch4sc17_c3e8c603:

#   pl "Sis! You’re totally crushing on [mc]!"
    pl "Amiga! Você está completamente apaixonada por ele. [mc]!"

# game/chapters/chapter4/script/ch4sc17.rpy:1402
translate brazil ch4sc17_79d29a43:

#   pl "Not even denying it anymore?"
    pl "Nem sequer nega mais?"

# game/chapters/chapter4/script/ch4sc17.rpy:1403
translate brazil ch4sc17_782a9d47:

#   ki "[mc]... He... He’s amazing. Strong, kind, smart, respectful. A man that wields that kind of power?"
    ki "[mc] Ele... Ele é incrível. Forte, gentil, inteligente, respeitoso. Um homem que exerce esse tipo de poder?"

# game/chapters/chapter4/script/ch4sc17.rpy:1404
translate brazil ch4sc17_b5c049a4:

#   ki "You’ve seen how power-hungry most men are, and how they treat us..."
    ki "Você já viu como a maioria dos homens são ambiciosos por poder e como eles nos tratam..."

# game/chapters/chapter4/script/ch4sc17.rpy:1405
translate brazil ch4sc17_ac3cc97a:

#   ki "[mc] could easily bend us to his will, but he doesn’t. He actually respects us."
    ki "[mc] Ele poderia facilmente nos dobrar à sua vontade, mas não o faz. Na verdade, ele nos respeita."

# game/chapters/chapter4/script/ch4sc17.rpy:1406
translate brazil ch4sc17_1c3e0730:

#   pl "I know... I wouldn’t mind him bending me a little, though..."
    pl "Eu sei... Mas não me importaria se ele me dobrasse um pouco..."

# game/chapters/chapter4/script/ch4sc17.rpy:1408
translate brazil ch4sc17_db9eb23c:

#   ki "Pearl!! You're shameless..."
    ki "Pérola!! Você é descarada..."

# game/chapters/chapter4/script/ch4sc17.rpy:1409
translate brazil ch4sc17_f39def9a:

#   pl "*Laughs* What? I bet you have thought about it too! Him bending you over that is!"
    pl "*Risos* O quê? Aposto que você também já pensou nisso! Ele te virando de quatro, isso sim!"

# game/chapters/chapter4/script/ch4sc17.rpy:1410
translate brazil ch4sc17_a5c61ca0:

#   ki "I liked it better when we were fighting..."
    ki "Eu gostava mais quando estávamos brigando..."

# game/chapters/chapter4/script/ch4sc17.rpy:1411
translate brazil ch4sc17_a8c2ba85:

#   pl "Love you too, sis."
    pl "Também te amo, irmã."

# game/chapters/chapter4/script/ch4sc17.rpy:1418
translate brazil ch4sc17_877f5b28:

#   mct "Only one ship left and it should be clear for Kira to come through."
    mct "Só falta mais um navio e o caminho deverá ficar livre para Kira passar."

# game/chapters/chapter4/script/ch4sc17.rpy:1423
translate brazil ch4sc17_eb0682c9:

#   mct "That should do it. I hope Kira has been able to handle Pearl..."
    mct "Isso deve resolver o problema. Espero que Kira tenha conseguido lidar com Pearl..."

# game/chapters/chapter4/script/ch4sc17.rpy:1424
translate brazil ch4sc17_41bee024:

#   mct "I saw her sneak on the ship earlier, but they need to sort it out themselves."
    mct "Eu a vi entrar sorrateiramente no navio mais cedo, mas eles precisam resolver isso entre si."

# game/chapters/chapter4/script/ch4sc17.rpy:1425
translate brazil ch4sc17_e4e575b7:

#   mct "I'd better get to work on the docks."
    mct "É melhor eu ir trabalhar nas docas."

# game/chapters/chapter4/script/ch4sc17.rpy:1427
translate brazil ch4sc17_762a9dd3:

#   ki "Looks like he’s all done. What do you think, sis? Should we join in on the fun?"
    ki "Parece que ele já terminou. O que você acha, mana? Devemos entrar na brincadeira também?"

# game/chapters/chapter4/script/ch4sc17.rpy:1428
translate brazil ch4sc17_3823838b:

#   pl "I think it’s high time we show Father that we have a new dadd-"
    pl "Acho que já está na hora de mostrarmos ao papai que temos um novo pai."

# game/chapters/chapter4/script/ch4sc17.rpy:1431
translate brazil ch4sc17_63216de9:

#   ki "Don’t you dare finish that sentence, you little perv!"
    ki "Nem pense em terminar essa frase, seu pervertidozinho!"

# game/chapters/chapter4/script/ch4sc17.rpy:1432
translate brazil ch4sc17_bef40f12:

#   pl "*Giggles* 'Kay, I won’t! But we were both thinking it!"
    pl "*Risos* 'Tá bom, eu não vou! Mas nós duas estávamos pensando nisso!"

# game/chapters/chapter4/script/ch4sc17.rpy:1434
translate brazil ch4sc17_12c30cfb:

#   pl "Let’s go help him get his artifact back!"
    pl "Vamos ajudá-lo a recuperar seu artefato!"

# game/chapters/chapter4/script/ch4sc17.rpy:1436
translate brazil ch4sc17_fef281d1:

#   mct "How many men does Blackheart have?"
    mct "Quantos homens Blackheart tem?"

# game/chapters/chapter4/script/ch4sc17.rpy:1437
translate brazil ch4sc17_b951c991:

#   mct "Doesn’t matter. I will cut them all down."
    mct "Não importa. Vou cortar todas elas."

# game/chapters/chapter4/script/ch4sc17.rpy:1439
translate brazil ch4sc17_96d02eb6:

#   ki "Hey... Need a hand?"
    ki "Ei... Precisa de uma mãozinha?"

# game/chapters/chapter4/script/ch4sc17.rpy:1441
translate brazil ch4sc17_ede9dd10:

#   pl "Or two...?"
    pl "Ou dois...?"

# game/chapters/chapter4/script/ch4sc17.rpy:1442
translate brazil ch4sc17_2af503a1:

#   mct "I’ll be damned. Kira actually got Pearl back on our side."
    mct "Não acredito. Kira realmente conseguiu trazer Pearl de volta para o nosso lado."

# game/chapters/chapter4/script/ch4sc17.rpy:1444
translate brazil ch4sc17_d777f238:

#   mc "It’s good to have you back, Pearl."
    mc "Que bom que você voltou, Pearl."

# game/chapters/chapter4/script/ch4sc17.rpy:1446
translate brazil ch4sc17_a5e707aa:

#   pl "I should’ve never left. I’m... I’m really sorry."
    pl "Eu nunca deveria ter ido embora. Eu... eu sinto muito mesmo."

# game/chapters/chapter4/script/ch4sc17.rpy:1447
translate brazil ch4sc17_da15d19f:

#   pl "I’ve really missed our late night chats... I’ve missed you."
    pl "Senti muita falta das nossas conversas até altas horas da noite... Senti sua falta."

# game/chapters/chapter4/script/ch4sc17.rpy:1452
translate brazil ch4sc17_d1514bd4:

#   mc "I’ve missed you too, and that cheeky smirk of yours."
    mc "Eu também senti sua falta, e daquele seu sorrisinho maroto."

# game/chapters/chapter4/script/ch4sc17.rpy:1453
translate brazil ch4sc17_d8c510a9:

#   "Pearl is happily surprised you didn't scold her, her trust has increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Pearl ficou feliz e surpresa por você não a ter repreendido; a confiança dela aumentou bastante. {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc17.rpy:1458
translate brazil ch4sc17_6c512f22:

#   mc "Before we can have anymore late night chats, we have some ass-kicking to do."
    mc "Antes de podermos continuar com nossas conversas noturnas, precisamos dar uma surra em alguém."

# game/chapters/chapter4/script/ch4sc17.rpy:1459
translate brazil ch4sc17_8ca55437:

#   "Pearl is surprised you didn't scold her, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Pearl ficou surpresa por você não a ter repreendido; a confiança dela aumentou bastante. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc17.rpy:1464
translate brazil ch4sc17_852cd312:

#   ki "If you two are done making up, we have a situation. And they’re coming straight for us!"
    ki "Se vocês dois já terminaram de se reconciliar, temos um problema. E eles estão vindo direto para cima de nós!"

# game/chapters/chapter4/script/ch4sc17.rpy:1465
translate brazil ch4sc17_e5595053:

#   pl "Let’s get to it!"
    pl "Vamos começar!"

# game/chapters/chapter4/script/ch4sc17.rpy:1472
translate brazil ch4sc17_804ecfb0:

#   pl "Hrrrh! I’ll take the left side, Kira you take the right! [mc], you take the middle!"
    pl "Hrrrh! Eu fico com o lado esquerdo, Kira, você fica com o direito! [mc], você fica com o do meio!"

# game/chapters/chapter4/script/ch4sc17.rpy:1475
translate brazil ch4sc17_a0ada61e:

#   ki "Hhiiyaah! I’ll bathe the docks in your blood! Bastard!"
    ki "Hhiiyaah! Vou banhar as docas com o seu sangue! Seu desgraçado!"

# game/chapters/chapter4/script/ch4sc17.rpy:1477
translate brazil ch4sc17_d1b97b57:

#   mct "I'd better hold off on using anymore of my powers, I’ve already used them to take out the fleet."
    mct "É melhor eu não usar mais nenhum dos meus poderes, já os usei para destruir a frota."

# game/chapters/chapter4/script/ch4sc17.rpy:1479
translate brazil ch4sc17_3ec2c9af:

#   mct "I still don’t know what their father is capable of to inspire such fear among his people."
    mct "Ainda não sei do que o pai deles é capaz para inspirar tanto medo em seu povo."

# game/chapters/chapter4/script/ch4sc17.rpy:1480
translate brazil ch4sc17_15608ed7:

#   mct "I can’t risk falling unconscious before facing him."
    mct "Não posso arriscar desmaiar antes de encará-lo."

# game/chapters/chapter4/script/ch4sc17.rpy:1482
translate brazil ch4sc17_c5af1c2b:

#   mct "I don't know the full effects of his ring, but he is likely to use it against me when I charge him."
    mct "Não conheço todos os efeitos do anel dele, mas é provável que ele o use contra mim quando eu o atacar."

# game/chapters/chapter4/script/ch4sc17.rpy:1483
translate brazil ch4sc17_b5807175:

#   mct "Time to show Blackheart what happens when you betray me..."
    mct "Chegou a hora de mostrar a Blackheart o que acontece quando você me trai..."

# game/chapters/chapter4/script/ch4sc17.rpy:1490
translate brazil ch4sc17_495246c3:

#   mct "A dislocated jaw for you!"
    mct "Uma mandíbula deslocada para você!"

# game/chapters/chapter4/script/ch4sc17.rpy:1494
translate brazil ch4sc17_267b1ed0:

#   mct "A broken neck for you!"
    mct "Que você quebre o pescoço!"

# game/chapters/chapter4/script/ch4sc17.rpy:1497
translate brazil ch4sc17_12428f12:

#   cb "{b}ENOUGH!!{/b}"
    cb "{b}SUFICIENTE!!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1498
translate brazil ch4sc17_fd090d29:

#   cb "I’ve grown tired of your pathetic displays of power."
    cb "Já me cansei das suas patéticas demonstrações de poder."

# game/chapters/chapter4/script/ch4sc17.rpy:1500
translate brazil ch4sc17_473f74a0:

#   cb "This is what you want, isn’t it?"
    cb "É isso que você quer, não é?"

# game/chapters/chapter4/script/ch4sc17.rpy:1501
translate brazil ch4sc17_42084aa4:

#   cb "Why don’t you stop being a little boy? Come and get it!"
    cb "Por que você não para de ser um garotinho? Venha pegar!"

# game/chapters/chapter4/script/ch4sc17.rpy:1503
translate brazil ch4sc17_5f64ebb6:

#   ki "[mc]! No! He's taunting you!"
    ki "[mc] Não! Ele está te provocando!"

# game/chapters/chapter4/script/ch4sc17.rpy:1504
translate brazil ch4sc17_e0277353:

#   ki "Don't listen to him!"
    ki "Não dê ouvidos a ele!"

# game/chapters/chapter4/script/ch4sc17.rpy:1506
translate brazil ch4sc17_1ac9b7fc:

#   cb "Hahaha! Are you going to let a woman tell you what to do? You really are a little boy!"
    cb "Hahaha! Vai deixar uma mulher te dizer o que fazer? Você é mesmo um garotinho!"

# game/chapters/chapter4/script/ch4sc17.rpy:1507
translate brazil ch4sc17_30db0969:

#   cb "Pathetic!"
    cb "Patético!"

# game/chapters/chapter4/script/ch4sc17.rpy:1511
translate brazil ch4sc17_b8f2cea1:

#   ki "{b}[mc]!!{/b}"
    ki "{b}[mc]!!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1512
translate brazil ch4sc17_d41c94ad:

#   pl "Father! Please don’t!"
    pl "Pai! Por favor, não faça isso!"

# game/chapters/chapter4/script/ch4sc17.rpy:1514
translate brazil ch4sc17_eca85b7b:

#   cb "Heh! We’ve got him now. Do your thing, Szhar!"
    cb "Heh! Agora o pegamos. Faça o que sabe fazer, Szhar!"

# game/chapters/chapter4/script/ch4sc17.rpy:1516
translate brazil ch4sc17_7b3bd146:

#   uk "*Hissing* Szhaa! Trap! Ssszh, yes! Trap! Kill!"
    uk "*Sibilando* Szhaa! Armadilha! Ssszh, sim! Armadilha! Matar!"

# game/chapters/chapter4/script/ch4sc17.rpy:1519
translate brazil ch4sc17_cec4b520:

#   uk "*Hissing* Szaahh!!"
    uk "*Sibilando* Szaahh!!"

# game/chapters/chapter4/script/ch4sc17.rpy:1522
translate brazil ch4sc17_a15eefa3:

#   mc "*Groans* Arhhh!!"
    mc "*Gemidos* Arghhh!!"

# game/chapters/chapter4/script/ch4sc17.rpy:1524
translate brazil ch4sc17_c4c10b9a:

#   mc "*Painful groan* Hhrrrhh!"
    mc "*Gemido de dor* Hhrrrhh!"

# game/chapters/chapter4/script/ch4sc17.rpy:1525
translate brazil ch4sc17_b8a52155:

#   cb "Haha! Fool! You’re about to find out what happens to those who oppose me! Blackheart..."
    cb "Haha! Seu tolo! Você está prestes a descobrir o que acontece com aqueles que se opõem a mim! Coração Negro..."

# game/chapters/chapter4/script/ch4sc17.rpy:1527
translate brazil ch4sc17_8626aaf4:

#   cb "{b}KING OF PIRATES!!{/b}"
    cb "{b}REI DOS PIRATAS!!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1529
translate brazil ch4sc17_31fea732:

#   mc "What... Hrrrh! Is this?!"
    mc "O quê... Hrrrh! É isto?!"

# game/chapters/chapter4/script/ch4sc17.rpy:1530
translate brazil ch4sc17_9e7bca40:

#   cb "Oh this? It’s something special I have prepared for you... a prison."
    cb "Ah, isto? É algo especial que preparei para você... uma prisão."

# game/chapters/chapter4/script/ch4sc17.rpy:1532
translate brazil ch4sc17_08cf277a:

#   cb "I’ll see you in there... boy."
    cb "Te vejo lá dentro... garoto."

# game/chapters/chapter4/script/ch4sc17.rpy:1533
translate brazil ch4sc17_3dfbf243:

#   mc "Hhrrrhh! Bastard! I'll kill you for this."
    mc "Hhrrrhh! Seu desgraçado! Vou te matar por isso."

# game/chapters/chapter4/script/ch4sc17.rpy:1535
translate brazil ch4sc17_be902507:

#   cb "*Laughs* Making threats in your position? Pathetic!"
    cb "*Risos* Fazendo ameaças na sua posição? Patético!"

# game/chapters/chapter4/script/ch4sc17.rpy:1536
translate brazil ch4sc17_409baba9:

#   pl "{b}[mc]!!{/b}"
    pl "{b}[mc]!!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1538
translate brazil ch4sc17_7bc6902f:

#   pl "[mc]!! Father! Stop this!"
    pl "[mc] Pai! Pare com isso!"

# game/chapters/chapter4/script/ch4sc17.rpy:1539
translate brazil ch4sc17_7b69d1b6:

#   pl "I won’t forgive you for this!"
    pl "Eu não vou te perdoar por isso!"

# game/chapters/chapter4/script/ch4sc17.rpy:1551
translate brazil ch4sc17_22ff0fb7:

#   mc "*Groans* Urrh... What the hell happened? Where am I?"
    mc "*Gemidos* Urrh... Que diabos aconteceu? Onde estou?"

# game/chapters/chapter4/script/ch4sc17.rpy:1552
translate brazil ch4sc17_0ee0ee80:

#   mc "The ground feels... odd. The air is different as well... dry and cold."
    mc "O chão parece... estranho. O ar também está diferente... seco e frio."

# game/chapters/chapter4/script/ch4sc17.rpy:1553
translate brazil ch4sc17_99344cb1:

#   mc "Did his ring do this? Is it really capable of creating and even transporting me to another dimension?"
    mc "Será que o anel dele fez isso? Será que ele é realmente capaz de criar e até mesmo me transportar para outra dimensão?"

# game/chapters/chapter4/script/ch4sc17.rpy:1557
translate brazil ch4sc17_00f01326:

#   cb "Welcome to {b}Decimore!{/b} My own little dimension."
    cb "Bem-vindo(a) ao {b} Décimore!{/b} Minha própria pequena dimensão."

# game/chapters/chapter4/script/ch4sc17.rpy:1558
translate brazil ch4sc17_cc08caaa:

#   cb "I’m so glad you could make it... It’s been a while since I've had visitors. Please, make yourself at home."
    cb "Que bom que você pôde vir... Faz tempo que não recebo visitas. Por favor, fique à vontade."

# game/chapters/chapter4/script/ch4sc17.rpy:1559
translate brazil ch4sc17_c3bbcd8a:

#   cb "You’ll be here a while..."
    cb "Você ficará aqui por um tempo..."

# game/chapters/chapter4/script/ch4sc17.rpy:1561
translate brazil ch4sc17_47b0c58c:

#   mc "*Grunts* Deci- what?"
    mc "*Grunhido* Deci- o quê?"

# game/chapters/chapter4/script/ch4sc17.rpy:1562
translate brazil ch4sc17_cbc83e66:

#   cb "{b}Decimore!{/b} I guess I can’t blame you for not knowing it... It’s not exactly a touristy place."
    cb "{b}Décimore!{/b} Acho que não posso te culpar por não saber... Não é exatamente um lugar turístico."

# game/chapters/chapter4/script/ch4sc17.rpy:1563
translate brazil ch4sc17_ff52e1b3:

#   mc "Your... ring."
    mc "Seu... anel."

# game/chapters/chapter4/script/ch4sc17.rpy:1564
translate brazil ch4sc17_d8709395:

#   mc "It did this? Created this?"
    mc "Foi ele que fez isso? Criou isso?"

# game/chapters/chapter4/script/ch4sc17.rpy:1566
translate brazil ch4sc17_d4801cdb:

#   cb "Correct. It has carved out my own little area in the third layer of hell."
    cb "Correto. Isso criou meu próprio cantinho no terceiro círculo do inferno."

# game/chapters/chapter4/script/ch4sc17.rpy:1567
translate brazil ch4sc17_ee7d9cbf:

#   mc "Third layer of hell? ... what?"
    mc "Terceiro círculo do inferno? ... o quê?"

# game/chapters/chapter4/script/ch4sc17.rpy:1569
translate brazil ch4sc17_69534275:

#   cb "You don’t even know, do you? Have you even studied the lore of Midomir and it’s realms?"
    cb "Você nem sabe, não é? Você sequer estudou a história de Midomir e seus reinos?"

# game/chapters/chapter4/script/ch4sc17.rpy:1570
translate brazil ch4sc17_1dcd298e:

#   mc "No... can’t say that I have."
    mc "Não... não posso dizer que sim."

# game/chapters/chapter4/script/ch4sc17.rpy:1571
translate brazil ch4sc17_c2b71479:

#   cb "Hah! You really are a boy..."
    cb "Hah! Você é mesmo um menino..."

# game/chapters/chapter4/script/ch4sc17.rpy:1573
translate brazil ch4sc17_91f7f70a:

#   cb "Allow me to give you a little summary, then."
    cb "Permita-me, então, fazer um breve resumo."

# game/chapters/chapter4/script/ch4sc17.rpy:1574
translate brazil ch4sc17_86919823:

#   cb "This here is a little part of Decimore the third layer of hell. In total there are five layers of hell."
    cb "Esta é uma pequena parte de Decimore, a terceira camada do inferno. No total, existem cinco camadas do inferno."

# game/chapters/chapter4/script/ch4sc17.rpy:1579
translate brazil ch4sc17_4bed826a:

#   cb "Let's begin with the 1st layer of the hells, Infernus."
    cb "Vamos começar com a primeira camada dos infernos, Infernus."

# game/chapters/chapter4/script/ch4sc17.rpy:1580
translate brazil ch4sc17_6130b525:

#   cb "As the 1st of five layers, Infernus is closest to the surface of Midomir, the planet that we live on as mortals."
    cb "Sendo a primeira das cinco camadas, Infernus é a mais próxima da superfície de Midomir, o planeta em que vivemos como mortais."

# game/chapters/chapter4/script/ch4sc17.rpy:1583
translate brazil ch4sc17_153356f9:

#   cb "Each layer functions as it's own separate realm within Midomir's core."
    cb "Cada camada funciona como um reino separado dentro do núcleo de Midomir."

# game/chapters/chapter4/script/ch4sc17.rpy:1584
translate brazil ch4sc17_383cdb72:

#   cb "Infernus is a hellish and ravaged landscape, filled with Volcanoes..."
    cb "Infernus é uma paisagem infernal e devastada, repleta de vulcões..."

# game/chapters/chapter4/script/ch4sc17.rpy:1585
translate brazil ch4sc17_22cdea24:

#   cb "Oceans of molten lava, and a wide number of hellish creatures which calls this inhospitable realm home."
    cb "Oceanos de lava derretida e uma vasta gama de criaturas infernais que chamam este reino inóspito de lar."

# game/chapters/chapter4/script/ch4sc17.rpy:1590
translate brazil ch4sc17_c05a3891:

#   cb "As for the ruler of Infernus, it would be none other than the Archdevil, Infernith."
    cb "Quanto ao governante de Infernus, não seria outro senão o Arquidemônio, Infernith."

# game/chapters/chapter4/script/ch4sc17.rpy:1591
translate brazil ch4sc17_9efe5b20:

#   cb "Rumors has it that she was but a regular devil originally."
    cb "Dizem por aí que, originalmente, ela não passava de um demônio comum."

# game/chapters/chapter4/script/ch4sc17.rpy:1594
translate brazil ch4sc17_8ccf9d43:

#   cb "Several millennia ago she rose to the position of Archdevil..."
    cb "Há vários milênios, ela ascendeu à posição de Arquidemônio..."

# game/chapters/chapter4/script/ch4sc17.rpy:1595
translate brazil ch4sc17_e984e505:

#   cb "By betraying the previous Archdevil of Infernus, a very respectable way to elevate your position if you ask me."
    cb "Ao trair o antigo Arquidemônio de Infernus, uma maneira bastante respeitável de ascender na carreira, na minha opinião."

# game/chapters/chapter4/script/ch4sc17.rpy:1596
translate brazil ch4sc17_4e4397f9:

#   mc "Of course a pirate would think so."
    mc "É claro que um pirata pensaria assim."

# game/chapters/chapter4/script/ch4sc17.rpy:1597
translate brazil ch4sc17_134084fa:

#   cb "Upon their death Infernith took advantage and absorbed their essence, thus becoming the Archdevil herself."
    cb "Após a morte deles, Infernith aproveitou a oportunidade e absorveu a essência deles, tornando-se assim a própria Arquidemônio."

# game/chapters/chapter4/script/ch4sc17.rpy:1600
translate brazil ch4sc17_c5c5152b:

#   cb "As the Archdevil of Infernus she is the weakest of the five Archdevils."
    cb "Como arquidemônio de Infernus, ela é a mais fraca dos cinco arquidemônios."

# game/chapters/chapter4/script/ch4sc17.rpy:1601
translate brazil ch4sc17_e9c75dfc:

#   cb "As their strength correlates to the layer of hell which they rule."
    cb "Pois sua força está diretamente relacionada à camada do inferno que governam."

# game/chapters/chapter4/script/ch4sc17.rpy:1602
translate brazil ch4sc17_ffa593dd:

#   cb "However being the weakest of some of the strongest beings in the universe, is hardly a tragedy."
    cb "Contudo, ser o mais fraco entre alguns dos seres mais fortes do universo dificilmente é uma tragédia."

# game/chapters/chapter4/script/ch4sc17.rpy:1603
translate brazil ch4sc17_d741ca69:

#   cb "It's said that she fools her opponents with her cutesy demeanor or flirtatious attitude."
    cb "Dizem que ela engana seus oponentes com seu jeito fofo ou sua atitude sedutora."

# game/chapters/chapter4/script/ch4sc17.rpy:1604
translate brazil ch4sc17_17fe4887:

#   cb "But don't let that fool you..."
    cb "Mas não se deixe enganar..."

# game/chapters/chapter4/script/ch4sc17.rpy:1605
translate brazil ch4sc17_fe85836b:

#   cb "For even as the weakest of the five Archdevils, she holds vast power, enough to put her well above most gods and goddesses."
    cb "Mesmo sendo a mais fraca dos cinco Arquidemônios, ela detém um poder imenso, suficiente para colocá-la muito acima da maioria dos deuses e deusas."

# game/chapters/chapter4/script/ch4sc17.rpy:1610
translate brazil ch4sc17_11d9196c:

#   cb "Let's move on, to the 2nd layer of the hells, Dys."
    cb "Vamos prosseguir para a segunda camada dos infernos, Dys."

# game/chapters/chapter4/script/ch4sc17.rpy:1611
translate brazil ch4sc17_c13a6660:

#   cb "Dys is a stark contrast to Infernus."
    cb "Dys é um forte contraste com Infernus."

# game/chapters/chapter4/script/ch4sc17.rpy:1612
translate brazil ch4sc17_0b088b36:

#   cb "Instead of a molten and typical hellish landscape, Dys captures another essence of the hells, barren wastelands of frost and ice."
    cb "Em vez de uma paisagem infernal típica e incandescente, Dys captura outra essência dos infernos: desertos áridos de gelo e geada."

# game/chapters/chapter4/script/ch4sc17.rpy:1615
translate brazil ch4sc17_e7289720:

#   cb "Dys has an ominous beauty to it..."
    cb "Dys possui uma beleza sinistra..."

# game/chapters/chapter4/script/ch4sc17.rpy:1616
translate brazil ch4sc17_1de3085f:

#   cb "Souls that end up within this layer of the hells will come to know true isolation."
    cb "As almas que acabam nessa camada dos infernos conhecerão o verdadeiro isolamento."

# game/chapters/chapter4/script/ch4sc17.rpy:1619
translate brazil ch4sc17_cf3533f4:

#   cb "The Archdevil and eternal ruler of Dys is none other than Dyssia."
    cb "O arquidemônio e governante eterno de Dys não é outro senão Dyssia."

# game/chapters/chapter4/script/ch4sc17.rpy:1620
translate brazil ch4sc17_0dfe09a3:

#   cb "She is rumored to be both beautiful and cute..."
    cb "Há rumores de que ela seja bonita e fofa..."

# game/chapters/chapter4/script/ch4sc17.rpy:1621
translate brazil ch4sc17_3dd0bd84:

#   cb "But one touch... or kiss, from this Archdevil can flashfreeze even hellfiends and blazehounds with little effort."
    cb "Mas um toque... ou um beijo, deste Arquidemônio pode congelar instantaneamente até mesmo demônios infernais e cães de fogo com pouco esforço."

# game/chapters/chapter4/script/ch4sc17.rpy:1624
translate brazil ch4sc17_3a8c4af3:

#   cb "Dyssia is the most potent wielder of frost and ice magical affinities within all the known realms."
    cb "Dyssia é a usuária mais poderosa das afinidades mágicas com o gelo e a geada em todos os reinos conhecidos."

# game/chapters/chapter4/script/ch4sc17.rpy:1625
translate brazil ch4sc17_39925abc:

#   cb "If you bore her, she'll not hesitate to turn you into a permanent frost sculpture to decorate her frozen palace deep within Dys."
    cb "Se você a entediar, ela não hesitará em transformá-lo em uma escultura de gelo permanente para decorar seu palácio congelado nas profundezas de Dys."

# game/chapters/chapter4/script/ch4sc17.rpy:1630
translate brazil ch4sc17_4e7a00b8:

#   cb "Let's move on to our current location."
    cb "Vamos então para a nossa localização atual."

# game/chapters/chapter4/script/ch4sc17.rpy:1631
translate brazil ch4sc17_394683e4:

#   cb "You're currently in small part of Decimore, conjured by my ring."
    cb "Você está atualmente em uma pequena parte de Decimore, conjurada pelo meu anel."

# game/chapters/chapter4/script/ch4sc17.rpy:1632
translate brazil ch4sc17_3ba04b76:

#   cb "Decimore is a desolate and isolated realm covered in eternal darkness."
    cb "Decimore é um reino desolado e isolado, envolto em escuridão eterna."

# game/chapters/chapter4/script/ch4sc17.rpy:1635
translate brazil ch4sc17_96ee37a2:

#   cb "Decimore is the layer of hell that has seen the most battle..."
    cb "Décimore é a camada do inferno que presenciou o maior número de batalhas..."

# game/chapters/chapter4/script/ch4sc17.rpy:1636
translate brazil ch4sc17_77ef81a8:

#   cb "As it was the center stage where majority of the Abyss wars took place during the 1st Era."
    cb "Por ter sido o palco principal onde a maioria das Guerras do Abismo ocorreram durante a 1ª Era."

# game/chapters/chapter4/script/ch4sc17.rpy:1637
translate brazil ch4sc17_10a18e69:

#   cb "As such Decimore's desolate wasteland and war-torn landscapes has countless long-forgotten artifacts-"
    cb "Assim, as terras devastadas e as paisagens áridas de Decimore, assoladas pela guerra, abrigam inúmeros artefatos há muito esquecidos."

# game/chapters/chapter4/script/ch4sc17.rpy:1638
translate brazil ch4sc17_9b01422e:

#   cb "-And the remains of great champions as well as skeletons of creatures from Era's past scattered throughout."
    cb "-E os restos mortais de grandes campeões, assim como esqueletos de criaturas do passado, estão espalhados por toda parte."

# game/chapters/chapter4/script/ch4sc17.rpy:1641
translate brazil ch4sc17_9d5face9:

#   cb "As for the ruler of this lovely realm? None other than the Archdevil of Decimore, Deci."
    cb "E quanto ao governante deste belo reino? Ninguém menos que o Arquidemônio de Decimore, Deci."

# game/chapters/chapter4/script/ch4sc17.rpy:1642
translate brazil ch4sc17_f7da4e57:

#   cb "Deci was once no more than a regular succubus with ambitions much too grand for such a lowly creature."
    cb "Deci já foi nada mais que uma súcubo comum com ambições muito maiores do que a de uma criatura tão insignificante."

# game/chapters/chapter4/script/ch4sc17.rpy:1643
translate brazil ch4sc17_c3d2b4ca:

#   cb "And yet, today she stands as one of the most powerful beings in existence."
    cb "E, no entanto, hoje ela se destaca como um dos seres mais poderosos que existem."

# game/chapters/chapter4/script/ch4sc17.rpy:1646
translate brazil ch4sc17_2c0696fa:

#   cb "If that doesn't scream 'Don't let your dreams be dreams' I don't know what does."
    cb "Se isso não grita \"Não deixe que seus sonhos sejam apenas sonhos\", eu não sei o que grita."

# game/chapters/chapter4/script/ch4sc17.rpy:1647
translate brazil ch4sc17_7966d05a:

#   cb "Her fierce ambition catapulted her into power shortly after the Abyss wars had ended..."
    cb "Sua ambição desmedida a catapultou para o poder logo após o fim das Guerras do Abismo..."

# game/chapters/chapter4/script/ch4sc17.rpy:1648
translate brazil ch4sc17_f6d66ccb:

#   cb "The aftermath of the wars had left Decimore in turmoil and without a ruler."
    cb "O rescaldo das guerras deixou Decimore em turbulência e sem um governante."

# game/chapters/chapter4/script/ch4sc17.rpy:1649
translate brazil ch4sc17_4fef2a74:

#   cb "An opportunity she would not let slip."
    cb "Uma oportunidade que ela não deixaria escapar."

# game/chapters/chapter4/script/ch4sc17.rpy:1650
translate brazil ch4sc17_f905d92a:

#   cb "She rose from the shadows ready to betray, lie, cheat and steal whatever she had to in order to achieve her dream, and she succeeded."
    cb "Ela emergiu das sombras pronta para trair, mentir, enganar e roubar tudo o que fosse necessário para realizar seu sonho, e conseguiu."

# game/chapters/chapter4/script/ch4sc17.rpy:1655
translate brazil ch4sc17_f62fd5b7:

#   cb "Let's move on to the 4th layer... Methos."
    cb "Vamos passar para a 4ª camada... Métodos."

# game/chapters/chapter4/script/ch4sc17.rpy:1656
translate brazil ch4sc17_1f4dae91:

#   cb "Methos is a realm consisting of vast sandy deserts and large rocky formations and mountains."
    cb "Methos é um reino constituído por vastos desertos arenosos, grandes formações rochosas e montanhas."

# game/chapters/chapter4/script/ch4sc17.rpy:1657
translate brazil ch4sc17_3036532c:

#   cb "The landscape of Methos is much alike that of Arazalia's deserts, except..."
    cb "A paisagem de Methos é muito semelhante à dos desertos de Arazalia, exceto..."

# game/chapters/chapter4/script/ch4sc17.rpy:1658
translate brazil ch4sc17_d23a5a6c:

#   cb "Methos is plunged into eternal night, lit up only by it's purple sun."
    cb "Methos está mergulhada em uma noite eterna, iluminada apenas por seu sol púrpura."

# game/chapters/chapter4/script/ch4sc17.rpy:1661
translate brazil ch4sc17_b8d6c28e:

#   cb "Scattered all across Methos is various ancient technologies..."
    cb "Espalhadas por todo o Methos encontram-se diversas tecnologias antigas..."

# game/chapters/chapter4/script/ch4sc17.rpy:1662
translate brazil ch4sc17_78ee021b:

#   cb "Such as energy pylons and gate ways just to name a few."
    cb "Como torres de transmissão de energia e pórticos, só para citar alguns exemplos."

# game/chapters/chapter4/script/ch4sc17.rpy:1663
translate brazil ch4sc17_4f43487b:

#   cb "Methos is also known as the realm of lost souls, as souls unfortunate enough to end up here becomes twisted and tortured throughout eternity."
    cb "Methos também é conhecido como o reino das almas perdidas, pois as almas que têm o azar de parar aqui se tornam atormentadas e torturadas por toda a eternidade."

# game/chapters/chapter4/script/ch4sc17.rpy:1666
translate brazil ch4sc17_20d29469:

#   cb "As for the ruler of Methos? That would be Methodan, Archdevil of Methos."
    cb "Quanto ao governante de Methos? Esse seria Methodan, o arquidemônio de Methos."

# game/chapters/chapter4/script/ch4sc17.rpy:1667
translate brazil ch4sc17_9722a5b0:

#   cb "Methodan was once an esteemed elven mage, however as his thirst for knowledge grew..."
    cb "Methodan já foi um estimado mago élfico, porém, à medida que sua sede de conhecimento crescia..."

# game/chapters/chapter4/script/ch4sc17.rpy:1668
translate brazil ch4sc17_986fa95e:

#   cb "As did his willingness to dive deeper into dark magic, he began to delve into necromancy."
    cb "Assim como sua disposição para se aprofundar na magia negra, ele começou a explorar a necromancia."

# game/chapters/chapter4/script/ch4sc17.rpy:1671
translate brazil ch4sc17_60e42c0e:

#   cb "He began twisting the souls of the dead to do his bidding, but when his own life came to an end..."
    cb "Ele começou a manipular as almas dos mortos para que cumprissem suas ordens, mas quando sua própria vida chegou ao fim..."

# game/chapters/chapter4/script/ch4sc17.rpy:1672
translate brazil ch4sc17_811f40cd:

#   cb "He fittingly ended up in Methos, after centuries of torture and despair as a soul, he managed to gain a corporeal form, appearing as a demonic spirit."
    cb "Ele acabou, apropriadamente, em Methos, onde, após séculos de tortura e desespero como alma, conseguiu obter uma forma corpórea, aparecendo como um espírito demoníaco."

# game/chapters/chapter4/script/ch4sc17.rpy:1675
translate brazil ch4sc17_50cf4f81:

#   cb "It is said that his spirit-form is a hideous and twisted visage, a result of his dark doings in life."
    cb "Diz-se que sua forma espiritual é uma aparência horrenda e distorcida, resultado de suas ações sombrias em vida."

# game/chapters/chapter4/script/ch4sc17.rpy:1676
translate brazil ch4sc17_abb44286:

#   cb "It is unknown how he as a mere soul managed this feat, but once he did, he was chosen to be the ruler of Methos."
    cb "Não se sabe como ele, sendo apenas uma alma, conseguiu tal feito, mas uma vez que o fez, foi escolhido para ser o governante de Methos."

# game/chapters/chapter4/script/ch4sc17.rpy:1677
translate brazil ch4sc17_383ed6da:

#   cb "Torturing and feeding upon the unfortunate souls that arrives in his layer of the hells."
    cb "Torturando e se alimentando das almas infelizes que chegam ao seu círculo infernal."

# game/chapters/chapter4/script/ch4sc17.rpy:1678
translate brazil ch4sc17_6727ec36:

#   cb "It's a place even I would not want to end up once my life comes to an end."
    cb "É um lugar onde nem eu gostaria de acabar quando minha vida chegar ao fim."

# game/chapters/chapter4/script/ch4sc17.rpy:1683
translate brazil ch4sc17_05bd9d0e:

#   cb "Ahh, at last, the 5th and final layer of the hells... Pandemonium."
    cb "Ah, finalmente, a 5ª e última camada dos infernos... Pandemônio."

# game/chapters/chapter4/script/ch4sc17.rpy:1684
translate brazil ch4sc17_b9df4d8a:

#   cb "Pandemonium was the original hell upon creation of Midomir."
    cb "Pandemônio era o inferno original quando Midomir foi criado."

# game/chapters/chapter4/script/ch4sc17.rpy:1685
translate brazil ch4sc17_56a66c63:

#   cb "However as the Chaos seethed out from the Abyss, Pandemonium was not enough to keep the forces of the Abyss at bay."
    cb "Contudo, à medida que o Caos emanava do Abismo, o Pandemônio não foi suficiente para conter as forças do Abismo."

# game/chapters/chapter4/script/ch4sc17.rpy:1686
translate brazil ch4sc17_ae622e21:

#   cb "Which led to the most savage war Midomir has ever endured, known as {b}'The Abyss Wars'{/b}."
    cb "O que levou à guerra mais brutal que Midomir já enfrentou, conhecida como {b}'As Guerras do Abismo'{/b}."

# game/chapters/chapter4/script/ch4sc17.rpy:1687
translate brazil ch4sc17_7eba0a8d:

#   cb "Lasting for roughly 5.200 years, during this time... Each layer of the hells was gradually created."
    cb "Durando aproximadamente 5.200 anos, durante esse tempo... Cada camada dos infernos foi gradualmente criada."

# game/chapters/chapter4/script/ch4sc17.rpy:1688
translate brazil ch4sc17_f27284b8:

#   cb "And finally the forces of the Abyss was pushed back to their realm deep within the core of the planet."
    cb "E finalmente as forças do Abismo foram repelidas de volta ao seu reino nas profundezas do núcleo do planeta."

# game/chapters/chapter4/script/ch4sc17.rpy:1689
translate brazil ch4sc17_b2d9b135:

#   cb "Now each layer of the five hells serve as a barrier and safeguard against the Abyss."
    cb "Agora, cada camada dos cinco infernos serve como uma barreira e proteção contra o Abismo."

# game/chapters/chapter4/script/ch4sc17.rpy:1690
translate brazil ch4sc17_289030b2:

#   cb "Should it's forces ever manage to break through the seals placed upon it."
    cb "Caso suas forças consigam romper os selos que a cercam."

# game/chapters/chapter4/script/ch4sc17.rpy:1693
translate brazil ch4sc17_fbe2738f:

#   cb "Pandemonium is a mysterious land, plunged in eternal night."
    cb "Pandemônio é uma terra misteriosa, mergulhada em noite eterna."

# game/chapters/chapter4/script/ch4sc17.rpy:1694
translate brazil ch4sc17_2af64af3:

#   cb "It has many different terrains and weird structural architecture throughout it's vast realm."
    cb "Possui diversos tipos de terreno e uma arquitetura estrutural peculiar por toda a sua vasta extensão."

# game/chapters/chapter4/script/ch4sc17.rpy:1695
translate brazil ch4sc17_1c954be4:

#   cb "The Main feature of Pandemonium would definitely be the Pandemonium fortress."
    cb "A principal característica de Pandemonium seria, sem dúvida, a fortaleza de Pandemonium."

# game/chapters/chapter4/script/ch4sc17.rpy:1696
translate brazil ch4sc17_be96773a:

#   cb "Only accessible through gateways within Pandemonium itself, it is the largest structure in creation."
    cb "Acessível apenas por meio de portais dentro do próprio Pandemônio, é a maior estrutura da criação."

# game/chapters/chapter4/script/ch4sc17.rpy:1697
translate brazil ch4sc17_5285a017:

#   cb "It's so large that one has to use gateways and portals to traverse it, the fortress itself is bigger than entire cities."
    cb "É tão grande que é preciso usar portões e portais para atravessá-la; a própria fortaleza é maior do que cidades inteiras."

# game/chapters/chapter4/script/ch4sc17.rpy:1700
translate brazil ch4sc17_45f53b8b:

#   cb "And who rules Pandemonium? None other than the Archdevil Panzael."
    cb "E quem governa Pandemônio? Ninguém menos que o Arquidemônio Panzael."

# game/chapters/chapter4/script/ch4sc17.rpy:1701
translate brazil ch4sc17_5fccb55f:

#   cb "Unlike the other four Archdevils, who rose to their power in one way or another."
    cb "Diferentemente dos outros quatro Arquidemônios, que ascenderam ao poder de uma forma ou de outra."

# game/chapters/chapter4/script/ch4sc17.rpy:1702
translate brazil ch4sc17_e6d7e542:

#   cb "Panzael was birthed at the creation of the hells itself, he's as ancient as Midomir and the hells themselves."
    cb "Panzael nasceu na própria criação dos infernos; ele é tão antigo quanto Midomir e os próprios infernos."

# game/chapters/chapter4/script/ch4sc17.rpy:1703
translate brazil ch4sc17_452cea94:

#   cb "His vast power and the fact he was birthed at the dawn of the planet has often led to him being called 'The False Divine'."
    cb "Seu vasto poder e o fato de ter nascido na aurora do planeta muitas vezes o levaram a ser chamado de 'O Falso Divino'."

# game/chapters/chapter4/script/ch4sc17.rpy:1706
translate brazil ch4sc17_bf506131:

#   cb "Being the Archdevil of Pandemonium also means he's the strongest Archdevil, by quite a large margin as well."
    cb "Ser o Arquidemônio do Pandemônio também significa que ele é o Arquidemônio mais forte, por uma grande margem."

# game/chapters/chapter4/script/ch4sc17.rpy:1707
translate brazil ch4sc17_ab02bfe7:

#   cb "He is the one true king of the hells, and the other Archdevils submit to his will."
    cb "Ele é o único e verdadeiro rei dos infernos, e os outros arquidemônios se submetem à sua vontade."

# game/chapters/chapter4/script/ch4sc17.rpy:1708
translate brazil ch4sc17_f6f56794:

#   cb "Although the layers and their inhabitants rarely interact with each other."
    cb "Embora as camadas e seus habitantes raramente interajam entre si."

# game/chapters/chapter4/script/ch4sc17.rpy:1709
translate brazil ch4sc17_c7b4d3cd:

#   cb "Panzael, much to the luck of the residents of Midomir, has little ambition."
    cb "Panzael, para grande sorte dos habitantes de Midomir, tem pouca ambição."

# game/chapters/chapter4/script/ch4sc17.rpy:1710
translate brazil ch4sc17_b03927c2:

#   cb "Having been around since the planet's creation, he much prefers to be left alone to his own solitude."
    cb "Tendo existido desde a criação do planeta, ele prefere muito mais ficar sozinho em sua própria solidão."

# game/chapters/chapter4/script/ch4sc17.rpy:1711
translate brazil ch4sc17_2e0256ee:

#   cb "Whereas the other Archdevils seems to take a much more active role in acquiring souls and spreading mischief..."
    cb "Enquanto os outros Arquidemônios parecem desempenhar um papel muito mais ativo na aquisição de almas e na disseminação de travessuras..."

# game/chapters/chapter4/script/ch4sc17.rpy:1712
translate brazil ch4sc17_a47a1d5f:

#   cb "Panzael views such acts as beneath him, the only thing that seems to draw his attention, is when he feels the Abyss stirring."
    cb "Panzael considera tais atos indignos de sua posição; a única coisa que parece chamar sua atenção é quando sente o Abismo se agitando."

# game/chapters/chapter4/script/ch4sc17.rpy:1717
translate brazil ch4sc17_c68b2f52:

#   cb "And at the very bottom of the fifth layer, lies the entrance to the Abyss. {b}‘His’{/b} realm."
    cb "E bem no fundo da quinta camada, encontra-se a entrada para o Abismo. {b}'Dele'{/b} reino."

# game/chapters/chapter4/script/ch4sc17.rpy:1718
translate brazil ch4sc17_89b2ff0f:

#   mc "*Grunts* Who?"
    mc "*Resmunga* Quem?"

# game/chapters/chapter4/script/ch4sc17.rpy:1720
translate brazil ch4sc17_b71dd0f4:

#   cb "{b}Balthazar.{/b} Possibly the most infamous and terrifying being to ever live."
    cb "{b}Baltazar.{/b} Possivelmente o ser mais infame e aterrorizante que já existiu."

# game/chapters/chapter4/script/ch4sc17.rpy:1721
translate brazil ch4sc17_476dd4a3:

#   cb "You don’t even know of him? You really are a whelp."
    cb "Você nem sequer o conhece? Você é mesmo um pirralho."

# game/chapters/chapter4/script/ch4sc17.rpy:1723
translate brazil ch4sc17_d35c9062:

#   mc "I know who he is. He's been dead for over 500 years, though. Not exactly recent history."
    mc "Eu sei quem ele é. Mas ele está morto há mais de 500 anos. Não é exatamente história recente."

# game/chapters/chapter4/script/ch4sc17.rpy:1724
translate brazil ch4sc17_c83c1764:

#   cb "Dead? No, boy... Balthazar isn’t dead. He's been sealed away in the Abyss for 500 years."
    cb "Morto? Não, rapaz... Balthazar não está morto. Ele foi selado no Abismo por 500 anos."

# game/chapters/chapter4/script/ch4sc17.rpy:1725
translate brazil ch4sc17_c2c0edf5:

#   cb "He’s biding his time... His return to Midomir is inevitable."
    cb "Ele está aguardando o momento certo... Seu retorno a Midomir é inevitável."

# game/chapters/chapter4/script/ch4sc17.rpy:1727
translate brazil ch4sc17_40365b43:

#   cb "This ring? It belonged to one of the mages who banished him, a mage named Szhar."
    cb "Este anel? Pertencia a um dos magos que o baniram, um mago chamado Szhar."

# game/chapters/chapter4/script/ch4sc17.rpy:1728
translate brazil ch4sc17_a197693c:

#   mc "If that’s the case, then you’re the ‘boy’ around here."
    mc "Se for esse o caso, então você é o 'menino' por aqui."

# game/chapters/chapter4/script/ch4sc17.rpy:1730
translate brazil ch4sc17_a9787bce:

#   mc "You do realize all of the mages who sealed him away, died... because of their rings."
    mc "Você sabe que todos os magos que o aprisionaram morreram... por causa de seus anéis."

# game/chapters/chapter4/script/ch4sc17.rpy:1731
translate brazil ch4sc17_5e81e078:

#   mc "The amount of power needed to seal Balthazar, it required them to sacrifice their life force into their rings."
    mc "A quantidade de poder necessária para selar Balthazar exigiu que eles sacrificassem sua força vital em seus anéis."

# game/chapters/chapter4/script/ch4sc17.rpy:1732
translate brazil ch4sc17_7d586773:

#   mc "The ring is corrupting your mind... lusting for power... paranoid about even your own kin."
    mc "O anel está corrompendo sua mente... sede de poder... paranoia até mesmo em relação aos seus próprios parentes."

# game/chapters/chapter4/script/ch4sc17.rpy:1734
translate brazil ch4sc17_cbed03e9:

#   cb "Tsk! You haven’t got a clue, boy! This ring is everything!"
    cb "Tsc! Você não tem a mínima ideia, garoto! Este anel é tudo!"

# game/chapters/chapter4/script/ch4sc17.rpy:1735
translate brazil ch4sc17_953b43c5:

#   cb "With it I, Blackheart the relentless, king of Looter’s Bay, scourge of the sea-"
    cb "Com ele eu, Coração Negro, o implacável, rei da Baía dos Saqueadores, flagelo do mar-"

# game/chapters/chapter4/script/ch4sc17.rpy:1737
translate brazil ch4sc17_e466ef02:

#   cb "I will rule. {b}I WILL DOMINATE!!{/b}"
    cb "Eu governarei. {b} EU VOU DOMINAR!!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1739
translate brazil ch4sc17_4af106c3:

#   cb "Now, I think it’s time I return to my daughters. It'd seem they need a lesson in obedience."
    cb "Agora, acho que é hora de eu voltar para minhas filhas. Parece que elas precisam de uma lição de obediência."

# game/chapters/chapter4/script/ch4sc17.rpy:1740
translate brazil ch4sc17_6709edf7:

#   cb "I do hope you enjoy your stay here. Don’t view it as being trapped... call it a vacation."
    cb "Espero que você aproveite sua estadia aqui. Não a encare como uma prisão... considere-a como férias."

# game/chapters/chapter4/script/ch4sc17.rpy:1742
translate brazil ch4sc17_3fd59ebe:

#   cb "A permanent vacation."
    cb "Férias permanentes."

# game/chapters/chapter4/script/ch4sc17.rpy:1748
translate brazil ch4sc17_d0728421:

#   mc "Me? Trapped? You’re a little ignorant, aren’t you?"
    mc "Eu? Preso? Você é um pouco ingênuo, não é?"

# game/chapters/chapter4/script/ch4sc17.rpy:1749
translate brazil ch4sc17_cc4026e7:

#   mc "I’m exactly where I want to be."
    mc "Estou exatamente onde quero estar."

# game/chapters/chapter4/script/ch4sc17.rpy:1751
translate brazil ch4sc17_77c02f58:

#   cb "Have you lost your mind, boy? What are you talking about?"
    cb "Você perdeu a cabeça, rapaz? Do que você está falando?"

# game/chapters/chapter4/script/ch4sc17.rpy:1753
translate brazil ch4sc17_74e25403:

#   mc "I simply wanted to see what all the fuss was about, regarding your ring."
    mc "Eu só queria ver qual era a razão de tanto alvoroço em relação ao seu anel."

# game/chapters/chapter4/script/ch4sc17.rpy:1754
translate brazil ch4sc17_0b8f7fc2:

#   mc "I do appreciate the history lesson, though."
    mc "Agradeço, no entanto, a aula de história."

# game/chapters/chapter4/script/ch4sc17.rpy:1755
translate brazil ch4sc17_ad03f665:

#   mc "Oh and that ring of yours? I’ll be taking that."
    mc "Ah, e esse seu anel? Vou levá-lo comigo."

# game/chapters/chapter4/script/ch4sc17.rpy:1758
translate brazil ch4sc17_2d80bf78:

#   cb "{b}YOU DARE DEFY ME BOY?! I AM A KING!!{/b}"
    cb "{b}Você se atreve a me desafiar, garoto?! Eu sou um rei!!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1760
translate brazil ch4sc17_a7b76358:

#   mc "Any man who has to remind people of his being the king, is no king at all."
    mc "Qualquer homem que precise lembrar às pessoas que é rei, não é rei nenhum."

# game/chapters/chapter4/script/ch4sc17.rpy:1762
translate brazil ch4sc17_7c62b123:

#   mc "You'll regret using Pearl against me. Threatening Kira. Stealing Eliza's hope."
    mc "Você vai se arrepender de usar a Pérola contra mim. De ameaçar a Kira. De roubar a esperança da Eliza."

# game/chapters/chapter4/script/ch4sc17.rpy:1764
translate brazil ch4sc17_724c8d62:

#   cb "Oh, I’m going to enjoy killing you!"
    cb "Ah, vou adorar te matar!"

# game/chapters/chapter4/script/ch4sc17.rpy:1767
translate brazil ch4sc17_37948b23:

#   cb "{b}DIE!!{/b}"
    cb "{b}O!!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1770
translate brazil ch4sc17_926b1ef1:

#   cb "*Groans* Argggh!!"
    cb "*Geme* Argh!!"

# game/chapters/chapter4/script/ch4sc17.rpy:1772
translate brazil ch4sc17_e37b3ad7:

#   mc "This might hurt a little..."
    mc "Isso pode doer um pouco..."

# game/chapters/chapter4/script/ch4sc17.rpy:1777
translate brazil ch4sc17_03e33391:

#   cb "*Grunts* That’s the best you’ve got?"
    cb "*Resmunga* É só isso que você tem?"

# game/chapters/chapter4/script/ch4sc17.rpy:1778
translate brazil ch4sc17_2daf8828:

#   mct "That combo should’ve torn him to shreds..."
    mct "Essa combinação deveria tê-lo despedaçado..."

# game/chapters/chapter4/script/ch4sc17.rpy:1779
translate brazil ch4sc17_0c2445cb:

#   mct "The ring... it could be enhancing his physical prowess. Making his body more durable..."
    mct "O anel... pode estar aprimorando sua força física. Tornando seu corpo mais resistente..."

# game/chapters/chapter4/script/ch4sc17.rpy:1781
translate brazil ch4sc17_fac3797d:

#   cb "I'll show you real power!"
    cb "Vou te mostrar o verdadeiro poder!"

# game/chapters/chapter4/script/ch4sc17.rpy:1782
translate brazil ch4sc17_ffdf68a2:

#   cb "*Whispers* Sszhar... Sazh, Hraazh, Slethzzh!"
    cb "*Sussurros* Sszhar... Sazh, Hraazh, Slethzzh!"

# game/chapters/chapter4/script/ch4sc17.rpy:1785
translate brazil ch4sc17_0d5a31d4:

#   mct "He enchanted his blade? I can feel the seething magic from here."
    mct "Ele enfeitiçou a lâmina? Consigo sentir a magia fervilhando daqui."

# game/chapters/chapter4/script/ch4sc17.rpy:1786
translate brazil ch4sc17_babafc1f:

#   mct "Better avoid getting hit by that..."
    mct "É melhor evitar ser atingido por isso..."

# game/chapters/chapter4/script/ch4sc17.rpy:1789
translate brazil ch4sc17_64919ea8:

#   cb "You ready to meet your end boy?{b} HERE I COME!{/b}"
    cb "Você está pronto para encontrar seu fim, garoto?{b} Aí vou eu!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1790
translate brazil ch4sc17_ea045ffc:

#   mct "*Sigh* I can’t hold back, that ring is serious."
    mct "*Suspiro* Não consigo me conter, esse anel é sério."

# game/chapters/chapter4/script/ch4sc17.rpy:1791
translate brazil ch4sc17_cac29a86:

#   mct "Creating this place in Decimore... increasing his strength... now empowering his blade?"
    mct "Criar este lugar em Decimore... aumentar sua força... e agora fortalecer sua lâmina?"

# game/chapters/chapter4/script/ch4sc17.rpy:1793
translate brazil ch4sc17_3c52614e:

#   mct "I’ll fight him like Rin taught me to."
    mct "Vou lutar contra ele como Rin me ensinou."

# game/chapters/chapter4/script/ch4sc17.rpy:1794
translate brazil ch4sc17_33b35b63:

#   cb "Hah! You’ve finally accepted your fate, boy?!"
    cb "Hah! Finalmente aceitou seu destino, rapaz?!"

# game/chapters/chapter4/script/ch4sc17.rpy:1795
translate brazil ch4sc17_0fffdf5f:

#   mct "Feel his movements in the wind... every step he takes sends ripples forth..."
    mct "Sinta seus movimentos ao vento... cada passo que ele dá envia ondas..."

# game/chapters/chapter4/script/ch4sc17.rpy:1797
translate brazil ch4sc17_241ee7db:

#   mct "If this doesn’t work, it'll leave me open for him to strike me down. No pressure."
    mct "Se isso não funcionar, ficarei vulnerável a ele me atacar. Sem pressão."

# game/chapters/chapter4/script/ch4sc17.rpy:1799
translate brazil ch4sc17_baaebb1a:

#   cb "You’re dead! {b}YOU HEAR ME?! DEAD!!{/b}"
    cb "Você está morto! {b} ENTENDEU?! MORTO!!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1800
translate brazil ch4sc17_232207f0:

#   mct "Now!"
    mct "Agora!"

# game/chapters/chapter4/script/ch4sc17.rpy:1803
translate brazil ch4sc17_9184fb51:

#   cb "{b}WHAT?!{/b}"
    cb "{b}O QUE?!{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1804
translate brazil ch4sc17_95f28d96:

#   "As Blackheart strikes, you dissipate in the whirlwind you conjured."
    "Ao ser atingido pelo golpe de Blackheart, você se dissipa no turbilhão que conjurou."

# game/chapters/chapter4/script/ch4sc17.rpy:1807
translate brazil ch4sc17_8b6d275e:

#   cb "{b}HUH?! HOW DID YOU-{/b}"
    cb "{b}Hã?! Como você...?{/b}"

# game/chapters/chapter4/script/ch4sc17.rpy:1810
translate brazil ch4sc17_46f5dcec:

#   mc "Time for a nap... king of pirates."
    mc "Hora da soneca... rei dos piratas."

# game/chapters/chapter4/script/ch4sc17.rpy:1811
translate brazil ch4sc17_4d0ff036:

#   cb "*Struggling* Hrrahh! Hnnhhrrr!"
    cb "*Lutando* Hrrahh! Hnnhhrrr!"

# game/chapters/chapter4/script/ch4sc17.rpy:1813
translate brazil ch4sc17_e4a94a02:

#   "You continue squeezing, until he passes out."
    "Você continua apertando até ele desmaiar."

# game/chapters/chapter4/script/ch4sc17.rpy:1815
translate brazil ch4sc17_bf26e625:

#   "Blackheart falls unconscious."
    "Blackheart desmaia."

# game/chapters/chapter4/script/ch4sc17.rpy:1817
translate brazil ch4sc17_2731c125:

#   mc "This really could’ve been avoided if you hadn't forced Pearl to betray me. I did warn you when we first met."
    mc "Isso realmente poderia ter sido evitado se você não tivesse forçado Pearl a me trair. Eu te avisei quando nos conhecemos."

# game/chapters/chapter4/script/ch4sc17.rpy:1819
translate brazil ch4sc17_d070fa8d:

#   mc "You won’t be needing this anymore."
    mc "Você não precisará mais disso."

# game/chapters/chapter4/script/ch4sc17.rpy:1821
translate brazil ch4sc17_1b4e49e1:

#   mct "All this fuss over such a little thing..."
    mct "Todo esse alvoroço por uma coisa tão pequena..."

# game/chapters/chapter4/script/ch4sc17.rpy:1822
translate brazil ch4sc17_08f80071:

#   mct "I'd better bring it back to the guild. Maybe Sylph or Dalen will have some ideas about what to do with it."
    mct "É melhor eu levar isso de volta para a guilda. Talvez Sylph ou Dalen tenham alguma ideia do que fazer com isso."

# game/chapters/chapter4/script/ch4sc17.rpy:1824
translate brazil ch4sc17_95b7d27e:

#   mct "Let’s see how this thing works..."
    mct "Vamos ver como isso funciona..."

# game/chapters/chapter4/script/ch4sc17.rpy:1825
translate brazil ch4sc17_36612164:

#   mct "Maybe if I focus my thoughts on returning to my last location..."
    mct "Talvez se eu concentrar meus pensamentos em retornar ao meu último local..."

# game/chapters/chapter4/script/ch4sc17.rpy:1831
translate brazil ch4sc17_4d1868d2:

#   mct "Something's happening..."
    mct "Algo está acontecendo..."

# game/chapters/chapter4/script/ch4sc17.rpy:1833
translate brazil ch4sc17_5f574a1e:

#   mct "It doesn’t hurt this time?"
    mct "Dessa vez não dói?"

# game/chapters/chapter4/script/ch4sc17.rpy:1843
translate brazil ch4sc17_a0738492:

#   ki "[mc]!"
    ki "[mc]!"

# game/chapters/chapter4/script/ch4sc17.rpy:1847
translate brazil ch4sc17_4119c8d4:

#   pl "You’re back!"
    pl "Você voltou!"

# game/chapters/chapter4/script/ch4sc17.rpy:1848
translate brazil ch4sc17_d338e80d:

#   ki "Are you hurt? What happened?"
    ki "Você está ferido? O que aconteceu?"

# game/chapters/chapter4/script/ch4sc17.rpy:1849
translate brazil ch4sc17_7669e4df:

#   mc "Easy, girls. I’m okay."
    mc "Calma, meninas. Estou bem."

# game/chapters/chapter4/script/ch4sc17.rpy:1851
translate brazil ch4sc17_e83f6f81:

#   mct "Damn. They're hugging me pretty tightly... they must've been worried."
    mct "Puxa. Estão me abraçando bem forte... deviam estar preocupados."

# game/chapters/chapter4/script/ch4sc17.rpy:1852
translate brazil ch4sc17_86851638:

#   pl "We took care of all the bad pirates!"
    pl "Cuidamos de todos os piratas malvados!"

# game/chapters/chapter4/script/ch4sc17.rpy:1853
translate brazil ch4sc17_4f893152:

#   ki "Did you... handle father? Is he... dead?"
    ki "Você... lidou com o pai? Ele está... morto?"

# game/chapters/chapter4/script/ch4sc17.rpy:1855
translate brazil ch4sc17_35793c1e:

#   mc "Let’s just say he is serving some time in prison..."
    mc "Digamos apenas que ele está cumprindo pena na prisão..."

# game/chapters/chapter4/script/ch4sc17.rpy:1856
translate brazil ch4sc17_6f8af4cb:

#   mc "We’ll give him some time to think about how he’s treated you two."
    mc "Vamos dar-lhe algum tempo para pensar em como tratou vocês dois."

# game/chapters/chapter4/script/ch4sc17.rpy:1857
translate brazil ch4sc17_86963e14:

#   ki "Good! He deserves a time-out."
    ki "Ótimo! Ele merece um tempo de reflexão."

# game/chapters/chapter4/script/ch4sc17.rpy:1859
translate brazil ch4sc17_5c0c44be:

#   mc "So you two handled everything here?"
    mc "Então vocês dois resolveram tudo por aqui?"

# game/chapters/chapter4/script/ch4sc17.rpy:1860
translate brazil ch4sc17_5ded268e:

#   pl "You bet we did! We’re not infamous pirates for nothing..."
    pl "Pode apostar que sim! Não somos piratas famosos à toa..."

# game/chapters/chapter4/script/ch4sc17.rpy:1861
translate brazil ch4sc17_3eb30ad2:

#   ki "Your eyes... They’re still red?"
    ki "Seus olhos... ainda estão vermelhos?"

# game/chapters/chapter4/script/ch4sc17.rpy:1862
translate brazil ch4sc17_a9f26f2f:

#   mc "Oh... I guess I'm still a little fired up after everything that's happened."
    mc "Ah... Acho que ainda estou um pouco exaltado depois de tudo o que aconteceu."

# game/chapters/chapter4/script/ch4sc17.rpy:1864
translate brazil ch4sc17_1d000cde:

#   pl "*Whispering* {size=-10}{b}Are you thinking what I’m thinking, sis?{/b}{/size}"
    pl "*Sussurrando* {size=-10}{b}Você está pensando o mesmo que eu, mana?{/b}{/size}"

# game/chapters/chapter4/script/ch4sc17.rpy:1866
translate brazil ch4sc17_c39d36b1:

#   ki "*Whispering* {size=-10}{b}It’s like you’re reading my mind...{/b}{/size}"
    ki "*Sussurrando* {size=-10}{b}É como se você estivesse lendo meus pensamentos...{/b}{/size}"

# game/chapters/chapter4/script/ch4sc17.rpy:1867
translate brazil ch4sc17_82efd6fb:

#   mc "What are you two whispering abou-"
    mc "Sobre o que vocês dois estão cochichando?"

# game/chapters/chapter4/script/ch4sc17.rpy:1871
translate brazil ch4sc17_971c16d3:

#   ki "Mhwaah!"
    ki "Mhwaah!"

# game/chapters/chapter4/script/ch4sc17.rpy:1872
translate brazil ch4sc17_c1b81b5c:

#   pl "Mwah! Mwah!"
    pl "Uau! Uau!"

# game/chapters/chapter4/script/ch4sc17.rpy:1874
translate brazil ch4sc17_2d080df1:

#   pl "Would you look at that! His eyes are back to baby-blue!"
    pl "Olha só! Os olhos dele voltaram a ser azuis como os de um bebê!"

# game/chapters/chapter4/script/ch4sc17.rpy:1875
translate brazil ch4sc17_9e0826a7:

#   ki "Mhm-hm. I suppose having two beautiful girls in his arms kissing him will do that."
    ki "Hum-hum. Imagino que ter duas lindas garotas em seus braços o beijando faça isso."

# game/chapters/chapter4/script/ch4sc17.rpy:1876
translate brazil ch4sc17_4e534e29:

#   mc "Heh. How about we get out of here? I’ve had enough of this place."
    mc "Heh. Que tal sairmos daqui? Já chega deste lugar."

# game/chapters/chapter4/script/ch4sc17.rpy:1877
translate brazil ch4sc17_6d8ac74f:

#   ki "Don’t forget to grab the artifact."
    ki "Não se esqueça de pegar o artefato."

# game/chapters/chapter4/script/ch4sc17.rpy:1879
translate brazil ch4sc17_c000d648:

#   mc "Right. Come on girls, let’s get back to the ship"
