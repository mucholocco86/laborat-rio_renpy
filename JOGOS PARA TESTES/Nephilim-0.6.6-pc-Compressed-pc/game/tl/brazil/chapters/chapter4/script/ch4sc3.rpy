# ARQUIVO: game/chapters/chapter4/script/ch4sc3.rpy DIALOGOS: 253


# game/chapters/chapter4/script/ch4sc3.rpy:8
translate brazil ch4sc3_a1dd6577:

#   mct "*Sigh* Who else could know what to do about Eliza’s condition?"
    mct "*Suspiro* Quem mais saberia o que fazer em relação ao estado de saúde da Eliza?"

# game/chapters/chapter4/script/ch4sc3.rpy:9
translate brazil ch4sc3_6cebac06:

#   mct "."
    mct "."

# game/chapters/chapter4/script/ch4sc3.rpy:10
translate brazil ch4sc3_9a7b3be6:

#   mct ".."
    mct "..."

# game/chapters/chapter4/script/ch4sc3.rpy:11
translate brazil ch4sc3_295bbea7:

#   mct "..."
    mct "..."

# game/chapters/chapter4/script/ch4sc3.rpy:13
translate brazil ch4sc3_481bd895:

#   mct "Magic! Of course! Sylph will know what to do."
    mct "Mágica! Claro! Sylph saberá o que fazer."

# game/chapters/chapter4/script/ch4sc3.rpy:15
translate brazil ch4sc3_89824b18:

#   mct "She has to know something that can help Eliza!"
    mct "Ela deve saber algo que possa ajudar Eliza!"

# game/chapters/chapter4/script/ch4sc3.rpy:21
translate brazil ch4sc3_eafa9cbf:

#   sy "There was this big brute of an ogre and and and..."
    sy "Havia um ogro enorme e bruto e e e..."

# game/chapters/chapter4/script/ch4sc3.rpy:23
translate brazil ch4sc3_8b30cd37:

#   sy "The horrible ogre was just about to munch down on the innocent fae!"
    sy "O ogro horrível estava prestes a devorar a fada inocente!"

# game/chapters/chapter4/script/ch4sc3.rpy:25
translate brazil ch4sc3_c3d53bac:

#   sy "But! Get this! A charming and dashing guy shows up, clad all in black!"
    sy "Mas, olha só! Aparece um cara charmoso e elegante, todo de preto!"

# game/chapters/chapter4/script/ch4sc3.rpy:27
translate brazil ch4sc3_91258cab:

#   sy "And so this guy-"
    sy "E então esse cara-"

# game/chapters/chapter4/script/ch4sc3.rpy:29
translate brazil ch4sc3_c0ac8ef0:

#   da "[mc]."
    da "[mc]."

# game/chapters/chapter4/script/ch4sc3.rpy:32
translate brazil ch4sc3_9ad1089d:

#   sy "What?! No, not him-"
    sy "O quê?! Não, não ele!"

# game/chapters/chapter4/script/ch4sc3.rpy:34
translate brazil ch4sc3_8e98b48c:

#   sy "I mean, sure he is totally handsome and his heavenly blue eyes could charm even Princess Amelia!"
    sy "Quer dizer, claro que ele é absolutamente lindo e seus olhos azuis celestiais poderiam encantar até a Princesa Amelia!"

# game/chapters/chapter4/script/ch4sc3.rpy:35
translate brazil ch4sc3_2d0020e6:

#   sy "And sure, he happens to dress in all black ... Buuut!"
    sy "E claro, ele se veste todo de preto... Maaaaas!"

# game/chapters/chapter4/script/ch4sc3.rpy:37
translate brazil ch4sc3_a1db0da9:

#   sy "T-That is just a coincidence! Yes, a coincidence!"
    sy "É apenas uma coincidência! Sim, uma coincidência!"

# game/chapters/chapter4/script/ch4sc3.rpy:39
translate brazil ch4sc3_c15010dc:

#   da "No, Sylph... [mc]’s here."
    da "Não, Sylph... [mc]'s está aqui."

# game/chapters/chapter4/script/ch4sc3.rpy:43
translate brazil ch4sc3_c7db5d1a:

#   da "What’s wrong? You look pretty shaken."
    da "O que houve? Você parece bastante abalado(a)."

# game/chapters/chapter4/script/ch4sc3.rpy:44
translate brazil ch4sc3_7a90aa7e:

#   da "I'm sure you wouldn't be here at this hour if it weren't serious, you can tell us."
    da "Tenho certeza de que você não estaria aqui a esta hora se não fosse algo sério, pode nos dizer."

# game/chapters/chapter4/script/ch4sc3.rpy:47
translate brazil ch4sc3_b96fff69:

#   syt "Something's wrong!"
    syt "Tem algo errado!"

# game/chapters/chapter4/script/ch4sc3.rpy:48
translate brazil ch4sc3_dcf2cc9f:

#   syt "His eyes... they're red!"
    syt "Os olhos dele... estão vermelhos!"

# game/chapters/chapter4/script/ch4sc3.rpy:50
translate brazil ch4sc3_3feff17d:

#   "Sylph rushes up from the counter, placing both of her tiny hands on your cheeks."
    "Sylph surge correndo do balcão, colocando suas duas mãozinhas em suas bochechas."

# game/chapters/chapter4/script/ch4sc3.rpy:51
translate brazil ch4sc3_b70e0d1a:

#   sy "Heey... what's happened? Y-Your eyes... They’ve changed."
    sy "Ei... o que aconteceu? Seus olhos... mudaram."

# game/chapters/chapter4/script/ch4sc3.rpy:52
translate brazil ch4sc3_f9483a91:

#   sy "[mc]. Please, tell me. I'll help!"
    sy "[mc] Por favor, me diga. Eu ajudo!"

# game/chapters/chapter4/script/ch4sc3.rpy:54
translate brazil ch4sc3_c6206e8d:

#   mc "I-I... Eliza, she’s..."
    mc "II... Eliza, ela é..."

# game/chapters/chapter4/script/ch4sc3.rpy:56
translate brazil ch4sc3_cfedefaa:

#   sy "What happened? Is she okay?"
    sy "O que aconteceu? Ela está bem?"

# game/chapters/chapter4/script/ch4sc3.rpy:57
translate brazil ch4sc3_012b3953:

#   sy "Please tell me? I'll do whatever I can."
    sy "Por favor, me diga? Farei tudo o que estiver ao meu alcance."

# game/chapters/chapter4/script/ch4sc3.rpy:59
translate brazil ch4sc3_1d687d50:

#   mc "She’s alive. *Sighs heavily* But-..."
    mc "Ela está viva. *Suspira profundamente* Mas..."

# game/chapters/chapter4/script/ch4sc3.rpy:60
translate brazil ch4sc3_f3dadc9c:

#   mc "Her legs... she's lost all feeling in her legs."
    mc "As pernas dela... ela perdeu toda a sensibilidade nas pernas."

# game/chapters/chapter4/script/ch4sc3.rpy:63
translate brazil ch4sc3_e4177766:

#   mc "It was him!"
    mc "Era ele!"

# game/chapters/chapter4/script/ch4sc3.rpy:64
translate brazil ch4sc3_5bac6007:

#   mc "He... he crippled her!"
    mc "Ele... ele a deixou paralítica!"

# game/chapters/chapter4/script/ch4sc3.rpy:66
translate brazil ch4sc3_a755160d:

#   "Sylph feels your anger surfacing and she instinctively caresses your cheeks, her flowery scent surrounding you."
    "Sylph sente sua raiva vindo à tona e instintivamente acaricia suas bochechas, seu perfume floral envolvendo você."

# game/chapters/chapter4/script/ch4sc3.rpy:68
translate brazil ch4sc3_6e064cb3:

#   da "Woah, woah... take a deep breath."
    da "Calma, calma... respire fundo."

# game/chapters/chapter4/script/ch4sc3.rpy:69
translate brazil ch4sc3_31193cb9:

#   da "Tell us exactly what happened."
    da "Conte-nos exatamente o que aconteceu."

# game/chapters/chapter4/script/ch4sc3.rpy:73
translate brazil ch4sc3_57890287:

#   "You spend the next hour recapping what happened this evening in vivid detail..."
    "Você passa a próxima hora recapitulando em detalhes vívidos o que aconteceu esta noite..."

# game/chapters/chapter4/script/ch4sc3.rpy:74
translate brazil ch4sc3_ea1d296e:

#   "Hoping that either of them might know something that could help."
    "Espero que algum deles saiba algo que possa ajudar."

# game/chapters/chapter4/script/ch4sc3.rpy:76
translate brazil ch4sc3_582cd50f:

#   da "*Sigh* He didn’t intend to kill her, he was toying with you."
    da "*Suspiro* Ele não tinha a intenção de matá-la, ele estava brincando com você."

# game/chapters/chapter4/script/ch4sc3.rpy:77
translate brazil ch4sc3_c480954a:

#   da "Testing you."
    da "Estou te testando."

# game/chapters/chapter4/script/ch4sc3.rpy:79
translate brazil ch4sc3_2d878b29:

#   mc "What do you mean? How would you even know?"
    mc "O que você quer dizer? Como você saberia disso?"

# game/chapters/chapter4/script/ch4sc3.rpy:81
translate brazil ch4sc3_c7bc1c2f:

#   da "At first it was only a suspicion, but targeting you like this?"
    da "No início era apenas uma suspeita, mas te escolher como alvo assim?"

# game/chapters/chapter4/script/ch4sc3.rpy:82
translate brazil ch4sc3_1b1411cb:

#   da "Now I know. I know exactly who’s after you... Taron."
    da "Agora eu sei. Sei exatamente quem está atrás de você... Taron."

# game/chapters/chapter4/script/ch4sc3.rpy:84
translate brazil ch4sc3_087fb359:

#   mc "Taron? This is the first I’ve heard of him."
    mc "Taron? É a primeira vez que ouço falar dele."

# game/chapters/chapter4/script/ch4sc3.rpy:86
translate brazil ch4sc3_50e5d973:

#   da "That's intentional. He usually has lackeys doing his bidding..."
    da "Isso é intencional. Ele geralmente tem capangas fazendo o que ele manda..."

# game/chapters/chapter4/script/ch4sc3.rpy:87
translate brazil ch4sc3_33915c26:

#   da "Trust me, [mc]. He's bad news. And if he'd wanted to kill Eliza, she'd already be dead."
    da "Confie em mim, [mc] Ele é uma má influência. E se ele quisesse matar Eliza, ela já estaria morta."

# game/chapters/chapter4/script/ch4sc3.rpy:89
translate brazil ch4sc3_4d48f4c7:

#   da "He would’ve specifically targeted her lower back to cripple her."
    da "Ele teria mirado especificamente na região lombar dela para incapacitá-la."

# game/chapters/chapter4/script/ch4sc3.rpy:90
translate brazil ch4sc3_2286d41b:

#   da "To hurt you. To let you know that he’s in control."
    da "Para te magoar. Para te mostrar que ele está no controle."

# game/chapters/chapter4/script/ch4sc3.rpy:92
translate brazil ch4sc3_6165012e:

#   mc "Not even the divines themselves could stop me from doing what I intend to do to him."
    mc "Nem mesmo os deuses poderiam me impedir de fazer o que pretendo fazer com ele."

# game/chapters/chapter4/script/ch4sc3.rpy:93
translate brazil ch4sc3_db7c7150:

#   mc "Fuck... And you know him, Dalen?"
    mc "Puta merda... E você o conhece, Dalen?"

# game/chapters/chapter4/script/ch4sc3.rpy:98
translate brazil ch4sc3_34f48c7c:

#   mc "Dalen, I need answers... you know what this man has done."
    mc "Dalen, preciso de respostas... você sabe o que esse homem fez."

# game/chapters/chapter4/script/ch4sc3.rpy:99
translate brazil ch4sc3_962472e7:

#   mc "If you want me to trust you, then you need to be straight with me."
    mc "Se você quer que eu confie em você, precisa ser sincero comigo."

# game/chapters/chapter4/script/ch4sc3.rpy:100
translate brazil ch4sc3_37c0ae2c:

#   mc "How do you know all this, Dalen? What's your connection to this 'Taron'?"
    mc "Como você sabe de tudo isso, Dalen? Qual é a sua ligação com esse tal de 'Taron'?"

# game/chapters/chapter4/script/ch4sc3.rpy:102
translate brazil ch4sc3_2ea0774c:

#   da "*Sigh* He..."
    da "*Suspiro* Ele..."

# game/chapters/chapter4/script/ch4sc3.rpy:103
translate brazil ch4sc3_75678c8f:

#   "Your attempt to convince Dalen to reveal information about Taron was a {b}success!{/b} {size=+3}{b}{color=#ffee54}Leadership{/color}{/b}{/size} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Sua tentativa de convencer Dalen a revelar informações sobre Taron foi uma {b} sucesso!{/b}  {size=+3}{b}{color=#ffee54}Liderança{/color}{/b}{/size} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc3.rpy:104
translate brazil ch4sc3_e71169d3:

#   da "He, Oren, and I... we used to be friends."
    da "Ele, Oren, e eu... costumávamos ser amigos."

# game/chapters/chapter4/script/ch4sc3.rpy:107
translate brazil ch4sc3_b20df5cb:

#   mc "Friends?!"
    mc "Amigos?!"

# game/chapters/chapter4/script/ch4sc3.rpy:109
translate brazil ch4sc3_6c69720a:

#   mc "What the hell, Dalen!"
    mc "Que diabos, Dalen!"

# game/chapters/chapter4/script/ch4sc3.rpy:111
translate brazil ch4sc3_8b38ead0:

#   da "Emphasis on 'used to be.'"
    da "Ênfase em \"costumava ser\"."

# game/chapters/chapter4/script/ch4sc3.rpy:112
translate brazil ch4sc3_7c92ed34:

#   da "The three of us met when we were young."
    da "Nós três nos conhecemos quando éramos jovens."

# game/chapters/chapter4/script/ch4sc3.rpy:114
translate brazil ch4sc3_7b2b3ab0:

#   da "We were all training at the royal academy. Each of us easily surpassed the other students..."
    da "Estávamos todos treinando na academia real. Cada um de nós superava facilmente os outros alunos..."

# game/chapters/chapter4/script/ch4sc3.rpy:115
translate brazil ch4sc3_45bb5e36:

#   da "So our instructors decided to put us in a special unit."
    da "Então, nossos instrutores decidiram nos colocar em uma unidade especial."

# game/chapters/chapter4/script/ch4sc3.rpy:117
translate brazil ch4sc3_0313b537:

#   da "We quickly became known as 'Trinity' among the other cadets."
    da "Rapidamente ficamos conhecidos como 'Trindade' entre os outros cadetes."

# game/chapters/chapter4/script/ch4sc3.rpy:118
translate brazil ch4sc3_2ed7d856:

#   da "An unbeatable trio who took out the king's worst offenders."
    da "Um trio imbatível que eliminou os piores criminosos do rei."

# game/chapters/chapter4/script/ch4sc3.rpy:120
translate brazil ch4sc3_5c124d35:

#   da "But after we graduated we all drifted apart..."
    da "Mas depois que nos formamos, todos nos afastamos..."

# game/chapters/chapter4/script/ch4sc3.rpy:121
translate brazil ch4sc3_73e73dd3:

#   da "Oren married his sweetheart, Ellen and moved to Whitehills."
    da "Oren casou-se com sua amada, Ellen, e mudou-se para Whitehills."

# game/chapters/chapter4/script/ch4sc3.rpy:122
translate brazil ch4sc3_7d52e070:

#   da "I visited him once after Eliza was born. She was only two summers old at the time."
    da "Visitei-o uma vez depois do nascimento de Eliza. Ela tinha apenas dois verões na altura."

# game/chapters/chapter4/script/ch4sc3.rpy:123
translate brazil ch4sc3_923b8636:

#   da "Such a lively girl, though. She was running after Oren wherever he went..."
    da "Que menina animada! Ela corria atrás do Oren para onde quer que ele fosse..."

# game/chapters/chapter4/script/ch4sc3.rpy:125
translate brazil ch4sc3_e7e2bff3:

#   da "As for Taron... He went to work as an elite mercenary directly under the command of the Knight-Commander."
    da "Quanto a Taron... Ele foi trabalhar como mercenário de elite, diretamente sob o comando do Cavaleiro-Comandante."

# game/chapters/chapter4/script/ch4sc3.rpy:126
translate brazil ch4sc3_3aa7361b:

#   da "They usually took on the most dangerous and rewarding missions."
    da "Eles geralmente assumiam as missões mais perigosas e recompensadoras."

# game/chapters/chapter4/script/ch4sc3.rpy:128
translate brazil ch4sc3_a92f999b:

#   da "Taron has mostly kept to himself, although I've seen him several times since we split from the academy."
    da "Taron tem se mantido bastante reservado, embora eu o tenha visto várias vezes desde que nos separamos da academia."

# game/chapters/chapter4/script/ch4sc3.rpy:129
translate brazil ch4sc3_74616a32:

#   da "But each time I've encountered him, he's seemed less and less like the kid I graduated alongside."
    da "Mas a cada vez que o encontro, ele me parece cada vez menos o garoto com quem me formei."

# game/chapters/chapter4/script/ch4sc3.rpy:131
translate brazil ch4sc3_b4b02cbf:

#   da "And I sought adventure. I wanted to see the world outside the capital walls."
    da "E eu buscava aventura. Queria ver o mundo além dos muros da capital."

# game/chapters/chapter4/script/ch4sc3.rpy:132
translate brazil ch4sc3_ac9e5e53:

#   da "I spent several years traveling, until I finally had my fill of murky caves, rugged mountains and old ruins."
    da "Passei vários anos viajando, até que finalmente me fartei de cavernas escuras, montanhas acidentadas e ruínas antigas."

# game/chapters/chapter4/script/ch4sc3.rpy:133
translate brazil ch4sc3_27da2fba:

#   da "Eventually, I decided to return to Luxenford to establish the adventurer’s guild here."
    da "Por fim, decidi retornar a Luxenford para estabelecer aqui a guilda dos aventureiros."

# game/chapters/chapter4/script/ch4sc3.rpy:135
translate brazil ch4sc3_73c160f4:

#   da "As for what caused Taron to become... whatever he's become, I have no idea."
    da "Quanto ao que levou Taron a se tornar... seja lá o que ele se tornou, eu não faço ideia."

# game/chapters/chapter4/script/ch4sc3.rpy:136
translate brazil ch4sc3_88dab9c6:

#   da "He’s become cold and calculating. He ruthlessly manipulates people to his own ends. And he’s cunning."
    da "Ele se tornou frio e calculista. Manipula as pessoas impiedosamente para atingir seus próprios objetivos. E é astuto."

# game/chapters/chapter4/script/ch4sc3.rpy:138
translate brazil ch4sc3_30f9b289:

#   da "I’ve tried to catch him red-handed several times. But to no avail. He uses lackeys to do his bidding."
    da "Já tentei pegá-lo em flagrante várias vezes, mas sem sucesso. Ele usa capangas para fazer o que ele manda."

# game/chapters/chapter4/script/ch4sc3.rpy:140
translate brazil ch4sc3_168800a0:

#   da "He covers his tracks well."
    da "Ele encobre bem os seus rastros."

# game/chapters/chapter4/script/ch4sc3.rpy:142
translate brazil ch4sc3_f5412e11:

#   mc "This time he didn’t use lackeys. He assaulted Eliza himself."
    mc "Dessa vez, ele não usou capangas. Ele mesmo atacou Eliza."

# game/chapters/chapter4/script/ch4sc3.rpy:144
translate brazil ch4sc3_0d6d4119:

#   mc "*Sigh* We need to find a way to help Eliza."
    mc "*Suspiro* Precisamos encontrar uma maneira de ajudar a Eliza."

# game/chapters/chapter4/script/ch4sc3.rpy:148
translate brazil ch4sc3_3311f30d:

#   mc "This is the man who... killed my parents... who has been chasing me and Oren..."
    mc "Este é o homem que... matou meus pais... que vem me perseguindo, a mim e a Oren..."

# game/chapters/chapter4/script/ch4sc3.rpy:149
translate brazil ch4sc3_2b193efb:

#   mc "Please tell me Dalen, I need to know..."
    mc "Por favor, me diga, Dalen, eu preciso saber..."

# game/chapters/chapter4/script/ch4sc3.rpy:154
translate brazil ch4sc3_1a91aef2:

#   "Your attempt to persuade Dalen to give you information about Taron was {b}successful!{/b} {size=+3}{b}{color=#2bff8b}Persuasion{/color}{/b}{/size} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Sua tentativa de persuadir Dalen a lhe dar informações sobre Taron foi {b} bem-sucedido!{/b}  {size=+3}{b}{color=#2bff8b}Persuasão{/color}{/b}{/size} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc3.rpy:198
translate brazil ch4sc3_74ade354:

#   mc "You’ll have to tell me exactly how you know all this, Dalen..."
    mc "Você vai ter que me dizer exatamente como sabe de tudo isso, Dalen..."

# game/chapters/chapter4/script/ch4sc3.rpy:199
translate brazil ch4sc3_9ba3c995:

#   mc "Another time..."
    mc "Outra hora..."

# game/chapters/chapter4/script/ch4sc3.rpy:200
translate brazil ch4sc3_f1c4e8bd:

#   mc "First, we have to cure Eliza."
    mc "Primeiro precisamos curar Eliza."

# game/chapters/chapter4/script/ch4sc3.rpy:203
translate brazil ch4sc3_917ab580:

#   mc "Sylph, is there anything you can do to help Eliza?"
    mc "Sylph, há algo que você possa fazer para ajudar Eliza?"

# game/chapters/chapter4/script/ch4sc3.rpy:204
translate brazil ch4sc3_dbce6f7c:

#   mc "Any spell to make her walk again?"
    mc "Existe algum feitiço para fazê-la andar novamente?"

# game/chapters/chapter4/script/ch4sc3.rpy:206
translate brazil ch4sc3_aea443fb:

#   sy "."
    sy "."

# game/chapters/chapter4/script/ch4sc3.rpy:207
translate brazil ch4sc3_5c2c7bcf:

#   sy "..."
    sy "..."

# game/chapters/chapter4/script/ch4sc3.rpy:208
translate brazil ch4sc3_be831153:

#   "Sylph seems hesitant..."
    "Sylph parece hesitante..."

# game/chapters/chapter4/script/ch4sc3.rpy:210
translate brazil ch4sc3_bfd92d62:

#   sy "I’m sorry, [mc]."
    sy "Desculpe, [mc]."

# game/chapters/chapter4/script/ch4sc3.rpy:211
translate brazil ch4sc3_7af0d162:

#   sy "I’m not capable of performing any magic like that."
    sy "Não sou capaz de realizar nenhum tipo de mágica."

# game/chapters/chapter4/script/ch4sc3.rpy:214
translate brazil ch4sc3_f6fcdf78:

#   syt "I cannot provide what he asks... it's dark magic..."
    syt "Não posso fornecer o que ele pede... é magia negra..."

# game/chapters/chapter4/script/ch4sc3.rpy:215
translate brazil ch4sc3_a80fe67a:

#   syt "Last time a fae performed dark magic... I-... I lost everything."
    syt "Da última vez que uma fada praticou magia negra... eu... eu perdi tudo."

# game/chapters/chapter4/script/ch4sc3.rpy:216
translate brazil ch4sc3_d8ac7aae:

#   syt "We need another solution... one that does not mean certain doom for everyone."
    syt "Precisamos de outra solução... uma que não signifique a ruína certa para todos."

# game/chapters/chapter4/script/ch4sc3.rpy:218
translate brazil ch4sc3_cc5197b3:

#   mc "We have to do something!"
    mc "Temos que fazer alguma coisa!"

# game/chapters/chapter4/script/ch4sc3.rpy:219
translate brazil ch4sc3_159186d4:

#   mc "I-I can’t leave her like this."
    mc "Não posso deixá-la assim."

# game/chapters/chapter4/script/ch4sc3.rpy:221
translate brazil ch4sc3_1a0ad138:

#   mc "This happened because this psycho wanted to get to me, she doesn’t deserve this!"
    mc "Isso aconteceu porque essa psicopata queria me atingir, ela não merece isso!"

# game/chapters/chapter4/script/ch4sc3.rpy:223
translate brazil ch4sc3_a2bd3f63:

#   da "Calm yourself, [mc]."
    da "Acalme-se, [mc]."

# game/chapters/chapter4/script/ch4sc3.rpy:224
translate brazil ch4sc3_8a983824:

#   da "I might know of a way to cure her."
    da "Talvez eu saiba de uma maneira de curá-la."

# game/chapters/chapter4/script/ch4sc3.rpy:226
translate brazil ch4sc3_a39420a8:

#   da "But... It'll be a large undertaking to even attempt it, let alone succeed."
    da "Mas... será uma tarefa gigantesca até mesmo tentar, quanto mais ter sucesso."

# game/chapters/chapter4/script/ch4sc3.rpy:228
translate brazil ch4sc3_ebcd76b2:

#   mc "Failure is not an option, Dalen."
    mc "Falhar não é uma opção, Dalen."

# game/chapters/chapter4/script/ch4sc3.rpy:229
translate brazil ch4sc3_df925a7b:

#   mc "I’ll do whatever it takes to cure her."
    mc "Farei o que for preciso para curá-la."

# game/chapters/chapter4/script/ch4sc3.rpy:231
translate brazil ch4sc3_71cb213f:

#   da "*Sigh* I know you will."
    da "*Suspiro* Eu sei que você vai."

# game/chapters/chapter4/script/ch4sc3.rpy:233
translate brazil ch4sc3_b7857148:

#   da "So, let me get straight to it."
    da "Então, vamos direto ao ponto."

# game/chapters/chapter4/script/ch4sc3.rpy:234
translate brazil ch4sc3_07d1375b:

#   da "I once heard about an artifact said to be blessed by Lucid, one of the seven divines."
    da "Certa vez ouvi falar de um artefato que diziam ter sido abençoado por Lucid, uma das sete divindades."

# game/chapters/chapter4/script/ch4sc3.rpy:236
translate brazil ch4sc3_5b5b70c4:

#   da "It is supposed to have healing powers strong enough to even bring the dead back to life..."
    da "Dizem que possui poderes de cura tão fortes que podem até mesmo trazer os mortos de volta à vida..."

# game/chapters/chapter4/script/ch4sc3.rpy:238
translate brazil ch4sc3_7cdfe316:

#   mc "T-The dead?"
    mc "Os mortos?"

# game/chapters/chapter4/script/ch4sc3.rpy:240
translate brazil ch4sc3_2e0d532b:

#   sy "Whau!! You’ve never told me about this!"
    sy "Uau!! Você nunca me contou isso!"

# game/chapters/chapter4/script/ch4sc3.rpy:242
translate brazil ch4sc3_70adee2f:

#   da "For good reason. It’s only been a tale passed down from the higher ups at the academy... a legend."
    da "Com razão. É apenas uma história transmitida pelos figurões da academia... uma lenda."

# game/chapters/chapter4/script/ch4sc3.rpy:243
translate brazil ch4sc3_8a2b1c2a:

#   da "Nobody has actually seen it... nobody alive, at least."
    da "Ninguém viu isso de fato... pelo menos ninguém vivo."

# game/chapters/chapter4/script/ch4sc3.rpy:245
translate brazil ch4sc3_a44a6b05:

#   da "So, there’s no way to know for sure if it even exists."
    da "Portanto, não há como saber com certeza se isso sequer existe."

# game/chapters/chapter4/script/ch4sc3.rpy:252
translate brazil ch4sc3_e59ccdcd:

#   mct "Mama ... Papa ... I-"
    mct "Mãe... Pai... Eu-"

# game/chapters/chapter4/script/ch4sc3.rpy:253
translate brazil ch4sc3_19fc2e9f:

#   mct "I could see you again."
    mct "Eu poderia te ver de novo."

# game/chapters/chapter4/script/ch4sc3.rpy:254
translate brazil ch4sc3_195c69ee:

#   mct "There’s so much I want to tell you... All the crazy shit I’ve been through since that night."
    mct "Tem tanta coisa que eu quero te contar... Todas as loucuras pelas quais passei desde aquela noite."

# game/chapters/chapter4/script/ch4sc3.rpy:255
translate brazil ch4sc3_e89b77ea:

#   mct "All the weird creatures I’ve encountered... all the different people, with their quirks and all."
    mct "Todas as criaturas estranhas que encontrei... todas as pessoas diferentes, com suas peculiaridades e tudo mais."

# game/chapters/chapter4/script/ch4sc3.rpy:256
translate brazil ch4sc3_5584a6ae:

#   mct "Speaking of people, I met this girl... stubborn as a mule."
    mct "Por falar em pessoas, conheci uma garota... teimosa como uma mula."

# game/chapters/chapter4/script/ch4sc3.rpy:257
translate brazil ch4sc3_5976fdad:

#   mct "As beautiful as a fairy tale princess."
    mct "Tão bela quanto uma princesa de conto de fadas."

# game/chapters/chapter4/script/ch4sc3.rpy:258
translate brazil ch4sc3_a1a6b6ca:

#   mct "We’ve been through so much together in such a short amount of time. I can’t help but feel drawn to her."
    mct "Já passamos por tanta coisa juntos em tão pouco tempo. Não consigo evitar me sentir atraído por ela."

# game/chapters/chapter4/script/ch4sc3.rpy:259
translate brazil ch4sc3_600cd0bb:

#   mct "She was thrown into this with me that night. Without either of us knowing it at the time..."
    mct "Ela foi jogada nisso comigo naquela noite. Sem que nenhum de nós soubesse disso na hora..."

# game/chapters/chapter4/script/ch4sc3.rpy:260
translate brazil ch4sc3_cfd6f544:

#   mct "I want to make sure she has a good life... a happy life."
    mct "Quero garantir que ela tenha uma boa vida... uma vida feliz."

# game/chapters/chapter4/script/ch4sc3.rpy:262
translate brazil ch4sc3_6c19fb74:

#   mct "Her name is Eliza. She’s..."
    mct "O nome dela é Eliza. Ela é..."

# game/chapters/chapter4/script/ch4sc3.rpy:267
translate brazil ch4sc3_339e0f74:

#   mct "I’ve grown fond of her. It’s been... interesting having a friend again."
    mct "Eu acabei gostando dela. Tem sido... interessante ter uma amiga novamente."

# game/chapters/chapter4/script/ch4sc3.rpy:268
translate brazil ch4sc3_31fee902:

#   mct "I can rely on her. But I let her down when she needed me the most."
    mct "Posso confiar nela. Mas a decepcionei quando ela mais precisava de mim."

# game/chapters/chapter4/script/ch4sc3.rpy:269
translate brazil ch4sc3_7eed6556:

#   mct "Now she’s hurt and I have to fix it. I have to."
    mct "Agora ela está magoada e eu tenho que consertar isso. Eu tenho que fazer isso."

# game/chapters/chapter4/script/ch4sc3.rpy:272
translate brazil ch4sc3_40826263:

#   mct "I’ve never cared about anyone like I do for her. And she just got injured badly..."
    mct "Nunca me importei com ninguém como me importo com ela. E ela acabou de se machucar gravemente..."

# game/chapters/chapter4/script/ch4sc3.rpy:273
translate brazil ch4sc3_d957eb7c:

#   mct "But I’m going to fix it. And when I do... I’m going to take her on a date just like she's been talking about."
    mct "Mas eu vou resolver isso. E quando eu resolver... vou levá-la para um encontro, exatamente como ela vem falando."

# game/chapters/chapter4/script/ch4sc3.rpy:277
translate brazil ch4sc3_6a3ca502:

#   da "I know what you’re thinking, [mc]. Don’t go down that rabbit hole. The artifact is rumored to be a chalice."
    da "Eu sei o que você está pensando, [mc] Não se aprofunde nesse assunto. Há rumores de que o artefato seja um cálice."

# game/chapters/chapter4/script/ch4sc3.rpy:278
translate brazil ch4sc3_bd95ad00:

#   da "The deceased would have to drink from it in order to be brought back to life."
    da "O falecido teria que beber daquele líquido para voltar à vida."

# game/chapters/chapter4/script/ch4sc3.rpy:280
translate brazil ch4sc3_8a33aef7:

#   da "And I assume you don’t exactly have the bodies of your parents readily available?"
    da "E presumo que você não tenha exatamente os corpos de seus pais à disposição?"

# game/chapters/chapter4/script/ch4sc3.rpy:282
translate brazil ch4sc3_e8a5402a:

#   mc "No... but..."
    mc "Não... mas..."

# game/chapters/chapter4/script/ch4sc3.rpy:284
translate brazil ch4sc3_526da054:

#   da "We also don’t know the extent of the power the artifact holds."
    da "Também não sabemos a extensão do poder que o artefato detém."

# game/chapters/chapter4/script/ch4sc3.rpy:286
translate brazil ch4sc3_706c7c59:

#   da "Does it even exist? If it does, is it single use? Would it work on the dead, or only the living?"
    da "Isso sequer existe? Se existe, é de uso único? Funcionaria em mortos ou apenas em vivos?"

# game/chapters/chapter4/script/ch4sc3.rpy:288
translate brazil ch4sc3_5d438415:

#   sy "All valid questions... But I do believe it exists! All legends spring from somewhere, right?"
    sy "Todas são perguntas válidas... Mas eu acredito que exista! Todas as lendas têm uma origem, não é?"

# game/chapters/chapter4/script/ch4sc3.rpy:290
translate brazil ch4sc3_11c10a8c:

#   mc "If this chalice is real, and it can cure Eliza, I have to find it. I need to."
    mc "Se esse cálice for real e puder curar Eliza, eu preciso encontrá-lo. Preciso mesmo."

# game/chapters/chapter4/script/ch4sc3.rpy:292
translate brazil ch4sc3_a68adb5e:

#   mc "Does either of you know its location?"
    mc "Algum de vocês sabe onde fica?"

# game/chapters/chapter4/script/ch4sc3.rpy:294
translate brazil ch4sc3_ebca1960:

#   da "I don’t know for certain, but it was rumored to have been lost on an island called... Isla de Inmortui."
    da "Não sei ao certo, mas havia um rumor de que teria se perdido em uma ilha chamada... Isla de Inmortui."

# game/chapters/chapter4/script/ch4sc3.rpy:295
translate brazil ch4sc3_beb16890:

#   da "The Island of Undead, to be specific."
    da "Mais especificamente, a Ilha dos Mortos-Vivos."

# game/chapters/chapter4/script/ch4sc3.rpy:298
translate brazil ch4sc3_a874f1f8:

#   sy "Un-d-d-dead?! That doesn’t sound very welcoming..."
    sy "Não-mortos?! Isso não soa muito acolhedor..."

# game/chapters/chapter4/script/ch4sc3.rpy:299
translate brazil ch4sc3_38bc7428:

#   sy "I-I don't think we should mess with something like that! It could be dangerous!"
    sy "Acho que não devemos mexer com uma coisa dessas! Pode ser perigoso!"

# game/chapters/chapter4/script/ch4sc3.rpy:301
translate brazil ch4sc3_7d4043ce:

#   mc "It doesn’t matter, I will go."
    mc "Não importa, eu irei."

# game/chapters/chapter4/script/ch4sc3.rpy:302
translate brazil ch4sc3_c2479195:

#   "As the words leave your mouth. Sylph grabs your face again."
    "Assim que as palavras saem da sua boca, Sylph agarra seu rosto novamente."

# game/chapters/chapter4/script/ch4sc3.rpy:304
translate brazil ch4sc3_28174b79:

#   sy "No! You can’t seriously consider going to such a place?!"
    sy "Não! Você não pode estar realmente considerando ir a um lugar assim?!"

# game/chapters/chapter4/script/ch4sc3.rpy:305
translate brazil ch4sc3_8c43438c:

#   sy "Y-Y-You could get hurt! Or, Earth Mother forbid... even worse! You could die!"
    sy "Você pode se machucar! Ou, Deus nos livre... pior ainda! Você pode morrer!"

# game/chapters/chapter4/script/ch4sc3.rpy:307
translate brazil ch4sc3_0ad8443f:

#   sy "Inmortui! Means undying! Seems like a good reason to stay far away."
    sy "Inmortui! Significa imortal! Parece um bom motivo para ficar bem longe."

# game/chapters/chapter4/script/ch4sc3.rpy:313
translate brazil ch4sc3_2eca7aac:

#   mc "Hey... don’t worry, Sylph."
    mc "Ei... não se preocupe, Sylph."

# game/chapters/chapter4/script/ch4sc3.rpy:314
translate brazil ch4sc3_8a2de2f4:

#   mc "Nothing will happen to me, I promise."
    mc "Nada vai me acontecer, eu prometo."

# game/chapters/chapter4/script/ch4sc3.rpy:316
translate brazil ch4sc3_7801f6ab:

#   sy "You can’t promise that!"
    sy "Você não pode prometer isso!"

# game/chapters/chapter4/script/ch4sc3.rpy:317
translate brazil ch4sc3_89410776:

#   sy "You can’t know for sure!"
    sy "Você não pode ter certeza!"

# game/chapters/chapter4/script/ch4sc3.rpy:318
translate brazil ch4sc3_0f1b88e0:

#   "She squeezes your cheeks firmly, not wanting to let go."
    "Ela aperta suas bochechas com firmeza, sem querer soltá-las."

# game/chapters/chapter4/script/ch4sc3.rpy:320
translate brazil ch4sc3_c91b7db3:

#   mc "Yes I can. Eliza is hurt because of me..."
    mc "Sim, eu posso. Eliza está magoada por minha causa..."

# game/chapters/chapter4/script/ch4sc3.rpy:322
translate brazil ch4sc3_93bf9ee7:

#   mc "Sylph, you can sense magic, yeah?"
    mc "Sylph, você consegue sentir magia, não é?"

# game/chapters/chapter4/script/ch4sc3.rpy:324
translate brazil ch4sc3_2008a9b8:

#   sy "Uh-huh! uh-huh! I can! Why?"
    sy "Uhum! Uhum! Eu posso! Por quê?"

# game/chapters/chapter4/script/ch4sc3.rpy:326
translate brazil ch4sc3_96b19635:

#   mc "Do it. Sense my magic."
    mc "Faça isso. Sinta minha magia."

# game/chapters/chapter4/script/ch4sc3.rpy:327
translate brazil ch4sc3_75e93600:

#   mc "It will tell you all you need to know."
    mc "Isso lhe dirá tudo o que você precisa saber."

# game/chapters/chapter4/script/ch4sc3.rpy:331
translate brazil ch4sc3_7eb6e70b:

#   "The warmth of her hands increases against your skin as she begins."
    "O calor das mãos dela aumenta contra a sua pele enquanto ela começa."

# game/chapters/chapter4/script/ch4sc3.rpy:333
translate brazil ch4sc3_6898b552:

#   "She stares intently into your eyes, as if she can see your magic through them."
    "Ela olha fixamente nos seus olhos, como se pudesse ver a sua magia através deles."

# game/chapters/chapter4/script/ch4sc3.rpy:334
translate brazil ch4sc3_e50f1bab:

#   "You feel a slight tingling in your cheeks where her hands rest."
    "Você sente um leve formigamento nas bochechas onde as mãos dela repousam."

# game/chapters/chapter4/script/ch4sc3.rpy:335
translate brazil ch4sc3_d5d802c5:

#   "Her magic and your own meet for the first time. It's an odd sensation you haven't felt before."
    "A magia dela e a sua se encontram pela primeira vez. É uma sensação estranha que você nunca sentiu antes."

# game/chapters/chapter4/script/ch4sc3.rpy:340
translate brazil ch4sc3_d101d3cd:

#   "Letting Sylph feel your magic, successfully managed to calm her, {b}{color=#87e1fa}Charisma{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Ao deixar Sylph sentir sua magia, você conseguiu acalmá-la com sucesso. {b}{color=#87e1fa}Carisma{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc3.rpy:342
translate brazil ch4sc3_41016583:

#   sy "*Sigh* You’re right... there’s no way you'll fail to bring her this cure."
    sy "*Suspiro* Você tem razão... não tem como você não conseguir trazer essa cura para ela."

# game/chapters/chapter4/script/ch4sc3.rpy:343
translate brazil ch4sc3_24132182:

#   sy "I still don’t like it!"
    sy "Eu ainda não gosto disso!"

# game/chapters/chapter4/script/ch4sc3.rpy:345
translate brazil ch4sc3_c04e6076:

#   mc "How about this? When I get back... you can give me a proper scolding for not heeding your advice."
    mc "Que tal isso? Quando eu voltar... você pode me dar uma bronca daquelas por não ter seguido seu conselho."

# game/chapters/chapter4/script/ch4sc3.rpy:347
translate brazil ch4sc3_458421f5:

#   sy "*Whispers* {size=-7}{b}I’ll settle for a biiiig hug... The biggest ever!{/b}{/size}"
    sy "*Sussurros* {size=-7}{b}Eu me contentaria com um abraço beeem grande... O maior de todos!{/b}{/size}"

# game/chapters/chapter4/script/ch4sc3.rpy:349
translate brazil ch4sc3_9c2277ec:

#   mc "*Whispers* {size=-7}{b}You’ve got a deal. One big-ass hug for Sylph upon my return.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Combinado. Um abraço bem apertado para Sylph quando eu voltar.{/b}{/size}"

# game/chapters/chapter4/script/ch4sc3.rpy:351
translate brazil ch4sc3_ba3cb5b7:

#   "Sylph feels calm again, knowing what awaits her upon your return has relaxed her, her trust has increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Sylph se sente calma novamente, sabendo o que a espera quando você voltar, o que a relaxou e aumentou sua confiança. {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc3.rpy:357
translate brazil ch4sc3_5b49cb2a:

#   mc "Sylph, back off."
    mc "Sylph, afaste-se."

# game/chapters/chapter4/script/ch4sc3.rpy:358
translate brazil ch4sc3_7aeb6ea1:

#   mc "Stop worrying about me. I can handle myself."
    mc "Pare de se preocupar comigo. Eu sei me virar."

# game/chapters/chapter4/script/ch4sc3.rpy:359
translate brazil ch4sc3_abd6fa81:

#   mc "I’ve been up against worse odds and I’m still here. I couldn't care less if I had to venture into the five hells."
    mc "Já enfrentei adversidades piores e ainda estou aqui. Não me importaria nem um pouco se tivesse que me aventurar nos cinco infernos."

# game/chapters/chapter4/script/ch4sc3.rpy:360
translate brazil ch4sc3_a9a43ab1:

#   mc "There’s no fucking way I'll die before killing the bastard that did this and finding a cure for Eliza."
    mc "Não há a mínima chance de eu morrer antes de matar o desgraçado que fez isso e encontrar uma cura para Eliza."

# game/chapters/chapter4/script/ch4sc3.rpy:362
translate brazil ch4sc3_899a63de:

#   sy "*Shaky voice* [mc]-... I-..."
    sy "*Voz trêmula* [mc] -... EU-..."

# game/chapters/chapter4/script/ch4sc3.rpy:364
translate brazil ch4sc3_de534571:

#   "Your directness in the matter successfully intimidated Sylph to back off. {b}{color=#fc584c}Intimidation{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Sua franqueza ao abordar o assunto conseguiu intimidar Sylph a ponto de fazê-lo recuar. {b}{color=#fc584c}Intimidação{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc3.rpy:365
translate brazil ch4sc3_ca255fd2:

#   sy "*Sigh* Fine... have it your way."
    sy "*Suspiro* Tudo bem... que seja como você quiser."

# game/chapters/chapter4/script/ch4sc3.rpy:366
translate brazil ch4sc3_50f1caac:

#   sy "But I don’t think it's a good idea!"
    sy "Mas acho que não é uma boa ideia!"

# game/chapters/chapter4/script/ch4sc3.rpy:368
translate brazil ch4sc3_b9c92dff:

#   "Sylph does not like that you dismissed her concerns, her trust has decreased by {size=+3}{b}{color=#f00}1{/color}{/b}{/size}."
    "Sylph não gostou que você tenha ignorado as preocupações dela, e a confiança dela diminuiu. {size=+3}{b}{color=#f00}1{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc3.rpy:372
translate brazil ch4sc3_66e62349:

#   da "Nobody has ever set foot on that island and returned, hence the name."
    da "Ninguém jamais pisou naquela ilha e voltou, daí o nome."

# game/chapters/chapter4/script/ch4sc3.rpy:374
translate brazil ch4sc3_fcf0a941:

#   mc "I don’t care, Dalen."
    mc "Não me importo, Dalen."

# game/chapters/chapter4/script/ch4sc3.rpy:375
translate brazil ch4sc3_b62d68ac:

#   mc "I’m not afraid. If anything tries to stop me..."
    mc "Não tenho medo. Se algo tentar me impedir..."

# game/chapters/chapter4/script/ch4sc3.rpy:377
translate brazil ch4sc3_b85fdb3d:

#   da "*Sigh* I know better than to try and stop you... she’s Oren’s daughter."
    da "*Suspiro* Sei que é melhor não tentar te impedir... ela é filha do Oren."

# game/chapters/chapter4/script/ch4sc3.rpy:378
translate brazil ch4sc3_6864c9cb:

#   da "I want her to be cured as well... I can't stand knowing Taron has harmed her like this."
    da "Eu também quero que ela se cure... Não suporto saber que Taron a machucou dessa forma."

# game/chapters/chapter4/script/ch4sc3.rpy:379
translate brazil ch4sc3_3d0ccafc:

#   da "I'll pull some strings and arrange for passage on a ship."
    da "Vou usar minha influência e conseguir uma passagem em um navio."

# game/chapters/chapter4/script/ch4sc3.rpy:381
translate brazil ch4sc3_8b9522fc:

#   da "Come back here in the morning."
    da "Volte aqui pela manhã."

# game/chapters/chapter4/script/ch4sc3.rpy:382
translate brazil ch4sc3_6a5d5269:

#   da "We’ll plan your journey together."
    da "Planejaremos sua viagem juntos."

# game/chapters/chapter4/script/ch4sc3.rpy:384
translate brazil ch4sc3_dbcd9a01:

#   mc "Dalen... thank you."
    mc "Dalen... obrigado."

# game/chapters/chapter4/script/ch4sc3.rpy:386
translate brazil ch4sc3_a92877f8:

#   da "You should know... the journey will be long..."
    da "Você deve saber... a jornada será longa..."

# game/chapters/chapter4/script/ch4sc3.rpy:387
translate brazil ch4sc3_004c9344:

#   da "You're about to get a real taste of what it means to be an adventurer... make sure to say your goodbyes."
    da "Você está prestes a experimentar o verdadeiro significado de ser um aventureiro... não se esqueça de se despedir."

# game/chapters/chapter4/script/ch4sc3.rpy:388
translate brazil ch4sc3_5b834ee9:

#   da "You should expect to be at sea for several moons."
    da "Você deve esperar ficar no mar por várias luas."

# game/chapters/chapter4/script/ch4sc3.rpy:390
translate brazil ch4sc3_b938c45d:

#   sy "Wha?! Several?! But-"
    sy "O quê?! Vários?! Mas-"

# game/chapters/chapter4/script/ch4sc3.rpy:392
translate brazil ch4sc3_5bddce9c:

#   mc "Noted. I'll make preparations for the journey, and give my friends a heads up."
    mc "Anotado. Farei os preparativos para a viagem e avisarei meus amigos."

# game/chapters/chapter4/script/ch4sc3.rpy:393
translate brazil ch4sc3_74d2d99a:

#   mc "I’ll see you tomorrow at first light."
    mc "Te vejo amanhã ao amanhecer."

# game/chapters/chapter4/script/ch4sc3.rpy:395
translate brazil ch4sc3_81011159:

#   "Dalen heads to his office and you head for the door."
    "Dalen dirige-se ao seu escritório e você dirige-se para a porta."

# game/chapters/chapter4/script/ch4sc3.rpy:397
translate brazil ch4sc3_c3492334:

#   sy "[mc]!"
    sy "[mc]!"

# game/chapters/chapter4/script/ch4sc3.rpy:399
translate brazil ch4sc3_22c1bcff:

#   mc "Sylph? What is it?"
    mc "Sílfide? O que é isso?"

# game/chapters/chapter4/script/ch4sc3.rpy:401
translate brazil ch4sc3_9560d790:

#   "You feel her small hands grab onto yours and gently place something in your palm."
    "Você sente as mãozinhas dela segurarem as suas e colocarem algo delicadamente na palma da sua mão."

# game/chapters/chapter4/script/ch4sc3.rpy:402
translate brazil ch4sc3_760fcfc6:

#   sy "Please take this! It will protect you from the bad things..."
    sy "Por favor, aceite isto! Vai te proteger das coisas ruins..."

# game/chapters/chapter4/script/ch4sc3.rpy:403
translate brazil ch4sc3_7b613379:

#   sy "This flower contains magical properties from the Earth Mother's tree."
    sy "Esta flor contém propriedades mágicas da árvore da Mãe Terra."

# game/chapters/chapter4/script/ch4sc3.rpy:404
translate brazil ch4sc3_af9c7e00:

#   sy "If you bring it back to me..."
    sy "Se você me trouxer isso de volta..."

# game/chapters/chapter4/script/ch4sc3.rpy:405
translate brazil ch4sc3_87e12d85:

#   sy "We’ll make it bloom... together."
    sy "Vamos fazê-la florescer... juntos."

# game/chapters/chapter4/script/ch4sc3.rpy:407
translate brazil ch4sc3_f0412c7d:

#   mc "Thank you, Sylph. I’ll be sure to bring it back to you."
    mc "Obrigada, Sylph. Com certeza trarei de volta para você."

# game/chapters/chapter4/script/ch4sc3.rpy:415
translate brazil ch4sc3_d37c32b4:

#   "Sylph stops just before her small lips connect with yours and you feel her warm breath tickle your lips."
    "Sylph para um instante antes de seus pequenos lábios tocarem os seus, e você sente sua respiração quente acariciando seus lábios."

# game/chapters/chapter4/script/ch4sc3.rpy:421
translate brazil ch4sc3_7f02594b:

#   "Her upper lip carefully grazes yours and her breathing intensifies."
    "O lábio superior dela roça delicadamente o seu e a respiração dela se intensifica."

# game/chapters/chapter4/script/ch4sc3.rpy:423
translate brazil ch4sc3_1829e7ff:

#   "As you tilt your head, she playfully caresses your lips with hers."
    "Ao inclinar a cabeça, ela acaricia seus lábios com os dela, de forma lúdica."

# game/chapters/chapter4/script/ch4sc3.rpy:424
translate brazil ch4sc3_28f265d0:

#   "Her hand remains firm at the back of your neck as she begins to kiss you as delicately as a flower."
    "A mão dela permanece firme na sua nuca enquanto ela começa a beijá-lo com a delicadeza de uma flor."

# game/chapters/chapter4/script/ch4sc3.rpy:427
translate brazil ch4sc3_330ea55b:

#   sy "*Mwahh* Mhnnhh!"
    sy "*Mwahh* Mhnnhh!"

# game/chapters/chapter4/script/ch4sc3.rpy:432
translate brazil ch4sc3_e039e221:

#   "Her small lips are warm and tingling with magic. An intoxicating sensation you haven’t felt before."
    "Seus lábios delicados são quentes e vibram com magia. Uma sensação inebriante que você nunca sentiu antes."

# game/chapters/chapter4/script/ch4sc3.rpy:433
translate brazil ch4sc3_abf851e0:

#   sy "Mhhhh... MhMh! *Soft moans* Mhhww!"
    sy "Mhhhh... MhMh! *Gemidos suaves* Mhhww!"

# game/chapters/chapter4/script/ch4sc3.rpy:434
translate brazil ch4sc3_9886030e:

#   "She keeps kissing you, making sure there’s no space between your lips."
    "Ela continua te beijando, certificando-se de que não haja espaço entre seus lábios."

# game/chapters/chapter4/script/ch4sc3.rpy:435
translate brazil ch4sc3_cfa29a55:

#   "She wants to be close to you... She longs for it."
    "Ela quer estar perto de você... Ela anseia por isso."

# game/chapters/chapter4/script/ch4sc3.rpy:436
translate brazil ch4sc3_07fb6962:

#   "Her delicate kisses keeps increasing in intensity, as do her moans."
    "Seus beijos delicados vão aumentando em intensidade, assim como seus gemidos."

# game/chapters/chapter4/script/ch4sc3.rpy:437
translate brazil ch4sc3_c016afc3:

#   "Until she finally pulls away."
    "Até que ela finalmente se afasta."

# game/chapters/chapter4/script/ch4sc3.rpy:440
translate brazil ch4sc3_a6d7c55e:

#   sy "Mmhwaa..."
    sy "Uau..."

# game/chapters/chapter4/script/ch4sc3.rpy:442
translate brazil ch4sc3_e8f283b9:

#   mc "What’s that for?"
    mc "Para que serve isso?"

# game/chapters/chapter4/script/ch4sc3.rpy:444
translate brazil ch4sc3_f8c44f3b:

#   sy "Just something for good luck."
    sy "Só uma coisinha para dar sorte."

# game/chapters/chapter4/script/ch4sc3.rpy:445
translate brazil ch4sc3_4f19b71a:

#   sy "Here, let me give you some more..."
    sy "Aqui, deixe-me dar-lhe mais algumas informações..."

# game/chapters/chapter4/script/ch4sc3.rpy:457
translate brazil ch4sc3_4d479e66:

#   mc "Sylph, no."
    mc "Sílfide, não."

# game/chapters/chapter4/script/ch4sc3.rpy:458
translate brazil ch4sc3_f2f668c3:

#   mc "It’s not a good idea... it's not the time for this."
    mc "Não é uma boa ideia... não é o momento para isso."

# game/chapters/chapter4/script/ch4sc3.rpy:460
translate brazil ch4sc3_1faa4d27:

#   sy "R-Right... I’m sorry, silly, silly me."
    sy "Certo... Desculpe, que boba eu fui."

# game/chapters/chapter4/script/ch4sc3.rpy:461
translate brazil ch4sc3_39f6e58c:

#   sy "I thought you might’ve felt the same about me... the way our magic connects..."
    sy "Pensei que você pudesse sentir o mesmo por mim... pela forma como nossa magia se conecta..."

# game/chapters/chapter4/script/ch4sc3.rpy:463
translate brazil ch4sc3_57f3a6ee:

#   mc "Don’t be sorry... it takes courage to show how you feel."
    mc "Não se desculpe... é preciso coragem para mostrar o que você sente."

# game/chapters/chapter4/script/ch4sc3.rpy:464
translate brazil ch4sc3_1ced5df1:

#   mc "I just can’t return your feelings, at least not at this moment."
    mc "Simplesmente não consigo corresponder aos seus sentimentos, pelo menos não neste momento."

# game/chapters/chapter4/script/ch4sc3.rpy:470
translate brazil ch4sc3_0197a75c:

#   sy "I-I... thank you ,[mc]."
    sy "II... obrigado, [mc]."

# game/chapters/chapter4/script/ch4sc3.rpy:471
translate brazil ch4sc3_bf6d80c7:

#   sy "That does make sense, when you put it like that."
    sy "Faz sentido, quando você coloca dessa forma."

# game/chapters/chapter4/script/ch4sc3.rpy:472
translate brazil ch4sc3_92d43f6a:

#   sy "Please make sure you come back..."
    sy "Por favor, não se esqueça de voltar..."

# game/chapters/chapter4/script/ch4sc3.rpy:151
translate brazil ch4sc3_37c0ae2c_1:

#   mc "How do you know all this, Dalen? What's your connection to this 'Taron'?"
    mc "Como você sabe de tudo isso, Dalen? Qual é a sua ligação com esse tal de 'Taron'?"

# game/chapters/chapter4/script/ch4sc3.rpy:153
translate brazil ch4sc3_2ea0774c_1:

#   da "*Sigh* He..."
    da "*Suspiro* Ele..."

# game/chapters/chapter4/script/ch4sc3.rpy:155
translate brazil ch4sc3_e71169d3_1:

#   da "He, Oren, and I... we used to be friends."
    da "Ele, Oren, e eu... costumávamos ser amigos."

# game/chapters/chapter4/script/ch4sc3.rpy:158
translate brazil ch4sc3_b20df5cb_1:

#   mc "Friends?!"
    mc "Amigos?!"

# game/chapters/chapter4/script/ch4sc3.rpy:159
translate brazil ch4sc3_6c69720a_1:

#   mc "What the hell, Dalen!"
    mc "Que diabos, Dalen!"

# game/chapters/chapter4/script/ch4sc3.rpy:161
translate brazil ch4sc3_8b38ead0_1:

#   da "Emphasis on 'used to be.'"
    da "Ênfase em \"costumava ser\"."

# game/chapters/chapter4/script/ch4sc3.rpy:162
translate brazil ch4sc3_7c92ed34_1:

#   da "The three of us met when we were young."
    da "Nós três nos conhecemos quando éramos jovens."

# game/chapters/chapter4/script/ch4sc3.rpy:164
translate brazil ch4sc3_7b2b3ab0_1:

#   da "We were all training at the royal academy. Each of us easily surpassed the other students..."
    da "Estávamos todos treinando na academia real. Cada um de nós superava facilmente os outros alunos..."

# game/chapters/chapter4/script/ch4sc3.rpy:165
translate brazil ch4sc3_45bb5e36_1:

#   da "So our instructors decided to put us in a special unit."
    da "Então, nossos instrutores decidiram nos colocar em uma unidade especial."

# game/chapters/chapter4/script/ch4sc3.rpy:167
translate brazil ch4sc3_0313b537_1:

#   da "We quickly became known as 'Trinity' among the other cadets."
    da "Rapidamente ficamos conhecidos como 'Trindade' entre os outros cadetes."

# game/chapters/chapter4/script/ch4sc3.rpy:168
translate brazil ch4sc3_2ed7d856_1:

#   da "An unbeatable trio who took out the king's worst offenders."
    da "Um trio imbatível que eliminou os piores criminosos do rei."

# game/chapters/chapter4/script/ch4sc3.rpy:170
translate brazil ch4sc3_5c124d35_1:

#   da "But after we graduated we all drifted apart..."
    da "Mas depois que nos formamos, todos nos afastamos..."

# game/chapters/chapter4/script/ch4sc3.rpy:171
translate brazil ch4sc3_73e73dd3_1:

#   da "Oren married his sweetheart, Ellen and moved to Whitehills."
    da "Oren casou-se com sua amada, Ellen, e mudou-se para Whitehills."

# game/chapters/chapter4/script/ch4sc3.rpy:172
translate brazil ch4sc3_7d52e070_1:

#   da "I visited him once after Eliza was born. She was only two summers old at the time."
    da "Visitei-o uma vez depois do nascimento de Eliza. Ela tinha apenas dois verões na altura."

# game/chapters/chapter4/script/ch4sc3.rpy:173
translate brazil ch4sc3_923b8636_1:

#   da "Such a lively girl, though. She was running after Oren wherever he went..."
    da "Que menina animada! Ela corria atrás do Oren para onde quer que ele fosse..."

# game/chapters/chapter4/script/ch4sc3.rpy:175
translate brazil ch4sc3_e7e2bff3_1:

#   da "As for Taron... He went to work as an elite mercenary directly under the command of the Knight-Commander."
    da "Quanto a Taron... Ele foi trabalhar como mercenário de elite, diretamente sob o comando do Cavaleiro-Comandante."

# game/chapters/chapter4/script/ch4sc3.rpy:176
translate brazil ch4sc3_3aa7361b_1:

#   da "They usually took on the most dangerous and rewarding missions."
    da "Eles geralmente assumiam as missões mais perigosas e recompensadoras."

# game/chapters/chapter4/script/ch4sc3.rpy:178
translate brazil ch4sc3_a92f999b_1:

#   da "Taron has mostly kept to himself, although I've seen him several times since we split from the academy."
    da "Taron tem se mantido bastante reservado, embora eu o tenha visto várias vezes desde que nos separamos da academia."

# game/chapters/chapter4/script/ch4sc3.rpy:179
translate brazil ch4sc3_74616a32_1:

#   da "But each time I've encountered him, he's seemed less and less like the kid I graduated alongside."
    da "Mas a cada vez que o encontro, ele me parece cada vez menos o garoto com quem me formei."

# game/chapters/chapter4/script/ch4sc3.rpy:181
translate brazil ch4sc3_b4b02cbf_1:

#   da "And I sought adventure. I wanted to see the world outside the capital walls."
    da "E eu buscava aventura. Queria ver o mundo além dos muros da capital."

# game/chapters/chapter4/script/ch4sc3.rpy:182
translate brazil ch4sc3_ac9e5e53_1:

#   da "I spent several years traveling, until I finally had my fill of murky caves, rugged mountains and old ruins."
    da "Passei vários anos viajando, até que finalmente me fartei de cavernas escuras, montanhas acidentadas e ruínas antigas."

# game/chapters/chapter4/script/ch4sc3.rpy:183
translate brazil ch4sc3_27da2fba_1:

#   da "Eventually, I decided to return to Luxenford to establish the adventurer’s guild here."
    da "Por fim, decidi retornar a Luxenford para estabelecer aqui a guilda dos aventureiros."

# game/chapters/chapter4/script/ch4sc3.rpy:185
translate brazil ch4sc3_73c160f4_1:

#   da "As for what caused Taron to become... whatever he's become, I have no idea."
    da "Quanto ao que levou Taron a se tornar... seja lá o que ele se tornou, eu não faço ideia."

# game/chapters/chapter4/script/ch4sc3.rpy:186
translate brazil ch4sc3_88dab9c6_1:

#   da "He’s become cold and calculating. He ruthlessly manipulates people to his own ends. And he’s cunning."
    da "Ele se tornou frio e calculista. Manipula as pessoas impiedosamente para atingir seus próprios objetivos. E é astuto."

# game/chapters/chapter4/script/ch4sc3.rpy:188
translate brazil ch4sc3_30f9b289_1:

#   da "I’ve tried to catch him red-handed several times. But to no avail. He uses lackeys to do his bidding."
    da "Já tentei pegá-lo em flagrante várias vezes, mas sem sucesso. Ele usa capangas para fazer o que ele manda."

# game/chapters/chapter4/script/ch4sc3.rpy:190
translate brazil ch4sc3_168800a0_1:

#   da "He covers his tracks well."
    da "Ele encobre bem os seus rastros."

# game/chapters/chapter4/script/ch4sc3.rpy:192
translate brazil ch4sc3_f5412e11_1:

#   mc "This time he didn’t use lackeys. He assaulted Eliza himself."
    mc "Dessa vez, ele não usou capangas. Ele mesmo atacou Eliza."

# game/chapters/chapter4/script/ch4sc3.rpy:194
translate brazil ch4sc3_0d6d4119_1:

#   mc "*Sigh* We need to find a way to help Eliza."
    mc "*Suspiro* Precisamos encontrar uma maneira de ajudar a Eliza."

# game/chapters/chapter4/script/ch4sc3.rpy:213
translate brazil ch4sc3_5c2c7bcf_1:

#   sy "..."
    sy "..."

# game/chapters/chapter4/script/ch4sc3.rpy:338
translate brazil ch4sc3_5c2c7bcf_2:

#   sy "..."
    sy "..."

# game/chapters/chapter4/script/ch4sc3.rpy:466
translate brazil ch4sc3_5c2c7bcf_3:

#   sy "..."
    sy "..."

