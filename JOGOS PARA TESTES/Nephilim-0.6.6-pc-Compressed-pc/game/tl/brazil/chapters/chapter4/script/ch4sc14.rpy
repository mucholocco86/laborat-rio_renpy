translate brazil ch4sc14_2acbc4d4:

#   ki "We'd better find some exotic treasure. And soon!"
    ki "É melhor encontrarmos algum tesouro exótico. E logo!"

# game/chapters/chapter4/script/ch4sc14.rpy:2355
translate brazil ch4sc14_ff206607:

#   mc "*Chuckles* Aye, aye, Captain!"
    mc "*Risos* Sim, sim, Capitão!"

# game/chapters/chapter4/script/ch4sc14.rpy:2357
translate brazil ch4sc14_745b9a08:

#   ki "*Nudge* Hush you!"
    ki "*Cutucada* Silêncio!"

# game/chapters/chapter4/script/ch4sc14.rpy:2359
translate brazil ch4sc14_99434ad9:

#   ki "All I’m saying, is a little shiny treasure would be welcome."
    ki "Só estou dizendo que um pequeno tesouro brilhante seria bem-vindo."

# game/chapters/chapter4/script/ch4sc14.rpy:2361
translate brazil ch4sc14_1f0fb456:

#   mc "Don’t worry. I won’t let you return to your father empty handed."
    mc "Não se preocupe. Não vou deixar você voltar para seu pai de mãos vazias."

# game/chapters/chapter4/script/ch4sc14.rpy:2362
translate brazil ch4sc14_505469fc:

#   mc "I refuse to give him an excuse to berate you any further."
    mc "Recuso-me a dar-lhe qualquer desculpa para continuar a insultá-lo."

# game/chapters/chapter4/script/ch4sc14.rpy:2366
translate brazil ch4sc14_b0c83c86:

#   "She leans closer against you."
    "Ela se inclina mais perto de você."

# game/chapters/chapter4/script/ch4sc14.rpy:2367
translate brazil ch4sc14_96667528:

#   ki "*Whispers* {size=-10}{b}Thank you.{/b}{/size}"
    ki "*Sussurros* {size=-10}{b}Obrigado.{/b}{/size}"

# game/chapters/chapter4/script/ch4sc14.rpy:2368
translate brazil ch4sc14_1d2e3f1a:

#   ki "*Whispers* {size=-10}{b}I can't believe I-... I belong to you now, completely.{/b}{/size}"
    ki "*Sussurros* {size=-10}{b}Não consigo acreditar que... agora eu pertenço a você, completamente.{/b}{/size}"

# game/chapters/chapter4/script/ch4sc14.rpy:2370
translate brazil ch4sc14_d5750692:

#   "You feel her hot breath on your cheek, followed by a soft, wet sensation."
    "Você sente a respiração quente dela em sua bochecha, seguida por uma sensação suave e úmida."

# game/chapters/chapter4/script/ch4sc14.rpy:2380
translate brazil ch4sc14_cc33c81f:

#   ki "*Whispers* {size=-10}{b}Goodnight... my hero.{/b}{/size}"
    ki "*Sussurros* {size=-10}{b}Boa noite... meu herói.{/b}{/size}"

# game/chapters/chapter4/script/ch4sc14.rpy:2382
translate brazil ch4sc14_d7cdad4f:

#   "She falls asleep with her arms and legs wrapped around you."
    "Ela adormece com os braços e as pernas em volta de você."

# game/chapters/chapter4/script/ch4sc14.rpy:2383
translate brazil ch4sc14_63f7e69f:

#   mct "She’s already asleep. It’s been quite an eventful day for her."
    mct "Ela já está dormindo. Foi um dia bastante agitado para ela."

# game/chapters/chapter4/script/ch4sc14.rpy:2384
translate brazil ch4sc14_fbede0ce:

#   mct "For both of us, really."
    mct "Para nós dois, na verdade."

# game/chapters/chapter4/script/ch4sc14.rpy:2385
translate brazil ch4sc14_737b5ce6:

#   mct "I noticed something earlier... When I was picking mushrooms."
    mct "Notei algo mais cedo... Quando estava colhendo cogumelos."

# game/chapters/chapter4/script/ch4sc14.rpy:2386
translate brazil ch4sc14_1be298f1:

#   mct "There was a faint trace of magic coming from the other tunnel."
    mct "Havia um leve traço de magia vindo do outro túnel."

# game/chapters/chapter4/script/ch4sc14.rpy:2387
translate brazil ch4sc14_71c2113a:

#   mct "But there was enough for me to know that it feels different from normal magic."
    mct "Mas foi o suficiente para eu perceber que a sensação é diferente da magia normal."

# game/chapters/chapter4/script/ch4sc14.rpy:2388
translate brazil ch4sc14_2924b22e:

#   mct "I guess we’ll find out more tomorrow."
    mct "Acho que saberemos mais amanhã."

# game/chapters/chapter4/script/ch4sc14.rpy:2390
translate brazil ch4sc14_e72c916a:

#   "You listen quietly to the sounds of the heavy downpour and the fire crackling. You feel her warm body slumbering against yours..."
    "Você escuta em silêncio o som da forte chuva e do crepitar do fogo. Sente o corpo quente dela adormecido contra o seu..."

# game/chapters/chapter4/script/ch4sc14.rpy:2392
translate brazil ch4sc14_ccfece4a:

#   "Then sleep claims you as well."
    "Então o sono também te pega."

# game/chapters/chapter4/script/ch4sc14.rpy:2397
translate brazil ch4sc14_91e92e0d:

#   "You break away, Kira understands your signal."
    "Você se desvencilha, Kira entende seu sinal."

# game/chapters/chapter4/script/ch4sc14.rpy:2399
translate brazil ch4sc14_56d05b94:

#   "The two of you sit down by the fire."
    "Vocês dois se sentam perto da lareira."

# game/chapters/chapter4/script/ch4sc14.rpy:2400
translate brazil ch4sc14_0d7d6665:

#   ki "I’m sorry. I-"
    ki "Sinto muito. Eu-"

# game/chapters/chapter4/script/ch4sc14.rpy:2401
translate brazil ch4sc14_a67bd546:

#   mc "Kira, it’s fine... I understand. But we’re friends, and I don’t want to ruin that."
    mc "Kira, tudo bem... eu entendo. Mas somos amigas, e eu não quero estragar isso."

# game/chapters/chapter4/script/ch4sc14.rpy:2402
translate brazil ch4sc14_b69a450c:

#   mc "I feel something for you. But right now, it isn’t clear to me what that is."
    mc "Sinto algo por você. Mas, neste momento, não me é claro o que é."

# game/chapters/chapter4/script/ch4sc14.rpy:2403
translate brazil ch4sc14_da4b7488:

#   mc "And I refuse to ruin our friendship for an impulse."
    mc "E eu me recuso a arruinar nossa amizade por um impulso."

# game/chapters/chapter4/script/ch4sc14.rpy:2404
translate brazil ch4sc14_334c3506:

#   ki "Friends. I like that. But... I do feel something for you."
    ki "Amigos. Eu gosto disso. Mas... eu sinto algo por você."

# game/chapters/chapter4/script/ch4sc14.rpy:2405
translate brazil ch4sc14_b2935a2c:

#   ki "This probably won't be my only moment of weakness."
    ki "Provavelmente, esse não será meu único momento de fraqueza."

# game/chapters/chapter4/script/ch4sc14.rpy:2406
translate brazil ch4sc14_7bcb7d36:

#   mc "That's okay. As long as you understand why I can't do more until I'm certain of my own feelings."
    mc "Tudo bem. Contanto que você entenda por que não posso fazer mais nada até ter certeza dos meus próprios sentimentos."

# game/chapters/chapter4/script/ch4sc14.rpy:2407
translate brazil ch4sc14_edffacf4:

#   ki "I am."
    ki "Eu sou."

# game/chapters/chapter4/script/ch4sc14.rpy:2408
translate brazil ch4sc14_02f868ec:

#   "The two of you sit by the fire for a while longer before going to bed."
    "Vocês dois ficam sentados junto à lareira por mais um tempo antes de irem para a cama."

# game/chapters/chapter4/script/ch4sc14.rpy:2410
translate brazil ch4sc14_2f8ba351:

#   "You wait until after Kira is sleeping deeply, before rising and heading back to the pools."
    "Você espera até que Kira esteja dormindo profundamente, antes de se levantar e voltar para as piscinas."

# game/chapters/chapter4/script/ch4sc14.rpy:2411
translate brazil ch4sc14_4b52a0ff:

#   "There’s an idea you can’t get out of your mind. Maybe ... ?"
    "Há uma ideia que não sai da sua cabeça. Talvez...?"

# game/chapters/chapter4/script/ch4sc14.rpy:2413
translate brazil ch4sc14_8b041d11:

#   "When you reach the pools, you place your hands on a crystal and try to absorb the rejuvenation magic within it."
    "Ao chegar às piscinas, você coloca as mãos em um cristal e tenta absorver a magia rejuvenescedora que ele contém."

# game/chapters/chapter4/script/ch4sc14.rpy:2417
translate brazil ch4sc14_00a33698:

#   mct "It worked! I've never abosrbed essence from an object before. I guess anything magical is fair game."
    mct "Funcionou! Nunca tinha absorvido a essência de um objeto antes. Acho que tudo que é mágico vale."

# game/chapters/chapter4/script/ch4sc14.rpy:2418
translate brazil ch4sc14_c26e7977:

#   mct "Being able to regenerate and heal will come in handy for sure."
    mct "A capacidade de se regenerar e curar certamente será muito útil."

# game/chapters/chapter4/script/ch4sc14.rpy:79
translate brazil ch4sc14_3555f4d2_1:

#   "*Echoing thunder*"
    "*Ecoando o trovão*"

# game/chapters/chapter4/script/ch4sc14.rpy:264
translate brazil ch4sc14_22f922f0_1:

#   "You follow Kira’s gaze down to your erection."
    "Você acompanha o olhar de Kira até chegar à sua ereção."

# game/chapters/chapter4/script/ch4sc14.rpy:266
translate brazil ch4sc14_fca925f0_1:

#   ki "Isn’t that uncomfortable?"
    ki "Isso não é desconfortável?"

# game/chapters/chapter4/script/ch4sc14.rpy:268
translate brazil ch4sc14_e34a3d14_1:

#   mc "It can be, if it stays like this for too long without release."
    mc "Pode acontecer, se permanecer assim por muito tempo sem ser liberado."

# game/chapters/chapter4/script/ch4sc14.rpy:271
translate brazil ch4sc14_c764c636_1:

#   "Kira catches herself staring, and turns away blushing."
    "Kira se dá conta de que está encarando e desvia o olhar, corando."

# game/chapters/chapter4/script/ch4sc14.rpy:908
translate brazil ch4sc14_26aaa7cd_1:

#   mc "{b}KIRA!!{/b}"
    mc "{b}PENSAR!!{/b}"

