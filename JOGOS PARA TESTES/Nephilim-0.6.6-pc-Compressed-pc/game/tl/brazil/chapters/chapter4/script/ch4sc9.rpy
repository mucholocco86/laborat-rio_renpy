# game/chapters/chapter4/script/ch4sc9.rpy:1072
translate brazil ch4sc9_34b00ef6:

#   kl "T-That’s okay... I had a feeling. Let’s get some sleep!"
    kl "T-Tudo bem... Eu já imaginava. Vamos dormir um pouco!"

# game/chapters/chapter4/script/ch4sc9.rpy:1074
translate brazil ch4sc9_c4a8dc0d:

#   kl "I hope we won't have to get up early... I really want to sleep in!"
    kl "Espero que não tenhamos que acordar cedo... Quero muito dormir até mais tarde!"

# game/chapters/chapter4/script/ch4sc9.rpy:1080
translate brazil ch4sc9_8daaf097:

#   mc "I don’t know about you but I’m about to pass out."
    mc "Não sei quanto a vocês, mas eu estou quase desmaiando."

# game/chapters/chapter4/script/ch4sc9.rpy:1081
translate brazil ch4sc9_f73816f9:

#   mc "I'll see you tomorrow, Kelly."
    mc "Te vejo amanhã, Kelly."

# game/chapters/chapter4/script/ch4sc9.rpy:1083
translate brazil ch4sc9_fc7a964f:

#   kl "Totally! Nighty night."
    kl "Com certeza! Boa noite."

# game/chapters/chapter4/script/ch4sc9.rpy:1091
translate brazil ch4sc9_5bc9d9aa:

#   mct "Ugh... I can’t sleep."
    mct "Ai... Não consigo dormir."

# game/chapters/chapter4/script/ch4sc9.rpy:1092
translate brazil ch4sc9_7859e4e1:

#   mct "Some fresh air might do the trick."
    mct "Um pouco de ar fresco pode resolver o problema."

# game/chapters/chapter4/script/ch4sc9.rpy:1097
translate brazil ch4sc9_c5849b24:

#   mct "Huh. Is that... ?"
    mct "Hum. É isso...?"

# game/chapters/chapter4/script/ch4sc9.rpy:1106
translate brazil ch4sc9_54c77186:

#   mct "It’s definitely Pearl."
    mct "Com certeza é Pearl."

# game/chapters/chapter4/script/ch4sc9.rpy:1107
translate brazil ch4sc9_9e2edb49:

#   mct "Damn..."
    mct "Droga..."

# game/chapters/chapter4/script/ch4sc9.rpy:1108
translate brazil ch4sc9_e96cc114:

#   mct "Flynn wasn’t exaggerating when he raved on about Pearl and Kira's beauty."
    mct "Flynn não estava exagerando quando elogiou a beleza de Pearl e Kira."

# game/chapters/chapter4/script/ch4sc9.rpy:1109
translate brazil ch4sc9_766b406e:

#   mct "The way the moonlight highlights her tan skin against the darkened skies..."
    mct "O modo como o luar realça sua pele bronzeada contra o céu escuro..."

# game/chapters/chapter4/script/ch4sc9.rpy:1110
translate brazil ch4sc9_531c5147:

#   mct "Not to mention her curves... the way she carries herself... she’s beautiful and she knows it."
    mct "Sem falar nas suas curvas... o jeito como ela se porta... ela é linda e sabe disso."

# game/chapters/chapter4/script/ch4sc9.rpy:1111
translate brazil ch4sc9_9050c864:

#   mct "According to Flynn, she's reputed to be a skilled fighter just like her sister."
    mct "Segundo Flynn, ela tem fama de ser uma lutadora habilidosa, assim como sua irmã."

# game/chapters/chapter4/script/ch4sc9.rpy:1112
translate brazil ch4sc9_359e3f20:

#   mct "It’s hard to imagine someone so mesmerizing being that deadly."
    mct "É difícil imaginar alguém tão fascinante sendo tão mortal."

# game/chapters/chapter4/script/ch4sc9.rpy:1113
translate brazil ch4sc9_a4b889c1:

#   mct "Guess it’s time I head back below deck and get some rest."
    mct "Acho que está na hora de eu voltar para o convés inferior e descansar um pouco."

# game/chapters/chapter4/script/ch4sc9.rpy:1118
translate brazil ch4sc9_f7501f89:

#   pl "Aren't you going to join me?"
    pl "Você não vai se juntar a mim?"

# game/chapters/chapter4/script/ch4sc9.rpy:1119
translate brazil ch4sc9_c078781a:

#   mct "She noticed me? She's got a strong sense of her surroundings."
    mct "Ela me notou? Ela tem uma percepção aguçada do que acontece ao seu redor."

# game/chapters/chapter4/script/ch4sc9.rpy:1121
translate brazil ch4sc9_810310bb:

#   mc "Sure, if you don't mind."
    mc "Claro, se não se importar."

# game/chapters/chapter4/script/ch4sc9.rpy:1124
translate brazil ch4sc9_2420ea74:

#   pl "I like to come out here at night."
    pl "Gosto de vir aqui à noite."

# game/chapters/chapter4/script/ch4sc9.rpy:1126
translate brazil ch4sc9_25a3e8ac:

#   mc "I can see why."
    mc "Eu entendo o porquê."

# game/chapters/chapter4/script/ch4sc9.rpy:1127
translate brazil ch4sc9_46e7cfcd:

#   mc "It’s... serene."
    mc "É... sereno."

# game/chapters/chapter4/script/ch4sc9.rpy:1129
translate brazil ch4sc9_a52462f3:

#   pl "*Giggles* Serene? Is that your way of saying it’s beautiful?"
    pl "*Risos* Sereno? É assim que você quer dizer que é bonito?"

# game/chapters/chapter4/script/ch4sc9.rpy:1131
translate brazil ch4sc9_72600212:

#   mc "No. It means calming. Or soothing…"
    mc "Não. Significa acalmar. Ou tranquilizar…"

# game/chapters/chapter4/script/ch4sc9.rpy:1133
translate brazil ch4sc9_a41aa8b4:

#   pl "Oh! I see."
    pl "Oh, eu vejo."

# game/chapters/chapter4/script/ch4sc9.rpy:1134
translate brazil ch4sc9_015dce0a:

#   pl "Yeah, I suppose it is soothing."
    pl "Sim, suponho que seja reconfortante."

# game/chapters/chapter4/script/ch4sc9.rpy:1135
translate brazil ch4sc9_8a30e2fe:

#   pl "Serene... *Giggles softly* Yes, serene."
    pl "Sereno... *Risinhos suaves* Sim, sereno."

# game/chapters/chapter4/script/ch4sc9.rpy:1137
translate brazil ch4sc9_7b5fc241:

#   pl "I come here for the sounds mostly. The gentle lapping of the sea against the ship..."
    pl "Venho aqui principalmente pelos sons. O suave murmúrio do mar contra o navio..."

# game/chapters/chapter4/script/ch4sc9.rpy:1138
translate brazil ch4sc9_f2769b29:

#   pl "The sighing of the wind as it flows across the sails."
    pl "O suspiro do vento ao passar pelas velas."

# game/chapters/chapter4/script/ch4sc9.rpy:1140
translate brazil ch4sc9_8b75548c:

#   pl "It’s like my senses are... magnified somehow."
    pl "É como se meus sentidos estivessem... amplificados de alguma forma."

# game/chapters/chapter4/script/ch4sc9.rpy:1141
translate brazil ch4sc9_f2411df8:

#   pl "There's just something about being out at night..."
    pl "Tem algo de especial em estar na rua à noite..."

# game/chapters/chapter4/script/ch4sc9.rpy:1142
translate brazil ch4sc9_27356878:

#   pl "It makes me feel-"
    pl "Isso me faz sentir-"

# game/chapters/chapter4/script/ch4sc9.rpy:1144
translate brazil ch4sc9_e91de204:

#   mc "Alive?"
    mc "Vivo?"

# game/chapters/chapter4/script/ch4sc9.rpy:1145
translate brazil ch4sc9_1ef877a7:

#   pl "Alive, yes."
    pl "Vivo, sim."

# game/chapters/chapter4/script/ch4sc9.rpy:1146
translate brazil ch4sc9_5723684a:

#   pl "Hmm, you're a curious one."
    pl "Hum, você é uma pessoa curiosa."

# game/chapters/chapter4/script/ch4sc9.rpy:1147
translate brazil ch4sc9_a6f0acd8:

#   mc "*Chuckles* As are you..."
    mc "*Risos* Você também..."

# game/chapters/chapter4/script/ch4sc9.rpy:1151
translate brazil ch4sc9_c2673f33:

#   pl "A pearl for your thoughts?"
    pl "Uma pérola para seus pensamentos?"

# game/chapters/chapter4/script/ch4sc9.rpy:1153
translate brazil ch4sc9_c452363f:

#   mc "*Chuckles* Clever..."
    mc "*Risos* Inteligente..."

# game/chapters/chapter4/script/ch4sc9.rpy:1155
translate brazil ch4sc9_667f41a6:

#   pl "Something keeping you up?"
    pl "Tem algo te impedindo de dormir?"

# game/chapters/chapter4/script/ch4sc9.rpy:1156
translate brazil ch4sc9_8da51589:

#   pl "Maybe... the reason you’re on our ship?"
    pl "Talvez... seja por isso que você está em nosso navio?"

# game/chapters/chapter4/script/ch4sc9.rpy:1157
translate brazil ch4sc9_0b05834f:

#   mct "She comes off as aloof, but she's much more perceptive than I initially anticipated."
    mct "Ela parece distante, mas é muito mais perspicaz do que eu imaginava inicialmente."

# game/chapters/chapter4/script/ch4sc9.rpy:1159
translate brazil ch4sc9_3ce58d5e:

#   mc "You’re observant."
    mc "Você é observador(a)."

# game/chapters/chapter4/script/ch4sc9.rpy:1161
translate brazil ch4sc9_9fb6a52a:

#   pl "Call it intuition."
    pl "Podemos chamar isso de intuição."

# game/chapters/chapter4/script/ch4sc9.rpy:1163
translate brazil ch4sc9_267e50cc:

#   mc "Well... you've pretty much guessed it."
    mc "Bem... você provavelmente já adivinhou."

# game/chapters/chapter4/script/ch4sc9.rpy:1164
translate brazil ch4sc9_15eafbe3:

#   mc "The reason I'm aboard the Bloody Banshee and heading to Inmortui..."
    mc "O motivo de eu estar a bordo da Bloody Banshee e a caminho de Inmortui..."

# game/chapters/chapter4/script/ch4sc9.rpy:1166
translate brazil ch4sc9_b3d74362:

#   pl "It’s to help someone? Someone you care about?"
    pl "É para ajudar alguém? Alguém de quem você gosta?"

# game/chapters/chapter4/script/ch4sc9.rpy:1168
translate brazil ch4sc9_582e2d1e:

#   mc "Yeah, how did you-"
    mc "Sim, como você..."

# game/chapters/chapter4/script/ch4sc9.rpy:1169
translate brazil ch4sc9_31a4e7a6:

#   mc "Intuition. Right."
    mc "Intuição. Certo."

# game/chapters/chapter4/script/ch4sc9.rpy:1171
translate brazil ch4sc9_1af666ee:

#   pl "You helped Kelly without a second thought, very... masculine."
    pl "Você ajudou a Kelly sem pensar duas vezes, muito... másculo."

# game/chapters/chapter4/script/ch4sc9.rpy:1172
translate brazil ch4sc9_7b2fd321:

#   pl "You're a protector, a provider, that's why you're out here as well, to provide and protect."
    pl "Você é um protetor, um provedor, é por isso que você também está aqui, para prover e proteger."

# game/chapters/chapter4/script/ch4sc9.rpy:1174
translate brazil ch4sc9_16546c74:

#   mc "*Chuckles* I guess you've got me all figured out, huh?"
    mc "*Risos* Acho que você me decifrou completamente, né?"

# game/chapters/chapter4/script/ch4sc9.rpy:1177
translate brazil ch4sc9_6f3b76d1:

#   "Pearl turns and looks directly at you."
    "Pearl se vira e olha diretamente para você."

# game/chapters/chapter4/script/ch4sc9.rpy:1179
translate brazil ch4sc9_6567f586:

#   pl "You’re interesting."
    pl "Você é interessante."

# game/chapters/chapter4/script/ch4sc9.rpy:1180
translate brazil ch4sc9_50e4e894:

#   pl "On first impression, you don't seem like someone who'd go out of his way to help people."
    pl "À primeira vista, você não parece ser alguém que se esforçaria para ajudar as pessoas."

# game/chapters/chapter4/script/ch4sc9.rpy:1181
translate brazil ch4sc9_b49eb05b:

#   pl "And yet, you’re here to help someone you care about."
    pl "E, no entanto, você está aqui para ajudar alguém de quem você gosta."

# game/chapters/chapter4/script/ch4sc9.rpy:1183
translate brazil ch4sc9_a25a735b:

#   pl "..."
    pl "..."

# game/chapters/chapter4/script/ch4sc9.rpy:1185
translate brazil ch4sc9_afcd3957:

#   pl "I like that you helped Kira recover Kelly, you didn't know Kelly, and Kira... well-"
    pl "Gostei que você ajudou a Kira a recuperar a Kelly, você não conhecia a Kelly, e a Kira... bem..."

# game/chapters/chapter4/script/ch4sc9.rpy:1186
translate brazil ch4sc9_a2416a8c:

#   pl "Kira has been... less than friendly to you."
    pl "Kira não tem sido... muito amigável com você."

# game/chapters/chapter4/script/ch4sc9.rpy:1190
translate brazil ch4sc9_b34bf576:

#   pl "You have layers…"
    pl "Você tem camadas…"

# game/chapters/chapter4/script/ch4sc9.rpy:1192
translate brazil ch4sc9_f23870e0:

#   mc "Layers?"
    mc "Camadas?"

# game/chapters/chapter4/script/ch4sc9.rpy:1194
translate brazil ch4sc9_d58a0333:

#   pl "Like an onion!"
    pl "Igual a uma cebola!"

# game/chapters/chapter4/script/ch4sc9.rpy:1196
translate brazil ch4sc9_80a014c2:

#   pl "*Giggles*"
    pl "*Risos*"

# game/chapters/chapter4/script/ch4sc9.rpy:1197
translate brazil ch4sc9_04d39e2d:

#   mc "Great. I’ve always dreamed of being an onion."
    mc "Ótimo. Sempre sonhei em ser uma cebola."

# game/chapters/chapter4/script/ch4sc9.rpy:1199
translate brazil ch4sc9_ed2f8280:

#   pl "A cute onion!"
    pl "Uma cebola fofa!"

# game/chapters/chapter4/script/ch4sc9.rpy:1203
translate brazil ch4sc9_2fb42d8d:

#   pl "[mc], What's your story?"
    pl "[mc] Qual é a sua história?"

# game/chapters/chapter4/script/ch4sc9.rpy:1205
translate brazil ch4sc9_fcbd18e0:

#   mc "*Sigh* ..."
    mc "*Suspirar* ..."

# game/chapters/chapter4/script/ch4sc9.rpy:1206
translate brazil ch4sc9_0b9d98fc:

#   mc "We’re really doing this?"
    mc "Estamos mesmo fazendo isso?"

# game/chapters/chapter4/script/ch4sc9.rpy:1208
translate brazil ch4sc9_c86211d2:

#   pl "Kira says the voyage to Inmortui will take somewhere between one to two moons."
    pl "Kira diz que a viagem para Inmortui levará entre uma e duas luas."

# game/chapters/chapter4/script/ch4sc9.rpy:1209
translate brazil ch4sc9_2a48e8e6:

#   pl "We might as well get to know each other? The ship isn't that big."
    pl "Já que estamos aqui, por que não nos conhecer melhor? O navio não é tão grande assim."

# game/chapters/chapter4/script/ch4sc9.rpy:1211
translate brazil ch4sc9_c8108632:

#   mct "She’s got a point. And she’s certainly friendlier than her sister."
    mct "Ela tem razão. E com certeza é mais simpática que a irmã."

# game/chapters/chapter4/script/ch4sc9.rpy:1212
translate brazil ch4sc9_e831e20b:

#   mc "Alright. I’ll start from the beginning."
    mc "Muito bem. Vou começar do início."

# game/chapters/chapter4/script/ch4sc9.rpy:1216
translate brazil ch4sc9_e1ebe746:

#   pl "Woah! No way. He killed your parents AND he crippled Eliza?"
    pl "Nossa! Não acredito. Ele matou seus pais E deixou a Eliza aleijada?"

# game/chapters/chapter4/script/ch4sc9.rpy:1217
translate brazil ch4sc9_4ffa2bbe:

#   pl "You’ve had to endure so much. Ever since you were a boy..."
    pl "Você teve que suportar tanta coisa. Desde que era menino..."

# game/chapters/chapter4/script/ch4sc9.rpy:1219
translate brazil ch4sc9_1da97fc1:

#   pl "All these scars..."
    pl "Todas essas cicatrizes..."

# game/chapters/chapter4/script/ch4sc9.rpy:1220
translate brazil ch4sc9_1fb1c2aa:

#   pl "They carry such painful memories."
    pl "Eles carregam lembranças muito dolorosas."

# game/chapters/chapter4/script/ch4sc9.rpy:1224
translate brazil ch4sc9_d67fa093:

#   pl "But they are also signs that you are a survivor."
    pl "Mas também são sinais de que você é um sobrevivente."

# game/chapters/chapter4/script/ch4sc9.rpy:1225
translate brazil ch4sc9_9b7a033b:

#   pl "A brave soul who will do anything for those he cares about."
    pl "Uma alma corajosa que fará qualquer coisa por aqueles que ama."

# game/chapters/chapter4/script/ch4sc9.rpy:1227
translate brazil ch4sc9_2ddc8ec4:

#   mc "You’re giving me too much credit. I’ve hurt people too."
    mc "Você está me dando crédito demais. Eu também já magoei pessoas."

# game/chapters/chapter4/script/ch4sc9.rpy:1228
translate brazil ch4sc9_f9fed73e:

#   mc "Most of them were bad, but some of them weren't. Innocents."
    mc "A maioria deles era má, mas alguns não. Inocentes."

# game/chapters/chapter4/script/ch4sc9.rpy:1230
translate brazil ch4sc9_a28a8435:

#   pl "Sounds like you’re carrying around a lot of guilt."
    pl "Parece que você está carregando muita culpa."

# game/chapters/chapter4/script/ch4sc9.rpy:1232
translate brazil ch4sc9_6ae1e0f6:

#   pl "I've hurt a lot of bad people too. And like you..."
    pl "Eu também já magoei muita gente má. E assim como você..."

# game/chapters/chapter4/script/ch4sc9.rpy:1233
translate brazil ch4sc9_a2d38793:

#   pl "Some innocents have also been caught in the crossfire."
    pl "Alguns inocentes também foram atingidos no fogo cruzado."

# game/chapters/chapter4/script/ch4sc9.rpy:1235
translate brazil ch4sc9_e6225cee:

#   pl "It's something we'll carry with us for the rest of our lives."
    pl "É algo que levaremos conosco para o resto de nossas vidas."

# game/chapters/chapter4/script/ch4sc9.rpy:1236
translate brazil ch4sc9_70bc43c1:

#   mc "Rest of our lives, huh?"
    mc "O resto de nossas vidas, hein?"

# game/chapters/chapter4/script/ch4sc9.rpy:1238
translate brazil ch4sc9_185a3ab9:

#   pl "Yeah. Unless you’re a cold blooded killer with no sign of remorse."
    pl "Sim. A menos que você seja um assassino a sangue frio sem qualquer sinal de remorso."

# game/chapters/chapter4/script/ch4sc9.rpy:1239
translate brazil ch4sc9_4de312cf:

#   pl "But then, you wouldn’t be lugging around all the guilt, would you? Besides…"
    pl "Mas aí você não estaria carregando toda essa culpa, estaria? Além disso…"

# game/chapters/chapter4/script/ch4sc9.rpy:1241
translate brazil ch4sc9_e29ff7f3:

#   pl "When I touched your chest just now, I could tell it's definitely not cold blood in your veins..."
    pl "Ao tocar seu peito agora há pouco, percebi que definitivamente não é sangue frio que corre em suas veias..."

# game/chapters/chapter4/script/ch4sc9.rpy:1242
translate brazil ch4sc9_82cb9603:

#   pl "You were surprisingly warm to the touch."
    pl "Você estava surpreendentemente quente ao toque."

# game/chapters/chapter4/script/ch4sc9.rpy:1245
translate brazil ch4sc9_5ecb1f8b:

#   mc "You know, you might have everyone else fooled..."
    mc "Sabe, você pode ter enganado todo mundo..."

# game/chapters/chapter4/script/ch4sc9.rpy:1247
translate brazil ch4sc9_6b3ffa53:

#   mc "But this flirty and dumbed-down version of yourself is clearly a front."
    mc "Mas essa versão sedutora e simplória de você mesma é claramente uma fachada."

# game/chapters/chapter4/script/ch4sc9.rpy:1250
translate brazil ch4sc9_0a84d7d5:

#   pl "Got me all figured out, have you?"
    pl "Você já me decifrou completamente, não é?"

# game/chapters/chapter4/script/ch4sc9.rpy:1252
translate brazil ch4sc9_898625f8:

#   mc "No, far from it."
    mc "Não, longe disso."

# game/chapters/chapter4/script/ch4sc9.rpy:1253
translate brazil ch4sc9_40967b7c:

#   mc "You’re an onion too."
    mc "Você também é uma cebola."

# game/chapters/chapter4/script/ch4sc9.rpy:1255
translate brazil ch4sc9_4a7f8fe8:

#   pl "*Giggles softly* Am I... a cute onion?"
    pl "*Risinhos suaves* Eu sou... uma cebola fofa?"

# game/chapters/chapter4/script/ch4sc9.rpy:1257
translate brazil ch4sc9_f996696d:

#   mc "Very."
    mc "Muito."

# game/chapters/chapter4/script/ch4sc9.rpy:1259
translate brazil ch4sc9_46d3a172:

#   mc "There’s more to you than meets the eye."
    mc "Você é muito mais do que aparenta."

# game/chapters/chapter4/script/ch4sc9.rpy:1261
translate brazil ch4sc9_2bca8c9c:

#   mc "You're wickedly smart, and cunning too."
    mc "Você é incrivelmente inteligente e astuto também."

# game/chapters/chapter4/script/ch4sc9.rpy:1262
translate brazil ch4sc9_221dab27:

#   mc "You mask it very well, so I’m not surprised others don’t catch on."
    mc "Você disfarça muito bem, então não me surpreende que os outros não percebam."

# game/chapters/chapter4/script/ch4sc9.rpy:1264
translate brazil ch4sc9_83a8a016:

#   mc "Obviously, you’re incredibly beautiful."
    mc "Obviamente, você é incrivelmente linda."

# game/chapters/chapter4/script/ch4sc9.rpy:1265
translate brazil ch4sc9_6db7e4ef:

#   mc "I suspect you'd give most princesses a run for their money."
    mc "Acho que você daria trabalho para a maioria das princesas."

# game/chapters/chapter4/script/ch4sc9.rpy:1267
translate brazil ch4sc9_b9ffd632:

#   plt "He needs to stop saying these things!"
    plt "Ele precisa parar de dizer essas coisas!"

# game/chapters/chapter4/script/ch4sc9.rpy:1269
translate brazil ch4sc9_31dced6a:

#   mc "I suppose that’s why you’re so flirty? You can leverage your looks against males."
    mc "Imagino que seja por isso que você é tão paqueradora? Você pode usar sua aparência a seu favor com os homens."

# game/chapters/chapter4/script/ch4sc9.rpy:1270
translate brazil ch4sc9_b42a613b:

#   mc "And since the world of pirates and sailors is dominated by men, any edge you can find against them is useful."
