# game/chapters/chapter4/script/ch4sc10.rpy:10
translate brazil ch4sc10_7dc54cca:

#   "Over the next week, you and Flynn bond with the crew of the Bloody Banshee."
    "Ao longo da próxima semana, você e Flynn criarão laços com a tripulação do Bloody Banshee."

# game/chapters/chapter4/script/ch4sc10.rpy:156
translate brazil ch4sc10_ad87bbf5:

#   kl "{b}*Shouts* Kira! We’re here!{/b}"
    kl "{b}*Grita* Kira! Chegamos!{/b}"

# game/chapters/chapter4/script/ch4sc10.rpy:159
translate brazil ch4sc10_ad344062:

#   ki "Finally!"
    ki "Finalmente!"

# game/chapters/chapter4/script/ch4sc10.rpy:160
translate brazil ch4sc10_200bb7f9:

#   ki "Once we're docked, you're in charge of stocking the ship with supplies!"
    ki "Assim que atracarmos, você ficará responsável por abastecer o navio com suprimentos!"

# game/chapters/chapter4/script/ch4sc10.rpy:162
translate brazil ch4sc10_fef19042:

#   mc "Did Kelly just announce we’re here?"
    mc "A Kelly acabou de anunciar que chegamos?"

# game/chapters/chapter4/script/ch4sc10.rpy:163
translate brazil ch4sc10_ad06ca6b:

#   mc "I thought it would take more than a week to reach Inmortui?"
    mc "Pensei que demoraria mais de uma semana para chegar a Inmortui?"

# game/chapters/chapter4/script/ch4sc10.rpy:165
translate brazil ch4sc10_a8cb7ab8:

#   ki "*Scoffs* We’re not at Inmortui."
    ki "*Risos* Não estamos em Inmortui."

# game/chapters/chapter4/script/ch4sc10.rpy:166
translate brazil ch4sc10_d4a473e1:

#   ki "We’re taking a little detour."
    ki "Vamos fazer um pequeno desvio."

# game/chapters/chapter4/script/ch4sc10.rpy:168
translate brazil ch4sc10_535b1449:

#   mc "What the fuck, Kira? That wasn’t our deal."
    mc "Que merda, Kira? Não era esse o nosso acordo."

# game/chapters/chapter4/script/ch4sc10.rpy:169
translate brazil ch4sc10_e8ecedc8:

#   mc "I don’t have time for this shit!"
    mc "Não tenho tempo para essa merda!"

# game/chapters/chapter4/script/ch4sc10.rpy:171
translate brazil ch4sc10_32c7fb12:

#   ki "Boohoo! 'Cause we’re here now and I’m taking you to meet someone."
    ki "Buááá! Porque já estamos aqui e eu vou te levar para conhecer alguém."

# game/chapters/chapter4/script/ch4sc10.rpy:173
translate brazil ch4sc10_75a4958f:

#   mc "Who?!"
    mc "Quem?!"

# game/chapters/chapter4/script/ch4sc10.rpy:175
translate brazil ch4sc10_e72e129a:

#   ki "My fath- The pirate king. Captain Blackheart."
    ki "Meu pai... O rei dos piratas. Capitão Coração Negro."

# game/chapters/chapter4/script/ch4sc10.rpy:176
translate brazil ch4sc10_0f30b843:

#   ki "You'd better tell him what you’re after. He isn’t known for his hospitality or his patience."
    ki "É melhor você dizer a ele o que deseja. Ele não é conhecido por sua hospitalidade ou paciência."

# game/chapters/chapter4/script/ch4sc10.rpy:178
translate brazil ch4sc10_e382d37b:

#   mc "Where the fuck are we, Kira?"
    mc "Onde diabos estamos, Kira?"

# game/chapters/chapter4/script/ch4sc10.rpy:180
translate brazil ch4sc10_d08075e0:

#   ki "Here it is!"
    ki "Aqui está!"

# game/chapters/chapter4/script/ch4sc10.rpy:183
translate brazil ch4sc10_1583bd27:

#   ki "{b}Looter’s Bay.{/b}"
    ki "{b}Baía dos Saqueadores.{/b}"

# game/chapters/chapter4/script/ch4sc10.rpy:186
translate brazil ch4sc10_90371172:

#   ki "Home..."
    ki "Lar..."

# game/chapters/chapter4/script/ch4sc10.rpy:187
translate brazil ch4sc10_84118c6c:

#   mct "*Exhales deeply* Stay calm... just a little detour... if I kill them now, I won't be able to reach Inmortui."
    mct "*Exala profundamente* Mantenha a calma... apenas um pequeno desvio... se eu os matar agora, não conseguirei chegar a Inmortui."

