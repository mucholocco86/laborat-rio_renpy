# ARQUIVO: game/chapters/chapter4/script/ch4sc11.rpy DIALOGOS: 395


# game/chapters/chapter4/script/ch4sc11.rpy:8
translate brazil ch4sc11_23930979:

#   "You and Kira proceed to row into Looter's Bay, Kira hasn't looked at you once."
    "Você e Kira seguem remando em direção à Baía dos Saqueadores, e Kira não olhou para você nenhuma vez."

# game/chapters/chapter4/script/ch4sc11.rpy:9
translate brazil ch4sc11_89530537:

#   mc "Kira, I don’t know what you hope to achieve by doing this."
    mc "Kira, não sei o que você espera conseguir fazendo isso."

# game/chapters/chapter4/script/ch4sc11.rpy:10
translate brazil ch4sc11_61d1f2b7:

#   mc "I just need you to drop me off at Inmortui as we agreed."
    mc "Só preciso que você me deixe em Inmortui, como combinamos."

# game/chapters/chapter4/script/ch4sc11.rpy:12
translate brazil ch4sc11_af297fb0:

#   "Kira still isn't able to look at you, she clearly feels somewhat guilty of her decision to bring you here."
    "Kira ainda não consegue olhar para você, ela claramente se sente um pouco culpada por ter te trazido aqui."

# game/chapters/chapter4/script/ch4sc11.rpy:13
translate brazil ch4sc11_d37f035c:

#   ki "..."
    ki "..."

# game/chapters/chapter4/script/ch4sc11.rpy:15
translate brazil ch4sc11_71c5c2cc:

#   ki "Look, you’re clearly going after something valuable."
    ki "Olha, você está claramente buscando algo valioso."

# game/chapters/chapter4/script/ch4sc11.rpy:16
translate brazil ch4sc11_60910f09:

#   ki "Nobody just 'goes to Inmortui.' Even the most seasoned sailors avoid that place like the plague."
    ki "Ninguém simplesmente 'vai a Inmortui'. Até os marinheiros mais experientes evitam aquele lugar como a peste."

# game/chapters/chapter4/script/ch4sc11.rpy:19
translate brazil ch4sc11_f9d1a3e8:

#   kit "He just needs to tell father what he's after and we can all get out of here, nobody gets hurt."
    kit "Ele só precisa dizer ao pai o que quer e todos nós podemos sair daqui, ninguém se machuca."

# game/chapters/chapter4/script/ch4sc11.rpy:20
translate brazil ch4sc11_3b3b737d:

#   mc "Kira, do you really think betraying me and taking me to your father will make me tell you anything of value?"
    mc "Kira, você realmente acha que me trair e me levar até seu pai fará com que eu lhe diga algo de valor?"

# game/chapters/chapter4/script/ch4sc11.rpy:22
translate brazil ch4sc11_dbfbc98f:

#   ki "He’s not- I never told you that!"
    ki "Ele não é... Eu nunca te disse isso!"

# game/chapters/chapter4/script/ch4sc11.rpy:24
translate brazil ch4sc11_d9633548:

#   mc "It wasn’t that hard to figure out."
    mc "Não foi tão difícil de descobrir."

# game/chapters/chapter4/script/ch4sc11.rpy:26
translate brazil ch4sc11_52b4a5bd:

#   ki "It doesn’t matter! Nothing I can say or do will be able to protect you from him."
    ki "Não importa! Nada que eu diga ou faça será capaz de protegê-la dele."

# game/chapters/chapter4/script/ch4sc11.rpy:27
translate brazil ch4sc11_125d2710:

#   ki "So just tell him everything you know! Otherwise he's going to hurt you, I-I don't want that! So just tell him."
    ki "Então, conte tudo o que você sabe para ele! Senão, ele vai te magoar, e eu não quero isso! Então, conte tudo."

# game/chapters/chapter4/script/ch4sc11.rpy:29
translate brazil ch4sc11_e48320b5:

#   mc "Congratulations, Kira."
    mc "Parabéns, Kira."

# game/chapters/chapter4/script/ch4sc11.rpy:31
translate brazil ch4sc11_fc9b7b5c:

#   mc "You just broke my trust in you."
    mc "Você acabou de quebrar a minha confiança em você."

# game/chapters/chapter4/script/ch4sc11.rpy:32
translate brazil ch4sc11_5f10d6ef:

#   "Kira stiffens up, clearly she's surprised by your words."
    "Kira se enrijece, claramente surpresa com suas palavras."

# game/chapters/chapter4/script/ch4sc11.rpy:33
translate brazil ch4sc11_d3aa8940:

#   mc "That might not seem like much to you. But is that how you repay my saving Kelly?"
    mc "Isso pode não parecer muito para você. Mas é assim que você me retribui por ter salvado a Kelly?"

# game/chapters/chapter4/script/ch4sc11.rpy:34
translate brazil ch4sc11_fc8b8594:

#   mc "Over the past week, I thought we'd developed a rapport. Not a friendship, as such."
    mc "Ao longo da última semana, achei que tínhamos desenvolvido uma afinidade. Não uma amizade propriamente dita."

# game/chapters/chapter4/script/ch4sc11.rpy:35
translate brazil ch4sc11_1775f171:

#   mc "But we had an understanding of each other, at least. A mutual respect."
    mc "Mas pelo menos nos entendíamos. Tínhamos respeito mútuo."

# game/chapters/chapter4/script/ch4sc11.rpy:36
translate brazil ch4sc11_c5d12264:

#   mc "Hell, had it been another week, we'd have become friends I dare say."
    mc "Puxa, se tivesse sido mais uma semana, eu diria que teríamos nos tornado amigos."

# game/chapters/chapter4/script/ch4sc11.rpy:38
translate brazil ch4sc11_64826b6f:

#   kit "We did... we do! We are friends!"
    kit "Sim, nós fazemos... fazemos sim! Somos amigos!"

# game/chapters/chapter4/script/ch4sc11.rpy:39
translate brazil ch4sc11_3cce840a:

#   kit "Fuck, Kira. Nicely done!"
    kit "Caramba, Kira. Muito bem!"

# game/chapters/chapter4/script/ch4sc11.rpy:40
translate brazil ch4sc11_a918c2ab:

#   kit "But there’s no going back now that we’re here... this is protocol, he doesn't get it..."
    kit "Mas agora que chegamos aqui, não há como voltar atrás... isto é o protocolo, ele não entende..."

# game/chapters/chapter4/script/ch4sc11.rpy:41
translate brazil ch4sc11_3389b432:

#   kit "Nobody breaks fathers rules and remains unhurt, even us!"
    kit "Ninguém quebra as regras do pai e sai ileso, nem mesmo nós!"

# game/chapters/chapter4/script/ch4sc11.rpy:43
translate brazil ch4sc11_b52b2c3f:

#   ki "[mc]... I do respect you-"
    ki "[mc]... Eu te respeito..."

# game/chapters/chapter4/script/ch4sc11.rpy:46
translate brazil ch4sc11_91f2a4e9:

#   mc "{b}Shut it, Kira!{/b}"
    mc "{b}Cala a boca, Kira!{/b}"

# game/chapters/chapter4/script/ch4sc11.rpy:47
translate brazil ch4sc11_82f106c9:

#   mc "{b}Look at me!{/b} Do you think I’m messing around?"
    mc "{b}Olhe para mim!{/b} Você acha que estou brincando?"

# game/chapters/chapter4/script/ch4sc11.rpy:48
translate brazil ch4sc11_b7a666d1:

#   mc "You want to know so badly what I’m after on Inmortui? Fine."
    mc "Você quer tanto saber o que eu procuro no Inmortui? Ótimo."

# game/chapters/chapter4/script/ch4sc11.rpy:50
translate brazil ch4sc11_393d86db:

#   mc "I’m looking for an artifact... an ancient relic in the shape of a chalice."
    mc "Estou à procura de um artefato... uma relíquia antiga em forma de cálice."

# game/chapters/chapter4/script/ch4sc11.rpy:51
translate brazil ch4sc11_0bd15bb0:

#   mc "Supposedly, it was blessed or created by one of the seven divines called {b}Lucid{/b}."
    mc "Supostamente, foi abençoado ou criado por um dos sete deuses chamados {b} Lúcido{/b}."

# game/chapters/chapter4/script/ch4sc11.rpy:52
translate brazil ch4sc11_72fef0cd:

#   mc "I need to use it to heal someone close to me who has been hurt badly."
    mc "Preciso usá-lo para curar alguém próximo a mim que foi muito ferido."

# game/chapters/chapter4/script/ch4sc11.rpy:54
translate brazil ch4sc11_c21fc8c6:

#   mc "So, let me be very clear about this."
    mc "Então, deixe-me ser bem claro sobre isso."

# game/chapters/chapter4/script/ch4sc11.rpy:56
translate brazil ch4sc11_cf7cec71:

#   mc "If you, your father, or anyone else gets in my way..."
    mc "Se você, seu pai ou qualquer outra pessoa entrar no meu caminho..."

# game/chapters/chapter4/script/ch4sc11.rpy:57
translate brazil ch4sc11_60b10d5e:

#   mc "I will kill them, and everyone else here."
    mc "Vou matar eles e todos os outros aqui."

# game/chapters/chapter4/script/ch4sc11.rpy:58
translate brazil ch4sc11_d5e533b7:

#   mc "I will burn Looter’s Bay to the ground and erase it from existence."
    mc "Vou reduzir a Baía dos Saqueadores a cinzas e apagá-la da existência."

# game/chapters/chapter4/script/ch4sc11.rpy:60
translate brazil ch4sc11_0aaa6653:

#   ki "*Stuttering* Wha-What are y-you!?"
    ki "*Gaguejando* O-O que v-você está fazendo!?"

# game/chapters/chapter4/script/ch4sc11.rpy:61
translate brazil ch4sc11_b7542fa1:

#   ki "Your eyes!"
    ki "Seus olhos!"

# game/chapters/chapter4/script/ch4sc11.rpy:63
translate brazil ch4sc11_5c879443:

#   mc "Do we understand each other?"
    mc "Nós nos entendemos?"

# game/chapters/chapter4/script/ch4sc11.rpy:65
translate brazil ch4sc11_150c5e86:

#   ki "Y-Yes! We understand each other."
    ki "S-Sim! Nós nos entendemos."

# game/chapters/chapter4/script/ch4sc11.rpy:67
translate brazil ch4sc11_acecdcdf:

#   ki "Its not like I want this either! But he- 'She stops herself'"
    ki "Não é como se eu também quisesse isso! Mas ele... 'Ela se interrompe'"

# game/chapters/chapter4/script/ch4sc11.rpy:68
translate brazil ch4sc11_2392c84b:

#   ki "Arghh... it doesn’t matter."
    ki "Arghh... não importa."

# game/chapters/chapter4/script/ch4sc11.rpy:70
translate brazil ch4sc11_b9ba33ad:

#   mc "You want his approval."
    mc "Você quer a aprovação dele."

# game/chapters/chapter4/script/ch4sc11.rpy:71
translate brazil ch4sc11_e4217906:

#   mc "Since Pearl usually acts so carefree and spoiled, I'm guessing that she must be the favorite."
    mc "Como Pearl geralmente age de forma tão despreocupada e mimada, imagino que ela deva ser a favorita."

# game/chapters/chapter4/script/ch4sc11.rpy:73
translate brazil ch4sc11_32a69695:

#   ki "{b}NO!{/b} I... how did you?"
    ki "{b}NÃO!{/b} Eu... como você fez isso?"

# game/chapters/chapter4/script/ch4sc11.rpy:77
translate brazil ch4sc11_35fb8b34:

#   ki "*Sigh* Just once, you know... just once, I'd like him to notice me and my achievements."
    ki "*Suspiro* Só uma vez, sabe... só uma vez, eu gostaria que ele me notasse e reconhecesse minhas conquistas."

# game/chapters/chapter4/script/ch4sc11.rpy:78
translate brazil ch4sc11_175e8f32:

#   ki "I’m always busting my ass and managing the crew."
    ki "Estou sempre me esforçando ao máximo e gerenciando a equipe."

# game/chapters/chapter4/script/ch4sc11.rpy:79
translate brazil ch4sc11_f00388c1:

#   ki "Keeping that scumbag, Louie, in line... ensuring that we have marks to plunder..."
    ki "Mantendo aquele canalha do Louie na linha... garantindo que tenhamos vítimas para explorar..."

# game/chapters/chapter4/script/ch4sc11.rpy:81
translate brazil ch4sc11_cfd3649e:

#   ki "And do I ever get a pat on the back in return?"
    ki "E será que alguma vez recebo um tapinha nas costas em troca?"

# game/chapters/chapter4/script/ch4sc11.rpy:82
translate brazil ch4sc11_b35eed9b:

#   ki "Even a ‘Well done, Kira. I’m proud of you’ would suffice."
    ki "Até mesmo um \"Muito bem, Kira. Estou orgulhoso de você\" seria suficiente."

# game/chapters/chapter4/script/ch4sc11.rpy:84
translate brazil ch4sc11_5806c706:

#   ki "By the sea! Listen to me whining like a little girl. Sorry."
    ki "À beira-mar! Escuta só eu reclamando como uma menininha. Desculpa."

# game/chapters/chapter4/script/ch4sc11.rpy:85
translate brazil ch4sc11_2f637172:

#   ki "Let’s just get this over with."
    ki "Vamos acabar logo com isso."

# game/chapters/chapter4/script/ch4sc11.rpy:87
translate brazil ch4sc11_4cb006a7:

#   mc "I get it…"
    mc "Entendo…"

# game/chapters/chapter4/script/ch4sc11.rpy:88
translate brazil ch4sc11_d56455f0:

#   mct "Maybe it could be worth showing her some good faith? She does seem regretful of her actions."
    mct "Talvez valha a pena demonstrar boa vontade para com ela? Ela parece arrependida de suas ações."

# game/chapters/chapter4/script/ch4sc11.rpy:93
translate brazil ch4sc11_ee8fbe26:

#   mc "When I was ten summers old… My parents were murdered."
    mc "Quando eu tinha dez anos, durante o verão… Meus pais foram assassinados."

# game/chapters/chapter4/script/ch4sc11.rpy:95
translate brazil ch4sc11_cb58c56a:

#   mc "I... I was the one who found them."
    mc "Eu... eu fui quem os encontrou."

# game/chapters/chapter4/script/ch4sc11.rpy:98
translate brazil ch4sc11_6e8e818f:

#   mc "Their bodies were cold to the touch..."
    mc "Seus corpos estavam frios ao toque..."

# game/chapters/chapter4/script/ch4sc11.rpy:99
translate brazil ch4sc11_ee4aed4d:

#   mc "There was blood all over them. Lots of wounds and deep cuts."
    mc "Estavam cobertos de sangue. Muitas feridas e cortes profundos."

# game/chapters/chapter4/script/ch4sc11.rpy:100
translate brazil ch4sc11_afa9ad37:

#   mc "I was lucky a man appeared in the dark of night and took me with him."
    mc "Tive sorte de um homem aparecer na escuridão da noite e me levar com ele."

# game/chapters/chapter4/script/ch4sc11.rpy:101
translate brazil ch4sc11_a7ffbf34:

#   mc "He became something of a father figure to me, over the years."
    mc "Com o passar dos anos, ele se tornou uma espécie de figura paterna para mim."

# game/chapters/chapter4/script/ch4sc11.rpy:103
translate brazil ch4sc11_e4477e6c:

#   mc "But he wasn’t one to give praise freely, either."
    mc "Mas ele também não era do tipo que distribuía elogios facilmente."

# game/chapters/chapter4/script/ch4sc11.rpy:104
translate brazil ch4sc11_b5644785:

#   mc "So, yeah. I know what it’s like, Kira. That constant battle for approval."
    mc "Sim, eu sei como é, Kira. Essa constante batalha por aprovação."

# game/chapters/chapter4/script/ch4sc11.rpy:106
translate brazil ch4sc11_ebe0648a:

#   ki "[mc]... I-"
    ki "[mc]... EU-"

# game/chapters/chapter4/script/ch4sc11.rpy:107
translate brazil ch4sc11_c1aefaf4:

#   ki "Thank you…"
    ki "Obrigado…"

# game/chapters/chapter4/script/ch4sc11.rpy:109
translate brazil ch4sc11_a6b0b818:

#   kit "Fuck. Experiencing that at the age of ten??"
    kit "Puta merda. Passar por isso aos dez anos de idade??"

# game/chapters/chapter4/script/ch4sc11.rpy:110
translate brazil ch4sc11_6716b4ee:

#   kit "I... I just want to hug him!"
    kit "Eu... eu só quero abraçá-lo!"

# game/chapters/chapter4/script/ch4sc11.rpy:111
translate brazil ch4sc11_5479a2bf:

#   "Kira is surprised that you trusted her with your past, her trust increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Kira ficou surpresa por você ter confiado a ela seu passado, e a confiança dela aumentou ainda mais. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc11.rpy:113
translate brazil ch4sc11_b084abea:

#   kit "*Sigh* You really messed up this time, Kira."
    kit "*Suspiro* Dessa vez você realmente fez besteira, Kira."

# game/chapters/chapter4/script/ch4sc11.rpy:114
translate brazil ch4sc11_7f1194da:

#   kit "The first man I ever befriend and I go behind his back... fuck! I hate this!"
    kit "O primeiro homem com quem fiz amizade e eu o traí pelas costas... droga! Odeio isso!"

# game/chapters/chapter4/script/ch4sc11.rpy:119
translate brazil ch4sc11_195fe37c:

#   "You keep your past to yourself and soon arrive at the docks."
    "Você guarda seu passado para si e logo chega às docas."

# game/chapters/chapter4/script/ch4sc11.rpy:123
translate brazil ch4sc11_1b719771:

#   ki "What the hell are you doing?"
    ki "Que diabos você está fazendo?"

# game/chapters/chapter4/script/ch4sc11.rpy:124
translate brazil ch4sc11_9b0b59ea:

#   mc "What does it look like I’m doing? I'm helping you up."
    mc "O que parece que estou fazendo? Estou te ajudando a levantar."

# game/chapters/chapter4/script/ch4sc11.rpy:126
translate brazil ch4sc11_d433ce15:

#   ki "*Raises voice* I don’t need your help!"
    ki "*Eleva a voz* Eu não preciso da sua ajuda!"

# game/chapters/chapter4/script/ch4sc11.rpy:127
translate brazil ch4sc11_7ecc8a74:

#   ki "I’m more than capable of handling myself."
    ki "Sou mais do que capaz de me virar sozinho."

# game/chapters/chapter4/script/ch4sc11.rpy:128
translate brazil ch4sc11_b2a4d798:

#   mc "Go on then."
    mc "Então vá em frente."

# game/chapters/chapter4/script/ch4sc11.rpy:130
translate brazil ch4sc11_cc57ca41:

#   ki "You really think I can’t do it?"
    ki "Você acha mesmo que eu não consigo?"

# game/chapters/chapter4/script/ch4sc11.rpy:131
translate brazil ch4sc11_044f02fc:

#   ki "Typical man! Always underestimating women!"
    ki "Típico homem! Sempre subestimando as mulheres!"

# game/chapters/chapter4/script/ch4sc11.rpy:133
translate brazil ch4sc11_221f529a:

#   kit "Hah! Does he really think I can’t climb a silly dock?"
    kit "Hah! Ele realmente acha que eu não consigo subir num cais idiota?"

# game/chapters/chapter4/script/ch4sc11.rpy:134
translate brazil ch4sc11_0f8c7079:

#   kit "He'll be eating barnacles for a week!"
    kit "Ele vai comer cracas durante uma semana!"

# game/chapters/chapter4/script/ch4sc11.rpy:137
translate brazil ch4sc11_c6b3f19b:

#   kit "I’ve done this a thousand times…"
    kit "Já fiz isso mil vezes…"

# game/chapters/chapter4/script/ch4sc11.rpy:139
translate brazil ch4sc11_9e343304:

#   ki "Aha! Told you it was easy!"
    ki "Ahá! Eu disse que era fácil!"

# game/chapters/chapter4/script/ch4sc11.rpy:140
translate brazil ch4sc11_04edd38e:

#   ki "And you thought I needed help! Pffft!"
    ki "E você achou que eu precisava de ajuda! Pffft!"

# game/chapters/chapter4/script/ch4sc11.rpy:141
translate brazil ch4sc11_c6f04fcd:

#   "Amidst her boasting, her foot slips."
    "Em meio à sua arrogância, ela escorrega."

# game/chapters/chapter4/script/ch4sc11.rpy:143
translate brazil ch4sc11_7d23b620:

#   ki "Huh?? {b}Oouuhhoh!{/b}"
    ki "Huh?? {b} Oouuhhoh!{/b}"

# game/chapters/chapter4/script/ch4sc11.rpy:147
translate brazil ch4sc11_f023f031:

#   ki "{b}*Screams* Aaiiiiihh!{/b}"
    ki "{b}*Gritos* Aiiiiiihh!{/b}"

# game/chapters/chapter4/script/ch4sc11.rpy:154
translate brazil ch4sc11_c4d5f313:

#   mc "Don’t worry, I’ve got you."
    mc "Não se preocupe, eu estou aqui para você."

# game/chapters/chapter4/script/ch4sc11.rpy:155
translate brazil ch4sc11_2d3e5fab:

#   ki "Don’t let go!"
    ki "Não solte!"

# game/chapters/chapter4/script/ch4sc11.rpy:158
translate brazil ch4sc11_27bb7259:

#   mc "Say it."
    mc "Diga isso."

# game/chapters/chapter4/script/ch4sc11.rpy:160
translate brazil ch4sc11_d1eb60fc:

#   ki "{b}*Shouting* S-Say what?!{/b}"
    ki "{b}*Gritando* D-Diga o quê?!{/b}"

# game/chapters/chapter4/script/ch4sc11.rpy:161
translate brazil ch4sc11_d34ca8d2:

#   ki "Just pull me up already!"
    ki "Me puxa logo!"

# game/chapters/chapter4/script/ch4sc11.rpy:163
translate brazil ch4sc11_0deec30a:

#   mc "Aren’t you going to say please?"
    mc "Você não vai dizer \"por favor\"?"

# game/chapters/chapter4/script/ch4sc11.rpy:165
translate brazil ch4sc11_c5e1158b:

#   ki "What?! You fucker!"
    ki "O quê?! Seu filho da puta!"

# game/chapters/chapter4/script/ch4sc11.rpy:166
translate brazil ch4sc11_0420e835:

#   ki "I’m going to kill you!!"
    ki "Vou te matar!!"

# game/chapters/chapter4/script/ch4sc11.rpy:168
translate brazil ch4sc11_816e630b:

#   "You loosen your grip."
    "Você afrouxa o aperto."

# game/chapters/chapter4/script/ch4sc11.rpy:170
translate brazil ch4sc11_d004eb6f:

#   ki "{b}AaaiiHhh!!{/b}"
    ki "{b}AaaiiHhh!!{/b}"

# game/chapters/chapter4/script/ch4sc11.rpy:171
translate brazil ch4sc11_fdb185cf:

#   ki "F-Fuck! Please!"
    ki "P-Porra! Por favor!"

# game/chapters/chapter4/script/ch4sc11.rpy:172
translate brazil ch4sc11_0ba8744d:

#   ki "Please pull me up!"
    ki "Por favor, me ajude a subir!"

# game/chapters/chapter4/script/ch4sc11.rpy:173
translate brazil ch4sc11_f1c0804a:

#   "In one swift motion, you pull her up effortlessly, as if she weighed nothing."
    "Num movimento rápido, você a levanta sem esforço, como se ela não pesasse nada."

# game/chapters/chapter4/script/ch4sc11.rpy:175
translate brazil ch4sc11_ec7d8b81:

#   "But she clings too tightly in her desperation, and you both tumble to the dock."
    "Mas, em seu desespero, ela se agarra com tanta força que vocês dois caem no cais."

