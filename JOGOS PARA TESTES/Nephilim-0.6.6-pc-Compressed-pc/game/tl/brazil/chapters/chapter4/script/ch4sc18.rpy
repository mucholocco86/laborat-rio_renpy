# ARQUIVO: game/chapters/chapter4/script/ch4sc18.rpy DIALOGOS: 326


# game/chapters/chapter4/script/ch4sc18.rpy:9
translate brazil ch4sc18_4676772d:

#   al "Hey, Eliza."
    al "Olá, Eliza."

# game/chapters/chapter4/script/ch4sc18.rpy:11
translate brazil ch4sc18_e00acfcc:

#   el "Alice! It’s been a while since I’ve seen you."
    el "Alice! Faz tempo que não te vejo."

# game/chapters/chapter4/script/ch4sc18.rpy:13
translate brazil ch4sc18_34d6a374:

#   al "Sorry... I’ve just been so busy over at the Academy."
    al "Desculpe... tenho estado muito ocupado na Academia."

# game/chapters/chapter4/script/ch4sc18.rpy:14
translate brazil ch4sc18_98b966db:

#   al "Got room for one more?"
    al "Tem espaço para mais um?"

# game/chapters/chapter4/script/ch4sc18.rpy:16
translate brazil ch4sc18_3deca152:

#   el "Always!"
    el "Sempre!"

# game/chapters/chapter4/script/ch4sc18.rpy:17
translate brazil ch4sc18_1388bad8:

#   el "I’m just waiting for Sylph to finish up with one of our new recruits."
    el "Estou apenas esperando Sylph terminar com um dos nossos novos recrutas."

# game/chapters/chapter4/script/ch4sc18.rpy:19
translate brazil ch4sc18_f1032a10:

#   al "New recruit? Have things been going well here?"
    al "Novo recruta? As coisas estão indo bem por aqui?"

# game/chapters/chapter4/script/ch4sc18.rpy:21
translate brazil ch4sc18_68c59fc6:

#   el "Yeah, his name is Milton and I owed him a favor. I kind of got him sacked from his old job..."
    el "Sim, o nome dele é Milton e eu lhe devia um favor. Eu meio que fiz com que ele fosse demitido do antigo emprego..."

# game/chapters/chapter4/script/ch4sc18.rpy:22
translate brazil ch4sc18_51dfbfd6:

#   al "Eliza! That’s terrible. What happened?"
    al "Eliza! Que terrível! O que aconteceu?"

# game/chapters/chapter4/script/ch4sc18.rpy:23
translate brazil ch4sc18_04d9c346:

#   el "He let me and [mc] inside the gates when we first arrived here. We were supposed to have a city-pass..."
    el "Ele me deixou e [mc] Logo que chegamos, estávamos dentro dos portões. Deveríamos ter um passe da cidade..."

# game/chapters/chapter4/script/ch4sc18.rpy:24
translate brazil ch4sc18_98e6a047:

#   el "But [mc] convinced him to let us in as long as we'd put in a word for him at the guild."
    el "Mas [mc] Nós o convencemos a nos deixar entrar, contanto que falássemos por ele na guilda."

# game/chapters/chapter4/script/ch4sc18.rpy:25
translate brazil ch4sc18_6a9a91bc:

#   al "Maybe that's why there weren't any guards at the gates when we arrived at the city."
    al "Talvez seja por isso que não havia guardas nos portões quando chegamos à cidade."

# game/chapters/chapter4/script/ch4sc18.rpy:26
translate brazil ch4sc18_e729764d:

#   al "Hmmm..."
    al "Hmmm..."

# game/chapters/chapter4/script/ch4sc18.rpy:28
translate brazil ch4sc18_426269f6:

#   al "Easy! Blame it on [mc]!"
    al "Fácil! Culpe o [mc]!"

# game/chapters/chapter4/script/ch4sc18.rpy:29
translate brazil ch4sc18_ac7f7649:

#   el "*Snickers* Is that what you did when you two were younger?"
    el "*Risos* Era isso que vocês faziam quando eram mais jovens?"

# game/chapters/chapter4/script/ch4sc18.rpy:31
translate brazil ch4sc18_cd0d6712:

#   al "Yeah. Nobody believed a cute little village girl would be the cause of any trouble."
    al "Sim. Ninguém acreditava que uma garotinha bonitinha da aldeia pudesse causar problemas."

# game/chapters/chapter4/script/ch4sc18.rpy:32
translate brazil ch4sc18_14ddab0c:

#   al "Although, it was mostly Flynn who ended up getting the blame. He was always thinking up crazy things to do..."
    al "Embora, no fim das contas, a culpa tenha recaído principalmente sobre Flynn. Ele sempre inventava coisas malucas para fazer..."

# game/chapters/chapter4/script/ch4sc18.rpy:34
translate brazil ch4sc18_b09eb14c:

#   el "Now that, I believe. I wish I could’ve known you guys when we were younger..."
    el "Agora sim, eu acredito. Gostaria de ter conhecido vocês quando éramos mais jovens..."

# game/chapters/chapter4/script/ch4sc18.rpy:35
translate brazil ch4sc18_22995d0f:

#   el "My life would’ve been so different..."
    el "Minha vida teria sido tão diferente..."

# game/chapters/chapter4/script/ch4sc18.rpy:37
translate brazil ch4sc18_911935e7:

#   al "You would’ve fit right in. Just like you do now."
    al "Você teria se encaixado perfeitamente. Assim como agora."

# game/chapters/chapter4/script/ch4sc18.rpy:38
translate brazil ch4sc18_dba7ecf9:

#   al "To be honest with you, when I first saw you with [mc] back in Riverside, I felt jealous..."
    al "Para ser sincera, quando te vi pela primeira vez com [mc] De volta a Riverside, eu senti inveja..."

# game/chapters/chapter4/script/ch4sc18.rpy:40
translate brazil ch4sc18_5625b4e3:

#   el "Jealous? Why?"
    el "Com ciúmes? Por quê?"

# game/chapters/chapter4/script/ch4sc18.rpy:42
translate brazil ch4sc18_8ff86740:

#   al "Because it was obvious how strong your bond was, even if you hadn’t known each other for long back then."
    al "Porque era óbvio o quão forte era o vínculo entre vocês, mesmo que não se conhecessem há muito tempo naquela época."

# game/chapters/chapter4/script/ch4sc18.rpy:43
translate brazil ch4sc18_ce006822:

#   al "It kind of reminded me of when I was the one he was close with."
    al "Isso me lembrou um pouco de quando eu era a pessoa com quem ele tinha mais proximidade."

# game/chapters/chapter4/script/ch4sc18.rpy:44
translate brazil ch4sc18_5285e77e:

#   al "I felt like I'd been replaced. I know it’s not how it is, but that's how I felt in the moment."
    al "Senti como se tivesse sido substituído. Sei que não é assim que as coisas são, mas foi assim que me senti naquele momento."

# game/chapters/chapter4/script/ch4sc18.rpy:46
translate brazil ch4sc18_c70ebb5c:

#   el "Alice... I’m sorry."
    el "Alice... Me desculpe."

# game/chapters/chapter4/script/ch4sc18.rpy:47
translate brazil ch4sc18_b6e2aeb0:

#   el "I don’t want you to feel that way."
    el "Não quero que você se sinta assim."

# game/chapters/chapter4/script/ch4sc18.rpy:49
translate brazil ch4sc18_118369cc:

#   al "I don’t. Not anymore. Now I just want [mc] to be happy. And I want to support him however I can."
    al "Não. Não mais. Agora eu só quero [mc] Para ser feliz. E quero apoiá-lo de todas as maneiras possíveis."

# game/chapters/chapter4/script/ch4sc18.rpy:51
translate brazil ch4sc18_dae8d94d:

#   el "Is that why you've buried yourself in your studies?"
    el "É por isso que você se dedicou tanto aos estudos?"

# game/chapters/chapter4/script/ch4sc18.rpy:52
translate brazil ch4sc18_c1af644a:

#   el "To find a way to help?"
    el "Para encontrar uma forma de ajudar?"

# game/chapters/chapter4/script/ch4sc18.rpy:54
translate brazil ch4sc18_f32a308c:

#   al "Yeah... I want to make myself useful, I don’t have any combat experience or magical talents."
    al "Sim... quero me tornar útil, não tenho nenhuma experiência em combate nem talentos mágicos."

# game/chapters/chapter4/script/ch4sc18.rpy:55
translate brazil ch4sc18_78d58526:

#   al "But alchemy... it can be learned. It can be studied."
    al "Mas a alquimia... pode ser aprendida. Pode ser estudada."

# game/chapters/chapter4/script/ch4sc18.rpy:56
translate brazil ch4sc18_4b2eb72f:

#   al "So that’s what I intend to do. Until I can brew potions and elixirs for all situations."
    al "Então é isso que pretendo fazer. Até que eu consiga preparar poções e elixires para todas as situações."

# game/chapters/chapter4/script/ch4sc18.rpy:58
translate brazil ch4sc18_5d9faffe:

#   el "That’s incredible of you!"
    el "Isso é incrível da sua parte!"

# game/chapters/chapter4/script/ch4sc18.rpy:59
translate brazil ch4sc18_98dc813a:

#   el "You’ve really found your purpose after arriving here..."
    el "Você realmente encontrou seu propósito depois de chegar aqui..."

# game/chapters/chapter4/script/ch4sc18.rpy:61
translate brazil ch4sc18_21ccbd3b:

#   al "Don’t act like you haven’t. I’ve seen how hard you’ve been working lately."
    al "Não finja que não. Eu vi o quanto você tem trabalhado ultimamente."

# game/chapters/chapter4/script/ch4sc18.rpy:62
translate brazil ch4sc18_3a3b0b4a:

#   al "You’re clearly motivated, beyond any doubt."
    al "Você está claramente motivado, sem qualquer dúvida."

# game/chapters/chapter4/script/ch4sc18.rpy:64
translate brazil ch4sc18_1fac9f1e:

#   el "Y-Yeah... There’s something I want to do for [mc]... for both of us, actually."
    el "Sim... Tem algo que eu quero fazer por [mc]... para nós dois, na verdade."

# game/chapters/chapter4/script/ch4sc18.rpy:65
translate brazil ch4sc18_5507f6d4:

#   el "Neither [mc] or I have had a place to call home for so many years..."
    el "Nenhum [mc] ou eu tive um lugar para chamar de lar por tantos anos..."

# game/chapters/chapter4/script/ch4sc18.rpy:67
translate brazil ch4sc18_c8125d3e:

#   el "So, that’s what I’m working towards."
    el "Então, é para isso que estou trabalhando."

# game/chapters/chapter4/script/ch4sc18.rpy:69
translate brazil ch4sc18_ebca32bd:

#   al "Eliza... that’s amazing! I had no idea you were up to something so big!"
    al "Eliza... isso é incrível! Eu não fazia ideia de que você estava envolvida em algo tão grandioso!"

# game/chapters/chapter4/script/ch4sc18.rpy:70
translate brazil ch4sc18_61d13fa7:

#   al "Let me know if there’s anything I can do to help!"
    al "Me avise se houver algo que eu possa fazer para ajudar!"

# game/chapters/chapter4/script/ch4sc18.rpy:72
translate brazil ch4sc18_64f00749:

#   el "Thanks! But right now it’s all about saving up enough coin to afford building materials."
    el "Obrigado! Mas agora o importante é juntar dinheiro suficiente para comprar os materiais de construção."

# game/chapters/chapter4/script/ch4sc18.rpy:73
translate brazil ch4sc18_82151267:

#   el "How’s it going with your new friend? Luna?"
    el "Como está indo com sua nova amiga? Luna?"

# game/chapters/chapter4/script/ch4sc18.rpy:75
translate brazil ch4sc18_1f546f73:

#   al "Oh, Luna? She’s great, actually. She’s very busy all the time, though."
    al "Ah, Luna? Ela é ótima, na verdade. Mas está sempre muito ocupada."

# game/chapters/chapter4/script/ch4sc18.rpy:76
translate brazil ch4sc18_da46fe8b:

#   al "She’s working on a secret project with our professor. Something to do with her mother."
    al "Ela está trabalhando em um projeto secreto com o nosso professor. Tem algo a ver com a mãe dela."

# game/chapters/chapter4/script/ch4sc18.rpy:77
translate brazil ch4sc18_ba994f22:

#   al_t "I'd better not tell her that it might have something to do with... Taron."
    al_t "É melhor eu não contar para ela que isso pode ter algo a ver com... Taron."

# game/chapters/chapter4/script/ch4sc18.rpy:78
translate brazil ch4sc18_0470f061:

#   al_t "I don’t want her to worry. She’s already been through enough trauma."
    al_t "Não quero que ela se preocupe. Ela já passou por traumas suficientes."

# game/chapters/chapter4/script/ch4sc18.rpy:80
translate brazil ch4sc18_d96f318c:

#   al "Eliza, I’ve gotta run. My afternoon classes are about to start."
    al "Eliza, preciso ir. Minhas aulas da tarde estão prestes a começar."

# game/chapters/chapter4/script/ch4sc18.rpy:81
translate brazil ch4sc18_3b20f87d:

#   al "Talk soon, okay?"
    al "Falamos em breve, ok?"

# game/chapters/chapter4/script/ch4sc18.rpy:83
translate brazil ch4sc18_d280b813:

#   el "'Kay! See you later, Miss Alchemist!"
    el "Tá bom! Até mais, senhorita alquimista!"

# game/chapters/chapter4/script/ch4sc18.rpy:86
translate brazil ch4sc18_834de56c:

#   elt "..."
    elt "..."

# game/chapters/chapter4/script/ch4sc18.rpy:88
translate brazil ch4sc18_56c42fb3:

#   elt "Hmh. It felt like she was holding something back."
    elt "Hum. Parecia que ela estava escondendo alguma coisa."

# game/chapters/chapter4/script/ch4sc18.rpy:89
translate brazil ch4sc18_d48b0af5:

#   elt "I’m probably just reading too much into things. Either way, it’s great that she’s doing well at the academy."
    elt "Provavelmente estou dando muita importância às coisas. De qualquer forma, é ótimo que ela esteja se saindo bem na academia."

# game/chapters/chapter4/script/ch4sc18.rpy:91
translate brazil ch4sc18_fd1c6137:

#   elt "[mc]... You better come home soon..."
    elt "[mc]... É melhor você voltar para casa logo..."

# game/chapters/chapter4/script/ch4sc18.rpy:92
translate brazil ch4sc18_8c848102:

#   elt "I have a lot of hugs to cash in... *Sigh*"
    elt "Tenho muitos abraços para distribuir... *Suspiro*"

# game/chapters/chapter4/script/ch4sc18.rpy:117
translate brazil ch4sc18_23abd37b:

#   uk "*Chanting* Jantar... Mantar... Jadu... Mantar... Balthaz... Zar..."
    uk "*Cantando* Jantar... Mantar... Magia... Mantar... Balthaz... Zar..."

# game/chapters/chapter4/script/ch4sc18.rpy:119
translate brazil ch4sc18_0b322772:

#   ta "..."
    ta "..."

# game/chapters/chapter4/script/ch4sc18.rpy:120
translate brazil ch4sc18_627276b4:

#   uk "You are late."
    uk "Você está atrasado(a)."

# game/chapters/chapter4/script/ch4sc18.rpy:121
translate brazil ch4sc18_b1e944dc:

#   ta "There have been... complications."
    ta "Houve... complicações."

# game/chapters/chapter4/script/ch4sc18.rpy:123
translate brazil ch4sc18_39636aeb:

#   uk "Complications?"
    uk "Complicações?"

# game/chapters/chapter4/script/ch4sc18.rpy:125
translate brazil ch4sc18_2ed2b658:

#   ta "It’s of no concern."
    ta "Não há motivo para preocupação."

# game/chapters/chapter4/script/ch4sc18.rpy:127
translate brazil ch4sc18_e72e16d7:

#   uk "Clearly you can’t seem to fathom the importance of our work."
    uk "Claramente, você parece não conseguir compreender a importância do nosso trabalho."

# game/chapters/chapter4/script/ch4sc18.rpy:129
translate brazil ch4sc18_97265fc1:

#   ta "I know full well what’s at stake."
    ta "Sei perfeitamente o que está em jogo."

# game/chapters/chapter4/script/ch4sc18.rpy:131
translate brazil ch4sc18_de7f524e:

#   uk "Our Lord Eternal will rise again. And when he does... you’ll want to be in his good graces."
    uk "Nosso Senhor Eterno ressuscitará. E quando isso acontecer... você vai querer estar em Sua graça."

# game/chapters/chapter4/script/ch4sc18.rpy:132
translate brazil ch4sc18_db1ac69d:

#   uk "You've seen his vision in the flames, just as I have..."
    uk "Você viu a visão dele nas chamas, assim como eu..."

# game/chapters/chapter4/script/ch4sc18.rpy:133
translate brazil ch4sc18_bc49a2f7:

#   uk "You know what will happen to those who fail him."
    uk "Você sabe o que acontecerá com aqueles que o decepcionarem."

# game/chapters/chapter4/script/ch4sc18.rpy:135
translate brazil ch4sc18_58965a79:

#   ta "I know."
    ta "Eu sei."

# game/chapters/chapter4/script/ch4sc18.rpy:136
translate brazil ch4sc18_f548b87f:

#   ta "The plan is in motion. Pieces are moving without them even knowing it."
    ta "O plano está em andamento. As peças estão se movendo sem que eles sequer percebam."

# game/chapters/chapter4/script/ch4sc18.rpy:138
translate brazil ch4sc18_d65cf6b7:

#   uk "He won’t tolerate failure, Taron."
    uk "Ele não tolera fracassos, Taron."

# game/chapters/chapter4/script/ch4sc18.rpy:140
translate brazil ch4sc18_e48e9de7:

#   ta "*Teeth clenching* ..."
    ta "*Apertando os dentes* ..."

# game/chapters/chapter4/script/ch4sc18.rpy:141
translate brazil ch4sc18_b32ee020:

#   ta "He won’t have to. You’ll all see... I'll be the one to bring him back."
    ta "Ele não precisará. Vocês todos verão... Eu serei quem o trará de volta."

# game/chapters/chapter4/script/ch4sc18.rpy:142
translate brazil ch4sc18_03bbe6c1:

#   ta "What are you guys even doing to bring about his vision?"
    ta "O que vocês estão fazendo para concretizar a visão dele?"

# game/chapters/chapter4/script/ch4sc18.rpy:144
translate brazil ch4sc18_ffc22096:

#   ta "All I see are your minions preaching in the streets like common zealots!"
    ta "Só vejo seus asseclas pregando nas ruas como fanáticos comuns!"

# game/chapters/chapter4/script/ch4sc18.rpy:146
translate brazil ch4sc18_de145f25:

#   uk "We do his will. There are no small parts in the master’s plan."
    uk "Fazemos a sua vontade. Não há papéis pequenos no plano do mestre."

# game/chapters/chapter4/script/ch4sc18.rpy:147
translate brazil ch4sc18_43235164:

#   uk "Our Lord chose you, Taron... but rest assured, you are just one of many candidates."
    uk "Nosso Senhor te escolheu, Taron... mas tenha certeza, você é apenas um entre muitos candidatos."

# game/chapters/chapter4/script/ch4sc18.rpy:148
translate brazil ch4sc18_ab1380d3:

#   uk "Best make sure your little plans don't fall through."
    uk "É melhor garantir que seus pequenos planos não deem errado."

# game/chapters/chapter4/script/ch4sc18.rpy:157
translate brazil ch4sc18_8a10ace6:

#   mct "There she is. We’re long overdue for a chat."
    mct "Lá está ela. Já faz tempo que precisamos conversar."

# game/chapters/chapter4/script/ch4sc18.rpy:159
translate brazil ch4sc18_22d4e493:

#   pl "It’s time, huh?"
    pl "Chegou a hora, né?"

# game/chapters/chapter4/script/ch4sc18.rpy:161
translate brazil ch4sc18_27945222:

#   mc "It’s time."
    mc "Chegou a hora."

# game/chapters/chapter4/script/ch4sc18.rpy:162
translate brazil ch4sc18_a25a735b:

#   pl "..."
    pl "..."

# game/chapters/chapter4/script/ch4sc18.rpy:164
translate brazil ch4sc18_cf95715b:

#   pl "*Deep sigh* Where... Where do I even begin?"
    pl "*Suspiro profundo* Por onde... Por onde eu começo?"

# game/chapters/chapter4/script/ch4sc18.rpy:166
translate brazil ch4sc18_4b542016:

#   mc "Your father threatened to harm or possibly kill Kira, if you didn’t obey, right?"
    mc "Seu pai ameaçou ferir ou possivelmente matar Kira se você não obedecesse, certo?"

# game/chapters/chapter4/script/ch4sc18.rpy:167
translate brazil ch4sc18_89d6fae4:

#   pl "*Nods*"
    pl "*Acena com a cabeça*"

# game/chapters/chapter4/script/ch4sc18.rpy:168
translate brazil ch4sc18_50622c41:

#   mc "Then you’re not to blame. He is. To turn his own daughters against each other?"
    mc "Então a culpa não é sua. É dele. Por colocar as próprias filhas umas contra as outras?"

# game/chapters/chapter4/script/ch4sc18.rpy:169
translate brazil ch4sc18_c963f9c1:

#   mc "The ring has clearly been influencing him for quite some time."
    mc "O anel claramente o tem influenciado há algum tempo."

# game/chapters/chapter4/script/ch4sc18.rpy:171
translate brazil ch4sc18_e687a3c7:

#   pl "Don’t... Don’t do that."
    pl "Não... Não faça isso."

# game/chapters/chapter4/script/ch4sc18.rpy:172
translate brazil ch4sc18_3df4656a:

#   pl "Don’t try to excuse my actions. In the end, I made the decision to listen to father’s threats."
    pl "Não tente justificar minhas ações. No fim, tomei a decisão de acatar as ameaças do meu pai."

# game/chapters/chapter4/script/ch4sc18.rpy:174
translate brazil ch4sc18_78447c25:

#   pl "I could’ve warned you guys, we- we could’ve come up with a plan together..."
    pl "Eu poderia ter avisado vocês, nós... nós poderíamos ter bolado um plano juntos..."

# game/chapters/chapter4/script/ch4sc18.rpy:175
translate brazil ch4sc18_7335cd08:

#   mc "Hey... It’s okay..."
    mc "Ei... Está tudo bem..."

# game/chapters/chapter4/script/ch4sc18.rpy:177
translate brazil ch4sc18_1ef7112b:

#   mc "Come here... I’ve already forgiven you."
    mc "Venha cá... Eu já te perdoei."

# game/chapters/chapter4/script/ch4sc18.rpy:178
translate brazil ch4sc18_fe7c0f5f:

#   mc "You’re far too pretty to be crying."
    mc "Você é muito bonita para estar chorando."

# game/chapters/chapter4/script/ch4sc18.rpy:180
translate brazil ch4sc18_26e05a61:

#   pl "No... I don’t deserve this, [mc]. You should hate me... You should shout at me..."
    pl "Não... eu não mereço isso. [mc] Você deveria me odiar... Você deveria gritar comigo..."

# game/chapters/chapter4/script/ch4sc18.rpy:181
translate brazil ch4sc18_7c1e660d:

#   pl "I... I can’t accept your forgiveness... I just can’t."
    pl "Eu... eu não consigo aceitar seu perdão... simplesmente não consigo."

# game/chapters/chapter4/script/ch4sc18.rpy:183
translate brazil ch4sc18_421cf769:

#   mc "Pearl..."
    mc "Pérola..."

# game/chapters/chapter4/script/ch4sc18.rpy:184
translate brazil ch4sc18_8022ef27:

#   pl "*Sobs* No! [mc]... Please, just leave me alone."
    pl "*Soluços* Não! [mc] Por favor, me deixe em paz."

# game/chapters/chapter4/script/ch4sc18.rpy:191
translate brazil ch4sc18_be8f091f:

