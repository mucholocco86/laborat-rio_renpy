# ARQUIVO: game/chapters/chapter4/script/ch4sc4.rpy DIALOGOS: 98


# game/chapters/chapter4/script/ch4sc4.rpy:11
translate brazil ch4sc4_d0970aa3:

#   mct "Looks like Flynn's here."
    mct "Parece que Flynn está aqui."

# game/chapters/chapter4/script/ch4sc4.rpy:12
translate brazil ch4sc4_35182b62:

#   mct "And with Borri, no less."
    mct "E com Borri, nada menos."

# game/chapters/chapter4/script/ch4sc4.rpy:14
translate brazil ch4sc4_e6ddd295:

#   fy "Cus! Come join us!"
    fy "Cus! Venha se juntar a nós!"

# game/chapters/chapter4/script/ch4sc4.rpy:15
translate brazil ch4sc4_831bcb38:

#   br "Hey, [mc]... sit down with us for a moment."
    br "Ei, [mc]...sente-se conosco por um momento."

# game/chapters/chapter4/script/ch4sc4.rpy:16
translate brazil ch4sc4_ccb7bc5a:

#   br "The lasses are upstairs resting."
    br "As moças estão descansando lá em cima."

# game/chapters/chapter4/script/ch4sc4.rpy:18
translate brazil ch4sc4_b3c74fcd:

#   mc "I was wondering when you'd show up, Flynn."
    mc "Eu estava me perguntando quando você apareceria, Flynn."

# game/chapters/chapter4/script/ch4sc4.rpy:19
translate brazil ch4sc4_b39a76f0:

#   mc "I see you two have hit it off?"
    mc "Vejo que vocês dois se deram muito bem?"

# game/chapters/chapter4/script/ch4sc4.rpy:21
translate brazil ch4sc4_15dbeb6d:

#   fy "Hey cuz... I wish it was under better circumstances."
    fy "Ei, primo... Eu gostaria que tivesse sido em melhores circunstâncias."

# game/chapters/chapter4/script/ch4sc4.rpy:22
translate brazil ch4sc4_7506ea86:

#   fy "This fella explained everything."
    fy "Esse cara explicou tudo."

# game/chapters/chapter4/script/ch4sc4.rpy:24
translate brazil ch4sc4_486d6a5a:

#   br "So... what’s the plan?"
    br "Então... qual é o plano?"

# game/chapters/chapter4/script/ch4sc4.rpy:25
translate brazil ch4sc4_6ac99d0a:

#   br "Did ye learn anything of use?"
    br "Vocês aprenderam algo útil?"

# game/chapters/chapter4/script/ch4sc4.rpy:27
translate brazil ch4sc4_4387039c:

#   fy "Please tell us you have something."
    fy "Por favor, diga-nos que você tem algo."

# game/chapters/chapter4/script/ch4sc4.rpy:28
translate brazil ch4sc4_838175e6:

#   fy "'Cause we’ve been scrambling the last few hours, but to no avail."
    fy "Porque temos estado a trabalhar arduamente nas últimas horas, mas sem sucesso."

# game/chapters/chapter4/script/ch4sc4.rpy:30
translate brazil ch4sc4_1414cf31:

#   mc "*Sigh* I might have something."
    mc "*Suspiro* Talvez eu tenha algo."

# game/chapters/chapter4/script/ch4sc4.rpy:31
translate brazil ch4sc4_3ec5aa71:

#   mc "Emphasis on 'might'."
    mc "Ênfase em \"poderia\"."

# game/chapters/chapter4/script/ch4sc4.rpy:33
translate brazil ch4sc4_2cd796c6:

#   br "Well? Don’t keep us in suspense!"
    br "E aí? Não nos deixe na expectativa!"

# game/chapters/chapter4/script/ch4sc4.rpy:34
translate brazil ch4sc4_6522b7e2:

#   br "I can’t take sitting idle any bloody longer! I'm ready te crack some skulls!"
    br "Não aguento mais ficar parado! Estou pronto para quebrar alguns crânios!"

# game/chapters/chapter4/script/ch4sc4.rpy:36
translate brazil ch4sc4_9ccb6665:

#   mc "Shame. Cause that’s exactly what I need you to do."
    mc "Vergonha. Porque é exatamente isso que eu preciso que você faça."

# game/chapters/chapter4/script/ch4sc4.rpy:37
translate brazil ch4sc4_322020a2:

#   mc "This will be a solo mission."
    mc "Esta será uma missão individual."

# game/chapters/chapter4/script/ch4sc4.rpy:38
translate brazil ch4sc4_bf72411c:

#   mc "If you guys want to help, then watch over Eliza while I’m away."
    mc "Se vocês quiserem ajudar, cuidem da Eliza enquanto eu estiver fora."

# game/chapters/chapter4/script/ch4sc4.rpy:40
translate brazil ch4sc4_0c87e671:

#   br "Arrrgh! I can’t bloody deny ye when yer put it like that, can I?"
    br "Argh! Não posso negar quando você coloca as coisas desse jeito, posso?"

# game/chapters/chapter4/script/ch4sc4.rpy:42
translate brazil ch4sc4_ee525bdf:

#   fy "Borri stays with Eliza. I’m going with you."
    fy "Borri fica com Eliza. Eu vou com você."

# game/chapters/chapter4/script/ch4sc4.rpy:44
translate brazil ch4sc4_d39ed18e:

#   mc "Flynn."
    mc "Flynn."

# game/chapters/chapter4/script/ch4sc4.rpy:45
translate brazil ch4sc4_026ebf3c:

#   mc "This isn't like the times we used to play scavengers back home."
    mc "Isso não é como nos tempos em que costumávamos brincar de catadores de lixo em casa."

# game/chapters/chapter4/script/ch4sc4.rpy:47
translate brazil ch4sc4_6f8a50ad:

#   fy "Don't 'Flynn' me."
    fy "Não me chame de 'Flynn'."

# game/chapters/chapter4/script/ch4sc4.rpy:48
translate brazil ch4sc4_5488b9e4:

#   fy "No, I’m going with."
    fy "Não, eu vou com..."

# game/chapters/chapter4/script/ch4sc4.rpy:49
translate brazil ch4sc4_6def6703:

#   fy "I didn’t come to the capital to sit in taverns like I did back home."
    fy "Eu não vim para a capital para ficar sentado em tabernas como fazia em casa."

# game/chapters/chapter4/script/ch4sc4.rpy:51
translate brazil ch4sc4_8a14765f:

#   fy "I came here to find my purpose! I already signed up with the Seafarer’s guild."
    fy "Vim aqui para encontrar meu propósito! Já me inscrevi na guilda dos marinheiros."

# game/chapters/chapter4/script/ch4sc4.rpy:52
translate brazil ch4sc4_e9105c1a:

#   fy "But this? Helping you and Eliza? There’s no way I’m staying behind."
    fy "Mas isto? Ajudar você e a Eliza? De jeito nenhum vou ficar para trás."

# game/chapters/chapter4/script/ch4sc4.rpy:54
translate brazil ch4sc4_01f5e855:

#   mc "You don’t even know where we’re going yet."
    mc "Você ainda nem sabe para onde estamos indo."

# game/chapters/chapter4/script/ch4sc4.rpy:56
translate brazil ch4sc4_3971ca55:

#   fy "Great! That’s what adventure is all about!"
    fy "Ótimo! É disso que se trata a aventura!"

# game/chapters/chapter4/script/ch4sc4.rpy:57
translate brazil ch4sc4_4e3f567c:

#   fy "Lay it on me cus! Where is this adventure taking us? A secret island filled with lustful women?"
    fy "Manda ver, mano! Aonde essa aventura vai nos levar? Uma ilha secreta cheia de mulheres sensuais?"

# game/chapters/chapter4/script/ch4sc4.rpy:58
translate brazil ch4sc4_eede6f76:

#   fy "We'd be the only men amongst them... and their culture would require us to bless them with our seed!"
    fy "Seríamos os únicos homens entre elas... e a cultura delas exigiria que as abençoássemos com nossa semente!"

# game/chapters/chapter4/script/ch4sc4.rpy:59
translate brazil ch4sc4_82c5ed7e:

#   fy "Maybe a long-lost lagoon with beautiful mermaids who will find us exotic and irresistable?!"
    fy "Talvez uma lagoa perdida há muito tempo, com belas sereias que nos acharão exóticos e irresistíveis?!"

# game/chapters/chapter4/script/ch4sc4.rpy:60
translate brazil ch4sc4_78f6306b:

#   fy "I wonder how it works? You know, making babies with a mermaid?"
    fy "Eu me pergunto como isso funciona? Sabe, fazer bebês com uma sereia?"

# game/chapters/chapter4/script/ch4sc4.rpy:62
translate brazil ch4sc4_04bc0569:

#   mc "If you're done with your rather... vivid day-dreaming, I'll tell you."
    mc "Se você já terminou com seus devaneios... digamos, vívidos, eu lhe direi."

# game/chapters/chapter4/script/ch4sc4.rpy:63
translate brazil ch4sc4_c76e0958:

#   mc "Isle de Inmortui."
    mc "Ilha dos Imortais."

# game/chapters/chapter4/script/ch4sc4.rpy:65
translate brazil ch4sc4_d8debf0b:

#   fy "What’s that?"
    fy "O que é isso?"

# game/chapters/chapter4/script/ch4sc4.rpy:67
translate brazil ch4sc4_055fc2fd:

#   fy "Is it some sort of riddle?"
    fy "Seria algum tipo de enigma?"

# game/chapters/chapter4/script/ch4sc4.rpy:69
translate brazil ch4sc4_ac9c91a0:

#   mc "No, it's our destination."
    mc "Não, é o nosso destino."

# game/chapters/chapter4/script/ch4sc4.rpy:71
translate brazil ch4sc4_5d4adce9:

#   br "Isle de Inmortui... ... Island of Undying?"
    br "Ilha dos Imortais... ... Ilha da Eterna Imortalidade?"

# game/chapters/chapter4/script/ch4sc4.rpy:73
translate brazil ch4sc4_8eacfe6a:

#   fy "U-Undying? Surely a name created in jest by some drunken sailors!"
    fy "U-Imortal? Com ​​certeza um nome criado em tom de brincadeira por alguns marinheiros bêbados!"

# game/chapters/chapter4/script/ch4sc4.rpy:74
translate brazil ch4sc4_3d238a7f:

#   fy "To scare away pillagers or pirates! R-Right?"
    fy "Para espantar saqueadores ou piratas! Certo?"

# game/chapters/chapter4/script/ch4sc4.rpy:76
translate brazil ch4sc4_cd762858:

#   mc "Nah, the source of the intel is good. Believe me."
    mc "Não, a fonte da informação é boa. Acredite em mim."

# game/chapters/chapter4/script/ch4sc4.rpy:78
translate brazil ch4sc4_174e6bd1:

#   fy "I’m sure it’s all a big misunderstanding, cousin."
    fy "Tenho certeza de que tudo isso é um grande mal-entendido, primo."

# game/chapters/chapter4/script/ch4sc4.rpy:80
translate brazil ch4sc4_9c3d72f0:

#   fy "Who in their right mind would give an island that name?"
    fy "Quem em sã consciência daria esse nome a uma ilha?"

# game/chapters/chapter4/script/ch4sc4.rpy:82
translate brazil ch4sc4_079323a7:

#   fy "What are we going there for, anyway?"
    fy "Afinal, para que vamos lá?"

# game/chapters/chapter4/script/ch4sc4.rpy:84
translate brazil ch4sc4_e93cfbdb:

#   mc "To retrieve an artifact. Supposedly it's a chalice. They say it contains powers of divine restoration."
    mc "Para recuperar um artefato. Supostamente, é um cálice. Dizem que ele contém poderes de restauração divina."

# game/chapters/chapter4/script/ch4sc4.rpy:85
translate brazil ch4sc4_882acac4:

#   mc "According to legend, drinking from it will heal any injury, or cure any wounds that have been inflicted."
    mc "Segundo a lenda, beber dessa água cura qualquer ferimento ou ferida."

# game/chapters/chapter4/script/ch4sc4.rpy:87
translate brazil ch4sc4_f3bcb648:

#   fy "Legend? So, we’re not even certain this thing exists?"
    fy "Lenda? Então, nem sequer temos certeza se isso existe?"

# game/chapters/chapter4/script/ch4sc4.rpy:89
translate brazil ch4sc4_93716bea:

#   fy "We’re basically going on a wild goose chase?"
    fy "Basicamente, estamos embarcando numa busca inútil?"

# game/chapters/chapter4/script/ch4sc4.rpy:91
translate brazil ch4sc4_5ff6ba18:

#   mc "Hey, if you want to stay back I don’t blame you-"
    mc "Ei, se você quiser ficar, eu não te culpo."

# game/chapters/chapter4/script/ch4sc4.rpy:93
translate brazil ch4sc4_ceee21ba:

#   fy "No! No, no, no! I’m going! And we’ll find this thing!"
    fy "Não! Não, não, não! Eu vou! E nós vamos encontrar essa coisa!"

# game/chapters/chapter4/script/ch4sc4.rpy:94
translate brazil ch4sc4_19488ea9:

#   fy "Once we get back, we’ll be the talk of the town!"
    fy "Quando voltarmos, seremos o assunto da cidade!"

# game/chapters/chapter4/script/ch4sc4.rpy:96
translate brazil ch4sc4_58c95adf:

#   fy "Just imagine all the ladies throwing themselves at our feet..."
    fy "Imagine só todas as mulheres se atirando aos nossos pés..."

# game/chapters/chapter4/script/ch4sc4.rpy:97
translate brazil ch4sc4_a983b18b:

#   fy "After they hear the tale of two handsome adventurers returning from the horrible Island of Undying!"
    fy "Depois de ouvirem a história de dois belos aventureiros que retornaram da terrível Ilha dos Imortais!"

# game/chapters/chapter4/script/ch4sc4.rpy:99
translate brazil ch4sc4_50bd271c:

#   fy "With a legendary artifact, blessed by the divines, no less!"
    fy "Com um artefato lendário, abençoado pelos deuses, nada menos!"

# game/chapters/chapter4/script/ch4sc4.rpy:100
translate brazil ch4sc4_3288a7df:

#   fy "I’ll be surprised if we aren’t granted an audience with the king!"
    fy "Ficarei surpreso se não nos for concedida uma audiência com o rei!"

# game/chapters/chapter4/script/ch4sc4.rpy:101
translate brazil ch4sc4_531d8f5b:

#   fy "And his beautiful maiden daughter, who needs a strong heroic man for a prosperous marriage."
    fy "E sua bela filha solteira, que precisa de um homem forte e heroico para um casamento próspero."

# game/chapters/chapter4/script/ch4sc4.rpy:102
translate brazil ch4sc4_174e3a4f:

#   br "*Scoffs*"
    br "*Risos*"

# game/chapters/chapter4/script/ch4sc4.rpy:104
translate brazil ch4sc4_52a8c71c:

#   mc "We’re doing this for Eliza."
    mc "Estamos fazendo isso por Eliza."

# game/chapters/chapter4/script/ch4sc4.rpy:106
translate brazil ch4sc4_ba383b6a:

#   fy "Right, of course. I’m fully aware..."
    fy "Certo, claro. Estou plenamente ciente..."

# game/chapters/chapter4/script/ch4sc4.rpy:107
translate brazil ch4sc4_1efe6172:

#   fy "But there’s no reason we can’t bask in a little glory afterwards, right?"
    fy "Mas não há razão para não podermos desfrutar de um pouco de glória depois, certo?"

# game/chapters/chapter4/script/ch4sc4.rpy:109
translate brazil ch4sc4_aafda908:

#   mc "*Sigh* I suppose you can bask in all the glory you want."
    mc "*Suspiro* Imagino que você possa se deleitar com toda a glória que desejar."

# game/chapters/chapter4/script/ch4sc4.rpy:111
translate brazil ch4sc4_c99d560d:

#   fy "Yes! That’s the spirit!-"
    fy "Sim! É isso aí!"

# game/chapters/chapter4/script/ch4sc4.rpy:112
translate brazil ch4sc4_26fac118:

#   mc "If you survive."
    mc "Se você sobreviver."

# game/chapters/chapter4/script/ch4sc4.rpy:114
translate brazil ch4sc4_64e3e658:

#   fy "Wha-"
    fy "Quatro-"

# game/chapters/chapter4/script/ch4sc4.rpy:116
translate brazil ch4sc4_5a04c19d:

#   br "*Chuckles* Don’t tell me ye think the place being called undying means nothing?"
    br "*Risos* Não me diga que você acha que o fato do lugar ser chamado de imortal não significa nada?"

# game/chapters/chapter4/script/ch4sc4.rpy:117
translate brazil ch4sc4_935b535f:

#   br "Ye'd better prepare for one hell of a trip, lad."
    br "É melhor você se preparar para uma viagem daquelas, rapaz."

# game/chapters/chapter4/script/ch4sc4.rpy:120
translate brazil ch4sc4_ff3fc3dc:

#   br "Yer thought this would be easy sailing huh? Heh!"
    br "Você achou que isso seria moleza, né? Heh!"

# game/chapters/chapter4/script/ch4sc4.rpy:121
translate brazil ch4sc4_219372a2:

#   br "I'd be surprised if ye make it back alive lad!"
    br "Ficaria surpreso se você voltasse vivo, rapaz!"

# game/chapters/chapter4/script/ch4sc4.rpy:125
translate brazil ch4sc4_68712098:

#   fyt "I'm going to {b}DIE?!{/b}"
    fyt "Eu vou para {b} MORRER?!{/b}"

# game/chapters/chapter4/script/ch4sc4.rpy:126
translate brazil ch4sc4_8d099add:

#   fyt "B-But... I can't die!? I'm a virgin!"
    fyt "M-Mas... eu não posso morrer!? Eu sou virgem!"

# game/chapters/chapter4/script/ch4sc4.rpy:128
translate brazil ch4sc4_7a5b899f:

#   mc "Flynn, I’m leaving at first light tomorrow... if you want to come, you can meet me at the docks. But think about it."
    mc "Flynn, parto ao amanhecer amanhã... se quiser vir, pode me encontrar no cais. Mas pense bem."

# game/chapters/chapter4/script/ch4sc4.rpy:129
translate brazil ch4sc4_a2485503:

#   mc "This isn’t like when we were kids... this is life or death. There’s no reason for you to risk your life as well."
    mc "Isso não é como quando éramos crianças... isso é vida ou morte. Não há motivo para você arriscar a sua vida também."

# game/chapters/chapter4/script/ch4sc4.rpy:131
translate brazil ch4sc4_6ff2dee9:

#   fy "Let me stop you right there, cousin. There’s no doubt in my mind that I'm doing this."
    fy "Deixa eu te interromper aqui, primo. Não tenho a menor dúvida de que vou fazer isso."

# game/chapters/chapter4/script/ch4sc4.rpy:133
translate brazil ch4sc4_49676dbb:

#   fy "We thought we'd already lost you once. I’m going to make sure we don’t have a repeat of that."
    fy "Pensávamos que já tínhamos te perdido uma vez. Vou garantir que isso não se repita."

# game/chapters/chapter4/script/ch4sc4.rpy:134
translate brazil ch4sc4_ae138528:

#   fy "We’re family. I was the one who had to stay strong when Alice and Sabby were crying their eyes out after you disappeared."
    fy "Somos família. Eu fui quem teve que se manter forte quando Alice e Sabby estavam chorando muito depois do seu desaparecimento."

# game/chapters/chapter4/script/ch4sc4.rpy:136
translate brazil ch4sc4_7fb66934:

#   fy "Some days things seemed normal... and then, suddenly out of nowhere, a memory of you would strike them."
    fy "Em alguns dias, tudo parecia normal... e então, de repente, do nada, uma lembrança sua surgia."

# game/chapters/chapter4/script/ch4sc4.rpy:137
translate brazil ch4sc4_28be8b36:

#   fy "Then they'd isolate themselves again, sobbing uncontrollably til their bodies couldn’t produce anymore tears."
    fy "Então eles se isolavam novamente, soluçando incontrolavelmente até que seus corpos não pudessem mais produzir lágrimas."

# game/chapters/chapter4/script/ch4sc4.rpy:138
translate brazil ch4sc4_b2bb9f06:

#   fy "We’ve all been through so much god damn pain and grief from losing you and your parents all those years ago."
    fy "Todos nós passamos por tanta dor e sofrimento por termos perdido você e seus pais tantos anos atrás."

# game/chapters/chapter4/script/ch4sc4.rpy:140
translate brazil ch4sc4_2c0c246a:

#   fy "So I’m doing this. And maybe I'm joking about the benefits, but they're {b}NOT{/b} why I’m doing it."
    fy "Então estou fazendo isso. E talvez eu esteja brincando sobre os benefícios, mas eles são... {b} NÃO{/b} Por que estou fazendo isso."

# game/chapters/chapter4/script/ch4sc4.rpy:141
translate brazil ch4sc4_5f040ca5:

#   fy "If you believe anything, believe that."
    fy "Se você acredita em alguma coisa, acredite nisso."

# game/chapters/chapter4/script/ch4sc4.rpy:143
translate brazil ch4sc4_b1a21061:

#   mc "Flynn... I-"
    mc "Flynn... Eu-"

# game/chapters/chapter4/script/ch4sc4.rpy:146
translate brazil ch4sc4_de0185c8:

#   fy "Come here, cuz!"
    fy "Vem cá, primo!"

# game/chapters/chapter4/script/ch4sc4.rpy:147
translate brazil ch4sc4_a31340dd:

#   mc "Really?"
    mc "Realmente?"

# game/chapters/chapter4/script/ch4sc4.rpy:148
translate brazil ch4sc4_403d2de1:

#   fy "{b}YES!{/b}"
    fy "{b}SIM!{/b}"

# game/chapters/chapter4/script/ch4sc4.rpy:149
translate brazil ch4sc4_bcc4722c:

#   mc "*Sighs* Fine..."
    mc "*Suspiro* Tudo bem..."

# game/chapters/chapter4/script/ch4sc4.rpy:151
translate brazil ch4sc4_9612c24e:

#   "You embrace each other for the first time since you were ten years old."
    "Vocês se abraçam pela primeira vez desde os dez anos de idade."

# game/chapters/chapter4/script/ch4sc4.rpy:152
translate brazil ch4sc4_e2d9d25f:

#   mct "As much as he fools around... he's chosen to take a stand, I can respect that."
    mct "Por mais que ele brinque... ele escolheu tomar uma posição, e eu respeito isso."

# game/chapters/chapter4/script/ch4sc4.rpy:154
translate brazil ch4sc4_dcca1eab:

#   fy "Now go... I believe there are two wonderful girls waiting for you."
    fy "Agora vá... acredito que há duas garotas maravilhosas esperando por você."

# game/chapters/chapter4/script/ch4sc4.rpy:156
translate brazil ch4sc4_9662f090:

#   mc "Thank you, Flynn."
    mc "Obrigado, Flynn."

# game/chapters/chapter4/script/ch4sc4.rpy:157
translate brazil ch4sc4_525c6531:

#   mc "It’s... it’s good to have you with me."
    mc "É... é bom ter você comigo."

# game/chapters/chapter4/script/ch4sc4.rpy:159
translate brazil ch4sc4_830a0cf6:

#   mc "And thank you, Borri. For staying behind and looking after Eliza."
    mc "E obrigada, Borri. Por ter ficado e cuidado da Eliza."

# game/chapters/chapter4/script/ch4sc4.rpy:160
translate brazil ch4sc4_2a22ab07:

#   mc "It’s not a favor I will soon forget."
    mc "Não é um favor que esquecerei tão cedo."

# game/chapters/chapter4/script/ch4sc4.rpy:162
translate brazil ch4sc4_717d9187:

#   br "Bah! Don't ye get all mushy on me now... go on, lad."
    br "Bah! Não venha com essa de sentimentalismo agora... vai lá, rapaz."

# game/chapters/chapter4/script/ch4sc4.rpy:163
translate brazil ch4sc4_4d8903f9:

#   br "But after ye return, the first two barrels o' ale will be on you."
    br "Mas, depois que você voltar, os dois primeiros barris de cerveja serão por sua conta."

