#   el "W-What happened?"
    el "O que aconteceu?"

# game/chapters/chapter4/script/ch4sc1.rpy:18
translate brazil ch4sc1_ff3d8382:

#   el "[mc]?"
    el "[mc]?"

# game/chapters/chapter4/script/ch4sc1.rpy:21
translate brazil ch4sc1_9c98311d:

#   mc "Y-You’re alive?!"
    mc "V-Você está vivo?!"

# game/chapters/chapter4/script/ch4sc1.rpy:23
translate brazil ch4sc1_a1e4d257:

#   el "{size=+3}{b}Owwh!{/b}{/size} My poor ears... I’m glad you’re happy, but don’t shout so loudly."
    el "{size=+3}{b}Ai!{/b}{/size} Meus pobres ouvidos... Fico feliz que você esteja feliz, mas não grite tão alto."

# game/chapters/chapter4/script/ch4sc1.rpy:25
translate brazil ch4sc1_b328dea1:

#   mc "How do you feel? Does it hurt anywhere?"
    mc "Como você se sente? Sente dor em algum lugar?"

# game/chapters/chapter4/script/ch4sc1.rpy:26
translate brazil ch4sc1_e07d12e3:

#   mc "Are you okay to stand?"
    mc "Você consegue ficar de pé?"

# game/chapters/chapter4/script/ch4sc1.rpy:28
translate brazil ch4sc1_8733615e:

#   el "I..."
    el "EU..."

# game/chapters/chapter4/script/ch4sc1.rpy:30
translate brazil ch4sc1_b0745539:

#   el "I-I can’t feel my legs..."
    el "Não consigo sentir minhas pernas..."

# game/chapters/chapter4/script/ch4sc1.rpy:32
translate brazil ch4sc1_3501211e:

#   el "[mc]? W-Why can’t I feel my legs?"
    el "[mc] Por que não consigo sentir minhas pernas?"

# game/chapters/chapter4/script/ch4sc1.rpy:37
translate brazil ch4sc1_58e22a31:

#   mct "Fuck! {b}FUCK!!{/b}"
    mct "Porra! {b} PORRA!!{/b}"

# game/chapters/chapter4/script/ch4sc1.rpy:38
translate brazil ch4sc1_766f86a3:

#   mct "When he punched her in the back, it must have broken her lower spine."
    mct "Quando ele a socou nas costas, deve ter fraturado a parte inferior da coluna dela."

# game/chapters/chapter4/script/ch4sc1.rpy:39
translate brazil ch4sc1_1a07d9b1:

#   mct "I heard the sound of something snapping... this is bad..."
    mct "Ouvi o som de algo estalando... isso é ruim..."

# game/chapters/chapter4/script/ch4sc1.rpy:41
translate brazil ch4sc1_3d60211e:

#   mc "Listen... I’m going to pinch your legs."
    mc "Escuta... Vou beliscar suas pernas."

# game/chapters/chapter4/script/ch4sc1.rpy:42
translate brazil ch4sc1_d887d19b:

#   mc "Let me know when you start to feel something."
    mc "Me avise quando você começar a sentir alguma coisa."

# game/chapters/chapter4/script/ch4sc1.rpy:44
translate brazil ch4sc1_21763dea:

#   el "[mc], I’m scared... W-Why can’t I move my legs?"
    el "[mc] Estou com medo... P-Por que não consigo mexer as pernas?"

# game/chapters/chapter4/script/ch4sc1.rpy:46
translate brazil ch4sc1_45a181a2:

#   mc "Shhh. It will be okay... I promise."
    mc "Shhh. Vai ficar tudo bem... Eu prometo."

# game/chapters/chapter4/script/ch4sc1.rpy:47
translate brazil ch4sc1_12cf498e:

#   mc "Just tell me when you feel something."
    mc "Apenas me diga quando você sentir alguma coisa."

# game/chapters/chapter4/script/ch4sc1.rpy:49
translate brazil ch4sc1_ad82a52b:

#   el "O-Okay..."
    el "O-Okay..."

# game/chapters/chapter4/script/ch4sc1.rpy:57
translate brazil ch4sc1_a298a2bb:

#   el "Ouwh!"
    el "Ai!"

# game/chapters/chapter4/script/ch4sc1.rpy:59
translate brazil ch4sc1_50eeab43:

#   mct "It appears she can’t feel anything below her waist..."
    mct "Parece que ela não sente nada abaixo da cintura..."

# game/chapters/chapter4/script/ch4sc1.rpy:60
translate brazil ch4sc1_c41c0206:

#   mct "Right around her hip bone is where she starts to feel something... which means she can't walk."
    mct "É bem na altura do osso do quadril que ela começa a sentir algo... o que significa que ela não consegue andar."

# game/chapters/chapter4/script/ch4sc1.rpy:62
translate brazil ch4sc1_8391dc9e:

#   el "[mc]... I-I... Selena, she-"
    el "[mc]... II... Selena, ela-"

# game/chapters/chapter4/script/ch4sc1.rpy:63
translate brazil ch4sc1_3d3e1fe5:

#   el "Sel-Selena..."
    el "Sel-Selena..."

# game/chapters/chapter4/script/ch4sc1.rpy:66
translate brazil ch4sc1_565d387c:

#   "She doesn't manage to finish her sentence before exhaustion takes her."
    "Ela não consegue terminar a frase antes que o cansaço a domine."

# game/chapters/chapter4/script/ch4sc1.rpy:67
translate brazil ch4sc1_95d57be9:

#   mct "Selena? Is she worried about her safety? Does she think Selena was taken as well?"
    mct "Selena? Ela está preocupada com a segurança dela? Ela acha que Selena também foi sequestrada?"

# game/chapters/chapter4/script/ch4sc1.rpy:69
translate brazil ch4sc1_9c8d4fa3:

#   mct "The shock of everything that's happened in the last few hours must have taken it’s toll."
    mct "O choque de tudo o que aconteceu nas últimas horas deve ter cobrado seu preço."

# game/chapters/chapter4/script/ch4sc1.rpy:70
translate brazil ch4sc1_163423e4:

#   mct "I have to get her back to the warmth of the tavern, and our bed."
    mct "Preciso levá-la de volta para o aconchego da taverna e para nossa cama."

# game/chapters/chapter4/script/ch4sc1.rpy:72
translate brazil ch4sc1_ffcedcb8:

#   mct "She’s so incredibly strong."
    mct "Ela é incrivelmente forte."

# game/chapters/chapter4/script/ch4sc1.rpy:73
translate brazil ch4sc1_6ca9a26a:

#   mct "She was stuck down here in the cold, dirty cellars, all on her own..."
    mct "Ela estava presa aqui embaixo, nos porões frios e sujos, completamente sozinha..."

# game/chapters/chapter4/script/ch4sc1.rpy:74
translate brazil ch4sc1_e789f03e:

#   mct "Still, she managed to hold it together."
    mct "Ainda assim, ela conseguiu manter a compostura."

# game/chapters/chapter4/script/ch4sc1.rpy:75
translate brazil ch4sc1_565d45ad:

#   mct "When I first arrived, I could tell she was in a lot of pain."
    mct "Quando cheguei, percebi que ela estava com muita dor."

# game/chapters/chapter4/script/ch4sc1.rpy:77
translate brazil ch4sc1_0a28fe10:

#   mct "But she put on a brave face for me, so that I wouldn’t worry before we were safe."
    mct "Mas ela se mostrou corajosa para que eu não me preocupasse antes de estarmos em segurança."

# game/chapters/chapter4/script/ch4sc1.rpy:78
translate brazil ch4sc1_009d1e9f:

#   mct "Now it’s my turn to be strong. I need to be her rock through this."
    mct "Agora é a minha vez de ser forte. Preciso ser o porto seguro dela durante esse período."

# game/chapters/chapter4/script/ch4sc1.rpy:81
translate brazil ch4sc1_cd51e52e:

#   mct "No... Her mountain."
    mct "Não... A montanha dela."

# game/chapters/chapter4/script/ch4sc1.rpy:99
translate brazil ch4sc1_f0cc6f3e:

#   mct "You will walk again..."
    mct "Você voltará a andar..."

# game/chapters/chapter4/script/ch4sc1.rpy:100
translate brazil ch4sc1_5ed5d044:

#   mct "I will stop at nothing to ensure that."
    mct "Não vou parar por nada até garantir isso."

# game/chapters/chapter4/script/ch4sc1.rpy:104
translate brazil ch4sc1_9492a47f:

#   mct "We're here."
    mct "Estamos aqui."

# game/chapters/chapter4/script/ch4sc1.rpy:110
translate brazil ch4sc1_e805d00a:

#   br "[mc]!"
    br "[mc]!"

# game/chapters/chapter4/script/ch4sc1.rpy:111
translate brazil ch4sc1_7bedd4d1:

#   br "Ye found her! What the blazes happened?"
    br "Vocês a encontraram! Que diabos aconteceu?"

# game/chapters/chapter4/script/ch4sc1.rpy:113
translate brazil ch4sc1_cad13535:

#   mc "Help me get her to our room."
    mc "Me ajude a levá-la até o nosso quarto."

# game/chapters/chapter4/script/ch4sc1.rpy:114
translate brazil ch4sc1_cbb5cb0b:

#   mc "She needs rest... I’ll tell you what happened later."
    mc "Ela precisa descansar... Eu conto o que aconteceu depois."

# game/chapters/chapter4/script/ch4sc1.rpy:116
translate brazil ch4sc1_6121f03a:

#   br "Here, I’ll get the doors."
    br "Aqui, vou pegar as portas."

# game/chapters/chapter4/script/ch4sc1.rpy:118
translate brazil ch4sc1_7f3cc773:

#   br "She looks rough..."
    br "Ela parece estar com uma aparência abatida..."

# game/chapters/chapter4/script/ch4sc1.rpy:119
translate brazil ch4sc1_7007c49f:

#   br "We'd best make sure the innkeep prepares some honeyed tea for when she wakes up."
    br "É melhor garantirmos que o dono da pousada prepare um chá com mel para quando ela acordar."

# game/chapters/chapter4/script/ch4sc1.rpy:121
translate brazil ch4sc1_b343ce50:

#   al "[mc]?"
    al "[mc]?"

# game/chapters/chapter4/script/ch4sc1.rpy:122
translate brazil ch4sc1_49fd8205:

#   mct "Is that... here? Now?"
    mct "É... aqui? Agora?"

# game/chapters/chapter4/script/ch4sc1.rpy:125
translate brazil ch4sc1_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter4/script/ch4sc1.rpy:127
translate brazil ch4sc1_e6abb694:

#   mc "Alice?"
    mc "Alice?"

# game/chapters/chapter4/script/ch4sc1.rpy:128
translate brazil ch4sc1_9d83a8e2:

#   mc "What are you doing here?"
    mc "O que você está fazendo aqui?"

# game/chapters/chapter4/script/ch4sc1.rpy:130
translate brazil ch4sc1_8e387b7f:

#   al_t "I'm here to confess my feelings to you..."
    al_t "Estou aqui para confessar meus sentimentos a você..."

# game/chapters/chapter4/script/ch4sc1.rpy:132
translate brazil ch4sc1_fe4fe758:

#   al "Wait... is that?!"
    al "Espera... é isso mesmo?!"

# game/chapters/chapter4/script/ch4sc1.rpy:134
translate brazil ch4sc1_cb67e95c:

#   al "What happened?"
    al "O que aconteceu?"

# game/chapters/chapter4/script/ch4sc1.rpy:135
translate brazil ch4sc1_23e46d50:

#   al "Who did this to her?!"
    al "Quem fez isso com ela?!"

# game/chapters/chapter4/script/ch4sc1.rpy:137
translate brazil ch4sc1_f81a5540:

#   mc "Not here..."
    mc "Não aqui..."

# game/chapters/chapter4/script/ch4sc1.rpy:138
translate brazil ch4sc1_a1987b23:

#   mc "Come, we can talk in my room."
    mc "Venha, podemos conversar no meu quarto."

# game/chapters/chapter4/script/ch4sc1.rpy:144
translate brazil ch4sc1_bec68b4a:

#   mc "Rest up..."
    mc "Descanse..."

# game/chapters/chapter4/script/ch4sc1.rpy:145
translate brazil ch4sc1_7d87c9f7:

#   mc "We’ll get your legs working in no time."
    mc "Em pouco tempo, suas pernas estarão funcionando corretamente."

# game/chapters/chapter4/script/ch4sc1.rpy:147
translate brazil ch4sc1_d69ae112:

#   mc "I promise you, Eliza."
    mc "Eu te prometo, Eliza."

# game/chapters/chapter4/script/ch4sc1.rpy:148
translate brazil ch4sc1_a84e9c85:

#   mc "Nothing will stand in my way."
    mc "Nada ficará no meu caminho."

# game/chapters/chapter4/script/ch4sc1.rpy:155
translate brazil ch4sc1_b5f6bbd9:

#   mc "I will find a way, no matter the cost."
    mc "Encontrarei um jeito, custe o que custar."

# game/chapters/chapter4/script/ch4sc1.rpy:160
translate brazil ch4sc1_d0310960:

#   mc "I will tear this city apart to find him."
    mc "Vou destruir esta cidade para encontrá-lo."

# game/chapters/chapter4/script/ch4sc1.rpy:161
translate brazil ch4sc1_1a566c53:

#   mc "And when I do, he will know the definition of terror."
    mc "E quando eu fizer isso, ele saberá a definição de terror."

# game/chapters/chapter4/script/ch4sc1.rpy:164
translate brazil ch4sc1_a09f8c86:

#   mc "He will pay for this."
    mc "Ele vai pagar por isso."

# game/chapters/chapter4/script/ch4sc1.rpy:166
translate brazil ch4sc1_d91b3a51:

#   mc "He claimed you were a weakness."
    mc "Ele alegou que você era uma fraqueza."

# game/chapters/chapter4/script/ch4sc1.rpy:167
translate brazil ch4sc1_06529ad3:

#   mc "Don’t you dare believe that, even for a second."
    mc "Nem pense nisso, nem por um segundo."

# game/chapters/chapter4/script/ch4sc1.rpy:169
translate brazil ch4sc1_c8b3447e:

#   mc "He couldn’t be more wrong. You’re not my weakness..."
    mc "Ele não poderia estar mais enganado. Você não é minha fraqueza..."

# game/chapters/chapter4/script/ch4sc1.rpy:170
translate brazil ch4sc1_59b7e5b2:

#   mc "You’re my strength. You hear me?"
    mc "Você é a minha força. Está me ouvindo?"

# game/chapters/chapter4/script/ch4sc1.rpy:172
translate brazil ch4sc1_a4ed88bd:

#   mc "I’ve spent the last decade in misery. Struggling at every turn."
    mc "Passei a última década em sofrimento. Lutando a cada passo."

# game/chapters/chapter4/script/ch4sc1.rpy:173
translate brazil ch4sc1_e64dac3a:

#   mc "The only thing on my mind was to avenge the death of my parents."
    mc "A única coisa em que eu pensava era em vingar a morte dos meus pais."

# game/chapters/chapter4/script/ch4sc1.rpy:175
translate brazil ch4sc1_f9834115:

#   mc "But then I met you."
    mc "Mas aí eu te conheci."

# game/chapters/chapter4/script/ch4sc1.rpy:176
translate brazil ch4sc1_a2f28c92:

#   mc "And slowly things started to change. I didn’t want to admit it at first, but you’ve taught me so much."
    mc "E aos poucos as coisas começaram a mudar. No início, eu não queria admitir, mas você me ensinou muito."

# game/chapters/chapter4/script/ch4sc1.rpy:178
translate brazil ch4sc1_b6c46339:

#   mc "Every day with you has made me feel more alive than I ever expected."
    mc "Cada dia com você me fez sentir mais viva do que jamais imaginei."

# game/chapters/chapter4/script/ch4sc1.rpy:179
translate brazil ch4sc1_1a639242:

#   mc "You've supported me at every turn... and you’ve given me new purpose."
    mc "Você me apoiou em todos os momentos... e me deu um novo propósito."

# game/chapters/chapter4/script/ch4sc1.rpy:181
translate brazil ch4sc1_66f3d2c4:

#   mct "There’s nothing I wouldn’t do for you. Nothing."
    mct "Não há nada que eu não faria por você. Nada."

# game/chapters/chapter4/script/ch4sc1.rpy:182
translate brazil ch4sc1_69921b4f:

#   mc "*Heavy Sigh* ..."
    mc "*Suspiro pesado* ..."

# game/chapters/chapter4/script/ch4sc1.rpy:183
translate brazil ch4sc1_1e1b445d:

#   "You run your hand through her soft silky hair one last time before you get up..."
    "Você passa a mão pelos cabelos macios e sedosos dela uma última vez antes de se levantar..."

# game/chapters/chapter4/script/ch4sc1.rpy:191
translate brazil ch4sc1_c47126d2:

#   br "Will the lass be alright?"
    br "A moça ficará bem?"

# game/chapters/chapter4/script/ch4sc1.rpy:192
translate brazil ch4sc1_e532700b:

#   br "What in the shambles happened earlier?"
    br "Que diabos aconteceu mais cedo?"

# game/chapters/chapter4/script/ch4sc1.rpy:193
translate brazil ch4sc1_22081485:

#   br "Ye bolted outta here as if ye were chased by a ghost."
    br "Vocês saíram correndo daqui como se estivessem sendo perseguidos por um fantasma."

# game/chapters/chapter4/script/ch4sc1.rpy:195
translate brazil ch4sc1_dfb41048:

#   al "I heard you mentioning her legs? Did someone do this to her?"
    al "Ouvi você mencionar as pernas dela? Alguém fez isso com ela?"

# game/chapters/chapter4/script/ch4sc1.rpy:197
translate brazil ch4sc1_a2d87dde:

#   mc "*Sigh* Yes. Someone..."
    mc "*Suspiro* Sim. Alguém..."

# game/chapters/chapter4/script/ch4sc1.rpy:199
translate brazil ch4sc1_ed169743:

#   mc "The same someone who murdered Mama and Papa in cold blood."
    mc "A mesma pessoa que assassinou mamãe e papai a sangue frio."

# game/chapters/chapter4/script/ch4sc1.rpy:201
translate brazil ch4sc1_cc5a47f1:

#   mc "All because of what I am... Everyone who gets close to me ends up hurt or worse."
    mc "Tudo por causa de quem eu sou... Todos que se aproximam de mim acabam machucados ou pior."

# game/chapters/chapter4/script/ch4sc1.rpy:203
translate brazil ch4sc1_d57d96e9:

#   mc "Look at her."
    mc "Olhe para ela."

# game/chapters/chapter4/script/ch4sc1.rpy:205
translate brazil ch4sc1_7e7175f3:

#   mc "She’s innocent in all of this. Yet because she's dear to me, he targeted her."
    mc "Ela é inocente em tudo isso. Mesmo assim, por ser muito querida para mim, ele a escolheu como alvo."

# game/chapters/chapter4/script/ch4sc1.rpy:206
translate brazil ch4sc1_764ca998:

#   mc "Hurt her, Alice. Crippled her..."
    mc "Machuque-a, Alice. Deixe-a aleijada..."

# game/chapters/chapter4/script/ch4sc1.rpy:208
translate brazil ch4sc1_d68af11f:

#   al "[mc]... Don’t blame yourself for this... you couldn’t have known."
    al "[mc]...Não se culpe por isso...você não tinha como saber."

# game/chapters/chapter4/script/ch4sc1.rpy:209
translate brazil ch4sc1_bfe2a9d3:

#   al "I know that's probably hard to see right now... but this is not your fault."
    al "Eu sei que provavelmente é difícil enxergar isso agora... mas a culpa não é sua."

# game/chapters/chapter4/script/ch4sc1.rpy:211
translate brazil ch4sc1_795c2ca0:

#   br "Aye... listen te the lass, ye can’t shoulder this on yer own."
    br "Sim... escute a moça, você não pode carregar isso sozinha."

# game/chapters/chapter4/script/ch4sc1.rpy:213
translate brazil ch4sc1_b4a104a9:

#   al "The only one to blame for this is the creep who hurt her and killed your parents!"
    al "O único culpado por isso é o crápula que a machucou e matou seus pais!"

# game/chapters/chapter4/script/ch4sc1.rpy:215
translate brazil ch4sc1_210267b5:

#   mc "I... I appreciate what you guys are trying to do, but it is my fault."
    mc "Eu... eu agradeço o que vocês estão tentando fazer, mas a culpa é minha."

# game/chapters/chapter4/script/ch4sc1.rpy:216
translate brazil ch4sc1_a5f65d85:

#   mc "Nothing can change that."
    mc "Nada pode mudar isso."

# game/chapters/chapter4/script/ch4sc1.rpy:218
translate brazil ch4sc1_446e4ba1:

#   mc "I should’ve been prepared... what did I expect?"
    mc "Eu devia ter estado preparado... o que eu esperava?"

# game/chapters/chapter4/script/ch4sc1.rpy:219
translate brazil ch4sc1_c9c2cc22:

#   mc "That he would just let me track him down without putting up a fight?"
    mc "Que ele simplesmente me deixaria rastreá-lo sem oferecer resistência?"

# game/chapters/chapter4/script/ch4sc1.rpy:221
translate brazil ch4sc1_86cd6fe8:

#   mc "Could you guys watch over her for a while?"
    mc "Vocês poderiam cuidar dela por um tempo?"

# game/chapters/chapter4/script/ch4sc1.rpy:223
translate brazil ch4sc1_71da4e42:

#   al "What do you mean?"
    al "O que você quer dizer?"

# game/chapters/chapter4/script/ch4sc1.rpy:225
translate brazil ch4sc1_b1122d3b:

#   mc "There’s someone I have to go see, they might be able to help Eliza."
    mc "Preciso falar com alguém, essa pessoa talvez possa ajudar a Eliza."

# game/chapters/chapter4/script/ch4sc1.rpy:227
translate brazil ch4sc1_8255e4e8:

#   br "Sure, kid. Go on."
    br "Claro, garoto. Continue."

# game/chapters/chapter4/script/ch4sc1.rpy:228
translate brazil ch4sc1_c6223ed4:

#   br "We'll stay put and watch over her."
    br "Vamos ficar aqui e cuidar dela."

# game/chapters/chapter4/script/ch4sc1.rpy:230
translate brazil ch4sc1_8f81ec25:

#   al "[mc], I-I..."
    al "[mc], II..."

# game/chapters/chapter4/script/ch4sc1.rpy:231
