    lll "{b}*Grita* Você não é nada! Hnnrr! Está me ouvindo?? NADA!!{/b}"

# game/chapters/chapter4/script/ch4sc12.rpy:981
translate brazil ch4sc12_3f439bce:

#   lll "You think you can flirt with me for years and then turn all of your attention on the new guy?!"
