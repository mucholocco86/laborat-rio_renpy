# game/chapters/chapter4/script/ch4sc12.rpy:582
translate brazil ch4sc12_d90dec84:

#   mc "When I first stepped onboard your ship-"
    mc "Quando pisei pela primeira vez a bordo do seu navio-"

# game/chapters/chapter4/script/ch4sc12.rpy:583
translate brazil ch4sc12_88666f90:

#   ki "The Bloody Banshee."
    ki "A Banshee Sangrenta."

# game/chapters/chapter4/script/ch4sc12.rpy:584
translate brazil ch4sc12_05500ff6:

#   mc "Huh?"
    mc "Huh?"

# game/chapters/chapter4/script/ch4sc12.rpy:585
translate brazil ch4sc12_740fa12d:

#   ki "That’s her name."
    ki "Esse é o nome dela."

# game/chapters/chapter4/script/ch4sc12.rpy:586
translate brazil ch4sc12_7d12d01d:

#   ki "You're part of her crew now, you should address her as such."
    ki "Agora você faz parte da equipe dela, então deve tratá-la como tal."

# game/chapters/chapter4/script/ch4sc12.rpy:588
translate brazil ch4sc12_716019b8:

#   mc "Right."
    mc "Certo."

# game/chapters/chapter4/script/ch4sc12.rpy:589
translate brazil ch4sc12_2fe5ac38:

#   mc "When I first stepped aboard ‘The Bloody Banshee’."
    mc "Quando embarquei pela primeira vez em 'The Bloody Banshee'."

# game/chapters/chapter4/script/ch4sc12.rpy:591
translate brazil ch4sc12_eb3264c3:

#   mc "I never imagined the two of us would be sitting here... together."
    mc "Eu jamais imaginei que nós dois estaríamos sentados aqui... juntos."

# game/chapters/chapter4/script/ch4sc12.rpy:592
translate brazil ch4sc12_1db8c565:

#   ki "Obviously. You didn’t even know Looter’s Bay existed."
    ki "Obviamente. Você nem sabia que a Baía dos Saqueadores existia."

# game/chapters/chapter4/script/ch4sc12.rpy:593
translate brazil ch4sc12_959e67ea:

#   mc "You know what I mean."
    mc "Você sabe o que eu quero dizer."

# game/chapters/chapter4/script/ch4sc12.rpy:595
translate brazil ch4sc12_76715009:

#   ki "I- Yeah. I do."
    ki "Sim, eu concordo."

# game/chapters/chapter4/script/ch4sc12.rpy:596
translate brazil ch4sc12_4f7efda8:

#   ki "I’m quite surprised at myself, to be fair."
    ki "Para ser sincera, estou bastante surpresa comigo mesma."

# game/chapters/chapter4/script/ch4sc12.rpy:597
translate brazil ch4sc12_4a515ef1:

#   ki "I’ve been so patient with you..."
    ki "Tenho sido tão paciente com você..."

# game/chapters/chapter4/script/ch4sc12.rpy:599
translate brazil ch4sc12_26fd4fae:

#   mc "Hmh. Is that what you call it? I'd call it-"
    mc "Hum. É assim que se chama? Eu chamaria de..."

# game/chapters/chapter4/script/ch4sc12.rpy:600
translate brazil ch4sc12_ca7cd5a9:

#   ki "Don’t make me regret bringing you here!"
    ki "Não me faça me arrepender de ter te trazido aqui!"

# game/chapters/chapter4/script/ch4sc12.rpy:602
translate brazil ch4sc12_db0633a5:

#   mc "*Chuckles* Alright, alright. I’m just pulling your leg... sorta."
    mc "*Risos* Tá bom, tá bom. Tô só brincando... mais ou menos."

# game/chapters/chapter4/script/ch4sc12.rpy:603
translate brazil ch4sc12_d9ed3f79:

#   ki "*Smirks* Ass."
    ki "*Sorri de canto* Bunda."

# game/chapters/chapter4/script/ch4sc12.rpy:605
translate brazil ch4sc12_95237a7b:

#   ki "It’s getting late. We should head back and get some rest. We’re leaving at first light."
    ki "Está ficando tarde. Devemos voltar e descansar um pouco. Partiremos ao amanhecer."

# game/chapters/chapter4/script/ch4sc12.rpy:606
translate brazil ch4sc12_beae84fd:

#   mc "Hmm, actually..."
    mc "Hum, na verdade..."

# game/chapters/chapter4/script/ch4sc12.rpy:607
translate brazil ch4sc12_30c61d51:

#   mc "If you don’t mind, I'll stay here a little while longer."
    mc "Se não se importar, ficarei aqui mais um pouco."

# game/chapters/chapter4/script/ch4sc12.rpy:609
translate brazil ch4sc12_9e3e232e:

#   ki "Sure. I’ll see you tomorrow."
    ki "Claro. Te vejo amanhã."

# game/chapters/chapter4/script/ch4sc12.rpy:616
translate brazil ch4sc12_45af85cb:

#   mct "Kira’s very different from who I thought she was when we first met."
    mct "Kira é muito diferente da pessoa que eu imaginava quando nos conhecemos."

# game/chapters/chapter4/script/ch4sc12.rpy:617
translate brazil ch4sc12_e71bdc01:

#   mct "She's worried about me. I never expected that."
    mct "Ela está preocupada comigo. Eu nunca esperava por isso."

# game/chapters/chapter4/script/ch4sc12.rpy:618
translate brazil ch4sc12_bcebbd04:

#   mct "I’m not sure what to think of her father, though. She seems convinced he's going to make a move against me."
    mct "Não sei bem o que pensar do pai dela. Ela parece convencida de que ele vai fazer alguma coisa contra mim."

# game/chapters/chapter4/script/ch4sc12.rpy:619
translate brazil ch4sc12_ab4f908a:

#   mct "Not that it would be surprising, though. No 'king' of pirates is likely to be very friendly."
    mct "Mas isso não seria nenhuma surpresa. Nenhum \"rei\" dos piratas provavelmente seria muito amigável."

# game/chapters/chapter4/script/ch4sc12.rpy:620
translate brazil ch4sc12_ee797883:

#   mct "Then there's that ring of his... If it really is an enchanted ring, then it won't do any good in his hands."
    mct "E tem aquele anel dele... Se for mesmo um anel encantado, não vai adiantar nada nas mãos dele."

# game/chapters/chapter4/script/ch4sc12.rpy:621
translate brazil ch4sc12_31339c22:

#   mct "If I could bring it back to Dalen and Sylph, maybe they could see if it's connected to Borri's ring."
    mct "Se eu pudesse levar isso de volta para Dalen e Sylph, talvez eles pudessem ver se está relacionado ao anel de Borri."

# game/chapters/chapter4/script/ch4sc12.rpy:622
translate brazil ch4sc12_5a144253:

#   mct "Hmmh."
    mct "Hum."

# game/chapters/chapter4/script/ch4sc12.rpy:623
translate brazil ch4sc12_611f7094:

#   mct "Kira seemed vulnerable tonight?"
    mct "Kira pareceu vulnerável esta noite?"

# game/chapters/chapter4/script/ch4sc12.rpy:624
translate brazil ch4sc12_d8287eb7:

#   mct "Sharing her special spot with me... maybe she longs to connect with someone."
    mct "Compartilhando seu lugar especial comigo... talvez ela anseie por se conectar com alguém."

# game/chapters/chapter4/script/ch4sc12.rpy:625
translate brazil ch4sc12_638bb814:

#   mct "And for some reason, she's comfortable enough with me that she thinks I could be that someone."
    mct "E por algum motivo, ela se sente tão à vontade comigo que acha que eu poderia ser essa pessoa."

# game/chapters/chapter4/script/ch4sc12.rpy:626
translate brazil ch4sc12_a6105c77:

#   mct "*Sigh* Do I really need to add someone else to the list of people I care about?"
    mct "*Suspiro* Será que preciso mesmo adicionar mais alguém à lista de pessoas com quem me importo?"

# game/chapters/chapter4/script/ch4sc12.rpy:627
translate brazil ch4sc12_a8242d8b:

#   mct "Guess it's too late, I already do care about her and Pearl, even Kelly has been a breath of fresh air."
    mct "Acho que é tarde demais, eu já me importo com ela e com a Pearl, até a Kelly tem sido um sopro de ar fresco."

# game/chapters/chapter4/script/ch4sc12.rpy:628
translate brazil ch4sc12_60a77000:

#   mct "However... it'll only put them in danger."
    mct "No entanto... isso só os colocará em perigo."

# game/chapters/chapter4/script/ch4sc12.rpy:629
translate brazil ch4sc12_02c15d14:

#   mct "Taron... he’s made it clear that anyone I'm close with is a target."
    mct "Taron... ele deixou bem claro que qualquer pessoa próxima a mim é um alvo."

# game/chapters/chapter4/script/ch4sc12.rpy:630
translate brazil ch4sc12_2207341d:

#   mct "Kira is no pushover, though. She and Pearl have lived amongst danger their entire lives…"
    mct "Kira não é nenhuma boba. Ela e Pérola viveram em meio ao perigo a vida inteira…"

# game/chapters/chapter4/script/ch4sc12.rpy:631
translate brazil ch4sc12_78acdcc2:

#   mct "As soon as Eliza is back on her feet. I’m going straight for that bastard…"
    mct "Assim que Eliza estiver de pé novamente, vou direto atrás daquele desgraçado…"

# game/chapters/chapter4/script/ch4sc12.rpy:632
translate brazil ch4sc12_dac2dde2:

#   mct "Whatever twisted plans he seems to have for me, I don’t intend to sit around and wait for his next move."
    mct "Quaisquer que sejam os planos perversos que ele pareça ter para mim, não pretendo ficar sentada esperando seu próximo movimento."

# game/chapters/chapter4/script/ch4sc12.rpy:634
translate brazil ch4sc12_72c0365d:

#   mct "Eliza... I miss you."
    mct "Eliza... Sinto sua falta."

# game/chapters/chapter4/script/ch4sc12.rpy:640
translate brazil ch4sc12_55758466:

#   "As the Arc-stone lights up, a faint humming echoes throughout the room"
    "Conforme a Pedra Arcana se ilumina, um zumbido fraco ecoa por toda a sala."

# game/chapters/chapter4/script/ch4sc12.rpy:642
translate brazil ch4sc12_63c96801:

#   elt "Urrhh... what’s going on?"
    elt "Urrhh... o que está acontecendo?"

# game/chapters/chapter4/script/ch4sc12.rpy:643
translate brazil ch4sc12_bf7a3450:

#   elt "Huh?"
    elt "Huh?"

# game/chapters/chapter4/script/ch4sc12.rpy:646
translate brazil ch4sc12_5bff682f:

#   elt "{b}OH! OHH!!{/b}"
    elt "{b}OH! OHH!!{/b}"

# game/chapters/chapter4/script/ch4sc12.rpy:649
translate brazil ch4sc12_4e6ed7aa:

#   elt "*Grunts* Hhnnnh!"
    elt "*Grunhidos* Hhnnnh!"

# game/chapters/chapter4/script/ch4sc12.rpy:652
translate brazil ch4sc12_74afa7aa:

#   elt "{b}[mc]!{/b} It has to be [mc]!"
    elt "{b}[mc]!{/b} Tem que ser [mc]!"

# game/chapters/chapter4/script/ch4sc12.rpy:655
translate brazil ch4sc12_b442b606:

#   elt "Got it!"
    elt "Entendi!"

# game/chapters/chapter4/script/ch4sc12.rpy:658
translate brazil ch4sc12_cdc0b460:

#   el "[mc]? Is- Is it really you? Can you hear me?"
    el "[mc] É você mesmo? Você consegue me ouvir?"

# game/chapters/chapter4/script/ch4sc12.rpy:659
translate brazil ch4sc12_0c439d20:

#   mc "Hey, little one…"
    mc "Ei, pequenino…"

# game/chapters/chapter4/script/ch4sc12.rpy:660
translate brazil ch4sc12_f7e68355:

#   mc "How are you holding up?"
    mc "Como você está?"

# game/chapters/chapter4/script/ch4sc12.rpy:661
translate brazil ch4sc12_9a171ce3:

#   el "I’m... good."
    el "Estou bem."

# game/chapters/chapter4/script/ch4sc12.rpy:663
translate brazil ch4sc12_63cb197e:

#   el "Much better, now that I’m hearing your voice."
    el "Muito melhor agora que estou ouvindo sua voz."

# game/chapters/chapter4/script/ch4sc12.rpy:664
translate brazil ch4sc12_594393f4:

#   el "How does this work? It’s like we’re talking but it’s inside my head."
    el "Como isso funciona? É como se estivéssemos conversando, mas está acontecendo dentro da minha cabeça."

# game/chapters/chapter4/script/ch4sc12.rpy:665
translate brazil ch4sc12_07be5b0e:

#   el "Am I dreaming?"
    el "Estou sonhando?"

# game/chapters/chapter4/script/ch4sc12.rpy:667
translate brazil ch4sc12_9452bc7f:

#   mc "Not quite. The Arc-stone binds our minds when it's activated, letting us communicate telepathically."
    mc "Não exatamente. A Pedra Arcana vincula nossas mentes quando ativada, permitindo-nos comunicar telepaticamente."

# game/chapters/chapter4/script/ch4sc12.rpy:668
translate brazil ch4sc12_7c887fc0:

#   el "Woah... Wai-Wait! Does that mean you can read my thoughts?!"
    el "Uau... Espera aí! Isso significa que você consegue ler meus pensamentos?!"

# game/chapters/chapter4/script/ch4sc12.rpy:670
translate brazil ch4sc12_1f68200a:

#   mc "Hah, no. Not exactly."
    mc "Ah, não. Não exatamente."

# game/chapters/chapter4/script/ch4sc12.rpy:671
translate brazil ch4sc12_64b72a94:

#   mc "Why? Is there anything you don’t want me to know?"
    mc "Por quê? Há algo que você não quer que eu saiba?"

# game/chapters/chapter4/script/ch4sc12.rpy:675
translate brazil ch4sc12_38148d9c:

#   el "Oh definitely! There’s so much I’m keeping from you! If only you knew! *Giggles*"
    el "Ah, com certeza! Tem tanta coisa que estou escondendo de você! Se você soubesse! *Risos*"

# game/chapters/chapter4/script/ch4sc12.rpy:676
translate brazil ch4sc12_e48ae9ff:

#   mc "It’s good to hear you laugh again."
    mc "Que bom te ouvir rir de novo."

# game/chapters/chapter4/script/ch4sc12.rpy:677
translate brazil ch4sc12_f715720e:

#   mc "Eliza... I’m-"
    mc "Eliza... Eu sou-"

# game/chapters/chapter4/script/ch4sc12.rpy:678
translate brazil ch4sc12_89c1d39e:

#   el "I know."
    el "Eu sei."

# game/chapters/chapter4/script/ch4sc12.rpy:679
translate brazil ch4sc12_cba1eccb:

#   el "You don’t have to say it. I know you had to leave…"
    el "Você não precisa dizer isso. Eu sei que você teve que ir embora…"

# game/chapters/chapter4/script/ch4sc12.rpy:680
translate brazil ch4sc12_7732215e:

#   el "At first, I was so upset with you. But that was just me lashing out... sorry."
    el "No começo, fiquei muito chateada com você. Mas foi só um desabafo... desculpe."

# game/chapters/chapter4/script/ch4sc12.rpy:681
translate brazil ch4sc12_c8451d7b:

#   mc "You’re the last person in all of Midomir that should be sorry."
    mc "Você é a última pessoa em todo Midomir que deveria se desculpar."

# game/chapters/chapter4/script/ch4sc12.rpy:682
translate brazil ch4sc12_264509d2:

#   mc "You had every right to react like you did. You must have felt so helpless in that moment."
    mc "Você tinha todo o direito de reagir daquela forma. Você deve ter se sentido completamente impotente naquele momento."

# game/chapters/chapter4/script/ch4sc12.rpy:683
translate brazil ch4sc12_18d2c465:

#   el "You- You understand?"
    el "Você... você entende?"

# game/chapters/chapter4/script/ch4sc12.rpy:684
translate brazil ch4sc12_45d787bf:

#   mc "Yeah. Oren walked away from you. Your mother walked away. And now I-"
    mc "Sim. Oren te abandonou. Sua mãe te abandonou. E agora eu..."

# game/chapters/chapter4/script/ch4sc12.rpy:685
translate brazil ch4sc12_3574c0f5:

#   el "You haven’t walked away. You’re out there for me. And, you’re here with me now."
    el "Você não me abandonou. Você está lá fora por minha causa. E você está aqui comigo agora."

# game/chapters/chapter4/script/ch4sc12.rpy:686
translate brazil ch4sc12_582436a4:

#   el "I hate not being able to hug you."
    el "Odeio não poder te abraçar."

# game/chapters/chapter4/script/ch4sc12.rpy:687
translate brazil ch4sc12_8ddf7442:

#   mc "Yeah... it sucks."
    mc "É... é péssimo."

# game/chapters/chapter4/script/ch4sc12.rpy:688
translate brazil ch4sc12_f895d10a:

#   mc "How about everytime you feel like giving me a hug, you save it in your treasury?"
    mc "Que tal se, toda vez que você sentir vontade de me dar um abraço, você guardar essa lembrança no seu tesouro?"

# game/chapters/chapter4/script/ch4sc12.rpy:689
translate brazil ch4sc12_052e066a:

#   el "*Giggles* What? Like a stash of hugs?"
    el "*Risos* O quê? Tipo um estoque de abraços?"

# game/chapters/chapter4/script/ch4sc12.rpy:690
translate brazil ch4sc12_662cdc52:

#   mc "*Chuckles* Heh… Yeah, something like that. And once we see each other again..."
    mc "*Risos* Heh… É, algo assim. E quando nos virmos de novo…"

# game/chapters/chapter4/script/ch4sc12.rpy:691
translate brazil ch4sc12_5a3d93dc:

#   mc "You can cash in all of your stored hugs."
    mc "Você pode resgatar todos os seus abraços acumulados."

# game/chapters/chapter4/script/ch4sc12.rpy:692
translate brazil ch4sc12_76b95b78:

#   el "{b}!!!!!!!!!!!!{/b}"
    el "{b}!!!!!!!!!!!!{/b}"

# game/chapters/chapter4/script/ch4sc12.rpy:694
translate brazil ch4sc12_05be38f5:

#   el "That’s so cute!"
    el "Que fofo!"

# game/chapters/chapter4/script/ch4sc12.rpy:695
translate brazil ch4sc12_db8672d8:

#   mc "It’s not..."
    mc "Não é..."

# game/chapters/chapter4/script/ch4sc12.rpy:696
translate brazil ch4sc12_cdf2a677:

#   el "{b}CUTE!{/b} Oh! OHH! I’m going to store a lot more than just hugs! *Giggles*"
    el "{b}BONITINHO!{/b} Oh! Ohh! Vou guardar muito mais do que apenas abraços! *Risos*"

# game/chapters/chapter4/script/ch4sc12.rpy:697
translate brazil ch4sc12_f1ef8e1e:

#   mc "Great. What did I just get myself into?"
    mc "Ótimo. Em que enrascada eu me meti?"

# game/chapters/chapter4/script/ch4sc12.rpy:698
translate brazil ch4sc12_01615964:

#   el "*Giggles* You’ll see! And don’t act like you’re against it."
    el "*Risos* Você vai ver! E não aja como se fosse contra."

# game/chapters/chapter4/script/ch4sc12.rpy:699
translate brazil ch4sc12_93bc853f:

#   el "We both know you suck at playing tough with me!"
    el "Nós dois sabemos que você é péssimo em bancar o durão comigo!"

# game/chapters/chapter4/script/ch4sc12.rpy:700
translate brazil ch4sc12_feba58ce:

#   mc "Damn you... Fine! I look forward to you cashing in too."
    mc "Maldito seja você... Tudo bem! Estou ansioso para que você também lucre com isso."

# game/chapters/chapter4/script/ch4sc12.rpy:701
translate brazil ch4sc12_708ebd91:

#   el "That’s more like it! Now you better sit down, 'cause I have so much to tell you!"
    el "Isso sim! Agora é melhor você se sentar, porque tenho tanta coisa para te contar!"

# game/chapters/chapter4/script/ch4sc12.rpy:702
translate brazil ch4sc12_8cafd260:

#   mc "Sitting as we speak."
    mc "Neste exato momento, estamos sentados aqui."

# game/chapters/chapter4/script/ch4sc12.rpy:703
translate brazil ch4sc12_b9ee3e79:

#   el "Okay, so... I’ll start with Alice."
    el "Certo, então... vou começar com Alice."

# game/chapters/chapter4/script/ch4sc12.rpy:704
translate brazil ch4sc12_42111639:

#   el "She’s joined the Academy of Learning. She’s been going every day since you left."
    el "Ela entrou para a Academia de Aprendizagem. Ela tem ido todos os dias desde que você foi embora."

# game/chapters/chapter4/script/ch4sc12.rpy:705
translate brazil ch4sc12_81c33070:

#   el "She must really be into that alchemy and herbology stuff. Or maybe she has a hot teacher?"
    el "Ela deve ser mesmo fã de alquimia e herbologia. Ou talvez ela tenha um professor gato?"

# game/chapters/chapter4/script/ch4sc12.rpy:706
translate brazil ch4sc12_186d9511:

#   mc "Probably both."
    mc "Provavelmente ambos."

# game/chapters/chapter4/script/ch4sc12.rpy:707
translate brazil ch4sc12_2200c0b1:

#   el "*Giggles* Right! And-and Borri! He’s been lugging me around in his trader’s cart."
    el "*Risos* É isso aí! E o Borri! Ele anda me carregando no carrinho de comerciante dele."

# game/chapters/chapter4/script/ch4sc12.rpy:708
translate brazil ch4sc12_de359806:

#   el "He pretends it’s hard on him, but I’ve caught him smiling every time I ask to go somewhere."
    el "Ele finge que é difícil para ele, mas eu o flagrei sorrindo toda vez que o convido para ir a algum lugar."

# game/chapters/chapter4/script/ch4sc12.rpy:709
translate brazil ch4sc12_880fb20b:

#   el "I think he's just enjoying having me out and about."
    el "Acho que ele está simplesmente gostando de me ver por aí."

# game/chapters/chapter4/script/ch4sc12.rpy:710
translate brazil ch4sc12_a187d3df:

#   el "He’s also busting his ass at the guild. He's saving up all the coin he can, but he still refuses to tell me what it’s for."
    el "Ele também está se matando de trabalhar na guilda. Está juntando todas as moedas que consegue, mas ainda se recusa a me dizer para que é."

# game/chapters/chapter4/script/ch4sc12.rpy:711
translate brazil ch4sc12_d1527e12:

#   mc "Heh. He is stubborn, but I’ve never met anyone that can match your stubbornness."
    mc "Heh. Ele é teimoso, mas nunca conheci ninguém que se comparasse à sua teimosia."

# game/chapters/chapter4/script/ch4sc12.rpy:712
translate brazil ch4sc12_1c39c2f8:

#   el "Heh-Heh! It’s only a matter of time before he folds and reveals what he has planned."
    el "Heh-heh! É só uma questão de tempo até ele ceder e revelar o que planejou."

# game/chapters/chapter4/script/ch4sc12.rpy:713
translate brazil ch4sc12_ee0c8d87:

#   mc "Now, tell me about you. What have you been up to?"
    mc "Agora, me conte sobre você. O que você tem feito?"

# game/chapters/chapter4/script/ch4sc12.rpy:714
translate brazil ch4sc12_fcfa7c7f:

#   el "I’ve mostly spent the days reading in our room. Can’t exactly move around except for when Borri is here."
    el "Tenho passado a maior parte dos dias lendo no nosso quarto. Não consigo me movimentar muito, exceto quando o Borri está aqui."

# game/chapters/chapter4/script/ch4sc12.rpy:715
translate brazil ch4sc12_ad0ef6ef:

#   el "But that changed today!"
    el "Mas isso mudou hoje!"

# game/chapters/chapter4/script/ch4sc12.rpy:717
translate brazil ch4sc12_d9f1437a:

#   mc "Wai-Wait what?! You can walk again?"
    mc "Espera aí, o quê?! Você consegue andar de novo?"

# game/chapters/chapter4/script/ch4sc12.rpy:718
translate brazil ch4sc12_6db4ad91:

#   el "No... not quite. But Sylph surprised me today!"
    el "Não... não exatamente. Mas Sylph me surpreendeu hoje!"

# game/chapters/chapter4/script/ch4sc12.rpy:719
translate brazil ch4sc12_4772f989:

#   el "She cast a spell on me. And now whenever I’m near her, I can {b}FLY!!{/b}"
    el "Ela me enfeitiçou. E agora, sempre que estou perto dela, eu consigo... {b} VOAR!!{/b}"

# game/chapters/chapter4/script/ch4sc12.rpy:720
translate brazil ch4sc12_8a873b9c:

#   el "You should see me in action! Even Sylph fears to race me!"
    el "Você deveria me ver em ação! Até a Sylph tem medo de correr comigo!"

# game/chapters/chapter4/script/ch4sc12.rpy:721
translate brazil ch4sc12_21f26964:

#   mc "Woah... fly? That’s incredible. I know Sylph flies around all the time but..."
    mc "Uau... voar? Isso é incrível. Eu sei que a Sylph voa por aí o tempo todo, mas..."

# game/chapters/chapter4/script/ch4sc12.rpy:722
translate brazil ch4sc12_0024ed45:

#   mc "I never thought she would be able to make anyone else fly."
    mc "Eu nunca pensei que ela fosse capaz de fazer alguém mais voar."

# game/chapters/chapter4/script/ch4sc12.rpy:723
translate brazil ch4sc12_261aacf3:

#   el "It’s like an aura or something, she called it. It only works near her."
    el "É como uma aura ou algo assim, ela disse. Só funciona perto dela."

# game/chapters/chapter4/script/ch4sc12.rpy:724
translate brazil ch4sc12_62850767:

#   mc "Yeah that would make sense. But that’s amazing, Eliza."
    mc "Sim, faz sentido. Mas isso é incrível, Eliza."

# game/chapters/chapter4/script/ch4sc12.rpy:725
translate brazil ch4sc12_edba1c12:

#   mc "It sounds like it'll make things easier going forward."
    mc "Parece que isso vai facilitar as coisas daqui para frente."

# game/chapters/chapter4/script/ch4sc12.rpy:726
translate brazil ch4sc12_bc2df860:

#   el "Yeah... I’m going to be spending most of my time at the guild until you return."
    el "Sim... Vou passar a maior parte do meu tempo na guilda até você voltar."

# game/chapters/chapter4/script/ch4sc12.rpy:727
translate brazil ch4sc12_e8fce738:

#   el "Like Borri, I have something I want to save up for."
    el "Assim como Borri, eu também tenho algo para o qual quero juntar dinheiro."

# game/chapters/chapter4/script/ch4sc12.rpy:728
translate brazil ch4sc12_42162a1e:

#   mc "Do tell."
    mc "Conte-me tudo."

# game/chapters/chapter4/script/ch4sc12.rpy:729
translate brazil ch4sc12_d055568a:

#   el "Nuh-Uh! It’s going to be a surprise for you- Us!"
    el "Não, não! Vai ser uma surpresa para você... para nós!"

# game/chapters/chapter4/script/ch4sc12.rpy:730
translate brazil ch4sc12_64eb8a47:

#   mc "If you’re trying to ignite my curiosity so that I return faster, it’s working."
    mc "Se você está tentando despertar minha curiosidade para que eu volte mais rápido, está funcionando."

# game/chapters/chapter4/script/ch4sc12.rpy:731
translate brazil ch4sc12_e0a78eff:

#   el "Yay! Then that’s exactly what I’m doing!"
    el "Eba! Então é exatamente isso que estou fazendo!"

# game/chapters/chapter4/script/ch4sc12.rpy:732
translate brazil ch4sc12_e55c27d6:

#   el "Speaking of curiosity..."
    el "Por falar em curiosidade..."

# game/chapters/chapter4/script/ch4sc12.rpy:733
translate brazil ch4sc12_bd2f1c87:

#   el "Would you like to know what I’m wearing right now?"
    el "Você gostaria de saber o que estou vestindo agora?"

# game/chapters/chapter4/script/ch4sc12.rpy:742
translate brazil ch4sc12_7ebd40dd:

#   mc "You'd better tell me. In vivid detail."
    mc "É melhor você me contar. Com detalhes vívidos."

# game/chapters/chapter4/script/ch4sc12.rpy:743
translate brazil ch4sc12_67678cdb:

#   "Eliza likes that you're interested, her trust has increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Eliza gosta do seu interesse, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc12.rpy:745
translate brazil ch4sc12_fa1f58e8:

#   el "I’m wearing... nothing."
    el "Estou vestindo... nada."

# game/chapters/chapter4/script/ch4sc12.rpy:746
translate brazil ch4sc12_c477386f:

#   el "All that’s covering me is our blanket. It still has some of your scent."
    el "A única coisa que me cobre é o nosso cobertor. Ele ainda tem um pouco do seu cheiro."

# game/chapters/chapter4/script/ch4sc12.rpy:748
translate brazil ch4sc12_5daa14fc:

#   mc "I’ve got nothing here with your scent on it, but I remember it as if you were here."
    mc "Não tenho nada aqui com o seu cheiro, mas me lembro como se você estivesse aqui."

# game/chapters/chapter4/script/ch4sc12.rpy:750
translate brazil ch4sc12_297aa0e2:

#   el "Oh yeah? Does my scent entice you?"
    el "Ah, é? Meu perfume te atrai?"

# game/chapters/chapter4/script/ch4sc12.rpy:751
translate brazil ch4sc12_07cf2dc0:

#   mc "You’ve got no idea. The smell of your soft, raven-colored hair... Dreamveil & Sunroot."
    mc "Você não faz ideia. O cheiro do seu cabelo macio, cor de ébano... Dreamveil & Sunroot."

# game/chapters/chapter4/script/ch4sc12.rpy:752
translate brazil ch4sc12_40745d1a:

#   el "I love how you always remember my scent, it's so... primal and yet... incredibly romantic."
    el "Adoro como você sempre se lembra do meu cheiro, é tão... primitivo e, ao mesmo tempo... incrivelmente romântico."

# game/chapters/chapter4/script/ch4sc12.rpy:753
translate brazil ch4sc12_dd5ef13e:

#   mc "I also remember the taste of your luscious lips... the feeling of your smooth, naked skin against mine."
    mc "Também me lembro do sabor dos seus lábios deliciosos... da sensação da sua pele macia e nua contra a minha."

# game/chapters/chapter4/script/ch4sc12.rpy:755
translate brazil ch4sc12_5a6e102d:

#   el "*Breath quickens* Heavens... I miss your touch!"
    el "*Respiração acelerada* Céus... Que saudade do seu toque!"

# game/chapters/chapter4/script/ch4sc12.rpy:756
translate brazil ch4sc12_6a4b5b29:

#   el "[mc]... my breasts crave your attention…"
    el "[mc]...meus seios anseiam pela sua atenção…"

# game/chapters/chapter4/script/ch4sc12.rpy:758
translate brazil ch4sc12_2db05a27:

#   el "*Whimpers* {b}NnHhh!{/b}"
    el "*Geme* {b} NnHhh!{/b}"

# game/chapters/chapter4/script/ch4sc12.rpy:765
translate brazil ch4sc12_9bd3ac9a:

#   mc "Are you touching your breasts?"
    mc "Você está tocando seus seios?"

# game/chapters/chapter4/script/ch4sc12.rpy:767
translate brazil ch4sc12_31eb9769:

#   el "Y-Yes. They’re really soft and warm."
    el "S-Sim. Eles são muito macios e quentinhos."

# game/chapters/chapter4/script/ch4sc12.rpy:769
translate brazil ch4sc12_450ce091:

#   el "{b}Mnnhh!!{/b} [mc]. I really want you to touch them."
    el "{b}Mnnhh!!{/b}  [mc] Eu realmente quero que você os toque."

# game/chapters/chapter4/script/ch4sc12.rpy:770
translate brazil ch4sc12_cc54d48f:

#   el "I need you..."
    el "Eu preciso de você..."

# game/chapters/chapter4/script/ch4sc12.rpy:771
translate brazil ch4sc12_3a7dd3ce:

#   el "*Moans* I’m squeezing them for you. Nnhh! Yes…"
    el "*Gemidos* Estou apertando-os para você. Nnhh! Sim…"

# game/chapters/chapter4/script/ch4sc12.rpy:773
translate brazil ch4sc12_72462998:

#   mc "You’ve got no idea how badly I want to be with you right now."
    mc "Você não faz ideia de como eu quero estar com você agora."

# game/chapters/chapter4/script/ch4sc12.rpy:780
translate brazil ch4sc12_f7d0795b:

#   el "I’m going to store this in the treasury!"
    el "Vou guardar isso no tesouro!"

# game/chapters/chapter4/script/ch4sc12.rpy:782
translate brazil ch4sc12_bbcdf608:

#   el "You'd better have plenty of stamina when you return. I intend to use every ounce you have."
    el "É melhor você ter muita energia quando voltar. Pretendo usar cada gota que você tiver."

# game/chapters/chapter4/script/ch4sc12.rpy:784
translate brazil ch4sc12_670484bc:

#   mc "I’m already looking forward to our date."
    mc "Já estou ansioso pelo nosso encontro."

# game/chapters/chapter4/script/ch4sc12.rpy:786
translate brazil ch4sc12_c51dc2ca:

#   el "I’ve thought about it every day since we talked about it."
    el "Tenho pensado nisso todos os dias desde que conversamos sobre o assunto."

# game/chapters/chapter4/script/ch4sc12.rpy:787
translate brazil ch4sc12_65699135:

#   el "I’ve never been as excited about anything before. I feel like I’m going to burst!"
    el "Nunca estive tão entusiasmada com nada antes. Sinto que vou explodir de tanta alegria!"

# game/chapters/chapter4/script/ch4sc12.rpy:789
translate brazil ch4sc12_1c6c6fc3:

#   mc "*Chuckles* I know what you mean..."
    mc "*Risos* Eu sei o que você quer dizer..."

# game/chapters/chapter4/script/ch4sc12.rpy:790
translate brazil ch4sc12_08393348:

#   mc "I’ve never been on a date before, you know?"
    mc "Eu nunca tive um encontro antes, sabe?"

# game/chapters/chapter4/script/ch4sc12.rpy:792
translate brazil ch4sc12_d4beac92:

#   el "Oh? I’m your first?"
    el "Ah? Sou o seu primeiro?"

# game/chapters/chapter4/script/ch4sc12.rpy:793
translate brazil ch4sc12_e13a2cc0:

#   el "Same goes for me... but it will be magical anyway! I have a feeling our date will include several... 'first times' for me."
    el "O mesmo vale para mim... mas mesmo assim será mágico! Tenho a sensação de que nosso encontro incluirá várias... 'primeiras vezes' para mim."

# game/chapters/chapter4/script/ch4sc12.rpy:794
translate brazil ch4sc12_6bd667ef:

#   mc "Yeah... I have a feeling it will, as long as you're ready for it."
    mc "Sim... tenho a sensação de que sim, contanto que você esteja preparado(a)."

# game/chapters/chapter4/script/ch4sc12.rpy:795
translate brazil ch4sc12_a5753a45:

#   el "I... I am, all that matters to me, is that we get to spend time together."
    el "Eu... eu só quero saber se podemos passar um tempo juntos."

# game/chapters/chapter4/script/ch4sc12.rpy:796
translate brazil ch4sc12_b05ac318:

#   el "I wouldn’t even mind if you took me fishing."
    el "Eu não me importaria nem um pouco se você me levasse para pescar."

# game/chapters/chapter4/script/ch4sc12.rpy:798
translate brazil ch4sc12_f67c0657:

#   mc "*Chuckles* Is that so?"
    mc "*Risos* É mesmo?"

# game/chapters/chapter4/script/ch4sc12.rpy:799
translate brazil ch4sc12_59971b08:

#   el "I take it back! No fishing please!"
    el "Retiro o que disse! Nada de pescar, por favor!"

# game/chapters/chapter4/script/ch4sc12.rpy:800
translate brazil ch4sc12_56fb6372:

#   el "Please don’t make me go fishing..."
    el "Por favor, não me faça ir pescar..."

# game/chapters/chapter4/script/ch4sc12.rpy:802
translate brazil ch4sc12_3dee3300:

#   mc "I thought kittens liked fish?"
    mc "Pensei que gatinhos gostassem de peixe?"

# game/chapters/chapter4/script/ch4sc12.rpy:804
translate brazil ch4sc12_eaa14367:

#   el "For eating! You dummy..."
    el "Para comer! Seu idiota..."

# game/chapters/chapter4/script/ch4sc12.rpy:805
translate brazil ch4sc12_07aa2c81:

#   el "*Giggles*"
    el "*Risos*"

# game/chapters/chapter4/script/ch4sc12.rpy:807
translate brazil ch4sc12_66a5117a:

#   mc "*Chuckles*"
    mc "*Risos*"

# game/chapters/chapter4/script/ch4sc12.rpy:809
translate brazil ch4sc12_0d441b3d:

#   mc "I have to get going now. We’re setting sail early in the morning."
    mc "Preciso ir agora. Vamos zarpar bem cedo pela manhã."

# game/chapters/chapter4/script/ch4sc12.rpy:811
translate brazil ch4sc12_a36e7337:

#   el "Awwh... I wish we could keep talking all night."
    el "Ah... Eu queria que pudéssemos ficar conversando a noite toda."

# game/chapters/chapter4/script/ch4sc12.rpy:812
translate brazil ch4sc12_f5085ce4:

#   el "Please be careful out there. And come back to me... soon."
    el "Por favor, tome cuidado lá fora. E volte para mim... logo."

# game/chapters/chapter4/script/ch4sc12.rpy:814
translate brazil ch4sc12_7cb9ac93:

#   mc "I will. Goodnight my kitten."
    mc "Sim, eu vou. Boa noite, meu gatinho."

# game/chapters/chapter4/script/ch4sc12.rpy:815
translate brazil ch4sc12_04b4845e:

#   el "Goodnight... my lion."
    el "Boa noite... meu leão."

# game/chapters/chapter4/script/ch4sc12.rpy:824
translate brazil ch4sc12_3bbfef4a:

#   mc "Tempting, but I’ve got to head back to the ship. We’re setting sail early in the morning…"
    mc "É tentador, mas preciso voltar para o navio. Partiremos bem cedo amanhã de manhã…"

# game/chapters/chapter4/script/ch4sc12.rpy:826
translate brazil ch4sc12_16dc8feb:

#   el "Awwh... alright. Thank you for reaching out... I needed this."
    el "Ah... tudo bem. Obrigada por entrar em contato... eu precisava disso."

# game/chapters/chapter4/script/ch4sc12.rpy:828
translate brazil ch4sc12_6b2e5954:

#   mc "We both did. I'll check in you again soon."
    mc "Nós dois fizemos isso. Entrarei em contato com você novamente em breve."

# game/chapters/chapter4/script/ch4sc12.rpy:830
translate brazil ch4sc12_6d8a6616:

#   el "Goodnight!"
    el "Boa noite!"

# game/chapters/chapter4/script/ch4sc12.rpy:834
translate brazil ch4sc12_22bcfc54:

#   mct "*Sigh* Everything seems to be going well back in the capital."
    mct "*Suspiro* Parece que tudo está indo bem de volta à capital."

# game/chapters/chapter4/script/ch4sc12.rpy:835
translate brazil ch4sc12_b069d127:

#   mct "I was slightly worried how she would cope with being immobilized."
    mct "Eu estava um pouco preocupada com a forma como ela lidaria com a imobilização."

# game/chapters/chapter4/script/ch4sc12.rpy:836
translate brazil ch4sc12_4d7ec851:

#   mct "It's good Borri and Sylph are watching out for her, they're definitely keeping her busy."
    mct "Que bom que Borri e Sylph estão cuidando dela, com certeza estão mantendo-a ocupada."

# game/chapters/chapter4/script/ch4sc12.rpy:837
translate brazil ch4sc12_e74b81e0:

#   mct "My life really has undergone quite the change since I met Eliza."
    mct "Minha vida realmente mudou bastante desde que conheci Eliza."

# game/chapters/chapter4/script/ch4sc12.rpy:838
translate brazil ch4sc12_6d40c0ba:

#   mct "At least that's what started it, but now..."
    mct "Pelo menos foi assim que tudo começou, mas agora..."

# game/chapters/chapter4/script/ch4sc12.rpy:839
translate brazil ch4sc12_cd289295:

#   mct "Now I'm making more friends than I know what to do with."
    mct "Agora estou fazendo mais amigos do que sei o que fazer com eles."

# game/chapters/chapter4/script/ch4sc12.rpy:840
translate brazil ch4sc12_4356664d:

#   mct "Oren always preached the importance of allies you can count on."
    mct "Oren sempre pregou a importância de ter aliados com os quais se possa contar."

# game/chapters/chapter4/script/ch4sc12.rpy:843
translate brazil ch4sc12_67089e6e:

#   mct "Eliza... I would do anything for her. I trust her blindly and she has my back."
    mct "Eliza... Eu faria qualquer coisa por ela. Confio nela cegamente e ela me protege."

# game/chapters/chapter4/script/ch4sc12.rpy:844
translate brazil ch4sc12_480a3514:

#   mct "She hasn't wavered from my side since I met her."
    mct "Ela não se afastou de mim desde que a conheci."

# game/chapters/chapter4/script/ch4sc12.rpy:845
translate brazil ch4sc12_41316dc2:

#   mct "She's one of the most amazing people I've ever met, headstrong and stubborn, cute and funny."
    mct "Ela é uma das pessoas mais incríveis que já conheci, obstinada e teimosa, fofa e engraçada."

# game/chapters/chapter4/script/ch4sc12.rpy:847
translate brazil ch4sc12_596da043:

#   mct "Kira... I can't believe I'm saying it but... we're friends... or something."
    mct "Kira... Não acredito que estou dizendo isso, mas... somos amigas... ou algo assim."

# game/chapters/chapter4/script/ch4sc12.rpy:848
translate brazil ch4sc12_72caa866:

#   mct "She's definitely a bit of a hothead, a fireball. But she cares."
    mct "Ela definitivamente é um pouco esquentada, uma verdadeira bomba-relógio. Mas ela se importa."

# game/chapters/chapter4/script/ch4sc12.rpy:849
translate brazil ch4sc12_153f6f36:

#   mct "Tonight made it clear, going forward I can rely on her..."
    mct "Esta noite ficou claro que, daqui para frente, posso confiar nela..."

# game/chapters/chapter4/script/ch4sc12.rpy:851
translate brazil ch4sc12_3947e3ac:

#   mct "Pearl... Easy-going, relaxed, enjoying every moment presented to her. For a pair of twins they couldn't be more different."
    mct "Pearl... Tranquila, relaxada, aproveitando cada momento que lhe é apresentado. Para um par de gêmeas, elas não poderiam ser mais diferentes."

# game/chapters/chapter4/script/ch4sc12.rpy:852
translate brazil ch4sc12_8fdaab44:

#   mct "I would definitely consider Pearl a friend. She's been kind and understanding towards me."
    mct "Com certeza considero Pearl uma amiga. Ela tem sido gentil e compreensiva comigo."

# game/chapters/chapter4/script/ch4sc12.rpy:853
translate brazil ch4sc12_524a5442:

#   mct "And our late night talks has really helped take my mind off all that's been going on."
    mct "E nossas conversas noturnas realmente me ajudaram a me distrair de tudo o que tem acontecido."

# game/chapters/chapter4/script/ch4sc12.rpy:855
translate brazil ch4sc12_fb938455:

#   mct "Then there's Kelly."
    mct "E depois tem a Kelly."

# game/chapters/chapter4/script/ch4sc12.rpy:856
translate brazil ch4sc12_becd214f:

#   mct "Sweet young girl... she has the world awaiting her and she is eager to explore it."
    mct "Doce menina... o mundo inteiro está à sua espera e ela está ansiosa para explorá-lo."

# game/chapters/chapter4/script/ch4sc12.rpy:857
translate brazil ch4sc12_52834fab:

#   mct "She's the daughter of Luxenford nobles, Lady Maggie and Lord Edward, yet she's spent her life at sea as a... Sea-born."
    mct "Ela é filha dos nobres de Luxemburgo, Lady Maggie e Lord Edward, mas passou a vida no mar como uma... Nascida no Mar."

# game/chapters/chapter4/script/ch4sc12.rpy:858
translate brazil ch4sc12_21b93743:

#   mct "She is sweet to Flynn and seems to enjoy his stupid jokes... *Chuckles* Even when they're slightly inappropriate."
    mct "Ela é carinhosa com o Flynn e parece gostar das piadas bobas dele... *Risos* Mesmo quando são um pouco inapropriadas."

# game/chapters/chapter4/script/ch4sc12.rpy:859
translate brazil ch4sc12_f49f9371:

#   mct "That says a lot about her character."
    mct "Isso diz muito sobre o caráter dela."

# game/chapters/chapter4/script/ch4sc12.rpy:861
translate brazil ch4sc12_818dfa4a:

#   mct "Alice... we haven't had a moment to ourselves to properly talk."
    mct "Alice... ainda não tivemos um momento a sós para conversar direito."

# game/chapters/chapter4/script/ch4sc12.rpy:862
translate brazil ch4sc12_e9200b91:

#   mct "I can't imagine it was easy for her coming all the way to the capital and then have me running off."
    mct "Não consigo imaginar que tenha sido fácil para ela vir até a capital e depois me ver fugir."

# game/chapters/chapter4/script/ch4sc12.rpy:863
translate brazil ch4sc12_300cd045:

#   mct "She has feelings for me, I'm not oblivious to that... but am I able to return her feelings?"
    mct "Ela tem sentimentos por mim, eu não sou alheio a isso... mas será que sou capaz de retribuir esses sentimentos?"

# game/chapters/chapter4/script/ch4sc12.rpy:864
translate brazil ch4sc12_721d01a3:

#   mct "It's something I'll have to be cautious about, she means a lot to me and I don't want to hurt her."
    mct "É algo com que terei de ter cautela, ela significa muito para mim e não quero magoá-la."

# game/chapters/chapter4/script/ch4sc12.rpy:866
translate brazil ch4sc12_7a6cc550:

#   mct "Rin..."
    mct "Também..."

# game/chapters/chapter4/script/ch4sc12.rpy:867
translate brazil ch4sc12_8737bada:

#   mct "We've not been able to reach out to one another... despite her giving me an Arcstone."
    mct "Não conseguimos entrar em contato uma com a outra... apesar dela ter me dado uma Arcstone."

# game/chapters/chapter4/script/ch4sc12.rpy:868
translate brazil ch4sc12_7888ed09:

#   mct "I've tried a couple of times over the years... *Exhales* She likely hates me for leaving."
    mct "Tentei algumas vezes ao longo dos anos... *Suspira* Ela provavelmente me odeia por ter ido embora."

# game/chapters/chapter4/script/ch4sc12.rpy:869
translate brazil ch4sc12_81ceee6b:

#   mct "I can't blame her... we were at the height of our relationship and I just... up and left."
    mct "Não posso culpá-la... estávamos no auge do nosso relacionamento e eu simplesmente... fui embora."

# game/chapters/chapter4/script/ch4sc12.rpy:870
translate brazil ch4sc12_0ff2fee8:

#   mct "I hope I get a chance to reconnect with her some day..."
    mct "Espero ter a oportunidade de reencontrá-la algum dia..."

# game/chapters/chapter4/script/ch4sc12.rpy:872
translate brazil ch4sc12_3ab4eb1c:

#   mct "*Sigh* And then there's Sylph... that little fae is something else."
    mct "*Suspiro* E depois tem a Sylph... aquela pequena fada é algo de outro mundo."

# game/chapters/chapter4/script/ch4sc12.rpy:873
translate brazil ch4sc12_93719207:

#   mct "Cheerful, excitable, reliable. Those are just a few terms I'd use to describe her."
    mct "Alegre, entusiasmada, confiável. Esses são apenas alguns termos que eu usaria para descrevê-la."

# game/chapters/chapter4/script/ch4sc12.rpy:874
translate brazil ch4sc12_76e9b3e3:

#   mct "I don't know how long she has been teamed up with Dalen, they're running the guild together which means he trusts her."
    mct "Não sei há quanto tempo ela está trabalhando com Dalen, eles administram a guilda juntos, o que significa que ele confia nela."

# game/chapters/chapter4/script/ch4sc12.rpy:875
translate brazil ch4sc12_d526c0d6:

#   mct "Before I left, she sensed my magic, but it also allowed me to sense hers... she's genuine to the core."
    mct "Antes de eu partir, ela sentiu a minha magia, mas isso também me permitiu sentir a dela... ela é genuína até a medula."

# game/chapters/chapter4/script/ch4sc12.rpy:878
translate brazil ch4sc12_0e8c81bc:

#   mct "And now, Sylph's looking out for Eliza? Giving her something to be excited about? I appreciate that."
    mct "E agora, Sylph está cuidando de Eliza? Dando a ela um motivo para se animar? Agradeço isso."

# game/chapters/chapter4/script/ch4sc12.rpy:879
translate brazil ch4sc12_c8344c17:

#   mct "*Heavy sigh* ..."
    mct "*Suspiro pesado* ..."

# game/chapters/chapter4/script/ch4sc12.rpy:880
translate brazil ch4sc12_1b81999c:

#   mct "What am I doing with all of them? They clearly have grown fond of me... And I of them."
    mct "O que estou fazendo com todos eles? É evidente que eles se afeiçoaram a mim... e eu a eles."

# game/chapters/chapter4/script/ch4sc12.rpy:881
translate brazil ch4sc12_de77a4e8:

#   mct "I care for all of them in their own way. The last thing I want is for any of them to get hurt."
    mct "Eu me importo com todos eles à sua maneira. A última coisa que eu quero é que algum deles se machuque."

# game/chapters/chapter4/script/ch4sc12.rpy:882
translate brazil ch4sc12_42007260:

#   mct "But do I even know how I feel? I've never imagined to be in such a situation..."
    mct "Mas será que eu sequer sei como me sinto? Nunca imaginei estar numa situação dessas..."

# game/chapters/chapter4/script/ch4sc12.rpy:883
translate brazil ch4sc12_7262dfa4:

#   mct "The goal has always been clear. Kill the man who murdered my parents."
    mct "O objetivo sempre foi claro: matar o homem que assassinou meus pais."

# game/chapters/chapter4/script/ch4sc12.rpy:884
translate brazil ch4sc12_2d3e3cc5:

#   mct "Now it's all muddied... Friends... Allies... Companions... Lovers."
    mct "Agora está tudo confuso... Amigos... Aliados... Companheiros... Amantes."

# game/chapters/chapter4/script/ch4sc12.rpy:885
translate brazil ch4sc12_e5494c8b:

#   mct "I can't make a decision right now. I can't be distracted by... Feelings."
    mct "Não consigo tomar uma decisão agora. Não posso me deixar distrair por... sentimentos."

# game/chapters/chapter4/script/ch4sc12.rpy:886
translate brazil ch4sc12_81f16813:

#   mct "Once Taron is dealt with. Then I can figure out what it is I really feel. And for whom."
    mct "Assim que Taron estiver resolvido, poderei descobrir o que realmente sinto. E por quem."

