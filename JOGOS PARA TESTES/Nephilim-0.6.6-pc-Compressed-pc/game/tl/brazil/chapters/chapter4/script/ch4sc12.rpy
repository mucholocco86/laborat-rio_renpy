# ARQUIVO: game/chapters/chapter4/script/ch4sc12.rpy DIALOGOS: 671


# game/chapters/chapter4/script/ch4sc12.rpy:10
translate brazil ch4sc12_3c81f773:

#   ki "Okay, we’re here. ‘Creed’s Chunky Chicken’..."
    ki "Ok, chegamos. 'Frango em pedaços do Creed'..."

# game/chapters/chapter4/script/ch4sc12.rpy:12
translate brazil ch4sc12_bd8d420a:

#   mc "'Chunky Chicken'?"
    mc "'Frango em pedaços'?"

# game/chapters/chapter4/script/ch4sc12.rpy:13
translate brazil ch4sc12_41239e87:

#   mc "Do I even want to know?"
    mc "Será que eu quero mesmo saber?"

# game/chapters/chapter4/script/ch4sc12.rpy:15
translate brazil ch4sc12_6c32b78e:

#   ki "Probably not."
    ki "Provavelmente não."

# game/chapters/chapter4/script/ch4sc12.rpy:16
translate brazil ch4sc12_adaa71fc:

#   ki "But if you're curious... over there."
    ki "Mas se você estiver curioso... ali."

# game/chapters/chapter4/script/ch4sc12.rpy:19
translate brazil ch4sc12_32d02638:

#   mc "Damn. I see your point."
    mc "Puxa. Entendi seu ponto de vista."

# game/chapters/chapter4/script/ch4sc12.rpy:20
translate brazil ch4sc12_bfc28aef:

#   ki "Creed won’t tell anyone why he always keeps a fat chick here. But every time they grow up ..."
    ki "Creed não conta a ninguém por que sempre mantém uma garota gordinha por perto. Mas toda vez que elas crescem..."

# game/chapters/chapter4/script/ch4sc12.rpy:22
translate brazil ch4sc12_b613930f:

#   ki "He gets a new one and wastes no time fattening it up."
    ki "Ele pega uma nova e não perde tempo em engordá-la."

# game/chapters/chapter4/script/ch4sc12.rpy:24
translate brazil ch4sc12_b9412ac4:

#   ki "Personally, I think he eats them."
    ki "Pessoalmente, acho que ele os come."

# game/chapters/chapter4/script/ch4sc12.rpy:27
translate brazil ch4sc12_918cfe01:

#   cc "Squueeek!"
    cc "Squeeek!"

# game/chapters/chapter4/script/ch4sc12.rpy:29
translate brazil ch4sc12_3dc0a005:

#   cr "Hey! Stop scaring the poor fella!"
    cr "Ei! Pare de assustar o coitado!"

# game/chapters/chapter4/script/ch4sc12.rpy:30
translate brazil ch4sc12_226c9dfb:

#   cr "You might be the boss’s daughter, but I’ll still toss you out on your ass, Kira!"
    cr "Você pode até ser filha do chefe, mas mesmo assim vou te mandar embora na hora, Kira!"

# game/chapters/chapter4/script/ch4sc12.rpy:32
translate brazil ch4sc12_d8b93a5a:

#   ki "Yeah, yeah, Creed... you’re lucky I’m in a good mood today."
    ki "É, é, Creed... você tem sorte de eu estar de bom humor hoje."

# game/chapters/chapter4/script/ch4sc12.rpy:33
translate brazil ch4sc12_25a4e69d:

#   ki "Otherwise I’d use you as sharkbait."
    ki "Caso contrário, eu te usaria como isca para tubarões."

# game/chapters/chapter4/script/ch4sc12.rpy:35
translate brazil ch4sc12_7a8dd97d:

#   ki "Come."
    ki "Vir."

# game/chapters/chapter4/script/ch4sc12.rpy:36
translate brazil ch4sc12_b712cd72:

#   ki "We shouldn’t keep father waiting. He isn’t known for his patience."
    ki "Não devemos deixar o pai esperando. Ele não é conhecido por sua paciência."

# game/chapters/chapter4/script/ch4sc12.rpy:38
translate brazil ch4sc12_a5d65af9:

#   ki "Remember, let me do the talking. You’ll just say something stupid and get yourself killed…"
    ki "Lembre-se, deixe-me falar. Você só vai dizer alguma besteira e acabar morto..."

# game/chapters/chapter4/script/ch4sc12.rpy:39
translate brazil ch4sc12_6e438683:

#   mc "Concerned for my safety?"
    mc "Preocupado(a) com a minha segurança?"

# game/chapters/chapter4/script/ch4sc12.rpy:41
translate brazil ch4sc12_679ad3db:

#   ki "Wha- No!"
    ki "O quê?! Não!"

# game/chapters/chapter4/script/ch4sc12.rpy:42
translate brazil ch4sc12_82be81c1:

#   ki "I-I don’t care what happens to you! I mean, I do-"
    ki "Eu não me importo com o que aconteça com você! Quer dizer, eu me importo sim."

# game/chapters/chapter4/script/ch4sc12.rpy:43
translate brazil ch4sc12_252c62d2:

#   ki "Ugh! Just keep quiet and do as I say for once!"
    ki "Ah! Fique quieto e faça o que eu mando desta vez!"

# game/chapters/chapter4/script/ch4sc12.rpy:45
translate brazil ch4sc12_c93a24ae:

#   ki "I’m trying to help you here, in case you didn’t notice."
    ki "Estou tentando te ajudar aqui, caso você não tenha percebido."

# game/chapters/chapter4/script/ch4sc12.rpy:46
translate brazil ch4sc12_a9742802:

#   mc "So you do care."
    mc "Então você se importa, sim."

# game/chapters/chapter4/script/ch4sc12.rpy:47
translate brazil ch4sc12_840ed384:

#   mct "*Chuckles* She gets flustered so easily when I put her on the spot."
    mct "*Risos* Ela fica tão nervosa quando a coloco em situações constrangedoras."

# game/chapters/chapter4/script/ch4sc12.rpy:50
translate brazil ch4sc12_84bab88b:

#   "Kira remains silent as she enters the back room."
    "Kira permanece em silêncio ao entrar na sala dos fundos."

# game/chapters/chapter4/script/ch4sc12.rpy:64
translate brazil ch4sc12_0f53ee9c:

#   cb "Kira. What took you so long?"
    cb "Kira. Por que demorou tanto?"

# game/chapters/chapter4/script/ch4sc12.rpy:67
translate brazil ch4sc12_5dca34ca:

#   ki "Hi... Daddy."
    ki "Oi... papai."

# game/chapters/chapter4/script/ch4sc12.rpy:69
translate brazil ch4sc12_3bc5e53e:

#   cb "Don’t ‘daddy’ me."
    cb "Não me trate como um pai."

# game/chapters/chapter4/script/ch4sc12.rpy:70
translate brazil ch4sc12_d3b969e2:

#   cb "Your sister already stopped by to give me her full report."
    cb "Sua irmã já passou aqui para me dar o relatório completo."

# game/chapters/chapter4/script/ch4sc12.rpy:71
translate brazil ch4sc12_3cfc99c9:

#   cb "While you were fooling around with the ‘cargo’... Pearl came to see me straightaway, as she should."
    cb "Enquanto você estava se divertindo com a 'carga'... Pearl veio me ver imediatamente, como deveria."

# game/chapters/chapter4/script/ch4sc12.rpy:73
translate brazil ch4sc12_da5786ae:

#   ki "Daddy! I-"
    ki "Papai! Eu-"

# game/chapters/chapter4/script/ch4sc12.rpy:76
translate brazil ch4sc12_1b627c9c:

#   cb "Enough!"
    cb "Suficiente!"

# game/chapters/chapter4/script/ch4sc12.rpy:77
translate brazil ch4sc12_5f98a2b1:

#   cb "Go find your sister and get something to eat. You’ll anchor in the bay tonight and leave at first light."
    cb "Vá encontrar sua irmã e comer alguma coisa. Vocês vão ancorar na baía esta noite e partir ao amanhecer."

# game/chapters/chapter4/script/ch4sc12.rpy:79
translate brazil ch4sc12_6d67cc3d:

#   cb "I wish to have a chat with your friend here."
    cb "Gostaria de conversar com seu amigo aqui."

# game/chapters/chapter4/script/ch4sc12.rpy:81
translate brazil ch4sc12_ac6d98c8:

#   "As Kira turns to leave, she puts her hand on your arm."
    "Ao se virar para ir embora, Kira coloca a mão no seu braço."

# game/chapters/chapter4/script/ch4sc12.rpy:82
translate brazil ch4sc12_76dc7031:

#   "You can feel her arm trembling, she's clearly upset about her fathers reaction."
    "É possível sentir o braço dela tremendo; ela está claramente chateada com a reação do pai."

# game/chapters/chapter4/script/ch4sc12.rpy:85
translate brazil ch4sc12_878c3cb3:

#   kit "I'm... never good enough."
    kit "Eu... nunca sou bom o suficiente."

# game/chapters/chapter4/script/ch4sc12.rpy:87
translate brazil ch4sc12_b0a97dbc:

#   ki "*Whispers* {size=-10}{b}Come find me later… I’ll be at the docks.{/b}{/size}"
    ki "*Sussurros* {size=-10}{b}Venha me encontrar mais tarde... Estarei nas docas.{/b}{/size}"

# game/chapters/chapter4/script/ch4sc12.rpy:88
translate brazil ch4sc12_e2202d87:

#   ki "*Whispers* {size=-10}{b}There’s something I want to show you.{/b}{/size}"
    ki "*Sussurros* {size=-10}{b}Tem algo que eu quero te mostrar.{/b}{/size}"

# game/chapters/chapter4/script/ch4sc12.rpy:90
translate brazil ch4sc12_5b2eb6c5:

#   ki "*Whispers* {size=-10}{b}Make sure you aren’t followed.{/b}{/size}"
    ki "*Sussurros* {size=-10}{b}Certifique-se de que não está sendo seguido.{/b}{/size}"

# game/chapters/chapter4/script/ch4sc12.rpy:92
translate brazil ch4sc12_388385bd:

#   "Blackheart turns his gaze towards you."
    "Blackheart volta seu olhar para você."

# game/chapters/chapter4/script/ch4sc12.rpy:94
translate brazil ch4sc12_e3d45a47:

#   cb "You."
    cb "Você."

# game/chapters/chapter4/script/ch4sc12.rpy:95
translate brazil ch4sc12_b5d21dc2:

#   cb "Care to tell me why both my daughters have lost their heads over you?"
    cb "Você gostaria de me dizer por que minhas duas filhas perderam a cabeça por sua causa?"

# game/chapters/chapter4/script/ch4sc12.rpy:97
translate brazil ch4sc12_58c2fba2:

#   cb "First, Pearl rushes to see me, telling me how great you are and that I shouldn’t kill you."
    cb "Primeiro, Pearl corre para me ver, dizendo o quão incrível você é e que eu não deveria te matar."

# game/chapters/chapter4/script/ch4sc12.rpy:99
translate brazil ch4sc12_61900616:

#   cb "And now Kira finally delivers you, but not in chains as expected."
    cb "E agora Kira finalmente te entrega, mas não acorrentado como esperado."

# game/chapters/chapter4/script/ch4sc12.rpy:101
translate brazil ch4sc12_96d7d00b:

#   cb "Neither of them have shown much interest in boys before."
    cb "Nenhuma das duas havia demonstrado muito interesse por garotos antes."

# game/chapters/chapter4/script/ch4sc12.rpy:102
translate brazil ch4sc12_6c5d8103:

#   cb "And yet, here they are. Both acting out of character because of you."
    cb "E, no entanto, aqui estão eles. Ambos agindo de forma atípica por sua causa."

# game/chapters/chapter4/script/ch4sc12.rpy:104
translate brazil ch4sc12_fb7063c8:

#   cb "What is a father supposed to make of that?"
    cb "O que um pai deve pensar disso?"

# game/chapters/chapter4/script/ch4sc12.rpy:106
translate brazil ch4sc12_61ee5d6b:

#   cb "Am I to embrace you as your potential father-in-law?"
    cb "Devo aceitá-lo como seu potencial sogro?"

# game/chapters/chapter4/script/ch4sc12.rpy:107
translate brazil ch4sc12_d8805e0c:

#   cb "Or... should I hang you for daring to lay eyes on my daughters?"
    cb "Ou... devo enforcá-lo por ousar olhar para as minhas filhas?"

# game/chapters/chapter4/script/ch4sc12.rpy:114
translate brazil ch4sc12_2ce657bc:

#   mc "How about we skip these little games?"
    mc "Que tal deixarmos de lado esses joguinhos?"

# game/chapters/chapter4/script/ch4sc12.rpy:115
translate brazil ch4sc12_d371189f:

#   mc "They're boring, and I couldn't care less about your opinion of me."
    mc "Eles são chatos, e eu não dou a mínima para a sua opinião sobre mim."

# game/chapters/chapter4/script/ch4sc12.rpy:117
translate brazil ch4sc12_f4a71c9e:

#   mc "I’m only interested in reaching Inmortui. If anyone gets in my way... even you, 'King of pirates' ..."
    mc "Meu único objetivo é chegar a Inmortui. Se alguém se colocar no meu caminho... mesmo você, 'Rei dos Piratas'..."

# game/chapters/chapter4/script/ch4sc12.rpy:118
translate brazil ch4sc12_a1dfd54b:

#   mc "Then I will tear that person apart while your daughters watch."
    mc "Então eu vou despedaçar essa pessoa enquanto suas filhas assistem."

# game/chapters/chapter4/script/ch4sc12.rpy:119
translate brazil ch4sc12_66a12ae0:

#   mc "And then I'll burn this cozy little settlement to the ground."
    mc "E depois vou reduzir este pequeno e aconchegante povoado a cinzas."

# game/chapters/chapter4/script/ch4sc12.rpy:121
translate brazil ch4sc12_74045749:

#   "You managed to intimidate Blackheart enough to gain his respect, {b}{color=#fc584c}Intimidation{/color}{/b} increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Você conseguiu intimidar Blackheart o suficiente para ganhar o respeito dele. {b}{color=#fc584c}Intimidação{/color}{/b} aumentado por {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc12.rpy:127
translate brazil ch4sc12_8659b50d:

#   mc "How about a third option? I need to reach Inmortui."
    mc "Que tal uma terceira opção? Preciso entrar em contato com Inmortui."

# game/chapters/chapter4/script/ch4sc12.rpy:128
translate brazil ch4sc12_4f1bb550:

#   mc "The sooner we leave, the sooner I’ll be out of your hair."
    mc "Quanto mais cedo formos embora, mais cedo eu sairei do seu caminho."

# game/chapters/chapter4/script/ch4sc12.rpy:130
translate brazil ch4sc12_ad78bd6b:

#   mc "In return for safe passage, I'll make sure to retrieve valuables from Inmortui."
    mc "Em troca de uma passagem segura, eu me encarregarei de recuperar os objetos de valor de Inmortui."

# game/chapters/chapter4/script/ch4sc12.rpy:131
translate brazil ch4sc12_27fee287:

#   mc "Worst case scenario: I die, and you’re rid of me."
    mc "Na pior das hipóteses: eu morro e vocês se livram de mim."

# game/chapters/chapter4/script/ch4sc12.rpy:133
translate brazil ch4sc12_14c25fee:

#   mc "Best case, I return with some ancient loot for you."
    mc "Na melhor das hipóteses, volto com alguns tesouros antigos para você."

# game/chapters/chapter4/script/ch4sc12.rpy:134
translate brazil ch4sc12_04b6ea65:

#   mc "Either way, it's a good deal for you."
    mc "De qualquer forma, é um bom negócio para você."

# game/chapters/chapter4/script/ch4sc12.rpy:136
translate brazil ch4sc12_915a2f05:

#   "You managed to persuade Blackheart successfully! {b}{color=#2bff8b}Persuasion{/color}{/b} increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Você conseguiu persuadir Blackheart com sucesso! {b}{color=#2bff8b}Persuasão{/color}{/b} aumentado por {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc12.rpy:142
translate brazil ch4sc12_07bdfb02:

#   mc "Blackheart, you're a leader."
    mc "Blackheart, você é um líder."

# game/chapters/chapter4/script/ch4sc12.rpy:143
translate brazil ch4sc12_70514210:

#   mc "Which means I know you'll recognize my efforts."
    mc "Isso significa que sei que você reconhecerá meus esforços."

# game/chapters/chapter4/script/ch4sc12.rpy:145
translate brazil ch4sc12_03914214:

#   mc "Earlier you said Pearl has filled you in about everything, which means you know about the trouble in Luxenford."
    mc "Anteriormente você disse que Pearl lhe contou tudo, o que significa que você sabe sobre os problemas em Luxenford."

# game/chapters/chapter4/script/ch4sc12.rpy:146
translate brazil ch4sc12_f4badf34:

#   mc "That I was the one who secured our crew and ensured the wellbeing of them."
    mc "Fui eu quem garantiu a segurança da nossa equipe e o seu bem-estar."

# game/chapters/chapter4/script/ch4sc12.rpy:149
translate brazil ch4sc12_74b88448:

#   mc "Now, you may or may not care about your daughters crew, I don't know you well enough to make that observation."
    mc "Agora, você pode se importar ou não com a equipe de sua filha, eu não te conheço o suficiente para fazer essa observação."

# game/chapters/chapter4/script/ch4sc12.rpy:150
translate brazil ch4sc12_a687ff55:

#   mc "But you should know enough about me now that'll make you want to have me on your daughters manifest."
    mc "Mas agora você já deve saber o suficiente sobre mim para querer me incluir na lista de apadrinhamento da sua filha."

# game/chapters/chapter4/script/ch4sc12.rpy:151
translate brazil ch4sc12_67e232eb:

#   mc "Am I right?"
    mc "Estou certo?"

# game/chapters/chapter4/script/ch4sc12.rpy:152
translate brazil ch4sc12_3e47dccf:

#   "You managed to take control of the discussion and lead Blackheart's opinion successfully! {b}{color=#ffee54}Leadership{/color}{/b} increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Você conseguiu assumir o controle da discussão e influenciar a opinião de Blackheart com sucesso! {b}{color=#ffee54}Liderança{/color}{/b} aumentado por {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc12.rpy:158
translate brazil ch4sc12_a10632e5:

#   mc "Blackheart, you're a renowned Captain, and a undisputed leader of your pirates."
    mc "Blackheart, você é um capitão renomado e um líder indiscutível de seus piratas."

# game/chapters/chapter4/script/ch4sc12.rpy:159
translate brazil ch4sc12_6028749f:

#   mc "I've known you for less than an hour and yet I can clearly tell what you're after."
    mc "Eu te conheço há menos de uma hora e já consigo perceber claramente o que você quer."

# game/chapters/chapter4/script/ch4sc12.rpy:161
translate brazil ch4sc12_02d1c0ee:

#   mc "You want a future for your pirates where you're not fighting for scraps."
    mc "Você quer um futuro para seus piratas onde não precisem lutar por migalhas."

# game/chapters/chapter4/script/ch4sc12.rpy:162
translate brazil ch4sc12_82ecfdc1:

#   mc "You want prosperity and recognition as an official independant state."
    mc "Você almeja prosperidade e reconhecimento como um estado oficialmente independente."

# game/chapters/chapter4/script/ch4sc12.rpy:163
translate brazil ch4sc12_c1342760:

#   cb "*Scoffs* Hmm."
    cb "*Risos* Hum."

# game/chapters/chapter4/script/ch4sc12.rpy:166
translate brazil ch4sc12_5c9a08f3:

#   mc "Well guess what?"
    mc "Adivinha só?"

# game/chapters/chapter4/script/ch4sc12.rpy:167
translate brazil ch4sc12_8e8d7120:

#   mc "Allowing me to undertake this journey with your daughters will be a step towards that future."
    mc "Permitir que eu embarque nessa jornada com suas filhas será um passo em direção a esse futuro."

# game/chapters/chapter4/script/ch4sc12.rpy:168
translate brazil ch4sc12_c62f9f15:

#   mc "We're going to an infamous island that no sailors or any of your pirates dare step foot on..."
    mc "Vamos para uma ilha infame onde nenhum marinheiro ou pirata se atreve a pôr os pés..."

# game/chapters/chapter4/script/ch4sc12.rpy:169
translate brazil ch4sc12_9da50f26:

#   mc "Imagine the treasures we might come across... your chambers filled with gold and gems..."
    mc "Imagine os tesouros que poderíamos encontrar... seus aposentos repletos de ouro e pedras preciosas..."

# game/chapters/chapter4/script/ch4sc12.rpy:170
translate brazil ch4sc12_743bfbf7:

#   "You managed to sway Blackheart's opinion due to his lust for power and riches, {b}{color=#87e1fa}Charisma{/color}{/b} increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Você conseguiu influenciar a opinião de Blackheart devido à sua sede de poder e riquezas. {b}{color=#87e1fa}Carisma{/color}{/b} aumentado por {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc12.rpy:177
translate brazil ch4sc12_20bcf8bf:

#   cb "..."
    cb "..."

# game/chapters/chapter4/script/ch4sc12.rpy:179
translate brazil ch4sc12_86f9a468:

#   cb "Heh! The balls on you, kid."
    cb "Heh! A coragem é sua, garoto."

# game/chapters/chapter4/script/ch4sc12.rpy:180
translate brazil ch4sc12_2f339811:

#   cb "Hhmm..."
    cb "Hmmm..."

# game/chapters/chapter4/script/ch4sc12.rpy:182
translate brazil ch4sc12_efe1d94f:

#   cb "Alright. I’ve decided!"
    cb "Muito bem. Já me decidi!"

# game/chapters/chapter4/script/ch4sc12.rpy:183
translate brazil ch4sc12_3df542fe:

#   cb "I'll authorize your passage to Inmortui."
    cb "Autorizarei sua passagem para Inmortui."

# game/chapters/chapter4/script/ch4sc12.rpy:184
translate brazil ch4sc12_802d57c3:

#   cb "Pearl & Kira will supervise you. They'll have instructions to 'handle' you if you step out of line."
    cb "Pearl e Kira irão supervisioná-lo(a). Elas terão instruções sobre como lidar com você caso se comporte de maneira inadequada."

# game/chapters/chapter4/script/ch4sc12.rpy:185
translate brazil ch4sc12_16091fc8:

#   cb "Now, leave. Before I run out of goodwill."
    cb "Agora, vá embora. Antes que minha boa vontade acabe."

# game/chapters/chapter4/script/ch4sc12.rpy:187
translate brazil ch4sc12_7d3dc34d:

#   mc "One last thing before I leave."
    mc "Só mais uma coisa antes de eu ir."

# game/chapters/chapter4/script/ch4sc12.rpy:189
translate brazil ch4sc12_c19771a3:

#   mc "That’s quite an interesting ring you’re wearing."
    mc "Esse anel que você está usando é bem interessante."

# game/chapters/chapter4/script/ch4sc12.rpy:191
translate brazil ch4sc12_65717f81:

#   cb "Hmm."
    cb "Hum."

# game/chapters/chapter4/script/ch4sc12.rpy:192
translate brazil ch4sc12_e7ead6b5:

#   cb "This tacky old thing? Not all that interesting, I’m afraid. Just an old family heirloom…"
    cb "Essa coisa velha e brega? Não é lá muito interessante, receio. Apenas uma antiga herança de família…"

# game/chapters/chapter4/script/ch4sc12.rpy:194
translate brazil ch4sc12_b6bf8754:

#   cb "Now, was that all?"
