    kl "Vocês estão bem aí em cima? Parece que fomos atingidos por uma enorme explosão de canhão..."

# game/chapters/chapter4/script/ch4sc16.rpy:882
translate brazil ch4sc16_f8a5ba70:

#   kl "{b}[mc]!!{/b}"
    kl "{b}[mc]!!{/b}"

