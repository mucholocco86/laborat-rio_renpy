    kit "Onde ele está...? [mc]!"

# game/chapters/chapter4/script/ch4sc16.rpy:858
translate brazil ch4sc16_efb2a26d:

#   mct "*Grunts* Rrgh! That took... more... than I expected."
    mct "*Grunhidos* Argh! Isso levou... mais... do que eu esperava."

