translate brazil ch4sc19_cb5f2c75:

#   el "Okay! Okay... Phew! I'd better climb down. *Snickers*"
    el "Ok! Ok... Ufa! É melhor eu descer. *Risinhos*"

# game/chapters/chapter4/script/ch4sc19.rpy:2651
translate brazil ch4sc19_4b3eb56b:

#   el "Boooooo! *Sigh* Okay, I'll have my hug another time then."
    el "Buuuu! *Suspiro* Ok, então meu abraço fica para outra hora."

# game/chapters/chapter4/script/ch4sc19.rpy:2653
translate brazil ch4sc19_77393617:

#   el "*Exhales* Okay ... I’m calm."
    el "*Exala* Ok... Estou calmo."

# game/chapters/chapter4/script/ch4sc19.rpy:2656
translate brazil ch4sc19_03c0c659:

#   mc "Ready to get out of here?"
    mc "Pronto para sair daqui?"

# game/chapters/chapter4/script/ch4sc19.rpy:2657
translate brazil ch4sc19_16511054:

#   el "Yes!!"
    el "Sim!!"

# game/chapters/chapter4/script/ch4sc19.rpy:2659
translate brazil ch4sc19_fe2db332:

#   ml "Oh, hey. Welcome back [mc]."
    ml "Ah, olá. Bem-vindo de volta. [mc]."

# game/chapters/chapter4/script/ch4sc19.rpy:2660
translate brazil ch4sc19_dc13b7e2:

#   mc "Hey. Are you settling in alright?"
    mc "Olá. Você está se adaptando bem?"

# game/chapters/chapter4/script/ch4sc19.rpy:2661
translate brazil ch4sc19_cceb20ff:

#   ml "I sure am! Miss Eliza has been showing me the ropes and making sure I get appropriate quests for my skill level."
    ml "Com certeza! A senhorita Eliza tem me ensinado tudo e garantido que eu receba missões adequadas ao meu nível de habilidade."

# game/chapters/chapter4/script/ch4sc19.rpy:2663
translate brazil ch4sc19_6a9bcf7a:

#   mc "You’re in good hands with this one."
    mc "Com essa você está em boas mãos."

# game/chapters/chapter4/script/ch4sc19.rpy:2664
translate brazil ch4sc19_9261a6d8:

#   mc "She’s the most incredible and hardworking girl I know."
    mc "Ela é a garota mais incrível e trabalhadora que eu conheço."

# game/chapters/chapter4/script/ch4sc19.rpy:2666
translate brazil ch4sc19_513b058b:

#   el "*Whispers* {size=-10}{b}Shush you!{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Cala a boca!{/b}{/size}"

# game/chapters/chapter4/script/ch4sc19.rpy:2668
translate brazil ch4sc19_1c00a1da:

#   el "Bye Milton! If I don’t see you tomorrow before your quest, best of luck and remember to stick to the roads!"
    el "Tchau, Milton! Se eu não te vir amanhã antes da sua missão, boa sorte e lembre-se de ficar nas estradas!"

# game/chapters/chapter4/script/ch4sc19.rpy:2670
translate brazil ch4sc19_3a0fe337:

#   mc "*Whispers* {size=-10}{b}Milton? Since when are you on first name basis? Why can't he just be... guard?{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Milton? Desde quando vocês se tratam pelo primeiro nome? Por que ele não pode ser simplesmente... guarda?{/b}{/size}"

# game/chapters/chapter4/script/ch4sc19.rpy:2671
translate brazil ch4sc19_97ddf3a0:

#   el "*Whispers* {size=-10}{b}You’re terrible! ... Don’t tell me you’re jealous?!{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Você é terrível! ... Não me diga que você está com ciúmes?!{/b}{/size}"

# game/chapters/chapter4/script/ch4sc19.rpy:2672
translate brazil ch4sc19_82e1dce6:

#   mc "*Whispers*{size=-10}{b} No...{/b}{/size}"
    mc "*Sussurros*{size=-10}{b} Não...{/b}{/size}"

# game/chapters/chapter4/script/ch4sc19.rpy:2673
translate brazil ch4sc19_dfbf72b6:

#   el "*Whispers* {size=-10}{b}You totally are!{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Com certeza!{/b}{/size}"

# game/chapters/chapter4/script/ch4sc19.rpy:2674
translate brazil ch4sc19_fcbd18e0:

#   mc "*Sigh* ..."
    mc "*Suspirar* ..."

# game/chapters/chapter4/script/ch4sc19.rpy:2675
translate brazil ch4sc19_5e0229f6:

#   el "Good... It means you care."
    el "Que bom... Isso significa que você se importa."

# game/chapters/chapter4/script/ch4sc19.rpy:2676
translate brazil ch4sc19_ec2afe29:

#   mc "Yeah, yeah. C’mon, let’s get out of here."
    mc "Sim, sim. Vamos embora daqui."

# game/chapters/chapter4/script/ch4sc19.rpy:2679
translate brazil ch4sc19_9ab8888f:

#   el "I’m... hungry..."
    el "Estou com fome..."

# game/chapters/chapter4/script/ch4sc19.rpy:2680
translate brazil ch4sc19_8a6b9f76:

#   mc "I know. Not giving in to the hunger as soon as it presents itself is what you need to learn."
    mc "Eu sei. O que você precisa aprender é a não ceder à fome assim que ela aparece."

# game/chapters/chapter4/script/ch4sc19.rpy:2682
translate brazil ch4sc19_09ce698f:

#   el "*Sigh* I know... But it’s not like being hungry was before. It’s like my entire body is screaming at me."
    el "*Suspiro* Eu sei... Mas não é como sentir fome antes. É como se meu corpo inteiro estivesse gritando comigo."

# game/chapters/chapter4/script/ch4sc19.rpy:2683
translate brazil ch4sc19_3d60da6b:

#   el "It feels like I’m burning up everywhere under my skin..."
    el "Sinto como se estivesse queimando em todo o meu corpo..."

# game/chapters/chapter4/script/ch4sc19.rpy:2685
translate brazil ch4sc19_12f22967:

#   el "Every time we've passed a person since we left the guild, I've wanted to sink my teeth into their necks..."
    el "Desde que saímos da guilda, sempre que cruzamos com alguém, dá vontade de cravar meus dentes no pescoço dessa pessoa..."

# game/chapters/chapter4/script/ch4sc19.rpy:2686
translate brazil ch4sc19_36544fc5:

#   el "I can hear their hearts beating, pumping warm, delicious blood through their veins..."
    el "Consigo ouvir seus corações batendo, bombeando sangue quente e delicioso por suas veias..."

# game/chapters/chapter4/script/ch4sc19.rpy:2688
translate brazil ch4sc19_a9023054:

#   mc "Soon. I promise... You’re doing well keeping it at bay so far."
    mc "Em breve. Prometo... Você está se saindo bem em manter isso sob controle até agora."

# game/chapters/chapter4/script/ch4sc19.rpy:2689
translate brazil ch4sc19_8023292d:

#   mc "Let’s head up to the roof behind the tavern."
    mc "Vamos subir até o telhado atrás da taverna."

# game/chapters/chapter4/script/ch4sc19.rpy:2691
translate brazil ch4sc19_0ea7ffdf:

#   el "The roof sounds kinda nice... I like it there."
    el "O telhado parece bem agradável... Eu gosto de lá."

# game/chapters/chapter4/script/ch4sc19.rpy:2692
translate brazil ch4sc19_716d9e90:

#   el "Can I... bite you up there?"
    el "Posso... te morder aí em cima?"

# game/chapters/chapter4/script/ch4sc19.rpy:2695
translate brazil ch4sc19_d209500f:

#   el "Booo! You’re being mean..."
    el "Buuu! Você está sendo malvado..."

# game/chapters/chapter4/script/ch4sc19.rpy:2696
translate brazil ch4sc19_1c905fd0:

#   mc "We already talked about this. You need to learn how to feed properly if you want to control this."
    mc "Já falamos sobre isso. Você precisa aprender a alimentar corretamente se quiser controlar essa situação."

# game/chapters/chapter4/script/ch4sc19.rpy:2698
translate brazil ch4sc19_07495fea:

#   el "But you smell way better than everyone else."
    el "Mas você tem um cheiro muito melhor do que todo mundo."

# game/chapters/chapter4/script/ch4sc19.rpy:2699
translate brazil ch4sc19_03e38a3c:

#   el "I bet your blood tastes... angelic!"
    el "Aposto que seu sangue tem um gosto... angelical!"

# game/chapters/chapter4/script/ch4sc19.rpy:2701
translate brazil ch4sc19_8d187d43:

#   mc "That’s the thing... we're worried there might be side-effects if you drink my blood."
    mc "É isso mesmo... estamos preocupados que possa haver efeitos colaterais se você beber meu sangue."

# game/chapters/chapter4/script/ch4sc19.rpy:2702
translate brazil ch4sc19_8c3cf488:

#   mc "Vampires feed on mortals. There are too many unknowns... what if my blood burns you from the inside out?"
    mc "Vampiros se alimentam de mortais. Há muitas incógnitas... e se meu sangue te queimar de dentro para fora?"

# game/chapters/chapter4/script/ch4sc19.rpy:2703
translate brazil ch4sc19_cf8127f7:

#   mc "Until we know for certain... I won’t let you anywhere near mine."
    mc "Até termos certeza... não vou deixar você chegar perto da minha."

# game/chapters/chapter4/script/ch4sc19.rpy:2705
translate brazil ch4sc19_c6ddd455:

#   el "I understand... I hate it, but I understand."
    el "Eu entendo... Eu detesto isso, mas eu entendo."

# game/chapters/chapter4/script/ch4sc19.rpy:2707
translate brazil ch4sc19_ea797217:

#   el "Isn’t this the roof we sat on last night?"
    el "Não foi este o telhado onde nos sentamos ontem à noite?"

# game/chapters/chapter4/script/ch4sc19.rpy:2708
translate brazil ch4sc19_bc5545e1:

#   mc "Yeah, it is. It should be a good vantage point. It's off the main streets and drunks will walk through the alley."
    mc "Sim, é verdade. Deve ser um bom ponto de observação. Fica afastado das ruas principais e os bêbados costumam passar pelo beco."

# game/chapters/chapter4/script/ch4sc19.rpy:2710
translate brazil ch4sc19_ca1da346:

#   el "Eeuw! I don’t want to bite some filthy drunk!"
    el "Eca! Não quero morder nenhum bêbado imundo!"

# game/chapters/chapter4/script/ch4sc19.rpy:2711
translate brazil ch4sc19_59d13adf:

#   mc "Picking a target who’s drunk will make it easier ..."
    mc "Escolher um alvo bêbado tornará tudo mais fácil..."

# game/chapters/chapter4/script/ch4sc19.rpy:2712
translate brazil ch4sc19_97f894c6:

#   mc "And if they try to tell anyone, people will just put it down to them being too drunk."
    mc "E se eles tentarem contar para alguém, as pessoas simplesmente vão dizer que eles estão muito bêbados."

# game/chapters/chapter4/script/ch4sc19.rpy:2714
translate brazil ch4sc19_bd6eb1c6:

#   el "Mhhm... Makes sense. *Sigh* Fine."
    el "Hum... Faz sentido. *Suspiro* Tudo bem."

# game/chapters/chapter4/script/ch4sc19.rpy:2718
translate brazil ch4sc19_04c07819:

#   el "I already have a target in my sights..."
    el "Eu já tenho um alvo na mira..."

# game/chapters/chapter4/script/ch4sc19.rpy:2720
translate brazil ch4sc19_831c6d60:

#   el "You see... there’s this guy. He just recently came back to me... and everything’s changed again."
    el "Sabe... tem esse cara. Ele voltou para mim recentemente... e tudo mudou de novo."

# game/chapters/chapter4/script/ch4sc19.rpy:2721
translate brazil ch4sc19_8023ae93:

#   mc "Everything?"
    mc "Tudo?"

# game/chapters/chapter4/script/ch4sc19.rpy:2723
translate brazil ch4sc19_b73197b7:

#   el "Everything... except the way I feel about him."
    el "Tudo... exceto o que sinto por ele."

# game/chapters/chapter4/script/ch4sc19.rpy:2725
translate brazil ch4sc19_881bb439:

#   mc "I wonder who that could be."
    mc "Quem será essa pessoa?"

# game/chapters/chapter4/script/ch4sc19.rpy:2727
translate brazil ch4sc19_a569a5e7:

#   el "I’ll show you. Close your eyes."
    el "Eu vou te mostrar. Feche os olhos."

# game/chapters/chapter4/script/ch4sc19.rpy:2729
translate brazil ch4sc19_dacd0c95:

#   mc "Closed."
    mc "Fechado."

# game/chapters/chapter4/script/ch4sc19.rpy:2730
translate brazil ch4sc19_5db6e1c8:

#   el "Mh-Hm..."
    el "Hum-hum..."

# game/chapters/chapter4/script/ch4sc19.rpy:2732
translate brazil ch4sc19_5b94e1f2:

#   "You feel her warm breath against your lips, and her scent surrounds you like a warm blanket."
    "Você sente a respiração quente dela contra seus lábios, e o perfume dela te envolve como um cobertor aconchegante."

# game/chapters/chapter4/script/ch4sc19.rpy:2733
translate brazil ch4sc19_6aec5106:

#   el "Tell me. What do I smell like?"
    el "Diga-me. Que cheiro eu tenho?"

# game/chapters/chapter4/script/ch4sc19.rpy:2735
translate brazil ch4sc19_0be049b1:

#   mc "Your scent is delicate..."
    mc "Seu perfume é delicado..."

# game/chapters/chapter4/script/ch4sc19.rpy:2736
translate brazil ch4sc19_f8ce9e89:

#   mc "*Inhales* Dreamveil... Sunroot... with a subtle hint of citrus."
    mc "*Inspira* Dreamveil... Sunroot... com um toque sutil de cítricos."

# game/chapters/chapter4/script/ch4sc19.rpy:2738
translate brazil ch4sc19_5049a34a:

#   el "Your nose is as sharp as ever. You like it?"
    el "Seu nariz continua tão afilado como sempre. Você gosta?"

# game/chapters/chapter4/script/ch4sc19.rpy:2739
translate brazil ch4sc19_0b3bc929:

#   mc "It’s intoxicating... not very different from your usual scent, though."
    mc "É inebriante... mas não muito diferente do seu perfume habitual."

# game/chapters/chapter4/script/ch4sc19.rpy:2741
translate brazil ch4sc19_faa3f21f:

#   el "It’s a new perfume I bought recently..."
    el "É um perfume novo que comprei recentemente..."

# game/chapters/chapter4/script/ch4sc19.rpy:2743
translate brazil ch4sc19_7ad3983d:

#   el "I tried a few different ones, but then I remembered how you complimented my scent..."
    el "Experimentei alguns diferentes, mas aí me lembrei de como você elogiou meu perfume..."

# game/chapters/chapter4/script/ch4sc19.rpy:2745
translate brazil ch4sc19_f76f2bc7:

#   el "The lady in the shop showed me this one, she called it an enhancer. It's supposed to enhance your own natural scent."
    el "A moça da loja me mostrou este, ela chamou de intensificador. Supostamente, ele realça o seu cheiro natural."

# game/chapters/chapter4/script/ch4sc19.rpy:2747
translate brazil ch4sc19_6ee02920:

#   el "I wanted to wear it for your return..."
    el "Eu queria usá-lo para o seu retorno..."

# game/chapters/chapter4/script/ch4sc19.rpy:2748
translate brazil ch4sc19_38d1239f:

#   el "But you surprised me at the guild so I didn’t have a chance to wear it until now..."
    el "Mas você me surpreendeu na guilda, então não tive a chance de usá-lo até agora..."

# game/chapters/chapter4/script/ch4sc19.rpy:2750
translate brazil ch4sc19_5489675f:

#   mc "It’s definitely having an... effect on me."
    mc "Definitivamente está tendo um... efeito em mim."

# game/chapters/chapter4/script/ch4sc19.rpy:2751
translate brazil ch4sc19_6e3044f9:

#   mc "Your natural scent was already alluring as it was..."
    mc "Seu aroma natural já era sedutor por si só..."

# game/chapters/chapter4/script/ch4sc19.rpy:2753
translate brazil ch4sc19_7fe49739:

#   el "*Sensual whisper* Taste me..."
    el "*Sussurro sensual* Prove-me..."

# game/chapters/chapter4/script/ch4sc19.rpy:2754
translate brazil ch4sc19_95fd3f85:

#   "Her soft lips rest against yours, and you answer in kind."
    "Os lábios macios dela repousam contra os seus, e você retribui o gesto."

# game/chapters/chapter4/script/ch4sc19.rpy:2756
translate brazil ch4sc19_960663ba:

#   mct "There it is... her signature lip-sucking. She really is amazing."
    mct "Aí está... o jeito característico dela de chupar os lábios. Ela é realmente incrível."

# game/chapters/chapter4/script/ch4sc19.rpy:2758
translate brazil ch4sc19_6cb8f56c:

#   el "*Moans softly* Mmmmhh..."
    el "*Geme baixinho* Mmmmhh..."

# game/chapters/chapter4/script/ch4sc19.rpy:2759
translate brazil ch4sc19_fa3d9e8e:

#   mct "She really has the best lips in all the known realms..."
    mct "Ela realmente tem os lábios mais lindos de todos os reinos conhecidos..."

# game/chapters/chapter4/script/ch4sc19.rpy:2770
translate brazil ch4sc19_e0e2e9c4:

#   el "Nnnghh... Mmmmmmm..."
    el "Nnnghh... Mmmmmmm..."

# game/chapters/chapter4/script/ch4sc19.rpy:2771
translate brazil ch4sc19_533fe2db:

#   mct "Her tongue movements are unmatched... She’s massaging mine, covering it with her saliva."
    mct "Os movimentos da língua dela são incomparáveis... Ela está massageando a minha, cobrindo-a com sua saliva."

# game/chapters/chapter4/script/ch4sc19.rpy:2772
translate brazil ch4sc19_a2d201ad:

#   mct "It’s like each kiss is telling me how much she cares about me."
    mct "É como se cada beijo me dissesse o quanto ela se importa comigo."

# game/chapters/chapter4/script/ch4sc19.rpy:2773
translate brazil ch4sc19_97119cff:

#   elt "I don’t want to stop kissing him... Mhhh! We've got so many kisses to catch up on... *Licks*"
    elt "Não quero parar de beijá-lo... Mhhh! Temos tantos beijos para trocar... *Lambe*"

# game/chapters/chapter4/script/ch4sc19.rpy:2781
translate brazil ch4sc19_32f2c2d5:

#   el "*Heavy breathing * That was..."
    el "*Respiração ofegante* Isso foi..."

# game/chapters/chapter4/script/ch4sc19.rpy:2782
translate brazil ch4sc19_69a1b761:

#   mc "Hot."
    mc "Quente."

# game/chapters/chapter4/script/ch4sc19.rpy:2784
translate brazil ch4sc19_134a2697:

#   el "Scorching..."
    el "Escaldante..."

# game/chapters/chapter4/script/ch4sc19.rpy:2785
translate brazil ch4sc19_1a440d81:

#   mc "Blazing..."
    mc "Incandescente..."

# game/chapters/chapter4/script/ch4sc19.rpy:2787
translate brazil ch4sc19_acba5415:

#   el "Searing..."
    el "Ardente..."

# game/chapters/chapter4/script/ch4sc19.rpy:2788
translate brazil ch4sc19_c2d86e6f:

#   mc "*Chuckles* You win."
    mc "*Risos* Você venceu."

# game/chapters/chapter4/script/ch4sc19.rpy:2790
translate brazil ch4sc19_8975b667:

#   el "I want my prize now."
    el "Quero meu prêmio agora."

# game/chapters/chapter4/script/ch4sc19.rpy:2802
translate brazil ch4sc19_a808fe40:

#   mc "I've always hated losing. But with you, it’s like I win either way."
    mc "Sempre odiei perder. Mas com você, é como se eu ganhasse de qualquer jeito."

# game/chapters/chapter4/script/ch4sc19.rpy:2808
translate brazil ch4sc19_832b8168:

#   el "*Giggles* For such a brute... you really know how to melt me with your words."
    el "*Risos* Para um bruto desses... você realmente sabe como me derreter com suas palavras."

# game/chapters/chapter4/script/ch4sc19.rpy:2809
translate brazil ch4sc19_646f93ea:

#   el "I need to sit... My knees feel funny."
    el "Preciso sentar... Meus joelhos estão estranhos."

# game/chapters/chapter4/script/ch4sc19.rpy:2811
translate brazil ch4sc19_04af930a:

#   el "I might tumble and fall off the roof."
    el "Eu posso tropeçar e cair do telhado."

# game/chapters/chapter4/script/ch4sc19.rpy:2813
translate brazil ch4sc19_ed0be3de:

#   mc "I’d catch you."
    mc "Eu te pegaria."

# game/chapters/chapter4/script/ch4sc19.rpy:2815
translate brazil ch4sc19_e3c04f65:

#   el "Don’t say that... I might just test it."
    el "Não diga isso... talvez eu teste."

# game/chapters/chapter4/script/ch4sc19.rpy:2818
translate brazil ch4sc19_4cd4b510:

#   "The two of you sit closely together, looking up at the moon."
    "Vocês dois sentam-se bem próximos, olhando para a lua."

# game/chapters/chapter4/script/ch4sc19.rpy:2820
translate brazil ch4sc19_edd4158c:

#   el "I love you."
    el "Eu te amo."

# game/chapters/chapter4/script/ch4sc19.rpy:2822
translate brazil ch4sc19_bffea011:

#   mc "I love you too."
    mc "Eu também te amo."

# game/chapters/chapter4/script/ch4sc19.rpy:2824
translate brazil ch4sc19_512b3f9f:

#   el "To the moon and back?"
    el "Ida e volta à lua?"

# game/chapters/chapter4/script/ch4sc19.rpy:2826
translate brazil ch4sc19_2e13908a:

#   mc "Mh-Hm. To the moon and back."
    mc "Hum-hum. Ida e volta, até a lua."

# game/chapters/chapter4/script/ch4sc19.rpy:2832
translate brazil ch4sc19_8f14245e:

#   el "It really is beautiful tonight. Big and bright... like a million fireflies swarmed together in the sky."
    el "Está realmente lindo esta noite. Grande e brilhante... como se um milhão de vaga-lumes estivessem reunidos no céu."

# game/chapters/chapter4/script/ch4sc19.rpy:2834
translate brazil ch4sc19_64e20ef2:

#   mc "Imagine if that was true..."
    mc "Imagine se isso fosse verdade..."

# game/chapters/chapter4/script/ch4sc19.rpy:2838
translate brazil ch4sc19_d8f0613b:

#   el "I feel so tiny when I look up there..."
    el "Me sinto tão pequena quando olho lá para cima..."

# game/chapters/chapter4/script/ch4sc19.rpy:2840
translate brazil ch4sc19_16f5cab3:

#   mct "She's right... I wonder what else is out there?"
    mct "Ela tem razão... Fico imaginando o que mais existe por aí?"

# game/chapters/chapter4/script/ch4sc19.rpy:2842
translate brazil ch4sc19_85302e21:

#   el "Do you ever wonder what’s out there?"
    el "Você já se perguntou o que existe lá fora?"

# game/chapters/chapter4/script/ch4sc19.rpy:2846
translate brazil ch4sc19_ed75ed7d:

#   mc "I used to quite often."
    mc "Eu costumava fazer isso com bastante frequência."

# game/chapters/chapter4/script/ch4sc19.rpy:2847
translate brazil ch4sc19_c026863a:

#   mc "After your father took me away, I suffered from nightmares... about my parents."
    mc "Depois que seu pai me levou embora, eu passei a ter pesadelos... com meus pais."

# game/chapters/chapter4/script/ch4sc19.rpy:2849
translate brazil ch4sc19_8bbb37ec:

#   mc "I'd have these vivid dreams about finding them that night... and I'd wake up shaking."
    mc "Eu tinha sonhos muito vívidos sobre encontrá-los naquela noite... e acordava tremendo."

# game/chapters/chapter4/script/ch4sc19.rpy:2850
translate brazil ch4sc19_b71c088a:

#   mc "When that happened, I'd find somewhere I could look at the moon."
    mc "Quando isso acontecia, eu procurava algum lugar onde pudesse olhar para a lua."

# game/chapters/chapter4/script/ch4sc19.rpy:2852
translate brazil ch4sc19_91e14412:

#   mc "And it might sound dumb... but I'd talk to it."
    mc "E pode parecer bobagem... mas eu conversaria com ele."

# game/chapters/chapter4/script/ch4sc19.rpy:2853
translate brazil ch4sc19_e06f50bd:

#   mc "I'd tell it about everything I'd been through."
    mc "Eu contaria tudo o que tinha passado."

# game/chapters/chapter4/script/ch4sc19.rpy:2855
translate brazil ch4sc19_84e69c81:

#   mc "I'd complain about how things weren't fair... and the things that annoyed me."
    mc "Eu reclamava de como as coisas não eram justas... e das coisas que me irritavam."

# game/chapters/chapter4/script/ch4sc19.rpy:2856
translate brazil ch4sc19_539fe4ac:

#   mc "And after a while, I always managed to calm down."
    mc "E depois de um tempo, eu sempre conseguia me acalmar."

# game/chapters/chapter4/script/ch4sc19.rpy:2857
translate brazil ch4sc19_b56e7a85:

#   "You feel her hand run up your back, then her fingers caressing your hair."
    "Você sente a mão dela subir pelas suas costas, e depois os dedos acariciando seu cabelo."

# game/chapters/chapter4/script/ch4sc19.rpy:2859
translate brazil ch4sc19_d771f068:

#   el "[mc]... that’s not dumb. Not at all."
    el "[mc]... isso não é bobagem. De jeito nenhum."

# game/chapters/chapter4/script/ch4sc19.rpy:2860
translate brazil ch4sc19_ec436aec:

#   el "You probably needed to talk to someone about it all, and I don’t imagine my father being a good listener."
    el "Você provavelmente precisava conversar com alguém sobre tudo isso, e não imagino que meu pai seja um bom ouvinte."

# game/chapters/chapter4/script/ch4sc19.rpy:2862
translate brazil ch4sc19_0e99f2f7:

#   mc "Yeah, I could never talk to him. Not like I’m able to talk with you."
    mc "É, eu nunca conseguiria conversar com ele. Não como consigo conversar com você."

# game/chapters/chapter4/script/ch4sc19.rpy:2864
translate brazil ch4sc19_ce5df0ff:

#   el "I’m here for you... always."
    el "Estou aqui para você... sempre."

# game/chapters/chapter4/script/ch4sc19.rpy:2868
translate brazil ch4sc19_be01e9c9:

#   el "I’ll be your moon."
    el "Serei a sua lua."

# game/chapters/chapter4/script/ch4sc19.rpy:2870
translate brazil ch4sc19_9f44998d:

#   mc "My moon... I like that."
    mc "Minha lua... Gostei disso."

# game/chapters/chapter4/script/ch4sc19.rpy:2872
translate brazil ch4sc19_fe17ec91:

#   el "You'd better! It’s a permanent position."
    el "É melhor que aceite! É um cargo permanente."

# game/chapters/chapter4/script/ch4sc19.rpy:2873
translate brazil ch4sc19_b2e0e34e:

#   el "And I offer no take-backs!"
    el "E não ofereço retratação!"

# game/chapters/chapter4/script/ch4sc19.rpy:2875
translate brazil ch4sc19_532d089f:

#   mc "I'd do anything for you. You know that, right?"
    mc "Eu faria qualquer coisa por você. Você sabe disso, não é?"

# game/chapters/chapter4/script/ch4sc19.rpy:2877
translate brazil ch4sc19_d78c06dc:

#   el "I do."
    el "Eu faço."

# game/chapters/chapter4/script/ch4sc19.rpy:2878
translate brazil ch4sc19_5a34534a:

#   el "And the feeling is mutual. If you ended up in one of the five hells-"
    el "E o sentimento é recíproco. Se você acabasse em um dos cinco infernos..."

# game/chapters/chapter4/script/ch4sc19.rpy:2880
translate brazil ch4sc19_1c9f737e:

#   el "I'd barge in there and break you out myself!"
    el "Eu invadiria esse lugar e te libertaria pessoalmente!"

# game/chapters/chapter4/script/ch4sc19.rpy:2882
translate brazil ch4sc19_eb722364:

#   mc "My own little hellraiser. *Chuckles*"
    mc "Minha pequena encrenqueira. *Risos*"

# game/chapters/chapter4/script/ch4sc19.rpy:2886
translate brazil ch4sc19_a72e53c2:

#   mc "Thank you. It means a lot."
    mc "Obrigado. Significa muito para mim."

# game/chapters/chapter4/script/ch4sc19.rpy:2890
translate brazil ch4sc19_ddcf541a:

#   "The two of you sit in companionable silence for a while, just observing the streets below."
    "Vocês dois ficam sentados em silêncio agradável por um tempo, apenas observando as ruas lá embaixo."

# game/chapters/chapter4/script/ch4sc19.rpy:2891
translate brazil ch4sc19_6e4aa6df:

#   "Eliza gently runs her fingers through your hair while she rests against you."
    "Eliza passa os dedos delicadamente pelos seus cabelos enquanto se encosta em você."

# game/chapters/chapter4/script/ch4sc19.rpy:2894
translate brazil ch4sc19_9950f41c:

#   el "*Sigh* Hunger’s back..."
    el "*Suspiro* A fome voltou..."

# game/chapters/chapter4/script/ch4sc19.rpy:2896
translate brazil ch4sc19_3a92ba8a:

#   mc "Luckily for you... it’s dinner time. See that girl?"
    mc "Por sorte... é hora do jantar. Viu aquela garota?"

# game/chapters/chapter4/script/ch4sc19.rpy:2898
translate brazil ch4sc19_ba753da9:

#   el "Mh-Hm."
    el "Hum-hum."

# game/chapters/chapter4/script/ch4sc19.rpy:2899
translate brazil ch4sc19_172b6bdb:

#   el "I’m surprised you didn’t pick some stinky old man."
    el "Estou surpreso que você não tenha escolhido algum velho fedorento."

# game/chapters/chapter4/script/ch4sc19.rpy:2901
translate brazil ch4sc19_2a4bcd0e:

#   mc "I think it’s important we make this a positive experience for you."
    mc "Acho importante que façamos desta uma experiência positiva para você."

# game/chapters/chapter4/script/ch4sc19.rpy:2903
translate brazil ch4sc19_47aff8c3:

#   mc "Anyway... she’s your meal for tonight."
    mc "Enfim... ela será o seu jantar de hoje."

# game/chapters/chapter4/script/ch4sc19.rpy:2904
translate brazil ch4sc19_1b490b15:

#   mc "I’ll observe and step in if needed."
    mc "Vou observar e intervir se necessário."

# game/chapters/chapter4/script/ch4sc19.rpy:2906
translate brazil ch4sc19_55c39b6c:

#   el "Mhhm..."
    el "Hum..."

# game/chapters/chapter4/script/ch4sc19.rpy:2907
translate brazil ch4sc19_ceb03d7d:

#   el "I'm so hungry..."
    el "Estou com tanta fome..."

# game/chapters/chapter4/script/ch4sc19.rpy:2909
translate brazil ch4sc19_d3bf6aad:

#   el "I can't believe I'm saying this... but she looks delicious."
    el "Não acredito que estou dizendo isso... mas ela parece deliciosa."

# game/chapters/chapter4/script/ch4sc19.rpy:2918
translate brazil ch4sc19_f1cc460f:

#   uk "Huh? Anyone there?"
    uk "Hein? Tem alguém aí?"

# game/chapters/chapter4/script/ch4sc19.rpy:2920
translate brazil ch4sc19_9e9450ed:

#   uk "Weird... I thought I heard something."
    uk "Que estranho... Achei que tinha ouvido alguma coisa."

# game/chapters/chapter4/script/ch4sc19.rpy:2921
translate brazil ch4sc19_f37287fb:

#   uk "I must be imagining things. *Sigh* Serves me right for letting the girls get me tipsy."
    uk "Devo estar imaginando coisas. *Suspiro* Bem feito para mim por deixar as meninas me embebedarem."

# game/chapters/chapter4/script/ch4sc19.rpy:2923
translate brazil ch4sc19_f84f4a42:

#   uk "I'd better get home before Father discovers I’m out past curfew... well past."
    uk "É melhor eu voltar para casa antes que meu pai descubra que estou na rua depois do toque de recolher... bem depois."

# game/chapters/chapter4/script/ch4sc19.rpy:2925
translate brazil ch4sc19_3e9073ac:

#   uk "Last time it happened, I had to do all the chores by myself for a week..."
    uk "Da última vez que isso aconteceu, tive que fazer todas as tarefas domésticas sozinha durante uma semana..."

# game/chapters/chapter4/script/ch4sc19.rpy:2930
translate brazil ch4sc19_4cb47a13:

#   uk "*Muffled* Mhhhhh!! Mmmhpfff!"
    uk "*Abafado* Mhhhhh!! Mmmhpfff!"

# game/chapters/chapter4/script/ch4sc19.rpy:2931
translate brazil ch4sc19_06dd8713:

#   el "I’m really sorry... I just need a quick bite."
    el "Me desculpe... Só preciso comer algo rapidinho."

# game/chapters/chapter4/script/ch4sc19.rpy:2935
translate brazil ch4sc19_481def87:

#   uk "Muffled* Hhnnghhh! Hhhmmh!"
    uk "Abafado* Hhnnghhh! Hhhmmh!"

# game/chapters/chapter4/script/ch4sc19.rpy:2938
translate brazil ch4sc19_94847796:

#   elt "Mhm... Sho ghood... Mmhm! M-More..."
    elt "Hum... Sho ghood... Hum! M-Mais..."

# game/chapters/chapter4/script/ch4sc19.rpy:2945
translate brazil ch4sc19_e0348172:

#   mc "Eliza... You’ve had enough. If you continue, you'll kill her."
    mc "Eliza... Você já teve o suficiente. Se continuar, você a matará."

# game/chapters/chapter4/script/ch4sc19.rpy:2946
translate brazil ch4sc19_633a23e9:

#   mc "Remember, the goal is to control your feed and stop before the bloodlust sets in."
    mc "Lembre-se, o objetivo é controlar sua alimentação e parar antes que a sede de sangue se instale."

# game/chapters/chapter4/script/ch4sc19.rpy:2947
translate brazil ch4sc19_246753b4:

#   mct "I have to be cautious here, a woman's life is at stake."
    mct "Preciso ter cautela aqui, a vida de uma mulher está em jogo."

# game/chapters/chapter4/script/ch4sc19.rpy:2948
translate brazil ch4sc19_9fd206e6:

#   mct "If I try to pull her off, she might snap the girl's neck in the process. The last thing she needs is an innocent life on her conscience."
    mct "Se eu tentar tirá-la de lá, ela pode acabar quebrando o pescoço da menina. A última coisa que ela precisa é de uma vida inocente na consciência."

# game/chapters/chapter4/script/ch4sc19.rpy:2949
translate brazil ch4sc19_cf251f29:

#   mct "I have to get through to her. Make her stop of her own accord... It’s the only way for her to learn control."
    mct "Preciso chegar até ela. Fazer com que ela pare por conta própria... É o único jeito de ela aprender a se controlar."

# game/chapters/chapter4/script/ch4sc19.rpy:2951
translate brazil ch4sc19_af1c9f90:

#   mc "Eliza, I know you’re probably drowning in emotions right now, and the blood is making you forget everything else."
    mc "Eliza, eu sei que você provavelmente está se afogando em emoções agora, e o sangue está fazendo você esquecer tudo o resto."

# game/chapters/chapter4/script/ch4sc19.rpy:2952
translate brazil ch4sc19_e2ddb2b6:

#   mc "But you'll lose yourself like that. So just... focus on my voice. I’m right here with you."
    mc "Mas você vai se perder assim. Então... concentre-se na minha voz. Estou aqui com você."

# game/chapters/chapter4/script/ch4sc19.rpy:2953
translate brazil ch4sc19_6c66704a:

#   mc "Think of your favorite memory, the happiest one you can remember... and focus on that."
    mc "Pense na sua lembrança favorita, a mais feliz que você consegue recordar... e concentre-se nela."

# game/chapters/chapter4/script/ch4sc19.rpy:2958
translate brazil ch4sc19_0352ee1a:

#   el "Hhhaaaa..."
    el "Hhhaaaa..."

# game/chapters/chapter4/script/ch4sc19.rpy:2960
translate brazil ch4sc19_74755ac9:

#   el "I heard you. I actually heard you through the blood."
    el "Eu te ouvi. Eu realmente te ouvi através do sangue."

# game/chapters/chapter4/script/ch4sc19.rpy:2961
translate brazil ch4sc19_b19050fe:

#   el "I... I found you in the darkness."
    el "Eu... eu te encontrei na escuridão."

# game/chapters/chapter4/script/ch4sc19.rpy:2962
translate brazil ch4sc19_5ebd0a0b:

#   el "Did I do it? Did I stop in time?"
    el "Será que eu consegui? Será que parei a tempo?"

# game/chapters/chapter4/script/ch4sc19.rpy:2964
translate brazil ch4sc19_6afca92f:

#   mc "Yes. You did better than I expected. She's still breathing fine."
    mc "Sim. Você se saiu melhor do que eu esperava. Ela ainda está respirando bem."

# game/chapters/chapter4/script/ch4sc19.rpy:2965
translate brazil ch4sc19_ea53cd76:

#   el "What are you doing? Will she be okay?!"
    el "O que você está fazendo? Ela vai ficar bem?!"

# game/chapters/chapter4/script/ch4sc19.rpy:2967
translate brazil ch4sc19_073b77f5:

#   mc "It’s a new ability I learned when I was on Inmortui. I can mend fresh wounds."
    mc "É uma nova habilidade que aprendi quando estava em Inmortui. Consigo curar feridas recentes."

# game/chapters/chapter4/script/ch4sc19.rpy:2968
translate brazil ch4sc19_65e1c3f1:

#   mc "I used it on Dalen after he cut himself to fill the chalice with his blood."
    mc "Usei isso em Dalen depois que ele se cortou para encher o cálice com seu sangue."

# game/chapters/chapter4/script/ch4sc19.rpy:2969
translate brazil ch4sc19_70821ea4:

#   el "Woah! [mc]... This is incredible! You’re healing her!"
    el "Uau! [mc]... Isso é incrível! Você está curando-a!"

# game/chapters/chapter4/script/ch4sc19.rpy:2970
translate brazil ch4sc19_81f27c36:

#   el "Then... I... I didn’t kill her?!"
    el "Então... eu... eu não a matei?!"

# game/chapters/chapter4/script/ch4sc19.rpy:2977
translate brazil ch4sc19_6b7c7617:

#   mc "She’ll be fine. She just need to sleep it off."
    mc "Ela vai ficar bem. Ela só precisa dormir um pouco para passar o efeito."

# game/chapters/chapter4/script/ch4sc19.rpy:2978
translate brazil ch4sc19_aea4b526:

#   mc "She might wake up with one hell of a headache, though."
    mc "Mas ela pode acordar com uma baita dor de cabeça."

# game/chapters/chapter4/script/ch4sc19.rpy:2979
translate brazil ch4sc19_6fe26331:

#   el "Maybe... Maybe I really can do this? Be a vampire who doesn’t have to kill?"
    el "Talvez... talvez eu realmente consiga fazer isso? Ser um vampiro que não precisa matar?"

# game/chapters/chapter4/script/ch4sc19.rpy:2980
translate brazil ch4sc19_0fcdbd1f:

#   mc "As long as you maintain focus when you feed, and not give in to the bloodlust-"
    mc "Contanto que você mantenha o foco ao se alimentar e não ceda à sede de sangue..."

# game/chapters/chapter4/script/ch4sc19.rpy:2981
translate brazil ch4sc19_e8cb70d1:

#   mc "Then... Yeah, I think it's possible."
    mc "Então... Sim, acho que é possível."

# game/chapters/chapter4/script/ch4sc19.rpy:2984
translate brazil ch4sc19_d3b762fe:

#   el "*Squeals excitedly* Mhiyaah!"
    el "*Grita de alegria* Mhiyaah!"

# game/chapters/chapter4/script/ch4sc19.rpy:2985
translate brazil ch4sc19_dac3ee9a:

#   el "Thank you! Thank you so much for helping me!"
    el "Obrigada! Muito obrigada por me ajudar!"

# game/chapters/chapter4/script/ch4sc19.rpy:2986
translate brazil ch4sc19_4052c488:

#   el "This- This means I won't have to kill anyone!"
    el "Isso significa que eu não terei que matar ninguém!"

# game/chapters/chapter4/script/ch4sc19.rpy:2987
translate brazil ch4sc19_fc9609fe:

#   mc "Of course. I’ll be with you every step of the way. We’re in this together."
    mc "Claro. Estarei com você em cada passo do caminho. Estamos juntos nessa."

# game/chapters/chapter4/script/ch4sc19.rpy:2988
translate brazil ch4sc19_eed20107:

#   mc "I failed you the night you were turning... I should've been more attentive."
    mc "Eu falhei com você na noite em que você estava completando dez anos... Eu deveria ter prestado mais atenção."

# game/chapters/chapter4/script/ch4sc19.rpy:2990
translate brazil ch4sc19_16421dea:

#   "{color=#87e1fa}Light Morality{/color} increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "{color=#87e1fa}Moralidade Leve{/color} aumentado por {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc19.rpy:2997
translate brazil ch4sc19_5d81cf2a:

#   mct "She'll never survive being a vampire if she doesn’t enjoy it."
    mct "Ela jamais sobreviverá como vampira se não gostar disso."

# game/chapters/chapter4/script/ch4sc19.rpy:2998
translate brazil ch4sc19_d137f3c8:

#   mct "She’s an apex predator now..."
    mct "Ela agora é uma predadora alfa..."

# game/chapters/chapter4/script/ch4sc19.rpy:3000
translate brazil ch4sc19_c4db7164:

#   mct "Why should she feel bad for surviving? Does the wolf feel bad for the sheep?"
    mct "Por que ela deveria se sentir mal por ter sobrevivido? O lobo sente pena da ovelha?"

# game/chapters/chapter4/script/ch4sc19.rpy:3001
translate brazil ch4sc19_2f6f1a3e:

#   mct "Does the lion apologize to the zebra? Does the eagle pity the hare? No. She should enjoy this."
    mct "Será que o leão pede desculpas à zebra? Será que a águia tem pena da lebre? Não. Ela deveria estar gostando disso."

# game/chapters/chapter4/script/ch4sc19.rpy:3003
translate brazil ch4sc19_3d396359:

#   mc "I’m here with you. Just relax and drink up..."
    mc "Estou aqui com você. Apenas relaxe e aproveite..."

# game/chapters/chapter4/script/ch4sc19.rpy:3005
translate brazil ch4sc19_309f9c71:

#   el "*Bites harder* Hrrhhmm..."
    el "*Morde com mais força* Hrrhhmm..."

# game/chapters/chapter4/script/ch4sc19.rpy:3007
translate brazil ch4sc19_ce3af348:

#   mc "Good girl... Take as much as you need."
    mc "Boa menina... Pegue o quanto precisar."

# game/chapters/chapter4/script/ch4sc19.rpy:3008
translate brazil ch4sc19_31d2a135:

#   mc "Savor the taste..."
    mc "Aprecie o sabor..."

# game/chapters/chapter4/script/ch4sc19.rpy:3010
translate brazil ch4sc19_85dc1868:

#   el "More... So good... I want more..."
    el "Mais... Tão bom... Quero mais..."

# game/chapters/chapter4/script/ch4sc19.rpy:3013
translate brazil ch4sc19_44873948:

#   mc "Drink as much as you need... Empty her veins if need be."
    mc "Beba o quanto precisar... Esvazie as veias dela, se necessário."

# game/chapters/chapter4/script/ch4sc19.rpy:3014
translate brazil ch4sc19_9b98fb94:

#   el "*Moans* Mmnhh! Mhmmm..."
    el "*Gemidos* Mmnhh! Mhmmm..."

# game/chapters/chapter4/script/ch4sc19.rpy:3016
translate brazil ch4sc19_6ee7ae15:

#   el "Haaahh... Delicious!"
    el "Haaahh... Delicioso!"

# game/chapters/chapter4/script/ch4sc19.rpy:3018
translate brazil ch4sc19_363fdc77:

#   el "Do you want some?"
    el "Você quer um pouco?"

# game/chapters/chapter4/script/ch4sc19.rpy:3021
translate brazil ch4sc19_819c3887:

#   el "More for me then."
    el "Então, sobra mais para mim."

# game/chapters/chapter4/script/ch4sc19.rpy:3023
translate brazil ch4sc19_5479e60a:

#   el "Mmnhhh... Nnngh..."
    el "Mmnhhh... Nnngh..."

# game/chapters/chapter4/script/ch4sc19.rpy:3024
translate brazil ch4sc19_65d7747c:

#   "She continues sucking on the girl’s neck until there’s nothing left."
    "Ela continua chupando o pescoço da garota até não sobrar nada."

# game/chapters/chapter4/script/ch4sc19.rpy:3031
translate brazil ch4sc19_65553405:

#   el "Is she dead?"
    el "Ela está morta?"

# game/chapters/chapter4/script/ch4sc19.rpy:3032
translate brazil ch4sc19_9d6d2fa1:

#   mc "It seems so. Do you feel satisfied?"
    mc "Parece que sim. Você se sente satisfeito?"

# game/chapters/chapter4/script/ch4sc19.rpy:3033
translate brazil ch4sc19_bba1ad8e:

#   el "Mh-Hm. She was tasty..."
    el "Hum-hum. Ela era gostosa..."

# game/chapters/chapter4/script/ch4sc19.rpy:3035
translate brazil ch4sc19_b6adcadd:

#   mc "Good. I’m proud of you."
    mc "Ótimo. Estou orgulhoso de você."

# game/chapters/chapter4/script/ch4sc19.rpy:3036
translate brazil ch4sc19_4befc92b:

#   el "R-Really? I did good?"
    el "Sério? Eu me saí bem?"

# game/chapters/chapter4/script/ch4sc19.rpy:3037
translate brazil ch4sc19_2f5d4256:

#   mc "Yes. You’re top of the food chain... She is prey."
    mc "Sim. Você está no topo da cadeia alimentar... Ela é a presa."

# game/chapters/chapter4/script/ch4sc19.rpy:3038
translate brazil ch4sc19_74ec3046:

#   el "Is it really okay that I killed her?"
    el "Será que realmente está tudo bem eu tê-la matado?"

# game/chapters/chapter4/script/ch4sc19.rpy:3039
translate brazil ch4sc19_eec26e21:

#   mc "Eliza, you're not human any more. Binding yourself to human morals will only bring you suffering."
    mc "Eliza, você não é mais humana. Se prender a normas morais humanas só lhe trará sofrimento."

# game/chapters/chapter4/script/ch4sc19.rpy:3040
translate brazil ch4sc19_04c5897a:

#   mc "Besides, humans kill each other constantly. Why should you be upset about it when you literally need to feed to survive?"
    mc "Além disso, os humanos se matam constantemente. Por que você deveria se incomodar com isso se você precisa se alimentar para sobreviver?"

# game/chapters/chapter4/script/ch4sc19.rpy:3041
translate brazil ch4sc19_7d6867cd:

#   el "When you put it like that... it seems, okay?"
    el "Quando você coloca dessa forma... parece que está tudo bem?"

# game/chapters/chapter4/script/ch4sc19.rpy:3044
translate brazil ch4sc19_52ddc99f:

#   el "I’m so happy! Yaay!"
    el "Estou tão feliz! Eba!"

# game/chapters/chapter4/script/ch4sc19.rpy:3045
translate brazil ch4sc19_173e918b:

#   el "I couldn’t have done this without you! Thank you for guiding me through it!"
    el "Eu não teria conseguido sem você! Obrigada por me guiar durante todo o processo!"

# game/chapters/chapter4/script/ch4sc19.rpy:3047
translate brazil ch4sc19_130d0640:

#   mc "I’ll be with you every step of the way, I promise."
    mc "Estarei com você em cada passo do caminho, eu prometo."

# game/chapters/chapter4/script/ch4sc19.rpy:3048
translate brazil ch4sc19_0378cc43:

#   "{color=#f00}Dark Morality{/color} has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "{color=#f00}Moralidade Sombria{/color} aumentou em {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc19.rpy:3053
translate brazil ch4sc19_bd80f62b:

#   el "With you by my side... I feel like I can overcome this whole vampire thing."
    el "Com você ao meu lado... sinto que posso superar toda essa coisa de vampiro."

# game/chapters/chapter4/script/ch4sc19.rpy:3054
translate brazil ch4sc19_78b34643:

#   el "I thought I might not be any good at it... It seemed like such an insurmountable mountain to climb."
    el "Pensei que talvez não fosse bom nisso... Parecia uma montanha intransponível."

# game/chapters/chapter4/script/ch4sc19.rpy:3056
translate brazil ch4sc19_717b5673:

#   mc "Luckily, you seem to be a good climber."
    mc "Por sorte, você parece ser um bom escalador."

# game/chapters/chapter4/script/ch4sc19.rpy:3058
translate brazil ch4sc19_c6cafc7d:

#   el "I can’t take all the credit... I have a great climbing partner."
    el "Não posso levar todo o crédito... tenho um ótimo parceiro de escalada."

# game/chapters/chapter4/script/ch4sc19.rpy:3062
translate brazil ch4sc19_dd6b8acd:

#   el "What?"
    el "O que?"

# game/chapters/chapter4/script/ch4sc19.rpy:3064
translate brazil ch4sc19_535df642:

#   mc "Nothing... Just..."
    mc "Nada... Apenas..."

# game/chapters/chapter4/script/ch4sc19.rpy:3070
translate brazil ch4sc19_e40aa7f7:

#   mc "Come here, you little cutie."
    mc "Vem cá, minha gracinha."

# game/chapters/chapter4/script/ch4sc19.rpy:3073
translate brazil ch4sc19_350653aa:

#   "As your lips touch gently, you can taste the metallic traces of the blood on her lips."
    "Ao tocar suavemente seus lábios, você consegue sentir o gosto metálico do sangue em seus lábios."

# game/chapters/chapter4/script/ch4sc19.rpy:3075
translate brazil ch4sc19_ed3fe9ef:

#   "But that doesn't stop either of you from enjoying each others lips."
    "Mas isso não impede nenhum de vocês de desfrutar dos lábios um do outro."

# game/chapters/chapter4/script/ch4sc19.rpy:3078
translate brazil ch4sc19_6e9a59ea:

#   el "MmpphH! Mmhhh..."
    el "MmpphH! Mmhhh..."

# game/chapters/chapter4/script/ch4sc19.rpy:3079
translate brazil ch4sc19_35a05ec3:

#   "The taste of blood is quickly washed away by your co-mingled saliva."
    "O gosto de sangue é rapidamente dissipado pela sua saliva misturada."

# game/chapters/chapter4/script/ch4sc19.rpy:3080
translate brazil ch4sc19_bd384b0e:

#   mct "She kisses me with such intimacy... It’s hard not to get addicted."
    mct "Ela me beija com tanta intimidade... É difícil não ficar viciado."

# game/chapters/chapter4/script/ch4sc19.rpy:3082
translate brazil ch4sc19_f05d045c:

#   mct "Who am I kidding? I am already addicted."
    mct "Quem eu quero enganar? Eu já estou viciado."

# game/chapters/chapter4/script/ch4sc19.rpy:3083
translate brazil ch4sc19_6778a434:

#   elt "Nngh! I love how he grabs on to me when we kiss... It makes me feel so safe."
    elt "Nngh! Adoro como ele me abraça quando nos beijamos... Me sinto tão segura."

# game/chapters/chapter4/script/ch4sc19.rpy:3085
translate brazil ch4sc19_25fd8510:

#   el "Yum..."
    el "Hum..."

# game/chapters/chapter4/script/ch4sc19.rpy:3086
translate brazil ch4sc19_6fb60925:

#   el "Take me home? Our bed is waiting for us."
    el "Leve-me para casa? Nossa cama está nos esperando."

# game/chapters/chapter4/script/ch4sc19.rpy:3088
translate brazil ch4sc19_e0463fb1:

#   mc "That does sound inviting... Let's go."
    mc "Parece tentador... Vamos lá."

# game/chapters/chapter4/script/ch4sc19.rpy:3096
translate brazil ch4sc19_9da0e209:

#   mc "Let’s get out of here before anyone comes by."
    mc "Vamos sair daqui antes que alguém apareça."

# game/chapters/chapter4/script/ch4sc19.rpy:3098
translate brazil ch4sc19_956566cf:

#   el "Yeah... It’s been a long day. I can practically hear our bed screaming for us."
    el "É... Foi um dia longo. Quase consigo ouvir nossa cama gritando por nós."

# game/chapters/chapter4/script/ch4sc19.rpy:3108
translate brazil ch4sc19_c95a62c2:

#   el "*Stretching* Finally. This bed has been calling me all day!"
    el "*Alongando-me* Finalmente! Esta cama estava me chamando o dia todo!"

# game/chapters/chapter4/script/ch4sc19.rpy:3109
translate brazil ch4sc19_d520dfdd:

#   mc "You and me both... It’s been quite the day."
    mc "Eu também... Foi um dia e tanto."

# game/chapters/chapter4/script/ch4sc19.rpy:3111
translate brazil ch4sc19_45592309:

#   el "I need to get out of these clothes... Tell me about your day?"
    el "Preciso tirar essas roupas... Conte-me sobre o seu dia?"

# game/chapters/chapter4/script/ch4sc19.rpy:3113
translate brazil ch4sc19_a56845e5:

#   mc "After I left the guild, I went to search the cells where Taron kept you."
    mc "Depois que saí da guilda, fui procurar as celas onde Taron te mantinha."

# game/chapters/chapter4/script/ch4sc19.rpy:3114
translate brazil ch4sc19_2157d1ca:

#   mc "I had to fight off a few of his thugs, but nothing major."
    mc "Tive que enfrentar alguns dos seus capangas, mas nada de muito grave."

# game/chapters/chapter4/script/ch4sc19.rpy:3115
translate brazil ch4sc19_f13500b9:

#   el "Ugh! I still have nightmares about that place..."
    el "Argh! Ainda tenho pesadelos com aquele lugar..."

# game/chapters/chapter4/script/ch4sc19.rpy:3117
translate brazil ch4sc19_68600152:

#   el "Did you encounter the old man that was in the cell with me?"
    el "Você encontrou o velho que estava na cela comigo?"

# game/chapters/chapter4/script/ch4sc19.rpy:3118
translate brazil ch4sc19_a7d424e1:

#   mc "No. Are you sure you didn’t just imagine him because of the trauma?"
    mc "Não. Tem certeza de que não o imaginou apenas por causa do trauma?"

# game/chapters/chapter4/script/ch4sc19.rpy:3120
translate brazil ch4sc19_9a4d82bd:

#   el "I’m positive... He was there."
    el "Tenho certeza... Ele estava lá."

# game/chapters/chapter4/script/ch4sc19.rpy:3121
translate brazil ch4sc19_0ece233f:

#   el "He kept mumbling variations of the word 'wibble' ..."
    el "Ele continuava murmurando variações da palavra 'wibble'..."

# game/chapters/chapter4/script/ch4sc19.rpy:3122
translate brazil ch4sc19_ad1aea1f:

#   el "He might've been traumatized by something."
    el "Ele pode ter ficado traumatizado por alguma coisa."

# game/chapters/chapter4/script/ch4sc19.rpy:3124
translate brazil ch4sc19_733a6998:

#   el "*Continues undressing*"
    el "*Continua se despindo*"

# game/chapters/chapter4/script/ch4sc19.rpy:3125
translate brazil ch4sc19_ec511e65:

#   mc "Sounds like he was off his meds... Anyway, he wasn’t there."
    mc "Parece que ele estava sem tomar os remédios... Enfim, ele não estava lá."

# game/chapters/chapter4/script/ch4sc19.rpy:3126
translate brazil ch4sc19_947053d4:

#   el "Shame... I'd like to help that old man, he must've been there for a reason..."
    el "Que pena... Eu gostaria de ajudar aquele senhor, ele devia estar ali por algum motivo..."

# game/chapters/chapter4/script/ch4sc19.rpy:3127
translate brazil ch4sc19_3c2e18ae:

#   mc "Maybe... somebody else was in the cells though."
    mc "Talvez... houvesse mais alguém nas celas."

# game/chapters/chapter4/script/ch4sc19.rpy:3128
translate brazil ch4sc19_c0af965e:

#   el "Oh? Another prisoner? Or one of his guards?"
    el "Ah? Outro prisioneiro? Ou um dos seus guardas?"

# game/chapters/chapter4/script/ch4sc19.rpy:3130
translate brazil ch4sc19_d1ef66e0:

#   mc "Prisoner. A woman named Cassandra."
    mc "Prisioneira. Uma mulher chamada Cassandra."

# game/chapters/chapter4/script/ch4sc19.rpy:3131
translate brazil ch4sc19_b6843826:

#   el "Cassandra... Doesn’t ring a bell. I don’t think she was there at the same time as me."
    el "Cassandra... Não me soa familiar. Acho que ela não estava lá ao mesmo tempo que eu."

# game/chapters/chapter4/script/ch4sc19.rpy:3132
translate brazil ch4sc19_e7f3b6b5:

#   el "He really has a thing for locking up women, huh? *Angrily* Bastard..."
    el "Ele realmente tem uma tara por trancar mulheres, né? *Com raiva* Desgraçado..."

# game/chapters/chapter4/script/ch4sc19.rpy:3133
translate brazil ch4sc19_a972a9f1:

#   mc "She's the leader of the mage’s guild here in Luxenford."
    mc "Ela é a líder da guilda de magos aqui em Luxenford."

# game/chapters/chapter4/script/ch4sc19.rpy:3136
translate brazil ch4sc19_96cdb3bb:

#   el "{b}WHAT?!{/b} A leader of a guild? Isn’t that insanely risky, even for him?"
    el "{b}O QUE?!{/b} Ser o líder de uma guilda? Isso não é extremamente arriscado, mesmo para ele?"

# game/chapters/chapter4/script/ch4sc19.rpy:3137
translate brazil ch4sc19_cd7c9ed8:

#   mc "Yes. He’s gotten careless... Something or someone must have him under a lot of pressure."
    mc "Sim. Ele está descuidado... Algo ou alguém deve estar pressionando-o bastante."

# game/chapters/chapter4/script/ch4sc19.rpy:3139
translate brazil ch4sc19_51088e60:

#   mc "Which means he's bound to make mistakes. Eventually, that'll lead us to him."
    mc "O que significa que ele certamente cometerá erros. Eventualmente, isso nos levará até ele."

# game/chapters/chapter4/script/ch4sc19.rpy:3140
translate brazil ch4sc19_8ad4854b:

#   mc "Holding a guild leader prisoner is bound to get noticed. She'll be able to identify him easily."
    mc "Manter o líder de uma guilda como prisioneiro certamente chamará a atenção. Ela será capaz de identificá-lo facilmente."

# game/chapters/chapter4/script/ch4sc19.rpy:3141
translate brazil ch4sc19_69fed45d:

#   mc "I can only assume that means he doesn’t intend to let her live."
    mc "Só posso presumir que isso significa que ele não pretende deixá-la viver."

# game/chapters/chapter4/script/ch4sc19.rpy:3143
translate brazil ch4sc19_b6812867:

#   el "Good thing you got her out of there then!"
    el "Ainda bem que você a tirou de lá!"

# game/chapters/chapter4/script/ch4sc19.rpy:3145
translate brazil ch4sc19_588f862f:

#   mc "About that... I didn’t free her."
    mc "Sobre isso... eu não a libertei."

# game/chapters/chapter4/script/ch4sc19.rpy:3147
translate brazil ch4sc19_1c8dc060:

#   el "What?! Why would you just leave her there to rot? Do you have any idea how it feels to be kept in that place?"
    el "O quê?! Por que você a deixaria lá para apodrecer? Você tem ideia de como é se sentir mantida naquele lugar?"

# game/chapters/chapter4/script/ch4sc19.rpy:3149
translate brazil ch4sc19_d430cf24:

#   el "Those cold, murky cells... They’re disgusting! Inhumane! We need to go get her right now!"
    el "Aquelas celas frias e escuras... São repugnantes! Desumanas! Precisamos ir buscá-la agora mesmo!"

# game/chapters/chapter4/script/ch4sc19.rpy:3152
translate brazil ch4sc19_fd75a25b:

#   mc "{b}ELIZA!!{/b} Listen for a second."
    mc "{b}ELIZA!!{/b} Escute por um segundo."

# game/chapters/chapter4/script/ch4sc19.rpy:3153
translate brazil ch4sc19_5e59852a:

#   mc "If I could’ve gotten her out, I would have. But Taron had a mage cast a hex on her."
    mc "Se eu pudesse tê-la tirado de lá, eu teria tirado. Mas Taron pediu a um mago que lançasse uma maldição sobre ela."

# game/chapters/chapter4/script/ch4sc19.rpy:3154
translate brazil ch4sc19_ab269ee0:

#   mc "Apparently, if she leaves, it'll use her own mana as a bomb and destroy her from the inside."
    mc "Aparentemente, se ela sair, usará sua própria mana como uma bomba e a destruirá por dentro."

# game/chapters/chapter4/script/ch4sc19.rpy:3156
translate brazil ch4sc19_4230dee2:

#   el "W-What?? That’s horrible... We have to do something."
    el "O quê?? Isso é horrível... Temos que fazer alguma coisa."

# game/chapters/chapter4/script/ch4sc19.rpy:3157
translate brazil ch4sc19_34ec680f:

#   mc "I am. Cassandra asked me to find her daughter, Luna."
    mc "Sim. Cassandra me pediu para encontrar sua filha, Luna."

# game/chapters/chapter4/script/ch4sc19.rpy:3159
translate brazil ch4sc19_8a2af57c:

#   el "Luna... Luna... Hmh."
    el "Agente... Agente... Hmh."

# game/chapters/chapter4/script/ch4sc19.rpy:3160
translate brazil ch4sc19_375e2d80:

#   el "Alice has a friend at the academy with that name."
    el "Alice tem uma amiga na academia com esse nome."

# game/chapters/chapter4/script/ch4sc19.rpy:3161
translate brazil ch4sc19_7dd345aa:

#   mc "That would be the one."
    mc "Essa seria a ideal."

# game/chapters/chapter4/script/ch4sc19.rpy:3163
translate brazil ch4sc19_d9da8ee2:

#   el "You already found her?"
    el "Você já a encontrou?"

# game/chapters/chapter4/script/ch4sc19.rpy:3165
translate brazil ch4sc19_d4118e3c:

#   mc "I did. Taron has been forcing her to try to lift a curse from a blade of ancient origin..."
    mc "Sim, eu fiz. Taron a está forçando a tentar quebrar uma maldição de uma lâmina de origem ancestral..."

# game/chapters/chapter4/script/ch4sc19.rpy:3166
translate brazil ch4sc19_8873e371:

#   mc "He's using her mother as leverage to keep her obedient."
    mc "Ele está usando a mãe dela como moeda de troca para mantê-la obediente."

# game/chapters/chapter4/script/ch4sc19.rpy:3167
translate brazil ch4sc19_8ac0bc9f:

#   mc "Clearly, Taron values it highly enough that he's willing to go to extremes for it."
    mc "Claramente, Taron valoriza isso tanto que está disposto a ir a extremos para conseguir."

# game/chapters/chapter4/script/ch4sc19.rpy:3169
translate brazil ch4sc19_12dfd29a:

#   el "Geez! You weren't kidding about having had a busy day..."
    el "Nossa! Você não estava brincando quando disse que teve um dia corrido..."

# game/chapters/chapter4/script/ch4sc19.rpy:3171
translate brazil ch4sc19_8355a084:

#   mct "Telling her about Onyx could be risky. If the wrong person gets wind of it... everyone involved is at risk."
    mct "Contar a ela sobre Onyx pode ser arriscado. Se a pessoa errada descobrir... todos os envolvidos correm risco."

# game/chapters/chapter4/script/ch4sc19.rpy:3172
translate brazil ch4sc19_77d8c1c2:

#   mct "She already has a lot on her plate right now. Do I really want to add more on top of it?"
    mct "Ela já tem muita coisa para lidar agora. Será que eu realmente quero adicionar mais uma coisa a isso?"

# game/chapters/chapter4/script/ch4sc19.rpy:3174
translate brazil ch4sc19_c8d41072:

#   el "Spill it. Whatever it is you're thinking so hard about... just tell me."
    el "Desembucha. Seja lá o que for que esteja te incomodando tanto... me conta logo."

# game/chapters/chapter4/script/ch4sc19.rpy:3176
translate brazil ch4sc19_19857321:

#   mct "Heh... Observant as ever."
    mct "Heh... Observador como sempre."

# game/chapters/chapter4/script/ch4sc19.rpy:3177
translate brazil ch4sc19_6f040796:

#   mct "We agreed we'd never keep each other in the dark... I don’t intend to start now."
    mct "Combinamos que nunca esconderíamos nada um do outro... E não pretendo começar agora."

# game/chapters/chapter4/script/ch4sc19.rpy:3178
translate brazil ch4sc19_ad42b2f6:

#   mct "Eliza is the one person I'd trust with anything."
    mct "Eliza é a única pessoa em quem eu confiaria para qualquer coisa."

# game/chapters/chapter4/script/ch4sc19.rpy:3180
translate brazil ch4sc19_a78f8bc7:

#   mc "I offered to help Luna lift the curse while she and Alice search for a way to break the hex on Cassandra."
    mc "Eu me ofereci para ajudar Luna a quebrar a maldição enquanto ela e Alice procuram uma maneira de desfazer o feitiço que aflige Cassandra."

# game/chapters/chapter4/script/ch4sc19.rpy:3181
translate brazil ch4sc19_5a59be7b:

#   mc "But after Luna left... I managed to break the curse on the blade without her."
    mc "Mas depois que Luna foi embora... eu consegui quebrar a maldição da lâmina sem ela."

# game/chapters/chapter4/script/ch4sc19.rpy:3182
translate brazil ch4sc19_4e9f9786:

#   mc "And it turned out not to be a blade at all. The curse was a seal to lock Onyx in stasis in her blade form."
    mc "E descobriu-se que não era uma lâmina afinal. A maldição era um selo para manter Onyx em estase em sua forma de lâmina."

# game/chapters/chapter4/script/ch4sc19.rpy:3184
translate brazil ch4sc19_b7e45814:

#   el "Onyx?"
    el "Ônix?"

# game/chapters/chapter4/script/ch4sc19.rpy:3186
translate brazil ch4sc19_40c4ea75:

#   mc "Onyx is the blade- Well, actually, she's something called a 'Symbiote'."
    mc "Onyx é a lâmina... Bem, na verdade, ela é algo chamado \"simbionte\"."

# game/chapters/chapter4/script/ch4sc19.rpy:3187
translate brazil ch4sc19_07fdaf02:

#   mc "She has the ability to change shapes."
    mc "Ela tem a capacidade de mudar de forma."

# game/chapters/chapter4/script/ch4sc19.rpy:3189
translate brazil ch4sc19_97396e58:

#   el "What’s a sym... symbiote?"
    el "O que é um sim... simbionte?"

# game/chapters/chapter4/script/ch4sc19.rpy:3191
translate brazil ch4sc19_f45c7654:

#   mc "A symbiote is one of three subspecies of morphlings. The other two kinds are slimes and oozelings."
    mc "Um simbionte é uma das três subespécies de morphlings. Os outros dois tipos são os slimes e os oozelings."

# game/chapters/chapter4/script/ch4sc19.rpy:3192
translate brazil ch4sc19_19522a1d:

#   mc "They each have their own characteristics and abilities, but I don’t know too much about them."
    mc "Cada um deles possui suas próprias características e habilidades, mas eu não sei muito sobre eles."

# game/chapters/chapter4/script/ch4sc19.rpy:3194
translate brazil ch4sc19_9c3c3597:

#   el "What did you do with it?"
    el "O que você fez com isso?"

# game/chapters/chapter4/script/ch4sc19.rpy:3195
translate brazil ch4sc19_5df55108:

#   el "I haven’t seen you carrying around a sword or anything?"
    el "Não te vi carregando uma espada ou algo do tipo?"

# game/chapters/chapter4/script/ch4sc19.rpy:3197
translate brazil ch4sc19_56684f0e:

#   mc "Symbiotes need a host to survive."
    mc "Os simbiontes precisam de um hospedeiro para sobreviver."

# game/chapters/chapter4/script/ch4sc19.rpy:3198
translate brazil ch4sc19_491e34f7:

#   mc "So... I offered-"
