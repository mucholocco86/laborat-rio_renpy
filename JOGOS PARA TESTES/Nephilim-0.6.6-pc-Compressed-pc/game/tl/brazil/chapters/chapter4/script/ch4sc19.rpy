#   mct "Her heart is pounding... she's completely forgotten that anyone else is here."
    mct "Seu coração está acelerado... ela se esqueceu completamente de que há mais alguém ali."

# game/chapters/chapter4/script/ch4sc19.rpy:2639
translate brazil ch4sc19_0a077657:

#   el "*Whispers* {size=-10}{b}Yum.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Hum.{/b}{/size}"

# game/chapters/chapter4/script/ch4sc19.rpy:2640
translate brazil ch4sc19_3ca38f7c:

#   mc "*Whispers* {size=-10}{b}Yum indeed. I’ll need some more of that later...{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Hum, que delícia! Vou precisar de mais disso depois...{/b}{/size}"

# game/chapters/chapter4/script/ch4sc19.rpy:2641
translate brazil ch4sc19_2768f83d:

#   el "*Whispers* {size=-10}{b}Mh-Hm! Definitely... just... a little appetizer! *Giggles*{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Hum-hum! Com certeza... só... um pequeno aperitivo! *Risos*{/b}{/size}"

# game/chapters/chapter4/script/ch4sc19.rpy:2643
translate brazil ch4sc19_45650fa5:

#   el "*Kiss* Mhmh... Mmhhh."
    el "*Beijo* Mhmh... Mmhhh."

