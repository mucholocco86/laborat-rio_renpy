    lu "*Cantando* Azha... Lir... Lazi'ahi... Luh!"

# game/chapters/chapter4/script/ch4sc19.rpy:1952
translate brazil ch4sc19_3baa83b0:

#   lu "*Groans* {b}NO!!{/b}"
    lu "*Gemidos* {b} NÃO!!{/b}"

# game/chapters/chapter4/script/ch4sc19.rpy:1953
translate brazil ch4sc19_e8f7c1ef:

#   lu "At this rate I’ll never break the curse! And I’m running out of time!"
    lu "Nesse ritmo, nunca vou quebrar a maldição! E estou ficando sem tempo!"

# game/chapters/chapter4/script/ch4sc19.rpy:1955
translate brazil ch4sc19_94fd2eca:

#   lu "He will hurt mother..."
    lu "Ele vai machucar a mãe..."

# game/chapters/chapter4/script/ch4sc19.rpy:1956
translate brazil ch4sc19_40178984:

#   lu "None of my magic is effective on this thing..."
    lu "Nenhuma das minhas magias funciona contra isso..."

# game/chapters/chapter4/script/ch4sc19.rpy:1958
translate brazil ch4sc19_288b5d1c:

#   mct "There she is... Silverish hair, black clothes, big quirky hat."
    mct "Lá está ela... Cabelos prateados, roupas pretas, um chapéu grande e peculiar."

# game/chapters/chapter4/script/ch4sc19.rpy:1959
translate brazil ch4sc19_2204d0eb:

#   mc "Hey, need some help with that?"
    mc "Ei, precisa de ajuda com isso?"

# game/chapters/chapter4/script/ch4sc19.rpy:1962
translate brazil ch4sc19_765bf7e9:

#   lu "*Startled* Who are you?!"
    lu "*Assustada* Quem é você?!"

# game/chapters/chapter4/script/ch4sc19.rpy:1963
translate brazil ch4sc19_652ffdc2:

#   lu "Stay put! Unless you wish to be incinerated!"
    lu "Fique aí! A menos que queira ser incinerado!"

# game/chapters/chapter4/script/ch4sc19.rpy:1965
translate brazil ch4sc19_3f353ab9:

#   mc "Woah, woah! No need to set the place on fire..."
    mc "Calma aí! Não precisa incendiar o lugar..."

# game/chapters/chapter4/script/ch4sc19.rpy:1966
translate brazil ch4sc19_0593fc9f:

#   lu "Speak! Before I set you ablaze!"
    lu "Fale! Antes que eu te incendeie!"

# game/chapters/chapter4/script/ch4sc19.rpy:1967
translate brazil ch4sc19_d532172e:

#   mc "Cassandra asked me to find you. To help you with the cursed relic."
    mc "Cassandra me pediu para te encontrar. Para te ajudar com a relíquia amaldiçoada."

# game/chapters/chapter4/script/ch4sc19.rpy:1968
translate brazil ch4sc19_04cae494:

#   lu "Lies! You don’t know her! You’re one of Tarons lackeys sent to scare me!"
    lu "Mentira! Você não a conhece! Você é um dos capangas do Taron, enviado para me assustar!"

# game/chapters/chapter4/script/ch4sc19.rpy:1970
translate brazil ch4sc19_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter4/script/ch4sc19.rpy:1972
translate brazil ch4sc19_85d9bf51:

#   mc "Don’t... Ever... Associate me with that cockroach!"
    mc "Não... jamais... me associe a essa barata!"

# game/chapters/chapter4/script/ch4sc19.rpy:1974
translate brazil ch4sc19_811f18fa:

#   mc "We clear?"
    mc "Tudo certo?"

# game/chapters/chapter4/script/ch4sc19.rpy:1975
translate brazil ch4sc19_f793e6fc:

#   lu "Okay! Okay..."
    lu "Ok! Ok..."

# game/chapters/chapter4/script/ch4sc19.rpy:1976
translate brazil ch4sc19_0372cd75:

#   lu "So you’re not one of his lackeys? Then who are you?"
    lu "Então você não é um dos seus capangas? Então quem é você?"

# game/chapters/chapter4/script/ch4sc19.rpy:1978
translate brazil ch4sc19_69124a64:

#   mc "I’m [mc], I'm a member of the Adventurer's guild."
    mc "Eu sou [mc] Sou membro da guilda dos aventureiros."

# game/chapters/chapter4/script/ch4sc19.rpy:1979
translate brazil ch4sc19_67bfbe5c:

#   mc "I was investigating an area Taron had kept one of my friends..."
    mc "Eu estava investigando uma área onde Taron mantinha um dos meus amigos..."

# game/chapters/chapter4/script/ch4sc19.rpy:1981
translate brazil ch4sc19_3b5f83a8:

#   lu "That’s where you met my mom. In Taron’s dungeon..."
    lu "Foi lá que você conheceu minha mãe. Na masmorra de Taron..."

# game/chapters/chapter4/script/ch4sc19.rpy:1983
translate brazil ch4sc19_1b5b8024:

#   mc "Yeah, she didn't look to be in pristine condition."
    mc "Sim, ela não parecia estar em perfeitas condições."

# game/chapters/chapter4/script/ch4sc19.rpy:1985
translate brazil ch4sc19_cfe3236d:

#   lu "He’s been keeping her locked up for months... Caged up like an animal!"
    lu "Ele a mantém presa há meses... Enjaulada como um animal!"

# game/chapters/chapter4/script/ch4sc19.rpy:1987
translate brazil ch4sc19_703a742d:

#   lu "I have to free her! *Frustrated sigh* But I haven’t been able to make any progress..."
    lu "Preciso libertá-la! *Suspiro de frustração* Mas não consegui fazer nenhum progresso..."

# game/chapters/chapter4/script/ch4sc19.rpy:1989
translate brazil ch4sc19_ca50e5ec:

#   mc "Cassandra asked me to find you. To help you."
    mc "Cassandra me pediu para te encontrar. Para te ajudar."

# game/chapters/chapter4/script/ch4sc19.rpy:1991
translate brazil ch4sc19_5ba6cdfc:

#   lu "Curious..."
    lu "Curioso..."

# game/chapters/chapter4/script/ch4sc19.rpy:1992
translate brazil ch4sc19_f022f552:

#   lu "Why? Why would you put yourself in danger to help me?"
    lu "Por quê? Por que você se colocaria em perigo para me ajudar?"

# game/chapters/chapter4/script/ch4sc19.rpy:1994
translate brazil ch4sc19_de441682:

#   mc "I'll be honest with you, helping you is not out of the goodness in my heart."
    mc "Para ser sincero, ajudá-lo não é fruto da bondade que tenho no coração."

# game/chapters/chapter4/script/ch4sc19.rpy:1995
translate brazil ch4sc19_6c80befc:

#   mc "I have my own motivations for wanting Taron to suffer... Helping you serves that purpose."
    mc "Tenho minhas próprias motivações para querer que Taron sofra... Ajudá-lo serve a esse propósito."

# game/chapters/chapter4/script/ch4sc19.rpy:1997
translate brazil ch4sc19_e2fcf471:

#   lu "Hmh."
    lu "Hum."

# game/chapters/chapter4/script/ch4sc19.rpy:1998
translate brazil ch4sc19_bf313b1b:

#   mct "She’s smiling?"
    mct "Ela está sorrindo?"

# game/chapters/chapter4/script/ch4sc19.rpy:2000
translate brazil ch4sc19_c4e30688:

#   lu "An alliance... I like it."
    lu "Uma aliança... Gostei."

# game/chapters/chapter4/script/ch4sc19.rpy:2001
translate brazil ch4sc19_85ba59a9:

#   lu "Shake on it?"
    lu "Apertar os dedos?"

# game/chapters/chapter4/script/ch4sc19.rpy:2006
translate brazil ch4sc19_08d63849:

#   mct "Her hands are so delicate..."
    mct "As mãos dela são tão delicadas..."

# game/chapters/chapter4/script/ch4sc19.rpy:2007
translate brazil ch4sc19_5d43714b:

#   lu "We'll work together, to free my mother and bring Taron to justice."
    lu "Vamos trabalhar juntos para libertar minha mãe e levar Taron à justiça."

# game/chapters/chapter4/script/ch4sc19.rpy:2008
translate brazil ch4sc19_dc261575:

#   mc "We'll work together."
    mc "Vamos trabalhar juntos."

# game/chapters/chapter4/script/ch4sc19.rpy:2011
translate brazil ch4sc19_4ea9bb55:

#   mct "She’s kind of cute... If you look past her almost incinerating me earlier..."
    mct "Ela é até bonitinha... Se você ignorar o fato dela quase ter me incinerado mais cedo..."

# game/chapters/chapter4/script/ch4sc19.rpy:2013
translate brazil ch4sc19_dcdcc67a:

#   lu "Okay! Let’s get to it!"
    lu "Certo! Vamos começar!"

# game/chapters/chapter4/script/ch4sc19.rpy:2014
translate brazil ch4sc19_d18e8064:

#   mc "After you."
    mc "Depois de você."

# game/chapters/chapter4/script/ch4sc19.rpy:2016
translate brazil ch4sc19_4410db62:

#   lu "This is what we’re working with. A black blade of unknown origin..."
    lu "É com isto que estamos trabalhando. Uma lâmina negra de origem desconhecida..."

# game/chapters/chapter4/script/ch4sc19.rpy:2017
translate brazil ch4sc19_3443bece:

#   lu "It’s believed to be from the ancient world."
    lu "Acredita-se que seja do mundo antigo."

# game/chapters/chapter4/script/ch4sc19.rpy:2019
translate brazil ch4sc19_84a79d76:

#   mc "Ancient world? As in the world before Balthazar’s rampage?"
    mc "Mundo antigo? Como o mundo antes da fúria de Baltazar?"

# game/chapters/chapter4/script/ch4sc19.rpy:2021
translate brazil ch4sc19_a3eac225:

#   lu "Exactly... You do know some of our history. Curious."
    lu "Exatamente... Você conhece um pouco da nossa história. Curioso."

# game/chapters/chapter4/script/ch4sc19.rpy:2023
translate brazil ch4sc19_39ffc0b2:

#   mc "That means this relic is well over 500 years old, probably more."
    mc "Isso significa que essa relíquia tem bem mais de 500 anos, provavelmente mais."

# game/chapters/chapter4/script/ch4sc19.rpy:2024
translate brazil ch4sc19_edc45a05:

#   mc "I'm guessing it's from the 1st Era."
    mc "Imagino que seja da 1ª Era."

# game/chapters/chapter4/script/ch4sc19.rpy:2026
translate brazil ch4sc19_9c07bd48:

#   lu "Uh-Huh, it's highly likely to be way older."
    lu "Hum, é bem provável que seja bem mais antigo."

# game/chapters/chapter4/script/ch4sc19.rpy:2027
translate brazil ch4sc19_3ad5426c:

#   lu "I haven't been able to determine it's origin."
    lu "Não consegui determinar sua origem."

# game/chapters/chapter4/script/ch4sc19.rpy:2029
translate brazil ch4sc19_85bc4f64:

#   mc "It looks like it’s still in pristine condition... What material is it made of?"
    mc "Parece estar em perfeitas condições... De que material é feito?"

# game/chapters/chapter4/script/ch4sc19.rpy:2030
translate brazil ch4sc19_e4013849:

#   lu "I don’t know... It’s pitch-black all over, even the hilt and handle... Like onyx or obsidian."
    lu "Não sei... É completamente preto, até mesmo o cabo e a empunhadura... Parece ônix ou obsidiana."

# game/chapters/chapter4/script/ch4sc19.rpy:2031
translate brazil ch4sc19_d88ff4e8:

#   mct "Strange... It definitely has potent magic infused into it. Ancient... Dark magic."
    mct "Estranho... Definitivamente possui uma magia poderosa impregnada. Magia antiga... magia negra."

# game/chapters/chapter4/script/ch4sc19.rpy:2033
translate brazil ch4sc19_eedb7d59:

#   mc "Luna, this blade is cursed, correct?"
    mc "Luna, esta lâmina é amaldiçoada, certo?"

# game/chapters/chapter4/script/ch4sc19.rpy:2035
translate brazil ch4sc19_a68d26bf:

#   lu "Yes. I’ve been trying to break the curse by infusing my magic into it, hoping to overwhelm it."
    lu "Sim. Tenho tentado quebrar a maldição infundindo minha magia nela, na esperança de superá-la."

# game/chapters/chapter4/script/ch4sc19.rpy:2036
translate brazil ch4sc19_da317629:

#   lu "But it seems to be protected by some sort of barrier that repels my magic..."
    lu "Mas parece estar protegido por algum tipo de barreira que repele minha magia..."

# game/chapters/chapter4/script/ch4sc19.rpy:2038
translate brazil ch4sc19_4534c083:

#   mc "Mind if I take a look at it?"
    mc "Posso dar uma olhada?"

# game/chapters/chapter4/script/ch4sc19.rpy:2039
translate brazil ch4sc19_0ef6a3dd:

#   lu "Go ahead... I’m at a loss as what to do about it."
    lu "Pode falar... Não sei o que fazer a respeito."

# game/chapters/chapter4/script/ch4sc19.rpy:2041
translate brazil ch4sc19_a6b11a98:

#   lu "What are you doing?"
    lu "O que você está fazendo?"

# game/chapters/chapter4/script/ch4sc19.rpy:2042
translate brazil ch4sc19_e7bd363d:

#   mc "Checking its balance... It’s incredibly light for a sword this size, but perfectly balanced."
    mc "Verificando o equilíbrio... É incrivelmente leve para uma espada deste tamanho, mas perfeitamente equilibrada."

# game/chapters/chapter4/script/ch4sc19.rpy:2043
translate brazil ch4sc19_b3140921:

#   mc "Stand back a bit, I’m going to try to infuse some of my magic into it..."
    mc "Dê um passo para trás, vou tentar infundir um pouco da minha magia nisso..."

# game/chapters/chapter4/script/ch4sc19.rpy:2045
translate brazil ch4sc19_881ab2ac:

#   lu "Your magic? You’re a mage?!"
    lu "Sua magia? Você é um mago?!"

# game/chapters/chapter4/script/ch4sc19.rpy:2046
translate brazil ch4sc19_a28231ab:

#   lu "Why didn't you tell me?"
    lu "Por que você não me contou?"

# game/chapters/chapter4/script/ch4sc19.rpy:2050
translate brazil ch4sc19_721cfd33:

#   mc "No, not like a mage. I’m something else entirely..."
    mc "Não, não como um mago. Sou algo completamente diferente..."

# game/chapters/chapter4/script/ch4sc19.rpy:2055
translate brazil ch4sc19_f0b20201:

#   lu "It’s responding to you?! How?"
    lu "Está respondendo a você?! Como?"

# game/chapters/chapter4/script/ch4sc19.rpy:2057
translate brazil ch4sc19_529b0adf:

#   mc "I’m channeling it with my magic just like you said, to overwhelm it."
    mc "Estou canalizando isso com a minha magia, exatamente como você disse, para sobrepujar essa energia."

# game/chapters/chapter4/script/ch4sc19.rpy:2062
translate brazil ch4sc19_439e2910:

#   lu "By the arcane arts! It’s working?!"
    lu "Pelas artes arcanas! Está funcionando?!"

# game/chapters/chapter4/script/ch4sc19.rpy:2065
translate brazil ch4sc19_a0606342:

#   mc "*Grunts* Ahrrh! Let’s find out!"
    mc "*Grunhidos* Ahrrh! Vamos descobrir!"

# game/chapters/chapter4/script/ch4sc19.rpy:2068
translate brazil ch4sc19_70b83cbc:

#   lu "{b}*Screams*{/b} AAiiiyh!"
    lu "{b}*Gritos*{/b} Aiiiyh!"

# game/chapters/chapter4/script/ch4sc19.rpy:2070
translate brazil ch4sc19_40358752:

#   mc "I can’t hold it much longer! Get down!"
    mc "Não consigo aguentar por muito mais tempo! Desça!"

# game/chapters/chapter4/script/ch4sc19.rpy:2071
translate brazil ch4sc19_e2867a3a:

#   lu "{b}*Shouting*{/b} [mc]! Aiihh!"
    lu "{b}*Gritando*{/b}  [mc]! Aiihh!"

# game/chapters/chapter4/script/ch4sc19.rpy:2079
translate brazil ch4sc19_91d8a70c:

#   mc "You okay?"
    mc "Você está bem?"

# game/chapters/chapter4/script/ch4sc19.rpy:2080
translate brazil ch4sc19_6cac2c3e:

#   lu "*Shaking* Y-Yes... I... I think so."
    lu "*Tremendo* S-Sim... Eu... Eu acho que sim."

# game/chapters/chapter4/script/ch4sc19.rpy:2082
translate brazil ch4sc19_06854158:

#   lu "By the Arcane! What was that?! Did it work?"
    lu "Pelo Arcano! O que foi isso?! Funcionou?"

# game/chapters/chapter4/script/ch4sc19.rpy:2083
translate brazil ch4sc19_531118f5:

#   lu "Is the curse finally broken?"
    lu "A maldição foi finalmente quebrada?"

# game/chapters/chapter4/script/ch4sc19.rpy:2085
translate brazil ch4sc19_10ac3f14:

#   mc "Not yet... I felt it giving way but I might have to do it over several attempts."
    mc "Ainda não... Senti que estava cedendo, mas talvez precise de várias tentativas."

# game/chapters/chapter4/script/ch4sc19.rpy:2086
translate brazil ch4sc19_00d11cd3:

#   mc "Do you mind if I stay here and continue working on it?"
    mc "Você se importa se eu ficar aqui e continuar trabalhando nisso?"

# game/chapters/chapter4/script/ch4sc19.rpy:2088
translate brazil ch4sc19_b2f115b7:

#   lu "Not at all! But... What should I do? My magic won’t work on it."
    lu "De jeito nenhum! Mas... O que eu devo fazer? Minha magia não vai funcionar nisso."

# game/chapters/chapter4/script/ch4sc19.rpy:2089
translate brazil ch4sc19_5c2d91de:

#   lu "I can’t just sit still while my mother is imprisoned..."
    lu "Não posso ficar parada enquanto minha mãe está presa..."

# game/chapters/chapter4/script/ch4sc19.rpy:2091
translate brazil ch4sc19_dad4271b:

#   mc "Your mother mentioned a hex put on her? Preventing her from leaving, my friend Alice is working on it."
    mc "Sua mãe mencionou que fizeram um feitiço nela? Para impedi-la de ir embora, minha amiga Alice está trabalhando nisso."

# game/chapters/chapter4/script/ch4sc19.rpy:2092
translate brazil ch4sc19_a9796548:

#   mc "She isn’t magically gifted though and could probably use your help in finding a way to break the hex."
    mc "Ela não possui dons mágicos, e provavelmente sua ajuda seria bem-vinda para encontrar uma maneira de quebrar o feitiço."

# game/chapters/chapter4/script/ch4sc19.rpy:2094
translate brazil ch4sc19_869b1676:

#   lu "Oh, you know Alice? She’s really sweet!"
    lu "Ah, você conhece a Alice? Ela é muito querida!"

# game/chapters/chapter4/script/ch4sc19.rpy:2096
translate brazil ch4sc19_3c0bdb1b:

#   lu "*Mumbles* She’s... My only friend..."
    lu "*Murmura* Ela é... Minha única amiga..."

# game/chapters/chapter4/script/ch4sc19.rpy:2098
translate brazil ch4sc19_d31c096b:

#   lu "I really appreciate you doing this..."
    lu "Agradeço muito por você ter feito isso..."

# game/chapters/chapter4/script/ch4sc19.rpy:2099
translate brazil ch4sc19_b64974c7:

#   lu "I know you aren't doing it for me... But-... Thank you."
    lu "Eu sei que você não está fazendo isso por mim... Mas... Obrigada."

# game/chapters/chapter4/script/ch4sc19.rpy:2101
translate brazil ch4sc19_2edec4cc:

#   mc "You don't have to thank me, as you said, I have my own reasons for helping."
    mc "Você não precisa me agradecer, como você disse, eu tenho meus próprios motivos para ajudar."

# game/chapters/chapter4/script/ch4sc19.rpy:2103
translate brazil ch4sc19_6e5ed369:

#   lu "Just one thing before I go to help her..."
    lu "Só mais uma coisa antes de eu ir ajudá-la..."

# game/chapters/chapter4/script/ch4sc19.rpy:2106
translate brazil ch4sc19_ee87e6f3:

#   mc "Oh?"
    mc "Oh?"

# game/chapters/chapter4/script/ch4sc19.rpy:2109
translate brazil ch4sc19_3ab62f97:

#   lu "Regardless of intentions, your help is valuable to me. So-"
    lu "Independentemente das intenções, sua ajuda é valiosa para mim. Então-"

# game/chapters/chapter4/script/ch4sc19.rpy:2111
translate brazil ch4sc19_f9191029:

#   lu "*Mwah*"
    lu "*Beijo*"

# game/chapters/chapter4/script/ch4sc19.rpy:2112
translate brazil ch4sc19_1cbd20cf:

#   mct "That was unexpected... I guess she really appreciates someone trying to help her mom."
    mct "Isso foi inesperado... Acho que ela realmente aprecia que alguém esteja tentando ajudar a mãe dela."

# game/chapters/chapter4/script/ch4sc19.rpy:2113
translate brazil ch4sc19_d691242b:

#   mct "Can’t have been easy dealing with all this on her own as an 18 year old..."
    mct "Não deve ter sido fácil lidar com tudo isso sozinha aos 18 anos..."

# game/chapters/chapter4/script/ch4sc19.rpy:2114
translate brazil ch4sc19_a3fea6c0:

#   mct "Her scent... Vanilla and Orchids."
    mct "O perfume dela... Baunilha e orquídeas."

# game/chapters/chapter4/script/ch4sc19.rpy:2115
translate brazil ch4sc19_eec05c2b:

#   "Luna's warm, soft lips lingers for a few moments before stepping back."
    "Os lábios quentes e macios de Luna permanecem por alguns instantes antes de ela se afastar."

# game/chapters/chapter4/script/ch4sc19.rpy:2117
translate brazil ch4sc19_efd8b75d:

#   lu "Sorry! I-I'm just grateful!"
    lu "Desculpe! Eu... eu só estou grato!"

# game/chapters/chapter4/script/ch4sc19.rpy:2118
translate brazil ch4sc19_b34759c1:

#   lu "A-And your super cute! And dark! Tall and dark! Um-Hh!"
    lu "E você é super fofo! E moreno! Alto e moreno! Hum-Hh!"

# game/chapters/chapter4/script/ch4sc19.rpy:2120
translate brazil ch4sc19_6153e3cc:

#   lu "Aaaand I’m rambling like a total mess..."
    lu "E eu estou divagando como uma completa bagunça..."

# game/chapters/chapter4/script/ch4sc19.rpy:2121
translate brazil ch4sc19_4e475a52:

#   lu "Byee!"
    lu "Tchau!"

# game/chapters/chapter4/script/ch4sc19.rpy:2126
translate brazil ch4sc19_0d514b23:

#   mct "*Sigh* She seems sweet and trustworthy... And Alice likes her."
    mct "*Suspiro* Ela parece doce e confiável... E Alice gosta dela."

# game/chapters/chapter4/script/ch4sc19.rpy:2127
translate brazil ch4sc19_75d060b7:

#   mct "But after Selena, I don’t want to take any chances when it comes to Taron."
    mct "Mas depois da Selena, não quero correr nenhum risco em relação ao Taron."

# game/chapters/chapter4/script/ch4sc19.rpy:2128
translate brazil ch4sc19_243d7923:

#   mct "It’s better if nobody knows I actually broke the curse..."
    mct "É melhor que ninguém saiba que eu quebrei a maldição..."

# game/chapters/chapter4/script/ch4sc19.rpy:2130
translate brazil ch4sc19_b6f32136:

#   mct "But why would a sword from the ancient world be of value to Taron?"
    mct "Mas por que uma espada do mundo antigo teria valor para Taron?"

# game/chapters/chapter4/script/ch4sc19.rpy:2131
translate brazil ch4sc19_2b8d151b:

#   mct "And why would it have that strong of a curse placed on it?"
    mct "E por que teria uma maldição tão forte sobre si?"

# game/chapters/chapter4/script/ch4sc19.rpy:2133
translate brazil ch4sc19_d4cfb36c:

#   mct "Since Sylph and I aren’t on speaking terms right now..."
    mct "Já que eu e Sylph não estamos nos falando no momento..."

# game/chapters/chapter4/script/ch4sc19.rpy:2134
translate brazil ch4sc19_b3d8530b:

#   mct "I guess there's only one way to figure this out... I’ll have to disenchant it myself."
    mct "Acho que só há uma maneira de descobrir isso... Vou ter que desencantá-lo eu mesmo."

# game/chapters/chapter4/script/ch4sc19.rpy:2139
translate brazil ch4sc19_fdbade3f:

#   mc "{b}W-WHAT THE?!{/b}"
    mc "{b}O QUÊ?!{/b}"

# game/chapters/chapter4/script/ch4sc19.rpy:2148
translate brazil ch4sc19_ab768b38:

#   mct "Five hells... What is going on? The sword is transforming into a..."
    mct "Pelos cinco infernos... O que está acontecendo? A espada está se transformando em..."

# game/chapters/chapter4/script/ch4sc19.rpy:2152
translate brazil ch4sc19_4af1ea21:

#   mct "Woman?"
    mct "Mulher?"

# game/chapters/chapter4/script/ch4sc19.rpy:2154
translate brazil ch4sc19_05fb0624:

#   uk "You."
    uk "Você."

# game/chapters/chapter4/script/ch4sc19.rpy:2155
translate brazil ch4sc19_58259508:

#   uk "You freed me."
    uk "Você me libertou."

# game/chapters/chapter4/script/ch4sc19.rpy:2159
translate brazil ch4sc19_0fb77c47:

#   mc "What... Are you?"
    mc "O que você está?"

# game/chapters/chapter4/script/ch4sc19.rpy:2162
translate brazil ch4sc19_1aa7e082:

#   mc "I broke a curse placed on the blade... Which you emerged from?"
    mc "Quebrei uma maldição lançada sobre a lâmina... Da qual você emergiu?"

# game/chapters/chapter4/script/ch4sc19.rpy:2164
translate brazil ch4sc19_6a9fe13d:

#   uk "You don’t know what I am?"
    uk "Você não sabe o que eu sou?"

# game/chapters/chapter4/script/ch4sc19.rpy:2166
translate brazil ch4sc19_8c352251:

#   mc "No? I’ve never seen anything like you."
    mc "Não? Nunca vi nada parecido com você."

# game/chapters/chapter4/script/ch4sc19.rpy:2168
translate brazil ch4sc19_b9edfba1:

#   uk "Tell me, What year is this?"
    uk "Diga-me, em que ano estamos?"

# game/chapters/chapter4/script/ch4sc19.rpy:2170
translate brazil ch4sc19_a12b6f07:

#   mc "Year 562 of the 2nd Era."
    mc "Ano 562 da 2ª Era."

# game/chapters/chapter4/script/ch4sc19.rpy:2173
translate brazil ch4sc19_7d617133:

#   uk "{b}WHAT?!{/b} Has it really been that long..."
    uk "{b}O QUE?!{/b} Já faz tanto tempo assim...?"

# game/chapters/chapter4/script/ch4sc19.rpy:2175
translate brazil ch4sc19_c9d9fbdf:

#   mc "You still haven’t told me what you are."
    mc "Você ainda não me disse o que você é."

# game/chapters/chapter4/script/ch4sc19.rpy:2177
translate brazil ch4sc19_d16da9a4:

#   uk "I’m a Symbiote! Silly!"
    uk "Eu sou um simbionte! Que bobagem!"

# game/chapters/chapter4/script/ch4sc19.rpy:2179
translate brazil ch4sc19_54f0e37c:

#   uk "You know... Like a Slime or Oozeling just... Cooler!"
    uk "Sabe... Tipo uma gosma ou algo escorrendo, só que... Mais legal!"

# game/chapters/chapter4/script/ch4sc19.rpy:2181
translate brazil ch4sc19_bcfc91cb:

#   mc "What’s the difference?"
    mc "Qual é a diferença?"

# game/chapters/chapter4/script/ch4sc19.rpy:2183
translate brazil ch4sc19_ab6647ae:

#   uk "I’ll pretend you didn’t just say that!"
    uk "Vou fingir que você não disse isso!"

# game/chapters/chapter4/script/ch4sc19.rpy:2185
translate brazil ch4sc19_e53eb0c3:

#   uk "There’s too many differences to go over them all right now... But I suppose the main difference is-"
    uk "Existem muitas diferenças para serem abordadas todas agora... Mas suponho que a principal diferença seja:"

# game/chapters/chapter4/script/ch4sc19.rpy:2187
translate brazil ch4sc19_0fa3449e:

#   uk "How we survive, slimes has to devour bio-organisms to survive."
    uk "Para sobrevivermos, os lodos precisam devorar outros organismos biológicos."

# game/chapters/chapter4/script/ch4sc19.rpy:2189
translate brazil ch4sc19_c198168e:

#   uk "Oozelings survive by feeding on in-animate objects and materials. Disgusting I know! Blegh!"
    uk "Os gosmentos sobrevivem alimentando-se de objetos e materiais inanimados. Que nojo, eu sei! Credo!"

# game/chapters/chapter4/script/ch4sc19.rpy:2191
translate brazil ch4sc19_06e282bc:

#   uk "And Symbiotes, like myself survive by forming a symbiosis with a living being!"
    uk "E os simbiontes, como eu, sobrevivem formando uma simbiose com um ser vivo!"

# game/chapters/chapter4/script/ch4sc19.rpy:2193
translate brazil ch4sc19_60a17f30:

#   mc "Symbiosis? Like a give and take between the host and you?"
    mc "Simbiose? Algo como uma troca entre o hospedeiro e você?"

# game/chapters/chapter4/script/ch4sc19.rpy:2195
translate brazil ch4sc19_a6003f93:

#   uk "Exactly! You’re brilliant! Catching on quickly."
    uk "Exatamente! Você é brilhante! Está aprendendo rápido."

# game/chapters/chapter4/script/ch4sc19.rpy:2197
translate brazil ch4sc19_beb8cfa3:

#   uk "As a Symbiote, I need essence from a living host to survive."
    uk "Como simbionte, preciso da essência de um hospedeiro vivo para sobreviver."

# game/chapters/chapter4/script/ch4sc19.rpy:2199
translate brazil ch4sc19_2dacfad6:

#   mc "Won’t that kill the host?"
    mc "Isso não vai matar o hospedeiro?"

# game/chapters/chapter4/script/ch4sc19.rpy:2201
translate brazil ch4sc19_33f26cca:

#   uk "In most cases yes. We usually seek a host with a high amount of essence or life-force."
    uk "Na maioria dos casos, sim. Geralmente buscamos um hospedeiro com uma grande quantidade de essência ou força vital."

# game/chapters/chapter4/script/ch4sc19.rpy:2203
translate brazil ch4sc19_7e486c6f:

#   uk "That way we can survive for longer and benefit from symbiosis."
    uk "Dessa forma, podemos sobreviver por mais tempo e nos beneficiar da simbiose."

# game/chapters/chapter4/script/ch4sc19.rpy:2205
translate brazil ch4sc19_a6ff0b0e:

#   mc "What does the host gain from the symbiosis?"
    mc "O que o hospedeiro ganha com a simbiose?"

# game/chapters/chapter4/script/ch4sc19.rpy:2207
translate brazil ch4sc19_844baba4:

#   uk "Lots of benefits! A telepathic connection between host and symbiote is established."
    uk "Muitos benefícios! Uma conexão telepática entre hospedeiro e simbionte é estabelecida."

# game/chapters/chapter4/script/ch4sc19.rpy:2209
translate brazil ch4sc19_aab0172e:

#   uk "And the host will benefit from increased physical power! Symbiotes are very powerful!"
    uk "E o hospedeiro se beneficiará com o aumento da força física! Os simbiontes são muito poderosos!"

# game/chapters/chapter4/script/ch4sc19.rpy:2210
translate brazil ch4sc19_f451943b:

#   mct "Hmh... This is not what I expected... Is that why Taron wants this creature? To increase his power?"
    mct "Hum... Não era isso que eu esperava... Será que é por isso que Taron quer essa criatura? Para aumentar seu poder?"

# game/chapters/chapter4/script/ch4sc19.rpy:2212
translate brazil ch4sc19_596ea5f7:

#   mct "What if I were to enter this symbiosis it’s talking about? I have vast amounts of essence and I am able to regenerate."
    mct "E se eu entrasse nessa simbiose da qual se fala? Tenho vastas quantidades de essência e sou capaz de me regenerar."

# game/chapters/chapter4/script/ch4sc19.rpy:2214
translate brazil ch4sc19_21f6d6ce:

#   ox "I’m Onyx btw!"
    ox "A propósito, meu nome é Onyx!"

# game/chapters/chapter4/script/ch4sc19.rpy:2216
translate brazil ch4sc19_9381e834:

#   mc "Nice to meet you Onyx, I’m [mc]."
    mc "Prazer em conhecê-lo, Onyx. Eu sou... [mc]."

# game/chapters/chapter4/script/ch4sc19.rpy:2218
translate brazil ch4sc19_5c6e7c1b:

#   ox "[mc], Hmh! I like it!"
    ox "[mc] Hum! Gostei!"

# game/chapters/chapter4/script/ch4sc19.rpy:2220
translate brazil ch4sc19_530a0579:

#   mc "Onyx, why were you under that curse?"
    mc "Onyx, por que você estava sob essa maldição?"

# game/chapters/chapter4/script/ch4sc19.rpy:2222
translate brazil ch4sc19_5ce00565:

#   ox "Ugh! That stupid witch cursed me!"
    ox "Argh! Aquela bruxa estúpida me amaldiçoou!"

# game/chapters/chapter4/script/ch4sc19.rpy:2223
translate brazil ch4sc19_38270520:

#   ox "She forced me into the shape of a blade and put an immobiluz curse on me."
    ox "Ela me forçou a assumir a forma de uma lâmina e lançou uma maldição de imobilização sobre mim."

# game/chapters/chapter4/script/ch4sc19.rpy:2225
translate brazil ch4sc19_efe3aa0a:

#   ox "It’s basically like a stasis spell, only permanent until broken by sheer force of power."
    ox "É basicamente como um feitiço de estase, só que permanente até ser quebrado pela força bruta."

# game/chapters/chapter4/script/ch4sc19.rpy:2227
translate brazil ch4sc19_75392849:

#   ox "You... You must be very powerful to break such a curse."
    ox "Você... Você deve ser muito poderoso para quebrar uma maldição dessas."

# game/chapters/chapter4/script/ch4sc19.rpy:2229
translate brazil ch4sc19_e7f2ab83:

#   mc "I suppose... So you need a host to survive now that the curse is broken?"
    mc "Imagino... Então você precisa de um hospedeiro para sobreviver agora que a maldição foi quebrada?"

# game/chapters/chapter4/script/ch4sc19.rpy:2231
translate brazil ch4sc19_d6a9aee6:

#   ox "Yes... Afraid I won’t be able to manifest for long without a host and their essence."
    ox "Sim... receio que não conseguirei manifestar por muito tempo sem um hospedeiro e sua essência."

# game/chapters/chapter4/script/ch4sc19.rpy:2233
translate brazil ch4sc19_85f5e262:

#   mc "A man named Taron wants you for himself, do you know him?"
    mc "Um homem chamado Taron quer você para si, você o conhece?"

# game/chapters/chapter4/script/ch4sc19.rpy:2235
translate brazil ch4sc19_cd47da77:

#   ox "Taron... No. I’ve been asleep for well over 500 years if what you told me earlier is true."
    ox "Taron... Não. Se o que você me disse antes for verdade, eu estive dormindo por mais de 500 anos."

# game/chapters/chapter4/script/ch4sc19.rpy:2237
translate brazil ch4sc19_509c22f8:

#   ox "Last I remember some warlord named Balthazar wanted to acquire me during the age of the rebellion wars."
    ox "A última vez que me lembro, um senhor da guerra chamado Balthazar queria me capturar durante a época das guerras de rebelião."

# game/chapters/chapter4/script/ch4sc19.rpy:2239
translate brazil ch4sc19_96ca20a6:

#   mc "You knew Balthazar?"
    mc "Você conhecia Baltazar?"

# game/chapters/chapter4/script/ch4sc19.rpy:2241
translate brazil ch4sc19_1bb1af13:

#   ox "Not personally... I knew ‘of’ him. He had quite the reputation! You didn’t want to stand in his way."
    ox "Pessoalmente, não... Eu já tinha ouvido falar dele. Ele tinha uma reputação e tanto! Ninguém queria cruzar o seu caminho."

# game/chapters/chapter4/script/ch4sc19.rpy:2243
translate brazil ch4sc19_52161eb6:

#   ox "Lord of Embers they often referred to him as. He would torment those who stood against him by burning them alive..."
    ox "O Senhor das Brasas era como costumavam chamá-lo. Ele atormentava aqueles que se opunham a ele, queimando-os vivos..."

# game/chapters/chapter4/script/ch4sc19.rpy:2245
translate brazil ch4sc19_55588794:

#   mc "Balthazar is gone, has been for 500 years."
    mc "Baltazar se foi, já faz 500 anos."

# game/chapters/chapter4/script/ch4sc19.rpy:2247
translate brazil ch4sc19_881491d6:

#   ox "Good! I don’t care much for world destruction and all that. I’m a simple symbiote... I like to be alive!"
    ox "Ótimo! Não me importo muito com destruição do mundo e essas coisas. Sou apenas um simbionte... Gosto de estar vivo!"

# game/chapters/chapter4/script/ch4sc19.rpy:2249
translate brazil ch4sc19_f8ecdb4a:

#   ox "And thanks to you... I finally feel alive again."
    ox "E graças a vocês... finalmente me sinto vivo de novo."

# game/chapters/chapter4/script/ch4sc19.rpy:2251
translate brazil ch4sc19_112d9a86:

#   ox "So this... ‘Taron’ wants to enter symbiosis with me?"
    ox "Então... esse tal de 'Taron' quer entrar em simbiose comigo?"

# game/chapters/chapter4/script/ch4sc19.rpy:2253
translate brazil ch4sc19_fef8a09e:

#   ox "However... He didn’t free me."
    ox "No entanto... Ele não me libertou."

# game/chapters/chapter4/script/ch4sc19.rpy:2255
translate brazil ch4sc19_f9cef812:

#   ox "You did."
    ox "Você fez."

# game/chapters/chapter4/script/ch4sc19.rpy:2256
translate brazil ch4sc19_2d326299:

#   ox "You removed the shackles on me, Mhm..."
    ox "Você removeu as correntes que me prendiam, Mhm..."

# game/chapters/chapter4/script/ch4sc19.rpy:2258
translate brazil ch4sc19_20bdfca1:

#   ox "Would you be open to me?"
    ox "Você estaria disposto(a) a se abrir comigo?"

# game/chapters/chapter4/script/ch4sc19.rpy:2259
translate brazil ch4sc19_c3d1b699:

#   ox "To... Bond with me? To... Have me?"
    ox "Para... criar laços comigo? Para... me ter?"

# game/chapters/chapter4/script/ch4sc19.rpy:2261
translate brazil ch4sc19_cc1a0d35:

#   ox "You freed me... You deserve me. I could be yours if you want it..."
    ox "Você me libertou... Você me merece. Eu poderia ser sua se você quisesse..."

# game/chapters/chapter4/script/ch4sc19.rpy:2262
translate brazil ch4sc19_8a84d7d8:

#   ox "With you as my host... I wouldn’t just be feeding to survive... You would make my life... Exciting."
    ox "Com você como meu anfitrião... eu não estaria apenas me alimentando para sobreviver... Você tornaria minha vida... emocionante."

# game/chapters/chapter4/script/ch4sc19.rpy:2265
translate brazil ch4sc19_e7f8d71a:

#   ox "Something I crave desperately... Being stuck as a cursed object for 500 years... Not very thrilling."
    ox "Algo que eu desejo desesperadamente... Ficar preso como um objeto amaldiçoado por 500 anos... Nada emocionante."

# game/chapters/chapter4/script/ch4sc19.rpy:2266
translate brazil ch4sc19_57c02c70:

#   ox "Just sensing the magic within you ... Sends tingles throughout my body."
    ox "Só de sentir a magia que existe em você... já me dá arrepios por todo o corpo."

# game/chapters/chapter4/script/ch4sc19.rpy:2268
translate brazil ch4sc19_c756124f:

#   mc "How would it work?"
    mc "Como funcionaria?"

# game/chapters/chapter4/script/ch4sc19.rpy:2269
translate brazil ch4sc19_bfecdb0c:

#   mc "You would become part of me?"
    mc "Você se tornaria parte de mim?"

# game/chapters/chapter4/script/ch4sc19.rpy:2270
translate brazil ch4sc19_e8e0cbed:

#   ox "Yes, as we enter symbiosis, we will merge into one."
    ox "Sim, ao entrarmos em simbiose, nos fundiremos em um só."

# game/chapters/chapter4/script/ch4sc19.rpy:2272
translate brazil ch4sc19_e2910618:

#   ox "We will be able to communicate through your mind. You will be able to call upon me if you need me."
    ox "Poderemos nos comunicar através da sua mente. Você poderá me chamar se precisar de mim."

# game/chapters/chapter4/script/ch4sc19.rpy:2273
translate brazil ch4sc19_163face1:

#   ox "You could use me as a weapon in battle. Or I could shield you from harm."
    ox "Você poderia me usar como arma em batalha. Ou eu poderia protegê-lo(a) de qualquer mal."

# game/chapters/chapter4/script/ch4sc19.rpy:2275
translate brazil ch4sc19_f93c48a4:

#   mc "What about the whole you feeding on my essence situation?"
    mc "E quanto a toda essa situação de você se alimentar da minha essência?"

# game/chapters/chapter4/script/ch4sc19.rpy:2276
translate brazil ch4sc19_36f6fdd3:

#   ox "You’ve got more magic within you than I’ve ever seen... It would take years if not decades for me to drain you ..."
    ox "Você possui mais magia dentro de si do que eu jamais vi... Levaria anos, talvez décadas, para eu drenar toda a sua energia..."

# game/chapters/chapter4/script/ch4sc19.rpy:2277
translate brazil ch4sc19_379376e0:

#   mc "Encouraging..."
    mc "Encorajador..."

# game/chapters/chapter4/script/ch4sc19.rpy:2279
translate brazil ch4sc19_875f4f4a:

#   mct "She doesn’t know about my regenerative powers..."
    mct "Ela não sabe sobre meus poderes regenerativos..."

# game/chapters/chapter4/script/ch4sc19.rpy:2280
translate brazil ch4sc19_5ad1fed8:

#   mct "They could potentially recover and off-set the magic she needs to survive."
    mct "Eles poderiam potencialmente se recuperar e compensar a magia que ela precisa para sobreviver."

# game/chapters/chapter4/script/ch4sc19.rpy:2283
translate brazil ch4sc19_4c6e4c96:

#   mct "I can't let Taron have her... If what she claims is true, she will be a tremendous asset."
    mct "Não posso deixar que Taron fique com ela... Se o que ela afirma for verdade, ela será uma grande aliada."

# game/chapters/chapter4/script/ch4sc19.rpy:2284
translate brazil ch4sc19_d29a3e7f:

#   mct "Even Balthazar sought her... If I'm to do this, we better do it right, I'll be honest with her."
    mct "Até Baltazar a cortejou... Se eu vou fazer isso, é melhor fazermos direito, serei honesto com ela."

# game/chapters/chapter4/script/ch4sc19.rpy:2286
translate brazil ch4sc19_caf380c5:

#   mc "Onyx, I have the ability to passively regenerate. Would that affect anything?"
    mc "Onyx, eu tenho a habilidade de regeneração passiva. Isso afetaria alguma coisa?"

# game/chapters/chapter4/script/ch4sc19.rpy:2287
translate brazil ch4sc19_19a83f34:

#   ox "Yes! Yes it would! How exciting this is!"
    ox "Sim! Sim, seria mesmo! Que emocionante!"

# game/chapters/chapter4/script/ch4sc19.rpy:2289
translate brazil ch4sc19_c703cd42:

#   ox "This means we could maintain symbiosis... As long as we want! Years... Decades... Centuries!"
    ox "Isso significa que poderíamos manter a simbiose... Pelo tempo que quiséssemos! Anos... Décadas... Séculos!"

# game/chapters/chapter4/script/ch4sc19.rpy:2290
translate brazil ch4sc19_4f735e62:

#   ox "*Moans* I'm quivering at the thought!"
    ox "*Gemidos* Só de pensar nisso já me dá arrepios!"

# game/chapters/chapter4/script/ch4sc19.rpy:2291
translate brazil ch4sc19_a720966e:

#   ox "There’s essentially two ways for maintaining our symbiosis."
    ox "Existem basicamente duas maneiras de manter nossa simbiose."

# game/chapters/chapter4/script/ch4sc19.rpy:2293
translate brazil ch4sc19_a12d94aa:

#   ox "One. I feed passively from you as I’ve done with my past hosts..."
    ox "Um. Eu me alimento passivamente de você, como fiz com meus hospedeiros anteriores..."

# game/chapters/chapter4/script/ch4sc19.rpy:2294
translate brazil ch4sc19_4627ca4e:

#   ox "Boring, but it does the trick."
    ox "Chato, mas funciona."

# game/chapters/chapter4/script/ch4sc19.rpy:2296
translate brazil ch4sc19_90915021:

#   ox "Or... Two. I feed actively from you... Much more exciting!"
    ox "Ou... dois. Eu me alimento ativamente de você... Muito mais emocionante!"

# game/chapters/chapter4/script/ch4sc19.rpy:2298
translate brazil ch4sc19_df6ff0fb:

#   mc "Actively?"
    mc "Ativamente?"

# game/chapters/chapter4/script/ch4sc19.rpy:2300
translate brazil ch4sc19_4f8867ed:

#   ox "*Sensual tone* Actively... Very actively..."
    ox "*Tom sensual* Ativamente... Muito ativamente..."

# game/chapters/chapter4/script/ch4sc19.rpy:2302
translate brazil ch4sc19_b8c67f51:

#   mc "You mean..."
    mc "Você quer dizer..."

# game/chapters/chapter4/script/ch4sc19.rpy:2304
translate brazil ch4sc19_007d0ca8:

#   ox "Why don’t I show you..."
    ox "Por que eu não te mostro...?"

# game/chapters/chapter4/script/ch4sc19.rpy:2311
translate brazil ch4sc19_e94c4491:

#   mct "This could be interesting."
    mct "Isso pode ser interessante."

# game/chapters/chapter4/script/ch4sc19.rpy:2313
translate brazil ch4sc19_352967ff:

#   mc "Go ahead. Show me how you would like to be fed."
    mc "Vamos lá. Mostre-me como você gostaria de ser alimentado."

# game/chapters/chapter4/script/ch4sc19.rpy:2316
translate brazil ch4sc19_bda0d885:

#   ox "Exciting! Thrilling! Mmnn... You will have to lose these!"
    ox "Que emocionante! Que eletrizante! Hummm... Você vai ter que se livrar disso!"

# game/chapters/chapter4/script/ch4sc19.rpy:2318
translate brazil ch4sc19_e766f21d:

#   ox "Mnnh... What a fine specimen you are."
    ox "Hum... Que belo exemplar você é."

# game/chapters/chapter4/script/ch4sc19.rpy:2319
translate brazil ch4sc19_62abb5aa:

#   ox "Such a warm and well built body. Mhm..."
    ox "Um corpo tão quente e bem-feito. Hum..."

# game/chapters/chapter4/script/ch4sc19.rpy:2320
translate brazil ch4sc19_38197645:

#   ox "I’m very excited for you to be my host..."
    ox "Estou muito animado por você ser meu anfitrião..."

# game/chapters/chapter4/script/ch4sc19.rpy:2321
translate brazil ch4sc19_ae398abe:

