# game/chapters/chapter4/script/ch4sc5.rpy:201
translate brazil ch4sc5_888d936d:

#   al "O-Our date..."
    al "O-Nosso encontro..."

# game/chapters/chapter4/script/ch4sc5.rpy:203
translate brazil ch4sc5_58bc3702:

#   al "For real?! You really want to go on a date with me?!"
    al "Sério?! Você realmente quer sair comigo?!"

# game/chapters/chapter4/script/ch4sc5.rpy:204
translate brazil ch4sc5_32ffa76b:

#   al "Both! I want both!"
    al "Ambos! Quero ambos!"

# game/chapters/chapter4/script/ch4sc5.rpy:206
translate brazil ch4sc5_d2cd3d34:

#   "In utter excitement, Alice plants her soft lips against your cheek."
    "Em êxtase, Alice encosta seus lábios macios em sua bochecha."

# game/chapters/chapter4/script/ch4sc5.rpy:207
translate brazil ch4sc5_15b2500d:

#   al "*Mwaaah*"
    al "*Mwaaah*"

# game/chapters/chapter4/script/ch4sc5.rpy:208
translate brazil ch4sc5_98845e8f:

#   al_t "I want to kiss him so badly!!"
    al_t "Eu quero muito beijá-lo!!"

# game/chapters/chapter4/script/ch4sc5.rpy:209
translate brazil ch4sc5_280beb71:

#   "Her vanilla-scented hair engulfs you while her lips gently release their pressure on your cheek."
    "Seus cabelos com aroma de baunilha te envolvem enquanto seus lábios aliviam suavemente a pressão em sua bochecha."

# game/chapters/chapter4/script/ch4sc5.rpy:211
translate brazil ch4sc5_9bd1d7e8:

#   "Then slowly she lifts her warm lips off your cheek..."
    "Então, lentamente, ela afasta seus lábios quentes da sua bochecha..."

# game/chapters/chapter4/script/ch4sc5.rpy:212
translate brazil ch4sc5_6c3fa1f2:

#   "And moves slightly so that they graze your lips too, clearly longing for a kiss which she can't allow herself."
    "E move-se ligeiramente, de modo que roçam também os seus lábios, claramente desejando um beijo que ela não se permite."

# game/chapters/chapter4/script/ch4sc5.rpy:213
translate brazil ch4sc5_e7748d11:

#   "She lets out a small whimper as her nipple pushes into your chest."
    "Ela solta um pequeno gemido quando seu mamilo pressiona seu peito."

# game/chapters/chapter4/script/ch4sc5.rpy:215
translate brazil ch4sc5_d7ff3cf8:

#   al "*Whimpers* Mhhm!"
    al "*Geme* Mhhm!"

# game/chapters/chapter4/script/ch4sc5.rpy:216
translate brazil ch4sc5_6abbb721:

#   al_t "Heavens! I'm so sensitive..."
    al_t "Nossa! Eu sou tão sensível..."

# game/chapters/chapter4/script/ch4sc5.rpy:218
translate brazil ch4sc5_6927b77f:

#   al "Sweet dreams, [mc]."
    al "Bons sonhos, [mc]."

# game/chapters/chapter4/script/ch4sc5.rpy:219
translate brazil ch4sc5_838687e3:

#   "Alice is overcome with joy with the idea of an actual date with you, her trust has increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Alice está radiante com a ideia de um encontro de verdade com você, e sua confiança aumentou muito. {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter4/script/ch4sc5.rpy:226
translate brazil ch4sc5_2cd78978:

#   mc "I don’t think that’s a good idea."
    mc "Não acho que seja uma boa ideia."

# game/chapters/chapter4/script/ch4sc5.rpy:227
translate brazil ch4sc5_0f3f4143:

#   mc "I don’t want us to cross a line we can’t uncross."
    mc "Não quero que ultrapassemos um limite que não possamos reverter."

# game/chapters/chapter4/script/ch4sc5.rpy:229
translate brazil ch4sc5_caee4eed:

#   al "I understand... I just don’t want to lose you again."
    al "Eu entendo... Só não quero te perder de novo."

# game/chapters/chapter4/script/ch4sc5.rpy:230
translate brazil ch4sc5_a724c266:

#   al "I only just got you back in my life."
    al "Acabei de te reconquistar."

# game/chapters/chapter4/script/ch4sc5.rpy:232
translate brazil ch4sc5_469b4503:

#   mc "Always and forever, Alice."
    mc "Para sempre e sempre, Alice."

# game/chapters/chapter4/script/ch4sc5.rpy:234
translate brazil ch4sc5_15ecaeca:

#   al "Always and forever, goodnight!"
    al "Sempre e para sempre, boa noite!"

# game/chapters/chapter4/script/ch4sc5.rpy:239
translate brazil ch4sc5_4df62533:

#   "Sleep quickly claims you..."
    "O sono te pega de jeito rapidinho..."

# game/chapters/chapter4/script/ch4sc5.rpy:240
translate brazil ch4sc5_0f821e70:

#   "A few hours pass with the three of you resting against each other."
    "Passam-se algumas horas com vocês três descansando encostados uns nos outros."

# game/chapters/chapter4/script/ch4sc5.rpy:243
translate brazil ch4sc5_c6da2e83:

#   "Dawn arrives sooner than you expected."
    "O amanhecer chega mais cedo do que você esperava."

# game/chapters/chapter4/script/ch4sc5.rpy:245
translate brazil ch4sc5_12e2ea30:

#   mct "Alice... she really came through last night."
    mct "Alice... ela realmente se superou ontem à noite."

# game/chapters/chapter4/script/ch4sc5.rpy:247
translate brazil ch4sc5_1e746da0:

#   mct "She didn’t waver from Eliza’s side when I asked her to watch over her."
    mct "Ela não hesitou em ficar ao lado de Eliza quando lhe pedi que cuidasse dela."

# game/chapters/chapter4/script/ch4sc5.rpy:248
translate brazil ch4sc5_6517e279:

#   mct "I shouldn’t be surprised, really. Alice has always had a tendency to care for others and put their needs first."
    mct "Na verdade, não deveria me surpreender. Alice sempre teve uma tendência a se preocupar com os outros e colocar as necessidades deles em primeiro lugar."

# game/chapters/chapter4/script/ch4sc5.rpy:249
translate brazil ch4sc5_c342d0c7:

#   mct "Not a bad quality to have, but she needs to learn to speak up about what she wants."
    mct "Não é uma qualidade ruim, mas ela precisa aprender a expressar o que deseja."

# game/chapters/chapter4/script/ch4sc5.rpy:250
translate brazil ch4sc5_a33922bd:

#   mct "Otherwise, she’s going to be walked over by everyone..."
    mct "Caso contrário, todos vão passar por cima dela..."

# game/chapters/chapter4/script/ch4sc5.rpy:251
translate brazil ch4sc5_a2bc1b40:

#   mct "She'd make for an amazing wife one day, to whomever earns her love."
    mct "Ela seria uma esposa incrível um dia, para quem quer que conquiste o seu amor."

# game/chapters/chapter4/script/ch4sc5.rpy:253
translate brazil ch4sc5_ab679049:

#   mct "Eliza..."
    mct "Eliza..."

# game/chapters/chapter4/script/ch4sc5.rpy:255
translate brazil ch4sc5_5714db5e:

#   mct "She’s the toughest girl I’ve ever met."
    mct "Ela é a garota mais durona que eu já conheci."

# game/chapters/chapter4/script/ch4sc5.rpy:256
translate brazil ch4sc5_5a2278f9:

#   mct "Stubborn as a mule. She gets that from her father."
    mct "Teimosa como uma mula. Ela puxou isso do pai."

# game/chapters/chapter4/script/ch4sc5.rpy:257
translate brazil ch4sc5_1e816ceb:

#   mct "It annoyed me beyond belief at first. But now, it's grown on me."
    mct "No começo, isso me irritou demais. Mas agora, acabei me acostumando."

# game/chapters/chapter4/script/ch4sc5.rpy:258
translate brazil ch4sc5_654a2142:

#   mct "She's come a long way from when we first met. Despite her current injury..."
    mct "Ela percorreu um longo caminho desde que nos conhecemos. Apesar da lesão atual..."

# game/chapters/chapter4/script/ch4sc5.rpy:259
translate brazil ch4sc5_671a1c4c:

#   mct "She’s no longer a victim... she faces any danger head on."
    mct "Ela não é mais uma vítima... ela enfrenta qualquer perigo de frente."

# game/chapters/chapter4/script/ch4sc5.rpy:260
translate brazil ch4sc5_de48d536:

#   mct "Her first encounter with goblins, she killed two of them... that was quite impressive."
    mct "Em seu primeiro encontro com goblins, ela matou dois deles... isso foi bastante impressionante."

# game/chapters/chapter4/script/ch4sc5.rpy:261
translate brazil ch4sc5_8a92159f:

#   mct "Your father would be proud of you. I know he would."
    mct "Seu pai estaria orgulhoso de você. Eu sei que estaria."

# game/chapters/chapter4/script/ch4sc5.rpy:262
translate brazil ch4sc5_16404237:

#   mct "I will find this artifact. And it will work... it has to."
    mct "Vou encontrar esse artefato. E vai funcionar... tem que funcionar."

# game/chapters/chapter4/script/ch4sc5.rpy:263
translate brazil ch4sc5_6fbe63a9:

#   mct "There’s still a whole world out there for us to see... together."
    mct "Ainda há um mundo inteiro lá fora para vermos... juntos."

# game/chapters/chapter4/script/ch4sc5.rpy:264
translate brazil ch4sc5_0680a698:

#   mct "I can no longer imagine my life without her, she's my little kitten."
    mct "Já não consigo imaginar a minha vida sem ela, ela é a minha gatinha."

# game/chapters/chapter4/script/ch4sc5.rpy:266
translate brazil ch4sc5_91984651:

#   "You take a deep breath. Filling your lungs with the scented air of Eliza and Alice sleeping against you."
    "Você respira fundo, enchendo os pulmões com o ar perfumado de Eliza e Alice dormindo encostadas em você."

# game/chapters/chapter4/script/ch4sc5.rpy:267
translate brazil ch4sc5_46868701:

#   mct "*Sigh* As much I'd love to lay here with these two til the end of time..."
    mct "*Suspiro* Por mais que eu adorasse ficar aqui deitada com esses dois até o fim dos tempos..."

# game/chapters/chapter4/script/ch4sc5.rpy:268
translate brazil ch4sc5_2aff8efa:

#   mct "It’s time to do something about this mess."
    mct "Chegou a hora de fazer algo a respeito dessa bagunça."

# game/chapters/chapter4/script/ch4sc5.rpy:272
translate brazil ch4sc5_b8046f2c:

#   "You manage to escape the cuddle-session without waking the girls."
    "Você consegue escapar da sessão de carinhos sem acordar as garotas."

# game/chapters/chapter4/script/ch4sc5.rpy:273
translate brazil ch4sc5_27f36fd7:

#   mct "I’ll head over to the guild and go over the plan with Dalen."
    mct "Vou até a guilda e vou repassar o plano com o Dalen."

# game/chapters/chapter4/script/ch4sc5.rpy:274
translate brazil ch4sc5_a4333261:

#   mct "He said that the journey will likely take several months..."
    mct "Ele disse que a viagem provavelmente levará vários meses..."

# game/chapters/chapter4/script/ch4sc5.rpy:275
translate brazil ch4sc5_529114fb:

#   mct "The girls won’t be happy about that..."
    mct "As meninas não vão gostar disso..."

# game/chapters/chapter4/script/ch4sc5.rpy:276
translate brazil ch4sc5_f696c3d8:

#   mct "I just reunited with Alice, again. And Eliza..."
    mct "Acabei de reencontrar Alice. E Eliza..."

# game/chapters/chapter4/script/ch4sc5.rpy:277
translate brazil ch4sc5_cfc0c4b5:

#   mct "Well, she's never happy when we part..."
    mct "Bem, ela nunca fica feliz quando nos separamos..."

# game/chapters/chapter4/script/ch4sc5.rpy:278
translate brazil ch4sc5_f1e237a2:

#   mct "Okay, that's an understatement. She'd probably kick my ass if her legs were functional."
    mct "Ok, isso é um eufemismo. Ela provavelmente me daria uma surra se as pernas dela funcionassem."

# game/chapters/chapter4/script/ch4sc5.rpy:279
translate brazil ch4sc5_20f59d49:

#   mct "She'll just have to wait for that until I return with the chalice."
    mct "Ela terá que esperar até que eu retorne com o cálice."

# game/chapters/chapter4/script/ch4sc5.rpy:159
translate brazil ch4sc5_dc7d1f31_1:

#   al "..."
    al "..."

