# game/chapters/chapter3/script/ch3sc23.rpy:8
translate brazil ch3sc23_890218ca:

#   uk "Hurry up, Pearl! We’ve already been in the city for hours..."
    uk "Anda logo, Pearl! Já estamos na cidade há horas..."

# game/chapters/chapter3/script/ch3sc23.rpy:9
translate brazil ch3sc23_106f0410:

#   uk "You know I don't much care for the city... the ground is much too solid for my taste."
    uk "Sabe, eu não gosto muito da cidade... o chão é muito duro para o meu gosto."

# game/chapters/chapter3/script/ch3sc23.rpy:11
translate brazil ch3sc23_5a0bc577:

#   pl "But the fish is so cute!"
    pl "Mas o peixe é tão fofo!"

# game/chapters/chapter3/script/ch3sc23.rpy:12
translate brazil ch3sc23_a8d2d758:

#   pl "Take a look, Kira!"
    pl "Dá uma olhada, Kira!"

# game/chapters/chapter3/script/ch3sc23.rpy:14
translate brazil ch3sc23_9cd3c599:

#   ki "Pearl... We live on a ship."
    ki "Pérola... Nós vivemos em um navio."

# game/chapters/chapter3/script/ch3sc23.rpy:15
translate brazil ch3sc23_24dd146b:

#   ki "We literally see all kinds of fish... Every. Single. Day."
    ki "Nós vemos literalmente todos os tipos de peixes... Todos. Os. Dias."

# game/chapters/chapter3/script/ch3sc23.rpy:18
translate brazil ch3sc23_6a2b2bc5:

#   pl "That's not the same! Just look at how cute they are!"
    pl "Não é a mesma coisa! Olha só que fofura!"

# game/chapters/chapter3/script/ch3sc23.rpy:20
translate brazil ch3sc23_2a468d6f:

#   ki "Pearl, come on!"
    ki "Pérola, vamos lá!"

# game/chapters/chapter3/script/ch3sc23.rpy:23
translate brazil ch3sc23_38f6671c:

#   pl "Kira, are you looking? The fishy looks so happy."
    pl "Kira, você está olhando? O peixinho parece tão feliz."

# game/chapters/chapter3/script/ch3sc23.rpy:25
translate brazil ch3sc23_de520994:

#   pl "Okay, seriously... what's caught your attention?"
    pl "Ok, falando sério... o que chamou sua atenção?"

# game/chapters/chapter3/script/ch3sc23.rpy:27
translate brazil ch3sc23_bc83fc74:

#   ki "Huh? Nothing."
    ki "Hã? Nada."

# game/chapters/chapter3/script/ch3sc23.rpy:28
translate brazil ch3sc23_bab27e23:

#   ki "I was paying attention... now let's go."
    ki "Eu estava prestando atenção... agora vamos lá."

# game/chapters/chapter3/script/ch3sc23.rpy:30
translate brazil ch3sc23_d8810ac7:

#   pl "Is that so? You were paying attention to the fishys?"
    pl "É mesmo? Você estava prestando atenção nos peixinhos?"

# game/chapters/chapter3/script/ch3sc23.rpy:31
translate brazil ch3sc23_e17fd359:

#   pl "I could’ve sworn you were undressing that guy with your eyes just now."
    pl "Eu juraria que você estava despindo aquele cara com os olhos agora mesmo."

# game/chapters/chapter3/script/ch3sc23.rpy:33
translate brazil ch3sc23_3a3aaae6:

#   ki "Urhh! Don’t be ridiculous Pearl!"
    ki "Urgh! Não seja ridícula, Pearl!"

# game/chapters/chapter3/script/ch3sc23.rpy:34
translate brazil ch3sc23_c38e3802:

#   ki "You know I don’t have time for men... Besides, they're all pigs."
    ki "Você sabe que eu não tenho tempo para homens... Além disso, são todos uns porcos."

# game/chapters/chapter3/script/ch3sc23.rpy:36
translate brazil ch3sc23_58d1352e:

#   ki "Now, let’s get out of here..."
    ki "Agora, vamos sair daqui..."

# game/chapters/chapter3/script/ch3sc23.rpy:37
translate brazil ch3sc23_c0d11570:

#   ki "You wanted to buy some supplies before we set sail."
    ki "Você queria comprar alguns suprimentos antes de zarparmos."

# game/chapters/chapter3/script/ch3sc23.rpy:42
translate brazil ch3sc23_39c0366c:

#   al_t "Hrrh... Finding [mc] in a city this large is borderline impossible!"
    al_t "Hrrh... Encontrando [mc] Numa cidade deste tamanho, é praticamente impossível!"

# game/chapters/chapter3/script/ch3sc23.rpy:44
translate brazil ch3sc23_915550d1:

#   al_t "Think Alice, think!"
    al_t "Pensa, Alice, pensa!"

# game/chapters/chapter3/script/ch3sc23.rpy:46
translate brazil ch3sc23_14ef7c56:

#   al_t "Hmhm. My best bet is probably to look for him in the nearby taverns."
    al_t "Hum. Acho que a melhor opção é procurá-lo nas tavernas próximas."

# game/chapters/chapter3/script/ch3sc23.rpy:47
translate brazil ch3sc23_84b3fe94:

#   al_t "I have to book rooms for Flynn and Sabrina anyway."
    al_t "De qualquer forma, preciso reservar quartos para Flynn e Sabrina."

# game/chapters/chapter3/script/ch3sc23.rpy:53
translate brazil ch3sc23_b3f66984:

#   el "Feel it?"
    el "Você consegue sentir isso?"

# game/chapters/chapter3/script/ch3sc23.rpy:55
translate brazil ch3sc23_2ee86e60:

#   mc "Feel what?"
    mc "Sentir o quê?"

# game/chapters/chapter3/script/ch3sc23.rpy:57
translate brazil ch3sc23_a55e54d1:

#   el "Our impending promotion!"
    el "Nossa promoção está chegando!"

# game/chapters/chapter3/script/ch3sc23.rpy:58
translate brazil ch3sc23_3780b020:

#   el "We totally kicked that quest's butt!"
    el "Nós detonamos nessa missão!"

# game/chapters/chapter3/script/ch3sc23.rpy:60
translate brazil ch3sc23_2511bb88:

#   mc "Mmh. I think we did pretty well, yeah."
    mc "Hum. Acho que nos saímos muito bem, sim."

# game/chapters/chapter3/script/ch3sc23.rpy:61
translate brazil ch3sc23_0a9cc086:

#   mc "I hope the artifacts we brought back will be worth the trouble."
    mc "Espero que os artefatos que trouxemos de volta valham a pena todo o esforço."

# game/chapters/chapter3/script/ch3sc23.rpy:63
translate brazil ch3sc23_c2fa3bda:

#   el "They will!"
    el "Eles vão sim!"

# game/chapters/chapter3/script/ch3sc23.rpy:64
translate brazil ch3sc23_630726a0:

#   el "We completed the quest {b}AND{/b} we brought back not one, but {b}TWO{/b} artifacts!"
    el "Concluímos a missão. {b} E{/b} não trouxemos de volta apenas um, mas {b} DOIS{/b} artefatos!"

# game/chapters/chapter3/script/ch3sc23.rpy:66
translate brazil ch3sc23_77ad77a9:

#   mc "Don’t get my hopes up..."
    mc "Não me iluda..."

# game/chapters/chapter3/script/ch3sc23.rpy:68
translate brazil ch3sc23_98526776:

#   el "With all the coin we are about to receive, we definitely have to find you a proper outfit!"
    el "Com todo o dinheiro que vamos receber, com certeza precisamos encontrar uma roupa adequada para você!"

# game/chapters/chapter3/script/ch3sc23.rpy:70
translate brazil ch3sc23_623987b6:

#   mc "What’s wrong with what I’m wearing?"
    mc "O que há de errado com a roupa que estou vestindo?"

# game/chapters/chapter3/script/ch3sc23.rpy:72
translate brazil ch3sc23_a70bc1f1:

#   el "Besides the fact that you've been wearing it for years and it reeks?"
    el "Além do fato de você usar isso há anos e estar fedendo?"

# game/chapters/chapter3/script/ch3sc23.rpy:73
translate brazil ch3sc23_fce72a6e:

#   el "We’re buying you a new outfit, and that’s final."
    el "Vamos comprar uma roupa nova para você, e ponto final."

# game/chapters/chapter3/script/ch3sc23.rpy:75
translate brazil ch3sc23_36b5e13f:

#   mc "*Sigh* Five hells, you can be so stubborn..."
    mc "*Suspiro* Pelos cinco infernos, você pode ser tão teimoso..."

# game/chapters/chapter3/script/ch3sc23.rpy:77
translate brazil ch3sc23_9e0faf53:

#   el "*Giggles* And don’t you forget it!"
    el "*Risos* E não se esqueça disso!"

# game/chapters/chapter3/script/ch3sc23.rpy:79
translate brazil ch3sc23_a58191f2:

#   sy "Hi, guys! You’re back early? How did it go?"
    sy "Olá, pessoal! Vocês voltaram mais cedo? Como foi?"

# game/chapters/chapter3/script/ch3sc23.rpy:80
translate brazil ch3sc23_c1bdd6e1:

#   sy "Did you run into trouble? You don't look hurt so that's a relief!"
    sy "Você se meteu em alguma encrenca? Você não parece machucado, então isso é um alívio!"

# game/chapters/chapter3/script/ch3sc23.rpy:82
translate brazil ch3sc23_8a403754:

#   el "Nothing we couldn’t handle, the quest is completed!"
    el "Nada que não pudéssemos resolver, missão cumprida!"

# game/chapters/chapter3/script/ch3sc23.rpy:83
translate brazil ch3sc23_0b7085b9:

#   el "There's not a single goblin that still draws breath in those ruins."
    el "Não há um único goblin que ainda respire naquelas ruínas."

# game/chapters/chapter3/script/ch3sc23.rpy:85
translate brazil ch3sc23_9e91b714:

#   sy "W-What?!"
    sy "O quê?!"

# game/chapters/chapter3/script/ch3sc23.rpy:86
translate brazil ch3sc23_56324c92:

#   sy "So fast? I thought it'd take you a few days at least!"
    sy "Tão rápido? Achei que levaria pelo menos alguns dias!"

# game/chapters/chapter3/script/ch3sc23.rpy:88
translate brazil ch3sc23_ce44b4e4:

#   mc "It wasn’t my first encounter with goblins."
    mc "Não foi meu primeiro encontro com goblins."

# game/chapters/chapter3/script/ch3sc23.rpy:89
translate brazil ch3sc23_27d9177b:

#   mc "And Eliza is a good partner."
    mc "E Eliza é uma boa parceira."

# game/chapters/chapter3/script/ch3sc23.rpy:91
translate brazil ch3sc23_833fc5e8:

#   el "*Excited* We did work well together!"
    el "*Animada* Nós trabalhamos bem juntos!"

# game/chapters/chapter3/script/ch3sc23.rpy:92
translate brazil ch3sc23_158c8825:

#   el "You should have seen us, Sylph!"
    el "Você devia ter nos visto, Sylph!"

# game/chapters/chapter3/script/ch3sc23.rpy:94
translate brazil ch3sc23_f2f8ad23:

#   sy "I sure would have loved to see that... I hope you took care of all of them."
    sy "Eu adoraria ter visto isso... Espero que você tenha cuidado de todos eles."

# game/chapters/chapter3/script/ch3sc23.rpy:96
translate brazil ch3sc23_82f0563b:

#   mc "Every. Last. One."
    mc "Cada. Um. Deles."

# game/chapters/chapter3/script/ch3sc23.rpy:98
translate brazil ch3sc23_fb9e06fe:

#   sy "Good! Those foul creatures don’t deserve to live anywhere near settlements!"
    sy "Ótimo! Essas criaturas repugnantes não merecem viver perto de assentamentos!"

# game/chapters/chapter3/script/ch3sc23.rpy:100
translate brazil ch3sc23_8a3a7ecd:

#   sy "I’m relieved you guys were able to handle it!"
    sy "Fico aliviado que vocês tenham conseguido lidar com a situação!"

# game/chapters/chapter3/script/ch3sc23.rpy:101
translate brazil ch3sc23_209d720a:

#   sy "Now the local farmers can start working their fields again, and merchants can travel those roads safely again."
    sy "Agora os agricultores locais podem voltar a trabalhar nos seus campos e os comerciantes podem voltar a circular nessas estradas em segurança."

# game/chapters/chapter3/script/ch3sc23.rpy:103
translate brazil ch3sc23_8d81a6e9:

#   el "Does this mean that we are officially C-Rank Adventurers now, Sylph?"
    el "Isso significa que agora somos oficialmente aventureiros de nível C, Sylph?"

# game/chapters/chapter3/script/ch3sc23.rpy:105
translate brazil ch3sc23_df5ad4ef:

#   sy "You bet! You’ve definitely shown you have what it takes to be taken seriously within our guild."
    sy "Pode apostar! Você definitivamente mostrou que tem o que é preciso para ser levado a sério em nossa guilda."

# game/chapters/chapter3/script/ch3sc23.rpy:106
translate brazil ch3sc23_27489d0f:

#   sy "I'll update your status right away. But before I forget... here! Your reward for today's quest!"
    sy "Vou atualizar seu status agora mesmo. Mas antes que eu me esqueça... aqui está! Sua recompensa pela missão de hoje!"

# game/chapters/chapter3/script/ch3sc23.rpy:108
translate brazil ch3sc23_ec8f49b0:

#   sy "You’ve earned a total of forty silvers from this quest!"
    sy "Você ganhou um total de quarenta moedas de prata nesta missão!"

# game/chapters/chapter3/script/ch3sc23.rpy:111
translate brazil ch3sc23_057d097c:

#   el "{b}Forty silvers?! FORTY!!{/b} We’re rich!"
    el "{b}Quarenta pratas?! QUARENTA!!{/b} Somos ricos!"

# game/chapters/chapter3/script/ch3sc23.rpy:112
translate brazil ch3sc23_256b0580:

#   el "[mc], you seeing this?!"
    el "[mc] Você está vendo isso?!"

# game/chapters/chapter3/script/ch3sc23.rpy:114
translate brazil ch3sc23_d4feeb28:

#   mc "We also found a few items in the ruins..."
    mc "Também encontramos alguns objetos nas ruínas..."

# game/chapters/chapter3/script/ch3sc23.rpy:115
translate brazil ch3sc23_c80c56e4:

#   mc "Are these of any interest to the Guild?"
    mc "Isso interessa à Guilda?"

# game/chapters/chapter3/script/ch3sc23.rpy:118
translate brazil ch3sc23_03230209:

#   "You and Eliza show the objects to Sylph for inspection."
    "Você e Eliza mostram os objetos para Sylph inspecionar."

# game/chapters/chapter3/script/ch3sc23.rpy:120
translate brazil ch3sc23_da97eeb7:

#   "Sylph quietly observes the horn and the sigil for a few moments."
    "Sylph observa silenciosamente o chifre e o sigilo por alguns instantes."

# game/chapters/chapter3/script/ch3sc23.rpy:121
translate brazil ch3sc23_3dbf961c:

#   sy "Hmmm... hmm... hm..."
    sy "Hum... hum... hum..."

# game/chapters/chapter3/script/ch3sc23.rpy:124
translate brazil ch3sc23_deecdd77:

#   sy "Yes! These are fantastic!"
    sy "Sim! São fantásticos!"

# game/chapters/chapter3/script/ch3sc23.rpy:126
translate brazil ch3sc23_41d6663f:

#   sy "I'll identify them right away, so we can properly display them!"
    sy "Vou identificá-los imediatamente para que possamos exibi-los adequadamente!"

# game/chapters/chapter3/script/ch3sc23.rpy:127
translate brazil ch3sc23_1161ed66:

#   sy "Then I'll add them to the Guild's collection!"
    sy "Então eu os adicionarei à coleção da Guilda!"

# game/chapters/chapter3/script/ch3sc23.rpy:132
translate brazil ch3sc23_84cfcea8:

#   sy "My, oh my! You’ve found an actual Jarl’s horn from the age of vikings!"
    sy "Nossa! Você encontrou uma verdadeira corneta de Jarl da época dos vikings!"

# game/chapters/chapter3/script/ch3sc23.rpy:133
translate brazil ch3sc23_fff722c3:

#   sy "And from Clan Windcaller, no less."
    sy "E nada menos que do Clã Windcaller."

# game/chapters/chapter3/script/ch3sc23.rpy:134
translate brazil ch3sc23_9894b448:

#   sy "They were among the most revered clans back in their time!"
    sy "Eles estavam entre os clãs mais reverenciados em sua época!"

# game/chapters/chapter3/script/ch3sc23.rpy:136
translate brazil ch3sc23_47e7e96c:

#   sy "This is quite rare!"
    sy "Isso é bastante raro!"

# game/chapters/chapter3/script/ch3sc23.rpy:137
translate brazil ch3sc23_7135b3dd:

#   sy "You see... vikings were an important part of civilization during the First Era."
    sy "Veja bem... os vikings foram uma parte importante da civilização durante a Primeira Era."

# game/chapters/chapter3/script/ch3sc23.rpy:138
translate brazil ch3sc23_44b433dc:

#   sy "And Ragnar was a great Jarl who saw to it that their clan rose to worldwide renown!"
    sy "E Ragnar foi um grande Jarl que garantiu que seu clã alcançasse renome mundial!"

# game/chapters/chapter3/script/ch3sc23.rpy:140
translate brazil ch3sc23_95a5fb7b:

#   sy "But they vanished during the gruesome events caused by Balthazar."
    sy "Mas eles desapareceram durante os eventos horríveis causados ​​por Baltazar."

# game/chapters/chapter3/script/ch3sc23.rpy:141
translate brazil ch3sc23_1cca1244:

#   sy "It is said they retreated to the Kingdom of Izenthul and haven't left since."
    sy "Diz-se que eles se refugiaram no Reino de Izenthul e não saíram de lá desde então."

# game/chapters/chapter3/script/ch3sc23.rpy:143
translate brazil ch3sc23_4ae3c7d8:

#   sy "Let’s see what the sigil reveals when I identify it."
    sy "Vamos ver o que o sigilo revela quando eu o identificar."

# game/chapters/chapter3/script/ch3sc23.rpy:148
translate brazil ch3sc23_a5fe5223:

#   sy "Interesting... It seems to be one of the coveted sigils of the Knight’s watch brotherhood."
    sy "Interessante... Parece ser um dos símbolos mais cobiçados da irmandade da Guarda dos Cavaleiros."

# game/chapters/chapter3/script/ch3sc23.rpy:150
translate brazil ch3sc23_e82c168a:

#   sy "They’re the highest ranking members of the Kingsguard."
    sy "Eles são os membros de mais alta patente da Guarda Real."

# game/chapters/chapter3/script/ch3sc23.rpy:151
translate brazil ch3sc23_2b17e588:

#   sy "Odd that you found it in some goblin ruins, of all places..."
    sy "Que estranho você ter encontrado isso em ruínas de goblins, de todos os lugares..."

# game/chapters/chapter3/script/ch3sc23.rpy:152
translate brazil ch3sc23_2ea78b71:

#   sy "I guess those ruins could've been an outpost for the Knight's watch members at once point."
    sy "Imagino que aquelas ruínas possam ter servido como um posto avançado para os membros da Guarda dos Cavaleiros em algum momento."

# game/chapters/chapter3/script/ch3sc23.rpy:154
translate brazil ch3sc23_310d2a39:

#   sy "Either way, let’s put them up for display!"
    sy "De qualquer forma, vamos exibi-los!"

# game/chapters/chapter3/script/ch3sc23.rpy:155
translate brazil ch3sc23_db49afc0:

#   sy "That'll show everyone the Adventurer’s Guild is back on track!"
    sy "Isso mostrará a todos que a Guilda dos Aventureiros está de volta aos trilhos!"

# game/chapters/chapter3/script/ch3sc23.rpy:158
translate brazil ch3sc23_8a953e63:

#   sy "We'll put em on these shelves here."
    sy "Vamos colocá-los nessas prateleiras aqui."

# game/chapters/chapter3/script/ch3sc23.rpy:161
translate brazil ch3sc23_ad2fabe2:

#   sy "First the Horn of Clan Windcaller!"
    sy "Primeiro, a Trompa do Clã Chamador de Ventos!"

# game/chapters/chapter3/script/ch3sc23.rpy:162
translate brazil ch3sc23_dd9052e4:

#   sy "Neat!"
    sy "Organizado!"

# game/chapters/chapter3/script/ch3sc23.rpy:165
translate brazil ch3sc23_5e9507e4:

#   sy "And right above it we'll display the sigil of the Knight's watch brother! Mhm-hm!"
    sy "E logo acima, exibiremos o brasão do irmão da guarda do Cavaleiro! Hum-hum!"

# game/chapters/chapter3/script/ch3sc23.rpy:166
translate brazil ch3sc23_a9ac2d73:

#   el "They look great on display! It's exciting seeing that we've made an impact on the guild!"
    el "Ficam ótimos em exposição! É emocionante ver que causamos um impacto na guilda!"

# game/chapters/chapter3/script/ch3sc23.rpy:167
translate brazil ch3sc23_7fe6de45:

#   sy "You sure have, it's something you can be proud of! I can't wait for Dalen to see these!"
    sy "Com certeza! É algo de que você pode se orgulhar! Mal posso esperar para que Dalen veja isso!"

# game/chapters/chapter3/script/ch3sc23.rpy:169
translate brazil ch3sc23_7245f041:

#   sy "Here you go, five silvers for the sigil, and ten for the horn!"
    sy "Aqui está, cinco moedas de prata pelo sigilo e dez pelo chifre!"

# game/chapters/chapter3/script/ch3sc23.rpy:171
translate brazil ch3sc23_5c03020d:

#   mc "That's more than I expected, to be honest."
    mc "Sinceramente, isso é mais do que eu esperava."

# game/chapters/chapter3/script/ch3sc23.rpy:173
translate brazil ch3sc23_d5cb891d:

#   sy "Increasing our display collection will show people the Guild is back on track and thriving!"
    sy "Aumentar nossa coleção em exposição mostrará às pessoas que a Guilda está de volta aos trilhos e prosperando!"

# game/chapters/chapter3/script/ch3sc23.rpy:174
translate brazil ch3sc23_86c7b3ac:

#   sy "That should help entice more recruits! Which means we can clear more bounties and quests!"
    sy "Isso deve ajudar a atrair mais recrutas! O que significa que podemos concluir mais missões e recompensas!"

# game/chapters/chapter3/script/ch3sc23.rpy:176
translate brazil ch3sc23_37e3107f:

#   sy "We’ll be swimming in riches soon! I can feel it!"
    sy "Em breve estaremos nadando em riquezas! Eu sinto isso!"

# game/chapters/chapter3/script/ch3sc23.rpy:177
translate brazil ch3sc23_68695030:

#   sy "*Giggling* What should I buy first? New dress? New panties? So many options!"
    sy "*Risos* O que eu compro primeiro? Um vestido novo? Calcinhas novas? Tantas opções!"

# game/chapters/chapter3/script/ch3sc23.rpy:179
translate brazil ch3sc23_6b7a115f:

#   mc "Don’t get too carried away, Sylph."
    mc "Não se empolgue demais, Sylph."

# game/chapters/chapter3/script/ch3sc23.rpy:180
translate brazil ch3sc23_3d4242f0:

#   mc "It'll still be a while before we'll be able to dive into a pool filled with riches."
    mc "Ainda vai demorar um pouco até que possamos mergulhar em uma piscina repleta de riquezas."

# game/chapters/chapter3/script/ch3sc23.rpy:182
translate brazil ch3sc23_4fbbfbd6:

#   sy "I know, I know... But thanks to the two of you, we’re on the right track for the first time in a long time!"
    sy "Eu sei, eu sei... Mas graças a vocês dois, estamos no caminho certo pela primeira vez em muito tempo!"

# game/chapters/chapter3/script/ch3sc23.rpy:183
translate brazil ch3sc23_0ca4c451:

#   sy "This is a big deal! And we should all be proud of it, especially the two of you!"
    sy "Isso é muito importante! E todos nós devemos nos orgulhar disso, especialmente vocês dois!"

# game/chapters/chapter3/script/ch3sc23.rpy:185
translate brazil ch3sc23_57a7b8b7:

#   mc "We appreciate the vote of confidence, Sylph."
    mc "Agradecemos o voto de confiança, Sylph."

# game/chapters/chapter3/script/ch3sc23.rpy:186
translate brazil ch3sc23_52481274:

#   mc "We'd better head out now, though."
    mc "É melhor irmos embora agora."

# game/chapters/chapter3/script/ch3sc23.rpy:188
translate brazil ch3sc23_0688441f:

#   el "Yeah, I’m in desperate need of a hot bath!"
    el "Sim, preciso desesperadamente de um banho quente!"

# game/chapters/chapter3/script/ch3sc23.rpy:189
translate brazil ch3sc23_3397aa5b:

#   el "Battling those nasty goblins has left me feeling icky!"
    el "Lutar contra aqueles goblins desagradáveis ​​me deixou com uma sensação horrível!"

# game/chapters/chapter3/script/ch3sc23.rpy:191
translate brazil ch3sc23_e282954a:

#   el "Bye, Sylph!"
    el "Adeus, Sylph!"

# game/chapters/chapter3/script/ch3sc23.rpy:192
translate brazil ch3sc23_b8987884:

#   el "We’ll stop by tomorrow and check to see if any new quests have been posted."
    el "Passaremos por lá amanhã para verificar se alguma nova missão foi publicada."

# game/chapters/chapter3/script/ch3sc23.rpy:194
translate brazil ch3sc23_7eddfbbf:

#   sy "Oh! Oh! Before I forget, Dalen asked to see you."
    sy "Oh! Oh! Antes que eu me esqueça, Dalen pediu para te ver."

# game/chapters/chapter3/script/ch3sc23.rpy:196
translate brazil ch3sc23_df31c33a:

#   mct "*Sigh* I suppose we'd better see what he wants."
    mct "*Suspiro* Acho que é melhor vermos o que ele quer."

# game/chapters/chapter3/script/ch3sc23.rpy:198
translate brazil ch3sc23_61585027:

#   mc "Dalen? What does he want?"
    mc "Dalen? O que ele quer?"

# game/chapters/chapter3/script/ch3sc23.rpy:200
translate brazil ch3sc23_77ff4e1e:

#   sy "It’s not for me to say... but he rarely asks to see new recruits."
    sy "Não cabe a mim dizer... mas ele raramente pede para ver os novos recrutas."

# game/chapters/chapter3/script/ch3sc23.rpy:201
translate brazil ch3sc23_eb6ea671:

#   sy "So I’m guessing it’s important."
    sy "Então, presumo que seja importante."

# game/chapters/chapter3/script/ch3sc23.rpy:203
translate brazil ch3sc23_d11ec834:

#   mc "Alright. We’ll check in with him now, then."
    mc "Certo. Vamos verificar com ele agora, então."

# game/chapters/chapter3/script/ch3sc23.rpy:205
translate brazil ch3sc23_5cc322f7:

#   mc "C’mon, Eliza. The faster we get this over with, the faster we can have that bath."
    mc "Vamos lá, Eliza. Quanto mais rápido terminarmos isso, mais rápido poderemos tomar esse banho."

# game/chapters/chapter3/script/ch3sc23.rpy:207
translate brazil ch3sc23_4b6235ad:

#   el "Don’t forget my massage!"
    el "Não se esqueça da minha massagem!"

# game/chapters/chapter3/script/ch3sc23.rpy:209
translate brazil ch3sc23_9471eb9a:

#   mc "*Exhales* And your massage."
    mc "*Exala* E sua massagem."

# game/chapters/chapter3/script/ch3sc23.rpy:211
translate brazil ch3sc23_d6fbec61:

#   el "Yay! Isn’t he just wonderful, Sylph?"
    el "Eba! Ele não é simplesmente maravilhoso, Sylph?"

# game/chapters/chapter3/script/ch3sc23.rpy:213
translate brazil ch3sc23_3adf074e:

#   sy "Hey, [mc]. My feet are pretty sore from working the desk here all day..."
    sy "Ei, [mc] Meus pés estão bem doloridos de tanto trabalhar aqui na mesa o dia todo..."

# game/chapters/chapter3/script/ch3sc23.rpy:215
translate brazil ch3sc23_791e463b:

#   mc "You’re literally levitating..."
    mc "Você está literalmente levitando..."

# game/chapters/chapter3/script/ch3sc23.rpy:217
translate brazil ch3sc23_66bfb490:

#   sy "Boooo! I want a massage too, sometime!"
    sy "Buuu! Eu também quero uma massagem qualquer dia desses!"

# game/chapters/chapter3/script/ch3sc23.rpy:218
translate brazil ch3sc23_77bbdbd6:

#   sy "That’s the least you can do for your favorite fae, no?"
    sy "Isso é o mínimo que você pode fazer pela sua fada favorita, não é?"

# game/chapters/chapter3/script/ch3sc23.rpy:220
translate brazil ch3sc23_1930f835:

#   mc "*Sigh* Sure, some other time."
    mc "*Suspiro* Claro, em outra ocasião."

# game/chapters/chapter3/script/ch3sc23.rpy:222
translate brazil ch3sc23_ebe76f9e:

#   sy "Yay! I’ll hold you to that."
    sy "Eba! Vou cobrar isso de você."

# game/chapters/chapter3/script/ch3sc23.rpy:228
translate brazil ch3sc23_a82f6c5f:

#   dat "*Sigh*"
    dat "*Suspirar*"

# game/chapters/chapter3/script/ch3sc23.rpy:230
translate brazil ch3sc23_cd6399c1:

#   da "Good, you’re back. Take a seat."
    da "Que bom que você voltou. Sente-se."

# game/chapters/chapter3/script/ch3sc23.rpy:232
translate brazil ch3sc23_990c4682:

#   mc "Sylph mentioned you wanted to see us?"
    mc "Sylph mencionou que você queria nos ver?"

# game/chapters/chapter3/script/ch3sc23.rpy:234
translate brazil ch3sc23_ece9e3f7:

#   da "There’s something I want to ask the two of you."
    da "Há algo que eu gostaria de perguntar a vocês dois."

# game/chapters/chapter3/script/ch3sc23.rpy:236
translate brazil ch3sc23_26654521:

#   da "And please don’t take me for a fool. There’s more to you than meets the eye."
    da "E, por favor, não me tome por tola. Você é muito mais do que aparenta."

# game/chapters/chapter3/script/ch3sc23.rpy:237
translate brazil ch3sc23_0dfaf084:

#   da "I would like to find out what exactly that is. Now."
    da "Gostaria de descobrir exatamente o que é isso. Agora."

# game/chapters/chapter3/script/ch3sc23.rpy:239
translate brazil ch3sc23_3a271224:

#   mc "You wouldn’t believe me if I were to tell you."
    mc "Você não acreditaria se eu lhe contasse."

# game/chapters/chapter3/script/ch3sc23.rpy:241
translate brazil ch3sc23_01b14e74:

#   da "You’d be surprised what I’d believe."
    da "Você ficaria surpreso com o que eu acreditaria."

# game/chapters/chapter3/script/ch3sc23.rpy:242
translate brazil ch3sc23_b5959d81:

#   da "I've traveled all five kingdoms of Midomir, I've seen just about anything."
    da "Já viajei por todos os cinco reinos de Midomir, já vi praticamente tudo."

# game/chapters/chapter3/script/ch3sc23.rpy:244
translate brazil ch3sc23_4111c20a:

#   el "He's right... we can trust him. I-I can feel it."
    el "Ele tem razão... podemos confiar nele. Eu sinto isso."

# game/chapters/chapter3/script/ch3sc23.rpy:246
translate brazil ch3sc23_b85bbc74:

#   mc "*Sigh* I’ll tell you."
    mc "*Suspiro* Eu vou te contar."

# game/chapters/chapter3/script/ch3sc23.rpy:247
translate brazil ch3sc23_fe48ee5d:

#   mc "If Eliza believes you're trustworthy, so be it."
    mc "Se Eliza acredita que você é confiável, que assim seja."

# game/chapters/chapter3/script/ch3sc23.rpy:249
translate brazil ch3sc23_241a823d:

#   "You spend the next hour telling Dalen bits and pieces about your life after the death of your parents."
    "Você passa a próxima hora contando a Dalen detalhes da sua vida após a morte de seus pais."

# game/chapters/chapter3/script/ch3sc23.rpy:251
translate brazil ch3sc23_2a8ee0f5:

#   da "Oren... Oren took you in and trained you for the last decade?"
    da "Oren... Oren te acolheu e te treinou durante a última década?"

# game/chapters/chapter3/script/ch3sc23.rpy:252
translate brazil ch3sc23_8ea4c6e7:

#   da "Explains why you were able to handle that Berzerker."
    da "Isso explica por que você conseguiu lidar com aquele Berserker."

# game/chapters/chapter3/script/ch3sc23.rpy:254
translate brazil ch3sc23_2a2f4f5d:

#   da "And Eliza is Oren's daughter?"
    da "E Eliza é filha de Oren?"

# game/chapters/chapter3/script/ch3sc23.rpy:255
translate brazil ch3sc23_0f401d1c:

#   da "Hmm, I had a feeling... I wasn't sure though, she has the determination of her father."
    da "Hum, eu tinha um pressentimento... Mas não tinha certeza, ela tem a determinação do pai."

# game/chapters/chapter3/script/ch3sc23.rpy:256
translate brazil ch3sc23_2a4c4299:

#   da "Not to mention the Raven hair and blue eyes of her beautiful mother."
    da "Sem falar dos cabelos negros e dos olhos azuis de sua linda mãe."

# game/chapters/chapter3/script/ch3sc23.rpy:258
translate brazil ch3sc23_809c4a62:

#   el "*Gasps* Y-You knew my mother? How?"
    el "*Suspiros* V-Você conhecia minha mãe? Como?"

# game/chapters/chapter3/script/ch3sc23.rpy:259
translate brazil ch3sc23_ad8849b7:

#   el "[mc] told me that you and my father attended an academy together?"
    el "[mc] Você me disse que você e meu pai estudaram juntos em uma academia?"

# game/chapters/chapter3/script/ch3sc23.rpy:261
translate brazil ch3sc23_58f6e338:

#   da "Oren and I grew up together. We were both top of our academy class. Well, us and Taron."
    da "Oren e eu crescemos juntos. Nós dois éramos os melhores da nossa turma na academia. Bem, nós e o Taron."

# game/chapters/chapter3/script/ch3sc23.rpy:262
translate brazil ch3sc23_53ae6f99:

#   da "The three of us quickly became friends. We did everything together while we were there."
    da "Nós três nos tornamos amigos rapidamente. Fizemos tudo juntos enquanto estávamos lá."

# game/chapters/chapter3/script/ch3sc23.rpy:263
translate brazil ch3sc23_6696ff2b:

#   da "Combat training, academic studies, exploring, wilderness survival."
    da "Treinamento de combate, estudos acadêmicos, exploração, sobrevivência na natureza."

# game/chapters/chapter3/script/ch3sc23.rpy:264
translate brazil ch3sc23_8b68dbaf:

#   da "But we all went our separate ways after graduating from the academy."
    da "Mas, depois de nos formarmos na academia, cada um seguiu seu próprio caminho."

# game/chapters/chapter3/script/ch3sc23.rpy:265
translate brazil ch3sc23_d216311d:

#   da "I became an adventurer... thus I left Luxenford to travel the kingdoms in search of adventures."
    da "Eu me tornei um aventureiro... e assim deixei Luxemburgo para viajar pelos reinos em busca de aventuras."

# game/chapters/chapter3/script/ch3sc23.rpy:266
translate brazil ch3sc23_258a3de0:

#   da "Oren fell in love with your mother, Ellen."
    da "Oren se apaixonou por sua mãe, Ellen."

# game/chapters/chapter3/script/ch3sc23.rpy:267
translate brazil ch3sc23_d86fff7a:

#   da "Together they moved to Whitehills in order to live a peaceful life and start a family."
    da "Juntos, eles se mudaram para Whitehills para viver uma vida tranquila e formar uma família."

# game/chapters/chapter3/script/ch3sc23.rpy:268
translate brazil ch3sc23_a8e2c520:

#   da "As for Taron, he got accepted into the Kingsguard."
    da "Quanto a Taron, ele foi aceito na Guarda Real."

# game/chapters/chapter3/script/ch3sc23.rpy:270
translate brazil ch3sc23_4c8f7eb8:

#   el "I can’t believe you knew my parents! No wonder I felt like I could trust you."
    el "Não acredito que você conhecia meus pais! Não é à toa que eu sentia que podia confiar em você."

# game/chapters/chapter3/script/ch3sc23.rpy:271
translate brazil ch3sc23_fa67aa50:

#   el "Is the world really that small?"
    el "O mundo é mesmo tão pequeno assim?"

# game/chapters/chapter3/script/ch3sc23.rpy:273
translate brazil ch3sc23_de92d336:

#   mc "Sometimes it really feels like it."
    mc "Às vezes, parece mesmo que sim."

# game/chapters/chapter3/script/ch3sc23.rpy:275
translate brazil ch3sc23_48713426:

#   da "*Chuckles* It's funny how Oren has had such a significant impact on each of our lives."
    da "*Risos* É engraçado como Oren teve um impacto tão significativo na vida de cada um de nós."

# game/chapters/chapter3/script/ch3sc23.rpy:276
translate brazil ch3sc23_136e3b01:

#   da "Childhood friend of mine, father to Eliza and mentor to [mc], and now we're all sitting in a room together."
    da "Meu amigo de infância, pai da Eliza e mentor de [mc] E agora estamos todos sentados juntos numa sala."

# game/chapters/chapter3/script/ch3sc23.rpy:278
translate brazil ch3sc23_6f4227ca:

#   da "Thank you for being honest with me, about everything... You’ve given me a lot to think about."
    da "Obrigada por ser honesta comigo sobre tudo... Você me deu muito em que pensar."

# game/chapters/chapter3/script/ch3sc23.rpy:279
translate brazil ch3sc23_e33efe6c:

#   da "Go on, get out of here! You must be tired after dealing with those goblins."
    da "Vamos, saia daqui! Você deve estar cansado depois de lidar com aqueles goblins."

# game/chapters/chapter3/script/ch3sc23.rpy:282
translate brazil ch3sc23_6443584f:

#   dat "*Sigh* Oren... Even from the grave you manage to keep things interesting."
    dat "*Suspiro* Oren... Mesmo do túmulo você consegue manter as coisas interessantes."

# game/chapters/chapter3/script/ch3sc23.rpy:283
translate brazil ch3sc23_6f55f9b2:

#   dat "So this is what you meant in your letter all those years ago... 'The Chosen One has been found'"
    dat "Então era isso que você queria dizer em sua carta de tantos anos atrás... 'O Escolhido foi encontrado'"

# game/chapters/chapter3/script/ch3sc23.rpy:284
translate brazil ch3sc23_c02a8b13:

#   dat "I never much believed in those prophecies that you delved into... but meeting him myself..."
    dat "Eu nunca acreditei muito nessas profecias que você mencionou... mas conhecê-lo pessoalmente..."

# game/chapters/chapter3/script/ch3sc23.rpy:285
translate brazil ch3sc23_f09e678d:

#   dat "Can I really deny it?"
    dat "Posso mesmo negar isso?"

