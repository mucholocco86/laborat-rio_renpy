# ARQUIVO: game/chapters/chapter3/script/ch3sc1.rpy DIALOGOS: 46


# game/chapters/chapter3/script/ch3sc1.rpy:19
translate brazil ch3sc1_db7fa650:

#   "As the two of you approach the city gates, a guard suddenly appears from behind the gate."
    "Conforme vocês dois se aproximam dos portões da cidade, um guarda surge repentinamente por trás do portão."

# game/chapters/chapter3/script/ch3sc1.rpy:21
translate brazil ch3sc1_7ee5d3c5:

#   gd "{b}Halt!{/b} State your business here."
    gd "{b}Pare!{/b} Descreva aqui o seu negócio."

# game/chapters/chapter3/script/ch3sc1.rpy:25
translate brazil ch3sc1_a4a505b1:

#   mc "We’re here to join the Adventurers Guild."
    mc "Estamos aqui para nos juntarmos à Guilda dos Aventureiros."

# game/chapters/chapter3/script/ch3sc1.rpy:27
translate brazil ch3sc1_0a985dd6:

#   gd "City is off-limits at the moment unless you have a {b}city-pass{/b}."
    gd "A cidade está interditada no momento, a menos que você tenha um {b} passe de cidade{/b}."

# game/chapters/chapter3/script/ch3sc1.rpy:29
translate brazil ch3sc1_cec278c6:

#   mct "Great... Just fucking great."
    mct "Ótimo... Simplesmente ótimo."

# game/chapters/chapter3/script/ch3sc1.rpy:30
translate brazil ch3sc1_a072425b:

#   mct "I’ll have to convince him to let us pass somehow."
    mct "Vou ter que convencê-lo a nos deixar passar de alguma forma."

# game/chapters/chapter3/script/ch3sc1.rpy:34
translate brazil ch3sc1_71e3b37a:

#   "{size=+3}{b}Success!{/b}{/size} Your {color=#87e1fa}Charisma{/color} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "{size=+3}{b}Sucesso!{/b}{/size} Seu {color=#87e1fa} Carisma{/color} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc1.rpy:36
translate brazil ch3sc1_d850fa1e:

#   mc "What’s your name?"
    mc "Qual o seu nome?"

# game/chapters/chapter3/script/ch3sc1.rpy:38
translate brazil ch3sc1_29a3b894:

#   gd "Milton."
    gd "Milton."

# game/chapters/chapter3/script/ch3sc1.rpy:40
translate brazil ch3sc1_00892ea8:

#   mc "Milton, we’ve been on the road for the better part of a week now, traveling here from Riverside."
    mc "Milton, estamos na estrada há quase uma semana, viajando desde Riverside até aqui."

# game/chapters/chapter3/script/ch3sc1.rpy:41
translate brazil ch3sc1_149dd4e3:

#   mc "We wish to become adventurers and help others."
    mc "Desejamos nos tornar aventureiros e ajudar os outros."

# game/chapters/chapter3/script/ch3sc1.rpy:43
translate brazil ch3sc1_1948367b:

#   mc "Don’t turn us away."
    mc "Não nos rejeitem."

# game/chapters/chapter3/script/ch3sc1.rpy:44
translate brazil ch3sc1_f200a28d:

#   mc "If you would be so generous as to allow us entry, we would like to get a city-pass and head straight for the guild."
    mc "Se vocês forem tão generosos a ponto de nos permitir a entrada, gostaríamos de obter um passe da cidade e ir diretamente para a guilda."

# game/chapters/chapter3/script/ch3sc1.rpy:45
translate brazil ch3sc1_502c409f:

#   mc "We have an important meeting with the guildmaster and if we're late he won't be pleased..."
    mc "Temos uma reunião importante com o mestre da guilda e, se nos atrasarmos, ele não ficará nada contente..."

# game/chapters/chapter3/script/ch3sc1.rpy:47
translate brazil ch3sc1_f3180a85:

#   mc "So if you let us pass, we'll be happy to put in a good word for you with the guildmaster."
    mc "Então, se você nos der passagem, ficaremos felizes em interceder por você junto ao mestre da guilda."

# game/chapters/chapter3/script/ch3sc1.rpy:49
translate brazil ch3sc1_c314f5a7:

#   ml "Hmm..."
    ml "Hum..."

# game/chapters/chapter3/script/ch3sc1.rpy:50
translate brazil ch3sc1_d649588d:

#   ml "Lord Dalen is a renowned knight and respected guildmaster, being in his good graces is nothing to sneeze at."
    ml "Lorde Dalen é um cavaleiro renomado e um respeitado mestre de guilda; estar em suas boas graças não é algo para se desprezar."

# game/chapters/chapter3/script/ch3sc1.rpy:52
translate brazil ch3sc1_1590cada:

#   ml "Alright sir."
    ml "Muito bem, senhor."

# game/chapters/chapter3/script/ch3sc1.rpy:53
translate brazil ch3sc1_a8b9300b:

#   ml "But we’ll be keeping an eye on you. Make sure you register for a pass immediately."
    ml "Mas estaremos de olho em você. Certifique-se de se cadastrar para obter um passe imediatamente."

# game/chapters/chapter3/script/ch3sc1.rpy:55
translate brazil ch3sc1_c9cb66d2:

#   mc "Sure, that’s not a problem. Where can we get a city-pass?"
    mc "Claro, sem problema. Onde podemos comprar um passe para a cidade?"

# game/chapters/chapter3/script/ch3sc1.rpy:57
translate brazil ch3sc1_5a5d30d6:

#   ml "You’ll get a pass when you sign up with the guild."
    ml "Você receberá um passe ao se inscrever na guilda."

# game/chapters/chapter3/script/ch3sc1.rpy:58
translate brazil ch3sc1_d7c7e575:

#   ml "All guilds have city-passes they hand out to their recruits."
    ml "Todas as guildas têm passes de acesso à cidade que distribuem aos seus recrutas."

# game/chapters/chapter3/script/ch3sc1.rpy:60
translate brazil ch3sc1_413ab482:

#   mc "Thank you, Milton."
    mc "Obrigado, Milton."

# game/chapters/chapter3/script/ch3sc1.rpy:62
translate brazil ch3sc1_2994ffb2:

#   el "Thank you so much! I was afraid you'd turn us away..."
    el "Muito obrigada! Eu estava com medo de que vocês nos rejeitassem..."

# game/chapters/chapter3/script/ch3sc1.rpy:63
translate brazil ch3sc1_a9501b5c:

#   el "You are a true guard, Milton!"
    el "Você é um verdadeiro guarda, Milton!"

# game/chapters/chapter3/script/ch3sc1.rpy:65
translate brazil ch3sc1_c798665f:

#   ml "Oh, eh..."
    ml "Ah, é..."

# game/chapters/chapter3/script/ch3sc1.rpy:66
translate brazil ch3sc1_936babe7:

#   ml "Thank you, miss!"
    ml "Obrigada, senhorita!"

# game/chapters/chapter3/script/ch3sc1.rpy:68
translate brazil ch3sc1_12052605:

#   ml "It's an honor to have you within our gates, I believe you'll make fine adventurers."
    ml "É uma honra tê-los entre nós, acredito que vocês serão excelentes aventureiros."

# game/chapters/chapter3/script/ch3sc1.rpy:70
translate brazil ch3sc1_44e0529b:

#   ml "And don't forget to mention me to Lord Dalen!"
    ml "E não se esqueça de mencionar meu nome ao Lorde Dalen!"

# game/chapters/chapter3/script/ch3sc1.rpy:72
translate brazil ch3sc1_a8f3effb:

#   el "You bet! We'll make sure to put in a good word for you!"
    el "Pode apostar! Com certeza daremos uma boa palavra por você!"

# game/chapters/chapter3/script/ch3sc1.rpy:78
translate brazil ch3sc1_11c5f085:

#   "{size=+3}{b}Success!{/b}{/size} Your {color=#fc584c}Intimidation{/color} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "{size=+3}{b}Sucesso!{/b}{/size} Seu {color=#fc584c} Intimidação{/color} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc1.rpy:81
translate brazil ch3sc1_fcbd18e0:

#   mc "*Sigh* ..."
    mc "*Suspirar* ..."

# game/chapters/chapter3/script/ch3sc1.rpy:83
translate brazil ch3sc1_78dd9d95:

#   mc "Listen here, guard. We’re here to see Dalen, the head of the Adventurers Guild."
    mc "Escute aqui, guarda. Viemos falar com Dalen, o chefe da Guilda dos Aventureiros."

# game/chapters/chapter3/script/ch3sc1.rpy:84
translate brazil ch3sc1_f5ece72d:

#   mc "He's awaiting our arrival and we’re already late."
    mc "Ele está esperando nossa chegada e já estamos atrasados."

# game/chapters/chapter3/script/ch3sc1.rpy:87
translate brazil ch3sc1_4964f17c:

#   mc "Do you want to tell him that you’re the reason we’re late for our meeting?"
    mc "Você quer contar para ele que você é o motivo do nosso atraso para a reunião?"

# game/chapters/chapter3/script/ch3sc1.rpy:88
translate brazil ch3sc1_e223d075:

#   mc "Or should I do you that kindness?"
    mc "Ou devo lhe fazer essa gentileza?"

# game/chapters/chapter3/script/ch3sc1.rpy:90
translate brazil ch3sc1_3a97014b:

#   gd "No, I-"
    gd "Não, eu-"

# game/chapters/chapter3/script/ch3sc1.rpy:92
translate brazil ch3sc1_84841de7:

#   mc "Then you'd better let us through. He’s not known for his patience."
    mc "Então é melhor nos deixar passar. Ele não é conhecido por sua paciência."

# game/chapters/chapter3/script/ch3sc1.rpy:93
translate brazil ch3sc1_48e1422a:

#   mc "I'd hate for you to lose your position as gateguard over this."
    mc "Eu detestaria que você perdesse seu cargo de porteiro por causa disso."

# game/chapters/chapter3/script/ch3sc1.rpy:97
translate brazil ch3sc1_59d160f1:

#   gd "R-Right away, sir! I’m sorry for any inconvenience."
    gd "— Sim, senhor! Peço desculpas por qualquer inconveniente."

# game/chapters/chapter3/script/ch3sc1.rpy:98
translate brazil ch3sc1_d7b3fa7c:

#   gd "Please see to it that you pick up the city-pass at the guild."
    gd "Certifique-se de pegar o passe da cidade na guilda."

# game/chapters/chapter3/script/ch3sc1.rpy:100
translate brazil ch3sc1_93dfa314:

#   mc "Will do."
    mc "Vai fazer."

# game/chapters/chapter3/script/ch3sc1.rpy:101
translate brazil ch3sc1_a02d48bd:

#   mc "Now why don't you run along? We don't need an escort."
    mc "Por que você não vai embora? Não precisamos de escolta."

# game/chapters/chapter3/script/ch3sc1.rpy:105
translate brazil ch3sc1_555e72a3:

#   el "*Whispers* {size=+3}{b}Heavens! Are you crazy?! What if he didn’t back down? We’d be knee deep in trouble!{/b}{/size}"
    el "*Sussurros* {size=+3}{b}Meu Deus! Você está louco?! E se ele não recuasse? Estaríamos em maus lençóis!{/b}{/size}"

# game/chapters/chapter3/script/ch3sc1.rpy:107
translate brazil ch3sc1_da301620:

#   mc "Sometimes you gotta live a little."
    mc "Às vezes você precisa viver um pouco."

# game/chapters/chapter3/script/ch3sc1.rpy:109
translate brazil ch3sc1_a1c76144:

#   el "*Relieved sigh* Hhaah... I’m just happy you pulled it off."
    el "*Suspiro de alívio* Haha... Estou feliz que você tenha conseguido."

