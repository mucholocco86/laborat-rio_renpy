# game/chapters/chapter3/script/ch3sc12.rpy:73
translate brazil ch3sc12_b32039ec_1:

#   sy "Here, ten silvers! I know it’s not much, but it was only a D-Rank quest."
    sy "Aqui estão dez moedas de prata! Eu sei que não é muito, mas era apenas uma missão de Rank D."

# game/chapters/chapter3/script/ch3sc12.rpy:11
translate brazil ch3sc12_b498ce83:

#   sy "*Humms softly*"
    sy "*Cantarola baixinho*"

# game/chapters/chapter3/script/ch3sc12.rpy:13
translate brazil ch3sc12_6aef4382:

#   syt "..."
    syt "..."

# game/chapters/chapter3/script/ch3sc12.rpy:16
translate brazil ch3sc12_a63c62b9:

#   syt "I wonder if they are doing alright?"
    syt "Será que eles estão bem?"

# game/chapters/chapter3/script/ch3sc12.rpy:17
translate brazil ch3sc12_a184135f:

#   syt "The quest should be pretty straightforward, from what I could tell."
    syt "Pelo que pude perceber, a missão deve ser bem simples."

# game/chapters/chapter3/script/ch3sc12.rpy:18
translate brazil ch3sc12_5e6d44b2:

#   syt "And [mc]... he has so much magic within him."
    syt "E [mc]... ele possui muita magia dentro de si."

# game/chapters/chapter3/script/ch3sc12.rpy:19
translate brazil ch3sc12_6eaa8bbe:

#   syt "I'm sure they're fiiiiine."
    syt "Tenho certeza de que eles estão ótimos."

# game/chapters/chapter3/script/ch3sc12.rpy:20
translate brazil ch3sc12_7de413eb:

#   syt "Would he? Mmhm, no! There's no way he would be interested in someone like me, right?"
    syt "Será que ele se interessaria? Hum, não! Não tem a menor chance dele se interessar por alguém como eu, né?"

# game/chapters/chapter3/script/ch3sc12.rpy:21
translate brazil ch3sc12_1227dcd3:

#   syt "I'm just a silly fae, confined to this guild."
    syt "Sou apenas uma fada boba, confinada a esta guilda."

# game/chapters/chapter3/script/ch3sc12.rpy:22
translate brazil ch3sc12_4c8f7478:

#   syt "What use could I be to someone like him?"
    syt "Que utilidade eu poderia ter para alguém como ele?"

# game/chapters/chapter3/script/ch3sc12.rpy:26
translate brazil ch3sc12_995286d6:

#   el "Hiii Sylph! We’re back!"
    el "Olá, Sylph! Estamos de volta!"

# game/chapters/chapter3/script/ch3sc12.rpy:28
translate brazil ch3sc12_02f1678c:

#   sy "Oh my! You guys sure work fast!"
    sy "Nossa! Vocês trabalham muito rápido!"

# game/chapters/chapter3/script/ch3sc12.rpy:30
translate brazil ch3sc12_4a467163:

#   syt "See? I knew they'd handle it, easy peasy!"
    syt "Viram? Eu sabia que eles dariam conta, moleza!"

# game/chapters/chapter3/script/ch3sc12.rpy:32
translate brazil ch3sc12_29ea8459:

#   sy "Seems like Dalen has sized you up perfectly!"
    sy "Parece que Dalen te avaliou perfeitamente!"

# game/chapters/chapter3/script/ch3sc12.rpy:36
translate brazil ch3sc12_7e4c3613:

#   el "Are you saying you didn’t have faith in us?"
    el "Você está dizendo que não tinha fé em nós?"

# game/chapters/chapter3/script/ch3sc12.rpy:38
translate brazil ch3sc12_ad4c39e6:

#   sy "No way!"
    sy "Sem chance!"

# game/chapters/chapter3/script/ch3sc12.rpy:39
translate brazil ch3sc12_383b3463:

#   sy "I totally had faith!"
    sy "Eu tinha fé absoluta!"

# game/chapters/chapter3/script/ch3sc12.rpy:41
translate brazil ch3sc12_68e98302:

#   sy "Yuuuup, yup, yup!"
    sy "Sim, sim, sim!"

# game/chapters/chapter3/script/ch3sc12.rpy:42
translate brazil ch3sc12_b2592a0c:

#   sy "That’s me, the little ole faith-fae!"
    sy "Essa sou eu, a pequena fada da fé!"

# game/chapters/chapter3/script/ch3sc12.rpy:44
translate brazil ch3sc12_d7850904:

#   el "Riiiight..."
    el "Certo..."

# game/chapters/chapter3/script/ch3sc12.rpy:46
translate brazil ch3sc12_002a46df:

#   mc "Sylph, was there any reward for this quest? Or was it just a trial run?"
    mc "Sylph, havia alguma recompensa por essa missão? Ou foi apenas um teste?"

# game/chapters/chapter3/script/ch3sc12.rpy:48
translate brazil ch3sc12_d1a63ee2:

#   sy "Oh! Right! Right, right, right!"
    sy "Ah! Certo! Certo, certo, certo!"

# game/chapters/chapter3/script/ch3sc12.rpy:50
translate brazil ch3sc12_c2e25876:

#   sy "Just a moment!"
    sy "Um momento!"

# game/chapters/chapter3/script/ch3sc12.rpy:54
translate brazil ch3sc12_49688f15:

#   sy "It should be right over here. I remember placing it here earlier."
    sy "Deveria estar bem aqui. Lembro-me de tê-lo colocado aqui antes."

# game/chapters/chapter3/script/ch3sc12.rpy:56
translate brazil ch3sc12_d2fd8743:

#   sy "You’ve definitely earned a reward. A raven came by earlier with a letter stating your work was satisfactory."
    sy "Você definitivamente merece uma recompensa. Um corvo passou por aqui mais cedo com uma carta dizendo que seu trabalho foi satisfatório."

# game/chapters/chapter3/script/ch3sc12.rpy:57
translate brazil ch3sc12_27282d9f:

#   sy "Dalen will be very pleased with your success!"
    sy "Dalen ficará muito satisfeito com o seu sucesso!"

# game/chapters/chapter3/script/ch3sc12.rpy:58
translate brazil ch3sc12_493a1c5b:

#   sy "So am I, in fact!"
    sy "Eu também!"

# game/chapters/chapter3/script/ch3sc12.rpy:62
translate brazil ch3sc12_39c68fdb:

#   elt "She’s got to be doing this on purpose."
    elt "Ela deve estar fazendo isso de propósito."

# game/chapters/chapter3/script/ch3sc12.rpy:64
translate brazil ch3sc12_3228f0bb:

#   elt "Calm down, Eliza."
    elt "Calma, Eliza."

# game/chapters/chapter3/script/ch3sc12.rpy:65
translate brazil ch3sc12_db8b76fc:

#   elt "It’s Sylph... She might be a bit aloof but she’s a fae!"
    elt "É a Sylph... Ela pode ser um pouco distante, mas é uma fada!"

# game/chapters/chapter3/script/ch3sc12.rpy:66
translate brazil ch3sc12_a9995f0f:

#   elt "It’s not like she'd intentionally try to seduce [mc]. Right?"
    elt "Não é como se ela tentasse seduzir intencionalmente. [mc]. Certo?"

# game/chapters/chapter3/script/ch3sc12.rpy:67
translate brazil ch3sc12_29e24a1a:

#   elt "Then again... she's perking her ass all over the place? Hnngh!"
    elt "Por outro lado... ela está empinando a bunda para todo lado? Hnngh!"

# game/chapters/chapter3/script/ch3sc12.rpy:69
translate brazil ch3sc12_b32039ec:

#   sy "Here, ten silvers! I know it’s not much, but it was only a D-Rank quest."
    sy "Aqui estão dez moedas de prata! Eu sei que não é muito, mas era apenas uma missão de Rank D."

# game/chapters/chapter3/script/ch3sc12.rpy:78
translate brazil ch3sc12_dcc67200:

#   el "Are you kidding me, Sylph? This is great!"
    el "Você está brincando, Sylph? Isso é ótimo!"

# game/chapters/chapter3/script/ch3sc12.rpy:80
translate brazil ch3sc12_393ea38e:

#   sy "Here you go, [mc]."
    sy "Aqui você vai, [mc]."

# game/chapters/chapter3/script/ch3sc12.rpy:81
translate brazil ch3sc12_b1181ad8:

#   "As Sylph hands you the coins, her tiny fingers stroke your hand gently."
    "Enquanto Sylph lhe entrega as moedas, seus dedinhos acariciam sua mão delicadamente."

# game/chapters/chapter3/script/ch3sc12.rpy:83
translate brazil ch3sc12_7fce89dc:

#   "Her fingers are so elegant to the touch, you can even feel the magic essence flowing within her fingertips."
    "Seus dedos são tão delicados ao toque que você consegue até sentir a essência mágica fluindo em suas pontas."

# game/chapters/chapter3/script/ch3sc12.rpy:84
translate brazil ch3sc12_9d6bd87b:

#   mc "Thank you, Sylph."
    mc "Obrigada, Sylph."

# game/chapters/chapter3/script/ch3sc12.rpy:88
translate brazil ch3sc12_83e41953:

#   sy "No, [mc]. Thank you for joining us. We need this as much as you do."
    sy "Não, [mc] Obrigado por se juntar a nós. Precisamos disso tanto quanto vocês."

# game/chapters/chapter3/script/ch3sc12.rpy:89
translate brazil ch3sc12_f7e2c621:

#   sy "It means... it means a lot."
    sy "Significa... significa muito."

# game/chapters/chapter3/script/ch3sc12.rpy:91
translate brazil ch3sc12_ff216cc8:

#   sy "Now get outta here you two!"
    sy "Agora sumam daqui vocês dois!"

# game/chapters/chapter3/script/ch3sc12.rpy:92
translate brazil ch3sc12_e2d74092:

#   sy "You're new to town. I'm sure there's a bunch of things you want to do!"
    sy "Você é novo na cidade. Tenho certeza de que há muitas coisas que você quer fazer!"

# game/chapters/chapter3/script/ch3sc12.rpy:94
translate brazil ch3sc12_0d1e9a1f:

#   sy "But remember to check back tomorrow. There might be a new quest available then!"
    sy "Mas lembre-se de voltar amanhã. Pode haver uma nova missão disponível!"

# game/chapters/chapter3/script/ch3sc12.rpy:96
translate brazil ch3sc12_9d4e22ca:

#   mc "Will do, Sylph. Give Dalen our regards."
    mc "Combinado, Sylph. Mande lembranças para Dalen."

# game/chapters/chapter3/script/ch3sc12.rpy:98
translate brazil ch3sc12_ccf7b383:

#   sy "Sure thing. I can't wait to tell him of your success! See you tomorrow!"
    sy "Claro! Mal posso esperar para contar a ele sobre o seu sucesso! Até amanhã!"

# game/chapters/chapter3/script/ch3sc12.rpy:104
translate brazil ch3sc12_7f875fc2:

#   el "*Stretches* Mhh! Can you feel it?"
    el "*Se alonga* Hum! Você consegue sentir?"

# game/chapters/chapter3/script/ch3sc12.rpy:105
translate brazil ch3sc12_ecf204cb:

#   el "Mmmh! It feels just wonderful!"
    el "Hum! É uma sensação maravilhosa!"

# game/chapters/chapter3/script/ch3sc12.rpy:107
translate brazil ch3sc12_2ee86e60:

#   mc "Feel what?"
    mc "Sentir o quê?"

# game/chapters/chapter3/script/ch3sc12.rpy:108
translate brazil ch3sc12_5520daf8:

#   el "*Giggling happily*"
    el "*Rindo alegremente*"

# game/chapters/chapter3/script/ch3sc12.rpy:110
translate brazil ch3sc12_6cc45e13:

#   el "The success of our first quest, silly!"
    el "O sucesso da nossa primeira missão, bobinho!"

# game/chapters/chapter3/script/ch3sc12.rpy:111
translate brazil ch3sc12_7e92293c:

#   el "It went much better than we could have hoped for."
    el "Correu muito melhor do que poderíamos ter esperado."

# game/chapters/chapter3/script/ch3sc12.rpy:113
translate brazil ch3sc12_f377505a:

#   mc "Yeah it was rather straightfoward, and we got paid a decent amount."
    mc "Sim, foi bem simples, e recebemos um valor razoável."

# game/chapters/chapter3/script/ch3sc12.rpy:114
translate brazil ch3sc12_f4304d7d:

#   mc "It does feel good, can't deny that."
    mc "É uma sensação boa, não dá para negar."

# game/chapters/chapter3/script/ch3sc12.rpy:116
translate brazil ch3sc12_032c4dfe:

#   el "Even if you tried to deny it, your smile tells me all I need to know!"
    el "Mesmo que você tente negar, seu sorriso me diz tudo o que preciso saber!"

# game/chapters/chapter3/script/ch3sc12.rpy:117
translate brazil ch3sc12_efec06e0:

#   el "Your loving every moment of being an adventurer! As do I for that matter!"
    el "Você está aproveitando cada momento de sua aventura! Eu também!"

# game/chapters/chapter3/script/ch3sc12.rpy:119
translate brazil ch3sc12_a92f68e9:

#   mc "I'm glad you're taking a liking to it, this is what I've always wanted to do."
    mc "Que bom que você está gostando, é exatamente isso que eu sempre quis fazer."

# game/chapters/chapter3/script/ch3sc12.rpy:120
translate brazil ch3sc12_db416f56:

#   mc "Why don’t you head over to the tavern we passed by earlier, and make sure there’s a room for us tonight?"
    mc "Por que você não vai até a taverna por onde passamos mais cedo e verifica se há um quarto para nós esta noite?"

# game/chapters/chapter3/script/ch3sc12.rpy:122
translate brazil ch3sc12_3d022ea2:

#   el "Great idea!"
    el "Ótima ideia!"

# game/chapters/chapter3/script/ch3sc12.rpy:123
translate brazil ch3sc12_bca38b11:

#   el "I was hoping we could've stayed at the guild..."
    el "Eu esperava que pudéssemos ter ficado na guilda..."

# game/chapters/chapter3/script/ch3sc12.rpy:125
translate brazil ch3sc12_0ed47ac1:

#   el "But Sylph said they were renovating the sleeping quarters."
    el "Mas Sylph disse que estavam reformando os dormitórios."

# game/chapters/chapter3/script/ch3sc12.rpy:126
translate brazil ch3sc12_2497e2a5:

#   el "I suppose it'll be a while till we can leave tavern beds behind us."
    el "Imagino que ainda vai demorar um pouco até podermos deixar para trás as camas de taverna."

# game/chapters/chapter3/script/ch3sc12.rpy:128
translate brazil ch3sc12_3e42db9f:

#   mc "We’ll make do with taverns for now."
    mc "Por enquanto, vamos nos contentar com as tavernas."

# game/chapters/chapter3/script/ch3sc12.rpy:129
translate brazil ch3sc12_e305fa5f:

#   mc "I didn’t expect our first reward to be so generous, though."
    mc "Não esperava que nossa primeira recompensa fosse tão generosa."

# game/chapters/chapter3/script/ch3sc12.rpy:131
translate brazil ch3sc12_2f85baea:

#   el "Same! Ten silvers for a D rank quest?"
    el "Igualzinho! Dez moedas de prata por uma missão de nível D?"

# game/chapters/chapter3/script/ch3sc12.rpy:132
translate brazil ch3sc12_389d4a7f:

#   el "We’ll be rich in no time if it’s always like this. *Giggles*"
    el "Se continuar assim, ficaremos ricos rapidinho. *Risos*"

# game/chapters/chapter3/script/ch3sc12.rpy:133
translate brazil ch3sc12_5b1ae575:

#   el "Think about all the things we could buy after a few quests!"
    el "Pense em todas as coisas que poderíamos comprar depois de algumas missões!"

# game/chapters/chapter3/script/ch3sc12.rpy:135
translate brazil ch3sc12_ae930c9b:

#   el "But I'm getting ahead of myself."
    el "Mas estou me adiantando."

# game/chapters/chapter3/script/ch3sc12.rpy:136
translate brazil ch3sc12_91afd698:

#   el "Okay. I’ll head over and get us a room before they’re all taken."
    el "Certo. Vou lá reservar um quarto para nós antes que todos estejam ocupados."

# game/chapters/chapter3/script/ch3sc12.rpy:138
translate brazil ch3sc12_059aab8d:

#   mc "Sounds good. I’ll find you later."
    mc "Parece ótimo. Te encontro mais tarde."

# game/chapters/chapter3/script/ch3sc12.rpy:140
translate brazil ch3sc12_95dc3c02:

#   el "Oh, wait! W-Would it be completely shameless of me to spend a few silvers on a new outfit?"
    el "Ah, espere! S-Seria completamente descarado da minha parte gastar algumas moedas de prata em uma roupa nova?"

# game/chapters/chapter3/script/ch3sc12.rpy:141
translate brazil ch3sc12_1287ddb3:

#   el "I saw this really cute outfit earlier when we passed by a store, and it looks practical too!"
    el "Vi essa roupa super fofa mais cedo quando passamos em frente a uma loja, e parece bem prática também!"

# game/chapters/chapter3/script/ch3sc12.rpy:143
translate brazil ch3sc12_4a4f9312:

#   el "I know we don’t have much."
    el "Eu sei que não temos muita coisa."

# game/chapters/chapter3/script/ch3sc12.rpy:148
translate brazil ch3sc12_0b6cf116:

#   mc "I don’t see why not."
    mc "Não vejo por que não."

# game/chapters/chapter3/script/ch3sc12.rpy:149
translate brazil ch3sc12_0e1c9895:

#   mc "You’ve been training hard and did well on our first quest."
    mc "Você treinou bastante e se saiu bem em nossa primeira missão."

# game/chapters/chapter3/script/ch3sc12.rpy:151
translate brazil ch3sc12_86301430:

#   mc "Go on, pick out something you really like."
    mc "Vamos lá, escolha algo de que você realmente goste."

# game/chapters/chapter3/script/ch3sc12.rpy:152
translate brazil ch3sc12_cecaf5b2:

#   mc "But before you buy it, remember to try it on."
    mc "Mas antes de comprar, lembre-se de experimentar."

# game/chapters/chapter3/script/ch3sc12.rpy:153
translate brazil ch3sc12_a6273e2f:

#   mc "You have to be nimble in it, that's one of your strengths."
    mc "Você precisa ser ágil nisso, essa é uma das suas maiores qualidades."

# game/chapters/chapter3/script/ch3sc12.rpy:155
translate brazil ch3sc12_e13dc711:

#   el "R-Really?! {b}Yay!{/b}"
    el "Sério?! {b} Yay!{/b}"

# game/chapters/chapter3/script/ch3sc12.rpy:158
translate brazil ch3sc12_25d78ec3:

#   el "{b}You’re the best!{/b}"
    el "{b}Você é o melhor!{/b}"

# game/chapters/chapter3/script/ch3sc12.rpy:159
translate brazil ch3sc12_ce53cd29:

#   el "Thank you, [mc]! Thank you, thank you!"
    el "Obrigado, [mc] Muito obrigado!"

# game/chapters/chapter3/script/ch3sc12.rpy:160
translate brazil ch3sc12_0039247f:

#   el "I promise I'll test it before buying anything! I can't wait to show you!"
    el "Prometo que vou testar antes de comprar qualquer coisa! Mal posso esperar para te mostrar!"

# game/chapters/chapter3/script/ch3sc12.rpy:162
translate brazil ch3sc12_eeac516d:

#   "She plants her soft wet lips on your cheek in excitement, while she caresses your cheek."
    "Ela encosta seus lábios macios e úmidos em sua bochecha, empolgada, enquanto acaricia seu rosto."

# game/chapters/chapter3/script/ch3sc12.rpy:163
translate brazil ch3sc12_5bdc44d7:

#   el "{b}Mwaaah!{/b}"
    el "{b}Uau!{/b}"

# game/chapters/chapter3/script/ch3sc12.rpy:165
translate brazil ch3sc12_c78dd5c7:

#   el "See you later at the tavern, handsome."
    el "Te vejo mais tarde na taverna, bonitão."

# game/chapters/chapter3/script/ch3sc12.rpy:166
translate brazil ch3sc12_619f7035:

#   "Eliza is excited that you encouraged her, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Eliza está animada por você a ter encorajado, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc12.rpy:169
translate brazil ch3sc12_4b81c702:

#   mc "See you."
    mc "Vê você."

# game/chapters/chapter3/script/ch3sc12.rpy:173
translate brazil ch3sc12_836967de:

#   mc "I don’t think it’s wise to spend what little coin we have on outfits."
    mc "Não acho sensato gastar o pouco dinheiro que temos com roupas."

# game/chapters/chapter3/script/ch3sc12.rpy:175
translate brazil ch3sc12_603d5c51:

#   mc "But we have five silvers each to spend, so I won’t stop you."
    mc "Mas cada um de nós tem cinco moedas de prata para gastar, então não vou impedi-los."

# game/chapters/chapter3/script/ch3sc12.rpy:176
translate brazil ch3sc12_99c02078:

#   mc "Just remember to have enough left over for the room tonight."
    mc "Só não se esqueça de deixar o suficiente para o quarto esta noite."

# game/chapters/chapter3/script/ch3sc12.rpy:178
translate brazil ch3sc12_03b952c0:

#   el "Trust me! Once you see my new outfit you will regret hesitating!"
    el "Acredite em mim! Quando você vir meu novo look, vai se arrepender de ter hesitado!"

# game/chapters/chapter3/script/ch3sc12.rpy:180
translate brazil ch3sc12_b6f1cfed:

#   mc "Whatever you say... Catch you later."
    mc "Como quiser... Até mais."

