translate brazil ch3sc13_e643c0a8:

#   br "Basic... items..."
    br "Itens básicos..."

# game/chapters/chapter3/script/ch3sc13.rpy:33
translate brazil ch3sc13_927d58a5:

#   br "{b}YER TRYING TE TRICK ME NOW?!{/b}"
    br "{b}VOCÊ ESTÁ TENTANDO ME ENGANAR AGORA?!{/b}"

# game/chapters/chapter3/script/ch3sc13.rpy:34
translate brazil ch3sc13_67e6d0c1:

#   br "This is fine steel! Nothing basic about it!"
    br "Este é aço de primeira qualidade! Nada de básico nele!"

# game/chapters/chapter3/script/ch3sc13.rpy:36
translate brazil ch3sc13_19ae2a9b:

#   uk "N-No sir, I’m sorry but we can’t offer you more than this."
    uk "N-Não senhor, sinto muito, mas não podemos lhe oferecer mais do que isso."

# game/chapters/chapter3/script/ch3sc13.rpy:38
translate brazil ch3sc13_8cca0c0a:

