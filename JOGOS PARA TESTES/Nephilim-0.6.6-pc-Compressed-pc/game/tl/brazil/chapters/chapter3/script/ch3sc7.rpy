# ARQUIVO: game/chapters/chapter3/script/ch3sc7.rpy DIALOGOS: 55


# game/chapters/chapter3/script/ch3sc7.rpy:11
translate brazil ch3sc7_3a4f2eca:

#   sy "Oh, hi guys!"
    sy "Olá, pessoal!"

# game/chapters/chapter3/script/ch3sc7.rpy:13
translate brazil ch3sc7_b0925314:

#   el "Hi Sylph!"
    el "Olá, Sylph!"

# game/chapters/chapter3/script/ch3sc7.rpy:14
translate brazil ch3sc7_ab462dd3:

#   el "What have you got for us? We'll take on anything!"
    el "O que vocês têm para nós? Aceitamos qualquer coisa!"

# game/chapters/chapter3/script/ch3sc7.rpy:16
translate brazil ch3sc7_b1bb5431:

#   el "There's no quest too small! We'll get it done!"
    el "Não existe missão pequena demais! Nós vamos conseguir!"

# game/chapters/chapter3/script/ch3sc7.rpy:18
translate brazil ch3sc7_6e21b1d8:

#   sy "Oh my! You’re eager!"
    sy "Nossa! Você está ansioso(a)!"

# game/chapters/chapter3/script/ch3sc7.rpy:20
translate brazil ch3sc7_49d1f4d9:

#   sy "Well, you’re in luck because I’ve just received a quest!"
    sy "Bom, você está com sorte porque acabei de receber uma missão!"

# game/chapters/chapter3/script/ch3sc7.rpy:21
translate brazil ch3sc7_13dccade:

#   sy "It’s only a D-Ranked mission, so it should be simple."
    sy "É apenas uma missão de nível D, então deve ser simples."

# game/chapters/chapter3/script/ch3sc7.rpy:23
translate brazil ch3sc7_7eb35038:

#   el "You sure know how to make it sound exciting, Sylph."
    el "Você sabe mesmo como fazer as coisas parecerem emocionantes, Sylph."

# game/chapters/chapter3/script/ch3sc7.rpy:25
translate brazil ch3sc7_082483dc:

#   sy "*Snickering* Heh-heh-heeeeh. It’s my specialty really!"
    sy "*Risinhos* Heh-heh-heeeeh. É a minha especialidade, na verdade!"

# game/chapters/chapter3/script/ch3sc7.rpy:27
translate brazil ch3sc7_a10621d4:

#   mc "Don’t listen to her..."
    mc "Não dê ouvidos a ela..."

# game/chapters/chapter3/script/ch3sc7.rpy:28
translate brazil ch3sc7_fee62134:

#   mc "We’ll gladly accept it."
    mc "Aceitaremos com prazer."

# game/chapters/chapter3/script/ch3sc7.rpy:31
translate brazil ch3sc7_f9c17db0:

#   sy "Great! It feels amazing to have such nice and dependable new recruits."
    sy "Ótimo! É maravilhoso ter novos recrutas tão bons e confiáveis."

# game/chapters/chapter3/script/ch3sc7.rpy:33
translate brazil ch3sc7_d4e7f5c2:

#   sy "Such a handsome and reliable recruit. *Snickers* Heh-heeeh."
    sy "Que recruta bonito e confiável. *Risos* Heh-heeeh."

# game/chapters/chapter3/script/ch3sc7.rpy:35
translate brazil ch3sc7_541164ef:

#   sy "Okaaay, pleasantries later. Business first!"
    sy "Ok, chega de formalidades. Vamos ao que interessa!"

# game/chapters/chapter3/script/ch3sc7.rpy:37
translate brazil ch3sc7_4877b7e2:

#   el "What is the mission about?"
    el "Qual é o objetivo da missão?"

# game/chapters/chapter3/script/ch3sc7.rpy:39
translate brazil ch3sc7_7f7d4fdc:

#   sy "One of the local stables has had issues with wolves roaming nearby."
    sy "Um dos estábulos locais tem tido problemas com lobos que rondam as proximidades."

# game/chapters/chapter3/script/ch3sc7.rpy:40
translate brazil ch3sc7_aa524ebe:

#   sy "Apparently, the wolves chased off their best breeding mare!"
    sy "Aparentemente, os lobos afugentaram a melhor égua reprodutora deles!"

# game/chapters/chapter3/script/ch3sc7.rpy:42
translate brazil ch3sc7_32f96e61:

#   sy "So, they've asked for someone to come and deal with the situation."
    sy "Então, eles pediram que alguém viesse lidar com a situação."

# game/chapters/chapter3/script/ch3sc7.rpy:44
translate brazil ch3sc7_e262d456:

#   el "How should we approach the situation?"
    el "Como devemos abordar essa situação?"

# game/chapters/chapter3/script/ch3sc7.rpy:46
translate brazil ch3sc7_e4ae3750:

#   mc "We’ll see how bad it is once we get there."
    mc "Veremos o quão ruim é quando chegarmos lá."

# game/chapters/chapter3/script/ch3sc7.rpy:48
translate brazil ch3sc7_2037c93d:

#   sy "Sounds like the two of you have got it all under control."
    sy "Parece que vocês dois têm tudo sob controle."

# game/chapters/chapter3/script/ch3sc7.rpy:49
translate brazil ch3sc7_50136049:

#   sy "As adventurers it'll be important that can you solve unforeseen events when you get out there."
    sy "Como aventureiros, será importante que vocês consigam resolver imprevistos quando estiverem lá fora."

# game/chapters/chapter3/script/ch3sc7.rpy:51
translate brazil ch3sc7_65b1ab77:

#   sy "Being on the same page as your partner is paramount to succeeding."
    sy "Estar em sintonia com seu parceiro é fundamental para o sucesso."

# game/chapters/chapter3/script/ch3sc7.rpy:52
translate brazil ch3sc7_d188b1c6:

#   sy "Return here once you’ve completed the task, and you’ll receive your reward."
    sy "Volte aqui assim que concluir a tarefa e você receberá sua recompensa."

# game/chapters/chapter3/script/ch3sc7.rpy:54
translate brazil ch3sc7_052869d1:

#   mc "Eliza and I work well together, we’ll be back before you know it, Sylph."
    mc "Eu e a Eliza trabalhamos bem juntas, voltaremos antes que você perceba, Sylph."

# game/chapters/chapter3/script/ch3sc7.rpy:55
translate brazil ch3sc7_43116ef8:

#   "Eliza nods happily at your statement."
    "Eliza acena com a cabeça, satisfeita com sua afirmação."

# game/chapters/chapter3/script/ch3sc7.rpy:56
translate brazil ch3sc7_02ceef95:

#   mc "Keep that reward ready for us."
    mc "Mantenha essa recompensa pronta para nós."

# game/chapters/chapter3/script/ch3sc7.rpy:58
translate brazil ch3sc7_fe56a625:

#   sy "Mhhm! Confidence. I like it!"
    sy "Hum! Confiança. Gostei!"

# game/chapters/chapter3/script/ch3sc7.rpy:60
translate brazil ch3sc7_f83dc39f:

#   sy "{b}OH!{/b}"
    sy "{b}OH!{/b}"

# game/chapters/chapter3/script/ch3sc7.rpy:61
translate brazil ch3sc7_83b4a215:

#   sy "Before I forget!"
    sy "Antes que eu me esqueça!"

# game/chapters/chapter3/script/ch3sc7.rpy:63
translate brazil ch3sc7_486a784c:

#   sy "I managed to get your city-passes ready."
    sy "Consegui preparar seus passes de transporte da cidade."

# game/chapters/chapter3/script/ch3sc7.rpy:64
translate brazil ch3sc7_b1c751cc:

#   sy "Here, now you should be able to freely enter Luxenford."
    sy "Pronto, agora você deve conseguir entrar livremente em Luxemburgo."

# game/chapters/chapter3/script/ch3sc7.rpy:66
translate brazil ch3sc7_f5237e63:

#   el "Ah, great! No more trouble with the guards."
    el "Ah, ótimo! Chega de problemas com os guardas."

# game/chapters/chapter3/script/ch3sc7.rpy:68
translate brazil ch3sc7_01fc7dbd:

#   mc "Hey, I handled the guards just fine."
    mc "Ei, eu lidei com os guardas sem problemas."

# game/chapters/chapter3/script/ch3sc7.rpy:70
translate brazil ch3sc7_b8498fba:

#   el "We got lucky, and you know it!"
    el "Tivemos sorte, e você sabe disso!"

# game/chapters/chapter3/script/ch3sc7.rpy:72
translate brazil ch3sc7_b1305ae8:

#   mc "*Chuckles* The only lucky one was you, having me there to gain us entry."
    mc "*Risos* O único sortudo foi você, por me ter lá para garantir a nossa entrada."

# game/chapters/chapter3/script/ch3sc7.rpy:74
translate brazil ch3sc7_63390697:

#   el "Yeah right! You wouldn't have gotten us anywhere if it hadn't been for my teachings!"
    el "É mesmo! Você não teria nos levado a lugar nenhum se não fossem meus ensinamentos!"

# game/chapters/chapter3/script/ch3sc7.rpy:76
translate brazil ch3sc7_f05d5f9d:

#   el "Without me, you'd probably be in the dungeons right now for trying to fool the gate guard!"
    el "Sem mim, você provavelmente estaria nas masmorras agora por tentar enganar o guarda do portão!"

# game/chapters/chapter3/script/ch3sc7.rpy:78
translate brazil ch3sc7_191d5601:

#   mc "Alright, alright... we both played a part in handling the guard."
    mc "Muito bem, muito bem... nós dois tivemos nossa participação em lidar com o guarda."

# game/chapters/chapter3/script/ch3sc7.rpy:80
translate brazil ch3sc7_a8a1cedd:

#   sy "Bickering and making up in one go? Magnificient! Rare amongst humans, rare indeed."
    sy "Discutir e fazer as pazes de uma só vez? Magnífico! Raro entre os humanos, muito raro mesmo."

# game/chapters/chapter3/script/ch3sc7.rpy:82
translate brazil ch3sc7_b6d942a3:

#   sy "*Giggles* Go on, you two."
    sy "*Risos* Vão em frente, vocês dois."

# game/chapters/chapter3/script/ch3sc7.rpy:83
translate brazil ch3sc7_ca0aef2c:

#   sy "Don’t keep the stable keeper waiting!"
    sy "Não faça o tratador de cavalos esperar!"

# game/chapters/chapter3/script/ch3sc7.rpy:85
translate brazil ch3sc7_f6bf8774:

#   mc "See you soon, Sylph. Keep that coin ready."
    mc "Até breve, Sylph. Mantenha essa moeda à mão."

# game/chapters/chapter3/script/ch3sc7.rpy:86
translate brazil ch3sc7_12f28ec5:

#   el "We'll have this sorted in the blink of an eye! Mh-hm!"
    el "Resolveremos isso num piscar de olhos! Hum-hum!"

# game/chapters/chapter3/script/ch3sc7.rpy:87
translate brazil ch3sc7_0284a202:

#   sy "Great to hear! Head out the southern city-gate and you'll find the stable about two miles to the west."
    sy "Que ótimo saber! Saia pelo portão sul da cidade e você encontrará o estábulo a cerca de três quilômetros a oeste."

# game/chapters/chapter3/script/ch3sc7.rpy:89
translate brazil ch3sc7_36986ba2:

#   syt ". .. ..."
    syt "..."

# game/chapters/chapter3/script/ch3sc7.rpy:90
translate brazil ch3sc7_80b1a8ff:

#   syt "I know Dalen says it’s forbidden to get involved with recruits."
    syt "Eu sei que Dalen diz que é proibido se envolver com recrutas."

# game/chapters/chapter3/script/ch3sc7.rpy:92
translate brazil ch3sc7_273bf554:

#   syt "But he's confident, ambitious, and not to mention... incredibly handsome!"
    syt "Mas ele é confiante, ambicioso e, sem falar... incrivelmente bonito!"

# game/chapters/chapter3/script/ch3sc7.rpy:93
translate brazil ch3sc7_361ead09:

#   syt "Seems like Earth-Mother finally answered my prayers! No more solo Sylph! Heheh-Heeh!"
    syt "Parece que a Mãe Terra finalmente atendeu às minhas preces! Chega de Sylph sozinha! Heheh-Heeh!"

# game/chapters/chapter3/script/ch3sc7.rpy:95
translate brazil ch3sc7_371aac70:

#   syt "Ahh, the way his steely blue eyes pierced my soul!"
    syt "Ah, como aqueles olhos azuis penetrantes me atingiram a alma!"

# game/chapters/chapter3/script/ch3sc7.rpy:97
translate brazil ch3sc7_7e783617:

#   syt "I’m sorry, Dalen, but I want to get to know this one!"
    syt "Sinto muito, Dalen, mas quero conhecer essa pessoa!"

# game/chapters/chapter3/script/ch3sc7.rpy:98
translate brazil ch3sc7_fe15a371:

#   syt "His magic is so... overwhelming!"
    syt "A magia dele é tão... avassaladora!"

# game/chapters/chapter3/script/ch3sc7.rpy:99
translate brazil ch3sc7_18393f4a:

#   syt "I've never encountered a human that had such a powerful magical essence."
    syt "Nunca encontrei um ser humano que possuísse uma essência mágica tão poderosa."

# game/chapters/chapter3/script/ch3sc7.rpy:101
translate brazil ch3sc7_d7eb9a6d:

#   syt "I’ll just have to break a few rules, won’t I?"
    syt "Vou ter que quebrar algumas regras, não é?"

# game/chapters/chapter3/script/ch3sc7.rpy:102
translate brazil ch3sc7_d64e7542:

#   syt "*Snickers* Heh-Heeeeh."
    syt "*Risos* Heh-Heeeeh."

