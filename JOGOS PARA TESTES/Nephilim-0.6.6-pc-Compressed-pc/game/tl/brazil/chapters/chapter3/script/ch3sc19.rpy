# ARQUIVO: game/chapters/chapter3/script/ch3sc19.rpy DIALOGOS: 31


# game/chapters/chapter3/script/ch3sc19.rpy:10
translate brazil ch3sc19_d5ab3a81:

#   fy "We’re here guys!"
    fy "Chegamos, pessoal!"

# game/chapters/chapter3/script/ch3sc19.rpy:11
translate brazil ch3sc19_8abea35f:

#   fy "I proudly present, Luxenford!"
    fy "Apresento com orgulho: Luxenford!"

# game/chapters/chapter3/script/ch3sc19.rpy:13
translate brazil ch3sc19_1f347e11:

#   sa "We actually made it!"
    sa "Nós conseguimos!"

# game/chapters/chapter3/script/ch3sc19.rpy:15
translate brazil ch3sc19_e401a863:

#   fy "You ever doubted me, sis?"
    fy "Você alguma vez duvidou de mim, mana?"

# game/chapters/chapter3/script/ch3sc19.rpy:17
translate brazil ch3sc19_62b70743:

#   sa "Nooo... Not at all dear brother."
    sa "Não... De jeito nenhum, meu caro irmão."

# game/chapters/chapter3/script/ch3sc19.rpy:18
translate brazil ch3sc19_96f54a76:

#   sa "I had the utmost faith in your navigation skills given that we... traveled here by the main road!"
    sa "Eu tinha total confiança em suas habilidades de navegação, visto que... viajamos até aqui pela estrada principal!"

# game/chapters/chapter3/script/ch3sc19.rpy:20
translate brazil ch3sc19_fa445762:

#   al "C’mon, you two!"
    al "Vamos lá, vocês dois!"

# game/chapters/chapter3/script/ch3sc19.rpy:21
translate brazil ch3sc19_307e846f:

#   al "Quit dilly-dallying. We can’t stand here all day!"
    al "Pare de enrolar. Não podemos ficar aqui o dia todo!"

# game/chapters/chapter3/script/ch3sc19.rpy:23
translate brazil ch3sc19_28aaacef:

#   sa "W-Wait up, Alice!"
    sa "E-Espere, Alice!"

# game/chapters/chapter3/script/ch3sc19.rpy:25
translate brazil ch3sc19_7366b7e6:

#   fyt "I suppose I’ll let them do their thing. I'd better hurry and enlist with the Seafarer’s guild!"
    fyt "Acho que vou deixá-los fazer o que quiserem. É melhor eu me apressar e me alistar na guilda dos marinheiros!"

# game/chapters/chapter3/script/ch3sc19.rpy:26
translate brazil ch3sc19_aa503af7:

#   fyt "Who knows? They might even have a ship ready for me. Captain Flynn, imagine that!"
    fyt "Quem sabe? Talvez até já tenham um navio pronto para mim. Capitão Flynn, imagine só!"

# game/chapters/chapter3/script/ch3sc19.rpy:30
translate brazil ch3sc19_83f59496:

#   sa "So, Alice..."
    sa "Então, Alice..."

# game/chapters/chapter3/script/ch3sc19.rpy:31
translate brazil ch3sc19_add8eff1:

#   sa "What’s the first thing you’ll do when you see [mc]?"
    sa "Qual a primeira coisa que você fará quando vir [mc]?"

# game/chapters/chapter3/script/ch3sc19.rpy:33
translate brazil ch3sc19_2b59e53c:

#   al "I haven’t thought about it..."
    al "Eu não pensei nisso..."

# game/chapters/chapter3/script/ch3sc19.rpy:35
translate brazil ch3sc19_04db0075:

#   sa "Oh? You haven’t thought about running into his arms, having him embrace you as your lips meet?"
    sa "Ah, é? Você nunca pensou em correr para os braços dele, ser abraçada por ele e seus lábios se encontrarem?"

# game/chapters/chapter3/script/ch3sc19.rpy:36
translate brazil ch3sc19_43a49cb1:

#   sa "How it'll be just like you've never left each others side. You haven't thought about that the entire journey here?"
    sa "Como se nunca tivessem se separado. Você não pensou nisso durante toda a viagem até aqui?"

# game/chapters/chapter3/script/ch3sc19.rpy:40
translate brazil ch3sc19_dad51c83:

#   al_t "Why does it feel like she reads my every thought?!"
    al_t "Por que tenho a sensação de que ela lê todos os meus pensamentos?!"

# game/chapters/chapter3/script/ch3sc19.rpy:42
translate brazil ch3sc19_b812bfa3:

#   al "Don’t be silly, Sabrina..."
    al "Não seja boba, Sabrina..."

# game/chapters/chapter3/script/ch3sc19.rpy:44
translate brazil ch3sc19_4d46360f:

#   sa "Alice, this is your chance to finally show him what he means to you. That it’s not just a childhood crush!"
    sa "Alice, esta é a sua chance de finalmente mostrar a ele o que ele significa para você. Que não é apenas uma paixão de infância!"

# game/chapters/chapter3/script/ch3sc19.rpy:45
translate brazil ch3sc19_666cf751:

#   sa "Just grab fate by the balls and do it."
    sa "Simplesmente agarre o destino pelos testículos e faça."

# game/chapters/chapter3/script/ch3sc19.rpy:47
translate brazil ch3sc19_9baf4839:

#   al "I know... I know. I’m just not sure how to go about it yet, you know?"
    al "Eu sei... eu sei. Só não tenho certeza de como fazer isso ainda, sabe?"

# game/chapters/chapter3/script/ch3sc19.rpy:48
translate brazil ch3sc19_9f098673:

#   al "What if I mess up our entire friendship because I’m being silly?"
    al "E se eu estragar toda a nossa amizade por estar sendo boba?"

# game/chapters/chapter3/script/ch3sc19.rpy:50
translate brazil ch3sc19_e9545a4a:

#   sa "Fat chance!"
    sa "Nem pensar!"

# game/chapters/chapter3/script/ch3sc19.rpy:51
translate brazil ch3sc19_334a8293:

#   sa "There’s absolutely no way telling him how you feel will ruin your friendship."
    sa "Não há absolutamente nenhuma chance de que contar a ele como você se sente arruine a amizade de vocês."

# game/chapters/chapter3/script/ch3sc19.rpy:52
translate brazil ch3sc19_9891526b:

#   sa "[mc]'s a man, you having feelings for him won't scare him away, even if he somehow does not feel the same."
    sa "[mc]'Para um homem, o fato de você ter sentimentos por ele não o afastará, mesmo que, de alguma forma, ele não sinta o mesmo."

# game/chapters/chapter3/script/ch3sc19.rpy:55
translate brazil ch3sc19_5347af31:

#   al_t "That does sound comforting... I don't want to lose him."
    al_t "Isso parece reconfortante... Não quero perdê-lo."

# game/chapters/chapter3/script/ch3sc19.rpy:57
translate brazil ch3sc19_542c4a7b:

#   al "*Sigh* I hope you’re right..."
    al "*Suspiro* Espero que você esteja certo..."

# game/chapters/chapter3/script/ch3sc19.rpy:59
translate brazil ch3sc19_45ad7636:

#   sa "Sweetie, I'm always right."
    sa "Querida, eu sempre tenho razão."

# game/chapters/chapter3/script/ch3sc19.rpy:60
translate brazil ch3sc19_5ec26eb9:

#   sa "Let's go checkout some stores and find the academy of learning."
    sa "Vamos dar uma olhada em algumas lojas e encontrar a academia de aprendizagem."

# game/chapters/chapter3/script/ch3sc19.rpy:62
translate brazil ch3sc19_38e8f957:

#   al "Sounds good!"
    al "Parece bom!"

# game/chapters/chapter3/script/ch3sc19.rpy:63
translate brazil ch3sc19_5615a6a0:

#   al "We should probably find a place where we can grab some food as well, I'm famished!"
    al "Provavelmente deveríamos encontrar um lugar onde possamos comprar comida também, estou faminto!"

