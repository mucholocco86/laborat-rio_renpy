# ARQUIVO: game/chapters/chapter3/script/ch3sc26.rpy DIALOGOS: 18


# game/chapters/chapter3/script/ch3sc26.rpy:10
translate brazil ch3sc26_6fc87384:

#   uk "Sir, the target has completed the second quest."
    uk "Senhor, o alvo completou a segunda missão."

# game/chapters/chapter3/script/ch3sc26.rpy:11
translate brazil ch3sc26_d6c84f93:

#   uk "Just as you suspected, Dalen assigned them to the goblins."
    uk "Como você suspeitava, Dalen os designou aos goblins."

# game/chapters/chapter3/script/ch3sc26.rpy:13
translate brazil ch3sc26_dc2c58f0:

#   ta "Of course he did..."
    ta "É claro que sim..."

# game/chapters/chapter3/script/ch3sc26.rpy:14
translate brazil ch3sc26_8d66f639:

#   ta "I know him well."
    ta "Eu o conheço bem."

# game/chapters/chapter3/script/ch3sc26.rpy:16
translate brazil ch3sc26_f150bdcc:

#   uk "Sir, how did you know he would assign them?"
    uk "Senhor, como o senhor sabia que ele os designaria?"

# game/chapters/chapter3/script/ch3sc26.rpy:18
translate brazil ch3sc26_483da1ee:

#   ta "It’s simple. Dalen sees potential in him."
    ta "É simples. Dalen vê potencial nele."

# game/chapters/chapter3/script/ch3sc26.rpy:19
translate brazil ch3sc26_f27240a6:

#   ta "So, all I had to do was devise a scenario where his abilities could be tested."
    ta "Então, tudo o que eu precisava fazer era criar um cenário onde suas habilidades pudessem ser testadas."

# game/chapters/chapter3/script/ch3sc26.rpy:21
translate brazil ch3sc26_48fc11bb:

#   uk "Clever, sir."
    uk "Inteligente, senhor."

# game/chapters/chapter3/script/ch3sc26.rpy:22
translate brazil ch3sc26_03787059:

#   uk "Should we still proceed as planned?"
    uk "Devemos prosseguir conforme planejado?"

# game/chapters/chapter3/script/ch3sc26.rpy:24
translate brazil ch3sc26_5d5d8551:

#   ta "Yes. The time for idling has passed... it’s time to act."
    ta "Sim. O tempo de ficar parado já passou... é hora de agir."

# game/chapters/chapter3/script/ch3sc26.rpy:25
translate brazil ch3sc26_c83261b0:

#   ta "Don’t disappoint me."
    ta "Não me decepcione."

# game/chapters/chapter3/script/ch3sc26.rpy:26
translate brazil ch3sc26_799a6dbd:

#   ta "You know what happens to those who do."
    ta "Você sabe o que acontece com quem faz isso."

# game/chapters/chapter3/script/ch3sc26.rpy:28
translate brazil ch3sc26_45a5a434:

#   uk "S-Sir!"
    uk "S-Senhor!"

# game/chapters/chapter3/script/ch3sc26.rpy:30
translate brazil ch3sc26_10020388:

#   ta "Go inform our little dove, make sure to remind her what happens if she doesn't play her part to perfection."
    ta "Vá informar nossa pequena pomba, certifique-se de lembrá-la do que acontece se ela não desempenhar seu papel com perfeição."

# game/chapters/chapter3/script/ch3sc26.rpy:31
translate brazil ch3sc26_712d9375:

#   ta "Cold feet is not an option if she wants to protect what matters most to her."
    ta "Ceder ao medo não é uma opção se ela quiser proteger o que é mais importante para ela."

# game/chapters/chapter3/script/ch3sc26.rpy:33
translate brazil ch3sc26_bf4e18fc:

#   uk "S-Sir! I'll instruct the bitch at once!"
    uk "Senhor! Vou instruir a cadela imediatamente!"

# game/chapters/chapter3/script/ch3sc26.rpy:34
translate brazil ch3sc26_ad5413a1:

#   uk "She'll comply or we'll turn up the heat on her sist-"
    uk "Ela vai obedecer ou vamos aumentar a pressão sobre a irmã dela."

# game/chapters/chapter3/script/ch3sc26.rpy:36
translate brazil ch3sc26_545aafc8:

#   ta "Leave. Just get it done."
    ta "Vá embora. Simplesmente termine o que está fazendo."

