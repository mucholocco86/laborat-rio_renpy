# ARQUIVO: game/chapters/chapter3/script/ch3sc20.rpy DIALOGOS: 108


# game/chapters/chapter3/script/ch3sc20.rpy:9
translate brazil ch3sc20_9880c641:

#   el "Last night was fun!"
    el "A noite passada foi divertida!"

# game/chapters/chapter3/script/ch3sc20.rpy:11
translate brazil ch3sc20_d4cf24bb:

#   mc "Knowing you, you’ll want to do it again..."
    mc "Conhecendo você, sei que você vai querer fazer isso de novo..."

# game/chapters/chapter3/script/ch3sc20.rpy:13
translate brazil ch3sc20_dfad66ea:

#   el "You bet! Don’t pretend you didn’t enjoy a relaxing night with friends and ales."
    el "Pode apostar! Não finja que você não curtiu uma noite relaxante com amigos e cerveja."

# game/chapters/chapter3/script/ch3sc20.rpy:15
translate brazil ch3sc20_fd75ba57:

#   mc "I admit it was kind of refreshing."
    mc "Admito que foi meio revigorante."

# game/chapters/chapter3/script/ch3sc20.rpy:16
translate brazil ch3sc20_ee7a33c3:

#   mc "Borri and Selena. They..."
    mc "Borri e Selena. Eles..."

# game/chapters/chapter3/script/ch3sc20.rpy:21
translate brazil ch3sc20_76b7cb86:

#   "{color=#87e1fa}Light Morality{/color} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "{color=#87e1fa}Moralidade Leve{/color} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc20.rpy:24
translate brazil ch3sc20_ead55ce4:

#   elt "I was hoping he'd feel that way, he's really come a long way."
    elt "Eu esperava que ele se sentisse assim, ele realmente percorreu um longo caminho."

# game/chapters/chapter3/script/ch3sc20.rpy:26
translate brazil ch3sc20_c93e216d:

#   el "I knew you liked them!"
    el "Eu sabia que você gostava deles!"

# game/chapters/chapter3/script/ch3sc20.rpy:27
translate brazil ch3sc20_a96b5063:

#   el "I can tell that you and Borri get along like brothers!"
    el "Dá para perceber que você e o Borri se dão como irmãos!"

# game/chapters/chapter3/script/ch3sc20.rpy:29
translate brazil ch3sc20_9a68b5e0:

#   mc "I’m an only child, but I suppose Borri is what I imagine having a brother would be like."
    mc "Sou filha única, mas acho que Borri é como eu imagino que seria ter um irmão."

# game/chapters/chapter3/script/ch3sc20.rpy:31
translate brazil ch3sc20_c754f667:

#   el "I’m happy to see you like this."
    el "Fico feliz em te ver assim."

# game/chapters/chapter3/script/ch3sc20.rpy:32
translate brazil ch3sc20_5a9539c7:

#   el "Remember we talked about what comes next after we accomplish our goal?"
    el "Lembra quando conversamos sobre o que acontece depois de alcançarmos nosso objetivo?"

# game/chapters/chapter3/script/ch3sc20.rpy:34
translate brazil ch3sc20_b71b4057:

#   el "Making friends will be a big part of that."
    el "Fazer amigos será uma parte importante disso."

# game/chapters/chapter3/script/ch3sc20.rpy:36
translate brazil ch3sc20_e5544801:

#   mc "I get it."
    mc "Entendo."

# game/chapters/chapter3/script/ch3sc20.rpy:37
translate brazil ch3sc20_223264cd:

#   mc "You won’t let me be a loner forever..."
    mc "Você não vai me deixar ficar sozinho para sempre..."

# game/chapters/chapter3/script/ch3sc20.rpy:39
translate brazil ch3sc20_12a6ebb9:

#   el "*Giggles* Finally, you're starting to understand!"
    el "*Risos* Finalmente, você está começando a entender!"

# game/chapters/chapter3/script/ch3sc20.rpy:41
translate brazil ch3sc20_bae8ce37:

#   el "Let's find Sylph and see what she has for us today."
    el "Vamos encontrar Sylph e ver o que ela tem para nós hoje."

# game/chapters/chapter3/script/ch3sc20.rpy:45
translate brazil ch3sc20_3908a603:

#   "{color=#f00}Dark Morality{/color} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "{color=#f00}Moralidade Sombria{/color} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc20.rpy:48
translate brazil ch3sc20_122f2c85:

#   elt "I was hoping he'd have begun to consider them friends..."
    elt "Eu esperava que ele começasse a considerá-los amigos..."

# game/chapters/chapter3/script/ch3sc20.rpy:49
translate brazil ch3sc20_5af7db71:

#   elt "I don't think keeping everyone at arms length will do him any good."
    elt "Não acho que manter todos à distância vá lhe fazer bem algum."

# game/chapters/chapter3/script/ch3sc20.rpy:51
translate brazil ch3sc20_0e030e79:

#   el "*Sigh* You know you'll need friends down the line, right?"
    el "*Suspiro* Você sabe que vai precisar de amigos mais para frente, né?"

# game/chapters/chapter3/script/ch3sc20.rpy:53
translate brazil ch3sc20_835f1a36:

#   mc "I’m fine..."
    mc "Estou bem..."

# game/chapters/chapter3/script/ch3sc20.rpy:55
translate brazil ch3sc20_8a7c4f27:

#   el "For now."
    el "Por agora."

# game/chapters/chapter3/script/ch3sc20.rpy:56
translate brazil ch3sc20_2eea6adf:

#   el "But I worry about you..."
    el "Mas eu me preocupo com você..."

# game/chapters/chapter3/script/ch3sc20.rpy:57
translate brazil ch3sc20_29c573bf:

#   el "If you close yourself off from everyone, nothing good comes from that."
    el "Se você se isolar de todos, nada de bom virá disso."

# game/chapters/chapter3/script/ch3sc20.rpy:58
translate brazil ch3sc20_0d789b74:

#   el "It'll lead to darkness... despair... loneliness."
    el "Isso levará à escuridão... ao desespero... à solidão."

# game/chapters/chapter3/script/ch3sc20.rpy:60
translate brazil ch3sc20_2451cc8d:

#   mc "Are you done? We have a quest to pick up."
    mc "Você terminou? Temos uma missão para retomar."

# game/chapters/chapter3/script/ch3sc20.rpy:62
translate brazil ch3sc20_3e30675e:

#   el "Yeah, yeah... Let’s go."
    el "Sim, sim... Vamos lá."

# game/chapters/chapter3/script/ch3sc20.rpy:63
translate brazil ch3sc20_e049ff65:

#   el "We'll visit this topic again, though."
    el "Voltaremos a abordar esse assunto mais tarde."

# game/chapters/chapter3/script/ch3sc20.rpy:64
translate brazil ch3sc20_34350269:

#   el "You know I'm more stubborn than you."
    el "Você sabe que eu sou mais teimoso do que você."

# game/chapters/chapter3/script/ch3sc20.rpy:66
translate brazil ch3sc20_2c9f7e58:

#   mc "*Sigh* I've noticed."
    mc "*Suspiro* Eu percebi."

# game/chapters/chapter3/script/ch3sc20.rpy:69
translate brazil ch3sc20_a9c8c5a2:

#   el "Hmm... I don’t see Sylph anywhere."
    el "Hum... Não vejo Sylph em lugar nenhum."

# game/chapters/chapter3/script/ch3sc20.rpy:71
translate brazil ch3sc20_b093c633:

#   el "The Guild hall looks empty."
    el "O salão da guilda parece vazio."

# game/chapters/chapter3/script/ch3sc20.rpy:72
translate brazil ch3sc20_c62ad03d:

#   el "I guess the Guild really has been having trouble getting contracts lately."
    el "Acho que a Guilda realmente tem tido dificuldades para conseguir contratos ultimamente."

# game/chapters/chapter3/script/ch3sc20.rpy:74
translate brazil ch3sc20_c2ac042c:

#   mc "With the two of us, and now Borri as well, I’m sure things will turn around."
    mc "Com nós dois, e agora com o Borri também, tenho certeza de que as coisas vão melhorar."

# game/chapters/chapter3/script/ch3sc20.rpy:75
translate brazil ch3sc20_ef3c7eb1:

#   mc "As the three of us begin completing more and more quests, word will spread."
    mc "À medida que nós três formos completando mais e mais missões, a notícia se espalhará."

# game/chapters/chapter3/script/ch3sc20.rpy:77
translate brazil ch3sc20_52dc9a5c:

#   el "Totally! Completing today's quest will be another step towards a brighter future!"
    el "Com certeza! Concluir a missão de hoje será mais um passo rumo a um futuro melhor!"

# game/chapters/chapter3/script/ch3sc20.rpy:78
translate brazil ch3sc20_fafe9c03:

#   el "If anyone can return the Adventurer’s Guild to its former glory, it's us!"
    el "Se alguém pode devolver à Guilda dos Aventureiros a sua antiga glória, somos nós!"

# game/chapters/chapter3/script/ch3sc20.rpy:80
translate brazil ch3sc20_da5841f9:

#   mc "Someone’s feeling confident. I like it."
    mc "Alguém está se sentindo confiante. Eu gosto disso."

# game/chapters/chapter3/script/ch3sc20.rpy:81
translate brazil ch3sc20_26adf4fe:

#   mc "Now, let’s see if Sylph is anywhere to be found."
    mc "Agora, vamos ver se Sylph está em algum lugar."

# game/chapters/chapter3/script/ch3sc20.rpy:83
translate brazil ch3sc20_7f291fd8:

#   el "Uh-Uh! Allow me to summon her! *Snickers*"
    el "Uh-Uh! Permita-me invocá-la! *Risinhos*"

# game/chapters/chapter3/script/ch3sc20.rpy:86
translate brazil ch3sc20_5329138a:

#   el "{b}*Shouts*{/b} Sylph!"
    el "{b}*Gritos*{/b} Sílfide!"

# game/chapters/chapter3/script/ch3sc20.rpy:87
translate brazil ch3sc20_a06e7cdc:

#   el "{b}*Shouts*{/b} Where are you hiding that cute little Pixie butt of yours?!"
    el "{b}*Gritos*{/b} Onde você está escondendo esse seu bumbum de fada tão fofo?!"

# game/chapters/chapter3/script/ch3sc20.rpy:90
translate brazil ch3sc20_2f8f1d18:

#   sy "Who're you calling a Pixie?! I’m a Fae!"
    sy "Quem você está chamando de Pixie?! Eu sou uma Fae!"

# game/chapters/chapter3/script/ch3sc20.rpy:92
translate brazil ch3sc20_27b84604:

#   sy "Huge difference! Huge!"
    sy "Uma diferença enorme! Enorme!"

# game/chapters/chapter3/script/ch3sc20.rpy:93
translate brazil ch3sc20_81f38f22:

#   sy "Pixies are teeny-tiny! The size of your finger!"
    sy "As fadas são minúsculas! Do tamanho do seu dedo!"

# game/chapters/chapter3/script/ch3sc20.rpy:94
translate brazil ch3sc20_47f3f074:

#   sy "I may be smaller than a human but I'm still big!"
    sy "Posso ser menor que um humano, mas ainda sou grande!"

# game/chapters/chapter3/script/ch3sc20.rpy:96
translate brazil ch3sc20_868f95c6:

#   sy "Oh! Eliza, [mc]!"
    sy "Oh! Eliza, [mc]!"

# game/chapters/chapter3/script/ch3sc20.rpy:97
translate brazil ch3sc20_9761eaa6:

#   sy "Well, well, if it isn’t my two favorite recruits!"
    sy "Ora, ora, se não são meus dois recrutas favoritos!"

# game/chapters/chapter3/script/ch3sc20.rpy:99
translate brazil ch3sc20_551ae8ce:

#   mc "We’re your only recruits."
    mc "Somos seus únicos recrutas."

# game/chapters/chapter3/script/ch3sc20.rpy:101
translate brazil ch3sc20_a73697d3:

#   sy "For now! Hopefully our luck is about to change now that you two have begun completing quests!"
    sy "Por enquanto! Esperamos que nossa sorte mude agora que vocês dois começaram a completar missões!"

# game/chapters/chapter3/script/ch3sc20.rpy:103
translate brazil ch3sc20_bcf0710c:

#   sy "As you've probably noticed, our shelves are rather empty at the moment."
    sy "Como você provavelmente já deve ter percebido, nossas prateleiras estão bem vazias no momento."

# game/chapters/chapter3/script/ch3sc20.rpy:105
translate brazil ch3sc20_45b5fc9e:

#   sy "If you manage to find anything noteworthy while doing quests, be sure to bring it back and we can display it here!"
    sy "Se você encontrar algo interessante durante suas missões, não se esqueça de trazer para que possamos exibir aqui!"

# game/chapters/chapter3/script/ch3sc20.rpy:107
translate brazil ch3sc20_7fa9f0e9:

#   sy "That will help with attracting new recruits!"
    sy "Isso ajudará a atrair novos recrutas!"

# game/chapters/chapter3/script/ch3sc20.rpy:108
translate brazil ch3sc20_b4b69684:

#   sy "If people see our Guild Hall filling out with awesome artifacts and heirlooms, they will surely be impressed!"
    sy "Se as pessoas virem nosso Salão da Guilda se enchendo de artefatos e relíquias incríveis, certamente ficarão impressionadas!"

# game/chapters/chapter3/script/ch3sc20.rpy:110
translate brazil ch3sc20_a9035d6d:

#   el "Makes sense, we'll keep our eyes peeled for anything that would be display worthy!"
    el "Faz sentido, ficaremos de olho em qualquer coisa que possa ser exibida!"

# game/chapters/chapter3/script/ch3sc20.rpy:111
translate brazil ch3sc20_48e5c8c4:

#   el "Speaking of quests, got anything for us today Sylph?"
    el "Por falar em missões, tem alguma para nós hoje, Sylph?"

# game/chapters/chapter3/script/ch3sc20.rpy:113
translate brazil ch3sc20_44c45b54:

#   sy "You betcha!"
    sy "Pode apostar!"

# game/chapters/chapter3/script/ch3sc20.rpy:114
translate brazil ch3sc20_f1ca364a:

#   sy "We actually happen to have two quests today!"
    sy "Por acaso, temos duas missões hoje!"

# game/chapters/chapter3/script/ch3sc20.rpy:117
translate brazil ch3sc20_d3036b7f:

#   el "Great! We’ll take both!"
    el "Ótimo! Vamos levar os dois!"

# game/chapters/chapter3/script/ch3sc20.rpy:119
translate brazil ch3sc20_ad155f09:

#   sy "Love the enthusiasm girl! But you will have to settle for one today."
    sy "Adorei o entusiasmo, garota! Mas hoje você terá que se contentar com apenas um."

# game/chapters/chapter3/script/ch3sc20.rpy:120
translate brazil ch3sc20_91f22be8:

#   sy "I have to keep one quest available for our newest recruit."
    sy "Preciso manter uma missão disponível para o nosso recruta mais novo."

# game/chapters/chapter3/script/ch3sc20.rpy:122
translate brazil ch3sc20_cc146070:

#   mct "She’s talking about Borri."
    mct "Ela está falando sobre Borri."

# game/chapters/chapter3/script/ch3sc20.rpy:124
translate brazil ch3sc20_6e9dc832:

#   sy "So I’ve prepared one of the quests as his introductory task."
    sy "Então, preparei uma das missões como tarefa introdutória para ele."

# game/chapters/chapter3/script/ch3sc20.rpy:126
translate brazil ch3sc20_e18f4aa8:

#   el "Ah, you must be talking about Borri, he’s our friend and we suggested he should join us at the guild."
    el "Ah, você deve estar falando do Borri, ele é nosso amigo e sugerimos que ele se juntasse a nós na guilda."

# game/chapters/chapter3/script/ch3sc20.rpy:128
translate brazil ch3sc20_3cd09ce0:

#   sy "My, my! Completing quests and recruiting new members?"
    sy "Nossa! Completar missões e recrutar novos membros?"

# game/chapters/chapter3/script/ch3sc20.rpy:129
translate brazil ch3sc20_26dc7228:

#   sy "Where have you two been all these years?"
    sy "Onde vocês dois estiveram todos esses anos?"

# game/chapters/chapter3/script/ch3sc20.rpy:131
translate brazil ch3sc20_65ca7153:

#   mc "You’re giving us too much credit, Sylph."
    mc "Você está nos dando crédito demais, Sylph."

# game/chapters/chapter3/script/ch3sc20.rpy:132
translate brazil ch3sc20_c3517675:

#   mc "Borri needed a better way to earn coin, so we suggested the guild."
    mc "Borri precisava de uma maneira melhor de ganhar dinheiro, então sugerimos a guilda."

# game/chapters/chapter3/script/ch3sc20.rpy:134
translate brazil ch3sc20_4f7cc287:

#   sy "Everyone has their own reasons for joining."
    sy "Cada um tem seus próprios motivos para participar."

# game/chapters/chapter3/script/ch3sc20.rpy:135
translate brazil ch3sc20_2ed147b3:

#   sy "Either way, the guild needs more members to stay competitive."
    sy "De qualquer forma, a guilda precisa de mais membros para se manter competitiva."

# game/chapters/chapter3/script/ch3sc20.rpy:137
translate brazil ch3sc20_776e0b8d:

#   mc "Hmm. Makes sense, we wouldn’t want to lose quests or contracts to other guilds."
    mc "Hum. Faz sentido, não gostaríamos de perder missões ou contratos para outras guildas."

# game/chapters/chapter3/script/ch3sc20.rpy:139
translate brazil ch3sc20_5b56268b:

#   sy "Exactly!"
    sy "Exatamente!"

# game/chapters/chapter3/script/ch3sc20.rpy:140
translate brazil ch3sc20_4b7e5dc0:

#   sy "Let me just fetch your contract for today."
    sy "Deixe-me buscar seu contrato de hoje."

# game/chapters/chapter3/script/ch3sc20.rpy:142
translate brazil ch3sc20_d11b9e0b:

#   sy "Here you go!"
    sy "Aqui você vai!"

# game/chapters/chapter3/script/ch3sc20.rpy:144
translate brazil ch3sc20_6b3d710f:

#   el "It says it’s a C-Rank quest?"
    el "Diz que é uma missão de Rank C?"

# game/chapters/chapter3/script/ch3sc20.rpy:145
translate brazil ch3sc20_5db66941:

#   el "But I thought we’re only approved for D-Rank?"
    el "Mas eu pensava que só tínhamos aprovação para a categoria D?"

# game/chapters/chapter3/script/ch3sc20.rpy:147
translate brazil ch3sc20_1d0c44f6:

#   sy "Yes, normally you’d have to rank up by completing several D-Rank contracts before receiving this."
    sy "Sim, normalmente você precisaria subir de nível completando vários contratos de Rank D antes de receber isso."

# game/chapters/chapter3/script/ch3sc20.rpy:148
translate brazil ch3sc20_ff397ae6:

#   sy "But Dalen has a feeling you two will be able to complete it."
    sy "Mas Dalen tem a sensação de que vocês dois conseguirão concluir isso."

# game/chapters/chapter3/script/ch3sc20.rpy:149
translate brazil ch3sc20_cabd1faa:

#   sy "And if you do manage to complete it, you will officially be C-Rank Adventurers!"
    sy "E se vocês conseguirem completar, serão oficialmente Aventureiros de Rank C!"

# game/chapters/chapter3/script/ch3sc20.rpy:151
translate brazil ch3sc20_7713d1f5:

#   mc "We’ll take it."
    mc "Aceitaremos."

# game/chapters/chapter3/script/ch3sc20.rpy:152
translate brazil ch3sc20_7955e2d6:

#   el "*Nods approvingly* Mh-hm!"
    el "*Acena com a cabeça em aprovação* Hum-hum!"

# game/chapters/chapter3/script/ch3sc20.rpy:154
translate brazil ch3sc20_31f84e70:

#   elt "Hmm... This feels a little soon, it’s only our 2nd quest."
    elt "Hum... Parece um pouco cedo, é apenas a nossa segunda missão."

# game/chapters/chapter3/script/ch3sc20.rpy:155
translate brazil ch3sc20_d7d457a7:

#   elt "But I’ve got [mc] with me, it should be fine."
    elt "Mas eu tenho [mc] Comigo, tudo deve correr bem."

# game/chapters/chapter3/script/ch3sc20.rpy:157
translate brazil ch3sc20_cf0ec2b0:

#   el "So what is this quest about, Sylph?"
    el "Então, do que se trata essa missão, Sylph?"

# game/chapters/chapter3/script/ch3sc20.rpy:158
translate brazil ch3sc20_78bd72ff:

#   el "If it's C-Rank, we need some info, going in blind would be dangerous."
    el "Se for de nível C, precisamos de algumas informações; entrar sem nenhuma informação seria perigoso."

# game/chapters/chapter3/script/ch3sc20.rpy:160
translate brazil ch3sc20_ff20a128:

#   sy "Oh right!"
    sy "Ah, sim!"

# game/chapters/chapter3/script/ch3sc20.rpy:161
translate brazil ch3sc20_66d8e30e:

#   sy "Silly me, I almost forgot to inform you! There’s some abandoned ruins to the east of Luxenford."
    sy "Que bobeira a minha, quase me esqueci de te avisar! Há algumas ruínas abandonadas a leste de Luxenford."

# game/chapters/chapter3/script/ch3sc20.rpy:163
translate brazil ch3sc20_5ba59a65:

#   sy "A scout reported that a group of goblins have set up camp within the ruins..."
    sy "Um batedor relatou que um grupo de goblins montou acampamento nas ruínas..."

# game/chapters/chapter3/script/ch3sc20.rpy:165
translate brazil ch3sc20_19113da2:

#   mc "Let me guess... they’re terrorizing the nearby villages and travelers?"
    mc "Deixe-me adivinhar... eles estão aterrorizando as aldeias vizinhas e os viajantes?"

# game/chapters/chapter3/script/ch3sc20.rpy:167
translate brazil ch3sc20_1c7fb345:

#   sy "Yes!! And it's horrible. They're nasty creatures."
    sy "Sim!! E é horrível. São criaturas repugnantes."

# game/chapters/chapter3/script/ch3sc20.rpy:168
translate brazil ch3sc20_338ed118:

#   sy "They attack anyone who comes across them."
    sy "Eles atacam qualquer um que cruze o seu caminho."

# game/chapters/chapter3/script/ch3sc20.rpy:169
translate brazil ch3sc20_398ee931:

#   sy "I-I... It’s horrible what they’ve done, they eat people... and they... breed the women they capture-"
    sy "II... É horrível o que eles fizeram, eles comem pessoas... e... engravidam as mulheres que capturam-"

# game/chapters/chapter3/script/ch3sc20.rpy:171
translate brazil ch3sc20_cff45a48:

#   mc "It’s alright, Sylph... you don’t need to tell us anymore."
    mc "Está tudo bem, Sylph... você não precisa nos contar mais nada."

# game/chapters/chapter3/script/ch3sc20.rpy:172
translate brazil ch3sc20_f027bc70:

#   mc "I’ve dealt with goblins before... disgusting creatures."
    mc "Já lidei com goblins antes... criaturas repugnantes."

# game/chapters/chapter3/script/ch3sc20.rpy:174
translate brazil ch3sc20_24838a20:

#   mc "Consider the contract completed by nightfall, Sylph."
    mc "Considere o contrato concluído ao anoitecer, Sylph."

# game/chapters/chapter3/script/ch3sc20.rpy:176
translate brazil ch3sc20_4c1f83d3:

#   sy "So soon?!"
    sy "Tão cedo?!"

# game/chapters/chapter3/script/ch3sc20.rpy:177
translate brazil ch3sc20_706537a8:

#   sy "That would be amazing! Please be careful, guys."
