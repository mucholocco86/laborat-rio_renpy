# ARQUIVO: game/chapters/chapter3/script/ch3sc4.rpy DIALOGOS: 38


# game/chapters/chapter3/script/ch3sc4.rpy:7
translate brazil ch3sc4_d1a258ff:

#   "Back on the streets of the capital..."
    "De volta às ruas da capital..."

# game/chapters/chapter3/script/ch3sc4.rpy:10
translate brazil ch3sc4_8c0464a6:

#   el "This is so exciting! I can’t believe we are official members of the guild now!"
    el "Que emocionante! Não acredito que agora somos membros oficiais da guilda!"

# game/chapters/chapter3/script/ch3sc4.rpy:11
translate brazil ch3sc4_d14773cd:

#   el "I'm surprised we got accepted so easily."
    el "Estou surpreso por termos sido aceitos com tanta facilidade."

# game/chapters/chapter3/script/ch3sc4.rpy:13
translate brazil ch3sc4_3249be18:

#   mc "Well, given their current situation, it would have been foolish of him to decline us."
    mc "Bem, dada a situação atual deles, teria sido insensato da parte dele nos recusar."

# game/chapters/chapter3/script/ch3sc4.rpy:14
translate brazil ch3sc4_400b4ed9:

#   mc "Sounds like the guild need all the help it can get."
    mc "Parece que a guilda precisa de toda a ajuda possível."

# game/chapters/chapter3/script/ch3sc4.rpy:16
translate brazil ch3sc4_2b0bf8c2:

#   el "I think he accepted us 'cause he could sense we'll become great adventurers!"
    el "Acho que ele nos aceitou porque pressentiu que nos tornaríamos grandes aventureiros!"

# game/chapters/chapter3/script/ch3sc4.rpy:18
translate brazil ch3sc4_bf42f129:

#   mc "Only time will tell."
    mc "Só o tempo dirá."

# game/chapters/chapter3/script/ch3sc4.rpy:19
translate brazil ch3sc4_e88aed91:

#   mc "Either way, we should watch out for anything that could be connected to the recruiting issue or the kidnappings."
    mc "De qualquer forma, devemos ficar atentos a qualquer coisa que possa estar relacionada ao problema do recrutamento ou aos sequestros."

# game/chapters/chapter3/script/ch3sc4.rpy:21
translate brazil ch3sc4_e1d68d24:

#   el "Right! First we should get our equipment checked and prepared."
    el "Certo! Primeiro, precisamos verificar e preparar nosso equipamento."

# game/chapters/chapter3/script/ch3sc4.rpy:22
translate brazil ch3sc4_f55dfa44:

#   el "Then we can head back to Sylph."
    el "Então poderemos voltar para Sylph."

# game/chapters/chapter3/script/ch3sc4.rpy:24
translate brazil ch3sc4_82eebd75:

#   el "Dalen said she would have a quest ready for us."
    el "Dalen disse que teria uma missão preparada para nós."

# game/chapters/chapter3/script/ch3sc4.rpy:25
translate brazil ch3sc4_322ff088:

#   el "I can't wait to see what it is! This is so exciting!"
    el "Mal posso esperar para ver o que é! Que emocionante!"

# game/chapters/chapter3/script/ch3sc4.rpy:27
translate brazil ch3sc4_677b9534:

#   mct "*Chuckles* It’s cute how excited she seems to be about getting a quest."
    mct "*Risos* É engraçado como ela parece animada por ter recebido uma missão."

# game/chapters/chapter3/script/ch3sc4.rpy:31
translate brazil ch3sc4_16432324:

#   mct "I'm glad I'm able to share this moment with her."
    mct "Fico feliz por poder compartilhar este momento com ela."

# game/chapters/chapter3/script/ch3sc4.rpy:32
translate brazil ch3sc4_edcb5c96:

#   mct "We've come a long way already."
    mct "Já percorremos um longo caminho."

# game/chapters/chapter3/script/ch3sc4.rpy:38
translate brazil ch3sc4_d7d43e1c:

#   el "Careful, [mc]."
    el "Cuidadoso, [mc]."

# game/chapters/chapter3/script/ch3sc4.rpy:40
translate brazil ch3sc4_74f342c8:

#   mc "Mh?"
    mc "Hum?"

# game/chapters/chapter3/script/ch3sc4.rpy:42
translate brazil ch3sc4_0191b111:

#   el "Holding a girl's hand in public?"
    el "Dar as mãos a uma garota em público?"

# game/chapters/chapter3/script/ch3sc4.rpy:43
translate brazil ch3sc4_40b3513d:

#   el "Keep doing things like this, and a girl might think you like her."
    el "Continue fazendo coisas assim, e uma garota pode pensar que você gosta dela."

# game/chapters/chapter3/script/ch3sc4.rpy:45
translate brazil ch3sc4_68996d76:

#   mc "A girl might be right."
    mc "Uma garota pode estar certa."

# game/chapters/chapter3/script/ch3sc4.rpy:47
translate brazil ch3sc4_1ca6aabe:

#   el "A girl is always right! *Giggling*"
    el "Uma garota sempre tem razão! *Risos*"

# game/chapters/chapter3/script/ch3sc4.rpy:48
translate brazil ch3sc4_7b896a7b:

#   el "And she thinks you should..."
    el "E ela acha que você deveria..."

# game/chapters/chapter3/script/ch3sc4.rpy:50
translate brazil ch3sc4_bc3569f3:

#   el "You should keep doing it!"
    el "Você deve continuar fazendo isso!"

# game/chapters/chapter3/script/ch3sc4.rpy:51
translate brazil ch3sc4_a4be5839:

#   el "Yes, that would definitely be the right thing to do..."
    el "Sim, com certeza seria a coisa certa a fazer..."

# game/chapters/chapter3/script/ch3sc4.rpy:53
translate brazil ch3sc4_0e3a66e0:

#   mc "Don’t worry."
    mc "Não se preocupe."

# game/chapters/chapter3/script/ch3sc4.rpy:54
translate brazil ch3sc4_31892147:

#   mc "I’m not letting go of this cute little hand of yours... it belongs to me now."
    mc "Não vou soltar essa sua mãozinha fofa... ela me pertence agora."

# game/chapters/chapter3/script/ch3sc4.rpy:56
translate brazil ch3sc4_43df6a9e:

#   el "You say the silliest things."
    el "Você diz as coisas mais bobas."

# game/chapters/chapter3/script/ch3sc4.rpy:57
translate brazil ch3sc4_3f8a5dbe:

#   "Eliza feels great comfort in holding your hand, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Eliza sente grande conforto ao segurar sua mão, e sua confiança aumentou. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc4.rpy:58
translate brazil ch3sc4_25f555be:

#   el "Come on, let’s go. I’m intrigued to find out more about our first quest!"
    el "Vamos lá! Estou curioso para saber mais sobre nossa primeira missão!"

# game/chapters/chapter3/script/ch3sc4.rpy:60
translate brazil ch3sc4_8a271ca9:

#   mc "Honestly, I’m looking forward to it as well."
    mc "Sinceramente, eu também estou ansioso por isso."

# game/chapters/chapter3/script/ch3sc4.rpy:62
translate brazil ch3sc4_dd3e11c4:

#   el "What do you think it'll be? Helping a cat out of a tree? Returning chickens to their owner?"
    el "O que você acha que vai ser? Ajudar um gato a descer de uma árvore? Devolver galinhas ao dono?"

# game/chapters/chapter3/script/ch3sc4.rpy:63
translate brazil ch3sc4_82b98f3a:

#   el "No, it has to be more involved than that, it's our recruitment quest!"
    el "Não, tem que ser algo mais complexo do que isso, é a nossa busca por recrutamento!"

# game/chapters/chapter3/script/ch3sc4.rpy:64
translate brazil ch3sc4_5f9d2252:

#   mc "*Chuckles* I'm not sure, maybe we'd have to catch a thief? Or return stolen goods?"
    mc "*Risos* Não sei, talvez tivéssemos que pegar um ladrão? Ou devolver os bens roubados?"

# game/chapters/chapter3/script/ch3sc4.rpy:65
translate brazil ch3sc4_3dc59abd:

#   mc "Could be anything, as adventurers, our contracts could easily have us traveling outside Luxenford as well."
    mc "Poderia ser qualquer coisa, já que, como aventureiros, nossos contratos poderiam facilmente nos levar a viajar para fora de Luxemburgo."

# game/chapters/chapter3/script/ch3sc4.rpy:66
translate brazil ch3sc4_efcf0be8:

#   el "Hmm! Guess we'll find out when we return to Sylph."
    el "Hum! Acho que só vamos descobrir quando voltarmos para Sylph."

# game/chapters/chapter3/script/ch3sc4.rpy:70
translate brazil ch3sc4_06585ebb:

#   mc "Let’s get going. The sooner we start our quest, the better."
    mc "Vamos começar. Quanto antes iniciarmos nossa jornada, melhor."

# game/chapters/chapter3/script/ch3sc4.rpy:72
translate brazil ch3sc4_94c8a0a3:

#   el "I can’t wait to get started on our first mission!"
    el "Mal posso esperar para começar nossa primeira missão!"

# game/chapters/chapter3/script/ch3sc4.rpy:73
translate brazil ch3sc4_f9c0c8d4:

#   el "I don’t feel like we can truly call ourselves members til we’ve completed at least one quest."
    el "Não acho que possamos nos considerar verdadeiramente membros até que tenhamos concluído pelo menos uma missão."

