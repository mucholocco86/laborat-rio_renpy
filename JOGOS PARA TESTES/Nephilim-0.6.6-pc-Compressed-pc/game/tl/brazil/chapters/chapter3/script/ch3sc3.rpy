# ARQUIVO: game/chapters/chapter3/script/ch3sc3.rpy DIALOGOS: 97


# game/chapters/chapter3/script/ch3sc3.rpy:7
translate brazil ch3sc3_9768bb49:

#   "A few moments later in Dalen's office..."
    "Poucos instantes depois, no escritório de Dalen..."

# game/chapters/chapter3/script/ch3sc3.rpy:10
translate brazil ch3sc3_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter3/script/ch3sc3.rpy:11
translate brazil ch3sc3_0fd4d656:

#   "......"
    "......"

# game/chapters/chapter3/script/ch3sc3.rpy:12
translate brazil ch3sc3_8b8ceb72:

#   "............"
    "............"

# game/chapters/chapter3/script/ch3sc3.rpy:14
translate brazil ch3sc3_747ccae9:

#   da "Ahh, you two must be the new recruits."
    da "Ah, vocês dois devem ser os novos recrutas."

# game/chapters/chapter3/script/ch3sc3.rpy:16
translate brazil ch3sc3_44a8de84:

#   el "How did you-"
    el "Como você..."

# game/chapters/chapter3/script/ch3sc3.rpy:18
translate brazil ch3sc3_7ada0147:

#   da "According to the local guards, I’m expecting a meeting with you two."
    da "Segundo os guardas locais, estou aguardando um encontro com vocês dois."

# game/chapters/chapter3/script/ch3sc3.rpy:20
translate brazil ch3sc3_35493d73:

#   el "Oh... About that..."
    el "Ah... Sobre isso..."

# game/chapters/chapter3/script/ch3sc3.rpy:22
translate brazil ch3sc3_dab98fc5:

#   el "We can explain, sir."
    el "Podemos explicar, senhor."

# game/chapters/chapter3/script/ch3sc3.rpy:23
translate brazil ch3sc3_1afdb550:

#   el "*Whispers* {size=-10}{b}Go on, explain it to him before he kicks us out!{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Vai lá, explica isso para ele antes que ele nos expulse!{/b}{/size}"

# game/chapters/chapter3/script/ch3sc3.rpy:25
translate brazil ch3sc3_ff304187:

#   mc "The guard wouldn’t let us enter the city without a city-pass."
    mc "O guarda não nos deixou entrar na cidade sem um passe municipal."

# game/chapters/chapter3/script/ch3sc3.rpy:26
translate brazil ch3sc3_1f23046d:

#   mc "So I handled it the best I could without causing a scene."
    mc "Então, lidei com a situação da melhor maneira possível, sem causar alarde."

# game/chapters/chapter3/script/ch3sc3.rpy:32
translate brazil ch3sc3_7286a87e:

#   da "So you did."
    da "Sim, você fez."

# game/chapters/chapter3/script/ch3sc3.rpy:33
translate brazil ch3sc3_4d982e61:

#   da "Being able to think on your feet and solve unforeseen problems..."
    da "Ter a capacidade de pensar rápido e resolver problemas imprevistos..."

# game/chapters/chapter3/script/ch3sc3.rpy:35
translate brazil ch3sc3_5745d75a:

#   da "That's something any adventurer who’s worthy of the name must be able to do."
    da "Isso é algo que qualquer aventureiro que faça jus a esse nome deve ser capaz de fazer."

# game/chapters/chapter3/script/ch3sc3.rpy:37
translate brazil ch3sc3_833df71e:

#   da "However, I'd advise you to avoid intimidating guards in the future..."
    da "No entanto, aconselho você a evitar intimidar guardas no futuro..."

# game/chapters/chapter3/script/ch3sc3.rpy:38
translate brazil ch3sc3_3c9aad0f:

#   da "All it takes is for one guard to not be swayed and you'll end up in the dungeons."
    da "Basta que um guarda não se deixe influenciar e você acaba nas masmorras."

# game/chapters/chapter3/script/ch3sc3.rpy:41
translate brazil ch3sc3_f2171ff0:

#   da "However, I'd advise you to avoid trying to persuade guards in the future..."
    da "No entanto, aconselho você a evitar tentar persuadir guardas no futuro..."

# game/chapters/chapter3/script/ch3sc3.rpy:45
translate brazil ch3sc3_6fb1465c:

#   mc "Noted."
    mc "Observado."

# game/chapters/chapter3/script/ch3sc3.rpy:46
translate brazil ch3sc3_1a2b3c59:

#   mc "So, all that fuss about the city-pass was a test?"
    mc "Então, toda aquela confusão sobre o passe da cidade foi um teste?"

# game/chapters/chapter3/script/ch3sc3.rpy:48
translate brazil ch3sc3_d9789485:

#   da "No, let’s just call it a happy coincidence."
    da "Não, vamos chamar isso de feliz coincidência."

# game/chapters/chapter3/script/ch3sc3.rpy:50
translate brazil ch3sc3_7442a5f3:

#   da "The city-pass requirement was ordered by the guard captain."
    da "A exigência do passe municipal foi determinada pelo capitão da guarda."

# game/chapters/chapter3/script/ch3sc3.rpy:52
translate brazil ch3sc3_76170fc3:

#   da "And not without good reason, either."
    da "E não sem um bom motivo."

# game/chapters/chapter3/script/ch3sc3.rpy:54
translate brazil ch3sc3_aefe4904:

#   el "Sir, if I may be so bold, why? It seems a little excessive."
    el "Senhor, se me permite a ousadia, por quê? Parece um pouco exagerado."

# game/chapters/chapter3/script/ch3sc3.rpy:56
translate brazil ch3sc3_822a1282:

#   da "Recently, there’s been a string of kidnappings around the city."
    da "Recentemente, houve uma série de sequestros na cidade."

# game/chapters/chapter3/script/ch3sc3.rpy:57
translate brazil ch3sc3_dd328e88:

#   da "At least suspected kidnappings, there's been no ransom demands, only young women disappearing."
    da "Ao menos nos casos suspeitos de sequestro, não houve pedidos de resgate, apenas o desaparecimento de mulheres jovens."

# game/chapters/chapter3/script/ch3sc3.rpy:59
translate brazil ch3sc3_c009ded1:

#   da "So unless outsiders have official business in Luxenford, they will be refused at the gates for now."
    da "Portanto, a menos que os visitantes tenham assuntos oficiais a tratar em Luxemburgo, a entrada será recusada nos portões, por enquanto."

# game/chapters/chapter3/script/ch3sc3.rpy:60
translate brazil ch3sc3_9a702795:

#   da "There's nothing to be done about it at the moment, not until a culprit for the kidnappings have been brought to justice."
    da "Não há nada que se possa fazer neste momento, não até que o culpado pelos sequestros seja levado à justiça."

# game/chapters/chapter3/script/ch3sc3.rpy:62
translate brazil ch3sc3_7340a4df:

#   el "Are there any leads on these kidnappings?"
    el "Há alguma pista sobre esses sequestros?"

# game/chapters/chapter3/script/ch3sc3.rpy:63
translate brazil ch3sc3_245934ec:

#   el "Surely people can't just vanish without a trace?"
    el "Certamente as pessoas não podem simplesmente desaparecer sem deixar rastro, certo?"

# game/chapters/chapter3/script/ch3sc3.rpy:65
translate brazil ch3sc3_467ab33c:

#   da "*Sigh* I’m afraid not... It’s been going on for roughly four or five moons now."
    da "*Suspiro* Receio que não... Isso já dura mais ou menos quatro ou cinco luas."

# game/chapters/chapter3/script/ch3sc3.rpy:66
translate brazil ch3sc3_61cbfb0d:

#   da "So far nine young women between the age of 18 to 25 have gone missing."
    da "Até o momento, nove jovens mulheres entre 18 e 25 anos estão desaparecidas."

# game/chapters/chapter3/script/ch3sc3.rpy:68
translate brazil ch3sc3_59e904ab:

#   mc "We’ll keep an eye out for anything suspicious."
    mc "Ficaremos atentos a qualquer atividade suspeita."

# game/chapters/chapter3/script/ch3sc3.rpy:69
translate brazil ch3sc3_b292abe0:

#   el "*Nods in agreement* Hm-hm!"
    el "*Acena com a cabeça em concordância* Hm-hm!"

# game/chapters/chapter3/script/ch3sc3.rpy:71
translate brazil ch3sc3_2c8f8be7:

#   da "Good. Be sure to report it to the guards or me if you stumble upon anything."
    da "Ótimo. Não se esqueça de informar os guardas ou a mim caso encontre algo suspeito."

# game/chapters/chapter3/script/ch3sc3.rpy:72
translate brazil ch3sc3_05c370af:

#   da "But don't go trying to solve this on your own."
    da "Mas não tente resolver isso sozinho."

# game/chapters/chapter3/script/ch3sc3.rpy:73
translate brazil ch3sc3_a79a67fe:

#   da "It's far too serious for recruits to deal with on their own."
    da "É algo demasiado sério para os recrutas lidarem sozinhos."

# game/chapters/chapter3/script/ch3sc3.rpy:74
translate brazil ch3sc3_8e6eaff3:

#   da "I'm sure both of you are quite capable. But I'd rather not have our first two recruits in over a year vanish as well."
    da "Tenho certeza de que ambos são bastante capazes. Mas eu preferiria não perder também nossos dois primeiros recrutas em mais de um ano."

# game/chapters/chapter3/script/ch3sc3.rpy:76
translate brazil ch3sc3_83048c6f:

#   el "Understood, sir! We'll report back if we come across anything that seems suspicious."
    el "Entendido, senhor! Informaremos caso encontremos algo suspeito."

# game/chapters/chapter3/script/ch3sc3.rpy:77
translate brazil ch3sc3_c16bc6a8:

#   el "Being in the target range for these kidnappings myself, I'd like to get this solved!"
    el "Como eu mesma estou na zona de risco desses sequestros, gostaria de ver isso resolvido!"

# game/chapters/chapter3/script/ch3sc3.rpy:79
translate brazil ch3sc3_f07b2246:

#   da "Yeah, I can see why you'd feel uneasy about the situation, and please, just call me Dalen."
    da "Sim, eu entendo por que você se sentiria desconfortável com a situação, e por favor, me chame apenas de Dalen."

# game/chapters/chapter3/script/ch3sc3.rpy:80
translate brazil ch3sc3_cc5a77e3:

#   da "I’m not one for such formalities. Come, let's have a seat."
    da "Não sou fã de formalidades. Venha, vamos nos sentar."

# game/chapters/chapter3/script/ch3sc3.rpy:82
translate brazil ch3sc3_01f8a901:

#   el "Yes, sir- I mean Dalen."
    el "Sim, senhor... quero dizer, Dalen."

# game/chapters/chapter3/script/ch3sc3.rpy:83
translate brazil ch3sc3_a6b7d354:

#   el "By the way, the guard at the gates told us to inquire about getting our city-pass with you?"
    el "A propósito, o guarda nos portões nos disse para perguntarmos sobre como obter o passe da cidade com vocês?"

# game/chapters/chapter3/script/ch3sc3.rpy:85
translate brazil ch3sc3_b0470fca:

#   da "Ah, right."
    da "Ah, certo."

# game/chapters/chapter3/script/ch3sc3.rpy:86
translate brazil ch3sc3_3342f84f:

#   da "Sylph will make one for you on your way out."
    da "Sylph fará um para você na saída."

# game/chapters/chapter3/script/ch3sc3.rpy:88
translate brazil ch3sc3_abb518cf:

#   el "Great!"
    el "Ótimo!"

# game/chapters/chapter3/script/ch3sc3.rpy:89
translate brazil ch3sc3_8ed43bdd:

#   el "We really don’t wish to cause trouble with the guards."
    el "Não queremos mesmo causar problemas com os guardas."

# game/chapters/chapter3/script/ch3sc3.rpy:91
translate brazil ch3sc3_94db23e9:

#   da "Now, tell me."
    da "Agora, me diga."

# game/chapters/chapter3/script/ch3sc3.rpy:92
translate brazil ch3sc3_2f548e00:

#   da "Why did you really lie to the guards and want to see me?"
    da "Por que você mentiu para os guardas e queria me ver?"

# game/chapters/chapter3/script/ch3sc3.rpy:94
translate brazil ch3sc3_e479ef1b:

#   mc "We want to become members of your guild and be official adventurers."
    mc "Queremos nos tornar membros da sua guilda e ser aventureiros oficiais."

# game/chapters/chapter3/script/ch3sc3.rpy:95
translate brazil ch3sc3_7172c8a4:

#   mc "It's been a dream of mine since childhood, although it hasn't been a priority recently. For personal reasons."
    mc "É um sonho meu desde a infância, embora não tenha sido uma prioridade recentemente. Por motivos pessoais."

# game/chapters/chapter3/script/ch3sc3.rpy:96
translate brazil ch3sc3_f176bc6a:

#   mc "And we also happen to be short on coin."
    mc "E por acaso, também estamos com pouco dinheiro."

# game/chapters/chapter3/script/ch3sc3.rpy:97
translate brazil ch3sc3_e93f1264:

#   mc "We heard completing quests and contracts for the guild is a good way to earn money."
    mc "Ouvimos dizer que completar missões e contratos para a guilda é uma boa maneira de ganhar dinheiro."

# game/chapters/chapter3/script/ch3sc3.rpy:99
translate brazil ch3sc3_3bdf5cee:

#   da "I see..."
    da "Eu vejo..."

# game/chapters/chapter3/script/ch3sc3.rpy:101
translate brazil ch3sc3_9a0719fa:

#   el "Please, sir- Dalen! We’ve traveled so far to get here."
    el "Por favor, senhor Dalen! Viajamos tão longe para chegar aqui."

# game/chapters/chapter3/script/ch3sc3.rpy:102
translate brazil ch3sc3_f127be17:

#   el "Don’t turn us away."
    el "Não nos rejeitem."

# game/chapters/chapter3/script/ch3sc3.rpy:104
translate brazil ch3sc3_c6979358:

#   da "Woah, calm down miss. I don’t intend to turn you away."
    da "Calma, senhorita. Não pretendo rejeitá-la."

# game/chapters/chapter3/script/ch3sc3.rpy:105
translate brazil ch3sc3_20f7ae59:

#   da "Your reasons for joining us are your own. People seek out adventuring for their own reasons."
    da "Os motivos que o levam a se juntar a nós são seus. Cada pessoa busca aventuras por suas próprias razões."

# game/chapters/chapter3/script/ch3sc3.rpy:107
translate brazil ch3sc3_937f55ff:

#   da "Some for the community, some for the thrill of discovery, some for coin, and some to fulfill their dreams."
    da "Alguns pela comunidade, alguns pela emoção da descoberta, alguns pelo dinheiro e alguns para realizar seus sonhos."

# game/chapters/chapter3/script/ch3sc3.rpy:108
translate brazil ch3sc3_cf082f42:

#   da "I don't judge. Also, we’re short on adventurers at the moment. There haven’t been any new recruits this season."
    da "Não julgo. Além disso, estamos com poucos aventureiros no momento. Não houve nenhum novo recruta nesta temporada."

# game/chapters/chapter3/script/ch3sc3.rpy:110
translate brazil ch3sc3_74e87916:

#   el "Oh, right. Sylph did mention something about that."
    el "Ah, sim. Sylph mencionou algo sobre isso."

# game/chapters/chapter3/script/ch3sc3.rpy:111
translate brazil ch3sc3_ea7facd2:

#   el "That's unfortunate, I'd think people would be eager to apply for the guild?"
    el "Que pena, eu imaginava que as pessoas estariam ansiosas para se candidatar à guilda."

# game/chapters/chapter3/script/ch3sc3.rpy:113
translate brazil ch3sc3_35134737:

#   mc "I'm with Eliza, I would've thought the guild would appeal to a lot of people?"
    mc "Concordo com a Eliza, eu imaginava que a guilda atrairia muita gente."

# game/chapters/chapter3/script/ch3sc3.rpy:114
translate brazil ch3sc3_6fd71c63:

#   mc "Why haven't any new recruits been applying to the guild?"
    mc "Por que nenhum novo recruta se candidatou à guilda?"

# game/chapters/chapter3/script/ch3sc3.rpy:116
translate brazil ch3sc3_72c86414:

#   da "I haven’t been able to confirm anything yet. But I do have a hunch who might be behind it."
    da "Ainda não consegui confirmar nada. Mas tenho um palpite sobre quem pode estar por trás disso."

# game/chapters/chapter3/script/ch3sc3.rpy:117
translate brazil ch3sc3_b448246a:

#   da "And it's not just our guild. Other guilds have been targeted too."
    da "E não é só a nossa guilda. Outras guildas também foram alvo."

# game/chapters/chapter3/script/ch3sc3.rpy:118
translate brazil ch3sc3_5f66a087:

#   da "Like the Mages Guild, for example... they recently had a change in leadership."
    da "Assim como a Guilda dos Magos, por exemplo... eles tiveram uma mudança de liderança recentemente."

# game/chapters/chapter3/script/ch3sc3.rpy:119
translate brazil ch3sc3_9c0f1b71:

#   da "I was on good terms with their previous Guildmaster, Cassandra."
    da "Eu tinha um bom relacionamento com a antiga Mestra da Guilda, Cassandra."

# game/chapters/chapter3/script/ch3sc3.rpy:120
translate brazil ch3sc3_3b1dcdb9:

#   da "She's an incredible sorceress, renowned leader, a beauty from the Sen'ju region, but most of all, she's a good person."
    da "Ela é uma feiticeira incrível, uma líder renomada, uma beleza da região de Sen'ju, mas acima de tudo, é uma boa pessoa."

# game/chapters/chapter3/script/ch3sc3.rpy:121
translate brazil ch3sc3_5c9eb893:

#   da "However, since their change in leadership, I haven't been able to get into contact with her."
    da "No entanto, desde a mudança na liderança, não consegui entrar em contato com ela."

# game/chapters/chapter3/script/ch3sc3.rpy:123
translate brazil ch3sc3_c92c8476:

#   el "That doesn't sound promising... could that be foulplay as well?"
    el "Isso não parece nada promissor... será que também pode ser um crime?"

# game/chapters/chapter3/script/ch3sc3.rpy:124
translate brazil ch3sc3_71ce0b48:

#   el "Who do you think is behind it?"
    el "Quem você acha que está por trás disso?"

# game/chapters/chapter3/script/ch3sc3.rpy:126
translate brazil ch3sc3_4e17e461:

#   da "Our rival guild, The Mercenaries Guild."
    da "Nossa guilda rival, a Guilda dos Mercenários."

# game/chapters/chapter3/script/ch3sc3.rpy:127
translate brazil ch3sc3_d04080a1:

#   da "I'm almost certain of it, but they've been covering their tracks well."
    da "Tenho quase certeza disso, mas eles têm conseguido encobrir bem os seus rastros."

# game/chapters/chapter3/script/ch3sc3.rpy:129
translate brazil ch3sc3_8050466b:

#   el "Why would they try to sabotage your recruitment? Or that of other guilds?"
    el "Por que eles tentariam sabotar o seu recrutamento? Ou o de outras guildas?"

# game/chapters/chapter3/script/ch3sc3.rpy:130
translate brazil ch3sc3_b8199004:

#   el "Seems like it would be a big risk to take. If they're ever found out..."
    el "Parece ser um risco muito grande. Se eles forem descobertos..."

# game/chapters/chapter3/script/ch3sc3.rpy:132
translate brazil ch3sc3_231c86f5:

#   da "They benefit from our guild performing poorly."
    da "Eles se beneficiam do mau desempenho da nossa guilda."

# game/chapters/chapter3/script/ch3sc3.rpy:133
translate brazil ch3sc3_f3c46a33:

#   da "You see, our guilds compete over some common quests and bounties."
    da "Veja bem, nossas guildas competem por algumas missões e recompensas em comum."

# game/chapters/chapter3/script/ch3sc3.rpy:135
translate brazil ch3sc3_b8176cb0:

#   mc "So if our guild has less recruits to fulfill contracts..."
    mc "Então, se nossa guilda tiver menos recrutas para cumprir os contratos..."

# game/chapters/chapter3/script/ch3sc3.rpy:137
translate brazil ch3sc3_1a6746b4:

#   da "We'll earn less coin, and people needing help will turn to them instead of us."
    da "Ganharemos menos dinheiro e as pessoas que precisam de ajuda recorrerão a eles em vez de a nós."

# game/chapters/chapter3/script/ch3sc3.rpy:138
translate brazil ch3sc3_090e9aaf:

#   da "But I can't figure out why they would target the Mage's guild as well."
    da "Mas não consigo entender por que eles também atacariam a guilda dos magos."

# game/chapters/chapter3/script/ch3sc3.rpy:139
translate brazil ch3sc3_0167735d:

#   da "They don't have any overlapping contracts or quests."
    da "Eles não têm contratos ou missões que se sobreponham."

# game/chapters/chapter3/script/ch3sc3.rpy:141
translate brazil ch3sc3_ac17f2b1:

#   el "This isn't right! Hnngh..."
    el "Isso não está certo! Hnngh..."

# game/chapters/chapter3/script/ch3sc3.rpy:142
translate brazil ch3sc3_dd0db2b4:

#   el "There’s got to be something we can do about it!"
    el "Tem que haver algo que possamos fazer a respeito!"

# game/chapters/chapter3/script/ch3sc3.rpy:144
translate brazil ch3sc3_e6482281:

#   da "*Sigh* I appreciate your concern... I really do."
    da "*Suspiro* Agradeço sua preocupação... de verdade."

# game/chapters/chapter3/script/ch3sc3.rpy:145
translate brazil ch3sc3_cb1e1356:

#   da "I’m working on a plan... but I'll need solid proof before I can proceed."
    da "Estou elaborando um plano... mas preciso de provas concretas antes de prosseguir."

# game/chapters/chapter3/script/ch3sc3.rpy:147
translate brazil ch3sc3_7a9bad16:

#   da "For now, we’re just happy to have two new recruits."
    da "Por enquanto, estamos felizes por termos dois novos recrutas."

# game/chapters/chapter3/script/ch3sc3.rpy:149
translate brazil ch3sc3_2dc69e20:

#   da "You two should head out to sort your equipment and supplies."
    da "Vocês dois devem ir organizar seus equipamentos e suprimentos."

# game/chapters/chapter3/script/ch3sc3.rpy:151
translate brazil ch3sc3_50c8d146:

#   da "Sylph will have a quest ready for you once you return."
    da "Sylph terá uma missão pronta para você quando retornar."

# game/chapters/chapter3/script/ch3sc3.rpy:153
translate brazil ch3sc3_f661beb5:

#   mc "Sounds good."
    mc "Parece bom."

# game/chapters/chapter3/script/ch3sc3.rpy:154
translate brazil ch3sc3_14e3dcfc:

#   mc "Keep us updated when you think of a way to deal with the recruitment issue."
    mc "Mantenha-nos informados quando você pensar em uma maneira de lidar com a questão do recrutamento."

# game/chapters/chapter3/script/ch3sc3.rpy:156
translate brazil ch3sc3_1f0e738d:

#   da "Thank you, [mc] and Eliza."
    da "Obrigado, [mc] e Eliza."

# game/chapters/chapter3/script/ch3sc3.rpy:157
translate brazil ch3sc3_d8311f0f:

#   da "Something tells me that you will both make great additions to our ranks."
    da "Algo me diz que vocês dois serão ótimas adições às nossas fileiras."

# game/chapters/chapter3/script/ch3sc3.rpy:159
translate brazil ch3sc3_11fb21f0:

#   el "We won’t disappoint you, Dalen!"
    el "Não vamos te decepcionar, Dalen!"

# game/chapters/chapter3/script/ch3sc3.rpy:161
translate brazil ch3sc3_6461fd39:

#   da "Alright, alright. Get going you two."
    da "Muito bem, muito bem. Vão vocês dois."

