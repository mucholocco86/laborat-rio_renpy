# ARQUIVO: game/chapters/chapter3/script/ch3sc10.rpy DIALOGOS: 191


# game/chapters/chapter3/script/ch3sc10.rpy:11
translate brazil ch3sc10_c1d38165:

#   mc "According to the instructions Sylph gave us, the stables should be around here."
    mc "De acordo com as instruções que Sylph nos deu, os estábulos devem estar por aqui."

# game/chapters/chapter3/script/ch3sc10.rpy:12
translate brazil ch3sc10_c31e6a28:

#   el "Yeah, she said about two miles west of the city-gate, feels like this would be about that far."
    el "Sim, ela disse que fica a cerca de três quilômetros a oeste do portão da cidade, parece que seria mais ou menos essa distância."

# game/chapters/chapter3/script/ch3sc10.rpy:15
translate brazil ch3sc10_48221e2d:

#   mc "Keep your eyes peeled for anything that looks like a barn or stable-like."
    mc "Fique atento a qualquer coisa que se pareça com um celeiro ou estábulo."

# game/chapters/chapter3/script/ch3sc10.rpy:17
translate brazil ch3sc10_b6e8e02f:

#   el "Look!"
    el "Olhar!"

# game/chapters/chapter3/script/ch3sc10.rpy:18
translate brazil ch3sc10_074b3514:

#   el "I think that’s it over there."
    el "Acho que é isso ali."

# game/chapters/chapter3/script/ch3sc10.rpy:20
translate brazil ch3sc10_249e099a:

#   mc "Ah, finally..."
    mc "Ah, finalmente..."

# game/chapters/chapter3/script/ch3sc10.rpy:21
translate brazil ch3sc10_c70d3b97:

#   mc "I thought we’d have to circle back."
    mc "Achei que teríamos que voltar atrás."

# game/chapters/chapter3/script/ch3sc10.rpy:23
translate brazil ch3sc10_06c3d98e:

#   el "Don’t be silly, we’ve only walked a few miles!"
    el "Não seja bobo, nós só caminhamos alguns quilômetros!"

# game/chapters/chapter3/script/ch3sc10.rpy:25
translate brazil ch3sc10_561b3cbb:

#   mc "Let’s go check if the stable keeper is around."
    mc "Vamos verificar se o tratador de cavalos está por perto."

# game/chapters/chapter3/script/ch3sc10.rpy:27
translate brazil ch3sc10_83e36362:

#   "The two of you scan the area for any signs of activity but nothing catches your eye."
    "Vocês dois examinam a área em busca de qualquer sinal de atividade, mas nada chama a sua atenção."

# game/chapters/chapter3/script/ch3sc10.rpy:29
translate brazil ch3sc10_a3ccce78:

#   el "Hello, anybody here?"
    el "Olá, tem alguém aí?"

# game/chapters/chapter3/script/ch3sc10.rpy:31
translate brazil ch3sc10_d8c269a7:

#   uk "Hi there!"
    uk "Olá!"

# game/chapters/chapter3/script/ch3sc10.rpy:33
translate brazil ch3sc10_b6f30d30:

#   uk "What can I do for you two?"
    uk "O que posso fazer por vocês dois?"

# game/chapters/chapter3/script/ch3sc10.rpy:35
translate brazil ch3sc10_7c8c2c9f:

#   uk "If you’re here to buy a horse, you'll have to wait..."
    uk "Se você está aqui para comprar um cavalo, terá que esperar..."

# game/chapters/chapter3/script/ch3sc10.rpy:36
translate brazil ch3sc10_5a6d20ec:

#   uk "We don’t have any available for sale at the moment,as they've been relocated for their safety."
    uk "Não temos nenhum disponível para venda no momento, pois eles foram realocados para sua segurança."

# game/chapters/chapter3/script/ch3sc10.rpy:37
translate brazil ch3sc10_af435cea:

#   uk "But we still have some saddles available."
    uk "Mas ainda temos algumas selas disponíveis."

# game/chapters/chapter3/script/ch3sc10.rpy:39
translate brazil ch3sc10_b08cf84d:

#   el "Actually, we’re here on behalf of the Adventurers Guild."
    el "Na verdade, estamos aqui em nome da Guilda dos Aventureiros."

# game/chapters/chapter3/script/ch3sc10.rpy:40
translate brazil ch3sc10_06eb0cc1:

#   el "You know, to save you."
    el "Sabe, para te salvar."

# game/chapters/chapter3/script/ch3sc10.rpy:42
translate brazil ch3sc10_109ce68e:

#   mc "We heard you were having trouble with wolves in the area?"
    mc "Soubemos que vocês estavam tendo problemas com lobos na região?"

# game/chapters/chapter3/script/ch3sc10.rpy:43
translate brazil ch3sc10_a185fa83:

#   mc "We just received your contract."
    mc "Acabamos de receber seu contrato."

# game/chapters/chapter3/script/ch3sc10.rpy:45
translate brazil ch3sc10_da78c6fa:

#   uk "Oh, I didn’t expect anyone so soon!"
    uk "Nossa, não esperava ninguém tão cedo!"

# game/chapters/chapter3/script/ch3sc10.rpy:46
translate brazil ch3sc10_5c09a678:

#   uk "I only just sent out the request this morning."
    uk "Acabei de enviar a solicitação esta manhã."

# game/chapters/chapter3/script/ch3sc10.rpy:48
translate brazil ch3sc10_6e3e2e03:

#   uk "Thank the Divines! That you guys could respond to it this soon."
    uk "Graças aos deuses! Que vocês tenham respondido tão rápido."

# game/chapters/chapter3/script/ch3sc10.rpy:49
translate brazil ch3sc10_0fd75883:

#   uk "The stable keeper has been worried for the horses ever since our mare was driven off."
    uk "O tratador está preocupado com os cavalos desde que nossa égua foi levada embora."

# game/chapters/chapter3/script/ch3sc10.rpy:51
translate brazil ch3sc10_f86f456c:

#   sl "I’m Selena by the way, Nice to meet you guys!"
    sl "A propósito, meu nome é Selena. Prazer em conhecer vocês!"

# game/chapters/chapter3/script/ch3sc10.rpy:53
translate brazil ch3sc10_7b83df28:

#   el "Nice to meet you, Selena."
    el "Prazer em conhecê-la, Selena."

# game/chapters/chapter3/script/ch3sc10.rpy:54
translate brazil ch3sc10_362e7e41:

#   el "I’m Eliza, and my partner here is [mc]."
    el "Eu sou Eliza, e meu parceiro aqui é [mc]."

# game/chapters/chapter3/script/ch3sc10.rpy:56
translate brazil ch3sc10_e6d63d6e:

#   mc "Nice to meet you, Selena."
    mc "Prazer em conhecê-la, Selena."

# game/chapters/chapter3/script/ch3sc10.rpy:57
translate brazil ch3sc10_909c9866:

#   mc "So you're not the stable keeper then?"
    mc "Então você não é o tratador de cavalos?"

# game/chapters/chapter3/script/ch3sc10.rpy:58
translate brazil ch3sc10_c132e9c7:

#   sl "Goodness, no. I'm working here as a stablemaiden, looking after the horses, grooming them and feeding them."
    sl "Deus me livre. Estou trabalhando aqui como tratadora de cavalos, cuidando deles, escovando-os e alimentando-os."

# game/chapters/chapter3/script/ch3sc10.rpy:60
translate brazil ch3sc10_9ede56a7:

#   sl "But enough about me, that's not what you came all the way out here for."
    sl "Mas chega de falar de mim, não foi para isso que você veio até aqui."

# game/chapters/chapter3/script/ch3sc10.rpy:61
translate brazil ch3sc10_6e9cc6ad:

#   sl "I suppose you two want to get right to work?"
    sl "Imagino que vocês dois queiram começar a trabalhar imediatamente?"

# game/chapters/chapter3/script/ch3sc10.rpy:63
translate brazil ch3sc10_5d232ee9:

#   el "Yes! We're eager to solve this matter."
    el "Sim! Estamos ansiosos para resolver essa questão."

# game/chapters/chapter3/script/ch3sc10.rpy:64
translate brazil ch3sc10_24bbf153:

#   el "Can you share any details about the recent attacks?"
    el "Poderia compartilhar detalhes sobre os ataques recentes?"

# game/chapters/chapter3/script/ch3sc10.rpy:66
translate brazil ch3sc10_00571337:

#   sl "Let's see..."
    sl "Vamos ver..."

# game/chapters/chapter3/script/ch3sc10.rpy:67
translate brazil ch3sc10_f1548a2d:

#   sl "It started a few moons ago."
    sl "Tudo começou há algumas luas."

# game/chapters/chapter3/script/ch3sc10.rpy:69
translate brazil ch3sc10_6b5e407d:

#   sl "At first we just had a few encounters at the outskirts of the woods."
    sl "Inicialmente, tivemos apenas alguns encontros nos arredores da floresta."

# game/chapters/chapter3/script/ch3sc10.rpy:70
translate brazil ch3sc10_19ff4d53:

#   sl "We didn’t think anything of it."
    sl "Não demos muita importância a isso."

# game/chapters/chapter3/script/ch3sc10.rpy:72
translate brazil ch3sc10_b6af976e:

#   el "Did they start getting closer to the stables?"
    el "Eles começaram a se aproximar dos estábulos?"

# game/chapters/chapter3/script/ch3sc10.rpy:75
translate brazil ch3sc10_1b081eb0:

#   sl "*Exhales deeply* ..."
    sl "*Exala profundamente* ..."

# game/chapters/chapter3/script/ch3sc10.rpy:77
translate brazil ch3sc10_ae0bc1cd:

#   sl "*Sigh* Yes... recently, they even managed to hunt and kill one of our horses that got loose."
    sl "*Suspiro* Sim... recentemente, eles até conseguiram caçar e matar um dos nossos cavalos que havia escapado."

# game/chapters/chapter3/script/ch3sc10.rpy:78
translate brazil ch3sc10_93dcdca3:

#   sl "It was our breeding mare."
    sl "Era a nossa égua reprodutora."

# game/chapters/chapter3/script/ch3sc10.rpy:79
translate brazil ch3sc10_a91a1666:

#   sl "Without her, it'll be a while before we can procure another and start breeding again."
    sl "Sem ela, vai demorar um pouco até conseguirmos outra e começarmos a criar novamente."

# game/chapters/chapter3/script/ch3sc10.rpy:81
translate brazil ch3sc10_8da85613:

#   el "Oh, that's horrible..."
    el "Oh, isso é horrível..."

# game/chapters/chapter3/script/ch3sc10.rpy:82
translate brazil ch3sc10_4e311110:

#   el "Is that why you aren’t selling any at the moment?"
    el "É por isso que você não está vendendo nenhum no momento?"

# game/chapters/chapter3/script/ch3sc10.rpy:84
translate brazil ch3sc10_7d543ca3:

#   sl "*Nods* Yes, we can’t afford to lose any more horses now..."
    sl "*Acena com a cabeça* Sim, não podemos nos dar ao luxo de perder mais nenhum cavalo agora..."

# game/chapters/chapter3/script/ch3sc10.rpy:85
translate brazil ch3sc10_b62bf3f3:

#   sl "Otherwise we might not be able to breed any new offspring next season."
    sl "Caso contrário, talvez não consigamos gerar novos descendentes na próxima temporada."

# game/chapters/chapter3/script/ch3sc10.rpy:86
translate brazil ch3sc10_a9cf228d:

#   sl "A-And no offspring means no income. We'd have to close down the stables."
    sl "E sem descendentes não há renda. Teríamos que fechar os estábulos."

# game/chapters/chapter3/script/ch3sc10.rpy:87
translate brazil ch3sc10_34d92a29:

#   sl "That's why the stable keeper is relocating the horses to a nearby stable until the issue has been resolved."
    sl "Por isso, o tratador está transferindo os cavalos para um estábulo próximo até que o problema seja resolvido."

# game/chapters/chapter3/script/ch3sc10.rpy:89
translate brazil ch3sc10_b282ac25:

#   mc "Selena, can you show us the nearby area where you have seen the wolves?"
    mc "Selena, você pode nos mostrar a área próxima onde você viu os lobos?"

# game/chapters/chapter3/script/ch3sc10.rpy:91
translate brazil ch3sc10_4661e2e5:

#   sl "Oh. You mean go out there? To the woods?"
    sl "Ah. Você quer dizer ir lá fora? Para a floresta?"

# game/chapters/chapter3/script/ch3sc10.rpy:93
translate brazil ch3sc10_086d2121:

#   mc "Yes, we’ll need to find them to deal with them."
    mc "Sim, precisaremos encontrá-los para lidar com eles."

# game/chapters/chapter3/script/ch3sc10.rpy:95
translate brazil ch3sc10_9628b400:

#   sl "I’m not too fond of going out there... there's wolves..."
    sl "Não gosto muito de ir lá fora... tem lobos..."

# game/chapters/chapter3/script/ch3sc10.rpy:97
translate brazil ch3sc10_eac011df:

#   el "Don’t worry Selena, we’ll be there as well."
    el "Não se preocupe, Selena, nós também estaremos lá."

# game/chapters/chapter3/script/ch3sc10.rpy:98
translate brazil ch3sc10_ed761e99:

#   el "If anything happens, we’ll handle it!"
    el "Se algo acontecer, nós resolveremos!"

# game/chapters/chapter3/script/ch3sc10.rpy:100
translate brazil ch3sc10_521de865:

#   "Selena, clearly nervous and not reassured by Eliza, looks to you."
    "Selena, visivelmente nervosa e sem se sentir tranquilizada por Eliza, olha para você."

# game/chapters/chapter3/script/ch3sc10.rpy:105
translate brazil ch3sc10_a15d334c:

#   mc "Hey..."
    mc "Ei..."

# game/chapters/chapter3/script/ch3sc10.rpy:106
translate brazil ch3sc10_3ddb2509:

#   mc "I won’t let anything happen to you, Selena."
    mc "Não vou deixar que nada aconteça com você, Selena."

# game/chapters/chapter3/script/ch3sc10.rpy:107
translate brazil ch3sc10_0bb5b964:

#   mc "You'll be safe with me."
    mc "Você estará seguro comigo."

# game/chapters/chapter3/script/ch3sc10.rpy:110
translate brazil ch3sc10_a94bdf91:

#   sl "I guess you'd be right there with me... that does make me feel a bit safer."
    sl "Acho que você concorda comigo... isso me deixa um pouco mais tranquilo."

# game/chapters/chapter3/script/ch3sc10.rpy:111
translate brazil ch3sc10_441b2d50:

#   "Selena feels reassured by you, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Selena se sente mais segura com você, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc10.rpy:112
translate brazil ch3sc10_3aa347d7:

#   sl "O-Okay, I suppose I could show you."
    sl "Certo, acho que posso te mostrar."

# game/chapters/chapter3/script/ch3sc10.rpy:113
translate brazil ch3sc10_90c0fa92:

#   "You successfully reassured Selena, your {color=#87e1fa}Charisma{/color} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguiu tranquilizar Selena, sua {color=#87e1fa} Carisma{/color} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc10.rpy:118
translate brazil ch3sc10_5daed978:

#   mc "Selena, we can't help you solve the problem if you don't show us."
    mc "Selena, não podemos te ajudar a resolver o problema se você não nos mostrar."

# game/chapters/chapter3/script/ch3sc10.rpy:119
translate brazil ch3sc10_5d91f03d:

#   mc "Being scared of wolves is silly, especially with us here."
    mc "Ter medo de lobos é bobagem, especialmente com a gente por aqui."

# game/chapters/chapter3/script/ch3sc10.rpy:121
translate brazil ch3sc10_2459d0b0:

#   mc "I'm here to do a job, now take me to the area so I can resolve this matter."
    mc "Estou aqui para realizar um trabalho, agora leve-me até a área para que eu possa resolver este problema."

# game/chapters/chapter3/script/ch3sc10.rpy:123
translate brazil ch3sc10_933af021:

#   sl "[mc]... O-Okay, yeah."
    sl "[mc]... Tá bom, sim."

# game/chapters/chapter3/script/ch3sc10.rpy:124
translate brazil ch3sc10_9a484588:

#   sl "I'll trust in your direction, let's go, it isn't far."
    sl "Confiarei na sua direção, vamos lá, não é longe."

# game/chapters/chapter3/script/ch3sc10.rpy:125
translate brazil ch3sc10_12cdd235:

#   "You successfully took control of the situation, your {color=#ffee54}Leadership{/color} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguiu controlar a situação com sucesso, seu {color=#ffee54} Liderança{/color} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc10.rpy:128
translate brazil ch3sc10_8fcffcc3:

#   sl "Follow me! It's not too far from here."
    sl "Siga-me! Não é muito longe daqui."

# game/chapters/chapter3/script/ch3sc10.rpy:134
translate brazil ch3sc10_b757f67a:

#   sl "What are you looking for exactly?"
    sl "O que você está procurando exatamente?"

# game/chapters/chapter3/script/ch3sc10.rpy:136
translate brazil ch3sc10_fce7d05c:

#   mc "Signs of activity."
    mc "Sinais de atividade."

# game/chapters/chapter3/script/ch3sc10.rpy:137
translate brazil ch3sc10_842c65c2:

#   mc "Like paw prints in the dirt, or tufts of fur stuck to branches. Anything that could give us a clue."
    mc "Como pegadas na terra ou tufos de pelo presos em galhos. Qualquer coisa que possa nos dar uma pista."

# game/chapters/chapter3/script/ch3sc10.rpy:138
translate brazil ch3sc10_5f612535:

#   sl "It’s around here we first spotted them, we've seen a grey-ish one and a black one."
    sl "Foi por aqui que os avistamos pela primeira vez; vimos um acinzentado e um preto."

# game/chapters/chapter3/script/ch3sc10.rpy:140
translate brazil ch3sc10_707e6c62:

#   el "Be alert, Selena."
    el "Fique atenta, Selena."

# game/chapters/chapter3/script/ch3sc10.rpy:141
translate brazil ch3sc10_55e3c033:

#   el "If anything happens, let us handle it."
    el "Se algo acontecer, deixe que nós cuidemos disso."

# game/chapters/chapter3/script/ch3sc10.rpy:143
translate brazil ch3sc10_61a82d91:

#   sl "Will do, Eliza!"
    sl "Farei isso, Eliza!"

# game/chapters/chapter3/script/ch3sc10.rpy:144
translate brazil ch3sc10_fc0a6f8d:

#   sl "Thank you guys... Really, I mean it."
    sl "Muito obrigado, pessoal... De verdade, é sincero."

# game/chapters/chapter3/script/ch3sc10.rpy:148
translate brazil ch3sc10_a37dea4f:

#   mct "Hmh?"
    mct "Hum?"

# game/chapters/chapter3/script/ch3sc10.rpy:150
translate brazil ch3sc10_295bbea7:

#   mct "..."
    mct "..."

# game/chapters/chapter3/script/ch3sc10.rpy:153
translate brazil ch3sc10_99c0483a:

#   mc "You two, get down."
    mc "Vocês dois, desçam daqui."

# game/chapters/chapter3/script/ch3sc10.rpy:156
translate brazil ch3sc10_901c0250:

#   el "*Whispers* {size=-10}{b}Did you see anything?{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Você viu alguma coisa?{/b}{/size}"

# game/chapters/chapter3/script/ch3sc10.rpy:158
translate brazil ch3sc10_ac733a56:

#   mc "*Whispers* {size=-10}{b}I thought I heard something in the distance.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Achei que tinha ouvido algo à distância.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc10.rpy:162
translate brazil ch3sc10_11d187d6:

#   el "*Whispers* {size=-10}{b}False alarm, I suppos-{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Alarme falso, eu suponho.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc10.rpy:165
translate brazil ch3sc10_007a4d54:

#   sl "{b}AaahhH!!{/b}"
    sl "{b}AaahhH!!{/b}"

# game/chapters/chapter3/script/ch3sc10.rpy:167
translate brazil ch3sc10_8d2265cf:

#   sl "{b}S-Stay back!! You beast!{/b}"
    sl "{b}Fique longe!! Seu monstro!{/b}"

# game/chapters/chapter3/script/ch3sc10.rpy:171
translate brazil ch3sc10_9dd80e7d:

#   "*Snarls* Hrrh!"
    "*Rosna* Hrrh!"

# game/chapters/chapter3/script/ch3sc10.rpy:173
translate brazil ch3sc10_83d0465a:

#   sl "*Nervous* {b}G-Guys! Help!{/b}"
    sl "*Nervoso* {b} G-Pessoal! Socorro!{/b}"

# game/chapters/chapter3/script/ch3sc10.rpy:175
translate brazil ch3sc10_63e0fbef:

#   mc "Selena, don’t move a muscle."
    mc "Selena, não se mexa."

# game/chapters/chapter3/script/ch3sc10.rpy:177
translate brazil ch3sc10_b46ee273:

#   el "What should we do?"
    el "O que devemos fazer?"

# game/chapters/chapter3/script/ch3sc10.rpy:179
translate brazil ch3sc10_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter3/script/ch3sc10.rpy:183
translate brazil ch3sc10_7f067286:

#   "Eliza’s trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "A confiança de Eliza aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc10.rpy:186
translate brazil ch3sc10_3c8f3974:

#   mct "It’s risky, but I could try to lure the wolf away."
    mct "É arriscado, mas eu poderia tentar atrair o lobo para longe."

# game/chapters/chapter3/script/ch3sc10.rpy:187
translate brazil ch3sc10_0064accf:

#   mct "I hope this doesn’t backfire... the success of our quest depends on it."
    mct "Espero que isso não se volte contra nós... o sucesso da nossa missão depende disso."

# game/chapters/chapter3/script/ch3sc10.rpy:189
translate brazil ch3sc10_a073aee8:

#   mc "Eliza, I’m going to attempt to lure the wolf away."
    mc "Eliza, vou tentar atrair o lobo para longe."

# game/chapters/chapter3/script/ch3sc10.rpy:190
translate brazil ch3sc10_923c1e3b:

#   mc "You’re in charge of getting Selena back to the stables safely."
    mc "Você é responsável por levar Selena de volta aos estábulos em segurança."

# game/chapters/chapter3/script/ch3sc10.rpy:192
translate brazil ch3sc10_a7bb353c:

#   el "Okay! I won’t let you down."
    el "Certo! Não vou te decepcionar."

# game/chapters/chapter3/script/ch3sc10.rpy:194
translate brazil ch3sc10_0641dd68:

#   mc "Wait for me to be out of sight."
