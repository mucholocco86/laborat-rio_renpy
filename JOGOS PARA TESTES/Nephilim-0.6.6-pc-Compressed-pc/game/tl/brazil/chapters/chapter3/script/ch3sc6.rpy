# ARQUIVO: game/chapters/chapter3/script/ch3sc6.rpy DIALOGOS: 77


# game/chapters/chapter3/script/ch3sc6.rpy:7
translate brazil ch3sc6_13f34a02:

#   "The two of you take your leave with your new supplies."
    "Vocês dois se despedem com seus novos suprimentos."

# game/chapters/chapter3/script/ch3sc6.rpy:10
translate brazil ch3sc6_3c01fade:

#   el "Sooo... have you given any more thought to what our first quest will be?"
    el "Então... você já pensou mais sobre qual será nossa primeira missão?"

# game/chapters/chapter3/script/ch3sc6.rpy:12
translate brazil ch3sc6_24766eba:

#   mc "I’m not sure what to expect."
    mc "Não sei bem o que esperar."

# game/chapters/chapter3/script/ch3sc6.rpy:13
translate brazil ch3sc6_c776cf7a:

#   mc "But don’t get your hopes up for anything too exciting."
    mc "Mas não criem grandes expectativas para nada muito emocionante."

# game/chapters/chapter3/script/ch3sc6.rpy:15
translate brazil ch3sc6_27db34eb:

#   el "You mean to tell me that they don’t just hand out high rank quests to complete rookies?"
    el "Você quer dizer que eles não distribuem missões de alto nível para novatos?"

# game/chapters/chapter3/script/ch3sc6.rpy:17
translate brazil ch3sc6_1a3ce239:

#   mc "Pretty much."
    mc "Praticamente isso."

# game/chapters/chapter3/script/ch3sc6.rpy:18
translate brazil ch3sc6_ebbac4ef:

#   mc "We’re currently D-Rank, as far I could tell from the look I got at the notice board we passed by."
    mc "Atualmente estamos na categoria D, pelo que pude perceber pelo olhar que recebi no quadro de avisos por onde passamos."

# game/chapters/chapter3/script/ch3sc6.rpy:19
translate brazil ch3sc6_178690cb:

#   mc "So, most likely we'll have to progress up the ranks as follows D-Rank to C-Rank then B-Rank onto A-Rank and finally S-Rank."
    mc "Portanto, muito provavelmente teremos que progredir nos rankings da seguinte forma: Rank D para Rank C, depois Rank B, Rank A e, finalmente, Rank S."

# game/chapters/chapter3/script/ch3sc6.rpy:20
translate brazil ch3sc6_6f063f38:

#   mc "It seems the difficulty and therefore reward from contracts & quests is tied to our Adventurers-Rank."
    mc "Parece que a dificuldade e, portanto, a recompensa de contratos e missões estão ligadas ao nosso nível de aventureiro."

# game/chapters/chapter3/script/ch3sc6.rpy:22
translate brazil ch3sc6_9bfedb1b:

#   el "Mmmh... You’ve got a point... as D-Class adventurers we probably won't get anything juicy."
    el "Hum... Você tem razão... como aventureiros Classe D, provavelmente não vamos conseguir nada de interessante."

# game/chapters/chapter3/script/ch3sc6.rpy:23
translate brazil ch3sc6_9483108f:

#   el "We should aim to reach a higher rank!"
    el "Devemos almejar uma posição mais elevada!"

# game/chapters/chapter3/script/ch3sc6.rpy:24
translate brazil ch3sc6_8b6d1021:

#   el "That way we could get quests that have better rewards and earn more coin!"
    el "Dessa forma, poderíamos receber missões com recompensas melhores e ganhar mais moedas!"

# game/chapters/chapter3/script/ch3sc6.rpy:26
translate brazil ch3sc6_02553547:

#   el "We have to do our best, [mc]!"
    el "Temos que fazer o nosso melhor, [mc]!"

# game/chapters/chapter3/script/ch3sc6.rpy:27
translate brazil ch3sc6_acc0f909:

#   el "I'll accept nothing less."
    el "Não aceitarei nada menos que isso."

# game/chapters/chapter3/script/ch3sc6.rpy:31
translate brazil ch3sc6_1125a56a:

#   mc "Why do I have the feeling that-"
    mc "Por que tenho a sensação de que-"

# game/chapters/chapter3/script/ch3sc6.rpy:33
translate brazil ch3sc6_f6e468ba:

#   el "Nah-nah! Not telling."
    el "Não, não! Não vou contar."

# game/chapters/chapter3/script/ch3sc6.rpy:34
translate brazil ch3sc6_a0efed5d:

#   el "Just know I intend for us to reach the top ranks! S-Rank!"
    el "Saiba que minha intenção é que alcancemos o topo do ranking! Rank S!"

# game/chapters/chapter3/script/ch3sc6.rpy:36
translate brazil ch3sc6_a81e494a:

#   mc "Why do you care about our ranking?"
    mc "Por que você se importa com a nossa classificação?"

# game/chapters/chapter3/script/ch3sc6.rpy:37
translate brazil ch3sc6_fbfd1a6f:

#   mc "You know what our goal is."
    mc "Você sabe qual é o nosso objetivo."

# game/chapters/chapter3/script/ch3sc6.rpy:39
translate brazil ch3sc6_2c9029b0:

#   el "*Sighs* [mc]."
    el "*Suspiros* [mc]."

# game/chapters/chapter3/script/ch3sc6.rpy:40
translate brazil ch3sc6_9b914035:

#   el "Have you ever stopped to think about what life will be after we accomplish what we've set out to do?"
    el "Você já parou para pensar em como será a vida depois que realizarmos o que nos propusemos a fazer?"

# game/chapters/chapter3/script/ch3sc6.rpy:41
translate brazil ch3sc6_08164463:

#   el "Would we continue being adventurers? Would we separate and leave on different paths?"
    el "Continuaríamos sendo aventureiros? Ou nos separaríamos e seguiríamos caminhos diferentes?"

# game/chapters/chapter3/script/ch3sc6.rpy:42
translate brazil ch3sc6_f2091155:

#   el "Would we buy a piece of land and become farmers?"
    el "Será que compraríamos um terreno e nos tornaríamos agricultores?"

# game/chapters/chapter3/script/ch3sc6.rpy:44
translate brazil ch3sc6_f1f70a80:

#   mc "I... I don’t know."
    mc "Eu... eu não sei."

# game/chapters/chapter3/script/ch3sc6.rpy:45
translate brazil ch3sc6_86802cd6:

#   mc "Never really given any thought as what would come after."
    mc "Nunca parei para pensar no que viria depois."

# game/chapters/chapter3/script/ch3sc6.rpy:47
translate brazil ch3sc6_a0ce982d:

#   el "Exactly! I had a feeling you wouldn't be thinking longterm..."
    el "Exatamente! Eu tinha a sensação de que você não estaria pensando a longo prazo..."

# game/chapters/chapter3/script/ch3sc6.rpy:48
translate brazil ch3sc6_67ff0ac7:

#   el "So I feel like at least one of us should be sensible and prepare for that."
    el "Então, acho que pelo menos um de nós deveria ser sensato e se preparar para isso."

# game/chapters/chapter3/script/ch3sc6.rpy:50
translate brazil ch3sc6_eb5c4405:

#   mc "Makes sense I suppose, I've always been so focused on... you know what."
    mc "Faz sentido, eu acho, eu sempre estive tão focado em... você sabe o quê."

# game/chapters/chapter3/script/ch3sc6.rpy:51
translate brazil ch3sc6_e899e2b4:

#   mc "But what does that have to do with us climbing the ranks of the guild?"
    mc "Mas o que isso tem a ver com a nossa ascensão na hierarquia da guilda?"

# game/chapters/chapter3/script/ch3sc6.rpy:53
translate brazil ch3sc6_4a194938:

#   el "As you said, higher rankings mean better quests and contracts that will bring in more coin."
    el "Como você disse, classificações mais altas significam missões e contratos melhores que renderão mais moedas."

# game/chapters/chapter3/script/ch3sc6.rpy:54
translate brazil ch3sc6_95043dd9:

#   el "I want to be able to set aside a decent amount of coin from every quest."
    el "Quero poder reservar uma quantia razoável de moedas a cada missão."

# game/chapters/chapter3/script/ch3sc6.rpy:55
translate brazil ch3sc6_e6095aa0:

#   el "Not spend it all just as fast as we earn it."
    el "Não gaste tudo tão rápido quanto ganhamos."

# game/chapters/chapter3/script/ch3sc6.rpy:57
translate brazil ch3sc6_c84fc804:

#   mc "Okay... makes sense."
    mc "Ok... faz sentido."

# game/chapters/chapter3/script/ch3sc6.rpy:58
translate brazil ch3sc6_7ef54ec5:

#   mc "I'm with you so far, go on."
    mc "Até aqui estou com você, continue."

# game/chapters/chapter3/script/ch3sc6.rpy:60
translate brazil ch3sc6_b4c9a177:

#   el "Once we’ve saved up a bunch, and we’ve gotten our... revenge."
    el "Depois de juntarmos uma boa quantia e conseguirmos nossa... vingança."

# game/chapters/chapter3/script/ch3sc6.rpy:62
translate brazil ch3sc6_9f6518a1:

#   el "I suggest we purchase a house somewhere quiet? Still close to the capital, of course."
    el "Sugiro que compremos uma casa em algum lugar tranquilo? Ainda perto da capital, claro."

# game/chapters/chapter3/script/ch3sc6.rpy:63
translate brazil ch3sc6_3c290c89:

#   el "But also far enough that we can have peace and relax!"
    el "Mas também longe o suficiente para que possamos ter paz e relaxar!"

# game/chapters/chapter3/script/ch3sc6.rpy:64
translate brazil ch3sc6_eaba0388:

#   el "Create a homestead, you know? Somewhere we can call home... it's something neither of us have had most of our lives."
    el "Criar um lar, sabe? Um lugar que possamos chamar de nossa casa... é algo que nenhum de nós teve durante a maior parte de nossas vidas."

# game/chapters/chapter3/script/ch3sc6.rpy:66
translate brazil ch3sc6_2a92072f:

#   el "The divines know we'll need it after all this!"
    el "Os deuses sabem que precisaremos disso depois de tudo isso!"

# game/chapters/chapter3/script/ch3sc6.rpy:68
translate brazil ch3sc6_2f47a197:

#   el "Now, c’mon! Let’s go pickup our first quest from Sylph!"
    el "Vamos lá! Vamos pegar nossa primeira missão com a Sylph!"

# game/chapters/chapter3/script/ch3sc6.rpy:71
translate brazil ch3sc6_ed41b4fb:

#   "You catch up to her outside the guild."
    "Você a alcança do lado de fora da guilda."

# game/chapters/chapter3/script/ch3sc6.rpy:73
translate brazil ch3sc6_df04b11d:

#   mct "Hmm... It’s actually not a bad idea... I've never really thought about what comes after."
    mct "Hum... Na verdade, não é uma má ideia... Nunca tinha pensado no que vem depois."

# game/chapters/chapter3/script/ch3sc6.rpy:74
translate brazil ch3sc6_f7d360c6:

#   mct "She seems to have put quite a bit of thought into this... into... our future."
    mct "Parece que ela refletiu bastante sobre isso... sobre... o nosso futuro."

# game/chapters/chapter3/script/ch3sc6.rpy:75
translate brazil ch3sc6_c39fd85c:

#   mc "Eliza, wait up!"
    mc "Eliza, espere!"

# game/chapters/chapter3/script/ch3sc6.rpy:78
translate brazil ch3sc6_1ec92b80:

#   el "Hmm?"
    el "Hum?"

# game/chapters/chapter3/script/ch3sc6.rpy:85
translate brazil ch3sc6_78101c6b:

#   mc "You know what? That’s not a terrible idea."
    mc "Sabe de uma coisa? Não é uma ideia tão ruim assim."

# game/chapters/chapter3/script/ch3sc6.rpy:87
translate brazil ch3sc6_ec2289dc:

#   el "R-Really?! I was afraid you'd think it’s silly."
    el "Sério?! Eu tinha medo que você achasse isso bobagem."

# game/chapters/chapter3/script/ch3sc6.rpy:88
translate brazil ch3sc6_f7b9fb22:

#   "Eliza is pleasantly surprised that you praised her foresight, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Eliza ficou agradavelmente surpresa com o elogio à sua perspicácia, e sua confiança aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc6.rpy:89
translate brazil ch3sc6_8462417a:

#   el "You don't think I'm getting ahead of myself?"
    el "Você acha que não estou me precipitando?"

# game/chapters/chapter3/script/ch3sc6.rpy:91
translate brazil ch3sc6_f001c50e:

#   mc "No, it makes sense. We don’t know how long it'll take us to get to that point."
    mc "Não, faz sentido. Não sabemos quanto tempo levará para chegarmos a esse ponto."

# game/chapters/chapter3/script/ch3sc6.rpy:92
translate brazil ch3sc6_e208908c:

#   mc "Not to mention, I'm sure it won't be a straight path to vengeance, life don't tend to be that simple."
    mc "Sem falar que, tenho certeza, não será um caminho fácil para a vingança; a vida não costuma ser tão simples."

# game/chapters/chapter3/script/ch3sc6.rpy:93
translate brazil ch3sc6_9c690dc2:

#   mc "It feels great to have a plan, something we can work towards."
    mc "É ótimo ter um plano, algo em que podemos trabalhar."

# game/chapters/chapter3/script/ch3sc6.rpy:95
translate brazil ch3sc6_4a1f3c51:

#   el "*Giggles* You can call me Master-Planner from now on."
    el "*Risos* De agora em diante, pode me chamar de Mestre dos Planos."

# game/chapters/chapter3/script/ch3sc6.rpy:96
translate brazil ch3sc6_b016dfd5:

#   el "You can add it to my ever-growing list of cool titles! *Snickers*"
    el "Pode adicionar à minha lista cada vez maior de títulos legais! *Risos*"

# game/chapters/chapter3/script/ch3sc6.rpy:98
translate brazil ch3sc6_5c905059:

#   mc "Yeah... No."
    mc "Sim... Não."

# game/chapters/chapter3/script/ch3sc6.rpy:99
translate brazil ch3sc6_8e50a895:

#   mc "Let's add it to the list of things to never call you."
    mc "Vamos adicionar isso à lista de coisas que nunca devem ser ditas para você."

# game/chapters/chapter3/script/ch3sc6.rpy:101
translate brazil ch3sc6_91caac5b:

#   el "*Nudge* Don't be a meanie!"
    el "*Cutucada* Não seja malvado!"

# game/chapters/chapter3/script/ch3sc6.rpy:102
translate brazil ch3sc6_73cfd5b1:

#   el "Just once? Please?"
    el "Só uma vez? Por favor?"

# game/chapters/chapter3/script/ch3sc6.rpy:104
translate brazil ch3sc6_7cfa4f38:

#   mc "Still a no."
    mc "Continua sendo um não."

# game/chapters/chapter3/script/ch3sc6.rpy:106
translate brazil ch3sc6_29cee16f:

#   el "Whateverrr!"
    el "Tanto faz!"

# game/chapters/chapter3/script/ch3sc6.rpy:107
translate brazil ch3sc6_3b396e4c:

#   el "We both know I am! Mh-hm, Master-Planner Eliza."
    el "Nós duas sabemos que sou! Hum-hum, Eliza, a Mestra dos Planos."

# game/chapters/chapter3/script/ch3sc6.rpy:108
translate brazil ch3sc6_d335c11d:

#   mct "*Chuckles* She's ridiculous..."
    mct "*Risos* Ela é ridícula..."

# game/chapters/chapter3/script/ch3sc6.rpy:110
translate brazil ch3sc6_c59755f4:

#   el "Let’s go get that quest so we can begin climbing the ranks!"
    el "Vamos pegar essa missão para começarmos a subir na classificação!"

# game/chapters/chapter3/script/ch3sc6.rpy:111
translate brazil ch3sc6_be537ba6:

#   mc "Finally, a sensible suggestion."
    mc "Finalmente, uma sugestão sensata."

# game/chapters/chapter3/script/ch3sc6.rpy:113
translate brazil ch3sc6_bc575e37:

#   el "*Nudge* I'm gonna punch you!"
    el "*Cutucada* Vou te dar um soco!"

# game/chapters/chapter3/script/ch3sc6.rpy:114
translate brazil ch3sc6_b6a76ba7:

#   el "Now c'mon before you say something you'll regret!"
    el "Vamos lá, antes que você diga algo de que se arrependerá!"

# game/chapters/chapter3/script/ch3sc6.rpy:121
translate brazil ch3sc6_62d52cff:

#   mc "I don’t want to think that far ahead. We’ll just lose focus of our goal."
    mc "Não quero pensar tão longe. Só vamos perder o foco no nosso objetivo."

# game/chapters/chapter3/script/ch3sc6.rpy:123
translate brazil ch3sc6_27b6c825:

#   el "I think we could manage fine. It won’t even require much effort."
    el "Acho que conseguiríamos nos virar bem. Nem precisaria de muito esforço."

# game/chapters/chapter3/script/ch3sc6.rpy:125
translate brazil ch3sc6_f3b9030a:

#   mc "Eliza, I’m not saying no. Just leave it for later, okay?"
    mc "Eliza, eu não estou dizendo não. Só deixe para depois, tá bom?"

# game/chapters/chapter3/script/ch3sc6.rpy:127
translate brazil ch3sc6_6dfcf90c:

#   el "*Sigh* Fine, fine."
    el "*Suspiro* Tudo bem, tudo bem."

# game/chapters/chapter3/script/ch3sc6.rpy:129
translate brazil ch3sc6_5c53c707:

#   "Eliza is disappointed that you won't consider the future, her trust has increased by {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."
    "Eliza está desapontada por você não considerar o futuro, mas a confiança dela aumentou. {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc6.rpy:131
translate brazil ch3sc6_99f7165a:

#   el "But we still need to increase our ranking."
    el "Mas ainda precisamos melhorar nossa posição no ranking."

# game/chapters/chapter3/script/ch3sc6.rpy:132
translate brazil ch3sc6_f142a7ee:

#   el "Otherwise we'll be living in poverty and not be able to afford better equipment."
    el "Caso contrário, viveremos na pobreza e não teremos condições de comprar equipamentos melhores."

# game/chapters/chapter3/script/ch3sc6.rpy:133
translate brazil ch3sc6_11fe8c5e:

#   el "Or food, or ales, or tavern rooms!"
    el "Ou comida, ou cervejas, ou salas de taberna!"

# game/chapters/chapter3/script/ch3sc6.rpy:135
translate brazil ch3sc6_2b1982b6:

#   mc "You’re right."
    mc "Você tem razão."

# game/chapters/chapter3/script/ch3sc6.rpy:136
translate brazil ch3sc6_16c74c9d:

#   mc "We’ll need to earn a decent amount of coin if we want to accomplish anything."
    mc "Precisaremos ganhar uma quantia razoável de dinheiro se quisermos realizar alguma coisa."

# game/chapters/chapter3/script/ch3sc6.rpy:138
translate brazil ch3sc6_ff0fc3b1:

#   mc "Let’s go grab that quest and begin."
    mc "Vamos pegar essa missão e começar."

