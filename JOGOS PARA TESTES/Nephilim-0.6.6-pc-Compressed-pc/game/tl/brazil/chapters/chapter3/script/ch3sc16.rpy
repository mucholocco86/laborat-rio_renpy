translate brazil ch3sc16_8e7344ca:

#   sa "Help! We can't swim! Oh wait... neither can Flynn!"
    sa "Socorro! Nós não sabemos nadar! Ah, espera... o Flynn também não sabe!"

# game/chapters/chapter3/script/ch3sc16.rpy:159
translate brazil ch3sc16_6571ae4d:

#   fy "Laugh it up, ladies."
    fy "Ótimo, meninas!"

