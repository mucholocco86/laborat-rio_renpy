translate brazil ch3sc16_55db1acc:

#   fy "That has to be the worst pirate name I’ve ever heard!"
    fy "Esse deve ser o pior nome de pirata que eu já ouvi!"

# game/chapters/chapter3/script/ch3sc16.rpy:182
translate brazil ch3sc16_e0bd7735:

#   fy "C’mon you two! Let’s find a spot to set up camp before nightfall."
    fy "Vamos lá, vocês dois! Vamos encontrar um lugar para acampar antes que anoiteça."

# game/chapters/chapter3/script/ch3sc16.rpy:183
