    fy "Em breve, todos conhecerão o nome Flynn. Em todo o Mar Cerúleo!"

# game/chapters/chapter3/script/ch3sc16.rpy:162
translate brazil ch3sc16_3d48a1e2:

#   sa "Just... Flynn? That isn’t very pirate-like."
    sa "Só... Flynn? Isso não é muito a cara de um pirata."

