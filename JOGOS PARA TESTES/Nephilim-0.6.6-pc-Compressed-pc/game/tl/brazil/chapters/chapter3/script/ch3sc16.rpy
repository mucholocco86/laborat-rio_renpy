    fy "É exatamente isso que eu venho dizendo!"

# game/chapters/chapter3/script/ch3sc16.rpy:79
translate brazil ch3sc16_7d8e5a07:

#   fy "I'm so ready to leave Riverside behind for the ladies in the big city."
