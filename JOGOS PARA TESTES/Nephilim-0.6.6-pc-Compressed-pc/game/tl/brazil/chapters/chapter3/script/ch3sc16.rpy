#   al "You guys done being dramatic?"
    al "Vocês já pararam com o drama?"

# game/chapters/chapter3/script/ch3sc16.rpy:67
translate brazil ch3sc16_10086607:

#   sa "I wonderrrr what brought on this sudden change in appearance... Hmmm."
    sa "Fico pensando o que causou essa mudança repentina na aparência... Hmmm."

