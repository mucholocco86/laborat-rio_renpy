translate brazil ch3sc16_05c2d3c6:

#   al "She has a point, Flynn. You should come up with a cool pirate name that people will remember!"
    al "Ela tem razão, Flynn. Você deveria inventar um nome de pirata bacana que as pessoas vão se lembrar!"

