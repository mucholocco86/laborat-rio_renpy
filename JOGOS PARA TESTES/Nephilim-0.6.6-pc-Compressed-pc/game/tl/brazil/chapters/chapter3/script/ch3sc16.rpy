#   fy "Hmm... That’s not a bad idea."
    fy "Hum... Não é uma má ideia."

# game/chapters/chapter3/script/ch3sc16.rpy:169
translate brazil ch3sc16_b3859ecc:

#   fy "But what?"
    fy "Mas o quê?"

# game/chapters/chapter3/script/ch3sc16.rpy:171
translate brazil ch3sc16_9d3b8daf:

#   sa "Hmmmh."
    sa "Hmmm."

# game/chapters/chapter3/script/ch3sc16.rpy:173
translate brazil ch3sc16_fc9ca5bd:

#   sa "How about..."
    sa "Que tal..."

# game/chapters/chapter3/script/ch3sc16.rpy:174
translate brazil ch3sc16_e0f7c1ff:

#   sa "{b}Flynn Fairwind!{/b}"
    sa "{b}Flynn Fairwind!{/b}"

# game/chapters/chapter3/script/ch3sc16.rpy:176
translate brazil ch3sc16_82e0f235:

#   fy "I appreciate the effort, Sabby."
    fy "Agradeço o esforço, Sabby."

