# game/chapters/chapter3/script/ch3sc16.rpy:71
translate brazil ch3sc16_36547a2c:

#   al "The merchant at the market had some leftover dark pigments. So I decided to darken the color a bit."
    al "O comerciante do mercado tinha alguns pigmentos escuros que sobraram. Então, decidi escurecer um pouco a cor."

