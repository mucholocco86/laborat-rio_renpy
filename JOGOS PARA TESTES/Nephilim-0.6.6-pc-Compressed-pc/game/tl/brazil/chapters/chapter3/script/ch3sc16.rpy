translate brazil ch3sc16_6d5356e1:

#   al "I might even shorten it once we get situated in Luxenford."
    al "Talvez eu até encurte o trajeto quando estivermos instalados em Luxemburgo."

# game/chapters/chapter3/script/ch3sc16.rpy:74
translate brazil ch3sc16_279d22b6:

#   sa "Suuure Alice... whatever you say."
    sa "Claro, Alice... o que você disser."

