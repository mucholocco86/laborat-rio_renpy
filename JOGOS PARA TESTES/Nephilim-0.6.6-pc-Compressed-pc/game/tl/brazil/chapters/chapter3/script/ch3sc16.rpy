#   al "And Flynn, I’m assuming-"
    al "E Flynn, presumo eu..."

# game/chapters/chapter3/script/ch3sc16.rpy:150
translate brazil ch3sc16_7faf82ec:

#   fy "Seafarer’s Guild! The greatest guild to ever exist!"
    fy "Guilda dos Marinheiros! A maior guilda que já existiu!"

# game/chapters/chapter3/script/ch3sc16.rpy:151
translate brazil ch3sc16_569e39da:

#   fy "I'm going to conquer the Cerulean seas and all it's women!"
    fy "Vou conquistar os mares cerúleos e todas as suas mulheres!"

# game/chapters/chapter3/script/ch3sc16.rpy:153
translate brazil ch3sc16_f56dc9c7:

#   al "Hah, Yuuup! That sounds about right!"
    al "Ah, sim! Parece bem isso mesmo!"

# game/chapters/chapter3/script/ch3sc16.rpy:155
translate brazil ch3sc16_ff6b4241:

#   "Both Alice and Sabrina giggles at Flynn's excitement."
    "Tanto Alice quanto Sabrina riem baixinho da empolgação de Flynn."

