#   el "Do you think he'll leave us alone if we keep quiet?"
    el "Você acha que ele nos deixará em paz se ficarmos quietos?"

# game/chapters/chapter3/script/ch3sc27.rpy:21
translate brazil ch3sc27_6b63f93e:

#   mc "I doubt it... He’s stubborn as a mule."
    mc "Duvido... Ele é teimoso como uma mula."

# game/chapters/chapter3/script/ch3sc27.rpy:23
translate brazil ch3sc27_edfd8333:

#   br "'He' can still hear ye!"
    br "Ele ainda pode te ouvir!"

# game/chapters/chapter3/script/ch3sc27.rpy:24
translate brazil ch3sc27_43ca38a6:

#   br "C’mon, ye two. Ales are waiting downstairs!"
    br "Vamos lá, vocês dois. Tem cerveja esperando lá embaixo!"

# game/chapters/chapter3/script/ch3sc27.rpy:29
translate brazil ch3sc27_22b51210:

#   br "Ahh! There ye are! Took ye long enough."
    br "Ah! Aí estão vocês! Demorou, hein?"

# game/chapters/chapter3/script/ch3sc27.rpy:30
translate brazil ch3sc27_1c101b2f:

#   br "Eliza, ye looking mighty fine as always!"
    br "Eliza, você está maravilhosa como sempre!"

# game/chapters/chapter3/script/ch3sc27.rpy:32
translate brazil ch3sc27_9e3375c9:

#   el "T-Thank you, Borri."
    el "O-Obrigado, Borri."

# game/chapters/chapter3/script/ch3sc27.rpy:33
translate brazil ch3sc27_a26abced:

#   el "Ever the charmer, I see."
    el "Vejo que ele continua sendo um encanto."

# game/chapters/chapter3/script/ch3sc27.rpy:35
translate brazil ch3sc27_1569a045:

#   mc "Don’t compliment her too much..."
    mc "Não a elogie demais..."

# game/chapters/chapter3/script/ch3sc27.rpy:36
translate brazil ch3sc27_36a759cb:

#   mc "Her head will grow bigger than a troll's."
    mc "A cabeça dela vai crescer mais do que a de um troll."

# game/chapters/chapter3/script/ch3sc27.rpy:38
translate brazil ch3sc27_7bb5d4e8:

#   el "You know, a brute like you could learn a thing or two from a gentleman like Borri."
    el "Sabe, um bruto como você poderia aprender uma coisa ou duas com um cavalheiro como Borri."

# game/chapters/chapter3/script/ch3sc27.rpy:39
translate brazil ch3sc27_a757f155:

#   el "Maybe try complimenting me once in a blue moon!"
    el "Talvez você devesse tentar me elogiar de vez em quando!"

# game/chapters/chapter3/script/ch3sc27.rpy:42
