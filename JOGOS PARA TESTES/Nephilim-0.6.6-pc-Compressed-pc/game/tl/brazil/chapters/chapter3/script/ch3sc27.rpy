#   el "......."
    el "......."

# game/chapters/chapter3/script/ch3sc27.rpy:50
translate brazil ch3sc27_40091242:

#   "Then the two of you break eye-contact, looking away awkwardly."
    "Então vocês dois quebram o contato visual, desviando o olhar de forma constrangida."

# game/chapters/chapter3/script/ch3sc27.rpy:52
translate brazil ch3sc27_d98090a7:

#   br "What ye sulking for? Did I interrupt ye makin' babies?"
    br "Por que você está emburrada? Interrompi vocês fazendo bebês?"

# game/chapters/chapter3/script/ch3sc27.rpy:55
translate brazil ch3sc27_ce07565c:

#   el "{b}*Gasps* Borri!!{/b}"
    el "{b}*Suspiros* Borri!!{/b}"

# game/chapters/chapter3/script/ch3sc27.rpy:57
translate brazil ch3sc27_fc6a2714:

#   br "Ahh, apologies for interrupting, lass."
    br "Ah, desculpe interromper, querida."

# game/chapters/chapter3/script/ch3sc27.rpy:58
translate brazil ch3sc27_f6bab035:

#   br "I was just too excited and had to come get ye."
    br "Eu estava muito empolgado e tive que vir te buscar."

# game/chapters/chapter3/script/ch3sc27.rpy:60
translate brazil ch3sc27_2a142534:

#   mc "It’s alright, Borri..."
    mc "Está tudo bem, Borri..."

# game/chapters/chapter3/script/ch3sc27.rpy:61
translate brazil ch3sc27_4bb47979:

#   mc "And no, we were not making babies."
    mc "E não, nós não estávamos fazendo bebês."

# game/chapters/chapter3/script/ch3sc27.rpy:63
translate brazil ch3sc27_cc7486cd:

#   el "Enough about making babies!"
    el "Chega de falar sobre fazer bebês!"

# game/chapters/chapter3/script/ch3sc27.rpy:64
translate brazil ch3sc27_e8c8297d:

#   el "So... what made you so excited?"
    el "Então... o que te deixou tão animado(a)?"

# game/chapters/chapter3/script/ch3sc27.rpy:66
translate brazil ch3sc27_9a86d412:

#   br "Yer lookin' at the newest member of yer Guild, lass!"
    br "Você está olhando para a mais nova integrante da sua Guilda, garota!"

# game/chapters/chapter3/script/ch3sc27.rpy:68
translate brazil ch3sc27_72991a9c:

#   el "Owh! I knew you would manage to get accepted!"
    el "Ah! Eu sabia que você conseguiria ser aceito!"

# game/chapters/chapter3/script/ch3sc27.rpy:69
translate brazil ch3sc27_42dede9f:

#   el "Does this mean that you already completed your first quest, then?"
    el "Isso significa que você já completou sua primeira missão?"

# game/chapters/chapter3/script/ch3sc27.rpy:71
translate brazil ch3sc27_076372e0:

#   br "Aye lass! T'was easy, I tell ye!"
    br "Sim, minha querida! Foi fácil, eu te digo!"

# game/chapters/chapter3/script/ch3sc27.rpy:72
translate brazil ch3sc27_7b8de500:

#   br "I had te help this elderly lady retrieve her dead husband's heirloom."
    br "Tive que ajudar essa senhora idosa a recuperar a herança de seu falecido marido."

# game/chapters/chapter3/script/ch3sc27.rpy:74
translate brazil ch3sc27_f43521fb:

#   mc "Wait... so you basically had to babysit an old woman?"
    mc "Espera aí... então você basicamente teve que cuidar de uma senhora idosa?"

# game/chapters/chapter3/script/ch3sc27.rpy:76
translate brazil ch3sc27_c19665a6:

#   el "*Giggles* Borri! Goodness!"
    el "*Risos* Borri! Nossa!"

# game/chapters/chapter3/script/ch3sc27.rpy:77
translate brazil ch3sc27_c166e2ab:

#   el "I didn’t know you had a thing for elderly women!"
    el "Eu não sabia que você tinha uma queda por mulheres idosas!"

# game/chapters/chapter3/script/ch3sc27.rpy:79
translate brazil ch3sc27_3870199a:

#   br "Arrh! Shut yer pipes!"
    br "Argh! Cale a boca!"

# game/chapters/chapter3/script/ch3sc27.rpy:80
translate brazil ch3sc27_7af98fcd:

#   br "I know how it sounds... but it turned out te be real horse-shite!"
    br "Eu sei como soa... mas acabou sendo uma grande besteira!"

# game/chapters/chapter3/script/ch3sc27.rpy:82
translate brazil ch3sc27_b39eb0df:

#   mc "What, she needed you to carry her around?"
    mc "O quê, ela precisava que você a carregasse?"

# game/chapters/chapter3/script/ch3sc27.rpy:85
translate brazil ch3sc27_0aa77620:

#   el "*Snickers*"
    el "*Risos*"

# game/chapters/chapter3/script/ch3sc27.rpy:87
translate brazil ch3sc27_840e04b3:

#   br "Blast it!"
    br "Detone!"

# game/chapters/chapter3/script/ch3sc27.rpy:88
translate brazil ch3sc27_09c1d3dc:

#   br "Will ye listen?!"
    br "Vocês vão me ouvir?!"

# game/chapters/chapter3/script/ch3sc27.rpy:90
translate brazil ch3sc27_9df4d189:

#   mc "Okay, okay... Go on, Borri."
    mc "Ok, ok... Vai em frente, Borri."

# game/chapters/chapter3/script/ch3sc27.rpy:93
translate brazil ch3sc27_31396e50:

#   bth "*Chuckles* ... *Giggling* ..."
    bth "*Risos* ... *Garizinhos* ..."

# game/chapters/chapter3/script/ch3sc27.rpy:95
translate brazil ch3sc27_b72a29e5:

#   br "So, as I was telling ye. Big hassle!"
    br "Então, como eu estava dizendo, que complicação!"

# game/chapters/chapter3/script/ch3sc27.rpy:96
translate brazil ch3sc27_630faac1:

#   br "The heirloom had been buried with her husband years ago..."
    br "A relíquia de família havia sido enterrada com o marido dela anos atrás..."

# game/chapters/chapter3/script/ch3sc27.rpy:97
translate brazil ch3sc27_bf22034a:

#   br "We went into the graveyard to dig up the coffin... But..."
    br "Fomos ao cemitério desenterrar o caixão... Mas..."

# game/chapters/chapter3/script/ch3sc27.rpy:99
translate brazil ch3sc27_b068324e:

#   el "But..?"
    el "Mas..?"

# game/chapters/chapter3/script/ch3sc27.rpy:101
translate brazil ch3sc27_e304d67a:

#   br "The blasted thing was empty... Empty!"
    br "Aquela maldita coisa estava vazia... Vazia!"

# game/chapters/chapter3/script/ch3sc27.rpy:102
translate brazil ch3sc27_d14564d1:

#   br "*Scoffs* can ye believe it!? No heirloom and... no husband!"
    br "*Risos* Dá para acreditar?! Sem herança de família e... sem marido!"

# game/chapters/chapter3/script/ch3sc27.rpy:104
translate brazil ch3sc27_15b3b791:

#   el "Wait... so the husband isn’t dead?"
    el "Espera... então o marido não está morto?"

# game/chapters/chapter3/script/ch3sc27.rpy:106
translate brazil ch3sc27_8594f714:

#   br "Aye... well, I can’t tell ye... remains a mystery."
    br "É... bem, não posso te contar... continua sendo um mistério."

# game/chapters/chapter3/script/ch3sc27.rpy:107
translate brazil ch3sc27_62fb69a1:

#   br "The woman was shocked and she just asked me to bring her home."
    br "A mulher ficou chocada e simplesmente me pediu para levá-la para casa."

# game/chapters/chapter3/script/ch3sc27.rpy:109
translate brazil ch3sc27_9b84fe46:

#   el "Wait, you just gave up?!"
    el "Espera aí, você simplesmente desistiu?!"

# game/chapters/chapter3/script/ch3sc27.rpy:110
translate brazil ch3sc27_a4e5edc8:

#   el "You stumbled upon a real life mystery case!"
    el "Você se deparou com um verdadeiro mistério!"

# game/chapters/chapter3/script/ch3sc27.rpy:112
translate brazil ch3sc27_c2461fa4:

#   br "I had te respect her wishes... can’t just push forward if she needs time te process."
    br "Tive que respeitar os desejos dela... não posso simplesmente seguir em frente se ela precisa de tempo para processar as informações."

# game/chapters/chapter3/script/ch3sc27.rpy:114
translate brazil ch3sc27_2c81a496:

#   el "Aww... Borri."
    el "Ah... Borri."

# game/chapters/chapter3/script/ch3sc27.rpy:115
translate brazil ch3sc27_d63265c1:

#   el "That's actually really sweet of you."
    el "Isso é realmente muito gentil da sua parte."

# game/chapters/chapter3/script/ch3sc27.rpy:117
translate brazil ch3sc27_e76f7af3:

#   el "I know someone else who could be a little sweeter."
    el "Conheço outra pessoa que poderia ser um pouco mais gentil."

# game/chapters/chapter3/script/ch3sc27.rpy:118
translate brazil ch3sc27_452eb195:

#   mct "Yeah, I saw that one coming a mile away..."
    mct "É, eu já esperava por isso..."

# game/chapters/chapter3/script/ch3sc27.rpy:120
translate brazil ch3sc27_c51a176c:

#   br "I could check in with her tomorrow, and see if she wants more help with the situation."
    br "Eu poderia falar com ela amanhã e ver se ela precisa de mais ajuda com a situação."

# game/chapters/chapter3/script/ch3sc27.rpy:122
translate brazil ch3sc27_73711697:

#   el "I think that would be a good idea."
    el "Acho que seria uma boa ideia."

# game/chapters/chapter3/script/ch3sc27.rpy:123
translate brazil ch3sc27_094f8711:

#   el "Who knows? Maybe you will be able to solve the mystery!"
    el "Quem sabe? Talvez você consiga desvendar o mistério!"

# game/chapters/chapter3/script/ch3sc27.rpy:125
translate brazil ch3sc27_514fe0ea:

#   mc "I agree. The quest may have been completed, but if we only care about completing the quest... and nothing else..."
    mc "Concordo. A missão pode ter sido concluída, mas se nos importamos apenas com a conclusão da missão... e nada mais..."

# game/chapters/chapter3/script/ch3sc27.rpy:126
translate brazil ch3sc27_16d64109:

#   mc "We might as well just join the Mercenaries Guild."
    mc "É melhor nos juntarmos à Guilda dos Mercenários."

# game/chapters/chapter3/script/ch3sc27.rpy:128
translate brazil ch3sc27_782fb76d:

#   br "Yer right, lad. We’re Adventurers! The whole point is to help people, not just do the bare minimum to get our coin."
    br "É isso aí, rapaz. Somos aventureiros! O objetivo é ajudar as pessoas, não apenas fazer o mínimo necessário para ganhar dinheiro."

# game/chapters/chapter3/script/ch3sc27.rpy:130
translate brazil ch3sc27_bea1c2ab:

#   el "That’s right! Sylph told us when we joined that, as Adventurers, our duty is to... explore the unknown."
    el "Isso mesmo! Sylph nos disse quando nos juntamos a nós que, como aventureiros, nosso dever é... explorar o desconhecido."

# game/chapters/chapter3/script/ch3sc27.rpy:131
translate brazil ch3sc27_9bde2d1a:

#   el "Chase our dreams and-"
    el "Persiga seus sonhos e-"

# game/chapters/chapter3/script/ch3sc27.rpy:133
translate brazil ch3sc27_4363f03c:

#   mc "And help those in need."
    mc "E ajude aqueles que precisam."

# game/chapters/chapter3/script/ch3sc27.rpy:135
translate brazil ch3sc27_54e8a08e:

#   br "Cheers to that!"
    br "Um brinde a isso!"

# game/chapters/chapter3/script/ch3sc27.rpy:137
translate brazil ch3sc27_55969c19:

#   evr "To being Adventurers!"
    evr "Ao espírito aventureiro!"

# game/chapters/chapter3/script/ch3sc27.rpy:140
translate brazil ch3sc27_9879611e:

#   evr "Cheers!"
    evr "Saúde!"

# game/chapters/chapter3/script/ch3sc27.rpy:142
translate brazil ch3sc27_5b3b29b9:

#   sl "Hey guys! *Giggling* Looks like I arrived at the perfect time!"
    sl "Olá, pessoal! *Risos* Parece que cheguei na hora perfeita!"

# game/chapters/chapter3/script/ch3sc27.rpy:143
translate brazil ch3sc27_7838492b:

#   sl "What are you cheering for tonight?"
    sl "Para qual time você está torcendo hoje à noite?"

# game/chapters/chapter3/script/ch3sc27.rpy:145
translate brazil ch3sc27_eef54dfd:

#   el "Being Adventurers! Borri completed his first quest today!"
    el "Sendo aventureiros! Borri completou sua primeira missão hoje!"

# game/chapters/chapter3/script/ch3sc27.rpy:146
translate brazil ch3sc27_d907fdf0:

#   sl "Ahh, you’re officially one of them now, Borri?"
    sl "Ah, então agora você é oficialmente um deles, Borri?"

# game/chapters/chapter3/script/ch3sc27.rpy:148
translate brazil ch3sc27_318dbce3:

#   br "That’s right, lass! Ye do fancy Adventurers, don’t ye?"
    br "Isso mesmo, moça! Você gosta mesmo de aventureiros, não é?"

# game/chapters/chapter3/script/ch3sc27.rpy:150
translate brazil ch3sc27_29721469:

#   sl "Mmh... I sure do."
    sl "Hum... com certeza."

# game/chapters/chapter3/script/ch3sc27.rpy:151
translate brazil ch3sc27_9ff87769:

#   "Selena looks directly at you as she admits it."
    "Selena olha diretamente para você enquanto admite isso."

# game/chapters/chapter3/script/ch3sc27.rpy:153
translate brazil ch3sc27_ccff4042:

#   br "Bah! Ye don’t know what yer missin!"
    br "Bah! Vocês não sabem o que estão perdendo!"

# game/chapters/chapter3/script/ch3sc27.rpy:154
translate brazil ch3sc27_4c9f4f1b:

#   br "Sit down lass! Join us fer a round o' ales?"
    br "Sente-se, moça! Junte-se a nós para uma rodada de cervejas?"

# game/chapters/chapter3/script/ch3sc27.rpy:156
translate brazil ch3sc27_893e33fc:

#   sl "Sorry, no ales for me tonight, I was wondering if I could steal Eliza for a while?"
    sl "Desculpe, nada de cerveja para mim hoje à noite. Estava pensando se poderia roubar a Eliza por um tempinho?"

# game/chapters/chapter3/script/ch3sc27.rpy:157
translate brazil ch3sc27_a9c9618b:

#   el "Oh, you need me for something?"
    el "Ah, você precisa de mim para alguma coisa?"

# game/chapters/chapter3/script/ch3sc27.rpy:159
translate brazil ch3sc27_49865b69:

#   sl "It’s not important, if you’re busy..."
    sl "Não é importante, se você estiver ocupado..."

# game/chapters/chapter3/script/ch3sc27.rpy:160
translate brazil ch3sc27_53499e70:

#   sl "I just thought we could use a little girl time?"
    sl "Eu só pensei que poderíamos aproveitar um tempinho só para nós duas?"

# game/chapters/chapter3/script/ch3sc27.rpy:161
translate brazil ch3sc27_ed490206:

#   sl "But if you can't leave these two troublemakers alone, I get it."
    sl "Mas se você não consegue deixar esses dois encrenqueiros em paz, eu entendo."

# game/chapters/chapter3/script/ch3sc27.rpy:163
translate brazil ch3sc27_e2441c16:

#   el "Oh, please! "
    el "Ah, por favor! "

# game/chapters/chapter3/script/ch3sc27.rpy:164
translate brazil ch3sc27_560e07c5:

#   el "I’m sure these two gentlemen can handle themselves for a while. Right, guys?"
    el "Tenho certeza de que esses dois senhores conseguirão se virar por um tempo. Certo, rapazes?"

# game/chapters/chapter3/script/ch3sc27.rpy:166
translate brazil ch3sc27_608da989:

#   mc "Don’t worry about us, as long as the ale keeps flowing, I have a feeling Borri won’t leave."
    mc "Não se preocupem conosco, enquanto a cerveja continuar a fluir, tenho a sensação de que Borri não vai embora."

# game/chapters/chapter3/script/ch3sc27.rpy:168
translate brazil ch3sc27_207421ff:

#   br "Hah! Ye right on that lad! Innkeeper! Two more!"
    br "Hah! Isso mesmo, rapaz! Estalajadeiro! Mais duas!"

# game/chapters/chapter3/script/ch3sc27.rpy:170
translate brazil ch3sc27_e548df6a:

#   sl "*Giggles* Men... Let’s leave them to it, Eliza."
    sl "*Risos* Homens... Vamos deixá-los em paz, Eliza."

# game/chapters/chapter3/script/ch3sc27.rpy:171
translate brazil ch3sc27_2db28191:

#   el "Sure! See you later guys!"
    el "Claro! Até mais, pessoal!"

# game/chapters/chapter3/script/ch3sc27.rpy:173
translate brazil ch3sc27_f42c427b:

#   el "Let’s go outside, I need some fresh air! Maybe you could show me around the area of the tavern?"
    el "Vamos lá fora, preciso de ar fresco! Talvez você pudesse me mostrar os arredores da taverna?"

# game/chapters/chapter3/script/ch3sc27.rpy:174
translate brazil ch3sc27_60f41700:

#   el "I still haven’t seen much of the city."
    el "Ainda não vi grande parte da cidade."

# game/chapters/chapter3/script/ch3sc27.rpy:176
translate brazil ch3sc27_c0562430:

#   sl "Great idea! I’ll be happy to show you a bit of the city."
    sl "Ótima ideia! Terei o maior prazer em lhe mostrar um pouco da cidade."

# game/chapters/chapter3/script/ch3sc27.rpy:177
translate brazil ch3sc27_ff6b4aca:

#   sl "There's so many shops and interesting places, if you know where to look."
    sl "Há muitas lojas e lugares interessantes, se você souber onde procurar."

# game/chapters/chapter3/script/ch3sc27.rpy:180
translate brazil ch3sc27_6d65a726:

#   br "So tell me lad... What’s the deal with ye and Eliza? Ye seem to be pretty close."
    br "Então me diga, rapaz... Qual é a sua com a Eliza? Vocês parecem ser bem próximos."

# game/chapters/chapter3/script/ch3sc27.rpy:181
translate brazil ch3sc27_26fe8f7c:

#   br "Or has Selena caught yer eye? The lass seems te be takin a fancy te ye."
    br "Ou será que Selena chamou sua atenção? Parece que a moça está interessada em você."

# game/chapters/chapter3/script/ch3sc27.rpy:183
translate brazil ch3sc27_379b8d96:

#   mc "Straight to the good stuff, eh?"
    mc "Direto ao que interessa, né?"

# game/chapters/chapter3/script/ch3sc27.rpy:187
translate brazil ch3sc27_abab3f6c:

#   "Eliza’s trust increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "A confiança de Eliza aumentou em {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc27.rpy:190
translate brazil ch3sc27_faada91d:

#   mc "Eliza has grown on me ever since I met her..."
    mc "Desde que conheci Eliza, conquistei seu coração..."

# game/chapters/chapter3/script/ch3sc27.rpy:192
translate brazil ch3sc27_9ac805e4:

#   mc "There are times I might have lost control, but she has a knack for calming me."
    mc "Houve momentos em que eu poderia ter perdido o controle, mas ela tem um jeito especial de me acalmar."

# game/chapters/chapter3/script/ch3sc27.rpy:195
translate brazil ch3sc27_f2abd771:

#   mc "I'm not sure what it is, between us, but it’s definitely more than friendship."
    mc "Não sei bem o que é, entre nós, mas com certeza é mais do que amizade."

# game/chapters/chapter3/script/ch3sc27.rpy:198
translate brazil ch3sc27_cc10120c:

#   "Selena’s trust increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "A confiança de Selena aumentou em {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc27.rpy:201
translate brazil ch3sc27_bbf6eef4:

#   mc "Selena is... Well hard to explain..."
    mc "Selena é... Bem, difícil de explicar..."

# game/chapters/chapter3/script/ch3sc27.rpy:203
translate brazil ch3sc27_5904a6d9:

#   mc "I don’t know her that well yet, but there’s something about her that intrigues me."
    mc "Eu ainda não a conheço muito bem, mas há algo nela que me intriga."

# game/chapters/chapter3/script/ch3sc27.rpy:205
translate brazil ch3sc27_45809583:

#   mc "She’s damaged. Like me, she’s had a rough start to life. I guess we connect through that?"
    mc "Ela é uma pessoa traumatizada. Assim como eu, ela teve um começo de vida difícil. Acho que nos conectamos por isso?"

# game/chapters/chapter3/script/ch3sc27.rpy:208
translate brazil ch3sc27_3651e982:

#   "Alice’s trust increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "A confiança de Alice aumentou em {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc27.rpy:212
translate brazil ch3sc27_5553d207:

#   mc "Alice. My childhood friend... We grew up together."
    mc "Alice. Minha amiga de infância... Crescemos juntas."

# game/chapters/chapter3/script/ch3sc27.rpy:213
translate brazil ch3sc27_35c4d7f0:

#   mc "Up until our tenth summer, when my parents were killed."
    mc "Até o nosso décimo verão, quando meus pais foram mortos."

# game/chapters/chapter3/script/ch3sc27.rpy:215
translate brazil ch3sc27_e960daa6:

#   mc "I saw her again recently. She slapped me, deservedly, I might add. We made up afterwards, though. I hope to see her again."
    mc "Eu a vi novamente recentemente. Ela me deu um tapa, merecidamente, devo acrescentar. Mas nos reconciliamos depois. Espero vê-la novamente."

# game/chapters/chapter3/script/ch3sc27.rpy:216
translate brazil ch3sc27_05d4443a:

#   mc "The sooner the better."
    mc "Quanto mais cedo melhor."

# game/chapters/chapter3/script/ch3sc27.rpy:219
translate brazil ch3sc27_451e9cce:

#   "Borri's trust has decreased by {size=+3}{b}{color=#f00}1{/color}{/b}{/size}."
    "A confiança de Borri diminuiu em {size=+3}{b}{color=#f00}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc27.rpy:222
translate brazil ch3sc27_2ef75f4d:

#   mc "I'm not ready for a serious relationship right now."
    mc "Não estou pronto(a) para um relacionamento sério agora."

# game/chapters/chapter3/script/ch3sc27.rpy:223
translate brazil ch3sc27_8e0b4151:

#   mc "I have something I need to achieve. And I can't let emotions get in the way."
    mc "Tenho algo que preciso realizar. E não posso deixar que as emoções atrapalhem."

# game/chapters/chapter3/script/ch3sc27.rpy:226
translate brazil ch3sc27_f3b00def:

#   mc "But they are lovely girls. I could see myself with any of them."
    mc "Mas elas são garotas adoráveis. Eu me imagino com qualquer uma delas."

# game/chapters/chapter3/script/ch3sc27.rpy:227
translate brazil ch3sc27_ac86a4ec:

#   mc "I'm not sure I'd want to choose between them."
    mc "Não tenho certeza se gostaria de escolher entre eles."

# game/chapters/chapter3/script/ch3sc27.rpy:229
translate brazil ch3sc27_940400a7:

#   br "Ahh... I know yer humans favor men being able to openly play the field without consequences."
    br "Ah... eu sei que vocês, humanos, preferem que os homens possam ter vários parceiros abertamente, sem consequências."

# game/chapters/chapter3/script/ch3sc27.rpy:230
translate brazil ch3sc27_4455047d:

#   br "It's even normal for most men to take multiple wives or mistresses."
    br "É até normal que a maioria dos homens tenha várias esposas ou amantes."

# game/chapters/chapter3/script/ch3sc27.rpy:231
translate brazil ch3sc27_1a9de2d2:

#   br "I guess human and dwarven society are different. Me wife would skin me hide! *Sighs* But-..."
    br "Acho que a sociedade humana e a dos anões são diferentes. Minha esposa me esfolaria! *Suspiros* Mas..."

# game/chapters/chapter3/script/ch3sc27.rpy:232
translate brazil ch3sc27_e02e74de:

#   br "Entertaining multiple women never ends well, lad! I know it sounds enticing."
    br "Divertir várias mulheres nunca acaba bem, rapaz! Eu sei que parece tentador."

# game/chapters/chapter3/script/ch3sc27.rpy:233
translate brazil ch3sc27_d1c065ce:

#   br "Just be careful about hurting them."
    br "Tenha cuidado para não os machucar."

# game/chapters/chapter3/script/ch3sc27.rpy:234
translate brazil ch3sc27_5fb0ab29:

#   br "Human women may accept that men do as they please, but that don't mean they like it. Ye know?"
    br "As mulheres podem até aceitar que os homens façam o que bem entenderem, mas isso não significa que gostem. Entende?"

# game/chapters/chapter3/script/ch3sc27.rpy:235
translate brazil ch3sc27_56db3f63:

#   br "I may not fully agree, but even if ye want to involve yerself with all these lasses, if that's where ye heart leads ye, then go for it."
    br "Posso não concordar totalmente, mas mesmo que você queira se envolver com todas essas moças, se é isso que seu coração deseja, então vá em frente."

# game/chapters/chapter3/script/ch3sc27.rpy:238
translate brazil ch3sc27_ef82ee3c:

#   br "Love can be tricky, I tell ye, lad."
    br "O amor pode ser complicado, viu, rapaz?"

# game/chapters/chapter3/script/ch3sc27.rpy:239
translate brazil ch3sc27_471b95f1:

#   br "But if ye want some advice?"
    br "Mas se vocês quiserem algum conselho?"

# game/chapters/chapter3/script/ch3sc27.rpy:241
translate brazil ch3sc27_8c3d96ac:

#   mc "Sure... lay it on me."
    mc "Claro... pode falar à vontade."

# game/chapters/chapter3/script/ch3sc27.rpy:243
translate brazil ch3sc27_94405c95:

#   br "Be honest and follow yer heart. I know it’s something every blasted romance book tells ye..."
    br "Seja honesta e siga seu coração. Eu sei que é algo que todo livro de romance maldito diz..."

# game/chapters/chapter3/script/ch3sc27.rpy:244
translate brazil ch3sc27_3aaebb03:

#   br "But fer good reason! When ye follow yer heart, it’s the most pure and intense emotion ye'll ever feel."
    br "Mas com razão! Quando você segue seu coração, é a emoção mais pura e intensa que você jamais sentirá."

# game/chapters/chapter3/script/ch3sc27.rpy:246
translate brazil ch3sc27_e92995b2:

#   br "Nothing comes close to that feeling."
    br "Nada se compara a essa sensação."

# game/chapters/chapter3/script/ch3sc27.rpy:247
translate brazil ch3sc27_e9ea6456:

#   br "And once ye find it, protect it with everything ye have!"
    br "E quando o encontrardes, protegei-o com tudo o que tendes!"

# game/chapters/chapter3/script/ch3sc27.rpy:249
translate brazil ch3sc27_c5ff8a29:

#   mc "I... Thank you Borri."
    mc "Eu... Obrigada, Borri."

# game/chapters/chapter3/script/ch3sc27.rpy:251
translate brazil ch3sc27_b02fb217:

#   mct "I will have to figure all this out..."
    mct "Vou ter que descobrir tudo isso..."

# game/chapters/chapter3/script/ch3sc27.rpy:252
translate brazil ch3sc27_d0a7e9b6:

#   mct "I emotionally shut down after being forced to leave Rin behind..."
    mct "Eu me fechei emocionalmente depois de ser forçada a deixar Rin para trás..."

# game/chapters/chapter3/script/ch3sc27.rpy:253
translate brazil ch3sc27_889d204e:

#   mct "But since meeting Eliza... and everyone else... I've become more like my old self again."
    mct "Mas desde que conheci Eliza... e todos os outros... voltei a ser mais como eu era antes."

# game/chapters/chapter3/script/ch3sc27.rpy:254
translate brazil ch3sc27_2bc874e4:

#   mct "But I can’t afford to get distracted from my main objective. Avenging Mama and Papa."
    mct "Mas não posso me distrair do meu objetivo principal: vingar mamãe e papai."

# game/chapters/chapter3/script/ch3sc27.rpy:256
translate brazil ch3sc27_7115e053:

#   br "Hah! Don’t worry lad!"
    br "Ah! Não se preocupe, rapaz!"

# game/chapters/chapter3/script/ch3sc27.rpy:257
translate brazil ch3sc27_c7314728:

#   br "Yer young... Ye still have lots of time te figure things out! Cheers-"
    br "Você é jovem... Ainda tem muito tempo para descobrir as coisas! Saúde!"

# game/chapters/chapter3/script/ch3sc27.rpy:262
translate brazil ch3sc27_60e4cb31:

#   sl "{size=+3}{b}*Shouts* HELP!!!{/b}{/size} Somebody help!!"
    sl "{size=+3}{b}*Grita* SOCORRO!!!{/b}{/size} Alguém me ajude!!"

# game/chapters/chapter3/script/ch3sc27.rpy:264
translate brazil ch3sc27_243c71be:

#   mct "That’s Selena, Where’s Eliza?!"
    mct "Essa é a Selena, onde está a Eliza?!"

# game/chapters/chapter3/script/ch3sc27.rpy:266
translate brazil ch3sc27_54549d65:

#   mc "{b}Selena!{/b} What’s going on?"
    mc "{b}Selena!{/b} O que está acontecendo?"

# game/chapters/chapter3/script/ch3sc27.rpy:267
translate brazil ch3sc27_a08c48e2:

#   mc "Why isn’t Eliza with you?"
    mc "Por que Eliza não está com você?"

# game/chapters/chapter3/script/ch3sc27.rpy:269
translate brazil ch3sc27_9f827048:

#   sl "*Out of breath* Haah... Hhhaa... They- ... They took her!"
    sl "*Sem fôlego* Haah... Hhhaa... Eles- ... Eles a levaram!"

# game/chapters/chapter3/script/ch3sc27.rpy:271
translate brazil ch3sc27_b079f041:

#   mc "Took her? Who took her?!"
    mc "Levou-a? Quem a levou?!"

# game/chapters/chapter3/script/ch3sc27.rpy:273
translate brazil ch3sc27_f21d505d:

#   sl "*Sobbing* They jumped us in the alley..."
    sl "*Soluços* Eles nos atacaram no beco..."

# game/chapters/chapter3/script/ch3sc27.rpy:274
translate brazil ch3sc27_c415de24:

#   sl "W-We were just talking and suddenly three masked men trapped us!"
    sl "Estávamos conversando quando, de repente, três homens mascarados nos cercaram!"

# game/chapters/chapter3/script/ch3sc27.rpy:275
translate brazil ch3sc27_f5a199b8:

#   sl "We didn't stand a chance... I was knocked to the ground and they took off with Eliza."
    sl "Não tivemos a menor chance... Fui derrubado no chão e eles fugiram com a Eliza."

# game/chapters/chapter3/script/ch3sc27.rpy:277
translate brazil ch3sc27_26680458:

#   "Your pulse increases with every moment, you feel your skin becoming hot underneath the surface."
    "Seu pulso acelera a cada instante, e você sente sua pele esquentar por baixo da superfície."

# game/chapters/chapter3/script/ch3sc27.rpy:278
translate brazil ch3sc27_012f246d:

#   mct "If anything has happened to her..."
    mct "Se algo lhe aconteceu..."

# game/chapters/chapter3/script/ch3sc27.rpy:279
translate brazil ch3sc27_48f33248:

#   mct "I will descend upon this city."
    mct "Eu irei invadir esta cidade."

# game/chapters/chapter3/script/ch3sc27.rpy:283
translate brazil ch3sc27_613e948e:

#   "You rush out the door."
    "Você sai correndo pela porta."

# game/chapters/chapter3/script/ch3sc27.rpy:285
translate brazil ch3sc27_e0666ffc:

#   sl "Wait-"
    sl "Espere-"

# game/chapters/chapter3/script/ch3sc27.rpy:287
translate brazil ch3sc27_3d96c69e:

#   br "Ye okay lass? Ye must be traumatized."
    br "Você está bem, moça? Você deve estar traumatizada."

# game/chapters/chapter3/script/ch3sc27.rpy:288
translate brazil ch3sc27_a6d18d8f:

#   br "Come, let's sit..."
    br "Venha, vamos sentar..."

# game/chapters/chapter3/script/ch3sc27.rpy:290
translate brazil ch3sc27_5b6d96ab:

#   sl "It was terrible... no, I can't!"
    sl "Foi terrível... não, não consigo!"

# game/chapters/chapter3/script/ch3sc27.rpy:291
translate brazil ch3sc27_6ee286b2:

#   sl "I have to go after him!"
    sl "Tenho que ir atrás dele!"

# game/chapters/chapter3/script/ch3sc27.rpy:293
translate brazil ch3sc27_f68434e3:

#   br "{b}Blazes!{/b}"
    br "{b}Que horror!{/b}"

# game/chapters/chapter3/script/ch3sc27.rpy:294
translate brazil ch3sc27_437b4712:

#   br "What in the name of Malpheon is going on!"
    br "Que diabos está acontecendo?!"

