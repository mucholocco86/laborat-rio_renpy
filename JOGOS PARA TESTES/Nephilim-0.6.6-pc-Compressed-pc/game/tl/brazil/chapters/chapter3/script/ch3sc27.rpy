#   el "*Giggles* ..."
    el "*Risos* ..."

# game/chapters/chapter3/script/ch3sc27.rpy:46
translate brazil ch3sc27_9570cd7d:

#   "The two of you look at each other, thinking back to what was happening in the room..."
    "Vocês dois se entreolham, relembrando o que estava acontecendo na sala..."

# game/chapters/chapter3/script/ch3sc27.rpy:47
translate brazil ch3sc27_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter3/script/ch3sc27.rpy:48
