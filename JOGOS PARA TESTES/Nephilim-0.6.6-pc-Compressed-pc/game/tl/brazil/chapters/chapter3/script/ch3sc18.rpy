#   elt "'I hope to be one of them some day.' Ughrr!"
    elt "'Espero ser um deles algum dia.' Argh!"

# game/chapters/chapter3/script/ch3sc18.rpy:577
translate brazil ch3sc18_db5c8ec1:

#   elt "Where does she even come up with this horseshit?"
    elt "De onde ela tira essas besteiras?"

# game/chapters/chapter3/script/ch3sc18.rpy:579
translate brazil ch3sc18_a6d6f633:

#   elt "Oh, right! She works at a stable! *Giggles*"
    elt "Ah, é mesmo! Ela trabalha num estábulo! *Risos*"

# game/chapters/chapter3/script/ch3sc18.rpy:580
translate brazil ch3sc18_abde777b:

#   elt "Maybe if she spent less time flirting with [mc] and more time attending the horses she wouldn't need aid?"
