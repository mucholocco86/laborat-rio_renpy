translate brazil ch3sc18_6d835145:

#   br "Barhh!"
    br "Barhhh!"

# game/chapters/chapter3/script/ch3sc18.rpy:516
translate brazil ch3sc18_846f45c4:

#   br "Anywho... Selena, how did ye meet these two rascals?"
    br "Enfim... Selena, como você conheceu esses dois patifes?"

# game/chapters/chapter3/script/ch3sc18.rpy:518
translate brazil ch3sc18_46107f16:

#   sl "I was their first Quest!"
    sl "Eu fui o primeiro convidado deles!"

# game/chapters/chapter3/script/ch3sc18.rpy:520
translate brazil ch3sc18_6957bc99:

#   el "Phrasing, Selena. Phrasing!"
    el "Que maneira de se expressar, Selena. Que maneira de se expressar!"

