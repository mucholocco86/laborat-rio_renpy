    el "*Sussurra timidamente* {size=-7}{b}Você vai me fazer corar... pare com isso! *Risos*{/b}{/size}"

# game/chapters/chapter3/script/ch3sc18.rpy:480
translate brazil ch3sc18_eeddfa48:

#   "Eliza likes being caressed by you, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Eliza gosta de ser acariciada por você, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc18.rpy:485
