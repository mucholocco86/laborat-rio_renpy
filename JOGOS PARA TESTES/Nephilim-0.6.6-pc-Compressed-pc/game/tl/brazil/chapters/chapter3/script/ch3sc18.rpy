    mc "Me sinto um pouco tenso depois de hoje..."

# game/chapters/chapter3/script/ch3sc18.rpy:494
translate brazil ch3sc18_ed411cb2:

#   el "Don't worry about it..."
    el "Não se preocupe com isso..."

# game/chapters/chapter3/script/ch3sc18.rpy:495
translate brazil ch3sc18_8c3857ac:

#   el "It's been hectic since we arrived at Luxenford..."
    el "Tem sido uma correria desde que chegamos a Luxemburgo..."

# game/chapters/chapter3/script/ch3sc18.rpy:496
translate brazil ch3sc18_a27b0b01:

