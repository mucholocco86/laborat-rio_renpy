translate brazil ch3sc18_e6b2cd15:

#   mc "*Whispers* {size=-7}{b}I can't wait to get you alone...{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Mal posso esperar para ficar a sós com você...{/b}{/size}"

