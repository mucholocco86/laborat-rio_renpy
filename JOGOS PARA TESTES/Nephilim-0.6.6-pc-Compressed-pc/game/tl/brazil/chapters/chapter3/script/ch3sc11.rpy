# ARQUIVO: game/chapters/chapter3/script/ch3sc11.rpy DIALOGOS: 113


# game/chapters/chapter3/script/ch3sc11.rpy:7
translate brazil ch3sc11_bbd60795:

#   "Back at the stables..."
    "De volta aos estábulos..."

# game/chapters/chapter3/script/ch3sc11.rpy:10
translate brazil ch3sc11_021481b1:

#   sl "Will [mc] be alright on his own?"
    sl "Vai [mc] Ele vai ficar bem sozinho?"

# game/chapters/chapter3/script/ch3sc11.rpy:12
translate brazil ch3sc11_1920f01c:

#   el "Definitely! There’s much more to him than meets the eye, trust me."
    el "Com certeza! Ele é muito mais do que aparenta, acredite."

# game/chapters/chapter3/script/ch3sc11.rpy:13
translate brazil ch3sc11_3a716296:

#   el "He's saved me many times, and I've seen him take on some tough foes."
    el "Ele já me salvou muitas vezes, e eu o vi enfrentar alguns inimigos difíceis."

# game/chapters/chapter3/script/ch3sc11.rpy:15
translate brazil ch3sc11_646de2c2:

#   sl "Yeah, you're right!"
    sl "Sim, você tem razão!"

# game/chapters/chapter3/script/ch3sc11.rpy:16
translate brazil ch3sc11_6970b827:

#   sl "He was really brave and confident!"
    sl "Ele foi realmente corajoso e confiante!"

# game/chapters/chapter3/script/ch3sc11.rpy:17
translate brazil ch3sc11_5c180663:

#   sl "And did you notice how blue his eyes are?"
    sl "E você reparou como os olhos dele são azuis?"

# game/chapters/chapter3/script/ch3sc11.rpy:19
translate brazil ch3sc11_275c61b5:

#   sl "I felt like whenever he looked at me, I could just melt away!"
    sl "Eu sentia que, sempre que ele olhava para mim, eu simplesmente derretia!"

# game/chapters/chapter3/script/ch3sc11.rpy:20
translate brazil ch3sc11_ee269544:

#   sl "Maybe I'll embrace him upon his return... yes. *Giggling*"
    sl "Talvez eu o abrace quando ele voltar... sim. *Risos*"

# game/chapters/chapter3/script/ch3sc11.rpy:22
translate brazil ch3sc11_0a854612:

#   elt "E-Embrace him?! What the hell is she on about..."
    elt "E-Abraçá-lo?! Que diabos ela está falando...?"

# game/chapters/chapter3/script/ch3sc11.rpy:23
translate brazil ch3sc11_4e6e28fb:

#   elt "It almost sounds like she fancies him? Hrrhh!"
    elt "Parece até que ela está a fim dele? Hrrhh!"

# game/chapters/chapter3/script/ch3sc11.rpy:25
translate brazil ch3sc11_20876fc6:

#   el "Do you have a partner, Selena? I mean you’re beautiful and outgoing."
    el "Você tem um parceiro, Selena? Quero dizer, você é linda e extrovertida."

# game/chapters/chapter3/script/ch3sc11.rpy:27
translate brazil ch3sc11_44ca2e8b:

#   sl "That's kind of you to say. But no, I don’t have anyone. For as long I can remember, it’s only been my sister and me."
    sl "Que gentileza sua dizer isso. Mas não, eu não tenho ninguém. Desde que me lembro, só existem eu e minha irmã."

# game/chapters/chapter3/script/ch3sc11.rpy:29
translate brazil ch3sc11_a12341ac:

#   sl "Our parents couldn’t afford to feed all their children anymore, so they sent us on our way."
    sl "Nossos pais não tinham mais condições de alimentar todos os filhos, então nos mandaram embora."

# game/chapters/chapter3/script/ch3sc11.rpy:31
translate brazil ch3sc11_923d15ef:

#   sl "Less mouths to feed, you see? So my sister and I had to make our own way growing up."
    sl "Menos bocas para alimentar, entende? Então, minha irmã e eu tivemos que trilhar nosso próprio caminho enquanto crescíamos."

# game/chapters/chapter3/script/ch3sc11.rpy:32
translate brazil ch3sc11_1595f1cc:

#   sl "I managed to get us on aboard a ship sailing from Arazalia to Luxenford."
    sl "Consegui embarcar em um navio que fazia a rota Arazalia-Luxemburgo."

# game/chapters/chapter3/script/ch3sc11.rpy:34
translate brazil ch3sc11_61366ed8:

#   sl "We lived on the streets of Luxenford for years."
    sl "Moramos nas ruas de Luxenford durante anos."

# game/chapters/chapter3/script/ch3sc11.rpy:35
translate brazil ch3sc11_9037a6c8:

#   sl "It-it was rough..."
    sl "Foi difícil..."

# game/chapters/chapter3/script/ch3sc11.rpy:36
translate brazil ch3sc11_3207de49:

#   sl "But I finally landed this job as a stablemaiden. Things have been looking up since then."
    sl "Mas finalmente consegui este emprego como tratadora de cavalos. As coisas têm melhorado desde então."

# game/chapters/chapter3/script/ch3sc11.rpy:38
translate brazil ch3sc11_bc6300e1:

#   sl "I’m able to pay for a room at a tavern and warm meals now. So everything has worked out."
    sl "Agora consigo pagar um quarto numa taverna e refeições quentes. Então, no fim, tudo deu certo."

# game/chapters/chapter3/script/ch3sc11.rpy:40
translate brazil ch3sc11_d439e5ee:

#   el "Oh, I’m sorry to hear you had to go through all that. At least you have your sister."
    el "Nossa, sinto muito que você tenha passado por tudo isso. Pelo menos você tem sua irmã."

# game/chapters/chapter3/script/ch3sc11.rpy:41
translate brazil ch3sc11_0f083f51:

#   el "I'm sure she appreciates you watching out for her."
    el "Tenho certeza de que ela aprecia que você esteja cuidando dela."

# game/chapters/chapter3/script/ch3sc11.rpy:43
translate brazil ch3sc11_12eb7776:

#   sl "Yeah..."
    sl "Sim..."

# game/chapters/chapter3/script/ch3sc11.rpy:44
translate brazil ch3sc11_a4850df0:

#   sl "M-My sister..."
    sl "M-Minha irmã..."

# game/chapters/chapter3/script/ch3sc11.rpy:46
translate brazil ch3sc11_4f554ac7:

#   "Selena falls quiet... she seems lost in thought."
    "Selena fica em silêncio... parece perdida em pensamentos."

# game/chapters/chapter3/script/ch3sc11.rpy:52
translate brazil ch3sc11_e40e4d7c:

#   mc "Hey, girls. I see you made it back in one piece."
    mc "Olá, meninas. Vejo que vocês voltaram ilesas."

# game/chapters/chapter3/script/ch3sc11.rpy:53
translate brazil ch3sc11_99d033ef:

#   "As soon as Selena hears your voice she gets up in a hurry."
    "Assim que Selena ouve sua voz, ela se levanta rapidamente."

# game/chapters/chapter3/script/ch3sc11.rpy:55
translate brazil ch3sc11_703e66df:

#   sl "[mc]!!"
    sl "[mc]!!"

# game/chapters/chapter3/script/ch3sc11.rpy:56
translate brazil ch3sc11_dd0e3ea0:

#   sl "You're finally back!"
    sl "Você finalmente voltou!"

# game/chapters/chapter3/script/ch3sc11.rpy:58
translate brazil ch3sc11_d91198fe:

#   sl "I’m so glad you’re safe!"
    sl "Que bom que você está em segurança!"

# game/chapters/chapter3/script/ch3sc11.rpy:59
translate brazil ch3sc11_2c8a9104:

#   sl "You had me so worried!"
    sl "Você me deixou tão preocupado(a)!"

# game/chapters/chapter3/script/ch3sc11.rpy:62
translate brazil ch3sc11_805ef1ea:

#   "She wraps her arms around your waist leaning against you."
    "Ela te abraça pela cintura, encostando-se em você."

# game/chapters/chapter3/script/ch3sc11.rpy:64
translate brazil ch3sc11_834de56c:

#   elt "..."
    elt "..."

# game/chapters/chapter3/script/ch3sc11.rpy:65
translate brazil ch3sc11_dbf85e34:

#   elt "Seriously?"
    elt "Seriamente?"

# game/chapters/chapter3/script/ch3sc11.rpy:67
translate brazil ch3sc11_65f61e9a:

#   sl "I’m really glad you’re back and the giant wolf didn’t eat you!"
    sl "Que bom que você voltou e que o lobo gigante não te comeu!"

# game/chapters/chapter3/script/ch3sc11.rpy:68
translate brazil ch3sc11_6517bd58:

#   mc "*Chuckles* The wolf won't bother you or any of your horses any longer."
    mc "*Risos* O lobo não vai mais incomodar você nem seus cavalos."

# game/chapters/chapter3/script/ch3sc11.rpy:69
translate brazil ch3sc11_3ff31004:

#   sl "*Giggling* My hero... thank you so much!"
    sl "*Risos* Meu herói... muito obrigada!"

# game/chapters/chapter3/script/ch3sc11.rpy:71
translate brazil ch3sc11_54de1df5:

#   elt "What the hell? Is this girl for real?"
    elt "Que diabos? Essa garota está falando sério?"

# game/chapters/chapter3/script/ch3sc11.rpy:72
translate brazil ch3sc11_45df756b:

#   elt "Hnrrrhh..."
    elt "Hnrrrh..."

# game/chapters/chapter3/script/ch3sc11.rpy:74
translate brazil ch3sc11_089c4c18:

#   elt "*Sigh* I know I shouldn't be jealous. She's probably just worried about him... But still."
    elt "*Suspiro* Eu sei que não deveria ter ciúmes. Ela provavelmente só está preocupada com ele... Mas mesmo assim."

# game/chapters/chapter3/script/ch3sc11.rpy:79
translate brazil ch3sc11_c7699b4b:

#   elt "So annoying. Why is she hugging him like that?"
    elt "Que irritante. Por que ela está o abraçando assim?"

# game/chapters/chapter3/script/ch3sc11.rpy:80
translate brazil ch3sc11_53a83272:

#   elt "She doesn't even know him!"
    elt "Ela nem o conhece!"

# game/chapters/chapter3/script/ch3sc11.rpy:82
translate brazil ch3sc11_85de5e8e:

#   mc "Hey, Kitten."
    mc "Ei, gatinho(a)."

# game/chapters/chapter3/script/ch3sc11.rpy:84
translate brazil ch3sc11_f778e459:

#   elt "Mmhpff! He noticed!"
    elt "Mmhpff! Ele percebeu!"

# game/chapters/chapter3/script/ch3sc11.rpy:86
translate brazil ch3sc11_a1e70291:

#   elt "He’s so sweet."
    elt "Ele é tão doce."

# game/chapters/chapter3/script/ch3sc11.rpy:87
translate brazil ch3sc11_f96b9571:

#   elt "Mhm... He knows how much I like it when he scratches my head."
    elt "Hum... Ele sabe o quanto eu gosto quando ele coça minha cabeça."

# game/chapters/chapter3/script/ch3sc11.rpy:89
translate brazil ch3sc11_bd1badb6:

#   mc "Well done keeping Selena safe... I’m proud of you."
    mc "Muito bem por manter a Selena em segurança... Estou orgulhoso de você."

# game/chapters/chapter3/script/ch3sc11.rpy:91
translate brazil ch3sc11_c7b299fd:

#   elt "Heavens! It feels so good to hear him say that."
    elt "Nossa! É tão bom ouvi-lo dizer isso."

# game/chapters/chapter3/script/ch3sc11.rpy:92
translate brazil ch3sc11_2000a58f:

#   elt "I did good... He's proud of me."
    elt "Eu me saí bem... Ele está orgulhoso de mim."

# game/chapters/chapter3/script/ch3sc11.rpy:94
translate brazil ch3sc11_702ab43c:

#   elt "If only Selena wasn’t here..."
    elt "Se ao menos Selena não estivesse aqui..."

# game/chapters/chapter3/script/ch3sc11.rpy:96
translate brazil ch3sc11_54d62fb6:

#   elt "I’d jump him right here- Nyaah..."
    elt "Eu pularia em cima dele aqui mesmo - Nyaah..."

# game/chapters/chapter3/script/ch3sc11.rpy:97
translate brazil ch3sc11_fdd517d6:

#   elt "He could toss me around in the hay... rip off my clothes with a hunger for my body..."
    elt "Ele poderia me jogar de um lado para o outro no feno... arrancar minhas roupas com uma fome insaciável pelo meu corpo..."

# game/chapters/chapter3/script/ch3sc11.rpy:98
translate brazil ch3sc11_d4fa8544:

#   elt "I'd eagerly kiss his neck as he pushes me down..."
    elt "Eu beijaria ansiosamente o pescoço dele enquanto ele me empurrasse para baixo..."

# game/chapters/chapter3/script/ch3sc11.rpy:99
translate brazil ch3sc11_b2bc3cee:

#   elt "."
    elt "."

# game/chapters/chapter3/script/ch3sc11.rpy:100
translate brazil ch3sc11_b0dad5ab:

#   elt ".."
    elt "..."

# game/chapters/chapter3/script/ch3sc11.rpy:103
translate brazil ch3sc11_fd649f51:

#   el "[mc]... I-"
    el "[mc]... EU-"

# game/chapters/chapter3/script/ch3sc11.rpy:108
translate brazil ch3sc11_d77c8d1c:

#   mc "Good job keeping her safe. We’ve completed our first quest."
    mc "Bom trabalho em mantê-la segura. Concluímos nossa primeira missão."

# game/chapters/chapter3/script/ch3sc11.rpy:110
translate brazil ch3sc11_49c23ee8:

#   el "Oh, thank you. It wasn't a problem."
    el "Ah, obrigada. Não houve problema algum."

# game/chapters/chapter3/script/ch3sc11.rpy:114
translate brazil ch3sc11_20dbea54:

#   sl "You guys actually did it!"
    sl "Vocês realmente conseguiram!"

# game/chapters/chapter3/script/ch3sc11.rpy:115
translate brazil ch3sc11_c67c1808:

#   sl "I'm glad we requested help from the Adventurer's Guild."
    sl "Fico feliz por termos solicitado ajuda da Guilda dos Aventureiros."

# game/chapters/chapter3/script/ch3sc11.rpy:117
translate brazil ch3sc11_797e0cbf:

#   el "Did you ever doubt us? We had it all under control."
    el "Alguma vez você duvidou de nós? Tínhamos tudo sob controle."

# game/chapters/chapter3/script/ch3sc11.rpy:119
translate brazil ch3sc11_8bd28401:

#   sl "Honestly, I thought I was a goner for a while there."
    sl "Sinceramente, por um tempo achei que ia morrer."

# game/chapters/chapter3/script/ch3sc11.rpy:121
translate brazil ch3sc11_2fb12f88:

#   sl "[mc] and Eliza, thank you both so much! You saved my life. I-I won’t forget what you did."
    sl "[mc] Eliza, muito obrigada a vocês duas! Vocês salvaram minha vida. Jamais esquecerei o que fizeram."

# game/chapters/chapter3/script/ch3sc11.rpy:122
translate brazil ch3sc11_f3026fdb:

#   sl "If I can do anything to repay you, don't hesitate to mention it!"
    sl "Se eu puder fazer algo para te retribuir, não hesite em mencionar!"

# game/chapters/chapter3/script/ch3sc11.rpy:124
translate brazil ch3sc11_925dec43:

#   el "Don’t worry about it, Selena."
    el "Não se preocupe com isso, Selena."

# game/chapters/chapter3/script/ch3sc11.rpy:125
translate brazil ch3sc11_bfc50987:

#   el "We’re just happy we could help. Isn’t that right, [mc]?"
    el "Estamos felizes por termos podido ajudar. Não é verdade? [mc]?"

# game/chapters/chapter3/script/ch3sc11.rpy:127
translate brazil ch3sc11_7e509022:

#   mc "Sure... What she said."
    mc "Claro... Concordo com o que ela disse."

# game/chapters/chapter3/script/ch3sc11.rpy:129
translate brazil ch3sc11_9165c3b6:

#   el "He’s not one for socializing. But I’m working on improving that."
    el "Ele não é muito de socializar. Mas estou trabalhando para melhorar isso."

# game/chapters/chapter3/script/ch3sc11.rpy:131
translate brazil ch3sc11_ecc59f8c:

#   el "Believe it or not, he’s already come a long way from when I first met him."
    el "Acredite ou não, ele já percorreu um longo caminho desde que o conheci."

# game/chapters/chapter3/script/ch3sc11.rpy:133
translate brazil ch3sc11_a7fc60ad:

#   el "*Smirks* I can tell I still have work to do."
    el "*Sorri de canto de boca* Percebo que ainda tenho trabalho a fazer."

# game/chapters/chapter3/script/ch3sc11.rpy:135
translate brazil ch3sc11_0c027dba:

#   sl "Oh, I see! It’s no trouble really, I don’t mind!"
    sl "Ah, entendi! Não tem problema nenhum, não me importo!"

# game/chapters/chapter3/script/ch3sc11.rpy:137
translate brazil ch3sc11_383e519a:

#   sl "I’ll be sure to send word to your guild right away that the task has been completed to my satisfaction!"
    sl "Avisarei imediatamente a sua guilda que a tarefa foi concluída a contento!"

# game/chapters/chapter3/script/ch3sc11.rpy:139
translate brazil ch3sc11_5c55f02c:

#   sl "Thank you, Selena. That would be great!"
    sl "Obrigada, Selena. Seria ótimo!"

# game/chapters/chapter3/script/ch3sc11.rpy:140
translate brazil ch3sc11_fb6e362f:

#   el "This was our first quest for the Guild. I'm sure they will be happy to hear that it went well."
    el "Essa foi nossa primeira missão para a Guilda. Tenho certeza de que eles ficarão felizes em saber que correu tudo bem."

# game/chapters/chapter3/script/ch3sc11.rpy:142
translate brazil ch3sc11_508f99eb:

#   sl "I don’t feel like it’s nearly enough!"
    sl "Não acho que seja suficiente!"

# game/chapters/chapter3/script/ch3sc11.rpy:143
translate brazil ch3sc11_edb850d3:

#   sl "You guys saved my life after all."
    sl "Vocês salvaram minha vida, afinal."

# game/chapters/chapter3/script/ch3sc11.rpy:145
translate brazil ch3sc11_6011ed6e:

#   el "That’s part of the job description as adventurers! We help where we can."
    el "Isso faz parte da descrição do trabalho de aventureiros! Ajudamos no que podemos."

# game/chapters/chapter3/script/ch3sc11.rpy:147
translate brazil ch3sc11_2dc46147:

#   el "We're just happy to get our feet wet!"
    el "Estamos simplesmente felizes por poder dar os primeiros passos!"

# game/chapters/chapter3/script/ch3sc11.rpy:149
translate brazil ch3sc11_135a27c7:

#   sl "Still. Hmm..."
    sl "Ainda assim. Hum..."

# game/chapters/chapter3/script/ch3sc11.rpy:151
translate brazil ch3sc11_875991de:

#   sl "HmmmHmmmhh ..."
    sl "HmmmHmmmhh ..."

# game/chapters/chapter3/script/ch3sc11.rpy:153
translate brazil ch3sc11_698621ba:

#   sl "Hey, I’ve got an idea! Why don’t we meet up at a tavern later?"
    sl "Ei, tive uma ideia! Que tal nos encontrarmos em uma taverna mais tarde?"

# game/chapters/chapter3/script/ch3sc11.rpy:154
translate brazil ch3sc11_21f402fa:

#   sl "You guys said you're new to Luxenford, so you'll definitely need to know which taverns are worth your coin!"
    sl "Vocês disseram que são novos em Luxenford, então com certeza precisam saber quais tavernas valem a pena!"

# game/chapters/chapter3/script/ch3sc11.rpy:156
translate brazil ch3sc11_46544c55:

#   "Eliza glances at you, smiling."
    "Eliza olha para você, sorrindo."

# game/chapters/chapter3/script/ch3sc11.rpy:158
translate brazil ch3sc11_a4cb2547:

#   mc "We-"
    mc "Nós-"

# game/chapters/chapter3/script/ch3sc11.rpy:160
translate brazil ch3sc11_75d25a4a:

#   el "Sounds great! We'd love that!"
    el "Ótimo! Adoraríamos!"

# game/chapters/chapter3/script/ch3sc11.rpy:161
translate brazil ch3sc11_628afe7d:

#   mc "*Exhales* ..."
    mc "*Exala* ..."

# game/chapters/chapter3/script/ch3sc11.rpy:163
translate brazil ch3sc11_d4e0cfe7:

#   sl "Yay! Ales on me! As thanks for everything."
    sl "Eba! Cerveja por minha conta! Como agradecimento por tudo."

# game/chapters/chapter3/script/ch3sc11.rpy:164
translate brazil ch3sc11_73b83be8:

#   sl "We'll spare no expense! *Giggling*"
    sl "Não vamos poupar despesas! *Risos*"

# game/chapters/chapter3/script/ch3sc11.rpy:167
translate brazil ch3sc11_854319de:

#   el "Did you hear that, [mc]? Free ales! {b}Yahoo!{/b}"
    el "Você ouviu isso? [mc] Cervejas grátis! {b} Yahoo!{/b}"

# game/chapters/chapter3/script/ch3sc11.rpy:169
translate brazil ch3sc11_61a39aa2:

#   el "We’re going to celebrate our first quest being a complete success!!"
    el "Vamos comemorar o sucesso total da nossa primeira missão!!"

# game/chapters/chapter3/script/ch3sc11.rpy:171
translate brazil ch3sc11_9a1029ba:

#   mc "I guess that settles it."
    mc "Acho que isso resolve tudo."

# game/chapters/chapter3/script/ch3sc11.rpy:172
translate brazil ch3sc11_a9fbc5cf:

#   mc "*Sigh* ... We'll see you later, Selena. Thank you for inviting us."
    mc "*Suspiro* ... Até mais, Selena. Obrigada pelo convite."

# game/chapters/chapter3/script/ch3sc11.rpy:174
translate brazil ch3sc11_29e7571d:

#   sl "*Giggle* See you, [mc]! I’m looking forward to treating you!"
    sl "*Risos* Até logo, [mc] Estou ansiosa para te atender!"

# game/chapters/chapter3/script/ch3sc11.rpy:175
translate brazil ch3sc11_cb561660:

#   sl "Look for the tavern, 'The Drunken Rooster'! That's my favorite!"
    sl "Procurem a taverna \"O Galo Bêbado\"! É a minha favorita!"

# game/chapters/chapter3/script/ch3sc11.rpy:177
translate brazil ch3sc11_ae5c4f52:

#   mc "The Drunken Rooster, got it."
    mc "O Galo Bêbado, entendeu?"

# game/chapters/chapter3/script/ch3sc11.rpy:178
translate brazil ch3sc11_cf2c68fe:

#   mc "Eliza, let’s head back to the guild and collect our reward."
    mc "Eliza, vamos voltar para a guilda e receber nossa recompensa."

# game/chapters/chapter3/script/ch3sc11.rpy:179
translate brazil ch3sc11_d420a191:

#   el "*Nods* Mh-hm."
    el "*Acena com a cabeça* Hum-hum."

# game/chapters/chapter3/script/ch3sc11.rpy:181
translate brazil ch3sc11_2cdd6224:

#   el "Thank you Selena, we’ll meet you later!"
    el "Obrigada, Selena! Nos vemos mais tarde!"

# game/chapters/chapter3/script/ch3sc11.rpy:182
translate brazil ch3sc11_8a67030d:

#   el "I look forward to sharing ales!"
    el "Estou ansioso para compartilhar cervejas!"

# game/chapters/chapter3/script/ch3sc11.rpy:186
translate brazil ch3sc11_e0ae34e1:

#   slt "He’s an interesting one."
    slt "Ele é uma figura interessante."

# game/chapters/chapter3/script/ch3sc11.rpy:187
translate brazil ch3sc11_c4cb9bd0:

#   slt "There’s more to him than meets the eye, that's for sure."
    slt "Ele é muito mais do que aparenta, disso não há dúvida."

