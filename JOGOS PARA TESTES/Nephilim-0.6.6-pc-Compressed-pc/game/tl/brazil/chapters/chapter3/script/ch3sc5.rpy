translate brazil ch3sc5_e4991734:

#   el "Let’s take a look in here, they might have something useful?"
    el "Vamos dar uma olhada aqui, talvez encontrem algo útil?"

# game/chapters/chapter3/script/ch3sc5.rpy:13
translate brazil ch3sc5_b6426668:

#   mc "*The Hag’s Cauldron* Charming name."
    mc "*O Caldeirão da Bruxa* Nome encantador."

# game/chapters/chapter3/script/ch3sc5.rpy:15
