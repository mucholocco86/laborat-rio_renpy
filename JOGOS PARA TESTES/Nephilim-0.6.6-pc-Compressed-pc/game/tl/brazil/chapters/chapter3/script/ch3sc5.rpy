    "..."

# game/chapters/chapter3/script/ch3sc5.rpy:99
translate brazil ch3sc5_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter3/script/ch3sc5.rpy:101
translate brazil ch3sc5_7a018181:

#   mc "No rush..."
    mc "Sem pressa..."

# game/chapters/chapter3/script/ch3sc5.rpy:102
translate brazil ch3sc5_183d08f1:

#   mc "No rush, at all."
    mc "Sem pressa nenhuma."

# game/chapters/chapter3/script/ch3sc5.rpy:111
translate brazil ch3sc5_89f9c164:

#   "Eliza gives you a hard nudge, signaling you to behave."
    "Eliza te dá um empurrãozinho firme, sinalizando para você se comportar."

# game/chapters/chapter3/script/ch3sc5.rpy:113
translate brazil ch3sc5_a54f6cf9:

#   mct "If looks could kill, I’d already have one foot in the grave."
    mct "Se olhares matassem, eu já estaria com um pé na cova."

# game/chapters/chapter3/script/ch3sc5.rpy:114
translate brazil ch3sc5_782272e3:

#   mct "Still cute, though."
    mct "Mesmo assim, continua fofo."

# game/chapters/chapter3/script/ch3sc5.rpy:116
translate brazil ch3sc5_10790e3e:

#   el "*Whispers* {size=-10}{b}Cut it out!{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Pare com isso!{/b}{/size}"

# game/chapters/chapter3/script/ch3sc5.rpy:117
translate brazil ch3sc5_2c449112:

#   el "*Whispers* {size=-10}{b}We're here to buy supplies! You big oaf...{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Viemos comprar suprimentos! Seu grandalhão...{/b}{/size}"

# game/chapters/chapter3/script/ch3sc5.rpy:119
translate brazil ch3sc5_980448d6:

#   el "."
    el "."

