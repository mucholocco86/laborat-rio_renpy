translate brazil ch3sc28_f0396bb0:

#   mct "I have to focus on her scent..."
    mct "Preciso me concentrar no perfume dela..."

# game/chapters/chapter3/script/ch3sc28.rpy:182
translate brazil ch3sc28_440493ce:

#   mct "Just like Oren taught me."
    mct "Exatamente como Oren me ensinou."

