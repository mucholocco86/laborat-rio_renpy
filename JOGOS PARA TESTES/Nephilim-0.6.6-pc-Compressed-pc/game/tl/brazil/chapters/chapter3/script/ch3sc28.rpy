#   ta "Leave."
    ta "Deixar."

# game/chapters/chapter3/script/ch3sc28.rpy:166
translate brazil ch3sc28_98ce727f:

#   ta "Before my goodwill runs out."
    ta "Antes que minha boa vontade acabe."

# game/chapters/chapter3/script/ch3sc28.rpy:168
translate brazil ch3sc28_3c76dcfd:

#   slt "Bastard!"
    slt "Desgraçado!"

# game/chapters/chapter3/script/ch3sc28.rpy:169
translate brazil ch3sc28_5e9203d5:

#   ta "*Chuckles* Hm-hm-hm..."
    ta "*Risos* Hm-hm-hm..."

# game/chapters/chapter3/script/ch3sc28.rpy:171
translate brazil ch3sc28_a9f14355:

#   slt "[mc]... Eliza... I’m sorry."
    slt "[mc]... Eliza... Me desculpe."

# game/chapters/chapter3/script/ch3sc28.rpy:172
translate brazil ch3sc28_a3f67e9f:

#   slt "I-... I had no choice."
    slt "Eu... eu não tive escolha."

