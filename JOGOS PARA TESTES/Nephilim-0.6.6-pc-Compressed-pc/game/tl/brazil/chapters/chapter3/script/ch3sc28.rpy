translate brazil ch3sc28_cdf45260:

#   sl "Are you going to harm them?"
    sl "Você vai machucá-los?"

# game/chapters/chapter3/script/ch3sc28.rpy:156
translate brazil ch3sc28_8fc7be32:

#   ta "Yes."
    ta "Sim."

# game/chapters/chapter3/script/ch3sc28.rpy:158
translate brazil ch3sc28_1c771aa2:

#   sl "Why-"
    sl "Por que-"

# game/chapters/chapter3/script/ch3sc28.rpy:160
translate brazil ch3sc28_5e43202a:

#   ta "You don't need to know, little dove."
    ta "Você não precisa saber, minha pequena pomba."

