#   ta "Aren't you in a rush for your reunion with your sweet baby-sis?"
    ta "Você não está com pressa para o reencontro com sua querida irmãzinha?"

# game/chapters/chapter3/script/ch3sc28.rpy:163
translate brazil ch3sc28_1f9818f8:

#   sl "If you-"
    sl "Se você-"

# game/chapters/chapter3/script/ch3sc28.rpy:165
