# ARQUIVO: game/chapters/chapter3/script/ch3sc2.rpy DIALOGOS: 89


# game/chapters/chapter3/script/ch3sc2.rpy:13
translate brazil ch3sc2_d420f26c:

#   el "I wonder why we need a city-pass?"
    el "Por que será que precisamos de um passe para a cidade?"

# game/chapters/chapter3/script/ch3sc2.rpy:14
translate brazil ch3sc2_cfa203aa:

#   el "We didn’t hear any mention of it earlier on our travels."
    el "Não tínhamos ouvido falar disso anteriormente durante nossas viagens."

# game/chapters/chapter3/script/ch3sc2.rpy:16
translate brazil ch3sc2_ff2bb217:

#   mc "It could be a recent thing."
    mc "Pode ser algo recente."

# game/chapters/chapter3/script/ch3sc2.rpy:17
translate brazil ch3sc2_6606d4b4:

#   mc "Maybe something has happened recently that travelers wouldn't know about?"
    mc "Talvez tenha acontecido algo recentemente que os viajantes desconheçam?"

# game/chapters/chapter3/script/ch3sc2.rpy:19
translate brazil ch3sc2_976432f7:

#   el "We'd better remember to get ours at the guild. We might have gotten lucky this time."
    el "É melhor lembrarmos de pegar o nosso na guilda. Talvez tenhamos tido sorte desta vez."

# game/chapters/chapter3/script/ch3sc2.rpy:20
translate brazil ch3sc2_c2a2683e:

#   el "I suspect not every guard is easily manipulated."
    el "Suspeito que nem todos os guardas sejam facilmente manipuláveis."

# game/chapters/chapter3/script/ch3sc2.rpy:22
translate brazil ch3sc2_0816aa65:

#   el "You handled it well back there, but..."
    el "Você lidou bem com a situação lá atrás, mas..."

# game/chapters/chapter3/script/ch3sc2.rpy:24
translate brazil ch3sc2_5c92f934:

#   el "We can't rely on you intimidating the guards."
    el "Não podemos contar com você para intimidar os guardas."

# game/chapters/chapter3/script/ch3sc2.rpy:27
translate brazil ch3sc2_1d6034c6:

#   el "We can't rely on you persuading the guards with your charms."
    el "Não podemos contar com o seu charme para persuadir os guardas."

# game/chapters/chapter3/script/ch3sc2.rpy:29
translate brazil ch3sc2_b405f7b9:

#   el "Milton was rather easy to sway, I doubt all the guards will be though."
    el "Milton era bastante fácil de influenciar, mas duvido que todos os guardas sejam."

# game/chapters/chapter3/script/ch3sc2.rpy:31
translate brazil ch3sc2_340db6bd:

#   el "And I can't emphasize how much I don't want to see the inside of a cell."
    el "E não consigo enfatizar o quanto eu não quero ver o interior de uma cela."

# game/chapters/chapter3/script/ch3sc2.rpy:33
translate brazil ch3sc2_670ad2a4:

#   mc "Are you doubting my social skills? You’re the one teaching me."
    mc "Você está duvidando das minhas habilidades sociais? Você é quem está me ensinando."

# game/chapters/chapter3/script/ch3sc2.rpy:34
translate brazil ch3sc2_93f527c9:

#   mc "I was using what my teacher has bestowed upon me. *Chuckles*"
    mc "Eu estava usando o que meu professor me transmitiu. *Risos*"

# game/chapters/chapter3/script/ch3sc2.rpy:36
translate brazil ch3sc2_833875f7:

#   el "And you’ve definitely been improving! But don’t get cocky on me, mister!"
    el "E você definitivamente tem melhorado! Mas não fique convencido demais, meu caro!"

# game/chapters/chapter3/script/ch3sc2.rpy:38
translate brazil ch3sc2_e05da28e:

#   mc "You said it yourself, the student will surpass the teacher."
    mc "Você mesmo disse, o aluno superará o professor."

# game/chapters/chapter3/script/ch3sc2.rpy:40
translate brazil ch3sc2_4a387bdb:

#   el "I-I... I was... that’s not the same! Urrh!"
    el "II... Eu estava... isso não é a mesma coisa! Urrh!"

# game/chapters/chapter3/script/ch3sc2.rpy:41
translate brazil ch3sc2_580c194a:

#   el "You still have a long way to go. Especially when it comes to dealing with nobles."
    el "Você ainda tem um longo caminho a percorrer. Principalmente quando se trata de lidar com a nobreza."

# game/chapters/chapter3/script/ch3sc2.rpy:42
translate brazil ch3sc2_3e8af967:

#   el "So don't go getting too confident just yet."
    el "Portanto, não fique confiante demais ainda."

# game/chapters/chapter3/script/ch3sc2.rpy:44
translate brazil ch3sc2_52219eb9:

#   el "Come on! Let’s just find the guild hall."
    el "Vamos lá! Vamos encontrar a sede da guilda."

# game/chapters/chapter3/script/ch3sc2.rpy:45
translate brazil ch3sc2_0c13ec59:

#   mc "Shouldn't be much further, I was told it'd be near the plaza we passed thirty minutes ago."
    mc "Não deve ser muito mais longe, me disseram que seria perto da praça por onde passamos há trinta minutos."

# game/chapters/chapter3/script/ch3sc2.rpy:50
translate brazil ch3sc2_6d155d97:

#   "Your intel proved correct, the two of you arrive at the guild headquarters fifteen minutes later."
    "Suas informações se provaram corretas, e vocês dois chegaram à sede da guilda quinze minutos depois."

# game/chapters/chapter3/script/ch3sc2.rpy:53
translate brazil ch3sc2_e8b42937:

#   el "Phew! I was starting to think we wouldn't find it before sundown."
    el "Ufa! Já estava começando a achar que não encontraríamos antes do pôr do sol."

# game/chapters/chapter3/script/ch3sc2.rpy:55
translate brazil ch3sc2_1aa057f9:

#   mc "You're being dramatic... It only took us two, maybe three hours from the city-gates."
    mc "Você está sendo dramático... Levamos apenas duas, talvez três horas desde os portões da cidade."

# game/chapters/chapter3/script/ch3sc2.rpy:56
translate brazil ch3sc2_3504e176:

#   mc "With the amount of winding streets and tall buildings, it's hard to navigate as newcomers."
    mc "Com a quantidade de ruas sinuosas e prédios altos, é difícil para os recém-chegados se orientarem."

# game/chapters/chapter3/script/ch3sc2.rpy:63
translate brazil ch3sc2_7214e2b9:

#   mct "Cozy. Although a little worn down..."
    mct "Aconchegante. Embora um pouco desgastado..."

# game/chapters/chapter3/script/ch3sc2.rpy:64
translate brazil ch3sc2_43a9f8ff:

#   mct "I kinda expected it to be more... lively?"
    mct "Eu esperava que fosse mais... animado?"

# game/chapters/chapter3/script/ch3sc2.rpy:66
translate brazil ch3sc2_b4989a74:

#   el "This place is amazing! Can you believe we’re really here? {size=+3}{b}The Adventurers Guild!{/b}{/size}"
    el "Este lugar é incrível! Dá para acreditar que estamos mesmo aqui? {size=+3}{b}A Guilda dos Aventureiros!{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:67
translate brazil ch3sc2_5b46488c:

#   el "You've just set foot in the place you always dreamed about as a youngster!"
    el "Você acaba de pisar no lugar com que sempre sonhou quando era criança!"

# game/chapters/chapter3/script/ch3sc2.rpy:69
translate brazil ch3sc2_065c7d8a:

#   mc "Let’s not get too excited just yet..."
    mc "Não vamos nos animar demais ainda..."

# game/chapters/chapter3/script/ch3sc2.rpy:70
translate brazil ch3sc2_59c4c953:

#   mc "It doesn’t even look like anyone's here."
    mc "Nem parece que tem alguém aqui."

# game/chapters/chapter3/script/ch3sc2.rpy:72
translate brazil ch3sc2_5f97ef63:

#   el "Hello, anyone here?"
    el "Olá, tem alguém aí?"

# game/chapters/chapter3/script/ch3sc2.rpy:79
translate brazil ch3sc2_778c50f6:

#   "Scrambling noises"
    "Ruídos de confusão"

# game/chapters/chapter3/script/ch3sc2.rpy:81
translate brazil ch3sc2_eb05749a:

#   el "Huh!? Did you hear that? I think it came from behind the counter."
    el "Hã!? Você ouviu isso? Acho que veio de trás do balcão."

# game/chapters/chapter3/script/ch3sc2.rpy:83
translate brazil ch3sc2_20e3cdfe:

#   mc "Go on, check it out."
    mc "Vamos lá, dê uma olhada."

# game/chapters/chapter3/script/ch3sc2.rpy:85
translate brazil ch3sc2_ad7976e7:

#   el "W-Who me? N-No way! You go!"
    el "Q-Quem, eu? N-De jeito nenhum! Vai você!"

# game/chapters/chapter3/script/ch3sc2.rpy:86
translate brazil ch3sc2_a25c89b1:

#   el "It c-could be something dangerous!"
    el "Pode ser algo perigoso!"

# game/chapters/chapter3/script/ch3sc2.rpy:88
translate brazil ch3sc2_46c45a6b:

#   mc "Something dangerous? We're inside a building, Eliza."
    mc "Algo perigoso? Estamos dentro de um prédio, Eliza."

# game/chapters/chapter3/script/ch3sc2.rpy:90
translate brazil ch3sc2_ae3f596b:

#   el "P-Please? One time a giant field rat charged me from behind a sack of wheat in Mother's cabin."
    el "Por favor? Uma vez, um rato gigante do campo me atacou por trás de um saco de trigo na cabana da minha mãe."

# game/chapters/chapter3/script/ch3sc2.rpy:91
translate brazil ch3sc2_46152e04:

#   el "I didn't sleep for days!"
    el "Não consegui dormir por dias!"

# game/chapters/chapter3/script/ch3sc2.rpy:93
translate brazil ch3sc2_9ea7cfd9:

#   mc "Alright, alright. I'll check it out."
    mc "Certo, certo. Vou verificar."

# game/chapters/chapter3/script/ch3sc2.rpy:95
translate brazil ch3sc2_fcbd18e0:

#   mc "*Sigh* ..."
    mc "*Suspirar* ..."

# game/chapters/chapter3/script/ch3sc2.rpy:101
translate brazil ch3sc2_bb40babc:

#   "As you get closer to the desk, the rustling sound increases. Clearly, something is behind the counter."
    "À medida que você se aproxima da mesa, o ruído de farfalhar aumenta. Claramente, há algo atrás do balcão."

# game/chapters/chapter3/script/ch3sc2.rpy:104
translate brazil ch3sc2_fce29e05:

#   uk "{b}Hi!{/b} Welcome to the Adventurers Guild!"
    uk "{b}Oi!{/b} Bem-vindos à Guilda dos Aventureiros!"

# game/chapters/chapter3/script/ch3sc2.rpy:105
translate brazil ch3sc2_20b8017c:

#   uk "What can I do for the two of you?"
    uk "O que posso fazer por vocês dois?"

# game/chapters/chapter3/script/ch3sc2.rpy:107
translate brazil ch3sc2_64945baf:

#   mc "You’re a fae!"
    mc "Você é uma fada!"

# game/chapters/chapter3/script/ch3sc2.rpy:109
translate brazil ch3sc2_a9e5580a:

#   elt "{b}F-F-F-Fae?!{/b}"
    elt "{b}FFF-Fae?!{/b}"

# game/chapters/chapter3/script/ch3sc2.rpy:111
translate brazil ch3sc2_46547b3a:

#   uk "Correct! I’m a fae! Good eyes!"
    uk "Correto! Eu sou uma fada! Bons olhos!"

# game/chapters/chapter3/script/ch3sc2.rpy:113
translate brazil ch3sc2_142bb0fd:

#   uk "Can you guess which kind of fae, by any chance?"
    uk "Você consegue adivinhar que tipo de fada, por acaso?"

# game/chapters/chapter3/script/ch3sc2.rpy:114
translate brazil ch3sc2_ab923adf:

#   uk "Forest fairy? Pixie? Nymph? Sprite? Or perhaps I'm a Aquafii?"
    uk "Fada da floresta? Duende? Ninfa? Espírito da floresta? Ou talvez eu seja uma Aquafii?"

# game/chapters/chapter3/script/ch3sc2.rpy:116
translate brazil ch3sc2_2d567cd8:

#   mc "Sorry, no."
    mc "Desculpe, não."

# game/chapters/chapter3/script/ch3sc2.rpy:117
translate brazil ch3sc2_11280091:

#   mc "I have no notion what the differences between the specific kinds of fae are."
    mc "Não tenho a mínima ideia de quais sejam as diferenças entre os tipos específicos de fadas."

# game/chapters/chapter3/script/ch3sc2.rpy:118
translate brazil ch3sc2_fa3cd6ef:

#   mc "You're my first fae."
    mc "Você é minha primeira fada."

# game/chapters/chapter3/script/ch3sc2.rpy:120
translate brazil ch3sc2_d1d394c3:

#   uk "{b}His first{/b}, he says! *Giggles* Interesting, very interesting!"
    uk "{b}Seu primeiro{/b}— Ele diz! *Risos* Interessante, muito interessante!"

# game/chapters/chapter3/script/ch3sc2.rpy:122
translate brazil ch3sc2_87e1dd0f:

#   uk "It’s not surprising at all. We aren’t the most common creatures in Midomir."
    uk "Não é nada surpreendente. Não somos as criaturas mais comuns em Midomir."

# game/chapters/chapter3/script/ch3sc2.rpy:124
translate brazil ch3sc2_9a0fff81:

#   uk "People used to hunt us and keep us in magically sealed cages to take advantage of our magic."
    uk "Antigamente, as pessoas nos caçavam e nos mantinham em gaiolas magicamente seladas para se aproveitarem de nossa magia."

# game/chapters/chapter3/script/ch3sc2.rpy:126
translate brazil ch3sc2_85251935:

#   uk "So, naturally, my kind grew wary of humans."
    uk "Então, naturalmente, minha espécie passou a desconfiar dos humanos."

# game/chapters/chapter3/script/ch3sc2.rpy:127
translate brazil ch3sc2_59033317:

#   uk "And we spread out far across Midomir, seeking shelter in secluded areas."
    uk "E nos espalhamos por todo Midomir, buscando abrigo em áreas isoladas."

# game/chapters/chapter3/script/ch3sc2.rpy:129
translate brazil ch3sc2_6db66c01:

#   mc "Does that mean you're hiding in here?"
    mc "Isso significa que você está se escondendo aqui?"

# game/chapters/chapter3/script/ch3sc2.rpy:131
translate brazil ch3sc2_84134cab:

#   uk "By Earth-mother's roots! No, not hiding. Dalen, the guildmaster..."
    uk "Pelas raízes da Mãe Terra! Não, não estou me escondendo. Dalen, o mestre da guilda..."

# game/chapters/chapter3/script/ch3sc2.rpy:132
translate brazil ch3sc2_3739d74b:

#   uk "He took me in. He's provided for me for over a decade by now."
    uk "Ele me acolheu. Ele tem me sustentado por mais de uma década."

# game/chapters/chapter3/script/ch3sc2.rpy:133
translate brazil ch3sc2_474952ff:

#   uk "In return, I manage the desk and daily tasks of the recruits here at the guild."
    uk "Em troca, eu gerencio a recepção e as tarefas diárias dos recrutas aqui na guilda."

# game/chapters/chapter3/script/ch3sc2.rpy:135
translate brazil ch3sc2_bd23b8a4:

#   mc "I’m [mc], and this is-"
    mc "Eu sou [mc] E isto é-"

# game/chapters/chapter3/script/ch3sc2.rpy:137
translate brazil ch3sc2_b050dd2d:

#   el "Eliza! Nice to meet you!"
    el "Eliza! Prazer em conhecê-la!"

# game/chapters/chapter3/script/ch3sc2.rpy:139
translate brazil ch3sc2_3d09c472:

#   sy "I’m Sylphina, but everyone just calls me Sylph."
    sy "Meu nome é Sylphina, mas todos me chamam apenas de Sylph."

# game/chapters/chapter3/script/ch3sc2.rpy:140
translate brazil ch3sc2_636af745:

#   sy "I'm a Forest fairy, or 'Fae' for short."
    sy "Sou uma fada da floresta, ou 'Fae' para abreviar."

# game/chapters/chapter3/script/ch3sc2.rpy:142
translate brazil ch3sc2_5fbf3ff9:

#   sy "If you guys are here to put up a request or a bounty, please fill in the form over there."
    sy "Se vocês estão aqui para fazer um pedido ou oferecer uma recompensa, por favor, preencham o formulário ali."

# game/chapters/chapter3/script/ch3sc2.rpy:144
translate brazil ch3sc2_14f70b4c:

#   el "Actually, we’re here to join!"
    el "Na verdade, estamos aqui para participar!"

# game/chapters/chapter3/script/ch3sc2.rpy:146
translate brazil ch3sc2_e892ad70:

#   sy "Oh, oh! My goodness! New recruits!"
    sy "Oh, oh! Meu Deus! Novos recrutas!"

# game/chapters/chapter3/script/ch3sc2.rpy:148
translate brazil ch3sc2_4cfe239f:

#   sy "It’s so lovely to meet you! You’re actually the first recruits we've had this year."
    sy "É um prazer conhecê-los! Vocês são os primeiros recrutas que tivemos este ano."

# game/chapters/chapter3/script/ch3sc2.rpy:150
translate brazil ch3sc2_a248ccb3:

#   mc "We’re the first? How come?"
    mc "Somos os primeiros? Como assim?"

# game/chapters/chapter3/script/ch3sc2.rpy:152
translate brazil ch3sc2_2262392a:

#   sy "Who’s to say? Dalen, our leader, seems to think there’s foul play involved."
    sy "Quem pode afirmar com certeza? Dalen, nosso líder, parece achar que houve algo de errado."

# game/chapters/chapter3/script/ch3sc2.rpy:153
translate brazil ch3sc2_b6b6e294:

#   sy "I'm inclined to believe him as well. Dalen has good instincts."
    sy "Também tendo a acreditar nele. Dalen tem bons instintos."

# game/chapters/chapter3/script/ch3sc2.rpy:155
translate brazil ch3sc2_6df7a5d7:

#   el "Foul play? That doesn’t sound good."
    el "Jogo sujo? Isso não soa bem."

# game/chapters/chapter3/script/ch3sc2.rpy:157
translate brazil ch3sc2_d1f92947:

#   sy "Yeah, he thinks someone is intimidating potential recruits."
    sy "Sim, ele acha que alguém está intimidando potenciais recrutas."

# game/chapters/chapter3/script/ch3sc2.rpy:159
translate brazil ch3sc2_4f8a94b5:

#   sy "He can probably tell you more about it when you meet him."
    sy "Ele provavelmente poderá lhe contar mais sobre isso quando vocês se encontrarem."

# game/chapters/chapter3/script/ch3sc2.rpy:161
translate brazil ch3sc2_77ab3b6a:

#   el "*Whispers* {size=-10}{b}We should definitely keep an eye out for anything suspicious while we’re in the capital.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Definitivamente, devemos ficar atentos a qualquer coisa suspeita enquanto estivermos na capital.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:163
translate brazil ch3sc2_4f584ce6:

#   mc "*Whispers* {size=-10}{b}Mhhmm. Stay alert.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Hum. Fique alerta.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:165
translate brazil ch3sc2_6a9b4fa5:

#   el "*Whispers* {size=-10}{b}Me? I'm always alert. You stay alert!{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Eu? Estou sempre alerta. Fique alerta você também!{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:167
translate brazil ch3sc2_d511eef7:

#   mc "*Whispers* {size=-10}{b}You wouldn't know a threat if it stared you in the face.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Você não reconheceria uma ameaça nem se ela estivesse bem na sua frente.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:169
translate brazil ch3sc2_c5511f46:

#   el "*Whispers* {size=-10}{b}Rude! I would see it coming a mile away!{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Que grosseria! Eu já esperava por isso de longe!{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:170
translate brazil ch3sc2_31bf930f:

#   el "*Whispers* {size=-10}{b}I remember someone who got tricked by mean bandits.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Lembro-me de alguém que foi enganado por bandidos malvados.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:172
translate brazil ch3sc2_a038d52d:

#   mc "*Whispers* {size=-10}{b}I was just testing them.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Eu estava apenas testando-os.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:174
translate brazil ch3sc2_a7116ced:

#   el "*Whispers* {size=-10}{b}Mhhmm. What about the time I ambushed you by the campfire?{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Hum. E aquela vez que te embosquei perto da fogueira?{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:176
translate brazil ch3sc2_7ede422f:

#   mc "*Whispers* {size=-10}{b}That was-{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Isso foi-{/b}{/size}"

# game/chapters/chapter3/script/ch3sc2.rpy:178
translate brazil ch3sc2_d83b5010:

#   sy "You guys can go meet Dalen now. He'll be glad to see new recruits."
    sy "Vocês podem ir conhecer o Dalen agora. Ele ficará feliz em ver os novos recrutas."

# game/chapters/chapter3/script/ch3sc2.rpy:180
translate brazil ch3sc2_ab5b32dd:

#   sy "I have a feeling this is the beginning of something wonderful!"
    sy "Tenho a sensação de que este é o começo de algo maravilhoso!"

# game/chapters/chapter3/script/ch3sc2.rpy:182
translate brazil ch3sc2_9d6bd87b:

#   mc "Thank you, Sylph."
    mc "Obrigada, Sylph."

# game/chapters/chapter3/script/ch3sc2.rpy:184
translate brazil ch3sc2_1438ee46:

#   sy "No worries! I’m so excited to finally have new recruits!"
    sy "Sem problemas! Estou muito animado por finalmente ter novos recrutas!"

# game/chapters/chapter3/script/ch3sc2.rpy:186
translate brazil ch3sc2_3a5e64af:

#   sy "Please come see me if you have any questions, or when you’re ready for your first quest!"
    sy "Por favor, venha me ver se tiver alguma dúvida ou quando estiver pronto para sua primeira aventura!"

