translate brazil ch6sc9_12a7091f:

#   "The young woman approaches you, keeping her eyes locked with yours."
    "A jovem se aproxima de você, mantendo o olhar fixo no seu."

# game/chapters/chapter6/ch6sc9.rpy:4123
translate brazil ch6sc9_527b29e9:

#   "She stops right before you, just staring."
    "Ela para bem na sua frente, ficando olhando fixamente."

# game/chapters/chapter6/ch6sc9.rpy:4124
translate brazil ch6sc9_11bc386d:

#   mc "Hey…"
    mc "Ei…"

# game/chapters/chapter6/ch6sc9.rpy:4126
translate brazil ch6sc9_0ab66173:

#   sih "Hi…"
    sih "Oi…"

# game/chapters/chapter6/ch6sc9.rpy:4127
translate brazil ch6sc9_51bcd4fc:

#   sih "S-... Sivah."
    sih "S-... Sivah."

# game/chapters/chapter6/ch6sc9.rpy:4129
translate brazil ch6sc9_bd7d9df9:

#   mc "[mc]."
    mc "[mc]."

# game/chapters/chapter6/ch6sc9.rpy:4131
translate brazil ch6sc9_c1fd4a31:

#   "The young woman takes a few more glances at you in silence, before leaving"
    "A jovem lança mais alguns olhares para você em silêncio, antes de ir embora."

# game/chapters/chapter6/ch6sc9.rpy:4133
translate brazil ch6sc9_0da8a745:

#   sih "*Under her breath* Bye-bye, {b}{size=-9}Daddy{/size}{/b}."
    sih "*Em voz baixa* Tchau, tchau, {b}{size=-9}Papai{/size}{/b}."

# game/chapters/chapter6/ch6sc9.rpy:4142
translate brazil ch6sc9_b642a6bf:

#   siv "[mc], I’m so delighted you’ve taken me up on my invitation."
    siv "[mc] Fico muito feliz que você tenha aceitado meu convite."

# game/chapters/chapter6/ch6sc9.rpy:4144
translate brazil ch6sc9_416aceea:

#   "You take note of her dress, elegantly draping along her curvaceous body."
    "Você repara no vestido dela, que drapeia elegantemente ao longo de seu corpo curvilíneo."

# game/chapters/chapter6/ch6sc9.rpy:4145
translate brazil ch6sc9_628a82f6:

#   siv "Does it appeal to you?"
    siv "Isso lhe interessa?"

# game/chapters/chapter6/ch6sc9.rpy:4147
translate brazil ch6sc9_a48f743e:

#   mc "The dress or your body?"
    mc "O vestido ou o seu corpo?"

# game/chapters/chapter6/ch6sc9.rpy:4149
translate brazil ch6sc9_82227f4d:

#   siv "I’d like you to answer for both."
    siv "Gostaria que você respondesse por ambas."

# game/chapters/chapter6/ch6sc9.rpy:4152
translate brazil ch6sc9_2301c54a:

#   mc "I haven’t been able to get the sight you gave me at the baths out of my mind."
    mc "A imagem que você me proporcionou nos banhos não sai da minha cabeça."

# game/chapters/chapter6/ch6sc9.rpy:4153
translate brazil ch6sc9_2dd241bf:

#   mc "Your body is incredibly attractive… as for your dress, it stirs my desires."
    mc "Seu corpo é incrivelmente atraente… quanto ao seu vestido, ele desperta meus desejos."

# game/chapters/chapter6/ch6sc9.rpy:4154
translate brazil ch6sc9_b8978f4c:

#   mc "It’s the right amount of provocative and elegance."
    mc "É a dose certa de provocação e elegância."

# game/chapters/chapter6/ch6sc9.rpy:4156
translate brazil ch6sc9_d9e371c0:

#   siv "My… you have a silver tongue, don’t you?"
    siv "Nossa... você tem lábia, não é?"

# game/chapters/chapter6/ch6sc9.rpy:4157
translate brazil ch6sc9_efdeb89a:

#   "Thanks to your {color=#87e1fa}Charisma{/color} your compliments made Sivir feel special, her trust has increased by {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."
    "Obrigado ao seu {color=#87e1fa} Carisma{/color} Seus elogios fizeram Sivir se sentir especial, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc9.rpy:4160
translate brazil ch6sc9_81503b5a:

#   siv "Thank you for the compliments, you look… appetizing, as usual."
    siv "Obrigada pelos elogios, você está... apetitosa, como sempre."

# game/chapters/chapter6/ch6sc9.rpy:4163
translate brazil ch6sc9_94e7f263:

#   mc "Knowing what you're hiding under there, makes both appealing to me."
    mc "Saber o que você está escondendo aí embaixo torna ambos os assuntos atraentes para mim."

# game/chapters/chapter6/ch6sc9.rpy:4164
translate brazil ch6sc9_3d7bbfb2:

#   "You did not have enough {color=#87e1fa}Charisma{/color} to impress Sivir with your answer."
    "Você não tinha o suficiente {color=#87e1fa} Carisma{/color} Para impressionar Sivir com sua resposta."

# game/chapters/chapter6/ch6sc9.rpy:4166
translate brazil ch6sc9_64e520a6:

#   siv "Thank you for the compliment"
    siv "Obrigado pelo elogio."

# game/chapters/chapter6/ch6sc9.rpy:4169
translate brazil ch6sc9_26299816:

#   mc "That woman who just left, who-"
    mc "Aquela mulher que acabou de sair, que-"

