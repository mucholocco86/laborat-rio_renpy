translate brazil ch6sc9_b153285e:

#   mc "Thank you, Sewah. I’ll see you around."
    mc "Obrigada, Sewah. Até mais."

# game/chapters/chapter6/ch6sc9.rpy:4080
translate brazil ch6sc9_56ef287e:

#   mct "Sewah..."
    mct "Luxo..."

