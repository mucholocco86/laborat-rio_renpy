    mct "{i}Encontrei uma deusa... completei suas provações... e conquistei o respeito de várias mulheres da tribo.{/i}"

# game/chapters/chapter6/ch6sc6.rpy:4068
translate brazil ch6sc6_31e3df8b:

#   mct "{i}That Kisha, though... she’s a tough one to crack.{/i}"
    mct "{i}Mas a Kisha... ela é difícil de decifrar.{/i}"

# game/chapters/chapter6/ch6sc6.rpy:4070
translate brazil ch6sc6_a25c0e28:

#   mct "{i}The old ways are firmly ingrained in her, and it doesn’t help that Marah has been whispering in her ear.{/i}"
    mct "{i}Os costumes antigos estão firmemente enraizados nela, e não ajuda em nada o fato de Marah estar sussurrando em seu ouvido.{/i}"

# game/chapters/chapter6/ch6sc6.rpy:4076
translate brazil ch6sc6_89c75138:

#   mct "{i}Maybe if I complete the hunt tomorrow with Vex, she might come around?{/i}"
    mct "{i}Talvez se eu terminar a caçada amanhã com a Vex, ela mude de ideia?{/i}"

# game/chapters/chapter6/ch6sc6.rpy:4078
translate brazil ch6sc6_8117b9f1:

#   mct "{i}We’ll see. For now, some much needed rest is all I care about.{/i}"
    mct "{i}Veremos. Por agora, tudo o que me importa é descansar bastante.{/i}"

# game/chapters/chapter6/ch6sc6.rpy:4093
translate brazil ch6sc6_25881e26:

#   ki "Where the hell is it...?"
    ki "Onde diabos está...?"

# game/chapters/chapter6/ch6sc6.rpy:4095
translate brazil ch6sc6_9ed6356f:

#   ki "I could’ve sworn Daddy kept his stuff around here somewhere..."
    ki "Eu juraria que papai guardava as coisas dele por aqui em algum lugar..."

# game/chapters/chapter6/ch6sc6.rpy:4096
translate brazil ch6sc6_bea9fab6:

#   bd "Hey, firecracker, whatcha looking for?"
    bd "Ei, danadinho(a), o que você está procurando?"

# game/chapters/chapter6/ch6sc6.rpy:4098
translate brazil ch6sc6_fbd61351:

#   ki "Brenda... do you always appear when you’re not wanted?"
    ki "Brenda... você sempre aparece quando não é bem-vinda?"

# game/chapters/chapter6/ch6sc6.rpy:4099
translate brazil ch6sc6_7c6e914c:

#   ki "Can’t you just... go take a swim with some sharks or demonrays?"
    ki "Você não pode simplesmente... ir nadar com alguns tubarões ou arraias demoníacas?"

# game/chapters/chapter6/ch6sc6.rpy:4100
translate brazil ch6sc6_bebf182c:

#   bd "Nice to see you too, sourpuss."
    bd "Que bom te ver também, rabugento."

# game/chapters/chapter6/ch6sc6.rpy:4102
translate brazil ch6sc6_58ca786c:

#   ki "Ugh... I don’t have time for your prickly comments."
    ki "Ugh... Não tenho tempo para seus comentários irritantes."

# game/chapters/chapter6/ch6sc6.rpy:4103
translate brazil ch6sc6_c4ca9a7d:

#   bd "You’re the one who’s being mean to your best friend."
    bd "Você é quem está sendo cruel com seu melhor amigo."

# game/chapters/chapter6/ch6sc6.rpy:4105
translate brazil ch6sc6_062ced0f:

#   ki "We are {b}NOT{/b} best friends. We aren’t friends at all."
    ki "Nós somos {b} NÃO{/b} Melhores amigos. Nós não somos amigos de verdade."

# game/chapters/chapter6/ch6sc6.rpy:4106
translate brazil ch6sc6_c325b910:

#   bd "We used to be."
    bd "Nós costumávamos ser assim."

# game/chapters/chapter6/ch6sc6.rpy:4108
translate brazil ch6sc6_c8c21686:

#   ki "Yes, used to be. {b}Past tense!{/b}"
    ki "Sim, costumava ser. {b} Passado!{/b}"

# game/chapters/chapter6/ch6sc6.rpy:4109
translate brazil ch6sc6_388f0cbc:

#   ki "Now, if you’ll excuse me..."
    ki "Agora, com sua licença..."

# game/chapters/chapter6/ch6sc6.rpy:4111
translate brazil ch6sc6_d37f035c:

#   ki "..."
    ki "..."

# game/chapters/chapter6/ch6sc6.rpy:4113
translate brazil ch6sc6_55e8a333:

#   bd "I’ll try again. What are you searching for?"
    bd "Vou tentar novamente. O que você está procurando?"

# game/chapters/chapter6/ch6sc6.rpy:4117
translate brazil ch6sc6_8b8dffc8:

#   bd "Please tell me. Let me earn your trust."
    bd "Por favor, me diga. Deixe-me conquistar sua confiança."

# game/chapters/chapter6/ch6sc6.rpy:4121
translate brazil ch6sc6_5b3b1e74:

#   bd "Kira... we've already talked about this. I want to be your friend again."
    bd "Kira... nós já conversamos sobre isso. Quero ser sua amiga de novo."

# game/chapters/chapter6/ch6sc6.rpy:4122
translate brazil ch6sc6_18f4c5fa:

#   bd "At least give me a chance... okay?"
    bd "Pelo menos me dê uma chance... tá bom?"

# game/chapters/chapter6/ch6sc6.rpy:4124
translate brazil ch6sc6_1fcdb65a:

#   ki "Ugh... you’re fucking relentless!"
    ki "Puxa... você é implacável!"

# game/chapters/chapter6/ch6sc6.rpy:4125
translate brazil ch6sc6_e43b9da6:

#   bd "I know. *Snickers*"
    bd "Eu sei. *Risos*"

# game/chapters/chapter6/ch6sc6.rpy:4126
translate brazil ch6sc6_c7a4449c:

#   ki "*Sighs* Take a seat on the bench."
    ki "*Suspiro* Sente-se no banco."

# game/chapters/chapter6/ch6sc6.rpy:4128
translate brazil ch6sc6_1542a2c0:

#   bd "I knew you’d come around."
    bd "Eu sabia que você acabaria cedendo."

# game/chapters/chapter6/ch6sc6.rpy:4129
translate brazil ch6sc6_c7dd0ff1:

#   ki "Don’t push it."
    ki "Não force a barra."

# game/chapters/chapter6/ch6sc6.rpy:4131
translate brazil ch6sc6_413b97e5:

#   bd "So, I’ve been thinking lately..."
    bd "Então, tenho pensado ultimamente..."

# game/chapters/chapter6/ch6sc6.rpy:4132
translate brazil ch6sc6_d781ca17:

#   bd "You and Pearl wish to reclaim Looter’s Bay, I’ll help you with that."
    bd "Você e Pearl desejam retomar a Baía dos Saqueadores, eu os ajudarei com isso."

# game/chapters/chapter6/ch6sc6.rpy:4134
translate brazil ch6sc6_9095fe54:

#   ki "Are you mad? There is no ‘reclaiming’ Looter’s Bay any longer."
    ki "Você está louco? Não existe mais como \"recuperar\" a Baía dos Saqueadores."

# game/chapters/chapter6/ch6sc6.rpy:4135
translate brazil ch6sc6_45a46421:

#   ki "You know full well what Diana is like, she’ll never hand it back over to us."
    ki "Você sabe muito bem como a Diana é, ela nunca vai nos devolver isso."

# game/chapters/chapter6/ch6sc6.rpy:4136
translate brazil ch6sc6_69b0a3c0:

#   ki "She’s here on the king’s orders."
    ki "Ela está aqui por ordem do rei."

# game/chapters/chapter6/ch6sc6.rpy:4138
translate brazil ch6sc6_94acb36a:

#   bd "Kira, do you honestly think she intends to stay here a moment longer than she has to?"
    bd "Kira, você realmente acha que ela pretende ficar aqui um minuto a mais do que o necessário?"

# game/chapters/chapter6/ch6sc6.rpy:4139
translate brazil ch6sc6_d2870184:

#   bd "She hates us, our whole way of life, and our culture. No, she’ll leave as soon as she has completed her task."
    bd "Ela nos odeia, odeia todo o nosso modo de vida e nossa cultura. Não, ela irá embora assim que terminar sua tarefa."

# game/chapters/chapter6/ch6sc6.rpy:4141
translate brazil ch6sc6_5936baac:

#   ki "And her task is to bring Looter’s Bay back into Luxenford's fold."
    ki "E a sua tarefa é trazer a Baía dos Saqueadores de volta para o domínio de Luxenford."

# game/chapters/chapter6/ch6sc6.rpy:4142
translate brazil ch6sc6_2cf9eff5:

#   ki "So, how exactly do you propose we reclaim it, given their goal?"
    ki "Então, como exatamente você propõe que o recuperemos, considerando o objetivo deles?"

# game/chapters/chapter6/ch6sc6.rpy:4144
translate brazil ch6sc6_8e564b9b:

#   bd "Simple!"
    bd "Simples!"

# game/chapters/chapter6/ch6sc6.rpy:4145
translate brazil ch6sc6_15cc6d54:

#   bd "We just have to convince Diana that it is in the king’s best interest to hand it over to us."
    bd "Só precisamos convencer Diana de que é do melhor interesse do rei entregá-lo a nós."

# game/chapters/chapter6/ch6sc6.rpy:4147
translate brazil ch6sc6_492ab705:

#   bd "That doesn’t sound too hard, right?"
    bd "Não parece muito difícil, certo?"

# game/chapters/chapter6/ch6sc6.rpy:4149
translate brazil ch6sc6_36c2e37a:

#   ki "Sure, that sounds soooooo easy... have you actually lost your mind?"
    ki "Claro, isso parece tão fácil... você realmente perdeu a cabeça?"

# game/chapters/chapter6/ch6sc6.rpy:4151
translate brazil ch6sc6_5785ba56:

#   bd "Where’s your sense of adventure? You never backed down from a challenge when we were kids."
    bd "Cadê seu espírito aventureiro? Você nunca fugiu de um desafio quando éramos crianças."

# game/chapters/chapter6/ch6sc6.rpy:4152
translate brazil ch6sc6_6acde2c1:

#   bd "Your boyfriend, [mc], he promised Diana something that is stored in Luxenford."
    bd "Seu namorado, [mc] Ele prometeu a Diana algo que está guardado em Luxemburgo."

# game/chapters/chapter6/ch6sc6.rpy:4153
translate brazil ch6sc6_130e80ad:

#   bd "She’ll want to go there once he gets back."
    bd "Ela vai querer ir lá quando ele voltar."

# game/chapters/chapter6/ch6sc6.rpy:4155
translate brazil ch6sc6_ef97a99b:

#   bd "So, until then... we’ll make ourselves useful, show her we are not as bad as she believes us to be."
    bd "Então, até lá... vamos nos tornar úteis, mostrar a ela que não somos tão ruins quanto ela pensa que somos."

# game/chapters/chapter6/ch6sc6.rpy:4157
translate brazil ch6sc6_304811b8:

#   bd "Then, when it’s time for her to leave, she’ll be happy to put us in charge."
    bd "Então, quando chegar a hora dela ir embora, ela ficará feliz em nos deixar no comando."

# game/chapters/chapter6/ch6sc6.rpy:4159
translate brazil ch6sc6_cf2eec85:

#   bd "As long as we comply with her rules and follow official regulations."
    bd "Contanto que cumpramos as regras dela e sigamos os regulamentos oficiais."

# game/chapters/chapter6/ch6sc6.rpy:4160
translate brazil ch6sc6_1649f90c:

#   bd "Sure, we’ll have to leave piracy behind us, for the most part. But we can adjust to being a regular seafaring and trading hub."
    bd "Claro, teremos que deixar a pirataria para trás, em grande parte. Mas podemos nos adaptar a ser um centro comercial e de navegação regular."

# game/chapters/chapter6/ch6sc6.rpy:4162
translate brazil ch6sc6_0f342152:

#   bd "And if that is what it takes to get our home back, wouldn’t that be worth it?"
    bd "E se for isso que for preciso para recuperarmos nossa casa, não valeria a pena?"

# game/chapters/chapter6/ch6sc6.rpy:4164
translate brazil ch6sc6_bb8c3e00:

#   ki "Huh... Brenda that is... actually a well-thought-out plan."
    ki "Hum... Brenda, isso é... na verdade, um plano bem elaborado."

# game/chapters/chapter6/ch6sc6.rpy:4166
translate brazil ch6sc6_1107650b:

#   bd "I knew it! I knew you’d see reason... I really believe we can do it."
    bd "Eu sabia! Eu sabia que você ia entender... Eu realmente acredito que podemos conseguir."

# game/chapters/chapter6/ch6sc6.rpy:4168
translate brazil ch6sc6_d1fb524f:

#   ki "It might be a good and somewhat logical plan, but there’s no guarantee it’ll work."
    ki "Pode ser um plano bom e até certo ponto lógico, mas não há garantia de que funcionará."

# game/chapters/chapter6/ch6sc6.rpy:4170
translate brazil ch6sc6_31cad722:

#   bd "It will work, I know it will... Diana is desperate to get whatever she is after."
    bd "Vai funcionar, eu sei que vai... Diana está desesperada para conseguir o que quer que esteja buscando."

# game/chapters/chapter6/ch6sc6.rpy:4171
translate brazil ch6sc6_e7c40902:

#   bd "She’ll be eager to get out of here, first chance she gets."
    bd "Ela vai querer sair daqui assim que tiver a primeira oportunidade."

# game/chapters/chapter6/ch6sc6.rpy:4172
translate brazil ch6sc6_81674062:

#   bd "You and me, we know Looter’s Bay like nobody else... it’ll be in her best interest to let us resume control."
    bd "Você e eu conhecemos a Baía dos Saqueadores como ninguém... será do interesse dela nos deixar retomar o controle."

# game/chapters/chapter6/ch6sc6.rpy:4174
translate brazil ch6sc6_35e9fe00:

#   bd "Please, Kira... tell me you’ll do this with me?"
    bd "Por favor, Kira... diga-me que você fará isso comigo?"

# game/chapters/chapter6/ch6sc6.rpy:4175
translate brazil ch6sc6_e9dd2955:

#   bd "I need my best friend back..."
    bd "Preciso da minha melhor amiga de volta..."

# game/chapters/chapter6/ch6sc6.rpy:4177
translate brazil ch6sc6_84e3f91a:

#   ki "Jesus... you look like Pearl when somebody guts a fish."
    ki "Jesus... você fica parecendo a Pearl quando alguém limpa um peixe."

# game/chapters/chapter6/ch6sc6.rpy:4179
translate brazil ch6sc6_17ecb15b:

#   ki "Ugh! Fine, whatever... we’ll give it a shot."
    ki "Ah, tá bom, tanto faz... vamos tentar."

# game/chapters/chapter6/ch6sc6.rpy:4180
translate brazil ch6sc6_217bbd6e:

#   ki "Pearl and I aren’t interested in being pirates the way father taught us, anyway."
    ki "Pearl e eu não temos interesse em ser piratas do jeito que papai nos ensinou, de qualquer forma."

# game/chapters/chapter6/ch6sc6.rpy:4181
translate brazil ch6sc6_88de4062:

#   ki "If Looter’s Bay going legit can lead to us being free and independent..."
    ki "Se a legalização de Looter's Bay puder nos levar à liberdade e à independência..."

# game/chapters/chapter6/ch6sc6.rpy:4182
translate brazil ch6sc6_caebeabe:

#   ki "Then I suppose it’s worth-"
    ki "Então, suponho que valha a pena."

# game/chapters/chapter6/ch6sc6.rpy:4184
translate brazil ch6sc6_7585fb00:

#   bd "Thank the seas! Kira I’m so happy that we’ll do this together."
    bd "Graças aos mares! Kira, estou tão feliz que faremos isso juntas."

# game/chapters/chapter6/ch6sc6.rpy:4185
translate brazil ch6sc6_b539b175:

#   bd "If we work together like we used to, it will work... I know it will."
    bd "Se trabalharmos juntos como antes, vai funcionar... Eu sei que vai."

# game/chapters/chapter6/ch6sc6.rpy:4187
translate brazil ch6sc6_5c87905e:

#   ki "Will you stop touching me! We’re not friends... we’re just... allied on this."
    ki "Você pode parar de me tocar? Nós não somos amigos... nós só... estamos aliados nisso."

# game/chapters/chapter6/ch6sc6.rpy:4189
translate brazil ch6sc6_652c5f28:

#   bd "Allies for now... but friends after."
    bd "Aliados por enquanto... mas amigos depois."

# game/chapters/chapter6/ch6sc6.rpy:4191
translate brazil ch6sc6_d6321a7b:

#   ki "I’m not going to promise that... you have a lot to atone for."
    ki "Não vou prometer isso... você tem muito a expiar."

# game/chapters/chapter6/ch6sc6.rpy:4193
translate brazil ch6sc6_7ca92f28:

#   ki "But yes, we’ll be allies for this. Now, please leave me alone."
    ki "Mas sim, seremos aliados nisso. Agora, por favor, me deixe em paz."

# game/chapters/chapter6/ch6sc6.rpy:4195
translate brazil ch6sc6_11b1e16c:

#   bd "I’ll come to you once I have something solid to work with. For now..."
    bd "Entrarei em contato assim que tiver algo concreto para trabalhar. Por enquanto..."

# game/chapters/chapter6/ch6sc6.rpy:4196
translate brazil ch6sc6_87e14cd5:

#   bd "Just keep building trust with Diana. We’ll need to be in good standing with her for our plan to work."
    bd "Continue a construir a confiança com a Diana. Precisamos estar em bons termos com ela para que o nosso plano funcione."

# game/chapters/chapter6/ch6sc6.rpy:4198
translate brazil ch6sc6_1ed5b99a:

#   kl "Oh! Uhm... hi."
    kl "Ah! Hum... oi."

# game/chapters/chapter6/ch6sc6.rpy:4199
translate brazil ch6sc6_185900ce:

#   bd "*Snickers* Seas kiddo... you’ve really grown up."
    bd "*Risos* Nossa, garoto... você realmente cresceu."

# game/chapters/chapter6/ch6sc6.rpy:4201
translate brazil ch6sc6_6f479581:

#   bd "What have you been feeding her? Her tits are massive."
    bd "O que você anda dando para ela comer? Os peitos dela são enormes."

# game/chapters/chapter6/ch6sc6.rpy:4202
translate brazil ch6sc6_023636a8:

#   bd "Kelly, is it? I remember when Kira and Pearl first got you as their ward. You were nothing but a stick."
    bd "Kelly, não é? Lembro-me de quando Kira e Pearl te acolheram como pupila. Você não passava de um graveto."

# game/chapters/chapter6/ch6sc6.rpy:4203
translate brazil ch6sc6_58699dde:

#   bd "Now look at you... with a that body would have most men wrapped around your finger."
    bd "Olha só para você... com esse corpo, a maioria dos homens estaria na palma da sua mão."

# game/chapters/chapter6/ch6sc6.rpy:4204
translate brazil ch6sc6_c5248122:

#   ki "Leave her alone, Brenda, or I’ll -"
    ki "Deixe-a em paz, Brenda, ou eu vou..."

# game/chapters/chapter6/ch6sc6.rpy:4206
translate brazil ch6sc6_7ee0e64b:

#   bd "Buzzkill..."
    bd "Estraga-prazeres..."

# game/chapters/chapter6/ch6sc6.rpy:4207
translate brazil ch6sc6_27937009:

#   bd "Kelly doesn’t need to worry about me. I’m saving myself, after all."
    bd "Kelly não precisa se preocupar comigo. Afinal, estou me salvando."

# game/chapters/chapter6/ch6sc6.rpy:4208
translate brazil ch6sc6_55e27099:

#   ki "*Scoffs* Saving yourself? As if... for who?"
    ki "*Risos* Se salvar? Como se... para quem?"

# game/chapters/chapter6/ch6sc6.rpy:4210
translate brazil ch6sc6_21e3fb44:

#   bd "Funny you should ask."
    bd "Que coincidência você perguntar isso."

# game/chapters/chapter6/ch6sc6.rpy:4211
translate brazil ch6sc6_f507d41f:

#   bd "Your boyfriend... {b}I want him{/b}."
    bd "Seu namorado... {b} Eu o quero{/b}."

# game/chapters/chapter6/ch6sc6.rpy:4213
translate brazil ch6sc6_14fbc307:

#   ki "{b}WHAT?!{/b}"
    ki "{b}O QUE?!{/b}"

# game/chapters/chapter6/ch6sc6.rpy:4214
translate brazil ch6sc6_4d6cc7fa:

#   bd "Toodles!"
    bd "Até logo!"

# game/chapters/chapter6/ch6sc6.rpy:4227
translate brazil ch6sc6_485bebcc:

#   mc "*Yawns* Hnngh... looks like I’m not the first to rise."
    mc "*Boceja* Hnngh... parece que não sou o primeiro a acordar."

# game/chapters/chapter6/ch6sc6.rpy:4229
translate brazil ch6sc6_5b785593:

#   ec "Good morning, Vex."
    ec "Bom dia, Vex."

# game/chapters/chapter6/ch6sc6.rpy:4230
translate brazil ch6sc6_b6299445:

#   vx "Good morning to you as well, A’nu."
    vx "Bom dia para você também, A'nu."

# game/chapters/chapter6/ch6sc6.rpy:4232
translate brazil ch6sc6_1e43f4e0:

#   tz "Good morning, do we have time for some refreshments before we set out today?"
    tz "Bom dia, temos tempo para um lanche antes de partirmos hoje?"

# game/chapters/chapter6/ch6sc6.rpy:4234
translate brazil ch6sc6_99514a8c:

#   mc "Good morning, Vex."
    mc "Bom dia, Vex."

# game/chapters/chapter6/ch6sc6.rpy:4240
translate brazil ch6sc6_e4007b5e:

#   vx "*Nods* Mhm, good morning."
    vx "*Acena com a cabeça* Hum, bom dia."

# game/chapters/chapter6/ch6sc6.rpy:4242
translate brazil ch6sc6_394b3dd5:

#   mc "Forgive me for being so forward this early in the morning, but you look beautiful today."
    mc "Me perdoe por ser tão direta logo de manhã, mas você está linda hoje."

# game/chapters/chapter6/ch6sc6.rpy:4245
translate brazil ch6sc6_8c65b17c:

#   vx "I will forgive you... t-thank you."
    vx "Eu te perdoarei... o-obrigado."

# game/chapters/chapter6/ch6sc6.rpy:4246
translate brazil ch6sc6_ad98a7bc:

#   "Vex accepted your compliment, your {b}{color=#87e1fa}Charisma{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Vex aceitou seu elogio, seu {b}{color=#87e1fa}Carisma{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc6.rpy:4250
translate brazil ch6sc6_74f906d5:

#   vx "You... you also look beautiful today."
    vx "Você... você também está linda hoje."

# game/chapters/chapter6/ch6sc6.rpy:4253
translate brazil ch6sc6_68072837:

#   mc "*Chuckles* Why, thank you."
    mc "*Risos* Ah, obrigada."

# game/chapters/chapter6/ch6sc6.rpy:4256
translate brazil ch6sc6_3615e8d6:

#   "Vex likes that you took the initiative to compliment her, trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Vex gostou que você tivesse tomado a iniciativa de elogiá-la, e isso aumentou a confiança dela. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc6.rpy:4264
translate brazil ch6sc6_b34890a8:

#   ec "Yes, Tazzy, we have some time for some refreshments before we go."
    ec "Sim, Tazzy, temos algum tempo para um lanche antes de irmos."

# game/chapters/chapter6/ch6sc6.rpy:4265
translate brazil ch6sc6_bddff8b3:

#   ec "But don’t take too long, we have a lot to accomplish today."
    ec "Mas não demore muito, temos muito o que fazer hoje."

# game/chapters/chapter6/ch6sc6.rpy:4267
translate brazil ch6sc6_2c4fde25:

#   pl "I’ll get us some fresh water. I saw a stream not far from here yesterday."
    pl "Vou buscar água fresca para nós. Vi um riacho não muito longe daqui ontem."

# game/chapters/chapter6/ch6sc6.rpy:4269
translate brazil ch6sc6_f3a74816:

#   tz "Great! I’ll go with you, we shouldn’t go off on our own out here."
    tz "Ótimo! Eu vou com você, não devemos nos separar daqui."

# game/chapters/chapter6/ch6sc6.rpy:4271
translate brazil ch6sc6_537d83ed:

#   pl "I’d like that. I really don’t fancy being ambushed by the Arugoh tribe again."
    pl "Eu gostaria disso. Não quero mesmo ser emboscado pela tribo Arugoh de novo."

# game/chapters/chapter6/ch6sc6.rpy:4273
translate brazil ch6sc6_7f637899:

#   tz "Or that giant snake, Jimun. Fair warning, if we run into that thing, I’ll leave you to get eaten first."
    tz "Ou aquela cobra gigante, Jimun. Só um aviso: se a gente se deparar com aquela coisa, eu deixo você ser devorado primeiro."

# game/chapters/chapter6/ch6sc6.rpy:4275
translate brazil ch6sc6_fa2c5499:

#   pl "*Snickers* You're slow as a slug. You'd have no chance of outrunning me."
    pl "*Risos* Você é lento como uma lesma. Não teria a menor chance de me alcançar."

# game/chapters/chapter6/ch6sc6.rpy:4277
translate brazil ch6sc6_b69bf85f:

#   mc "So, what are we doing while they get water?"
    mc "Então, o que estamos fazendo enquanto eles pegam água?"

# game/chapters/chapter6/ch6sc6.rpy:4280
translate brazil ch6sc6_2c557b80:

#   ec "We three will discuss our plan for today's excursion."
    ec "Nós três discutiremos nosso plano para a excursão de hoje."

# game/chapters/chapter6/ch6sc6.rpy:4282
translate brazil ch6sc6_931c268b:

#   vx "Today, we shall complete our hunt."
    vx "Hoje, vamos concluir nossa busca."

# game/chapters/chapter6/ch6sc6.rpy:4283
translate brazil ch6sc6_ec6bbcd5:

#   vx "We will succeed. I can feel it."
    vx "Nós vamos conseguir. Eu sinto isso."

# game/chapters/chapter6/ch6sc6.rpy:4285
translate brazil ch6sc6_3ffea502:

#   ec "If Gaia wills it, Vex."
    ec "Se Gaia assim o quiser, Vex."

# game/chapters/chapter6/ch6sc6.rpy:4287
translate brazil ch6sc6_79dbe087:

#   vx "*Nods* Mhm, if Gaia wills it."
    vx "*Acena com a cabeça* Hum, se Gaia assim o quiser."

# game/chapters/chapter6/ch6sc6.rpy:4289
translate brazil ch6sc6_045c1bea:

#   mc "I know you guys like to put your faith in the goddesses, but I prefer something more... tangible."
    mc "Eu sei que vocês gostam de depositar sua fé nas deusas, mas eu prefiro algo mais... tangível."

# game/chapters/chapter6/ch6sc6.rpy:4290
translate brazil ch6sc6_c0584fce:

#   mc "Like, how do you intend to proceed during today’s outing?"
    mc "Tipo, como você pretende proceder durante o passeio de hoje?"

# game/chapters/chapter6/ch6sc6.rpy:4291
translate brazil ch6sc6_7deac353:

#   mc "Aside from leaving everything up to Gaia’s influence."
    mc "Além de deixar tudo à mercê da influência de Gaia."

# game/chapters/chapter6/ch6sc6.rpy:4293
translate brazil ch6sc6_798142f5:

#   ec "We shall do what we do best, tracking."
    ec "Faremos o que fazemos de melhor: rastrear."

# game/chapters/chapter6/ch6sc6.rpy:4294
translate brazil ch6sc6_cdc23476:

#   ec "We’ll keep our eyes and ears sharp and focused..."
    ec "Manteremos nossos olhos e ouvidos atentos e focados..."

# game/chapters/chapter6/ch6sc6.rpy:4295
translate brazil ch6sc6_7e7aa5c3:

#   ec "Paying careful attention to the jungle and it’s inhabitants."
    ec "Prestando muita atenção à selva e aos seus habitantes."

# game/chapters/chapter6/ch6sc6.rpy:4297
translate brazil ch6sc6_661c80c6:

#   mc "See? That’s a plan I can get behind."
    mc "Viu? É um plano que eu apoio."

# game/chapters/chapter6/ch6sc6.rpy:4298
translate brazil ch6sc6_adf30411:

#   mc "Something I was taught is to listen attentively to the sounds of birds."
    mc "Uma coisa que me ensinaram foi a ouvir atentamente os sons dos pássaros."

# game/chapters/chapter6/ch6sc6.rpy:4299
translate brazil ch6sc6_c300b7fd:

#   mc "They can alert potential prey to your presence, but likewise, they can alert you to possible danger."
    mc "Elas podem alertar potenciais presas sobre a sua presença, mas, da mesma forma, podem alertá-lo sobre um possível perigo."

# game/chapters/chapter6/ch6sc6.rpy:4301
translate brazil ch6sc6_309a34e8:

#   ec "You are correct, birds can be very useful during hunts if you know what to listen for."
    ec "Você está certo, os pássaros podem ser muito úteis durante a caça se você souber o que procurar."

# game/chapters/chapter6/ch6sc6.rpy:4302
translate brazil ch6sc6_0125cffe:

#   ec "You have a hunter’s knowledge."
    ec "Você tem o conhecimento de um caçador."

# game/chapters/chapter6/ch6sc6.rpy:4304
translate brazil ch6sc6_22179efd:

#   mc "I’m definitely not as experienced as your huntresses, but I’ve hunted quite a bit, yes."
    mc "Com certeza não sou tão experiente quanto suas caçadoras, mas já cacei bastante, sim."

# game/chapters/chapter6/ch6sc6.rpy:4306
translate brazil ch6sc6_c9a59fea:

#   ec "A proficient tracker will rarely return empty-handed."
    ec "Um rastreador competente raramente volta de mãos vazias."

# game/chapters/chapter6/ch6sc6.rpy:4308
translate brazil ch6sc6_8a9f7f16:

#   mc "*Chuckles* I got to experience that first-hand... when Suji and Zyra tracked and caught me."
    mc "*Risos* Eu pude vivenciar isso em primeira mão... quando Suji e Zyra me rastrearam e me pegaram."

# game/chapters/chapter6/ch6sc6.rpy:4309
translate brazil ch6sc6_484701db:

#   ec "*Giggles lightly* Heheh..."
    ec "*Risinhos suaves* Heheh..."

# game/chapters/chapter6/ch6sc6.rpy:4311
translate brazil ch6sc6_512b9c9f:

#   ec "You were... a surprising prey, to say the least."
    ec "Você foi... uma presa surpreendente, para dizer o mínimo."

# game/chapters/chapter6/ch6sc6.rpy:4313
translate brazil ch6sc6_644623f9:

#   ec "And it goes to show... the goddesses always provides us with what we need."
    ec "E isso demonstra que... as deusas sempre nos fornecem o que precisamos."

# game/chapters/chapter6/ch6sc6.rpy:4314
translate brazil ch6sc6_b4773832:

#   ec "They provided us with you."
    ec "Eles nos forneceram você."

# game/chapters/chapter6/ch6sc6.rpy:4316
translate brazil ch6sc6_316d5ca5:

#   mc "That’s one way to look at it."
    mc "Essa é uma maneira de ver as coisas."

# game/chapters/chapter6/ch6sc6.rpy:4318
translate brazil ch6sc6_6a77dabb:

#   ec "Last night, I even heard young Vex thank the goddesses for making you her teammate."
    ec "Ontem à noite, cheguei a ouvir a jovem Vex agradecer às deusas por ter você como sua companheira de equipe."

# game/chapters/chapter6/ch6sc6.rpy:4323
translate brazil ch6sc6_6b2794c4:

#   vx "Speak no more of my prayers, I beg of you!"
    vx "Não fale mais das minhas orações, eu imploro!"

# game/chapters/chapter6/ch6sc6.rpy:4324
translate brazil ch6sc6_ba08b82a:

#   vx "He's standing right here!"
    vx "Ele está bem aqui!"

# game/chapters/chapter6/ch6sc6.rpy:4326
translate brazil ch6sc6_7ba756c2:

#   ec "*Giggles* You’re too cute, Vex."
    ec "*Risos* Você é muito fofa, Vex."

# game/chapters/chapter6/ch6sc6.rpy:4327
translate brazil ch6sc6_9251f5a8:

#   vx "Not another word! It’s... embarrassing!"
    vx "Nem mais uma palavra! É... constrangedor!"

# game/chapters/chapter6/ch6sc6.rpy:4328
translate brazil ch6sc6_f241e964:

#   tz "We’re baaack! Who’s ready for some refreshments?"
    tz "Estamos de volta! Quem está pronto para um refresco?"

# game/chapters/chapter6/ch6sc6.rpy:4330
translate brazil ch6sc6_afd2e0d2:

#   pl "I had a sip of the water at the creek. It’s so good, cool and clear!"
    pl "Dei um gole na água do riacho. É tão boa, fresca e cristalina!"

# game/chapters/chapter6/ch6sc6.rpy:4331
translate brazil ch6sc6_ffb04223:

#   pl "We filled the entire jar, so there should be plenty for everyone."
    pl "Enchemos o frasco completamente, então deve haver o suficiente para todos."

# game/chapters/chapter6/ch6sc6.rpy:4334
translate brazil ch6sc6_511bb117:

#   "The girls fill everyone's cups."
    "As meninas enchem os copos de todos."

# game/chapters/chapter6/ch6sc6.rpy:4337
translate brazil ch6sc6_59cd3187:

#   ec "MMmmhh..."
    ec "Hummm..."

# game/chapters/chapter6/ch6sc6.rpy:4338
translate brazil ch6sc6_d4edcc44:

#   ec "Pearl, you were right... this is good."
    ec "Pearl, você tinha razão... isto é bom."

# game/chapters/chapter6/ch6sc6.rpy:4340
translate brazil ch6sc6_747dc59a:

#   pl "The creek must be fed from a nearby spring, otherwise the water wouldn’t be this clean."
    pl "O riacho deve ser alimentado por uma nascente próxima, caso contrário a água não seria tão limpa."

# game/chapters/chapter6/ch6sc6.rpy:4341
translate brazil ch6sc6_1e6577d5:

#   ec "It is quite possible, there are several springs scattered across the island."
    ec "É bem possível que existam várias nascentes espalhadas pela ilha."

# game/chapters/chapter6/ch6sc6.rpy:4343
translate brazil ch6sc6_a4a6f4b9:

#   ec "Thank you, it was kind of you and Taz to fetch us the water."
    ec "Obrigado, foi muita gentileza sua e do Taz trazerem a água para nós."

# game/chapters/chapter6/ch6sc6.rpy:4344
translate brazil ch6sc6_4687b933:

#   vx "Mmm! *Gulp* thank you, Pearl."
    vx "Hum! *Engole em seco* Obrigada, Pérola."

# game/chapters/chapter6/ch6sc6.rpy:4345
translate brazil ch6sc6_3d88548f:

#   vx "Now, nothing can stop us from completing the hunt."
    vx "Agora, nada pode nos impedir de concluir a caçada."

# game/chapters/chapter6/ch6sc6.rpy:4347
translate brazil ch6sc6_d2ea5144:

#   pl "Tazzy and I aren't much use out here... so I’m glad we could do this, at least."
    pl "Eu e a Tazzy não somos de muita utilidade por aqui... então fico feliz que pelo menos tenhamos conseguido fazer isso."

# game/chapters/chapter6/ch6sc6.rpy:4348
translate brazil ch6sc6_bd6dc327:

#   vx "You would not be with us if we thought you a burden."
    vx "Você não estaria conosco se o considerássemos um fardo."

# game/chapters/chapter6/ch6sc6.rpy:4350
translate brazil ch6sc6_380c5653:

#   ec "Vex is right. You may not be huntresses, but you have been plenty helpful and good company."
    ec "Vex tem razão. Vocês podem não ser caçadoras, mas têm sido muito prestativas e uma ótima companhia."

# game/chapters/chapter6/ch6sc6.rpy:4351
translate brazil ch6sc6_cd79711c:

#   ec "But now, the hunt must begin."
    ec "Mas agora, a caçada deve começar."

# game/chapters/chapter6/ch6sc6.rpy:4352
translate brazil ch6sc6_cecdacac:

#   ec "Are you all prepared for what the jungle has in store for us today?"
    ec "Estão todos preparados para o que a selva nos reserva hoje?"

# game/chapters/chapter6/ch6sc6.rpy:4354
translate brazil ch6sc6_49350e90:

#   pl "Yep! Ready as hungry sharks at a shipwreck."
    pl "Sim! Prontos como tubarões famintos diante de um naufrágio."

# game/chapters/chapter6/ch6sc6.rpy:4356
translate brazil ch6sc6_bd55e745:

#   vx "I’ve been ready my entire life."
    vx "Estive preparado a vida inteira."

# game/chapters/chapter6/ch6sc6.rpy:4357
translate brazil ch6sc6_b13b73f8:

#   vx "Finally... I get to prove myself and test my skills against the jungle."
    vx "Finalmente... vou poder provar meu valor e testar minhas habilidades na selva."

# game/chapters/chapter6/ch6sc6.rpy:4359
translate brazil ch6sc6_aca28fb5:

#   mc "I’m ready too. I woke up filled with anticipation."
    mc "Eu também estou pronto. Acordei cheio de expectativa."

# game/chapters/chapter6/ch6sc6.rpy:4360
translate brazil ch6sc6_2deff311:

#   mc "I know Vex and I will do great."
    mc "Eu sei que Vex e eu nos sairemos muito bem."

# game/chapters/chapter6/ch6sc6.rpy:4361
translate brazil ch6sc6_2d4fc9c7:

#   mc "I haven’t seen the other huntresses this morning. Aren’t they coming along for the hunt?"
    mc "Não vi as outras caçadoras esta manhã. Elas não vão participar da caçada?"

# game/chapters/chapter6/ch6sc6.rpy:4363
translate brazil ch6sc6_a6d771ff:

#   ec "It pleases me that you are in high spirits, for today will not be easy."
    ec "Fico feliz em saber que você está de bom humor, pois hoje não será um dia fácil."

# game/chapters/chapter6/ch6sc6.rpy:4364
translate brazil ch6sc6_0b1dbba5:

#   ec "Suji, Zyra and Kisha have already started."
    ec "Suji, Zyra e Kisha já começaram."

# game/chapters/chapter6/ch6sc6.rpy:4365
translate brazil ch6sc6_4d74065f:

#   ec "They will be shadowing us as we enter the jungle. Their task is purely to observe the hunt."
    ec "Eles nos acompanharão enquanto entramos na selva. Sua tarefa é simplesmente observar a caçada."

# game/chapters/chapter6/ch6sc6.rpy:4367
translate brazil ch6sc6_6558d452:

#   ec "Pearl, you and Tazzy will accompany the main group. You might even learn a thing or two about tracking."
    ec "Pearl, você e Tazzy acompanharão o grupo principal. Vocês podem até aprender uma coisa ou duas sobre rastreamento."

# game/chapters/chapter6/ch6sc6.rpy:4368
translate brazil ch6sc6_984da78e:

#   ec "But when we get close to today’s prey, I'll lead you both away to a safe distance to observe."
    ec "Mas quando nos aproximarmos da presa de hoje, levarei vocês dois para uma distância segura para observar."

# game/chapters/chapter6/ch6sc6.rpy:4369
translate brazil ch6sc6_8223a31d:

#   pl "*Nods* Mh-hm."
    pl "*Acena com a cabeça* Hum-hum."

# game/chapters/chapter6/ch6sc6.rpy:4371
translate brazil ch6sc6_dd3f6b4f:

#   ec "At that stage, [mc], you and Vex will be on your own."
    ec "Nessa fase, [mc], você e Vex ficarão por conta própria."

# game/chapters/chapter6/ch6sc6.rpy:4372
translate brazil ch6sc6_940344aa:

#   ec "Once the hunt begins, nobody will come to your aid. You will only be able to depend on each other."
    ec "Uma vez iniciada a caçada, ninguém virá em seu auxílio. Vocês só poderão contar um com o outro."

# game/chapters/chapter6/ch6sc6.rpy:4373
translate brazil ch6sc6_b3ae090f:

#   ec "Although rare, we have lost huntresses during the hunting trials before. So, be on your guard."
    ec "Embora raro, já perdemos caçadoras durante as provas de caça. Portanto, fiquem atentos."

# game/chapters/chapter6/ch6sc6.rpy:4375
translate brazil ch6sc6_b673a47c:

#   mc "Echo, I promise I will not let anything happen to Vex."
    mc "Echo, eu prometo que não deixarei nada acontecer com Vex."

# game/chapters/chapter6/ch6sc6.rpy:4377
translate brazil ch6sc6_8ad84ea7:

#   ec "That eases the burden of my heart... thank you."
    ec "Isso alivia o peso no meu coração... obrigada."

# game/chapters/chapter6/ch6sc6.rpy:4379
translate brazil ch6sc6_5ec36140:

#   ec "Now, let us enter the jungle."
    ec "Agora, vamos entrar na selva."

# game/chapters/chapter6/ch6sc6.rpy:4380
translate brazil ch6sc6_dad6b6fb:

#   ec "Even though you aren’t experienced trackers, you might still spot things that a trained eye could miss, so remain alert."
    ec "Mesmo que vocês não sejam rastreadores experientes, ainda podem notar coisas que um olhar treinado poderia deixar passar, então fiquem alertas."

# game/chapters/chapter6/ch6sc6.rpy:4383
translate brazil ch6sc6_93109f8d:

#   mc "Ready to become a huntress, little one?"
    mc "Pronta para se tornar uma caçadora, pequena?"

# game/chapters/chapter6/ch6sc6.rpy:4384
translate brazil ch6sc6_3b645c77:

#   vx "*Nods* Mh-hm."
    vx "*Acena com a cabeça* Hum-hum."

# game/chapters/chapter6/ch6sc6.rpy:4385
translate brazil ch6sc6_e1313b09:

#   "Vex shoots you a gentle smile, then turns her attention back to the jungle."
    "Vex lhe lança um sorriso gentil e, em seguida, volta sua atenção para a selva."

# game/chapters/chapter6/ch6sc6.rpy:4388
translate brazil ch6sc6_98dbea30:

#   mct "{i}I think Vex is starting to warm up to me being her partner for the hunt.{/i}"
    mct "{i}Acho que a Vex está começando a se acostumar com a ideia de eu ser seu parceiro na caçada.{/i}"

# game/chapters/chapter6/ch6sc6.rpy:4389
translate brazil ch6sc6_5939f007:

#   mct "{i}I rather enjoy her company. She can be headstrong and stubborn, but sometimes she seems quite timid and shy.{/i}"
    mct "{i}Gosto bastante da companhia dela. Ela pode ser teimosa e obstinada, mas às vezes parece bem tímida e reservada.{/i}"

# game/chapters/chapter6/ch6sc6.rpy:4394
translate brazil ch6sc6_2c489f5c:

#   "For the next two hours, the five of you trek through the dense foliage of the hunting grounds."
    "Nas próximas duas horas, vocês cinco caminharão pela densa folhagem da área de caça."

# game/chapters/chapter6/ch6sc6.rpy:4395
translate brazil ch6sc6_72605eb2:

#   "The jungle is surprisingly quiet this morning. The normal chorus of bird song, the usual calls of monkeys high in the canopy..."
    "A selva está surpreendentemente silenciosa esta manhã. O coro habitual de cantos de pássaros, os chamados usuais dos macacos no alto da copa das árvores..."

# game/chapters/chapter6/ch6sc6.rpy:4396
translate brazil ch6sc6_0d71aa36:

#   "Even the chirping of crickets... all are strangely absent as you work your way through the undergrowth."
    "Até mesmo o canto dos grilos... tudo está estranhamente ausente enquanto você caminha pela vegetação rasteira."

# game/chapters/chapter6/ch6sc6.rpy:4397
translate brazil ch6sc6_75854fdd:

#   "You and Echo exchange glances as you both take note of it."
    "Você e Echo trocam olhares enquanto ambos observam a cena."

# game/chapters/chapter6/ch6sc6.rpy:4400
translate brazil ch6sc6_44f7b510:

#   pl "Are we... lost?"
    pl "Estamos... perdidos?"

# game/chapters/chapter6/ch6sc6.rpy:4401
translate brazil ch6sc6_b9bbe0e1:

#   ec "No, Pearl."
    ec "Não, Pearl."

# game/chapters/chapter6/ch6sc6.rpy:4402
translate brazil ch6sc6_7838421b:

#   ec "You needn’t be concerned about that. Within our hunting grounds, the jungle does not change."
    ec "Você não precisa se preocupar com isso. Dentro de nossas áreas de caça, a selva não muda."

# game/chapters/chapter6/ch6sc6.rpy:4403
translate brazil ch6sc6_5d0a3a33:

#   pl "Oh, right... I forgot about that."
    pl "Ah, é verdade... Eu tinha me esquecido disso."

# game/chapters/chapter6/ch6sc6.rpy:4405
translate brazil ch6sc6_3f016015:

#   mc "Something has changed, though. The jungle has been too silent for around... an hour now?"
    mc "Mas algo mudou. A selva está silenciosa demais há cerca de... uma hora?"

# game/chapters/chapter6/ch6sc6.rpy:4406
translate brazil ch6sc6_b49e6fde:

#   ec "I noticed that too... It is not a sign I’m thrilled about, if I’m honest."
    ec "Eu também reparei nisso... Para ser sincera, não é um sinal que me deixe muito feliz."

# game/chapters/chapter6/ch6sc6.rpy:4407
translate brazil ch6sc6_14441197:

#   pl "Y-You think something big and nasty has scared away the animals?"
    pl "Você acha que algo grande e desagradável espantou os animais?"

# game/chapters/chapter6/ch6sc6.rpy:4408
translate brazil ch6sc6_329ee711:

#   ec "It is a possibility that has crossed my mind."
    ec "É uma possibilidade que já me passou pela cabeça."

# game/chapters/chapter6/ch6sc6.rpy:4409
translate brazil ch6sc6_1ec11e83:

#   ec "Zyra heard something big yesterday, and now the jungle is unusually quiet..."
    ec "Zyra ouviu algo importante ontem, e agora a selva está estranhamente silenciosa..."

# game/chapters/chapter6/ch6sc6.rpy:4410
translate brazil ch6sc6_727d5e4e:

#   ec "Let us pray that it is a coincidence, nothing more."
    ec "Rezemos para que seja uma coincidência, nada mais."

# game/chapters/chapter6/ch6sc6.rpy:4412
translate brazil ch6sc6_d4b327a3:

#   pl "I’m not terribly keen on this whole jungle thing... I much prefer being on the water."
    pl "Não sou muito fã dessa coisa toda de selva... Prefiro muito mais estar na água."

# game/chapters/chapter6/ch6sc6.rpy:4413
translate brazil ch6sc6_ca3c358d:

#   pl "On the water, you’re free... you can see miles around in every direction."
    pl "Na água, você é livre... você consegue ver quilômetros ao redor em todas as direções."

# game/chapters/chapter6/ch6sc6.rpy:4414
translate brazil ch6sc6_99b76238:

#   pl "In here... I feel like I'm surrounded by unseen threats that lurk behind every bush and tree."
    pl "Aqui dentro... sinto que estou cercado por ameaças invisíveis que espreitam atrás de cada arbusto e árvore."

# game/chapters/chapter6/ch6sc6.rpy:4418
translate brazil ch6sc6_3625191c:

#   ec "Hm, I never really thought about it like that."
    ec "Hum, nunca tinha pensado nisso dessa forma."

# game/chapters/chapter6/ch6sc6.rpy:4419
translate brazil ch6sc6_d5735dff:

#   ec "To us, the jungle is a blanket of safety and comfort."
    ec "Para nós, a selva é um refúgio de segurança e conforto."

# game/chapters/chapter6/ch6sc6.rpy:4420
translate brazil ch6sc6_9a6dd2a2:

#   ec "On the open water, you’re subject to the elements and powerless to do anything against a storm."
    ec "Em mar aberto, você está sujeito aos elementos e impotente para fazer qualquer coisa contra uma tempestade."

# game/chapters/chapter6/ch6sc6.rpy:4421
translate brazil ch6sc6_70b8f1d4:

#   ec "In here, your survival depends all on your own skills, and those of your allies."
    ec "Aqui, sua sobrevivência depende inteiramente de suas próprias habilidades e das de seus aliados."

# game/chapters/chapter6/ch6sc6.rpy:4423
translate brazil ch6sc6_20daf778:

#   pl "Huh... I guess they both have their advantages and drawbacks. Maybe it just depends on what you’re used to?"
    pl "Hum... Acho que ambos têm suas vantagens e desvantagens. Talvez dependa apenas do que você está acostumado?"

# game/chapters/chapter6/ch6sc6.rpy:4424
translate brazil ch6sc6_de681cea:

#   pl "Do you think we’ll come across the temple Vex mentioned? We’ve been out here for hours."
    pl "Você acha que vamos encontrar o templo que Vex mencionou? Estamos aqui fora há horas."

# game/chapters/chapter6/ch6sc6.rpy:4426
translate brazil ch6sc6_0f107f77:

#   ec "It is difficult to say... the temple might be harder to find than we first thought."
    ec "É difícil dizer... o templo pode ser mais difícil de encontrar do que pensávamos inicialmente."

# game/chapters/chapter6/ch6sc6.rpy:4427
translate brazil ch6sc6_7ba79313:

#   ec "We only found the other temple by accident, when I fell into that opening. That was not the normal entrance."
    ec "Só encontramos o outro templo por acaso, quando caí naquela abertura. Aquela não era a entrada normal."

# game/chapters/chapter6/ch6sc6.rpy:4428
translate brazil ch6sc6_b8f26298:

#   ec "These temples seem to be quite elusive, more than I expected."
    ec "Esses templos parecem ser bastante difíceis de encontrar, mais do que eu esperava."

# game/chapters/chapter6/ch6sc6.rpy:4430
translate brazil ch6sc6_301eb214:

#   mc "Hmmm... after experiencing yesterday's temple, I’m rather curious to see this one."
    mc "Hum... depois de visitar o templo de ontem, estou bastante curioso para ver este."

# game/chapters/chapter6/ch6sc6.rpy:4431
translate brazil ch6sc6_cca73fb1:

#   mc "Hey, Vex?"
    mc "Ei, Vex?"

# game/chapters/chapter6/ch6sc6.rpy:4433
translate brazil ch6sc6_853d6763:

#   vx "Yes, what is it?"
    vx "Sim, o que é?"

# game/chapters/chapter6/ch6sc6.rpy:4435
translate brazil ch6sc6_9591cba7:

#   mc "I know you told us everything you could recall about the tale you heard."
    mc "Sei que você nos contou tudo o que se lembrava sobre a história que ouviu."

# game/chapters/chapter6/ch6sc6.rpy:4436
translate brazil ch6sc6_83c20dca:

#   mc "But, being out here and seeing everything for yourself, does it bring anything else to mind?"
    mc "Mas, estando aqui e vendo tudo com meus próprios olhos, isso lhe traz alguma outra coisa à mente?"

# game/chapters/chapter6/ch6sc6.rpy:4438
translate brazil ch6sc6_70cca056:

#   vx "Hmm..."
    vx "Hum..."

# game/chapters/chapter6/ch6sc6.rpy:4439
translate brazil ch6sc6_33844af1:

#   vx "Now that you mention it..."
    vx "Agora que você mencionou isso..."

# game/chapters/chapter6/ch6sc6.rpy:4441
translate brazil ch6sc6_bbb15a70:

#   vx "I do recall they said something about a unique plant, or possibly a flower, that grew near the temple entrance."
    vx "Lembro-me de terem mencionado algo sobre uma planta peculiar, ou talvez uma flor, que crescia perto da entrada do templo."

# game/chapters/chapter6/ch6sc6.rpy:4442
translate brazil ch6sc6_aa419a92:

#   vx "I didn't think much about it at the time, there are so many different plants that grow out here."
    vx "Na época, não pensei muito nisso, pois há tantas plantas diferentes que crescem por aqui."

# game/chapters/chapter6/ch6sc6.rpy:4443
translate brazil ch6sc6_8b6e99f6:

#   vx "Just ask Miyo, she’s a herbalist."
    vx "Basta perguntar à Miyo, ela é uma herbalista."

# game/chapters/chapter6/ch6sc6.rpy:4445
translate brazil ch6sc6_26f4ac29:

#   tz "Sometimes the devil hides in the details. This could prove quite useful."
    tz "Às vezes, o diabo se esconde nos detalhes. Isso pode ser bastante útil."

# game/chapters/chapter6/ch6sc6.rpy:4446
translate brazil ch6sc6_6d64938c:

#   tz "Good job, Vex."
    tz "Bom trabalho, Vex."

# game/chapters/chapter6/ch6sc6.rpy:4449
translate brazil ch6sc6_bc9f63ff:

#   ec "Tazzy is right. This might give us a clue to locate the temple’s entrance."
    ec "Tazzy tem razão. Isso pode nos dar uma pista para localizar a entrada do templo."

# game/chapters/chapter6/ch6sc6.rpy:4450
translate brazil ch6sc6_9c7a1732:

#   ec "Do you remember any details about the plant? Like the color of its flower, or its shape and size?"
    ec "Você se lembra de algum detalhe sobre a planta? Como a cor da flor, ou seu formato e tamanho?"

# game/chapters/chapter6/ch6sc6.rpy:4453
translate brazil ch6sc6_4545b42f:

#   vx "How did they describe it...?"
    vx "Como eles descreveram isso...?"

# game/chapters/chapter6/ch6sc6.rpy:4455
translate brazil ch6sc6_5f50eb37:

#   vx "Oh!"
    vx "Oh!"

# game/chapters/chapter6/ch6sc6.rpy:4456
translate brazil ch6sc6_0407390b:

#   vx "I remember now!"
    vx "Agora me lembro!"

# game/chapters/chapter6/ch6sc6.rpy:4465
translate brazil ch6sc6_1a91e991:

#   vx "They said it was similar to a Dusk Orchid, which has been my favorite flower ever since Miyo showed me one."
    vx "Disseram que era semelhante a uma orquídea crepuscular, que é minha flor favorita desde que Miyo me mostrou uma."

# game/chapters/chapter6/ch6sc6.rpy:4466
translate brazil ch6sc6_64fd5c7f:

#   vx "Only, this one was a blue color instead of dark purple. But the shape and size should be much the same."
    vx "Só que este era azul em vez de roxo escuro. Mas o formato e o tamanho devem ser praticamente os mesmos."

# game/chapters/chapter6/ch6sc6.rpy:4471
translate brazil ch6sc6_34d87c52:

#   vx "I remember the women describing it like the flowers had been formed from the tears of a star."
    vx "Lembro-me das mulheres descrevendo como se as flores tivessem sido formadas pelas lágrimas de uma estrela."

# game/chapters/chapter6/ch6sc6.rpy:4472
translate brazil ch6sc6_5059d08e:

#   vx "Which is why they are blue!"
    vx "É por isso que eles são azuis!"

# game/chapters/chapter6/ch6sc6.rpy:4475
translate brazil ch6sc6_bd15876c:

#   ec "That sounds like they might be describing Starlight Roses."
    ec "Parece que eles estão descrevendo Starlight Roses."

# game/chapters/chapter6/ch6sc6.rpy:4476
translate brazil ch6sc6_3bb2477d:

#   ec "If I remember correctly, some grow in an area not far from where we stand."
    ec "Se bem me lembro, algumas crescem numa área não muito longe de onde estamos."

# game/chapters/chapter6/ch6sc6.rpy:4478
translate brazil ch6sc6_458f3aea:

#   ec "Follow me, I will guide us there."
    ec "Sigam-me, eu os guiarei até lá."

# game/chapters/chapter6/ch6sc6.rpy:4479
translate brazil ch6sc6_dfe7b392:

#   mc "Perfect. We’ll follow your lead, Echo."
    mc "Perfeito. Seguiremos suas instruções, Echo."

# game/chapters/chapter6/ch6sc6.rpy:4482
translate brazil ch6sc6_805c4f65:

#   "About thirty minutes later, you begin searching the area where the Starlight Roses supposedly grow."
    "Cerca de trinta minutos depois, você começa a procurar na área onde supostamente crescem as Rosas da Luz das Estrelas."

# game/chapters/chapter6/ch6sc6.rpy:4485
translate brazil ch6sc6_3adf7051:

#   pl "*Sighs* We’ve been looking for a while and I still don’t see any blue flowers. Just green, on top of more green."
    pl "*Suspiro* Já faz um tempo que estamos procurando e ainda não vejo nenhuma flor azul. Só verde, em cima de mais verde."

# game/chapters/chapter6/ch6sc6.rpy:4487
translate brazil ch6sc6_f308c8ed:

#   tz "I’m sure we’ll find them, we just have to keep looking."
    tz "Tenho certeza de que os encontraremos, só precisamos continuar procurando."

# game/chapters/chapter6/ch6sc6.rpy:4489
translate brazil ch6sc6_1d84a6f7:

#   pl "I’m just a little bored with the endless jungle... why can’t these temples be located in a big lake?"
    pl "Estou um pouco entediado com essa selva interminável... por que esses templos não podem estar localizados em um grande lago?"

# game/chapters/chapter6/ch6sc6.rpy:4490
translate brazil ch6sc6_797a06b0:

#   pl "Then we could swim around and look for fishys."
    pl "Então poderíamos nadar por aí e procurar peixinhos."

# game/chapters/chapter6/ch6sc6.rpy:4492
translate brazil ch6sc6_199bdc97:

#   tz "Why do you like fish so much?"
    tz "Por que você gosta tanto de peixe?"

# game/chapters/chapter6/ch6sc6.rpy:4493
translate brazil ch6sc6_a25a735b:

#   pl "..."
    pl "..."

# game/chapters/chapter6/ch6sc6.rpy:4494
translate brazil ch6sc6_f85d8aaa:

#   pl "They’re cute."
    pl "Eles são fofos."

# game/chapters/chapter6/ch6sc6.rpy:4495
translate brazil ch6sc6_ceae09bf:

#   tz "Sure, I suppose they can be... but-"
    tz "Claro, suponho que possam ser... mas-"

# game/chapters/chapter6/ch6sc6.rpy:4499
translate brazil ch6sc6_e58962df:

#   pl "{b}Don’t push it{/b}, Taz."
    pl "{b}Não force a barra.{/b}, Taz."

# game/chapters/chapter6/ch6sc6.rpy:4500
translate brazil ch6sc6_6c289c25:

#   pl "Kira and [mc] are the {b}only{/b} people who know. You and I may be getting along, but we aren’t that close."
    pl "Kira e [mc] são os {b} apenas{/b} Pessoas que sabem. Você e eu podemos até nos dar bem, mas não somos tão próximos assim."

# game/chapters/chapter6/ch6sc6.rpy:4501
translate brazil ch6sc6_012ff5b8:

#   pl "Don’t push me on this, okay?"
    pl "Não me pressione quanto a isso, ok?"

# game/chapters/chapter6/ch6sc6.rpy:4502
translate brazil ch6sc6_bf2d40e1:

#   tz "*Nods in agreement* Mh-hm! Mh-hm!"
    tz "*Acena com a cabeça em concordância* Hum-hum! Hum-hum!"

# game/chapters/chapter6/ch6sc6.rpy:4504
translate brazil ch6sc6_3680a7b2:

#   pl "Great! Then I won’t have to {b}cut your throat!{/b} *Giggles*"
    pl "Ótimo! Então eu não precisarei... {b} Corte sua garganta!{/b} *Risos*"

# game/chapters/chapter6/ch6sc6.rpy:4505
translate brazil ch6sc6_12bb1394:

#   tz "Y-You’re kidding? R-Right?"
    tz "V-Você está brincando? C-Certo?"

# game/chapters/chapter6/ch6sc6.rpy:4506
translate brazil ch6sc6_d281768e:

#   pl "Mmmh-hmm! *Snickers*"
    pl "Hum-hum! *Risinhos*"

# game/chapters/chapter6/ch6sc6.rpy:4508
translate brazil ch6sc6_0191e40c:

#   mc "Pearl, stop tormenting poor Tazzy. She’ll have nightmares"
    mc "Pearl, pare de atormentar a pobre Tazzy. Ela vai ter pesadelos."

# game/chapters/chapter6/ch6sc6.rpy:4509
translate brazil ch6sc6_fba742c2:

#   pl "Sorry! I was just bored..."
    pl "Desculpe! Eu estava apenas entediado..."

# game/chapters/chapter6/ch6sc6.rpy:4510
translate brazil ch6sc6_f4fdc7fb:

#   pl "And she was poking me about fishys..."
    pl "E ela estava me cutucando sobre peixinhos..."

# game/chapters/chapter6/ch6sc6.rpy:4511
translate brazil ch6sc6_d3fe03fd:

#   mc "Taz, don’t push Pearl on that topic. She will tell you if she comes to care enough about you."
    mc "Taz, não pressione a Pearl sobre esse assunto. Ela vai te contar se passar a se importar o suficiente com você."

# game/chapters/chapter6/ch6sc6.rpy:4512
translate brazil ch6sc6_f4f582b6:

#   tz "*Nods* Mh!"
    tz "*Acena com a cabeça* Hum!"

# game/chapters/chapter6/ch6sc6.rpy:4513
translate brazil ch6sc6_2dbe92db:

#   pl "*Giggles* Heheh! You’re getting scolded too!"
    pl "*Risos* Heheh! Você também vai levar bronca!"

# game/chapters/chapter6/ch6sc6.rpy:4518
translate brazil ch6sc6_b136a1da:

#   vx "On guard, everyone!"
    vx "Atenção, pessoal!"

# game/chapters/chapter6/ch6sc6.rpy:4519
translate brazil ch6sc6_74a32ba0:

#   vx "Something moved out there."
    vx "Algo se mexeu lá fora."

# game/chapters/chapter6/ch6sc6.rpy:4520
translate brazil ch6sc6_ebc7aacb:

#   ec "*Hushed* Pearl! Tazzy! You’re with me!"
    ec "*Sussurro* Pearl! Tazzy! Vocês estão comigo!"

# game/chapters/chapter6/ch6sc6.rpy:4522
translate brazil ch6sc6_a52dcd89:

#   vx "We’re on our own now, be vigilant... Champion."
    vx "Agora estamos por nossa conta, fiquem atentos... Campeão."

# game/chapters/chapter6/ch6sc6.rpy:4524
translate brazil ch6sc6_b9ccff4e:

#   mc "What did you see?"
    mc "O que você viu?"

# game/chapters/chapter6/ch6sc6.rpy:4525
translate brazil ch6sc6_18b7713e:

#   vx "I did not see it, I heard it... and it sounded big."
    vx "Eu não vi, eu ouvi... e parecia enorme."

# game/chapters/chapter6/ch6sc6.rpy:4526
translate brazil ch6sc6_78affed0:

#   vx "We need to-"
    vx "Precisamos-"

# game/chapters/chapter6/ch6sc6.rpy:4528
translate brazil ch6sc6_68c7af56:

#   mc "Shh! Quiet, Vex."
    mc "Shh! Silêncio, Vex."

# game/chapters/chapter6/ch6sc6.rpy:4529
translate brazil ch6sc6_b41b0193:

#   mc "I can feel it moving... you’re right, it’s big... real big."
    mc "Consigo sentir se mexendo... você tem razão, é grande... muito grande."

# game/chapters/chapter6/ch6sc6.rpy:4530
translate brazil ch6sc6_7ee3f274:

#   mc "If the ground trembles when it moves, we’re in for a tough opponent."
    mc "Se o chão treme quando se move, temos um adversário difícil pela frente."

# game/chapters/chapter6/ch6sc6.rpy:4532
translate brazil ch6sc6_232fbcd5:

#   vx "There! I saw it! It’s- It’s coming this way!"
    vx "Ali! Eu vi! Está... Está vindo para cá!"

# game/chapters/chapter6/ch6sc6.rpy:4533
translate brazil ch6sc6_a51be5c9:

#   vx "I-I can’t believe it! It’s-"
    vx "Não acredito! É-"

# game/chapters/chapter6/ch6sc6.rpy:4535
translate brazil ch6sc6_731c5f0e:

#   "A huge serpent slithers swiftly towards you, emerging from the dense foilage."
    "Uma enorme serpente desliza rapidamente em sua direção, emergindo da densa folhagem."

# game/chapters/chapter6/ch6sc6.rpy:4536
translate brazil ch6sc6_6a6c5740:

#   mc "Jimun..."
    mc "Jimun..."

# game/chapters/chapter6/ch6sc6.rpy:4539
translate brazil ch6sc6_82c7da3f:

#   vx "Riiiyahh!"
    vx "Riiyahh!"

# game/chapters/chapter6/ch6sc6.rpy:4540
translate brazil ch6sc6_efeccc7c:

#   mc "Vex! Don’t be reckless!"
    mc "Irritado! Não seja imprudente!"

# game/chapters/chapter6/ch6sc6.rpy:4543
translate brazil ch6sc6_e838efe7:

#   vx "*Squeals* Aiiiyhh!!"
    vx "*Gritos* Aiiiyhh!!"

# game/chapters/chapter6/ch6sc6.rpy:4544
translate brazil ch6sc6_8bbb8df0:

#   mc "Vex!"
    mc "Irritado!"

# game/chapters/chapter6/ch6sc6.rpy:4546
translate brazil ch6sc6_1334fa1f:

#   mc "Onyx, I hope you’re in the mood for snake... cause we got a big one coming up."
    mc "Onyx, espero que você esteja com vontade de comer cobra... porque temos uma grande vindo por aí."

# game/chapters/chapter6/ch6sc6.rpy:4547
translate brazil ch6sc6_3076cdf9:

#   ox "Let’s dice it!"
    ox "Vamos analisar os dados!"

# game/chapters/chapter6/ch6sc6.rpy:4550
translate brazil ch6sc6_224db34f:

#   mc "Here we go."
    mc "Vamos lá."

# game/chapters/chapter6/ch6sc6.rpy:4554
translate brazil ch6sc6_1290d4cc:

#   vx "*Groans* Hnngh... faster than I expected."
    vx "*Gemidos* Hnngh... mais rápido do que eu esperava."

# game/chapters/chapter6/ch6sc6.rpy:4555
translate brazil ch6sc6_d900faae:

#   vx "I twisted my ankle during the fall... dammit!"
    vx "Torci o tornozelo durante a queda... droga!"

# game/chapters/chapter6/ch6sc6.rpy:4557
translate brazil ch6sc6_a1679c1e:

#   vx "[mc]... I let him down. I've let my partner down."
    vx "[mc]...Eu o decepcionei. Eu decepcionei meu parceiro."

# game/chapters/chapter6/ch6sc6.rpy:4559
translate brazil ch6sc6_02f09f06:

#   jim "SSaarrhhh!"
    jim "SSaarrhhh!"

# game/chapters/chapter6/ch6sc6.rpy:4562
translate brazil ch6sc6_7844d925:

#   vx "*Agonizing squeal* Aiiiyhh!"
    vx "*Grito agonizante* Aiiiyhh!"

# game/chapters/chapter6/ch6sc6.rpy:4563
translate brazil ch6sc6_fa081054:

#   mc "Hnnghh! Vex! Can you move?"
    mc "Hnnghh! Vex! Você consegue se mexer?"

# game/chapters/chapter6/ch6sc6.rpy:4564
translate brazil ch6sc6_1ae1879b:

#   vx "[mc]! N-No, *Groans* I twisted my ankle and... and my right leg feels numb."
    vx "[mc] N-Não, *Geme* Eu torci o tornozelo e... e minha perna direita está dormente."

# game/chapters/chapter6/ch6sc6.rpy:4566
translate brazil ch6sc6_2681b55b:

#   mc "Dammit, it nicked you with its fang. The numbing must be from the venom."
    mc "Droga, te picou com a presa. A dormência deve ser do veneno."

# game/chapters/chapter6/ch6sc6.rpy:4567
translate brazil ch6sc6_5ccbd862:

#   mc "Hnngh... I can’t hold it off much longer, I need to get you out of here."
    mc "Hnngh... Não consigo adiar por muito mais tempo, preciso tirar você daqui."

# game/chapters/chapter6/ch6sc6.rpy:4569
translate brazil ch6sc6_0dc255df:

#   ox "Master, I will keep the Jimun occupied while you get her out."
    ox "Mestre, vou manter o Jimun ocupado enquanto você a tira de lá."

# game/chapters/chapter6/ch6sc6.rpy:4570
translate brazil ch6sc6_89118402:

#   vx "Arrgh! It-It hurts!"
    vx "Argh! Isso dói!"

# game/chapters/chapter6/ch6sc6.rpy:4573
translate brazil ch6sc6_0fe55e29:

#   mc "Now, Onyx!"
    mc "Agora, Ônix!"

# game/chapters/chapter6/ch6sc6.rpy:4574
translate brazil ch6sc6_1d95a13b:

#   ox "Take that, big slimy bugger!"
    ox "Toma essa, seu verme nojento!"

# game/chapters/chapter6/ch6sc6.rpy:4576
translate brazil ch6sc6_9710f62c:

#   vx "Hnngh... [mc]?"
    vx "Hnngh... [mc]?"

# game/chapters/chapter6/ch6sc6.rpy:4577
translate brazil ch6sc6_cf78eafa:

#   vx "T-Thank you..."
    vx "O-Obrigado..."

# game/chapters/chapter6/ch6sc6.rpy:4578
translate brazil ch6sc6_efd830cc:

#   mc "Shh... you can thank me after we’ve defeated the Jimun. Until then... conserve your strength."
    mc "Shhh... você pode me agradecer depois que derrotarmos os Jimun. Até lá... conserve suas forças."

# game/chapters/chapter6/ch6sc6.rpy:4580
translate brazil ch6sc6_b341db5f:

#   vx "Mmghh... you rescued me..."
    vx "Mmghh... você me salvou..."

# game/chapters/chapter6/ch6sc6.rpy:4581
translate brazil ch6sc6_212c7a4e:

#   vx "The others keep calling you Champion... Hero... I’m starting to understand why."
    vx "Os outros continuam te chamando de Campeão... Herói... Estou começando a entender o porquê."

# game/chapters/chapter6/ch6sc6.rpy:4582
translate brazil ch6sc6_1726c3c1:

#   mc "I think the venom is starting to go to your head, little one."
    mc "Acho que o veneno está começando a subir à sua cabeça, pequeno."

# game/chapters/chapter6/ch6sc6.rpy:4584
translate brazil ch6sc6_38ed727a:

#   mc "Now, I’m not trying to be funny... but just stay put."
    mc "Olha, não estou tentando ser engraçado... mas fique aí parado."

# game/chapters/chapter6/ch6sc6.rpy:4585
translate brazil ch6sc6_f9c49435:

#   vx "Ha-ha... if I could, I’d kick your butt..."
    vx "Hahaha... se eu pudesse, eu te daria uma surra..."

# game/chapters/chapter6/ch6sc6.rpy:4586
translate brazil ch6sc6_ac036123:

#   vx "[mc], please... please be safe out there."
    vx "[mc] Por favor... por favor, tomem cuidado lá fora."

# game/chapters/chapter6/ch6sc6.rpy:4587
translate brazil ch6sc6_ef691a11:

#   mc "I’ll try, but I doubt that thing will make it easy. See you soon, little one."
    mc "Vou tentar, mas duvido que isso facilite as coisas. Até logo, meu bem."

# game/chapters/chapter6/ch6sc6.rpy:4592
translate brazil ch6sc6_65e5f216:

#   vx "[mc]! Be careful!"
    vx "[mc]! Tome cuidado!"

# game/chapters/chapter6/ch6sc6.rpy:4594
translate brazil ch6sc6_21a81c14:

#   mc "Hold it steady, Onyx! Time to see what this beast is made of."
    mc "Mantenha a calma, Onyx! Chegou a hora de ver do que essa fera é feita."

# game/chapters/chapter6/ch6sc6.rpy:4595
translate brazil ch6sc6_6e62d485:

#   ox "Hnnghh! Hurry Master! Holding this thing is using up all my energy... It's incredibly strong!"
    ox "Hnnghh! Depressa, Mestre! Segurar isso está consumindo toda a minha energia... É incrivelmente forte!"

# game/chapters/chapter6/ch6sc6.rpy:4600
translate brazil ch6sc6_4c011ef7:

#   mc "Why can't you pierce it, Onyx?"
    mc "Por que você não consegue perfurá-lo, Ônix?"

# game/chapters/chapter6/ch6sc6.rpy:4601
translate brazil ch6sc6_7f648f40:

#   ox "The scales! They’re harder and denser than metal! It’s like it's covered in armor plating!"
    ox "As escamas! São mais duras e densas que metal! É como se estivessem cobertas por uma armadura!"

# game/chapters/chapter6/ch6sc6.rpy:4604
translate brazil ch6sc6_9df4b9aa:

#   jim "Shaarrrh!!"
    jim "Shaarrrr!!"

# game/chapters/chapter6/ch6sc6.rpy:4605
translate brazil ch6sc6_8aa855c7:

#   ox "I can’t hold it any longer!"
    ox "Não consigo mais segurar!"

# game/chapters/chapter6/ch6sc6.rpy:4608
translate brazil ch6sc6_82430fdb:

#   jim "Sharrhhrr!"
    jim "Shhhhrr!"

# game/chapters/chapter6/ch6sc6.rpy:4610
translate brazil ch6sc6_3d1a60ed:

#   mc "Here it comes..."
    mc "Lá vem ele..."

# game/chapters/chapter6/ch6sc6.rpy:4612
translate brazil ch6sc6_77008a6d:

#   mc "If Onyx can't cut through its scales, maybe this will do the trick?"
    mc "Se Onyx não consegue cortar suas escamas, talvez isso resolva o problema?"

# game/chapters/chapter6/ch6sc6.rpy:4613
translate brazil ch6sc6_e8ac9d9e:

#   mc "Wind has incredible piercing properties when you compress it enough."
    mc "O vento possui propriedades penetrantes incríveis quando comprimido o suficiente."

# game/chapters/chapter6/ch6sc6.rpy:4615
translate brazil ch6sc6_300609c1:

#   mc "I’ll compress it into a javelin of wind, powerful enough to penetrate even a castle wall."
    mc "Vou comprimi-la em uma lança de vento, poderosa o suficiente para penetrar até mesmo a muralha de um castelo."

# game/chapters/chapter6/ch6sc6.rpy:4618
translate brazil ch6sc6_da95669b:

#   mc "That should do it."
    mc "Isso deve resolver o problema."

# game/chapters/chapter6/ch6sc6.rpy:4620
translate brazil ch6sc6_c39fc108:

#   mc "Let’s see how you handle this, big guy."
    mc "Vamos ver como você lida com isso, grandalhão."

# game/chapters/chapter6/ch6sc6.rpy:4623
translate brazil ch6sc6_b705fe1d:

#   jim "{b}SharHHR!!{/b}"
    jim "{b}SharHHR!!{/b}"

# game/chapters/chapter6/ch6sc6.rpy:4624
translate brazil ch6sc6_3f73713e:

#   mc "Sounds like it felt it, but there's no puncture wound... fuck!"
    mc "Parece que sentiu algo, mas não há nenhum ferimento perfurante... droga!"

# game/chapters/chapter6/ch6sc6.rpy:4627
translate brazil ch6sc6_12de8f42:

#   mc "It’s coming, {b}FAST!{/b}"
    mc "Está chegando, {b} RÁPIDO!{/b}"

# game/chapters/chapter6/ch6sc6.rpy:4630
translate brazil ch6sc6_686a0397:

#   mc "Hnnngh! How is it so damn fast? Something this big that doesn't even have legs... it shouldn’t be able to move this quickly."
    mc "Hnnngh! Como é que é tão rápido? Uma coisa tão grande que nem sequer tem pernas... não deveria conseguir mover-se tão depressa."

# game/chapters/chapter6/ch6sc6.rpy:4631
translate brazil ch6sc6_0353bab9:

#   mc "F-Fuck... I hate to admit it, Onyx, but you were right. Hnnngh... This bastard is strong as hell."
    mc "Puta merda... Odeio admitir, Onyx, mas você tinha razão. Hnnngh... Esse desgraçado é forte pra caramba."

# game/chapters/chapter6/ch6sc6.rpy:4632
translate brazil ch6sc6_8ca96cf8:

#   ox "Master! W-What do we do?! I can feel Jimun's strength overpowering yours!"
    ox "Mestre! O que fazemos?! Sinto a força de Jimun superando a sua!"

# game/chapters/chapter6/ch6sc6.rpy:4633
translate brazil ch6sc6_6c93878d:

#   mc "Onyx... wait... Onyx, that’s it! Thank you, you just gave me an idea."
    mc "Ônix... espera... Ônix, é isso! Obrigada, você acabou de me dar uma ideia."

# game/chapters/chapter6/ch6sc6.rpy:4634
translate brazil ch6sc6_541a26c7:

#   ox "What did I say?"
    ox "O que eu disse?"

# game/chapters/chapter6/ch6sc6.rpy:4637
translate brazil ch6sc6_5a300b0f:

#   jim "ShARH!"
    jim "ANÁLISE!"

# game/chapters/chapter6/ch6sc6.rpy:4640
translate brazil ch6sc6_878bf517:

#   vx "{b}*Screams* [mc]!!! NO!!{/b}"
    vx "{b}*Gritos* [mc]!!! NÃO!!{/b}"

# game/chapters/chapter6/ch6sc6.rpy:4641
translate brazil ch6sc6_cba57fea:

#   vx "It... it ate him!!"
    vx "Ele... ele o devorou!!"

# game/chapters/chapter6/ch6sc6.rpy:4643
translate brazil ch6sc6_ac3321f6:

#   jim "Shrrhhh!!"
    jim "Shrrhhh!!"

# game/chapters/chapter6/ch6sc6.rpy:4644
translate brazil ch6sc6_5a68d0dd:

#   vx "AiiiyhH!"
    vx "AiiiyhH!"

# game/chapters/chapter6/ch6sc6.rpy:4646
translate brazil ch6sc6_3cd9e6c4:

#   vx "It... it stopped moving?"
    vx "Ele... ele parou de se mexer?"

# game/chapters/chapter6/ch6sc6.rpy:4648
translate brazil ch6sc6_f4bd043e:

#   jim "..."
    jim "..."

# game/chapters/chapter6/ch6sc6.rpy:4655
translate brazil ch6sc6_f2341561:

#   vx "*Gasps* {b}HUUUH?!{/b}"
    vx "*Suspiros* {b} Hã?!{/b}"

# game/chapters/chapter6/ch6sc6.rpy:4656
translate brazil ch6sc6_8e1a15ae:

#   vx "I-I... I can’t believe it..."
    vx "II... Não consigo acreditar..."

# game/chapters/chapter6/ch6sc6.rpy:4660
translate brazil ch6sc6_c79339cb:

#   ox "Brilliant plan, Master! We couldn’t pierce its tough exterior, but like all creatures... it is mushy on the inside!"
    ox "Plano brilhante, Mestre! Não conseguimos penetrar sua casca dura, mas como todas as criaturas... é mole por dentro!"

# game/chapters/chapter6/ch6sc6.rpy:4663
translate brazil ch6sc6_1a8c9887:

#   mc "*Panting* Hnnghh... still, that was still tough to cut through..."
    mc "*Ofegante* Hnnghh... mesmo assim, foi difícil de cortar..."

# game/chapters/chapter6/ch6sc6.rpy:4665
translate brazil ch6sc6_402ba94f:

#   ox "That was an astonishing risk you took, letting it gobble you up like that. How did you know it would work?"
    ox "Foi um risco enorme que você correu, deixando-se ser engolido dessa forma. Como você sabia que daria certo?"

# game/chapters/chapter6/ch6sc6.rpy:4666
translate brazil ch6sc6_4ea7131c:

#   mc "I didn’t... but when you were talking, it reminded me that you’re inside of me."
    mc "Eu não... mas enquanto você falava, isso me lembrou que você está dentro de mim."

# game/chapters/chapter6/ch6sc6.rpy:4667
translate brazil ch6sc6_f24cd21a:

#   mc "Not in my stomach, of course, but it sparked the idea of trying to slice it from inside instead."
    mc "Não no meu estômago, claro, mas isso me deu a ideia de tentar cortá-lo por dentro."

# game/chapters/chapter6/ch6sc6.rpy:4668
translate brazil ch6sc6_2dd8d406:

#   ox "Clever! Glad I could assist! Even though you just gambled with both of our lives..."
    ox "Que esperto! Fico feliz em poder ajudar! Mesmo que você tenha acabado de arriscar nossas vidas..."

# game/chapters/chapter6/ch6sc6.rpy:4669
translate brazil ch6sc6_8bfab06d:

#   mc "I could barely hold that thing... not even with the physical enhancement I got from Malpheon’s talisman."
    mc "Eu mal conseguia segurar aquilo... nem mesmo com o aprimoramento físico que recebi do talismã de Malpheon."

# game/chapters/chapter6/ch6sc6.rpy:4670
translate brazil ch6sc6_ba636584:

#   ox "Mythical beasts are no joke, Master."
    ox "Criaturas míticas não são brincadeira, Mestre."

# game/chapters/chapter6/ch6sc6.rpy:4672
translate brazil ch6sc6_2846f0bb:

#   mc "Vex! We need to check on her, she was wounded."
    mc "Vex! Precisamos ver como ela está, ela foi ferida."

# game/chapters/chapter6/ch6sc6.rpy:4673
translate brazil ch6sc6_938d4ad2:

#   ox "Go on. I’m going to take a long nap to recover."
    ox "Pode ir. Vou tirar uma longa soneca para me recuperar."

# game/chapters/chapter6/ch6sc6.rpy:4675
translate brazil ch6sc6_ba752c82:

#   vx "*Groans* Hnngh!"
    vx "*Gemidos* Hnngh!"

# game/chapters/chapter6/ch6sc6.rpy:4676
translate brazil ch6sc6_3377b9e5:

#   mc "What in the five hells is she doing?!"
    mc "Que diabos ela está fazendo?!"

# game/chapters/chapter6/ch6sc6.rpy:4678
translate brazil ch6sc6_7b10afde:

#   mc "Hey, hey... where are you going?"
    mc "Ei, ei... para onde você está indo?"

# game/chapters/chapter6/ch6sc6.rpy:4679
translate brazil ch6sc6_39e24797:

#   vx "Nnnghh... going to... check you... for wounds."
    vx "Nnnghh... vou... verificar... se você tem ferimentos."

# game/chapters/chapter6/ch6sc6.rpy:4680
translate brazil ch6sc6_553de724:

#   vx "Hnnghh... then... kick your ass."
    vx "Hnnghh... então... vou te dar uma surra."

# game/chapters/chapter6/ch6sc6.rpy:4682
translate brazil ch6sc6_20e1246a:

#   mc "Come here, little one. I need to check your wound."
    mc "Venha cá, pequenino. Preciso examinar seu ferimento."

# game/chapters/chapter6/ch6sc6.rpy:4683
translate brazil ch6sc6_13248e41:

#   vx "You were so reckless... after I said to be careful!"
    vx "Você foi tão imprudente... depois de eu ter dito para ter cuidado!"

# game/chapters/chapter6/ch6sc6.rpy:4684
translate brazil ch6sc6_9315a1f7:

#   vx "I saw it! It... it ate you! All because I... I was foolish and rushed in blindly."
    vx "Eu vi! Isso... isso te devorou! Tudo porque eu... eu fui tolo e me precipitei às cegas."

# game/chapters/chapter6/ch6sc6.rpy:4686
translate brazil ch6sc6_cffb7eea:

#   vx "W-What are you doing back there...?"
    vx "O que você está fazendo aí atrás...?"

# game/chapters/chapter6/ch6sc6.rpy:4687
translate brazil ch6sc6_57997612:

#   vx "I feel... exposed like this."
    vx "Eu me sinto... exposta assim."

# game/chapters/chapter6/ch6sc6.rpy:4688
translate brazil ch6sc6_1106a595:

#   mc "I’m going to cure your wound before an infection sets in."
    mc "Vou tratar seu ferimento antes que uma infecção se instale."

# game/chapters/chapter6/ch6sc6.rpy:4690
translate brazil ch6sc6_2bb4b1a1:

#   vx "Cure my wound? Are you both a shaman and a warrior?"
    vx "Curar meu ferimento? Você é ao mesmo tempo xamã e guerreiro?"

# game/chapters/chapter6/ch6sc6.rpy:4691
translate brazil ch6sc6_720c48d9:

#   mc "*Chuckles* No, not a shaman. Just a guy with a few tricks."
    mc "*Risos* Não, não sou um xamã. Só um cara com alguns truques."

# game/chapters/chapter6/ch6sc6.rpy:4692
translate brazil ch6sc6_b269c534:

#   mc "Hold still."
    mc "Fique parado."

# game/chapters/chapter6/ch6sc6.rpy:4694
translate brazil ch6sc6_0e60f055:

#   vx "*Gasps* Aahhh... oh... oh, o-okay..."
    vx "*Suspiros* Aahhh... oh... oh, o-ok..."

# game/chapters/chapter6/ch6sc6.rpy:4695
translate brazil ch6sc6_93d26407:

#   vx "MMmgh... [mc]..."
    vx "Hmmm... [mc]..."

# game/chapters/chapter6/ch6sc6.rpy:4697
translate brazil ch6sc6_b0868d0c:

#   mc "I promised Echo you wouldn’t get hurt. This is the least I can do."
    mc "Eu prometi à Echo que você não se machucaria. Isso é o mínimo que posso fazer."

# game/chapters/chapter6/ch6sc6.rpy:4698
translate brazil ch6sc6_a864d52a:

#   vx "I... would never blame you for any of this."
    vx "Eu... jamais te culparia por nada disso."

# game/chapters/chapter6/ch6sc6.rpy:4701
translate brazil ch6sc6_b91fb7cc:

#   vx "Ohh... that feels... so warm."
    vx "Ohh... que sensação... tão aconchegante."

# game/chapters/chapter6/ch6sc6.rpy:4702
translate brazil ch6sc6_e3aeeefa:

#   mc "It’s working, thank the heavens..."
    mc "Está funcionando, graças a Deus..."

# game/chapters/chapter6/ch6sc6.rpy:4703
translate brazil ch6sc6_4415f5c2:

#   mc "I wasn’t sure if it would, given that it wasn’t from an ordinary beast."
    mc "Eu não tinha certeza se funcionaria, visto que não se tratava de um animal comum."

# game/chapters/chapter6/ch6sc6.rpy:4705
translate brazil ch6sc6_ee43ef38:

#   mc "How does it feel? Is there any pain?"
    mc "Como você se sente? Sente alguma dor?"

# game/chapters/chapter6/ch6sc6.rpy:4706
translate brazil ch6sc6_874d03d7:

#   vx "*Gasps lightly* [mc]... mmmh... n-no, no pain..."
    vx "*Suspira levemente* [mc]... hum... n-não, sem dor..."

# game/chapters/chapter6/ch6sc6.rpy:4707
translate brazil ch6sc6_1eb8ee4a:

#   vx "Just... your warm hands... mmm."
    vx "Só... suas mãos quentinhas... hum."

# game/chapters/chapter6/ch6sc6.rpy:4708
translate brazil ch6sc6_588d9726:

#   mc "That’s good. See if your leg can support your own weight."
    mc "Que bom. Veja se sua perna consegue suportar seu próprio peso."

# game/chapters/chapter6/ch6sc6.rpy:4710
translate brazil ch6sc6_def256b3:

#   vx "Nnghh... it feels like... like before we even encountered Jimun."
    vx "Nnghh... parece... como se fosse antes mesmo de encontrarmos o Jimun."

# game/chapters/chapter6/ch6sc6.rpy:4711
translate brazil ch6sc6_c1bf7414:

#   vx "T-Thank you... Hero. You saved my life... twice."
    vx "O-Obrigado... Herói. Você salvou minha vida... duas vezes."

# game/chapters/chapter6/ch6sc6.rpy:4712
translate brazil ch6sc6_89b6c305:

#   mc "What are partners for? Think you’re good to stand on your own?"
    mc "Para que servem os parceiros? Acha que consegue se virar sozinho?"

# game/chapters/chapter6/ch6sc6.rpy:4714
translate brazil ch6sc6_ad00b087:

#   vx "Not yet... hold me a little longer..."
    vx "Ainda não... me abrace mais um pouquinho..."

# game/chapters/chapter6/ch6sc6.rpy:4715
translate brazil ch6sc6_c1a6339a:

#   mc "Sure... but you’re not leaving me much space back here."
    mc "Claro... mas você não está me deixando muito espaço aqui atrás."

# game/chapters/chapter6/ch6sc6.rpy:4716
translate brazil ch6sc6_da529ee7:

#   vx "You have enough... MMm..."
    vx "Você já tem o suficiente... Hum..."

# game/chapters/chapter6/ch6sc6.rpy:4717
translate brazil ch6sc6_46553ce4:

#   vx "O-Okay, I’m ready to stand on my own."
    vx "Ok, estou pronto para me virar sozinho."

# game/chapters/chapter6/ch6sc6.rpy:4719
translate brazil ch6sc6_267a0faf:

#   vx "S-Sorry... I just needed a bit of help before I felt sure of myself."
    vx "D-Desculpe... Eu só precisava de um pouco de ajuda para me sentir mais confiante."

# game/chapters/chapter6/ch6sc6.rpy:4721
translate brazil ch6sc6_c035103a:

#   mc "I think I'll survive you using my face as a support for your ass."
    mc "Acho que sobreviverei se você usar meu rosto como apoio para sua bunda."

# game/chapters/chapter6/ch6sc6.rpy:4722
translate brazil ch6sc6_ecf416ff:

#   mc "Just don’t make a habit out of it. *Chuckles*"
    mc "Só não faça disso um hábito. *Risos*"

# game/chapters/chapter6/ch6sc6.rpy:4724
translate brazil ch6sc6_bcc4f758:

#   vx "No promises..."
    vx "Sem promessas..."

# game/chapters/chapter6/ch6sc6.rpy:4725
translate brazil ch6sc6_ddbfd01a:

#   vx "You have a very comfortable face to sit on-"
    vx "Você tem um rosto muito confortável para sentar."

# game/chapters/chapter6/ch6sc6.rpy:4728
translate brazil ch6sc6_82115897:

#   vx "{b}*Squeals*{/b} Aiiiyh! Forget I said that! By all the jungles!"
    vx "{b}*Gritos de alegria*{/b} Aiiiyh! Esqueçam o que eu disse! Pelas selvas!"

# game/chapters/chapter6/ch6sc6.rpy:4729
translate brazil ch6sc6_a0b96682:

#   mc "*Chuckles* It is forever burned into my mind."
    mc "*Risos* Isso ficará gravado para sempre na minha mente."

# game/chapters/chapter6/ch6sc6.rpy:4731
translate brazil ch6sc6_33b64468:

#   vx "Do you want me to get my spear?!"
    vx "Você quer que eu pegue minha lança?!"

# game/chapters/chapter6/ch6sc6.rpy:4732
translate brazil ch6sc6_c73c122f:

#   vx "It’s right over there, and- and I already thanked you for saving me... so I’m free to kill you now!"
    vx "É ali mesmo, e... e eu já te agradeci por me salvar... então agora posso te matar!"

# game/chapters/chapter6/ch6sc6.rpy:4734
translate brazil ch6sc6_dbcc1a1b:

#   mc "You’re cute."
    mc "Você é fofo(a)."

# game/chapters/chapter6/ch6sc6.rpy:4735
translate brazil ch6sc6_eb04093e:

#   vx "Hnnrrhh..."
    vx "Hnnrrh..."

# game/chapters/chapter6/ch6sc6.rpy:4737
translate brazil ch6sc6_864b1cf1:

#   "She can't help but smile at you, she is clearly relieved you're okay."
    "Ela não consegue conter o sorriso, está claramente aliviada por você estar bem."

# game/chapters/chapter6/ch6sc6.rpy:4739
translate brazil ch6sc6_7a27f959:

#   vx "You know... you were really impressive back there."
    vx "Sabe... você foi realmente impressionante lá atrás."

# game/chapters/chapter6/ch6sc6.rpy:4740
translate brazil ch6sc6_f20f3350:

#   vx "Even if you were reckless."
    vx "Mesmo que você tenha sido imprudente."

# game/chapters/chapter6/ch6sc6.rpy:4742
translate brazil ch6sc6_b842e745:

#   mc "*Chuckles* You're criticising me for being reckless, little one?"
    mc "*Risos* Você está me criticando por ser imprudente, meu bem?"

# game/chapters/chapter6/ch6sc6.rpy:4744
translate brazil ch6sc6_2a68510b:

#   vx "*Giggles lightly* I guess I'm not the best one to give a lecture on that topic."
    vx "*Risos discretos* Acho que não sou a pessoa mais indicada para dar uma palestra sobre esse assunto."

# game/chapters/chapter6/ch6sc6.rpy:4746
translate brazil ch6sc6_b1fa8459:

#   vx "I... I just wish I could've been more helpful."
    vx "Eu... eu só queria ter podido ajudar mais."

# game/chapters/chapter6/ch6sc6.rpy:4748
translate brazil ch6sc6_72bf204f:

#   vx "Instead, I got myself injured straight away."
    vx "Em vez disso, acabei me machucando logo de cara."

# game/chapters/chapter6/ch6sc6.rpy:4749
translate brazil ch6sc6_dc17d0b6:

#   vx "And you had to rescue me, putting yourself at risk to do so."
    vx "E você teve que me resgatar, colocando-se em risco para isso."

# game/chapters/chapter6/ch6sc6.rpy:4754
translate brazil ch6sc6_f2041d99:

#   ec "{b}*Shouting*{/b} [mc]! Vex!"
    ec "{b}*Gritando*{/b}  [mc]! Irritado!"

# game/chapters/chapter6/ch6sc6.rpy:4758
translate brazil ch6sc6_f9930c41:

#   "Echo rushes into your arms, embracing you worriedly, then checking you for wounds."
    "Echo corre para seus braços, abraçando-o(a) preocupado(a), e em seguida verifica se você tem ferimentos."

# game/chapters/chapter6/ch6sc6.rpy:4759
translate brazil ch6sc6_6860ebb6:

#   ec "By the jungle... are you hurt?"
    ec "Na selva... você está ferido?"

# game/chapters/chapter6/ch6sc6.rpy:4760
translate brazil ch6sc6_96df17ce:

#   mc "No, I’m alright... we both are."
    mc "Não, eu estou bem... nós dois estamos."

# game/chapters/chapter6/ch6sc6.rpy:4761
translate brazil ch6sc6_fb1507c4:

#   ec "I shall pray to Gaia tonight and offer her my gratitude."
    ec "Esta noite, irei rezar a Gaia e oferecer-lhe a minha gratidão."

# game/chapters/chapter6/ch6sc6.rpy:4763
translate brazil ch6sc6_b252e733:

#   ec "Look at you... you’re a total mess."
    ec "Olha só para você... você está um caos total."

# game/chapters/chapter6/ch6sc6.rpy:4764
translate brazil ch6sc6_f126f6b7:

#   ec "Did my eyes deceive me, or did I just see you get swallowed whole by Jimun?"
    ec "Meus olhos me enganaram, ou eu vi você ser engolido inteiro pelo Jimun?"

# game/chapters/chapter6/ch6sc6.rpy:4766
translate brazil ch6sc6_0b146200:

#   ec "Even saying that out loud sounds ridiculous."
    ec "Até mesmo dizer isso em voz alta soa ridículo."

# game/chapters/chapter6/ch6sc6.rpy:4768
translate brazil ch6sc6_ab33e4d7:

#   mc "Your eyes didn't deceive you."
    mc "Seus olhos não o enganaram."

# game/chapters/chapter6/ch6sc6.rpy:4769
translate brazil ch6sc6_bd9e297c:

#   mc "But I suppose this settles the dispute about whether Jimun was made up or not."
    mc "Mas suponho que isso resolva a disputa sobre se Jimun foi inventado ou não."

# game/chapters/chapter6/ch6sc6.rpy:4771
translate brazil ch6sc6_91006a80:

#   ec "Incredible... and horrifying."
    ec "Incrível... e horripilante."

# game/chapters/chapter6/ch6sc6.rpy:4772
translate brazil ch6sc6_aa58aaf5:

#   ec "To think such a magnificent beast has been living amongst us all these years."
    ec "É incrível pensar que uma criatura tão magnífica viveu entre nós durante todos esses anos."

# game/chapters/chapter6/ch6sc6.rpy:4773
translate brazil ch6sc6_0825d480:

#   mc "I think this confirms what must have happened to your missing huntresses."
    mc "Acho que isso confirma o que deve ter acontecido com suas caçadoras desaparecidas."

# game/chapters/chapter6/ch6sc6.rpy:4774
translate brazil ch6sc6_2f3be482:

#   ec "I pray they did not suffer. They wouldn’t have stood a chance, none of us would have."
    ec "Rezo para que eles não tenham sofrido. Eles não teriam tido a menor chance, nenhum de nós teria."

# game/chapters/chapter6/ch6sc6.rpy:4776
translate brazil ch6sc6_cd4bb1b8:

#   ec "I saw how it repelled your attacks... it even overpowered you physically..."
    ec "Eu vi como repeliu seus ataques... chegou até a dominá-lo fisicamente..."

# game/chapters/chapter6/ch6sc6.rpy:4777
translate brazil ch6sc6_9cd2e08e:

#   ec "Even if we had faced it with all the huntresses of A’nai, we would’ve been nothing but an annoyance to such a beast."
    ec "Mesmo que tivéssemos enfrentado aquela criatura com todas as caçadoras de A'nai, não passaríamos de um incômodo para tal fera."

# game/chapters/chapter6/ch6sc6.rpy:4779
translate brazil ch6sc6_3a225a57:

#   ec "Uuff... you reek!"
    ec "Ufa... você está fedendo!"

# game/chapters/chapter6/ch6sc6.rpy:4780
translate brazil ch6sc6_12985a66:

#   ec "You need a bath, like yesterday!"
    ec "Você precisa de um banho, para ontem!"

# game/chapters/chapter6/ch6sc6.rpy:4781
translate brazil ch6sc6_665720a9:

#   mc "*Chuckles* What? You’re cutting our embrace short because of a little odor of blood and guts?"
    mc "*Risos* O quê? Você está interrompendo nosso abraço por causa de um leve cheiro de sangue e vísceras?"

# game/chapters/chapter6/ch6sc6.rpy:4782
translate brazil ch6sc6_b9ff0774:

#   ec "I most definitely am! *Giggles* You can have another embrace..."
    ec "Com certeza! *Risos* Pode me dar outro abraço..."

# game/chapters/chapter6/ch6sc6.rpy:4783
translate brazil ch6sc6_1a08332d:

#   ec "When you have washed. And thoroughly too!"
    ec "Depois de se lavar. E muito bem!"

# game/chapters/chapter6/ch6sc6.rpy:4785
translate brazil ch6sc6_2dfb67f2:

#   mc "Come here! You little..."
    mc "Venha cá! Seu pequeno..."

# game/chapters/chapter6/ch6sc6.rpy:4787
translate brazil ch6sc6_79f5d064:

#   ec "{b}*Squeals*{/b} Aiiyh! No! *Giggles* Get your stinky paws off me!"
    ec "{b}*Gritos de alegria*{/b} Aiiyh! Não! *Risos* Tire suas patas fedorentas de mim!"

# game/chapters/chapter6/ch6sc6.rpy:4789
translate brazil ch6sc6_86c3b9af:

#   pl "See, Taz? I told you. Easy peasy for [mc]."
    pl "Viu, Taz? Eu te disse. Moleza para você. [mc]."

# game/chapters/chapter6/ch6sc6.rpy:4790
translate brazil ch6sc6_5e82893c:

#   tz "Brilliant! Simply brilliant!"
    tz "Brilhante! Simplesmente brilhante!"

# game/chapters/chapter6/ch6sc6.rpy:4791
translate brazil ch6sc6_20b9430b:

#   pl "Nothing on this island can match him, nothing."
    pl "Nada nesta ilha se compara a ele, nada."

# game/chapters/chapter6/ch6sc6.rpy:4793
translate brazil ch6sc6_34575f97:

#   tz "*Mumbles* The hero used his cunning and intellect to defeat the mythological beast known as Jimun."
    tz "*Murmura* O herói usou sua astúcia e intelecto para derrotar a besta mitológica conhecida como Jimun."

# game/chapters/chapter6/ch6sc6.rpy:4794
translate brazil ch6sc6_eb9e1a4c:

#   tz "*Mumbles* He quickly adapted during the battle when he realized his brawn alone wouldn’t suffice."
    tz "*Resmunga* Ele se adaptou rapidamente durante a batalha quando percebeu que sua força bruta sozinha não seria suficiente."

# game/chapters/chapter6/ch6sc6.rpy:4795
translate brazil ch6sc6_558c4c84:

#   tz "*Mumbles* He severed the great serpent’s head from the inside, ensuring the safety of his companions."
    tz "*Murmura* Ele decepou a cabeça da grande serpente por dentro, garantindo a segurança de seus companheiros."

# game/chapters/chapter6/ch6sc6.rpy:4797
translate brazil ch6sc6_0c38a9a0:

#   pl "Tazzy, keep up!"
    pl "Tazzy, acompanha o ritmo!"

# game/chapters/chapter6/ch6sc6.rpy:4798
translate brazil ch6sc6_5f949538:

#   tz "Coming! Pearl! Don’t leave me alone out here!"
    tz "Já vou! Pérola! Não me deixe sozinha aqui fora!"

# game/chapters/chapter6/ch6sc6.rpy:4800
translate brazil ch6sc6_3a7415be:

#   mc "Hey girls."
    mc "Olá, meninas."

# game/chapters/chapter6/ch6sc6.rpy:4802
translate brazil ch6sc6_70120ebf:

#   pl "Nice work out there."
    pl "Bom trabalho!"

# game/chapters/chapter6/ch6sc6.rpy:4803
translate brazil ch6sc6_f19e6a97:

#   pl "We were debating whether to cheer for the big snakey, or you."
    pl "Estávamos debatendo se deveríamos torcer pela cobra gigante ou por você."

# game/chapters/chapter6/ch6sc6.rpy:4805
translate brazil ch6sc6_4f1c5b6a:

#   mc "*Chuckles* Is that so? I hope you placed your bets correctly, then."
    mc "*Risos* É mesmo? Espero que você tenha feito suas apostas corretamente, então."

# game/chapters/chapter6/ch6sc6.rpy:4807
translate brazil ch6sc6_01846a08:

#   pl "I did."
    pl "Eu fiz."

# game/chapters/chapter6/ch6sc6.rpy:4808
translate brazil ch6sc6_1c27c722:

#   pl "Little miss chronicler over here bet against me."
    pl "A pequena cronista aqui apostou contra mim."

# game/chapters/chapter6/ch6sc6.rpy:4810
translate brazil ch6sc6_fef9a1d8:

#   tz "P-Pearl! Don’t sell me out like that..."
    tz "P-Pearl! Não me venda assim..."

# game/chapters/chapter6/ch6sc6.rpy:4811
translate brazil ch6sc6_615929c3:

#   tz "All I said was that in most great heroic sagas, the hero suffers a defeat, even multiple defeats, before they rise again, stronger than before."
    tz "Tudo o que eu disse foi que, na maioria das grandes sagas heroicas, o herói sofre uma derrota, até mesmo múltiplas derrotas, antes de ressurgir, mais forte do que antes."

# game/chapters/chapter6/ch6sc6.rpy:4813
translate brazil ch6sc6_cbd45401:

#   pl "You stink, by the way. I think you need to spend a full week in the ocean."
    pl "Aliás, você está fedendo. Acho que você precisa passar uma semana inteira no oceano."

# game/chapters/chapter6/ch6sc6.rpy:4814
translate brazil ch6sc6_1526602a:

#   mc "You’re not the first to say so..."
    mc "Você não é o primeiro a dizer isso..."

# game/chapters/chapter6/ch6sc6.rpy:4816
translate brazil ch6sc6_ae1cece2:

#   pl "I’ll just be... somewhere over here. *Snickers*"
    pl "Vou ficar... em algum lugar por aqui. *Risos*"

# game/chapters/chapter6/ch6sc6.rpy:4817
translate brazil ch6sc6_9f838a68:

#   pl "I’m glad you’re okay, though... you had me worried for a second."
    pl "Que bom que você está bem... você me deixou preocupado por um instante."

# game/chapters/chapter6/ch6sc6.rpy:4821
translate brazil ch6sc6_93311e09:

#   pl "*Quietly* But then I remembered: if you died out there, you wouldn’t get to {b}fuck me{/b} later..."
    pl "*Em voz baixa* Mas então me lembrei: se você morresse lá fora, não teria a chance de... {b} foda-se{/b} mais tarde..."

# game/chapters/chapter6/ch6sc6.rpy:4822
translate brazil ch6sc6_f04ff062:

#   pl "So, I knew there was no way you would lose. *Giggles lightly*"
    pl "Então, eu sabia que não tinha como você perder. *Risinhos discretos*"

# game/chapters/chapter6/ch6sc6.rpy:4828
translate brazil ch6sc6_dcd0d9c0:

#   tz "*Mumbles* The Nephilim was covered in smelly guts and the dried blood of the great serpent, Jimun."
    tz "*Murmúrios* O Nefilim estava coberto de vísceras malcheirosas e sangue seco da grande serpente, Jimun."

# game/chapters/chapter6/ch6sc6.rpy:4829
translate brazil ch6sc6_f68a004b:

#   tz "*Mumbles* A hero’s work is seldom a clean task..."
    tz "*Resmunga* O trabalho de um herói raramente é uma tarefa fácil..."

# game/chapters/chapter6/ch6sc6.rpy:4830
translate brazil ch6sc6_5b762393:

#   tz "*Mumbles* All of his companions begged him to take a bath. I concurred with this: he was in dire need of it."
    tz "*Resmunga* Todos os seus companheiros imploraram para que ele tomasse um banho. Concordei: ele precisava desesperadamente disso."

# game/chapters/chapter6/ch6sc6.rpy:4832
translate brazil ch6sc6_2f29acf9:

#   mc "Taz ... you know I can hear you?"
    mc "Taz... você sabe que eu consigo te ouvir?"

# game/chapters/chapter6/ch6sc6.rpy:4833
translate brazil ch6sc6_9912eb1b:

#   "She glances at you and flashes a cheeky smile, before she continues her musings."
    "Ela lança um olhar rápido para você e esboça um sorriso travesso, antes de continuar com seus devaneios."

# game/chapters/chapter6/ch6sc6.rpy:4835
translate brazil ch6sc6_36428f0a:

#   tz "*Mumbles* I shared a longing look with the hero, his heart fluttered like a man in love."
    tz "*Murmúrios* Troquei um olhar de saudade com o herói, e o coração dele palpitou como o de um homem apaixonado."

# game/chapters/chapter6/ch6sc6.rpy:4837
translate brazil ch6sc6_65aa7f16:

#   mc "*Chuckles* Right... I’ll leave you to it."
    mc "*Risos* Certo... Vou deixar vocês com isso."

# game/chapters/chapter6/ch6sc6.rpy:4839
translate brazil ch6sc6_483f8891:

#   tz "[mc], like Pearl... I'm also happy you’re unscathed."
    tz "[mc] Assim como Pearl... também fico feliz que você tenha saído ileso."

# game/chapters/chapter6/ch6sc6.rpy:4840
translate brazil ch6sc6_0a74fb7e:

#   tz "Just... for the record."
    tz "Só para constar..."

# game/chapters/chapter6/ch6sc6.rpy:4842
translate brazil ch6sc6_851d650c:

#   mc "I appreciate it. Don’t worry... your ‘hero’ won’t leave you without a job any time soon."
    mc "Agradeço. Não se preocupe... seu 'herói' não vai te deixar sem emprego tão cedo."

# game/chapters/chapter6/ch6sc6.rpy:4844
translate brazil ch6sc6_c7a127a2:

#   tz "T-Thank you... I’m glad to hear it."
    tz "O-Obrigado... Fico feliz em ouvir isso."

# game/chapters/chapter6/ch6sc6.rpy:4846
translate brazil ch6sc6_9cc7a206:

#   tz "*Mumbles* The hero’s words brought me great comfort, but I longed for his embrace. If only he weren’t covered in guts."
    tz "*Murmúrios* As palavras do herói me trouxeram grande conforto, mas eu ansiava por seu abraço. Se ao menos ele não estivesse coberto de vísceras."

# game/chapters/chapter6/ch6sc6.rpy:4847
translate brazil ch6sc6_254f4209:

#   mc "*Chuckles* Yeah, yeah... let me know when you see a bath."
    mc "*Risos* É, é... me avisa quando você vir uma banheira."

# game/chapters/chapter6/ch6sc6.rpy:4849
translate brazil ch6sc6_e1344ba4:

#   tz "Trust me, you’ll be the first one I tell."
    tz "Acredite em mim, você será o primeiro a saber."

# game/chapters/chapter6/ch6sc6.rpy:4851
translate brazil ch6sc6_e74f0343:

#   vx "Ooh, ooh! Look! Starlight Roses!"
    vx "Oh, oh! Olha! Rosas da Luz das Estrelas!"

# game/chapters/chapter6/ch6sc6.rpy:4852
translate brazil ch6sc6_3a21d638:

#   ec "Good eyes, Vex. Gaia is smiling on you after you defeated her great serpent."
    ec "Bons olhos, Vex. Gaia está sorrindo para você depois que você derrotou sua grande serpente."

# game/chapters/chapter6/ch6sc6.rpy:4854
translate brazil ch6sc6_5c66c028:

#   vx "C’mon guys! This has to be the way to the temple!"
    vx "Vamos lá, pessoal! Este deve ser o caminho para o templo!"

# game/chapters/chapter6/ch6sc6.rpy:4856
translate brazil ch6sc6_c4d980b7:

#   ec "Vex! Wait up!"
    ec "Vex! Espere!"

# game/chapters/chapter6/ch6sc6.rpy:4857
translate brazil ch6sc6_829e638e:

#   ec "Haven’t you learned not to rush off like that?!"
    ec "Você ainda não aprendeu a não sair correndo assim?!"

# game/chapters/chapter6/ch6sc6.rpy:4859
translate brazil ch6sc6_79299e64:

#   ec "Everyone, follow Vex!"
    ec "Sigam Vex, pessoal!"

# game/chapters/chapter6/ch6sc6.rpy:4860
translate brazil ch6sc6_cade1fbd:

#   ec "Quickly now!"
    ec "Rápido!"

# game/chapters/chapter6/ch6sc6.rpy:4863
translate brazil ch6sc6_24c3b8e0:

#   "Your group follows the trail of Starlight Roses, until Vex eventually stops in her tracks with a wondrous expression."
    "Seu grupo segue o rastro das Rosas da Luz Estelar, até que Vex finalmente para, com uma expressão de admiração."

# game/chapters/chapter6/ch6sc6.rpy:4866
translate brazil ch6sc6_f54dae8a:

#   vx "By all the jungles..."
    vx "Por todas as selvas..."

# game/chapters/chapter6/ch6sc6.rpy:4867
translate brazil ch6sc6_77d1e197:

#   vx "It’s... beautiful."
    vx "É... lindo."

# game/chapters/chapter6/ch6sc6.rpy:4868
translate brazil ch6sc6_39426da5:

#   vx "I’ve never seen anything like it..."
    vx "Nunca vi nada igual..."

# game/chapters/chapter6/ch6sc6.rpy:4870
translate brazil ch6sc6_e1d2a79f:

#   vx "Did our ancestors really build this?"
    vx "Será que nossos ancestrais realmente construíram isso?"

# game/chapters/chapter6/ch6sc6.rpy:4871
translate brazil ch6sc6_6d7ee0df:

#   ec "They did... they were truly ahead of their time."
    ec "Sim, eles estavam... estavam realmente à frente de seu tempo."

# game/chapters/chapter6/ch6sc6.rpy:4872
translate brazil ch6sc6_4f7fa38e:

#   vx "This place was made to be worthy of the goddesses."
    vx "Este lugar foi feito para ser digno das deusas."

# game/chapters/chapter6/ch6sc6.rpy:4873
translate brazil ch6sc6_df856cfa:

#   vx "It seems the tales were true. We found the Starlight Roses and a temple reclaimed by the jungle."
    vx "Parece que as histórias eram verdadeiras. Encontramos as Rosas da Luz das Estrelas e um templo retomado pela selva."

# game/chapters/chapter6/ch6sc6.rpy:4875
translate brazil ch6sc6_1896ab28:

#   ks "This place is sacred ground! Outsiders must not be allowed to soil it!"
    ks "Este lugar é sagrado! Não se deve permitir que estranhos o profanem!"

# game/chapters/chapter6/ch6sc6.rpy:4876
translate brazil ch6sc6_bd4dc8cc:

#   ks "Allowing them to enter such a place is sure to upset the goddesses!"
    ks "Permitir que entrem em um lugar assim certamente desagradará as deusas!"

# game/chapters/chapter6/ch6sc6.rpy:4879
translate brazil ch6sc6_3ee76430:

#   ec "Kisha! You will cease this aggression at once!"
    ec "Kisha! Você vai parar com essa agressão imediatamente!"

# game/chapters/chapter6/ch6sc6.rpy:4880
translate brazil ch6sc6_996202de:

#   "Echo fixes her head-huntress with a stern look, clearly annoyed at her lack of faith in you."
    "Echo encara sua caçadora de cabeças com um olhar severo, claramente irritada com a falta de fé dela em você."

# game/chapters/chapter6/ch6sc6.rpy:4882
translate brazil ch6sc6_9b4815f3:

#   ks "Yes, A’nu... I did not mean to offend."
    ks "Sim, A'nu... Não tive a intenção de ofender."

# game/chapters/chapter6/ch6sc6.rpy:4883
translate brazil ch6sc6_f8824fc5:

#   ks "It's just that, our ancestors built this place and the others like it. And now outsiders are all over them."
    ks "É que nossos ancestrais construíram este lugar e outros semelhantes. E agora, forasteiros estão por toda parte."

# game/chapters/chapter6/ch6sc6.rpy:4885
translate brazil ch6sc6_e22459f9:

#   ec "The ancestors may have built these places, but we do not know what they would have wanted."
    ec "Os ancestrais podem ter construído esses lugares, mas não sabemos o que eles teriam desejado."

# game/chapters/chapter6/ch6sc6.rpy:4886
translate brazil ch6sc6_fd45c96c:

#   ec "It does not fall to us to decide who may, or may not, enter these grounds."
    ec "Não nos cabe decidir quem pode, ou não, entrar nestas instalações."

# game/chapters/chapter6/ch6sc6.rpy:4888
translate brazil ch6sc6_80eb9c6c:

#   ks "H-How so?"
    ks "H-Como assim?"

# game/chapters/chapter6/ch6sc6.rpy:4889
translate brazil ch6sc6_8f28614e:

#   ks "Shouldn’t it be up to us to decide?"
    ks "Não deveria ser nós a decidir?"

# game/chapters/chapter6/ch6sc6.rpy:4891
translate brazil ch6sc6_e2071214:

#   ec "No, it should not. We did not build these places, neither did our parents or grandparents."
    ec "Não, não deveria. Nós não construímos esses lugares, nem nossos pais ou avós."

# game/chapters/chapter6/ch6sc6.rpy:4892
translate brazil ch6sc6_8c0cf40e:

#   ec "They are centuries old... and we allowed them to become like this, abandoned."
    ec "Elas têm séculos de idade... e nós permitimos que chegassem a esse ponto, abandonadas."

# game/chapters/chapter6/ch6sc6.rpy:4894
translate brazil ch6sc6_4472dd03:

#   ks "A’nu, you know this is not true."
    ks "A'nu, você sabe que isso não é verdade."

# game/chapters/chapter6/ch6sc6.rpy:4896
translate brazil ch6sc6_f75569bd:

#   ec "Enlighten me."
    ec "Esclareça-me."

# game/chapters/chapter6/ch6sc6.rpy:4898
translate brazil ch6sc6_324a6804:

#   ks "Our connection to these places... it was taken from us, ripped out of our lives."
    ks "Nossa ligação com esses lugares... nos foi tirada, arrancada de nossas vidas."

# game/chapters/chapter6/ch6sc6.rpy:4899
translate brazil ch6sc6_f7a411f4:

#   ks "The outsiders... during the great desecration, they ruined everything... they stole our heritage."
    ks "Os forasteiros... durante a grande profanação, arruinaram tudo... roubaram nossa herança."

# game/chapters/chapter6/ch6sc6.rpy:4901
translate brazil ch6sc6_ab6f7de9:

#   ec "And yet, since that time... for two decades now, we have not bothered to rediscover these wonders."
    ec "E, no entanto, desde então... já faz duas décadas, não nos demos ao trabalho de redescobrir essas maravilhas."

# game/chapters/chapter6/ch6sc6.rpy:4902
translate brazil ch6sc6_d31dc305:

#   ec "We allowed these magnificent places to be reclaimed by the jungle and forgotten."
    ec "Deixamos que esses lugares magníficos fossem retomados pela selva e esquecidos."

# game/chapters/chapter6/ch6sc6.rpy:4903
translate brazil ch6sc6_748f3006:

#   ec "Only when [mc] and his friends joined us, have we found them again."
    ec "Somente quando [mc] E se os amigos dele se juntaram a nós, será que os encontramos novamente?"

# game/chapters/chapter6/ch6sc6.rpy:4905
translate brazil ch6sc6_0b7c0b3c:

#   ks "Hmm..."
    ks "Hum..."

# game/chapters/chapter6/ch6sc6.rpy:4906
translate brazil ch6sc6_3f849ef5:

#   ks "You are as stubborn as your mother, A’nu."
    ks "Você é tão teimosa quanto sua mãe, A'nu."

# game/chapters/chapter6/ch6sc6.rpy:4908
translate brazil ch6sc6_7ac41831:

#   sj "Head-huntress, you must be able to see that the A’nu makes a solid and reasonable point."
    sj "Caçadora de cabeças, você deve ser capaz de perceber que os A'nu têm um argumento sólido e razoável."

# game/chapters/chapter6/ch6sc6.rpy:4909
translate brazil ch6sc6_32839f30:

#   sj "The two of you are both leaders and important pillars of A’nai, you need to be on the same page."
    sj "Vocês dois são líderes e pilares importantes de A'nai, precisam estar em sintonia."

# game/chapters/chapter6/ch6sc6.rpy:4910
translate brazil ch6sc6_0b839b42:

#   sj "If you keep at each other's throats, it will only cause a divide amongst our people."
    sj "Se vocês continuarem se atacando mutuamente, isso só causará divisão entre o nosso povo."

# game/chapters/chapter6/ch6sc6.rpy:4912
translate brazil ch6sc6_a0616830:

#   ec "Suji is right, Kisha... bickering like this over the outsiders is exactly what Marah desires."
    ec "Suji tem razão, Kisha... essas discussões sobre os forasteiros são exatamente o que Marah deseja."

# game/chapters/chapter6/ch6sc6.rpy:4914
translate brazil ch6sc6_6d47dab1:

#   ks "Hrrrmmm..."
    ks "Hmmm..."

# game/chapters/chapter6/ch6sc6.rpy:4915
translate brazil ch6sc6_f9927643:

#   ks "Forgive me, A’nu... perhaps I’ve allowed Marah’s beliefs to cloud my judgment."
    ks "Perdoe-me, A'nu... talvez eu tenha deixado as crenças de Marah nublarem meu julgamento."

# game/chapters/chapter6/ch6sc6.rpy:4917
translate brazil ch6sc6_7ecb4935:

#   ks "I still do not entirely trust the intentions of the outsiders, but I shall attempt to remedy that."
    ks "Ainda não confio totalmente nas intenções dos forasteiros, mas tentarei remediar isso."

# game/chapters/chapter6/ch6sc6.rpy:4918
translate brazil ch6sc6_bf77e660:

#   ks "After all, the outsider... [mc], he did just defeat a great beast to protect one of our own."
    ks "Afinal, o forasteiro... [mc] Ele acabou de derrotar uma grande fera para proteger um dos nossos."

# game/chapters/chapter6/ch6sc6.rpy:4919
translate brazil ch6sc6_9eedad00:

#   ks "For now... I will leave events in the hands of the goddesses."
    ks "Por agora... deixarei os acontecimentos nas mãos das deusas."

# game/chapters/chapter6/ch6sc6.rpy:4921
translate brazil ch6sc6_06d78517:

#   ec "As it should be. Marah may be High-Priestess, but she does not speak for the goddesses."
    ec "Como deve ser. Marah pode ser a Alta Sacerdotisa, mas ela não fala em nome das deusas."

# game/chapters/chapter6/ch6sc6.rpy:4922
translate brazil ch6sc6_59b2a58d:

#   ec "That said, to show I’m willing to meet you halfway, only [mc] and Vex will enter the temple."
    ec "Dito isso, para mostrar que estou disposto a ceder um pouco, apenas [mc] E Vex entrará no templo."

# game/chapters/chapter6/ch6sc6.rpy:4924
translate brazil ch6sc6_93c83a40:

#   vx "Really?!"
    vx "Realmente?!"

# game/chapters/chapter6/ch6sc6.rpy:4925
translate brazil ch6sc6_15054431:

#   vx "I get to enter?! With [mc]?"
    vx "Eu posso participar?! Com [mc]?"

# game/chapters/chapter6/ch6sc6.rpy:4926
translate brazil ch6sc6_ba24263d:

#   vx "*Happily* {b}T-Together?{/b}"
    vx "*Felizmente* {b} T-Juntos?{/b}"

# game/chapters/chapter6/ch6sc6.rpy:4928
translate brazil ch6sc6_3d9d60da:

#   ec "Yes, the two of you will enter together. You've both earned it by taking down a beast like the Jimun."
    ec "Sim, vocês dois entrarão juntos. Ambos mereceram isso por terem derrotado uma fera como o Jimun."

# game/chapters/chapter6/ch6sc6.rpy:4929
translate brazil ch6sc6_c5d03a7c:

#   ec "[mc] is the champion of Gaia, and Malanthe. The goddesses are sure to be pleased by his presence in their temples."
    ec "[mc] Ele é o campeão de Gaia e Malanthe. As deusas certamente ficarão satisfeitas com sua presença em seus templos."

# game/chapters/chapter6/ch6sc6.rpy:4930
translate brazil ch6sc6_7dbb8937:

#   ec "The two of you can consider this your graduation reward for passing your hunter and huntress trials."
    ec "Vocês dois podem considerar isso como sua recompensa de formatura por terem passado nos testes de caçador e caçadora."

# game/chapters/chapter6/ch6sc6.rpy:4932
translate brazil ch6sc6_4b96dcf5:

#   tz "Only they get to enter the ancient temple? *Sighs* That’s disappointing."
    tz "Só eles podem entrar no templo antigo? *Suspiro* Que decepção."

# game/chapters/chapter6/ch6sc6.rpy:4933
translate brazil ch6sc6_518ffa97:

#   tz "But, I understand... it holds great meaning to your people."
    tz "Mas eu entendo... isso tem um grande significado para o seu povo."

# game/chapters/chapter6/ch6sc6.rpy:4935
translate brazil ch6sc6_bfedafd1:

#   tz "As newcomers, we shouldn't just waltz all over the place. We might accidentally damage your history."
    tz "Como recém-chegados, não devemos simplesmente sair por aí sem rumo. Podemos acabar danificando sua história sem querer."

# game/chapters/chapter6/ch6sc6.rpy:4936
translate brazil ch6sc6_c27be65c:

#   ks "*Nods approvingly* I like this one."
    ks "*Acena com a cabeça em aprovação* Eu gosto desse."

# game/chapters/chapter6/ch6sc6.rpy:4937
translate brazil ch6sc6_c1e990e8:

#   ec "That is correct."
    ec "Isso mesmo."

# game/chapters/chapter6/ch6sc6.rpy:4939
translate brazil ch6sc6_e8a03fd6:

#   ec "Thank you for respecting the grounds of our ancestors, Taz, and not pushing our boundaries."
    ec "Obrigado por respeitar o território dos nossos ancestrais, Taz, e por não ultrapassar os nossos limites."

# game/chapters/chapter6/ch6sc6.rpy:4940
translate brazil ch6sc6_b915bc8c:

#   ec "You make it easy for us to trust you."
    ec "Você nos permite confiar em você com facilidade."

# game/chapters/chapter6/ch6sc6.rpy:4942
translate brazil ch6sc6_d593e946:

#   vx "We still have one obstacle to overcome... before [mc] and I can enjoy our reward."
    vx "Ainda temos um obstáculo a superar... antes [mc] E eu posso desfrutar da nossa recompensa."

# game/chapters/chapter6/ch6sc6.rpy:4943
translate brazil ch6sc6_7f65df7f:

#   ec "What is it?"
    ec "O que é?"

# game/chapters/chapter6/ch6sc6.rpy:4945
translate brazil ch6sc6_0eb9a771:

#   vx "That."
    vx "Que."

# game/chapters/chapter6/ch6sc6.rpy:4946
translate brazil ch6sc6_aac5bdc6:

#   vx "What are we going to do about the entrance?"
    vx "O que vamos fazer em relação à entrada?"

# game/chapters/chapter6/ch6sc6.rpy:4948
translate brazil ch6sc6_8fd3343d:

#   ec "Ah, it appears to be walled off completely."
    ec "Ah, parece estar completamente murado."

# game/chapters/chapter6/ch6sc6.rpy:4949
translate brazil ch6sc6_58f19eab:

#   ec "Another mystery to be solved..."
    ec "Mais um mistério a ser resolvido..."

# game/chapters/chapter6/ch6sc6.rpy:4951
translate brazil ch6sc6_4b192870:

#   sj "I think I may know the answer to this mystery."
    sj "Acho que talvez eu saiba a resposta para esse mistério."

# game/chapters/chapter6/ch6sc6.rpy:4953
translate brazil ch6sc6_cf056541:

#   sj "[mc]."
    sj "[mc]."

# game/chapters/chapter6/ch6sc6.rpy:4955
translate brazil ch6sc6_9e6f11df:

#   mc "Me?"
    mc "Meu?"

# game/chapters/chapter6/ch6sc6.rpy:4957
translate brazil ch6sc6_0eb77be4:

#   sj "Remember when we arrived at the temple of Gaia?"
    sj "Lembra quando chegamos ao templo de Gaia?"

# game/chapters/chapter6/ch6sc6.rpy:4959
translate brazil ch6sc6_f53debb9:

#   mc "Right, now that you mention it..."
    mc "Certo, agora que você mencionou..."

# game/chapters/chapter6/ch6sc6.rpy:4961
translate brazil ch6sc6_fc887361:

#   sj "It was walled off too... but when you approached, the wisps from your talisman activated the wall for us."
    sj "Estava murado também... mas quando você se aproximou, os fragmentos do seu talismã ativaram a muralha para nós."

# game/chapters/chapter6/ch6sc6.rpy:4962
translate brazil ch6sc6_ca4d05f9:

#   sj "I believe you are the only one who can re-open this temple."
    sj "Acredito que você seja o único que pode reabrir este templo."

# game/chapters/chapter6/ch6sc6.rpy:4964
translate brazil ch6sc6_686079fd:

#   mc "Maybe. I guess it's worth a try."
    mc "Talvez. Acho que vale a pena tentar."

# game/chapters/chapter6/ch6sc6.rpy:4966
translate brazil ch6sc6_499dc4db:

#   sj "The wall itself is different, it does not have a sigil like the one at Gaia’s temple ..."
    sj "A própria parede é diferente, não possui um sigilo como o do templo de Gaia..."

# game/chapters/chapter6/ch6sc6.rpy:4968
translate brazil ch6sc6_10af31e6:

#   sj "But if you look next to it, there’s a smaller version of the shrine we encountered during our run-in with the mist."
    sj "Mas se você olhar ao lado, verá uma versão menor do santuário que encontramos durante nosso encontro com a névoa."

# game/chapters/chapter6/ch6sc6.rpy:4969
translate brazil ch6sc6_bef636d7:

#   pl "She’s right! It looks almost identical to the bigger version we encountered in the jungle."
    pl "Ela tem razão! Parece quase idêntico à versão maior que encontramos na selva."

# game/chapters/chapter6/ch6sc6.rpy:4970
translate brazil ch6sc6_160c554d:

#   mc "Good eye, Suji. Let’s see if I can activate it with the wisps."
    mc "Boa observação, Suji. Vamos ver se consigo ativá-lo com os fios de luz."

# game/chapters/chapter6/ch6sc6.rpy:4974
translate brazil ch6sc6_c245959b:

#   sj "*Quietly* {size=-10}{b}[mc], remember the other small temple we encountered after leaving Gaia’s main temple?{/b}{/size}"
    sj "*Em silêncio* {size=-10}{b}[mc]Você se lembra do outro pequeno templo que encontramos depois de sair do templo principal de Gaia?{/b}{/size}"

# game/chapters/chapter6/ch6sc6.rpy:4975
translate brazil ch6sc6_c464a969:

#   sj "*Quietly* {size=-10}{b}I believe this might be another such temple, it isn’t very far from Malanthe’s main temple.{/b}{/size}"
    sj "*Em silêncio* {size=-10}{b}Acredito que este possa ser outro templo desse tipo, não fica muito longe do templo principal de Malanthe.{/b}{/size}"

# game/chapters/chapter6/ch6sc6.rpy:4977
translate brazil ch6sc6_2bd48bc7:

#   sj "*Quietly* {size=-10}{b}If it is, you will likely encounter a rejuvenating bath in there as well.{/b}{/size}"
    sj "*Em silêncio* {size=-10}{b}Se for esse o caso, provavelmente encontrará também um banho revigorante por lá.{/b}{/size}"

# game/chapters/chapter6/ch6sc6.rpy:4978
translate brazil ch6sc6_c1ed4730:

#   sj "*Quietly* {size=-10}{b}What I’m trying to say is... clean yourself properly. I do not wish the stench of Jimun’s blood-{/b}{/size}"
    sj "*Em silêncio* {size=-10}{b}O que estou tentando dizer é... limpe-se adequadamente. Não quero que o cheiro do sangue de Jimun...{/b}{/size}"

# game/chapters/chapter6/ch6sc6.rpy:4979
translate brazil ch6sc6_60ba5491:

#   sj "*Quietly* {size=-10}{b}To lessen the experience of our mating tonight.{/b}{/size}"
    sj "*Em silêncio* {size=-10}{b}Para amenizar a experiência do nosso acasalamento esta noite.{/b}{/size}"

# game/chapters/chapter6/ch6sc6.rpy:4981
translate brazil ch6sc6_667d5fd6:

#   mc "Did watching me take down Jimun and becoming a full-fledged Hunter of A’nai awaken your desires, huntress?"
    mc "Ver-me derrotar Jimun e tornar-me uma Caçadora de A'nai despertou seus desejos, caçadora?"

# game/chapters/chapter6/ch6sc6.rpy:4983
translate brazil ch6sc6_57de8a3b:

#   sj "*Quietly* {size=-10}{b}You know it has... tonight I will claim your seed.{/b}{/size}"
    sj "*Em silêncio* {size=-10}{b}Você sabe que sim... esta noite eu vou reivindicar sua semente.{/b}{/size}"

# game/chapters/chapter6/ch6sc6.rpy:4986
translate brazil ch6sc6_01037b9f:

#   sj "*Quietly* {size=-10}{b}I need to feel you inside me, I crave feeling your strength.{/b}{/size}"
    sj "*Em silêncio* {size=-10}{b}Preciso sentir você dentro de mim, anseio por sentir sua força.{/b}{/size}"

# game/chapters/chapter6/ch6sc6.rpy:4988
translate brazil ch6sc6_b21c49a7:

#   "Suji is severely turned on by your display of strength against Jimun, her trust has increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Suji ficou extremamente excitada com sua demonstração de força contra Jimun, e sua confiança aumentou consideravelmente. {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc6.rpy:4993
translate brazil ch6sc6_fe277e8d:

#   mc "You sure know how to make a man excited for what’s to come. I’ll see if there’s a bath inside."
    mc "Você sabe muito bem como deixar um homem ansioso pelo que está por vir. Vou ver se tem banheira lá dentro."

# game/chapters/chapter6/ch6sc6.rpy:4994
translate brazil ch6sc6_e6237e68:

#   sj "*Nods* Mmh."
    sj "*Acena com a cabeça* Hum."

# game/chapters/chapter6/ch6sc6.rpy:5003
translate brazil ch6sc6_b680d532:

#   mc "Let’s see..."
    mc "Vamos ver..."

# game/chapters/chapter6/ch6sc6.rpy:5006
translate brazil ch6sc6_f5024dd4:

#   mc "I think Suji is on to something. The talisman is vibrating faster as I get closer."
    mc "Acho que Suji descobriu algo. O talismã está vibrando mais rápido à medida que me aproximo."

# game/chapters/chapter6/ch6sc6.rpy:5007
translate brazil ch6sc6_985130db:

#   sj "I knew it!"
    sj "Eu sabia!"

# game/chapters/chapter6/ch6sc6.rpy:5009
translate brazil ch6sc6_16b753d1:

#   mct "{i}Okay, let’s see if you guys can activate this thing.{/i}"
    mct "{i}Ok, vamos ver se vocês conseguem ativar isso.{/i}"

# game/chapters/chapter6/ch6sc6.rpy:5011
translate brazil ch6sc6_dd643e19:

#   mc "{i}*Tongue of the Ancients* Hsu, uhr, riveh, wisptuh, ahkoh.{/i}"
    mc "{i}*Língua dos Antigos* Hsu, uhr, riveh, wisptuh, ahkoh.{/i}"

# game/chapters/chapter6/ch6sc6.rpy:5012
translate brazil ch6sc6_524eed72:

#   tz "Brilliant! Echo, what’s he saying?"
    tz "Genial! Echo, o que ele está dizendo?"

# game/chapters/chapter6/ch6sc6.rpy:5013
translate brazil ch6sc6_2cbd69d3:

#   ec "I... I do not know."
    ec "Eu... eu não sei."

# game/chapters/chapter6/ch6sc6.rpy:5014
translate brazil ch6sc6_2e329bc6:

#   ec "He is speaking the tongue of our ancestors."
    ec "Ele está falando a língua de nossos ancestrais."

# game/chapters/chapter6/ch6sc6.rpy:5016
translate brazil ch6sc6_4f45d320:

#   ks "Words... escape me."
    ks "As palavras... me escapam."

# game/chapters/chapter6/ch6sc6.rpy:5017
translate brazil ch6sc6_3b9e7db6:

#   ks "I cannot believe what I am seeing."
    ks "Não consigo acreditar no que estou vendo."

# game/chapters/chapter6/ch6sc6.rpy:5018
translate brazil ch6sc6_5cb0bc0e:

#   sj "I couldn’t at first either... [mc] truly is a wonder."
    sj "No início, eu também não conseguia... [mc] É realmente uma maravilha."

# game/chapters/chapter6/ch6sc6.rpy:5020
translate brazil ch6sc6_a6699074:

#   mc "*Tongue of the Ancients* Ih, kah, ritoh, revelio."
    mc "*Língua dos Antigos* Ih, kah, ritoh, revelio."

# game/chapters/chapter6/ch6sc6.rpy:5021
translate brazil ch6sc6_513862e1:

#   tz "He did it! Go, Hero!"
    tz "Ele conseguiu! Vai, herói!"

# game/chapters/chapter6/ch6sc6.rpy:5022
translate brazil ch6sc6_3db80163:

#   sj "I knew he would. He is a great champion."
    sj "Eu sabia que ele faria isso. Ele é um grande campeão."

# game/chapters/chapter6/ch6sc6.rpy:5024
translate brazil ch6sc6_43e352ad:

#   mc "Vex, come join me. It’s about to open."
    mc "Vex, venha se juntar a mim. Está prestes a abrir."

# game/chapters/chapter6/ch6sc6.rpy:5026
translate brazil ch6sc6_3912ef17:

#   vx "Coming!"
    vx "Chegando!"

# game/chapters/chapter6/ch6sc6.rpy:5028
translate brazil ch6sc6_54bbc8c2:

#   ec "Vex, I don’t expect anything dangerous inside- it’s not supposed to be a temple with trials."
    ec "Vex, não espero nada perigoso lá dentro - não é para ser um templo com provações."

# game/chapters/chapter6/ch6sc6.rpy:5029
translate brazil ch6sc6_c7aefc17:

#   ec "But we do not know for certain."
    ec "Mas não sabemos ao certo."

# game/chapters/chapter6/ch6sc6.rpy:5030
translate brazil ch6sc6_68ca9c13:

#   ec "So... stay alert and protect [mc], as he will do for you."
    ec "Então... fique alerta e proteja-se [mc], assim como ele fará por você."

# game/chapters/chapter6/ch6sc6.rpy:5032
translate brazil ch6sc6_10079e89:

#   vx "Don’t worry, A’nu."
    vx "Não se preocupe, A'nu."

# game/chapters/chapter6/ch6sc6.rpy:5033
translate brazil ch6sc6_57f619cb:

#   vx "I have no intention of taking my eyes off him."
    vx "Não tenho a menor intenção de desviar o olhar dele."

# game/chapters/chapter6/ch6sc6.rpy:5034
translate brazil ch6sc6_1b7a9959:

#   vx "[mc], wait up!"
    vx "[mc] Espere aí!"

# game/chapters/chapter6/ch6sc6.rpy:5036
translate brazil ch6sc6_d3c185ca:

#   vx "Don’t you dare enter without me!"
    vx "Não se atreva a entrar sem mim!"

# game/chapters/chapter6/ch6sc6.rpy:5037
translate brazil ch6sc6_4273e8a8:

#   vx "This is my reward too!"
    vx "Essa também é a minha recompensa!"

# game/chapters/chapter6/ch6sc6.rpy:5039
translate brazil ch6sc6_5d38f820:

#   mc "C’mon then, move those skinny little legs of yours."
    mc "Vamos lá, mexa essas suas perninhas magricelas."

# game/chapters/chapter6/ch6sc6.rpy:5040
translate brazil ch6sc6_a6d75055:

#   vx "T-Take that back! My legs are juicy! Y-You have skinny legs!"
    vx "Retire o que disse! Minhas pernas são suculentas! Você tem pernas finas!"

# game/chapters/chapter6/ch6sc6.rpy:5042
translate brazil ch6sc6_0da05580:

#   vx "Did I... did I make it?"
    vx "Será que... será que eu consegui?"

# game/chapters/chapter6/ch6sc6.rpy:5043
translate brazil ch6sc6_9106bf70:

#   mc "*Chuckles* Yes, little one... you made it."
    mc "*Risos* Sim, meu bem... você conseguiu."

# game/chapters/chapter6/ch6sc6.rpy:5044
translate brazil ch6sc6_112ffb5b:

#   vx "Right... the wall is still up! *Giggles*"
    vx "Certo... o muro ainda está de pé! *Risos*"

# game/chapters/chapter6/ch6sc6.rpy:5047
translate brazil ch6sc6_291f9b4e:

#   vx "*Gasps* Do you feel that?!"
    vx "*Suspiros* Você sente isso?!"

# game/chapters/chapter6/ch6sc6.rpy:5048
translate brazil ch6sc6_cf2519db:

#   mc "Mhm, it’s opening. An old stone wall like this must be very heavy, it will cause some rumbling when it moves."
    mc "Hum, está abrindo. Uma parede de pedra antiga como essa deve ser muito pesada, vai causar um certo estrondo quando se mover."

# game/chapters/chapter6/ch6sc6.rpy:5049
translate brazil ch6sc6_e6f8d5b8:

#   vx "M-Moving?! How is such a thing possible?"
    vx "M-Moving?! Como isso é possível?"

# game/chapters/chapter6/ch6sc6.rpy:5050
translate brazil ch6sc6_a47cf66a:

#   mc "Enchantments. Your ancestors built enchantments into them."
    mc "Encantamentos. Seus ancestrais incorporaram encantamentos neles."

# game/chapters/chapter6/ch6sc6.rpy:5051
translate brazil ch6sc6_88388dcf:

#   mc "It’s incredibly rare to see such advanced building techniques."
    mc "É extremamente raro ver técnicas de construção tão avançadas."

# game/chapters/chapter6/ch6sc6.rpy:5053
translate brazil ch6sc6_c3b39a80:

#   vx "This is exciting! *Giggles* I’m glad we earned this!"
    vx "Que emocionante! *Risos* Fico feliz que tenhamos conquistado isso!"

# game/chapters/chapter6/ch6sc6.rpy:5054
translate brazil ch6sc6_77487ddb:

#   vx "Incredible..."
    vx "Incrível..."

# game/chapters/chapter6/ch6sc6.rpy:5055
translate brazil ch6sc6_8d3a24b1:

#   mc "They always are..."
    mc "Eles sempre são..."

# game/chapters/chapter6/ch6sc6.rpy:5057
translate brazil ch6sc6_537ad9c5:

#   mc "Let’s see what it has in store for us."
    mc "Vamos ver o que nos reserva o futuro."

# game/chapters/chapter6/ch6sc6.rpy:5058
translate brazil ch6sc6_88b5bfdf:

#   vx "Ooh, it smells nice here! Like wildflowers freshly gathered from the jungle."
    vx "Nossa, que cheiro bom! Parece o de flores silvestres recém-colhidas na selva."

# game/chapters/chapter6/ch6sc6.rpy:5060
translate brazil ch6sc6_30eb3d91:

#   tz "*Gasps* It’s closing?! How are they going to get out?"
    tz "*Suspiros* Está fechando?! Como eles vão sair daqui?"

# game/chapters/chapter6/ch6sc6.rpy:5061
translate brazil ch6sc6_28cba4f1:

#   ec "I’m sure it can be opened from within. It's probably to give whoever enters within some privacy."
    ec "Tenho certeza de que pode ser aberto por dentro. Provavelmente é para dar alguma privacidade a quem entra."

# game/chapters/chapter6/ch6sc6.rpy:5063
translate brazil ch6sc6_cd7162e5:

#   tz "Why would they need privacy?"
    tz "Por que eles precisariam de privacidade?"

# game/chapters/chapter6/ch6sc6.rpy:5064
translate brazil ch6sc6_a68535ec:

#   sj "It’s a secondary temple to the goddess Malanthe, the goddess of desire... lust... passion."
    sj "É um templo secundário dedicado à deusa Malanthe, a deusa do desejo... da luxúria... da paixão."

# game/chapters/chapter6/ch6sc6.rpy:5065
translate brazil ch6sc6_a1483f60:

#   sj "It is likely intended for... mating in her honor."
    sj "Provavelmente se destina a... acasalamento em sua homenagem."

# game/chapters/chapter6/ch6sc6.rpy:5066
translate brazil ch6sc6_1f701e48:

#   tz "*Gasps* Oh! Oh, my..."
    tz "*Suspiros* Oh! Oh, meu Deus..."

# game/chapters/chapter6/ch6sc6.rpy:5074
translate brazil ch6sc6_7c533b48:

#   vx "The wall behind us... it closed!"
    vx "A parede atrás de nós... ela se fechou!"

# game/chapters/chapter6/ch6sc6.rpy:5075
translate brazil ch6sc6_d4695d4f:

#   mc "Don’t worry, my wisps will let us out whenever we’re ready. I just have to approach the wall again."
    mc "Não se preocupe, meus espíritos nos libertarão quando estivermos prontos. Só preciso me aproximar da parede novamente."

# game/chapters/chapter6/ch6sc6.rpy:5077
translate brazil ch6sc6_f696b882:

#   vx "I am not quite sure how to process all I’ve seen you do over the past day..."
    vx "Não sei bem como processar tudo o que vi você fazer no último dia..."

# game/chapters/chapter6/ch6sc6.rpy:5078
translate brazil ch6sc6_b494fc99:

#   vx "You must be a reincarnation of our ancestors... how else could you manage all this?"
    vx "Você deve ser a reencarnação de nossos ancestrais... de que outra forma você conseguiria fazer tudo isso?"

# game/chapters/chapter6/ch6sc6.rpy:5080
translate brazil ch6sc6_85d74394:

#   mc "I hate to disappoint you, little one... but I doubt I have any ties to your ancestors."
    mc "Sinto muito em te desapontar, meu bem... mas duvido que eu tenha qualquer ligação com seus ancestrais."

# game/chapters/chapter6/ch6sc6.rpy:5082
translate brazil ch6sc6_30e91d3c:

#   vx "Whether you do, or you don’t, one thing is certain..."
    vx "Quer você faça isso ou não, uma coisa é certa..."

# game/chapters/chapter6/ch6sc6.rpy:5083
translate brazil ch6sc6_0ad0a27c:

#   vx "You’re incredible, heroic, strong, brave, reckless, bold, and handsome. A man the likes of which we’ve never seen in A’nai before."
    vx "Você é incrível, heróico, forte, corajoso, destemido, audacioso e bonito. Um homem como nunca vimos em A'nai antes."

# game/chapters/chapter6/ch6sc6.rpy:5085
translate brazil ch6sc6_dd682bdd:

#   mc "Did you just call me handsome, Vex?"
    mc "Você acabou de me chamar de bonito, Vex?"

# game/chapters/chapter6/ch6sc6.rpy:5087
translate brazil ch6sc6_9e6c5946:

#   vx "That’s what stood out to you? *Scoffs lightly* Figures..."
    vx "Foi isso que te chamou a atenção? *Risos discretos* Faz sentido..."

# game/chapters/chapter6/ch6sc6.rpy:5088
translate brazil ch6sc6_231e424b:

#   vx "Yes, you are very attractive... amongst other things."
    vx "Sim, você é muito atraente... entre outras coisas."

# game/chapters/chapter6/ch6sc6.rpy:5090
translate brazil ch6sc6_26c7b0d3:

#   vx "Now, let’s look around before your head gets any bigger."
    vx "Agora, vamos dar uma olhada ao redor antes que sua cabeça fique ainda maior."

# game/chapters/chapter6/ch6sc6.rpy:5092
translate brazil ch6sc6_3be87993:

#   mc "*Chuckles* I could get used to you throwing compliments my way."
    mc "*Risos* Eu poderia me acostumar com você me fazendo elogios."

# game/chapters/chapter6/ch6sc6.rpy:5093
translate brazil ch6sc6_b2b6b340:

#   vx "*Snickers* As if!"
    vx "*Risos* Como se fosse possível!"

# game/chapters/chapter6/ch6sc6.rpy:5094
translate brazil ch6sc6_7d96d1dc:

#   vx "That was merely a residual compliment out of gratitude for you saving me..."
    vx "Isso foi apenas um elogio residual em agradecimento por você ter me salvado..."

# game/chapters/chapter6/ch6sc6.rpy:5096
translate brazil ch6sc6_2ac0f09c:

#   vx "Stay close, okay? I promised Echo I would protect you."
    vx "Fique perto, tá bom? Eu prometi à Echo que ia te proteger."

# game/chapters/chapter6/ch6sc6.rpy:5097
translate brazil ch6sc6_344cb241:

#   mc "*Chuckles* Sure."
    mc "*Risos* Claro."

# game/chapters/chapter6/ch6sc6.rpy:5098
translate brazil ch6sc6_ceea83e7:

#   "The two of you begin exploring the interior, each new discovery sending Vex into excited awe."
    "Vocês dois começam a explorar o interior, e cada nova descoberta deixa Vex maravilhado e entusiasmado."

# game/chapters/chapter6/ch6sc6.rpy:5100
translate brazil ch6sc6_6d657145:

#   vx "There's a similar statue back in A’nai..."
    vx "Existe uma estátua semelhante em A'nai..."

# game/chapters/chapter6/ch6sc6.rpy:5101
translate brazil ch6sc6_c3f5072c:

#   vx "The priestesses often pray at it, hoping that the goddesses will hear them again."
    vx "As sacerdotisas costumam rezar ali, na esperança de que as deusas as ouçam novamente."

# game/chapters/chapter6/ch6sc6.rpy:5103
translate brazil ch6sc6_fe87074b:

#   vx "*Gasps* Look at this one! It’s huge!"
    vx "*Suspiros* Olha só isso! É enorme!"

# game/chapters/chapter6/ch6sc6.rpy:5104
translate brazil ch6sc6_2b09d92d:

#   vx "I wonder how our ancestors could build it?"
    vx "Fico pensando em como nossos ancestrais conseguiram construí-lo?"

# game/chapters/chapter6/ch6sc6.rpy:5106
translate brazil ch6sc6_3d7e2602:

#   vx "What is this place?"
    vx "Que lugar é este?"

# game/chapters/chapter6/ch6sc6.rpy:5107
translate brazil ch6sc6_e659a0d9:

#   vx "It would have taken a lot of effort to build it. It must have been important."
    vx "Construí-lo teria exigido muito esforço. Devia ser algo importante."

# game/chapters/chapter6/ch6sc6.rpy:5109
translate brazil ch6sc6_a931c48d:

#   mc "I have a feeling the others were right."
    mc "Tenho a impressão de que os outros estavam certos."

# game/chapters/chapter6/ch6sc6.rpy:5110
translate brazil ch6sc6_da2b86fa:

#   mc "This is a secondary temple of Malanthe. Judging by the color of the light... and the atmosphere in here."
    mc "Este é um templo secundário de Malanthe. A julgar pela cor da luz... e pela atmosfera aqui dentro."

# game/chapters/chapter6/ch6sc6.rpy:5111
translate brazil ch6sc6_34cc72d7:

#   mc "If that’s the case, the purpose of this temple is likely to -"
    mc "Se for esse o caso, o propósito deste templo provavelmente será -"

# game/chapters/chapter6/ch6sc6.rpy:5113
translate brazil ch6sc6_598b4695:

#   vx "Ooh! What is this?!"
    vx "Ooh! O que é isso?!"

# game/chapters/chapter6/ch6sc6.rpy:5114
translate brazil ch6sc6_416b7e5e:

#   mc "Don’t stray off too far, okay?"
    mc "Não se afaste muito, ok?"

# game/chapters/chapter6/ch6sc6.rpy:5116
translate brazil ch6sc6_0726e270:

#   vx "*Gasps* Woah..."
    vx "*Suspira* Uau..."

# game/chapters/chapter6/ch6sc6.rpy:5117
translate brazil ch6sc6_2838cce4:

#   vx "It’s so... red..."
    vx "É tão... vermelho..."

# game/chapters/chapter6/ch6sc6.rpy:5118
translate brazil ch6sc6_b3835c0f:

#   vx "I’ve never seen red... water..."
    vx "Eu nunca vi água vermelha..."

# game/chapters/chapter6/ch6sc6.rpy:5120
translate brazil ch6sc6_eb324093:

#   vx "It’s so... pretty."
    vx "É tão... bonito."

# game/chapters/chapter6/ch6sc6.rpy:5121
translate brazil ch6sc6_9b4292b3:

#   vx "It has a refreshing aura..."
    vx "Tem uma aura revigorante..."

# game/chapters/chapter6/ch6sc6.rpy:5122
translate brazil ch6sc6_dd27e6cf:

#   vx "No. Invigorating."
    vx "Não. Revigorante."

# game/chapters/chapter6/ch6sc6.rpy:5124
translate brazil ch6sc6_b9a22849:

#   vx "I wonder if..."
    vx "Será que...?"

# game/chapters/chapter6/ch6sc6.rpy:5125
translate brazil ch6sc6_064b458c:

#   vx "Would Malanthe be angry with me if I...?"
    vx "Malanthe ficaria zangada comigo se eu...?"

# game/chapters/chapter6/ch6sc6.rpy:5127
translate brazil ch6sc6_4c042747:

#   vx "Just... for a moment..."
    vx "Só... por um instante..."

# game/chapters/chapter6/ch6sc6.rpy:5134
translate brazil ch6sc6_a2b4b247:

#   vx "*Squeals* {b}AHH!{/b}"
    vx "*Gritos de alegria* {b} AHH!{/b}"

# game/chapters/chapter6/ch6sc6.rpy:5135
translate brazil ch6sc6_bb770123:

#   mc "Vex?!"
    mc "Vex?!"

# game/chapters/chapter6/ch6sc6.rpy:5137
translate brazil ch6sc6_dde12e25:

#   mc "Vex? What is it? Are you okay?"
    mc "Vex? O que foi? Você está bem?"

# game/chapters/chapter6/ch6sc6.rpy:5138
translate brazil ch6sc6_325e9c2f:

#   vx "I’m- I’m fine, the water..."
    vx "Eu estou bem, a água..."

# game/chapters/chapter6/ch6sc6.rpy:5139
translate brazil ch6sc6_46543369:

#   vx "It moved!"
    vx "Mexeu-se!"

# game/chapters/chapter6/ch6sc6.rpy:5141
translate brazil ch6sc6_05500ff6:

#   mc "Huh?"
    mc "Huh?"

# game/chapters/chapter6/ch6sc6.rpy:5142
translate brazil ch6sc6_d323dfb0:

#   mc "What do you mean the water moved? Is there something in it?"
    mc "O que você quer dizer com a água se movendo? Tem alguma coisa nela?"

# game/chapters/chapter6/ch6sc6.rpy:5143
translate brazil ch6sc6_74d0dd1f:

#   vx "N-No, I do not think so... the water is quite clear."
    vx "N-Não, não acho... a água está bem limpa."

# game/chapters/chapter6/ch6sc6.rpy:5145
translate brazil ch6sc6_7876730d:

#   vx "It feels strangely invigorating to be so close to it, so I..."
    vx "É estranhamente revigorante estar tão perto disso, então eu..."

# game/chapters/chapter6/ch6sc6.rpy:5146
translate brazil ch6sc6_bee165df:

#   vx "I thought it would be okay to touch it."
    vx "Achei que não haveria problema em tocá-lo."

# game/chapters/chapter6/ch6sc6.rpy:5148
translate brazil ch6sc6_67dbe43c:

#   vx "And then it moved!"
    vx "E então se mexeu!"

# game/chapters/chapter6/ch6sc6.rpy:5149
translate brazil ch6sc6_25e226fd:

#   vx "Are you... angry with me?"
    vx "Você está com raiva de mim?"

# game/chapters/chapter6/ch6sc6.rpy:5151
translate brazil ch6sc6_e72c1325:

#   mc "Hey... little one, I’m not angry with you, okay?"
    mc "Ei... pequenino(a), eu não estou bravo(a) com você, tá bom?"

# game/chapters/chapter6/ch6sc6.rpy:5153
translate brazil ch6sc6_62db4f8a:

#   "Vex doesn’t speak, instead she nods gently into your palm."
    "Vex não fala, em vez disso, ela acena suavemente com a cabeça em direção à sua palma."

# game/chapters/chapter6/ch6sc6.rpy:5161
translate brazil ch6sc6_336cc357:

#   vx "Mh-hm."
    vx "Hum-hum."

# game/chapters/chapter6/ch6sc6.rpy:5163
translate brazil ch6sc6_f1043b23:

#   mc "Now, can you try explaining what happened again? This water has me curious."
    mc "Agora, você pode tentar explicar o que aconteceu novamente? Essa água me deixou curioso."

# game/chapters/chapter6/ch6sc6.rpy:5165
translate brazil ch6sc6_d2e612d4:

#   vx "Yes, I’ll try!"
    vx "Sim, vou tentar!"

# game/chapters/chapter6/ch6sc6.rpy:5167
translate brazil ch6sc6_373759fa:

#   vx "I was curious about the water, that red color drew me to it..."
    vx "Eu estava curioso sobre a água, aquela cor vermelha me atraiu..."

# game/chapters/chapter6/ch6sc6.rpy:5168
translate brazil ch6sc6_f36d604f:

#   vx "I felt a refreshing and soothing presence as I got closer to it."
    vx "Ao me aproximar, senti uma presença refrescante e reconfortante."

# game/chapters/chapter6/ch6sc6.rpy:5170
translate brazil ch6sc6_cd36082a:

#   vx "And then- then I remembered how dirty you are. How much you need a bath..."
    vx "E então... então eu me lembrei de como você está sujo. De como você precisa de um banho..."

# game/chapters/chapter6/ch6sc6.rpy:5171
translate brazil ch6sc6_2889612d:

#   vx "So I wanted to feel if it would be alright for you to bathe in."
    vx "Então, eu queria saber se você se importaria de tomar banho com essa água."

# game/chapters/chapter6/ch6sc6.rpy:5172
translate brazil ch6sc6_56646d49:

#   mc "You wanted to check if the water was safe for me?"
    mc "Você queria verificar se a água era segura para mim?"

# game/chapters/chapter6/ch6sc6.rpy:5174
translate brazil ch6sc6_bbaffedd:

#   vx "Y-Yes... A’nu asked me to protect you... and I will."
    vx "S-Sim... A'nu me pediu para te proteger... e eu vou."

# game/chapters/chapter6/ch6sc6.rpy:5175
translate brazil ch6sc6_e1f737d0:

#   vx "But also, you saved my life..."
    vx "Mas você também salvou minha vida..."

# game/chapters/chapter6/ch6sc6.rpy:5177
translate brazil ch6sc6_a2a793bd:

#   vx "So, I already wished to protect you."
    vx "Então, eu já desejava te proteger."

# game/chapters/chapter6/ch6sc6.rpy:5179
translate brazil ch6sc6_055fa7ae:

#   mc "*Chuckles* Thank you, little one... you’re cute."
    mc "*Risos* Obrigada, pequenina... você é fofa."

# game/chapters/chapter6/ch6sc6.rpy:5180
translate brazil ch6sc6_553cae7b:

#   vx "Mmmh..."
    vx "Hum..."

# game/chapters/chapter6/ch6sc6.rpy:5182
translate brazil ch6sc6_1ef7a8ef:

#   vx "Just... cute?"
    vx "Simplesmente... fofo?"

# game/chapters/chapter6/ch6sc6.rpy:5187
translate brazil ch6sc6_c6f8dbfc:

#   mc "No, you aren’t just cute..."
    mc "Não, você não é apenas fofo(a)..."

# game/chapters/chapter6/ch6sc6.rpy:5188
translate brazil ch6sc6_5556a26b:

#   mc "You’re incredibly beautiful, as well."
    mc "Você também é incrivelmente linda."

# game/chapters/chapter6/ch6sc6.rpy:5189
translate brazil ch6sc6_b9fac298:

#   "Vex’s arms rest heavily on yours, as if she is trying to signal she wants to be closer to you."
    "Os braços de Vex repousam pesadamente sobre os seus, como se ela estivesse tentando sinalizar que quer ficar mais perto de você."

# game/chapters/chapter6/ch6sc6.rpy:5191
translate brazil ch6sc6_32a14adf:

#   vx "[mc]... thank you."
    vx "[mc]... obrigado."

# game/chapters/chapter6/ch6sc6.rpy:5194
translate brazil ch6sc6_1bf3c14f:

#   vx "It pleases me to know that you find me attractive."
    vx "Fico feliz em saber que você me acha atraente."

# game/chapters/chapter6/ch6sc6.rpy:5195
translate brazil ch6sc6_956e3b3f:

#   "Vex is happy to be connecting with you. Vex’s trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "A Vex está feliz em se conectar com você. A confiança da Vex aumentou em {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc6.rpy:5199
translate brazil ch6sc6_31a8e758:

#   mc "And sweet, it was kind of you to check the water for me."
    mc "E que gentileza sua ter verificado a água para mim."

# game/chapters/chapter6/ch6sc6.rpy:5201
translate brazil ch6sc6_1eadd661:

#   vx "You’re welcome!"
    vx "De nada!"

# game/chapters/chapter6/ch6sc6.rpy:5204
translate brazil ch6sc6_a29ce15f:

#   mc "Now, how did the water move if nothing is in it?"
    mc "Ora, como é que a água se moveu se não havia nada nela?"

# game/chapters/chapter6/ch6sc6.rpy:5205
translate brazil ch6sc6_fcf8d7e6:

#   mc "Could you show me? I won’t let anything happen to you."
    mc "Você poderia me mostrar? Não vou deixar que nada lhe aconteça."

# game/chapters/chapter6/ch6sc6.rpy:5207
translate brazil ch6sc6_d6e63dbb:

#   vx "Yes... I’ll be happy to show you."
    vx "Sim... terei o maior prazer em lhe mostrar."

# game/chapters/chapter6/ch6sc6.rpy:5209
translate brazil ch6sc6_139e1465:

#   vx "I felt drawn to the water, like it wanted me to be in it."
    vx "Senti-me atraído pela água, como se ela quisesse que eu estivesse dentro dela."

# game/chapters/chapter6/ch6sc6.rpy:5210
translate brazil ch6sc6_5ac886c9:

#   vx "My body was completely overtaken with warmth and serenity. I felt safe... so, I reached out."
    vx "Meu corpo foi completamente tomado por uma sensação de calor e serenidade. Eu me senti segura... então, estendi a mão."

# game/chapters/chapter6/ch6sc6.rpy:5211
translate brazil ch6sc6_4de795d3:

#   vx "Then the water surface rose up to embrace me -"
    vx "Então a superfície da água subiu para me abraçar -"

# game/chapters/chapter6/ch6sc6.rpy:5213
translate brazil ch6sc6_f364e1d5:

#   vx "*Gasps* Like this!"
    vx "*Suspira* Assim!"

# game/chapters/chapter6/ch6sc6.rpy:5214
translate brazil ch6sc6_cde963a8:

#   vx "L-Look it’s doing it!"
    vx "Olha, está funcionando!"

# game/chapters/chapter6/ch6sc6.rpy:5215
translate brazil ch6sc6_43043de1:

#   vx "It’s rising up towards me."
    vx "Está subindo em minha direção."

# game/chapters/chapter6/ch6sc6.rpy:5217
translate brazil ch6sc6_b1076ca1:

#   mc "How strange..."
    mc "Que estranho..."

# game/chapters/chapter6/ch6sc6.rpy:5218
translate brazil ch6sc6_92a36832:

#   mc "This water is enchanted... the color of the water in the basin where Malanthe’s statue stands was the same crimson red color."
    mc "Esta água é encantada... a cor da água na bacia onde se encontra a estátua de Malanthe era da mesma cor vermelho carmesim."

# game/chapters/chapter6/ch6sc6.rpy:5219
translate brazil ch6sc6_bb7b2a3b:

#   vx "It’s not blood, is it?"
    vx "Não é sangue, é?"

# game/chapters/chapter6/ch6sc6.rpy:5220
translate brazil ch6sc6_70299b62:

#   mc "No... everything about it is like normal water, except... the red coloring, and the soothing feeling when we're nearby."
    mc "Não... tudo nela é como água normal, exceto... a cor vermelha e a sensação calmante quando estamos por perto."

# game/chapters/chapter6/ch6sc6.rpy:5221
translate brazil ch6sc6_3883c4b4:

#   vx "And the fact it moves!"
    vx "E o fato de se mover!"

# game/chapters/chapter6/ch6sc6.rpy:5223
translate brazil ch6sc6_d8dc45cf:

#   mc "And that. Allow me..."
    mc "E isso. Permita-me..."

# game/chapters/chapter6/ch6sc6.rpy:5224
translate brazil ch6sc6_63a0ff04:

#   vx "Look! It’s rising up to you now!"
    vx "Olha! Está subindo na sua direção agora!"

# game/chapters/chapter6/ch6sc6.rpy:5225
translate brazil ch6sc6_f36b7174:

#   vx "What do you think? Is it... alive?"
    vx "O que você acha? Está... vivo?"

# game/chapters/chapter6/ch6sc6.rpy:5227
translate brazil ch6sc6_2ed4a0d1:

#   mc "How... intriguing..."
    mc "Que... intrigante..."

# game/chapters/chapter6/ch6sc6.rpy:5228
translate brazil ch6sc6_abaa8b77:

#   mc "I feel odd... at peace? Excited? There’s definitely a powerful force behind this."
    mc "Sinto-me estranho... em paz? Animado? Definitivamente há uma força poderosa por trás disso."

# game/chapters/chapter6/ch6sc6.rpy:5229
translate brazil ch6sc6_13e73904:

#   mc "Just dipping my fingertips is making them tingle."
    mc "Só de molhar a ponta dos dedos, já sinto um formigamento."

# game/chapters/chapter6/ch6sc6.rpy:5231
translate brazil ch6sc6_5a0325e3:

#   vx "A powerful force... do you think Malanthe herself enchanted these waters?"
    vx "Uma força poderosa... você acha que a própria Malanthe enfeitiçou essas águas?"

# game/chapters/chapter6/ch6sc6.rpy:5232
translate brazil ch6sc6_40d235b5:

#   mc "Mhm. I felt exactly like this when I was in her presence."
    mc "Sim. Eu me sentia exatamente assim quando estava na presença dela."

# game/chapters/chapter6/ch6sc6.rpy:5233
translate brazil ch6sc6_c971578a:

#   vx "Malanthe... imbued her presence into these waters... so that the worthy could bathe and invigorate themselves."
    vx "Malanthe... impregnou sua presença nessas águas... para que os dignos pudessem banhar-se e revigorar-se."

# game/chapters/chapter6/ch6sc6.rpy:5235
translate brazil ch6sc6_4270adc4:

#   vx "[mc]... this is her gift to us. Our reward for becoming hunter and huntress."
    vx "[mc]... este é o presente dela para nós. Nossa recompensa por nos tornarmos caçadores e caçadoras."

# game/chapters/chapter6/ch6sc6.rpy:5236
translate brazil ch6sc6_12ad0490:

#   vx "For taking down a beast the likes of which no one has managed to slay before."
    vx "Por ter abatido uma fera como ninguém jamais conseguiu derrotar."

# game/chapters/chapter6/ch6sc6.rpy:5237
translate brazil ch6sc6_a61f5156:

#   mct "{i}Mmm... her fingers are so gentle...{/i}"
    mct "{i}Hum... os dedos dela são tão delicados...{/i}"

