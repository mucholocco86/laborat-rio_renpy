translate brazil ch6sc4_3a551075:

#   pl "There are two things in life that men desire above all else."
    pl "Existem duas coisas na vida que os homens desejam acima de tudo."

# game/chapters/chapter6/ch6sc4.rpy:63
translate brazil ch6sc4_807b2104:

