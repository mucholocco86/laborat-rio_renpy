translate brazil ch6sc4_7236ee0f:

#   tz "What are you doing to me?"
    tz "O que você está fazendo comigo?"

# game/chapters/chapter6/ch6sc4.rpy:114
translate brazil ch6sc4_bf28462c:

#   mc "I’m revitalizing you. Your body doesn’t look injured, but you're clearly dehydrated and famished."
    mc "Estou revitalizando você. Seu corpo não parece ferido, mas você está claramente desidratado e faminto."

# game/chapters/chapter6/ch6sc4.rpy:115
translate brazil ch6sc4_71bfc5d6:

#   tz "*Whimpers softly* Mmmh... that’s... it feels soothing... warm even."
    tz "*Geme baixinho* Mmmh... isso... é reconfortante... até quentinho."

# game/chapters/chapter6/ch6sc4.rpy:116
translate brazil ch6sc4_365a91aa:

#   mc "It’ll just take a moment and you’ll feel better."
    mc "Vai levar só um minutinho e você vai se sentir melhor."

# game/chapters/chapter6/ch6sc4.rpy:118
translate brazil ch6sc4_467a8574:

#   tz "Aahh... t-take as long as you neeeeed- mmmh..."
