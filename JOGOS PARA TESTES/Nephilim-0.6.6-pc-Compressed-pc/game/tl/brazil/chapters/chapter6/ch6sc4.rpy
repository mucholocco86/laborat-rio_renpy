#   tz "Well... I used my translocator to find you."
    tz "Bem... eu usei meu translocador para te encontrar."

# game/chapters/chapter6/ch6sc4.rpy:176
translate brazil ch6sc4_9479be96:

#   mc "Your what, now?"
    mc "Seu quê, agora?"

