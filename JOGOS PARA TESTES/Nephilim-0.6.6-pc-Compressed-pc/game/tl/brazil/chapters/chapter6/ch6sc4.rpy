#   mi "You really think he’d like it?"
    mi "Você acha mesmo que ele gostaria disso?"

# game/chapters/chapter6/ch6sc4.rpy:58
translate brazil ch6sc4_55491733:

#   pl "Miyo, I’m going to tell you a secret."
    pl "Miyo, vou te contar um segredo."

# game/chapters/chapter6/ch6sc4.rpy:60
translate brazil ch6sc4_06f08833:

#   mi "Uh, I like secrets! What is it?"
    mi "Hum, eu gosto de segredos! Qual é?"

