translate brazil ch6sc4_e07b77c0:

#   zy ".............."
    zy "..............."

# game/chapters/chapter6/ch6sc4.rpy:536
translate brazil ch6sc4_4d309f5c:

#   zy "*Sighs* Against my better judgment... fine."
    zy "*Suspiro* Contra o meu bom senso... tudo bem."

# game/chapters/chapter6/ch6sc4.rpy:537
translate brazil ch6sc4_75bc047f:

#   zy "Let’s use the black magic device of this outsider."
    zy "Vamos usar o dispositivo de magia negra desse forasteiro."

# game/chapters/chapter6/ch6sc4.rpy:539
translate brazil ch6sc4_fdd9bca1:

#   tz "Great! Everyone gather around [mc]. Everyone needs to place a hand on him."
    tz "Ótimo! Todos se reúnam ao redor [mc] Todos precisam colocar a mão sobre ele."

# game/chapters/chapter6/ch6sc4.rpy:544
translate brazil ch6sc4_694be882:

#   "They all gather around. Once they all place their hands on you, Tazzy activates the device."
    "Todos se reúnem ao seu redor. Assim que todos colocam as mãos em você, Tazzy ativa o dispositivo."

# game/chapters/chapter6/ch6sc4.rpy:554
translate brazil ch6sc4_3254dc1e:

#   evr "{b}AuuuahHh!!{/b}"
    evr "{b}AuuuahHh!!{/b}"

# game/chapters/chapter6/ch6sc4.rpy:557
translate brazil ch6sc4_39a9c382:

#   evr "*Groans* Owwh... Hhnnghh... Ouch!"
    evr "*Gemidos* Ai... Hhnnghh... Ai!"

# game/chapters/chapter6/ch6sc4.rpy:558
translate brazil ch6sc4_894f7dda:

#   pl "Everyone okay?"
    pl "Está tudo bem com todos?"

# game/chapters/chapter6/ch6sc4.rpy:559
translate brazil ch6sc4_54c4532f:

#   sj "I’m fine..."
    sj "Estou bem..."

# game/chapters/chapter6/ch6sc4.rpy:560
translate brazil ch6sc4_0aaba728:

#   mi "Phew... that was wild."
    mi "Ufa... isso foi incrível."

# game/chapters/chapter6/ch6sc4.rpy:561
translate brazil ch6sc4_e3c20d0b:

#   mc "*Groans* Girls... as much as I enjoy being in the middle of this, could you all get up?"
    mc "*Gemidos* Meninas... por mais que eu goste de estar no meio disso, vocês poderiam se levantar?"

# game/chapters/chapter6/ch6sc4.rpy:563
translate brazil ch6sc4_d1deb1a0:

#   pl "We actually made it? And right to the front gate!"
    pl "Nós realmente conseguimos? E direto para o portão da frente!"

# game/chapters/chapter6/ch6sc4.rpy:564
translate brazil ch6sc4_a87027c7:

#   mi "It feels good to be home. Thanks to Tazzy and her special device!"
    mi "É bom estar em casa. Obrigada, Tazzy, e ao seu dispositivo especial!"

# game/chapters/chapter6/ch6sc4.rpy:565
translate brazil ch6sc4_19e452bb:

#   tz "Happy to help!"
    tz "Fico contente em ajudar!"

# game/chapters/chapter6/ch6sc4.rpy:566
translate brazil ch6sc4_fd0f2297:

#   sj "Come, let’s not dawdle out here. I’m sure they must be worried about us."
    sj "Vamos, não vamos ficar enrolando aqui. Tenho certeza de que eles devem estar preocupados conosco."

# game/chapters/chapter6/ch6sc4.rpy:568
translate brazil ch6sc4_f6f0e3ba:

#   zy "Looks like your black magic device worked."
    zy "Parece que seu dispositivo de magia negra funcionou."

# game/chapters/chapter6/ch6sc4.rpy:569
translate brazil ch6sc4_95785813:

#   mc "Yeah, seems like it."
    mc "Sim, parece que sim."

# game/chapters/chapter6/ch6sc4.rpy:572
translate brazil ch6sc4_f6a4686e:

#   mc "Zyra?"
    mc "Escritório?"

# game/chapters/chapter6/ch6sc4.rpy:574
translate brazil ch6sc4_b192ed94:

#   zy "Yes?"
    zy "Sim?"

# game/chapters/chapter6/ch6sc4.rpy:576
translate brazil ch6sc4_38c79534:

#   mc "Aren’t you getting up?"
    mc "Você não vai se levantar?"

# game/chapters/chapter6/ch6sc4.rpy:580
translate brazil ch6sc4_c49a79b4:

#   "Being close to you stirs emotions within Zyra she didn't realise she had, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Estar perto de você desperta emoções em Zyra que ela nem sabia que tinha; sua confiança aumentou. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:581
translate brazil ch6sc4_5b116f0b:

#   zy "Right... let’s go."
    zy "Certo... vamos lá."

# game/chapters/chapter6/ch6sc4.rpy:588
translate brazil ch6sc4_54717b45:

#   zy "Thank you for getting us back, Outsider."
    zy "Obrigado por nos trazer de volta, Forasteiro."

# game/chapters/chapter6/ch6sc4.rpy:590
translate brazil ch6sc4_09ff5625:

#   sj "*Hissed* Zyra! Stop calling him that."
    sj "*Sibilou* Zyra! Pare de chamá-lo assim."

# game/chapters/chapter6/ch6sc4.rpy:591
translate brazil ch6sc4_d56c5242:

#   sj "He is not an outsider any longer."
    sj "Ele não é mais um forasteiro."

# game/chapters/chapter6/ch6sc4.rpy:592
translate brazil ch6sc4_0da11273:

#   zy "*Nods*"
    zy "*Acena com a cabeça*"

# game/chapters/chapter6/ch6sc4.rpy:594
translate brazil ch6sc4_1e278d98:

#   zy "She's right. I apologize. Thank you, [mc]."
    zy "Ela tem razão. Peço desculpas. Obrigada. [mc]."

# game/chapters/chapter6/ch6sc4.rpy:595
translate brazil ch6sc4_84771e4c:

#   mc "You’re most welcome, Zyra."
    mc "De nada, Zyra."

# game/chapters/chapter6/ch6sc4.rpy:596
translate brazil ch6sc4_cf4b3025:

#   zy "We’ll go fetch Echo, she must be worried."
    zy "Vamos buscar a Echo, ela deve estar preocupada."

# game/chapters/chapter6/ch6sc4.rpy:598
translate brazil ch6sc4_3f9f061d:

#   mi "I’m going to go prepare the mushrooms we gathered, Pearl."
    mi "Vou preparar os cogumelos que colhemos, Pearl."

# game/chapters/chapter6/ch6sc4.rpy:599
translate brazil ch6sc4_01d2c94e:

#   mi "You and [mc] should stop by my hut later, and we can all enjoy them together."
    mi "Você e [mc] Você deve passar na minha cabana mais tarde, e podemos todos aproveitar juntos."

# game/chapters/chapter6/ch6sc4.rpy:601
translate brazil ch6sc4_c768dc09:

#   pl "Sounds great! I’m going to go visit your baths first. I can feel grime all over my skin."
    pl "Parece ótimo! Vou visitar seus banhos primeiro. Estou sentindo sujeira por toda a minha pele."

# game/chapters/chapter6/ch6sc4.rpy:603
translate brazil ch6sc4_d51fd4ac:

#   mi "Enjoy! We’ll see each other later then."
    mi "Aproveite! Nos vemos mais tarde então."

# game/chapters/chapter6/ch6sc4.rpy:612
translate brazil ch6sc4_ad6d1874:

#   ks "Marah, Marah..."
    ks "Com raiva, com raiva..."

# game/chapters/chapter6/ch6sc4.rpy:614
translate brazil ch6sc4_2e342f5f:

#   ks "Are you trying to bribe me?"
    ks "Você está tentando me subornar?"

# game/chapters/chapter6/ch6sc4.rpy:615
translate brazil ch6sc4_48cd155d:

#   ks "Tempting me with one of our last bottles of Tintoberry wine..."
    ks "Tentando-me com uma de nossas últimas garrafas de vinho Tintoberry..."

# game/chapters/chapter6/ch6sc4.rpy:617
translate brazil ch6sc4_60edcdb9:

#   mh "One of the last bottles of the delicious and unobtainable Tintoberry wine, you say?"
    mh "Você disse que são uma das últimas garrafas do delicioso e impossível de encontrar vinho Tintoberry?"

# game/chapters/chapter6/ch6sc4.rpy:618
translate brazil ch6sc4_09e99103:

#   mh "*Snickers* I hadn’t noticed."
    mh "*Risos* Eu não tinha percebido."

# game/chapters/chapter6/ch6sc4.rpy:620
translate brazil ch6sc4_38fb560e:

#   ks "You’re shrewd, I’ll give you that."
    ks "Você é astuto, isso eu admito."

# game/chapters/chapter6/ch6sc4.rpy:621
translate brazil ch6sc4_8db3b492:

#   ks "But, if you think my favorite wine will sway-"
    ks "Mas, se você acha que meu vinho favorito vai mudar de ideia..."

# game/chapters/chapter6/ch6sc4.rpy:623
translate brazil ch6sc4_b95efe46:

#   mh "No, no, no... you mistake my intent."
    mh "Não, não, não... você interpretou mal minhas intenções."

# game/chapters/chapter6/ch6sc4.rpy:625
translate brazil ch6sc4_e440abf1:

#   mh "A gift for a dear old friend."
    mh "Um presente para um querido amigo de longa data."

# game/chapters/chapter6/ch6sc4.rpy:627
translate brazil ch6sc4_1fdae644:

#   mh "Think of it as a sign of trust between us."
    mh "Considere isso um sinal de confiança entre nós."

# game/chapters/chapter6/ch6sc4.rpy:629
translate brazil ch6sc4_d68d0fd7:

#   ks "Old friend, huh?"
    ks "Velho amigo, né?"

# game/chapters/chapter6/ch6sc4.rpy:630
translate brazil ch6sc4_2e12e848:

#   ks "It’s been a while since we were friends, Marah."
    ks "Já faz um tempo que não somos amigas, Marah."

# game/chapters/chapter6/ch6sc4.rpy:632
translate brazil ch6sc4_000f7d84:

#   mh "Something which troubles me deeply, something I wish to correct."
    mh "Algo que me incomoda profundamente, algo que desejo corrigir."

# game/chapters/chapter6/ch6sc4.rpy:634
translate brazil ch6sc4_64540190:

#   mh "I know I’ve been... acting a little overly protective, as of late."
    mh "Eu sei que tenho agido... de forma um pouco superprotetora ultimamente."

# game/chapters/chapter6/ch6sc4.rpy:636
translate brazil ch6sc4_18d4ebc7:

#   ks "Overly protective? Your irrational fear of the outsider has put you at odds with our A’nu."
    ks "Excessivamente protetor? Seu medo irracional do forasteiro o colocou em conflito com nossos A'nu."

# game/chapters/chapter6/ch6sc4.rpy:638
translate brazil ch6sc4_4c30be49:

#   mh "Yes, yes... pushing him down into the depths of the temple..."
    mh "Sim, sim... empurrando-o para as profundezas do templo..."

# game/chapters/chapter6/ch6sc4.rpy:640
translate brazil ch6sc4_10f40691:

#   mh "*Quietly* {size=-10}{b}Backfired.{/b}{/size}"
    mh "*Em silêncio* {size=-10}{b}Deu errado.{/b}{/size}"

# game/chapters/chapter6/ch6sc4.rpy:641
translate brazil ch6sc4_715f5dca:

#   mh "*Quietly* {size=-10}{b}That devilish bastard.{/b}{/size}"
    mh "*Em silêncio* {size=-10}{b}Aquele desgraçado.{/b}{/size}"

# game/chapters/chapter6/ch6sc4.rpy:644
translate brazil ch6sc4_1879606a:

#   mh "*Quietly* {size=-10}{b}The outsider has proven himself to be... strong, tsk.{/b}{/size}"
    mh "*Em silêncio* {size=-10}{b}O forasteiro provou ser... forte, tsc.{/b}{/size}"

# game/chapters/chapter6/ch6sc4.rpy:645
translate brazil ch6sc4_1895fd85:

#   mh "*Quietly* {size=-10}{b}Even I must admit that was... impressive. Grrhh...{/b}{/size}"
    mh "*Em silêncio* {size=-10}{b}Até eu tenho que admitir que isso foi... impressionante. Grrhh...{/b}{/size}"

# game/chapters/chapter6/ch6sc4.rpy:651
translate brazil ch6sc4_a58967c2:

#   mh "I am High-Priestess, you’re Head-Huntress, we both share the burden of protecting our people."
    mh "Eu sou a Alta Sacerdotisa, você é a Caçadora de Cabeças, ambas compartilhamos o fardo de proteger nosso povo."

# game/chapters/chapter6/ch6sc4.rpy:652
translate brazil ch6sc4_aecf9055:

#   mh "We may not see eye to eye on many things these days, but our desire and duty to protect our tribe from-"
    mh "Podemos não concordar em muitas coisas hoje em dia, mas nosso desejo e dever de proteger nossa tribo de-"

# game/chapters/chapter6/ch6sc4.rpy:654
translate brazil ch6sc4_790f4cb4:

#   mh "From the horrors of the past... that is something we still share to this day."
    mh "Dos horrores do passado... isso é algo que ainda compartilhamos até hoje."

# game/chapters/chapter6/ch6sc4.rpy:656
translate brazil ch6sc4_73974fa2:

#   ks "The wellbeing of the tribe comes before all."
    ks "O bem-estar da tribo vem antes de tudo."

# game/chapters/chapter6/ch6sc4.rpy:658
translate brazil ch6sc4_6bbc2f89:

#   mh "Exactly!"
    mh "Exatamente!"

# game/chapters/chapter6/ch6sc4.rpy:659
translate brazil ch6sc4_dfdfa37c:

#   mh "Which is why I’ve come to you, Kisha."
    mh "Por isso vim até você, Kisha."

# game/chapters/chapter6/ch6sc4.rpy:661
translate brazil ch6sc4_14bd1a1b:

#   mh "The outsiders, they pose a threat."
    mh "Os forasteiros representam uma ameaça."

# game/chapters/chapter6/ch6sc4.rpy:662
translate brazil ch6sc4_520a4b7b:

#   mh "They’re a problem that needs solving."
    mh "São um problema que precisa ser resolvido."

# game/chapters/chapter6/ch6sc4.rpy:663
translate brazil ch6sc4_46513467:

#   mh "They don't desire to follow our ways. Instead, they seek to corrupt us from within."
    mh "Eles não desejam seguir nossos caminhos. Em vez disso, procuram nos corromper por dentro."

# game/chapters/chapter6/ch6sc4.rpy:665
translate brazil ch6sc4_f7ce3ce3:

#   ks "Hmm."
    ks "Hum."

# game/chapters/chapter6/ch6sc4.rpy:666
translate brazil ch6sc4_eb4fc9cd:

#   ks "Your conviction isn’t lacking. What makes you so sure of their intentions?"
    ks "Você não tem falta de convicção. O que te faz ter tanta certeza das intenções deles?"

# game/chapters/chapter6/ch6sc4.rpy:668
translate brazil ch6sc4_41e2dbe1:

#   mh "Echo... sweet, naive Echo."
    mh "Eco... a doce e ingênua Eco."

# game/chapters/chapter6/ch6sc4.rpy:671
translate brazil ch6sc4_dd599021:

#   ks "Watch your tongue. She is our A’nu."
    ks "Cuidado com a língua. Ela é nossa A'nu."

# game/chapters/chapter6/ch6sc4.rpy:673
translate brazil ch6sc4_8e73910f:

#   mh "Her kindness to the outsider has allowed him to corrupt her mind and heart."
    mh "Sua bondade para com o forasteiro permitiu que ele corrompesse sua mente e seu coração."

# game/chapters/chapter6/ch6sc4.rpy:674
translate brazil ch6sc4_7443b0f0:

#   mh "Did you not see how upset she was when I sent him into the depths?"
    mh "Você não viu o quanto ela ficou chateada quando eu o mandei para as profundezas?"

# game/chapters/chapter6/ch6sc4.rpy:675
translate brazil ch6sc4_be80d716:

#   mh "His seed of corruption had already begun taking hold of her."
    mh "A semente da corrupção dele já havia começado a se apoderar dela."

# game/chapters/chapter6/ch6sc4.rpy:677
translate brazil ch6sc4_d0d094a3:

#   mh "He has deceived her mind, Kisha."
    mh "Ele a enganou, Kisha."

# game/chapters/chapter6/ch6sc4.rpy:678
translate brazil ch6sc4_5f2bd939:

#   mh "And he will continue to corrupt her and the tribe."
    mh "E ele continuará a corrompê-la, assim como a toda a tribo."

# game/chapters/chapter6/ch6sc4.rpy:680
translate brazil ch6sc4_cebe354e:

#   ks "I would never allow him to harm her."
    ks "Eu jamais permitiria que ele a machucasse."

# game/chapters/chapter6/ch6sc4.rpy:681
translate brazil ch6sc4_5fd85d24:

#   ks "He will never lay hands on her."
    ks "Ele jamais levantará as mãos para ela."

# game/chapters/chapter6/ch6sc4.rpy:683
translate brazil ch6sc4_a4405281:

#   mh "Lay his hands on her?"
    mh "Pôs as mãos nela?"

# game/chapters/chapter6/ch6sc4.rpy:684
translate brazil ch6sc4_b17d1915:

#   mh "Hmh, who says he hasn’t already had them all over her?"
    mh "Hum, quem disse que ele já não a pegou todas?"

# game/chapters/chapter6/ch6sc4.rpy:685
translate brazil ch6sc4_8d9d957c:

#   ks "That’s enough. Assuming things won't get you anywhere."
    ks "Chega. Partindo do princípio de que isso não vai te levar a lugar nenhum."

# game/chapters/chapter6/ch6sc4.rpy:686
translate brazil ch6sc4_8570baa7:

#   ks "Your point has been made."
    ks "Seu argumento foi esclarecido."

# game/chapters/chapter6/ch6sc4.rpy:688
translate brazil ch6sc4_cb5099af:

#   mh "Has it?"
    mh "Será mesmo?"

# game/chapters/chapter6/ch6sc4.rpy:690
translate brazil ch6sc4_dd5ccea8:

#   ks "Yes, it has."
    ks "Sim, tem."

# game/chapters/chapter6/ch6sc4.rpy:691
translate brazil ch6sc4_172f9c40:

#   ks "I thank you for your gift, now I must return to my duties."
    ks "Agradeço o seu presente, agora devo retornar às minhas funções."

# game/chapters/chapter6/ch6sc4.rpy:693
translate brazil ch6sc4_89e16f79:

#   ks "I suggest you do the same."
    ks "Sugiro que você faça o mesmo."

# game/chapters/chapter6/ch6sc4.rpy:695
translate brazil ch6sc4_859b4713:

#   mh "Yes, yes... our duties cannot be neglected, remember that."
    mh "Sim, sim... não podemos negligenciar nossos deveres, lembrem-se disso."

# game/chapters/chapter6/ch6sc4.rpy:697
translate brazil ch6sc4_aa82f69e:

#   mh "Think about what we’ve discussed, old friend."
    mh "Pense no que conversamos, meu velho amigo."

# game/chapters/chapter6/ch6sc4.rpy:698
translate brazil ch6sc4_51f31a06:

#   mh "The tribe is counting on us."
    mh "A tribo está contando conosco."

# game/chapters/chapter6/ch6sc4.rpy:700
translate brazil ch6sc4_9073d71c:

#   ks "You’ve given me much to think about, that is true."
    ks "Você me deu muito em que pensar, isso é verdade."

# game/chapters/chapter6/ch6sc4.rpy:702
translate brazil ch6sc4_6165f229:

#   ks "I’ll take my leave then."
    ks "Então, vou-me embora."

# game/chapters/chapter6/ch6sc4.rpy:703
translate brazil ch6sc4_9c49f3d1:

#   mh "Savor the wine! There’s no telling if we’ll ever obtain more."
    mh "Aproveite o vinho! Não sabemos se conseguiremos mais."

# game/chapters/chapter6/ch6sc4.rpy:704
translate brazil ch6sc4_47c78ef5:

#   ks "Hrrm... savor it, I shall."
    ks "Hum... vou saborear cada momento."

# game/chapters/chapter6/ch6sc4.rpy:713
translate brazil ch6sc4_2aa80b1a:

#   ec "[mc]!"
    ec "[mc]!"

# game/chapters/chapter6/ch6sc4.rpy:714
translate brazil ch6sc4_cbc5b7ee:

#   ec "By all the goddesses!"
    ec "Por todas as deusas!"

# game/chapters/chapter6/ch6sc4.rpy:716
translate brazil ch6sc4_0511b900:

#   ec "Y-You’re back, and unharmed?"
    ec "Você voltou e está ileso?"

# game/chapters/chapter6/ch6sc4.rpy:717
translate brazil ch6sc4_8bd66bfe:

#   ec "No ill fate has befallen you?"
    ec "Nenhuma desgraça lhe sobreveio?"

# game/chapters/chapter6/ch6sc4.rpy:719
translate brazil ch6sc4_afd5d286:

#   mc "Don’t worry... Echo, I’m unharmed."
    mc "Não se preocupe... Echo, estou ileso."

# game/chapters/chapter6/ch6sc4.rpy:721
translate brazil ch6sc4_0b066be5:

#   ec "When you weren’t back by sundown... I feared the worst."
    ec "Quando você não voltou antes do pôr do sol... temi o pior."

# game/chapters/chapter6/ch6sc4.rpy:723
translate brazil ch6sc4_096412bb:

#   ec "Oh? Who’s this?"
    ec "Oh? Quem é?"

# game/chapters/chapter6/ch6sc4.rpy:724
translate brazil ch6sc4_44fcf5d8:

#   ec "She's beautiful. A friend of yours?"
    ec "Ela é linda. É sua amiga?"

# game/chapters/chapter6/ch6sc4.rpy:726
translate brazil ch6sc4_b4eb53a8:

#   tz "Tazzy! And thank you!"
    tz "Tazzy! E obrigada!"

# game/chapters/chapter6/ch6sc4.rpy:727
translate brazil ch6sc4_b8a9266e:

#   tz "But please, you can call me Taz. Pleasure!"
    tz "Mas, por favor, pode me chamar de Taz. Com prazer!"

# game/chapters/chapter6/ch6sc4.rpy:729
translate brazil ch6sc4_6fb71595:

#   ec "No, no. The pleasure is mine."
    ec "Não, não. O prazer é meu."

# game/chapters/chapter6/ch6sc4.rpy:730
translate brazil ch6sc4_e1ada1c7:

#   ec "Welcome to A’nai, Taz."
    ec "Bem-vindo a A'nai, Taz."

# game/chapters/chapter6/ch6sc4.rpy:731
translate brazil ch6sc4_2dee47af:

#   ec "Are you the ambassador that [mc] is searching for?"
    ec "Você é o embaixador que... [mc] O que você está procurando?"

# game/chapters/chapter6/ch6sc4.rpy:733
translate brazil ch6sc4_513393b2:

#   tz "Ambassador? No, I’m a chronicler assigned to [mc]!"
    tz "Embaixador? Não, sou um cronista designado para [mc]!"

# game/chapters/chapter6/ch6sc4.rpy:735
translate brazil ch6sc4_e14db95b:

#   ec "Is that so?"
    ec "É assim mesmo?"

# game/chapters/chapter6/ch6sc4.rpy:736
translate brazil ch6sc4_1393117e:

#   ec "Forgive me, but I don't know what that is."
    ec "Me perdoe, mas eu não sei o que é isso."

# game/chapters/chapter6/ch6sc4.rpy:738
translate brazil ch6sc4_ab72e392:

#   tz "Oh, oh... uh, how do I best put it?"
    tz "Oh, oh... hum, como posso dizer isso da melhor forma?"

# game/chapters/chapter6/ch6sc4.rpy:740
translate brazil ch6sc4_cfecaa25:

#   mc "We’re friends, let’s just leave it at that."
    mc "Somos amigos, vamos deixar por isso mesmo."

# game/chapters/chapter6/ch6sc4.rpy:741
translate brazil ch6sc4_f9293e82:

#   tz "Yeah, I guess we have become friends!"
    tz "É, acho que nos tornamos amigos!"

# game/chapters/chapter6/ch6sc4.rpy:743
translate brazil ch6sc4_6cc30811:

#   tz "Hnnghh..."
    tz "Hnnghh..."

# game/chapters/chapter6/ch6sc4.rpy:744
translate brazil ch6sc4_2beff85e:

#   mc "Taz? What’s wrong?"
    mc "Taz? O que houve?"

# game/chapters/chapter6/ch6sc4.rpy:745
translate brazil ch6sc4_64d9bb63:

#   tz "I feel a little lightheaded suddenly... Nnghh."
    tz "De repente, sinto uma leve tontura... Nnghh."

# game/chapters/chapter6/ch6sc4.rpy:747
translate brazil ch6sc4_aaae1f41:

#   ec "She needs rest. The jungle has clearly taken its toll on her and she's exhausted."
    ec "Ela precisa descansar. A selva claramente a debilitou muito e ela está exausta."

# game/chapters/chapter6/ch6sc4.rpy:748
translate brazil ch6sc4_fd6b0320:

#   ec "Poor thing."
    ec "Coitadinho."

# game/chapters/chapter6/ch6sc4.rpy:749
translate brazil ch6sc4_4c9857f1:

#   ec "I can't imagine being out there alone in an unknown jungle."
    ec "Não consigo me imaginar sozinha em uma selva desconhecida."

# game/chapters/chapter6/ch6sc4.rpy:751
translate brazil ch6sc4_72019806:

#   ec "Suji, Zyra."
    ec "Suji, escritório."

# game/chapters/chapter6/ch6sc4.rpy:753
translate brazil ch6sc4_84ba5340:

#   ec "Please, take her to a hut where she can rest and recover."
    ec "Por favor, levem-na para uma cabana onde ela possa descansar e se recuperar."

# game/chapters/chapter6/ch6sc4.rpy:754
translate brazil ch6sc4_1c6c586b:

#   ec "One of the healing huts should be vacant."
    ec "Uma das cabanas de cura deve estar vaga."

# game/chapters/chapter6/ch6sc4.rpy:755
translate brazil ch6sc4_1d6fd91c:

#   ec "We haven’t had any injuries in the tribe lately."
    ec "Não tivemos nenhum ferimento na tribo ultimamente."

# game/chapters/chapter6/ch6sc4.rpy:757
translate brazil ch6sc4_115516d2:

#   sj "We’ll take her right away."
    sj "Vamos levá-la imediatamente."

# game/chapters/chapter6/ch6sc4.rpy:758
translate brazil ch6sc4_b0895ad2:

#   zy "As you command, A’nu."
    zy "Como ordenas, A'nu."

# game/chapters/chapter6/ch6sc4.rpy:760
translate brazil ch6sc4_0cdcc8cc:

#   ec "Thank you."
    ec "Obrigado."

# game/chapters/chapter6/ch6sc4.rpy:762
translate brazil ch6sc4_1f2519c3:

#   ec "One of the priestesses will tend to you."
    ec "Uma das sacerdotisas irá atendê-lo(a)."

# game/chapters/chapter6/ch6sc4.rpy:763
translate brazil ch6sc4_2616f351:

#   ec "Once you’ve got some rest and food, you’ll be good as new."
    ec "Depois de descansar e se alimentar bem, você estará como novo."

# game/chapters/chapter6/ch6sc4.rpy:765
translate brazil ch6sc4_9c337f34:

#   tz "You're most kind, but really... I’m fine."
    tz "Você é muito gentil, mas na verdade... eu estou bem."

# game/chapters/chapter6/ch6sc4.rpy:766
translate brazil ch6sc4_d01dcc71:

#   tz "I don't wish to impose on your tribe..."
    tz "Não desejo incomodar sua tribo..."

# game/chapters/chapter6/ch6sc4.rpy:771
translate brazil ch6sc4_27007923:

#   mc "Taz, You’re going, and that’s final."
    mc "Taz, você vai, e ponto final."

# game/chapters/chapter6/ch6sc4.rpy:772
translate brazil ch6sc4_861971ba:

#   mc "You have been through a great deal out there, but your body still clearly needs some proper rest."
    mc "Você passou por muita coisa lá fora, mas seu corpo ainda precisa claramente de um descanso adequado."

# game/chapters/chapter6/ch6sc4.rpy:773
translate brazil ch6sc4_40d92a70:

#   tz "[mc], I'm fin-"
    tz "[mc], eu estou fin-"

# game/chapters/chapter6/ch6sc4.rpy:775
translate brazil ch6sc4_5c0f5f49:

#   mc "You're going to take this kind offer Echo just gave you, and rest, fully."
    mc "Você vai aceitar essa gentil oferta que Echo acabou de lhe fazer e descansar completamente."

# game/chapters/chapter6/ch6sc4.rpy:776
translate brazil ch6sc4_f3e9bc8c:

#   mc "If you do not, so help me I will drag you back out there to fend for yourself."
    mc "Se você não fizer isso, juro por Deus que vou arrastá-lo de volta para lá para se virar sozinho."

# game/chapters/chapter6/ch6sc4.rpy:777
translate brazil ch6sc4_cb3be07a:

#   tz "O-Okay! Okay! Gosh-dolly, I will rest!"
    tz "Tá bom! Tá bom! Nossa, eu vou descansar!"

# game/chapters/chapter6/ch6sc4.rpy:778
translate brazil ch6sc4_c0fb9bb8:

#   "You managed to intimidate Taz to get the rest she needs, your {b}{color=#fc584c}Intimidation{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguiu intimidar a Taz para que ela descansasse, sua. {b}{color=#fc584c}Intimidação{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:780
translate brazil ch6sc4_a41f7a43:

#   tz "[mc] has a point, I will accept your generous offer."
    tz "[mc] Você tem razão, aceitarei sua generosa oferta."

# game/chapters/chapter6/ch6sc4.rpy:785
translate brazil ch6sc4_34351ac9:

#   mc "You’re going, and that’s final."
    mc "Você vai, e ponto final."

# game/chapters/chapter6/ch6sc4.rpy:786
translate brazil ch6sc4_45009d9c:

#   mc "I may have revitalized you, but your body still clearly needs some proper rest."
    mc "Talvez eu tenha te revitalizado, mas seu corpo ainda precisa claramente de um descanso adequado."

# game/chapters/chapter6/ch6sc4.rpy:787
translate brazil ch6sc4_6f81bc1c:

#   tz "I-I suppose a little nap and some food won’t do me any harm."
    tz "Acho que um cochilo e alguma comida não me farão mal nenhum."

# game/chapters/chapter6/ch6sc4.rpy:789
translate brazil ch6sc4_3d6fe728:

#   "You took command and managed to get Taz to rest, your {b}{color=#ffee54}Leadership{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você assumiu o comando e conseguiu fazer Taz descansar, seu {b}{color=#ffee54}Liderança{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:791
translate brazil ch6sc4_aa561233:

#   tz "I will gladly take you up on the offer, resting is the logical decision."
    tz "Aceitarei sua oferta com prazer; descansar é a decisão lógica."

# game/chapters/chapter6/ch6sc4.rpy:795
translate brazil ch6sc4_3d056e75:

#   mc "Taz, you're clearly in need of rest, a lot of it..."
    mc "Taz, você claramente precisa descansar, e muito..."

# game/chapters/chapter6/ch6sc4.rpy:796
translate brazil ch6sc4_b06c6ba8:

#   mc "You're really going to stand here and deny it?"
    mc "Você vai mesmo ficar aí negando isso?"

# game/chapters/chapter6/ch6sc4.rpy:797
translate brazil ch6sc4_61518925:

#   mc "It wouldn't be very nice to reject Echo's offer, she wants to make sure you're okay."
    mc "Não seria muito legal recusar a oferta da Echo, ela quer ter certeza de que você está bem."

# game/chapters/chapter6/ch6sc4.rpy:798
translate brazil ch6sc4_caaab761:

#   tz "*Sighs* Damnit, even I can't argue with that..."
    tz "*Suspiro* Droga, nem eu consigo discordar disso..."

# game/chapters/chapter6/ch6sc4.rpy:800
translate brazil ch6sc4_2dec2fff:

#   "You succeeding in persuading Taz to rest, your {b}{color=#2bff8b}Persuasion{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguindo persuadir Taz a descansar, seu {b}{color=#2bff8b}Persuasão{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:802
translate brazil ch6sc4_75f5c4ae:

#   tz "Resting is the logical decision, and it's a generous offer, thank you Echo, I will accept."
    tz "Descansar é a decisão lógica, e é uma oferta generosa, obrigada Echo, eu aceito."

# game/chapters/chapter6/ch6sc4.rpy:806
translate brazil ch6sc4_a52c38cb:

#   mc "Taz, I've begun to care about you, we're becoming friends."
    mc "Taz, comecei a me importar com você, estamos nos tornando amigos."

# game/chapters/chapter6/ch6sc4.rpy:807
translate brazil ch6sc4_1a239e6c:

#   mc "If you won't rest for yourself, then do it for me?"
    mc "Se você não descansar por si mesmo, então descanse por mim?"

# game/chapters/chapter6/ch6sc4.rpy:808
translate brazil ch6sc4_79ac538b:

#   mc "I'd feel better knowing you're recovering your strength."
    mc "Eu me sentiria melhor sabendo que você está recuperando suas forças."

# game/chapters/chapter6/ch6sc4.rpy:809
translate brazil ch6sc4_a23104bb:

#   tz "You would? I-... oh how can I say no when you put it like that..."
    tz "Você faria isso? Eu... ah, como posso dizer não quando você coloca dessa forma...?"

# game/chapters/chapter6/ch6sc4.rpy:811
translate brazil ch6sc4_8e4b8052:

#   "You succeeding in persuading Taz to rest, your {b}{color=#87e1fa}Charisma{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguindo persuadir Taz a descansar, seu {b}{color=#87e1fa}Carisma{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:813
translate brazil ch6sc4_ae29dbef:

#   tz "I can't leave [mc] to worry about me, Echo, I will happily accept your kind offer."
    tz "Não posso ir embora [mc] Se você não quiser se preocupar comigo, Echo, aceitarei com prazer sua gentil oferta."

# game/chapters/chapter6/ch6sc4.rpy:817
translate brazil ch6sc4_2b4c128a:

#   sj "Taz, was it?"
    sj "Taz, não é?"

# game/chapters/chapter6/ch6sc4.rpy:818
translate brazil ch6sc4_69f676c5:

#   tz "Yes, thank you girls for taking care of me. You know, out there in the jungle."
    tz "Sim, obrigada meninas por cuidarem de mim. Sabe, lá na selva."

# game/chapters/chapter6/ch6sc4.rpy:819
translate brazil ch6sc4_e65f1770:

#   zy "We did what any Huntress would. We take care of the injured."
    zy "Fizemos o que qualquer Caçadora faria. Cuidamos dos feridos."

# game/chapters/chapter6/ch6sc4.rpy:820
translate brazil ch6sc4_5cb6eb54:

#   tz "Still, I’m grateful... I really am."
    tz "Ainda assim, sou grato... de verdade."

# game/chapters/chapter6/ch6sc4.rpy:821
translate brazil ch6sc4_8aca0081:

#   "You feel a gentle touch on your chest."
    "Você sente um toque suave no seu peito."

# game/chapters/chapter6/ch6sc4.rpy:823
translate brazil ch6sc4_32c6b6e8:

#   ec "[mc]..."
    ec "[mc]..."

# game/chapters/chapter6/ch6sc4.rpy:824
translate brazil ch6sc4_153bd6bb:

#   ec "You must rest as well."
    ec "Você também precisa descansar."

# game/chapters/chapter6/ch6sc4.rpy:825
translate brazil ch6sc4_dc8c2f04:

#   mc "I’m okay, you don’t need to worry about me."
    mc "Estou bem, não precisa se preocupar comigo."

# game/chapters/chapter6/ch6sc4.rpy:827
translate brazil ch6sc4_60930d09:

#   ec "I find that to be... impossible."
    ec "Considero isso... impossível."

# game/chapters/chapter6/ch6sc4.rpy:829
translate brazil ch6sc4_6794ae6f:

#   ec "Your journey into the jungle will have taken a toll, even if you will not admit it to me."
    ec "Sua jornada pela selva certamente lhe cobrou um preço, mesmo que você não admita isso para mim."

# game/chapters/chapter6/ch6sc4.rpy:831
translate brazil ch6sc4_d8cff4de:

#   mc "I suppose it has been quite exhausting."
    mc "Imagino que tenha sido bastante exaustivo."

# game/chapters/chapter6/ch6sc4.rpy:832
translate brazil ch6sc4_ea5e4ee8:

#   ec "You've done well."
    ec "Você se saiu bem."

# game/chapters/chapter6/ch6sc4.rpy:834
translate brazil ch6sc4_abe5d9a6:

#   ec "If you won't rest right away, then at least you should sit."
    ec "Se você não vai descansar imediatamente, pelo menos sente-se."

# game/chapters/chapter6/ch6sc4.rpy:836
translate brazil ch6sc4_52ad3248:

#   ec "Sit with me? Tell me about what happened in the jungle?"
    ec "Sente-se comigo? Conte-me o que aconteceu na selva?"

# game/chapters/chapter6/ch6sc4.rpy:837
translate brazil ch6sc4_5fc8fd79:

#   mc "Sure. You must be curious."
    mc "Claro. Você deve estar curioso(a)."

# game/chapters/chapter6/ch6sc4.rpy:839
translate brazil ch6sc4_0fafeb0b:

#   ec "*Scoffs lightly* Curious? That would be an understatement."
    ec "*Risos discretos* Curioso? Isso seria um eufemismo."

# game/chapters/chapter6/ch6sc4.rpy:840
translate brazil ch6sc4_e597e875:

#   ec "Come, we’ll find a bench to sit on. I won’t make you climb the stairs to my chambers tonight."
    ec "Venha, vamos encontrar um banco para sentarmos. Não vou fazer você subir as escadas até meus aposentos esta noite."

# game/chapters/chapter6/ch6sc4.rpy:841
translate brazil ch6sc4_438bea10:

#   mc "You’re too generous. *Chuckles*"
    mc "Você é generoso demais. *Risos*"

# game/chapters/chapter6/ch6sc4.rpy:843
translate brazil ch6sc4_918c703c:

#   ec "This spot should be good, I like it here."
    ec "Este lugar parece bom, eu gosto daqui."

# game/chapters/chapter6/ch6sc4.rpy:845
translate brazil ch6sc4_602eb408:

#   mc "It’s where we first sat down and chatted during the tour you gave me."
    mc "Foi lá que nos sentamos e conversamos pela primeira vez durante a visita guiada que você me deu."

# game/chapters/chapter6/ch6sc4.rpy:846
translate brazil ch6sc4_6ce94245:

#   ec "You remember?"
    ec "Você se lembra?"

# game/chapters/chapter6/ch6sc4.rpy:848
translate brazil ch6sc4_ad5ca0c1:

#   mc "Vividly, you had my full attention."
    mc "Você captou minha atenção completamente, de forma vívida."

# game/chapters/chapter6/ch6sc4.rpy:849
translate brazil ch6sc4_7f90817e:

#   mc "As you do now."
    mc "Como você faz agora."

# game/chapters/chapter6/ch6sc4.rpy:851
translate brazil ch6sc4_2b37dfb0:

#   ec "You really know what to say to make me feel... warm."
    ec "Você sabe mesmo o que dizer para me fazer sentir... acolhida."

# game/chapters/chapter6/ch6sc4.rpy:852
translate brazil ch6sc4_1de29ef4:

#   ec "Please, sit beside me. I will not have you standing any longer."
    ec "Por favor, sente-se ao meu lado. Não vou deixar você ficar de pé por mais tempo."

# game/chapters/chapter6/ch6sc4.rpy:854
translate brazil ch6sc4_8eff56d3:

#   mc "Don’t mind if I do."
    mc "Não me importo se eu fizer isso."

# game/chapters/chapter6/ch6sc4.rpy:855
translate brazil ch6sc4_6a9c7296:

#   ec "I do not... mind it."
    ec "Não me importo com isso."

# game/chapters/chapter6/ch6sc4.rpy:857
translate brazil ch6sc4_4214abb4:

#   mc "*Chuckles* You don’t have to confirm, it’s just a saying."
    mc "*Risos* Não precisa confirmar, é só um ditado."

# game/chapters/chapter6/ch6sc4.rpy:859
translate brazil ch6sc4_b8fb2304:

#   ec "Ohh! *Giggles softly* I am still getting used to your way of speaking."
    ec "Oh! *Risos suaves* Ainda estou me acostumando com o seu jeito de falar."

# game/chapters/chapter6/ch6sc4.rpy:861
translate brazil ch6sc4_e5c0ed65:

#   mc "As am I, with your tribe. Although, I feel like I’m getting the hang of it."
    mc "Eu também, e me identifico com a sua tribo. Embora eu sinta que estou começando a pegar o jeito."

# game/chapters/chapter6/ch6sc4.rpy:863
translate brazil ch6sc4_84b8230a:

#   ec "Being around Suji and Zyra all day, even Miyo... I imagine you’ve had to adapt quickly."
    ec "Passar o dia todo perto da Suji e da Zyra, e até da Miyo... imagino que você teve que se adaptar rapidamente."

# game/chapters/chapter6/ch6sc4.rpy:865
translate brazil ch6sc4_f83d9087:

#   mc "Yeah, I suppose they rubbed off on me a little."
    mc "É, acho que acabei absorvendo um pouco disso."

# game/chapters/chapter6/ch6sc4.rpy:869
translate brazil ch6sc4_74586479:

#   ec "I wish to hear all of it."
    ec "Quero ouvir tudo."

# game/chapters/chapter6/ch6sc4.rpy:871
translate brazil ch6sc4_c92d0085:

#   ec "From the moment you stepped outside our gates, until you arrived back within them."
    ec "Desde o momento em que você saiu pelos nossos portões até o momento em que retornou para dentro deles."

# game/chapters/chapter6/ch6sc4.rpy:873
translate brazil ch6sc4_03c3835d:

#   ec "Will you share your experiences with me?"
    ec "Você gostaria de compartilhar suas experiências comigo?"

# game/chapters/chapter6/ch6sc4.rpy:875
translate brazil ch6sc4_e75c79f8:

#   "You start from the beginning... Echo remaining silent and listening attentively."
    "Você começa do início... Echo permanece em silêncio, ouvindo atentamente."

# game/chapters/chapter6/ch6sc4.rpy:882
translate brazil ch6sc4_113b1fb8:

#   "Saving Miyo when she fell from the tree."
    "Salvando Miyo quando ela caiu da árvore."

# game/chapters/chapter6/ch6sc4.rpy:885
translate brazil ch6sc4_868691cc:

#   "Being led to a safe zone within the mist by following traces of magic from the shrine."
    "Sendo conduzido a uma zona segura dentro da névoa ao seguir vestígios de magia provenientes do santuário."

# game/chapters/chapter6/ch6sc4.rpy:888
translate brazil ch6sc4_2573ae40:

#   "You and Suji setting out to try to find a path back."
    "Você e Suji partem em busca de um caminho de volta."

# game/chapters/chapter6/ch6sc4.rpy:891
translate brazil ch6sc4_e7cf2222:

#   "Unexpectedly stumbling upon Tazzy, your acquaintance from the mainland."
    "Ao se deparar inesperadamente com Tazzy, uma conhecida sua do continente."

# game/chapters/chapter6/ch6sc4.rpy:894
translate brazil ch6sc4_4478035e:

#   "How your talisman reacted when you approached the entrance to Gaia’s temple."
    "Como seu talismã reagiu quando você se aproximou da entrada do templo de Gaia."

# game/chapters/chapter6/ch6sc4.rpy:897
translate brazil ch6sc4_40789edb:

#   "The trials that you and Suji conquered together inside Gaia’s temple."
    "As provações que você e Suji superaram juntos dentro do templo de Gaia."

# game/chapters/chapter6/ch6sc4.rpy:900
translate brazil ch6sc4_17a3ce76:

#   "You and Suji shielding each other from danger."
    "Você e Suji se protegendo mutuamente do perigo."

# game/chapters/chapter6/ch6sc4.rpy:903
translate brazil ch6sc4_a30249de:

#   "Reaching Gaia’s inner sanctum..."
    "Atingindo o santuário interior de Gaia..."

# game/chapters/chapter6/ch6sc4.rpy:906
translate brazil ch6sc4_39daaa52:

#   "Gaia granting you an audience."
    "Gaia concedendo-lhe uma audiência."

# game/chapters/chapter6/ch6sc4.rpy:909
translate brazil ch6sc4_1e6f0121:

#   "Becoming Gaia’s chosen, her champion."
    "Tornando-me a escolhida de Gaia, sua campeã."

# game/chapters/chapter6/ch6sc4.rpy:912
translate brazil ch6sc4_a313baec:

#   "Acquiring the first of three communion stones."
    "Adquirindo a primeira das três pedras da comunhão."

# game/chapters/chapter6/ch6sc4.rpy:915
translate brazil ch6sc4_be31e2bd:

#   "Then recovering Taz's tools, and bringing everyone back."
    "Em seguida, recuperamos as ferramentas de Taz e trouxemos todos de volta."

# game/chapters/chapter6/ch6sc4.rpy:924
translate brazil ch6sc4_3a6369d7:

#   ec "..."
    ec "..."

# game/chapters/chapter6/ch6sc4.rpy:926
translate brazil ch6sc4_185cec50:

#   ec "By all the goddesses... [mc]..."
    ec "Por todas as deusas... [mc]..."

# game/chapters/chapter6/ch6sc4.rpy:927
translate brazil ch6sc4_944a5348:

#   ec "All that, and you’re still standing? How have you not collapsed long ago?"
    ec "Depois de tudo isso, você ainda está de pé? Como é que você ainda não desmaiou há muito tempo?"

# game/chapters/chapter6/ch6sc4.rpy:929
translate brazil ch6sc4_73d052e0:

#   mc "Welcome to an adventurer’s life. Although, this was definitely not an average day. *Chuckles*"
    mc "Bem-vindo à vida de um aventureiro. Embora, definitivamente, este não tenha sido um dia comum. *Risos*"

# game/chapters/chapter6/ch6sc4.rpy:932
translate brazil ch6sc4_8c8038ea:

#   ec "Champion of the trials, an outsider risking his life to protect both Miyo and Suji... a hero."
    ec "Campeão das provas, um forasteiro que arrisca a vida para proteger Miyo e Suji... um herói."

# game/chapters/chapter6/ch6sc4.rpy:933
translate brazil ch6sc4_3d152d5a:

#   ec "Entrusted and chosen by {b}Gaia{/b} herself to serve as her champion for our people..."
    ec "Encarregado e escolhido por {b} Gaia{/b} Ela mesma para servir como defensora do nosso povo..."

# game/chapters/chapter6/ch6sc4.rpy:935
translate brazil ch6sc4_0b0b72c1:

#   ec "You really are..."
    ec "Você realmente é..."

# game/chapters/chapter6/ch6sc4.rpy:936
translate brazil ch6sc4_fedbb66e:

#   ec "Special."
    ec "Especial."

# game/chapters/chapter6/ch6sc4.rpy:937
translate brazil ch6sc4_b899310d:

#   mct "Mmh... her hand is incredibly soft and soothing."
    mct "Hum... a mão dela é incrivelmente macia e suave."

# game/chapters/chapter6/ch6sc4.rpy:938
translate brazil ch6sc4_c07deab6:

#   ec "It seems Gaia herself has affirmed my faith in you."
    ec "Parece que a própria Gaia confirmou minha fé em você."

# game/chapters/chapter6/ch6sc4.rpy:941
translate brazil ch6sc4_f2d7166d:

#   ec "You're a strong man, a true warrior..."
    ec "Você é um homem forte, um verdadeiro guerreiro..."

# game/chapters/chapter6/ch6sc4.rpy:942
translate brazil ch6sc4_7b6c1d12:

#   ec "You're... worthy."
    ec "Você é... digno(a)."

# game/chapters/chapter6/ch6sc4.rpy:944
translate brazil ch6sc4_2aaf1230:

#   "Your {color=#87e1fa}Charisma{/color} is high enough to make Echo appreciate you, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Seu {color=#87e1fa} Carisma{/color} é alta o suficiente para que Echo te aprecie, a confiança dela aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:945
translate brazil ch6sc4_d93895b6:

#   ec "You're truly a blessing from the goddesses, I believe it so."
    ec "Você é verdadeiramente uma bênção das deusas, eu acredito nisso."

# game/chapters/chapter6/ch6sc4.rpy:947
translate brazil ch6sc4_c5b781a1:

#   "Your {color=#87e1fa}Charisma{/color} wasn't high enough to be further appreciated by Echo."
    "Seu {color=#87e1fa} Carisma{/color} Não estava suficientemente alto para ser melhor apreciado por Echo."

# game/chapters/chapter6/ch6sc4.rpy:950
translate brazil ch6sc4_0ae8c060:

#   ec "[mc]... I have decided."
    ec "[mc]... Eu já me decidi."

# game/chapters/chapter6/ch6sc4.rpy:951
translate brazil ch6sc4_25745d9d:

#   mc "Decided what?"
    mc "Decidiu o quê?"

# game/chapters/chapter6/ch6sc4.rpy:952
translate brazil ch6sc4_bda6bc57:

#   ec "You’ll see... tomorrow."
    ec "Você verá... amanhã."

# game/chapters/chapter6/ch6sc4.rpy:953
translate brazil ch6sc4_ff32cec6:

#   ec "For now, you must go rest and regain your strength."
    ec "Por agora, você precisa descansar e recuperar suas forças."

# game/chapters/chapter6/ch6sc4.rpy:955
translate brazil ch6sc4_587c8083:

#   ec "We’ll meet again at first light tomorrow."
    ec "Nos encontraremos novamente ao amanhecer de amanhã."

# game/chapters/chapter6/ch6sc4.rpy:956
translate brazil ch6sc4_b6031610:

#   ec "Meet me by the main gate."
    ec "Encontre-me no portão principal."

# game/chapters/chapter6/ch6sc4.rpy:957
translate brazil ch6sc4_7c0d68bb:

#   mc "Tomorrow, first light, by the main gate?"
    mc "Amanhã, ao raiar do dia, junto ao portão principal?"

# game/chapters/chapter6/ch6sc4.rpy:959
translate brazil ch6sc4_4eb27e4a:

#   ec "*Nods* I’ll retire to my chambers for the night. You should do the same."
    ec "*Acena com a cabeça* Vou me recolher aos meus aposentos para passar a noite. Você deveria fazer o mesmo."

# game/chapters/chapter6/ch6sc4.rpy:960
translate brazil ch6sc4_0e1c45e0:

#   mc "I will, right after I’ve had some food. Miyo invited Pearl and I to try some of the mushrooms they gathered today."
    mc "Sim, logo depois de comer alguma coisa. Miyo convidou Pearl e eu para experimentar alguns dos cogumelos que colheram hoje."

# game/chapters/chapter6/ch6sc4.rpy:962
translate brazil ch6sc4_6992ad86:

#   ec "Ahh, you’re in for a treat, then."
    ec "Ah, então você vai adorar."

# game/chapters/chapter6/ch6sc4.rpy:963
translate brazil ch6sc4_86dc7814:

#   ec "If she's whipping up her mushrooms glazed in bushberry juices... you'll be salivating for sure. *Giggles*"
    ec "Se ela estiver preparando cogumelos glaceados em suco de amora silvestre... você com certeza vai ficar com água na boca. *Risos*"

# game/chapters/chapter6/ch6sc4.rpy:965
translate brazil ch6sc4_3496f2f3:

#   ec "Despite her young age, Miyo is an excellent cook."
    ec "Apesar de sua pouca idade, Miyo é uma excelente cozinheira."

# game/chapters/chapter6/ch6sc4.rpy:966
translate brazil ch6sc4_d1b87356:

#   ec "Being a herbalist, cooking and knowing the edibles of the jungle is her life's path."
    ec "Ser herbalista, cozinhar e conhecer os alimentos da selva é o caminho que ela trilhou na vida."

# game/chapters/chapter6/ch6sc4.rpy:968
translate brazil ch6sc4_d94345b6:

#   mc "If I wasn’t looking forward to it before, you’ve just sold me."
    mc "Se eu não estava ansioso por isso antes, você acabou de me convencer."

# game/chapters/chapter6/ch6sc4.rpy:970
translate brazil ch6sc4_8d90f81c:

#   ec "*Giggles softly* I do know not your meaning, but... by your expression, it was a positive one."
    ec "*Risinhos suaves* Não sei bem o que você quis dizer, mas... pela sua expressão, foi algo positivo."

# game/chapters/chapter6/ch6sc4.rpy:972
translate brazil ch6sc4_9d661032:

#   mc "Yeah, just means I’m excited and your words have encouraged me."
    mc "Sim, significa apenas que estou animado e suas palavras me encorajaram."

# game/chapters/chapter6/ch6sc4.rpy:974
translate brazil ch6sc4_10f67dcf:

#   ec "Ahh, I see... I’ll see you tomorrow then, Champion."
    ec "Ah, entendi... Então te vejo amanhã, campeão."

# game/chapters/chapter6/ch6sc4.rpy:976
translate brazil ch6sc4_5dc48e04:

#   ec "Goodnight, and may your dreams be pleasant."
    ec "Boa noite, e que seus sonhos sejam agradáveis."

# game/chapters/chapter6/ch6sc4.rpy:977
translate brazil ch6sc4_86cf9243:

#   mc "Goodnight, Echo. May yours be, as well."
    mc "Boa noite, Echo. Que a sua também seja boa noite."

# game/chapters/chapter6/ch6sc4.rpy:982
translate brazil ch6sc4_f08a46e5:

#   "You sit for a few moments after Echo leaves, gathering yourself after today's adventure."
    "Você se senta por alguns instantes depois que Echo vai embora, recompondo-se após a aventura de hoje."

# game/chapters/chapter6/ch6sc4.rpy:987
translate brazil ch6sc4_723d924a:

#   mct "{i}I wonder what she wants to show me so early in the morning?{/i}"
    mct "{i}Fico pensando o que ela quer me mostrar tão cedo pela manhã?{/i}"

# game/chapters/chapter6/ch6sc4.rpy:988
translate brazil ch6sc4_65d0e947:

#   mct "{i}Her voice was a little hesitant, but still filled with excitement.{/i}"
    mct "{i}Sua voz estava um pouco hesitante, mas ainda assim repleta de entusiasmo.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:989
translate brazil ch6sc4_7e55a7b2:

#   mct "{i}I'd guess it's something deeply personal to her.{/i}"
    mct "{i}Imagino que seja algo profundamente pessoal para ela.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:991
translate brazil ch6sc4_0d917713:

#   mct "{i}Now, to find Miyo’s hut...{/i}"
    mct "{i}Agora, vamos encontrar a cabana da Miyo...{/i}"

# game/chapters/chapter6/ch6sc4.rpy:992
translate brazil ch6sc4_3cb35a02:

#   mct "{i}How hard can it be? There’s only a village full of huts to sort through. *Chuckles*{/i}"
    mct "{i}Qual a dificuldade? É só uma aldeia cheia de cabanas para vasculhar. *Risos*{/i}"

# game/chapters/chapter6/ch6sc4.rpy:994
translate brazil ch6sc4_c08b7963:

#   mct "{i}Pearl and Miyo seem to be hitting it off. Granted, Pearl is mainly befriending her to help us get a favorable outcome.{/i}"
    mct "{i}Pearl e Miyo parecem estar se dando bem. Claro, Pearl está se aproximando dela principalmente para nos ajudar a obter um resultado favorável.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:995
translate brazil ch6sc4_02f57f71:

#   mct "{i}Still, maybe Miyo could break down some of Pearl’s walls, and actually become a real friend.{/i}"
    mct "{i}Ainda assim, talvez Miyo pudesse derrubar algumas das barreiras de Pearl e se tornar uma amiga de verdade.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:997
translate brazil ch6sc4_e8ba6f71:

#   mct "{i}If Pearl doesn’t murder her first, that is. *Chuckles*{/i}"
    mct "{i}Se Pearl não a matar primeiro, é claro. *Risos*{/i}"

# game/chapters/chapter6/ch6sc4.rpy:998
translate brazil ch6sc4_6e0b53f2:

#   mct "{i}I'd like to get to know her a little better, as well. She's been very welcoming, and curious about us too.{/i}"
    mct "{i}Eu também gostaria de conhecê-la um pouco melhor. Ela tem sido muito receptiva e também curiosa a nosso respeito.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1000
translate brazil ch6sc4_77c81037:

#   mct "{i}I suppose that’s the benefit of her youth. She would’ve only been an infant during the desecration.{/i}"
    mct "{i}Suponho que essa seja a vantagem de sua juventude. Ela seria apenas um bebê durante a profanação.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1001
translate brazil ch6sc4_f915799b:

#   mct "{i}She hasn't the same reason to harbor ill will towards outsiders, other than from tales of old. She's more open to forming her own opinions.{/i}"
    mct "{i}Ela não tem o mesmo motivo para nutrir rancor contra forasteiros, além das antigas histórias. Ela está mais aberta a formar suas próprias opiniões.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1003
translate brazil ch6sc4_97a8864e:

#   mct "{i}There she is.{/i}"
    mct "{i}Ali está ela.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1004
translate brazil ch6sc4_82b337e6:

#   mct "{i}Luckily she’s standing outside, saves me the trouble of sticking my head into random huts ...{/i}"
    mct "{i}Por sorte, ela está do lado de fora, o que me poupa o trabalho de enfiar a cabeça em cabanas aleatórias...{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1006
translate brazil ch6sc4_8056b90b:

#   mi "..."
    mi "..."

# game/chapters/chapter6/ch6sc4.rpy:1007
translate brazil ch6sc4_67d91a44:

#   mc "Hey, Miyo."
    mc "Ei, Miyo."

# game/chapters/chapter6/ch6sc4.rpy:1009
translate brazil ch6sc4_eb4a99b5:

#   mi "Oh! [mc], you’re early. Hi!"
    mi "Oh! [mc] Você chegou cedo. Oi!"

# game/chapters/chapter6/ch6sc4.rpy:1010
translate brazil ch6sc4_34c67665:

#   mi "I didn’t see you approaching."
    mi "Eu não te vi se aproximando."

# game/chapters/chapter6/ch6sc4.rpy:1011
translate brazil ch6sc4_c319f282:

#   mi "I was just taking a peek at the stars tonight."
    mi "Eu estava apenas dando uma olhada nas estrelas esta noite."

# game/chapters/chapter6/ch6sc4.rpy:1013
translate brazil ch6sc4_8866eae4:

#   mc "See anything interesting up there?"
    mc "Vê alguma coisa interessante lá em cima?"

# game/chapters/chapter6/ch6sc4.rpy:1014
translate brazil ch6sc4_7bd0e502:

#   mc "See any shooting stars?"
    mc "Avistou alguma estrela cadente?"

# game/chapters/chapter6/ch6sc4.rpy:1016
translate brazil ch6sc4_483eb622:

#   mi "Not tonight, but they are beautiful as always."
    mi "Não esta noite, mas elas estão lindas como sempre."

# game/chapters/chapter6/ch6sc4.rpy:1021
translate brazil ch6sc4_7d38ff42:

#   mc "Like you."
    mc "Como você."

# game/chapters/chapter6/ch6sc4.rpy:1023
translate brazil ch6sc4_cbf2f1b4:

#   mi "Oh? Ohh... you... think I’m beautiful?"
    mi "Ah? Ahh... você... acha que eu sou bonita?"

# game/chapters/chapter6/ch6sc4.rpy:1024
translate brazil ch6sc4_2f068911:

#   mc "I do."
    mc "Eu faço."

# game/chapters/chapter6/ch6sc4.rpy:1027
translate brazil ch6sc4_aea471e7:

#   mi "T-Thank you, you’re beautiful too."
    mi "O-Obrigada, você também é linda."

# game/chapters/chapter6/ch6sc4.rpy:1028
translate brazil ch6sc4_d4aadd3f:

#   "Miyo is pleasantly surprised by your compliment, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Miyo ficou agradavelmente surpresa com seu elogio, e sua confiança aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:1029
translate brazil ch6sc4_ec1cee4b:

#   mi "It's nice being... noticed, especially by you."
    mi "É bom ser... notado, especialmente por você."

# game/chapters/chapter6/ch6sc4.rpy:1031
translate brazil ch6sc4_c83e3059:

#   "You managed to successfully charm Miyo, your {b}{color=#87e1fa}Charisma{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguiu encantar Miyo com sucesso, sua {b}{color=#87e1fa}Carisma{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:1035
translate brazil ch6sc4_adca0187:

#   mc "I always liked looking upon the night sky."
    mc "Eu sempre gostei de contemplar o céu noturno."

# game/chapters/chapter6/ch6sc4.rpy:1036
translate brazil ch6sc4_068e686e:

#   mi "Me too... it is such a calming feeling."
    mi "Eu também... é uma sensação tão calmante."

# game/chapters/chapter6/ch6sc4.rpy:1040
translate brazil ch6sc4_1caf0f0e:

#   mi "So, what brings you to my hut?"
    mi "Então, o que te traz à minha cabana?"

# game/chapters/chapter6/ch6sc4.rpy:1042
translate brazil ch6sc4_1c2a387f:

#   mc "I thought I was invited. For mushrooms? Something about them being covered in berry juice?"
    mc "Pensei que tinha sido convidado. Para comer cogumelos? Algo sobre eles estarem cobertos com suco de frutas vermelhas?"

# game/chapters/chapter6/ch6sc4.rpy:1043
translate brazil ch6sc4_a19ca4fe:

#   mi "Mushrooms, you say? Hmh... No. Doesn’t ring a bell."
    mi "Cogumelos, você disse? Hum... Não. Não me vem nada à mente."

# game/chapters/chapter6/ch6sc4.rpy:1045
translate brazil ch6sc4_e4e2c444:

#   mc "Please tell me I wasn’t imagining it? I’m starving..."
    mc "Por favor, me diga que eu não estava imaginando coisas? Estou morrendo de fome..."

# game/chapters/chapter6/ch6sc4.rpy:1046
translate brazil ch6sc4_393481ec:

#   mi "Hmmmmh..."
    mi "Hummm..."

# game/chapters/chapter6/ch6sc4.rpy:1048
translate brazil ch6sc4_3e05c69a:

#   mi "*Laughs* Kidding!"
    mi "*Risos* Brincadeirinha!"

# game/chapters/chapter6/ch6sc4.rpy:1049
translate brazil ch6sc4_eb1001b9:

#   mi "I was just teasing you, the mushrooms are stewing as we speak."
    mi "Eu estava só brincando, os cogumelos estão cozinhando neste exato momento."

# game/chapters/chapter6/ch6sc4.rpy:1051
translate brazil ch6sc4_f52b4b6b:

#   mi "Come, let’s go inside. It’s getting a little chilly out here."
    mi "Venha, vamos entrar. Está ficando um pouco frio aqui fora."

# game/chapters/chapter6/ch6sc4.rpy:1052
translate brazil ch6sc4_7fff7447:

#   mct "{i}The little minx... *Chuckles*{/i}"
    mct "{i}A pequena pestinha... *Risos*{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1053
translate brazil ch6sc4_90275fd3:

#   mi "Pearl isn't here yet, so it'll just be the two of us for now."
    mi "Pearl ainda não chegou, então seremos só nós duas por enquanto."

# game/chapters/chapter6/ch6sc4.rpy:1055
translate brazil ch6sc4_b174a70c:

#   mc "I’m going to get you back for this..."
    mc "Vou me vingar disso..."

# game/chapters/chapter6/ch6sc4.rpy:1057
translate brazil ch6sc4_0d759942:

#   mi "*Whispers* Oh yeah? What will you do to me?"
    mi "*Sussurrando* Ah, é? O que você vai fazer comigo?"

# game/chapters/chapter6/ch6sc4.rpy:1058
translate brazil ch6sc4_6c2bd4f8:

#   mi "*Whispers* Champion."
    mi "*Sussurra* Campeão."

# game/chapters/chapter6/ch6sc4.rpy:1060
translate brazil ch6sc4_a19aeffa:

#   mc "Wouldn’t you like to know?"
    mc "Você não gostaria de saber?"

# game/chapters/chapter6/ch6sc4.rpy:1062
translate brazil ch6sc4_0cbf5188:

#   mi "*Giggles* Maybe I’ll find out inside?"
    mi "*Risos* Talvez eu descubra lá dentro?"

# game/chapters/chapter6/ch6sc4.rpy:1064
translate brazil ch6sc4_ee3f3827:

#   mc "Maybe you will... I look forward to seeing how you live."
    mc "Talvez você consiga... Estou ansioso para ver como você vai viver."

# game/chapters/chapter6/ch6sc4.rpy:1065
translate brazil ch6sc4_ffc3ce53:

#   mi "*Giggles softly* ..."
    mi "*Ri baixinho* ..."

# game/chapters/chapter6/ch6sc4.rpy:1070
translate brazil ch6sc4_8cd1fad6:

#   "The two of you head inside her hut. Miyo proceeds to sit down on her bed."
    "Vocês duas entram na cabana dela. Miyo se senta na cama."

# game/chapters/chapter6/ch6sc4.rpy:1074
translate brazil ch6sc4_d35822fc:

#   mi "I didn’t expect you to stop by so soon..."
    mi "Não esperava que você aparecesse tão cedo..."

# game/chapters/chapter6/ch6sc4.rpy:1075
translate brazil ch6sc4_c425ebf0:

#   mi "I thought you'd come with Pearl, after her bath."
    mi "Pensei que você viria com a Pearl depois do banho dela."

# game/chapters/chapter6/ch6sc4.rpy:1077
translate brazil ch6sc4_a1ef0f09:

#   mi "What made you decide to come on your own?"
    mi "O que te levou a decidir vir por conta própria?"

# game/chapters/chapter6/ch6sc4.rpy:1079
translate brazil ch6sc4_2bef80c6:

#   mc "*Chuckles* What?"
    mc "*Risos* O quê?"

# game/chapters/chapter6/ch6sc4.rpy:1080
translate brazil ch6sc4_ba7b6f69:

#   mc "Aren't I allowed to visit you without Pearl as my chaperone?"
    mc "Não posso visitá-la sem a Pearl como minha acompanhante?"

# game/chapters/chapter6/ch6sc4.rpy:1082
translate brazil ch6sc4_d1a61ad2:

#   mi "T-That’s not what I’m saying! Not at all."
    mi "N-Não é isso que estou dizendo! De jeito nenhum."

# game/chapters/chapter6/ch6sc4.rpy:1083
translate brazil ch6sc4_419c92a6:

#   mi "It both surprises and pleases me that you wanted to see me. Just me."
    mi "Fico surpresa e feliz ao mesmo tempo que você tenha querido me ver. Só a mim."

# game/chapters/chapter6/ch6sc4.rpy:1084
translate brazil ch6sc4_2621a11b:

#   mi "Please, Hero... sit with me?"
    mi "Por favor, Herói... sente-se comigo?"

# game/chapters/chapter6/ch6sc4.rpy:1086
translate brazil ch6sc4_cdb7c25b:

#   mc "It pleases you that I came on my own?"
    mc "Você se alegra que eu tenha vindo sozinha?"

# game/chapters/chapter6/ch6sc4.rpy:1087
translate brazil ch6sc4_6563c1f2:

#   mi "*Nods* Mh-hm."
    mi "*Acena com a cabeça* Hum-hum."

# game/chapters/chapter6/ch6sc4.rpy:1089
translate brazil ch6sc4_4c84b846:

#   mi "Greatly so, even."
    mi "Extremamente, inclusive."

# game/chapters/chapter6/ch6sc4.rpy:1090
translate brazil ch6sc4_e1bb63b1:

#   mi "That is why I am curious why you sought me out."
    mi "Por isso, estou curioso para saber por que você me procurou."

# game/chapters/chapter6/ch6sc4.rpy:1092
translate brazil ch6sc4_0bf7d0df:

#   mi "W-Was it because... you were bored?"
    mi "Q-Foi porque... você estava entediado(a)?"

# game/chapters/chapter6/ch6sc4.rpy:1093
translate brazil ch6sc4_a9350466:

#   mi "Or... did you really want to see me?"
    mi "Ou... você realmente queria me ver?"

# game/chapters/chapter6/ch6sc4.rpy:1095
translate brazil ch6sc4_677af78f:

#   mc "I came to see you, believe it or not. I’d like to get to know you better."
    mc "Acredite ou não, vim para te ver. Gostaria de te conhecer melhor."

# game/chapters/chapter6/ch6sc4.rpy:1097
translate brazil ch6sc4_4fcc8674:

#   mi "*Gasps* Y-You would?!"
    mi "*Suspira* V-Você faria isso?!"

# game/chapters/chapter6/ch6sc4.rpy:1098
translate brazil ch6sc4_2af172bb:

#   mi "Truly so?!"
    mi "É mesmo?!"

# game/chapters/chapter6/ch6sc4.rpy:1100
translate brazil ch6sc4_87867e19:

#   mi "I mean- great! I share the meaning of your words!"
    mi "Quer dizer, ótimo! Compartilho do significado das suas palavras!"

# game/chapters/chapter6/ch6sc4.rpy:1101
translate brazil ch6sc4_604ac87a:

#   mi "I... want to know you better too, Champion."
    mi "Eu... também quero te conhecer melhor, Campeão."

# game/chapters/chapter6/ch6sc4.rpy:1103
translate brazil ch6sc4_05687b96:

#   mc "Why don’t you start by telling me how your day with us in the jungle was?"
    mc "Por que você não começa me contando como foi o seu dia conosco na selva?"

# game/chapters/chapter6/ch6sc4.rpy:1104
translate brazil ch6sc4_c7614acc:

#   mc "Were you doing okay at the shrine, with the mist and all?"
    mc "Você estava bem no santuário, com a névoa e tudo mais?"

# game/chapters/chapter6/ch6sc4.rpy:1106
translate brazil ch6sc4_b6fa1364:

#   mi "Ohh, y-yeah... it was a little scary at first. This was actually my first encounter with it."
    mi "Ah, sim... foi um pouco assustador no começo. Na verdade, esse foi meu primeiro contato com isso."

# game/chapters/chapter6/ch6sc4.rpy:1107
translate brazil ch6sc4_94f01551:

#   mi "I've never been that far from A’nai before, and the mist doesn’t usually come close to the village."
    mi "Nunca estive tão longe de A'nai antes, e a neblina geralmente não chega perto da vila."

# game/chapters/chapter6/ch6sc4.rpy:1109
translate brazil ch6sc4_8f999883:

#   mi "But I felt reassured having Suji and Zyra with us. They are our top Huntresses."
    mi "Mas me senti mais tranquila por ter Suji e Zyra conosco. Elas são nossas melhores Caçadoras."

# game/chapters/chapter6/ch6sc4.rpy:1110
translate brazil ch6sc4_22ef369c:

#   mi "And having you and Pearl there as well, really helped give me some peace of mind."
    mi "E ter você e a Pearl lá também me ajudou muito a ficar mais tranquila."

# game/chapters/chapter6/ch6sc4.rpy:1112
translate brazil ch6sc4_b82ba7e9:

#   mi "I had a great time foraging with Pearl. She seemed genuinely happy to learn about the plants we gathered."
    mi "Eu me diverti muito coletando plantas com a Pearl. Ela pareceu genuinamente feliz em aprender sobre as plantas que coletamos."

# game/chapters/chapter6/ch6sc4.rpy:1114
translate brazil ch6sc4_df1797af:

#   mc "I’m glad the two of you have become friends so quickly."
    mc "Fico feliz que vocês dois tenham se tornado amigos tão rapidamente."

# game/chapters/chapter6/ch6sc4.rpy:1116
translate brazil ch6sc4_bac76ec2:

#   mi "Me too. She is so kind to me."
    mi "Eu também. Ela é muito gentil comigo."

# game/chapters/chapter6/ch6sc4.rpy:1118
translate brazil ch6sc4_15146d74:

#   mi "It’s not always easy to be one of the youngest in the tribe..."
    mi "Nem sempre é fácil ser um dos mais jovens da tribo..."

# game/chapters/chapter6/ch6sc4.rpy:1119
translate brazil ch6sc4_56959e27:

#   mi "But it’s been so easy to talk to Pearl about anything."
    mi "Mas tem sido muito fácil conversar com Pearl sobre qualquer coisa."

# game/chapters/chapter6/ch6sc4.rpy:1121
translate brazil ch6sc4_4eb53631:

#   mi "She speaks highly of you."
    mi "Ela fala muito bem de você."

# game/chapters/chapter6/ch6sc4.rpy:1123
translate brazil ch6sc4_c7261b18:

#   mc "Does she now?"
    mc "Será mesmo?"

# game/chapters/chapter6/ch6sc4.rpy:1125
translate brazil ch6sc4_ba10364d:

#   mi "Yes, she can’t help herself... she has told me about many of your great deeds."
    mi "Sim, ela não consegue se conter... ela me contou sobre muitas das suas grandes façanhas."

# game/chapters/chapter6/ch6sc4.rpy:1126
translate brazil ch6sc4_8d5be35c:

#   mi "In fact..."
    mi "Na verdade..."

# game/chapters/chapter6/ch6sc4.rpy:1128
translate brazil ch6sc4_95e83702:

#   mi "She has stirred my curiosity about you."
    mi "Ela despertou minha curiosidade a seu respeito."

# game/chapters/chapter6/ch6sc4.rpy:1130
translate brazil ch6sc4_77412db9:

#   mi "Which is why it pleases me that you came by on your own."
    mi "Por isso, fico feliz que você tenha vindo por conta própria."

# game/chapters/chapter6/ch6sc4.rpy:1132
translate brazil ch6sc4_0482ffa2:

#   mi "So we could get to know each other..."
    mi "Para que pudéssemos nos conhecer melhor..."

# game/chapters/chapter6/ch6sc4.rpy:1134
translate brazil ch6sc4_61a96352:

#   mi "Intimately."
    mi "Intimamente."

# game/chapters/chapter6/ch6sc4.rpy:1136
translate brazil ch6sc4_1e1cdffc:

#   mc "I've always felt you get to know a person best by being alone together."
    mc "Sempre achei que a melhor maneira de conhecer uma pessoa é estando a sós com ela."

# game/chapters/chapter6/ch6sc4.rpy:1137
translate brazil ch6sc4_c70fb4d4:

#   mc "I appreciate you being so welcoming to us. Right from the start, you seemed eager to meet us."
    mc "Agradeço a forma como nos receberam. Desde o início, vocês pareceram ansiosos para nos conhecer."

# game/chapters/chapter6/ch6sc4.rpy:1139
translate brazil ch6sc4_737a26e6:

#   mi "Is it so strange to be kind and open amongst outsiders?"
    mi "Será tão estranho ser gentil e receptivo com pessoas de fora?"

# game/chapters/chapter6/ch6sc4.rpy:1141
translate brazil ch6sc4_771568ef:

#   mc "I wouldn’t say strange, but people are usually a little more guarded."
    mc "Eu não diria estranho, mas as pessoas geralmente ficam um pouco mais na defensiva."

# game/chapters/chapter6/ch6sc4.rpy:1143
translate brazil ch6sc4_2573635c:

#   mi "That is a shame... I'm glad to have met you here, then."
    mi "Que pena... Fico feliz por ter te conhecido aqui, então."

# game/chapters/chapter6/ch6sc4.rpy:1145
translate brazil ch6sc4_b62f31ef:

#   mi "I believe kindness is important."
    mi "Acredito que a gentileza é importante."

# game/chapters/chapter6/ch6sc4.rpy:1146
translate brazil ch6sc4_7773f4bf:

#   mi "If we all strive to be kind towards each other, I see no reason for the mistakes of the past to repeat."
    mi "Se todos nos esforçarmos para sermos gentis uns com os outros, não vejo razão para que os erros do passado se repitam."

# game/chapters/chapter6/ch6sc4.rpy:1147
translate brazil ch6sc4_a34dc379:

#   mct "{i}I can see why she’d think that way, she’s been shielded in the tribe her entire life.{/i}"
    mct "{i}Eu consigo entender por que ela pensaria dessa forma, ela foi protegida na tribo durante toda a sua vida.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1148
translate brazil ch6sc4_a5338cb9:

#   mct "{i}It might be a little naive, but it’s also refreshing to meet someone filled with untainted kindness like Miyo.{/i}"
    mct "{i}Pode parecer um pouco ingênuo, mas também é revigorante conhecer alguém com uma bondade genuína como a Miyo.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1150
translate brazil ch6sc4_b3e7b99f:

#   mi "You are very handsome."
    mi "Você é muito bonito."

# game/chapters/chapter6/ch6sc4.rpy:1151
translate brazil ch6sc4_889f837e:

#   mi "My eyes seem to gravitate towards you whenever you're in my vicinity."
    mi "Meus olhos parecem ser atraídos por você sempre que você está por perto."

# game/chapters/chapter6/ch6sc4.rpy:1153
translate brazil ch6sc4_b9a14589:

#   mc "*Chuckles* Thank you, Miyo."
    mc "*Risos* Obrigada, Miyo."

# game/chapters/chapter6/ch6sc4.rpy:1154
translate brazil ch6sc4_2ae80aa7:

#   mc "You’re quite a beautiful young lady yourself."
    mc "Você também é uma jovem muito bonita."

# game/chapters/chapter6/ch6sc4.rpy:1156
translate brazil ch6sc4_4e31d799:

#   mi "*Giggles lightly* Oh? I’m beautiful?"
    mi "*Risinhos suaves* Ah? Eu sou bonita?"

# game/chapters/chapter6/ch6sc4.rpy:1158
translate brazil ch6sc4_fa4a392d:

#   mc "Stop fishing for compliments, yes... you’re beautiful."
    mc "Pare de buscar elogios, sim... você é linda."

# game/chapters/chapter6/ch6sc4.rpy:1160
translate brazil ch6sc4_f6e77096:

#   mi "*Snickers* ..."
    mi "*Snickers* ..."

# game/chapters/chapter6/ch6sc4.rpy:1162
translate brazil ch6sc4_747b005c:

#   mi "You were very heroic today..."
    mi "Você foi muito heroico hoje..."

# game/chapters/chapter6/ch6sc4.rpy:1163
translate brazil ch6sc4_348f1898:

#   mi "When you saved me from falling."
    mi "Quando você me impediu de cair."

# game/chapters/chapter6/ch6sc4.rpy:1165
translate brazil ch6sc4_79aa5f3f:

#   mi "I felt things..."
    mi "Eu senti coisas..."

# game/chapters/chapter6/ch6sc4.rpy:1166
translate brazil ch6sc4_0a82f2cc:

#   mi "When you were holding me... weird things..."
    mi "Quando você me abraçava... coisas estranhas..."

# game/chapters/chapter6/ch6sc4.rpy:1168
translate brazil ch6sc4_a3e0603e:

#   mi "Things I normally only feel when I'm alone and... excited."
    mi "Coisas que normalmente só sinto quando estou sozinha e... animada."

# game/chapters/chapter6/ch6sc4.rpy:1170
translate brazil ch6sc4_5e3388a3:

#   mi "But today I wasn’t alone."
    mi "Mas hoje eu não estava sozinho."

# game/chapters/chapter6/ch6sc4.rpy:1171
translate brazil ch6sc4_2cca7503:

#   mi "I was with you, in your arms."
    mi "Eu estava com você, em seus braços."

# game/chapters/chapter6/ch6sc4.rpy:1173
translate brazil ch6sc4_65496ae1:

#   mc "I’m just glad I was able to catch you."
    mc "Fico feliz por ter conseguido te encontrar."

# game/chapters/chapter6/ch6sc4.rpy:1174
translate brazil ch6sc4_b1a4fc18:

#   mc "A fall like that would’ve hurt."
    mc "Uma queda daquelas teria doído."

# game/chapters/chapter6/ch6sc4.rpy:1176
translate brazil ch6sc4_d1314109:

#   mi "You know, from what I understand from our ancestors, and the etchings they left on walls and slates..."
    mi "Sabe, pelo que entendi dos nossos antepassados ​​e das inscrições que deixaram nas paredes e nas placas de ardósia..."

# game/chapters/chapter6/ch6sc4.rpy:1178
translate brazil ch6sc4_ddd1cbcf:

#   mi "A man and woman, they are... meant for each other."
    mi "Um homem e uma mulher, eles são... feitos um para o outro."

# game/chapters/chapter6/ch6sc4.rpy:1179
translate brazil ch6sc4_00837c46:

#   mi "There are many depictions of them... together."
    mi "Existem muitas representações deles... juntos."

# game/chapters/chapter6/ch6sc4.rpy:1180
translate brazil ch6sc4_4adea590:

#   mi "Doing... interesting things."
    mi "Fazendo coisas... interessantes."

# game/chapters/chapter6/ch6sc4.rpy:1182
translate brazil ch6sc4_0ac94c94:

#   mi "Things that have made me... curious"
    mi "Coisas que me deixaram... curioso"

# game/chapters/chapter6/ch6sc4.rpy:1184
translate brazil ch6sc4_1241a8ed:

#   mi "When I asked our elders about it, they say the A’khan will... that he will mate with the tribe."
    mi "Quando perguntei aos nossos anciãos sobre isso, eles disseram que o A'khan irá... que ele irá se acasalar com a tribo."

# game/chapters/chapter6/ch6sc4.rpy:1185
translate brazil ch6sc4_ba81c0db:

#   mi "He will take the A’nu as his bride, but that his desire runs too powerfully and deep, and he will need to share it with the tribe."
    mi "Ele tomará A'nu como sua esposa, mas seu desejo é tão forte e profundo que precisará compartilhá-lo com a tribo."

# game/chapters/chapter6/ch6sc4.rpy:1186
translate brazil ch6sc4_c0036c2f:

#   mi "Everyone... will become his."
    mi "Todos... se tornarão dele."

# game/chapters/chapter6/ch6sc4.rpy:1187
translate brazil ch6sc4_52aaf808:

#   mct "{i}This A’khan thing is getting more and more appealing...{/i}"
    mct "{i}Essa história do A'khan está ficando cada vez mais interessante...{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1189
translate brazil ch6sc4_67e25bfe:

#   mi "A curious thought..."
    mi "Um pensamento curioso..."

# game/chapters/chapter6/ch6sc4.rpy:1190
translate brazil ch6sc4_de21bc06:

#   mi "They say the A’khan will choose whoever, whenever, wherever it pleases him."
    mi "Dizem que o A'khan escolherá quem quiser, quando quiser e onde quiser."

# game/chapters/chapter6/ch6sc4.rpy:1191
translate brazil ch6sc4_4902d087:

#   mi "And that the women will be eager to be chosen to fulfill his desires."
    mi "E que as mulheres estarão ansiosas para serem escolhidas para satisfazer seus desejos."

# game/chapters/chapter6/ch6sc4.rpy:1193
translate brazil ch6sc4_c36d0a25:

#   mi "You’re already on that path. You've completed two of the four trials..."
    mi "Você já está nesse caminho. Você completou duas das quatro provas..."

# game/chapters/chapter6/ch6sc4.rpy:1194
translate brazil ch6sc4_44efcde5:

#   mi "You've met a goddess, and even been named as her champion."
    mi "Você conheceu uma deusa e até foi nomeado seu campeão."

# game/chapters/chapter6/ch6sc4.rpy:1196
translate brazil ch6sc4_051096a4:

#   mi "Such a thing has never occurred in the history of my people."
    mi "Tal coisa jamais ocorreu na história do meu povo."

# game/chapters/chapter6/ch6sc4.rpy:1198
translate brazil ch6sc4_70b2a63a:

#   mc "Things have certainly been eventful since I arrived on Aruna."
    mc "As coisas certamente têm sido agitadas desde que cheguei a Aruna."

# game/chapters/chapter6/ch6sc4.rpy:1200
translate brazil ch6sc4_8c8a3fc2:

#   mi "I believe there’s a good reason for that."
    mi "Acredito que haja um bom motivo para isso."

# game/chapters/chapter6/ch6sc4.rpy:1202
translate brazil ch6sc4_7af02aa0:

#   mi "Just like... I believe there’s a good reason you came to see me... alone."
    mi "Assim como... acredito que haja um bom motivo para você ter vindo me ver... sozinha."

# game/chapters/chapter6/ch6sc4.rpy:1209
translate brazil ch6sc4_710c139d:

#   mct "I guess I am on the path of becoming their A’khan."
    mct "Acho que estou no caminho para me tornar o A'khan deles."

# game/chapters/chapter6/ch6sc4.rpy:1210
translate brazil ch6sc4_55173e6c:

#   mct "Why not enjoy the benefits a little early? Besides... she's incredibly attractive."
    mct "Por que não aproveitar os benefícios um pouco mais cedo? Além disso... ela é incrivelmente atraente."

# game/chapters/chapter6/ch6sc4.rpy:1212
translate brazil ch6sc4_1762fad6:

#   mi "*Sensual* I hoped this would be your choice."
    mi "*Sensual* Eu esperava que essa fosse a sua escolha."

# game/chapters/chapter6/ch6sc4.rpy:1214
translate brazil ch6sc4_c994e932:

#   "Miyo is pleased you're feeling the same way as her, her trust has increased by {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."
    "Miyo está feliz por você sentir o mesmo que ela, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:1216
translate brazil ch6sc4_b11c3545:

#   mi "*Sensual* Champion.. taste me."
    mi "Campeã *Sensual*... prove-me."

# game/chapters/chapter6/ch6sc4.rpy:1219
translate brazil ch6sc4_f0349608:

#   pl "Aaah... I can smell the mushrooms! My mouth is watering already."
    pl "Ahhh... consigo sentir o cheiro dos cogumelos! Minha boca já está salivando."

# game/chapters/chapter6/ch6sc4.rpy:1220
translate brazil ch6sc4_2fda86c0:

#   mi "!!!!!!!!!!!"
    mi "!!!!!!!!!!"

# game/chapters/chapter6/ch6sc4.rpy:1224
translate brazil ch6sc4_2c1fc0ba:

#   mc "Sorry, Miyo. I don’t know you well enough at this point."
    mc "Desculpe, Miyo. Eu ainda não te conheço bem o suficiente."

# game/chapters/chapter6/ch6sc4.rpy:1226
translate brazil ch6sc4_a2d53e4e:

#   mi "I-I understand..."
    mi "Eu entendo..."

# game/chapters/chapter6/ch6sc4.rpy:1227
translate brazil ch6sc4_62d4422c:

#   "Miyo feels rejected being denied her first kiss, her trust has decreased by {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."
    "Miyo sente-se rejeitada por lhe terem negado o primeiro beijo, e a sua confiança diminuiu. {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc4.rpy:1229
translate brazil ch6sc4_46b749aa:

#   mi "I like you, and I wanted to make it known, sorry!"
    mi "Eu gosto de você e queria deixar isso claro, desculpe!"

# game/chapters/chapter6/ch6sc4.rpy:1231
translate brazil ch6sc4_7323d4c2:

#   mc "I’m glad you did. That takes courage."
    mc "Que bom que você fez isso. É preciso coragem."

# game/chapters/chapter6/ch6sc4.rpy:1232
translate brazil ch6sc4_d9e2dfdb:

#   mc "Let’s just get to know each other better first, and then we’ll see. Deal?"
    mc "Vamos nos conhecer melhor primeiro, e depois vemos o que acontece. Combinado?"

# game/chapters/chapter6/ch6sc4.rpy:1235
translate brazil ch6sc4_9e4e02f6:

#   mi "Deal!"
    mi "Negócio!"

# game/chapters/chapter6/ch6sc4.rpy:1237
translate brazil ch6sc4_fe7105f4:

#   mi "That’s a relief, I feared you'd be upset with me."
    mi "Que alívio, eu temia que você ficasse chateado comigo."

# game/chapters/chapter6/ch6sc4.rpy:1238
translate brazil ch6sc4_d4589057:

#   mi "I look forward to getting to know you better, then."
    mi "Espero poder conhecê-lo(a) melhor, então."

# game/chapters/chapter6/ch6sc4.rpy:1241
translate brazil ch6sc4_083d73fc:

#   pl "Hnnngh!"
    pl "Hnnngh!"

# game/chapters/chapter6/ch6sc4.rpy:1243
translate brazil ch6sc4_ed90f628:

#   pl "Oh, [mc]? You got here earlier than I expected."
    pl "Oh, [mc] Você chegou mais cedo do que eu esperava."

# game/chapters/chapter6/ch6sc4.rpy:1245
translate brazil ch6sc4_31b40b3f:

#   mi "Pearl! Finally, the stew is just about ready!"
    mi "Pérola! Finalmente, o ensopado está quase pronto!"

# game/chapters/chapter6/ch6sc4.rpy:1247
translate brazil ch6sc4_14a9d3b3:

#   mi "Come. You too, [mc]. You’re both in for a treat!"
    mi "Venha. Você também. [mc] Vocês dois vão adorar!"

# game/chapters/chapter6/ch6sc4.rpy:1248
translate brazil ch6sc4_c310823d:

#   mc "Sounds great. I’m famished."
    mc "Parece ótimo. Estou faminto."

# game/chapters/chapter6/ch6sc4.rpy:1253
translate brazil ch6sc4_0ae8076e:

#   "The three of you sit down by the cooking fire and Miyo pours a bowl for each of you."
    "Vocês três se sentam perto da fogueira e Miyo serve uma tigela para cada um de vocês."

# game/chapters/chapter6/ch6sc4.rpy:1257
translate brazil ch6sc4_b3394b6b:

#   mi "Afi, appetito! Enjoy!"
    mi "Afi, bom apetite! Aproveite!"

# game/chapters/chapter6/ch6sc4.rpy:1258
translate brazil ch6sc4_e637834f:

#   pl "*Slurps* Yum! Yum, yum, yummy-yum!"
    pl "*Sorve* Hum! Hum, hum, que delícia!"

# game/chapters/chapter6/ch6sc4.rpy:1259
translate brazil ch6sc4_1efa5910:

#   mc "This is incredible, Miyo. Echo was right, you’re an excellent cook."
    mc "Isso é incrível, Miyo. Echo tinha razão, você cozinha muito bem."

# game/chapters/chapter6/ch6sc4.rpy:1260
translate brazil ch6sc4_62f2e7ed:

#   mi "*Laughs lightly* Guys... you’re exaggerating! I’m average at best."
    mi "*Risos discretos* Gente... vocês estão exagerando! Eu sou, no máximo, mediana."

# game/chapters/chapter6/ch6sc4.rpy:1262
translate brazil ch6sc4_4011a427:

#   mc "No, we’re not. It’s delicious and very filling, well-seasoned too."
    mc "Não, não estamos. É delicioso, muito substancioso e bem temperado."

# game/chapters/chapter6/ch6sc4.rpy:1263
translate brazil ch6sc4_476f96a7:

#   mi "[mc]... t-thank you. I’m glad my cooking pleases you."
    mi "[mc]... O-obrigado. Fico feliz que minha comida lhe agrade."

# game/chapters/chapter6/ch6sc4.rpy:1264
translate brazil ch6sc4_600d1cad:

#   pl "*Slurps* Mmmh! So good! Can we have more?"
    pl "*Sorve* Hum! Que delícia! Podemos ter mais?"

# game/chapters/chapter6/ch6sc4.rpy:1266
translate brazil ch6sc4_a67ca0a3:

#   mi "Please! Dig in! I made this stew for the three of us, so you needn’t hesitate."
    mi "Por favor! Sirva-se! Fiz este ensopado para nós três, então não precisa hesitar."

# game/chapters/chapter6/ch6sc4.rpy:1267
translate brazil ch6sc4_d6c0c8a8:

