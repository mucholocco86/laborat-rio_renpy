# game/chapters/chapter6/ch6sc4.rpy:1884
translate brazil ch6sc4_3c383d80:

#   mct "{i}I suppose word is spreading about the trials.{/i}"
    mct "{i}Imagino que a notícia sobre os julgamentos esteja se espalhando.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1886
translate brazil ch6sc4_1d074da3:

#   tai "Mmh! Looking handsome today, champion!"
    tai "Hum! Você está muito bonito hoje, campeão!"

# game/chapters/chapter6/ch6sc4.rpy:1887
translate brazil ch6sc4_d8b537f0:

#   mct "{i}How did I land in this tribe of beautiful women again?{/i}"
    mct "{i}Como é que eu fui parar nessa tribo de mulheres lindas de novo?{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1888
translate brazil ch6sc4_1e0c8ce5:

#   mct "{i}Not to mention, Echo... A beauty like hers is seldom seen on the mainland.{/i}"
    mct "{i}Sem falar em Echo... Uma beleza como a dela raramente se vê no continente.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1889
translate brazil ch6sc4_abf269ab:

#   mct "{i}And she actually has a kind heart. She can be fierce when needed, but she is mostly gentle.{/i}"
    mct "{i}E ela realmente tem um bom coração. Ela pode ser feroz quando necessário, mas na maior parte do tempo é gentil.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1890
translate brazil ch6sc4_159d150a:

#   mct "{i}If she wants to share something personal with me today, she’ll have my full attention.{/i}"
    mct "{i}Se ela quiser compartilhar algo pessoal comigo hoje, terá toda a minha atenção.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1892
translate brazil ch6sc4_d75e6886:

#   mct "Thankfully, I haven’t seen that witch Marah again."
    mct "Ainda bem que não vi aquela bruxa da Marah novamente."

# game/chapters/chapter6/ch6sc4.rpy:1893
translate brazil ch6sc4_5060becb:

#   mct "But... I'm not so naive to think she’s given up."
    mct "Mas... não sou tão ingênuo a ponto de achar que ela desistiu."

# game/chapters/chapter6/ch6sc4.rpy:1894
translate brazil ch6sc4_cd0de5d7:

#   mct "{i}I suspect she’ll attempt to get rid of me again.{/i}"
    mct "{i}Suspeito que ela tentará se livrar de mim novamente.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1896
translate brazil ch6sc4_d148c793:

#   mct "{i}But she’ll come to learn that I’m not so easily bested.{/i}"
    mct "{i}Mas ela acabará por aprender que não sou tão fácil de derrotar.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1897
translate brazil ch6sc4_3223ca41:

#   mct "Hopefully Echo isn’t easily thwarted, either."
    mct "Esperemos que Echo também não seja facilmente derrotada."

# game/chapters/chapter6/ch6sc4.rpy:1898
translate brazil ch6sc4_dc0a14eb:

#   mct "It must be difficult to have one of her highest ranking advisors go against her."
    mct "Deve ser difícil para ela ver um de seus conselheiros de maior destaque se voltar contra ela."

# game/chapters/chapter6/ch6sc4.rpy:1900
translate brazil ch6sc4_0d704110:

#   mct "{i}I just hope she remains strong in her convictions.{/i}"
    mct "{i}Só espero que ela se mantenha firme em suas convicções.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1901
translate brazil ch6sc4_1eaf1918:

#   mct "She’s already put her neck on the line for me."
    mct "Ela já se arriscou por mim."

# game/chapters/chapter6/ch6sc4.rpy:1902
translate brazil ch6sc4_d16dbef6:

#   mct "I’ll be doing the same for her, should it come to that."
    mct "Farei o mesmo por ela, se for preciso."

# game/chapters/chapter6/ch6sc4.rpy:1904
translate brazil ch6sc4_5f79227a:

#   mct "{i}She’s already here. I hope I didn’t keep her waiting too long.{/i}"
    mct "{i}Ela já está aqui. Espero não tê-la feito esperar muito tempo.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1906
translate brazil ch6sc4_913aed3c:

#   mct "{i}She may only be human, but there's no denying...{/i}"
    mct "{i}Ela pode ser apenas humana, mas não há como negar...{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1907
translate brazil ch6sc4_50680b82:

#   mct "{i}She’s sculpted like a Goddess.{/i}"
    mct "{i}Ela tem o corpo esculpido como uma deusa.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:1910
translate brazil ch6sc4_67b4960e:

#   ec "Good morning to you."
    ec "Bom dia para você."

# game/chapters/chapter6/ch6sc4.rpy:1912
translate brazil ch6sc4_2f3bcb68:

#   mc "Good morning to you too, Echo."
    mc "Bom dia para você também, Echo."

# game/chapters/chapter6/ch6sc4.rpy:1913
translate brazil ch6sc4_5b20878b:

#   mc "Did you get a good night's sleep?"
    mc "Você dormiu bem esta noite?"

# game/chapters/chapter6/ch6sc4.rpy:1915
translate brazil ch6sc4_c32ddb55:

#   ec "So, so... I was a little restless, to be truthful with you."
    ec "Então, então... Para ser sincera, eu estava um pouco inquieta."

# game/chapters/chapter6/ch6sc4.rpy:1917
translate brazil ch6sc4_c38231a8:

#   mc "Oh? Was something the matter?"
    mc "Ah? Aconteceu alguma coisa?"

# game/chapters/chapter6/ch6sc4.rpy:1919
translate brazil ch6sc4_5dd65c21:

#   ec "No, no. Nothing like that."
    ec "Não, não. Nada disso."

# game/chapters/chapter6/ch6sc4.rpy:1920
translate brazil ch6sc4_dd8408d1:

#   ec "I’ve just been filled with excitement since I invited you to this outing."
    ec "Estou muito animada desde que te convidei para este passeio."

# game/chapters/chapter6/ch6sc4.rpy:1922
translate brazil ch6sc4_dee0537b:

#   mc "That makes two of us"
    mc "Somos dois, então."

# game/chapters/chapter6/ch6sc4.rpy:1923
translate brazil ch6sc4_cf3f539b:

#   mc "I’ve got to admit, being invited for a mysterious outing with the A’nu herself..."
    mc "Tenho que admitir, ser convidada para um passeio misterioso com a própria A'nu..."

# game/chapters/chapter6/ch6sc4.rpy:1924
translate brazil ch6sc4_d0b995af:

#   mc "One can’t help but be a little curious."
    mc "É impossível não sentir um pouco de curiosidade."

# game/chapters/chapter6/ch6sc4.rpy:1926
translate brazil ch6sc4_e3de8dd5:

#   ec "Then let us delay no longer."
    ec "Então não vamos adiar mais."

# game/chapters/chapter6/ch6sc4.rpy:1928
translate brazil ch6sc4_b3151445:

#   ec "Shall we?"
    ec "Devemos nós?"

# game/chapters/chapter6/ch6sc4.rpy:1929
translate brazil ch6sc4_c8977181:

#   mc "Sure, I’m following your lead."
    mc "Claro, estou seguindo suas instruções."

# game/chapters/chapter6/ch6sc4.rpy:1931
translate brazil ch6sc4_e8e898bc:

#   sj "[mc], watch over our A’nu. Protect her at all costs."
    sj "[mc] Cuide de nossa A'nu. Proteja-a a todo custo."

# game/chapters/chapter6/ch6sc4.rpy:1933
translate brazil ch6sc4_fe42afdb:

#   ec "Goddess, Suji... I've been to the jungle many times, all on my own, need I remind you?"
    ec "Deusa, Suji... já estive na selva muitas vezes, sozinha, preciso te lembrar?"

# game/chapters/chapter6/ch6sc4.rpy:1934
translate brazil ch6sc4_81375a53:

#   ec "The last thing I need is a babysitter."
    ec "A última coisa de que preciso é de uma babá."

# game/chapters/chapter6/ch6sc4.rpy:1936
translate brazil ch6sc4_21320f3b:

#   sj "My apologies, A’nu. I meant no offense."
    sj "Peço desculpas, A'nu. Não tive a intenção de ofender."

# game/chapters/chapter6/ch6sc4.rpy:1937
translate brazil ch6sc4_35f7d64c:

#   ec "You have given none."
    ec "Você não deu nenhuma."

# game/chapters/chapter6/ch6sc4.rpy:1939
translate brazil ch6sc4_08e91984:

#   ec "But try to remember... I’ve been through the same training as the rest of you."
    ec "Mas tentem se lembrar... Eu passei pelo mesmo treinamento que todos vocês."

# game/chapters/chapter6/ch6sc4.rpy:1941
translate brazil ch6sc4_e7897610:

#   sj "A'nu."
    sj "Não."

# game/chapters/chapter6/ch6sc4.rpy:1943
translate brazil ch6sc4_9a6f89f8:

#   mc "*Quietly* {size=-10}{b}Don’t worry Suji, I won’t let anything happen to her.{/b}{/size}"
    mc "*Em silêncio* {size=-10}{b}Não se preocupe, Suji, eu não vou deixar nada acontecer com ela.{/b}{/size}"

# game/chapters/chapter6/ch6sc4.rpy:1945
translate brazil ch6sc4_83bc1cd6:

#   sj "[mc]..."
    sj "[mc]..."

# game/chapters/chapter6/ch6sc4.rpy:1946
translate brazil ch6sc4_beed602f:

#   sj "May the goddesses watch over you."
    sj "Que as deusas te protejam."

# game/chapters/chapter6/ch6sc4.rpy:1953
translate brazil ch6sc4_3d930c99:

#   "You and Echo leave A'nai behind and set out into the jungle."
    "Você e Echo deixam A'nai para trás e partem para a selva."

# game/chapters/chapter6/ch6sc4.rpy:1954
translate brazil ch6sc4_fb98873e:

#   ec "Can you believe Suji? Asking you to watch over me... me?! I'm their A'nu."
    ec "Você acredita, Suji? Pedindo para você cuidar de mim... de mim?! Eu sou o A'nu deles."

# game/chapters/chapter6/ch6sc4.rpy:1955
translate brazil ch6sc4_47823890:

#   mc "It's common for guards to watch over their leaders. At least, back on the mainland it is."
    mc "É comum que guardas vigiem seus líderes. Pelo menos, é assim no continente."

# game/chapters/chapter6/ch6sc4.rpy:1956
translate brazil ch6sc4_fad62ef2:

#   ec "Well, I don't need anyone to watch over me."
    ec "Bem, eu não preciso de ninguém para ficar de olho em mim."

# game/chapters/chapter6/ch6sc4.rpy:1957
translate brazil ch6sc4_cb91a23b:

#   mc "*Chuckles* Nevertheless, I promised her I would. So, I will."
    mc "*Risos* Mesmo assim, eu prometi a ela que faria. Então, farei."

# game/chapters/chapter6/ch6sc4.rpy:1958
translate brazil ch6sc4_b0138153:

#   ec "Don't you start!"
    ec "Nem comece!"

# game/chapters/chapter6/ch6sc4.rpy:1959
translate brazil ch6sc4_8b37f95e:

#   bth "*Laughs*"
    bth "*Risos*"

# game/chapters/chapter6/ch6sc4.rpy:1962
translate brazil ch6sc4_5f7b158c:

#   ec "Ahhh... the jungle is refreshing this time of day."
    ec "Ahhh... a selva é revigorante a esta hora do dia."

# game/chapters/chapter6/ch6sc4.rpy:1963
translate brazil ch6sc4_bf64ccff:

#   ec "Everything is just waking up after the shelter of night."
    ec "Tudo está apenas despertando após o abrigo da noite."

# game/chapters/chapter6/ch6sc4.rpy:1964
translate brazil ch6sc4_56f124ac:

#   mc "I know what you mean, I love the early mornings when I'm traveling."
    mc "Eu sei o que você quer dizer, eu adoro as manhãs bem cedo quando estou viajando."

# game/chapters/chapter6/ch6sc4.rpy:1966
translate brazil ch6sc4_678371a9:

#   ec "It pleases me greatly that you wanted to accompany me today."
    ec "Fico muito contente por você ter desejado me acompanhar hoje."

# game/chapters/chapter6/ch6sc4.rpy:1968
translate brazil ch6sc4_b273001a:

#   mc "When a beautiful woman invites you to share something personal, alone together in the jungle-"
    mc "Quando uma mulher linda te convida para compartilhar algo pessoal, a sós na selva..."

# game/chapters/chapter6/ch6sc4.rpy:1969
translate brazil ch6sc4_30a4ed09:

#   mc "You follow her. Wherever she leads you."
    mc "Você a segue. Para onde quer que ela o leve."

# game/chapters/chapter6/ch6sc4.rpy:1971
translate brazil ch6sc4_37259fc1:

#   ec "Hmm."
    ec "Hum."

# game/chapters/chapter6/ch6sc4.rpy:1972
translate brazil ch6sc4_f21744b0:

#   ec "You enjoy charming me, don’t you?"
    ec "Você gosta de me encantar, não é?"

# game/chapters/chapter6/ch6sc4.rpy:1974
translate brazil ch6sc4_61a73ac5:

#   ec "Maybe you've said the same things to other women."
    ec "Talvez você já tenha dito as mesmas coisas para outras mulheres."

# game/chapters/chapter6/ch6sc4.rpy:1975
translate brazil ch6sc4_440228a1:

#   ec "Maybe you charm them as well?"
    ec "Talvez você também consiga encantá-los?"

# game/chapters/chapter6/ch6sc4.rpy:1977
translate brazil ch6sc4_e5e3d39a:

#   mc "If I have been attracted to them, then yes."
    mc "Se eu me senti atraído por elas, então sim."

# game/chapters/chapter6/ch6sc4.rpy:1979
translate brazil ch6sc4_fe1a257c:

#   ec "Good."
    ec "Bom."

# game/chapters/chapter6/ch6sc4.rpy:1980
translate brazil ch6sc4_56cc4db0:

#   ec "This pleases me."
    ec "Isso me agrada."

# game/chapters/chapter6/ch6sc4.rpy:1982
translate brazil ch6sc4_6b719375:

#   mc "It pleases you that I charm other women?"
    mc "Te agrada que eu encante outras mulheres?"

# game/chapters/chapter6/ch6sc4.rpy:1984
translate brazil ch6sc4_8507a8fe:

#   ec "No. It is not that which pleases me."
    ec "Não. Não é isso que me agrada."

# game/chapters/chapter6/ch6sc4.rpy:1985
translate brazil ch6sc4_75fcbbc9:

#   ec "It is the honesty of your words."
    ec "É a honestidade das suas palavras."

# game/chapters/chapter6/ch6sc4.rpy:1986
translate brazil ch6sc4_5bddddb6:

#   ec "That is what holds meaning for me."
    ec "É isso que tem significado para mim."

# game/chapters/chapter6/ch6sc4.rpy:1988
translate brazil ch6sc4_edbfe911:

#   ec "You do not hide it, you speak your truth, and act upon it."
    ec "Você não esconde isso, você fala a sua verdade e age de acordo com ela."

# game/chapters/chapter6/ch6sc4.rpy:1990
translate brazil ch6sc4_1922b751:

#   ec "It makes me feel safe to know that whatever I may ask, you will be direct and truthful with me."
    ec "Sinto-me segura sabendo que, seja qual for a minha pergunta, você será direta e sincera comigo."

# game/chapters/chapter6/ch6sc4.rpy:1992
translate brazil ch6sc4_90a0bd4d:

#   mc "That’s one thing I can promise you."
    mc "Isso é uma coisa que posso te prometer."

# game/chapters/chapter6/ch6sc4.rpy:1994
translate brazil ch6sc4_dcb46e6c:

#   ec "Good... and in return, you will always be able to count on me doing the same for you."
    ec "Ótimo... e em troca, você sempre poderá contar comigo para fazer o mesmo por você."

# game/chapters/chapter6/ch6sc4.rpy:1995
translate brazil ch6sc4_b2b5fc21:

#   ec "Let us continue."
    ec "Vamos continuar."

# game/chapters/chapter6/ch6sc4.rpy:1997
translate brazil ch6sc4_c5ca348b:

#   ec "We’re close. It’s just a little ways off the path."
    ec "Estamos perto. Só está um pouco fora do caminho."

# game/chapters/chapter6/ch6sc4.rpy:1999
translate brazil ch6sc4_5060300f:

#   mc "Are you sure? Doesn’t the jungle change every so often?"
    mc "Tem certeza? A selva não muda de tempos em tempos?"

# game/chapters/chapter6/ch6sc4.rpy:2000
translate brazil ch6sc4_0b2d180d:

#   ec "Not this close to the village."
    ec "Não tão perto da vila."

# game/chapters/chapter6/ch6sc4.rpy:2001
translate brazil ch6sc4_f31c7d90:

#   ec "For some reason, the mist seems to avoid the area close to the village."
    ec "Por algum motivo, a neblina parece evitar a área próxima à vila."

# game/chapters/chapter6/ch6sc4.rpy:2002
translate brazil ch6sc4_bef0e866:

#   ec "Worry not. I’ve been to this place many times over the years. Besides..."
    ec "Não se preocupe. Já estive neste lugar muitas vezes ao longo dos anos. Além disso..."

# game/chapters/chapter6/ch6sc4.rpy:2003
translate brazil ch6sc4_4a8ba06c:

#   ec "Some of the most enjoyable things in life are found off the beaten path, [mc]."
    ec "Algumas das coisas mais prazerosas da vida são encontradas fora dos caminhos mais comuns. [mc]."

# game/chapters/chapter6/ch6sc4.rpy:2005
translate brazil ch6sc4_402a0d1a:

#   mc "Having traveled quite a bit, I have to agree with you."
    mc "Tendo viajado bastante, concordo com você."

# game/chapters/chapter6/ch6sc4.rpy:2006
translate brazil ch6sc4_89b175ef:

#   mc "Going off the beaten path is what led me to A’nai, and to you."
    mc "Sair dos caminhos tradicionais foi o que me levou a A'nai e a você."

# game/chapters/chapter6/ch6sc4.rpy:2007
translate brazil ch6sc4_d3095235:

#   mc "Still, I can't help but be curious about where you’re leading me."
    mc "Ainda assim, não consigo conter a curiosidade sobre aonde você está me levando."

# game/chapters/chapter6/ch6sc4.rpy:2009
translate brazil ch6sc4_724ff6cc:

#   ec "I will sate your curiosity soon enough."
    ec "Satisfarei sua curiosidade em breve."

# game/chapters/chapter6/ch6sc4.rpy:2010
translate brazil ch6sc4_82d73554:

#   mc "The anticipation keeps building."
    mc "A expectativa só aumenta."

# game/chapters/chapter6/ch6sc4.rpy:2011
translate brazil ch6sc4_bf84d3a2:

#   ec "We’ll let it build... until it... overflows."
    ec "Vamos deixar acumular... até... transbordar."

# game/chapters/chapter6/ch6sc4.rpy:2013
translate brazil ch6sc4_96153652:

#   "You keep following Echo deeper into the jungle. The further you go, the thicker it gets."
    "Você continua seguindo Echo, adentrando cada vez mais a selva. Quanto mais longe você vai, mais densa ela fica."

# game/chapters/chapter6/ch6sc4.rpy:2014
translate brazil ch6sc4_39b151e5:

#   ec "I’m taking you to a place that is very special to me. I first discovered it when I was only a child."
    ec "Vou te levar a um lugar muito especial para mim. Descobri-o quando ainda era criança."

# game/chapters/chapter6/ch6sc4.rpy:2016
translate brazil ch6sc4_7fb4e878:

#   ec "I haven't shared it with anyone else in the village, it’s my hidden place."
    ec "Não compartilhei com mais ninguém na vila, é o meu lugar secreto."

# game/chapters/chapter6/ch6sc4.rpy:2017
translate brazil ch6sc4_48bec986:

#   mc "Nobody else has been there before?"
    mc "Ninguém mais esteve lá antes?"

# game/chapters/chapter6/ch6sc4.rpy:2018
translate brazil ch6sc4_2749a0d2:

#   ec "I can't say for sure, but it has remained private to me for all my years."
    ec "Não posso afirmar com certeza, mas isso permaneceu privado para mim durante todos esses anos."

# game/chapters/chapter6/ch6sc4.rpy:2020
translate brazil ch6sc4_3ed53270:

#   mc "Maybe you're the only person to have found it?"
    mc "Talvez você seja a única pessoa que o encontrou?"

# game/chapters/chapter6/ch6sc4.rpy:2021
translate brazil ch6sc4_c0b6aa5d:

#   ec "It is entirely possible. However... it doesn't matter to me whether anyone else has been here."
    ec "É perfeitamente possível. No entanto... para mim, não importa se mais alguém já esteve aqui."

# game/chapters/chapter6/ch6sc4.rpy:2022
translate brazil ch6sc4_637dfe99:

#   ec "It will remain close to my heart, either way."
    ec "De qualquer forma, continuará a ter um lugar especial no meu coração."

# game/chapters/chapter6/ch6sc4.rpy:2024
translate brazil ch6sc4_c65ca8ad:

#   ec "*Sighs heavily* You were truthful with me earlier, so I must also be honest with you."
    ec "*Suspira profundamente* Você foi sincero comigo antes, então eu também preciso ser honesto com você."

# game/chapters/chapter6/ch6sc4.rpy:2025
translate brazil ch6sc4_984d3f85:

#   ec "The reason why I favor this place..."
    ec "O motivo pelo qual eu prefiro este lugar..."

# game/chapters/chapter6/ch6sc4.rpy:2027
translate brazil ch6sc4_04f27b5a:

#   ec "I enjoy being here so greatly because..."
    ec "Eu gosto muito de estar aqui porque..."

# game/chapters/chapter6/ch6sc4.rpy:2028
translate brazil ch6sc4_75ee52fa:

#   ec "It allows me to escape my duties. Even if only for a few moments."
    ec "Isso me permite escapar das minhas obrigações. Mesmo que seja apenas por alguns instantes."

# game/chapters/chapter6/ch6sc4.rpy:2029
translate brazil ch6sc4_1fd80303:

#   ec "Here I can let go of my burdens. The weight of my responsibilities is lifted off me."
    ec "Aqui posso me libertar dos meus fardos. O peso das minhas responsabilidades foi retirado de mim."

# game/chapters/chapter6/ch6sc4.rpy:2031
translate brazil ch6sc4_c837eae2:

#   ec "In this place, I am not the A’nu, the ruler of my people. I am just... me, Echo."
    ec "Neste lugar, eu não sou o A'nu, o governante do meu povo. Eu sou apenas... eu, Eco."

# game/chapters/chapter6/ch6sc4.rpy:2032
translate brazil ch6sc4_e5544801:

#   mc "I get it."
    mc "Entendo."

# game/chapters/chapter6/ch6sc4.rpy:2033
translate brazil ch6sc4_70d4495d:

#   mc "Having an entire people depending on you, looking to you for advice and guidance constantly..."
    mc "Ter um povo inteiro dependendo de você, buscando constantemente seus conselhos e orientações..."

# game/chapters/chapter6/ch6sc4.rpy:2034
translate brazil ch6sc4_4787b3fb:

#   mc "It must be overwhelming and tiring, even for the most dedicated leader."
    mc "Deve ser algo avassalador e cansativo, mesmo para o líder mais dedicado."

# game/chapters/chapter6/ch6sc4.rpy:2036
translate brazil ch6sc4_e9fb5e2c:

#   ec "Y-You truly do understand me?"
    ec "Você realmente me entende?"

# game/chapters/chapter6/ch6sc4.rpy:2038
translate brazil ch6sc4_c54103b7:

#   mc "Mhm, I had a similar place back in my home village of Riverside."
    mc "Sim, eu tinha um lugar parecido na minha cidade natal, Riverside."

# game/chapters/chapter6/ch6sc4.rpy:2039
translate brazil ch6sc4_e0d0fc5b:

#   mc "There was this one part of the forest, it had a patch of apple trees in a clearing. "
    mc "Havia uma parte da floresta com um grupo de macieiras em uma clareira. "

# game/chapters/chapter6/ch6sc4.rpy:2040
translate brazil ch6sc4_86e18cfc:

#   mc "I often went there to spend hours playing, and munching on apples when they were ripe."
    mc "Eu costumava ir lá para passar horas brincando e comendo maçãs quando estavam maduras."

# game/chapters/chapter6/ch6sc4.rpy:2042
translate brazil ch6sc4_e609a27e:

#   ec "*Giggles joyfully* Goddess, that sounds lovely!"
    ec "*Risos de alegria* Nossa, isso parece maravilhoso!"

# game/chapters/chapter6/ch6sc4.rpy:2043
translate brazil ch6sc4_0af36356:

#   ec "Maybe one day..."
    ec "Talvez um dia..."

# game/chapters/chapter6/ch6sc4.rpy:2045
translate brazil ch6sc4_ffe93062:

#   ec "*Sighs deeply* Nevermind."
    ec "*Suspira profundamente* Deixa pra lá."

# game/chapters/chapter6/ch6sc4.rpy:2047
translate brazil ch6sc4_78f31588:

#   mc "Hey, speak your truth."
    mc "Ei, fale a sua verdade."

# game/chapters/chapter6/ch6sc4.rpy:2050
translate brazil ch6sc4_f01c0995:

#   ec "I... I would love to visit your special place with you someday."
    ec "Eu... eu adoraria visitar seu lugar especial com você algum dia."

# game/chapters/chapter6/ch6sc4.rpy:2052
translate brazil ch6sc4_2706a1aa:

#   mc "It's a long way from Aruna, but... if you truly want to, then I will share it with you one day."
    mc "É muito longe de Aruna, mas... se você realmente quiser, um dia compartilharei com você."

# game/chapters/chapter6/ch6sc4.rpy:2056
translate brazil ch6sc4_90ece79e:

#   ec "[mc]- I... I do want it."
    ec "[mc]— Eu... eu quero isso."

# game/chapters/chapter6/ch6sc4.rpy:2058
translate brazil ch6sc4_06880aed:

#   mc "Then it’s a promise."
    mc "Então é uma promessa."

# game/chapters/chapter6/ch6sc4.rpy:2059
translate brazil ch6sc4_750aab35:

#   mc "For now, we’ll share your special place."
    mc "Por agora, vamos compartilhar seu lugar especial."

# game/chapters/chapter6/ch6sc4.rpy:2060
translate brazil ch6sc4_38129068:

#   mc "And one day, we will share mine as well."
    mc "E um dia, nós também compartilharemos a minha."

# game/chapters/chapter6/ch6sc4.rpy:2062
translate brazil ch6sc4_6e36e6ab:

#   ec "I’d love that! *Giggles*"
    ec "Eu adoraria! *Risos*"

# game/chapters/chapter6/ch6sc4.rpy:2063
translate brazil ch6sc4_df5a9ca4:

#   ec "Come, we’re almost there!"
    ec "Venha, já estamos quase lá!"

# game/chapters/chapter6/ch6sc4.rpy:2069
translate brazil ch6sc4_9365c943:

#   ec "We’re coming up on it now."
    ec "Estamos quase lá."

# game/chapters/chapter6/ch6sc4.rpy:2070
translate brazil ch6sc4_20459767:

#   ec "Please, close your eyes for me."
    ec "Por favor, feche os olhos para mim."

# game/chapters/chapter6/ch6sc4.rpy:2072
translate brazil ch6sc4_b4d4e340:

#   mc "Close my eyes? Why?"
    mc "Fechar os olhos? Por quê?"

# game/chapters/chapter6/ch6sc4.rpy:2074
translate brazil ch6sc4_ce317d4a:

#   ec "Place your trust in me, as I have placed mine in you."
    ec "Confie em mim, assim como eu confio em você."

# game/chapters/chapter6/ch6sc4.rpy:2076
translate brazil ch6sc4_84f16542:

#   mc "Okay..."
    mc "OK..."

# game/chapters/chapter6/ch6sc4.rpy:2078
translate brazil ch6sc4_d5de2cd1:

#   ec "Please, close your eyes, I want this to be a surprise."
    ec "Por favor, feche os olhos, quero que seja uma surpresa."

# game/chapters/chapter6/ch6sc4.rpy:2079
translate brazil ch6sc4_961c6718:

#   ec "You only get to see something for the first time once."
    ec "Você só tem a oportunidade de ver algo pela primeira vez uma única vez."

# game/chapters/chapter6/ch6sc4.rpy:2081
translate brazil ch6sc4_10431f8f:

#   mc "Okay, okay... eyes closed, I won’t spoil your surprise."
    mc "Ok, ok... olhos fechados, não vou estragar a surpresa."

# game/chapters/chapter6/ch6sc4.rpy:2084
translate brazil ch6sc4_2416e22e:

#   ec "Here, I’ll guide you."
    ec "Aqui, eu vou te orientar."

# game/chapters/chapter6/ch6sc4.rpy:2085
translate brazil ch6sc4_ca197dc5:

#   "You feel Echo's soft palm clasp yours gently, her fingers squeezing you encouragingly."
    "Você sente a palma macia de Echo segurar a sua delicadamente, seus dedos apertando-a em um gesto encorajador."

# game/chapters/chapter6/ch6sc4.rpy:2086
translate brazil ch6sc4_cf4f8437:

#   mc "If I fall, I’m taking you down with me."
    mc "Se eu cair, levo você comigo."

# game/chapters/chapter6/ch6sc4.rpy:2087
translate brazil ch6sc4_979aba31:

#   ec "You wouldn’t dare!"
    ec "Você não teria coragem!"

# game/chapters/chapter6/ch6sc4.rpy:2088
translate brazil ch6sc4_0ac2bccd:

#   mc "You don’t want to find out. *Chuckles*"
    mc "Você não quer descobrir. *Risos*"

# game/chapters/chapter6/ch6sc4.rpy:2091
translate brazil ch6sc4_54d931cb:

#   ec "Almost there."
    ec "Quase lá."

# game/chapters/chapter6/ch6sc4.rpy:2092
translate brazil ch6sc4_8c3dfe23:

#   ec "Wait... stand here."
    ec "Espere... fique aqui."

# game/chapters/chapter6/ch6sc4.rpy:2093
translate brazil ch6sc4_04e63403:

#   mc "Is this good?"
    mc "Isso é bom?"

# game/chapters/chapter6/ch6sc4.rpy:2094
translate brazil ch6sc4_a6ff8860:

#   ec "Yes, that will do."
    ec "Sim, isso serve."

# game/chapters/chapter6/ch6sc4.rpy:2097
translate brazil ch6sc4_754bb8a4:

#   ec "Okay, you can open your eyes now."
    ec "Muito bem, agora você pode abrir os olhos."

# game/chapters/chapter6/ch6sc4.rpy:2102
translate brazil ch6sc4_62b5d3f5:

#   "On opening your eyes, you’re met with an unexpected sight."
    "Ao abrir os olhos, você se depara com uma visão inesperada."

# game/chapters/chapter6/ch6sc4.rpy:2103
translate brazil ch6sc4_f32ed304:

#   "A lush grove, flourishing with numerous plants, and a cloud of butterflies swirling around a large beautiful tree in the center."
    "Um bosque exuberante, repleto de inúmeras plantas, e uma nuvem de borboletas rodopiando em torno de uma grande e bela árvore no centro."

# game/chapters/chapter6/ch6sc4.rpy:2105
translate brazil ch6sc4_e20c22f8:

#   "Echo lets out a gentle laugh as a butterfly comes to greet her."
    "Echo solta uma risada suave quando uma borboleta vem cumprimentá-la."

# game/chapters/chapter6/ch6sc4.rpy:2106
translate brazil ch6sc4_1acf9339:

#   mct "{i}*Chuckles lightly* She’s completely in her element out here.{/i}"
    mct "{i}*Risos discretos* Ela está completamente à vontade aqui.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:2108
translate brazil ch6sc4_31f94659:

#   mct "{i}I can see why she cherishes this place.{/i}"
    mct "{i}Agora entendo por que ela gosta tanto deste lugar.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:2109
translate brazil ch6sc4_1b0ee152:

#   ec "*Giggles* Off you go! Enjoy the flowers little one."
    ec "*Risos* Pode ir! Aproveite as flores, meu bem."

# game/chapters/chapter6/ch6sc4.rpy:2111
translate brazil ch6sc4_1592d92d:

#   ec "What do you think?"
    ec "O que você acha?"

# game/chapters/chapter6/ch6sc4.rpy:2112
translate brazil ch6sc4_374f7fb7:

#   ec "Do you like it?"
    ec "Você gosta disso?"

# game/chapters/chapter6/ch6sc4.rpy:2114
translate brazil ch6sc4_c50a2b15:

#   mc "Like it? Echo, saying I like it would be an insult to this place..."
    mc "Gostou? Echo, dizer que gostei seria um insulto a este lugar..."

# game/chapters/chapter6/ch6sc4.rpy:2115
translate brazil ch6sc4_679c8370:

#   mc "It’s incredible, it’s..."
    mc "É incrível, é..."

# game/chapters/chapter6/ch6sc4.rpy:2117
translate brazil ch6sc4_159e05b8:

#   ec "Awe-inspiring."
    ec "Impressionante."

# game/chapters/chapter6/ch6sc4.rpy:2119
translate brazil ch6sc4_319a1111:

#   mc "It’s like I stepped into a whole other realm."
    mc "É como se eu tivesse entrado em um mundo completamente diferente."

# game/chapters/chapter6/ch6sc4.rpy:2120
translate brazil ch6sc4_9a913230:

#   mc "A realm of wonder and beauty. I don’t think this compares to anything I’ve seen."
    mc "Um reino de maravilhas e beleza. Acho que não se compara a nada que eu já tenha visto."

# game/chapters/chapter6/ch6sc4.rpy:2122
translate brazil ch6sc4_03e08a79:

#   ec "Your reaction... it’s everything I had hoped it would be... it pleases me greatly."
    ec "Sua reação... é tudo o que eu esperava... me deixa muito feliz."

# game/chapters/chapter6/ch6sc4.rpy:2123
translate brazil ch6sc4_2cf141b8:

#   mc "You’re pleased I’ve never seen something like this?"
    mc "Você está contente por eu nunca ter visto algo assim?"

# game/chapters/chapter6/ch6sc4.rpy:2124
translate brazil ch6sc4_feda4999:

#   ec "Yes."
    ec "Sim."

# game/chapters/chapter6/ch6sc4.rpy:2126
translate brazil ch6sc4_e49e95b0:

#   ec "It means I get to be the one who introduces you to beauty like this."
    ec "Significa que serei eu quem te apresentará a essa beleza."

# game/chapters/chapter6/ch6sc4.rpy:2128
translate brazil ch6sc4_56f4b345:

#   ec "I feel happy to finally share this place with someone..."
    ec "Estou feliz por finalmente poder compartilhar este lugar com alguém..."

# game/chapters/chapter6/ch6sc4.rpy:2130
translate brazil ch6sc4_b35ae2d7:

#   ec "With... you."
    ec "Com você."

# game/chapters/chapter6/ch6sc4.rpy:2132
translate brazil ch6sc4_15c07a86:

#   mc "You know, Echo..."
    mc "Sabe, Echo..."

# game/chapters/chapter6/ch6sc4.rpy:2133
translate brazil ch6sc4_02ba0d59:

#   mc "I didn’t know what to expect today, but this has been a pleasant surprise."
    mc "Eu não sabia o que esperar hoje, mas isso foi uma grata surpresa."

# game/chapters/chapter6/ch6sc4.rpy:2134
translate brazil ch6sc4_155f4caf:

#   mc "I’m glad you decided to share this with me."
    mc "Fico feliz que você tenha decidido compartilhar isso comigo."

# game/chapters/chapter6/ch6sc4.rpy:2136
translate brazil ch6sc4_fdc26645:

#   ec "Your words fill me with joy. I am happy you decided to join me too."
    ec "Suas palavras me enchem de alegria. Fico feliz que você também tenha decidido se juntar a mim."

# game/chapters/chapter6/ch6sc4.rpy:2138
translate brazil ch6sc4_22249a97:

#   ec "Although, I must be truthful."
    ec "No entanto, devo ser sincero."

# game/chapters/chapter6/ch6sc4.rpy:2140
translate brazil ch6sc4_8945fc9f:

#   ec "For a fleeting moment, while I was waiting for you at the gate..."
    ec "Por um breve instante, enquanto eu te esperava no portão..."

# game/chapters/chapter6/ch6sc4.rpy:2141
translate brazil ch6sc4_fb32cd9f:

#   ec "I feared that you would not come, that you had changed your mind."
    ec "Eu temia que você não viesse, que tivesse mudado de ideia."

# game/chapters/chapter6/ch6sc4.rpy:2143
translate brazil ch6sc4_140eaf9e:

#   mc "Why would you think that? I agreed to meet you, didn’t I?"
    mc "Por que você pensaria isso? Eu concordei em me encontrar com você, não concordei?"

# game/chapters/chapter6/ch6sc4.rpy:2144
translate brazil ch6sc4_153c3062:

#   ec "Well... you are a man."
    ec "Bem... você é um homem."

# game/chapters/chapter6/ch6sc4.rpy:2146
translate brazil ch6sc4_99441ac7:

#   mc "And? I thought you weren’t going to judge me based on something like that?"
    mc "E daí? Pensei que você não fosse me julgar por algo assim."

# game/chapters/chapter6/ch6sc4.rpy:2147
translate brazil ch6sc4_ca27eb46:

#   ec "[mc]... I... I’m sorry. I did not mean it like that."
    ec "[mc]... Eu... Eu sinto muito. Não era essa a minha intenção."

# game/chapters/chapter6/ch6sc4.rpy:2149
translate brazil ch6sc4_aaddfeeb:

#   ec "Marah’s constant nagging and tales of men of the past..."
    ec "As constantes reclamações de Marah e suas histórias sobre homens do passado..."

# game/chapters/chapter6/ch6sc4.rpy:2150
translate brazil ch6sc4_462c2388:

#   ec "I know her words only speak the truth of our past, and they have no connection to you..."
    ec "Sei que as palavras dela apenas expressam a verdade sobre o nosso passado e não têm nenhuma ligação com você..."

# game/chapters/chapter6/ch6sc4.rpy:2152
translate brazil ch6sc4_0be90135:

#   ec "Yet..."
    ec "Ainda..."

# game/chapters/chapter6/ch6sc4.rpy:2153
translate brazil ch6sc4_f724c746:

#   ec "Her seeds of corruption must’ve affected me, sown doubt within me."
    ec "Suas sementes de corrupção devem ter me afetado, semeado dúvidas dentro de mim."

# game/chapters/chapter6/ch6sc4.rpy:2155
translate brazil ch6sc4_7a924d1d:

#   mc "Then allow me banish those doubts, and erase any seeds of corruption."
    mc "Então permita-me dissipar essas dúvidas e apagar qualquer semente de corrupção."

# game/chapters/chapter6/ch6sc4.rpy:2156
translate brazil ch6sc4_acac78e0:

#   mc "Once and for all."
    mc "De uma vez por todas."

# game/chapters/chapter6/ch6sc4.rpy:2157
translate brazil ch6sc4_f875e328:

#   ec "*Whimpers softly* Mmnhh..."
    ec "*Geme baixinho* Mmnhh..."

# game/chapters/chapter6/ch6sc4.rpy:2159
translate brazil ch6sc4_fdf4406a:

#   ec "[mc]... what are you...?"
    ec "[mc]... o que você está...?"

# game/chapters/chapter6/ch6sc4.rpy:2161
translate brazil ch6sc4_e858dc18:

#   mc "Shh... now it is time for you to trust me."
    mc "Shhh... agora é hora de você confiar em mim."

# game/chapters/chapter6/ch6sc4.rpy:2163
translate brazil ch6sc4_0c711f75:

#   ec "*Nods* O-Okay."
    ec "*Acena com a cabeça* O-Okay."

# game/chapters/chapter6/ch6sc4.rpy:2165
translate brazil ch6sc4_ce2c595c:

#   mc "You're not the only one with a surprise to share today."
    mc "Você não é o único com uma surpresa para compartilhar hoje."

# game/chapters/chapter6/ch6sc4.rpy:2166
translate brazil ch6sc4_7ff72ead:

#   mc "Turn around for me."
    mc "Vire-se para mim."

# game/chapters/chapter6/ch6sc4.rpy:2168
translate brazil ch6sc4_aef899e2:

#   ec "Like this?"
    ec "Assim?"

# game/chapters/chapter6/ch6sc4.rpy:2169
translate brazil ch6sc4_2612744d:

#   mc "Perfect, hold still."
    mc "Perfeito, fique parado."

# game/chapters/chapter6/ch6sc4.rpy:2171
translate brazil ch6sc4_518d1fa0:

#   ec "[mc]... did you just... put a necklace on me?"
    ec "[mc]...você acabou de... colocar um colar em mim?"

# game/chapters/chapter6/ch6sc4.rpy:2174
translate brazil ch6sc4_bd854654:

#   ec "Thank you, it’s beautiful..."
    ec "Obrigada, é lindo..."

# game/chapters/chapter6/ch6sc4.rpy:2176
translate brazil ch6sc4_32c5fee7:

#   ec "Wait... no, no... it can’t be!"
    ec "Espera... não, não... não pode ser!"

# game/chapters/chapter6/ch6sc4.rpy:2178
translate brazil ch6sc4_86310dde:

#   ec "This is... my mother’s necklace?"
    ec "Este é... o colar da minha mãe?"

# game/chapters/chapter6/ch6sc4.rpy:2179
translate brazil ch6sc4_6db59377:

#   ec "H-How did you? Where?"
    ec "H-Como você fez isso? Onde?"

# game/chapters/chapter6/ch6sc4.rpy:2181
translate brazil ch6sc4_563db971:

#   mc "I found it in Gaia’s temple. It was on her statue."
    mc "Encontrei-a no templo de Gaia. Estava na estátua dela."

# game/chapters/chapter6/ch6sc4.rpy:2183
translate brazil ch6sc4_bfdcc8a8:

#   ec "You didn't tell me when you got back... why?"
    ec "Você não me disse quando voltou... por quê?"

# game/chapters/chapter6/ch6sc4.rpy:2185
translate brazil ch6sc4_5f156dab:

#   mc "I didn’t feel it was the right time, with everyone else around."
    mc "Não senti que fosse o momento certo, com todas as outras pessoas por perto."

# game/chapters/chapter6/ch6sc4.rpy:2186
translate brazil ch6sc4_90ae4568:

#   mc "This felt... like it demanded a more private setting."
    mc "A sensação era de que... precisava de um ambiente mais reservado."

# game/chapters/chapter6/ch6sc4.rpy:2188
translate brazil ch6sc4_fdaea101:

#   ec "Yes, I agree... you were wise to wait."
    ec "Sim, concordo... você foi sábio em esperar."

# game/chapters/chapter6/ch6sc4.rpy:2189
translate brazil ch6sc4_35f58457:

#   ec "This is the perfect place to receive such a gift."
    ec "Este é o lugar perfeito para receber um presente assim."

# game/chapters/chapter6/ch6sc4.rpy:2191
translate brazil ch6sc4_9b5d33f3:

#   ec "*Sighs heavily* But... I cannot accept it."
    ec "*Suspira profundamente* Mas... eu não consigo aceitar isso."

# game/chapters/chapter6/ch6sc4.rpy:2192
translate brazil ch6sc4_be55ff55:

#   mc "It’s yours, Echo."
    mc "É seu, Echo."

# game/chapters/chapter6/ch6sc4.rpy:2194
translate brazil ch6sc4_188d7407:

#   mc "It belonged to your mother, it’s an heirloom of your people."
    mc "Pertenceu à sua mãe, é uma herança do seu povo."

# game/chapters/chapter6/ch6sc4.rpy:2196
translate brazil ch6sc4_96ba8958:

#   ec "B-But you took this from the temple, Gaia’s statue..."
    ec "Mas você tirou isso do templo, a estátua de Gaia..."

# game/chapters/chapter6/ch6sc4.rpy:2197
translate brazil ch6sc4_1a2681d2:

#   ec "It must’ve been there for a -"
    ec "Deve ter estado lá por um tempo -"

# game/chapters/chapter6/ch6sc4.rpy:2199
translate brazil ch6sc4_41f12160:

#   mc "Sshh..."
    mc "Shhh..."

# game/chapters/chapter6/ch6sc4.rpy:2200
translate brazil ch6sc4_4fbc1412:

#   "As you put your finger on her lips, Echo completely freezes in surprise."
    "Ao colocar o dedo nos lábios dela, Echo congela completamente de surpresa."

# game/chapters/chapter6/ch6sc4.rpy:2201
translate brazil ch6sc4_7062e3bf:

#   mc "You needn’t worry about that."
    mc "Você não precisa se preocupar com isso."

# game/chapters/chapter6/ch6sc4.rpy:2202
translate brazil ch6sc4_bc7cf41b:

#   mc "This belonged to the previous A’nu. You are her heir, and that title is now rightfully yours."
    mc "Este título pertencia à A'nu anterior. Você é o herdeiro dela, e agora ele lhe pertence por direito."

# game/chapters/chapter6/ch6sc4.rpy:2203
translate brazil ch6sc4_59c4af35:

#   mc "This necklace represents not just your mother, but you, all of your people, and all the beliefs you hold dear."
    mc "Este colar representa não apenas sua mãe, mas você, todo o seu povo e todas as crenças que você preza."

# game/chapters/chapter6/ch6sc4.rpy:2204
translate brazil ch6sc4_066d6fd2:

#   mc "Your people's history, present and future, it belongs to you... their queen."
    mc "A história, o presente e o futuro do seu povo pertencem a você... à sua rainha."

# game/chapters/chapter6/ch6sc4.rpy:2206
translate brazil ch6sc4_ed5d7e5a:

#   ec "*Muffled* Mmgh... Mhm-Mm?"
    ec "*Abafado* Mmgh... Mhm-Mm?"

# game/chapters/chapter6/ch6sc4.rpy:2207
translate brazil ch6sc4_d2d69a50:

#   mc "Sorry, but I won’t hear it."
    mc "Desculpe, mas não quero ouvir isso."

# game/chapters/chapter6/ch6sc4.rpy:2208
translate brazil ch6sc4_9905544a:

#   mc "Your mother might’ve placed this necklace on Gaia’s statue as an offering, wishing for her to watch over you."
    mc "Sua mãe pode ter colocado este colar na estátua de Gaia como uma oferenda, desejando que ela o protegesse."

# game/chapters/chapter6/ch6sc4.rpy:2209
translate brazil ch6sc4_5ad34e3e:

#   mc "But it was Gaia herself who asked me to bring it back to your people. To you."
    mc "Mas foi a própria Gaia quem me pediu para trazê-la de volta ao seu povo. A vocês."

# game/chapters/chapter6/ch6sc4.rpy:2211
translate brazil ch6sc4_2e6f66ff:

#   mc "Are you going to stand there and argue against the will of your goddess?"
    mc "Você vai ficar aí parado discutindo contra a vontade da sua deusa?"

# game/chapters/chapter6/ch6sc4.rpy:2212
translate brazil ch6sc4_3c61e39d:

#   ec "Hmm..."
    ec "Hum..."

# game/chapters/chapter6/ch6sc4.rpy:2214
translate brazil ch6sc4_9c12ceb8:

#   ec "You make it impossible to argue."
    ec "Você torna impossível argumentar."

# game/chapters/chapter6/ch6sc4.rpy:2216
translate brazil ch6sc4_8ea0d987:

#   mc "So, you’ll accept it?"
    mc "Então, você vai aceitar?"

# game/chapters/chapter6/ch6sc4.rpy:2217
translate brazil ch6sc4_e3bec288:

#   ec "*Nods*"
    ec "*Acena com a cabeça*"

# game/chapters/chapter6/ch6sc4.rpy:2219
translate brazil ch6sc4_dc5dc95a:

#   ec "Yes, I’ll... I’ll accept this gift from you."
    ec "Sim, eu... eu aceito este presente seu."

# game/chapters/chapter6/ch6sc4.rpy:2221
translate brazil ch6sc4_303b316d:

#   mc "Good. Hopefully you like its design. It’s quite beautiful, if you ask me."
    mc "Ótimo. Espero que goste do design. É bem bonito, na minha opinião."

# game/chapters/chapter6/ch6sc4.rpy:2223
translate brazil ch6sc4_9bc75aa1:

#   ec "Oh, [mc]..."
    ec "Oh, [mc]..."

# game/chapters/chapter6/ch6sc4.rpy:2224
translate brazil ch6sc4_d4fc2ad3:

#   ec "You have no idea how much this means to me..."
    ec "Você não faz ideia do quanto isso significa para mim..."

# game/chapters/chapter6/ch6sc4.rpy:2226
translate brazil ch6sc4_01395346:

#   ec "I-I love it."
    ec "Eu adorei."

# game/chapters/chapter6/ch6sc4.rpy:2228
translate brazil ch6sc4_a9db44b2:

#   ec "As much as I..."
    ec "Por mais que eu..."

# game/chapters/chapter6/ch6sc4.rpy:2229
translate brazil ch6sc4_2a7a830f:

#   ec "Love you."
    ec "Amo você."

# game/chapters/chapter6/ch6sc4.rpy:2237
translate brazil ch6sc4_76369907:

#   mc "You love-"
    mc "Você ama-"

# game/chapters/chapter6/ch6sc4.rpy:2240
translate brazil ch6sc4_1826ad6b:

#   "Before you have time to absorb her words, you feel the warmth and softness of her lips on yours."
    "Antes mesmo de você ter tempo de assimilar as palavras dela, você sente o calor e a maciez dos lábios dela nos seus."

# game/chapters/chapter6/ch6sc4.rpy:2243
translate brazil ch6sc4_ab58720b:

#   "She locks her arms tightly around your neck as she passionately kisses you again and again."
    "Ela envolve seus braços firmemente em volta do seu pescoço enquanto te beija apaixonadamente repetidas vezes."

# game/chapters/chapter6/ch6sc4.rpy:2245
translate brazil ch6sc4_bd7a1f86:

#   ec "*Moans softly* Mmhm... Nngh."
    ec "*Geme baixinho* Mmhm... Nngh."

# game/chapters/chapter6/ch6sc4.rpy:2247
translate brazil ch6sc4_5cc01b14:

#   mc "Mmmh... I’ve been waiting for this ever since we got back yesterday... Mmm."
    mc "Hum... Estava esperando por isso desde que voltamos ontem... Hum."

# game/chapters/chapter6/ch6sc4.rpy:2250
translate brazil ch6sc4_5e543043:

#   ec "*Kiss* Why do you think I was so restless last night?"
    ec "*Beijo* Por que você acha que eu estava tão inquieto ontem à noite?"

# game/chapters/chapter6/ch6sc4.rpy:2251
translate brazil ch6sc4_6568e0ce:

#   ec "Mmmh... I wanted to find you and do this... Mmmgh."
    ec "Hum... Eu queria te encontrar e fazer isso... Hum..."

# game/chapters/chapter6/ch6sc4.rpy:2253
translate brazil ch6sc4_95b21179:

#   ec "To feel your hands on me... Mghh, I’ve been longing for it."
    ec "Sentir suas mãos em mim... Mghh, eu estava desejando isso há muito tempo."

# game/chapters/chapter6/ch6sc4.rpy:2254
translate brazil ch6sc4_18f8cddd:

#   mc "Me too. Your body is incredible, Echo... I love holding you in my hands."
    mc "Eu também. Seu corpo é incrível, Echo... Adoro te segurar em meus braços."

# game/chapters/chapter6/ch6sc4.rpy:2255
translate brazil ch6sc4_41b97b64:

#   ec "My entire body tingles when I'm in your arms."
    ec "Meu corpo inteiro formiga quando estou em seus braços."

# game/chapters/chapter6/ch6sc4.rpy:2257
translate brazil ch6sc4_75bdc5f5:

#   mc "*Kiss* Mmgh... did you... Mmm... did you mean it?"
    mc "*Beijo* Mmgh... você... Mmm... você estava falando sério?"

# game/chapters/chapter6/ch6sc4.rpy:2259
translate brazil ch6sc4_7148afa8:

#   "She reluctantly releases her arms from your neck and pulls back."
    "Ela solta os braços do seu pescoço com relutância e se afasta."

# game/chapters/chapter6/ch6sc4.rpy:2263
translate brazil ch6sc4_2536e5dc:

#   ec "I meant it."
    ec "Eu estava falando sério."

# game/chapters/chapter6/ch6sc4.rpy:2264
translate brazil ch6sc4_51d37e29:

#   ec "[mc]... I love everything about you."
    ec "[mc]...Eu amo tudo em você."

# game/chapters/chapter6/ch6sc4.rpy:2266
translate brazil ch6sc4_8709244b:

#   ec "Every time I learn something new about you, I'm both surprised and intrigued."
    ec "Cada vez que descubro algo novo sobre você, fico surpreso e intrigado."

# game/chapters/chapter6/ch6sc4.rpy:2267
translate brazil ch6sc4_d0cb0d00:

#   ec "When I think about you, I feel funny... When you're away, I worry."
    ec "Quando penso em você, me sinto estranho... Quando você está longe, eu me preocupo."

# game/chapters/chapter6/ch6sc4.rpy:2268
translate brazil ch6sc4_ce92ee63:

#   ec "You have become... very special to me."
    ec "Você se tornou... muito especial para mim."

# game/chapters/chapter6/ch6sc4.rpy:2270
translate brazil ch6sc4_b3a1b313:

#   ec "As special as this place..."
    ec "Tão especial quanto este lugar..."

# game/chapters/chapter6/ch6sc4.rpy:2271
translate brazil ch6sc4_bffb4c11:

#   ec "You have claimed a place next to it in my heart."
    ec "Você conquistou um lugar ao lado dele no meu coração."

# game/chapters/chapter6/ch6sc4.rpy:2273
translate brazil ch6sc4_07c4f28b:

#   mc "You’re special to me, as well."
    mc "Você também é especial para mim."

# game/chapters/chapter6/ch6sc4.rpy:2274
translate brazil ch6sc4_1e95dcef:

#   mc "I can honestly say, I’m happy that we’ve found each other."
    mc "Posso dizer honestamente que estou feliz por termos nos encontrado."

# game/chapters/chapter6/ch6sc4.rpy:2275
translate brazil ch6sc4_e3bc9a05:

#   mc "You’ve allowed me into your home."
    mc "Você me permitiu entrar em sua casa."

# game/chapters/chapter6/ch6sc4.rpy:2276
translate brazil ch6sc4_433f8773:

#   mc "You've shown me kindness and respect, defended me against your own advisors..."
    mc "Você me demonstrou gentileza e respeito, me defendeu contra seus próprios conselheiros..."

# game/chapters/chapter6/ch6sc4.rpy:2278
translate brazil ch6sc4_3ef2c4c6:

#   mc "You’ve allowed me to discover a lost civilization."
    mc "Você me permitiu descobrir uma civilização perdida."

# game/chapters/chapter6/ch6sc4.rpy:2279
translate brazil ch6sc4_fae63dd7:

#   mc "And even brought me to your very own private paradise."
    mc "E até me levou ao seu paraíso particular."

# game/chapters/chapter6/ch6sc4.rpy:2280
translate brazil ch6sc4_e3e33adb:

#   mc "At first it was just instinctual attraction, a desire that kept building."
    mc "No início, era apenas uma atração instintiva, um desejo que foi crescendo aos poucos."

# game/chapters/chapter6/ch6sc4.rpy:2281
translate brazil ch6sc4_25d83b94:

#   mc "But it’s clearly more than that."
    mc "Mas é claramente mais do que isso."

# game/chapters/chapter6/ch6sc4.rpy:2282
translate brazil ch6sc4_3c9b6da5:

#   mc "Otherwise I wouldn’t find myself smiling whenever I’m with you."
    mc "Caso contrário, eu não me veria sorrindo sempre que estou com você."

# game/chapters/chapter6/ch6sc4.rpy:2284
translate brazil ch6sc4_95418e08:

#   ec "I've liked you from our first encounter too."
    ec "Eu também gostei de você desde o nosso primeiro encontro."

# game/chapters/chapter6/ch6sc4.rpy:2285
translate brazil ch6sc4_1f009f70:

#   ec "And you’re right, at first... it was merely an incredible attraction."
    ec "E você tem razão, a princípio... era simplesmente uma atração incrível."

# game/chapters/chapter6/ch6sc4.rpy:2286
translate brazil ch6sc4_d7f52f0c:

#   ec "Seeing a handsome, well-sculpted man for the first time."
    ec "Ver um homem bonito e bem-apessoado pela primeira vez."

# game/chapters/chapter6/ch6sc4.rpy:2288
translate brazil ch6sc4_ed0fe654:

#   ec "I knew it was more than just simple desire in the moment when Marah pushed you down into the temple depths."
    ec "Eu sabia que era mais do que um simples desejo momentâneo quando Marah te empurrou para as profundezas do templo."

# game/chapters/chapter6/ch6sc4.rpy:2289
translate brazil ch6sc4_04eb15f4:

#   ec "The twisting pit in my stomach as I watched you fall."
    ec "A sensação de aperto no estômago enquanto eu te via cair."

# game/chapters/chapter6/ch6sc4.rpy:2290
translate brazil ch6sc4_e810a636:

#   ec "The despair I felt because I didn't know your fate."
    ec "O desespero que senti por não saber o seu destino."

# game/chapters/chapter6/ch6sc4.rpy:2291
translate brazil ch6sc4_c5c68929:

#   ec "That was when I knew that deeper feelings had somehow taken root inside me."
    ec "Foi nesse momento que percebi que sentimentos mais profundos haviam, de alguma forma, criado raízes dentro de mim."

# game/chapters/chapter6/ch6sc4.rpy:2293
translate brazil ch6sc4_ec46ce69:

#   ec "And then, then you emerged again... reborn as a champion of our people."
    ec "E então, você ressurgiu... renascido como um campeão do nosso povo."

# game/chapters/chapter6/ch6sc4.rpy:2294
translate brazil ch6sc4_f02a69a9:

#   ec "On the path to become .. A’khan."
    ec "No caminho para se tornar... A'khan."

# game/chapters/chapter6/ch6sc4.rpy:2295
translate brazil ch6sc4_2ac9da9f:

#   ec "Everything since has only further amplified my feelings for you, which brings us to this very moment."
    ec "Tudo o que aconteceu desde então só intensificou meus sentimentos por você, o que nos traz a este exato momento."

# game/chapters/chapter6/ch6sc4.rpy:2296
translate brazil ch6sc4_cc1caa0b:

#   ec "My heart was not mistaken."
    ec "Meu coração não se enganou."

# game/chapters/chapter6/ch6sc4.rpy:2297
translate brazil ch6sc4_889cfcda:

#   ec "It was right to have pointed itself at you."
    ec "Foi correto que tenha se voltado para você."

# game/chapters/chapter6/ch6sc4.rpy:2299
translate brazil ch6sc4_1471b99e:

#   ec "My heart is true, so I know this."
    ec "Meu coração é sincero, por isso eu sei disso."

# game/chapters/chapter6/ch6sc4.rpy:2300
translate brazil ch6sc4_0c5790f8:

#   ec "I love you."
    ec "Eu te amo."

# game/chapters/chapter6/ch6sc4.rpy:2301
translate brazil ch6sc4_42da931b:

#   ec "You’ve made it so easy to fall for you..."
    ec "Você tornou tudo tão fácil para me apaixonar por você..."

# game/chapters/chapter6/ch6sc4.rpy:2302
translate brazil ch6sc4_ad218ef1:

#   ec "So... easy for me to... enjoy."
    ec "Então... é fácil para mim... aproveitar."

# game/chapters/chapter6/ch6sc4.rpy:2304
translate brazil ch6sc4_2c4dcf98:

#   "Echo eyes you up and down, biting her lip in a futile attempt to contain her desire."
    "Echo olha você de cima a baixo, mordendo o lábio numa tentativa inútil de conter seu desejo."

# game/chapters/chapter6/ch6sc4.rpy:2306
translate brazil ch6sc4_cfaea9b6:

#   mc "You’re quite easy to enjoy, too."
    mc "Você também é uma pessoa muito agradável."

# game/chapters/chapter6/ch6sc4.rpy:2307
translate brazil ch6sc4_00a7f8fb:

#   mc "I’ve told you before, and I’ll tell you again..."
    mc "Eu já te disse antes, e vou te dizer de novo..."

# game/chapters/chapter6/ch6sc4.rpy:2309
translate brazil ch6sc4_06c9a752:

#   mc "Your body is shaped like you are a goddess."
    mc "Seu corpo tem o formato de uma deusa."

# game/chapters/chapter6/ch6sc4.rpy:2310
translate brazil ch6sc4_20c6794c:

#   ec "Mmmh... such blasphemous words."
    ec "Hum... que palavras blasfemas."

# game/chapters/chapter6/ch6sc4.rpy:2311
translate brazil ch6sc4_13b2f508:

#   ec "Yet... I can't refute them because you have actually met a goddess."
    ec "No entanto... não posso refutá-los porque você realmente conheceu uma deusa."

# game/chapters/chapter6/ch6sc4.rpy:2313
translate brazil ch6sc4_8bf683e7:

#   mc "And not only does your body stir an untamed hunger within me..."
    mc "E seu corpo não apenas desperta em mim uma fome indomável..."

# game/chapters/chapter6/ch6sc4.rpy:2314
translate brazil ch6sc4_325695f1:

#   mc "You have a heart and mind to match..."
    mc "Você tem um coração e uma mente à altura..."

# game/chapters/chapter6/ch6sc4.rpy:2315
translate brazil ch6sc4_8b09bb87:

#   mc "I value your company far more than any ancient artifact or relic."
    mc "Prezo muito mais a sua empresa do que qualquer artefato ou relíquia antiga."

# game/chapters/chapter6/ch6sc4.rpy:2318
translate brazil ch6sc4_0524261e:

#   ec "D-Do you truly mean all of this?"
    ec "Você está falando sério mesmo sobre tudo isso?"

# game/chapters/chapter6/ch6sc4.rpy:2320
translate brazil ch6sc4_12952c0e:

#   mc "Yes, Echo... I do."
    mc "Sim, Echo... eu sei."

# game/chapters/chapter6/ch6sc4.rpy:2321
translate brazil ch6sc4_97481b94:

#   mc "Every moment with you is precious to me."
    mc "Cada momento com você é precioso para mim."

# game/chapters/chapter6/ch6sc4.rpy:2323
translate brazil ch6sc4_68e8a205:

#   ec "I... [mc], I feel the same."
    ec "EU... [mc] Eu sinto o mesmo."

# game/chapters/chapter6/ch6sc4.rpy:2324
translate brazil ch6sc4_16e2d5b5:

#   ec "Before you arrived in A’nai..."
    ec "Antes de você chegar em A'nai..."

# game/chapters/chapter6/ch6sc4.rpy:2326
translate brazil ch6sc4_71b8da60:

#   ec "My days were so empty and lifeless."
    ec "Meus dias eram tão vazios e sem vida."

# game/chapters/chapter6/ch6sc4.rpy:2327
translate brazil ch6sc4_baa86419:

#   ec "*Exhales* Everything stayed the same."
    ec "*Exala* Tudo permaneceu igual."

# game/chapters/chapter6/ch6sc4.rpy:2328
translate brazil ch6sc4_5d7054f9:

#   ec "One sunrise, followed by another, and another."
    ec "Um nascer do sol, seguido de outro, e outro."

# game/chapters/chapter6/ch6sc4.rpy:2329
translate brazil ch6sc4_ff248ca1:

#   ec "Nothing ever changed. Life was an endlessly repeating cycle."
    ec "Nada jamais mudava. A vida era um ciclo que se repetia infinitamente."

# game/chapters/chapter6/ch6sc4.rpy:2331
translate brazil ch6sc4_72e223ff:

#   ec "I felt... suffocated by how monotonous each day had become."
    ec "Eu me sentia... sufocada pela monotonia que cada dia havia alcançado."

# game/chapters/chapter6/ch6sc4.rpy:2332
translate brazil ch6sc4_31f23d41:

#   ec "But now, everything has begun to change."
    ec "Mas agora, tudo começou a mudar."

# game/chapters/chapter6/ch6sc4.rpy:2334
translate brazil ch6sc4_e2a875ba:

#   ec "All that was once grey and monotone has become vibrant with color."
    ec "Tudo o que antes era cinza e monótono agora se tornou vibrante e colorido."

# game/chapters/chapter6/ch6sc4.rpy:2335
translate brazil ch6sc4_49583c3c:

#   ec "Everything is blooming... I-I am blooming."
    ec "Tudo está florescendo... Eu estou florescendo."

# game/chapters/chapter6/ch6sc4.rpy:2336
translate brazil ch6sc4_392251d7:

#   ec "For the first time in... since I can remember, I feel completely alive."
    ec "Pela primeira vez em... desde que me lembro, sinto-me completamente vivo."

# game/chapters/chapter6/ch6sc4.rpy:2338
translate brazil ch6sc4_ad77d001:

#   ec "The air is filled with scents I had long forgotten..."
    ec "O ar está repleto de aromas que eu havia esquecido há muito tempo..."

# game/chapters/chapter6/ch6sc4.rpy:2339
translate brazil ch6sc4_12824d30:

#   ec "The rays of the sun feel warm again as they caress my skin..."
    ec "Os raios de sol voltam a aquecer enquanto acariciam minha pele..."

# game/chapters/chapter6/ch6sc4.rpy:2341
translate brazil ch6sc4_2354c353:

#   ec "You..."
    ec "Você..."

# game/chapters/chapter6/ch6sc4.rpy:2343
translate brazil ch6sc4_9e6f11df:

#   mc "Me?"
    mc "Meu?"

# game/chapters/chapter6/ch6sc4.rpy:2345
translate brazil ch6sc4_13bd385b:

#   ec "You’ve made me bloom."
    ec "Você me fez florescer."

# game/chapters/chapter6/ch6sc4.rpy:2346
translate brazil ch6sc4_52048fef:

#   mc "I’m glad I’ve made you feel like that."
    mc "Fico feliz por ter feito você se sentir assim."

# game/chapters/chapter6/ch6sc4.rpy:2348
translate brazil ch6sc4_d06dba20:

#   ec "You’ve made me feel much more than that..."
    ec "Você me fez sentir muito mais do que isso..."

# game/chapters/chapter6/ch6sc4.rpy:2349
translate brazil ch6sc4_03db2902:

#   ec "It is hard for me to find the words, the overwhelming desire I feel rising inside me whenever we’re together."
    ec "É difícil para mim encontrar as palavras, o desejo avassalador que sinto crescer dentro de mim sempre que estamos juntos."

# game/chapters/chapter6/ch6sc4.rpy:2351
translate brazil ch6sc4_f1f33dd6:

#   mc "You don’t have to explain it."
    mc "Você não precisa explicar."

# game/chapters/chapter6/ch6sc4.rpy:2352
translate brazil ch6sc4_785fbc70:

#   mc "I feel it too."
    mc "Eu também sinto isso."

# game/chapters/chapter6/ch6sc4.rpy:2354
translate brazil ch6sc4_aeca61e4:

#   ec "Then, instead of using words..."
    ec "Então, em vez de usar palavras..."

# game/chapters/chapter6/ch6sc4.rpy:2357
translate brazil ch6sc4_0fb9f713:

#   ec "I think it's time to use our bodies to communicate our feelings."
    ec "Acho que está na hora de usarmos nossos corpos para comunicar nossos sentimentos."

# game/chapters/chapter6/ch6sc4.rpy:2358
translate brazil ch6sc4_9164c4cc:

#   ec "Mmm... touch me, [mc]..."
    ec "Hum... me toque, [mc]..."

# game/chapters/chapter6/ch6sc4.rpy:2359
translate brazil ch6sc4_d80aa9dc:

#   mc "I can feel your heart racing through your breast."
    mc "Consigo sentir seu coração acelerado através do seu peito."

# game/chapters/chapter6/ch6sc4.rpy:2360
translate brazil ch6sc4_4305bf99:

#   ec "It has been like this since you said I am special to you."
    ec "Tem sido assim desde que você disse que eu sou especial para você."

# game/chapters/chapter6/ch6sc4.rpy:2361
translate brazil ch6sc4_902e6e79:

#   ec "I cannot seem to calm it."
    ec "Não consigo acalmá-lo."

# game/chapters/chapter6/ch6sc4.rpy:2363
translate brazil ch6sc4_d5ee0e88:

#   ec "I want us to share our bodies with each other."
    ec "Quero que compartilhemos nossos corpos um com o outro."

# game/chapters/chapter6/ch6sc4.rpy:2365
translate brazil ch6sc4_d8606ebc:

#   mc "Are you certain? As the A’nu, your purity is sacred, only for your A’khan..."
    mc "Tem certeza? Como A'nu, sua pureza é sagrada, somente para seu A'khan..."

# game/chapters/chapter6/ch6sc4.rpy:2367
translate brazil ch6sc4_04dd8caf:

#   ec "I’ve never been more certain. If you do not wish for my purity to have been spoiled..."
    ec "Nunca estive tão certo. Se você não deseja que minha pureza seja corrompida..."

# game/chapters/chapter6/ch6sc4.rpy:2368
translate brazil ch6sc4_198cb911:

#   ec "Then you... will have to become the A’khan of my people."
    ec "Então você... terá que se tornar o A'khan do meu povo."

# game/chapters/chapter6/ch6sc4.rpy:2370
translate brazil ch6sc4_5ed6a1cd:

#   mc "*Chuckles* I suppose we could call this an advance on me becoming A’khan."
    mc "*Risos* Acho que podemos chamar isso de um avanço para eu me tornar A'khan."

# game/chapters/chapter6/ch6sc4.rpy:2371
translate brazil ch6sc4_164414f1:

#   mc "A little taste-test?"
    mc "Uma pequena degustação?"

# game/chapters/chapter6/ch6sc4.rpy:2372
translate brazil ch6sc4_f9a486f6:

#   ec "*Giggles softly* ..."
    ec "*Ri baixinho* ..."

# game/chapters/chapter6/ch6sc4.rpy:2374
translate brazil ch6sc4_71f73f05:

#   ec "Exactly... I have followed my heart since you arrived, and it has led me here, to be with you."
    ec "Exatamente... Tenho seguido meu coração desde que você chegou, e ele me trouxe até aqui, para estar com você."

# game/chapters/chapter6/ch6sc4.rpy:2375
translate brazil ch6sc4_bac55b5a:

#   ec "And my heart tells me that you are my A'khan, with or without any trials."
    ec "E meu coração me diz que você é meu A'khan, com ou sem provações."

# game/chapters/chapter6/ch6sc4.rpy:2376
translate brazil ch6sc4_55bad493:

