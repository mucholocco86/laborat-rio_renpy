#   mc "How are you feeling?"
    mc "Como você está se sentindo?"

# game/chapters/chapter6/ch6sc4.rpy:103
translate brazil ch6sc4_1f9b2a2d:

#   tz "Mr... Mr. Nephilim? Is that you?"
    tz "Senhor... Senhor Nefilim? É você?"

