translate brazil ch6sc4_771add93:

#   pl "He’ll be swimming like a fish! *Giggles*"
    pl "Ele vai nadar como um peixe! *Risos*"

# game/chapters/chapter6/ch6sc4.rpy:51
translate brazil ch6sc4_cced71d7:

#   mi "Swimming like a fish?"
    mi "Nadar como um peixe?"

# game/chapters/chapter6/ch6sc4.rpy:53
translate brazil ch6sc4_3ceacb55:

#   pl "He’ll be happy! That’s what it means."
    pl "Ele ficará feliz! É isso que significa."

# game/chapters/chapter6/ch6sc4.rpy:55
translate brazil ch6sc4_6bf55f5e:

#   mi "Oh! Oh... good."
    mi "Oh! Oh... que bom."

