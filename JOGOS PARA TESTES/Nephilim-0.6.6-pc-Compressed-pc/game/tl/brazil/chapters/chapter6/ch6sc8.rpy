translate brazil ch6sc8_77a840ec:

#   mc "How do you shelter your people?"
    mc "Como você protege seu povo?"

# game/chapters/chapter6/ch6sc8.rpy:545
translate brazil ch6sc8_326dffd3:

#   uk "How we manage things is of no concern to you, outsider."
    uk "A forma como gerimos as coisas não lhe diz respeito, forasteiro."

