    uk "Irmã Echo, né? Mentira."

# game/chapters/chapter6/ch6sc8.rpy:525
translate brazil ch6sc8_d62b6583:

#   uk "I don't know how you learned her name or title, but you will soon sing a different tune outsider."
    uk "Não sei como você descobriu o nome ou o título dela, mas em breve você cantará uma música diferente, forasteiro."

# game/chapters/chapter6/ch6sc8.rpy:532
translate brazil ch6sc8_0d80261e:

