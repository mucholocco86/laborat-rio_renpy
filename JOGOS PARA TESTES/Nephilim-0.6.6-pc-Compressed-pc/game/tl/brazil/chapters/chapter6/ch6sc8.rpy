    mc "Então, vou perguntar pela última vez… renda-se."

# game/chapters/chapter6/ch6sc8.rpy:1938
translate brazil ch6sc8_f42f995e:

#   "Riven nods in agreement, in doing so she lets out a long-winded sigh."
    "Riven acena com a cabeça em concordância e, ao fazê-lo, solta um longo suspiro."

