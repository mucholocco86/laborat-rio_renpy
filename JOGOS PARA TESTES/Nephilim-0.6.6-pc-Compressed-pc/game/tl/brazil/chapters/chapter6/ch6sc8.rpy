translate brazil ch6sc8_fe9dace0:

#   mc "It is likely that whatever killed and ate that carcass outside is resting after such a large meal."
    mc "É provável que o que quer que tenha matado e comido aquela carcaça lá fora esteja descansando após uma refeição tão farta."

# game/chapters/chapter6/ch6sc8.rpy:102
translate brazil ch6sc8_86bb68eb:

#   mc "If we can avoid disturbing or awakening it, we should try to do so."
    mc "Se pudermos evitar perturbá-lo ou despertá-lo, devemos tentar fazê-lo."

# game/chapters/chapter6/ch6sc8.rpy:104
translate brazil ch6sc8_778ccd88:

#   pl "Sorry… I didn’t think about that."
    pl "Desculpe… não pensei nisso."

# game/chapters/chapter6/ch6sc8.rpy:105
translate brazil ch6sc8_d782fe50:

#   pl "I’ll try to be quiet."
    pl "Vou tentar ficar em silêncio."

# game/chapters/chapter6/ch6sc8.rpy:107
translate brazil ch6sc8_81d2d43c:

#   tz "Yes, you won’t even notice we’re here."
    tz "Sim, você nem vai perceber que estamos aqui."

# game/chapters/chapter6/ch6sc8.rpy:108
translate brazil ch6sc8_ff9bc089:

#   tz "*Hushed* {size=-3}Teeeaaam stealth!{/size}"
    tz "*Sussurrado* {size=-3} Equipe furtiva!{/size}"

