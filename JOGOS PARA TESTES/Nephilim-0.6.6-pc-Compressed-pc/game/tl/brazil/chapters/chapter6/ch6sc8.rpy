translate brazil ch6sc8_9db103bb:

#   pl "Just be careful and take your time with each pillar."
    pl "Tenha cuidado e dedique tempo a cada pilar."

# game/chapters/chapter6/ch6sc8.rpy:130
translate brazil ch6sc8_5d2339b4:

#   tz "*Nods*"
    tz "*Acena com a cabeça*"

# game/chapters/chapter6/ch6sc8.rpy:132
translate brazil ch6sc8_e637bea1:

#   mc "I’ll go last, in case something happens and either of you need assistance."
    mc "Eu vou por último, caso algo aconteça e algum de vocês precise de ajuda."

# game/chapters/chapter6/ch6sc8.rpy:133
translate brazil ch6sc8_5d696af5:

#   pl "I’ll be fine, keep your eyes on Taz."
    pl "Eu vou ficar bem, fique de olho no Taz."

# game/chapters/chapter6/ch6sc8.rpy:137
translate brazil ch6sc8_36db489e:

#   pl "Although… if you happen to peek in my direction, I won’t be complaining. *Giggles softly*"
    pl "Mas... se por acaso você der uma espiadinha na minha direção, eu não vou reclamar. *Risinhos suaves*"

# game/chapters/chapter6/ch6sc8.rpy:138
translate brazil ch6sc8_45c2f442:

#   mc "*Chuckles* …"
    mc "*Risos* …"

# game/chapters/chapter6/ch6sc8.rpy:139
translate brazil ch6sc8_1ab633f4:

#   pl "Who knows, maybe my skirt will reveal something peachy during my jumps..."
    pl "Quem sabe, talvez minha saia revele algo interessante durante meus saltos..."

# game/chapters/chapter6/ch6sc8.rpy:145
translate brazil ch6sc8_6ea0278c:

#   pl "Uh-oh, okay… the pillars aren’t too big but they are rather stable."
    pl "Ih, ok... os pilares não são muito grandes, mas são bastante estáveis."

# game/chapters/chapter6/ch6sc8.rpy:146
translate brazil ch6sc8_984fae50:

#   pl "Take note Taz, it’s important you stabilize your feet and keep a slight bend in your knees."
    pl "Preste atenção, Taz, é importante que você estabilize os pés e mantenha os joelhos ligeiramente flexionados."

# game/chapters/chapter6/ch6sc8.rpy:147
translate brazil ch6sc8_72e89d63:

#   pl "Otherwise you might lose your balance which is a big no no in this situation."
    pl "Caso contrário, você pode perder o equilíbrio, o que é extremamente inaceitável nesta situação."

# game/chapters/chapter6/ch6sc8.rpy:149
translate brazil ch6sc8_22d21e23:

#   mct "{i}Pearl makes it look easy, she has great balance and agility.{/i}"
    mct "{i}Pearl faz tudo parecer fácil, ela tem ótimo equilíbrio e agilidade.{/i}"

# game/chapters/chapter6/ch6sc8.rpy:150
translate brazil ch6sc8_a08c92dd:

#   mct "{i}Taz is quite the opposite, no combat experience to help her in this situation.{/i}"
    mct "{i}Taz é exatamente o oposto, sem nenhuma experiência em combate para ajudá-la nessa situação.{/i}"

# game/chapters/chapter6/ch6sc8.rpy:151
translate brazil ch6sc8_de025c9d:

#   mct "{i}But she claims she wants to accompany me on adventures, so she’ll have to learn this stuff.{/i}"
    mct "{i}Mas ela afirma que quer me acompanhar em aventuras, então terá que aprender essas coisas.{/i}"

# game/chapters/chapter6/ch6sc8.rpy:153
translate brazil ch6sc8_c7cddcae:

#   mc "Go on Taz, I’ll be right behind you."
    mc "Vai lá, Taz, eu já vou estar logo atrás de você."

# game/chapters/chapter6/ch6sc8.rpy:154
translate brazil ch6sc8_285a9cf1:

#   tz "P-Promise?"
    tz "Promessa?"

# game/chapters/chapter6/ch6sc8.rpy:155
translate brazil ch6sc8_705702fd:

#   mc "I won’t let you get hurt, I promise."
    mc "Eu não vou deixar você se machucar, eu prometo."

# game/chapters/chapter6/ch6sc8.rpy:156
translate brazil ch6sc8_08bb27b1:

#   tz "O-Okay… I wish we could go across like this, with your arm around me."
    tz "Tudo bem... Eu gostaria que pudéssemos atravessar assim, com você me abraçando."

# game/chapters/chapter6/ch6sc8.rpy:157
translate brazil ch6sc8_bb308946:

#   mc "I’d be happy to do so, but the pillars aren’t wide enough for both of us."
    mc "Eu adoraria fazer isso, mas os pilares não são largos o suficiente para nós dois."

# game/chapters/chapter6/ch6sc8.rpy:158
translate brazil ch6sc8_2bccdb3d:

#   tz "*Sighs* Just my luck… here goes."
    tz "*Suspiro* Justo a minha sorte... lá vou eu."

# game/chapters/chapter6/ch6sc8.rpy:160
translate brazil ch6sc8_2d410ccd:

#   "Taz leaps with all her might."
    "Taz salta com toda a sua força."

# game/chapters/chapter6/ch6sc8.rpy:161
translate brazil ch6sc8_d8fd8bbd:

#   tz "Hnnngh!"
    tz "Hnnngh!"

# game/chapters/chapter6/ch6sc8.rpy:163
translate brazil ch6sc8_03de0ab8:

#   tz "I did it! [mc], did you see?"
    tz "Eu consegui! [mc] Você viu?"

# game/chapters/chapter6/ch6sc8.rpy:164
translate brazil ch6sc8_cd14512f:

#   mc "Mhm, good job Taz."
    mc "Hum, bom trabalho, Taz."

# game/chapters/chapter6/ch6sc8.rpy:166
translate brazil ch6sc8_973cf248:

#   mc "I’m impressed, that was a great landing on your first jump."
    mc "Fiquei impressionado, foi uma ótima aterrissagem no seu primeiro salto."

# game/chapters/chapter6/ch6sc8.rpy:167
translate brazil ch6sc8_48281f94:

#   tz "If you’re watching me, I can’t fail… I won’t let that happen."
    tz "Se você está me observando, eu não posso falhar... Não vou deixar isso acontecer."

# game/chapters/chapter6/ch6sc8.rpy:169
translate brazil ch6sc8_862a61be:

#   tz "Please… keep your eyes on me."
    tz "Por favor… mantenha seus olhos em mim."

# game/chapters/chapter6/ch6sc8.rpy:173
translate brazil ch6sc8_66bb458d:

#   mc "You know I won’t be taking my eyes off a gorgeous woman such as you."
    mc "Você sabe que eu não vou tirar os olhos de uma mulher linda como você."

# game/chapters/chapter6/ch6sc8.rpy:174
translate brazil ch6sc8_13a757cb:

#   tz "*Snickers softly* Gorgeous huh? Compliment accepted!"
    tz "*Ri baixinho* Linda, né? Elogio aceito!"

# game/chapters/chapter6/ch6sc8.rpy:175
translate brazil ch6sc8_a90f8c54:

#   tz "Having a handsome man such as you watching me, it fills me with confidence."
    tz "Ter um homem bonito como você me observando me enche de confiança."

# game/chapters/chapter6/ch6sc8.rpy:179
translate brazil ch6sc8_24c6d4e1:

#   mc "Don’t worry, I’ll watch out for you."
    mc "Não se preocupe, eu vou cuidar de você."

# game/chapters/chapter6/ch6sc8.rpy:180
translate brazil ch6sc8_ffdea193:

#   tz "Thank you…"
    tz "Obrigado…"

# game/chapters/chapter6/ch6sc8.rpy:183
translate brazil ch6sc8_828d6976:

#   "Filled with confidence, Tazzy makes short work of the remaining pillars and you follow her with each jump."
    "Cheia de confiança, Tazzy supera rapidamente os pilares restantes e você a acompanha a cada salto."

# game/chapters/chapter6/ch6sc8.rpy:187
translate brazil ch6sc8_8f44fa9c:

#   mc "Great job Taz, we’re almost there."
    mc "Ótimo trabalho, Taz, estamos quase lá."

# game/chapters/chapter6/ch6sc8.rpy:188
translate brazil ch6sc8_e20695c0:

#   tz "I’m doing it [mc] I’m really doing it!"
    tz "Estou fazendo isso [mc] Estou mesmo a fazer isso!"

# game/chapters/chapter6/ch6sc8.rpy:191
translate brazil ch6sc8_b6eb2da0:

#   tz "*Gasps* {size=+10}UUaaahh!! [mc]!!{/size}"
    tz "*Suspiros* {size=+10} UUaaahh!! [mc]!!{/size}"

# game/chapters/chapter6/ch6sc8.rpy:192
translate brazil ch6sc8_ba148f52:

#   tz "I’m slippiiiiiing!"
    tz "Estou escorregando!"

# game/chapters/chapter6/ch6sc8.rpy:195
translate brazil ch6sc8_fccc28fc:

#   mc "Hnnh! I got you!"
    mc "Hnnh! Te peguei!"

# game/chapters/chapter6/ch6sc8.rpy:196
translate brazil ch6sc8_b80fc34d:

#   tz "*Gasps* Aiiyh! Gosh dolly! Y-You caught me?!"
    tz "*Suspiros* Aiiyh! Nossa, querida! V-Você me pegou?!"

# game/chapters/chapter6/ch6sc8.rpy:197
translate brazil ch6sc8_31564046:

#   mc "I said I would, didn’t I?"
    mc "Eu disse que faria, não disse?"

# game/chapters/chapter6/ch6sc8.rpy:199
translate brazil ch6sc8_0449aaae:

#   tz "Y-Your wind… it’s-... mmmh…"
    tz "Seu vento... é... hum..."

# game/chapters/chapter6/ch6sc8.rpy:200
translate brazil ch6sc8_6f8789a4:

#   tz "Blowing me in all sorts of… funny places… Nnghh…"
    tz "Me dando prazer em todos os tipos de… lugares engraçados… Nnghh…"

# game/chapters/chapter6/ch6sc8.rpy:201
translate brazil ch6sc8_0d0743b4:

#   mc "Close your eyes, I’ll get you to the other side."
    mc "Feche os olhos, eu te levarei para o outro lado."

# game/chapters/chapter6/ch6sc8.rpy:203
translate brazil ch6sc8_f833ba15:

#   tz "O-Okay…"
    tz "O-Okay…"

# game/chapters/chapter6/ch6sc8.rpy:204
translate brazil ch6sc8_35ac5500:

#   tz "They’re closed."
    tz "Estão fechados."

# game/chapters/chapter6/ch6sc8.rpy:206
translate brazil ch6sc8_f30ef06f:

#   tz "Woah! This is incredible! *Giggles*"
    tz "Uau! Isso é incrível! *Risos*"

# game/chapters/chapter6/ch6sc8.rpy:207
translate brazil ch6sc8_cc8f3455:

#   pl "Taz! You had me worried for a second, you’re lucky [mc] was ready for you."
    pl "Taz! Você me deixou preocupado por um segundo, você tem sorte. [mc] Estava pronto para você."

# game/chapters/chapter6/ch6sc8.rpy:208
translate brazil ch6sc8_9fd5ad69:

#   tz "Trust me, I feel very… lucky."
    tz "Acredite, eu me sinto muito... sortudo."

# game/chapters/chapter6/ch6sc8.rpy:213
translate brazil ch6sc8_f1cb7220:

#   "As you cross the last few pillars, the three of you begin to make your way into the next area."
    "Ao ultrapassarem os últimos pilares, vocês três começam a seguir para a próxima área."

# game/chapters/chapter6/ch6sc8.rpy:218
translate brazil ch6sc8_f42ce749:

#   tz "Thank you… for saving me back there, I would’ve been a goner if you hadn’t caught me."
    tz "Obrigado… por me salvar lá atrás, eu teria morrido se você não tivesse me segurado."

# game/chapters/chapter6/ch6sc8.rpy:220
translate brazil ch6sc8_104eb986:

#   mc "You know full well you don’t have to thank me."
    mc "Você sabe muito bem que não precisa me agradecer."

# game/chapters/chapter6/ch6sc8.rpy:222
translate brazil ch6sc8_e3f77410:

#   tz "I know, but I still feel grateful."
    tz "Eu sei, mas mesmo assim me sinto grato."

# game/chapters/chapter6/ch6sc8.rpy:223
translate brazil ch6sc8_3f03e505:

#   tz "Although, how come you didn’t just swoosh all three of us across from the beginning?"
    tz "Mas por que você não nos levou a todos os três para o outro lado desde o início?"

# game/chapters/chapter6/ch6sc8.rpy:225
translate brazil ch6sc8_461e8d4f:

#   pl "I think it’s because he’s trying to limit how much he uses his abilities, right?"
    pl "Acho que é porque ele está tentando limitar o uso de suas habilidades, certo?"

# game/chapters/chapter6/ch6sc8.rpy:227
translate brazil ch6sc8_9a70b219:

#   mc "Pearl’s right, using my abilities might seem straightforward, but my mentor always warned me-"
    mc "Pearl tem razão, usar minhas habilidades pode parecer simples, mas meu mentor sempre me alertou..."

# game/chapters/chapter6/ch6sc8.rpy:228
translate brazil ch6sc8_d47adbcb:

#   mc "That using them too much, could lead me down a path that is hard to navigate."
    mc "O uso excessivo desses recursos pode me levar por um caminho difícil de percorrer."

# game/chapters/chapter6/ch6sc8.rpy:229
translate brazil ch6sc8_e991e7d2:

#   mc "A path that could be impossible to return from…"
    mc "Um caminho do qual pode ser impossível retornar…"

# game/chapters/chapter6/ch6sc8.rpy:231
translate brazil ch6sc8_6e1ffc42:

#   tz "Goodness golly… I’m sorry, I did not think of that."
    tz "Nossa… Desculpe, eu não tinha pensado nisso."

# game/chapters/chapter6/ch6sc8.rpy:233
translate brazil ch6sc8_494d743d:

#   pl "What does it feel like when you use your abilities?"
    pl "Qual é a sensação de usar suas habilidades?"

# game/chapters/chapter6/ch6sc8.rpy:235
translate brazil ch6sc8_49905913:

#   mc "It feels empowering… but I guess that’s where the danger lies."
    mc "É uma sensação de empoderamento... mas acho que é aí que reside o perigo."

# game/chapters/chapter6/ch6sc8.rpy:236
translate brazil ch6sc8_cfe9f654:

#   mc "You can get addicted to such a feeling, until it engulfs you."
    mc "Você pode ficar viciado nesse tipo de sensação, até que ela o consuma por completo."

# game/chapters/chapter6/ch6sc8.rpy:238
translate brazil ch6sc8_bffb1445:

#   pl "Like that Balthazar guy you told me and Kira about?"
    pl "Tipo aquele tal de Balthazar que você mencionou para mim e para a Kira?"

# game/chapters/chapter6/ch6sc8.rpy:240
translate brazil ch6sc8_8aac413c:

#   tz "Oh my! Balthazar is bad news, even back at the scriptorium."
    tz "Oh, céus! Balthazar é uma má notícia, mesmo lá no scriptorium."

# game/chapters/chapter6/ch6sc8.rpy:241
translate brazil ch6sc8_de3e7c88:

#   tz "If you could end up like him, you should be cautious with your abilities."
    tz "Se você corre o risco de acabar como ele, deve ter cautela com suas habilidades."

# game/chapters/chapter6/ch6sc8.rpy:243
translate brazil ch6sc8_0b9a32fd:

#   mc "You heard about him at the scriptorium?"
    mc "Você ouviu falar dele no scriptorium?"

# game/chapters/chapter6/ch6sc8.rpy:245
translate brazil ch6sc8_59f1dec5:

#   tz "Yes, before we are despatched on our journey, they go over several heroes and… villains."
    tz "Sim, antes de partirmos em nossa jornada, eles apresentam vários heróis e… vilões."

# game/chapters/chapter6/ch6sc8.rpy:247
translate brazil ch6sc8_a6f9648b:

#   tz "They typically choose certain heroes and villains from the world the chosen chronicler is sent to."
    tz "Eles geralmente escolhem certos heróis e vilões do mundo para o qual o cronista escolhido é enviado."

# game/chapters/chapter6/ch6sc8.rpy:248
translate brazil ch6sc8_ee1b0412:

#   tz "So in my case, the world being Midomir, I was briefed on Balthazar amongst others…"
    tz "Então, no meu caso, sendo o mundo Midomir, fui informado sobre Baltazar, entre outros…"

# game/chapters/chapter6/ch6sc8.rpy:250
translate brazil ch6sc8_6c6a4504:

#   tz "He was a Nephilim like [mc]... only his mind darkened over the ages, until nothing but brutality was left."
    tz "Ele era um Nefilim, assim como ele. [mc]... sua mente se obscureceu com o passar dos séculos, até que nada restou além da brutalidade."

# game/chapters/chapter6/ch6sc8.rpy:252
translate brazil ch6sc8_0078ac91:

#   tz "When it was discovered just how deep his darkness had taken root, it was already too late."
    tz "Quando se descobriu a profundidade das suas raízes sombrias, já era tarde demais."

# game/chapters/chapter6/ch6sc8.rpy:253
translate brazil ch6sc8_6889d0c5:

#   tz "He had become nigh unstoppable."
    tz "Ele havia se tornado praticamente imparável."

# game/chapters/chapter6/ch6sc8.rpy:255
translate brazil ch6sc8_c31d78d3:

#   tz "Only with the Divines blessing rings for 10 of the worlds most capable mages, who even had to infuse their own souls to said rings…"
    tz "Somente com a bênção dos Divinos, anéis para 10 dos magos mais capazes do mundo, que inclusive tiveram que infundir suas próprias almas nesses anéis…"

# game/chapters/chapter6/ch6sc8.rpy:256
translate brazil ch6sc8_609c7b02:

#   tz "Did they manage to stop him… seal him away into the abyss."
    tz "Será que conseguiram detê-lo... selá-lo no abismo?"

# game/chapters/chapter6/ch6sc8.rpy:258
translate brazil ch6sc8_bc9e6e1e:

#   pl "If [mc] falls to darkness… I won’t let anyone harm him."
    pl "Se [mc] Cai na escuridão… Não deixarei ninguém lhe fazer mal."

# game/chapters/chapter6/ch6sc8.rpy:260
translate brazil ch6sc8_898446fe:

#   tz "I am not allowed to have my own bias on the matter, but I can’t help but want for you to remain as you are…"
    tz "Não me é permitido ter minha própria opinião sobre o assunto, mas não consigo evitar o desejo de que você permaneça como está…"

# game/chapters/chapter6/ch6sc8.rpy:261
translate brazil ch6sc8_14a97677:

#   tz "Not become what Balthazar became. Corrupted by darkness and chaos."
    tz "Não se tornar o que Baltazar se tornou. Corrompido pelas trevas e pelo caos."

# game/chapters/chapter6/ch6sc8.rpy:263
translate brazil ch6sc8_40e54093:

#   mc "I have no intention of becoming like him, which again… is why I try to limit my usage of my powers if they aren’t needed."
    mc "Não tenho nenhuma intenção de me tornar como ele, e é por isso que tento limitar o uso dos meus poderes quando não são necessários."

# game/chapters/chapter6/ch6sc8.rpy:264
translate brazil ch6sc8_0854e5ab:

#   mc "I doubt I’m close to falling over the edge, but then again… I’m sure Balthazar didn’t believe his own corruption either."
    mc "Duvido que eu esteja perto de perder a cabeça, mas, por outro lado... tenho certeza de que Baltazar também não acreditava na própria corrupção."

# game/chapters/chapter6/ch6sc8.rpy:266
translate brazil ch6sc8_8993fb10:

#   pl "We’ll keep our eyes on you, if we notice any changes in you, we’ll let you know."
    pl "Vamos ficar de olho em você e, se notarmos alguma mudança, avisaremos."

# game/chapters/chapter6/ch6sc8.rpy:268
translate brazil ch6sc8_122f2823:

#   tz "Pearl’s right, you can count on us to tell you… it’s the least we can do."
    tz "Pearl tem razão, pode contar com a gente para lhe dizer… é o mínimo que podemos fazer."

# game/chapters/chapter6/ch6sc8.rpy:270
translate brazil ch6sc8_4ce48c35:

#   tz "Being made aware of potentially slipping into darkness could allow you to steer clear of it."
    tz "Tomar consciência do risco de mergulhar na escuridão pode permitir que você a evite."

# game/chapters/chapter6/ch6sc8.rpy:272
translate brazil ch6sc8_f398e686:

#   mc "Let’s hope you’re right… alright, enough chatting… we better get through this cave."
    mc "Tomara que você esteja certo… muito bem, chega de conversa… é melhor atravessarmos essa caverna."

# game/chapters/chapter6/ch6sc8.rpy:281
translate brazil ch6sc8_db0fe6a4:

#   mct "{i}In truth, I don’t know much about what happened to Balthazar or what Oren truly knew…{/i}"
    mct "{i}Na verdade, não sei muito sobre o que aconteceu com Balthazar ou o que Oren realmente sabia…{/i}"

# game/chapters/chapter6/ch6sc8.rpy:282
translate brazil ch6sc8_18f8f0ce:

#   mct "{i}Oren had done quite a bit of research but then again, he was just a man… with no ties to the age of Balthazar.{/i}"
    mct "{i}Oren havia feito bastante pesquisa, mas, afinal, ele era apenas um homem... sem qualquer ligação com a época de Baltazar.{/i}"

# game/chapters/chapter6/ch6sc8.rpy:283
translate brazil ch6sc8_359d6085:

#   mct "{i}What he knew or thought he knew, could easily have been morphed tales of the past.{/i}"
    mct "{i}O que ele sabia, ou pensava que sabia, poderia facilmente ter sido uma versão distorcida de histórias do passado.{/i}"

# game/chapters/chapter6/ch6sc8.rpy:285
translate brazil ch6sc8_5882ba37:

#   mct "{i}*Sighs* If only I could talk to someone who actually knows about these matters… wait-{/i}"
    mct "{i}*Suspiro* Se ao menos eu pudesse conversar com alguém que realmente entendesse desses assuntos… espera aí-{/i}"

# game/chapters/chapter6/ch6sc8.rpy:286
translate brazil ch6sc8_547aa167:

#   mct "{i}-Maia, she has to know? Fitting how I’m headed to see her next.{/i}"
    mct "{i}— Maia, ela deve saber, né? Faz sentido que eu vá vê-la em seguida.{/i}"

# game/chapters/chapter6/ch6sc8.rpy:287
translate brazil ch6sc8_0c93d38d:

#   mct "{i}I’ll add it to the growing list of things I’d love to talk to her about…{/i}"
    mct "{i}Vou adicionar isso à crescente lista de coisas sobre as quais adoraria conversar com ela…{/i}"

# game/chapters/chapter6/ch6sc8.rpy:291
translate brazil ch6sc8_efab7ece:

#   pl "There’s a foul stench coming from the area up ahead… yuck."
    pl "Há um cheiro horrível vindo da área mais à frente... que nojo."

# game/chapters/chapter6/ch6sc8.rpy:294
translate brazil ch6sc8_d9d5c330:

#   tz "Oof yeah… what the hell is that? It’s almost gut-punching with each breath."
    tz "Nossa, sim... que diabos é isso? É quase como um soco no estômago a cada respiração."

# game/chapters/chapter6/ch6sc8.rpy:295
translate brazil ch6sc8_d899d50b:

#   mc "*Hushed* {size=-7}{b}Quiet! The beast is resting up ahead.{/size}"
    mc "*Sussurrado* {size=-7}{b}Silêncio! A fera está descansando lá na frente.{/size}"

# game/chapters/chapter6/ch6sc8.rpy:297
translate brazil ch6sc8_24482cdc:

#   tz "*Whispers* {size=-7}{b}It’s huge! I’ve never imagined such a beast!"
    tz "*Sussurros* {size=-7}{b}É enorme! Nunca imaginei que existisse uma fera assim!"

# game/chapters/chapter6/ch6sc8.rpy:298
translate brazil ch6sc8_5936159b:

#   tz "*Whispers* {size=-7}{b}This must be it’s lair?"
    tz "*Sussurros* {size=-7}{b}Este deve ser o seu covil?"

# game/chapters/chapter6/ch6sc8.rpy:300
translate brazil ch6sc8_c768c6b0:

#   pl "*Whispers* {size=-7}{b}Hey… look at the opposite side of the lair, isn’t that?"
    pl "*Sussurros* {size=-7}{b}Ei... olha só para o outro lado do covil, não é?"

# game/chapters/chapter6/ch6sc8.rpy:301
translate brazil ch6sc8_9f4f6892:

#   mc "*Whispers* {size=-7}{b}Yeah I think it is, our way through."
    mc "*Sussurros* {size=-7}{b}Sim, acho que é, o nosso caminho."

# game/chapters/chapter6/ch6sc8.rpy:303
translate brazil ch6sc8_18e53292:

#   tz "*Whispers* {size=-7}{b}I’m sorry but are you two completely forgetting the huge and smelly beast laying directly in our way?"
    tz "*Sussurros* {size=-7}{b}Me desculpem, mas vocês dois estão se esquecendo completamente da enorme e fedorenta criatura que está bem na nossa frente?"

# game/chapters/chapter6/ch6sc8.rpy:304
translate brazil ch6sc8_df589b39:

#   mc "*Whispers* {size=-7}{b}We’ll sneak around it… be quiet and don’t make any sudden noises."
    mc "*Sussurros* {size=-7}{b}Vamos contornar a área sorrateiramente... fiquem quietos e não façam nenhum barulho repentino."

# game/chapters/chapter6/ch6sc8.rpy:306
translate brazil ch6sc8_23cd9f64:

#   pl "*Whispers* {size=-7}{b}If it wakes up, are we running or fighting it?"
    pl "*Sussurros* {size=-7}{b}Se ele acordar, vamos fugir ou lutar contra ele?"

# game/chapters/chapter6/ch6sc8.rpy:307
translate brazil ch6sc8_0614fe4c:

#   mc "*Whispers* {size=-7}{b}Running, we’ll run… we have Taz with us and there’s no telling how powerful this thing is."
    mc "*Sussurros* {size=-7}{b}Correndo, vamos correr… temos o Taz conosco e não dá para saber o quão poderoso ele é."

# game/chapters/chapter6/ch6sc8.rpy:308
translate brazil ch6sc8_89329a83:

#   pl "*Nods* {size=-7}{b}Mhm."
    pl "*Acena com a cabeça* {size=-7}{b}Hum."

# game/chapters/chapter6/ch6sc8.rpy:310
translate brazil ch6sc8_61c42acf:

#   tz "*Whispers* {size=-7}{b}One of you go first, please…"
    tz "*Sussurros* {size=-7}{b}Um de vocês pode ir primeiro, por favor…"

# game/chapters/chapter6/ch6sc8.rpy:312
translate brazil ch6sc8_597a37aa:

#   mc "*Whispers* {size=-7}{b}Taz, follow Pearl’s lead, she’s good at being stealthy.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Taz, siga o exemplo da Pearl, ela é ótima em ser discreta.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:313
translate brazil ch6sc8_7b31f637:

#   tz "*Whispers* {size=-7}{b}O-Okay, you’ll be right behind me? Right?{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}Certo, você vai ficar logo atrás de mim, né?{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:314
translate brazil ch6sc8_3ce987ed:

#   mc "*Whispers* {size=-7}{b}Yes, now go. We don’t want to be here for any longer than we need to.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Sim, agora vão. Não queremos ficar aqui mais tempo do que o necessário.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:316
translate brazil ch6sc8_5ce9d5f5:

#   tz "*Whispers* {size=-7}{b}Oh my… that thing is massive!{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}Nossa… aquilo é enorme!{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:317
translate brazil ch6sc8_6cdfe905:

#   tz "*Whispers* {size=-7}{b}It looks like a giant hairless wolf?{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}Parece um lobo gigante sem pelos?{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:319
translate brazil ch6sc8_3a43f87a:

#   mc "*Whispers* {size=-7}{b}I believe it’s something called a Warg.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Acredito que seja algo chamado Warg.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:320
translate brazil ch6sc8_2c913234:

#   mc "*Whispers* {size=-7}{b}My mentor, Oren. He had a bestiary with all manner of creatures.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Meu mentor, Oren. Ele tinha um bestiário com todo tipo de criatura.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:321
translate brazil ch6sc8_f77d3149:

#   tz "*Whispers* {size=-7}{b}Please don’t let it eat me…{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}Por favor, não deixe que isso me consuma…{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:323
translate brazil ch6sc8_200cdf11:

#   tz "*Whispers* {size=-7}{b}[mc]? You’re still with me right-{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}[mc]Você ainda está comigo, certo?{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:324
translate brazil ch6sc8_e7d4f4a1:

#   mc "*Whispers* {size=-7}{b}Yeah, I won’t let it eat you.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}É, eu não vou deixar isso te consumir.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:325
translate brazil ch6sc8_4ca32aec:

#   tz "*Whispers* {size=-7}{b}Oh thank goodness- Aiiyh-{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}Oh, graças a Deus! Aiiyh!{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:329
translate brazil ch6sc8_6777da2c:

#   mc "*Whispers* {size=-7}{b}I have an idea... stand still.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Tenho uma ideia... fique parado.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:331
translate brazil ch6sc8_dfe5ea78:

#   tz "*Whispers* {size=-7}{b}W-What's this? Oooh it tickles!{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}O que é isso? Oooh, faz cócegas!{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:332
translate brazil ch6sc8_ebcbd51b:

#   mc "*Whispers* {size=-7}{b}A while back I learned how to create Shadow-fog, we'll use it to sneak by the beast.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Há algum tempo aprendi a criar névoa sombria; vamos usá-la para passar sorrateiramente pela fera.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:334
translate brazil ch6sc8_0ef245a0:

#   tz "*Whispers* {size=-7}{b}G-Goodness! You keep surprising me [mc]...{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}Nossa! Você não para de me surpreender! [mc]...{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:335
translate brazil ch6sc8_7bf4cbda:

#   mc "*Whispers* {size=-7}{b}Don't worry Taz, I won't let anything happen to you.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Não se preocupe, Taz, eu não vou deixar nada acontecer com você.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:337
translate brazil ch6sc8_0a4aa6b7:

#   tz "*Whispers* {size=-7}{b}I'm not worried... I never am with you by my side.{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}Não estou preocupado... Nunca estou quando você está ao meu lado.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:338
translate brazil ch6sc8_35a2bd64:

#   tz "*Whispers* {size=-7}{b}What will this do?{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}O que isso vai fazer?{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:341
translate brazil ch6sc8_5200a16b:

#   "You successfully manifested Shadow-fog to remain undetected, your {b}{color=#745099}Stealth{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você manifestou com sucesso a Névoa Sombria para permanecer indetectável, seu {b}{color=#745099}Furtividade{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc8.rpy:342
translate brazil ch6sc8_cb9c4ce4:

#   tz "*Whispers* {size=-7}{b}Gosh-dolly! This feels oddly awesome! Like I'm levitating!{/b}{/size}"
    tz "*Sussurros* {size=-7}{b}Nossa! Que sensação estranhamente incrível! Parece que estou levitando!{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:343
translate brazil ch6sc8_6a5c120a:

#   mc "*Whispers* {size=-7}{b}You're not quite levitating, but it makes you almost weightless, so your footsteps won't be detected.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Você não chega a levitar, mas fica quase sem peso, então seus passos não serão detectados.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:344
translate brazil ch6sc8_0a0f024b:

#   mc "*Whispers* {size=-7}{b}Go on, head towards the exit and let's catch up to Pearl.{/b}{/size}"
    mc "*Sussurros* {size=-7}{b}Vamos lá, siga em direção à saída e vamos alcançar a Pearl.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:346
translate brazil ch6sc8_e9ee06b8:

#   "You and Taz successfully sneak past the beast without issue, and meet up with Pearl in the tunnel."
    "Você e Taz conseguem passar pela fera sem problemas e encontram Pearl no túnel."

# game/chapters/chapter6/ch6sc8.rpy:351
translate brazil ch6sc8_6e2b9780:

#   tz "Uh!"
    tz "Uh!"

# game/chapters/chapter6/ch6sc8.rpy:353
translate brazil ch6sc8_f19d00e0:

#   tz "On no! I didn’t mean to-"
    tz "Não! Eu não queria..."

# game/chapters/chapter6/ch6sc8.rpy:355
translate brazil ch6sc8_5265b77b:

#   mc "*Hushed* {b}Taz, stay still!{/b} Don’t move a muscle."
    mc "*Sussurrado* {b} Taz, fique parado!{/b} Não se mexa."

# game/chapters/chapter6/ch6sc8.rpy:357
translate brazil ch6sc8_0478c88c:

#   tz "[mc]! The rock! I’m so sorry!"
    tz "[mc]! A pedra! Me desculpe!"

# game/chapters/chapter6/ch6sc8.rpy:363
translate brazil ch6sc8_ee7a1c47:

#   uk "*Snarls* Hrrrrh…"
    uk "*Rosna* Hrrrrh…"

# game/chapters/chapter6/ch6sc8.rpy:367
translate brazil ch6sc8_0eedc408:

#   mc "Taz, {b}RUN!{/b}"
    mc "Taz, {b} CORRER!{/b}"

# game/chapters/chapter6/ch6sc8.rpy:369
translate brazil ch6sc8_edee760d:

#   tz "Uuuah it’s waking up!"
    tz "Uuuah, está acordando!"

# game/chapters/chapter6/ch6sc8.rpy:371
translate brazil ch6sc8_d2ad1bb2:

#   mc "{size=+10}{b}TAZ! MOVE!!{/b}{/size}"
    mc "{size=+10}{b}TAZ! SAI DA FRENTE!!{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:373
translate brazil ch6sc8_6e00ac10:

#   "With the need for stealth eliminated, you and Taz break into a full sprint while the beast let’s out a bloodcurdling roar behind you."
    "Sem a necessidade de furtividade, você e Taz partem para uma corrida a toda velocidade enquanto a fera solta um rugido arrepiante atrás de vocês."

# game/chapters/chapter6/ch6sc8.rpy:374
translate brazil ch6sc8_a5a4fa25:

#   tz "Aiiiyh!"
    tz "Aiiiyy!"

# game/chapters/chapter6/ch6sc8.rpy:375
translate brazil ch6sc8_1a027a50:

#   mc "Faster Taz!"
    mc "Taz mais rápido!"

# game/chapters/chapter6/ch6sc8.rpy:377
translate brazil ch6sc8_9809e23e:

#   "The three of you scramble in full sprint into the passage at the back of the beast’s lair."
    "Vocês três correm a toda velocidade para a passagem nos fundos da toca da fera."

# game/chapters/chapter6/ch6sc8.rpy:378
translate brazil ch6sc8_20868306:

#   tz "*Squeals* Is it still after us?"
    tz "*Gritos de alegria* Ainda está atrás de nós?"

# game/chapters/chapter6/ch6sc8.rpy:379
translate brazil ch6sc8_77d6b0b5:

#   mc "Yes!-"
    mc "Sim!-"

# game/chapters/chapter6/ch6sc8.rpy:380
translate brazil ch6sc8_f8206aa6:

#   "Before you can fully answer, you hear Taz scream from up ahead."
    "Antes que você possa responder completamente, ouve Taz gritar lá na frente."

# game/chapters/chapter6/ch6sc8.rpy:383
translate brazil ch6sc8_5c114e43:

#   tz "{size=+3}{b}HELP!!{/b}{/size}"
    tz "{size=+3}{b}AJUDA!!{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:384
translate brazil ch6sc8_0ded84d1:

#   "In her sprint and attempt to glance backwards, Tazzy slipped at the edge of a bottomless chasm, hanging on for her life."
    "Em sua corrida e na tentativa de olhar para trás, Tazzy escorregou na beira de um abismo sem fundo, agarrando-se com todas as forças."

# game/chapters/chapter6/ch6sc8.rpy:386
translate brazil ch6sc8_a00ff1a6:

#   tz "*Cries in terror* [mc]! Help!!"
    tz "*Chora de terror* [mc]! Ajuda!!"

# game/chapters/chapter6/ch6sc8.rpy:387
translate brazil ch6sc8_386cb8ec:

#   tz "I can’t hold on much longer! My grip is slipping!"
    tz "Não consigo aguentar por muito mais tempo! Estou perdendo a firmeza!"

# game/chapters/chapter6/ch6sc8.rpy:389
translate brazil ch6sc8_a3fed49e:

#   mc "Taz! You’re doing well, grab my hand!"
    mc "Taz! Você está indo bem, segure minha mão!"

# game/chapters/chapter6/ch6sc8.rpy:390
translate brazil ch6sc8_fbf261ab:

#   tz "I don’t know! I’m slipping!"
    tz "Não sei! Estou perdendo a cabeça!"

# game/chapters/chapter6/ch6sc8.rpy:392
translate brazil ch6sc8_0d6de518:

#   tz "Aiiiyh!!"
    tz "Aiiiyh!!"

# game/chapters/chapter6/ch6sc8.rpy:393
translate brazil ch6sc8_6d49ddc5:

#   mc "I got you!"
    mc "Te peguei!"

# game/chapters/chapter6/ch6sc8.rpy:394
translate brazil ch6sc8_3e97d636:

#   tz "Please get me up!"
    tz "Por favor, me ajude a levantar!"

# game/chapters/chapter6/ch6sc8.rpy:397
translate brazil ch6sc8_dc1e4c87:

#   "With the echoing roars of the Warg behind you, you pull her up firmly."
    "Com os rugidos ecoando atrás de você, você a puxa para cima com firmeza."

# game/chapters/chapter6/ch6sc8.rpy:398
translate brazil ch6sc8_5a0518fa:

#   tz "[mc]! Oh Thank you! I thought I was going to die!"
    tz "[mc] Oh, muito obrigada! Pensei que ia morrer!"

# game/chapters/chapter6/ch6sc8.rpy:399
translate brazil ch6sc8_b17c8a2b:

#   mc "Don’t worry Taz, I won’t let you die…"
    mc "Não se preocupe, Taz, eu não vou deixar você morrer…"

# game/chapters/chapter6/ch6sc8.rpy:400
translate brazil ch6sc8_f7c6675a:

#   tz "Please don’t let go of me! That was so terrifying!"
    tz "Por favor, não me solte! Foi tão assustador!"

# game/chapters/chapter6/ch6sc8.rpy:402
translate brazil ch6sc8_c924e2cc:

#   uk "*Deep roar* Hhhrrrhh!"
    uk "*Rugido profundo* Hhhrrrhh!"

# game/chapters/chapter6/ch6sc8.rpy:403
translate brazil ch6sc8_8ce25a1e:

#   mc "Taz, run to Pearl, I have an idea."
    mc "Taz, corre até a Pearl, eu tive uma ideia."

# game/chapters/chapter6/ch6sc8.rpy:404
translate brazil ch6sc8_508ac321:

#   tz "O-Okay! Please be careful!"
    tz "Tudo bem! Por favor, tenha cuidado!"

# game/chapters/chapter6/ch6sc8.rpy:406
translate brazil ch6sc8_c385ad14:

#   tz "[mc], please come with us!"
    tz "[mc] Por favor, venha conosco!"

# game/chapters/chapter6/ch6sc8.rpy:407
translate brazil ch6sc8_ac97e0a0:

#   mc "I’ll be right behind you. Trust me…"
    mc "Estarei logo atrás de você. Confie em mim…"

# game/chapters/chapter6/ch6sc8.rpy:409
translate brazil ch6sc8_04e9e506:

#   mc "We won’t be outrunning this thing with Taz, I’ll have to stop it."
    mc "Não vamos conseguir escapar dessa coisa com o Taz, vou ter que pará-la."

# game/chapters/chapter6/ch6sc8.rpy:410
translate brazil ch6sc8_f739ff88:

#   uk "HRhrhhrh!!"
    uk "HRrrhhh!!"

# game/chapters/chapter6/ch6sc8.rpy:413
translate brazil ch6sc8_45faf996:

#   mc "Here it comes!"
    mc "Lá vem ele!"

# game/chapters/chapter6/ch6sc8.rpy:416
translate brazil ch6sc8_d9253c0e:

#   mc "Huh?! My wind isn’t powerful enough down here to knock it back!"
    mc "Hã?! O vento aqui embaixo não é forte o suficiente para derrubá-lo!"

# game/chapters/chapter6/ch6sc8.rpy:417
translate brazil ch6sc8_76a7706a:

#   mc "He’s pushing right through it! Hnngh!"
    mc "Ele está passando por cima disso sem parar! Hnngh!"

# game/chapters/chapter6/ch6sc8.rpy:418
translate brazil ch6sc8_ec36cf03:

#   "Your wind gust does little to deter the beast, as it continues to launch itself towards you."
    "Sua rajada de vento pouco faz para deter a fera, que continua a se lançar em sua direção."

# game/chapters/chapter6/ch6sc8.rpy:421
translate brazil ch6sc8_4cf67416:

#   mc "*Groans* Hurrghh!"
    mc "*Gemidos* Argh!"

# game/chapters/chapter6/ch6sc8.rpy:422
translate brazil ch6sc8_3ef55ade:

#   mc "Fuck! I need to get out of its grasp quickly- Hnngh!"
    mc "Droga! Preciso me livrar disso rapidamente! Hnngh!"

# game/chapters/chapter6/ch6sc8.rpy:424
translate brazil ch6sc8_6268b436:

#   mc "Stalagmites… that could work!"
    mc "Estalagmites… isso poderia funcionar!"

# game/chapters/chapter6/ch6sc8.rpy:425
translate brazil ch6sc8_657b38ba:

#   mc "I can’t gather enough wind force down here to blow it upwards… but-"
    mc "Não consigo reunir força de vento suficiente aqui embaixo para soprá-lo para cima… mas-"

# game/chapters/chapter6/ch6sc8.rpy:427
translate brazil ch6sc8_5c7e3f40:

#   mc "The earth-affinity I’ve gained from the talisman should be even more potent down here."
    mc "A afinidade com a terra que adquiri com o talismã deve ser ainda mais potente aqui embaixo."

# game/chapters/chapter6/ch6sc8.rpy:429
translate brazil ch6sc8_21964149:

#   "While keeping the beast at bay with all your might, you concentrate some of your energy into the ground below you-"
    "Enquanto mantém a fera à distância com todas as suas forças, você concentra parte de sua energia no solo abaixo de você."

# game/chapters/chapter6/ch6sc8.rpy:430
translate brazil ch6sc8_c32d866f:

#   mc "As Oren taught me over the years, using elemental magic in areas of that element, will enhance it."
    mc "Como Oren me ensinou ao longo dos anos, usar magia elemental em áreas daquele elemento irá potencializá-la."

# game/chapters/chapter6/ch6sc8.rpy:431
translate brazil ch6sc8_54b3e386:

#   mc "Which is why my wind isn’t powerful down here, as there’s barely any natural air."
    mc "É por isso que o vento não é forte aqui embaixo, já que quase não há ar natural."

# game/chapters/chapter6/ch6sc8.rpy:432
translate brazil ch6sc8_bcb4c69c:

#   mc "Earth and rocks on the other hand? Plentiful in a place such as this… it’s ready!"
    mc "Terra e rochas, por outro lado? Abundantes num lugar como este… está tudo pronto!"

# game/chapters/chapter6/ch6sc8.rpy:436
translate brazil ch6sc8_5de1d9e0:

#   "You have managed to gather enough energy and as you shoot it directly into the ground it-"
    "Você conseguiu reunir energia suficiente e, ao dispará-la diretamente no chão, ela..."

# game/chapters/chapter6/ch6sc8.rpy:437
translate brazil ch6sc8_24141150:

#   "-Manifests a large stone pillar, sending the Warg soaring towards the ceiling and it’s many stalagmites."
    "-Manifesta um grande pilar de pedra, lançando o Warg em direção ao teto e suas inúmeras estalagmites."

# game/chapters/chapter6/ch6sc8.rpy:440
translate brazil ch6sc8_527a5992:

#   uk "*Roars* Hhrnnrhharrhh! Hhrh… hhhh…"
    uk "*Ruge* Hhrnnrhharrhh! Hhhh… hhhh…"

# game/chapters/chapter6/ch6sc8.rpy:443
translate brazil ch6sc8_6e0c17e7:

#   "You managed to manifest a giant stone-pillar to kill the beast, your {b}{color=#ff8400}Strength{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguiu manifestar um pilar de pedra gigante para matar a besta, seu {b}{color=#ff8400}Força{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc8.rpy:444
translate brazil ch6sc8_9e4c382d:

#   mc "*Out of breath* Hnngh… five hells…"
    mc "*Sem fôlego* Hnngh… pelos cinco infernos…"

# game/chapters/chapter6/ch6sc8.rpy:445
translate brazil ch6sc8_a6cd60e4:

#   mc "I need more practice with earth magic… it’s draining too much stamina at my current skill level."
    mc "Preciso praticar mais magia da terra... está consumindo muita energia no meu nível atual."

# game/chapters/chapter6/ch6sc8.rpy:453
translate brazil ch6sc8_8318a1d3:

#   pl "I knew you would manage! You even made it look easy!"
    pl "Eu sabia que você daria conta! Você até fez parecer fácil!"

# game/chapters/chapter6/ch6sc8.rpy:454
translate brazil ch6sc8_063c1ed8:

#   tz "Thank goodness! I wouldn’t have believed what just happened if I didn’t witness it!"
    tz "Graças a Deus! Eu não teria acreditado no que acabou de acontecer se não tivesse presenciado!"

# game/chapters/chapter6/ch6sc8.rpy:455
translate brazil ch6sc8_bcdec2c1:

#   "Both girls squeeze you tightly with no intention of letting go…"
    "As duas garotas te apertam com força, sem nenhuma intenção de te soltar…"

# game/chapters/chapter6/ch6sc8.rpy:456
translate brazil ch6sc8_13749bbb:

#   mc "Girls-... let me breathe…"
    mc "Meninas... me deixem respirar..."

# game/chapters/chapter6/ch6sc8.rpy:457
translate brazil ch6sc8_260d5320:

#   pl "We’re not letting go anytime soon! Isn’t that right Taz?"
    pl "Não vamos desistir tão cedo! Não é verdade, Taz?"

# game/chapters/chapter6/ch6sc8.rpy:458
translate brazil ch6sc8_ade8d3ea:

#   tz "She’s right! I was terrified you’d be made into a meal by that beast!"
    tz "Ela tem razão! Eu estava apavorada que você fosse devorada por aquela fera!"

# game/chapters/chapter6/ch6sc8.rpy:459
translate brazil ch6sc8_b5ee72d0:

#   mc "*Chuckles* Alright alright, get it out of your systems then…"
    mc "*Risos* Muito bem, muito bem, então desabafem..."

# game/chapters/chapter6/ch6sc8.rpy:462
translate brazil ch6sc8_ecf54309:

#   "The girls keep hugging you tightly for several minutes while praising you, as they finally relent their affections..."
    "As garotas continuam te abraçando forte por vários minutos enquanto te elogiam, até que finalmente cedem ao carinho..."

# game/chapters/chapter6/ch6sc8.rpy:467
translate brazil ch6sc8_11e11f54:

#   "The three of you continue down the passageway and within an hour you reach the exit."
    "Vocês três continuam pelo corredor e, em uma hora, chegam à saída."

# game/chapters/chapter6/ch6sc8.rpy:469
translate brazil ch6sc8_aa370aa5:

#   pl "Ahh… finally! I can feel fresh air from up ahead!"
    pl "Ahh… finalmente! Consigo sentir o ar fresco vindo de lá da frente!"

# game/chapters/chapter6/ch6sc8.rpy:470
translate brazil ch6sc8_800a3254:

#   mc "C’mon girls, let’s go get ourselves captured…"
    mc "Vamos lá, meninas, vamos nos deixar capturar…"

# game/chapters/chapter6/ch6sc8.rpy:471
translate brazil ch6sc8_39b0620a:

#   tz "I shan’t believe we’re actually letting ourselves be captured by a hostile tribe…"
    tz "Não acredito que realmente estamos nos deixando capturar por uma tribo hostil…"

# game/chapters/chapter6/ch6sc8.rpy:472
translate brazil ch6sc8_781e8553:

#   tz "The thought alone makes the hairs stand on the back of my neck."
    tz "Só de pensar nisso, os pelos da minha nuca se arrepiam."

# game/chapters/chapter6/ch6sc8.rpy:477
translate brazil ch6sc8_cb921449:

#   pl "There, I see light!"
    pl "Ali, vejo a luz!"

# game/chapters/chapter6/ch6sc8.rpy:478
translate brazil ch6sc8_0a27544a:

#   tz "Goodness! The sun has begun to set already?!"
    tz "Nossa! O sol já começou a se pôr?!"

# game/chapters/chapter6/ch6sc8.rpy:479
translate brazil ch6sc8_427b2c24:

#   mc "Don’t worry, according to the information we were given, the Arugoh tribe is located close to this side of the cave."
    mc "Não se preocupe, de acordo com as informações que nos foram dadas, a tribo Arugoh está localizada perto deste lado da caverna."

# game/chapters/chapter6/ch6sc8.rpy:480
translate brazil ch6sc8_807816c3:

#   mc "Just head straight forward once we’re outside, it should only be a 15 minute walk."
    mc "Assim que estivermos lá fora, basta seguir em frente; a caminhada deve levar apenas 15 minutos."

# game/chapters/chapter6/ch6sc8.rpy:485
translate brazil ch6sc8_05615386:

#   "After a short walk, the three of you make it clear of the heavy foliage and into a clearing."
    "Após uma curta caminhada, vocês três conseguem sair da densa folhagem e chegam a uma clareira."

# game/chapters/chapter6/ch6sc8.rpy:490
translate brazil ch6sc8_bb30fcf2:

#   pl "Looks like we made it."
    pl "Parece que conseguimos."

# game/chapters/chapter6/ch6sc8.rpy:491
translate brazil ch6sc8_d8dee17a:

#   tz "Somebody’s coming!"
    tz "Alguém está vindo!"

# game/chapters/chapter6/ch6sc8.rpy:493
translate brazil ch6sc8_1c2ead7a:

#   "Two women emerge from behind the fence."
    "Duas mulheres surgem de trás da cerca."

# game/chapters/chapter6/ch6sc8.rpy:494
translate brazil ch6sc8_be682055:

#   tz "Uhh… they don’t look too thrilled to see us."
    tz "Hum… eles não parecem muito contentes em nos ver."

# game/chapters/chapter6/ch6sc8.rpy:496
translate brazil ch6sc8_0931fd55:

#   pl "How can they look this good while angry? Kira could learn a thing or two from them. *Snickers*"
    pl "Como é que eles conseguem ficar tão bonitos quando estão zangados? A Kira podia aprender uma coisa ou duas com eles. *Risinhos*"

# game/chapters/chapter6/ch6sc8.rpy:497
translate brazil ch6sc8_f95581bd:

#   mc "*Whispers* {size=-10}{b}Remember we’re here to be captured.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Lembrem-se que estamos aqui para sermos capturados.{/b}{/size}"

# game/chapters/chapter6/ch6sc8.rpy:499
translate brazil ch6sc8_d21184a5:

#   uk "Outsiders, how foolish of you to travel into our territory."
    uk "Forasteiros, que tolice a vossa parte invadir o nosso território."

# game/chapters/chapter6/ch6sc8.rpy:500
translate brazil ch6sc8_8122f25f:

#   uk "But it saves us the trouble of having to hunt you down throughout the jungle."
    uk "Mas isso nos poupa o trabalho de ter que te caçar por toda a selva."

# game/chapters/chapter6/ch6sc8.rpy:502
translate brazil ch6sc8_e7602df3:

#   mc "How about you just let us pass, we’re only here for the ambassador you kidnapped."
    mc "Que tal nos deixar passar? Estamos aqui apenas por causa do embaixador que vocês sequestraram."

# game/chapters/chapter6/ch6sc8.rpy:503
