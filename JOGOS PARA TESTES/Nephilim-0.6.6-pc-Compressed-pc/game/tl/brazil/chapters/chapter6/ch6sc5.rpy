# ARQUIVO: game/chapters/chapter6/ch6sc5.rpy DIALOGOS: 1591


# game/chapters/chapter6/ch6sc5.rpy:7
translate brazil ch6sc5_5d715264:

#   da "The three of you did well today."
    da "Vocês três se saíram bem hoje."

# game/chapters/chapter6/ch6sc5.rpy:9
translate brazil ch6sc5_bd24f23b:

#   da "Borri, you have a lot of power in your blows."
    da "Borri, você tem muita força nos seus golpes."

# game/chapters/chapter6/ch6sc5.rpy:10
translate brazil ch6sc5_a00df576:

#   da "But your movements are too sluggish."
    da "Mas seus movimentos são muito lentos."

# game/chapters/chapter6/ch6sc5.rpy:11
translate brazil ch6sc5_6214946a:

#   da "It doesn't require much skill to evade your attacks."
    da "Não é preciso muita habilidade para se esquivar dos seus ataques."

# game/chapters/chapter6/ch6sc5.rpy:13
translate brazil ch6sc5_50469185:

#   da "So, you’ll be working on that going forward."
    da "Então, você vai trabalhar nisso daqui para frente."

# game/chapters/chapter6/ch6sc5.rpy:14
translate brazil ch6sc5_c3e2ccff:

#   da "All three of you will be working on shoring up your weaknesses."
    da "Vocês três trabalharão para fortalecer seus pontos fracos."

# game/chapters/chapter6/ch6sc5.rpy:15
translate brazil ch6sc5_8945c454:

#   da "There's no need to train aspects where you’re already strong."
    da "Não há necessidade de treinar aspectos nos quais você já é forte."

# game/chapters/chapter6/ch6sc5.rpy:16
translate brazil ch6sc5_97cc495f:

#   da "Which means we’ll focus on improving your weaknesses."
    da "Isso significa que nos concentraremos em melhorar seus pontos fracos."

# game/chapters/chapter6/ch6sc5.rpy:18
translate brazil ch6sc5_22cbc697:

#   da "Borri, that means you'll be working on your agility."
    da "Borri, isso significa que você vai trabalhar na sua agilidade."

# game/chapters/chapter6/ch6sc5.rpy:20
translate brazil ch6sc5_f57b0b16:

#   br "Bah! Dwarves aren’t known for their agility, Dalen!"
    br "Bah! Os anões não são conhecidos pela sua agilidade, Dalen!"

# game/chapters/chapter6/ch6sc5.rpy:21
translate brazil ch6sc5_8ff78134:

#   br "We're meant to swing big hammers or axes, with the strength and power to make it count!"
    br "Nosso objetivo é brandir grandes martelos ou machados, com a força e o poder necessários para fazer a diferença!"

# game/chapters/chapter6/ch6sc5.rpy:23
translate brazil ch6sc5_809e8f16:

#   da "I've met several dwarves who specialize as assassins and rogues."
    da "Já conheci vários anões especializados em assassinatos e ladinos."

# game/chapters/chapter6/ch6sc5.rpy:24
translate brazil ch6sc5_fcc1626a:

#   da "So, you will train your agility."
    da "Então, você vai treinar sua agilidade."

# game/chapters/chapter6/ch6sc5.rpy:25
translate brazil ch6sc5_a6ec7a4c:

#   br "*Grunts while nodding* Hmh."
    br "*Resmunga enquanto acena com a cabeça* Hmh."

# game/chapters/chapter6/ch6sc5.rpy:27
translate brazil ch6sc5_cea74626:

#   br "How come yer still standing? Bella landed multiple blows on ye."
    br "Como você ainda está de pé? Bella te acertou vários golpes."

# game/chapters/chapter6/ch6sc5.rpy:28
translate brazil ch6sc5_387551ef:

#   br "I know ye blocked several with yer arm and shinguards, but Bella is made of Vibranite."
    br "Eu sei que você bloqueou vários com seu braço e caneleiras, mas Bella é feita de Vibranite."

# game/chapters/chapter6/ch6sc5.rpy:29
translate brazil ch6sc5_108d48a0:

#   br "It's a rare smithing alloy... that creates shockwaves on impact."
    br "É uma liga metálica rara para forja... que cria ondas de choque ao sofrer impacto."

# game/chapters/chapter6/ch6sc5.rpy:30
translate brazil ch6sc5_447fc922:

#   br "It's effective even against armor 'cause it can shatter the bones beneath."
    br "É eficaz até mesmo contra armaduras, pois pode quebrar os ossos por baixo."

# game/chapters/chapter6/ch6sc5.rpy:32
translate brazil ch6sc5_03a0e6e1:

#   da "Vibranite, huh? That is both rare and expensive."
    da "Vibranite, hein? É raro e caro."

# game/chapters/chapter6/ch6sc5.rpy:33
translate brazil ch6sc5_1ff44d83:

#   da "I can see why you hold Bella in such high regard..."
    da "Entendo por que você tem Bella em tão alta consideração..."

# game/chapters/chapter6/ch6sc5.rpy:34
translate brazil ch6sc5_b529a6a7:

#   da "Even setting aside her sentimental value."
    da "Mesmo deixando de lado o valor sentimental que ela representa."

# game/chapters/chapter6/ch6sc5.rpy:35
translate brazil ch6sc5_12f5f781:

#   da "And yes, I did block rather than dodge several of your blows."
    da "E sim, eu bloqueei em vez de esquivar de vários dos seus golpes."

# game/chapters/chapter6/ch6sc5.rpy:37
translate brazil ch6sc5_1dc88a30:

#   da "But, you see, my armor isn’t made of regular steel either."
    da "Mas, veja bem, minha armadura também não é feita de aço comum."

# game/chapters/chapter6/ch6sc5.rpy:38
translate brazil ch6sc5_2a55fd3b:

#   da "It's forged from Palladium, a material only found deep within the mines of Arazalia."
    da "É forjado em paládio, um material encontrado apenas nas profundezas das minas de Arazalia."

# game/chapters/chapter6/ch6sc5.rpy:39
translate brazil ch6sc5_4a7d8eab:

#   da "It’s sturdy and lightweight, but its most important quality is that it is incredibly impact absorbent."
    da "É resistente e leve, mas sua qualidade mais importante é a incrível capacidade de absorver impactos."

# game/chapters/chapter6/ch6sc5.rpy:41
translate brazil ch6sc5_d9bbaa62:

#   da "If it wasn’t so damn rare and hard to acquire, I’d want all of us to have armor like mine."
    da "Se não fosse tão rara e difícil de conseguir, eu gostaria que todos nós tivéssemos uma armadura como a minha."

# game/chapters/chapter6/ch6sc5.rpy:42
translate brazil ch6sc5_f5d90eac:

#   da "It has saved my skin more than a few times over the years."
    da "Já salvou minha pele mais de uma vez ao longo dos anos."

# game/chapters/chapter6/ch6sc5.rpy:43
translate brazil ch6sc5_39ef7a9f:

#   da "Now, as for you Milton..."
    da "E quanto a você, Milton..."

# game/chapters/chapter6/ch6sc5.rpy:45
translate brazil ch6sc5_3e0f1c7a:

#   da "Your greatest strength seems to be your speed."
    da "Sua maior qualidade parece ser a velocidade."

# game/chapters/chapter6/ch6sc5.rpy:46
translate brazil ch6sc5_67c0af8d:

#   da "You’re quick and nimble, and you managed to dodge many of my strikes."
    da "Você é rápido e ágil, e conseguiu esquivar-se de muitos dos meus golpes."

# game/chapters/chapter6/ch6sc5.rpy:47
translate brazil ch6sc5_52a75020:

#   da "Unfortunately, given your size, your attacks lacked sufficient force to trouble me."
    da "Infelizmente, dado o seu tamanho, seus ataques não tiveram força suficiente para me incomodar."

# game/chapters/chapter6/ch6sc5.rpy:48
translate brazil ch6sc5_bfc3ee7d:

#   da "It was like being bitten by an ant: annoying, but nothing to worry about."
    da "Foi como ser picado por uma formiga: irritante, mas nada preocupante."

# game/chapters/chapter6/ch6sc5.rpy:49
translate brazil ch6sc5_2b04a9fc:

#   da "So, we’ll be working on putting some meat on your bones, as well as improving the technique of your strikes."
    da "Então, vamos trabalhar para que você ganhe mais massa muscular, além de aprimorar a técnica dos seus golpes."

# game/chapters/chapter6/ch6sc5.rpy:52
translate brazil ch6sc5_84b79f3f:

#   ml "Sir, yes sir!"
    ml "Sim, senhor!"

# game/chapters/chapter6/ch6sc5.rpy:53
translate brazil ch6sc5_dcde7719:

#   da "*Chuckles* At ease, adventurer Milton, you’re not a guard any more."
    da "*Risos* Fique tranquilo, aventureiro Milton, você não é mais um guarda."

# game/chapters/chapter6/ch6sc5.rpy:55
translate brazil ch6sc5_1b6f5def:

#   da "And Flynn, I’m glad you joined us today, even if your lack of previous combat training is obvious."
    da "E Flynn, fico feliz que você tenha se juntado a nós hoje, mesmo que sua falta de treinamento prévio em combate seja óbvia."

# game/chapters/chapter6/ch6sc5.rpy:57
translate brazil ch6sc5_833db4ca:

#   fy "What can I say? I’m a lover not a fighter."
    fy "O que posso dizer? Sou um amante, não um lutador."

# game/chapters/chapter6/ch6sc5.rpy:58
translate brazil ch6sc5_1bf7c38f:

#   fy "My talents are better suited to fine young maidens with shapely bosoms!"
    fy "Meus talentos se encaixam melhor em jovens donzelas de seios fartos!"

# game/chapters/chapter6/ch6sc5.rpy:60
translate brazil ch6sc5_20667fd9:

#   da "Be that as it may, you'll be better off knowing how to defend yourself."
    da "Seja como for, é melhor você saber como se defender."

# game/chapters/chapter6/ch6sc5.rpy:62
translate brazil ch6sc5_fa826316:

#   da "Now that Taron has been revealed as a traitor to the throne, his actions will likely be harder to predict."
    da "Agora que Taron foi revelado como um traidor do trono, suas ações provavelmente serão mais difíceis de prever."

# game/chapters/chapter6/ch6sc5.rpy:63
translate brazil ch6sc5_7b3f3a95:

#   da "He could act out against any of us if he sees an advantage to it."
    da "Ele poderia agir contra qualquer um de nós se visse alguma vantagem nisso."

# game/chapters/chapter6/ch6sc5.rpy:64
translate brazil ch6sc5_a6eacbfb:

#   da "So, the better prepared for battle we are, the better our odds of surviving."
    da "Portanto, quanto melhor preparados estivermos para a batalha, maiores serão nossas chances de sobrevivência."

# game/chapters/chapter6/ch6sc5.rpy:66
translate brazil ch6sc5_c9815511:

#   da "Even if you only learn the basics of combat, it could turn the tide of battle."
    da "Mesmo que você aprenda apenas o básico do combate, isso pode mudar o rumo da batalha."

# game/chapters/chapter6/ch6sc5.rpy:67
translate brazil ch6sc5_4fdac9b0:

#   da "Let’s say that Borri is squaring up against an evenly matched opponent ..."
    da "Digamos que Borri esteja enfrentando um adversário de nível semelhante..."

# game/chapters/chapter6/ch6sc5.rpy:68
translate brazil ch6sc5_0d0eac25:

#   da "Then having a second fighter like you, even if only trained in the basics, might help turn the tide of the battle."
    da "Então, ter um segundo lutador como você, mesmo que treinado apenas no básico, pode ajudar a virar o jogo."

# game/chapters/chapter6/ch6sc5.rpy:70
translate brazil ch6sc5_1788b8f5:

#   fy "Sounds good to me! I’ll become something akin to a battlefield bard!"
    fy "Parece ótimo! Vou me tornar algo parecido com um bardo de batalha!"

# game/chapters/chapter6/ch6sc5.rpy:71
translate brazil ch6sc5_ef2ce274:

#   fy "I'll inspire our allies to win any battle!"
    fy "Vou inspirar nossos aliados a vencer qualquer batalha!"

# game/chapters/chapter6/ch6sc5.rpy:73
translate brazil ch6sc5_54cc506f:

#   da "Something like that..."
    da "Algo assim..."

# game/chapters/chapter6/ch6sc5.rpy:75
translate brazil ch6sc5_e6dde4cc:

#   da "Let’s wrap up for today."
    da "Vamos encerrar por hoje."

# game/chapters/chapter6/ch6sc5.rpy:76
translate brazil ch6sc5_143936b2:

#   da "We’ll continue at dawn tomorrow and start working on your individual weaknesses."
    da "Continuaremos amanhã ao amanhecer e começaremos a trabalhar em seus pontos fracos individuais."

# game/chapters/chapter6/ch6sc5.rpy:78
translate brazil ch6sc5_16aaa3b9:

#   da "Go fill your bellies with a hearty meal, my treat for your efforts."
    da "Vão se deliciar com uma refeição farta, por minha conta como agradecimento pelo esforço de vocês."

# game/chapters/chapter6/ch6sc5.rpy:79
translate brazil ch6sc5_88573bf1:

#   fy "Yahoo! Let’s go eat our fill at the Drunken Rooster, lads!"
    fy "Eba! Vamos comer até não aguentar mais no Drunken Rooster, rapazes!"

# game/chapters/chapter6/ch6sc5.rpy:80
translate brazil ch6sc5_a91f643c:

#   ml "*Laughs* You like their food that much?"
    ml "*Risos* Você gosta tanto assim da comida deles?"

# game/chapters/chapter6/ch6sc5.rpy:81
translate brazil ch6sc5_e5e5b53a:

#   br "Hah! It’s that lass, Anna. Her milkers have him completely enchanted."
    br "Ah! É aquela moça, Anna. Os seios dela o deixaram completamente enfeitiçado."

# game/chapters/chapter6/ch6sc5.rpy:83
translate brazil ch6sc5_6b14dac0:

#   fy "Ooh... Anna."
    fy "Ah... Anna."

# game/chapters/chapter6/ch6sc5.rpy:84
translate brazil ch6sc5_d035007e:

#   fy "She has the biggest tit- the biggest personality I've ever seen!"
    fy "Ela tem os maiores peitos e a maior personalidade que eu já vi!"

# game/chapters/chapter6/ch6sc5.rpy:85
translate brazil ch6sc5_d54ca08a:

#   fy "She’s probably already worrying about why I haven’t shown up for ales yet. Come, come!"
    fy "Ela provavelmente já está preocupada porque eu ainda não apareci para tomar umas cervejas. Vamos, vamos!"

# game/chapters/chapter6/ch6sc5.rpy:96
translate brazil ch6sc5_76cd2e63:

#   "Back in A’nai the sun has begun to set, and some of the villagers are arranging a bonfire."
    "De volta a A'nai, o sol começou a se pôr e alguns moradores estão preparando uma fogueira."

# game/chapters/chapter6/ch6sc5.rpy:97
translate brazil ch6sc5_bab7fcc4:

#   "Seating arrangements have been prepared for those who wish to partake in the ceremony."
    "Os lugares já foram reservados para aqueles que desejam participar da cerimônia."

# game/chapters/chapter6/ch6sc5.rpy:98
translate brazil ch6sc5_699a4a30:

#   "As you approach, you can feel an excited energy in the air."
    "Ao se aproximar, você pode sentir uma energia vibrante no ar."

# game/chapters/chapter6/ch6sc5.rpy:100
translate brazil ch6sc5_10215417:

#   "The sound of lighthearted chatter spills out from the ceremonial area."
    "O som de conversas animadas ecoa da área cerimonial."

# game/chapters/chapter6/ch6sc5.rpy:101
translate brazil ch6sc5_51f176f8:

#   mct "{i}Seems like everyone is in high spirits.{/i}"
    mct "{i}Parece que todos estão de ótimo humor.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:103
translate brazil ch6sc5_a685abe8:

#   mct "Vex and Miyo are still building the bonfire."
    mct "Vex e Miyo ainda estão construindo a fogueira."

# game/chapters/chapter6/ch6sc5.rpy:104
translate brazil ch6sc5_6f66f9cb:

#   mct "I guess it’ll be a little while before things get started properly."
    mct "Acho que vai demorar um pouco até as coisas começarem de verdade."

# game/chapters/chapter6/ch6sc5.rpy:105
translate brazil ch6sc5_b8e713c8:

#   mct "{i}Might as well make the rounds.{/i}"
    mct "{i}Já que estamos aqui, podemos fazer a ronda.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:107
translate brazil ch6sc5_4bbd31dc:

#   mct "It’d be nice to get to know some of them a bit more..."
    mct "Seria bom conhecer alguns deles um pouco melhor..."

# game/chapters/chapter6/ch6sc5.rpy:108
translate brazil ch6sc5_f0ea4efa:

#   mct "Or at least maintain friendly relations with those I already know."
    mct "Ou pelo menos manter relações amigáveis ​​com aqueles que eu já conheço."

# game/chapters/chapter6/ch6sc5.rpy:110
translate brazil ch6sc5_643c3f25:

#   mct "{i}I’ll start off with Zyra and Suji.{/i}"
    mct "{i}Vou começar com Zyra e Suji.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:111
translate brazil ch6sc5_37b061bd:

#   mct "{i}You never know what you might get with those two. Sometimes, they're really strict and to the point.{/i}"
    mct "{i}Com esses dois, você nunca sabe o que esperar. Às vezes, eles são muito rigorosos e diretos.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:112
translate brazil ch6sc5_0002d4b7:

#   mct "{i}Other times, they’re quite friendly and patient.{/i}"
    mct "{i}Outras vezes, eles são bastante amigáveis ​​e pacientes.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:114
translate brazil ch6sc5_add634d0:

#   "As they see you approach, they begin smiling."
    "Ao verem você se aproximar, começam a sorrir."

# game/chapters/chapter6/ch6sc5.rpy:115
translate brazil ch6sc5_3960aad0:

#   mct "{i}They seem happy to see me.{/i}"
    mct "{i}Eles parecem felizes em me ver.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:117
translate brazil ch6sc5_01c4a773:

#   zy "Greetings, Champion."
    zy "Saudações, Campeão."

# game/chapters/chapter6/ch6sc5.rpy:118
translate brazil ch6sc5_b9c2e397:

#   zy "I wasn’t sure you’d make it."
    zy "Eu não tinha certeza se você conseguiria."

# game/chapters/chapter6/ch6sc5.rpy:120
translate brazil ch6sc5_98c2a770:

#   mc "And miss out on Vex’s ceremony? No chance."
    mc "E perder a cerimônia da Vex? Nem pensar."

# game/chapters/chapter6/ch6sc5.rpy:122
translate brazil ch6sc5_3ddc1ff8:

#   zy "I’m surprised and glad that you decided to participate."
    zy "Fiquei surpreso e feliz por você ter decidido participar."

# game/chapters/chapter6/ch6sc5.rpy:124
translate brazil ch6sc5_4c38ccb4:

#   sj "I had a feeling you’d make it."
    sj "Eu tinha a sensação de que você conseguiria."

# game/chapters/chapter6/ch6sc5.rpy:125
translate brazil ch6sc5_e23ea999:

#   sj "Enjoying the pre-ceremony so far?"
    sj "Está gostando da pré-cerimônia até agora?"

# game/chapters/chapter6/ch6sc5.rpy:127
translate brazil ch6sc5_0587d76a:

#   mc "I only just arrived, but yeah. I wasn’t sure what to expect, but so far it seems pretty laid back."
    mc "Acabei de chegar, mas sim. Não sabia o que esperar, mas até agora parece bem tranquilo."

# game/chapters/chapter6/ch6sc5.rpy:128
translate brazil ch6sc5_5fe9dd2c:

#   mc "And I notice that most of crew from our expedition is here."
    mc "E notei que a maior parte da tripulação da nossa expedição está aqui."

# game/chapters/chapter6/ch6sc5.rpy:130
translate brazil ch6sc5_2f7750f5:

#   zy "Anybody is welcome to participate. But usually, since the ceremony is for prospective huntresses..."
    zy "Qualquer pessoa é bem-vinda a participar. Mas, geralmente, como a cerimônia é para futuras caçadoras..."

# game/chapters/chapter6/ch6sc5.rpy:131
translate brazil ch6sc5_08fda2be:

#   zy "It is mostly their friends and other huntresses who take part in the festivities."
    zy "São principalmente suas amigas e outras caçadoras que participam das festividades."

# game/chapters/chapter6/ch6sc5.rpy:133
translate brazil ch6sc5_2d9d8738:

#   mc "I don’t want to throw any shade, but there’s one person I’m glad isn’t here."
    mc "Não quero criticar ninguém, mas tem uma pessoa que eu fico feliz que não esteja aqui."

# game/chapters/chapter6/ch6sc5.rpy:135
translate brazil ch6sc5_269686e0:

#   zy "Like... Marah? *Snickers*"
    zy "Tipo... Marah? *Risos*"

# game/chapters/chapter6/ch6sc5.rpy:137
translate brazil ch6sc5_a6d5c516:

#   mc "I guess I'm as subtle as a rock. *Chuckles*"
    mc "Acho que sou tão discreto quanto uma pedra. *Risos*"

# game/chapters/chapter6/ch6sc5.rpy:139
translate brazil ch6sc5_be52b7e5:

#   sj "Don’t worry, Marah doesn’t usually take part in ceremonies that aren't related to priestess' business."
    sj "Não se preocupe, Marah geralmente não participa de cerimônias que não estejam relacionadas aos assuntos de sacerdotisa."

# game/chapters/chapter6/ch6sc5.rpy:140
translate brazil ch6sc5_45dd238d:

#   sj "I doubt you’ll see her tonight."
    sj "Duvido que você a veja esta noite."

# game/chapters/chapter6/ch6sc5.rpy:142
translate brazil ch6sc5_c3aff36c:

#   zy "She keeps to her chambers during festivities like this."
    zy "Ela permanece em seus aposentos durante festividades como esta."

# game/chapters/chapter6/ch6sc5.rpy:144
translate brazil ch6sc5_ccb0b8bb:

#   sj "Her heart and mind are too old for such things."
    sj "Seu coração e sua mente são muito velhos para essas coisas."

# game/chapters/chapter6/ch6sc5.rpy:146
translate brazil ch6sc5_4e2048d6:

#   sj "She has always been a little grumpy and set in her ways."
    sj "Ela sempre foi um pouco rabugenta e teimosa."

# game/chapters/chapter6/ch6sc5.rpy:147
translate brazil ch6sc5_d032b530:

#   sj "But since you arrived, it's like she’s fallen into a pit of darkness which is consuming her."
    sj "Mas desde que você chegou, é como se ela tivesse caído em um poço de escuridão que a está consumindo."

# game/chapters/chapter6/ch6sc5.rpy:149
translate brazil ch6sc5_18ea6648:

#   zy "Let us not dwell on such topics tonight."
    zy "Não vamos nos deter nesses assuntos esta noite."

# game/chapters/chapter6/ch6sc5.rpy:151
translate brazil ch6sc5_149299f2:

#   zy "We should turn our attention towards happier things."
    zy "Devemos voltar nossa atenção para coisas mais felizes."

# game/chapters/chapter6/ch6sc5.rpy:152
translate brazil ch6sc5_1ce7f060:

#   zy "Champion, do you wish to share a drink with us?"
    zy "Campeão, gostaria de brindar conosco?"

# game/chapters/chapter6/ch6sc5.rpy:154
translate brazil ch6sc5_61a4d8ce:

#   mc "You bet."
    mc "Pode apostar."

# game/chapters/chapter6/ch6sc5.rpy:156
translate brazil ch6sc5_e87debc1:

#   sj "Here, I think you will like this one."
    sj "Aqui, acho que você vai gostar deste."

# game/chapters/chapter6/ch6sc5.rpy:158
translate brazil ch6sc5_efe2ed68:

#   mc "Thank you, Suji. What is it?"
    mc "Obrigada, Suji. O que é isso?"

# game/chapters/chapter6/ch6sc5.rpy:160
translate brazil ch6sc5_d4355771:

#   sj "It’s called Jungle-Jingle! It tastes like summer has smacked your face, and then kissed it afterwards."
    sj "Chama-se Jungle-Jingle! Tem gosto de verão, como se ele tivesse dado um tapa na sua cara e depois a beijado."

# game/chapters/chapter6/ch6sc5.rpy:161
translate brazil ch6sc5_8859d591:

#   mc "*Chuckles* Sounds like my kind of a drink."
    mc "*Risos* Parece ser o tipo de bebida que eu gosto."

# game/chapters/chapter6/ch6sc5.rpy:162
translate brazil ch6sc5_da043026:

#   sj "Let us toast!"
    sj "Vamos fazer um brinde!"

# game/chapters/chapter6/ch6sc5.rpy:164
translate brazil ch6sc5_6f85a674:

#   zy "Tonight we toast to two things: to our Champion of the trials, and to potential new huntresses."
    zy "Esta noite brindamos a duas coisas: à nossa campeã das provas e às potenciais novas caçadoras."

# game/chapters/chapter6/ch6sc5.rpy:166
translate brazil ch6sc5_7d0bf8d5:

#   sj "I’ll drink to that!"
    sj "Eu brindo a isso!"

# game/chapters/chapter6/ch6sc5.rpy:167
translate brazil ch6sc5_a57b13ba:

#   zy "Cheers to your first Jungle-Jingle, Champion!"
    zy "Um brinde ao seu primeiro Jungle-Jingle, campeão!"

# game/chapters/chapter6/ch6sc5.rpy:168
translate brazil ch6sc5_437b9b87:

#   mc "Cheers to making friends with two beautiful and strong huntresses."
    mc "Um brinde a fazer amizade com duas caçadoras lindas e fortes."

# game/chapters/chapter6/ch6sc5.rpy:169
translate brazil ch6sc5_6632fb85:

#   bth "*Giggles lightly*"
    bth "*Risinhos suaves*"

# game/chapters/chapter6/ch6sc5.rpy:171
translate brazil ch6sc5_69eae0d3:

#   mct "*Gulp* Hmh... where’s the smack and kiss she was talking about?"
    mct "*Engole em seco* Hmh... cadê o tapa e o beijo de que ela estava falando?"

# game/chapters/chapter6/ch6sc5.rpy:172
translate brazil ch6sc5_2f5894a4:

#   mct "It tastes just like water flavored with berries-"
    mct "Tem gosto de água com sabor de frutas vermelhas."

# game/chapters/chapter6/ch6sc5.rpy:175
translate brazil ch6sc5_c82bca5f:

#   "You feel the sting of two hands simultaneously landing a smack on each cheek."
    "Você sente a ardência de duas mãos desferindo simultaneamente um tapa em cada bochecha."

# game/chapters/chapter6/ch6sc5.rpy:176
translate brazil ch6sc5_cc9a0e84:

#   mc "{b}PffffhHh!{/b}"
    mc "{b}PffffhHh!{/b}"

# game/chapters/chapter6/ch6sc5.rpy:178
translate brazil ch6sc5_2d804247:

#   "As the sting of their palms recedes, it is replaced by the softness of their lips."
    "À medida que a ardência nas palmas das mãos diminui, é substituída pela suavidade dos lábios."

# game/chapters/chapter6/ch6sc5.rpy:179
translate brazil ch6sc5_4c7d3b6b:

#   sj "*Mwaah!*"
    sj "*Mwaah!*"

# game/chapters/chapter6/ch6sc5.rpy:181
translate brazil ch6sc5_a109ee65:

#   zy "Mmmhh!"
    zy "Hummm!"

# game/chapters/chapter6/ch6sc5.rpy:182
translate brazil ch6sc5_adf3d1db:

#   mct "{i}What the fuck just happened?{/i}"
    mct "{i}Que porra acabou de acontecer?{/i}"

# game/chapters/chapter6/ch6sc5.rpy:184
translate brazil ch6sc5_3e706aa0:

#   bth "*Giggles* Welcome to the jungle!"
    bth "*Risos* Bem-vindos à selva!"

# game/chapters/chapter6/ch6sc5.rpy:185
translate brazil ch6sc5_6b06d6e1:

#   mc "A smack and a kiss, huh? You little vixens..."
    mc "Um tapa e um beijo, é? Suas raposinhas..."

# game/chapters/chapter6/ch6sc5.rpy:187
translate brazil ch6sc5_849fa471:

#   zy "The Jungle-Jingle special! Served by yours truly, Zyra and Suji! *Snickers*"
    zy "O especial Jungle-Jingle! Servido por nós, Zyra e Suji! *Risos*"

# game/chapters/chapter6/ch6sc5.rpy:189
translate brazil ch6sc5_8927b881:

#   sj "Enjoy the ceremony, [mc]."
    sj "Aproveite a cerimônia, [mc]."

# game/chapters/chapter6/ch6sc5.rpy:190
translate brazil ch6sc5_d585e778:

#   mc "If this is how it starts, I’m sure it won’t be an evening I’ll forget anytime soon."
    mc "Se começar assim, tenho certeza de que não será uma noite que esquecerei tão cedo."

# game/chapters/chapter6/ch6sc5.rpy:192
translate brazil ch6sc5_48da9b50:

#   zy "It's good to know we've made a lasting impression."
    zy "É bom saber que causamos uma impressão duradoura."

# game/chapters/chapter6/ch6sc5.rpy:194
translate brazil ch6sc5_f6f6980a:

#   bth "*Giggles* Come find us if you wish to share another drink!"
    bth "*Risos* Venha nos encontrar se quiser tomar outro drinque!"

# game/chapters/chapter6/ch6sc5.rpy:199
translate brazil ch6sc5_8f271159:

#   mct "{i}Hmm, I haven’t really had a chance to talk with Kisha.{/i}"
    mct "{i}Hum, eu realmente não tive a oportunidade de conversar com a Kisha.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:200
translate brazil ch6sc5_f9fbaea1:

#   mct "{i}She’s the Head-Huntress of A’nai, so it would be nice to get to know her a little more.{/i}"
    mct "{i}Ela é a Caçadora-Chefe de A'nai, então seria bom conhecê-la um pouco melhor.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:202
translate brazil ch6sc5_d335d17c:

#   mct "Even with her eyes closed, she sensed me approaching!"
    mct "Mesmo com os olhos fechados, ela sentiu minha aproximação!"

# game/chapters/chapter6/ch6sc5.rpy:203
translate brazil ch6sc5_016e8177:

#   mct "Impressive."
    mct "Impressionante."

# game/chapters/chapter6/ch6sc5.rpy:205
translate brazil ch6sc5_53ee0a89:

#   ks "Greetings, Outsider."
    ks "Saudações, forasteiro."

# game/chapters/chapter6/ch6sc5.rpy:206
translate brazil ch6sc5_e14bcfa6:

#   ks "What is it? Why have you sought me out?"
    ks "O que é isso? Por que você me procurou?"

# game/chapters/chapter6/ch6sc5.rpy:208
translate brazil ch6sc5_68423940:

#   mc "Hey... Kisha, was it?"
    mc "Ei... Kisha, não é?"

# game/chapters/chapter6/ch6sc5.rpy:209
translate brazil ch6sc5_a2fc7978:

#   ks "*Nods* ..."
    ks "*Acena com a cabeça* ..."

# game/chapters/chapter6/ch6sc5.rpy:210
translate brazil ch6sc5_3c6ca796:

#   mc "I just wanted to see how you were."
    mc "Eu só queria saber como você estava."

# game/chapters/chapter6/ch6sc5.rpy:212
translate brazil ch6sc5_b14d13b1:

#   ks "You imagine us close enough for pleasantries and small talk?"
    ks "Você nos imagina próximos o suficiente para trocas de gentilezas e conversas informais?"

# game/chapters/chapter6/ch6sc5.rpy:214
translate brazil ch6sc5_7eef5767:

#   mc "No, I do not... that's why I wanted to speak with you."
    mc "Não, eu não... por isso queria falar com você."

# game/chapters/chapter6/ch6sc5.rpy:215
translate brazil ch6sc5_2f5427d5:

#   mc "To remedy that, and to get to know you. Is that such a crime?"
    mc "Para remediar isso e para te conhecer melhor. Isso é um crime?"

# game/chapters/chapter6/ch6sc5.rpy:217
translate brazil ch6sc5_d229f6c1:

#   ks "It is not a crime, no."
    ks "Não é crime, não."

# game/chapters/chapter6/ch6sc5.rpy:218
translate brazil ch6sc5_32fa96c3:

#   ks "But I am not a woman who cares for pleasantries, they only serve to distract."
    ks "Mas eu não sou uma mulher que se importa com gentilezas, elas só servem para distrair."

# game/chapters/chapter6/ch6sc5.rpy:220
translate brazil ch6sc5_fd12aa53:

#   ks "I do not know your intentions here."
    ks "Não sei quais são suas intenções aqui."

# game/chapters/chapter6/ch6sc5.rpy:221
translate brazil ch6sc5_b21926ec:

#   ks "Arriving at A’nai out of nowhere, befriending us..."
    ks "Chegando em A'nai do nada, e fazendo amizade conosco..."

# game/chapters/chapter6/ch6sc5.rpy:223
translate brazil ch6sc5_9f3fe061:

#   mc "Well, first off... I’m only here on Aruna Island to look for a missing diplomat."
    mc "Bem, para começar... Estou aqui na Ilha de Aruna apenas para procurar um diplomata desaparecido."

# game/chapters/chapter6/ch6sc5.rpy:224
translate brazil ch6sc5_6303a4c3:

#   mc "If I don't find them, it could lead to some serious political ramifications between Arazalia and Luxeron."
    mc "Se eu não os encontrar, isso poderá acarretar sérias consequências políticas entre Arazalia e Luxeron."

# game/chapters/chapter6/ch6sc5.rpy:226
translate brazil ch6sc5_cf65afec:

#   mc "And I'm in A'nai because your huntresses knocked me out and brought me here, as you might remember."
    mc "E estou em A'nai porque suas caçadoras me nocautearam e me trouxeram para cá, como você deve se lembrar."

# game/chapters/chapter6/ch6sc5.rpy:227
translate brazil ch6sc5_c3c0d05a:

#   ks "Hrrmm..."
    ks "Hum..."

# game/chapters/chapter6/ch6sc5.rpy:229
translate brazil ch6sc5_9e91a23f:

#   mc "And honestly? I think this place is pretty amazing, the way all of you live in harmony with the island."
    mc "E, sinceramente? Acho este lugar incrível, a forma como todos vocês vivem em harmonia com a ilha."

# game/chapters/chapter6/ch6sc5.rpy:230
translate brazil ch6sc5_d986e0f7:

#   mc "So, yeah. I’ve been befriending those of you who have been open and welcoming towards me."
    mc "Então, sim. Tenho feito amizade com aqueles de vocês que têm sido abertos e acolhedores comigo."

# game/chapters/chapter6/ch6sc5.rpy:232
translate brazil ch6sc5_f34546a0:

#   ks "*Quietly* Marah said you would attempt to befriend us, to twist our minds..."
    ks "*Em voz baixa*, Marah disse que você tentaria se aproximar de nós, para nos manipular..."

# game/chapters/chapter6/ch6sc5.rpy:233
translate brazil ch6sc5_4bfc9bd0:

#   ks "What is it you’re after, Outsider? Why do you continue to remain here?"
    ks "O que você busca, forasteiro? Por que continua aqui?"

# game/chapters/chapter6/ch6sc5.rpy:235
translate brazil ch6sc5_9d8492c6:

#   mc "Well, for starters, this seems like a much better place to base myself than wandering the jungle aimlessly."
    mc "Bem, para começar, este parece ser um lugar muito melhor para me estabelecer do que vagar sem rumo pela selva."

# game/chapters/chapter6/ch6sc5.rpy:236
translate brazil ch6sc5_056dd2cf:

#   mc "And since your High-Priestess, Marah... forcibly set me on the path of the trials."
    mc "E já que sua Alta Sacerdotisa, Marah... me colocou à força no caminho das provações."

# game/chapters/chapter6/ch6sc5.rpy:238
translate brazil ch6sc5_13ace662:

#   mc "I decided to give them a try. If I succeed, great."
    mc "Resolvi experimentá-los. Se eu conseguir, ótimo."

# game/chapters/chapter6/ch6sc5.rpy:239
translate brazil ch6sc5_55499899:

#   mc "If I don’t, that’s great too."
    mc "Se eu não fizer isso, ótimo também."

# game/chapters/chapter6/ch6sc5.rpy:240
translate brazil ch6sc5_c97de85d:

#   mc "At least I’ll have experienced something that few others ever will."
    mc "Ao menos terei vivenciado algo que poucos outros terão a oportunidade de vivenciar."

# game/chapters/chapter6/ch6sc5.rpy:242
translate brazil ch6sc5_e1706dc3:

#   ks "You enjoy the thrill of the unknown, Outsider?"
    ks "Você gosta da emoção do desconhecido, Forasteiro?"

# game/chapters/chapter6/ch6sc5.rpy:243
translate brazil ch6sc5_2f19644d:

#   ks "To overcome obstacles that others think impossible?"
    ks "Superar obstáculos que outros consideram impossíveis?"

# game/chapters/chapter6/ch6sc5.rpy:247
translate brazil ch6sc5_f36e5aec:

#   mc "Exactly."
    mc "Exatamente."

# game/chapters/chapter6/ch6sc5.rpy:248
translate brazil ch6sc5_1a50df3f:

#   mc "I’m an adventurer, and that’s a big part of why I am one."
    mc "Sou um aventureiro, e essa é uma grande parte da razão pela qual sou um."

# game/chapters/chapter6/ch6sc5.rpy:250
translate brazil ch6sc5_7a5005f4:

#   ks "Interesting..."
    ks "Interessante..."

# game/chapters/chapter6/ch6sc5.rpy:252
translate brazil ch6sc5_d1a72c17:

#   "Kisha is surprised to learn this about you, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Kisha ficou surpresa ao saber disso sobre você, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc5.rpy:253
translate brazil ch6sc5_70e44445:

#   ks "Hmm... I, too, enjoyed the thrill of exploration when I was but a young huntress."
    ks "Hum... Eu também gostava da emoção da exploração quando era apenas uma jovem caçadora."

# game/chapters/chapter6/ch6sc5.rpy:256
translate brazil ch6sc5_cb8cf91c:

#   mc "I suppose?"
    mc "Eu suponho?"

# game/chapters/chapter6/ch6sc5.rpy:258
translate brazil ch6sc5_b2256fda:

#   ks "You suppose? *Scoffs*"
    ks "Você acha? *Risos*"

# game/chapters/chapter6/ch6sc5.rpy:259
translate brazil ch6sc5_a1a08a53:

#   "Kisha finds your lack of enthusiasm disappointing."
    "Kisha considera sua falta de entusiasmo decepcionante."

# game/chapters/chapter6/ch6sc5.rpy:263
translate brazil ch6sc5_f82b01ad:

#   ks "These days, my thrills comes from seeing the huntresses I train as they become more capable warriors."
    ks "Hoje em dia, minha maior satisfação vem de ver as caçadoras que treino se tornarem guerreiras cada vez mais capazes."

# game/chapters/chapter6/ch6sc5.rpy:264
translate brazil ch6sc5_37bc6f87:

#   ks "Young Vex is one of my best students in recent years."
    ks "Young Vex é um dos meus melhores alunos dos últimos anos."

# game/chapters/chapter6/ch6sc5.rpy:265
translate brazil ch6sc5_de704730:

#   ks "I know she will do well during her trial tomorrow."
    ks "Sei que ela se sairá bem durante o julgamento amanhã."

# game/chapters/chapter6/ch6sc5.rpy:267
translate brazil ch6sc5_72fc4d1e:

#   mc "Yeah, I think she will do just fine. She seems very capable and dutiful."
    mc "Sim, acho que ela se sairá muito bem. Ela parece muito capaz e dedicada."

# game/chapters/chapter6/ch6sc5.rpy:269
translate brazil ch6sc5_eb02ac73:

#   ks "She is still young, but she has great potential."
    ks "Ela ainda é jovem, mas tem um grande potencial."

# game/chapters/chapter6/ch6sc5.rpy:271
translate brazil ch6sc5_4d7e5a52:

#   mc "Hmm, since you enjoy training..."
    mc "Hum, já que você gosta de treinar..."

# game/chapters/chapter6/ch6sc5.rpy:272
translate brazil ch6sc5_7e2d5755:

#   mc "Maybe you and I could have a sparring match?"
    mc "Talvez você e eu pudéssemos fazer uma luta de treino?"

# game/chapters/chapter6/ch6sc5.rpy:274
translate brazil ch6sc5_f0e4550c:

#   ks "Are you taunting me, Outsider?"
    ks "Você está me provocando, forasteiro?"

# game/chapters/chapter6/ch6sc5.rpy:276
translate brazil ch6sc5_b865decc:

#   mc "No, I wouldn’t dare."
    mc "Não, eu não me atreveria."

# game/chapters/chapter6/ch6sc5.rpy:277
translate brazil ch6sc5_d4fa9d3b:

#   mc "You’re clearly the most respected warrior in A’nai."
    mc "É evidente que você é o guerreiro mais respeitado em A'nai."

# game/chapters/chapter6/ch6sc5.rpy:279
translate brazil ch6sc5_43ccc9d7:

#   mc "And something my mentor instilled in me a long time ago-"
    mc "E algo que meu mentor me ensinou há muito tempo..."

# game/chapters/chapter6/ch6sc5.rpy:280
translate brazil ch6sc5_9cf33b90:

#   mc "Was never to shy away from an opportunity to challenge myself against the best."
    mc "Nunca me esquivei de uma oportunidade de me desafiar contra os melhores."

# game/chapters/chapter6/ch6sc5.rpy:281
translate brazil ch6sc5_fdafe86f:

#   ks "Hmmh..."
    ks "Hum..."

# game/chapters/chapter6/ch6sc5.rpy:283
translate brazil ch6sc5_88aeac8f:

#   ks "Those are words of wisdom that true warriors know."
    ks "Essas são palavras de sabedoria que os verdadeiros guerreiros conhecem."

# game/chapters/chapter6/ch6sc5.rpy:284
translate brazil ch6sc5_fb4b73d0:

#   ks "Very well, then."
    ks "Muito bem, então."

# game/chapters/chapter6/ch6sc5.rpy:285
translate brazil ch6sc5_46a3da09:

#   ks "I will accept your challenge, come find me some other time... when you are ready to duel."
    ks "Aceito seu desafio, procure-me em outra ocasião... quando estiver pronto para um duelo."

# game/chapters/chapter6/ch6sc5.rpy:287
translate brazil ch6sc5_86ba4b0c:

#   ks "I will see your worth for myself."
    ks "Eu mesma verei o seu valor."

# game/chapters/chapter6/ch6sc5.rpy:291
translate brazil ch6sc5_f9fb2e5f:

#   mc "Great. I’m already looking forward to besting you."
    mc "Ótimo. Já estou ansioso para te derrotar."

# game/chapters/chapter6/ch6sc5.rpy:292
translate brazil ch6sc5_49c0615d:

#   ks "*Scoffs* ..."
    ks "*Zomba* ..."

# game/chapters/chapter6/ch6sc5.rpy:294
translate brazil ch6sc5_b8dc1ac3:

#   "Kisha finds your confidence refreshing, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Kisha acha sua confiança revigorante, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc5.rpy:299
translate brazil ch6sc5_4c108d31:

#   ks "Go, enjoy the festivities."
    ks "Vá e aproveite as festividades."

# game/chapters/chapter6/ch6sc5.rpy:300
translate brazil ch6sc5_6461a922:

#   ks "And I shall do the same. Separately."
    ks "E eu farei o mesmo. Separadamente."

# game/chapters/chapter6/ch6sc5.rpy:301
translate brazil ch6sc5_9343256c:

#   mct "*Chuckles* Heh... she’s a tough one to crack."
    mct "*Risos* Heh... ela é difícil de decifrar."

# game/chapters/chapter6/ch6sc5.rpy:302
translate brazil ch6sc5_304b63f2:

#   mct "Hopefully, beating her in a duel will make her more open towards me."
    mct "Espero que, ao derrotá-la em um duelo, ela se torne mais receptiva a mim."

# game/chapters/chapter6/ch6sc5.rpy:304
translate brazil ch6sc5_5ebd50e1:

#   mc "See you around, Head-Huntress."
    mc "Até mais, Caçadora de Cabeças."

# game/chapters/chapter6/ch6sc5.rpy:313
translate brazil ch6sc5_ceb2ac58:

#   mct "Even Sakari is here?"
    mct "Até a Sakari está aqui?"

# game/chapters/chapter6/ch6sc5.rpy:314
translate brazil ch6sc5_44e69d8f:

#   mct "I didn’t expect her to come to a huntress ceremony."
    mct "Eu não esperava que ela viesse a uma cerimônia de caçadora."

# game/chapters/chapter6/ch6sc5.rpy:316
translate brazil ch6sc5_04583e7f:

#   mc "Evening, Sakari."
    mc "Boa noite, Sakari."

# game/chapters/chapter6/ch6sc5.rpy:321
translate brazil ch6sc5_c34b2eb1:

#   mc "You look breathtaking tonight."
    mc "Você está deslumbrante esta noite."

# game/chapters/chapter6/ch6sc5.rpy:322
translate brazil ch6sc5_e3f35f5d:

#   "A warm smile softens her face at your compliment."
    "Um sorriso caloroso suaviza o rosto dela ao seu elogio."

# game/chapters/chapter6/ch6sc5.rpy:324
translate brazil ch6sc5_0db3a64c:

#   mc "I like what you’ve done with your hair tonight, compared to your usual ponytail."
    mc "Gostei do que você fez com o cabelo hoje à noite, comparado ao seu rabo de cavalo de sempre."

# game/chapters/chapter6/ch6sc5.rpy:326
translate brazil ch6sc5_cda069dd:

#   sk "Thank you. I’m glad it draws your attention."
    sk "Obrigado. Fico feliz que tenha chamado sua atenção."

# game/chapters/chapter6/ch6sc5.rpy:327
translate brazil ch6sc5_285322fe:

#   sk "Is there... anything else that gets your attention?"
    sk "Há... mais alguma coisa que lhe chame a atenção?"

# game/chapters/chapter6/ch6sc5.rpy:330
translate brazil ch6sc5_2d8094c4:

#   mc "Definitely... your dress."
    mc "Com certeza... seu vestido."

# game/chapters/chapter6/ch6sc5.rpy:331
translate brazil ch6sc5_d185a82d:

#   mc "I’m glad you didn’t change your outfit, this one highlights your body perfectly."
    mc "Que bom que você não trocou de roupa, essa valoriza perfeitamente o seu corpo."

# game/chapters/chapter6/ch6sc5.rpy:333
translate brazil ch6sc5_74ff2311:

#   "You've elevated your social knowledge by complimenting Sakari, your {b}{color=#87e1fa}Charisma{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
