#   di "..."
    di "..."

# game/chapters/chapter6/ch6sc7.rpy:889
translate brazil ch6sc7_a3f30426_1:

#   di "*Sighs* ..."
    di "*Suspiros* ..."

# game/chapters/chapter6/ch6sc7.rpy:979
translate brazil ch6sc7_10a2ea83_1:

#   ec "Now, I must leave you. I have to prepare for the ceremony."
    ec "Agora, preciso ir. Tenho que me preparar para a cerimônia."

# game/chapters/chapter6/ch6sc7.rpy:17
translate brazil ch6sc7_7725df7c:

#   mc "Hnnnghh! Morning everyone..."
    mc "Hnnnghh! Bom dia a todos..."

# game/chapters/chapter6/ch6sc7.rpy:20
translate brazil ch6sc7_f50d834c:

#   ec "Good morning to you, [mc]."
    ec "Bom dia para você, [mc]."

# game/chapters/chapter6/ch6sc7.rpy:21
translate brazil ch6sc7_d09269e1:

#   ec "It's lovely to see you in such high spirits."
    ec "É ótimo te ver tão animado(a)."

# game/chapters/chapter6/ch6sc7.rpy:22
translate brazil ch6sc7_9e1b90e9:

#   ec "Did our goddesses visit you in your dreams? *Giggles*"
    ec "Nossas deusas te visitaram em seus sonhos? *Risos*"

# game/chapters/chapter6/ch6sc7.rpy:26
translate brazil ch6sc7_0afb0157:

#   mc "Oh, I spent my night with a... goddess."
    mc "Ah, passei a noite com uma... deusa."

# game/chapters/chapter6/ch6sc7.rpy:27
translate brazil ch6sc7_64f2d557:

#   tz "*Snickers lightly* ..."
    tz "*Ri baixinho* ..."

# game/chapters/chapter6/ch6sc7.rpy:32
translate brazil ch6sc7_4a9c9bf7:

#   mc "Of course I’m in great spirits. We’ve achieved a lot over the past few days here."
    mc "É claro que estou muito animado. Conseguimos muita coisa nos últimos dias aqui."

# game/chapters/chapter6/ch6sc7.rpy:35
translate brazil ch6sc7_6ba6eeac:

#   mc "I assume we’re heading back to A’nai today?"
    mc "Imagino que hoje voltaremos para A'nai?"

# game/chapters/chapter6/ch6sc7.rpy:37
translate brazil ch6sc7_57decee7:

#   ec "Mh-hm. We’ll set out as soon as we've packed up camp and everyone’s had some breakfast."
    ec "Hum-hum. Partiremos assim que terminarmos de desmontar o acampamento e todos tomarem o café da manhã."

# game/chapters/chapter6/ch6sc7.rpy:38
translate brazil ch6sc7_6d82329a:

#   ec "Make sure you have some as well."
    ec "Certifique-se de ter alguns também."

# game/chapters/chapter6/ch6sc7.rpy:39
translate brazil ch6sc7_8c6de1f2:

#   ec "You may be well rested, but you still need food."
    ec "Você pode estar bem descansado, mas ainda precisa se alimentar."

# game/chapters/chapter6/ch6sc7.rpy:41
translate brazil ch6sc7_733d93e3:

#   ec "Once we get back to A’nai, you and I will discuss how to proceed..."
    ec "Assim que retornarmos a A'nai, você e eu discutiremos como proceder..."

# game/chapters/chapter6/ch6sc7.rpy:42
translate brazil ch6sc7_d8ce2ffe:

#   ec "... concerning the Arugoh tribe and the last temple."
    ec "... referentes à tribo Arugoh e ao último templo."

# game/chapters/chapter6/ch6sc7.rpy:46
translate brazil ch6sc7_c6b275f3:

#   "As Echo walks past you, she places her hand on your chest, clearly longing for your touch."
    "Ao passar por você, Echo coloca a mão no seu peito, claramente desejando o seu toque."

# game/chapters/chapter6/ch6sc7.rpy:47
translate brazil ch6sc7_ac6bab17:

#   "Which you answer in kind by placing your hand on her lower stomach."
    "Ao que você responde da mesma forma, colocando a mão na parte inferior da barriga dela."

# game/chapters/chapter6/ch6sc7.rpy:48
translate brazil ch6sc7_35b1c249:

#   mc "*Quietly* {size=-10}{b}I look forward to discussing our plans with you, one on one.{/b}{/size}"
    mc "*Em silêncio* {size=-10}{b}Aguardo com expectativa a oportunidade de discutir nossos planos com você, individualmente.{/b}{/size}"

# game/chapters/chapter6/ch6sc7.rpy:49
translate brazil ch6sc7_407bfa31:

#   ec "*Quietly* {size=-10}{b}Mmmh... Me too... I’ll make sure we won’t be disturbed during our- strategy meeting.{/b}{/size}"
    ec "*Em silêncio* {size=-10}{b}Hum... Eu também... Vou garantir que não seremos interrompidos durante nossa reunião de estratégia.{/b}{/size}"

# game/chapters/chapter6/ch6sc7.rpy:50
translate brazil ch6sc7_8334328f:

#   mc "I’ll help pack up the tents."
    mc "Vou ajudar a desmontar as barracas."

# game/chapters/chapter6/ch6sc7.rpy:52
translate brazil ch6sc7_b5afa0b8:

#   ec "Are you in a hurry to get back to A’nai? *Giggles softly*"
    ec "Você está com pressa para voltar para A'nai? *Risinhos suaves*"

# game/chapters/chapter6/ch6sc7.rpy:54
translate brazil ch6sc7_73f9696e:

#   mc "You bet I am, desperate even."
    mc "Pode apostar que sim, até mesmo desesperado."

# game/chapters/chapter6/ch6sc7.rpy:56
translate brazil ch6sc7_83964e89:

#   ec "Me too... I’ll help pack up as well. The sooner, the better."
    ec "Eu também... Vou ajudar a empacotar. Quanto antes, melhor."

# game/chapters/chapter6/ch6sc7.rpy:58
translate brazil ch6sc7_3dc1be48:

#   mct "*Chuckles* With the way she’s lightly digging her nails into my chest, she must also be desperate for our ‘meeting’."
    mct "*Risos* Pelo jeito que ela está cravando as unhas de leve no meu peito, ela também deve estar desesperada para o nosso 'encontro'."

# game/chapters/chapter6/ch6sc7.rpy:60
translate brazil ch6sc7_10825fc4:

#   ec "C’mon, Champion... let's not delay any further."
    ec "Vamos lá, campeão... não vamos perder mais tempo."

# game/chapters/chapter6/ch6sc7.rpy:63
translate brazil ch6sc7_053f6c0e:

#   mc "Sounds good, I’ll help pack up the tents."
    mc "Parece ótimo, eu ajudo a desmontar as barracas."

# game/chapters/chapter6/ch6sc7.rpy:64
translate brazil ch6sc7_b302eb59:

#   ec "Great, I’m sure it will go swiftly with your help."
    ec "Ótimo, tenho certeza de que tudo correrá rapidamente com a sua ajuda."

# game/chapters/chapter6/ch6sc7.rpy:79
translate brazil ch6sc7_c1b6fb4b:

#   am "{b}Frida?!{/b} Did you bring that dress I pointed out?"
    am "{b}Frida?!{/b} Você trouxe aquele vestido que eu mostrei?"

# game/chapters/chapter6/ch6sc7.rpy:80
translate brazil ch6sc7_1c525932:

#   fr "Y-Yes! It should be around here somewhere..."
    fr "Sim! Deve estar por aqui em algum lugar..."

# game/chapters/chapter6/ch6sc7.rpy:82
translate brazil ch6sc7_3cfd04ea:

#   am "By all means, take your time... it’s not like I’m completely exposed back here."
    am "Sem problemas, não tenha pressa... não é como se eu estivesse completamente exposto aqui atrás."

# game/chapters/chapter6/ch6sc7.rpy:83
translate brazil ch6sc7_c717cb33:

#   fr "S-Sorry! Luckily, it’s only us in here."
    fr "D-Desculpe! Felizmente, só estamos nós aqui."

# game/chapters/chapter6/ch6sc7.rpy:85
translate brazil ch6sc7_ca9b7f58:

#   am "Benefit of being a royal, I suppose, they’ll close down the shop so you aren’t bothered."
    am "Uma das vantagens de ser da realeza, suponho, é que eles fecham a loja para que você não seja incomodado."

# game/chapters/chapter6/ch6sc7.rpy:86
translate brazil ch6sc7_2d8ef4f6:

#   fr "It must be nice, Your Grace."
    fr "Deve ser muito bom, Vossa Graça."

# game/chapters/chapter6/ch6sc7.rpy:87
translate brazil ch6sc7_cd905c61:

#   am "*Sighs* How often do I need to ask you to address me by my name and not my title, Frida?"
    am "*Suspiro* Quantas vezes preciso pedir que você me chame pelo meu nome e não pelo meu título, Frida?"

# game/chapters/chapter6/ch6sc7.rpy:89
translate brazil ch6sc7_e22a9bec:

#   fr "At least once more, Your Grace."
    fr "Ao menos mais uma vez, Vossa Graça."

# game/chapters/chapter6/ch6sc7.rpy:91
translate brazil ch6sc7_65d9da64:

#   am "{b}Frida!{/b}"
    am "{b}Frida!{/b}"

# game/chapters/chapter6/ch6sc7.rpy:92
translate brazil ch6sc7_7818b504:

#   fr "S-Sorry! Amelia..."
    fr "D-Desculpe! Amélia..."

# game/chapters/chapter6/ch6sc7.rpy:93
translate brazil ch6sc7_ff480fc5:

#   am "Finally..."
    am "Finalmente..."

# game/chapters/chapter6/ch6sc7.rpy:94
translate brazil ch6sc7_905191b6:

#   fr "Is that why you enjoy having [mc] around? Because he doesn’t treat you like a superior?"
    fr "É por isso que você gosta de ter [mc] Por perto? Porque ele não te trata como superior?"

# game/chapters/chapter6/ch6sc7.rpy:96
translate brazil ch6sc7_cff4ebe9:

#   am "Mhm-hm."
    am "Hum-hum."

# game/chapters/chapter6/ch6sc7.rpy:97
translate brazil ch6sc7_fca94575:

#   am "He treats me as an equal."
    am "Ele me trata como igual."

# game/chapters/chapter6/ch6sc7.rpy:98
translate brazil ch6sc7_119aea2b:

#   am "I’m not just some fragile object to him, he actually lets me do stuff."
    am "Eu não sou apenas um objeto frágil para ele, ele realmente me deixa fazer coisas."

# game/chapters/chapter6/ch6sc7.rpy:99
translate brazil ch6sc7_f101916d:

#   am "Like, when we were out on our date- I mean when he took me outside the palace..."
    am "Tipo, quando estávamos no nosso encontro - quer dizer, quando ele me levou para fora do palácio..."

# game/chapters/chapter6/ch6sc7.rpy:101
translate brazil ch6sc7_cfac90a8:

#   am "We ventured quite a distance into the wilderness and found this amazing cliff with a huge tree on top!"
    am "Nos aventuramos por uma grande distância na mata e encontramos este penhasco incrível com uma árvore enorme no topo!"

# game/chapters/chapter6/ch6sc7.rpy:102
translate brazil ch6sc7_2c470468:

#   am "And he didn’t even offer to carry me up the large hill."
    am "E ele nem sequer se ofereceu para me carregar até o topo da colina."

# game/chapters/chapter6/ch6sc7.rpy:103
translate brazil ch6sc7_71e7436d:

#   fr "You sound excited about that. Wouldn’t you have wanted to be carried by him?"
    fr "Você parece animada com isso. Não teria gostado de ser carregada por ele?"

# game/chapters/chapter6/ch6sc7.rpy:105
translate brazil ch6sc7_efdf8642:

#   am "Yes, and no... I love that he lets me do things on my own. But I know if I had asked him to, he would’ve carried me up."
    am "Sim e não... Adoro que ele me deixe fazer as coisas sozinha. Mas sei que se eu tivesse pedido, ele teria me carregado no colo."

# game/chapters/chapter6/ch6sc7.rpy:106
translate brazil ch6sc7_9b24687c:

#   am "To him, I’m just Amelia... a friend."
    am "Para ele, eu sou apenas Amelia... uma amiga."

# game/chapters/chapter6/ch6sc7.rpy:108
translate brazil ch6sc7_a95490ee:

#   am "I’m so thankful to him for that... he's giving me something I haven't had before."
    am "Sou muito grata a ele por isso... ele está me dando algo que eu nunca tive antes."

# game/chapters/chapter6/ch6sc7.rpy:109
translate brazil ch6sc7_aa6196dc:

#   am "You’ve been my only genuine friend my entire life, but even that is limited by your service as my handmaiden."
    am "Você tem sido minha única amiga verdadeira em toda a minha vida, mas mesmo isso é limitado pelo seu serviço como minha criada."

# game/chapters/chapter6/ch6sc7.rpy:111
translate brazil ch6sc7_984e9c1d:

#   am "Whereas with [mc], he might be in service as my bodyguard, but he doesn’t give a hoot about that."
    am "Enquanto que com [mc] Ele pode até estar a meu serviço como guarda-costas, mas não está nem aí para isso."

# game/chapters/chapter6/ch6sc7.rpy:112
translate brazil ch6sc7_34d5c5e6:

#   am "If he resigned as my bodyguard tomorrow, it wouldn’t change how he is with me."
    am "Se ele se demitisse do cargo de meu guarda-costas amanhã, isso não mudaria a forma como ele se comporta comigo."

# game/chapters/chapter6/ch6sc7.rpy:114
translate brazil ch6sc7_ea93fd75:

#   fr "Y-Yeah... that’s the feeling I get from him as well. He sees everyone as having equal importance."
    fr "É... essa é a impressão que eu tenho dele também. Ele vê todos como tendo a mesma importância."

# game/chapters/chapter6/ch6sc7.rpy:116
translate brazil ch6sc7_4b3e29df:

#   fr "Sure, he understands when to be polite around people of high social standing..."
    fr "Claro, ele sabe quando ser educado perto de pessoas de alta posição social..."

# game/chapters/chapter6/ch6sc7.rpy:117
translate brazil ch6sc7_ee4bf8cb:

#   fr "But I really believe he couldn't care less if someone has noble blood, or is a humble peasant."
    fr "Mas eu realmente acredito que ele não se importa nem um pouco se alguém tem sangue nobre ou é um humilde camponês."

# game/chapters/chapter6/ch6sc7.rpy:119
translate brazil ch6sc7_4659b5f0:

#   am "I believe that as well."
    am "Eu também acredito nisso."

# game/chapters/chapter6/ch6sc7.rpy:120
translate brazil ch6sc7_8c8e7fff:

#   am "It’s refreshing, to say the least."
    am "É, no mínimo, revigorante."

# game/chapters/chapter6/ch6sc7.rpy:122
translate brazil ch6sc7_da5ad227:

#   am "Frida! Seriously, though?! {b}MY DRESS?!{/b}"
    am "Frida! Sério mesmo?! {b} MEU VESTIDO?!{/b}"

# game/chapters/chapter6/ch6sc7.rpy:124
translate brazil ch6sc7_83e3f2b9:

#   fr "H-here! Sorry! I got caught up in our talk. I've been holding it for a while..."
    fr "Aqui estou! Desculpe! Me distraí com a nossa conversa. Estou segurando isso há um tempo..."

# game/chapters/chapter6/ch6sc7.rpy:126
translate brazil ch6sc7_efef360a:

#   am "*Exhales* You’re hopeless..."
    am "*Exala* Você é um caso perdido..."

# game/chapters/chapter6/ch6sc7.rpy:127
translate brazil ch6sc7_2a1e1daf:

#   am "How do I look?"
    am "Como estou?"

# game/chapters/chapter6/ch6sc7.rpy:129
translate brazil ch6sc7_9d9c281d:

#   fr "Beautiful!"
    fr "Lindo!"

# game/chapters/chapter6/ch6sc7.rpy:130
translate brazil ch6sc7_e79988b2:

#   am "R-Really? It’s not too much with the flowery pattern?"
    am "Sério? Não é demais com essa estampa floral?"

# game/chapters/chapter6/ch6sc7.rpy:131
translate brazil ch6sc7_af771204:

#   fr "Nuh-uh! It is very feminine... and the dress flows nicely along your curves."
    fr "Não, não! É muito feminino... e o vestido cai lindamente sobre suas curvas."

# game/chapters/chapter6/ch6sc7.rpy:133
translate brazil ch6sc7_e37c6802:

#   am "Huh... you’re right. It does flow along my body quite well."
    am "Hum... você tem razão. Realmente desliza muito bem pelo meu corpo."

# game/chapters/chapter6/ch6sc7.rpy:135
translate brazil ch6sc7_9e48fe53:

#   am "And it’s incredibly soft... it must be made from Arazalian silk."
    am "E é incrivelmente macio... deve ser feito de seda arazaliana."

# game/chapters/chapter6/ch6sc7.rpy:137
translate brazil ch6sc7_2ab0c407:

#   fr "It is! We found it in the imported goods corner. You can really tell?"
    fr "É sim! Encontramos na seção de produtos importados. Dá para perceber mesmo?"

# game/chapters/chapter6/ch6sc7.rpy:138
translate brazil ch6sc7_ff8633ff:

#   fr "You must have an impressive sense of touch to be able to feel it."
    fr "É preciso ter um tato impressionante para conseguir senti-lo."

# game/chapters/chapter6/ch6sc7.rpy:140
translate brazil ch6sc7_86d5120c:

#   am "It is quite simply, really."
    am "É bem simples, na verdade."

# game/chapters/chapter6/ch6sc7.rpy:142
translate brazil ch6sc7_aae32ef5:

#   am "You just run your fingertips along the fabric."
    am "Basta passar a ponta dos dedos ao longo do tecido."

# game/chapters/chapter6/ch6sc7.rpy:144
translate brazil ch6sc7_9368ea3d:

#   am "You can tell the difference because..."
    am "Você consegue perceber a diferença porque..."

# game/chapters/chapter6/ch6sc7.rpy:146
translate brazil ch6sc7_567f559c:

#   am "Silk from Luxeron feels smooth in only one direction, whereas Arazalian silk is smooth in every direction."
    am "A seda de Luxeron é macia apenas em uma direção, enquanto a seda de Arazalian é macia em todas as direções."

# game/chapters/chapter6/ch6sc7.rpy:147
translate brazil ch6sc7_51010ef1:

#   fr "Impressive!"
    fr "Impressionante!"

# game/chapters/chapter6/ch6sc7.rpy:149
translate brazil ch6sc7_585b469b:

#   fr "Your Grace... Amelia, should I put in an order for this dress, then?"
    fr "Vossa Graça... Amelia, devo encomendar este vestido, então?"

# game/chapters/chapter6/ch6sc7.rpy:151
translate brazil ch6sc7_1360d2ff:

#   am "That would be lovely. Thank you, Frida."
    am "Seria ótimo. Obrigada, Frida."

# game/chapters/chapter6/ch6sc7.rpy:152
translate brazil ch6sc7_7d2113c9:

#   am "Add a few extra silvers for good measure. I want to ensure the dress is ready for when [mc] returns."
    am "Adicione mais alguns detalhes em prata para garantir. Quero ter certeza de que o vestido esteja pronto para quando... [mc] devoluções."

# game/chapters/chapter6/ch6sc7.rpy:154
translate brazil ch6sc7_20137e76:

#   am "Of course! I have a feeling he will be impressed."
    am "Claro! Tenho a impressão de que ele ficará impressionado."

# game/chapters/chapter6/ch6sc7.rpy:156
translate brazil ch6sc7_b9f357fd:

#   am "*Quietly* [mc], impressed by me?"
    am "*Em silêncio* [mc] Impressionado(a) comigo?"

# game/chapters/chapter6/ch6sc7.rpy:157
translate brazil ch6sc7_ed3ef34b:

#   am "Wouldn’t that be lovely? *Sighs* Knowing him, he won’t even notice the new dress."
    am "Não seria adorável? *Suspiro* Conhecendo-o, ele nem vai notar o vestido novo."

# game/chapters/chapter6/ch6sc7.rpy:158
translate brazil ch6sc7_067a2e11:

#   am "Even so, it feels nice to dress up for him... especially since the banquet is in honor of him and his friends."
    am "Mesmo assim, é bom me arrumar para ele... especialmente porque o banquete é em homenagem a ele e seus amigos."

# game/chapters/chapter6/ch6sc7.rpy:162
translate brazil ch6sc7_c006d8d2:

#   am "Maybe... if I let him feel the silk?"
    am "Talvez... se eu o deixasse sentir a seda?"

# game/chapters/chapter6/ch6sc7.rpy:163
translate brazil ch6sc7_55ec26d8:

#   am "While I’m wearing it... maybe he’d appreciate the dress then? *Quiet giggle*"
    am "Enquanto eu estiver usando... talvez ele aprecie o vestido então? *Risinho discreto*"

# game/chapters/chapter6/ch6sc7.rpy:179
translate brazil ch6sc7_114385c5:

#   mc "Looks like we’re ready to head out. Good job, girls."
    mc "Parece que estamos prontas para partir. Bom trabalho, meninas."

# game/chapters/chapter6/ch6sc7.rpy:180
translate brazil ch6sc7_beabe333:

#   mc "Huntresses, keep your eyes sharp. If we see a chance to bring back food for the tribe, we shall do so."
    mc "Caçadoras, mantenham os olhos bem abertos. Se virmos uma chance de trazer comida para a tribo, nós a aproveitaremos."

# game/chapters/chapter6/ch6sc7.rpy:182
translate brazil ch6sc7_1c897f7d:

#   ec "Spoken like a true hunter... leadership suits you."
    ec "Falando como um verdadeiro caçador... liderança combina com você."

# game/chapters/chapter6/ch6sc7.rpy:183
translate brazil ch6sc7_594410c5:

#   ec "Suits you really well."
    ec "Combina muito bem com você."

# game/chapters/chapter6/ch6sc7.rpy:186
translate brazil ch6sc7_54c74b22:

#   "After your time inside the hunting grounds, everyone is ready to return to the comforts of A’nai."
    "Após o tempo gasto nos campos de caça, todos estão prontos para retornar ao conforto de A'nai."

# game/chapters/chapter6/ch6sc7.rpy:188
translate brazil ch6sc7_bf1e18e5:

#   pl "Uh-uh! I know the first thing I’m going to do once we reach A’nai."
    pl "Não, não! Eu sei a primeira coisa que vou fazer quando chegarmos a A'nai."

# game/chapters/chapter6/ch6sc7.rpy:189
translate brazil ch6sc7_329d27a0:

#   mc "What’s gotten you so excited?"
    mc "O que te deixou tão animado(a)?"

# game/chapters/chapter6/ch6sc7.rpy:191
translate brazil ch6sc7_e7cbcb96:

#   pl "Guess!"
    pl "Adivinhar!"

# game/chapters/chapter6/ch6sc7.rpy:193
translate brazil ch6sc7_f14f29cb:

#   mc "I would say food, but we just had breakfast..."
    mc "Eu diria comida, mas acabamos de tomar café da manhã..."

# game/chapters/chapter6/ch6sc7.rpy:194
translate brazil ch6sc7_2fda9b23:

#   mc "Given what a little mermaid you are..."
    mc "Considerando a pequena sereia que você é..."

# game/chapters/chapter6/ch6sc7.rpy:195
translate brazil ch6sc7_4f6f040a:

#   mc "I’ll wager coin that it's the prospect of a bath that has you riled you up so much."
    mc "Aposto que é a perspectiva de um banho que te deixou tão irritado."

# game/chapters/chapter6/ch6sc7.rpy:197
translate brazil ch6sc7_fea0d439:

#   pl "Bingo! *Giggles*"
    pl "Bingo! *Risos*"

# game/chapters/chapter6/ch6sc7.rpy:198
translate brazil ch6sc7_7b1d4d49:

#   pl "I'm in need of the greatest bath ever! And the bath in A’nai has the best rejuvenating waters!"
