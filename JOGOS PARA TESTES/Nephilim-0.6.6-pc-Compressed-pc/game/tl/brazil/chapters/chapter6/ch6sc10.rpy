# game/chapters/chapter6/ch6sc10.rpy:4794
translate brazil ch6sc10_c91b06e0:

#   vx "Y-Yeah… he does."
    vx "S-Sim… ele faz."

# game/chapters/chapter6/ch6sc10.rpy:4795
translate brazil ch6sc10_0f0b8a50:

#   mc "*Chuckles* You’re cute when you get all shy."
    mc "*Risos* Você fica uma gracinha quando fica todo tímido."

