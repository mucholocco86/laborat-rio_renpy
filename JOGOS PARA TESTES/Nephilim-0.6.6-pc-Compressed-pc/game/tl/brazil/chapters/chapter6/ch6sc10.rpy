translate brazil ch6sc10_e8e3d75f:

#   mct "Her sister? Hmm, she could be one of the huntresses that went missing, scouting the northern section of the island."
    mct "A irmã dela? Hum, ela poderia ser uma das caçadoras que desapareceram enquanto exploravam a parte norte da ilha."

