translate brazil ch6sc10_5ff11154:

#   vx "Miyo… I’m so sorry, I promise I will keep my eyes peeled when I’m out on hunts."
    vx "Miyo... Me desculpe, prometo que ficarei atenta quando estiver caçando."

# game/chapters/chapter6/ch6sc10.rpy:4809
translate brazil ch6sc10_5da1565d:

#   mi "Vex… thank you."
    mi "Vex... obrigado."

