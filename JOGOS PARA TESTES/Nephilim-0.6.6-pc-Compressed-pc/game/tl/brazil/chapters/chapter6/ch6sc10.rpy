translate brazil ch6sc10_5a6c3283:

#   mc "You needn’t beg, you know full well that it is just a “until I return” goodbye."
    mc "Você não precisa implorar, sabe muito bem que é apenas um adeus \"até eu voltar\"."

# game/chapters/chapter6/ch6sc10.rpy:4834
translate brazil ch6sc10_bca1a043:

#   vx "G-Good…"
    vx "Bom…"

