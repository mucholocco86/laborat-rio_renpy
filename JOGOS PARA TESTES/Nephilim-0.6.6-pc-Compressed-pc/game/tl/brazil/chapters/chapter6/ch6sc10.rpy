translate brazil ch6sc10_bc3fee24:

#   vx "I don’t think I could handle it… if I never saw you again."
    vx "Acho que não conseguiria lidar com isso... se nunca mais te visse."

# game/chapters/chapter6/ch6sc10.rpy:4837
translate brazil ch6sc10_fde9ed94:

#   mc "Shh… my little huntress."
    mc "Shhh… minha pequena caçadora."

