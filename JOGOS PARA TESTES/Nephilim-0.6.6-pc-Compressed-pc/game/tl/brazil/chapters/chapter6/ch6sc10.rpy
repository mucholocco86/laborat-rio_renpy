translate brazil ch6sc10_97b10fa0:

#   vx "You look handsome today."
    vx "Você está muito bonito hoje."

# game/chapters/chapter6/ch6sc10.rpy:4788
translate brazil ch6sc10_6ef4029c:

#   mi "Look at you Vex! Being all forward and stuff. *Giggles*"
