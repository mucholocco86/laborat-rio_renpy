translate brazil ch6sc10_43a67047:

#   mc "I’ll miss that cheeky little smile of yours."
    mc "Vou sentir falta desse seu sorrisinho maroto."

# game/chapters/chapter6/ch6sc10.rpy:4874
translate brazil ch6sc10_40122321:

#   mi "You promised Vex that you’d be back… you better keep it."
    mi "Você prometeu à Vex que voltaria... é melhor cumprir sua promessa."

# game/chapters/chapter6/ch6sc10.rpy:4875
translate brazil ch6sc10_bd1d4477:

#   mc "*Chuckles* Just for her sake?"
    mc "*Risos* Só por causa dela?"

# game/chapters/chapter6/ch6sc10.rpy:4876
translate brazil ch6sc10_1f2ded47:

#   mi "Nnh-Nhh… not just for her… I just didn’t want to sound selfish."
    mi "Nnh-Nhh… não só por ela… eu só não queria parecer egoísta."

# game/chapters/chapter6/ch6sc10.rpy:4877
translate brazil ch6sc10_88b996f6:

#   mc "Until I see you again, Miyo."
    mc "Até nos vermos de novo, Miyo."

# game/chapters/chapter6/ch6sc10.rpy:4878
translate brazil ch6sc10_67f48606:

#   mi "Bye-bye! I look forward to our future under your leadership."
    mi "Adeus! Aguardo com expectativa o nosso futuro sob a sua liderança."

# game/chapters/chapter6/ch6sc10.rpy:4883
translate brazil ch6sc10_d9a1d3e9:

#   sk "*Sighs* If I had known you would leave us this soon…"
    sk "*Suspiro* Se eu soubesse que você nos deixaria tão cedo…"

# game/chapters/chapter6/ch6sc10.rpy:4884
translate brazil ch6sc10_e11aaa61:

#   sk "I… I wouldn’t have held myself back as I have…"
    sk "Eu... eu não teria me contido como me contive..."

# game/chapters/chapter6/ch6sc10.rpy:4886
translate brazil ch6sc10_e7f0601a:

#   mc "I’ll return Sakari, and when I do…"
    mc "Eu devolverei Sakari, e quando eu fizer isso…"

# game/chapters/chapter6/ch6sc10.rpy:4887
translate brazil ch6sc10_ef9b5579:

#   mc "You’ll have your chance."
    mc "Você terá sua chance."

# game/chapters/chapter6/ch6sc10.rpy:4889
translate brazil ch6sc10_9e23fd4a:

#   sk "Mh-hm… I look forward to that."
    sk "Hum... Estou ansioso por isso."

# game/chapters/chapter6/ch6sc10.rpy:4890
translate brazil ch6sc10_438e6c76:

#   sk "I won’t let my chance to show you my affections go to waste twice."
    sk "Não vou deixar que a minha chance de demonstrar o meu afeto por você se perca duas vezes."

# game/chapters/chapter6/ch6sc10.rpy:4894
translate brazil ch6sc10_75a08497:

#   sk "This... 'Harem' you've built... it's truly a feat for a king."
    sk "Este... 'harém' que você construiu... é realmente uma façanha para um rei."

# game/chapters/chapter6/ch6sc10.rpy:4895
translate brazil ch6sc10_df2f5519:

#   sk "However... when you return, I aim to stand out amongst all your beautiful women."
    sk "No entanto... quando você voltar, meu objetivo é me destacar entre todas as suas belas mulheres."

# game/chapters/chapter6/ch6sc10.rpy:4896
translate brazil ch6sc10_1e69f321:

#   sk "I will win your heart, and your desire."
    sk "Conquistarei seu coração e seu desejo."

# game/chapters/chapter6/ch6sc10.rpy:4902
translate brazil ch6sc10_b0f248ef:

#   mc "I’m looking forward to seeing what you come up with."
    mc "Estou ansioso para ver o que você vai criar."

# game/chapters/chapter6/ch6sc10.rpy:4903
translate brazil ch6sc10_2b2d76ce:

#   mc "Farewell, Mistress Sakari."
    mc "Adeus, Senhora Sakari."

# game/chapters/chapter6/ch6sc10.rpy:4905
translate brazil ch6sc10_3d58f19a:

#   sk "F-Farewell, my A’khan."
    sk "Adeus, meu A'khan."

# game/chapters/chapter6/ch6sc10.rpy:4910
translate brazil ch6sc10_03accc7d:

#   sj "MMmh!! I’m going to miss you big time, you know?!"
    sj "Hummm!! Vou sentir muita saudade de você, sabia?!"

# game/chapters/chapter6/ch6sc10.rpy:4911
translate brazil ch6sc10_ccaf96d6:

#   mc "*Chuckles* I know, Suji… I’ll miss you too."
    mc "*Risos* Eu sei, Suji... Também sentirei sua falta."

# game/chapters/chapter6/ch6sc10.rpy:4912
translate brazil ch6sc10_f2404ce3:

#   sj "I demand Jungle-Jingles upon your return! Hm-Hm!"
    sj "Exijo que você toque Jungle-Jingles quando voltar! Hm-Hm!"

# game/chapters/chapter6/ch6sc10.rpy:4914
translate brazil ch6sc10_22dca241:

#   mc "Fine, I’ll grant you one Jungle-Jingle when I return."
    mc "Tudo bem, eu te concederei uma canção da selva quando eu voltar."

# game/chapters/chapter6/ch6sc10.rpy:4916
translate brazil ch6sc10_65792d0b:

#   sj "Three!"
    sj "Três!"

# game/chapters/chapter6/ch6sc10.rpy:4918
translate brazil ch6sc10_bff3a6eb:

#   mc "One."
    mc "Um."

# game/chapters/chapter6/ch6sc10.rpy:4920
translate brazil ch6sc10_0ebb52d1:

#   sj "Two!"
    sj "Dois!"

# game/chapters/chapter6/ch6sc10.rpy:4922
translate brazil ch6sc10_188ef40b:

#   mc "*Sighs* … Two."
    mc "*Suspiro* … Dois."

# game/chapters/chapter6/ch6sc10.rpy:4924
translate brazil ch6sc10_417b6517:

#   sj "*Hugs tightly* Yay!"
    sj "*Abraça forte* Oba!"

# game/chapters/chapter6/ch6sc10.rpy:4925
translate brazil ch6sc10_7241ba12:

#   sj "Goodbye [mc]! Please don’t forget us while you’re out there adventuring in the great world."
    sj "Adeus [mc] Por favor, não se esqueçam de nós enquanto estiverem por aí se aventurando pelo mundo."

# game/chapters/chapter6/ch6sc10.rpy:4926
translate brazil ch6sc10_5b1b050a:

#   mc "Goodbye Suji, you don’t have to worry, you have etched your way into my mind and heart."
    mc "Adeus, Suji, não se preocupe, você deixou sua marca na minha mente e no meu coração."

# game/chapters/chapter6/ch6sc10.rpy:4930
translate brazil ch6sc10_c34de74e:

#   sj "I love you!"
    sj "Eu te amo!"

# game/chapters/chapter6/ch6sc10.rpy:4931
translate brazil ch6sc10_0c36bc68:

#   mc "*Chuckles* I love you too. My sexy little huntress."
    mc "*Risos* Eu também te amo. Minha pequena caçadora sexy."

# game/chapters/chapter6/ch6sc10.rpy:4933
translate brazil ch6sc10_0549cbb1:

#   sj "*Hugs tightly* I wish I could go explore the world with you!"
    sj "*Abraça forte* Eu queria poder explorar o mundo com você!"

# game/chapters/chapter6/ch6sc10.rpy:4934
translate brazil ch6sc10_61f89fb0:

#   sj "Like when we explored Gaia's temple!"
    sj "Assim como quando exploramos o templo de Gaia!"

# game/chapters/chapter6/ch6sc10.rpy:4936
translate brazil ch6sc10_8f38c6cf:

#   mc "Maybe one day... I'll take you on an adventure outside of the island."
    mc "Talvez um dia... eu te leve numa aventura para fora da ilha."

# game/chapters/chapter6/ch6sc10.rpy:4937
translate brazil ch6sc10_3d157c76:

#   sj "YES! I'd love that! *Giggling* A great adventure while we mate like animals!"
    sj "SIM! Eu adoraria! *Risos* Uma grande aventura enquanto acasalamos como animais!"

# game/chapters/chapter6/ch6sc10.rpy:4938
translate brazil ch6sc10_670f85e0:

#   mc "*Chuckles* Deal."
    mc "*Risos* Fechado."

# game/chapters/chapter6/ch6sc10.rpy:4947
translate brazil ch6sc10_bdafe5d7:

#   zy "Mmhhhpfh!"
    zy "Mmhhhpfh!"

# game/chapters/chapter6/ch6sc10.rpy:4948
translate brazil ch6sc10_8fdd0a4a:

#   mc "Zyra…"
    mc "Escritório…"

# game/chapters/chapter6/ch6sc10.rpy:4949
translate brazil ch6sc10_5eaa93dc:

#   zy "No!"
    zy "Não!"

# game/chapters/chapter6/ch6sc10.rpy:4951
translate brazil ch6sc10_a0497897:

#   zy "Two more weeks! At least!"
    zy "Mais duas semanas! Pelo menos!"

# game/chapters/chapter6/ch6sc10.rpy:4952
translate brazil ch6sc10_f1697b48:

#   mc "You know I can’t… not at this moment."
    mc "Você sabe que eu não posso... não neste momento."

# game/chapters/chapter6/ch6sc10.rpy:4953
translate brazil ch6sc10_a5dcc3d0:

#   mc "My friends and loved ones back home are counting on me to return."
    mc "Meus amigos e entes queridos em casa estão contando com o meu retorno."

# game/chapters/chapter6/ch6sc10.rpy:4955
translate brazil ch6sc10_61aa0743:

#   zy "Mmhfp! But I miss you!"
    zy "Mmhfp! Mas eu sinto sua falta!"

# game/chapters/chapter6/ch6sc10.rpy:4956
translate brazil ch6sc10_61126258:

#   mc "*Sighs* You know I will miss you too, you have really grown on me."
    mc "*Suspiro* Você sabe que também sentirei sua falta, você realmente me conquistou."

# game/chapters/chapter6/ch6sc10.rpy:4957
translate brazil ch6sc10_6115d591:

#   zy "I have? I mean… of course I have!"
    zy "Eu tenho? Quer dizer... claro que tenho!"

# game/chapters/chapter6/ch6sc10.rpy:4959
translate brazil ch6sc10_c3125f39:

#   zy "I’m a great huntress!"
    zy "Sou uma ótima caçadora!"

# game/chapters/chapter6/ch6sc10.rpy:4960
translate brazil ch6sc10_346468fa:

#   mc "*Chuckles* One of my very best huntresses."
    mc "*Risos* Uma das minhas melhores caçadoras."

# game/chapters/chapter6/ch6sc10.rpy:4961
translate brazil ch6sc10_c325a6e8:

#   zy "And beautiful too! *Giggles*"
    zy "E linda também! *Risos*"

# game/chapters/chapter6/ch6sc10.rpy:4962
translate brazil ch6sc10_0df98290:

#   mc "And beautiful as well."
    mc "E também muito bonita."

# game/chapters/chapter6/ch6sc10.rpy:4964
translate brazil ch6sc10_136597a1:

#   zy "Alright, alright… I suppose I will let you off the hook."
    zy "Tudo bem, tudo bem... Acho que vou te deixar escapar dessa."

# game/chapters/chapter6/ch6sc10.rpy:4965
translate brazil ch6sc10_9e1ca80a:

#   zy "But you better bring more compliments with you upon returning!"
    zy "Mas é melhor você trazer mais elogios quando voltar!"

# game/chapters/chapter6/ch6sc10.rpy:4966
translate brazil ch6sc10_f08aaa56:

#   mc "*Chuckles* I’ll see what I can do. Take care Zyra."
    mc "*Risos* Vou ver o que posso fazer. Cuide-se, Zyra."

# game/chapters/chapter6/ch6sc10.rpy:4971
translate brazil ch6sc10_e5e9fbfa:

#   riv "I know it’s pointless to ask you to stay… but…"
    riv "Eu sei que é inútil pedir para você ficar… mas…"

# game/chapters/chapter6/ch6sc10.rpy:4972
translate brazil ch6sc10_1abc1521:

#   riv "I would never forgive myself if I didn’t at least ask, so… please, won’t you stay?"
    riv "Eu jamais me perdoaria se ao menos não perguntasse, então... por favor, você não quer ficar?"

# game/chapters/chapter6/ch6sc10.rpy:4973
translate brazil ch6sc10_3272f76d:

#   mc "Despite us both knowing the answer, I’m glad you asked."
    mc "Apesar de ambos sabermos a resposta, fico feliz que você tenha perguntado."

# game/chapters/chapter6/ch6sc10.rpy:4975
translate brazil ch6sc10_93228e72:

#   riv "As I said, If I hadn’t I would have been asking myself every day if it would have changed the outcome."
    riv "Como eu disse, se não o tivesse feito, ficaria me perguntando todos os dias se o resultado teria sido diferente."

# game/chapters/chapter6/ch6sc10.rpy:4976
translate brazil ch6sc10_c095e825:

#   riv "But you’ve told me about your loved ones back home, so I knew very well you couldn’t stay for long."
    riv "Mas você me falou sobre seus entes queridos em casa, então eu sabia muito bem que você não poderia ficar por muito tempo."

# game/chapters/chapter6/ch6sc10.rpy:4977
translate brazil ch6sc10_49212918:

#   riv "And I know you, I know you count us amongst your loved ones as well now. I know you will return to us whenever possible."
    riv "E eu sei que você nos considera também entre seus entes queridos agora. Sei que você voltará para nós sempre que possível."

# game/chapters/chapter6/ch6sc10.rpy:4979
translate brazil ch6sc10_7ab876cf:

#   mct "Damn, she does know me well."
    mct "Caramba, ela me conhece muito bem."

# game/chapters/chapter6/ch6sc10.rpy:4980
translate brazil ch6sc10_53e20b19:

#   mct "I suppose we have gotten rather close during my time here."
    mct "Imagino que tenhamos nos aproximado bastante durante o tempo que passei aqui."

# game/chapters/chapter6/ch6sc10.rpy:4981
translate brazil ch6sc10_c1faa5cd:

#   mc "I’ll come visit whenever I can, I’m glad you understand that."
    mc "Eu irei te visitar sempre que puder, fico feliz que você entenda isso."

# game/chapters/chapter6/ch6sc10.rpy:4984
translate brazil ch6sc10_a5aafc2b:

#   riv "Mmmffh!"
    riv "Mmmffh!"

# game/chapters/chapter6/ch6sc10.rpy:4985
translate brazil ch6sc10_384f65b3:

#   riv "Until then, I will do my best to train our huntresses, and help construct new huts for the rest of the tribe."
    riv "Até lá, farei o meu melhor para treinar nossas caçadoras e ajudar a construir novas cabanas para o resto da tribo."

# game/chapters/chapter6/ch6sc10.rpy:4986
translate brazil ch6sc10_96c8effa:

#   mc "That’s what I like to hear, I’m counting on you Riven."
    mc "É isso que eu gosto de ouvir, estou contando com você, Riven."

# game/chapters/chapter6/ch6sc10.rpy:4989
translate brazil ch6sc10_98fda13c:

#   riv "[mc]-... I want to tell you that I... I lo-"
    riv "[mc]...Quero te dizer que eu... eu te amo"

# game/chapters/chapter6/ch6sc10.rpy:4990
translate brazil ch6sc10_155ad2b1:

#   mc "Shh, I know Riven. I know."
    mc "Shh, eu conheço a Riven. Eu sei."

# game/chapters/chapter6/ch6sc10.rpy:4991
translate brazil ch6sc10_03e6db96:

#   mc "Don't tell me now, tell me upon my return. That way you know I'll have to come see you again."
    mc "Não me diga agora, diga-me quando eu voltar. Assim você saberá que terei que vir vê-lo(a) novamente."

# game/chapters/chapter6/ch6sc10.rpy:4992
translate brazil ch6sc10_4d2d8cb2:

#   riv "R-Right! That's so cute! Mmfffhh! Thank you... you always know how to ease my mind."
    riv "É isso aí! Que fofo! Hummm! Obrigada... você sempre sabe como me tranquilizar."

# game/chapters/chapter6/ch6sc10.rpy:4997
translate brazil ch6sc10_0a3842e1:

#   "Riven hugs you tightly before the two of you part."
    "Riven te abraça forte antes de vocês dois se separarem."

# game/chapters/chapter6/ch6sc10.rpy:5002
translate brazil ch6sc10_fd818dbd:

#   mc "There she is, my strong and beautiful Head-Huntress."
    mc "Aí está ela, minha forte e bela Caçadora de Cabeças."

# game/chapters/chapter6/ch6sc10.rpy:5003
translate brazil ch6sc10_f2dd89f4:

#   "Kisha can’t help but giggle as you caress her chin and cheek."
    "Kisha não consegue conter o risinho enquanto você acaricia seu queixo e bochecha."

# game/chapters/chapter6/ch6sc10.rpy:5004
translate brazil ch6sc10_5c734479:

#   "The once cold and harsh facade of hers now instantly melt whenever you look upon her."
    "A fachada antes fria e severa dela agora se desfaz instantaneamente sempre que você a olha."

# game/chapters/chapter6/ch6sc10.rpy:5005
translate brazil ch6sc10_aa8a4af3:

#   mc "You’ll watch over everyone with Riven whilst I’m away, won’t you?"
    mc "Você vai cuidar de todos com a Riven enquanto eu estiver fora, não é?"

# game/chapters/chapter6/ch6sc10.rpy:5007
translate brazil ch6sc10_8cd0db0e:

#   ks "I will, My A’khan."
    ks "Sim, meu A'khan."

# game/chapters/chapter6/ch6sc10.rpy:5008
translate brazil ch6sc10_d895bd51:

#   ks "We have a great deal of work ahead of us to provide all the returning members shelter, starting with huts."
    ks "Temos muito trabalho pela frente para providenciar abrigo a todos os membros que retornam, começando pelas cabanas."

# game/chapters/chapter6/ch6sc10.rpy:5010
translate brazil ch6sc10_b61d2cee:

#   mc "What else?"
    mc "O que mais?"

# game/chapters/chapter6/ch6sc10.rpy:5012
translate brazil ch6sc10_c36a5607:

#   ks "We will also have to integrate them into our way of living, assign them to their respective duties."
    ks "Teremos também que integrá-los em nosso modo de vida, atribuindo-lhes as respectivas funções."

# game/chapters/chapter6/ch6sc10.rpy:5013
translate brazil ch6sc10_5623e8d2:

#   ks "And of course, training everyone will continue. We may have a strong A’khan to protect us now-"
    ks "E, claro, o treinamento de todos continuará. Talvez agora tenhamos um A'khan forte para nos proteger."

# game/chapters/chapter6/ch6sc10.rpy:5014
translate brazil ch6sc10_5b5ffd6d:

#   ks "-But we should all be able to pull our weight should a battle find itself upon us."
    ks "Mas todos nós devemos ser capazes de fazer a nossa parte caso nos deparemos com uma batalha."

# game/chapters/chapter6/ch6sc10.rpy:5016
translate brazil ch6sc10_c7dad092:

#   mc "I couldn’t have said it better myself, Kisha. I’m glad to be leaving A’nai in your capable hands."
    mc "Eu não poderia ter dito melhor, Kisha. Fico feliz em deixar A'nai em suas mãos capazes."

# game/chapters/chapter6/ch6sc10.rpy:5017
translate brazil ch6sc10_3a5766ce:

#   "Kisha nods happily, she appreciates you acknowledging her."
    "Kisha acena com a cabeça, feliz; ela aprecia que você a reconheça."

# game/chapters/chapter6/ch6sc10.rpy:5019
translate brazil ch6sc10_61f36247:

#   mc "Take care of yourself and everyone, Head-Huntress."
    mc "Cuide de si mesma e de todos, Caçadora de Cabeças."

# game/chapters/chapter6/ch6sc10.rpy:5020
translate brazil ch6sc10_a642cb6d:

#   ks "Mhm-hm."
    ks "Hum-hum."

# game/chapters/chapter6/ch6sc10.rpy:5023
translate brazil ch6sc10_524ce2c5:

#   "On your way towards the main gate, you hear Pearl’s soft voice call out to you."
    "No caminho em direção ao portão principal, você ouve a voz suave de Pearl chamando por você."

# game/chapters/chapter6/ch6sc10.rpy:5026
translate brazil ch6sc10_8cf11b53:

#   pl "[mc]! There you are!"
    pl "[mc]! Aí está você!"

# game/chapters/chapter6/ch6sc10.rpy:5027
translate brazil ch6sc10_843fce10:

#   mc "Hey, I was just about to come look for you."
    mc "Ei, eu estava justamente indo te procurar."

# game/chapters/chapter6/ch6sc10.rpy:5028
translate brazil ch6sc10_6dde60f0:

#   pl "You found me! *Giggles* Had I known, I would’ve hid… make you work for it."
    pl "Você me encontrou! *Risos* Se eu soubesse, teria me escondido... para te fazer merecer."

# game/chapters/chapter6/ch6sc10.rpy:5030
translate brazil ch6sc10_1ddda45b:

#   pl "Where have you been all day?"
    pl "Onde você esteve o dia todo?"

# game/chapters/chapter6/ch6sc10.rpy:5031
translate brazil ch6sc10_a970bc0d:

#   pl "I may have been getting ready to leave but I definitely noticed your absence."
    pl "Eu talvez estivesse me preparando para ir embora, mas com certeza notei sua ausência."

# game/chapters/chapter6/ch6sc10.rpy:5033
translate brazil ch6sc10_ee407ba3:

#   mc "You’re perceptive as ever, you’re right, I wasn’t here in A’nai."
    mc "Você é perspicaz como sempre, você tem razão, eu não estava aqui em A'nai."

# game/chapters/chapter6/ch6sc10.rpy:5035
translate brazil ch6sc10_c8db4b42:

#   pl "*Giggles* Your mermaid does rather well on land, don’t you think? Wait-"
    pl "*Risos* Sua sereia se sai muito bem em terra firme, não acha? Espera aí..."

# game/chapters/chapter6/ch6sc10.rpy:5037
translate brazil ch6sc10_5a03db91:

#   pl "What do you mean you weren’t in A’nai? Did you venture into the jungle?"
    pl "Como assim você não estava em A'nai? Você se aventurou na selva?"

# game/chapters/chapter6/ch6sc10.rpy:5039
translate brazil ch6sc10_8aec7aca:

#   mc "No, I actually met with Maia. She had a proposition for me."
    mc "Não, na verdade eu me encontrei com a Maia. Ela tinha uma proposta para mim."

# game/chapters/chapter6/ch6sc10.rpy:5041
translate brazil ch6sc10_3967bf93:

#   pl "Hmh, how ominous…"
    pl "Hum, que presságio sinistro…"

# game/chapters/chapter6/ch6sc10.rpy:5042
translate brazil ch6sc10_974b146c:

#   pl "But I won’t ask what it’s about, you will tell me if I need to know."
    pl "Mas não vou perguntar do que se trata, você me dirá se eu precisar saber."

# game/chapters/chapter6/ch6sc10.rpy:5044
translate brazil ch6sc10_b9adec4c:

#   mct "I love how understanding she is, and I know she is curious by nature, yet she chooses to respect my privacy."
    mct "Admiro a compreensão dela e sei que ela é curiosa por natureza, mas mesmo assim opta por respeitar a minha privacidade."

# game/chapters/chapter6/ch6sc10.rpy:5045
translate brazil ch6sc10_c4a5dca5:

#   mc "Correct, it was a personal meeting. Thank you for not prying."
    mc "Correto, foi uma reunião pessoal. Obrigada por não ser intrometida."

# game/chapters/chapter6/ch6sc10.rpy:5047
translate brazil ch6sc10_f5414b88:

#   pl "Of course, Sharky!"
    pl "Claro, Sharky!"

# game/chapters/chapter6/ch6sc10.rpy:5049
translate brazil ch6sc10_f0b52d98:

#   pl "So, are you ready to get the hell on out of here?"
    pl "Então, você está pronto para dar o fora daqui?"

# game/chapters/chapter6/ch6sc10.rpy:5050
translate brazil ch6sc10_84eff248:

#   pl "Not that I mind it, A’nai has grown on me actually, but I really want to go see Kira."
    pl "Não que eu me importe, na verdade acabei gostando da A'nai, mas eu realmente quero ir ver a Kira."

# game/chapters/chapter6/ch6sc10.rpy:5052
translate brazil ch6sc10_3addc42a:

#   mc "You bet, I’m sure she is losing her mind worrying about us."
    mc "Pode apostar, tenho certeza de que ela está ficando louca de preocupação conosco."

# game/chapters/chapter6/ch6sc10.rpy:5054
translate brazil ch6sc10_76aded31:

#   tz "There you are!"
    tz "Aí está!"

# game/chapters/chapter6/ch6sc10.rpy:5055
translate brazil ch6sc10_f82993a1:

#   tz "Where in all of Midomir have you been all day? We’re supposed to depart in a few moments."
    tz "Onde você esteve o dia todo em Midomir? Deveríamos partir em instantes."

# game/chapters/chapter6/ch6sc10.rpy:5057
translate brazil ch6sc10_d2bf39e2:

#   mc "*Chuckles* Sorry boss, I was a little preoccupied with being summoned by a goddess."
    mc "*Risos* Desculpe, chefe, eu estava um pouco ocupado por ter sido convocado por uma deusa."

# game/chapters/chapter6/ch6sc10.rpy:5059
translate brazil ch6sc10_ec41fc55:

#   tz "Oh! Huuuh?!"
    tz "Oh! Hã?!"

# game/chapters/chapter6/ch6sc10.rpy:5061
translate brazil ch6sc10_bf8da31d:

#   tz "I can’t believe I missed such an opportunity!"
    tz "Não acredito que perdi uma oportunidade dessas!"

# game/chapters/chapter6/ch6sc10.rpy:5062
translate brazil ch6sc10_86c7e8d7:

#   tz "I could’ve written great things about such an event."
    tz "Eu poderia ter escrito coisas maravilhosas sobre um evento como esse."

# game/chapters/chapter6/ch6sc10.rpy:5064
translate brazil ch6sc10_ca56923c:

#   tz "*Mumbles* {size=-5}{b}Hmmh, the Nephilim was summoned personally by one of Midomir’s goddesses.{/b}{/size}"
    tz "*Murmúrios* {size=-5}{b}Hum, o Nefilim foi invocado pessoalmente por uma das deusas de Midomir.{/b}{/size}"

# game/chapters/chapter6/ch6sc10.rpy:5065
translate brazil ch6sc10_bfb326e8:

#   tz "*Mumbles* {size=-5}{b}What she had in store for him is yet unknown, but a step in the right direction it certainly seems to be.{/b}{/size}"
    tz "*Murmúrios* {size=-5}{b}O que ela tinha planejado para ele ainda é desconhecido, mas certamente parece ser um passo na direção certa.{/b}{/size}"

# game/chapters/chapter6/ch6sc10.rpy:5067
translate brazil ch6sc10_ea2febb2:

#   mc "Think you got everything? *Chuckles*"
    mc "Acha que tem tudo? *Risos*"

# game/chapters/chapter6/ch6sc10.rpy:5069
translate brazil ch6sc10_23e73340:

#   tz "Sorry, yeah… you know how I get when something happens."
    tz "Desculpe, é... você sabe como eu fico quando alguma coisa acontece."

# game/chapters/chapter6/ch6sc10.rpy:5070
translate brazil ch6sc10_56549b99:

#   tz "I don’t want to risk forgetting it."
    tz "Não quero correr o risco de esquecer."

# game/chapters/chapter6/ch6sc10.rpy:5072
translate brazil ch6sc10_5a5aa49b:

#   mc "Taz, it’s fine. I would go into details about it but it was more of a personal meeting."
    mc "Taz, tudo bem. Eu poderia entrar em detalhes, mas foi mais um encontro pessoal."

# game/chapters/chapter6/ch6sc10.rpy:5073
translate brazil ch6sc10_a95511f4:

#   "Tazzy nods understandingly."
    "Tazzy acena com a cabeça, compreendendo."

# game/chapters/chapter6/ch6sc10.rpy:5075
translate brazil ch6sc10_f7210036:

#   tz "It looks like the sun is starting to set."
    tz "Parece que o sol está começando a se pôr."

# game/chapters/chapter6/ch6sc10.rpy:5076
translate brazil ch6sc10_e2957ebc:

#   tz "I’m going to miss the beauty of nature out here."
    tz "Vou sentir falta da beleza da natureza aqui."

# game/chapters/chapter6/ch6sc10.rpy:5078
translate brazil ch6sc10_b805585e:

#   mc "Yeah, me too."
    mc "Sim, eu também."

# game/chapters/chapter6/ch6sc10.rpy:5079
translate brazil ch6sc10_1fea04d8:

#   mc "I’ve been out in the wilds more often than not over the last decade…"
    mc "Passei a maior parte da última década em áreas selvagens…"

# game/chapters/chapter6/ch6sc10.rpy:5080
translate brazil ch6sc10_d1360734:

#   mc "But Aruna and A’nai have been something else… it has grown on me quite a bit."
    mc "Mas Aruna e A'nai são outra história... acabei gostando bastante."

# game/chapters/chapter6/ch6sc10.rpy:5082
translate brazil ch6sc10_8bb9b011:

#   pl "I’m sure having 70ish women all drooling over you as their handsome and powerful leader has nothing to do with it?"
    pl "Tenho certeza de que ter umas 70 mulheres babando por você, seu líder bonito e poderoso, não tem nada a ver com isso, né?"

# game/chapters/chapter6/ch6sc10.rpy:5084
translate brazil ch6sc10_cb8b0931:

#   tz "*Giggles* Pearl! You really have no filter, do you?"
    tz "*Risos* Pérola! Você realmente não tem filtro, né?"

# game/chapters/chapter6/ch6sc10.rpy:5085
translate brazil ch6sc10_eecc17f5:

#   mc "She really doesn’t, which I’ve grown to like about her. *Chuckles*"
    mc "Ela realmente não faz isso, e eu passei a gostar disso nela. *Risos*"

# game/chapters/chapter6/ch6sc10.rpy:5087
translate brazil ch6sc10_0544d0ae:

#   pl "What? By all means, correct me if I’m wrong! *Snickers*"
    pl "O quê? Corrija-me se eu estiver errado! *Risos*"

# game/chapters/chapter6/ch6sc10.rpy:5089
translate brazil ch6sc10_71ecf693:

#   "Neither you or Taz attempts to correct her."
    "Nem você nem Taz tentam corrigi-la."

# game/chapters/chapter6/ch6sc10.rpy:5090
translate brazil ch6sc10_9f5f3526:

#   mc "We’ve had quite the adventure out here, huh girls?"
    mc "Tivemos uma grande aventura por aqui, não é, meninas?"

# game/chapters/chapter6/ch6sc10.rpy:5092
translate brazil ch6sc10_742db080:

#   tz "Certainly so! Remember when you found me passed out in the jungle?"
    tz "Com certeza! Lembra quando você me encontrou desmaiado na selva?"

# game/chapters/chapter6/ch6sc10.rpy:5093
translate brazil ch6sc10_b49d9c04:

#   pl "Or when we got separated upon arriving here by eating those blacknip berries!"
    pl "Ou quando nos separamos ao chegar aqui por causa daquelas frutinhas de melão-de-são-caetano!"

# game/chapters/chapter6/ch6sc10.rpy:5095
translate brazil ch6sc10_2debb879:

#   tz "Or when we managed to successfully make it through the cave with that filthy beast?"
    tz "Ou quando conseguimos atravessar a caverna com aquela criatura imunda?"

# game/chapters/chapter6/ch6sc10.rpy:5096
translate brazil ch6sc10_b11a5716:

#   pl "I’ll admit, it truly has been quite the adventure. *Giggles*"
    pl "Admito, foi realmente uma grande aventura. *Risos*"

# game/chapters/chapter6/ch6sc10.rpy:5098
translate brazil ch6sc10_417d880a:

#   tz "C’mon, we better head to the main gate, I believe Orianna should be waiting for us."
    tz "Vamos, é melhor irmos para o portão principal, acredito que Orianna esteja nos esperando."

# game/chapters/chapter6/ch6sc10.rpy:5099
translate brazil ch6sc10_22cc9450:

#   tz "She seems really sweet, we shouldn’t make her wait."
    tz "Ela parece ser muito simpática, não devemos fazê-la esperar."

# game/chapters/chapter6/ch6sc10.rpy:5101
translate brazil ch6sc10_028da4c0:

#   mc "I agree, Orianna seems genuine, which took me by surprise… being a diplomat and all."
    mc "Concordo, Orianna parece genuína, o que me surpreendeu... sendo eu diplomata e tudo mais."

# game/chapters/chapter6/ch6sc10.rpy:5102
translate brazil ch6sc10_56e4c794:

#   mc "So far she has my trust, so yeah, let’s not keep her waiting."
    mc "Até agora, ela tem a minha confiança, então, sim, não vamos fazê-la esperar."

# game/chapters/chapter6/ch6sc10.rpy:5104
translate brazil ch6sc10_d14397b4:

#   tz "*Mumbles* {size=-5}{b}The Nephilim has begun making allies across the kingdoms.{/b}{/size}"
    tz "*Murmúrios* {size=-5}{b}Os Nefilins começaram a fazer alianças por todos os reinos.{/b}{/size}"

# game/chapters/chapter6/ch6sc10.rpy:5105
translate brazil ch6sc10_5e8945a8:

#   tz "*Mumbles* {size=-5}{b}Maybe he is planning a conquest?{/b}{/size}"
    tz "*Murmúrios* {size=-5}{b}Talvez ele esteja planejando uma conquista?{/b}{/size}"

# game/chapters/chapter6/ch6sc10.rpy:5106
translate brazil ch6sc10_2bad2a82:

#   mc "Taz…"
    mc "Taz…"

# game/chapters/chapter6/ch6sc10.rpy:5108
translate brazil ch6sc10_8cd7c35c:

#   tz "*Snickers* Sorry! Sorry! But who knows?"
    tz "*Risos* Desculpe! Desculpe! Mas quem sabe?"

# game/chapters/chapter6/ch6sc10.rpy:5109
translate brazil ch6sc10_eb200103:

#   tz "L-Let’s go!"
    tz "Vamos lá!"

# game/chapters/chapter6/ch6sc10.rpy:5112
translate brazil ch6sc10_bc641bc6:

#   "The three of you meet up with Orianna at the gate and you set out with directions from the huntresses of the beach."
    "Vocês três se encontram com Orianna no portão e partem seguindo as instruções das caçadoras da praia."

# game/chapters/chapter6/ch6sc10.rpy:5123
translate brazil ch6sc10_233b404c:

#   pl "Mmgh! Nothing like a nighttime swim!"
    pl "Hum! Nada como um mergulho noturno!"

# game/chapters/chapter6/ch6sc10.rpy:5124
translate brazil ch6sc10_f290c9f4:

#   pl "And nobody got eaten by sharks! *Giggles*"
    pl "E ninguém foi devorado por tubarões! *Risos*"

# game/chapters/chapter6/ch6sc10.rpy:5126
translate brazil ch6sc10_1ca22375:

#   pl "Now, if you’ll excuse me, I’m going to wash off the salt water."
    pl "Agora, com licença, vou lavar a água salgada."

# game/chapters/chapter6/ch6sc10.rpy:5127
translate brazil ch6sc10_c376032b:

#   pl "We have roughly two days at sea depending on the winds, until we reach Looter’s Bay, so make yourselves comfortable!"
    pl "Teremos aproximadamente dois dias no mar, dependendo dos ventos, até chegarmos à Baía dos Saqueadores, então fiquem à vontade!"

# game/chapters/chapter6/ch6sc10.rpy:5129
translate brazil ch6sc10_bcae2b57:

#   tz "Uhh… she was kidding about the sharks, right?"
    tz "Hum… ela estava brincando sobre os tubarões, né?"

# game/chapters/chapter6/ch6sc10.rpy:5130
translate brazil ch6sc10_abc53b6e:

#   tz "Right???"
    tz "Certo???"

# game/chapters/chapter6/ch6sc10.rpy:5131
translate brazil ch6sc10_eb6a0442:

#   ori "*Giggles* …"
    ori "*Risos* …"

# game/chapters/chapter6/ch6sc10.rpy:5133
translate brazil ch6sc10_d0b5e924:

#   tz "Oh! Hell no!"
    tz "Oh! De jeito nenhum!"

# game/chapters/chapter6/ch6sc10.rpy:5134
translate brazil ch6sc10_dfe9b8aa:

#   tz "I-... I need to go lay down for a bit, before I have a heart attack."
    tz "Eu... eu preciso me deitar um pouco, antes que eu tenha um ataque cardíaco."

# game/chapters/chapter6/ch6sc10.rpy:5135
translate brazil ch6sc10_738c390f:

#   mc "There’s a comfortable bed in the captain's quarters, you can rest in there."
    mc "Há uma cama confortável na cabine do capitão, você pode descansar lá."

# game/chapters/chapter6/ch6sc10.rpy:5136
translate brazil ch6sc10_fe1e20c6:

#   tz "Thank you, I’ll see you guys later."
    tz "Obrigado, vejo vocês mais tarde."

# game/chapters/chapter6/ch6sc10.rpy:5138
translate brazil ch6sc10_d02cb220:

#   mc "And then there were two."
    mc "E então ficaram dois."

# game/chapters/chapter6/ch6sc10.rpy:5139
translate brazil ch6sc10_f7e68355:

#   mc "How are you holding up?"
    mc "Como você está?"

# game/chapters/chapter6/ch6sc10.rpy:5140
translate brazil ch6sc10_15f7a721:

#   mc "The trek through the jungle to the beach took almost two hours and then one hour to swim to the ship."
    mc "A caminhada pela selva até a praia levou quase duas horas e depois mais uma hora para nadar até o navio."

# game/chapters/chapter6/ch6sc10.rpy:5142
translate brazil ch6sc10_8f7f8110:

#   ori "Sure, it was a little rough, but I managed."
    ori "Sim, foi um pouco difícil, mas consegui."

# game/chapters/chapter6/ch6sc10.rpy:5143
translate brazil ch6sc10_e43c236c:

#   ori "I had a rather capable man looking out for me afterall."
    ori "Afinal, eu tinha um homem bastante competente cuidando de mim."

# game/chapters/chapter6/ch6sc10.rpy:5145
translate brazil ch6sc10_a6d065fa:

#   ori "Thank you by the way, for assisting me during the swim…"
    ori "Aliás, muito obrigado por me ajudar durante a natação…"

# game/chapters/chapter6/ch6sc10.rpy:5146
translate brazil ch6sc10_a584233a:

#   ori "I’m not a strong swimmer as you noticed."
    ori "Como você deve ter percebido, eu não sou um bom nadador."

# game/chapters/chapter6/ch6sc10.rpy:5148
translate brazil ch6sc10_2ace2314:

#   mc "You’re most welcome, Ori."
    mc "De nada, Ori."

# game/chapters/chapter6/ch6sc10.rpy:5149
translate brazil ch6sc10_63a42b47:

#   mc "I couldn’t exactly let you down, your safety is the whole reason we came out here in the first place."
    mc "Eu não poderia te decepcionar, sua segurança é o principal motivo de termos vindo até aqui."

# game/chapters/chapter6/ch6sc10.rpy:5151
translate brazil ch6sc10_8aac6b84:

#   ori "Right! I suppose you did it just for the mission…"
    ori "Certo! Imagino que você fez isso apenas pela missão…"

# game/chapters/chapter6/ch6sc10.rpy:5156
translate brazil ch6sc10_06844f01:

#   mc "I think we both know…"
    mc "Acho que nós dois sabemos…"

# game/chapters/chapter6/ch6sc10.rpy:5158
translate brazil ch6sc10_7187d3e6:

#   mc "The mission was the last thing on my mind after I met you."
    mc "A missão era a última coisa em que eu pensava depois que te conheci."

# game/chapters/chapter6/ch6sc10.rpy:5159
translate brazil ch6sc10_9aa580c7:

#   ori "Nnhh… I see…"
    ori "Hum… entendi…"

# game/chapters/chapter6/ch6sc10.rpy:5160
translate brazil ch6sc10_0945dea7:

#   ori "I-... I had hoped that would be the case."
    ori "Eu... eu esperava que fosse esse o caso."

# game/chapters/chapter6/ch6sc10.rpy:5162
translate brazil ch6sc10_f6f73106:

#   "Orianna enjoys your flirtation, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Orianna gosta da sua paquera, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc10.rpy:5166
translate brazil ch6sc10_78aff081:

#   mc "Mhm, the mission comes above all."
    mc "Sim, a missão vem acima de tudo."

# game/chapters/chapter6/ch6sc10.rpy:5167
translate brazil ch6sc10_3d34d1ee:

#   mc "Nothing will happen to you under my watch."
    mc "Nada lhe acontecerá enquanto eu estiver de guarda."

# game/chapters/chapter6/ch6sc10.rpy:5169
translate brazil ch6sc10_32348515:

#   ori "That’s… good."
    ori "Isso é bom."

# game/chapters/chapter6/ch6sc10.rpy:5173
translate brazil ch6sc10_47c0ee90:

#   ori "This is one thing I love about my job, I travel quite often, usually at sea."
    ori "Uma das coisas que eu adoro no meu trabalho é que viajo com bastante frequência, geralmente pelo mar."

# game/chapters/chapter6/ch6sc10.rpy:5174
translate brazil ch6sc10_98dfa199:

#   ori "The air out here is so fresh, and the ambiance of the waves brushing against the ship, with the occasional seagull."
    ori "O ar aqui é tão fresco, e a atmosfera das ondas batendo no navio, com a presença ocasional de uma gaivota, é maravilhosa."

# game/chapters/chapter6/ch6sc10.rpy:5176
translate brazil ch6sc10_fe39a9d6:

#   ori "It brings peace and quiet to one's mind, which is sorely needed in the world of politics."
    ori "Isso traz paz e tranquilidade à mente, algo extremamente necessário no mundo da política."

# game/chapters/chapter6/ch6sc10.rpy:5178
translate brazil ch6sc10_4d98f32a:

#   mc "Yeah, I can imagine… as you know, I’m not too keen on politics, I don’t have the temperament for it."
    mc "Sim, consigo imaginar... como você sabe, não sou muito fã de política, não tenho o temperamento para isso."

# game/chapters/chapter6/ch6sc10.rpy:5180
translate brazil ch6sc10_69c15d90:

#   ori "Oh you’d totally end up strangling some sophisticated aristocrat on the first day! *Snickers*"
    ori "Ah, você com certeza acabaria estrangulando algum aristocrata sofisticado logo no primeiro dia! *Risos*"

# game/chapters/chapter6/ch6sc10.rpy:5181
translate brazil ch6sc10_0aaba195:

#   mc "*Chuckles* That sounds about right."
    mc "*Risos* Parece bem plausível."

# game/chapters/chapter6/ch6sc10.rpy:5183
translate brazil ch6sc10_8ea504e2:

#   mc "Although, you’re a politician… yet I seem to enjoy your company."
    mc "Embora você seja um político... ainda assim, parece que gosto da sua companhia."

# game/chapters/chapter6/ch6sc10.rpy:5185
translate brazil ch6sc10_5cadbe60:

#   ori "[mc], I-... I rather enjoy yours as well, I must admit."
    ori "[mc] Eu... devo admitir que também gosto bastante do seu."

# game/chapters/chapter6/ch6sc10.rpy:5186
translate brazil ch6sc10_ff001f7e:

#   ori "I’m certainly glad you don’t feel the need to strangle me every time I utter a sentence. *Giggles*"
    ori "Fico muito feliz que você não sinta necessidade de me estrangular cada vez que eu digo uma frase. *Risos*"

# game/chapters/chapter6/ch6sc10.rpy:5188
translate brazil ch6sc10_b0d01b60:

#   mc "Well…"
    mc "Bem…"

# game/chapters/chapter6/ch6sc10.rpy:5190
translate brazil ch6sc10_a1ec7cb4:

#   ori "*Laughs* Stop! Don’t you start!"
    ori "*Risos* Pare! Não comece!"

# game/chapters/chapter6/ch6sc10.rpy:5192
translate brazil ch6sc10_b734acd0:

#   ori "*Belly growls* Uh…"
    ori "*Barriga ronca* Uh…"

# game/chapters/chapter6/ch6sc10.rpy:5193
translate brazil ch6sc10_3ef48203:

#   ori "I think I’ll go look if there’s anything we can cook up for dinner in the ship's storage."
    ori "Acho que vou dar uma olhada para ver se tem alguma coisa que possamos preparar para o jantar no depósito do navio."

# game/chapters/chapter6/ch6sc10.rpy:5195
translate brazil ch6sc10_62c0d942:

#   mc "There should be, the storage on these ships have been enchanted with cooling magic by their Admiral."
    mc "Deveria haver, já que os compartimentos de armazenamento nesses navios foram encantados com magia de resfriamento pelo seu Almirante."

# game/chapters/chapter6/ch6sc10.rpy:5197
translate brazil ch6sc10_7b24e65c:

#   ori "Great, I’ll attempt to whip something up for dinner that we can all enjoy."
    ori "Ótimo, vou tentar preparar algo para o jantar que todos possamos apreciar."

# game/chapters/chapter6/ch6sc10.rpy:5199
translate brazil ch6sc10_4d59e790:

#   ori "*Giggles lightly* Just… don’t judge my cooking, okay? I’ll have to make do with whatever we have."
    ori "*Risinhos discretos* Só... não julgue minha comida, tá bom? Vou ter que me virar com o que tivermos."

# game/chapters/chapter6/ch6sc10.rpy:5201
translate brazil ch6sc10_7237ea4e:

#   ori "But when you arrive in Arazalia, and I’m showing you around… we could have dinner at my place?"
    ori "Mas quando você chegar em Arazalia, e eu estiver te mostrando a cidade… poderíamos jantar na minha casa?"

# game/chapters/chapter6/ch6sc10.rpy:5203
translate brazil ch6sc10_6cd3e245:

#   mc "I’d like that, Orianna."
    mc "Eu gostaria disso, Orianna."

# game/chapters/chapter6/ch6sc10.rpy:5205
translate brazil ch6sc10_138453ac:

#   ori "Perfect! Then I’ll be able to do my cooking justice, and you’ll get to taste the local cuisine."
    ori "Perfeito! Assim, poderei fazer justiça à minha culinária e você poderá provar a gastronomia local."

# game/chapters/chapter6/ch6sc10.rpy:5207
translate brazil ch6sc10_2f337405:

#   ori "Join me in the dining area in about an hour, okay?"
    ori "Junte-se a mim na sala de jantar daqui a uma hora, ok?"

# game/chapters/chapter6/ch6sc10.rpy:5208
translate brazil ch6sc10_b9710c73:

#   mc "Sure thing."
    mc "Claro que sim."

# game/chapters/chapter6/ch6sc10.rpy:5209
translate brazil ch6sc10_3079200a:

#   ori "Oh! And tell the others as well. They must be famished from the jungle trek and swim."
    ori "Ah! E conte para os outros também. Eles devem estar famintos depois da trilha e do mergulho na selva."

# game/chapters/chapter6/ch6sc10.rpy:5210
translate brazil ch6sc10_7df1785e:

#   mc "Will do, and thank you, for making us all dinner."
    mc "Farei isso, e obrigada por preparar o jantar para todos nós."

# game/chapters/chapter6/ch6sc10.rpy:5219
translate brazil ch6sc10_7f06641c:

#   "You decide to head to the bath area below deck to check on Pearl."
    "Você decide ir até a área dos banheiros no convés inferior para verificar como está Pearl."

# game/chapters/chapter6/ch6sc10.rpy:5220
translate brazil ch6sc10_76326077:

#   pl "Who’s there?"
    pl "Quem está aí?"

# game/chapters/chapter6/ch6sc10.rpy:5221
translate brazil ch6sc10_6e12f0e7:

#   mc "Just your favorite sharky."
    mc "Simplesmente o seu tubarãozinho favorito."

# game/chapters/chapter6/ch6sc10.rpy:5222
translate brazil ch6sc10_ace82aca:

