translate brazil ch6sc10_051dbed5:

#   mc "I don’t want you thinking like that."
    mc "Não quero que você pense assim."

# game/chapters/chapter6/ch6sc10.rpy:4839
translate brazil ch6sc10_99945e60:

#   vx "*Nods gently* Mmh."
    vx "*Acena levemente com a cabeça* Hum."

