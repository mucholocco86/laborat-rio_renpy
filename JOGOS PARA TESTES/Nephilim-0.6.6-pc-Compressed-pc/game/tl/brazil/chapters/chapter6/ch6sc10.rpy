translate brazil ch6sc10_b60af83e:

#   vx "O-Okay… I promise I will think happy thoughts… about your return."
    vx "Tudo bem... Prometo que vou pensar coisas boas... sobre o seu retorno."

# game/chapters/chapter6/ch6sc10.rpy:4843
translate brazil ch6sc10_88fe4adf:

#   vx "About us… hunting together."
    vx "Sobre nós… caçando juntos."

