# game/chapters/chapter6/ch6sc3.rpy:1756
translate brazil ch6sc3_4a8d1671:

#   sj "I have not."
    sj "Não."

# game/chapters/chapter6/ch6sc3.rpy:1757
translate brazil ch6sc3_aed24067:

#   sj "Why do you ask?"
    sj "Por que você pergunta?"

# game/chapters/chapter6/ch6sc3.rpy:1759
translate brazil ch6sc3_9c7104cd:

#   mc "Just curious. Echo said that the leaders of each faction don't partake, but that it’s free for all others to indulge."
