# game/chapters/chapter6/ch6sc3.rpy:1761
translate brazil ch6sc3_56355313:

#   sj "Just because something is free to do, does not mean that everyone wants to partake, myself included."
    sj "O simples fato de algo ser gratuito não significa que todos queiram participar, inclusive eu."

# game/chapters/chapter6/ch6sc3.rpy:1763
translate brazil ch6sc3_74dcb5a3:

#   mc "Still, living your whole life without physical contact, you must have a lot of pent up tension."
    mc "Mesmo assim, vivendo a vida inteira sem contato físico, você deve ter muita tensão acumulada."

# game/chapters/chapter6/ch6sc3.rpy:1766
translate brazil ch6sc3_61c79c42:

#   sj "I... manage."
    sj "Eu... consigo."

# game/chapters/chapter6/ch6sc3.rpy:1767
