# ARQUIVO: game/chapters/chapter6/ch6sc3.rpy DIALOGOS: 1709


# game/chapters/chapter6/ch6sc3.rpy:11
translate brazil ch6sc3_b9971b30:

#   bn "It’s so good to see you on your feet again, sweetie."
    bn "Que bom te ver de pé de novo, querida."

# game/chapters/chapter6/ch6sc3.rpy:12
translate brazil ch6sc3_dd8b9387:

#   am "I’ve been back on my feet for the better part of a week now. Good of you to notice... Father."
    am "Já faz quase uma semana que estou de pé novamente. Que bom que você notou... Pai."

# game/chapters/chapter6/ch6sc3.rpy:14
translate brazil ch6sc3_465c0d8b:

#   bn "Right, your mother let me know you were in good health."
    bn "Certo, sua mãe me disse que você está com boa saúde."

# game/chapters/chapter6/ch6sc3.rpy:15
translate brazil ch6sc3_803d7e4b:

#   bn "I just haven’t had the time to see for myself lately."
    bn "Ultimamente, simplesmente não tenho tido tempo para ver com meus próprios olhos."

# game/chapters/chapter6/ch6sc3.rpy:16
translate brazil ch6sc3_1c8acf17:

#   am "..."
    am "..."

# game/chapters/chapter6/ch6sc3.rpy:18
translate brazil ch6sc3_013e9157:

#   am "*Quietly* {size=-10}{b}You never do...{/b}{/size}"
    am "*Em silêncio* {size=-10}{b}Você nunca faz isso...{/b}{/size}"

# game/chapters/chapter6/ch6sc3.rpy:20
translate brazil ch6sc3_8308d0df:

#   bn "With everything that's been going on..."
    bn "Com tudo o que tem acontecido..."

# game/chapters/chapter6/ch6sc3.rpy:21
translate brazil ch6sc3_aebc644d:

#   bn "The unrest in the south that's bordering on civil-war..."
    bn "A instabilidade no sul está à beira de uma guerra civil..."

# game/chapters/chapter6/ch6sc3.rpy:23
translate brazil ch6sc3_32b39d47:

#   bn "Combined with your kidnapping. And discovering that Taron played a part in it..."
    bn "Somado ao seu sequestro. E à descoberta de que Taron teve participação nisso..."

# game/chapters/chapter6/ch6sc3.rpy:25
translate brazil ch6sc3_3ebe42cd:

#   bn "*Sighs* And then there’s {b}Looter’s Bay{/b}."
    bn "*Suspiros* E então há {b} Baía dos Saqueadores{/b}."

# game/chapters/chapter6/ch6sc3.rpy:26
translate brazil ch6sc3_0a242101:

#   bn "It's a vital location for the health of our trade-routes and we need to get it under control."
    bn "É um local vital para a saúde das nossas rotas comerciais e precisamos controlar a situação."

# game/chapters/chapter6/ch6sc3.rpy:28
translate brazil ch6sc3_111534c5:

#   bn "With all of that, it’s been hard to find the time to be a father too."
    bn "Com tudo isso, tem sido difícil encontrar tempo para também ser pai."

# game/chapters/chapter6/ch6sc3.rpy:30
translate brazil ch6sc3_43007a95:

#   qm "She understands that. We both do..."
    qm "Ela entende isso. Nós dois entendemos..."

# game/chapters/chapter6/ch6sc3.rpy:32
translate brazil ch6sc3_97776f2f:

#   qm "But being a parent isn’t just a title."
    qm "Mas ser pai ou mãe não é apenas um título."

# game/chapters/chapter6/ch6sc3.rpy:33
translate brazil ch6sc3_890b8529:

#   qm "You have to actively participate. Look at it from her perspective..."
    qm "Você precisa participar ativamente. Veja a situação da perspectiva dela..."

# game/chapters/chapter6/ch6sc3.rpy:35
translate brazil ch6sc3_a14ce613:

#   qm "She was kidnapped and beaten, scared and alone..."
    qm "Ela foi sequestrada e espancada, estava assustada e sozinha..."

# game/chapters/chapter6/ch6sc3.rpy:36
translate brazil ch6sc3_cfa3fb18:

#   qm "And yet her father hasn't even made time to check on her now that she's home?"
    qm "E, no entanto, o pai dela nem sequer arranjou tempo para ver como ela está agora que ela voltou para casa?"

# game/chapters/chapter6/ch6sc3.rpy:38
translate brazil ch6sc3_14b8b8d4:

#   qm "We both understand your duties as king, but try to remember your duties as a father as well."
    qm "Ambos compreendemos seus deveres como rei, mas tente se lembrar também de seus deveres como pai."

# game/chapters/chapter6/ch6sc3.rpy:40
translate brazil ch6sc3_8d4f90c9:

#   bn "*Sighs deeply* You’re right... I know you’re right."
    bn "*Suspira profundamente* Você tem razão... Eu sei que você tem razão."

# game/chapters/chapter6/ch6sc3.rpy:41
translate brazil ch6sc3_69383011:

#   bn "I've just been so caught up in it all. Especially with everything going on right now..."
    bn "Tenho estado tão envolvida com tudo isso. Principalmente com tudo o que está acontecendo agora..."

# game/chapters/chapter6/ch6sc3.rpy:43
translate brazil ch6sc3_84d5bd01:

#   bn "Amelia, sweetie... allow me to make it up to you? Why don’t you and I spend the day together?"
    bn "Amélia, querida... permita-me compensar você? Que tal passarmos o dia juntos?"

# game/chapters/chapter6/ch6sc3.rpy:44
translate brazil ch6sc3_c2d3b7ee:

#   bn "We could take a trip to the city since you seem to enjoy it out there."
    bn "Poderíamos fazer uma viagem à cidade, já que você parece gostar de lá."

# game/chapters/chapter6/ch6sc3.rpy:46
translate brazil ch6sc3_502d1ebc:

#   am "R-Really?"
    am "Sério?"

# game/chapters/chapter6/ch6sc3.rpy:47
translate brazil ch6sc3_234c228b:

#   am "We haven’t visited the market together since I was a child."
    am "Não vamos ao mercado juntos desde que eu era criança."

# game/chapters/chapter6/ch6sc3.rpy:49
translate brazil ch6sc3_05969434:

#   bn "I know. I’ve been less and less present the more you've grown."
    bn "Eu sei. Tenho estado cada vez menos presente à medida que você cresce."

# game/chapters/chapter6/ch6sc3.rpy:50
translate brazil ch6sc3_0bdaaea4:

#   bn "But I’d like to start making amends for souring our relationship, if I can."
    bn "Mas eu gostaria de começar a reparar o dano que causei ao nosso relacionamento, se possível."

# game/chapters/chapter6/ch6sc3.rpy:51
translate brazil ch6sc3_238286ba:

#   bn "Now, I can’t promise I'll be able to do it frequently..."
    bn "Bem, não posso prometer que conseguirei fazer isso com frequência..."

# game/chapters/chapter6/ch6sc3.rpy:52
translate brazil ch6sc3_5bc01f0f:

#   bn "But I’d like to try to spend more time with you."
    bn "Mas eu gostaria de tentar passar mais tempo com você."

# game/chapters/chapter6/ch6sc3.rpy:53
translate brazil ch6sc3_99ec178d:

#   bn "Maybe start to get to know the woman you’ve become instead of the child I keep imagining you still are."
    bn "Talvez você devesse começar a conhecer a mulher que se tornou, em vez da criança que continuo imaginando que você ainda seja."

# game/chapters/chapter6/ch6sc3.rpy:55
translate brazil ch6sc3_f1f210eb:

#   am "Father... Okay."
    am "Pai... Tudo bem."

# game/chapters/chapter6/ch6sc3.rpy:56
translate brazil ch6sc3_40f03956:

#   am "I - I’d like that as well."
    am "Eu também gostaria disso."

# game/chapters/chapter6/ch6sc3.rpy:58
translate brazil ch6sc3_a49aca88:

#   am "By the way, have either of you heard from [mc]? I wish to host a banquet for him and his guild."
    am "A propósito, algum de vocês teve notícias de... [mc] Gostaria de oferecer um banquete para ele e sua guilda."

# game/chapters/chapter6/ch6sc3.rpy:59
translate brazil ch6sc3_841b8580:

#   am "They... all worked together to save me."
    am "Eles... todos trabalharam juntos para me salvar."

# game/chapters/chapter6/ch6sc3.rpy:60
translate brazil ch6sc3_abcf1aea:

#   am "I want to thank them personally."
    am "Quero agradecer-lhes pessoalmente."

# game/chapters/chapter6/ch6sc3.rpy:62
translate brazil ch6sc3_76bb63ef:

#   qm "That’s a wonderful idea, honey."
    qm "Que ideia maravilhosa, querida."

# game/chapters/chapter6/ch6sc3.rpy:63
translate brazil ch6sc3_daf3c325:

#   qm "I'm glad you're being proactive about these things."
    qm "Fico feliz que você esteja sendo proativo em relação a essas coisas."

# game/chapters/chapter6/ch6sc3.rpy:64
translate brazil ch6sc3_617c1dd3:

#   qm "Unfortunately, I haven’t heard from [mc] either."
    qm "Infelizmente, não tive notícias. [mc] qualquer."

# game/chapters/chapter6/ch6sc3.rpy:65
translate brazil ch6sc3_a2354222:

#   qm "Quite frankly, I’m a little concerned. I'd expected him to be around more given all that’s happened."
    qm "Sinceramente, estou um pouco preocupado. Esperava que ele estivesse mais presente, considerando tudo o que aconteceu."

# game/chapters/chapter6/ch6sc3.rpy:67
translate brazil ch6sc3_c14548ec:

#   bn "Let me put your minds at ease: [mc] is not in Luxenford currently."
    bn "Deixe-me tranquilizá-los: [mc] Atualmente não está em Luxemburgo."

# game/chapters/chapter6/ch6sc3.rpy:68
translate brazil ch6sc3_d3d3c0aa:

#   bn "Earlier, I mentioned Looter’s Bay has been a distraction lately."
    bn "Anteriormente, mencionei que a Baía dos Saqueadores tem sido uma distração ultimamente."

# game/chapters/chapter6/ch6sc3.rpy:69
translate brazil ch6sc3_0e991aa0:

#   bn "I recently sent {b}Lord Admiral Diana{/b}, of the 1st Vanguard fleet, to handle the situation there."
    bn "Eu enviei recentemente {b} Lorde Almirante Diana{/b}, da 1ª Frota de Vanguarda, para lidar com a situação no local."

# game/chapters/chapter6/ch6sc3.rpy:71
translate brazil ch6sc3_18bd4f3d:

#   bn "The Admiral sent me word enquiring about [mc] and his status here in the palace."
    bn "O Almirante me enviou uma mensagem perguntando sobre [mc] e sua posição aqui no palácio."

# game/chapters/chapter6/ch6sc3.rpy:73
translate brazil ch6sc3_e89bde6b:

#   bn "Of course, I let her know that he holds the rank of royal guard, since he's Amelia's bodyguard."
    bn "É claro que eu a informei de que ele possui a patente de guarda real, já que é o guarda-costas de Amelia."

# game/chapters/chapter6/ch6sc3.rpy:75
translate brazil ch6sc3_fadbd2d0:

#   am "G-Good... he’ll be back soon then?"
    am "Ótimo... então ele volta logo?"

# game/chapters/chapter6/ch6sc3.rpy:77
translate brazil ch6sc3_2f5160d0:

#   qm "Worry not, darling, I’m sure he’ll be back with us before we know it."
    qm "Não se preocupe, querida, tenho certeza de que ele estará de volta conosco antes que percebamos."

# game/chapters/chapter6/ch6sc3.rpy:79
translate brazil ch6sc3_d2ef771b:

#   qm "Right? He’ll be back soon?"
    qm "Certo? Ele volta logo?"

# game/chapters/chapter6/ch6sc3.rpy:81
translate brazil ch6sc3_09d85e1c:

#   bn "*Sighs* Not as soon as the two of you would like, I’m afraid."
    bn "*Suspiro* Receio que não tão cedo quanto vocês dois gostariam."

# game/chapters/chapter6/ch6sc3.rpy:82
translate brazil ch6sc3_2e352a21:

#   bth "What? Why not? When will he be back?"
    bth "O quê? Por que não? Quando ele volta?"

# game/chapters/chapter6/ch6sc3.rpy:84
translate brazil ch6sc3_3f405d43:

#   bn "I don't know for certain."
    bn "Não sei ao certo."

# game/chapters/chapter6/ch6sc3.rpy:85
translate brazil ch6sc3_f666ed31:

#   bn "The Admiral’s letter mentioned she'd tasked him to rescue the lost Ambassador from Arazalia."
    bn "A carta da Almirante mencionava que ela o havia incumbido de resgatar o Embaixador desaparecido em Arazalia."

# game/chapters/chapter6/ch6sc3.rpy:87
translate brazil ch6sc3_4b3a7911:

#   am "Great... marvelous..."
    am "Ótimo... maravilhoso..."

# game/chapters/chapter6/ch6sc3.rpy:88
translate brazil ch6sc3_4e6a1b71:

#   am "Just... wonderful."
    am "Simplesmente... maravilhoso."

# game/chapters/chapter6/ch6sc3.rpy:90
translate brazil ch6sc3_566b7fec:

#   bn "Cheer up, honey. Now that Taron is in hiding and their plot has been thwarted, you should be safe for a while."
    bn "Anime-se, querida. Agora que Taron está escondido e o plano deles foi frustrado, você estará segura por um tempo."

# game/chapters/chapter6/ch6sc3.rpy:92
translate brazil ch6sc3_e443d50c:

#   bn "Don't fret that [mc] isn't guarding you right now."
    bn "Não se preocupe com isso. [mc] Não está te protegendo agora."

# game/chapters/chapter6/ch6sc3.rpy:94
translate brazil ch6sc3_7ed747ba:

#   qm "Men..."
    qm "Homens..."

# game/chapters/chapter6/ch6sc3.rpy:95
translate brazil ch6sc3_60ab10ac:

#   qm "Dear husband, can’t you see that this isn’t about wanting protection? Your daughter has made a friend."
    qm "Meu querido marido, você não percebe que isso não tem nada a ver com querer proteção? Sua filha fez uma amiga."

# game/chapters/chapter6/ch6sc3.rpy:97
translate brazil ch6sc3_ec2ba84b:

#   qm "As I said, I’m sure he’ll be back with us soon."
    qm "Como eu disse, tenho certeza de que ele estará de volta conosco em breve."

# game/chapters/chapter6/ch6sc3.rpy:98
translate brazil ch6sc3_1e58498f:

#   qm "Until then, let’s try not to worry about things that we can't control."
    qm "Até lá, vamos tentar não nos preocupar com coisas que não podemos controlar."

# game/chapters/chapter6/ch6sc3.rpy:100
translate brazil ch6sc3_b2c48095:

#   qm "Why don’t you go get ready for your daytrip, sweetie?"
    qm "Por que você não vai se arrumar para o seu passeio, querida?"

# game/chapters/chapter6/ch6sc3.rpy:102
translate brazil ch6sc3_2421bf91:

#   am "*Sighs* Okay, I’ll be ready in about an hour."
    am "*Suspiro* Ok, estarei pronto em cerca de uma hora."

# game/chapters/chapter6/ch6sc3.rpy:103
translate brazil ch6sc3_b9fa0580:

#   bn "Sounds great, honey. I’ll meet you at the palace entrance. I'm looking forward to spending the day with you."
    bn "Ótimo, querida. Te encontro na entrada do palácio. Estou ansiosa para passar o dia com você."

# game/chapters/chapter6/ch6sc3.rpy:104
translate brazil ch6sc3_47c08b80:

#   am "Mmh..."
    am "Hum..."

# game/chapters/chapter6/ch6sc3.rpy:116
translate brazil ch6sc3_4136c130:

#   mc "Huh? What the...?"
    mc "Hein? Que...?"

# game/chapters/chapter6/ch6sc3.rpy:118
translate brazil ch6sc3_29541dfe:

#   mc "I’m back at the shrine."
    mc "Estou de volta ao santuário."

# game/chapters/chapter6/ch6sc3.rpy:119
translate brazil ch6sc3_a8eab74a:

#   mc "But... how? It’s not possible..."
    mc "Mas... como? Não é possível..."

# game/chapters/chapter6/ch6sc3.rpy:121
translate brazil ch6sc3_7b6926ab:

#   mc "I didn’t make any turns. I followed the tracks until they faded out..."
    mc "Não fiz nenhuma curva. Segui os rastros até que eles desapareceram..."

# game/chapters/chapter6/ch6sc3.rpy:122
translate brazil ch6sc3_3b67064c:

#   mc "And when I pushed through the undergrowth, somehow I found myself back here?"
    mc "E quando consegui abrir caminho pela vegetação rasteira, de alguma forma me vi de volta aqui?"

# game/chapters/chapter6/ch6sc3.rpy:124
translate brazil ch6sc3_712c0698:

#   zy "So, now you’ve experienced the mist yourself. Not so easy to navigate, is it?"
    zy "Então, agora você mesmo experimentou a neblina. Não é tão fácil de navegar, não é?"

# game/chapters/chapter6/ch6sc3.rpy:125
translate brazil ch6sc3_0d1bc075:

#   zy "Whenever someone tries to conquer the mist, it always brings them right back to where they started."
    zy "Sempre que alguém tenta vencer a névoa, acaba voltando ao ponto de partida."

# game/chapters/chapter6/ch6sc3.rpy:127
translate brazil ch6sc3_e1a81e74:

#   sj "Like a living maze."
    sj "Como um labirinto vivo."

# game/chapters/chapter6/ch6sc3.rpy:128
translate brazil ch6sc3_ea6474a9:

#   sj "No matter how hard we’ve tried in the past, the mist is absolute, always victorious."
    sj "Por mais que tenhamos nos esforçado no passado, a névoa é absoluta, sempre vitoriosa."

# game/chapters/chapter6/ch6sc3.rpy:130
translate brazil ch6sc3_70d4162b:

#   zy "It is known."
    zy "Isso é conhecido."

# game/chapters/chapter6/ch6sc3.rpy:132
translate brazil ch6sc3_5781d03d:

#   mc "Hmm... then, what can we do?"
    mc "Hum... então, o que podemos fazer?"

# game/chapters/chapter6/ch6sc3.rpy:133
translate brazil ch6sc3_4c98ff3a:

#   mc "Just sit here twiddling our thumbs and wait for the mist to eventually dissipate?"
    mc "Ficar aqui sentados de braços cruzados esperando a neblina dissipar por completo?"

# game/chapters/chapter6/ch6sc3.rpy:135
translate brazil ch6sc3_3e9d2b5e:

#   mi "Not necessarily-"
    mi "Não necessariamente."

# game/chapters/chapter6/ch6sc3.rpy:136
translate brazil ch6sc3_f337b711:

#   mi "I’ve spotted several berry bushes around here that Pearl and I can forage from while we wait."
    mi "Avistei vários arbustos de frutos silvestres por aqui, dos quais Pearl e eu podemos colher enquanto esperamos."

# game/chapters/chapter6/ch6sc3.rpy:138
translate brazil ch6sc3_c16ff259:

#   pl "Music to my ears. It’ll be much better to stay occupied."
    pl "Que maravilha! Vai ser muito melhor me manter ocupado."

# game/chapters/chapter6/ch6sc3.rpy:139
translate brazil ch6sc3_719f07c8:

#   pl "We'll leave it up to [mc] to find a way out of here."
    pl "Deixaremos isso a cargo de [mc] Para encontrar uma saída daqui."

# game/chapters/chapter6/ch6sc3.rpy:141
translate brazil ch6sc3_74470334:

#   mc "Okay. Miyo, Pearl... the two of you will keep foraging while we’re here."
    mc "Certo. Miyo, Pearl... vocês duas vão continuar coletando alimentos enquanto estivermos aqui."

# game/chapters/chapter6/ch6sc3.rpy:142
translate brazil ch6sc3_e84d0910:

#   mc "Zyra, Suji... do either of you know anything else that might give us a clue about this area?"
    mc "Zyra, Suji... alguma de vocês sabe de mais alguma coisa que possa nos dar uma pista sobre essa área?"

# game/chapters/chapter6/ch6sc3.rpy:144
translate brazil ch6sc3_4e7b6421:

#   mc "Maybe something your ancestors have passed down about the shrines, or tales about the mist?"
    mc "Talvez algo que seus ancestrais tenham transmitido sobre os santuários, ou histórias sobre a névoa?"

# game/chapters/chapter6/ch6sc3.rpy:145
translate brazil ch6sc3_4595d5ba:

#   bth "*Nods* Mm..."
    bth "*Acena com a cabeça* Hum..."

# game/chapters/chapter6/ch6sc3.rpy:147
translate brazil ch6sc3_6647a77a:

#   sj "I do remember one thing..."
    sj "Lembro-me de uma coisa..."

# game/chapters/chapter6/ch6sc3.rpy:148
translate brazil ch6sc3_85bdd316:

#   sj "One of the old priestesses used to tell us tales about these shrines..."
    sj "Uma das antigas sacerdotisas costumava nos contar histórias sobre esses santuários..."

# game/chapters/chapter6/ch6sc3.rpy:149
translate brazil ch6sc3_100f1dc7:

#   sj "They didn’t really stick in my mind. We were just younglings at the time."
    sj "Elas não ficaram realmente na minha memória. Éramos apenas crianças na época."

# game/chapters/chapter6/ch6sc3.rpy:151
translate brazil ch6sc3_b19110e1:

#   mc "What? What did she say about them?"
    mc "O quê? O que ela disse sobre eles?"

# game/chapters/chapter6/ch6sc3.rpy:153
translate brazil ch6sc3_de1de096:

#   sj "She claimed that the shrines were conduits for the gods."
    sj "Ela alegava que os santuários eram canais para os deuses."

# game/chapters/chapter6/ch6sc3.rpy:154
translate brazil ch6sc3_df5d3259:

#   sj "And that only someone who has their favor can hope to access their knowledge."
    sj "E somente alguém que tenha o seu favor pode esperar ter acesso ao seu conhecimento."

# game/chapters/chapter6/ch6sc3.rpy:156
translate brazil ch6sc3_661b1208:

#   sj "Her meaning has always been a mystery to me."
    sj "O significado disso sempre foi um mistério para mim."

# game/chapters/chapter6/ch6sc3.rpy:158
translate brazil ch6sc3_0cd1da5c:

#   sj "But you... you've been blessed with an artifact of the gods."
    sj "Mas você... você foi abençoado com um artefato dos deuses."

# game/chapters/chapter6/ch6sc3.rpy:159
translate brazil ch6sc3_ad63cc86:

#   sj "Maybe...?"
    sj "Talvez...?"

# game/chapters/chapter6/ch6sc3.rpy:161
translate brazil ch6sc3_2a4c89b6:

#   zy "Maybe that is what she meant?"
    zy "Talvez fosse isso que ela queria dizer?"

# game/chapters/chapter6/ch6sc3.rpy:162
translate brazil ch6sc3_b0895a80:

#   zy "That only someone with their artifact can access the shrines?"
    zy "Que apenas quem possuir o artefato poderá acessar os santuários?"

# game/chapters/chapter6/ch6sc3.rpy:164
translate brazil ch6sc3_6c0caa94:

#   sj "I believe you're right."
    sj "Acho que você tem razão."

# game/chapters/chapter6/ch6sc3.rpy:165
translate brazil ch6sc3_105ebef3:

#   sj "Maybe that's why [mc] could sense the shrine from far away, while we could not."
    sj "Talvez seja por isso. [mc] podíamos sentir a presença do santuário de longe, enquanto nós não conseguíamos."

# game/chapters/chapter6/ch6sc3.rpy:167
translate brazil ch6sc3_61d4b2ef:

#   sj "Please, approach the shrine and see what happens."
    sj "Por favor, aproxime-se do santuário e veja o que acontece."

# game/chapters/chapter6/ch6sc3.rpy:169
translate brazil ch6sc3_f954e79c:

#   zy "Are we sure this is a good idea? The shrines... they’re sacred."
    zy "Temos certeza de que isso é uma boa ideia? Os santuários... eles são sagrados."

# game/chapters/chapter6/ch6sc3.rpy:170
translate brazil ch6sc3_e5d8d15d:

#   zy "He seems friendly, but he remains an outsider..."
    zy "Ele parece amigável, mas continua sendo um forasteiro..."

# game/chapters/chapter6/ch6sc3.rpy:172
translate brazil ch6sc3_25b7db54:

#   mc "The necklace... it’s vibrating as I get closer to the shrine!"
    mc "O colar... está vibrando conforme me aproximo do santuário!"

# game/chapters/chapter6/ch6sc3.rpy:173
translate brazil ch6sc3_f5180a66:

#   sj "See? They’re connected."
    sj "Viu? Eles estão conectados."

# game/chapters/chapter6/ch6sc3.rpy:174
translate brazil ch6sc3_8ec8598a:

#   zy "Hmmh..."
    zy "Hum..."

# game/chapters/chapter6/ch6sc3.rpy:176
translate brazil ch6sc3_777e5a8e:

#   zy "If I recall, those tales also mentioned something about a change."
    zy "Se bem me lembro, essas histórias também mencionavam algo sobre uma mudança."

# game/chapters/chapter6/ch6sc3.rpy:177
translate brazil ch6sc3_9b961594:

#   zy "That anyone who seeks the acceptance of the gods must be willing to accept some kind of transformation."
    zy "Que qualquer um que busque a aceitação dos deuses deve estar disposto a aceitar algum tipo de transformação."

# game/chapters/chapter6/ch6sc3.rpy:179
translate brazil ch6sc3_aca1e479:

#   mct "{i}Hmm, accepting transformation? Sounds like what my body has been doing my entire life.{/i}"
    mct "{i}Hum, aceitar a transformação? Parece algo que meu corpo vem fazendo a vida inteira.{/i}"

# game/chapters/chapter6/ch6sc3.rpy:181
translate brazil ch6sc3_e2c9daba:

#   mct "{i}Every time I’ve absorbed a soul, or the essence of a living creature, or have been pushed beyond my limits...{/i}"
    mct "{i}Toda vez que absorvi uma alma, ou a essência de uma criatura viva, ou fui levado além dos meus limites...{/i}"

# game/chapters/chapter6/ch6sc3.rpy:183
translate brazil ch6sc3_174c7d16:

#   mct "{i}My body has always transformed itself, increasing my durability, strength, speed, and even unlocking new abilities.{/i}"
    mct "{i}Meu corpo sempre se transformou, aumentando minha resistência, força, velocidade e até mesmo desbloqueando novas habilidades.{/i}"

# game/chapters/chapter6/ch6sc3.rpy:184
translate brazil ch6sc3_7d012094:

#   sj "*Clears throat*"
    sj "*Limpa a garganta*"

# game/chapters/chapter6/ch6sc3.rpy:186
translate brazil ch6sc3_70fcaebc:

#   sj "Share your thoughts."
    sj "Compartilhe suas ideias."

# game/chapters/chapter6/ch6sc3.rpy:188
translate brazil ch6sc3_143b4c6b:

#   mc "Earlier, you said these shrines are found close to the temples, correct?"
    mc "Anteriormente, você disse que esses santuários são encontrados perto dos templos, correto?"

# game/chapters/chapter6/ch6sc3.rpy:190
translate brazil ch6sc3_c1480836:

#   sj "Yes."
    sj "Sim."

# game/chapters/chapter6/ch6sc3.rpy:192
translate brazil ch6sc3_8519a66a:

#   mc "Then I’m thinking we should attempt to find the one nearby... it could hold answers."
    mc "Então, acho que deveríamos tentar encontrar aquele que está por perto... ele pode conter as respostas."

# game/chapters/chapter6/ch6sc3.rpy:193
translate brazil ch6sc3_0192a844:

#   mc "Even if it doesn’t, it could hold more lost treasures or knowledge from your tribe's ancestors."
    mc "Mesmo que não contenha, pode guardar mais tesouros perdidos ou conhecimento dos ancestrais da sua tribo."

# game/chapters/chapter6/ch6sc3.rpy:195
translate brazil ch6sc3_a56f24a6:

#   sj "Hmh... he has a point."
    sj "Hum... ele tem razão."

# game/chapters/chapter6/ch6sc3.rpy:196
translate brazil ch6sc3_6fb2d775:

#   sj "What do you think?"
    sj "O que você acha?"

# game/chapters/chapter6/ch6sc3.rpy:198
translate brazil ch6sc3_296eee25:

#   zy "If we could recover some of what we've lost to time, it would certainly benefit the tribe in various ways."
    zy "Se pudéssemos recuperar parte do que perdemos com o tempo, isso certamente beneficiaria a tribo de diversas maneiras."

# game/chapters/chapter6/ch6sc3.rpy:199
translate brazil ch6sc3_d9783358:

#   zy "You know how much A'nu cherishes our history, and the elders would love to regain some of what we've lost."
    zy "Você sabe o quanto A'nu valoriza nossa história, e os anciãos adorariam recuperar parte do que perdemos."

# game/chapters/chapter6/ch6sc3.rpy:201
translate brazil ch6sc3_54ef7678:

#   sj "It is known."
    sj "Isso é conhecido."

# game/chapters/chapter6/ch6sc3.rpy:202
translate brazil ch6sc3_d36a0e1b:

#   sj "If nothing else, it would be a worthy feat to rediscover one of the lost {b}Temples of the Goddesses{/ib}."
    sj "No mínimo, seria uma façanha louvável redescobrir uma das perdidas. {b} Templos das Deusas{/ib}."

# game/chapters/chapter6/ch6sc3.rpy:204
translate brazil ch6sc3_dc3b1d8c:

#   sj "Okay. So, how do you want to proceed?"
    sj "Certo. Então, como você deseja prosseguir?"

# game/chapters/chapter6/ch6sc3.rpy:206
translate brazil ch6sc3_8c033c82:

#   mc "I’m thinking we should split the group."
    mc "Acho que deveríamos dividir o grupo."

# game/chapters/chapter6/ch6sc3.rpy:207
translate brazil ch6sc3_b61b1d85:

#   mc "One of you needs to remain here and watch over Pearl and Miyo while they forage, and keep this as our central hub."
    mc "Um de vocês precisa ficar aqui e vigiar Pearl e Miyo enquanto elas procuram comida, e manter este lugar como nosso ponto central."

# game/chapters/chapter6/ch6sc3.rpy:208
translate brazil ch6sc3_e18de988:

#   mc "I can always find my way back here, since I can sense the magic of the shrine."
    mc "Sempre consigo encontrar o caminho de volta para cá, pois sinto a magia do santuário."

# game/chapters/chapter6/ch6sc3.rpy:209
translate brazil ch6sc3_24d95e86:

#   mc "So, one of you could accompany me to find the temple."
    mc "Então, um de vocês poderia me acompanhar para encontrar o templo."

# game/chapters/chapter6/ch6sc3.rpy:211
translate brazil ch6sc3_1ac13b91:

#   sj "Who should go with [mc]?"
    sj "Com quem você deve ir? [mc]?"

# game/chapters/chapter6/ch6sc3.rpy:215
translate brazil ch6sc3_f8f812df:

#   mc "Suji, you'll go with me."
    mc "Suji, você irá comigo."

# game/chapters/chapter6/ch6sc3.rpy:216
translate brazil ch6sc3_55f6738a:

#   "Both girls turn their attention to you as you start taking command."
    "As duas garotas voltam sua atenção para você quando você começa a assumir o comando."

# game/chapters/chapter6/ch6sc3.rpy:218
translate brazil ch6sc3_b997b3fa:

#   sj "Y-You want me with you? Why?"
    sj "V-Você me quer com você? Por quê?"

# game/chapters/chapter6/ch6sc3.rpy:220
translate brazil ch6sc3_13a72bd0:

#   mc "I'm interested to see what you're capable of."
    mc "Tenho interesse em ver do que você é capaz."

# game/chapters/chapter6/ch6sc3.rpy:221
translate brazil ch6sc3_98100b27:

#   mc "During our talks, you've seemed to have interest for the temples and your ancestors..."
    mc "Durante nossas conversas, você pareceu ter interesse pelos templos e por seus ancestrais..."

# game/chapters/chapter6/ch6sc3.rpy:222
translate brazil ch6sc3_7c8f72ac:

#   mc "This is an opportunity for you to discover some of your history."
    mc "Esta é uma oportunidade para você descobrir um pouco da sua história."

# game/chapters/chapter6/ch6sc3.rpy:224
translate brazil ch6sc3_5c13b927:

#   sj "He's... he's right, I really would love to go with him."
    sj "Ele... ele tem razão, eu adoraria ir com ele."

# game/chapters/chapter6/ch6sc3.rpy:225
translate brazil ch6sc3_2245ee36:

#   zy "*Nods in agreement.* Mh."
    zy "*Acena com a cabeça em concordância.* Hum."

# game/chapters/chapter6/ch6sc3.rpy:227
translate brazil ch6sc3_6e864d17:

#   mc "Zyra, you'll remain here and watch over Pearl and Miyo."
    mc "Zyra, você ficará aqui e cuidará de Pearl e Miyo."

# game/chapters/chapter6/ch6sc3.rpy:228
translate brazil ch6sc3_ab1ba72d:

#   mc "I'd feel better knowing a huntress of your renown is looking after them."
    mc "Eu me sentiria melhor sabendo que uma caçadora de sua renome está cuidando deles."

# game/chapters/chapter6/ch6sc3.rpy:230
translate brazil ch6sc3_ab7ec856:

#   zy "You got it."
    zy "Você entendeu."

# game/chapters/chapter6/ch6sc3.rpy:231
translate brazil ch6sc3_c1f50974:

#   zy "No harm shall fall on them during my watch, you can count on me, [mc]."
    zy "Nenhum mal lhes sobrevirá enquanto eu estiver de guarda, podem contar comigo. [mc]."

# game/chapters/chapter6/ch6sc3.rpy:233
translate brazil ch6sc3_d883db29:

#   zy "Looks like it's settled then, I agree with [mc]'s plan."
    zy "Parece que está resolvido então, concordo com [mc] o plano de."

# game/chapters/chapter6/ch6sc3.rpy:236
translate brazil ch6sc3_0c66a3d6:

#   sj "Me too, he has a great mind for leading."
    sj "Eu também acho que ele tem uma mente brilhante para liderança."

# game/chapters/chapter6/ch6sc3.rpy:237
translate brazil ch6sc3_a4d9af25:

#   "The girls submit to your command, you succeeded in ordering them, your {b}{color=#ffee54}Leadership{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "As garotas se submetem às suas ordens, você conseguiu dar-lhes ordens, suas {b}{color=#ffee54}Liderança{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc3.rpy:241
translate brazil ch6sc3_e878a882:

#   zy "You go. I'm intrigued by the idea of these temples..."
    zy "Pode ir. Estou intrigado com a ideia desses templos..."

# game/chapters/chapter6/ch6sc3.rpy:242
translate brazil ch6sc3_5e191d8d:

#   zy "But your eyes have always widened most when the elders spoke about them."
    zy "Mas seus olhos sempre se arregalavam mais quando os mais velhos falavam sobre eles."

# game/chapters/chapter6/ch6sc3.rpy:244
translate brazil ch6sc3_8e650b58:

#   zy "I’ll remain here and watch over Pearl and Miyo."
    zy "Vou ficar aqui e cuidar de Pearl e Miyo."

# game/chapters/chapter6/ch6sc3.rpy:245
translate brazil ch6sc3_4741a6fb:

#   zy "No harm shall fall on them during my watch."
    zy "Nenhum mal lhes sobrevirá enquanto eu estiver de guarda."

# game/chapters/chapter6/ch6sc3.rpy:246
translate brazil ch6sc3_d1c4fc25:

#   "Your {color=#ffee54}Leadership{/color} was too low to take the lead in the discussion."
    "Seu {color=#ffee54} Liderança{/color} estava muito baixo para assumir a liderança na discussão."

# game/chapters/chapter6/ch6sc3.rpy:249
translate brazil ch6sc3_bcf378fd:

#   sj "Then it is decided."
    sj "Então está decidido."

# game/chapters/chapter6/ch6sc3.rpy:250
translate brazil ch6sc3_f2928bd7:

#   sj "Which means you and I will search for this temple."
    sj "Isso significa que você e eu iremos procurar por esse templo."

# game/chapters/chapter6/ch6sc3.rpy:252
translate brazil ch6sc3_a2ed5c08:

#   mc "Sounds good to me, just..."
    mc "Parece-me ótimo, só que..."

# game/chapters/chapter6/ch6sc3.rpy:253
translate brazil ch6sc3_c2d86d54:

#   mc "Try not to slow me down. *Chuckles*"
    mc "Tente não me atrasar. *Risos*"

# game/chapters/chapter6/ch6sc3.rpy:255
translate brazil ch6sc3_7d9544cb:

#   sj "*Scoffs lightly* He thinks he’s funny. After you, Outsider."
    sj "*Risos discretos* Ele acha que é engraçado. Depois de você, Forasteiro."

# game/chapters/chapter6/ch6sc3.rpy:256
translate brazil ch6sc3_c1073f04:

#   sj "I look forward to seeing you in action."
    sj "Aguardo ansiosamente para vê-lo em ação."

# game/chapters/chapter6/ch6sc3.rpy:258
translate brazil ch6sc3_e1001cd2:

#   mc "You’ll have to be observant, I’m quick."
    mc "Você terá que ser observador, eu sou rápido."

# game/chapters/chapter6/ch6sc3.rpy:259
translate brazil ch6sc3_1fc260ed:

#   sj "*Snickers* I’m sure you are, but I’ve got the vision of a hawk."
    sj "*Risos* Tenho certeza que sim, mas eu tenho a visão de um falcão."

# game/chapters/chapter6/ch6sc3.rpy:261
translate brazil ch6sc3_09f2de35:

#   mc "Is that so?"
    mc "É assim mesmo?"

# game/chapters/chapter6/ch6sc3.rpy:264
translate brazil ch6sc3_e53a1c7d:

#   mc "Maybe I’ll get to see you in action as well?"
    mc "Talvez eu também tenha a oportunidade de te ver em ação?"

# game/chapters/chapter6/ch6sc3.rpy:265
translate brazil ch6sc3_c77c10d7:

#   sj "Maybe you will..."
    sj "Talvez você..."

# game/chapters/chapter6/ch6sc3.rpy:270
translate brazil ch6sc3_95fe86cc:

#   "The two of you walk for roughly fifteen minutes."
    "Vocês dois caminham por aproximadamente quinze minutos."

# game/chapters/chapter6/ch6sc3.rpy:275
translate brazil ch6sc3_0ff821c6:

#   sj "Is this the same path you followed before?"
    sj "Este é o mesmo caminho que você seguiu antes?"

# game/chapters/chapter6/ch6sc3.rpy:277
translate brazil ch6sc3_94ab4dd5:

#   mc "No. Last time I followed the footsteps that led from the shrine."
    mc "Não. Da última vez, segui as pegadas que partiam do santuário."

# game/chapters/chapter6/ch6sc3.rpy:278
translate brazil ch6sc3_b75f19a0:

#   mc "This time I’m following -"
    mc "Desta vez estou seguindo -"

# game/chapters/chapter6/ch6sc3.rpy:280
translate brazil ch6sc3_28c16809:

#   sj "Your intuition?"
    sj "Sua intuição?"

# game/chapters/chapter6/ch6sc3.rpy:282
translate brazil ch6sc3_f5109dd1:

#   mc "Y-Yeah... how did you know?"
    mc "É... como você sabia?"

# game/chapters/chapter6/ch6sc3.rpy:284
translate brazil ch6sc3_de104dea:

#   sj "You’re not alone in having a gut feeling."
    sj "Você não está sozinho(a) em ter um pressentimento."

# game/chapters/chapter6/ch6sc3.rpy:286
translate brazil ch6sc3_74231c8e:

#   mc "Look, we’re approaching a clearing of sorts."
    mc "Olha, estamos nos aproximando de uma espécie de clareira."

# game/chapters/chapter6/ch6sc3.rpy:288
translate brazil ch6sc3_bce18733:

#   sj "Well done, Hero."
    sj "Muito bem, herói."

# game/chapters/chapter6/ch6sc3.rpy:289
translate brazil ch6sc3_85442b5a:

#   sj "Seems your intuition is... strong."
    sj "Parece que sua intuição é... forte."

# game/chapters/chapter6/ch6sc3.rpy:291
translate brazil ch6sc3_af698f75:

#   mc "Please..."
    mc "Por favor..."

# game/chapters/chapter6/ch6sc3.rpy:292
translate brazil ch6sc3_41b84c43:

#   mc "Just call me [mc]."
    mc "É só me ligar. [mc]."

# game/chapters/chapter6/ch6sc3.rpy:294
translate brazil ch6sc3_0ca0dd35:

#   sj "[mc]... well done, [mc]."
    sj "[mc]... bom trabalho, [mc]."

# game/chapters/chapter6/ch6sc3.rpy:296
translate brazil ch6sc3_e9acd5b4:

#   "Your intuition was correct, the setting sun is finally able to penetrate the thicket as the jungle thins out."
    "Sua intuição estava correta, o pôr do sol finalmente consegue penetrar a mata fechada à medida que a selva se torna mais rala."

# game/chapters/chapter6/ch6sc3.rpy:297
translate brazil ch6sc3_44024356:

#   mc "Suji, am I the only one seeing this? Is that a-"
    mc "Suji, sou só eu que estou vendo isso? É um-"

# game/chapters/chapter6/ch6sc3.rpy:298
translate brazil ch6sc3_df3ff1c9:

#   sj "A person."
    sj "Uma pessoa."

# game/chapters/chapter6/ch6sc3.rpy:300
translate brazil ch6sc3_7753c3ab:

#   sj "Even though we weren’t following the tracks this time, this must be the one who made them."
    sj "Embora não estivéssemos seguindo os rastros desta vez, deve ser este o responsável por eles."

# game/chapters/chapter6/ch6sc3.rpy:301
translate brazil ch6sc3_fd9f70d8:

#   sj "I think it’s a woman."
    sj "Acho que é uma mulher."

# game/chapters/chapter6/ch6sc3.rpy:303
translate brazil ch6sc3_bed956a3:

#   mc "Wait. Isn’t that...?"
    mc "Espere. Não é...?"

# game/chapters/chapter6/ch6sc3.rpy:304
translate brazil ch6sc3_df690279:

#   mc "Tazzy? From the royal banquet during Amelia's name day celebrations? What in the five hells is she doing here?"
    mc "Tazzy? Do banquete real durante as comemorações do aniversário da Amelia? Que diabos ela está fazendo aqui?"

# game/chapters/chapter6/ch6sc3.rpy:306
translate brazil ch6sc3_fe0829e3:

#   mc "Tazzy, is that you?"
    mc "Tazzy, é você?"

# game/chapters/chapter6/ch6sc3.rpy:307
translate brazil ch6sc3_22603541:

#   mc "Can you hear me?"
    mc "Você consegue me ouvir?"

# game/chapters/chapter6/ch6sc3.rpy:309
translate brazil ch6sc3_d22758b6:

#   tz "Hnngh... Wha...?"
    tz "Hnngh... O quê...?"

# game/chapters/chapter6/ch6sc3.rpy:310
translate brazil ch6sc3_16f10155:

#   tz "Who’s there... s-stay away!"
    tz "Quem está aí... f-fique longe!"

# game/chapters/chapter6/ch6sc3.rpy:311
translate brazil ch6sc3_14f34213:

#   mc "Taz, it’s me, [mc]."
    mc "Taz, sou eu. [mc]."

# game/chapters/chapter6/ch6sc3.rpy:313
translate brazil ch6sc3_27b906b1:

#   tz "[mc], is that really you?"
    tz "[mc] É você mesmo?"

# game/chapters/chapter6/ch6sc3.rpy:314
translate brazil ch6sc3_a4f9307b:

#   mc "Yeah, Taz... it’s me."
    mc "Sim, Taz... sou eu."

# game/chapters/chapter6/ch6sc3.rpy:316
translate brazil ch6sc3_0e7ec03f:

#   tz "No, no... it can’t be?"
    tz "Não, não... não pode ser?"

# game/chapters/chapter6/ch6sc3.rpy:317
translate brazil ch6sc3_1e6bb728:

#   tz "This is just my fever toying with my mind again..."
    tz "É só a febre pregando peças na minha cabeça de novo..."

# game/chapters/chapter6/ch6sc3.rpy:318
translate brazil ch6sc3_08084621:

#   tz "L-Leave me alone!"
    tz "Me deixe em paz!"

# game/chapters/chapter6/ch6sc3.rpy:320
translate brazil ch6sc3_eb0828c3:

#   mc "I’m not leaving you alone out here, and this isn’t your mind playing tricks on you."
    mc "Não vou te deixar sozinho aqui fora, e isso não é coisa da sua cabeça."

# game/chapters/chapter6/ch6sc3.rpy:321
translate brazil ch6sc3_ef42d5bd:

#   mc "Here. If your eyes won’t convince you, then feel my hand."
    mc "Aqui. Se seus olhos não o convencerem, então sinta minha mão."

# game/chapters/chapter6/ch6sc3.rpy:323
translate brazil ch6sc3_4e332b49:

#   tz "By the creator... it is you?"
    tz "Pelo criador... é você?"

# game/chapters/chapter6/ch6sc3.rpy:324
translate brazil ch6sc3_4d12fad7:

#   tz "[mc]? You’re not a mirage?"
    tz "[mc] Você não é uma miragem?"

# game/chapters/chapter6/ch6sc3.rpy:325
translate brazil ch6sc3_bae07610:

#   mc "*Chuckle* No, I’m not a mirage."
    mc "*Risos* Não, eu não sou uma miragem."

# game/chapters/chapter6/ch6sc3.rpy:327
translate brazil ch6sc3_485fd76b:

#   tz "Your hand... it’s so warm."
    tz "Sua mão... está tão quente."

# game/chapters/chapter6/ch6sc3.rpy:328
translate brazil ch6sc3_d0f478de:

#   tz "Thank you..."
    tz "Obrigado..."

# game/chapters/chapter6/ch6sc3.rpy:330
translate brazil ch6sc3_ccc941be:

#   mc "You’re welcome."
    mc "De nada."

# game/chapters/chapter6/ch6sc3.rpy:331
translate brazil ch6sc3_b4cb9b9b:

#   mc "Don’t worry, it’s going to be okay. You’re going to be okay."
    mc "Não se preocupe, tudo vai ficar bem. Você vai ficar bem."

# game/chapters/chapter6/ch6sc3.rpy:333
translate brazil ch6sc3_a0c04693:

#   tz "Huh, who’s this?"
    tz "Hum, quem é esse?"

# game/chapters/chapter6/ch6sc3.rpy:334
translate brazil ch6sc3_e7fe6ef8:

#   tz "There's an incredibly beautiful and almost naked woman behind you..."
    tz "Há uma mulher incrivelmente bela e quase nua atrás de você..."

# game/chapters/chapter6/ch6sc3.rpy:336
translate brazil ch6sc3_3ac159b2:

#   mc "Oh, that’s Suji. She’s one of the locals, a skilled Huntress and... a friend."
    mc "Ah, essa é a Suji. Ela é uma das moradoras locais, uma caçadora habilidosa e... uma amiga."

# game/chapters/chapter6/ch6sc3.rpy:337
translate brazil ch6sc3_cc67098c:

#   tz "Locals... friends... Hnngh..."
    tz "Moradores locais... amigos... Hnngh..."

# game/chapters/chapter6/ch6sc3.rpy:338
translate brazil ch6sc3_4fa4641f:

#   tz "I'm feeling... uhhgh-"
    tz "Estou me sentindo... uhhgh-"

# game/chapters/chapter6/ch6sc3.rpy:342
translate brazil ch6sc3_b3fadb62:

#   mc "Taz! Hey!"
    mc "Taz! Ei!"

# game/chapters/chapter6/ch6sc3.rpy:344
translate brazil ch6sc3_c2397d2a:

#   sj "She's exhausted. Being out here on her own has taken a toll on her."
    sj "Ela está exausta. Ficar sozinha aqui a debilitou muito."

# game/chapters/chapter6/ch6sc3.rpy:345
translate brazil ch6sc3_439371c6:

#   mc "Looks like she's out for a while... I’ll carry her then."
    mc "Parece que ela vai ficar fora por um tempo... Eu a carregarei então."

# game/chapters/chapter6/ch6sc3.rpy:347
translate brazil ch6sc3_29f42b51:

#   mc "*Quietly* C’mon, Taz. You’ll be fine."
    mc "*Em voz baixa* Vamos lá, Taz. Você vai ficar bem."

# game/chapters/chapter6/ch6sc3.rpy:348
translate brazil ch6sc3_32545916:

#   "You grab her gently and pull her up."
    "Você a segura delicadamente e a levanta."

# game/chapters/chapter6/ch6sc3.rpy:350
translate brazil ch6sc3_2d12e14d:

#   mc "*Quietly* I know you must be out here because of me... but why?"
    mc "*Em voz baixa* Eu sei que você deve estar aqui por minha causa... mas por quê?"

# game/chapters/chapter6/ch6sc3.rpy:351
translate brazil ch6sc3_dac2cd74:

#   mc "*Quietly* How did you even get here?"
    mc "*Em voz baixa* Como você chegou aqui?"

# game/chapters/chapter6/ch6sc3.rpy:353
translate brazil ch6sc3_c4d146e4:

#   sj "Careful. Isn’t she too heavy for you?"
    sj "Cuidado. Ela não é pesada demais para você?"

# game/chapters/chapter6/ch6sc3.rpy:355
translate brazil ch6sc3_be3c5dec:

#   mc "No, she weighs next to nothing."
    mc "Não, ela não pesa quase nada."

# game/chapters/chapter6/ch6sc3.rpy:356
translate brazil ch6sc3_e246ada3:

#   mc "Don’t worry, I’ve got her."
    mc "Não se preocupe, eu estou cuidando dela."

# game/chapters/chapter6/ch6sc3.rpy:358
translate brazil ch6sc3_7269ac72:

#   sj "Interesting... you picked her up without hesitation. And your muscles aren't even trembling from the effort."
    sj "Interessante... você a pegou no colo sem hesitar. E seus músculos nem tremem pelo esforço."

# game/chapters/chapter6/ch6sc3.rpy:360
translate brazil ch6sc3_0fda7c5d:

#   sj "Are all men... strong like you?"
    sj "Todos os homens são... fortes como você?"

# game/chapters/chapter6/ch6sc3.rpy:362
translate brazil ch6sc3_613d4502:

#   mc "*Chuckle* No, not all."
    mc "*Risos* Não, nem todos."

# game/chapters/chapter6/ch6sc3.rpy:364
translate brazil ch6sc3_a16c6f82:

#   sj "You’re a powerful man, then? Hmh."
    sj "Então você é um homem poderoso? Hum."

# game/chapters/chapter6/ch6sc3.rpy:365
translate brazil ch6sc3_c650d847:

#   sj "You have a warrior’s spirit within you, it is known. But... to see it with my own eyes... Hmh."
    sj "Você tem um espírito guerreiro dentro de si, isso é sabido. Mas... ver isso com meus próprios olhos... Hmh."

# game/chapters/chapter6/ch6sc3.rpy:367
translate brazil ch6sc3_950e09eb:

#   mc "Let’s take her back to the others at the shrine."
    mc "Vamos levá-la de volta para os outros no santuário."

# game/chapters/chapter6/ch6sc3.rpy:369
translate brazil ch6sc3_c0ccf57f:

#   sj "*Nods* She will be safe with them."
    sj "*Acena com a cabeça* Ela estará segura com eles."

# game/chapters/chapter6/ch6sc3.rpy:371
translate brazil ch6sc3_ef14a888:

#   sj "It's a good thing we managed to find her. Being alone out here... is not wise."
    sj "Ainda bem que conseguimos encontrá-la. Ficar sozinha aqui fora... não é uma boa ideia."

# game/chapters/chapter6/ch6sc3.rpy:372
translate brazil ch6sc3_ee7332b2:

#   mc "Yeah, we still need to find the temple and she’s completely lights-out."
    mc "Sim, ainda precisamos encontrar o templo e ela está completamente inconsciente."

# game/chapters/chapter6/ch6sc3.rpy:374
translate brazil ch6sc3_f44d0b1b:

#   mc "There’s no telling when she’ll wake up."
    mc "Não se sabe quando ela vai acordar."

# game/chapters/chapter6/ch6sc3.rpy:375
translate brazil ch6sc3_6167493a:

#   sj "If she wakes while we’re out searching for the temple..."
    sj "Se ela acordar enquanto estivermos procurando o templo..."

# game/chapters/chapter6/ch6sc3.rpy:377
translate brazil ch6sc3_179127c6:

#   sj "At least the others can take care of her."
    sj "Ao menos os outros podem cuidar dela."

# game/chapters/chapter6/ch6sc3.rpy:378
translate brazil ch6sc3_ca84788b:

#   sj "Maybe feed her some of the berries they're gathering. She’ll need to regain her strength."
    sj "Talvez dê a ela algumas das frutas que estão colhendo. Ela precisa recuperar as forças."

# game/chapters/chapter6/ch6sc3.rpy:380
translate brazil ch6sc3_8c14133b:

#   mc "I appreciate your willingness to help her."
    mc "Agradeço sua disposição em ajudá-la."

# game/chapters/chapter6/ch6sc3.rpy:381
translate brazil ch6sc3_013566da:

#   mc "You know, we make quite the team."
    mc "Sabe, nós formamos uma ótima equipe."

# game/chapters/chapter6/ch6sc3.rpy:383
translate brazil ch6sc3_253d02cc:

#   sj "*Scoffs lightly* Hmm."
    sj "*Risos discretos* Hum."

# game/chapters/chapter6/ch6sc3.rpy:385
translate brazil ch6sc3_8f401045:

#   sj "It is too early to know such a thing..."
    sj "É muito cedo para saber tal coisa..."

# game/chapters/chapter6/ch6sc3.rpy:386
translate brazil ch6sc3_70c3393b:

#   sj "But we shall see."
    sj "Mas veremos."

# game/chapters/chapter6/ch6sc3.rpy:388
translate brazil ch6sc3_81684bad:

#   mc "Keep straight ahead, that’s the path towards the others."
    mc "Siga em frente, esse é o caminho para os outros."

# game/chapters/chapter6/ch6sc3.rpy:389
translate brazil ch6sc3_e567fbc7:

#   mc "Unless the jungle or the mist decides to play tricks on us again."
    mc "A menos que a selva ou a neblina decidam nos pregar peças novamente."

# game/chapters/chapter6/ch6sc3.rpy:391
translate brazil ch6sc3_b37dd437:

#   sj "*Scoffs* Perhaps they are in cahoots and have teamed up to play mischievous tricks on us?"
    sj "*Risos* Talvez estejam em conluio e tenham se juntado para nos pregar peças?"

# game/chapters/chapter6/ch6sc3.rpy:393
translate brazil ch6sc3_43e1a8ac:

#   mc "*Chuckles* They must be. How else would they manage it?"
    mc "*Risos* Devem ser. Como mais eles conseguiriam?"

# game/chapters/chapter6/ch6sc3.rpy:394
translate brazil ch6sc3_4bb71bc1:

#   sj "Perhaps there’s an explanation for it, perhaps not... not all things can be easily figured out."
    sj "Talvez haja uma explicação para isso, talvez não... nem tudo é fácil de decifrar."

# game/chapters/chapter6/ch6sc3.rpy:396
translate brazil ch6sc3_faeb0443:

#   mc "Hmm, could be... but I have a feeling we’ll be able to figure it out, one way or another."
    mc "Hum, pode ser... mas tenho a sensação de que conseguiremos resolver isso, de um jeito ou de outro."

# game/chapters/chapter6/ch6sc3.rpy:397
translate brazil ch6sc3_fbc076b6:

#   sj "You are filled with confidence. I enjoy that."
    sj "Você está cheio de confiança. Eu gosto disso."

# game/chapters/chapter6/ch6sc3.rpy:399
translate brazil ch6sc3_dc15705f:

#   mc "*Chuckles* What? You enjoy my confidence, or teaming up with me?"
    mc "*Risos* O quê? Você gosta da minha confiança ou de trabalhar em equipe comigo?"

# game/chapters/chapter6/ch6sc3.rpy:400
translate brazil ch6sc3_4048310b:

#   sj "One does not exclude the other."
    sj "Uma coisa não exclui a outra."

# game/chapters/chapter6/ch6sc3.rpy:402
translate brazil ch6sc3_1fd40510:

#   mc "Hey, Suji?"
    mc "Ei, Suji?"

# game/chapters/chapter6/ch6sc3.rpy:404
translate brazil ch6sc3_d42e120a:

#   sj "Hmm? Something on your mind?"
    sj "Hum? Tem algo te incomodando?"

# game/chapters/chapter6/ch6sc3.rpy:406
translate brazil ch6sc3_5d7e8e5a:

#   mc "Yeah, I just wanted to thank you."
    mc "Sim, eu só queria agradecer."

# game/chapters/chapter6/ch6sc3.rpy:408
translate brazil ch6sc3_dfb3af96:

#   sj "Thank me? What for?"
    sj "Agradecer-me? Por quê?"

# game/chapters/chapter6/ch6sc3.rpy:410
translate brazil ch6sc3_de9a1c0d:

#   mc "For, you know... accepting me."
    mc "Porque, sabe... me aceitar."

# game/chapters/chapter6/ch6sc3.rpy:411
translate brazil ch6sc3_6dd826e6:

#   mc "Not killing me when you had me tranquilized."
    mc "Não me matar depois de me ter tranquilizado."

# game/chapters/chapter6/ch6sc3.rpy:413
translate brazil ch6sc3_76837d41:

#   sj "Did the A’nu not share our ways with you?"
    sj "Os A'nu não compartilharam nossos costumes com vocês?"

# game/chapters/chapter6/ch6sc3.rpy:415
translate brazil ch6sc3_067b1c0b:

#   mc "She has been very open about your ways."
    mc "Ela tem sido muito aberta sobre os seus métodos."

# game/chapters/chapter6/ch6sc3.rpy:417
translate brazil ch6sc3_1bb316d1:

#   sj "Then you need not thank me or wonder why we didn’t kill you."
    sj "Então você não precisa me agradecer nem se perguntar por que não te matamos."

# game/chapters/chapter6/ch6sc3.rpy:418
translate brazil ch6sc3_eed373a7:

#   sj "We aren’t like outsiders..."
    sj "Não somos como os forasteiros..."

# game/chapters/chapter6/ch6sc3.rpy:419
translate brazil ch6sc3_5d7ea7a2:

#   sj "We do not kill without mercy, or for sport. We know when we must strike, and when to stay our hands."
    sj "Não matamos sem piedade, nem por esporte. Sabemos quando devemos atacar e quando devemos nos conter."

# game/chapters/chapter6/ch6sc3.rpy:421
translate brazil ch6sc3_10a2dc1f:

#   sj "That said... you are welcome."
    sj "Dito isso... de nada."

# game/chapters/chapter6/ch6sc3.rpy:423
translate brazil ch6sc3_d5b4f7c3:

#   sj "I am pleased you did not attempt anything foolish when you awoke."
    sj "Fico feliz que você não tenha tentado nenhuma besteira ao acordar."

# game/chapters/chapter6/ch6sc3.rpy:425
translate brazil ch6sc3_45102108:

#   sj "We would have been forced to take your life to protect the tribe, and that..."
    sj "Teríamos sido forçados a tirar sua vida para proteger a tribo, e isso..."

# game/chapters/chapter6/ch6sc3.rpy:426
translate brazil ch6sc3_2e3eb1b2:

#   sj "That, would have been a shame."
    sj "Isso teria sido uma pena."

# game/chapters/chapter6/ch6sc3.rpy:428
translate brazil ch6sc3_81933558:

#   mc "Oh? You think so?"
    mc "Ah, é? Você acha mesmo?"

# game/chapters/chapter6/ch6sc3.rpy:432
translate brazil ch6sc3_e625e6cd:

#   sj "You are very unique. Much different compared to what we’ve been taught about outsiders."
    sj "Você é muito singular. Bem diferente daquilo que nos ensinaram sobre os que são de fora."

# game/chapters/chapter6/ch6sc3.rpy:433
translate brazil ch6sc3_81a33b43:

#   sj "I never thought I would get to meet an outsider, but I am pleased that you are the one I’ve met."
    sj "Nunca imaginei que um dia conheceria alguém de fora, mas fico feliz por ter conhecido você."

# game/chapters/chapter6/ch6sc3.rpy:435
translate brazil ch6sc3_7436eda3:

#   mc "Thank you, Suji."
    mc "Obrigada, Suji."

# game/chapters/chapter6/ch6sc3.rpy:436
translate brazil ch6sc3_b59379d6:

#   mc "I’m glad you feel that way. I’m glad to have met you as well."
    mc "Fico feliz que você se sinta assim. Também fico feliz por ter te conhecido."

# game/chapters/chapter6/ch6sc3.rpy:438
translate brazil ch6sc3_195a53b3:

#   sj "There is one other reason it would’ve been a shame not to give you a chance..."
    sj "Existe ainda outro motivo pelo qual teria sido uma pena não lhe dar uma oportunidade..."

# game/chapters/chapter6/ch6sc3.rpy:439
translate brazil ch6sc3_352ce6d7:

#   mc "Hmh? What would that be?"
    mc "Hum? O que seria isso?"

# game/chapters/chapter6/ch6sc3.rpy:441
translate brazil ch6sc3_41c7ddb8:

#   sj "You are handsome, very attractive."
    sj "Você é bonito, muito atraente."

# game/chapters/chapter6/ch6sc3.rpy:446
translate brazil ch6sc3_0e639168:

#   sj "Your physique is that of a great warrior."
    sj "Seu físico é o de um grande guerreiro."

# game/chapters/chapter6/ch6sc3.rpy:447
translate brazil ch6sc3_ae4871a0:

#   sj "It appeals to me."
    sj "Isso me agrada."

# game/chapters/chapter6/ch6sc3.rpy:449
translate brazil ch6sc3_33e3f127:

#   mc "Your physique isn’t to be scoffed at either, Suji."
    mc "Seu físico também não deve ser menosprezado, Suji."

# game/chapters/chapter6/ch6sc3.rpy:450
translate brazil ch6sc3_b0e96f9b:

#   mc "You’re in great shape, by the looks of it."
    mc "Pelo que parece, você está em ótima forma."

# game/chapters/chapter6/ch6sc3.rpy:452
translate brazil ch6sc3_6383f1f7:

#   sj "You... like my body too?"
    sj "Você... também gosta do meu corpo?"

# game/chapters/chapter6/ch6sc3.rpy:454
translate brazil ch6sc3_b2d65d7e:

#   mc "I do, you’re beautiful."
    mc "Sim, você é linda."

# game/chapters/chapter6/ch6sc3.rpy:456
translate brazil ch6sc3_842d9de6:

#   sj "T-Thank you."
    sj "O-Obrigado."

# game/chapters/chapter6/ch6sc3.rpy:457
translate brazil ch6sc3_5fe17b1a:

#   sj "It pleases me that you think so."
    sj "Fico feliz que você pense assim."

# game/chapters/chapter6/ch6sc3.rpy:459
translate brazil ch6sc3_7cc65c19:

#   sj "As a Huntress, I aim to remain in peak physical condition, to improve my strength and flexibility."
    sj "Como caçadora, meu objetivo é manter-me em excelente forma física, aprimorando minha força e flexibilidade."

# game/chapters/chapter6/ch6sc3.rpy:461
translate brazil ch6sc3_e5544801:

#   mc "I get it."
    mc "Entendo."

# game/chapters/chapter6/ch6sc3.rpy:462
translate brazil ch6sc3_cb62f9f8:

#   mc "In order to protect the tribe, you walk the warrior’s path."
    mc "Para proteger a tribo, você trilha o caminho do guerreiro."

# game/chapters/chapter6/ch6sc3.rpy:464
translate brazil ch6sc3_f75e0446:

#   sj "You... understand?"
    sj "Você... entende?"

# game/chapters/chapter6/ch6sc3.rpy:467
translate brazil ch6sc3_981a4f41:

#   sj "I’m glad ... come, we should get going."
    sj "Que bom... vamos, devemos ir."

# game/chapters/chapter6/ch6sc3.rpy:468
translate brazil ch6sc3_7001de80:

#   "Suji appreciates you noticing her body, Suji’s trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Suji aprecia que você tenha reparado no corpo dela, a confiança de Suji aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc3.rpy:472
translate brazil ch6sc3_1a9a287c:

#   mc "Thank you, I’m glad my looks helped me survive. *Chuckles*"
    mc "Obrigada, fico feliz que minha aparência tenha me ajudado a sobreviver. *Risos*"

# game/chapters/chapter6/ch6sc3.rpy:474
translate brazil ch6sc3_98852cfa:

#   sj "Lucky you. *Scoffs lightly* Come, we should get going."
    sj "Que sorte a sua. *Risos discretos* Vamos, precisamos ir."

# game/chapters/chapter6/ch6sc3.rpy:480
translate brazil ch6sc3_15a8da6e:

#   "The two of you continue down the path for a few minutes until you return to the shrine."
    "Vocês dois continuam pelo caminho por alguns minutos até retornarem ao santuário."

# game/chapters/chapter6/ch6sc3.rpy:483
translate brazil ch6sc3_53724836:

#   "When you reach your destination, you gently put Taz down, leaning her back against one of the pillars."
    "Ao chegar ao seu destino, você coloca Taz delicadamente no chão, encostando-a em um dos pilares."

# game/chapters/chapter6/ch6sc3.rpy:485
translate brazil ch6sc3_37ded7df:

#   pl "[mc]?"
    pl "[mc]?"

# game/chapters/chapter6/ch6sc3.rpy:486
translate brazil ch6sc3_c2758020:

#   pl "You're back! I was -"
    pl "Você voltou! Eu estava -"

# game/chapters/chapter6/ch6sc3.rpy:488
translate brazil ch6sc3_ec298605:

#   pl "By the seas!"
    pl "À beira-mar!"

# game/chapters/chapter6/ch6sc3.rpy:489
translate brazil ch6sc3_00f3e881:

#   pl "Is she okay?"
    pl "Ela está bem?"

# game/chapters/chapter6/ch6sc3.rpy:491
translate brazil ch6sc3_9447a99e:

#   pl "Who is she?"
    pl "Quem é ela?"

# game/chapters/chapter6/ch6sc3.rpy:492
translate brazil ch6sc3_7ea79938:

#   pl "Is she the one who left those tracks here?"
    pl "Foi ela quem deixou esses rastros aqui?"

# game/chapters/chapter6/ch6sc3.rpy:494
translate brazil ch6sc3_5088f41c:

#   mc "She’s okay, I think. She’s just exhausted from being out here on her own a while."
    mc "Acho que ela está bem. Ela só está exausta por ter ficado sozinha aqui por um tempo."

# game/chapters/chapter6/ch6sc3.rpy:495
translate brazil ch6sc3_70f8a9bc:

#   mc "As for who she is, she’s... an acquaintance of mine from back in Luxenford."
    mc "Quanto a quem ela é, ela é... uma conhecida minha dos tempos de Luxemburgo."

# game/chapters/chapter6/ch6sc3.rpy:497
translate brazil ch6sc3_3921a218:

#   sj "Luxenford? Is that the name of your tribe?"
    sj "Luxemburgo? Esse é o nome da sua tribo?"

# game/chapters/chapter6/ch6sc3.rpy:499
translate brazil ch6sc3_fc1eb443:

#   mc "*Chuckle* No. It’s the city I live in... just like you live in A’nai."
    mc "*Risos* Não. É a cidade onde eu moro... assim como você mora em A'nai."

# game/chapters/chapter6/ch6sc3.rpy:501
translate brazil ch6sc3_da1591f8:

#   sj "Ahh, I see."
    sj "Ah, entendi."

# game/chapters/chapter6/ch6sc3.rpy:502
translate brazil ch6sc3_be69f60e:

#   sj "So, then your tribe is this 'Adventurers Guild'?"
    sj "Então, sua tribo é essa tal de 'Guilda dos Aventureiros'?"

# game/chapters/chapter6/ch6sc3.rpy:504
translate brazil ch6sc3_b0498fa3:

#   mc "Yeah, I suppose that is akin to your tribe."
    mc "Sim, suponho que seja semelhante à sua tribo."

# game/chapters/chapter6/ch6sc3.rpy:506
translate brazil ch6sc3_6249cb58:

#   pl "What is an acquaintance of yours doing out here, though? Did she follow us?"
    pl "Mas o que uma conhecida sua está fazendo aqui? Será que ela nos seguiu?"

# game/chapters/chapter6/ch6sc3.rpy:508
translate brazil ch6sc3_692c57e5:

#   mc "No. At least, I doubt it..."
    mc "Não. Pelo menos, eu duvido..."

# game/chapters/chapter6/ch6sc3.rpy:509
translate brazil ch6sc3_58732b93:

#   mc "There’s no way she could’ve known I would be here."
    mc "Não havia a menor possibilidade de ela saber que eu estaria aqui."

# game/chapters/chapter6/ch6sc3.rpy:510
translate brazil ch6sc3_92cf1dac:

#   mc "I rushed straight to you and Kira when I got your message."
    mc "Assim que recebi sua mensagem, corri direto para você e para a Kira."

# game/chapters/chapter6/ch6sc3.rpy:511
translate brazil ch6sc3_bae34736:

#   mc "And from there, we sailed directly here. So, I have no idea how she wound up here."
    mc "E de lá, navegamos diretamente para cá. Então, não faço ideia de como ela veio parar aqui."

# game/chapters/chapter6/ch6sc3.rpy:513
translate brazil ch6sc3_d04c03f1:

#   pl "A mystery within the already mysterious jungle, hmh..."
    pl "Um mistério dentro da já misteriosa selva, hmh..."

# game/chapters/chapter6/ch6sc3.rpy:514
translate brazil ch6sc3_ead92758:

#   pl "This is so weird. But, if she’s a friend of yours, then we should look after her."
    pl "Isso é muito estranho. Mas, se ela é sua amiga, então devemos cuidar dela."

# game/chapters/chapter6/ch6sc3.rpy:516
translate brazil ch6sc3_6d0d9f7b:

#   sj "She requires rest... and plenty of it."
    sj "Ela precisa descansar... e muito."

# game/chapters/chapter6/ch6sc3.rpy:518
translate brazil ch6sc3_0225ec3b:

#   zy "She is in no condition to move."
    zy "Ela não tem condições de se mover."

# game/chapters/chapter6/ch6sc3.rpy:519
translate brazil ch6sc3_c093b059:

#   zy "And with the mist, we stand little chance of taking her safely back to A’nai."
    zy "E com a neblina, temos poucas chances de levá-la de volta em segurança para A'nai."

# game/chapters/chapter6/ch6sc3.rpy:520
translate brazil ch6sc3_2df18a37:

#   zy "But once the mist clears, we'll be able to take her back and our shamans can tend to her."
    zy "Mas assim que a neblina se dissipar, poderemos levá-la de volta e nossos xamãs poderão cuidar dela."

# game/chapters/chapter6/ch6sc3.rpy:522
translate brazil ch6sc3_d0eeb3cc:

#   sj "I agree. Attempting to move her around in the mist is too dangerous."
    sj "Concordo. Tentar movê-la na neblina é muito perigoso."

# game/chapters/chapter6/ch6sc3.rpy:523
translate brazil ch6sc3_01bfa6ca:

#   sj "She must rest."
    sj "Ela precisa descansar."

# game/chapters/chapter6/ch6sc3.rpy:525
translate brazil ch6sc3_c45d0006:

#   mc "Hmh."
    mc "Hum."

# game/chapters/chapter6/ch6sc3.rpy:526
translate brazil ch6sc3_96417a76:

#   mc "Then we’ll keep looking for that temple."
    mc "Então continuaremos procurando por esse templo."

# game/chapters/chapter6/ch6sc3.rpy:527
translate brazil ch6sc3_eab30279:

#   mc "Pearl, are you good to remain here still?"
    mc "Pearl, você ainda pode ficar aqui?"

# game/chapters/chapter6/ch6sc3.rpy:529
translate brazil ch6sc3_4d3e6568:

#   pl "I don’t mind."
    pl "Não me importo."

# game/chapters/chapter6/ch6sc3.rpy:530
translate brazil ch6sc3_28c9c567:

#   pl "Besides, if she wakes up, it might be good to have someone from our part of the world to explain things."
    pl "Além disso, se ela acordar, pode ser bom ter alguém da nossa região para explicar as coisas."

# game/chapters/chapter6/ch6sc3.rpy:531
translate brazil ch6sc3_d8a068ce:

#   pl "I’ll continue to help Miyo forage for food that we can bring back to A’nai."
    pl "Continuarei ajudando Miyo a procurar alimentos que possamos trazer de volta para A'nai."

# game/chapters/chapter6/ch6sc3.rpy:532
translate brazil ch6sc3_89573325:

#   pl "She's been showing me which berries are edible."
    pl "Ela tem me mostrado quais frutas silvestres são comestíveis."

# game/chapters/chapter6/ch6sc3.rpy:534
translate brazil ch6sc3_d5b8da3e:

#   mi "The jungle is bountiful, but we’ll have plenty of mouths to feed with so many new faces."
    mi "A selva é abundante, mas teremos muitas bocas para alimentar com tantas caras novas."

# game/chapters/chapter6/ch6sc3.rpy:535
translate brazil ch6sc3_f63fb285:

#   pl "We'd better get to it, then."
    pl "É melhor começarmos logo, então."

# game/chapters/chapter6/ch6sc3.rpy:536
translate brazil ch6sc3_71ee619f:

#   pl "I'm sure this lady will be famished when she awakes."
    pl "Tenho certeza de que essa senhora estará faminta quando acordar."

# game/chapters/chapter6/ch6sc3.rpy:538
translate brazil ch6sc3_dae0117b:

#   pl "Don’t be afraid to put us to work."
    pl "Não tenham medo de nos colocar para trabalhar."

# game/chapters/chapter6/ch6sc3.rpy:539
translate brazil ch6sc3_4a076415:

#   pl "We’re happy to earn our keep while we stay with you."
    pl "Estamos felizes em ganhar nosso sustento enquanto estivermos hospedados com vocês."

# game/chapters/chapter6/ch6sc3.rpy:541
translate brazil ch6sc3_1d573451:

#   mi "You already are."
    mi "Você já é."

# game/chapters/chapter6/ch6sc3.rpy:542
translate brazil ch6sc3_9a8df36c:

#   mi "Foraging is one of the most essential duties of the tribe."
    mi "A coleta de alimentos é uma das tarefas mais essenciais da tribo."

# game/chapters/chapter6/ch6sc3.rpy:544
translate brazil ch6sc3_31b4e31f:

#   pl "Then we'll forage as much as we're able to carry back with us."
    pl "Então, vamos coletar o máximo que conseguirmos carregar de volta conosco."

# game/chapters/chapter6/ch6sc3.rpy:546
translate brazil ch6sc3_cc810bd6:

#   mi "That we will, but remember to leave a few berries in each bush."
    mi "Faremos isso, mas lembre-se de deixar algumas frutinhas em cada arbusto."

# game/chapters/chapter6/ch6sc3.rpy:547
translate brazil ch6sc3_cfad9e1e:

#   mi "It will allow them to regrow easier for future harvests."
    mi "Isso permitirá que elas cresçam novamente mais facilmente para futuras colheitas."

# game/chapters/chapter6/ch6sc3.rpy:550
translate brazil ch6sc3_cf056541:

#   sj "[mc]."
    sj "[mc]."

# game/chapters/chapter6/ch6sc3.rpy:551
translate brazil ch6sc3_dfbdba08:

#   sj "Are you ready to head back out? We should get going if we hope to discover the temple."
    sj "Está pronto para voltarmos? Devemos ir se quisermos descobrir o templo."

# game/chapters/chapter6/ch6sc3.rpy:553
translate brazil ch6sc3_447e802e:

#   mc "You’re right, I’m itching to find the temple."
    mc "Você tem razão, estou louco para encontrar o templo."

# game/chapters/chapter6/ch6sc3.rpy:555
translate brazil ch6sc3_56d4d6bc:

#   sj "You’re itching?"
    sj "Você está com coceira?"

# game/chapters/chapter6/ch6sc3.rpy:557
translate brazil ch6sc3_e93ecab1:

#   mc "*Chuckles* Not literally, it’s an expression."
    mc "*Risos* Não literalmente, é uma expressão."

# game/chapters/chapter6/ch6sc3.rpy:558
translate brazil ch6sc3_f3dcc6d5:

#   mc "It means I’m excited."
    mc "Significa que estou animado(a)."

# game/chapters/chapter6/ch6sc3.rpy:560
translate brazil ch6sc3_f25501c5:

#   sj "Ahh... then, I’m itching too."
    sj "Ah... então, eu também estou com coceira."

# game/chapters/chapter6/ch6sc3.rpy:562
translate brazil ch6sc3_75694f54:

#   mc "*Chuckles* ..."
    mc "*Risos* ..."

# game/chapters/chapter6/ch6sc3.rpy:564
translate brazil ch6sc3_11802745:

#   sj "What? Did I say something funny?"
    sj "O quê? Eu disse alguma coisa engraçada?"

# game/chapters/chapter6/ch6sc3.rpy:566
translate brazil ch6sc3_d601a3c7:

#   mc "You're fine. I've just never heard someone say it back like that."
    mc "Você está bem. Eu só nunca ouvi ninguém responder isso dessa forma."

# game/chapters/chapter6/ch6sc3.rpy:568
translate brazil ch6sc3_368773c9:

#   sj "I'm glad I can amuse you."
    sj "Fico feliz em poder te divertir."

# game/chapters/chapter6/ch6sc3.rpy:570
translate brazil ch6sc3_de15a881:

#   sj "Is this your calling, then? Uncovering lost secrets and treasures?"
    sj "Então, essa é a sua vocação? Desvendar segredos e tesouros perdidos?"

# game/chapters/chapter6/ch6sc3.rpy:572
translate brazil ch6sc3_516eb32f:

#   mc "You could say that. At least, it’s a big part of being an adventurer."
    mc "Pode-se dizer isso. Pelo menos, é uma parte importante de ser um aventureiro."

# game/chapters/chapter6/ch6sc3.rpy:574
translate brazil ch6sc3_64b17efd:

#   sj "You must’ve seen a lot of wonderful things..."
    sj "Você deve ter visto muitas coisas maravilhosas..."

# game/chapters/chapter6/ch6sc3.rpy:579
translate brazil ch6sc3_0a4e4a69:

#   mc "I’m looking at one of them right now."
    mc "Estou olhando para um deles agora mesmo."

# game/chapters/chapter6/ch6sc3.rpy:581
translate brazil ch6sc3_78d69613:

#   sj "..."
    sj "..."

# game/chapters/chapter6/ch6sc3.rpy:582
translate brazil ch6sc3_6a2fb0a1:

#   "Suji's cheeks turn red as she realizes what you're saying."
    "As bochechas de Suji ficam vermelhas quando ela percebe o que você está dizendo."

# game/chapters/chapter6/ch6sc3.rpy:584
translate brazil ch6sc3_cd288bd6:

#   sj "Oh... I..."
    sj "Ah... eu..."

# game/chapters/chapter6/ch6sc3.rpy:585
translate brazil ch6sc3_8babfd2d:

#   sj "I..."
    sj "EU..."

# game/chapters/chapter6/ch6sc3.rpy:587
translate brazil ch6sc3_ab24610b:

#   "Suji likes your forwardness, Suji’s trust has increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Suji gosta da sua franqueza, a confiança de Suji aumentou. {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc3.rpy:591
translate brazil ch6sc3_b0808727:

#   mc "Yeah, I’ve seen quite a few things in my travels."
    mc "Sim, já vi muita coisa nas minhas viagens."

# game/chapters/chapter6/ch6sc3.rpy:595
translate brazil ch6sc3_947752dd:

#   zy "Go on, you two. I’ll watch over this woman while the others forage."
    zy "Vão em frente, vocês dois. Eu vou cuidar dessa mulher enquanto os outros procuram comida."

# game/chapters/chapter6/ch6sc3.rpy:596
translate brazil ch6sc3_3063bd6a:

#   mc "Thank you. I appreciate it, Zyra."
    mc "Obrigada. Agradeço muito, Zyra."

# game/chapters/chapter6/ch6sc3.rpy:597
translate brazil ch6sc3_8db0f3a8:

#   zy "Think nothing of it. She clearly needs care."
    zy "Não dê importância a isso. Ela claramente precisa de cuidados."

# game/chapters/chapter6/ch6sc3.rpy:599
translate brazil ch6sc3_8fc56f1c:

#   sj "I’m itching to see where your instincts will lead us to this time."
    sj "Estou ansiosa para ver aonde seus instintos nos levarão desta vez."

# game/chapters/chapter6/ch6sc3.rpy:601
translate brazil ch6sc3_b35cd6c7:

#   mc "C’mon then, let’s not dilly-dally any longer."
    mc "Vamos lá, não vamos mais enrolar."

# game/chapters/chapter6/ch6sc3.rpy:603
translate brazil ch6sc3_c3955809:

#   sj "Dilly-dally?"
    sj "Enrolar?"

# game/chapters/chapter6/ch6sc3.rpy:604
translate brazil ch6sc3_f83e2093:

#   mc "*Chuckles* Never mind."
    mc "*Risos* Deixa pra lá."

# game/chapters/chapter6/ch6sc3.rpy:611
translate brazil ch6sc3_ff66365d:

#   sj "It’s wondrous how your instincts work."
    sj "É incrível como nossos instintos funcionam."

# game/chapters/chapter6/ch6sc3.rpy:612
translate brazil ch6sc3_cc4b426d:

#   sj "Do you just feel something and follow it’s direction?"
    sj "Você simplesmente sente algo e segue a direção dessa sensação?"

# game/chapters/chapter6/ch6sc3.rpy:614
translate brazil ch6sc3_cf8a3e4c:

#   mc "Mmm. Pretty much."
    mc "Hum. Praticamente isso."

# game/chapters/chapter6/ch6sc3.rpy:616
translate brazil ch6sc3_e503a5bf:

#   sj "I’d love to do that. Could you teach me?"
    sj "Eu adoraria fazer isso. Você poderia me ensinar?"

# game/chapters/chapter6/ch6sc3.rpy:618
translate brazil ch6sc3_81a06d23:

#   mc "I’m afraid not."
    mc "Receio que não."

# game/chapters/chapter6/ch6sc3.rpy:620
translate brazil ch6sc3_f2c419de:

#   sj "You deem me unworthy?"
    sj "Você me considera indigno?"

# game/chapters/chapter6/ch6sc3.rpy:622
translate brazil ch6sc3_4fab7736:

#   mc "No, it’s not that."
    mc "Não, não é isso."

# game/chapters/chapter6/ch6sc3.rpy:623
translate brazil ch6sc3_1044266d:

#   mc "Following an instinct is not a skill that can be taught or trained. It’s just... there."
    mc "Seguir um instinto não é uma habilidade que possa ser ensinada ou treinada. Simplesmente... existe."

# game/chapters/chapter6/ch6sc3.rpy:624
translate brazil ch6sc3_4b3483b4:

#   mc "I can’t really explain it."
    mc "Não consigo explicar direito."

# game/chapters/chapter6/ch6sc3.rpy:626
translate brazil ch6sc3_639124f1:

#   sj "You are a mystery."
    sj "Você é um mistério."

# game/chapters/chapter6/ch6sc3.rpy:635
translate brazil ch6sc3_23a95cc8:

#   mc "The mist is lightening up again. Looks like we’ve made it to a new pathway."
    mc "A neblina está dissipando novamente. Parece que chegamos a um novo caminho."

# game/chapters/chapter6/ch6sc3.rpy:637
translate brazil ch6sc3_b0230aa1:

#   sj "It seems the instinct of a man is a curious thing."
    sj "Parece que o instinto humano é algo curioso."

# game/chapters/chapter6/ch6sc3.rpy:638
translate brazil ch6sc3_4a487a3d:

#   sj "You surprise me."
    sj "Você me surpreende."

# game/chapters/chapter6/ch6sc3.rpy:640
translate brazil ch6sc3_e0f7418e:

#   mc "*Chuckles* Thank you."
    mc "*Risos* Obrigada."

# game/chapters/chapter6/ch6sc3.rpy:641
translate brazil ch6sc3_93d6b78b:

#   mc "But, we’re not in the clear yet."
    mc "Mas ainda não estamos fora de perigo."

# game/chapters/chapter6/ch6sc3.rpy:642
translate brazil ch6sc3_fa162cc5:

#   mc "We don’t know if this is actually the path to the temple, or if it's leading us elsewhere."
    mc "Não sabemos se este é realmente o caminho para o templo, ou se está nos levando para outro lugar."

# game/chapters/chapter6/ch6sc3.rpy:644
translate brazil ch6sc3_bf7ad4b9:

#   sj "Then, let’s follow it and discover what lies ahead together."
    sj "Então, vamos acompanhar e descobrir juntos o que nos espera."

# game/chapters/chapter6/ch6sc3.rpy:646
translate brazil ch6sc3_0958dac5:

#   sj "We’ll conquer it as a team, just like before..."
    sj "Vamos superar isso em equipe, assim como antes..."

# game/chapters/chapter6/ch6sc3.rpy:647
translate brazil ch6sc3_4879d696:

#   mct "{i}*Chuckles* Seems she liked it when I said we make a great team.{/i}"
    mct "{i}*Risos* Parece que ela gostou quando eu disse que formamos uma ótima equipe.{/i}"

# game/chapters/chapter6/ch6sc3.rpy:649
translate brazil ch6sc3_aadfc157:

#   sj "Come, Hero."
    sj "Vamos, Herói."

# game/chapters/chapter6/ch6sc3.rpy:650
translate brazil ch6sc3_5a7bf443:

#   sj "The remaining daylight is waning and we have a temple to find."
    sj "A luz do dia está diminuindo e temos um templo para encontrar."

# game/chapters/chapter6/ch6sc3.rpy:651
translate brazil ch6sc3_34e93eb5:

#   "The two of you emerge into the clearing when Suji suddenly stops in her tracks."
    "Vocês dois chegam à clareira quando Suji para repentinamente."

# game/chapters/chapter6/ch6sc3.rpy:655
translate brazil ch6sc3_f85984b8:

#   mc "Why’d you stop?"
    mc "Por que você parou?"

# game/chapters/chapter6/ch6sc3.rpy:656
translate brazil ch6sc3_4457e599:

#   mc "Did you spot something?"
    mc "Você viu alguma coisa?"

# game/chapters/chapter6/ch6sc3.rpy:658
translate brazil ch6sc3_fbdfe6c2:

#   sj "Look. The ground..."
    sj "Olha. O chão..."

# game/chapters/chapter6/ch6sc3.rpy:660
translate brazil ch6sc3_c3629009:

#   mc "Huh... that looks familiar."
    mc "Hum... isso me parece familiar."

# game/chapters/chapter6/ch6sc3.rpy:661
translate brazil ch6sc3_f4b0729d:

#   sj "Familiar? You’ve been here before?"
    sj "Você se sente familiar? Já esteve aqui antes?"

# game/chapters/chapter6/ch6sc3.rpy:662
translate brazil ch6sc3_5a962a88:

#   mc "Not here, exactly."
    mc "Não exatamente aqui."

# game/chapters/chapter6/ch6sc3.rpy:663
translate brazil ch6sc3_9d015111:

#   mc "But those markings, the stone work... it looks like something I saw outside the other temple."
    mc "Mas essas marcas, o trabalho em pedra... parece algo que vi do lado de fora do outro templo."

# game/chapters/chapter6/ch6sc3.rpy:665
translate brazil ch6sc3_084bd636:

#   sj "I’ve been to the jungle countless times, yet... I’ve never seen such a place."
    sj "Já estive na selva inúmeras vezes, mas... nunca vi um lugar assim."

# game/chapters/chapter6/ch6sc3.rpy:666
translate brazil ch6sc3_02897d8f:

#   sj "Marvelous... do you think it was our ancestors who made this?"
    sj "Maravilhoso... você acha que foram nossos ancestrais que fizeram isso?"

# game/chapters/chapter6/ch6sc3.rpy:668
translate brazil ch6sc3_6874c292:

#   mc "I’m inclined to believe so. According to Echo, your ancestors were blessed by the divine, Malpheon."
    mc "Estou inclinado a acreditar que sim. Segundo Echo, seus ancestrais foram abençoados pelo divino Malpheon."

# game/chapters/chapter6/ch6sc3.rpy:669
translate brazil ch6sc3_d17657aa:

#   mc "He bestowed on them an amazing ability to construct and carve stone."
    mc "Ele lhes concedeu uma incrível habilidade para construir e esculpir em pedra."

# game/chapters/chapter6/ch6sc3.rpy:672
translate brazil ch6sc3_09e46b8f:

#   "You begin to feel warmth radiating from your necklace."
    "Você começa a sentir um calor emanando do seu colar."

# game/chapters/chapter6/ch6sc3.rpy:678
translate brazil ch6sc3_2d628f89:

#   sj "[mc]! *Gasps* Y-Your necklace!"
    sj "[mc] *Suspiros* S-Seu colar!"

# game/chapters/chapter6/ch6sc3.rpy:679
translate brazil ch6sc3_ea81cda6:

#   mc "Don’t worry, it’s not dangerous."
    mc "Não se preocupe, não é perigoso."

# game/chapters/chapter6/ch6sc3.rpy:681
translate brazil ch6sc3_0fe6d294:

#   mc "This confirms it... this place must be connected to the Temple of A’nai below your village."
    mc "Isso confirma... este lugar deve estar conectado ao Templo de A'nai, abaixo da sua vila."

# game/chapters/chapter6/ch6sc3.rpy:682
translate brazil ch6sc3_28d9b215:

#   sj "Woah... it’s so..."
    sj "Uau... é tão..."

# game/chapters/chapter6/ch6sc3.rpy:684
translate brazil ch6sc3_8719c25a:

#   sj "Beautiful."
    sj "Lindo."

# game/chapters/chapter6/ch6sc3.rpy:685
translate brazil ch6sc3_de2bb546:

#   sj "What... what are they?"
    sj "O quê... o que são eles?"

# game/chapters/chapter6/ch6sc3.rpy:687
translate brazil ch6sc3_cda72afa:

#   mc "They’re wisps."
    mc "São apenas fios soltos."

# game/chapters/chapter6/ch6sc3.rpy:688
translate brazil ch6sc3_b910f071:

#   mc "They helped guide me back to A’nai after I emerged from the last temple in the middle of the jungle."
    mc "Eles me ajudaram a voltar para A'nai depois que saí do último templo no meio da selva."

# game/chapters/chapter6/ch6sc3.rpy:689
translate brazil ch6sc3_85fd96e6:

#   mc "I don't know if guidance is their only purpose, but they’ve been very helpful so far."
    mc "Não sei se orientar é o único propósito deles, mas até agora têm sido muito úteis."

# game/chapters/chapter6/ch6sc3.rpy:690
translate brazil ch6sc3_292f977c:

#   mc "They led me and Pearl all the way back to A'nai."
    mc "Eles nos guiaram, a mim e a Pearl, de volta para A'nai."

# game/chapters/chapter6/ch6sc3.rpy:692
translate brazil ch6sc3_dce765d2:

#   sj "Fascinating."
    sj "Fascinante."

# game/chapters/chapter6/ch6sc3.rpy:693
translate brazil ch6sc3_6e0c17f1:

#   sj "You... you truly are the Champion who was promised."
    sj "Você... você é verdadeiramente o campeão que foi prometido."

# game/chapters/chapter6/ch6sc3.rpy:695
translate brazil ch6sc3_9f374ea1:

#   sj "Look! Something's happening. They’re... interacting with the carvings on the ground."
    sj "Olha! Algo está acontecendo. Eles estão... interagindo com as esculturas no chão."

# game/chapters/chapter6/ch6sc3.rpy:696
translate brazil ch6sc3_4e5d1952:

#   mc "Huh... you're right."
    mc "Hum... você tem razão."

# game/chapters/chapter6/ch6sc3.rpy:698
translate brazil ch6sc3_a1258209:

#   mc "Interesting. Maybe this is the key to finding the entrance?"
    mc "Interessante. Talvez esta seja a chave para encontrar a entrada?"

# game/chapters/chapter6/ch6sc3.rpy:699
translate brazil ch6sc3_cfa22d9c:

#   sj "They’re creating eyes..."
    sj "Eles estão criando olhos..."

# game/chapters/chapter6/ch6sc3.rpy:701
translate brazil ch6sc3_b3ab2e26:

#   sj "What are they telling us?"
    sj "O que eles estão nos dizendo?"

# game/chapters/chapter6/ch6sc3.rpy:702
translate brazil ch6sc3_4a56c3d6:

#   mc "Hmh... maybe, maybe they want us to see?"
    mc "Hum... talvez, talvez eles queiram que a gente veja?"

# game/chapters/chapter6/ch6sc3.rpy:703
translate brazil ch6sc3_c1e1da45:

#   "Suji quickly scans the area with her eyes."
    "Suji examina rapidamente a área com os olhos."

# game/chapters/chapter6/ch6sc3.rpy:705
translate brazil ch6sc3_410018b2:

#   sj "Look! Over there through the foliage, there’s a light."
    sj "Olha! Ali, por entre a folhagem, há uma luz."

# game/chapters/chapter6/ch6sc3.rpy:706
translate brazil ch6sc3_9c3e2dd6:

#   sj "Your wisps must've activated it!"
    sj "Devem ter sido seus espíritos que o ativaram!"

# game/chapters/chapter6/ch6sc3.rpy:708
translate brazil ch6sc3_eb967f54:

#   mc "I’ll be damned... We probably didn’t notice it earlier because it wasn’t lit up."
    mc "Puxa vida... Provavelmente não percebemos antes porque não estava aceso."

# game/chapters/chapter6/ch6sc3.rpy:709
translate brazil ch6sc3_0430450a:

#   mc "Good work, Suji. I guess you do have eyes like a hawk."
    mc "Bom trabalho, Suji. Acho que você realmente tem olhos de águia."

# game/chapters/chapter6/ch6sc3.rpy:710
translate brazil ch6sc3_ea925be0:

#   sj "Mhm, I told you so. From now on I’ll be known as Hawkeye."
    sj "É, eu te disse. De agora em diante, serei conhecido como Gavião Arqueiro."

# game/chapters/chapter6/ch6sc3.rpy:711
translate brazil ch6sc3_f322c97d:

#   mc "No. That’s... just, no."
    mc "Não. Isso é... simplesmente não."

# game/chapters/chapter6/ch6sc3.rpy:713
translate brazil ch6sc3_9874a173:

#   sj "I can’t believe we found it..."
    sj "Não acredito que encontramos..."

# game/chapters/chapter6/ch6sc3.rpy:714
translate brazil ch6sc3_d4556b9a:

#   sj "That has to be the entrance to one of our ancestor's temples, built in honor of our goddesses."
    sj "Essa deve ser a entrada de um dos templos de nossos ancestrais, construído em homenagem às nossas deusas."

# game/chapters/chapter6/ch6sc3.rpy:716
translate brazil ch6sc3_17884d3b:

#   sj "Come."
    sj "Vir."

# game/chapters/chapter6/ch6sc3.rpy:717
translate brazil ch6sc3_60b3e575:

#   sj "Let us examine it."
    sj "Vamos analisá-lo."

# game/chapters/chapter6/ch6sc3.rpy:724
translate brazil ch6sc3_ff3918ab:

#   sj "Hmm..."
    sj "Hum..."

# game/chapters/chapter6/ch6sc3.rpy:725
translate brazil ch6sc3_68d06110:

#   mc "Careful..."
    mc "Cuidadoso..."

# game/chapters/chapter6/ch6sc3.rpy:727
translate brazil ch6sc3_b0aabde3:

#   sj "No signs of traps. Still, we should remain alert."
    sj "Não há sinais de armadilhas. Mesmo assim, devemos permanecer alertas."

# game/chapters/chapter6/ch6sc3.rpy:728
translate brazil ch6sc3_e05a4e60:

#   sj "Come here, [mc]."
    sj "Venha aqui, [mc]."

# game/chapters/chapter6/ch6sc3.rpy:730
translate brazil ch6sc3_def0ad19:

#   mc "What is it?"
    mc "O que é?"

# game/chapters/chapter6/ch6sc3.rpy:731
translate brazil ch6sc3_069de476:

#   sj "You should see this... it’s just like-"
    sj "Você precisa ver isso... é exatamente como-"

# game/chapters/chapter6/ch6sc3.rpy:732
translate brazil ch6sc3_7970c9a2:

#   mc "Hey, wait up."
    mc "Ei, espere aí."

# game/chapters/chapter6/ch6sc3.rpy:734
translate brazil ch6sc3_602dbec1:

#   sj "Just like the flooring outside, but this is a wall."
    sj "Assim como o piso externo, só que desta vez é uma parede."

# game/chapters/chapter6/ch6sc3.rpy:735
translate brazil ch6sc3_dd531216:

#   sj "It must be connected in some way to the outside."
    sj "Deve estar conectado de alguma forma com o exterior."

# game/chapters/chapter6/ch6sc3.rpy:736
translate brazil ch6sc3_9f89abb9:

#   sj "It wasn’t lit up like this when we first got here."
    sj "Não estava tão iluminado assim quando chegamos aqui."

# game/chapters/chapter6/ch6sc3.rpy:738
translate brazil ch6sc3_2fd44cff:

#   sj "Do you think this is the entrance? I’ve never seen anything like it."
    sj "Você acha que esta é a entrada? Nunca vi nada parecido."

# game/chapters/chapter6/ch6sc3.rpy:739
translate brazil ch6sc3_c738e839:

#   mc "Hmm, it has to be an entrance... but I don’t see any passageways or doors, only this wall."
    mc "Hum, deve ser uma entrada... mas não vejo nenhuma passagem ou porta, apenas esta parede."

# game/chapters/chapter6/ch6sc3.rpy:741
translate brazil ch6sc3_b2def4d1:

#   sj "Perhaps it is not an entrance, but an exit? Something that can only be unlocked from the inside."
    sj "Talvez não seja uma entrada, mas uma saída? Algo que só pode ser destrancado por dentro."

# game/chapters/chapter6/ch6sc3.rpy:742
translate brazil ch6sc3_1bd14498:

#   mc "Maybe... but then why would the wisps activate it from outside?"
    mc "Talvez... mas então por que os espíritos da floresta o ativariam de fora?"

# game/chapters/chapter6/ch6sc3.rpy:744
translate brazil ch6sc3_3337cd13:

#   sj "I do not know."
    sj "Não sei."

# game/chapters/chapter6/ch6sc3.rpy:745
translate brazil ch6sc3_c5f39c46:

#   sj "But this place must be important."
    sj "Mas este lugar deve ser importante."

# game/chapters/chapter6/ch6sc3.rpy:747
translate brazil ch6sc3_ccd634cd:

#   mc "Hmm, this stone looks out of place."
    mc "Hum, essa pedra parece fora de lugar."

# game/chapters/chapter6/ch6sc3.rpy:748
translate brazil ch6sc3_4e0c38ab:

#   mc "Could it be an opening mechanism? Some kind of lever, maybe?"
    mc "Poderia ser um mecanismo de abertura? Algum tipo de alavanca, talvez?"

# game/chapters/chapter6/ch6sc3.rpy:754
translate brazil ch6sc3_e59c18fd:

#   "You push on the stone, it sinks into the wall, and the room begins to rumble."
    "Você empurra a pedra, ela afunda na parede e a sala começa a tremer."

# game/chapters/chapter6/ch6sc3.rpy:760
translate brazil ch6sc3_3868040b:

#   sj "[mc]! You’ve earned the wrath of the Goddesses! Uuuahh!"
    sj "[mc] Você atraiu a ira das Deusas! Uuuahh!"

# game/chapters/chapter6/ch6sc3.rpy:761
translate brazil ch6sc3_c1ddcef4:

#   mc "Stand your ground, Huntress, we don't know what to expect."
    mc "Mantenha-se firme, Caçadora, não sabemos o que esperar."

# game/chapters/chapter6/ch6sc3.rpy:763
translate brazil ch6sc3_0689a3dd:

#   sj "What do the goddesses mean by this?"
    sj "O que as deusas querem dizer com isso?"

# game/chapters/chapter6/ch6sc3.rpy:764
translate brazil ch6sc3_2ff7543c:

#   mc "I don’t think it’s their doing, look."
    mc "Não acho que seja culpa deles, veja bem."

# game/chapters/chapter6/ch6sc3.rpy:765
translate brazil ch6sc3_f2f0410b:

#   mc "The wall is moving."
    mc "A parede está se movendo."

# game/chapters/chapter6/ch6sc3.rpy:767
translate brazil ch6sc3_96d84b1a:

#   sj "By the Goddesses, you’re right! Have we found our way inside?"
    sj "Pelas deusas, você tem razão! Conseguimos entrar?"

# game/chapters/chapter6/ch6sc3.rpy:768
translate brazil ch6sc3_aac29032:

#   mc "Yeah, it appears so."
    mc "Sim, parece que sim."

# game/chapters/chapter6/ch6sc3.rpy:770
translate brazil ch6sc3_59c301a1:

#   mc "After the last temple, and now this, I think I’m starting to get an idea of how they work."
    mc "Depois do último templo, e agora este, acho que estou começando a ter uma ideia de como eles funcionam."

# game/chapters/chapter6/ch6sc3.rpy:771
translate brazil ch6sc3_067135b8:

#   mc "How your ancestors meant for them to be unlocked. And the puzzles they contain."
    mc "Como seus ancestrais queriam que fossem destrancados. E os enigmas que eles contêm."

# game/chapters/chapter6/ch6sc3.rpy:773
translate brazil ch6sc3_5d3c53cc:

#   sj "You share their instinct?"
    sj "Você compartilha desse instinto?"

# game/chapters/chapter6/ch6sc3.rpy:774
translate brazil ch6sc3_0c1798d2:

#   sj "Or maybe their puzzles are meant for {b}you{/b}. Maybe you’re the one intended to solve them?"
    sj "Ou talvez seus quebra-cabeças sejam destinados a {b} você{/b}Talvez você seja a pessoa destinada a resolvê-los?"

# game/chapters/chapter6/ch6sc3.rpy:776
translate brazil ch6sc3_1e252e9b:

#   mc "Perhaps... it's impossible to know."
    mc "Talvez... seja impossível saber."

# game/chapters/chapter6/ch6sc3.rpy:778
translate brazil ch6sc3_b4fbaadf:

#   sj "Hold up... I... I don't know if we should go any further."
    sj "Espere aí... Eu... Eu não sei se devemos prosseguir."

# game/chapters/chapter6/ch6sc3.rpy:783
translate brazil ch6sc3_ebe8ad9e:

#   mc "We've come this far, we even managed to find a way to open the temple."
    mc "Chegamos até aqui, conseguimos até encontrar uma maneira de abrir o templo."

# game/chapters/chapter6/ch6sc3.rpy:784
translate brazil ch6sc3_bd78cee7:

#   mc "It would be a waste not to explore it further, wouldn't it?"
    mc "Seria um desperdício não explorar isso mais a fundo, não é?"

# game/chapters/chapter6/ch6sc3.rpy:786
translate brazil ch6sc3_a43de59b:

#   sj "I-... I guess..."
    sj "Eu... eu acho..."

# game/chapters/chapter6/ch6sc3.rpy:787
translate brazil ch6sc3_a4fd42c0:

#   sj "But what if it angers the ancestors?"
    sj "Mas e se isso irritar os ancestrais?"

# game/chapters/chapter6/ch6sc3.rpy:789
translate brazil ch6sc3_18e1b9b5:

#   mc "If that were they case, your ancestors would've struck me down in Malpheon's temple."
    mc "Se assim fosse, seus ancestrais teriam me fulminado no templo de Malpheon."

# game/chapters/chapter6/ch6sc3.rpy:790
translate brazil ch6sc3_ffb99f73:

#   mc "Instead they rewarded me, I'll protect you, okay?"
    mc "Em vez disso, eles me recompensaram. Eu vou te proteger, ok?"

# game/chapters/chapter6/ch6sc3.rpy:792
translate brazil ch6sc3_97d8a214:

#   sj "O-Okay, yeah, you're right... I'll trust you."
    sj "Tá bem, sim, você tem razão... Vou confiar em você."

# game/chapters/chapter6/ch6sc3.rpy:794
translate brazil ch6sc3_dfbf95ca:

#   "You convinced Suji, your {b}{color=#2bff8b}Persuasion{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você convenceu Suji, sua {b}{color=#2bff8b}Persuasão{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc3.rpy:798
translate brazil ch6sc3_fe26b758:

#   mc "Your ancestors has led us to their temple, do you really wish to turn back?"
    mc "Seus ancestrais nos conduziram ao seu templo, você realmente deseja voltar atrás?"

# game/chapters/chapter6/ch6sc3.rpy:799
translate brazil ch6sc3_8242d99f:

#   mc "Aren't you curious what they have in store for us?"
    mc "Você não está curioso para saber o que eles têm reservado para nós?"

# game/chapters/chapter6/ch6sc3.rpy:802
translate brazil ch6sc3_58ebea66:

#   sj "I am curious, but also... a little afraid?"
    sj "Estou curioso, mas também... um pouco receoso?"

# game/chapters/chapter6/ch6sc3.rpy:804
translate brazil ch6sc3_409eed92:

#   mc "I'll be with you every step of the way, your ancestors have blessed me already."
    mc "Estarei com você a cada passo do caminho, seus ancestrais já me abençoaram."

# game/chapters/chapter6/ch6sc3.rpy:805
translate brazil ch6sc3_9ab9c0b3:

#   sj "Yeah, that's true... you're right, I'll be safe with you."
    sj "Sim, é verdade... você tem razão, estarei seguro com você."

# game/chapters/chapter6/ch6sc3.rpy:806
translate brazil ch6sc3_637650e2:

#   sj "Okay! Let's find out what this temple is all about!"
    sj "Muito bem! Vamos descobrir do que se trata este templo!"

# game/chapters/chapter6/ch6sc3.rpy:808
translate brazil ch6sc3_da5e8c74:

#   "You managed to inspire Suji, your {b}{color=#ffee54}Leadership{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Você conseguiu inspirar Suji, sua {b}{color=#ffee54}Liderança{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc3.rpy:810
translate brazil ch6sc3_2128eff1:

#   mc "I don’t imagine the place will be lit. Hold on, I’ll make us a torch."
    mc "Não imagino que o lugar estará iluminado. Espere um pouco, vou fazer uma tocha para nós."

# game/chapters/chapter6/ch6sc3.rpy:811
translate brazil ch6sc3_094b11a5:

#   "You begin to craft a torch out of nearby debris and dry materials."
    "Você começa a improvisar uma tocha com detritos e materiais secos que encontrar por perto."

# game/chapters/chapter6/ch6sc3.rpy:818
translate brazil ch6sc3_7a9bace5:

#   sj "Good thinking, Champion. I’ll await your command, then."
    sj "Boa ideia, Campeão. Aguardarei suas ordens, então."

# game/chapters/chapter6/ch6sc3.rpy:820
translate brazil ch6sc3_5a733477:

#   mc "*Chuckles* Any command?"
    mc "*Risos* Alguma ordem?"

# game/chapters/chapter6/ch6sc3.rpy:822
translate brazil ch6sc3_1144afdc:

#   sj "*Scoffs lightly* No, not any command."
    sj "*Risos discretos* Não, nenhuma ordem."

# game/chapters/chapter6/ch6sc3.rpy:824
translate brazil ch6sc3_12c34a0b:

#   sj "If you want me to obey your every command... you'll have to earn it."
    sj "Se você quer que eu obedeça a todas as suas ordens... terá que merecer."

# game/chapters/chapter6/ch6sc3.rpy:825
translate brazil ch6sc3_a7052e86:

#   sj "By becoming the A'khan, manage that and I'd... {size=-10}{b}obey your every word... Every. Word.{/b}{/size}"
    sj "Ao me tornar o A'khan, conseguir isso e eu... {size=-10}{b}Obedeça a cada palavra sua... Cada. Palavra.{/b}{/size}"

# game/chapters/chapter6/ch6sc3.rpy:827
translate brazil ch6sc3_88d3c563:

#   mc "My every word? Careful, huntress... you never know what I might command of you."
    mc "Cada palavra minha? Cuidado, caçadora... você nunca sabe o que eu posso lhe ordenar."

# game/chapters/chapter6/ch6sc3.rpy:828
translate brazil ch6sc3_b826e0d2:

#   mc "One moment you're fighting off my enemies, the next you're serving me wine, naked."
    mc "Num instante você está lutando contra meus inimigos, no outro está me servindo vinho, nua."

# game/chapters/chapter6/ch6sc3.rpy:830
translate brazil ch6sc3_9eb0e39c:

#   "Suji keeps her eyes locked with yours, clearly enjoying the idea, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Suji mantém os olhos fixos nos seus, claramente gostando da ideia; sua confiança aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc3.rpy:834
translate brazil ch6sc3_90a99713:

#   mc "Hmh, shame..."
    mc "Hum, que pena…"

# game/chapters/chapter6/ch6sc3.rpy:837
translate brazil ch6sc3_c69272e5:

#   sj "Your tongue is cheeky."
    sj "Você tem a língua afiada."

# game/chapters/chapter6/ch6sc3.rpy:839
translate brazil ch6sc3_6f32f5d0:

#   sj "Cheekier, than your wit is sharp."
    sj "Mais atrevido do que a sua sagacidade."

# game/chapters/chapter6/ch6sc3.rpy:840
translate brazil ch6sc3_3b1bcb96:

#   sj "If it was anyone else... my spear would’ve silenced you long ago."
    sj "Se fosse qualquer outra pessoa... minha lança já teria te silenciado há muito tempo."

# game/chapters/chapter6/ch6sc3.rpy:842
translate brazil ch6sc3_7185a56e:

#   mc "But not me?"
    mc "Mas eu não?"

# game/chapters/chapter6/ch6sc3.rpy:844
translate brazil ch6sc3_1ef32577:

#   sj "No, not you."
    sj "Não, você não."

# game/chapters/chapter6/ch6sc3.rpy:846
translate brazil ch6sc3_bc991378:

#   mc "I guess that makes me special."
    mc "Acho que isso me torna especial."

# game/chapters/chapter6/ch6sc3.rpy:848
translate brazil ch6sc3_5634905a:

#   sj "Mmm, you’ve yet to show me just how special..."
    sj "Hum, você ainda não me mostrou o quão especial você é..."

# game/chapters/chapter6/ch6sc3.rpy:850
translate brazil ch6sc3_6de44e42:

#   sj "Lead on, Champion."
    sj "Siga em frente, campeão."

# game/chapters/chapter6/ch6sc3.rpy:851
translate brazil ch6sc3_6b08c794:

#   sj "I look forward to seeing what else you're capable of."
    sj "Estou ansioso para ver do que mais você é capaz."

# game/chapters/chapter6/ch6sc3.rpy:853
translate brazil ch6sc3_9c2cc6c4:

#   sj "Think we’ll find more secret artifacts like the one you’re wearing?"
    sj "Acha que vamos encontrar mais artefatos secretos como esse que você está usando?"

# game/chapters/chapter6/ch6sc3.rpy:855
translate brazil ch6sc3_e8154e8c:

#   mc "It’s certainly possible, but I wouldn’t get my hopes up. Things like this talisman...?"
    mc "É certamente possível, mas eu não criaria muitas expectativas. Coisas como esse talismã...?"

# game/chapters/chapter6/ch6sc3.rpy:857
translate brazil ch6sc3_e4ebfd96:

#   mc "They’re incredibly rare. I’ve traveled a lot, as you know, and I’ve only encountered one other relic like this."
    mc "São incrivelmente raras. Como você sabe, já viajei muito e só encontrei uma outra relíquia como esta."

# game/chapters/chapter6/ch6sc3.rpy:859
translate brazil ch6sc3_35ef4d81:

#   mct "{i}Lucid’s {b}Chalice of Vitality{/b}.{/i}"
    mct "{i}Lucid's {b} Cálice da Vitalidade{/b}.{/i}"

# game/chapters/chapter6/ch6sc3.rpy:861
translate brazil ch6sc3_367833d3:

#   mc "But, it’s likely we’ll find items left behind by your ancestors, even if they aren't relics blessed by the gods."
    mc "Mas é provável que encontremos objetos deixados por seus ancestrais, mesmo que não sejam relíquias abençoadas pelos deuses."

# game/chapters/chapter6/ch6sc3.rpy:863
translate brazil ch6sc3_eda97686:

#   sj "I hope we do..."
    sj "Espero que sim..."

# game/chapters/chapter6/ch6sc3.rpy:865
translate brazil ch6sc3_88d5eb6d:

#   sj "To bring back lost relics of my people... A’nu would be pleased."
    sj "Trazer de volta as relíquias perdidas do meu povo... A'nu ficaria satisfeito."

# game/chapters/chapter6/ch6sc3.rpy:867
translate brazil ch6sc3_4f071922:

#   mc "I’m surprised how much everyone in your tribe seems to respect and value each other."
    mc "Fico surpreso com o quanto todos na sua tribo parecem se respeitar e se valorizar mutuamente."

# game/chapters/chapter6/ch6sc3.rpy:869
translate brazil ch6sc3_f1d3bdc3:

#   sj "It surprises you?"
    sj "Isso te surpreende?"

# game/chapters/chapter6/ch6sc3.rpy:870
translate brazil ch6sc3_02945433:

#   sj "We rely on each other for survival, we grew up together, we hunt together, play together, eat together..."
    sj "Dependemos uns dos outros para sobreviver, crescemos juntos, caçamos juntos, brincamos juntos, comemos juntos..."

# game/chapters/chapter6/ch6sc3.rpy:872
translate brazil ch6sc3_b6b72a91:

#   sj "Every member of the tribe has a role to fulfill, and is an integral part of our way of life."
    sj "Cada membro da tribo tem um papel a cumprir e é parte integrante do nosso modo de vida."

# game/chapters/chapter6/ch6sc3.rpy:873
translate brazil ch6sc3_605fa23c:

#   sj "Everyone earns their respect, and once they do, they rarely lose it."
    sj "Todos conquistam o respeito que lhes é devido e, uma vez conquistado, raramente o perdem."

# game/chapters/chapter6/ch6sc3.rpy:875
translate brazil ch6sc3_3b848f6c:

#   mc "Not everyone turns out as great as you?"
    mc "Nem todo mundo se torna tão incrível quanto você?"

# game/chapters/chapter6/ch6sc3.rpy:876
translate brazil ch6sc3_a379f87f:

#   sj "*Scoffs lightly* Thank you, but no... luckily it’s not often that there’s a bad seed."
    sj "*Risos discretos* Obrigada, mas não... felizmente não é comum haver uma maçã podre na cesta."

# game/chapters/chapter6/ch6sc3.rpy:878
translate brazil ch6sc3_22a48b78:

#   sj "But it does happen. Those ones usually seek out the Arugoh tribe, or are exiled into the jungle."
    sj "Mas acontece. Esses geralmente procuram a tribo Arugoh ou são exilados para a selva."

# game/chapters/chapter6/ch6sc3.rpy:880
translate brazil ch6sc3_9cf1b067:

#   sj "There is no place in A’nai for extremists or people filled with hatred."
    sj "Em A'nai, não há lugar para extremistas ou pessoas cheias de ódio."

# game/chapters/chapter6/ch6sc3.rpy:882
translate brazil ch6sc3_0701da32:

#   mc "I get it. Echo told me how both tribes used to be united until after the desecration of your village."
    mc "Entendi. Echo me contou como as duas tribos costumavam ser unidas até depois da profanação da sua aldeia."

# game/chapters/chapter6/ch6sc3.rpy:884
translate brazil ch6sc3_2927041c:

#   sj "*Nods* Mmm."
    sj "*Acena com a cabeça* Hum."

# game/chapters/chapter6/ch6sc3.rpy:889
translate brazil ch6sc3_26abd4fb:

#   "The two of you continue down the pathways until you come upon an opening into a small room."
    "Vocês dois continuam pelos caminhos até chegarem a uma entrada que dá para uma pequena sala."

# game/chapters/chapter6/ch6sc3.rpy:894
translate brazil ch6sc3_901bfb37:

#   sj "By the Goddesses..."
    sj "Pelas Deusas..."

# game/chapters/chapter6/ch6sc3.rpy:896
translate brazil ch6sc3_bfca32ae:

#   sj "Have you seen anything like this before?"
    sj "Você já viu algo parecido antes?"

# game/chapters/chapter6/ch6sc3.rpy:898
translate brazil ch6sc3_9bcc0356:

#   mc "No, not quite. Although..."
    mc "Não, não exatamente. Embora..."

# game/chapters/chapter6/ch6sc3.rpy:900
translate brazil ch6sc3_56ee5eab:

#   mc "This statue is familiar... it’s identical to the ones in the temple below A’nai."
    mc "Essa estátua me é familiar... é idêntica às que estão no templo abaixo de A'nai."

# game/chapters/chapter6/ch6sc3.rpy:901
translate brazil ch6sc3_760966ed:

#   mc "I wonder if-"
    mc "Será que...?"

# game/chapters/chapter6/ch6sc3.rpy:904
translate brazil ch6sc3_f9a279d4:

#   "As you take a step towards the statue, it lights up with a teal flame."
    "Ao dar um passo em direção à estátua, ela se ilumina com uma chama azul-esverdeada."

# game/chapters/chapter6/ch6sc3.rpy:907
translate brazil ch6sc3_7a08baf7:

#   sj "W-What?! Who did this! Come out, or face my spear!"
    sj "O quê?! Quem fez isso?! Apareça, ou enfrentará minha lança!"

# game/chapters/chapter6/ch6sc3.rpy:908
translate brazil ch6sc3_75c1d007:

#   mc "*Chuckles* Unless you’re planning on spearing the statue, you can lower your guard."
    mc "*Risos* A menos que você esteja planejando espetar a estátua com uma lança, pode baixar a guarda."

# game/chapters/chapter6/ch6sc3.rpy:910
translate brazil ch6sc3_8fea91d7:

#   mc "The statues in the other temple were enchanted by magic and also acted as a light source."
    mc "As estátuas do outro templo eram encantadas por magia e também funcionavam como fonte de luz."

# game/chapters/chapter6/ch6sc3.rpy:911
translate brazil ch6sc3_b546c7cf:

#   sj "Oh... it's just a light source?"
    sj "Ah... é só uma fonte de luz?"

# game/chapters/chapter6/ch6sc3.rpy:913
translate brazil ch6sc3_c6d48989:

#   sj "Do not tell Zyra about this."
    sj "Não conte isso para Zyra."

# game/chapters/chapter6/ch6sc3.rpy:914
translate brazil ch6sc3_5f73ecdf:

#   sj "Please..."
    sj "Por favor..."

# game/chapters/chapter6/ch6sc3.rpy:916
translate brazil ch6sc3_b2df7960:

#   mc "Let me guess: you’ll never hear the end of it if she finds out you were afraid of a statue?"
    mc "Deixe-me adivinhar: você nunca mais terá paz se ela descobrir que você tinha medo de uma estátua?"

# game/chapters/chapter6/ch6sc3.rpy:918
translate brazil ch6sc3_53f3872a:

#   sj "I wasn’t afraid! Huntresses fear nothing. I... I was on guard."
    sj "Eu não estava com medo! Caçadoras não temem nada. Eu... eu estava em guarda."

# game/chapters/chapter6/ch6sc3.rpy:919
translate brazil ch6sc3_3da7583c:

#   mc "Don’t worry, Suji. I won’t betray your trust."
    mc "Não se preocupe, Suji. Eu não vou trair a sua confiança."

# game/chapters/chapter6/ch6sc3.rpy:921
translate brazil ch6sc3_33cea6f8:

#   mc "Your secret is safe with me."
    mc "Seu segredo está a salvo comigo."

# game/chapters/chapter6/ch6sc3.rpy:923
translate brazil ch6sc3_f7b6ace4:

#   sj "Thank you... [mc]."
    sj "Obrigado... [mc]."

# game/chapters/chapter6/ch6sc3.rpy:925
translate brazil ch6sc3_f3dab4c6:

#   sj "It appears we have a decision to make."
    sj "Parece que temos uma decisão a tomar."

# game/chapters/chapter6/ch6sc3.rpy:926
translate brazil ch6sc3_a353507b:

#   sj "The ancestors have left us with a choice."
    sj "Os ancestrais nos deixaram uma escolha."

# game/chapters/chapter6/ch6sc3.rpy:928
translate brazil ch6sc3_b33a6868:

#   sj "Champion, what do you think? Does your instinct tell you anything?"
    sj "Campeão, o que você acha? Seu instinto lhe diz alguma coisa?"

# game/chapters/chapter6/ch6sc3.rpy:930
translate brazil ch6sc3_da9789bf:

#   mc "Hmm, my instinct isn’t telling me anything in particular."
    mc "Hum, meu instinto não me diz nada em particular."

# game/chapters/chapter6/ch6sc3.rpy:931
translate brazil ch6sc3_e6f30540:

#   mc "But if this temple is anything like the previous one..."
    mc "Mas se este templo for parecido com o anterior..."

# game/chapters/chapter6/ch6sc3.rpy:932
translate brazil ch6sc3_2866eb7f:

#   mc "We’ll need to remain alert and proceed with caution."
    mc "Precisaremos permanecer alertas e proceder com cautela."

# game/chapters/chapter6/ch6sc3.rpy:934
translate brazil ch6sc3_9917bb74:

#   sj "I agree, the unknown can be dangerous."
    sj "Concordo, o desconhecido pode ser perigoso."

# game/chapters/chapter6/ch6sc3.rpy:936
translate brazil ch6sc3_02b7c260:

#   sj "We must be cautious about our decisions going forward."
    sj "Devemos ser cautelosos com as decisões que tomaremos daqui para frente."

# game/chapters/chapter6/ch6sc3.rpy:938
translate brazil ch6sc3_80d16530:

#   mc "The entrances don’t appear to be giving us any clues. Hold on... let me try something."
    mc "As entradas não parecem estar nos dando nenhuma pista. Espere... deixe-me tentar algo."

# game/chapters/chapter6/ch6sc3.rpy:945
translate brazil ch6sc3_2feaca78:

#   sj "[mc], what are you...?"
    sj "[mc], o que você está...?"

# game/chapters/chapter6/ch6sc3.rpy:946
translate brazil ch6sc3_1f207291:

#   sj "Don't just go inside one!"
    sj "Não entre simplesmente em um deles!"

# game/chapters/chapter6/ch6sc3.rpy:948
translate brazil ch6sc3_bb205247:

#   mc "I won't..."
    mc "Eu não vou..."

# game/chapters/chapter6/ch6sc3.rpy:949
translate brazil ch6sc3_5ddcf4b6:

#   mc "I'm able to see in the dark."
    mc "Consigo enxergar no escuro."

# game/chapters/chapter6/ch6sc3.rpy:950
translate brazil ch6sc3_1fa98126:

#   sj "You're able to what? H-How?"
    sj "Você consegue fazer o quê? C-Como?"

# game/chapters/chapter6/ch6sc3.rpy:952
translate brazil ch6sc3_f5fd30e5:

#   mc "It’s a long story. I'll share it with you some other time."
    mc "É uma longa história. Contarei a vocês em outra ocasião."

# game/chapters/chapter6/ch6sc3.rpy:953
translate brazil ch6sc3_924ebeb9:

#   "As you stare down the pitch black corridor, you focus intensely and the darkness begins to brighten."
    "Enquanto você encara o corredor completamente escuro, concentra-se intensamente e a escuridão começa a clarear."

# game/chapters/chapter6/ch6sc3.rpy:956
translate brazil ch6sc3_97319e79:

#   mc "It looks like an ordinary corridor with another of these statues at the far end."
    mc "Parece um corredor comum com outra dessas estátuas no fundo."

# game/chapters/chapter6/ch6sc3.rpy:957
translate brazil ch6sc3_5b68ccca:

#   sj "Incredible! You can really see the end of the passageway?"
    sj "Incrível! Dá mesmo para ver o fim da passagem?"

# game/chapters/chapter6/ch6sc3.rpy:959
translate brazil ch6sc3_ddd15752:

#   mc "Mhm. I should check the other one as well."
    mc "Hum. Devo verificar o outro também."

# game/chapters/chapter6/ch6sc3.rpy:960
translate brazil ch6sc3_b591e8e7:

#   mc "See if there's any clues or differences between them."
    mc "Veja se há alguma pista ou diferença entre eles."

# game/chapters/chapter6/ch6sc3.rpy:962
translate brazil ch6sc3_d1268688:

#   sj "Goddess ... you could actually see something down there? It’s pitch-black ..."
    sj "Deusa... você conseguiu ver alguma coisa lá embaixo? Está completamente escuro..."

# game/chapters/chapter6/ch6sc3.rpy:963
translate brazil ch6sc3_168723c0:

#   mc "Mmm. Clear as day. Although, no colors."
    mc "Hum. Claro como água. Embora, sem cores."

# game/chapters/chapter6/ch6sc3.rpy:964
translate brazil ch6sc3_aa6fc28b:

#   sj "Amazing ..."
    sj "Incrível ..."

# game/chapters/chapter6/ch6sc3.rpy:966
translate brazil ch6sc3_85cfcb18:

#   mc "Hmh ... it’s ... identical?"
    mc "Hum... é... idêntico?"

# game/chapters/chapter6/ch6sc3.rpy:967
translate brazil ch6sc3_5fd0125a:

#   mc "Same bland corridor with a statue at the end ... no obvious sign of any turns or doors."
    mc "O mesmo corredor sem graça com uma estátua no final... nenhum sinal óbvio de curvas ou portas."

# game/chapters/chapter6/ch6sc3.rpy:968
translate brazil ch6sc3_0f3799fd:

#   sj "This statue only lit up once we got close to it, maybe we need to get closer?"
    sj "Essa estátua só se iluminou quando chegamos perto dela, talvez precisemos chegar mais perto?"

# game/chapters/chapter6/ch6sc3.rpy:970
translate brazil ch6sc3_d9456444:

#   mc "Yeah, I’m thinking the same."
    mc "Sim, eu também estou pensando a mesma coisa."

# game/chapters/chapter6/ch6sc3.rpy:971
translate brazil ch6sc3_1c0ac2c3:

#   mc "They must be proximity based."
    mc "Devem ser baseados na proximidade."

# game/chapters/chapter6/ch6sc3.rpy:973
translate brazil ch6sc3_297104db:

#   sj "I think we should choose the left one. I noticed something while you were examining it."
    sj "Acho que devemos escolher a da esquerda. Notei algo enquanto você a examinava."

# game/chapters/chapter6/ch6sc3.rpy:974
translate brazil ch6sc3_849020ac:

#   mc "Oh? Do tell."
    mc "Ah, é? Conte-me mais."

# game/chapters/chapter6/ch6sc3.rpy:976
translate brazil ch6sc3_46753aab:

#   sj "Look, a sigil of spears."
    sj "Olha, um sigilo de lanças."

# game/chapters/chapter6/ch6sc3.rpy:978
translate brazil ch6sc3_bd8f51ed:

#   sj "Spears are one of our greatest tools. They're used in both hunting and combat."
    sj "As lanças são uma das nossas melhores ferramentas. Elas são usadas tanto na caça quanto no combate."

# game/chapters/chapter6/ch6sc3.rpy:979
translate brazil ch6sc3_24faf0a4:

#   sj "To our people, they are a symbol of survival."
    sj "Para o nosso povo, eles são um símbolo de sobrevivência."

# game/chapters/chapter6/ch6sc3.rpy:981
translate brazil ch6sc3_e6a6a01a:

#   sj "It has to mean something that they have marked this one."
    sj "O fato de terem marcado esta deve significar alguma coisa."

# game/chapters/chapter6/ch6sc3.rpy:982
translate brazil ch6sc3_3ad8956a:

#   mc "I see ... maybe it's a sign from your ancestors that only your people would understand which path to take?"
    mc "Entendo... talvez seja um sinal dos seus ancestrais de que só o seu povo saberia qual caminho seguir?"

# game/chapters/chapter6/ch6sc3.rpy:984
translate brazil ch6sc3_95bafc92:

#   sj "I believe so. The other pathway doesn’t appear to have a sigil."
    sj "Acredito que sim. O outro caminho não parece ter um sigilo."

# game/chapters/chapter6/ch6sc3.rpy:985
translate brazil ch6sc3_080a8ef1:

#   mc "Let’s check out the one with the sigil, then."
    mc "Vamos dar uma olhada naquele que tem o sigilo, então."

# game/chapters/chapter6/ch6sc3.rpy:987
translate brazil ch6sc3_c28486a9:

#   "The two of you head to the entrance of the hallway, carefully steeping inside."
    "Vocês dois se dirigem à entrada do corredor, entrando com cuidado."

# game/chapters/chapter6/ch6sc3.rpy:988
translate brazil ch6sc3_e5765518:

#   mc "Let's see what this temple is all about."
    mc "Vamos ver do que se trata este templo."

# game/chapters/chapter6/ch6sc3.rpy:990
translate brazil ch6sc3_b06b496a:

#   sj "Careful, just because we haven’t spotted anything, doesn't mean it’s safe."
    sj "Cuidado, só porque não detectamos nada, não significa que seja seguro."

# game/chapters/chapter6/ch6sc3.rpy:991
translate brazil ch6sc3_af3bae26:

#   sj "Getting comfortable too soon could lead to an untimely demise."
    sj "Acomodar-se cedo demais pode levar a uma morte prematura."

# game/chapters/chapter6/ch6sc3.rpy:993
translate brazil ch6sc3_96f19b22:

#   mc "Don’t worry, it’s not my first time in one of these temples, remember?"
    mc "Não se preocupe, não é a minha primeira vez em um desses templos, lembra?"

# game/chapters/chapter6/ch6sc3.rpy:994
translate brazil ch6sc3_34c0f4bc:

#   "As you finish your sentence, a rumbling clicking sound echoes throughout the passageway."
    "Ao terminar a frase, um som estrondoso de estalos ecoa pelo corredor."

# game/chapters/chapter6/ch6sc3.rpy:997
translate brazil ch6sc3_8a21b938:

#   "Suji throws herself at you, holding you back from stepping further as the ground rumbles in front of you."
    "Suji se atira sobre você, impedindo-o de dar mais um passo enquanto o chão treme à sua frente."

# game/chapters/chapter6/ch6sc3.rpy:998
translate brazil ch6sc3_f83e06fa:

#   sj "[mc]!! Watch out!"
    sj "[mc]!! Atenção!"

# game/chapters/chapter6/ch6sc3.rpy:1001
translate brazil ch6sc3_8a7ea034:

#   sj "That was close ... one step further and we'd been skewered ..."
    sj "Essa foi por pouco... mais um passo e teríamos sido espetados..."

# game/chapters/chapter6/ch6sc3.rpy:1002
translate brazil ch6sc3_89d78f12:

#   sj "We agreed to be cautious, and then you nearly get yourself impaled!"
    sj "Combinamos de ser cautelosos, e aí você quase se empala!"

# game/chapters/chapter6/ch6sc3.rpy:1003
translate brazil ch6sc3_3e45a6ec:

#   mc "I didn’t see any pressure plates or tripwires ... how did the trap activate?"
    mc "Não vi nenhuma placa de pressão ou fio de disparo... como a armadilha foi ativada?"

# game/chapters/chapter6/ch6sc3.rpy:1005
translate brazil ch6sc3_7a3e9450:

#   sj "Look! The statue ... it lit up, but not with the teal hue like the other one."
    sj "Olha! A estátua... ela acendeu, mas não com aquele tom azul-esverdeado como a outra."

# game/chapters/chapter6/ch6sc3.rpy:1007
translate brazil ch6sc3_e819bffe:

#   mc "Huh ... a proximity based, enchanted trap? Your ancestors were way ahead of their time."
    mc "Hum... uma armadilha encantada baseada na proximidade? Seus ancestrais estavam muito à frente de seu tempo."

# game/chapters/chapter6/ch6sc3.rpy:1009
translate brazil ch6sc3_cbcafdae:

#   mc "Suji, thank you."
    mc "Suji, obrigada."

# game/chapters/chapter6/ch6sc3.rpy:1010
translate brazil ch6sc3_272d2c65:

#   mc "You could’ve easily been impaled trying to stop me."
    mc "Você poderia facilmente ter sido empalado tentando me impedir."

# game/chapters/chapter6/ch6sc3.rpy:1012
translate brazil ch6sc3_ab68e904:

#   sj "Your thanks are not needed. It is my duty to guard you."
    sj "Seus agradecimentos não são necessários. É meu dever protegê-lo(a)."

# game/chapters/chapter6/ch6sc3.rpy:1013
translate brazil ch6sc3_8844b872:

#   sj "Not only did the A’nu ask this of us, but ..."
    sj "Os A'nu não apenas nos pediram isso, mas..."

# game/chapters/chapter6/ch6sc3.rpy:1015
translate brazil ch6sc3_d5edb72a:

#   sj "We’re a team, right?"
    sj "Somos uma equipe, certo?"

# game/chapters/chapter6/ch6sc3.rpy:1017
translate brazil ch6sc3_d0afa58a:

#   mc "Yes, we are."
    mc "Sim, somos."

# game/chapters/chapter6/ch6sc3.rpy:1019
translate brazil ch6sc3_9752ec94:

#   sj "Would you not risk your life to guard me? As I have done for you?"
    sj "Você não arriscaria sua vida para me proteger? Assim como eu fiz por você?"

# game/chapters/chapter6/ch6sc3.rpy:1021
translate brazil ch6sc3_b1769911:

#   mc "I would."
    mc "Eu poderia."

# game/chapters/chapter6/ch6sc3.rpy:1023
translate brazil ch6sc3_d3bf9008:

#   mc "No harm will come to you while you’re with me."
    mc "Nenhum mal lhe acontecerá enquanto estiver comigo."

# game/chapters/chapter6/ch6sc3.rpy:1025
translate brazil ch6sc3_e0f231a1:

#   sj "I ... I believe you."
    sj "Eu... eu acredito em você."

# game/chapters/chapter6/ch6sc3.rpy:1027
translate brazil ch6sc3_310d64c4:

#   sj "We'd better try the other passage, before we accidentally get impaled in here."
    sj "É melhor tentarmos a outra passagem, antes que acabemos empalados aqui sem querer."

# game/chapters/chapter6/ch6sc3.rpy:1030
translate brazil ch6sc3_49fab0eb:

#   sj "Right? We should go and check it out?"
    sj "Certo? Deveríamos ir lá conferir?"

# game/chapters/chapter6/ch6sc3.rpy:1032
translate brazil ch6sc3_f95561c1:

#   mc "Yeah ... let’s check it out."
    mc "Sim... vamos dar uma olhada."

# game/chapters/chapter6/ch6sc3.rpy:1033
translate brazil ch6sc3_9da44dba:

#   "And so the two of you venture into the other hallway, this time treading even more cautiously."
    "E assim vocês dois se aventuram pelo outro corredor, desta vez caminhando com ainda mais cautela."

# game/chapters/chapter6/ch6sc3.rpy:1035
translate brazil ch6sc3_4f6fbe4f:

#   sj "It looks clear ..."
    sj "Parece claro..."

# game/chapters/chapter6/ch6sc3.rpy:1036
translate brazil ch6sc3_d5383d12:

#   sj "Do try not to activate any more traps. *Scoffs lightly*"
    sj "Por favor, não ative mais nenhuma armadilha. *Risos discretos*"

# game/chapters/chapter6/ch6sc3.rpy:1038
translate brazil ch6sc3_01df73ee:

#   mc "*Chuckles* ... this hall is remarkably dull compared to the other one."
    mc "*Risos* ... este salão é notavelmente sem graça em comparação com o outro."

# game/chapters/chapter6/ch6sc3.rpy:1040
translate brazil ch6sc3_be8328a7:

#   sj "I agree ... far less 'itching'."
    sj "Concordo... bem menos \"coceira\"."

# game/chapters/chapter6/ch6sc3.rpy:1041
translate brazil ch6sc3_efa97cc3:

#   mc "*Chuckles* Exciting you mean?"
    mc "*Risos* Emocionante, você quer dizer?"

# game/chapters/chapter6/ch6sc3.rpy:1042
translate brazil ch6sc3_f855cf04:

#   sj "Your way of speaking is confusing, yes... I meant exciting."
    sj "Seu jeito de falar é confuso, sim... Eu quis dizer empolgante."

# game/chapters/chapter6/ch6sc3.rpy:1043
translate brazil ch6sc3_8e61e145:

#   sj "I see nothing out of the ordinary."
    sj "Não vejo nada de anormal."

# game/chapters/chapter6/ch6sc3.rpy:1045
translate brazil ch6sc3_6e485c02:

#   sj "Have you ... taken many women exploring other ancient temples?"
    sj "Você já levou muitas mulheres para explorar outros templos antigos?"

# game/chapters/chapter6/ch6sc3.rpy:1046
translate brazil ch6sc3_d66dbc12:

#   mc "*Chuckles* No, I can’t say that I have ..."
    mc "*Risos* Não, não posso dizer que tenho..."

# game/chapters/chapter6/ch6sc3.rpy:1047
translate brazil ch6sc3_bfd4de77:

#   mc "You’re my first."
    mc "Você é a minha primeira."

# game/chapters/chapter6/ch6sc3.rpy:1049
translate brazil ch6sc3_69d64027:

#   sj "I ... am your first?"
    sj "Eu... sou o seu primeiro?"

# game/chapters/chapter6/ch6sc3.rpy:1050
translate brazil ch6sc3_a6429dc7:

#   sj "This ... pleases me to know."
    sj "Fico feliz em saber disso."

# game/chapters/chapter6/ch6sc3.rpy:1052
translate brazil ch6sc3_ddbf91ed:

#   mc "I’m your first as well, I take it?"
    mc "Eu também sou o seu primeiro, certo?"

# game/chapters/chapter6/ch6sc3.rpy:1053
translate brazil ch6sc3_c6fed436:

#   sj "Mhm, you are."
    sj "Sim, você é."

# game/chapters/chapter6/ch6sc3.rpy:1054
translate brazil ch6sc3_86178502:

#   sj "This is my first time in any temple besides the one in A’nai, and that one is only accessible above ground level."
    sj "Esta é a primeira vez que visito um templo além do de A'nai, e este só é acessível acima do nível do solo."

# game/chapters/chapter6/ch6sc3.rpy:1056
translate brazil ch6sc3_ad7f832d:

#   sj "Unless ..."
    sj "A menos que ..."

# game/chapters/chapter6/ch6sc3.rpy:1057
translate brazil ch6sc3_31a3d418:

#   mc "Unless you take a tumble down a near bottomless shaft, like yours truly?"
    mc "A menos que você caia num poço quase sem fundo, como eu?"

# game/chapters/chapter6/ch6sc3.rpy:1059
translate brazil ch6sc3_32d6f2b8:

#   sj "*Snickers* I wasn’t going to put it like that ... but, yes."
    sj "*Risos* Eu não ia dizer isso dessa forma... mas, sim."

# game/chapters/chapter6/ch6sc3.rpy:1060
translate brazil ch6sc3_1618ee0d:

#   sj "That is what I was thinking."
    sj "Era exatamente isso que eu estava pensando."

# game/chapters/chapter6/ch6sc3.rpy:1062
translate brazil ch6sc3_3134a6d0:

#   sj "Look! The statue."
    sj "Olha! A estátua."

# game/chapters/chapter6/ch6sc3.rpy:1063
translate brazil ch6sc3_1c4896a2:

#   mc "Looks like we’re in the clear. It has the same teal flame as the one outside."
    mc "Parece que está tudo bem. Tem a mesma chama azul-esverdeada que a de fora."

# game/chapters/chapter6/ch6sc3.rpy:1065
translate brazil ch6sc3_0a1574f2:

#   sj "I’m not seeing any doors."
    sj "Não estou vendo nenhuma porta."

# game/chapters/chapter6/ch6sc3.rpy:1066
translate brazil ch6sc3_050c9e6f:

#   sj "What are we ...?"
    sj "O que somos nós...?"

# game/chapters/chapter6/ch6sc3.rpy:1070
translate brazil ch6sc3_3167f729:

#   sj "{b}Wuaah!{/b}"
    sj "{b}Uau!{/b}"

# game/chapters/chapter6/ch6sc3.rpy:1071
translate brazil ch6sc3_356e2a5c:

#   sj "Goddess! What is happening?!"
    sj "Deusa! O que está acontecendo?!"

# game/chapters/chapter6/ch6sc3.rpy:1073
translate brazil ch6sc3_94bd52d4:

#   mc "It's moving ... looks like we found our door."
    mc "Está se movendo... parece que encontramos nossa porta."

# game/chapters/chapter6/ch6sc3.rpy:1075
translate brazil ch6sc3_221a8274:

#   sj "*Gasps* ..."
    sj "*Suspiros* ..."

# game/chapters/chapter6/ch6sc3.rpy:1077
translate brazil ch6sc3_464bbf4d:

#   sj "Zyra will never believe this."
    sj "Zyra jamais acreditará nisso."

# game/chapters/chapter6/ch6sc3.rpy:1079
translate brazil ch6sc3_e0ea4174:

#   sj "Wait, the passage goes ... down?"
    sj "Espere, a passagem desce...?"

# game/chapters/chapter6/ch6sc3.rpy:1081
translate brazil ch6sc3_b4c36662:

#   mc "It’s not too steep, but we’ll have to slide down."
    mc "Não é muito íngreme, mas teremos que deslizar para baixo."

# game/chapters/chapter6/ch6sc3.rpy:1082
translate brazil ch6sc3_514823a7:

#   mc "The way looks clear, as far as I can tell. I think there’s another doorway at the bottom."
    mc "Pelo que posso ver, o caminho parece livre. Acho que há outra porta lá embaixo."

# game/chapters/chapter6/ch6sc3.rpy:1084
translate brazil ch6sc3_6aedb757:

#   sj "We’ll have to slide down?"
    sj "Teremos que deslizar para baixo?"

# game/chapters/chapter6/ch6sc3.rpy:1085
translate brazil ch6sc3_c7a94c8f:

#   mc "Mhmm. Trying to balance all the way down probably won’t end well. Besides, sliding is faster."
    mc "Hum. Tentar manter o equilíbrio durante toda a descida provavelmente não vai acabar bem. Além disso, deslizar é mais rápido."

# game/chapters/chapter6/ch6sc3.rpy:1086
translate brazil ch6sc3_080f2ca3:

#   mc "Don’t worry, I’ll go first. That way we’ll know if there are any traps, and I can catch you at the bottom."
    mc "Não se preocupe, eu vou primeiro. Assim saberemos se há alguma armadilha e eu posso te pegar lá embaixo."

# game/chapters/chapter6/ch6sc3.rpy:1088
translate brazil ch6sc3_07d826eb:

#   sj "Okay ... be careful."
    sj "Ok... tenha cuidado."

# game/chapters/chapter6/ch6sc3.rpy:1091
translate brazil ch6sc3_bda4b79c:

#   sj "He’s so reckless, charging headfirst into the unknown."
    sj "Ele é tão imprudente, se lançando de cabeça no desconhecido."

# game/chapters/chapter6/ch6sc3.rpy:1092
translate brazil ch6sc3_dcbed90f:

#   sj "Reckless ... but brave. *Inhales* I'd better get down as well."
    sj "Imprudente... mas corajoso. *Inspira* É melhor eu descer também."

# game/chapters/chapter6/ch6sc3.rpy:1100
translate brazil ch6sc3_1c4cac61:

#   "As the two of you successfully slide down and enter the next room, you’re met with a now familiar sight."
    "Assim que vocês dois deslizam com sucesso para baixo e entram na sala seguinte, deparam-se com uma cena já familiar."

# game/chapters/chapter6/ch6sc3.rpy:1102
translate brazil ch6sc3_8fdc3aa4:

#   sj "It’s ... identical to the last room?"
    sj "É... idêntico ao último quarto?"

# game/chapters/chapter6/ch6sc3.rpy:1104
translate brazil ch6sc3_e3b3824c:

#   mc "Same statue and all."
    mc "A mesma estátua e tudo mais."

# game/chapters/chapter6/ch6sc3.rpy:1106
translate brazil ch6sc3_f9c88823:

#   sj "Is this a trick? Have our minds been deceived by the temple?"
    sj "Será isto uma armadilha? Terão as nossas mentes sido enganadas pelo templo?"

# game/chapters/chapter6/ch6sc3.rpy:1108
translate brazil ch6sc3_2aac4fe8:

#   mc "No, but I suspect that confusing potential trespassers was the intention of your ancestors."
    mc "Não, mas suspeito que confundir potenciais invasores era a intenção de seus ancestrais."

# game/chapters/chapter6/ch6sc3.rpy:1110
translate brazil ch6sc3_09b1eed1:

#   sj "Once again, you speak the wisdom of our ancestors."
    sj "Mais uma vez, você expressa a sabedoria de nossos ancestrais."

# game/chapters/chapter6/ch6sc3.rpy:1111
translate brazil ch6sc3_375690a3:

#   sj "How do you understand all this?"
    sj "Como você entende tudo isso?"

# game/chapters/chapter6/ch6sc3.rpy:1113
translate brazil ch6sc3_b4c67185:

#   mc "I’m not claiming that I understand your ancestors or their wisdom. I’m just assuming based on my own experience."
    mc "Não estou afirmando que entendo seus ancestrais ou sua sabedoria. Estou apenas supondo com base na minha própria experiência."

# game/chapters/chapter6/ch6sc3.rpy:1115
translate brazil ch6sc3_f2da4f5c:

#   sj "Then you hold great experience, it has gotten us this far."
    sj "Então você tem muita experiência, foi ela que nos trouxe até aqui."

# game/chapters/chapter6/ch6sc3.rpy:1116
translate brazil ch6sc3_34632b5c:

#   sj "Which one should we choose? I'll trust in your decision."
    sj "Qual devemos escolher? Confio na sua decisão."

# game/chapters/chapter6/ch6sc3.rpy:1118
translate brazil ch6sc3_64d07154:

#   mc "Hmm."
    mc "Hum."

# game/chapters/chapter6/ch6sc3.rpy:1120
translate brazil ch6sc3_a5112d7c:

#   sj "That glowy-eye thing you did: can you do it again?"
    sj "Aquela coisa que você fez com os olhos brilhantes: você pode fazer de novo?"

# game/chapters/chapter6/ch6sc3.rpy:1122
translate brazil ch6sc3_9a6cc5bc:

#   sj "Maybe there’s a clue hidden in the darkness of one of the halls?"
    sj "Talvez haja uma pista escondida na escuridão de um dos corredores?"

# game/chapters/chapter6/ch6sc3.rpy:1124
translate brazil ch6sc3_64884a60:

#   mc "Sure, it’s probably our best bet. Although, I expect these ones will be identical as well."
    mc "Com certeza, provavelmente é a nossa melhor opção. Embora eu espere que estas também sejam idênticas."

# game/chapters/chapter6/ch6sc3.rpy:1126
translate brazil ch6sc3_64acce98:

#   mc "Hold on, it’ll just take a moment."
    mc "Aguarde um instante, só vai demorar um pouco."

# game/chapters/chapter6/ch6sc3.rpy:1128
translate brazil ch6sc3_536e9ff4:

#   sj "I still can’t quite understand how you’re able to see in the dark. But ... it’s impressive."
    sj "Ainda não consigo entender direito como você consegue enxergar no escuro. Mas... é impressionante."

# game/chapters/chapter6/ch6sc3.rpy:1129
translate brazil ch6sc3_438d9bde:

#   mc "Nothing unusual here. An empty corridor with a statue at the end."
    mc "Nada de incomum aqui. Um corredor vazio com uma estátua no final."

# game/chapters/chapter6/ch6sc3.rpy:1131
translate brazil ch6sc3_1eb4f653:

#   mc "And ... more of the same."
    mc "E... mais do mesmo."

# game/chapters/chapter6/ch6sc3.rpy:1132
translate brazil ch6sc3_138bc376:

#   mc "As expected."
    mc "Como esperado."

# game/chapters/chapter6/ch6sc3.rpy:1134
translate brazil ch6sc3_12ff7dd2:

#   sj "Let’s try the right one first, this time. It was the correct one last time."
    sj "Vamos tentar primeiro a correta, desta vez. Da última vez, foi a correta."

# game/chapters/chapter6/ch6sc3.rpy:1135
translate brazil ch6sc3_c9427615:

#   mc "We might as well. As far as I can tell, there’s no way to distinguish them from each other."
    mc "Podemos fazer isso. Pelo que sei, não há como distingui-los um do outro."

# game/chapters/chapter6/ch6sc3.rpy:1137
translate brazil ch6sc3_e5ee8780:

#   sj "I’ll take the lead on this one. We don’t want you getting accidentally impaled."
    sj "Eu vou assumir a liderança nessa. Não queremos que você seja empalado acidentalmente."

# game/chapters/chapter6/ch6sc3.rpy:1139
translate brazil ch6sc3_4e821b31:

#   mc "*Chuckles* Am I ever going to hear the end of that?"
    mc "*Risos* Será que algum dia vou ouvir o fim disso?"

# game/chapters/chapter6/ch6sc3.rpy:1140
translate brazil ch6sc3_8c5f83f8:

#   sj "*Scoffs lightly* No, Champion ... I shall remind you whenever you get too boastful."
    sj "*Risos discretos* Não, campeão... Eu lhe lembrarei sempre que você se achar demais."

# game/chapters/chapter6/ch6sc3.rpy:1141
translate brazil ch6sc3_06728f7c:

#   sj "Now, follow closely."
    sj "Agora, preste bastante atenção."

# game/chapters/chapter6/ch6sc3.rpy:1143
translate brazil ch6sc3_426b64fe:

#   sj "[mc], why did our ancestors create all this?"
    sj "[mc] Por que nossos ancestrais criaram tudo isso?"

# game/chapters/chapter6/ch6sc3.rpy:1144
translate brazil ch6sc3_87b46d86:

#   sj "Why make it this difficult to reach the inner temple?"
    sj "Por que tornar o acesso ao templo interior tão difícil?"

# game/chapters/chapter6/ch6sc3.rpy:1146
translate brazil ch6sc3_3b49d4a7:

#   mc "It’s impossible to say without asking them directly."
    mc "É impossível dizer sem perguntar diretamente a eles."

# game/chapters/chapter6/ch6sc3.rpy:1147
translate brazil ch6sc3_ce41dbc5:

#   mc "But my guess would be that, much like your tribe today, they lived secluded and cut off from the outside world."
    mc "Mas eu diria que, assim como sua tribo hoje em dia, eles viviam isolados e afastados do mundo exterior."

# game/chapters/chapter6/ch6sc3.rpy:1149
translate brazil ch6sc3_fca9a1ab:

#   mc "It’s likely they could have had bad experiences with outsiders, even back then."
    mc "É provável que eles já tivessem tido experiências ruins com pessoas de fora, mesmo naquela época."

# game/chapters/chapter6/ch6sc3.rpy:1150
translate brazil ch6sc3_5dccddd9:

#   mc "And thus they created these elaborate temples."
    mc "E assim eles criaram esses templos elaborados."

# game/chapters/chapter6/ch6sc3.rpy:1151
translate brazil ch6sc3_01a4f576:

#   sj "To shield themselves? Hmm. I think ... I think that I agree with that theory."
    sj "Para se protegerem? Hum. Acho que... acho que concordo com essa teoria."

# game/chapters/chapter6/ch6sc3.rpy:1155
translate brazil ch6sc3_e6954f39:

#   sj "Huh?"
    sj "Huh?"

# game/chapters/chapter6/ch6sc3.rpy:1160
translate brazil ch6sc3_9c010122:

#   mc "Suji! Watch out!"
    mc "Suji! Cuidado!"

# game/chapters/chapter6/ch6sc3.rpy:1162
translate brazil ch6sc3_70f26226:

#   "As the statue lights up, it immediately fires a projectile directly at Suji."
    "Assim que a estátua se ilumina, ela dispara imediatamente um projétil diretamente em Suji."

# game/chapters/chapter6/ch6sc3.rpy:1165
translate brazil ch6sc3_fc7ddfba:

#   sj "Aiiyhh!"
    sj "Aiiyhh!"

# game/chapters/chapter6/ch6sc3.rpy:1168
translate brazil ch6sc3_b588fcb7:

#   sj "*Gasps* [mc] ..."
    sj "*Suspiros* [mc] ..."

# game/chapters/chapter6/ch6sc3.rpy:1169
translate brazil ch6sc3_203e3a40:

#   mc "That was close."
    mc "Essa foi por pouco."

# game/chapters/chapter6/ch6sc3.rpy:1175
translate brazil ch6sc3_91d8a70c:

#   mc "You okay?"
    mc "Você está bem?"

# game/chapters/chapter6/ch6sc3.rpy:1178
translate brazil ch6sc3_9524822e:

#   sj "You ... you saved me."
    sj "Você... você me salvou."

# game/chapters/chapter6/ch6sc3.rpy:1180
translate brazil ch6sc3_57f42689:

#   mc "Just returning the favor."
    mc "Apenas retribuindo o favor."

# game/chapters/chapter6/ch6sc3.rpy:1182
translate brazil ch6sc3_c3fecc88:

#   sj "T-Thank you, Hero."
    sj "O-Obrigado, Herói."

# game/chapters/chapter6/ch6sc3.rpy:1184
translate brazil ch6sc3_05feccc8:

#   mc "You don’t need to thank me. Didn’t we already establish that we’ll guard each other?"
    mc "Não precisa me agradecer. Já não tínhamos combinado que iríamos nos proteger mutuamente?"

# game/chapters/chapter6/ch6sc3.rpy:1186
translate brazil ch6sc3_f519f668:

#   sj "We did. Still, words are easily spoken ..."
    sj "Sim, fizemos. Mesmo assim, palavras são fáceis de dizer..."

# game/chapters/chapter6/ch6sc3.rpy:1188
translate brazil ch6sc3_6833e788:

#   sj "But you've lived up to them. Your actions have proved it so."
    sj "Mas você fez jus a elas. Suas ações provaram isso."

# game/chapters/chapter6/ch6sc3.rpy:1190
translate brazil ch6sc3_dcad2abb:

#   sj "If you hadn’t gotten me out of the way, I wouldn’t have been able to avoid that. I’d have joined my ancestors."
    sj "Se você não tivesse me tirado do caminho, eu não teria conseguido evitar aquilo. Eu teria me juntado aos meus ancestrais."

# game/chapters/chapter6/ch6sc3.rpy:1192
translate brazil ch6sc3_e0ac862b:

#   mc "You won't be joining them on my watch. You have my word, Suji."
    mc "Você não vai se juntar a eles enquanto eu estiver por perto. Pode confiar em mim, Suji."

# game/chapters/chapter6/ch6sc3.rpy:1194
translate brazil ch6sc3_0b7e6599:

#   sj "Your word ... It ... it comforts me to know this."
    sj "Suas palavras... Isso... isso me conforta."

# game/chapters/chapter6/ch6sc3.rpy:1196
translate brazil ch6sc3_eee9a4d0:

#   mc "C’mon, let’s check out the other passage instead."
    mc "Vamos lá, vamos dar uma olhada na outra passagem."

# game/chapters/chapter6/ch6sc3.rpy:1197
translate brazil ch6sc3_81d2b129:

#   sj "*Nods* Mmhm."
    sj "*Acena com a cabeça* Hum-hum."

# game/chapters/chapter6/ch6sc3.rpy:1201
translate brazil ch6sc3_c4d13233:

#   sj "I do not see anything out of the ordinary, no signs of traps."
    sj "Não vejo nada de anormal, nenhum sinal de armadilhas."

# game/chapters/chapter6/ch6sc3.rpy:1203
translate brazil ch6sc3_5f2ff2c3:

#   mc "Yeah, it’s clear, as far as I can tell. But we'd better remain alert anyway."
    mc "Sim, está claro, pelo que posso ver. Mas é melhor ficarmos alertas de qualquer forma."

# game/chapters/chapter6/ch6sc3.rpy:1205
translate brazil ch6sc3_cee1da68:

#   sj "Do you feel that? The air -"
    sj "Você sente isso? O ar -"

# game/chapters/chapter6/ch6sc3.rpy:1206
translate brazil ch6sc3_1c08f8a0:

#   mc "Mhhm. There’s a slight draft coming from somewhere."
    mc "Hum. Há uma leve corrente de ar vindo de algum lugar."

# game/chapters/chapter6/ch6sc3.rpy:1208
translate brazil ch6sc3_17815dbc:

#   sj "Very slight, but it’s there."
    sj "Muito sutil, mas está lá."

# game/chapters/chapter6/ch6sc3.rpy:1209
translate brazil ch6sc3_b405682c:

#   sj "There must be a passage behind this statue as well, then."
    sj "Deve haver também uma passagem atrás dessa estátua."

# game/chapters/chapter6/ch6sc3.rpy:1211
translate brazil ch6sc3_926bed21:

#   sj "We must be on the right path."
    sj "Devemos estar no caminho certo."

# game/chapters/chapter6/ch6sc3.rpy:1213
translate brazil ch6sc3_10d132b0:

#   mc "Right on cue. *Chuckles*"
    mc "Na hora certa. *Risos*"

# game/chapters/chapter6/ch6sc3.rpy:1214
translate brazil ch6sc3_fc86be78:

#   mc "Looks like your words carry magic within them, Suji."
    mc "Parece que suas palavras carregam magia dentro delas, Suji."

# game/chapters/chapter6/ch6sc3.rpy:1216
translate brazil ch6sc3_4b8d7fdc:

#   sj "If only that were the case ... I would -"
    sj "Se ao menos fosse assim... eu faria -"

# game/chapters/chapter6/ch6sc3.rpy:1219
translate brazil ch6sc3_7365c761:

#   sj "Goddesses!"
    sj "Deusas!"

# game/chapters/chapter6/ch6sc3.rpy:1221
translate brazil ch6sc3_92ec07d9:

#   sj "*Sighs* I don’t think I’ll ever get used to this architecture ..."
    sj "*Suspiro* Acho que nunca vou me acostumar com essa arquitetura..."

# game/chapters/chapter6/ch6sc3.rpy:1223
translate brazil ch6sc3_38ec9af9:

#   mc "It’s not something you encounter often. I’ve never encountered enchanted architecture in my travels either."
    mc "Não é algo que se encontra com frequência. Eu também nunca me deparei com arquitetura encantada em minhas viagens."

# game/chapters/chapter6/ch6sc3.rpy:1225
translate brazil ch6sc3_5127aa28:

#   sj "The ancestors ... they really were something else."
    sj "Os ancestrais... esses sim eram algo extraordinário."

# game/chapters/chapter6/ch6sc3.rpy:1227
translate brazil ch6sc3_be145cd5:

#   sj "It appears to be leading down again."
    sj "Parece que está voltando a cair."

# game/chapters/chapter6/ch6sc3.rpy:1229
translate brazil ch6sc3_671fd537:

#   mc "Yeah, same as before ... a slope down with a door at the end."
    mc "Sim, igual a antes... uma rampa para baixo com uma porta no final."

# game/chapters/chapter6/ch6sc3.rpy:1231
translate brazil ch6sc3_1687a07a:

#   mc "Do you want the honors of going first this time?"
    mc "Você quer ter a honra de ir primeiro desta vez?"

# game/chapters/chapter6/ch6sc3.rpy:1233
translate brazil ch6sc3_bc526845:

#   sj "Me? N-No ... I think it’s better when you do it."
    sj "Eu? N-Não... Acho que é melhor quando você faz."

# game/chapters/chapter6/ch6sc3.rpy:1234
translate brazil ch6sc3_c81b56e6:

#   sj "You’re great at leading the way."
    sj "Você é ótimo em liderar pelo exemplo."

# game/chapters/chapter6/ch6sc3.rpy:1236
translate brazil ch6sc3_fda8cb41:

#   sj "*Quietly* What is this feeling in my belly?"
    sj "*Em voz baixa* Que sensação é essa na minha barriga?"

# game/chapters/chapter6/ch6sc3.rpy:1237
translate brazil ch6sc3_4be96c39:

#   sj "*Quietly* I’m excited knowing that he awaits me? Surely not ..."
    sj "*Em voz baixa* Estou animada por saber que ele está me esperando? Certamente que não..."

# game/chapters/chapter6/ch6sc3.rpy:1238
translate brazil ch6sc3_f883bd4c:

#   sj "*Quietly* I mustn't be getting enough fresh air down here."
    sj "*Em voz baixa* Devo estar com falta de ar fresco por aqui."

# game/chapters/chapter6/ch6sc3.rpy:1241
translate brazil ch6sc3_85064b04:

#   "You catch her at the bottom and the two of you proceed into the next room."
    "Você a alcança lá embaixo e vocês dois seguem para a próxima sala."

# game/chapters/chapter6/ch6sc3.rpy:1244
translate brazil ch6sc3_56e6cef4:

#   "As the two of you enter the room, you’re presented with another puzzle."
    "Ao entrarem na sala, vocês dois se deparam com outro enigma."

# game/chapters/chapter6/ch6sc3.rpy:1245
translate brazil ch6sc3_193aedc0:

#   mc "This is quite different to the other rooms."
    mc "Este quarto é bastante diferente dos outros."

# game/chapters/chapter6/ch6sc3.rpy:1247
translate brazil ch6sc3_b42e6517:

#   sj "Three doors this time, but two of them are sealed off."
    sj "Desta vez são três portas, mas duas delas estão lacradas."

# game/chapters/chapter6/ch6sc3.rpy:1248
translate brazil ch6sc3_373d9477:

#   mc "And there are two statues this time, smaller in size."
    mc "E desta vez há duas estátuas, de tamanho menor."

# game/chapters/chapter6/ch6sc3.rpy:1250
translate brazil ch6sc3_b24493fb:

#   sj "The statues aren’t lighting up like the others did."
    sj "As estátuas não estão se iluminando como as outras."

# game/chapters/chapter6/ch6sc3.rpy:1251
translate brazil ch6sc3_d0c0378d:

#   sj "Perhaps we have to activate them somehow?"
    sj "Talvez tenhamos que ativá-los de alguma forma?"

# game/chapters/chapter6/ch6sc3.rpy:1253
translate brazil ch6sc3_fcf340b6:

#   mc "I agree."
    mc "Concordo."

# game/chapters/chapter6/ch6sc3.rpy:1254
translate brazil ch6sc3_bc40e8dc:

#   mc "And I’m betting we’ll have to reach the end of the open corridor to make any progress."
    mc "E aposto que teremos que chegar ao fim do corredor aberto para fazermos algum progresso."

# game/chapters/chapter6/ch6sc3.rpy:1255
translate brazil ch6sc3_c531ce28:

#   sj "*Nods in agreement*"
    sj "*Acena com a cabeça em concordância*"

# game/chapters/chapter6/ch6sc3.rpy:1257
translate brazil ch6sc3_4299b3c7:

#   sj "We’ll do it, together."
    sj "Faremos isso juntos."

