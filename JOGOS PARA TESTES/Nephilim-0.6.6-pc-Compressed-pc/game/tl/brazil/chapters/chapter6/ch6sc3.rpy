# game/chapters/chapter6/ch6sc3.rpy:3000
translate brazil ch6sc3_64e96fc1:

#   mc "Not a problem. And know this: I don't regret this either."
    mc "Sem problemas. E saiba disso: eu também não me arrependo."

# game/chapters/chapter6/ch6sc3.rpy:3002
translate brazil ch6sc3_9da2ba63:

#   "Suji lets out a relieved sigh. She enjoys one last caress of her cheek, before she gathers herself."
    "Suji solta um suspiro de alívio. Ela saboreia um último carinho na bochecha antes de se recompor."

# game/chapters/chapter6/ch6sc3.rpy:3003
