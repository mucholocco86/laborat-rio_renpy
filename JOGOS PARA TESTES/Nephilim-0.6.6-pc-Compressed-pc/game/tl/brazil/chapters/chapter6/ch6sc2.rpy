translate brazil ch6sc2_da15336a:

#   pl "Relax with me... at least until my hair dries, please?"
    pl "Relaxa comigo... pelo menos até meu cabelo secar, por favor?"

# game/chapters/chapter6/ch6sc2.rpy:487
translate brazil ch6sc2_7e8fece8:

#   mc "*Sighs* ... fine. But only until your hair is dry."
    mc "*Suspiro* ... tudo bem. Mas só até seu cabelo secar."

# game/chapters/chapter6/ch6sc2.rpy:489
translate brazil ch6sc2_69c9d4e7:

#   mct "{i}I can’t remember the last time I was at a beach and actually sat down.{/i}"
    mct "{i}Não me lembro da última vez que estive numa praia e me sentei de fato.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:490
translate brazil ch6sc2_19c15480:

#   mct "{i}I've been so consumed with revenge for the last few years of my life... I've rarely enjoyed anything.{/i}"
    mct "{i}Nos últimos anos da minha vida, estive tão consumido pela vingança que raramente tive prazer em alguma coisa.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:491
translate brazil ch6sc2_be493d9e:

#   mct "{i}Only small moments with Rin... and then Eliza. Both managed to bring me out of my shell of darkness.{/i}"
