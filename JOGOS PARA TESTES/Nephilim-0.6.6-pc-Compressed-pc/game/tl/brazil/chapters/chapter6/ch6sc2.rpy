translate brazil ch6sc2_24ab6c11:

#   "You didn't have enough {color=#87e1fa}Charisma{/color} to give a response that pleased Echo."
    "Você não tinha o suficiente {color=#87e1fa} Carisma{/color} Para dar uma resposta que agradasse à Echo."

# game/chapters/chapter6/ch6sc2.rpy:2989
translate brazil ch6sc2_a0fa5e79:

#   "Echo is slightly disappointed by you response, her trust has decreased by {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."
    "Echo ficou um pouco desapontada com sua resposta, e a confiança dela diminuiu. {size=+3}{b}{color=#f00}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc2.rpy:2993
translate brazil ch6sc2_8c125d3f:

#   ec "Come, my bedchamber awaits."
    ec "Venha, meu quarto o aguarda."

# game/chapters/chapter6/ch6sc2.rpy:2994
translate brazil ch6sc2_450f512b:

#   ec "It’s time for you to hear the darkest tale of the past. Of {b}the Great Desecration.{/b}"
    ec "Chegou a hora de você ouvir a história mais sombria do passado. {b} A Grande Profanação.{/b}"

# game/chapters/chapter6/ch6sc2.rpy:2996
translate brazil ch6sc2_30f2e4cc:

#   ec "But first, I wish to know... I am curious-"
    ec "Mas primeiro, eu gostaria de saber... Estou curioso(a)..."

# game/chapters/chapter6/ch6sc2.rpy:2997
translate brazil ch6sc2_fff371dd:

#   ec "How was your time in the Chambers of Malanthe?"
    ec "Como foi sua experiência nas Câmaras de Malanthe?"

# game/chapters/chapter6/ch6sc2.rpy:2998
translate brazil ch6sc2_a96efa72:

#   mc "It was..."
    mc "Era..."

# game/chapters/chapter6/ch6sc2.rpy:3000
translate brazil ch6sc2_44c47b6a:

#   ec "Please, be honest with me."
    ec "Por favor, seja sincero comigo."

# game/chapters/chapter6/ch6sc2.rpy:3001
translate brazil ch6sc2_f766e0e7:

#   ec "I wish to know if my gift was well received."
    ec "Gostaria de saber se meu presente foi bem recebido."

# game/chapters/chapter6/ch6sc2.rpy:3002
translate brazil ch6sc2_22ddd29b:

#   mc "I enjoyed it. You’ve been very generous to me."
    mc "Gostei muito. Você foi muito generoso comigo."

# game/chapters/chapter6/ch6sc2.rpy:3004
translate brazil ch6sc2_56cc4db0:

#   ec "This pleases me."
    ec "Isso me agrada."

# game/chapters/chapter6/ch6sc2.rpy:3005
translate brazil ch6sc2_1f390f65:

#   ec "I’m glad you enjoyed my gift."
    ec "Fico feliz que tenha gostado do meu presente."

# game/chapters/chapter6/ch6sc2.rpy:3006
translate brazil ch6sc2_9db0070f:

#   ec "I was worried that you might not have been satisfied..."
    ec "Eu estava preocupado que você não tivesse ficado satisfeito..."

# game/chapters/chapter6/ch6sc2.rpy:3008
translate brazil ch6sc2_be1c0fb7:

#   ec "I know how Sakari can be."
    ec "Eu sei como Sakari pode ser."

# game/chapters/chapter6/ch6sc2.rpy:3009
translate brazil ch6sc2_d1ef8909:

#   ec "She’s a fierce lioness, and her maidens are her cubs."
    ec "Ela é uma leoa feroz, e suas crias são seus filhotes."

# game/chapters/chapter6/ch6sc2.rpy:3010
translate brazil ch6sc2_ab613b64:

#   ec "I was afraid they’d eat you up whole."
    ec "Eu tinha medo que eles te devorassem inteiro."

# game/chapters/chapter6/ch6sc2.rpy:3012
translate brazil ch6sc2_4d4457c6:

#   mc "*Chuckles* Don’t worry, Echo... I can handle myself."
    mc "*Risos* Não se preocupe, Echo... Eu sei me virar."

# game/chapters/chapter6/ch6sc2.rpy:3013
translate brazil ch6sc2_a7da3541:

#   mc "Nothing like a couple of lionesses to keep a man on his toes."
    mc "Nada como um par de leoas para manter um homem alerta."

# game/chapters/chapter6/ch6sc2.rpy:3015
translate brazil ch6sc2_902c2722:

#   ec "*Snickers* I’m glad they didn’t scare you off."
    ec "*Risos* Que bom que eles não te assustaram."

# game/chapters/chapter6/ch6sc2.rpy:3016
translate brazil ch6sc2_6c91f086:

#   ec "Please. Sit with me."
    ec "Por favor, sente-se comigo."

# game/chapters/chapter6/ch6sc2.rpy:3018
translate brazil ch6sc2_87279a0c:

#   mc "Your bedchamber is lovely."
    mc "Seu quarto é encantador."

# game/chapters/chapter6/ch6sc2.rpy:3020
translate brazil ch6sc2_3753f9ec:

#   ec "Thank you. I wanted us to have some privacy to get to know one another better."
    ec "Obrigada. Eu queria que tivéssemos um pouco de privacidade para nos conhecermos melhor."

# game/chapters/chapter6/ch6sc2.rpy:3022
translate brazil ch6sc2_ade90c8e:

#   mc "Yeah, the tour was great. But I prefer privacy too, if I'm honest."
    mc "Sim, o passeio foi ótimo. Mas, para ser sincero, eu também prefiro privacidade."

# game/chapters/chapter6/ch6sc2.rpy:3023
translate brazil ch6sc2_2f3ce9c1:

#   mc "So, how come you were so curious about my experience in the chambers?"
    mc "Então, por que você estava tão curioso sobre a minha experiência nas câmaras?"

# game/chapters/chapter6/ch6sc2.rpy:3025
translate brazil ch6sc2_057bf7d3:

#   ec "Oh... I... well, it sort of ties into our ancestry and our beliefs."
    ec "Ah... eu... bem, isso meio que se relaciona com nossa ancestralidade e nossas crenças."

# game/chapters/chapter6/ch6sc2.rpy:3027
translate brazil ch6sc2_f22b9878:

#   ec "You see, there is a leader for each role in our society: Huntresses, Priests, Maidens, Herbalists, and Guards."
    ec "Veja bem, existe um líder para cada função em nossa sociedade: Caçadoras, Sacerdotes, Donzelas, Herboristas e Guardas."

# game/chapters/chapter6/ch6sc2.rpy:3031
translate brazil ch6sc2_f67b40f1:

#   ec "For Huntresses, that leader is Kisha, the Head-Huntress."
    ec "Para as Caçadoras, essa líder é Kisha, a Caçadora-Chefe."

# game/chapters/chapter6/ch6sc2.rpy:3034
translate brazil ch6sc2_062f0cfd:

#   ec "For our Priests it’s Marah, the High-Priestess."
    ec "Para os nossos sacerdotes, é Marah, a Alta Sacerdotisa."

# game/chapters/chapter6/ch6sc2.rpy:3037
translate brazil ch6sc2_05b6b684:

#   ec "For Maidens it’s Sakari, the Mistress of Malanthe."
    ec "Para as donzelas, é Sakari, a Senhora de Malanthe."

# game/chapters/chapter6/ch6sc2.rpy:3040
translate brazil ch6sc2_edd56178:

#   ec "For the Herbalists, it’s Sewah, Chief-Herbalist."
    ec "Para os herbalistas, é Sewah, Herborista Chefe."

# game/chapters/chapter6/ch6sc2.rpy:3041
translate brazil ch6sc2_5f841088:

#   ec "Although Sewah isn't with us at A'nai currently, long story."
    ec "Embora Sewah não esteja conosco em A'nai atualmente, é uma longa história."

# game/chapters/chapter6/ch6sc2.rpy:3044
translate brazil ch6sc2_29256e02:

#   ec "And for the Guards and War-Maidens it’s Riven, Grandhuntress."
    ec "E para as Guardas e Donzelas da Guerra, é Riven, a Grande Caçadora."

# game/chapters/chapter6/ch6sc2.rpy:3045
translate brazil ch6sc2_363ef8b2:

#   ec "She too, is currently not present in A'nai..."
    ec "Ela também não está presente em A'nai no momento..."

# game/chapters/chapter6/ch6sc2.rpy:3047
translate brazil ch6sc2_f5a1f7fd:

#   mc "So, each role or group within your tribe has a leader assigned to it?"
    mc "Então, cada função ou grupo dentro da sua tribo tem um líder designado?"

# game/chapters/chapter6/ch6sc2.rpy:3049
translate brazil ch6sc2_1e688351:

#   ec "Correct. And I... as the A’nu... I suppose I would be considered a Queen, where you’re from."
    ec "Correto. E eu... como A'nu... suponho que eu seria considerada uma Rainha, de onde você é."

# game/chapters/chapter6/ch6sc2.rpy:3050
translate brazil ch6sc2_4ddbe740:

#   ec "I am the highest authority within the tribe, but I rarely have to use my authority."
    ec "Sou a maior autoridade dentro da tribo, mas raramente preciso usar minha autoridade."

# game/chapters/chapter6/ch6sc2.rpy:3052
translate brazil ch6sc2_e9c52b7e:

#   ec "It’s important to appoint good leaders for each group, because they oversee and handle the tasks given to their members."
    ec "É importante nomear bons líderes para cada grupo, pois eles supervisionam e gerenciam as tarefas atribuídas aos seus membros."

# game/chapters/chapter6/ch6sc2.rpy:3054
translate brazil ch6sc2_ec1e75e6:

#   mc "I see, that’s quite smart."
    mc "Entendi, isso é bem inteligente."

# game/chapters/chapter6/ch6sc2.rpy:3055
translate brazil ch6sc2_64327983:

#   mc "We have a similar system where I’m from, although on a larger scale, and with more conflicting interests."
    mc "De onde eu venho, temos um sistema semelhante, embora em maior escala e com mais interesses conflitantes."

# game/chapters/chapter6/ch6sc2.rpy:3056
translate brazil ch6sc2_4ab564cb:

#   mc "We have groups of people that we call guilds. They function a little like your role groupings, albeit with some differences."
    mc "Temos grupos de pessoas que chamamos de guildas. Elas funcionam de forma semelhante aos seus grupos por função, embora com algumas diferenças."

# game/chapters/chapter6/ch6sc2.rpy:3058
translate brazil ch6sc2_6b3e569d:

#   ec "Right. Earlier, I believe you said you were part of an 'Adventurer’s guild?'"
    ec "Certo. Antes, acho que você disse que fazia parte de uma 'guilda de aventureiros'?"

# game/chapters/chapter6/ch6sc2.rpy:3060
translate brazil ch6sc2_646f9e7c:

#   mc "Yeah. So... you were explaining your curiosity about my visit to the Chamber of Malanthe?"
    mc "Sim. Então... você estava explicando sua curiosidade sobre minha visita à Câmara de Malanthe?"

# game/chapters/chapter6/ch6sc2.rpy:3062
translate brazil ch6sc2_4c10a614:

#   ec "Right... as I was saying, none of the leaders, including myself as the A’nu..."
    ec "Certo... como eu estava dizendo, nenhum dos líderes, incluindo eu mesmo como A'nu..."

# game/chapters/chapter6/ch6sc2.rpy:3063
translate brazil ch6sc2_572d5f82:

#   ec "Participate in the pleasures that the Chamber of Malanthe provides the rest of the tribe."
    ec "Participe dos prazeres que a Câmara de Malanthe proporciona ao resto da tribo."

# game/chapters/chapter6/ch6sc2.rpy:3065
translate brazil ch6sc2_a16337d3:

#   mc "Oh? How come?"
    mc "Ah? Como assim?"

# game/chapters/chapter6/ch6sc2.rpy:3067
translate brazil ch6sc2_96e59ba6:

#   ec "It is forbidden."
    ec "É proibido."

# game/chapters/chapter6/ch6sc2.rpy:3068
translate brazil ch6sc2_3aa8cfac:

#   ec "Each leader is saving herself for..."
    ec "Cada líder está se guardando para..."

# game/chapters/chapter6/ch6sc2.rpy:3070
translate brazil ch6sc2_163ec697:

#   mc "For?"
    mc "Para?"

# game/chapters/chapter6/ch6sc2.rpy:3072
translate brazil ch6sc2_bbc849b9:

#   ec "For our next {b}A'khan{/b} to emerge."
    ec "Para o nosso próximo {b} A'khan{/b} emergir."

# game/chapters/chapter6/ch6sc2.rpy:3074
translate brazil ch6sc2_83bcfa62:

#   ec "Our histories teach that, someday, a great champion will arise."
    ec "Nossa história nos ensina que, um dia, um grande campeão surgirá."

# game/chapters/chapter6/ch6sc2.rpy:3075
translate brazil ch6sc2_c375eb34:

#   ec "And when he does, he will claim A’nai as his tribe, and become it’s {b}A'khan{/b}."
    ec "E quando o fizer, ele reivindicará A'nai como sua tribo e se tornará seu líder. {b} A'khan{/b}."

# game/chapters/chapter6/ch6sc2.rpy:3076
translate brazil ch6sc2_f9ab6dae:

#   ec "A King, in your speech."
    ec "Um rei, em seu discurso."

# game/chapters/chapter6/ch6sc2.rpy:3078
translate brazil ch6sc2_75bd917b:

#   ec "So, it's important that our leaders remain pure for him."
    ec "Portanto, é importante que nossos líderes permaneçam puros por Ele."

# game/chapters/chapter6/ch6sc2.rpy:3082
translate brazil ch6sc2_3067585f:

#   mc "So, you’ve never...?"
    mc "Então, você nunca...?"

# game/chapters/chapter6/ch6sc2.rpy:3084
translate brazil ch6sc2_a0676fd9:

#   ec "I... I’ve done... things, on my own."
    ec "Eu... eu já fiz... coisas, por conta própria."

# game/chapters/chapter6/ch6sc2.rpy:3085
translate brazil ch6sc2_10e5ee50:

#   ec "To prepare for the day he emerges."
    ec "Para se preparar para o dia em que ele surgir."

# game/chapters/chapter6/ch6sc2.rpy:3086
translate brazil ch6sc2_fd926314:

#   mct "{i}*Chuckles* She’s getting a little shy? I guess I was being a little too direct.{/i}"
    mct "{i}*Risos* Ela está ficando um pouco tímida? Acho que fui um pouco direto demais.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:3088
translate brazil ch6sc2_fd65168f:

#   mc "I understand, whoever that man is... he is in for a treat."
    mc "Entendo, quem quer que seja esse homem... ele terá uma grata surpresa."

# game/chapters/chapter6/ch6sc2.rpy:3090
translate brazil ch6sc2_3ff8b302:

#   ec "A-Anyways... I think it’s time for you to hear about our past."
    ec "Bem... acho que está na hora de você ouvir sobre o nosso passado."

# game/chapters/chapter6/ch6sc2.rpy:3091
translate brazil ch6sc2_9a20274c:

#   ec "You said you wanted to know what happened? Why there are no men among us?"
    ec "Você disse que queria saber o que aconteceu? Por que não há homens entre nós?"

# game/chapters/chapter6/ch6sc2.rpy:3093
translate brazil ch6sc2_0fe1338d:

#   mc "I do ... it piques my interest. But I can tell that it troubles you."
    mc "Sim... isso desperta meu interesse. Mas percebo que te incomoda."

# game/chapters/chapter6/ch6sc2.rpy:3094
translate brazil ch6sc2_f82fb2e6:

#   mc "I can wait."
    mc "Posso esperar."

# game/chapters/chapter6/ch6sc2.rpy:3096
translate brazil ch6sc2_108cfddc:

#   ec "It does pain me to think about it, but you need to know if you wish to understand us."
    ec "Dói-me pensar nisso, mas você precisa saber se quiser nos entender."

# game/chapters/chapter6/ch6sc2.rpy:3097
translate brazil ch6sc2_baa66b2f:

#   ec "If we continue to hold on to our pain, to blame all outsiders for what happened years ago..."
    ec "Se continuarmos a nos apegar à nossa dor, a culpar todos os que estão de fora pelo que aconteceu anos atrás..."

# game/chapters/chapter6/ch6sc2.rpy:3098
translate brazil ch6sc2_b87fa891:

#   ec "Then... we’ll never heal our wounds."
    ec "Então... nossas feridas jamais cicatrizarão."

# game/chapters/chapter6/ch6sc2.rpy:3100
translate brazil ch6sc2_fe22f028:

#   ec "Those who suffered and endured the desecration must be remembered and honored."
    ec "Aqueles que sofreram e suportaram a profanação devem ser lembrados e honrados."

# game/chapters/chapter6/ch6sc2.rpy:3101
translate brazil ch6sc2_8249418b:

#   ec "It all started when I was only a newborn. I hadn’t even learned to walk yet."
    ec "Tudo começou quando eu ainda era recém-nascido. Eu nem tinha aprendido a andar ainda."

# game/chapters/chapter6/ch6sc2.rpy:3103
translate brazil ch6sc2_a7afa7ef:

#   ec "You see... at the time, we had an A’khan. He was kind, brave and strong."
    ec "Veja bem... naquela época, tínhamos um A'khan. Ele era gentil, corajoso e forte."

# game/chapters/chapter6/ch6sc2.rpy:3104
translate brazil ch6sc2_b7c0d98d:

#   ec "Those were peaceful times. Aruna, our island was unified then. We all lived here in A’nai. One big tribe."
    ec "Aqueles eram tempos de paz. Aruna, nossa ilha, estava unificada naquela época. Todos nós vivíamos aqui em A'nai. Uma grande tribo."

# game/chapters/chapter6/ch6sc2.rpy:3106
translate brazil ch6sc2_c1c61f17:

#   mc "The A’khan, was he the one who built this temple?"
    mc "O A'khan, foi ele quem construiu este templo?"

# game/chapters/chapter6/ch6sc2.rpy:3108
translate brazil ch6sc2_e65e1ed2:

#   ec "No, no. As I said, this temple is ancient."
    ec "Não, não. Como eu disse, este templo é antigo."

# game/chapters/chapter6/ch6sc2.rpy:3109
translate brazil ch6sc2_35ffafc0:

#   ec "It was built long ago by our ancestors."
    ec "Foi construído há muito tempo pelos nossos antepassados."

# game/chapters/chapter6/ch6sc2.rpy:3111
translate brazil ch6sc2_4c3612f1:

#   ec "There are many old temples and ruins scattered throughout Aruna and its jungles."
    ec "Existem muitos templos antigos e ruínas espalhadas por Aruna e suas selvas."

# game/chapters/chapter6/ch6sc2.rpy:3113
translate brazil ch6sc2_ce8cb217:

#   ec "The temple we’re in right now is the heart of A’nai."
    ec "O templo em que nos encontramos agora é o coração de A'nai."

# game/chapters/chapter6/ch6sc2.rpy:3114
translate brazil ch6sc2_3d3b1163:

#   ec "It is one of four, large ancient temples on the island."
    ec "É um dos quatro grandes templos antigos da ilha."

# game/chapters/chapter6/ch6sc2.rpy:3115
translate brazil ch6sc2_f1fe0687:

#   ec "Each of the three Goddesses that we worship has a temple dedicated to her."
    ec "Cada uma das três Deusas que veneramos possui um templo dedicado a ela."

# game/chapters/chapter6/ch6sc2.rpy:3116
translate brazil ch6sc2_ec689ae9:

#   ec "And then there’s this one."
    ec "E depois há esta aqui."

# game/chapters/chapter6/ch6sc2.rpy:3118
translate brazil ch6sc2_7511d1b8:

#   ec "We believe that this was the very first temple."
    ec "Acreditamos que este foi o primeiro templo."

# game/chapters/chapter6/ch6sc2.rpy:3119
translate brazil ch6sc2_98f79ee9:

#   ec "Built to honor the old ways by the followers of Malpheon."
    ec "Construído para honrar os antigos costumes dos seguidores de Malpheon."

# game/chapters/chapter6/ch6sc2.rpy:3121
translate brazil ch6sc2_1e2951a0:

#   ec "The other three temples are believed to have been built soon after, using knowledge that Malpheon had bestowed upon the tribe."
    ec "Acredita-se que os outros três templos tenham sido construídos logo depois, utilizando o conhecimento que Malpheon havia transmitido à tribo."

# game/chapters/chapter6/ch6sc2.rpy:3123
translate brazil ch6sc2_972417d0:

#   ec "The temple of Maia is in the territory of the Arugoh tribe, who we share the island with."
    ec "O templo de Maia fica no território da tribo Arugoh, com quem compartilhamos a ilha."

# game/chapters/chapter6/ch6sc2.rpy:3125
translate brazil ch6sc2_11ceaf1f:

#   ec "But the temple of Malanthe and the temple of Gaia have both been lost to the jungle, nobody in our generation has seen them."
    ec "Mas o templo de Malanthe e o templo de Gaia se perderam na selva; ninguém da nossa geração os viu."

# game/chapters/chapter6/ch6sc2.rpy:3126
translate brazil ch6sc2_37ac7408:

#   ec "As for the Temple of Maia, it is located further to the north, deep within the jungle."
    ec "Já o Templo de Maia está localizado mais ao norte, no meio da selva."

# game/chapters/chapter6/ch6sc2.rpy:3128
translate brazil ch6sc2_d72b8f9f:

#   mc "Imagine uncovering them..."
    mc "Imagine descobri-los..."

# game/chapters/chapter6/ch6sc2.rpy:3130
translate brazil ch6sc2_525aa84c:

#   ec "If only it were possible. Even for us, the jungle is mysterious and can be both... a refuge and a danger."
    ec "Quem dera fosse possível. Mesmo para nós, a selva é misteriosa e pode ser tanto um refúgio quanto um perigo."

# game/chapters/chapter6/ch6sc2.rpy:3132
translate brazil ch6sc2_9357f3f7:

#   mc "Echo, what happened to divide the tribe in two?"
    mc "Echo, o que aconteceu para dividir a tribo em duas?"

# game/chapters/chapter6/ch6sc2.rpy:3134
translate brazil ch6sc2_d7dd2863:

#   ec "During the peaceful times that our A’Khan provided, Aruna island became known for its ancient culture and exotic goods."
    ec "Durante os períodos de paz proporcionados por nosso A'Khan, a ilha de Aruna ficou conhecida por sua cultura ancestral e produtos exóticos."

# game/chapters/chapter6/ch6sc2.rpy:3136
translate brazil ch6sc2_abd20a9b:

#   ec "We were prosperous in our dealings with others. The variety of fruits from the jungle were popular both for medicine and making alcohol."
    ec "Nossas relações com os outros eram prósperas. As diversas frutas da selva eram populares tanto para fins medicinais quanto para a produção de bebidas alcoólicas."

# game/chapters/chapter6/ch6sc2.rpy:3137
translate brazil ch6sc2_509ff61b:

#   ec "Nobles from the mainlands prized those wines for their potency and their sweet taste."
    ec "Os nobres do continente apreciavam esses vinhos por sua potência e seu sabor adocicado."

# game/chapters/chapter6/ch6sc2.rpy:3138
translate brazil ch6sc2_91b4359f:

#   ec "But after a few good years of prosperity... it all came to an end."
    ec "Mas depois de alguns bons anos de prosperidade... tudo chegou ao fim."

# game/chapters/chapter6/ch6sc2.rpy:3140
translate brazil ch6sc2_be27308e:

#   ec "During the early days of trading with the outside world, our A'khan allowed sailors to take refuge here."
    ec "Nos primórdios do comércio com o mundo exterior, nosso A'khan permitiu que os marinheiros se refugiassem aqui."

# game/chapters/chapter6/ch6sc2.rpy:3141
translate brazil ch6sc2_23096f55:

#   ec "And as all men have desires... they made an arrangement with our A'khan to be allowed to..."
    ec "E como todos os homens têm desejos... eles fizeram um acordo com nosso A'khan para que lhes fosse permitido..."

# game/chapters/chapter6/ch6sc2.rpy:3143
translate brazil ch6sc2_272ee1eb:

#   ec "... 'enjoy' the Chambers of Malanthe, and its maidens. But only if the maidens willingly accepted the men."
    ec "... 'desfrutar' dos aposentos de Malanthe e de suas donzelas. Mas somente se as donzelas aceitassem os homens de bom grado."

# game/chapters/chapter6/ch6sc2.rpy:3144
translate brazil ch6sc2_c81c17a8:

#   ec "Those were the terms that our A'khan set, and in return the sailors could trade freely with A'nai."
    ec "Esses foram os termos que nosso A'khan estabeleceu, e em troca os marinheiros podiam negociar livremente com A'nai."

# game/chapters/chapter6/ch6sc2.rpy:3145
translate brazil ch6sc2_e4f4dc8f:

#   ec "Unfortunately, some of the outsiders grew vile and aggressive towards our maidens, sometimes ending in physical abuse."
    ec "Infelizmente, alguns dos forasteiros se tornaram cruéis e agressivos com nossas moças, chegando, por vezes, a agressões físicas."

# game/chapters/chapter6/ch6sc2.rpy:3147
translate brazil ch6sc2_c870c4d1:

#   ec "Our A'khan did not take this lightly."
    ec "Nosso A'khan não levou isso na brincadeira."

# game/chapters/chapter6/ch6sc2.rpy:3148
translate brazil ch6sc2_aed73e78:

#   ec "Once he learned about these transgressions, he immediately terminated the deal with the outsiders."
    ec "Assim que tomou conhecimento dessas transgressões, ele imediatamente rescindiu o acordo com os forasteiros."

# game/chapters/chapter6/ch6sc2.rpy:3149
translate brazil ch6sc2_67548a63:

#   ec "It seemed to work. After a while, the sailors stopped visiting A'nai."
    ec "Pareceu funcionar. Depois de um tempo, os marinheiros pararam de visitar A'nai."

# game/chapters/chapter6/ch6sc2.rpy:3151
translate brazil ch6sc2_56098517:

#   ec "The greed of men... our joy was short-lived."
    ec "A ganância dos homens... nossa alegria durou pouco."

# game/chapters/chapter6/ch6sc2.rpy:3153
translate brazil ch6sc2_1d1674ff:

#   ec "One day, a few men from an unknown land arrived seeking aid after being shipwrecked."
    ec "Certo dia, alguns homens de uma terra desconhecida chegaram em busca de ajuda após terem sofrido um naufrágio."

# game/chapters/chapter6/ch6sc2.rpy:3155
translate brazil ch6sc2_a2266d01:

#   ec "But they arrived under false pretenses."
    ec "Mas eles chegaram sob falsos pretextos."

# game/chapters/chapter6/ch6sc2.rpy:3156
translate brazil ch6sc2_6771d73a:

#   ec "They tricked our great A’Khan... they tricked all of us."
    ec "Eles enganaram nosso grande A'Khan... enganaram a todos nós."

# game/chapters/chapter6/ch6sc2.rpy:3157
translate brazil ch6sc2_3e53bf97:

#   ec "We allowed them into the midst of A’nai, we gave them shelter, provided aid and food..."
    ec "Nós os acolhemos no meio de A'nai, demos-lhes abrigo, fornecemos ajuda e comida..."

# game/chapters/chapter6/ch6sc2.rpy:3159
translate brazil ch6sc2_1d2901fc:

#   ec "Weeks went by, and they established relations within the tribe. After a time, we let our guard down."
    ec "Passaram-se semanas e eles estabeleceram relações dentro da tribo. Depois de um tempo, baixamos a guarda."

# game/chapters/chapter6/ch6sc2.rpy:3160
translate brazil ch6sc2_3e93bb36:

#   ec "But these men had not shipwrecked at Aruna by chance, it was intentional."
    ec "Mas o naufrágio desses homens em Aruna não foi por acaso, foi intencional."

# game/chapters/chapter6/ch6sc2.rpy:3164
translate brazil ch6sc2_b95d19e6:

#   ec "How naive... how hopelessly foolish we were."
    ec "Que ingenuidade... que tolice irremediável a nossa."

# game/chapters/chapter6/ch6sc2.rpy:3165
translate brazil ch6sc2_a7daa7b5:

#   ec "One night, they managed to light a beacon and we didn’t notice before it was too late."
    ec "Certa noite, eles conseguiram acender um farol e nós só percebemos quando já era tarde demais."

# game/chapters/chapter6/ch6sc2.rpy:3167
translate brazil ch6sc2_9c779392:

#   ec "Suddenly, we were set upon by many men."
    ec "De repente, fomos atacados por muitos homens."

# game/chapters/chapter6/ch6sc2.rpy:3168
translate brazil ch6sc2_f8a4d1cd:

#   ec "We outnumbered them, but they were able to overpower us due to their treachery."
    ec "Éramos em maior número, mas eles conseguiram nos derrotar devido à sua traição."

# game/chapters/chapter6/ch6sc2.rpy:3170
translate brazil ch6sc2_9837319e:

#   ec "The group we'd been aiding had insisted on a celebration that evening..."
    ec "O grupo que estávamos ajudando insistiu em fazer uma comemoração naquela noite..."

# game/chapters/chapter6/ch6sc2.rpy:3171
translate brazil ch6sc2_50f4e945:

#   ec "And many of our people had over-indulged in the sweet alcohol and were in no shape to fight."
    ec "E muitos dos nossos tinham exagerado na bebida doce e não estavam em condições de lutar."

# game/chapters/chapter6/ch6sc2.rpy:3173
translate brazil ch6sc2_cc761fff:

#   ec "[mc]... we were attacked from within, betrayed by those who had gained our trust."
    ec "[mc]...fomos atacados por dentro, traídos por aqueles que haviam conquistado nossa confiança."

# game/chapters/chapter6/ch6sc2.rpy:3174
translate brazil ch6sc2_c8d499a0:

#   ec "The people we had only sought to aid... turned into monsters."
    ec "As pessoas que nós apenas queríamos ajudar... transformaram-se em monstros."

# game/chapters/chapter6/ch6sc2.rpy:3175
translate brazil ch6sc2_ba7a7788:

#   ec "They captured our guards and huntresses first, and after that we were powerless when they seized the temple."
    ec "Primeiro capturaram nossos guardas e caçadoras, e depois ficamos impotentes quando tomaram o templo."

# game/chapters/chapter6/ch6sc2.rpy:3177
translate brazil ch6sc2_b5b205e7:

#   ec "What happened next was... {b}The Great Desecration{/b}."
    ec "O que aconteceu a seguir foi... {b} A Grande Profanação{/b}."

# game/chapters/chapter6/ch6sc2.rpy:3178
translate brazil ch6sc2_1519cc62:

#   ec "Our... oppression."
    ec "Nossa... opressão."

# game/chapters/chapter6/ch6sc2.rpy:3180
translate brazil ch6sc2_c16ae741:

#   ec "They killed our A’Khan by brutally beating him to death in front of the whole tribe."
    ec "Eles mataram nosso A'Khan espancando-o brutalmente até a morte na frente de toda a tribo."

# game/chapters/chapter6/ch6sc2.rpy:3181
translate brazil ch6sc2_fc881570:

#   ec "It is told that the wails of our tribeswomen could be heard all over Aruna that night."
    ec "Conta-se que os lamentos das mulheres da nossa tribo puderam ser ouvidos por toda Aruna naquela noite."

# game/chapters/chapter6/ch6sc2.rpy:3183
translate brazil ch6sc2_458bb456:

#   ec "Everyone was imprisoned here in the Great Temple of A’nai. They ransacked the lower sections and then turned it into a prison."
    ec "Todos foram aprisionados aqui no Grande Templo de A'nai. Eles saquearam as seções inferiores e depois transformaram o local em uma prisão."

# game/chapters/chapter6/ch6sc2.rpy:3184
translate brazil ch6sc2_38ea3b2f:

#   ec "Nothing was sacred to these men, they broke the statues we built to honor the gods."
    ec "Nada era sagrado para esses homens; eles destruíram as estátuas que construímos para honrar os deuses."

# game/chapters/chapter6/ch6sc2.rpy:3186
translate brazil ch6sc2_3656fe58:

#   ec "They beat anyone that earned their ire..."
    ec "Eles espancavam qualquer um que despertasse sua ira..."

# game/chapters/chapter6/ch6sc2.rpy:3187
translate brazil ch6sc2_38dbcb4c:

#   ec "But... but that wasn’t enough for them..."
    ec "Mas... mas isso não foi suficiente para eles..."

# game/chapters/chapter6/ch6sc2.rpy:3188
translate brazil ch6sc2_8cc7b128:

#   ec "It only took a few days for the beatings to become increasingly brutal. And the men... their urges were unleashed."
    ec "Bastaram alguns dias para que as agressões se tornassem cada vez mais brutais. E os homens... seus impulsos foram libertados."

# game/chapters/chapter6/ch6sc2.rpy:3189
translate brazil ch6sc2_843a90e6:

#   ec "*Clenches teeth* The women of A’nai were mercilessly brutalized and raped. That is the true horror our tribe suffered."
    ec "*Aperta os dentes* As mulheres de A'nai foram brutalizadas e estupradas sem piedade. Esse é o verdadeiro horror que nossa tribo sofreu."

# game/chapters/chapter6/ch6sc2.rpy:3191
translate brazil ch6sc2_0541c49c:

#   ec "Those sick bastards reveled in the pleasures of the flesh, not given freely but taken forcefully."
    ec "Aqueles bastardos doentes se deleitavam nos prazeres da carne, não concedidos livremente, mas tomados à força."

# game/chapters/chapter6/ch6sc2.rpy:3192
translate brazil ch6sc2_f4455ddd:

#   ec "It is told by our elders that they were relentless."
    ec "Nossos ancestrais contam que eles eram implacáveis."

# game/chapters/chapter6/ch6sc2.rpy:3193
translate brazil ch6sc2_af4526d6:

#   ec "Night after night the cries and screams of women being taken against their will filled the city."
    ec "Noite após noite, os gritos e lamentos de mulheres sendo levadas contra a sua vontade ecoavam pela cidade."

# game/chapters/chapter6/ch6sc2.rpy:3194
translate brazil ch6sc2_999c5ba0:

#   ec "The darkest hour of A'nai had come."
    ec "Chegou a hora mais sombria de A'nai."

# game/chapters/chapter6/ch6sc2.rpy:3196
translate brazil ch6sc2_fda2de41:

#   mc "Echo, I’m... that’s horrible. I’m so sorry for what your tribe suffered."
    mc "Echo, eu... isso é horrível. Sinto muito pelo que sua tribo sofreu."

# game/chapters/chapter6/ch6sc2.rpy:3197
translate brazil ch6sc2_6b6979bd:

#   ec "*Nods* ..."
    ec "*Acena com a cabeça* ..."

# game/chapters/chapter6/ch6sc2.rpy:3199
translate brazil ch6sc2_ad982c44:

#   ec "My mother, who was A’nu before me, was now widowed... but she bided her time, together with a few others who still had the strength."
    ec "Minha mãe, que era A'nu antes de mim, agora estava viúva... mas ela esperou o momento certo, junto com algumas outras pessoas que ainda tinham forças."

# game/chapters/chapter6/ch6sc2.rpy:3201
translate brazil ch6sc2_15b424e3:

#   ec "They used the intruders own tactics against them and slowly earned their trust."
    ec "Eles usaram as próprias táticas dos invasores contra eles e, aos poucos, conquistaram sua confiança."

# game/chapters/chapter6/ch6sc2.rpy:3203
translate brazil ch6sc2_0218eaf0:

#   ec "Eventually, they learned their routines, and gained a little more freedom outside the temple cells."
    ec "Com o tempo, eles aprenderam suas rotinas e ganharam um pouco mais de liberdade fora das celas do templo."

# game/chapters/chapter6/ch6sc2.rpy:3204
translate brazil ch6sc2_09ca0d74:

#   ec "They needed to act swiftly and decisively, and so they struck one night when the men had been drinking heavily."
    ec "Eles precisavam agir com rapidez e decisão, então atacaram numa noite em que os homens estavam muito embriagados."

# game/chapters/chapter6/ch6sc2.rpy:3206
translate brazil ch6sc2_063c8e89:

#   ec "They brought secretly crafted wooden weapons to the pleasure session that night..."
    ec "Eles levaram armas de madeira fabricadas secretamente para a sessão de prazer naquela noite..."

# game/chapters/chapter6/ch6sc2.rpy:3208
translate brazil ch6sc2_0e27d110:

#   ec "And killed the men there while they were vulnerable."
    ec "E mataram os homens que estavam lá enquanto estavam vulneráveis."

# game/chapters/chapter6/ch6sc2.rpy:3209
translate brazil ch6sc2_ca7539a7:

#   ec "Then they snuck around the village in the dark, quietly slaying any that they found sleeping."
    ec "Então, eles se esgueiraram pela aldeia na escuridão, matando silenciosamente qualquer um que encontrassem dormindo."

# game/chapters/chapter6/ch6sc2.rpy:3211
translate brazil ch6sc2_9e6822c4:

#   ec "Soon, they were able to retake our homes, and the remaining outsiders were all put to the spear."
    ec "Em pouco tempo, eles conseguiram retomar nossas casas, e os forasteiros restantes foram todos mortos à lança."

# game/chapters/chapter6/ch6sc2.rpy:3213
translate brazil ch6sc2_c2c9772c:

#   ec "They now suffer in the most wretched of hells, I’m certain!"
    ec "Agora eles sofrem nos infernos mais miseráveis, disso eu tenho certeza!"

# game/chapters/chapter6/ch6sc2.rpy:3214
translate brazil ch6sc2_334e8b1f:

#   ec "Months of torture, violence, and rape was finally over for our people ..."
    ec "Meses de tortura, violência e estupro finalmente chegaram ao fim para o nosso povo..."

# game/chapters/chapter6/ch6sc2.rpy:3216
translate brazil ch6sc2_259f42e0:

#   ec "*Exhales deeply* But reclaiming what had been lost came with a heavy price."
    ec "*Exala profundamente* Mas recuperar o que havia sido perdido teve um preço alto."

# game/chapters/chapter6/ch6sc2.rpy:3217
translate brazil ch6sc2_c1e2a379:

#   ec "Most of our best war-maidens had been killed in the initial attack."
    ec "A maioria das nossas melhores guerreiras havia sido morta no ataque inicial."

# game/chapters/chapter6/ch6sc2.rpy:3218
translate brazil ch6sc2_9cfa481d:

#   ec "And many others lost their lives to the ongoing brutality of the abuse and rape."
    ec "E muitas outras pessoas perderam a vida devido à brutalidade contínua dos abusos e estupros."

# game/chapters/chapter6/ch6sc2.rpy:3219
translate brazil ch6sc2_05f311a9:

#   ec "My mother... she fell that night, too. The tribe's victory cost us both our A'khan and A'nu."
    ec "Minha mãe... ela também caiu naquela noite. A vitória da tribo nos custou tanto nosso A'khan quanto nosso A'nu."

# game/chapters/chapter6/ch6sc2.rpy:3221
translate brazil ch6sc2_08dd109a:

#   mc "Echo..."
    mc "Eco..."

# game/chapters/chapter6/ch6sc2.rpy:3222
translate brazil ch6sc2_c65ed896:

#   mc "You don't have to say any more."
    mc "Você não precisa dizer mais nada."

# game/chapters/chapter6/ch6sc2.rpy:3223
translate brazil ch6sc2_f33a5f42:

#   mc "I can tell its taking its toll on you."
    mc "Dá para perceber que isso está te afetando bastante."

# game/chapters/chapter6/ch6sc2.rpy:3225
translate brazil ch6sc2_2413edb7:

#   ec "It is alright."
    ec "Está tudo bem."

# game/chapters/chapter6/ch6sc2.rpy:3226
translate brazil ch6sc2_29d814fd:

#   ec "I- I must tell it."
    ec "Eu... eu preciso contar isso."

# game/chapters/chapter6/ch6sc2.rpy:3228
translate brazil ch6sc2_1dd15820:

#   ec "After the gruesome event was behind us, the tribe was never the same."
    ec "Após o terrível acontecimento, a tribo nunca mais foi a mesma."

# game/chapters/chapter6/ch6sc2.rpy:3229
translate brazil ch6sc2_eec9f0b3:

#   ec "Some women were unable to endure their traumas."
    ec "Algumas mulheres não conseguiram suportar seus traumas."

# game/chapters/chapter6/ch6sc2.rpy:3230
translate brazil ch6sc2_bc65c845:

#   ec "Those ones left to go into the jungle, never to return."
    ec "Aqueles que partiram para a selva, para nunca mais voltar."

# game/chapters/chapter6/ch6sc2.rpy:3232
translate brazil ch6sc2_4872f8a2:

#   ec "And a growing discontent amongst the survivors here in A’nai grew worse over time."
    ec "E o crescente descontentamento entre os sobreviventes aqui em A'nai piorou com o tempo."

# game/chapters/chapter6/ch6sc2.rpy:3234
translate brazil ch6sc2_a21a4862:

#   ec "Eventually, about half the tribe broke away and formed their own Tribe, the Arugoh."
    ec "Com o tempo, cerca de metade da tribo se separou e formou sua própria tribo, os Arugoh."

# game/chapters/chapter6/ch6sc2.rpy:3235
translate brazil ch6sc2_07dba37c:

#   ec "They settled to the north side of A'nai."
    ec "Eles se estabeleceram no lado norte de A'nai."

# game/chapters/chapter6/ch6sc2.rpy:3236
translate brazil ch6sc2_ec1e0496:

#   ec "Those who remained here in A’nai all agreed to hide ourselves away from the outside world."
    ec "Todos os que permaneceram aqui em A'nai concordaram em se esconder do mundo exterior."

# game/chapters/chapter6/ch6sc2.rpy:3237
translate brazil ch6sc2_e5a676b3:

#   ec "We forbade all outsiders from entering our territory, especially men."
    ec "Proibimos a entrada de todos os forasteiros em nosso território, especialmente homens."

# game/chapters/chapter6/ch6sc2.rpy:3239
translate brazil ch6sc2_a8ed1136:

#   ec "But the Arugoh felt this approach was too lenient."
    ec "Mas os Arugoh acharam essa abordagem muito branda."

# game/chapters/chapter6/ch6sc2.rpy:3240
translate brazil ch6sc2_32a97290:

#   ec "They believed outsiders should be enslaved in the same way that had been done to us."
    ec "Eles acreditavam que os forasteiros deveriam ser escravizados da mesma forma que nós fomos escravizados."

# game/chapters/chapter6/ch6sc2.rpy:3241
translate brazil ch6sc2_ba38741f:

#   ec "That all outsiders were evil."
    ec "Que todos os forasteiros eram maus."

# game/chapters/chapter6/ch6sc2.rpy:3243
translate brazil ch6sc2_7ccb816c:

#   mct "{i}Then the one who attacked our ship has to be from the Arugoh tribe.{/i}"
    mct "{i}Então, quem atacou nosso navio deve ser da tribo Arugoh.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:3245
translate brazil ch6sc2_aab2243e:

#   ec "They believe in attacking first, and I can’t honestly fault their reasons."
    ec "Eles acreditam em atacar primeiro, e sinceramente não posso criticar seus motivos."

# game/chapters/chapter6/ch6sc2.rpy:3247
translate brazil ch6sc2_6655c3f7:

#   ec "But, we don’t wish to carry such hatred."
    ec "Mas não desejamos nutrir esse ódio."

# game/chapters/chapter6/ch6sc2.rpy:3248
translate brazil ch6sc2_971ed42b:

#   ec "Instead, we chose to distance ourselves from the outside world."
    ec "Em vez disso, optamos por nos distanciar do mundo exterior."

# game/chapters/chapter6/ch6sc2.rpy:3250
translate brazil ch6sc2_c43efd8b:

#   ec "Most of the younger women in the tribe today, myself included, never suffered the horrors of that time."
    ec "A maioria das mulheres mais jovens da tribo hoje, incluindo eu mesma, nunca sofreu os horrores daquela época."

# game/chapters/chapter6/ch6sc2.rpy:3251
translate brazil ch6sc2_62f15e4b:

#   ec "I was only four or five summers when it happened, and most of the others you see around A'nai today were also too young."
    ec "Eu tinha apenas quatro ou cinco anos quando isso aconteceu, e a maioria das outras pessoas que você vê por aí em A'nai hoje também eram muito jovens."

# game/chapters/chapter6/ch6sc2.rpy:3252
translate brazil ch6sc2_2a761f7c:

#   ec "But our remaining elders did have to endure it."
    ec "Mas os nossos idosos restantes tiveram que suportar isso."

# game/chapters/chapter6/ch6sc2.rpy:3253
translate brazil ch6sc2_41abcc73:

#   ec "And they have taught us all the tales of the desecration."
    ec "E eles nos ensinaram todas as histórias da profanação."

# game/chapters/chapter6/ch6sc2.rpy:3255
translate brazil ch6sc2_7cf9f5c1:

#   ec "Which is why many are so wary of you."
    ec "É por isso que muitos desconfiam tanto de você."

# game/chapters/chapter6/ch6sc2.rpy:3256
translate brazil ch6sc2_43bf2e05:

#   ec "Both because you're an outsider and a man."
    ec "Tanto por você ser um forasteiro quanto por ser homem."

# game/chapters/chapter6/ch6sc2.rpy:3257
translate brazil ch6sc2_b5f5ec1a:

#   ec "You'd need to earn their respect, by proving yourself."
    ec "Você precisaria conquistar o respeito deles, provando o seu valor."

# game/chapters/chapter6/ch6sc2.rpy:3259
translate brazil ch6sc2_71d869b5:

#   mc "All that makes sense, but..."
    mc "Tudo isso faz sentido, mas..."

# game/chapters/chapter6/ch6sc2.rpy:3260
translate brazil ch6sc2_97d68ecf:

#   mc "Haven't there been any boys born into your tribe?"
    mc "Não nasceu nenhum menino na sua tribo?"

# game/chapters/chapter6/ch6sc2.rpy:3262
translate brazil ch6sc2_67ef7f7c:

#   ec "After the trauma that men had brought upon our tribe, the elders who took charge after my mother’s passing-"
    ec "Após o trauma que os homens infligiram à nossa tribo, os anciãos que assumiram o comando após o falecimento da minha mãe-"

# game/chapters/chapter6/ch6sc2.rpy:3263
translate brazil ch6sc2_21043298:

#   ec "-Decided that the boys would be sent to the neighboring island, to join the male tribes there."
    ec "-Decidiram que os meninos seriam enviados para a ilha vizinha, para se juntarem às tribos masculinas de lá."

# game/chapters/chapter6/ch6sc2.rpy:3265
translate brazil ch6sc2_92a13d56:

#   ec "And since no man has been here since... there have been no newborns for two decades."
    ec "E como nenhum homem esteve aqui desde então... não houve nascimentos nas últimas duas décadas."

# game/chapters/chapter6/ch6sc2.rpy:3266
translate brazil ch6sc2_4a67071f:

#   ec "*Sighs* No more of this, not tonight."
    ec "*Suspiro* Chega disso, não esta noite."

# game/chapters/chapter6/ch6sc2.rpy:3267
translate brazil ch6sc2_70de8a34:

#   ec "Discussing this has taken its toll on me."
    ec "Discutir isso me deixou exausto."

# game/chapters/chapter6/ch6sc2.rpy:3269
translate brazil ch6sc2_9d84a4c0:

#   mc "Hey, it's fine... Echo, you’re fine."
    mc "Ei, está tudo bem... Echo, você está bem."

# game/chapters/chapter6/ch6sc2.rpy:3270
translate brazil ch6sc2_93fe8a32:

#   mc "You’ve shared more with me than I could've expected... I had no idea your tribe had such a horrible past."
    mc "Você compartilhou mais comigo do que eu poderia esperar... Eu não fazia ideia de que sua tribo tinha um passado tão horrível."

# game/chapters/chapter6/ch6sc2.rpy:3272
translate brazil ch6sc2_d2d526ce:

#   ec "*Nods* Have I answered all your questions, then?"
    ec "*Acena com a cabeça* Respondi a todas as suas perguntas, então?"

# game/chapters/chapter6/ch6sc2.rpy:3274
translate brazil ch6sc2_ffe804b8:

#   mc "You have, Echo."
    mc "Você tem, Echo."

# game/chapters/chapter6/ch6sc2.rpy:3275
translate brazil ch6sc2_a58d16e1:

#   mc "Thank you for trusting me."
    mc "Obrigado por confiar em mim."

# game/chapters/chapter6/ch6sc2.rpy:3277
translate brazil ch6sc2_da7709b4:

#   ec "You’re different, [mc]... an outsider, true."
    ec "Você é diferente, [mc]... um forasteiro, sem dúvida."

# game/chapters/chapter6/ch6sc2.rpy:3278
translate brazil ch6sc2_e367e527:

#   ec "But you don’t harbor ill intent towards us... I can feel it."
    ec "Mas você não nutre más intenções contra nós... Eu posso sentir isso."

# game/chapters/chapter6/ch6sc2.rpy:3280
translate brazil ch6sc2_ebdbaa3c:

#   mc "I promise you, I don't have any bad intentions."
    mc "Eu prometo que não tenho nenhuma má intenção."

# game/chapters/chapter6/ch6sc2.rpy:3281
translate brazil ch6sc2_50cd3505:

#   mc "Once I find my friend, Pearl... if you would allow us to, I’d love to stay a bit and get to know more about you."
    mc "Assim que eu encontrar minha amiga, Pearl... se você permitir, adoraria ficar um pouco e conhecer você melhor."

# game/chapters/chapter6/ch6sc2.rpy:3283
translate brazil ch6sc2_b650a690:

#   ec "A-About me?"
    ec "Sobre mim?"

# game/chapters/chapter6/ch6sc2.rpy:3289
translate brazil ch6sc2_9099eb5e:

#   mc "Yes, Echo... I’d like to learn more about you."
    mc "Sim, Echo... Gostaria de saber mais sobre você."

# game/chapters/chapter6/ch6sc2.rpy:3291
translate brazil ch6sc2_4f0f8c55:

#   mc "You’re beautiful, strong, kind... getting to know you seems like something I’d enjoy."
    mc "Você é linda, forte, gentil... conhecê-la parece algo que eu gostaria de fazer."

# game/chapters/chapter6/ch6sc2.rpy:3292
translate brazil ch6sc2_da2c12f3:

#   "Echo is pleased with your compliment, her trust increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Echo ficou satisfeita com seu elogio, e sua confiança aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc2.rpy:3295
translate brazil ch6sc2_fa6a5488:

#   ec "*Shyly* It's getting a little hot in here..."
    ec "*Timidamente* Está ficando um pouco quente aqui..."

# game/chapters/chapter6/ch6sc2.rpy:3297
translate brazil ch6sc2_e533926d:

#   mc "*Chuckles* Was it something I said? I just thought I'd be straightforward with you."
    mc "*Risos* Será que eu disse algo errado? Só achei que seria melhor ser sincero com você."

# game/chapters/chapter6/ch6sc2.rpy:3298
translate brazil ch6sc2_061956be:

#   mc "One leader to another."
    mc "De um líder para outro."

# game/chapters/chapter6/ch6sc2.rpy:3300
translate brazil ch6sc2_f9918e06:

#   ec "At first I wasn't sure what to think about you, but you do seem like a capable leader."
    ec "No início, eu não sabia bem o que pensar de você, mas você parece ser um líder competente."

# game/chapters/chapter6/ch6sc2.rpy:3301
translate brazil ch6sc2_8fff2918:

#   ec "You're quite interesting! Genuine... strong... curious..."
    ec "Você é uma pessoa muito interessante! Genuína... forte... curiosa..."

# game/chapters/chapter6/ch6sc2.rpy:3303
translate brazil ch6sc2_df64221e:

#   "Echo likes that you're coming across as a strong leader, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Echo gosta que você esteja se mostrando um líder forte, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc2.rpy:3305
translate brazil ch6sc2_edd65b95:

#   ec "[mc]... I- I’m interested-"
    ec "[mc]... Eu... eu tenho interesse..."

# game/chapters/chapter6/ch6sc2.rpy:3313
translate brazil ch6sc2_e960857c:

#   mc "Yeah, I’d love to know more about your tribe, and your culture."
    mc "Sim, adoraria saber mais sobre sua tribo e sua cultura."

# game/chapters/chapter6/ch6sc2.rpy:3315
translate brazil ch6sc2_0371f3b0:

#   ec "Oh... yeah, I’m glad you’re interested in us. I’d allow you to sta-"
    ec "Ah... sim, fico feliz que você esteja interessado em nós. Eu permitiria que você começasse..."

# game/chapters/chapter6/ch6sc2.rpy:3321
translate brazil ch6sc2_2f14a891:

#   uk "Outsider! You dare trespass in our city and sacred temple?!"
    uk "Forasteiro! Você ousa invadir nossa cidade e templo sagrado?!"

# game/chapters/chapter6/ch6sc2.rpy:3325
translate brazil ch6sc2_b74bcaf7:

#   mc "*Whispers* {size=-10}{b}She seems nice.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Ela parece ser simpática.{/b}{/size}"

# game/chapters/chapter6/ch6sc2.rpy:3327
translate brazil ch6sc2_0f615de9:

#   ec "High-Priestess Marah..."
    ec "A Alta Sacerdotisa está furiosa..."

# game/chapters/chapter6/ch6sc2.rpy:3328
translate brazil ch6sc2_29f0ecc9:

#   ec "What are you doing in my bedchamber?"
    ec "O que você está fazendo no meu quarto?"

# game/chapters/chapter6/ch6sc2.rpy:3330
translate brazil ch6sc2_6d5230e7:

#   mh "What is this... this man... this outsider doing in your sacred bedchamber, A’nu?"
    mh "O que é este... este homem... este forasteiro fazendo em seu quarto sagrado, A'nu?"

# game/chapters/chapter6/ch6sc2.rpy:3331
translate brazil ch6sc2_a21f9991:

#   mh "And why is his devilish tongue so intimate with your name?"
    mh "E por que sua língua diabólica é tão íntima do seu nome?"

# game/chapters/chapter6/ch6sc2.rpy:3333
translate brazil ch6sc2_1cfb3a60:

#   ec "I’ve allowed him to use my name, he is my guest... Marah."
    ec "Eu permiti que ele usasse meu nome, ele é meu convidado... Marah."

# game/chapters/chapter6/ch6sc2.rpy:3334
translate brazil ch6sc2_14b067a8:

#   ec "And, his name is [mc]... not outsider."
    ec "E o nome dele é [mc]... não um forasteiro."

# game/chapters/chapter6/ch6sc2.rpy:3336
translate brazil ch6sc2_9044312a:

#   mh "Do you not remember our suffering? The horrors we had to endure?"
    mh "Vocês não se lembram do nosso sofrimento? Dos horrores que tivemos que suportar?"

# game/chapters/chapter6/ch6sc2.rpy:3337
translate brazil ch6sc2_70b63e6d:

#   mh "The softened version of {b}our{/b} past you just told this... outsider, does not reflect the true horror."
    mh "A versão suavizada de {b} nosso{/b} O que você acabou de dizer... de um forasteiro, não reflete o verdadeiro horror."

# game/chapters/chapter6/ch6sc2.rpy:3339
translate brazil ch6sc2_bfc9aa2f:

#   mh "Tsk! Outsider! Do you wish to hear what really happened?"
    mh "Tsc! Forasteiro! Deseja ouvir o que realmente aconteceu?"

# game/chapters/chapter6/ch6sc2.rpy:3341
translate brazil ch6sc2_8fbccdab:

#   mc "I have a feeling you’ll tell me either way..."
    mc "Tenho a impressão de que você vai me dizer de qualquer jeito..."

# game/chapters/chapter6/ch6sc2.rpy:3343
translate brazil ch6sc2_7d68a71d:

#   mh "Right you are... Let me enlighten you."
    mh "Você tem razão... Deixe-me esclarecer."

# game/chapters/chapter6/ch6sc2.rpy:3344
translate brazil ch6sc2_99b1224c:

#   mh "What A’nu has told you was true, but she neglected to tell you how truly horrific it was."
    mh "O que A'nu lhe contou era verdade, mas ela omitiu o quão verdadeiramente horrível foi."

# game/chapters/chapter6/ch6sc2.rpy:3346
translate brazil ch6sc2_514abe93:

#   ec "I didn't feel it necessary to share every vile detail with him."
    ec "Não achei necessário compartilhar com ele todos os detalhes sórdidos."

# game/chapters/chapter6/ch6sc2.rpy:3347
translate brazil ch6sc2_99a8dd66:

#   ec "He understands enough of the tale."
    ec "Ele entende o suficiente da história."

# game/chapters/chapter6/ch6sc2.rpy:3349
translate brazil ch6sc2_86bffe2e:

#   mh "And, why would you feel that way? Why would you spare him all the details?"
    mh "E por que você se sentiria assim? Por que omitiria todos os detalhes?"

# game/chapters/chapter6/ch6sc2.rpy:3351
translate brazil ch6sc2_4aad174e:

#   ec "Because... he is nothing like them."
    ec "Porque... ele não se parece em nada com eles."

# game/chapters/chapter6/ch6sc2.rpy:3352
translate brazil ch6sc2_62db534a:

#   ec "[mc] is respectful and kind!"
    ec "[mc] É respeitoso e gentil!"

# game/chapters/chapter6/ch6sc2.rpy:3355
translate brazil ch6sc2_abd0cb17:

#   ec "He is a strong leader, I can sense it..."
    ec "Ele é um líder forte, eu consigo sentir isso..."

# game/chapters/chapter6/ch6sc2.rpy:3356
translate brazil ch6sc2_a030dcf5:

#   ec "He's a Captain! Of a great ship called the Bloody Banshee!"
    ec "Ele é um capitão! De um grande navio chamado Banshee Sangrenta!"

# game/chapters/chapter6/ch6sc2.rpy:3359
translate brazil ch6sc2_eac06e07:

#   ec "And he's..."
    ec "E ele é..."

# game/chapters/chapter6/ch6sc2.rpy:3361
translate brazil ch6sc2_55310869:

#   ec "He is curious, he is filled with wonder, and he wishes to learn about us, Marah."
    ec "Ele é curioso, está cheio de admiração e deseja aprender sobre nós, Marah."

# game/chapters/chapter6/ch6sc2.rpy:3363
translate brazil ch6sc2_780f63ff:

#   mh "How quickly you forget!"
    mh "Como você esquece rápido!"

# game/chapters/chapter6/ch6sc2.rpy:3364
translate brazil ch6sc2_45a14d43:

#   mh "He only fakes it in order to conquer us!"
    mh "Ele só finge para nos conquistar!"

# game/chapters/chapter6/ch6sc2.rpy:3366
translate brazil ch6sc2_616cea2c:

#   mh "Outsiders only know of conquest and inflicting pain."
    mh "Quem está de fora só conhece a conquista e a arte de infligir dor."

# game/chapters/chapter6/ch6sc2.rpy:3367
translate brazil ch6sc2_c131ff10:

#   mh "They will enslave us again if we give them the chance."
    mh "Eles nos escravizarão novamente se lhes dermos a oportunidade."

# game/chapters/chapter6/ch6sc2.rpy:3369
translate brazil ch6sc2_c02e6108:

#   mh "Our great A’Khan was slain like a beast!"
    mh "Nosso grande A'Khan foi morto como uma fera!"

# game/chapters/chapter6/ch6sc2.rpy:3370
translate brazil ch6sc2_66156396:

#   mh "They didn’t just beat and brutalize him in front of everyone. No..."
    mh "Eles não apenas o espancaram e brutalizaram na frente de todos. Não..."

# game/chapters/chapter6/ch6sc2.rpy:3372
translate brazil ch6sc2_d775879b:

#   mh "They learned that he had a wife, Echo’s mother."
    mh "Descobriram que ele tinha uma esposa, a mãe de Echo."

# game/chapters/chapter6/ch6sc2.rpy:3373
translate brazil ch6sc2_c9d7a666:

#   mh "So they brought her to him and commanded her to stab him to death with a dull blade."
    mh "Então a trouxeram até ele e ordenaram que ela o esfaqueasse até a morte com uma lâmina cega."

# game/chapters/chapter6/ch6sc2.rpy:3375
translate brazil ch6sc2_f26ea4fc:

#   ec "High-Priestess!"
    ec "Alta Sacerdotisa!"

# game/chapters/chapter6/ch6sc2.rpy:3377
translate brazil ch6sc2_a9a96081:

#   mh "He must hear it to truly understand."
    mh "Ele precisa ouvir para realmente entender."

# game/chapters/chapter6/ch6sc2.rpy:3379
translate brazil ch6sc2_442f3ee9:

#   mh "Of course, she refused to commit this horrific crime against the man she loved."
    mh "É claro que ela se recusou a cometer esse crime horrível contra o homem que amava."

# game/chapters/chapter6/ch6sc2.rpy:3381
translate brazil ch6sc2_2691f2fc:

#   mh "So, to force our beloved queen, our A’nu, to commit this terrible act, they dragged out a woman from the tribe."
    mh "Então, para forçar nossa amada rainha, nossa A'nu, a cometer esse ato terrível, eles arrastaram uma mulher da tribo."

# game/chapters/chapter6/ch6sc2.rpy:3382
translate brazil ch6sc2_a62e1096:

#   mh "They threw her down next to our A’Khan..."
    mh "Eles a jogaram ao lado do nosso A'Khan..."

# game/chapters/chapter6/ch6sc2.rpy:3383
translate brazil ch6sc2_b5faff72:

#   mh "They beat her, and raped her into the dirt. And for each hour that our Queen refused-"
    mh "Eles a espancaram e a estupraram até deixá-la imunda. E por cada hora que nossa Rainha se recusou..."

# game/chapters/chapter6/ch6sc2.rpy:3385
translate brazil ch6sc2_5b6e7727:

#   mh "-Another women would be brought out... and so it went on."
    mh "-Outra mulher era trazida... e assim continuava."

# game/chapters/chapter6/ch6sc2.rpy:3386
translate brazil ch6sc2_71571817:

#   mh "Our queen wept in horror at the choice she faced."
    mh "Nossa rainha chorou horrorizada diante da escolha que tinha pela frente."

# game/chapters/chapter6/ch6sc2.rpy:3387
translate brazil ch6sc2_8e9973e7:

#   mh "She knew that killing her beloved, her husband, her A’Khan..."
    mh "Ela sabia que matar seu amado, seu marido, seu A'Khan..."

# game/chapters/chapter6/ch6sc2.rpy:3388
translate brazil ch6sc2_48fd5bc0:

#   mh "The father of her child... was the only way to stop her tribe from suffering."
    mh "O pai de seu filho... era a única maneira de impedir o sofrimento de sua tribo."

# game/chapters/chapter6/ch6sc2.rpy:3390
translate brazil ch6sc2_17c1c711:

#   mh "Our A'khan was barely able to speak after his brutalization."
    mh "Nosso A'khan mal conseguia falar após a brutalidade que sofreu."

# game/chapters/chapter6/ch6sc2.rpy:3391
translate brazil ch6sc2_e94f0e73:

#   mh "But he pleaded with her to kill him and spare the women."
    mh "Mas ele implorou para que ela o matasse e poupasse as mulheres."

# game/chapters/chapter6/ch6sc2.rpy:3392
translate brazil ch6sc2_22b38312:

#   mh "The whole village bore witness to it all."
    mh "Toda a aldeia testemunhou tudo."

# game/chapters/chapter6/ch6sc2.rpy:3393
translate brazil ch6sc2_7d8d682a:

#   mh "She finally took the dull dagger and shakily tried to stab Echo’s father."
    mh "Ela finalmente pegou a adaga sem fio e, trêmula, tentou esfaquear o pai de Echo."

# game/chapters/chapter6/ch6sc2.rpy:3395
translate brazil ch6sc2_c90dafcb:

#   ec "Please... no more."
    ec "Por favor... chega."

# game/chapters/chapter6/ch6sc2.rpy:3396
translate brazil ch6sc2_90850927:

#   ec "He... he understands."
    ec "Ele... ele entende."

# game/chapters/chapter6/ch6sc2.rpy:3398
translate brazil ch6sc2_ea30c58b:

#   mh "Luckily, Echo was only a youngling nearing her fifth summer."
    mh "Por sorte, Echo era apenas uma jovem prestes a completar cinco verões."

# game/chapters/chapter6/ch6sc2.rpy:3399
translate brazil ch6sc2_f4b86fe1:

#   mh "So she wasn't brought out to witness the horror."
    mh "Então ela não foi trazida para testemunhar o horror."

# game/chapters/chapter6/ch6sc2.rpy:3400
translate brazil ch6sc2_68593b64:

#   mh "Our queen’s first attempt at stabbing her husband failed."
    mh "A primeira tentativa da nossa rainha de esfaquear o marido falhou."

# game/chapters/chapter6/ch6sc2.rpy:3401
translate brazil ch6sc2_e438089e:

#   mh "The blade was so dull, and her strength and determination was lacking."
    mh "A lâmina estava tão cega, e ela não tinha força nem determinação."

# game/chapters/chapter6/ch6sc2.rpy:3403
translate brazil ch6sc2_38270558:

#   mh "So, another woman was brought out..."
    mh "Então, outra mulher foi trazida..."

# game/chapters/chapter6/ch6sc2.rpy:3404
translate brazil ch6sc2_ba560d01:

#   mh "And it began again."
    mh "E tudo recomeçou."

# game/chapters/chapter6/ch6sc2.rpy:3406
translate brazil ch6sc2_184aa0e3:

#   mh "Our A'nu screamed in agony as she thrust the blade harder into her husband’s chest."
    mh "Nossa A'nu gritou de agonia enquanto cravava a lâmina com mais força no peito do marido."

# game/chapters/chapter6/ch6sc2.rpy:3407
translate brazil ch6sc2_53e2a314:

#   mh "This time, piercing the skin."
    mh "Desta vez, perfurando a pele."

# game/chapters/chapter6/ch6sc2.rpy:3409
translate brazil ch6sc2_73af0fec:

#   mh "But the usurpers just laughed and shouted at her to try again, while they continued to assault the woman next to her."
    mh "Mas os usurpadores apenas riram e gritaram para ela tentar novamente, enquanto continuavam a agredir a mulher ao lado dela."

# game/chapters/chapter6/ch6sc2.rpy:3411
translate brazil ch6sc2_85f4d19d:

#   mh "Her husband kept yelling at her to just do it, to end it. And she stabbed him again."
    mh "O marido dela não parava de gritar para ela fazer aquilo, para acabar com tudo. E ela o esfaqueou de novo."

# game/chapters/chapter6/ch6sc2.rpy:3412
translate brazil ch6sc2_6aed5f75:

#   mh "*Mimics* {b}'Again, do it again, bitch! Finish him! Once more!'{/b}... they yelled these things even as they abused the women."
    mh "*Imita* {b}'De novo, faça de novo, vadia! Acabe com ele! Mais uma vez!'{/b}...eles gritavam essas coisas enquanto abusavam das mulheres."

# game/chapters/chapter6/ch6sc2.rpy:3413
translate brazil ch6sc2_96ddedad:

#   mh "Eventually, her eyes glazed over, and her weeping stopped, and she stabbed her husband over and over again."
    mh "Por fim, seus olhos se vidraram, seu choro cessou e ela esfaqueou o marido repetidas vezes."

# game/chapters/chapter6/ch6sc2.rpy:3415
translate brazil ch6sc2_56b48a70:

#   mh "Until she was left stabbing only a lifeless corpse."
    mh "Até que restou apenas ela esfaqueando um cadáver sem vida."

# game/chapters/chapter6/ch6sc2.rpy:3416
translate brazil ch6sc2_b181dadd:

#   mh "The stabbing didn’t stop until she couldn’t lift her arm anymore."
    mh "As facadas só pararam quando ela não conseguiu mais levantar o braço."

# game/chapters/chapter6/ch6sc2.rpy:3417
translate brazil ch6sc2_160876ce:

#   mh "And then, to everyone's horror... the bastards didn’t stop!"
    mh "E então, para horror de todos... os desgraçados não pararam!"

# game/chapters/chapter6/ch6sc2.rpy:3418
translate brazil ch6sc2_952af2f4:

#   mh "They kept taking turns on the woman next to our queen."
    mh "Eles se revezavam para assediar a mulher ao lado da nossa rainha."

# game/chapters/chapter6/ch6sc2.rpy:3420
translate brazil ch6sc2_9061364c:

#   mh "The whole village wept as we witnessed what you outsiders are capable of!"
    mh "Toda a aldeia chorou ao testemunharmos do que vocês, forasteiros, são capazes!"

# game/chapters/chapter6/ch6sc2.rpy:3422
translate brazil ch6sc2_2bcd50a5:

#   ec "Marah, no more... please."
    ec "Marah, chega... por favor."

# game/chapters/chapter6/ch6sc2.rpy:3423
translate brazil ch6sc2_b5f87bdc:

#   mh "Worry not, sweet Echo. The tale is over."
    mh "Não se preocupe, querida Echo. A história acabou."

# game/chapters/chapter6/ch6sc2.rpy:3425
translate brazil ch6sc2_92091a98:

#   mh "I will not let this man harm you or anyone else in our tribe."
    mh "Não permitirei que esse homem faça mal a você ou a qualquer outra pessoa da nossa tribo."

# game/chapters/chapter6/ch6sc2.rpy:3427
translate brazil ch6sc2_2eee40c4:

#   mh "Outsider, come."
    mh "Forasteiro, entre."

# game/chapters/chapter6/ch6sc2.rpy:3428
translate brazil ch6sc2_1ad1e882:

#   mh "Now that you know our history, it’s time you saw it for yourself."
    mh "Agora que você conhece nossa história, é hora de vê-la com seus próprios olhos."

# game/chapters/chapter6/ch6sc2.rpy:3430
translate brazil ch6sc2_7b59bc97:

#   mc "See what?"
    mc "Veja o quê?"

# game/chapters/chapter6/ch6sc2.rpy:3432
translate brazil ch6sc2_e02ae244:

#   mh "The dungeons below the temple..."
    mh "As masmorras abaixo do templo..."

# game/chapters/chapter6/ch6sc2.rpy:3433
translate brazil ch6sc2_931c1890:

#   mh "Nobody has had the strength to restore them to their former purpose. There is too much... pain."
    mh "Ninguém teve forças para restaurá-los à sua função original. Há muita... dor."

# game/chapters/chapter6/ch6sc2.rpy:3435
translate brazil ch6sc2_01a072b2:

#   mh "A’nu, Outsider... come."
    mh "A'nu, forasteiro... venha."

# game/chapters/chapter6/ch6sc2.rpy:3437
translate brazil ch6sc2_e3603cd1:

#   ec "L-Let's go..."
    ec "Vamos lá..."

# game/chapters/chapter6/ch6sc2.rpy:3440
translate brazil ch6sc2_3a88a8fa:

#   "And so you and Echo follows Marah down into the depths of the temple."
    "E assim você e Echo seguem Marah até as profundezas do templo."

# game/chapters/chapter6/ch6sc2.rpy:3443
translate brazil ch6sc2_665e3f1b:

#   mc "*Whispers* {size=-10}{b}Echo... what is this place?{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Eco... que lugar é este?{/b}{/size}"

# game/chapters/chapter6/ch6sc2.rpy:3445
translate brazil ch6sc2_751cb013:

#   ec "*Quietly* {size=-10}{b}Sshh... [mc], do not speak... not here.{/b}{/size}"
    ec "*Em silêncio* {size=-10}{b}Shhh... [mc] Não fale... não aqui.{/b}{/size}"

# game/chapters/chapter6/ch6sc2.rpy:3446
translate brazil ch6sc2_8ffab070:

#   ec "*Quietly* {size=-10}{b}These are the sacred halls of the temple that were turned into our prison.{/b}{/size}"
    ec "*Em silêncio* {size=-10}{b}Estas são as salas sagradas do templo que foram transformadas em nossa prisão.{/b}{/size}"

# game/chapters/chapter6/ch6sc2.rpy:3448
translate brazil ch6sc2_54a94d3f:

#   mh "This is where we used to worship the goddesses, to pray for their guidance and blessings."
    mh "Era aqui que costumávamos venerar as deusas, para rezar pedindo sua orientação e bênçãos."

# game/chapters/chapter6/ch6sc2.rpy:3449
translate brazil ch6sc2_10cebe72:

#   mh "One of our most sacred places, now defiled by outsiders... desecrated beyond recognition."
    mh "Um dos nossos lugares mais sagrados, agora profanado por forasteiros... desrespeitado a ponto de ficar irreconhecível."

# game/chapters/chapter6/ch6sc2.rpy:3451
translate brazil ch6sc2_e33cf5ce:

#   mh "Your kind doesn’t belong here. You shouldn’t be allowed anywhere near this place."
    mh "Gente como você não pertence a este lugar. Vocês não deveriam ter permissão para chegar perto daqui."

# game/chapters/chapter6/ch6sc2.rpy:3452
translate brazil ch6sc2_992562f3:

#   mh "But our A’nu, Echo, she insists that you learn about us. And so you shall. With your own eyes."
    mh "Mas nossa A'nu, Echo, insiste que você aprenda sobre nós. E assim você fará. Com seus próprios olhos."

# game/chapters/chapter6/ch6sc2.rpy:3454
translate brazil ch6sc2_fc61eee2:

#   mh "See the conditions that we suffered! That we were subjected to!"
    mh "Vejam as condições que sofremos! Às quais fomos submetidos!"

# game/chapters/chapter6/ch6sc2.rpy:3455
translate brazil ch6sc2_6d8be0bd:

#   mh "Witness what your kind does! What was done to us!"
    mh "Testemunhem o que a sua espécie faz! O que fizeram conosco!"

# game/chapters/chapter6/ch6sc2.rpy:3457
translate brazil ch6sc2_baab7f1d:

#   mh "Tormented... kept in cages like animals... only taken out when they..."
    mh "Atormentados... mantidos em gaiolas como animais... só são retirados quando..."

# game/chapters/chapter6/ch6sc2.rpy:3459
translate brazil ch6sc2_bd6645c9:

#   mh "When they wanted to do... horrible... perverse things to us."
    mh "Quando eles queriam fazer... coisas horríveis... perversas conosco."

# game/chapters/chapter6/ch6sc2.rpy:3461
translate brazil ch6sc2_bd62fac1:

#   mh "Hours became days, days became weeks, moons came and passed... no end to being their playthings!"
    mh "Horas se transformaram em dias, dias em semanas, luas vieram e se foram... e não havia fim para serem seus brinquedos!"

# game/chapters/chapter6/ch6sc2.rpy:3462
translate brazil ch6sc2_0039cbb3:

#   mh "We vowed to never let it happen again."
    mh "Juramos que isso nunca mais aconteceria."

# game/chapters/chapter6/ch6sc2.rpy:3463
translate brazil ch6sc2_926cbc1b:

#   mh "That those we lost would not have died in vain."
    mh "Para que aqueles que perdemos não tenham morrido em vão."

# game/chapters/chapter6/ch6sc2.rpy:3465
translate brazil ch6sc2_b0c9796f:

#   mh "Echo’s mother was only a shell of her former self after what she endured..."
    mh "A mãe de Echo era apenas uma sombra do que fora depois de tudo o que passou..."

# game/chapters/chapter6/ch6sc2.rpy:3466
translate brazil ch6sc2_23805834:

#   mh "But, after several months, she somehow found the strength to rally the others. We finally managed to reclaim our freedom and home."
    mh "Mas, depois de vários meses, ela de alguma forma encontrou forças para reunir os outros. Finalmente conseguimos recuperar nossa liberdade e nosso lar."

# game/chapters/chapter6/ch6sc2.rpy:3467
translate brazil ch6sc2_be897715:

#   mh "She saved us all. She even saved me..."
    mh "Ela nos salvou a todos. Ela até me salvou..."

# game/chapters/chapter6/ch6sc2.rpy:3468
translate brazil ch6sc2_8dc4d516:

#   mh "I was 26 summers at the time... The night of our rebellion was the first time-"
    mh "Eu tinha 26 anos na época... A noite da nossa rebelião foi a primeira vez..."

# game/chapters/chapter6/ch6sc2.rpy:3470
translate brazil ch6sc2_aad43723:

#   mh "I had been removed from my cage."
    mh "Eu havia sido retirado da minha gaiola."

# game/chapters/chapter6/ch6sc2.rpy:3471
translate brazil ch6sc2_b25872c5:

#   mh "They had decided it was my time to become their... plaything."
    mh "Eles decidiram que era a minha vez de me tornar o... brinquedo deles."

# game/chapters/chapter6/ch6sc2.rpy:3472
translate brazil ch6sc2_d16e71be:

#   mh "I was fortunate enough that they speared the man just before he had his way with me."
    mh "Tive a sorte de eles terem atingido o homem com uma lança pouco antes que ele pudesse abusar de mim."

# game/chapters/chapter6/ch6sc2.rpy:3476
translate brazil ch6sc2_7e54b91c:

#   mc "Marah, I'm sorry for what happened to your people all those years ago."
    mc "Marah, sinto muito pelo que aconteceu com seu povo todos esses anos atrás."

# game/chapters/chapter6/ch6sc2.rpy:3477
translate brazil ch6sc2_a0e9df00:

#   mc "Some people are scum, who will take advantage of others."
    mc "Algumas pessoas são escória, que se aproveitam dos outros."

# game/chapters/chapter6/ch6sc2.rpy:3478
translate brazil ch6sc2_dc8d2852:

#   mc "Doesn't matter if they were born on the mainland or on an island."
    mc "Não importa se nasceram no continente ou numa ilha."

# game/chapters/chapter6/ch6sc2.rpy:3480
translate brazil ch6sc2_d11079e0:

#   mh "Hmph, on that we can agree."
    mh "Hum, nisso podemos concordar."

# game/chapters/chapter6/ch6sc2.rpy:3482
translate brazil ch6sc2_cbf1e3e1:

#   mh "But if you think-"
    mh "Mas se você pensar-"

# game/chapters/chapter6/ch6sc2.rpy:3483
translate brazil ch6sc2_e11f6409:

#   mc "I know what kind of man I am, I did not come here to harm anyone."
    mc "Eu sei que tipo de homem sou, não vim aqui para prejudicar ninguém."

# game/chapters/chapter6/ch6sc2.rpy:3484
translate brazil ch6sc2_93b53736:

#   mc "I didn't even know this place existed until I woke up in a tent here... chained."
    mc "Eu nem sabia que este lugar existia até acordar aqui, numa tenda... acorrentado."

# game/chapters/chapter6/ch6sc2.rpy:3487
translate brazil ch6sc2_6f057e9f:

#   mh "*Scoffs* Your words..."
    mh "*Zomba* Suas palavras..."

# game/chapters/chapter6/ch6sc2.rpy:3488
translate brazil ch6sc2_c50e26e6:

#   "Marah detects a sliver of truth in your words, her trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Marah percebe um resquício de verdade em suas palavras, e sua confiança aumentou. {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc2.rpy:3489
translate brazil ch6sc2_39e76683:

#   mh "No! Your words are venomous!"
    mh "Não! Suas palavras são venenosas!"

# game/chapters/chapter6/ch6sc2.rpy:3490
translate brazil ch6sc2_e357663d:

#   mh "We lost our precious A'nu... we lost nearly half the tribe..."
    mh "Perdemos nosso precioso A'nu... perdemos quase metade da tribo..."

# game/chapters/chapter6/ch6sc2.rpy:3495
translate brazil ch6sc2_63ecc01f:

#   mc "I agree some 'outsiders' would have bad intentions if they found your tribe."
    mc "Concordo que alguns \"forasteiros\" teriam más intenções se encontrassem sua tribo."

# game/chapters/chapter6/ch6sc2.rpy:3496
translate brazil ch6sc2_ae401280:

#   mc "But I'm not-"
    mc "Mas eu não sou-"

# game/chapters/chapter6/ch6sc2.rpy:3498
translate brazil ch6sc2_0a3e1e42:

#   mh "'But you're not like them'? *Scoffs* Do you think us fools!?"
    mh "'Mas você não é como eles'? *Zomba* Você acha que somos tolos!?"

# game/chapters/chapter6/ch6sc2.rpy:3499
translate brazil ch6sc2_e08de4a7:

#   "Your {color=#87e1fa}Charisma{/color} was too low to gain any trust from Marah."
    "Seu {color=#87e1fa} Carisma{/color} era muito baixo para ganhar a confiança de Marah."

# game/chapters/chapter6/ch6sc2.rpy:3504
translate brazil ch6sc2_58a6e021:

#   mh "Now her daughter, our A'nu, is too eager to forget the past and has allowed you inside our home."
    mh "Agora, sua filha, nossa A'nu, está ansiosa demais para esquecer o passado e permitiu que você entrasse em nossa casa."

# game/chapters/chapter6/ch6sc2.rpy:3506
translate brazil ch6sc2_5d937d7d:

#   ec "Marah, I do not forget the past, but I also don’t desire to live trapped within it."
    ec "Marah, eu não esqueço o passado, mas também não desejo viver presa a ele."

# game/chapters/chapter6/ch6sc2.rpy:3507
translate brazil ch6sc2_768a2ce3:

#   ec "Things are not the same, time has passed, decades..."
    ec "As coisas não são mais as mesmas, o tempo passou, décadas..."

# game/chapters/chapter6/ch6sc2.rpy:3509
translate brazil ch6sc2_7eda9b97:

#   mh "Nothing has changed! He’s an outsider!"
    mh "Nada mudou! Ele é um forasteiro!"

# game/chapters/chapter6/ch6sc2.rpy:3511
translate brazil ch6sc2_84ffc4d0:

#   ec "He comes with good intentions, he is not like the ones from our past."
    ec "Ele vem com boas intenções, não é como os do nosso passado."

# game/chapters/chapter6/ch6sc2.rpy:3513
translate brazil ch6sc2_5025a26f:

#   mh "How can you be so sure of that?"
    mh "Como você pode ter tanta certeza disso?"

# game/chapters/chapter6/ch6sc2.rpy:3514
translate brazil ch6sc2_03b34197:

#   mh "You have only known this man for a day!"
    mh "Você só conhece esse homem há um dia!"

# game/chapters/chapter6/ch6sc2.rpy:3516
translate brazil ch6sc2_ad165110:

#   ec "Because... he and I have talked."
    ec "Porque... ele e eu já conversamos."

# game/chapters/chapter6/ch6sc2.rpy:3517
translate brazil ch6sc2_a30d0a4c:

#   ec "We’ve spoken a great deal since his arrival... I believe he has a pure heart."
    ec "Temos conversado bastante desde a sua chegada... Acredito que ele tenha um coração puro."

# game/chapters/chapter6/ch6sc2.rpy:3520
translate brazil ch6sc2_7f96f89b:

#   mh "*Laughs in disbelief* Hahahah! You can’t possibly be that naive?"
    mh "*Risos incrédulos* Hahaha! Você não pode ser tão ingênuo assim, né?"

# game/chapters/chapter6/ch6sc2.rpy:3522
translate brazil ch6sc2_2c523812:

#   mh "Outsiders are demons... wolves dressed up as sheep."
    mh "Os forasteiros são demônios... lobos em pele de cordeiro."

# game/chapters/chapter6/ch6sc2.rpy:3523
translate brazil ch6sc2_dec15187:

#   mh "They only speak lies... their true intentions shrouded in shadows."
    mh "Eles só falam mentiras... suas verdadeiras intenções estão envoltas em sombras."

# game/chapters/chapter6/ch6sc2.rpy:3525
translate brazil ch6sc2_e051417a:

#   mh "Outsider, do you know what their leader said just before we drove our spears through him?"
    mh "Forasteiro, você sabe o que o líder deles disse momentos antes de cravarmos nossas lanças nele?"

# game/chapters/chapter6/ch6sc2.rpy:3526
translate brazil ch6sc2_1f53aab2:

#   mc "I don’t imagine he had anything nice to say?"
    mc "Não imagino que ele tenha tido algo de bom a dizer."

# game/chapters/chapter6/ch6sc2.rpy:3527
translate brazil ch6sc2_a4e98be2:

#   mh "*Scoffs* No, he certainly didn’t."
    mh "*Risos* Não, certamente não."

# game/chapters/chapter6/ch6sc2.rpy:3529
translate brazil ch6sc2_82f598ea:

#   mh "He vowed he'd return to finish what he had started... to finish conquering us."
    mh "Ele jurou que voltaria para terminar o que havia começado... para terminar de nos conquistar."

# game/chapters/chapter6/ch6sc2.rpy:3530
translate brazil ch6sc2_e697622e:

#   mh "To enslave us and take away our freedom forever."
    mh "Para nos escravizar e nos privar da nossa liberdade para sempre."

# game/chapters/chapter6/ch6sc2.rpy:3532
translate brazil ch6sc2_aebaa2f5:

#   ec "Marah, you saw him die with your own eyes."
    ec "Marah, você o viu morrer com seus próprios olhos."

# game/chapters/chapter6/ch6sc2.rpy:3533
translate brazil ch6sc2_c37c5647:

#   ec "His corpse was burned... you cannot believe that he can return."
    ec "Seu cadáver foi queimado... você não consegue acreditar que ele possa voltar."

# game/chapters/chapter6/ch6sc2.rpy:3535
translate brazil ch6sc2_16688a6e:

#   mh "Whether he returns in his physical form, or as a spirit disguised in another form, I am certain that his malign will endures."
    mh "Quer ele retorne em sua forma física, quer como um espírito disfarçado em outra forma, tenho certeza de que sua vontade maligna perdurará."

# game/chapters/chapter6/ch6sc2.rpy:3536
translate brazil ch6sc2_86b99bc0:

#   mh "His will to defile and dominate, to desecrate and ruin, it lives on in this outsider!"
    mh "Sua vontade de profanar e dominar, de desrespeitar e arruinar, continua viva neste forasteiro!"

# game/chapters/chapter6/ch6sc2.rpy:3538
translate brazil ch6sc2_785c0a98:

#   mh "Letting them enslave us, letting them destroy our sacred temple and ruin our tributes to the goddesses... it’s a bad omen."
    mh "Deixar que nos escravizem, que destruam nosso templo sagrado e arruinem nossas oferendas às deusas... é um mau presságio."

# game/chapters/chapter6/ch6sc2.rpy:3539
translate brazil ch6sc2_f6ce64a6:

#   mh "Why else did the magic abandon our people after the desecration? We’ve been cursed."
    mh "Por que mais a magia teria abandonado nosso povo após a profanação? Fomos amaldiçoados."

# game/chapters/chapter6/ch6sc2.rpy:3541
translate brazil ch6sc2_089edc84:

#   mh "Yet, you still bring an outsider to our very home."
    mh "No entanto, você ainda traz um estranho para dentro da nossa própria casa."

# game/chapters/chapter6/ch6sc2.rpy:3542
translate brazil ch6sc2_a0bedb67:

#   mh "You ignore the curse put on us? Do you seek to have the past repeat itself?"
    mh "Você ignora a maldição que nos foi imposta? Deseja que o passado se repita?"

# game/chapters/chapter6/ch6sc2.rpy:3543
translate brazil ch6sc2_cff824e4:

#   mh "Naive child! If only you had been older when it happened, then you would take it more seriously."
    mh "Criança ingênua! Se você fosse mais velha quando isso aconteceu, levaria a situação mais a sério."

# game/chapters/chapter6/ch6sc2.rpy:3546
translate brazil ch6sc2_e3400c93:

#   ec "{b}Marah!{/b} I’m no child and you’re overstepping!"
    ec "{b}Marah!{/b} Eu não sou criança e você está ultrapassando os limites!"

# game/chapters/chapter6/ch6sc2.rpy:3548
translate brazil ch6sc2_05b7f985:

#   mh "Outsider... come, there is something else you must see."
    mh "Forasteiro... venha, há algo mais que você precisa ver."

# game/chapters/chapter6/ch6sc2.rpy:3549
translate brazil ch6sc2_2d64bae0:

#   mh "The one place they didn’t manage to defile, our last sacred place... is tucked away."
    mh "O único lugar que eles não conseguiram profanar, nosso último lugar sagrado... está escondido."

# game/chapters/chapter6/ch6sc2.rpy:3551
translate brazil ch6sc2_9bbb6fc6:

#   mh "See the shimmering light from the tunnel? Our last remnant of the past."
    mh "Consegue ver a luz cintilante vinda do túnel? É o nosso último vestígio do passado."

# game/chapters/chapter6/ch6sc2.rpy:3552
translate brazil ch6sc2_e1399e02:

#   mh "Since we’re breaking tradition, you might as well see it for yourself."
    mh "Já que estamos quebrando a tradição, você pode muito bem ver com seus próprios olhos."

# game/chapters/chapter6/ch6sc2.rpy:3554
translate brazil ch6sc2_d8e5267e:

#   ec "Marah, what is the meaning of thi-"
    ec "Marah, qual é o significado disso?"

# game/chapters/chapter6/ch6sc2.rpy:3556
translate brazil ch6sc2_5baa1ec9:

#   mc "Hmm, I do sense magic flowing up from inside this shaft..."
    mc "Hum, sinto que algo mágico emana de dentro deste poço..."

# game/chapters/chapter6/ch6sc2.rpy:3557
translate brazil ch6sc2_f22443b2:

#   mh "If you will not protect our tribe, I will!"
    mh "Se vocês não protegerem nossa tribo, eu o farei!"

# game/chapters/chapter6/ch6sc2.rpy:3560
translate brazil ch6sc2_1aebfcfe:

#   ec "{b}[mc]!!{/b}"
    ec "{b}[mc]!!{/b}"

# game/chapters/chapter6/ch6sc2.rpy:3561
translate brazil ch6sc2_f6d5c7f9:

#   "You manage to dodge her shove. But she flings opens her palm... releasing a powdery cloud into your face."
    "Você consegue se esquivar do empurrão dela. Mas ela abre a palma da mão... liberando uma nuvem de pó no seu rosto."

# game/chapters/chapter6/ch6sc2.rpy:3564
translate brazil ch6sc2_470fe94b:

#   mc "*Cough* What the... *Cough*"
    mc "*Tosse* O quê... *Tosse*"

# game/chapters/chapter6/ch6sc2.rpy:3569
translate brazil ch6sc2_45e0baa4:

#   mc "Hnnghh... what the? Can’t... move..."
    mc "Hnnghh... o quê? Não consigo... me mexer..."

# game/chapters/chapter6/ch6sc2.rpy:3573
translate brazil ch6sc2_c0f67ce7:

#   ec "Marah! What manner of evil has taken hold of you?"
    ec "Mara! Que tipo de mal se apoderou de você?"

# game/chapters/chapter6/ch6sc2.rpy:3574
translate brazil ch6sc2_42010ca2:

#   ec "What... what have you done?!"
    ec "O quê... o que você fez?!"

# game/chapters/chapter6/ch6sc2.rpy:3576
translate brazil ch6sc2_63c5c333:

#   mh "I did what you should have done yourself! He was an outsider..."
    mh "Eu fiz o que você mesmo deveria ter feito! Ele era um forasteiro..."

# game/chapters/chapter6/ch6sc2.rpy:3577
translate brazil ch6sc2_30f70e18:

#   mh "Naive girl."
    mh "Menina ingênua."

# game/chapters/chapter6/ch6sc2.rpy:3580
translate brazil ch6sc2_7e33a36d:

#   ec "Hold your venomous tongue!"
    ec "Cale a boca, seu veneno!"

# game/chapters/chapter6/ch6sc2.rpy:3581
translate brazil ch6sc2_5a5558fa:

#   ec "You forget who you’re talking to! You’re in no position to speak to me like that."
    ec "Você se esquece com quem está falando! Você não tem moral para falar comigo desse jeito."

# game/chapters/chapter6/ch6sc2.rpy:3582
translate brazil ch6sc2_47d88ad0:

#   ec "Especially after what you’ve just done!"
    ec "Principalmente depois do que você acabou de fazer!"

# game/chapters/chapter6/ch6sc2.rpy:3584
translate brazil ch6sc2_781408c9:

#   mh "*Scoffs* Has this outsider... this man... already corrupted your mind?"
    mh "*Risos* Será que esse forasteiro... esse homem... já corrompeu sua mente?"

# game/chapters/chapter6/ch6sc2.rpy:3585
translate brazil ch6sc2_6f97bb97:

#   mh "Has your respect for me and my opinion really been dissolved this swiftly?"
    mh "Será que o respeito que você tinha por mim e pela minha opinião desapareceu tão rapidamente?"

# game/chapters/chapter6/ch6sc2.rpy:3587
translate brazil ch6sc2_ba65e726:

#   ec "You have served me faithfully. You even taught me a great deal after my mother’s passing..."
    ec "Você me serviu fielmente. Você até me ensinou muito depois do falecimento da minha mãe..."

# game/chapters/chapter6/ch6sc2.rpy:3588
translate brazil ch6sc2_7f6ec475:

#   ec "But you are the one lacking respect."
    ec "Mas é você quem está demonstrando falta de respeito."

# game/chapters/chapter6/ch6sc2.rpy:3589
translate brazil ch6sc2_9cd3cf16:

#   ec "And this lack of respect, lack of trust..."
    ec "E essa falta de respeito, essa falta de confiança..."

# game/chapters/chapter6/ch6sc2.rpy:3591
translate brazil ch6sc2_ed865e6c:

#   ec "I'm your A’nu."
    ec "Eu sou seu A'nu."

# game/chapters/chapter6/ch6sc2.rpy:3592
translate brazil ch6sc2_ab361cd4:

#   ec "It has brought this man to his death... a good man."
    ec "Isso levou esse homem à morte... um homem bom."

# game/chapters/chapter6/ch6sc2.rpy:3594
translate brazil ch6sc2_d06ccca2:

#   mh "Possibly... we both know where that tunnel leads."
    mh "Talvez... nós dois saibamos aonde esse túnel leva."

# game/chapters/chapter6/ch6sc2.rpy:3596
translate brazil ch6sc2_d199420a:

#   ec "The depths of A’nai, once used to determine the worth of an A’khan."
    ec "As profundezas de A'nai, outrora usadas para determinar o valor de um A'khan."

# game/chapters/chapter6/ch6sc2.rpy:3598
translate brazil ch6sc2_4303d878:

#   mh "You may see him again, if the goddesses will it so."
    mh "Você poderá vê-lo novamente, se as deusas assim o quiserem."

# game/chapters/chapter6/ch6sc2.rpy:3599
translate brazil ch6sc2_75a0ba72:

#   mh "I severely doubt it, though."
    mh "Duvido muito, no entanto."

# game/chapters/chapter6/ch6sc2.rpy:3601
translate brazil ch6sc2_51a85946:

#   ec "Marah, for your sake... I hope he returns to us unharmed."
    ec "Marah, por você... espero que ele volte para nós ileso."

# game/chapters/chapter6/ch6sc2.rpy:3603
translate brazil ch6sc2_536d6755:

#   mh "I am sorry to undermine you, but you know I have our tribe's wellbeing at heart."
    mh "Lamento contrariá-lo, mas você sabe que o bem-estar da nossa tribo é a minha maior prioridade."

# game/chapters/chapter6/ch6sc2.rpy:3604
translate brazil ch6sc2_ac7e990c:

#   mh "This had to be done, believe me."
    mh "Isso precisava ser feito, acredite em mim."

# game/chapters/chapter6/ch6sc2.rpy:3605
translate brazil ch6sc2_c57e53fb:

#   mh "Good man or not, he was a threat, a risk... one that we cannot afford to take."
    mh "Bom homem ou não, ele era uma ameaça, um risco... um risco que não podemos nos dar ao luxo de correr."

# game/chapters/chapter6/ch6sc2.rpy:3607
translate brazil ch6sc2_187b6eba:

#   ec "I'll be in my chambers."
    ec "Estarei em meus aposentos."

# game/chapters/chapter6/ch6sc2.rpy:3608
translate brazil ch6sc2_63c05180:

#   ec "I suggest you go pray to the goddesses and hope they hear you."
    ec "Sugiro que você vá rezar para as deusas e espere que elas te ouçam."

# game/chapters/chapter6/ch6sc2.rpy:3612
translate brazil ch6sc2_fde50917:

#   "As your consciousness returns, you feel yourself sliding down a seemingly endless corridor that is illuminated with an ominous red light."
    "Ao recuperar a consciência, você se sente deslizando por um corredor aparentemente infinito, iluminado por uma luz vermelha sinistra."

# game/chapters/chapter6/ch6sc2.rpy:3613
translate brazil ch6sc2_aad656b9:

#   mc "Marah... that fucking bitch... she surprised me with some sort of powder."
    mc "Marah... aquela vadia... ela me surpreendeu com algum tipo de pó."

# game/chapters/chapter6/ch6sc2.rpy:3614
translate brazil ch6sc2_fbadc49b:

#   mc "I was making good progress with Echo until that hag came along."
    mc "Eu estava progredindo bem com a Echo até aquela bruxa aparecer."

# game/chapters/chapter6/ch6sc2.rpy:3615
translate brazil ch6sc2_6b9f487f:

#   "Suddenly you reach the end of the tunnel. Unable to stop your momentum, you go flying through a dense fog wall."
    "De repente, você chega ao fim do túnel. Incapaz de parar o impulso, você atravessa uma densa parede de neblina."

# game/chapters/chapter6/ch6sc2.rpy:3624
translate brazil ch6sc2_432253fb:

#   ox "Don’t worry, Master! I’ve got you!"
    ox "Não se preocupe, Mestre! Eu estou aqui para te ajudar!"

# game/chapters/chapter6/ch6sc2.rpy:3625
translate brazil ch6sc2_860f85fb:

#   mc "Thanks. For some reason I couldn’t use my wind abilities to cushion the landing..."
    mc "Obrigado. Por algum motivo, não consegui usar minhas habilidades com o vento para amortecer o pouso..."

# game/chapters/chapter6/ch6sc2.rpy:3626
translate brazil ch6sc2_e693d411:

#   mc "Now that I think about it, I haven’t felt my magic since arriving here on Aruna."
    mc "Pensando bem, não sinto minha magia desde que cheguei aqui em Aruna."

# game/chapters/chapter6/ch6sc2.rpy:3627
translate brazil ch6sc2_c8034668:

#   mc "The only magic I’ve felt was what drew me towards A’nai. But Echo claims their magic is lost."
    mc "A única magia que senti foi a que me atraiu para A'nai. Mas Echo afirma que a magia deles está perdida."

# game/chapters/chapter6/ch6sc2.rpy:3629
translate brazil ch6sc2_777da86c:

#   ox "Maybe it’s connected? Whatever has caused their magic to disappear, maybe it's also disrupting yours?"
    ox "Talvez esteja tudo relacionado? Seja lá o que for que tenha causado o desaparecimento da magia deles, talvez também esteja afetando a sua?"

# game/chapters/chapter6/ch6sc2.rpy:3631
translate brazil ch6sc2_801fc927:

#   mc "That’s likely the case... But this place is filled with magical presence, and it seems you’re functioning fine?"
    mc "É provável que seja esse o caso... Mas este lugar está repleto de uma presença mágica, e parece que você está funcionando bem?"

# game/chapters/chapter6/ch6sc2.rpy:3633
translate brazil ch6sc2_6768d18a:

#   ox "You forget, Master... I’m not just magical. I’m part of your being. Just like your hands, feet, and nose."
    ox "Você se esquece, Mestre... Eu não sou apenas mágica. Sou parte do seu ser. Assim como suas mãos, seus pés e seu nariz."

# game/chapters/chapter6/ch6sc2.rpy:3635
translate brazil ch6sc2_e5603108:

#   mc "Good to know that you’re not so easily vanquished."
    mc "Que bom saber que você não se deixa vencer tão facilmente."

# game/chapters/chapter6/ch6sc2.rpy:3636
translate brazil ch6sc2_71479021:

#   mc "However, if something is powerful enough to eliminate magic, or at the very least subdue it across the entire island..."
    mc "Contudo, se algo for poderoso o suficiente para eliminar a magia, ou pelo menos subjugá-la em toda a ilha..."

# game/chapters/chapter6/ch6sc2.rpy:3637
translate brazil ch6sc2_4aa6d044:

#   mc "That’s going to be troublesome, to say the least."
    mc "Isso vai ser problemático, para dizer o mínimo."

# game/chapters/chapter6/ch6sc2.rpy:3639
translate brazil ch6sc2_76e9b680:

#   ox "Didn’t they say that they lost touch with their magic after the desecration? After their enslavement?"
    ox "Eles não disseram que perderam o contato com a magia depois da profanação? Depois da escravização?"

# game/chapters/chapter6/ch6sc2.rpy:3640
translate brazil ch6sc2_85b4fdf7:

#   ox "It sounds like they think they've angered their gods, but I’ve never heard of gods interfering in this way with mortals."
    ox "Parece que eles acham que irritaram seus deuses, mas eu nunca ouvi falar de deuses interferindo dessa forma na vida dos mortais."

# game/chapters/chapter6/ch6sc2.rpy:3641
translate brazil ch6sc2_afc61423:

#   ox "The most they usually do is to imbue an artifact with magic, or bestow a temporary blessing on their followers."
    ox "O máximo que costumam fazer é imbuir um artefato com magia ou conceder uma bênção temporária aos seus seguidores."

# game/chapters/chapter6/ch6sc2.rpy:3642
translate brazil ch6sc2_ab6d6595:

#   ox "But to remove magic entirely, or subdue it? I've never heard of such a thing."
    ox "Mas eliminar a magia por completo, ou subjugá-la? Nunca ouvi falar de tal coisa."

# game/chapters/chapter6/ch6sc2.rpy:3644
translate brazil ch6sc2_058dc59a:

#   mc "Mhm, yeah... Maia said something like that too. I don’t think it’s anything to do with angering their gods."
    mc "Sim, é... Maia disse algo parecido também. Não acho que tenha algo a ver com irritar os deuses deles."

# game/chapters/chapter6/ch6sc2.rpy:3645
translate brazil ch6sc2_7a2d0cf9:

#   mc "My guess is those men who tried to enslave A’nai are at the root of it. Maybe they did something? Or it could be the Arugoh tribe."
    mc "Acho que a raiz do problema está nos homens que tentaram escravizar A'nai. Talvez eles tenham feito algo? Ou talvez seja a tribo Arugoh."

# game/chapters/chapter6/ch6sc2.rpy:3646
translate brazil ch6sc2_8e8248b0:

#   mc "One of them attacked our ship with magic, so they must still have access to it. It could be that they're responsible."
    mc "Um deles atacou nossa nave com magia, então eles ainda devem ter acesso a ela. Pode ser que sejam os responsáveis."

# game/chapters/chapter6/ch6sc2.rpy:3648
translate brazil ch6sc2_cda07ed7:

#   ox "Right now, all we can do is guess. Which won’t help much down here."
    ox "No momento, tudo o que podemos fazer é supor. O que não vai ajudar muito aqui embaixo."

# game/chapters/chapter6/ch6sc2.rpy:3652
translate brazil ch6sc2_dd5d20e2:

#   mc "You’re right... let’s take a look around."
    mc "Você tem razão... vamos dar uma olhada por aí."

# game/chapters/chapter6/ch6sc2.rpy:3656
translate brazil ch6sc2_ea62f405:

#   mc "I came from up there, through that thick red fog."
    mc "Eu vim de lá de cima, através daquela densa névoa vermelha."

# game/chapters/chapter6/ch6sc2.rpy:3657
translate brazil ch6sc2_7bd1d83c:

#   mc "Given how long it took, and the speed I was sliding, we’re a long... long way below the temple."
    mc "Considerando o tempo que levou e a velocidade com que eu estava deslizando, estamos muito... muito longe abaixo do templo."

# game/chapters/chapter6/ch6sc2.rpy:3658
translate brazil ch6sc2_76cf7bce:

#   mc "*Sighs* It’s going to be one hell of a trek to get out of here, if it's even possible."
    mc "*Suspiro* Vai ser uma jornada infernal para sair daqui, se é que será possível."

# game/chapters/chapter6/ch6sc2.rpy:3660
translate brazil ch6sc2_32c68b6f:

#   mc "This place looks ancient... does Echo and her tribe even know it exists?"
    mc "Este lugar parece muito antigo... será que Echo e sua tribo sequer sabem que ele existe?"

# game/chapters/chapter6/ch6sc2.rpy:3661
translate brazil ch6sc2_8d69d765:

#   mc "And these statues..."
    mc "E essas estátuas..."

# game/chapters/chapter6/ch6sc2.rpy:3663
translate brazil ch6sc2_9a21c011:

#   mc "They’re lit by some sort of red light coming from their basins. Funny, the tunnel had dim red light as well."
    mc "Elas são iluminadas por algum tipo de luz vermelha que vem de suas bacias. Curiosamente, o túnel também tinha uma luz vermelha fraca."

# game/chapters/chapter6/ch6sc2.rpy:3664
translate brazil ch6sc2_bfd453ba:

#   mc "There’s definitely magic emanating from this temple. It’s even making my skin tingle."
    mc "Definitivamente, há algo de mágico emanando deste templo. Está até me dando arrepios."

# game/chapters/chapter6/ch6sc2.rpy:3666
translate brazil ch6sc2_f92e144a:

#   mc "Question is, why? Why build this so far below the surface? Was it to hide it?"
    mc "A questão é: por quê? Por que construir isso tão abaixo da superfície? Seria para esconder?"

# game/chapters/chapter6/ch6sc2.rpy:3667
translate brazil ch6sc2_4c300657:

#   mc "Ancient civilizations often built their burial chambers, treasure troves and religious offerings deep below ground."
    mc "Civilizações antigas frequentemente construíam suas câmaras funerárias, tesouros e oferendas religiosas em profundidades abaixo da superfície."

# game/chapters/chapter6/ch6sc2.rpy:3668
translate brazil ch6sc2_2aa4b920:

#   mc "Probably to protect and hide them from raiders. Huh? There’s a different light coming from over there."
    mc "Provavelmente para protegê-los e escondê-los de saqueadores. Hã? Tem uma luz diferente vindo dali."

# game/chapters/chapter6/ch6sc2.rpy:3670
translate brazil ch6sc2_37241b1b:

#   mc "Staying here in this chamber won’t do much good anyway..."
    mc "Ficar aqui neste quarto não vai adiantar muito de qualquer forma..."

# game/chapters/chapter6/ch6sc2.rpy:3671
translate brazil ch6sc2_db4a112c:

#   mc "I might as well check it out."
    mc "Acho que vou dar uma olhada."

# game/chapters/chapter6/ch6sc2.rpy:3675
translate brazil ch6sc2_122b516d:

#   mc "The magical presence feels stronger here..."
    mc "A presença mágica parece mais forte aqui..."

# game/chapters/chapter6/ch6sc2.rpy:3679
translate brazil ch6sc2_1b8c2601:

#   mc "Definitely increasing as I get closer to the blue light... what’s going on?"
    mc "Definitivamente, está aumentando conforme me aproximo da luz azul... o que está acontecendo?"

# game/chapters/chapter6/ch6sc2.rpy:3681
translate brazil ch6sc2_d47e0d88:

#   mc "A fog wall? How ominous..."
    mc "Uma parede de névoa? Que presságio..."

# game/chapters/chapter6/ch6sc2.rpy:3682
translate brazil ch6sc2_1213ac55:

#   mc "Should I enter?"
    mc "Devo entrar?"

# game/chapters/chapter6/ch6sc2.rpy:3688
translate brazil ch6sc2_56fe18e6:

#   mc "*Sighs* I really can’t be bothered but... it’s either this or wither away down here..."
    mc "*Suspiro* Eu realmente não estou com paciência, mas... ou é isso ou definhar aqui embaixo..."

# game/chapters/chapter6/ch6sc2.rpy:3692
translate brazil ch6sc2_c6b1295e:

#   mc "How bad could it be?"
    mc "Quão ruim poderia ser?"

# game/chapters/chapter6/ch6sc2.rpy:3696
translate brazil ch6sc2_cecc44aa:

#   mc "Woah... it feels strange: cool to the touch."
    mc "Uau... é uma sensação estranha: está frio ao toque."

# game/chapters/chapter6/ch6sc2.rpy:3705
translate brazil ch6sc2_c057d5be:

#   mc "*Coughs* Damn... should’ve taken a deep breath before coming through."
    mc "*Tosse* Droga... devia ter respirado fundo antes de vir."

# game/chapters/chapter6/ch6sc2.rpy:3707
translate brazil ch6sc2_0cb1f2db:

#   mc "That’s... not creepy at all."
    mc "Isso... não é nada assustador."

# game/chapters/chapter6/ch6sc2.rpy:3708
translate brazil ch6sc2_c6717c2f:

#   mc "There’s something in this room. I can feel a presence."
    mc "Há algo neste quarto. Consigo sentir uma presença."

# game/chapters/chapter6/ch6sc2.rpy:3711
translate brazil ch6sc2_25fe2822:

#   mc "What the... self-lighting fires?"
    mc "Que diabos... são fogueiras que se acendem sozinhas?"

# game/chapters/chapter6/ch6sc2.rpy:3713
translate brazil ch6sc2_638f06c8:

#   uk "*Echoing Rumble* ..."
    uk "*Ecoando* ..."

# game/chapters/chapter6/ch6sc2.rpy:3718
translate brazil ch6sc2_d2e464d8:

#   mc "The sounds are coming from that... thing at the end of the hall."
    mc "Os sons estão vindo daquela... coisa no final do corredor."

# game/chapters/chapter6/ch6sc2.rpy:3722
translate brazil ch6sc2_d9a82d1a:

#   mc "That’s no ordinary statue... it’s..."
    mc "Essa não é uma estátua qualquer... é..."

# game/chapters/chapter6/ch6sc2.rpy:3732
translate brazil ch6sc2_1f60a120:

#   mc "A golem? ... Must've been enchanted by whoever built this place."
    mc "Um golem? ... Deve ter sido enfeitiçado por quem construiu este lugar."

# game/chapters/chapter6/ch6sc2.rpy:3735
translate brazil ch6sc2_09bcae19:

#   mc "*Exhales* Well, I’ve been itching to punch something ever since that... Marah appeared."
    mc "*Suspira* Bom, eu estava com muita vontade de socar alguma coisa desde que... a Marah apareceu."

# game/chapters/chapter6/ch6sc2.rpy:3740
translate brazil ch6sc2_8839e6bf:

#   uk "*Roaring rumble* Rhooohrhhh!"
    uk "*Estrondo ensurdecedor* Rhooohrhhh!"

# game/chapters/chapter6/ch6sc2.rpy:3750
translate brazil ch6sc2_0a718169:

#   mc "One punch? Really? *Sighs* Disappointing."
    mc "Um soco só? Sério? *Suspiro* Que decepção."

# game/chapters/chapter6/ch6sc2.rpy:3753
translate brazil ch6sc2_d89a0a0a:

#   mc "I suppose he was put here to thrash potential raiders, not oppose a Nephilim."
    mc "Suponho que ele tenha sido colocado aqui para repelir possíveis invasores, não para se opor a um Nefilim."

# game/chapters/chapter6/ch6sc2.rpy:3755
translate brazil ch6sc2_7d6b06e2:

#   mc "Speaking of raiders... that looks like the door to a treasury if ever I saw one."
    mc "Por falar em saqueadores... essa parece ser a porta de um tesouro, se é que já vi alguma."

# game/chapters/chapter6/ch6sc2.rpy:3757
translate brazil ch6sc2_4165d243:

#   mc "It looks ancient... and massive..."
    mc "Parece antigo... e enorme..."

# game/chapters/chapter6/ch6sc2.rpy:3758
translate brazil ch6sc2_27081348:

#   mc "I wonder how long it's been here? Was it a part of the temple, or was it built long before?"
    mc "Gostaria de saber há quanto tempo está aqui? Fazia parte do templo ou foi construído muito antes?"

# game/chapters/chapter6/ch6sc2.rpy:3760
translate brazil ch6sc2_ad51dbb4:

#   mc "Whoever built this place must’ve been giants ... or maybe they used enchanted golems like the one guarding this place as workers."
    mc "Quem construiu este lugar devia ser um gigante... ou talvez tenha usado golens encantados como este que guarda o local como trabalhadores."

# game/chapters/chapter6/ch6sc2.rpy:3761
translate brazil ch6sc2_393cde78:

#   mc "These glyphs inscribed on the door... probably a language lost to time."
    mc "Esses glifos inscritos na porta... provavelmente uma língua perdida no tempo."

# game/chapters/chapter6/ch6sc2.rpy:3763
translate brazil ch6sc2_d7880e33:

#   mc "Maybe it's a warning telling me not to touch this conveniently placed handle?"
    mc "Talvez seja um aviso para eu não tocar nessa alça convenientemente localizada?"

# game/chapters/chapter6/ch6sc2.rpy:3764
translate brazil ch6sc2_540fd439:

#   mc "Ancient tombs and traps usually go hand in hand, after all."
    mc "Afinal, tumbas antigas e armadilhas geralmente andam de mãos dadas."

# game/chapters/chapter6/ch6sc2.rpy:3766
translate brazil ch6sc2_a78c06b4:

#   mc "Onyx, be a dear...?"
    mc "Ônix, seja um querido...?"

# game/chapters/chapter6/ch6sc2.rpy:3767
translate brazil ch6sc2_b8359a6b:

#   ox "Master! I can’t believe you'd use me this way! *Fake sobbing* I’ve been downgraded to a mere trap decoy!"
    ox "Mestre! Não acredito que me usaria assim! *Chorando* Fui rebaixada a uma mera isca para armadilhas!"

# game/chapters/chapter6/ch6sc2.rpy:3769
translate brazil ch6sc2_15266832:

#   mc "Calm down. We both know this won’t kill you..."
    mc "Calma. Nós dois sabemos que isso não vai te matar..."

# game/chapters/chapter6/ch6sc2.rpy:3770
translate brazil ch6sc2_7a87e2b8:

#   ox "*Fake weeping* It’s the thought that counts!"
    ox "*Chorando de brincadeira* O que importa é a intenção!"

# game/chapters/chapter6/ch6sc2.rpy:3773
translate brazil ch6sc2_ebfc84a2:

#   ox "{b}OWH!!{/b}"
    ox "{b}OH MEU DEUS!!{/b}"

# game/chapters/chapter6/ch6sc2.rpy:3774
translate brazil ch6sc2_a80d2f8a:

#   mc "Are you hurt?"
    mc "Você está ferido?"

# game/chapters/chapter6/ch6sc2.rpy:3775
translate brazil ch6sc2_3f3523e2:

#   ox "No. *Snickers* You know blades can’t hurt me."
    ox "Não. *Risos* Você sabe que lâminas não podem me machucar."

# game/chapters/chapter6/ch6sc2.rpy:3776
translate brazil ch6sc2_5efc6238:

#   mc "*Sighs* ... just open the damn door, you drama-oozeling."
    mc "*Suspiros* ... abra logo essa porta, seu dramático!"

# game/chapters/chapter6/ch6sc2.rpy:3777
translate brazil ch6sc2_e3623484:

#   "The handle clicks a few times as Onyx twists it, then a loud thump is followed by a final click."
    "A alça estala algumas vezes enquanto Onyx a gira, depois um baque alto é seguido por um clique final."

# game/chapters/chapter6/ch6sc2.rpy:3779
translate brazil ch6sc2_bd6ec15e:

#   ox "That should do it, Master."
    ox "Isso deve resolver o problema, Mestre."

# game/chapters/chapter6/ch6sc2.rpy:3780
translate brazil ch6sc2_5cc1dd81:

#   mc "Good job, Onyx. You’re not too shabby at this adventuring stuff."
    mc "Bom trabalho, Onyx. Você não é nada mal nessas coisas de aventura."

# game/chapters/chapter6/ch6sc2.rpy:3781
translate brazil ch6sc2_dc3455fc:

#   "The door begins to rumble..."
    "A porta começa a tremer..."

# game/chapters/chapter6/ch6sc2.rpy:3785
translate brazil ch6sc2_f3676051:

#   ox "Woah! Master... this is incredible! We’re rich!!"
    ox "Uau! Mestre... isto é incrível! Estamos ricos!!"

# game/chapters/chapter6/ch6sc2.rpy:3786
translate brazil ch6sc2_22ae32d5:

#   mc "Easy... we don’t know if there are any more traps inside."
    mc "Calma... não sabemos se há mais armadilhas lá dentro."

# game/chapters/chapter6/ch6sc2.rpy:3787
translate brazil ch6sc2_02403488:

#   mc "And we won’t be able to get all of this out of here anyway."
    mc "E de qualquer forma não vamos conseguir tirar tudo isso daqui."

# game/chapters/chapter6/ch6sc2.rpy:3789
translate brazil ch6sc2_b01b1aad:

#   mc "Woah... I’ve never seen this much loot in one treasury..."
    mc "Uau... Nunca vi tanto saque em um único tesouro..."

# game/chapters/chapter6/ch6sc2.rpy:3790
translate brazil ch6sc2_83cffd3e:

#   mc "This must have been gathered over centuries."
    mc "Isso deve ter sido reunido ao longo de séculos."

# game/chapters/chapter6/ch6sc2.rpy:3796
translate brazil ch6sc2_a588a0ff:

#   mc "Huh? What’s that..."
    mc "Hã? O que é isso...?"

# game/chapters/chapter6/ch6sc2.rpy:3797
translate brazil ch6sc2_b44aa608:

#   mc "A... necklace? It’s levitating? It must be an effect of the magic surrounding it."
    mc "Um... colar? Está levitando? Deve ser um efeito da magia que o envolve."

# game/chapters/chapter6/ch6sc2.rpy:3798
translate brazil ch6sc2_f3561c22:

#   mc "It’s similar to the fog wall I went through."
    mc "É semelhante à parede de neblina que eu atravessei."

# game/chapters/chapter6/ch6sc2.rpy:3800
translate brazil ch6sc2_9046abb5:

#   mc "There’s no mistaking it..."
    mc "Não há como negar..."

# game/chapters/chapter6/ch6sc2.rpy:3801
translate brazil ch6sc2_5e8f1fda:

#   mc "This is the feeling that was drawing me towards A’nai when I was in the jungle."
    mc "Era esse sentimento que me atraía em direção a A'nai quando eu estava na selva."

# game/chapters/chapter6/ch6sc2.rpy:3802
translate brazil ch6sc2_9d770435:

#   mc "Out there it was faint, I could barely feel it."
    mc "Lá fora era fraco, eu mal conseguia sentir."

# game/chapters/chapter6/ch6sc2.rpy:3803
translate brazil ch6sc2_5f0eecf7:

#   mc "But here... being this close, it makes my skin tingle."
    mc "Mas aqui... estando tão perto, sinto um arrepio na pele."

# game/chapters/chapter6/ch6sc2.rpy:3805
translate brazil ch6sc2_2ee2b7b0:

#   ox "Careful, Master... what if it's a dark object?"
    ox "Cuidado, Mestre... e se for um objeto escuro?"

# game/chapters/chapter6/ch6sc2.rpy:3806
translate brazil ch6sc2_7ec32e94:

#   ox "Maybe it's the thing that is subduing magic?"
    ox "Talvez seja isso que esteja subjugando a magia?"

# game/chapters/chapter6/ch6sc2.rpy:3807
translate brazil ch6sc2_adba534a:

#   mc "No... this doesn’t feel like a trap."
    mc "Não... isso não me parece uma armadilha."

# game/chapters/chapter6/ch6sc2.rpy:3808
translate brazil ch6sc2_bbcc942b:

#   mc "It feels... fated."
    mc "Parece... predestinado."

# game/chapters/chapter6/ch6sc2.rpy:3810
translate brazil ch6sc2_9d1f0551:

#   ox "Fated? There’s no such thing!"
    ox "Predestinado? Isso não existe!"

# game/chapters/chapter6/ch6sc2.rpy:3811
translate brazil ch6sc2_152d75fd:

#   mc "I can’t explain it, Onyx."
    mc "Não consigo explicar, Onyx."

# game/chapters/chapter6/ch6sc2.rpy:3812
translate brazil ch6sc2_3db485a0:

#   mc "It’s just the feeling I get. Like it’s safe... like it was meant for me, or for someone like me."
    mc "É apenas a sensação que eu tenho. Como se fosse seguro... como se fosse para mim, ou para alguém como eu."

# game/chapters/chapter6/ch6sc2.rpy:3814
translate brazil ch6sc2_e062e223:

#   "As you get closer and your hand approaches the floating talisman, it’s soothing aura reaches out to meet you."
    "À medida que você se aproxima e sua mão se aproxima do talismã flutuante, sua aura calmante se estende ao seu encontro."

# game/chapters/chapter6/ch6sc2.rpy:3815
translate brazil ch6sc2_5d4b4efb:

#   mc "Woah... its reacting to me?"
    mc "Uau... está reagindo a mim?"

# game/chapters/chapter6/ch6sc2.rpy:3816
translate brazil ch6sc2_00a4a947:

#   mc "Let’s see if I can absorb this essence."
    mc "Vamos ver se consigo absorver essa essência."

# game/chapters/chapter6/ch6sc2.rpy:3818
translate brazil ch6sc2_a1b6654a:

#   "As you guessed, the essence merges with you as you come into contact with it."
    "Como você deve ter imaginado, a essência se funde com você ao entrar em contato com ela."

# game/chapters/chapter6/ch6sc2.rpy:3819
translate brazil ch6sc2_a680ac8a:

#   mc "It's working."
    mc "Está funcionando."

# game/chapters/chapter6/ch6sc2.rpy:3821
translate brazil ch6sc2_2e3240a1:

#   mc "Incredible... I feel... stronger? More... durable?"
    mc "Incrível... Eu me sinto... mais forte? Mais... resistente?"

# game/chapters/chapter6/ch6sc2.rpy:3822
translate brazil ch6sc2_f93b9676:

#   mc "Strange, that usually only happens when I absorb the lifeforce of enemies I’ve defeated."
    mc "Estranho, isso geralmente só acontece quando absorvo a força vital de inimigos que derrotei."

# game/chapters/chapter6/ch6sc2.rpy:3824
translate brazil ch6sc2_29b8f717:

#   mc "Let’s see what this necklace is all about."
    mc "Vamos ver do que se trata esse colar."

# game/chapters/chapter6/ch6sc2.rpy:3826
translate brazil ch6sc2_63350ba0:

#   mc "It’s heavy... way heavier than something this size should be. I don’t think an average human could possibly lift it."
    mc "É pesado... muito mais pesado do que algo desse tamanho deveria ser. Acho que uma pessoa comum não conseguiria levantá-lo."

# game/chapters/chapter6/ch6sc2.rpy:3827
translate brazil ch6sc2_55cd1901:

#   mc "Maybe that was the purpose of the magical essence surrounding it? To allow whoever finds it to be its wielder?"
    mc "Talvez esse fosse o propósito da essência mágica que a envolvia? Permitir que quem a encontrasse se tornasse seu portador?"

# game/chapters/chapter6/ch6sc2.rpy:3828
translate brazil ch6sc2_a8346071:

#   mc "Might as well try it on..."
    mc "Melhor experimentar..."

# game/chapters/chapter6/ch6sc2.rpy:3837
translate brazil ch6sc2_46e46452:

#   mc "I feel stronger..."
    mc "Eu me sinto mais forte..."

# game/chapters/chapter6/ch6sc2.rpy:3842
translate brazil ch6sc2_22f87dc0:

#   mc "Onyx... do you feel this as well?"
    mc "Ônix... você também sente isso?"

# game/chapters/chapter6/ch6sc2.rpy:3843
translate brazil ch6sc2_a195752c:

#   ox "Yes... you were right, Master."
    ox "Sim... você tinha razão, Mestre."

# game/chapters/chapter6/ch6sc2.rpy:3844
translate brazil ch6sc2_07ee4bd0:

#   ox "It is... fated."
    ox "Está... predestinado."

# game/chapters/chapter6/ch6sc2.rpy:3846
translate brazil ch6sc2_bfa147cd:

#   mc "It feels like it’s part of me now. Just like you?"
    mc "Sinto como se já fizesse parte de mim. Assim como você?"

# game/chapters/chapter6/ch6sc2.rpy:3847
translate brazil ch6sc2_ff01975d:

#   mc "I... absorbed the essence it was imbued with."
    mc "Eu... absorvi a essência que a compunha."

# game/chapters/chapter6/ch6sc2.rpy:3848
translate brazil ch6sc2_a74952b5:

#   ox "Could this be... no, surely not?"
    ox "Será possível... não, certamente não?"

# game/chapters/chapter6/ch6sc2.rpy:3851
translate brazil ch6sc2_d42219d1:

#   ox "Could it be an artifact of the Divines?"
    ox "Poderia ser um artefato dos Divinos?"

# game/chapters/chapter6/ch6sc2.rpy:3852
translate brazil ch6sc2_8a89c1b4:

#   ox "Echo said their ancestors were followers of Malpheon?"
    ox "Echo disse que seus ancestrais eram seguidores de Malpheon?"

# game/chapters/chapter6/ch6sc2.rpy:3854
translate brazil ch6sc2_f9f9ed0b:

#   mc "Right... the more recent generations worship {b}The Celestial Trinity{/b} of Gaia, Malanthe and Maia."
    mc "Certo... as gerações mais recentes adoram {b} A Trindade Celestial{/b} de Gaia, Malanthe e Maia."

# game/chapters/chapter6/ch6sc2.rpy:3855
translate brazil ch6sc2_d8fd0bc5:

#   mc "But way back when A’nai was first founded..."
    mc "Mas, lá nos primórdios da fundação de A'nai..."

# game/chapters/chapter6/ch6sc2.rpy:3857
translate brazil ch6sc2_92bc30e0:

#   mc "They were followers of Malpheon... one of the seven divines, just like Lucid."
    mc "Eles eram seguidores de Malpheon... um dos sete divinos, assim como Lucid."

# game/chapters/chapter6/ch6sc2.rpy:3858
translate brazil ch6sc2_0540bed9:

#   mc "If this is an artifact from the Divines, then it would explain why it feels so... powerful."
    mc "Se for um artefato dos Divinos, isso explicaria por que ele parece tão... poderoso."

# game/chapters/chapter6/ch6sc2.rpy:3860
translate brazil ch6sc2_52283ea5:

#   mc "It gives me the same vibe as when I’ve been in the presence of Lucid."
    mc "Me dá a mesma sensação de quando estou na presença de Lucid."

# game/chapters/chapter6/ch6sc2.rpy:3861
translate brazil ch6sc2_92ec38d3:

#   mc "Familiar and... right?"
    mc "Familiar e... certo?"

# game/chapters/chapter6/ch6sc2.rpy:3862
translate brazil ch6sc2_0cfd2b2c:

#   mc "It just feels... right."
    mc "Parece... certo."

# game/chapters/chapter6/ch6sc2.rpy:3864
translate brazil ch6sc2_d8b279ac:

#   mc "When I put it on, I felt myself gain the affinity for Earth-magic."
    mc "Ao vesti-lo, senti que adquiri uma afinidade com a magia da Terra."

# game/chapters/chapter6/ch6sc2.rpy:3865
translate brazil ch6sc2_97e7abda:

#   mc "And these wisps? It’s like they’re alive, but also part of me somehow?"
    mc "E esses fios? É como se estivessem vivos, mas também fizessem parte de mim de alguma forma?"

# game/chapters/chapter6/ch6sc2.rpy:3867
translate brazil ch6sc2_f9ce0dfd:

#   mc "But I still feel unable to do any magic..."
    mc "Mas ainda me sinto incapaz de fazer qualquer mágica..."

# game/chapters/chapter6/ch6sc2.rpy:3869
translate brazil ch6sc2_0645faf7:

#   ox "Rats! Then this can't be the magic dampener that we suspected."
    ox "Droga! Então isso não pode ser o amortecedor mágico que suspeitávamos."

# game/chapters/chapter6/ch6sc2.rpy:3870
translate brazil ch6sc2_2c7a703e:

#   mc "Looks like I’m able to control the wisps, though. I can freely send them back into the necklace."
    mc "Parece que consigo controlar os fios de luz. Posso enviá-los de volta para o colar livremente."

# game/chapters/chapter6/ch6sc2.rpy:3871
translate brazil ch6sc2_468d4c53:

#   ox "Great! But we've still got a magic problem to grapple with."
    ox "Ótimo! Mas ainda temos um problema mágico para resolver."

# game/chapters/chapter6/ch6sc2.rpy:3877
translate brazil ch6sc2_6e5d7ec1:

#   mc "Don’t worry, Onyx... we’ll figure it out."
    mc "Não se preocupe, Onyx... nós vamos dar um jeito."

# game/chapters/chapter6/ch6sc2.rpy:3878
translate brazil ch6sc2_0b211652:

#   mc "Let’s grab a few gems and see if we can find a way out."
    mc "Vamos pegar algumas joias e ver se conseguimos encontrar uma saída."

# game/chapters/chapter6/ch6sc2.rpy:3880
translate brazil ch6sc2_637b414f:

#   ox "Ooohh... nicking a few ancient and possibly incredibly valuable gems? I love it when you’re being naughty!"
    ox "Ooohh... roubar algumas joias antigas e possivelmente incrivelmente valiosas? Adoro quando você apronta!"

# game/chapters/chapter6/ch6sc2.rpy:3881
translate brazil ch6sc2_07837616:

#   mc "*Chuckles* Right... there’s no reason to leave empty-handed from a place like this. We’ll need plenty of coin back home."
    mc "*Risos* É verdade... não há motivo para sair de mãos vazias de um lugar como este. Precisaremos de bastante dinheiro quando voltarmos para casa."

# game/chapters/chapter6/ch6sc2.rpy:3883
translate brazil ch6sc2_598c1933:

#   mc "Hmh? A chain?"
    mc "Hum? O quê?"

# game/chapters/chapter6/ch6sc2.rpy:3885
translate brazil ch6sc2_8d462495:

#   mc "Let’s see... I doubt it's a trap, we’re already inside the treasury."
    mc "Vamos ver... Duvido que seja uma armadilha, já estamos dentro do tesouro."

# game/chapters/chapter6/ch6sc2.rpy:3887
translate brazil ch6sc2_1369a184:

#   "As you pull the chain, a rumbling can be heard from the hallway."
    "Ao puxar a corrente, ouve-se um estrondo vindo do corredor."

# game/chapters/chapter6/ch6sc2.rpy:3890
translate brazil ch6sc2_3ec53078:

#   mc "Did you feel that? Something shifted in the other room."
    mc "Você sentiu isso? Algo mudou no outro cômodo."

# game/chapters/chapter6/ch6sc2.rpy:3891
translate brazil ch6sc2_4b34afe3:

#   ox "Don’t just stand there, Master... let’s check it out!"
    ox "Não fique aí parado, Mestre... vamos dar uma olhada!"

# game/chapters/chapter6/ch6sc2.rpy:3893
translate brazil ch6sc2_aa7cd1cd:

#   mc "Looks like the fog wall changed color. Guess that’s our way forward."
    mc "Parece que a parede de neblina mudou de cor. Acho que esse é o caminho a seguir."

# game/chapters/chapter6/ch6sc2.rpy:3894
translate brazil ch6sc2_a50c542e:

#   ox "Into the unknown we go!"
    ox "Rumo ao desconhecido!"

# game/chapters/chapter6/ch6sc2.rpy:3899
translate brazil ch6sc2_61b4b5ae:

#   "Going through the wall of fog once more, you encounter a long, winding corridor punctuated with faint red lights."
    "Ao atravessar mais uma vez a cortina de neblina, você se depara com um longo corredor sinuoso, pontilhado por tênues luzes vermelhas."

# game/chapters/chapter6/ch6sc2.rpy:3900
translate brazil ch6sc2_03ee049c:

#   "You follow it for well over an hour..."
    "Você acompanha isso por mais de uma hora..."

# game/chapters/chapter6/ch6sc2.rpy:3905
translate brazil ch6sc2_e9e73f41:

#   mc "By the Divines... this is..."
    mc "Pelos deuses... isto é..."

# game/chapters/chapter6/ch6sc2.rpy:3907
translate brazil ch6sc2_fe5e4e94:

#   mc "These carvings... the intricate stonework and statues..."
    mc "Essas esculturas... os trabalhos em pedra intrincados e as estátuas..."

# game/chapters/chapter6/ch6sc2.rpy:3908
translate brazil ch6sc2_7f59239a:

#   mc "This has to be older than the Temple of A’nai that is built on top of it."
    mc "Isso deve ser mais antigo que o Templo de A'nai, que foi construído sobre ele."

# game/chapters/chapter6/ch6sc2.rpy:3909
translate brazil ch6sc2_53f3a305:

#   mc "When was the last time a living being walked these halls?"
    mc "Quando foi a última vez que um ser vivo caminhou por esses corredores?"

# game/chapters/chapter6/ch6sc2.rpy:3911
translate brazil ch6sc2_90e8e2b9:

#   mc "My guess is... it must date back to the first Era."
    mc "Meu palpite é que... deve datar da Primeira Era."

# game/chapters/chapter6/ch6sc2.rpy:3912
translate brazil ch6sc2_05ca27da:

#   mc "Which makes it over a thousand years old."
    mc "O que a torna com mais de mil anos."

# game/chapters/chapter6/ch6sc2.rpy:3914
translate brazil ch6sc2_051f9532:

#   mc "Hmh... looks like... beasts? Dragons?"
    mc "Hum... parecem... feras? Dragões?"

# game/chapters/chapter6/ch6sc2.rpy:3915
translate brazil ch6sc2_23031297:

#   ox "Dragons were not very common in my time, but they were still more widespread than they are today."
    ox "Os dragões não eram muito comuns na minha época, mas ainda assim eram mais disseminados do que são hoje."

# game/chapters/chapter6/ch6sc2.rpy:3917
translate brazil ch6sc2_2bad2f95:

#   mc "A throne? ... What is that doing down here?"
    mc "Um trono? ... O que é que isso está fazendo aqui embaixo?"

# game/chapters/chapter6/ch6sc2.rpy:3918
translate brazil ch6sc2_bf1d6d01:

#   mc "Was this built by an underground civilization? Or has this temple sunken below ground over the ages?"
    mc "Será que foi construído por uma civilização subterrânea? Ou será que este templo afundou ao longo dos séculos?"

# game/chapters/chapter6/ch6sc2.rpy:3920
translate brazil ch6sc2_4a55a91b:

#   mc "These statues... they’re the same as the ones in the ruins I first fell into."
    mc "Essas estátuas... são as mesmas que estavam nas ruínas em que caí pela primeira vez."

# game/chapters/chapter6/ch6sc2.rpy:3922
translate brazil ch6sc2_82915c7a:

#   mc "*Chuckles* Might as well..."
    mc "*Risos* Tanto faz..."

# game/chapters/chapter6/ch6sc2.rpy:3924
translate brazil ch6sc2_e097a05e:

#   mc "Imagine... ruling a whole civilization..."
    mc "Imagine... governar uma civilização inteira..."

# game/chapters/chapter6/ch6sc2.rpy:3925
translate brazil ch6sc2_9da64079:

#   mc "It does have a certain... appeal."
    mc "Tem, de fato, um certo... charme."

# game/chapters/chapter6/ch6sc2.rpy:3927
translate brazil ch6sc2_887d71fc:

#   mc "*Exhales* But I’m busy enough as it is, with all that’s going on back home."
    mc "*Suspira* Mas já estou bastante ocupado com tudo o que está acontecendo em casa."

# game/chapters/chapter6/ch6sc2.rpy:3928
translate brazil ch6sc2_46f7148a:

#   mc "Can’t imagine the amount of work it would take to keep a whole civilization in line and happy."
    mc "Não consigo imaginar a quantidade de trabalho necessária para manter toda uma civilização em ordem e feliz."

# game/chapters/chapter6/ch6sc2.rpy:3930
translate brazil ch6sc2_9cfd30ab:

#   mc "Huh? Something shifted behind the throne?"
    mc "Hein? Algo mudou atrás do trono?"

# game/chapters/chapter6/ch6sc2.rpy:3931
translate brazil ch6sc2_7b473311:

#   ox "Maybe it's a secret passage? Back in my day, rulers often had escape tunnels in their bedchambers or throne rooms."
    ox "Talvez seja uma passagem secreta? Antigamente, os governantes costumavam ter túneis de fuga em seus aposentos ou salas do trono."

# game/chapters/chapter6/ch6sc2.rpy:3932
translate brazil ch6sc2_cc1fc1e2:

#   mc "Let’s have a look."
    mc "Vamos dar uma olhada."

# game/chapters/chapter6/ch6sc2.rpy:3943
translate brazil ch6sc2_235eba05:

#   ki "What do you mean 'you’re fully aware that they haven’t responded?!'"
    ki "Como assim 'você está plenamente ciente de que eles não responderam?!'"

# game/chapters/chapter6/ch6sc2.rpy:3945
translate brazil ch6sc2_ff31ba50:

#   di "Don’t make me repeat myself."
    di "Não me faça repetir."

# game/chapters/chapter6/ch6sc2.rpy:3947
translate brazil ch6sc2_5264747e:

#   ki "But they were supposed to send a raven once they arrived at Aruna! We haven’t heard anything in days!"
    ki "Mas eles deveriam ter enviado um corvo assim que chegassem a Aruna! Não tivemos notícias há dias!"

# game/chapters/chapter6/ch6sc2.rpy:3949
translate brazil ch6sc2_a9bdd348:

#   di "Kira, I have more important things to worry about than your boyfriend and your sister."
    di "Kira, tenho coisas mais importantes com que me preocupar do que com seu namorado e sua irmã."

# game/chapters/chapter6/ch6sc2.rpy:3951
translate brazil ch6sc2_f26be702:

#   di "We have to establish a whole new infrastructure and logistics center here in Looter’s Bay."
    di "Precisamos estabelecer uma infraestrutura e um centro logístico completamente novos aqui em Looter's Bay."

# game/chapters/chapter6/ch6sc2.rpy:3952
translate brazil ch6sc2_13800066:

#   di "Besides, [mc] went toe to toe with me and lived to tell the tale. He's the only person to ever accomplish that."
    di "Além do mais, [mc] Ele me enfrentou de igual para igual e viveu para contar a história. Ele é a única pessoa que já conseguiu isso."

# game/chapters/chapter6/ch6sc2.rpy:3954
translate brazil ch6sc2_06900c44:

#   di "I think he can handle whatever Aruna throws at them."
    di "Acho que ele consegue lidar com qualquer coisa que a Aruna lhes reserve."

# game/chapters/chapter6/ch6sc2.rpy:3956
translate brazil ch6sc2_3ac5c398:

#   ki "Let me go... let me retrieve them."
    ki "Deixe-me ir... deixe-me recuperá-los."

# game/chapters/chapter6/ch6sc2.rpy:3958
translate brazil ch6sc2_4d041f27:

#   di "You’re my only insurance that they won’t just run off into the sunset."
    di "Você é minha única garantia de que eles não vão simplesmente desaparecer no horizonte."

# game/chapters/chapter6/ch6sc2.rpy:3959
translate brazil ch6sc2_1b67455f:

#   di "[mc] made a deal with me. I'm handling things here while he handles the ambassador situation. I intend to uphold my end."
    di "[mc] Ele fez um acordo comigo. Estou cuidando das coisas aqui enquanto ele resolve a situação do embaixador. Pretendo cumprir minha parte."

# game/chapters/chapter6/ch6sc2.rpy:3961
translate brazil ch6sc2_6573bd15:

#   di "Upon returning with the ambassador, the charges of piracy against you and Pearl will be dropped."
    di "Ao retornar com o embaixador, as acusações de pirataria contra você e Pearl serão retiradas."

# game/chapters/chapter6/ch6sc2.rpy:3962
translate brazil ch6sc2_ec729e59:

#   di "Now, if you made yourself useful and helped me organize everything here..."
    di "Agora, se você se mostrou útil e me ajudou a organizar tudo aqui..."

# game/chapters/chapter6/ch6sc2.rpy:3964
translate brazil ch6sc2_fc243c8f:

#   di "We’d get it done sooner. And if [mc] and your sister still haven't returned by then, we can go look for them."
    di "Nós faríamos isso mais cedo. E se [mc] E se sua irmã ainda não tiver retornado até lá, podemos ir procurá-la."

# game/chapters/chapter6/ch6sc2.rpy:3966
translate brazil ch6sc2_20ffbd78:

#   ki "Tsk! ... what do you need from me?"
    ki "Tsc! ... o que você precisa de mim?"

# game/chapters/chapter6/ch6sc2.rpy:3977
translate brazil ch6sc2_eca4e0df:

#   mh "A’nu... you need to forget the outsider..."
    mh "A'nu... você precisa esquecer o forasteiro..."

# game/chapters/chapter6/ch6sc2.rpy:3978
translate brazil ch6sc2_67ef6158:

#   mh "We will not see him again. Your people need you to be out amongst them. Not hiding away up here..."
    mh "Não o veremos novamente. Seu povo precisa que você esteja entre eles. Não escondido aqui em cima..."

# game/chapters/chapter6/ch6sc2.rpy:3980
translate brazil ch6sc2_dee5bc7d:

#   ec "It’s been seven hours! I think our people can handle their responsibilities as usual."
    ec "Já se passaram sete horas! Acho que nossa equipe consegue lidar com suas responsabilidades como sempre."

# game/chapters/chapter6/ch6sc2.rpy:3981
translate brazil ch6sc2_c7a1ee86:

#   ec "If you believe there’s anything special they need to be doing, go and instruct them to do it yourself."
    ec "Se você acredita que eles precisam fazer algo específico, vá e instrua-os a fazer você mesmo."

# game/chapters/chapter6/ch6sc2.rpy:3983
translate brazil ch6sc2_28ad3bba:

#   mh "A’nu..."
    mh "Eu não vou..."

# game/chapters/chapter6/ch6sc2.rpy:3984
translate brazil ch6sc2_59c44c5e:

#   mh "Has this... outsider... really corrupted you so deeply already?"
    mh "Será que esse... forasteiro... já te corrompeu tão profundamente?"

# game/chapters/chapter6/ch6sc2.rpy:3985
translate brazil ch6sc2_5e730700:

#   mh "Will you abandon your duties as our A’nu, as the leader who guides us?"
    mh "Você abandonará seus deveres como nosso A'nu, como o líder que nos guia?"

# game/chapters/chapter6/ch6sc2.rpy:3987
translate brazil ch6sc2_43bd64b1:

#   ec "No, he has not corrupted my mind. He was sweet and kind, curious and respectful..."
    ec "Não, ele não corrompeu minha mente. Ele era doce e gentil, curioso e respeitoso..."

# game/chapters/chapter6/ch6sc2.rpy:3988
translate brazil ch6sc2_c6db4d25:

#   ec "I wished to know more about him."
    ec "Eu queria saber mais sobre ele."

# game/chapters/chapter6/ch6sc2.rpy:3989
translate brazil ch6sc2_ca3e2392:

#   ec "But I will never choose an outsider over our tribe. You know that!"
    ec "Mas eu jamais escolherei um forasteiro em detrimento da nossa tribo. Você sabe disso!"

# game/chapters/chapter6/ch6sc2.rpy:3991
translate brazil ch6sc2_5938b2fb:

#   ec "Yet, here you come before me..."
    ec "E, no entanto, aqui estás diante de mim..."

# game/chapters/chapter6/ch6sc2.rpy:3992
translate brazil ch6sc2_1e180f1b:

#   ec "Questioning my honor? My allegiance to our home?"
    ec "Questionando minha honra? Minha lealdade à nossa pátria?"

# game/chapters/chapter6/ch6sc2.rpy:3994
translate brazil ch6sc2_840b12a3:

#   mh "A’nu... Echo... *Sighs*"
    mh "A'nu... Echo... *Suspiros*"

# game/chapters/chapter6/ch6sc2.rpy:3995
translate brazil ch6sc2_964c8dd2:

#   mh "I know my actions have hurt you... that I went against your wishes."
    mh "Sei que minhas ações te magoaram... que agi contra a sua vontade."

# game/chapters/chapter6/ch6sc2.rpy:3997
translate brazil ch6sc2_9efb8489:

#   ec "*Scoffs* Hffh..."
    ec "*Risos* Hffh..."

# game/chapters/chapter6/ch6sc2.rpy:3999
translate brazil ch6sc2_be3708a6:

#   mh "I know my choice has soured our bond... damaged our trust."
    mh "Sei que minha escolha azedou nosso relacionamento... prejudicou nossa confiança."

# game/chapters/chapter6/ch6sc2.rpy:4001
translate brazil ch6sc2_bdb085a4:

#   ec "Yes, you have."
    ec "Sim, você tem."

# game/chapters/chapter6/ch6sc2.rpy:4002
translate brazil ch6sc2_e6a5ff38:

#   ec "You went against my will. You attacked my guest."
    ec "Você agiu contra a minha vontade. Você atacou meu convidado."

# game/chapters/chapter6/ch6sc2.rpy:4004
translate brazil ch6sc2_f6901e77:

#   mh "I did it for you, for our tribe, for us all-"
    mh "Fiz isso por você, pela nossa tribo, por todos nós."

# game/chapters/chapter6/ch6sc2.rpy:4006
translate brazil ch6sc2_b49aa899:

#   ec "*Scoffs* Don’t say you did it for everyone. You only did it for yourself!"
    ec "*Risos* Não diga que fez isso por todos. Você só fez por si mesmo!"

# game/chapters/chapter6/ch6sc2.rpy:4007
translate brazil ch6sc2_ec70d925:

#   ec "Because of your past experiences."
    ec "Devido às suas experiências passadas."

# game/chapters/chapter6/ch6sc2.rpy:4009
translate brazil ch6sc2_bab40b64:

#   ec "The only outsider who escaped back then, he is long dead!"
    ec "O único forasteiro que conseguiu escapar naquela época já está morto há muito tempo!"

# game/chapters/chapter6/ch6sc2.rpy:4010
translate brazil ch6sc2_c5d8dfbf:

#   ec "He wouldn’t survive decades on his own in the jungle. And he certainly has nothing to do with [mc]!"
    ec "Ele não sobreviveria décadas sozinho na selva. E certamente não tem nada a ver com isso. [mc]!"

# game/chapters/chapter6/ch6sc2.rpy:4012
translate brazil ch6sc2_893d8034:

#   mh "And what if he escaped the jungle?"
    mh "E se ele escapasse da selva?"

# game/chapters/chapter6/ch6sc2.rpy:4013
translate brazil ch6sc2_a4ebc7cf:

#   mh "What if he has spent decades planning to come back and finish what was started?"
    mh "E se ele passou décadas planejando voltar e terminar o que começou?"

# game/chapters/chapter6/ch6sc2.rpy:4015
translate brazil ch6sc2_9d914998:

#   mh "This [mc]... he's probably his lackey who he brought here to seduce us."
    mh "Esse [mc]... ele provavelmente é um dos capangas dele, que ele trouxe aqui para nos seduzir."

# game/chapters/chapter6/ch6sc2.rpy:4016
translate brazil ch6sc2_db21079e:

#   mh "And when we lower our guard..."
    mh "E quando baixamos a guarda..."

# game/chapters/chapter6/ch6sc2.rpy:4017
translate brazil ch6sc2_d8e843d8:

#   mh "Just like last time, they'll come in force to conquer us!"
    mh "Assim como da última vez, eles virão em peso para nos conquistar!"

# game/chapters/chapter6/ch6sc2.rpy:4019
translate brazil ch6sc2_06709f66:

#   mh "I have every right not to trust outsiders!"
    mh "Tenho todo o direito de não confiar em estranhos!"

# game/chapters/chapter6/ch6sc2.rpy:4020
translate brazil ch6sc2_ba871d15:

#   mh "Echo, this [mc]... he is just like them! I know it!"
    mh "Eco, isto [mc]...ele é igualzinho a eles! Eu sei disso!"

# game/chapters/chapter6/ch6sc2.rpy:4022
translate brazil ch6sc2_82fb291e:

#   mh "Had we given him the opportunity, he would happily have enslaved us. History would have repeated!"
    mh "Se lhe tivéssemos dado a oportunidade, ele nos teria escravizado com prazer. A história teria se repetido!"

# game/chapters/chapter6/ch6sc2.rpy:4024
translate brazil ch6sc2_560bbf4f:

#   ec "Despite your years and wisdom, Marah..."
    ec "Apesar de seus anos e sabedoria, Marah..."

# game/chapters/chapter6/ch6sc2.rpy:4025
translate brazil ch6sc2_661bac01:

#   ec "You’re not a shaman, nor are you a farseer."
    ec "Você não é um xamã, nem um vidente."

# game/chapters/chapter6/ch6sc2.rpy:4026
translate brazil ch6sc2_03022fc1:

#   ec "You are only a priestess. You cannot claim to know his heart."
    ec "Você é apenas uma sacerdotisa. Não pode afirmar conhecer o coração dele."

# game/chapters/chapter6/ch6sc2.rpy:4028
translate brazil ch6sc2_eb4444c2:

#   mh "I’m... I’m well aware that I’m no farseer, but you don’t need to be one to know that outsiders are bad!"
    mh "Eu... eu sei muito bem que não sou nenhum vidente, mas não precisa ser um para saber que forasteiros são ruins!"

# game/chapters/chapter6/ch6sc2.rpy:4030
translate brazil ch6sc2_1cc7d24a:

#   ec "Why are you here? Why have you come to see me?"
    ec "Por que você está aqui? Por que veio me ver?"

# game/chapters/chapter6/ch6sc2.rpy:4032
translate brazil ch6sc2_d07730ae:

#   mh "I desired to check up on you, A’nu... to make sure you remain strong as ever."
    mh "Eu queria saber como você está, A'nu... para ter certeza de que você continua forte como sempre."

# game/chapters/chapter6/ch6sc2.rpy:4033
translate brazil ch6sc2_03bfb3be:

#   mh "To ensure the outsider has not caused too much terror."
    mh "Para garantir que o forasteiro não tenha causado muito terror."

# game/chapters/chapter6/ch6sc2.rpy:4035
translate brazil ch6sc2_5237c9f0:

#   mh "His words... they nearly had me convinced, that's how dangerous he is!"
    mh "As palavras dele... quase me convenceram, de tão perigoso que ele é!"

# game/chapters/chapter6/ch6sc2.rpy:4036
translate brazil ch6sc2_15f78747:

#   mh "If he can convince me, he would be able to have all of A'nai eating out of his palm, tsk!"
    mh "Se ele conseguir me convencer, terá todo o povo de A'nai comendo na palma da mão dele, tsk!"

# game/chapters/chapter6/ch6sc2.rpy:4042
translate brazil ch6sc2_328a715e:

#   ec "My head is in the right place, if that’s what you’re asking me."
    ec "Se é isso que você está me perguntando, estou com a cabeça no lugar certo."

# game/chapters/chapter6/ch6sc2.rpy:4043
translate brazil ch6sc2_b21e4139:

#   ec "My duties as A’nu, as the leader of our people, are my reason to live."
    ec "Meus deveres como A'nu, como líder do nosso povo, são a razão da minha existência."

# game/chapters/chapter6/ch6sc2.rpy:4045
translate brazil ch6sc2_4e15f272:

#   ec "If you think to question that again... may the goddesses have mercy on you then."
    ec "Se você pensar em questionar isso novamente... que as deusas tenham misericórdia de você então."

# game/chapters/chapter6/ch6sc2.rpy:4047
translate brazil ch6sc2_0827123d:

#   mh "My A’nu... I meant no disrespect. I will take my leave and seek redemption from the goddesses."
    mh "Minha A'nu... Não tive a intenção de desrespeitar. Vou me retirar e buscar redenção junto às deusas."

# game/chapters/chapter6/ch6sc2.rpy:4048
translate brazil ch6sc2_a8b37a87:

#   mh "I will not have our trust broken."
    mh "Não permitirei que nossa confiança seja quebrada."

# game/chapters/chapter6/ch6sc2.rpy:4049
translate brazil ch6sc2_2e370df0:

#   mh "I can only hope they will guide me upon a path of mending."
    mh "Só posso esperar que eles me guiem por um caminho de cura."

# game/chapters/chapter6/ch6sc2.rpy:4053
translate brazil ch6sc2_652535a0:

#   ec "*Quietly* {size=-10}{b}This is the first time she has betrayed me... is her fear of outsiders so deeply rooted?{/b}{/size}"
    ec "*Em silêncio* {size=-10}{b}Esta é a primeira vez que ela me trai... será que o medo que ela tem de estranhos está tão enraizado assim?{/b}{/size}"

# game/chapters/chapter6/ch6sc2.rpy:4054
translate brazil ch6sc2_50d35f6d:

#   ec "*Quietly* {size=-10}{b}[mc]... I’m sorry I never got the chance to know you.{/b}{/size}"
    ec "*Em silêncio* {size=-10}{b}[mc]... Sinto muito por nunca ter tido a chance de te conhecer.{/b}{/size}"

# game/chapters/chapter6/ch6sc2.rpy:4063
translate brazil ch6sc2_85c8b45b:

#   "After following the passage from the throne room for hours, you finally see daylight."
    "Após percorrer o corredor que sai da sala do trono por horas, você finalmente vê a luz do dia."

# game/chapters/chapter6/ch6sc2.rpy:4066
translate brazil ch6sc2_d961f209:

#   mct "{i}Finally! I’m not sure how long I was down there for, but the sun is setting.{/i}"
    mct "{i}Finalmente! Não sei ao certo quanto tempo fiquei lá embaixo, mas o sol está se pondo.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:4068
translate brazil ch6sc2_62847160:

#   mct "{i}*Inhales deeply* Aaahh...{/i}"
    mct "{i}*Inspira profundamente* Aaahh...{/i}"

# game/chapters/chapter6/ch6sc2.rpy:4069
translate brazil ch6sc2_63d9a9f3:

#   mct "{i}The jungle air feels so fresh after being stuck in the dusty, ancient tomb.{/i}"
    mct "{i}O ar da selva parece tão fresco depois de ficar preso na tumba antiga e empoeirada.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:4071
translate brazil ch6sc2_fd84ad0a:

#   mct "{i}I’m never taking fresh air for granted again...{/i}"
    mct "{i}Nunca mais vou dar o ar fresco como garantido...{/i}"

# game/chapters/chapter6/ch6sc2.rpy:4073
translate brazil ch6sc2_cdabf5a6:

#   mct "{i}Huh? The wisps are reacting to something?{/i}"
    mct "{i}Hein? Os espíritos estão reagindo a alguma coisa?{/i}"

# game/chapters/chapter6/ch6sc2.rpy:4074
translate brazil ch6sc2_8c03cbfd:

#   mct "{i}Let’s see what it’s leading me to.{/i}"
    mct "{i}Vamos ver aonde isso vai me levar.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:4077
translate brazil ch6sc2_80841355:

#   mc "What's up, little guy? Where are you taking me?"
    mc "E aí, amiguinho? Aonde você está me levando?"

# game/chapters/chapter6/ch6sc2.rpy:4079
translate brazil ch6sc2_4a07567b:

#   mc "Huh? Is someone back there?"
    mc "Hein? Tem alguém aí atrás?"

# game/chapters/chapter6/ch6sc2.rpy:4080
translate brazil ch6sc2_21592d96:

#   mc "I think I can see someone behind the pillar."
    mc "Acho que consigo ver alguém atrás da coluna."

# game/chapters/chapter6/ch6sc2.rpy:4081
translate brazil ch6sc2_3a48c62b:

#   mc "Whoever is back there, make yourself known. I’m not in the mood for games."
    mc "Quem estiver aí atrás, se identifique. Não estou com paciência para joguinhos."

# game/chapters/chapter6/ch6sc2.rpy:4083
translate brazil ch6sc2_67cb42d0:

#   pl "[mc]...?"
    pl "[mc]...?"

# game/chapters/chapter6/ch6sc2.rpy:4084
translate brazil ch6sc2_7c833fac:

#   pl "*Shaky voice* Is that... is it really you?"
    pl "*Voz trêmula* É... é você mesmo?"

# game/chapters/chapter6/ch6sc2.rpy:4086
translate brazil ch6sc2_5cdcc6b5:

#   mc "Pearl? Pearl, is that you?"
    mc "Pérola? Pérola, é você?"

# game/chapters/chapter6/ch6sc2.rpy:4087
translate brazil ch6sc2_d0701254:

#   mc "Come, it’s okay. You’re safe now."
    mc "Venha, está tudo bem. Você está seguro agora."

# game/chapters/chapter6/ch6sc2.rpy:4090
translate brazil ch6sc2_06ff5644:

#   pl "MMffhh... [mc]... *Voice cracks* I-I couldn’t find you!"
    pl "MMffhh... [mc]... *A voz falha* Eu não consegui te encontrar!"

# game/chapters/chapter6/ch6sc2.rpy:4092
translate brazil ch6sc2_556ef437:

#   mc "Ssh-Shh... it’s okay, I’m right here."
    mc "Shhh... está tudo bem, eu estou bem aqui."

# game/chapters/chapter6/ch6sc2.rpy:4093
translate brazil ch6sc2_bb07d032:

#   mc "First, are you okay? Are you hurt?"
    mc "Primeiro, você está bem? Você se machucou?"

# game/chapters/chapter6/ch6sc2.rpy:4095
translate brazil ch6sc2_e9b8050b:

#   pl "Hurt? N-No ... I think I’m fine."
    pl "Machucado? N-Não... Acho que estou bem."

# game/chapters/chapter6/ch6sc2.rpy:4097
translate brazil ch6sc2_c5543c91:

#   mc "You don’t look fine, you’re covered in dirt and grime."
    mc "Você não parece bem, está coberto de sujeira e fuligem."

# game/chapters/chapter6/ch6sc2.rpy:4098
translate brazil ch6sc2_e46e96b2:

#   mc "And your feet are freezing ..."
    mc "E seus pés estão congelando..."

# game/chapters/chapter6/ch6sc2.rpy:4100
translate brazil ch6sc2_7c9b360d:

#   pl "It’s okay... I’m okay... you’re nice and warm."
    pl "Está tudo bem... eu estou bem... você está quentinho e aconchegante."

# game/chapters/chapter6/ch6sc2.rpy:4101
translate brazil ch6sc2_41b1aadf:

#   mc "I’m glad I found you, I know you’re fully capable of handling yourself, but I was a little worried..."
    mc "Fico feliz por ter te encontrado, sei que você é perfeitamente capaz de se virar sozinha, mas eu estava um pouco preocupada..."

# game/chapters/chapter6/ch6sc2.rpy:4103
translate brazil ch6sc2_74995ddf:

#   mc "But what are you doing here?"
    mc "Mas o que você está fazendo aqui?"

# game/chapters/chapter6/ch6sc2.rpy:4104
translate brazil ch6sc2_64af69a8:

#   mc "How’d you know where I was?"
    mc "Como você sabia onde eu estava?"

# game/chapters/chapter6/ch6sc2.rpy:4106
translate brazil ch6sc2_f93b6fd2:

#   pl "I didn’t... I’ve been hiding. This place seemed nice and sheltered."
    pl "Eu não... eu estava me escondendo. Este lugar parecia agradável e protegido."

# game/chapters/chapter6/ch6sc2.rpy:4107
translate brazil ch6sc2_32a6ac06:

#   pl "I was about to look inside that tunnel when I heard someone coming out, so I hid here not knowing what was going on."
    pl "Eu estava prestes a olhar dentro daquele túnel quando ouvi alguém saindo, então me escondi aqui sem saber o que estava acontecendo."

# game/chapters/chapter6/ch6sc2.rpy:4109
translate brazil ch6sc2_6bffeecd:

#   mc "It’s a blessing that you’re okay and unharmed."
    mc "É uma bênção que você esteja bem e ileso."

# game/chapters/chapter6/ch6sc2.rpy:4110
translate brazil ch6sc2_b974accb:

#   mc "You have no clue how happy I am to see you."
    mc "Você não faz ideia de como estou feliz em te ver."

# game/chapters/chapter6/ch6sc2.rpy:4112
translate brazil ch6sc2_0441917a:

#   pl "Me too, [mc]... I’m so happy to have found you."
    pl "Eu também, [mc]... Estou muito feliz por ter te encontrado."

# game/chapters/chapter6/ch6sc2.rpy:4113
translate brazil ch6sc2_3f5a3eae:

#   pl "I-I thought I’d never see you again..."
    pl "Pensei que nunca mais te veria..."

# game/chapters/chapter6/ch6sc2.rpy:4115
translate brazil ch6sc2_9334972a:

#   mc "Now, that’s crazy talk..."
    mc "Isso é uma loucura..."

# game/chapters/chapter6/ch6sc2.rpy:4116
translate brazil ch6sc2_0aa83de2:

#   mc "You know I’d be searching this jungle through and through for you."
    mc "Você sabe que eu vasculharia essa selva de cabo a rabo à sua procura."

# game/chapters/chapter6/ch6sc2.rpy:4118
translate brazil ch6sc2_5f626254:

#   pl "Really?"
    pl "Realmente?"

# game/chapters/chapter6/ch6sc2.rpy:4120
translate brazil ch6sc2_388e5491:

#   mc "Yeah... I don’t want to face Kira’s wrath if I return without you."
    mc "É... eu não quero enfrentar a ira de Kira se eu voltar sem você."

# game/chapters/chapter6/ch6sc2.rpy:4122
translate brazil ch6sc2_ef9da4a0:

#   pl "*Giggles* Ass..."
    pl "*Risos* Bunda..."

# game/chapters/chapter6/ch6sc2.rpy:4124
translate brazil ch6sc2_28fee9c0:

#   mc "You said you were hiding? What from?"
    mc "Você disse que estava se escondendo? De quê?"

# game/chapters/chapter6/ch6sc2.rpy:4126
translate brazil ch6sc2_644dc889:

#   pl "Yeah... when I woke up, I... I felt like I was being watched."
    pl "Sim... quando acordei, eu... senti como se estivesse sendo observado."

# game/chapters/chapter6/ch6sc2.rpy:4128
translate brazil ch6sc2_dba1c6e0:

#   pl "And sure enough, when I found some running water, an arrow flew right by my head when I bent down to quench my thirst."
    pl "E, como previsto, quando encontrei água corrente, uma flecha passou voando bem perto da minha cabeça quando me abaixei para matar a sede."

# game/chapters/chapter6/ch6sc2.rpy:4130
translate brazil ch6sc2_e8cf4bd1:

#   pl "So I legged it straight into the jungle..."
    pl "Então eu corri direto para a selva..."

# game/chapters/chapter6/ch6sc2.rpy:4131
translate brazil ch6sc2_fa771f1f:

#   pl "I lost my attackers, but I also lost my own bearings."
    pl "Perdi meus agressores, mas também perdi a noção de onde estava."

# game/chapters/chapter6/ch6sc2.rpy:4133
translate brazil ch6sc2_a0d0b4f5:

#   pl "I’ve been wandering around aimlessly ever since, looking for a safe spot to huddle up."
    pl "Desde então, tenho vagado sem rumo, procurando um lugar seguro para me aconchegar."

# game/chapters/chapter6/ch6sc2.rpy:4135
translate brazil ch6sc2_6ea17bf1:

#   pl "Huh, what’s this thing?"
    pl "Hum, o que é isso?"

# game/chapters/chapter6/ch6sc2.rpy:4136
translate brazil ch6sc2_caa37e9b:

#   mc "It’s a necklace or talisman of some sort... I found it deep inside that ruin I emerged from."
    mc "É um colar ou algum tipo de talismã... Encontrei-o no fundo daquela ruína de onde saí."

# game/chapters/chapter6/ch6sc2.rpy:4138
translate brazil ch6sc2_5540706c:

#   mc "It seems to have some magical properties, and it linked with me when I put it on."
    mc "Parece ter algumas propriedades mágicas, e senti uma conexão quando o coloquei."

# game/chapters/chapter6/ch6sc2.rpy:4140
translate brazil ch6sc2_733e5607:

#   pl "*Sighs* Okay..."
    pl "*Suspiro* Ok..."

# game/chapters/chapter6/ch6sc2.rpy:4142
translate brazil ch6sc2_c0057c42:

#   mc "*Chuckles* Just, okay?"
    mc "*Risos* Só... ok?"

# game/chapters/chapter6/ch6sc2.rpy:4144
translate brazil ch6sc2_a25dfc90:

#   pl "I’m too exhausted to be able to think about strange magical artifacts right now."
    pl "Estou tão exausto que não consigo pensar em estranhos artefatos mágicos agora."

# game/chapters/chapter6/ch6sc2.rpy:4146
translate brazil ch6sc2_4574f14a:

#   mc "Yeah, let’s get you out of here. The sun is setting and we don’t want to be stuck in the jungle at night."
    mc "Sim, vamos tirar você daqui. O sol está se pondo e não queremos ficar presos na selva à noite."

# game/chapters/chapter6/ch6sc2.rpy:4148
translate brazil ch6sc2_ac7ac68e:

#   pl "Where are we going? Did you find some shelter?"
    pl "Para onde vamos? Você encontrou algum abrigo?"

# game/chapters/chapter6/ch6sc2.rpy:4150
translate brazil ch6sc2_ece8d407:

#   mc "I may have befriended the locals."
    mc "Talvez eu tenha feito amizade com os moradores locais."

# game/chapters/chapter6/ch6sc2.rpy:4152
translate brazil ch6sc2_33092bb0:

#   mc "Well... some of them. I’d say half want me dead, and the other half seem... interested?"
    mc "Bem... alguns deles. Eu diria que metade quer me matar, e a outra metade parece... interessada?"

# game/chapters/chapter6/ch6sc2.rpy:4155
translate brazil ch6sc2_7060f5c5:

#   pl "Locals... the ones that were hunting me?!"
    pl "Moradores locais... aqueles que estavam me caçando?!"

# game/chapters/chapter6/ch6sc2.rpy:4157
translate brazil ch6sc2_d2524d1d:

#   mc "No. Apparently, there are two separate tribes inhabiting the island."
    mc "Não. Aparentemente, existem duas tribos distintas habitando a ilha."

# game/chapters/chapter6/ch6sc2.rpy:4158
translate brazil ch6sc2_a489def4:

#   mc "The semi-friendly ones from A’nai, and then the ones who probably shipwrecked us and were hunting you."
    mc "Os meio-amigáveis ​​de A'nai, e depois aqueles que provavelmente nos causaram o naufrágio e estavam à sua caça."

# game/chapters/chapter6/ch6sc2.rpy:4160
translate brazil ch6sc2_53a01f38:

#   mc "The Arugoh tribe."
    mc "A tribo Arugoh."

# game/chapters/chapter6/ch6sc2.rpy:4162
translate brazil ch6sc2_676109e8:

#   pl "So, we’re seeking shelter with the tribe where only half of them want us dead?"
    pl "Então, estamos buscando refúgio com a tribo onde apenas metade deles quer nos matar?"

# game/chapters/chapter6/ch6sc2.rpy:4164
translate brazil ch6sc2_f0cf74c2:

#   mc "*Chuckles* When you say it like that, it sounds like a bad idea."
    mc "*Risos* Quando você fala assim, parece uma má ideia."

# game/chapters/chapter6/ch6sc2.rpy:4165
translate brazil ch6sc2_dd40781e:

#   mc "But they aren’t that terrible, they're just very cautious about outsiders."
    mc "Mas eles não são tão terríveis assim, apenas são muito cautelosos com estranhos."

# game/chapters/chapter6/ch6sc2.rpy:4166
translate brazil ch6sc2_97cbb659:

#   mc "And... I was told they have baths."
    mc "E... me disseram que eles têm banheiras."

# game/chapters/chapter6/ch6sc2.rpy:4168
translate brazil ch6sc2_17dfdc9c:

#   pl "*Exhaustedly* Hnnghh... I can’t believe I’m risking my life for a bath... *Sighs* but I can’t deny the appeal."
    pl "*Exausta* Hnnghh... Não acredito que estou arriscando minha vida por um banho... *Suspiro* Mas não posso negar o apelo."

# game/chapters/chapter6/ch6sc2.rpy:4169
translate brazil ch6sc2_ec50f62f:

#   mc "Here, lean on me and I’ll get us there."
    mc "Aqui, apoie-se em mim e eu levarei vocês até lá."

# game/chapters/chapter6/ch6sc2.rpy:4171
translate brazil ch6sc2_db97f9d4:

#   pl "How do you even know where we’re going?"
    pl "Como você sabe para onde estamos indo?"

# game/chapters/chapter6/ch6sc2.rpy:4172
translate brazil ch6sc2_2f355509:

#   pl "Did you suddenly become King of the Jungle or something?"
    pl "Você se tornou o Rei da Selva de repente ou algo assim?"

# game/chapters/chapter6/ch6sc2.rpy:4174
translate brazil ch6sc2_53488dc6:

#   mc "*Chuckles* Who knows...?"
    mc "*Risos* Quem sabe...?"

# game/chapters/chapter6/ch6sc2.rpy:4175
translate brazil ch6sc2_230a2708:

#   mc "But this artifact, somehow it makes me feel in tune with the jungle."
    mc "Mas esse artefato, de alguma forma, me faz sentir em sintonia com a selva."

# game/chapters/chapter6/ch6sc2.rpy:4177
translate brazil ch6sc2_1ddbee09:

#   mc "*Language of the Ancients* Asha, locah A’nai."
    mc "*Língua dos Antigos* Asha, locah A'nai."

# game/chapters/chapter6/ch6sc2.rpy:4179
translate brazil ch6sc2_4f9f6c72:

#   pl "What the? Since when do you speak the tongue of the Ancients?"
    pl "O quê? Desde quando você fala a língua dos antigos?"

# game/chapters/chapter6/ch6sc2.rpy:4181
translate brazil ch6sc2_49fa49a2:

#   mc "I don’t know... I was just telling the wisps to guide us to A’nai... and it came out like that."
    mc "Não sei... Eu só estava pedindo aos espíritos da floresta que nos guiassem até A'nai... e saiu assim."

# game/chapters/chapter6/ch6sc2.rpy:4183
translate brazil ch6sc2_091a9b73:

#   pl "I’ve only heard Father use that language before... when he was researching ancient artifacts."
    pl "Só ouvi meu pai usar essa linguagem antes... quando ele estava pesquisando artefatos antigos."

# game/chapters/chapter6/ch6sc2.rpy:4184
translate brazil ch6sc2_4d06fd03:

#   pl "It took him years with his nose buried in ancient texts to learn a few sentences."
    pl "Ele levou anos com o nariz enfiado em textos antigos para aprender algumas frases."

# game/chapters/chapter6/ch6sc2.rpy:4186
translate brazil ch6sc2_c85b2e72:

#   mc "This artifact must have taught me the language, or something."
    mc "Esse artefato deve ter me ensinado o idioma, ou algo assim."

# game/chapters/chapter6/ch6sc2.rpy:4187
translate brazil ch6sc2_2fc1de61:

#   mc "C’mon, we’ll follow the wisp. It’ll lead us to A’nai."
    mc "Vamos lá, vamos seguir o rastro. Ele nos levará até A'nai."

# game/chapters/chapter6/ch6sc2.rpy:4189
translate brazil ch6sc2_9031b981:

#   pl "Y-Yeah... okay."
    pl "S-Sim... tudo bem."

# game/chapters/chapter6/ch6sc2.rpy:4190
translate brazil ch6sc2_16938939:

#   pl "A bath and a bed would be really nice..."
    pl "Uma banheira e uma cama seriam ótimas..."

# game/chapters/chapter6/ch6sc2.rpy:4191
translate brazil ch6sc2_3055c1b4:

#   mc "You’ll have both. Their leader was welcoming towards me, I’m sure she will be to you as well."
    mc "Você terá ambos. A líder deles foi receptiva comigo, tenho certeza de que será com você também."

# game/chapters/chapter6/ch6sc2.rpy:4196
translate brazil ch6sc2_a5b3c65e:

#   "About an hour of trekking through the undergrove of the jungle you arrive at the gates of A'nai."
    "Após cerca de uma hora de caminhada pela mata fechada da selva, você chegará aos portões de A'nai."

# game/chapters/chapter6/ch6sc2.rpy:4201
translate brazil ch6sc2_89359177:

#   mc "We’re here."
    mc "Estamos aqui."

# game/chapters/chapter6/ch6sc2.rpy:4202
translate brazil ch6sc2_18c6bdd3:

#   pl "I can’t believe that wisp of yours took us directly here..."
    pl "Não acredito que esse seu fio de luz nos trouxe diretamente para cá..."

# game/chapters/chapter6/ch6sc2.rpy:4204
translate brazil ch6sc2_42f50801:

#   sj "Is that...?"
    sj "É isso...?"

# game/chapters/chapter6/ch6sc2.rpy:4205
translate brazil ch6sc2_e99df48f:

#   sj "How did he...?"
    sj "Como ele fez isso...?"

# game/chapters/chapter6/ch6sc2.rpy:4207
translate brazil ch6sc2_5ea91b6b:

#   zy "By the goddesses, it is him!"
    zy "Pelas deusas, é ele mesmo!"

# game/chapters/chapter6/ch6sc2.rpy:4208
translate brazil ch6sc2_6557a43b:

#   zy "Looks like he has a woman with him too."
    zy "Parece que ele também está acompanhado de uma mulher."

# game/chapters/chapter6/ch6sc2.rpy:4210
translate brazil ch6sc2_de7fc9e2:

#   sj "Get the A’nu! She’ll want to see this... swiftly!"
    sj "Chame a A'nu! Ela vai querer ver isso... rapidinho!"

# game/chapters/chapter6/ch6sc2.rpy:4212
translate brazil ch6sc2_330b4aa2:

#   zy "I’ll be as swift as a leopard hunting its prey."
    zy "Serei tão veloz quanto um leopardo caçando sua presa."

# game/chapters/chapter6/ch6sc2.rpy:4214
translate brazil ch6sc2_a645b9b2:

#   sj "She’ll be pleased..."
    sj "Ela ficará satisfeita..."

# game/chapters/chapter6/ch6sc2.rpy:4215
translate brazil ch6sc2_ecb84526:

#   sj "Everyone was shocked when Marah proclaimed the outsider dead earlier."
    sj "Todos ficaram chocados quando Marah anunciou a morte do forasteiro."

# game/chapters/chapter6/ch6sc2.rpy:4223
translate brazil ch6sc2_e51ae20d:

#   zy "{b}A’nu!!{/b}"
    zy "{b}Não!!{/b}"

# game/chapters/chapter6/ch6sc2.rpy:4225
translate brazil ch6sc2_c7c856a9:

#   ec "Yes, Huntress?"
    ec "Sim, Caçadora?"

# game/chapters/chapter6/ch6sc2.rpy:4226
translate brazil ch6sc2_5779bded:

#   ec "Why are you out of breath? Did you sprint up all the stairs to my chamber?"
    ec "Por que você está sem fôlego? Subiu correndo todas as escadas até o meu quarto?"

# game/chapters/chapter6/ch6sc2.rpy:4228
translate brazil ch6sc2_14929916:

#   zy "Yes! Like a leopard, I bring news! There is something you must see!"
    zy "Sim! Como um leopardo, trago novidades! Há algo que você precisa ver!"

# game/chapters/chapter6/ch6sc2.rpy:4229
translate brazil ch6sc2_c6ab8a84:

#   zy "Your eyes will think it a dream."
    zy "Seus olhos acharão que é um sonho."

# game/chapters/chapter6/ch6sc2.rpy:4231
translate brazil ch6sc2_d8df7458:

#   ec "Can't Marah handle this?"
    ec "Será que a Marah não consegue lidar com isso?"

# game/chapters/chapter6/ch6sc2.rpy:4232
translate brazil ch6sc2_5fd3429d:

#   ec "I’m not feeling well today... I just want to be alone."
    ec "Não estou me sentindo bem hoje... Só quero ficar sozinha."

# game/chapters/chapter6/ch6sc2.rpy:4234
translate brazil ch6sc2_88355c57:

#   zy "I must insist, A’nu. You will not wish for Marah to handle this."
    zy "Devo insistir, A'nu. Você não vai querer que Marah lide com isso."

# game/chapters/chapter6/ch6sc2.rpy:4235
translate brazil ch6sc2_c37f0ce6:

#   zy "You will quite surprised. Pleasantly so, even!"
    zy "Você ficará bastante surpreso. E agradavelmente surpreso!"

# game/chapters/chapter6/ch6sc2.rpy:4237
translate brazil ch6sc2_b5c966ad:

#   ec "Oh? Is that so? Well, I suppose I’ll have to see it, then."
    ec "Ah, é mesmo? Bom, acho que terei que ver então."

# game/chapters/chapter6/ch6sc2.rpy:4238
translate brazil ch6sc2_45e39d97:

#   ec "Lead me to this pleasant surprise, Huntress."
    ec "Leve-me a esta agradável surpresa, Caçadora."

# game/chapters/chapter6/ch6sc2.rpy:4243
translate brazil ch6sc2_aa47725a:

#   sj "What happened? Why did you come from the jungle, and with... another outsider?"
    sj "O que aconteceu? Por que você veio da selva, e com... outro forasteiro?"

# game/chapters/chapter6/ch6sc2.rpy:4244
translate brazil ch6sc2_d1e3fa2b:

#   mc "As I said, your high-priestess... Marah... pushed me down a tunnel inside the temple."
    mc "Como eu disse, sua alta sacerdotisa... Marah... me empurrou para dentro de um túnel dentro do templo."

# game/chapters/chapter6/ch6sc2.rpy:4246
translate brazil ch6sc2_177b72aa:

#   sj "Marah did that? She committed an act of violence against a guest?"
    sj "Marah fez isso? Ela cometeu um ato de violência contra um hóspede?"

# game/chapters/chapter6/ch6sc2.rpy:4247
translate brazil ch6sc2_2b0b6a79:

#   sj "Hmm... that is anything but honorable."
    sj "Hum... isso está longe de ser honroso."

# game/chapters/chapter6/ch6sc2.rpy:4248
translate brazil ch6sc2_2ba0a980:

#   sj "You might be an outsider, but A’nu made it clear you were a guest and wanted you treated well."
    sj "Você pode ser um forasteiro, mas A'nu deixou claro que você era um convidado e queria que fosse bem tratado."

# game/chapters/chapter6/ch6sc2.rpy:4250
translate brazil ch6sc2_9787de49:

#   mc "Your high-priestess seems very paranoid. She was telling me about your people's past..."
    mc "Sua alta sacerdotisa parece muito paranoica. Ela estava me contando sobre o passado do seu povo..."

# game/chapters/chapter6/ch6sc2.rpy:4251
translate brazil ch6sc2_baf7c820:

#   mc "Then she led us down into the once-sacred chamber, which was turned into a prison."
    mc "Em seguida, ela nos conduziu até a câmara que outrora fora sagrada, mas que agora havia sido transformada em prisão."

# game/chapters/chapter6/ch6sc2.rpy:4252
translate brazil ch6sc2_719fcfd7:

#   mc "She tricked me into looking down a tunnel shaft and attacked."
    mc "Ela me enganou, fazendo-me olhar para dentro de um túnel, e então me atacou."

# game/chapters/chapter6/ch6sc2.rpy:4253
translate brazil ch6sc2_05dc7d1e:

#   mc "I managed to dodge her initial shove, but she had some kind of powder that knocked me out."
    mc "Consegui me esquivar do empurrão inicial dela, mas ela tinha algum tipo de pó que me deixou inconsciente."

# game/chapters/chapter6/ch6sc2.rpy:4255
translate brazil ch6sc2_55615b19:

#   sj "Typical... just like high-priestesses of the past."
    sj "Típico... igualzinho às altas sacerdotisas do passado."

# game/chapters/chapter6/ch6sc2.rpy:4257
translate brazil ch6sc2_62df6ce9:

#   mc "They have a history of being snakes?"
    mc "Eles têm um histórico de serem cobras?"

# game/chapters/chapter6/ch6sc2.rpy:4258
translate brazil ch6sc2_70452f3d:

#   sj "*Nods*"
    sj "*Acena com a cabeça*"

# game/chapters/chapter6/ch6sc2.rpy:4260
translate brazil ch6sc2_d3cdd39d:

#   sj "Mhm, they are second-in-command, directly below the A’nu."
    sj "Sim, eles são os segundos no comando, diretamente abaixo dos A'nu."

# game/chapters/chapter6/ch6sc2.rpy:4262
translate brazil ch6sc2_487e1579:

#   sj "Cunning, ambitious, ruthless... venomous women."
    sj "Astutas, ambiciosas, implacáveis... mulheres venenosas."

# game/chapters/chapter6/ch6sc2.rpy:4264
translate brazil ch6sc2_35f4476a:

#   sj "You’ll want to be careful with her."
    sj "É melhor ter cuidado com ela."

# game/chapters/chapter6/ch6sc2.rpy:4266
translate brazil ch6sc2_6fb1465c:

#   mc "Noted."
    mc "Observado."

# game/chapters/chapter6/ch6sc2.rpy:4268
translate brazil ch6sc2_d24faee1:

#   sj "So, you made it back here after being pushed into the underground?"
    sj "Então, você conseguiu voltar para cá depois de ter sido empurrado para o subterrâneo?"

# game/chapters/chapter6/ch6sc2.rpy:4270
translate brazil ch6sc2_d8c47a32:

#   mc "Yeah. At first I slid down a long, twisting tunnel that was dimly lit by some red light."
    mc "Sim. No início, deslizei por um túnel longo e sinuoso, fracamente iluminado por uma luz vermelha."

# game/chapters/chapter6/ch6sc2.rpy:4272
translate brazil ch6sc2_3c4e6f9d:

#   mc "At the end of the tunnel there was a fog-barrier that I fell right through. And I ended up in a large underground ruin."
    mc "No final do túnel havia uma barreira de neblina pela qual eu caí. E acabei em uma grande ruína subterrânea."

# game/chapters/chapter6/ch6sc2.rpy:4273
translate brazil ch6sc2_f0ca0a2a:

#   "The huntress observes you carefully as you recount these events."
    "A caçadora observa você atentamente enquanto você relata esses acontecimentos."

# game/chapters/chapter6/ch6sc2.rpy:4275
translate brazil ch6sc2_2f33aa84:

#   mc "It looked ancient... really ancient. And once again it was lit up by a red atmosphere."
    mc "Parecia antigo... muito antigo. E, mais uma vez, estava iluminado por uma atmosfera vermelha."

# game/chapters/chapter6/ch6sc2.rpy:4277
translate brazil ch6sc2_076be5c0:

#   mc "And it had these large, faceless statues, and they were holding... what looked like basins?"
    mc "E havia essas estátuas grandes e sem rosto, e elas estavam segurando... o que pareciam ser bacias?"

# game/chapters/chapter6/ch6sc2.rpy:4279
translate brazil ch6sc2_53b0e65d:

#   mc "After getting my bearings, I noticed a place with a different colored light. More of a teal hue. So I went to investigate."
    mc "Depois de me orientar, notei um lugar com uma luz de cor diferente. Mais para um tom azul-esverdeado. Então fui investigar."

# game/chapters/chapter6/ch6sc2.rpy:4281
translate brazil ch6sc2_118a688f:

#   mc "It led me to another fog-barrier, this time in the shape of a door. When I went through it, I found myself in a different hall."
    mc "Isso me levou a outra barreira de neblina, desta vez em forma de porta. Ao atravessá-la, me vi em um salão diferente."

# game/chapters/chapter6/ch6sc2.rpy:4283
translate brazil ch6sc2_fea5a149:

#   mc "I fought off a guardian golem and found myself in a treasury filled with gold, gemstones, relics and..."
    mc "Derrotei um golem guardião e me vi em um tesouro repleto de ouro, pedras preciosas, relíquias e..."

# game/chapters/chapter6/ch6sc2.rpy:4285
translate brazil ch6sc2_7a1bdef8:

#   sj "This... the necklace you’re wearing. You didn’t have it when I saw you last."
    sj "Este... o colar que você está usando. Você não o tinha quando a vi pela última vez."

# game/chapters/chapter6/ch6sc2.rpy:4286
translate brazil ch6sc2_480498e1:

#   sj "Amazing, you’re a... Nobody has ventured into the deep ruins and returned."
    sj "Incrível, você é... Ninguém jamais se aventurou nas ruínas profundas e retornou."

# game/chapters/chapter6/ch6sc2.rpy:4288
translate brazil ch6sc2_c69838c7:

#   mc "Nobody?"
    mc "Ninguém?"

# game/chapters/chapter6/ch6sc2.rpy:4289
translate brazil ch6sc2_23fd7077:

#   sj "None in my lifetime, at least."
    sj "Pelo menos não em toda a minha vida."

# game/chapters/chapter6/ch6sc2.rpy:4290
translate brazil ch6sc2_a24532f7:

#   sj "You’re the... only one."
    sj "Você é o único..."

# game/chapters/chapter6/ch6sc2.rpy:4292
translate brazil ch6sc2_a55ba4f4:

#   sj "I’m not sure what this means, but it feels... important."
    sj "Não sei bem o que isso significa, mas parece... importante."

# game/chapters/chapter6/ch6sc2.rpy:4293
translate brazil ch6sc2_9de99013:

#   sj "You must show it to our A’nu."
    sj "Você deve mostrá-lo ao nosso A'nu."

# game/chapters/chapter6/ch6sc2.rpy:4295
translate brazil ch6sc2_517b9ded:

#   sj "She’ll know."
    sj "Ela saberá."

# game/chapters/chapter6/ch6sc2.rpy:4297
translate brazil ch6sc2_2b1f59e5:

#   mc "I will. I trust her a great deal, she has been genuine with me."
    mc "Sim, eu confio muito nela, ela tem sido sincera comigo."

# game/chapters/chapter6/ch6sc2.rpy:4299
translate brazil ch6sc2_df3adc1b:

#   sj "Hmh... you’re interesting, Outsider."
    sj "Hum... você é interessante, Forasteiro."

# game/chapters/chapter6/ch6sc2.rpy:4300
translate brazil ch6sc2_9a1512df:

#   sj "There’s something special about you... something... primal."
    sj "Você tem algo de especial... algo... primitivo."

# game/chapters/chapter6/ch6sc2.rpy:4302
translate brazil ch6sc2_09f2de35:

#   mc "Is that so?"
    mc "É assim mesmo?"

# game/chapters/chapter6/ch6sc2.rpy:4304
translate brazil ch6sc2_c737ef3a:

#   sj "Yes, I feel it. Your energy, it’s... brave and powerful. You made it through the depths of A’nai unscathed."
    sj "Sim, eu sinto isso. Sua energia é... corajosa e poderosa. Você saiu ileso das profundezas de A'nai."

# game/chapters/chapter6/ch6sc2.rpy:4305
translate brazil ch6sc2_fe54c7bb:

#   mct "{i}*Chuckles* I wonder if that’s all she’s feeling... I know that look.{/i}"
    mct "{i}*Risos* Será que é só isso que ela está sentindo...? Conheço esse olhar.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:4307
translate brazil ch6sc2_1ca6d6ee:

#   sj "I believe... you’re on the path, Outsider."
    sj "Acredito que... você está no caminho certo, Forasteiro."

# game/chapters/chapter6/ch6sc2.rpy:4309
translate brazil ch6sc2_91796bcd:

#   mc "The path?"
    mc "O caminho?"

# game/chapters/chapter6/ch6sc2.rpy:4311
translate brazil ch6sc2_980dddcc:

#   sj "Mmm... {b}The Path of A’khans{/b}. The man who was promised..."
    sj "Hum... {b} O Caminho de A'khans{/b}O homem a quem foi prometido..."

# game/chapters/chapter6/ch6sc2.rpy:4313
translate brazil ch6sc2_0ad8fffc:

#   sj "Our legends tell that, one day, a great warrior will arise among us..."
    sj "Nossas lendas contam que, um dia, um grande guerreiro surgirá entre nós..."

# game/chapters/chapter6/ch6sc2.rpy:4314
translate brazil ch6sc2_235a4b4a:

#   sj "And his will, his determination, his power, his... primal energy will overshadow all previous A'khans."
    sj "E sua vontade, sua determinação, seu poder, sua... energia primordial ofuscarão todos os A'khans anteriores."

# game/chapters/chapter6/ch6sc2.rpy:4316
translate brazil ch6sc2_6283e355:

#   sj "A-Anyway..."
    sj "Enfim..."

# game/chapters/chapter6/ch6sc2.rpy:4317
translate brazil ch6sc2_f35b2322:

#   sj "I’m glad you’ve managed to find your friend and that she appears to be in good health."
    sj "Que bom que você conseguiu encontrar sua amiga e que ela parece estar bem de saúde."

# game/chapters/chapter6/ch6sc2.rpy:4319
translate brazil ch6sc2_2e96c6b6:

#   mc "Yeah, it was pure luck I managed to find her."
    mc "Sim, foi pura sorte eu ter conseguido encontrá-la."

# game/chapters/chapter6/ch6sc2.rpy:4320
translate brazil ch6sc2_291f4bcb:

#   sj "Echo... the A’nu, while you were in the Chambers of Malanthe, she asked us to keep an eye out for your friend."
    sj "Echo... a A'nu, enquanto você estava nas Câmaras de Malanthe, ela nos pediu para ficarmos de olho em seu amigo."

# game/chapters/chapter6/ch6sc2.rpy:4321
translate brazil ch6sc2_a31340dd:

#   mc "Really?"
    mc "Realmente?"

# game/chapters/chapter6/ch6sc2.rpy:4322
translate brazil ch6sc2_c713544e:

#   sj "*Nods* Mhm. The jungle is dangerous and she commanded we bring her back here immediately upon finding her."
    sj "*Acena com a cabeça* Hum. A selva é perigosa e ela ordenou que a trouxéssemos de volta imediatamente assim que a encontrássemos."

# game/chapters/chapter6/ch6sc2.rpy:4324
translate brazil ch6sc2_532a37a9:

#   sj "The jungle is a blessing and a curse... a shield and a trap."
    sj "A selva é uma bênção e uma maldição... um escudo e uma armadilha."

# game/chapters/chapter6/ch6sc2.rpy:4326
translate brazil ch6sc2_430e45ce:

#   mc "Yeah, nature does not discriminate. It gives and it takes."
    mc "Sim, a natureza não discrimina. Ela dá e tira."

# game/chapters/chapter6/ch6sc2.rpy:4328
translate brazil ch6sc2_e29bb293:

#   sj "Exactly... it’s all a matter of perspective."
    sj "Exatamente... tudo é uma questão de perspectiva."

# game/chapters/chapter6/ch6sc2.rpy:4330
translate brazil ch6sc2_cfa56cd4:

#   sj "Handsome, strong... and wise?"
    sj "Bonito, forte... e sábio?"

# game/chapters/chapter6/ch6sc2.rpy:4331
translate brazil ch6sc2_4d3d5047:

#   sj "You are a triple threat, [mc]."
    sj "Você é uma ameaça tripla, [mc]."

# game/chapters/chapter6/ch6sc2.rpy:4333
translate brazil ch6sc2_dd754948:

#   mc "You seem quite wise yourself."
    mc "Você parece ser bastante sábio(a)."

# game/chapters/chapter6/ch6sc2.rpy:4339
translate brazil ch6sc2_4ae7e1ec:

#   sj "Thank you..."
    sj "Obrigado..."

# game/chapters/chapter6/ch6sc2.rpy:4341
translate brazil ch6sc2_a4268875:

#   mc "And beautiful, too."
    mc "E também muito bonita."

# game/chapters/chapter6/ch6sc2.rpy:4342
translate brazil ch6sc2_82021f53:

#   mc "Not to mention strong, otherwise you wouldn’t be trusted as a huntress."
    mc "Sem falar na força, caso contrário você não seria confiável como caçadora."

# game/chapters/chapter6/ch6sc2.rpy:4344
translate brazil ch6sc2_253a20ef:

#   sj "*Scoffs lightly* [mc]... Outsider, you’re too much."
    sj "*Risos discretos* [mc]... Forasteiro, você é demais."

# game/chapters/chapter6/ch6sc2.rpy:4347
translate brazil ch6sc2_f24a384e:

#   sj "But... thank you, it was nice to hear."
    sj "Mas... obrigada, foi bom ouvir isso."

# game/chapters/chapter6/ch6sc2.rpy:4348
translate brazil ch6sc2_7b034b1a:

#   "Suji appreciates you noticing her, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Suji agradece por você ter notado ela, a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc2.rpy:4350
translate brazil ch6sc2_8190bea5:

#   mc "Anytime Suji, my gut feeling about you is that you're genuine."
    mc "Suji, sempre que precisar, minha intuição me diz que você é genuína."

# game/chapters/chapter6/ch6sc2.rpy:4352
translate brazil ch6sc2_92aa03cd:

#   sj "I'd like to believe I am, unless you cross us."
    sj "Gostaria de acreditar que sim, a menos que você nos contrarie."

# game/chapters/chapter6/ch6sc2.rpy:4354
translate brazil ch6sc2_91d39848:

#   mc "Genuine and protective? Attractive qualities in a woman."
    mc "Autêntica e protetora? Qualidades atraentes em uma mulher."

# game/chapters/chapter6/ch6sc2.rpy:4356
translate brazil ch6sc2_8306c718:

#   sj "You better stop talking like that..."
    sj "É melhor você parar de falar assim..."

# game/chapters/chapter6/ch6sc2.rpy:4357
translate brazil ch6sc2_583b6e58:

#   mct "*Chuckles* She's getting shy? I guess these huntresses aren't used to having a man around after all."
    mct "*Risos* Ela está ficando tímida? Acho que essas caçadoras não estão acostumadas a ter um homem por perto, afinal."

# game/chapters/chapter6/ch6sc2.rpy:4361
translate brazil ch6sc2_4e268b74:

#   sj "Thank you."
    sj "Obrigado."

# game/chapters/chapter6/ch6sc2.rpy:4365
translate brazil ch6sc2_917778d7:

#   ec "{b}[mc]!{/b}"
    ec "{b}[mc]!{/b}"

# game/chapters/chapter6/ch6sc2.rpy:4366
translate brazil ch6sc2_89de4fd5:

#   ec "Y-You’re here!? By the goddesses! Alive and unharmed?!"
    ec "V-Você está aqui?! Pelas deusas! Vivo e ileso?!"

# game/chapters/chapter6/ch6sc2.rpy:4367
translate brazil ch6sc2_54380d2d:

#   mc "Hey, Echo-"
    mc "Ei, Echo-"

# game/chapters/chapter6/ch6sc2.rpy:4369
translate brazil ch6sc2_24bc6af7:

#   ec "You’re back! I can’t believe this... and you’re okay? You’re not hurt?"
    ec "Você voltou! Não acredito... e você está bem? Não se machucou?"

# game/chapters/chapter6/ch6sc2.rpy:4370
translate brazil ch6sc2_8be471c2:

#   "She caresses both your cheeks as she looks you over for injuries."
    "Ela acaricia suas duas bochechas enquanto te examina em busca de ferimentos."

# game/chapters/chapter6/ch6sc2.rpy:4372
translate brazil ch6sc2_302d4b59:

#   ec "*Voice cracks* W-When you went down that tunnel, I thought I’d never see you again!"
    ec "*A voz falha* Q-Quando você desceu por aquele túnel, pensei que nunca mais te veria!"

# game/chapters/chapter6/ch6sc2.rpy:4373
translate brazil ch6sc2_434654ca:

#   ec "I feared the worst. I was so afraid I felt sick to my -"
    ec "Temi o pior. Estava com tanto medo que me senti enjoado."

# game/chapters/chapter6/ch6sc2.rpy:4375
translate brazil ch6sc2_1477929c:

#   mc "Hey... Echo, I’m here. I’m right here..."
    mc "Ei... Echo, estou aqui. Estou bem aqui..."

# game/chapters/chapter6/ch6sc2.rpy:4376
translate brazil ch6sc2_072c9220:

#   mc "You don’t need to worry any longer."
    mc "Você não precisa mais se preocupar."

# game/chapters/chapter6/ch6sc2.rpy:4377
translate brazil ch6sc2_fa80d372:

#   mc "I’m okay, it takes more than a little tumble through some ancient ruins to take me out."
    mc "Estou bem, não basta um pequeno tombo em ruínas antigas para me derrubar."

# game/chapters/chapter6/ch6sc2.rpy:4379
translate brazil ch6sc2_4b68e8bb:

#   ec "You jest... that must mean you’re fine? It seems my worrying was for naught."
    ec "Você está brincando... isso significa que você está bem? Parece que minha preocupação foi em vão."

# game/chapters/chapter6/ch6sc2.rpy:4380
translate brazil ch6sc2_bae8efff:

#   mc "You needn’t worry about me, I told you... I’m an adventurer."
    mc "Não precisa se preocupar comigo, eu já disse... Sou um aventureiro."

# game/chapters/chapter6/ch6sc2.rpy:4381
translate brazil ch6sc2_09ff6295:

#   mc "Handling the unexpected comes with the job."
    mc "Lidar com o inesperado faz parte do trabalho."

# game/chapters/chapter6/ch6sc2.rpy:4383
translate brazil ch6sc2_28775ba0:

#   ec "My instincts tell me you’re more than just an ordinary adventurer..."
    ec "Meu instinto me diz que você é mais do que apenas um aventureiro comum..."

# game/chapters/chapter6/ch6sc2.rpy:4384
translate brazil ch6sc2_f646bf03:

#   ec "Something... much more."
    ec "Algo... muito mais."

# game/chapters/chapter6/ch6sc2.rpy:4386
translate brazil ch6sc2_ca6b89e7:

#   sj "I believe your instincts are correct, A’nu."
    sj "Acredito que seus instintos estão corretos, A'nu."

# game/chapters/chapter6/ch6sc2.rpy:4387
translate brazil ch6sc2_882096fe:

#   sj "After his trial in the depths below the temple..."
    sj "Após seu julgamento nas profundezas abaixo do templo..."

# game/chapters/chapter6/ch6sc2.rpy:4389
translate brazil ch6sc2_9c95a645:

#   sj "I believe he might be the one our legends refer to. He has the spirit of A'khan within him."
    sj "Acredito que ele possa ser aquele a quem nossas lendas se referem. Ele possui o espírito de A'khan dentro de si."

# game/chapters/chapter6/ch6sc2.rpy:4391
translate brazil ch6sc2_8970d07a:

#   ec "Oh? That’s a bold claim to make, Huntress."
    ec "Ah, é mesmo? Essa é uma afirmação ousada, Caçadora."

# game/chapters/chapter6/ch6sc2.rpy:4392
translate brazil ch6sc2_07e0e1b3:

#   ec "You were quite against having him here this morning, but now you proclaim him our man of legend?"
    ec "Você era totalmente contra tê-lo aqui esta manhã, mas agora o proclama nosso homem lendário?"

# game/chapters/chapter6/ch6sc2.rpy:4394
translate brazil ch6sc2_5dbe4997:

#   sj "He emerged from the ancient tombs, the first in our lifetime. And look what he brought up from the depths!"
    sj "Ele emergiu das tumbas antigas, o primeiro em nossa geração. E vejam só o que ele trouxe das profundezas!"

# game/chapters/chapter6/ch6sc2.rpy:4396
translate brazil ch6sc2_ec6eae79:

#   ec "Fascinating..."
    ec "Fascinante..."

# game/chapters/chapter6/ch6sc2.rpy:4397
translate brazil ch6sc2_5abcb308:

#   ec "It looks like the Talisman of Malpheon, the one depicted in our tablets. It was wielded by the A’khans of old."
    ec "Parece-se com o Talismã de Malpheon, aquele representado em nossas tábuas. Era empunhado pelos A'khans da antiguidade."

# game/chapters/chapter6/ch6sc2.rpy:4399
translate brazil ch6sc2_5bc2b2dd:

#   ec "How in the name of the Goddesses did you manage to find this? It has been thought lost to time."
    ec "Como em nome das Deusas você conseguiu encontrar isso? Acreditava-se que estava perdido para sempre."

# game/chapters/chapter6/ch6sc2.rpy:4401
translate brazil ch6sc2_2657733f:

#   mc "It’s a long story."
    mc "É uma longa história."

# game/chapters/chapter6/ch6sc2.rpy:4402
translate brazil ch6sc2_cfcc6731:

#   "The two women stare you patiently."
    "As duas mulheres olham para você pacientemente."

# game/chapters/chapter6/ch6sc2.rpy:4403
translate brazil ch6sc2_c47da7f2:

#   mc "*Sighs*... So, here’s what happened -"
    mc "*Suspiro*... Então, eis o que aconteceu -"

# game/chapters/chapter6/ch6sc2.rpy:4408
translate brazil ch6sc2_93ee00b1:

#   "You go over your tomb raider tale once more... from start to finish."
    "Você repassa sua história de exploradora de tumbas mais uma vez... do começo ao fim."

# game/chapters/chapter6/ch6sc2.rpy:4413
translate brazil ch6sc2_8610603b:

#   ec "You... you truly are extraordinary. One of a kind."
    ec "Você... você é realmente extraordinário(a). Único(a)."

# game/chapters/chapter6/ch6sc2.rpy:4415
translate brazil ch6sc2_068ce039:

#   mc "If only you knew."
    mc "Quem dera você soubesse."

# game/chapters/chapter6/ch6sc2.rpy:4417
translate brazil ch6sc2_219c7ae5:

#   ec "I will have to speak to the village Elders. They know our history and ancient tales better than anymore."
    ec "Vou ter que falar com os anciãos da aldeia. Eles conhecem nossa história e contos ancestrais melhor do que ninguém."

# game/chapters/chapter6/ch6sc2.rpy:4418
translate brazil ch6sc2_590a3d59:

#   ec "Their guidance and knowledge will be important going forward."
    ec "A orientação e o conhecimento deles serão importantes daqui para frente."

# game/chapters/chapter6/ch6sc2.rpy:4420
translate brazil ch6sc2_30f5d312:

#   sj "A’nu, if I remember correctly, some of the tales of old speak of this necklace and other ancient relics."
    sj "A'nu, se bem me lembro, algumas histórias antigas falam desse colar e de outras relíquias ancestrais."

# game/chapters/chapter6/ch6sc2.rpy:4421
translate brazil ch6sc2_75a928f2:

#   sj "They say the man who will arise as the greatest A’khan and elevate our people will undergo a series of trials."
    sj "Dizem que o homem que surgir como o maior A'khan e elevará nosso povo passará por uma série de provações."

# game/chapters/chapter6/ch6sc2.rpy:4423
translate brazil ch6sc2_749c409c:

#   sj "If such tales are true, then the outsider... [mc]... has completed the first trial of the A'khans."
    sj "Se essas histórias forem verdadeiras, então o forasteiro... [mc]... concluiu o primeiro julgamento dos A'khans."

# game/chapters/chapter6/ch6sc2.rpy:4425
translate brazil ch6sc2_45f4199e:

#   ec "That is what I believe too, Suji. But I’ll have to confirm this knowledge."
    ec "Eu também acredito nisso, Suji. Mas preciso confirmar essa informação."

# game/chapters/chapter6/ch6sc2.rpy:4426
translate brazil ch6sc2_4b9cb556:

#   ec "You've completed the trial unharmed, not even a scratch on you."
    ec "Você concluiu o teste ileso, sem um único arranhão."

# game/chapters/chapter6/ch6sc2.rpy:4428
translate brazil ch6sc2_22c0ce76:

#   ec "And this... you acquired an artifact of Malpheon. The first in several generations to do so."
    ec "E isto... você adquiriu um artefato de Malpheon. O primeiro em várias gerações a fazê-lo."

# game/chapters/chapter6/ch6sc2.rpy:4429
translate brazil ch6sc2_a532fbb6:

#   ec "*Quietly* Intriguing... you may very well be..."
    ec "*Discretamente* intrigante... você pode muito bem estar..."

# game/chapters/chapter6/ch6sc2.rpy:4431
translate brazil ch6sc2_3129be68:

#   mc "What? What is it, Echo?"
    mc "O quê? O que foi, Echo?"

# game/chapters/chapter6/ch6sc2.rpy:4432
translate brazil ch6sc2_3c61e39d:

#   ec "Hmm..."
    ec "Hum..."

# game/chapters/chapter6/ch6sc2.rpy:4434
translate brazil ch6sc2_bf802079:

#   ec "I wonder... if the other temples of the goddesses hold similar challenges?"
    ec "Será que os outros templos das deusas apresentam desafios semelhantes?"

# game/chapters/chapter6/ch6sc2.rpy:4435
translate brazil ch6sc2_111074cc:

#   ec "If so, then you could -"
    ec "Se for esse o caso, então você poderia -"

# game/chapters/chapter6/ch6sc2.rpy:4437
translate brazil ch6sc2_76f9bf3e:

#   ec "Oh? You’ve found your friend too? I had asked my huntresses to help you search for her."
    ec "Ah? Você também encontrou sua amiga? Eu havia pedido às minhas caçadoras que ajudassem você a procurá-la."

# game/chapters/chapter6/ch6sc2.rpy:4439
translate brazil ch6sc2_0071409c:

#   mc "Yeah, Suji mentioned you asked them to help. Thank you for the gesture."
    mc "Sim, a Suji mencionou que você pediu ajuda a eles. Obrigada pela gentileza."

# game/chapters/chapter6/ch6sc2.rpy:4440
translate brazil ch6sc2_324b09fe:

#   ec "Will you introduce me? I’d love to meet her."
    ec "Você poderia me apresentar a ela? Eu adoraria conhecê-la."

# game/chapters/chapter6/ch6sc2.rpy:4442
translate brazil ch6sc2_549518f5:

#   mc "Pearl, there’s someone I’d like you to meet. Echo, the A’nu of the tribe."
    mc "Pearl, tem alguém que eu gostaria que você conhecesse. Echo, a A'nu da tribo."

# game/chapters/chapter6/ch6sc2.rpy:4443
translate brazil ch6sc2_e44d9c96:

#   ec "Hello, friend of [mc]."
    ec "Olá, amigo de [mc]."

# game/chapters/chapter6/ch6sc2.rpy:4445
translate brazil ch6sc2_370e9c81:

#   pl "Hi! I’m Pearl, thank you for letting us inside your city."
    pl "Olá! Sou Pearl, obrigada por nos permitirem entrar em sua cidade."

# game/chapters/chapter6/ch6sc2.rpy:4446
translate brazil ch6sc2_ca461835:

#   pl "This place is incredible, and your hospitality is more than we could hope for."
    pl "Este lugar é incrível, e a sua hospitalidade superou todas as nossas expectativas."

# game/chapters/chapter6/ch6sc2.rpy:4448
translate brazil ch6sc2_50e3f0c0:

#   ec "Thank you. That’s very kind of you to say. [mc] said something similar when he first saw our home."
    ec "Obrigado. É muita gentileza sua dizer isso. [mc] Ele disse algo semelhante quando viu nossa casa pela primeira vez."

# game/chapters/chapter6/ch6sc2.rpy:4449
translate brazil ch6sc2_e23028fe:

#   ec "As for our hospitality, think nothing of it."
    ec "Quanto à nossa hospitalidade, não hesite em nos contatar."

# game/chapters/chapter6/ch6sc2.rpy:4450
translate brazil ch6sc2_e8ba51e7:

#   ec "I will not have either of you trekking around in the jungle. It is not safe."
    ec "Não permitirei que nenhum de vocês faça trilhas na selva. Não é seguro."

# game/chapters/chapter6/ch6sc2.rpy:4452
translate brazil ch6sc2_ff656677:

#   pl "Y-Yeah... I've come to realize that."
    pl "É... eu cheguei a essa conclusão."

# game/chapters/chapter6/ch6sc2.rpy:4454
translate brazil ch6sc2_92b65bdd:

#   ec "You look like you’ve been through hell and back..."
    ec "Você parece ter passado por poucas e boas..."

# game/chapters/chapter6/ch6sc2.rpy:4455
translate brazil ch6sc2_02b35334:

#   ec "The two of you must rest, relax, and clean up."
    ec "Vocês dois precisam descansar, relaxar e se limpar."

# game/chapters/chapter6/ch6sc2.rpy:4457
translate brazil ch6sc2_18133a53:

#   pl "Being chased through the jungle by unknown attackers has left me a little tired..."
    pl "Ser perseguido na selva por atacantes desconhecidos me deixou um pouco cansado..."

# game/chapters/chapter6/ch6sc2.rpy:4458
translate brazil ch6sc2_6197a4af:

#   pl "Thank you for allowing this."
    pl "Obrigado por permitir isso."

# game/chapters/chapter6/ch6sc2.rpy:4460
translate brazil ch6sc2_daabf233:

#   ec "I will have a maiden prepare you a bath. The baths are located on the ground floor of the temple."
    ec "Pedirei a uma criada que prepare um banho para você. Os banhos estão localizados no térreo do templo."

# game/chapters/chapter6/ch6sc2.rpy:4461
translate brazil ch6sc2_5239662d:

#   ec "The waters come from an underground spring. They're both warm and soothing."
    ec "As águas provêm de uma nascente subterrânea. São quentes e relaxantes."

# game/chapters/chapter6/ch6sc2.rpy:4463
translate brazil ch6sc2_d702a03c:

#   pl "A natural hotspring?"
    pl "Uma fonte termal natural?"

# game/chapters/chapter6/ch6sc2.rpy:4464
translate brazil ch6sc2_4c360f63:

#   pl "Right here, below your temple?"
    pl "Bem aqui, abaixo da sua têmpora?"

# game/chapters/chapter6/ch6sc2.rpy:4466
translate brazil ch6sc2_bd153151:

#   ec "*Giggles softly* It surprises you?"
    ec "*Risinhos suaves* Isso te surpreende?"

# game/chapters/chapter6/ch6sc2.rpy:4467
translate brazil ch6sc2_8fcca7b4:

#   ec "We don't bathe in murky rivers just because we live in the jungle."
    ec "Não tomamos banho em rios turvos só porque vivemos na selva."

# game/chapters/chapter6/ch6sc2.rpy:4468
translate brazil ch6sc2_925719a1:

#   ec "The ones who built the temple must’ve enjoyed bathing too."
    ec "Aqueles que construíram o templo também deviam gostar de tomar banho."

# game/chapters/chapter6/ch6sc2.rpy:4469
translate brazil ch6sc2_aa1f6aed:

#   ec "They made an incredible bath chamber and it’s built directly on top of the hot spring."
    ec "Eles construíram uma incrível câmara de banho, que foi erguida diretamente sobre a fonte termal."

# game/chapters/chapter6/ch6sc2.rpy:4471
translate brazil ch6sc2_3bc2bd48:

#   pl "It sounds incredible... I’m almost scared I’m dreaming right now."
    pl "Parece incrível... Estou quase com medo de estar sonhando."

# game/chapters/chapter6/ch6sc2.rpy:4473
translate brazil ch6sc2_d7a91057:

#   ec "Come, you two. Let us not remain idle."
    ec "Venham, vocês dois. Não fiquemos ociosos."

# game/chapters/chapter6/ch6sc2.rpy:4474
translate brazil ch6sc2_e3476f28:

#   ec "I'll lead you to the baths, there you will be able to relax and freshen up."
    ec "Vou te levar aos banhos, lá você poderá relaxar e se refrescar."

# game/chapters/chapter6/ch6sc2.rpy:4476
translate brazil ch6sc2_cc8ca86f:

#   pl "You’re too generous... thank you!"
    pl "Você é muito generoso... muito obrigado!"

# game/chapters/chapter6/ch6sc2.rpy:4477
translate brazil ch6sc2_d7666983:

#   ec "I'm just pleased you're both alright. Please, follow me."
    ec "Fico feliz que vocês dois estejam bem. Por favor, me sigam."

# game/chapters/chapter6/ch6sc2.rpy:4479
translate brazil ch6sc2_249f237c:

#   pl "I can’t believe it... you really did befriend the locals! Their leader is so kind to us."
    pl "Não acredito... você realmente fez amizade com os moradores locais! O líder deles é muito gentil conosco."

# game/chapters/chapter6/ch6sc2.rpy:4481
translate brazil ch6sc2_97494c54:

#   mc "*Chuckles* I told you, didn’t I?"
    mc "*Risos* Eu te disse, não disse?"

# game/chapters/chapter6/ch6sc2.rpy:4483
translate brazil ch6sc2_581cf299:

#   pl "Mhm-Hm... still, I had to see it with my own eyes."
    pl "Hum-hum... mesmo assim, eu precisava ver com meus próprios olhos."

# game/chapters/chapter6/ch6sc2.rpy:4485
translate brazil ch6sc2_51fd5499:

#   pl "You aren’t known to be the most social of butterflies! *Giggles*"
    pl "Você não é conhecida por ser a pessoa mais sociável do mundo! *Risos*"

# game/chapters/chapter6/ch6sc2.rpy:4486
translate brazil ch6sc2_0ebed171:

#   mc "I befriended a whole tribe while you made enemies with another. You may have to retract that statement."
    mc "Eu fiz amizade com uma tribo inteira enquanto você fez inimigos com outra. Talvez você tenha que se retratar dessa afirmação."

# game/chapters/chapter6/ch6sc2.rpy:4488
translate brazil ch6sc2_3bca873a:

#   pl "*Snickers* Fair. C’mon, we have a bath waiting for us!"
    pl "*Risos* Justo. Vamos, temos um banho nos esperando!"

# game/chapters/chapter6/ch6sc2.rpy:4490
translate brazil ch6sc2_1070f1c4:

#   mc "After you, little mermaid."
    mc "Depois de você, pequena sereia."

# game/chapters/chapter6/ch6sc2.rpy:4497
translate brazil ch6sc2_3c7bed17:

#   mh "Tsk! ..."
    mh "Tsc! ..."

# game/chapters/chapter6/ch6sc2.rpy:4498
translate brazil ch6sc2_8619d3aa:

#   mh "By all the goddesses! How did he survive falling into the ancient depths?"
    mh "Por todas as deusas! Como ele sobreviveu à queda nas profundezas ancestrais?"

# game/chapters/chapter6/ch6sc2.rpy:4499
translate brazil ch6sc2_fdd39eda:

#   mh "Bastard... nobody has ever survived a journey there."
    mh "Maldito... ninguém jamais sobreviveu a uma viagem até lá."

# game/chapters/chapter6/ch6sc2.rpy:4501
translate brazil ch6sc2_34ba9b72:

#   mh "Goddesses, I’ve failed you. I must do more to protect us..."
    mh "Deusas, eu falhei com vocês. Devo fazer mais para nos proteger..."

# game/chapters/chapter6/ch6sc2.rpy:4502
translate brazil ch6sc2_7432f756:

#   mh "I will not let this... outsider... corrupt us. His presence here is a mockery of us all."
    mh "Não permitirei que esse... forasteiro... nos corrompa. Sua presença aqui é uma afronta a todos nós."

# game/chapters/chapter6/ch6sc2.rpy:4504
translate brazil ch6sc2_f7a6ef7a:

#   mh "I will have to take things into my own hands... Mhm."
    mh "Vou ter que tomar as rédeas da situação... Hum."

# game/chapters/chapter6/ch6sc2.rpy:4505
translate brazil ch6sc2_c8acddc8:

#   mh "So much to do. I can’t allow this to go on!"
    mh "Há tanta coisa para fazer. Não posso deixar isso continuar!"

# game/chapters/chapter6/ch6sc2.rpy:4516
translate brazil ch6sc2_7afe0db0:

#   el "Great work today, Borri. I wouldn’t have managed to build that shelter for the building materials without you."
    el "Excelente trabalho hoje, Borri. Eu não teria conseguido construir aquele abrigo para os materiais de construção sem você."

# game/chapters/chapter6/ch6sc2.rpy:4518
translate brazil ch6sc2_60eda22b:

#   br "Bah! Ye would’ve done just fine. Might’ve taken a few extra nails, but yer more than capable, lass."
    br "Bah! Você teria se saído muito bem. Talvez precisasse de algumas unhas a mais, mas você é mais do que capaz, garota."

# game/chapters/chapter6/ch6sc2.rpy:4520
translate brazil ch6sc2_f3c63693:

#   el "Be that as it may, I’m still grateful for the help."
    el "Seja como for, continuo grato pela ajuda."

# game/chapters/chapter6/ch6sc2.rpy:4521
translate brazil ch6sc2_a9a1099f:

#   el "It feels good to have something to do... while [mc] is away."
    el "É bom ter algo para fazer... enquanto [mc] está ausente."

# game/chapters/chapter6/ch6sc2.rpy:4523
translate brazil ch6sc2_2db5cdcd:

#   br "Aye, I don’t want ye locking yerself in a room fer a week again..."
    br "É, eu não quero que você se tranque num quarto por uma semana de novo..."

# game/chapters/chapter6/ch6sc2.rpy:4525
translate brazil ch6sc2_9977125d:

#   el "Hey! ... Rude."
    el "Ei! ... Que grosseria."

# game/chapters/chapter6/ch6sc2.rpy:4527
translate brazil ch6sc2_253db6f8:

#   el "Do you think he’s okay? It sounded like his friends, Kira and Pearl, were in serious trouble."
    el "Você acha que ele está bem? Parecia que os amigos dele, Kira e Pearl, estavam em apuros sérios."

# game/chapters/chapter6/ch6sc2.rpy:4529
translate brazil ch6sc2_403cf542:

#   br "Bah! The lad will be fine. Ye know him... trouble follows him everywhere, but he always handles it."
    br "Ora! O rapaz vai ficar bem. Você o conhece... os problemas o perseguem por todo lado, mas ele sempre dá um jeito."

# game/chapters/chapter6/ch6sc2.rpy:4531
translate brazil ch6sc2_c2872b2e:

#   el "Yeah... you’re right. I’m going to continue working long shifts at the guild to earn more coin while he’s gone."
    el "É... você tem razão. Vou continuar trabalhando em turnos longos na guilda para ganhar mais dinheiro enquanto ele estiver fora."

# game/chapters/chapter6/ch6sc2.rpy:4533
translate brazil ch6sc2_9652b835:

#   el "We might have been given the basic materials by King Bennen, but we'll need so much more."
    el "Talvez o Rei Bennen tenha nos dado os materiais básicos, mas precisaremos de muito mais."

# game/chapters/chapter6/ch6sc2.rpy:4535
translate brazil ch6sc2_1381119a:

#   br "Hah! Don’t tell me yer already thinking about furniture, lass? *Chuckles*"
    br "Hah! Não me diga que você já está pensando em móveis, moça? *Risos*"

# game/chapters/chapter6/ch6sc2.rpy:4536
translate brazil ch6sc2_a9df1efe:

#   el "What? It’s a valid thing to think about!"
    el "O quê? É algo válido para se pensar!"

# game/chapters/chapter6/ch6sc2.rpy:4538
translate brazil ch6sc2_71aa4dc9:

#   el "A home will do us little good if it’s just going to be empty."
    el "Uma casa não nos servirá de nada se ficar vazia."

# game/chapters/chapter6/ch6sc2.rpy:4539
translate brazil ch6sc2_9ce3e788:

#   el "[mc] agrees with me. It didn’t take much to convince him after he had tried the beds at Palace Valois."
    el "[mc] Concordo comigo. Não foi preciso muito para convencê-lo depois que ele experimentou as camas do Palace Valois."

# game/chapters/chapter6/ch6sc2.rpy:4541
translate brazil ch6sc2_9a922679:

#   br "*Chuckles* Heh! I bet he had a sore back from the soft mattresses!"
    br "*Risos* Heh! Aposto que ele ficou com dor nas costas por causa dos colchões macios!"

# game/chapters/chapter6/ch6sc2.rpy:4542
translate brazil ch6sc2_85b920f4:

#   el "No way! That’s not a thing... is it?"
    el "De jeito nenhum! Isso não existe... existe?"

# game/chapters/chapter6/ch6sc2.rpy:4544
translate brazil ch6sc2_59dc4639:

#   br "Those puppy eyes of yours, lass, they'll have him agreeing to just about anything."
    br "Esses seus olhinhos de cachorro pidão, garota, vão fazer ele concordar com quase tudo."

# game/chapters/chapter6/ch6sc2.rpy:4546
translate brazil ch6sc2_6af7eda2:

#   el "Huuh? Are you suggesting I’m only getting my way because I’m pretty?"
    el "Hã? Você está sugerindo que eu só consigo o que quero porque sou bonita?"

# game/chapters/chapter6/ch6sc2.rpy:4548
translate brazil ch6sc2_6d77e468:

#   br "Nay, lass. Not because yer pretty... because he loves ye, through and through."
    br "Não, querida. Não é porque você é bonita... é porque ele te ama completamente."

# game/chapters/chapter6/ch6sc2.rpy:4550
translate brazil ch6sc2_0accc66a:

#   el "And I him... *Sighs* Do you think... he’ll be back soon?"
    el "E eu... *Suspiro* Você acha que... ele voltará em breve?"

# game/chapters/chapter6/ch6sc2.rpy:4552
translate brazil ch6sc2_01c15d44:

#   br "He'll be back before ye know it, lass. I think ye had the right idea about keeping busy."
    br "Ele volta antes que você perceba, moça. Acho que você teve a ideia certa de se manter ocupada."

# game/chapters/chapter6/ch6sc2.rpy:4553
translate brazil ch6sc2_7f42d96b:

#   br "The less time yer mind has t' think about it, t' sooner he’ll pop up."
    br "Quanto menos tempo sua mente tiver para pensar nisso, mais cedo ele aparecerá."

# game/chapters/chapter6/ch6sc2.rpy:4555
translate brazil ch6sc2_2220119d:

#   el "Yeah... I’m getting another ale."
    el "Sim... Vou pegar outra cerveja."

# game/chapters/chapter6/ch6sc2.rpy:4557
translate brazil ch6sc2_f8b7b40d:

#   el "Do you want one too?"
    el "Você também quer um?"

# game/chapters/chapter6/ch6sc2.rpy:4558
translate brazil ch6sc2_2ead0deb:

#   br "Aye! Thank ye, lass."
    br "Sim! Obrigada, moça."

# game/chapters/chapter6/ch6sc2.rpy:4560
translate brazil ch6sc2_0b204973:

#   br "Make it two! Me ol' bones are in need of a good night's rest!"
    br "Que sejam dois! Meus ossos precisam de uma boa noite de sono!"

# game/chapters/chapter6/ch6sc2.rpy:4561
translate brazil ch6sc2_b0be21c2:

#   el "*Shouting* You’re not that old!"
    el "*Gritando* Você não é tão velho assim!"

# game/chapters/chapter6/ch6sc2.rpy:4574
translate brazil ch6sc2_ba8005ea:

#   pl "Woah... Echo! I’ve never seen anything like this!"
    pl "Uau... Echo! Nunca vi nada igual!"

# game/chapters/chapter6/ch6sc2.rpy:4576
translate brazil ch6sc2_d2e61566:

#   pl "Calling this a bath is an understatement!"
    pl "Chamar isso de banho é um eufemismo!"

# game/chapters/chapter6/ch6sc2.rpy:4577
translate brazil ch6sc2_655fde38:

#   ec "It pleases me to hear that you’re happy about this place."
    ec "Fico feliz em saber que você está contente com este lugar."

# game/chapters/chapter6/ch6sc2.rpy:4579
translate brazil ch6sc2_221c95cc:

#   pl "I am... this is like a dream. Thank you so much."
    pl "Estou... isto é como um sonho. Muito obrigada."

# game/chapters/chapter6/ch6sc2.rpy:4580
translate brazil ch6sc2_0eb8d196:

#   ec "You are welcome, I’m just glad the two of you are alright."
    ec "De nada, fico feliz que vocês dois estejam bem."

# game/chapters/chapter6/ch6sc2.rpy:4582
translate brazil ch6sc2_ad6c766c:

#   mc "The water looks so refreshing..."
    mc "A água parece tão refrescante..."

# game/chapters/chapter6/ch6sc2.rpy:4583
translate brazil ch6sc2_edeb1638:

#   mc "Why does it have that slightly teal tint even though we're indoors?"
    mc "Por que tem esse tom levemente azulado mesmo estando em um ambiente interno?"

# game/chapters/chapter6/ch6sc2.rpy:4585
translate brazil ch6sc2_24f4f89e:

#   ec "Remember how I told you our ancestors worshipped Malpheon?"
    ec "Lembra quando eu te disse que nossos ancestrais adoravam Malpheon?"

# game/chapters/chapter6/ch6sc2.rpy:4586
translate brazil ch6sc2_010d57f7:

#   ec "According to legend, they used one of the blessings they received from him to enchant the hot spring below here."
    ec "Segundo a lenda, eles usaram uma das bênçãos que receberam dele para encantar a fonte termal que fica aqui embaixo."

# game/chapters/chapter6/ch6sc2.rpy:4587
translate brazil ch6sc2_2f847701:

#   ec "The water will stay eternally fresh, warm and cleansed."
    ec "A água permanecerá eternamente fresca, quente e purificada."

# game/chapters/chapter6/ch6sc2.rpy:4588
translate brazil ch6sc2_d84d314f:

#   mc "Enchanted water... huh, your tribe really has a nice setup here."
    mc "Água encantada... hum, sua tribo realmente tem uma estrutura muito boa aqui."

# game/chapters/chapter6/ch6sc2.rpy:4590
translate brazil ch6sc2_dfe64dc7:

#   ec "We’re blessed to have had ancestors with such ties to Malpheon."
    ec "Somos privilegiados por termos tido ancestrais com laços tão fortes com Malpheon."

# game/chapters/chapter6/ch6sc2.rpy:4591
translate brazil ch6sc2_2d803612:

#   ec "And we still strive to regain a close connection to our goddesses of today."
    ec "E ainda nos esforçamos para recuperar uma conexão próxima com nossas deusas de hoje."

# game/chapters/chapter6/ch6sc2.rpy:4593
translate brazil ch6sc2_39c5359c:

#   pl "Magical water... *Giggles*"
    pl "Água mágica... *Risos*"

# game/chapters/chapter6/ch6sc2.rpy:4594
translate brazil ch6sc2_e574cf03:

#   pl "If I wasn’t a mermaid already... this would surely turn me into one!"
    pl "Se eu já não fosse uma sereia... isso com certeza me transformaria em uma!"

# game/chapters/chapter6/ch6sc2.rpy:4596
translate brazil ch6sc2_3f8a9a26:

#   ec "A mermaid?"
    ec "Uma sereia?"

# game/chapters/chapter6/ch6sc2.rpy:4598
translate brazil ch6sc2_6b9aee35:

#   pl "Just a little joke. [mc] likes to think I’m a mermaid 'cause I love water so much."
    pl "Só uma piadinha. [mc] Gosto de pensar que sou uma sereia porque amo muito a água."

# game/chapters/chapter6/ch6sc2.rpy:4600
translate brazil ch6sc2_6834c352:

#   ec "*Scoffs lightly* Is that so? Then you’ll definitely love this."
    ec "*Risos discretos* É mesmo? Então você com certeza vai adorar isso."

# game/chapters/chapter6/ch6sc2.rpy:4601
translate brazil ch6sc2_fbb6e737:

#   ec "The water here completely loosens your muscles and releases all the tension in your body."
    ec "A água aqui relaxa completamente os músculos e libera toda a tensão do corpo."

# game/chapters/chapter6/ch6sc2.rpy:4602
translate brazil ch6sc2_d58adb33:

#   ec "You’ll relax like never before."
    ec "Você vai relaxar como nunca antes."

# game/chapters/chapter6/ch6sc2.rpy:4604
translate brazil ch6sc2_0103a976:

#   pl "Seas! Really?"
    pl "Mares! Sério?"

# game/chapters/chapter6/ch6sc2.rpy:4605
translate brazil ch6sc2_5f190a54:

#   pl "That sounds exactly what my body needs right now..."
    pl "Isso parece ser exatamente o que meu corpo precisa agora..."

# game/chapters/chapter6/ch6sc2.rpy:4607
translate brazil ch6sc2_3ee78d52:

#   mc "I wonder how your ancestors managed all this? Sure, I get that they were blessed by Malpheon..."
    mc "Fico imaginando como seus ancestrais conseguiram tudo isso? Claro, entendo que eles foram abençoados por Malpheon..."

# game/chapters/chapter6/ch6sc2.rpy:4608
translate brazil ch6sc2_a647843d:

#   mc "But they'd still need a lot of manpower to build these places."
    mc "Mas eles ainda precisariam de muita mão de obra para construir esses lugares."

# game/chapters/chapter6/ch6sc2.rpy:4610
translate brazil ch6sc2_af6b123c:

#   ec "It is unknown to us now. Our ancestor's methods have been lost over the centuries."
    ec "Atualmente, desconhecemos esse método. Os métodos de nossos ancestrais se perderam ao longo dos séculos."

# game/chapters/chapter6/ch6sc2.rpy:4611
translate brazil ch6sc2_c4998bc9:

#   ec "We can only preserve their accomplishments to the best of our abilities, and enjoy the fruits of their labor to this day."
    ec "Só podemos preservar suas realizações da melhor maneira possível e desfrutar dos frutos de seu trabalho até os dias de hoje."

# game/chapters/chapter6/ch6sc2.rpy:4613
translate brazil ch6sc2_cc77dd3d:

#   pl "[mc], enough with the questioning... we’re here to unwind."
    pl "[mc] Chega de perguntas... estamos aqui para relaxar."

# game/chapters/chapter6/ch6sc2.rpy:4614
translate brazil ch6sc2_aeffa91b:

#   pl "I’m sure you’ll have plenty of time to talk about history, but for now... let’s relax and enjoy this amazing bath!"
    pl "Tenho certeza de que vocês terão bastante tempo para conversar sobre história, mas por agora... vamos relaxar e aproveitar este banho maravilhoso!"

# game/chapters/chapter6/ch6sc2.rpy:4615
translate brazil ch6sc2_ac164fd7:

#   mc "*Chuckles* Alright, alright... I’ll spare you from my fascination with ancient civilizations."
    mc "*Risos* Tudo bem, tudo bem... Vou poupá-los da minha fascinação por civilizações antigas."

# game/chapters/chapter6/ch6sc2.rpy:4617
translate brazil ch6sc2_da3e9973:

#   pl "Good, because right now..."
    pl "Ótimo, porque agora mesmo..."

# game/chapters/chapter6/ch6sc2.rpy:4618
translate brazil ch6sc2_2b247fbb:

#   pl "All that is keeping me from passing out is the thought of my body sinking into this water..."
    pl "A única coisa que me impede de desmaiar é o pensamento do meu corpo afundando nesta água..."

# game/chapters/chapter6/ch6sc2.rpy:4619
translate brazil ch6sc2_efa4c3f0:

#   pl "Having all this dirt and mud washed away, and letting the soothing water rejuvenate my spirit and body."
    pl "Ter toda essa sujeira e lama lavadas, e deixar a água calmante revigorar meu espírito e meu corpo."

# game/chapters/chapter6/ch6sc2.rpy:4621
translate brazil ch6sc2_b5972983:

#   pl "I can hear the water speaking to me."
    pl "Consigo ouvir a água falando comigo."

# game/chapters/chapter6/ch6sc2.rpy:4622
translate brazil ch6sc2_6388905a:

#   pl "It’s telling us to get naked and enjoy it."
    pl "Está nos dizendo para ficarmos nus e aproveitarmos."

# game/chapters/chapter6/ch6sc2.rpy:4623
translate brazil ch6sc2_f8093f0d:

#   mc "*Chuckle* I get it, I get it... then let’s get to it."
    mc "*Risos* Entendi, entendi... então vamos lá."

# game/chapters/chapter6/ch6sc2.rpy:4625
translate brazil ch6sc2_130138c1:

#   ec "I’ll let the two of you have some privacy, then. I need to seek guidance from our elders anyway."
    ec "Vou deixar vocês dois em privacidade, então. De qualquer forma, preciso consultar nossos anciãos."

# game/chapters/chapter6/ch6sc2.rpy:4626
translate brazil ch6sc2_26f80e40:

#   ec "Enjoy the bath, and relax as long as you need."
    ec "Aproveite o banho e relaxe pelo tempo que precisar."

# game/chapters/chapter6/ch6sc2.rpy:4628
translate brazil ch6sc2_9e42716d:

#   ec "[mc], if you need me... you know where my personal chambers are."
    ec "[mc] Se precisar de mim... você sabe onde ficam meus aposentos particulares."

# game/chapters/chapter6/ch6sc2.rpy:4629
translate brazil ch6sc2_4b032f28:

#   ec "Anything at all, come find me... your presence is one which I enjoy."
    ec "Qualquer coisa, venha me encontrar... sua presença é algo que me agrada."

# game/chapters/chapter6/ch6sc2.rpy:4631
translate brazil ch6sc2_39b3371e:

#   mc "Sure, I might pay you a visit later."
    mc "Claro, talvez eu te faça uma visita mais tarde."

# game/chapters/chapter6/ch6sc2.rpy:4632
translate brazil ch6sc2_e840e2b1:

#   ec "Oh? ..."
    ec "Oh? ..."

# game/chapters/chapter6/ch6sc2.rpy:4634
translate brazil ch6sc2_b95b3da5:

#   ec "That would be ... lovely."
    ec "Isso seria... adorável."

# game/chapters/chapter6/ch6sc2.rpy:4635
translate brazil ch6sc2_1bf11238:

#   ec "I’ll see you later then, [mc]."
    ec "Te vejo mais tarde então, [mc]."

# game/chapters/chapter6/ch6sc2.rpy:4637
translate brazil ch6sc2_866c734c:

#   ec "Come, Suji. Let’s give our guests some privacy."
    ec "Vamos, Suji. Vamos dar um pouco de privacidade aos nossos convidados."

# game/chapters/chapter6/ch6sc2.rpy:4638
translate brazil ch6sc2_fdcdbeff:

#   sj "As you wish, A’nu."
    sj "Como desejar, A'nu."

# game/chapters/chapter6/ch6sc2.rpy:4640
translate brazil ch6sc2_5aae1eba:

#   ec "Enjoy the bath you two."
    ec "Aproveitem o banho vocês dois."

# game/chapters/chapter6/ch6sc2.rpy:4641
translate brazil ch6sc2_327d4b41:

#   ec "Suji will stand guard at the outer entrance and ensure that nobody disturbs you."
    ec "Suji ficará de guarda na entrada externa e garantirá que ninguém o perturbe."

# game/chapters/chapter6/ch6sc2.rpy:4642
translate brazil ch6sc2_df8d66d5:

#   mc "Bye, Echo. Thank you."
    mc "Tchau, Echo. Obrigada."

# game/chapters/chapter6/ch6sc2.rpy:4643
translate brazil ch6sc2_b5af2d7e:

#   pl "Bye! Thank you again!"
    pl "Tchau! Muito obrigada novamente!"

# game/chapters/chapter6/ch6sc2.rpy:4648
translate brazil ch6sc2_09587d04:

#   pl "Bath time! *Giggles* Let’s get naked!"
    pl "Hora do banho! *Risos* Vamos ficar nus!"

# game/chapters/chapter6/ch6sc2.rpy:4649
translate brazil ch6sc2_b42d0638:

#   mc "Let’s indeed."
    mc "Vamos lá, sim."

# game/chapters/chapter6/ch6sc2.rpy:4651
translate brazil ch6sc2_f6fcef59:

#   pl "Could you?"
    pl "Você poderia?"

# game/chapters/chapter6/ch6sc2.rpy:4652
translate brazil ch6sc2_b51787ae:

#   mc "Mhm-Hm, of course."
    mc "Sim, claro."

# game/chapters/chapter6/ch6sc2.rpy:4654
translate brazil ch6sc2_45e42fff:

#   pl "[mc]... thank you."
    pl "[mc]... obrigado."

# game/chapters/chapter6/ch6sc2.rpy:4655
translate brazil ch6sc2_b6e8da43:

#   pl "You’re so good to me..."
    pl "Você é tão bom para mim..."

# game/chapters/chapter6/ch6sc2.rpy:4657
translate brazil ch6sc2_ccc941be:

#   mc "You’re welcome."
    mc "De nada."

# game/chapters/chapter6/ch6sc2.rpy:4658
translate brazil ch6sc2_71fe2076:

#   pl "Mmh... much better."
    pl "Hum... muito melhor."

# game/chapters/chapter6/ch6sc2.rpy:4660
translate brazil ch6sc2_c08caec3:

#   mc "What do you think of this place?"
    mc "O que você acha deste lugar?"

# game/chapters/chapter6/ch6sc2.rpy:4661
translate brazil ch6sc2_25994a7b:

#   pl "Of A’nai? I like it."
    pl "De A'nai? Gostei."

# game/chapters/chapter6/ch6sc2.rpy:4662
