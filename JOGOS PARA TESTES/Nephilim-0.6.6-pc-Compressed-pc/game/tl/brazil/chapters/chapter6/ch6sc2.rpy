# game/chapters/chapter6/ch6sc2.rpy:444
translate brazil ch6sc2_78451458:

#   "The two of you stay submerged until you’re closing in on the beach."
    "Vocês dois permanecem submersos até estarem se aproximando da praia."

# game/chapters/chapter6/ch6sc2.rpy:445
translate brazil ch6sc2_979c8053:

#   "Pearl’s breath control must be close to the limits of peak human conditioning."
    "O controle da respiração de Pearl deve estar próximo dos limites do condicionamento humano máximo."

# game/chapters/chapter6/ch6sc2.rpy:452
translate brazil ch6sc2_07a3f67b:

#   mct "{i}She looks happy... Good.{/i}"
    mct "{i}Ela parece feliz... Que bom.{/i}"

