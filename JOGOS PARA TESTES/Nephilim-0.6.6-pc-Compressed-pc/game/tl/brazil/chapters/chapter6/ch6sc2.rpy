# ARQUIVO: game/chapters/chapter6/ch6sc2.rpy DIALOGOS: 4482


# game/chapters/chapter6/ch6sc2.rpy:16
translate brazil ch6sc2_bfcf133e:

#   br "Blasted boot! Get on, will ye!"
    br "Bota maldita! Suba logo!"

# game/chapters/chapter6/ch6sc2.rpy:20
translate brazil ch6sc2_a098e066:

#   el "Morning, Borri! What are you cursing about so early in the day?"
    el "Bom dia, Borri! Por que você está reclamando tão cedo?"

# game/chapters/chapter6/ch6sc2.rpy:22
translate brazil ch6sc2_fcf1d505:

#   br "These darned tailors and artisans in Luxenford don’t make proper dwarven attire!"
    br "Esses malditos alfaiates e artesãos de Luxenford não fazem trajes anões decentes!"

# game/chapters/chapter6/ch6sc2.rpy:23
translate brazil ch6sc2_846ad0e9:

#   br "Me ol' boots gave out last week. Been struggling with these ever since! Egh!"
    br "Minhas botas velhas se desfizeram semana passada. Estou sofrendo com elas desde então! Aff!"

# game/chapters/chapter6/ch6sc2.rpy:25
translate brazil ch6sc2_8f3de7c1:

#   el "I never really gave it much thought, but yeah ... dwarves would probably need specially made clothes."
    el "Eu nunca tinha pensado muito nisso, mas sim... os anões provavelmente precisariam de roupas feitas especialmente para eles."

# game/chapters/chapter6/ch6sc2.rpy:26
translate brazil ch6sc2_10e511e4:

#   br "Aye. And since we’re few and far between here in t'capital, demand fer such is low."
    br "Sim. E como somos poucos e distantes uns dos outros aqui na capital, a demanda por isso é baixa."

# game/chapters/chapter6/ch6sc2.rpy:27
translate brazil ch6sc2_dd813ff5:

#   br "Now, what brings a lass like yerself here at t'crack o'dawn?"
    br "Ora, o que traz uma moça como você aqui ao raiar do dia?"

# game/chapters/chapter6/ch6sc2.rpy:29
translate brazil ch6sc2_47fb2524:

#   el "*Giggles* Heh-heh-heh!"
    el "*Risos* Heh-heh-heh!"

# game/chapters/chapter6/ch6sc2.rpy:30
translate brazil ch6sc2_b584d357:

#   br "Nay, lass, nay! I know yer up t'somethin', and I’m telling ye, {b}NAY!{/b}"
    br "Não, garota, não! Eu sei que você está aprontando alguma coisa, e estou te dizendo, {b} NÃO!{/b}"

# game/chapters/chapter6/ch6sc2.rpy:32
translate brazil ch6sc2_3cc4ca00:

#   el "Shopping!"
    el "Compras!"

# game/chapters/chapter6/ch6sc2.rpy:33
translate brazil ch6sc2_ed46994f:

#   el "We’re going shopping!"
    el "Vamos às compras!"

# game/chapters/chapter6/ch6sc2.rpy:36
translate brazil ch6sc2_bd37daca:

#   br "Nay!! Abso-friggin-lutely not!"
    br "Não!! De jeito nenhum!"

# game/chapters/chapter6/ch6sc2.rpy:37
translate brazil ch6sc2_2e109472:

#   br "Ye better get it out of yer noggin!"
    br "É melhor você tirar isso da sua cabeça!"

# game/chapters/chapter6/ch6sc2.rpy:45
translate brazil ch6sc2_9900cf65:

#   br "*Groans* Brrah! T' things ye make me do, lass. Not even me wife would have succeeded!"
    br "*Geme* Brah! As coisas que você me faz fazer, garota. Nem minha esposa teria conseguido!"

# game/chapters/chapter6/ch6sc2.rpy:46
translate brazil ch6sc2_9cc0ce11:

#   br "So... what’re ye looking fer... shoes? ... dresses?"
    br "Então... o que vocês estão procurando... sapatos? ... vestidos?"

# game/chapters/chapter6/ch6sc2.rpy:48
translate brazil ch6sc2_4b0afa0c:

#   el "Neither. I'm not cruel enough to bring you shopping for that. No, we're here to get..."
    el "Nenhuma das duas. Não sou cruel o suficiente para te levar às compras para isso. Não, estamos aqui para comprar..."

# game/chapters/chapter6/ch6sc2.rpy:49
translate brazil ch6sc2_e2d93b25:

#   el "Tools!"
    el "Ferramentas!"

# game/chapters/chapter6/ch6sc2.rpy:51
translate brazil ch6sc2_79e0be0c:

#   br "T-Tools?! By Drusilda’s hammer... yer serious?!"
    br "Ferramentas em T?! Pelo martelo da Drusilda... você está falando sério?!"

# game/chapters/chapter6/ch6sc2.rpy:52
translate brazil ch6sc2_f6e8951e:

#   br "HAH! Why didn’t ye blasted say so from t' get-go!"
    br "HAH! Por que você não disse isso desde o início?!"

# game/chapters/chapter6/ch6sc2.rpy:54
translate brazil ch6sc2_aad7c5f8:

#   el "Because it amuses me when you get all grumpy! *Giggles*"
    el "Porque me diverte quando você fica todo mal-humorado! *Risos*"

# game/chapters/chapter6/ch6sc2.rpy:56
translate brazil ch6sc2_f7c5e2be:

#   br "Bah! Yer gonna be t' reason me ol' heart gives out one of these days."
    br "Bah! Você vai ser o motivo pelo qual meu coração vai parar de funcionar um dia desses."

# game/chapters/chapter6/ch6sc2.rpy:58
translate brazil ch6sc2_020cb282:

#   el "Pish-Posh! You have at least another 100 - 150 years left in you, from what I know about dwarves!"
    el "Bobagem! Pelo que sei sobre anões, você ainda tem pelo menos mais 100 a 150 anos de vida pela frente!"

# game/chapters/chapter6/ch6sc2.rpy:59
translate brazil ch6sc2_bde7cde9:

#   el "And if you dare die before that... I’ll kill you myself!"
    el "E se você ousar morrer antes disso... eu mesmo te matarei!"

# game/chapters/chapter6/ch6sc2.rpy:61
translate brazil ch6sc2_09306e9a:

#   br "*Chuckles* Heh... I’ve said it before, and I’ll say it again, lass... ye have t' heart of a dwarven woman!"
    br "*Risos* Heh... Eu já disse isso antes e vou dizer de novo, moça... você tem o coração de uma anã!"

# game/chapters/chapter6/ch6sc2.rpy:62
translate brazil ch6sc2_6d225a15:

#   br "So... what are we buying tools fer?"
    br "Então... para que estamos comprando ferramentas?"

# game/chapters/chapter6/ch6sc2.rpy:64
translate brazil ch6sc2_675c3c85:

#   el "[mc] and I just finished transporting building materials to our home site, but something came up with the pirates he knows."
    el "[mc] E eu acabei de transportar os materiais de construção para o local da nossa casa, mas surgiu um problema com os piratas que ele conhece."

# game/chapters/chapter6/ch6sc2.rpy:65
translate brazil ch6sc2_a8f87c0d:

#   el "It sounded like they were in trouble, so he’s taking care of that for a while."
    el "Parecia que eles estavam com problemas, então ele está cuidando disso por um tempo."

# game/chapters/chapter6/ch6sc2.rpy:67
translate brazil ch6sc2_ed674cca:

#   el "So, instead of the materials just laying about in the elements, I thought we’d get some tools and start working!"
    el "Então, em vez de deixar os materiais simplesmente jogados ao relento, pensei que poderíamos pegar algumas ferramentas e começar a trabalhar!"

# game/chapters/chapter6/ch6sc2.rpy:68
translate brazil ch6sc2_a37085e6:

#   br "*Chuckles* Heh! And what makes ye think I know anything about building?"
    br "*Risos* Heh! E o que te faz pensar que eu entendo alguma coisa de construção?"

# game/chapters/chapter6/ch6sc2.rpy:70
translate brazil ch6sc2_04551193:

#   el "You’re a dwarf! I've heard male dwarves are typically in charge of construction, while the women forge tools, armor and weapons."
    el "Você é um anão! Ouvi dizer que os anões homens geralmente ficam responsáveis ​​pela construção, enquanto as mulheres forjam ferramentas, armaduras e armas."

# game/chapters/chapter6/ch6sc2.rpy:72
translate brazil ch6sc2_a8072aa8:

#   br "Blasted books... be telling too much! *Exhales*"
    br "Malditos livros... acabam contando demais! *Suspira*"

# game/chapters/chapter6/ch6sc2.rpy:73
translate brazil ch6sc2_0b363386:

#   br "*Exhales* Alright, lass. We both know arguing with ye is futile... let’s see what tools we can find."
    br "*Suspira* Muito bem, garota. Nós duas sabemos que discutir com você é inútil... vamos ver que ferramentas podemos encontrar."

# game/chapters/chapter6/ch6sc2.rpy:75
translate brazil ch6sc2_15484fdd:

#   el "That’s the spirit! C’mon, it’ll be fun!"
    el "É isso aí! Vamos lá, vai ser divertido!"

# game/chapters/chapter6/ch6sc2.rpy:76
translate brazil ch6sc2_d284c135:

#   br "Beats shopping fer clothes... let’s get to it, lass."
    br "Melhor do que comprar roupa... vamos lá, garota."

# game/chapters/chapter6/ch6sc2.rpy:84
translate brazil ch6sc2_f7bacd87:

#   mct "{i}Mhm...{/i}"
    mct "{i}Hum...{/i}"

# game/chapters/chapter6/ch6sc2.rpy:86
translate brazil ch6sc2_1ca328a6:

#   mct "{i}Despite the small bed... that wasn’t a bad sleep...{/i}"
    mct "{i}Apesar da cama pequena... não foi uma noite de sono ruim...{/i}"

# game/chapters/chapter6/ch6sc2.rpy:87
translate brazil ch6sc2_4d39c714:

#   mct "{i}Looks like the sun is starting to rise.{/i}"
    mct "{i}Parece que o sol está começando a nascer.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:89
translate brazil ch6sc2_b2004ad0:

#   mct "{i}Hmm... Pearl’s up already?{/i}"
    mct "{i}Hum... Pearl já acordou?{/i}"

# game/chapters/chapter6/ch6sc2.rpy:90
translate brazil ch6sc2_7a1c4881:

#   mct "{i}Let's go see what she's up to.{/i}"
    mct "{i}Vamos ver o que ela está aprontando.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:100
translate brazil ch6sc2_c64a1b65:

#   mc "There you are. Morning."
    mc "Pronto. Bom dia."

# game/chapters/chapter6/ch6sc2.rpy:102
translate brazil ch6sc2_28bdbc61:

#   pl "Here I am. Morning!"
    pl "Aqui estou eu. Bom dia!"

# game/chapters/chapter6/ch6sc2.rpy:104
translate brazil ch6sc2_b3e4b707:

#   mc "You always up this early or was the bed too uncomfortable?"
    mc "Você sempre acorda tão cedo ou a cama era muito desconfortável?"

# game/chapters/chapter6/ch6sc2.rpy:106
translate brazil ch6sc2_3b438715:

#   pl "The bed was... comfortable."
    pl "A cama era... confortável."

# game/chapters/chapter6/ch6sc2.rpy:107
translate brazil ch6sc2_c24be0d7:

#   pl "I’m just used to rising early. Kira likes to sleep in, and someone has to steer the ship, so I usually take the morning shift."
    pl "Estou acostumado a acordar cedo. Kira gosta de dormir até mais tarde, e alguém precisa comandar o navio, então geralmente fico com o turno da manhã."

# game/chapters/chapter6/ch6sc2.rpy:111
translate brazil ch6sc2_e1da9ff0:

#   pl "How about you? Did you... you know, sleep well?"
    pl "E você? Você... sabe, dormiu bem?"

# game/chapters/chapter6/ch6sc2.rpy:113
translate brazil ch6sc2_2168985d:

#   mc "Yeah. I slept like a baby... sharing a bed with you gave me peace."
    mc "Sim. Dormi como um bebê... dividir a cama com você me trouxe paz."

# game/chapters/chapter6/ch6sc2.rpy:115
translate brazil ch6sc2_88ae15a1:

#   pl "G-Good... me too... I’ve never slept so soundly. The sun was already up when I awoke, which is never the case."
    pl "Ótimo... eu também... Nunca dormi tão bem. O sol já tinha nascido quando acordei, o que nunca acontece."

# game/chapters/chapter6/ch6sc2.rpy:117
translate brazil ch6sc2_b97d5541:

#   mc "How do you feel?"
    mc "Como você está se sentindo?"

# game/chapters/chapter6/ch6sc2.rpy:119
translate brazil ch6sc2_cc30a838:

#   mc "You’re not feeling any pain?"
    mc "Você não está sentindo nenhuma dor?"

# game/chapters/chapter6/ch6sc2.rpy:121
translate brazil ch6sc2_e2b58e06:

#   mc "You’re not..."
    mc "Você não está..."

# game/chapters/chapter6/ch6sc2.rpy:123
translate brazil ch6sc2_b9add690:

#   mc "Feeling sore this morning?"
    mc "Sentindo dores musculares esta manhã?"

# game/chapters/chapter6/ch6sc2.rpy:124
translate brazil ch6sc2_47c2d1f1:

#   pl "*Whimpers* Mnfhh... j-just a little. But it’s okay."
    pl "*Geme* Mnfhh... s-só um pouquinho. Mas tudo bem."

# game/chapters/chapter6/ch6sc2.rpy:125
translate brazil ch6sc2_a24e7c0c:

#   pl "It was... Mmhm... worth it."
    pl "Foi... Hum... valeu a pena."

# game/chapters/chapter6/ch6sc2.rpy:127
translate brazil ch6sc2_cfe8824a:

#   mc "Yeah? There are no regrets on your part?"
    mc "É mesmo? Você não se arrepende de nada?"

# game/chapters/chapter6/ch6sc2.rpy:129
translate brazil ch6sc2_6e0d7077:

#   pl "N-No... Mmffhh... none."
    pl "N-Não... Mmffhh... nenhum."

# game/chapters/chapter6/ch6sc2.rpy:131
translate brazil ch6sc2_cb7c7c2c:

#   pl "What about you? Was I... enough?"
    pl "E você? Eu fui... suficiente?"

# game/chapters/chapter6/ch6sc2.rpy:133
translate brazil ch6sc2_0732d172:

#   mc "Mm. You were more than enough... no regrets here."
    mc "Hum. Você foi mais do que suficiente... nenhum arrependimento da parte dela."

# game/chapters/chapter6/ch6sc2.rpy:135
translate brazil ch6sc2_aae2e095:

#   pl "G-Good... [mc] I..."
    pl "Bom... [mc] EU..."

# game/chapters/chapter6/ch6sc2.rpy:137
translate brazil ch6sc2_4fdb3a25:

#   pl "I really enjoyed last night..."
    pl "Gostei muito da noite passada..."

# game/chapters/chapter6/ch6sc2.rpy:139
translate brazil ch6sc2_a25a735b:

#   pl "..."
    pl "..."

# game/chapters/chapter6/ch6sc2.rpy:141
translate brazil ch6sc2_7d1c9f90:

#   mc "You’re worried about Kira?"
    mc "Você está preocupado com a Kira?"

# game/chapters/chapter6/ch6sc2.rpy:142
translate brazil ch6sc2_89d6fae4:

#   pl "*Nods*"
    pl "*Acena com a cabeça*"

# game/chapters/chapter6/ch6sc2.rpy:144
translate brazil ch6sc2_06776c91:

#   pl "We’ve talked about it at length since we parted ways with you."
    pl "Já conversamos bastante sobre isso desde que nos separamos de você."

# game/chapters/chapter6/ch6sc2.rpy:145
translate brazil ch6sc2_9c2b4c04:

#   pl "We both have feelings for you..."
    pl "Nós dois temos sentimentos por você..."

# game/chapters/chapter6/ch6sc2.rpy:147
translate brazil ch6sc2_a29b8d1a:

#   mc "I knew Kira felt that way... but you do as well?"
    mc "Eu sabia que Kira se sentia assim... mas você também?"

# game/chapters/chapter6/ch6sc2.rpy:148
translate brazil ch6sc2_e4f11e0c:

#   pl "*Nods* Mh..."
    pl "*Acena com a cabeça* Hum..."

# game/chapters/chapter6/ch6sc2.rpy:150
translate brazil ch6sc2_6ee9d0f5:

#   pl "Do you really think last night would’ve happened if I wasn’t in lov- if I didn’t care about you?"
    pl "Você realmente acha que o que aconteceu ontem à noite teria acontecido se eu não estivesse apaixonado(a) por você?"

# game/chapters/chapter6/ch6sc2.rpy:152
translate brazil ch6sc2_caa57830:

#   mc "No... last night was real, our feelings were real... our bodies conveyed that perfectly."
    mc "Não... a noite passada foi real, nossos sentimentos foram reais... nossos corpos transmitiram isso perfeitamente."

# game/chapters/chapter6/ch6sc2.rpy:154
translate brazil ch6sc2_5a256f52:

#   mc "So, you know full well that I feel the same."
    mc "Então, você sabe muito bem que eu sinto o mesmo."

# game/chapters/chapter6/ch6sc2.rpy:156
translate brazil ch6sc2_edbef236:

#   pl "Kira and I agreed that if you picked either one of us we would accept it and be happy."
    pl "Kira e eu concordamos que, se você escolhesse qualquer uma de nós, aceitaríamos e ficaríamos felizes."

# game/chapters/chapter6/ch6sc2.rpy:157
translate brazil ch6sc2_5a91c3e7:

#   pl "And if... if you have feelings for both of us, then... we’ll accept that as well."
    pl "E se... se você tiver sentimentos por nós dois, então... nós também aceitaremos isso."

# game/chapters/chapter6/ch6sc2.rpy:159
translate brazil ch6sc2_09c6452e:

#   mc "Really? You’d be okay with that? There wouldn’t be any jealousy?"
    mc "Sério? Você não teria problema com isso? Não haveria nenhum ciúme?"

# game/chapters/chapter6/ch6sc2.rpy:161
translate brazil ch6sc2_ae924cbc:

#   pl "No. We'd just ask that you don’t get overly affectionate in front of the other. So as not to rub it in their face."
    pl "Não. Pedimos apenas que você não demonstre afeto em excesso na frente da outra pessoa, para não ficar constrangido(a)."

# game/chapters/chapter6/ch6sc2.rpy:162
translate brazil ch6sc2_210e0f4a:

#   pl "Apart from that, we’re twins, we’ve been together our whole lives... we want the best for each other."
    pl "Além disso, somos gêmeas, estamos juntas desde sempre... queremos o melhor uma para a outra."

# game/chapters/chapter6/ch6sc2.rpy:166
translate brazil ch6sc2_0444bfa3:

#   pl "And if both of our hearts point to you, then how could we fault each other for that?"
    pl "E se ambos os nossos corações apontam para você, como poderíamos nos culpar um ao outro por isso?"

# game/chapters/chapter6/ch6sc2.rpy:168
translate brazil ch6sc2_7a4827e0:

#   mc "Pearl... that’s awfully mature of the two of you. I know that it’s common for a man to have multiple partners."
    mc "Pearl... isso é muito maduro da parte de vocês dois. Eu sei que é comum um homem ter várias parceiras."

# game/chapters/chapter6/ch6sc2.rpy:169
translate brazil ch6sc2_095cee05:

#   mc "But sisters are a different prospect... twins no less."
    mc "Mas irmãs são uma história diferente... gêmeas, nada menos."

# game/chapters/chapter6/ch6sc2.rpy:171
translate brazil ch6sc2_b37827eb:

#   mc "Look at me."
    mc "Olhe para mim."

# game/chapters/chapter6/ch6sc2.rpy:174
translate brazil ch6sc2_39d1f709:

#   mc "I want both of you. You’ve both shown me loyalty and your genuine selves."
    mc "Eu quero vocês dois. Ambos me mostraram lealdade e foram autênticos."

# game/chapters/chapter6/ch6sc2.rpy:176
translate brazil ch6sc2_30100971:

#   mc "I’m attracted to both of you and my feelings for each of you grow every moment we’re together."
    mc "Sinto atração por vocês dois e meus sentimentos por cada um de vocês crescem a cada momento que passamos juntos."

# game/chapters/chapter6/ch6sc2.rpy:178
translate brazil ch6sc2_0bf33619:

#   pl "[mc]... you have no idea what a relief this is. This way, we’ll all get to be happy!"
    pl "[mc]...você não faz ideia do alívio que isso representa. Assim, todos nós seremos felizes!"

# game/chapters/chapter6/ch6sc2.rpy:179
translate brazil ch6sc2_a8bcb5e1:

#   pl "Both of us will get to be with you and know real happiness."
    pl "Nós dois teremos a oportunidade de estar com você e conhecer a verdadeira felicidade."

# game/chapters/chapter6/ch6sc2.rpy:183
translate brazil ch6sc2_8e263d86:

#   mc "Pearl... I only want you."
    mc "Pérola... Eu só quero você."

# game/chapters/chapter6/ch6sc2.rpy:184
translate brazil ch6sc2_f05d2d5b:

#   mc "Kira is great, but I only see her as a friend... unlike you."
    mc "A Kira é ótima, mas eu só a vejo como amiga... ao contrário de você."

# game/chapters/chapter6/ch6sc2.rpy:186
translate brazil ch6sc2_2aa0ccf3:

#   pl "[mc]... you have no idea what a relief that is. I feel so... so happy!"
    pl "[mc]...você não faz ideia do alívio que isso me causa. Estou me sentindo tão... tão feliz!"

# game/chapters/chapter6/ch6sc2.rpy:187
translate brazil ch6sc2_9452ac8d:

#   pl "I was willing to share you with Kira at the expense of my own happiness, but now I won't have to!"
    pl "Eu estava disposta a compartilhar você com Kira à custa da minha própria felicidade, mas agora não precisarei mais!"

# game/chapters/chapter6/ch6sc2.rpy:190
translate brazil ch6sc2_ae956247:

#   pl "I’m glad we got that out of the way..."
    pl "Que bom que resolvemos isso..."

# game/chapters/chapter6/ch6sc2.rpy:194
translate brazil ch6sc2_5cf8b5c1:

#   pl "Now I can do this!"
    pl "Agora eu consigo fazer isso!"

# game/chapters/chapter6/ch6sc2.rpy:198
translate brazil ch6sc2_d2aa17a3:

#   pl "*Mwaah* Mnnnhmm-MMm..."
    pl "*Mwaah* Mnnnhmm-MMm..."

# game/chapters/chapter6/ch6sc2.rpy:206
translate brazil ch6sc2_6f91b682:

#   pl "*Sensual* I want to taste you... Mmm..."
    pl "*Sensual* Quero te provar... Mmm..."

# game/chapters/chapter6/ch6sc2.rpy:208
translate brazil ch6sc2_3064a217:

#   mc "Go on then, you little sea-minx. Have your breakfast, I’ll steer the ship."
    mc "Vamos lá, sua pequena ladra do mar. Tome seu café da manhã, eu piloto o navio."

# game/chapters/chapter6/ch6sc2.rpy:210
translate brazil ch6sc2_d1e57c25:

#   pl "Do try not to steer us off course... *Snickers*"
    pl "Por favor, não tente nos desviar do caminho... *Risos*"

# game/chapters/chapter6/ch6sc2.rpy:212
translate brazil ch6sc2_66b5271c:

#   pl "I'd intended to taste you last night..."
    pl "Eu pretendia te provar ontem à noite..."

# game/chapters/chapter6/ch6sc2.rpy:213
translate brazil ch6sc2_9ba4bd74:

#   pl "But I completely passed out after you claimed me... I was so overwhelmed with joy."
    pl "Mas eu desmaiei completamente depois que você me reivindicou... Fiquei tão transbordando de alegria."

