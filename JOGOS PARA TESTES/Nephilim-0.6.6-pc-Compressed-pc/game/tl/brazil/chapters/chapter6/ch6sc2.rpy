    mct "{i}De empolgada a silenciosa num instante... há mais por trás do seu amor por peixes do que ela demonstra.{/i}"

# game/chapters/chapter6/ch6sc2.rpy:434
translate brazil ch6sc2_ac33c08c:

#   mc "*Shouting* C’mon, let’s go find you some new fishys to befriend!"
    mc "*Gritando* Vamos lá, vamos encontrar novos peixinhos para você fazer amizade!"

# game/chapters/chapter6/ch6sc2.rpy:435
translate brazil ch6sc2_e3dc1e08:

