# game/chapters/chapter6/ch6sc2.rpy:2205
translate brazil ch6sc2_310bb9af_1:

#   mc "I don’t want to cross any boundaries or accidentally insult your ways."
    mc "Não quero ultrapassar nenhum limite nem ofender seus costumes sem querer."

# game/chapters/chapter6/ch6sc2.rpy:2209
translate brazil ch6sc2_c268f561_1:

#   ks "Disrespecting our ways and culture is a quick way to become an enemy of our tribe."
    ks "Desrespeitar nossos costumes e cultura é uma maneira rápida de se tornar inimigo da nossa tribo."

# game/chapters/chapter6/ch6sc2.rpy:2877
translate brazil ch6sc2_2d4e451c_1:

#   mc "Your offer is very tempting. I’m sure most wouldn’t refuse. But I didn’t come here for you."
    mc "Sua oferta é muito tentadora. Tenho certeza de que a maioria não recusaria. Mas eu não vim aqui por você."

# game/chapters/chapter6/ch6sc2.rpy:2879
translate brazil ch6sc2_c5b00c1c_1:

#   tai "Say no more, I do not judge. How one wishes to achieve pleasure is their own choice."
    tai "Não precisa dizer mais nada, eu não julgo. A forma como cada um busca o prazer é uma escolha pessoal."

# game/chapters/chapter6/ch6sc2.rpy:2882
translate brazil ch6sc2_626a1c69_1:

#   tai "I’m quite... curious about you, Outsider."
    tai "Estou bastante... curioso(a) a seu respeito, Forasteiro(a)."

# game/chapters/chapter6/ch6sc2.rpy:2965
translate brazil ch6sc2_a7bcf340_1:

#   mc "I see..."
    mc "Eu vejo..."

# game/chapters/chapter6/ch6sc2.rpy:3080
translate brazil ch6sc2_a7bcf340_2:

#   mc "I see..."
    mc "Eu vejo..."

# game/chapters/chapter6/ch6sc2.rpy:3309
translate brazil ch6sc2_edd65b95_1:

#   ec "[mc]... I- I’m interested-"
    ec "[mc]... Eu... eu tenho interesse..."

# game/chapters/chapter6/ch6sc2.rpy:3494
translate brazil ch6sc2_7e54b91c_1:

#   mc "Marah, I'm sorry for what happened to your people all those years ago."
    mc "Marah, sinto muito pelo que aconteceu com seu povo todos esses anos atrás."

# game/chapters/chapter6/ch6sc2.rpy:3500
translate brazil ch6sc2_e357663d_1:

#   mh "We lost our precious A'nu... we lost nearly half the tribe..."
    mh "Perdemos nosso precioso A'nu... perdemos quase metade da tribo..."

# game/chapters/chapter6/ch6sc2.rpy:3567
translate brazil ch6sc2_1aebfcfe_1:

