    lu "{b}*Gritos de alegria* [mc]! Hahaha! Isso faz cócegas! Malvado!{/b}"

# game/chapters/chapter7/ch7sc2.rpy:1121
translate brazil ch7sc2_6ea07053:

#   mc "Are you going to behave? *Chuckles*"
    mc "Você vai se comportar? *Risos*"

# game/chapters/chapter7/ch7sc2.rpy:1123
translate brazil ch7sc2_d5dd7f97:

