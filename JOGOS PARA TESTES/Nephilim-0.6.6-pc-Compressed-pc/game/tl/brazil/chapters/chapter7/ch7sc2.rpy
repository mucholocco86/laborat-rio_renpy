# game/chapters/chapter7/ch7sc2.rpy:655
translate brazil ch7sc2_d69a8be6:

#   ala "Before we departed from the society, I heard talk of a rebellion brewing in Arazalia..."
    ala "Antes de nos despedirmos da sociedade, ouvi falar de uma rebelião que estava se formando em Arazalia..."

# game/chapters/chapter7/ch7sc2.rpy:656
translate brazil ch7sc2_8f10ba68:

#   ala "The kingdom is divided, the poor starving and left to fend for themselves, while the rich hoard food and materials."
    ala "O reino está dividido, os pobres passam fome e são deixados à própria sorte, enquanto os ricos acumulam comida e bens materiais."

# game/chapters/chapter7/ch7sc2.rpy:657
translate brazil ch7sc2_8ba38714:

#   ala "Our target... this woman... the leader of the rebellion?"
    ala "Nosso alvo... essa mulher... a líder da rebelião?"

# game/chapters/chapter7/ch7sc2.rpy:659
translate brazil ch7sc2_21c53de3:

#   ci "There you go, dots connected."
    ci "Pronto, agora tudo se encaixou."

# game/chapters/chapter7/ch7sc2.rpy:660
translate brazil ch7sc2_bdbfd53a:

#   ci "Our contract is to eliminate the opposition. Our ship’s storage will be filled to the brim with gold upon doing so."
    ci "Nosso contrato é eliminar a oposição. O depósito de ouro do nosso navio ficará repleto dele assim que o fizermos."

# game/chapters/chapter7/ch7sc2.rpy:662
translate brazil ch7sc2_90b459e4:

#   ala "But... this woman..."
    ala "Mas... essa mulher..."

# game/chapters/chapter7/ch7sc2.rpy:663
translate brazil ch7sc2_3d2289c4:

#   ala "She’s fighting to free slaves, and she protects the poor... those who can’t fend for themselves."
    ala "Ela luta para libertar os escravos e protege os pobres... aqueles que não conseguem se defender sozinhos."

# game/chapters/chapter7/ch7sc2.rpy:665
translate brazil ch7sc2_9e3a44f3:

#   ci "*Sighs* Alana, what you’re experiencing is the remnants of a guilty conscience..."
    ci "*Suspiro* Alana, o que você está sentindo são os resquícios de uma consciência culpada..."

# game/chapters/chapter7/ch7sc2.rpy:666
translate brazil ch7sc2_5acfcb10:

#   ci "I’m going to need you to get over that, okay?"
    ci "Preciso que você supere isso, ok?"

# game/chapters/chapter7/ch7sc2.rpy:668
translate brazil ch7sc2_751a1361:

#   ci "Do you think the bandits who tore your family apart felt guilty?"
    ci "Você acha que os bandidos que destruíram sua família sentiram culpa?"

# game/chapters/chapter7/ch7sc2.rpy:669
translate brazil ch7sc2_0d8681a2:

#   ci "The world is cruel and seldom fair... we’re assassins. We’re not soldiers in an army..."
    ci "O mundo é cruel e raramente justo... somos assassinos. Não somos soldados em um exército..."

# game/chapters/chapter7/ch7sc2.rpy:671
translate brazil ch7sc2_2b992230:

#   ci "We’re not adventurers looking to help out the neighborhood."
    ci "Não somos aventureiros que querem ajudar a vizinhança."

# game/chapters/chapter7/ch7sc2.rpy:673
translate brazil ch7sc2_18e11cd1:

#   ci "If that isn’t enough, think about this... if this rebellion is allowed to go on..."
    ci "Se isso não for suficiente, pense nisto... se essa rebelião continuar..."

# game/chapters/chapter7/ch7sc2.rpy:675
translate brazil ch7sc2_a4657d45:

#   ci "Thousands will die, on both sides..."
    ci "Milhares morrerão, de ambos os lados..."

# game/chapters/chapter7/ch7sc2.rpy:676
translate brazil ch7sc2_d513972c:

#   ci "Killing the leader will scatter the rebellion, and life will go back to usual in their kingdom."
    ci "Matar o líder dispersará a rebelião e a vida voltará ao normal em seu reino."

# game/chapters/chapter7/ch7sc2.rpy:678
translate brazil ch7sc2_ccddeab3:

#   ala "I... I guess..."
    ala "Eu... eu acho..."

# game/chapters/chapter7/ch7sc2.rpy:679
translate brazil ch7sc2_98753db8:

#   ala "I just don’t like it... I feel like we should be on the side of those who can’t fend for themselves..."
    ala "Eu simplesmente não gosto disso... Acho que deveríamos estar do lado daqueles que não conseguem se defender sozinhos..."

# game/chapters/chapter7/ch7sc2.rpy:681
translate brazil ch7sc2_a732f860:

#   ci "We all wish we could be... but we’re a neutral faction, we don’t pick sides... we remain in the middle."
    ci "Todos nós gostaríamos de ser assim... mas somos uma facção neutra, não tomamos partido... permanecemos no meio."

# game/chapters/chapter7/ch7sc2.rpy:682
translate brazil ch7sc2_a340dbc4:

#   ci "Go..."
    ci "Ir..."

# game/chapters/chapter7/ch7sc2.rpy:683
translate brazil ch7sc2_8cd60168:

#   ci "Rest..."
    ci "Descansar..."

# game/chapters/chapter7/ch7sc2.rpy:685
translate brazil ch7sc2_b7396042:

#   ci "If what I hear about this leader of theirs is true... we’ll need our strength."
    ci "Se o que ouço sobre esse líder deles for verdade... precisaremos de toda a nossa força."

# game/chapters/chapter7/ch7sc2.rpy:686
translate brazil ch7sc2_2ad0dfeb:

#   ala "Fine... I’ll see you at dawn, then."
    ala "Ótimo... então te vejo ao amanhecer."

# game/chapters/chapter7/ch7sc2.rpy:697
translate brazil ch7sc2_1336b191:

#   "Within the hour, people start arriving at the palace, guards escort the invitees to the Grand Hall where the banquet is being held."
    "Dentro de uma hora, as pessoas começam a chegar ao palácio, e os guardas escoltam os convidados até o Salão Nobre, onde o banquete está sendo realizado."

# game/chapters/chapter7/ch7sc2.rpy:704
translate brazil ch7sc2_be9d0b6e:

#   dat "*Chuckles* It's strange not seeing Bennen at one of these events."
    dat "*Risos* É estranho não ver o Bennen em um desses eventos."

# game/chapters/chapter7/ch7sc2.rpy:705
translate brazil ch7sc2_8bb4366e:

#   dat "Guess I've gotta be the chaperone tonight."
    dat "Acho que vou ter que ser o acompanhante hoje à noite."

# game/chapters/chapter7/ch7sc2.rpy:708
translate brazil ch7sc2_5eb51cf7:

#   al_t "This is... awesome!"
    al_t "Isso é... incrível!"

# game/chapters/chapter7/ch7sc2.rpy:709
translate brazil ch7sc2_f83a29eb:

#   al_t "I can't believe I actually got invited to a royal banquet! Wait until mother hears about this!"
    al_t "Não acredito que fui convidado para um banquete real! Espere até minha mãe saber disso!"

# game/chapters/chapter7/ch7sc2.rpy:712
translate brazil ch7sc2_604070af:

#   syt "Ooooh boy! Phew! There's not really anyone here that I don't know at least a bit."
    syt "Ufa! Ufa! Não tem praticamente ninguém aqui que eu não conheça pelo menos um pouco."

# game/chapters/chapter7/ch7sc2.rpy:713
translate brazil ch7sc2_0e55797b:

#   syt "I'm still going to withhold my wings tonight, no reason to risk anything."
    syt "Vou continuar sem usar minhas asas esta noite, não há motivo para arriscar nada."

# game/chapters/chapter7/ch7sc2.rpy:716
translate brazil ch7sc2_7bf9c60e:

#   mct "Looks like a few have arrived already. I’m not seeing Merida or Amelia, though."
    mct "Parece que alguns já chegaram. Não estou vendo Merida nem Amelia, porém."

# game/chapters/chapter7/ch7sc2.rpy:717
translate brazil ch7sc2_ff5e402e:

#   mct "They will probably arrive last, like we did for Amelia’s name day banquet."
    mct "Eles provavelmente chegarão por último, como aconteceu conosco no banquete do dia do nome de Amelia."

# game/chapters/chapter7/ch7sc2.rpy:720
translate brazil ch7sc2_c16dcf09:

#   "A few moments pass and more people arrive."
    "Passam-se alguns instantes e chegam mais pessoas."

# game/chapters/chapter7/ch7sc2.rpy:723
translate brazil ch7sc2_7ef1e8a4:

#   lut "Everyone looks beautiful tonight, I..."
    lut "Todos estão lindos esta noite, eu..."

# game/chapters/chapter7/ch7sc2.rpy:724
translate brazil ch7sc2_7cac0a7a:

#   lut "I feel naked without my hat... but Eliza convinced me to let my hair down for this event."
    lut "Me sinto nua sem meu chapéu... mas Eliza me convenceu a soltar o cabelo para este evento."

# game/chapters/chapter7/ch7sc2.rpy:727
translate brazil ch7sc2_4ec6927b:

#   frt "*Giggling* I'm really attending as a guest! This is great!"
    frt "*Risos* Eu vou mesmo como convidada! Que ótimo!"

# game/chapters/chapter7/ch7sc2.rpy:728
translate brazil ch7sc2_b83acf1a:

#   frt "I don't have to think about any of my duties tonight."
    frt "Não preciso pensar em nenhuma das minhas obrigações esta noite."

# game/chapters/chapter7/ch7sc2.rpy:729
translate brazil ch7sc2_166de334:

#   frt "I wonder what guests do at these events? Oh, [mc] looks so handsome tonight!"
    frt "Fico pensando o que os convidados fazem nesses eventos? Ah, [mc] Ele está tão bonito esta noite!"

# game/chapters/chapter7/ch7sc2.rpy:732
translate brazil ch7sc2_9c4d5521:

#   mlt "Looks like there's no noblewomen here tonight."
    mlt "Parece que não há nenhuma dama da nobreza por aqui esta noite."

# game/chapters/chapter7/ch7sc2.rpy:733
translate brazil ch7sc2_c1a8eb1f:

#   mlt "Guess I can enjoy my meal without worrying about... becoming a meal myself."
    mlt "Acho que posso aproveitar minha refeição sem me preocupar em... virar comida também."

# game/chapters/chapter7/ch7sc2.rpy:736
translate brazil ch7sc2_fd7217c0:

#   fy "Ladies, ladies! Brace yourselves! Your man Flynn has arrived!"
    fy "Senhoras, senhoras! Preparem-se! Seu homem, Flynn, chegou!"

# game/chapters/chapter7/ch7sc2.rpy:737
translate brazil ch7sc2_adae4bf4:

#   fy "That's right, the one and only, the scourge of pirates, the Deck Captain of the Bloody Banshee!"
    fy "Isso mesmo, o único e inigualável, o flagelo dos piratas, o Capitão de Convés do Banshee Sangrento!"

# game/chapters/chapter7/ch7sc2.rpy:738
translate brazil ch7sc2_d7629e8f:

#   fy "The man who will once again bring peace to this city... and who'll bring your panty-thief to justice!"
    fy "O homem que trará paz novamente a esta cidade... e que levará o ladrão de calcinhas à justiça!"

# game/chapters/chapter7/ch7sc2.rpy:741
translate brazil ch7sc2_f0e27cc8:

#   "As she enters the room, Eliza scans for you. When she finally sees you, she locks eyes with you."
    "Ao entrar na sala, Eliza procura por você com o olhar. Quando finalmente te vê, seus olhares se cruzam."

# game/chapters/chapter7/ch7sc2.rpy:744
translate brazil ch7sc2_7d3e7871:

#   mct "Five hells... my kitten knows how to make an entrance, she’s gorgeous."
    mct "Pelos cinco infernos... minha gatinha sabe como chegar chegando, ela é linda."

# game/chapters/chapter7/ch7sc2.rpy:745
translate brazil ch7sc2_7dc7542a:

#   elt "He has that goofy smile... does he really like my look tonight?"
    elt "Ele tem aquele sorriso bobo... será que ele realmente gostou do meu visual hoje à noite?"

# game/chapters/chapter7/ch7sc2.rpy:747
translate brazil ch7sc2_978053d6:

#   mct "Looks like most of us are here now, just missing Borri and Amelia."
    mct "Parece que a maioria de nós já está aqui, só faltam o Borri e a Amelia."

# game/chapters/chapter7/ch7sc2.rpy:750
translate brazil ch7sc2_a732bb29:

#   br "*Chuckles* ..."
    br "*Risos* ..."

# game/chapters/chapter7/ch7sc2.rpy:751
translate brazil ch7sc2_3b032936:

#   brt "A royal banquet... heh! Look at me, moving up in the world, eh?"
    brt "Um banquete real... hein! Olha só pra mim, subindo na vida, é?"

# game/chapters/chapter7/ch7sc2.rpy:752
translate brazil ch7sc2_f47a4c0e:

#   mct "He looks so out of his element in those fancy clothes. *Chuckles* I know how you feel, buddy."
    mct "Ele parece tão deslocado com essas roupas chiques. *Risos* Eu sei como você se sente, amigo."

# game/chapters/chapter7/ch7sc2.rpy:757
translate brazil ch7sc2_97758b8e:

#   "Everyone gathers around and begins to mingle, greeting each other and the usual."
    "Todos se reúnem e começam a confraternizar, cumprimentando-se uns aos outros como de costume."

# game/chapters/chapter7/ch7sc2.rpy:762
translate brazil ch7sc2_1ab66064:

#   "As the doors open, everyone turns their attention towards the entrance, then stands respectfully."
    "Assim que as portas se abrem, todos voltam sua atenção para a entrada e, em seguida, ficam de pé respeitosamente."

# game/chapters/chapter7/ch7sc2.rpy:765
translate brazil ch7sc2_d3ef9c3f:

#   evr "*Gasps* She’s so beautiful! There she is! I can’t believe she really invited us personally! I should’ve bathed today!"
    evr "*Suspiros* Ela é tão linda! Lá está ela! Não acredito que ela realmente nos convidou pessoalmente! Eu devia ter tomado banho hoje!"

# game/chapters/chapter7/ch7sc2.rpy:766
translate brazil ch7sc2_4719443c:

#   amt "Look at all of them... they're so dressed up tonight, they must've been as excited as I am for tonight."
    amt "Olha só para eles... estão todos tão elegantes esta noite, devem estar tão animados quanto eu para este dia."

# game/chapters/chapter7/ch7sc2.rpy:767
translate brazil ch7sc2_1eac5de6:

#   "With Amelia's arrival the list of attendees is complete, and she heads towards the front of the hall as everyone gathers around."
    "Com a chegada de Amelia, a lista de participantes está completa, e ela se dirige para a frente do salão enquanto todos se reúnem ao seu redor."

# game/chapters/chapter7/ch7sc2.rpy:772
translate brazil ch7sc2_651851bf:

#   am "*Clears throat* Welcome everyone! I recognize some of you from my name day celebrations, and I see some new faces too."
    am "*Limpa a garganta* Sejam todos bem-vindos! Reconheço alguns de vocês das comemorações do meu aniversário, e vejo também alguns rostos novos."

# game/chapters/chapter7/ch7sc2.rpy:773
translate brazil ch7sc2_f19f761e:

#   am "But unlike my name day celebration, where it wasn’t possible for me to mingle with all the guests ..."
    am "Mas, ao contrário da minha festa de aniversário, onde não me foi possível interagir com todos os convidados..."

# game/chapters/chapter7/ch7sc2.rpy:775
translate brazil ch7sc2_f54bfa3f:

#   am "Tonight is different. Tonight is not a banquet in my honor, but it is one in yours."
    am "Esta noite é diferente. Esta noite não é um banquete em minha homenagem, mas sim em sua."

# game/chapters/chapter7/ch7sc2.rpy:776
translate brazil ch7sc2_f4d12d9c:

#   am "So, please, don’t feel the need to act all proper and courtly. Just be yourselves and enjoy the evening."
    am "Então, por favor, não se sintam na obrigação de agir de forma tão formal e educada. Simplesmente sejam vocês mesmos e aproveitem a noite."

# game/chapters/chapter7/ch7sc2.rpy:778
translate brazil ch7sc2_94d04a9b:

#   am "I hope to get to know each and every one of you a little better tonight. So, please ..."
    am "Espero conhecer cada um de vocês um pouco melhor esta noite. Então, por favor..."

# game/chapters/chapter7/ch7sc2.rpy:779
translate brazil ch7sc2_b30c3c21:

#   am "Just approach me as you would a friend, not a princess."
    am "Trate-me como trataria uma amiga, não uma princesa."

# game/chapters/chapter7/ch7sc2.rpy:781
translate brazil ch7sc2_5d2bc8c4:

#   am "I am only home safe thanks to all of your efforts. And I want you all to know that I am incredibly grateful for your aid."
    am "Só cheguei em casa em segurança graças a todos os seus esforços. E quero que todos saibam que sou imensamente grato pela ajuda de vocês."

# game/chapters/chapter7/ch7sc2.rpy:783
translate brazil ch7sc2_fdc5e239:

#   am "Behind me, the maids of the castle have prepared us a feast. I hope you’ll all join me at the table and eat to your hearts content!"
    am "Atrás de mim, as criadas do castelo prepararam um banquete para nós. Espero que todos se juntem a mim à mesa e comam à vontade!"

# game/chapters/chapter7/ch7sc2.rpy:784
translate brazil ch7sc2_effe79a3:

#   evr "We’d love to! ... Yum! ... I’m famished! ... Aye, yer got some ale or just wine? ... Borri! ... What? I'm speak'n t’ her like me friends!"
    evr "Adoraríamos! ... Hum! ... Estou faminto! ... Ei, você tem cerveja ou só vinho? ... Borri! ... O quê? Estou falando com ela como se fossem meus amigos!"

# game/chapters/chapter7/ch7sc2.rpy:786
translate brazil ch7sc2_00201f14:

#   am "*Giggles* There is, in fact, plenty of ale. Come... let’s sit and enjoy ourselves!"
    am "*Risos* Na verdade, tem bastante cerveja. Venha... vamos sentar e nos divertir!"

# game/chapters/chapter7/ch7sc2.rpy:790
translate brazil ch7sc2_ef84fbae:

#   mc "*Whispers*{size=-10}{b} You look like a goddess tonight.{/b}{/size}"
    mc "*Sussurros*{size=-10}{b} Você está parecendo uma deusa esta noite.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:792
translate brazil ch7sc2_252c308a:

#   el "*Whispers*{size=-10}{b} A goddess, huh?{/b}{/size}"
    el "*Sussurros*{size=-10}{b} Uma deusa, hein?{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:793
translate brazil ch7sc2_6848969f:

#   el "*Whispers*{size=-10}{b} Is that why your hand has been resting on my hip for the entire speech? You always get this familiar with goddesses?{/b}{/size}"
    el "*Sussurros*{size=-10}{b} É por isso que sua mão ficou repousando no meu quadril durante todo o discurso? Você sempre fica assim com as deusas?{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:795
translate brazil ch7sc2_97079021:

#   mc "*Whispers* {size=-10}{b}Only the ones I like.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Apenas as que eu gosto.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:796
translate brazil ch7sc2_f5e64555:

#   el "*Snickers* {size=-10}{b}...{/b}{/size}"
    el "*Risos* {size=-10}{b}...{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:798
translate brazil ch7sc2_64b85a49:

#   "Eliza begins to purr softly as you run your fingers up her smooth forearm."
    "Eliza começa a ronronar suavemente enquanto você desliza os dedos pelo seu antebraço liso."

# game/chapters/chapter7/ch7sc2.rpy:799
translate brazil ch7sc2_79a7493e:

#   mc "*Whispers* {size=-10}{b}I love the dress. It’s new, isn’t it?{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Adorei o vestido. É novo, não é?{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:800
translate brazil ch7sc2_b70adc93:

#   el "*Whispers*{size=-10}{b} Mhm-hm, don’t worry... I’ll return it to Nuel in the morning. It’s a bit pricey, but I really wanted a dress suitable for tonight.{/b}{/size}"
    el "*Sussurros*{size=-10}{b} Hum-hum, não se preocupe... Devolverei ao Nuel amanhã. É um pouco caro, mas eu queria mesmo um vestido adequado para esta noite.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:802
translate brazil ch7sc2_5a8e0686:

#   mc "*Whispers* {size=-10}{b}You’re not returning this dress, it's perfect for you. The white goes well with your beautiful blue eyes and raven-colored hair.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Você não vai devolver este vestido, ele é perfeito para você. O branco combina muito bem com seus lindos olhos azuis e cabelos negros como azeviche.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:803
translate brazil ch7sc2_fb6dd08c:

#   mc "*Whispers* {size=-10}{b}And you don’t have a dress in your wardrobe yet. I don’t care about the price, I’ll just take on some extra quests at the guild.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}E você ainda não tem um vestido no seu guarda-roupa. Não me importo com o preço, só aceito algumas missões extras na guilda.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:805
translate brazil ch7sc2_82deaeb6:

#   el "*Whispers* {size=-10}{b}[mc]... I... I don’t know what to say.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}[mc]... Eu... Eu não sei o que dizer.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:807
translate brazil ch7sc2_eb65429f:

#   mc "*Whispers* {size=-10}{b}Say that you’ll keep it? This will be a gift from me.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Você disse que vai ficar com ele? Será um presente meu.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:809
translate brazil ch7sc2_8ab70aea:

#   el "*Whispers* {size=-10}{b}O-Okay, I’ll keep it, then. I’ll never return something you’ve given me.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Tá bem, então vou ficar com ele. Nunca vou devolver nada que você me deu.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:811
translate brazil ch7sc2_c53e00ba:

#   mc "*Whispers* {size=-10}{b}Good, is this elven fabric? It feels like it.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Ótimo, este tecido élfico? Parece que sim.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:812
translate brazil ch7sc2_80104388:

#   el "*Whispers* {size=-10}{b}Mmh, it’s so light and smooth. It feels really nice to wear.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Hum, é tão leve e macio. É muito agradável de usar.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:813
translate brazil ch7sc2_36293e43:

#   el "*Whispers* {size=-10}{b}Baby... if you keep caressing me like this, we won’t make it to the table... nnnh.{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Meu bem... se você continuar me acariciando assim, não vamos chegar à mesa... nnnh.{/b}{/size}"

# game/chapters/chapter7/ch7sc2.rpy:814
translate brazil ch7sc2_dfac2c4f:

#   mc "*Whispers* {size=-10}{b}How am I meant to keep my hands off you when you look this appetizing?{/b}{/size}"
