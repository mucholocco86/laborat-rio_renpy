translate brazil ch7sc6_f33deec2:

#   fr "As you’ve always had mine! It’s a great honor to be considered your friend."
    fr "Assim como você sempre teve a minha! É uma grande honra ser considerado seu amigo."

# game/chapters/chapter7/ch7sc6.rpy:2728
translate brazil ch7sc6_3aefea12:

#   am "Do you really believe my ring could be one of those special rings? I find that so hard to believe…"
    am "Você realmente acredita que meu anel possa ser um desses anéis especiais? Acho isso tão difícil de acreditar…"

# game/chapters/chapter7/ch7sc6.rpy:2730
translate brazil ch7sc6_36c1bf63:

#   fr "I do believe it, but we’ll know for certain once we scour all the books in the royal library!"
    fr "Acredito nisso, mas só teremos certeza depois de vasculharmos todos os livros da biblioteca real!"

# game/chapters/chapter7/ch7sc6.rpy:2731
translate brazil ch7sc6_c5cf675b:

#   fr "But firstly…"
    fr "Mas, em primeiro lugar…"

# game/chapters/chapter7/ch7sc6.rpy:2733
translate brazil ch7sc6_23637ac9:

#   am "Firstly what? Where are you heading?"
    am "Primeiro, o quê? Para onde você está indo?"

