translate brazil ch7sc6_b72b93c1:

#   br "Hmm, let’s see… these ones have been cut larger than the others, they’ll do nice fer a sturdy deck."
    br "Hum, vejamos... estas foram cortadas maiores que as outras, servirão bem para um deck resistente."

# game/chapters/chapter7/ch7sc6.rpy:507
translate brazil ch7sc6_a135bd6a:

