translate brazil ch7sc6_4f4d502f:

#   fr "I’ll go draw you a bath! You’re not going back to sleep covered in sweat, not if you’re going to see [mc] tomorrow!"
    fr "Vou preparar um banho para você! Você não vai voltar a dormir toda suada, não se quiser ver [mc] amanhã!"

# game/chapters/chapter7/ch7sc6.rpy:2735
translate brazil ch7sc6_a5f5fa7e:

#   am "*Giggling* R-Right! Thank you!"
    am "*Risos* C-Certo! Obrigada!"

