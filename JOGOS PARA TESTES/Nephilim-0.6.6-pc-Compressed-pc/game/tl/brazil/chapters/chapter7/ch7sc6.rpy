translate brazil ch7sc6_5e15deeb:

#   am "Woah… hello? Who’s there!?"
    am "Uau… olá? Quem está aí!?"

# game/chapters/chapter7/ch7sc6.rpy:2787
translate brazil ch7sc6_e418c83c:

#   "After the structure has fully manifested, a figure reveals itself to Amelia, levitating within the ominous structure."
    "Após a estrutura se manifestar completamente, uma figura se revela a Amelia, levitando dentro da estrutura sinistra."

# game/chapters/chapter7/ch7sc6.rpy:2788
translate brazil ch7sc6_993cabec:

#   am "W-Who are you? What’s going on?!"
    am "Q-Quem é você? O que está acontecendo?!"

# game/chapters/chapter7/ch7sc6.rpy:2790
translate brazil ch7sc6_e58adc31:

#   spi "*Echoing voice* Amelia…"
    spi "*Voz com eco* Amélia…"

# game/chapters/chapter7/ch7sc6.rpy:2791
translate brazil ch7sc6_d92d0d26:

#   spi "*Echoing voice* Amelia…... Amelia…..."
    spi "*Voz com eco* Amélia… Amélia…"

# game/chapters/chapter7/ch7sc6.rpy:2793
translate brazil ch7sc6_89afd948:

#   am "Who… what… are you?"
    am "Quem… o quê… é você?"

# game/chapters/chapter7/ch7sc6.rpy:2794
translate brazil ch7sc6_e9a55009:

#   am "I-I have a bodyguard! If-if you harm me he- he’ll hurt you!"
    am "Eu tenho um guarda-costas! Se... se você me machucar, ele... ele vai te machucar!"

# game/chapters/chapter7/ch7sc6.rpy:2796
translate brazil ch7sc6_2ec5c9df:

#   spi "Amelia… you needn’t fear me, I wish you no harm."
    spi "Amélia... você não precisa ter medo de mim, não lhe desejo nenhum mal."

# game/chapters/chapter7/ch7sc6.rpy:2797
translate brazil ch7sc6_16b24250:

#   spi "You’ve grown strong Amelia, stronger than you realize."
    spi "Você se tornou forte, Amelia, mais forte do que imagina."

# game/chapters/chapter7/ch7sc6.rpy:2799
translate brazil ch7sc6_23cdab1f:

#   am "W-Where am I?"
    am "O-Onde estou?"

# game/chapters/chapter7/ch7sc6.rpy:2800
translate brazil ch7sc6_3a88003d:

#   am "What have you done to me?!"
    am "O que você fez comigo?!"

# game/chapters/chapter7/ch7sc6.rpy:2802
translate brazil ch7sc6_8d444d15:

#   spi "I have brought you here because it’s time we meet… to talk."
    spi "Eu te trouxe aqui porque chegou a hora de nos encontrarmos... para conversar."

