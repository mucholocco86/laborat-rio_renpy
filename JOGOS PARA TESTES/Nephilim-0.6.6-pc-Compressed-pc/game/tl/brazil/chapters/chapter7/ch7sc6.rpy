translate brazil ch7sc6_9e5959e5:

#   spi "Your ring."
    spi "Seu anel."

# game/chapters/chapter7/ch7sc6.rpy:2809
translate brazil ch7sc6_f9dbe327:

#   am "My ring?? So my dreams are correlated to the ring?"
    am "Meu anel?? Então meus sonhos estão relacionados ao anel?"

# game/chapters/chapter7/ch7sc6.rpy:2811
translate brazil ch7sc6_a5f398a3:

#   spi "Yes, we are currently inside your ring, it contains a small pocket-dimension."
    spi "Sim, estamos dentro do seu anel, ele contém um pequeno compartimento."

# game/chapters/chapter7/ch7sc6.rpy:2813
translate brazil ch7sc6_f800173c:

#   am "I-I don’t know what that means…"
    am "Não sei o que isso significa…"

# game/chapters/chapter7/ch7sc6.rpy:2815
translate brazil ch7sc6_b2d00e77:

#   spi "It is not of importance, just know you’re safe here."
    spi "Não é importante, apenas saiba que você está seguro aqui."

# game/chapters/chapter7/ch7sc6.rpy:2817
translate brazil ch7sc6_2a2855ba:

#   am "W-Who are you then?"
    am "Q-Quem é você então?"

# game/chapters/chapter7/ch7sc6.rpy:2819
translate brazil ch7sc6_b3597707:

#   spi "I am the Ringbearer who lives within your ring… or, I was the Ringbearer, now all that’s left of me is my soul."
    spi "Eu sou o Portador do Anel que vive dentro do seu anel… ou, eu era o Portador do Anel, agora tudo o que me resta é a minha alma."

# game/chapters/chapter7/ch7sc6.rpy:2820
translate brazil ch7sc6_b593c828:

#   am "…"
    am "…"

# game/chapters/chapter7/ch7sc6.rpy:2822
translate brazil ch7sc6_ca159dd7:

#   am "So, this ring, my ring… it was yours at some point in time?"
    am "Então, este anel, meu anel… em algum momento foi seu?"

