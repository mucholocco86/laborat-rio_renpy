    br "Sim, pelos meus cálculos, devemos ter o suficiente!"

# game/chapters/chapter7/ch7sc6.rpy:516
translate brazil ch7sc6_f345698d:

#   br "Hah! Brilliant work lad! Keep her steady!"
    br "Hah! Trabalho brilhante, rapaz! Mantenha-a firme!"

