translate brazil ch7sc6_b53b1f8f:

#   am "It’s… it’s possible? I don’t know… I’ve never seen it do this before?"
    am "É... é possível? Não sei... nunca vi isso acontecer antes?"

# game/chapters/chapter7/ch7sc6.rpy:2695
translate brazil ch7sc6_137a90af:

#   fr "Enchanted maybe? Enchanted rings… Amelia!"
    fr "Encantados, talvez? Anéis encantados… Amélia!"

# game/chapters/chapter7/ch7sc6.rpy:2696
translate brazil ch7sc6_3bb8216f:

#   fr "R-Remember that book we were reading maybe one or two years ago?"
    fr "R-Lembra daquele livro que estávamos lendo talvez um ou dois anos atrás?"

# game/chapters/chapter7/ch7sc6.rpy:2697
translate brazil ch7sc6_75d34245:

#   am "*Gasps* The book of Balthan’s downfall?"
    am "*Suspiros* O livro da queda de Balthan?"

