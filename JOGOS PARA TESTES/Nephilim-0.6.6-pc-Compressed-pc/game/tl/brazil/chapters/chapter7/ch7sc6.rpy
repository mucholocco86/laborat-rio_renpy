translate brazil ch7sc6_d31fc203:

#   am "I better get up, having a warm bath will clear my mind."
    am "É melhor eu me levantar, um banho quente vai clarear minha mente."

# game/chapters/chapter7/ch7sc6.rpy:2740
translate brazil ch7sc6_c0994745:

#   am "And my body…"
    am "E meu corpo…"

# game/chapters/chapter7/ch7sc6.rpy:2741
translate brazil ch7sc6_1b4ad39a:

#   am "These dreams… or visions?"
    am "Esses sonhos... ou visões?"

# game/chapters/chapter7/ch7sc6.rpy:2743
translate brazil ch7sc6_5f025304:

#   am "They’re so intense and vivid, I can feel my entire body tense up."
    am "São tão intensas e vívidas que sinto meu corpo inteiro se tensionar."

