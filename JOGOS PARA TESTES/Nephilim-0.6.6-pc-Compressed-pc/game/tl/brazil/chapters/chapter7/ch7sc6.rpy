translate brazil ch7sc6_f414daa7:

#   am "Hello?! Is anybody there?!"
    am "Olá?! Tem alguém aí?!"

# game/chapters/chapter7/ch7sc6.rpy:2781
translate brazil ch7sc6_6b80a32f:

#   am "*Gasps* Huh?! W-What’s going on?!"
    am "*Suspiros* Hã?! O-O que está acontecendo?!"

