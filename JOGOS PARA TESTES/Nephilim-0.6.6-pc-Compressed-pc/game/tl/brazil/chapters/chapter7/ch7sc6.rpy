translate brazil ch7sc6_7b5c7178:

#   br "Lass! Oooh… aye! What yer got fer us?"
    br "Moça! Oooh… sim! O que você tem para nós?"

# game/chapters/chapter7/ch7sc6.rpy:534
translate brazil ch7sc6_0276c426:

#   el "Nothing special, just some fresh bread and juicy apples!"
    el "Nada de especial, apenas pão fresco e maçãs suculentas!"

# game/chapters/chapter7/ch7sc6.rpy:535
translate brazil ch7sc6_e02c6a1f:

#   mc "Sounds great, we’ve set up a dining area up here that we can use."
    mc "Ótimo, montamos uma área de jantar aqui em cima que podemos usar."

# game/chapters/chapter7/ch7sc6.rpy:537
translate brazil ch7sc6_5f345655:

#   el "*Giggling* You better dig in before Borri devours it all!"
    el "*Risos* É melhor você começar a comer antes que o Borri devore tudo!"

# game/chapters/chapter7/ch7sc6.rpy:538
translate brazil ch7sc6_c29ae12a:

#   br "Baah! Tis bread is simply delicious lass!"
