translate brazil ch7sc4_bd23dbf5_1:

#   tg "*Giggling*"
    tg "*Risos*"

# game/chapters/chapter7/ch7sc4.rpy:1987
translate brazil ch7sc4_bd23dbf5_2:

#   tg "*Giggling*"
    tg "*Risos*"

# game/chapters/chapter7/ch7sc4.rpy:2056
