    lu "Aqui! Chupe mais um pouquinho e eu posso me convencer! *Risinhos*"

# game/chapters/chapter7/ch7sc3.rpy:197
translate brazil ch7sc3_4cf328ea:

#   mc "Mmmh! Mmmh…"
    mc "Hum! Hum…"

# game/chapters/chapter7/ch7sc3.rpy:199
translate brazil ch7sc3_a09a4d4e:

#   mc "Now that we’ve both had our taste buds satisfied momentarily, how about we get out of here?"
    mc "Agora que ambos tivemos nossos paladares satisfeitos por um instante, que tal irmos embora daqui?"

# game/chapters/chapter7/ch7sc3.rpy:200
translate brazil ch7sc3_5f6f1a32:

