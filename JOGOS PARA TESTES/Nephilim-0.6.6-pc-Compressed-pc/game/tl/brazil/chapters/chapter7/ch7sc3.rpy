    lu "*Risinhos suaves* …"

# game/chapters/chapter7/ch7sc3.rpy:2587
translate brazil ch7sc3_70f542fa_2:

#   lu "*Giggles softly* …"
    lu "*Risinhos suaves* …"

# game/chapters/chapter7/ch7sc3.rpy:2279
translate brazil ch7sc3_821b300a_1:

#   mc "Mmmh… I love you, Luna."
    mc "Hum… Eu te amo, Luna."

