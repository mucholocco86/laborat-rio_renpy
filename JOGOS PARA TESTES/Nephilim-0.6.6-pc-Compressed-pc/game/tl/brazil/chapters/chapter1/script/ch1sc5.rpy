# ARQUIVO: game/chapters/chapter1/script/ch1sc5.rpy DIALOGOS: 52


# game/chapters/chapter1/script/ch1sc5.rpy:12
translate brazil ch1sc5_6c04c666:

#   pa "Honey, I'm back."
    pa "Querida, voltei."

# game/chapters/chapter1/script/ch1sc5.rpy:14
translate brazil ch1sc5_0134fbf8:

#   ma "Ahh, honey. There you are!"
    ma "Ah, querida. Aí está você!"

# game/chapters/chapter1/script/ch1sc5.rpy:15
translate brazil ch1sc5_b709b23f:

#   ma "Where's [mc]?"
    ma "Onde está [mc]?"

# game/chapters/chapter1/script/ch1sc5.rpy:17
translate brazil ch1sc5_a81db65b:

#   pa "We ran into Alice, so [mc] is out playing with her for a while."
    pa "Encontramos Alice, então [mc] Está brincando com ela há um tempo."

# game/chapters/chapter1/script/ch1sc5.rpy:19
translate brazil ch1sc5_da26b85f:

#   ma "Good! I’m nowhere near ready for dinner yet..."
    ma "Ótimo! Ainda não estou nem perto de estar pronto para o jantar..."

# game/chapters/chapter1/script/ch1sc5.rpy:21
translate brazil ch1sc5_f905deb7:

#   pa "Mhh! Something smells delicious in here!"
    pa "Hum! Tem algo com um cheiro delicioso aqui!"

# game/chapters/chapter1/script/ch1sc5.rpy:23
translate brazil ch1sc5_1ddd4aa8:

#   ma "*Giggles* I’m preparing a small feast for tonight, honey."
    ma "*Risos* Estou preparando um pequeno banquete para esta noite, querido."

# game/chapters/chapter1/script/ch1sc5.rpy:25
translate brazil ch1sc5_3461ec2a:

#   pa "What would we ever do without you, sweetie."
    pa "O que faríamos sem você, meu bem?"

# game/chapters/chapter1/script/ch1sc5.rpy:27
translate brazil ch1sc5_8265c15f:

#   ma "Starve! Obviously..."
    ma "Morrer de fome! Obviamente..."

# game/chapters/chapter1/script/ch1sc5.rpy:29
translate brazil ch1sc5_dd39f1d8:

#   pa "*Chuckles* Thank the Divines I found such a lovely wife."
    pa "*Risos* Graças a Deus que encontrei uma esposa tão adorável."

# game/chapters/chapter1/script/ch1sc5.rpy:31
translate brazil ch1sc5_017d13d5:

#   ma "I thank them everyday, honey. You & [mc] are the blessings of my life."
    ma "Agradeço a eles todos os dias, querida. Você e [mc] São as bênçãos da minha vida."

# game/chapters/chapter1/script/ch1sc5.rpy:33
translate brazil ch1sc5_cd2d7fdc:

#   pa "I truly don’t deserve you."
    pa "Eu realmente não te mereço."

# game/chapters/chapter1/script/ch1sc5.rpy:35
translate brazil ch1sc5_71368c50:

#   pa "I love you."
    pa "Eu te amo."

# game/chapters/chapter1/script/ch1sc5.rpy:37
translate brazil ch1sc5_bcb3d1fd:

#   ma "I love you too, sweetie."
    ma "Eu também te amo, meu bem."

# game/chapters/chapter1/script/ch1sc5.rpy:39
translate brazil ch1sc5_525b654d:

#   pa "Come here."
    pa "Venha aqui."

# game/chapters/chapter1/script/ch1sc5.rpy:41
translate brazil ch1sc5_6882ca2e:

#   ma "Uhh... Hey there, handsome!"
    ma "Hum... Olá, bonitão!"

# game/chapters/chapter1/script/ch1sc5.rpy:43
translate brazil ch1sc5_9c2df819:

#   pa "Hey beautiful."
    pa "Olá, linda."

# game/chapters/chapter1/script/ch1sc5.rpy:45
translate brazil ch1sc5_3a5a0bca:

#   "Your parent's kiss is filled with love and warmth."
    "O beijo dos seus pais é repleto de amor e carinho."

# game/chapters/chapter1/script/ch1sc5.rpy:49
translate brazil ch1sc5_1eb2062e:

#   pa "By the gods! I’m a lucky man!"
    pa "Pelos deuses! Sou um homem de sorte!"

# game/chapters/chapter1/script/ch1sc5.rpy:51
translate brazil ch1sc5_093ba1bd:

#   ma "*Giggles* And don’t you forget it, mister!"
    ma "*Risos* E não se esqueça disso, senhor!"

# game/chapters/chapter1/script/ch1sc5.rpy:53
translate brazil ch1sc5_c40dfe44:

#   pa "May the gods punish me for eternity should I forget for even a second..."
    pa "Que os deuses me castiguem por toda a eternidade se eu me esquecer por um segundo sequer..."

# game/chapters/chapter1/script/ch1sc5.rpy:55
translate brazil ch1sc5_e4473011:

#   ma "Now, stop distracting me. I’ve gotta finish cooking before [mc] comes home!"
    ma "Agora, pare de me distrair. Preciso terminar de cozinhar antes [mc] volta para casa!"

# game/chapters/chapter1/script/ch1sc5.rpy:57
translate brazil ch1sc5_7b84b8dd:

#   pa "Alright... Alright. Anything I can help with?"
    pa "Certo... Certo. Posso ajudar em algo?"

# game/chapters/chapter1/script/ch1sc5.rpy:59
translate brazil ch1sc5_c318b579:

#   ma "No, you just sit down and relax for a bit. It won’t take long."
    ma "Não, você pode simplesmente sentar e relaxar um pouco. Não vai demorar muito."

# game/chapters/chapter1/script/ch1sc5.rpy:65
translate brazil ch1sc5_4dbcfacb:

#   "Papa smokes his pipe for a while, relaxing, while Mama continues to cook."
    "Papai fuma seu cachimbo por um tempo, relaxando, enquanto mamãe continua cozinhando."

# game/chapters/chapter1/script/ch1sc5.rpy:67
translate brazil ch1sc5_d3fd606f:

#   ma "So what did you get up to today?"
    ma "Então, o que você fez hoje?"

# game/chapters/chapter1/script/ch1sc5.rpy:69
translate brazil ch1sc5_80971c2f:

#   pa "I ran a few errands, stopped by Gibs' place on the way to the market for nails."
    pa "Fiz algumas coisas para resolver, passei na loja do Gibs a caminho do mercado para comprar pregos."

# game/chapters/chapter1/script/ch1sc5.rpy:70
translate brazil ch1sc5_c669bd5b:

#   pa "Gibson sends his regards. He had some trouble getting the anvil aligned properly, but I managed to repair it."
    pa "Gibson manda lembranças. Ele teve alguma dificuldade para alinhar a bigorna corretamente, mas eu consegui consertá-la."

# game/chapters/chapter1/script/ch1sc5.rpy:72
translate brazil ch1sc5_323feacf:

#   ma "That’s great, honey. It’s been a while since we had old Gibson over for dinner."
    ma "Que ótimo, querida. Já faz um tempo que o velho Gibson não vem jantar aqui."

# game/chapters/chapter1/script/ch1sc5.rpy:74
translate brazil ch1sc5_299d834f:

#   pa "Old?! You know we’re the same age..."
    pa "Velhos?! Você sabe que temos a mesma idade..."

# game/chapters/chapter1/script/ch1sc5.rpy:76
translate brazil ch1sc5_46cfa47f:

#   ma "*Giggles* Yes, honey. I’m aware..."
    ma "*Risos* Sim, querida. Eu sei..."

# game/chapters/chapter1/script/ch1sc5.rpy:77
translate brazil ch1sc5_bbbfcc5b:

#   pa "You little vixen!"
    pa "Sua raposinha!"

# game/chapters/chapter1/script/ch1sc5.rpy:79
translate brazil ch1sc5_fe6d9dc2:

#   pa "He invited me for ales at the tavern tomorrow as payment for the repair."
    pa "Ele me convidou para tomar umas cervejas na taverna amanhã como pagamento pelo conserto."

# game/chapters/chapter1/script/ch1sc5.rpy:81
translate brazil ch1sc5_e35ba127:

#   ma "Oh, did he now? And what about all that needs doing around here tomorrow?"
    ma "Ah, é mesmo? E quanto a tudo o que precisa ser feito por aqui amanhã?"

# game/chapters/chapter1/script/ch1sc5.rpy:83
translate brazil ch1sc5_b82e3270:

#   pa "Honey... you know how stubborn that bear of man can be!"
    pa "Querida... você sabe como aquele urso de homem pode ser teimoso!"

# game/chapters/chapter1/script/ch1sc5.rpy:85
translate brazil ch1sc5_d53998a3:

#   ma "*Giggles* I’m sure you tried real hard to find an excuse!"
    ma "*Risos* Tenho certeza que você se esforçou muito para encontrar uma desculpa!"

# game/chapters/chapter1/script/ch1sc5.rpy:87
translate brazil ch1sc5_dcf16c29:

#   pa "*Chuckles* He was relentless! Wouldn’t take any excuses!"
    pa "*Risos* Ele era implacável! Não aceitava desculpas!"

# game/chapters/chapter1/script/ch1sc5.rpy:89
translate brazil ch1sc5_780d6653:

#   mat "Those two... whenever they get together it’s like they are young lads again."
    mat "Aqueles dois... sempre que se juntam, é como se fossem jovens novamente."

# game/chapters/chapter1/script/ch1sc5.rpy:91
translate brazil ch1sc5_efcfca06:

#   ma "I’m just teasing you, sweetie. There won’t be much to do tomorrow anyway."
    ma "Estou só brincando com você, querida. De qualquer forma, não haverá muito o que fazer amanhã."

# game/chapters/chapter1/script/ch1sc5.rpy:93
translate brazil ch1sc5_de213930:

#   ma "Besides, [mc] can help out with the chores."
    ma "Além do mais, [mc] Pode ajudar nas tarefas domésticas."

# game/chapters/chapter1/script/ch1sc5.rpy:95
translate brazil ch1sc5_2f478134:

#   pa "He’s such a good kid... he has the kind soul of his mother."
    pa "Ele é um menino tão bom... tem a alma bondosa da mãe."

# game/chapters/chapter1/script/ch1sc5.rpy:97
translate brazil ch1sc5_49fe3569:

#   ma "He definitely gets his charm from his father."
    ma "Ele definitivamente herdou o charme do pai."

# game/chapters/chapter1/script/ch1sc5.rpy:98
translate brazil ch1sc5_0272c81a:

#   ma "Can you believe [mc] is 10 summers already?"
    ma "Você acredita? [mc] Já se passaram 10 verões?"

# game/chapters/chapter1/script/ch1sc5.rpy:100
translate brazil ch1sc5_ad1ec465:

#   pa "I still remember him coming into our lives, as if it were yesterday."
    pa "Ainda me lembro dele entrando em nossas vidas como se fosse ontem."

# game/chapters/chapter1/script/ch1sc5.rpy:102
translate brazil ch1sc5_c0ebd671:

#   ma "I know... we'd tried to have a child for so many years, honey."
    ma "Eu sei... nós tentamos ter um filho por tantos anos, querida."

# game/chapters/chapter1/script/ch1sc5.rpy:103
translate brazil ch1sc5_dad6fc7a:

#   ma "For some reason, I just couldn’t become pregnant."
    ma "Por algum motivo, eu simplesmente não conseguia engravidar."

# game/chapters/chapter1/script/ch1sc5.rpy:105
translate brazil ch1sc5_2c3600ce:

#   pa "Until that fateful night..."
    pa "Até aquela noite fatídica..."

# game/chapters/chapter1/script/ch1sc5.rpy:107
translate brazil ch1sc5_3719e4f0:

#   ma "Yes. That night changed our lives..."
    ma "Sim. Aquela noite mudou nossas vidas..."

# game/chapters/chapter1/script/ch1sc5.rpy:109
translate brazil ch1sc5_2aa05a37:

#   ma "We have [mc] now thanks to that."
    ma "Nós temos [mc] Agora, graças a isso."

# game/chapters/chapter1/script/ch1sc5.rpy:111
translate brazil ch1sc5_fee6d3fd:

#   mat "I just pray nothing will happen to him."
    mat "Só rezo para que nada lhe aconteça."

# game/chapters/chapter1/script/ch1sc5.rpy:112
translate brazil ch1sc5_e1637bcf:

#   mat "I refuse to let anyone use him for their own gain... people in power often exploit others."
    mat "Recuso-me a deixar que alguém o use para proveito próprio... pessoas no poder frequentemente exploram os outros."

# game/chapters/chapter1/script/ch1sc5.rpy:114
translate brazil ch1sc5_5cd57d31:

#   mat "I don’t regret for a second what happened that night..."
    mat "Não me arrependo nem por um segundo do que aconteceu naquela noite..."

