# ARQUIVO: game/chapters/chapter1/script/ch1sc7.rpy DIALOGOS: 57


# game/chapters/chapter1/script/ch1sc7.rpy:15
translate brazil ch1sc7_f4591dc5:

#   al "[mc]... [mc]! Wake up!"
    al "[mc]... [mc]! Acordar!"

# game/chapters/chapter1/script/ch1sc7.rpy:17
translate brazil ch1sc7_3c15ed5b:

#   mc "Hmmmh..."
    mc "Hmmm..."

# game/chapters/chapter1/script/ch1sc7.rpy:23
translate brazil ch1sc7_8a531916:

#   mc "Huh? Alice?"
    mc "Hein? Alice?"

# game/chapters/chapter1/script/ch1sc7.rpy:25
translate brazil ch1sc7_fce6338c:

#   al "Come on, [mc]! It’s dark... we need to get home!"
    al "Vamos, [mc] Está escuro... precisamos ir para casa!"

# game/chapters/chapter1/script/ch1sc7.rpy:27
translate brazil ch1sc7_a03a7c9d:

#   al "I heard some rustling in the bushes..."
    al "Ouvi um farfalhar nos arbustos..."

# game/chapters/chapter1/script/ch1sc7.rpy:29
translate brazil ch1sc7_20fde691:

#   mct "Alice must be scared, but she doesn’t want to admit it."
    mct "Alice deve estar com medo, mas não quer admitir."

# game/chapters/chapter1/script/ch1sc7.rpy:33
translate brazil ch1sc7_d8397ef6:

#   mc "I can’t believe we slept that long."
    mc "Não acredito que dormimos tanto tempo."

# game/chapters/chapter1/script/ch1sc7.rpy:34
translate brazil ch1sc7_90fa707b:

#   mc "Alright, let's go home."
    mc "Muito bem, vamos para casa."

# game/chapters/chapter1/script/ch1sc7.rpy:38
translate brazil ch1sc7_f15ca705:

#   al "Here, I’ll help you up."
    al "Ei, eu te ajudo a levantar."

# game/chapters/chapter1/script/ch1sc7.rpy:40
translate brazil ch1sc7_c4b9b24b:

#   "She grabs your hand firmly and pulls you to your feet."
    "Ela segura sua mão com firmeza e te puxa para que você fique de pé."

# game/chapters/chapter1/script/ch1sc7.rpy:42
translate brazil ch1sc7_dda316b5:

#   mc "Thanks. Lets get home before our parents make us do chores until next moon."
    mc "Obrigado. Vamos para casa antes que nossos pais nos façam fazer tarefas domésticas até a próxima lua."

# game/chapters/chapter1/script/ch1sc7.rpy:43
translate brazil ch1sc7_e4416bbe:

#   al "It's so dark out here."
    al "Está muito escuro aqui fora."

# game/chapters/chapter1/script/ch1sc7.rpy:45
translate brazil ch1sc7_7540538c:

#   mc "Come. I'll protect you, remember?"
    mc "Venha. Eu vou te proteger, lembra?"

# game/chapters/chapter1/script/ch1sc7.rpy:47
translate brazil ch1sc7_cd48c796:

#   al "Y... Yes. Okay, let’s go!"
    al "Sim... Ok, vamos lá!"

# game/chapters/chapter1/script/ch1sc7.rpy:49
translate brazil ch1sc7_d301af23:

#   mc "Don’t worry, Alice. I won’t let anything bad happen to you... not ever!"
    mc "Não se preocupe, Alice. Eu não vou deixar nada de ruim acontecer com você... nunca!"

# game/chapters/chapter1/script/ch1sc7.rpy:51
translate brazil ch1sc7_9cc6a21a:

#   "Rustling sounds from nearby bushes."
    "Sons farfalhantes vindos de arbustos próximos."

# game/chapters/chapter1/script/ch1sc7.rpy:52
translate brazil ch1sc7_ea0800e5:

#   al "Did you hear that!?"
    al "Você ouviu isso!?"

# game/chapters/chapter1/script/ch1sc7.rpy:54
translate brazil ch1sc7_785077fa:

#   mc "Maybe it’s a troll? Or..."
    mc "Talvez seja um troll? Ou..."

# game/chapters/chapter1/script/ch1sc7.rpy:56
translate brazil ch1sc7_a69e0b2e:

#   al "T-Troll?!"
    al "T-Troll?!"

# game/chapters/chapter1/script/ch1sc7.rpy:58
translate brazil ch1sc7_71ce503c:

#   al "Trolls aren’t real, r-right?"
    al "Os trolls não existem de verdade, né?"

# game/chapters/chapter1/script/ch1sc7.rpy:60
translate brazil ch1sc7_0912e049:

#   mc "They are... but they live up in the mountains, usually in caves."
    mc "Eles existem... mas vivem nas montanhas, geralmente em cavernas."

# game/chapters/chapter1/script/ch1sc7.rpy:61
translate brazil ch1sc7_4eb43493:

#   mc "The most dangerous thing this close to the village would be wild boars..."
    mc "O maior perigo tão perto da aldeia seriam os javalis..."

# game/chapters/chapter1/script/ch1sc7.rpy:62
translate brazil ch1sc7_d6935327:

#   mc "...maybe a direwolf. But they are very rare."
    mc "...talvez um lobo gigante. Mas eles são muito raros."

# game/chapters/chapter1/script/ch1sc7.rpy:64
translate brazil ch1sc7_d33459b9:

#   al "You promise nothing bad is out here?"
    al "Você promete que não há nada de ruim por aqui?"

# game/chapters/chapter1/script/ch1sc7.rpy:66
translate brazil ch1sc7_fe824c30:

#   mc "Yes, Alice. The hunters told me themselves last time I was with Papa at the meat market."
    mc "Sim, Alice. Os caçadores me contaram isso pessoalmente da última vez que estive com o papai no mercado de carne."

# game/chapters/chapter1/script/ch1sc7.rpy:68
translate brazil ch1sc7_a57219e2:

#   al_t "Phew. That does make me feel a bit better. The hunters definitely know these woods better than us!"
    al_t "Ufa! Isso me deixa um pouco mais tranquilo. Os caçadores com certeza conhecem essas matas melhor do que nós!"

# game/chapters/chapter1/script/ch1sc7.rpy:69
translate brazil ch1sc7_bfb502a3:

#   al_t "I know it’s late, and it's his birthday... but I'd feel safer if he walked me home."
    al_t "Eu sei que é tarde e que é aniversário dele... mas eu me sentiria mais segura se ele me acompanhasse até em casa."

# game/chapters/chapter1/script/ch1sc7.rpy:71
translate brazil ch1sc7_f91e9e63:

#   al "Mmh... [mc]? Walk me home?"
    al "Hum... [mc] Você me acompanha até em casa?"

# game/chapters/chapter1/script/ch1sc7.rpy:78
translate brazil ch1sc7_54272d84:

#   "Alice's Trust has Increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "A confiança de Alice aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter1/script/ch1sc7.rpy:79
translate brazil ch1sc7_51e01bb8:

#   mc "Sure, Alice. Don't worry, I'll walk you home."
    mc "Claro, Alice. Não se preocupe, eu te acompanho até em casa."

# game/chapters/chapter1/script/ch1sc7.rpy:81
translate brazil ch1sc7_9126b9c8:

#   al "Yay! Thank you, thank you, thank you!"
    al "Eba! Muito obrigada!"

# game/chapters/chapter1/script/ch1sc7.rpy:82
translate brazil ch1sc7_30f60ce5:

#   al "Ahh! I feel much safer with you... thank you!"
    al "Ah! Me sinto muito mais segura com você... obrigada!"

# game/chapters/chapter1/script/ch1sc7.rpy:84
translate brazil ch1sc7_eb6dcf69:

#   mct "Ha, she seems excited."
    mct "Ah, ela parece animada."

# game/chapters/chapter1/script/ch1sc7.rpy:86
translate brazil ch1sc7_08c8b104:

#   mc "You don’t have to thank me, we’re best friends."
    mc "Você não precisa me agradecer, somos melhores amigos."

# game/chapters/chapter1/script/ch1sc7.rpy:88
translate brazil ch1sc7_0a25ee3a:

#   al "Still... you’re always so kind to me."
    al "Mesmo assim... você é sempre tão gentil comigo."

# game/chapters/chapter1/script/ch1sc7.rpy:90
translate brazil ch1sc7_98b85a4a:

#   al "The others... they..."
    al "Os outros... eles..."

# game/chapters/chapter1/script/ch1sc7.rpy:92
translate brazil ch1sc7_d8072e95:

#   mc "I know, Alice. Do they still bother you?"
    mc "Eu sei, Alice. Eles ainda te incomodam?"

# game/chapters/chapter1/script/ch1sc7.rpy:94
translate brazil ch1sc7_886f89f0:

#   al "Not since you scared them off."
    al "Não desde que você os espantou."

# game/chapters/chapter1/script/ch1sc7.rpy:96
translate brazil ch1sc7_8be935ff:

#   mc "And I’ll do it again."
    mc "E farei isso de novo."

# game/chapters/chapter1/script/ch1sc7.rpy:98
translate brazil ch1sc7_83b4969b:

#   al "*Giggles* My knight."
    al "*Risos* Meu cavaleiro."

# game/chapters/chapter1/script/ch1sc7.rpy:99
translate brazil ch1sc7_5e5a1e1f:

#   mc "*Chuckles* I’ve been called worse."
    mc "*Risos* Já me chamaram de coisas piores."

# game/chapters/chapter1/script/ch1sc7.rpy:100
translate brazil ch1sc7_857377c6:

#   al "I bet you have!"
    al "Aposto que sim!"

# game/chapters/chapter1/script/ch1sc7.rpy:102
translate brazil ch1sc7_20237517:

#   "You continue chatting for a while as you walk Alice home."
    "Vocês continuam conversando por um tempo enquanto acompanham Alice até em casa."

# game/chapters/chapter1/script/ch1sc7.rpy:104
translate brazil ch1sc7_e6f3c6cb:

#   mc "Here we are Alice, I hope you won’t get in trouble for being out late."
    mc "Aqui estamos, Alice. Espero que você não se meta em encrenca por ter chegado tarde."

# game/chapters/chapter1/script/ch1sc7.rpy:106
translate brazil ch1sc7_6f1a2b3b:

#   al "No biggies. Mom knows it's your birthday. But if I do get in trouble, I’ll totally blame you!"
    al "Sem problemas. Mamãe sabe que é seu aniversário. Mas se eu me meter em encrenca, a culpa é toda sua!"

# game/chapters/chapter1/script/ch1sc7.rpy:108
translate brazil ch1sc7_a505159b:

#   mc "You might as well, Beth hates me."
    mc "Você também pode fazer isso, Beth me odeia."

# game/chapters/chapter1/script/ch1sc7.rpy:109
translate brazil ch1sc7_d9a14c0e:

#   al "No she doesn't, she just thinks you're a bad influence on me."
    al "Não, ela não pensa assim, ela apenas acha que você é uma má influência para mim."

# game/chapters/chapter1/script/ch1sc7.rpy:110
translate brazil ch1sc7_14e25058:

#   mc "Maybe I am, bye bye, Alice. Thanks for making my birthday amazing!"
    mc "Talvez eu seja, tchau tchau, Alice. Obrigada por tornar meu aniversário incrível!"

# game/chapters/chapter1/script/ch1sc7.rpy:111
translate brazil ch1sc7_9ca154bf:

#   al "*Giggles* Anytime [mc]!"
    al "*Risos* A qualquer hora [mc]!"

# game/chapters/chapter1/script/ch1sc7.rpy:117
translate brazil ch1sc7_c442a27c:

#   "You decide it's best not to keep your worried parents waiting any longer."
    "Você decide que é melhor não deixar seus pais preocupados esperando mais."

# game/chapters/chapter1/script/ch1sc7.rpy:119
translate brazil ch1sc7_b75dbf3e:

#   mc "Okay, Alice. You can see your house from here, let's separate."
    mc "Certo, Alice. Você consegue ver sua casa daqui, vamos nos separar."

# game/chapters/chapter1/script/ch1sc7.rpy:120
translate brazil ch1sc7_5a270e38:

#   mc "We don’t want our parents to worry any longer than they already have..."
    mc "Não queremos que nossos pais se preocupem mais do que já estão..."

# game/chapters/chapter1/script/ch1sc7.rpy:121
translate brazil ch1sc7_e758ff78:

#   mc "We might get a big, big, big ass-whooping for being out this late!"
    mc "Podemos levar uma surra daquelas por estarmos na rua tão tarde!"

# game/chapters/chapter1/script/ch1sc7.rpy:123
translate brazil ch1sc7_cd92137c:

#   al "Aww... Okay. Bye bye, [mc]. Be safe!"
    al "Ah... Ok. Tchau tchau. [mc] Fique em segurança!"

# game/chapters/chapter1/script/ch1sc7.rpy:125
translate brazil ch1sc7_04c30ca6:

#   mc "Bye! See you tomorrow!"
    mc "Tchau! Até amanhã!"

# game/chapters/chapter1/script/ch1sc7.rpy:126
translate brazil ch1sc7_a2c01cb5:

#   mct "Thank you, Alice. I can’t imagine my life without you in it."
    mct "Obrigada, Alice. Não consigo imaginar minha vida sem você."

# game/chapters/chapter1/script/ch1sc7.rpy:132
translate brazil ch1sc7_2945afba:

#   mct "Shitsticks! I’ve gotta get home fast! Mama and Papa will not be happy."
    mct "Droga! Preciso chegar em casa rápido! Mamãe e papai não vão gostar nada disso."

