# ARQUIVO: game/chapters/chapter1/script/ch1sc6.rpy DIALOGOS: 91


# game/chapters/chapter1/script/ch1sc6.rpy:13
translate brazil ch1sc6_dd139b09:

#   ma "Okay... that's the last crystal in place for the ritual."
    ma "Ok... esse é o último cristal a ser colocado no ritual."

# game/chapters/chapter1/script/ch1sc6.rpy:15
translate brazil ch1sc6_2eaff88b:

#   pa "Honey... are you sure this is a good idea?"
    pa "Querida... você tem certeza de que isso é uma boa ideia?"

# game/chapters/chapter1/script/ch1sc6.rpy:16
translate brazil ch1sc6_9ae5895f:

#   pa "We have no idea what to expect."
    pa "Não temos ideia do que esperar."

# game/chapters/chapter1/script/ch1sc6.rpy:18
translate brazil ch1sc6_321c0aba:

#   ma "We talked about this. It’s the only way."
    ma "Já conversamos sobre isso. É o único jeito."

# game/chapters/chapter1/script/ch1sc6.rpy:19
translate brazil ch1sc6_3c06c250:

#   ma "We’ve spent the last two years searching for answers."
    ma "Passamos os últimos dois anos em busca de respostas."

# game/chapters/chapter1/script/ch1sc6.rpy:21
translate brazil ch1sc6_aef96fd0:

#   pa "I know. It just feels like we are messing with things beyond our understanding."
    pa "Eu sei. Parece que estamos mexendo com coisas que não conseguimos entender."

# game/chapters/chapter1/script/ch1sc6.rpy:23
translate brazil ch1sc6_dee56c46:

#   ma "We're just summoning an Angel. It’s not like we're the first to do so..."
    ma "Estamos apenas invocando um anjo. Não é como se fôssemos os primeiros a fazer isso..."

# game/chapters/chapter1/script/ch1sc6.rpy:24
translate brazil ch1sc6_ae04ad86:

#   ma "Oh, or maybe we are?"
    ma "Ah, ou talvez sejamos?"

# game/chapters/chapter1/script/ch1sc6.rpy:26
translate brazil ch1sc6_45fac29c:

#   pa "Honey... I’m amazed you can joke in this situation."
    pa "Querida... Estou impressionada que você consiga fazer piada nessa situação."

# game/chapters/chapter1/script/ch1sc6.rpy:28
translate brazil ch1sc6_4a3f9e5f:

#   ma "Shhh... I have to concentrate."
    ma "Shhh... Preciso me concentrar."

# game/chapters/chapter1/script/ch1sc6.rpy:29
translate brazil ch1sc6_33249b97:

#   pa "Okay, okay. Let’s do it."
    pa "Ok, ok. Vamos lá."

# game/chapters/chapter1/script/ch1sc6.rpy:31
translate brazil ch1sc6_a564b7c2:

#   ma "I’m going to create a binding circle. If I infuse enough of my magic into it..."
    ma "Vou criar um círculo de ligação. Se eu infundir magia suficiente nele..."

# game/chapters/chapter1/script/ch1sc6.rpy:32
translate brazil ch1sc6_e723c67c:

#   ma "... it should be strong enough to hold anything."
    ma "...deveria ser forte o suficiente para suportar qualquer coisa."

# game/chapters/chapter1/script/ch1sc6.rpy:33
translate brazil ch1sc6_cb16be87:

#   pa "..."
    pa "..."

# game/chapters/chapter1/script/ch1sc6.rpy:35
translate brazil ch1sc6_3a7af25c:

#   "A sphere of energy begins to form between her palms."
    "Uma esfera de energia começa a se formar entre as palmas das mãos dela."

# game/chapters/chapter1/script/ch1sc6.rpy:37
translate brazil ch1sc6_438bbcb9:

#   "The crystals begin to vibrate, making a quiet humming sound."
    "Os cristais começam a vibrar, produzindo um zumbido suave."

# game/chapters/chapter1/script/ch1sc6.rpy:39
translate brazil ch1sc6_3e97c858:

#   "One by one they light up."
    "Uma a uma, elas se iluminam."

# game/chapters/chapter1/script/ch1sc6.rpy:47
translate brazil ch1sc6_1774b59f:

#   "The sphere of raw concentrated magic appears ready."
    "A esfera da magia bruta e concentrada parece pronta."

# game/chapters/chapter1/script/ch1sc6.rpy:49
translate brazil ch1sc6_b92a671e:

#   "Slowly, she sends the sphere towards the lights."
    "Lentamente, ela envia a esfera em direção às luzes."

# game/chapters/chapter1/script/ch1sc6.rpy:59
translate brazil ch1sc6_4e68ab45:

#   "The sphere transforms into a large binding circle filled with magic."
    "A esfera se transforma em um grande círculo de ligação repleto de magia."

# game/chapters/chapter1/script/ch1sc6.rpy:61
translate brazil ch1sc6_bfbe949c:

#   "The crystals seem to be containing the powerful magic in place."
    "Os cristais parecem estar contendo a poderosa magia."

# game/chapters/chapter1/script/ch1sc6.rpy:63
translate brazil ch1sc6_3904cbdc:

#   pa "It worked! You’re amazing honey!"
    pa "Funcionou! Você é incrível, querida!"

# game/chapters/chapter1/script/ch1sc6.rpy:65
translate brazil ch1sc6_c41c59c3:

#   ma "I... It’s not over yet."
    ma "Eu... Ainda não acabou."

# game/chapters/chapter1/script/ch1sc6.rpy:66
translate brazil ch1sc6_22f133cd:

#   ma "Castiel... Angel of life. I summon thee, holiness."
    ma "Castiel... Anjo da vida. Eu te invoco, santidade."

# game/chapters/chapter1/script/ch1sc6.rpy:68
translate brazil ch1sc6_18eeed18:

#   ma "Oh Castiel... Mighty warrior of light. Hear my summons."
    ma "Ó Castiel... Poderoso guerreiro da luz. Ouça meu chamado."

# game/chapters/chapter1/script/ch1sc6.rpy:70
translate brazil ch1sc6_cc10c12d:

#   ma "I humbly beg your holy spirit..."
    ma "Humildemente imploro ao teu santo espírito..."

# game/chapters/chapter1/script/ch1sc6.rpy:72
translate brazil ch1sc6_b516b860:

#   ma "*Frustrated* ... It didn’t work."
    ma "*Frustrado*... Não funcionou."

# game/chapters/chapter1/script/ch1sc6.rpy:73
translate brazil ch1sc6_b86f54c3:

#   ma "All these years searching for answers..."
    ma "Todos esses anos em busca de respostas..."

# game/chapters/chapter1/script/ch1sc6.rpy:74
translate brazil ch1sc6_c22d9806:

#   ma "This was our last hope!"
    ma "Essa era a nossa última esperança!"

# game/chapters/chapter1/script/ch1sc6.rpy:75
translate brazil ch1sc6_dfaccc4e:

#   pa "Don’t blame yourself, honey. You did everything you could."
    pa "Não se culpe, querida. Você fez tudo o que podia."

# game/chapters/chapter1/script/ch1sc6.rpy:76
translate brazil ch1sc6_697cdd10:

#   pa "We knew it was a stab in the dark."
    pa "Sabíamos que era um tiro no escuro."

# game/chapters/chapter1/script/ch1sc6.rpy:78
translate brazil ch1sc6_79596a6a:

#   ma "The summoning should have worked. I infused all my magic into it."
    ma "A invocação deveria ter funcionado. Eu infundi toda a minha magia nela."

# game/chapters/chapter1/script/ch1sc6.rpy:79
translate brazil ch1sc6_25d8578c:

#   pa "Wait! What's happening?!"
    pa "Espere! O que está acontecendo?!"

# game/chapters/chapter1/script/ch1sc6.rpy:81
translate brazil ch1sc6_82dcf712:

#   ma "*Sniff* Huh?!"
    ma "*Cheira* Hã?!"

# game/chapters/chapter1/script/ch1sc6.rpy:84
translate brazil ch1sc6_035f8e3e:

#   "Suddenly an incredible force of raw energy appears within the circle!"
    "Subitamente, uma força incrível de energia bruta surge dentro do círculo!"

# game/chapters/chapter1/script/ch1sc6.rpy:85
translate brazil ch1sc6_ab0bf22b:

#   "It expands rapidly."
    "Expande-se rapidamente."

# game/chapters/chapter1/script/ch1sc6.rpy:91
translate brazil ch1sc6_d19c5f4e:

#   pa "Honey! Be careful!!"
    pa "Querida! Tenha cuidado!!"

# game/chapters/chapter1/script/ch1sc6.rpy:93
translate brazil ch1sc6_779f9869:

#   "A bright blinding light fills the room."
    "Uma luz forte e ofuscante preenche a sala."

# game/chapters/chapter1/script/ch1sc6.rpy:95
translate brazil ch1sc6_3ef0f260:

#   "As the light fades, a figure appears in the circle."
    "À medida que a luz diminui, uma figura aparece no círculo."

# game/chapters/chapter1/script/ch1sc6.rpy:100
translate brazil ch1sc6_3eb04c98:

#   ma "By the gods!! It worked!"
    ma "Pelos deuses!! Funcionou!"

# game/chapters/chapter1/script/ch1sc6.rpy:102
translate brazil ch1sc6_4af66c0a:

#   pa "By the Divines! Y... You actually did it!"
    pa "Pelos deuses! Você... Você realmente conseguiu!"

# game/chapters/chapter1/script/ch1sc6.rpy:104
translate brazil ch1sc6_3c114446:

#   ma "C... Castiel?"
    ma "C... Castiel?"

# game/chapters/chapter1/script/ch1sc6.rpy:106
translate brazil ch1sc6_00fb4568:

#   ca "..."
    ca "..."

# game/chapters/chapter1/script/ch1sc6.rpy:108
translate brazil ch1sc6_ed456bed:

#   ma "C... Castiel, my sincerest apologies for summoning you."
    ma "C... Castiel, minhas mais sinceras desculpas por tê-lo invocado."

# game/chapters/chapter1/script/ch1sc6.rpy:110
translate brazil ch1sc6_6451c061:

#   ma "We’re so desperate. We’ve tried and tried, but nothing..."
    ma "Estamos desesperados. Tentamos de tudo, mas nada..."

# game/chapters/chapter1/script/ch1sc6.rpy:112
translate brazil ch1sc6_c28b3c15:

#   "The Angelic figure rises slowly."
    "A figura angelical se ergue lentamente."

# game/chapters/chapter1/script/ch1sc6.rpy:114
translate brazil ch1sc6_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter1/script/ch1sc6.rpy:116
translate brazil ch1sc6_83fb1906:

#   ca "I know your situation."
    ca "Eu entendo sua situação."

# game/chapters/chapter1/script/ch1sc6.rpy:118
translate brazil ch1sc6_93ab2dc2:

#   ma "Y... You do? Can you help us?"
    ma "Você... Você faz isso? Pode nos ajudar?"

# game/chapters/chapter1/script/ch1sc6.rpy:120
translate brazil ch1sc6_6266979b:

#   ca "I can."
    ca "Eu posso."

# game/chapters/chapter1/script/ch1sc6.rpy:121
translate brazil ch1sc6_ef13804d:

#   ca "However... it’s strictly forbidden."
    ca "No entanto... é estritamente proibido."

# game/chapters/chapter1/script/ch1sc6.rpy:123
translate brazil ch1sc6_79dc3680:

#   ma "Please... Castiel. If you heard our prayers, you must know our intentions and feelings?"
    ma "Por favor... Castiel. Se você ouviu nossas orações, deve saber nossas intenções e sentimentos?"

# game/chapters/chapter1/script/ch1sc6.rpy:125
translate brazil ch1sc6_5fc54399:

#   ca "That is the only reason I answered your summons."
    ca "Essa é a única razão pela qual atendi à sua convocação."

# game/chapters/chapter1/script/ch1sc6.rpy:127
translate brazil ch1sc6_4c070113:

#   ca "This child that you dream of... he will come to have incredible power."
    ca "Essa criança com quem você sonha... ela terá um poder incrível."

# game/chapters/chapter1/script/ch1sc6.rpy:129
translate brazil ch1sc6_afdf01b9:

#   ca "It’s of utmost importance that he is raised with love and compassion."
    ca "É de extrema importância que ele seja criado com amor e compaixão."

# game/chapters/chapter1/script/ch1sc6.rpy:131
translate brazil ch1sc6_e74dbdd0:

#   ma "He will grow up loved! We will care for him with all we have, & teach him all we know in life!"
    ma "Ele crescerá amado! Cuidaremos dele com tudo o que temos e o ensinaremos tudo o que sabemos da vida!"

# game/chapters/chapter1/script/ch1sc6.rpy:133
translate brazil ch1sc6_d2601925:

#   ca "You must swear it upon your unborn child's life. If I bless you with a child, he will be a Nephilim."
    ca "Você deve jurar pela vida do seu filho ainda não nascido. Se eu te abençoar com um filho, ele será um Nefilim."

# game/chapters/chapter1/script/ch1sc6.rpy:135
translate brazil ch1sc6_99da373f:

#   ma "Nephilim? What does that mean?"
    ma "Nefilins? O que isso significa?"

# game/chapters/chapter1/script/ch1sc6.rpy:137
translate brazil ch1sc6_81b99068:

#   ca "A Nephilim is a half human, half angel hybrid."
    ca "Um Nefilim é um híbrido meio humano, meio anjo."

# game/chapters/chapter1/script/ch1sc6.rpy:139
translate brazil ch1sc6_a41f044a:

#   ca "There has only been one other Nephilim in the history of Midomir."
    ca "Na história de Midomir, houve apenas um outro Nefilim."

# game/chapters/chapter1/script/ch1sc6.rpy:141
translate brazil ch1sc6_d77a0ae3:

#   ca "He became consumed with power... he brought an end to the first era."
    ca "Ele se deixou consumir pelo poder... e pôs fim à primeira era."

# game/chapters/chapter1/script/ch1sc6.rpy:143
translate brazil ch1sc6_cdc93b0e:

#   ca "Thousands of innocents died in agony... despair flooded the lands."
    ca "Milhares de inocentes morreram em agonia... o desespero inundou a terra."

# game/chapters/chapter1/script/ch1sc6.rpy:145
translate brazil ch1sc6_d778202f:

#   ca "Ever since then, angels have been forbidden to interfere with mortals. Especially having children with them."
    ca "Desde então, os anjos estão proibidos de interferir na vida dos mortais, especialmente de ter filhos com eles."

# game/chapters/chapter1/script/ch1sc6.rpy:147
translate brazil ch1sc6_b73e7508:

#   ma "Please, Castiel, we will raise him right. If what you say is true, he will be a miracle. A beacon of hope."
    ma "Por favor, Castiel, nós o criaremos corretamente. Se o que você diz for verdade, ele será um milagre. Um farol de esperança."

# game/chapters/chapter1/script/ch1sc6.rpy:149
translate brazil ch1sc6_01569590:

#   ca "I can sense your emotions... your heart is pure."
    ca "Consigo sentir suas emoções... seu coração é puro."

# game/chapters/chapter1/script/ch1sc6.rpy:152
translate brazil ch1sc6_4e126fa1:

#   ca "Very well."
    ca "Muito bem."

# game/chapters/chapter1/script/ch1sc6.rpy:153
translate brazil ch1sc6_db8bb190:

#   ca "I will bless you with a child."
    ca "Eu te abençoarei com um filho."

# game/chapters/chapter1/script/ch1sc6.rpy:155
translate brazil ch1sc6_0f925785:

#   ca "But don't make me regret this decision."
    ca "Mas não me faça me arrepender dessa decisão."

# game/chapters/chapter1/script/ch1sc6.rpy:157
translate brazil ch1sc6_d0cce54f:

#   ca_t "This child will be the only one able to stop Balthazar."
    ca_t "Essa criança será a única capaz de deter Baltazar."

# game/chapters/chapter1/script/ch1sc6.rpy:159
translate brazil ch1sc6_48ca8751:

#   ma "Bless you, Castiel! I... I don't know what to say."
    ma "Deus te abençoe, Castiel! Eu... eu não sei o que dizer."

# game/chapters/chapter1/script/ch1sc6.rpy:161
translate brazil ch1sc6_2ca44e82:

#   ca "Go lay down on the bed and I will take care of the rest."
    ca "Deite-se na cama e eu cuidarei do resto."

# game/chapters/chapter1/script/ch1sc6.rpy:163
translate brazil ch1sc6_8ac99227:

#   ma "T... the bed. "
    ma "T... a cama. "

# game/chapters/chapter1/script/ch1sc6.rpy:164
translate brazil ch1sc6_5bbf9514:

#   ma "*Nervous* O... Okay."
    ma "*Nervosa* Ah... Ok."

# game/chapters/chapter1/script/ch1sc6.rpy:166
translate brazil ch1sc6_c6f5282b:

#   "She carefully walks past Castiel and approaches the empty bed."
    "Ela passa cuidadosamente por Castiel e se aproxima da cama vazia."

# game/chapters/chapter1/script/ch1sc6.rpy:168
translate brazil ch1sc6_7bdce0e3:

#   "She leans over to grab the bottom of her dress."
    "Ela se inclina para segurar a barra do vestido."

# game/chapters/chapter1/script/ch1sc6.rpy:169
translate brazil ch1sc6_2e5c3ea7:

#   ca "Stop."
    ca "Parar."

# game/chapters/chapter1/script/ch1sc6.rpy:171
translate brazil ch1sc6_19590f98:

#   ma "Huh?"
    ma "Huh?"

# game/chapters/chapter1/script/ch1sc6.rpy:173
translate brazil ch1sc6_002b5645:

#   ca "No need for that, just lay down."
    ca "Não precisa disso, apenas deite-se."

# game/chapters/chapter1/script/ch1sc6.rpy:175
translate brazil ch1sc6_8f1f2714:

#   ma "O... Okay. I'm not sure how this works."
    ma "Ah... Ok. Não tenho certeza de como isso funciona."

# game/chapters/chapter1/script/ch1sc6.rpy:177
translate brazil ch1sc6_d417a397:

#   ca "You’ll see."
    ca "Você vai ver."

# game/chapters/chapter1/script/ch1sc6.rpy:179
translate brazil ch1sc6_17830ead:

#   ma "W... Will it hurt?"
    ma "Vai doer?"

# game/chapters/chapter1/script/ch1sc6.rpy:181
translate brazil ch1sc6_8b43d5d2:

#   ca "You’ll feel a tiny tingle in your belly, nothing else."
    ca "Você sentirá um leve formigamento na barriga, nada mais."

# game/chapters/chapter1/script/ch1sc6.rpy:182
translate brazil ch1sc6_d01ced06:

#   ca "I’m infusing some of my essence with yours, thus making you pregnant."
    ca "Estou infundindo um pouco da minha essência com a sua, fazendo com que você engravide."

# game/chapters/chapter1/script/ch1sc6.rpy:184
translate brazil ch1sc6_0ae63f8b:

#   ma "Mh! Ahh... it’s warm."
    ma "Hum! Ah... está quentinho."

# game/chapters/chapter1/script/ch1sc6.rpy:185
translate brazil ch1sc6_4883a428:

#   "Castiel proceeds to infuse her with pure angelic energy."
    "Castiel então a imbuí com pura energia angelical."

# game/chapters/chapter1/script/ch1sc6.rpy:189
translate brazil ch1sc6_51d80832:

#   ca "It’s done. Remember what I’ve told you, protect him at all costs."
    ca "Está feito. Lembre-se do que eu lhe disse: proteja-o a todo custo."

# game/chapters/chapter1/script/ch1sc6.rpy:190
translate brazil ch1sc6_002a0adb:

#   ca "If you let him fall to darkness, I will have to... end him."
    ca "Se você o deixar sucumbir à escuridão, terei que... acabar com ele."

# game/chapters/chapter1/script/ch1sc6.rpy:192
translate brazil ch1sc6_771f0c6b:

#   ma "Thank you! Thank you! Thank you! We’ll cherish this child with all the love our hearts contain!"
    ma "Muito obrigada! Muito obrigada! Muito obrigada! Vamos amar esta criança com todo o carinho que nossos corações têm!"

# game/chapters/chapter1/script/ch1sc6.rpy:194
translate brazil ch1sc6_add83bdd:

#   ca "I have no doubt. Goodbye."
    ca "Não tenho dúvidas. Adeus."

# game/chapters/chapter1/script/ch1sc6.rpy:196
translate brazil ch1sc6_81afec93:

#   "As Castiel rises, the room starts vibrating, accompanied by a high-pitched sound."
    "Conforme Castiel se levanta, a sala começa a vibrar, acompanhada por um som agudo."

# game/chapters/chapter1/script/ch1sc6.rpy:150
translate brazil ch1sc6_00fb4568_1:

#   ca "..."
    ca "..."

