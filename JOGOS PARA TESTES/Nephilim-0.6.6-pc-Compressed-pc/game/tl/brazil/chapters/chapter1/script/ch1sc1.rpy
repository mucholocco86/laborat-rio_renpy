# ARQUIVO: game/chapters/chapter1/script/ch1sc1.rpy DIALOGOS: 138


# game/chapters/chapter1/script/ch1sc1.rpy:11
translate brazil ch1sc1_ce19857f:

#   "This is you. You have a long journey ahead, filled with adventure, friendship, love, lust, betrayal..."
    "Este é você. Você tem uma longa jornada pela frente, repleta de aventura, amizade, amor, desejo, traição..."

# game/chapters/chapter1/script/ch1sc1.rpy:12
translate brazil ch1sc1_72f65ef1:

#   "But first you must decide on a name. How else will the bards write songs about your heroism?"
    "Mas primeiro você precisa escolher um nome. De que outra forma os bardos escreverão canções sobre o seu heroísmo?"

# game/chapters/chapter1/script/ch1sc1.rpy:13
translate brazil ch1sc1_77eeb26e:

#   "You are going to be a hero... right?"
    "Você vai ser um herói... não é?"

# game/chapters/chapter1/script/ch1sc1.rpy:41
translate brazil ch1sc1_57d94e77:

#   al "Hi there! I’m Alice. My boss, the developer, has asked me to meet you here!"
    al "Olá! Meu nome é Alice. Meu chefe, o desenvolvedor, pediu para eu me encontrar com vocês aqui!"

# game/chapters/chapter1/script/ch1sc1.rpy:43
translate brazil ch1sc1_91c16417:

#   al "He wanted me to give you a few details about the game, and how it plays."
    al "Ele queria que eu desse alguns detalhes sobre o jogo e como ele funciona."

# game/chapters/chapter1/script/ch1sc1.rpy:45
translate brazil ch1sc1_5d025fd0:

#   al "I’m sure a smart individual such as yourself can figure it out, no problem!"
    al "Tenho certeza de que uma pessoa inteligente como você conseguirá resolver isso sem problemas!"

# game/chapters/chapter1/script/ch1sc1.rpy:47
translate brazil ch1sc1_845beec9:

#   al "But he always reminds me that I have too much faith in people."
    al "Mas ele sempre me lembra que tenho fé demais nas pessoas."

# game/chapters/chapter1/script/ch1sc1.rpy:48
translate brazil ch1sc1_ffac97b2:

#   al "So please bear with me!"
    al "Então, por favor, tenham paciência comigo!"

# game/chapters/chapter1/script/ch1sc1.rpy:50
translate brazil ch1sc1_28f3465b:

#   al "Anywho... let’s get right to it!"
    al "Enfim... vamos direto ao assunto!"

# game/chapters/chapter1/script/ch1sc1.rpy:51
translate brazil ch1sc1_2d1948fd:

#   al "As you totally already know, Nephilim is a {b}Medieval, Dark/High fantasy story.{/b}"
    al "Como você já deve saber, Nephilim é um tipo de povo. {b} História medieval de fantasia sombria/alta fantasia.{/b}"

# game/chapters/chapter1/script/ch1sc1.rpy:52
translate brazil ch1sc1_39574964:

#   al "It takes place in a world known as {b}Midomir{/b}, during a medieval time period."
    al "A história se passa em um mundo conhecido como {b} Midomir{/b}, durante o período medieval."

# game/chapters/chapter1/script/ch1sc1.rpy:53
translate brazil ch1sc1_d124a319:

#   al "This means that you'll encounter various different species, such as gods and goddesses, angels and demons-"
    al "Isso significa que você encontrará diversas espécies diferentes, como deuses e deusas, anjos e demônios."

# game/chapters/chapter1/script/ch1sc1.rpy:54
translate brazil ch1sc1_a7129dd4:

#   al "-Devils and fairies, dwarves and elves and so many more!"
    al "-Demônios e fadas, anões e elfos e muito mais!"

# game/chapters/chapter1/script/ch1sc1.rpy:55
translate brazil ch1sc1_2f92a59b:

#   al "In Nephilim each species and kingdom has their own societal rules and beliefs they follow..."
    al "Entre os Nefilins, cada espécie e reino possui suas próprias regras e crenças sociais que seguem..."

# game/chapters/chapter1/script/ch1sc1.rpy:56
translate brazil ch1sc1_f49f1eeb:

#   al "Human society is a Patriarchy which means it's dominated by men and favors them over women."
    al "A sociedade humana é um patriarcado, o que significa que é dominada pelos homens e os favorece em detrimento das mulheres."

# game/chapters/chapter1/script/ch1sc1.rpy:57
translate brazil ch1sc1_5dc4bc1d:

#   al "Us women are often treated inferior to men or as a property of our spouses, while the men are free to do as they please."
    al "Nós, mulheres, somos frequentemente tratadas como inferiores aos homens ou como propriedade de nossos cônjuges, enquanto os homens são livres para fazer o que bem entenderem."

# game/chapters/chapter1/script/ch1sc1.rpy:58
translate brazil ch1sc1_5d5c6cc3:

#   al "Can you believe it? Some women are sentenced to death for infidelity, while the men can take as many partners as they see fit?"
    al "Acredita nisso? Algumas mulheres são condenadas à morte por infidelidade, enquanto os homens podem ter quantas parceiras quiserem?"

# game/chapters/chapter1/script/ch1sc1.rpy:59
translate brazil ch1sc1_2f530a62:

#   al "So not fair! Ugh! Anyways, what this means for you is that you can pick and choose which of us girls you'd like to surround yourself with."
    al "Que injustiça! Aff! Enfim, o que isso significa para você é que você pode escolher com quais de nós, garotas, você gostaria de se cercar."

# game/chapters/chapter1/script/ch1sc1.rpy:60
translate brazil ch1sc1_8857bbf2:

#   al "You want only one of us? Great! You want to have a little fun on the side? Great! You want to marry all of us? Awesome!"
    al "Você quer só uma de nós? Ótimo! Quer se divertir um pouco por fora? Ótimo! Quer casar com todas nós? Incrível!"

# game/chapters/chapter1/script/ch1sc1.rpy:61
translate brazil ch1sc1_bd2e49f1:

#   al "During the story you will be able to make choices. BIG surprise, I know!"
    al "Durante a história, você poderá fazer escolhas. Grande surpresa, eu sei!"

# game/chapters/chapter1/script/ch1sc1.rpy:63
translate brazil ch1sc1_7a93ad2c:

#   al "Some choices will {color=#00ff00}increase{/color} how much a person trusts you."
    al "Algumas opções serão {color=#00ff00} aumentar{/color} O quanto uma pessoa confia em você."

# game/chapters/chapter1/script/ch1sc1.rpy:64
translate brazil ch1sc1_6d0cb8ac:

#   al "While other choices can {color=#f00}decrease{/color} their trust in you!"
    al "Embora outras opções possam {color=#f00} diminuir{/color} A confiança que eles depositam em você!"

# game/chapters/chapter1/script/ch1sc1.rpy:66
translate brazil ch1sc1_a721721a:

#   al "Depending on how much they trust you, you may be able to romance some characters!"
    al "Dependendo do nível de confiança que eles depositam em você, você poderá até mesmo desenvolver um romance com alguns personagens!"

# game/chapters/chapter1/script/ch1sc1.rpy:67
translate brazil ch1sc1_c33e0c52:

#   al "Trust will also be used to determine friendships and whether someone will help you on certain quests."
    al "A confiança também será usada para determinar amizades e se alguém o ajudará em determinadas missões."

# game/chapters/chapter1/script/ch1sc1.rpy:69
translate brazil ch1sc1_9a412220:

#   al "Or some of them could betray you if their trust diminishes too much."
    al "Ou alguns deles podem te trair se a confiança neles diminuir demais."

# game/chapters/chapter1/script/ch1sc1.rpy:70
translate brazil ch1sc1_56001497:

#   al "That is definitely a possibility!"
    al "Isso é definitivamente uma possibilidade!"

# game/chapters/chapter1/script/ch1sc1.rpy:72
translate brazil ch1sc1_69139577:

#   al "Other than trust, some choices will also build your personal morality towards {color=#87e1fa}Light{/color} or {color=#f00}Dark.{/color}"
    al "Além da confiança, algumas escolhas também moldarão sua moralidade pessoal em relação a {color=#87e1fa} Luz{/color} ou {color=#f00} Escuro.{/color}"

# game/chapters/chapter1/script/ch1sc1.rpy:73
translate brazil ch1sc1_180b47c4:

#   al "Each morality will have its own ending, and the boss assured me they will be quite different!"
    al "Cada moral terá seu próprio final, e o chefe me garantiu que serão bem diferentes!"

# game/chapters/chapter1/script/ch1sc1.rpy:74
translate brazil ch1sc1_500823ad:

#   al "I should probably mention that most {color=#ff8cdd}romance{/color} options are neutral (available to both paths). However, there will be some that are tied to a specific path."
    al "Provavelmente devo mencionar que a maioria {color=#ff8cdd} romance{/color} As opções são neutras (disponíveis para ambos os caminhos). No entanto, haverá algumas que estarão vinculadas a um caminho específico."

# game/chapters/chapter1/script/ch1sc1.rpy:76
translate brazil ch1sc1_18e37424:

#   al "Oh, and if you wish, you can hide/show the textbox by pressing *H* key, or pressing the middle mouse button."
    al "Ah, e se desejar, você pode ocultar/exibir a caixa de texto pressionando a tecla *H* ou o botão do meio do mouse."

# game/chapters/chapter1/script/ch1sc1.rpy:77
translate brazil ch1sc1_e1b05df9:

#   al "You know, in case you wish to have a better view!"
    al "Sabe, caso você queira ter uma visão melhor!"

# game/chapters/chapter1/script/ch1sc1.rpy:79
translate brazil ch1sc1_6f424b61:

#   al "Oh shoot! I didn’t realize how long I’ve been yapping on for!"
    al "Puxa! Nem me dei conta de quanto tempo fiquei falando sem parar!"

# game/chapters/chapter1/script/ch1sc1.rpy:81
translate brazil ch1sc1_f4d3a23d:

#   al "I’m so sorry! We’ll probably see each other again..."
    al "Sinto muito! Provavelmente nos veremos de novo..."

# game/chapters/chapter1/script/ch1sc1.rpy:83
translate brazil ch1sc1_4208b180:

#   al "Please, it’s time for your adventure in Midomir to begin. Enjoy!"
    al "Por favor, chegou a hora de sua aventura em Midomir começar. Aproveite!"

# game/chapters/chapter1/script/ch1sc1.rpy:86
translate brazil ch1sc1_0411e8c7:

#   al "Ow! Who forgot to put the books away? This place is a mess!"
    al "Ai! Quem se esqueceu de guardar os livros? Que bagunça!"

# game/chapters/chapter1/script/ch1sc1.rpy:87
translate brazil ch1sc1_c23824df:

#   al "How am I supposed to get to lunch in time with all of you making such a mess!?"
    al "Como é que eu vou conseguir chegar a tempo para o almoço com toda essa bagunça que vocês estão fazendo?!"

# game/chapters/chapter1/script/ch1sc1.rpy:94
translate brazil ch1sc1_239e9d7a:

#   mct "We should cooking the mushrooms we foraged earlier."
    mct "Devemos cozinhar os cogumelos que colhemos mais cedo."

# game/chapters/chapter1/script/ch1sc1.rpy:95
translate brazil ch1sc1_f64ab3e1:

#   mct "It's been twenty minutes since I got the fire going... how long does she need to bathe?"
    mct "Já faz vinte minutos que acendi o fogo... quanto tempo ela precisa para tomar banho?"

# game/chapters/chapter1/script/ch1sc1.rpy:98
translate brazil ch1sc1_49e35d4f:

#   mct "The lake we passed earlier is only about five minutes away..."
    mct "O lago por onde passamos mais cedo fica a apenas cinco minutos daqui..."

# game/chapters/chapter1/script/ch1sc1.rpy:99
translate brazil ch1sc1_01840ad1:

#   mct "Maybe I'll go look for her, I'm famished."
    mct "Talvez eu vá procurá-la, estou faminto."

# game/chapters/chapter1/script/ch1sc1.rpy:104
translate brazil ch1sc1_10d52d97:

#   mc "There you are..."
    mc "Aí está..."

# game/chapters/chapter1/script/ch1sc1.rpy:107
translate brazil ch1sc1_be71bd24:

#   el "Here I am..."
    el "Aqui estou..."

# game/chapters/chapter1/script/ch1sc1.rpy:110
translate brazil ch1sc1_261e074f:

#   "As you arrive at the lake you're met with the sight of Eliza bathing under the moonlight."
    "Ao chegar ao lago, você se depara com a visão de Eliza tomando banho sob o luar."

# game/chapters/chapter1/script/ch1sc1.rpy:111
translate brazil ch1sc1_6b40a8c0:

#   mct "Five hells... she's not even out of the water or getting dressed yet."
    mct "Pelo amor de Deus... ela nem saiu da água ainda, nem se vestiu."

# game/chapters/chapter1/script/ch1sc1.rpy:112
translate brazil ch1sc1_13911999:

#   mc "I'm hungry... I've got the fire going."
    mc "Estou com fome... Já acendi o fogo."

# game/chapters/chapter1/script/ch1sc1.rpy:113
translate brazil ch1sc1_484aa696:

#   el "Nice!"
    el "Legal!"

# game/chapters/chapter1/script/ch1sc1.rpy:114
translate brazil ch1sc1_412d71bb:

#   "Eliza's belly rumbles..."
    "A barriga de Eliza ronca..."

# game/chapters/chapter1/script/ch1sc1.rpy:115
translate brazil ch1sc1_8c04d623:

#   el "You didn't hear that!"
    el "Você não ouviu isso!"

# game/chapters/chapter1/script/ch1sc1.rpy:116
translate brazil ch1sc1_1f09de64:

#   mc "*Chuckles* You're still getting shy about me hearing your stomach growling?"
    mc "*Risos* Você ainda fica com vergonha de eu ouvir seu estômago roncando?"

# game/chapters/chapter1/script/ch1sc1.rpy:117
translate brazil ch1sc1_22054287:

#   mc "It happens several times a day with how little we've been eating."
    mc "Isso acontece várias vezes ao dia, devido à pouca comida que temos ingerido."

# game/chapters/chapter1/script/ch1sc1.rpy:118
translate brazil ch1sc1_a431305c:

#   el "I-I'm a woman!"
    el "Eu sou uma mulher!"

# game/chapters/chapter1/script/ch1sc1.rpy:119
translate brazil ch1sc1_036fe94e:

#   el "A woman's stomach never growls! I've told you this!"
    el "A barriga de uma mulher nunca ronca! Eu já te disse isso!"

# game/chapters/chapter1/script/ch1sc1.rpy:120
translate brazil ch1sc1_3ddadb29:

#   mc "Right... and you never snore either."
    mc "Certo... e você também nunca ronca."

# game/chapters/chapter1/script/ch1sc1.rpy:121
translate brazil ch1sc1_d6fac29b:

#   el "Exactly! *Giggling*"
    el "Exatamente! *Risos*"

# game/chapters/chapter1/script/ch1sc1.rpy:122
translate brazil ch1sc1_3e923c47:

#   el "But you do! Biiiiig time!"
    el "Mas você faz sim! E muito!"

# game/chapters/chapter1/script/ch1sc1.rpy:123
translate brazil ch1sc1_e15b7cc3:

#   mc "I wouldn't know."
    mc "Eu não saberia dizer."

# game/chapters/chapter1/script/ch1sc1.rpy:124
translate brazil ch1sc1_5d445d7b:

#   el "Then you'll have to take my word for it."
    el "Então você terá que acreditar na minha palavra."

# game/chapters/chapter1/script/ch1sc1.rpy:125
translate brazil ch1sc1_38c32d20:

#   mc "And you'll have to take me for my word when I say... hurry up."
    mc "E você terá que acreditar na minha palavra quando eu disser... apresse-se."

# game/chapters/chapter1/script/ch1sc1.rpy:126
translate brazil ch1sc1_073a686e:

#   el "*Giggling* Or what?"
    el "*Risos* Ou o quê?"

# game/chapters/chapter1/script/ch1sc1.rpy:127
translate brazil ch1sc1_c16d7ba9:

#   mc "Or I'll get in the water... grab you... carry your ass back to camp."
    mc "Ou eu entro na água... te agarro... e te levo de volta para o acampamento."

# game/chapters/chapter1/script/ch1sc1.rpy:128
translate brazil ch1sc1_e2e8d40e:

#   el "See... you think you're threatening me, but really you're just making me a promise!"
    el "Veja... você acha que está me ameaçando, mas na verdade está apenas me fazendo uma promessa!"

# game/chapters/chapter1/script/ch1sc1.rpy:129
translate brazil ch1sc1_8e3eafe8:

#   mc "*Exhales* Eliza... I'm starving, you must be as well."
    mc "*Exala* Eliza... Estou morrendo de fome, você também deve estar."

# game/chapters/chapter1/script/ch1sc1.rpy:130
translate brazil ch1sc1_960eb862:

#   el "Mmh... I won't take much longer."
    el "Hum... Não vou demorar muito."

# game/chapters/chapter1/script/ch1sc1.rpy:131
translate brazil ch1sc1_28473a35:

#   el "Did you see all the mushrooms I managed to gather?"
    el "Você viu todos os cogumelos que consegui colher?"

# game/chapters/chapter1/script/ch1sc1.rpy:132
translate brazil ch1sc1_5facf7e1:

#   mc "Yeah, you did well."
    mc "Sim, você se saiu bem."

# game/chapters/chapter1/script/ch1sc1.rpy:133
translate brazil ch1sc1_40d21628:

#   mc "While mushrooms don't exactly make me salivate... it'll be filling enough until we reach Riverside."
    mc "Embora os cogumelos não me façam exatamente salivar... isso será suficiente para me satisfazer até chegarmos a Riverside."

# game/chapters/chapter1/script/ch1sc1.rpy:134
translate brazil ch1sc1_49084d14:

#   el "I think I know something that does make you salivate though..."
    el "Acho que sei de algo que realmente te deixa com água na boca..."

# game/chapters/chapter1/script/ch1sc1.rpy:135
translate brazil ch1sc1_e8a7a78a:

#   el "*Giggling* Mmh!"
    el "*Risos* Hum!"

# game/chapters/chapter1/script/ch1sc1.rpy:136
translate brazil ch1sc1_ebb8407a:

#   mc "How's your leg?"
    mc "Como está sua perna?"

# game/chapters/chapter1/script/ch1sc1.rpy:137
translate brazil ch1sc1_4182d1b0:

#   mc "You took quite the tumble earlier when you were climbing that rock."
    mc "Você levou um tombo feio mais cedo quando estava escalando aquela pedra."

# game/chapters/chapter1/script/ch1sc1.rpy:138
translate brazil ch1sc1_a3cfb437:

#   el "Oh it's fine, really."
    el "Ah, está tudo bem, sério."

# game/chapters/chapter1/script/ch1sc1.rpy:139
translate brazil ch1sc1_12031b16:

#   el "I might get a tiny bruise but I didn't twist anything."
    el "Posso ficar com um pequeno hematoma, mas não torci nada."

# game/chapters/chapter1/script/ch1sc1.rpy:140
translate brazil ch1sc1_7b471f6f:

#   mc "Good."
    mc "Bom."

# game/chapters/chapter1/script/ch1sc1.rpy:141
translate brazil ch1sc1_78e5fba0:

#   el "Awwh! Look at you being all worried about me!"
    el "Ahhh! Olha só você, todo preocupado comigo!"

# game/chapters/chapter1/script/ch1sc1.rpy:142
translate brazil ch1sc1_57392357:

#   mc "You know I do."
    mc "Você sabe que sim."

# game/chapters/chapter1/script/ch1sc1.rpy:143
translate brazil ch1sc1_b744bcb3:

#   el "MMh... I know."
    el "Hum... eu sei."

# game/chapters/chapter1/script/ch1sc1.rpy:144
translate brazil ch1sc1_1115b735:

#   el "It's still quite when you reveal it."
    el "Ainda está tudo muito tranquilo quando você revela."

# game/chapters/chapter1/script/ch1sc1.rpy:145
translate brazil ch1sc1_a89cad40:

#   el "We'll arrive at Riverside tomorrow, correct?"
    el "Chegaremos em Riverside amanhã, certo?"

# game/chapters/chapter1/script/ch1sc1.rpy:146
translate brazil ch1sc1_1ba95157:

#   mc "Tonight."
    mc "Essa noite."

# game/chapters/chapter1/script/ch1sc1.rpy:147
translate brazil ch1sc1_343c4e16:

#   el "*Gasps* Tonight!? But it's already dark?"
    el "*Suspiros* Esta noite!? Mas já está escuro?"

# game/chapters/chapter1/script/ch1sc1.rpy:148
translate brazil ch1sc1_089c1c9d:

#   mc "We're not that far, we'll just have dinner and rest for a bit."
    mc "Não estamos tão longe, vamos jantar e descansar um pouco."

# game/chapters/chapter1/script/ch1sc1.rpy:149
translate brazil ch1sc1_81597b02:

#   el "Okay, go back and throw the mushrooms on those rocks near the fire while I finish up."
    el "Certo, volte e jogue os cogumelos naquelas pedras perto da fogueira enquanto eu termino."

# game/chapters/chapter1/script/ch1sc1.rpy:150
translate brazil ch1sc1_927f1e10:

#   el "That should sear them nicely and gives me a few minutes to dry off and get dressed."
    el "Isso deve selá-los bem e me dá alguns minutos para secar e me vestir."

# game/chapters/chapter1/script/ch1sc1.rpy:151
translate brazil ch1sc1_67a7b5c5:

#   mc "Alright, I'll see you in a few then."
    mc "Certo, então te vejo daqui a pouco."

# game/chapters/chapter1/script/ch1sc1.rpy:157
translate brazil ch1sc1_e38eb608:

#   mct "{i}...{/i}"
    mct "{i}...{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:158
translate brazil ch1sc1_1ac1bfd6:

#   mct "{i}Ten summers...{/i}"
    mct "{i}Dez verões...{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:159
translate brazil ch1sc1_cfadae2e:

#   mct "{i}Ten summers... And ten winters, since I've been back here.{/i}"
    mct "{i}Dez verões... e dez invernos, desde que voltei para cá.{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:160
translate brazil ch1sc1_5c58b69b:

#   elt "{i}*Exhales* Hnnghh... My legs are killing me, we've been on the road for several days.{/i}"
    elt "{i}*Exala* Hnnghh... Minhas pernas estão me matando, estamos na estrada há vários dias.{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:161
translate brazil ch1sc1_98582a02:

#   elt "{i}Sleeping on the ground and foraging for mushrooms and berries... not exactly pleasant.{/i}"
    elt "{i}Dormir no chão e procurar cogumelos e frutos silvestres... não é exatamente agradável.{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:162
translate brazil ch1sc1_d6ff3412:

#   elt "{i}I wonder why we stopped, does he want to setup camp for the night?{/i}"
    elt "{i}Fico me perguntando por que paramos, será que ele quer acampar esta noite?{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:163
translate brazil ch1sc1_ba257cb4:

#   elt "{i}No, that can't be it, he said earlier we were relatively close.{/i}"
    elt "{i}Não, não pode ser isso, ele disse antes que estávamos relativamente perto.{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:166
translate brazil ch1sc1_5c733a5f:

#   mc "Eliza, we're here."
    mc "Eliza, estamos aqui."

# game/chapters/chapter1/script/ch1sc1.rpy:168
translate brazil ch1sc1_4d5bad23:

#   el "Here? Already?"
    el "Aqui? Já?"

# game/chapters/chapter1/script/ch1sc1.rpy:169
translate brazil ch1sc1_6cb8bc10:

#   el "So this is Riversi-"
    el "Então, este é Riversi-"

# game/chapters/chapter1/script/ch1sc1.rpy:171
translate brazil ch1sc1_c3ce03ab:

#   mc "Home..."
    mc "Lar..."

# game/chapters/chapter1/script/ch1sc1.rpy:172
translate brazil ch1sc1_a34f51fa:

#   mc "It used to be my home. A long time ago..."
    mc "Costumava ser minha casa. Há muito tempo atrás..."

# game/chapters/chapter1/script/ch1sc1.rpy:174
translate brazil ch1sc1_463c448f:

#   el "How does it feel to see it again?"
    el "Qual a sensação de vê-lo novamente?"

# game/chapters/chapter1/script/ch1sc1.rpy:175
translate brazil ch1sc1_a8bbea4c:

#   el "Does it bring back a lot of memories?"
    el "Isso traz à tona muitas lembranças?"

# game/chapters/chapter1/script/ch1sc1.rpy:177
translate brazil ch1sc1_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter1/script/ch1sc1.rpy:178
translate brazil ch1sc1_1c21cb77:

#   "You remain silent, contemplating what to say."
    "Você permanece em silêncio, ponderando o que dizer."

# game/chapters/chapter1/script/ch1sc1.rpy:179
translate brazil ch1sc1_9ea802c3:

#   "You feel something touching your hand."
    "Você sente algo tocando sua mão."

# game/chapters/chapter1/script/ch1sc1.rpy:181
translate brazil ch1sc1_60a593b0:

#   "Eliza gently places her hand in yours, squeezing softly."
    "Eliza coloca delicadamente a mão na sua, apertando-a suavemente."

# game/chapters/chapter1/script/ch1sc1.rpy:182
translate brazil ch1sc1_a3cf9502:

#   "Her small fingers seem to fit perfectly between yours."
    "Os dedinhos dela parecem encaixar perfeitamente entre os seus."

# game/chapters/chapter1/script/ch1sc1.rpy:184
translate brazil ch1sc1_6bae1282:

#   el "I'm not going anywhere... take your time."
    el "Não vou a lugar nenhum... fique à vontade."

# game/chapters/chapter1/script/ch1sc1.rpy:185
translate brazil ch1sc1_f08eda60:

#   mc "It... it feels different. I don't belong here anymore."
    mc "É... é diferente. Eu não pertenço mais a este lugar."

# game/chapters/chapter1/script/ch1sc1.rpy:186
translate brazil ch1sc1_e732527a:

#   mc "The place itself... it looks the same as it did back then."
    mc "O lugar em si... parece o mesmo de antigamente."

# game/chapters/chapter1/script/ch1sc1.rpy:187
translate brazil ch1sc1_99c9d51a:

#   mc "But I've changed... So much has changed."
    mc "Mas eu mudei... Muita coisa mudou."

# game/chapters/chapter1/script/ch1sc1.rpy:188
translate brazil ch1sc1_4623c815:

#   elt "{i}I wish I could do something more to comfort him.{/i}"
    elt "{i}Gostaria de poder fazer algo mais para confortá-lo.{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:190
translate brazil ch1sc1_cd25eb75:

#   mct "{i}I'm not the little boy who used to live here anymore...{/i}"
    mct "{i}Eu não sou mais o garotinho que morava aqui...{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:191
translate brazil ch1sc1_0be62a24:

#   mct "{i}I was so naive back then. Adventure this... treasure that...{/i}"
    mct "{i}Eu era tão ingênua naquela época. Aventura isso... tesouro aquilo...{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:193
translate brazil ch1sc1_e4e5c148:

#   el "[mc]... What happened back then?"
    el "[mc]... O que aconteceu naquela época?"

# game/chapters/chapter1/script/ch1sc1.rpy:195
translate brazil ch1sc1_209cbab8:

#   el "I can see the pain all over your face, you hide it well..."
    el "Consigo ver a dor estampada em seu rosto, você a esconde muito bem..."

# game/chapters/chapter1/script/ch1sc1.rpy:196
translate brazil ch1sc1_09288d4e:

#   el "But, you don't need to hide it from me."
    el "Mas você não precisa esconder isso de mim."

# game/chapters/chapter1/script/ch1sc1.rpy:197
translate brazil ch1sc1_fb17a1ba:

#   el "Not after what we've been through."
    el "Não depois de tudo o que passamos."

# game/chapters/chapter1/script/ch1sc1.rpy:199
translate brazil ch1sc1_0a28ee29:

#   mc "Eliza..."
    mc "Eliza..."

# game/chapters/chapter1/script/ch1sc1.rpy:200
translate brazil ch1sc1_c6680e26:

#   el "[mc]... I'm here with you. No going back, remember?"
    el "[mc]...Estou aqui com você. Não tem volta, lembra?"

# game/chapters/chapter1/script/ch1sc1.rpy:201
translate brazil ch1sc1_692a8d00:

#   el "We've got each other's backs."
    el "Nós nos apoiamos mutuamente."

# game/chapters/chapter1/script/ch1sc1.rpy:207
translate brazil ch1sc1_8777af2b:

#   mc "*Sighs* I've come to understand how stubborn you can be..."
    mc "*Suspiro* Agora entendo o quão teimoso você pode ser..."

# game/chapters/chapter1/script/ch1sc1.rpy:208
translate brazil ch1sc1_2cfab49f:

#   el "*Giggles softly* You should be used to it by now!"
    el "*Risinhos suaves* Você já deveria estar acostumado!"

# game/chapters/chapter1/script/ch1sc1.rpy:209
translate brazil ch1sc1_1c0eee6c:

#   mc "So where should I even begin?"
    mc "Por onde devo começar?"

# game/chapters/chapter1/script/ch1sc1.rpy:211
translate brazil ch1sc1_b1c4dfa5:

#   elt "{i}It seems he's finally comfortable enough with me to share his past.{/i}"
    elt "{i}Parece que ele finalmente se sente confortável o suficiente comigo para compartilhar seu passado.{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:212
translate brazil ch1sc1_8f7f40f6:

#   elt "{i}This is a big step for him... It means the world to me that he's willing to let me in.{/i}"
    elt "{i}Isso é um grande passo para ele... Significa muito para mim que ele esteja disposto a me deixar entrar.{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:214
translate brazil ch1sc1_b29e2ac6:

#   el "It's okay... Take your time."
    el "Não tem problema... Leve o tempo que precisar."

# game/chapters/chapter1/script/ch1sc1.rpy:215
translate brazil ch1sc1_18ea0c9b:

#   el "Start from the beginning. *Softly squeezes your hand* And pause if you need to."
    el "Comece do início. *Aperta sua mão suavemente* E faça uma pausa se precisar."

# game/chapters/chapter1/script/ch1sc1.rpy:216
translate brazil ch1sc1_8e3e2d8d:

#   "Eliza appreciates you sharing this with her."
    "Eliza agradece por você ter compartilhado isso com ela."

# game/chapters/chapter1/script/ch1sc1.rpy:217
translate brazil ch1sc1_45a67e1a:

#   "Eliza's trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "A confiança de Eliza aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter1/script/ch1sc1.rpy:218
translate brazil ch1sc1_a2dbfc3f:

#   mc "It all began the day of my tenth summer..."
    mc "Tudo começou no dia do meu décimo verão..."

# game/chapters/chapter1/script/ch1sc1.rpy:224
translate brazil ch1sc1_653ce075:

#   mc "Leave it alone Eliza... I don't want to talk about it."
    mc "Deixa isso pra lá, Eliza... Não quero falar sobre isso."

# game/chapters/chapter1/script/ch1sc1.rpy:226
translate brazil ch1sc1_f1d30349:

#   elt "{i}Why won't he open up to me?{/i}"
    elt "{i}Por que ele não se abre comigo?{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:227
translate brazil ch1sc1_c9495297:

#   elt "{i}We've been through a lot together in a short amount of time. *Sighs* I'll have to be patient.{/i}"
    elt "{i}Passamos por muita coisa juntos em tão pouco tempo. *Suspiro* Terei que ser paciente.{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:228
translate brazil ch1sc1_3804b3c0:

#   elt "{i}I wouldn't like to be pushed on a sensitive subject either... When he's ready, I'll be here.{/i}"
    elt "{i}Eu também não gostaria de ser pressionada sobre um assunto delicado... Quando ele estiver pronto, estarei aqui.{/i}"

# game/chapters/chapter1/script/ch1sc1.rpy:230
translate brazil ch1sc1_c778f6d8:

#   el "I'm sorry, okay? I won't press the matter further..."
    el "Sinto muito, está bem? Não vou insistir mais no assunto..."

# game/chapters/chapter1/script/ch1sc1.rpy:231
translate brazil ch1sc1_ba6b8814:

#   el "Just know I'm here for you, [mc]."
    el "Saiba que estou aqui para você, [mc]."

# game/chapters/chapter1/script/ch1sc1.rpy:233
translate brazil ch1sc1_980128a2:

#   mc "... You don't have to feel sorry, I'm just not ready to talk about it."
    mc "... Você não precisa se sentir mal, eu só não estou pronto para falar sobre isso."

# game/chapters/chapter1/script/ch1sc1.rpy:235
translate brazil ch1sc1_9c1948ea:

#   mc "Let's go. It's been close to a week since we had a proper meal."
    mc "Vamos lá. Já faz quase uma semana que não fazemos uma refeição decente."

# game/chapters/chapter1/script/ch1sc1.rpy:237
translate brazil ch1sc1_5c44fc54:

#   el "Or a proper bed! As much as I love the starry nights-"
    el "Ou uma cama de verdade! Por mais que eu ame as noites estreladas..."

# game/chapters/chapter1/script/ch1sc1.rpy:238
translate brazil ch1sc1_06c2e242:

#   el "I'm afraid my back won't endure another night on the cold ground."
    el "Tenho medo que minhas costas não aguentem mais uma noite no chão frio."

# game/chapters/chapter1/script/ch1sc1.rpy:240
translate brazil ch1sc1_33c3bb5c:

#   mct "{i}All these memories... That day ten summers ago changed everything...{/i}"
    mct "{i}Todas essas lembranças... Aquele dia, dez verões atrás, mudou tudo...{/i}"

