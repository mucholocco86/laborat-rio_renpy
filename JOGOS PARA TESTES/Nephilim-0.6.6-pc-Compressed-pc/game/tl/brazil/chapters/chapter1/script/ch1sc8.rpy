# ARQUIVO: game/chapters/chapter1/script/ch1sc8.rpy DIALOGOS: 81


# game/chapters/chapter1/script/ch1sc8.rpy:11
translate brazil ch1sc8_b46d8dae:

#   mct "I wonder what Mama has made for dinner? I have a feeling it will be delicious!"
    mct "Fico imaginando o que a mamãe preparou para o jantar! Tenho a impressão de que estará uma delícia!"

# game/chapters/chapter1/script/ch1sc8.rpy:13
translate brazil ch1sc8_01050c12:

#   mct "I just hope they won’t be too mad. It’s not like we decided to fall asleep."
    mct "Só espero que eles não fiquem muito zangados. Não é como se tivéssemos decidido dormir."

# game/chapters/chapter1/script/ch1sc8.rpy:15
translate brazil ch1sc8_70633ad7:

#   mct "Huh? The house is dark!"
    mct "Hã? A casa está escura!"

# game/chapters/chapter1/script/ch1sc8.rpy:17
translate brazil ch1sc8_41f4d519:

#   mct "Surely they haven’t gone to bed already? Not when I haven't come home yet."
    mct "Será que eles já foram dormir mesmo? Não quando eu ainda nem cheguei em casa."

# game/chapters/chapter1/script/ch1sc8.rpy:19
translate brazil ch1sc8_b7f67693:

#   mct "Maybe they are hiding, trying to surprise me?"
    mct "Talvez estejam se escondendo, tentando me surpreender?"

# game/chapters/chapter1/script/ch1sc8.rpy:21
translate brazil ch1sc8_43b09f36:

#   mct "I hope Alice didn’t get in too much trouble with her mom."
    mct "Espero que Alice não tenha se metido em muitas encrencas com a mãe dela."

# game/chapters/chapter1/script/ch1sc8.rpy:22
translate brazil ch1sc8_7904b33b:

#   mct "It’s just the two of them, ever since her dad died. Her mom has been overprotective of Alice ever since."
    mct "Desde que o pai dela morreu, são só as duas. Desde então, a mãe tem sido superprotetora com Alice."

# game/chapters/chapter1/script/ch1sc8.rpy:24
translate brazil ch1sc8_095bcd8c:

#   mct "Guess I'll find out when I see her tomorrow. I better get inside."
    mct "Acho que vou descobrir quando a vir amanhã. É melhor eu entrar."

# game/chapters/chapter1/script/ch1sc8.rpy:27
translate brazil ch1sc8_d0e40f48:

#   "You push open the door, but you are met with nothing but a dark room."
    "Você empurra a porta, mas se depara apenas com um quarto escuro."

# game/chapters/chapter1/script/ch1sc8.rpy:29
translate brazil ch1sc8_88390bd6:

#   mc "Mama? Papa?"
    mc "Mãe? Pai?"

# game/chapters/chapter1/script/ch1sc8.rpy:31
translate brazil ch1sc8_2aa49236:

#   mct "Hmm... they don’t seem to be home."
    mct "Hum... parece que eles não estão em casa."

# game/chapters/chapter1/script/ch1sc8.rpy:33
translate brazil ch1sc8_29ec90b3:

#   mct "Could they have gone to visit Gibson? Or the tavern maybe?"
    mct "Será que eles foram visitar Gibson? Ou talvez a taverna?"

# game/chapters/chapter1/script/ch1sc8.rpy:34
translate brazil ch1sc8_9932a174:

#   mct "No way. They talked about having a birthday dinner for me."
    mct "De jeito nenhum. Eles falaram em fazer um jantar de aniversário para mim."

# game/chapters/chapter1/script/ch1sc8.rpy:36
translate brazil ch1sc8_ea17276d:

#   "You try yelling a little louder."
    "Tente gritar um pouco mais alto."

# game/chapters/chapter1/script/ch1sc8.rpy:37
translate brazil ch1sc8_0ec2a69f:

#   mc "Mama! Papa! Are you here?"
    mc "Mamãe! Papai! Vocês estão aí?"

# game/chapters/chapter1/script/ch1sc8.rpy:39
translate brazil ch1sc8_9e04ccf4:

#   mct "Why aren’t they answering? I've never had this feeling before. It's like a cold pit in my tummy."
    mct "Por que eles não respondem? Nunca senti isso antes. É como um frio na barriga."

# game/chapters/chapter1/script/ch1sc8.rpy:40
translate brazil ch1sc8_9381d51b:

#   mct "Huh? That barrel of scrolls is tipped over!"
    mct "Hein? Aquele barril de pergaminhos tombou!"

# game/chapters/chapter1/script/ch1sc8.rpy:42
translate brazil ch1sc8_3955a28f:

#   "Your eyes scout the room."
    "Seus olhos percorrem a sala."

# game/chapters/chapter1/script/ch1sc8.rpy:43
translate brazil ch1sc8_a687e796:

#   mct "What the... ?!"
    mct "O quê?!"

# game/chapters/chapter1/script/ch1sc8.rpy:45
translate brazil ch1sc8_58c69f36:

#   mc "*Louder* Mama?! Papa?!"
    mc "*Mais alto* Mãe?! Pai?!"

# game/chapters/chapter1/script/ch1sc8.rpy:47
translate brazil ch1sc8_bcb7c876:

#   mct "Where are they?"
    mct "Onde eles estão?"

# game/chapters/chapter1/script/ch1sc8.rpy:49
translate brazil ch1sc8_b4d78f97:

#   mc "This isn’t funny!"
    mc "Isso não tem graça!"

# game/chapters/chapter1/script/ch1sc8.rpy:50
translate brazil ch1sc8_59c44ea2:

#   mc "Where are you? Mama!! Papa!!"
    mc "Onde vocês estão? Mamãe!! Papai!!"

# game/chapters/chapter1/script/ch1sc8.rpy:53
translate brazil ch1sc8_727eca39:

#   mct "What in the blazes is going on?"
    mct "Que diabos está acontecendo?"

# game/chapters/chapter1/script/ch1sc8.rpy:54
translate brazil ch1sc8_b87c431f:

#   mct "I swear... if they've gone to the tavern..."
    mct "Juro... se eles foram à taverna..."

# game/chapters/chapter1/script/ch1sc8.rpy:57
translate brazil ch1sc8_d09a72ea:

#   "As you get closer to the bedroom, you begin to feel chills down your back.."
    "Ao se aproximar do quarto, você começa a sentir arrepios na espinha."

# game/chapters/chapter1/script/ch1sc8.rpy:60
translate brazil ch1sc8_12be06bc:

#   mc "Maa..."
    mc "Sempre..."

# game/chapters/chapter1/script/ch1sc8.rpy:61
translate brazil ch1sc8_b93d5507:

#   "You don't manage to finish your call before you freeze up."
    "Você não consegue terminar a chamada antes de travar."

# game/chapters/chapter1/script/ch1sc8.rpy:63
translate brazil ch1sc8_fc194b57:

#   mct "W... w... what?!"
    mct "O... o... o quê?!"

# game/chapters/chapter1/script/ch1sc8.rpy:64
translate brazil ch1sc8_f8a43422:

#   "You try to move your legs but they won't listen."
    "Você tenta mexer as pernas, mas elas não obedecem."

# game/chapters/chapter1/script/ch1sc8.rpy:84
translate brazil ch1sc8_bc5764f4:

#   "With all your strength you push forward."
    "Você avança com toda a sua força."

# game/chapters/chapter1/script/ch1sc8.rpy:85
translate brazil ch1sc8_909a3a53:

#   mc "Mama? Papa? ... Mama!! Papa!!"
    mc "Mãe? Pai? ... Mãe!! Pai!!"

# game/chapters/chapter1/script/ch1sc8.rpy:87
translate brazil ch1sc8_fac6d3f8:

#   "You rush over to your parents. As fast as your trembling legs can carry you."
    "Você corre até seus pais. O mais rápido que suas pernas trêmulas permitem."

# game/chapters/chapter1/script/ch1sc8.rpy:91
translate brazil ch1sc8_2b800f9f:

#   mc "Come on Mama, wake up! It's not funny anymore! Wake up... wake up!"
    mc "Vamos, mamãe, acorde! Isso não tem mais graça! Acorde... acorde!"

# game/chapters/chapter1/script/ch1sc8.rpy:93
translate brazil ch1sc8_eb9e1bb8:

#   "You touch her cheeks... they're cold."
    "Você toca nas bochechas dela... estão frias."

# game/chapters/chapter1/script/ch1sc8.rpy:96
translate brazil ch1sc8_60c60a4e:

#   mc "Mama!!!"
    mc "Mamãe!!!"

# game/chapters/chapter1/script/ch1sc8.rpy:98
translate brazil ch1sc8_067f3055:

#   mct "Why is her skin so cold? ... M... Mama?"
    mct "Por que a pele dela está tão fria? ... M... Mamãe?"

# game/chapters/chapter1/script/ch1sc8.rpy:100
translate brazil ch1sc8_da916d6a:

#   mct "No... Mama? ... No no no no... no!"
    mct "Não... Mãe? ... Não, não, não, não... não!"

# game/chapters/chapter1/script/ch1sc8.rpy:101
translate brazil ch1sc8_c5eb44c1:

#   mct "H... how? ... Wh... Who? Why?!"
    mct "H... como? ... Q... Quem? Por quê?!"

# game/chapters/chapter1/script/ch1sc8.rpy:103
translate brazil ch1sc8_008fa618:

#   "You can barely think... let alone speak."
    "Você mal consegue pensar... quanto mais falar."

# game/chapters/chapter1/script/ch1sc8.rpy:105
translate brazil ch1sc8_fd00af1a:

#   "Your body is trembling. Both your parents lie dead before you."
    "Seu corpo está tremendo. Seus dois pais jazem mortos diante de você."

# game/chapters/chapter1/script/ch1sc8.rpy:106
translate brazil ch1sc8_e6420692:

#   "Their bodies covered in... wounds... blood... bruises."
    "Seus corpos estavam cobertos de... feridas... sangue... hematomas."

# game/chapters/chapter1/script/ch1sc8.rpy:110
translate brazil ch1sc8_6feaf5dc:

#   mct "*Sobs* M... Mama. Papa. Don’t leave me!"
    mct "*Soluços* M... Mamãe. Papai. Não me deixem!"

# game/chapters/chapter1/script/ch1sc8.rpy:124
translate brazil ch1sc8_7c868c21:

#   mct "Huh.. what’s going on?.."
    mct "Hum... o que está acontecendo?..."

# game/chapters/chapter1/script/ch1sc8.rpy:125
translate brazil ch1sc8_554c4f48:

#   mct "Huh? What’s going on?"
    mct "Hã? O que está acontecendo?"

# game/chapters/chapter1/script/ch1sc8.rpy:126
translate brazil ch1sc8_6f94ab65:

#   "You feel a warm energy flowing around you."
    "Você sente uma energia quente fluindo ao seu redor."

# game/chapters/chapter1/script/ch1sc8.rpy:128
translate brazil ch1sc8_06b6e09e:

#   "Suddenly your body begins absorbing the energy."
    "De repente, seu corpo começa a absorver a energia."

# game/chapters/chapter1/script/ch1sc8.rpy:129
translate brazil ch1sc8_9817faa9:

#   mc "*Painful* Arrrh!"
    mc "*Doloroso* Arrrh!"

# game/chapters/chapter1/script/ch1sc8.rpy:131
translate brazil ch1sc8_c0ceb54c:

#   mct "What's happening? Hrrraah!"
    mct "O que está acontecendo? Hrrraah!"

# game/chapters/chapter1/script/ch1sc8.rpy:133
translate brazil ch1sc8_d99e53c4:

#   "As the energy merges with your body, you feel sharp bursts of pain, which cause you to scream in agony."
    "À medida que a energia se funde com o seu corpo, você sente fortes pontadas de dor, que o fazem gritar de agonia."

# game/chapters/chapter1/script/ch1sc8.rpy:134
translate brazil ch1sc8_c9541125:

#   "The pain vanishes as it becomes one with your essence."
    "A dor desaparece ao se tornar uma só com a sua essência."

# game/chapters/chapter1/script/ch1sc8.rpy:136
translate brazil ch1sc8_d7030394:

#   "The energy finally settles within you."
    "A energia finalmente se instala dentro de você."

# game/chapters/chapter1/script/ch1sc8.rpy:137
translate brazil ch1sc8_a6fc038c:

#   "Realising where you are and what has happened, you feel defeated."
    "Ao perceber onde você está e o que aconteceu, você se sente derrotado."

# game/chapters/chapter1/script/ch1sc8.rpy:138
translate brazil ch1sc8_e962c93b:

#   mct "Mama... Papa..."
    mct "Mãe... Pai..."

# game/chapters/chapter1/script/ch1sc8.rpy:140
translate brazil ch1sc8_b27b0ebf:

#   mct "I... I will find who did this..."
    mct "Eu... eu vou descobrir quem fez isso..."

# game/chapters/chapter1/script/ch1sc8.rpy:142
translate brazil ch1sc8_1e48718e:

#   mct "I will make them suffer!"
    mct "Eu os farei sofrer!"

# game/chapters/chapter1/script/ch1sc8.rpy:145
translate brazil ch1sc8_e3bced57:

#   "The energy suddenly burns hot within you again. You feel it flowing through every cell in your body."
    "De repente, a energia arde intensamente dentro de você novamente. Você a sente fluindo por cada célula do seu corpo."

# game/chapters/chapter1/script/ch1sc8.rpy:147
translate brazil ch1sc8_eda06dd6:

#   "Then it calms once more. It seems that your body is still adjusting."
    "Depois, a sensação se acalma novamente. Parece que seu corpo ainda está se adaptando."

# game/chapters/chapter1/script/ch1sc8.rpy:149
translate brazil ch1sc8_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter1/script/ch1sc8.rpy:157
translate brazil ch1sc8_2f0768ce:

#   mct "Mama.."
    mct "Mamãe..."

# game/chapters/chapter1/script/ch1sc8.rpy:163
translate brazil ch1sc8_6cb9b0f0:

#   uk "Kid.."
    uk "Criança.."

# game/chapters/chapter1/script/ch1sc8.rpy:165
translate brazil ch1sc8_610b9d0e:

#   mct "Huh?"
    mct "Huh?"

# game/chapters/chapter1/script/ch1sc8.rpy:167
translate brazil ch1sc8_ddb9c81e:

#   mc "W... Who are you?"
    mc "Q... Quem é você?"

# game/chapters/chapter1/script/ch1sc8.rpy:168
translate brazil ch1sc8_8f9ccabe:

#   oe "Later... I know what happened here. Come with me."
    oe "Mais tarde... Eu sei o que aconteceu aqui. Venha comigo."

# game/chapters/chapter1/script/ch1sc8.rpy:170
translate brazil ch1sc8_29236f54:

#   mct "He knows? W... was he involved?!"
    mct "Ele sabe? Ele... ele estava envolvido?!"

# game/chapters/chapter1/script/ch1sc8.rpy:172
translate brazil ch1sc8_0814e750:

#   mc "I’m not going anywhere until you tell me what’s going on!"
    mc "Não vou a lugar nenhum até você me dizer o que está acontecendo!"

# game/chapters/chapter1/script/ch1sc8.rpy:174
translate brazil ch1sc8_7da52bdf:

#   oe "We don’t have time. He’s still looking for you... now come!"
    oe "Não temos tempo. Ele ainda está te procurando... venha agora!"

# game/chapters/chapter1/script/ch1sc8.rpy:176
translate brazil ch1sc8_9455ec30:

#   mc "What do you mean looking for me?!"
    mc "Como assim você está me procurando?!"

# game/chapters/chapter1/script/ch1sc8.rpy:177
translate brazil ch1sc8_7aed9f1a:

#   mc "Are Ma... Mama and Papa dead because of me?!"
    mc "Será que mamãe e papai morreram por minha causa?!"

# game/chapters/chapter1/script/ch1sc8.rpy:179
translate brazil ch1sc8_a5ff1c47:

#   "You sit there for a few seconds. Your thoughts are all over the place... Why? Who?"
    "Você fica sentado ali por alguns segundos. Seus pensamentos estão uma bagunça... Por quê? Quem?"

# game/chapters/chapter1/script/ch1sc8.rpy:180
translate brazil ch1sc8_51c257db:

#   oe "I will explain everything once we get you out of here. Now let's go!"
    oe "Explicarei tudo assim que você sair daqui. Agora vamos!"

# game/chapters/chapter1/script/ch1sc8.rpy:182
translate brazil ch1sc8_e8c656e7:

#   oe "Kid... if you want to avenge them, then come with me right now."
    oe "Garoto... se você quer vingá-los, então venha comigo agora mesmo."

# game/chapters/chapter1/script/ch1sc8.rpy:184
translate brazil ch1sc8_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter1/script/ch1sc8.rpy:186
translate brazil ch1sc8_11f6ff49:

#   "You feel emotions you’ve never experienced before. A burning hatred for whoever did this to your parents..."
    "Você sente emoções que nunca experimentou antes. Um ódio ardente por quem fez isso com seus pais..."

# game/chapters/chapter1/script/ch1sc8.rpy:187
translate brazil ch1sc8_cde4c390:

#   "You no longer feel scared. Instead a desire for justice... for payback... vengeance grows within you."
    "Você não sente mais medo. Em vez disso, um desejo de justiça... de retribuição... de vingança cresce dentro de você."

# game/chapters/chapter1/script/ch1sc8.rpy:189
translate brazil ch1sc8_4210f5cb:

#   mct "Revenge."
    mct "Vingança."

# game/chapters/chapter1/script/ch1sc8.rpy:190
translate brazil ch1sc8_46f36772:

#   mct "Whoever did this will pay... with blood."
    mct "Quem fez isso vai pagar... com sangue."

# game/chapters/chapter1/script/ch1sc8.rpy:192
translate brazil ch1sc8_2574a51a:

#   "With those final thoughts, you stand up. One goal in mind."
    "Com esses pensamentos finais, você se levanta. Um objetivo em mente."

# game/chapters/chapter1/script/ch1sc8.rpy:193
translate brazil ch1sc8_985260bf:

#   "Find out who murdered Mama and Papa... and make them regret it."
    "Descubra quem assassinou a mamãe e o papai... e faça com que se arrependam."

# game/chapters/chapter1/script/ch1sc8.rpy:159
translate brazil ch1sc8_a20cefa7_1:

#   "..."
    "..."

# game/chapters/chapter1/script/ch1sc8.rpy:161
translate brazil ch1sc8_a20cefa7_2:

#   "..."
    "..."

