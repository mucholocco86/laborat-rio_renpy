translate brazil ch1sc4_c560f11e:

#   mc "Woah, Alice. Is this really for me?"
    mc "Uau, Alice. Isso é mesmo para mim?"

# game/chapters/chapter1/script/ch1sc4.rpy:344
translate brazil ch1sc4_cf243b85:

#   al "Silly! Do you see any other birthday boys around here?"
    al "Que bobagem! Você vê mais algum aniversariante por aqui?"

# game/chapters/chapter1/script/ch1sc4.rpy:346
translate brazil ch1sc4_041d3cd8:

#   mct "This is so cool. Alice is incredible!"
    mct "Que legal! A Alice é incrível!"

# game/chapters/chapter1/script/ch1sc4.rpy:348
translate brazil ch1sc4_586c2800:

#   mc "Thank you, Alice. I like it!"
    mc "Obrigada, Alice. Gostei!"

# game/chapters/chapter1/script/ch1sc4.rpy:350
translate brazil ch1sc4_f80a54e1:

#   al "R... Really?"
    al "R... Sério?"

# game/chapters/chapter1/script/ch1sc4.rpy:352
translate brazil ch1sc4_e4dc4868:

#   mc "Yes!! It's by far the best thing you could have gotten me!"
    mc "Sim!! É de longe a melhor coisa que você poderia ter me dado!"

# game/chapters/chapter1/script/ch1sc4.rpy:354
translate brazil ch1sc4_d3103fef:

#   "You don’t hesitate to embrace her, hugging her as tightly as you can."
    "Você não hesita em abraçá-la, apertando-a com toda a força que consegue."

# game/chapters/chapter1/script/ch1sc4.rpy:355
translate brazil ch1sc4_2db804f8:

#   mct "I can’t believe she gave me something this awesome! She always cares so much."
    mct "Não acredito que ela me deu algo tão incrível! Ela sempre se preocupa tanto."

# game/chapters/chapter1/script/ch1sc4.rpy:357
translate brazil ch1sc4_053b6911:

#   al_t "Woah, I didn’t expect him to like it this much.."
    al_t "Uau, não esperava que ele gostasse tanto assim..."

# game/chapters/chapter1/script/ch1sc4.rpy:358
translate brazil ch1sc4_834c5583:

#   al_t "I’m so happy, I could burst into a... a rainbow!"
    al_t "Estou tão feliz que poderia explodir num... arco-íris!"

# game/chapters/chapter1/script/ch1sc4.rpy:360
translate brazil ch1sc4_728f88d5:

#   mc "Thank you, Alice. You know me so well."
    mc "Obrigada, Alice. Você me conhece tão bem."

# game/chapters/chapter1/script/ch1sc4.rpy:361
translate brazil ch1sc4_2e46c8ad:

#   al_t "I love it when he pats my hair like this."
    al_t "Adoro quando ele acaricia meu cabelo assim."

# game/chapters/chapter1/script/ch1sc4.rpy:363
translate brazil ch1sc4_4cce7767:

#   al "I'm so happy you like it, [mc]!"
    al "Fico muito feliz que você tenha gostado! [mc]!"

# game/chapters/chapter1/script/ch1sc4.rpy:365
translate brazil ch1sc4_da0b05c7:

#   mc "What even is this thing? Do you think it's some sort of relic from the first era?"
    mc "O que é isso, afinal? Você acha que é algum tipo de relíquia da primeira era?"

# game/chapters/chapter1/script/ch1sc4.rpy:367
translate brazil ch1sc4_ab077092:

#   al "Not sure if it’s true, but I heard an old man at the market say it’s a key of sorts; to unlock an ancient ruin!"
    al "Não sei se é verdade, mas ouvi um senhor no mercado dizer que é uma espécie de chave para abrir uma ruína antiga!"

# game/chapters/chapter1/script/ch1sc4.rpy:368
translate brazil ch1sc4_436a04c2:

#   al "It’s probably worthless... but at least it symbolizes our dream to discover the secrets of Midomir."
    al "Provavelmente não vale nada... mas pelo menos simboliza nosso sonho de descobrir os segredos de Midomir."

# game/chapters/chapter1/script/ch1sc4.rpy:370
translate brazil ch1sc4_71b72d71:

#   mc "I'll always keep it safe, Alice! Whenever I look at it, I'll always remember our goal."
    mc "Sempre guardarei em segurança, Alice! Sempre que eu olhar para isso, lembrarei do nosso objetivo."

# game/chapters/chapter1/script/ch1sc4.rpy:372
translate brazil ch1sc4_d19a824e:

#   al_t "He’s so sweet, I'm lucky that he’s my best friend."
    al_t "Ele é tão querido, tenho sorte de ele ser meu melhor amigo."

# game/chapters/chapter1/script/ch1sc4.rpy:374
translate brazil ch1sc4_38ebefc1:

#   mct "She’s always thinking about me before herself. I'll be there for her whenever she needs me."
    mct "Ela sempre pensa em mim antes de pensar em si mesma. Estarei lá para ela sempre que ela precisar de mim."

# game/chapters/chapter1/script/ch1sc4.rpy:375
translate brazil ch1sc4_2915bbe2:

#   "You notice something flying around you, it's colourful and nimble."
    "Você percebe algo voando ao seu redor, é colorido e ágil."

# game/chapters/chapter1/script/ch1sc4.rpy:377
translate brazil ch1sc4_a9a8f778:

#   mc "Alice, look over there!"
    mc "Alice, olha ali!"

# game/chapters/chapter1/script/ch1sc4.rpy:379
translate brazil ch1sc4_990c8f34:

#   "You point to the bright animal flying past you."
    "Você aponta para o animal brilhante que passa voando por você."

# game/chapters/chapter1/script/ch1sc4.rpy:381
translate brazil ch1sc4_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter1/script/ch1sc4.rpy:385
translate brazil ch1sc4_d9a770b6:

#   al "Oh my! Come on [mc], let's go check it out!"
    al "Nossa! Vamos lá! [mc] Vamos lá conferir!"

# game/chapters/chapter1/script/ch1sc4.rpy:387
translate brazil ch1sc4_4ba5233f:

#   mc "Right behind you, Alice!"
    mc "Logo atrás de você, Alice!"

# game/chapters/chapter1/script/ch1sc4.rpy:389
translate brazil ch1sc4_12e434a6:

#   "You chase after the flying critter for a good hour..."
    "Você persegue a criatura voadora por uma boa hora..."

# game/chapters/chapter1/script/ch1sc4.rpy:391
translate brazil ch1sc4_76000704:

#   mc "Hraah... Alice... W-Wait up!"
    mc "Hraah... Alice... E-Espere!"

# game/chapters/chapter1/script/ch1sc4.rpy:392
translate brazil ch1sc4_cc7c607d:

#   al "Quick, [mc]! It's going to get away."
    al "Rápido, [mc] Vai escapar!"

# game/chapters/chapter1/script/ch1sc4.rpy:394
translate brazil ch1sc4_6bb95122:

#   mc "*Heavy breathing* Paah... did... did it get away?"
    mc "*Respiração pesada* Paah... será que... será que escapou?"

# game/chapters/chapter1/script/ch1sc4.rpy:396
translate brazil ch1sc4_37c35d00:

#   al "No, look! It’s over there. We have to be quiet..."
    al "Não, olhe! Está ali. Temos que fazer silêncio..."

# game/chapters/chapter1/script/ch1sc4.rpy:398
translate brazil ch1sc4_6271893d:

#   "You both crawl behind some nearby bushes."
    "Vocês dois rastejam para trás de uns arbustos próximos."

# game/chapters/chapter1/script/ch1sc4.rpy:400
translate brazil ch1sc4_8b4ea874:

#   mc "*Whispers* {size=-10}{b}Woah that's pretty cool, huh Alice?{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Uau, isso é muito legal, né, Alice?{/b}{/size}"

# game/chapters/chapter1/script/ch1sc4.rpy:401
translate brazil ch1sc4_4a50cb62:

#   al "*Whispers* {size=-10}{b}I’ve never seen anything like it before! Are they usually this big?{/b}{/size}"
    al "*Sussurros* {size=-10}{b}Nunca vi nada parecido! Eles costumam ser tão grandes assim?{/b}{/size}"

# game/chapters/chapter1/script/ch1sc4.rpy:403
translate brazil ch1sc4_e6a0d1f9:

#   mc "*Whispers* {size=-10}{b}No, this one has to be a new species, or a mutation of some kind.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Não, essa deve ser uma nova espécie, ou algum tipo de mutação.{/b}{/size}"

# game/chapters/chapter1/script/ch1sc4.rpy:404
translate brazil ch1sc4_18d396c5:

#   mc "*Whispers* {size=-10}{b}It’s like we are adventurers already, Alice. Exploring the forests and finding new animals.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}É como se já fôssemos aventureiros, Alice. Explorando as florestas e encontrando novos animais.{/b}{/size}"

# game/chapters/chapter1/script/ch1sc4.rpy:406
translate brazil ch1sc4_eca44874:

#   al "*Excited* I know! {b}This is great!{/b}"
    al "*Estou animada*, eu sei! {b} Isso é ótimo!{/b}"

# game/chapters/chapter1/script/ch1sc4.rpy:408
translate brazil ch1sc4_636885c5:

#   al "Oops! I got too excited... me and my loud mouth."
    al "Ops! Me empolguei demais... eu e minha boca grande."

# game/chapters/chapter1/script/ch1sc4.rpy:410
translate brazil ch1sc4_ff5e737c:

#   mc "*Chuckles* You definitely won't have any success as a burglar..."
    mc "*Risos* Você definitivamente não terá sucesso como ladrão..."

# game/chapters/chapter1/script/ch1sc4.rpy:411
translate brazil ch1sc4_c55bd6c0:

#   mc "Don’t worry, Alice. We still got to see it. That's pretty amazing if you ask me!"
    mc "Não se preocupe, Alice. Nós ainda conseguimos ver. Isso é incrível, na minha opinião!"

# game/chapters/chapter1/script/ch1sc4.rpy:413
translate brazil ch1sc4_dc7d1f31:

#   al "..."
    al "..."

# game/chapters/chapter1/script/ch1sc4.rpy:414
translate brazil ch1sc4_317f5088:

#   al "You’re right... Hey let’s go over there and sit for a while."
    al "Você tem razão... Ei, vamos lá e sentamos um pouco."

# game/chapters/chapter1/script/ch1sc4.rpy:416
translate brazil ch1sc4_8f5ebec6:

#   mc "Sure... hey! Wait up!"
    mc "Claro... ei! Espere!"

# game/chapters/chapter1/script/ch1sc4.rpy:418
translate brazil ch1sc4_4a74649f:

#   al "*Giggles* Last one buys sweets on the next market day!"
    al "*Risos* Quem chegar por último compra doces no próximo dia de feira!"

# game/chapters/chapter1/script/ch1sc4.rpy:420
translate brazil ch1sc4_8aeaec65:

#   mc "Can’t wait for you to buy me a whole wagon of treats!"
    mc "Mal posso esperar para você me comprar um carrinho cheio de guloseimas!"

# game/chapters/chapter1/script/ch1sc4.rpy:421
translate brazil ch1sc4_db9cde58:

#   al "Over here. We can lay down for a while!"
    al "Por aqui. Podemos deitar um pouco!"

# game/chapters/chapter1/script/ch1sc4.rpy:423
translate brazil ch1sc4_096d78da:

#   al "This is just what I needed! My legs feel like jelly that's been left out in the sun!"
    al "Era exatamente disso que eu precisava! Minhas pernas estão parecendo gelatina que ficou no sol!"

# game/chapters/chapter1/script/ch1sc4.rpy:425
translate brazil ch1sc4_6dd9c8f4:

#   mc "*Chuckles* Alice, you always say the weirdest things..."
    mc "*Risos* Alice, você sempre diz as coisas mais estranhas..."

# game/chapters/chapter1/script/ch1sc4.rpy:427
translate brazil ch1sc4_68d0983d:

#   al "*Giggles* Made you laugh, didn't it?"
    al "*Risos* Te fiz rir, não foi?"

# game/chapters/chapter1/script/ch1sc4.rpy:429
translate brazil ch1sc4_029555d8:

#   mc "Yuup! You sure did!"
    mc "Sim! Com certeza!"

# game/chapters/chapter1/script/ch1sc4.rpy:431
translate brazil ch1sc4_54017f44:

#   mc "Hey Alice?"
    mc "Ei, Alice?"

# game/chapters/chapter1/script/ch1sc4.rpy:432
translate brazil ch1sc4_6fca71c2:

#   al "Hmm?"
    al "Hum?"

# game/chapters/chapter1/script/ch1sc4.rpy:434
translate brazil ch1sc4_d3f5e5de:

#   mc "Can I ask a question about your father?"
    mc "Posso fazer uma pergunta sobre seu pai?"

# game/chapters/chapter1/script/ch1sc4.rpy:436
translate brazil ch1sc4_63e507a5:

#   al "Sure, I guess you can. But you know that I barely know anything about him..."
    al "Claro, acho que pode. Mas você sabe que eu mal sei alguma coisa sobre ele..."

# game/chapters/chapter1/script/ch1sc4.rpy:438
translate brazil ch1sc4_5e5021b6:

#   mc "I was wondering if your dad... you know, maybe you would have siblings?"
    mc "Estava pensando se seu pai... sabe, talvez você tivesse irmãos?"

# game/chapters/chapter1/script/ch1sc4.rpy:440
translate brazil ch1sc4_55d6e1bb:

#   al "Oh, I guess. But you still have both your parents and you don't have any siblings either."
    al "Ah, acho que sim. Mas você ainda tem seus pais e não tem irmãos."

# game/chapters/chapter1/script/ch1sc4.rpy:442
translate brazil ch1sc4_98a66b98:

#   mct "Huh, she’s right. I wonder why Mama and Papa haven't had any more children?"
    mct "Hum, ela tem razão. Fico pensando por que mamãe e papai não tiveram mais filhos?"

# game/chapters/chapter1/script/ch1sc4.rpy:444
translate brazil ch1sc4_f83b3eff:

#   mc "Yeah. That is weird, now that you mention it."
    mc "Sim. É estranho, agora que você mencionou."

# game/chapters/chapter1/script/ch1sc4.rpy:446
translate brazil ch1sc4_a7eaeb82:

#   al "I don't know about you... but I don't need any siblings. I already have you."
    al "Não sei quanto a você... mas eu não preciso de irmãos. Eu já tenho você."

# game/chapters/chapter1/script/ch1sc4.rpy:447
translate brazil ch1sc4_747a900f:

#   mc "*Chuckles* True, true, true!"
    mc "*Risos* Verdade, verdade, verdade!"

# game/chapters/chapter1/script/ch1sc4.rpy:449
translate brazil ch1sc4_def904e6:

#   al "[mc]..."
    al "[mc]..."

# game/chapters/chapter1/script/ch1sc4.rpy:451
translate brazil ch1sc4_b9635451:

#   "Alice hesitates for a moment..."
    "Alice hesita por um instante..."

# game/chapters/chapter1/script/ch1sc4.rpy:453
translate brazil ch1sc4_51f6667b:

#   al "Promise me that you won’t leave me."
    al "Prometa-me que você não vai me deixar."

# game/chapters/chapter1/script/ch1sc4.rpy:455
translate brazil ch1sc4_ec761c3f:

#   mc "I promise. I will always watch over you, Alice."
    mc "Eu prometo. Sempre cuidarei de você, Alice."

# game/chapters/chapter1/script/ch1sc4.rpy:456
translate brazil ch1sc4_5a3444b8:

#   al "Always and forever?"
    al "Para sempre e para sempre?"

# game/chapters/chapter1/script/ch1sc4.rpy:457
translate brazil ch1sc4_25cb6354:

#   mc "Always and forever."
    mc "Sempre e para sempre."

# game/chapters/chapter1/script/ch1sc4.rpy:459
translate brazil ch1sc4_5395ca83:

#   "It doesn’t take long before you both fall asleep."
    "Não demora muito para que ambos adormeçam."

# game/chapters/chapter1/script/ch1sc4.rpy:383
translate brazil ch1sc4_a20cefa7_1:

#   "..."
    "..."

