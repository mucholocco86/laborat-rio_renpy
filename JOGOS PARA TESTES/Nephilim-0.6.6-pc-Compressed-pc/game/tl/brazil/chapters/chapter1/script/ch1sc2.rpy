# ARQUIVO: game/chapters/chapter1/script/ch1sc2.rpy DIALOGOS: 234


# game/chapters/chapter1/script/ch1sc2.rpy:67
translate brazil ch1sc2_2b35b6fe_1:

#   mc "..."
    mc "..."

# game/chapters/chapter1/script/ch1sc2.rpy:12
translate brazil ch1sc2_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter1/script/ch1sc2.rpy:18
translate brazil ch1sc2_0e3394cb:

#   ma "Sweetie... wake up."
    ma "Querida... acorde."

# game/chapters/chapter1/script/ch1sc2.rpy:19
translate brazil ch1sc2_7c1a4d9b:

#   mc "Maaa... just a little bit longer!"
    mc "Maaa... só mais um pouquinho!"

# game/chapters/chapter1/script/ch1sc2.rpy:21
translate brazil ch1sc2_40142d67:

#   mat "My little boy is growing up too fast! I can't believe he’s already ten summers old."
    mat "Meu filhinho está crescendo rápido demais! Não consigo acreditar que ele já tem dez verões."

# game/chapters/chapter1/script/ch1sc2.rpy:23
translate brazil ch1sc2_d61502bf:

#   ma "No way, you little munchkin! It's your special day today!"
    ma "De jeito nenhum, meu pequeno! Hoje é o seu dia especial!"

# game/chapters/chapter1/script/ch1sc2.rpy:25
translate brazil ch1sc2_f815cea7:

#   mct "Huh... Special day? Oh... {b}OH!{/b}"
    mct "Hum... Dia especial? Ah... {b} OH!{/b}"

# game/chapters/chapter1/script/ch1sc2.rpy:26
translate brazil ch1sc2_16b9026c:

#   mct "It’s my birthday today! I'm finally turning ten."
    mct "Hoje é meu aniversário! Finalmente estou completando dez anos."

# game/chapters/chapter1/script/ch1sc2.rpy:27
translate brazil ch1sc2_e4d19dcb:

#   mct "I’m definitely old enough to start training to become an adventurer now!"
    mct "Com certeza já tenho idade suficiente para começar a treinar para me tornar um aventureiro!"

# game/chapters/chapter1/script/ch1sc2.rpy:29
translate brazil ch1sc2_cfbe7803:

#   ma "Now get your cute little butt out of bed, mister. I've already made breakfast for us, and your dad is waiting at the table!"
    ma "Agora levanta esse teu rabinho bonitinho da cama, mocinho. Já preparei o café da manhã para nós, e seu pai está esperando à mesa!"

# game/chapters/chapter1/script/ch1sc2.rpy:31
translate brazil ch1sc2_87907805:

#   "Mama leaves the room and you contemplate staying in bed a while longer..."
    "Mamãe sai do quarto e você pensa em ficar na cama mais um pouco..."

# game/chapters/chapter1/script/ch1sc2.rpy:33
translate brazil ch1sc2_876321c3:

#   "But you don't much feel like doing chores on your birthday, so you decide to get up."
    "Mas você não está com muita vontade de fazer tarefas domésticas no seu aniversário, então decide se levantar."

# game/chapters/chapter1/script/ch1sc2.rpy:35
translate brazil ch1sc2_3bcc1b80:

#   "With a loud yawn, you slowly sit up."
    "Com um bocejo alto, você se senta lentamente."

# game/chapters/chapter1/script/ch1sc2.rpy:36
translate brazil ch1sc2_fa4dcfc4:

#   "Only a few seconds pass before your tummy beings to growl"
    "Passam-se apenas alguns segundos antes que sua barriga comece a roncar."

# game/chapters/chapter1/script/ch1sc2.rpy:38
translate brazil ch1sc2_09798d9c:

#   mc "I’m so hungry I could eat a feast meant for the king!"
    mc "Estou com tanta fome que comeria um banquete digno de um rei!"

# game/chapters/chapter1/script/ch1sc2.rpy:39
translate brazil ch1sc2_24d85e60:

#   mc "Better get some breakfast if I want to have any hope of becoming a strong adventurer!"
    mc "É melhor tomar um bom café da manhã se eu quiser ter alguma chance de me tornar um aventureiro de sucesso!"

# game/chapters/chapter1/script/ch1sc2.rpy:41
translate brazil ch1sc2_fa137af5:

#   "You stand up, after a good stretch you feel eager to start the day."
    "Você se levanta e, depois de se alongar bem, sente-se ansioso para começar o dia."

# game/chapters/chapter1/script/ch1sc2.rpy:42
translate brazil ch1sc2_b724957d:

#   "Heading to the kitchen you can hear the fireplace crackling and your parents chatting."
    "Ao ir para a cozinha, você consegue ouvir a lareira crepitando e seus pais conversando."

# game/chapters/chapter1/script/ch1sc2.rpy:44
translate brazil ch1sc2_6683bdf1:

#   mct "Ahh, today is going to be awesome!"
    mct "Ah, hoje vai ser incrível!"

# game/chapters/chapter1/script/ch1sc2.rpy:45
translate brazil ch1sc2_ec51f127:

#   mct "I’ve always wanted to be a famous adventurer, one who travels far across Midomir!"
    mct "Sempre quis ser um aventureiro famoso, alguém que viaje por todo Midomir!"

# game/chapters/chapter1/script/ch1sc2.rpy:46
translate brazil ch1sc2_586ca52a:

#   mct "Imagine finding secret ruins... or rescuing people from goblins!"
    mct "Imagine encontrar ruínas secretas... ou resgatar pessoas de goblins!"

# game/chapters/chapter1/script/ch1sc2.rpy:47
translate brazil ch1sc2_f31bf520:

#   mct "Finding some buried treasure would definitely be pretty cool too!"
    mct "Encontrar um tesouro enterrado também seria muito legal!"

# game/chapters/chapter1/script/ch1sc2.rpy:48
translate brazil ch1sc2_90e3f1a1:

#   mct "This will be amazing! I’ve got to begin training soon."
    mct "Isso vai ser incrível! Preciso começar a treinar em breve."

# game/chapters/chapter1/script/ch1sc2.rpy:50
translate brazil ch1sc2_1ec898b4:

#   mc "Morning Papa!"
    mc "Bom dia, papai!"

# game/chapters/chapter1/script/ch1sc2.rpy:52
translate brazil ch1sc2_c844614c:

#   pa "Ahh, there you are son! I was starting to think the bed had swallowed you up!"
    pa "Ah, aí está você, filho! Já estava começando a achar que a cama tinha te engolido!"

# game/chapters/chapter1/script/ch1sc2.rpy:53
translate brazil ch1sc2_c3b0a6fe:

#   pa "I know it's early, but today is a special birthday!"
    pa "Eu sei que ainda é cedo, mas hoje é um aniversário especial!"

# game/chapters/chapter1/script/ch1sc2.rpy:55
translate brazil ch1sc2_1da237a4:

#   mc "Huh, what makes this birthday so special?"
    mc "Hum, o que torna este aniversário tão especial?"

# game/chapters/chapter1/script/ch1sc2.rpy:57
translate brazil ch1sc2_7804b518:

#   pa "Son, this is your tenth summer. It's finally time to start teaching you about my work"
    pa "Filho, este é o seu décimo verão. Finalmente chegou a hora de começar a te ensinar sobre o meu trabalho."

# game/chapters/chapter1/script/ch1sc2.rpy:59
translate brazil ch1sc2_bdbc33d8:

#   mc "Uhh... but Papa, I want to become an adventurer. I'm definitely old enough to start training now!"
    mc "Hum... mas papai, eu quero me tornar um aventureiro. Com certeza já tenho idade suficiente para começar a treinar!"

# game/chapters/chapter1/script/ch1sc2.rpy:61
translate brazil ch1sc2_268cf777:

#   pa "Son, we’ve talked about this. You need to learn my trade, then you'll be able to help others around the village."
    pa "Filho, já conversamos sobre isso. Você precisa aprender o meu ofício, aí poderá ajudar os outros na aldeia."

# game/chapters/chapter1/script/ch1sc2.rpy:63
translate brazil ch1sc2_ac53027c:

#   mc "But Pa!!"
    mc "Mas pai!!"

# game/chapters/chapter1/script/ch1sc2.rpy:65
translate brazil ch1sc2_0d78bfc4:

#   pa "No! Enough about this adventurer nonsense..."
    pa "Não! Chega dessa bobagem de aventureiro..."

# game/chapters/chapter1/script/ch1sc2.rpy:69
translate brazil ch1sc2_cb16be87:

#   pa "..."
    pa "..."

# game/chapters/chapter1/script/ch1sc2.rpy:71
translate brazil ch1sc2_419a8896:

#   pa "Look son ... sorry for raising my voice. But becoming an adventurer... it’s just a child's dream."
    pa "Olha, filho... desculpe por ter levantado a voz. Mas se tornar um aventureiro... é apenas o sonho de criança."

# game/chapters/chapter1/script/ch1sc2.rpy:72
translate brazil ch1sc2_9c1c4b7d:

#   pa "Leave that to the knights of the guilds in the capital."
    pa "Deixe isso para os cavaleiros das guildas da capital."

# game/chapters/chapter1/script/ch1sc2.rpy:73
translate brazil ch1sc2_f7223931:

#   pa "Son, you are a true miracle for your mother and me; a blessing from the divines."
    pa "Filho, você é um verdadeiro milagre para sua mãe e para mim; uma bênção divina."

# game/chapters/chapter1/script/ch1sc2.rpy:74
translate brazil ch1sc2_3e8b3bab:

#   pa "We don't want you to put yourself in danger just for thrills."
    pa "Não queremos que você se coloque em perigo apenas por emoção."

# game/chapters/chapter1/script/ch1sc2.rpy:76
translate brazil ch1sc2_207478e1:

#   mct "Papa doesn’t understand... I want to help people and discover new things."
    mct "Papai não entende... Eu quero ajudar as pessoas e descobrir coisas novas."

# game/chapters/chapter1/script/ch1sc2.rpy:78
translate brazil ch1sc2_fc270507:

#   pat "I can’t tell him the real reason that we need him to stay here in Riverside."
    pat "Não posso lhe contar o verdadeiro motivo pelo qual precisamos que ele fique aqui em Riverside."

# game/chapters/chapter1/script/ch1sc2.rpy:79
translate brazil ch1sc2_6f48026d:

#   pat "If only he'd give up this foolish dream! It's way too dangerous for him."
    pat "Se ao menos ele desistisse desse sonho tolo! É muito perigoso para ele."

# game/chapters/chapter1/script/ch1sc2.rpy:81
translate brazil ch1sc2_c30f5280:

#   mct "Just wait Papa... I'll show you and everyone else that I have what it takes to be an adventurer."
    mct "Aguarde só, papai... Vou mostrar a você e a todos os outros que tenho o que é preciso para ser um aventureiro."

# game/chapters/chapter1/script/ch1sc2.rpy:83
translate brazil ch1sc2_e5edb7ab:

#   mct "Hmm, I’ve got a plan... If we can go see Gibson the blacksmith in Riverside, then maybe he can craft me a sword!"
    mct "Hum, tive uma ideia... Se pudermos ir ver o ferreiro Gibson em Riverside, talvez ele consiga fazer uma espada para mim!"

# game/chapters/chapter1/script/ch1sc2.rpy:85
translate brazil ch1sc2_fab74df1:

#   ma "Now now you two! Don't get ahead of yourselves. Finish your breakfast and save all this discussion about work for later."
    ma "Calma aí, vocês dois! Não se precipitem. Terminem o café da manhã e deixem essa conversa sobre trabalho para depois."

# game/chapters/chapter1/script/ch1sc2.rpy:87
translate brazil ch1sc2_d5625542:

#   "You take a big bite of your oats."
    "Você dá uma grande mordida no seu mingau de aveia."

# game/chapters/chapter1/script/ch1sc2.rpy:89
translate brazil ch1sc2_f84a6e35:

#   mc "Mmh, this is yummy! No wonder Clark always tries to convince Mama to cook at the tavern."
    mc "Hum, que delícia! Não é à toa que o Clark sempre tenta convencer a mamãe a cozinhar na taverna."

# game/chapters/chapter1/script/ch1sc2.rpy:91
translate brazil ch1sc2_9bad4bff:

#   pa "It sure is great, honey!"
    pa "É ótimo mesmo, querida!"

# game/chapters/chapter1/script/ch1sc2.rpy:93
translate brazil ch1sc2_0d46f9f2:

#   ma "Oh, by the divines... what am I to do with you two?"
    ma "Oh, pelos deuses... o que farei com vocês dois?"

# game/chapters/chapter1/script/ch1sc2.rpy:95
translate brazil ch1sc2_b3cbeec8:

#   mc "Papa, I’m finished now. Can I come with you today?"
    mc "Papai, já terminei. Posso ir com você hoje?"

# game/chapters/chapter1/script/ch1sc2.rpy:97
translate brazil ch1sc2_eb5dce45:

#   pa "Ha! It's good to see you so eager son! You remind me of myself at your age"
    pa "Ah! Que bom te ver tão entusiasmado, filho! Você me lembra de mim mesmo na sua idade."

# game/chapters/chapter1/script/ch1sc2.rpy:99
translate brazil ch1sc2_9500e269:

#   pa "Don't worry, son. Today you just have fun and tomorrow we'll start your training!"
    pa "Não se preocupe, filho. Hoje você só precisa se divertir e amanhã começaremos seu treinamento!"

# game/chapters/chapter1/script/ch1sc2.rpy:101
translate brazil ch1sc2_84f16542:

#   mc "Okay..."
    mc "OK..."

# game/chapters/chapter1/script/ch1sc2.rpy:103
translate brazil ch1sc2_35a544e4:

#   ma "Oh, Honeybun! Keep your chin up, munchkin. I’ll have a chat with this old man. Go outside & play."
    ma "Oh, meu bem! Não desanime, meu pequeno. Vou conversar com esse velhinho. Vá lá fora brincar."

# game/chapters/chapter1/script/ch1sc2.rpy:105
translate brazil ch1sc2_9a320427:

#   "Mama walks toward you. You know that look on her face... Papa is in trouble!"
    "Mamãe caminha em sua direção. Você conhece aquela expressão no rosto dela... Papai está em apuros!"

# game/chapters/chapter1/script/ch1sc2.rpy:107
translate brazil ch1sc2_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter1/script/ch1sc2.rpy:109
translate brazil ch1sc2_334f9252:

#   "Mama plants a soft kiss on your forehead"
    "Mamãe deposita um beijo suave em sua testa."

# game/chapters/chapter1/script/ch1sc2.rpy:111
translate brazil ch1sc2_24fb42cc:

#   ma "Munchkin, you can head outside. Papa... will be with you shortly."
    ma "Munchkin, você pode ir lá fora. Papai... já vai estar com você."

# game/chapters/chapter1/script/ch1sc2.rpy:113
translate brazil ch1sc2_2c163683:

#   "As you walk towards the door, you can feel Mama staring daggers at Papa."
    "Ao caminhar em direção à porta, você consegue sentir o olhar fulminante da mamãe para o papai."

# game/chapters/chapter1/script/ch1sc2.rpy:115
translate brazil ch1sc2_d11f91a3:

#   "Once outside, you feel the cool morning breeze on your cheeks."
    "Ao sair, você sente a brisa fresca da manhã em suas bochechas."

# game/chapters/chapter1/script/ch1sc2.rpy:117
translate brazil ch1sc2_a77427bc:

#   mc "Aahh. Today is going to be great! I can feel it in my tummy!"
    mc "Ahhh. Hoje vai ser ótimo! Consigo sentir isso na minha barriga!"

# game/chapters/chapter1/script/ch1sc2.rpy:119
translate brazil ch1sc2_6262f50e:

#   ma "Honey, don't be so quick to dismiss [mc]'s dreams."
    ma "Querida, não descarte isso tão rapidamente. [mc] Os sonhos de."

# game/chapters/chapter1/script/ch1sc2.rpy:120
translate brazil ch1sc2_bdc0667b:

#   ma "You should know that telling someone {b}NOT{/b} to do something at his age will only make him more determined."
    ma "Você deve saber que contar para alguém {b} NÃO{/b} Fazer algo nessa idade só o tornará mais determinado."

# game/chapters/chapter1/script/ch1sc2.rpy:122
translate brazil ch1sc2_7a451c88:

#   pa "Blazes... you’ve got a point. I guess I was a little too quick."
    pa "Puxa... você tem razão. Acho que me precipitei um pouco."

# game/chapters/chapter1/script/ch1sc2.rpy:124
translate brazil ch1sc2_fecb9421:

#   ma "What gave you that impression?"
    ma "O que lhe deu essa impressão?"

# game/chapters/chapter1/script/ch1sc2.rpy:126
translate brazil ch1sc2_90c51121:

#   pa "Was I too tough on him, you think?"
    pa "Você acha que fui muito duro com ele?"

# game/chapters/chapter1/script/ch1sc2.rpy:128
translate brazil ch1sc2_e7fa40a3:

#   ma "All I know is... I remember a certain someone who used to have all sorts of dreams of their own."
    ma "Tudo o que sei é... Lembro-me de uma certa pessoa que costumava ter todo tipo de sonhos próprios."

# game/chapters/chapter1/script/ch1sc2.rpy:130
translate brazil ch1sc2_e6030cd6:

#   pa "You’re right, my love. I just want him to live a happy life here in our village."
    pa "Você tem razão, meu amor. Eu só quero que ele tenha uma vida feliz aqui na nossa aldeia."

# game/chapters/chapter1/script/ch1sc2.rpy:131
translate brazil ch1sc2_6fa88633:

#   pa "I never wanted him to feel like I was dismissing his dreams."
    pa "Eu nunca quis que ele sentisse que eu estava desmerecendo os sonhos dele."

# game/chapters/chapter1/script/ch1sc2.rpy:133
translate brazil ch1sc2_e65e4fdb:

#   ma "Come here, honey."
    ma "Vem cá, querida."

# game/chapters/chapter1/script/ch1sc2.rpy:135
translate brazil ch1sc2_6d80426a:

#   "Your parents share a gentle and loving kiss."
    "Seus pais trocam um beijo terno e carinhoso."

# game/chapters/chapter1/script/ch1sc2.rpy:137
translate brazil ch1sc2_2962b0d7:

#   ma "We have to keep him safe, no matter what. Nobody can ever find out."
    ma "Temos que protegê-lo, custe o que custar. Ninguém jamais pode descobrir."

# game/chapters/chapter1/script/ch1sc2.rpy:139
translate brazil ch1sc2_e10f5eff:

#   pa "I know dear, I know. We will protect him like we always have."
    pa "Eu sei, querida, eu sei. Nós o protegeremos como sempre fizemos."

# game/chapters/chapter1/script/ch1sc2.rpy:141
translate brazil ch1sc2_2a02fb9e:

#   ma "I just worry so much!"
    ma "Eu me preocupo demais!"

# game/chapters/chapter1/script/ch1sc2.rpy:142
translate brazil ch1sc2_63c2e854:

#   ma "He's all we have... you two are my world."
    ma "Ele é tudo o que temos... vocês dois são o meu mundo."

# game/chapters/chapter1/script/ch1sc2.rpy:144
translate brazil ch1sc2_f4b61b90:

#   pa "Honey, I promise you, nothing will happen. We’ve been careful ever since he was born."
    pa "Querida, eu prometo, nada vai acontecer. Temos sido cuidadosos desde que ele nasceu."

# game/chapters/chapter1/script/ch1sc2.rpy:146
translate brazil ch1sc2_84326348:

#   ma "I suppose you’re right. Alright, alright. You'd better get going. There's a whole bunch I need to prepare for his birthday dinner."
    ma "Acho que você tem razão. Tudo bem, tudo bem. É melhor você ir. Tenho muita coisa para preparar para o jantar de aniversário dele."

# game/chapters/chapter1/script/ch1sc2.rpy:147
translate brazil ch1sc2_e059a7ad:

#   ma "I'll be heading into town with Maya, the market should have been restocked recently."
    ma "Vou à cidade com a Maya; o mercado deve ter sido reabastecido recentemente."

# game/chapters/chapter1/script/ch1sc2.rpy:149
translate brazil ch1sc2_7a9b8536:

#   pa "Alright sweetie, tell Maya I said hi... now, come here."
    pa "Tudo bem, querida, diga à Maya que mandei um oi... agora, venha aqui."

# game/chapters/chapter1/script/ch1sc2.rpy:151
translate brazil ch1sc2_6eacd584:

#   "Papa pulls Mama in for another kiss. It calms her down slightly."
    "Papai puxa mamãe para mais um beijo. Isso a acalma um pouco."

# game/chapters/chapter1/script/ch1sc2.rpy:153
translate brazil ch1sc2_59d085eb:

#   pa "My beautiful and loving wife."
    pa "Minha linda e amada esposa."

# game/chapters/chapter1/script/ch1sc2.rpy:155
translate brazil ch1sc2_d918cb43:

#   "Papa walks outside and Mama begins preparing the birthday dinner ingredients."
    "Papai sai e mamãe começa a preparar os ingredientes para o jantar de aniversário."

# game/chapters/chapter1/script/ch1sc2.rpy:158
translate brazil ch1sc2_e3ab6f0e:

#   pat "Hmm, looks like I'm out of nails already. I’ll have to visit Gibson on my way to the market."
    pat "Hum, parece que já fiquei sem pregos. Vou ter que dar uma passada na Gibson a caminho do mercado."

# game/chapters/chapter1/script/ch1sc2.rpy:159
translate brazil ch1sc2_b73c1955:

#   mc "Hi Papa! What are you doing today?"
    mc "Oi, papai! O que você vai fazer hoje?"

# game/chapters/chapter1/script/ch1sc2.rpy:161
translate brazil ch1sc2_8f7ce281:

#   pa "Oh, hey Son. Today I’m heading into the village to get some supplies from the market"
    pa "Ah, olá filho. Hoje vou à vila comprar algumas coisas no mercado."

# game/chapters/chapter1/script/ch1sc2.rpy:162
translate brazil ch1sc2_55949552:

#   pa "I’ll have to stop by Gibson’s workshop on the way. We’re out of nails."
    pa "Vou ter que dar uma passada na oficina do Gibson no caminho. Estamos sem pregos."

# game/chapters/chapter1/script/ch1sc2.rpy:164
translate brazil ch1sc2_7c023e45:

#   mct "Oh, Gibson! It's been a long time since I saw him. He's the village blacksmith and Papa’s long-time friend."
    mct "Ah, Gibson! Faz muito tempo que não o vejo. Ele é o ferreiro da aldeia e amigo de longa data do papai."

# game/chapters/chapter1/script/ch1sc2.rpy:166
translate brazil ch1sc2_dda64252:

#   mc "How about I come with you, Dad? I want to talk to Gibson too! Maybe he can craft me a sword!"
    mc "Que tal eu ir com você, pai? Eu também quero falar com o Gibson! Talvez ele possa fazer uma espada para mim!"

# game/chapters/chapter1/script/ch1sc2.rpy:168
translate brazil ch1sc2_b20199cf:

#   pa "A sword? Why would you want a sword? Are you planning on becoming a knight now?"
    pa "Uma espada? Por que você iria querer uma espada? Está planejando se tornar um cavaleiro agora?"

# game/chapters/chapter1/script/ch1sc2.rpy:170
translate brazil ch1sc2_ad6579c6:

#   mct "Hmm, maybe he likes knights better than adventurers? It's worth a shot!"
    mct "Hum, talvez ele goste mais de cavaleiros do que de aventureiros? Vale a pena tentar!"

# game/chapters/chapter1/script/ch1sc2.rpy:172
translate brazil ch1sc2_e9bd9d8a:

#   mc "Yes... maybe... not sure, Papa. But it would be cool to have a sword, right?"
    mc "Sim... talvez... não tenho certeza, papai. Mas seria legal ter uma espada, né?"

# game/chapters/chapter1/script/ch1sc2.rpy:174
translate brazil ch1sc2_7ea60fb3:

#   pa "Settle down, Son. You’re still too young for such things. First, you need to learn to use hammers, nails and saws."
    pa "Calma, filho. Você ainda é muito novo para essas coisas. Primeiro, você precisa aprender a usar martelos, pregos e serras."

# game/chapters/chapter1/script/ch1sc2.rpy:176
translate brazil ch1sc2_98cb9a3b:

#   mct "Hmm... I guess I'll have to play along, for now."
    mct "Hum... Acho que vou ter que entrar na brincadeira, por enquanto."

# game/chapters/chapter1/script/ch1sc2.rpy:178
translate brazil ch1sc2_f1d4f7f6:

#   mct "If I pretend to be interested in his work, maybe he will allow me to have a sword later?"
    mct "Se eu fingir interesse no trabalho dele, talvez ele me deixe ter uma espada mais tarde?"

# game/chapters/chapter1/script/ch1sc2.rpy:180
translate brazil ch1sc2_3ad410e3:

#   mc "Okay, okay. I’ll focus on mastering a hammer first."
    mc "Certo, certo. Primeiro vou me concentrar em dominar o martelo."

# game/chapters/chapter1/script/ch1sc2.rpy:182
translate brazil ch1sc2_fefcea21:

#   pa "I’m glad to hear it, Son! Trust me, you will love it!"
    pa "Que bom ouvir isso, filho! Confie em mim, você vai adorar!"

# game/chapters/chapter1/script/ch1sc2.rpy:184
translate brazil ch1sc2_22b12dd4:

#   mct "I’ve got to be patient... the capital wasn’t built in a day."
    mct "Tenho que ter paciência... a capital não foi construída em um dia."

# game/chapters/chapter1/script/ch1sc2.rpy:186
translate brazil ch1sc2_9340d22a:

#   "A wild Alice appears!"
    "Uma Alice selvagem aparece!"

# game/chapters/chapter1/script/ch1sc2.rpy:189
translate brazil ch1sc2_377758eb:

#   al "Hi [mc]. Hi sir!"
    al "Fé [mc] Olá, senhor!"

# game/chapters/chapter1/script/ch1sc2.rpy:191
translate brazil ch1sc2_ef86efe0:

#   mc "Hi Alice! What are you doing here this early?"
    mc "Olá Alice! O que você está fazendo aqui tão cedo?"

# game/chapters/chapter1/script/ch1sc2.rpy:193
translate brazil ch1sc2_a04a0077:

#   mct "Alice is my best friend. We have been inseparable ever since we met 2 summers ago."
    mct "Alice é minha melhor amiga. Somos inseparáveis ​​desde que nos conhecemos, há dois verões."

# game/chapters/chapter1/script/ch1sc2.rpy:194
translate brazil ch1sc2_3da7b01c:

#   mct "She moved here to Riverside with her mother, Beth... Beth she... does not like me."
    mct "Ela se mudou para Riverside com a mãe dela, Beth... Beth... não gosta de mim."

# game/chapters/chapter1/script/ch1sc2.rpy:195
translate brazil ch1sc2_104912ce:

#   mct "But Alice... she is the most compassionate and thoughtful person I know."
    mct "Mas Alice... ela é a pessoa mais compassiva e atenciosa que conheço."

# game/chapters/chapter1/script/ch1sc2.rpy:196
translate brazil ch1sc2_e33b17fd:

#   mct "She’s always been there for me like I've been for her. We both dream of becoming adventurers and travelling the world together!"
    mct "Ela sempre esteve ao meu lado, assim como eu estive ao lado dela. Nós duas sonhamos em nos tornar aventureiras e viajar pelo mundo juntas!"

# game/chapters/chapter1/script/ch1sc2.rpy:198
translate brazil ch1sc2_de350e19:

#   al "I've come to celebrate you, silly!"
    al "Vim para celebrar você, bobinho(a)!"

# game/chapters/chapter1/script/ch1sc2.rpy:200
translate brazil ch1sc2_8f1b92f6:

#   mc "Ohh... sorry Alice. I was about to go with father to visit Gibson."
    mc "Ah... desculpe, Alice. Eu estava prestes a ir com meu pai visitar Gibson."

# game/chapters/chapter1/script/ch1sc2.rpy:201
translate brazil ch1sc2_5f05148b:

#   mc "We can hang out later I’m sure!"
    mc "Podemos sair mais tarde, tenho certeza!"

# game/chapters/chapter1/script/ch1sc2.rpy:203
translate brazil ch1sc2_e75e4b0e:

#   al "Oh... okay. I just wanted to see if we could go exploring in the forest."
    al "Ah... tudo bem. Eu só queria ver se podíamos ir explorar a floresta."

# game/chapters/chapter1/script/ch1sc2.rpy:205
translate brazil ch1sc2_70ffcbcb:

#   mct "Hmm, that does sound way more fun than going with Papa."
    mct "Hum, isso parece muito mais divertido do que ir com o papai."

# game/chapters/chapter1/script/ch1sc2.rpy:206
translate brazil ch1sc2_176c9b76:

#   mct "But I also gotta prove to Papa that I'm serious..."
    mct "Mas também preciso provar ao papai que estou falando sério..."

# game/chapters/chapter1/script/ch1sc2.rpy:207
translate brazil ch1sc2_f91dc4cf:

#   mct "What should I do?"
    mct "O que devo fazer?"

# game/chapters/chapter1/script/ch1sc2.rpy:214
translate brazil ch1sc2_54272d84:

#   "Alice's Trust has Increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "A confiança de Alice aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter1/script/ch1sc2.rpy:215
translate brazil ch1sc2_0d672871:

#   pa "Don’t be silly! Alice, he’s free to go with you, just don’t stay out too long. I know his mother has plans for his birthday dinner."
    pa "Não seja boba! Alice, ele pode ir com você, só não demore muito. Eu sei que a mãe dele já tem planos para o jantar de aniversário dele."

# game/chapters/chapter1/script/ch1sc2.rpy:217
translate brazil ch1sc2_cf843828:

#   al "Yay! Come on [mc]! Let's go explore!"
    al "Eba! Vamos lá! [mc] Vamos explorar!"

# game/chapters/chapter1/script/ch1sc2.rpy:219
translate brazil ch1sc2_4f2a8a9d:

#   "Alice grabs your hand and eagerly drags you towards the forest."
    "Alice agarra sua mão e, ansiosa, te arrasta em direção à floresta."

# game/chapters/chapter1/script/ch1sc2.rpy:221
translate brazil ch1sc2_7caa7009:

#   pat "*Chuckles* Hah, those two! They're growing up so fast. Too fast, if you ask me."
    pat "*Risos* Hah, esses dois! Estão crescendo tão rápido. Rápido demais, se me perguntarem."

# game/chapters/chapter1/script/ch1sc2.rpy:222
translate brazil ch1sc2_cdac6316:

#   pat "Poor Alice. She's had a tough childhood; her dad was murdered by bandits when she was so young."
    pat "Pobre Alice. Ela teve uma infância difícil; seu pai foi assassinado por bandidos quando ela era muito pequena."

# game/chapters/chapter1/script/ch1sc2.rpy:223
translate brazil ch1sc2_2d5f4fe1:

#   pat "But [mc] has been supportive of her ever since they met. I'm proud of you son."
    pat "Mas [mc] Ele a apoiou desde que se conheceram. Tenho orgulho de você, filho."

# game/chapters/chapter1/script/ch1sc2.rpy:225
translate brazil ch1sc2_5678b118:

#   mct "Alice seems eager today. I guess she's really excited for my birthday."
    mct "Alice parece animada hoje. Acho que ela está muito empolgada com o meu aniversário."

# game/chapters/chapter1/script/ch1sc2.rpy:226
translate brazil ch1sc2_cd0dc435:

#   mct "There's never a boring moment with this girl."
    mct "Com essa garota, nunca há um momento tedioso."

# game/chapters/chapter1/script/ch1sc2.rpy:234
translate brazil ch1sc2_042eda6c:

#   "You and Alice stroll happily through the forest, searching for anything of interest."
    "Você e Alice passeiam alegremente pela floresta, procurando por algo interessante."

# game/chapters/chapter1/script/ch1sc2.rpy:235
translate brazil ch1sc2_7091463e:

#   "After a while something catches Alice’s attention."
    "Após algum tempo, algo chama a atenção de Alice."

# game/chapters/chapter1/script/ch1sc2.rpy:237
translate brazil ch1sc2_c67e4b17:

#   al "Oh, look! I think there's something by that tree over there!"
    al "Olha só! Acho que tem alguma coisa perto daquela árvore ali!"

# game/chapters/chapter1/script/ch1sc2.rpy:239
translate brazil ch1sc2_086884f7:

#   "Alice starts running her fingers through the grass near the tree."
    "Alice começa a passar os dedos pela grama perto da árvore."

# game/chapters/chapter1/script/ch1sc2.rpy:241
translate brazil ch1sc2_9a10fdb2:

#   mct "Hmm I wonder what she is digging for over there?"
    mct "Hum, fico pensando o que será que ela está procurando por lá?"

# game/chapters/chapter1/script/ch1sc2.rpy:243
translate brazil ch1sc2_6802f648:

#   mc "Did you find something, Alice?"
    mc "Você encontrou alguma coisa, Alice?"

# game/chapters/chapter1/script/ch1sc2.rpy:245
translate brazil ch1sc2_f58dbbaf:

#   al "I thought I saw something glittering here, but it was just a smooth rock."
    al "Achei que tinha visto algo brilhando aqui, mas era apenas uma pedra lisa."

# game/chapters/chapter1/script/ch1sc2.rpy:247
translate brazil ch1sc2_42379c6d:

#   mc "Ahh. It was probably some light from the sun. Smooth surfaces can reflect it."
    mc "Ah. Provavelmente era a luz do sol. Superfícies lisas podem refletir a luz."

# game/chapters/chapter1/script/ch1sc2.rpy:249
translate brazil ch1sc2_6fd35622:

#   al "*Sigh* I really got excited for a bit there. Could you imagine finding something valuable?"
    al "*Suspiro* Por um momento, fiquei realmente empolgado. Imagina encontrar algo valioso?"

# game/chapters/chapter1/script/ch1sc2.rpy:251
translate brazil ch1sc2_2b86dbd1:

#   mc "Alice... I doubt we'll find anything valuable laying in the grass. You usually have to dig deep for treasure."
    mc "Alice... Duvido que encontremos algo valioso na grama. Geralmente é preciso cavar fundo para achar tesouros."

# game/chapters/chapter1/script/ch1sc2.rpy:253
translate brazil ch1sc2_94c24011:

#   al "Right! Right, right, right. I didn't think about that."
    al "Certo! Certo, certo, certo. Eu não tinha pensado nisso."

# game/chapters/chapter1/script/ch1sc2.rpy:254
translate brazil ch1sc2_98ee6c02:

#   al "But we'll find something that would even impress the King himself someday, I just know it!"
    al "Mas um dia encontraremos algo que impressionaria até o próprio Rei, disso eu tenho certeza!"

# game/chapters/chapter1/script/ch1sc2.rpy:256
translate brazil ch1sc2_954c5af9:

#   mc "{b}*Impression of the King*{/b} Oh, bless the Divines!"
    mc "{b}*Impressão do Rei*{/b} Oh, benditos sejam os Divinos!"

# game/chapters/chapter1/script/ch1sc2.rpy:257
translate brazil ch1sc2_df3c71e4:

#   mc "{b}*Impression of the King*{/b} It's [mc] and Alice with an ancient treasure you've brought to my kingdom. How can I repay you?"
    mc "{b}*Impressão do Rei*{/b} Isso é [mc] E Alice, com um antigo tesouro que você trouxe para o meu reino. Como posso lhe retribuir?"

# game/chapters/chapter1/script/ch1sc2.rpy:258
translate brazil ch1sc2_289d8337:

#   mc "You honour us, my King. If you could grant us a ship, that would be payment enough."
    mc "O senhor nos honra, meu Rei. Se pudesse nos conceder um navio, isso já seria pagamento suficiente."

# game/chapters/chapter1/script/ch1sc2.rpy:259
translate brazil ch1sc2_d94fb85e:

#   mc "{b}*Impression of the King*{/b} Of course! It shall be so. You will have the finest ship in my fleet."
    mc "{b}*Impressão do Rei*{/b} Claro! Assim será. Você terá o melhor navio da minha frota."

# game/chapters/chapter1/script/ch1sc2.rpy:261
translate brazil ch1sc2_2a495e86:

#   al "*Giggles* We'll be captains of the high seas in no time!"
    al "*Risos* Em pouco tempo seremos capitães dos altos mares!"

# game/chapters/chapter1/script/ch1sc2.rpy:263
translate brazil ch1sc2_81874411:

#   mc "We'll be swimming in coins, pearls and diamonds!"
    mc "Estaremos nadando em moedas, pérolas e diamantes!"

# game/chapters/chapter1/script/ch1sc2.rpy:264
translate brazil ch1sc2_a948b72e:

#   mc "Not to mention all the secret islands we'll discover and turn into our hideouts!"
    mc "Sem falar em todas as ilhas secretas que descobriremos e transformaremos em nossos esconderijos!"

# game/chapters/chapter1/script/ch1sc2.rpy:266
translate brazil ch1sc2_48c75855:

#   al "Aye aye, Captain [mc]!"
    al "Adeus, Capitão. [mc]!"

# game/chapters/chapter1/script/ch1sc2.rpy:268
translate brazil ch1sc2_3c6657c9:

#   mc "Captain... I like the sound of that! Captain [mc] and Captain Alice heh! We'll be sailing the black seas in no time!"
    mc "Capitão... Gostei disso! Capitão [mc] E a Capitã Alice, hein! Em pouco tempo estaremos navegando pelos mares negros!"

# game/chapters/chapter1/script/ch1sc2.rpy:270
translate brazil ch1sc2_c4c5f9a7:

#   al "Please, did you already forget how it went with the raft you built last summer?"
    al "Por favor, você já se esqueceu de como foi a experiência com a jangada que você construiu no verão passado?"

# game/chapters/chapter1/script/ch1sc2.rpy:272
translate brazil ch1sc2_3a0555b5:

#   al "It didn’t even make it across the lake!"
    al "Nem sequer conseguiu atravessar o lago!"

# game/chapters/chapter1/script/ch1sc2.rpy:273
translate brazil ch1sc2_a83989fe:

#   al "You and Flynn almost drowned halfway across.."
    al "Você e Flynn quase se afogaram no meio do caminho..."

# game/chapters/chapter1/script/ch1sc2.rpy:275
translate brazil ch1sc2_d5afd6e4:

#   mc "Okay, okay. I admit it wasn’t my best idea. But it would have worked if it wasn’t for Flynn and his oversized ass!"
    mc "Tá bem, tá bem. Admito que não foi a minha melhor ideia. Mas teria funcionado se não fosse pelo Flynn e sua bunda enorme!"

# game/chapters/chapter1/script/ch1sc2.rpy:277
translate brazil ch1sc2_75305d36:

#   mc "What was he thinking, that my tiny raft was suddenly going to hold three people?"
    mc "O que ele estava pensando, que minha pequena jangada de repente ia comportar três pessoas?"

# game/chapters/chapter1/script/ch1sc2.rpy:279
translate brazil ch1sc2_d7650bd0:

#   al "Silly! You know how excited he gets about anything to do with boats and pirates and the like!"
    al "Que bobagem! Você sabe o quanto ele fica empolgado com tudo que tem a ver com barcos, piratas e coisas do tipo!"

# game/chapters/chapter1/script/ch1sc2.rpy:280
translate brazil ch1sc2_a07b4983:

#   "You and Alice both laugh, remembering how excited Flynn was even as the raft was sinking."
    "Você e Alice riem, lembrando-se da empolgação de Flynn mesmo quando a jangada estava afundando."

# game/chapters/chapter1/script/ch1sc2.rpy:282
translate brazil ch1sc2_bc178336:

#   al "Sooo... did your parents give you a present yet?"
    al "E aí... seus pais já te deram um presente?"

# game/chapters/chapter1/script/ch1sc2.rpy:284
translate brazil ch1sc2_bbac6fe9:

#   mc "No, not yet. I guess I'll get it later today."
    mc "Não, ainda não. Acho que recebo mais tarde hoje."

# game/chapters/chapter1/script/ch1sc2.rpy:286
translate brazil ch1sc2_87d4aae4:

#   al "I’m sure they will get you something nice!"
    al "Tenho certeza que eles vão te dar algo legal!"

# game/chapters/chapter1/script/ch1sc2.rpy:288
translate brazil ch1sc2_8c0cf098:

#   mc "I wish they'd get me a sword... then I could start doing some combat and defense training to become an adventurer!"
    mc "Quem me dera me dessem uma espada... aí eu poderia começar a treinar combate e defesa para me tornar um aventureiro!"

# game/chapters/chapter1/script/ch1sc2.rpy:290
translate brazil ch1sc2_4ee1c13d:

#   al "Woah! That would be so fun! Then we could go exploring like we do now, but all over Midomir!"
    al "Uau! Isso seria muito divertido! Aí poderíamos explorar como fazemos agora, mas por todo Midomir!"

# game/chapters/chapter1/script/ch1sc2.rpy:292
translate brazil ch1sc2_6dabfd70:

#   al "And you could beat up any bandits or outlaws who tries to steal our treasures!"
    al "E você poderia derrotar qualquer bandido ou fora da lei que tentasse roubar nossos tesouros!"

# game/chapters/chapter1/script/ch1sc2.rpy:294
translate brazil ch1sc2_0856b2fc:

#   mc "That’s right! We could visit all the exciting places! Like Whitefalls near Cloudrock, or the capital, Luxenford!"
    mc "Isso mesmo! Poderíamos visitar todos esses lugares incríveis! Como Whitefalls perto de Cloudrock, ou a capital, Luxemburgo!"

# game/chapters/chapter1/script/ch1sc2.rpy:296
translate brazil ch1sc2_fcc6e7e9:

#   al "And we would meet lots of interesting people. Like... Knights! Or Mermaids! Or, or... or the King!"
    al "E conheceríamos muitas pessoas interessantes. Como... Cavaleiros! Ou Sereias! Ou, ou... ou o Rei!"

# game/chapters/chapter1/script/ch1sc2.rpy:298
translate brazil ch1sc2_6c115484:

#   mc "Don’t forget about outlaws and goblins and trolls... and witches!"
    mc "Não se esqueçam dos foras da lei, dos goblins, dos trolls... e das bruxas!"

# game/chapters/chapter1/script/ch1sc2.rpy:300
translate brazil ch1sc2_667146ac:

#   al "Huuuuh! Those things don’t exist, do they?"
    al "Huuuuh! Essas coisas não existem, né?"

# game/chapters/chapter1/script/ch1sc2.rpy:301
translate brazil ch1sc2_0ef210f3:

#   al "I mean outlaws, sure... B-but trolls?!"
    al "Quero dizer, foras da lei, claro... M-mas e trolls?!"

# game/chapters/chapter1/script/ch1sc2.rpy:303
translate brazil ch1sc2_7c228dbe:

#   mc "Don’t worry, Alice. If we meet any trolls I will protect you!"
    mc "Não se preocupe, Alice. Se encontrarmos algum troll, eu a protegerei!"

# game/chapters/chapter1/script/ch1sc2.rpy:305
translate brazil ch1sc2_76fe5bdd:

#   al "You promise you’ll always protect me?"
    al "Você promete que sempre me protegerá?"

# game/chapters/chapter1/script/ch1sc2.rpy:307
translate brazil ch1sc2_32ca8ede:

#   mc "I promise Alice, always and forever."
    mc "Eu prometo à Alice, sempre e para sempre."

# game/chapters/chapter1/script/ch1sc2.rpy:308
translate brazil ch1sc2_ca6804d7:

#   mc "No bandit or smelly old troll is ever going to harm you, Alice."
    mc "Nenhum bandido ou troll fedorento jamais vai te machucar, Alice."

# game/chapters/chapter1/script/ch1sc2.rpy:310
translate brazil ch1sc2_c3a69835:

#   mct "She has such a pure heart. I'll do my best to protect it."
    mct "Ela tem um coração tão puro. Farei o meu melhor para protegê-lo."

# game/chapters/chapter1/script/ch1sc2.rpy:312
translate brazil ch1sc2_2fcb74ab:

#   "Almost as if Alice heard your thoughts, she wraps her arms around you, squeezing you tightly."
    "Quase como se Alice tivesse lido seus pensamentos, ela te envolve em seus braços, apertando-te com força."

# game/chapters/chapter1/script/ch1sc2.rpy:313
translate brazil ch1sc2_1b23fb09:

#   "You can tell that your promise means the world to her."
    "Dá para perceber que sua promessa significa tudo para ela."

# game/chapters/chapter1/script/ch1sc2.rpy:315
translate brazil ch1sc2_bcdc46e0:

#   al "*Soft voice* Always and forever."
    al "*Voz suave* Sempre e para sempre."

# game/chapters/chapter1/script/ch1sc2.rpy:317
translate brazil ch1sc2_4b023769:

#   al_t "It feels like nothing can hurt me when he’s around."
    al_t "Sinto que nada pode me machucar quando ele está por perto."

# game/chapters/chapter1/script/ch1sc2.rpy:318
translate brazil ch1sc2_56b4264f:

#   al_t "I wish we could stay like this all day."
    al_t "Eu queria que pudéssemos ficar assim o dia todo."

# game/chapters/chapter1/script/ch1sc2.rpy:319
translate brazil ch1sc2_a1e7487f:

#   mc "Alright, let’s continue our adventure."
    mc "Muito bem, vamos continuar nossa aventura."

# game/chapters/chapter1/script/ch1sc2.rpy:321
translate brazil ch1sc2_4f66ae33:

#   al "Sure! Today we’ll find something interesting! I can feel it!"
    al "Claro! Hoje vamos encontrar algo interessante! Eu sinto isso!"

# game/chapters/chapter1/script/ch1sc2.rpy:322
translate brazil ch1sc2_09081286:

#   mc "That's the spirit Alice!"
    mc "É isso aí, Alice!"

# game/chapters/chapter1/script/ch1sc2.rpy:324
translate brazil ch1sc2_c26dd333:

#   "You and Alice begin exploring further into the nearby woods, chatting about everything you find between the grass and the clouds."
    "Você e Alice começam a explorar mais a fundo a floresta próxima, conversando sobre tudo o que encontram entre a grama e as nuvens."

# game/chapters/chapter1/script/ch1sc2.rpy:335
translate brazil ch1sc2_4512e10f:

#   "Gibson's Trust has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "O Gibson's Trust aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter1/script/ch1sc2.rpy:336
translate brazil ch1sc2_c3278a67:

#   pa "Oh, Son. Are you sure you want to run errands with your old man on your birthday?"
    pa "Oh, filho. Tem certeza de que quer fazer compras com seu pai no seu aniversário?"

# game/chapters/chapter1/script/ch1sc2.rpy:338
translate brazil ch1sc2_969d760c:

#   mct "I kinda want to go with Alice and have fun ... but I have to show Papa I'm grown up. Perhaps then he'll let me have a sword!"
    mct "Eu até que queria ir com a Alice e me divertir... mas preciso mostrar para o papai que já sou crescida. Quem sabe assim ele me deixa ter uma espada!"

# game/chapters/chapter1/script/ch1sc2.rpy:339
translate brazil ch1sc2_4d1c053a:

#   mct "Besides, it's been a while since I last saw Gibson."
    mct "Além disso, já faz um tempo desde a última vez que vi Gibson."

# game/chapters/chapter1/script/ch1sc2.rpy:341
translate brazil ch1sc2_2eb5fcb2:

#   mc "I'm sure, Papa. I’m old enough to start learning about these things. Besides, Gibson is funny!"
    mc "Tenho certeza, papai. Já tenho idade suficiente para começar a aprender sobre essas coisas. Além disso, o Gibson é engraçado!"

# game/chapters/chapter1/script/ch1sc2.rpy:343
translate brazil ch1sc2_0b90fee3:

#   pa "Ha! You only think that because he’s not making fun of you!"
    pa "Ah! Você só pensa isso porque ele não está zombando de você!"

# game/chapters/chapter1/script/ch1sc2.rpy:344
translate brazil ch1sc2_1de225ae:

#   mc "Guilty! Hey, Papa?"
    mc "Culpado! Ei, papai?"

# game/chapters/chapter1/script/ch1sc2.rpy:345
translate brazil ch1sc2_86c22016:

#   pa "Yes, Son?"
    pa "Sim, filho?"

# game/chapters/chapter1/script/ch1sc2.rpy:346
translate brazil ch1sc2_d5148028:

#   mc "What did you want to be when you were my age?"
    mc "O que você queria ser quando tivesse a minha idade?"

# game/chapters/chapter1/script/ch1sc2.rpy:347
translate brazil ch1sc2_6eb6909c:

#   pa "Ha, easy! I always wanted to build things with my hands, even as a wee little runt. Anytime I could help my father build things, I did."
    pa "Ah, fácil! Eu sempre quis construir coisas com as minhas mãos, mesmo quando era bem pequeno. Sempre que podia ajudar meu pai a construir alguma coisa, eu ajudava."

# game/chapters/chapter1/script/ch1sc2.rpy:348
translate brazil ch1sc2_5d5636b4:

#   mc "I see... Thanks, Papa."
    mc "Entendi... Obrigado, papai."

# game/chapters/chapter1/script/ch1sc2.rpy:349
translate brazil ch1sc2_1321e3ae:

#   pa "Alright, alright, Son. Let's go meet up with Gibson."
    pa "Muito bem, muito bem, filho. Vamos encontrar o Gibson."

# game/chapters/chapter1/script/ch1sc2.rpy:352
translate brazil ch1sc2_45800655:

#   "After walking a short distance down the road, you arrive at Gibson's workshop."
    "Após caminhar um pouco pela estrada, você chega à oficina de Gibson."

# game/chapters/chapter1/script/ch1sc2.rpy:353
translate brazil ch1sc2_e152a118:

#   mc "Do you think he’ll be here this early?"
    mc "Você acha que ele chegará tão cedo?"

# game/chapters/chapter1/script/ch1sc2.rpy:355
translate brazil ch1sc2_30d8fb84:

#   pa "Only one way to find out..."
    pa "Só há uma maneira de descobrir..."

# game/chapters/chapter1/script/ch1sc2.rpy:357
translate brazil ch1sc2_97d2eb98:

#   pa "Hey Gibson!! Are you up yet, you old buffoon?!"
    pa "Ei, Gibson!! Já acordou, seu velho bobo?!"

# game/chapters/chapter1/script/ch1sc2.rpy:359
translate brazil ch1sc2_31bec1f3:

#   mc "Gibson! Are you home?"
    mc "Gibson! Você está em casa?"

# game/chapters/chapter1/script/ch1sc2.rpy:361
translate brazil ch1sc2_0fcbc72e:

#   "Gibson appears at the door."
    "Gibson aparece à porta."

# game/chapters/chapter1/script/ch1sc2.rpy:362
translate brazil ch1sc2_2eab3f64:

#   mc "Hey Gibs! There you are!"
    mc "Ei, Gibs! Aí está você!"

# game/chapters/chapter1/script/ch1sc2.rpy:364
translate brazil ch1sc2_13be3031:

#   gb "Well, well. If it isn’t the birthday boy and his witty excuse of a father!"
    gb "Ora, ora! Se não é o aniversariante e seu pai, que se diz muito espirituoso!"

# game/chapters/chapter1/script/ch1sc2.rpy:366
translate brazil ch1sc2_23f9cff8:

#   pa "At least I am a father... you old dog!"
    pa "Ao menos eu sou pai... seu velho safado!"

# game/chapters/chapter1/script/ch1sc2.rpy:367
translate brazil ch1sc2_0ed151bf:

#   "They both burst into laughter at their bad insults."
    "Ambos caíram na gargalhada com os insultos de mau gosto que haviam trocado."

# game/chapters/chapter1/script/ch1sc2.rpy:368
translate brazil ch1sc2_7dcffbc5:

#   gb "It's good to see you, old friend."
    gb "É bom te ver, velho amigo."

# game/chapters/chapter1/script/ch1sc2.rpy:369
translate brazil ch1sc2_caa16366:

#   pa "Likewise Gibson."
    pa "Igualmente Gibson."

# game/chapters/chapter1/script/ch1sc2.rpy:371
translate brazil ch1sc2_692b1e2e:

#   mct "Gibson is always so friendly. He's been friends with my parents for many years and he’s like an uncle to me."
    mct "Gibson é sempre muito simpático. Ele é amigo dos meus pais há muitos anos e é como um tio para mim."

# game/chapters/chapter1/script/ch1sc2.rpy:373
translate brazil ch1sc2_42f1415e:

#   gb "So what brings you fellas by this morning?"
    gb "Então, o que traz vocês aqui esta manhã?"

# game/chapters/chapter1/script/ch1sc2.rpy:374
translate brazil ch1sc2_f52f1109:

#   gb "I assume it's not just the glory of my company?"
    gb "Imagino que não seja apenas a glória da minha empresa?"

# game/chapters/chapter1/script/ch1sc2.rpy:376
translate brazil ch1sc2_f6ff188a:

#   mc "Nothing special, Gibs. Just wanted to see how you were doing!"
    mc "Nada de especial, Gibs. Só queria saber como você estava!"

# game/chapters/chapter1/script/ch1sc2.rpy:378
translate brazil ch1sc2_baeaf429:

#   "The three of you head inside Gibson's workshop."
    "Vocês três entram na oficina de Gibson."

# game/chapters/chapter1/script/ch1sc2.rpy:380
translate brazil ch1sc2_46745248:

#   pa "[mc] is tagging along for my errands today. Tomorrow he'll start learning my trade."
    pa "[mc] Ele está me acompanhando nos meus afazeres hoje. Amanhã ele começará a aprender o meu ofício."

# game/chapters/chapter1/script/ch1sc2.rpy:382
translate brazil ch1sc2_01aefc22:

#   gb "Ahh, I see. He’s certainly old enough now!"
    gb "Ah, entendi. Ele já tem idade suficiente!"

# game/chapters/chapter1/script/ch1sc2.rpy:383
translate brazil ch1sc2_b6cbd905:

#   gb "By the way, could you take a look at my forge? It's been acting up lately."
    gb "A propósito, você poderia dar uma olhada na minha forja? Ela anda apresentando problemas ultimamente."

# game/chapters/chapter1/script/ch1sc2.rpy:385
translate brazil ch1sc2_28de9097:

#   pa "Oh, sure thing. Let me have a look."
    pa "Ah, claro. Deixe-me dar uma olhada."

# game/chapters/chapter1/script/ch1sc2.rpy:387
translate brazil ch1sc2_b318da67:

#   gb "Thanks pal! You’re a lifesaver. Can’t tell you how many times Gunthar has bothered me..."
    gb "Valeu, cara! Você me salvou. Nem consigo te dizer quantas vezes o Gunthar me encheu o saco..."

# game/chapters/chapter1/script/ch1sc2.rpy:388
translate brazil ch1sc2_47e5bdd2:

#   gb "... about his damned horseshoes not being ready."
    gb "... sobre as malditas ferraduras dele não estarem prontas."

# game/chapters/chapter1/script/ch1sc2.rpy:390
translate brazil ch1sc2_c1751f1e:

#   "Papa checks on the forge."
    "Papai verifica a forja."

# game/chapters/chapter1/script/ch1sc2.rpy:391
translate brazil ch1sc2_bbc7a93d:

#   pa "Hmm, with a little adjusting the forge and anvil should be in top shape."
    pa "Hum, com alguns ajustes, a forja e a bigorna devem ficar em perfeitas condições."

# game/chapters/chapter1/script/ch1sc2.rpy:393
translate brazil ch1sc2_575b0608:

#   gb "Hey kid, since it’s your birthday, is there anything you want me to craft for you?"
    gb "Ei, garoto(a), já que é seu aniversário, tem alguma coisa que você queira que eu faça para você?"

# game/chapters/chapter1/script/ch1sc2.rpy:394
translate brazil ch1sc2_62127fa4:

#   mc "Yes! Could you craft a sword for me?"
    mc "Sim! Você poderia forjar uma espada para mim?"

# game/chapters/chapter1/script/ch1sc2.rpy:396
translate brazil ch1sc2_6c19356e:

#   mc "I’ve heard many stories about the legendary blacksmith from Whitefalls!"
    mc "Já ouvi muitas histórias sobre o lendário ferreiro de Whitefalls!"

# game/chapters/chapter1/script/ch1sc2.rpy:397
translate brazil ch1sc2_c09d4631:

#   gb "Ha! Sorry kid, I haven't been smithing any swords lately. Things have been peaceful these last few summers. I'm mostly making nails and tools now."
    gb "Ah! Desculpe, garoto, não tenho forjado espadas ultimamente. As coisas têm estado tranquilas nestes últimos verões. Agora estou me dedicando mais a fazer pregos e ferramentas."

# game/chapters/chapter1/script/ch1sc2.rpy:399
translate brazil ch1sc2_0699dacf:

#   mct "Damn! Looks like I won’t get my hands on a sword today."
    mct "Droga! Parece que não vou conseguir uma espada hoje."

# game/chapters/chapter1/script/ch1sc2.rpy:401
translate brazil ch1sc2_ec00cf03:

#   mc "Papa, I’ll wait outside."
    mc "Papai, vou esperar lá fora."

# game/chapters/chapter1/script/ch1sc2.rpy:402
translate brazil ch1sc2_8b595d72:

#   pa "I’ll be out soon, I'm almost done fixing the forge."
    pa "Já vou sair, estou quase terminando de consertar a forja."

# game/chapters/chapter1/script/ch1sc2.rpy:404
translate brazil ch1sc2_43c3c7d1:

#   mct "Hm, I hope he doesn’t take long. I don’t want to spend all day waiting around for Papa."
    mct "Hum, espero que ele não demore. Não quero passar o dia todo esperando o papai."

# game/chapters/chapter1/script/ch1sc2.rpy:406
translate brazil ch1sc2_b602ec6a:

#   mct "I hope Alice still wants to go exploring. I can't wait til we grow up and travel the world..."
    mct "Espero que Alice ainda queira explorar o mundo. Mal posso esperar para crescermos e viajarmos juntas..."

# game/chapters/chapter1/script/ch1sc2.rpy:407
translate brazil ch1sc2_c4a95e94:

#   mct "We’ll become famous adventurers for sure!"
    mct "Com certeza nos tornaremos aventureiros famosos!"

# game/chapters/chapter1/script/ch1sc2.rpy:409
translate brazil ch1sc2_f35ce0a7:

#   pa "All done! Are you ready to head to the market?"
    pa "Tudo pronto! Você está pronto para ir ao mercado?"

# game/chapters/chapter1/script/ch1sc2.rpy:411
translate brazil ch1sc2_9721a4ec:

#   "You notice Alice walking by..."
    "Você percebe Alice passando..."

# game/chapters/chapter1/script/ch1sc2.rpy:415
translate brazil ch1sc2_07f8f65d:

#   al "Hi guys!"
    al "Oi, pessoal!"

# game/chapters/chapter1/script/ch1sc2.rpy:417
translate brazil ch1sc2_1727970d:

#   pa "*Sigh* Son, why don’t you go have fun with Alice? I’m going to stay and catch up with Gibson."
    pa "*Suspiro* Filho, por que você não vai se divertir com a Alice? Eu vou ficar aqui e conversar com o Gibson."

# game/chapters/chapter1/script/ch1sc2.rpy:418
translate brazil ch1sc2_1f894118:

#   pa "I’ll start teaching you how to work a hammer tomorrow."
    pa "Amanhã começarei a te ensinar a usar um martelo."

# game/chapters/chapter1/script/ch1sc2.rpy:420
translate brazil ch1sc2_a84f0e1b:

#   mc "Yes!!"
    mc "Sim!!"

# game/chapters/chapter1/script/ch1sc2.rpy:422
translate brazil ch1sc2_d39887e9:

#   mc "Err, I mean, sure Papa... If you insist."
    mc "Hum, quer dizer, claro, papai... Se o senhor insiste."

# game/chapters/chapter1/script/ch1sc2.rpy:424
translate brazil ch1sc2_f00e3fde:

#   pat "*Chuckles* Ha! He couldn’t contain his excitement. It’s good to see him like this... happy."
    pat "*Risos* Ha! Ele não conseguiu conter a empolgação. É bom vê-lo assim... feliz."

# game/chapters/chapter1/script/ch1sc2.rpy:426
translate brazil ch1sc2_d44c895e:

#   mct "Yes! Now I can go exploring with Alice."
    mct "Sim! Agora posso ir explorar com a Alice."

# game/chapters/chapter1/script/ch1sc2.rpy:428
translate brazil ch1sc2_add3ce1f:

#   pat "Heh, those two are such good kids. They've been inseparable for a few summers now, almost like siblings."
    pat "Hehe, esses dois são crianças tão boas. Eles têm sido inseparáveis ​​por alguns verões, quase como irmãos."

# game/chapters/chapter1/script/ch1sc2.rpy:429
translate brazil ch1sc2_19804e12:

#   mc "Hey Alice! Wait up! I'm free now."
    mc "Ei, Alice! Espere! Estou livre agora."

# game/chapters/chapter1/script/ch1sc2.rpy:431
translate brazil ch1sc2_39abd0fc:

#   al "Really? Yay! Come, come! Lets go already!"
    al "Sério? Oba! Vamos, vamos! Vamos logo!"

# game/chapters/chapter1/script/ch1sc2.rpy:434
translate brazil ch1sc2_0eaf0622:

#   "You and Alice run off to the nearby woods..."
    "Você e Alice fogem para a floresta próxima..."

# game/chapters/chapter1/script/ch1sc2.rpy:157
translate brazil ch1sc2_cb16be87_1:

#   pa "..."
    pa "..."

# game/chapters/chapter1/script/ch1sc2.rpy:187
translate brazil ch1sc2_a20cefa7_1:

#   "..."
    "..."

# game/chapters/chapter1/script/ch1sc2.rpy:413
translate brazil ch1sc2_a20cefa7_2:

#   "..."
    "..."

