    el "Então... Mnhh, bom! MNh! Hnh! *Sucção*"

# game/chapters/chapter5/script/ch5sc10.rpy:135
translate brazil ch5sc10_a9787555:

#   mc "*Moans* Damn... Mnhh... You’re relentless!"
    mc "*Gemidos* Droga... Mnhh... Você é implacável!"

# game/chapters/chapter5/script/ch5sc10.rpy:136
translate brazil ch5sc10_357a0cbf:

#   el "*Moans* Mnhh... Not shtoppingh. *Suck* Not until... Mhhh... you feed me... Hnngh! Every. Last. Droppph. Mnhh!"
    el "*Gemidos* Mnhh... Não vou parar. *Sucção* Só quando... Mhhh... você me alimentar... Hnngh! Até a última gota. Mnhh!"

# game/chapters/chapter5/script/ch5sc10.rpy:137
translate brazil ch5sc10_ada8b958:

#   mc "*Moans* You little... Ahnhh ... she-devil. Mnhh. Eliza... I’m-"
    mc "*Gemidos* Sua pequena... Ahnhh... diabinha. Mnhh. Eliza... Eu estou-"

# game/chapters/chapter5/script/ch5sc10.rpy:139
translate brazil ch5sc10_ac1e8eb1:

#   el "*Sucks harder* Yes! MNhh... Fill my mouth! *Sucks* Mh! Fill me up! I want to taste your delicious cum! MH!"
