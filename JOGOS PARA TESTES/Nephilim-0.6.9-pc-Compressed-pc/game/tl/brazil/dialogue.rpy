# game/chapters/chapter5/script/ch5sc12.rpy:140
translate brazil ch5sc12_40ec6e2b:

#   bn "Hah! Get a load of this guy! Charming his way through breakfast. What’s next, [mc]?"
    bn "Hah! Olha só esse cara! Encantando todo mundo no café da manhã. O que será que vem depois? [mc]?"

# game/chapters/chapter5/script/ch5sc12.rpy:141
translate brazil ch5sc12_f6ce62d6:

#   bn "Do you plan to run off with my wife and daughter, and add them to your harem? *Chuckles*"
    bn "Você planeja fugir com minha esposa e minha filha e adicioná-las ao seu harém? *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:144
