#   lu "Yay! Thank you mom!"
    lu "Eba! Obrigada, mãe!"

# game/chapters/chapter7/ch7sc9.rpy:1035
translate brazil ch7sc9_49c8def0:

#   lu "We won’t attack with lethal force obviously, but I really want to knock him on his butt!"
    lu "Obviamente não vamos atacar com força letal, mas eu realmente quero derrubá-lo!"

