    mct "{i}*Suspiro* Assim que começamos a progredir... dois passos para trás.{/i}"

# game/chapters/chapter6/ch6sc4.rpy:4316
translate brazil ch6sc4_c2b9afb4:

#   mct "{i}But I can understand why she’s fearful, this Scriptorium sounds like they don’t mess around.{/i}"
