# game/chapters/chapter5/script/ch5sc14.rpy:2913
translate brazil ch5sc14_03d15f8f:

#   ki "It’s our only option. Bring Kelly and Pedro up to speed while I prepare the rowboats."
    ki "É a nossa única opção. Coloque Kelly e Pedro a par da situação enquanto eu preparo os barcos a remo."

# game/chapters/chapter5/script/ch5sc14.rpy:2922
