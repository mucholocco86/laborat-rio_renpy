translate brazil ch2sc19_nz_025bda09:

#   elt "He makes me feel so reassured with just a single touch..."
    elt "Ele me transmite tanta segurança com um simples toque..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:433
translate brazil ch2sc19_nz_5435eba8:

#   el "You know..."
    el "Você sabe..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:434
translate brazil ch2sc19_nz_fc504a43:

#   el "You didn’t have to put back on your shirt for my sake."
    el "Você não precisava vestir a camisa de novo por minha causa."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:436
translate brazil ch2sc19_nz_b1ac94f7:

#   mc "Yeah, sure."
    mc "Sim, claro."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:437
translate brazil ch2sc19_nz_f429e858:

#   mc "*Chuckles* Let me just freeze to death after nearly dying."
    mc "*Risos* Deixa eu congelar até a morte depois de quase morrer."

