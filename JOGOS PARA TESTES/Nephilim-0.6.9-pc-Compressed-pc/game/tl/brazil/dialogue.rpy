translate brazil ch7sc9_2a1a485c:

#   mc "Hey… you okay?"
    mc "Ei... você está bem?"

# game/chapters/chapter7/ch7sc9.rpy:1013
translate brazil ch7sc9_8323e79d:

#   lu "[mc]...?"
    lu "[mc]...?"

