# game/chapters/chapter5/script/ch5sc12.rpy:49
translate brazil ch5sc12_12abe5b0:

#   mc "My cousin is actually working on the case."
    mc "Meu primo está trabalhando no caso."

# game/chapters/chapter5/script/ch5sc12.rpy:51
translate brazil ch5sc12_2edd67a6:

#   am "No offense, but it seems he’s doing a piss-poor job of it!"
