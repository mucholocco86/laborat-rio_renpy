translate brazil ch5sc2_34b60347:

#   mc "Woah, Sylph. One, two, three, six... eighteen? Eighteen silver coins?"
    mc "Uau, Sylph. Um, dois, três, seis... dezoito? Dezoito moedas de prata?"

# game/chapters/chapter5/script/ch5sc2.rpy:3034
