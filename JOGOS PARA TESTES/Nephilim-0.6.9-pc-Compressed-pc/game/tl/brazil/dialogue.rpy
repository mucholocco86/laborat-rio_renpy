translate brazil ch3sc28_2af74d79:

#   el "Who the hell are you?!"
    el "Quem diabos é você?!"

# game/chapters/chapter3/script/ch3sc28.rpy:23
translate brazil ch3sc28_2dc3447b:

#   el "Why am I in here?!"
    el "Por que estou aqui?!"

# game/chapters/chapter3/script/ch3sc28.rpy:25
translate brazil ch3sc28_16e82824:

#   ta "I have my reasons."
    ta "Tenho meus motivos."

# game/chapters/chapter3/script/ch3sc28.rpy:26
translate brazil ch3sc28_0864ec01:

#   ta "None of which a dumb little peasant girl, like you, would understand."
    ta "Nada disso uma camponesa tola como você entenderia."

# game/chapters/chapter3/script/ch3sc28.rpy:29
translate brazil ch3sc28_089980e7:

#   el "*Shouts* {b}I don’t even know you! Let me go!!{/b}"
    el "*Gritos* {b} Eu nem te conheço! Me solta!!{/b}"

