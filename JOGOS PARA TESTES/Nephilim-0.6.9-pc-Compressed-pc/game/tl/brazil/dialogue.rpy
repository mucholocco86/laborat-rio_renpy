#   ro "Mmm..."
    ro "Hum..."

# game/chapters/chapter5/script/ch5sc09.rpy:162
translate brazil ch5sc09_9699ad36:

#   ro "I'll have to make an appointment at the palace bathhouse."
    ro "Vou ter que marcar uma consulta no balneário do palácio."

# game/chapters/chapter5/script/ch5sc09.rpy:163
translate brazil ch5sc09_af8409fe:

#   ro "Running the guild is giving me a stiff back..."
    ro "Administrar a guilda está me dando dor nas costas..."

# game/chapters/chapter5/script/ch5sc09.rpy:165
translate brazil ch5sc09_4be26c11:

#   ro "At least they'll have to jump me to the head of the queue now that I'm a guildleader."
    ro "Pelo menos agora que sou líder de guilda, eles vão ter que me passar a frente na fila."

# game/chapters/chapter5/script/ch5sc09.rpy:171
translate brazil ch5sc09_04123740:

#   ro "Hmh? I could've sworn... *Sighs* I really do need a vacation."
    ro "Hum? Eu juraria que... *Suspiro* Eu realmente preciso de férias."

# game/chapters/chapter5/script/ch5sc09.rpy:174
translate brazil ch5sc09_8a7daff5:

#   lut "{i}Finally, the old hag is gone!{/i}"
    lut "{i}Finalmente, a velha bruxa se foi!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:175
translate brazil ch5sc09_f40dcfc9:

#   lut "{i}I have to be quick about this. If I’m caught, she might put a hex on me too.{/i}"
    lut "{i}Preciso ser rápida. Se me pegarem, ela pode me amaldiçoar também.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:177
translate brazil ch5sc09_83546300:

#   lut "{i}I still can’t believe it was Rose who hexed Mother. But I won’t let her get away with it!{/i}"
    lut "{i}Ainda não consigo acreditar que foi Rose quem enfeitiçou minha mãe. Mas não vou deixar ela sair impune!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:178
translate brazil ch5sc09_f882a07d:

#   lut "{i}Looks like it’s all clear.{/i}"
    lut "{i}Parece que está tudo resolvido.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:186
translate brazil ch5sc09_bd9e7a4e:

#   lut "{i}Okay... Let’s see what she’s been hiding.{/i}"
    lut "{i}Ok... Vamos ver o que ela está escondendo.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:187
translate brazil ch5sc09_c8f3fb76:

#   lut "{i}The hex she used on mother has to be in one of these books...{/i}"
    lut "{i}O feitiço que ela usou na mãe deve estar em um desses livros...{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:189
translate brazil ch5sc09_5773a758:

#   lut "{i}Ishai, deli, atuh!{/i}"
    lut "{i}Ishai, delicate, atuh!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:190
translate brazil ch5sc09_9d973c26:

#   lut "{i}No, nothing unusual here.{/i}"
    lut "{i}Não, nada de incomum por aqui.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:192
translate brazil ch5sc09_74db73e5:

#   lut "{i}Seekth, Iiha, Lutuh!{/i}"
    lut "{i}Seekth, Iiha, Lutuh!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:193
translate brazil ch5sc09_8f8c9abe:

#   lut "{i}Hmh... Curses... Bindings... Seals... Nope, nothing here either.{/i}"
    lut "{i}Hum... Maldições... Amarras... Selos... Não, nada aqui também.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:195
translate brazil ch5sc09_5264f2f8:

#   lut "{i}Revelio, Dih, Uhn!{/i}"
    lut "{i}Revelio, Dih, Uhn!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:196
translate brazil ch5sc09_87b22efa:

#   lut "{i}Mindwipe incantation... Barrier seals... Hexes... Hexes!! Here!{/i}"
    lut "{i}Encantamento de lavagem cerebral... Selos de barreira... Maldições... Maldições!! Aqui!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:197
translate brazil ch5sc09_3651a473:

#   "*Door opens in the distance*"
    "*Uma porta se abre ao longe*"

# game/chapters/chapter5/script/ch5sc09.rpy:199
translate brazil ch5sc09_8b575071:

#   lut "{i}She’s back!!{/i}"
    lut "{i}Ela voltou!!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:201
translate brazil ch5sc09_8fb02e25:

#   lut "{i}Shucks! There’s nowhere to hide!!{/i}"
    lut "{i}Puxa! Não há onde se esconder!!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:204
translate brazil ch5sc09_6b8e97b0:

#   lut "{i}I’m not here... I’m not here... Just go away you... you... you big-breasted betraying bitch!{/i}"
    lut "{i}Eu não estou aqui... Eu não estou aqui... Vá embora, sua... sua... sua vadia traidora de peitões!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:205
translate brazil ch5sc09_26afe318:

#   ro "Luna? *Sighs* I’m disappointed in you."
    ro "Luna? *Suspiro* Estou decepcionada com você."

# game/chapters/chapter5/script/ch5sc09.rpy:208
translate brazil ch5sc09_3d64da19:

#   lu "The fuck you are?! You hexed my mother!"
    lu "Quem você pensa que é?! Você enfeitiçou minha mãe!"

# game/chapters/chapter5/script/ch5sc09.rpy:209
translate brazil ch5sc09_5a21c5ef:

#   ro "You have no proof of that. So let’s skip the accusations."
    ro "Você não tem provas disso. Então, vamos deixar as acusações de lado."

# game/chapters/chapter5/script/ch5sc09.rpy:210
translate brazil ch5sc09_d75768b6:

#   ro "Now, scurry away. I have business to take care of."
    ro "Agora, vá embora. Tenho assuntos a tratar."

# game/chapters/chapter5/script/ch5sc09.rpy:213
translate brazil ch5sc09_9826d5cc:

#   lu "I’m not leaving without answers! She’s suffering!"
    lu "Não vou embora sem respostas! Ela está sofrendo!"

# game/chapters/chapter5/script/ch5sc09.rpy:215
translate brazil ch5sc09_95c7d350:

#   ro "Luna, darling. Stop meddling in affairs which don't concern you."
    ro "Luna, querida. Pare de se intrometer em assuntos que não lhe dizem respeito."

# game/chapters/chapter5/script/ch5sc09.rpy:217
translate brazil ch5sc09_62403e8b:

#   ro "You’re nothing but a child. Leave this to the grown-ups."
    ro "Você não passa de uma criança. Deixe isso para os adultos."

# game/chapters/chapter5/script/ch5sc09.rpy:219
translate brazil ch5sc09_39192a6c:

#   lu "I’m not a child!! I’m an adult. And {b}THIS{/b} does concern me. It’s my mother we’re talking about!"
    lu "Eu não sou criança!! Sou adulto. E {b} ESSE{/b} Isso me preocupa. Estamos falando da minha mãe!"

# game/chapters/chapter5/script/ch5sc09.rpy:220
translate brazil ch5sc09_ac50c709:

#   lu "You know... the woman who's been {b}YOUR{/b} best friend for years? Who's also {b}YOUR{/b} leader!"
    lu "Sabe... a mulher que tem sido {b} SEU{/b} melhor amiga há anos? Que também é {b} SEU{/b} líder!"

# game/chapters/chapter5/script/ch5sc09.rpy:223
translate brazil ch5sc09_dd1ca039:

#   ro "You need to leave this be. I’m telling you this for your own good."
    ro "Você precisa deixar isso para lá. Estou lhe dizendo isso para o seu próprio bem."

# game/chapters/chapter5/script/ch5sc09.rpy:225
translate brazil ch5sc09_ed3464cd:

#   lu "*Scoffs* My own good?! I’m already knee deep in shit and worries!"
    lu "*Risos* Meu próprio bem?! Já estou atolado até o pescoço em problemas e preocupações!"

# game/chapters/chapter5/script/ch5sc09.rpy:226
translate brazil ch5sc09_9e6fdf82:

#   lu "Rose, this is my final warning. If you don’t release Mother, I’ll... You won't like what I’ll do!"
    lu "Rose, este é meu último aviso. Se você não libertar a Mãe, eu... Você não vai gostar do que eu vou fazer!"

# game/chapters/chapter5/script/ch5sc09.rpy:228
translate brazil ch5sc09_528fdc51:

#   ro "Lift the curse on Taron’s blade, and he will release your mother. He gave me his word."
    ro "Remova a maldição da lâmina de Taron, e ele libertará sua mãe. Ele me deu a sua palavra."

# game/chapters/chapter5/script/ch5sc09.rpy:230
translate brazil ch5sc09_33301814:

#   lu "Are you really that naive?! He'll do no such thing. She knows who he is, and so do I."
    lu "Você é mesmo tão ingênua?! Ele jamais faria uma coisa dessas. Ela sabe quem ele é, e eu também."

# game/chapters/chapter5/script/ch5sc09.rpy:231
translate brazil ch5sc09_dba2bb31:

#   lu "There’s zero, {b}ZERO{/b} chance we’ll walk away alive if he gets what he wants."
    lu "Não há nenhum. {b} ZERO{/b} Temos alguma chance de sair vivos se ele conseguir o que quer."

# game/chapters/chapter5/script/ch5sc09.rpy:233
translate brazil ch5sc09_6ce46da6:

#   ro "Once again, you reveal your ignorance. You'll both walk away unharmed as long you do as instructed."
    ro "Mais uma vez, você demonstra sua ignorância. Ambos sairão ilesos, contanto que façam o que foi instruído."

# game/chapters/chapter5/script/ch5sc09.rpy:235
translate brazil ch5sc09_be900be1:

#   ro "Taron is many things. Egotistical... ambitious... self-centered... but he always keeps his word."
    ro "Taron é muitas coisas. Egocêntrico... ambicioso... egocêntrico... mas sempre cumpre sua palavra."

# game/chapters/chapter5/script/ch5sc09.rpy:238
translate brazil ch5sc09_2ad17a60:

#   lu "{b}He’s an unhinged, mother-kidnapping psychopath!{/b} That’s what he is!!"
    lu "{b}Ele é um psicopata desequilibrado que sequestra mães!{/b} É isso que ele é!!"

# game/chapters/chapter5/script/ch5sc09.rpy:240
translate brazil ch5sc09_39d63ed9:

#   ro "I’m not going to argue about this with you. Deliver the sword with the curse lifted..."
    ro "Não vou discutir isso com você. Entregue a espada com a maldição removida..."

# game/chapters/chapter5/script/ch5sc09.rpy:241
translate brazil ch5sc09_f6cd9488:

#   ro "Or remain in your current predicament."
    ro "Ou permaneça na sua situação atual."

# game/chapters/chapter5/script/ch5sc09.rpy:243
translate brazil ch5sc09_c4c7603e:

#   lu "Why are you on {b}HIS{/b} side?! Y-You’re family, Rose! You’ve been around since my feet were tiny!"
    lu "Por que você está em {b} DELE{/b} Do lado?! V-Você é da família, Rose! Você está por perto desde que eu era pezinho!"

# game/chapters/chapter5/script/ch5sc09.rpy:244
translate brazil ch5sc09_a4e5bfd8:

#   lu "Does he have something on you?! Or is this of your own accord?! Just tell me!"
    lu "Ele tem alguma coisa contra você?! Ou você está fazendo isso por conta própria?! Me diga logo!"

# game/chapters/chapter5/script/ch5sc09.rpy:246
translate brazil ch5sc09_6cbcfbe8:

#   ro "It was good seeing you, Luna. Don’t let the door hit you on the way out."
    ro "Foi bom te ver, Luna. Que a porta não te acerte na saída."

# game/chapters/chapter5/script/ch5sc09.rpy:248
translate brazil ch5sc09_2d5b095f:

#   lu "Tsk! I will get to the bottom of this."
    lu "Tsc! Vou descobrir o que está acontecendo."

# game/chapters/chapter5/script/ch5sc09.rpy:256
translate brazil ch5sc09_b9a6b878:

#   elt "{i}I’ll put the firewood near the log over there. It looks like a great spot to have our fire.{/i}"
    elt "{i}Vou colocar a lenha perto daquele tronco ali. Parece um ótimo lugar para fazermos nossa fogueira.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:258
translate brazil ch5sc09_ab18bd81:

#   elt "{i}Decent... but not enough for an all-night campfire.{/i}"
    elt "{i}Razoável... mas não o suficiente para uma fogueira que dure a noite toda.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:260
translate brazil ch5sc09_bd6c78f4:

#   elt "{i}These ones look fat and dry! They’ll burn really well.{/i}"
    elt "{i}Essas parecem bem gordinhas e secas! Vão queimar muito bem.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:262
translate brazil ch5sc09_41a04bec:

#   elt "{i}Hmmm. Still not enough. Not if I want to live up to my title as the best firewood gatherer in all of Midomir!{/i}"
    elt "{i}Hum. Ainda não é suficiente. Não se eu quiser fazer jus ao meu título de melhor coletor de lenha de todo Midomir!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:264
translate brazil ch5sc09_d1f11d8d:

#   elt "{i}I have a reputation to uphold! Better get these ones over here as well.{/i}"
    elt "{i}Tenho uma reputação a zelar! É melhor trazerem esses também.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:266
translate brazil ch5sc09_d4483bd3:

#   elt "{i}[mc] will be impressed! *Giggles* Although... maybe I overdid it just a smidge?{/i}"
    elt "{i}[mc] Vai ficar impressionado! *Risos* Embora... talvez eu tenha exagerado um pouquinho?{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:267
translate brazil ch5sc09_4e262dce:

#   elt "{i}Naaah, that’s crazy talk! One can never have too much wood! ... right?{/i}"
    elt "{i}Não, isso é conversa fiada! Nunca se tem madeira demais! ... né?{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:270
translate brazil ch5sc09_e85d14b2:

#   mct "{i}Just where I left them.{/i}"
    mct "{i}Exatamente onde os deixei.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:271
translate brazil ch5sc09_f3f15f19:

#   mct "{i}I’ll have to remember to pay Borri back. He really came through for us with all these supplies.{/i}"
    mct "{i}Preciso me lembrar de pagar o Borri. Ele realmente nos ajudou muito com todos esses suprimentos.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:273
translate brazil ch5sc09_fcb93970:

#   mct "{i}She says it’s already been the best day she could wish for...{/i}"
    mct "{i}Ela diz que já foi o melhor dia que poderia desejar...{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:274
translate brazil ch5sc09_259a23e0:

#   mct "{i}But she'd better buckle up. 'Cause I made sure not to half-ass this.{/i}"
    mct "{i}Mas é melhor ela se preparar. Porque eu garanti que não farei nada pela metade.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:275
translate brazil ch5sc09_c010a863:

#   mct "{i}After everything she’s been through: first with the transformation, and then the purification...{/i}"
    mct "{i}Depois de tudo o que ela passou: primeiro com a transformação e depois com a purificação...{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:277
translate brazil ch5sc09_0e2afd00:

#   mct "{i}She deserves the best.{/i}"
    mct "{i}Ela merece o melhor.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:278
translate brazil ch5sc09_8a87167f:

#   mct "{i}I’m not gonna lie, seeing her smiling all day has been so uplifting. It even makes me feel...{/i}"
    mct "{i}Não vou mentir, vê-la sorrindo o dia todo foi muito animador. Até me faz sentir...{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:279
translate brazil ch5sc09_baf0f2f5:

#   mct "{i}Fuck it. I have to admit, it makes me happy to see her like this.{/i}"
    mct "{i}Que se dane. Tenho que admitir, fico feliz em vê-la assim.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:285
translate brazil ch5sc09_baf27b2d:

#   uk "There you are! You’re a hard one to track down."
    uk "Aí está você! É difícil te encontrar."

# game/chapters/chapter5/script/ch5sc09.rpy:286
translate brazil ch5sc09_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter5/script/ch5sc09.rpy:289
translate brazil ch5sc09_24be3960:

#   uk "Hey! We’re talking to you."
    uk "Ei! Estamos falando com você."

# game/chapters/chapter5/script/ch5sc09.rpy:291
translate brazil ch5sc09_40df458e:

#   uk "First, you kill the boss's son."
    uk "Primeiro, você mata o filho do chefe."

# game/chapters/chapter5/script/ch5sc09.rpy:292
translate brazil ch5sc09_43df9d63:

#   uk "And then you flee, forcing us to track you for months! Not nice."
    uk "E depois você foge, nos obrigando a rastreá-lo por meses! Que feio."

# game/chapters/chapter5/script/ch5sc09.rpy:294
translate brazil ch5sc09_5a7fa269:

#   uk "Boss gave that bitch Irene quite the thrasin' upon bringing the news back to camp."
    uk "O chefe deu uma baita surra naquela vadia da Irene quando trouxe a notícia de volta para o acampamento."

# game/chapters/chapter5/script/ch5sc09.rpy:295
translate brazil ch5sc09_f2a1ce3a:

#   uk "Sadly she managed to escape before we could have our turn with her..."
    uk "Infelizmente, ela conseguiu escapar antes que pudéssemos ter nossa vez com ela..."

# game/chapters/chapter5/script/ch5sc09.rpy:296
translate brazil ch5sc09_1290b79c:

#   uk "Always wanted to enjoy that tight petite body of hers... mmhh..."
    uk "Sempre quis desfrutar daquele corpinho firme e delicado dela... mmhh..."

# game/chapters/chapter5/script/ch5sc09.rpy:302
translate brazil ch5sc09_edb039c1:

#   mc "I have no idea what the two of you are on about."
    mc "Não faço a mínima ideia do que vocês dois estão falando."

# game/chapters/chapter5/script/ch5sc09.rpy:303
translate brazil ch5sc09_7ba8249f:

#   mc "Now leave."
    mc "Agora vá embora."

# game/chapters/chapter5/script/ch5sc09.rpy:305
translate brazil ch5sc09_e7a28f9f:

#   uk "Rammus, son of Raden. The greatest bandit lord to ever roam the lands of Luxeron."
    uk "Rammus, filho de Raden. O maior senhor dos bandidos que já percorreu as terras de Luxeron."

# game/chapters/chapter5/script/ch5sc09.rpy:306
translate brazil ch5sc09_b2e1def2:

#   uk "That jog your memory?"
    uk "Isso lhe refresca a memória?"

# game/chapters/chapter5/script/ch5sc09.rpy:309
translate brazil ch5sc09_5847ac6d:

#   mc "Oh, that guy..."
    mc "Ah, aquele cara..."

# game/chapters/chapter5/script/ch5sc09.rpy:312
translate brazil ch5sc09_e2556e08:

#   mc "Nope, doesn’t ring a bell."
    mc "Não, não me soa familiar."

# game/chapters/chapter5/script/ch5sc09.rpy:314
translate brazil ch5sc09_6611a7a1:

#   uk "Maybe we should remind you, then!"
    uk "Talvez devêssemos lembrá-lo, então!"

# game/chapters/chapter5/script/ch5sc09.rpy:316
translate brazil ch5sc09_6ecda14f:

#   uk "Can you believe this punk? Killing the boss's son and then fleeing the scene like a little bitch."
    uk "Dá para acreditar nesse delinquente? Matou o filho do chefe e depois fugiu da cena como um covarde."

# game/chapters/chapter5/script/ch5sc09.rpy:318
translate brazil ch5sc09_12a16a09:

#   uk "Sounds pretty bitchy to me."
    uk "Me parece uma atitude bem grosseira."

# game/chapters/chapter5/script/ch5sc09.rpy:320
translate brazil ch5sc09_a45f4bd6:

#   uk "Boss has promised a big juicy reward for whoever brings you to him."
    uk "O chefe prometeu uma recompensa generosa para quem te trouxer até ele."

# game/chapters/chapter5/script/ch5sc09.rpy:322
translate brazil ch5sc09_a09e42b7:

#   uk "Mhm... Raden would very much like a word with you."
    uk "Hum... Raden gostaria muito de conversar com você."

# game/chapters/chapter5/script/ch5sc09.rpy:324
translate brazil ch5sc09_fe4f9e17:

#   mc "I’ve had a really lovely day. So, in the spirit of that... you'll get exactly {b}one{/b} chance."
    mc "Tive um dia realmente maravilhoso. Então, nesse espírito... você receberá exatamente {b} um{/b} chance."

# game/chapters/chapter5/script/ch5sc09.rpy:325
translate brazil ch5sc09_2f1638ec:

#   mc "One chance to walk away and convince your boss I’m dead."
    mc "Uma única chance de ir embora e convencer seu chefe de que estou morto."

# game/chapters/chapter5/script/ch5sc09.rpy:327
translate brazil ch5sc09_91b22f17:

#   uk "*Scoffs* Hah! Get a load of this punk! Walk away? Nobody walks away from Raden’s orders!"
    uk "*Zomba* Hah! Olha só esse moleque! Ir embora? Ninguém foge das ordens do Raden!"

# game/chapters/chapter5/script/ch5sc09.rpy:328
translate brazil ch5sc09_971c90b3:

#   uk "Get him!"
    uk "Peguem ele!"

# game/chapters/chapter5/script/ch5sc09.rpy:331
translate brazil ch5sc09_2abe198a:

#   mc "I see. So you have chosen death..."
    mc "Entendo. Então você escolheu a morte..."

# game/chapters/chapter5/script/ch5sc09.rpy:333
translate brazil ch5sc09_2d40ce69:

#   uk "Hah! You got lucky and caught Rammus off guard! But we’re not so easily-"
    uk "Hah! Você deu sorte e pegou o Rammus desprevenido! Mas nós não somos tão fáceis assim..."

# game/chapters/chapter5/script/ch5sc09.rpy:336
translate brazil ch5sc09_68791f1c:

#   uk "*Agonizing scream* AArrHHghh!!"
    uk "*Grito agonizante* AArrHHghh!!"

# game/chapters/chapter5/script/ch5sc09.rpy:339
translate brazil ch5sc09_898a943b:

#   uk "Bastard!! First Rammus, now Lob? I’ll fucking gut you!!"
    uk "Seu desgraçado!! Primeiro o Rammus, agora o Lob? Vou te estripar!!"

# game/chapters/chapter5/script/ch5sc09.rpy:343
translate brazil ch5sc09_11e71bc7:

#   mc "I see. So you have chosen death."
    mc "Entendo. Então você escolheu a morte."

# game/chapters/chapter5/script/ch5sc09.rpy:348
translate brazil ch5sc09_edd4c957:

#   uk "*Agonizing scream* {b}AArrHHghh!!{/b}"
    uk "*Grito agonizante* {b} AArrHHghh!!{/b}"

# game/chapters/chapter5/script/ch5sc09.rpy:354
translate brazil ch5sc09_6e9cf8a1:

#   uk "{b}YOU'LL REGRET THIS!{/b}"
    uk "{b}Você vai se arrepender disso!{/b}"

# game/chapters/chapter5/script/ch5sc09.rpy:357
translate brazil ch5sc09_bd978319:

#   "You catch his hand and twist it, plunging his blade into his own throat."
    "Você segura a mão dele e a torce, cravando a lâmina na própria garganta dele."

# game/chapters/chapter5/script/ch5sc09.rpy:358
translate brazil ch5sc09_d8b3b7d9:

#   uk "*Blood-choking gurgle* Hrrgh... Hghrh..."
    uk "*Garganta sufocante* Hrrgh... Hghrh..."

# game/chapters/chapter5/script/ch5sc09.rpy:360
translate brazil ch5sc09_fe03f58e:

#   mc "Could’ve gone so differently. Shame."
    mc "Poderia ter sido tão diferente. Uma pena."

# game/chapters/chapter5/script/ch5sc09.rpy:362
translate brazil ch5sc09_df6a8f7f:

#   mc "If you'll excuse me, I have a date to get back to."
    mc "Com licença, preciso retornar a um compromisso."

# game/chapters/chapter5/script/ch5sc09.rpy:370
translate brazil ch5sc09_0bb409b2:

#   el "He should’ve been back by now."
    el "Ele já deveria ter voltado."

# game/chapters/chapter5/script/ch5sc09.rpy:371
translate brazil ch5sc09_efdf806a:

#   el "Maybe I should go look for him?"
    el "Talvez eu devesse ir procurá-lo?"

# game/chapters/chapter5/script/ch5sc09.rpy:373
translate brazil ch5sc09_885597a0:

#   el "..."
    el "..."

# game/chapters/chapter5/script/ch5sc09.rpy:375
translate brazil ch5sc09_d578cfe0:

#   el "What took you so long?"
    el "Por que demorou tanto?"

# game/chapters/chapter5/script/ch5sc09.rpy:377
translate brazil ch5sc09_cb8520d1:

#   mc "Just had to do a little pest control along the way."
    mc "Só precisei fazer um pequeno controle de pragas no caminho."

# game/chapters/chapter5/script/ch5sc09.rpy:380
translate brazil ch5sc09_68911fed:

#   "In an instant, Eliza rushes to you, her voice heavy with worry."
    "Num instante, Eliza corre até você, com a voz carregada de preocupação."

# game/chapters/chapter5/script/ch5sc09.rpy:381
translate brazil ch5sc09_93f34936:

#   el "What happened?"
    el "O que aconteceu?"

# game/chapters/chapter5/script/ch5sc09.rpy:382
translate brazil ch5sc09_93088392:

#   mc "*Sigh* I had to take care of some bandits that have, apparently, been looking for us."
    mc "*Suspiro* Tive que lidar com alguns bandidos que, aparentemente, estavam nos procurando."

# game/chapters/chapter5/script/ch5sc09.rpy:384
translate brazil ch5sc09_191a5855:

#   el "Bandits? Why?"
    el "Bandidos? Por quê?"

# game/chapters/chapter5/script/ch5sc09.rpy:386
translate brazil ch5sc09_f6fc7cfa:

#   mc "Remember Rammus? That annoying guy I killed after we met? He was the son of a bandit lord who's put out a bounty on us."
    mc "Lembra do Rammus? Aquele cara chato que eu matei depois que nos conhecemos? Ele era filho de um chefe bandido que colocou uma recompensa pela nossa cabeça."

# game/chapters/chapter5/script/ch5sc09.rpy:388
translate brazil ch5sc09_1e654f18:

#   el "Where are they? I’ll kill them myself!"
    el "Onde eles estão? Eu mesmo os matarei!"

# game/chapters/chapter5/script/ch5sc09.rpy:389
translate brazil ch5sc09_e6dc98f8:

#   el "If not for attacking us, then for trying to harm you. And if not for that, then for meddling in our date! Hnnrrhh!"
    el "Se não foi por nos atacar, foi por tentar te prejudicar. E se não foi por isso, foi por se intrometer no nosso encontro! Hnnrrhh!"

# game/chapters/chapter5/script/ch5sc09.rpy:391
translate brazil ch5sc09_b357266b:

#   mc "*Chuckles* Have I told you how cute you are when you get all huffy and puffy?"
    mc "*Risos* Já te disse como você fica fofo quando fica todo emburrado e bufando?"

# game/chapters/chapter5/script/ch5sc09.rpy:395
translate brazil ch5sc09_e6314b32:

#   el "So, they didn’t hurt you?"
    el "Então, eles não te machucaram?"

# game/chapters/chapter5/script/ch5sc09.rpy:397
translate brazil ch5sc09_7e0d6ffc:

#   mc "Obviously."
    mc "Obviamente."

# game/chapters/chapter5/script/ch5sc09.rpy:398
translate brazil ch5sc09_a2e3b9ef:

#   el "Good."
    el "Bom."

# game/chapters/chapter5/script/ch5sc09.rpy:399
translate brazil ch5sc09_edc8208e:

#   mc "Now, how about we forget about them? We have a camp to set up. Why don’t you unpack while I start cooking?"
    mc "Que tal esquecermos deles agora? Temos um acampamento para montar. Por que você não desfaz as malas enquanto eu começo a cozinhar?"

# game/chapters/chapter5/script/ch5sc09.rpy:401
translate brazil ch5sc09_0b5c4c38:

#   el "Okay! Oh, and do take note of how much firewood I gathered!"
    el "Certo! Ah, e reparem na quantidade de lenha que eu juntei!"

# game/chapters/chapter5/script/ch5sc09.rpy:402
translate brazil ch5sc09_30b97750:

#   mc "*Chuckles* The best firewood gatherer in the five kingdoms."
    mc "*Risos* O melhor coletor de lenha dos cinco reinos."

# game/chapters/chapter5/script/ch5sc09.rpy:403
translate brazil ch5sc09_fd063c23:

#   el "I told you! I’m the best!"
    el "Eu te disse! Eu sou o melhor!"

# game/chapters/chapter5/script/ch5sc09.rpy:406
translate brazil ch5sc09_97e74667:

#   el "You brought so much stuff... How in the world did you manage all this?"
    el "Você trouxe tanta coisa... Como você conseguiu fazer tudo isso?"

# game/chapters/chapter5/script/ch5sc09.rpy:407
translate brazil ch5sc09_5c57ceaa:

#   mc "I had a little help from Borri. A shopkeeper owed him a favor, which he called in for this."
    mc "Recebi uma pequena ajuda de Borri. Um lojista lhe devia um favor, e ele o contatou para isso."

# game/chapters/chapter5/script/ch5sc09.rpy:409
translate brazil ch5sc09_f4588b13:

#   el "Awwh, that’s kind of him. Remind me to thank him next we see him."
    el "Ah, que gentil da parte dele. Lembre-me de agradecê-lo na próxima vez que o virmos."

# game/chapters/chapter5/script/ch5sc09.rpy:410
translate brazil ch5sc09_96f37fa6:

#   mc "I already made sure to thank him, but I’m sure he’d be happy to hear it from you as well."
    mc "Eu já lhe agradeci, mas tenho certeza de que ele também ficaria feliz em ouvir isso de você."

# game/chapters/chapter5/script/ch5sc09.rpy:412
translate brazil ch5sc09_97836629:

#   el "[mc]! You actually prepared a picnic basket for us?"
    el "[mc] Você preparou uma cesta de piquenique para nós?"

# game/chapters/chapter5/script/ch5sc09.rpy:413
translate brazil ch5sc09_d016cc0d:

#   mc "Just the bare necessities..."
    mc "Apenas o estritamente necessário..."

# game/chapters/chapter5/script/ch5sc09.rpy:415
translate brazil ch5sc09_aa17bd62:

#   el "Bare necessities? Bread... wine..."
    el "O essencial? Pão... vinho..."

# game/chapters/chapter5/script/ch5sc09.rpy:416
translate brazil ch5sc09_0dcb9e88:

#   el "A lady might get the impression you’re trying to charm her."
    el "Uma mulher pode ter a impressão de que você está tentando encantá-la."

# game/chapters/chapter5/script/ch5sc09.rpy:418
translate brazil ch5sc09_01160789:

#   mc "What an outrageous notion!"
    mc "Que ideia absurda!"

# game/chapters/chapter5/script/ch5sc09.rpy:420
translate brazil ch5sc09_0fdb7c9c:

#   el "*Giggles softly* Totally!"
    el "*Risinhos suaves* Totalmente!"

# game/chapters/chapter5/script/ch5sc09.rpy:421
translate brazil ch5sc09_f4a955f4:

#   el "How’s the fire going over there?"
    el "Como estão os incêndios por aí?"

# game/chapters/chapter5/script/ch5sc09.rpy:423
translate brazil ch5sc09_6d80a152:

#   mc "Almost ready for cooking. How about our tent? Have you finished setting it up?"
    mc "Quase tudo pronto para cozinhar. E a nossa barraca? Você já terminou de montá-la?"

# game/chapters/chapter5/script/ch5sc09.rpy:426
translate brazil ch5sc09_dcd7177f:

#   el "T-Tent?! Wha- No. I didn’t know there was a tent!"
    el "T-Tenda?! Quê?! Não. Eu não sabia que havia uma tenda!"

# game/chapters/chapter5/script/ch5sc09.rpy:427
translate brazil ch5sc09_358769cc:

#   el "I’m not even sure how to set one up!"
    el "Nem sei como configurar um!"

# game/chapters/chapter5/script/ch5sc09.rpy:429
translate brazil ch5sc09_3d0a4e8f:

#   mc "You’ll figure it out. It’s in the big bag."
    mc "Você vai descobrir. Está na sacola grande."

# game/chapters/chapter5/script/ch5sc09.rpy:431
translate brazil ch5sc09_4dd2640e:

#   el "This one here, yeah?"
    el "Este aqui, né?"

# game/chapters/chapter5/script/ch5sc09.rpy:432
translate brazil ch5sc09_413cf2c5:

#   mc "Yeah... that’s the one."
    mc "Sim... é essa mesma."

# game/chapters/chapter5/script/ch5sc09.rpy:434
translate brazil ch5sc09_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter5/script/ch5sc09.rpy:435
translate brazil ch5sc09_1b2c4f52:

#   el "I think I've got it! Hnnngh!"
    el "Acho que consegui! Hnnngh!"

# game/chapters/chapter5/script/ch5sc09.rpy:437
translate brazil ch5sc09_6d2e20c2:

#   "Eliza scrambles around the camp for the better part of an hour..."
    "Eliza percorre o acampamento freneticamente durante quase uma hora..."

# game/chapters/chapter5/script/ch5sc09.rpy:439
translate brazil ch5sc09_3a9fe650:

#   el "Tadaa! *Proudly* Who’s the best tent-builder you know? Me! That’s who! *Snickers*"
    el "Ta-da! *Orgulhosamente* Quem é o melhor construtor de barracas que você conhece? Eu! Isso mesmo! *Risinhos*"

# game/chapters/chapter5/script/ch5sc09.rpy:440
translate brazil ch5sc09_71b64438:

#   el "*Proudly* Eliza! Purified vampire! Ass-kicker of troublemakers! Wood gathering queen!"
    el "*Orgulhosamente* Eliza! Vampira purificada! Exterminadora de encrenqueiros! Rainha da coleta de lenha!"

# game/chapters/chapter5/script/ch5sc09.rpy:441
translate brazil ch5sc09_885c1e79:

#   el "*Proudly* Defender of the downtrodden! Master adventurer! And now tent-pitcher extraordinaire!"
    el "*Orgulhosamente* Defensor dos oprimidos! Mestre aventureiro! E agora, especialista em montar barracas!"

# game/chapters/chapter5/script/ch5sc09.rpy:442
translate brazil ch5sc09_62ab6bd5:

#   mct "{i}I almost don’t have the heart to tell her that’s just the backup tent...{/i}"
    mct "{i}Quase não tenho coragem de lhe dizer que aquela é apenas a tenda reserva...{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:444
translate brazil ch5sc09_e829c0c3:

#   mc "Eliza? What I’m about to tell you is going to be extremely hard to hear..."
    mc "Eliza? O que vou te dizer agora vai ser extremamente difícil de ouvir..."

# game/chapters/chapter5/script/ch5sc09.rpy:445
translate brazil ch5sc09_dc6de6fb:

#   mc "One could say, that it’s heart-shattering news..."
    mc "Pode-se dizer que é uma notícia devastadora..."

# game/chapters/chapter5/script/ch5sc09.rpy:446
translate brazil ch5sc09_7a735f22:

#   el "Bring it! I can handle anything right now! *Giggles*"
    el "Pode vir! Eu consigo lidar com qualquer coisa agora! *Risos*"

# game/chapters/chapter5/script/ch5sc09.rpy:448
translate brazil ch5sc09_ecf247c9:

#   mc "The tent you set up..."
    mc "A barraca que você montou..."

# game/chapters/chapter5/script/ch5sc09.rpy:449
translate brazil ch5sc09_20bca1f1:

#   el "I know. It’s awesome, right?!"
    el "Eu sei. É incrível, né?!"

# game/chapters/chapter5/script/ch5sc09.rpy:450
translate brazil ch5sc09_5893b47c:

#   mc "That’s the backup tent. I brought it in case something happened to the main tent."
    mc "Essa é a barraca reserva. Eu a trouxe caso algo acontecesse com a barraca principal."

# game/chapters/chapter5/script/ch5sc09.rpy:452
translate brazil ch5sc09_1e0e1f8c:

#   el "B-Back up tent?"
    el "Barraca reserva?"

# game/chapters/chapter5/script/ch5sc09.rpy:453
translate brazil ch5sc09_7ec33624:

#   el "No... It can’t be. No... You’re just trying to pull my leg! Right?"
    el "Não... Não pode ser. Não... Você só está tentando me enganar! Não é?"

# game/chapters/chapter5/script/ch5sc09.rpy:454
translate brazil ch5sc09_81a06d23:

#   mc "I’m afraid not."
    mc "Receio que não."

# game/chapters/chapter5/script/ch5sc09.rpy:456
translate brazil ch5sc09_c3ba92da:

#   el "*Defeated* My entire life has been a lie!"
    el "*Derrotado* Toda a minha vida foi uma mentira!"

# game/chapters/chapter5/script/ch5sc09.rpy:457
translate brazil ch5sc09_c66d92c2:

#   el "Tent-pitcher extraordinaire... what a joke! I’m a fraud!"
    el "Montador de barracas extraordinário... que piada! Sou uma fraude!"

# game/chapters/chapter5/script/ch5sc09.rpy:459
translate brazil ch5sc09_d4162152:

#   el "I-I’m a scammer! I can hear the other tent-pitchers laughing at me! ... Nobody’s going to love me!"
    el "Eu sou um golpista! Consigo ouvir os outros que estão montando barracas rindo de mim! ... Ninguém vai gostar de mim!"

# game/chapters/chapter5/script/ch5sc09.rpy:461
translate brazil ch5sc09_153c898e:

#   mc "Look on the bright side, if you don’t make it as an adventurer, you could always join the drama club."
    mc "Veja pelo lado bom: se você não se der bem como aventureiro, sempre poderá entrar para o clube de teatro."

# game/chapters/chapter5/script/ch5sc09.rpy:462
translate brazil ch5sc09_7384b54b:

#   el "The only thing worse than this, would be hearing your worst enemy say {i}'I am your father'{/i}."
    el "A única coisa pior do que isso seria ouvir seu pior inimigo dizer {i}'Eu sou seu pai'{/i}."

# game/chapters/chapter5/script/ch5sc09.rpy:463
translate brazil ch5sc09_01b207f5:

#   mc "*Chuckles* Yeah, I can’t imagine the humiliation that would cause..."
    mc "*Risos* É, não consigo imaginar a humilhação que isso causaria..."

# game/chapters/chapter5/script/ch5sc09.rpy:465
translate brazil ch5sc09_72ee4064:

#   el "[mc]... What are we going to do? I just spent a whole hour pitching this tent!"
    el "[mc]... O que vamos fazer? Acabei de passar uma hora inteira montando esta barraca!"

# game/chapters/chapter5/script/ch5sc09.rpy:466
translate brazil ch5sc09_41d4ec32:

#   mc "Let’s start by taking it down. C’mon... I’ll help."
    mc "Vamos começar por desmontá-lo. Vamos lá... eu ajudo."

# game/chapters/chapter5/script/ch5sc09.rpy:468
translate brazil ch5sc09_08a44083:

#   el "Teamwork makes the dream work! *Giggles*"
    el "Trabalho em equipe faz o sonho acontecer! *Risos*"

# game/chapters/chapter5/script/ch5sc09.rpy:469
translate brazil ch5sc09_8c0b1067:

#   mc "H-Hey... quit monkeying around."
    mc "Ei... pare de brincar."

# game/chapters/chapter5/script/ch5sc09.rpy:470
translate brazil ch5sc09_d68f1887:

#   el "Make me!"
    el "Me faz!"

# game/chapters/chapter5/script/ch5sc09.rpy:471
translate brazil ch5sc09_764fd193:

#   mc "*Sighs* You're hopeless..."
    mc "*Suspiro* Você é um caso perdido..."

# game/chapters/chapter5/script/ch5sc09.rpy:473
translate brazil ch5sc09_4c038691:

#   "The two of you spend a while repacking the backup tent, then setting up the new one."
    "Vocês dois passam um tempo empacotando e reempacotando a barraca reserva, e depois montam a nova."

# game/chapters/chapter5/script/ch5sc09.rpy:476
translate brazil ch5sc09_10dd40bc:

#   mc "Don’t like it?"
    mc "Não gostou?"

# game/chapters/chapter5/script/ch5sc09.rpy:477
translate brazil ch5sc09_202cce04:

#   el "......."
    el "......."

# game/chapters/chapter5/script/ch5sc09.rpy:480
translate brazil ch5sc09_1a7f06e7:

#   el "MMmhp!"
    el "MMmhp!"

# game/chapters/chapter5/script/ch5sc09.rpy:482
translate brazil ch5sc09_788d1e3b:

#   el "I love it... I love you."
    el "Eu adoro isso... Eu te amo."

# game/chapters/chapter5/script/ch5sc09.rpy:483
translate brazil ch5sc09_bffea011:

#   mc "I love you too."
    mc "Eu também te amo."

# game/chapters/chapter5/script/ch5sc09.rpy:487
translate brazil ch5sc09_032ff9e4:

#   el "*Muuah!* NNnhhh..."
    el "*Muuah!* Nnhhh..."

# game/chapters/chapter5/script/ch5sc09.rpy:488
translate brazil ch5sc09_577f33b3:

#   mc "Mmm..."
    mc "Hum..."

# game/chapters/chapter5/script/ch5sc09.rpy:490
translate brazil ch5sc09_53220e44:

#   "As usual with both of you, a simple kiss never remains simple for long..."
    "Como sempre acontece com vocês dois, um simples beijo nunca permanece simples por muito tempo..."

# game/chapters/chapter5/script/ch5sc09.rpy:491
translate brazil ch5sc09_2b954c1d:

#   "Eliza presses her soft lips intimately against yours, keeping both your mouths open."
    "Eliza pressiona seus lábios macios intimamente contra os seus, mantendo a boca de ambos entreaberta."

# game/chapters/chapter5/script/ch5sc09.rpy:492
translate brazil ch5sc09_9cc5a232:

#   "Her wet tongue grazes yours delicately, inviting you to lick hers in turn."
    "Sua língua úmida roça delicadamente a sua, convidando você a lamber a dela também."

# game/chapters/chapter5/script/ch5sc09.rpy:493
translate brazil ch5sc09_8ae922d5:

#   el "*Licks* Mnhohhmm... Mhhm..."
    el "*Lambe* Mnhohhmm... Mhhm..."

# game/chapters/chapter5/script/ch5sc09.rpy:495
translate brazil ch5sc09_27a104a7:

#   mc "Dinner?"
    mc "Jantar?"

# game/chapters/chapter5/script/ch5sc09.rpy:496
translate brazil ch5sc09_fe711e97:

#   el "Totally..."
    el "Totalmente..."

# game/chapters/chapter5/script/ch5sc09.rpy:498
translate brazil ch5sc09_0f85abe8:

#   el "Mhnhh..."
    el "Hmmm..."

# game/chapters/chapter5/script/ch5sc09.rpy:499
translate brazil ch5sc09_bf7cb306:

#   mct "{i}I love feeling her press against me...{/i}"
    mct "{i}Adoro sentir ela se pressionando contra mim...{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:500
translate brazil ch5sc09_0fd79ca9:

#   mct "{i}Having her small waist in my hands, while her breasts squish against me like this.{/i}"
    mct "{i}Com suas mãos em sua cintura fina, enquanto seus seios se comprimem contra mim assim.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:502
translate brazil ch5sc09_51a676de:

#   el "*Heavy breathing* Food?"
    el "*Respiração ofegante* Comida?"

# game/chapters/chapter5/script/ch5sc09.rpy:503
translate brazil ch5sc09_2fcc7ac5:

#   mc "Sure..."
    mc "Claro..."

# game/chapters/chapter5/script/ch5sc09.rpy:505
translate brazil ch5sc09_4a83d9f6:

#   el "Mnh-mhh..."
    el "Mhh-mhh..."

# game/chapters/chapter5/script/ch5sc09.rpy:507
translate brazil ch5sc09_28b644e2:

#   el "*Panting* Pause! ... Pphhhh... Okay, dinner for real!"
    el "*Ofegante* Pausa! ... Pfff... Ok, jantar de verdade!"

# game/chapters/chapter5/script/ch5sc09.rpy:508
translate brazil ch5sc09_bb19ab73:

#   mc "*Light chuckle* You drive me crazy, Kitten."
    mc "*Risada discreta* Você me deixa louco, gatinha."

# game/chapters/chapter5/script/ch5sc09.rpy:510
translate brazil ch5sc09_e9163796:

#   el "*Kiss* Mhhnh... *Purrs* NnrhhHh..."
    el "*Beijo* Mhhnh... *Ronrona* NnrhhHh..."

# game/chapters/chapter5/script/ch5sc09.rpy:512
translate brazil ch5sc09_770ca431:

#   el "Okay! Okay. Phew. Cook! Dinner! Now! *Giggles*"
    el "Ok! Ok. Ufa. Cozinhar! Jantar! Agora! *Risos*"

# game/chapters/chapter5/script/ch5sc09.rpy:514
translate brazil ch5sc09_e18ecceb:

#   mc "You know how to stir my hunger..."
    mc "Você sabe como despertar minha fome..."

# game/chapters/chapter5/script/ch5sc09.rpy:515
translate brazil ch5sc09_4cdff529:

#   el "Me? You’re the one lifting my appetite to the skies."
    el "Eu? É você quem está elevando meu apetite às alturas."

# game/chapters/chapter5/script/ch5sc09.rpy:517
translate brazil ch5sc09_5aee2c15:

#   mc "Heh. Let’s get busy making dinner. The sooner we eat, the sooner we can have dessert."
    mc "Heh. Vamos começar a preparar o jantar. Quanto mais cedo comermos, mais cedo poderemos comer a sobremesa."

# game/chapters/chapter5/script/ch5sc09.rpy:518
translate brazil ch5sc09_7de1d6ad:

#   el "Mhm... I do like dessert!"
    el "Hum... eu gosto de sobremesa!"

# game/chapters/chapter5/script/ch5sc09.rpy:520
translate brazil ch5sc09_28e8fba6:

#   el "*Mwah*"
    el "*Beijo*"

# game/chapters/chapter5/script/ch5sc09.rpy:527
translate brazil ch5sc09_289fe1de:

#   mc "How about we make some dinner?"
    mc "Que tal prepararmos o jantar?"

# game/chapters/chapter5/script/ch5sc09.rpy:528
translate brazil ch5sc09_25699fb4:

#   el "Yum!"
    el "Que delícia!"

# game/chapters/chapter5/script/ch5sc09.rpy:533
translate brazil ch5sc09_5aee7395:

#   bth "*Eager soup-slurping noises* Slllrrrpph..."
    bth "*Ruídos de alguém tomando sopa com entusiasmo* Slllrrrpph..."

# game/chapters/chapter5/script/ch5sc09.rpy:534
