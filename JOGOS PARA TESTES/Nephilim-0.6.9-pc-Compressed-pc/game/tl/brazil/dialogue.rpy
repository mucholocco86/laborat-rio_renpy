# game/chapters/chapter4/script/ch4sc17.rpy:10
translate brazil ch4sc17_1f5f5636:

#   el "Borri! Watch out! We’re going to end up on the floor!"
    el "Borri! Cuidado! Vamos acabar no chão!"

# game/chapters/chapter4/script/ch4sc17.rpy:11
translate brazil ch4sc17_62a9cf9e:

#   br "Aye! Quit yer squirming, lass!"
    br "Sim! Pare de se contorcer, garota!"

# game/chapters/chapter4/script/ch4sc17.rpy:13
translate brazil ch4sc17_3a77d401:

#   sy "Aah! There you are!"
    sy "Ah! Aí está você!"

# game/chapters/chapter4/script/ch4sc17.rpy:14
translate brazil ch4sc17_bd0d2182:

#   el "Sylph! Tell Borri to stop being so reckless!"
    el "Sylph! Diga ao Borri para parar de ser tão imprudente!"

# game/chapters/chapter4/script/ch4sc17.rpy:15
translate brazil ch4sc17_6f8d2640:

#   sy "Borri! Dwarf-up and carry her steadily!"
    sy "Borri! Suba e carregue-a com firmeza!"

# game/chapters/chapter4/script/ch4sc17.rpy:17
translate brazil ch4sc17_b18e8c4b:

#   br "Wha! Ye mad woman?! Yer lookin at the strongest dwarf in Luxenford. Nay! All of Luxeron!"
    br "O quê?! Sua louca?! Você está olhando para o anão mais forte de Luxenford. Não! De toda Luxeron!"

# game/chapters/chapter4/script/ch4sc17.rpy:18
translate brazil ch4sc17_daa15c4a:

#   sy "Well... do it better! Your posture could use some adjustment."
    sy "Bem... faça melhor! Sua postura precisa de alguns ajustes."

# game/chapters/chapter4/script/ch4sc17.rpy:19
translate brazil ch4sc17_0a55526d:

#   br "*Mumbles* Blasted she-devil..."
    br "*Resmunga* Maldita diaba..."

# game/chapters/chapter4/script/ch4sc17.rpy:21
translate brazil ch4sc17_2b02dd0f:

#   sy "What was that? Hmmm! Maybe I should sprinkle some pixie dust all over you!"
    sy "O que foi isso? Hum! Talvez eu devesse jogar um pouco de pó de fada em você!"

# game/chapters/chapter4/script/ch4sc17.rpy:22
translate brazil ch4sc17_96e9b56b:

#   sy "Make you levitate upside down! *Snickers*"
    sy "Te faço levitar de cabeça para baixo! *Risos*"

# game/chapters/chapter4/script/ch4sc17.rpy:24
translate brazil ch4sc17_6f0abad5:

#   el "Stop it, you two!"
    el "Parem com isso, vocês dois!"

# game/chapters/chapter4/script/ch4sc17.rpy:25
translate brazil ch4sc17_a9776a92:

#   el "Sylph, do you have any quests for us today? I’ve convinced Borri to take me on a quest."
    el "Sylph, você tem alguma missão para nós hoje? Convenci Borri a me levar em uma missão."

# game/chapters/chapter4/script/ch4sc17.rpy:27
translate brazil ch4sc17_bab665bd:

#   sy "A quest, you say? I do have one leftover from yesterday that wasn’t completed."
