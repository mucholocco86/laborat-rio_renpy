translate brazil ch3sc28_190a5efc:

#   el "Why are you doing this?!"
    el "Por que você está fazendo isso?!"

# game/chapters/chapter3/script/ch3sc28.rpy:32
translate brazil ch3sc28_91085215:

#   ta "Quiet down! Be grateful I’m such a gracious host. I could’ve let my guards have their way with you..."
    ta "Silêncio! Agradeça por eu ser um anfitrião tão gentil. Eu poderia ter deixado meus guardas fazerem o que quisessem com você..."

# game/chapters/chapter3/script/ch3sc28.rpy:33
translate brazil ch3sc28_c47ada29:

#   ta "But instead, I chose to give you your own cell."
    ta "Mas, em vez disso, optei por lhe dar sua própria cela."

# game/chapters/chapter3/script/ch3sc28.rpy:34
translate brazil ch3sc28_6582e9c1:

#   ta "You’re practically being treated like a queen, despite your... despicable upbringing."
    ta "Você está sendo praticamente tratada como uma rainha, apesar da sua... criação desprezível."

# game/chapters/chapter3/script/ch3sc28.rpy:36
translate brazil ch3sc28_33627498:

#   el "What are you sayi-"
    el "O que você está dizendo?"

# game/chapters/chapter3/script/ch3sc28.rpy:37
translate brazil ch3sc28_9e0d16f5:

#   el "You will pay for this! [mc] will find me!"
    el "Você vai pagar por isso! [mc] vai me encontrar!"

# game/chapters/chapter3/script/ch3sc28.rpy:38
translate brazil ch3sc28_aa5ce5bd:

#   el "A-And when he does... you will regret this!"
    el "E quando ele fizer isso... você vai se arrepender!"

# game/chapters/chapter3/script/ch3sc28.rpy:40
translate brazil ch3sc28_e33661d7:

#   ta "You really are a naive little summer child, aren’t you?"
    ta "Você é mesmo uma criancinha ingênua, não é?"

# game/chapters/chapter3/script/ch3sc28.rpy:41
translate brazil ch3sc28_fa7c305b:

#   ta "Of course [mc] is going to find you... I’m counting on it."
    ta "Claro [mc] Vai te encontrar... Estou contando com isso."

# game/chapters/chapter3/script/ch3sc28.rpy:42
translate brazil ch3sc28_6c9891a1:

#   ta "You’ve been playing right into my hands ever since you arrived in Luxenford."
    ta "Você tem me enganado direitinho desde que chegou em Luxemburgo."

# game/chapters/chapter3/script/ch3sc28.rpy:44
translate brazil ch3sc28_c977e022:

#   el "He will kill you."
    el "Ele vai te matar."

# game/chapters/chapter3/script/ch3sc28.rpy:46
translate brazil ch3sc28_7091b520:

#   ta "No dear, he won't."
    ta "Não, querida, ele não vai."

# game/chapters/chapter3/script/ch3sc28.rpy:47
translate brazil ch3sc28_ef470160:

#   ta "Why do you think I captured you? You're his weakness."
    ta "Por que você acha que eu te capturei? Você é a fraqueza dele."

# game/chapters/chapter3/script/ch3sc28.rpy:49
translate brazil ch3sc28_ae19d1a6:

#   el "[mc] doesn't have any weakness! Especially me!"
    el "[mc] Não tem nenhuma fraqueza! Principalmente eu!"

# game/chapters/chapter3/script/ch3sc28.rpy:51
translate brazil ch3sc28_0e6ccd03:

#   ta "*Scoffs* Even you didn't believe that, but nice try."
    ta "*Risos* Nem você acreditou nisso, mas boa tentativa."

# game/chapters/chapter3/script/ch3sc28.rpy:52
translate brazil ch3sc28_b8172591:

#   ta "I'm going to use you little dove, use you to get what I want."
    ta "Vou usar você, minha pequena pomba, usar você para conseguir o que quero."

# game/chapters/chapter3/script/ch3sc28.rpy:54
translate brazil ch3sc28_4882082a:

#   el "Why? Why are you doing this?!"
    el "Por quê? Por que você está fazendo isso?!"

# game/chapters/chapter3/script/ch3sc28.rpy:57
translate brazil ch3sc28_dfeffcfb:

#   ta "{b}Enough!!{/b}"
    ta "{b}Suficiente!!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:59
translate brazil ch3sc28_6d87ce23:

#   ta "This conversation bores me."
    ta "Essa conversa me aborrece."

# game/chapters/chapter3/script/ch3sc28.rpy:60
translate brazil ch3sc28_601bd1d7:

#   ta "See you soon... Eliza."
    ta "Até breve... Eliza."

# game/chapters/chapter3/script/ch3sc28.rpy:62
translate brazil ch3sc28_ff878c17:

#   ta "And do send my regards to your father next you see him, It’s been a while since I’ve seen Oren."
    ta "E mande lembranças ao seu pai na próxima vez que o vir. Já faz um tempo que não vejo o Oren."

# game/chapters/chapter3/script/ch3sc28.rpy:63
translate brazil ch3sc28_51c6c58c:

#   ta "I wonder how the old chap is doing?"
    ta "Gostaria de saber como estará o velho?"

# game/chapters/chapter3/script/ch3sc28.rpy:65
translate brazil ch3sc28_dcad4d86:

#   el "My father is dead, asshole!"
    el "Meu pai está morto, seu idiota!"

# game/chapters/chapter3/script/ch3sc28.rpy:66
translate brazil ch3sc28_0b322772:

#   ta "..."
    ta "..."

# game/chapters/chapter3/script/ch3sc28.rpy:67
translate brazil ch3sc28_d791acd5:

#   tat "Oren... dead? I was wondering why the beast had arrived in Luxenford with only his daughter..."
    tat "Oren... morto? Eu estava me perguntando por que a besta tinha chegado a Luxenford apenas com sua filha..."

# game/chapters/chapter3/script/ch3sc28.rpy:68
translate brazil ch3sc28_e26484d6:

#   tat "Hmph, no matter... won't change anything."
    tat "Hum, tanto faz... não vai mudar nada."

# game/chapters/chapter3/script/ch3sc28.rpy:73
translate brazil ch3sc28_2b8b5854:

#   elt "What the fuck? That sick pervert! I have to get out of here! I can’t let [mc] play into his hands!"
    elt "Que porra é essa? Que pervertido doente! Preciso sair daqui! Não posso deixar [mc] Faça o que ele quer!"

# game/chapters/chapter3/script/ch3sc28.rpy:74
translate brazil ch3sc28_35a3acff:

#   elt "Whatever he has planned... it isn’t anything good."
    elt "Seja lá o que ele tenha planejado... não é nada bom."

# game/chapters/chapter3/script/ch3sc28.rpy:75
translate brazil ch3sc28_3198ebb1:

#   elt "I can’t let [mc] fall into his trap... especially because of me!"
    elt "Não posso deixar [mc] Cair na armadilha dele... principalmente por minha causa!"

# game/chapters/chapter3/script/ch3sc28.rpy:77
translate brazil ch3sc28_d07ab3bc:

#   uk "*Mumbling* Wib, Wib, wibble..."
    uk "*Murmurando* Wib, Wib, wibble..."

# game/chapters/chapter3/script/ch3sc28.rpy:78
translate brazil ch3sc28_dc2556bb:

#   elt "What the heck? I thought he said I was alone in this cell?"
    elt "Que diabos? Pensei que ele tivesse dito que eu estava sozinho nesta cela?"

# game/chapters/chapter3/script/ch3sc28.rpy:80
translate brazil ch3sc28_623ac79a:

#   uk "*Mumbling* Wibble, Wibbl, Wib, Wibble..."
    uk "*Murmurando* Wibble, Wibbl, Wib, Wibble..."

# game/chapters/chapter3/script/ch3sc28.rpy:82
translate brazil ch3sc28_62eb6fa8:

#   uk "*Mumbling* Wibb, Wibb, Wibbl."
    uk "*Murmúrios* Wibb, Wibb, Wibbl."

# game/chapters/chapter3/script/ch3sc28.rpy:84
translate brazil ch3sc28_64df998e:

#   el "E-Excuse me, sir. Are you alright?"
    el "Com licença, senhor. O senhor está bem?"

# game/chapters/chapter3/script/ch3sc28.rpy:86
translate brazil ch3sc28_1ac6ec7d:

#   uk "*Mumbling* Wibb, Wibbl, Wwible, Wibb."
    uk "*Murmúrios* Wibb, Wibbl, Wwible, Wibb."

# game/chapters/chapter3/script/ch3sc28.rpy:90
translate brazil ch3sc28_240c873b:

#   uk "Mumbling* Wibb, Wibb, Wibble."
    uk "Murmurando* Wibb, Wibb, Wibble."

# game/chapters/chapter3/script/ch3sc28.rpy:91
translate brazil ch3sc28_4732ea58:

#   el "S-Sir, you okay? Please tell me if I can do anything."
    el "Senhor, o senhor está bem? Por favor, me diga se posso fazer alguma coisa."

# game/chapters/chapter3/script/ch3sc28.rpy:92
translate brazil ch3sc28_0a9b0226:

#   uk "*Mumbling* W-Wibb, Wibble, Wibbe, W-Wibb."
    uk "*Murmúrios* W-Wibb, Wibble, Wibbe, W-Wibb."

# game/chapters/chapter3/script/ch3sc28.rpy:93
translate brazil ch3sc28_434462c7:

#   el "*Sigh* O-Okay, I’ll be over here if you need anything."
    el "*Suspiro* T-Tudo bem, estarei aqui se precisar de alguma coisa."

# game/chapters/chapter3/script/ch3sc28.rpy:95
translate brazil ch3sc28_a2414271:

#   elt "Great. I’m covered in dirt and trapped in a damp cell that is divines-know-where, along with an old lunatic."
    elt "Ótimo. Estou coberto de sujeira e preso em uma cela úmida que fica sabe-se lá onde, junto com um velho lunático."

# game/chapters/chapter3/script/ch3sc28.rpy:97
translate brazil ch3sc28_adeea9a3:

#   elt "How am I going to get out?"
    elt "Como vou sair daqui?"

# game/chapters/chapter3/script/ch3sc28.rpy:99
translate brazil ch3sc28_bf7a3450:

#   elt "Huh?"
    elt "Huh?"

# game/chapters/chapter3/script/ch3sc28.rpy:100
translate brazil ch3sc28_1dde92ba:

#   uk "There’s no point trying to escape."
    uk "Não adianta tentar escapar."

# game/chapters/chapter3/script/ch3sc28.rpy:102
translate brazil ch3sc28_62f18865:

#   uk "I’m sorry it had to be this way. There was no other option."
    uk "Sinto muito que tenha sido assim. Não havia outra opção."

# game/chapters/chapter3/script/ch3sc28.rpy:104
translate brazil ch3sc28_0a009cbe:

#   el "{b}You!?{/b} It was you?!"
    el "{b}Você!?{/b} Foi você?!"

# game/chapters/chapter3/script/ch3sc28.rpy:105
translate brazil ch3sc28_d22eae7e:

#   el "We trusted you!"
    el "Nós confiamos em você!"

# game/chapters/chapter3/script/ch3sc28.rpy:107
translate brazil ch3sc28_a77ce778:

#   uk "And look where that got you?"
    uk "E veja só onde isso te levou?"

# game/chapters/chapter3/script/ch3sc28.rpy:108
translate brazil ch3sc28_5d277d41:

#   uk "You should have been more careful... now it’s too late."
