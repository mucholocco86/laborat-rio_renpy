#   am "Stop it! Let's have breakfast without discussing my bodyguard's harem, okay!?"
    am "Pare com isso! Vamos tomar café da manhã sem falar do harém do meu guarda-costas, ok!?"

# game/chapters/chapter5/script/ch5sc12.rpy:174
translate brazil ch5sc12_be057cb0:

#   bn "Bah, you're no fun sweetheart! We're just joking!"
    bn "Bah, você não tem graça nenhuma, querida! Estamos só brincando!"

# game/chapters/chapter5/script/ch5sc12.rpy:176
