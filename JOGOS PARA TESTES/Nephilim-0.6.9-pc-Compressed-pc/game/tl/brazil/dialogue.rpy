translate brazil ch7sc9_3c6d2559:

#   ro "It’s too soon… not to mention highly inappropriate."
    ro "É muito cedo... para não mencionar que é extremamente inapropriado."

# game/chapters/chapter7/ch7sc9.rpy:2286
translate brazil ch7sc9_b03a6efd:

#   ro "You have no idea how badly I’d like to invite you back to my place…"
    ro "Você não faz ideia de como eu gostaria de te convidar para vir à minha casa…"

