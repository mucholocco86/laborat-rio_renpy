translate brazil ch6sc10_9e9841cb:

#   pl "*Snickers* Exactly like this! Show us what you’ve got [mc]!"
    pl "*Risos* Exatamente assim! Mostre-nos o que você tem! [mc]!"

# game/chapters/chapter6/ch6sc10.rpy:6375
translate brazil ch6sc10_1b0653d3:

#   tz "Oh! Oh my! This will require some balance!"
    tz "Oh! Oh meu Deus! Isso vai exigir um pouco de equilíbrio!"

# game/chapters/chapter6/ch6sc10.rpy:6377
translate brazil ch6sc10_1e97beec:

#   pl "Uh-huh! You’ll get used to it after a few reps."
    pl "Uhum! Você se acostumará depois de algumas repetições."

# game/chapters/chapter6/ch6sc10.rpy:6379
translate brazil ch6sc10_659eb854:

