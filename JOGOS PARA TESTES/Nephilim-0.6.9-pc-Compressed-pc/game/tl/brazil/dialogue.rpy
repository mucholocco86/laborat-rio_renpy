    tz "Com certeza! Mostre-nos o quão forte você é, Sr. Nefilim!"

# game/chapters/chapter6/ch6sc10.rpy:6394
translate brazil ch6sc10_3c2b799f:

#   mc "*Sighs* You girls are ridiculous…"
    mc "*Suspiro* Vocês meninas são ridículas…"

# game/chapters/chapter6/ch6sc10.rpy:6396
translate brazil ch6sc10_ac93e88d:

