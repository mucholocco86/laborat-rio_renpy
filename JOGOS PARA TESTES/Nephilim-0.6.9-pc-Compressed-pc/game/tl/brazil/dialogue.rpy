translate brazil ch4sc17_fc78214a:

#   br "Porkchops!"
    br "Costeletas de porco!"

# game/chapters/chapter4/script/ch4sc17.rpy:169
translate brazil ch4sc17_361af1ec:

#   br "I’ll be damned, lass! How has he not run off?"
    br "Puxa vida, moça! Como é que ele ainda não fugiu?"

# game/chapters/chapter4/script/ch4sc17.rpy:170
translate brazil ch4sc17_a3b7f93f:

#   el "I don’t know... maybe he found something he likes out here?"
    el "Não sei... talvez ele tenha encontrado algo de que goste por aqui?"

# game/chapters/chapter4/script/ch4sc17.rpy:171
translate brazil ch4sc17_5964a9c6:

#   el "Eating fresh vegetation is probably new to him."
    el "Comer vegetação fresca provavelmente é uma novidade para ele."

# game/chapters/chapter4/script/ch4sc17.rpy:172
translate brazil ch4sc17_e848f2c9:

#   pk "*Happy Oinks*"
    pk "*Porquinhos felizes*"

# game/chapters/chapter4/script/ch4sc17.rpy:174
translate brazil ch4sc17_f6c48be8:

#   br "Come on, lass."
    br "Vamos lá, moça."

# game/chapters/chapter4/script/ch4sc17.rpy:175
translate brazil ch4sc17_df8e142c:

#   br "Let’s take him home and get our pay."
    br "Vamos levá-lo para casa e receber nosso pagamento."

# game/chapters/chapter4/script/ch4sc17.rpy:184
translate brazil ch4sc17_d7f9d414:

#   mct "*Inhales* Hmm..."
    mct "*Inspira* Hum..."

# game/chapters/chapter4/script/ch4sc17.rpy:185
translate brazil ch4sc17_86f6b6d4:

#   mct "I did it, Rin."
    mct "Eu consegui, Rin."

# game/chapters/chapter4/script/ch4sc17.rpy:186
translate brazil ch4sc17_99727ec0:

#   mct "I finally mastered the cyclone-manifestation you spent so long teaching me."
    mct "Finalmente dominei a manifestação do ciclone que você passou tanto tempo me ensinando."

# game/chapters/chapter4/script/ch4sc17.rpy:187
translate brazil ch4sc17_439deb83:

#   mct "*Exhales* I miss you... even if you might hate me."
    mct "*Suspira* Sinto sua falta... mesmo que você me odeie."

# game/chapters/chapter4/script/ch4sc17.rpy:190
translate brazil ch4sc17_64800083:

#   kit "He’s up early... I wonder what he’s up to?"
    kit "Ele acordou cedo... Será que ele está aprontando alguma coisa?"

# game/chapters/chapter4/script/ch4sc17.rpy:192
translate brazil ch4sc17_7084969d:

#   kit "He looks like he's in a peaceful place... Hope it’s okay to join him."
    kit "Ele parece estar num lugar tranquilo... Espero que não haja problema em me juntar a ele."

# game/chapters/chapter4/script/ch4sc17.rpy:194
translate brazil ch4sc17_59114ce9:

#   mc "Hey Kira..."
    mc "Ei, Kira..."

# game/chapters/chapter4/script/ch4sc17.rpy:195
translate brazil ch4sc17_89bded6c:

#   ki "Morning. How’d you know it was me?"
    ki "Bom dia. Como você sabia que era eu?"

# game/chapters/chapter4/script/ch4sc17.rpy:196
translate brazil ch4sc17_2db2c976:

#   mc "Your scent."
    mc "Seu perfume."

# game/chapters/chapter4/script/ch4sc17.rpy:198
translate brazil ch4sc17_dcd7acba:

#   ki "Oh... is that one of your abilities?"
    ki "Ah... essa é uma das suas habilidades?"

# game/chapters/chapter4/script/ch4sc17.rpy:202
translate brazil ch4sc17_5a9cd290:

#   mc "You have a very unique and alluring scent, like a mix between the ocean and freshly picked Crimson-thorn."
    mc "Você tem um aroma muito singular e sedutor, como uma mistura entre o oceano e um espinheiro-carmesim recém-colhido."

# game/chapters/chapter4/script/ch4sc17.rpy:203
translate brazil ch4sc17_e1b7d971:

#   kit "He really has a way with words."
    kit "Ele tem um jeito especial com as palavras."

# game/chapters/chapter4/script/ch4sc17.rpy:204
translate brazil ch4sc17_6fa9f2dc:

#   kit "Making me blush first thing in the morning..."
    kit "Me faz corar logo de manhã..."

# game/chapters/chapter4/script/ch4sc17.rpy:207
translate brazil ch4sc17_75f38e6d:

#   ki "*Mwaaah*"
    ki "*Mwaaah*"

# game/chapters/chapter4/script/ch4sc17.rpy:208
translate brazil ch4sc17_68478f4e:

#   "Kira plants a sweet and caring kiss on your cheek as she embraces you."
    "Kira deposita um beijo doce e carinhoso em sua bochecha enquanto te abraça."

# game/chapters/chapter4/script/ch4sc17.rpy:210
translate brazil ch4sc17_0d467987:

#   mc "What was that for?"
    mc "Para que serviu isso?"

# game/chapters/chapter4/script/ch4sc17.rpy:212
translate brazil ch4sc17_c3e6583a:

#   ki "Just felt like it..."
    ki "Simplesmente me deu vontade..."

# game/chapters/chapter4/script/ch4sc17.rpy:213
translate brazil ch4sc17_cdcd3d7f:

#   ki "And for last night. I had a hard time falling asleep without you after what happened between us."
    ki "E quanto à noite passada? Tive muita dificuldade para dormir sem você depois do que aconteceu entre nós."

# game/chapters/chapter4/script/ch4sc17.rpy:215
translate brazil ch4sc17_596b9eeb:

#   mc "Yeah... me too."
    mc "Sim... eu também."

# game/chapters/chapter4/script/ch4sc17.rpy:216
translate brazil ch4sc17_128b5834:

#   mc "You were incredible."
    mc "Você foi incrível."

# game/chapters/chapter4/script/ch4sc17.rpy:218
translate brazil ch4sc17_31bf96fe:

#   ki "*Muuah*"
    ki "*Muuah*"

# game/chapters/chapter4/script/ch4sc17.rpy:220
translate brazil ch4sc17_ae277c5e:

#   ki "Maybe you could... spend the night... next time?"
    ki "Talvez você pudesse... passar a noite... da próxima vez?"

# game/chapters/chapter4/script/ch4sc17.rpy:221
translate brazil ch4sc17_852ddff9:

#   mct "She wants to be close to me. It's a nice feeling."
    mct "Ela quer ficar perto de mim. É uma sensação boa."

