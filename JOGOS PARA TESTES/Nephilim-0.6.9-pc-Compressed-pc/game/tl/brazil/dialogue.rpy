# game/chapters/chapter5/script/ch5sc11.rpy:2052
translate brazil ch5sc11_3075b66d:

#   mct "{i}But for now... let’s test out this grandiose bed and see what all the fuss is about.{/i}"
    mct "{i}Mas por agora... vamos testar esta cama magnífica e ver se é que ela tem tanto alarido.{/i}"

# game/chapters/chapter5/script/ch5sc11.rpy:2056
translate brazil ch5sc11_b15808f0:

#   mct "{i}*Sighs* ...{/i}"
    mct "{i}*Suspiros* ...{/i}"

# game/chapters/chapter5/script/ch5sc11.rpy:2058
translate brazil ch5sc11_629a0cfc:

#   mct "{i}It feels nice. A little soft for my liking, though.{/i}"
    mct "{i}É agradável ao toque. Um pouco macio demais para o meu gosto, porém.{/i}"

# game/chapters/chapter5/script/ch5sc11.rpy:2060
translate brazil ch5sc11_81b4e542:

#   mct "{i}Sweet mother’s mercy... It feels like I’m floating on a cloud. What the hell is this thing made of?{/i}"
    mct "{i}Graças a Deus... Parece que estou flutuando em uma nuvem. Do que diabos é feito isso?{/i}"

# game/chapters/chapter5/script/ch5sc11.rpy:2062
translate brazil ch5sc11_d9795d98:

#   mct "{i}Ohhh... That’s the spot. Yeah... Definitely saving up for one of these for the house.{/i}"
    mct "{i}Ahhh... É esse o lugar. Sim... Com certeza vou juntar dinheiro para comprar um desses para casa.{/i}"

# game/chapters/chapter5/script/ch5sc11.rpy:2064
translate brazil ch5sc11_00e78eb0:

#   mct "{i}Surely it... *Yawns* it can't be that expensive? ZzZz...{/i}"
