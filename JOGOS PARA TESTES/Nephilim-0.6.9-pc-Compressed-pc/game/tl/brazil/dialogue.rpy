translate brazil ch5sc2_ab09922b:

#   el "{b}*Moans* OH!! [mc]! YES!!{/b} I feel it! I feel you! {b}AHHHHHHH!{/b}"
    el "{b}*Gemidos* OH!! [mc]! SIM!!{/b} Eu sinto isso! Eu te sinto! {b} AHHHHHHH!{/b}"

# game/chapters/chapter5/script/ch5sc2.rpy:1333
translate brazil ch5sc2_41b5db7f:

#   el "{b}*Moans* Aiiiyhh!! YES!!!{/b}"
    el "{b}*Gemidos* Aiiiyhh!! SIM!!!{/b}"

