    "Enquanto a suposta líder se retira, as mulheres restantes cercam vocês três."

# game/chapters/chapter6/ch6sc8.rpy:533
translate brazil ch6sc8_e2c7ac41:

#   pl "I guess we’re going to the dungeons…"
    pl "Acho que vamos para as masmorras…"

# game/chapters/chapter6/ch6sc8.rpy:535
translate brazil ch6sc8_6d7e2c0a:

