# game/chapters/chapter4/script/ch4sc12.rpy:913
translate brazil ch4sc12_4fa9f227:

#   lll "*Grunts* Hnnrrrh. Bathing, yes."
    lll "*Grunhidos* Hnnrrrh. Banho, sim."

# game/chapters/chapter4/script/ch4sc12.rpy:915
translate brazil ch4sc12_ea386b7c:

#   lll "The ocean is so inviting tonight... wouldn’t you agree?"
    lll "O oceano está tão convidativo esta noite... você não concorda?"

# game/chapters/chapter4/script/ch4sc12.rpy:917
translate brazil ch4sc12_bdc30e79:

