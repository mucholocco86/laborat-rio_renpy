translate brazil ch7sc10_17921c82:

#   mc "You’ll be taken care of by some of my priestesses, you’ll be in capable hands."
    mc "Você será cuidado por algumas das minhas sacerdotisas, estará em boas mãos."

# game/chapters/chapter7/ch7sc10.rpy:307
translate brazil ch7sc10_8cb558db:

#   elt "She hurt [mc]..."
    elt "Ela se machucou [mc]..."

# game/chapters/chapter7/ch7sc10.rpy:308
translate brazil ch7sc10_57ea4322:

#   elt "She tried to kill him..."
    elt "Ela tentou matá-lo..."

# game/chapters/chapter7/ch7sc10.rpy:311
translate brazil ch7sc10_885597a0:

#   el "..."
    el "..."

# game/chapters/chapter7/ch7sc10.rpy:313
translate brazil ch7sc10_f93a6760:

#   mh "Hmm? Aren’t you going with them?"
    mh "Hum? Você não vai com eles?"

# game/chapters/chapter7/ch7sc10.rpy:316
translate brazil ch7sc10_c7fbbb4b:

#   mh "I suppose waiting here would be okay-"
    mh "Acho que esperar aqui não seria problema."

# game/chapters/chapter7/ch7sc10.rpy:319
translate brazil ch7sc10_3170906b:

#   mh "*Gasps* Y-Your eyes!"
    mh "*Suspiros* S-Seus olhos!"

# game/chapters/chapter7/ch7sc10.rpy:328
translate brazil ch7sc10_90427335:

#   mh "*Gasps for air* Hhrrh! Hnnghh!"
    mh "*Respira fundo* Hhrrh! Hnnghh!"

# game/chapters/chapter7/ch7sc10.rpy:330
translate brazil ch7sc10_5f38a47f:

#   el "{b}Spare me your pleasantries!{/b}"
    el "{b}Poupe-me das suas gentilezas!{/b}"

# game/chapters/chapter7/ch7sc10.rpy:332
translate brazil ch7sc10_61044374:

#   mh "Hrrgh! D-Demon!"
    mh "Hrrgh! D-Demônio!"

# game/chapters/chapter7/ch7sc10.rpy:333
translate brazil ch7sc10_66d69c6d:

#   el "Oh I’m a demon alright."
    el "Ah, eu sou um demônio, com certeza."

# game/chapters/chapter7/ch7sc10.rpy:334
translate brazil ch7sc10_07c551fa:

#   el "I'm your worst nightmare, Marah."
    el "Eu sou o seu pior pesadelo, Marah."

# game/chapters/chapter7/ch7sc10.rpy:336
translate brazil ch7sc10_b226db52:

#   el "Let’s get one thing straight."
    el "Vamos deixar uma coisa bem clara."

# game/chapters/chapter7/ch7sc10.rpy:337
translate brazil ch7sc10_96c18b46:

#   el "The only reason your head is still attached to your body is because [mc] decided to give you a second chance."
    el "A única razão pela qual sua cabeça ainda está presa ao seu corpo é porque [mc] Decidi te dar uma segunda chance."

# game/chapters/chapter7/ch7sc10.rpy:338
translate brazil ch7sc10_59134901:

#   el "For some reason he thinks you can be of value to him."
    el "Por algum motivo, ele acha que você pode ser útil para ele."

# game/chapters/chapter7/ch7sc10.rpy:340
translate brazil ch7sc10_4c7aad07:

#   el "For your sake I suggest you spend the rest of your life proving him right."
    el "Para o seu próprio bem, sugiro que passe o resto da vida provando que ele está certo."

# game/chapters/chapter7/ch7sc10.rpy:341
translate brazil ch7sc10_27c2c02b:

#   el "If you ever betray him again… if I even see you looking at him in a way I don’t like…"
    el "Se você o trair novamente... se eu sequer vir você olhando para ele de um jeito que eu não goste..."

# game/chapters/chapter7/ch7sc10.rpy:343
translate brazil ch7sc10_eea5b571:

#   mh "I- hrrh… I’ll never betray him… hngghh… he’s everything to me."
    mh "Eu... hrrh... Eu nunca o trairei... hngghh... ele é tudo para mim."

# game/chapters/chapter7/ch7sc10.rpy:345
translate brazil ch7sc10_636bf30c:

#   el "I don’t care what you think he is to you!"
    el "Não me importa o que você pense que ele seja para você!"

# game/chapters/chapter7/ch7sc10.rpy:346
translate brazil ch7sc10_8903852d:

#   el "I’m already pissed I can’t kill you for hurting him."
    el "Já estou irritado por não poder te matar por tê-lo machucado."

# game/chapters/chapter7/ch7sc10.rpy:348
translate brazil ch7sc10_ef7cd900:

#   el "But one wrong move on your part and I will, that’s a promise."
    el "Mas um passo em falso da sua parte e eu... isso é uma promessa."

# game/chapters/chapter7/ch7sc10.rpy:349
translate brazil ch7sc10_a4376635:

#   el "Anyone hurts [mc]... they’ll answer to me."
    el "Qualquer um que se machuque [mc]...eles responderão a mim."

# game/chapters/chapter7/ch7sc10.rpy:355
translate brazil ch7sc10_a40397f2:

#   el "Nice meeting you… Marah."
    el "Prazer em conhecê-lo(a)... Irritado(a)."

# game/chapters/chapter7/ch7sc10.rpy:356
translate brazil ch7sc10_6bd17e28:

#   mh "*Gasping* Hnnghh… you should… nhhgh… know this…"
    mh "*Ofegante* Hnnghh… você deveria… nhhgh… saber disso…"

# game/chapters/chapter7/ch7sc10.rpy:358
translate brazil ch7sc10_86994624:

#   mh "I’m not sorry for my actions back then."
    mh "Não me arrependo das minhas ações daquela época."

# game/chapters/chapter7/ch7sc10.rpy:359
translate brazil ch7sc10_fcf063ed:

#   mh "I acted in the interest of the tribe with the information I had at the time."
    mh "Agi no interesse da tribo com as informações que tinha na época."

# game/chapters/chapter7/ch7sc10.rpy:361
translate brazil ch7sc10_b15504be:

#   mh "My precious A’khan… [mc]... he was an outsider at the time, an unknown potential threat."
    mh "Meu precioso A'khan… [mc]... ele era um forasteiro na época, uma ameaça potencial desconhecida."

# game/chapters/chapter7/ch7sc10.rpy:362
translate brazil ch7sc10_9b3bb3b6:

#   mh "Seeing an outsider in our midst, a man no less… old wounds burst open and… the pain of the past came gushing out."
    mh "Ao vermos um forasteiro entre nós, um homem, nada menos… antigas feridas se reabriram e… a dor do passado jorrou."

# game/chapters/chapter7/ch7sc10.rpy:364
translate brazil ch7sc10_b788e408:

#   mh "I will always protect A’nai."
    mh "Eu sempre protegerei A'nai."

# game/chapters/chapter7/ch7sc10.rpy:365
translate brazil ch7sc10_33edede7:

#   mh "[mc] has become our A’khan, he has become… A’nai."
    mh "[mc] tornou-se o nosso A'khan, tornou-se… A'nai."

# game/chapters/chapter7/ch7sc10.rpy:366
translate brazil ch7sc10_5b8c1e68:

#   mh "I will protect and cherish him as I do the village, until I draw my last breath."
    mh "Eu o protegerei e o amarei como amo a aldeia, até meu último suspiro."

# game/chapters/chapter7/ch7sc10.rpy:368
translate brazil ch7sc10_8bc469e9:

#   el "I... I can understand wanting to protect what's precious to you."
    el "Eu... eu entendo querer proteger aquilo que lhe é precioso."

# game/chapters/chapter7/ch7sc10.rpy:369
translate brazil ch7sc10_be2a024b:

#   el "For your sake, I hope your words carry the truth."
    el "Por você, espero que suas palavras transmitam a verdade."

# game/chapters/chapter7/ch7sc10.rpy:370
translate brazil ch7sc10_174872c2:

#   mh "We're in our sacred hut, the goddesses are witness to my words and the truth within them."
    mh "Estamos em nossa cabana sagrada, as deusas são testemunhas das minhas palavras e da verdade nelas contida."

# game/chapters/chapter7/ch7sc10.rpy:371
translate brazil ch7sc10_7e3beb00:

#   el "I'm... I'm sorry if I was a little rough... my emotions got the better of me."
    el "Me desculpe se fui um pouco rude... minhas emoções me dominaram."

# game/chapters/chapter7/ch7sc10.rpy:372
translate brazil ch7sc10_64a280ac:

#   mh "*Groans softly* It's okay... I understand your aggression."
    mh "*Geme baixinho* Tudo bem... Eu entendo sua agressividade."

# game/chapters/chapter7/ch7sc10.rpy:381
translate brazil ch7sc10_59b4687d:

#   mct "I forgot how peaceful the nights are out here."
    mct "Eu tinha me esquecido de como as noites são tranquilas por aqui."

# game/chapters/chapter7/ch7sc10.rpy:382
translate brazil ch7sc10_fd900071:

#   mct "It feels good to be back, like a home away from home."
    mct "É bom estar de volta, como um lar longe de casa."

# game/chapters/chapter7/ch7sc10.rpy:384
translate brazil ch7sc10_0ba37ca7:

#   mct "There she is."
    mct "Ali está ela."

# game/chapters/chapter7/ch7sc10.rpy:386
translate brazil ch7sc10_581ccf86:

#   el "She’s all yours."
    el "Ela é toda sua."

# game/chapters/chapter7/ch7sc10.rpy:387
translate brazil ch7sc10_754e7f80:

#   "You feel Eliza’s soft breast squish against your tricep while her fingers trace your bicep."
    "Você sente o seio macio de Eliza pressionando seu tríceps enquanto os dedos dela deslizam pelo seu bíceps."

# game/chapters/chapter7/ch7sc10.rpy:389
translate brazil ch7sc10_c1c11cc7:

#   mc "*Chuckles* I’m not walking in on a corpse, am I?"
    mc "*Risos* Não estou me deparando com um cadáver, estou?"

# game/chapters/chapter7/ch7sc10.rpy:396
translate brazil ch7sc10_2653476b:

#   mc "Eliza…"
    mc "Eliza…"

# game/chapters/chapter7/ch7sc10.rpy:398
translate brazil ch7sc10_1c7e1fd3:

#   el "I didn’t kill her!"
    el "Eu não a matei!"

# game/chapters/chapter7/ch7sc10.rpy:399
translate brazil ch7sc10_27e4dd37:

#   el "But she would totally deserve it if I did!"
    el "Mas ela mereceria totalmente se eu fizesse isso!"

# game/chapters/chapter7/ch7sc10.rpy:401
translate brazil ch7sc10_3fa5e3e8:

#   mc "*Chuckles* You’re cute when you get all protective over me."
    mc "*Risos* Você fica tão fofo quando se torna todo protetor comigo."

# game/chapters/chapter7/ch7sc10.rpy:403
translate brazil ch7sc10_1143cd6f:

#   el "Hmpfh."
    el "Hum."

# game/chapters/chapter7/ch7sc10.rpy:407
translate brazil ch7sc10_cd059bca:

#   el "....."
    el "....."

# game/chapters/chapter7/ch7sc10.rpy:409
translate brazil ch7sc10_e77d2bbe:

#   el "H-How much did you hear?"
    el "H-Quanto você ouviu?"

# game/chapters/chapter7/ch7sc10.rpy:411
translate brazil ch7sc10_bc2f48cb:

#   mc "Enough… you didn’t hold back."
    mc "Chega… você não se conteve."

# game/chapters/chapter7/ch7sc10.rpy:413
translate brazil ch7sc10_a15e52bd:

#   el "I’ll never hold back when it comes to your safety."
    el "Eu nunca vou hesitar quando se trata da sua segurança."

# game/chapters/chapter7/ch7sc10.rpy:415
translate brazil ch7sc10_3676de7a:

#   el "Are you mad at me?"
    el "Você está bravo comigo?"

# game/chapters/chapter7/ch7sc10.rpy:417
translate brazil ch7sc10_6f52b7fd:

#   mc "*Chuckles* You know me better than to think I’d be mad at you, especially over this."
    mc "*Risos* Você me conhece bem o suficiente para saber que eu não ficaria bravo com você, principalmente por causa disso."

# game/chapters/chapter7/ch7sc10.rpy:418
translate brazil ch7sc10_ca3855f4:

#   mc "But try to avoid threatening the locals any further, I’d like for them to enjoy our visits."
    mc "Mas tente evitar ameaçar ainda mais os moradores locais, eu gostaria que eles aproveitassem nossas visitas."

# game/chapters/chapter7/ch7sc10.rpy:420
translate brazil ch7sc10_7180291e:

#   el "Me too! It made me really happy when you invited me to come, like… really happy!"
    el "Eu também! Fiquei muito feliz quando você me convidou para vir, tipo... muito feliz mesmo!"

# game/chapters/chapter7/ch7sc10.rpy:422
translate brazil ch7sc10_f447e7f2:

#   el "I want to make friends with the tribe, I just needed to get the point across to that... one."
    el "Quero fazer amizade com a tribo, só precisava deixar isso bem claro para aquela... pessoa."

# game/chapters/chapter7/ch7sc10.rpy:423
translate brazil ch7sc10_c0bebb1c:

#   el "I don’t want her thinking she got off easy."
    el "Não quero que ela pense que se safou fácil."

# game/chapters/chapter7/ch7sc10.rpy:425
translate brazil ch7sc10_8c4325b1:

#   mc "*Chuckles* Hmffh, she definitely won’t be thinking that after the scolding you just handed her."
    mc "*Risos* Hmffh, ela definitivamente não vai pensar isso depois da bronca que você acabou de dar nela."

# game/chapters/chapter7/ch7sc10.rpy:427
translate brazil ch7sc10_880ea825:

#   el "Hey... how are you feeling?"
    el "Ei... como você está se sentindo?"

# game/chapters/chapter7/ch7sc10.rpy:428
translate brazil ch7sc10_173609aa:

#   el "You know... after getting us through the portal?"
    el "Sabe... depois de nos ajudar a atravessar o portal?"

# game/chapters/chapter7/ch7sc10.rpy:430
translate brazil ch7sc10_92e5c6e7:

#   mc "I feel fine, I definitely felt it take a substantial amount of my energy as we went through."
    mc "Eu me sinto bem, mas definitivamente senti que isso consumiu uma quantidade considerável da minha energia durante o processo."

# game/chapters/chapter7/ch7sc10.rpy:431
translate brazil ch7sc10_a13ebd97:

#   mc "I was a little lightheaded when we got here but my body feels like it has recovered."
    mc "Cheguei aqui com um pouco de tontura, mas meu corpo já se recuperou."

# game/chapters/chapter7/ch7sc10.rpy:433
translate brazil ch7sc10_7928641f:

#   el "Okay... that's better than I had expected to be honest, I thought you'd have to lay down."
    el "Ok... para ser sincera, isso é melhor do que eu esperava. Achei que você teria que se deitar."

# game/chapters/chapter7/ch7sc10.rpy:434
translate brazil ch7sc10_5118d159:

#   el "Just... take it easy okay?"
    el "Só... relaxa, tá bom?"

# game/chapters/chapter7/ch7sc10.rpy:436
translate brazil ch7sc10_5aa25d30:

#   el "This is your first time doing the portal, it could have delayed effects."
    el "Esta é a sua primeira vez acessando o portal, portanto, os efeitos podem ser retardados."

# game/chapters/chapter7/ch7sc10.rpy:438
translate brazil ch7sc10_82ff4a78:

#   mc "Yeah... you're right."
    mc "Sim... você tem razão."

# game/chapters/chapter7/ch7sc10.rpy:439
translate brazil ch7sc10_ae79f3b4:

#   mc "Maia did mention that using these portals could cause my body to have a delayed reaction."
    mc "Maia mencionou que usar esses portais poderia causar uma reação tardia no meu corpo."

# game/chapters/chapter7/ch7sc10.rpy:441
translate brazil ch7sc10_3442e0ef:

#   el "Exactly, so we should probably take it easy for a couple of hours at least."
    el "Exatamente, então provavelmente devemos pegar leve por pelo menos algumas horas."

# game/chapters/chapter7/ch7sc10.rpy:442
translate brazil ch7sc10_28f9ba40:

#   el "To make sure you don't pass out suddenly, it's your first time creating the portal."
    el "Para garantir que você não desmaie de repente, esta é a sua primeira vez criando o portal."

# game/chapters/chapter7/ch7sc10.rpy:444
translate brazil ch7sc10_28fd5c79:

#   mc "I agree... and I brought all three of us through."
    mc "Concordo... e eu trouxe nós três conosco."

# game/chapters/chapter7/ch7sc10.rpy:445
translate brazil ch7sc10_0e34c2c3:

#   mc "We'll take it easy, I'll catch up with you after I've talked to Marah."
    mc "Vamos com calma, falo com você depois que conversar com a Marah."

# game/chapters/chapter7/ch7sc10.rpy:446
translate brazil ch7sc10_9eb660cb:

#   "Eliza nods."
    "Eliza acena com a cabeça."

# game/chapters/chapter7/ch7sc10.rpy:448
translate brazil ch7sc10_ba6098f3:

#   el "I’ll go check on Rin while you finish talking to Marah."
    el "Vou ver como está a Rin enquanto você termina de falar com a Marah."

# game/chapters/chapter7/ch7sc10.rpy:450
translate brazil ch7sc10_a32e75d5:

#   el "You took her to the big temple over there?"
    el "Você a levou ao grande templo ali?"

# game/chapters/chapter7/ch7sc10.rpy:451
translate brazil ch7sc10_6b9d2a56:

#   el "I don't see any entrance other than at the top?"
    el "Não vejo nenhuma outra entrada além da que fica no topo?"

# game/chapters/chapter7/ch7sc10.rpy:453
translate brazil ch7sc10_4e5d8484:

#   mc "Yeah it's not visible from this side."
    mc "Sim, não é visível deste lado."

# game/chapters/chapter7/ch7sc10.rpy:454
translate brazil ch7sc10_978cfb10:

#   mc "Go around the left side and about halfway up there’s an entrance off to the side."
    mc "Contorne pelo lado esquerdo e, mais ou menos na metade do caminho, você encontrará uma entrada lateral."

# game/chapters/chapter7/ch7sc10.rpy:455
translate brazil ch7sc10_635a6457:

#   mc "It’ll lead you to a large room with a natural pool inside, there’s a couple of priestesses already, just be upfront about who you are."
    mc "Você chegará a uma sala grande com uma piscina natural no interior. Já há algumas sacerdotisas lá; basta ser sincero sobre quem você é."

# game/chapters/chapter7/ch7sc10.rpy:457
translate brazil ch7sc10_7569c409:

#   el "Left side of temple, about halfway up, got it. See you soon…"
    el "Lado esquerdo do templo, mais ou menos na metade da subida, consegui. Até logo…"

# game/chapters/chapter7/ch7sc10.rpy:459
translate brazil ch7sc10_1ee29024:

#   mc "See you soon, Kitten."
    mc "Até breve, gatinha."

# game/chapters/chapter7/ch7sc10.rpy:461
translate brazil ch7sc10_83e1e8ff:

#   el "Sooner rather than later please… I’d like you to show me around the village."
    el "O mais breve possível, por favor... Gostaria que você me mostrasse a vila."

# game/chapters/chapter7/ch7sc10.rpy:463
translate brazil ch7sc10_43dfe728:

#   mc "A moonlit stroll through A’nai with my very own Moonkitten? Deal."
    mc "Um passeio ao luar por A'nai com a minha própria gatinha lunar? Combinado."

# game/chapters/chapter7/ch7sc10.rpy:464
translate brazil ch7sc10_b8c3a548:

#   el "Don’t take too long, Moonkitten’s aren’t known for being patient! *Giggles*"
    el "Não demore muito, os gatinhos da Lua não são conhecidos por serem pacientes! *Risos*"

# game/chapters/chapter7/ch7sc10.rpy:465
translate brazil ch7sc10_31eb9462:

#   el "My claws might just come out if you keep me waiting!"
    el "Se você me fizer esperar, minhas garras podem aparecer!"

# game/chapters/chapter7/ch7sc10.rpy:466
translate brazil ch7sc10_745c920a:

#   mc "Threatening me with a good time are we? *Chuckles*"
    mc "Está me ameaçando com uma noite inesquecível, é? *Risos*"

# game/chapters/chapter7/ch7sc10.rpy:467
translate brazil ch7sc10_4fe52f4f:

#   el "Don’t tempt me!"
    el "Não me tente!"

# game/chapters/chapter7/ch7sc10.rpy:476
translate brazil ch7sc10_8aba305e:

#   mh "Thank you… you truly answered my prayers despite how selfish they were…"
    mh "Obrigada… você realmente atendeu às minhas orações, apesar de quão egoístas elas parecessem…"

# game/chapters/chapter7/ch7sc10.rpy:477
translate brazil ch7sc10_d0d74c65:

#   mh "I shan’t take this blessing for granted."
    mh "Não vou encarar essa bênção como algo garantido."

# game/chapters/chapter7/ch7sc10.rpy:479
translate brazil ch7sc10_f1405e1d:

#   mh "You’ve brought him back to us… to me."
    mh "Você o trouxe de volta para nós... para mim."

# game/chapters/chapter7/ch7sc10.rpy:480
translate brazil ch7sc10_caff478c:

#   mh "I will not waste this chance you’ve given me… this chance to redeem myself."
    mh "Não vou desperdiçar esta oportunidade que você me deu… esta oportunidade de me redimir."

# game/chapters/chapter7/ch7sc10.rpy:482
translate brazil ch7sc10_ff709f4f:

#   mh "I will be worthy of this blessing…"
    mh "Serei digno dessa bênção…"

# game/chapters/chapter7/ch7sc10.rpy:483
translate brazil ch7sc10_d0dbbf20:

#   mh "I will earn his affections… his love."
    mh "Conquistarei seu afeto... seu amor."

# game/chapters/chapter7/ch7sc10.rpy:485
translate brazil ch7sc10_01a5535c:

#   mh "Maidens… thank you."
    mh "Donzelas… obrigada."

# game/chapters/chapter7/ch7sc10.rpy:486
translate brazil ch7sc10_b73ecb34:

#   mh "Because of this blessing, our huntresses will return to us in good health… I can feel it."
    mh "Graças a essa bênção, nossas caçadoras retornarão para nós com boa saúde... Eu posso sentir isso."

# game/chapters/chapter7/ch7sc10.rpy:487
translate brazil ch7sc10_86ef4c33:

#   mh "He… He will ensure it."
    mh "Ele... Ele vai garantir isso."

# game/chapters/chapter7/ch7sc10.rpy:489
translate brazil ch7sc10_feffcb91:

#   mc "*Clears throat* Ahem… hey."
    mc "*Limpa a garganta* Hum… olá."

# game/chapters/chapter7/ch7sc10.rpy:490
translate brazil ch7sc10_a0ef932b:

#   mh "*Gasps* My A’khan!? By the goddesses… you startled me."
    mh "*Suspiros* Meu A'khan!? Pelas deusas... você me assustou."

# game/chapters/chapter7/ch7sc10.rpy:491
translate brazil ch7sc10_52a9cd96:

#   mc "Sorry, didn’t mean to sneak up on you… you wanted to talk?"
    mc "Desculpe, não queria te assustar... você queria conversar?"

# game/chapters/chapter7/ch7sc10.rpy:493
translate brazil ch7sc10_63e17b84:

#   mh "Please never apologize for your presence… It’s something I’ve come to… enjoy."
    mh "Por favor, nunca se desculpe por sua presença... É algo que aprendi a... apreciar."

# game/chapters/chapter7/ch7sc10.rpy:494
translate brazil ch7sc10_cd7b2c0b:

#   mh "*Sighs* I’m afraid it isn’t pleasant news I wish to discuss tonight."
