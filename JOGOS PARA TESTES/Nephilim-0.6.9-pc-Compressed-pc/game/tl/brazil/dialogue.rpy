# game/chapters/chapter2/script/ch2sc10.rpy:357
translate brazil ch2sc10_66696342:

#   my "Especially after all these years."
    my "Principalmente depois de todos esses anos."

# game/chapters/chapter2/script/ch2sc10.rpy:359
translate brazil ch2sc10_f37df085:

#   mc "What are you talking about? A woman like you isn't being showered in compliments by your husband daily?"
    mc "Do que você está falando? Uma mulher como você não recebe elogios do seu marido diariamente?"

# game/chapters/chapter2/script/ch2sc10.rpy:360
translate brazil ch2sc10_9ce17bc1:

