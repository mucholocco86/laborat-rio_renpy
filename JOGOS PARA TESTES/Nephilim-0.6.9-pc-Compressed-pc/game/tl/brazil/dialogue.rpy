    mct "Ela já passou por uma montanha-russa de emoções hoje."

# game/chapters/chapter4/script/ch4sc19.rpy:3617
translate brazil ch4sc19_2b8a539f:

#   mc "*Whispers* You’re off the hook... for now."
    mc "*Sussurrando* Você está livre... por enquanto."

# game/chapters/chapter4/script/ch4sc19.rpy:3619
translate brazil ch4sc19_653a0f23:

#   "She turns her head and locks lips with you, sucking gently a few times before she moves out from under you."
    "Ela vira a cabeça e te beija, sugando suavemente algumas vezes antes de se afastar de você."

# game/chapters/chapter4/script/ch4sc19.rpy:3627
translate brazil ch4sc19_a791581a:

#   mc "Sorry. I got caught up in the moment... Let’s get into bed."
    mc "Desculpe. Me empolguei no momento... Vamos para a cama."

# game/chapters/chapter4/script/ch4sc19.rpy:3628
translate brazil ch4sc19_bbdf3800:

#   el "............"
    el "............"

# game/chapters/chapter4/script/ch4sc19.rpy:3629
translate brazil ch4sc19_aed4df13:

#   el "*Sighs heavily* Okay..."
    el "*Suspira profundamente* Ok..."

# game/chapters/chapter4/script/ch4sc19.rpy:3635
translate brazil ch4sc19_e3f78ad3:

#   el "This!"
    el "Esse!"

# game/chapters/chapter4/script/ch4sc19.rpy:3638
translate brazil ch4sc19_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/chapters/chapter4/script/ch4sc19.rpy:3639
translate brazil ch4sc19_fcd98ef4:

#   el "I’ve been looking forward to this all day."
    el "Estive ansioso por isso o dia todo."

# game/chapters/chapter4/script/ch4sc19.rpy:3641
translate brazil ch4sc19_9fe34076:

#   mc "I’m spoiling you too much... I should be whipping you into shape."
    mc "Estou te mimando demais... Eu deveria estar te colocando na linha."

# game/chapters/chapter4/script/ch4sc19.rpy:3643
translate brazil ch4sc19_48ab34d5:

#   el "Luckily, I'm already in shape. So... spoil away!"
    el "Por sorte, já estou em forma. Então... podem me dar os parabéns à vontade!"

# game/chapters/chapter4/script/ch4sc19.rpy:3645
translate brazil ch4sc19_66a5117a:

#   mc "*Chuckles*"
    mc "*Risos*"

# game/chapters/chapter4/script/ch4sc19.rpy:3646
translate brazil ch4sc19_2aba1632:

#   mc "Hey, what's that scroll on your nightstand?"
    mc "Ei, o que é esse pergaminho na sua mesa de cabeceira?"

# game/chapters/chapter4/script/ch4sc19.rpy:3648
translate brazil ch4sc19_b4e347f1:

#   el "Oh, that? It’s... a surprise!"
    el "Ah, isso? É... uma surpresa!"

# game/chapters/chapter4/script/ch4sc19.rpy:3649
translate brazil ch4sc19_79030287:

#   mc "Now I’m curious... Tell me?"
    mc "Agora fiquei curioso... Conte-me?"

# game/chapters/chapter4/script/ch4sc19.rpy:3651
translate brazil ch4sc19_4187f351:

#   el "Too bad! You’ll have to wait!"
    el "Que pena! Você terá que esperar!"

# game/chapters/chapter4/script/ch4sc19.rpy:3653
translate brazil ch4sc19_87c64fc1:

#   mc "I hate waiting... makes me anxious."
    mc "Eu detesto esperar... isso me deixa ansioso."

# game/chapters/chapter4/script/ch4sc19.rpy:3655
translate brazil ch4sc19_22702bf9:

#   el "Nice try! My lips are sealed! It’s a surprise for you... Telling you would make it less exciting!"
    el "Boa tentativa! Meus lábios estão selados! É uma surpresa para você... Contar só tornaria tudo menos emocionante!"

# game/chapters/chapter4/script/ch4sc19.rpy:3656
translate brazil ch4sc19_0b2ae063:

#   el "There’s absolutely no way that you’ll get it out of me- {b}Eeeeeeee!!{/b}"
    el "Não há a mínima chance de você conseguir arrancar isso de mim. {b} Eeeeeeeee!!{/b}"

# game/chapters/chapter4/script/ch4sc19.rpy:3659
translate brazil ch4sc19_5aaf14f4:

#   mc "Sorry, what were you saying? I didn’t quite catch that!"
    mc "Desculpe, o que você estava dizendo? Não entendi direito!"

# game/chapters/chapter4/script/ch4sc19.rpy:3660
translate brazil ch4sc19_85fcd332:

#   el "{b}*Laughing* Hahahah! N-No! Stop!!{/b}"
    el "{b}*Risos* Hahahah! N-Não! Pare!!{/b}"

# game/chapters/chapter4/script/ch4sc19.rpy:3662
translate brazil ch4sc19_a4f975b3:

#   mc "All you have to do is tell me what the scroll is."
    mc "Basta você me dizer o que é o pergaminho."

# game/chapters/chapter4/script/ch4sc19.rpy:3664
translate brazil ch4sc19_2c792588:

#   el "{b}*Laughing* NhooO! Hahahh! Hands off my butt! It tickles!{/b}"
    el "{b}*Risos* NhooO! Hahahh! Tirem as mãos da minha bunda! Faz cócegas!{/b}"

# game/chapters/chapter4/script/ch4sc19.rpy:3666
translate brazil ch4sc19_08a6eb5d:

#   mc "You mean this perky little thing is ticklish?"
    mc "Quer dizer que essa coisinha animada tem cócegas?"

# game/chapters/chapter4/script/ch4sc19.rpy:3669
translate brazil ch4sc19_e6c9de93:

#   el "{b}*Squeals* Aiyyeee! SHTOOPP! Mercy! Hahahhhhaha!{/b}"
    el "{b}*gritos* Aiyyeee! SHTOOPP! Misericórdia! Hahahhaha!{/b}"

# game/chapters/chapter4/script/ch4sc19.rpy:3670
translate brazil ch4sc19_65dff5d4:

#   el "I’ll tell you everything! I promise!"
    el "Eu vou te contar tudo! Prometo!"

# game/chapters/chapter4/script/ch4sc19.rpy:3672
translate brazil ch4sc19_3a39b662:

#   mc "That’s more like it."
    mc "Isso sim é que é bom."

# game/chapters/chapter4/script/ch4sc19.rpy:3673
translate brazil ch4sc19_2d8d48e8:

#   "You grab her by the hips and pull her back into the bed."
    "Você a agarra pelos quadris e a puxa de volta para a cama."

# game/chapters/chapter4/script/ch4sc19.rpy:3675
translate brazil ch4sc19_4e5dbefb:

#   el "You’re very hands-on today."
    el "Você está muito participativo hoje."

# game/chapters/chapter4/script/ch4sc19.rpy:3677
translate brazil ch4sc19_3f20eb35:

#   mc "Sorry, I got a little carried away."
    mc "Desculpe, me empolguei um pouco."

# game/chapters/chapter4/script/ch4sc19.rpy:3679
translate brazil ch4sc19_60b59c98:

#   el "If you ever apologize for touching me again, I’ll... I’ll be really mad! No! Furious even!"
    el "Se você se desculpar por me tocar de novo, eu... eu vou ficar muito brava! Não! Furiosa mesmo!"

# game/chapters/chapter4/script/ch4sc19.rpy:3681
translate brazil ch4sc19_4fe8e2c9:

#   mct "Heh... This little cutie."
    mct "Hehe... Que gracinha."

# game/chapters/chapter4/script/ch4sc19.rpy:3682
translate brazil ch4sc19_7f09c0df:

#   mc "Noted. So what’s that scroll about?"
    mc "Anotado. Então, do que se trata esse pergaminho?"

# game/chapters/chapter4/script/ch4sc19.rpy:3684
translate brazil ch4sc19_913027be:

#   el "*Sigh* I promised, didn't I?"
    el "*Suspiro* Eu prometi, não prometi?"

# game/chapters/chapter4/script/ch4sc19.rpy:3685
translate brazil ch4sc19_e2d1806e:

#   mc "Yes, and there’s no take-backs."
    mc "Sim, e não há como voltar atrás."

# game/chapters/chapter4/script/ch4sc19.rpy:3687
translate brazil ch4sc19_31958dd6:

#   el "Okay. So, the scroll used to belong to Dalen. He got it as a reward when he graduated with honors from the academy."
    el "Certo. Então, o pergaminho pertencia a Dalen. Ele o recebeu como recompensa por se formar com honras na academia."

# game/chapters/chapter4/script/ch4sc19.rpy:3688
translate brazil ch4sc19_f3874667:

#   el "You remember when we talked before you left? About having a dream that goes beyond our revenge?"
    el "Você se lembra daquela conversa que tivemos antes de você ir embora? Sobre termos um sonho que vai além da nossa vingança?"

# game/chapters/chapter4/script/ch4sc19.rpy:3690
translate brazil ch4sc19_c4f1a042:

#   mc "I do. Finding a place to call... home."
    mc "Sim. Encontrar um lugar para chamar de... lar."

# game/chapters/chapter4/script/ch4sc19.rpy:3692
translate brazil ch4sc19_1ba7c157:

#   el "That’s what that scroll is. Home... our home."
    el "É isso que esse pergaminho representa. Lar... nosso lar."

# game/chapters/chapter4/script/ch4sc19.rpy:3694
translate brazil ch4sc19_b935241b:

#   el "Dalen wanted me to have it. He says I’ve earned it and that he doesn’t have a need for it..."
    el "Dalen queria que eu ficasse com ele. Ele diz que eu mereci e que ele não precisa mais dele..."

# game/chapters/chapter4/script/ch4sc19.rpy:3695
translate brazil ch4sc19_cea6d02d:

#   el "But that’s a cover... I think he feels guilty about drifting apart from Father after they graduated."
    el "Mas isso é só uma desculpa... Acho que ele se sente culpado por ter se afastado do pai depois que se formaram."

# game/chapters/chapter4/script/ch4sc19.rpy:3697
translate brazil ch4sc19_2231c39e:

#   el "And that he wasn’t there for me when Father left. Or when Mother left..."
    el "E que ele não estava lá para mim quando papai foi embora. Nem quando mamãe foi embora..."

# game/chapters/chapter4/script/ch4sc19.rpy:3699
translate brazil ch4sc19_0ad9cc7e:

#   el "Even though he doesn’t have to feel guilty about something that was out of his control."
    el "Mesmo que ele não precise se sentir culpado por algo que estava fora de seu controle."

# game/chapters/chapter4/script/ch4sc19.rpy:3700
translate brazil ch4sc19_b2a49e96:

#   el "He couldn’t have known about any of that. *Sigh* But he looked happy when I accepted it."
    el "Ele não tinha como saber de nada disso. *Suspiro* Mas ele pareceu feliz quando eu aceitei."

# game/chapters/chapter4/script/ch4sc19.rpy:3702
translate brazil ch4sc19_859ef0da:

#   mc "What is it? You call it home, but it’s just a scroll."
    mc "O que é isso? Você chama de lar, mas é apenas um pergaminho."

# game/chapters/chapter4/script/ch4sc19.rpy:3704
translate brazil ch4sc19_4133ab37:

#   el "It isn’t just a scroll! It’s the deed to a piece of land not far from here."
    el "Não é apenas um pergaminho! É a escritura de um terreno não muito longe daqui."

# game/chapters/chapter4/script/ch4sc19.rpy:3705
translate brazil ch4sc19_16b67e05:

#   el "Dalen said it doesn’t have any buildings yet. It's completely untouched."
    el "Dalen disse que ainda não há nenhuma construção. Está completamente intocado."

# game/chapters/chapter4/script/ch4sc19.rpy:3707
translate brazil ch4sc19_98e5518f:

#   mc "No buildings?"
    mc "Não há edifícios?"

# game/chapters/chapter4/script/ch4sc19.rpy:3709
translate brazil ch4sc19_2657bca8:

#   el "Yeah, so it will be up to the two of us to gather materials and make something out of it."
    el "Sim, então vai depender de nós dois reunir os materiais e fazer algo com eles."

# game/chapters/chapter4/script/ch4sc19.rpy:3710
translate brazil ch4sc19_47d53ef1:

#   el "Make it ours."
    el "Faça dele o nosso."

# game/chapters/chapter4/script/ch4sc19.rpy:3712
translate brazil ch4sc19_6e3b58a1:

#   mc "Eliza... that’s amazing. You really keep surprising me."
    mc "Eliza... isso é incrível. Você continua me surpreendendo."

# game/chapters/chapter4/script/ch4sc19.rpy:3713
translate brazil ch4sc19_7ed140e6:

#   mc "Dalen mentioned how hard you’ve been working, managing the guild with Sylph."
    mc "Dalen comentou o quanto você tem se esforçado, administrando a guilda com Sylph."

# game/chapters/chapter4/script/ch4sc19.rpy:3715
translate brazil ch4sc19_cd04a687:

#   el "Oh, I didn’t do much. They give me too much credit."
    el "Ah, eu não fiz muita coisa. Eles me dão crédito demais."

# game/chapters/chapter4/script/ch4sc19.rpy:3717
translate brazil ch4sc19_2cb6ef90:

#   mc "I don’t believe that for even a second..."
    mc "Não acredito nisso nem por um segundo..."

# game/chapters/chapter4/script/ch4sc19.rpy:3718
translate brazil ch4sc19_7a216bfc:

#   mc "I’m proud of you."
    mc "Tenho orgulho de você."

# game/chapters/chapter4/script/ch4sc19.rpy:3721
translate brazil ch4sc19_290cb338:

#   elt "I did it all for you..."
    elt "Fiz tudo isso por você..."

# game/chapters/chapter4/script/ch4sc19.rpy:3723
translate brazil ch4sc19_216cfaec:

#   elt "I love you so much."
    elt "Eu te amo muito."

# game/chapters/chapter4/script/ch4sc19.rpy:3725
translate brazil ch4sc19_51c49832:

#   el "*Sighs heavily* We'd better get some rest."
    el "*Suspira profundamente* É melhor irmos descansar."

# game/chapters/chapter4/script/ch4sc19.rpy:3726
translate brazil ch4sc19_0fac3528:

#   "After a quick shuffle, Eliza makes herself comfortable."
    "Após se ajeitar rapidamente, Eliza se acomoda."

# game/chapters/chapter4/script/ch4sc19.rpy:3729
translate brazil ch4sc19_8b26b030:

#   el "Ahhhh... Yes! I’ve been looking forward to this! *Giggles*"
    el "Ahhhh... Sim! Estava ansiosa por isso! *Risos*"

# game/chapters/chapter4/script/ch4sc19.rpy:3730
translate brazil ch4sc19_12b579f9:

#   el "My favorite heated pillow and head-scratches!"
    el "Meu travesseiro aquecido favorito e carinhos na cabeça!"

# game/chapters/chapter4/script/ch4sc19.rpy:3732
translate brazil ch4sc19_03854614:

#   mc "*Chuckles* You know this is a two-person bed?"
    mc "*Risos* Você sabe que esta é uma cama para duas pessoas?"

# game/chapters/chapter4/script/ch4sc19.rpy:3734
translate brazil ch4sc19_f0f91853:

#   el "Mh-Hm. I fail to see your point."
    el "Hum-hum. Não entendi seu ponto."

# game/chapters/chapter4/script/ch4sc19.rpy:3736
translate brazil ch4sc19_5510093c:

#   mc "My point is, maybe you could-"
    mc "O que eu quero dizer é que talvez você pudesse..."

# game/chapters/chapter4/script/ch4sc19.rpy:3738
translate brazil ch4sc19_d03da800:

#   el "If you finish that sentence, I’ll have an extra large bucket of cold water waiting for you in the morning."
    el "Se você terminar essa frase, terei um balde extra grande de água fria esperando por você amanhã de manhã."

# game/chapters/chapter4/script/ch4sc19.rpy:3739
translate brazil ch4sc19_6ab8b92d:

#   mct "*Sigh* I guess I’ll take the sleeping arm then... Women!"
    mct "*Suspiro* Acho que vou ficar com o braço que dorme então... Mulheres!"

# game/chapters/chapter4/script/ch4sc19.rpy:3741
translate brazil ch4sc19_0c7c8a0b:

#   mc "My side of the bed it is..."
    mc "É o meu lado da cama..."

# game/chapters/chapter4/script/ch4sc19.rpy:3743
translate brazil ch4sc19_ff2637b8:

#   el "Wise choice! Mhhh..."
    el "Escolha sábia! Hum..."

# game/chapters/chapter4/script/ch4sc19.rpy:3744
translate brazil ch4sc19_bd18cf1e:

#   el "Your side is so much more comfortable! It’s warm... and somehow smells like... timber?"
    el "Seu lado é muito mais confortável! É quentinho... e de alguma forma cheira a... madeira?"

# game/chapters/chapter4/script/ch4sc19.rpy:3745
translate brazil ch4sc19_36f88766:

#   el "Why do you smell like that? I’ve never seen you chop wood!"
    el "Por que você está com esse cheiro? Nunca te vi cortando lenha!"

# game/chapters/chapter4/script/ch4sc19.rpy:3747
translate brazil ch4sc19_17905aa4:

#   mc "*Chuckles* How should I know? It’s just my scent."
    mc "*Risos* Como eu vou saber? É só o meu cheiro."

# game/chapters/chapter4/script/ch4sc19.rpy:3749
translate brazil ch4sc19_934c7954:

#   el "*Giggles* I like it! And I especially like your head scratches, Mhhhh..."
    el "*Risos* Eu gostei! E gostei especialmente dos seus carinhos na cabeça, Mhhhh..."

# game/chapters/chapter4/script/ch4sc19.rpy:3750
translate brazil ch4sc19_4ab268f6:

#   el "Mhhh! Night, night!"
    el "Hum! Boa noite!"

# game/chapters/chapter4/script/ch4sc19.rpy:3751
translate brazil ch4sc19_08531868:

#   mct "Heh. She sure loves her cuddle time..."
    mct "Hehe. Ela adora mesmo um tempinho de carinho..."

# game/chapters/chapter4/script/ch4sc19.rpy:3755
translate brazil ch4sc19_e8b5fe03:

#   mc "Goodnight."
    mc "Boa noite."

# game/chapters/chapter4/script/ch4sc19.rpy:3769
translate brazil ch4sc19_7e183ae9:

#   mc "*Groggy* Hnngh... Eliza?"
    mc "*Gronguejando* Hnngh... Eliza?"

# game/chapters/chapter4/script/ch4sc19.rpy:3771
translate brazil ch4sc19_49777e69:

#   el "Wakey, wakey, eggs and bakey!"
    el "Acorda, acorda, ovos e pão!"

# game/chapters/chapter4/script/ch4sc19.rpy:3773
translate brazil ch4sc19_c2d72681:

#   mc "Urhh... Is the sun even up yet...?"
    mc "Hum... O sol já nasceu...?"

# game/chapters/chapter4/script/ch4sc19.rpy:3775
translate brazil ch4sc19_4bd89620:

#   el "It will be soon! Time to look alive!"
    el "Vai ser em breve! Hora de ficar animado!"

# game/chapters/chapter4/script/ch4sc19.rpy:3777
translate brazil ch4sc19_c9d25a54:

#   mc "Wake me when it’s dawn, you little morning monster."
    mc "Acorde-me quando amanhecer, seu pequeno monstro da manhã."

# game/chapters/chapter4/script/ch4sc19.rpy:3781
translate brazil ch4sc19_7e9602b4:

#   el "Morning monster? Would a monster do this?!"
    el "Monstro da manhã? Um monstro faria isso?!"

# game/chapters/chapter4/script/ch4sc19.rpy:3785
translate brazil ch4sc19_4000da22:

#   el "*Muah* And this..."
    el "*Muah* E isto..."

# game/chapters/chapter4/script/ch4sc19.rpy:3787
translate brazil ch4sc19_0d3b0339:

#   el "*Muah* Nnhhgh... *Mwah*"
    el "*Muah* Nnhhgh... *Mwah*"

# game/chapters/chapter4/script/ch4sc19.rpy:3789
translate brazil ch4sc19_9511c6ad:

#   mc "*Laughing* H-Hey! Attacking an unsuspecting victim is exactly what a monster would do!"
    mc "*Risos* Ei! Atacar uma vítima desprevenida é exatamente o que um monstro faria!"

# game/chapters/chapter4/script/ch4sc19.rpy:3791
translate brazil ch4sc19_820caeb6:

#   el "*Kiss* Nhooo! *Mwah* This is totally different! *Muah*"
    el "*Beijo* Nhooo! *Mwah* Isso é totalmente diferente! *Muah*"

# game/chapters/chapter4/script/ch4sc19.rpy:3793
translate brazil ch4sc19_b1e3e6fe:

#   el "*Mwaahh* These are- *Kiss* attacks of- Hnnghhh... affection!"
    el "*Mwaahh* Estes são- *Beijo* ataques de- Hnnghhh... afeto!"

# game/chapters/chapter4/script/ch4sc19.rpy:3794
translate brazil ch4sc19_97333e7c:

#   mct "Waking up with her is never boring... She’s grinding against me."
    mct "Acordar com ela nunca é entediante... Ela está se esfregando em mim."

# game/chapters/chapter4/script/ch4sc19.rpy:3796
translate brazil ch4sc19_c96453df:

#   mc "Okay, okay! I’m awake..."
    mc "Ok, ok! Estou acordado..."

# game/chapters/chapter4/script/ch4sc19.rpy:3798
translate brazil ch4sc19_1c5e8321:

#   el "Better be! You can’t sleep all day, you big ol’ sleepyhead!"
    el "É melhor que sim! Você não pode dormir o dia todo, seu dorminhoco!"

# game/chapters/chapter4/script/ch4sc19.rpy:3802
translate brazil ch4sc19_79767862:

#   el "C’mon! We have to get up, sleepyhead!"
    el "Vamos lá! Temos que levantar, dorminhoco!"

# game/chapters/chapter4/script/ch4sc19.rpy:3805
translate brazil ch4sc19_5d672314:

#   mc "Ugh... What's the rush? I could use a day where we sleep til at least noon..."
    mc "Aff... Qual a pressa? Eu bem que poderia passar um dia dormindo até pelo menos meio-dia..."

# game/chapters/chapter4/script/ch4sc19.rpy:3807
translate brazil ch4sc19_dd1c179d:

#   el "We’re going training! You always say I have to practice."
    el "Vamos treinar! Você sempre diz que eu preciso praticar."

# game/chapters/chapter4/script/ch4sc19.rpy:3809
translate brazil ch4sc19_47bf7e79:

#   mc "Sure... But does it have to be this early?"
    mc "Claro... Mas precisa ser tão cedo assim?"

# game/chapters/chapter4/script/ch4sc19.rpy:3811
translate brazil ch4sc19_bf0668e2:

#   el "Yes. I’m excited!"
    el "Sim! Estou animado!"

# game/chapters/chapter4/script/ch4sc19.rpy:3813
translate brazil ch4sc19_08683172:

#   mc "*Sigh* I couldn’t tell..."
    mc "*Suspiro* Não saberia dizer..."

# game/chapters/chapter4/script/ch4sc19.rpy:3815
translate brazil ch4sc19_b2acae85:

#   el "Let’s gooooo! Up and at 'em! *Giggles*"
    el "Vamos lá! Vamos com tudo! *Risos*"

# game/chapters/chapter4/script/ch4sc19.rpy:3823
translate brazil ch4sc19_655608d7:

#   el "*Nervous* How do you feel?"
    el "*Nervoso* Como você se sente?"

# game/chapters/chapter4/script/ch4sc19.rpy:3825
translate brazil ch4sc19_49b2617c:

#   mc "Tired..."
    mc "Cansado..."

