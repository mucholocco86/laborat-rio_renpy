translate brazil ch6sc8_0769b357:

#   pl "Uhh… [mc]... behind us…"
    pl "Hum… [mc]... atrás de nós…"

# game/chapters/chapter6/ch6sc8.rpy:511
translate brazil ch6sc8_fec1890d:

#   mc "Why are you doing this? Why do you have to kidnap and harm outsiders?"
    mc "Por que você está fazendo isso? Por que você precisa sequestrar e ferir pessoas de fora?"

