# game/chapters/chapter5/script/ch5sc09.rpy:17
translate brazil ch5sc09_af35e991:

#   wo "Hey, everyone! It’s Flynn! The hero who captured the mean panty-thief!"
    wo "Olá, pessoal! É o Flynn! O herói que capturou o ladrão de calcinhas malvado!"

# game/chapters/chapter5/script/ch5sc09.rpy:19
translate brazil ch5sc09_aa2e5cf8:

#   wo "Oh, Flynn! My hero! The legends were true about you!"
    wo "Oh, Flynn! Meu herói! As lendas sobre você eram verdadeiras!"

# game/chapters/chapter5/script/ch5sc09.rpy:20
translate brazil ch5sc09_19719371:

#   fy "Ladies, please. I didn't do it for rewards or glory. It was my solemn duty."
    fy "Senhoras, por favor. Eu não fiz isso por recompensas ou glória. Era meu dever solene."

# game/chapters/chapter5/script/ch5sc09.rpy:22
translate brazil ch5sc09_20eeba0b:

#   wo "Oh, Flynn. What can we ever do to thank you?"
    wo "Oh, Flynn. O que podemos fazer para te agradecer?"

# game/chapters/chapter5/script/ch5sc09.rpy:23
translate brazil ch5sc09_3e83550e:

#   wo "Let us be your harem! We’ll do anything you want!”"
    wo "Deixe-nos ser seu harém! Faremos tudo o que você quiser!"

# game/chapters/chapter5/script/ch5sc09.rpy:25
