translate brazil ch6sc9_2539fc36:

#   el "*Quietly* {size=-9}{b}Why didn’t you warn me?!{/b}{/size}"
    el "*Em silêncio* {size=-9}{b}Por que você não me avisou?!{/b}{/size}"

# game/chapters/chapter6/ch6sc9.rpy:3668
translate brazil ch6sc9_920db30d:

