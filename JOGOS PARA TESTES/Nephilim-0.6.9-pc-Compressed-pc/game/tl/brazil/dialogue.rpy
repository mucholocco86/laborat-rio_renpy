#   el "It’ll take more than a hungry wolf to beat him."
    el "Vai ser preciso mais do que um lobo faminto para derrotá-lo."

# game/chapters/chapter3/script/ch3sc10.rpy:216
translate brazil ch3sc10_3734fa7c:

#   el "Come, let’s get you back to the stables, we'll be safe there while we wait for [mc]."
    el "Vamos, vamos levá-lo de volta para os estábulos, lá estaremos seguros enquanto esperamos. [mc]."

# game/chapters/chapter3/script/ch3sc10.rpy:221
translate brazil ch3sc10_b3cb7503:

#   mc "It’s just me and you now."
    mc "Agora somos só eu e você."

# game/chapters/chapter3/script/ch3sc10.rpy:222
translate brazil ch3sc10_b701327a:

#   mc "I don’t suppose you’ll agree to just return to the woods and leave the horses alone?"
    mc "Imagino que você não concordaria em simplesmente voltar para a floresta e deixar os cavalos em paz, certo?"

# game/chapters/chapter3/script/ch3sc10.rpy:226
translate brazil ch3sc10_43938a5b:

#   "*Growls* Hhrrhh!"
    "*Rosna* Hhrrhh!"

# game/chapters/chapter3/script/ch3sc10.rpy:230
translate brazil ch3sc10_cba5159f:

#   mc "*Sigh* Let's see if what Rin taught me still works."
    mc "*Suspiro* Vamos ver se o que Rin me ensinou ainda funciona."

# game/chapters/chapter3/script/ch3sc10.rpy:235
translate brazil ch3sc10_5f18a81e:

#   ri "Look [mc]!"
    ri "Olhar [mc]!"

# game/chapters/chapter3/script/ch3sc10.rpy:236
translate brazil ch3sc10_b0ff4a46:

#   ri "We can practice on this cute little one over here."
    ri "Podemos praticar com essa criaturinha fofa aqui."

# game/chapters/chapter3/script/ch3sc10.rpy:238
translate brazil ch3sc10_ba8f9911:

#   mc "*Sigh* Rin…"
    mc "*Suspiro* Rin…"

# game/chapters/chapter3/script/ch3sc10.rpy:239
translate brazil ch3sc10_63a4fc15:

#   mc "The last five times we tried it didn’t work."
    mc "Nas últimas cinco vezes que tentamos, não funcionou."

# game/chapters/chapter3/script/ch3sc10.rpy:241
translate brazil ch3sc10_92194c3d:

#   ri "This time it will work!"
    ri "Dessa vez vai funcionar!"

# game/chapters/chapter3/script/ch3sc10.rpy:242
translate brazil ch3sc10_875c1a1e:

#   ri "I know it will."
    ri "Eu sei que vai acontecer."

# game/chapters/chapter3/script/ch3sc10.rpy:244
translate brazil ch3sc10_b84ce293:

#   ri "You almost had it last time remember?"
    ri "Você quase conseguiu da última vez, lembra?"

# game/chapters/chapter3/script/ch3sc10.rpy:245
translate brazil ch3sc10_aebe56e6:

#   ri "And this time I can feel it in my tummy! You will be able to do it!"
    ri "E desta vez eu consigo sentir na minha barriga! Você também vai conseguir!"

# game/chapters/chapter3/script/ch3sc10.rpy:246
translate brazil ch3sc10_266a6fa7:

#   ri "Close your eyes and remember what we practiced."
    ri "Feche os olhos e lembre-se do que praticamos."

# game/chapters/chapter3/script/ch3sc10.rpy:249
translate brazil ch3sc10_c12ec5b7:

#   mct "*Exhales* Okay... just like we practiced."
    mct "*Exala* Ok... exatamente como ensaiamos."

# game/chapters/chapter3/script/ch3sc10.rpy:253
translate brazil ch3sc10_b0d86800:

#   "You feel Rin’s soft fingers run through the back of your hair until they reach your temples."
    "Você sente os dedos macios de Rin deslizarem pela parte de trás do seu cabelo até chegarem às suas têmporas."

# game/chapters/chapter3/script/ch3sc10.rpy:254
translate brazil ch3sc10_7e84abe5:

#   ri "*Whispers* {size=-5}{b}Inhale deeply, tune out the sounds of the forest until all you hear is my voice and your heartbeat.{/b}{/size}"
    ri "*Sussurros* {size=-5}{b}Respire fundo, desligue-se dos sons da floresta até que tudo o que você ouça seja a minha voz e as batidas do seu coração.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc10.rpy:255
translate brazil ch3sc10_21b61fd4:

#   ri "*Whispers* {size=-5}{b}Feel the breeze on your skin as it flows through the woods.{/b}{/size}"
    ri "*Sussurros* {size=-5}{b}Sinta a brisa na sua pele enquanto ela flui pela floresta.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc10.rpy:256
translate brazil ch3sc10_123d2a76:

#   ri "*Whispers* {size=-5}{b}Focus on your intentions for this little creature. You are his friend. He can trust you, and you him.{/b}{/size}"
    ri "*Sussurros* {size=-5}{b}Concentre-se nas suas intenções para com essa criaturinha. Você é amigo dela. Ela pode confiar em você, e você nela.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc10.rpy:257
translate brazil ch3sc10_5ea41544:

#   ri "*Whispers* {size=-5}{b}You are ready, [mc]. Open your eyes and bond with him.{/b}{/size}"
    ri "*Sussurros* {size=-5}{b}Você está pronto, [mc] Abra os olhos e crie um vínculo com ele.{/b}{/size}"

# game/chapters/chapter3/script/ch3sc10.rpy:266
translate brazil ch3sc10_0ff34c74:

#   mc "*Exhales deeply*"
    mc "*Exala profundamente*"

# game/chapters/chapter3/script/ch3sc10.rpy:267
translate brazil ch3sc10_f1e09dcc:

#   mct "Just like you taught me... Rin."
    mct "Assim como você me ensinou... Rin."

# game/chapters/chapter3/script/ch3sc10.rpy:277
translate brazil ch3sc10_250aa8eb:

#   "Suddenly the large Direwolf seems to give in to your authority and relaxes."
    "De repente, o grande lobo gigante parece ceder à sua autoridade e relaxa."

# game/chapters/chapter3/script/ch3sc10.rpy:279
translate brazil ch3sc10_84123fbd:

#   mc "See? You can be a good puppy... we don’t have to hurt each other."
    mc "Viu? Você pode ser um bom cachorrinho... não precisamos nos machucar."

# game/chapters/chapter3/script/ch3sc10.rpy:280
