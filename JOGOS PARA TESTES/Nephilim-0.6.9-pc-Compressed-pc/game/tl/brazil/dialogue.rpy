translate brazil ch4sc12_b3433cbd:

#   lll "I know you get off on this, don't you?!"
    lll "Eu sei que você gosta disso, não é?!"

# game/chapters/chapter4/script/ch4sc12.rpy:942
translate brazil ch4sc12_d935e9b2:

#   lll "We both know you’re only good for one thing!"
    lll "Nós dois sabemos que você só serve para uma coisa!"

# game/chapters/chapter4/script/ch4sc12.rpy:943
translate brazil ch4sc12_4d248473:

#   kl "{b}OWWH!{/b} Let me go!"
    kl "{b}Ai!{/b} Me solte!"

# game/chapters/chapter4/script/ch4sc12.rpy:944
translate brazil ch4sc12_62298e22:

#   lll "From now on you’re going to do exactly as I say! You'll be taking care of my every hnnrrrh ... need."
    lll "A partir de agora, você fará exatamente o que eu mandar! Você cuidará de todas as minhas necessidades..."

# game/chapters/chapter4/script/ch4sc12.rpy:945
translate brazil ch4sc12_a70658d8:

#   lll "You'll be on your knees just like now, begging for me to satisfy you!"
    lll "Você estará de joelhos, assim como agora, implorando para que eu a satisfaça!"

# game/chapters/chapter4/script/ch4sc12.rpy:947
translate brazil ch4sc12_a9dacb28:

#   kl "*Crying*{b} N-No!{/b} Let me go, you creep!"
    kl "*Choro*{b} N-Não!{/b} Me solta, seu tarado!"

