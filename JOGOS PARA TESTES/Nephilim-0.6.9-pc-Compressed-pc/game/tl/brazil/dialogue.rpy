# game/chapters/chapter5/script/ch5sc07.rpy:958
translate brazil ch5sc07_9260e979:

#   frt "{i}And handsome. I could feel the heat radiating off his muscular body last time he sat in front of me.{/i}"
    frt "{i}E bonito. Consegui sentir o calor emanando de seu corpo musculoso da última vez que ele se sentou à minha frente.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:960
