#   "10 years later.."
    "10 anos depois..."

# game/chapters/chapter1_5/script/ch2sc1.rpy:22
translate brazil ch2sc1_9a7b3be6:

#   mct ".."
    mct "..."

# game/chapters/chapter1_5/script/ch2sc1.rpy:24
translate brazil ch2sc1_05eae1a5:

#   mct "....."
    mct "....."

# game/chapters/chapter1_5/script/ch2sc1.rpy:26
translate brazil ch2sc1_464be0b7:

#   mct "........."
    mct "........."

# game/chapters/chapter1_5/script/ch2sc1.rpy:28
translate brazil ch2sc1_3a4cfa2b:

#   mct "Should only be a few more days on the road now til I reach Riverside."
    mct "Só devo ter mais alguns dias de viagem até chegar a Riverside."

# game/chapters/chapter1_5/script/ch2sc1.rpy:30
translate brazil ch2sc1_26f2142f:

#   mct "I wonder if I’ll run into them?"
    mct "Será que um dia vou encontrá-los?"

# game/chapters/chapter1_5/script/ch2sc1.rpy:31
translate brazil ch2sc1_22672d5b:

#   mct "Old man Gibs... Flynn... Sabrina... Alice."
    mct "Velho Gibs... Flynn... Sabrina... Alice."

# game/chapters/chapter1_5/script/ch2sc1.rpy:33
translate brazil ch2sc1_8618fe36:

#   mct "No. I’ve got to avoid them, I can’t let them get involved."
    mct "Não. Tenho que evitá-los, não posso deixar que se envolvam."

# game/chapters/chapter1_5/script/ch2sc1.rpy:34
translate brazil ch2sc1_20fc02b4:

#   mct "But it sure would be nice to see them again. Fuck!"
    mct "Mas seria ótimo vê-los de novo. Droga!"

# game/chapters/chapter1_5/script/ch2sc1.rpy:35
translate brazil ch2sc1_6d2e6f93:

#   mct "Snap out of it, [mc]! You know it will only put them in danger."
    mct "Acorda pra vida! [mc] Você sabe que isso só os colocará em perigo."

# game/chapters/chapter1_5/script/ch2sc1.rpy:37
translate brazil ch2sc1_52983e88:

#   "You continue down the beaten path for a few miles."
    "Você continua seguindo o caminho já trilhado por alguns quilômetros."

# game/chapters/chapter1_5/script/ch2sc1.rpy:39
translate brazil ch2sc1_8dabefc6:

#   ".."
    "..."

# game/chapters/chapter1_5/script/ch2sc1.rpy:41
translate brazil ch2sc1_5f9b772e:

#   "...."
    "..."

# game/chapters/chapter1_5/script/ch2sc1.rpy:43
translate brazil ch2sc1_3928a113:

#   "......."
    "......."

# game/chapters/chapter1_5/script/ch2sc1.rpy:46
translate brazil ch2sc1_4aebe187:

#   uk "{b}*Scream*{/b} Aaiiiee! Leave me alone!!"
    uk "{b}*Gritar*{/b} Aiiiii! Me deixa em paz!!"

# game/chapters/chapter1_5/script/ch2sc1.rpy:48
translate brazil ch2sc1_7c6d2361:

#   mct "Huh? The scream came from over there."
    mct "Hein? O grito veio de lá."

# game/chapters/chapter1_5/script/ch2sc1.rpy:50
translate brazil ch2sc1_c87d8810:

#   uk "Get off me! You filthy swines!"
    uk "Saiam de cima de mim! Seus porcos imundos!"

# game/chapters/chapter1_5/script/ch2sc1.rpy:52
translate brazil ch2sc1_8dfa07de:

#   uk "Come on sweetheart, let’s have some fun."
    uk "Vamos lá, querida, vamos nos divertir."

# game/chapters/chapter1_5/script/ch2sc1.rpy:54
translate brazil ch2sc1_496822d2:

#   uk "My friend and I like sweet things."
    uk "Eu e meu amigo gostamos de doces."

# game/chapters/chapter1_5/script/ch2sc1.rpy:55
translate brazil ch2sc1_dc97744c:

#   uk "And you sure are a treat!"
    uk "E você é mesmo uma delícia!"

# game/chapters/chapter1_5/script/ch2sc1.rpy:57
