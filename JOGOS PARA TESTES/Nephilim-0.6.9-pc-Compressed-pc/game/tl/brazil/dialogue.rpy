translate brazil ch6sc2_8eb4e485:

#   vx "Take it back! I’m not crushing on anyone! Especially some handsome and mysterious outsider!"
    vx "Retira o que disse! Não estou apaixonada por ninguém! Principalmente por um forasteiro bonito e misterioso!"

# game/chapters/chapter6/ch6sc2.rpy:6890
translate brazil ch6sc2_c714e33e:

#   mi "*Laughing* Hahhah! Sorry, Vex, but your cute, rosy cheeks say otherwise!"
    mi "*Risos* Hahaha! Desculpe, Vex, mas suas bochechas rosadas e fofas dizem o contrário!"

# game/chapters/chapter6/ch6sc2.rpy:6891
translate brazil ch6sc2_73b39b29:

#   vx "You be quiet! Or... or I'll challenge you to a duel! Hnngh!"
    vx "Fique quieto! Ou... ou eu te desafio para um duelo! Hnngh!"

# game/chapters/chapter6/ch6sc2.rpy:6893
translate brazil ch6sc2_93412ab3:

#   pl "Oh, yeah. Echo was looking for you earlier. I’m not sure where she went, though."
    pl "Ah, sim. A Echo estava te procurando mais cedo. Não sei onde ela foi, no entanto."

# game/chapters/chapter6/ch6sc2.rpy:6894
translate brazil ch6sc2_42936418:

#   mc "Oh? Maybe I should go see what she wanted."
    mc "Ah? Talvez eu devesse ir ver o que ela queria."

# game/chapters/chapter6/ch6sc2.rpy:6896
translate brazil ch6sc2_9b9a757c:

#   ec "You need not search for me. I am here."
    ec "Você não precisa me procurar. Eu estou aqui."

