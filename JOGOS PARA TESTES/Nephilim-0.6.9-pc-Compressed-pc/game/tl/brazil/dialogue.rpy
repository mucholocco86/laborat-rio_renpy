# game/chapters/chapter5/script/ch5sc07.rpy:920
translate brazil ch5sc07_81819b14:

#   am "No! Eww! They're murky and moist! Uck! At least, that’s what I’ve heard."
    am "Não! Eca! São turvas e úmidas! Credo! Pelo menos, foi o que eu ouvi dizer."

# game/chapters/chapter5/script/ch5sc07.rpy:922
translate brazil ch5sc07_775b2f71:

