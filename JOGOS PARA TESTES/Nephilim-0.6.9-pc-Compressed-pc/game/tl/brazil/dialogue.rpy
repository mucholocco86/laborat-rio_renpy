#   bn "[mc], please be seated!"
    bn "[mc] Por favor, sente-se!"

# game/chapters/chapter5/script/ch5sc12.rpy:184
translate brazil ch5sc12_d8b2ecae:

#   mc "If you weren’t a king, you could make it big as a jester."
    mc "Se você não fosse rei, poderia fazer sucesso como bobo da corte."

# game/chapters/chapter5/script/ch5sc12.rpy:185
translate brazil ch5sc12_72b87b4f:

#   qm "*Giggles softly*"
    qm "*Ri baixinho*"

# game/chapters/chapter5/script/ch5sc12.rpy:187
translate brazil ch5sc12_3515ff0a:

#   bn "Hahaha! See, Sweetheart? He threw it back at me, the king!"
    bn "Hahaha! Viu, meu bem? Ele me devolveu a provocação, o rei!"

# game/chapters/chapter5/script/ch5sc12.rpy:188
translate brazil ch5sc12_227fbe37:

#   bn "This is why we hired you, [mc]. You’ve got balls."
    bn "Foi por isso que te contratamos. [mc] Você tem coragem."

# game/chapters/chapter5/script/ch5sc12.rpy:189
translate brazil ch5sc12_6b54dc35:

#   bn "Now, please, have some refreshments. The servants will be out with the food momentarily."
    bn "Agora, por favor, aceitem um refresco. Os criados já vão trazer a comida."

# game/chapters/chapter5/script/ch5sc12.rpy:192
translate brazil ch5sc12_243e1516:

#   mc "I'll be sure to eat my fill."
    mc "Com certeza vou comer até me fartar."

# game/chapters/chapter5/script/ch5sc12.rpy:194
translate brazil ch5sc12_e2f7d906:

#   qm "How did you like the room?"
    qm "O que você achou do quarto?"

# game/chapters/chapter5/script/ch5sc12.rpy:196
translate brazil ch5sc12_922e99d4:

#   mc "It was great."
    mc "Foi ótimo."

# game/chapters/chapter5/script/ch5sc12.rpy:197
translate brazil ch5sc12_0e832920:

#   mc "After I got used to the softness of the bed, I slept like a baby."
    mc "Depois que me acostumei com a maciez da cama, dormi como um bebê."

# game/chapters/chapter5/script/ch5sc12.rpy:199
translate brazil ch5sc12_feb6686c:

#   qm "There are hundreds of rooms in the castle..."
    qm "Existem centenas de quartos no castelo..."

# game/chapters/chapter5/script/ch5sc12.rpy:200
translate brazil ch5sc12_e926877b:

#   qm "I hand-picked that one for you. So, I’m glad you enjoyed it."
    qm "Eu escolhi essa especialmente para você. Fico feliz que tenha gostado."

# game/chapters/chapter5/script/ch5sc12.rpy:203
translate brazil ch5sc12_7cb39f2e:

#   mc "*Whispers* {size=-10}{b}I think we both know how much I liked... the room.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Acho que nós dois sabemos o quanto eu gostei... do quarto.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:205
translate brazil ch5sc12_1724967e:

#   qm "*Whispers* {size=-10}{b}Mhh-Hm. I do recall you seeming very... satisfied with it.{/b}{/size}"
    qm "*Sussurros* {size=-10}{b}Hum-hum. Lembro-me de você parecer muito... satisfeito com isso.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:207
translate brazil ch5sc12_ac9805e7:

#   qm "*Whispers* {size=-10}{b}But we talked about this. It was a one time thing. So please, contain yourself.{/b}{/size}"
    qm "*Sussurros* {size=-10}{b}Mas nós conversamos sobre isso. Foi algo que aconteceu apenas uma vez. Então, por favor, se controle.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:208
translate brazil ch5sc12_7acfdfce:

#   mc "*Whispers* {size=-10}{b}Merida-{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Mérida-{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:213
translate brazil ch5sc12_c951392b:

#   mc "Definitely."
    mc "Definitivamente."

# game/chapters/chapter5/script/ch5sc12.rpy:214
translate brazil ch5sc12_3532d7be:

#   mc "I fear it's going to be hard to sleep in regular beds again after this experience."
    mc "Receio que, depois dessa experiência, será difícil voltar a dormir em camas normais."

# game/chapters/chapter5/script/ch5sc12.rpy:217
translate brazil ch5sc12_9e6b660e:

#   bn "Ahh! Finally!"
    bn "Ah! Finalmente!"

# game/chapters/chapter5/script/ch5sc12.rpy:218
translate brazil ch5sc12_62f7c83f:

#   bn "Looks like our meal is ready. I hope you’re hungry, [mc]!"
    bn "Parece que nossa refeição está pronta. Espero que você esteja com fome. [mc]!"

# game/chapters/chapter5/script/ch5sc12.rpy:220
translate brazil ch5sc12_b16f27aa:

#   mc "Are you kidding? I’m famished, Your Majesty."
    mc "Está brincando? Estou faminto, Majestade."

# game/chapters/chapter5/script/ch5sc12.rpy:221
translate brazil ch5sc12_c863fe9b:

#   bn "Haha! I knew that'd get your appetite going. You’re a man, after all."
    bn "Haha! Eu sabia que isso ia te abrir o apetite. Afinal, você é homem."

# game/chapters/chapter5/script/ch5sc12.rpy:222
translate brazil ch5sc12_74c5bdf4:

#   bn "You’re in luck too! Our maids serve some delicious dishes!"
    bn "Você também está com sorte! Nossas empregadas preparam pratos deliciosos!"

# game/chapters/chapter5/script/ch5sc12.rpy:224
translate brazil ch5sc12_31ac2cd5:

#   md "Would you like some buns, sir?"
    md "O senhor gostaria de alguns pãezinhos?"

# game/chapters/chapter5/script/ch5sc12.rpy:225
translate brazil ch5sc12_0a1bdeb2:

#   mct "{i}That’s one of the maids from last night. Vila, I think her name was.{/i}"
    mct "{i}Essa é uma das empregadas de ontem à noite. Vila, acho que era esse o nome dela.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:226
translate brazil ch5sc12_266f2b21:

#   mc "I’d love a bun. Thank you."
    mc "Adoraria um pãozinho. Obrigada."

# game/chapters/chapter5/script/ch5sc12.rpy:228
translate brazil ch5sc12_0442f67d:

#   md "I hope they are to your liking?"
    md "Espero que sejam do seu agrado."

# game/chapters/chapter5/script/ch5sc12.rpy:229
translate brazil ch5sc12_302431cb:

#   mc "I’ll have to taste them before I can give my honest opinion."
    mc "Preciso prová-los antes de poder dar minha opinião sincera."

# game/chapters/chapter5/script/ch5sc12.rpy:232
translate brazil ch5sc12_275bcf2a:

#   md "Once you taste these... they'll spoil you for any other buns."
    md "Depois de provar esses pãezinhos... você não vai querer mais nenhum outro."

# game/chapters/chapter5/script/ch5sc12.rpy:234
translate brazil ch5sc12_74f61ab0:

#   mc "They do look tasty... and perfectly made."
    mc "Parecem deliciosos... e feitos com perfeição."

# game/chapters/chapter5/script/ch5sc12.rpy:236
translate brazil ch5sc12_6bba26e8:

#   md "*Softly* You’ll be getting a taste soon enough. Here you go."
    md "*Suavemente* Você logo vai provar. Aqui está."

# game/chapters/chapter5/script/ch5sc12.rpy:238
translate brazil ch5sc12_8154fe94:

#   md "*Quietly* Mmmh..."
    md "*Em voz baixa* Hum..."

# game/chapters/chapter5/script/ch5sc12.rpy:239
translate brazil ch5sc12_dd1eec78:

#   md "What do you think, sir? Don’t they smell absolutely delicious?"
    md "O que o senhor acha? Não têm um cheiro absolutamente delicioso?"

# game/chapters/chapter5/script/ch5sc12.rpy:240
translate brazil ch5sc12_25bb5559:

#   mct "{i}She does smell amazing. The scent of baked goods is all over her.{/i}"
    mct "{i}Ela tem um cheiro maravilhoso. O aroma de bolos recém-assados ​​está por toda parte.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:242
translate brazil ch5sc12_ff5cb433:

#   mc "They smell absolutely divine. I’d love two."
    mc "Têm um cheiro absolutamente divino. Eu adoraria ter dois."

# game/chapters/chapter5/script/ch5sc12.rpy:243
translate brazil ch5sc12_56749e2a:

#   bn "I knew your appetite would soar once you saw her goods! *Chuckles*"
    bn "Eu sabia que seu apetite ia disparar quando você visse as coisas boas dela! *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:244
translate brazil ch5sc12_0bb2d422:

#   md "*Whispers* {size=-10}{b}We'll continue this another time... handsome.{/b}{/size}"
    md "*Sussurros* {size=-10}{b}Continuaremos isso em outra ocasião... lindo.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:249
translate brazil ch5sc12_67cab2f9:

#   md "Go on, try one. I made them myself."
    md "Vamos lá, experimente. Eu mesmo os fiz."

# game/chapters/chapter5/script/ch5sc12.rpy:252
translate brazil ch5sc12_d6cd990f:

#   bn "Don’t you usually work in pairs during the morning shift? Where’s the other maid?"
    bn "Vocês não costumam trabalhar em duplas no turno da manhã? Onde está a outra empregada?"

# game/chapters/chapter5/script/ch5sc12.rpy:254
translate brazil ch5sc12_de813a04:

#   md "You are correct, Your Majesty."
    md "Vossa Majestade está correto."

# game/chapters/chapter5/script/ch5sc12.rpy:255
translate brazil ch5sc12_7a4fe49d:

#   md "I’m afraid I haven’t seen her this morning. Mei wasn’t in her bed when the rest of us awoke."
    md "Receio não a ter visto esta manhã. Mei não estava na cama quando nós outros acordamos."

# game/chapters/chapter5/script/ch5sc12.rpy:256
translate brazil ch5sc12_de2fba05:

#   md "Which is unusual for her."
    md "O que é incomum para ela."

# game/chapters/chapter5/script/ch5sc12.rpy:257
translate brazil ch5sc12_06c14507:

#   md "I usually wake her up in the morning because she likes to stay up late."
    md "Normalmente eu a acordo de manhã porque ela gosta de ficar acordada até tarde."

# game/chapters/chapter5/script/ch5sc12.rpy:259
translate brazil ch5sc12_9a3c3f4d:

#   qm "We should send someone to look for her."
    qm "Devemos enviar alguém para procurá-la."

# game/chapters/chapter5/script/ch5sc12.rpy:260
translate brazil ch5sc12_3ef05be9:

#   qm "Something could have happened to her? Maybe she’s injured or something?"
    qm "Será que aconteceu alguma coisa com ela? Talvez ela esteja ferida ou algo assim?"

# game/chapters/chapter5/script/ch5sc12.rpy:261
translate brazil ch5sc12_97607264:

#   bn "Bah! You’re overreacting. She knows her way around the castle by now. I’m sure she’ll turn up."
    bn "Ora! Você está exagerando. Ela já conhece o castelo como a palma da mão. Tenho certeza de que ela vai aparecer."

# game/chapters/chapter5/script/ch5sc12.rpy:266
translate brazil ch5sc12_8c2a551f:

#   bn "I’ll take three buns, dear."
    bn "Vou querer três pãezinhos, querida."

# game/chapters/chapter5/script/ch5sc12.rpy:268
translate brazil ch5sc12_a22173dd:

#   md "Of course, Your Majesty."
    md "Claro, Vossa Majestade."

# game/chapters/chapter5/script/ch5sc12.rpy:270
translate brazil ch5sc12_7c6af936:

#   qm "..."
    qm "..."

# game/chapters/chapter5/script/ch5sc12.rpy:271
translate brazil ch5sc12_4d71d1fb:

#   bn "[mc] was right. They do smell delicious! Freshly baked, I presume?"
    bn "[mc] Tinha razão. Eles realmente têm um cheiro delicioso! Presumo que estejam fresquinhos, né?"

# game/chapters/chapter5/script/ch5sc12.rpy:273
translate brazil ch5sc12_ab9b06eb:

#   md "Yes, just an hour out of the oven, Your Highness."
    md "Sim, acabou de sair do forno, Alteza."

# game/chapters/chapter5/script/ch5sc12.rpy:275
translate brazil ch5sc12_8af028de:

#   bn "Marvelous!"
    bn "Maravilhoso!"

# game/chapters/chapter5/script/ch5sc12.rpy:276
translate brazil ch5sc12_6a46a67d:

#   md "Would the princess like a bun?"
    md "A princesa gostaria de um pãozinho?"

# game/chapters/chapter5/script/ch5sc12.rpy:278
translate brazil ch5sc12_5836e802:

#   am "Hmh. I really shouldn’t ... One. I’ll take one."
    am "Hum. Eu realmente não deveria... Um. Vou levar um."

# game/chapters/chapter5/script/ch5sc12.rpy:280
translate brazil ch5sc12_e14d00d7:

#   md "Of course, Your Highness. I hope it is to your taste."
    md "Claro, Alteza. Espero que seja do seu agrado."

# game/chapters/chapter5/script/ch5sc12.rpy:282
translate brazil ch5sc12_07ee8efc:

#   am "I’m sure it will be. Thank you."
    am "Tenho certeza que sim. Obrigada."

# game/chapters/chapter5/script/ch5sc12.rpy:284
translate brazil ch5sc12_b5b8838b:

#   bn "Alright everyone. Let’s dig in!"
    bn "Muito bem, pessoal. Vamos começar!"

# game/chapters/chapter5/script/ch5sc12.rpy:286
translate brazil ch5sc12_b051a07d:

#   qm "*Whispers* {size=-10}{b}Stop it!{/b}{/size}"
    qm "*Sussurros* {size=-10}{b}Pare com isso!{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:288
translate brazil ch5sc12_badcb50a:

#   mc "*Whispers* {size=-10}{b}You’re the one who keeps rubbing against me.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Você é quem fica se esfregando em mim.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:290
translate brazil ch5sc12_672effbb:

#   qm "*Whispers* {size=-10}{b}You started it. You’re being too- too bold.{/b}{/size}"
    qm "*Sussurros* {size=-10}{b}Você que começou. Você está sendo muito... muito ousado.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:292
translate brazil ch5sc12_cf546287:

#   mc "*Whispers* {size=-10}{b}I can’t help it. Sitting next to you... your scent right beside me.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Não consigo evitar. Sentada ao seu lado... seu perfume bem perto de mim.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:296
translate brazil ch5sc12_303aaad4:

#   qm "*Whispers* {size=-10}{b}We shouldn’t...{/b}{/size}"
    qm "*Sussurros* {size=-10}{b}Não deveríamos...{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:298
translate brazil ch5sc12_5ffe6c95:

#   mc "*Whispers* {size=-10}{b}Seems like you’re enjoying this. Do you feel excited?{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Parece que você está gostando. Você está animado(a)?{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:300
translate brazil ch5sc12_717ac762:

#   qm "*Whispers* {size=-10}{b}No... Mnhh... No.{/b}{/size}"
    qm "*Sussurros* {size=-10}{b}Não... Hum... Não.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:302
translate brazil ch5sc12_31b2b67b:

#   qm "*Whispers* {size=-10}{b}I-I... Nnghh... You smell really nice too.{/b}{/size}"
    qm "*Sussurros* {size=-10}{b}II... Nnghh... Você também cheira muito bem.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:303
translate brazil ch5sc12_2e0ff436:

#   "Merida squeezes your leg between hers, keeping it in place."
    "Mérida aperta sua perna entre as dela, mantendo-a no lugar."

# game/chapters/chapter5/script/ch5sc12.rpy:305
translate brazil ch5sc12_ce9fedde:

#   mc "*Whispers* {size=-10}{b}Merida... you drive me crazy.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Mérida... você me deixa louco.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:308
translate brazil ch5sc12_352f49c4:

#   qm "{b}*Squeals* AiiYyhHH!!{/b}"
    qm "{b}*Gritos* AiiYyhHH!!{/b}"

# game/chapters/chapter5/script/ch5sc12.rpy:309
translate brazil ch5sc12_ee959a3a:

#   bn "Honey?! What in the world has gotten into you?"
    bn "Querida?! O que diabos aconteceu com você?"

# game/chapters/chapter5/script/ch5sc12.rpy:310
translate brazil ch5sc12_d48ed51e:

#   qm "Excuse me! I-I forgot to ask my handmaiden to- to help me with my new dress!"
    qm "Com licença! Esqueci de pedir à minha criada para me ajudar com meu vestido novo!"

# game/chapters/chapter5/script/ch5sc12.rpy:317
translate brazil ch5sc12_a03df35d:

#   "You and Amelia finish up breakfast and take your leave."
    "Você e Amelia terminam o café da manhã e se despedem."

# game/chapters/chapter5/script/ch5sc12.rpy:319
translate brazil ch5sc12_043d388c:

#   mc "*Sighs* Is it always this busy in the palace?"
    mc "*Suspiro* O palácio é sempre tão movimentado assim?"

# game/chapters/chapter5/script/ch5sc12.rpy:320
translate brazil ch5sc12_4a84d257:

#   am "Pretty much! Valois Palace is like a whole city within the city."
    am "Praticamente isso! O Palácio Valois é como uma cidade inteira dentro da cidade."

# game/chapters/chapter5/script/ch5sc12.rpy:321
translate brazil ch5sc12_d4c70daa:

#   mc "Valois Palace?"
    mc "Palácio Valois?"

# game/chapters/chapter5/script/ch5sc12.rpy:322
translate brazil ch5sc12_d4d7f790:

#   am "Mhm-Hm! My family's name."
    am "Hum-hum! O nome da minha família."

# game/chapters/chapter5/script/ch5sc12.rpy:323
translate brazil ch5sc12_2f312c3e:

#   am "We're house Valois."
    am "Somos da casa Valois."

# game/chapters/chapter5/script/ch5sc12.rpy:324
translate brazil ch5sc12_347af324:

#   mc "Hmh, I didn't know that."
    mc "Hum, eu não sabia disso."

# game/chapters/chapter5/script/ch5sc12.rpy:325
translate brazil ch5sc12_3c75472e:

#   am "You know, it wouldn't hurt for you to read more."
    am "Sabe, não lhe faria mal nenhum ler mais."

# game/chapters/chapter5/script/ch5sc12.rpy:326
translate brazil ch5sc12_fe10b674:

#   am "Anyway... mostly it's just nobles, court attendees, servants, and workers... sometimes a few traders too."
    am "Enfim... na maior parte das vezes são nobres, membros da corte, servos e trabalhadores... às vezes alguns comerciantes também."

# game/chapters/chapter5/script/ch5sc12.rpy:328
translate brazil ch5sc12_ed8c7dba:

#   mc "No wonder you want to get out of here."
    mc "Não me admira que você queira sair daqui."

# game/chapters/chapter5/script/ch5sc12.rpy:329
translate brazil ch5sc12_0c05e6b0:

#   am "It can get a little hectic, yeah. I’d love nothing more than to settle down by a quiet lake."
    am "Pode ficar um pouco agitado, sim. Eu adoraria me estabelecer perto de um lago tranquilo."

# game/chapters/chapter5/script/ch5sc12.rpy:330
translate brazil ch5sc12_01804c81:

#   mc "I know a place like that."
    mc "Conheço um lugar assim."

# game/chapters/chapter5/script/ch5sc12.rpy:332
translate brazil ch5sc12_79bc2de8:

#   am "Oh? Is that where you’re taking me for our excursion today?"
    am "Ah? É para lá que você vai me levar no nosso passeio de hoje?"

# game/chapters/chapter5/script/ch5sc12.rpy:333
translate brazil ch5sc12_2b794855:

#   mc "I’m afraid it’s a fair distance from here. Too far for today."
    mc "Receio que seja bastante longe daqui. Longe demais para hoje."

# game/chapters/chapter5/script/ch5sc12.rpy:335
translate brazil ch5sc12_3c874ef4:

#   mc "Maybe I’ll take you some other time."
    mc "Talvez eu te leve em outra ocasião."

# game/chapters/chapter5/script/ch5sc12.rpy:336
translate brazil ch5sc12_2867a8d7:

#   am "Great! Oh-"
    am "Ótimo! Oh-"

# game/chapters/chapter5/script/ch5sc12.rpy:338
translate brazil ch5sc12_8a842472:

#   am "Before we leave, I have to change outfits. Heels and dresses won’t be suited for going outside the city, right?"
    am "Antes de sairmos, preciso trocar de roupa. Salto alto e vestido não são adequados para sair da cidade, né?"

# game/chapters/chapter5/script/ch5sc12.rpy:339
translate brazil ch5sc12_8f4ed0b6:

#   mc "Not unless you want to have your day, shoes, and dress ruined... no."
    mc "A menos que você queira que seu dia, seus sapatos e seu vestido sejam arruinados... não."

# game/chapters/chapter5/script/ch5sc12.rpy:340
translate brazil ch5sc12_91637b8e:

#   am "Do you know where the kitchens in the east wing are located? The ones closest to the banquet hall from last night?"
    am "Você sabe onde ficam as cozinhas da ala leste? Aquelas mais próximas do salão de banquetes de ontem à noite?"

# game/chapters/chapter5/script/ch5sc12.rpy:342
translate brazil ch5sc12_7a844dbd:

#   mc "I’m familiar with the kitchens, yes. Why?"
    mc "Sim, conheço as cozinhas. Por quê?"

# game/chapters/chapter5/script/ch5sc12.rpy:344
translate brazil ch5sc12_732c18bf:

#   am "Great! We'll meet at the back of the kitchens."
    am "Ótimo! Nos encontraremos nos fundos das cozinhas."

# game/chapters/chapter5/script/ch5sc12.rpy:345
translate brazil ch5sc12_7a05e0fd:

#   am "There's a door leading to the storage cellar. Meet me down there in... an hour?"
    am "Há uma porta que dá para o depósito. Encontre-me lá em... uma hora?"

# game/chapters/chapter5/script/ch5sc12.rpy:346
translate brazil ch5sc12_ef72c062:

#   mc "An hour?! ... *Sighs* Sure."
    mc "Uma hora?! ... *Suspiro* Claro."

# game/chapters/chapter5/script/ch5sc12.rpy:349
translate brazil ch5sc12_3da2bae3:

#   mct "{i}I can’t believe I agreed to take her outside the city ...{/i}"
    mct "{i}Não acredito que concordei em levá-la para fora da cidade...{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:350
translate brazil ch5sc12_2b35b6fe:

#   mc "..."
    mc "..."

# game/chapters/chapter5/script/ch5sc12.rpy:352
translate brazil ch5sc12_0a277118:

#   mct "{i}If her parents finds out, they’ll have me thrown into the dungeons, flogged, and possibly hanged.{/i}"
    mct "{i}Se os pais dela descobrirem, vão me mandar para os calabouços, me açoitar e possivelmente me enforcar.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:353
translate brazil ch5sc12_79af3802:

#   mct "{i}Maybe they’ll even parade me naked through the streets, with a crier yelling 'shame'. *Scoffs* Like that'd change anyone.{/i}"
    mct "{i}Talvez até me desfilem nua pelas ruas, com um porta-voz gritando \"vergonha\". *Risos* Como se isso fosse mudar alguém.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:355
translate brazil ch5sc12_e1e5cd0b:

#   "You hear the door from the kitchen open"
    "Você ouve a porta da cozinha se abrir."

# game/chapters/chapter5/script/ch5sc12.rpy:356
translate brazil ch5sc12_c2ca5ee9:

#   mct "{i}Finally...{/i}"
    mct "{i}Finalmente...{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:358
translate brazil ch5sc12_095731b7:

#   mc "By the five hells... What are you wearing?"
    mc "Pelos cinco infernos... O que você está vestindo?"

# game/chapters/chapter5/script/ch5sc12.rpy:360
translate brazil ch5sc12_24ad9517:

#   am "Oh, this little outfit? It’s something I threw together once I decided you should take me adventuring."
    am "Ah, essa roupinha? Eu improvisei quando decidi que você deveria me levar para uma aventura."

# game/chapters/chapter5/script/ch5sc12.rpy:361
translate brazil ch5sc12_c81c48af:

#   am "Do you like it?"
    am "Você gosta disso?"

# game/chapters/chapter5/script/ch5sc12.rpy:362
translate brazil ch5sc12_b6777ba1:

#   mc "I mean, it’s certainly better than your heels and pink dresses... I’m just a little taken aback."
    mc "Quer dizer, com certeza é melhor do que seus saltos altos e vestidos rosa... Só estou um pouco surpresa."

# game/chapters/chapter5/script/ch5sc12.rpy:364
translate brazil ch5sc12_f1f7c288:

#   am "What’s that supposed to mean?!"
    am "O que isso quer dizer?!"

# game/chapters/chapter5/script/ch5sc12.rpy:365
translate brazil ch5sc12_9b4a6be3:

#   am "You don’t think I have what it takes as an adventurer?!"
    am "Você acha que eu não tenho o que é preciso para ser um aventureiro?!"

# game/chapters/chapter5/script/ch5sc12.rpy:367
translate brazil ch5sc12_fd57bccc:

#   mc "Dressing like one isn’t the same as being one."
    mc "Vestir-se como um não é o mesmo que ser um."

# game/chapters/chapter5/script/ch5sc12.rpy:368
translate brazil ch5sc12_3088c4ac:

#   am "Hmmgh..."
    am "Hum..."

# game/chapters/chapter5/script/ch5sc12.rpy:370
translate brazil ch5sc12_079cb0eb:

#   am "I’m well aware of that! But it’s the first step. Just wait, I’ll show you that I can be adventurous!"
    am "Estou bem ciente disso! Mas é apenas o primeiro passo. Espere só, vou te mostrar que também sei ser aventureira!"

# game/chapters/chapter5/script/ch5sc12.rpy:372
translate brazil ch5sc12_50132635:

#   mc "Weren't you the one who told me that you’ve never ventured beyond the city walls before?"
    mc "Não foi você quem me disse que nunca tinha se aventurado além dos muros da cidade?"

# game/chapters/chapter5/script/ch5sc12.rpy:374
translate brazil ch5sc12_1448cd24:

#   mc "Look, I know you’re excited about this. But outside these walls... things are unpredictable, to say the least."
    mc "Olha, eu sei que você está animado com isso. Mas fora destas paredes... as coisas são imprevisíveis, para dizer o mínimo."

# game/chapters/chapter5/script/ch5sc12.rpy:376
translate brazil ch5sc12_96dfb503:

#   mc "So just... try not to do something reckless. Okay?"
    mc "Então... tente não fazer nada imprudente. Ok?"

# game/chapters/chapter5/script/ch5sc12.rpy:378
translate brazil ch5sc12_f3b672ba:

#   am "Deal! Let’s goooo! There’s an exit over here that we can use."
    am "Combinado! Vamos lá! Tem uma saída por aqui que podemos usar."

# game/chapters/chapter5/script/ch5sc12.rpy:380
translate brazil ch5sc12_214f30eb:

#   mc "A trapdoor? You’re not leading me down into your secret, decrepit sex dungeon, are you?"
    mc "Uma alçapão? Você não vai me levar para sua masmorra sexual secreta e decadente, vai?"

# game/chapters/chapter5/script/ch5sc12.rpy:382
translate brazil ch5sc12_ceba7675:

#   am "Sorry to disappoint you and your deviant mind, but it’s not a sex dungeon."
    am "Sinto muito desapontá-lo e à sua mente pervertida, mas isto não é uma masmorra sexual."

# game/chapters/chapter5/script/ch5sc12.rpy:383
translate brazil ch5sc12_f1ae5edd:

#   am "It’s a secret passage that eventually leads out into the nearby woods."
    am "É uma passagem secreta que eventualmente leva à mata próxima."

# game/chapters/chapter5/script/ch5sc12.rpy:385
translate brazil ch5sc12_2be16eac:

#   mc "A secret passage?"
    mc "Uma passagem secreta?"

# game/chapters/chapter5/script/ch5sc12.rpy:387
translate brazil ch5sc12_9436b37f:

#   am "Mhm. There are a few hidden paths inside the castle that lead outside."
    am "Sim. Existem alguns caminhos escondidos dentro do castelo que levam para o exterior."

# game/chapters/chapter5/script/ch5sc12.rpy:388
translate brazil ch5sc12_5655054e:

#   am "They were originally built during the construction of the castle, hundreds of years ago."
    am "Elas foram originalmente construídas durante a construção do castelo, há centenas de anos."

# game/chapters/chapter5/script/ch5sc12.rpy:389
translate brazil ch5sc12_db4c35cd:

#   am "They're intended to help us escape if the castle is attacked or besieged, which was a lot more common back then."
    am "Elas servem para nos ajudar a escapar caso o castelo seja atacado ou sitiado, o que era muito mais comum naquela época."

# game/chapters/chapter5/script/ch5sc12.rpy:391
translate brazil ch5sc12_cd71cf18:

#   mc "You know your stuff."
    mc "Você entende do assunto."

# game/chapters/chapter5/script/ch5sc12.rpy:393
translate brazil ch5sc12_907312c8:

#   am "Well, I did grow up in this castle."
    am "Bem, eu cresci neste castelo."

# game/chapters/chapter5/script/ch5sc12.rpy:394
translate brazil ch5sc12_f7ad027b:

#   am "Not to mention, there are plenty of books from those times in the library."
    am "Sem falar que há muitos livros daquela época na biblioteca."

# game/chapters/chapter5/script/ch5sc12.rpy:396
translate brazil ch5sc12_546a486d:

#   am "I used to play around in the tunnels, along with some of the servants. They can get a little dark."
    am "Eu costumava brincar nos túneis, junto com alguns dos criados. Eles podem ficar um pouco escuros."

# game/chapters/chapter5/script/ch5sc12.rpy:397
translate brazil ch5sc12_e5900c73:

#   mc "You played in the tunnels? The princess?"
    mc "Você brincou nos túneis? A princesa?"

# game/chapters/chapter5/script/ch5sc12.rpy:398
translate brazil ch5sc12_53d5d0fa:

#   am "What? You think noble children are exempt from wanting to explore?"
    am "O quê? Você acha que crianças nobres estão isentas da vontade de explorar?"

# game/chapters/chapter5/script/ch5sc12.rpy:399
translate brazil ch5sc12_4884f63e:

#   mc "I suppose not ..."
    mc "Acho que não..."

# game/chapters/chapter5/script/ch5sc12.rpy:400
translate brazil ch5sc12_26a3b536:

#   am "It’s a pretty narrow path down there. So watch your step."
    am "É um caminho bem estreito lá embaixo. Então, cuidado onde pisa."

# game/chapters/chapter5/script/ch5sc12.rpy:403
translate brazil ch5sc12_e3826b25:

#   am "I’ll lead the way."
    am "Eu vou liderar o caminho."

# game/chapters/chapter5/script/ch5sc12.rpy:404
translate brazil ch5sc12_b82c82f8:

#   am "Don’t worry, the worst you’ll encounter down here are rats. Maybe an old skeleton or two..."
    am "Não se preocupe, o pior que você encontrará aqui embaixo são ratos. Talvez um esqueleto antigo ou dois..."

# game/chapters/chapter5/script/ch5sc12.rpy:406
translate brazil ch5sc12_4ba423be:

#   am "You’re not afraid of the dark, are you?"
    am "Você não tem medo do escuro, tem?"

# game/chapters/chapter5/script/ch5sc12.rpy:408
translate brazil ch5sc12_4cafc181:

#   mc "No. I was just thinking how quiet it is down here."
    mc "Não. Eu só estava pensando em como é silencioso aqui embaixo."

# game/chapters/chapter5/script/ch5sc12.rpy:409
translate brazil ch5sc12_3db783df:

#   mc "Like, it feels completely cut off from the world."
    mc "É como se eu estivesse completamente isolado do mundo."

# game/chapters/chapter5/script/ch5sc12.rpy:410
translate brazil ch5sc12_577d860c:

#   mc "I can practically hear my own heartbeat."
    mc "Eu praticamente consigo ouvir meu próprio coração batendo."

# game/chapters/chapter5/script/ch5sc12.rpy:412
translate brazil ch5sc12_f42eda24:

#   am "Yeah, it can be a little surreal, or even disorienting if you aren’t paying attention."
    am "Sim, pode ser um pouco surreal, ou até mesmo desorientador se você não estiver prestando atenção."

# game/chapters/chapter5/script/ch5sc12.rpy:413
translate brazil ch5sc12_947aceaf:

#   am "You know those skeletons I mentioned earlier?"
    am "Sabe aqueles esqueletos que mencionei antes?"

# game/chapters/chapter5/script/ch5sc12.rpy:415
translate brazil ch5sc12_8cf64806:

#   mc "Yeah? What about them?"
    mc "É mesmo? E quanto a eles?"

# game/chapters/chapter5/script/ch5sc12.rpy:417
translate brazil ch5sc12_9e2e5a0d:

#   am "According to legend, a group of bandits found their way in here..."
    am "Segundo a lenda, um grupo de bandidos entrou aqui..."

# game/chapters/chapter5/script/ch5sc12.rpy:418
translate brazil ch5sc12_bbd5b45b:

#   am "In a futile attempt to sneak inside the castle."
    am "Em uma tentativa fútil de entrar sorrateiramente no castelo."

# game/chapters/chapter5/script/ch5sc12.rpy:419
translate brazil ch5sc12_33693ea2:

#   am "Eventually, they ran out of light and lost their way."
    am "Por fim, a luz acabou e eles se perderam."

# game/chapters/chapter5/script/ch5sc12.rpy:420
translate brazil ch5sc12_92cadd4b:

#   am "Their remains were found, years later, picked clean to the bone by rats."
    am "Seus restos mortais foram encontrados anos depois, completamente devorados até os ossos por ratos."

# game/chapters/chapter5/script/ch5sc12.rpy:422
translate brazil ch5sc12_5e44a000:

#   mc "Right..."
    mc "Certo..."

# game/chapters/chapter5/script/ch5sc12.rpy:423
translate brazil ch5sc12_1a61a841:

#   mc "That seems a little far-fetched, don’t you think?"
    mc "Isso parece um pouco rebuscado, não acha?"

# game/chapters/chapter5/script/ch5sc12.rpy:425
translate brazil ch5sc12_4f6e10ee:

#   am "I don’t know. During my grandfather’s reign, they used to throw prisoners down here as punishment."
    am "Não sei. Durante o reinado do meu avô, costumavam jogar prisioneiros aqui embaixo como castigo."

# game/chapters/chapter5/script/ch5sc12.rpy:426
translate brazil ch5sc12_fb9486a2:

#   am "In the absolute darkness and complete silence, none of them ever managed to escape."
    am "Na escuridão absoluta e no silêncio total, nenhum deles conseguiu escapar."

# game/chapters/chapter5/script/ch5sc12.rpy:428
translate brazil ch5sc12_87e33bc3:

#   am "Apparently, they used to occasionally send servants down here to remove the corpses as to avoid stinking up the place."
    am "Aparentemente, costumavam enviar criados ocasionalmente para cá para remover os cadáveres, a fim de evitar que o local ficasse com mau cheiro."

# game/chapters/chapter5/script/ch5sc12.rpy:430
translate brazil ch5sc12_4afa4c08:

#   am "When Father came into his reign, he put an end to it, though."
    am "Quando o Pai assumiu o seu reinado, ele pôs fim a isso."

# game/chapters/chapter5/script/ch5sc12.rpy:431
translate brazil ch5sc12_e30b1287:

#   am "Now, prisoners are kept locked up in the dungeons until their sentence is passed."
    am "Agora, os prisioneiros ficam trancados nas masmorras até que sua sentença seja proferida."

# game/chapters/chapter5/script/ch5sc12.rpy:433
translate brazil ch5sc12_44277a97:

#   mc "And knowing all that, you still played down here, carefree?"
    mc "E sabendo de tudo isso, você ainda brincava aqui, despreocupado?"

# game/chapters/chapter5/script/ch5sc12.rpy:435
translate brazil ch5sc12_ca1a777b:

#   am "I told you, I had servants with me. All with torches and snacks."
    am "Eu já disse, eu tinha criados comigo. Todos com tochas e lanches."

# game/chapters/chapter5/script/ch5sc12.rpy:437
translate brazil ch5sc12_996eb76e:

#   am "We’re almost at the end of the passage now."
    am "Estamos quase no final da passagem."

# game/chapters/chapter5/script/ch5sc12.rpy:440
translate brazil ch5sc12_c4840c37:

#   am "Hnngh! It’s stuck! Can you push it open?"
    am "Hnngh! Está preso! Você consegue empurrar para abrir?"

# game/chapters/chapter5/script/ch5sc12.rpy:443
translate brazil ch5sc12_ce8b0ae7:

#   am "Frida’s right, you really are strong. It didn’t even budge when I tried."
    am "A Frida tem razão, você é mesmo forte. Nem se mexeu quando tentei."

# game/chapters/chapter5/script/ch5sc12.rpy:444
translate brazil ch5sc12_0bedaa42:

#   mc "You only had one bun for breakfast... it’s not surprising you're as weak as a wet rag."
    mc "Você só comeu um pãozinho no café da manhã... não é de se admirar que esteja tão fraco quanto um pano molhado."

# game/chapters/chapter5/script/ch5sc12.rpy:445
translate brazil ch5sc12_e344a96f:

#   am "Hey! I’m trying to watch my weight... *Belly growls*"
    am "Ei! Estou tentando controlar meu peso... *Barriga ronca*"

# game/chapters/chapter5/script/ch5sc12.rpy:446
translate brazil ch5sc12_5e1e37f7:

#   am "Watch your step. I remember one of the servants slipped on the steps once. Sometimes water seeps down and makes it slick."
    am "Cuidado onde pisa. Lembro-me de um dos criados que escorregou nos degraus uma vez. Às vezes, a água infiltra e deixa o piso escorregadio."

# game/chapters/chapter5/script/ch5sc12.rpy:448
translate brazil ch5sc12_ad69c53c:

#   mc "It was smart of you to only eat one bun. It’s a tight fit."
    mc "Foi uma atitude inteligente da sua parte comer só um pãozinho. Cabe tudo muito apertado."

# game/chapters/chapter5/script/ch5sc12.rpy:449
translate brazil ch5sc12_6f62d643:

#   am "Did you just call me fat?"
    am "Você acabou de me chamar de gorda?"

# game/chapters/chapter5/script/ch5sc12.rpy:450
translate brazil ch5sc12_5321d11c:

#   mc "Here, I’ll give you a hand."
    mc "Aqui, vou te dar uma mão."

# game/chapters/chapter5/script/ch5sc12.rpy:452
translate brazil ch5sc12_ca9f79c1:

#   am "I can’t believe you pulled me up so easily... T-Thank you."
    am "Não acredito que você me ajudou a levantar tão facilmente... O-Obrigado."

# game/chapters/chapter5/script/ch5sc12.rpy:453
translate brazil ch5sc12_f0244e95:

#   am "Handsome, chases away creeps, dances like a proper man, and frees me from dark passageways..."
    am "Bonito, espanta os pervertidos, dança como um cavalheiro e me liberta de passagens escuras..."

# game/chapters/chapter5/script/ch5sc12.rpy:455
translate brazil ch5sc12_9fdad683:

#   am "Is there anything you don’t do?"
    am "Existe algo que você não faz?"

# game/chapters/chapter5/script/ch5sc12.rpy:456
translate brazil ch5sc12_d5c948ee:

#   am "Or are you just annoyingly good at everything?"
    am "Ou você é simplesmente irritantemente bom em tudo?"

# game/chapters/chapter5/script/ch5sc12.rpy:458
translate brazil ch5sc12_7684b1d0:

#   mc "C’mon. Let’s move deeper into the woods."
    mc "Vamos lá. Vamos nos embrenhar mais na floresta."

# game/chapters/chapter5/script/ch5sc12.rpy:459
translate brazil ch5sc12_ac7025f2:

#   mc "I don’t want to risk being seen out here with you."
    mc "Não quero correr o risco de ser vista aqui fora com você."

# game/chapters/chapter5/script/ch5sc12.rpy:461
translate brazil ch5sc12_d6fe0e84:

#   am "That’s a good idea. Let’s see what we can find."
    am "Essa é uma boa ideia. Vamos ver o que conseguimos encontrar."

# game/chapters/chapter5/script/ch5sc12.rpy:462
translate brazil ch5sc12_97708516:

#   am "It’d be nice to find a place we could sit in the grass."
    am "Seria bom encontrar um lugar onde pudéssemos sentar na grama."

# game/chapters/chapter5/script/ch5sc12.rpy:464
translate brazil ch5sc12_3740e2d7:

#   "The two of you find a rocky pathway and decide to follow it for a couple of hours."
    "Vocês dois encontram um caminho rochoso e decidem segui-lo por algumas horas."

# game/chapters/chapter5/script/ch5sc12.rpy:466
translate brazil ch5sc12_47b51d6d:

#   am "By the Divines... I’ve never been this high up before."
    am "Pelos deuses... nunca estive tão alto antes."

# game/chapters/chapter5/script/ch5sc12.rpy:467
translate brazil ch5sc12_56b8454b:

#   am "I love how quiet it is up here, though, and the air is so different compared to the city..."
    am "Adoro o silêncio aqui em cima, e o ar é tão diferente comparado com o da cidade..."

# game/chapters/chapter5/script/ch5sc12.rpy:469
translate brazil ch5sc12_70add63b:

#   am "Have you ever been here before?"
    am "Você já esteve aqui antes?"

# game/chapters/chapter5/script/ch5sc12.rpy:470
translate brazil ch5sc12_2804e506:

#   mc "No. This is my first time seeing this area."
    mc "Não. É a primeira vez que vejo esta área."

# game/chapters/chapter5/script/ch5sc12.rpy:471
translate brazil ch5sc12_823065e2:

#   mc "I’m surprised you’re able to keep up, it’s quite steep."
    mc "Estou surpreso que você consiga acompanhar, é uma subida bastante íngreme."

# game/chapters/chapter5/script/ch5sc12.rpy:473
translate brazil ch5sc12_911558f6:

#   am "This is nothing!"
    am "Isso não é nada!"

# game/chapters/chapter5/script/ch5sc12.rpy:474
translate brazil ch5sc12_e5f7ada9:

#   am "I usually wake up early and go running around the castle courtyards to keep in shape."
    am "Normalmente acordo cedo e saio para correr pelos pátios do castelo para me manter em forma."

# game/chapters/chapter5/script/ch5sc12.rpy:475
translate brazil ch5sc12_750c68b5:

#   am "Besides, this is what adventuring is all about!"
    am "Além disso, é disso que se trata a aventura!"

# game/chapters/chapter5/script/ch5sc12.rpy:476
translate brazil ch5sc12_a37650a5:

#   am "Discovering new areas and exploring the unknown!"
    am "Descobrindo novas áreas e explorando o desconhecido!"

# game/chapters/chapter5/script/ch5sc12.rpy:478
translate brazil ch5sc12_1ccef4e3:

#   mct "{i}*Chuckles* She’s not wrong. This is pretty cool, actually. I was half-expecting her to whine the whole way.{/i}"
    mct "{i}*Risos* Ela não está errada. Isso é bem legal, na verdade. Eu meio que esperava que ela reclamasse o tempo todo.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:479
translate brazil ch5sc12_7f993596:

#   mc "We’re almost at the top."
    mc "Estamos quase no topo."

# game/chapters/chapter5/script/ch5sc12.rpy:480
translate brazil ch5sc12_c466cf69:

#   mc "Looks like there's a pretty big tree up there."
    mc "Parece que tem uma árvore bem grande lá em cima."

# game/chapters/chapter5/script/ch5sc12.rpy:481
translate brazil ch5sc12_c9b15822:

#   mc "It'll probably be a good spot to stop and rest."
    mc "Provavelmente será um bom lugar para parar e descansar."

# game/chapters/chapter5/script/ch5sc12.rpy:483
translate brazil ch5sc12_8fa07da0:

#   am "Woah... That is a big ass tree!"
    am "Uau... Que árvore enorme!"

# game/chapters/chapter5/script/ch5sc12.rpy:484
translate brazil ch5sc12_a66be2cb:

#   am "{b}*Gasps* AND IT HAS RED LEAVES?!{/b}"
    am "{b}*Suspiros* E TEM FOLHAS VERMELHAS?!{/b}"

# game/chapters/chapter5/script/ch5sc12.rpy:485
translate brazil ch5sc12_7b2029ef:

#   mc "Trees come in all shapes, sizes, colors, and some have other oddities."
    mc "As árvores vêm em todos os formatos, tamanhos, cores e algumas têm outras peculiaridades."

# game/chapters/chapter5/script/ch5sc12.rpy:486
translate brazil ch5sc12_d0d0b6c1:

#   mc "But this one does stand out quite a bit."
    mc "Mas este aqui se destaca bastante."

# game/chapters/chapter5/script/ch5sc12.rpy:488
translate brazil ch5sc12_3f43fb38:

#   am "I... I’m in awe."
    am "Eu... eu estou impressionado."

# game/chapters/chapter5/script/ch5sc12.rpy:489
translate brazil ch5sc12_093bcae4:

#   am "To think something like this exists... and we’re only a couple of hours from Luxenford."
    am "Pensar que algo assim existe... e estamos a apenas algumas horas de Luxemburgo."

# game/chapters/chapter5/script/ch5sc12.rpy:490
translate brazil ch5sc12_b0d7cb7d:

#   am "Makes you wonder what else is out there."
    am "Faz você se perguntar o que mais existe por aí."

# game/chapters/chapter5/script/ch5sc12.rpy:491
translate brazil ch5sc12_e984c696:

#   mct "{i}*Chuckles* Heh... She reminds me a little of Eliza when she discovers something new.{/i}"
    mct "{i}*Risos* Heh... Ela me lembra um pouco a Eliza quando descobre algo novo.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:492
translate brazil ch5sc12_b08d3890:

#   mct "{i}They come from such different backgrounds, but they seem to share the same wonder for the world.{/i}"
    mct "{i}Eles vêm de origens tão diferentes, mas parecem compartilhar a mesma admiração pelo mundo.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:494
translate brazil ch5sc12_895ae07d:

#   am "Let’s sit here for a while? It’s so pretty!"
    am "Vamos ficar sentados aqui um pouco? É tão bonito!"

# game/chapters/chapter5/script/ch5sc12.rpy:495
translate brazil ch5sc12_f588456c:

#   mc "Sure. We didn’t come all the way up here to just to turn back immediately-"
    mc "Claro. Não viemos até aqui para simplesmente voltar atrás imediatamente."

# game/chapters/chapter5/script/ch5sc12.rpy:498
translate brazil ch5sc12_cca984b7:

#   am "{b}YESS!!{/b}"
    am "{b}SIM!!{/b}"

# game/chapters/chapter5/script/ch5sc12.rpy:506
translate brazil ch5sc12_525dc95e:

#   am "When was the last time you did something like this?"
    am "Quando foi a última vez que você fez algo assim?"

# game/chapters/chapter5/script/ch5sc12.rpy:507
translate brazil ch5sc12_a6cbb436:

#   mc "Sitting with a princess at the top of a mountain? You’re my first."
    mc "Sentar-me com uma princesa no topo de uma montanha? Você é a minha primeira."

# game/chapters/chapter5/script/ch5sc12.rpy:509
translate brazil ch5sc12_035093e5:

#   am "*Giggles* No, silly! While I’m glad to be your first..."
    am "*Risos* Não, bobinho! Embora eu esteja feliz por ser a sua primeira..."

# game/chapters/chapter5/script/ch5sc12.rpy:510
translate brazil ch5sc12_3d39a378:

#   am "I meant seeing something like this."
    am "Eu quis dizer ver algo assim."

# game/chapters/chapter5/script/ch5sc12.rpy:512
translate brazil ch5sc12_03f450ef:

#   mc "I've been traveling for most of my life."
    mc "Tenho viajado durante a maior parte da minha vida."

# game/chapters/chapter5/script/ch5sc12.rpy:513
translate brazil ch5sc12_c591331b:

#   mc "Pretty much been constantly on the move since the age of ten."
    mc "Praticamente estou em constante movimento desde os dez anos de idade."

# game/chapters/chapter5/script/ch5sc12.rpy:514
translate brazil ch5sc12_e69c41af:

#   mc "So, I’ve seen a lot of places like this, but they all feel unique and each has its own thing going on."
    mc "Então, eu já vi muitos lugares assim, mas todos eles parecem únicos e cada um tem sua própria essência."

# game/chapters/chapter5/script/ch5sc12.rpy:516
translate brazil ch5sc12_c6ca86ee:

#   am "We’re the same age, but you’ve seen so much more of the world..."
    am "Temos a mesma idade, mas você já viu muito mais do mundo..."

# game/chapters/chapter5/script/ch5sc12.rpy:517
translate brazil ch5sc12_91851b0d:

#   am "I envy you."
    am "Eu te invejo."

# game/chapters/chapter5/script/ch5sc12.rpy:519
translate brazil ch5sc12_7a3d9906:

#   mc "It’s not a competition. Besides, you’ve got your whole life ahead of you."
    mc "Não é uma competição. Além disso, você tem a vida inteira pela frente."

# game/chapters/chapter5/script/ch5sc12.rpy:520
translate brazil ch5sc12_bf2be3a5:

#   mc "You’ll have plenty of opportunities to see the world."
    mc "Você terá muitas oportunidades para conhecer o mundo."

# game/chapters/chapter5/script/ch5sc12.rpy:522
translate brazil ch5sc12_8d58c003:

#   am "I desperately want that to be true..."
    am "Desejo desesperadamente que isso seja verdade..."

# game/chapters/chapter5/script/ch5sc12.rpy:523
translate brazil ch5sc12_75d71a31:

#   am "*Sighs heavily* But it’s just not that simple in my position."
    am "*Suspira profundamente* Mas na minha posição não é tão simples assim."

# game/chapters/chapter5/script/ch5sc12.rpy:525
translate brazil ch5sc12_3d568d32:

#   mc "When was the last time you did something like this?"
    mc "Quando foi a última vez que você fez algo assim?"

# game/chapters/chapter5/script/ch5sc12.rpy:527
translate brazil ch5sc12_01219e12:

#   am "Like what? Seeing a tree?"
    am "Tipo o quê? Ver uma árvore?"

# game/chapters/chapter5/script/ch5sc12.rpy:528
translate brazil ch5sc12_5fefccff:

#   mc "*Chuckles* Not exactly how I would’ve put it... but yeah."
    mc "*Risos* Não seria exatamente assim que eu diria... mas enfim."

# game/chapters/chapter5/script/ch5sc12.rpy:529
translate brazil ch5sc12_eebc0f0d:

#   am "The only trees I get to see are those visible from the castle balconies."
    am "As únicas árvores que consigo ver são as que ficam visíveis das varandas do castelo."

# game/chapters/chapter5/script/ch5sc12.rpy:531
translate brazil ch5sc12_a8f932da:

#   am "So, I guess that means you’re my first too! *Giggles*"
    am "Então, acho que isso significa que você também é a minha primeira! *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:533
translate brazil ch5sc12_ed466ebd:

#   am "*Sigh* I’m just happy I finally got to live a little with someone."
    am "*Suspiro* Estou feliz por finalmente ter tido a oportunidade de viver um pouco com alguém."

# game/chapters/chapter5/script/ch5sc12.rpy:534
translate brazil ch5sc12_89a346fc:

#   am "Are the other members of your guild just as awesome as you?"
    am "Os outros membros da sua guilda são tão incríveis quanto você?"

# game/chapters/chapter5/script/ch5sc12.rpy:535
translate brazil ch5sc12_b3e47f96:

#   am "I noticed some were attending the banquet last night."
    am "Notei que alguns estavam presentes no banquete ontem à noite."

# game/chapters/chapter5/script/ch5sc12.rpy:537
translate brazil ch5sc12_58f3e136:

#   mct "{i}Did she just... call me awesome? *Chuckles* That’s a first.{/i}"
    mct "{i}Ela acabou de... me chamar de incrível? *Risos* Essa é a primeira vez.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:538
translate brazil ch5sc12_33f5ae2f:

#   mc "The others are great."
    mc "Os outros são ótimos."

# game/chapters/chapter5/script/ch5sc12.rpy:539
translate brazil ch5sc12_55cd945f:

#   mc "You probably already know Dalen, but I’ll have to introduce you to Eliza at some point."
    mc "Você provavelmente já conhece o Dalen, mas terei que te apresentar a Eliza em algum momento."

# game/chapters/chapter5/script/ch5sc12.rpy:541
translate brazil ch5sc12_132f9f97:

#   am "Eliza..."
    am "Eliza..."

# game/chapters/chapter5/script/ch5sc12.rpy:542
translate brazil ch5sc12_11f09d40:

#   am "What's she like?"
    am "Como ela é?"

# game/chapters/chapter5/script/ch5sc12.rpy:544
translate brazil ch5sc12_04c6376b:

#   mc "She’s the best. Once you earn her trust, she’ll be the most reliable person you’ll ever meet."
    mc "Ela é a melhor. Depois que você conquistar a confiança dela, ela será a pessoa mais confiável que você já conheceu."

# game/chapters/chapter5/script/ch5sc12.rpy:546
translate brazil ch5sc12_42089d70:

#   am "Was she the raven-haired girl at the banquet last night?"
    am "Era ela a garota de cabelos negros que estava no banquete ontem à noite?"

# game/chapters/chapter5/script/ch5sc12.rpy:547
translate brazil ch5sc12_ae2ebd04:

#   am "I saw you sitting together at one of the tables."
    am "Eu vi vocês dois sentados juntos em uma das mesas."

# game/chapters/chapter5/script/ch5sc12.rpy:548
translate brazil ch5sc12_0a3ec38e:

#   mc "That's her. We came to Luxenford together to join the guild."
    mc "Essa é ela. Viemos juntas para Luxemburgo para nos juntarmos à guilda."

# game/chapters/chapter5/script/ch5sc12.rpy:550
translate brazil ch5sc12_2826f245:

#   am "She’s beautiful."
    am "Ela é linda."

# game/chapters/chapter5/script/ch5sc12.rpy:551
translate brazil ch5sc12_1c20b7c3:

#   am "And the other guy sitting with you? I think I’ve seen him before..."
    am "E o outro cara sentado com você? Acho que já o vi antes..."

# game/chapters/chapter5/script/ch5sc12.rpy:553
translate brazil ch5sc12_260facd8:

#   mc "That’s Milton. He's the newest recruit at the guild."
    mc "Esse é o Milton. Ele é o recruta mais novo da guilda."

# game/chapters/chapter5/script/ch5sc12.rpy:555
translate brazil ch5sc12_9623f888:

#   am "Oh, Milton? I remember a guard by that name."
    am "Ah, Milton? Lembro-me de um guarda com esse nome."

# game/chapters/chapter5/script/ch5sc12.rpy:556
translate brazil ch5sc12_f43ade69:

#   am "He struck me as being a little too sweet for guard duty."
    am "Achei-o um pouco bonzinho demais para o serviço de guarda."

# game/chapters/chapter5/script/ch5sc12.rpy:558
translate brazil ch5sc12_bb7fd1d3:

#   mc "Yeah... I think he’s better suited for helping people with us, than enforcing laws."
    mc "Sim... Acho que ele é mais indicado para ajudar as pessoas do que para aplicar a lei."

# game/chapters/chapter5/script/ch5sc12.rpy:560
translate brazil ch5sc12_aaac5798:

#   am "*Laughs lightly* Agreed!"
    am "*Risos discretos* Concordo!"

# game/chapters/chapter5/script/ch5sc12.rpy:561
translate brazil ch5sc12_74779864:

#   am "I could literally hear his armor jittering whenever I walked near him."
    am "Eu conseguia literalmente ouvir sua armadura vibrando sempre que me aproximava dele."

# game/chapters/chapter5/script/ch5sc12.rpy:563
translate brazil ch5sc12_e2982be6:

#   mc "We also have a fairy in the guild, Sylph."
    mc "Nós também temos uma fada na guilda, Sylph."

# game/chapters/chapter5/script/ch5sc12.rpy:564
translate brazil ch5sc12_86a52c01:

#   mc "But I’d appreciate it if you don’t mention her to everyone else."
    mc "Mas eu agradeceria se você não a mencionasse para todos os outros."

# game/chapters/chapter5/script/ch5sc12.rpy:566
translate brazil ch5sc12_f9c55081:

#   am "I promise, I won’t."
    am "Prometo que não farei isso."

# game/chapters/chapter5/script/ch5sc12.rpy:567
translate brazil ch5sc12_20b24506:

#   am "I’ve heard about what some people do to fairies."
    am "Já ouvi falar do que algumas pessoas fazem com as fadas."

# game/chapters/chapter5/script/ch5sc12.rpy:569
translate brazil ch5sc12_c1ce034e:

#   am "It’s not something I'd wish upon anyone."
    am "Não é algo que eu desejaria a ninguém."

# game/chapters/chapter5/script/ch5sc12.rpy:571
translate brazil ch5sc12_dac859ec:

#   am "I’d love to meet all of them, someday."
    am "Adoraria conhecer todos eles um dia."

# game/chapters/chapter5/script/ch5sc12.rpy:572
translate brazil ch5sc12_5bea0065:

#   am "If you trust them, then they must be great people."
    am "Se você confia neles, então eles devem ser ótimas pessoas."

# game/chapters/chapter5/script/ch5sc12.rpy:574
translate brazil ch5sc12_bdd8d10d:

#   mc "I’ll introduce you, sometime."
    mc "Eu te apresentarei, algum dia."

# game/chapters/chapter5/script/ch5sc12.rpy:575
translate brazil ch5sc12_9e020fa4:

#   mc "Oh, and I forgot to mention Borri. He's a bullheaded, but very reliable dwarf."
    mc "Ah, e esqueci de mencionar o Borri. Ele é um anão teimoso, mas muito confiável."

# game/chapters/chapter5/script/ch5sc12.rpy:576
translate brazil ch5sc12_749cbce3:

#   mc "And my cousin, Flynn, too."
    mc "E meu primo, Flynn, também."

# game/chapters/chapter5/script/ch5sc12.rpy:577
translate brazil ch5sc12_5b027e27:

#   mc "He’s not a part of our guild but he hangs around with us pretty often."
    mc "Ele não faz parte da nossa guilda, mas está sempre por perto."

# game/chapters/chapter5/script/ch5sc12.rpy:579
translate brazil ch5sc12_cd8007d5:

#   am "Oh? An actual family member?"
    am "Ah? Um membro da família de verdade?"

# game/chapters/chapter5/script/ch5sc12.rpy:581
translate brazil ch5sc12_5dada080:

#   am "What’s he like? Is he anything like... you?"
    am "Como ele é? Ele se parece com... você?"

# game/chapters/chapter5/script/ch5sc12.rpy:583
translate brazil ch5sc12_0773fa7a:

#   mc "*Chuckles* What? Looking to replace me already?"
    mc "*Risos* O quê? Já querem me substituir?"

# game/chapters/chapter5/script/ch5sc12.rpy:585
translate brazil ch5sc12_95ffd129:

#   am "No... *Mumbles* Nobody could do that."
    am "Não... *Murmura* Ninguém conseguiria fazer isso."

# game/chapters/chapter5/script/ch5sc12.rpy:587
translate brazil ch5sc12_986ab796:

#   mc "Flynn is... Hmh. I’m not sure where to begin."
    mc "Flynn é... Hmh. Não sei bem por onde começar."

# game/chapters/chapter5/script/ch5sc12.rpy:588
translate brazil ch5sc12_b3a6f614:

#   mc "Anything I say will make him sound... like a buffoon with a good heart."
    mc "Qualquer coisa que eu diga vai fazê-lo parecer... um bobo de bom coração."

# game/chapters/chapter5/script/ch5sc12.rpy:590
translate brazil ch5sc12_858d395e:

#   am "*Giggles* So, exactly like you?"
    am "*Risos* Então, exatamente como você?"

# game/chapters/chapter5/script/ch5sc12.rpy:592
translate brazil ch5sc12_315232e1:

#   mc "*Chuckles* You’re teasing me relentlessly today."
    mc "*Risos* Você está me provocando sem parar hoje."

# game/chapters/chapter5/script/ch5sc12.rpy:594
translate brazil ch5sc12_56f91bac:

#   am "You make it so easy for me!"
    am "Você torna tudo tão fácil para mim!"

# game/chapters/chapter5/script/ch5sc12.rpy:595
translate brazil ch5sc12_9c76c557:

#   am "Besides, if I can’t tease my own bodyguard, how will I ever have any fun?"
    am "Além disso, se eu não posso provocar meu próprio guarda-costas, como vou me divertir?"

# game/chapters/chapter5/script/ch5sc12.rpy:597
translate brazil ch5sc12_c57d13b0:

#   mc "Don’t you have a whole array of servants you can tease?"
    mc "Você não tem uma variedade enorme de servos que você pode provocar?"

# game/chapters/chapter5/script/ch5sc12.rpy:599
translate brazil ch5sc12_d0c8c325:

#   am "They’re no fun. You’re fun!"
    am "Eles não têm graça nenhuma. Você é que é divertido!"

# game/chapters/chapter5/script/ch5sc12.rpy:600
translate brazil ch5sc12_9d8480c6:

#   am "And... we’re friends... right?"
    am "E... somos amigos... certo?"

# game/chapters/chapter5/script/ch5sc12.rpy:602
translate brazil ch5sc12_ddd2c949:

#   mc "I’d say we are."
    mc "Eu diria que sim."

# game/chapters/chapter5/script/ch5sc12.rpy:603
translate brazil ch5sc12_792d74af:

#   mc "Which is the only reason I’m tolerating your teasing, Princess."
    mc "Essa é a única razão pela qual estou tolerando suas provocações, Princesa."

# game/chapters/chapter5/script/ch5sc12.rpy:605
translate brazil ch5sc12_da47a288:

#   am "Other than Frida, and now you, I don’t have anyone else I’d consider a friend."
    am "Além da Frida, e agora de você, não tenho mais ninguém que eu consideraria um amigo."

# game/chapters/chapter5/script/ch5sc12.rpy:606
translate brazil ch5sc12_036ea97c:

#   am "I’ve always wanted to have friends like you do. Friends that would do anything for each other."
    am "Sempre quis ter amigos como vocês. Amigos que fariam qualquer coisa um pelo outro."

# game/chapters/chapter5/script/ch5sc12.rpy:608
translate brazil ch5sc12_49c2652a:

#   mc "If there’s one thing I’ve learned, it's that the number of friends you have doesn't matter."
    mc "Se há uma coisa que aprendi, é que o número de amigos que você tem não importa."

# game/chapters/chapter5/script/ch5sc12.rpy:609
translate brazil ch5sc12_5498143e:

#   mc "It’s their quality that's important."
    mc "O importante é a qualidade deles."

# game/chapters/chapter5/script/ch5sc12.rpy:611
translate brazil ch5sc12_a0d8d047:

#   am "*Mumbles* I want that... with you."
    am "*Murmura* Eu quero isso... com você."

# game/chapters/chapter5/script/ch5sc12.rpy:613
translate brazil ch5sc12_c70f9a87:

#   mc "Hmh?"
    mc "Hum?"

# game/chapters/chapter5/script/ch5sc12.rpy:616
translate brazil ch5sc12_6b41020f:

#   am "N-Nothing."
    am "N-Nada."

# game/chapters/chapter5/script/ch5sc12.rpy:617
translate brazil ch5sc12_16e225dc:

#   am "Shall we go sit by the water for a bit?"
    am "Vamos sentar um pouco perto da água?"

# game/chapters/chapter5/script/ch5sc12.rpy:618
translate brazil ch5sc12_54b9c852:

#   mc "Sure, that sounds nice."
    mc "Claro, isso parece ótimo."

# game/chapters/chapter5/script/ch5sc12.rpy:623
translate brazil ch5sc12_7f2f6d12:

#   am "Mnhh... My feet are a little sore from hiking up here. Feels nice to get my boots off."
    am "Hum... Meus pés estão um pouco doloridos da caminhada até aqui. É bom tirar as botas."

# game/chapters/chapter5/script/ch5sc12.rpy:624
translate brazil ch5sc12_e865c9cf:

#   am "The grass and leaves here feels so cool and soft... Mnh."
    am "A grama e as folhas aqui são tão frescas e macias... Mnh."

# game/chapters/chapter5/script/ch5sc12.rpy:626
translate brazil ch5sc12_df17c7f6:

#   am "Aren't you taking yours off?"
    am "Você não vai tirar o seu?"

# game/chapters/chapter5/script/ch5sc12.rpy:627
translate brazil ch5sc12_4f22aa68:

#   mc "I’ll pass."
    mc "Eu vou passar."

# game/chapters/chapter5/script/ch5sc12.rpy:628
translate brazil ch5sc12_526d33f5:

#   am "You don’t know what you’re missing... *Giggles*"
    am "Você não sabe o que está perdendo... *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:630
translate brazil ch5sc12_3e107b26:

#   am "We should do this more often."
    am "Deveríamos fazer isso com mais frequência."

# game/chapters/chapter5/script/ch5sc12.rpy:631
translate brazil ch5sc12_ee281e2d:

#   mc "I could be convinced ..."
    mc "Eu poderia ser convencido..."

# game/chapters/chapter5/script/ch5sc12.rpy:632
translate brazil ch5sc12_e65b5aca:

#   mc "But your parents might start to wonder where we disappear off to for hours on end."
    mc "Mas seus pais podem começar a se perguntar para onde desaparecemos por horas a fio."

# game/chapters/chapter5/script/ch5sc12.rpy:633
translate brazil ch5sc12_7ccb33cb:

#   am "Yeah... If only they’d let me live my life."
    am "É... Se ao menos me deixassem viver minha vida."

# game/chapters/chapter5/script/ch5sc12.rpy:635
translate brazil ch5sc12_e5975e22:

#   am "This is what I want life to be... joyful moments with people I care about."
    am "É isso que eu quero da vida... momentos felizes com as pessoas que eu amo."

# game/chapters/chapter5/script/ch5sc12.rpy:636
translate brazil ch5sc12_5a69a69c:

#   am "With true friends, you know?"
    am "Com os verdadeiros amigos, sabe?"

# game/chapters/chapter5/script/ch5sc12.rpy:637
translate brazil ch5sc12_32857969:

#   mct "*Chuckles* I guess that confirms it, she genuinely thinks of me as a friend."
    mct "*Risos* Acho que isso confirma, ela realmente me considera uma amiga."

# game/chapters/chapter5/script/ch5sc12.rpy:638
translate brazil ch5sc12_858e3008:

#   am "Just be able to walk anywhere, see whatever is there... meet interesting people."
    am "Simplesmente poder caminhar para qualquer lugar, ver o que quer que esteja lá... conhecer pessoas interessantes."

# game/chapters/chapter5/script/ch5sc12.rpy:640
translate brazil ch5sc12_ece6a531:

#   mc "I get it. Maybe your parents will ease up on you?"
    mc "Entendo. Talvez seus pais peguem mais leve com você?"

# game/chapters/chapter5/script/ch5sc12.rpy:641
translate brazil ch5sc12_ed639025:

#   am "That’s wishful thinking."
    am "Isso é pura ilusão."

# game/chapters/chapter5/script/ch5sc12.rpy:642
translate brazil ch5sc12_b27c337a:

#   am "They won’t ease up until they’ve shackled me to some perverted nobleson."
    am "Eles não vão dar trégua até me acorrentarem a algum nobre pervertido."

# game/chapters/chapter5/script/ch5sc12.rpy:644
translate brazil ch5sc12_6beb81ac:

#   am "Do I look like an object to you, [mc]?"
    am "Eu pareço um objeto para você? [mc]?"

# game/chapters/chapter5/script/ch5sc12.rpy:646
translate brazil ch5sc12_d9af6597:

#   mc "No?"
    mc "Não?"

# game/chapters/chapter5/script/ch5sc12.rpy:648
translate brazil ch5sc12_7f984301:

#   am "Then why do my parents go to such lengths to make me feel like one?"
    am "Então por que meus pais se esforçam tanto para me fazer sentir como um deles?"

# game/chapters/chapter5/script/ch5sc12.rpy:650
translate brazil ch5sc12_e23d0ec8:

#   am "Are your parents like that too?"
    am "Seus pais também são assim?"

# game/chapters/chapter5/script/ch5sc12.rpy:651
translate brazil ch5sc12_9bd00721:

#   am "Do they get on your case about everything you do?"
    am "Eles ficam te criticando por tudo o que você faz?"

# game/chapters/chapter5/script/ch5sc12.rpy:653
translate brazil ch5sc12_ad986627:

#   mc "My parents... they’re dead."
    mc "Meus pais... eles estão mortos."

# game/chapters/chapter5/script/ch5sc12.rpy:656
translate brazil ch5sc12_9d5f6586:

#   mc "Happened a lifetime ago... when I was ten summers."
    mc "Aconteceu há uma eternidade... quando eu tinha dez anos, durante o verão."

# game/chapters/chapter5/script/ch5sc12.rpy:658
translate brazil ch5sc12_c45ab373:

#   mc "They were murdered... in cold blood. All because of me."
    mc "Eles foram assassinados... a sangue frio. Tudo por minha causa."

# game/chapters/chapter5/script/ch5sc12.rpy:659
translate brazil ch5sc12_f74f6e91:

#   mc "A man came to our vill-"
    mc "Um homem veio à nossa aldeia-"

# game/chapters/chapter5/script/ch5sc12.rpy:662
translate brazil ch5sc12_fc3cc0e5:

#   "You feel Amelia's arms wrap around you, like a blanket of comfort."
    "Você sente os braços de Amelia te envolverem, como um cobertor de conforto."

# game/chapters/chapter5/script/ch5sc12.rpy:663
translate brazil ch5sc12_1a3a88d6:

#   am "That's why you’ve been on the move since you were ten? I'd been wondering about that."
    am "É por isso que você está sempre se mudando desde os dez anos? Eu estava me perguntando sobre isso."

# game/chapters/chapter5/script/ch5sc12.rpy:664
translate brazil ch5sc12_92a2fb3d:

#   am "I’m so sorry. I didn’t know. And here I’ve been yapping about my parents, who’re both still healthy and alive..."
    am "Sinto muito. Eu não sabia. E aqui estou eu falando dos meus pais, que estão ambos vivos e saudáveis..."

# game/chapters/chapter5/script/ch5sc12.rpy:666
translate brazil ch5sc12_81d6baea:

#   mc "Amelia... It’s okay, you couldn’t have known."
    mc "Amélia... Tudo bem, você não tinha como saber."

# game/chapters/chapter5/script/ch5sc12.rpy:667
translate brazil ch5sc12_d7df403a:

#   mc "And even then, you don't have to apologize for talking about your own issues."
    mc "E mesmo assim, você não precisa se desculpar por falar sobre seus próprios problemas."

# game/chapters/chapter5/script/ch5sc12.rpy:668
translate brazil ch5sc12_69ee8cf9:

#   mc "We all live different lives. Comparing our misery or happiness to someone else, it doesn't do anyone any good."
    mc "Todos vivemos vidas diferentes. Comparar nossa infelicidade ou felicidade com a de outra pessoa não beneficia ninguém."

# game/chapters/chapter5/script/ch5sc12.rpy:670
translate brazil ch5sc12_e22061e5:

#   am "*Hugs tightly* Hnnghh. Still..."
    am "*Abraça forte* Hnnghh. Mesmo assim..."

# game/chapters/chapter5/script/ch5sc12.rpy:672
translate brazil ch5sc12_928d1d8e:

#   am "I’m sorry... I shouldn’t... I shouldn’t have asked about them."
    am "Me desculpe... Eu não deveria... Eu não deveria ter perguntado sobre eles."

# game/chapters/chapter5/script/ch5sc12.rpy:673
translate brazil ch5sc12_28c405c3:

#   am "Please say that you forgive me? I’m such a bad friend..."
    am "Por favor, diga que me perdoa? Sou uma péssima amiga..."

# game/chapters/chapter5/script/ch5sc12.rpy:675
translate brazil ch5sc12_a36de966:

#   mc "There’s nothing to forgive."
    mc "Não há nada a perdoar."

# game/chapters/chapter5/script/ch5sc12.rpy:676
translate brazil ch5sc12_f67eb71d:

#   mc "If I didn’t consider you a friend, I wouldn’t have told you about them."
    mc "Se eu não te considerasse um amigo, não teria te contado sobre eles."

# game/chapters/chapter5/script/ch5sc12.rpy:678
translate brazil ch5sc12_1110f7fd:

#   am "Then I’m glad you told me."
    am "Então fico feliz que você tenha me contado."

# game/chapters/chapter5/script/ch5sc12.rpy:679
translate brazil ch5sc12_9cf1bf1f:

#   am "I feel... I feel closer to you than before."
    am "Eu sinto... eu sinto que estou mais perto de você do que antes."

# game/chapters/chapter5/script/ch5sc12.rpy:681
translate brazil ch5sc12_d6fd6f73:

#   mc "That doesn’t have anything to do with the fact you’re hugging me tightly?"
    mc "Isso não tem nada a ver com o fato de você estar me abraçando forte?"

# game/chapters/chapter5/script/ch5sc12.rpy:684
translate brazil ch5sc12_b732ec43:

#   am "I meant emotionally! *Giggles* J-Jerk!"
    am "Eu quis dizer emocionalmente! *Risos* Idiota!"

# game/chapters/chapter5/script/ch5sc12.rpy:685
translate brazil ch5sc12_bf4eeae7:

#   am "If I didn’t feel incredibly bad for you right now, I’d push you right into the water!"
    am "Se eu não estivesse com muita pena de você agora, eu te empurraria direto na água!"

# game/chapters/chapter5/script/ch5sc12.rpy:686
translate brazil ch5sc12_fe51cde4:

#   mc "*Chuckles* Okay, okay! Sheesh woman! Sit down before we both take a swim."
    mc "*Risos* Tá bom, tá bom! Nossa, mulher! Senta aí antes que a gente dê um mergulho."

# game/chapters/chapter5/script/ch5sc12.rpy:688
translate brazil ch5sc12_50f85714:

#   mc "I can’t believe you almost put us both in the water."
    mc "Não acredito que você quase nos colocou na água."

# game/chapters/chapter5/script/ch5sc12.rpy:690
translate brazil ch5sc12_91215191:

#   am "I’m willing to make sacrifices if it means punishing you!"
    am "Estou disposto a fazer sacrifícios se isso significar punir você!"

# game/chapters/chapter5/script/ch5sc12.rpy:691
translate brazil ch5sc12_8b37f95e:

#   bth "*Laughs*"
    bth "*Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:692
translate brazil ch5sc12_0133f48b:

#   am "You said... they were killed? Do you know who did it?"
    am "Você disse... que eles foram mortos? Você sabe quem fez isso?"

# game/chapters/chapter5/script/ch5sc12.rpy:694
translate brazil ch5sc12_2f068911:

#   mc "I do."
    mc "Eu faço."

# game/chapters/chapter5/script/ch5sc12.rpy:695
translate brazil ch5sc12_eec6b963:

#   am "But you’re not going to tell me, are you?"
    am "Mas você não vai me contar, vai?"

# game/chapters/chapter5/script/ch5sc12.rpy:696
translate brazil ch5sc12_fca52711:

#   mc "No."
    mc "Não."

# game/chapters/chapter5/script/ch5sc12.rpy:698
translate brazil ch5sc12_b2057d98:

#   am "You know you can trust me, right?"
    am "Você sabe que pode confiar em mim, não é?"

# game/chapters/chapter5/script/ch5sc12.rpy:699
translate brazil ch5sc12_fd45b9e4:

#   am "I wouldn’t just go running off to tell anyone..."
    am "Eu não sairia correndo para contar a qualquer um..."

# game/chapters/chapter5/script/ch5sc12.rpy:700
translate brazil ch5sc12_10d2cc0b:

#   am "I wouldn’t even tell Frida something you told me in confidence."
    am "Eu jamais contaria para Frida algo que você me contou em confidência."

# game/chapters/chapter5/script/ch5sc12.rpy:701
translate brazil ch5sc12_8b7ac0e0:

#   mc "It’s not that I don’t trust you, but I don’t want you to get involved in this."
    mc "Não é que eu não confie em você, mas não quero que você se envolva nisso."

# game/chapters/chapter5/script/ch5sc12.rpy:702
translate brazil ch5sc12_15ca6268:

#   am "The murder of your parents... that's why you came to Luxenford, isn't it?"
    am "O assassinato de seus pais... foi por isso que você veio para Luxenford, não foi?"

# game/chapters/chapter5/script/ch5sc12.rpy:703
translate brazil ch5sc12_b6542a16:

#   mct "{i}She’s more observant than I initially thought.{/i}"
    mct "{i}Ela é mais observadora do que eu imaginava inicialmente.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:704
translate brazil ch5sc12_e1b86203:

#   mc "Yes. That's what brought me here initially, and it's still one of my primary reasons for staying."
    mc "Sim. Foi isso que me trouxe aqui inicialmente, e continua sendo um dos principais motivos para eu ficar."

# game/chapters/chapter5/script/ch5sc12.rpy:706
translate brazil ch5sc12_b0643369:

#   am "I see. So, if it wasn’t for that, you’d leave again?"
    am "Entendi. Então, se não fosse por isso, você iria embora de novo?"

# game/chapters/chapter5/script/ch5sc12.rpy:708
translate brazil ch5sc12_7ba80f5a:

#   mc "I used to think so. But after everything that has happened since we arrived..."
    mc "Eu costumava pensar assim. Mas depois de tudo o que aconteceu desde que chegamos..."

# game/chapters/chapter5/script/ch5sc12.rpy:709
translate brazil ch5sc12_3e62a9d1:

#   mc "I’ve found new reasons to stay."
    mc "Encontrei novos motivos para ficar."

# game/chapters/chapter5/script/ch5sc12.rpy:711
translate brazil ch5sc12_5bd1b123:

#   am "I’m... I’m glad."
    am "Estou... estou feliz."

# game/chapters/chapter5/script/ch5sc12.rpy:713
translate brazil ch5sc12_03f73089:

#   am "Have you had any luck so far?"
    am "Você já teve alguma sorte até agora?"

# game/chapters/chapter5/script/ch5sc12.rpy:714
translate brazil ch5sc12_377562ff:

#   am "Finding the person responsible, I mean."
    am "Quero dizer, encontrar o responsável."

# game/chapters/chapter5/script/ch5sc12.rpy:716
translate brazil ch5sc12_68cf96f7:

#   mc "I haven’t been able to confront him yet."
    mc "Ainda não consegui confrontá-lo."

# game/chapters/chapter5/script/ch5sc12.rpy:717
translate brazil ch5sc12_f630d209:

#   mc "There have been times when I was close, but something else got in my way."
    mc "Houve momentos em que estive perto, mas algo me impediu."

# game/chapters/chapter5/script/ch5sc12.rpy:719
translate brazil ch5sc12_18b41133:

#   am "I can’t imagine what it’s been like for you all this time?"
    am "Não consigo imaginar como tem sido para vocês todo esse tempo."

# game/chapters/chapter5/script/ch5sc12.rpy:720
translate brazil ch5sc12_cbea1d47:

#   am "How it must still feel."
    am "Como deve ser essa sensação até hoje."

# game/chapters/chapter5/script/ch5sc12.rpy:722
translate brazil ch5sc12_923a22b9:

#   mc "It hasn’t been easy..."
    mc "Não tem sido fácil..."

# game/chapters/chapter5/script/ch5sc12.rpy:723
translate brazil ch5sc12_28b46e5f:

#   mc "But there are plenty of people out there who have it worse."
    mc "Mas há muitas pessoas por aí em situação pior."

# game/chapters/chapter5/script/ch5sc12.rpy:725
translate brazil ch5sc12_2501c321:

#   am "Didn’t you just tell me that it's pointless comparing your own issues to other people's?"
    am "Você não acabou de me dizer que é inútil comparar seus próprios problemas com os de outras pessoas?"

# game/chapters/chapter5/script/ch5sc12.rpy:727
translate brazil ch5sc12_d6d191de:

#   mc "*Chuckles* Right... I think I need to be careful what I say around you. You’re as sharp as a razor."
    mc "*Risos* É... Acho que preciso ter cuidado com o que digo perto de você. Você é afiada como uma navalha."

# game/chapters/chapter5/script/ch5sc12.rpy:728
translate brazil ch5sc12_f2c11106:

#   am "*Giggles* I like to think I'm like a squirrel: tiny and cute, but if you touch my nuts I’ll go berzerk!"
    am "*Risos* Eu gosto de pensar que sou como um esquilo: pequeno e fofo, mas se você tocar nas minhas bolas, eu vou enlouquecer!"

# game/chapters/chapter5/script/ch5sc12.rpy:729
translate brazil ch5sc12_2bef80c6:

#   mc "*Chuckles* What?"
    mc "*Risos* O quê?"

# game/chapters/chapter5/script/ch5sc12.rpy:731
translate brazil ch5sc12_915c4ddf:

#   am "Uhhh- Let’s forget I made that comparison! Erase it from your mind! Now!"
    am "Uhhh... Vamos esquecer que eu fiz essa comparação! Apague isso da sua mente! Agora!"

# game/chapters/chapter5/script/ch5sc12.rpy:733
translate brazil ch5sc12_1678b782:

#   mc "I’m afraid you've thoroughly imprinted it into my skull."
    mc "Receio que você tenha gravado isso completamente na minha mente."

# game/chapters/chapter5/script/ch5sc12.rpy:734
translate brazil ch5sc12_c93fe3e0:

#   am "*Sighs* Great..."
    am "*Suspiros* Ótimo..."

# game/chapters/chapter5/script/ch5sc12.rpy:736
translate brazil ch5sc12_2e00f70d:

#   am "I... *Stomach growls*"
    am "Eu... *Estômago ronca*"

# game/chapters/chapter5/script/ch5sc12.rpy:738
translate brazil ch5sc12_6a31178d:

#   mc "Hungry?"
    mc "Com fome?"

# game/chapters/chapter5/script/ch5sc12.rpy:739
translate brazil ch5sc12_ebd81d1c:

#   am "No..."
    am "Não..."

# game/chapters/chapter5/script/ch5sc12.rpy:740
translate brazil ch5sc12_77615470:

#   mc "C’mon. Let’s head back to the market and get you something to eat."
    mc "Vamos lá. Vamos voltar ao mercado e comprar algo para você comer."

# game/chapters/chapter5/script/ch5sc12.rpy:742
translate brazil ch5sc12_e1c88ac8:

#   am "I’ll only eat something if you get something too!"
    am "Só vou comer alguma coisa se você também comer alguma coisa!"

# game/chapters/chapter5/script/ch5sc12.rpy:743
translate brazil ch5sc12_a4c5b234:

#   mc "What kind of logic is that?"
    mc "Que tipo de lógica é essa?"

# game/chapters/chapter5/script/ch5sc12.rpy:744
translate brazil ch5sc12_a86d8b4d:

#   am "Take it or leave it."
    am "Aceite ou recuse."

# game/chapters/chapter5/script/ch5sc12.rpy:746
translate brazil ch5sc12_f0e7bf5b:

#   mc "Remember your boots and cape."
    mc "Não se esqueça das suas botas e da sua capa."

# game/chapters/chapter5/script/ch5sc12.rpy:747
translate brazil ch5sc12_c6646dc9:

#   am "Right! My mind was already halfway down the mountain..."
    am "Certo! Minha mente já estava na metade do caminho montanha abaixo..."

# game/chapters/chapter5/script/ch5sc12.rpy:749
translate brazil ch5sc12_f1dd9f23:

#   am "I’m really happy we did this. You have no idea how much I needed this in my life."
    am "Estou muito feliz por termos feito isso. Você não imagina o quanto eu precisava disso na minha vida."

# game/chapters/chapter5/script/ch5sc12.rpy:750
translate brazil ch5sc12_4771dc61:

#   mc "I’m... actually happy we did it, too. It’s nice to see you being... well, you."
    mc "Na verdade, também estou feliz por termos feito isso. É bom ver você sendo... bem, você mesma."

# game/chapters/chapter5/script/ch5sc12.rpy:751
translate brazil ch5sc12_9971c47c:

#   am "Good! This means you’ll be excited next time I suggest we go on an adventure together."
    am "Ótimo! Isso significa que você ficará animado(a) na próxima vez que eu sugerir que partamos em uma aventura juntos."

# game/chapters/chapter5/script/ch5sc12.rpy:752
translate brazil ch5sc12_76128df9:

#   mc "Let’s not push it... *Chuckles*"
    mc "Não vamos exagerar... *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:761
translate brazil ch5sc12_5e79a75e:

#   am "I’m dreading going back to the castle..."
    am "Estou com receio de voltar ao castelo..."

# game/chapters/chapter5/script/ch5sc12.rpy:762
translate brazil ch5sc12_2876efd9:

#   mc "Why?"
    mc "Por que?"

# game/chapters/chapter5/script/ch5sc12.rpy:764
translate brazil ch5sc12_86fe0a48:

#   am "They’re going to scold me for being gone so long, even if they don’t know where we've been."
    am "Eles vão me repreender por ter ficado tanto tempo fora, mesmo que não saibam onde estivemos."

# game/chapters/chapter5/script/ch5sc12.rpy:765
translate brazil ch5sc12_66e391f2:

#   am "But it’s worse than just that."
    am "Mas é pior do que isso."

# game/chapters/chapter5/script/ch5sc12.rpy:766
translate brazil ch5sc12_345de7c5:

#   am "Last night, that creep, Cassian. Told me his father was making a deal with mine... about me."
    am "Ontem à noite, aquele cretino, Cassian, me disse que o pai dele estava fazendo um acordo com o meu... sobre mim."

# game/chapters/chapter5/script/ch5sc12.rpy:768
translate brazil ch5sc12_08191cf8:

#   am "Ugh! I can’t bear the thought of it. What it's going to mean..."
    am "Argh! Só de pensar nisso já me dá arrepios. O que isso vai significar..."

# game/chapters/chapter5/script/ch5sc12.rpy:769
translate brazil ch5sc12_72d00ebb:

#   mc "Surely he knows what kind of people they are? They aren’t exactly subtle about it."
    mc "Certamente ele sabe que tipo de pessoas eles são? Eles não são exatamente sutis quanto a isso."

# game/chapters/chapter5/script/ch5sc12.rpy:770
translate brazil ch5sc12_74b283b6:

#   am "At some point, his daughter's happiness will be eclipsed by the wellbeing of the Kingdom."
    am "Em algum momento, a felicidade de sua filha será ofuscada pelo bem-estar do Reino."

# game/chapters/chapter5/script/ch5sc12.rpy:772
translate brazil ch5sc12_09e2f718:

#   mc "What about your mother? Can’t she do something? Surely she doesn’t want you to be married off to some sicko."
    mc "E a sua mãe? Ela não pode fazer nada? Com ​​certeza ela não quer que você se case com algum doente."

# game/chapters/chapter5/script/ch5sc12.rpy:773
translate brazil ch5sc12_bc24fd67:

#   am "She can’t do anything. You know how it is... the man's decision is final in any marriage."
    am "Ela não pode fazer nada. Você sabe como é... a decisão do homem é final em qualquer casamento."

# game/chapters/chapter5/script/ch5sc12.rpy:774
translate brazil ch5sc12_84024701:

#   am "The best she can do is try to cajole or persuade, try to give little nudges occasionally."
    am "O melhor que ela pode fazer é tentar persuadir ou convencer, tentar dar pequenos empurrões de vez em quando."

# game/chapters/chapter5/script/ch5sc12.rpy:776
translate brazil ch5sc12_3d3e64ee:

#   mc "I see a few food stalls up ahead, let’s go see what they’ve got."
    mc "Vejo algumas barracas de comida mais à frente, vamos ver o que elas têm."

# game/chapters/chapter5/script/ch5sc12.rpy:778
translate brazil ch5sc12_e64e665d:

#   am "One of these, please!"
    am "Um destes, por favor!"

# game/chapters/chapter5/script/ch5sc12.rpy:780
translate brazil ch5sc12_9a9b5a38:

#   am "Mmm."
    am "Hum."

# game/chapters/chapter5/script/ch5sc12.rpy:784
translate brazil ch5sc12_2589d182:

#   am "Mpff, so good!"
    am "Mff, que delícia!"

# game/chapters/chapter5/script/ch5sc12.rpy:788
translate brazil ch5sc12_c5809b0b:

#   am "Yum!"
    am "Que delícia!"

# game/chapters/chapter5/script/ch5sc12.rpy:790
translate brazil ch5sc12_59e39353:

#   am "One of these for him."
    am "Uma dessas para ele."

# game/chapters/chapter5/script/ch5sc12.rpy:792
translate brazil ch5sc12_6ff4d341:

#   am "Also one of these!"
    am "Também um destes!"

# game/chapters/chapter5/script/ch5sc12.rpy:794
translate brazil ch5sc12_8a50870b:

#   am "And he wishes to try these as well."
    am "E ele também deseja experimentar estes."

# game/chapters/chapter5/script/ch5sc12.rpy:797
translate brazil ch5sc12_7880e0e2:

#   am "Aahh... No more. My belly, I’m so full!"
    am "Ahh... Chega. Minha barriga está tão cheia!"

# game/chapters/chapter5/script/ch5sc12.rpy:798
translate brazil ch5sc12_e56a296f:

#   mc "*Chuckles* With the way you gobbled down all of that? It’s no wonder..."
    mc "*Risos* Com a maneira como você devorou ​​tudo isso? Não é de admirar..."

# game/chapters/chapter5/script/ch5sc12.rpy:800
translate brazil ch5sc12_16dad152:

#   mc "I take it you enjoyed the food, then?"
    mc "Imagino que tenha gostado da comida, então?"

# game/chapters/chapter5/script/ch5sc12.rpy:801
translate brazil ch5sc12_9053a440:

#   am "I did. I adore the food here in the market. When I can, Frida and I come here to pick out some goodies."
    am "Sim, eu adoro. Adoro a comida daqui do mercado. Sempre que posso, Frida e eu viemos aqui escolher algumas delícias."

# game/chapters/chapter5/script/ch5sc12.rpy:802
translate brazil ch5sc12_b0eb43a7:

#   mc "That's how we first met."
    mc "Foi assim que nos conhecemos."

# game/chapters/chapter5/script/ch5sc12.rpy:803
translate brazil ch5sc12_30843799:

#   am "Y-Yeah. You remember?"
    am "S-Sim. Você se lembra?"

# game/chapters/chapter5/script/ch5sc12.rpy:805
translate brazil ch5sc12_7caeb939:

#   mc "Vividly."
    mc "Vividamente."

# game/chapters/chapter5/script/ch5sc12.rpy:806
translate brazil ch5sc12_b28f02b4:

#   am "There’s always so much variety here, you never know what-"
    am "Aqui sempre há tanta variedade, você nunca sabe o que vai encontrar."

# game/chapters/chapter5/script/ch5sc12.rpy:807
translate brazil ch5sc12_43979b9a:

#   wo "Fresh cookies! New glazings today! Get them before your friends do!"
    wo "Biscoitos fresquinhos! Coberturas novas hoje! Garanta os seus antes que seus amigos os peguem!"

# game/chapters/chapter5/script/ch5sc12.rpy:809
translate brazil ch5sc12_6168e7c2:

#   am "C-Cookies?"
    am "C-Cookies?"

# game/chapters/chapter5/script/ch5sc12.rpy:810
translate brazil ch5sc12_4f1384fd:

#   mc "Do you like cookies?"
    mc "Você gosta de biscoitos?"

# game/chapters/chapter5/script/ch5sc12.rpy:811
translate brazil ch5sc12_ba8e78a8:

#   am "Y-Yeah."
    am "S-Sim."

# game/chapters/chapter5/script/ch5sc12.rpy:812
translate brazil ch5sc12_632a271e:

#   mc "Let’s check it out."
    mc "Vamos dar uma olhada."

# game/chapters/chapter5/script/ch5sc12.rpy:813
translate brazil ch5sc12_e7be23d6:

#   am "O-Okay."
    am "Ok."

# game/chapters/chapter5/script/ch5sc12.rpy:814
translate brazil ch5sc12_f5475c40:

#   wo "Fresh cookies! Baked just this morning at the Cookie Cottage!"
    wo "Biscoitos fresquinhos! Assados ​​hoje de manhã na Cookie Cottage!"

# game/chapters/chapter5/script/ch5sc12.rpy:816
translate brazil ch5sc12_7322f590:

#   wo "Hi, you two! Fancy a cookie? Maybe one for your lady as well?"
    wo "Olá, vocês dois! Que tal um biscoito? Talvez um para a sua namorada também?"

# game/chapters/chapter5/script/ch5sc12.rpy:818
translate brazil ch5sc12_afca51aa:

#   am "*Gasps* {b}OH?{/b} W-We’re no-"
    am "*Suspiros* {b} OH?{/b} N-Não somos-"

# game/chapters/chapter5/script/ch5sc12.rpy:823
translate brazil ch5sc12_0276ea08:

#   mc "My wife would love to try a cookie, wouldn’t you honey?"
    mc "Minha esposa adoraria experimentar um biscoito, e você, querida?"

# game/chapters/chapter5/script/ch5sc12.rpy:825
translate brazil ch5sc12_7f52eeec:

#   am "{b}!?!?!?!{/b}"
    am "{b}!?!?!?!{/b}"

# game/chapters/chapter5/script/ch5sc12.rpy:827
translate brazil ch5sc12_72568422:

#   amt "{i}W-Wife?! ... Honey!? ...{/i}"
    amt "{i}C-Esposa?! ... Querida!? ...{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:829
translate brazil ch5sc12_679dce40:

#   amt "..."
    amt "..."

# game/chapters/chapter5/script/ch5sc12.rpy:831
translate brazil ch5sc12_17481843:

#   am "Y-Yes! We... we would like a cookie, please!"
    am "S-Sim! Nós... nós gostaríamos de um biscoito, por favor!"

# game/chapters/chapter5/script/ch5sc12.rpy:833
translate brazil ch5sc12_3ccb3ad5:

#   am "My-My dear husband has the biggest sweet tooth. You wouldn’t believe it!"
    am "Meu querido marido é um verdadeiro formiguinha. Você não acreditaria!"

# game/chapters/chapter5/script/ch5sc12.rpy:835
translate brazil ch5sc12_e87e3ede:

#   mc "I’m afraid she’s telling the truth."
    mc "Tenho receio de que ela esteja dizendo a verdade."

# game/chapters/chapter5/script/ch5sc12.rpy:836
translate brazil ch5sc12_08a7cfa7:

#   mc "I just can’t stay away from sweet things..."
    mc "Eu simplesmente não consigo ficar longe de doces..."

# game/chapters/chapter5/script/ch5sc12.rpy:838
translate brazil ch5sc12_726d5622:

#   am "*Muffled squeal* {size=-10}{b}Mnnffhh!!{/b}{/size}"
    am "*Grito abafado* {size=-10}{b}Mnnffhh!!{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:840
translate brazil ch5sc12_4db7c935:

#   am "*Whispers* {size=-10}{b}You’re so dead! I’m so getting you back for this...{/b}{/size}"
    am "*Sussurros* {size=-10}{b}Você está morto! Vou me vingar disso...{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:841
translate brazil ch5sc12_c87c6923:

#   mc "*Chuckles* That’s what you get for teasing me earlier, you little squirrel."
    mc "*Risos* Bem feito para você por ter me provocado antes, seu esquilinho."

# game/chapters/chapter5/script/ch5sc12.rpy:843
translate brazil ch5sc12_3bd83150:

#   am "W-Why are you doing it again?!"
    am "P-Por que você está fazendo isso de novo?!"

# game/chapters/chapter5/script/ch5sc12.rpy:844
translate brazil ch5sc12_216674da:

#   mc "This one is for good measure."
    mc "Esta é só para garantir."

# game/chapters/chapter5/script/ch5sc12.rpy:848
translate brazil ch5sc12_fa8c8143:

#   "Amelia secretively enjoys your cheekiness. Her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Amelia secretamente aprecia sua ousadia. A confiança dela aumentou em {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc12.rpy:852
translate brazil ch5sc12_a1d413f5:

#   am "We’re not married... Just friends, actually."
    am "Não somos casados... Na verdade, somos apenas amigos."

# game/chapters/chapter5/script/ch5sc12.rpy:853
translate brazil ch5sc12_edb48aed:

#   wo "My mistake. You do look cute together, though! Do you want to try a homemade cookie?"
    wo "Foi mal. Mas vocês ficam muito fofos juntos! Quer experimentar um biscoito caseiro?"

# game/chapters/chapter5/script/ch5sc12.rpy:857
translate brazil ch5sc12_f0f60aea:

#   wo "The Cookie Cottage is known all over Luxenford for their wide variety of delicious cookies."
    wo "A Cookie Cottage é conhecida em toda Luxenford pela sua grande variedade de biscoitos deliciosos."

# game/chapters/chapter5/script/ch5sc12.rpy:858
translate brazil ch5sc12_8e04a4a7:

#   wo "So, you two... what’ll it be? Can I tempt you with anything?"
    wo "Então, vocês dois... o que vão querer? Posso tentar vocês com alguma coisa?"

# game/chapters/chapter5/script/ch5sc12.rpy:860
translate brazil ch5sc12_43d98fc8:

#   mc "Well, they do look delicious. My mother actually used to make cookies for me when I was little."
    mc "Nossa, eles parecem deliciosos. Minha mãe costumava fazer biscoitos para mim quando eu era pequena."

# game/chapters/chapter5/script/ch5sc12.rpy:862
translate brazil ch5sc12_64c26045:

#   mc "What do you think, Amelia?"
    mc "O que você acha, Amelia?"

# game/chapters/chapter5/script/ch5sc12.rpy:866
translate brazil ch5sc12_a072a5bd:

#   am "They look so yummy... but I already ate way too much. I really shouldn’t."
    am "Parecem tão deliciosos... mas eu já comi demais. Não devia mesmo."

# game/chapters/chapter5/script/ch5sc12.rpy:868
translate brazil ch5sc12_c91590b9:

#   mc "Mnh, you did just chow down a whole bunch of baked goods a moment ago..."
    mc "Hum, você acabou de devorar um monte de doces..."

# game/chapters/chapter5/script/ch5sc12.rpy:870
translate brazil ch5sc12_7d8fd0b1:

#   am "The chocolate ones... look delicious."
    am "Os de chocolate... parecem deliciosos."

# game/chapters/chapter5/script/ch5sc12.rpy:871
translate brazil ch5sc12_875aeba0:

#   mct "{i}She’s practically salivating.{/i}"
    mct "{i}Ela está praticamente salivando.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:873
translate brazil ch5sc12_21ee8d57:

#   am "*Quietly* {size=-10}{b}[mc], I'd like one of the chocolate-infused ones.{/b}{/size}"
    am "*Em silêncio* {size=-10}{b}[mc]Eu gostaria de um daqueles com infusão de chocolate.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:874
translate brazil ch5sc12_560cdfd6:

#   am "*Quietly* {size=-10}{b}Please.{/b}{/size}"
    am "*Em silêncio* {size=-10}{b}Por favor.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:876
translate brazil ch5sc12_98c6b9a3:

#   mc "We’ll take one of the chocolate-infused cookies, please."
    mc "Vamos querer um dos biscoitos com chocolate, por favor."

# game/chapters/chapter5/script/ch5sc12.rpy:878
translate brazil ch5sc12_d5869e20:

#   wo "Coming right up. You’ll love it."
    wo "Já vem aí. Você vai adorar."

# game/chapters/chapter5/script/ch5sc12.rpy:879
translate brazil ch5sc12_0df14747:

#   wo "The chocolate practically melts inside your mouth as soon as you bite down."
    wo "O chocolate praticamente derrete na boca assim que você morde."

# game/chapters/chapter5/script/ch5sc12.rpy:881
translate brazil ch5sc12_bcf9cb2e:

#   am "Mmmgnh-Nnghh! Yummm!"
    am "Mmmgnh-Nnghh! Que delícia!"

# game/chapters/chapter5/script/ch5sc12.rpy:882
translate brazil ch5sc12_401887bd:

#   wo "If you'd like, we have a special variant today. We're trying out a new glazing recipe."
    wo "Se você quiser, temos uma variante especial hoje. Estamos testando uma nova receita de glacê."

# game/chapters/chapter5/script/ch5sc12.rpy:884
translate brazil ch5sc12_8762669a:

#   wo "It'll be on the house, of course."
    wo "Será por conta da casa, claro."

# game/chapters/chapter5/script/ch5sc12.rpy:885
translate brazil ch5sc12_34895cfc:

#   am "N-New glazing? I... I really shouldn't."
    am "Novos vidros? Eu... eu realmente não deveria."

# game/chapters/chapter5/script/ch5sc12.rpy:887
translate brazil ch5sc12_76ceb660:

#   mc "We'd be happy to try it. One please."
    mc "Teríamos o maior prazer em experimentar. Um, por favor."

# game/chapters/chapter5/script/ch5sc12.rpy:889
translate brazil ch5sc12_4f021945:

#   wo "Coming right up. You’ll going to love it. The glazing is made with homemade strawberry cream and raspberry paste!"
    wo "Já está a caminho. Você vai adorar. A cobertura é feita com creme de morango caseiro e pasta de framboesa!"

# game/chapters/chapter5/script/ch5sc12.rpy:891
translate brazil ch5sc12_887745ea:

#   am "I love strawberries... and raspberries."
    am "Adoro morangos... e framboesas."

# game/chapters/chapter5/script/ch5sc12.rpy:892
translate brazil ch5sc12_7569034b:

#   wo "Here you go!"
    wo "Aqui você vai!"

# game/chapters/chapter5/script/ch5sc12.rpy:894
translate brazil ch5sc12_19d4d527:

#   am "MmMmm! Soh-Gooohhd!"
    am "Hummm! Tão bom!"

# game/chapters/chapter5/script/ch5sc12.rpy:902
translate brazil ch5sc12_8f9b9cf5:

#   am "Thank you, [mc]. I think I overdid it, though."
    am "Obrigado, [mc] Acho que exagerei um pouco."

# game/chapters/chapter5/script/ch5sc12.rpy:903
translate brazil ch5sc12_8983f226:

#   mc "*Chuckles* Just slightly. Maybe next time you’ll eat a proper breakfast?"
    mc "*Risos* Só um pouquinho. Talvez da próxima vez você tome um café da manhã decente?"

# game/chapters/chapter5/script/ch5sc12.rpy:904
translate brazil ch5sc12_5844dee3:

#   am "Y-Yeah..."
    am "S-Sim..."

# game/chapters/chapter5/script/ch5sc12.rpy:906
translate brazil ch5sc12_6368842c:

#   mct "{i}Mnh... That woman seemed awfully familiar. Hmh, probably just a chance resemblance.{/i}"
    mct "{i}Hum... Aquela mulher me pareceu muito familiar. Hmh, provavelmente só uma semelhança passageira.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:908
translate brazil ch5sc12_b51ea280:

#   sa "Thank goodness he didn’t recognize me! That would’ve been so embarrassing..."
    sa "Ainda bem que ele não me reconheceu! Teria sido muito constrangedor..."

# game/chapters/chapter5/script/ch5sc12.rpy:909
translate brazil ch5sc12_429e49ae:

#   sa "I wonder how he’s doing? We haven’t even talked since we arrived in Luxenford."
    sa "Gostaria de saber como ele está. Nem sequer conversamos desde que chegamos a Luxemburgo."

# game/chapters/chapter5/script/ch5sc12.rpy:911
translate brazil ch5sc12_d28f60bf:

#   sa "I can’t keep this from them forever, but I can't bring myself to admit the truth. That I failed my Tailoring lessons so miserably..."
    sa "Não posso esconder isso deles para sempre, mas não consigo me obrigar a admitir a verdade. Que eu fracassei miseravelmente nas minhas aulas de costura..."

# game/chapters/chapter5/script/ch5sc12.rpy:912
translate brazil ch5sc12_22272312:

#   sa "And now I’m reduced to selling baked goods on the street? Ugh. Even Flynn made it into a guild..."
    sa "E agora me vejo obrigado a vender bolos na rua? Que droga. Até o Flynn conseguiu entrar para uma guilda..."

# game/chapters/chapter5/script/ch5sc12.rpy:954
translate brazil ch5sc12_80739a71:

#   am "*Exhales deeply* I’m about to collapse. Haaaahnhhh..."
    am "*Exala profundamente* Estou quase desmaiando. Haaaahnhhh..."

# game/chapters/chapter5/script/ch5sc12.rpy:955
translate brazil ch5sc12_f0ac0235:

#   mc "*Chuckles* Is Her Royal Highness tired of adventuring already?"
    mc "*Risos* Será que Sua Alteza Real já se cansou de aventuras?"

# game/chapters/chapter5/script/ch5sc12.rpy:957
translate brazil ch5sc12_954a40f3:

#   am "Keep it up, handsom... buddy. We can switch your room to a cell in the dungeons, if you prefer?"
    am "Continue assim, bonitão... amigo. Podemos trocar seu quarto por uma cela nas masmorras, se preferir."

# game/chapters/chapter5/script/ch5sc12.rpy:958
translate brazil ch5sc12_a3fb2d64:

#   mc "I thought I was off your dungeon list?"
    mc "Pensei que eu estivesse fora da sua lista de masmorras?"

# game/chapters/chapter5/script/ch5sc12.rpy:959
translate brazil ch5sc12_5648f936:

#   am "You are... for now."
    am "Você é... por enquanto."

# game/chapters/chapter5/script/ch5sc12.rpy:963
translate brazil ch5sc12_590c7dee:

#   mc "So, what did you enjoy the most about our day out adventuring?"
    mc "Então, do que você mais gostou no nosso dia de aventura?"

# game/chapters/chapter5/script/ch5sc12.rpy:964
translate brazil ch5sc12_eb9c996c:

#   mc "I’m guessing the food?"
    mc "Imagino que seja a comida?"

# game/chapters/chapter5/script/ch5sc12.rpy:966
translate brazil ch5sc12_4b52dffa:

#   am "The food was delicious, but that wasn’t what I enjoyed the most."
    am "A comida estava deliciosa, mas não foi isso que mais me agradou."

# game/chapters/chapter5/script/ch5sc12.rpy:968
translate brazil ch5sc12_5bf51c96:

#   mc "Oh? Are you sure?"
    mc "Ah? Tem certeza?"

# game/chapters/chapter5/script/ch5sc12.rpy:969
translate brazil ch5sc12_167421e0:

#   mc "You looked to be on cloud nine when you ate those cookies."
    mc "Você parecia estar nas nuvens quando comeu aqueles biscoitos."

# game/chapters/chapter5/script/ch5sc12.rpy:971
translate brazil ch5sc12_6b8012ad:

#   am "I’m sure."
    am "Tenho certeza."

# game/chapters/chapter5/script/ch5sc12.rpy:973
translate brazil ch5sc12_7894d287:

#   am "Sitting down with you, just the two of us..."
    am "Sentando-nos com você, só nós dois..."

# game/chapters/chapter5/script/ch5sc12.rpy:974
translate brazil ch5sc12_d7684166:

#   am "That was the most enjoyable part of the day for me."
    am "Essa foi a parte mais agradável do dia para mim."

# game/chapters/chapter5/script/ch5sc12.rpy:976
translate brazil ch5sc12_4d8aa118:

#   am "Having someone I could share such a moment with... I’ve always wanted that."
    am "Ter alguém com quem eu pudesse compartilhar um momento assim... Sempre quis isso."

# game/chapters/chapter5/script/ch5sc12.rpy:977
translate brazil ch5sc12_a1966ebd:

#   am "It means a lot to me that you and I have become friends."
    am "Significa muito para mim que você e eu tenhamos nos tornado amigos."

# game/chapters/chapter5/script/ch5sc12.rpy:979
translate brazil ch5sc12_c4e903e3:

#   mc "Me too, Amelia."
    mc "Eu também, Amelia."

# game/chapters/chapter5/script/ch5sc12.rpy:980
translate brazil ch5sc12_96929071:

#   mc "I’m glad we made it past the point of you glaring daggers at me."
    mc "Que bom que conseguimos superar a fase em que você me lançava olhares fulminantes."

# game/chapters/chapter5/script/ch5sc12.rpy:982
translate brazil ch5sc12_64a7f87b:

#   am "Yeah... somehow you weaseled your way past my defenses."
    am "É... de alguma forma você conseguiu burlar minhas defesas."

# game/chapters/chapter5/script/ch5sc12.rpy:984
translate brazil ch5sc12_a211fac1:

#   am "Hey... [mc]?"
    am "Ei... [mc]?"

# game/chapters/chapter5/script/ch5sc12.rpy:986
translate brazil ch5sc12_9a9d1c6c:

#   am "I’m really happy you took me out today."
    am "Fiquei muito feliz por você ter me levado para sair hoje."

# game/chapters/chapter5/script/ch5sc12.rpy:987
translate brazil ch5sc12_a13c2c4e:

#   am "I hope you enjoyed it as well..."
    am "Espero que você também tenha gostado..."

# game/chapters/chapter5/script/ch5sc12.rpy:994
translate brazil ch5sc12_092dcf52:

#   mc "To my surprise, I enjoyed spending the day with you too."
    mc "Para minha surpresa, também gostei de passar o dia com você."

# game/chapters/chapter5/script/ch5sc12.rpy:996
translate brazil ch5sc12_f92c473a:

#   am "I have no notion of what you could be insinuating. I’m always pleasant company."
    am "Não faço a mínima ideia do que você possa estar insinuando. Sou sempre uma companhia agradável."

# game/chapters/chapter5/script/ch5sc12.rpy:997
translate brazil ch5sc12_4b7c50a7:

#   mc "You sure are."
    mc "Com certeza."

# game/chapters/chapter5/script/ch5sc12.rpy:998
translate brazil ch5sc12_84955d63:

#   am "*Tight squeeze* Right?!"
    am "*Apertado* Não é?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1001
translate brazil ch5sc12_3fa2b640:

#   mc "R-Right... *Chuckles*"
    mc "Certo... *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:1003
translate brazil ch5sc12_24e700b3:

#   am "My feet feel totally and utterly squashed after today."
    am "Meus pés estão completamente esmagados depois de hoje."

# game/chapters/chapter5/script/ch5sc12.rpy:1004
translate brazil ch5sc12_7904a6c3:

#   am "I think I’m going to head back home."
    am "Acho que vou voltar para casa."

# game/chapters/chapter5/script/ch5sc12.rpy:1006
translate brazil ch5sc12_5151f27a:

#   mc "Okay, I'll escort you."
    mc "Certo, eu te acompanho."

# game/chapters/chapter5/script/ch5sc12.rpy:1008
translate brazil ch5sc12_87ea561c:

#   am "I’ll be fine... We’re only a couple of streets away from Valois Palace."
    am "Eu ficarei bem... Estamos a apenas algumas ruas do Palácio Valois."

# game/chapters/chapter5/script/ch5sc12.rpy:1009
translate brazil ch5sc12_7875b4cf:

#   am "Besides, I want to stop by Meredith's shop on the way."
    am "Além disso, quero dar uma passada na loja da Meredith no caminho."

# game/chapters/chapter5/script/ch5sc12.rpy:1011
translate brazil ch5sc12_56a6f600:

#   mc "Running low on perfumes already?"
    mc "Já está ficando sem perfumes?"

# game/chapters/chapter5/script/ch5sc12.rpy:1013
translate brazil ch5sc12_e4d15d8c:

#   am "*Giggles softly* Not quite... but a princess can never have too many!"
    am "*Risinhos suaves* Quase... mas uma princesa nunca tem demais!"

# game/chapters/chapter5/script/ch5sc12.rpy:1018
translate brazil ch5sc12_c468c49e:

#   mc "Sorry, but your perfumes will have to wait for another outing."
    mc "Desculpe, mas seus perfumes terão que esperar por outra ocasião."

# game/chapters/chapter5/script/ch5sc12.rpy:1019
translate brazil ch5sc12_08da1809:

#   mc "What we're doing is already irresponsible, I'm not letting you go off on your own here in the city."
    mc "O que estamos fazendo já é irresponsável, não vou deixar você sair sozinho aqui na cidade."

# game/chapters/chapter5/script/ch5sc12.rpy:1021
translate brazil ch5sc12_20fa239d:

#   am "*Sighs* You sound like my parents..."
    am "*Suspiro* Você soa como meus pais..."

# game/chapters/chapter5/script/ch5sc12.rpy:1022
translate brazil ch5sc12_d37085ba:

#   am "Fine. We'll do it your way."
    am "Ótimo. Faremos do seu jeito."

# game/chapters/chapter5/script/ch5sc12.rpy:1024
translate brazil ch5sc12_99df10f0:

#   am "There's an entrance to one of the palace's tunnels nearby, you can escort me there."
    am "Há uma entrada para um dos túneis do palácio aqui perto; você pode me acompanhar até lá."

# game/chapters/chapter5/script/ch5sc12.rpy:1026
translate brazil ch5sc12_ca665172:

#   mc "Sounds good, lead the way."
    mc "Ótimo, vamos lá."

# game/chapters/chapter5/script/ch5sc12.rpy:1028
translate brazil ch5sc12_ae817f01:

#   am "You know... I had a great time today."
    am "Sabe... eu me diverti muito hoje."

# game/chapters/chapter5/script/ch5sc12.rpy:1029
translate brazil ch5sc12_40eec9ac:

#   am "We should totally do this again."
    am "Com certeza deveríamos fazer isso de novo."

# game/chapters/chapter5/script/ch5sc12.rpy:1031
translate brazil ch5sc12_237eb0b2:

#   mc "I could be convinced... you're not the worst company in the world."
    mc "Eu poderia ser convencido... vocês não são a pior empresa do mundo."

# game/chapters/chapter5/script/ch5sc12.rpy:1033
translate brazil ch5sc12_e726c56b:

#   am "Good to know you enjoyed our little outing as well."
    am "Que bom saber que você também gostou do nosso pequeno passeio."

# game/chapters/chapter5/script/ch5sc12.rpy:1034
translate brazil ch5sc12_a236a885:

#   mc "Maybe next time we can do an official outing, so we don't have to trek through those dusty tunnels."
    mc "Talvez da próxima vez possamos fazer um passeio oficial, assim não precisamos atravessar aqueles túneis empoeirados."

# game/chapters/chapter5/script/ch5sc12.rpy:1036
translate brazil ch5sc12_78e958b0:

#   am "Is the big bad adventurer afraid of a little dust? *Snickers*"
    am "Será que o grande e mau aventureiro tem medo de um pouco de poeira? *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:1037
translate brazil ch5sc12_b9017da4:

#   am "Who would've thought!"
    am "Quem diria!"

# game/chapters/chapter5/script/ch5sc12.rpy:1039
translate brazil ch5sc12_f3326498:

#   mc "Nice try, but you'll have to do better if you want to goad me."
    mc "Boa tentativa, mas você vai ter que se esforçar mais se quiser me provocar."

# game/chapters/chapter5/script/ch5sc12.rpy:1040
translate brazil ch5sc12_f762d418:

#   am "Duly noted."
    am "Anotado."

# game/chapters/chapter5/script/ch5sc12.rpy:1041
translate brazil ch5sc12_38533e1e:

#   am "C'mon, the entrance is around this corner."
    am "Vamos lá, a entrada é logo ali na esquina."

# game/chapters/chapter5/script/ch5sc12.rpy:1043
translate brazil ch5sc12_7c97f0c0:

#   am "Here it is, give me a hand with the pothole."
    am "Aqui está, me dê uma mão com o buraco."

# game/chapters/chapter5/script/ch5sc12.rpy:1044
translate brazil ch5sc12_606e2d02:

#   mc "Sure."
    mc "Claro."

# game/chapters/chapter5/script/ch5sc12.rpy:1046
translate brazil ch5sc12_2c9824ff:

#   am "This is as far as you go."
    am "Você não pode ir até aqui."

# game/chapters/chapter5/script/ch5sc12.rpy:1047
translate brazil ch5sc12_9b471d34:

#   am "I know these tunnels well as you know and we're not risking being caught with you smuggling me into the palace."
    am "Conheço bem esses túneis, assim como você, e não vamos arriscar ser pegos enquanto você me leva escondido para o palácio."

# game/chapters/chapter5/script/ch5sc12.rpy:1049
translate brazil ch5sc12_89342410:

#   mc "Amelia, just let me get you into the castle-"
    mc "Amélia, deixe-me levá-la até o castelo..."

# game/chapters/chapter5/script/ch5sc12.rpy:1051
translate brazil ch5sc12_413bfe1b:

#   am "Ah-Ah. Don't argue with me."
    am "Ah-ah. Não discuta comigo."

# game/chapters/chapter5/script/ch5sc12.rpy:1052
translate brazil ch5sc12_ff6ea793:

#   am "I appreciate you going this far for me, but I will not have you getting in trouble over this."
    am "Agradeço por você ter se esforçado tanto por mim, mas não vou permitir que você se meta em problemas por causa disso."

# game/chapters/chapter5/script/ch5sc12.rpy:1054
translate brazil ch5sc12_ec725259:

#   am "If they found out we've been out today, they would blame you and another outing like this..."
    am "Se eles descobrissem que saímos hoje, a culpa seria sua e de mais um passeio como esse..."

# game/chapters/chapter5/script/ch5sc12.rpy:1055
translate brazil ch5sc12_d1203b7f:

#   am "Well let's just say it wouldn't become a reality."
    am "Bem, digamos que isso não se tornaria realidade."

# game/chapters/chapter5/script/ch5sc12.rpy:1057
translate brazil ch5sc12_a252f731:

#   am "Come by the palace soon, okay?"
    am "Apareça no palácio em breve, está bem?"

# game/chapters/chapter5/script/ch5sc12.rpy:1058
translate brazil ch5sc12_6531b6d7:

#   am "We can arrange another outing then."
    am "Podemos combinar outro passeio então."

# game/chapters/chapter5/script/ch5sc12.rpy:1060
translate brazil ch5sc12_b3350b73:

#   mc "*Sighs* Sure, but this is against my better judgement."
    mc "*Suspiro* Claro, mas isso vai contra o meu bom senso."

# game/chapters/chapter5/script/ch5sc12.rpy:1062
translate brazil ch5sc12_99f8a715:

#   am "Would you stop worrying so much? I've lived 20 years going to the city without you."
    am "Você poderia parar de se preocupar tanto? Já vivi 20 anos indo à cidade sem você."

# game/chapters/chapter5/script/ch5sc12.rpy:1063
translate brazil ch5sc12_1e4425e7:

#   am "I think I can handle a little trip through the tunnels for the hundreth time in my life."
    am "Acho que consigo lidar com uma pequena viagem pelos túneis pela centésima vez na minha vida."

# game/chapters/chapter5/script/ch5sc12.rpy:1065
translate brazil ch5sc12_cfc694d4:

#   mc "Fine, fine."
    mc "Tudo bem, tudo bem."

# game/chapters/chapter5/script/ch5sc12.rpy:1066
translate brazil ch5sc12_89de3f02:

#   mc "There is one thing I'd like to go check."
    mc "Há uma coisa que eu gostaria de ir verificar."

# game/chapters/chapter5/script/ch5sc12.rpy:1067
translate brazil ch5sc12_9829c5e9:

#   mc "That woman who sold us the cookies, I thought she looked familiar, she reminded me of my cousin."
    mc "Aquela mulher que nos vendeu os biscoitos, eu achei que ela me parecia familiar, ela me lembrou minha prima."

# game/chapters/chapter5/script/ch5sc12.rpy:1069
translate brazil ch5sc12_e08fb182:

#   am "Who? Flynn? I didn't think he would be dressed like that."
    am "Quem? Flynn? Não imaginei que ele estaria vestido assim."

# game/chapters/chapter5/script/ch5sc12.rpy:1071
translate brazil ch5sc12_d6b6bc96:

#   mc "*Chuckles* No, not Flynn. His sister, Sabrina. They came here together but I haven't seen her since then."
    mc "*Risos* Não, não é o Flynn. É a irmã dele, Sabrina. Eles vieram juntos para cá, mas não a vi desde então."

# game/chapters/chapter5/script/ch5sc12.rpy:1073
translate brazil ch5sc12_65e3b0fc:

#   am "Then you should hurry, the markets usually close down around this hour."
    am "Então você deve se apressar, os mercados costumam fechar por volta dessa hora."

# game/chapters/chapter5/script/ch5sc12.rpy:1074
translate brazil ch5sc12_ad5461a1:

#   mc "I will, thank you."
    mc "Sim, obrigada."

# game/chapters/chapter5/script/ch5sc12.rpy:1076
translate brazil ch5sc12_72cddba4:

#   am "R-Remember... to come by and see me one of these days?"
    am "R-Lembre-se... de vir me visitar um dia desses?"

# game/chapters/chapter5/script/ch5sc12.rpy:1078
translate brazil ch5sc12_2463d5cb:

#   mc "*Chuckles* Who's worrying now?"
    mc "*Risos* Quem está preocupado agora?"

# game/chapters/chapter5/script/ch5sc12.rpy:1079
translate brazil ch5sc12_2293da8b:

#   mc "Don't worry, I'll be around, you can just send for me at the guild if need be."
    mc "Não se preocupe, estarei por perto. Se precisar, pode me chamar na guilda."

# game/chapters/chapter5/script/ch5sc12.rpy:1081
translate brazil ch5sc12_94fb240e:

#   am "Great! I might just do that."
    am "Ótimo! Talvez eu faça isso mesmo."

# game/chapters/chapter5/script/ch5sc12.rpy:1082
translate brazil ch5sc12_b182e7da:

#   am "Say hi to your guildies from me, and tell them I look forward to meeting them!"
    am "Mande um abraço para os seus colegas de guilda em meu nome e diga a eles que estou ansioso para conhecê-los!"

# game/chapters/chapter5/script/ch5sc12.rpy:1084
translate brazil ch5sc12_dac16979:

#   mc "I will."
    mc "Eu vou."

# game/chapters/chapter5/script/ch5sc12.rpy:1085
translate brazil ch5sc12_309241c7:

#   mc "Don’t take too long getting back. Your parents may just sentence me to the gallows."
    mc "Não demore muito para voltar. Seus pais podem me mandar para a forca."

# game/chapters/chapter5/script/ch5sc12.rpy:1086
translate brazil ch5sc12_ee02820d:

#   mct "Not that it would have any effect on me, but it would be bothersome..."
    mct "Não que isso me afetasse de alguma forma, mas seria incômodo..."

# game/chapters/chapter5/script/ch5sc12.rpy:1088
translate brazil ch5sc12_2ada32e3:

#   am "As if I’d let them... Byee!"
    am "Como se eu fosse deixar... Tchau!"

# game/chapters/chapter5/script/ch5sc12.rpy:1092
translate brazil ch5sc12_5dbb16c2:

#   mct "Damn... looks like she has packed up for the day."
    mct "Puxa... parece que ela já encerrou as atividades por hoje."

# game/chapters/chapter5/script/ch5sc12.rpy:1093
translate brazil ch5sc12_663273fc:

#   mct "But if it was Sabrina, why didn't she say anything?"
    mct "Mas se era a Sabrina, por que ela não disse nada?"

# game/chapters/chapter5/script/ch5sc12.rpy:1094
translate brazil ch5sc12_8b08f6cf:

#   mct "Maybe she didn't recognize me as well? Certainly plausible given how little we've seen each other."
    mct "Talvez ela também não tenha me reconhecido? Certamente é plausível, considerando o pouco tempo que nos vimos."

# game/chapters/chapter5/script/ch5sc12.rpy:1095
translate brazil ch5sc12_3cf622c3:

#   mct "*Sighs* I suppose I'll stop by the Drunken Rooster on the way to the guild, I could use an ale after today's outing."
    mct "*Suspiro* Acho que vou dar uma passada no Galo Bêbado a caminho da guilda, uma cerveja me cairia bem depois do passeio de hoje."

# game/chapters/chapter5/script/ch5sc12.rpy:1104
translate brazil ch5sc12_7d52a8c0:

#   am "Phew... that section of the tunnels were longer than I remembered."
    am "Ufa... aquele trecho dos túneis era mais longo do que eu me lembrava."

# game/chapters/chapter5/script/ch5sc12.rpy:1105
translate brazil ch5sc12_a3b4d7a9:

#   am "I better change my clothes and check in with mother and father, to avoid suspicion."
    am "É melhor eu trocar de roupa e falar com a mãe e o pai, para evitar suspeitas."

# game/chapters/chapter5/script/ch5sc12.rpy:1107
translate brazil ch5sc12_7f47eac5:

#   ta "Right you are, little princess."
    ta "Você tem toda razão, princesinha."

# game/chapters/chapter5/script/ch5sc12.rpy:1108
translate brazil ch5sc12_7d1d4e7a:

#   ta "We wouldn't want your parents to be suspicious."
    ta "Não queremos que seus pais fiquem desconfiados."

# game/chapters/chapter5/script/ch5sc12.rpy:1110
translate brazil ch5sc12_e1761f01:

#   am "*Gasps* W-What are you! H-Hey! {b}STOP!{/b}"
    am "*Arfa* O-O que você é?! E-Ei! {b} PARAR!{/b}"

# game/chapters/chapter5/script/ch5sc12.rpy:1112
translate brazil ch5sc12_b32e0924:

#   ta "You're coming with me!"
    ta "Você vem comigo!"

# game/chapters/chapter5/script/ch5sc12.rpy:1118
translate brazil ch5sc12_d5716ded:

#   mc "Well if you're certain you can make it back on your own, there is one thing I'd like to go check."
    mc "Bem, se você tem certeza de que consegue voltar sozinho, há uma coisa que eu gostaria de verificar."

# game/chapters/chapter5/script/ch5sc12.rpy:1128
translate brazil ch5sc12_222afd8e:

#   am "[mc]? ... When... when will I see you again?"
    am "[mc]...Quando...quando te verei novamente?"

# game/chapters/chapter5/script/ch5sc12.rpy:1130
translate brazil ch5sc12_b41eda02:

#   mc "I don’t think there are any more events coming up. But you can always send for me whenever you need me."
    mc "Não creio que haja mais eventos programados. Mas você sempre pode me chamar quando precisar."

# game/chapters/chapter5/script/ch5sc12.rpy:1132
translate brazil ch5sc12_87a3a6f7:

#   am "O-Okay. I will!"
    am "Ok. Eu vou!"

# game/chapters/chapter5/script/ch5sc12.rpy:1135
translate brazil ch5sc12_3986f086:

#   mc "I will. Don’t take too long getting back. Your parents may just sentence me to the gallows."
    mc "Sim, eu vou. Não demore muito para voltar. Seus pais podem me mandar para a forca."

# game/chapters/chapter5/script/ch5sc12.rpy:1137
translate brazil ch5sc12_861122f9:

#   am "As if I’d let them! *Giggles* Byee!"
    am "Como se eu fosse deixar! *Risos* Tchau!"

# game/chapters/chapter5/script/ch5sc12.rpy:1151
translate brazil ch5sc12_2e37056c:

#   my "Shane? There you are..."
    my "Shane? Aí está você..."

# game/chapters/chapter5/script/ch5sc12.rpy:1152
translate brazil ch5sc12_1e7cfc4f:

#   sh "Hmm? What is it now?"
    sh "Hum? O que é agora?"

# game/chapters/chapter5/script/ch5sc12.rpy:1155
translate brazil ch5sc12_ecc831e5:

#   my "Didn't you hear me call upon you? Dinner's getting cold."
    my "Você não me ouviu te chamar? O jantar está esfriando."

# game/chapters/chapter5/script/ch5sc12.rpy:1156
translate brazil ch5sc12_ebe07530:

#   sh "As you can see, I'm clearly busy. Just eat without me."
    sh "Como você pode ver, estou claramente ocupado. Coma sem mim."

# game/chapters/chapter5/script/ch5sc12.rpy:1157
translate brazil ch5sc12_c9008509:

#   my "Shane, I just spent an hour in the kitchen, cooking a meal for us... the least you can do is come join."
    my "Shane, acabei de passar uma hora na cozinha preparando uma refeição para nós... o mínimo que você pode fazer é vir se juntar a nós."

# game/chapters/chapter5/script/ch5sc12.rpy:1160
translate brazil ch5sc12_e73ad7e4:

#   sh "Damnit Maya! You're a woman, stop acting like cooking dinner is a huge deal, that is your responsibility!"
    sh "Puxa, Maya! Você é mulher, pare de agir como se cozinhar o jantar fosse um grande problema, essa é a sua responsabilidade!"

# game/chapters/chapter5/script/ch5sc12.rpy:1161
translate brazil ch5sc12_f04a2804:

#   sh "I'll eat when I feel like it, now stop bothering me!"
    sh "Vou comer quando tiver vontade, agora pare de me incomodar!"

# game/chapters/chapter5/script/ch5sc12.rpy:1162
translate brazil ch5sc12_fc645303:

#   my "..."
    my "..."

# game/chapters/chapter5/script/ch5sc12.rpy:1165
translate brazil ch5sc12_5fa37052:

#   my "You never participate in our family, when's the last time you've spent time with Flynn or Sabrina?"
    my "Você nunca participa da nossa família, quando foi a última vez que você passou um tempo com Flynn ou Sabrina?"

# game/chapters/chapter5/script/ch5sc12.rpy:1166
translate brazil ch5sc12_d9c88548:

#   my "You couldn't bother with them before they moved away and now you don't even write them either!"
    my "Você não se importava com eles antes de se mudarem e agora nem sequer escreve para eles!"

# game/chapters/chapter5/script/ch5sc12.rpy:1169
translate brazil ch5sc12_c640af29:

#   sh "Don't push me, Maya. Just leave me alone for hells sake woman."
    sh "Não me provoque, Maya. Pelo amor de Deus, me deixe em paz!"

# game/chapters/chapter5/script/ch5sc12.rpy:1172
translate brazil ch5sc12_ad791d92:

#   my "I'm not pushing you Shane, I'm trying to talk some sense into you, trying to get you to take care of your family."
    my "Não estou te pressionando, Shane, estou tentando te fazer enxergar a realidade, tentando te convencer a cuidar da sua família."

# game/chapters/chapter5/script/ch5sc12.rpy:1173
translate brazil ch5sc12_65356bc8:

#   my "You keep chasing wenches at the tavern and drinking yourself into the bottom of every mug of ale you come across!"
    my "Você fica correndo atrás de moças na taverna e se embebedando até o fundo de cada caneca de cerveja que encontra!"

# game/chapters/chapter5/script/ch5sc12.rpy:1176
translate brazil ch5sc12_25bfdf4d:

#   my "How about you man up and provide for your family! Why do you think Flynn or Sabrina haven't come to visit us?!"
    my "Que tal você tomar uma atitude e sustentar sua família? Por que você acha que Flynn ou Sabrina ainda não vieram nos visitar?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1177
translate brazil ch5sc12_85d843ee:

#   my "Because of {b}YOU!{/b} You're the reason our kids fled to Luxenford, they couldn't stand seeing their disgrace of a father!"
    my "Por causa de {b} VOCÊ!{/b} Você é o motivo pelo qual nossos filhos fugiram para Luxemburgo, eles não suportavam ver aquele pai desprezível!"

# game/chapters/chapter5/script/ch5sc12.rpy:1180
translate brazil ch5sc12_ca46b9bd:

#   sh "Are you daft woman!? I've never struck you, but maybe that's what led our marriage astray, me putting up with your shit!"
    sh "Você é uma mulher louca?! Eu nunca te bati, mas talvez tenha sido isso que levou nosso casamento ao fracasso, eu aguentando suas besteiras!"

# game/chapters/chapter5/script/ch5sc12.rpy:1181
translate brazil ch5sc12_13f3e20f:

#   my "Whatever... I'm going to go have dinner, you can do whatever you want!"
    my "Tanto faz... Vou jantar, você pode fazer o que quiser!"

# game/chapters/chapter5/script/ch5sc12.rpy:1182
translate brazil ch5sc12_9ebb3d2e:

#   sh "Good! Get out of my sight! I can't believe I agreed to marry a woman like you!"
    sh "Ótimo! Saia da minha frente! Não acredito que concordei em me casar com uma mulher como você!"

# game/chapters/chapter5/script/ch5sc12.rpy:1190
translate brazil ch5sc12_9897f44c:

#   sh "{b}*Shouts*{/b} Oh and don't wait up for me! I'm going to the tavern after I'm done here!"
    sh "{b}*Gritos*{/b} Ah, e não me esperem acordados! Vou à taverna depois que terminar aqui!"

# game/chapters/chapter5/script/ch5sc12.rpy:1191
translate brazil ch5sc12_c5dab9b0:

#   sh "I'm sure there'll be quite a few women who'll appreciate a man like me, unlike you! *Scoffs*"
    sh "Tenho certeza de que haverá muitas mulheres que apreciarão um homem como eu, ao contrário de você! *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:1194
translate brazil ch5sc12_9f4aa095:

#   sh "{b}*Shouts*{/b} It's a miracle I ever had children with a hag like you! You hear me!?"
    sh "{b}*Gritos*{/b} É um milagre eu ter tido filhos com uma bruxa como você! Está me ouvindo!?"

# game/chapters/chapter5/script/ch5sc12.rpy:1195
translate brazil ch5sc12_39ace3bf:

#   sh "You couldn't even get me hard if you tried! You're useless Maya! Useless!"
    sh "Você não conseguiria me excitar nem se tentasse! Você é inútil, Maya! Inútil!"

# game/chapters/chapter5/script/ch5sc12.rpy:1198
translate brazil ch5sc12_cac98264:

#   sh "{b}*Shouts*{/b} And your cooking sucks! Can you really blame me for not wanting to eat anything made by you?!"
    sh "{b}*Gritos*{/b} E a sua comida é horrível! Você pode mesmo me culpar por não querer comer nada feito por você?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1199
translate brazil ch5sc12_c9767964:

#   sh "Maybe I should have you be the one chopping wood, at least you'd make an actual contribution to the household then!"
    sh "Talvez eu devesse te colocar para cortar lenha, pelo menos você daria uma contribuição real para a casa!"

# game/chapters/chapter5/script/ch5sc12.rpy:1205
translate brazil ch5sc12_17743e29:

#   my "*Sobbing* ..."
    my "*Soluços* ..."

# game/chapters/chapter5/script/ch5sc12.rpy:1208
translate brazil ch5sc12_5f01307e:

#   my "*Sobs* Why? Why is he like this?!"
    my "*Soluços* Por quê? Por que ele é assim?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1211
translate brazil ch5sc12_bd328f69:

#   my "*Sobbing* He's right... I-..."
    my "*Soluços* Ele tem razão... Eu..."

# game/chapters/chapter5/script/ch5sc12.rpy:1212
translate brazil ch5sc12_5b0ee3ce:

#   my "I'm useless!"
    my "Eu sou inútil!"

# game/chapters/chapter5/script/ch5sc12.rpy:1215
translate brazil ch5sc12_c1e66e0b:

#   my "A useless wife! *Sobs* I-... I don't deserve anything..."
    my "Uma esposa inútil! *Soluços* Eu... eu não mereço nada..."

# game/chapters/chapter5/script/ch5sc12.rpy:1216
translate brazil ch5sc12_f5b5fccd:

#   my "I'm-... I'm nothing! *Sobs*"
    my "Eu... eu não sou nada! *Soluços*"

# game/chapters/chapter5/script/ch5sc12.rpy:1219
translate brazil ch5sc12_7be7fd92:

#   my "[mc]... where are you? *Sobbing*"
    my "[mc]...onde você está? *Soluços*"

# game/chapters/chapter5/script/ch5sc12.rpy:1220
translate brazil ch5sc12_cc631df6:

#   my "I-... I need you."
    my "Eu... eu preciso de você."

# game/chapters/chapter5/script/ch5sc12.rpy:1223
translate brazil ch5sc12_859ffdb3:

#   my "*Cries* I need you, I need you so much!"
    my "*Chora* Eu preciso de você, eu preciso tanto de você!"

# game/chapters/chapter5/script/ch5sc12.rpy:1239
translate brazil ch5sc12_e61d8ae6:

#   vi "I hate seeing them like this..."
    vi "Odeio vê-los assim..."

# game/chapters/chapter5/script/ch5sc12.rpy:1240
translate brazil ch5sc12_62e99fae:

#   vi "It's so... eerie."
    vi "É tão... assustador."

# game/chapters/chapter5/script/ch5sc12.rpy:1242
translate brazil ch5sc12_47d2f57d:

#   uk "It's all but temporary, as you know... sister."
    uk "É tudo temporário, como você sabe... irmã."

# game/chapters/chapter5/script/ch5sc12.rpy:1243
translate brazil ch5sc12_742515fd:

#   vi "I know..."
    vi "Eu sei..."

# game/chapters/chapter5/script/ch5sc12.rpy:1244
translate brazil ch5sc12_0a5eb37e:

#   uk "You went through this very thing yourself, did you not?"
    uk "Você passou exatamente por isso, não é?"

# game/chapters/chapter5/script/ch5sc12.rpy:1246
translate brazil ch5sc12_9cccecf5:

#   vi "Mmh, which is exactly how I know what she's enduring right now."
    vi "Hum, é exatamente assim que eu sei o que ela está passando agora."

# game/chapters/chapter5/script/ch5sc12.rpy:1247
translate brazil ch5sc12_feed639c:

#   vi "Being trapped within your own mind... it is a horrendous thing."
    vi "Ficar preso dentro da própria mente... é uma coisa horrível."

# game/chapters/chapter5/script/ch5sc12.rpy:1248
translate brazil ch5sc12_ee41e1fe:

#   vi "Will this work? I still don't fully understand it."
    vi "Isso vai funcionar? Ainda não entendi completamente."

# game/chapters/chapter5/script/ch5sc12.rpy:1250
translate brazil ch5sc12_ba7a03f7:

#   uk "With everything you've seen, experienced on your own body even, you still question our Nightmaiden?"
    uk "Com tudo o que você viu, e até mesmo experimentou em seu próprio corpo, você ainda questiona nossa Donzela da Noite?"

# game/chapters/chapter5/script/ch5sc12.rpy:1251
translate brazil ch5sc12_5b878771:

#   vi "Just answer me."
    vi "Apenas me responda."

# game/chapters/chapter5/script/ch5sc12.rpy:1252
translate brazil ch5sc12_31e73022:

#   uk "As you know, we have the initiates blessed by our Nightmaiden, without them knowing it."
    uk "Como vocês sabem, nós abençoamos os iniciados com a bênção de nossa Donzela da Noite, sem que eles saibam disso."

# game/chapters/chapter5/script/ch5sc12.rpy:1254
translate brazil ch5sc12_20c5d9d6:

#   vi "Mh, go on."
    vi "Hum, continue."

# game/chapters/chapter5/script/ch5sc12.rpy:1255
translate brazil ch5sc12_51cbd9fb:

#   uk "The blessing traps their souls within their bodies for seven days, which means if the person with the blessing dies-"
    uk "A bênção aprisiona suas almas dentro de seus corpos por sete dias, o que significa que se a pessoa que recebeu a bênção morrer-"

# game/chapters/chapter5/script/ch5sc12.rpy:1256
translate brazil ch5sc12_2ab9deec:

#   vi "Their souls remain within their bodies, without being brought to the afterlife?"
    vi "Suas almas permanecem em seus corpos, sem serem levadas para a vida após a morte?"

# game/chapters/chapter5/script/ch5sc12.rpy:1257
translate brazil ch5sc12_c9a362fa:

#   uk "Correct, it prevents rigor mortis and decay, sort of like a grace period before they truly die."
    uk "Correto, isso impede o rigor mortis e a decomposição, como uma espécie de período de graça antes da morte definitiva."

# game/chapters/chapter5/script/ch5sc12.rpy:1259
translate brazil ch5sc12_96d975b6:

#   vi "Okay, I'm with you so far, but they are still dead, how do they... you know, come back?"
    vi "Certo, até aqui estou entendendo, mas eles ainda estão mortos, como eles... você sabe, voltam?"

# game/chapters/chapter5/script/ch5sc12.rpy:1260
translate brazil ch5sc12_7563a434:

#   uk "Thanks to this Ruby, the {b}Nightshard{/b}, it contains the essence of our Nightmaiden."
    uk "Graças a este rubi, o {b} Estilhaço Noturno{/b}, contém a essência da nossa Donzela da Noite."

# game/chapters/chapter5/script/ch5sc12.rpy:1261
translate brazil ch5sc12_ba326623:

#   uk "You put the Nightshard onto the body of someone who has been bestowed her blessing, and after some time passing."
    uk "Você coloca o Fragmento da Noite no corpo de alguém que recebeu sua bênção, e depois de algum tempo."

# game/chapters/chapter5/script/ch5sc12.rpy:1262
translate brazil ch5sc12_03f3e555:

#   vi "They'll resurrect as if they'd never died."
    vi "Eles ressuscitarão como se nunca tivessem morrido."

# game/chapters/chapter5/script/ch5sc12.rpy:1264
translate brazil ch5sc12_058f4b5a:

#   vi "And it just works... every time?"
    vi "E simplesmente funciona... sempre?"

# game/chapters/chapter5/script/ch5sc12.rpy:1265
translate brazil ch5sc12_33214363:

#   uk "It worked on you, didn't it? Sister."
    uk "Funcionou com você, não funcionou? Irmã."

# game/chapters/chapter5/script/ch5sc12.rpy:1266
translate brazil ch5sc12_53b7138f:

#   vi "I would've won my initiation... if I had faced Rin like I wanted."
    vi "Eu teria vencido minha iniciação... se tivesse enfrentado Rin como eu queria."

# game/chapters/chapter5/script/ch5sc12.rpy:1267
translate brazil ch5sc12_5fb4d3a2:

#   uk "*Scoffs* No, you would not."
    uk "*Risos* Não, você não faria isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1269
translate brazil ch5sc12_41637b32:

#   vi "She's... she's healing."
    vi "Ela está... ela está se recuperando."

# game/chapters/chapter5/script/ch5sc12.rpy:1270
translate brazil ch5sc12_398d24e7:

#   vi "Incredible..."
    vi "Incrível..."

# game/chapters/chapter5/script/ch5sc12.rpy:1271
translate brazil ch5sc12_38b8057d:

#   uk "Our Nightmaiden is eternal, as is her will."
    uk "Nossa Donzela da Noite é eterna, assim como a sua vontade."

# game/chapters/chapter5/script/ch5sc12.rpy:1272
translate brazil ch5sc12_3ed15688:

#   vi "I... consider my skeptism gone."
    vi "Eu... considero que meu ceticismo desapareceu."

# game/chapters/chapter5/script/ch5sc12.rpy:1274
translate brazil ch5sc12_35e8a25c:

#   vi "How long? Before she awakens."
    vi "Quanto tempo? Antes que ela acorde."

# game/chapters/chapter5/script/ch5sc12.rpy:1275
translate brazil ch5sc12_a7b6c01e:

#   uk "Could be an hour, could be a full day, it varies from person to person."
    uk "Pode ser uma hora, pode ser um dia inteiro, varia de pessoa para pessoa."

# game/chapters/chapter5/script/ch5sc12.rpy:1276
translate brazil ch5sc12_bcf2823b:

#   uk "You should remain here with her, she'll be confused when she awakens."
    uk "Você deve ficar aqui com ela, ela ficará confusa quando acordar."

# game/chapters/chapter5/script/ch5sc12.rpy:1278
translate brazil ch5sc12_8a86f74c:

#   vi "I'll remain and watch over her."
    vi "Vou ficar e cuidar dela."

# game/chapters/chapter5/script/ch5sc12.rpy:1279
translate brazil ch5sc12_1cde3b9b:

#   vi "It should be someone she trusts who explains this whole ordeal to her."
    vi "Deveria ser alguém em quem ela confia para lhe explicar toda essa situação."

# game/chapters/chapter5/script/ch5sc12.rpy:1280
translate brazil ch5sc12_cf4b069e:

#   uk "Very well, I leave her in your care then, sister."
    uk "Muito bem, então a deixo aos seus cuidados, irmã."

# game/chapters/chapter5/script/ch5sc12.rpy:1282
translate brazil ch5sc12_e1a6be68:

#   vi "Sister... rest, you've shown your worth, and will be one of us when you awaken."
    vi "Irmã... descanse, você já mostrou o seu valor e será uma de nós quando despertar."

# game/chapters/chapter5/script/ch5sc12.rpy:1283
translate brazil ch5sc12_820d0736:

#   vi "Irene is in for one hell of a surprise, but she'll have to wait..."
    vi "Irene terá uma baita surpresa, mas terá que esperar..."

# game/chapters/chapter5/script/ch5sc12.rpy:1284
translate brazil ch5sc12_b84db9ab:

#   vi "First she needs to come to terms with your death, she needs to steel her nerves, otherwise she'll never make it."
    vi "Primeiro ela precisa aceitar a sua morte, precisa se fortalecer, senão não vai conseguir."

# game/chapters/chapter5/script/ch5sc12.rpy:1289
translate brazil ch5sc12_c8b911f9:

#   "Two hours later..."
    "Duas horas depois..."

# game/chapters/chapter5/script/ch5sc12.rpy:1293
translate brazil ch5sc12_aebd508e:

#   vi "Rest... sister. Rest as long as you need."
    vi "Descanse... irmã. Descanse o tempo que precisar."

# game/chapters/chapter5/script/ch5sc12.rpy:1295
translate brazil ch5sc12_6ffda3a6:

#   vi "I better fetch some water, I remember when I first woke up after... being brought back."
    vi "É melhor eu pegar um pouco de água, eu me lembro de quando acordei depois de... ser trazido de volta."

# game/chapters/chapter5/script/ch5sc12.rpy:1296
translate brazil ch5sc12_154317ba:

#   vi "My throat was parched to say the least."
    vi "Para dizer o mínimo, minha garganta estava ressecada."

# game/chapters/chapter5/script/ch5sc12.rpy:1298
translate brazil ch5sc12_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter5/script/ch5sc12.rpy:1303
translate brazil ch5sc12_ed56e28b:

#   ala "*Gasping* Hnnh! Hhh!"
    ala "*Ofegante* Hnnh! Hhh!"

# game/chapters/chapter5/script/ch5sc12.rpy:1304
translate brazil ch5sc12_db64af51:

#   ala "Wha-... what happened?! What's going on?? Irene?"
    ala "O que... o que aconteceu?! O que está acontecendo?? Irene?"

# game/chapters/chapter5/script/ch5sc12.rpy:1310
translate brazil ch5sc12_d8fb35d9:

#   ala "I-... I'm alive?"
    ala "Eu... eu estou vivo?"

# game/chapters/chapter5/script/ch5sc12.rpy:1311
translate brazil ch5sc12_109324b0:

#   ala "But... I remember it, Irene-... she defeated me in the arena?"
    ala "Mas... eu me lembro, Irene... ela me derrotou na arena?"

# game/chapters/chapter5/script/ch5sc12.rpy:1312
translate brazil ch5sc12_ffd069fa:

#   ala "Was I just dreaming it? A vivid nightmare?"
    ala "Será que eu estava apenas sonhando? Um pesadelo vívido?"

# game/chapters/chapter5/script/ch5sc12.rpy:1313
translate brazil ch5sc12_1cae1d06:

#   ala "No... I felt the pain of each cut, I heard Irene scream as she held me."
    ala "Não... Senti a dor de cada corte, ouvi Irene gritar enquanto me abraçava."

# game/chapters/chapter5/script/ch5sc12.rpy:1314
translate brazil ch5sc12_7a6c4c68:

#   ala "I-... I tried to calm her, but my lips wouldn't move? I was trapped."
    ala "Eu... tentei acalmá-la, mas meus lábios não se moviam? Eu estava presa."

# game/chapters/chapter5/script/ch5sc12.rpy:1316
translate brazil ch5sc12_ef9079f3:

#   vi "Sister, looks like I missed it... welcome back to the world of the living."
    vi "Irmã, parece que eu perdi... bem-vinda de volta ao mundo dos vivos."

# game/chapters/chapter5/script/ch5sc12.rpy:1317
translate brazil ch5sc12_454118c2:

#   vi "We have much to discuss, but first... here, I brought you some water."
    vi "Temos muito o que conversar, mas primeiro... aqui, eu trouxe um pouco de água para você."

# game/chapters/chapter5/script/ch5sc12.rpy:1319
translate brazil ch5sc12_d8440df4:

#   ala "Viperia."
    ala "Víbora."

# game/chapters/chapter5/script/ch5sc12.rpy:1320
translate brazil ch5sc12_7ff23c4d:

#   ala "Tell me what happened?! I was dead... now I'm not? What the hell is going on?!"
    ala "Me diga o que aconteceu?! Eu estava morto... e agora não estou mais? Que diabos está acontecendo?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1321
translate brazil ch5sc12_606f9547:

#   ala "Where's Irene? Is she okay? I want to see her!"
    ala "Onde está a Irene? Ela está bem? Quero vê-la!"

# game/chapters/chapter5/script/ch5sc12.rpy:1323
translate brazil ch5sc12_9cc92c03:

#   vi "You'll get to see her when the time is right."
    vi "Você poderá vê-la quando chegar a hora certa."

# game/chapters/chapter5/script/ch5sc12.rpy:1324
translate brazil ch5sc12_777fde15:

#   ala "Why can't I see her now? She needs to know I'm alive! She must be freaking out!"
    ala "Por que não consigo vê-la agora? Ela precisa saber que estou vivo! Ela deve estar em pânico!"

# game/chapters/chapter5/script/ch5sc12.rpy:1325
translate brazil ch5sc12_5b2b99a4:

#   vi "You will be reunited with her in due time, but for now, you must practice patience."
    vi "Vocês se reencontrarão no devido tempo, mas por agora, você deve ter paciência."

# game/chapters/chapter5/script/ch5sc12.rpy:1327
translate brazil ch5sc12_5016c968:

#   vi "Irene is currently going through emotional distress due to you dying at her hands."
    vi "Irene está passando por um momento de grande sofrimento emocional devido à sua morte pelas mãos dela."

# game/chapters/chapter5/script/ch5sc12.rpy:1328
translate brazil ch5sc12_3cb63ebb:

#   vi "She needs to process it, and hone her emotions."
    vi "Ela precisa processar isso e aprimorar suas emoções."

# game/chapters/chapter5/script/ch5sc12.rpy:1329
translate brazil ch5sc12_59350839:

#   vi "Otherwise she'll never survive as a Shadow-sister."
    vi "Caso contrário, ela jamais sobreviverá como uma Irmã das Sombras."

# game/chapters/chapter5/script/ch5sc12.rpy:1330
translate brazil ch5sc12_6132a2c3:

#   ala "I-... I know, but-"
    ala "Eu... eu sei, mas..."

# game/chapters/chapter5/script/ch5sc12.rpy:1332
translate brazil ch5sc12_1ffb2ec2:

#   vi "Uh-uh, no buts."
    vi "Não, não há \"mas\"."

# game/chapters/chapter5/script/ch5sc12.rpy:1333
translate brazil ch5sc12_9b2d0c3d:

#   vi "Irene is about to be given a task of great importance to the society, she cannot afford to fail."
    vi "Irene está prestes a receber uma tarefa de grande importância para a sociedade, e não pode se dar ao luxo de falhar."

# game/chapters/chapter5/script/ch5sc12.rpy:1335
translate brazil ch5sc12_00bb59b7:

#   ala "So you're wanting us to remain seperated for the time being to not cause her further distress?"
    ala "Então você quer que permaneçamos separados por enquanto para não causar mais sofrimento a ela?"

# game/chapters/chapter5/script/ch5sc12.rpy:1336
translate brazil ch5sc12_7ffa13a4:

#   vi "*Scoffs* I knew you were the clever one."
    vi "*Risos* Eu sabia que você era o esperto."

# game/chapters/chapter5/script/ch5sc12.rpy:1337
translate brazil ch5sc12_f97012eb:

#   vi "Yes, Circe has been most impressed by your actions as initiate."
    vi "Sim, Circe ficou muito impressionada com suas ações como iniciado."

# game/chapters/chapter5/script/ch5sc12.rpy:1339
translate brazil ch5sc12_1ac57e11:

#   vi "It's on her orders that you have been brought back, she has deemed you have what it takes to be one of us."
    vi "Foi por ordem dela que você foi trazido de volta; ela considerou que você tem o que é preciso para ser um de nós."

# game/chapters/chapter5/script/ch5sc12.rpy:1340
translate brazil ch5sc12_c0976519:

#   ala "But... I failed, I lost to Irene?"
    ala "Mas... eu falhei, perdi para a Irene?"

# game/chapters/chapter5/script/ch5sc12.rpy:1342
translate brazil ch5sc12_b40a1853:

#   vi "You failed once, it was a rather even match, your life as a Shadow-sister is more than just combat."
    vi "Você falhou uma vez, foi uma luta bastante equilibrada, sua vida como uma Irmã das Sombras é mais do que apenas combate."

# game/chapters/chapter5/script/ch5sc12.rpy:1343
translate brazil ch5sc12_82ca2f93:

#   vi "Most of the time the success of an assassination is determined by avoiding combat altogether."
    vi "Na maioria das vezes, o sucesso de um assassinato é determinado por evitar o combate por completo."

# game/chapters/chapter5/script/ch5sc12.rpy:1345
translate brazil ch5sc12_d311a175:

#   ala "What am I to do then? I can't remain here at the society if I'm to avoid irene for a while."
    ala "O que devo fazer então? Não posso ficar aqui na sociedade se quiser evitar a Irene por um tempo."

# game/chapters/chapter5/script/ch5sc12.rpy:1346
translate brazil ch5sc12_40cb4b09:

#   vi "A mission has been chosen for you, one which will see you travel Arazalia."
    vi "Uma missão foi escolhida para você, uma que o levará a viajar por Arazalia."

# game/chapters/chapter5/script/ch5sc12.rpy:1348
translate brazil ch5sc12_db37d644:

#   ala "Arazalia? If you wanted to get rid of me, you could've just let me remained dead."
    ala "Arazalia? Se você quisesse se livrar de mim, poderia simplesmente ter me deixado morta."

# game/chapters/chapter5/script/ch5sc12.rpy:1349
translate brazil ch5sc12_0d05c3b6:

#   vi "*Scoffs* I know Arazalia is... far."
    vi "*Risos* Eu sei que Arazalia é... longe."

# game/chapters/chapter5/script/ch5sc12.rpy:1350
translate brazil ch5sc12_78009fa9:

#   vi "But you'll be well compensated for your first contract."
    vi "Mas você será bem remunerado pelo seu primeiro contrato."

# game/chapters/chapter5/script/ch5sc12.rpy:1351
translate brazil ch5sc12_9d1bec49:

#   vi "As you know, Arazalian contracts are by far the most lucrative."
    vi "Como você sabe, os contratos da Arazalian são de longe os mais lucrativos."

# game/chapters/chapter5/script/ch5sc12.rpy:1353
translate brazil ch5sc12_a863050a:

#   ala "As if I care about the coin... but if this is what will be best for Irene..."
    ala "Como se eu me importasse com a moeda... mas se isso for o melhor para Irene..."

# game/chapters/chapter5/script/ch5sc12.rpy:1354
translate brazil ch5sc12_50ef1ae0:

#   ala "*Exhales* Then that's what I'll do."
    ala "*Exala* Então é isso que farei."

# game/chapters/chapter5/script/ch5sc12.rpy:1355
translate brazil ch5sc12_bc687c41:

#   ala "You've trained us for these scenarios... I... I just didn't expect it to hit us this suddenly."
    ala "Vocês nos treinaram para esses cenários... Eu... eu simplesmente não esperava que isso nos atingisse tão repentinamente."

# game/chapters/chapter5/script/ch5sc12.rpy:1357
translate brazil ch5sc12_bae1fd55:

#   vi "Trust me, all your Shadow-sisters and brothers have been in your shoes."
    vi "Acredite em mim, todos os seus irmãos e irmãs das Sombras já estiveram no seu lugar."

# game/chapters/chapter5/script/ch5sc12.rpy:1358
translate brazil ch5sc12_322445d8:

#   vi "We fully understand the discomfort of the situation, but you'll make it through."
    vi "Entendemos perfeitamente o desconforto da situação, mas você vai superar isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1360
translate brazil ch5sc12_c7ccb0a9:

#   vi "And when you do, the two of you will emerge as Shadow-sisters nobody can dispute your rank."
    vi "E quando isso acontecer, vocês duas emergirão como Irmãs das Sombras, cuja posição ninguém poderá contestar."

# game/chapters/chapter5/script/ch5sc12.rpy:1361
translate brazil ch5sc12_5dda6fef:

#   ala "*Sighs* I'll have that water now... my throat is rather sore."
    ala "*Suspiro* Vou querer essa água agora... minha garganta está bastante irritada."

# game/chapters/chapter5/script/ch5sc12.rpy:1363
translate brazil ch5sc12_9cfd6029:

#   vi "*Scoffs* I knew it would be, dying isn't easy on the body."
    vi "*Risos* Eu sabia que seria assim, morrer não é fácil para o corpo."

# game/chapters/chapter5/script/ch5sc12.rpy:1372
translate brazil ch5sc12_4c728d84:

#   ir "*Panting* Hnnh... hhhrh..."
    ir "*Ofegante* Hnnh... hhhrh..."

# game/chapters/chapter5/script/ch5sc12.rpy:1374
translate brazil ch5sc12_de04d4d6:

#   vi "Well done, Sister."
    vi "Muito bem, irmã."

# game/chapters/chapter5/script/ch5sc12.rpy:1375
translate brazil ch5sc12_ba3a29ed:

#   vi "I see your training is elevating, taking down a Shadow-brother is no easy feat."
    vi "Vejo que seu treinamento está melhorando; derrotar um Irmão das Sombras não é tarefa fácil."

# game/chapters/chapter5/script/ch5sc12.rpy:1376
translate brazil ch5sc12_8fda1790:

#   ir "Viperia... where have you been all day? You said you had a mission for me."
    ir "Viperia... onde você esteve o dia todo? Você disse que tinha uma missão para mim."

# game/chapters/chapter5/script/ch5sc12.rpy:1377
translate brazil ch5sc12_455e11be:

#   vi "Not here, c'mon... I'll brief you up on the eastern terrace."
    vi "Não aqui, vamos lá... Vou te explicar tudo lá no terraço leste."

# game/chapters/chapter5/script/ch5sc12.rpy:1386
translate brazil ch5sc12_f764bca3:

#   ir "So... what is it? Who's my first target?"
    ir "Então... o que é isso? Quem é meu primeiro alvo?"

# game/chapters/chapter5/script/ch5sc12.rpy:1387
translate brazil ch5sc12_a20482e3:

#   vi "*Scoffs* Not so fast, first I need to ensure you can handle it, that you're... not gonna fall short."
    vi "*Risos* Não tão depressa, primeiro preciso ter certeza de que você consegue lidar com isso, que você... não vai decepcionar."

# game/chapters/chapter5/script/ch5sc12.rpy:1389
translate brazil ch5sc12_2e5119f5:

#   ir "I'm ready and you know it."
    ir "Estou pronto e você sabe disso."

# game/chapters/chapter5/script/ch5sc12.rpy:1390
translate brazil ch5sc12_80e0c789:

#   ir "You've seen my training, you saw how I took down that Shadow-brother just now."
    ir "Você viu meu treinamento, viu como eu derrotei aquele Irmão das Sombras agora mesmo."

# game/chapters/chapter5/script/ch5sc12.rpy:1391
translate brazil ch5sc12_317383fb:

#   vi "*Scoffs* I'm not sure you're mentally ready to take another life."
    vi "*Risos* Não tenho certeza se você está mentalmente preparado para tirar outra vida."

# game/chapters/chapter5/script/ch5sc12.rpy:1392
translate brazil ch5sc12_3e8a60fa:

#   vi "Besting your brothers and sisters in training is one thing."
    vi "Superar seus irmãos e irmãs de treino é uma coisa."

# game/chapters/chapter5/script/ch5sc12.rpy:1394
translate brazil ch5sc12_1cef1058:

#   vi "Being able to handle taking another life so soon? I'm not sure you have the mental fortitude for that."
    vi "Ser capaz de lidar com a ideia de tirar outra vida tão cedo? Não tenho certeza se você tem a força mental necessária para isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1395
translate brazil ch5sc12_533ed75b:

#   ir "You have no idea what I've been through or what I can handle."
    ir "Você não faz ideia do que eu passei ou do que sou capaz de suportar."

# game/chapters/chapter5/script/ch5sc12.rpy:1397
translate brazil ch5sc12_0355b344:

#   ir "You think Alana was my first kill? Give me a break..."
    ir "Você acha que Alana foi minha primeira vítima? Me poupe..."

# game/chapters/chapter5/script/ch5sc12.rpy:1398
translate brazil ch5sc12_6fde363a:

#   vi "*Scoffs* Yes, you were a big bad outlaw with Raden's legion."
    vi "*Risos* Sim, você era um grande e mau fora da lei da legião de Raden."

# game/chapters/chapter5/script/ch5sc12.rpy:1399
translate brazil ch5sc12_bade4241:

#   ir "I have dealt with Alana's death, I've regained my balance and found my focus."
    ir "Superei a morte de Alana, recuperei o equilíbrio e encontrei meu foco."

# game/chapters/chapter5/script/ch5sc12.rpy:1401
translate brazil ch5sc12_bbea727f:

#   vi "Is that so? Let's hear it... convince me that you have moved on."
    vi "É mesmo? Conte-me... convença-me de que você superou isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1402
translate brazil ch5sc12_ee4f678b:

#   vi "If you can convince me you're no longer feeling sorry for yourself, I'll give you your first contract."
    vi "Se você conseguir me convencer de que não está mais com pena de si mesmo, eu lhe darei seu primeiro contrato."

# game/chapters/chapter5/script/ch5sc12.rpy:1404
translate brazil ch5sc12_4aaa49b2:

#   ir "Rin."
    ir "Também."

# game/chapters/chapter5/script/ch5sc12.rpy:1406
translate brazil ch5sc12_0cf15b29:

#   vi "Rin? Elaborate."
    vi "Rin? Explique melhor."

# game/chapters/chapter5/script/ch5sc12.rpy:1408
translate brazil ch5sc12_825691ce:

#   ir "It all comes down to her."
    ir "Tudo depende dela."

# game/chapters/chapter5/script/ch5sc12.rpy:1409
translate brazil ch5sc12_b0b1261b:

#   ir "Sure, Alana died by my hands, I can't change that."
    ir "Sim, Alana morreu pelas minhas mãos, não posso mudar isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1411
translate brazil ch5sc12_55d9c530:

#   ir "But if I hadn't failed my mission to take out Rin, I would've gone through graduation weeks before Alana."
    ir "Mas se eu não tivesse falhado na minha missão de eliminar Rin, eu teria me formado semanas antes de Alana."

# game/chapters/chapter5/script/ch5sc12.rpy:1412
translate brazil ch5sc12_ea35440a:

#   ir "I would've faced another initiate in the arena... Alana would be alive."
    ir "Eu teria enfrentado outro iniciado na arena... Alana estaria viva."

# game/chapters/chapter5/script/ch5sc12.rpy:1414
translate brazil ch5sc12_da28a1da:

#   vit "She's already blaming Rin on her own? Perfect... makes my job a whole lot easier."
    vit "Ela já está culpando a Rin sozinha? Perfeito... isso facilita muito o meu trabalho."

# game/chapters/chapter5/script/ch5sc12.rpy:1415
translate brazil ch5sc12_91eb9536:

#   vit "All I'll have to do is give her a little nudge, and she'll lock onto Rin with all her hatred for good."
    vit "Basta eu dar um pequeno empurrãozinho nela, e ela vai se voltar para Rin com todo o seu ódio para sempre."

# game/chapters/chapter5/script/ch5sc12.rpy:1416
translate brazil ch5sc12_fadd1dcc:

#   vit "Catching Rin has been an issue for a while."
    vit "Capturar Rin tem sido um problema há algum tempo."

# game/chapters/chapter5/script/ch5sc12.rpy:1417
translate brazil ch5sc12_6996ea9f:

#   vit "The more members we can provide a personal reason to go after her... the better."
    vit "Quanto mais membros tivermos um motivo pessoal para ir atrás dela... melhor."

# game/chapters/chapter5/script/ch5sc12.rpy:1419
translate brazil ch5sc12_b3f00de1:

#   vi "Go on, you've caught my interest, Sister."
    vi "Vamos lá, você despertou meu interesse, irmã."

# game/chapters/chapter5/script/ch5sc12.rpy:1421
translate brazil ch5sc12_a18d2a73:

#   ir "I'm going to finish what I failed to do before, I'm going to take her down."
    ir "Vou terminar o que não consegui fazer antes, vou acabar com ela."

# game/chapters/chapter5/script/ch5sc12.rpy:1422
translate brazil ch5sc12_b8e2a34a:

#   ir "Failure isn't an option, Alana's honor depends on it."
    ir "Falhar não é uma opção, a honra de Alana depende disso."

# game/chapters/chapter5/script/ch5sc12.rpy:1424
translate brazil ch5sc12_544ff8f0:

#   vi "Yes, I see the reasoning for your target of choice."
    vi "Sim, entendo o raciocínio por trás da sua escolha de alvo."

# game/chapters/chapter5/script/ch5sc12.rpy:1425
translate brazil ch5sc12_908ce71a:

