#   mc "I am."
    mc "Eu sou."

# game/chapters/chapter7/ch7sc3.rpy:1457
translate brazil ch7sc3_98335c6b_1:

#   lu "*Giggles* …"
    lu "*Risos* …"

# game/chapters/chapter7/ch7sc3.rpy:1505
translate brazil ch7sc3_6d00b86e_1:

#   lu "*Snickers* …"
    lu "*Snickers* …"

# game/chapters/chapter7/ch7sc3.rpy:2249
translate brazil ch7sc3_70f542fa_1:

#   lu "*Giggles softly* …"
    lu "*Risinhos suaves* …"

# game/chapters/chapter7/ch7sc3.rpy:2689
translate brazil ch7sc3_70f542fa_2:

#   lu "*Giggles softly* …"
    lu "*Risinhos suaves* …"

# game/chapters/chapter7/ch7sc3.rpy:2381
translate brazil ch7sc3_821b300a_1:

#   mc "Mmmh… I love you, Luna."
    mc "Hum… Eu te amo, Luna."



