translate brazil ch5sc09_58612b03:

#   el "Want me to come with?"
    el "Quer que eu vá com você?"

# game/chapters/chapter5/script/ch5sc09.rpy:144
translate brazil ch5sc09_f2bff903:

#   mc "It’s fine. You’re on firewood duty. Just make sure we have enough to last all night."
    mc "Não tem problema. Você está encarregado da lenha. Só certifique-se de que temos o suficiente para a noite toda."

# game/chapters/chapter5/script/ch5sc09.rpy:146
translate brazil ch5sc09_45665d61:

#   el "Okaaay! Prepare to be amazed by my firewood gathering abilities! *Giggles*"
    el "Ok! Preparem-se para se surpreenderem com minhas habilidades em coletar lenha! *Risos*"

# game/chapters/chapter5/script/ch5sc09.rpy:154
translate brazil ch5sc09_c15cc7d6:

#   lu "..."
    lu "..."

# game/chapters/chapter5/script/ch5sc09.rpy:156
