translate brazil ch4sc17_2c7a26d5:

#   el "*Giggles* Hahah Hey! Now I see why [mc] named you Trouble! Hahah!"
    el "*Risos* Hahaha! Ei! Agora entendi por quê. [mc] Te dei o nome de Problema! Hahaha!"

# game/chapters/chapter4/script/ch4sc17.rpy:155
translate brazil ch4sc17_36187e9e:

#   br "Hah! Ye send me running and then yer just fooling around with the poor animal?!"
    br "Hah! Você me manda correr e depois fica aí brincando com o pobre animal?!"

