translate brazil ch7sc9_fea382ce:

#   ro "Then I have a feeling even I… your own guildmaster… won’t be able to resist you."
    ro "Então, tenho a sensação de que nem eu... seu próprio mestre de guilda... conseguirei resistir a você."

# game/chapters/chapter7/ch7sc9.rpy:2306
translate brazil ch7sc9_1bfe3793:

#   mc "I’ll toast to that… winning your affection."
    mc "Farei um brinde a isso… por conquistar seu afeto."

# game/chapters/chapter7/ch7sc9.rpy:2308
translate brazil ch7sc9_e55ab871:

