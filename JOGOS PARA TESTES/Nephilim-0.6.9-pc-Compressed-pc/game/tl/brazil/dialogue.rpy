# game/chapters/chapter2/script/ch2sc10.rpy:352
translate brazil ch2sc10_788d5b85:

#   mc "You look good... better than I remember."
    mc "Você está com uma ótima aparência... melhor do que eu me lembrava."

# game/chapters/chapter2/script/ch2sc10.rpy:353
translate brazil ch2sc10_6f2309fc:

#   my "*Snickers* I'm a decade older than you remember... but then again, back then you wouldn't have appreciated my looks."
    my "*Risos* Sou dez anos mais velha do que você se lembra... mas, pensando bem, naquela época você não teria apreciado minha aparência."

# game/chapters/chapter2/script/ch2sc10.rpy:354
translate brazil ch2sc10_4ac6bdbd:

