translate brazil ch5sc12_786a4dca:

#   mc "Did you ask the maids? Don’t they clean your room?"
    mc "Você perguntou às camareiras? Elas não limpam o seu quarto?"

# game/chapters/chapter5/script/ch5sc12.rpy:37
translate brazil ch5sc12_348c9221:

#   am "They don’t clean my room in the middle of the night."
    am "Eles não limpam meu quarto no meio da noite."

# game/chapters/chapter5/script/ch5sc12.rpy:39
translate brazil ch5sc12_d3780b47:

#   am "While I’m {b}SLEEPING!{/b}"
    am "Enquanto eu estiver {b} DORMINDO!{/b}"

