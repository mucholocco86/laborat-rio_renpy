# game/chapters/chapter5/script/ch5sc2.rpy:2971
translate brazil ch5sc2_791a64ed:

#   mc "Sylph... I can hear you."
    mc "Sylph... Eu consigo te ouvir."

# game/chapters/chapter5/script/ch5sc2.rpy:2973
translate brazil ch5sc2_c1338cc6:

#   sy "R-Right! Heh-heh-heh! I-I was fully aware! Yuup!"
