    kl "*Choro* {b} Você está doente! Eu não te quero!{/b}"

# game/chapters/chapter4/script/ch4sc12.rpy:950
translate brazil ch4sc12_4d2a106d:

#   lll "*Grip tightens* You'll play a different tune once I’ve filled every hole of yours!"
    lll "*Aperta mais forte* Você vai tocar uma música diferente quando eu tiver preenchido cada um dos seus buracos!"

# game/chapters/chapter4/script/ch4sc12.rpy:952
translate brazil ch4sc12_5b282de3:

#   lll "I bet you’re a tight fit. Such a young slender body. Hnnhhrrh... you’re mine, Kelly."
    lll "Aposto que você é bem apertadinha. Um corpinho tão jovem e esguio. Hnnhhrrh... você é minha, Kelly."

# game/chapters/chapter4/script/ch4sc12.rpy:954
translate brazil ch4sc12_d0a04da5:

