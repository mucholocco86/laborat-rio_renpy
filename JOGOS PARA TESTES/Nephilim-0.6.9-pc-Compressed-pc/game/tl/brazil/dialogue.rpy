# game/chapters/chapter1/script/ch1sc6.rpy:102
translate brazil ch1sc6_4af66c0a:

#   pa "By the Divines! Y... You actually did it!"
    pa "Pelos deuses! Você... Você realmente conseguiu!"

# game/chapters/chapter1/script/ch1sc6.rpy:104
translate brazil ch1sc6_3c114446:

#   ma "C... Castiel?"
    ma "C... Castiel?"

# game/chapters/chapter1/script/ch1sc6.rpy:106
translate brazil ch1sc6_00fb4568:

#   ca "..."
    ca "..."

# game/chapters/chapter1/script/ch1sc6.rpy:108
translate brazil ch1sc6_ed456bed:

#   ma "C... Castiel, my sincerest apologies for summoning you."
    ma "C... Castiel, minhas mais sinceras desculpas por tê-lo invocado."

# game/chapters/chapter1/script/ch1sc6.rpy:110
translate brazil ch1sc6_6451c061:

#   ma "We’re so desperate. We’ve tried and tried, but nothing..."
    ma "Estamos desesperados. Tentamos de tudo, mas nada..."

# game/chapters/chapter1/script/ch1sc6.rpy:112
translate brazil ch1sc6_c28b3c15:

#   "The Angelic figure rises slowly."
    "A figura angelical se ergue lentamente."

# game/chapters/chapter1/script/ch1sc6.rpy:114
translate brazil ch1sc6_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter1/script/ch1sc6.rpy:116
translate brazil ch1sc6_83fb1906:

#   ca "I know your situation."
    ca "Eu entendo sua situação."

# game/chapters/chapter1/script/ch1sc6.rpy:118
translate brazil ch1sc6_93ab2dc2:

#   ma "Y... You do? Can you help us?"
    ma "Você... Você faz isso? Pode nos ajudar?"

# game/chapters/chapter1/script/ch1sc6.rpy:120
translate brazil ch1sc6_6266979b:

#   ca "I can."
    ca "Eu posso."

# game/chapters/chapter1/script/ch1sc6.rpy:121
translate brazil ch1sc6_ef13804d:

#   ca "However... it’s strictly forbidden."
    ca "No entanto... é estritamente proibido."

# game/chapters/chapter1/script/ch1sc6.rpy:123
translate brazil ch1sc6_79dc3680:

#   ma "Please... Castiel. If you heard our prayers, you must know our intentions and feelings?"
    ma "Por favor... Castiel. Se você ouviu nossas orações, deve saber nossas intenções e sentimentos?"

# game/chapters/chapter1/script/ch1sc6.rpy:125
translate brazil ch1sc6_5fc54399:

#   ca "That is the only reason I answered your summons."
    ca "Essa é a única razão pela qual atendi à sua convocação."

# game/chapters/chapter1/script/ch1sc6.rpy:127
translate brazil ch1sc6_4c070113:

#   ca "This child that you dream of... he will come to have incredible power."
    ca "Essa criança com quem você sonha... ela terá um poder incrível."

# game/chapters/chapter1/script/ch1sc6.rpy:129
translate brazil ch1sc6_afdf01b9:

#   ca "It’s of utmost importance that he is raised with love and compassion."
    ca "É de extrema importância que ele seja criado com amor e compaixão."

# game/chapters/chapter1/script/ch1sc6.rpy:131
translate brazil ch1sc6_e74dbdd0:

#   ma "He will grow up loved! We will care for him with all we have, & teach him all we know in life!"
    ma "Ele crescerá amado! Cuidaremos dele com tudo o que temos e o ensinaremos tudo o que sabemos da vida!"

# game/chapters/chapter1/script/ch1sc6.rpy:133
translate brazil ch1sc6_d2601925:

#   ca "You must swear it upon your unborn child's life. If I bless you with a child, he will be a Nephilim."
    ca "Você deve jurar pela vida do seu filho ainda não nascido. Se eu te abençoar com um filho, ele será um Nefilim."

# game/chapters/chapter1/script/ch1sc6.rpy:135
translate brazil ch1sc6_99da373f:

#   ma "Nephilim? What does that mean?"
    ma "Nefilins? O que isso significa?"

# game/chapters/chapter1/script/ch1sc6.rpy:137
translate brazil ch1sc6_81b99068:

#   ca "A Nephilim is a half human, half angel hybrid."
    ca "Um Nefilim é um híbrido meio humano, meio anjo."

# game/chapters/chapter1/script/ch1sc6.rpy:139
translate brazil ch1sc6_a41f044a:

#   ca "There has only been one other Nephilim in the history of Midomir."
    ca "Na história de Midomir, houve apenas um outro Nefilim."

# game/chapters/chapter1/script/ch1sc6.rpy:141
translate brazil ch1sc6_d77a0ae3:

#   ca "He became consumed with power... he brought an end to the first era."
    ca "Ele se deixou consumir pelo poder... e pôs fim à primeira era."

# game/chapters/chapter1/script/ch1sc6.rpy:143
translate brazil ch1sc6_cdc93b0e:

#   ca "Thousands of innocents died in agony... despair flooded the lands."
    ca "Milhares de inocentes morreram em agonia... o desespero inundou a terra."

# game/chapters/chapter1/script/ch1sc6.rpy:145
translate brazil ch1sc6_d778202f:

#   ca "Ever since then, angels have been forbidden to interfere with mortals. Especially having children with them."
    ca "Desde então, os anjos estão proibidos de interferir na vida dos mortais, especialmente de ter filhos com eles."

# game/chapters/chapter1/script/ch1sc6.rpy:147
translate brazil ch1sc6_b73e7508:

#   ma "Please, Castiel, we will raise him right. If what you say is true, he will be a miracle. A beacon of hope."
    ma "Por favor, Castiel, nós o criaremos corretamente. Se o que você diz for verdade, ele será um milagre. Um farol de esperança."

# game/chapters/chapter1/script/ch1sc6.rpy:149
translate brazil ch1sc6_01569590:

#   ca "I can sense your emotions... your heart is pure."
    ca "Consigo sentir suas emoções... seu coração é puro."

# game/chapters/chapter1/script/ch1sc6.rpy:152
translate brazil ch1sc6_4e126fa1:

#   ca "Very well."
    ca "Muito bem."

# game/chapters/chapter1/script/ch1sc6.rpy:153
translate brazil ch1sc6_db8bb190:

#   ca "I will bless you with a child."
    ca "Eu te abençoarei com um filho."

# game/chapters/chapter1/script/ch1sc6.rpy:155
translate brazil ch1sc6_0f925785:

#   ca "But don't make me regret this decision."
    ca "Mas não me faça me arrepender dessa decisão."

# game/chapters/chapter1/script/ch1sc6.rpy:157
translate brazil ch1sc6_d0cce54f:

#   ca_t "This child will be the only one able to stop Balthazar."
    ca_t "Essa criança será a única capaz de deter Baltazar."

# game/chapters/chapter1/script/ch1sc6.rpy:159
translate brazil ch1sc6_48ca8751:

#   ma "Bless you, Castiel! I... I don't know what to say."
    ma "Deus te abençoe, Castiel! Eu... eu não sei o que dizer."

# game/chapters/chapter1/script/ch1sc6.rpy:161
translate brazil ch1sc6_2ca44e82:

#   ca "Go lay down on the bed and I will take care of the rest."
    ca "Deite-se na cama e eu cuidarei do resto."

# game/chapters/chapter1/script/ch1sc6.rpy:163
translate brazil ch1sc6_8ac99227:

#   ma "T... the bed. "
    ma "T... a cama. "

# game/chapters/chapter1/script/ch1sc6.rpy:164
translate brazil ch1sc6_5bbf9514:

#   ma "*Nervous* O... Okay."
    ma "*Nervosa* Ah... Ok."

# game/chapters/chapter1/script/ch1sc6.rpy:166
translate brazil ch1sc6_c6f5282b:

#   "She carefully walks past Castiel and approaches the empty bed."
    "Ela passa cuidadosamente por Castiel e se aproxima da cama vazia."

# game/chapters/chapter1/script/ch1sc6.rpy:168
translate brazil ch1sc6_7bdce0e3:

#   "She leans over to grab the bottom of her dress."
    "Ela se inclina para segurar a barra do vestido."

# game/chapters/chapter1/script/ch1sc6.rpy:169
translate brazil ch1sc6_2e5c3ea7:

#   ca "Stop."
    ca "Parar."

# game/chapters/chapter1/script/ch1sc6.rpy:171
translate brazil ch1sc6_19590f98:

#   ma "Huh?"
    ma "Huh?"

# game/chapters/chapter1/script/ch1sc6.rpy:173
translate brazil ch1sc6_002b5645:

#   ca "No need for that, just lay down."
    ca "Não precisa disso, apenas deite-se."

# game/chapters/chapter1/script/ch1sc6.rpy:175
translate brazil ch1sc6_8f1f2714:

#   ma "O... Okay. I'm not sure how this works."
    ma "Ah... Ok. Não tenho certeza de como isso funciona."

# game/chapters/chapter1/script/ch1sc6.rpy:177
translate brazil ch1sc6_d417a397:

#   ca "You’ll see."
    ca "Você verá."

# game/chapters/chapter1/script/ch1sc6.rpy:179
translate brazil ch1sc6_17830ead:

#   ma "W... Will it hurt?"
    ma "Vai doer?"

# game/chapters/chapter1/script/ch1sc6.rpy:181
translate brazil ch1sc6_8b43d5d2:

#   ca "You’ll feel a tiny tingle in your belly, nothing else."
    ca "Você sentirá um leve formigamento na barriga, nada mais."

# game/chapters/chapter1/script/ch1sc6.rpy:182
translate brazil ch1sc6_d01ced06:

#   ca "I’m infusing some of my essence with yours, thus making you pregnant."
    ca "Estou infundindo um pouco da minha essência com a sua, fazendo com que você engravide."

# game/chapters/chapter1/script/ch1sc6.rpy:184
translate brazil ch1sc6_0ae63f8b:

#   ma "Mh! Ahh... it’s warm."
    ma "Hum! Ah... está quentinho."

# game/chapters/chapter1/script/ch1sc6.rpy:185
translate brazil ch1sc6_4883a428:

#   "Castiel proceeds to infuse her with pure angelic energy."
    "Castiel então a imbuí com pura energia angelical."

# game/chapters/chapter1/script/ch1sc6.rpy:189
translate brazil ch1sc6_51d80832:

#   ca "It’s done. Remember what I’ve told you, protect him at all costs."
    ca "Está feito. Lembre-se do que eu lhe disse: proteja-o a todo custo."

# game/chapters/chapter1/script/ch1sc6.rpy:190
translate brazil ch1sc6_002a0adb:

#   ca "If you let him fall to darkness, I will have to... end him."
    ca "Se você o deixar sucumbir à escuridão, terei que... acabar com ele."

# game/chapters/chapter1/script/ch1sc6.rpy:192
translate brazil ch1sc6_771f0c6b:

#   ma "Thank you! Thank you! Thank you! We’ll cherish this child with all the love our hearts contain!"
    ma "Muito obrigada! Muito obrigada! Muito obrigada! Vamos amar esta criança com todo o carinho que nossos corações têm!"

# game/chapters/chapter1/script/ch1sc6.rpy:194
translate brazil ch1sc6_add83bdd:

#   ca "I have no doubt. Goodbye."
    ca "Não tenho dúvidas. Adeus."

# game/chapters/chapter1/script/ch1sc6.rpy:196
translate brazil ch1sc6_81afec93:

#   "As Castiel rises, the room starts vibrating, accompanied by a high-pitched sound."
    "Conforme Castiel se levanta, a sala começa a vibrar, acompanhada por um som agudo."

# game/chapters/chapter1/script/ch1sc6.rpy:150
translate brazil ch1sc6_00fb4568_1:

#   ca "..."
    ca "..."



# ARQUIVO: game/chapters/chapter3/script/ch3sc8.rpy DIALOGOS: 17


# game/chapters/chapter3/script/ch3sc8.rpy:12
translate brazil ch3sc8_5a21c7ac:

#   uk "..."
    uk "..."

# game/chapters/chapter3/script/ch3sc8.rpy:14
translate brazil ch3sc8_a0902dcf:

#   uk "Sir..."
    uk "Senhor..."

# game/chapters/chapter3/script/ch3sc8.rpy:15
translate brazil ch3sc8_a6f65f61:

#   uk "I’ve just received word that they’ve accepted the contract."
    uk "Acabei de receber a notícia de que eles aceitaram o contrato."

# game/chapters/chapter3/script/ch3sc8.rpy:17
translate brazil ch3sc8_9e2bbb68:

#   uk "Good. It won’t be long now."
    uk "Ótimo. Não vai demorar muito."

# game/chapters/chapter3/script/ch3sc8.rpy:19
translate brazil ch3sc8_c34c5dd4:

#   uk "Sir, is this really our best option? Surely there are better ways to guarantee your success?"
    uk "Senhor, esta é realmente a nossa melhor opção? Certamente existem maneiras melhores de garantir o seu sucesso?"

# game/chapters/chapter3/script/ch3sc8.rpy:22
translate brazil ch3sc8_52d9df39:

#   uk "Are you questioning my plan?"
    uk "Você está questionando meu plano?"

# game/chapters/chapter3/script/ch3sc8.rpy:24
translate brazil ch3sc8_c3fe84ea:

#   uk "N-No sir! I w-would never!"
    uk "N-Não senhor! Eu n-nunca faria isso!"

# game/chapters/chapter3/script/ch3sc8.rpy:26
translate brazil ch3sc8_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter3/script/ch3sc8.rpy:30
translate brazil ch3sc8_485c9f05:

#   uk "But are you certain we can trust her?"
    uk "Mas você tem certeza de que podemos confiar nela?"

# game/chapters/chapter3/script/ch3sc8.rpy:32
translate brazil ch3sc8_455b7b72:

#   uk "She will do as I command."
    uk "Ela fará como eu mandar."

# game/chapters/chapter3/script/ch3sc8.rpy:34
translate brazil ch3sc8_747a2804:

#   uk "H-How can you be sure?"
    uk "H-Como você pode ter certeza?"

# game/chapters/chapter3/script/ch3sc8.rpy:36
translate brazil ch3sc8_45adc1fa:

#   uk "I have something precious to her."
    uk "Tenho algo precioso para ela."

# game/chapters/chapter3/script/ch3sc8.rpy:37
translate brazil ch3sc8_1fac946b:

#   uk "She won’t fail."
    uk "Ela não vai falhar."

# game/chapters/chapter3/script/ch3sc8.rpy:40
translate brazil ch3sc8_db887696:

#   uk "Now, leave!"
    uk "Agora, vá embora!"

# game/chapters/chapter3/script/ch3sc8.rpy:42
translate brazil ch3sc8_cf9b6756:

#   uk "R-Right away, sir!"
    uk "Imediatamente, senhor!"

# game/chapters/chapter3/script/ch3sc8.rpy:48
translate brazil ch3sc8_96b0e3a6:

#   uk "You won’t fail. Will you, little bird?"
    uk "Você não vai falhar. Vai, passarinho?"

# game/chapters/chapter3/script/ch3sc8.rpy:49
translate brazil ch3sc8_1d8ab81c:

#   uk "After all... the fate of that which is most precious to you, rests on your compliance."
    uk "Afinal de contas... o destino daquilo que lhe é mais precioso depende da sua obediência."



# ARQUIVO: game/chapters/chapter3/script/ch3sc17.rpy DIALOGOS: 429


# game/chapters/chapter3/script/ch3sc17.rpy:20
translate brazil ch3sc17_31ad824f:

#   mct "This is the tavern that'll be our home for the next while... 'The Drunken Rooster'"
    mct "Esta é a taverna que será nossa casa pelos próximos tempos... 'O Galo Bêbado'"

# game/chapters/chapter3/script/ch3sc17.rpy:22
translate brazil ch3sc17_82e293cd:

#   mct "Where do they come up with these tavern names? Rusty Spoon... Drunken Rooster..."
    mct "De onde eles tiram esses nomes de taverna? Colher Enferrujada... Galo Bêbado..."

# game/chapters/chapter3/script/ch3sc17.rpy:24
translate brazil ch3sc17_95411891:

#   sl "This is the place, my favorite tavern in Luxenford."
    sl "Este é o lugar, minha taverna favorita em Luxemburgo."

# game/chapters/chapter3/script/ch3sc17.rpy:25
translate brazil ch3sc17_b41dee98:

#   sl "Aren't we meeting Eliza? I don't see her?"
    sl "Não íamos encontrar a Eliza? Não a vejo."

# game/chapters/chapter3/script/ch3sc17.rpy:27
translate brazil ch3sc17_55f06f1e:

#   mc "I appreciate you recommending us this place, I even suggested it to my acquaintance, Borri."
    mc "Agradeço por ter nos recomendado este lugar, inclusive o sugeri a um conhecido meu, Borri."

# game/chapters/chapter3/script/ch3sc17.rpy:28
translate brazil ch3sc17_82560b21:

#   mc "He said he'd meet us here for ales."
    mc "Ele disse que nos encontraria aqui para tomar umas cervejas."

# game/chapters/chapter3/script/ch3sc17.rpy:29
translate brazil ch3sc17_55e4f198:

#   mc "As for Eliza, she's probably inside already."
    mc "Quanto a Eliza, ela provavelmente já está lá dentro."

# game/chapters/chapter3/script/ch3sc17.rpy:31
translate brazil ch3sc17_e7f198f5:

#   sl "Great! before we head in, though..."
    sl "Ótimo! Mas antes de entrarmos..."

# game/chapters/chapter3/script/ch3sc17.rpy:33
translate brazil ch3sc17_6ebd1b7f:

#   sl "I’ve been meaning to do this."
    sl "Eu já vinha querendo fazer isso."

# game/chapters/chapter3/script/ch3sc17.rpy:35
translate brazil ch3sc17_d0a954fe:

#   "Before you have a chance to react, Selena leans in and plants her lips halfway between your lips and your cheek."
    "Antes que você tenha a chance de reagir, Selena se inclina e coloca os lábios a meio caminho entre os seus lábios e a sua bochecha."

# game/chapters/chapter3/script/ch3sc17.rpy:37
translate brazil ch3sc17_2836807d:

#   "Her lips feel warm and soft, her scent surrounds you... Earthroot and Marigolds."
    "Os lábios dela são quentes e macios, o perfume dela te envolve... Raiz da terra e calêndulas."

# game/chapters/chapter3/script/ch3sc17.rpy:38
translate brazil ch3sc17_687f50d7:

#   "Instead of pulling back, her lips linger... awaiting your response."
    "Em vez de se afastar, seus lábios permanecem... aguardando sua resposta."

# game/chapters/chapter3/script/ch3sc17.rpy:44
translate brazil ch3sc17_27b2f579:

#   "You turn towards her, merging your lips."
    "Você se vira para ela, unindo seus lábios aos dela."

# game/chapters/chapter3/script/ch3sc17.rpy:45
translate brazil ch3sc17_64d9d7cd:

#   "Selena immediately responds with a soft moan of excitement as your lips connect."
    "Selena responde imediatamente com um gemido suave de excitação quando seus lábios se encontram."

# game/chapters/chapter3/script/ch3sc17.rpy:47
translate brazil ch3sc17_05fab6dd:

#   "She runs her fingers through your hair tenderly grabbing it while your kiss becomes more passionate."
    "Ela passa os dedos pelos seus cabelos, acariciando-os delicadamente enquanto o beijo se torna mais apaixonado."

# game/chapters/chapter3/script/ch3sc17.rpy:57
translate brazil ch3sc17_c4079359:

#   "Her tender, exotic lips keep pushing against yours with a heated passion."
    "Seus lábios delicados e exóticos pressionam os seus com uma paixão ardente."

# game/chapters/chapter3/script/ch3sc17.rpy:58
translate brazil ch3sc17_1fbca60a:

#   "Her lips have a sweetness to them, almost caramel flavored."
    "Seus lábios têm um sabor adocicado, quase como caramelo."

# game/chapters/chapter3/script/ch3sc17.rpy:59
translate brazil ch3sc17_9f2c95a9:

#   "There’s nothing quite like the intoxicating scent of a woman who desires you."
    "Não há nada como o aroma inebriante de uma mulher que te deseja."

# game/chapters/chapter3/script/ch3sc17.rpy:61
translate brazil ch3sc17_12e35a59:

#   "You lean into her and she arches her back with your hands as support."
    "Você se inclina para ela e ela arqueia as costas, usando suas mãos como apoio."

# game/chapters/chapter3/script/ch3sc17.rpy:62
translate brazil ch3sc17_468eb95e:

#   sl "Mmhm! MmMmhh!"
    sl "Hum-hum! Hum-hum!"

# game/chapters/chapter3/script/ch3sc17.rpy:63
translate brazil ch3sc17_4796daf4:

#   "She presses her tight little body against you, signaling that she won’t deny your hands on her body."
    "Ela pressiona seu corpinho firme contra você, sinalizando que não vai negar o toque de suas mãos em seu corpo."

# game/chapters/chapter3/script/ch3sc17.rpy:65
translate brazil ch3sc17_246ca8f4:

#   "Selena is fully into the kiss between the two of you, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Selena está completamente envolvida no beijo entre vocês dois, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc17.rpy:68
translate brazil ch3sc17_f3804dec:

#   uk "{b}*Shouts* Ugh! Get a room you two!{/b}"
    uk "{b}*Grita* Eca! Vão para um quarto, vocês dois!{/b}"

# game/chapters/chapter3/script/ch3sc17.rpy:69
translate brazil ch3sc17_7d3efe69:

#   uk "{b}*Shouts* Youthful indecency knows no bounds!{/b}"
    uk "{b}*Grita* A indecência juvenil não conhece limites!{/b}"

# game/chapters/chapter3/script/ch3sc17.rpy:72
translate brazil ch3sc17_f606c677:

#   sl "{b}*Shouts*{/b} How about you mind your own business! {b}You old hag!{/b}"
    sl "{b}*Gritos*{/b} Que tal você cuidar da sua própria vida? {b} Sua velha bruxa!{/b}"

# game/chapters/chapter3/script/ch3sc17.rpy:73
translate brazil ch3sc17_89448a55:

#   sl "{b}*Shouts*{/b} If you can't handle seeing two young lovers having a moment, {b}then shut your eyes!{/b}"
    sl "{b}*Gritos*{/b} Se você não consegue lidar com a ideia de dois jovens apaixonados tendo um momento íntimo, {b} Então feche os olhos!{/b}"

# game/chapters/chapter3/script/ch3sc17.rpy:75
translate brazil ch3sc17_e6a07a20:

#   sl "Ughhh! Some people just have to ruin a good moment..."
    sl "Puxa! Tem gente que sempre estraga um bom momento..."

# game/chapters/chapter3/script/ch3sc17.rpy:77
translate brazil ch3sc17_bff42c4f:

#   mc "Tell me about it."
    mc "Conte-me sobre isso."

# game/chapters/chapter3/script/ch3sc17.rpy:78
translate brazil ch3sc17_2d07a737:

#   mc "That was a tasty kiss..."
    mc "Que beijo gostoso..."

# game/chapters/chapter3/script/ch3sc17.rpy:80
translate brazil ch3sc17_9b4f21b5:

#   sl "Mmh... I agree, you're a good kisser."
    sl "Hum... Concordo, você beija bem."

# game/chapters/chapter3/script/ch3sc17.rpy:83
translate brazil ch3sc17_b57865da:

#   sl "I imagine you've kissed quite a few women..."
    sl "Imagino que você já tenha beijado muitas mulheres..."

# game/chapters/chapter3/script/ch3sc17.rpy:84
translate brazil ch3sc17_9382f528:

#   sl "Maybe you've even got a harem? You definitely have the looks and personality for it."
    sl "Talvez você até tenha um harém? Você definitivamente tem a aparência e a personalidade para isso."

# game/chapters/chapter3/script/ch3sc17.rpy:86
translate brazil ch3sc17_4e0a836b:

#   mc "*Sighs* I don't have a harem... but if I did, I'd definitely invite you."
    mc "*Suspiro* Eu não tenho um harém... mas se tivesse, com certeza te convidaria."

# game/chapters/chapter3/script/ch3sc17.rpy:87
translate brazil ch3sc17_41d5a412:

#   mc "You're gorgeous and a great kisser."
    mc "Você é linda e beija muito bem."

# game/chapters/chapter3/script/ch3sc17.rpy:89
translate brazil ch3sc17_5491a6e9:

#   sl "If that kiss was anything to go by... I'd happily accept."
    sl "Se aquele beijo servir de indicação... eu aceitaria com prazer."

# game/chapters/chapter3/script/ch3sc17.rpy:91
translate brazil ch3sc17_70ce6342:

#   "Selena enjoys the thought of being in your harem, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Selena gosta da ideia de estar em seu harém, sua confiança aumentou por {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc17.rpy:97
translate brazil ch3sc17_6c3d367d:

#   sl "I imagine you've been practicing with Eliza?"
    sl "Imagino que você tenha praticado com a Eliza?"

# game/chapters/chapter3/script/ch3sc17.rpy:98
translate brazil ch3sc17_655b5a8d:

#   sl "She's head over heels for you, the way she looked at you at the stables..."
    sl "Ela está completamente apaixonada por você, pelo jeito que ela olhou para você nos estábulos..."

# game/chapters/chapter3/script/ch3sc17.rpy:99
translate brazil ch3sc17_0448ff65:

#   sl "The way she talked about you when she tried to calm me, she has feelings for you."
    sl "Pelo jeito que ela falou de você quando tentou me acalmar, ela tem sentimentos por você."

# game/chapters/chapter3/script/ch3sc17.rpy:101
translate brazil ch3sc17_1a8e1865:

#   mc "I'm well aware..."
    mc "Estou bem ciente..."

# game/chapters/chapter3/script/ch3sc17.rpy:102
translate brazil ch3sc17_c7ce0fa2:

#   mc "She was talking about me?"
    mc "Ela estava falando de mim?"

# game/chapters/chapter3/script/ch3sc17.rpy:104
translate brazil ch3sc17_5191344a:

#   sl "Mh-hm, she sang your praises."
    sl "Hum, ela te elogiou bastante."

# game/chapters/chapter3/script/ch3sc17.rpy:105
translate brazil ch3sc17_c7c469ad:

#   sl "A woman does not compliment a guy to another woman unless she is fully smitten."
    sl "Uma mulher não elogia um homem para outra mulher a menos que esteja completamente apaixonada."

# game/chapters/chapter3/script/ch3sc17.rpy:107
translate brazil ch3sc17_805ce245:

#   sl "And that is the single best indicator a man is of good character."
    sl "E esse é o melhor indicador de que um homem tem bom caráter."

# game/chapters/chapter3/script/ch3sc17.rpy:108
