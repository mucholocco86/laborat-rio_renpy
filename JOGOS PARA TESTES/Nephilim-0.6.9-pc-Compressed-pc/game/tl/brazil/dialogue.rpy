translate brazil ch5sc14_2b7edac6:

#   gib "*Chuckles* I can attest to that, I've been living like a king since you taught her to cook. *Chuckles*"
    gib "*Risos* Posso confirmar isso, tenho vivido como um rei desde que você a ensinou a cozinhar. *Risos*"

# game/chapters/chapter5/script/ch5sc14.rpy:371
