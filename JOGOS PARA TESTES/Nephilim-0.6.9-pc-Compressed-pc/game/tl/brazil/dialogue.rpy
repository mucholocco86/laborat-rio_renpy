#   mct "Fuck, he’s faster than I expected! I just barely managed to dodge that swing."
    mct "Caramba, ele é mais rápido do que eu esperava! Quase não consegui desviar daquele golpe."

# game/chapters/chapter3/script/ch3sc22.rpy:143
translate brazil ch3sc22_b5edf00f:

#   mct "He didn't even flinch at my punch directly to his abdomen?"
    mct "Ele nem sequer se mexeu quando lhe dei um soco direto no abdômen?"

# game/chapters/chapter3/script/ch3sc22.rpy:152
