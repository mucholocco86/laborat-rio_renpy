translate brazil ch4sc17_58f2dd73:

#   el "Borri, you’re back! And I see you’ve found something?"
    el "Borri, você voltou! E vejo que encontrou algo?"

# game/chapters/chapter4/script/ch4sc17.rpy:159
translate brazil ch4sc17_afd2431a:

#   br "Aye! Here ya go, ye beas- girl..."
    br "Ei! Aqui está, esta garota..."

# game/chapters/chapter4/script/ch4sc17.rpy:162
translate brazil ch4sc17_43d1ad3b:

#   "Trouble leaps after the piece of meat and catches it mid-air."
    "Problema salta atrás do pedaço de carne e o pega no ar."

