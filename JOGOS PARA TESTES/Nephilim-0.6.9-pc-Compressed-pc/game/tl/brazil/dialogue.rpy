#   am "*Laughing* Hahaha. That’s too funny! Hahahh!"
    am "*Risos* Hahaha. Isso é muito engraçado! Hahahh!"

# game/chapters/chapter5/script/ch5sc07.rpy:901
translate brazil ch5sc07_4197e975:

#   am "I haven’t laughed like that in a while. That’s twice in one day you’ve made me laugh..."
    am "Faz tempo que não ria assim. Já é a segunda vez hoje que você me faz rir..."

# game/chapters/chapter5/script/ch5sc07.rpy:902
translate brazil ch5sc07_ba43b6ea:

#   mc "Maybe, if this bodyguard thing doesn’t work out, I should apply to become a court jester..."
