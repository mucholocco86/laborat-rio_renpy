    am "*Risos* ..."

# game/chapters/chapter5/script/ch5sc07.rpy:897
translate brazil ch5sc07_aeb25084:

#   am "*Laughs* Hahah-Hahah! N-No! Not your head shape, silly! Hahaha!"
    am "*Risos* Hahaha! N-Não! Não o formato da sua cabeça, bobinho! Hahaha!"

# game/chapters/chapter5/script/ch5sc07.rpy:898
translate brazil ch5sc07_dd493a95:

