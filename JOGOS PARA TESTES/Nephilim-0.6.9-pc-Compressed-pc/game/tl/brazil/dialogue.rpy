    al "*Suspiro* Elas não estarão nuas. E certamente não vão querer entrar para o seu harém..."

# game/chapters/chapter5/script/ch5sc09.rpy:29
translate brazil ch5sc09_71f2221a:

#   fy "Please, Alice... you’re ruining my moment."
    fy "Por favor, Alice... você está estragando meu momento."

# game/chapters/chapter5/script/ch5sc09.rpy:31
translate brazil ch5sc09_39609f4e:

#   al "*Sighs* Fine. I’ll leave you to it, then. I have plenty to do at the academy anyway."
    al "*Suspiro* Tudo bem. Vou deixar você em paz, então. De qualquer forma, tenho muito o que fazer na academia."

# game/chapters/chapter5/script/ch5sc09.rpy:32
translate brazil ch5sc09_3c05bd32:

#   fy "Perfect! I’ll get this done in no time. You’ll see!"
    fy "Perfeito! Vou terminar isso rapidinho. Você vai ver!"

# game/chapters/chapter5/script/ch5sc09.rpy:41
translate brazil ch5sc09_9616c591:

#   am "*Sighs* ..."
    am "*Suspiros* ..."

# game/chapters/chapter5/script/ch5sc09.rpy:42
translate brazil ch5sc09_22acc123:

