translate brazil ch4sc17_99693c6b:

#   el "Didn’t you see how she stopped when I called her name?"
    el "Você não viu como ela parou quando eu a chamei pelo nome?"

# game/chapters/chapter4/script/ch4sc17.rpy:106
translate brazil ch4sc17_d69015e0:

#   br "Ye mean... this is the wolf that ye and [mc] dealt with on yer first quest?"
    br "Quer dizer... este é o lobo que você e [mc] resolveu o problema na sua primeira missão?"

# game/chapters/chapter4/script/ch4sc17.rpy:108
translate brazil ch4sc17_906f4052:

#   el "The one and only! Please let her pass..."
    el "A única e inigualável! Por favor, deixem-na passar..."

# game/chapters/chapter4/script/ch4sc17.rpy:110
translate brazil ch4sc17_0678c244:

#   br "*Sigh* Ye sure on this lass? She’s a wild beast."
    br "*Suspiro* Tem certeza dessa moça? Ela é uma fera selvagem."

# game/chapters/chapter4/script/ch4sc17.rpy:112
translate brazil ch4sc17_5c4fcaea:

#   el "{b}*Angrily* Borri!{/b} That’s the last time you call her that!"
    el "{b}*Com raiva* Borri!{/b} Essa é a última vez que você a chama assim!"

# game/chapters/chapter4/script/ch4sc17.rpy:113
translate brazil ch4sc17_e3a909bd:

#   el "Go quickly and fetch something edible at one of the market stalls near the city gates."
    el "Vá depressa e compre algo para comer em uma das barracas do mercado perto dos portões da cidade."

# game/chapters/chapter4/script/ch4sc17.rpy:115
translate brazil ch4sc17_7f093f4a:

#   br "What?! I can’t leave yer alone with this bea- wolf. It could attack ye!"
    br "O quê?! Não posso te deixar sozinho com esse lobo. Ele pode te atacar!"

# game/chapters/chapter4/script/ch4sc17.rpy:117
