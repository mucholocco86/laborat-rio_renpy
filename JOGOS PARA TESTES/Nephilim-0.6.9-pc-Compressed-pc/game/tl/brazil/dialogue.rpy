# game/chapters/chapter5/script/ch5sc07.rpy:939
translate brazil ch5sc07_b9664ac7:

#   mct "{i}Heh. Even when she does something nice, she can’t help but throw around her attitude.{/i}"
    mct "{i}Hehe. Mesmo quando faz algo legal, ela não consegue evitar demonstrar sua má vontade.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:941
translate brazil ch5sc07_9ed23ae2:

#   am "Wipe that smirk off your face! I’ll see you in a few days for our next outing."
    am "Apaga esse sorriso irônico do rosto! Te vejo daqui a alguns dias para o nosso próximo passeio."

# game/chapters/chapter5/script/ch5sc07.rpy:942
translate brazil ch5sc07_34ff67ac:

#   mct "{i}*Sigh* I guess I’m having a bath... it does sound refreshing, though.{/i}"
    mct "{i}*Suspiro* Acho que vou tomar um banho... parece refrescante.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:946
translate brazil ch5sc07_534e4a03:

#   frt "{i}Amelia said to prepare a bath for [mc].{/i}"
    frt "{i}Amélia disse para preparar um banho para [mc].{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:948
translate brazil ch5sc07_4a15c094:

#   frt "{i}Mhm... nice and warm! I wish I was the one taking a bath right now...{/i}"
    frt "{i}Hum... quentinho e gostoso! Quem me dera estar tomando banho agora...{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:950
translate brazil ch5sc07_6cf70198:

#   frt "{i}She’s never requested something like this before. Especially for a man.{/i}"
    frt "{i}Ela nunca havia pedido algo assim antes. Principalmente vindo de um homem.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:952
translate brazil ch5sc07_d0fffe41:

