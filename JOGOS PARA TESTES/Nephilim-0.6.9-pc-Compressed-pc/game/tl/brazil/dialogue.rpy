    evr "*Risada*"

# game/chapters/chapter5/script/ch5sc2.rpy:1367
translate brazil ch5sc2_947cd512:

#   al "Flynn! That didn’t happen!"
    al "Flynn! Isso não aconteceu!"

# game/chapters/chapter5/script/ch5sc2.rpy:1368
translate brazil ch5sc2_8a665196:

#   br "Aye! There’s no such thing as a deck-captain!"
    br "Sim! Não existe essa coisa de capitão de convés!"

# game/chapters/chapter5/script/ch5sc2.rpy:1369
translate brazil ch5sc2_6d7dc213:

#   fy "I’m telling you, guys! They entrusted me with the safety of the entire ship!"
    fy "Estou falando sério, pessoal! Eles me confiaram a segurança de todo o navio!"

# game/chapters/chapter5/script/ch5sc2.rpy:1371
translate brazil ch5sc2_d072449c:

#   fy "If it hadn’t been for me, the deck-captain, there’s no telling what would’ve happened that day."
    fy "Se não fosse por mim, o capitão de convés, ninguém sabe o que teria acontecido naquele dia."

# game/chapters/chapter5/script/ch5sc2.rpy:1372
translate brazil ch5sc2_0971329a:

#   fy "The seas were rough like never before. The winds blew through our sails like a hurricane!"
    fy "O mar estava agitado como nunca antes. Os ventos batiam nas nossas velas como um furacão!"

# game/chapters/chapter5/script/ch5sc2.rpy:1373
translate brazil ch5sc2_ea3163ee:

#   fy "We were surrounded by enemies on all fronts, but I kept calm and held my ground!"
    fy "Estávamos cercados por inimigos por todos os lados, mas mantive a calma e resisti!"

# game/chapters/chapter5/script/ch5sc2.rpy:1374
translate brazil ch5sc2_677506b6:

#   evr "*Laughing*"
    evr "*Rindo*"

# game/chapters/chapter5/script/ch5sc2.rpy:1376
translate brazil ch5sc2_21ae215c:

#   fy "Arh... My tales of heroism are wasted on you guys!"
    fy "Ah... Minhas histórias de heroísmo são inúteis para vocês!"

# game/chapters/chapter5/script/ch5sc2.rpy:1377
translate brazil ch5sc2_c25d691d:

#   fy "I’ll save 'em for those who truly appreciate them."
    fy "Vou guardá-las para aqueles que realmente as apreciam."

# game/chapters/chapter5/script/ch5sc2.rpy:1379
translate brazil ch5sc2_ac561dd4:

#   al "Would those happen to be the wenches at the tavern who have no choice but to listen as they pour your ale?"
    al "Seriam essas as moças da taverna que não têm escolha a não ser ouvir enquanto lhe servem cerveja?"

# game/chapters/chapter5/script/ch5sc2.rpy:1381
translate brazil ch5sc2_c372c309:

#   fy "Bah! You jest only because you haven’t seen any real adventure yet, sweet Alice."
    fy "Ora! Você só está brincando porque ainda não viu nenhuma aventura de verdade, minha querida Alice."

# game/chapters/chapter5/script/ch5sc2.rpy:1383
translate brazil ch5sc2_d2a5d06f:

#   fy "[mc]! There you are!"
    fy "[mc]! Aí está você!"

# game/chapters/chapter5/script/ch5sc2.rpy:1384
translate brazil ch5sc2_ecec9b40:

#   fy "Come, tell these nonbelievers that I was, in fact, deck-captain of the Bloody Banshee!"
    fy "Venham, digam a esses incrédulos que eu era, na verdade, o capitão de convés da Banshee Sangrenta!"

# game/chapters/chapter5/script/ch5sc2.rpy:1386
translate brazil ch5sc2_2d787260:

#   mc "I’m afraid that Flynn speaks the truth."
    mc "Tenho receio de que Flynn esteja falando a verdade."

# game/chapters/chapter5/script/ch5sc2.rpy:1387
translate brazil ch5sc2_3dac426f:

#   mc "Kira herself promoted him. He's the only deck-captain anywhere on the Cerulean sea."
    mc "A própria Kira o promoveu. Ele é o único capitão de convés em todo o Mar Cerúleo."

# game/chapters/chapter5/script/ch5sc2.rpy:1389
translate brazil ch5sc2_a2e39e0c:

#   fy "See! I told you guys, true story!"
    fy "Viram? Eu disse para vocês, é verdade!"

# game/chapters/chapter5/script/ch5sc2.rpy:1392
translate brazil ch5sc2_0e46e348:

#   mc "So, what is everyone doing here?"
    mc "Então, o que todos estão fazendo aqui?"

# game/chapters/chapter5/script/ch5sc2.rpy:1393
translate brazil ch5sc2_d8d35751:

#   mc "Thought you’d be busy at the Seafarers Guild, Flynn."
    mc "Pensei que você estaria ocupado na Guilda dos Marinheiros, Flynn."

# game/chapters/chapter5/script/ch5sc2.rpy:1395
translate brazil ch5sc2_5716e960:

#   mc "And Alice? I thought you’d be neck deep in your studies."
    mc "E Alice? Pensei que você estaria mergulhada até o pescoço nos seus estudos."

# game/chapters/chapter5/script/ch5sc2.rpy:1397
translate brazil ch5sc2_6c97c39e:

#   fy "It’s true."
    fy "É verdade."

# game/chapters/chapter5/script/ch5sc2.rpy:1398
translate brazil ch5sc2_122451a6:

#   fy "There's much to do for a renowned seafarer such as myself, but I was asked to come."
    fy "Há muito o que fazer para um marinheiro renomado como eu, mas me pediram para vir."

# game/chapters/chapter5/script/ch5sc2.rpy:1400
translate brazil ch5sc2_468c3661:

#   al "Sylph asked us all to meet here."
    al "Sylph pediu que todos nos encontrássemos aqui."

# game/chapters/chapter5/script/ch5sc2.rpy:1401
translate brazil ch5sc2_b5721ee8:

#   al "She wouldn’t say what it's about... which only piqued my curiosity!"
    al "Ela não quis dizer do que se tratava... o que só aumentou minha curiosidade!"

# game/chapters/chapter5/script/ch5sc2.rpy:1403
translate brazil ch5sc2_0498258c:

#   sy "Ah, [mc]! You’re here, great!"
    sy "Ah, [mc]! Você está aqui, ótimo!"

# game/chapters/chapter5/script/ch5sc2.rpy:1404
translate brazil ch5sc2_8224d8e0:

#   sy "Saves me the trouble of sending one of them to fetch you."
    sy "Isso me poupa o trabalho de mandar um deles buscar você."

# game/chapters/chapter5/script/ch5sc2.rpy:1406
translate brazil ch5sc2_f93e722d:

#   mc "Isn’t it quite late to be gathering everyone?"
    mc "Não está um pouco tarde para reunir todo mundo?"

# game/chapters/chapter5/script/ch5sc2.rpy:1407
translate brazil ch5sc2_15b4db8d:

#   mc "What are you up to, Sylph?"
    mc "O que você está aprontando, Sylph?"

# game/chapters/chapter5/script/ch5sc2.rpy:1409
translate brazil ch5sc2_9e3e6c0e:

#   al "Yeah. Spill the beans already, Sylph!"
    al "É isso aí. Conta logo o segredo, Sylph!"

# game/chapters/chapter5/script/ch5sc2.rpy:1410
translate brazil ch5sc2_b3f4e4ff:

#   al "You refused to say anything until [mc] got here."
    al "Você se recusou a dizer qualquer coisa até [mc] cheguei aqui."

# game/chapters/chapter5/script/ch5sc2.rpy:1416
translate brazil ch5sc2_cea74571:

#   al "*Whispers* {size=-10}{b}W-What are you doing?!{/b}{/size}"
    al "*Sussurros* {size=-10}{b}O que você está fazendo?!{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1418
translate brazil ch5sc2_90d9f414:

#   mc "*Whispers* {size=-10}{b}Touching your cute little ass.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Tocando na sua bundinha fofa.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1420
translate brazil ch5sc2_e13dfd09:

#   al "*Whispers* {size=-10}{b}S-Stop it! *Gasps* Mnhh! It’s way too risky!{/b}{/size}"
    al "*Sussurros* {size=-10}{b}P-Pare com isso! *Arfa* Mnhh! É muito arriscado!{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1422
translate brazil ch5sc2_9100af9b:

#   mc "*Whispers* {size=-10}{b}The way you're leaning back into my hand says something different.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}O jeito como você se inclina para trás, apoiando-se na minha mão, diz algo diferente.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1423
translate brazil ch5sc2_551e4d62:

#   mc "*Whispers* {size=-10}{b}You're quite the handful, Alice.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Você dá bastante trabalho, Alice.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1425
translate brazil ch5sc2_9c745894:

#   al "*Whispers* {size=-10}{b}Mnhh... You're... Bad, mhh.{/b}{/size}"
    al "*Sussurros* {size=-10}{b}Hum... Você é... mau, hum.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1427
translate brazil ch5sc2_60f648c0:

#   mc "*Whispers* {size=-10}{b}Your body knows what it wants.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Seu corpo sabe o que quer.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1428
translate brazil ch5sc2_244e7fff:

#   mc "*Whispers* {size=-10}{b}Your ass fits perfectly in my hand... So perky and firm.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Seu bumbum cabe perfeitamente na minha mão... Tão empinado e firme.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1430
translate brazil ch5sc2_d16eb15a:

#   al "*Whispers* {size=-10}{b}Ahh... D-Don’t... Say such... lewd things.{/b}{/size}"
    al "*Sussurros* {size=-10}{b}Ah... N-Não... Diga coisas tão... obscenas.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1441
translate brazil ch5sc2_16241f9e:

#   "Alice enjoyed being groped by you, her trust has increased by {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."
    "Alice gostou de ser apalpada por você, e a confiança dela aumentou. {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc2.rpy:1448
translate brazil ch5sc2_b0c6c069:

#   fy "I must say, I’m intrigued. What do you have for us, little fae?"
    fy "Devo dizer que estou intrigada. O que você tem para nós, pequena fada?"

# game/chapters/chapter5/script/ch5sc2.rpy:1450
translate brazil ch5sc2_034df084:

#   sy "Little fae? Hnnrh... I’m not little. I’m... I’m fun-sized!"
    sy "Pequena fada? Hnnrh... Eu não sou pequena. Eu sou... Eu sou do tamanho ideal para diversão!"

# game/chapters/chapter5/script/ch5sc2.rpy:1452
translate brazil ch5sc2_9317f415:

#   br "Aye, don’t listen te this bugger. Yer perfectly sized, lass!"
    br "É, não dê ouvidos a esse idiota. Você tem o tamanho perfeito, garota!"

# game/chapters/chapter5/script/ch5sc2.rpy:1454
translate brazil ch5sc2_cbd75463:

#   sy "Hnngh!"
    sy "Hnngh!"

# game/chapters/chapter5/script/ch5sc2.rpy:1455
translate brazil ch5sc2_f955cec5:

#   fy "Please forgive me, Sylph. When I called you little, I really meant cute!"
    fy "Por favor, me perdoe, Sylph. Quando eu te chamei de pequena, na verdade eu quis dizer fofa!"

# game/chapters/chapter5/script/ch5sc2.rpy:1456
translate brazil ch5sc2_68f47781:

#   fy "You’re the most beautiful fae I’ve ever seen!"
    fy "Você é a fada mais linda que eu já vi!"

# game/chapters/chapter5/script/ch5sc2.rpy:1458
translate brazil ch5sc2_17b40770:

#   sy "I’m the only fae you’ve ever seen!"
    sy "Eu sou a única fada que você já viu!"

# game/chapters/chapter5/script/ch5sc2.rpy:1461
translate brazil ch5sc2_39a4a0f9:

#   fy "Tiny detail! ... *Chuckles* Alright, you got me there!"
    fy "Detalhe minúsculo! ... *Risos* Tá bom, você me pegou!"

# game/chapters/chapter5/script/ch5sc2.rpy:1463
translate brazil ch5sc2_dfb9f190:

#   sy "*Laughs* Heh-heh-heh!"
    sy "*Risos* Heh-heh-heh!"

# game/chapters/chapter5/script/ch5sc2.rpy:1465
translate brazil ch5sc2_5fc17ff3:

#   sy "So! Are you guys ready to be amazed?"
    sy "Então! Estão preparados para se surpreender?"

# game/chapters/chapter5/script/ch5sc2.rpy:1466
translate brazil ch5sc2_a1bebd1a:

#   sy "My reveal is sure to dazzle your pants off!"
    sy "Minha revelação com certeza vai te deixar de queixo caído!"

# game/chapters/chapter5/script/ch5sc2.rpy:1468
translate brazil ch5sc2_f6c11514:

#   fy "You bet we are!! Dazzle us!"
    fy "Pode apostar que sim!! Nos deslumbre!"

# game/chapters/chapter5/script/ch5sc2.rpy:1470
translate brazil ch5sc2_11016217:

#   sy "*Excitedly* Four words!"
    sy "*Com entusiasmo* Quatro palavras!"

# game/chapters/chapter5/script/ch5sc2.rpy:1472
translate brazil ch5sc2_644e00f9:

#   sy "Grand Eggtastic Scavenger hunt!"
    sy "Grande Caça ao Tesouro Fantástica!"

# game/chapters/chapter5/script/ch5sc2.rpy:1473
translate brazil ch5sc2_1a587e3e:

#   sy "Or, as I’ve so cleverly dubbed it, the Great Eggathlon!"
    sy "Ou, como eu tão inteligentemente apelidei, a Grande Maratona dos Ovos!"

# game/chapters/chapter5/script/ch5sc2.rpy:1475
translate brazil ch5sc2_bef4cdd2:

#   al "A scavenger hunt? What are we looking for?"
    al "Uma caça ao tesouro? O que estamos procurando?"

# game/chapters/chapter5/script/ch5sc2.rpy:1477
translate brazil ch5sc2_d843fad4:

#   sy "Eggs! Enchanted eggs, to be specific!"
    sy "Ovos! Ovos encantados, para ser mais preciso!"

# game/chapters/chapter5/script/ch5sc2.rpy:1478
translate brazil ch5sc2_025c2475:

#   sy "So if you think you can just bring any regular egg... {b}WRONG!{/b}"
    sy "Então, se você acha que pode simplesmente trazer qualquer ovo comum... {b} ERRADO!{/b}"

# game/chapters/chapter5/script/ch5sc2.rpy:1480
translate brazil ch5sc2_6314ad0f:

#   fy "*Heavy sigh* There goes my plan..."
    fy "*Suspiro pesado* Lá se foi meu plano..."

# game/chapters/chapter5/script/ch5sc2.rpy:1482
translate brazil ch5sc2_2b5af054:

#   mc "Sylph... you really brought us here to search for eggs?"
    mc "Sylph... você realmente nos trouxe aqui para procurar ovos?"

# game/chapters/chapter5/script/ch5sc2.rpy:1484
translate brazil ch5sc2_ff1d7200:

#   al "Oh c’mon! It’ll be fun!"
    al "Ah, vamos lá! Vai ser divertido!"

# game/chapters/chapter5/script/ch5sc2.rpy:1485
translate brazil ch5sc2_285cee11:

#   al "Just like how we used to search for oddly shaped pine cones when we were young!"
    al "Assim como quando procurávamos pinhas com formatos estranhos quando éramos crianças!"

# game/chapters/chapter5/script/ch5sc2.rpy:1487
translate brazil ch5sc2_421eefe8:

#   fy "Oh yeah!"
    fy "Oh sim!"

# game/chapters/chapter5/script/ch5sc2.rpy:1488
translate brazil ch5sc2_5fb8facf:

#   fy "I remember this one pine cone that looked like my balls! Perfectly round!"
    fy "Lembro-me de uma pinha que parecia com os meus testículos! Perfeitamente redonda!"

# game/chapters/chapter5/script/ch5sc2.rpy:1490
translate brazil ch5sc2_2916b587:

#   evr "*Laughs*"
    evr "*Risos*"

# game/chapters/chapter5/script/ch5sc2.rpy:1492
translate brazil ch5sc2_25226f0f:

#   sy "That’s... certainly interesting! But hopefully these won’t look anything like... your balls."
    sy "Isso é... certamente interessante! Mas espero que não se pareçam em nada com... seus testículos."

# game/chapters/chapter5/script/ch5sc2.rpy:1494
translate brazil ch5sc2_30db9fa0:

#   fy "Why do you look so disappointed, Sylph?"
    fy "Por que você parece tão desapontada, Sylph?"

# game/chapters/chapter5/script/ch5sc2.rpy:1497
translate brazil ch5sc2_7c3295b5:

#   sy "Say that one more time and I'll give you actual pine cone balls!"
    sy "Repita isso mais uma vez e eu te dou bolas de pinha de verdade!"

# game/chapters/chapter5/script/ch5sc2.rpy:1498
translate brazil ch5sc2_3d9424e4:

#   fy "*Gulps* S-Sorry!"
    fy "*Engole em seco* D-Desculpe!"

# game/chapters/chapter5/script/ch5sc2.rpy:1500
translate brazil ch5sc2_d47060bb:

#   sy "So... Whaddya say?"
    sy "Então... O que você acha?"

# game/chapters/chapter5/script/ch5sc2.rpy:1501
translate brazil ch5sc2_013c4f14:

#   sy "Are you guys up for putting your adventuring skills to the test?"
    sy "Vocês estão a fim de colocar suas habilidades de aventureiro à prova?"

# game/chapters/chapter5/script/ch5sc2.rpy:1503
translate brazil ch5sc2_2fa2d190:

#   fy "You'd better believe it! I’m great at finding things!"
    fy "Pode acreditar! Sou ótimo em encontrar coisas!"

# game/chapters/chapter5/script/ch5sc2.rpy:1504
translate brazil ch5sc2_d68d707b:

#   ml "Sure, sounds fun!"
    ml "Claro, parece divertido!"

# game/chapters/chapter5/script/ch5sc2.rpy:1506
translate brazil ch5sc2_fa3df786:

#   br "Aye... Sounds like a fun outing!"
    br "Sim... Parece um passeio divertido!"

# game/chapters/chapter5/script/ch5sc2.rpy:1507
translate brazil ch5sc2_2c06f2dd:

#   sy "I know, right? It’s been a yearly tradition in our guild since we founded it!"
    sy "Pois é! É uma tradição anual na nossa guilda desde que a fundamos!"

# game/chapters/chapter5/script/ch5sc2.rpy:1509
translate brazil ch5sc2_128dca9f:

#   al "I call dibs on [mc]! We’ll be the best team!"
    al "Eu reivindico o direito de... [mc]! Nós seremos a melhor equipe!"

# game/chapters/chapter5/script/ch5sc2.rpy:1511
translate brazil ch5sc2_8eb8c397:

#   sy "Sorry, Alice. But there aren't any teams."
    sy "Desculpe, Alice. Mas não há nenhuma equipe."

# game/chapters/chapter5/script/ch5sc2.rpy:1513
translate brazil ch5sc2_8759abda:

#   sy "This is a solo endeavor."
    sy "Este é um empreendimento individual."

# game/chapters/chapter5/script/ch5sc2.rpy:1514
translate brazil ch5sc2_f805caf8:

#   sy "Each of you will have to find your own enchanted egg."
    sy "Cada um de vocês terá que encontrar seu próprio ovo encantado."

# game/chapters/chapter5/script/ch5sc2.rpy:1516
translate brazil ch5sc2_21dd774b:

#   fy "What happens if we find someone else’s egg?"
    fy "O que acontece se encontrarmos o ovo de outra pessoa?"

# game/chapters/chapter5/script/ch5sc2.rpy:1518
translate brazil ch5sc2_7b519a26:

#   sy "You’ll be electrocuted!"
    sy "Você vai levar um choque elétrico!"

# game/chapters/chapter5/script/ch5sc2.rpy:1521
translate brazil ch5sc2_173f4676:

#   sy "So don’t even think about any funny business!"
    sy "Então nem pense em fazer nenhuma gracinha!"

# game/chapters/chapter5/script/ch5sc2.rpy:1523
translate brazil ch5sc2_13f85f44:

#   fy "Yikes. She’s pretty scary for such a small thing."
    fy "Nossa! Ela é bem assustadora para uma coisinha tão pequena."

# game/chapters/chapter5/script/ch5sc2.rpy:1525
translate brazil ch5sc2_638c2c38:

#   br "Lass, how do we know which egg is ours?"
    br "Menina, como sabemos qual ovo é nosso?"

# game/chapters/chapter5/script/ch5sc2.rpy:1526
translate brazil ch5sc2_f9303827:

#   sy "The likelihood of you finding someone else’s egg is incredibly low."
    sy "A probabilidade de você encontrar o ovo de outra pessoa é incrivelmente baixa."

# game/chapters/chapter5/script/ch5sc2.rpy:1527
translate brazil ch5sc2_e3c1bb94:

#   sy "You'll each be given your own clue-"
    sy "Cada um de vocês receberá sua própria pista."

# game/chapters/chapter5/script/ch5sc2.rpy:1529
translate brazil ch5sc2_9c8247f9:

#   sy "-Which is specific to your egg only."
    sy "-O que é específico apenas para o seu ovo."

# game/chapters/chapter5/script/ch5sc2.rpy:1531
translate brazil ch5sc2_c3777a73:

#   al "Since this is a scavenger hunt... will there be prizes?"
    al "Já que se trata de uma caça ao tesouro... haverá prêmios?"

# game/chapters/chapter5/script/ch5sc2.rpy:1533
translate brazil ch5sc2_26bd0f7b:

#   fy "Oh, please say it’s a full evening ticket to ‘The Velvet Pearl’ or ‘Midnight’s Delights’!"
    fy "Ah, por favor, diga que é um ingresso para a noite toda para 'The Velvet Pearl' ou 'Midnight's Delights'!"

# game/chapters/chapter5/script/ch5sc2.rpy:1535
translate brazil ch5sc2_4a5c869a:

#   sy "Keep dreaming, junior!"
    sy "Continue sonhando, garoto!"

# game/chapters/chapter5/script/ch5sc2.rpy:1536
translate brazil ch5sc2_5952f126:

#   sy "There won’t be any midnight delights or velvet pearls when I’m through with you."
    sy "Não haverá mais delícias da meia-noite nem pérolas de veludo quando eu terminar com você."

# game/chapters/chapter5/script/ch5sc2.rpy:1538
translate brazil ch5sc2_d63b3113:

#   fy "I was merely jesting..."
    fy "Eu estava apenas brincando..."

# game/chapters/chapter5/script/ch5sc2.rpy:1541
translate brazil ch5sc2_5dba693a:

#   sy "Yes, there will be prizes for anyone who finds their egg. It’s not a race either."
    sy "Sim, haverá prêmios para quem encontrar seu ovo. E não é uma corrida."

# game/chapters/chapter5/script/ch5sc2.rpy:1542
translate brazil ch5sc2_e3c7deef:

#   sy "All that matters is that you find your egg, and bring it back here before dawn for your reward."
    sy "O importante é que você encontre seu ovo e o traga de volta aqui antes do amanhecer para receber sua recompensa."

# game/chapters/chapter5/script/ch5sc2.rpy:1544
translate brazil ch5sc2_d3787c72:

#   sy "Okay. One by one, speak with me at the door as you leave and I’ll give you your clue!"
    sy "Certo. Um por um, falem comigo na porta ao saírem e eu darei a dica para vocês!"

# game/chapters/chapter5/script/ch5sc2.rpy:1547
translate brazil ch5sc2_d6142794:

#   sy "*Inaudible whisper*"
    sy "*Sussurro inaudível*"

# game/chapters/chapter5/script/ch5sc2.rpy:1551
translate brazil ch5sc2_248ab664:

#   al "*Whispers* {size=-10}{b}I’ll wait for you outside, okay?{/b}{/size}"
    al "*Sussurros* {size=-10}{b}Vou te esperar lá fora, tá bom?{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1553
translate brazil ch5sc2_bb4f6954:

#   mc "*Whispers* {size=-10}{b}We aren’t allowed to work together.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Não nos é permitido trabalhar juntos.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1555
translate brazil ch5sc2_1c9b90c4:

#   al "*Whispers* {size=-10}{b}I know, but I have something I want to show you.{/b}{/size}"
    al "*Sussurros* {size=-10}{b}Eu sei, mas tenho algo que quero te mostrar.{/b}{/size}"

# game/chapters/chapter5/script/ch5sc2.rpy:1559
translate brazil ch5sc2_032bfb02:

#   sy "Okay, your clue is..."
    sy "Certo, a sua dica é..."

# game/chapters/chapter5/script/ch5sc2.rpy:1561
translate brazil ch5sc2_e8eca17d:

#   sy "I rest near the sky but I'm afraid of heights-"
    sy "Eu descanso perto do céu, mas tenho medo de altura."

# game/chapters/chapter5/script/ch5sc2.rpy:1562
translate brazil ch5sc2_06ed2327:

#   sy "Come rescue me, oh great adventurer, before a gust of wind claims me."
    sy "Vem me resgatar, ó grande aventureiro, antes que uma rajada de vento me leve."

# game/chapters/chapter5/script/ch5sc2.rpy:1564
translate brazil ch5sc2_7e2c247e:

#   mc "You really put a lot of effort into this, huh?"
    mc "Você se esforçou bastante nisso, hein?"

# game/chapters/chapter5/script/ch5sc2.rpy:1565
translate brazil ch5sc2_22d6a0f0:

#   syt "{i}He... He noticed?{/i}"
    syt "{i}Ele... Ele percebeu?{/i}"

# game/chapters/chapter5/script/ch5sc2.rpy:1567
translate brazil ch5sc2_99a79878:

#   sy "Sure did! I’m thrilled beyond belief that we're able to continue our traditions with you guys!"
    sy "Com certeza! Estou extremamente feliz por podermos continuar nossas tradições com vocês!"

# game/chapters/chapter5/script/ch5sc2.rpy:1569
translate brazil ch5sc2_75e8b2b6:

#   sy "Things were looking mighty grim at the start of the year, but then you guys came along."
    sy "As coisas pareciam muito sombrias no início do ano, mas aí vocês apareceram."

# game/chapters/chapter5/script/ch5sc2.rpy:1571
translate brazil ch5sc2_4b12a155:

#   sy "And now, look at how our little family has grown!"
    sy "E agora, veja como nossa pequena família cresceu!"

# game/chapters/chapter5/script/ch5sc2.rpy:1572
translate brazil ch5sc2_0add243e:

#   sy "The guild is prosperous for the first time in a long time!"
    sy "A guilda está prosperando pela primeira vez em muito tempo!"

# game/chapters/chapter5/script/ch5sc2.rpy:1573
translate brazil ch5sc2_5a489ad6:

#   sy "We’ve all come together and put in a lot of work, I’m... I’m really glad you’re back."
    sy "Nos unimos e trabalhamos muito, eu... eu estou muito feliz que você esteja de volta."

# game/chapters/chapter5/script/ch5sc2.rpy:1575
translate brazil ch5sc2_b02d3efc:

#   sy "I should have said that the moment you got back."
    sy "Eu deveria ter dito isso assim que você voltou."

# game/chapters/chapter5/script/ch5sc2.rpy:1576
translate brazil ch5sc2_50dc98d4:

#   sy "Let’s talk once you find the egg? Just the two of us."
    sy "Vamos conversar quando você encontrar o ovo? Só nós dois."

# game/chapters/chapter5/script/ch5sc2.rpy:1578
translate brazil ch5sc2_3c7284fe:

