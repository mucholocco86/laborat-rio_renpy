#   mc "No."
    mc "Não."

# game/chapters/chapter2/script/ch2sc11.rpy:72
translate brazil ch2sc11_4424106c:

#   wo "What’s the matter?"
    wo "Qual é o problema?"

# game/chapters/chapter2/script/ch2sc11.rpy:73
translate brazil ch2sc11_7a0869a7:

#   wo "Not used to an attractive woman giving you attention?"
    wo "Não está acostumado a receber atenção de uma mulher atraente?"

# game/chapters/chapter2/script/ch2sc11.rpy:77
translate brazil ch2sc11_4b6b232f:

#   wo "You might be hot, but that doesn't mean you'll get a chance like this again."
    wo "Você pode ser atraente, mas isso não significa que terá outra oportunidade como essa."

# game/chapters/chapter2/script/ch2sc11.rpy:79
translate brazil ch2sc11_e1ceb938:

#   mc "Look, I don't have time for you lady."
    mc "Olha, eu não tenho tempo para você, senhora."

# game/chapters/chapter2/script/ch2sc11.rpy:80
translate brazil ch2sc11_10b90ae1:

#   mc "Yes, I could rock your world for one night. Who cares?"
    mc "Sim, eu poderia te fazer vibrar por uma noite. Quem se importa?"

# game/chapters/chapter2/script/ch2sc11.rpy:82
translate brazil ch2sc11_5a2523ac:

#   wo "You haven’t even heard what I have to offer."
    wo "Você ainda nem ouviu o que eu tenho a oferecer."

# game/chapters/chapter2/script/ch2sc11.rpy:84
translate brazil ch2sc11_8af9c53e:

#   mc "I imagine it's tits and ass? You're nothing special, now back off or I'll put you down."
    mc "Imagino que seja peitos e bunda? Você não é nada de especial, agora se afaste ou eu te acabo com você."

# game/chapters/chapter2/script/ch2sc11.rpy:85
translate brazil ch2sc11_45998769:

#   "Your intimidation failed, but you've gained experience, your {b}{color=#fc584c}Intimidation{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "Sua intimidação falhou, mas você ganhou experiência. {b}{color=#fc584c}Intimidação{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc11.rpy:87
translate brazil ch2sc11_a9a90d44:

#   wo "I don't believe you, you don't look like a man who'd hurt a woman."
    wo "Não acredito em você, você não tem cara de homem que machucaria uma mulher."

# game/chapters/chapter2/script/ch2sc11.rpy:88
translate brazil ch2sc11_66a1b06a:

#   wo "Being with me could change your life kid."
    wo "Estar comigo pode mudar sua vida, garoto."

# game/chapters/chapter2/script/ch2sc11.rpy:91
translate brazil ch2sc11_7837efe7:

#   mc "Answer is still the same."
    mc "A resposta continua a mesma."

# game/chapters/chapter2/script/ch2sc11.rpy:93
translate brazil ch2sc11_30ff82f8:

#   wo "You’re a virgin, is that it? Hah, you wouldn’t be able to handle a real woman."
    wo "Você é virgem, é isso? Hah, você não conseguiria lidar com uma mulher de verdade."

# game/chapters/chapter2/script/ch2sc11.rpy:95
translate brazil ch2sc11_20100852:

#   mc "Go away... shoo!"
    mc "Vai embora... xô!"

# game/chapters/chapter2/script/ch2sc11.rpy:96
translate brazil ch2sc11_eed6622a:

#   mc "Make yourself disappear."
    mc "Faça-se desaparecer."

# game/chapters/chapter2/script/ch2sc11.rpy:98
translate brazil ch2sc11_3674a663:

#   wo "You have some nerve, kid! Most men would beg for my attention."
    wo "Você tem muita audácia, garoto! A maioria dos homens imploraria pela minha atenção."

# game/chapters/chapter2/script/ch2sc11.rpy:100
translate brazil ch2sc11_71586e94:

#   el "Hi babe!"
    el "Oi, amor!"

# game/chapters/chapter2/script/ch2sc11.rpy:102
translate brazil ch2sc11_9a83c1fd:

#   el "There you are! I’ve been looking all over for you."
    el "Finalmente você está aqui! Estava te procurando por toda parte."

# game/chapters/chapter2/script/ch2sc11.rpy:103
translate brazil ch2sc11_9b6ac9f4:

#   el "Typical, you're always sneaking away to the closest tavern!"
    el "Típico, você sempre dá um jeito de escapar para a taverna mais próxima!"

# game/chapters/chapter2/script/ch2sc11.rpy:104
translate brazil ch2sc11_22084e35:

#   el "Hope I didn’t make you wait long."
    el "Espero não ter feito você esperar muito."

# game/chapters/chapter2/script/ch2sc11.rpy:105
translate brazil ch2sc11_aa45e263:

#   mct "Ahh... I see what she's playing at, this might work."
    mct "Ah... entendi o que ela está tramando, isso pode funcionar."

# game/chapters/chapter2/script/ch2sc11.rpy:107
translate brazil ch2sc11_f8fab594:

#   mc "No, it’s fine... honey."
    mc "Não, está tudo bem... querida."

# game/chapters/chapter2/script/ch2sc11.rpy:109
translate brazil ch2sc11_74483d65:

#   wo "I’m sorry miss, I didn’t know he was spoken for."
    wo "Sinto muito, senhora, eu não sabia que ele já tinha dona."

# game/chapters/chapter2/script/ch2sc11.rpy:112
translate brazil ch2sc11_411c23c8:

#   el "Not another word out of you!"
    el "Nem mais uma palavra sua!"

# game/chapters/chapter2/script/ch2sc11.rpy:113
translate brazil ch2sc11_c2566900:

#   el "Find your own man."
    el "Encontre o seu próprio homem."

# game/chapters/chapter2/script/ch2sc11.rpy:115
translate brazil ch2sc11_98834e39:

#   el "Let’s go to our room, handsome!"
    el "Vamos para o nosso quarto, bonitão!"

# game/chapters/chapter2/script/ch2sc11.rpy:117
translate brazil ch2sc11_c3aad319:

#   mc "Sure, beautiful."
    mc "Claro, lindo."

# game/chapters/chapter2/script/ch2sc11.rpy:121
translate brazil ch2sc11_0fd4d656:

#   "......"
    "......"

# game/chapters/chapter2/script/ch2sc11.rpy:123
translate brazil ch2sc11_f4b0c880:

#   wo "Pffft."
    wo "Pfft."

# game/chapters/chapter2/script/ch2sc11.rpy:124
translate brazil ch2sc11_41b6fa5d:

#   wo "That girl doesn’t even hold a candle to a woman like me."
    wo "Aquela garota não chega nem perto de uma mulher como eu."

# game/chapters/chapter2/script/ch2sc11.rpy:127
translate brazil ch2sc11_d9d41bc3:

#   wo "Innkeep! Another ale!"
    wo "Estalajadeiro! Mais uma cerveja!"

