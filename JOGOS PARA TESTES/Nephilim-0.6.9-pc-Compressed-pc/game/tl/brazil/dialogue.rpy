    mc "Que maravilha! Você é uma pessoa matutina."

# game/chapters/chapter5/script/ch5sc12.rpy:29
translate brazil ch5sc12_2665c585:

#   mc "Why are you staring at me like you want to murder me?"
    mc "Por que você está me encarando como se quisesse me matar?"

