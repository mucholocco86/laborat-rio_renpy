translate brazil ch3sc28_34f23bb4:

#   elt "I didn’t see anything! One moment I was walking with Selena-"
    elt "Eu não vi nada! Num instante eu estava caminhando com a Selena..."

# game/chapters/chapter3/script/ch3sc28.rpy:17
translate brazil ch3sc28_55c8b784:

#   ta "Hello, little dove."
    ta "Olá, pombinha."

# game/chapters/chapter3/script/ch3sc28.rpy:20
