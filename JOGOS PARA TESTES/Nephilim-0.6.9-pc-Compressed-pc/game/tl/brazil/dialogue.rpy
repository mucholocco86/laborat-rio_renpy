translate brazil ch6sc2_52e735bb:

#   mc "*Chuckles* Seems you’re familiar with mine as well."
    mc "*Risos* Parece que você também conhece a minha."

# game/chapters/chapter6/ch6sc2.rpy:6852
translate brazil ch6sc2_130c5e33:

#   pl "Heh-heeeh..."
    pl "Heh-heeeh..."

