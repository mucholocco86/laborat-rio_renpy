#   el "*Slurps even louder* {b}MHHH!!{/b}"
    el "*Sorve ainda mais alto* {b} MHHH!!{/b}"

# game/chapters/chapter5/script/ch5sc09.rpy:540
translate brazil ch5sc09_6e11f6a4:

#   mc "*Slurps at maximum volume* {b}MMMM!!{/b}"
    mc "*Sopa em volume máximo* {b} Hummm!!{/b}"

# game/chapters/chapter5/script/ch5sc09.rpy:542
translate brazil ch5sc09_b4cd76bf:

#   el "Jeeez! It’s not a competition, you know?!"
    el "Puxa! Não é uma competição, sabia?!"

# game/chapters/chapter5/script/ch5sc09.rpy:544
translate brazil ch5sc09_69f220fb:

#   mc "Then why were you trying to win?"
    mc "Então por que você estava tentando ganhar?"

# game/chapters/chapter5/script/ch5sc09.rpy:548
translate brazil ch5sc09_0c7fa68d:

#   bth "*Laughing* HahhHaahHhah!!"
    bth "*Risos* HahhHaahHhah!!"

# game/chapters/chapter5/script/ch5sc09.rpy:565
translate brazil ch5sc09_d607f98a:

#   ri "Trail's fresh. She’s just been here."
    ri "A trilha está fresca. Ela acabou de passar por aqui."

# game/chapters/chapter5/script/ch5sc09.rpy:566
translate brazil ch5sc09_cae3deb1:

#   ri "{b}HUH?!!{/b}"
    ri "{b}HUH?!!{/b}"

# game/chapters/chapter5/script/ch5sc09.rpy:579
translate brazil ch5sc09_8da676fd:

#   ri "Close."
    ri "Fechar."

# game/chapters/chapter5/script/ch5sc09.rpy:581
translate brazil ch5sc09_cfb9b302:

#   ri "Element of surprise, lost."
    ri "Elemento surpresa, perdido."

# game/chapters/chapter5/script/ch5sc09.rpy:582
translate brazil ch5sc09_521bff81:

#   ri "Expecting me, hmm."
    ri "Me esperando, hum."

# game/chapters/chapter5/script/ch5sc09.rpy:583
translate brazil ch5sc09_98d16095:

#   ri "There! Found you!"
    ri "Pronto! Te achei!"

# game/chapters/chapter5/script/ch5sc09.rpy:588
translate brazil ch5sc09_0db4b7fd:

#   uk "Hmph! She really thinks that old trick will work on me?"
    uk "Hum! Ela realmente acha que esse truque velho vai funcionar comigo?"

# game/chapters/chapter5/script/ch5sc09.rpy:590
translate brazil ch5sc09_126a22b4:

#   uk "Huh?!"
    uk "Huh?!"

# game/chapters/chapter5/script/ch5sc09.rpy:593
translate brazil ch5sc09_10083f98:

#   uk "That’s new!"
    uk "Isso é novidade!"

# game/chapters/chapter5/script/ch5sc09.rpy:596
translate brazil ch5sc09_aa918b10:

#   "The sound of clashing steel rings out and echoes through the empty streets."
    "O som de aço se chocando ressoa e ecoa pelas ruas vazias."

# game/chapters/chapter5/script/ch5sc09.rpy:597
translate brazil ch5sc09_aaca10f0:

#   uk "HHrrghh!!"
    uk "HHrrghh!!"

# game/chapters/chapter5/script/ch5sc09.rpy:598
translate brazil ch5sc09_0d8db6e9:

#   uk "It’s so good to see you... Rin."
    uk "Que bom te ver... Rin."

# game/chapters/chapter5/script/ch5sc09.rpy:599
translate brazil ch5sc09_ab6ddc47:

#   ri "..."
    ri "..."

# game/chapters/chapter5/script/ch5sc09.rpy:602
translate brazil ch5sc09_d4f55fc1:

#   uk "UrHgh!"
    uk "Urgh!"

# game/chapters/chapter5/script/ch5sc09.rpy:604
translate brazil ch5sc09_850ef2a1:

#   uk "*Snickers* Not happy to see me?"
    uk "*Risos* Não está feliz em me ver?"

# game/chapters/chapter5/script/ch5sc09.rpy:605
translate brazil ch5sc09_64a6ca32:

#   uk "Shame. 'Cause I’ve been so looking forward to our reunion... Rin."
    uk "Que pena. Porque eu estava tão ansiosa pelo nosso reencontro... Rin."

# game/chapters/chapter5/script/ch5sc09.rpy:607
translate brazil ch5sc09_79e4cd7f:

#   ri "Why are you here?"
    ri "Por que você está aqui?"

# game/chapters/chapter5/script/ch5sc09.rpy:608
translate brazil ch5sc09_25ad1587:

#   ri "Viperia."
    ri "Víbora."

# game/chapters/chapter5/script/ch5sc09.rpy:609
translate brazil ch5sc09_a3c86614:

#   vi "Ahh... So you do remember me."
    vi "Ah... Então você se lembra de mim."

# game/chapters/chapter5/script/ch5sc09.rpy:612
translate brazil ch5sc09_600941af:

#   vi "Was it the trail of bodies that gave me away? Has my bounty grown large enough to catch the attention of a Shado-Jin?"
    vi "Será que foi o rastro de corpos que me entregou? Será que minha recompensa cresceu o suficiente para chamar a atenção de um Shado-Jin?"

# game/chapters/chapter5/script/ch5sc09.rpy:613
translate brazil ch5sc09_76a3f63a:

#   rit "{i}She’s quick!{/i}"
    rit "{i}Ela é rápida!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:614
translate brazil ch5sc09_4d96b7d8:

#   vi "Made you look!"
    vi "Te peguei!"

# game/chapters/chapter5/script/ch5sc09.rpy:617
translate brazil ch5sc09_d4c267d4:

#   ri "Aaahh!"
    ri "Aaahh!"

# game/chapters/chapter5/script/ch5sc09.rpy:619
translate brazil ch5sc09_32e5e0a9:

#   vi "Tsk... Rin. This is so unlike you. Has seeing me again shaken you, by any chance?"
    vi "Tsc... Rin. Isso não é nada típico de você. Por acaso, me ver de novo te abalou?"

# game/chapters/chapter5/script/ch5sc09.rpy:620
translate brazil ch5sc09_2726cde1:

#   vi "You were top of our class during training. Everyone envied you. Everyone wanted to be you."
    vi "Você foi o melhor da turma durante o treinamento. Todos te invejavam. Todos queriam ser você."

# game/chapters/chapter5/script/ch5sc09.rpy:622
translate brazil ch5sc09_a8d2d6b2:

#   vi "But then you just vanished right before our graduation."
    vi "Mas aí você simplesmente desapareceu bem antes da nossa formatura."

# game/chapters/chapter5/script/ch5sc09.rpy:623
translate brazil ch5sc09_02abc47d:

#   vi "You basically spat in everyone’s faces! Did you think you were better than us? Is that why you left?"
    vi "Basicamente, você cuspiu na cara de todo mundo! Achou que era melhor do que nós? Foi por isso que você foi embora?"

# game/chapters/chapter5/script/ch5sc09.rpy:625
translate brazil ch5sc09_915d5141:

#   vi "No, I don’t think that's it. That kind of thinking isn't convoluted enough for you."
    vi "Não, acho que não é isso. Esse tipo de raciocínio não é complexo o suficiente para você."

# game/chapters/chapter5/script/ch5sc09.rpy:626
translate brazil ch5sc09_46417dcb:

#   vi "You left the Society of Shadows to become a Shado-Jin. And let’s be honest about that... it's quite the downgrade."
    vi "Você deixou a Sociedade das Sombras para se tornar um Shado-Jin. E sejamos honestos... é um retrocesso e tanto."

# game/chapters/chapter5/script/ch5sc09.rpy:628
translate brazil ch5sc09_f01fe322:

#   vi "You could’ve changed the world with us, but instead you became a glorified mercenary. But why?"
    vi "Você poderia ter mudado o mundo conosco, mas em vez disso se tornou um mercenário glorificado. Mas por quê?"

# game/chapters/chapter5/script/ch5sc09.rpy:632
translate brazil ch5sc09_f8fe44df:

#   vi "Getting close, am I?"
    vi "Estou quase lá, não é?"

# game/chapters/chapter5/script/ch5sc09.rpy:634
translate brazil ch5sc09_ee87d266:

#   vi "Don’t tell me it was all because you wanted freedom?"
    vi "Não me diga que tudo isso foi porque você queria liberdade?"

# game/chapters/chapter5/script/ch5sc09.rpy:635
translate brazil ch5sc09_ee45d505:

#   vi "Freedom to follow your heart? You should know better, Rin... freedom is an illusion!"
    vi "Liberdade para seguir o coração? Você deveria saber disso, Rin... a liberdade é uma ilusão!"

# game/chapters/chapter5/script/ch5sc09.rpy:638
translate brazil ch5sc09_7bf54c6a:

#   vi "Hnngh!"
    vi "Hnngh!"

# game/chapters/chapter5/script/ch5sc09.rpy:641
translate brazil ch5sc09_d2e21071:

#   vi "I remember you telling me about a boy once..."
    vi "Lembro-me de você me contando sobre um menino uma vez..."

# game/chapters/chapter5/script/ch5sc09.rpy:644
translate brazil ch5sc09_2a50cd8c:

#   vi "Is that why you left? To find your little boyfriend?"
    vi "Foi por isso que você foi embora? Para encontrar seu namoradinho?"

# game/chapters/chapter5/script/ch5sc09.rpy:648
translate brazil ch5sc09_49565007:

#   vi "Tsk! Your silence is answer enough."
    vi "Tsc! Seu silêncio já é resposta suficiente."

# game/chapters/chapter5/script/ch5sc09.rpy:649
translate brazil ch5sc09_dafae6b5:

#   rit "{i}This is bad!{/i}"
    rit "{i}Isso é ruim!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:651
translate brazil ch5sc09_22830883:

#   vi "You may have been top of the trainees, but nobody’s ever bested me in grappling!"
    vi "Você pode ter sido o melhor dos estagiários, mas ninguém nunca me venceu na luta agarrada!"

# game/chapters/chapter5/script/ch5sc09.rpy:652
translate brazil ch5sc09_a7b45b68:

#   rit "{i}She’s right... If we stay on the ground, I’ll lose.{/i}"
    rit "{i}Ela tem razão... Se ficarmos no chão, eu vou perder.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:654
translate brazil ch5sc09_b419af4e:

#   vi "Ah-Ah-Ah! You’re not getting away!"
    vi "Ah-ah-ah! Você não vai escapar!"

# game/chapters/chapter5/script/ch5sc09.rpy:655
translate brazil ch5sc09_7e1ffd11:

#   vi "You know... I was pleased when I was the one assigned to eliminate you."
    vi "Sabe... fiquei contente quando me designaram para te eliminar."

# game/chapters/chapter5/script/ch5sc09.rpy:657
translate brazil ch5sc09_db148ec6:

#   vi "You’re the first to walk away from the Society of Shadows and live."
    vi "Você é o primeiro a se afastar da Sociedade das Sombras e sobreviver."

# game/chapters/chapter5/script/ch5sc09.rpy:658
translate brazil ch5sc09_ec10297a:

#   vi "Which, I’m sure you must realize, is something that we simply can’t have."
    vi "O que, tenho certeza que você já deve ter percebido, é algo que simplesmente não podemos ter."

# game/chapters/chapter5/script/ch5sc09.rpy:659
translate brazil ch5sc09_d1dbc2a4:

#   vi "But I must admit... this boyfriend of yours intrigues me."
    vi "Mas devo admitir... esse seu namorado me intriga."

# game/chapters/chapter5/script/ch5sc09.rpy:662
translate brazil ch5sc09_d7ed0e73:

#   "Rin manages to block the kunai blade before it can slice her thigh."
    "Rin consegue bloquear a lâmina da kunai antes que ela possa cortar sua coxa."

# game/chapters/chapter5/script/ch5sc09.rpy:663
translate brazil ch5sc09_7f3e5c7c:

#   rit "{i}Going for the major arteries. Trying to kill me.{/i}"
    rit "{i}Atacando as artérias principais. Tentando me matar.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:666
translate brazil ch5sc09_d3c30b78:

#   vi "Just give it up already! You know you can’t beat me!"
    vi "Desista logo! Você sabe que não pode me vencer!"

# game/chapters/chapter5/script/ch5sc09.rpy:667
translate brazil ch5sc09_948856cc:

#   rit "{i}*Groans* Urhh!! Now's my chance!{/i}"
    rit "{i}*Geme* Urhh!! Agora é minha chance!{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:670
translate brazil ch5sc09_9e6ef3d2:

#   ri "*Shouting* {b}GET...{/b}"
    ri "*Gritando* {b} PEGAR...{/b}"

# game/chapters/chapter5/script/ch5sc09.rpy:673
translate brazil ch5sc09_763cc21e:

#   ri "*Shouting* ... {b}OFF ME!!{/b}"
    ri "*Gritando* ... {b} SAI DE CIMA DE MIM!!{/b}"

# game/chapters/chapter5/script/ch5sc09.rpy:674
translate brazil ch5sc09_d5b6c0a7:

#   vi "Hnnrrgh!"
    vi "Hnnrrgh!"

# game/chapters/chapter5/script/ch5sc09.rpy:676
translate brazil ch5sc09_6522a018:

#   rit "Managed to deflect her kunai with my arm, just in time."
    rit "Consegui desviar a kunai dela com o braço, bem a tempo."

# game/chapters/chapter5/script/ch5sc09.rpy:677
translate brazil ch5sc09_95381ed3:

#   rit "she was going straight for my throat!"
    rit "Ela estava indo direto para a minha garganta!"

# game/chapters/chapter5/script/ch5sc09.rpy:678
translate brazil ch5sc09_5df1e080:

#   rit "{i}Hnrrhh... it stings.{/i}"
    rit "{i}Hnrrhh... dói.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:679
translate brazil ch5sc09_d8f801b7:

#   rit "{i}Have to end this quickly. She's going for the kill. One mistake, and it’ll be over for me.{/i}"
    rit "{i}Preciso acabar com isso logo. Ela está partindo para o ataque. Um erro, e tudo acaba para mim.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:680
translate brazil ch5sc09_feb41362:

#   rit "{i}[mc]... I’ll use our move.{/i}"
    rit "{i}[mc]... Vou usar nossa jogada.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:682
translate brazil ch5sc09_a3557c30:

#   "*Running steps approaching*"
    "*Passos de corrida se aproximando*"

# game/chapters/chapter5/script/ch5sc09.rpy:683
translate brazil ch5sc09_417c6b58:

#   rit "{i}Winds guide me.{/i}"
    rit "{i}Os ventos me guiam.{/i}"

# game/chapters/chapter5/script/ch5sc09.rpy:686
translate brazil ch5sc09_0d65a4c9:

#   vi "Urgh!"
    vi "Urgh!"

# game/chapters/chapter5/script/ch5sc09.rpy:688
translate brazil ch5sc09_f7034e68:

#   vi "This won’t help you, Rin... I know you."
    vi "Isso não vai te ajudar, Rin... Eu te conheço."

# game/chapters/chapter5/script/ch5sc09.rpy:689
translate brazil ch5sc09_42326b35:

#   vi "Do you really think that'll work on me again?"
    vi "Você acha mesmo que isso vai funcionar comigo de novo?"

# game/chapters/chapter5/script/ch5sc09.rpy:691
translate brazil ch5sc09_d782156f:

#   vi "There she is!"
    vi "Ali está ela!"

# game/chapters/chapter5/script/ch5sc09.rpy:694
translate brazil ch5sc09_bf015052:

#   vi "HUH?!"
    vi "HUH?!"

# game/chapters/chapter5/script/ch5sc09.rpy:695
translate brazil ch5sc09_cedd0d9a:

#   ri "Made you look!"
    ri "Te peguei!"

# game/chapters/chapter5/script/ch5sc09.rpy:698
translate brazil ch5sc09_819d6837:

#   vi "*Groans* UurHh!!"
    vi "*Gemidos* UurHh!!"

# game/chapters/chapter5/script/ch5sc09.rpy:700
translate brazil ch5sc09_7e4f360f:

#   vi "Hnnghh... How did you?"
    vi "Hnnghh... Como você fez isso?"

# game/chapters/chapter5/script/ch5sc09.rpy:703
translate brazil ch5sc09_568a85a5:

#   vi "Rin! Please! Don’t do this! We... we’re sisters of the Society!"
    vi "Rin! Por favor! Não faça isso! Nós... nós somos irmãs da Sociedade!"

# game/chapters/chapter5/script/ch5sc09.rpy:706
translate brazil ch5sc09_cd81763b:

#   vi "We spent years training together at the hideout! We’re Shadow Sisters!"
    vi "Passamos anos treinando juntas no esconderijo! Somos Irmãs das Sombras!"

# game/chapters/chapter5/script/ch5sc09.rpy:707
translate brazil ch5sc09_287a2c30:

#   ri "Sisters?"
    ri "Irmãs?"

# game/chapters/chapter5/script/ch5sc09.rpy:708
translate brazil ch5sc09_70c080da:

#   ri "Three times... three times you’ve tried to kill me."
    ri "Três vezes... três vezes você tentou me matar."

# game/chapters/chapter5/script/ch5sc09.rpy:710
translate brazil ch5sc09_1f4090c3:

#   vi "It was a mistake! I see that now..."
    vi "Foi um erro! Agora eu percebo..."

# game/chapters/chapter5/script/ch5sc09.rpy:711
translate brazil ch5sc09_2fd137a7:

#   vi "I-I could abandon the Society, just like you did! We could both be Shado-Jins!"
    vi "Eu poderia abandonar a Sociedade, assim como você fez! Nós dois poderíamos ser Shado-Jins!"

# game/chapters/chapter5/script/ch5sc09.rpy:713
translate brazil ch5sc09_c4316ddf:

#   ri "Always been a snake, Viperia."
    ri "Sempre foi uma cobra, Viperia."

# game/chapters/chapter5/script/ch5sc09.rpy:714
translate brazil ch5sc09_cc6d284f:

#   ri "Killing Kito with hemlock venom, I remember."
    ri "Lembro-me de ter matado Kito com veneno de cicuta."

# game/chapters/chapter5/script/ch5sc09.rpy:715
translate brazil ch5sc09_15f341f4:

#   ri "Pointed the finger at Ari, by planting the venom in her room."
    ri "Apontou o dedo para Ari, plantando o veneno em seu quarto."

# game/chapters/chapter5/script/ch5sc09.rpy:716
translate brazil ch5sc09_de23ddb3:

#   ri "Just like that, the two trainees ahead of you were eliminated."
    ri "Assim, sem mais nem menos, os dois estagiários à sua frente foram eliminados."

# game/chapters/chapter5/script/ch5sc09.rpy:717
translate brazil ch5sc09_af85705b:

#   ri "Bye, Viperia."
    ri "Tchau, Viper."

# game/chapters/chapter5/script/ch5sc09.rpy:731
translate brazil ch5sc09_a63dba2c:

#   rit "W-What? I-I can’t move?"
    rit "O quê? Eu não consigo me mexer?"

# game/chapters/chapter5/script/ch5sc09.rpy:732
translate brazil ch5sc09_232da5bc:

#   vi "*Snickers* You finally feel it, don’t you? It takes a little time to set in, but once it does... the effects are uncanny."
    vi "*Risos* Finalmente você sentiu, não é? Leva um tempinho para fazer efeito, mas quando faz... os efeitos são impressionantes."

# game/chapters/chapter5/script/ch5sc09.rpy:734
translate brazil ch5sc09_cbba03c1:

#   vi "You can blame your incompetence on the fact that you left."
    vi "Você pode atribuir sua incompetência ao fato de ter ido embora."

# game/chapters/chapter5/script/ch5sc09.rpy:735
translate brazil ch5sc09_b4cc4957:

#   vi "You never got to experience being injected with various poisons and toxins."
    vi "Você nunca teve a experiência de ser injetado com vários venenos e toxinas."

# game/chapters/chapter5/script/ch5sc09.rpy:737
translate brazil ch5sc09_71bd678c:

#   vi "All it takes is one drop of wyvern venom in your bloodstream, and it’s game over."
    vi "Basta uma gota de veneno de wyvern na sua corrente sanguínea para que o jogo acabe."

# game/chapters/chapter5/script/ch5sc09.rpy:738
translate brazil ch5sc09_aa401bf8:

#   vi "You see, it paralyzes the entire nervous system. Which is why you can’t even speak right now, let alone move."
    vi "Veja bem, isso paralisa todo o sistema nervoso. É por isso que você não consegue nem falar agora, muito menos se mexer."

# game/chapters/chapter5/script/ch5sc09.rpy:740
translate brazil ch5sc09_85623541:

#   vi "Which is just the way I prefer you... silent and obedient."
    vi "É exatamente assim que eu prefiro você... silenciosa e obediente."

# game/chapters/chapter5/script/ch5sc09.rpy:741
translate brazil ch5sc09_39088b9d:

#   vi "Now, listen up... here’s what I'm going to do."
    vi "Agora, escutem bem... é o seguinte: vou fazer o seguinte."

# game/chapters/chapter5/script/ch5sc09.rpy:743
translate brazil ch5sc09_4ece16b7:

#   vi "I’ll kill you here and now, putting an end to your miserable life. You’re a disgrace to the society."
    vi "Vou te matar aqui e agora, pondo fim à sua vida miserável. Você é uma vergonha para a sociedade."

# game/chapters/chapter5/script/ch5sc09.rpy:744
translate brazil ch5sc09_bf880dff:

#   vi "But for my own personal twist... I think I'm going to locate that boyfriend of yours. The one you're still so desperate to find."
    vi "Mas, para dar o meu toque pessoal... acho que vou localizar aquele seu namorado. Aquele que você ainda está tão desesperada para encontrar."

# game/chapters/chapter5/script/ch5sc09.rpy:747
translate brazil ch5sc09_83cf706b:

#   ri "*Mumbling* MHH!! MhrhHH! {b}NNGHH!!{/b}"
    ri "*Murmúrios* MHH!! MhrhHH! {b} NNGHH!!{/b}"

# game/chapters/chapter5/script/ch5sc09.rpy:748
translate brazil ch5sc09_aa18b695:

#   vi "*Snickers* Oh? You don’t like the idea of me meeting him?"
    vi "*Risos* Ah? Você não gosta da ideia de eu conhecê-lo?"

# game/chapters/chapter5/script/ch5sc09.rpy:749
translate brazil ch5sc09_72560eb8:

#   vi "Then knowing what comes next will drive you absolutely and infinitely insane! *Laughs*"
    vi "Saber o que vem a seguir vai te deixar completamente e infinitamente louco! *Risos*"

# game/chapters/chapter5/script/ch5sc09.rpy:751
