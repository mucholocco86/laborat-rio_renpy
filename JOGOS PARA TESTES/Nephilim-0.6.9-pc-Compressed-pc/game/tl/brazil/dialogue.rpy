    am "Sem surpresas. Primeira vez hospedado na casa de um nobre, não é?"

# game/chapters/chapter5/script/ch5sc12.rpy:76
translate brazil ch5sc12_716019b8:

#   mc "Right."
    mc "Certo."

# game/chapters/chapter5/script/ch5sc12.rpy:77
translate brazil ch5sc12_7b3185f2:

#   am "Don’t worry. I’ll make sure you get to spend more nights here in the future."
    am "Não se preocupe. Vou garantir que você passe mais noites aqui no futuro."

# game/chapters/chapter5/script/ch5sc12.rpy:78
translate brazil ch5sc12_eee4bff0:

#   am "Y-You know... for work purposes."
