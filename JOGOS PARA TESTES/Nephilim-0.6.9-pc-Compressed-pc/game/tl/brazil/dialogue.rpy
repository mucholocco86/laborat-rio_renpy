# game/chapters/chapter5/script/ch5sc11.rpy:2081
translate brazil ch5sc11_4cc750df:

#   qmt "Seeing him escort Amelia... Leading her in her last dance..."
    qmt "Vê-lo escoltar Amelia... Conduzi-la em sua última dança..."

# game/chapters/chapter5/script/ch5sc11.rpy:2082
translate brazil ch5sc11_a4629053:

#   qmt "He was so gallant... so... striking. All the ladies of the court were whispering about him."
