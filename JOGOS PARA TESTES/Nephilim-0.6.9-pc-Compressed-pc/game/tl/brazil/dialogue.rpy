translate brazil ch7sc1_06dcc903:

#   lu "Besides… [mc] is bound to be impressed if we help out at the guild. *Snickers*"
    lu "Além do mais… [mc] Com certeza ficará impressionado se ajudarmos na guilda. *Risos*"

