#   mc "Or else what?"
    mc "Ou o quê?"

# game/chapters/chapter5/script/ch5sc10.rpy:1842
translate brazil ch5sc10_3a07072b:

#   lu "I’ll have to... take action."
    lu "Terei que... tomar uma atitude."

# game/chapters/chapter5/script/ch5sc10.rpy:1844
translate brazil ch5sc10_09f2de35:

#   mc "Is that so?"
    mc "É assim mesmo?"

# game/chapters/chapter5/script/ch5sc10.rpy:1845
translate brazil ch5sc10_7913c252:

#   mc "Maybe I should take action first, then?"
    mc "Talvez eu devesse tomar uma atitude primeiro, então?"

# game/chapters/chapter5/script/ch5sc10.rpy:1847
translate brazil ch5sc10_bd12a787:

#   lu "*Whispers* {size=-10}{b}Mppphh!! Stop it! Mnhh ... She’s looking right at us!{/b}{/size}"
    lu "*Sussurros* {size=-10}{b}Mppphh!! Pare com isso! Mnhh... Ela está olhando diretamente para nós!{/b}{/size}"

# game/chapters/chapter5/script/ch5sc10.rpy:1848
translate brazil ch5sc10_99fb0394:

#   mc "*Whispers* {size=-10}{b}Why so flustered, Luna? Are you getting excited?{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Por que está tão agitada, Luna? Está ficando animada?{/b}{/size}"

# game/chapters/chapter5/script/ch5sc10.rpy:1849
translate brazil ch5sc10_eadf7bef:

#   lu "*Whispers* {size=-10}{b}No. Y-You’re wrong... I’m-I’m not feeling flustered! Mnhh...{/b}{/size}"
    lu "*Sussurros* {size=-10}{b}Não. V-Você está errado... Eu... Eu não estou me sentindo constrangido! Mnhh...{/b}{/size}"

# game/chapters/chapter5/script/ch5sc10.rpy:1852
translate brazil ch5sc10_a672312c:

#   lu "*Whispers* {size=-10}{b}You’ve no idea what you just started... Just you wait!{/b}{/size}"
    lu "*Sussurros* {size=-10}{b}Você não faz ideia do que acabou de começar... Espere só para ver!{/b}{/size}"

# game/chapters/chapter5/script/ch5sc10.rpy:1853
translate brazil ch5sc10_8b3ec032:

#   "Luna enjoys being playful with you, her trust has increased by {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."
    "Luna gosta de brincar com você, e a confiança dela aumentou bastante. {size=+3}{b}{color=#2bff8b}2{/color}{/b}{/size}."

# game/chapters/chapter5/script/ch5sc10.rpy:1857
translate brazil ch5sc10_b6423835:

#   mc "Heh, alright, alright."
    mc "Heh, tudo bem, tudo bem."

# game/chapters/chapter5/script/ch5sc10.rpy:1860
translate brazil ch5sc10_b73c10d8:

#   cas "Shouldn’t you two be getting to the palace? The celebration is due to start any moment."
    cas "Vocês dois não deveriam estar indo para o palácio? A celebração deve começar a qualquer momento."

# game/chapters/chapter5/script/ch5sc10.rpy:1861
translate brazil ch5sc10_2e102c43:

#   cas "I obviously shouldn’t make an appearance tonight. Taron probably already knows I’ve escaped..."
    cas "Obviamente, não devo aparecer esta noite. Taron provavelmente já sabe que eu escapei..."

# game/chapters/chapter5/script/ch5sc10.rpy:1863
translate brazil ch5sc10_fe8ce661:

#   cas "But he has no idea how, or where I can be found."
    cas "Mas ele não tem ideia de como ou onde me encontrar."

# game/chapters/chapter5/script/ch5sc10.rpy:1864
translate brazil ch5sc10_45003612:

#   cas "I’d like to keep it that way. At least for now."
    cas "Gostaria que continuasse assim. Pelo menos por enquanto."

# game/chapters/chapter5/script/ch5sc10.rpy:1866
translate brazil ch5sc10_1bf60051:

#   mc "Of course."
    mc "Claro."

# game/chapters/chapter5/script/ch5sc10.rpy:1867
translate brazil ch5sc10_67e8a695:

#   mc "Cassandra, I need to talk to you more about Taron, at some point."
    mc "Cassandra, preciso conversar mais com você sobre Taron, em algum momento."

# game/chapters/chapter5/script/ch5sc10.rpy:1869
translate brazil ch5sc10_1e6eb61f:

#   cas "Once everything quiets down, I'll be happy to tell you what I know."
    cas "Assim que tudo se acalmar, terei prazer em lhe contar o que sei."

# game/chapters/chapter5/script/ch5sc10.rpy:1871
translate brazil ch5sc10_c89da687:

#   mc "Thank you, I appreciate that."
    mc "Obrigado, agradeço."

# game/chapters/chapter5/script/ch5sc10.rpy:1873
translate brazil ch5sc10_3526097a:

#   mc "Shall we?"
    mc "Devemos nós?"

# game/chapters/chapter5/script/ch5sc10.rpy:1874
translate brazil ch5sc10_7071b19d:

#   lu "You go ahead, I’ll meet you there."
    lu "Pode ir em frente, eu te encontro lá."

# game/chapters/chapter5/script/ch5sc10.rpy:1875
translate brazil ch5sc10_0d40e46c:

#   lu "I’ve gotta change real quick."
    lu "Preciso me trocar rapidinho."

# game/chapters/chapter5/script/ch5sc10.rpy:1876
translate brazil ch5sc10_ce22340e:

#   mc "Sure. I'll see you there then."
    mc "Claro. Te vejo lá então."

# game/chapters/chapter5/script/ch5sc10.rpy:1895
translate brazil ch5sc10_aa4b0cc4:

#   da "Looks like a lot of people have already arrived."
    da "Parece que muita gente já chegou."

# game/chapters/chapter5/script/ch5sc10.rpy:1914
translate brazil ch5sc10_1f5488e2:

#   elt "I can’t believe I’m standing in the royal palace!!"
    elt "Não acredito que estou no palácio real!!"

# game/chapters/chapter5/script/ch5sc10.rpy:1915
translate brazil ch5sc10_8538bdf4:

#   elt "There are so many people here already."
    elt "Já tem muita gente aqui."

# game/chapters/chapter5/script/ch5sc10.rpy:1930
translate brazil ch5sc10_0026e8c2:

#   mc "Hey... You ready?"
    mc "Ei... Você está pronto?"

# game/chapters/chapter5/script/ch5sc10.rpy:1932
translate brazil ch5sc10_3fe154fe:

#   am "[mc], Hi... You decided to accept my invitation!"
    am "[mc] Olá... Você decidiu aceitar meu convite!"

# game/chapters/chapter5/script/ch5sc10.rpy:1934
translate brazil ch5sc10_197577b7:

#   mc "I wasn’t about to miss out on your 20th name day..."
    mc "Eu não ia perder por nada o seu 20º aniversário..."

# game/chapters/chapter5/script/ch5sc10.rpy:1935
translate brazil ch5sc10_3e57894a:

#   mc "Besides, it's not every day you get a personal invitation from a princess."
    mc "Além disso, não é todo dia que se recebe um convite pessoal de uma princesa."

# game/chapters/chapter5/script/ch5sc10.rpy:1937
translate brazil ch5sc10_3cd7d5a0:

#   am "No... It certainly isn't. *Giggles softly*"
    am "Não... Certamente que não. *Risinhos suaves*"

# game/chapters/chapter5/script/ch5sc10.rpy:1940
translate brazil ch5sc10_0c0c8f7c:

#   mc "Feeling nervous?"
    mc "Está se sentindo nervoso(a)?"

# game/chapters/chapter5/script/ch5sc10.rpy:1942
translate brazil ch5sc10_ebd81d1c:

#   am "No..."
    am "Não..."

# game/chapters/chapter5/script/ch5sc10.rpy:1943
translate brazil ch5sc10_9daaee31:

#   am "Maybe a little? ... But it’s better now that you’re here."
    am "Talvez um pouco? ... Mas agora que você está aqui, está melhor."

# game/chapters/chapter5/script/ch5sc10.rpy:1945
translate brazil ch5sc10_9108a245:

#   mc "Don’t worry, I’ll be here all night."
    mc "Não se preocupe, estarei aqui a noite toda."

# game/chapters/chapter5/script/ch5sc10.rpy:1946
translate brazil ch5sc10_caea6b0f:

#   mc "You look beautiful, by the way."
    mc "Aliás, você está linda."

# game/chapters/chapter5/script/ch5sc10.rpy:1948
translate brazil ch5sc10_8da54016:

#   am "T-Thank you."
    am "O-Obrigado."

# game/chapters/chapter5/script/ch5sc10.rpy:1949
translate brazil ch5sc10_e74ad1b1:

#   am "You too."
    am "Você também."

# game/chapters/chapter5/script/ch5sc10.rpy:1950
translate brazil ch5sc10_85b657f9:

#   am "I mean... you look handsome tonight."
    am "Quer dizer... você está bonito esta noite."

# game/chapters/chapter5/script/ch5sc10.rpy:1953
translate brazil ch5sc10_f03f6a17:

#   am "*Nods* Mhm."
    am "*Acena com a cabeça* Hum."

# game/chapters/chapter5/script/ch5sc10.rpy:1419
translate brazil ch5sc10_8d0bf45f_1:

#   wo "Your Grace."
    wo "Vossa Graça."

# game/chapters/chapter5/script/ch5sc10.rpy:1696
translate brazil ch5sc10_59bd1f0e_1:

#   sy "Let’s get dressed, you don't have long before you have to be at the royal celebration."
    sy "Vamos nos vestir, você não tem muito tempo antes de ter que estar na celebração real."

# game/chapters/chapter5/script/ch5sc10.rpy:1939
translate brazil ch5sc10_1c8acf17_1:

#   am "..."
    am "..."

# game/chapters/chapter5/script/ch5sc10.rpy:1952
translate brazil ch5sc10_3526097a_1:

#   mc "Shall we?"
    mc "Devemos nós?"



# ARQUIVO: game/chapters/chapter2/script/ch2sc17.rpy DIALOGOS: 117


# game/chapters/chapter2/script/ch2sc17.rpy:12
translate brazil ch2sc17_e883b250:

#   mct "I didn’t see Gibs at the tavern last night. Maybe he doesn’t even live here anymore?"
    mct "Não vi o Gibs na taverna ontem à noite. Será que ele nem mora mais aqui?"

# game/chapters/chapter2/script/ch2sc17.rpy:15
translate brazil ch2sc17_47147f72:

#   mct "I wonder how he's doing?"
    mct "Gostaria de saber como ele está."

# game/chapters/chapter2/script/ch2sc17.rpy:16
translate brazil ch2sc17_ea6c2e52:

#   mct "He was always a big softy on the inside... The thing with my parents though..."
    mct "Ele sempre foi um grande sentimental por dentro... Mas o problema com meus pais..."

# game/chapters/chapter2/script/ch2sc17.rpy:18
translate brazil ch2sc17_427395d7:

#   mct "That must have hit him hard."
    mct "Isso deve tê-lo afetado bastante."

# game/chapters/chapter2/script/ch2sc17.rpy:19
translate brazil ch2sc17_11d5e8c4:

#   mct "He and papa were best friends ever since their youth, and he adored mama."
    mct "Ele e o papai eram melhores amigos desde a juventude, e ele adorava a mamãe."

# game/chapters/chapter2/script/ch2sc17.rpy:21
translate brazil ch2sc17_ab3dfe9c:

#   mct "So often I've wanted to visit you and tell you everything Gibs."
    mct "Quantas vezes eu quis te visitar e te contar tudo, Gibs."

# game/chapters/chapter2/script/ch2sc17.rpy:22
translate brazil ch2sc17_4d851f2e:

#   mct "I-I..."
    mct "II..."

# game/chapters/chapter2/script/ch2sc17.rpy:24
translate brazil ch2sc17_fdf0b66d:

#   mct "Arhh! Whatever."
    mct "Ah! Tanto faz."

# game/chapters/chapter2/script/ch2sc17.rpy:25
translate brazil ch2sc17_0eeff25a:

#   mct "What's done is done, nobody can change the past..."
    mct "O que está feito, está feito, ninguém pode mudar o passado..."

# game/chapters/chapter2/script/ch2sc17.rpy:31
translate brazil ch2sc17_e8288f82:

#   mct "*Chuckles* His place still looks the same."
    mct "*Risos* O apartamento dele continua igual."

# game/chapters/chapter2/script/ch2sc17.rpy:33
translate brazil ch2sc17_533f0980:

#   mct "Here goes nothing."
    mct "Vamos lá."

# game/chapters/chapter2/script/ch2sc17.rpy:37
translate brazil ch2sc17_66ee747b:

#   mc "Hey Gibs! Are you here old man?"
    mc "Ei, Gibs! Você está aí, velho?"

# game/chapters/chapter2/script/ch2sc17.rpy:47
translate brazil ch2sc17_dee95575:

#   mct "Rats! I was hoping to speak to him before we left."
    mct "Que droga! Eu esperava falar com ele antes de irmos embora."

# game/chapters/chapter2/script/ch2sc17.rpy:49
translate brazil ch2sc17_b5d3e425:

#   mct "Since he isn’t here... hmm... I’ll go ask Clark if he knows anything."
    mct "Já que ele não está aqui... hum... vou perguntar ao Clark se ele sabe de alguma coisa."

# game/chapters/chapter2/script/ch2sc17.rpy:56
translate brazil ch2sc17_f0562c40:

#   gb "Huh?"
    gb "Huh?"

# game/chapters/chapter2/script/ch2sc17.rpy:57
translate brazil ch2sc17_1e772480:

#   gb "[mc]! It’s really you?"
    gb "[mc] É você mesmo?"

# game/chapters/chapter2/script/ch2sc17.rpy:61
translate brazil ch2sc17_2f46ca84:

#   mc "Hey, Old Bear."
    mc "Ei, Urso Velho."

# game/chapters/chapter2/script/ch2sc17.rpy:64
translate brazil ch2sc17_3be2c998:

#   gb "Come here, you little rascal!"
    gb "Vem cá, seu pestinha!"

# game/chapters/chapter2/script/ch2sc17.rpy:66
translate brazil ch2sc17_213e48d0:

#   mct "Oh no... brace for impact!"
    mct "Oh não... prepare-se para o impacto!"

# game/chapters/chapter2/script/ch2sc17.rpy:69
translate brazil ch2sc17_b50e6c39:

#   gb "Haha! You're just going to stand there!? Give me a hug!"
    gb "Haha! Vai ficar aí parado?! Me dá um abraço!"

# game/chapters/chapter2/script/ch2sc17.rpy:74
translate brazil ch2sc17_2da4d5aa:

#   gb "That’s it! Hah-hah-hah!"
    gb "É isso aí! Hah-hah-hah!"

# game/chapters/chapter2/script/ch2sc17.rpy:75
translate brazil ch2sc17_de2b1eb0:

#   gb "Give old Gibson a good squeeze!"
    gb "Dê um bom aperto no velho Gibson!"

# game/chapters/chapter2/script/ch2sc17.rpy:77
translate brazil ch2sc17_46c78128:

#   mc "Hrrraahh!"
    mc "Hrrraahh!"

# game/chapters/chapter2/script/ch2sc17.rpy:78
translate brazil ch2sc17_1195fb1b:

#   mc "C-Cant brea... breathe."
    mc "C-Não consigo respirar... respirar."

# game/chapters/chapter2/script/ch2sc17.rpy:80
translate brazil ch2sc17_fb080ecd:

#   gb "I can’t believe you’re really here!"
    gb "Não acredito que você está mesmo aqui!"

# game/chapters/chapter2/script/ch2sc17.rpy:81
translate brazil ch2sc17_32acd1bc:

#   gb "I never believed for a second that you were dead! Your aunt Maya was right!"
    gb "Eu nunca acreditei por um segundo que você estivesse morto! Sua tia Maya tinha razão!"

# game/chapters/chapter2/script/ch2sc17.rpy:82
translate brazil ch2sc17_1524cfe1:

#   gb "That gorgeous aunt of yours made sure I never stopped believing... she was convinced you couldn't be dead!"
    gb "Aquela sua tia maravilhosa fez com que eu nunca deixasse de acreditar... ela estava convencida de que você não podia estar morto!"

# game/chapters/chapter2/script/ch2sc17.rpy:84
translate brazil ch2sc17_50827f26:

#   mc "D-Definitely not dead. Hrhhh!"
    mc "D-Definitivamente não está morto. Hrhhh!"

# game/chapters/chapter2/script/ch2sc17.rpy:85
translate brazil ch2sc17_91261e3c:

#   mc "But I will be if you don’t stop squeezing so tightly."
    mc "Mas eu vou ficar se você não parar de apertar com tanta força."

# game/chapters/chapter2/script/ch2sc17.rpy:87
translate brazil ch2sc17_941db07f:

#   gb "Oh! Sorry, sorry! *Chuckles* Heh-heh! I forget my own strength."
    gb "Oh! Desculpe, desculpe! *Risos* Heh-heh! Eu me esqueço da minha própria força."

# game/chapters/chapter2/script/ch2sc17.rpy:89
translate brazil ch2sc17_b42b1271:

#   mc "*Winded* You don’t say."
    mc "*Sem fôlego* Não me diga."

# game/chapters/chapter2/script/ch2sc17.rpy:90
translate brazil ch2sc17_532580bc:

#   mc "What in the five hells have you been eating?"
    mc "Que diabos você andou comendo?"

# game/chapters/chapter2/script/ch2sc17.rpy:92
translate brazil ch2sc17_26ff1b98:

#   gb "What can I say, working with steel at the forge all day gives a man strength!"
    gb "O que posso dizer? Trabalhar com aço na forja o dia todo dá força a um homem!"

# game/chapters/chapter2/script/ch2sc17.rpy:94
translate brazil ch2sc17_2636484a:

#   mc "*Chuckles* It’s good to see you, Gibs... damn, my ribs."
    mc "*Risos* Que bom te ver, Gibs... droga, minhas costelas."

# game/chapters/chapter2/script/ch2sc17.rpy:95
translate brazil ch2sc17_56185c17:

#   gb "Hah! They'll pop back into place soon enough! It's great to see you kid!"
    gb "Ah! Eles vão voltar ao lugar rapidinho! Que bom te ver, garoto!"

# game/chapters/chapter2/script/ch2sc17.rpy:97
translate brazil ch2sc17_dfe765ab:

#   gb "Come, come! I want to hear everything!"
    gb "Venha, venha! Quero ouvir tudo!"

# game/chapters/chapter2/script/ch2sc17.rpy:100
translate brazil ch2sc17_73611f27:

#   gb "I bet a young lad like yourself have got quite the war-stories to tell!"
    gb "Aposto que um rapaz jovem como você tem muitas histórias de guerra para contar!"

# game/chapters/chapter2/script/ch2sc17.rpy:101
translate brazil ch2sc17_62e4b0fa:

#   gb "And by war-stories I mean, details about your female conquests!"
    gb "E por histórias de guerra, quero dizer detalhes sobre suas conquistas amorosas!"

# game/chapters/chapter2/script/ch2sc17.rpy:103
translate brazil ch2sc17_717487b4:

#   gb "Come! I need to sit down, I bet you've already got yourself a harem, oh to be young again!"
    gb "Vamos! Preciso me sentar, aposto que você já tem um harém, ah, como eu queria ser jovem de novo!"

# game/chapters/chapter2/script/ch2sc17.rpy:104
translate brazil ch2sc17_4d2f3e67:

#   mct "What is it with everyone thinking I'm building a harem? I'm just enjoying myself..."
    mct "Por que todo mundo acha que estou formando um harém? Estou apenas me divertindo..."

# game/chapters/chapter2/script/ch2sc17.rpy:107
translate brazil ch2sc17_b0e26fb0:

#   gb "Join me inside, I'm sure we'll need to sit for this!"
    gb "Venha comigo lá dentro, tenho certeza de que precisaremos ficar sentados para isso!"

# game/chapters/chapter2/script/ch2sc17.rpy:109
translate brazil ch2sc17_fcbd18e0:

#   mc "*Sigh* ..."
    mc "*Suspirar* ..."

# game/chapters/chapter2/script/ch2sc17.rpy:112
translate brazil ch2sc17_c0d09f09:

#   gb "Please, take a seat. We have a lot to catch up on."
    gb "Por favor, sente-se. Temos muito o que conversar."

# game/chapters/chapter2/script/ch2sc17.rpy:114
translate brazil ch2sc17_a72f4dfe:

#   gb "So, ten whole summers, huh? Where do we even begin?"
    gb "Então, dez verões inteiros, hein? Por onde começar?"

# game/chapters/chapter2/script/ch2sc17.rpy:116
translate brazil ch2sc17_53c8f6a0:

#   mc "I’ll just start from the night everything happened..."
    mc "Vou começar pela noite em que tudo aconteceu..."

# game/chapters/chapter2/script/ch2sc17.rpy:118
translate brazil ch2sc17_faa73f0f:

#   "You spend a few hours recapping the last ten years, and the recent events after Oren’s death and meeting Eliza."
    "Você passa algumas horas recapitulando os últimos dez anos e os eventos recentes após a morte de Oren e o encontro com Eliza."

# game/chapters/chapter2/script/ch2sc17.rpy:130
translate brazil ch2sc17_45cac942:

#   gb "."
    gb "."

# game/chapters/chapter2/script/ch2sc17.rpy:131
translate brazil ch2sc17_e3e0dc00:

#   gb ".."
    gb "..."

# game/chapters/chapter2/script/ch2sc17.rpy:133
translate brazil ch2sc17_d4a5db5c:

#   gb "Blazes, kid! You’ve been through one hell of a ride."
    gb "Puxa, garoto! Você passou por uma jornada e tanto."

# game/chapters/chapter2/script/ch2sc17.rpy:135
translate brazil ch2sc17_92a11bb4:

#   gb "Being taken away by a stranger, right as Eric & Lily were killed..."
    gb "Serem levados por um estranho, exatamente no momento em que Eric e Lily foram mortos..."

# game/chapters/chapter2/script/ch2sc17.rpy:137
translate brazil ch2sc17_2200e8ad:

#   gb "Spending several moons on the road, traveling to the far east."
    gb "Passando várias luas na estrada, viajando para o extremo oriente."

# game/chapters/chapter2/script/ch2sc17.rpy:139
translate brazil ch2sc17_dd57edaa:

#   gb "Finding this hidden 'Nakajima village' in the middle of a dense tropical forest."
    gb "Descobrir essa vila escondida de 'Nakajima' no meio de uma densa floresta tropical."

# game/chapters/chapter2/script/ch2sc17.rpy:141
translate brazil ch2sc17_3b8d0192:

#   gb "Meeting people from the Sen'ju region... I've never even met anyone from there."
    gb "Conhecer pessoas da região de Sen'ju... Eu nunca tinha conhecido ninguém de lá."

# game/chapters/chapter2/script/ch2sc17.rpy:142
translate brazil ch2sc17_4890a2c2:

#   gb "Except from traveling merchants."
    gb "Exceto comerciantes viajantes."

# game/chapters/chapter2/script/ch2sc17.rpy:144
translate brazil ch2sc17_3b06fc6e:

#   gb "I remember, clear as day, how you'd always pester Eric, your father, about becoming an adventurer."
    gb "Lembro-me, com toda a clareza, de como você sempre importunava Eric, seu pai, para que ele se tornasse um aventureiro."

# game/chapters/chapter2/script/ch2sc17.rpy:146
translate brazil ch2sc17_5e6e1767:

#   gb "It seems adventure found you all on its own."
    gb "Parece que a aventura te encontrou por conta própria."

# game/chapters/chapter2/script/ch2sc17.rpy:148
translate brazil ch2sc17_d6a0a102:

#   mc "It’s only just starting."
    mc "Está apenas começando."

# game/chapters/chapter2/script/ch2sc17.rpy:150
translate brazil ch2sc17_8676d992:

#   gb "You’re not staying?"
    gb "Você não vai ficar?"

# game/chapters/chapter2/script/ch2sc17.rpy:151
translate brazil ch2sc17_53efb045:

#   gb "*Sighs* But... you're finally home, I thought..."
    gb "*Suspiro* Mas... você finalmente está em casa, eu pensei..."

# game/chapters/chapter2/script/ch2sc17.rpy:153
translate brazil ch2sc17_dbf1d93f:

#   mc "No... Eliza and I have a long journey ahead of us."
    mc "Não... Eliza e eu temos uma longa jornada pela frente."

# game/chapters/chapter2/script/ch2sc17.rpy:154
translate brazil ch2sc17_e5d8666f:

#   mc "Lingering here in Riverside any longer won’t do me any good."
    mc "Permanecer aqui em Riverside por mais tempo não me fará bem algum."

# game/chapters/chapter2/script/ch2sc17.rpy:156
translate brazil ch2sc17_77a687ab:

#   gb "You’re a young man now, [mc]."
    gb "Você já é um jovem, [mc]."

# game/chapters/chapter2/script/ch2sc17.rpy:157
translate brazil ch2sc17_a18142e7:

#   gb "Part of that means making your own path in this world. You always went on and on about traveling..."
    gb "Parte disso significa trilhar seu próprio caminho neste mundo. Você sempre falava sem parar sobre viajar..."

# game/chapters/chapter2/script/ch2sc17.rpy:159
translate brazil ch2sc17_03905d21:

#   gb "I guess that part became a reality at least."
    gb "Acho que pelo menos essa parte se tornou realidade."

# game/chapters/chapter2/script/ch2sc17.rpy:161
translate brazil ch2sc17_727849a9:

#   gb "I was hoping you'd be able to stay a while longer. It would be good to have you around."
    gb "Eu esperava que você pudesse ficar mais um pouco. Seria bom ter você por perto."

# game/chapters/chapter2/script/ch2sc17.rpy:162
translate brazil ch2sc17_b3f8a881:

#   gb "*Quietly* {size=-10}{b}Not to mention, I'd love for you to meet Asta... I'm sure you'd be great friends...{/b}{/size}"
    gb "*Em silêncio* {size=-10}{b}Sem falar que eu adoraria que você conhecesse o Asta... Tenho certeza de que vocês seriam ótimos amigos...{/b}{/size}"

# game/chapters/chapter2/script/ch2sc17.rpy:164
translate brazil ch2sc17_f2ac7d91:

#   mc "Sorry to disappoint, Gibs. There’s something I have to do..."
    mc "Sinto muito desapontá-lo, Gibs. Tenho algo a fazer..."

# game/chapters/chapter2/script/ch2sc17.rpy:165
translate brazil ch2sc17_c101d41f:

#   mc "Something I can't achieve here in Riverside."
    mc "Algo que não consigo alcançar aqui em Riverside."

# game/chapters/chapter2/script/ch2sc17.rpy:167
translate brazil ch2sc17_6359501f:

#   gb "Heavens! You’re not seeking revenge are you?"
    gb "Céus! Você não está buscando vingança, está?"

# game/chapters/chapter2/script/ch2sc17.rpy:170
translate brazil ch2sc17_422f61af:

#   gb "Please tell me you aren't that bullheaded..."
    gb "Por favor, me diga que você não é tão teimoso assim..."

# game/chapters/chapter2/script/ch2sc17.rpy:174
translate brazil ch2sc17_c5f9f0cf:

#   mc "I have to. For them."
    mc "Eu preciso. Por eles."

# game/chapters/chapter2/script/ch2sc17.rpy:176
translate brazil ch2sc17_3eefa205:

#   gb "Kid... that’s the last thing they'd want."
    gb "Criança... essa é a última coisa que eles querem."

# game/chapters/chapter2/script/ch2sc17.rpy:177
translate brazil ch2sc17_6274d0be:

#   gb "Eric and Lily, they'd want you to be safe, to live your life."
    gb "Eric e Lily gostariam que você estivesse em segurança, que vivesse sua vida."

# game/chapters/chapter2/script/ch2sc17.rpy:179
translate brazil ch2sc17_8077fb68:

#   mc "It’s not about what they would have wanted, Gibs. I-I need this."
    mc "Não se trata do que eles teriam querido, Gibs. Eu preciso disso."

# game/chapters/chapter2/script/ch2sc17.rpy:181
translate brazil ch2sc17_ebe7c036:

#   mc "It’s the only thing that has kept me going all these years."
    mc "É a única coisa que me manteve firme todos esses anos."

# game/chapters/chapter2/script/ch2sc17.rpy:182
translate brazil ch2sc17_c69873d1:

#   mc "The only thing that has kept me from shattering into pieces..."
    mc "A única coisa que me impediu de me despedaçar..."

# game/chapters/chapter2/script/ch2sc17.rpy:186
translate brazil ch2sc17_2b2580e3:

#   gb "I... I understand. I guess it'd be pointless to ask you to be careful, eh?"
    gb "Eu... eu entendo. Acho que seria inútil pedir para você ter cuidado, né?"

# game/chapters/chapter2/script/ch2sc17.rpy:188
translate brazil ch2sc17_1a3ce239:

#   mc "Pretty much."
    mc "Praticamente isso."

# game/chapters/chapter2/script/ch2sc17.rpy:190
translate brazil ch2sc17_ae75af9a:

#   gb "In that case, I’ll simply ask that you finish what you’ve set out to do."
    gb "Nesse caso, peço simplesmente que você termine o que começou."

# game/chapters/chapter2/script/ch2sc17.rpy:192
translate brazil ch2sc17_f88bb7a1:

#   gb "Just don’t let it consume you... revenge can change a person. Make sure to surround yourself with good people."
    gb "Só não deixe que isso te consuma... a vingança pode mudar uma pessoa. Certifique-se de se cercar de pessoas boas."

# game/chapters/chapter2/script/ch2sc17.rpy:194
translate brazil ch2sc17_3cf91a90:

#   gb "People you can trust, people who will bring joy and light into your life."
    gb "Pessoas em quem você pode confiar, pessoas que trarão alegria e luz para sua vida."

# game/chapters/chapter2/script/ch2sc17.rpy:196
translate brazil ch2sc17_04deaad0:

#   mc "I-I’ll try, Gibs."
    mc "Eu vou tentar, Gibs."

# game/chapters/chapter2/script/ch2sc17.rpy:199
translate brazil ch2sc17_d7f1df72:

#   gb "I swear by the Divines, kid. If this is the last time I see you, I’ll beat you to a pulp!"
    gb "Juro pelos Divinos, garoto. Se esta for a última vez que te vejo, vou te dar uma surra!"

# game/chapters/chapter2/script/ch2sc17.rpy:201
translate brazil ch2sc17_259b7767:

#   mc "*Chuckle* I’ll see you again someday, Old Bear."
    mc "*Risos* Nos veremos novamente algum dia, Velho Urso."

# game/chapters/chapter2/script/ch2sc17.rpy:203
translate brazil ch2sc17_ffb4013d:

#   gb "Blazes... come here, Little Bear!"
    gb "Blazes... vem cá, Ursinho!"

# game/chapters/chapter2/script/ch2sc17.rpy:204
translate brazil ch2sc17_69dc3dd1:

#   mc "No! No more hugs. I'm still recovering from earlier."
    mc "Não! Chega de abraços. Ainda estou me recuperando do que aconteceu mais cedo."

# game/chapters/chapter2/script/ch2sc17.rpy:206
translate brazil ch2sc17_ff3b8a6a:

#   gb "Next time I see you, then!"
    gb "Na próxima vez que eu te vir, então!"

# game/chapters/chapter2/script/ch2sc17.rpy:207
translate brazil ch2sc17_167814cd:

#   mc "Alright, alright."
    mc "Certo, certo."

# game/chapters/chapter2/script/ch2sc17.rpy:209
translate brazil ch2sc17_6be3e009:

#   gb "And don’t underestimate whoever it is. Your father was a capable warrior."
    gb "E não subestime quem quer que seja. Seu pai era um guerreiro capaz."

# game/chapters/chapter2/script/ch2sc17.rpy:210
translate brazil ch2sc17_b4740910:

#   gb "He may have worked as a carpenter here in Riverside, but we both trained with sword and shield during our youth."
    gb "Ele pode ter trabalhado como carpinteiro aqui em Riverside, mas nós dois treinamos com espada e escudo durante nossa juventude."

# game/chapters/chapter2/script/ch2sc17.rpy:211
translate brazil ch2sc17_c75f75e2:

#   gb "And your mother..."
    gb "E sua mãe..."

# game/chapters/chapter2/script/ch2sc17.rpy:213
translate brazil ch2sc17_cd608f34:

#   gb "Lily, she was one of the most powerful arcane sorceresses I’ve ever seen."
    gb "Lily era uma das feiticeiras arcanas mais poderosas que eu já vi."

# game/chapters/chapter2/script/ch2sc17.rpy:214
translate brazil ch2sc17_3cc520dd:

#   gb "A renowned member of the Mage's guild."
    gb "Um membro renomado da guilda dos magos."

# game/chapters/chapter2/script/ch2sc17.rpy:215
translate brazil ch2sc17_d45d4207:

#   gb "Whoever could do that to them... has to be insanely powerful."
    gb "Quem quer que tenha conseguido fazer isso com eles... deve ser incrivelmente poderoso."

# game/chapters/chapter2/script/ch2sc17.rpy:217
translate brazil ch2sc17_e2e3818c:

#   mc "He's the one who should be afraid."
    mc "É ele quem deveria ter medo."

# game/chapters/chapter2/script/ch2sc17.rpy:219
translate brazil ch2sc17_63d7be09:

#   gb "I don’t doubt it kid. Just..."
    gb "Não duvido disso, garoto. Só..."

# game/chapters/chapter2/script/ch2sc17.rpy:221
translate brazil ch2sc17_6555aa52:

#   gb "Just make sure you come back."
    gb "Só não se esqueça de voltar."

# game/chapters/chapter2/script/ch2sc17.rpy:223
translate brazil ch2sc17_8bfa7a1c:

#   mc "I will, Gibs."
    mc "Sim, Gibs."

# game/chapters/chapter2/script/ch2sc17.rpy:224
translate brazil ch2sc17_5f2ec975:

#   mc "I still want to hear all the stories you have about my parents... so you can be sure I’ll return."
    mc "Ainda quero ouvir todas as histórias que você tem sobre meus pais... para que você tenha certeza de que voltarei."

# game/chapters/chapter2/script/ch2sc17.rpy:228
translate brazil ch2sc17_86c33922:

#   gb "Farewell, Little Bear. May the divines light your path."
    gb "Adeus, Ursinho. Que a divindade ilumine seu caminho."

# game/chapters/chapter2/script/ch2sc17.rpy:229
translate brazil ch2sc17_e3251364:

#   gb "And don't do anything foolish!"
    gb "E não faça nenhuma besteira!"

# game/chapters/chapter2/script/ch2sc17.rpy:231
translate brazil ch2sc17_dcb626c5:

#   mct "Goodbye old friend..."
    mct "Adeus, velho amigo..."

# game/chapters/chapter2/script/ch2sc17.rpy:235
translate brazil ch2sc17_4166c1a2:

#   gbt "They would be so proud of you."
    gbt "Eles ficariam muito orgulhosos de você."

# game/chapters/chapter2/script/ch2sc17.rpy:236
translate brazil ch2sc17_d98231d2:

#   gbt "Eric... Lily... are you guys seeing this from the afterlife? Your little boy has become a man."
    gbt "Eric... Lily... vocês estão vendo isso do além? O filhinho de vocês virou homem."

# game/chapters/chapter2/script/ch2sc17.rpy:237
translate brazil ch2sc17_99035c04:

#   gbt "*Sighs* I better head back inside, nails and hinges don't forge themselves."
    gbt "*Suspiro* É melhor eu voltar para dentro, pregos e dobradiças não se fazem sozinhos."

# game/chapters/chapter2/script/ch2sc17.rpy:240
translate brazil ch2sc17_e53cf28e:

#   astt "He's cute."
    astt "Ele é fofo."

# game/chapters/chapter2/script/ch2sc17.rpy:241
translate brazil ch2sc17_8ce4b8d5:

#   astt "Little bear? Hmm?"
    astt "Ursinho? Hum?"

# game/chapters/chapter2/script/ch2sc17.rpy:242
translate brazil ch2sc17_e0cf8699:

#   astt "I wonder who he is? I haven't seen him around Riverside before..."
    astt "Quem será ele? Nunca o vi por Riverside antes..."

# game/chapters/chapter2/script/ch2sc17.rpy:245
translate brazil ch2sc17_d2bf2a39:

#   astt "He was speaking to daddy for quite a while..."
    astt "Ele ficou conversando com o pai por um bom tempo..."

# game/chapters/chapter2/script/ch2sc17.rpy:246
translate brazil ch2sc17_7625645f:

#   astt "Do they know each other? But he's so young... he can't be much older than me? Maybe a year or two."
    astt "Eles se conhecem? Mas ele é tão jovem... não pode ser muito mais velho do que eu, né? Talvez um ou dois anos."

# game/chapters/chapter2/script/ch2sc17.rpy:247
translate brazil ch2sc17_e25bf5cd:

#   astt "I'm turning 19 in two weeks, maybe... maybe daddy could invite him?"
    astt "Vou fazer 19 anos daqui a duas semanas, talvez... talvez papai possa convidá-lo?"

# game/chapters/chapter2/script/ch2sc17.rpy:250
translate brazil ch2sc17_6a5710d1:

#   astt "There's not been any cute boys in Riverside since I arrived from Luxenford..."
    astt "Não apareceu nenhum rapaz bonito em Riverside desde que cheguei de Luxemburgo..."

# game/chapters/chapter2/script/ch2sc17.rpy:251
translate brazil ch2sc17_e804709f:

#   astt "If he's friends with daddy, surely daddy would approve of him? *Giggles* I'm getting ahead of myself!"
    astt "Se ele é amigo do papai, com certeza o papai aprovaria, né? *Risos* Estou me precipitando!"

# game/chapters/chapter2/script/ch2sc17.rpy:252
translate brazil ch2sc17_d078b272:

#   astt "I haven't even met him!"
    astt "Eu nem sequer o conheci!"

# game/chapters/chapter2/script/ch2sc17.rpy:254
translate brazil ch2sc17_ca78d52b:

#   gb "*Calling out* Asta, sweetie? Are you nearby? I could use a bucket of water for dousing the steel."
    gb "*Chamando* Asta, querido? Você está por perto? Eu preciso de um balde d'água para apagar o fogo."

# game/chapters/chapter2/script/ch2sc17.rpy:255
translate brazil ch2sc17_cc6cd144:

#   ast "*Shouts* Yes, I'll go fetch a fresh bucket daddy!"
    ast "*Grita* Sim, vou buscar um balde novo, papai!"

# game/chapters/chapter2/script/ch2sc17.rpy:256
translate brazil ch2sc17_bf2c2621:

#   gb "That's my girl! Don't fill it too much, otherwise you won't be able to carry it."
    gb "Essa é a minha garota! Não a encha demais, senão você não vai conseguir carregá-la."



# ARQUIVO: game/chapters/chapter2/script/ch2sc29.rpy DIALOGOS: 451


# game/chapters/chapter2/script/ch2sc29.rpy:11
translate brazil ch2sc29_a2498c0c:

#   mc "I’ll order us some drinks while you find us a spot."
    mc "Vou pedir algumas bebidas enquanto você procura um lugar para nós."

# game/chapters/chapter2/script/ch2sc29.rpy:13
translate brazil ch2sc29_c09bfd95:

#   el "Sure! I’ll grab the best spots!"
    el "Claro! Vou reservar os melhores lugares!"

# game/chapters/chapter2/script/ch2sc29.rpy:14
translate brazil ch2sc29_0abdd2fc:

#   el "You can inform your butt that there's a seat waiting for him!"
    el "Você pode avisar seu traseiro que há um assento esperando por ele!"

# game/chapters/chapter2/script/ch2sc29.rpy:16
translate brazil ch2sc29_5af0b35d:

#   mc "I have the utmost faith in your spot-picking skills."
    mc "Tenho plena confiança na sua capacidade de identificar alvos com precisão."

# game/chapters/chapter2/script/ch2sc29.rpy:18
translate brazil ch2sc29_13784133:

#   el "You'd better! *Giggling*"
    el "É melhor mesmo! *Risos*"

# game/chapters/chapter2/script/ch2sc29.rpy:19
translate brazil ch2sc29_23854871:

#   el "They're amazing! Unmatched even!"
    el "São incríveis! Incomparáveis!"

# game/chapters/chapter2/script/ch2sc29.rpy:21
translate brazil ch2sc29_45fb6249:

#   ik "Welcome to the Rusty spoon!"
    ik "Bem-vindo(a) à colher enferrujada!"

# game/chapters/chapter2/script/ch2sc29.rpy:22
translate brazil ch2sc29_3503c010:

#   ik "What can I get you?"
    ik "O que posso lhe oferecer?"

# game/chapters/chapter2/script/ch2sc29.rpy:24
translate brazil ch2sc29_4be70d5b:

#   mc "*Chuckles* Rusty spoon?"
    mc "*Risos* Colher enferrujada?"

# game/chapters/chapter2/script/ch2sc29.rpy:25
translate brazil ch2sc29_81745b2c:

#   mc "There’s got to be a story behind a name like that."
    mc "Deve haver uma história por trás de um nome como esse."

# game/chapters/chapter2/script/ch2sc29.rpy:27
translate brazil ch2sc29_c135ca60:

#   ik "Nothing eventful, I’m afraid."
    ik "Nada de muito interessante, receio."

# game/chapters/chapter2/script/ch2sc29.rpy:28
translate brazil ch2sc29_4bc08b8e:

#   ik "When I was setting up the tavern, my wife accidentally forgot she left all the spoons in a crate at our house."
    ik "Quando eu estava montando a taverna, minha esposa acidentalmente esqueceu que havia deixado todas as colheres em uma caixa em nossa casa."

# game/chapters/chapter2/script/ch2sc29.rpy:30
translate brazil ch2sc29_f7784110:

#   mc "Outside?"
    mc "Fora?"

# game/chapters/chapter2/script/ch2sc29.rpy:32
translate brazil ch2sc29_e333d37e:

#   ik "Yeah... We were getting ready to move it here, but it started pouring down."
    ik "Sim... Estávamos nos preparando para transferi-lo para cá, mas começou a chover torrencialmente."

# game/chapters/chapter2/script/ch2sc29.rpy:33
translate brazil ch2sc29_6733ff92:

#   ik "The worst rainfall we’ve had in decades!"
    ik "A pior chuva que tivemos em décadas!"

# game/chapters/chapter2/script/ch2sc29.rpy:35
translate brazil ch2sc29_c293efe4:

#   ik "It lasted a full week and we had to crash here for the duration of the storm."
    ik "Durou uma semana inteira e tivemos que ficar aqui durante toda a tempestade."

# game/chapters/chapter2/script/ch2sc29.rpy:37
translate brazil ch2sc29_10ac9d3b:

#   mc "So when you got back to the crate... the spoons were all rusted?"
    mc "Então, quando você voltou para o caixote... as colheres estavam todas enferrujadas?"

# game/chapters/chapter2/script/ch2sc29.rpy:39
translate brazil ch2sc29_7d96bef4:

#   ik "Smart lad! Aye... We managed to scrape the rust off with a remedy my wife bought in Luxenford."
    ik "Garoto esperto! É... Conseguimos remover a ferrugem com um produto que minha esposa comprou em Luxemburgo."

# game/chapters/chapter2/script/ch2sc29.rpy:40
translate brazil ch2sc29_fe7e4fad:

#   ik "However, that’s what led us to the name."
    ik "No entanto, foi isso que nos levou a escolher esse nome."

# game/chapters/chapter2/script/ch2sc29.rpy:42
translate brazil ch2sc29_d3dee951:

#   mc "I like it."
    mc "Eu gosto disso."

# game/chapters/chapter2/script/ch2sc29.rpy:43
translate brazil ch2sc29_3dd792c9:

#   mc "It has a certain charm to it."
    mc "Tem um certo charme."

# game/chapters/chapter2/script/ch2sc29.rpy:45
translate brazil ch2sc29_29fac75a:

#   ik "*Chuckles* Thanks, lad. You’ll still have to pay for your ales, though."
    ik "*Risos* Obrigado, rapaz. Mas você ainda vai ter que pagar pelas suas cervejas."

# game/chapters/chapter2/script/ch2sc29.rpy:47
translate brazil ch2sc29_16e083ab:

#   ik "Tell you what, why don’t you go sit with your girlfriend? I’ll bring the ales over in a moment."
    ik "Sabe de uma coisa? Por que você não vai sentar com a sua namorada? Já trago as cervejas."

# game/chapters/chapter2/script/ch2sc29.rpy:53
translate brazil ch2sc29_1f3cdcde:

#   mc "She’s beautiful, isn’t she?"
    mc "Ela é linda, não é?"

# game/chapters/chapter2/script/ch2sc29.rpy:55
translate brazil ch2sc29_f8a8c47a:

#   ik "She sure is, lad. What I wouldn’t give to be young again."
    ik "Com certeza, rapaz. O que eu não daria para ser jovem de novo."

# game/chapters/chapter2/script/ch2sc29.rpy:56
translate brazil ch2sc29_d1f9e933:

#   ik "How did you land a girl like that?"
    ik "Como você conseguiu conquistar uma garota dessas?"

# game/chapters/chapter2/script/ch2sc29.rpy:58
translate brazil ch2sc29_8118c972:

#   mc "I couldn’t really tell you. I guess we’re alike in some ways."
    mc "Não saberia dizer ao certo. Acho que somos parecidos em alguns aspectos."

# game/chapters/chapter2/script/ch2sc29.rpy:59
translate brazil ch2sc29_3e54738f:

#   mc "Our lives have been intertwined since we were little, although we had no idea at the time."
    mc "Nossas vidas estão entrelaçadas desde que éramos pequenos, embora não tivéssemos ideia disso na época."

# game/chapters/chapter2/script/ch2sc29.rpy:61
translate brazil ch2sc29_e3a3426f:

#   ik "You know what? First round of ales are on me."
    ik "Sabe de uma coisa? A primeira rodada de cervejas é por minha conta."

# game/chapters/chapter2/script/ch2sc29.rpy:62
translate brazil ch2sc29_505b93fd:

#   ik "In the spirit of young love!"
    ik "No espírito do amor jovem!"

# game/chapters/chapter2/script/ch2sc29.rpy:64
translate brazil ch2sc29_ab182d5e:

#   mc "Thank you. I’ll be sure to let her know!"
    mc "Obrigada. Com certeza avisarei a ela!"

# game/chapters/chapter2/script/ch2sc29.rpy:68
translate brazil ch2sc29_8926a288:

#   mc "Oh she’s not my girlfriend, we’re just friends traveling together."
    mc "Ah, ela não é minha namorada, somos apenas amigos viajando juntos."

# game/chapters/chapter2/script/ch2sc29.rpy:70
translate brazil ch2sc29_4b0bba1d:

#   ik "Apologies for assuming. You just seem to have some chemistry."
    ik "Peço desculpas por ter presumido algo. Parece que vocês simplesmente têm uma certa química."

# game/chapters/chapter2/script/ch2sc29.rpy:72
translate brazil ch2sc29_6a4c5e8e:

#   mc "I guess we do. We’ve become close friends in a short amount of time."
    mc "Acho que sim. Nos tornamos amigos íntimos em pouco tempo."

# game/chapters/chapter2/script/ch2sc29.rpy:74
translate brazil ch2sc29_511b85a5:

#   mc "We understand each other, and we've built up a solid amount of trust."
    mc "Nós nos entendemos e construímos uma sólida relação de confiança."

# game/chapters/chapter2/script/ch2sc29.rpy:76
translate brazil ch2sc29_1a80bc59:

#   ik "That’s a great foundation for many things: be it friendship, love, or marriage."
    ik "Essa é uma ótima base para muitas coisas: seja amizade, amor ou casamento."

# game/chapters/chapter2/script/ch2sc29.rpy:78
translate brazil ch2sc29_69ca9eec:

#   mc "I’m starting to see that. How much for the ales?"
    mc "Estou começando a perceber isso. Quanto custam as cervejas?"

# game/chapters/chapter2/script/ch2sc29.rpy:80
translate brazil ch2sc29_aa62b886:

#   ik "I’ve changed my mind. First round is on the house. Just make sure to let others know about the Rusty spoon!"
    ik "Mudei de ideia. A primeira rodada é por conta da casa. Só não se esqueça de avisar os outros sobre a colher enferrujada!"

# game/chapters/chapter2/script/ch2sc29.rpy:82
translate brazil ch2sc29_0c583a10:

#   mc "Thanks! I’ll be sure to mention it to others while we’re on the road."
    mc "Obrigado! Com certeza vou mencionar isso para os outros enquanto estivermos na estrada."

# game/chapters/chapter2/script/ch2sc29.rpy:86
translate brazil ch2sc29_0f2c8eb1:

#   el "*Hums to the ambiance* Hm-hn-hh-hm-hn-hh..."
    el "*Cantarola ao ritmo da música ambiente* Hm-hn-hh-hm-hn-hh..."

# game/chapters/chapter2/script/ch2sc29.rpy:87
translate brazil ch2sc29_532117ed:

#   mc "Hey, you."
    mc "Ei, você aí."

# game/chapters/chapter2/script/ch2sc29.rpy:89
translate brazil ch2sc29_b6c382cc:

#   el "Hi!"
    el "Oi!"

# game/chapters/chapter2/script/ch2sc29.rpy:90
translate brazil ch2sc29_d578cfe0:

#   el "What took you so long?"
    el "Por que demorou tanto?"

# game/chapters/chapter2/script/ch2sc29.rpy:92
translate brazil ch2sc29_1480a2fa:

#   mc "I got to talking with the innkeep."
    mc "Comecei a conversar com o dono da pousada."

# game/chapters/chapter2/script/ch2sc29.rpy:93
translate brazil ch2sc29_731750ad:

#   mc "He was telling me the story behind the name of the tavern, and then he thought you were my girlfriend."
    mc "Ele estava me contando a história por trás do nome da taverna, e aí achou que você era minha namorada."

# game/chapters/chapter2/script/ch2sc29.rpy:96
translate brazil ch2sc29_1b191981:

#   el "!!"
    el "!!"

# game/chapters/chapter2/script/ch2sc29.rpy:98
translate brazil ch2sc29_6ca05526:

#   el "G-Girlfriend? What a silly idea."
    el "Namorada? Que ideia boba."

# game/chapters/chapter2/script/ch2sc29.rpy:100
translate brazil ch2sc29_d1883e9c:

#   el "Just out of curiosity... what did you tell him?"
    el "Só por curiosidade... o que você disse para ele?"

# game/chapters/chapter2/script/ch2sc29.rpy:102
translate brazil ch2sc29_a19aeffa:

#   mc "Wouldn’t you like to know?"
    mc "Você não gostaria de saber?"

# game/chapters/chapter2/script/ch2sc29.rpy:105
translate brazil ch2sc29_6d9728af:

#   el "{b}I WOULD!{/b}"
    el "{b}EU PODERIA!{/b}"

# game/chapters/chapter2/script/ch2sc29.rpy:107
translate brazil ch2sc29_5c45b78a:

#   el "I- mean, I would..."
    el "Quer dizer, eu faria..."

# game/chapters/chapter2/script/ch2sc29.rpy:108
translate brazil ch2sc29_8d5e9322:

#   mc "*Chuckles* You're cute."
    mc "*Risos* Você é fofo(a)."

# game/chapters/chapter2/script/ch2sc29.rpy:109
translate brazil ch2sc29_65e49647:

#   el "It’s rude to keep a lady waiting, you know?"
    el "É falta de educação deixar uma dama esperando, sabe?"

# game/chapters/chapter2/script/ch2sc29.rpy:111
translate brazil ch2sc29_b305efe2:

#   el "Soo?"
    el "E daí?"

# game/chapters/chapter2/script/ch2sc29.rpy:116
translate brazil ch2sc29_abab3f6c:

#   "Eliza’s trust increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "A confiança de Eliza aumentou em {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc29.rpy:120
translate brazil ch2sc29_20572e6e:

#   "!!"
    "!!"

# game/chapters/chapter2/script/ch2sc29.rpy:122
translate brazil ch2sc29_c1dde051:

#   el "Y-You did?"
    el "Você fez isso?"

# game/chapters/chapter2/script/ch2sc29.rpy:124
translate brazil ch2sc29_064b79d7:

#   mc "Mmh, it felt right."
    mc "Hum, pareceu certo."

# game/chapters/chapter2/script/ch2sc29.rpy:125
translate brazil ch2sc29_70d13a59:

#   mc "Why? Shouldn’t I have?"
    mc "Por quê? Eu não deveria ter feito isso?"

# game/chapters/chapter2/script/ch2sc29.rpy:127
translate brazil ch2sc29_a18321f3:

#   el "N-No, it’s okay."
    el "N-Não, tudo bem."

# game/chapters/chapter2/script/ch2sc29.rpy:128
translate brazil ch2sc29_c9883a2a:

#   el "*Whispers quietly* {size=-10}{b}I’m really happy you did.{/b}{/size}"
    el "*Sussurra baixinho* {size=-10}{b}Fico muito feliz que você tenha feito isso.{/b}{/size}"

# game/chapters/chapter2/script/ch2sc29.rpy:130
translate brazil ch2sc29_1573f1f4:

#   elt "Heavens... Girlfriend?"
    elt "Céus... Namorada?"

# game/chapters/chapter2/script/ch2sc29.rpy:131
translate brazil ch2sc29_b218442d:

#   elt "Nyahh! I want to kiss him so badly!"
    elt "Nyahh! Eu quero muito beijá-lo!"

# game/chapters/chapter2/script/ch2sc29.rpy:132
translate brazil ch2sc29_3179ad42:

#   elt "Just jump onto his lap and wrap my legs and arms tightly around him, while our lips intertwine passionately."
    elt "Simplesmente pulo no colo dele e o enrolo com minhas pernas e braços, enquanto nossos lábios se entrelaçam apaixonadamente."

# game/chapters/chapter2/script/ch2sc29.rpy:135
translate brazil ch2sc29_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/chapters/chapter2/script/ch2sc29.rpy:138
translate brazil ch2sc29_74e93029:

#   mc "You're day-dreaming about our future, aren't you? *Chuckles*"
    mc "Você fica sonhando acordado com o nosso futuro, não é? *Risos*"

# game/chapters/chapter2/script/ch2sc29.rpy:140
translate brazil ch2sc29_e3a96c47:

#   el "Hmm?! N-No! I-... that would be crazy... y-yeah... totally crazy..."
    el "Hum?! N-Não! Eu... isso seria loucura... s-sim... totalmente loucura..."

# game/chapters/chapter2/script/ch2sc29.rpy:141
translate brazil ch2sc29_57391501:

#   el "A-Anyway! I’m ready for those ales!"
    el "Enfim! Estou pronto para essas cervejas!"

# game/chapters/chapter2/script/ch2sc29.rpy:143
translate brazil ch2sc29_e5903c6d:

#   mc "Me too, he should be here any moment now."
    mc "Eu também, ele deve chegar a qualquer momento."

# game/chapters/chapter2/script/ch2sc29.rpy:148
translate brazil ch2sc29_8e6c80e7:

#   el "I wonder why he thought we were a couple?"
    el "Eu me pergunto por que ele achou que éramos um casal?"

# game/chapters/chapter2/script/ch2sc29.rpy:150
translate brazil ch2sc29_7055bfc8:

#   mc "He said we had chemistry."
    mc "Ele disse que tínhamos química."

# game/chapters/chapter2/script/ch2sc29.rpy:152
translate brazil ch2sc29_148ab593:

#   el "I suppose we do. I just didn’t know it was obvious to others."
    el "Acho que sim. Só não sabia que era óbvio para os outros."

# game/chapters/chapter2/script/ch2sc29.rpy:154
translate brazil ch2sc29_d8aac7eb:

#   mc "Maybe he's just perceptive."
    mc "Talvez ele seja apenas perspicaz."

# game/chapters/chapter2/script/ch2sc29.rpy:156
translate brazil ch2sc29_c2147ef8:

#   el "Yeah. That’s probably it..."
    el "Sim. Provavelmente é isso..."

# game/chapters/chapter2/script/ch2sc29.rpy:157
translate brazil ch2sc29_92578d50:

#   el "Innkeepers talk to people all the time. They're probably used to picking up on such things."
    el "Os donos de pousadas conversam com as pessoas o tempo todo. Provavelmente estão acostumados a perceber esse tipo de coisa."

# game/chapters/chapter2/script/ch2sc29.rpy:158
translate brazil ch2sc29_5c4aa11e:

#   "Eliza’s trust increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "A confiança de Eliza aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc29.rpy:161
translate brazil ch2sc29_74f6627a:

#   ik "Here you are, do call me if you youngsters need anything else."
    ik "Aqui está, liguem-me se vocês, jovens, precisarem de mais alguma coisa."

# game/chapters/chapter2/script/ch2sc29.rpy:163
translate brazil ch2sc29_47a22870:

#   el "Thank you sir! This is exactly what we need right now!"
    el "Muito obrigado, senhor! É exatamente disso que precisamos neste momento!"

# game/chapters/chapter2/script/ch2sc29.rpy:165
translate brazil ch2sc29_d4a67591:

#   el "Oh! Oh! What should we toast to?"
    el "Oh! Oh! A que devemos fazer um brinde?"

# game/chapters/chapter2/script/ch2sc29.rpy:171
translate brazil ch2sc29_6608fc04:

#   el "To us! Cheers!"
    el "À nossa saúde! Um brinde!"

# game/chapters/chapter2/script/ch2sc29.rpy:174
translate brazil ch2sc29_13cf4476:

#   el "I like it! Cheers!"
    el "Gostei! Saúde!"

# game/chapters/chapter2/script/ch2sc29.rpy:177
translate brazil ch2sc29_4d7a3316:

#   el "The sweet taste of revenge! Cheers!"
    el "O doce sabor da vingança! Saúde!"

# game/chapters/chapter2/script/ch2sc29.rpy:180
translate brazil ch2sc29_c77139ba:

#   mc "You’ve earned it... being on the road for days isn't easy, yet you barely complaim."
    mc "Você merece... ficar na estrada por dias não é fácil, mas você quase não reclama."

# game/chapters/chapter2/script/ch2sc29.rpy:181
translate brazil ch2sc29_bec09ba0:

#   mc "Let’s enjoy ourselves, Cheers!"
    mc "Vamos nos divertir! Saúde!"

# game/chapters/chapter2/script/ch2sc29.rpy:188
translate brazil ch2sc29_598c7d66:

#   el "UUaaaAAaahh! This is so good!"
    el "UUaaaAAaahh! Isso é tão bom!"

# game/chapters/chapter2/script/ch2sc29.rpy:191
translate brazil ch2sc29_06daa561:

#   el "*Gulp, gulp* Hnngh..."
    el "*Engole em seco* Hnngh..."

# game/chapters/chapter2/script/ch2sc29.rpy:193
translate brazil ch2sc29_838c34de:

#   el "You're right! We've earned a little bit of comfort!"
    el "Você tem razão! Merecemos um pouco de conforto!"

# game/chapters/chapter2/script/ch2sc29.rpy:198
translate brazil ch2sc29_74120b8b:

#   el "Is now a good time to ask you about the guy who attacked us at the lake?"
    el "Agora seria um bom momento para te perguntar sobre o cara que nos atacou no lago?"

# game/chapters/chapter2/script/ch2sc29.rpy:200
translate brazil ch2sc29_7ada4607:

#   el "He clearly wasn’t just a regular thug... the way he fought you, on top of the water..."
    el "Ele claramente não era um bandido qualquer... o jeito que ele lutou com você, em cima da água..."

# game/chapters/chapter2/script/ch2sc29.rpy:201
translate brazil ch2sc29_0cf90f2d:

#   el "At one point, I-I thought..."
    el "Em um dado momento, eu pensei..."

# game/chapters/chapter2/script/ch2sc29.rpy:204
translate brazil ch2sc29_d7326957:

#   el "He almost drowned you [mc]!"
    el "Ele quase te afogou. [mc]!"

# game/chapters/chapter2/script/ch2sc29.rpy:205
translate brazil ch2sc29_bbc8fb55:

#   el "That’s not okay! I don’t accept that!"
    el "Isso não está certo! Eu não aceito isso!"

# game/chapters/chapter2/script/ch2sc29.rpy:207
translate brazil ch2sc29_c673afe7:

#   mc "Calm down, you little firecracker."
    mc "Calma, sua danadinha."

# game/chapters/chapter2/script/ch2sc29.rpy:208
translate brazil ch2sc29_2d91fd23:

#   mc "I’ll tell you... you're right, he wasn't a regular thug."
    mc "Vou te dizer... você tem razão, ele não era um bandido comum."

# game/chapters/chapter2/script/ch2sc29.rpy:210
translate brazil ch2sc29_7e6bcd96:

#   mc "The guy who attacked us is... well, was a Shado-jin."
    mc "O cara que nos atacou é... bem, era um Shado-jin."

# game/chapters/chapter2/script/ch2sc29.rpy:211
translate brazil ch2sc29_a8c95f92:

#   mc "They're an elite group within the Mercenaries Guild."
    mc "Eles são um grupo de elite dentro da Guilda dos Mercenários."

# game/chapters/chapter2/script/ch2sc29.rpy:212
translate brazil ch2sc29_8dc1952d:

#   mc "They are technically free-lance, but from what I know, it's mostly that guild who makes use of them."
    mc "Tecnicamente, eles são freelancers, mas pelo que sei, é principalmente essa guilda que os utiliza."

# game/chapters/chapter2/script/ch2sc29.rpy:214
translate brazil ch2sc29_ad723032:

#   mc "Only their best and most hardened members advance to become Shado-jins."
    mc "Apenas seus membros mais fortes e experientes progridem para se tornarem Shado-jins."

# game/chapters/chapter2/script/ch2sc29.rpy:216
translate brazil ch2sc29_92d87359:

#   el "I take it this wasn’t your first run-in with them?"
    el "Imagino que este não tenha sido seu primeiro encontro com eles?"

# game/chapters/chapter2/script/ch2sc29.rpy:217
translate brazil ch2sc29_1a129a86:

#   el "Given you've been on the run and seemed familiar with them."
    el "Considerando que você estava foragido e parecia estar familiarizado com eles."

# game/chapters/chapter2/script/ch2sc29.rpy:219
translate brazil ch2sc29_26a2af42:

#   mc "You’re right about that, apparently he had a brother who was also in that group."
    mc "Você tem razão, aparentemente ele tinha um irmão que também fazia parte desse grupo."

# game/chapters/chapter2/script/ch2sc29.rpy:220
translate brazil ch2sc29_a40d5448:

#   mc "And his brother tracked your father and me down, around two years ago."
    mc "E o irmão dele localizou a mim e ao seu pai, há cerca de dois anos."

# game/chapters/chapter2/script/ch2sc29.rpy:222
translate brazil ch2sc29_cd8abd0e:

#   mc "I wasn’t a match for him, but Oren handled him."
    mc "Eu não era páreo para ele, mas Oren deu conta do recado."

# game/chapters/chapter2/script/ch2sc29.rpy:223
translate brazil ch2sc29_1fafd2a5:

#   mc "The one who attacked us..."
    mc "Aquele que nos atacou..."

# game/chapters/chapter2/script/ch2sc29.rpy:224
translate brazil ch2sc29_d71c7ef8:

#   mc "He was after revenge for his brother, the bounty on me was just a bonus."
    mc "Ele queria vingança pela morte do irmão, a recompensa pela minha cabeça era apenas um bônus."

# game/chapters/chapter2/script/ch2sc29.rpy:227
translate brazil ch2sc29_c43f19e8:

#   elt "Those bastards have been hunting [mc] ever since he was a kid..."
    elt "Aqueles desgraçados andam caçando [mc] desde que ele era criança..."

# game/chapters/chapter2/script/ch2sc29.rpy:229
translate brazil ch2sc29_bd7b14bc:

#   el "What happened after you defeated him at the lake?"
    el "O que aconteceu depois que você o derrotou no lago?"

# game/chapters/chapter2/script/ch2sc29.rpy:230
translate brazil ch2sc29_3233bbe1:

#   el "You absorbed something from him? And then you collapsed, you were out cold for over an hour."
    el "Você absorveu alguma coisa dele? E então você desmaiou, ficou inconsciente por mais de uma hora."

# game/chapters/chapter2/script/ch2sc29.rpy:235
translate brazil ch2sc29_6c307337:

#   mc "I siphoned the mana cells in his body. He’ll live, but he won’t ever be able to use magic again."
    mc "Eu drenei as células de mana do corpo dele. Ele vai sobreviver, mas nunca mais poderá usar magia."

# game/chapters/chapter2/script/ch2sc29.rpy:236
translate brazil ch2sc29_c35df066:

#   mc "He’ll be physically weaker as well."
    mc "Ele também ficará fisicamente mais fraco."

# game/chapters/chapter2/script/ch2sc29.rpy:238
translate brazil ch2sc29_2b2913cb:

#   mc "I don’t gain as much strength from doing that compared to absorbing a soul, but it still makes me stronger."
    mc "Não ganho tanta força fazendo isso em comparação com absorver uma alma, mas ainda assim me torna mais forte."

# game/chapters/chapter2/script/ch2sc29.rpy:241
translate brazil ch2sc29_5a83430c:

#   mc "I absorbed his soul after he died. It increases my strength and allows me to grow my abilities."
    mc "Absorvi a alma dele depois que ele morreu. Isso aumenta minha força e me permite desenvolver minhas habilidades."

# game/chapters/chapter2/script/ch2sc29.rpy:242
translate brazil ch2sc29_314f5cb3:

#   mc "But it’s very painful and it can be overwhelming when it happens."
    mc "Mas é muito doloroso e pode ser avassalador quando acontece."

# game/chapters/chapter2/script/ch2sc29.rpy:246
translate brazil ch2sc29_48c2dd09:

#   mc "I don't have much experience doing... that."
    mc "Não tenho muita experiência nisso."

# game/chapters/chapter2/script/ch2sc29.rpy:248
translate brazil ch2sc29_c26e60db:

#   el "I see... you really had me worried when you collapsed."
    el "Entendi... você realmente me deixou preocupado quando desmaiou."

# game/chapters/chapter2/script/ch2sc29.rpy:249
translate brazil ch2sc29_00b487c8:

#   el "Has that happened before?"
    el "Isso já aconteceu antes?"

# game/chapters/chapter2/script/ch2sc29.rpy:251
translate brazil ch2sc29_7a6177fe:

#   mc "Not that I know of... All this is a learn-as-I-go process for me."
    mc "Que eu saiba, não... Tudo isso é um processo de aprendizado contínuo para mim."

# game/chapters/chapter2/script/ch2sc29.rpy:252
translate brazil ch2sc29_fcf2031c:

#   mc "It’s not like I went around absorbing souls as a kid, you know?"
    mc "Não é como se eu saísse por aí absorvendo almas quando era criança, sabe?"

# game/chapters/chapter2/script/ch2sc29.rpy:254
translate brazil ch2sc29_11c9a63c:

#   mc "Your father always warned me to be careful with it."
    mc "Seu pai sempre me alertava para ter cuidado com isso."

# game/chapters/chapter2/script/ch2sc29.rpy:255
translate brazil ch2sc29_42895ebd:

#   mc "Because power can be corrupting and addictive."
    mc "Porque o poder pode ser corruptor e viciante."

# game/chapters/chapter2/script/ch2sc29.rpy:257
translate brazil ch2sc29_e97acc7f:

#   el "I won’t allow you to end up like Balthazar."
    el "Não permitirei que você acabe como Baltazar."

# game/chapters/chapter2/script/ch2sc29.rpy:259
translate brazil ch2sc29_d777072e:

#   mc "I know you won't. I feel better knowing you have my back."
    mc "Eu sei que não vai. Me sinto melhor sabendo que posso contar com você."

# game/chapters/chapter2/script/ch2sc29.rpy:261
translate brazil ch2sc29_8b5e405c:

#   elt "He really does appreciate me."
    elt "Ele realmente gosta muito de mim."

# game/chapters/chapter2/script/ch2sc29.rpy:263
translate brazil ch2sc29_05519f37:

#   el "I have your back, front, and sides!"
    el "Tenho você de costas, da frente e dos lados!"

# game/chapters/chapter2/script/ch2sc29.rpy:266
translate brazil ch2sc29_eaba4b38:

#   mct "If I have to go through all this with anyone, I'm glad it's her."
    mct "Se eu tiver que passar por tudo isso com alguém, fico feliz que seja com ela."

# game/chapters/chapter2/script/ch2sc29.rpy:268
translate brazil ch2sc29_f9f24c38:

#   mc "Anyway, I think we’ll reach Luxenford tomorrow."
    mc "De qualquer forma, acho que chegaremos a Luxemburgo amanhã."

# game/chapters/chapter2/script/ch2sc29.rpy:270
translate brazil ch2sc29_09d723c6:

#   el "How do you know that?"
    el "Como você sabe disso?"

# game/chapters/chapter2/script/ch2sc29.rpy:271
translate brazil ch2sc29_4d2c37b1:

#   el "*Giggling* Are you going to tell me that being a Nephilim gives you psychic powers?"
    el "*Risos* Você vai me dizer que ser um Nefilim te dá poderes psíquicos?"

# game/chapters/chapter2/script/ch2sc29.rpy:275
translate brazil ch2sc29_4ff1f489:

#   mc "*Chuckles* Not that I’m aware of."
    mc "*Risos* Que eu saiba, não."

# game/chapters/chapter2/script/ch2sc29.rpy:276
translate brazil ch2sc29_606e4835:

#   mc "I overheard someone talking about the capital when I was speaking to the innkeeper."
    mc "Enquanto conversava com o dono da pousada, ouvi alguém falando sobre a capital."

# game/chapters/chapter2/script/ch2sc29.rpy:278
translate brazil ch2sc29_317c6e97:

#   mc "Sounded like they were on a day trip to deliver some goods."
    mc "Parecia que eles estavam em uma viagem de um dia para entregar algumas mercadorias."

# game/chapters/chapter2/script/ch2sc29.rpy:280
translate brazil ch2sc29_fce18f18:

#   el "Then it should be close!"
    el "Então deve estar perto!"

# game/chapters/chapter2/script/ch2sc29.rpy:282
translate brazil ch2sc29_cf165430:

#   mc "Yeah, by the end of tomorrow we should arrive at the gates to the city."
    mc "Sim, até o final de amanhã devemos chegar aos portões da cidade."

# game/chapters/chapter2/script/ch2sc29.rpy:283
translate brazil ch2sc29_26e62116:

#   mc "I’m excited, honestly."
    mc "Estou animado, sinceramente."

# game/chapters/chapter2/script/ch2sc29.rpy:285
translate brazil ch2sc29_36075576:

#   el "Wait, how many ales did you have?"
    el "Espere, quantas cervejas você tomou?"

# game/chapters/chapter2/script/ch2sc29.rpy:287
translate brazil ch2sc29_bff3a6eb:

#   mc "One."
    mc "Um."

# game/chapters/chapter2/script/ch2sc29.rpy:288
translate brazil ch2sc29_6496aded:

#   mc "Why? Do I look drunk or something?"
    mc "Por quê? Será que eu pareço bêbado ou algo assim?"

# game/chapters/chapter2/script/ch2sc29.rpy:290
translate brazil ch2sc29_6032f378:

#   el "No, but-... You don't usually get excited about..."
    el "Não, mas... Você geralmente não se empolga com..."

# game/chapters/chapter2/script/ch2sc29.rpy:291
translate brazil ch2sc29_5ee21f3b:

#   el "Well, anything!"
    el "Bem, qualquer coisa!"

# game/chapters/chapter2/script/ch2sc29.rpy:293
translate brazil ch2sc29_e38632b0:

#   mc "Reaching the capital is the first big step towards my goal."
    mc "Chegar à capital é o primeiro grande passo rumo ao meu objetivo."

# game/chapters/chapter2/script/ch2sc29.rpy:295
translate brazil ch2sc29_5cdd1e87:

#   el "{b}Our{/b} goal."
    el "{b}Nosso{/b} meta."

# game/chapters/chapter2/script/ch2sc29.rpy:299
translate brazil ch2sc29_84f4573f:

#   el "It’s {b}our{/b} goal, [mc]."
    el "Isso é {b} nosso{/b} meta, [mc]."

# game/chapters/chapter2/script/ch2sc29.rpy:300
translate brazil ch2sc29_4a52027f:

#   el "You’re forgetting, the person who killed your parents is also the reason why my father left Mother and me."
    el "Você está se esquecendo de que a pessoa que matou seus pais também é a razão pela qual meu pai abandonou minha mãe e a mim."

# game/chapters/chapter2/script/ch2sc29.rpy:302
translate brazil ch2sc29_b9ae216c:

#   el "And that led to Mother drinking and whoring her sorrows away, and eventually leaving me all alone."
    el "E isso fez com que minha mãe afogasse as mágoas na bebida e na prostituição, e eventualmente me deixasse completamente sozinha."

# game/chapters/chapter2/script/ch2sc29.rpy:303
translate brazil ch2sc29_80c22f63:

#   el "He ruined my childhood as much as he did yours."
    el "Ele arruinou minha infância tanto quanto arruinou a sua."

# game/chapters/chapter2/script/ch2sc29.rpy:305
translate brazil ch2sc29_2b1982b6:

#   mc "You’re right."
    mc "Você tem razão."

# game/chapters/chapter2/script/ch2sc29.rpy:306
translate brazil ch2sc29_6fe78d4e:

#   mc "I’m sorry, Eliza. {b}Our{/b} goal."
    mc "Sinto muito, Eliza. {b} Nosso{/b} meta."

# game/chapters/chapter2/script/ch2sc29.rpy:308
translate brazil ch2sc29_045e3467:

#   el "I’ll drink to that! Cheers!"
    el "Brindo a isso! Saúde!"

# game/chapters/chapter2/script/ch2sc29.rpy:316
translate brazil ch2sc29_4b31d8ec:

#   el "UUaaaAAaahh! *Giggling*"
    el "UUaaaAAaahh! *Risos*"

# game/chapters/chapter2/script/ch2sc29.rpy:318
translate brazil ch2sc29_a20cefa7:

#   "..."
    "..."

# game/chapters/chapter2/script/ch2sc29.rpy:319
translate brazil ch2sc29_0fd4d656:

#   "......"
    "......"

# game/chapters/chapter2/script/ch2sc29.rpy:320
translate brazil ch2sc29_278c7e29:

#   "........."
    "........."

# game/chapters/chapter2/script/ch2sc29.rpy:322
translate brazil ch2sc29_6302ae72:

#   el "Hey, [mc]."
    el "Ei, [mc]."

# game/chapters/chapter2/script/ch2sc29.rpy:324
translate brazil ch2sc29_f49fff8f:

#   mc "Yeah?"
    mc "Sim?"

# game/chapters/chapter2/script/ch2sc29.rpy:326
translate brazil ch2sc29_6d2bd260:

#   el "Why don’t we..."
    el "Por que não fazemos isso...?"

# game/chapters/chapter2/script/ch2sc29.rpy:327
translate brazil ch2sc29_77d60003:

#   el "head upstairs?"
    el "Subir as escadas?"

# game/chapters/chapter2/script/ch2sc29.rpy:329
translate brazil ch2sc29_1c75b444:

#   mc "It's getting a little crowded down here..."
    mc "Está ficando um pouco lotado por aqui..."

# game/chapters/chapter2/script/ch2sc29.rpy:330
translate brazil ch2sc29_3e498f6b:

#   elt "*Giggling softly* Yeah... way too crowded."
    elt "*Risos baixinhos* É... muito cheio."

# game/chapters/chapter2/script/ch2sc29.rpy:332
translate brazil ch2sc29_a365df9e:

#   el "Follow me."
    el "Me siga."

# game/chapters/chapter2/script/ch2sc29.rpy:335
translate brazil ch2sc29_03dad947:

#   mc "Right behind you."
    mc "Logo atrás de você."

# game/chapters/chapter2/script/ch2sc29.rpy:337
translate brazil ch2sc29_30259fba:

#   el "Good, enjoy the view."
    el "Ótimo, aproveite a vista."

# game/chapters/chapter2/script/ch2sc29.rpy:339
translate brazil ch2sc29_47ddf053:

#   mc "We men are simple creatures..."
    mc "Nós, homens, somos criaturas simples..."

# game/chapters/chapter2/script/ch2sc29.rpy:340
translate brazil ch2sc29_bbdd1a29:

#   mc "You know how much I appreciate a good view."
    mc "Você sabe o quanto eu aprecio uma bela vista."

# game/chapters/chapter2/script/ch2sc29.rpy:342
