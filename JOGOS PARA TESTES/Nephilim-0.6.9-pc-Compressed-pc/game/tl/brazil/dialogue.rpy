    mc "Você é muito bom nisso!"

# game/chapters/chapter6/ch6sc3.rpy:1620
translate brazil ch6sc3_371c35fb:

#   sj "We learn to climb into the canopy of the jungle at the age of five. We master the art of vines by eight."
    sj "Aprendemos a subir na copa das árvores da selva aos cinco anos de idade. Dominamos a arte de usar cipós aos oito."

# game/chapters/chapter6/ch6sc3.rpy:1622
