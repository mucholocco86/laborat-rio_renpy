translate brazil ch7sc1_0ed33107:

#   lu "Maybe there’s going to be hot adventurer guys that you can work your charms on! *Snickers*"
    lu "Talvez você encontre uns aventureiros bonitões que te conquistem com seu charme! *Risos*"

# game/chapters/chapter7/ch7sc1.rpy:407
translate brazil ch7sc1_df8867f8:

