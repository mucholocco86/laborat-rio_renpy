# game/chapters/chapter3/script/ch3sc28.rpy:343
translate brazil ch3sc28_e0abf8c2:

#   el "*Sigh* Fine, I’m shivering cold... I can barely stand on my feet as is-"
    el "*Suspiro* Tudo bem, estou tremendo de frio... Mal consigo ficar de pé..."

# game/chapters/chapter3/script/ch3sc28.rpy:345
translate brazil ch3sc28_630c7282:

#   mc "Here, this will help."
    mc "Aqui, isto vai ajudar."

# game/chapters/chapter3/script/ch3sc28.rpy:348
translate brazil ch3sc28_7a5a8bf6:

#   "You rub your warm hands against her cold skin."
    "Você esfrega suas mãos quentes contra a pele fria dela."

# game/chapters/chapter3/script/ch3sc28.rpy:350
translate brazil ch3sc28_60b4d95e:

#   el "Nnnhh... that feels really... good."
    el "Nnnhh... isso é muito... bom."

# game/chapters/chapter3/script/ch3sc28.rpy:352
translate brazil ch3sc28_91e323e7:

#   mc "Yeah... It does."
    mc "Sim... Funciona mesmo."

# game/chapters/chapter3/script/ch3sc28.rpy:354
translate brazil ch3sc28_5589584a:

#   mc "Come on, let's get you out of here."
    mc "Vamos, vamos tirar você daqui."

# game/chapters/chapter3/script/ch3sc28.rpy:356
translate brazil ch3sc28_e8f97eab:

#   el "W-Wait!"
    el "E-Espere!"

# game/chapters/chapter3/script/ch3sc28.rpy:357
translate brazil ch3sc28_9966556c:

#   el "We should bring the old man... I think he’s been here a long time."
    el "Devíamos trazer o velho... Acho que ele está aqui há muito tempo."

# game/chapters/chapter3/script/ch3sc28.rpy:359
translate brazil ch3sc28_dee77d54:

#   mc "What old man?"
    mc "Que velho?"

# game/chapters/chapter3/script/ch3sc28.rpy:361
translate brazil ch3sc28_2efdb6eb:

#   el "Him!"
    el "Ele!"

# game/chapters/chapter3/script/ch3sc28.rpy:362
translate brazil ch3sc28_2237fce9:

#   el "Huh? I... I swear, there was an old guy in this cell with me."
    el "Hã? Eu... eu juro, tinha um senhor idoso nessa cela comigo."

# game/chapters/chapter3/script/ch3sc28.rpy:364
translate brazil ch3sc28_6e917317:

#   el "He kept rambling and muttering the same word over and over."
    el "Ele continuava divagando e murmurando a mesma palavra repetidamente."

# game/chapters/chapter3/script/ch3sc28.rpy:365
translate brazil ch3sc28_fc11020a:

#   el "Wibb this and wibble that... he wasn't making much sense, but he seemed... nice?"
    el "Falava isso e falava aquilo... ele não estava fazendo muito sentido, mas parecia... legal?"

# game/chapters/chapter3/script/ch3sc28.rpy:367
translate brazil ch3sc28_18686f87:

#   mc "Either way, he isn’t there now."
    mc "De qualquer forma, ele não está lá agora."

# game/chapters/chapter3/script/ch3sc28.rpy:368
translate brazil ch3sc28_f7fc5af8:

#   mc "Let’s go."
    mc "Vamos."

# game/chapters/chapter3/script/ch3sc28.rpy:370
translate brazil ch3sc28_6a275b2e:

#   el "Be ready for anything, [mc]."
    el "Esteja preparado para tudo, [mc]."

# game/chapters/chapter3/script/ch3sc28.rpy:371
translate brazil ch3sc28_90618b35:

#   el "The guy who took me, he knows us... and he wanted you to come for me."
    el "O cara que me levou, ele nos conhece... e queria que você viesse me buscar."

# game/chapters/chapter3/script/ch3sc28.rpy:373
translate brazil ch3sc28_8b5a61f5:

#   mc "Don't worry, if he shows his face, he'll regret it."
    mc "Não se preocupe, se ele der as caras, vai se arrepender."

# game/chapters/chapter3/script/ch3sc28.rpy:374
translate brazil ch3sc28_b67ba756:

#   el "Sheesh... that guy has seen better days."
    el "Puxa... esse cara já teve dias melhores."

# game/chapters/chapter3/script/ch3sc28.rpy:377
translate brazil ch3sc28_8c272561:

#   mct "Huh? The door is barricaded from the other side."
    mct "Hã? A porta está barricada do outro lado."

# game/chapters/chapter3/script/ch3sc28.rpy:380
translate brazil ch3sc28_34f5a91a:

#   el "*Shaky voice* Hnnh... [mc]?"
    el "*Voz trêmula* Hnnh... [mc]?"

# game/chapters/chapter3/script/ch3sc28.rpy:381
translate brazil ch3sc28_582359ea:

#   mc "Hm?"
    mc "Hum?"

# game/chapters/chapter3/script/ch3sc28.rpy:383
translate brazil ch3sc28_e57c7282:

#   el "Hrrhh!! Let go of me!"
    el "Hrrhh!! Me solta!"

# game/chapters/chapter3/script/ch3sc28.rpy:386
translate brazil ch3sc28_2f6f1370:

#   mc "{b}Release her!!{/b}"
    mc "{b}Libertem-na!!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:388
translate brazil ch3sc28_da1546d8:

#   ta "Ah, ah, ah! One wrong move, and I’ll break her fragile little neck."
    ta "Ah, ah, ah! Um movimento em falso e eu quebro o pescocinho frágil dela."

# game/chapters/chapter3/script/ch3sc28.rpy:389
translate brazil ch3sc28_d5aee5dd:

#   ta "Heh! Look at you... the mighty Nephilim brought to heel by a peasant girl!"
    ta "Heh! Olha só você... o poderoso Nefilim subjugado por uma camponesa!"

# game/chapters/chapter3/script/ch3sc28.rpy:390
translate brazil ch3sc28_2e0fe95b:

#   ta "Do you know who I am, freak?"
    ta "Você sabe quem eu sou, esquisito?"

# game/chapters/chapter3/script/ch3sc28.rpy:392
translate brazil ch3sc28_300e8425:

#   mc "You’re... ... you’re the one who killed my parents."
    mc "Você é... ...você é quem matou meus pais."

# game/chapters/chapter3/script/ch3sc28.rpy:394
translate brazil ch3sc28_414c96be:

#   ta "Bingo!"
    ta "Bingo!"

# game/chapters/chapter3/script/ch3sc28.rpy:395
translate brazil ch3sc28_b5b8da73:

#   ta "You’re not as dimwitted as you look!"
    ta "Você não é tão burro quanto parece!"

# game/chapters/chapter3/script/ch3sc28.rpy:397
translate brazil ch3sc28_f1151e7e:

#   mc "What the fuck do you want?"
    mc "Que porra você quer?"

# game/chapters/chapter3/script/ch3sc28.rpy:398
translate brazil ch3sc28_d4c4254e:

#   mc "Why did you kill my parents? All because of a bounty on me?"
    mc "Por que você matou meus pais? Tudo por causa de uma recompensa pela minha cabeça?"

# game/chapters/chapter3/script/ch3sc28.rpy:400
translate brazil ch3sc28_e4ed88e0:

#   ta "*Scoffs* Don’t make me laugh! Bounty on a ten year old child? You're so naive..."
    ta "*Risos* Não me faça rir! Recompensa pela cabeça de uma criança de dez anos? Você é tão ingênuo..."

# game/chapters/chapter3/script/ch3sc28.rpy:401
translate brazil ch3sc28_fa201958:

#   ta "No, no... my plans for you far surpass what your simple beast-like mind can comprehend."
    ta "Não, não... meus planos para você vão muito além do que sua mente simplória e bestial pode compreender."

# game/chapters/chapter3/script/ch3sc28.rpy:404
translate brazil ch3sc28_133aabb6:

#   mc "Release her! She has nothing to do with this."
    mc "Libertem-na! Ela não tem nada a ver com isso."

# game/chapters/chapter3/script/ch3sc28.rpy:406
translate brazil ch3sc28_42dd2749:

#   ta "Oh, but she does... just like with your parents."
    ta "Ah, mas ela faz sim... exatamente como faz com seus pais."

# game/chapters/chapter3/script/ch3sc28.rpy:407
translate brazil ch3sc28_66c5036a:

#   ta "She will play her part to perfection... the part of growing your hatred!"
    ta "Ela desempenhará seu papel com perfeição... o papel de alimentar seu ódio!"

# game/chapters/chapter3/script/ch3sc28.rpy:409
translate brazil ch3sc28_14a9fd9a:

#   mc "You killed my parents... just to make me angry?!"
    mc "Você matou meus pais... só para me provocar?!"

# game/chapters/chapter3/script/ch3sc28.rpy:411
translate brazil ch3sc28_018ac5ed:

#   ta "Two for two!"
    ta "Dois por dois!"

# game/chapters/chapter3/script/ch3sc28.rpy:412
translate brazil ch3sc28_4805f83a:

#   ta "I guess even a monster like you can do simple math!"
    ta "Acho que até um monstro como você consegue fazer contas simples!"

# game/chapters/chapter3/script/ch3sc28.rpy:415
translate brazil ch3sc28_e8f669cf:

#   mc "Why... {b}WHY?!{/b}"
    mc "Por que... {b} POR QUE?!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:417
translate brazil ch3sc28_94a90df6:

#   ta "It’s simple, really. You were taking too long in gaining your strength."
    ta "É simples, na verdade. Você estava demorando muito para ganhar força."

# game/chapters/chapter3/script/ch3sc28.rpy:418
translate brazil ch3sc28_6db524f4:

#   ta "Your soft childhood and loving parents made you weak."
    ta "Sua infância tranquila e seus pais amorosos te deixaram fraco."

# game/chapters/chapter3/script/ch3sc28.rpy:420
translate brazil ch3sc28_80f17ded:

#   ta "So, I took it upon myself to create a reason for you to become stronger."
    ta "Então, tomei a iniciativa de criar um motivo para você se tornar mais forte."

# game/chapters/chapter3/script/ch3sc28.rpy:421
translate brazil ch3sc28_1fee7ed1:

#   ta "It seems killing your parents set you on the right track, but you’re still taking your sweet time"
    ta "Parece que matar seus pais te colocou no caminho certo, mas você ainda está levando o seu tempo."

# game/chapters/chapter3/script/ch3sc28.rpy:423
translate brazil ch3sc28_05a3197c:

#   ta "I suppose I should have killed everyone in that little village of yours..."
    ta "Acho que eu deveria ter matado todos naquela sua pequena vila..."

# game/chapters/chapter3/script/ch3sc28.rpy:424
translate brazil ch3sc28_8ce10c93:

#   ta "Maybe that would have given you the proper motivation?"
    ta "Talvez isso lhe tivesse dado a motivação necessária?"

# game/chapters/chapter3/script/ch3sc28.rpy:426
translate brazil ch3sc28_a9ce4e5d:

#   ta "But I guess I’ll have to settle for this young girl, who you seem to care for so deeply."
    ta "Mas acho que terei que me contentar com esta jovem, por quem você parece ter tanto carinho."

# game/chapters/chapter3/script/ch3sc28.rpy:427
translate brazil ch3sc28_5427fc88:

#   ta "Maybe this time, you'll do a better job of unlocking your powers."
    ta "Talvez desta vez você consiga desbloquear melhor seus poderes."

# game/chapters/chapter3/script/ch3sc28.rpy:429
translate brazil ch3sc28_856ea9af:

#   mc "If you hurt her-"
    mc "Se você a magoar-"

# game/chapters/chapter3/script/ch3sc28.rpy:431
translate brazil ch3sc28_52b80dbb:

#   el "Hnhhrh!"
    el "Hhhhh!"

# game/chapters/chapter3/script/ch3sc28.rpy:434
translate brazil ch3sc28_0e94b3d4:

#   el "*Screams* {b}Ahhhrhhh!{/b}"
    el "*Gritos* {b} Ahhhrhhh!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:439
translate brazil ch3sc28_c7652a6c:

#   el "*Screams in agony* {b}Ahhhrhhh! Hrrraahh!{/b}"
    el "*Gritos de agonia* {b} Ahhhrhhh! Hrrraahh!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:440
translate brazil ch3sc28_fd86ec62:

#   "The sound of Eliza's spine snapping echoes through the dungeon."
    "O som da espinha de Eliza se quebrando ecoa pela masmorra."

# game/chapters/chapter3/script/ch3sc28.rpy:443
translate brazil ch3sc28_30fec516:

#   mc "{b}ELIZA!!{/b}"
    mc "{b}ELIZA!!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:445
translate brazil ch3sc28_de1250ea:

#   ta "See you later..."
    ta "Até mais..."

# game/chapters/chapter3/script/ch3sc28.rpy:452
translate brazil ch3sc28_5aa0997a:

#   mc "E-Eliza! Wake up... Wake up right now you hear me?!"
    mc "E-Eliza! Acorde... Acorde agora mesmo, está me ouvindo?!"

# game/chapters/chapter3/script/ch3sc28.rpy:453
translate brazil ch3sc28_d002127a:

#   mc "No... No, no, {b}no!{/b}"
    mc "Não... Não, não, {b} Não!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:454
translate brazil ch3sc28_df1af554:

#   mc "Eliza?? Please... Please don't leave me."
    mc "Eliza?? Por favor... Por favor, não me deixe."

# game/chapters/chapter3/script/ch3sc28.rpy:457
translate brazil ch3sc28_889e55a7:

#   mc "T-There’s no way! {b}THERE’S NO WAY YOU DIE IN MY ARMS!!{/b}"
    mc "N-Não tem jeito! {b} NÃO HÁ A MENOR CHANCE DE VOCÊ MORRER EM MEUS BRAÇOS!!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:459
translate brazil ch3sc28_3edc7667:

#   mc "{b}AFTER ALL WE BEEN THROUGH! THIS IS NOT HOW IT ENDS!!{/b}"
    mc "{b}DEPOIS DE TUDO QUE PASSAMOS! NÃO É ASSIM QUE TERMINA!!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:462
translate brazil ch3sc28_30a85f33:

#   mc "To the same guy who murdered my parents!! {b}THERE’S NO WAY, YOU HEAR ME?!{/b}"
    mc "Para o mesmo cara que assassinou meus pais!! {b} NÃO ACREDITO, VOCÊ ME OUVIU?!{/b}"

# game/chapters/chapter3/script/ch3sc28.rpy:464
translate brazil ch3sc28_a8469146:

#   mct "Please, Eliza. I’ll do anything... Anything you want. {b}Please wake up!{/b}"
    mct "Por favor, Eliza. Eu farei qualquer coisa... Qualquer coisa que você quiser. {b} Por favor, acorde!{/b}"



# ARQUIVO: game/chapters/chapter3/script/ch3sc26.rpy DIALOGOS: 18


# game/chapters/chapter3/script/ch3sc26.rpy:10
translate brazil ch3sc26_6fc87384:

#   uk "Sir, the target has completed the second quest."
    uk "Senhor, o alvo concluiu a segunda missão."

# game/chapters/chapter3/script/ch3sc26.rpy:11
translate brazil ch3sc26_d6c84f93:

#   uk "Just as you suspected, Dalen assigned them to the goblins."
    uk "Como você suspeitava, Dalen os designou aos goblins."

# game/chapters/chapter3/script/ch3sc26.rpy:13
translate brazil ch3sc26_dc2c58f0:

#   ta "Of course he did..."
    ta "É claro que sim..."

# game/chapters/chapter3/script/ch3sc26.rpy:14
translate brazil ch3sc26_8d66f639:

#   ta "I know him well."
    ta "Eu o conheço bem."

# game/chapters/chapter3/script/ch3sc26.rpy:16
translate brazil ch3sc26_f150bdcc:

#   uk "Sir, how did you know he would assign them?"
    uk "Senhor, como o senhor sabia que ele os designaria?"

# game/chapters/chapter3/script/ch3sc26.rpy:18
translate brazil ch3sc26_483da1ee:

#   ta "It’s simple. Dalen sees potential in him."
    ta "É simples. Dalen vê potencial nele."

# game/chapters/chapter3/script/ch3sc26.rpy:19
translate brazil ch3sc26_f27240a6:

#   ta "So, all I had to do was devise a scenario where his abilities could be tested."
    ta "Então, tudo o que eu precisava fazer era criar um cenário onde suas habilidades pudessem ser testadas."

# game/chapters/chapter3/script/ch3sc26.rpy:21
translate brazil ch3sc26_48fc11bb:

#   uk "Clever, sir."
    uk "Inteligente, senhor."

# game/chapters/chapter3/script/ch3sc26.rpy:22
translate brazil ch3sc26_03787059:

#   uk "Should we still proceed as planned?"
    uk "Devemos prosseguir conforme planejado?"

# game/chapters/chapter3/script/ch3sc26.rpy:24
translate brazil ch3sc26_5d5d8551:

#   ta "Yes. The time for idling has passed... it’s time to act."
    ta "Sim. O tempo de ficar parado já passou... é hora de agir."

# game/chapters/chapter3/script/ch3sc26.rpy:25
translate brazil ch3sc26_c83261b0:

#   ta "Don’t disappoint me."
    ta "Não me decepcione."

# game/chapters/chapter3/script/ch3sc26.rpy:26
translate brazil ch3sc26_799a6dbd:

#   ta "You know what happens to those who do."
    ta "Você sabe o que acontece com quem faz isso."

# game/chapters/chapter3/script/ch3sc26.rpy:28
translate brazil ch3sc26_45a5a434:

#   uk "S-Sir!"
    uk "S-Senhor!"

# game/chapters/chapter3/script/ch3sc26.rpy:30
translate brazil ch3sc26_10020388:

#   ta "Go inform our little dove, make sure to remind her what happens if she doesn't play her part to perfection."
    ta "Vá informar nossa pequena pomba, certifique-se de lembrá-la do que acontece se ela não desempenhar seu papel com perfeição."

# game/chapters/chapter3/script/ch3sc26.rpy:31
translate brazil ch3sc26_712d9375:

#   ta "Cold feet is not an option if she wants to protect what matters most to her."
    ta "Ceder ao medo não é uma opção se ela quiser proteger o que é mais importante para ela."

# game/chapters/chapter3/script/ch3sc26.rpy:33
translate brazil ch3sc26_bf4e18fc:

#   uk "S-Sir! I'll instruct the bitch at once!"
    uk "Senhor! Vou instruir a cadela imediatamente!"

# game/chapters/chapter3/script/ch3sc26.rpy:34
translate brazil ch3sc26_ad5413a1:

#   uk "She'll comply or we'll turn up the heat on her sist-"
    uk "Ela vai obedecer ou vamos aumentar a pressão sobre a irmã dela."

# game/chapters/chapter3/script/ch3sc26.rpy:36
translate brazil ch3sc26_545aafc8:

#   ta "Leave. Just get it done."
    ta "Vá embora. Simplesmente termine o que está fazendo."



