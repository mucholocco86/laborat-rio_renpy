translate brazil ch5sc2_ef3198a1:

#   mc "Missed you? So-so, I suppose."
    mc "Senti sua falta? Mais ou menos, eu acho."

# game/chapters/chapter5/script/ch5sc2.rpy:3000
translate brazil ch5sc2_faeee619:

#   sy "That’s not funny! Not in the slightest! Hmfph!"
