#   el "*Snickers* Oh, I can, and I will! We are getting you clothed today one way or another!"
    el "*Risos* Ah, eu posso, e vou! Vamos te vestir hoje de um jeito ou de outro!"

# game/chapters/chapter7/ch7sc1.rpy:470
translate brazil ch7sc1_48705411:

#   el "Please be sweet to her… this is my favorite shop in the city."
    el "Por favor, seja gentil com ela... esta é a minha loja favorita na cidade."

