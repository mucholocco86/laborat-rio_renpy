#   sl "A-Are you sure?"
    sl "Tem certeza?"

# game/chapters/chapter3/script/ch3sc10.rpy:211
translate brazil ch3sc10_a01f8260:

#   sl "That was so scary!"
    sl "Foi muito assustador!"

# game/chapters/chapter3/script/ch3sc10.rpy:213
