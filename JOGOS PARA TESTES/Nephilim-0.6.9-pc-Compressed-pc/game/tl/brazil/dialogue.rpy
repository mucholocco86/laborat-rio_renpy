translate brazil ch2sc19_nz_cd7515c4:

#   el "Yes! I- no..."
    el "Sim! Eu... não..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:964
translate brazil ch2sc19_nz_21277c7e:

#   el "I mean- I do, if you do?"
    el "Quer dizer, eu quero, se você quiser?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:969
translate brazil ch2sc19_nz_b851afde:

#   mc "Come here!"
    mc "Venha aqui!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:970
translate brazil ch2sc19_nz_0e8ab570:

#   mc "It's about time we get you tucked in."
    mc "Já está na hora de te colocar na cama."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:972
translate brazil ch2sc19_nz_7873101d:

#   el "H-Hey! You big brute!"
    el "Ei! Seu brutamontes!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:975
translate brazil ch2sc19_nz_17d23031:

#   el "That eager, huh?"
    el "Tão ansioso, hein?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:977
translate brazil ch2sc19_nz_e334e13f:

#   mc "Something like that."
    mc "Algo assim."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:984
translate brazil ch2sc19_nz_8d99500e:

#   el "Really? You don’t mind?"
    el "Sério? Você não se importa?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:986
translate brazil ch2sc19_nz_ac84eeac:

#   mc "Eliza, I’ve been thinking about having you in my arms again since this morning."
    mc "Eliza, tenho pensado em te ter em meus braços novamente desde esta manhã."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:987
translate brazil ch2sc19_nz_45488c87:

#   mc "I obviously don't mind."
    mc "Obviamente, não me importo."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:989
translate brazil ch2sc19_nz_bd049d86:

#   el "Uh! Okay! Then you should probably cuddle me all night!"
    el "Ah! Ok! Então você provavelmente deveria me abraçar a noite toda!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:990
translate brazil ch2sc19_nz_76eaa6b1:

#   el "And you should keep me close!"
    el "E você deve me manter por perto!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:992
translate brazil ch2sc19_nz_bb221018:

#   el "Else you risk me getting cold."
    el "Caso contrário, você corre o risco de eu ficar com frio."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:994
translate brazil ch2sc19_nz_43397280:

#   mc "I’m not taking my hands off you until we wake up."
    mc "Não vou tirar as minhas mãos de você até acordarmos."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:996
translate brazil ch2sc19_nz_178af824:

#   el "Promise?"
    el "Promessa?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:998
translate brazil ch2sc19_nz_e8b3c062:

#   mc "Promise."
    mc "Promessa."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1000
translate brazil ch2sc19_nz_cb596dd0:

#   el "*Giggling happily* Good! I’ll hold you to that."
    el "*Risos de alegria* Ótimo! Vou cobrar isso de você."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1002
translate brazil ch2sc19_nz_a56885d2:

#   elt "I feel so protected in his arms."
    elt "Eu me sinto tão protegida em seus braços."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1003
translate brazil ch2sc19_nz_18c8eea4:

#   elt "Like nothing in the world can get me. It’s just me and [mc]."
    elt "Nada no mundo pode me pegar. Só existe eu e... [mc]."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1004
translate brazil ch2sc19_nz_a0c26298:

#   elt "I-I just want to be near him and protect him."
    elt "Eu só quero estar perto dele e protegê-lo."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1005
translate brazil ch2sc19_nz_1e9cb03a:

#   elt "I want to make him happy, the way he makes me happy."
    elt "Quero fazê-lo feliz, da mesma forma que ele me faz feliz."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1007
translate brazil ch2sc19_nz_a1a43e70:

#   elt "I won’t let anyone hurt him."
    elt "Não vou deixar ninguém machucá-lo."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1008
translate brazil ch2sc19_nz_f3254efc:

#   elt "When we reach the capital, there will be no shortage of people wanting to take advantage of him."
    elt "Quando chegarmos à capital, não faltarão pessoas querendo tirar vantagem dele."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1009
translate brazil ch2sc19_nz_179f55f8:

#   elt "I’ll have to stay alert."
    elt "Preciso ficar alerta."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1011
translate brazil ch2sc19_nz_8593ba9c:

#   el "So..."
    el "Então..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1013
translate brazil ch2sc19_nz_3f871f46:

#   mc "Hmm?"
    mc "Hum?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1015
translate brazil ch2sc19_nz_d859fc71:

#   el "What’s the verdict?"
    el "Qual é o veredicto?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1017
translate brazil ch2sc19_nz_7d124b45:

#   mc "On what?"
    mc "Em quê?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1019
translate brazil ch2sc19_nz_7f38a931:

#   el "You know... I said earlier you'd find out if I really smell like flowers or not. Why don’t you find out?"
    el "Sabe... eu disse antes que você descobriria se eu realmente cheiro a flores ou não. Por que você não descobre?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1021
translate brazil ch2sc19_nz_14bafaf2:

#   mc "*Inhales deeply* . .. ..."
    mc "*Inspira profundamente* . .. ..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1023
translate brazil ch2sc19_nz_961baa32:

#   el "*Giggles* H-Hey, that tickles!"
    el "*Risos* Ei, isso faz cócegas!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1025
translate brazil ch2sc19_nz_1878ae5c:

#   mc "*Inhales deeply* Mmmh..."
    mc "*Inspira profundamente* Hum..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1027
translate brazil ch2sc19_nz_193988e6:

#   el "*Giggling* Oh that feels-... mmh-hm..."
    el "*Risos* Ah, isso parece... hum..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1029
translate brazil ch2sc19_nz_8c1cc3ec:

#   el "So... what do you think?"
    el "Então... o que você acha?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1031
translate brazil ch2sc19_nz_d4a3c3f2:

#   mc "You smell like morning."
    mc "Você tem cheiro de manhã."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1033
translate brazil ch2sc19_nz_1e31dfb2:

#   el "Huh? Are you sure you didn’t smell the grass instead."
    el "Hein? Tem certeza de que não sentiu cheiro de grama?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1035
translate brazil ch2sc19_nz_91265372:

#   mc "Let me explain. Imagine waking up at dawn, just before sunrise."
    mc "Deixe-me explicar. Imagine acordar ao amanhecer, pouco antes do nascer do sol."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1036
translate brazil ch2sc19_nz_b85b6012:

#   mc "You step into a field of early spring flowers, in your case it would be Dreamveil & Sunroot."
    mc "Você entra num campo de flores da primavera, no seu caso seriam Dreamveil e Sunroot."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1038
translate brazil ch2sc19_nz_b77994cb:

#   mc "The morning dew is trickling down the leaves, and a chilly breeze brings your senses alive with the smell of a new day... Morning."
    mc "O orvalho da manhã escorre pelas folhas, e uma brisa fria desperta os sentidos com o aroma de um novo dia... Manhã."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1039
translate brazil ch2sc19_nz_9242aa7d:

#   mc "That’s how you smell."
    mc "É assim que você cheira."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1042
translate brazil ch2sc19_nz_7daa7785:

#   elt "Heavens! I'm going to melt!!!"
    elt "Meu Deus! Vou derreter!!!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1044
translate brazil ch2sc19_nz_e918f41e:

#   el "I-I... Thank you, [mc]."
    el "II... Obrigado, [mc]."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1046
translate brazil ch2sc19_nz_bef511e1:

#   el "You really have a way with words, don’t you?"
    el "Você tem mesmo um jeito especial com as palavras, não é?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1048
translate brazil ch2sc19_nz_ac4cab33:

#   elt "I feel all giddy after that description. Didn't expect that from him."
    elt "Fiquei toda eufórica depois dessa descrição. Não esperava isso dele."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1050
translate brazil ch2sc19_nz_3707ab71:

#   el "Did you-"
    el "Você fez-"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1052
translate brazil ch2sc19_nz_c1683c93:

#   mc "Yes, I liked it."
    mc "Sim, eu gostei."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1054
translate brazil ch2sc19_nz_1ddaedc8:

#   el "I-I won’t mind if you want to... sniff me again..."
    el "Não me importarei se você quiser... me cheirar de novo..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1056
translate brazil ch2sc19_nz_b3466473:

#   "You gently strafe her smooth neck with the tip of your nose while inhaling."
    "Você roça suavemente a ponta do nariz no pescoço liso dela enquanto inspira."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1057
translate brazil ch2sc19_nz_0bb2ecee:

#   mct "Divines grant me strength. Her scent is the single most intoxicating thing I’ve ever come across."
    mct "As divindades me concedem força. Seu perfume é a coisa mais inebriante que já senti."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1058
translate brazil ch2sc19_nz_a52aec82:

#   mc "*Whispers* {size=-10}{b}Goodnight, kitten.{/b}{/size}"
    mc "*Sussurros* {size=-10}{b}Boa noite, gatinho(a).{/b}{/size}"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1060
translate brazil ch2sc19_nz_12722d85:

#   el "*Purrs* {size=-10}{b}Goodnight, [mc]. Nnh-Nyahh...{/b}{/size}"
    el "*Ronrona* {size=-10}{b}Boa noite, [mc] Nnh-Nyahh...{/b}{/size}"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1068
translate brazil ch2sc19_nz_18f90f52:

#   mc "Tell you what: IF we wake up freezing, I’ll consider it."
    mc "Quer saber? Se acordarmos congelando, eu penso no assunto."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1073
translate brazil ch2sc19_nz_d97ad47e:

#   el "Night, night!"
    el "Boa noite!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1076
translate brazil ch2sc19_nz_e8b5fe03:

#   mc "Goodnight."
    mc "Boa noite."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1084
translate brazil ch2sc19_nz_9bd89949:

#   mct "As far as sleeping on the ground goes... this wasn't half-bad."
    mct "Considerando que já dormi no chão... até que não foi tão ruim."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1087
translate brazil ch2sc19_nz_29a41ced:

#   mct "Seems like I'm the last one to arise today."
    mct "Parece que fui o último a acordar hoje."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1090
translate brazil ch2sc19_nz_fff75004:

#   mct "Usually she's the one sleeping in."
    mct "Geralmente é ela quem dorme até mais tarde."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1092
translate brazil ch2sc19_nz_5d0c31e2:

#   mct "I wonder why she’s up early today?"
    mct "Será que ela acordou cedo hoje?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1094
translate brazil ch2sc19_nz_182c64aa:

#   mc "*Yawn* Hnnngh!"
    mc "*Bocejo* Hnnngh!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1096
translate brazil ch2sc19_nz_03b5ed3f:

#   mct "I better go look for her."
    mct "É melhor eu ir procurá-la."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1098
translate brazil ch2sc19_nz_829b7e3a:

#   mct "I have a feeling about where she might have gone."
    mct "Tenho um palpite sobre para onde ela pode ter ido."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1099
translate brazil ch2sc19_nz_f6526811:

#   mct "Sleeping on the ground, even after we made the campsite, she'd be a little dirty again."
    mct "Dormindo no chão, mesmo depois de montarmos o acampamento, ela ainda ficava um pouco suja de novo."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1112
translate brazil ch2sc19_nz_574de77e:

#   el "{b}[mc]!!{/b}"
    el "{b}[mc]!!{/b}"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1114
translate brazil ch2sc19_nz_c96642c6:

#   mc "."
    mc "."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1115
translate brazil ch2sc19_nz_3e0c0ef9:

#   mc ".."
    mc "..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1117
translate brazil ch2sc19_nz_f85984b8:

#   mc "Why’d you stop?"
    mc "Por que você parou?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1119
translate brazil ch2sc19_nz_4ce7a381:

#   el "'Cause you’re drooling."
    el "Porque você está babando."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1120
translate brazil ch2sc19_nz_59123411:

#   el "If I didn't know better I'd say you've seen the love of your life! *Snickering*"
    el "Se eu não soubesse, diria que você encontrou o amor da sua vida! *Risinhos*"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1122
translate brazil ch2sc19_nz_1f84f540:

#   mc "*Chuckles* You wish."
    mc "*Risos* Quem dera."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1123
translate brazil ch2sc19_nz_2a9b8646:

#   mc "I’m just... enjoying the scenery."
    mc "Estou apenas... apreciando a paisagem."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1125
translate brazil ch2sc19_nz_cf4a172f:

#   el "I think you’ve seen plenty for now!"
    el "Acho que você já viu o suficiente por agora!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1126
translate brazil ch2sc19_nz_3aa1bd86:

#   el "At least try to act like a gentleman, and turn around."
    el "Ao menos tente agir como um cavalheiro e dê meia-volta."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1128
translate brazil ch2sc19_nz_502cba8d:

#   mc "Sure, just hurry up."
    mc "Claro, só se apresse."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1130
translate brazil ch2sc19_nz_c02e1be7:

#   el "So bossy."
    el "Tão mandona."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1131
translate brazil ch2sc19_nz_3386444b:

#   el "Didn’t you sleep well last night?"
    el "Você não dormiu bem na noite passada?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1133
translate brazil ch2sc19_nz_d600aa27:

#   el "It sure felt like you did, based on what was pressing against me this morning."
    el "Com certeza foi a mesma sensação que você, baseada no que estava me pressionando esta manhã."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1134
translate brazil ch2sc19_nz_51c66745:

#   mc "*Chuckles* Sorry."
    mc "*Risos* Desculpe."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1136
translate brazil ch2sc19_nz_1f9ad4d1:

#   el "Don’t be sorry. I took it as a compliment."
    el "Não precisa se desculpar. Eu interpretei como um elogio."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1138
translate brazil ch2sc19_nz_59e3b556:

#   mc "Good. It’s not like I have any control over something like that."
    mc "Ótimo. Não é como se eu tivesse algum controle sobre algo assim."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1140
translate brazil ch2sc19_nz_10285d76:

#   mc "Especially... sleeping next to you."
    mc "Principalmente... dormir ao seu lado."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1142
translate brazil ch2sc19_nz_0b0b4065:

#   elt "Awwh, He's so cute when he gets shy!"
    elt "Ah, ele fica tão fofo quando fica tímido!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1144
translate brazil ch2sc19_nz_49aad68e:

#   el "Good to know I have that effect on you."
    el "Que bom saber que tenho esse efeito sobre você."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1145
translate brazil ch2sc19_nz_1edcae27:

#   el "In fact it made me want to remain in your arms longer, but I had to take the chance to wash off the dirt."
    el "Na verdade, isso me fez querer ficar mais tempo em seus braços, mas eu precisava aproveitar a oportunidade para me lavar."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1146
translate brazil ch2sc19_nz_e08d0519:

#   el "Since we don't know when we'll next pass a river or lake again."
    el "Já que não sabemos quando voltaremos a passar por um rio ou lago."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1149
translate brazil ch2sc19_nz_b6b7fcc7:

#   el "{b}Hyuuuah!{/b}"
    el "{b}Huuuah!{/b}"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1150
translate brazil ch2sc19_nz_3a5fc1c2:

#   el "Kitten-attack! *Giggling*"
    el "Ataque de gatinho! *Risos*"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1152
translate brazil ch2sc19_nz_7773bf12:

#   mc "You ready? The sooner we get moving, the faster we reach the capital."
    mc "Preparados? Quanto mais cedo começarmos, mais rápido chegaremos à capital."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1154
translate brazil ch2sc19_nz_9ae63802:

#   el "Hey, you shouldn’t rush a lady!"
    el "Ei, não se deve apressar uma dama!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1155
translate brazil ch2sc19_nz_b596aeac:

#   el "Heavens, did my father really not teach you any manners?"
    el "Céus, será que meu pai realmente não te ensinou boas maneiras?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1161
translate brazil ch2sc19_nz_63c17b2e:

#   mc "It wasn’t exactly on his list, no."
    mc "Não estava exatamente na lista dele, não."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1162
translate brazil ch2sc19_nz_7c3010a0:

#   mc "Your father taught me a lot of things, but how to socialize? That wasn't his strength."
    mc "Seu pai me ensinou muitas coisas, mas como socializar? Esse não era o forte dele."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1164
translate brazil ch2sc19_nz_948359f8:

#   el "*Sigh* Well, then..."
    el "*Suspiro* Bem, então..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1165
translate brazil ch2sc19_nz_aca2c4e2:

#   el "I suppose I’ll have to teach you, better late than never!"
    el "Acho que terei que te ensinar, antes tarde do que nunca!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1167
translate brazil ch2sc19_nz_b7dc80b9:

#   mc "Thanks, I’m good."
    mc "Obrigado, estou bem."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1168
translate brazil ch2sc19_nz_beeb5237:

#   mc "Now let’s go."
    mc "Vamos lá."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1170
translate brazil ch2sc19_nz_34ca0afb:

#   el "Don’t be so stubborn!"
    el "Não seja tão teimoso!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1171
translate brazil ch2sc19_nz_1621d5d4:

#   el "Don't underestimate how much manners and public perception can help you in social situations."
    el "Não subestime o quanto boas maneiras e a percepção pública podem te ajudar em situações sociais."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1173
translate brazil ch2sc19_nz_c8a8bdd3:

#   el "We’re going to the capital, Luxenford, right?"
    el "Vamos para a capital, Luxemburgo, certo?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1174
translate brazil ch2sc19_nz_465cbabc:

#   el "That means a lot of high profile nobles, merchants, and guilds..."
    el "Isso significa muitos nobres, mercadores e guildas de alto escalão..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1175
translate brazil ch2sc19_nz_54aca98c:

#   el "Not to mention the royal family! {b}House Valois.{/b}"
    el "Sem falar da família real! {b} Casa Valois.{/b}"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1177
translate brazil ch2sc19_nz_9bc3cc33:

#   el "Social skills will be very important when it comes to dealing with these types of people."
    el "Habilidades sociais serão muito importantes ao lidar com esse tipo de pessoa."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1179
translate brazil ch2sc19_nz_631899e4:

#   mc "Hmmh, you actually have a point. *Sighs*"
    mc "Hum, você tem razão. *Suspiro*"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1181
translate brazil ch2sc19_nz_68362b10:

#   el "I don’t know whether to be happy that you agree with me, or insulted that you seem so surprised."
    el "Não sei se fico feliz por você concordar comigo ou se me sinto insultado por você parecer tão surpreso."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1183
translate brazil ch2sc19_nz_674db0c8:

#   mc "No, really."
    mc "Não, sério."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1184
translate brazil ch2sc19_nz_cecf12a7:

#   mc "You came up with a great idea, Eliza."
    mc "Você teve uma ótima ideia, Eliza."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1188
translate brazil ch2sc19_nz_17891f34:

#   el "Thank you, [mc]."
    el "Obrigado, [mc]."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1189
translate brazil ch2sc19_nz_ea558932:

#   el "So, I’ll start teaching you proper social etiquette on the way."
    el "Então, vou começar a te ensinar a etiqueta social adequada ao longo do caminho."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1191
translate brazil ch2sc19_nz_de34399c:

#   el "You’ll be ready for lavish parties with high ranking officials in no time! *Giggling*"
    el "Em pouco tempo você estará pronto para festas luxuosas com autoridades de alto escalão! *Risos*"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1193
translate brazil ch2sc19_nz_24d141c9:

#   mc "How do you even know all this?"
    mc "Como você sabe de tudo isso?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1195
translate brazil ch2sc19_nz_6627ad24:

#   el "I know it’s not exactly common for commoners... like me."
    el "Eu sei que não é exatamente comum para pessoas comuns... como eu."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1196
translate brazil ch2sc19_nz_ac857ff3:

#   el "My mother taught me, though."
    el "Mas foi minha mãe quem me ensinou."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1197
translate brazil ch2sc19_nz_701761b1:

#   el "She said if I were to get anywhere in life, I'd need to know, in order to marry a proper man."
    el "Ela disse que, se eu quisesse chegar a algum lugar na vida, precisaria saber disso para poder me casar com um homem decente."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1199
translate brazil ch2sc19_nz_390ce92a:

#   mc "Makes sense, I suppose."
    mc "Faz sentido, suponho."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1201
translate brazil ch2sc19_nz_4543f678:

#   el "Hmhf. I-I don’t want that, though."
    el "Hmhf. Mas eu não quero isso."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1202
translate brazil ch2sc19_nz_2767aabc:

#   el "I don’t need some fancy-pants nobleman with a stick up his ass to take care of me."
    el "Eu não preciso de nenhum nobre metido a besta com um cabo de vassoura enfiado no rabo para cuidar de mim."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1204
translate brazil ch2sc19_nz_352bfc09:

#   mc "I know, Eliza."
    mc "Eu sei, Eliza."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1206
translate brazil ch2sc19_nz_827edf15:

#   mct "*Chuckles* Does she realize she's squeezing my arm tighter with every word?"
    mct "*Risos* Será que ela percebe que está apertando meu braço com mais força a cada palavra?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1208
translate brazil ch2sc19_nz_6de29542:

#   el "Some-some two-faced, rich, wine sipping... {b}Urgh!{/b}"
    el "Algum tipo de pessoa de duas caras, rica, que adora vinho... {b} Urgh!{/b}"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1212
translate brazil ch2sc19_nz_cfcc2293:

#   mc "I know."
    mc "Eu sei."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1214
translate brazil ch2sc19_nz_958a8fec:

#   el "Y-You do?"
    el "S-Sério?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1216
translate brazil ch2sc19_nz_278c2447:

#   mc "Yes... None of that appeals to you."
    mc "Sim... Nada disso te agrada."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1217
translate brazil ch2sc19_nz_631e8b0b:

#   mc "That would be a safe life."
    mc "Essa seria uma vida segura."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1218
translate brazil ch2sc19_nz_ca575e05:

#   mc "A tedious, boring, vanilla life, it'd fit most people."
    mc "Uma vida tediosa, monótona e sem graça, que serviria para a maioria das pessoas."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1219
translate brazil ch2sc19_nz_77838384:

#   mc "You aren’t like most people, though... That would never be enough for you."
    mc "Você não é como a maioria das pessoas... Isso nunca seria suficiente para você."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1221
translate brazil ch2sc19_nz_0893f1aa:

#   el "I-"
    el "EU-"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1223
translate brazil ch2sc19_nz_c8b2821d:

#   elt "He really knows me well."
    elt "Ele me conhece muito bem."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1225
translate brazil ch2sc19_nz_095cd972:

#   mc "You crave adventure, you enjoy the thrill of what each day might bring."
    mc "Você anseia por aventura, você gosta da emoção do que cada dia pode trazer."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1226
translate brazil ch2sc19_nz_e846b6d1:

#   mc "But above all, you want what you’ve never had."
    mc "Mas, acima de tudo, você quer aquilo que nunca teve."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1228
translate brazil ch2sc19_nz_bb9907fe:

#   el "Mmmh... what I’ve never had?"
    el "Hum... o que eu nunca experimentei?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1232
translate brazil ch2sc19_nz_374e8b99:

#   mc "Passion."
    mc "Paixão."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1234
translate brazil ch2sc19_nz_b903728b:

#   elt "He's right! I've never had passion in my life... until I met you, [mc]."
    elt "Ele tem razão! Eu nunca tive paixão na minha vida... até te conhecer. [mc]."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1235
translate brazil ch2sc19_nz_7113bfb2:

#   elt "He really... sees me."
    elt "Ele realmente... me vê."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1237
translate brazil ch2sc19_nz_0bfd8b6c:

#   el "You really know me that well?"
    el "Você me conhece tão bem assim?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1239
translate brazil ch2sc19_nz_e27f23ff:

#   mc "Mmh. I see you, Eliza."
    mc "Hum. Estou de olho em você, Eliza."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1243
translate brazil ch2sc19_nz_43d07803:

#   el "*Blush* I-I... I see you too, [mc]."
    el "*Corando* II... Eu também te vejo, [mc]."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1244
translate brazil ch2sc19_nz_fdb118d5:

#   el "You know... my life has been pretty exciting since we met."
    el "Sabe... minha vida tem sido bem emocionante desde que nos conhecemos."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1246
translate brazil ch2sc19_nz_9b504b7e:

#   mc "Hmm. I suppose it has."
    mc "Hum. Acho que sim."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1248
translate brazil ch2sc19_nz_b600c6c4:

#   el "There’s no telling what'll happen when we reach the capital."
    el "Não há como prever o que acontecerá quando chegarmos à capital."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1250
translate brazil ch2sc19_nz_bb2cfeb2:

#   el "I mean, there could even be bandits lurking around that tree over there!"
    el "Quer dizer, pode até haver bandidos à espreita perto daquela árvore ali!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1252
translate brazil ch2sc19_nz_6bf6eee6:

#   mc "Okay, calm down, little miss thrill seeker. Our lives aren’t that exciting."
    mc "Calma aí, mocinha aventureira. Nossas vidas não são tão emocionantes assim."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1254
translate brazil ch2sc19_nz_a61625a7:

#   el "*Giggle* I suppose not! A girl can dream though, right?"
    el "*Risos* Acho que não! Mas uma garota pode sonhar, né?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1256
translate brazil ch2sc19_nz_f8843891:

#   mc "You want bandits to pop out and try to rob us?"
    mc "Você quer que bandidos apareçam do nada para tentar nos assaltar?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1258
translate brazil ch2sc19_nz_3b1ef7aa:

#   el "Well, not exactly... But I’m dying to test out my combat skills after our recent training sessions."
    el "Bem, não exatamente... Mas estou louco para testar minhas habilidades de combate depois dos nossos recentes treinos."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1260
translate brazil ch2sc19_nz_3b02bdba:

#   mc "You’ve been doing well... You improve fast."
    mc "Você tem se saído bem... Você melhora rápido."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1261
translate brazil ch2sc19_nz_0c369230:

#   mc "You're quick to adapt to the things I teach you, with consistent training you'll be a force to be reckoned with."
    mc "Você se adapta rapidamente às coisas que eu te ensino, e com treinamento consistente, você se tornará uma força a ser reconhecida."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1263
translate brazil ch2sc19_nz_3e259fa1:

#   el "You’re just saying that. I feel like I could be way better."
    el "Você só está dizendo isso. Eu sinto que poderia ser muito melhor."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1265
translate brazil ch2sc19_nz_f01d04cf:

#   mc "Nobody became {b}Thrynn{/b}, The Giant, or {b}Crixus{/b}, God of the arena, overnight, you know?"
    mc "Ninguém se tornou {b} Thrynn{/b}, O Gigante, ou {b} Crixo{/b}Deus da arena, da noite para o dia, sabe?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1267
translate brazil ch2sc19_nz_ac1ba6f1:

#   mc "Trust me, you’ve improved a lot in a short amount of time... More than most."
    mc "Acredite, você melhorou muito em pouco tempo... Mais do que a maioria."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1269
translate brazil ch2sc19_nz_353afad3:

#   el "You really think so?"
    el "Você realmente acha isso?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1271
translate brazil ch2sc19_nz_678d2054:

#   mc "I know so. I’m proud of you."
    mc "Eu sei disso. Tenho orgulho de você."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1274
translate brazil ch2sc19_nz_9233b73a:

#   el "Mwaaahh!"
    el "Uau!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1276
translate brazil ch2sc19_nz_8bcd1e7f:

#   el "That means a lot coming from you!"
    el "Isso significa muito vindo de você!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1277
translate brazil ch2sc19_nz_71345c5b:

#   el "I can’t take all the credit though. You’re a great teacher."
    el "Não posso levar todo o crédito, porém. Você é um ótimo professor."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1279
translate brazil ch2sc19_nz_7d0c0839:

#   mc "Hmm, you think so?"
    mc "Hum, você acha?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1280
translate brazil ch2sc19_nz_0cf9b5bd:

#   mc "I’ve never taught anyone before... I’m just kind of winging it."
    mc "Nunca dei aulas para ninguém antes... Estou meio que improvisando."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1282
translate brazil ch2sc19_nz_745c26f5:

#   el "Yes, I definitely think so! How else would I be doing so great?"
    el "Sim, com certeza! De que outra forma eu estaria me saindo tão bem?"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1283
translate brazil ch2sc19_nz_54f07aca:

#   el "A student can only excel under great tutelage."
    el "Um aluno só consegue se destacar sob uma ótima orientação."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1285
translate brazil ch2sc19_nz_ffafc9e0:

#   mc "I suppose we’re a great team."
    mc "Acho que somos uma ótima equipe."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1287
translate brazil ch2sc19_nz_c44ce7bd:

#   el "The best team!"
    el "A melhor equipe!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1289
translate brazil ch2sc19_nz_14763457:

#   el "The dream team!"
    el "A equipe dos sonhos!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1290
translate brazil ch2sc19_nz_019743e9:

#   el "Nobody can defeat us!"
    el "Ninguém pode nos derrotar!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1298
translate brazil ch2sc19_nz_865ece69:

#   elt "Mmmhhaahh... He’s such a good kisser!"
    elt "Hummm... Ele beija tão bem!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1300
translate brazil ch2sc19_nz_cbafa1c1:

#   el "My life definitely isn’t lacking in the passion department around you."
    el "Minha vida definitivamente não carece de paixão quando se trata de você."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1302
translate brazil ch2sc19_nz_9ca06b63:

#   mc "It’s getting harder and harder to keep my hands off you."
    mc "Está ficando cada vez mais difícil manter minhas mãos longe de você."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1304
translate brazil ch2sc19_nz_e6b28cc0:

#   el "Then don’t."
    el "Então não faça isso."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1308
translate brazil ch2sc19_nz_97fefd2d:

#   el "*Mhwwaahh!*"
    el "*Mhwwaahh!*"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1309
translate brazil ch2sc19_nz_27605474:

#   mct "She always tastes incredible... mmh."
    mct "Ela sempre tem um gosto incrível... hum."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1311
translate brazil ch2sc19_nz_53f99e9c:

#   mc "I'm becoming addicted to these lips of yours."
    mc "Estou ficando viciado nesses seus lábios."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1312
translate brazil ch2sc19_nz_52b401de:

#   el "*Giggling* ..."
    el "*Risos* ..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1314
translate brazil ch2sc19_nz_0d5c225c:

#   el "Why don't you taste them again? You know... for good measure!"
    el "Por que você não os prova de novo? Sabe... só para garantir!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1316
translate brazil ch2sc19_nz_c0e08e42:

#   el "Mmmh-nnhh..."
    el "Hummm..."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1317
translate brazil ch2sc19_nz_b8091d38:

#   "Just as you get a firm hold on her perky ass, you hear a sound off in the distance"
    "Assim que você consegue segurar firme a bunda empinada dela, ouve um som ao longe."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1321
translate brazil ch2sc19_nz_ca75d1f3:

#   uk "{b}*Loudly* Arrgh!! Bloody arse!{/b}"
    uk "{b}*Em voz alta* Argh!! Que droga!{/b}"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1322
translate brazil ch2sc19_nz_47f93c4e:

#   elt "*Sighs heavily* Typical... he had just grabbed my ass!"
    elt "*Suspiro pesado* Típico... ele acabou de agarrar minha bunda!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1323
translate brazil ch2sc19_nz_6f90987a:

#   mct "*Exhales* Fuck me... I guess we'll need to investigate."
    mct "*Exala* Puta merda... Acho que vamos precisar investigar."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1331
translate brazil ch2sc19_nz_c839d70b:

#   mc "Let's get going. Would be nice to find an inn before night."
    mc "Vamos lá. Seria bom encontrar uma pousada antes do anoitecer."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1333
translate brazil ch2sc19_nz_4a36ace9:

#   el "I couldn't agree more!"
    el "Não poderia concordar mais!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1336
translate brazil ch2sc19_nz_a7c6c479:

#   uk "*Loud* Arrgh!! Bloody arse!"
    uk "*Alto* Argh!! Que droga!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:1071
translate brazil ch2sc19_nz_0f2e10c2_1:

#   el "O-Okay."
    el "Ok."



# ARQUIVO: game/chapters/chapter6/ch6sc5.rpy DIALOGOS: 1591


# game/chapters/chapter6/ch6sc5.rpy:7
translate brazil ch6sc5_5d715264:

#   da "The three of you did well today."
    da "Vocês três se saíram bem hoje."

# game/chapters/chapter6/ch6sc5.rpy:9
translate brazil ch6sc5_bd24f23b:

#   da "Borri, you have a lot of power in your blows."
    da "Borri, você tem muita força nos seus golpes."

# game/chapters/chapter6/ch6sc5.rpy:10
translate brazil ch6sc5_a00df576:

#   da "But your movements are too sluggish."
    da "Mas seus movimentos são muito lentos."

# game/chapters/chapter6/ch6sc5.rpy:11
translate brazil ch6sc5_6214946a:

#   da "It doesn't require much skill to evade your attacks."
    da "Não é preciso muita habilidade para se esquivar dos seus ataques."

# game/chapters/chapter6/ch6sc5.rpy:13
translate brazil ch6sc5_50469185:

#   da "So, you’ll be working on that going forward."
    da "Então, você vai trabalhar nisso daqui para frente."

# game/chapters/chapter6/ch6sc5.rpy:14
translate brazil ch6sc5_c3e2ccff:

#   da "All three of you will be working on shoring up your weaknesses."
    da "Vocês três trabalharão para fortalecer seus pontos fracos."

# game/chapters/chapter6/ch6sc5.rpy:15
translate brazil ch6sc5_8945c454:

#   da "There's no need to train aspects where you’re already strong."
    da "Não há necessidade de treinar aspectos nos quais você já é forte."

# game/chapters/chapter6/ch6sc5.rpy:16
translate brazil ch6sc5_97cc495f:

#   da "Which means we’ll focus on improving your weaknesses."
    da "Isso significa que nos concentraremos em melhorar seus pontos fracos."

# game/chapters/chapter6/ch6sc5.rpy:18
translate brazil ch6sc5_22cbc697:

#   da "Borri, that means you'll be working on your agility."
    da "Borri, isso significa que você vai trabalhar na sua agilidade."

# game/chapters/chapter6/ch6sc5.rpy:20
translate brazil ch6sc5_f57b0b16:

#   br "Bah! Dwarves aren’t known for their agility, Dalen!"
    br "Bah! Os anões não são conhecidos pela sua agilidade, Dalen!"

# game/chapters/chapter6/ch6sc5.rpy:21
translate brazil ch6sc5_8ff78134:

#   br "We're meant to swing big hammers or axes, with the strength and power to make it count!"
    br "Nosso objetivo é brandir grandes martelos ou machados, com a força e o poder necessários para fazer a diferença!"

# game/chapters/chapter6/ch6sc5.rpy:23
translate brazil ch6sc5_809e8f16:

#   da "I've met several dwarves who specialize as assassins and rogues."
    da "Já conheci vários anões especializados em assassinatos e ladinos."

# game/chapters/chapter6/ch6sc5.rpy:24
translate brazil ch6sc5_fcc1626a:

#   da "So, you will train your agility."
    da "Então, você vai treinar sua agilidade."

# game/chapters/chapter6/ch6sc5.rpy:25
translate brazil ch6sc5_a6ec7a4c:

#   br "*Grunts while nodding* Hmh."
    br "*Resmunga enquanto acena com a cabeça* Hmh."

# game/chapters/chapter6/ch6sc5.rpy:27
translate brazil ch6sc5_cea74626:

#   br "How come yer still standing? Bella landed multiple blows on ye."
    br "Como você ainda está de pé? Bella te acertou vários golpes."

# game/chapters/chapter6/ch6sc5.rpy:28
translate brazil ch6sc5_387551ef:

#   br "I know ye blocked several with yer arm and shinguards, but Bella is made of Vibranite."
    br "Eu sei que você bloqueou vários com seu braço e caneleiras, mas Bella é feita de Vibranite."

# game/chapters/chapter6/ch6sc5.rpy:29
translate brazil ch6sc5_108d48a0:

#   br "It's a rare smithing alloy... that creates shockwaves on impact."
    br "É uma liga metálica rara para forja... que cria ondas de choque ao sofrer impacto."

# game/chapters/chapter6/ch6sc5.rpy:30
translate brazil ch6sc5_447fc922:

#   br "It's effective even against armor 'cause it can shatter the bones beneath."
    br "É eficaz até mesmo contra armaduras, pois pode quebrar os ossos por baixo."

# game/chapters/chapter6/ch6sc5.rpy:32
translate brazil ch6sc5_03a0e6e1:

#   da "Vibranite, huh? That is both rare and expensive."
    da "Vibranite, hein? É raro e caro."

# game/chapters/chapter6/ch6sc5.rpy:33
translate brazil ch6sc5_1ff44d83:

#   da "I can see why you hold Bella in such high regard..."
    da "Entendo por que você tem Bella em tão alta consideração..."

# game/chapters/chapter6/ch6sc5.rpy:34
translate brazil ch6sc5_b529a6a7:

#   da "Even setting aside her sentimental value."
    da "Mesmo deixando de lado o valor sentimental que ela representa."

# game/chapters/chapter6/ch6sc5.rpy:35
translate brazil ch6sc5_12f5f781:

#   da "And yes, I did block rather than dodge several of your blows."
    da "E sim, eu bloqueei em vez de esquivar de vários dos seus golpes."

# game/chapters/chapter6/ch6sc5.rpy:37
translate brazil ch6sc5_1dc88a30:

#   da "But, you see, my armor isn’t made of regular steel either."
    da "Mas, veja bem, minha armadura também não é feita de aço comum."

# game/chapters/chapter6/ch6sc5.rpy:38
translate brazil ch6sc5_2a55fd3b:

#   da "It's forged from Palladium, a material only found deep within the mines of Arazalia."
    da "É forjado em paládio, um material encontrado apenas nas profundezas das minas de Arazalia."

# game/chapters/chapter6/ch6sc5.rpy:39
translate brazil ch6sc5_4a7d8eab:

#   da "It’s sturdy and lightweight, but its most important quality is that it is incredibly impact absorbent."
    da "É resistente e leve, mas sua qualidade mais importante é a incrível capacidade de absorver impactos."

# game/chapters/chapter6/ch6sc5.rpy:41
translate brazil ch6sc5_d9bbaa62:

#   da "If it wasn’t so damn rare and hard to acquire, I’d want all of us to have armor like mine."
    da "Se não fosse tão rara e difícil de conseguir, eu gostaria que todos nós tivéssemos uma armadura como a minha."

# game/chapters/chapter6/ch6sc5.rpy:42
translate brazil ch6sc5_f5d90eac:

#   da "It has saved my skin more than a few times over the years."
    da "Já salvou minha pele mais de uma vez ao longo dos anos."

# game/chapters/chapter6/ch6sc5.rpy:43
translate brazil ch6sc5_39ef7a9f:

#   da "Now, as for you Milton..."
    da "E quanto a você, Milton..."

# game/chapters/chapter6/ch6sc5.rpy:45
translate brazil ch6sc5_3e0f1c7a:

#   da "Your greatest strength seems to be your speed."
    da "Sua maior qualidade parece ser a velocidade."

# game/chapters/chapter6/ch6sc5.rpy:46
translate brazil ch6sc5_67c0af8d:

#   da "You’re quick and nimble, and you managed to dodge many of my strikes."
    da "Você é rápido e ágil, e conseguiu esquivar-se de muitos dos meus golpes."

# game/chapters/chapter6/ch6sc5.rpy:47
translate brazil ch6sc5_52a75020:

#   da "Unfortunately, given your size, your attacks lacked sufficient force to trouble me."
    da "Infelizmente, dado o seu tamanho, seus ataques não tiveram força suficiente para me incomodar."

# game/chapters/chapter6/ch6sc5.rpy:48
translate brazil ch6sc5_bfc3ee7d:

#   da "It was like being bitten by an ant: annoying, but nothing to worry about."
    da "Foi como ser picado por uma formiga: irritante, mas nada preocupante."

# game/chapters/chapter6/ch6sc5.rpy:49
translate brazil ch6sc5_2b04a9fc:

#   da "So, we’ll be working on putting some meat on your bones, as well as improving the technique of your strikes."
    da "Então, vamos trabalhar para que você ganhe mais massa muscular, além de aprimorar a técnica dos seus golpes."

# game/chapters/chapter6/ch6sc5.rpy:52
translate brazil ch6sc5_84b79f3f:

#   ml "Sir, yes sir!"
    ml "Sim, senhor!"

# game/chapters/chapter6/ch6sc5.rpy:53
translate brazil ch6sc5_dcde7719:

#   da "*Chuckles* At ease, adventurer Milton, you’re not a guard any more."
    da "*Risos* Fique tranquilo, aventureiro Milton, você não é mais um guarda."

# game/chapters/chapter6/ch6sc5.rpy:55
translate brazil ch6sc5_1b6f5def:

#   da "And Flynn, I’m glad you joined us today, even if your lack of previous combat training is obvious."
    da "E Flynn, fico feliz que você tenha se juntado a nós hoje, mesmo que sua falta de treinamento prévio em combate seja óbvia."

# game/chapters/chapter6/ch6sc5.rpy:57
translate brazil ch6sc5_833db4ca:

#   fy "What can I say? I’m a lover not a fighter."
    fy "O que posso dizer? Sou um amante, não um lutador."

# game/chapters/chapter6/ch6sc5.rpy:58
translate brazil ch6sc5_1bf7c38f:

#   fy "My talents are better suited to fine young maidens with shapely bosoms!"
    fy "Meus talentos se encaixam melhor em jovens donzelas de seios fartos!"

# game/chapters/chapter6/ch6sc5.rpy:60
translate brazil ch6sc5_20667fd9:

#   da "Be that as it may, you'll be better off knowing how to defend yourself."
    da "Seja como for, é melhor você saber como se defender."

# game/chapters/chapter6/ch6sc5.rpy:62
translate brazil ch6sc5_fa826316:

#   da "Now that Taron has been revealed as a traitor to the throne, his actions will likely be harder to predict."
    da "Agora que Taron foi revelado como um traidor do trono, suas ações provavelmente serão mais difíceis de prever."

# game/chapters/chapter6/ch6sc5.rpy:63
translate brazil ch6sc5_7b3f3a95:

#   da "He could act out against any of us if he sees an advantage to it."
    da "Ele poderia agir contra qualquer um de nós se visse alguma vantagem nisso."

# game/chapters/chapter6/ch6sc5.rpy:64
translate brazil ch6sc5_a6eacbfb:

#   da "So, the better prepared for battle we are, the better our odds of surviving."
    da "Portanto, quanto melhor preparados estivermos para a batalha, maiores serão nossas chances de sobrevivência."

# game/chapters/chapter6/ch6sc5.rpy:66
translate brazil ch6sc5_c9815511:

#   da "Even if you only learn the basics of combat, it could turn the tide of battle."
    da "Mesmo que você aprenda apenas o básico do combate, isso pode mudar o rumo da batalha."

# game/chapters/chapter6/ch6sc5.rpy:67
translate brazil ch6sc5_4fdac9b0:

#   da "Let’s say that Borri is squaring up against an evenly matched opponent ..."
    da "Digamos que Borri esteja enfrentando um adversário de nível semelhante..."

# game/chapters/chapter6/ch6sc5.rpy:68
translate brazil ch6sc5_0d0eac25:

#   da "Then having a second fighter like you, even if only trained in the basics, might help turn the tide of the battle."
    da "Então, ter um segundo lutador como você, mesmo que treinado apenas no básico, pode ajudar a virar o jogo."

# game/chapters/chapter6/ch6sc5.rpy:70
translate brazil ch6sc5_1788b8f5:

#   fy "Sounds good to me! I’ll become something akin to a battlefield bard!"
    fy "Parece ótimo! Vou me tornar algo parecido com um bardo de batalha!"

# game/chapters/chapter6/ch6sc5.rpy:71
translate brazil ch6sc5_ef2ce274:

#   fy "I'll inspire our allies to win any battle!"
    fy "Vou inspirar nossos aliados a vencer qualquer batalha!"

# game/chapters/chapter6/ch6sc5.rpy:73
translate brazil ch6sc5_54cc506f:

#   da "Something like that..."
    da "Algo assim..."

# game/chapters/chapter6/ch6sc5.rpy:75
translate brazil ch6sc5_e6dde4cc:

#   da "Let’s wrap up for today."
    da "Vamos encerrar por hoje."

# game/chapters/chapter6/ch6sc5.rpy:76
translate brazil ch6sc5_143936b2:

#   da "We’ll continue at dawn tomorrow and start working on your individual weaknesses."
    da "Continuaremos amanhã ao amanhecer e começaremos a trabalhar em seus pontos fracos individuais."

# game/chapters/chapter6/ch6sc5.rpy:78
translate brazil ch6sc5_16aaa3b9:

#   da "Go fill your bellies with a hearty meal, my treat for your efforts."
    da "Vão se deliciar com uma refeição farta, por minha conta como agradecimento pelo esforço de vocês."

# game/chapters/chapter6/ch6sc5.rpy:79
translate brazil ch6sc5_88573bf1:

#   fy "Yahoo! Let’s go eat our fill at the Drunken Rooster, lads!"
    fy "Eba! Vamos comer até não aguentar mais no Drunken Rooster, rapazes!"

# game/chapters/chapter6/ch6sc5.rpy:80
translate brazil ch6sc5_a91f643c:

#   ml "*Laughs* You like their food that much?"
    ml "*Risos* Você gosta tanto assim da comida deles?"

# game/chapters/chapter6/ch6sc5.rpy:81
translate brazil ch6sc5_e5e5b53a:

#   br "Hah! It’s that lass, Anna. Her milkers have him completely enchanted."
    br "Ah! É aquela moça, Anna. Os seios dela o deixaram completamente enfeitiçado."

# game/chapters/chapter6/ch6sc5.rpy:83
translate brazil ch6sc5_6b14dac0:

#   fy "Ooh... Anna."
    fy "Ah... Anna."

# game/chapters/chapter6/ch6sc5.rpy:84
translate brazil ch6sc5_d035007e:

#   fy "She has the biggest tit- the biggest personality I've ever seen!"
    fy "Ela tem os maiores peitos e a maior personalidade que eu já vi!"

# game/chapters/chapter6/ch6sc5.rpy:85
translate brazil ch6sc5_d54ca08a:

#   fy "She’s probably already worrying about why I haven’t shown up for ales yet. Come, come!"
    fy "Ela provavelmente já está preocupada porque eu ainda não apareci para tomar umas cervejas. Vamos, vamos!"

# game/chapters/chapter6/ch6sc5.rpy:96
translate brazil ch6sc5_76cd2e63:

#   "Back in A’nai the sun has begun to set, and some of the villagers are arranging a bonfire."
    "De volta a A'nai, o sol começou a se pôr e alguns moradores estão preparando uma fogueira."

# game/chapters/chapter6/ch6sc5.rpy:97
translate brazil ch6sc5_bab7fcc4:

#   "Seating arrangements have been prepared for those who wish to partake in the ceremony."
    "Os lugares já foram reservados para aqueles que desejam participar da cerimônia."

# game/chapters/chapter6/ch6sc5.rpy:98
translate brazil ch6sc5_699a4a30:

#   "As you approach, you can feel an excited energy in the air."
    "Ao se aproximar, você pode sentir uma energia vibrante no ar."

# game/chapters/chapter6/ch6sc5.rpy:100
translate brazil ch6sc5_10215417:

#   "The sound of lighthearted chatter spills out from the ceremonial area."
    "O som de conversas animadas ecoa da área cerimonial."

# game/chapters/chapter6/ch6sc5.rpy:101
translate brazil ch6sc5_51f176f8:

#   mct "{i}Seems like everyone is in high spirits.{/i}"
    mct "{i}Parece que todos estão de ótimo humor.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:103
translate brazil ch6sc5_a685abe8:

#   mct "Vex and Miyo are still building the bonfire."
    mct "Vex e Miyo ainda estão construindo a fogueira."

# game/chapters/chapter6/ch6sc5.rpy:104
translate brazil ch6sc5_6f66f9cb:

#   mct "I guess it’ll be a little while before things get started properly."
    mct "Acho que vai demorar um pouco até as coisas começarem de verdade."

# game/chapters/chapter6/ch6sc5.rpy:105
translate brazil ch6sc5_b8e713c8:

#   mct "{i}Might as well make the rounds.{/i}"
    mct "{i}Já que estamos aqui, podemos fazer a ronda.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:107
translate brazil ch6sc5_4bbd31dc:

#   mct "It’d be nice to get to know some of them a bit more..."
    mct "Seria bom conhecer alguns deles um pouco melhor..."

# game/chapters/chapter6/ch6sc5.rpy:108
translate brazil ch6sc5_f0ea4efa:

#   mct "Or at least maintain friendly relations with those I already know."
    mct "Ou pelo menos manter relações amigáveis ​​com aqueles que eu já conheço."

# game/chapters/chapter6/ch6sc5.rpy:110
translate brazil ch6sc5_643c3f25:

#   mct "{i}I’ll start off with Zyra and Suji.{/i}"
    mct "{i}Vou começar com Zyra e Suji.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:111
translate brazil ch6sc5_37b061bd:

#   mct "{i}You never know what you might get with those two. Sometimes, they're really strict and to the point.{/i}"
    mct "{i}Com esses dois, você nunca sabe o que esperar. Às vezes, eles são muito rigorosos e diretos.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:112
translate brazil ch6sc5_0002d4b7:

#   mct "{i}Other times, they’re quite friendly and patient.{/i}"
    mct "{i}Outras vezes, eles são bastante amigáveis ​​e pacientes.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:114
translate brazil ch6sc5_add634d0:

#   "As they see you approach, they begin smiling."
    "Ao verem você se aproximar, começam a sorrir."

# game/chapters/chapter6/ch6sc5.rpy:115
translate brazil ch6sc5_3960aad0:

#   mct "{i}They seem happy to see me.{/i}"
    mct "{i}Eles parecem felizes em me ver.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:117
translate brazil ch6sc5_01c4a773:

#   zy "Greetings, Champion."
    zy "Saudações, Campeão."

# game/chapters/chapter6/ch6sc5.rpy:118
translate brazil ch6sc5_b9c2e397:

#   zy "I wasn’t sure you’d make it."
    zy "Eu não tinha certeza se você conseguiria."

# game/chapters/chapter6/ch6sc5.rpy:120
translate brazil ch6sc5_98c2a770:

#   mc "And miss out on Vex’s ceremony? No chance."
    mc "E perder a cerimônia da Vex? Nem pensar."

# game/chapters/chapter6/ch6sc5.rpy:122
translate brazil ch6sc5_3ddc1ff8:

#   zy "I’m surprised and glad that you decided to participate."
    zy "Fiquei surpreso e feliz por você ter decidido participar."

# game/chapters/chapter6/ch6sc5.rpy:124
translate brazil ch6sc5_4c38ccb4:

#   sj "I had a feeling you’d make it."
    sj "Eu tinha a sensação de que você conseguiria."

# game/chapters/chapter6/ch6sc5.rpy:125
translate brazil ch6sc5_e23ea999:

#   sj "Enjoying the pre-ceremony so far?"
    sj "Está gostando da pré-cerimônia até agora?"

# game/chapters/chapter6/ch6sc5.rpy:127
translate brazil ch6sc5_0587d76a:

#   mc "I only just arrived, but yeah. I wasn’t sure what to expect, but so far it seems pretty laid back."
    mc "Acabei de chegar, mas sim. Não sabia o que esperar, mas até agora parece bem tranquilo."

# game/chapters/chapter6/ch6sc5.rpy:128
translate brazil ch6sc5_5fe9dd2c:

#   mc "And I notice that most of crew from our expedition is here."
    mc "E notei que a maior parte da tripulação da nossa expedição está aqui."

# game/chapters/chapter6/ch6sc5.rpy:130
translate brazil ch6sc5_2f7750f5:

#   zy "Anybody is welcome to participate. But usually, since the ceremony is for prospective huntresses..."
    zy "Qualquer pessoa é bem-vinda a participar. Mas geralmente, como a cerimônia é para futuras caçadoras..."

# game/chapters/chapter6/ch6sc5.rpy:131
translate brazil ch6sc5_08fda2be:

#   zy "It is mostly their friends and other huntresses who take part in the festivities."
    zy "São principalmente suas amigas e outras caçadoras que participam das festividades."

# game/chapters/chapter6/ch6sc5.rpy:133
translate brazil ch6sc5_2d9d8738:

#   mc "I don’t want to throw any shade, but there’s one person I’m glad isn’t here."
    mc "Não quero criticar ninguém, mas tem uma pessoa que eu fico feliz que não esteja aqui."

# game/chapters/chapter6/ch6sc5.rpy:135
translate brazil ch6sc5_269686e0:

#   zy "Like... Marah? *Snickers*"
    zy "Tipo... Marah? *Risos*"

# game/chapters/chapter6/ch6sc5.rpy:137
translate brazil ch6sc5_a6d5c516:

#   mc "I guess I'm as subtle as a rock. *Chuckles*"
    mc "Acho que sou tão discreto quanto uma pedra. *Risos*"

# game/chapters/chapter6/ch6sc5.rpy:139
translate brazil ch6sc5_be52b7e5:

#   sj "Don’t worry, Marah doesn’t usually take part in ceremonies that aren't related to priestess' business."
    sj "Não se preocupe, Marah geralmente não participa de cerimônias que não estejam relacionadas aos assuntos de sacerdotisa."

# game/chapters/chapter6/ch6sc5.rpy:140
translate brazil ch6sc5_45dd238d:

#   sj "I doubt you’ll see her tonight."
    sj "Duvido que você a veja esta noite."

# game/chapters/chapter6/ch6sc5.rpy:142
translate brazil ch6sc5_c3aff36c:

#   zy "She keeps to her chambers during festivities like this."
    zy "Ela permanece em seus aposentos durante festividades como esta."

# game/chapters/chapter6/ch6sc5.rpy:144
translate brazil ch6sc5_ccb0b8bb:

#   sj "Her heart and mind are too old for such things."
    sj "Seu coração e sua mente são muito velhos para essas coisas."

# game/chapters/chapter6/ch6sc5.rpy:146
translate brazil ch6sc5_4e2048d6:

#   sj "She has always been a little grumpy and set in her ways."
    sj "Ela sempre foi um pouco rabugenta e teimosa."

# game/chapters/chapter6/ch6sc5.rpy:147
translate brazil ch6sc5_d032b530:

#   sj "But since you arrived, it's like she’s fallen into a pit of darkness which is consuming her."
    sj "Mas desde que você chegou, é como se ela tivesse caído em um poço de escuridão que a está consumindo."

# game/chapters/chapter6/ch6sc5.rpy:149
translate brazil ch6sc5_18ea6648:

#   zy "Let us not dwell on such topics tonight."
    zy "Não vamos nos deter nesses assuntos esta noite."

# game/chapters/chapter6/ch6sc5.rpy:151
translate brazil ch6sc5_149299f2:

#   zy "We should turn our attention towards happier things."
    zy "Devemos voltar nossa atenção para coisas mais felizes."

# game/chapters/chapter6/ch6sc5.rpy:152
translate brazil ch6sc5_1ce7f060:

#   zy "Champion, do you wish to share a drink with us?"
    zy "Campeão, gostaria de brindar conosco?"

# game/chapters/chapter6/ch6sc5.rpy:154
translate brazil ch6sc5_61a4d8ce:

#   mc "You bet."
    mc "Pode apostar."

# game/chapters/chapter6/ch6sc5.rpy:156
translate brazil ch6sc5_e87debc1:

#   sj "Here, I think you will like this one."
    sj "Aqui, acho que você vai gostar deste."

# game/chapters/chapter6/ch6sc5.rpy:158
translate brazil ch6sc5_efe2ed68:

#   mc "Thank you, Suji. What is it?"
    mc "Obrigada, Suji. O que é isso?"

# game/chapters/chapter6/ch6sc5.rpy:160
translate brazil ch6sc5_d4355771:

#   sj "It’s called Jungle-Jingle! It tastes like summer has smacked your face, and then kissed it afterwards."
    sj "Chama-se Jungle-Jingle! Tem gosto de verão, como se ele tivesse dado um tapa na sua cara e depois a beijado."

# game/chapters/chapter6/ch6sc5.rpy:161
translate brazil ch6sc5_8859d591:

#   mc "*Chuckles* Sounds like my kind of a drink."
    mc "*Risos* Parece ser o tipo de bebida que eu gosto."

# game/chapters/chapter6/ch6sc5.rpy:162
translate brazil ch6sc5_da043026:

#   sj "Let us toast!"
    sj "Vamos fazer um brinde!"

# game/chapters/chapter6/ch6sc5.rpy:164
translate brazil ch6sc5_6f85a674:

#   zy "Tonight we toast to two things: to our Champion of the trials, and to potential new huntresses."
    zy "Esta noite brindamos a duas coisas: à nossa campeã das provas e às potenciais novas caçadoras."

# game/chapters/chapter6/ch6sc5.rpy:166
translate brazil ch6sc5_7d0bf8d5:

#   sj "I’ll drink to that!"
    sj "Eu brindo a isso!"

# game/chapters/chapter6/ch6sc5.rpy:167
translate brazil ch6sc5_a57b13ba:

#   zy "Cheers to your first Jungle-Jingle, Champion!"
    zy "Um brinde ao seu primeiro Jungle-Jingle, campeão!"

# game/chapters/chapter6/ch6sc5.rpy:168
translate brazil ch6sc5_437b9b87:

#   mc "Cheers to making friends with two beautiful and strong huntresses."
    mc "Um brinde a fazer amizade com duas caçadoras lindas e fortes."

# game/chapters/chapter6/ch6sc5.rpy:169
translate brazil ch6sc5_6632fb85:

#   bth "*Giggles lightly*"
    bth "*Risinhos suaves*"

# game/chapters/chapter6/ch6sc5.rpy:171
translate brazil ch6sc5_69eae0d3:

#   mct "*Gulp* Hmh... where’s the smack and kiss she was talking about?"
    mct "*Engole em seco* Hmh... cadê o tapa e o beijo de que ela estava falando?"

# game/chapters/chapter6/ch6sc5.rpy:172
translate brazil ch6sc5_2f5894a4:

#   mct "It tastes just like water flavored with berries-"
    mct "Tem gosto de água com sabor de frutas vermelhas."

# game/chapters/chapter6/ch6sc5.rpy:175
translate brazil ch6sc5_c82bca5f:

#   "You feel the sting of two hands simultaneously landing a smack on each cheek."
    "Você sente a ardência de duas mãos acertando simultaneamente uma bofetada em cada bochecha."

# game/chapters/chapter6/ch6sc5.rpy:176
translate brazil ch6sc5_cc9a0e84:

#   mc "{b}PffffhHh!{/b}"
    mc "{b}PffffhHh!{/b}"

# game/chapters/chapter6/ch6sc5.rpy:178
translate brazil ch6sc5_2d804247:

#   "As the sting of their palms recedes, it is replaced by the softness of their lips."
    "À medida que a ardência nas palmas das mãos diminui, é substituída pela suavidade dos lábios."

# game/chapters/chapter6/ch6sc5.rpy:179
translate brazil ch6sc5_4c7d3b6b:

#   sj "*Mwaah!*"
    sj "*Mwaah!*"

# game/chapters/chapter6/ch6sc5.rpy:181
translate brazil ch6sc5_a109ee65:

#   zy "Mmmhh!"
    zy "Hummm!"

# game/chapters/chapter6/ch6sc5.rpy:182
translate brazil ch6sc5_adf3d1db:

#   mct "{i}What the fuck just happened?{/i}"
    mct "{i}Que porra acabou de acontecer?{/i}"

# game/chapters/chapter6/ch6sc5.rpy:184
translate brazil ch6sc5_3e706aa0:

#   bth "*Giggles* Welcome to the jungle!"
    bth "*Risos* Bem-vindos à selva!"

# game/chapters/chapter6/ch6sc5.rpy:185
translate brazil ch6sc5_6b06d6e1:

#   mc "A smack and a kiss, huh? You little vixens..."
    mc "Um tapa e um beijo, é? Suas raposinhas..."

# game/chapters/chapter6/ch6sc5.rpy:187
translate brazil ch6sc5_849fa471:

#   zy "The Jungle-Jingle special! Served by yours truly, Zyra and Suji! *Snickers*"
    zy "O especial Jungle-Jingle! Servido por nós, Zyra e Suji! *Risos*"

# game/chapters/chapter6/ch6sc5.rpy:189
translate brazil ch6sc5_8927b881:

#   sj "Enjoy the ceremony, [mc]."
    sj "Aproveite a cerimônia, [mc]."

# game/chapters/chapter6/ch6sc5.rpy:190
translate brazil ch6sc5_d585e778:

#   mc "If this is how it starts, I’m sure it won’t be an evening I’ll forget anytime soon."
    mc "Se começar assim, tenho certeza de que não será uma noite que esquecerei tão cedo."

# game/chapters/chapter6/ch6sc5.rpy:192
translate brazil ch6sc5_48da9b50:

#   zy "It's good to know we've made a lasting impression."
    zy "É bom saber que causamos uma impressão duradoura."

# game/chapters/chapter6/ch6sc5.rpy:194
translate brazil ch6sc5_f6f6980a:

#   bth "*Giggles* Come find us if you wish to share another drink!"
    bth "*Risos* Venha nos encontrar se quiser tomar outro drinque!"

# game/chapters/chapter6/ch6sc5.rpy:199
translate brazil ch6sc5_8f271159:

#   mct "{i}Hmm, I haven’t really had a chance to talk with Kisha.{/i}"
    mct "{i}Hum, eu realmente não tive a oportunidade de conversar com a Kisha.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:200
translate brazil ch6sc5_f9fbaea1:

#   mct "{i}She’s the Head-Huntress of A’nai, so it would be nice to get to know her a little more.{/i}"
    mct "{i}Ela é a Caçadora-Chefe de A'nai, então seria bom conhecê-la um pouco melhor.{/i}"

# game/chapters/chapter6/ch6sc5.rpy:202
translate brazil ch6sc5_d335d17c:

#   mct "Even with her eyes closed, she sensed me approaching!"
    mct "Mesmo com os olhos fechados, ela sentiu minha aproximação!"

# game/chapters/chapter6/ch6sc5.rpy:203
translate brazil ch6sc5_016e8177:

#   mct "Impressive."
    mct "Impressionante."

# game/chapters/chapter6/ch6sc5.rpy:205
translate brazil ch6sc5_53ee0a89:

#   ks "Greetings, Outsider."
    ks "Saudações, forasteiro."

# game/chapters/chapter6/ch6sc5.rpy:206
translate brazil ch6sc5_e14bcfa6:

#   ks "What is it? Why have you sought me out?"
    ks "O que é isso? Por que você me procurou?"

# game/chapters/chapter6/ch6sc5.rpy:208
translate brazil ch6sc5_68423940:

#   mc "Hey... Kisha, was it?"
    mc "Ei... Kisha, não é?"

# game/chapters/chapter6/ch6sc5.rpy:209
translate brazil ch6sc5_a2fc7978:

#   ks "*Nods* ..."
    ks "*Acena com a cabeça* ..."

# game/chapters/chapter6/ch6sc5.rpy:210
translate brazil ch6sc5_3c6ca796:

#   mc "I just wanted to see how you were."
    mc "Eu só queria saber como você estava."

# game/chapters/chapter6/ch6sc5.rpy:212
translate brazil ch6sc5_b14d13b1:

#   ks "You imagine us close enough for pleasantries and small talk?"
    ks "Você nos imagina próximos o suficiente para trocas de gentilezas e conversas informais?"

# game/chapters/chapter6/ch6sc5.rpy:214
translate brazil ch6sc5_7eef5767:

#   mc "No, I do not... that's why I wanted to speak with you."
    mc "Não, eu não... por isso queria falar com você."

# game/chapters/chapter6/ch6sc5.rpy:215
translate brazil ch6sc5_2f5427d5:

#   mc "To remedy that, and to get to know you. Is that such a crime?"
    mc "Para remediar isso e para te conhecer melhor. Isso é um crime?"

# game/chapters/chapter6/ch6sc5.rpy:217
translate brazil ch6sc5_d229f6c1:

#   ks "It is not a crime, no."
    ks "Não é crime, não."

# game/chapters/chapter6/ch6sc5.rpy:218
translate brazil ch6sc5_32fa96c3:

#   ks "But I am not a woman who cares for pleasantries, they only serve to distract."
    ks "Mas eu não sou uma mulher que se importa com gentilezas, elas só servem para distrair."

# game/chapters/chapter6/ch6sc5.rpy:220
translate brazil ch6sc5_fd12aa53:

#   ks "I do not know your intentions here."
    ks "Não sei quais são suas intenções aqui."

# game/chapters/chapter6/ch6sc5.rpy:221
translate brazil ch6sc5_b21926ec:

#   ks "Arriving at A’nai out of nowhere, befriending us..."
    ks "Chegando em A'nai do nada, e fazendo amizade conosco..."

# game/chapters/chapter6/ch6sc5.rpy:223
translate brazil ch6sc5_9f3fe061:

#   mc "Well, first off... I’m only here on Aruna Island to look for a missing diplomat."
    mc "Bem, para começar... Estou aqui na Ilha de Aruna apenas para procurar um diplomata desaparecido."

# game/chapters/chapter6/ch6sc5.rpy:224
translate brazil ch6sc5_6303a4c3:

#   mc "If I don't find them, it could lead to some serious political ramifications between Arazalia and Luxeron."
    mc "Se eu não os encontrar, isso poderá acarretar sérias consequências políticas entre Arazalia e Luxeron."

# game/chapters/chapter6/ch6sc5.rpy:226
translate brazil ch6sc5_cf65afec:

#   mc "And I'm in A'nai because your huntresses knocked me out and brought me here, as you might remember."
    mc "E estou em A'nai porque suas caçadoras me nocautearam e me trouxeram para cá, como você deve se lembrar."

# game/chapters/chapter6/ch6sc5.rpy:227
translate brazil ch6sc5_c3c0d05a:

#   ks "Hrrmm..."
    ks "Hum..."

# game/chapters/chapter6/ch6sc5.rpy:229
translate brazil ch6sc5_9e91a23f:

#   mc "And honestly? I think this place is pretty amazing, the way all of you live in harmony with the island."
    mc "E, sinceramente? Acho este lugar incrível, a forma como todos vocês vivem em harmonia com a ilha."

# game/chapters/chapter6/ch6sc5.rpy:230
translate brazil ch6sc5_d986e0f7:

#   mc "So, yeah. I’ve been befriending those of you who have been open and welcoming towards me."
    mc "Então, sim. Tenho feito amizade com aqueles de vocês que têm sido abertos e acolhedores comigo."

# game/chapters/chapter6/ch6sc5.rpy:232
translate brazil ch6sc5_f34546a0:

#   ks "*Quietly* Marah said you would attempt to befriend us, to twist our minds..."
