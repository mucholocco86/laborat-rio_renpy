translate brazil ch3sc22_9cf4e6de:

#   mct "That was close. I knew it seemed too easy."
    mct "Essa foi por pouco. Eu sabia que parecia fácil demais."

# game/chapters/chapter3/script/ch3sc22.rpy:124
translate brazil ch3sc22_74f70f13:

#   mct "Blazes this guy is huge! I've never seen a goblin like this."
    mct "Caramba, esse cara é enorme! Nunca vi um goblin assim."

