translate brazil ch3sc22_4c08bec9:

#   bz "Roohhhrh... hhh..."
    bz "Roohhhrh... hhh..."

# game/chapters/chapter3/script/ch3sc22.rpy:569
translate brazil ch3sc22_d33cdabf:

#   bz "*Death cry* Hhrh! Hhrrhhh! Hhrh! Hh-... h..."
    bz "*Grito de morte* Hhrh! Hhrrhhh! Hhrh! Hh-... h..."

# game/chapters/chapter3/script/ch3sc22.rpy:571
translate brazil ch3sc22_ba145598:

#   "You don't waste any time, as soon as the berzerker drew it's last breaths, you begin absorbing his soul."
    "Você não perde tempo, assim que o berserker dá seu último suspiro, você começa a absorver sua alma."

# game/chapters/chapter3/script/ch3sc22.rpy:572
translate brazil ch3sc22_f3416ad1:

#   mct "His essence is filled with energy. I don't even feel exhausted anymore."
    mct "Sua essência transborda energia. Já nem me sinto mais exausto."

# game/chapters/chapter3/script/ch3sc22.rpy:578
translate brazil ch3sc22_72964741:

#   "You feel a large gathering of energy assemble in your fists."
    "Você sente uma grande concentração de energia se acumular em seus punhos."

# game/chapters/chapter3/script/ch3sc22.rpy:583
translate brazil ch3sc22_2eb46059:

#   mct "He’s all beefed up, if I use my mana manipulation to electrify him, all his muscles will be a disadvantage for him."
    mct "Ele está todo musculoso; se eu usar minha manipulação de mana para eletrocutá-lo, toda essa musculatura será uma desvantagem para ele."

# game/chapters/chapter3/script/ch3sc22.rpy:585
translate brazil ch3sc22_cb8ee350:

#   mct "Here he comes..."
    mct "Lá vem ele..."

# game/chapters/chapter3/script/ch3sc22.rpy:591
translate brazil ch3sc22_d47df4a5:

#   mct "Dodging now, are we?"
    mct "Estamos nos esquivando agora, é?"

# game/chapters/chapter3/script/ch3sc22.rpy:592
translate brazil ch3sc22_3c6dfbdf:

#   mct "Dodge this!"
    mct "Desvie disso!"

# game/chapters/chapter3/script/ch3sc22.rpy:614
translate brazil ch3sc22_f3aa43f2:

#   bz "*Painful groan* Rharhhgrh!"
    bz "*Gemido de dor* Rharhhgrh!"

# game/chapters/chapter3/script/ch3sc22.rpy:617
translate brazil ch3sc22_d908dd25:

#   mct "Your essence will be put to good use."
    mct "Sua essência será bem aproveitada."

# game/chapters/chapter3/script/ch3sc22.rpy:629
translate brazil ch3sc22_5c12d5e1:

#   el "{b}Catch!!{/b}"
    el "{b}Pegar!!{/b}"

# game/chapters/chapter3/script/ch3sc22.rpy:632
translate brazil ch3sc22_d0fd49e1:

#   el "I knew you would catch me."
    el "Eu sabia que você me pegaria."

# game/chapters/chapter3/script/ch3sc22.rpy:634
translate brazil ch3sc22_0817892e:

#   mc "Always."
    mc "Sempre."

# game/chapters/chapter3/script/ch3sc22.rpy:636
translate brazil ch3sc22_a1951911:

#   el "We did it. We completed our first C-Rank Quest!"
    el "Conseguimos! Completamos nossa primeira missão de Rank C!"

# game/chapters/chapter3/script/ch3sc22.rpy:638
translate brazil ch3sc22_755763d5:

#   "She’s brimming with excitement as she leans closer to you..."
    "Ela está radiante de entusiasmo enquanto se inclina para mais perto de você..."

# game/chapters/chapter3/script/ch3sc22.rpy:643
translate brazil ch3sc22_67d21f02:

#   el "Mmhm..."
    el "Hum..."

# game/chapters/chapter3/script/ch3sc22.rpy:644
translate brazil ch3sc22_1ff427cb:

#   mct "Her lips are as soft as I remember, her scent is conquering my senses with every breath."
    mct "Seus lábios são tão macios quanto me lembrava, seu perfume conquista meus sentidos a cada respiração."

# game/chapters/chapter3/script/ch3sc22.rpy:646
translate brazil ch3sc22_a057d3c1:

#   mct "I can feel how much she cares about me with each and every one of her kisses."
    mct "Consigo sentir o quanto ela se importa comigo em cada um de seus beijos."

# game/chapters/chapter3/script/ch3sc22.rpy:647
translate brazil ch3sc22_f0677cad:

#   mct "Each one is filled with emotion, tenderness and passion."
    mct "Cada uma delas é repleta de emoção, ternura e paixão."

# game/chapters/chapter3/script/ch3sc22.rpy:655
translate brazil ch3sc22_446776af:

#   el "Just like that, the pain is gone."
    el "Assim, de repente, a dor desapareceu."

# game/chapters/chapter3/script/ch3sc22.rpy:657
translate brazil ch3sc22_62ddff8e:

#   mc "I’m happy to be your medic anytime, m'lady."
    mc "Terei o maior prazer em ser seu médico a qualquer momento, minha senhora."

# game/chapters/chapter3/script/ch3sc22.rpy:660
translate brazil ch3sc22_bf189734:

#   el "*Mwaaah!* Nnhh..."
    el "*Mwaaah!* Nnhh..."

# game/chapters/chapter3/script/ch3sc22.rpy:663
translate brazil ch3sc22_e8a7a78a:

#   el "*Giggling* Mmh!"
    el "*Risos* Hum!"

# game/chapters/chapter3/script/ch3sc22.rpy:665
translate brazil ch3sc22_ef5b7497:

#   mc "Needed more healing?"
    mc "Precisava de mais cura?"

# game/chapters/chapter3/script/ch3sc22.rpy:669
translate brazil ch3sc22_cfc0127d:

#   el "Something like that..."
    el "Algo assim..."

# game/chapters/chapter3/script/ch3sc22.rpy:673
translate brazil ch3sc22_63918354:

#   "Eliza feels closer to you than ever before, her trust has increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Eliza sente-se mais próxima de você do que nunca, e sua confiança aumentou. {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter3/script/ch3sc22.rpy:676
translate brazil ch3sc22_3c1c989c:

#   el "Should we take a look around these ruins to see if we can find anything worthwhile?"
    el "Deveríamos dar uma olhada nessas ruínas para ver se encontramos algo de valor?"

# game/chapters/chapter3/script/ch3sc22.rpy:678
translate brazil ch3sc22_817819d8:

#   mc "Sure. Sylph did mention the Guild could use... well, pretty much anything to decorate the Guild Hall with."
    mc "Claro. Sylph mencionou que a Guilda poderia usar... bem, praticamente qualquer coisa para decorar o Salão da Guilda."

# game/chapters/chapter3/script/ch3sc22.rpy:682
translate brazil ch3sc22_81d46d3f:

#   mc "Let’s take a look around and see if we can find anything of note to bring back to the Guild."
    mc "Vamos dar uma olhada por aí e ver se encontramos algo de interessante para trazer de volta à Guilda."

# game/chapters/chapter3/script/ch3sc22.rpy:684
translate brazil ch3sc22_ffc5e1c8:

#   el "Sure!"
    el "Claro!"

# game/chapters/chapter3/script/ch3sc22.rpy:688
translate brazil ch3sc22_507387cf:

#   "The two of you begin searching the ruins for anything of interest."
    "Vocês dois começam a vasculhar as ruínas em busca de algo interessante."

# game/chapters/chapter3/script/ch3sc22.rpy:690
translate brazil ch3sc22_4a1bc430:

#   mc "Found something?"
    mc "Encontrou alguma coisa?"

# game/chapters/chapter3/script/ch3sc22.rpy:691
translate brazil ch3sc22_b9a95b37:

#   el "Y-Yeah there’s something lodged here between these rocks"
    el "Sim, tem alguma coisa presa aqui entre essas rochas."

# game/chapters/chapter3/script/ch3sc22.rpy:692
translate brazil ch3sc22_4f20305d:

#   el "I think I got it!"
    el "Acho que entendi!"

# game/chapters/chapter3/script/ch3sc22.rpy:694
translate brazil ch3sc22_893dcff0:

#   el "What do you suppose it is?"
    el "O que você acha que é?"

# game/chapters/chapter3/script/ch3sc22.rpy:696
translate brazil ch3sc22_cc92ccec:

#   mc "I’m not sure what it’s doing out here, but that’s definitely the sigil of the Kingsguard."
    mc "Não sei bem o que está fazendo aqui, mas esse é definitivamente o brasão da Guarda Real."

# game/chapters/chapter3/script/ch3sc22.rpy:698
translate brazil ch3sc22_d827e296:

#   el "Perhaps the goblins attacked an envoy from the guards at some point?"
    el "Talvez os goblins tenham atacado um enviado da guarda em algum momento?"

# game/chapters/chapter3/script/ch3sc22.rpy:700
translate brazil ch3sc22_b9be4c2a:

#   mc "Maybe so. We should definitely take it back to Sylph."
    mc "Talvez sim. Definitivamente, devemos levar isso de volta para Sylph."

# game/chapters/chapter3/script/ch3sc22.rpy:702
translate brazil ch3sc22_ff391d68:

#   el "Alright! Kingsguard sigil... neat!"
    el "Muito bem! Brasão da Guarda Real... bacana!"

# game/chapters/chapter3/script/ch3sc22.rpy:703
translate brazil ch3sc22_759b6bc0:

#   el "Let’s see if we can find anything else!"
    el "Vamos ver se encontramos mais alguma coisa!"

# game/chapters/chapter3/script/ch3sc22.rpy:705
translate brazil ch3sc22_d92cb6c2:

#   elt "Hmm..."
    elt "Hum..."

# game/chapters/chapter3/script/ch3sc22.rpy:706
translate brazil ch3sc22_91af1ef3:

#   elt "There’s got to be more interesting stuff laying around these ruins!"
    elt "Com certeza há mais coisas interessantes espalhadas por essas ruínas!"

# game/chapters/chapter3/script/ch3sc22.rpy:710
translate brazil ch3sc22_40a222ea:

#   elt "My, my. What do we have here?"
    elt "Nossa, nossa. O que temos aqui?"

# game/chapters/chapter3/script/ch3sc22.rpy:712
translate brazil ch3sc22_aadba3c5:

#   el "[mc]! Check this out!"
    el "[mc] Confira isso!"

# game/chapters/chapter3/script/ch3sc22.rpy:714
translate brazil ch3sc22_cd3a57fd:

#   el "Are you seeing this?"
    el "Você está vendo isso?"

# game/chapters/chapter3/script/ch3sc22.rpy:716
translate brazil ch3sc22_1407d631:

#   mc "Mhm. I’m definitely seeing it."
    mc "Sim, definitivamente estou percebendo."

# game/chapters/chapter3/script/ch3sc22.rpy:718
translate brazil ch3sc22_16e331c8:

#   el "I think it could be worth a lot!"
    el "Acho que pode valer muito!"

# game/chapters/chapter3/script/ch3sc22.rpy:720
translate brazil ch3sc22_c55037ed:

#   mc "Oh, it’s worth a lot. Trust me."
    mc "Ah, vale muito. Acredite em mim."

# game/chapters/chapter3/script/ch3sc22.rpy:722
translate brazil ch3sc22_00ad0d6c:

#   el "How do you know? Ever seen anything like it?"
    el "Como você sabe? Já viu algo parecido?"

# game/chapters/chapter3/script/ch3sc22.rpy:724
translate brazil ch3sc22_e40a953b:

#   mc "Nothing that rivals it, no..."
    mc "Nada que se compare a isso, não..."

# game/chapters/chapter3/script/ch3sc22.rpy:734
translate brazil ch3sc22_7ad6c558:

#   el "You’re staring at my ass, aren’t you?"
    el "Você está olhando para a minha bunda, não é?"

# game/chapters/chapter3/script/ch3sc22.rpy:736
translate brazil ch3sc22_ca87c531:

#   mc "Yes... No! I mean-"
    mc "Sim... Não! Quer dizer..."

# game/chapters/chapter3/script/ch3sc22.rpy:738
translate brazil ch3sc22_aab9a278:

#   el "*Giggles* It’s alright, you already know I don’t mind when it’s you."
    el "*Risos* Tudo bem, você já sabe que eu não me importo quando é você."

# game/chapters/chapter3/script/ch3sc22.rpy:740
translate brazil ch3sc22_8c9d9a32:

#   el "*Whispers* {size=-10}{b}I love having your eyes on me...{/b}{/size}"
    el "*Sussurros* {size=-10}{b}Adoro ter seus olhos em mim...{/b}{/size}"

# game/chapters/chapter3/script/ch3sc22.rpy:742
translate brazil ch3sc22_ee4feedd:

#   el "Now, check out this thing! I’ve never seen anything like it!"
    el "Olha só isso! Nunca vi nada igual!"

# game/chapters/chapter3/script/ch3sc22.rpy:744
translate brazil ch3sc22_d29b2f3a:

#   mc "It looks old, but there's not a speck of rust on it."
    mc "Parece antigo, mas não tem um único ponto de ferrugem."

# game/chapters/chapter3/script/ch3sc22.rpy:746
translate brazil ch3sc22_21f3f053:

#   el "Yeah... I think you’re right. It might even be from the first era?"
    el "Sim... acho que você tem razão. Pode até ser da primeira era?"

# game/chapters/chapter3/script/ch3sc22.rpy:748
translate brazil ch3sc22_7900ac2a:

#   mc "It must be. I don’t imagine a lot of trinkets have survived from that time, though."
    mc "Deve ser. Mas não imagino que muitos objetos daquela época tenham sobrevivido."

# game/chapters/chapter3/script/ch3sc22.rpy:749
translate brazil ch3sc22_f791418e:

#   mc "It's still strange that it’s so clean and well-kept. I can't imagine that the goblins maintained it like this."
    mc "Ainda acho estranho que esteja tão limpo e bem conservado. Não consigo imaginar que os goblins o mantivessem assim."

# game/chapters/chapter3/script/ch3sc22.rpy:751
translate brazil ch3sc22_f3e0caa8:

#   el "I say we take it back to Sylph and see if she knows anything about it."
    el "Eu digo que devemos levar isso de volta para Sylph e ver se ela sabe alguma coisa a respeito."

# game/chapters/chapter3/script/ch3sc22.rpy:753
translate brazil ch3sc22_979b9cac:

#   mc "Good idea. I don’t think we’ll find anything else around here, so let’s head back."
    mc "Boa ideia. Acho que não vamos encontrar mais nada por aqui, então vamos voltar."

# game/chapters/chapter3/script/ch3sc22.rpy:759
translate brazil ch3sc22_2d523ebb:

#   el "I still can’t believe we completely cleared those ruins of so many goblins! There were way more than I expected!"
    el "Ainda não consigo acreditar que limpamos completamente aquelas ruínas de tantos goblins! Havia muito mais do que eu esperava!"

# game/chapters/chapter3/script/ch3sc22.rpy:760
translate brazil ch3sc22_ee6ae575:

#   el "That was insane! I never imagined such foul creatures existed."
    el "Isso foi insano! Nunca imaginei que criaturas tão repugnantes existissem."

# game/chapters/chapter3/script/ch3sc22.rpy:762
translate brazil ch3sc22_c08f1ac3:

#   mc "You did good. I’m proud of you."
    mc "Você se saiu bem. Estou orgulhoso de você."

# game/chapters/chapter3/script/ch3sc22.rpy:764
translate brazil ch3sc22_7127457d:

#   el "I wasn’t about to let you have all the fun."
    el "Eu não ia deixar você se divertir sozinho."

# game/chapters/chapter3/script/ch3sc22.rpy:766
translate brazil ch3sc22_96fe4ab6:

#   el "But thanks. It means a lot coming from you."
    el "Mas obrigada. Significa muito vindo de você."

# game/chapters/chapter3/script/ch3sc22.rpy:768
translate brazil ch3sc22_b5b7d94d:

#   mc "Oren... your father, he'd have been proud of you, Eliza. You fought with zero hesitation."
    mc "Oren... seu pai, ele teria se orgulhado de você, Eliza. Você lutou sem hesitar."

# game/chapters/chapter3/script/ch3sc22.rpy:770
translate brazil ch3sc22_fc376c52:

#   el "[mc], thank you for saying that. But I still feel like I let you down, getting caught off-guard by that storm attack..."
    el "[mc] Obrigada por dizer isso. Mas ainda sinto que te decepcionei, sendo pega de surpresa por aquela tempestade..."

# game/chapters/chapter3/script/ch3sc22.rpy:772
translate brazil ch3sc22_feeb8c59:

#   mc "Seriously, don’t beat yourself up over it, Eliza."
    mc "Sério, não se culpe tanto por isso, Eliza."

# game/chapters/chapter3/script/ch3sc22.rpy:773
translate brazil ch3sc22_28ecaa77:

#   mc "You’ve only been training with me for a couple of weeks. Dodging spells is not something you learn overnight."
    mc "Você só está treinando comigo há algumas semanas. Esquivar-se de feitiços não é algo que se aprende da noite para o dia."

# game/chapters/chapter3/script/ch3sc22.rpy:775
translate brazil ch3sc22_cc90e96e:

#   el "Promise I wasn’t a burden?"
    el "Prometo que não fui um fardo?"

# game/chapters/chapter3/script/ch3sc22.rpy:777
translate brazil ch3sc22_deff6c53:

#   mc "A burden..? You took out two goblins. You know what I did the first time I encountered goblins?"
    mc "Um fardo...? Você derrotou dois goblins. Sabe o que eu fiz na primeira vez que encontrei goblins?"

# game/chapters/chapter3/script/ch3sc22.rpy:779
translate brazil ch3sc22_68cbd21b:

#   el "You probably killed like ten..."
    el "Você provavelmente matou uns dez..."

# game/chapters/chapter3/script/ch3sc22.rpy:781
translate brazil ch3sc22_4a7aa6a0:

#   mc "I froze. I was terrified of them. Their deep snarls, their horrifying yellow eyes, their disgusting sharp teeth..."
    mc "Eu paralisei. Estava apavorada com eles. Seus rosnados profundos, seus olhos amarelos horripilantes, seus dentes afiados e repugnantes..."

# game/chapters/chapter3/script/ch3sc22.rpy:783
translate brazil ch3sc22_bd8b2132:

#   mc "Oren kept tossing me into situations where I'd have to face off against goblins until I stopped being afraid of them."
    mc "Oren continuava me colocando em situações onde eu tinha que enfrentar goblins até que eu parasse de ter medo deles."

# game/chapters/chapter3/script/ch3sc22.rpy:785
translate brazil ch3sc22_103d3355:

#   mc "You, on the other hand, you just charged into them and started killing them efficiently. Not a shred of fear in you."
    mc "Você, por outro lado, simplesmente avançou contra eles e começou a eliminá-los com eficiência. Nem um pingo de medo."

# game/chapters/chapter3/script/ch3sc22.rpy:787
translate brazil ch3sc22_efdf5b56:

#   el "You were in danger... I won’t let anyone harm you."
    el "Você estava em perigo... Não vou deixar ninguém te machucar."

# game/chapters/chapter3/script/ch3sc22.rpy:789
translate brazil ch3sc22_1929480a:

#   el "I want to get stronger. I want to be able to fight by your side, as your equal."
    el "Quero ficar mais forte. Quero poder lutar ao seu lado, como seu igual."

# game/chapters/chapter3/script/ch3sc22.rpy:791
translate brazil ch3sc22_1f35808e:

#   mc "You’re well on your way. It felt great having you fight by me this time."
    mc "Você está no caminho certo. Foi ótimo ter você lutando ao meu lado desta vez."

# game/chapters/chapter3/script/ch3sc22.rpy:793
translate brazil ch3sc22_0296e127:

#   elt "He liked having me by his side..."
    elt "Ele gostava de me ter ao seu lado..."

# game/chapters/chapter3/script/ch3sc22.rpy:794
translate brazil ch3sc22_2688abf5:

#   elt "I already look forward to our next adventure!"
    elt "Já estou ansioso pela nossa próxima aventura!"

# game/chapters/chapter3/script/ch3sc22.rpy:796
translate brazil ch3sc22_600775a8:

#   el "Let’s get out of here... I feel like I need a long bath!"
    el "Vamos embora daqui... Acho que preciso de um longo banho!"

# game/chapters/chapter3/script/ch3sc22.rpy:798
translate brazil ch3sc22_7b7cd1e2:

#   mc "Yeah, you reek..."
    mc "É, você fede..."

# game/chapters/chapter3/script/ch3sc22.rpy:801
translate brazil ch3sc22_542812be:

#   el "Hey! be nice! *nudges your shoulder* It’s not like you’re smelling of dandelions right now either..."
    el "Ei! Seja legal! *dá um cutucão no seu ombro* Não é como se você estivesse cheirando a dente-de-leão agora..."

# game/chapters/chapter3/script/ch3sc22.rpy:803
translate brazil ch3sc22_5f6c8297:

#   mc "*Chuckle* Alright, I guess we’ll both have a bath after we’ve collected our reward."
    mc "*Risos* Muito bem, acho que nós dois vamos tomar um banho depois de recebermos nossa recompensa."

# game/chapters/chapter3/script/ch3sc22.rpy:805
translate brazil ch3sc22_40c358b4:

#   el "Deal! Ahh... Just the thought of a warm relaxing bath."
    el "Fechado! Ahh... Só de pensar num banho quente e relaxante já me dá água na boca."

# game/chapters/chapter3/script/ch3sc22.rpy:806
translate brazil ch3sc22_cec555bf:

#   el "And having my feet massaged."
    el "E receber uma massagem nos pés."

# game/chapters/chapter3/script/ch3sc22.rpy:808
translate brazil ch3sc22_4343fef6:

#   mc "Who said anything about that?"
    mc "Quem falou alguma coisa sobre isso?"

# game/chapters/chapter3/script/ch3sc22.rpy:810
translate brazil ch3sc22_ebfc3378:

#   el "*Giggles* I did, just now! You owe me, I totally saved your ass back there."
    el "*Risos* Fiz isso agora mesmo! Você me deve uma, eu salvei sua pele lá atrás."

# game/chapters/chapter3/script/ch3sc22.rpy:812
translate brazil ch3sc22_1a9f4f01:

#   mc "*Sigh* I’m not massaging your smelly feet."
    mc "*Suspiro* Não vou massagear seus pés fedorentos."

# game/chapters/chapter3/script/ch3sc22.rpy:814
translate brazil ch3sc22_3e347de6:

#   el "Huh?! How dare you!"
    el "Hein?! Como você se atreve!"

# game/chapters/chapter3/script/ch3sc22.rpy:815
translate brazil ch3sc22_52f007b8:

#   el "My little feet are cute and you know it!"
    el "Meus pezinhos são fofos e você sabe disso!"

# game/chapters/chapter3/script/ch3sc22.rpy:817
translate brazil ch3sc22_b629ace9:

#   el "Besides, they’ll be nice and fresh after the bath... like the rest of me."
    el "Além disso, eles ficarão macios e frescos depois do banho... como o resto de mim."

# game/chapters/chapter3/script/ch3sc22.rpy:819
translate brazil ch3sc22_a9c02a97:

#   mc "Alright, alright. You’ll get your massage."
    mc "Tudo bem, tudo bem. Você vai receber sua massagem."

# game/chapters/chapter3/script/ch3sc22.rpy:821
translate brazil ch3sc22_d7ddd5c5:

#   elt "Yes!! If he treats me like this after killing goblins... I won’t mind hunting down a few more. *Giggles*"
    elt "Sim!! Se ele me tratar assim depois de matar goblins... não me importarei de caçar mais alguns. *Risos*"

# game/chapters/chapter3/script/ch3sc22.rpy:823
translate brazil ch3sc22_4f1389df:

#   mc "What are you smiling about?"
    mc "Por que você está sorrindo?"

# game/chapters/chapter3/script/ch3sc22.rpy:825
translate brazil ch3sc22_a28eea20:

#   el "Nothing! Let’s gooo! To the Guild we go!"
    el "Nada! Vamos lá! Para a Guilda!"

# game/chapters/chapter3/script/ch3sc22.rpy:168
translate brazil ch3sc22_4615a269_1:

#   bz "{b}RrrhhhH!{/b}"
    bz "{b}RrrhhhH!{/b}"

# game/chapters/chapter3/script/ch3sc22.rpy:183
translate brazil ch3sc22_4615a269_2:

#   bz "{b}RrrhhhH!{/b}"
    bz "{b}RrrhhhH!{/b}"

# game/chapters/chapter3/script/ch3sc22.rpy:180
translate brazil ch3sc22_e9566676_1:

#   bz "Hrrh?"
    bz "Hum?"

# game/chapters/chapter3/script/ch3sc22.rpy:432
translate brazil ch3sc22_9d38f455_1:

#   gob "Rhrraahrarh!"
    gob "Rhrraahrarh!"

# game/chapters/chapter3/script/ch3sc22.rpy:616
translate brazil ch3sc22_ba145598_1:

#   "You don't waste any time, as soon as the berzerker drew it's last breaths, you begin absorbing his soul."
    "Você não perde tempo, assim que o berserker dá seu último suspiro, você começa a absorver sua alma."



# ARQUIVO: game/chapters/chapter6/ch6sc10.rpy DIALOGOS: 5214


# game/chapters/chapter6/ch6sc10.rpy:10
translate brazil ch6sc10_7199feef:

#   mc "Don’t mind if I do, you know how I like the comforts of your bed."
    mc "Não se importe se eu fizer isso, você sabe como eu gosto do conforto da sua cama."

# game/chapters/chapter6/ch6sc10.rpy:12
translate brazil ch6sc10_aff5cb57:

#   mc "Normally fancy beds aren’t my thing, they’re too soft for my liking."
    mc "Normalmente, camas sofisticadas não me agradam, são macias demais para o meu gosto."

# game/chapters/chapter6/ch6sc10.rpy:14
translate brazil ch6sc10_601c9e74:

#   mc "But the ones your tribe has seem to have the right amount of comfort and stiffness."
    mc "Mas as que sua tribo possui parecem ter o equilíbrio certo entre conforto e rigidez."

# game/chapters/chapter6/ch6sc10.rpy:16
translate brazil ch6sc10_24e006da:

#   riv "I Agree, if it were any softer I doubt I could fall asleep."
    riv "Concordo, se fosse mais macio, duvido que conseguiria dormir."

# game/chapters/chapter6/ch6sc10.rpy:17
translate brazil ch6sc10_303b7ef7:

#   riv "I expect I’d be twisting and turning just to find a comfortable position."
    riv "Imagino que ficaria me revirando só para encontrar uma posição confortável."

# game/chapters/chapter6/ch6sc10.rpy:19
translate brazil ch6sc10_09a2893c:

#   riv "*Sighs* Which is a lot less interesting when you’re on your own."
    riv "*Suspiro* O que é bem menos interessante quando você está sozinho."

# game/chapters/chapter6/ch6sc10.rpy:21
translate brazil ch6sc10_3a6e0725:

#   riv "Hnngh, make some room for your Grandhuntress."
    riv "Hnngh, abra espaço para sua Grande Caçadora."

# game/chapters/chapter6/ch6sc10.rpy:22
translate brazil ch6sc10_ad067580:

#   mc "I’ll always have room for you, Grandhuntress."
    mc "Sempre haverá espaço para você, Grande Caçadora."

# game/chapters/chapter6/ch6sc10.rpy:24
translate brazil ch6sc10_9260c7ea:

#   riv "..."
    riv "..."

# game/chapters/chapter6/ch6sc10.rpy:26
translate brazil ch6sc10_05713c4e:

#   riv "So, what brings you to my chambers in the middle of the night?"
    riv "Então, o que te traz aos meus aposentos no meio da noite?"

# game/chapters/chapter6/ch6sc10.rpy:28
translate brazil ch6sc10_bfa24ef0:

#   mc "I was on my way back to my own chambers to get some rest, then I saw your door cracked open."
    mc "Eu estava voltando para meus aposentos para descansar um pouco, quando vi sua porta entreaberta."

# game/chapters/chapter6/ch6sc10.rpy:29
translate brazil ch6sc10_725ead5b:

#   mc "I decided I’d check on you before I went to sleep."
    mc "Resolvi dar uma olhada em você antes de dormir."

# game/chapters/chapter6/ch6sc10.rpy:31
translate brazil ch6sc10_816f44d5:

#   riv "You… you were concerned about me?"
    riv "Você... você estava preocupado comigo?"

# game/chapters/chapter6/ch6sc10.rpy:33
translate brazil ch6sc10_a87e08fe:

#   mc "Well, yeah?"
    mc "Sim, é?"

# game/chapters/chapter6/ch6sc10.rpy:34
translate brazil ch6sc10_de4837ee:

#   mc "You’re about to uproot your whole life, all you’ve known for the last 20 years."
    mc "Você está prestes a mudar completamente sua vida, tudo o que você conheceu nos últimos 20 anos."

# game/chapters/chapter6/ch6sc10.rpy:36
translate brazil ch6sc10_22cc5ad4:

#   riv "Honestly? It’s a relief…"
    riv "Sinceramente? É um alívio…"

# game/chapters/chapter6/ch6sc10.rpy:38
translate brazil ch6sc10_3e58f2f8:

#   riv "Most of us are eager to be reunited with A’nai."
    riv "A maioria de nós está ansiosa para se reencontrar com A'nai."

# game/chapters/chapter6/ch6sc10.rpy:39
translate brazil ch6sc10_74cc77ac:

#   riv "We split off on our own because our elders at the time didn’t see eye to eye."
    riv "Nós nos separamos porque nossos anciãos da época não concordavam em tudo."

# game/chapters/chapter6/ch6sc10.rpy:41
translate brazil ch6sc10_b7027bca:

#   riv "I simply went with them because the elders believed it would be best if I went."
    riv "Eu simplesmente fui com eles porque os anciãos acreditavam que seria melhor se eu fosse."

# game/chapters/chapter6/ch6sc10.rpy:42
translate brazil ch6sc10_81446bd0:

#   riv "They claimed it was the only way for me to fulfill my mother’s wish."
    riv "Eles alegaram que era a única maneira de eu realizar o desejo da minha mãe."

# game/chapters/chapter6/ch6sc10.rpy:44
translate brazil ch6sc10_8b9e6ab3:

#   mc "Your mother?"
    mc "Sua mãe?"

# game/chapters/chapter6/ch6sc10.rpy:45
translate brazil ch6sc10_22f38ae1:

#   mc "I don’t think I’ve met her?"
    mc "Acho que nunca a conheci?"

# game/chapters/chapter6/ch6sc10.rpy:47
translate brazil ch6sc10_3ef96405:

#   riv "You wouldn’t have… she is long dead."
    riv "Você não teria... ela já morreu há muito tempo."

# game/chapters/chapter6/ch6sc10.rpy:48
translate brazil ch6sc10_a9af0646:

#   riv "She died the night of us overthrowing the outsiders."
    riv "Ela morreu na noite em que derrubamos os forasteiros."

# game/chapters/chapter6/ch6sc10.rpy:50
translate brazil ch6sc10_97f09613:

#   mct "Hmm, I'm sure several lives were lost that night, but it almost sound like it could be...?"
    mct "Hum, tenho certeza de que várias vidas foram perdidas naquela noite, mas parece que poderia ser...?"

# game/chapters/chapter6/ch6sc10.rpy:51
translate brazil ch6sc10_ed31af57:

#   mc "Who-"
    mc "Quem-"

# game/chapters/chapter6/ch6sc10.rpy:53
translate brazil ch6sc10_61ccd100:

#   riv "My mother was the previous A’nu."
    riv "Minha mãe era a A'nu anterior."

# game/chapters/chapter6/ch6sc10.rpy:55
translate brazil ch6sc10_d8e33583:

#   mc "Wouldn’t that mean… you’re-"
    mc "Isso não significaria que... você é-"

# game/chapters/chapter6/ch6sc10.rpy:57
translate brazil ch6sc10_28fb6c5c:

#   riv "That Echo is my sister? Yes."
    riv "Essa Echo é minha irmã? Sim."

# game/chapters/chapter6/ch6sc10.rpy:59
translate brazil ch6sc10_db532c51:

#   riv "Mother was only able to bear two children. Her pregnancy with Echo was a rough one."
    riv "A mãe só conseguiu ter dois filhos. Sua gravidez com Echo foi difícil."

# game/chapters/chapter6/ch6sc10.rpy:60
translate brazil ch6sc10_a5ab86d8:

#   riv "The priestesses said she would likely die if she attempted to have another."
    riv "As sacerdotisas disseram que ela provavelmente morreria se tentasse ter outro filho."

# game/chapters/chapter6/ch6sc10.rpy:62
translate brazil ch6sc10_7787b934:

#   mc "That means… Echo is your younger sister?"
    mc "Isso significa que… Echo é sua irmã mais nova?"

# game/chapters/chapter6/ch6sc10.rpy:63
translate brazil ch6sc10_156514ea:

#   "Riven nods gently."
    "Riven acena levemente com a cabeça."

# game/chapters/chapter6/ch6sc10.rpy:64
translate brazil ch6sc10_14895eff:

#   mc "Then how come she is the A’nu and not you? Why were you sent away?"
    mc "Então, por que ela é a A'nu e não você? Por que você foi expulso?"

# game/chapters/chapter6/ch6sc10.rpy:66
translate brazil ch6sc10_112a270a:

#   riv "Because of my strength… my power."
    riv "Graças à minha força… ao meu poder."

# game/chapters/chapter6/ch6sc10.rpy:67
translate brazil ch6sc10_df44ab32:

#   riv "Our elders wanted to ensure the tribe who split off could have a leader with good morals."
    riv "Nossos anciãos queriam garantir que a tribo que se separou pudesse ter um líder com bons princípios morais."

# game/chapters/chapter6/ch6sc10.rpy:69
translate brazil ch6sc10_b3a5117f:

#   riv "Since I was older than Echo, and had unmatched strength, due to Maia's blessing."
    riv "Como eu era mais velho que Echo e possuía uma força incomparável, graças à bênção de Maia."

# game/chapters/chapter6/ch6sc10.rpy:70
translate brazil ch6sc10_089faaf4:

#   riv "I was a better fit for this task."
    riv "Eu era mais adequado para essa tarefa."

# game/chapters/chapter6/ch6sc10.rpy:72
translate brazil ch6sc10_6dabfa72:

#   mc "I know what it feels like to lose your parents and home at a young age."
    mc "Eu sei o que é perder os pais e o lar ainda jovem."

# game/chapters/chapter6/ch6sc10.rpy:73
translate brazil ch6sc10_daa6c571:

#   mc "I found my parents killed in our home, when I was 10."
    mc "Encontrei meus pais mortos em nossa casa quando tinha 10 anos."

# game/chapters/chapter6/ch6sc10.rpy:74
translate brazil ch6sc10_b869ba6e:

#   mc "Then, immediately, I was taken away from all I knew."
    mc "Então, imediatamente, fui arrancado de tudo que eu conhecia."

# game/chapters/chapter6/ch6sc10.rpy:76
translate brazil ch6sc10_07404442:

#   riv "You mentioned this during our trial, but I did not wish to pry..."
    riv "Você mencionou isso durante o nosso julgamento, mas eu não quis ser indiscreto..."

# game/chapters/chapter6/ch6sc10.rpy:77
translate brazil ch6sc10_ed9b926b:

#   riv "Just 10? That is horrendous… I was 12 as you know, we share such… similar pasts."
    riv "Apenas 10? Isso é horrível... Eu tinha 12, como você sabe, compartilhamos passados ​​tão... semelhantes."

# game/chapters/chapter6/ch6sc10.rpy:78
translate brazil ch6sc10_01a0a4b4:

#   riv "I… I wish we didn’t have to go through that."
    riv "Eu... eu gostaria que não tivéssemos que passar por isso."

# game/chapters/chapter6/ch6sc10.rpy:80
translate brazil ch6sc10_3d895806:

#   mc "Yeah, its weird how the most awful thing I’ve had to endure has also led to the greatest things in my life."
    mc "Sim, é estranho como a coisa mais horrível que tive que suportar também me levou às melhores coisas da minha vida."

# game/chapters/chapter6/ch6sc10.rpy:81
translate brazil ch6sc10_5a67a74b:

#   mc "I wouldn’t have met a lot of the people I care about today…"
    mc "Eu não teria conhecido muitas das pessoas de quem gosto hoje…"

# game/chapters/chapter6/ch6sc10.rpy:82
translate brazil ch6sc10_f3ddf4ff:

#   "Riven gently combs her hand through her hair, pushing it behind her ear as she listens attentively."
    "Riven passa a mão delicadamente pelos cabelos, colocando-os atrás da orelha enquanto escuta atentamente."

# game/chapters/chapter6/ch6sc10.rpy:84
translate brazil ch6sc10_da1393a3:

#   mc "I wouldn’t have arrived here on Aruna, discovered your people, met… you."
    mc "Eu não teria chegado aqui em Aruna, descoberto seu povo, conhecido… você."

# game/chapters/chapter6/ch6sc10.rpy:85
translate brazil ch6sc10_a4c802c6:

#   mc "So while we've had to endure unspeakable hardships in life, it has also led to something good."
    mc "Então, embora tenhamos tido que suportar dificuldades indescritíveis na vida, isso também nos levou a algo bom."

# game/chapters/chapter6/ch6sc10.rpy:87
translate brazil ch6sc10_2f53c09d:

#   riv "I didn’t think of it that way, that’s actually a lovely way of seeing it."
    riv "Eu não tinha pensado nisso dessa forma, essa é realmente uma maneira encantadora de ver as coisas."

# game/chapters/chapter6/ch6sc10.rpy:89
translate brazil ch6sc10_150b270b:

#   riv "*Sighs* I doubt anything will ever mend the wounds we carry from losing our loved ones."
    riv "*Suspiro* Duvido que algo algum dia consiga curar as feridas que carregamos pela perda de nossos entes queridos."

# game/chapters/chapter6/ch6sc10.rpy:90
translate brazil ch6sc10_eec066e2:

#   riv "But we endure… we find the strength to continue on… and eventually, the wounds harden and turn to scars."
    riv "Mas nós perseveramos… encontramos forças para continuar… e, eventualmente, as feridas cicatrizam e se transformam em cicatrizes."

# game/chapters/chapter6/ch6sc10.rpy:92
translate brazil ch6sc10_c4d95599:

#   riv "Like when you arrived here and as I got to know you… my scars didn’t trouble me as much."
    riv "Assim como quando você chegou aqui e conforme eu fui te conhecendo… minhas cicatrizes não me incomodavam tanto."

# game/chapters/chapter6/ch6sc10.rpy:93
translate brazil ch6sc10_b25265f0:

#   riv "I began to feel new sensations within my body, new feelings… feelings that helps me endure the scars."
    riv "Comecei a sentir novas sensações no meu corpo, novos sentimentos… sentimentos que me ajudam a suportar as cicatrizes."

# game/chapters/chapter6/ch6sc10.rpy:95
translate brazil ch6sc10_e02778a5:

#   mc "I know what you mean."
    mc "Eu sei o que você quer dizer."

# game/chapters/chapter6/ch6sc10.rpy:97
translate brazil ch6sc10_9a473307:

#   mc "Nothing can erase our scars, but the people around us can help ease their pain."
    mc "Nada pode apagar nossas cicatrizes, mas as pessoas ao nosso redor podem ajudar a aliviar nossa dor."

# game/chapters/chapter6/ch6sc10.rpy:100
translate brazil ch6sc10_22ae8be1:

#   mc "I share your feelings Riven, you too have helped ease my pain."
    mc "Compartilho dos seus sentimentos, Riven. Você também me ajudou a aliviar minha dor."

# game/chapters/chapter6/ch6sc10.rpy:102
translate brazil ch6sc10_b84333ca:

#   "Riven looks at you with a warm smile, her trust has increased by {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."
    "Riven olha para você com um sorriso caloroso; sua confiança aumentou. {size=+3}{b}{color=#2bff8b}3{/color}{/b}{/size}."

# game/chapters/chapter6/ch6sc10.rpy:107
translate brazil ch6sc10_978390c2:

#   mc "Will you share how you gained Maia’s blessing? I've been curious to learn this."
    mc "Você poderia compartilhar como obteve a bênção de Maia? Tenho curiosidade em saber."

# game/chapters/chapter6/ch6sc10.rpy:109
translate brazil ch6sc10_6966f8c1:

#   riv "Mhm, I will."
    riv "Sim, eu irei."

# game/chapters/chapter6/ch6sc10.rpy:110
translate brazil ch6sc10_6310a745:

#   riv "You’ve been nothing but patient with me."
    riv "Você tem sido extremamente paciente comigo."

# game/chapters/chapter6/ch6sc10.rpy:112
translate brazil ch6sc10_d0b60a6d:

#   riv "As you know, I obtained her blessing the year of the great desecration, when I was 12."
    riv "Como você sabe, eu obtive a bênção dela no ano da grande profanação, quando eu tinha 12 anos."

# game/chapters/chapter6/ch6sc10.rpy:113
translate brazil ch6sc10_6c233c1d:

#   riv "I was out in the jungle, training to be huntresses with a friend, but we ventured too far…"
    riv "Eu estava na selva, treinando para sermos caçadoras com uma amiga, mas nos aventuramos longe demais…"

# game/chapters/chapter6/ch6sc10.rpy:115
translate brazil ch6sc10_04ff468e:

#   riv "Before we knew it, we were running for our lives… being chased by a large beast."
    riv "Antes que percebêssemos, estávamos correndo para salvar nossas vidas... sendo perseguidos por uma fera enorme."

# game/chapters/chapter6/ch6sc10.rpy:116
translate brazil ch6sc10_77ba0f5d:

#   riv "The huntress I was with pushed me out of the way just as the beast pounced on us."
    riv "A caçadora que estava comigo me empurrou para o lado no exato momento em que a fera saltou sobre nós."

# game/chapters/chapter6/ch6sc10.rpy:117
translate brazil ch6sc10_4564b007:

#   riv "She-... she and the beast went over the cliff. I ran screaming towards the cliff-"
    riv "Ela... ela e a fera caíram do penhasco. Eu corri gritando em direção ao penhasco."

# game/chapters/chapter6/ch6sc10.rpy:119
translate brazil ch6sc10_f5b1a829:

#   riv "-I saw her, hanging off the edge but her grip was slipping, with no time to think my body just acted."
    riv "— Eu a vi, pendurada na beira, mas ela estava escorregando, sem tempo para pensar, meu corpo simplesmente agiu."

# game/chapters/chapter6/ch6sc10.rpy:120
translate brazil ch6sc10_521837cc:

#   riv "All I knew was I had to hold on to her with everything I had in me."
    riv "Tudo o que eu sabia era que precisava me agarrar a ela com todas as minhas forças."

# game/chapters/chapter6/ch6sc10.rpy:122
translate brazil ch6sc10_40f3dc71:

#   riv "But-... she was older than me, I couldn’t hold her weight and I slipped."
    riv "Mas... ela era mais velha do que eu, não consegui suportar o peso dela e escorreguei."

# game/chapters/chapter6/ch6sc10.rpy:123
translate brazil ch6sc10_3a0c031a:

#   riv "I managed to grab the ledge at the last second, and she was hanging from my other hand."
    riv "Consegui agarrar a borda no último segundo, e ela ficou pendurada na minha outra mão."

# game/chapters/chapter6/ch6sc10.rpy:125
translate brazil ch6sc10_213a7ae9:

#   riv "I’ve never felt so much strain on my body, holding up the weight of two people with our lives on the line."
    riv "Nunca senti tanta pressão no meu corpo, sustentando o peso de duas pessoas com nossas vidas em risco."

# game/chapters/chapter6/ch6sc10.rpy:126
translate brazil ch6sc10_8fbecb4f:

#   riv "But it only lasted a few moments then my grip weakened and as I closed my eyes, embracing our fate."
    riv "Mas durou apenas alguns instantes, então meu aperto enfraqueceu e, ao fechar os olhos, aceitei nosso destino."

# game/chapters/chapter6/ch6sc10.rpy:128
translate brazil ch6sc10_f1920ec3:

#   riv "That’s when it happened… the most incredible warmth I’ve ever felt."
    riv "Foi então que aconteceu… o calor mais incrível que já senti."

# game/chapters/chapter6/ch6sc10.rpy:129
translate brazil ch6sc10_3fca4474:

#   riv "Suddenly my grip was no longer weakening, the opposite in fact."
    riv "De repente, minha força de preensão não estava mais diminuindo, pelo contrário."

# game/chapters/chapter6/ch6sc10.rpy:131
translate brazil ch6sc10_f17f8edf:

#   riv "I felt strong, stronger than I could imagine, I was able to pull us both up with ease."
    riv "Eu me senti forte, mais forte do que jamais imaginei, e consegui nos puxar para cima com facilidade."

# game/chapters/chapter6/ch6sc10.rpy:132
translate brazil ch6sc10_acb2ba68:

#   riv "The relief I felt in that moment… having saved my friend and mentor from falling to her death."
    riv "O alívio que senti naquele momento... por ter salvado minha amiga e mentora de uma queda fatal."

# game/chapters/chapter6/ch6sc10.rpy:134
translate brazil ch6sc10_8dd133d9:

#   riv "She didn’t question what happened to me, she just smiled and said, the goddesses have smiled upon me."
    riv "Ela não questionou o que me aconteceu, apenas sorriu e disse: \"As deusas sorriram para mim\"."

# game/chapters/chapter6/ch6sc10.rpy:136
translate brazil ch6sc10_19448af1:

#   mc "Maia saw you willing to put your life on the line for another, to risk everything for them."
    mc "Maia viu você disposto a arriscar a vida por outra pessoa, a arriscar tudo por ela."

# game/chapters/chapter6/ch6sc10.rpy:137
translate brazil ch6sc10_c700161c:

#   mc "She decided you were worthy of her blessing and bestowed you with power and abilities to keep doing what you did that day."
    mc "Ela decidiu que você era digno de sua bênção e lhe concedeu poder e habilidades para continuar fazendo o que você fez naquele dia."

# game/chapters/chapter6/ch6sc10.rpy:139
translate brazil ch6sc10_cf4a2068:

#   mc "To protect your people."
    mc "Para proteger o seu povo."

# game/chapters/chapter6/ch6sc10.rpy:141
translate brazil ch6sc10_9d57bccf:

