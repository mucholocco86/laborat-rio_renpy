translate brazil ch6sc8_dba6e126:

#   mc "I'm here on behalf of Echo, the A'nu of A'nai."
    mc "Estou aqui em nome de Echo, o A'nu de A'nai."

# game/chapters/chapter6/ch6sc8.rpy:520
translate brazil ch6sc8_67220042:

#   mc "I'm undertaking the trials of Khan."
    mc "Estou realizando os testes de Khan."

# game/chapters/chapter6/ch6sc8.rpy:521
translate brazil ch6sc8_7dad2893:

#   "The golden-haired beauty eyes you for a few minutes."
    "A bela loira de cabelos dourados olha para você por alguns minutos."

# game/chapters/chapter6/ch6sc8.rpy:522
translate brazil ch6sc8_63a14633:

#   "You uttering the name Echo, and mentioning the trial of Khans clearly struck a nerve."
    "O fato de você ter pronunciado o nome Echo e mencionado o julgamento dos Khans claramente tocou em um ponto sensível."

# game/chapters/chapter6/ch6sc8.rpy:524
translate brazil ch6sc8_5f172614:

