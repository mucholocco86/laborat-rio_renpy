translate brazil ch2sc19_nz_b97612d0:

#   mc "All that swimming made me famished."
    mc "Nadar tanto me deixou faminto."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:428
translate brazil ch2sc19_nz_0f2e10c2:

#   el "O-Okay."
    el "Ok."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:430
translate brazil ch2sc19_nz_60ae73b6:

#   elt "His hands are so strong and warm."
    elt "Suas mãos são tão fortes e quentes."

