translate brazil ch2sc19_nz_02624e35:

#   elt "I have several ideas to keep us warm. *Giggling*"
    elt "Tenho várias ideias para nos manter aquecidos. *Risos*"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:456
translate brazil ch2sc19_nz_374f2810:

#   my "*Giggling* Beth!"
    my "*Risos* Beth!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:457
translate brazil ch2sc19_nz_1639a7e4:

#   my "That's outrageous... even for me!"
    my "Isso é um absurdo... até para mim!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:460
translate brazil ch2sc19_nz_96811011:

#   bet "*Snickers* You've really never tried it? You must!"
    bet "*Risos* Você nunca experimentou mesmo? Você precisa experimentar!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:461
translate brazil ch2sc19_nz_bd6a47cc:

#   bet "I'm telling you, you'll be elevated to a whole new level of pleasure."
    bet "Eu te garanto, você será elevado a um nível totalmente novo de prazer."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:462
translate brazil ch2sc19_nz_52bb1574:

#   my "*Whispers excitedly* {size=-10}{b}How does it feel? Being filled in both... holes.{/b}{/size}"
    my "*Sussurra animadamente* {size=-10}{b}Qual é a sensação? De ter ambos os... buracos preenchidos.{/b}{/size}"

