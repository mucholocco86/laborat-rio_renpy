# game/chapters/chapter5/script/ch5sc11.rpy:2039
translate brazil ch5sc11_990462f1:

#   md1 "*Whispers* If you need anything... anything at all... we’ll be getting undressed in our quarters."
    md1 "*Sussurrando* Se precisarem de alguma coisa... qualquer coisa mesmo... vamos nos despir nos nossos aposentos."

# game/chapters/chapter5/script/ch5sc11.rpy:2041
translate brazil ch5sc11_25126251:

#   mct "{i}Well, that wasn't subtle at all.{/i}"
    mct "{i}Bom, isso não foi nada sutil.{/i}"

