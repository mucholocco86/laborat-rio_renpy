    mh "Estar em seus braços… o calor do seu corpo… o jeito que você me faz sentir… eu me perdi no momento."

# game/chapters/chapter7/ch7sc10.rpy:1335
translate brazil ch7sc10_980d8508:

#   mh "Uhh! This is so embarrassing!"
    mh "Nossa! Que vergonha!"

