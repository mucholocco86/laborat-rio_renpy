#   my "*Gasps* Gibson... I... I can't impose on you guys like that-"
    my "*Suspiros* Gibson... Eu... Eu não posso incomodar vocês assim..."

# game/chapters/chapter5/script/ch5sc14.rpy:295
translate brazil ch5sc14_88786435:

#   gib "Stop, you know Asta adores you, as do I. You always make things lively... *Chuckles*"
    gib "Pare, você sabe que o Asta te adora, assim como eu. Você sempre anima as coisas... *Risos*"

# game/chapters/chapter5/script/ch5sc14.rpy:296
translate brazil ch5sc14_d53a25f5:

#   my "Given what just happened... I-... I'll happily take you up on that offer."
    my "Considerando o que acabou de acontecer... eu... eu aceitarei sua oferta com prazer."

