translate brazil ch2sc19_nz_4f0f35c3:

#   my "C'mon Beth! You can't tease me like that and not give me the answer!"
    my "Vamos lá, Beth! Você não pode me provocar assim e não me dar a resposta!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:466
translate brazil ch2sc19_nz_b1a7bbe7:

#   bet "*Snickers* All I'm going to say is... next time you buy your... eggplants, buy two."
    bet "*Risos* Tudo o que vou dizer é... da próxima vez que você comprar berinjelas, compre duas."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:467
translate brazil ch2sc19_nz_321934f6:

#   bet "One for each... you know!"
    bet "Um para cada um... você sabe!"

# game/chapters/chapter2/script/ch2sc19_nz.rpy:468
translate brazil ch2sc19_nz_9cafa2fd:

#   bet "Oh and you're going to want to be alone... you won't be able to contain your moans when you get started."
