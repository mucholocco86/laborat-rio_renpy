    og "Ovo!!"

# game/chapters/chapter7/ch7sc4.rpy:2277
translate brazil ch7sc4_04fb6d42_1:

#   mc "It was fun playing with you Oggo."
    mc "Foi divertido jogar com você, Oggo."

