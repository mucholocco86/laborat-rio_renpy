translate brazil ch3sc10_a7bb353c:

#   el "Okay! I won’t let you down."
    el "Certo! Não vou te decepcionar."

# game/chapters/chapter3/script/ch3sc10.rpy:194
translate brazil ch3sc10_0641dd68:

#   mc "Wait for me to be out of sight."
    mc "Espere até que eu esteja fora de vista."

# game/chapters/chapter3/script/ch3sc10.rpy:195
translate brazil ch3sc10_9b38e4d7:

#   mc "I’ll meet you back at the stables. Let’s go!"
    mc "Te encontro de volta nos estábulos. Vamos lá!"

# game/chapters/chapter3/script/ch3sc10.rpy:200
translate brazil ch3sc10_0341f98c:

