# game/chapters/chapter5/script/ch5sc07.rpy:904
translate brazil ch5sc07_1f41c98e:

#   am "I have a feeling that won’t be an issue."
    am "Tenho a impressão de que isso não será um problema."

# game/chapters/chapter5/script/ch5sc07.rpy:905
