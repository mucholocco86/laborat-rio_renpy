translate brazil ch2sc19_nz_ebb7e697:

#   el "I’d keep you warm."
    el "Eu te manteria aquecido(a)."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:441
translate brazil ch2sc19_nz_23544b55:

#   mc "Careful, I might take you up on that."
    mc "Cuidado, eu posso aceitar essa sua proposta."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:443
translate brazil ch2sc19_nz_8989f6a7:

#   elt "Please do."
    elt "Por favor, faça isso."

