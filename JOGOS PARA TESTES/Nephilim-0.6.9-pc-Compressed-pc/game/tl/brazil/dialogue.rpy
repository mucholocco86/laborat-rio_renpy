translate brazil ch2sc11_203320d3:

#   mc "You're beautiful, I can't imagine a woman like yourself has trouble finding a man."
    mc "Você é linda, não consigo imaginar que uma mulher como você tenha dificuldade em encontrar um homem."

# game/chapters/chapter2/script/ch2sc11.rpy:62
translate brazil ch2sc11_bc520558:

#   "The women appreciates your compliment, your {b}{color=#87e1fa}Charisma{/color}{/b} has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."
    "A mulher apreciou seu elogio, seu {b}{color=#87e1fa}Carisma{/color}{/b} aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc11.rpy:64
translate brazil ch2sc11_0a1e30e9:

#   wo "Are you sure I can't change your mind? I can be ... persuasive."
    wo "Tem certeza de que não posso te fazer mudar de ideia? Eu posso ser... persuasivo."

# game/chapters/chapter2/script/ch2sc11.rpy:68
translate brazil ch2sc11_7b9af430:

#   "{color=#f00}Dark Morality{/color} Has increased by {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}"
    "{color=#f00}Moralidade Sombria{/color} Aumentou em {size=+3}{b}{color=#2bff8b}1{/color}{/b}{/size}"

# game/chapters/chapter2/script/ch2sc11.rpy:70
