#   sl "{b}Aaiiihh!{/b}"
    sl "{b}Aaaaaah!{/b}"

# game/chapters/chapter3/script/ch3sc10.rpy:207
translate brazil ch3sc10_20c435fd:

#   el "Hey, Selena..."
    el "Ei, Selena..."

# game/chapters/chapter3/script/ch3sc10.rpy:208
