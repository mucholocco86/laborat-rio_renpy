    ro "Já se passaram quase duas horas."

# game/chapters/chapter7/ch7sc9.rpy:2201
translate brazil ch7sc9_6166e5fe:

#   mc "*Chuckles* Is that so? That’s crazy…"
    mc "*Risos* É mesmo? Que loucura…"

