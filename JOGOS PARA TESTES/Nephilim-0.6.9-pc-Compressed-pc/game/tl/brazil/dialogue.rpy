#   bz "{b}RrrhhhH!{/b}"
    bz "{b}RrrhhhH!{/b}"

# game/chapters/chapter3/script/ch3sc22.rpy:154
translate brazil ch3sc22_1eadd91b:

#   mct "Huh?! A solid kick to the skull and he didn’t even flinch?"
    mct "Hã?! Um chute certeiro na cabeça e ele nem se mexeu?"

