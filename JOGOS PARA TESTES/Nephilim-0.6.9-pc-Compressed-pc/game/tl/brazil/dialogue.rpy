translate brazil ch6sc2_251b8eb7:

#   pl "There they are!"
    pl "Aí estão eles!"

# game/chapters/chapter6/ch6sc2.rpy:6832
translate brazil ch6sc2_ef204afc:

#   pl "Miyo is the one with black hair and the red dress. The other one is-"
    pl "Miyo é a de cabelo preto e vestido vermelho. A outra é..."

# game/chapters/chapter6/ch6sc2.rpy:6833
translate brazil ch6sc2_9087dcad:

#   mc "Vex. I’ve already had the pleasure."
    mc "Irritado. Eu já tive esse prazer."

