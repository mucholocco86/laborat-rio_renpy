translate brazil ch5sc11_bb6c395e:

#   qm "*Quietly* Such a silly thing for a woman of my age to hope for."
    qm "*Em voz baixa* Que coisa boba para uma mulher da minha idade desejar."

# game/chapters/chapter5/script/ch5sc11.rpy:2087
translate brazil ch5sc11_672f763c:

#   qm "*Quietly* Oh. He’s... fully naked?"
    qm "*Em voz baixa* Oh. Ele está... completamente nu?"

# game/chapters/chapter5/script/ch5sc11.rpy:2088
