# game/chapters/chapter5/script/ch5sc11.rpy:1977
translate brazil ch5sc11_fe29e8d4:

#   mct "{i}It's a little much. I could’ve just stayed in the guards barracks... But I suppose that’s not how ‘royals’ do things.{/i}"
