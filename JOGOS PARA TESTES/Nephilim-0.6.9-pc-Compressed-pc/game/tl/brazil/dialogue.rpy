translate brazil ch7sc1_409cb4f6:

#   nu "I will do just that, feel free to browse as much as you’d like."
    nu "Farei exatamente isso, fique à vontade para navegar o quanto quiser."

# game/chapters/chapter7/ch7sc1.rpy:477
translate brazil ch7sc1_c51d22fa:

#   el "Great! I already have a couple of outfits in mind for him that I took note of last time I was here."
    el "Ótimo! Já tenho algumas ideias de roupas para ele que anotei da última vez que estive aqui."

