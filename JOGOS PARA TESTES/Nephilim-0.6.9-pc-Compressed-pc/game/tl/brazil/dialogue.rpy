translate brazil ch7sc1_eb8231f9:

#   mc "When am I not sweet?"
    mc "Quando é que eu não sou doce?"

# game/chapters/chapter7/ch7sc1.rpy:472
translate brazil ch7sc1_31763665:

#   el "You know what I mean… go say hi."
    el "Você sabe o que eu quero dizer... vá lá e diga oi."

# game/chapters/chapter7/ch7sc1.rpy:474
translate brazil ch7sc1_2e694682:

#   el "Hii Nuel! I’m going to go browse, can you show my friend to the dressing area once you’ve gotten acquainted?"
    el "Oi Nuel! Vou dar uma olhada, você pode mostrar o provador para minha amiga depois que vocês se conhecerem?"

# game/chapters/chapter7/ch7sc1.rpy:475
translate brazil ch7sc1_df085152:

#   nu "Eliza, welcome back."
    nu "Eliza, seja bem-vinda de volta."

