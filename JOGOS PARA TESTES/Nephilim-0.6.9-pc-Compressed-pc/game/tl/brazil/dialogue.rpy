translate brazil ch5sc2_8d728e3a:

#   mc "I preferred you without clothes."
    mc "Eu preferia você sem roupa."

# game/chapters/chapter5/script/ch5sc2.rpy:2985
translate brazil ch5sc2_36a1e261:

#   sy "And you’re calling me naughty? You’ve quite the appetite!"
    sy "E você está me chamando de travessa? Você tem um apetite e tanto!"

# game/chapters/chapter5/script/ch5sc2.rpy:2987
translate brazil ch5sc2_3b1599c7:

#   mc "Hard not to feel hungry when you’ve had a taste of something delicious."
    mc "É difícil não sentir fome depois de provar algo delicioso."

