# game/chapters/chapter5/script/ch5sc07.rpy:954
translate brazil ch5sc07_db97e9b3:

#   frt "{i}It'd be nice to see her connect with someone from outside the castle.{/i}"
    frt "{i}Seria bom vê-la se conectar com alguém de fora do castelo.{/i}"

# game/chapters/chapter5/script/ch5sc07.rpy:956
translate brazil ch5sc07_01b64df6:

#   frt "{i}And [mc]... he seems really nice.{/i}"
