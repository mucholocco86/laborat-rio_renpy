# game/chapters/chapter4/script/ch4sc12.rpy:932
translate brazil ch4sc12_214d3bc7:

#   kl "Louie. Please leave, right now! You're making me uncomfortable."
    kl "Louie, por favor, vá embora agora mesmo! Você está me deixando desconfortável."

# game/chapters/chapter4/script/ch4sc12.rpy:935
translate brazil ch4sc12_3ff4df7f:

#   lll "{b}*Angrily* You tease! You wanted me here tonight! Admit me!{/b}"
    lll "{b}*Com raiva* Você está me provocando! Você me queria aqui esta noite! Me deixe entrar!{/b}"

# game/chapters/chapter4/script/ch4sc12.rpy:936
