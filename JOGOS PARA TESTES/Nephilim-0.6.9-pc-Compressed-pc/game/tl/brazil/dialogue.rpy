translate brazil ch7sc9_9ba3e40f:

#   ro "Mhm… I sense a magical future… remind me to thank fate if I ever meet her."
    ro "Hum… pressinto um futuro mágico… lembre-me de agradecer ao destino se um dia eu a encontrar."

# game/chapters/chapter7/ch7sc9.rpy:2260
translate brazil ch7sc9_52970960:

#   ro "Cheers!"
    ro "Saúde!"

# game/chapters/chapter7/ch7sc9.rpy:2262
translate brazil ch7sc9_4b65260d:

#   mc "To a magical future. Cheers!"
    mc "Para um futuro mágico. Saúde!"

# game/chapters/chapter7/ch7sc9.rpy:2266
translate brazil ch7sc9_199db034:

