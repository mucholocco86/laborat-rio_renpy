# game/chapters/chapter5/script/ch5sc12.rpy:53
translate brazil ch5sc12_3b3eaa08:

#   mc "Well... yeah."
    mc "Bem... sim."

# game/chapters/chapter5/script/ch5sc12.rpy:54
translate brazil ch5sc12_8fdfcc04:

#   mc "I guess I can’t argue with that."
