translate brazil ch6sc10_445e0152:

#   riv "And I intend to do so, our people will always be under my protection."
    riv "E é assim que pretendo fazer; nosso povo estará sempre sob minha proteção."

# game/chapters/chapter6/ch6sc10.rpy:144
translate brazil ch6sc10_561b1ad5:

#   mc "{b}‘Our’{/b} people, I like the sound of that."
    mc "{b}'Nosso'{/b} Pessoal, gostei da ideia."

# game/chapters/chapter6/ch6sc10.rpy:148
translate brazil ch6sc10_3a073208:

#   riv "Good, cause there’s no changing that at this point."
