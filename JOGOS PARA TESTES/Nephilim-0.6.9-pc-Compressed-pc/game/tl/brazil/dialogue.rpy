    tz "Você não estava brincando... ele ainda parece capaz de continuar como se nem estivéssemos aqui."

# game/chapters/chapter6/ch6sc10.rpy:6381
translate brazil ch6sc10_84ef64ab:

#   pl "Aren’t you happy we’re assisting you, sharky?"
    pl "Não estás feliz por estarmos te ajudando, tubarãozinho?"

# game/chapters/chapter6/ch6sc10.rpy:6383
translate brazil ch6sc10_b4a87a34:

