# game/chapters/chapter5/script/ch5sc12.rpy:1614
translate brazil ch5sc12_f037b1a3:

#   mc "As Dalen said, they're acting on the king’s orders. It'd be better if you can find out what's going on."
    mc "Como disse Dalen, eles estão agindo sob ordens do rei. Seria melhor se você pudesse descobrir o que está acontecendo."

# game/chapters/chapter5/script/ch5sc12.rpy:1616
translate brazil ch5sc12_1f4bd56f:

#   da "He’s right. We’ll start investigating whatever has happened. All of us."
    da "Ele tem razão. Vamos começar a investigar o que quer que tenha acontecido. Todos nós."

# game/chapters/chapter5/script/ch5sc12.rpy:1618
translate brazil ch5sc12_f5c1cbe9:

#   gd "Come on, then. Keeping the king waiting will only make things worse for you."
    gd "Vamos lá, então. Fazer o rei esperar só vai piorar as coisas para você."

# game/chapters/chapter5/script/ch5sc12.rpy:1620
translate brazil ch5sc12_fb287069:

#   gd "That’s more like it. No funny business, unless you want to feel the sting of my blade."
    gd "Isso sim! Sem gracinhas, a menos que você queira sentir a dor da minha lâmina."

# game/chapters/chapter5/script/ch5sc12.rpy:1635
translate brazil ch5sc12_7d28f2f9:

#   cwd "*Indistinct chattering*"
    cwd "*Ruído indistinto*"

# game/chapters/chapter5/script/ch5sc12.rpy:1637
translate brazil ch5sc12_784cd4ba:

#   bn "..."
    bn "..."

# game/chapters/chapter5/script/ch5sc12.rpy:1639
translate brazil ch5sc12_20c707ac:

#   bn "......"
    bn "......"

# game/chapters/chapter5/script/ch5sc12.rpy:1641
translate brazil ch5sc12_3aa28bd5:

#   bn "[mc], you stand accused of treason. How do you plead?"
    bn "[mc] Você está sendo acusado de traição. Como se declara?"

# game/chapters/chapter5/script/ch5sc12.rpy:1643
translate brazil ch5sc12_bad9c80f:

#   mct "{i}Treason!? What the fuck is going on? Everything seemed fine at breakfast this morning.{/i}"
    mct "{i}Traição?! Que merda está acontecendo? Tudo parecia normal no café da manhã hoje.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:1644
translate brazil ch5sc12_ecbf6a6c:

#   mc "Not guilty, Your Majesty."
    mc "Inocente, Vossa Majestade."

# game/chapters/chapter5/script/ch5sc12.rpy:1649
translate brazil ch5sc12_0b0ddeaf:

#   bn "You think you’re so clever, huh? Getting into our good graces and taking advantage of our trust."
    bn "Você se acha muito esperto, é? Tentando ganhar nossa simpatia e se aproveitando da nossa confiança."

# game/chapters/chapter5/script/ch5sc12.rpy:1650
translate brazil ch5sc12_0f920371:

#   bn "Tsk! Coming into our home, sleeping under our roof... eating at our own table!"
    bn "Que feio! Entrando na nossa casa, dormindo sob o nosso teto... comendo na nossa própria mesa!"

# game/chapters/chapter5/script/ch5sc12.rpy:1652
translate brazil ch5sc12_6ad0d589:

#   qm "Honey, let’s not-"
    qm "Querida, não vamos..."

# game/chapters/chapter5/script/ch5sc12.rpy:1654
translate brazil ch5sc12_b31b6f0e:

#   bn "Silence!"
    bn "Silêncio!"

# game/chapters/chapter5/script/ch5sc12.rpy:1656
translate brazil ch5sc12_ce3294a2:

#   bn "You may have my dear wife convinced of your innocence, but she’s got the soft heart of a woman."
    bn "Você pode ter convencido minha querida esposa da sua inocência, mas ela tem o coração mole de uma mulher."

# game/chapters/chapter5/script/ch5sc12.rpy:1658
translate brazil ch5sc12_4945c3f9:

#   mc "Your Grace, on what grounds am I being accused of treason?"
    mc "Vossa Graça, com que fundamentos estou sendo acusado de traição?"

# game/chapters/chapter5/script/ch5sc12.rpy:1659
translate brazil ch5sc12_8a529b5b:

#   bn "*Scoffs* As if you don’t already know! Very well..."
    bn "*Risos* Como se você já não soubesse! Muito bem..."

# game/chapters/chapter5/script/ch5sc12.rpy:1661
translate brazil ch5sc12_9bd28c98:

#   bn "Princess Amelia, my beloved daughter, is missing!"
    bn "A princesa Amélia, minha amada filha, está desaparecida!"

# game/chapters/chapter5/script/ch5sc12.rpy:1662
translate brazil ch5sc12_080f1af7:

#   bn "I am reliably informed that you were the last to be seen with her: leaving the capital this morning!"
    bn "Fui informada por fontes confiáveis ​​de que você foi a última pessoa vista com ela: saindo da capital esta manhã!"

# game/chapters/chapter5/script/ch5sc12.rpy:1664
translate brazil ch5sc12_a00f2353:

#   mct "{i}Amelia is missing? Fuck... I knew I should’ve insisted on escorting her all the way home.{/i}"
    mct "{i}Amelia está desaparecida? Droga... Eu sabia que devia ter insistido em acompanhá-la até em casa.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:1665
translate brazil ch5sc12_d74ba95d:

#   mc "Who is making these claims?"
    mc "Quem está fazendo essas afirmações?"

# game/chapters/chapter5/script/ch5sc12.rpy:1667
translate brazil ch5sc12_e9789e00:

#   ta "Me."
    ta "Meu."

# game/chapters/chapter5/script/ch5sc12.rpy:1668
translate brazil ch5sc12_46d15486:

#   ta "Hello, [mc]. I see you’ve managed to stoop to a new low. Kidnapping the princess..."
    ta "Olá, [mc] Vejo que você conseguiu chegar a um novo nível de baixeza. Sequestrando a princesa..."

# game/chapters/chapter5/script/ch5sc12.rpy:1669
translate brazil ch5sc12_169b46d6:

#   ta "Tsk, tsk. So unmannered."
    ta "Que feio! Que falta de educação!"

# game/chapters/chapter5/script/ch5sc12.rpy:1672
translate brazil ch5sc12_ab647844:

#   mc "Taron! You’re behind this? You’ll pay-"
    mc "Taron! Você está por trás disso? Você vai pagar!"

# game/chapters/chapter5/script/ch5sc12.rpy:1675
translate brazil ch5sc12_f51ca427:

#   bn "Silence! Taron’s men reported seeing you with Amelia."
    bn "Silêncio! Os homens de Taron relataram ter visto você com Amelia."

# game/chapters/chapter5/script/ch5sc12.rpy:1676
translate brazil ch5sc12_0fd5957a:

#   bn "And even that you'd somehow convinced her to swap into peasant clothes."
    bn "E até mesmo o fato de você, de alguma forma, tê-la convencido a trocar de roupa e vestir roupas de camponesa."

# game/chapters/chapter5/script/ch5sc12.rpy:1677
translate brazil ch5sc12_54154095:

#   bn "Likely, to avoid suspicion as you lured her away to do... divines know what to her!"
    bn "Provavelmente, para evitar suspeitas enquanto a atraía para fazer... sabe-se lá o quê com ela!"

# game/chapters/chapter5/script/ch5sc12.rpy:1679
translate brazil ch5sc12_5792f097:

#   bn "{b}WHERE IS MY LITTLE GIRL?! TELL ME!{/b}"
    bn "{b}ONDE ESTÁ MINHA FILHINHA?! ME DIGA!{/b}"

# game/chapters/chapter5/script/ch5sc12.rpy:1681
translate brazil ch5sc12_0de94826:

#   mc "*Clenches teeth* I... I don’t know where she is, Your Majesty."
    mc "*Aperta os dentes* Eu... eu não sei onde ela está, Vossa Majestade."

# game/chapters/chapter5/script/ch5sc12.rpy:1682
translate brazil ch5sc12_dec647b6:

#   mc "It’s true that Amelia and I ventured outside the city."
    mc "É verdade que eu e Amelia nos aventuramos para fora da cidade."

# game/chapters/chapter5/script/ch5sc12.rpy:1683
translate brazil ch5sc12_2f015c91:

#   mc "She'd asked me to take her exploring, and I agreed to escort her."
    mc "Ela me pediu para levá-la para explorar, e eu concordei em acompanhá-la."

# game/chapters/chapter5/script/ch5sc12.rpy:1686
translate brazil ch5sc12_a0f9cd45:

#   bn "{b}YOU WHAT?!{/b}"
    bn "{b}VOCÊ O QUÊ?!{/b}"

# game/chapters/chapter5/script/ch5sc12.rpy:1687
translate brazil ch5sc12_95b55fe8:

#   bn "You took my daughter outside the city, without a proper escort, and didn't notify me?!"
    bn "Você levou minha filha para fora da cidade, sem um acompanhante adequado, e não me avisou?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1689
translate brazil ch5sc12_09fd2639:

#   mc "As her bodyguard, was I supposed to let her leave on her own? With no protection at all?"
    mc "Como guarda-costas dela, eu deveria tê-la deixado sair sozinha? Sem nenhuma proteção?"

# game/chapters/chapter5/script/ch5sc12.rpy:1690
translate brazil ch5sc12_5ec4fd53:

#   mc "Knowing how strong willed she is, I thought it was best to cooperate and at least be able to watch over her."
    mc "Sabendo da sua personalidade forte, achei melhor cooperar e pelo menos poder ficar de olho nela."

# game/chapters/chapter5/script/ch5sc12.rpy:1692
translate brazil ch5sc12_7140c49a:

#   ta "A very convenient excuse."
    ta "Uma desculpa muito conveniente."

# game/chapters/chapter5/script/ch5sc12.rpy:1694
translate brazil ch5sc12_a7171b9f:

#   mc "I parted ways with Amelia in the city. A mistake on my part..."
    mc "Me despedi de Amelia na cidade. Um erro da minha parte..."

# game/chapters/chapter5/script/ch5sc12.rpy:1695
translate brazil ch5sc12_7c696336:

#   mc "Despite my better judgment, I agreed to part ways with her before we reached the palace..."
    mc "Apesar de saber que não devia ter bom senso, concordei em me separar dela antes de chegarmos ao palácio..."

# game/chapters/chapter5/script/ch5sc12.rpy:1696
translate brazil ch5sc12_c4004983:

#   mc "I should’ve obviously escorted her right to the castle gates."
    mc "Obviamente, eu deveria tê-la acompanhado até os portões do castelo."

# game/chapters/chapter5/script/ch5sc12.rpy:1698
translate brazil ch5sc12_6fc13ffb:

#   ta "He’s known to be a practiced liar, Your Majesty."
    ta "Sabe-se que ele é um mentiroso experiente, Vossa Majestade."

# game/chapters/chapter5/script/ch5sc12.rpy:1699
translate brazil ch5sc12_5523b8df:

#   ta "Not to mention, he has a history of violence towards young women."
    ta "Sem mencionar que ele tem um histórico de violência contra mulheres jovens."

# game/chapters/chapter5/script/ch5sc12.rpy:1702
translate brazil ch5sc12_6f401195:

#   mc "The hell I do! Shut your lying mouth-"
    mc "Claro que não! Cale a boca, seu mentiroso!"

# game/chapters/chapter5/script/ch5sc12.rpy:1704
translate brazil ch5sc12_8991df2e:

#   ta "Ah! Another outburst of violence."
    ta "Ah! Mais um surto de violência."

# game/chapters/chapter5/script/ch5sc12.rpy:1705
translate brazil ch5sc12_0bbe5865:

#   ta "But you don’t have to take my word for it. I’ve got irrefutable proof..."
    ta "Mas você não precisa acreditar na minha palavra. Eu tenho provas irrefutáveis..."

# game/chapters/chapter5/script/ch5sc12.rpy:1707
translate brazil ch5sc12_991ad612:

#   ta "Come on in, darling."
    ta "Entre, querida."

# game/chapters/chapter5/script/ch5sc12.rpy:1708
translate brazil ch5sc12_03595ee5:

#   ta "Show them what [mc] put you through last night."
    ta "Mostre a eles o quê [mc] te ajudei a passar pela noite passada."

# game/chapters/chapter5/script/ch5sc12.rpy:1709
translate brazil ch5sc12_c329ecc0:

#   "The door creaks open, and you're left speechless."
    "A porta range ao abrir, e você fica sem palavras."

# game/chapters/chapter5/script/ch5sc12.rpy:1711
translate brazil ch5sc12_8fc6d67f:

#   md1 "..."
    md1 "..."

# game/chapters/chapter5/script/ch5sc12.rpy:1712
translate brazil ch5sc12_54ce0e23:

#   qm "*Gasps in shock* No... No. This can’t be..."
    qm "*Suspiros de choque* Não... Não. Isso não pode ser..."

# game/chapters/chapter5/script/ch5sc12.rpy:1713
translate brazil ch5sc12_0ec2c227:

#   ta "Go on, darling. Tell them what you told me. How [mc] lured you into his room last night."
    ta "Vamos lá, querida. Conte a eles o que você me contou. Como? [mc] Ele te atraiu para o quarto dele ontem à noite."

# game/chapters/chapter5/script/ch5sc12.rpy:1715
translate brazil ch5sc12_095be3f6:

#   md1 "I... He... He wanted me to clean up something he'd spilled. But... but when I bent over, he- he..."
    md1 "Eu... Ele... Ele queria que eu limpasse algo que ele tinha derramado. Mas... mas quando eu me inclinei, ele- ele..."

# game/chapters/chapter5/script/ch5sc12.rpy:1716
translate brazil ch5sc12_16249e4b:

#   md1 "He grabbed me! I didn’t have time to shout before his hands were wrapped around my throat so tightly. I..."
    md1 "Ele me agarrou! Não tive tempo de gritar antes que suas mãos envolvessem meu pescoço com tanta força. Eu..."

# game/chapters/chapter5/script/ch5sc12.rpy:1719
translate brazil ch5sc12_69df28fa:

#   qm "*Shaken voice* I-I can’t hear any more of this!! AiiiyhhH! {size=+3}{b}{color=#2bff8b}Amelia!{/color}{/b}{/size}"
    qm "*Voz trêmula* Não aguento mais ouvir isso!! AiiiyhhH! {size=+3}{b}{color=#2bff8b}Amélia!{/color}{/b}{/size}"

# game/chapters/chapter5/script/ch5sc12.rpy:1720
translate brazil ch5sc12_3f29cd05:

#   ta "You assaulted this poor maid, and now you've also managed to terrify the Queen? Tsk, tsk."
    ta "Você agrediu essa pobre criada e agora conseguiu aterrorizar a Rainha também? Que feio."

# game/chapters/chapter5/script/ch5sc12.rpy:1722
translate brazil ch5sc12_3313e0fa:

#   mc "That’s not what-"
    mc "Não é isso que-"

# game/chapters/chapter5/script/ch5sc12.rpy:1725
translate brazil ch5sc12_3746b6eb:

#   bn "Was this woman in your room last night? Yes or no!"
    bn "Essa mulher estava no seu quarto ontem à noite? Sim ou não?"

# game/chapters/chapter5/script/ch5sc12.rpy:1727
translate brazil ch5sc12_f800bed0:

#   mc "Yes."
    mc "Sim."

# game/chapters/chapter5/script/ch5sc12.rpy:1729
translate brazil ch5sc12_6db0cdb0:

#   bn "You really are a twisted young man. To think you’d abuse our hospitality like this."
    bn "Você é mesmo um jovem pervertido. Pensar que você abusaria da nossa hospitalidade dessa maneira."

# game/chapters/chapter5/script/ch5sc12.rpy:1730
translate brazil ch5sc12_8f633e4e:

#   bn "You claim innocence, but all evidence points towards your wickedness."
    bn "Você alega inocência, mas todas as evidências apontam para a sua maldade."

# game/chapters/chapter5/script/ch5sc12.rpy:1731
translate brazil ch5sc12_3c83d197:

#   bn "I have no choice but to sentence you to the dungeons indefinitely."
    bn "Não tenho outra escolha senão sentenciá-lo às masmorras por tempo indeterminado."

# game/chapters/chapter5/script/ch5sc12.rpy:1732
translate brazil ch5sc12_831b6f0f:

#   bn "Until Amelia is safely returned to me, then we can figure out what happens next."
    bn "Até que Amelia retorne em segurança para mim, poderemos decidir o que acontecerá a seguir."

# game/chapters/chapter5/script/ch5sc12.rpy:1734
translate brazil ch5sc12_0bf8241d:

#   mct "{i}Taron, you... fucking prick. He must’ve been the one who has inflicted these horrors on Mei and kidnapped Amelia.{/i}"
    mct "{i}Taron, seu... filho da puta. Ele deve ter sido o responsável por infligir esses horrores à Mei e sequestrar a Amelia.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:1735
translate brazil ch5sc12_369a1e8c:

#   mc "Do what you must, Your Majesty. I am innocent in this matter, and that will remain true, whatever you might do."
    mc "Faça o que for preciso, Majestade. Sou inocente neste assunto, e isso continuará sendo verdade, aconteça o que acontecer."

# game/chapters/chapter5/script/ch5sc12.rpy:1736
translate brazil ch5sc12_f10f94e4:

#   bn "Guards! Take him away! Some time in the dungeons may loosen his tongue!"
    bn "Guardas! Levem-no daqui! Talvez um tempo nas masmorras o faça soltar a língua!"

# game/chapters/chapter5/script/ch5sc12.rpy:1738
translate brazil ch5sc12_303f1921:

#   ta "If I may make a suggestion, Your Majesty. I have the perfect prisoner to pair him up with."
    ta "Se me permite uma sugestão, Majestade, tenho o prisioneiro perfeito para fazer par com ele."

# game/chapters/chapter5/script/ch5sc12.rpy:1739
translate brazil ch5sc12_dd3543cc:

#   ta "I’m confident a night confined with him will make him squirm."
    ta "Tenho certeza de que uma noite confinada com ele o fará se contorcer."

# game/chapters/chapter5/script/ch5sc12.rpy:1740
translate brazil ch5sc12_ad65fa06:

#   bn "Very well. You’ve long been a loyal ally to the crown. If you think this will help bring Amelia back, then so be it."
    bn "Muito bem. Você tem sido um aliado leal da coroa por muito tempo. Se você acha que isso ajudará a trazer Amelia de volta, que assim seja."

# game/chapters/chapter5/script/ch5sc12.rpy:1743
translate brazil ch5sc12_0c3fe20d:

#   gd "I’m afraid this is the end of the road for you, asshole. Get in."
    gd "Receio que este seja o seu fim, seu idiota. Entre."

# game/chapters/chapter5/script/ch5sc12.rpy:1745
translate brazil ch5sc12_128473ec:

#   gd "I can’t believe they assigned common filth like you to protect our princess, and then you turn around and do this."
    gd "Não acredito que designaram gente insignificante como você para proteger nossa princesa, e depois você faz isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1746
translate brazil ch5sc12_de8216fc:

#   mc "I didn’t do shit."
    mc "Eu não fiz porra nenhuma."

# game/chapters/chapter5/script/ch5sc12.rpy:1747
translate brazil ch5sc12_1ca71d78:

#   mc "While you’re in here mocking me, Amelia is out there suffering."
    mc "Enquanto você está aí zombando de mim, Amelia está lá fora sofrendo."

# game/chapters/chapter5/script/ch5sc12.rpy:1748
translate brazil ch5sc12_c67d60dd:

#   gd "You’re the one who made her suffer!"
    gd "Foi você quem a fez sofrer!"

# game/chapters/chapter5/script/ch5sc12.rpy:1749
translate brazil ch5sc12_b69e5c36:

#   gd "Seeing that poor maid, I don’t even want to imagine what you've put the princess through!"
    gd "Vendo aquela pobre criada, nem quero imaginar o que você fez a princesa passar!"

# game/chapters/chapter5/script/ch5sc12.rpy:1751
translate brazil ch5sc12_5aedc731:

#   gd "C’mon. Let’s leave this filthy dog to stew on what he’s done."
    gd "Vamos lá. Deixemos esse cachorro imundo remoendo o que fez."

# game/chapters/chapter5/script/ch5sc12.rpy:1752
translate brazil ch5sc12_9a2f5a47:

#   gd "Maybe a few days without food will jog his memory."
    gd "Talvez alguns dias sem comer lhe ajudem a recuperar a memória."

# game/chapters/chapter5/script/ch5sc12.rpy:1754
translate brazil ch5sc12_d26ade5b:

#   mct "There’s not much I can do from in here."
    mct "Não há muito que eu possa fazer daqui de dentro."

# game/chapters/chapter5/script/ch5sc12.rpy:1755
translate brazil ch5sc12_008b2f7b:

#   mct "But Dalen is right, fighting the guards will only make a bigger mess of things."
    mct "Mas Dalen tem razão, lutar contra os guardas só vai piorar as coisas."

# game/chapters/chapter5/script/ch5sc12.rpy:1758
translate brazil ch5sc12_fc0bfd9e:

#   ta "Well, well, well."
    ta "Bem, bem, bem."

# game/chapters/chapter5/script/ch5sc12.rpy:1759
translate brazil ch5sc12_995b17f3:

#   ta "If the beast hasn’t found his way to his cage. Heh, fitting!"
    ta "Se a fera ainda não encontrou o caminho para sua jaula. Heh, apropriado!"

# game/chapters/chapter5/script/ch5sc12.rpy:1761
translate brazil ch5sc12_a2497c2c:

#   ta "Oh, how many years I’ve waited for this moment."
    ta "Oh, quantos anos esperei por este momento."

# game/chapters/chapter5/script/ch5sc12.rpy:1762
translate brazil ch5sc12_ab0c5cec:

#   ta "It only took killing your parents, then chasing you and Oren around for a decade."
    ta "Bastou matar seus pais e depois perseguir você e Oren por uma década."

# game/chapters/chapter5/script/ch5sc12.rpy:1764
translate brazil ch5sc12_d5480231:

#   mc "What the fuck do you want, Taron?"
    mc "Que porra você quer, Taron?"

# game/chapters/chapter5/script/ch5sc12.rpy:1765
translate brazil ch5sc12_02e5d507:

#   mc "Actually, never mind. I don't care what you want. You’re a dead man walking anyway."
    mc "Na verdade, deixa pra lá. Não me interessa o que você quer. Você já está morto e enterrado de qualquer jeito."

# game/chapters/chapter5/script/ch5sc12.rpy:1767
translate brazil ch5sc12_5df54cf5:

#   ta "Ooooh. Scary! You've got me quaking in my boots, beast."
    ta "Uau! Que medo! Você me deixou tremendo de medo, fera."

# game/chapters/chapter5/script/ch5sc12.rpy:1769
translate brazil ch5sc12_f89b91e9:

#   ta "I don’t think you realize the predicament you’re in."
    ta "Acho que você não se dá conta da situação difícil em que se encontra."

# game/chapters/chapter5/script/ch5sc12.rpy:1770
translate brazil ch5sc12_f685448c:

#   ta "But how could an animal like you possibly understand?"
    ta "Mas como um animal como você poderia entender?"

# game/chapters/chapter5/script/ch5sc12.rpy:1771
translate brazil ch5sc12_487b7b5e:

#   ta "Luckily, the king is reasonable enough to heed my advice, so I've arranged for a fitting cellmate for you."
    ta "Felizmente, o rei é razoável o suficiente para acatar meu conselho, então providenciei um companheiro de cela adequado para você."

# game/chapters/chapter5/script/ch5sc12.rpy:1773
translate brazil ch5sc12_08f1cb9e:

#   ta "I’ll leave you two to get better acquainted."
    ta "Vou deixar vocês dois se conhecerem melhor."

# game/chapters/chapter5/script/ch5sc12.rpy:1774
translate brazil ch5sc12_984e0cb6:

#   ta "Oh, and do be wary of the moon tonight."
    ta "Ah, e tenha cuidado com a lua esta noite."

# game/chapters/chapter5/script/ch5sc12.rpy:1775
translate brazil ch5sc12_421404da:

#   ta "It brings out the... beast in people! *Snickers*"
    ta "Isso desperta o lado... selvagem das pessoas! *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:1777
translate brazil ch5sc12_7d687691:

#   mc "Who are you talking about?"
    mc "De quem você está falando?"

# game/chapters/chapter5/script/ch5sc12.rpy:1779
translate brazil ch5sc12_ff1475db:

#   uk "I’m afraid that would be me."
    uk "Receio que esse alguém seria eu."

# game/chapters/chapter5/script/ch5sc12.rpy:1781
translate brazil ch5sc12_5c726914:

#   uk "Tell me, kid, why are you on Taron’s shit-list?"
    uk "Diga-me, garoto, por que você está na lista negra do Taron?"

# game/chapters/chapter5/script/ch5sc12.rpy:1783
translate brazil ch5sc12_4e459eee:

#   mc "I was born."
    mc "Eu nasci."

# game/chapters/chapter5/script/ch5sc12.rpy:1784
translate brazil ch5sc12_4639bcb2:

#   uk "*Chuckles*"
    uk "*Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:1786
translate brazil ch5sc12_9b440e24:

#   uk "Sounds about right. Taron can be... difficult."
    uk "Parece fazer sentido. Taron pode ser... difícil."

# game/chapters/chapter5/script/ch5sc12.rpy:1788
translate brazil ch5sc12_3588ed43:

#   mc "If, by difficult, you mean the kind of man who'd murder my parents in cold blood..."
    mc "Se, por difícil, você quer dizer o tipo de homem que assassinaria meus pais a sangue frio..."

# game/chapters/chapter5/script/ch5sc12.rpy:1789
translate brazil ch5sc12_acb0484e:

#   mc "Then spent a decade chasing me down, and hurt anyone I get close to... then yeah."
    mc "Depois passou uma década me perseguindo e machucando qualquer pessoa de quem eu me aproximasse... aí sim."

# game/chapters/chapter5/script/ch5sc12.rpy:1791
translate brazil ch5sc12_14b4c3cf:

#   uk "He’s a right arsehole, that one. A real prick."
    uk "Ele é um tremendo babaca, aquele cara. Um verdadeiro idiota."

# game/chapters/chapter5/script/ch5sc12.rpy:1792
translate brazil ch5sc12_05594813:

#   uk "But he’ll get what’s coming to him. Eventually, they all do."
    uk "Mas ele vai receber o que merece. No fim, todos recebem."

# game/chapters/chapter5/script/ch5sc12.rpy:1794
translate brazil ch5sc12_1738cbcc:

#   mc "Are you in here because of him too?"
    mc "Você também está aqui por causa dele?"

# game/chapters/chapter5/script/ch5sc12.rpy:1796
translate brazil ch5sc12_f884976a:

#   uk "Nay. I’m here because of my own stupidity, I’m afraid."
    uk "Não. Estou aqui por causa da minha própria estupidez, receio."

# game/chapters/chapter5/script/ch5sc12.rpy:1797
translate brazil ch5sc12_edef336a:

#   uk "I was caught thieving, you see. I was in the midst of emptying this noble woman’s coffers when..."
    uk "Fui apanhado a roubar, sabe? Estava no meio de esvaziar os cofres desta nobre senhora quando..."

# game/chapters/chapter5/script/ch5sc12.rpy:1798
translate brazil ch5sc12_8aa392ee:

#   uk "An argument broke out between her husband and herself. She stormed into the bedroom sobbing wildly."
    uk "Uma discussão começou entre ela e o marido. Ela entrou furiosa no quarto, soluçando descontroladamente."

# game/chapters/chapter5/script/ch5sc12.rpy:1800
translate brazil ch5sc12_cca6db1f:

#   uk "So, what did I do? Instead of hiding, I decided to comfort her."
    uk "Então, o que eu fiz? Em vez de me esconder, decidi confortá-la."

# game/chapters/chapter5/script/ch5sc12.rpy:1801
translate brazil ch5sc12_9f80e1f0:

#   uk "She was so distraught, she didn’t even question why I was there in her bedroom-"
    uk "Ela estava tão transtornada que nem questionou por que eu estava ali em seu quarto."

# game/chapters/chapter5/script/ch5sc12.rpy:1805
translate brazil ch5sc12_32d54db5:

#   uk "We ended up fucking like wild animals, until her husband came barging in."
    uk "Acabamos transando como animais selvagens, até que o marido dela entrou de repente."

# game/chapters/chapter5/script/ch5sc12.rpy:1806
translate brazil ch5sc12_44da71fb:

#   uk "Talk about being caught with your pants down."
    uk "Imagine ser pego de calças curtas!"

# game/chapters/chapter5/script/ch5sc12.rpy:1808
translate brazil ch5sc12_e5e36607:

#   mc "You’re kidding, right?"
    mc "Você está brincando, né?"

# game/chapters/chapter5/script/ch5sc12.rpy:1809
translate brazil ch5sc12_eb209ce3:

#   mc "You were there to steal her jewelry and ended up fucking her?{b} WHILE{/b} her husband was home?"
    mc "Você estava lá para roubar as joias dela e acabou transando com ela?{b} ENQUANTO{/b} O marido dela estava em casa?"

# game/chapters/chapter5/script/ch5sc12.rpy:1811
translate brazil ch5sc12_0d73a917:

#   uk "What can I say? She was a passionate women."
    uk "O que posso dizer? Ela era uma mulher apaixonada."

# game/chapters/chapter5/script/ch5sc12.rpy:1812
translate brazil ch5sc12_2fe12cd5:

#   uk "And I... well, I happen to have a weak spot for well-endowed women. *Chuckles*"
    uk "E eu... bem, eu tenho uma queda por mulheres bem dotadas. *Risos*"

# game/chapters/chapter5/script/ch5sc12.rpy:1814
translate brazil ch5sc12_a98ab0c5:

#   uk "So that’s how I ended up in here, awaiting my sentence."
    uk "Foi assim que acabei aqui, aguardando minha sentença."

# game/chapters/chapter5/script/ch5sc12.rpy:1815
translate brazil ch5sc12_96d0b8d6:

#   uk "Which, as you may know, is likely to be death for stealing from nobles."
    uk "O que, como você deve saber, provavelmente resultará em pena de morte para quem rouba de nobres."

# game/chapters/chapter5/script/ch5sc12.rpy:1817
translate brazil ch5sc12_6b071ebc:

#   mc "You wouldn’t happen to be the thief who’s been stealing panties around Luxenford, would you?"
    mc "Por acaso você não seria o ladrão que anda roubando calcinhas por Luxenford?"

# game/chapters/chapter5/script/ch5sc12.rpy:1818
translate brazil ch5sc12_ba3bdd81:

#   uk "Oh? *Chuckles* You’re on ‘her’ trail? Good luck. She’s a slippery one."
    uk "Ah? *Risos* Você está no rastro dela? Boa sorte. Ela é muito escorregadia."

# game/chapters/chapter5/script/ch5sc12.rpy:1820
translate brazil ch5sc12_4736ec50:

#   mc "You know her? What... don’t tell me there's some kind of guild for thieves too?"
    mc "Você a conhece? O quê... não me diga que existe algum tipo de guilda para ladrões também?"

# game/chapters/chapter5/script/ch5sc12.rpy:1822
translate brazil ch5sc12_c32da6ef:

#   uk "Something like that. We’re both members of an organization called ‘{b}The King’s Coin{/b}’. I guess we function a bit like a guild."
    uk "Algo assim. Nós dois somos membros de uma organização chamada '{b}A Moeda do Rei{/b}Acho que funcionamos um pouco como uma guilda."

# game/chapters/chapter5/script/ch5sc12.rpy:1824
translate brazil ch5sc12_746d67aa:

#   uk "But for obvious reasons, we aren’t recognized officially."
    uk "Mas, por razões óbvias, não somos reconhecidos oficialmente."

# game/chapters/chapter5/script/ch5sc12.rpy:1826
translate brazil ch5sc12_bf197e6c:

#   uk "*Chuckles* Hah! I've had a good run with them."
    uk "*Risos* Hah! Me diverti bastante com eles."

# game/chapters/chapter5/script/ch5sc12.rpy:1827
translate brazil ch5sc12_7bbb2fa2:

#   uk "They're the closest thing I have to family."
    uk "Eles são o mais próximo que tenho de uma família."

# game/chapters/chapter5/script/ch5sc12.rpy:1829
translate brazil ch5sc12_6af7407b:

#   mc "Thieves... family? Aren’t they just as likely to stab you in the back?"
    mc "Ladrões... família? Não é tão provável que eles te apunhalem pelas costas?"

# game/chapters/chapter5/script/ch5sc12.rpy:1831
translate brazil ch5sc12_39f41bf2:

#   uk "You couldn’t be more wrong, kid. We live by our own code, true. And if you’re caught, you're on your own."
    uk "Você não poderia estar mais enganado, garoto. Nós vivemos segundo o nosso próprio código, é verdade. E se você for pego, estará por sua conta."

# game/chapters/chapter5/script/ch5sc12.rpy:1832
translate brazil ch5sc12_7c12cb00:

#   uk "But, not one of us would ever sell out another."
    uk "Mas nenhum de nós jamais trairia o outro."

# game/chapters/chapter5/script/ch5sc12.rpy:1834
translate brazil ch5sc12_89e0f6e1:

#   mc "I’m guessing we shouldn’t bank on them staging a rescue, then?"
    mc "Imagino que não devemos contar com um resgate por parte deles, então?"

# game/chapters/chapter5/script/ch5sc12.rpy:1836
translate brazil ch5sc12_18f0e37c:

#   uk "Nay, we shouldn’t. Besides, the King’s Coin is based mostly in Raven's Rest."
    uk "Não, não deveríamos. Além disso, a Moeda do Rei é baseada principalmente em Raven's Rest."

# game/chapters/chapter5/script/ch5sc12.rpy:1837
translate brazil ch5sc12_9eebb7d9:

#   uk "As far as I know, your panty thief and I are the only two members here in Luxenford, currently."
    uk "Pelo que sei, seu ladrão de calcinhas e eu somos os únicos dois membros aqui em Luxenford, atualmente."

# game/chapters/chapter5/script/ch5sc12.rpy:1839
translate brazil ch5sc12_5a21c7ac:

#   uk "..."
    uk "..."

# game/chapters/chapter5/script/ch5sc12.rpy:1841
translate brazil ch5sc12_0e625e8a:

#   lc "Name’s Lucien. But ‘{b}Old Wolf{/b}’ is my call sign during operations."
    lc "Meu nome é Lucien. Mas...{b}Lobo Velho{/b}' é o meu indicativo de chamada durante as operações."

# game/chapters/chapter5/script/ch5sc12.rpy:1843
translate brazil ch5sc12_2b9ffeff:

#   mc "[mc]. Good to meet you, Lucien."
    mc "[mc] Prazer em conhecê-lo, Lucien."

# game/chapters/chapter5/script/ch5sc12.rpy:1844
translate brazil ch5sc12_e292b26a:

#   lc "Same, kiddo. So... I heard something about a certain princess being kidnapped."
    lc "Igualmente, garoto. Então... ouvi dizer que uma certa princesa foi sequestrada."

# game/chapters/chapter5/script/ch5sc12.rpy:1845
translate brazil ch5sc12_04347995:

#   lc "And somehow Taron's pinning it on you?"
    lc "E de alguma forma o Taron está colocando a culpa em você?"

# game/chapters/chapter5/script/ch5sc12.rpy:1846
translate brazil ch5sc12_1a3ce239:

#   mc "Pretty much."
    mc "Praticamente isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1847
translate brazil ch5sc12_55788793:

#   mc "I was assigned to be her bodyguard."
    mc "Fui designado para ser seu guarda-costas."

# game/chapters/chapter5/script/ch5sc12.rpy:1848
translate brazil ch5sc12_d80af076:

#   mc "We went on a small excursion so she could let off some steam."
    mc "Fizemos um pequeno passeio para que ela pudesse desestressar um pouco."

# game/chapters/chapter5/script/ch5sc12.rpy:1849
translate brazil ch5sc12_aa03218e:

#   mc "I felt a false sense of safety being so close to the castle..."
    mc "Senti uma falsa sensação de segurança por estar tão perto do castelo..."

# game/chapters/chapter5/script/ch5sc12.rpy:1850
translate brazil ch5sc12_04170700:

#   mc "And I made the mistake of letting her return the rest of the way alone."
    mc "E eu cometi o erro de deixá-la voltar o resto do caminho sozinha."

# game/chapters/chapter5/script/ch5sc12.rpy:1852
translate brazil ch5sc12_b280a7e0:

#   lc "But you didn’t actually abduct her?"
    lc "Mas você não a sequestrou de verdade?"

# game/chapters/chapter5/script/ch5sc12.rpy:1854
translate brazil ch5sc12_e916960f:

#   mc "Fuck no! That bastard Taron is behind it! He’s set everything up to make me look like the bad guy."
    mc "Nem pensar! Aquele desgraçado do Taron está por trás disso! Ele armou tudo para me fazer parecer o vilão."

# game/chapters/chapter5/script/ch5sc12.rpy:1855
translate brazil ch5sc12_8a0b9c1a:

#   mc "He even got to one of the maids."
    mc "Ele chegou até a se aproximar de uma das empregadas."

# game/chapters/chapter5/script/ch5sc12.rpy:1856
translate brazil ch5sc12_564bca29:

#   mc "She was in my room last night, and today he presented her to the court all covered in bruises."
    mc "Ela estava no meu quarto ontem à noite, e hoje ele a apresentou ao tribunal toda coberta de hematomas."

# game/chapters/chapter5/script/ch5sc12.rpy:1858
translate brazil ch5sc12_7a4ad19d:

#   lc "Which they assumed you’d given her? Clever..."
    lc "Eles presumiram que você tinha dado a ela? Inteligente..."

# game/chapters/chapter5/script/ch5sc12.rpy:1860
translate brazil ch5sc12_d7c67144:

#   lc "I’ll wager she didn’t tell the truth to the King?"
    lc "Aposto que ela não contou a verdade ao Rei."

# game/chapters/chapter5/script/ch5sc12.rpy:1862
translate brazil ch5sc12_0cf07428:

#   mc "Yeah... she lied, convincingly."
    mc "Sim... ela mentiu, e de forma convincente."

# game/chapters/chapter5/script/ch5sc12.rpy:1864
translate brazil ch5sc12_b1e41bf5:

#   lc "Sounds like a good, old-fashioned blackmail situation."
    lc "Parece uma boa e velha situação de chantagem."

# game/chapters/chapter5/script/ch5sc12.rpy:1865
translate brazil ch5sc12_07ffc7ba:

#   lc "She was probably seen leaving your room, and he seized on the opportunity."
    lc "Provavelmente ela foi vista saindo do seu quarto, e ele aproveitou a oportunidade."

# game/chapters/chapter5/script/ch5sc12.rpy:1867
translate brazil ch5sc12_e1ad4db4:

#   lc "I doubt she had any choice but to tell whatever version of the story that he wanted."
    lc "Duvido que ela tivesse outra escolha a não ser contar a versão da história que ele queria."

# game/chapters/chapter5/script/ch5sc12.rpy:1868
translate brazil ch5sc12_7d0ad574:

#   lc "After a sufficiently thorough beating, most people will comply out of fear."
    lc "Após uma surra suficientemente severa, a maioria das pessoas obedecerá por medo."

# game/chapters/chapter5/script/ch5sc12.rpy:1870
translate brazil ch5sc12_cbe54d08:

#   lc "Could even be that she’s protecting loved ones who may get hurt if she doesn't play along."
    lc "Pode até ser que ela esteja protegendo entes queridos que podem se machucar se ela não colaborar."

# game/chapters/chapter5/script/ch5sc12.rpy:1872
translate brazil ch5sc12_0d98ada7:

#   mc "Yeah... I can't hold it against her."
    mc "Sim... Não posso guardar rancor dela."

# game/chapters/chapter5/script/ch5sc12.rpy:1873
translate brazil ch5sc12_c497f78d:

#   mc "It's obvious she was brutally assaulted and traumatized."
    mc "É óbvio que ela foi brutalmente agredida e traumatizada."

# game/chapters/chapter5/script/ch5sc12.rpy:1874
translate brazil ch5sc12_cf86f4bd:

#   mc "Taron is the problem. One I need to deal with, very soon."
    mc "Taron é o problema. Um problema que preciso resolver, muito em breve."

# game/chapters/chapter5/script/ch5sc12.rpy:1876
translate brazil ch5sc12_f1bab997:

#   mct "{i}*Sighs* There’s not much I can do from here, though. It’s all up to Eliza and the others now.{/i}"
    mct "{i}*Suspiro* Não há muito que eu possa fazer daqui. Agora tudo depende da Eliza e dos outros.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:1884
translate brazil ch5sc12_00b825d9:

#   el "What in the high heavens and the five hells is going on? Why did they take [mc]?!"
    el "Que diabos está acontecendo? Por que eles levaram...? [mc]?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1885
translate brazil ch5sc12_0fc76f0d:

#   el "How can they just waltz right in here and demand he goes with them?!"
    el "Como é que eles podem simplesmente entrar aqui e exigir que ele vá com eles?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1887
translate brazil ch5sc12_0e5e2fad:

#   br "Aye... something is off."
    br "Sim... algo está errado."

# game/chapters/chapter5/script/ch5sc12.rpy:1888
translate brazil ch5sc12_2646b872:

#   br "I thought [mc] was getting along with the King and Queen."
    br "Eu pensei [mc] Estava se dando bem com o Rei e a Rainha."

# game/chapters/chapter5/script/ch5sc12.rpy:1889
translate brazil ch5sc12_9641bfd6:

#   br "Why would they arrest him like that, all of a sudden?"
    br "Por que o prenderiam assim, de repente?"

# game/chapters/chapter5/script/ch5sc12.rpy:1891
translate brazil ch5sc12_4aa70c6e:

#   da "One of my old buddies in the King’s Guard told me he's a suspect in Princess Amelia’s disappearance."
    da "Um dos meus antigos camaradas da Guarda Real me disse que ele é suspeito no desaparecimento da Princesa Amélia."

# game/chapters/chapter5/script/ch5sc12.rpy:1893
translate brazil ch5sc12_0cf65d34:

#   el "The Princess is missing?!"
    el "A princesa está desaparecida?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1894
translate brazil ch5sc12_3935583f:

#   el "What? {b}HOW?!{/b} [mc] just spent the entire day with her!"
    el "O que? {b} COMO?!{/b}  [mc] Passei o dia inteiro com ela!"

# game/chapters/chapter5/script/ch5sc12.rpy:1896
translate brazil ch5sc12_15b192dd:

#   da "Which is why he's their prime suspect."
    da "Por isso ele é o principal suspeito."

# game/chapters/chapter5/script/ch5sc12.rpy:1897
translate brazil ch5sc12_bae29701:

#   da "He's an outsider who broke the rules and escorted the princess outside of the city."
    da "Ele é um forasteiro que quebrou as regras e escoltou a princesa para fora da cidade."

# game/chapters/chapter5/script/ch5sc12.rpy:1898
translate brazil ch5sc12_a94d7fa3:

#   da "Additionally, during the hearing this morning, one of the handmaidens showed up, covered in bruises. She claimed that [mc] did it."
    da "Além disso, durante a audiência desta manhã, uma das criadas apareceu coberta de hematomas. Ela alegou que [mc] Consegui."

# game/chapters/chapter5/script/ch5sc12.rpy:1901
translate brazil ch5sc12_78d6301f:

#   el "{b}LIES!! FUCKING LIES!{/b}"
    el "{b}MENTIRAS!! MENTIRAS DESCARADAS!{/b}"

# game/chapters/chapter5/script/ch5sc12.rpy:1903
translate brazil ch5sc12_72ede466:

#   da "With everything else pointing at him, they're taking her statement at face value."
    da "Com todas as outras evidências apontando para ele, estão aceitando a declaração dela como verdadeira."

# game/chapters/chapter5/script/ch5sc12.rpy:1904
translate brazil ch5sc12_3d33f4ec:

#   da "Even if it is a blatant lie."
    da "Mesmo que seja uma mentira descarada."

# game/chapters/chapter5/script/ch5sc12.rpy:1905
translate brazil ch5sc12_3d8a5daf:

#   da "Their daughter is missing: thinking rationally, or taking their time to question, it's not something they're likely to do right now."
    da "A filha deles está desaparecida: pensar racionalmente ou parar para questionar, não é algo que eles provavelmente farão agora."

# game/chapters/chapter5/script/ch5sc12.rpy:1907
translate brazil ch5sc12_2c4d30f5:

#   el "That’s it! I’m breaking him out, right now!"
    el "É isso aí! Vou libertá-lo agora mesmo!"

# game/chapters/chapter5/script/ch5sc12.rpy:1908
translate brazil ch5sc12_61a10290:

#   el "He’s not spending a moment longer in some murky cell!"
    el "Ele não vai passar nem mais um minuto naquela cela escura!"

# game/chapters/chapter5/script/ch5sc12.rpy:1910
translate brazil ch5sc12_1519f82e:

#   br "Afraid what Dalen said earlier still holds true, lass."
    br "Receio que o que Dalen disse antes ainda seja verdade, moça."

# game/chapters/chapter5/script/ch5sc12.rpy:1911
translate brazil ch5sc12_57391ce7:

#   br "We can’t. It would only serve to make him look more guilty."
    br "Não podemos. Isso só serviria para fazê-lo parecer mais culpado."

# game/chapters/chapter5/script/ch5sc12.rpy:1913
translate brazil ch5sc12_8e88d071:

#   el "Then... what do we do?!"
    el "E então... o que fazemos?!"

# game/chapters/chapter5/script/ch5sc12.rpy:1914
translate brazil ch5sc12_07177b50:

#   el "I refuse to just sit here while he’s suffering!"
    el "Eu me recuso a ficar aqui sentada enquanto ele sofre!"

# game/chapters/chapter5/script/ch5sc12.rpy:1916
translate brazil ch5sc12_8f3bb8ca:

#   sy "It’s simple! If we can’t break him out, we’ll just have to find the princess instead!"
    sy "É simples! Se não conseguirmos libertá-lo, teremos que encontrar a princesa!"

# game/chapters/chapter5/script/ch5sc12.rpy:1917
translate brazil ch5sc12_e701d82b:

#   el "Sylph? Alice? Luna?"
    el "Sílfide? Alice? Luna?"

# game/chapters/chapter5/script/ch5sc12.rpy:1918
translate brazil ch5sc12_52dd4917:

#   da "I’m glad the three of you could make it."
    da "Fico feliz que vocês três tenham conseguido vir."

# game/chapters/chapter5/script/ch5sc12.rpy:1920
translate brazil ch5sc12_9b34f6e8:

#   lu "Of course! Sylph filled us in on the way here."
    lu "Claro! Sylph nos contou tudo no caminho para cá."

# game/chapters/chapter5/script/ch5sc12.rpy:1921
translate brazil ch5sc12_38b3f8ae:

#   lu "There’s no way [mc] will stay behind bars if all of us work together."
    lu "Não tem jeito. [mc] Ficaremos atrás das grades se todos trabalharmos juntos."

# game/chapters/chapter5/script/ch5sc12.rpy:1923
translate brazil ch5sc12_aa909131:

#   al "Damn straight!"
    al "Com certeza!"

# game/chapters/chapter5/script/ch5sc12.rpy:1924
translate brazil ch5sc12_9e6ab212:

#   al "[mc] will be free in no time. This time, we're going to save him!"
    al "[mc] Ele estará livre num instante. Desta vez, vamos salvá-lo!"

# game/chapters/chapter5/script/ch5sc12.rpy:1926
translate brazil ch5sc12_203125a4:

#   br "It’s good yer all here."
    br "Que bom que todos vocês estão aqui."

# game/chapters/chapter5/script/ch5sc12.rpy:1927
translate brazil ch5sc12_b8553187:

#   br "But how will we find the princess? She could be anywhere."
    br "Mas como vamos encontrar a princesa? Ela pode estar em qualquer lugar."

# game/chapters/chapter5/script/ch5sc12.rpy:1928
translate brazil ch5sc12_6738debb:

#   da "That’s where Luna comes in."
    da "É aí que Luna entra em cena."

# game/chapters/chapter5/script/ch5sc12.rpy:1929
translate brazil ch5sc12_737383a9:

#   da "I’ve worked with her mother, Cassandra, before. And Luna is also a talented young sorceress."
    da "Eu já trabalhei com a mãe dela, Cassandra, antes. E Luna também é uma jovem feiticeira talentosa."

# game/chapters/chapter5/script/ch5sc12.rpy:1931
translate brazil ch5sc12_7b6f499e:

#   lu "Thank you for the vote of confidence, Dalen."
    lu "Obrigado pelo voto de confiança, Dalen."

# game/chapters/chapter5/script/ch5sc12.rpy:1932
translate brazil ch5sc12_b4d46b67:

#   lu "And yes, I can perform a locator spell on the princess."
    lu "E sim, posso lançar um feitiço de localização na princesa."

# game/chapters/chapter5/script/ch5sc12.rpy:1933
translate brazil ch5sc12_a28b381b:

#   lu "But I'm going to need something of Princess Amelia's to do it."
    lu "Mas vou precisar de algo da Princesa Amelia para fazer isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1934
translate brazil ch5sc12_db3b14dc:

#   lu "Like a personal belonging... or her blood."
    lu "Como um objeto pessoal... ou o sangue dela."

# game/chapters/chapter5/script/ch5sc12.rpy:1936
translate brazil ch5sc12_e187c58c:

#   br "Blast it... I knew it sounded too easy."
    br "Puxa vida... Eu sabia que parecia fácil demais."

# game/chapters/chapter5/script/ch5sc12.rpy:1937
translate brazil ch5sc12_511db6ab:

#   da "Amelia’s blood is clearly out of the question."
    da "O sangue de Amelia está claramente fora de questão."

# game/chapters/chapter5/script/ch5sc12.rpy:1938
translate brazil ch5sc12_2d4a9f1a:

#   da "Someone will have to break into Valois Palace and retrieve some of Amelia’s belongings."
    da "Alguém terá que invadir o Palácio Valois e recuperar alguns pertences de Amélia."

# game/chapters/chapter5/script/ch5sc12.rpy:1940
translate brazil ch5sc12_5c0944f0:

#   el "I’ll do it."
    el "Eu farei isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1942
translate brazil ch5sc12_1d7cb205:

#   al "Eliza? Are you sure?"
    al "Eliza? Tem certeza?"

# game/chapters/chapter5/script/ch5sc12.rpy:1944
translate brazil ch5sc12_96fefbe6:

#   el "I’m the one best suited to do it."
    el "Eu sou a pessoa mais indicada para fazer isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1945
translate brazil ch5sc12_d876123e:

#   el "I already know some of the palace layout from the banquet."
    el "Eu já conheço parte da planta do palácio por causa do banquete."

# game/chapters/chapter5/script/ch5sc12.rpy:1947
translate brazil ch5sc12_f4d881d8:

#   el "I can move faster than the human eye can perceive."
    el "Consigo me mover mais rápido do que o olho humano consegue perceber."

# game/chapters/chapter5/script/ch5sc12.rpy:1948
translate brazil ch5sc12_05af6aac:

#   el "I move silently, and I can climb vertical walls with ease."
    el "Eu me movo silenciosamente e consigo escalar paredes verticais com facilidade."

# game/chapters/chapter5/script/ch5sc12.rpy:1950
translate brazil ch5sc12_e27103e4:

#   el "Out of all of us, it comes down to me or to Sylph."
    el "Entre todos nós, a escolha fica entre mim e Sylph."

# game/chapters/chapter5/script/ch5sc12.rpy:1951
translate brazil ch5sc12_7c4490c3:

#   el "But I feel confident in my abilities to get this done."
    el "Mas estou confiante na minha capacidade de realizar isso."

# game/chapters/chapter5/script/ch5sc12.rpy:1953
translate brazil ch5sc12_40088614:

#   da "Hmh, you’re right. You’re the best bet for getting in and out unnoticed."
    da "Hum, você tem razão. Você é a melhor opção para entrar e sair sem ser notado."

# game/chapters/chapter5/script/ch5sc12.rpy:1955
translate brazil ch5sc12_fb0fbee2:

#   br "Aye, the lass is stealthy as a cat! I know she can do it."
    br "Sim, a moça é furtiva como um gato! Eu sei que ela consegue."

# game/chapters/chapter5/script/ch5sc12.rpy:1957
translate brazil ch5sc12_55b622fb:

#   al "I can assist as well."
    al "Eu também posso ajudar."

# game/chapters/chapter5/script/ch5sc12.rpy:1958
translate brazil ch5sc12_375eb978:

#   al "I’ve been brewing a variety of utility elixirs and potions lately. I brought one that can shroud the imbiber."
    al "Ultimamente, tenho preparado diversos elixires e poções úteis. Trouxe um que pode envolver quem o bebe em um manto."

# game/chapters/chapter5/script/ch5sc12.rpy:1959
translate brazil ch5sc12_db5cdf9d:

#   al "I haven’t tested it, yet."
    al "Ainda não testei."

# game/chapters/chapter5/script/ch5sc12.rpy:1960
translate brazil ch5sc12_0360cec6:

#   al "But according to the recipe, it should make whoever drinks it nearly invisible, as long as they remain still."
    al "Mas, de acordo com a receita, quem a beber ficará praticamente invisível, desde que permaneça imóvel."

# game/chapters/chapter5/script/ch5sc12.rpy:1962
translate brazil ch5sc12_8fdeddcf:

#   el "Alice, that’s brilliant!"
    el "Alice, isso é genial!"

# game/chapters/chapter5/script/ch5sc12.rpy:1963
translate brazil ch5sc12_1176a8ff:

#   el "It might come in handy if any of the guards catch me in a bad spot."
    el "Isso pode ser útil se algum dos guardas me pegar em uma situação ruim."

# game/chapters/chapter5/script/ch5sc12.rpy:1965
translate brazil ch5sc12_affa1195:

#   lu "Meanwhile, I’ll start preparing the locator spell so we can track Amelia as soon as you get back."
    lu "Enquanto isso, vou começar a preparar o feitiço de localização para que possamos rastrear Amelia assim que você voltar."

# game/chapters/chapter5/script/ch5sc12.rpy:1967
translate brazil ch5sc12_c8382a94:

#   sy "I’ll help! I know some ingredients that could increase the potency of the spell!"
    sy "Eu ajudo! Conheço alguns ingredientes que podem aumentar a potência do feitiço!"

# game/chapters/chapter5/script/ch5sc12.rpy:1968
translate brazil ch5sc12_2f0646df:

#   sy "Even if she’s under a seal, we should be able to track her! Yuup!"
    sy "Mesmo que ela esteja sob sigilo, devemos conseguir rastreá-la! Sim!"

# game/chapters/chapter5/script/ch5sc12.rpy:1970
translate brazil ch5sc12_62fd3539:

#   da "Borri, you’re with me. We’ll prepare our gear."
    da "Borri, você vem comigo. Vamos preparar nosso equipamento."

# game/chapters/chapter5/script/ch5sc12.rpy:1971
translate brazil ch5sc12_79b338b5:

#   da "Whoever is holding Amelia, they won’t give her up without a fight."
    da "Quem estiver com Amelia, não a entregará sem lutar."

# game/chapters/chapter5/script/ch5sc12.rpy:1972
translate brazil ch5sc12_faa44a45:

#   br "Hah! I’ve been itching for a fight! I’ll prepare Bella!"
    br "Hah! Eu estava louca para brigar! Vou preparar a Bella!"

# game/chapters/chapter5/script/ch5sc12.rpy:1974
translate brazil ch5sc12_736b1aed:

#   evr "Bella?"
    evr "Bella?"

# game/chapters/chapter5/script/ch5sc12.rpy:1975
translate brazil ch5sc12_0b4afded:

#   br "Aye! My battlehammer!"
    br "Sim! Meu martelo de batalha!"

# game/chapters/chapter5/script/ch5sc12.rpy:1976
translate brazil ch5sc12_f7e53361:

#   br "She never lets me down! Heh..."
    br "Ela nunca me decepciona! Heh..."

# game/chapters/chapter5/script/ch5sc12.rpy:1978
translate brazil ch5sc12_e423814f:

#   sy "Only Borri would name his weapon... Yuuup!"
    sy "Só Borri para dar um nome à sua arma... Sim!"

# game/chapters/chapter5/script/ch5sc12.rpy:1980
translate brazil ch5sc12_95555d7a:

#   al "Great warriors typically name their weapons, Sylph."
    al "Grandes guerreiros costumam dar o nome de Sylph às suas armas."

# game/chapters/chapter5/script/ch5sc12.rpy:1981
translate brazil ch5sc12_10257e30:

#   al "That’s how famous weapons are passed down through the ages."
    al "É assim que as armas famosas são transmitidas ao longo dos séculos."

# game/chapters/chapter5/script/ch5sc12.rpy:1983
translate brazil ch5sc12_cf209b27:

#   el "My body is my weapon... and it’s called Eliza."
    el "Meu corpo é minha arma... e se chama Eliza."

# game/chapters/chapter5/script/ch5sc12.rpy:1985
translate brazil ch5sc12_066c7cdd:

#   evr "*Chuckles, *Laughs*, *Giggles* ..."
    evr "*Risos, *Risadas*, *Girinhos* ..."

# game/chapters/chapter5/script/ch5sc12.rpy:1987
translate brazil ch5sc12_55a0882c:

#   el "What? Was it something I said?"
    el "O quê? Eu disse alguma coisa errada?"

# game/chapters/chapter5/script/ch5sc12.rpy:1989
translate brazil ch5sc12_fb451c7a:

#   da "Everyone, you know what to do."
    da "Todos vocês sabem o que fazer."

# game/chapters/chapter5/script/ch5sc12.rpy:1990
translate brazil ch5sc12_7b168ca3:

#   da "Let’s bring Amelia home safe and sound, and free [mc] in return."
    da "Vamos trazer Amelia para casa sã e salva, e livre. [mc] em troca."

# game/chapters/chapter5/script/ch5sc12.rpy:1992
translate brazil ch5sc12_efb9c23a:

#   evr "Let’s do this!"
    evr "Vamos nessa!"

# game/chapters/chapter5/script/ch5sc12.rpy:2000
translate brazil ch5sc12_39ccc022:

#   gd "Can you believe that good-for-nothing peasant abducted the princess?"
    gd "Você acredita que aquele camponês imprestável sequestrou a princesa?"

# game/chapters/chapter5/script/ch5sc12.rpy:2001
translate brazil ch5sc12_a5e268f6:

#   gd "I knew he was up to no good. Waltzing around all proud at the banquet. He even danced with her. Tsk!"
    gd "Eu sabia que ele estava aprontando alguma coisa. Desfilando todo orgulhoso no banquete. Ele até dançou com ela. Que feio!"

# game/chapters/chapter5/script/ch5sc12.rpy:2003
translate brazil ch5sc12_4c6920e3:

#   elt "{i}Fuckers... I dare you to talk about him like that to my face.{/i}"
    elt "{i}Filhos da puta... Duvido que vocês tenham coragem de falar dele assim na minha cara.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2004
translate brazil ch5sc12_2cd0f63c:

#   elt "{i}They're so quick to talk trash now, but yesterday everyone was happy and praising him. Eck! Two-faced shits!{/i}"
    elt "{i}Eles são tão rápidos em falar mal agora, mas ontem todos estavam felizes e o elogiando. Credo! Hipócritas!{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2006
translate brazil ch5sc12_ad991683:

#   elt "If I recall, that door leads to the upper corridors."
    elt "Se bem me lembro, aquela porta dá acesso aos corredores superiores."

# game/chapters/chapter5/script/ch5sc12.rpy:2007
translate brazil ch5sc12_4ec23f3b:

#   elt "I’ll have to stay alert, there are probably extra patrols tonight."
    elt "Preciso ficar alerta, provavelmente haverá patrulhas extras esta noite."

# game/chapters/chapter5/script/ch5sc12.rpy:2008
translate brazil ch5sc12_3f5131a7:

#   elt "{i}If it comes to it, I have Alice’s elixir. Assuming it works.{/i}"
    elt "{i}Se for preciso, tenho o elixir da Alice. Supondo que funcione.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2010
translate brazil ch5sc12_acd82403:

#   elt "{i}[mc] is literally their best chance at keeping her safe, but they lock him up instead?! Idiots...{/i}"
    elt "{i}[mc] Essa é literalmente a melhor chance que eles têm de mantê-la segura, mas em vez disso, eles o prendem?! Idiotas...{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2011
translate brazil ch5sc12_5a7adbe5:

#   elt "{i}I can’t wait to see the stupid look on their faces when we bring Amelia back safe and sound.{/i}"
    elt "{i}Mal posso esperar para ver a cara de bobos deles quando trouxermos a Amelia de volta sã e salva.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2013
translate brazil ch5sc12_7e669dd2:

#   elt "Sounds like the coast is clear on the other side."
    elt "Parece que o caminho está livre do outro lado."

# game/chapters/chapter5/script/ch5sc12.rpy:2014
translate brazil ch5sc12_00634f49:

#   elt "From what Dalen told me, the royal bedrooms are located in the upper east wing."
    elt "Pelo que Dalen me contou, os aposentos reais estão localizados na ala leste superior."

# game/chapters/chapter5/script/ch5sc12.rpy:2015
translate brazil ch5sc12_66ce25d0:

#   elt "{i}*Inhales deeply* Here goes...{/i}"
    elt "{i}*Inspira profundamente* Lá vou eu...{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2021
translate brazil ch5sc12_af0e3faf:

#   gd "Hey you! What are you doing here?!"
    gd "Ei, você aí! O que você está fazendo aqui?!"

# game/chapters/chapter5/script/ch5sc12.rpy:2022
translate brazil ch5sc12_bb744a43:

#   elt "{i}Did someone see me?!{/i}"
    elt "{i}Alguém me viu?!{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2024
translate brazil ch5sc12_a3bdcb30:

#   md "Sorry! I was just tidying up the princess’s room."
    md "Desculpe! Eu estava apenas arrumando o quarto da princesa."

# game/chapters/chapter5/script/ch5sc12.rpy:2025
translate brazil ch5sc12_f88576d8:

#   md "The Queen wants it to be neat for her return."
    md "A Rainha quer que tudo esteja impecável para o seu retorno."

# game/chapters/chapter5/script/ch5sc12.rpy:2026
translate brazil ch5sc12_45969975:

#   elt "{i}Phew! He didn’t spot me, it was someone else.{/i}"
    elt "{i}Ufa! Ele não me viu, foi outra pessoa.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2027
translate brazil ch5sc12_0056598c:

#   gd "Alright, but the castle is on lock-down."
    gd "Muito bem, mas o castelo está em confinamento."

# game/chapters/chapter5/script/ch5sc12.rpy:2028
translate brazil ch5sc12_77c1e65d:

#   gd "Best return to the maids quarters now."
    gd "É melhor voltar agora para os aposentos das criadas."

# game/chapters/chapter5/script/ch5sc12.rpy:2030
translate brazil ch5sc12_c4c0f1b6:

#   elt "It sounded like she was coming from the princess’s room?"
    elt "Parecia que ela estava vindo do quarto da princesa?"

# game/chapters/chapter5/script/ch5sc12.rpy:2031
translate brazil ch5sc12_d0376aba:

#   elt "It must be that door at the end of the hall."
    elt "Deve ser aquela porta no final do corredor."

# game/chapters/chapter5/script/ch5sc12.rpy:2033
translate brazil ch5sc12_26d5f105:

#   elt "Looks like he’s the only guard patrolling this hall."
    elt "Parece que ele é o único guarda patrulhando este corredor."

# game/chapters/chapter5/script/ch5sc12.rpy:2034
translate brazil ch5sc12_b7b532ea:

#   elt "I’ll just wait for him to be out of sight-"
    elt "Vou esperar até ele sair de vista."

# game/chapters/chapter5/script/ch5sc12.rpy:2036
translate brazil ch5sc12_a3d3861d:

#   gd "Did you see that big-titted woman who ate all the sweetrolls?"
    gd "Você viu aquela mulher com peitões que comeu todos os pãezinhos doces?"

# game/chapters/chapter5/script/ch5sc12.rpy:2037
translate brazil ch5sc12_7a0218b8:

#   gd "Did I ever! I dreamed about milking those puppies all night!"
    gd "E como! Sonhei a noite toda em ordenhar aqueles filhotes!"

# game/chapters/chapter5/script/ch5sc12.rpy:2039
translate brazil ch5sc12_d46a5d50:

#   elt "{i}OH NO! They’re coming this way!{/i}"
    elt "{i}OH NÃO! Eles estão vindo para cá!{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2040
translate brazil ch5sc12_024264f3:

#   elt "{i}Alice! Her elixir...{/i}"
    elt "{i}Alice! Seu elixir...{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2042
translate brazil ch5sc12_cd1a1350:

#   elt "{i}*Gulp-Gulp* What a funky taste.{/i}"
    elt "{i}*Gulp-Gulp* Que gosto estranho.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2045
translate brazil ch5sc12_c3e18b0d:

#   elt "{i}Heavens!! She really needs to work on the taste!! Eck!{/i}"
    elt "{i}Meu Deus!! Ela precisa mesmo melhorar o paladar!! Eca!{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2047
translate brazil ch5sc12_4f9c6ef9:

#   gd "What did you think about the queen at the banquet? She looked fine as ever."
    gd "O que você achou da rainha no banquete? Ela estava linda como sempre."

# game/chapters/chapter5/script/ch5sc12.rpy:2048
translate brazil ch5sc12_3c7fcd58:

#   gd "Tell me about it! What I’d give to pound her deep into her royal sheets! The king is a lucky man."
    gd "Nem me fale! O que eu não daria para transá-la com força em seus lençóis reais! O rei é um homem de sorte."

# game/chapters/chapter5/script/ch5sc12.rpy:2050
translate brazil ch5sc12_27a76927:

#   gd "I wouldn’t be so sure about that... They haven’t slept in the same room for twenty years."
    gd "Eu não teria tanta certeza disso... Eles não dormem no mesmo quarto há vinte anos."

# game/chapters/chapter5/script/ch5sc12.rpy:2051
translate brazil ch5sc12_5c665c5e:

#   gd "Not once since their wedding night."
    gd "Nem uma vez desde a noite de núpcias."

# game/chapters/chapter5/script/ch5sc12.rpy:2052
translate brazil ch5sc12_6bba860b:

#   gd "That’s ridiculous! Why would he waste such a woman?!"
    gd "Isso é ridículo! Por que ele desperdiçaria uma mulher assim?!"

# game/chapters/chapter5/script/ch5sc12.rpy:2054
translate brazil ch5sc12_7dfb4aff:

#   gd "Beats me."
    gd "Não faço a mínima ideia."

# game/chapters/chapter5/script/ch5sc12.rpy:2055
translate brazil ch5sc12_5f5e9816:

#   gd "Whatever... Let’s get this patrol over with."
    gd "Tanto faz... Vamos terminar logo com essa patrulha."

# game/chapters/chapter5/script/ch5sc12.rpy:2056
translate brazil ch5sc12_21ea79b3:

#   elt "Please work, please work, please work!"
    elt "Por favor, trabalhe, por favor, trabalhe, por favor, trabalhe!"

# game/chapters/chapter5/script/ch5sc12.rpy:2057
translate brazil ch5sc12_649c49d8:

#   elt "She said to remain still... *Holds her breath*"
    elt "Ela disse para ficarmos quietos... *Prende a respiração*"

# game/chapters/chapter5/script/ch5sc12.rpy:2059
translate brazil ch5sc12_834208ef:

#   elt "They just walked straight past me!"
    elt "Eles simplesmente passaram direto por mim!"

# game/chapters/chapter5/script/ch5sc12.rpy:2060
translate brazil ch5sc12_db6d259f:

#   elt "Alice... you’re a bloody genius!"
    elt "Alice... você é uma gênia!"

# game/chapters/chapter5/script/ch5sc12.rpy:2062
translate brazil ch5sc12_a32a5475:

#   elt "{i}That was close... but exciting too! *Giggles*{/i}"
    elt "{i}Essa foi por pouco... mas também emocionante! *Risos*{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2063
translate brazil ch5sc12_74059655:

#   elt "{i}Are there always this many guards around, or is it because they’re on high alert?{/i}"
    elt "{i}Há sempre tantos guardas assim, ou é porque estão em estado de alerta máximo?{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2065
translate brazil ch5sc12_32594789:

#   elt "Better not stick around and push my luck."
    elt "É melhor não ficar por aqui e abusar da sorte."

# game/chapters/chapter5/script/ch5sc12.rpy:2066
translate brazil ch5sc12_e11313d9:

#   elt "Let’s see if I can find a personal item of Amelia's."
    elt "Vamos ver se consigo encontrar algum objeto pessoal da Amelia."

# game/chapters/chapter5/script/ch5sc12.rpy:2071
translate brazil ch5sc12_4b7edc53:

#   elt "Okay! I made it. And just in time by the looks of it."
    elt "Ok! Consegui. E pelo visto, bem a tempo."

# game/chapters/chapter5/script/ch5sc12.rpy:2072
translate brazil ch5sc12_a2c3c81d:

#   elt "The elixir lasted only a couple of minutes."
    elt "O elixir durou apenas alguns minutos."

# game/chapters/chapter5/script/ch5sc12.rpy:2074
translate brazil ch5sc12_3c8989e9:

#   elt "{i}Let’s see... There should be something around here somewhere.{/i}"
    elt "{i}Vamos ver... Deve haver alguma coisa por aqui em algum lugar.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2076
translate brazil ch5sc12_fbb241d0:

#   elt "{i}I can’t believe I was attending her name day celebrations yesterday, and now I’m going through her stuff.{/i}"
    elt "{i}Não acredito que ontem eu estava participando das comemorações do aniversário dela, e agora estou mexendo nas coisas dela.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2077
translate brazil ch5sc12_87deffdc:

#   elt "{i}Hmh. Nothing of interest here...{/i}"
    elt "{i}Hum. Nada de interessante por aqui...{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2079
translate brazil ch5sc12_1973e528:

#   elt "{i}Maybe here? Uh- these pillows are super soft!{/i}"
    elt "{i}Talvez aqui? Hum... esses travesseiros são super macios!{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2080
translate brazil ch5sc12_af450a49:

#   elt "{i}Note to self: acquire pillows like these for our home.{/i}"
    elt "{i}Anotação mental: preciso comprar almofadas como essas para nossa casa.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2082
translate brazil ch5sc12_072e7d2d:

#   elt "{i}Hmpfh! Where is all her stuff? Don’t royals keep anything in their rooms?{/i}"
    elt "{i}Hmpfh! Onde estão todas as coisas dela? Será que os membros da realeza não guardam nada em seus aposentos?{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2083
translate brazil ch5sc12_78eaad4c:

#   elt "{i}Hmmmnhhh...{/i}"
    elt "{i}Hummm...{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2085
translate brazil ch5sc12_016d9ed1:

#   elt "{i}The bed! There has to be something lost amongst all those sheets and pillows!{/i}"
    elt "{i}A cama! Deve haver alguma coisa perdida em meio a todos esses lençóis e travesseiros!{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2087
translate brazil ch5sc12_30948a5b:

#   elt "{i}Let’s see... What are you hiding in this luxurious bed of yours?{/i}"
    elt "{i}Vamos ver... O que você está escondendo nessa sua cama luxuosa?{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2088
translate brazil ch5sc12_2bc32c69:

#   elt "{i}Dirty laundry? Secret love-letters? I'll bet lots of men send her confessions about their profound love for her.{/i}"
    elt "{i}Roupa suja? Cartas de amor secretas? Aposto que muitos homens lhe enviam declarações de amor profundo.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2090
translate brazil ch5sc12_df5962e7:

#   elt "{i}I’d kick 'em all where the sun don’t shine, and send them on their way. I only want [mc]’s confession.{/i}"
    elt "{i}Eu chutaria todos eles onde o sol não bate e os mandaria embora. Eu só quero [mc] a confissão de.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2091
translate brazil ch5sc12_74b0d7e4:

#   elt "{i}I’d let him confess to me day in and day out! *Giggles softly* I’d swoon in his arms and... *Sighs* Not now, Eliza.{/i}"
    elt "{i}Eu deixaria ele se confessar para mim dia após dia! *Risinhos suaves* Eu me derreteria em seus braços e... *Suspiros* Agora não, Eliza.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2092
translate brazil ch5sc12_e6f98cb3:

#   elt "{i}Oh? What’s this?{/i}"
    elt "{i}Oh? O que é isto?{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2094
translate brazil ch5sc12_c511a67c:

#   elt "{i}Bingo! This definitely counts as a personal item! We’ll get [mc] out in no time!{/i}"
    elt "{i}Bingo! Isso definitivamente conta como um item pessoal! Vamos pegar [mc] Saiu rapidinho!{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2096
translate brazil ch5sc12_69f46ace:

#   elt "{i}This is technically stealing... and from the royals no less. She probably won’t mind, though. It’s to rescue her, after all!{/i}"
    elt "{i}Tecnicamente, isso é roubo... e da realeza, nada menos. Mas ela provavelmente não se importará. Afinal, é para resgatá-la!{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2097
translate brazil ch5sc12_d8e1f3c8:

#   elt "{i}But this little ring is probably worth more than everything [mc] and I own, combined.{/i}"
    elt "{i}Mas este pequeno anel provavelmente vale mais do que tudo. [mc] e eu possuo, em conjunto.{/i}"

# game/chapters/chapter5/script/ch5sc12.rpy:2105
translate brazil ch5sc12_d2742ae7:

#   lc "Hah! You’re pulling my leg, kid!"
    lc "Hah! Você está me zoando, garoto!"

# game/chapters/chapter5/script/ch5sc12.rpy:2107
translate brazil ch5sc12_1419a939:

#   mc "I wish I were..."
    mc "Quem me dera ser..."

# game/chapters/chapter5/script/ch5sc12.rpy:2109
translate brazil ch5sc12_8c4e3247:

#   lc "You’re telling me that in your measly twenty years, you’ve already met with not one, but TWO goddesses?"
    lc "Você está me dizendo que em seus míseros vinte anos, você já conheceu não uma, mas DUAS deusas?"

# game/chapters/chapter5/script/ch5sc12.rpy:2111
translate brazil ch5sc12_0ead0010:

#   mc "Correct. Lucid and Maia."
    mc "Correto. Lúcido e Maia."

# game/chapters/chapter5/script/ch5sc12.rpy:2113
translate brazil ch5sc12_dc244da5:

#   lc "And you've traveled to that mysterious island, Inmortui, as well?"
    lc "E você também viajou para aquela ilha misteriosa, Inmortui?"

# game/chapters/chapter5/script/ch5sc12.rpy:2114
translate brazil ch5sc12_da123eef:

#   lc "The one that nobody has been able to reach... or at least, that nobody has ever returned from?"
    lc "Aquela que ninguém conseguiu alcançar... ou pelo menos, de onde ninguém jamais retornou?"

# game/chapters/chapter5/script/ch5sc12.rpy:2116
translate brazil ch5sc12_cf39d098:

#   lc "Yet, you found it, beat a legion of restless undead, and somehow managed to escape in one piece?"
    lc "No entanto, você o encontrou, derrotou uma legião de mortos-vivos inquietos e, de alguma forma, conseguiu escapar ileso?"

# game/chapters/chapter5/script/ch5sc12.rpy:2118
translate brazil ch5sc12_a87a337b:

#   mc "Yep."
    mc "Sim."

# game/chapters/chapter5/script/ch5sc12.rpy:2120
translate brazil ch5sc12_2b77c962:
