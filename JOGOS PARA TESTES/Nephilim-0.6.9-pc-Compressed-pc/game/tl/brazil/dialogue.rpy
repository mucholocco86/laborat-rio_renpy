translate brazil ch6sc2_a58bb96a:

#   pl "Right! I forgot you were charming the villagers before I even got here!"
    pl "É mesmo! Eu tinha me esquecido que você já estava encantando os aldeões antes mesmo de eu chegar aqui!"

# game/chapters/chapter6/ch6sc2.rpy:6836
translate brazil ch6sc2_d86328b5:

#   mc "Charming them? Then how did I end up thrown down some ancient ruins?"
    mc "Encantá-los? Então como foi que eu acabei jogado em ruínas antigas?"

# game/chapters/chapter6/ch6sc2.rpy:6837
translate brazil ch6sc2_cc83fd65:

#   pl "*Giggles* Jealousy! Duuh!"
    pl "*Risos* Ciúme! Duh!"

# game/chapters/chapter6/ch6sc2.rpy:6838
translate brazil ch6sc2_fc1bc59e:

#   pl "It’s bound to happen when there’s a lot of female attention on a single male."
    pl "É algo que inevitavelmente acontece quando há muita atenção feminina voltada para um único homem."

# game/chapters/chapter6/ch6sc2.rpy:6839
translate brazil ch6sc2_5e44a000:

#   mc "Right..."
    mc "Certo..."

# game/chapters/chapter6/ch6sc2.rpy:6841
translate brazil ch6sc2_ff5a1f25:

#   mi "Pearl! Hi. I see you managed to wake up your friend?"
    mi "Pérola! Oi. Vejo que você conseguiu acordar sua amiga?"

# game/chapters/chapter6/ch6sc2.rpy:6842
translate brazil ch6sc2_75035628:

#   pl "You bet! Nobody can withstand an assault of my pokeys!"
    pl "Pode apostar! Ninguém resiste a um ataque dos meus podres!"

# game/chapters/chapter6/ch6sc2.rpy:6844
translate brazil ch6sc2_a15d334c:

#   mc "Hey..."
    mc "Ei..."

# game/chapters/chapter6/ch6sc2.rpy:6845
translate brazil ch6sc2_cdc04293:

#   mc "It’s nice to meet you. Miyo, is it?"
    mc "Prazer em conhecê-la. Miyo, não é?"

