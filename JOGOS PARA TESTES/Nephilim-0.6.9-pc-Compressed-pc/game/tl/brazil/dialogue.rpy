# game/chapters/chapter2/script/ch2sc19_nz.rpy:219
translate brazil ch2sc19_nz_fa621b45:

#   "{color=#f00}Dark morality{/color} has increased by {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."
    "{color=#f00}Moralidade sombria{/color} aumentou em {size=+3}{b}{color=#2bff8b}5{/color}{/b}{/size}."

# game/chapters/chapter2/script/ch2sc19_nz.rpy:221
translate brazil ch2sc19_nz_2d7d4979:

#   mct "Pathetic... just like his brother."
