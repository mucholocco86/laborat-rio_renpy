translate brazil ch7sc9_dd4731dd:

#   ro "It takes more than a handsome face and a little magical talent to earn my love."
    ro "Não basta um rosto bonito e um pouco de talento mágico para conquistar meu amor."

# game/chapters/chapter7/ch7sc9.rpy:2298
translate brazil ch7sc9_dbfd8107:

#   mc "Good, I like to earn my woman’s love and respect."
    mc "Ótimo, gosto de conquistar o amor e o respeito da minha mulher."

# game/chapters/chapter7/ch7sc9.rpy:2299
translate brazil ch7sc9_82f4d3e0:

#   ro "*Giggles softly* Mmh…"
    ro "*Risinhos suaves* Hum…"

