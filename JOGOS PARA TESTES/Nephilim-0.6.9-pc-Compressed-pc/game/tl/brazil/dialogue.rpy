translate brazil ch6sc9_e8b7cea7:

#   el "Sorry, but we’re closed for the day! You’ll have to come back tomorrow."
    el "Desculpe, mas estamos fechados por hoje! Você terá que voltar amanhã."

# game/chapters/chapter6/ch6sc9.rpy:3661
translate brazil ch6sc9_24c2809a:

#   br "Lass, look!"
    br "Menina, olha!"

# game/chapters/chapter6/ch6sc9.rpy:3663
translate brazil ch6sc9_c679f09a:

#   el "Borri, you’re always such a drama quee-"
    el "Borri, você sempre faz tanto drama!"

# game/chapters/chapter6/ch6sc9.rpy:3666
translate brazil ch6sc9_b1daa82b:

#   el "*Gasps* {size=+3}{b}Huh?!?!{/b}{/size}"
    el "*Suspiros* {size=+3}{b}Huh?!?!{/b}{/size}"

