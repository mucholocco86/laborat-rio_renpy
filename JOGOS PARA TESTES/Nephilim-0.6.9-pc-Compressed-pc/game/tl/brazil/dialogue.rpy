translate brazil ch4sc17_3c9ac34c:

#   el "Maybe when he comes home, we can come visit you out here?"
    el "Talvez quando ele voltar para casa, possamos vir te visitar aqui?"

# game/chapters/chapter4/script/ch4sc17.rpy:138
translate brazil ch4sc17_86a21555:

