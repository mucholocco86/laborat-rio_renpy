#   lu "Mom, can we go all out now? Pleeeeaaase?"
    lu "Mãe, podemos nos soltar agora? Por favoooor?"

# game/chapters/chapter7/ch7sc9.rpy:1028
translate brazil ch7sc9_53d841ad:

#   cas "I don’t know honey… someone could get hurt."
    cas "Não sei, querida... alguém pode se machucar."

# game/chapters/chapter7/ch7sc9.rpy:1030
translate brazil ch7sc9_b43d92f1:

#   mc "Don’t worry Cassandra, as you know, I can heal us if anything goes wrong."
    mc "Não se preocupe, Cassandra, como você sabe, eu posso nos curar se algo der errado."

# game/chapters/chapter7/ch7sc9.rpy:1032
translate brazil ch7sc9_80a13c08:

#   cas "*Sighs* Alright then… fine… go all out if you so desire."
    cas "*Suspiro* Muito bem então... tudo bem... vá em frente se quiser."

