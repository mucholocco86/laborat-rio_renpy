label lb_ep03_02_05_The_MC_goes_over_to_Zoras_place:
    $ renpy.music.set_volume(0.4, 0.0, channel="ambient")
    $ renpy.music.set_volume(0.4, 0.0, channel="ambient2")
    play ambient "sound effects/01/town_street_night_ambience.ogg" loop fadein 1.0
    play ambient2 "sound effects/01/town_traffic_ambience.ogg" loop fadein 1.0
    centered "Later that evening...{w=2.0}{nw}" with dissolve
    show text "Later that evening..."
    scene bg black with Dissolve(1)
    pause 1.0
    scene sc ep3 zorasplace z001
    with dissolve
    pause 1.0
    #Show the MC walking through the expensive, up-market side of town
    #Examples - https://media.istockphoto.com/id/1388026461/photo/apartment-buildings-in-a-residential-area.jpg?s=612x612&w=0&k=20&c=GCy56iiHP2PtU_NWXQ02lHAMCzAZehH15k_akMS17gs=
    #https://www.sandiegouniontribune.com/wp-content/uploads/migration/2022/02/22/0000017e-d539-d7e8-a97f-d57b109f0002.jpg?w=535
    show sc ep3 zorasplace z002
    with dissolve
    pause 1.0
    #the MC arrives outside the apartment building
    #he enters and is at the reception desk - https://www.daz3d.com/holiday-hotel-lobby
    stop ambient fadeout 1.0
    stop ambient2 fadeout 1.0
    scene bg black with Dissolve(1)
    $ renpy.music.set_volume(1.0, 1.0, channel="ambient")
    $ renpy.music.set_volume(1.0, 1.0, channel="ambient2")
    pause 1.0
    $ renpy.music.set_volume(0.6, 0.0, channel="music")
    play music "sound effects/03/hotel_lobby1.mp3" loop fadein 1.0
    play ambient "sound effects/03/water_fountain_Sound_Effect.mp3" loop fadein 1.0
    show sc ep3 zorasplace z003
    with dissolve
    mc"Woah..."
    #The MC looks around and realises how amazing the apartment reception is
    show sc ep3 zorasplace z004
    mc"This place is fancy."
    #the mild-mannered receptionist says this to the MC. He’s suspicious of him
    $ renpy.music.set_volume(0.6, 1.0, channel="ambient")
    show sc ep3 zorasplace z005
    con"May I help you, Sir?"
    show sc ep3 zorasplace z006
    mc"Oh, hey."
    mc"I was just on my way up to see a friend of mine."
    show sc ep3 zorasplace z007
    mc"Her name’s Zora, and she lives in the penthouse suite on the top floor."
    show sc ep3 zorasplace z008
    con"All guests need to be announced, Mister..."
    show sc ep3 zorasplace z009
    mc"[lastname]."
    show sc ep3 zorasplace z010
    con"Give me a moment, Mister [lastname] while I make a call."
    #the MC looks around while the concierge calls Zora’s apartment.
    show sc ep3 zorasplace z012
    pause 2.0
    show sc ep3 zorasplace z011
    with dissolve
    con"Yes, Miss Zora. There’s a young man who says he’s here to see you."
    show sc ep3 zorasplace z012
    con"Okay, I’ll send him right up."
    con"Very good."
    #The call ends
    show sc ep3 zorasplace z010
    con"You can see Miss Zora now. The elevator is to your left."
    show sc ep3 zorasplace z013
    mc"Thanks, buddy."
    #show the MC walking towards the elevator as the concierge keeps his eye on him
    play sound "sound effects/01/Elevator_Ding_Door_Open.ogg" noloop
    show sc ep3 zorasplace z014
    with dissolve
    pause 1.0
    show sc ep3 zorasplace z015
    with dissolve
    pause 0.4
    show sc ep3 zorasplace z016
    with dissolve
    pause 1.0
    #show the MC inside the elevator
    stop ambient fadeout 1.0
    play sound2 "sound effects/01/Elevator_Door_Close.ogg" noloop
    show sc ep3 zorasplace z017
    with dissolve
    pause 1.0
    scene black
    with dissolve
    pause 1.0
    stop sound fadeout 1.0
    stop sound2 fadeout 1.0
    $ renpy.music.set_volume(1.0, 0.0, channel="ambient")
    #show him clicking the button for the 20th-floor
    #https://www.daz3d.com/holiday-hotel-scenes-bundle
    #show him in the elevator
    #pause for five seconds
    #screen fades out

    #Show the MC getting out and walking to her door
    play sound "sound effects/01/Elevator_Ding_Door_Open.ogg" noloop
    show sc ep3 zorasplace z018
    with dissolve
    show sc ep3 zorasplace z019
    with dissolve
    pause 0.4
    play sound2 "sound effects/01/Elevator_Door_Close.ogg" noloop
    show sc ep3 zorasplace z020
    with dissolve
    pause 0.4
    stop sound fadeout 1.0
    stop sound2 fadeout 1.0
    #show the MC in front of her apartment door
    show sc ep3 zorasplace z021
    with dissolve
    pause 1.0
    show sc ep3 zorasplace z022
    with dissolve
    pause 1.0
    play sound "sound effects/01/Door_Knock_Sound_Effect_Free.mp3"
    show sc ep3 zorasplace z023
    with dissolve
    if persistent.v_sounds_text_on == True:
        "(Knock, knock, knock)"
    else:
        pause 2.0
        stop sound fadeout 1.0
    show sc ep3 zorasplace z022
    with faster_dissolve
    pause 1.0
    #it takes some time before she answers
    show sc ep3 zorasplace z024
    with dissolve
    pause 1.0
    stop music fadeout 1.0
    play sound "sound effects/01/door_open_light.mp3" noloop
    show sc ep3 zorasplace z025
    with dissolve
    pause 1.0
    play music "sound effects/02/Late Night Whispers.mp3" loop fadein 1.0
    show sc ep3 zorasplace z026
    with faster_dissolve
    zora"H-hi..."
    #she’s happy but visibly nervous
    show sc ep3 zorasplace z027
    mc"Hey Zora."
    #Hug her / Greet her]
    menu:
        "Hug her"(wt="Bonus Image"):
            show sc ep3 zorasplace z028
            with dissolve
            mc"(...)"
            #The MC hugs Zora
            zora"Mmm..."
            show sc ep3 zorasplace z029
            zora"It’s great to see you."
            $ rewards_unlock ("zora",8)
