translate brazil lb_ep03_04_02_The_Art_Gallery_Heist_Part_1_cca46efb:

#   v "{i}(*Whispering*){/i}\nDon’t wait for me, I’ll be right behind you..."
    v "{i}(*Sussurrando*){/i}Não me espere, já chego logo atrás..."

