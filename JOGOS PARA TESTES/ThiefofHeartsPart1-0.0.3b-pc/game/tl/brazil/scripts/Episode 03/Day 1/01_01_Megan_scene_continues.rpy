# game/scripts/Episode 03/Day 1/01_01_Megan_scene_continues.rpy:175
translate brazil lb_ep03_01_01_Megan_scene_continues_e2b3776c:

#   megan "All I ask for in return is that you also make yourself reachable whenever I call."
