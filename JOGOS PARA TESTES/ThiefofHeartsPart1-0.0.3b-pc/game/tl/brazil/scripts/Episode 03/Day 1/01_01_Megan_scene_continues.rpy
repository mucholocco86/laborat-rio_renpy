# game/scripts/Episode 03/Day 1/01_01_Megan_scene_continues.rpy:171
translate brazil lb_ep03_01_01_Megan_scene_continues_35d8554a:

#   megan "If you help me, [y_name], I could be a real asset to you."
    megan "Se você me ajudar, [y_name] Eu poderia ser uma verdadeira mais-valia para você."

# game/scripts/Episode 03/Day 1/01_01_Megan_scene_continues.rpy:173
