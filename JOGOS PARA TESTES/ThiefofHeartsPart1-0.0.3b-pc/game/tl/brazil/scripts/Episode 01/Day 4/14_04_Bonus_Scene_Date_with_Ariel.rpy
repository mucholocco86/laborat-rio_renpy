#   mc "Don't you like the place I chose?"
    mc "Você não gostou do lugar que eu escolhi?"

# game/scripts/Episode 01/Day 4/14_04_Bonus_Scene_Date_with_Ariel.rpy:77
translate brazil lb_ep01_Bonus_Scene_Date_with_Ariel1_f831077d:

#   a "It's not that, I just, I've never been here before is all."
    a "Não é isso, é só que eu nunca estive aqui antes."

# game/scripts/Episode 01/Day 4/14_04_Bonus_Scene_Date_with_Ariel.rpy:79
translate brazil lb_ep01_Bonus_Scene_Date_with_Ariel1_d99c3f74:

