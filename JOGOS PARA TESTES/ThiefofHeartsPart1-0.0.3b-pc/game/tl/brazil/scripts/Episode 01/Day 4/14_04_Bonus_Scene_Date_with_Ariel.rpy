    mc "Abriu apenas na semana passada."

# game/scripts/Episode 01/Day 4/14_04_Bonus_Scene_Date_with_Ariel.rpy:82
translate brazil lb_ep01_Bonus_Scene_Date_with_Ariel1_9c377c70:

#   mc "I've never been here before either, but I thought we could try it out. I've heard great things about it."
    mc "Eu também nunca estive aqui antes, mas pensei que poderíamos experimentar. Ouvi falar muito bem do lugar."

# game/scripts/Episode 01/Day 4/14_04_Bonus_Scene_Date_with_Ariel.rpy:84
