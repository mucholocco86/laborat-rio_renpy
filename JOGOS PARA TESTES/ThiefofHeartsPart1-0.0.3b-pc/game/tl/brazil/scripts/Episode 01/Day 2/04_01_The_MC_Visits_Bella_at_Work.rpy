#   b "Hmm... Okay, I’ll tell you."
    b "Hum... Ok, vou te contar."

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:376
translate brazil lb_ep01_04_01_Bella_Work_1_fe2f0068:

#   b "Well, if you must know, [vic_name] has asked me to do a few things which I think are related to this big job he is planning."
    b "Bem, se você precisa saber, [vic_name] Ele me pediu para fazer algumas coisas que eu acho que estão relacionadas a um grande projeto que ele está planejando."

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:378
translate brazil lb_ep01_04_01_Bella_Work_1_065439bd:

#   mc "Has he given you any details about the job?"
    mc "Ele te deu algum detalhe sobre o trabalho?"

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:380
translate brazil lb_ep01_04_01_Bella_Work_1_eb34fb6d:

#   b "No, none at all."
    b "Não, absolutamente nenhuma."

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:381
translate brazil lb_ep01_04_01_Bella_Work_1_6ad1d9cd:

#   b "The only thing he wants me to do is to create a forgery of a painting from some German artist."
    b "A única coisa que ele quer que eu faça é criar uma falsificação de uma pintura de algum artista alemão."

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:383
translate brazil lb_ep01_04_01_Bella_Work_1_242125b8:

#   mc "What painting?"
    mc "Que pintura?"

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:385
translate brazil lb_ep01_04_01_Bella_Work_1_24e208d8:

#   b "See for yourself."
    b "Veja você mesmo."

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:389
