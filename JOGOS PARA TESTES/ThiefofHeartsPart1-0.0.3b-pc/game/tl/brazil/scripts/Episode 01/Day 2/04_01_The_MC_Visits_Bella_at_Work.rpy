#   mc "Are you sure about that? You seem pretty invested in it, whatever it was."
    mc "Tem certeza disso? Você parece bastante envolvido nisso, seja lá o que for."

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:370
translate brazil lb_ep01_04_01_Bella_Work_1_85ebd9b2:

#   b "You’re not going to let this rest until I tell you, are you?"
    b "Você não vai deixar isso para lá até que eu lhe diga, vai?"

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:372
translate brazil lb_ep01_04_01_Bella_Work_1_04d4e8b1:

#   mc "No chance."
    mc "Nem pensar."

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:374
