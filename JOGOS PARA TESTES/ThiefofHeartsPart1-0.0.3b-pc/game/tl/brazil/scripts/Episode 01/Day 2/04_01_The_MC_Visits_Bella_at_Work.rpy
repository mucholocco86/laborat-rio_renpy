#   b "Anyway, get going, [y_name]. There’s no reason for you to be here any longer."
    b "Enfim, vamos lá, [y_name] Não há mais motivo para você ficar aqui."

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:456
translate brazil lb_ep01_04_01_Bella_Work_1_128f5052:

#   mc "(And there’s the bitchy [mc_b_address] that I know.)"
    mc "(E aí está a maldosa) [mc_b_address] que eu sei.)"

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:457
translate brazil lb_ep01_04_01_Bella_Work_1_4ed8b0bb:

#   mc "Fine, I’m going."
    mc "Ótimo, eu vou."

# game/scripts/Episode 01/Day 2/04_01_The_MC_Visits_Bella_at_Work.rpy:462
