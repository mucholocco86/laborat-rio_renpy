# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:7
translate brazil lb_ep01_group_meeting_home_d6ba339d:

#   vic "What do you mean you lost it?? How the fuck did you lose it??"
    vic "Como assim você perdeu?? Como diabos você perdeu isso??"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:10
translate brazil lb_ep01_group_meeting_home_c71b3da9:

#   mc "I honestly have no idea... I put it inside my pocket and then the next thing I knew, it was gone."
    mc "Sinceramente, não faço ideia... Coloquei no bolso e, de repente, tinha sumido."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:12
translate brazil lb_ep01_group_meeting_home_80a22bcc:

#   a "Maybe someone stole it from you?"
    a "Talvez alguém tenha roubado de você?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:14
translate brazil lb_ep01_group_meeting_home_8aaf1e9d:

#   v "But who would do that?"
    v "Mas quem faria isso?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:16
translate brazil lb_ep01_group_meeting_home_c2ea84bb:

#   mc "Oh shit!"
    mc "Ah Merda!"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:28
translate brazil lb_ep01_group_meeting_home_011b348c:

#   mc "UHH!"
    mc "UHH!"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:31
translate brazil lb_ep01_group_meeting_home_35ad3a6a:

#   pretty_g "Oh my God, are you okay?"
    pretty_g "Meu Deus, você está bem?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:33
translate brazil lb_ep01_group_meeting_home_162bb8a1:

#   mc "Yeah, I'm fine. Sorry, I didn't see you there."
    mc "Sim, estou bem. Desculpe, não te vi aí."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:36
translate brazil lb_ep01_group_meeting_home_2037a094:

#   pretty_g "It's okay, mistakes happen."
    pretty_g "Não tem problema, erros acontecem."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:40
translate brazil lb_ep01_group_meeting_home_c312e35f:

#   mc "I think I know who took it."
    mc "Acho que sei quem pegou."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:42
translate brazil lb_ep01_group_meeting_home_676c334f:

#   mc "The girl at the party."
    mc "A garota na festa."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:43
translate brazil lb_ep01_group_meeting_home_27936f1f:

#   mc "The one I ran into after the alarm went off."
    mc "Aquele em que me deparei depois que o alarme disparou."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:54
translate brazil lb_ep01_group_meeting_home_0de1fca1:

#   pretty_g "Thank you for the dance."
    pretty_g "Obrigado pela dança."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:55
translate brazil lb_ep01_group_meeting_home_b17779ee:

#   pretty_g "Maybe we'll bump into each other again soon."
    pretty_g "Talvez nos encontremos novamente em breve."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:56
translate brazil lb_ep01_group_meeting_home_4ed06c99:

#   pretty_g "Bye."
    pretty_g "Tchau."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:63
translate brazil lb_ep01_group_meeting_home_91a9878c:

#   mc "The girl at the party. The one I was dancing with."
    mc "A garota da festa. Aquela com quem eu estava dançando."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:67
translate brazil lb_ep01_group_meeting_home_90dc339e:

#   mc "She must have swiped it without me knowing."
    mc "Ela deve ter furtado sem que eu soubesse."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:69
translate brazil lb_ep01_group_meeting_home_be99956d:

#   b "Typical..."
    b "Típico..."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:71
translate brazil lb_ep01_group_meeting_home_7a72948c:

#   b "This is why you should have let me take the lead on that job."
    b "Por isso você deveria ter me deixado liderar aquele trabalho."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:74
translate brazil lb_ep01_group_meeting_home_96d24f34:

#   vic "Quiet [b_name]. I'm trying to think."
    vic "Quieto [b_name] Estou tentando pensar."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:77
translate brazil lb_ep01_group_meeting_home_1910fe74:

#   v "How could she have known that [y_name] even had the flash drive?"
    v "Como ela poderia saber disso? [y_name] Você sequer tinha o pen drive?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:79
translate brazil lb_ep01_group_meeting_home_fbb7b5a2:

#   vic "My guess is that she's also a thief. And she knew what we were doing right from the start."
    vic "Acho que ela também é ladra. E sabia o que estávamos fazendo desde o início."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:80
translate brazil lb_ep01_group_meeting_home_77159f41:

#   vic "She must've tracked [y_name] as soon as he entered the house and then waited for the right time to make her move."
    vic "Ela deve ter rastreado [y_name] Assim que ele entrou na casa, ela esperou o momento certo para agir."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:82
translate brazil lb_ep01_group_meeting_home_94131b4c:

#   vic "Which suggests that she is very well versed at this."
    vic "O que sugere que ela é muito bem versada nisso."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:85
translate brazil lb_ep01_group_meeting_home_e01b585f:

#   vic "Hmm..."
    vic "Hum..."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:87
translate brazil lb_ep01_group_meeting_home_20659776:

#   vic "There's every chance that she was also in disguise, which further complicates things."
    vic "Há grandes chances de que ela também estivesse disfarçada, o que complica ainda mais as coisas."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:89
translate brazil lb_ep01_group_meeting_home_a68d762d:

#   v "Do you think she was working alone?"
    v "Você acha que ela estava trabalhando sozinha?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:91
translate brazil lb_ep01_group_meeting_home_7e8258b2:

#   vic "I can't say for certain, yet."
    vic "Ainda não posso afirmar com certeza."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:92
translate brazil lb_ep01_group_meeting_home_e29ecdb8:

#   vic "I'll need to check my sources to see if there's another gang in town who may have been planning to hit that house as well."
    vic "Preciso verificar minhas fontes para ver se há outra gangue na cidade que também possa ter planejado atacar aquela casa."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:94
translate brazil lb_ep01_group_meeting_home_82095224:

#   vic "But it's best not to assume anything."
    vic "Mas é melhor não presumir nada."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:95
translate brazil lb_ep01_group_meeting_home_2f5e658d:

#   vic "The smartest thing that you can all do is to keep a low profile for now."
    vic "A coisa mais inteligente que todos vocês podem fazer é manter um perfil discreto por enquanto."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:97
translate brazil lb_ep01_group_meeting_home_f56815b0:

#   vic "Stick to doing your day jobs until we find more information on this girl."
    vic "Continuem com seus trabalhos diários até que tenhamos mais informações sobre essa garota."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:100
translate brazil lb_ep01_group_meeting_home_6c147a13:

#   vic "As for you, [y_name]."
    vic "Quanto a você, [y_name]."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:101
translate brazil lb_ep01_group_meeting_home_4f8a6534:

#   vic "What you did today was inexcusable."
    vic "O que você fez hoje foi imperdoável."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:103
translate brazil lb_ep01_group_meeting_home_afeb7d4e:

#   vic "Not only did you disobey some of my orders and forget to lock the office door, but you lost the only thing you needed to protect."
    vic "Você não só desobedeceu a algumas das minhas ordens e se esqueceu de trancar a porta do escritório, como também perdeu a única coisa que precisava proteger."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:105
translate brazil lb_ep01_group_meeting_home_5503e98e:

#   vic "This job could be as good as dead."
    vic "Este emprego pode estar praticamente acabado."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:107
translate brazil lb_ep01_group_meeting_home_8b5e620a:

#   mc "Wait!"
    mc "Espere!"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:108
translate brazil lb_ep01_group_meeting_home_72ca13a8:

#   mc "I remember something. About the girl at the party..."
    mc "Lembro-me de algo. Daquela garota na festa..."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:115
translate brazil lb_ep01_group_meeting_home_c6973002:

#   mc "She had a tattoo on her back. It was very distinct, very unique."
    mc "Ela tinha uma tatuagem nas costas. Era muito distinta, muito singular."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:118
translate brazil lb_ep01_group_meeting_home_95a413d4:

#   v "Do you think you could describe what it looks like?"
    v "Você acha que conseguiria descrever como é?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:120
translate brazil lb_ep01_group_meeting_home_58dfbc9c:

#   mc "Yes, certainly!"
    mc "Sim, com certeza!"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:122
translate brazil lb_ep01_group_meeting_home_9b62a673:

#   v "Well, if [y_name] can remember the details, then [b_name] might be able to draw and also recognise it."
    v "Bem, se [y_name] consegue se lembrar dos detalhes, então [b_name] talvez consiga desenhá-lo e também reconhecê-lo."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:123
translate brazil lb_ep01_group_meeting_home_67d1dc8e:

#   v "It is kind of your speciality, right?"
    v "É meio que a sua especialidade, não é?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:126
translate brazil lb_ep01_group_meeting_home_52d382ec:

#   b "Yeah, I guess."
    b "Sim, acho que sim."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:129
translate brazil lb_ep01_group_meeting_home_a86a908e:

#   mc "Just give me some time to retrieve the drive."
    mc "Só me dê um tempinho para recuperar o pen drive."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:132
translate brazil lb_ep01_group_meeting_home_c60f3461:

#   mc "I know I can get it back and fix this mess I made."
    mc "Sei que posso recuperar e consertar essa bagunça que fiz."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:134
translate brazil lb_ep01_group_meeting_home_6653f470:

#   vic "[a_name], how long do you estimate that this girl will have the flash drive in her possession?"
    vic "[a_name] Por quanto tempo você estima que essa garota ficará com o pen drive?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:136
translate brazil lb_ep01_group_meeting_home_d98fa55c:

#   a "Well, presuming that she's working alone, and going by the size of the files and information stored on there..."
    a "Bem, presumindo que ela esteja trabalhando sozinha, e levando em conta o tamanho dos arquivos e das informações armazenadas lá..."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:137
translate brazil lb_ep01_group_meeting_home_ff628704:

#   a "I'd say anywhere between forty-eight to seventy-two hours."
    a "Eu diria que entre quarenta e oito e setenta e duas horas."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:139
translate brazil lb_ep01_group_meeting_home_cf3267d2:

#   mc "What happens after that time is up?"
    mc "O que acontece depois que esse tempo acaba?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:141
translate brazil lb_ep01_group_meeting_home_e20622a9:

#   a "She'll either be able to crack the encrypted code that I personally stored onto that drive, or, she'll sell it to someone else."
    a "Ou ela conseguirá decifrar o código criptografado que eu pessoalmente armazenei naquele disco, ou o venderá para outra pessoa."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:142
translate brazil lb_ep01_group_meeting_home_aadcd934:

#   a "Most likely on the black market."
    a "Muito provavelmente no mercado negro."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:144
translate brazil lb_ep01_group_meeting_home_63aed19b:

#   a "If this girl is smart, then she stole it with the intention to make money as soon as possible."
    a "Se essa garota for esperta, então ela roubou com a intenção de ganhar dinheiro o mais rápido possível."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:146
translate brazil lb_ep01_group_meeting_home_4d0f4561:

#   b "So in other words, we're completely fucked then?"
    b "Em outras palavras, estamos completamente ferrados?"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:149
translate brazil lb_ep01_group_meeting_home_71796698:

#   vic "You know, I should be kicking you out of the [private_group] right now."
    vic "Sabe, eu devia te expulsar daqui. [private_group] agora mesmo."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:150
translate brazil lb_ep01_group_meeting_home_10bf3431:

#   vic "Or at the very least, standing you down from leading any future heists or scams."
    vic "Ou, no mínimo, te impedir de liderar quaisquer roubos ou golpes futuros."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:152
translate brazil lb_ep01_group_meeting_home_2c5a9317:

#   vic "Especially for this next big job that I have in mind."
    vic "Principalmente para este próximo grande trabalho que tenho em mente."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:154
translate brazil lb_ep01_group_meeting_home_c218109e:

#   v "[vic_name], please..."
    v "[vic_name], por favor..."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:158
translate brazil lb_ep01_group_meeting_home_8988c577:

#   vic "(The boy knows too much.)"
    vic "(O menino sabe demais.)"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:160
translate brazil lb_ep01_group_meeting_home_a7c2a484:

#   vic "(If I get rid of him entirely, then he could drop us all in it if he wanted to.)"
    vic "(Se eu me livrar dele completamente, ele poderá nos jogar a todos lá dentro se quiser.)"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:161
translate brazil lb_ep01_group_meeting_home_f1537519:

#   vic "(Then again, I could always pin one of our previous robberies on him without [y_name] even knowing.)"
    vic "(Por outro lado, eu sempre poderia atribuir a ele um de nossos roubos anteriores sem [y_name] mesmo sabendo.)"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:163
translate brazil lb_ep01_group_meeting_home_00b22663:

#   vic "Okay, I've come to a decision..."
    vic "Ok, cheguei a uma decisão..."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:165
translate brazil lb_ep01_group_meeting_home_022aa755:

#   vic "I'm going to give you seventy-two hours to get that flash drive back."
    vic "Vou te dar setenta e duas horas para recuperar esse pen drive."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:168
translate brazil lb_ep01_group_meeting_home_c7256ed9:

#   vic "[b_name], once [y_name] draws the image of the tattoo he saw on that girl, I want the two of you to check out all the local tattoo parlours."
    vic "[b_name], uma vez [y_name] Desenha a imagem da tatuagem que viu naquela garota. Quero que vocês dois visitem todos os estúdios de tatuagem da região."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:170
translate brazil lb_ep01_group_meeting_home_c00ab8e7:

#   b "We won't be able to do that tonight. There are only three parlours in town and they'd all be closed by now."
    b "Não poderemos fazer isso esta noite. Só existem três salões de beleza na cidade e todos já devem estar fechados."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:172
translate brazil lb_ep01_group_meeting_home_db00e2d3:

#   b "We'll have to go tomorrow after they open. But I have to work in the morning."
    b "Teremos que ir amanhã, depois que abrirem. Mas eu preciso trabalhar de manhã."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:175
translate brazil lb_ep01_group_meeting_home_37ebca5f:

#   vic "Fine. You two can meet up after you finish and before [y_name] starts his shift at the gym."
    vic "Ótimo. Vocês dois podem se encontrar depois que terminarem e antes [y_name] Ele começa seu turno na academia."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:177
translate brazil lb_ep01_group_meeting_home_417b0f6e:

#   a "I'll monitor all the sites that I can think of, just in case that flash drive pops up for sale."
    a "Vou monitorar todos os sites que eu conseguir imaginar, só por precaução, caso esse pen drive apareça à venda."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:179
translate brazil lb_ep01_group_meeting_home_feb7caee:

#   v "And I'll talk with Mrs. Walker to see if I can get a copy of the guest list from today's party."
    v "E vou falar com a Sra. Walker para ver se consigo uma cópia da lista de convidados da festa de hoje."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:181
translate brazil lb_ep01_group_meeting_home_e6d9264c:

#   v "This girl could be on it, or perhaps she was using an alias that we might recognise."
    v "Essa garota pode estar envolvida, ou talvez esteja usando um pseudônimo que possamos reconhecer."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:183
translate brazil lb_ep01_group_meeting_home_4ed86c57:

#   vic "Very good."
    vic "Muito bom."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:185
translate brazil lb_ep01_group_meeting_home_d82e738c:

#   b "Uhhh! This is a complete waste of time."
    b "Uhhh! Isso é uma completa perda de tempo."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:187
translate brazil lb_ep01_group_meeting_home_633d8d9d:

#   vic "I'll be the judge of that. So enough with the pouting and do what you're told, [b_name]."
    vic "Eu que vou julgar isso. Então chega de birra e faça o que eu mando. [b_name]."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:189
translate brazil lb_ep01_group_meeting_home_793d3632:

#   b "Hmphh!"
    b "Hmphh!"

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:191
translate brazil lb_ep01_group_meeting_home_965fa882:

#   vic "Now that you have a new task, I suggest that you all get a good night's rest and wake up fresh tomorrow morning."
    vic "Agora que vocês têm uma nova tarefa, sugiro que todos descansem bem esta noite e acordem revigorados amanhã de manhã."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:194
translate brazil lb_ep01_group_meeting_home_b5c4d210:

#   v "Of course."
    v "Claro."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:196
translate brazil lb_ep01_group_meeting_home_d9c6d59a:

#   vic "Girls, I need a moment with [y_name], alone."
    vic "Meninas, preciso de um momento com vocês. [y_name], sozinho."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:198
translate brazil lb_ep01_group_meeting_home_8a0d60f6:

#   v "Go easy on him, [vic_name]."
    v "Pegue leve com ele, [vic_name]."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:199
translate brazil lb_ep01_group_meeting_home_ba1e3b92:

#   v "We all make mistakes. Even you."
    v "Todos nós cometemos erros. Até você."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:203
translate brazil lb_ep01_group_meeting_home_8e2f13a0:

#   v "Come on..."
    v "Vamos..."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:206
translate brazil lb_ep01_group_meeting_home_16f183ff:

#   v "Let's leave them be, girls."
    v "Vamos deixá-las em paz, meninas."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:211
translate brazil lb_ep01_group_meeting_home_f9c090fe:

#   vic "I'll cut to the chase."
    vic "Vou direto ao ponto."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:213
translate brazil lb_ep01_group_meeting_home_b0056125:

#   vic "This is your final chance. Don't make me regret this."
    vic "Esta é sua última chance. Não me faça me arrepender."

# game/scripts/Episode 01/Day 1/02_01_Group_House_Meeting.rpy:215
