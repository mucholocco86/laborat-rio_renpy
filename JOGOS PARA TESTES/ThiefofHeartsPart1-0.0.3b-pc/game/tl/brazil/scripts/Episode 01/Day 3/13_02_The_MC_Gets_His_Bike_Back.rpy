translate brazil lb_ep01_The_MC_gets_his_bike_back_899736ef:

#   megan "In exchange, I want something from you in return."
    megan "Em troca, quero algo de você."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:458
translate brazil lb_ep01_The_MC_gets_his_bike_back_7cd20ce4:

#   mc "Um... Okay. What exactly do you want?"
    mc "Hum... Ok. O que exatamente você quer?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:460
translate brazil lb_ep01_The_MC_gets_his_bike_back_25b6a5f0:

#   megan "All in good time."
    megan "Tudo a seu tempo."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:462
translate brazil lb_ep01_The_MC_gets_his_bike_back_073013f4:

#   megan "I'll call you tomorrow morning."
    megan "Eu te ligo amanhã de manhã."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:463
translate brazil lb_ep01_The_MC_gets_his_bike_back_eebc4a84:

#   megan "Make sure to answer, and to keep the afternoon free."
    megan "Não se esqueça de responder e de manter a tarde livre."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:465
translate brazil lb_ep01_The_MC_gets_his_bike_back_a4e07c09:

#   megan "Can I trust you to do that?"
    megan "Posso confiar em você para fazer isso?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:467
translate brazil lb_ep01_The_MC_gets_his_bike_back_efef6c7b:

#   mc "Yes, you can."
    mc "Sim, você pode."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:469
translate brazil lb_ep01_The_MC_gets_his_bike_back_a7db994e:

#   megan "Great."
    megan "Ótimo."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:471
translate brazil lb_ep01_The_MC_gets_his_bike_back_4fa214f2:

#   mc "And what about my bike?"
    mc "E quanto à minha bicicleta?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:473
translate brazil lb_ep01_The_MC_gets_his_bike_back_c02fb48d:

#   megan "It's all yours."
    megan "É tudo seu."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:475
translate brazil lb_ep01_The_MC_gets_his_bike_back_72442fca:

#   mc "Really? Just like that?"
    mc "Sério? Assim, sem mais nem menos?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:477
translate brazil lb_ep01_The_MC_gets_his_bike_back_e53be4cd:

#   megan "Consider it a peace offering. And also to confirm that my intentions for you are noble."
    megan "Considere isso uma oferta de paz. E também uma forma de confirmar que minhas intenções para com você são nobres."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:479
translate brazil lb_ep01_The_MC_gets_his_bike_back_c7f05e6a:

#   megan "You help me get what I want, and I'll do likewise when and where I can."
    megan "Você me ajuda a conseguir o que quero, e eu farei o mesmo quando e onde puder."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:481
translate brazil lb_ep01_The_MC_gets_his_bike_back_9ff9b7f9:

#   megan "Do we have a deal?"
    megan "Temos um acordo?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:483
translate brazil lb_ep01_The_MC_gets_his_bike_back_d594084c:

#   mc "(She's giving me no reason not to trust her.)"
    mc "(Ela não me dá nenhum motivo para não confiar nela.)"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:485
translate brazil lb_ep01_The_MC_gets_his_bike_back_ba54c449:

#   mc "(I still need to be careful though.)"
    mc "(Ainda preciso ter cuidado, no entanto.)"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:486
translate brazil lb_ep01_The_MC_gets_his_bike_back_86f9bab7:

#   mc "Agreed."
    mc "Acordado."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:488
translate brazil lb_ep01_The_MC_gets_his_bike_back_b1778684:

#   megan "Great. You've made the right decision."
    megan "Ótimo. Você tomou a decisão certa."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:489
translate brazil lb_ep01_The_MC_gets_his_bike_back_4fb73347:

#   megan "I look forward to working {i}very closely{/i} with you."
    megan "Aguardo com expectativa a oportunidade de trabalhar. {i} muito de perto{/i} com você."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:491
translate brazil lb_ep01_The_MC_gets_his_bike_back_c44ab255:

#   megan "Do you have any other questions?"
    megan "Você tem mais alguma pergunta?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:493
translate brazil lb_ep01_The_MC_gets_his_bike_back_f162601b:

#   mc "Just one..."
    mc "Apenas um..."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:495
translate brazil lb_ep01_The_MC_gets_his_bike_back_c52685ac:

#   mc "Why are you helping me? It can't be solely because you think I have potential."
    mc "Por que você está me ajudando? Não pode ser apenas porque você acha que eu tenho potencial."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:496
translate brazil lb_ep01_The_MC_gets_his_bike_back_0b4981b2:

#   mc "It's just a little hard for me to believe that anyone would be interested in me for \"almost\" doing a job successfully."
    mc "É um pouco difícil para mim acreditar que alguém se interessaria por mim por \"quase\" ter feito um trabalho com sucesso."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:498
translate brazil lb_ep01_The_MC_gets_his_bike_back_abf6493a:

#   mc "So what's the real reason?"
    mc "Qual é, então, o verdadeiro motivo?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:500
translate brazil lb_ep01_The_MC_gets_his_bike_back_7942e088:

#   megan "All right, I'll be perfectly frank with you, [y_name]."
    megan "Muito bem, serei completamente franco com você, [y_name]."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:502
translate brazil lb_ep01_The_MC_gets_his_bike_back_14301d69:

#   megan "It's because I believe you can be trusted. And because I like you."
    megan "É porque acredito que você é confiável. E porque gosto de você."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:504
translate brazil lb_ep01_The_MC_gets_his_bike_back_39d1f062:

#   megan "I felt like we made a very strong connection when we met yesterday."
    megan "Senti que criamos uma conexão muito forte quando nos encontramos ontem."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:505
translate brazil lb_ep01_The_MC_gets_his_bike_back_2a913893:

#   megan "Wouldn't you agree?"
    megan "Você não concorda?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:508
translate brazil lb_ep01_The_MC_gets_his_bike_back_9760745b:

#   mc "Y-yeah... I suppose we did."
    mc "É... acho que sim."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:510
translate brazil lb_ep01_The_MC_gets_his_bike_back_0208189a:

#   mc "(I could definitely feel some sexual tension between us.)"
    mc "(Eu definitivamente conseguia sentir uma certa tensão sexual entre nós.)"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:512
translate brazil lb_ep01_The_MC_gets_his_bike_back_2ab65147:

#   mc "(But maybe that was just me and a certain part of my anatomy that believes that.)"
    mc "(Mas talvez fosse apenas eu e uma certa parte da minha anatomia que acreditava nisso.)"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:514
translate brazil lb_ep01_The_MC_gets_his_bike_back_fd9a2c28:

#   megan "A lot of my success and everything I have achieved, everything you see before you, is because I'm a good judge of character."
    megan "Grande parte do meu sucesso e de tudo que conquistei, tudo que você vê diante de si, se deve ao fato de eu ser um bom juiz de caráter."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:515
translate brazil lb_ep01_The_MC_gets_his_bike_back_572df808:

#   megan "I don't request services from just anybody."
    megan "Não solicito serviços de qualquer pessoa."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:517
translate brazil lb_ep01_The_MC_gets_his_bike_back_a90f9581:

#   megan "Does that answer your question?"
    megan "Isso responde à sua pergunta?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:519
translate brazil lb_ep01_The_MC_gets_his_bike_back_06024e54:

#   mc "Yes, it does."
    mc "Sim, faz sentido."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:521
translate brazil lb_ep01_The_MC_gets_his_bike_back_e9208142:

#   megan "Wonderful!"
    megan "Maravilhoso!"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:524
translate brazil lb_ep01_The_MC_gets_his_bike_back_c026c299:

#   megan "Anyway, I don't mean to be rude but I do need my beauty sleep."
    megan "Enfim, não quero ser indelicada, mas preciso do meu sono de beleza."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:526
translate brazil lb_ep01_The_MC_gets_his_bike_back_09ff3b36:

#   mc "Yeah, I should probably get going."
    mc "Sim, acho que já devo ir."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:528
translate brazil lb_ep01_The_MC_gets_his_bike_back_a2b357c6:

#   megan "Allow me to show you out..."
    megan "Permita-me acompanhá-lo até a saída..."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:542
translate brazil lb_ep01_The_MC_gets_his_bike_back_01d50e02:

#   mc "Thanks again for finding my bike."
    mc "Obrigado novamente por encontrar minha bicicleta."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:544
translate brazil lb_ep01_The_MC_gets_his_bike_back_61b15cef:

#   megan "You're most welcome."
    megan "Você é muito bem-vindo(a)."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:546
translate brazil lb_ep01_The_MC_gets_his_bike_back_53790766:

#   megan "But do you think saying thanks is enough?"
    megan "Mas você acha que dizer obrigado é suficiente?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:552
translate brazil lb_ep01_The_MC_gets_his_bike_back_aeb392c8:

#   mc "Oh, um... Thank you very much?"
    mc "Ah, hum... Muito obrigada?"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:553
translate brazil lb_ep01_The_MC_gets_his_bike_back_03a9b273:

#   mc "And thanks for sending your limo to pick me up."
    mc "E obrigado por enviar sua limusine para me buscar."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:554
translate brazil lb_ep01_The_MC_gets_his_bike_back_58e4aadd:

#   mc "I really do appreciate it and I look forward to hearing from you tomorrow."
    mc "Agradeço muito e aguardo seu contato amanhã."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:557
translate brazil lb_ep01_The_MC_gets_his_bike_back_302c50b7:

#   megan "Oh... Sure thing."
    megan "Ah... Claro."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:559
translate brazil lb_ep01_The_MC_gets_his_bike_back_f1f46d48:

#   megan "(I didn't take him for the completely ignorant type.)"
    megan "(Não o considerei como alguém completamente ignorante.)"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:566
translate brazil lb_ep01_The_MC_gets_his_bike_back_e64660bb:

#   mc "Mwah!"
    mc "Uau!"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:567
translate brazil lb_ep01_The_MC_gets_his_bike_back_80f445cf:

#   mc "(Damn, she smells amazing!)"
    mc "(Nossa, ela tem um cheiro incrível!)"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:570
translate brazil lb_ep01_The_MC_gets_his_bike_back_d4a5940e:

#   mc "And there's plenty more where that came from if you play your cards right."
    mc "E há muito mais de onde isso veio, se você jogar bem as suas cartas."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:572
translate brazil lb_ep01_The_MC_gets_his_bike_back_877335e8:

#   megan "(He's certainly sure of himself, and doesn't seem too intimidated by me... yet.)"
    megan "(Ele certamente tem confiança em si mesmo e não parece muito intimidado por mim... ainda.)"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:574
translate brazil lb_ep01_The_MC_gets_his_bike_back_6a35e253:

#   megan "(But will his attitude in the future be a hindrance or a help?)"
    megan "(Mas será que a sua atitude no futuro será um obstáculo ou uma ajuda?)"

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:577
translate brazil lb_ep01_The_MC_gets_his_bike_back_56838246:

#   mc "I look forward to hearing from you tomorrow."
    mc "Aguardo seu contato amanhã."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:584
translate brazil lb_ep01_The_MC_gets_his_bike_back_7d9fc0c6:

#   megan "Now there's a good boy."
    megan "Esse sim é um bom menino."

# game/scripts/Episode 01/Day 3/13_02_The_MC_Gets_His_Bike_Back.rpy:596
translate brazil lb_ep01_The_MC_gets_his_bike_back_48d21ca7:

#   megan "The gate will open automatically on your way out."
    megan "O portão abrirá automaticamente quando você sair."

