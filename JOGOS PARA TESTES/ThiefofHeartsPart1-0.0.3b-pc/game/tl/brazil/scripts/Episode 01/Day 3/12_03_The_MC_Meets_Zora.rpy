#   mc "I took several martial arts classes throughout my teens."
    mc "Fiz várias aulas de artes marciais durante a minha adolescência."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:355
translate brazil lb_ep01_The_MC_meets_Zora_04446916:

#   mc "I picked up a thing or two."
    mc "Aprendi uma coisa ou outra."

