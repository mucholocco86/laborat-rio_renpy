# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:580
translate brazil lb_ep01_12_03_MC_Calls_Bella_c42e182d:

#   b "So it's not a great time."
    b "Portanto, não é um bom momento."

