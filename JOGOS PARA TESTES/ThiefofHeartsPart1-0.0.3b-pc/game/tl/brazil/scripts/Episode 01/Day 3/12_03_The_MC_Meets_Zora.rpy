translate brazil lb_ep01_The_MC_meets_Zora_f2573b66:

#   mc "Unfortunately no, I have to be somewhere right now."
    mc "Infelizmente não, preciso estar em outro lugar agora."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:329
