#   mc "(And there's my good deed done for the day.)"
    mc "(E aqui está minha boa ação realizada por hoje.)"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:384
translate brazil lb_ep01_The_MC_meets_Zora_3969d6e2:

#   mc "(Well, at least one of them.)"
    mc "(Bem, pelo menos um deles.)"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:387
translate brazil lb_ep01_The_MC_meets_Zora_35b3843b:

#   mc "(Now to make that phone call so I can do these final tasks I promised to help with...)"
    mc "(Agora preciso fazer aquela ligação para concluir as últimas tarefas que prometi ajudar...)"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:345
translate brazil lb_ep01_The_MC_meets_Zora_ca57d060_1:

#   zora "Yeah..."
    zora "Sim..."

