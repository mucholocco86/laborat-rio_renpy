translate brazil lb_ep01_12_03_MC_Calls_Bella_545693b3:

#   mc "I know you probably wanted to go to this art school a little later on, but is there any chance we could go sooner, as in, right now?"
    mc "Sei que você provavelmente queria ir para essa escola de arte um pouco mais tarde, mas existe alguma possibilidade de irmos mais cedo, tipo, agora mesmo?"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:572
translate brazil lb_ep01_12_03_MC_Calls_Bella_ce6dba70:

#   b "Why?"
    b "Por que?"

