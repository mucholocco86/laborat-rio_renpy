#   zora "Thank you, [y_name], for coming to my rescue, for walking me into town and um..."
    zora "Obrigado, [y_name], por vir em meu socorro, por me acompanhar até a cidade e hum..."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:372
translate brazil lb_ep01_The_MC_meets_Zora_214bf705:

#   zora "For telling me about your gym."
    zora "Obrigada por me falar sobre sua academia."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:374
translate brazil lb_ep01_The_MC_meets_Zora_dc09307e:

#   zora "I guess I'll see you next week. I'm already looking forward to it."
    zora "Acho que nos veremos na próxima semana. Já estou ansioso."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:377
translate brazil lb_ep01_The_MC_meets_Zora_fd64c9e7:

#   mc "Yeah, me too, Zora."
    mc "Sim, eu também, Zora."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:379
