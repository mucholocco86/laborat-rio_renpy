translate brazil lb_ep01_The_MC_meets_Zora_12ad6d42:

#   mc "It's not part of a normal lesson, but I could show you a few moves, even some that I came up with."
    mc "Não faz parte de uma aula normal, mas eu poderia te mostrar alguns movimentos, inclusive alguns que eu mesmo criei."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:361
translate brazil lb_ep01_The_MC_meets_Zora_e2360df6:

#   zora "I'd like that."
    zora "Eu gostaria disso."

