#   zora "Okay... Where I'm from, I prefer to remain discreet about working out and getting into shape."
    zora "Bem... De onde eu venho, prefiro ser discreto sobre meus treinos e sobre entrar em forma."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:241
translate brazil lb_ep01_The_MC_meets_Zora_b39b7ff8:

#   zora "Everyone knows who I am and also my family."
    zora "Todos sabem quem eu sou, assim como minha família."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:243
translate brazil lb_ep01_The_MC_meets_Zora_bbe0a465:

#   zora "But here, no one knows me."
    zora "Mas aqui, ninguém me conhece."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:245
translate brazil lb_ep01_The_MC_meets_Zora_47bbd832:

#   mc "(Zora sounds like she could be someone important.)"
    mc "(Zora parece ser alguém importante.)"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:247
translate brazil lb_ep01_The_MC_meets_Zora_69b34a59:

#   mc "(Not like \"royalty\" important, but if she were to go missing, it would be a big deal.)"
    mc "(Não que seja algo da \"realeza\", mas se ela desaparecesse, seria um grande problema.)"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:249
