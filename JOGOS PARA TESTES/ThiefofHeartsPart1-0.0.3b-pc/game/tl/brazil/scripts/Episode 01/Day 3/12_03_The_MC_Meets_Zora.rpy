translate brazil lb_ep01_The_MC_meets_Zora_ca57d060:

#   zora "Yeah..."
    zora "Sim..."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:253
translate brazil lb_ep01_The_MC_meets_Zora_720bdcb0:

#   zora "You probably think I'm a self-absorbed, snobby rich girl, right?"
    zora "Você provavelmente pensa que sou uma patricinha rica, egocêntrica e esnobe, não é?"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:257
translate brazil lb_ep01_The_MC_meets_Zora_92ee9df6:

#   mc "Well, are you?"
    mc "E aí, é mesmo?"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:259
translate brazil lb_ep01_The_MC_meets_Zora_8e293181:

#   zora "Excuse me?"
    zora "Com licença?"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:261
translate brazil lb_ep01_The_MC_meets_Zora_b2fc6194:

#   mc "I don't mean to be rude, but..."
    mc "Não quero ser indelicado, mas..."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:265
translate brazil lb_ep01_The_MC_meets_Zora_4f671c67:

#   mc "No, not at all."
    mc "Não, de forma alguma."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:269
translate brazil lb_ep01_The_MC_meets_Zora_91489cb6:

#   mc "I guess I'm trying to understand why someone would care so much about what other people think."
    mc "Acho que estou tentando entender por que alguém se importaria tanto com o que os outros pensam."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:271
translate brazil lb_ep01_The_MC_meets_Zora_d79f107c:

#   zora "I just needed to do something for me, you know?"
    zora "Eu só precisava fazer algo por mim, sabe?"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:273
translate brazil lb_ep01_The_MC_meets_Zora_2bdf2fd8:

#   zora "Coming here wasn't easy, and finding a gym is an even bigger step for me to take. I've avoided going to one my whole life."
    zora "Chegar aqui não foi fácil, e encontrar uma academia é um passo ainda maior para mim. Evitei ir a uma academia a vida toda."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:275
translate brazil lb_ep01_The_MC_meets_Zora_f656543a:

#   zora "But... I've chosen to finally make this first step, and that's always the hardest part, right?"
    zora "Mas... finalmente decidi dar esse primeiro passo, e essa é sempre a parte mais difícil, não é?"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:277
translate brazil lb_ep01_The_MC_meets_Zora_3c0689b5:

#   mc "(Hmm... That's usually what we tell new signups at our gym.)"
    mc "(Hum... Geralmente é isso que dizemos aos novos alunos da nossa academia.)"

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:279
translate brazil lb_ep01_The_MC_meets_Zora_53b55702:

#   zora "I would have thought that someone who is in really great shape like yourself would understand."
    zora "Eu imaginaria que alguém que está em ótima forma como você entenderia."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:281
translate brazil lb_ep01_The_MC_meets_Zora_4e020d0a:

#   zora "But maybe not."
    zora "Mas talvez não."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:283
translate brazil lb_ep01_The_MC_meets_Zora_4791217b:

#   mc "Woah, woah... Let's back up a bit."
    mc "Calma aí... Vamos voltar um pouco atrás."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:285
