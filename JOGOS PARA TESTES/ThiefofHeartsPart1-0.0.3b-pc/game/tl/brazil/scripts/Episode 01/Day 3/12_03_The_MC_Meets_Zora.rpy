#   mc "Anyway, if you walk down there for a couple of blocks, you'll find the gym."
    mc "Enfim, se você caminhar por ali por alguns quarteirões, encontrará a academia."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:366
translate brazil lb_ep01_The_MC_meets_Zora_2d013505:

