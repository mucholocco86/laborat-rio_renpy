translate brazil lb_ep01_12_03_MC_Calls_Bella_bc14d55a:

#   mc "I understand. However, if we don't go now, then I can't guarantee that I'll be able to help you later."
    mc "Entendo. No entanto, se não formos agora, não posso garantir que poderei ajudá-lo mais tarde."

# game/scripts/Episode 01/Day 3/12_03_The_MC_Meets_Zora.rpy:584
translate brazil lb_ep01_12_03_MC_Calls_Bella_1f4f0328:

