label splashscreen:
    $ renpy.movie_cutscene("images/video/caribdisgames.webm")
    scene black with Dissolve(.4)
    pause 0.2

    scene splash with Dissolve(1.8)
    play sound "neon.mp3"
    scene splash2 with Dissolve(.1)
    scene splash with dis
    play sound "neon.mp3"
    scene splash2 with Dissolve(.1)
    scene splash with dis
    play sound "neon.mp3"
    scene splash2
    pause .025
    scene splash
    pause .025
    play sound2 "neon.mp3"
    scene splash2 with Dissolve(.1)
    pause
    #scene wall with Dissolve(2.5) 
    return


label start:
    $ renpy.music.set_volume(0.5, channel='music2')
    $ renpy.music.set_volume(0.5, channel='music2b')
    $ renpy.music.set_volume(0.1, channel='music3')
    $ renpy.music.set_volume(0.6, channel='soundlow')
    $ renpy.music.set_volume(0.6, channel='soundlow2')
    $ persistent.style = "1"
    $ game_version = myconfig.version
    scene wall
    stop music fadeout 6
    scene black with Dissolve(2.5)
    pause
    play sound "whoosh2.ogg"
    show intro 1 with flash
    play music2 happy1
    a "Hi!" with dissolve
    a "I'm Annie! It's really nice to meet you!"
    a "Thank you for downloading the game!"
    a "I wanted to kick things off by welcoming you and giving you a couple of tips to ensure you’re all set for the journey ahead."
    a "This game is pretty straightforward, and you seem like a pretty smart person, so I don’t think you’ll have much difficulty at all!"
    a "Here’s a few things that might help you along the way..."
    $ namelong = ""
    show intro 2
    show screen heart
    a "This little icon will beat if you do something the girl in front of you liked!"with dis
    play sound "beat.ogg"
    show heartr at topleft with dissolve
    hide heartr
    a "Like this!" with dissolve
    a "When you click on it, you'll see your current stats and standings with all the girls you’ve met during your adventure."
    a "You can even use your mouse wheel or the arrows on your keyboard to see all the different looks for each one of them!"
    a "But be careful! If you happen to see a girl that's greyed out, it means you’ve screwed up somewhere. In order to get on her path again, you’ll have to backtrack and find out where things went wrong!"
    a "Remember, good things are worth fighting for!"
    show intro 1
    a "And, well, I’m sure you know the rest. I don’t think it’s your first time playing this type of game..."with dis
    show intro 4
    a "The dialogue appears here, but remember, you can hide all UI at any time by pressing the \"H\" key."with dis
    a "If you see text that appears in parentheses, it means you’re reading that character’s thoughts!"
    show intro 4c
    a "(Testing... testing. Yep! Things appear to be working just fine!)" with dis
    show intro 4b
    a "(Oh, and since all my thoughts are already on display here, let me tell you that you should keep the music and sound effects enabled!)" with Dissolve(1.4)
    a "(You can even adjust the music volume from the Preferences menu, as well as the size and opacity of the textbox!)"
    a "(Sounds and music make the game soooo much better, trust me.)"
    a "(It’s way more... immersive!)"
    a "(You won't regret it!)"
    show intro 5
    a "And that's it!" with dis
    a "Thanks for hearing me out! I wish you a very–"
    show intro 6
    d "What the hell is going on here?" with dis
    d "What are you doing, Annie?"
    d "Are you welcoming the new players?"
    d "I thought I was in charge of doing that!"
    show intro 7
    a "Dalia! I... Um..." with dis
    a "I know this was supposed to be your job, but there's been a change of plans."
    d "What? Why? Who decided that?!"
    a "You know... him!"
    d "What?"
    d "He didn't say anything to me about a change of plans..."
    d "You–"
    show intro 8
    a "Yeah, well, um..." with dis
    a "Anyway, there's no use cryin' over spilled milk! Besides, I’m sure the new player is eager to begin! We should get going!"
    d "Hmmm..."
    a "Bye-bye for now! I hope to see you soon!"
    a "Enjoy!"
    scene black with dis
    $ mc = renpy.input("What is your name? (Default: Orion)", exclude='\\[]{')
    $ mc = mc.title()
    $ mc = mc.strip()
    if mc == "":
        $ mc = __("Orion")
    if mc == __("Alex"):
        "{i}Be aware! There's another important character with this name in the game! Consider choosing another one."
    if mc == __("Jerry"):
        "{i}Be aware! There's another important character with this name in the game! Consider choosing another one."
    if mc == __("Benjamin"):
        "{i}Be aware! There's another important character with this name in the game! Consider choosing another one."
    if mc == __("William"):
        "{i}Be aware! There's another important character with this name in the game! Consider choosing another one."
    $ lastname = renpy.input("What is your last name? (Default: Richards)", exclude='\\[]{')
    $ lastname = lastname.title()
    if lastname == "":
        $ lastname = "Richards"
    $ namelong = mc[-1]*5
    menu:
        "Do you want to enable pregnancy content?"
        "Yes{#0.1,pregnant}":
            $ pregnancy = True
        "No{#0.1,pregnant}":
            $ pregnancy = False
