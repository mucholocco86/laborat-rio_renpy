#   d "Don’t just sit there!"
    d "Não fique aí sentado!"

# game/script.rpy:8742
translate brazil dungeon_abf44f02:

#   d "We’re running out of time!"
    d "Estamos ficando sem tempo!"

# game/script.rpy:8744
