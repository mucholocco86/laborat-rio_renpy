# game/script.rpy:998
translate brazil start_3f2e36f4:

#   mc "*Imitating Chang's voice* {i}Bro, if you believe you're a player, you'll become a player."
    mc "*Imitando a voz do Chang* {i}Mano, se você acredita que é um jogador, você se tornará um jogador."

# game/script.rpy:999
translate brazil start_6857eab2:

#   mc "*Imitating Chang's voice* {i}No one knows us in this town. This is our chance to start fresh."
    mc "*Imitando a voz de Chang* {i}Ninguém nos conhece nesta cidade. Esta é a nossa chance de começar do zero."

# game/script.rpy:1000
translate brazil start_8c8e7c28:

#   mc "*Imitating Chang's voice* {i}We can be cool now. We can be whoever we want to be!"
    mc "*Imitando a voz de Chang* {i}Podemos ficar bem agora. Podemos ser quem quisermos ser!"

# game/script.rpy:1002
translate brazil start_621977fc:

#   c "*Laughs* Did I say that?"
    c "*Risos* Eu disse isso?"

# game/script.rpy:1003
translate brazil start_7802b868:

#   c "Well, scratch that then. It’s not going to work."
    c "Bem, risque isso então. Não vai funcionar."

# game/script.rpy:1004
translate brazil start_9a1c8d39:

#   c "You should stick to the \"nice\" guy attitude."
    c "Você deve manter a atitude de cara “legal”."

# game/script.rpy:1005
translate brazil start_5d71e7d0:

#   c "Look at me!"
    c "Olhe para mim!"

# game/script.rpy:1007
translate brazil start_f6194901:

#   mc "You didn't get any girls last year either."
    mc "Você também não conseguiu nenhuma garota no ano passado."

# game/script.rpy:1008
translate brazil start_aa2dc591:

#   mc "You spent 2 months composing a song to ask Cindy out, and when you finally did, she just laughed at you."
    mc "Você passou 2 meses compondo uma música para convidar Cindy para sair e, quando finalmente o fez, ela simplesmente riu de você."

# game/script.rpy:1009
translate brazil start_f7de71d5:

#   mc "And once she was finally able to catch her breath, Jeremy broke your guitar!"
    mc "E quando ela finalmente conseguiu recuperar o fôlego, Jeremy quebrou seu violão!"

# game/script.rpy:1011
translate brazil start_75fdf0d8:

#   c "Exactly!"
    c "Exatamente!"

# game/script.rpy:1012
translate brazil start_07afe46f:

#   c "Did that stop me? Did that take away my smile?"
    c "Isso me impediu? Isso tirou meu sorriso?"

# game/script.rpy:1014
translate brazil start_f9a8f3f6:

#   mc "You were crying for 2 weeks every time that-"
    mc "Você chorou por 2 semanas toda vez que-"

# game/script.rpy:1016
translate brazil start_14e05191:

#   c "What I'm trying to say is that no matter what happens, you should never lower your head!"
    c "O que estou tentando dizer é que não importa o que aconteça, você nunca deve abaixar a cabeça!"

# game/script.rpy:1017
translate brazil start_f0cd86a7:

#   c "Life is wonderful, [mc]!"
    c "A vida é maravilhosa, [mc]!"

# game/script.rpy:1019
translate brazil start_8687d4b4:

#   mc "Yeah, well, if you say so..."
    mc "Sim, bem, se você diz..."

# game/script.rpy:1021
translate brazil start_733c5ac9:

#   c "And if all else fails, I'll always be someone you can depend on, my friend."
    c "E se tudo mais falhar, sempre serei alguém em quem você pode confiar, meu amigo."

# game/script.rpy:1022
translate brazil start_8b1a4511:

#   mc "Hah... I know, buddy."
    mc "Hah... eu sei, amigo."

# game/script.rpy:1023
translate brazil start_dbd469c3:

#   mc "(Ah... Chang.)"
    mc "(Ah... Chang.)"

# game/script.rpy:1024
translate brazil start_d8ef7c67:

#   mc "(I met him over 10 years ago when I started school in London. He can be a bit weird at times, and that usually scares people.)"
    mc "(Eu o conheci há mais de 10 anos, quando comecei a estudar em Londres. Ele pode ser um pouco estranho às vezes, e isso geralmente assusta as pessoas.)"

# game/script.rpy:1025
translate brazil start_3fb30a24:

#   mc "(However, I would trust him with my life. I know he'd do anything to help me, if necessary.)"
    mc "(No entanto, eu confiaria minha vida a ele. Sei que ele faria qualquer coisa para me ajudar, se necessário.)"

# game/script.rpy:1026
translate brazil start_7a6e7d64:

#   mc "(Upon getting accepted to the Student Exchange Program, I was allowed to extend the invitation to some others as well.)"
    mc "(Ao ser aceito no Programa de Intercâmbio de Estudantes, pude estender o convite a outras pessoas também.)"

# game/script.rpy:1028
translate brazil start_8ff31f0a:

#   mc "(In total, there were 3 slots available—one for me and two for whoever I asked to join.)"
    mc "(No total, havia três vagas disponíveis – uma para mim e duas para quem eu pedi para participar.)"

# game/script.rpy:1029
translate brazil start_1d503172:

#   mc "(Chang was one of them, and the other...)"
    mc "(Chang era um deles, e o outro...)"

# game/script.rpy:1030
translate brazil start_ff3931f8:

#   a "I'm back!"
    a "Voltei!"

# game/script.rpy:1035
translate brazil start_c937296f:

#   mc "(...was Annie.)" with dissolve
    mc "(...era Annie.)" with dissolve

# game/script.rpy:1039
translate brazil start_f3c4b47b:

#   mc "Hey! Were you able to make that call?" with dis
    mc "Ei! Você conseguiu fazer essa ligação?" with dis

# game/script.rpy:1041
translate brazil start_8b3fa1a5:

#   a "Yes! Mission accomplished!" with dissolve
    a "Sim! Missão cumprida!" with dissolve

# game/script.rpy:1042
translate brazil start_84eb27f9:

#   a "There was a signal in the first car."
    a "Houve um sinal no primeiro carro."

# game/script.rpy:1044
translate brazil start_75d62f34:

#   mc "Nice!" with dissolve
    mc "Legal!" with dissolve

# game/script.rpy:1046
translate brazil start_29250441:

#   mc "(Annie is a close friend from my childhood.)" with dissolve
    mc "(Annie é uma amiga próxima da minha infância.)" with dissolve

# game/script.rpy:1047
translate brazil start_b17d31a8:

#   mc "(When I moved from Kredon, she was my next-door neighbor and the first person I met, along with Chang.)"
    mc "(Quando me mudei de Kredon, ela era minha vizinha e a primeira pessoa que conheci, junto com Chang.)"

# game/script.rpy:1048
translate brazil start_942fe02a:

#   mc "(We quickly bonded after discovering we both had something in common... the absence of our parents.)"
    mc "(Nós rapidamente nos unimos depois de descobrir que ambos tínhamos algo em comum... a ausência de nossos pais.)"

# game/script.rpy:1049
translate brazil start_77a11874:

#   mc "(Her father was a traveling salesman and her mother was a flight attendant, so she almost never got to see the two of them.)"
    mc "(O pai dela era caixeiro-viajante e a mãe comissária de bordo, então ela quase nunca via os dois.)"

# game/script.rpy:1050
translate brazil start_5e09e233:

#   mc "(We were both lost... and lonely.)"
    mc "(Estávamos ambos perdidos... e solitários.)"

# game/script.rpy:1051
translate brazil start_bdf37fec:

#   mc "(After finding a companion within each other, we’ve been inseparable ever since.)"
    mc "(Depois de encontrarmos um companheiro um no outro, nos tornamos inseparáveis ​​desde então.)"

# game/script.rpy:1052
translate brazil start_0568c337:

#   mc "(Annie is very polite, kind, and amiable.)"
    mc "(Annie é muito educada, gentil e amável.)"

# game/script.rpy:1053
translate brazil start_40948cd5:

#   mc "(Because of how close we were, people always believed we were dating... but the truth is, we're just friends.)"
    mc "(Por sermos próximos, as pessoas sempre acreditaram que estávamos namorando... mas a verdade é que somos apenas amigos.)"

# game/script.rpy:1054
translate brazil start_3e798d5b:

#   mc "(I mean… she's cute, and we love spending time with each other, but I've never tried to make a move on her.)"
    mc "(Quero dizer... ela é fofa e adoramos passar tempo um com o outro, mas nunca tentei mexer com ela.)"

# game/script.rpy:1055
translate brazil start_f9e67898:

#   mc "(I could never do it.)"
    mc "(Eu nunca conseguiria fazer isso.)"

# game/script.rpy:1056
translate brazil start_517cd701:

#   mc "(She'd probably freak out if I did.)"
    mc "(Ela provavelmente iria surtar se eu fizesse isso.)"

# game/script.rpy:1057
translate brazil start_057a305d:

#   mc "(And I'm not interested at all either.)"
    mc "(E também não estou interessado.)"

# game/script.rpy:1058
translate brazil start_2f9ce929:

#   mc "(I mean... Um... It wouldn't work.)"
    mc "(Quero dizer... Hum... Não funcionaria.)"

# game/script.rpy:1059
translate brazil start_a136dcf7:

#   mc "(It would be... weird for us. Yeah! That's the word. Weird.)"
    mc "(Seria... estranho para nós. Sim! Essa é a palavra. Estranho.)"

# game/script.rpy:1060
translate brazil start_42105d4c:

#   mc "(It's just not the kind of relationship we have.)"
    mc "(Simplesmente não é o tipo de relacionamento que temos.)"

# game/script.rpy:1063
translate brazil start_005f4daa:

#   a "Stop doing that!" with hpunch
    a "Pare de fazer isso!" with hpunch

# game/script.rpy:1064
translate brazil start_102aa7ae:

#   mc "W-What?"
    mc "O-o quê?"

# game/script.rpy:1065
translate brazil start_882e7265:

#   a "You know what. You always do that! First you're talking to someone, then your wandering thoughts take ahold of you and you stop listening."
    a "Você sabe o que. Você sempre faz isso! Primeiro você está conversando com alguém, depois seus pensamentos errantes tomam conta de você e você para de ouvir."

# game/script.rpy:1066
translate brazil start_bf603bcb:

#   mc "Me? That's not true."
    mc "Meu? Isso não é verdade."

# game/script.rpy:1067
translate brazil start_17a79874:

#   a "What was I talking about?"
    a "Do que eu estava falando?"

# game/script.rpy:1068
translate brazil start_f30ad74a:

#   mc "When?"
    mc "Quando?"

# game/script.rpy:1069
translate brazil start_4d725057:

#   a "Now. Before I brought you back into the real world."
    a "Agora. Antes de eu trazer você de volta ao mundo real."

# game/script.rpy:1070
translate brazil start_34d7e374:

#   mc "Um... Something about... video games?"
    mc "Hum... Algo sobre... videogames?"

# game/script.rpy:1071
translate brazil start_26c8c55e:

#   a ". . ."
    a ". . ."

# game/script.rpy:1072
translate brazil start_38632331:

#   a "I knew you weren't listening to me."
    a "Eu sabia que você não estava me ouvindo."

# game/script.rpy:1073
translate brazil start_64202350:

#   mc "Um... Okay, sorry, it won't happen again."
    mc "Hum... Ok, desculpe, isso não vai acontecer de novo."

# game/script.rpy:1074
translate brazil start_7ac8b8ba:

#   a "It better not!"
    a "É melhor não!"

# game/script.rpy:1076
translate brazil start_271109d7:

#   a "I was saying that I spoke with Nancy." with dis
    a "Eu estava dizendo que falei com Nancy." with dis

# game/script.rpy:1077
translate brazil start_f1db14fd:

#   a "She said she’s already there! She’ll be waiting for us outside Kredon's station."
    a "Ela disse que já está lá! Ela estará nos esperando do lado de fora da estação de Kredon."

# game/script.rpy:1079
translate brazil start_c67cbef8:

#   mc "Ah, that's great!" with dissolve
    mc "Ah, isso é ótimo!" with dissolve

# game/script.rpy:1080
translate brazil start_628518cf:

#   mc "I can't wait to see her. I hope she recognizes me."
    mc "Mal posso esperar para vê-la. Espero que ela me reconheça."

# game/script.rpy:1082
translate brazil start_748bd1ec:

#   a "*Laughs* I'm sure she will." with dis
    a "*Risos* Tenho certeza que ela vai." with dis

# game/script.rpy:1084
translate brazil start_9ac72b01:

#   mc "(I'm actually kind of nervous.)" with dissolve
    mc "(Na verdade, estou meio nervoso.)" with dissolve

# game/script.rpy:1085
translate brazil start_302827ef:

#   mc "(Nancy used to be my babysitter in Kredon. Since my father was always working, I can recall more memories with her than with my dad.)"
    mc "(Nancy era minha babá em Kredon. Como meu pai estava sempre trabalhando, consigo me lembrar de mais lembranças com ela do que com meu pai.)"

# game/script.rpy:1086
translate brazil start_02f697ee:

#   mc "(I used to spend the entire afternoon playing with Nancy and her daughter Dalia, but then we had to move and ended up losing touch.)"
    mc "(Eu passava a tarde inteira brincando com Nancy e sua filha Dalia, mas depois tivemos que nos mudar e acabamos perdendo contato.)"

# game/script.rpy:1087
translate brazil start_3062fb64:

#   mc "(It was a nice surprise to discover that she was one of the host families working with the Student Exchange Program.)"
    mc "(Foi uma boa surpresa descobrir que ela era uma das famílias anfitriãs que trabalhavam no Programa de Intercâmbio Estudantil.)"

# game/script.rpy:1088
translate brazil start_a7ae1926:

#   mc "(Living with them will be much cheaper than renting a student residence, and it’ll surely be nice to see Nancy and Dalia again.)"
    mc "(Morar com eles será muito mais barato do que alugar uma residência estudantil, e certamente será bom ver Nancy e Dalia novamente.)"

# game/script.rpy:1089
translate brazil start_cd97d54b:

#   mc "(Come to find out, she actually had 2 rooms available, so Annie will have a place to stay as well!)"
    mc "(Descobri que ela tinha 2 quartos disponíveis, então Annie também terá um lugar para ficar!)"

# game/script.rpy:1090
translate brazil start_137b57f6:

#   mc "(She’s actually been the one who’s been coordinating with Nancy over the phone, even though they didn’t know each other beforehand.)"
    mc "(Na verdade, é ela quem está coordenando com Nancy por telefone, embora elas não se conhecessem de antemão.)"

# game/script.rpy:1091
translate brazil start_2f51f13c:

#   mc "(I've always hated talking on the phone. I prefer chatting online, or talking in person.)"
    mc "(Sempre odiei falar ao telefone. Prefiro conversar online ou pessoalmente.)"

# game/script.rpy:1093
translate brazil start_504e10b1:

#   a "Do you think she will like me?" with dissolve
    a "Você acha que ela vai gostar de mim?" with dissolve

# game/script.rpy:1095
translate brazil start_1250b04a:

#   mc "Nancy? Of course!" with dissolve
    mc "Nanci? Claro!" with dissolve

# game/script.rpy:1096
translate brazil start_07e2c6b2:

#   mc "Don't worry about it, Annie. I haven't seen her in over 10 years, so it’ll probably feel like I’m meeting her for the first time too!"
    mc "Não se preocupe com isso, Annie. Eu não a vejo há mais de 10 anos, então provavelmente vai parecer que estou conhecendo ela pela primeira vez também!"

# game/script.rpy:1098
translate brazil start_1bb89422:

#   a "I know, but I can't help feeling a little bit nervous." with dissolve
    a "Eu sei, mas não posso deixar de me sentir um pouco nervoso." with dissolve

# game/script.rpy:1099
translate brazil start_4ee559c5:

#   a "What about you, Chang? Do you know anything about your host family?"
    a "E você, Chang? Você sabe alguma coisa sobre sua família anfitriã?"

# game/script.rpy:1101
translate brazil start_a93eaef0:

#   c "Not much! I just know their names are Lucinda and Mark, and they have a daughter named Micaela. They said their house isn’t very far away from the school."
    c "Não muito! Só sei que os nomes deles são Lucinda e Mark, e eles têm uma filha chamada Micaela. Eles disseram que a casa deles não fica muito longe da escola."

# game/script.rpy:1102
translate brazil start_fd0ddd8a:

#   c "Micaela is supposed to be the same age as us, so that's cool."
    c "Micaela deveria ter a mesma idade que nós, então tudo bem."

# game/script.rpy:1104
translate brazil start_292df759:

#   a "Sounds good!"
    a "Parece bom!"

# game/script.rpy:1108
translate brazil start_59caa819:

#   pas "{i}Next stop: Delwick" with dis
    pas "{i}Próxima parada: Delwick" with dis

# game/script.rpy:1109
translate brazil start_a1a21969:

#   a "Ahh! We're almost there!"
    a "Ahh! Estamos quase lá!"

# game/script.rpy:1111
translate brazil start_01519075:

#   a "That's the second-to-last stop!" with dis
    a "Essa é a penúltima parada!" with dis

# game/script.rpy:1112
translate brazil start_c01d3528:

#   a "What's the first thing you're going to do when we get to our new home?"
    a "Qual a primeira coisa que você fará quando chegarmos em nossa nova casa?"

# game/script.rpy:1114
translate brazil start_495fade2:

#   mc "Well, say hello to everyone." with dissolve
    mc "Bem, diga olá a todos." with dissolve

# game/script.rpy:1116
translate brazil start_a036821b:

#   a "I mean after that, airhead!" with dissolve
    a "Quero dizer, depois disso, cabeça-dura!" with dissolve

# game/script.rpy:1118
translate brazil start_0ba18a72:

#   mc "To tell you the truth, I'm pretty tired. I think I'll just go to sleep." with dissolve
    mc "Para falar a verdade, estou muito cansado. Acho que vou dormir." with dissolve

# game/script.rpy:1119
translate brazil start_a111ae47:

#   mc "Tomorrow is our first day of school, so I’d like to start off on the right foot. I would hate for everyone’s first impression to be from the Sleepy and Cranky [mc]."
    mc "Amanhã é nosso primeiro dia de aula, então gostaria de começar com o pé direito. Eu odiaria que a primeira impressão de todos fosse do Sleepy and Cranky [mc]."

# game/script.rpy:1121
translate brazil start_d298dcdc:

#   a "*Giggles* Fair enough!" with dissolve
    a "*Risos* Justo!" with dissolve

# game/script.rpy:1123
translate brazil start_aed3877c:

#   mc "What about you? What will you do?" with dissolve
    mc "E você? O que você vai fazer?" with dissolve

# game/script.rpy:1125
translate brazil start_1c264a6e:

#   a "Me? Logging into Eternum and playing a while, of course!" with dis
    a "Meu? Entrando no Eternum e jogando um pouco, é claro!" with dis

# game/script.rpy:1126
translate brazil start_f9a51a91:

#   mc "Ahh... I should’ve known."
    mc "Ahh... eu deveria saber."

# game/script.rpy:1127
translate brazil start_d99e0238:

#   mc "I don't even know why I asked."
    mc "Eu nem sei por que perguntei."

# game/script.rpy:1133
translate brazil start_c41e0098:

#   mc "{i}Eternum." with dis
    mc "{i}Eterno." with dis

# game/script.rpy:1134
translate brazil start_c31c5a3e:

#   mc "{i}Over the past year, every single conversation I have seems to be about it."
    mc "{i}Durante o ano passado, todas as conversas que tive parecem ser sobre isso."

# game/script.rpy:1135
translate brazil start_b9ac4637:

#   mc "{i}Just over a decade ago, a newly created company called Ulysses announced their first game:"
    mc "{i}Há pouco mais de uma década, uma empresa recém-criada chamada Ulysses anunciou seu primeiro jogo:"

# game/script.rpy:1136
translate brazil start_4e8cd70e:

#   mc "{i}A virtual, hyper-reality MMORPG that promised to revolutionize the world of technology."
    mc "{i}Um MMORPG virtual de hiper-realidade que prometia revolucionar o mundo da tecnologia."

# game/script.rpy:1137
translate brazil start_b1aadf90:

#   mc "{i}With the game’s neural implant that recreates the five senses, they said it’d become impossible to distinguish between the game and the real world."
    mc "{i}Com o implante neural do jogo que recria os cinco sentidos, eles disseram que seria impossível distinguir entre o jogo e o mundo real."

# game/script.rpy:1138
translate brazil start_96da4c51:

#   mc "{i}\"Eternum. More real than real life.\""
    mc "{i}\"Eternum. Mais real que a vida real.\""

# game/script.rpy:1139
translate brazil start_66a828f5:

#   mc "{i}They promised thousands of servers, absolute freedom, and things never before seen in history."
    mc "{i}Eles prometeram milhares de servidores, liberdade absoluta e coisas nunca antes vistas na história."

# game/script.rpy:1140
translate brazil start_7091e0a7:

#   mc "{i}A big claim, for sure."
    mc "{i}Uma grande afirmação, com certeza."

# game/script.rpy:1141
translate brazil start_e87dec2e:

#   mc "{i}But after they released the first version of the game and players got to see things for themselves, everything they promised... turned out to be an understatement."
    mc "{i}Mas depois que lançaram a primeira versão do jogo e os jogadores puderam ver as coisas por si mesmos, tudo o que prometeram... acabou sendo um eufemismo."

# game/script.rpy:1142
translate brazil start_5db1bcda:

#   mc "{i}It was better than one could've ever imagined."
    mc "{i}Foi melhor do que se poderia imaginar."

# game/script.rpy:1143
translate brazil start_63cf18d0:

#   mc "{i}People became addicted to Eternum, to say the least. The neural implant required to play cost $3500 and could only be used by a single person. They started to call it \"The drug of the rich\"."
    mc "{i}As pessoas ficaram viciadas em Eternum, para dizer o mínimo. O implante neural necessário para jogar custava US$ 3.500 e só poderia ser usado por uma única pessoa. Começaram a chamá-la de “A droga dos ricos”."

# game/script.rpy:1144
translate brazil start_084a52fc:

#   mc "{i}Shortly after the first release, Eternum added its own in-game currency and then Ulysses quickly became the biggest company in the world."
    mc "{i}Logo após o primeiro lançamento, a Eternum adicionou sua própria moeda ao jogo e então a Ulysses rapidamente se tornou a maior empresa do mundo."

# game/script.rpy:1145
translate brazil start_600ed1e8:

#   mc "{i}Today, Ulysses' market capitalization is worth $31 trillion U.S. dollars, more than 10 times that of Microsoft or Amazon."
    mc "{i}Hoje, a capitalização de mercado da Ulysses vale US$ 31 trilhões de dólares, mais de 10 vezes a da Microsoft ou da Amazon."

# game/script.rpy:1146
translate brazil start_fc15bdb7:

#   mc "{i}They say the owner of the company could buy out entire countries if he wanted."
    mc "{i}Dizem que o dono da empresa poderia comprar países inteiros se quisesse."

# game/script.rpy:1147
translate brazil start_4974fa48:

#   mc "{i}Not much is known about him, only that he created the entire game by himself and is referred to as... \"The Founder\"."
    mc "{i}Não se sabe muito sobre ele, apenas que ele criou o jogo inteiro sozinho e é conhecido como... \"O Fundador\"."

# game/script.rpy:1148
translate brazil start_53688be8:

#   mc "{i}There's some weird shit going on with that... \"game\"."
    mc "{i}Há alguma merda estranha acontecendo com esse... \"jogo\"."

# game/script.rpy:1149
translate brazil start_470e5fc0:

#   mc "{i}Yeah, you can't die in Eternum, but you can still feel pain. And there’s a dark side to the game too... black markets, torture, rape, child sexual abuse material, data theft..."
    mc "{i}Sim, você não pode morrer em Eternum, mas ainda pode sentir dor. E há um lado negro no jogo também... mercados negros, tortura, estupro, material de abuso sexual infantil, roubo de dados..."

# game/script.rpy:1150
translate brazil start_56c8aec2:

#   mc "{i}Everyone knows about it, but world governments turn a blind eye to it. Eternum abides by its own law. Its own rules. Its own police."
    mc "{i}Todo mundo sabe disso, mas os governos mundiais fazem vista grossa a isso. Eternum cumpre sua própria lei. Suas próprias regras. Sua própria polícia."

# game/script.rpy:1151
translate brazil start_1a52f62e:

#   mc "{i}And people don't care. They can fulfill all their fantasies there."
    mc "{i}E as pessoas não se importam. Eles podem realizar todas as suas fantasias lá."

# game/script.rpy:1152
translate brazil start_46553938:

#   mc "{i}And that... seems to be all that matters."
    mc "{i}E isso... parece ser tudo o que importa."

# game/script.rpy:1157
translate brazil start_37e89622:

#   mc "You should go to sleep too, Annie. We have to wake up early tomorrow." with dissolve
    mc "Você deveria dormir também, Annie. Temos que acordar cedo amanhã." with dissolve

# game/script.rpy:1158
translate brazil start_8dfd2013:

#   a "Yes, yes, I will!"
    a "Sim, sim, eu vou!"

# game/script.rpy:1159
translate brazil start_d4f8f479:

#   a "I'll just complete a couple of dungeons and pay a quick visit to the market."
    a "Vou apenas completar algumas masmorras e fazer uma rápida visita ao mercado."

# game/script.rpy:1160
translate brazil start_3e9c5369:

#   mc "I don't even know how the hell you managed to get enough money to buy yourself a neural implant."
    mc "Eu nem sei como diabos você conseguiu dinheiro suficiente para comprar um implante neural."

# game/script.rpy:1161
translate brazil start_2ebadb3b:

#   a "Well, it’s because as soon as the game was announced, I worked every side-gig I could and saved up each penny I earned!"
    a "Bem, é porque assim que o jogo foi anunciado, trabalhei em todos os trabalhos paralelos que pude e economizei cada centavo que ganhei!"

# game/script.rpy:1162
translate brazil start_da8e5ba8:

#   a "And it was SO worth it!"
    a "E valeu MUITO a pena!"

# game/script.rpy:1163
translate brazil start_78916c40:

#   mc "You play too much."
    mc "Você joga demais."

# game/script.rpy:1164
translate brazil start_82c3a54a:

#   a "Nah, that's not true!"
    a "Não, isso não é verdade!"

# game/script.rpy:1165
translate brazil start_1ab011e9:

#   mc "Yes, it is. How many hours a day do you play? 8? 10?"
    mc "É sim. Quantas horas por dia você joga? 8? 10?"

# game/script.rpy:1166
translate brazil start_0ec894fe:

#   mc "You're addicted."
    mc "Você é viciado."

# game/script.rpy:1169
translate brazil start_89cf9e72:

#   a "You’re just saying all this because you’re jealous that you can't play Eternum!"
    a "Você só está dizendo tudo isso porque está com ciúmes por não poder jogar Eternum!"

# game/script.rpy:1171
translate brazil start_fa3ab68b:

#   mc "Nah..."
    mc "Não..."

# game/script.rpy:1172
translate brazil start_ed164a02:

#   a "Yes, it's true."
    a "Sim, é verdade."

# game/script.rpy:1173
translate brazil start_13577f53:

#   mc "Nah."
    mc "Não."

# game/script.rpy:1174
