# game/script7.rpy:2824
translate brazil continuedaliapenny_80f38d54:

#   ili "We come from a proud lineage of Strigoi. Our entire people, in fact."
    ili "Viemos de uma orgulhosa linhagem de Strigoi. Na verdade, todo o nosso povo."

# game/script7.rpy:2826
translate brazil continuedaliapenny_f3c3a075:

#   ili2 "Everything was harmonious when we lived in idyllic Stravenovia."
    ili2 "Tudo era harmonioso quando vivíamos na idílica Stravenovia."

# game/script7.rpy:2827
translate brazil continuedaliapenny_5fd1d54f:

#   ili2 "There were only feasts, and parties..."
    ili2 "Havia apenas festas e festas..."

# game/script7.rpy:2828
translate brazil continuedaliapenny_0719cbfd:

#   ili2 "Ah, the parties..."
    ili2 "Ah, as festas..."

# game/script7.rpy:2830
translate brazil continuedaliapenny_9edce9e4:

#   ili "Until one day..."
    ili "Até que um dia..."

# game/script7.rpy:2831
translate brazil continuedaliapenny_4af98b86:

#   ili "Something changed. One by one, our entire kin began to transform into these... creatures you saw outside."
