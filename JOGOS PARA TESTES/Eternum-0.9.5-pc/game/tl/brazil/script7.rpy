#   bak "I never bothered to learn its name."
    bak "Nunca me preocupei em aprender seu nome."

# game/script7.rpy:6882
translate brazil morninghollow_1b61115e:

#   bak "He was the leader of the vampires, that's what matters."
    bak "Ele era o líder dos vampiros, é isso que importa."

# game/script7.rpy:6884
translate brazil morninghollow_a7e0c471:

#   bak "He ventured to our town, apparently because you told him we had a healer capable of curing his wife, or so he said." with dis12
    bak "Ele se aventurou em nossa cidade, aparentemente porque você lhe disse que tínhamos um curandeiro capaz de curar sua esposa, ou foi o que ele disse." with dis12

# game/script7.rpy:6896
translate brazil morninghollow_f38c25f7:

#   mc "F-Fangrend?"
    mc "F-Fangrend?"

