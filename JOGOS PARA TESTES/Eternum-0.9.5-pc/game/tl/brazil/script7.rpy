#   p "I wonder if–"
    p "Eu me pergunto se–"

# game/script7.rpy:2717
translate brazil continuedaliapenny_020b9cbe:

#   p "{sc=2}AAAAARGGHHHH!!{/sc}" with hpunchlong4
    p "{sc=2}AAAAARRGGHHH!!{/sc}" with hpunchlong4

