#   bak "That was a clever ruse."
    bak "Esse foi um estratagema inteligente."

# game/script7.rpy:6907
translate brazil morninghollow_d9792e7b:

#   bak "It was easy to drug him and decapitate him when he lay unconscious."
    bak "Foi fácil drogá-lo e decapitá-lo quando ele estava inconsciente."

# game/script7.rpy:6909
translate brazil morninghollow_743a633e:

#   mc "Really...? Was this truly necessary?"
    mc "Realmente...? Isso foi realmente necessário?"

# game/script7.rpy:6911
translate brazil morninghollow_eeeb0728:

#   bak "Don't play the saint now."
    bak "Não banque o santo agora."

# game/script7.rpy:6912
