    mc "Um..."

# game/script7.rpy:2660
translate brazil continuedaliapenny_a5c1706c:

#   mct "Hmm... it seems like he's actually a genuinely nice guy... despite his appearance."
    mct "Hmm... parece que ele é realmente um cara legal... apesar de sua aparência."

