    aaa "*Curvando-se graciosamente* Boa noite, senhora e senhor." with dis12

# game/script7.rpy:2617
translate brazil continuedaliapenny_3cd02e4c:

#   mor "I am Mortimer. Please, accept my sincerest apologies for the unsettling welcome you just received."
    mor "Eu sou Mortimer. Por favor, aceite minhas mais sinceras desculpas pelas inquietantes boas-vindas que acabou de receber."

# game/script7.rpy:2618
translate brazil continuedaliapenny_8114a09f:

#   mc "Uh..."
    mc "Uh..."

# game/script7.rpy:2619
translate brazil continuedaliapenny_822b45ad:

#   p "N-No problem."
    p "N-Não tem problema."

# game/script7.rpy:2620
translate brazil continuedaliapenny_0720464c:

#   mor "It is my great pleasure to welcome you to Lord Iliescu's residence."
    mor "É um grande prazer recebê-lo na residência de Lord Iliescu."

# game/script7.rpy:2623
translate brazil continuedaliapenny_8bcaea0b:

#   mc "What..." with dis12
    mc "O que..." with dis12

# game/script7.rpy:2624
