#   bak "Anyway, we've got to head back to town." with dis12
    bak "De qualquer forma, temos que voltar para a cidade." with dis12

# game/script7.rpy:6918
translate brazil morninghollow_6df649c2:

#   bak "The other monsters could initiate a revenge attack any time now."
    bak "Os outros monstros poderiam iniciar um ataque de vingança a qualquer momento."

# game/script7.rpy:6919
translate brazil morninghollow_05e90849:

#   bak "If you ever need help, you can reach out to us."
    bak "Se você precisar de ajuda, pode entrar em contato conosco."

# game/script7.rpy:6920
translate brazil morninghollow_fbcd59ed:

#   bak "Hollowbrook won't leave a fellow demon hunter hanging."
    bak "Hollowbrook não deixará um colega caçador de demônios pendurado."

# game/script7.rpy:6921
translate brazil morninghollow_3b2133da:

#   mc "I'll... keep that in mind."
    mc "Eu vou... manter isso em mente."

