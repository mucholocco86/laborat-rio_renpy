translate brazil continuedaliapenny_ab729267:

#   mc "Let's see what this “Lord” can tell us..."
    mc "Vamos ver o que esse “Senhor” pode nos dizer..."

# game/script7.rpy:2680
translate brazil continuedaliapenny_8502f013:

#   bla "Mortimer guides you through a labyrinth of tunnels and galleries, eventually leading you to a crypt adorned with a mysterious altar at its center." with dis14
    bla "Mortimer guia você por um labirinto de túneis e galerias, levando você a uma cripta adornada com um altar misterioso no centro." with dis14

# game/script7.rpy:2681
translate brazil continuedaliapenny_8076bfc1:

#   mor "Here it is!"
    mor "Aqui está!"

# game/script7.rpy:2682
translate brazil continuedaliapenny_08539ca7:

#   mc "*Whispering* Do you remember the way out?"
    mc "*Sussurrando* Você se lembra da saída?"

