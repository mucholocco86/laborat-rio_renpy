#   mc "Alright... we'll meet them."
    mc "Tudo bem... vamos conhecê-los."

# game/script7.rpy:2663
translate brazil continuedaliapenny_bb04f708:

#   mc "But we have to be back in Hollowbrook within 30 minutes. Northsylvania awaits!"
    mc "Mas temos que voltar a Hollowbrook dentro de 30 minutos. A Norte da Silvânia espera!"

