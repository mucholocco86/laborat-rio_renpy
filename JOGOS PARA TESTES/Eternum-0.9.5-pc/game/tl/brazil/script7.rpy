translate brazil menuvampirequestions_5fda6965:

#   ili "I've never heard that name in my life, no."
    ili "Nunca ouvi esse nome na minha vida, não."

# game/script7.rpy:3163
translate brazil menuvampirequestions_b5fec0ae:

#   mc "Do you know what “Eternum” is? Or Ulysses? Or things like... Europe, Asia, or America?"
    mc "Você sabe o que é \"Eterno\"? Ou Ulisses? Ou coisas como... Europa, Ásia ou América?"

# game/script7.rpy:3165
translate brazil menuvampirequestions_88a95067:

#   ili "Uhh... no, I'm not familiar with those terms, I'm sorry."
    ili "Uhh... não, não estou familiarizado com esses termos, sinto muito."

# game/script7.rpy:3167
translate brazil menuvampirequestions_da966407:

#   ili "Despite living for millennia, we've never left Ekabar." with dis
    ili "Apesar de vivermos há milênios, nunca saímos de Ekabar." with dis

# game/script7.rpy:3168
translate brazil menuvampirequestions_8ee5c6fb:

#   ili "Not even we know what lies beyond the great seas."
    ili "Nem mesmo nós sabemos o que existe além dos grandes mares."

# game/script7.rpy:3170
translate brazil menuvampirequestions_c10ad61a:

#   mc "No worries..."
    mc "Sem problemas..."

# game/script7.rpy:3171
translate brazil menuvampirequestions_5f09a9b4:

#   mct "His wife definitely mentioned Romania. I heard it. Shit, now that I think about it, they even brought up actual composers from the real world!"
    mct "Sua esposa definitivamente mencionou a Romênia. Eu ouvi isso. Merda, agora que penso nisso, eles até trouxeram compositores reais do mundo real!"

# game/script7.rpy:3172
translate brazil menuvampirequestions_9a4c4e40:

#   mct "Could their actual memories be intertwined with the false ones they acquired when they became NPCs?"
    mct "Suas memórias reais poderiam estar interligadas com as falsas que adquiriram quando se tornaram NPCs?"

# game/script7.rpy:3173
translate brazil menuvampirequestions_494e800b:

#   mct "Perhaps that's the trigger that can “free” them from Ulysses' control?"
    mct "Talvez seja esse o gatilho que pode “libertá-los” do controle de Ulisses?"

# game/script7.rpy:3174
translate brazil menuvampirequestions_421a79ce:

#   mct "I’ll need to note that down for later..."
    mct "Vou precisar anotar isso para mais tarde..."

# game/script7.rpy:3178
translate brazil menuvampirequestions_7d2b3208:

#   mc "What's your current relationship with the town of Hollowbrook?" with dis06
    mc "Qual é o seu relacionamento atual com a cidade de Hollowbrook?" with dis06

# game/script7.rpy:3180
translate brazil menuvampirequestions_396a19c2:

#   ili "It's... not the best."
    ili "Não é... o melhor."

# game/script7.rpy:3181
translate brazil menuvampirequestions_4ff4c3ab:

#   ili "Their hunters started targeting us without any provocation."
    ili "Seus caçadores começaram a nos atacar sem qualquer provocação."

# game/script7.rpy:3182
translate brazil menuvampirequestions_34e61627:

#   ili "We sustain ourselves on the blood of animals, and we never enter settlements unless it's strictly necessary."
    ili "Nós nos sustentamos com sangue de animais e nunca entramos em assentamentos a menos que seja estritamente necessário."

# game/script7.rpy:3183
translate brazil menuvampirequestions_533ce0e5:

#   ili "However, after they began massacring us... I had to take action."
    ili "Contudo, depois que começaram a nos massacrar... tive que agir."

# game/script7.rpy:3184
translate brazil menuvampirequestions_b6614d0e:

#   ili "These creatures might be mindless monsters now, but they were once my people. I will not stand idly by while they are slaughtered."
    ili "Essas criaturas podem ser monstros estúpidos agora, mas já foram meu povo. Não ficarei de braços cruzados enquanto eles são massacrados."

# game/script7.rpy:3186
translate brazil menuvampirequestions_31f32808:

#   mc "Understandable."
    mc "Compreensível."

# game/script7.rpy:3187
translate brazil menuvampirequestions_0abc4d9f:

#   mct "I wonder what started this surge of erratic behavior among the NPCs."
    mct "Eu me pergunto o que iniciou essa onda de comportamento errático entre os NPCs."

# game/script7.rpy:3188
translate brazil menuvampirequestions_8fca820b:

#   mct "Did the hunters go rogue first? Or perhaps it was the vampires?"
    mct "Os caçadores se rebelaram primeiro? Ou talvez fossem os vampiros?"

# game/script7.rpy:3189
translate brazil menuvampirequestions_e16f2e73:

#   mct "Hmm..."
    mct "Hum..."

# game/script7.rpy:3192
translate brazil menuvampirequestions_7c9012e6:

#   mc "Well, I'd love to stay and continue asking you questions, but we really must be on our way now." with dis08
    mc "Bem, eu adoraria ficar e continuar fazendo perguntas, mas realmente precisamos ir agora." with dis08

# game/script7.rpy:3194
translate brazil postmenuvampire_69121cbd:

#   mc "I hope we can continue our conversation sometime."
    mc "Espero que possamos continuar nossa conversa algum dia."

# game/script7.rpy:3196
translate brazil postmenuvampire_47598fec:

#   ili "Very well."
    ili "Muito bem."

# game/script7.rpy:3197
translate brazil postmenuvampire_e0e74d42:

#   ili "It was a pleasure meeting you, Lord [mc]."
    ili "Foi um prazer conhecê-lo, Senhor [mc]."

# game/script7.rpy:3198
translate brazil postmenuvampire_793dd242:

#   ili "I also hope we have the chance to meet again in the future."
    ili "Também espero que tenhamos a oportunidade de nos encontrar novamente no futuro."

# game/script7.rpy:3200
translate brazil postmenuvampire_2e0ccf64:

#   ili2 "Thank you for the visit!"
    ili2 "Obrigado pela visita!"

# game/script7.rpy:3201
translate brazil postmenuvampire_0c0c7ece:

#   ili2 "And don't hesitate to return! We don't b-bite, I swear!"
    ili2 "E não hesite em voltar! Nós não mordemos, eu juro!"

# game/script7.rpy:3203
translate brazil postmenuvampire_c15026a3:

#   mc "Oh, and by the way..." with dis
    mc "Ah, e por falar nisso..." with dis

# game/script7.rpy:3207
translate brazil postmenuvampire_85ee6cc7:

#   mc "If you truly wish to aid your wife, Hollowbrook is your best bet." with dis06
    mc "Se você realmente deseja ajudar sua esposa, Hollowbrook é sua melhor aposta." with dis06

# game/script7.rpy:3208
translate brazil postmenuvampire_90641af7:

#   mc "We crossed paths with the hunters upon our arrival, and they were leaving the town for good."
    mc "Cruzamos o caminho dos caçadores quando chegamos, e eles estavam deixando a cidade para sempre."

# game/script7.rpy:3209
translate brazil postmenuvampire_43e47039:

#   mc "Now only a handful of civilians remain, and among them there's a healer. Perhaps she can provide some assistance."
    mc "Agora restam apenas alguns civis, e entre eles há um curandeiro. Talvez ela possa fornecer alguma ajuda."

# game/script7.rpy:3210
translate brazil postmenuvampire_a6b7d16d:

#   mct "Hopefully this will lead to a truce and to us becoming friends with the hunters of Hollowbrook."
    mct "Esperamos que isso leve a uma trégua e a nos tornarmos amigos dos caçadores de Hollowbrook."

# game/script7.rpy:3212
translate brazil postmenuvampire_95c7ca73:

#   ili "Oh, that's excellent news."
    ili "Ah, isso é uma excelente notícia."

# game/script7.rpy:3213
translate brazil postmenuvampire_601d3c2d:

#   ili "We'll pay them a visit soon, then."
    ili "Faremos uma visita a eles em breve, então."

# game/script7.rpy:3216
translate brazil postmenuvampire_20b99d9a:

#   mc "We passed through Hollowbrook on our way here, and I can tell you the hunters have lost all reason." with dis06
    mc "Passamos por Hollowbrook a caminho daqui, e posso dizer que os caçadores perderam a razão." with dis06

# game/script7.rpy:3217
translate brazil postmenuvampire_b82e7221:

#   mc "They believe you're all malevolent creatures that must be eradicated."
    mc "Eles acreditam que todos vocês são criaturas malévolas que devem ser erradicadas."

# game/script7.rpy:3218
translate brazil postmenuvampire_f04750d0:

#   mc "If you wish to help your wife, you'd be better off far from that town of lunatics."
    mc "Se você deseja ajudar sua esposa, seria melhor ficar longe daquela cidade de lunáticos."

# game/script7.rpy:3220
translate brazil postmenuvampire_19884169:

#   ili "Thanks for the advice, we'll stay away from it."
    ili "Obrigado pelo conselho, ficaremos longe disso."

# game/script7.rpy:3221
translate brazil postmenuvampire_1e1afbfe:

#   ili "Unfounded fear is something we're accustomed to."
    ili "O medo infundado é algo a que estamos acostumados."

# game/script7.rpy:3222
translate brazil postmenuvampire_10e11b41:

#   ili "Thanks again for your help, [mc]."
    ili "Obrigado novamente pela sua ajuda, [mc]."

# game/script7.rpy:3224
translate brazil postmenuvampire_a7a92e8f:

#   mc "No problem."
    mc "Sem problemas."

# game/script7.rpy:3226
translate brazil postmenuvampire_a346ab14:

#   ili "Mortimer will escort you to the exit."
    ili "Mortimer irá acompanhá-lo até a saída."

# game/script7.rpy:3228
translate brazil postmenuvampire_e3f15aa5:

#   mor "With pleasure!"
    mor "Com prazer!"

# game/script7.rpy:3230
translate brazil postmenuvampire_1b3ccf59:

#   mor "Stick close, you two lovebirds, unless you fancy becoming dinner for giant tarantulas!"
    mor "Fiquem perto, seus dois pombinhos, a menos que queiram virar jantar para tarântulas gigantes!"

# game/script7.rpy:3232
translate brazil postmenuvampire_8b41990f:

#   mor "Stick close, unless you fancy becoming dinner for giant tarantulas!"
    mor "Fique por perto, a menos que você queira se tornar o jantar de tarântulas gigantes!"

# game/script7.rpy:3233
translate brazil postmenuvampire_1caf013c:

#   mc "W-We're right behind you!"
    mc "E-estamos bem atrás de você!"

# game/script7.rpy:3247
translate brazil werewolveslabel_3dfa7ca2:

#   bla "After walking through the woods for a while, you finally come across the ruins of an old fortress." with dis17
    bla "Depois de caminhar um pouco pela floresta, você finalmente se depara com as ruínas de uma antiga fortaleza." with dis17

# game/script7.rpy:3252
translate brazil werewolveslabel_3f4dea7d:

#   mc "*Whistles* (Damn, look at this castle.)" with dis
    mc "* Assobios * (Droga, olhe para este castelo.)" with dis

# game/script7.rpy:3253
translate brazil werewolveslabel_2030f5ac:

#   mct "I mean, it's clear it's seen better days, but its former glory still shines through."
    mct "Quero dizer, está claro que já viu dias melhores, mas sua antiga glória ainda brilha."

# game/script7.rpy:3254
translate brazil werewolveslabel_659382fd:

#   mct "I wonder if Luna also found this place. Without the {i}Lumina{/i} spell she taught me, I would have been completely lost in these woods."
    mct "Eu me pergunto se Luna também encontrou este lugar. Sem o feitiço {i}Lumina{/i} que ela me ensinou, eu estaria completamente perdido nesta floresta."

# game/script7.rpy:3255
translate brazil werewolveslabel_d3b5560c:

#   mc "*Scanning the surroundings* (Hmm...)"
    mc "*Examinando os arredores* (Hmm...)"

# game/script7.rpy:3256
translate brazil werewolveslabel_c61155c7:

#   mct "There's something off about this place, though."
    mct "Há algo estranho neste lugar, no entanto."

# game/script7.rpy:3258
translate brazil werewolveslabel_b46a4601:

#   mct "There are lit torches everywhere, so this can't be the monsters' hideout – there have to be humans nearby."
    mct "Há tochas acesas por toda parte, então este não pode ser o esconderijo dos monstros – deve haver humanos por perto."

# game/script7.rpy:3259
translate brazil werewolveslabel_aae5bb83:

#   mct "Also, there seem to be... chests scattered around?"
    mct "Além disso, parece haver... baús espalhados por aí?"

# game/script7.rpy:3260
translate brazil werewolveslabel_690990df:

#   mct "It almost looks like they were begging me to plunder their content."
    mct "Quase parece que eles estavam me implorando para saquear seu conteúdo."

# game/script7.rpy:3262
translate brazil werewolveslabel_3bec887c:

#   mct "Looks like a classic, basic trap, if you ask me."
    mct "Parece uma armadilha clássica e básica, se você me perguntar."

# game/script7.rpy:3263
translate brazil werewolveslabel_ccdfce6f:

#   mct "Probably bandits waiting to catch unsuspecting travelers on the road."
    mct "Provavelmente bandidos esperando para pegar viajantes desavisados ​​na estrada."

# game/script7.rpy:3264
translate brazil werewolveslabel_047caa1d:

#   mct "A single path through the valley, all surrounded by towering structures."
    mct "Um único caminho pelo vale, todo cercado por estruturas imponentes."

# game/script7.rpy:3265
translate brazil werewolveslabel_026cfc25:

#   mct "Yep, perfect for an ambush."
    mct "Sim, perfeito para uma emboscada."

# game/script7.rpy:3267
translate brazil werewolveslabel_1e89a587:

#   mct "Furthermore, the main wall and its gate are still in pretty good condition, which would make a hypothetical attack easy to defend."
    mct "Além disso, a muralha principal e o seu portão ainda estão em boas condições, o que tornaria um ataque hipotético fácil de defender."

# game/script7.rpy:3268
translate brazil werewolveslabel_8d6192e5:

#   mct "The whole place is simply too quiet not to be a trap..."
    mct "Todo o lugar é simplesmente silencioso demais para não ser uma armadilha..."

# game/script7.rpy:3269
translate brazil werewolveslabel_ed8e0069:

#   mct "Damn it, could Luna have fallen victim to this place?"
    mct "Droga, Luna poderia ter sido vítima deste lugar?"

# game/script7.rpy:3270
translate brazil werewolveslabel_deef82a5:

#   mct "What if the bandits have taken her captive?!"
    mct "E se os bandidos a levaram cativa?!"

# game/script7.rpy:3272
translate brazil werewolveslabel_92afa05c:

#   mct "Fuck... there are dozens of doors in the main courtyard. Could they have stashed her inside?"
    mct "Porra... há dezenas de portas no pátio principal. Eles poderiam tê-la escondido lá dentro?"

# game/script7.rpy:3273
translate brazil werewolveslabel_b009ac2d:

#   mct "Or... perhaps she was captured and taken elsewhere...?"
    mct "Ou... talvez ela tenha sido capturada e levada para outro lugar...?"

# game/script7.rpy:3274
translate brazil werewolveslabel_e49f01af:

#   mct "FUCK! This place is too big, I'll never find her!" with hpunch
    mct "PORRA! Este lugar é muito grande, nunca vou encontrá-la!" with hpunch

# game/script7.rpy:3275
translate brazil werewolveslabel_db382ea3:

#   mct "Goddamn it, what should I do..."
    mct "Droga, o que devo fazer..."

# game/script7.rpy:3277
translate brazil werewolveslabel_e5d18716:

#   mct "Okay... let's calm down and think this through." with dis14
    mct "Ok... vamos nos acalmar e pensar sobre isso." with dis14

# game/script7.rpy:3278
translate brazil werewolveslabel_f0fedfa5:

#   mct "Luna might seem adorable, but she's actually quite powerful."
    mct "Luna pode parecer adorável, mas na verdade ela é muito poderosa."

# game/script7.rpy:3279
translate brazil werewolveslabel_dbe7af54:

#   mct "She wouldn't have let herself be captured without a fight."
    mct "Ela não teria se deixado capturar sem lutar."

# game/script7.rpy:3280
translate brazil werewolveslabel_e6dc3ac3:

#   mct "I'll go down there and try to spot any signs of–"
    mct "Vou até lá e tentarei detectar qualquer sinal de–"

# game/script7.rpy:3281
translate brazil werewolveslabel_c3477187:

#   l "[mc]?"
    l "[mc]?"

# game/script7.rpy:3286
translate brazil werewolveslabel_c0fde9bd:

#   mc "NN-NAAAA-NAA!{w=0.26}{nw}" with hpunch
    mc "NN-NAAAA-NAA!{w=0.26}{nw}" with hpunch

# game/script7.rpy:3287
translate brazil werewolveslabel_7c962894:

#   mc "S-SU-GGL!{w=0.26}{nw}" with hpunch
    mc "S-SU-GGL!{w=0.26}{nw}" with hpunch

# game/script7.rpy:3291
translate brazil werewolveslabel_56b7faf6:

#   mc "G-G-GHJ-HW-WHAT?!" with hpunch
    mc "G-G-GHJ-HW-O QUE?!" with hpunch

# game/script7.rpy:3292
translate brazil werewolveslabel_47f0ea46:

#   mc "Wha..."
    mc "O que..."

# game/script7.rpy:3293
translate brazil werewolveslabel_a9cbc624:

#   mc "L-Luna?"
    mc "L-A lua?"

# game/script7.rpy:3295
translate brazil werewolveslabel_d0cbaf98:

#   mc "Oh Jesus, you're okay! Thank goodness!" with dis12
    mc "Oh Jesus, você está bem! Graças a Deus!" with dis12

# game/script7.rpy:3296
translate brazil werewolveslabel_52b054e3:

#   mc "How did you manage to escape from the bandits?!"
    mc "Como você conseguiu escapar dos bandidos?!"

# game/script7.rpy:3298
translate brazil werewolveslabel_e4141312:

#   l "Bandits...?"
    l "Bandidos...?"

# game/script7.rpy:3299
translate brazil werewolveslabel_9cfaceb7:

#   l "What bandits?"
    l "Que bandidos?"

# game/script7.rpy:3301
translate brazil werewolveslabel_6b0ed824:

#   mc "Um..."
    mc "Um..."

# game/script7.rpy:3302
translate brazil werewolveslabel_c3e99829:

#   mc "*Clears throat* Y-Yeah, for some reason I assumed you'd been captured by a group of thugs. I'm not sure why."
    mc "*Limpa a garganta* S-Sim, por algum motivo presumi que você tivesse sido capturado por um grupo de bandidos. Não sei por quê."

# game/script7.rpy:3303
translate brazil werewolveslabel_691473ee:

#   mc "But in any case, I'm relieved to see you're alright!"
    mc "Mas de qualquer forma, estou aliviado em ver que você está bem!"

# game/script7.rpy:3305
translate brazil werewolveslabel_0a1cb5f3:

#   l "Thanks! I'm glad to see you too!"
    l "Obrigado! Estou feliz em ver você também!"

# game/script7.rpy:3307
translate brazil werewolveslabel_3de9f3bc:

#   mc "How did you find me so fast?"
    mc "Como você me encontrou tão rápido?"

# game/script7.rpy:3309
translate brazil werewolveslabel_41db7178:

#   l "Well, you're... quite noisy."
    l "Bem, você é... muito barulhento."

# game/script7.rpy:3310
translate brazil werewolveslabel_c1adc9ff:

#   l "And the Lumina spell you cast can actually be spotted from a mile away."
    l "E o feitiço Lumina que você lança pode ser localizado a um quilômetro de distância."

# game/script7.rpy:3312
translate brazil werewolveslabel_d27216e2:

#   mc "Oh. Y-Yeah, that's fair."
    mc "Oh. S-Sim, isso é justo."

# game/script7.rpy:3313
translate brazil werewolveslabel_24c2f971:

#   mc "I definitely can't say the same about you, you’re quieter than a black cat on a moonlit rooftop."
    mc "Definitivamente não posso dizer o mesmo de você, você é mais quieto que um gato preto em um telhado iluminado pela lua."

# game/script7.rpy:3316
translate brazil werewolveslabel_4512289e:

#   l "But why are you here?"
    l "Mas por que você está aqui?"

# game/script7.rpy:3317
translate brazil werewolveslabel_c19233f9:

#   l "I thought you were supposed to stay in Hollowbrook."
    l "Achei que você deveria ficar em Hollowbrook."

# game/script7.rpy:3322
translate brazil werewolveslabel_03ae9155:

#   mc "I know, but I got bored and thought I would come your way to see those werewolves." with dissolve
    mc "Eu sei, mas fiquei entediado e pensei em ir até você ver aqueles lobisomens." with dissolve

# game/script7.rpy:3324
translate brazil werewolveslabel_42ba91e0:

#   mc "I know, but I was missing you, so I decided to come your way." with dissolve
    mc "Eu sei, mas estava sentindo sua falta, então decidi vir em sua direção." with dissolve

# game/script7.rpy:3325
translate brazil werewolveslabel_f25fc251:

#   mc "I don't know, playing Eternum without you isn't the same."
    mc "Não sei, jogar Eternum sem você não é a mesma coisa."

# game/script7.rpy:3330
translate brazil werewolveslabel_17591098:

#   l "Oh... thank you." with dis15
    l "Ah... obrigado." with dis15

# game/script7.rpy:3331
translate brazil werewolveslabel_7d59f440:

#   l "I... miss you too when you're not around."
    l "Eu... também sinto sua falta quando você não está por perto."

# game/script7.rpy:3333
translate brazil werewolveslabel_32b8e993:

#   mc "*Chuckles* The feeling is definitely mutual."
    mc "*Risos* O sentimento é definitivamente mútuo."

# game/script7.rpy:3335
translate brazil werewolveslabel_007aa51b:

#   l "Sorry if I've been more distant lately. Between my dad's cafe and the upcoming exams, I've barely had any free time."
    l "Desculpe se tenho estado mais distante ultimamente. Entre o café do meu pai e as próximas provas, quase não tive tempo livre."

# game/script7.rpy:3337
translate brazil werewolveslabel_1f91c16a:

#   mc "No worries! Both Annie and Dalia have been hitting the books like crazy too, whenever they weren't in Eternum."
    mc "Sem problemas! Tanto Annie quanto Dalia também têm ido aos livros como loucas, sempre que não estavam em Eternum."

# game/script7.rpy:3339
translate brazil werewolveslabel_b3fc63a4:

#   l "I should have more chill time once these exams are over."
    l "Eu deveria ter mais tempo para relaxar quando esses exames terminarem."

# game/script7.rpy:3340
translate brazil werewolveslabel_06d79a3d:

#   l "We can hang out more then."
    l "Podemos sair mais então."

# game/script7.rpy:3341
translate brazil werewolveslabel_4f5f816a:

#   l "If you want."
    l "Se você quiser."

# game/script7.rpy:3343
translate brazil werewolveslabel_ebce52f3:

#   mc "I'd love to!"
    mc "Eu adoraria!"

# game/script7.rpy:3345
translate brazil werewolveslabel_1d75234e:

#   l "Cool."
    l "Legal."

# game/script7.rpy:3346
translate brazil werewolveslabel_1042d646:

#   l "I'll text you."
    l "Vou mandar uma mensagem para você."

# game/script7.rpy:3348
translate brazil werewolveslabel_9c6cdcea:

#   mc "Looking forward to it!"
    mc "Estou ansioso por isso!"

# game/script7.rpy:3350
translate brazil werewolveslabel_f22ca94c:

#   l "But anyway, let's focus on the werewolves for now."
    l "Mas de qualquer forma, vamos nos concentrar nos lobisomens por enquanto."

# game/script7.rpy:3352
translate brazil werewolveslabel_eb426ba7:

#   mc "Oh, for sure. Can't wait to face off against a real werewolf!"
    mc "Ah, com certeza. Mal posso esperar para enfrentar um lobisomem de verdade!"

# game/script7.rpy:3354
translate brazil werewolveslabel_1221e538:

#   mc "I know, but then I thought you'd be in danger on your own, so I came your way to lend a hand." with dissolve
    mc "Eu sei, mas pensei que você estaria em perigo sozinho, então vim até você para ajudar." with dissolve

# game/script7.rpy:3356
translate brazil werewolveslabel_09a213eb:

#   l "Oh... thank you."
    l "Ah... obrigado."

# game/script7.rpy:3357
translate brazil werewolveslabel_5be9c014:

#   l "Although I should be alright."
    l "Embora eu devesse estar bem."

# game/script7.rpy:3358
translate brazil werewolveslabel_7f459704:

#   l "I've faced tougher things in Eternum."
    l "Já enfrentei coisas mais difíceis em Eternum."

# game/script7.rpy:3360
translate brazil werewolveslabel_bda7f88f:

#   mc "Have you ever run into a werewolf in Ekabar before?"
    mc "Você já encontrou um lobisomem em Ekabar antes?"

# game/script7.rpy:3362
translate brazil werewolveslabel_77f5cc68:

#   l "I haven't, but I've heard some tales."
    l "Não, mas ouvi algumas histórias."

# game/script7.rpy:3364
translate brazil werewolveslabel_72b15e4e:

#   mc "They've always struck me as intriguing."
    mc "Eles sempre me pareceram intrigantes."

# game/script7.rpy:3365
translate brazil werewolveslabel_e32637d6:

#   mc "But, I imagine they must be quite terrifying."
    mc "Mas imagino que devam ser bastante assustadores."

# game/script7.rpy:3368
translate brazil werewolveslabel_a37705ec:

#   mc "I got bored in Hollowbrook, so I decided to come your way to see those werewolves."
    mc "Fiquei entediado em Hollowbrook, então decidi ir até você para ver aqueles lobisomens."

# game/script7.rpy:3369
translate brazil werewolveslabel_674ddcdd:

#   mc "Well... if they're even real."
    mc "Bem... se eles são reais."

# game/script7.rpy:3370
translate brazil werewolveslabel_c1a3bd5c:

#   mc "I mean, I haven't really seen anything strange on my way here, have you?"
    mc "Quero dizer, eu realmente não vi nada de estranho no caminho até aqui, e você?"

# game/script7.rpy:3371
translate brazil werewolveslabel_8e98fd2d:

#   mc "Maybe there are no vampires either... maybe it's all part of a collective hysteria, stories spun from too much mead and wild imaginations."
    mc "Talvez também não existam vampiros... talvez seja tudo parte de uma histeria coletiva, histórias criadas a partir de muito hidromel e imaginação selvagem."

# game/script7.rpy:3374
translate brazil werewolveslabel_5ab97586:

#   l "*Moving in closer* Well, there {i}is{/i} something, of that I'm sure." with dis15
    l "*Aproximando-se* Bem, {i}há{/i} alguma coisa, disso eu tenho certeza." with dis15

# game/script7.rpy:3375
translate brazil werewolveslabel_575ecaa7:

#   l "Even if it's not werewolves, there's definitely some big stuff roaming around here."
    l "Mesmo que não sejam lobisomens, definitivamente há coisas grandes vagando por aqui."

# game/script7.rpy:3376
translate brazil werewolveslabel_63a8f86f:

#   l "Do you see that courtyard?"
    l "Você vê aquele pátio?"

# game/script7.rpy:3377
translate brazil werewolveslabel_f42fce5f:

#   mc "Yeah, I was looking at it before."
    mc "Sim, eu estava olhando para isso antes."

# game/script7.rpy:3378
translate brazil werewolveslabel_7ae73ea8:

#   l "I sent the owl I summoned to do a quick flyby, and it reported back some seriously hefty footprints over there."
    l "Mandei a coruja que convoquei para fazer um sobrevôo rápido, e ela relatou algumas pegadas bem pesadas por lá."

# game/script7.rpy:3380
translate brazil werewolveslabel_7966a5b5:

#   mc "Hmm... well, we can't really leave without investigating the area, so... there's only one way to go, if you ask me." with dis
    mc "Hmm... bem, não podemos sair sem investigar a área, então... só há um caminho a percorrer, se você me perguntar." with dis

# game/script7.rpy:3381
translate brazil werewolveslabel_b4654297:

#   mc "Let's make our way to the courtyard and then back to Hollowbrook? Reaching this place took me longer than expected."
    mc "Vamos para o pátio e depois voltamos para Hollowbrook? Chegar a este lugar demorou mais do que o esperado."

# game/script7.rpy:3382
translate brazil werewolveslabel_9a9b3c01:

#   mc "Penny might be on her way back too."
    mc "Penny pode estar voltando também."

# game/script7.rpy:3384
translate brazil werewolveslabel_3f1f199b:

#   l "Sounds good." with dis
    l "Parece bom." with dis

# game/script7.rpy:3385
translate brazil werewolveslabel_cfd518f9:

#   l "Just be careful when descending this wall, the rocks are quite slippery."
    l "Só tome cuidado ao descer esta parede, as pedras são bastante escorregadias."

# game/script7.rpy:3386
translate brazil werewolveslabel_f0c54518:

#   mc "Gotcha."
    mc "Entendi."

# game/script7.rpy:3392
translate brazil werewolveslabel_e6b963f2:

#   bla "You and Luna carefully climb down the steep slope that leads to the fortress entrance." with dis14
    bla "Você e Luna descem cuidadosamente a encosta íngreme que leva à entrada da fortaleza." with dis14

# game/script7.rpy:3393
translate brazil werewolveslabel_f1b9e1d3:

#   l "This place is so quiet."
    l "Este lugar é tão tranquilo."

# game/script7.rpy:3394
translate brazil werewolveslabel_bc2bc562:

#   mc "Yeah, and that freaks me out so much..."
    mc "Sim, e isso me assusta muito..."

# game/script7.rpy:3395
translate brazil werewolveslabel_9a77be78:

#   mc "Keep an eye out."
    mc "Fique de olho."

# game/script7.rpy:3398
translate brazil werewolveslabel_3515ef9e:

#   bla "You make your way to the courtyard you spotted earlier, yet you encounter nothing but dust, and silence." with dis12
    bla "Você segue até o pátio que viu anteriormente, mas não encontra nada além de poeira e silêncio." with dis12

# game/script7.rpy:3399
translate brazil werewolveslabel_f434fd21:

#   l "Nothing."
    l "Nada."

# game/script7.rpy:3400
translate brazil werewolveslabel_1c19219d:

#   l "Perhaps the werewolves are gone for good?"
    l "Talvez os lobisomens tenham ido embora para sempre?"

# game/script7.rpy:3401
translate brazil werewolveslabel_968bd010:

#   mc "Or maybe they were captured by a group of poachers."
    mc "Ou talvez tenham sido capturados por um grupo de caçadores furtivos."

# game/script7.rpy:3402
translate brazil werewolveslabel_abde89d7:

#   mc "And then abandoned."
    mc "E então abandonado."

# game/script7.rpy:3403
translate brazil werewolveslabel_95b50afe:

#   l "Could be."
    l "Poderia ser."

# game/script7.rpy:3405
translate brazil werewolveslabel_f1bdedd3:

#   bla "You hear a noise coming from behind you."
    bla "Você ouve um barulho vindo de trás de você."

# game/script7.rpy:3409
translate brazil werewolveslabel_4f727dee:

#   mc "H-Hey!" with hpunch
    mc "E-Ei!" with hpunch

# game/script7.rpy:3410
translate brazil werewolveslabel_77bd2f24:

#   l "What happened?"
    l "O que aconteceu?"

# game/script7.rpy:3411
translate brazil werewolveslabel_0a28d0e5:

#   mc "I... I heard something."
    mc "Eu... eu ouvi algo."

# game/script7.rpy:3412
translate brazil werewolveslabel_37ca2c84:

#   l "Maybe the wind?"
    l "Talvez o vento?"

# game/script7.rpy:3413
translate brazil werewolveslabel_cc761816:

#   mc "No..."
    mc "Não..."

# game/script7.rpy:3414
translate brazil werewolveslabel_cc49b579:

#   mc "We're not alone here..."
    mc "Não estamos sozinhos aqui..."

# game/script7.rpy:3415
translate brazil werewolveslabel_f08b3080:

#   l "*Pointing at the door* Let's check inside."
    l "*Apontando para a porta* Vamos verificar lá dentro."

# game/script7.rpy:3417
translate brazil werewolveslabel_7fef7511:

#   mc "Inside? Are you sure?" with Dissolve(1.9)
    mc "Dentro? Tem certeza?" with Dissolve(1.9)

# game/script7.rpy:3418
translate brazil werewolveslabel_bc5c265b:

#   l "Yes."
    l "Sim."

# game/script7.rpy:3419
translate brazil werewolveslabel_1cf3306a:

#   l "If there are really monsters here... there's something I need to see."
    l "Se realmente há monstros aqui... há algo que preciso ver."

# game/script7.rpy:3420
translate brazil werewolveslabel_9c6822d9:

#   mc "*Gulps* Alright then... but stay close."
    mc "*Gulps* Tudo bem então... mas fique por perto."

# game/script7.rpy:3421
translate brazil werewolveslabel_2b4a3315:

#   mc "We don't know what kinds of traps we might find."
    mc "Não sabemos que tipos de armadilhas poderemos encontrar."

# game/script7.rpy:3424
translate brazil werewolveslabel_d2455d53:

#   wer ". . ." with dis12
    wer ". . ." with dis12

# game/script7.rpy:3428
translate brazil werewolveslabel_67f3d118:

#   wer "*Howls*" with dis2
    wer "*Uivos*" with dis2

# game/script7.rpy:3431
translate brazil werewolveslabel_cd750bb7:

#   mc "D-Did you hear that? It sounded way closer this time." with dis17
    mc "D-Você ouviu isso? Parecia muito mais perto desta vez." with dis17

# game/script7.rpy:3432
translate brazil werewolveslabel_2c8663eb:

#   l "Definitely..."
    l "Definitivamente..."

# game/script7.rpy:3433
translate brazil werewolveslabel_515cf8cb:

#   mc "Let's get out of here, it's not worth staying here just to win favor with the hunters."
    mc "Vamos sair daqui, não vale a pena ficar aqui só para ganhar o favor dos caçadores."

# game/script7.rpy:3434
translate brazil werewolveslabel_fa7f70f8:

#   mc "Follow m–"
    mc "Siga m–"

# game/script7.rpy:3442
translate brazil werewolveslabel_7ec07863:

#   bla "As you turn around, a colossal creature almost the size of a car plummets from the stone arch above." with dis22
    bla "Quando você se vira, uma criatura colossal, quase do tamanho de um carro, cai do arco de pedra acima." with dis22

# game/script7.rpy:3445
translate brazil werewolveslabel_a163a235:

#   mc "H-Holy shit, THAT is big..." with dis17
    mc "H-Puta merda, ISSO é grande..." with dis17

# game/script7.rpy:3446
translate brazil werewolveslabel_f4a397b4:

#   l "[mc]...?"
    l "[mc]...?"

# game/script7.rpy:3450
translate brazil werewolveslabel_5e17e361:

#   bla "Another werewolf, as big as the first one, appears on the other side of the courtyard, blocking the only two possible exits." with dis17
    bla "Outro lobisomem, tão grande quanto o primeiro, aparece do outro lado do pátio, bloqueando as duas únicas saídas possíveis." with dis17

# game/script7.rpy:3451
translate brazil werewolveslabel_f1ee9653:

#   mc "F-Fuck..."
    mc "F-Foda-se..."

# game/script7.rpy:3456
translate brazil werewolveslabel_e9f8797d:

#   mc "W-Well, looks like the rumors were true after all..." with dis
    mc "B-Bem, parece que os rumores eram verdadeiros, afinal..." with dis

# game/script7.rpy:3458
translate brazil werewolveslabel_e72ce3e2:

#   mc "Can you... understand my words?"
    mc "Você consegue... entender minhas palavras?"

# game/script7.rpy:3459
translate brazil werewolveslabel_b97569c7:

#   mc "We mean you no harm. We can leave as quietly as we arrived."
    mc "Não queremos fazer mal a você. Podemos partir tão silenciosamente quanto chegamos."

# game/script7.rpy:3461
translate brazil werewolveslabel_37f70ea2:

#   bla "The creature looks at you menacingly, growling and arching its back."
    bla "A criatura olha para você ameaçadoramente, rosnando e arqueando as costas."

# game/script7.rpy:3465
translate brazil werewolveslabel_133360fc:

#   mc "So you're nothing but mindless animals? Fine." with dis15
    mc "Então vocês não passam de animais irracionais? Multar." with dis15

# game/script7.rpy:3466
translate brazil werewolveslabel_31c0aca0:

#   mc "Let's see who's faster, you monsters."
    mc "Vamos ver quem é mais rápido, seus monstros."

# game/script7.rpy:3467
translate brazil werewolveslabel_e9794b11:

#   mct "I need to find a way to defend myself while ensuring Luna's safety."
    mct "Preciso encontrar uma maneira de me defender e ao mesmo tempo garantir a segurança de Luna."

# game/script7.rpy:3468
translate brazil werewolveslabel_73dd560d:

#   mct "She's my priority, even if it means..."
    mct "Ela é minha prioridade, mesmo que isso signifique..."

# game/script7.rpy:3469
translate brazil werewolveslabel_ea579cea:

#   l "Wait!"
    l "Espere!"

# game/script7.rpy:3471
translate brazil werewolveslabel_05500ff6:

#   mc "Huh?"
    mc "Huh?"

# game/script7.rpy:3473
translate brazil werewolveslabel_8740524a:

#   l "Don't attack them!"
    l "Não os ataque!"

# game/script7.rpy:3475
translate brazil werewolveslabel_7cdfd67c:

#   mc "What? Why not?"
    mc "O que? Por que não?"

# game/script7.rpy:3477
translate brazil werewolveslabel_23c6aef5:

#   l "They won't harm us if we don't provoke them."
    l "Eles não nos farão mal se não os provocarmos."

# game/script7.rpy:3479
translate brazil werewolveslabel_102aa7ae:

#   mc "W-What?"
    mc "O-o quê?"

# game/script7.rpy:3480
translate brazil werewolveslabel_88a7f69c:

#   mc "How are you so sure?"
    mc "Como você tem tanta certeza?"

# game/script7.rpy:3482
translate brazil werewolveslabel_07e540f7:

#   l "Trust me!"
    l "Confie em mim!"

# game/script7.rpy:3484
translate brazil werewolveslabel_487784d4:

#   mc "*Observing the beast* Um..." with dis12
    mc "*Observando a fera* Hum..." with dis12

# game/script7.rpy:3485
translate brazil werewolveslabel_50d55824:

#   mc "I've seen enough National Geographic documentaries to know that's not a friendly stance, Luna."
    mc "Já vi documentários suficientes da National Geographic para saber que essa não é uma postura amigável, Luna."

# game/script7.rpy:3487
translate brazil werewolveslabel_2bb66f6f:

#   l "Please, don't attack them!"
    l "Por favor, não os ataque!"

# game/script7.rpy:3488
translate brazil werewolveslabel_557ceeb1:

#   l "And don't speak!"
    l "E não fale!"

# game/script7.rpy:3489
translate brazil werewolveslabel_7fc74390:

#   l "You have to trust me!"
    l "Você tem que confiar em mim!"

# game/script7.rpy:3491
translate brazil werewolveslabel_8114a09f:

#   mc "Uh..."
    mc "Uh..."

# game/script7.rpy:3492
translate brazil werewolveslabel_8f2e6d14:

#   mc "O-Okay, I trust you."
    mc "O-Ok, eu confio em você."

# game/script7.rpy:3493
translate brazil werewolveslabel_616f4930:

#   mc "I hope we don't regret this..."
    mc "Espero que não nos arrependamos disso..."

# game/script7.rpy:3497
translate brazil werewolveslabel_6bda2715:

#   bla "The werewolf in front of Luna takes a small step, preparing to attack." with dis2
    bla "O lobisomem na frente de Luna dá um pequeno passo, preparando-se para atacar." with dis2

# game/script7.rpy:3499
translate brazil werewolveslabel_ee4c03a7:

#   wer2 ". {w=0.25}. {w=0.25}.{w=0.25}{nw}"
    wer2 ". {w=0.25}. {w=0.25}.{w=0.25}{nw}"

