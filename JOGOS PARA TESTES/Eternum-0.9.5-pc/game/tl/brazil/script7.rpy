translate brazil morninghollow_10586662:

#   bla "You dedicate several hours to searching for Penelope, but with no success. Eventually, the sun rises and you find yourself back at a small set of ruins you saw when you first arrived." with dis12
    bla "Você dedica várias horas procurando Penélope, mas sem sucesso. Eventualmente, o sol nasce e você se encontra de volta a um pequeno conjunto de ruínas que viu quando chegou." with dis12

# game/script7.rpy:6672
translate brazil morninghollow_94de562f:

#   mct "Fuck... she’s nowhere to be found. Where the hell are you, Penny?"
    mct "Porra... ela não está em lugar nenhum. Onde diabos você está, Penny?"

# game/script7.rpy:6673
translate brazil morninghollow_3820f3be:

#   mc "*Sighs* (At least I saw the hunters searching for both Penny and Luna during the whole night.)"
    mc "*Suspiros* (Pelo menos eu vi os caçadores procurando por Penny e Luna durante toda a noite.)"

# game/script7.rpy:6674
translate brazil morninghollow_9b7d573a:

#   mct "I guess that's a good sign. It means they didn't find them either."
    mct "Acho que é um bom sinal. Isso significa que eles também não os encontraram."

# game/script7.rpy:6675
translate brazil morninghollow_218d7725:

#   mct "Or so I hope."
    mct "Ou assim espero."

# game/script7.rpy:6676
translate brazil morninghollow_c3477187:

#   l "[mc]?"
    l "[mc]?"

# game/script7.rpy:6678
translate brazil morninghollow_043873f3:

#   bla "You dedicate several hours to searching for Luna, but with no success. Eventually the sun rises and you find yourself back at a small set of ruins you saw when you first arrived." with dis12
    bla "Você dedica várias horas procurando Luna, mas sem sucesso. Eventualmente, o sol nasce e você se encontra de volta a um pequeno conjunto de ruínas que viu quando chegou." with dis12

# game/script7.rpy:6679
translate brazil morninghollow_e3d3f42c:

#   mct "Fuck... she wasn't by the church or the windmill."
    mct "Porra... ela não estava perto da igreja ou do moinho de vento."

# game/script7.rpy:6680
translate brazil morninghollow_5d0319ad:

#   mct "Maybe I should have tried looking somewhere else...? She didn't mention any other meeting spot, right...?"
    mct "Talvez eu devesse ter tentado procurar em outro lugar...? Ela não mencionou nenhum outro ponto de encontro, certo...?"

# game/script7.rpy:6681
translate brazil morninghollow_bf00b671:

#   mct "AGHHH, I should have paid more attention!" with hpunch
    mct "AGHHH, eu deveria ter prestado mais atenção!" with hpunch

# game/script7.rpy:6682
translate brazil morninghollow_da5ae6b7:

#   mct "And now I'm nearly back at the Exit Portal, and there's still no sign of anyone here!"
    mct "E agora estou quase de volta ao Portal de Saída e ainda não há sinal de ninguém aqui!"

# game/script7.rpy:6683
translate brazil morninghollow_67485488:

#   mct "What if something happened to them?"
    mct "E se algo acontecesse com eles?"

# game/script7.rpy:6684
translate brazil morninghollow_ac522cf5:

#   mct "Shit, did I really fail them?!"
    mct "Merda, eu realmente falhei com eles?!"

# game/script7.rpy:6685
translate brazil morninghollow_480beab8:

#   mct "Did I let them die?!!" with hpunch
    mct "Eu os deixei morrer?!!" with hpunch

# game/script7.rpy:6686
translate brazil morninghollow_74d1a22f:

#   mct "DID I–" with hpunch
    mct "Eu-" with hpunch

# game/script7.rpy:6687
translate brazil morninghollow_69f5f20d:

#   l "Hey [mc]."
    l "Ei, [mc]."

# game/script7.rpy:6689
translate brazil morninghollow_b27d71ee:

#   mc "*Turning around* Huh?" with dis
    mc "*Virando-se* Hein?" with dis

# game/script7.rpy:6690
translate brazil morninghollow_07548bae:

#   mc "LUNA!" with hpunch
    mc "LUA!" with hpunch

# game/script7.rpy:6692
translate brazil morninghollow_b6beda22:

#   mc "So good to see you!"
    mc "Que bom ver você!"

# game/script7.rpy:6694
translate brazil morninghollow_52e92ac9:

#   l "What are you still doing here?"
    l "O que você ainda está fazendo aqui?"

# game/script7.rpy:6695
translate brazil morninghollow_ad93a22e:

#   l "I thought you were supposed to find Penny and leave the server."
    l "Achei que você deveria encontrar Penny e sair do servidor."

# game/script7.rpy:6697
translate brazil morninghollow_520163f1:

#   mc "That's the problem – I couldn't find her!"
    mc "Esse é o problema – não consegui encontrá-la!"

# game/script7.rpy:6698
translate brazil morninghollow_6062ac80:

#   mc "I've been looking for her for hours, but she's M.I.A.!"
    mc "Estou procurando por ela há horas, mas ela está desaparecida!"

# game/script7.rpy:6699
translate brazil morninghollow_c5999c2c:

#   mc "*Sighs* But at least you’re safe! Definitely a sight for sore eyes!"
    mc "*Suspiros* Mas pelo menos você está seguro! Definitivamente um colírio para os olhos!"

# game/script7.rpy:6701
translate brazil morninghollow_7884fd3c:

#   mc "Thank god, are you okay?!"
    mc "Graças a Deus, você está bem?!"

# game/script7.rpy:6702
translate brazil morninghollow_f16e720a:

#   mc "I was so worried!"
    mc "Eu estava tão preocupado!"

# game/script7.rpy:6704
translate brazil morninghollow_a7dc4d8f:

#   l "Yeah, I'm alright."
    l "Sim, estou bem."

# game/script7.rpy:6705
translate brazil morninghollow_211793b0:

#   l "No worries."
    l "Sem problemas."

# game/script7.rpy:6707
translate brazil morninghollow_62c71050:

#   mc "Oof, thank god."
    mc "Ufa, graças a Deus."

# game/script7.rpy:6708
translate brazil morninghollow_136f2994:

#   mc "Where have you been?"
    mc "Onde você esteve?"

# game/script7.rpy:6710
translate brazil morninghollow_d586ed46:

#   l "I've been hiding in the old barn, waiting for the sun to come up so I could avoid the hunter patrols."
    l "Estive me escondendo no velho celeiro, esperando o sol nascer para poder evitar as patrulhas de caçadores."

# game/script7.rpy:6712
translate brazil morninghollow_eeb916e4:

#   mc "The old barn! I knew it!"
    mc "O velho celeiro! Eu sabia!"

# game/script7.rpy:6713
translate brazil morninghollow_fb3ba338:

#   mc "W-Well, I didn't, but I wish I had known."
    mc "Bem, não sabia, mas gostaria de ter sabido."

# game/script7.rpy:6714
translate brazil morninghollow_b05f7349:

#   mc "But anyway, I'm glad to see you're safe."
    mc "Mas de qualquer forma, fico feliz em ver que você está seguro."

# game/script7.rpy:6716
translate brazil morninghollow_cd87a2a4:

#   l "Yeah."
    l "Sim."

# game/script7.rpy:6718
translate brazil morninghollow_e16f2e73:

#   mct "Hmm..."
    mct "Hum..."

# game/script7.rpy:6719
translate brazil morninghollow_22eeac03:

#   mct "Her smile seems a bit off today."
    mct "Seu sorriso parece um pouco estranho hoje."

# game/script7.rpy:6721
translate brazil morninghollow_d4c6a23e:

#   mc "Did anything happen while you waited in that barn?"
    mc "Aconteceu alguma coisa enquanto você esperava naquele celeiro?"

# game/script7.rpy:6722
translate brazil morninghollow_c4184c5f:

#   mc "You know you can tell me anything."
    mc "Você sabe que pode me contar qualquer coisa."

# game/script7.rpy:6724
translate brazil morninghollow_60c88278:

#   mc "You sure everything's cool, though?"
    mc "Tem certeza que está tudo bem?"

# game/script7.rpy:6726
translate brazil morninghollow_3916e89c:

#   mc "If something happened..."
    mc "Se algo aconteceu..."

# game/script7.rpy:6728
translate brazil morninghollow_4c48bbeb:

#   l "I know!"
    l "Eu sei!"

# game/script7.rpy:6729
translate brazil morninghollow_414e9622:

#   l "But everything is okay, I swear!"
    l "Mas está tudo bem, eu juro!"

# game/script7.rpy:6730
translate brazil morninghollow_caf530b6:

#   l "I'm just tired, that's all."
    l "Estou apenas cansado, só isso."

# game/script7.rpy:6732
translate brazil morninghollow_67af8fbd:

#   mct "Well, that actually makes sense."
    mct "Bem, isso realmente faz sentido."

# game/script7.rpy:6733
translate brazil morninghollow_8cec8d91:

#   mc "Alright... okay then!"
    mc "Tudo bem... ok então!"

# game/script7.rpy:6734
translate brazil morninghollow_ebfe863e:

#   mc "I'll take your word for it."
    mc "Vou acreditar na sua palavra."

# game/script7.rpy:6735
translate brazil morninghollow_3e39220f:

#   mct "Sometimes it's hard to know what's inside Luna's mind."
    mct "Às vezes é difícil saber o que se passa na mente de Luna."

# game/script7.rpy:6736
translate brazil morninghollow_9e286c5c:

#   mc "*Sighs* Now we're just missing Penny."
    mc "*Suspiros* Agora só estamos sentindo falta de Penny."

# game/script7.rpy:6738
translate brazil morninghollow_54c25c46:

#   mc "Do you think we should–{w=1}{nw}"
    mc "Você acha que deveríamos–{w=1}{nw}"

# game/script7.rpy:6745
translate brazil morninghollow_c2c46833:

#   p "{sc=2}GUUUUUUYYSSS!!!{/sc}" with hpunch
    p "{sc=2}GUUUUUUYSSSS!!!{/sc}" with hpunch

# game/script7.rpy:6746
translate brazil morninghollow_765966e0:

#   l "Penny!"
    l "Centavo!"

# game/script7.rpy:6747
translate brazil morninghollow_5e3a8ead:

#   mc "W-Whoa!"
    mc "U-Uau!"

# game/script7.rpy:6749
translate brazil morninghollow_07f70a45:

#   mc "Speaking of the devil! It's so good to see you!" with dis
    mc "Falando no diabo! É tão bom ver você!" with dis

# game/script7.rpy:6750
translate brazil morninghollow_cafb8e5c:

#   p "Oh my god, I was so worried!"
    p "Oh meu Deus, eu estava tão preocupado!"

# game/script7.rpy:6751
translate brazil morninghollow_af9b212a:

#   p "I thought something terrible had happened to you!"
    p "Achei que algo terrível tivesse acontecido com você!"

# game/script7.rpy:6752
translate brazil morninghollow_520eb91d:

#   mc "We were the worried ones!"
    mc "Nós éramos os preocupados!"

# game/script7.rpy:6753
translate brazil morninghollow_1612048c:

#   mc "Have you been here the whole time?"
    mc "Você esteve aqui o tempo todo?"

# game/script7.rpy:6756
translate brazil morninghollow_aa70fbdb:

#   p "*Dismounting you* Not at all!" with hpunch
    p "*Desmontando você* De jeito nenhum!" with hpunch

# game/script7.rpy:6757
translate brazil morninghollow_02c4e86b:

#   p "So much has happened that I couldn't possibly cover it all!"
    p "Tanta coisa aconteceu que eu não conseguiria cobrir tudo!"

# game/script7.rpy:6759
translate brazil morninghollow_fd2563c6:

#   l "Tell us the short version, then!"
    l "Conte-nos a versão curta, então!"

# game/script7.rpy:6761
translate brazil morninghollow_8d1402ab:

#   p "Short version...? OKAY! Yeah, short version!"
    p "Versão curta...? OK! Sim, versão curta!"

# game/script7.rpy:6764
translate brazil morninghollow_1bc7f951:

#   p "*Takes a deep breath*{w=0.8}{nw}"
    p "*Respira fundo*{w=0.8}{nw}"

# game/script7.rpy:6767
translate brazil morninghollow_ebf29026:

#   p "OkayrememberwhenwesplitintownandIwenttofindthosevampiresright?!"
    p "Ok, lembra quando nos separamos na cidade e fui encontrar aqueles vampiros, certo?!"

# game/script7.rpy:6769
translate brazil morninghollow_2f3c51f3:

#   mc "W-What?" with hpunch
    mc "O-o quê?" with hpunch

# game/script7.rpy:6770
translate brazil morninghollow_66c4f07b:

#   mc "Breathe and don't speak so fast!"
    mc "Respire e não fale tão rápido!"

# game/script7.rpy:6771
translate brazil morninghollow_fb099ffd:

#   p "Mm-hm!"
    p "Hum-hm!"

# game/script7.rpy:6773
translate brazil morninghollow_49c935b2:

#   p "O-Okay."
    p "Ok."

# game/script7.rpy:6774
translate brazil morninghollow_f0158264:

#   p "So, as I was saying, I went to find those vampires, and..."
    p "Então, como eu estava dizendo, fui procurar aqueles vampiros e..."

# game/script7.rpy:6777
translate brazil morninghollow_ca52e744:

#   p "THEN I stumble upon this old cemetery, creepy monsters everywhere, when suddenly whoop, there's [mc]!"
    p "ENTÃO eu me deparo com um cemitério antigo, monstros assustadores por toda parte, quando de repente, opa, lá está [mc]!"

# game/script7.rpy:6778
translate brazil morninghollow_7d818ef8:

#   p "We meet Lord Iliescu, nice talk, good people, zip back to Hollowbrook, but wait! [mc] hears someone tailing us, so we split again!"
    p "Conhecemos Lord Iliescu, boa conversa, gente boa, voltamos para Hollowbrook, mas espere! [mc] ouve alguém nos seguindo, então nos separamos novamente!"

# game/script7.rpy:6780
translate brazil morninghollow_2d6bef9a:

#   p "THEN I stumble upon this old cemetery, dark, scary, creepy monsters everywhere, yes? But WAIT because in the same place I also meet Lord Iliescu, his wife, and this cool butler Mortimer – good folks!"
    p "ENTÃO eu tropeço neste antigo cemitério, monstros sombrios, assustadores e assustadores por toda parte, certo? Mas ESPERE porque no mesmo lugar também conheci Lord Iliescu, sua esposa, e esse mordomo bacana Mortimer – gente boa!"

# game/script7.rpy:6781
translate brazil morninghollow_77466184:

#   p "Lysandra sniffs my tits, they're like, “yo, want some drink?” Not blood, just wine! Had a chat, said bye-bye, zoomed back to Hollowbrook!"
    p "Lysandra cheira meus seios e eles dizem, \"ei, quer um pouco de bebida?\" Não sangue, apenas vinho! Conversei, disse tchau, voltei para Hollowbrook!"

# game/script7.rpy:6782
translate brazil morninghollow_24b9ceaf:

#   p "Then I get there, and I'm hearing these peeps talking about killing innocent centaurs, and I'm thinking, “man, these guys are nuts!”"
    p "Aí eu chego lá e ouço uma galera falando sobre matar centauros inocentes, e penso: \"cara, esses caras são malucos!\""

# game/script7.rpy:6783
translate brazil morninghollow_b7e4f824:

#   p "So I start looking for you, I can't find you anywhere, then, whoosh! I spy four dudes heading into the forest. I tail them, and I catch them trying to ambush a centaur family, with babies and everything!"
    p "Então começo a te procurar, não consigo te encontrar em lugar nenhum, então, whoosh! Vejo quatro caras indo para a floresta. Eu os sigo e os pego tentando emboscar uma família de centauros, com bebês e tudo mais!"

# game/script7.rpy:6784
translate brazil morninghollow_4d6ce012:

#   p "I'm like, “HEY!” – I shout it out loud. Centaurs hear me, hunters show themselves, chaos breaks out, hunters die, and the centaurs are all, “wow, thank you, come meet the king!” and I'm like “well, okay I guess.”"
    p "Eu fico tipo, \"EI!\" – eu grito bem alto. Os centauros me ouvem, os caçadores se mostram, o caos irrompe, os caçadores morrem e os centauros ficam todos, \"uau, obrigado, venha conhecer o rei!\" e eu digo \"bem, ok, eu acho.\""

# game/script7.rpy:6785
translate brazil morninghollow_e36f115d:

#   p "So, I tag along, and bam, meet the king, everyone's chilling, and then he's like “so, do you wanna be my queen?” and I'm like “whaaaaaat?”"
    p "Então, eu vou junto e bam, conheço o rei, todo mundo está relaxando, e então ele fica tipo \"então, você quer ser minha rainha?\" e eu fico tipo \"o quê?\""

# game/script7.rpy:6786
translate brazil morninghollow_740e483c:

#   p "And he's like “we can breed some half-human, half-horse lineage!” and I'm thinking, “but aren't centaurs already half-human, half-horse...?”"
    p "E ele disse \"podemos criar uma linhagem meio humana, meio cavalo!\" e estou pensando, \"mas os centauros já não são meio humanos, meio cavalos...?\""

# game/script7.rpy:6787
translate brazil morninghollow_102aa7ae:

#   mc "W-What?"
    mc "O-o quê?"

# game/script7.rpy:6788
translate brazil morninghollow_02c0c06c:

#   p "So anyway, that question distracts them and causes a huge debate, so I use it to sneak out, and I head back to town!"
    p "De qualquer forma, essa pergunta os distrai e causa um grande debate, então eu a uso para fugir e volto para a cidade!"

# game/script7.rpy:6789
translate brazil morninghollow_101e07b0:

#   p "Then I find this injured woman, I use restoration magic to patch her up, then bam! Her husband shows up, and I'm like, “ OH FUCK!”"
    p "Então eu encontro essa mulher ferida, uso magia de restauração para curá-la, então bam! O marido dela aparece e eu digo, \"OH, PORRA!\""

# game/script7.rpy:6790
translate brazil morninghollow_7df6e315:

#   p "But surprise, he's actually super grateful! They say Father Bakhar is crazy, they help me find a way out of town, and point me to this keep."
    p "Mas, surpresa, ele está super grato! Dizem que o Padre Bakhar é louco, ajudam-me a encontrar uma maneira de sair da cidade e indicam-me esta fortaleza."

# game/script7.rpy:6791
translate brazil morninghollow_9694da51:

#   p "I get here, no one's around. I wait ten minutes, meet a funny squirrel and a mushroom that I could swear moved, 5 more minutes, and..."
    p "Eu chego aqui, não tem ninguém por perto. Espero dez minutos, encontro um esquilo engraçado e um cogumelo que posso jurar que se mexeu, mais 5 minutos e..."

# game/script7.rpy:6793
translate brazil morninghollow_5c90e3b6:

#   p "BOOM! I finally find you both!" with hpunch
    p "BUM! Finalmente encontrei vocês dois!" with hpunch

# game/script7.rpy:6795
translate brazil morninghollow_32c2db2f:

#   mc "W-Wow."
    mc "Uau."

# game/script7.rpy:6796
translate brazil morninghollow_8a9fbaef:

#   mc "And did all of this happen... today?"
    mc "E tudo isso aconteceu... hoje?"

# game/script7.rpy:6797
translate brazil morninghollow_99672ab1:

#   p "Mm-hm."
    p "Hum-hm."

# game/script7.rpy:6798
translate brazil morninghollow_3769aeaf:

#   mc "H-Holy shit."
    mc "H-Puta merda."

# game/script7.rpy:6799
translate brazil morninghollow_ea1cacdb:

#   mc "*Laughs* Going on an adventure with you sure guarantees a wild ride."
    mc "*Risos* Partir em uma aventura com você certamente garante um passeio selvagem."

# game/script7.rpy:6801
translate brazil morninghollow_4edb2d0a:

#   l "The important thing is that you're safe and sound!"
    l "O importante é que você esteja são e salvo!"

# game/script7.rpy:6804
translate brazil morninghollow_4147a218:

#   p "Awww, thank you Luny!" with dis
    p "Ah, obrigado Luny!" with dis

# game/script7.rpy:6805
translate brazil morninghollow_8ef04ad7:

#   p "Your sweet voice always takes all of my stress away."
    p "Sua doce voz sempre tira todo o meu estresse."

# game/script7.rpy:6807
translate brazil morninghollow_4671db3c:

#   mct "Even if Penny doesn't realize it, she's had that same effect on Luna."
    mct "Mesmo que Penny não perceba, ela teve o mesmo efeito em Luna."

# game/script7.rpy:6808
translate brazil morninghollow_d79bc9b0:

#   mct "She looks a lot happier since she showed up."
    mct "Ela parece muito mais feliz desde que apareceu."

# game/script7.rpy:6809
translate brazil morninghollow_6f0a9e42:

#   p "But anyway, enough talking about myself! Tell me, how was your ride?"
    p "Mas de qualquer forma, chega de falar de mim! Me conta, como foi sua viagem?"

# game/script7.rpy:6812
translate brazil morninghollow_fae23060:

#   l "W-What ride?" with dissolve
    l "Q-Que passeio?" with dissolve

# game/script7.rpy:6813
translate brazil morninghollow_b451cd3b:

#   l "I didn't r-ride anything."
    l "Eu não andei em nada."

# game/script7.rpy:6814
translate brazil morninghollow_11ead26f:

#   l "I just..."
    l "Eu acabei de..."

# game/script7.rpy:6815
translate brazil morninghollow_251632a7:

#   l "We, uh, just..."
    l "Nós, ah, apenas..."

# game/script7.rpy:6817
translate brazil morninghollow_98a4cc9a:

#   mc "...we just hid in one of the town's buildings."
    mc "...acabamos de nos esconder em um dos prédios da cidade."

# game/script7.rpy:6818
translate brazil morninghollow_ffccdffe:

#   mc "There were a lot of hunters patrolling the streets, so we stayed put until dawn."
    mc "Havia muitos caçadores patrulhando as ruas, então ficamos parados até o amanhecer."

# game/script7.rpy:6820
translate brazil morninghollow_7fc0c9f9:

#   l "Y-Yeah! Exactly."
    l "S-Sim! Exatamente."

# game/script7.rpy:6821
translate brazil morninghollow_2bd79836:

#   l "It wasn't safe to venture out with them around."
    l "Não era seguro aventurar-se com eles por perto."

# game/script7.rpy:6824
translate brazil morninghollow_894c52b1:

#   l "We don't really have a cool story to tell like you."
    l "Nós realmente não temos uma história legal para contar como você."

# game/script7.rpy:6825
translate brazil morninghollow_5dd877a3:

#   l "I just hid in one of the town's buildings and stayed put until dawn to avoid the hunters patrolling."
    l "Eu apenas me escondi em um dos prédios da cidade e fiquei parado até o amanhecer para evitar a patrulha dos caçadores."

# game/script7.rpy:6827
translate brazil morninghollow_f9fcb0c7:

#   mc "Yeah, we regrouped here just a minute before you showed up."
    mc "Sim, nos reagrupamos aqui um minuto antes de você aparecer."

# game/script7.rpy:6829
translate brazil morninghollow_9f1e16e3:

