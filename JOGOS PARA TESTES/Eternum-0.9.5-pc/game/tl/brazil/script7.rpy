#   mc "Um... we're [mc] and Penelope."
    mc "Hum... nós somos [mc] e Penélope."

# game/script7.rpy:2741
translate brazil continuedaliapenny_600a505c:

#   mc "Nice to meet you."
    mc "Prazer em conhecê-lo."

# game/script7.rpy:2743
translate brazil continuedaliapenny_c4eb38dd:

#   ili "It feels refreshing to engage in conversation with someone other than Mortimer and my wife Lysa..."
    ili "É revigorante conversar com alguém que não seja Mortimer e minha esposa Lysa..."

# game/script7.rpy:2745
translate brazil continuedaliapenny_81996f06:

#   ili "Oh... I almost forgot. Lysandra? Where are you, my dear?" with dis14
    ili "Ah... quase esqueci. Lisandra? Onde você está, minha querida?" with dis14

# game/script7.rpy:2746
translate brazil continuedaliapenny_1c6743d9:

#   ili "We have guests."
    ili "Temos convidados."

# game/script7.rpy:2747
translate brazil continuedaliapenny_53b59b23:

#   mc "It's not necessary, really, we just–"
    mc "Não é necessário, realmente, nós apenas–"

# game/script7.rpy:2751
translate brazil continuedaliapenny_278b16c3:

#   ili2 "*Sniffing* Aaaaahhh... yeeeesss... I could smell them outside the crypt..." with dis12
    ili2 "*Cheirando* Aaaaahhh... sim... eu podia sentir o cheiro deles fora da cripta..." with dis12

# game/script7.rpy:2752
translate brazil continuedaliapenny_1966ffec:

#   mct "Where the hell did she come from...?"
    mct "De onde diabos ela veio...?"

# game/script7.rpy:2757
translate brazil continuedaliapenny_3ab31f5f:

#   ili2 "*Sniffing* They smell... wonderfully indeed..."
    ili2 "*Cheirando* Eles cheiram... maravilhosamente mesmo..."

# game/script7.rpy:2758
translate brazil continuedaliapenny_8fd2d48e:

#   mct "D-Damn, she's fast as fuck."
