#   l "It's just so dreadful."
    l "É tão terrível."

# game/script7.rpy:6903
translate brazil morninghollow_f0d0baaa:

#   bak "He was the leader of the werewolves, that's what matters."
    bak "Ele era o líder dos lobisomens, isso é o que importa."

# game/script7.rpy:6905
translate brazil morninghollow_cfd021e6:

#   bak "He ventured to our town, apparently because you told him we had a shaman capable of curing their curse, or something." with dis12
    bak "Ele se aventurou em nossa cidade, aparentemente porque você disse a ele que tínhamos um xamã capaz de curar a maldição deles, ou algo assim." with dis12

# game/script7.rpy:6906
