#   mc "So... yeah, it won't be possible, I'm afraid."
    mc "Então... sim, não será possível, infelizmente."

# game/script7.rpy:2922
translate brazil continuedaliapenny_4122fb91:

#   mc "So... we just have to dance?"
    mc "Então... só temos que dançar?"

