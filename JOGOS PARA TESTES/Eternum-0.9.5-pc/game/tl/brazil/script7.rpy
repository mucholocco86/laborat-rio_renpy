    wer2 ". {w=0.9}. {w=0.9}.{w=0.9}{nw}"

# game/script7.rpy:3538
translate brazil werewolveslabel_65d231eb:

#   wer2 "Hmph."
    wer2 "Hmph."

# game/script7.rpy:3541
translate brazil werewolveslabel_e58276aa:

#   wer2 "Um..." with dis12
    wer2 "Um..." with dis12

# game/script7.rpy:3542
translate brazil werewolveslabel_502d9e21:

#   wer2 "Dude, she's not reacting."
    wer2 "Cara, ela não está reagindo."

# game/script7.rpy:3543
translate brazil werewolveslabel_0ce6764b:

#   mct "What in the..."
    mct "O que no..."

# game/script7.rpy:3544
translate brazil werewolveslabel_2ed538f7:

#   wer2 "Why is she not reacting?"
    wer2 "Por que ela não está reagindo?"

# game/script7.rpy:3546
translate brazil werewolveslabel_a7c865a3:

#   wer "Are you asking me?"
    wer "Você está me perguntando?"

# game/script7.rpy:3548
translate brazil werewolveslabel_ed743b4c:

#   wer2 "No, I'm asking the mushroom behind you."
    wer2 "Não, estou perguntando ao cogumelo atrás de você."

# game/script7.rpy:3549
translate brazil werewolveslabel_27db9c23:

#   wer2 "Of course I'm asking you, dumbshit."
    wer2 "Claro que estou perguntando a você, idiota."

# game/script7.rpy:3550
translate brazil werewolveslabel_7de4ad7c:

#   wer2 "What are we supposed to do now?"
    wer2 "O que devemos fazer agora?"

# game/script7.rpy:3552
translate brazil werewolveslabel_d4bfd0d2:

#   wer "Eh..."
    wer "Eh..."

# game/script7.rpy:3553
translate brazil werewolveslabel_5f3b0968:

#   wer "I-I don't know, usually everyone's run away by this point."
    wer "E-eu não sei, geralmente todo mundo já fugiu a essa altura."

# game/script7.rpy:3555
translate brazil werewolveslabel_16e04f16:

#   wer2 "What did the guard orientation handbook say?"
    wer2 "O que dizia o manual de orientação da guarda?"

# game/script7.rpy:3557
translate brazil werewolveslabel_e6a73b55:

#   wer "Um... I'm not sure, I haven't finished reading it yet."
    wer "Hum... não tenho certeza, ainda não terminei de ler."

# game/script7.rpy:3559
translate brazil werewolveslabel_04eb0daa:

#   wer2 "Duuude..."
    wer2 "Cara..."

# game/script7.rpy:3561
translate brazil werewolveslabel_70006fe1:

#   wer "Don't give me that look, you know how much Fangrend likes to over-explain everything."
    wer "Não me olhe assim, você sabe o quanto Fangrend gosta de explicar tudo demais."

# game/script7.rpy:3562
translate brazil werewolveslabel_10e4d854:

#   wer "That thing has like... a hundred pages."
    wer "Essa coisa tem tipo... cem páginas."

# game/script7.rpy:3563
translate brazil werewolveslabel_740b7c72:

#   wer "He literally weaves in a childhood story that spans three chapters just to explain night shifts."
    wer "Ele literalmente tece uma história de infância que se estende por três capítulos apenas para explicar os turnos noturnos."

# game/script7.rpy:3565
translate brazil werewolveslabel_1e676197:

#   wer2 "*Cheeky laugh* Yeah, the one about the rice fields, right?"
    wer2 "*Risada atrevida* Sim, aquela sobre os campos de arroz, certo?"

# game/script7.rpy:3567
translate brazil werewolveslabel_5e43527f:

#   l "Hi!"
    l "Oi!"

# game/script7.rpy:3571
translate brazil werewolveslabel_c8e51ad8:

#   wer2 "*Backing off* WHAT THE HELL?! SHE CAN SPEAK!" with hpunch
    wer2 "*Recuando* QUE DIABOS?! ELA PODE FALAR!" with hpunch

# game/script7.rpy:3573
translate brazil werewolveslabel_87ae921f:

#   wer "Of course she can speak, nitwit."
    wer "Claro que ela pode falar, idiota."

# game/script7.rpy:3574
translate brazil werewolveslabel_f2c2f063:

#   wer "She's a human, humans can talk."
    wer "Ela é humana, os humanos podem falar."

# game/script7.rpy:3577
translate brazil werewolveslabel_391fabf0:

#   wer2 "Ah, yeah, that makes sense." with dis15
    wer2 "Ah, sim, isso faz sentido." with dis15

# game/script7.rpy:3579
translate brazil werewolveslabel_9209b5f8:

#   wer "And didn't you hear them chatting just a minute ago?"
    wer "E você não os ouviu conversando há pouco?"

# game/script7.rpy:3581
translate brazil werewolveslabel_758a61dd:

#   wer2 "I didn't, no."
    wer2 "Eu não fiz, não."

# game/script7.rpy:3582
translate brazil werewolveslabel_a9d72c0b:

#   wer2 "Still got my ears clogged from our last swim."
    wer2 "Ainda estou com os ouvidos entupidos do último mergulho."

# game/script7.rpy:3584
