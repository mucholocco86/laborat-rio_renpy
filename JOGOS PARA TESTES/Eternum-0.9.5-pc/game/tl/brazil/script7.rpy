#   mc "*Getting into attack position* Watch out!" with hpunch
    mc "*Entrando em posição de ataque* Cuidado!" with hpunch

# game/script7.rpy:2723
translate brazil continuedaliapenny_15e80a14:

#   p "*Standing up with a jump* You son of a bitch!" with dis
    p "*Levantando-se com um pulo* Seu filho da puta!" with dis

# game/script7.rpy:2724
translate brazil continuedaliapenny_5eda6f1e:

#   p "Who are you?!"
    p "Quem é você?!"

# game/script7.rpy:2725
translate brazil continuedaliapenny_08a72e9a:

#   p "Was this a trap?"
    p "Isso foi uma armadilha?"

# game/script7.rpy:2726
translate brazil continuedaliapenny_68f2fa71:

#   p "Speak before we kill you!" with hpunch
    p "Fale antes que matemos você!" with hpunch

# game/script7.rpy:2729
translate brazil continuedaliapenny_3884dd27:

#   ili "*Shaking off the dust from his clothes* I-I'm sorry, I apologize." with dis14
    ili "*Sacudindo a poeira de suas roupas* E-me desculpe, peço desculpas." with dis14

# game/script7.rpy:2730
translate brazil continuedaliapenny_3135c10d:

#   ili "It's just that... it's been so long since we last had visitors that I kind of forgot how to make a proper introduction."
    ili "É que... já faz tanto tempo que não recebemos visitas que meio que esqueci como fazer uma apresentação adequada."

# game/script7.rpy:2732
translate brazil continuedaliapenny_67fcb3c2:

#   ili "*Clears throat* Pleased to meet you, travelers." with dis
    ili "*Limpa a garganta* Prazer em conhecê-los, viajantes." with dis

# game/script7.rpy:2733
translate brazil continuedaliapenny_0331b87c:

#   ili "I am Lazarus Iliescu, sovereign of Stravenovia... at your service."
    ili "Eu sou Lazarus Iliescu, soberano de Stravenovia... ao seu serviço."

# game/script7.rpy:2735
translate brazil continuedaliapenny_bdee69fc:

#   p "*Catching her breath* You're... Lord Iliescu?"
    p "*Recuperando o fôlego* Você é... Lorde Iliescu?"

# game/script7.rpy:2737
translate brazil continuedaliapenny_1cd917e6:

#   ili "Since the day I was born."
    ili "Desde o dia em que nasci."

# game/script7.rpy:2739
translate brazil continuedaliapenny_6209382b:

#   mc "You sure made quite an entrance..."
    mc "Você com certeza fez uma entrada e tanto..."

# game/script7.rpy:2740
