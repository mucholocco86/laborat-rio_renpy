translate brazil westernending_255b7ecd:

#   x "I guess we're all done here for today, then."
    x "Acho que terminamos aqui por hoje, então."

# game/script6.rpy:12176
translate brazil westernending_56c25b9f:

#   mc "I'd say we are."
    mc "Eu diria que sim."

# game/script6.rpy:12178
translate brazil westernending_4470739e:

#   x "Alright then, let me pick up the things I left in that alleyway and we'll be good to go." with dis
    x "Tudo bem então, deixe-me pegar as coisas que deixei naquele beco e estaremos prontos para ir." with dis

