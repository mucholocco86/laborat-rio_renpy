translate brazil westernending_d91a6e26:

#   mc "He mentioned knowing the locations of their hiding spots in other servers."
    mc "Ele mencionou conhecer a localização de seus esconderijos em outros servidores."

# game/script6.rpy:12163
translate brazil westernending_08184af4:

