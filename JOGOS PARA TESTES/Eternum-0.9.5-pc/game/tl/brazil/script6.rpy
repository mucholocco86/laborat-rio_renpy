translate brazil westernending_dfd87991:

#   mct "They have Alex..."
    mct "Eles têm Alex..."

# game/script6.rpy:12263
translate brazil westernending_39b3d173:

#   ec "Don't you?"
    ec "Não é?"

# game/script6.rpy:12264
translate brazil westernending_7a00a589:

#   mc "Let her go."
    mc "Deixe ela ir."

