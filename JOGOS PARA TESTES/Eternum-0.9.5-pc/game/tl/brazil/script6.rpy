translate brazil westernending_5851ade3:

#   mct "I totally lost track of time."
    mct "Perdi totalmente a noção do tempo."

# game/script6.rpy:12236
translate brazil westernending_22eac321:

#   mct "I think the craziest thing is how unaware we are of what's happening in the real world."
    mct "Acho que o mais louco é como não temos consciência do que está acontecendo no mundo real."

