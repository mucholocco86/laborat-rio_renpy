translate brazil westernending_d62e856a:

#   ec "Ah, so you've chosen to meet your end with honor!"
    ec "Ah, então você escolheu cumprir seu fim com honra!"

# game/script6.rpy:12326
translate brazil westernending_e90e5ba3:

#   ec "Just because of that, we won't touch your girl."
    ec "Só por causa disso, não tocaremos na sua garota."

# game/script6.rpy:12328
translate brazil westernending_e64e54ef:

#   ec "Just because of that, we won't touch the girl."
    ec "Só por causa disso, não tocaremos na garota."

