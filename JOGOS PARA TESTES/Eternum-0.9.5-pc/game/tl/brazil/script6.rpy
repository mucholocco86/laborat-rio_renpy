translate brazil westernending_f8726fa3:

#   mc "Ah, good."
    mc "Ah, bom."

# game/script6.rpy:12172
translate brazil westernending_d8fae6c7:

#   mc "We can ask her once we're back in the real world."
    mc "Podemos perguntar a ela quando voltarmos ao mundo real."

