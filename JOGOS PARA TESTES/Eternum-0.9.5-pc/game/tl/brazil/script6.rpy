translate brazil westernloginnoalex_8ac203a1:

#   mct "These few days away from them sure have taken a toll."
    mct "Esses poucos dias longe deles certamente custaram caro."

# game/script6.rpy:8189
translate brazil westernloginnoalex_4ededb1d:

#   mct "And what happened with Annie last night didn't help either, that's for sure..."
    mct "E o que aconteceu com Annie ontem à noite também não ajudou, isso é certo..."

# game/script6.rpy:8191
translate brazil westernloginnoalex_0759b71c:

#   mc "*Slapping your cheeks* (Okay, focus, [mc].)" with hpunch
    mc "*Dando um tapa em suas bochechas* (Ok, concentre-se, [mc].)" with hpunch

# game/script6.rpy:8192
translate brazil westernloginnoalex_39da420b:

#   mct "Stop putting your skill points into “horny” and put them into “intelligence” instead. Focus on the Gems. Focus on WINNING!"
    mct "Pare de colocar seus pontos de habilidade em “tesão” e coloque-os em “inteligência”. Concentre-se nas joias. Concentre-se em GANHAR!"

# game/script6.rpy:8193
translate brazil westernloginnoalex_f1eefb2a:

#   mct "I should probably ask the bartender to cancel the whiskeys, though."
    mct "Eu provavelmente deveria pedir ao barman para cancelar os uísques."

# game/script6.rpy:8194
translate brazil westernloginnoalex_858a7a6f:

#   mct "I don't want to have to drink them all myself..."
    mct "Eu não quero ter que beber tudo sozinho..."

# game/script6.rpy:8197
translate brazil westernloginnoalex_bae6808b:

#   bla "You hear the saloon doors swing open as the piano abruptly stops playing."
    bla "Você ouve as portas do salão se abrindo enquanto o piano para de tocar abruptamente."

# game/script6.rpy:8201
translate brazil westernloginnoalex_d3ced348:

#   mc "*Turning around* (Huh?)" with dis12
    mc "*Virando-se* (hein?)" with dis12

# game/script6.rpy:8202
translate brazil westernloginnoalex_4b0853a9:

#   mct "Fuck, are those... Praetorians??"
    mct "Porra, aqueles são... Pretorianos??"

# game/script6.rpy:8203
translate brazil westernloginnoalex_e135da46:

#   mc "*Hiding your face under your hat* (What the hell are they doing here?)"
    mc "*Escondendo o rosto debaixo do chapéu* (O que diabos eles estão fazendo aqui?)"

# game/script6.rpy:8205
translate brazil westernloginnoalex_b05f2a1d:

#   pra "Attention, players." with dis08
    pra "Atenção, jogadores." with dis08

# game/script6.rpy:8206
translate brazil westernloginnoalex_69496617:

#   pra "All patrons of this establishment must immediately halt their current activities and take heed of our proclamation."
    pra "Todos os frequentadores deste estabelecimento devem interromper imediatamente as suas atividades atuais e prestar atenção à nossa proclamação."

# game/script6.rpy:8207
translate brazil westernloginnoalex_d7f5f6eb:

#   pra "An illegal, stolen artifact has been detected within this server."
    pra "Um artefato roubado ilegal foi detectado neste servidor."

# game/script6.rpy:8208
translate brazil westernloginnoalex_cfe0b9f4:

#   pra "Your cooperation is now mandated by the Ulysses EGCE commission to swiftly recover the item. Time is of the essence."
    pra "A sua cooperação é agora exigida pela comissão Ulysses EGCE para recuperar rapidamente o item. O tempo é essencial."

# game/script6.rpy:8211
translate brazil westernloginnoalex_a30e64b8:

#   sbar "Hold on there, partner..." with dis
    sbar "Espera aí, parceiro..." with dis

# game/script6.rpy:8212
translate brazil westernloginnoalex_1f7fade6:

#   sbar "Do you think you can just saunter into my saloon and start threatening my patrons just like that?"
    sbar "Você acha que pode simplesmente entrar no meu bar e começar a ameaçar meus clientes desse jeito?"

# game/script6.rpy:8213
translate brazil westernloginnoalex_e814f9eb:

#   sbar "GET THE F–"
    sbar "OBTENHA O F–"

# game/script6.rpy:8230
translate brazil westernloginnoalex_203e275c:

#   pra "I’ll remind you that standing in the way of any Praetorian unit carrying out command-directed orders will face permanent Excommunication." with dis12
    pra "Vou lembrá-lo de que qualquer unidade Pretoriana que execute ordens de comando enfrentará Excomunhão permanente." with dis12

# game/script6.rpy:8231
translate brazil westernloginnoalex_8d0635dc:

#   pra "As previously stated, your cooperation is mandatory as this matter needs to be addressed immediately."
    pra "Conforme afirmado anteriormente, a sua cooperação é obrigatória, pois este assunto precisa ser resolvido imediatamente."

# game/script6.rpy:8232
translate brazil westernloginnoalex_6a442a4c:

#   pra "Are there any others that wish to air their grievances?"
    pra "Há outros que desejam expor suas queixas?"

# game/script6.rpy:8234
translate brazil westernloginnoalex_d9ddd963:

#   pra ". . ." with dis08
    pra ". . ." with dis08

# game/script6.rpy:8236
translate brazil westernloginnoalex_9eb0e0ef:

#   pra "The item of our attention is a palm-sized, cube-shaped artifact." with dis08
    pra "O item que chama a nossa atenção é um artefato em forma de cubo, do tamanho da palma da mão." with dis08

# game/script6.rpy:8237
translate brazil westernloginnoalex_a1b9e2b0:

#   pra "One of our operatives will be stationed in the town center until this matter has concluded. Any assistance provided in solving this case will be generously rewarded."
    pra "Um de nossos agentes ficará estacionado no centro da cidade até que este assunto seja concluído. Qualquer assistência prestada na resolução deste caso será generosamente recompensada."

# game/script6.rpy:8238
translate brazil westernloginnoalex_6c15dd0c:

#   pra "Do any of you have questions?"
    pra "Algum de vocês tem dúvidas?"

# game/script6.rpy:8242
translate brazil westernloginnoalex_a1c5c60f:

#   pra "Thank you for your cooperation." with dis08
    pra "Obrigado pela sua cooperação." with dis08

# game/script6.rpy:8245
translate brazil westernloginnoalex_ce7b7709:

#   bla "The two Praetorians leave the saloon." with dis15
    bla "Os dois pretorianos saem do salão." with dis15

# game/script6.rpy:8246
translate brazil westernloginnoalex_f9a1f5bb:

#   mct "Holy fuck... Praetorians are on the server?? This is not good..."
    mct "Puta merda... Pretorianos estão no servidor?? Isso não é bom..."

# game/script6.rpy:8247
translate brazil westernloginnoalex_9b2193f1:

#   mct "And what are they looking for? Calypso?"
    mct "E o que eles estão procurando? Calipso?"

# game/script6.rpy:8248
translate brazil westernloginnoalex_6891c0c4:

#   mct "No... that's impossible, the Founder knew she's with us. It wouldn't make sense for him to send them."
    mct "Não... isso é impossível, a Fundadora sabia que estava conosco. Não faria sentido para ele enviá-los."

# game/script6.rpy:8249
translate brazil westernloginnoalex_e59c32b6:

#   mct "And... well, Calypso isn’t a “palm-sized, cube-shaped artifact”. What the hell is that about?"
    mct "E... bem, Calypso não é um \"artefato em forma de cubo do tamanho da palma da mão\". O que diabos é isso?"

# game/script6.rpy:8250
translate brazil westernloginnoalex_f1329139:

#   mct "I guess it'll be better if I just try to avoid them and go help the girls out there. It's not as if I can interview the bartender anymore."
    mct "Acho que será melhor se eu apenas tentar evitá-los e ajudar as garotas lá fora. Não posso mais entrevistar o barman."

# game/script6.rpy:8251
translate brazil westernloginnoalex_b8f2afa9:

#   mct "A Wild West town, a hidden outlaw, and three sexy girls. This promises to be fun."
    mct "Uma cidade do Velho Oeste, um bandido escondido e três garotas sensuais. Isso promete ser divertido."

# game/script6.rpy:8252
translate brazil westernloginnoalex_27851c8f:

#   mct "And possibly deadly."
    mct "E possivelmente mortal."

# game/script6.rpy:7985
translate brazil westernloginnoalex_282e5851_1:

#   mc "What...?"
    mc "O que...?"

# game/script6.rpy:8180
translate brazil westernloginnoalex_e09ffa78_1:

#   mct "Man, I'd kill to have another go with her someday..."
    mct "Cara, eu mataria para ter outra chance com ela algum dia..."

# game/script6.rpy:8240
translate brazil westernloginnoalex_d9ddd963_1:

#   pra ". . ." with dis08
    pra ". . ." with dis08

# game/script6.rpy:8261
translate brazil calypsowestern_c659652a:

#   bla "You survey the surroundings, and quickly spot Calypso sitting on one of the benches behind the saloon." with dis
    bla "Você examina os arredores e rapidamente avista Calypso sentado em um dos bancos atrás do salão." with dis

# game/script6.rpy:8262
translate brazil calypsowestern_408f0333:

#   mc "There she is!"
    mc "Lá está ela!"

# game/script6.rpy:8263
translate brazil calypsowestern_e011f9a5:

#   mct "Not the hardest girl to find. That hair of hers stands out like a lone tumbleweed in the middle of the desert."
    mct "Não é a garota mais difícil de encontrar. Aquele cabelo dela se destaca como uma erva daninha solitária no meio do deserto."

# game/script6.rpy:8266
translate brazil calypsowestern_cffa4ea3:

#   mc "*Sitting next to her* Be careful, Princess. Those things are deadly." with dis06
    mc "*Sentado ao lado dela* Tenha cuidado, Princesa. Essas coisas são mortais." with dis06

# game/script6.rpy:8268
translate brazil calypsowestern_1110ba53:

#   ca "I find the workings of this device to be remarkably ingenious, I must say."
    ca "Acho que o funcionamento deste dispositivo é extremamente engenhoso, devo dizer."

# game/script6.rpy:8269
translate brazil calypsowestern_31a8a4b9:

#   ca "Humans from my realm who cannot wield magic are limited to longbows or crossbows."
    ca "Humanos do meu reino que não conseguem exercer magia estão limitados a arcos longos ou bestas."

# game/script6.rpy:8270
translate brazil calypsowestern_6aad6743:

#   ca "This seems to be much more... precise. And fast."
    ca "Isso parece ser muito mais... preciso. E rápido."

# game/script6.rpy:8272
translate brazil calypsowestern_4a1c3f16:

#   mc "That’s nothing. You should see the things we have created in the present time."
    mc "Isso não é nada. Você deveria ver as coisas que criamos no tempo presente."

# game/script6.rpy:8273
translate brazil calypsowestern_0199f5a2:

#   mc "If there's one thing us humans are good at, it's killing each other."
    mc "Se há uma coisa em que nós, humanos, somos bons é matar uns aos outros."

# game/script6.rpy:8275
translate brazil calypsowestern_5e43e54e:

#   ca "Hah, I must agree with you there. I have never seen any other race engaging in more internal conflicts. Not even the dwarves."
    ca "Hah, devo concordar com você nisso. Nunca vi nenhuma outra raça envolvida em mais conflitos internos. Nem mesmo os anões."

# game/script6.rpy:8277
translate brazil calypsowestern_591dc9c0:

#   mc "Where did you get it from, by the way?"
    mc "Aliás, de onde você tirou isso?"

# game/script6.rpy:8280
translate brazil calypsowestern_ebca7a85:

#   ca "I replicated the one the deputy was wielding." with dis12
    ca "Eu repliquei aquele que o deputado estava empunhando." with dis12

# game/script6.rpy:8282
translate brazil calypsowestern_10abe8ff:

#   mc "Oh, so you found him already!"
    mc "Ah, então você já o encontrou!"

# game/script6.rpy:8284
translate brazil calypsowestern_a08e45fc:

#   ca "Indeed. He mentioned having business to attend to at the neighboring establishment, and he said he would answer my questions thereafter."
    ca "De fato. Ele mencionou que tinha negócios a tratar no estabelecimento vizinho e disse que responderia às minhas perguntas depois disso."

# game/script6.rpy:8285
translate brazil calypsowestern_8b4f546e:

#   ca "I was waiting for him to come out."
    ca "Eu estava esperando ele sair."

# game/script6.rpy:8287
translate brazil calypsowestern_82f15133:

#   mc "Nice!"
    mc "Legal!"

# game/script6.rpy:8288
translate brazil calypsowestern_65fa63ab:

#   mc "I see you quickly got the hang of things around here. You almost look like a local already."
    mc "Vejo que você rapidamente pegou o jeito das coisas por aqui. Você já quase parece um morador local."

# game/script6.rpy:8289
translate brazil calypsowestern_2725e439:

#   ca "Hmm."
    ca "Hum."

# game/script6.rpy:8290
translate brazil calypsowestern_2ac8a445:

#   mc "You'd adapt to our world pretty fast, I'm sure."
    mc "Você se adaptaria ao nosso mundo muito rápido, tenho certeza."

# game/script6.rpy:8292
translate brazil calypsowestern_a1e3d73c:

#   ca "Of course. Humans are simple, and their intricacies, banal."
    ca "Claro. Os humanos são simples e suas complexidades, banais."

# game/script6.rpy:8293
translate brazil calypsowestern_237d8697:

#   ca "Although... some of them pique my curiosity, I must admit."
    ca "Embora... alguns deles despertem minha curiosidade, devo admitir."

# game/script6.rpy:8295
translate brazil calypsowestern_279ec14b:

#   mc "Ah yeah, elven princesses do pique my curiosity as well."
    mc "Ah, sim, princesas élficas também despertam minha curiosidade."

# game/script6.rpy:8296
translate brazil calypsowestern_b8a595c9:

#   mc "One particular elven princess, to be precise."
    mc "Uma princesa élfica em particular, para ser mais preciso."

# game/script6.rpy:8297
translate brazil calypsowestern_23ea0bfb:

#   mc "*Chuckles* I even dreamt about you the other day."
    mc "*Risos* Eu até sonhei com você outro dia."

# game/script6.rpy:8301
translate brazil calypsowestern_38fc1022:

#   ca "Oh, really?" with dis
    ca "Oh sério?" with dis

# game/script6.rpy:8302
translate brazil calypsowestern_56be66ef:

#   ca "I very much hope there was no indecency in that dream."
    ca "Espero sinceramente que não tenha havido indecência nesse sonho."

# game/script6.rpy:8304
translate brazil calypsowestern_5a86862f:

#   mc "Not at all."
    mc "De jeito nenhum."

# game/script6.rpy:8305
translate brazil calypsowestern_56ba242c:

#   mct "Unfortunately..."
    mct "Infelizmente..."

# game/script6.rpy:8307
translate brazil calypsowestern_195b01af:

#   ca "In that case... I will allow it, despite its impropriety."
    ca "Nesse caso... eu permitirei, apesar de ser impropriedade."

# game/script6.rpy:8309
translate brazil calypsowestern_2e47f741:

#   mc "*Chuckles* Thank you for letting me dream, my Princess."
    mc "*Risos* Obrigado por me deixar sonhar, minha princesa."

# game/script6.rpy:8310
translate brazil calypsowestern_f10ac7bf:

#   mc "Your generosity knows no limits."
    mc "Sua generosidade não conhece limites."

# game/script6.rpy:8312
translate brazil calypsowestern_27c673bf:

#   ca "Well then, enlighten me. What occurred in this dream of yours, and what role did I play in it?"
    ca "Pois bem, me esclareça. O que aconteceu nesse seu sonho e que papel desempenhei nele?"

# game/script6.rpy:8315
translate brazil calypsowestern_563ac79e:

#   mc "Well technically it wasn't a dream, more like a hallucination. We call it a “bleeding case”."
    mc "Bem, tecnicamente não foi um sonho, foi mais como uma alucinação. Chamamos isso de “caso de sangramento”."

# game/script6.rpy:8317
translate brazil calypsowestern_08f00cc1:

#   mc "It happened during a day I was alone at home and didn't have much to do."
    mc "Aconteceu durante um dia em que eu estava sozinho em casa e não tinha muito o que fazer."

# game/script6.rpy:8318
translate brazil calypsowestern_1b1c28ee:

#   mc "I think I fell asleep on the couch or something, I don't remember it exactly."
    mc "Acho que adormeci no sofá ou algo assim, não me lembro exatamente."

# game/script6.rpy:8319
translate brazil calypsowestern_4058c76b:

#   mc "I saw the inn where you've been lodging in Ekabar, and you were there with the innkeeper."
    mc "Eu vi a pousada onde você estava hospedado em Ekabar, e você estava lá com o estalajadeiro."

# game/script6.rpy:8320
translate brazil calypsowestern_b3aecb7a:

#   mc "He asked you to pay, and then you got all mad and threatened him with your lightning magic."
    mc "Ele pediu que você pagasse, e então você ficou furioso e o ameaçou com sua magia relâmpago."

# game/script6.rpy:8321
translate brazil calypsowestern_881657d8:

#   mc "It was pretty funny."
    mc "Foi muito engraçado."

# game/script6.rpy:8323
translate brazil calypsowestern_ae8470c4:

#   ca "So... reminiscent of actual events?"
    ca "Então... lembra eventos reais?"

# game/script6.rpy:8325
translate brazil calypsowestern_f677fe42:

#   mc "*Chuckles* Something similar happened? Did you have trouble with the innkeeper?"
    mc "*Risos* Aconteceu algo semelhante? Você teve problemas com o estalajadeiro?"

# game/script6.rpy:8327
translate brazil calypsowestern_d0a5359e:

#   ca "Yes. He disrespected me, and I had to remind him who he was dealing with."
    ca "Sim. Ele me desrespeitou e tive que lembrá-lo com quem ele estava lidando."

# game/script6.rpy:8328
translate brazil calypsowestern_e71d08f2:

#   ca "Then you appeared out of nowhere, but left using vanishing magic without giving any sort of explanation."
    ca "Então você apareceu do nada, mas saiu usando magia de desaparecimento sem dar qualquer tipo de explicação."

# game/script6.rpy:8330
translate brazil calypsowestern_219c5f0c:

#   mc "What...? I don't have any vanishing magic."
    mc "O que...? Eu não tenho nenhuma magia de desaparecimento."

# game/script6.rpy:8331
translate brazil calypsowestern_7ef1d47d:

#   mc "When did this happen?"
    mc "Quando isso aconteceu?"

# game/script6.rpy:8333
translate brazil calypsowestern_b226fa36:

#   ca "Several moons ago."
    ca "Várias luas atrás."

# game/script6.rpy:8335
translate brazil calypsowestern_66ed3157:

#   mc "(Several moons ago? Could I have fallen asleep wearing the E-suit and visor again?)"
    mc "(Várias luas atrás? Será que eu poderia ter adormecido usando o traje eletrônico e a viseira de novo?)"

# game/script6.rpy:8337
translate brazil calypsowestern_ff9f9281:

#   mct "No, that can't be. I was on my way to Luna's uncle's house. I didn't even have them with me."
    mct "Não, isso não pode ser. Eu estava indo para a casa do tio de Luna. Eu nem os tinha comigo."

# game/script6.rpy:8339
translate brazil calypsowestern_a7a9043e:

#   mct "No, that can't be. I remember I didn't play Eternum that day."
    mct "Não, isso não pode ser. Lembro que não joguei Eternum naquele dia."

# game/script6.rpy:8340
translate brazil calypsowestern_e42ec655:

#   mc "Nah, it's impossible."
    mc "Não, é impossível."

# game/script6.rpy:8341
translate brazil calypsowestern_98cce2aa:

#   mc "You must be mistaking it for the time I went there with Alex."
    mc "Você deve estar confundindo isso com a época em que fui lá com Alex."

# game/script6.rpy:8343
translate brazil calypsowestern_1223eed4:

#   ca "No... you were alone. You said–"
    ca "Não... você estava sozinho. Você disse–"

# game/script6.rpy:8351
translate brazil calypsowestern_3e5bda40:

#   mc "Shit, did those gunshots come from the store where the deputy is?" with dis
    mc "Merda, aqueles tiros vieram da loja onde o policial está?" with dis

# game/script6.rpy:8353
translate brazil calypsowestern_3ceb6e1e:

#   ca "I believe so, yes..."
    ca "Acredito que sim, sim..."

# game/script6.rpy:8355
translate brazil calypsowestern_93e56402:

#   mc "Maybe he's in trouble?"
    mc "Talvez ele esteja com problemas?"

# game/script6.rpy:8358
translate brazil calypsowestern_be56df42:

#   ca "*Standing up* Perhaps with the man you're looking for?" with dis12
    ca "*Levantando-se* Talvez com o homem que você procura?" with dis12

# game/script6.rpy:8359
translate brazil calypsowestern_3c17e9d9:

#   mc "El Coyote? Fuck, could be possible."
    mc "El Coiote? Porra, poderia ser possível."

# game/script6.rpy:8360
translate brazil calypsowestern_2f66a084:

#   mc "Let's take a look."
    mc "Vamos dar uma olhada."

# game/script6.rpy:8366
translate brazil calypsowestern_d47f4f4e:

#   bla "You enter the store and find the Sheriff's deputy with his hands up." with dis
    bla "Você entra na loja e encontra o delegado do xerife com as mãos para cima." with dis

# game/script6.rpy:8367
translate brazil calypsowestern_c29a569f:

#   mc "Um... is there a problem, sir?"
    mc "Hum... há algum problema, senhor?"

# game/script6.rpy:8369
translate brazil calypsowestern_c8b3d764:

#   gsc "Oh, there is definitely a problem. This man is trying to rob me!"
    gsc "Ah, definitivamente há um problema. Este homem está tentando me roubar!"

# game/script6.rpy:8371
translate brazil calypsowestern_93592b55:

#   sd "I'm not robbing you, you dumbass!"
    sd "Eu não estou roubando você, seu idiota!"

# game/script6.rpy:8372
translate brazil calypsowestern_05edd09d:

#   sd "You've been renting this space for your store for a while now and it’s about time you’ve paid your property taxes just like everyone else!"
    sd "Você já aluga este espaço para sua loja há algum tempo e já é hora de pagar o imposto sobre a propriedade como todo mundo!"

# game/script6.rpy:8374
translate brazil calypsowestern_f3d7e11f:

#   gsc "First, you steal our lands from us, and now you want us to pay YOU for utilizing it?!"
    gsc "Primeiro, você rouba nossas terras de nós e agora quer que paguemos VOCÊ por utilizá-las?!"

# game/script6.rpy:8375
translate brazil calypsowestern_0e93fe26:

#   gsc "Over my dead body! Do you know how long my ancestors have dwelled in this area?!"
    gsc "Sobre meu cadáver! Você sabe há quanto tempo meus ancestrais moraram nesta área?!"

# game/script6.rpy:8377
translate brazil calypsowestern_85174814:

#   sd "Cut the shit, Brendan, you're from Queens!"
    sd "Pare com essa merda, Brendan, você é do Queens!"

# game/script6.rpy:8379
translate brazil calypsowestern_a77c6256:

#   gsc "You're offending my Wamapoke roots!"
    gsc "Você está ofendendo minhas raízes Wamapoke!"

# game/script6.rpy:8381
