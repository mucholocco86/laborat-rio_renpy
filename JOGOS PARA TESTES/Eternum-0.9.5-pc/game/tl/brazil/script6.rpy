translate brazil westernending_d06517ff:

#   ca "I will."
    ca "Eu vou."

# game/script6.rpy:12203
translate brazil westernending_82fdbca5:

#   ca "After seeing firsthand how useful asking the locals can be, I will resume my search of Hyril'ar."
    ca "Depois de ver em primeira mão como pode ser útil perguntar aos habitantes locais, retomarei minha busca por Hyril'ar."

# game/script6.rpy:12204
translate brazil westernending_a915ce04:

#   ca "Hopefully with better results this time."
    ca "Esperançosamente com melhores resultados desta vez."

