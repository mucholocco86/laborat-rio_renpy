translate brazil update06_4c1b0638:

#   mc "I wanted to keep up with the girls and..."
    mc "Eu queria acompanhar as meninas e..."

# game/script6.rpy:1402
translate brazil update06_ab9c9145:

#   mc "Wait, how do you know I've been playing Eternum?"
    mc "Espere, como você sabe que estou jogando Eternum?"

# game/script6.rpy:1404
translate brazil update06_98bcd11c:

#   ca "I could sense when you left what you call the “real world” and appeared in another realm."
    ca "Pude sentir quando você deixou o que chama de “mundo real” e apareceu em outro reino."

# game/script6.rpy:1405
translate brazil update06_4010d10c:

#   ca "Whether it was the desert, the grotto, or the jungle."
    ca "Quer fosse o deserto, a gruta ou a selva."

# game/script6.rpy:1406
translate brazil update06_d325b4df:

#   ca "And even if you {i}think{/i} you have improved, your technique is still reminiscent of a lumbering ogre!"
    ca "E mesmo que você {i}pense{/i} que melhorou, sua técnica ainda lembra a de um ogro pesado!"

# game/script6.rpy:1408
translate brazil update06_cb70afb1:

#   mc "So..."
    mc "Então..."

# game/script6.rpy:1409
translate brazil update06_93c1a0af:

#   mc "You've been following me around and spying on me?"
    mc "Você tem me seguido e me espionado?"

# game/script6.rpy:1411
translate brazil update06_c81b7376:

#   ca ". . ." with dis
    ca ". . ." with dis

