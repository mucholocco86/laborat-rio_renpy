translate brazil westernending_c70bed0d:

#   bi "The boss is simply unbeatable in a duel. He possesses the absolute fastest draw in all of Eternum!"
    bi "O chefe é simplesmente imbatível em duelo. Ele possui o empate mais rápido de toda Eternum!"

