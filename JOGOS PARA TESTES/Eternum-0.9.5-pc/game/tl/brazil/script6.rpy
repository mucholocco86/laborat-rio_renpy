translate brazil westernending_ac7920b6:

#   mct "A lot more..."
    mct "Muito mais..."

# game/script6.rpy:12232
translate brazil westernending_9ade786a:

#   mct "Especially in the morning..."
    mct "Principalmente pela manhã..."

# game/script6.rpy:12233
translate brazil westernending_7a318312:

#   bla ". . ."
    bla ". . ."

