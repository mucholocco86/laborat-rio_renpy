translate brazil update06_6fda1498:

#   ca "And I want to go with you on the next mission, as an active participant, not a getaway portal."
    ca "E quero ir com você na próxima missão, como participante ativo, não como portal de fuga."

# game/script6.rpy:1428
translate brazil update06_e515b30f:

#   ca "The more I discover about the different realms, the sooner I will be able to return home."
    ca "Quanto mais eu descobrir sobre os diferentes reinos, mais cedo poderei voltar para casa."

# game/script6.rpy:1430
translate brazil update06_d5ae2301:

#   mc "Fair enough."
    mc "Justo."

# game/script6.rpy:1431
translate brazil update06_e80a3a05:

#   mc "About the information you want... well, we discovered that some people who apparently died in our world are able to keep existing inside Eternum."
    mc "Sobre a informação que você deseja... bem, descobrimos que algumas pessoas que aparentemente morreram em nosso mundo conseguem continuar existindo dentro de Eternum."

# game/script6.rpy:1432
translate brazil update06_b85ea606:

#   mc "Thanatos, the man who attacked you here in Ogygia, is apparently one of them."
    mc "Thanatos, o homem que atacou você aqui em Ogígia, é aparentemente um deles."

# game/script6.rpy:1433
translate brazil update06_3f7e101e:

#   mc "My theory is that Ulysses found a way to... “digitize” human consciousness somehow."
    mc "A minha teoria é que Ulisses encontrou uma forma de... \"digitalizar\" a consciência humana de alguma forma."

# game/script6.rpy:1434
translate brazil update06_f7adb9f9:

#   mc "But I honestly don't know, it all still sounds too unreal to me."
    mc "Mas sinceramente não sei, tudo ainda me parece muito irreal."

# game/script6.rpy:1436
translate brazil update06_ab39c575:

#   ca "I... see."
    ca "Eu vejo."

# game/script6.rpy:1437
translate brazil update06_48e4a2f5:

#   ca "And what is the next step?"
    ca "E qual é o próximo passo?"

# game/script6.rpy:1439
translate brazil update06_1afb66e6:

#   mc "We're still trying to gather the 10 Gems of Doom in an attempt to unravel all the mystery. They're the key to this whole thing."
    mc "Ainda estamos tentando reunir as 10 Gemas da Perdição na tentativa de desvendar todo o mistério. Eles são a chave para tudo isso."

# game/script6.rpy:1440
translate brazil update06_6c84eb70:

#   mc "Nancy is using her connections to discover the possible locations of the other Gems."
    mc "Nancy está usando suas conexões para descobrir as possíveis localizações das outras Gems."

# game/script6.rpy:1442
translate brazil update06_d00b19af:

#   ca "Good. I like Miss Nancy. She is also a powerful ruler."
    ca "Bom. Eu gosto da senhorita Nancy. Ela também é uma governante poderosa."

# game/script6.rpy:1444
translate brazil update06_b70d0e35:

#   mc "So you want me to “summon” you next time we're on a mission?"
    mc "Então você quer que eu \"convoque\" você na próxima vez que estivermos em missão?"

# game/script6.rpy:1445
translate brazil update06_250acf73:

#   mc "We'll probably be playing again tomorrow."
    mc "Provavelmente jogaremos novamente amanhã."

# game/script6.rpy:1447
translate brazil update06_759859b3:

#   ca "Yes. I mean... no. I will come to you."
    ca "Sim. Quero dizer... não. Eu irei até você."

# game/script6.rpy:1448
translate brazil update06_e1de9fbd:

#   ca "Tomorrow is good. I will prepare."
    ca "Amanhã está bom. Eu vou me preparar."

# game/script6.rpy:1450
translate brazil update06_34d8a54c:

#   mc "Cool! Let's do that."
    mc "Legal! Vamos fazer isso."

# game/script6.rpy:1452
translate brazil update06_14a0f08c:

#   ca "Yes. {i}Cool."
    ca "Sim. {i}Legal."

# game/script6.rpy:1457
translate brazil update06_1da0b858:

#   ca "I will see you tomorrow then." with dis06
    ca "Vejo você amanhã então." with dis06

# game/script6.rpy:1458
translate brazil update06_2e48b59c:

#   ca "If that is all, I shall be on my way. Farewell, [mc]."
    ca "Se isso é tudo, irei embora. Adeus, [mc]."

# game/script6.rpy:1463
translate brazil update06_e7ba5304:

#   mc "Sounds good!" with dis06
    mc "Parece bom!" with dis06

# game/script6.rpy:1464
translate brazil update06_0056f047:

#   mc "Can't wait to team up with my favorite elven princess!"
    mc "Mal posso esperar para me juntar à minha princesa élfica favorita!"

# game/script6.rpy:1466
translate brazil update06_d5cc33b3:

#   mc "High-five!" with dis08
    mc "Mais cinco!" with dis08

# game/script6.rpy:1475
translate brazil update06_0200773e:

#   mct "Too soon."
    mct "Muito cedo."

# game/script6.rpy:1478
translate brazil update06_bb8ee756:

#   mc "*Bowing down* For the greater good of Hyril'ar, I pledge to lay my life down for my Princess and satisfy each one of her desires." with dis06
    mc "*Curvando-se* Para o bem maior de Hyril'ar, prometo dar minha vida por minha princesa e satisfazer cada um de seus desejos." with dis06

# game/script6.rpy:1480
translate brazil update06_04ed8ace:

#   ca "Hmph." with dis08
    ca "Hmph." with dis08

# game/script6.rpy:1487
translate brazil update06_6600f2eb:

#   mct "That “hmph” sounded more playful than the angry ones of before." with dis
    mct "Aquele “hmph” soou mais divertido do que os raivosos de antes." with dis

# game/script6.rpy:1488
translate brazil update06_aa6b101b:

