#   mc "*Grinding your teeth* You think I don’t know that?!"
    mc "*Ringando os dentes* Você acha que eu não sei disso?!"

# game/script2.rpy:4957
translate brazil nancygym_5f56d71b:

#   mc "I'm f-fucking trying."
    mc "Estou tentando, porra."

# game/script2.rpy:4958
translate brazil nancygym_bb5fd102:

#   mc "I can’t raise it any higher!"
    mc "Eu não posso aumentar mais!"

