translate brazil nancygym_d1df2ac5:

#   ger "Did you know that your mother and I are known as the \"Forever Young Ladies\" at this gym?"
    ger "Você sabia que sua mãe e eu somos conhecidas como as “Forever Young Ladies” nesta academia?"

# game/script2.rpy:4861
translate brazil nancygym_05348fbb:

#   mc "Like I said, I’m not Dalia..." with dissolve
    mc "Como eu disse, não sou Dalia..." with dissolve

# game/script2.rpy:4863
translate brazil nancygym_a765151f:

#   n "Yeah, well, I'm honestly not sure if anyone really calls us that." with dissolve
    n "Sim, bem, honestamente não tenho certeza se alguém realmente nos chama assim." with dissolve

# game/script2.rpy:4864
translate brazil nancygym_3d0797e6:

#   mc "(If someone does, I don’t think they were applying that nickname to Gertrude...)"
    mc "(Se alguém o fizer, não creio que estivesse aplicando esse apelido a Gertrude...)"

