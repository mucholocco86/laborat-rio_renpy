#   no "*Nervous laughter* Nada."
    no "*Risos nervosos* Nada."

# game/script2.rpy:8946
translate brazil novamissedscene_01de054b:

#   mc "So..." with dis
    mc "Então..." with dis

# game/script2.rpy:8947
translate brazil novamissedscene_6fc6cc3e:

#   mc "We're completely lost then?"
    mc "Estamos completamente perdidos então?"

# game/script2.rpy:8948
translate brazil novamissedscene_09e3cba5:

#   no "Um..."
    no "Um..."

# game/script2.rpy:8949
translate brazil novamissedscene_6b0ba10d:

#   no "Kinda."
    no "Tipo."

# game/script2.rpy:8951
translate brazil novamissedscene_40b06a1b:

#   no "I was so excited to get into this secret server that I forgot to think of a way to get out." with dis
    no "Fiquei tão animado para entrar neste servidor secreto que esqueci de pensar em uma maneira de sair." with dis

# game/script2.rpy:8952
translate brazil novamissedscene_7209f9c4:

#   x "So we don't even know which way to go?"
    x "Então nem sabemos que caminho seguir?"

# game/script2.rpy:8953
translate brazil novamissedscene_5dc360df:

#   no "I haven’t the faintest idea."
    no "Não tenho a menor ideia."

# game/script2.rpy:8955
translate brazil novamissedscene_ef0ded54:

#   no "But don't worry!" with dis
    no "Mas não se preocupe!" with dis

# game/script2.rpy:8956
translate brazil novamissedscene_a937c1ba:

#   no "If we start walking in a straight path, I'm sure we'll find something!"
    no "Se começarmos a caminhar em linha reta, tenho certeza que encontraremos algo!"

# game/script2.rpy:8957
translate brazil novamissedscene_0778c90b:

#   no "Come on guys, you just gotta put on a brave face!"
    no "Vamos lá pessoal, vocês só precisam ter uma cara de coragem!"

# game/script2.rpy:8958
translate brazil novamissedscene_d179972e:

#   no "WE'RE NOT GONNA DIE HERE!"
    no "NÃO VAMOS MORRER AQUI!"

# game/script2.rpy:8959
translate brazil novamissedscene_53200f69:

#   no "LET'S GO!" with hpunch
    no "VAMOS!" with hpunch

# game/script2.rpy:8960
translate brazil novamissedscene_77a89e99:

#   mc ". . ."
    mc ". . ."

# game/script2.rpy:8961
translate brazil novamissedscene_7618ca52:

#   x ". . ."
    x ". . ."

# game/script2.rpy:8970
translate brazil novamissedscene_8b604985:

#   no "AAAAAAAH, WE'RE GONNA DIE HERE!" with Dissolve(2.5)
    no "AAAAAAH, VAMOS MORRER AQUI!" with Dissolve(2.5)

# game/script2.rpy:8971
translate brazil novamissedscene_61476bd7:

#   no " This forest is endless!"
    no " Esta floresta é infinita!"

# game/script2.rpy:8974
translate brazil novamissedscene_ff726004:

#   no "My feet are killing me!" with Dissolve(2)
    no "Meus pés estão me matando!" with Dissolve(2)

# game/script2.rpy:8975
translate brazil novamissedscene_a9bdd102:

#   no "We've been wandering aimlessly in these woods for I don't even know how long."
    no "Estamos vagando sem rumo por essa floresta há nem sei quanto tempo."

# game/script2.rpy:8976
translate brazil novamissedscene_698d2f71:

#   no "I'm cold, I'm tired, and I'm thirsty!"
    no "Estou com frio, estou cansado e com sede!"

# game/script2.rpy:8977
translate brazil novamissedscene_f66b8e21:

#   no "If I'm the first to die, please don't eat me... I might look like a walking Cheeto, but I promise you, I do not taste like one..."
    no "Se eu for o primeiro a morrer, por favor, não me coma... Posso parecer um Cheeto ambulante, mas prometo a você, não tenho gosto de tal..."

# game/script2.rpy:8980
translate brazil novamissedscene_a3c7be9b:

#   x "The mountain keeps sloping down toward this direction." with dis12
    x "A montanha continua descendo nessa direção." with dis12

# game/script2.rpy:8981
translate brazil novamissedscene_c59a577e:

#   x "That looks like our best chance at finding a river."
    x "Essa parece ser a nossa melhor hipótese de encontrar um rio."

# game/script2.rpy:8982
translate brazil novamissedscene_b99126a3:

#   x "Once we get there, we'll be able to get our bearings."
    x "Assim que chegarmos lá, poderemos nos orientar."

# game/script2.rpy:8984
translate brazil novamissedscene_73d041dc:

#   no "How the hell do you still have so much energy?" with dis
    no "Como diabos você ainda tem tanta energia?" with dis

# game/script2.rpy:8985
translate brazil novamissedscene_043ee48e:

#   no "I’m on the verge of passing out!"
    no "Estou prestes a desmaiar!"

# game/script2.rpy:8987
translate brazil novamissedscene_fb62a296:

#   x "Well, thanks to all that swimming, I have quite a bit of stamina."
    x "Bem, graças a toda aquela natação, tenho bastante resistência."

# game/script2.rpy:8989
translate brazil novamissedscene_49f2f8a4:

#   no "Well what about your body temperature? Aren't you cold?"
    no "Bem, e a temperatura do seu corpo? Você não está com frio?"

# game/script2.rpy:8990
translate brazil novamissedscene_e8dce04b:

#   no "You're almost naked!"
    no "Você está quase nu!"

# game/script2.rpy:8992
translate brazil novamissedscene_2e269d02:

#   x "I was at first, but these robes really hold in the heat, even if it doesn't seem like it."
    x "No começo eu estava, mas essas vestes realmente resistem ao calor, mesmo que não pareça."

# game/script2.rpy:8993
translate brazil novamissedscene_0f7af616:

#   x "\"Elven magic\", I guess."
    x "\"Magia élfica\", eu acho."

# game/script2.rpy:8995
translate brazil novamissedscene_68a77f57:

#   no "Awww, that's so cool. If I'd known that this server was a damn frozen wasteland, I'd have taken another outfit."
    no "Ah, isso é tão legal. Se eu soubesse que este servidor era um deserto congelado, teria escolhido outra roupa."

# game/script2.rpy:8996
translate brazil novamissedscene_b1fa784d:

#   no "Yep. Definitely gonna die here."
    no "Sim. Definitivamente vou morrer aqui."

# game/script2.rpy:8999
translate brazil novamissedscene_0e1e9cd2:

#   mc "*Patting her* Come on, come on, Nova." with dissolve
    mc "*Dá um tapinha nela* Vamos, vamos, Nova." with dissolve

# game/script2.rpy:9000
translate brazil novamissedscene_44ac2a4a:

#   mc "How can the world’s greatest and cutest hacker die in a random server of Eternum, just because of a little cold weather?"
    mc "Como o maior e mais fofo hacker do mundo pode morrer em um servidor aleatório de Eternum, só por causa de um pouco de frio?"

# game/script2.rpy:9001
translate brazil novamissedscene_0c1ef55e:

#   mc "That’s not very fitting for you."
    mc "Isso não é muito adequado para você."

# game/script2.rpy:9003
translate brazil novamissedscene_9d2b8060:

#   no "*Giggles* Y-Yeah, I guess you're right." with dis08
    no "*Risos* S-Sim, acho que você está certo." with dis08

# game/script2.rpy:9004
translate brazil novamissedscene_6b50f4fa:

#   no "I’ll keep pushing through the pain!"
    no "Vou continuar superando a dor!"

# game/script2.rpy:9007
translate brazil novamissedscene_c0a052cd:

#   mc "And hey, if we don’t find Calypso or an Exit Portal, I guess someone will end up disconnecting us in the real world. I know Dalia will, otherwise she’ll have to wash dishes tonight." with Dissolve(1.6)
    mc "E ei, se não encontrarmos o Calypso ou um Portal de Saída, acho que alguém vai acabar nos desconectando do mundo real. Eu sei que Dalia vai, caso contrário ela terá que lavar a louça esta noite." with Dissolve(1.6)

# game/script2.rpy:9008
translate brazil novamissedscene_eca6b106:

#   mc "So nobody here will be dying from hunger or the cold."
    mc "Portanto, ninguém aqui morrerá de fome ou de frio."

# game/script2.rpy:9010
translate brazil novamissedscene_a2cda9fe:

#   x "Oh, I recommend you not doing that to anyone... like, ever."
    x "Ah, eu recomendo que você não faça isso com ninguém... tipo, nunca."

# game/script2.rpy:9012
translate brazil novamissedscene_c16663e1:

#   mc "Doing what? Disconnecting someone who's playing?"
    mc "Fazendo o quê? Desconectando alguém que está jogando?"

# game/script2.rpy:9014
translate brazil novamissedscene_6951962c:

#   x "Yeah. That’s a big no-no. They say the abrupt shock can cause nerve damage, leading to epilepsy or cerebral palsy."
    x "Sim. Isso é uma grande proibição. Eles dizem que o choque abrupto pode causar danos aos nervos, levando à epilepsia ou paralisia cerebral."

# game/script2.rpy:9016
translate brazil novamissedscene_985dd303:

#   no "There have been cases of people becoming blind or paraplegic after they were forcibly disconnected during the middle of a game session."
    no "Houve casos de pessoas que ficaram cegas ou paraplégicas depois de serem desconectadas à força durante uma sessão de jogo."

# game/script2.rpy:9018
translate brazil novamissedscene_bddc95f6:

#   x "Those were rare occurrences, yes, and other people have ended up fine after a forced disconnect, but still... I wouldn't risk it."
    x "Essas foram ocorrências raras, sim, e outras pessoas ficaram bem após uma desconexão forçada, mas ainda assim... eu não arriscaria."

# game/script2.rpy:9020
translate brazil novamissedscene_b1e5b52a:

#   mc "Are you serious? People know about these risks? And they still keep playing?"
    mc "Você está falando sério? As pessoas sabem sobre esses riscos? E eles ainda continuam jogando?"

# game/script2.rpy:9021
translate brazil novamissedscene_8db86a34:

#   mc "How is that possible?"
    mc "Como isso é possível?"

# game/script2.rpy:9023
translate brazil novamissedscene_dcbcf02b:

#   x "Millions of people die worldwide from tobacco and alcohol each year, but both are perfectly legal and people continue to consume them."
    x "Milhões de pessoas morrem em todo o mundo devido ao tabaco e ao álcool todos os anos, mas ambos são perfeitamente legais e as pessoas continuam a consumi-los."

# game/script2.rpy:9024
translate brazil novamissedscene_697decac:

#   x "Why would this be any different?"
    x "Por que isso seria diferente?"

# game/script2.rpy:9026
translate brazil novamissedscene_8355276b:

#   mc "Fair point... I'm not gonna stop playing because of those risks either."
    mc "Justo... Também não vou parar de jogar por causa desses riscos."

# game/script2.rpy:9028
translate brazil novamissedscene_a5fc2fa9:

#   no "The only way to leave a server without an Exit Portal, and at the cost of losing your levels and inventory... is by killing yourself."
    no "A única maneira de sair de um servidor sem um Portal de Saída, e ao custo de perder seus níveis e inventário... é se matando."

# game/script2.rpy:9030
translate brazil novamissedscene_fc447b5b:

#   mc "God, I hope it won’t come to that..."
    mc "Deus, espero que não chegue a esse ponto..."

# game/script2.rpy:9033
translate brazil novamissedscene_f5da95a6:

#   mc "Do you think Calypso will be protected?" with Dissolve(1.4)
    mc "Você acha que Calypso estará protegido?" with Dissolve(1.4)

# game/script2.rpy:9035
translate brazil novamissedscene_7ee0747b:

#   no "Yeah, it's very likely."
    no "Sim, é muito provável."

# game/script2.rpy:9036
translate brazil novamissedscene_70f8118b:

#   no "The other Weapons of Atlas were heavily guarded. Not sure if Hyas was also, but Dione was definitely protected by Praetorians."
    no "As outras Armas do Atlas estavam fortemente guardadas. Não tenho certeza se Hyas também estava, mas Dione era definitivamente protegida pelos pretorianos."

# game/script2.rpy:9038
translate brazil novamissedscene_540c268e:

#   mc "Praetorians?! Eternum's \"police\"?"
    mc "Pretorianos?! A “polícia” do Eterno?"

# game/script2.rpy:9039
translate brazil novamissedscene_1088e9b3:

#   mc "How is that fair? Aren't they immortal?"
    mc "Como isso é justo? Eles não são imortais?"

# game/script2.rpy:9041
translate brazil novamissedscene_1db3cd75:

#   no "No! They're tougher than most, but they can die just like any other player or AI of Eternum."
    no "Não! Eles são mais resistentes do que a maioria, mas podem morrer como qualquer outro jogador ou IA de Eternum."

# game/script2.rpy:9042
translate brazil novamissedscene_98284172:

#   no "The only two people with immunity are Idriel and the Founder himself."
    no "As únicas duas pessoas com imunidade são Idriel e o próprio Fundador."

# game/script2.rpy:9043
translate brazil novamissedscene_d62b36b9:

#   no "Not even the senior managers of Ulysses are protected."
    no "Nem mesmo os gestores seniores da Ulysses estão protegidos."

# game/script2.rpy:9046
translate brazil novamissedscene_4177f6ac:

#   no "Speaking of which, what's it like to be the daughter of William Bardot, Alex?" with dis
    no "Falando nisso, como é ser filha de William Bardot, Alex?" with dis

# game/script2.rpy:9047
translate brazil novamissedscene_9faa26c8:

#   no "Has he ever told you any secrets about the company?"
    no "Ele já lhe contou algum segredo sobre a empresa?"

# game/script2.rpy:9049
translate brazil novamissedscene_03740060:

#   x "No. He never talks about his job." with dis
    x "Não. Ele nunca fala sobre seu trabalho." with dis

# game/script2.rpy:9050
translate brazil novamissedscene_d79c1fbe:

#   x "And... well, we don't even talk to each other anymore, so... I don’t have much of an answer for you."
    x "E... bem, nós nem nos falamos mais, então... não tenho muita resposta para você."

# game/script2.rpy:9053
translate brazil novamissedscene_04cacbb0:

#   no "Oh... I'm sorry I asked, I didn't know it was a more serious topic." with Dissolve(1.5)
    no "Ah... me desculpe por ter perguntado, não sabia que era um assunto mais sério." with Dissolve(1.5)

# game/script2.rpy:9056
translate brazil novamissedscene_374f2ef7:

#   x "Don't worry, I don't mind." with dis
    x "Não se preocupe, eu não me importo." with dis

# game/script2.rpy:9057
translate brazil novamissedscene_66699637:

#   x "The relationship with my family is... complicated. [mc] witnessed that firsthand."
    x "A relação com a minha família é... complicada. [mc] testemunhou isso em primeira mão."

# game/script2.rpy:9060
translate brazil novamissedscene_bc8d1a9e:

#   x "Can I ask you a personal question?" with Dissolve(1.5)
    x "Posso fazer uma pergunta pessoal?" with Dissolve(1.5)

# game/script2.rpy:9061
translate brazil novamissedscene_e47e5789:

#   x "What happened to your eye? If you don't mind me asking."
    x "O que aconteceu com seu olho? Se você não se importa que eu pergunte."

# game/script2.rpy:9063
translate brazil novamissedscene_035e6ded:

#   no "I don't mind at all."
    no "Eu não me importo nem um pouco."

# game/script2.rpy:9065
translate brazil novamissedscene_3dc60fb2:

#   no "Actually, I'm surprised that [mc] hasn’t asked me about it yet." with dis08
    no "Na verdade, estou surpreso que [mc] ainda não tenha me perguntado sobre isso." with dis08

# game/script2.rpy:9068
translate brazil novamissedscene_4f2b38bc:

#   mc "Well, before all of this, we were pretty much strangers to each other. I thought it would be rude if I asked you point-blank." with dis12
    mc "Bem, antes de tudo isso, éramos praticamente estranhos um para o outro. Achei que seria rude se eu perguntasse à queima-roupa." with dis12

# game/script2.rpy:9069
translate brazil novamissedscene_f391c21a:

#   mc "And then... well, honestly you’re pretty flamboyant so I had forgotten you were even wearing an eyepatch. I wouldn't say that's your defining trait."
    mc "E então... bem, honestamente, você é muito extravagante, então esqueci que você estava usando um tapa-olho. Eu não diria que essa é a sua característica definidora."

# game/script2.rpy:9071
translate brazil novamissedscene_cf0e0e39:

#   no "...I'm not sure if that was a compliment, but I'll take it as one."
    no "...Não tenho certeza se isso foi um elogio, mas vou considerar isso."

# game/script2.rpy:9073
translate brazil novamissedscene_bd506aaa:

#   no "Anyway, my left eye is still there and it works—I’m not blind or anything." with dis
    no "De qualquer forma, meu olho esquerdo ainda está lá e funciona – não sou cego nem nada." with dis

# game/script2.rpy:9074
translate brazil novamissedscene_62b6682c:

#   no "Actually, I have better eyesight in my left eye than in my right one."
    no "Na verdade, tenho melhor visão no olho esquerdo do que no direito."

# game/script2.rpy:9075
translate brazil novamissedscene_9ec3beb6:

#   no "But it's highly sensitive and gets irritated if I remove my patch for longer than an hour a day."
    no "Mas é altamente sensível e fica irritado se eu remover o adesivo por mais de uma hora por dia."

# game/script2.rpy:9077
translate brazil novamissedscene_2e38f831:

#   mc "Really? Even in Eternum?"
    mc "Realmente? Mesmo em Eternum?"

# game/script2.rpy:9079
translate brazil novamissedscene_761ee30a:

#   no "Yep. That's the downside of Eternum's ultra-scan."
    no "Sim. Essa é a desvantagem do ultrascan do Eternum."

# game/script2.rpy:9080
translate brazil novamissedscene_e01662ab:

#   no "Physical illnesses like a missing leg, or in my case a sensitive eye, are also carried over into the game."
    no "Doenças físicas como falta de uma perna ou, no meu caso, um olho sensível, também são transportadas para o jogo."

# game/script2.rpy:9082
translate brazil novamissedscene_390b5280:

#   mc "I guess I’d never really thought about it..."
    mc "Acho que nunca tinha pensado nisso..."

# game/script2.rpy:9083
translate brazil novamissedscene_cee99550:

#   mc "That’s actually a little... sad."
    mc "Na verdade, isso é um pouco... triste."

# game/script2.rpy:9085
translate brazil novamissedscene_744d413a:

#   x "Well, Ulysses isn't really known for its ethical practices and upstanding moral values."
    x "Bem, Ulysses não é realmente conhecido por suas práticas éticas e valores morais elevados."

# game/script2.rpy:9086
translate brazil novamissedscene_5eb698cd:

#   x "They could probably create something that allowed people with disabilities to play normally."
    x "Eles provavelmente poderiam criar algo que permitisse que pessoas com deficiência jogassem normalmente."

# game/script2.rpy:9087
translate brazil novamissedscene_fc427535:

#   x "But if it doesn't make them any money, then why would they?"
    x "Mas se isso não lhes rende nenhum dinheiro, então por que o fariam?"

# game/script2.rpy:9088
translate brazil novamissedscene_06f637a9:

#   x "That's all that matters to them."
    x "Isso é tudo que importa para eles."

# game/script2.rpy:9091
translate brazil novamissedscene_52b5baf0:

#   mc "You know, sometimes, I think if Ulysses really..." with dis12
    mc "Sabe, às vezes, penso que se Ulisses realmente..." with dis12

# game/script2.rpy:9097
translate brazil novamissedscene_28a1d1de:

#   mc "Hmm? What's wrong?" with dissolve
    mc "Hum? O que está errado?" with dissolve

# game/script2.rpy:9100
translate brazil novamissedscene_59730d9d:

#   x "A..." with dissolve
    x "UM..." with dissolve

# game/script2.rpy:9101
translate brazil novamissedscene_bf2ce818:

#   x "A village!"
    x "Uma aldeia!"

# game/script2.rpy:9102
translate brazil novamissedscene_c4fc8eed:

#   mc "Oh! Finally!"
    mc "Oh! Finalmente!"

# game/script2.rpy:9103
translate brazil novamissedscene_fd70ad33:

#   no "Thank god!"
    no "Graças a Deus!"

# game/script2.rpy:9104
translate brazil novamissedscene_ccb37eca:

#   no "I was just about to accept my fate!"
    no "Eu estava prestes a aceitar meu destino!"

# game/script2.rpy:9105
translate brazil novamissedscene_2eeb4230:

#   x "Let's go take a look!"
    x "Vamos dar uma olhada!"

# game/script2.rpy:9109
translate brazil novamissedscene_4e6558ed:

#   mc "Damn... this place is a ghost town." with dis08
    mc "Droga... este lugar é uma cidade fantasma." with dis08

# game/script2.rpy:9110
translate brazil novamissedscene_9d52b847:

#   mc "HELLO?" with hpunch
    mc "OLÁ?" with hpunch

# game/script2.rpy:9111
translate brazil novamissedscene_6eb59fe4:

#   echo "{i}{size=50}Hello... {nw}{w=1}" with dis
    echo "{i}{size=50}Olá... {nw}{w=1}" with dis

# game/script2.rpy:9112
translate brazil novamissedscene_0f5f5055:

#   echo "{i}{size=40}Hello... {nw}{w=1}" with dis
    echo "{i}{size=40}Olá... {nw}{w=1}" with dis

# game/script2.rpy:9113
translate brazil novamissedscene_bd5e71bf:

#   echo "{i}{size=30}Hello..." with dis
    echo "{i}{size=30}Olá..." with dis

# game/script2.rpy:9114
translate brazil novamissedscene_669bf787:

#   mc "Hmmm... maybe there should be NPCs here, but they haven't been implemented yet."
    mc "Hmmm... talvez devesse haver NPCs aqui, mas eles ainda não foram implementados."

# game/script2.rpy:9115
translate brazil novamissedscene_d9fd6850:

#   mc "Maybe that's why the server was inaccessible?"
    mc "Talvez seja por isso que o servidor estava inacessível?"

# game/script2.rpy:9116
translate brazil novamissedscene_da5b4b81:

#   no "Like we're playing on an unfinished build of the server?"
    no "Como se estivéssemos jogando em uma versão inacabada do servidor?"

# game/script2.rpy:9117
translate brazil novamissedscene_9131a2fd:

#   mc "Yeah, something like that."
    mc "Sim, algo assim."

# game/script2.rpy:9120
translate brazil novamissedscene_b567a066:

#   x "That house was completely empty." with dis12
    x "Aquela casa estava completamente vazia." with dis12

# game/script2.rpy:9121
translate brazil novamissedscene_d3624f2d:

#   x "No trace of anyone."
    x "Nenhum vestígio de ninguém."

# game/script2.rpy:9122
translate brazil novamissedscene_ae4a7ae4:

#   x "No scraps of clothing, no personal belongings... nothing."
