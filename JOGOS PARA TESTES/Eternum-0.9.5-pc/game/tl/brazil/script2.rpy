translate brazil alexquestions_75d74f9d:

#   mc "So... tell me about your family." with dissolve
    mc "Então... conte-me sobre sua família." with dissolve

# game/script2.rpy:6099
translate brazil alexquestions_3aee3fee:

#   x "Ahhh... I knew this one was coming." with dis
    x "Ahhh... eu sabia que essa estava chegando." with dis

# game/script2.rpy:6100
translate brazil alexquestions_116bbdbc:

#   x "Well, the Bardot family..."
    x "Bem, a família Bardot..."

