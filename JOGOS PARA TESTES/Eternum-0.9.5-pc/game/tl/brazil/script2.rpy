#   mc "There are only three of them!"
    mc "Existem apenas três deles!"

# game/script2.rpy:9342
translate brazil novamissedscene_d9b26ac6:

#   x "Look around you, [mc]." with dis
    x "Olhe ao seu redor, [mc]." with dis

# game/script2.rpy:9343
translate brazil novamissedscene_d674a301:

#   x "We are surrounded."
    x "Estamos cercados."

# game/script2.rpy:9344
translate brazil novamissedscene_2927069c:

#   x "The second I remove the barrier, a flood of arrows will rain upon us."
    x "Assim que eu remover a barreira, uma enxurrada de flechas cairá sobre nós."

# game/script2.rpy:9345
translate brazil novamissedscene_c93a304f:

#   mc "Oh, fuck..."
    mc "Ah, porra..."

# game/script2.rpy:9347
translate brazil novamissedscene_fe1b5d31:

#   x "We're fucked..." with dis
    x "Estamos fodidos..." with dis

# game/script2.rpy:9349
translate brazil novamissedscene_264a83ef:

#   pra "Surrender now. This is your last warning." with dis08
    pra "Renda-se agora. Este é o seu último aviso." with dis08

# game/script2.rpy:9351
translate brazil novamissedscene_6e274a19:

#   x "*Voice breaking* I... I don't wanna die, [mc]." with dis08
    x "*Voz embargada* Eu... eu não quero morrer, [mc]." with dis08

# game/script2.rpy:9352
translate brazil novamissedscene_d2ca5269:

#   mc "(Shit, I've never seen her so scared...)"
    mc "(Merda, nunca a vi tão assustada...)"

# game/script2.rpy:9353
translate brazil novamissedscene_097ef90f:

#   x "*Voice breaking* They’d just say I had a heart attack swimming or some shit and then forget all about me."
    x "*Voz quebrada* Eles simplesmente diriam que tive um ataque cardíaco nadando ou algo assim e depois esqueceriam tudo sobre mim."

# game/script2.rpy:9354
translate brazil novamissedscene_5f968094:

#   mc "We’re gonna figure a way out of this, Alex."
    mc "Vamos descobrir uma maneira de sair disto, Alex."

# game/script2.rpy:9355
translate brazil novamissedscene_be39d42d:

#   x "But they’re everywhere!"
    x "Mas eles estão por toda parte!"

# game/script2.rpy:9356
translate brazil novamissedscene_026cb17e:

#   mc "Listen to me, this is not the end. We are not gonna die here."
    mc "Ouça-me, este não é o fim. Não vamos morrer aqui."

# game/script2.rpy:9357
translate brazil novamissedscene_9854acb2:

#   x "But what can we do?"
    x "Mas o que podemos fazer?"

# game/script2.rpy:9363
translate brazil novamissedscene_02885f13:

#   no "Well... I only see one solution." with dissolve
    no "Bem... só vejo uma solução." with dissolve

# game/script2.rpy:9364
translate brazil novamissedscene_6327861b:

#   no "Because there’s no way in hell I’m dying here either."
    no "Porque não há nenhuma maneira de eu morrer aqui também."

# game/script2.rpy:9365
translate brazil novamissedscene_3ae111cb:

#   no "There's still so much I want to do in this life."
    no "Ainda há tanta coisa que quero fazer nesta vida."

# game/script2.rpy:9367
translate brazil novamissedscene_49bdbdee:

#   x "What?"
    x "O que?"

# game/script2.rpy:9368
translate brazil novamissedscene_16539c23:

#   x "That sniper..."
    x "Aquele atirador..."

# game/script2.rpy:9369
translate brazil novamissedscene_f9299cd8:

#   x "I've seen it before..."
    x "Eu já vi isso antes..."

# game/script2.rpy:9370
translate brazil novamissedscene_31f608b7:

#   x "T-That's... Dione! The second Weapon of Atlas!"
    x "I-Isso é... Dione! A segunda arma do Atlas!"

# game/script2.rpy:9372
translate brazil novamissedscene_cb541d2b:

#   no "I think there’s only 2 Praetorians who are leading the charge. If we get rid of them, the warriors will lose formation."
    no "Acho que há apenas dois pretorianos liderando o ataque. Se nos livrarmos deles, os guerreiros perderão a formação."

# game/script2.rpy:9374
translate brazil novamissedscene_f379b6c8:

#   no "The other Praetorian is up there, on top of the hill." with dis
    no "O outro Pretoriano está lá em cima, no topo da colina." with dis

# game/script2.rpy:9375
translate brazil novamissedscene_48679022:

#   no "And she has a sniper rifle too. She's probably their backup plan."
    no "E ela também tem um rifle de precisão. Ela provavelmente é o plano reserva deles."

# game/script2.rpy:9377
translate brazil novamissedscene_227c69a9:

#   pra "What? Did she see me from there?" with dis
    pra "O que? Ela me viu de lá?" with dis

# game/script2.rpy:9378
translate brazil novamissedscene_a0385fb8:

#   pra "Huh, she’s got sharp eyes."
    pra "Huh, ela tem olhos afiados."

# game/script2.rpy:9380
translate brazil novamissedscene_f8ce7a26:

#   no "I think she's about 480 yards away. Maybe 490." with dis
    no "Acho que ela está a cerca de 480 metros de distância. Talvez 490." with dis

# game/script2.rpy:9381
translate brazil novamissedscene_e74bd55c:

#   no "I'd say it's a little hypocritical to accuse us of cheating, only to then use a sniper rifle on a medieval server... don't you think?"
    no "Eu diria que é um pouco hipócrita nos acusar de trapaça e depois usar um rifle de precisão em um servidor medieval... você não acha?"

# game/script2.rpy:9383
translate brazil novamissedscene_8e6858e3:

#   pra "Say whatever you want. You're just delaying the inevitable."
    pra "Diga o que quiser. Você está apenas atrasando o inevitável."

# game/script2.rpy:9385
translate brazil novamissedscene_70b29089:

#   mc "Y-Y-You have Dione?! But I thought it was owned by a... Delilah Warren, or something!" with dis
    mc "V-V-Você está com Dione?! Mas pensei que fosse propriedade de uma... Delilah Warren, ou algo assim!" with dis

# game/script2.rpy:9387
translate brazil novamissedscene_4318cd3a:

#   no "*Giggles* Pretty cool name, huh?" with dis
    no "*Risos* Nome muito legal, hein?" with dis

# game/script2.rpy:9388
translate brazil novamissedscene_1efaea6b:

#   mc "But why?"
    mc "Mas por que?"

# game/script2.rpy:9389
translate brazil novamissedscene_11431469:

#   no "Have you forgotten? The foundation of a hacker lifestyle is anonymity, [mc]."
    no "Você esqueceu? A base do estilo de vida hacker é o anonimato, [mc]."

# game/script2.rpy:9390
translate brazil novamissedscene_0c6a4e9c:

#   no "And let's be honest, Delilah Warren is a lot catchier than Nova Johnson."
    no "E sejamos honestos, Delilah Warren é muito mais cativante que Nova Johnson."

# game/script2.rpy:9393
translate brazil novamissedscene_660928f4:

#   no "And Dione is not just a sniper. It can transform into any kind of ranged weapon." with dissolve
    no "E Dione não é apenas um atirador de elite. Pode se transformar em qualquer tipo de arma de longo alcance." with dissolve

# game/script2.rpy:9394
translate brazil novamissedscene_18e1794d:

#   no "Hmm, but I think I’ll stick with this set-up today. I’m gonna need it for that Queen of the Hill up there."
    no "Hmm, mas acho que vou continuar com essa configuração hoje. Vou precisar dele para aquela Rainha da Colina lá em cima."

# game/script2.rpy:9398
translate brazil novamissedscene_9f9991c2:

#   no "I'll take care of that one, Alex." with dis12
    no "Eu cuidarei disso, Alex." with dis12

# game/script2.rpy:9399
translate brazil novamissedscene_c5e269a4:

#   no "Then I’ll deal with the archers in the trees and on the roofs."
    no "Depois cuidarei dos arqueiros nas árvores e nos telhados."

# game/script2.rpy:9400
translate brazil novamissedscene_605d2f1b:

#   no "Can I count on you to kill the other Praetorian leader?"
    no "Posso contar com você para matar o outro líder Pretoriano?"

# game/script2.rpy:9402
translate brazil novamissedscene_dfe8da7a:

#   x "The other Praetorian...?"
    x "O outro pretoriano...?"

# game/script2.rpy:9404
translate brazil novamissedscene_012ae4b8:

#   x "You can count on me, Nova. I got this bitch." with dis
    x "Você pode contar comigo, Nova. Eu peguei essa vadia." with dis

# game/script2.rpy:9406
translate brazil novamissedscene_b7cbc432:

#   mc "Holy shit, I can't believe it! You have Dione, the weapon whose bullets never miss their targets!" with dis
    mc "Puta merda, não acredito! Você tem Dione, a arma cujas balas nunca erram o alvo!" with dis

# game/script2.rpy:9407
translate brazil novamissedscene_9a4e4c18:

#   mc "We can win this fight!"
    mc "Podemos vencer essa luta!"

# game/script2.rpy:9409
translate brazil novamissedscene_c5998603:

#   no "*Giggles* Sorry [mc], I'm afraid that's only a rumor people have made up." with dissolve
    no "*Risos* Desculpe [mc], temo que seja apenas um boato que as pessoas inventaram." with dissolve

# game/script2.rpy:9410
translate brazil novamissedscene_b5c6dea0:

#   no "Its real unique ability is being able to transform into any type of firearm."
    no "Sua verdadeira habilidade única é poder se transformar em qualquer tipo de arma de fogo."

# game/script2.rpy:9411
translate brazil novamissedscene_d9d678cd:

#   no "Also, each bullet is fired with its cartridge, specially outfitted with tracking capabilities and thus allowing the user to teleport to its location."
    no "Além disso, cada bala é disparada com seu cartucho, especialmente equipado com recursos de rastreamento e permitindo assim ao usuário se teletransportar para sua localização."

# game/script2.rpy:9413
translate brazil novamissedscene_5f8e57c0:

#   pra "What? Is she seriously trying to snipe me from there?"
    pra "O que? Ela está seriamente tentando me atirar de lá?"

# game/script2.rpy:9414
translate brazil novamissedscene_0d908361:

#   pra "*Mockingly laughs* Good luck with that. Dione is the weakest of the three for a reason."
    pra "*Ri zombeteiramente* Boa sorte com isso. Dione é a mais fraca das três por um motivo."

# game/script2.rpy:9416
translate brazil novamissedscene_bc369c9e:

#   mc "Teleport to where its bullets travel? What the hell is the point of that?"
    mc "Teletransportar-se para onde suas balas viajam? Qual é o objetivo disso?"

# game/script2.rpy:9418
translate brazil novamissedscene_c022b8f7:

#   no "Well, very few things are faster than a bullet. So with that kind of speed, you can cover large distances in a matter of seconds, or even make for a quick escape." with dissolve
    no "Bem, poucas coisas são mais rápidas que uma bala. Assim, com esse tipo de velocidade, você pode percorrer grandes distâncias em questão de segundos, ou até mesmo escapar rapidamente." with dissolve

# game/script2.rpy:9420
translate brazil novamissedscene_d4342775:

#   mc "But... Alex's barrier will break the moment you shoot!" with dissolve
    mc "Mas... a barreira de Alex quebrará no momento em que você atirar!" with dissolve

# game/script2.rpy:9421
translate brazil novamissedscene_96c89101:

#   mc "If you miss the shot, the other Praetorian will easily snipe us! She has the high ground! Obi-Wan taught us the importance of that!"
    mc "Se você errar o tiro, o outro Pretoriano nos atirará facilmente! Ela tem o terreno elevado! Obi-Wan nos ensinou a importância disso!"

# game/script2.rpy:9423
translate brazil novamissedscene_e4330f32:

#   no "Well you know what they say about rumors, [mc]?" with dissolve
    no "Bem, você sabe o que dizem sobre rumores, [mc]?" with dissolve

# game/script2.rpy:9424
translate brazil novamissedscene_52caa5ad:

#   no "There’s usually a hint of truth to them."
    no "Geralmente há um toque de verdade neles."

# game/script2.rpy:9425
translate brazil novamissedscene_73d993b6:

#   no "In this case, the one that never misses... isn’t Dione..."
    no "Nesse caso quem nunca erra... não é a Dione..."

# game/script2.rpy:9431
translate brazil novamissedscene_9618b9f7:

#   no "It's me." with dis
    no "Sou eu." with dis

# game/script2.rpy:9440
translate brazil novamissedscene_b9fe2deb:

#   no ". . ." with dis
    no ". . ." with dis

# game/script2.rpy:9443
translate brazil novamissedscene_5e370532:

#   no "47 shots fired with Dione and 46 confirmed kills." with dis
    no "47 tiros disparados com Dione e 46 mortes confirmadas." with dis

# game/script2.rpy:9444
translate brazil novamissedscene_5d76d209:

#   no "Yeah, I missed a shot once, but don't tell anyone, alright? I have a reputation to uphold."
    no "Sim, perdi um tiro uma vez, mas não conte a ninguém, certo? Tenho uma reputação a defender."

# game/script2.rpy:9445
translate brazil novamissedscene_5c143015:

#   pra ". . ."
    pra ". . ."

# game/script2.rpy:9449
translate brazil novamissedscene_9b3eea6b:

#   no "I hope you don't mind me taking your spot. The view is just gorgeous up here!" with dissolve
    no "Espero que você não se importe que eu ocupe seu lugar. A vista é simplesmente linda aqui em cima!" with dissolve

# game/script2.rpy:9450
translate brazil novamissedscene_d572552b:

#   no "And please, don't take it personally. I’m just not ready to die quite yet."
    no "E por favor, não leve isso para o lado pessoal. Só não estou pronto para morrer ainda."

# game/script2.rpy:9451
translate brazil novamissedscene_e424cd79:

#   no "I at least have to make it to next Monday. Luna's father told me he's introducing a new taco to the menu. I’ve been {i}dying{/i} to try it..."
    no "Pelo menos tenho que chegar até a próxima segunda-feira. O pai de Luna me disse que está introduzindo um novo taco no cardápio. Estou {i}morrendo{/i} de experimentar..."

# game/script2.rpy:9452
translate brazil novamissedscene_4af1d94c:

#   no "And well, past that... I just made some new friends. We still have a lot of adventures ahead of us. I'm sure you understand."
    no "E bem, além disso... acabei de fazer alguns novos amigos. Ainda temos muitas aventuras pela frente. Tenho certeza que você entende."

# game/script2.rpy:9454
translate brazil novamissedscene_a1d75303:

#   no "My left eye helps, for sure, but the trick is to control your breathing, calculate the distance, account for the Coriolis effect, and of course factor in the wind." with dis
    no "Meu olho esquerdo ajuda, com certeza, mas o truque é controlar a respiração, calcular a distância, levar em conta o efeito Coriolis e, claro, levar em consideração o vento." with dis

# game/script2.rpy:9455
translate brazil novamissedscene_764d9be1:

#   no "Never rush. Take your time. Don’t stiffen up. Stay relaxed."
    no "Nunca se apresse. Sem pressa. Não endureça. Fique relaxado."

# game/script2.rpy:9456
translate brazil novamissedscene_d676a0e8:

#   no "Just keep your eye on the target..."
    no "Basta ficar de olho no alvo..."

# game/script2.rpy:9457
translate brazil novamissedscene_e09d4cd3:

#   no "...and then {i}slowly{/i} squeeze the trigger." with dis12
    no "...e então {i}lentamente{/i} aperte o gatilho." with dis12

# game/script2.rpy:9476
translate brazil novamissedscene_402740c2:

#   x "*Chuckles*" with dis
    x "*Risos*" with dis

# game/script2.rpy:9478
translate brazil novamissedscene_bfb70894:

#   sol "W-What the fuck?!" with dis12
    sol "Que porra é essa?!" with dis12

# game/script2.rpy:9479
translate brazil novamissedscene_4bee520f:

#   sol2 "She just headshot Mia and Emma!"
    sol2 "Ela acabou de atirar na cabeça de Mia e Emma!"

# game/script2.rpy:9481
translate brazil novamissedscene_f2e9c6e5:

#   x "You know, it always amazes me to see how you... a fucking computer program... can show such pure emotion."
    x "Sabe, sempre me surpreende ver como você... um maldito programa de computador... consegue demonstrar emoções tão puras."

# game/script2.rpy:9483
translate brazil novamissedscene_e8db7304:

#   pra "What?" with dis
    pra "O que?" with dis

# game/script2.rpy:9486
translate brazil novamissedscene_8128daf3:

#   x "The look on your face... it was pure terror." with dis
    x "A expressão no seu rosto... era puro terror." with dis

# game/script2.rpy:9487
translate brazil novamissedscene_bf5a42a2:

#   x "I must applaud the great work that Ulysses did when creating you. You almost look human."
    x "Devo aplaudir o excelente trabalho que Ulisses fez ao criar você. Você quase parece humano."

# game/script2.rpy:9489
translate brazil novamissedscene_23087b7d:

#   pra "Say whatever you want. Your fate remains the same."
    pra "Diga o que quiser. Seu destino permanece o mesmo."

# game/script2.rpy:9490
translate brazil novamissedscene_da45eb79:

#   pra "Seize her!"
    pra "Agarre-a!"

# game/script2.rpy:9492
translate brazil novamissedscene_23e042de:

#   x "I think your friends are scared shitless."
    x "Acho que seus amigos estão morrendo de medo."

# game/script2.rpy:9493
translate brazil novamissedscene_43574991:

#   x "You should have brought more Praetorians. What's the problem? Storage space getting too expensive for all your buddies?"
    x "Você deveria ter trazido mais Pretorianos. Qual é o problema? O espaço de armazenamento está ficando muito caro para todos os seus amigos?"

# game/script2.rpy:9495
translate brazil novamissedscene_4b0044b8:

#   pra "Enough. Your session is to be terminated and you will be excommunicated from the server."
    pra "Suficiente. Sua sessão será encerrada e você será excomungado do servidor."

# game/script2.rpy:9497
translate brazil novamissedscene_afe039bf:

#   x "Always the same speech. Maybe you’re due for a software update, or something."
    x "Sempre o mesmo discurso. Talvez você precise de uma atualização de software ou algo assim."

# game/script2.rpy:9499
translate brazil novamissedscene_19cd3f7a:

#   pra "You do not stand a chance against me."
    pra "Você não tem chance contra mim."

# game/script2.rpy:9501
translate brazil novamissedscene_e08e6842:

#   x "We'll see about that..." with dis12
    x "Veremos sobre isso..." with dis12

# game/script2.rpy:9512
translate brazil novamissedscene_c2da57ef:

#   x ". . ." with dissolve
    x ". . ." with dissolve

# game/script2.rpy:9513
translate brazil novamissedscene_ff1e9f52:

#   sol "S-She's a shapeshifter!"
    sol "Ela é uma metamorfa!"

# game/script2.rpy:9515
translate brazil novamissedscene_cc7db8da:

#   pra "You will regret this..." with Dissolve(1.5)
    pra "Você vai se arrepender disso..." with Dissolve(1.5)

# game/script2.rpy:9516
translate brazil novamissedscene_6cffd513:

#   pra "All three of you."
    pra "Vocês três."

# game/script2.rpy:9535
translate brazil novamissedscene_77dbb9a3:

#   sol "F-FUCK! RUN!" with dis
    sol "PORRA! CORRER!" with dis

# game/script2.rpy:9536
translate brazil novamissedscene_7d5a11e8:

#   sol2 "I told you we should have never accepted this job!"
    sol2 "Eu disse que nunca deveríamos ter aceitado esse trabalho!"

# game/script2.rpy:9537
translate brazil novamissedscene_f3b3feef:

#   sol "I didn't even know Praetorians could be killed! At 300 eternals an hour, this was supposed to be the job of a lifetime!"
    sol "Eu nem sabia que os Pretorianos poderiam ser mortos! A 300 eternos por hora, este deveria ser o trabalho de uma vida inteira!"

# game/script2.rpy:9538
translate brazil novamissedscene_4e146d67:

#   sol2 "And now we're gonna lose everything we’ve earned in this lifetime!"
    sol2 "E agora vamos perder tudo o que ganhamos nesta vida!"

# game/script2.rpy:9539
translate brazil novamissedscene_82102453:

#   sol2 "We should’ve just gotten those jobs at Aphrodite’s!"
    sol2 "Devíamos ter conseguido aqueles empregos na casa de Afrodite!"

# game/script2.rpy:9540
translate brazil novamissedscene_30b0761f:

#   sol "I-It's okay!"
    sol "Eu-está tudo bem!"

# game/script2.rpy:9541
translate brazil novamissedscene_34357189:

#   sol "I think that bitch ran off already!"
    sol "Acho que aquela vadia já fugiu!"

# game/script2.rpy:9542
translate brazil novamissedscene_cc0c8975:

#   sol "Maintaining that form consumes a great deal of energy, she probably went to..."
    sol "Manter essa forma consome muita energia, ela provavelmente foi para..."

# game/script2.rpy:9547
translate brazil novamissedscene_0264638a:

#   x "*Crushing her to the ground*" with vpunch
    x "*Esmagando-a no chão*" with vpunch

# game/script2.rpy:9551
translate brazil novamissedscene_fa57b31d:

#   x "*Tail swipe*" with hpunch
    x "*Golpe de cauda*" with hpunch

# game/script2.rpy:9559
translate brazil novamissedscene_b6b8ef3f:

#   mc "(Oh my fucking god...)" with dis
    mc "(Oh meu Deus, porra...)" with dis

# game/script2.rpy:9560
translate brazil novamissedscene_e27d028d:

#   mc "(They're all amazing...)"
    mc "(Eles são todos incríveis...)"

# game/script2.rpy:9562
translate brazil novamissedscene_f955575e:

#   mc "(Annie, Dalia, Luna, Nova, Alex...)" with dis12
    mc "(Annie, Dália, Luna, Nova, Alex...)" with dis12

# game/script2.rpy:9563
translate brazil novamissedscene_3eb267cc:

#   mc "(They're all such amazing players... while I’m here being about as useful as bacon at a vegan restaurant.)"
    mc "(Eles são todos jogadores incríveis... enquanto eu estou aqui sendo tão útil quanto bacon em um restaurante vegano.)"

# game/script2.rpy:9566
translate brazil novamissedscene_82afad34:

#   mc "(Alright. It’s time for me to start pulling my weight. From now on, I'll stop being useless.)" with dis12
    mc "(Tudo bem. É hora de começar a puxar meu peso. De agora em diante, deixarei de ser inútil.)" with dis12

# game/script2.rpy:9567
translate brazil novamissedscene_4f9cf007:

#   mc "(I'll go to the gym every day, study guides online, and play on my own to get experience and good items.)"
    mc "(Vou à academia todos os dias, estudo guias online e jogo sozinho para ganhar experiência e bons itens.)"

# game/script2.rpy:9568
translate brazil novamissedscene_d4ccc062:

#   mc "(I promise. You owe it to yourself, [mc].)"
