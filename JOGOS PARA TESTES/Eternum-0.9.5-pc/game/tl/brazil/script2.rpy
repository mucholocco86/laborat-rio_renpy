#   x "Paid for with MY money." with dissolve
    x "Pago com MEU dinheiro." with dissolve

# game/script2.rpy:6156
translate brazil alexquestions_203bbd1b:

#   x "And soon I’m going to leave this place too, once I have enough saved up."
    x "E em breve vou deixar este lugar também, assim que tiver economizado o suficiente."

