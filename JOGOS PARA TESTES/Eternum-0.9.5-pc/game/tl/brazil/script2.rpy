#   kai "And then exhale very slowly as we transition onto our final pose..."
    kai "E então expire bem lentamente enquanto fazemos a transição para nossa postura final..."

# game/script2.rpy:4949
translate brazil nancygym_a22a06fc:

#   n "*Exhales slowly*" with Dissolve(1.5)
    n "*Expira lentamente*" with Dissolve(1.5)

# game/script2.rpy:4950
translate brazil nancygym_47f7361b:

#   kai "Perfect, Nancy... your graceful movements are simply unmatched..."
    kai "Perfeito, Nancy... seus movimentos graciosos são simplesmente incomparáveis..."

# game/script2.rpy:4954
