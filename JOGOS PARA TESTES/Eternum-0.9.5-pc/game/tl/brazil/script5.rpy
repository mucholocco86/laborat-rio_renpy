#   mc "Well, well, well... it took you a whopping 2 seconds to answer the phone this time, Nova."
    mc "Bem, bem, bem... desta vez você demorou 2 segundos para atender o telefone, Nova."

# game/script5.rpy:12243
translate brazil thanahouse_2589bcc8:

#   mc "Is everything alright? Did something happen?"
    mc "Está tudo bem? Aconteceu alguma coisa?"

# game/script5.rpy:12246
translate brazil thanahouse_ac5a63b1:

#   no "It's not my fault! I was on the other side of the room sorting my manga collection."
    no "Não é minha culpa! Eu estava do outro lado da sala organizando minha coleção de mangás."

# game/script5.rpy:12247
translate brazil thanahouse_e34d07a9:

#   no "That's like... a solid 10 feet!"
    no "Isso é como... uns sólidos 3 metros!"

# game/script5.rpy:12250
translate brazil thanahouse_231b8d40:

#   no "And well, I'm still a little hungover, so that slowed my speed." with dissolve
    no "E bem, ainda estou com um pouco de ressaca, então isso diminuiu minha velocidade." with dissolve

# game/script5.rpy:12253
translate brazil thanahouse_5c554092:

#   mc "Yeah, I meant to ask you about that, are you feeling better?"
    mc "Sim, eu queria te perguntar sobre isso, você está se sentindo melhor?"

# game/script5.rpy:12256
translate brazil thanahouse_a332dc1e:

#   no "Definitely!"
    no "Definitivamente!"

# game/script5.rpy:12257
translate brazil thanahouse_d288140e:

#   no "I got up at 3 PM, took a shower, washed out the blue dye from my hair, scarfed down some food, and... well, it's been raining since then, so I didn't do much else."
    no "Acordei às 15h, tomei banho, lavei a tinta azul do cabelo, comi um pouco e... bem, está chovendo desde então, então não fiz muito mais."

# game/script5.rpy:12259
translate brazil thanahouse_409498cc:

#   no "Ah, and my mom scolded me for having my eye uncovered for so long last night." with dissolve
    no "Ah, e minha mãe me repreendeu por ter deixado meu olho descoberto por tanto tempo na noite passada." with dissolve

# game/script5.rpy:12262
translate brazil thanahouse_f3378e2e:

#   mc "Oh, right! Does it hurt you now?"
    mc "Ah, certo! Isso te machuca agora?"

# game/script5.rpy:12265
translate brazil thanahouse_4a36f8c8:

#   no "Not at all!"
    no "De jeito nenhum!"

# game/script5.rpy:12267
translate brazil thanahouse_2ed81a42:

#   no "I mean... well, it hurt a little when I came back from the party, but... nothing to worry about." with dissolve
    no "Quer dizer... bem, doeu um pouco quando voltei da festa, mas... nada com que se preocupar." with dissolve

# game/script5.rpy:12268
translate brazil thanahouse_cb6f49ac:

#   no "I know my limits. My mom’s just being a worrywart."
    no "Eu conheço meus limites. Minha mãe está apenas sendo preocupada."

# game/script5.rpy:12274
translate brazil thanahouse_3dc44510:

#   mc "*Awkward laugh* Oh... yeah, the party... I'm sorry I left early, I wasn't feeling that well."
    mc "*Ridinha estranha* Ah... sim, a festa... Me desculpe por ter saído mais cedo, não estava me sentindo muito bem."

# game/script5.rpy:12277
translate brazil thanahouse_db2e7a98:

#   no "It's okay, don't worry. We left early as well."
    no "Está tudo bem, não se preocupe. Saímos cedo também."

# game/script5.rpy:12279
translate brazil thanahouse_c75f3a8e:

#   no "Penny looked a bit sad, though. Or... maybe she was mad. I'm not sure." with dissolve
    no "Penny parecia um pouco triste, no entanto. Ou... talvez ela estivesse brava. Eu não tenho certeza." with dissolve

# game/script5.rpy:12280
translate brazil thanahouse_db091841:

#   mct "Oh shit, I hope she's not angry with me."
    mct "Oh merda, espero que ela não esteja com raiva de mim."

# game/script5.rpy:12282
translate brazil thanahouse_e27b112c:

#   no "But anyway, what are you up to?" with dissolve
    no "Mas afinal, o que você está fazendo?" with dissolve

# game/script5.rpy:12283
translate brazil thanahouse_2e8df80a:

#   no "How did the mission go? Do you have Thanatos' name?"
    no "Como foi a missão? Você tem o nome de Thanatos?"

# game/script5.rpy:12286
translate brazil thanahouse_8e3d2e56:

#   n "We do!"
    n "Nós fazemos!"

# game/script5.rpy:12289
translate brazil thanahouse_ea900b61:

#   no "Oh, hi, Nancy!"
    no "Ah, oi, Nanci!"

# game/script5.rpy:12290
translate brazil thanahouse_bf1c4025:

#   no "That's great news!"
    no "Isso é uma ótima notícia!"

# game/script5.rpy:12293
translate brazil thanahouse_0a6673cf:

#   n "We even found the address he used to initially register with Ulysses! Since it was relatively close, we decided to come immediately."
    n "Encontramos até o endereço que ele usou para se registrar inicialmente no Ulysses! Como estava relativamente perto, decidimos vir imediatamente."

# game/script5.rpy:12294
translate brazil thanahouse_588935da:

#   n "Unfortunately, the house is completely abandoned."
    n "Infelizmente, a casa está completamente abandonada."

# game/script5.rpy:12297
translate brazil thanahouse_195daf9c:

#   no "Agh, that sucks."
    no "Ah, isso é uma merda."

# game/script5.rpy:12298
translate brazil thanahouse_c4574b83:

#   no "Maybe he moved?"
    no "Talvez ele tenha se mudado?"

# game/script5.rpy:12301
translate brazil thanahouse_3f0ecf96:

#   n "Yeah, we thought the same."
    n "Sim, pensamos o mesmo."

# game/script5.rpy:12302
translate brazil thanahouse_b59bc6c8:

#   n "Would you be able to discover his current address if we gave you his name?"
    n "Você seria capaz de descobrir o endereço atual dele se lhe disséssemos o nome dele?"

# game/script5.rpy:12305
translate brazil thanahouse_b267d5fb:

#   no "Please, that's like asking a weightlifting champ if he can do 10 pushups."
    no "Por favor, é como perguntar a um campeão de levantamento de peso se ele consegue fazer 10 flexões."

# game/script5.rpy:12306
translate brazil thanahouse_86a4d19f:

#   no "Easy peasy!"
    no "Fácil!"

# game/script5.rpy:12310
translate brazil thanahouse_5e038d57:

#   no "I just need his full name, and I'll be able to give you his current address and all of his social networks in less than... 15 seconds." with dis12
    no "Só preciso do nome completo dele e poderei lhe dar o endereço atual e todas as redes sociais em menos de... 15 segundos." with dis12

# game/script5.rpy:12314
translate brazil thanahouse_d2488ae8:

#   mc "Really? And how are you gonna do that?"
    mc "Realmente? E como você vai fazer isso?"

# game/script5.rpy:12318
translate brazil thanahouse_d3237113:

#   no "A magician never reveals her tricks, [mc]!"
    no "Um mágico nunca revela seus truques, [mc]!"

# game/script5.rpy:12322
translate brazil thanahouse_ed0d3d42:

#   n "Okay, so... his name is Wyatt R. Pitman."
    n "Ok, então... o nome dele é Wyatt R. Pitman."

# game/script5.rpy:12323
translate brazil thanahouse_cbb38ae4:

#   n "He was born on February 17, 1999. And the address he registered with was 230 Old Ridge Trail, Evergreen, WA."
    n "Ele nasceu em 17 de fevereiro de 1999. E o endereço em que se registrou era 230 Old Ridge Trail, Evergreen, WA."

# game/script5.rpy:12327
translate brazil thanahouse_300e0297:

#   no "Got it!"
    no "Entendi!"

# game/script5.rpy:12328
translate brazil thanahouse_4fd647ae:

#   no "Give me one second..."
    no "Me dê um segundo..."

# game/script5.rpy:12329
translate brazil thanahouse_42835727:

#   no "And..."
    no "E..."

# game/script5.rpy:12332
translate brazil thanahouse_87d8d993:

#   no "Uh..." with dis08
    no "Uh..." with dis08

# game/script5.rpy:12333
translate brazil thanahouse_6d078993:

#   no "Wyatt R. Pitman, Evergreen, you said?"
    no "Wyatt R. Pitman, Evergreen, você disse?"

# game/script5.rpy:12334
translate brazil thanahouse_11413f6b:

#   no "W-Y-A-T-T R P-I-T-M-A-N?"
    no "W-Y-A-T-T R P-I-T-M-A-N?"

# game/script5.rpy:12337
translate brazil thanahouse_9830d96a:

#   n "Yes! Is there any problem?"
    n "Sim! Existe algum problema?"

# game/script5.rpy:12340
translate brazil thanahouse_7e724d59:

#   no "Um... I have bad news, guys. That guy is not Thanatos."
    no "Hum... tenho más notícias, pessoal. Esse cara não é Thanatos."

# game/script5.rpy:12341
translate brazil thanahouse_26aa59f7:

#   no "Must be a fake name."
    no "Deve ser um nome falso."

# game/script5.rpy:12343
translate brazil thanahouse_e1b3584e:

#   no "He's cleverer than we thought..." with dissolve
    no "Ele é mais inteligente do que pensávamos..." with dissolve

# game/script5.rpy:12346
translate brazil thanahouse_62be6370:

#   n "Huh? Why are you so sure?"
    n "Huh? Por que você tem tanta certeza?"

# game/script5.rpy:12349
translate brazil thanahouse_e786fd58:

#   no "Well... you were right, he did move 5 years ago."
    no "Bem... você estava certo, ele se mudou há 5 anos."

# game/script5.rpy:12350
translate brazil thanahouse_a5817fa4:

#   no "His new address is... Section 8, Stone 19, Evergreen Cemetery."
    no "Seu novo endereço é... Seção 8, Pedra 19, Cemitério Evergreen."

# game/script5.rpy:12351
translate brazil thanahouse_62e3b62c:

#   no "He's... dead."
    no "Ele está... morto."

# game/script5.rpy:12354
translate brazil thanahouse_18f30c1f:

#   n "What?! Wyatt R. Pitman died 5 years ago?!"
    n "O que?! Wyatt R. Pitman morreu há 5 anos?!"

# game/script5.rpy:12355
translate brazil thanahouse_a001533c:

#   n "Are you sure?"
    n "Tem certeza?"

# game/script5.rpy:12358
translate brazil thanahouse_c24d647d:

#   no "A hundred percent. Thanatos must be using fake identities of dead people to cover his tracks."
    no "Cem por cento. Thanatos deve estar usando identidades falsas de pessoas mortas para encobrir seus rastros."

# game/script5.rpy:12359
translate brazil thanahouse_e5fa9f40:

#   no "Would go with the whole “Greek god of death” thing."
    no "Iria com toda aquela coisa de “deus grego da morte”."

# game/script5.rpy:12360
translate brazil thanahouse_3f9796e0:

#   no "Although... he shouldn't be able to. I guess that reinforces our theory that he's working for Ulysses."
    no "Embora... ele não deveria ser capaz. Acho que isso reforça a nossa teoria de que ele está a trabalhar para Ulisses."

# game/script5.rpy:12363
translate brazil thanahouse_cc5ae734:

#   n "Agh... that's {i}bad{/i} news. We might be back to square one."
    n "Ah... isso é uma {i}má{/i} notícia. Podemos estar de volta à estaca zero."

# game/script5.rpy:12364
translate brazil thanahouse_0a24dbff:

#   n "*Sighs* Anyway, thank you, Nova."
    n "*Suspiros* De qualquer forma, obrigado, Nova."

# game/script5.rpy:12367
translate brazil thanahouse_d7f7bceb:

#   no "Is there anything else you need?"
    no "Há mais alguma coisa que você precisa?"

# game/script5.rpy:12370
translate brazil thanahouse_840a94dc:

#   n "Not right now... but thank you so much."
    n "Agora não... mas muito obrigado."

# game/script5.rpy:12371
translate brazil thanahouse_de11feb7:

#   n "We'll start heading back to Kredon now."
    n "Começaremos a voltar para Kredon agora."

# game/script5.rpy:12375
translate brazil thanahouse_56d34bab:

#   no "Okie-dokie!" with dis
    no "Ok, dokie!" with dis

# game/script5.rpy:12376
translate brazil thanahouse_600652cc:

#   no "I'm gonna play Eternum for a bit with Alex and Dalia."
    no "Vou jogar Eternum um pouco com Alex e Dalia."

# game/script5.rpy:12378
translate brazil thanahouse_3c3bcd2c:

#   no "But let me know when you're back! Maybe you can join!"
    no "Mas me avise quando voltar! Talvez você possa participar!"

# game/script5.rpy:12379
translate brazil thanahouse_77c5cf33:

#   no "See you later!"
    no "Até mais!"

# game/script5.rpy:12382
translate brazil thanahouse_4fce25c7:

#   mc "Goodbye, Nova! Have fun!"
    mc "Adeus, Nova! Divirta-se!"

# game/script5.rpy:12384
translate brazil thanahouse_804c7007:

#   mc "And thanks once again, number one hacker girl!"
    mc "E obrigado mais uma vez, garota hacker número um!"

# game/script5.rpy:12387
translate brazil thanahouse_2977cb02:

#   n "*Sighs* What a waste of time..." with dis14
    n "*Suspiro* Que perda de tempo..." with dis14

# game/script5.rpy:12388
translate brazil thanahouse_cba808c3:

#   n "We really got too ahead of ourselves..."
    n "Nós realmente nos adiantamos demais..."

# game/script5.rpy:12390
translate brazil thanahouse_f3071d4c:

#   mc "Don't say that!" with Dissolve(.7)
    mc "Não diga isso!" with Dissolve(.7)

# game/script5.rpy:12391
translate brazil thanahouse_013711c9:

#   mc "We had to try it, it was too good of an opportunity."
    mc "Tínhamos que tentar, era uma oportunidade muito boa."

# game/script5.rpy:12392
translate brazil thanahouse_7c265b63:

#   mc "So no long faces! Come on, let's go back to Kredon."
    mc "Portanto, nada de caretas! Vamos, vamos voltar para Kredon."

# game/script5.rpy:12393
translate brazil thanahouse_c5e0ab71:

#   mc "And let’s get something to eat along the way! My treat!"
    mc "E vamos comer alguma coisa no caminho! Meu prazer!"

# game/script5.rpy:12396
translate brazil thanahouse_5580363f:

#   n "*Chuckles* How do you do it, [mc]?" with dis14
    n "*Risos* Como você faz isso, [mc]?" with dis14

# game/script5.rpy:12399
translate brazil thanahouse_fe4c8152:

#   mc "Huh?" with dissolve
    mc "Huh?" with dissolve

# game/script5.rpy:12400
translate brazil thanahouse_94507c05:

#   mc "Do what?"
    mc "Fazer o quê?"

# game/script5.rpy:12402
translate brazil thanahouse_23748ac2:

#   n "Always staying positive. You’re so optimistic!" with dissolve
    n "Sempre permanecendo positivo. Você é tão otimista!" with dissolve

# game/script5.rpy:12403
translate brazil thanahouse_56a3753e:

#   n "During this Thanatos scheme, during the heist, even during the gladiator fight in Semper Invicta! You never seem to falter."
    n "Durante esse esquema de Thanatos, durante o assalto, até mesmo durante a luta de gladiadores em Sempre Invicta! Você nunca parece vacilar."

# game/script5.rpy:12405
translate brazil thanahouse_99ff1f08:

#   mc "Oh... well, I don't know, I've always been a pretty hopeful person." with dissolve
    mc "Ah... bem, não sei, sempre fui uma pessoa bastante esperançosa." with dissolve

# game/script5.rpy:12406
translate brazil thanahouse_b593ba2e:

#   mc "You have to fuck with me a LOT to make me upset. Unless you mess with someone I care about - then it’s a different story entirely."
    mc "Você tem que foder MUITO comigo para me deixar chateado. A menos que você mexa com alguém de quem gosto - então a história é completamente diferente."

# game/script5.rpy:12407
translate brazil thanahouse_bc98e692:

#   mc "I learned long ago that a half-full glass is better than a half-empty one. At the end of the day, all I can do is keep moving forward."
    mc "Aprendi há muito tempo que um copo meio cheio é melhor do que um copo meio vazio. No final das contas, tudo que posso fazer é seguir em frente."

# game/script5.rpy:12409
translate brazil thanahouse_a7d92602:

#   n "But the thing is that... it's not just {i}you{/i} moving forward." with dissolve
    n "Mas a questão é que... não é só {i}você{/i} seguindo em frente." with dissolve

# game/script5.rpy:12410
translate brazil thanahouse_cb6db637:

#   n "I'm not sure how you do it, but you make others feel good too. Your optimism, your reassurance... it’s contagious."
    n "Não tenho certeza de como você faz isso, mas você também faz os outros se sentirem bem. Seu otimismo, sua segurança... é contagiante."

# game/script5.rpy:12411
translate brazil thanahouse_3aec7802:

#   n "You have a gift! Even if you don't realize it yourself."
    n "Você tem um dom! Mesmo que você mesmo não perceba."

# game/script5.rpy:12413
translate brazil thanahouse_326d901c:

#   mc "*Chuckles* I'm not so sure, to be honest. I’ve met a lot of people who can't stand me." with dissolve
    mc "*Risos* Não tenho tanta certeza, para ser sincero. Conheci muitas pessoas que não me suportam." with dissolve

# game/script5.rpy:12414
translate brazil thanahouse_be63fe35:

#   mc "But thank you, Nancy."
    mc "Mas obrigado, Nancy."

# game/script5.rpy:12415
translate brazil thanahouse_0da1b8cb:

#   mc "Your words are really touching... but I have to imagine that a lot of this optimism stuff is due to you."
    mc "Suas palavras são realmente comoventes... mas imagino que muito desse otimismo se deve a você."

# game/script5.rpy:12416
translate brazil thanahouse_c05aff01:

#   mc "Growing up under your care really affected me."
    mc "Crescer sob seus cuidados realmente me afetou."

# game/script5.rpy:12418
translate brazil thanahouse_cc41286c:

#   n "Me? I don’t think so. I forced myself to swallow my tears and my pain when things went south a few years ago." with dissolve
    n "Meu? Eu não acho. Obriguei-me a engolir minhas lágrimas e minha dor quando as coisas pioraram, alguns anos atrás." with dissolve

# game/script5.rpy:12419
translate brazil thanahouse_bfb40d9f:

#   n "I kept a mask on because I was afraid that it would scare or hurt my daughters."
    n "Mantive a máscara porque tinha medo de assustar ou machucar minhas filhas."

# game/script5.rpy:12420
translate brazil thanahouse_c08e19cb:

#   n "And as they grew up, they started copying that same approach."
    n "E à medida que cresceram, começaram a copiar a mesma abordagem."

# game/script5.rpy:12421
translate brazil thanahouse_49344d0b:

#   n "They hide their insecurities, their fears. They always pretend to be happy, and they’ve gotten so good at it that sometimes even I can’t tell what’s an act."
    n "Escondem suas inseguranças, seus medos. Eles sempre fingem estar felizes e ficaram tão bons nisso que às vezes nem eu consigo dizer o que é uma atuação."

# game/script5.rpy:12422
translate brazil thanahouse_1152347a:

#   n "But... when they're with you... their smiles are genuine. The laughs are real."
    n "Mas... quando estão com você... seus sorrisos são genuínos. As risadas são reais."

# game/script5.rpy:12423
translate brazil thanahouse_9121681b:

#   n "You’ve really made the household... authentic. It’s almost like we were missing something before you came back."
    n "Você realmente tornou a casa... autêntica. É quase como se estivéssemos perdendo alguma coisa antes de você voltar."

# game/script5.rpy:12425
translate brazil thanahouse_ed24a052:

#   mc "Come off it! You don't need me for all that!" with dissolve
    mc "Pare com isso! Você não precisa de mim para tudo isso!" with dissolve

# game/script5.rpy:12426
translate brazil thanahouse_78ed1733:

#   mc "All I do is point out everything that’s already around you, I didn’t add anything special."
    mc "Tudo o que faço é apontar tudo o que já está ao seu redor, não acrescentei nada de especial."

# game/script5.rpy:12428
translate brazil thanahouse_b669a1ba:

#   n "But that’s not an easy thing to do, [mc]. People spend their lives trying to overcome insecurities." with Dissolve(1.6)
    n "Mas isso não é algo fácil de fazer, [mc]. As pessoas passam a vida tentando superar inseguranças." with Dissolve(1.6)

# game/script5.rpy:12429
translate brazil thanahouse_09c09216:

#   n "Even the prettiest girls feel ugly sometimes."
    n "Até as garotas mais bonitas às vezes se sentem feias."

# game/script5.rpy:12430
translate brazil thanahouse_85f1f354:

#   n "The people who are always cracking jokes and leaving others with smiles on their faces... you’d be surprised how many of them cry at night."
    n "As pessoas que estão sempre contando piadas e deixando os outros com sorrisos no rosto... você ficaria surpreso com quantas delas choram à noite."

# game/script5.rpy:12431
translate brazil thanahouse_19a9d4cd:

#   n "Even the most independent or popular girls feel alone."
    n "Até as garotas mais independentes ou populares se sentem sozinhas."

# game/script5.rpy:12432
translate brazil thanahouse_944c937f:

#   n "We might all be living different lives, but... when it comes down to it, we're all fighting the same monsters."
    n "Podemos estar todos vivendo vidas diferentes, mas... no final das contas, estamos todos lutando contra os mesmos monstros."

# game/script5.rpy:12434
translate brazil thanahouse_a6e7c10f:

#   n "I know that what I'm about to say might sound really selfish, but... " with Dissolve(1.6)
    n "Eu sei que o que estou prestes a dizer pode parecer muito egoísta, mas... " with Dissolve(1.6)

# game/script5.rpy:12435
translate brazil thanahouse_09e6ca61:

#   n "Don't leave us again, [mc]."
    n "Não nos deixe de novo, [mc]."

# game/script5.rpy:12436
translate brazil thanahouse_9c3b2f4d:

#   n "We need you."
    n "Nós precisamos de você."

# game/script5.rpy:12437
translate brazil thanahouse_53185990:

#   n "More than you think."
    n "Mais do que você pensa."

# game/script5.rpy:12439
translate brazil thanahouse_b0f9d6b8:

#   mc "Well, I don't know what life or the future or destiny hold in store for me, but I can promise you one thing, Nancy." with dissolve
    mc "Bem, não sei o que a vida, o futuro ou o destino me reservam, mas posso prometer-te uma coisa, Nancy." with dissolve

# game/script5.rpy:12440
translate brazil thanahouse_16154441:

#   mc "I'll never leave you or the girls again."
    mc "Nunca mais vou deixar você ou as meninas."

# game/script5.rpy:12441
translate brazil thanahouse_9f38300f:

#   mc "I swear on my life."
    mc "Juro pela minha vida."

# game/script5.rpy:12451
