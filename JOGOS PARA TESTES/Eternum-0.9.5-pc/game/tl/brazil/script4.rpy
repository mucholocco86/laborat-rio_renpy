translate brazil slotleavelabel_05e8ce35:

#   id "I know. But this time is special. We're holding an exclusive dinner this Saturday evening, at the Rockefeller server."
    id "Eu sei. Mas desta vez é especial. Realizamos um jantar exclusivo neste sábado à noite, no servidor Rockefeller."

# game/script4.rpy:1897
translate brazil slotleavelabel_f71a0ab7:

#   id "Only the most important people of Eternum are invited, and that includes... the owners of Gems of Doom."
    id "Apenas as pessoas mais importantes de Eternum são convidadas, e isso inclui... os proprietários de Gems of Doom."

# game/script4.rpy:1904
translate brazil slotleavelabel_7d073ada:

#   id "Heads." with dis04
    id "Cabeças." with dis04

# game/script4.rpy:1906
translate brazil slotleavelabel_ffafed0f:

#   mc "Oh... that's... awesome! I had no idea."
    mc "Ah... isso é... incrível! Eu não fazia ideia."

# game/script4.rpy:1908
translate brazil slotleavelabel_94fc3339:

#   id "The invitation of the previous owner of this Gem will be revoked, and given to you instead."
    id "O convite do proprietário anterior desta joia será revogado e entregue a você."

# game/script4.rpy:1909
translate brazil slotleavelabel_5eb3b0fb:

#   id "If you lose your Gem before Saturday, you'll lose your invitation as well."
    id "Se você perder sua joia antes de sábado, também perderá seu convite."

# game/script4.rpy:1911
translate brazil slotleavelabel_d888b3bd:

#   mc "I'll make sure not to lose it. Thank you so much."
    mc "Vou me certificar de não perdê-lo. Muito obrigado."

# game/script4.rpy:1919
translate brazil slotleavelabel_b9f0ad52:

#   id "You can bring a guest of your choice."
    id "Você pode trazer um convidado de sua preferência."

# game/script4.rpy:1920
translate brazil slotleavelabel_25cd7f08:

#   id "Obviously, given the nature of the event, all kinds of violence or attempted robberies are forbidden."
    id "Obviamente, dada a natureza do evento, é proibido todo tipo de violência ou tentativa de roubo."

# game/script4.rpy:1921
translate brazil slotleavelabel_68f2305f:

#   id "And finally, all guests must wear masks during the ceremony, to avoid disclosing the identities of the other Gem holders."
    id "E por fim, todos os convidados deverão usar máscaras durante a cerimônia, para evitar a divulgação das identidades dos demais detentores da Gema."

# game/script4.rpy:1923
translate brazil slotleavelabel_f7d3cdb3:

#   mc "That makes sense."
    mc "Isso faz sentido."

# game/script4.rpy:1924
translate brazil slotleavelabel_fb635887:

