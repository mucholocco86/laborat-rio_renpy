translate brazil slotleavelabel_06e6ceec:

#   mc "You've been living in these circles all your life, so you probably know how to blend in better than any of us." with dis04
    mc "Você viveu nesses círculos durante toda a sua vida, então provavelmente sabe como se misturar melhor do que qualquer um de nós." with dis04

# game/script4.rpy:2076
translate brazil slotleavelabel_34ef4e09:

#   x "Um... Really? Have you seen me? Do I look like someone who would blend in among a bunch of snobs?" with dis04
