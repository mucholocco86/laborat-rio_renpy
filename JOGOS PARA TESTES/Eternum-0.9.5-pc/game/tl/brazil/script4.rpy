translate brazil slotleavelabel_9d01eab5:

#   mc "I know you hate that kind of stuff, but I'm also sure you've been around people like that for a while now." with dis04
    mc "Eu sei que você odeia esse tipo de coisa, mas também tenho certeza de que você já conhece pessoas assim há algum tempo." with dis04

# game/script4.rpy:2079
translate brazil slotleavelabel_b3dfbe60:

#   mc "You're our best way of getting information from that dinner."
    mc "Você é a nossa melhor forma de obter informações daquele jantar."

