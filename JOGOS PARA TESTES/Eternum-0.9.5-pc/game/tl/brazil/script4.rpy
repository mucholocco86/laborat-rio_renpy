translate brazil slotleavelabel_da3714ec:

#   mc "It's about that dinner at the Boyle mansion... The one I was invited to after getting Garrington's Gem." with dissolve
    mc "É sobre aquele jantar na mansão Boyle... Aquele para o qual fui convidado depois de ganhar a joia de Garrington." with dissolve

# game/script4.rpy:2069
translate brazil slotleavelabel_2753d414:

#   x "Mm-hm."
    x "Hum-hm."

# game/script4.rpy:2070
translate brazil slotleavelabel_b7ecaff8:

#   mc "I've been talking with the others and we think that it should be you who comes with me."
    mc "Tenho conversado com os outros e achamos que deveria ser você quem vem comigo."

