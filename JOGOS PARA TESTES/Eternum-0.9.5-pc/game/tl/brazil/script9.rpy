translate brazil trial2a_a267a938:

#   tho "You, and you alone, must answer for your actions."
    tho "Você, e somente você, deve responder por suas ações."

# game/script9.rpy:1106
translate brazil trial2a_8ffc8db1:

#   mct "Dammit, that didn't work..."
    mct "Caramba, isso não funcionou..."

# game/script9.rpy:1110
translate brazil trial2b_c3953c31:

#   mc "Look, I..." with dis
    mc "Olha, eu..." with dis

# game/script9.rpy:1111
translate brazil trial2b_f82a71d9:

#   mc "*Sighs* Fuck."
    mc "* Suspira * Foda-se."

# game/script9.rpy:1112
translate brazil trial2b_4aa096f3:

#   mc "I... I wish to confess."
    mc "Eu... eu gostaria de confessar."

# game/script9.rpy:1114
translate brazil trial2b_5466925d:

#   tho "You wish to confess?"
    tho "Você deseja confessar?"

# game/script9.rpy:1116
translate brazil trial2b_b38d015a:

#   mc "Yes, Lord Thorund."
    mc "Sim, Lorde Thorund."

# game/script9.rpy:1117
translate brazil trial2b_d0d1c812:

#   mc "I'm guilty."
    mc "Eu sou culpado."

# game/script9.rpy:1118
translate brazil trial2b_4ae044cb:

#   mc "Guilty. Is that what you want to hear?"
    mc "Culpado. É isso que você quer ouvir?"

# game/script9.rpy:1120
translate brazil trial2b_9c07c840:

#   tho "Do you admit to abducting the Princess and attempting to take her life?"
    tho "Você admite ter sequestrado a princesa e tentado tirar a vida dela?"

# game/script9.rpy:1122
translate brazil trial2b_b4ca8f13:

#   mc "No, of that I'm innocent."
    mc "Não, disso sou inocente."

# game/script9.rpy:1123
translate brazil trial2b_d47416c3:

#   mc "I am guilty of a far more monstrous crime. I am guilty of being... a human."
    mc "Sou culpado de um crime muito mais monstruoso. Sou culpado de ser... um humano."

# game/script9.rpy:1124
translate brazil trial2b_5bd29b88:

#   tho ". . ."
    tho ". . ."

# game/script9.rpy:1126
translate brazil trial2b_84a555f2:

#   tho "You are not on trial for being a human."
    tho "Você não está sendo julgado por ser humano."

# game/script9.rpy:1128
translate brazil trial2b_6351cc22:

#   mc "Oh yes, I am."
    mc "Ah, sim, estou."

# game/script9.rpy:1129
translate brazil trial2b_ac658310:

#   mc "And I know I'll get no justice here..."
    mc "E eu sei que não terei justiça aqui..."

# game/script9.rpy:1130
translate brazil trial2b_5d78adf1:

#   mc "So I will let the gods decide my fate."
    mc "Então deixarei que os deuses decidam meu destino."

# game/script9.rpy:1134
translate brazil trial2b_d9984a9a:

#   mc "I demand a trial by combat."
    mc "Exijo um julgamento por combate."

# game/script9.rpy:1137
translate brazil trial2b_01a547e1:

#   ele ". . ."
    ele ". . ."

# game/script9.rpy:1140
translate brazil trial2b_19ab67bb:

#   ara ". . ."
    ara ". . ."

# game/script9.rpy:1143
translate brazil trial2b_c3e21791:

#   thod ". . ."
    thod ". . ."

# game/script9.rpy:1144
translate brazil trial2b_2bc821a5:

#   thod "A..."
    thod "UM..."

# game/script9.rpy:1145
translate brazil trial2b_f371c5ea:

#   thod "A what?"
    thod "Um o quê?"

# game/script9.rpy:1148
translate brazil trial2b_b920d5e0:

#   tho "That is not an option." with dis12
    tho "Isso não é uma opção." with dis12

# game/script9.rpy:1150
translate brazil trial2b_a3be92b2:

#   mct "Goddamnit..."
    mct "Droga..."

# game/script9.rpy:1152
translate brazil trial2b_bc42cda9:

#   syl "The human truly believes he can bring his barbaric ways into our lands."
    syl "O humano realmente acredita que pode trazer seus costumes bárbaros para nossas terras."

# game/script9.rpy:1153
translate brazil trial2b_798471a1:

#   syl "Where do you think you are, mortal?"
    syl "Onde você pensa que está, mortal?"

# game/script9.rpy:1155
translate brazil trial2b_3cc87d5a:

#   tho "In Hyril'ar, you may only attempt to defend yourself with your words, and nothing else."
    tho "Em Hyril'ar, você só pode tentar se defender com palavras e nada mais."

# game/script9.rpy:1156
translate brazil trial2b_44ddc81a:

#   tho "Do not try it again."
    tho "Não tente novamente."

# game/script9.rpy:1158
translate brazil trial2b_4967f04d:

#   mct "Dammit, that shit worked in Game of Thrones."
    mct "Droga, essa merda funcionou em Game of Thrones."

# game/script9.rpy:1159
translate brazil trial2b_bfefd6ca:

#   mct "Fucking George R.R. Martin..."
    mct "Maldito George R.R. Martin..."

# game/script9.rpy:1164
translate brazil trial2c_383a7f79:

#   mc "Alright, first of all..." with dis
    mc "Tudo bem, antes de tudo..." with dis

# game/script9.rpy:1165
translate brazil trial2c_c0a31bd6:

#   mc "Who are all of you?"
    mc "Quem são todos vocês?"

# game/script9.rpy:1167
translate brazil trial2c_e1363b19:

#   tho "My name is Lord Thorund."
    tho "Meu nome é Lorde Thorund."

# game/script9.rpy:1168
translate brazil trial2c_095fbb10:

#   tho "I am the eldest among the nobles of the Realm, and I have held a seat on the Council for over four millennia."
    tho "Sou o mais velho entre os nobres do Reino e ocupo um assento no Conselho há mais de quatro milênios."

# game/script9.rpy:1170
translate brazil trial2c_87f37a43:

#   tho "This is Lady Elenwen, daughter of Celeror of Farrah and the rightful heir of Eldunar, the most prosperous house on the entire continent."
    tho "Esta é Lady Elenwen, filha de Celeror de Farrah e legítima herdeira de Eldunar, a casa mais próspera de todo o continente."

# game/script9.rpy:1172
translate brazil trial2c_119d34d5:

#   tho "And this is Lord Sylax, heir to the ancient and honorable house of Cassyr, who has long served with pride as the King's Hand, fulfilling his duties across generations."
    tho "E este é Lord Sylax, herdeiro da antiga e honrada casa de Cassyr, que há muito serve com orgulho como Mão do Rei, cumprindo seus deveres através das gerações."

# game/script9.rpy:1174
translate brazil trial2c_5e5660e7:

#   tho "We, the three of us, constitute the Council of Regents, entrusted with the temporary governance of Hyril'ar until the rightful ruler returns — the sole descendant of Anima's bloodline, Princess Calypso."
    tho "Nós, nós três, constituimos o Conselho de Regentes, encarregado do governo temporário de Hyril'ar até o retorno do governante legítimo - o único descendente da linhagem de Anima, a Princesa Calypso."

# game/script9.rpy:1175
translate brazil trial2c_6b6f0c9e:

#   tho "Her highness vanished without a trace more than fifteen years ago, and since then, we have been awaiting her return with steadfast patience."
    tho "Sua alteza desapareceu sem deixar vestígios há mais de quinze anos e, desde então, aguardamos seu retorno com paciência."

# game/script9.rpy:1177
translate brazil trial2c_9e065675:

#   mct "Wait... fifteen years ago...?"
    mct "Espere... quinze anos atrás...?"

# game/script9.rpy:1178
translate brazil trial2c_794f7140:

#   mct "How is that possible? Ulysses didn't even exist back then."
    mct "Como isso é possível? Ulisses nem existia naquela época."

# game/script9.rpy:1179
translate brazil trial2c_dd706ce1:

#   mct "Does that mean she wasn’t actually kidnapped by the Founder...? How the hell did she end up stuck in that box, then?"
    mct "Isso significa que ela não foi realmente sequestrada pelo Fundador...? Como diabos ela acabou presa naquela caixa, então?"

# game/script9.rpy:1181
translate brazil trial2c_5815a610:

#   tho "And that is all you need to know."
    tho "E isso é tudo que você precisa saber."

# game/script9.rpy:1185
translate brazil ptrial2_6921ddb8:

#   tho "Now, you will answer our questions, as briefly and accurately as you are able."
    tho "Agora, você responderá às nossas perguntas da forma mais breve e precisa possível."

# game/script9.rpy:1186
translate brazil ptrial2_909e43bc:

#   tho "Keep in mind that withholding the truth will immediately result in the penalty of death by sword, without any further defense or deliberation."
    tho "Tenha em mente que reter a verdade resultará imediatamente na pena de morte pela espada, sem qualquer defesa ou deliberação adicional."

# game/script9.rpy:1187
translate brazil ptrial2_cbc90ff1:

#   tho "Do you understand?"
    tho "Você entende?"

# game/script9.rpy:1189
translate brazil ptrial2_e456d76a:

#   mc "*Gulps* Y-Yes."
    mc "* Engole em seco * S-Sim."

# game/script9.rpy:1191
translate brazil ptrial2_702ed310:

#   tho "What is your relationship with the Princess?"
    tho "Qual é a sua relação com a Princesa?"

# game/script9.rpy:1192
translate brazil ptrial2_d7495075:

#   tho "Why was she with you?"
    tho "Por que ela estava com você?"

# game/script9.rpy:1198
translate brazil trial3a_bae543b1:

#   mc "I am her owner." with dis
    mc "Eu sou o dono dela." with dis

# game/script9.rpy:1199
translate brazil trial3a_2a8d38db:

#   mc "She's something we call... “Weapon of Atlas”. The third one, to be precise."
    mc "Ela é algo que chamamos de... \"Arma de Atlas\". O terceiro, para ser mais preciso."

# game/script9.rpy:1200
translate brazil trial3a_4457d7da:

#   mc "As such, she's bound to serve me and create portals to wherever I want."
    mc "Como tal, ela deverá me servir e criar portais para onde eu quiser."

# game/script9.rpy:1202
translate brazil trial3a_dd5ce4a3:

#   syl "This is outrageous."
    syl "Isto é ultrajante."

# game/script9.rpy:1203
translate brazil trial3a_c4d5b190:

#   syl "This... {i}creature{/i} is determined to tarnish the entire royal lineage with his lies."
    syl "Esta... {i}criatura{/i} está determinada a manchar toda a linhagem real com suas mentiras."

# game/script9.rpy:1205
translate brazil trial3a_1bf106c7:

#   ele "The Princess serves no one in this world — certainly not a filthy human."
    ele "A Princesa não serve a ninguém neste mundo – certamente não a um humano imundo."

# game/script9.rpy:1207
translate brazil trial3a_287d955a:

#   mc "You asked for the truth, and I'm giving you just that."
    mc "Você pediu a verdade e eu estou lhe dando exatamente isso."

# game/script9.rpy:1211
translate brazil trial3b_0cd400cb:

#   mc "We're friends." with dis
    mc "Somos amigos." with dis

# game/script9.rpy:1212
translate brazil trial3b_a8b7ea7e:

#   tho "Hmm."
    tho "Hum."

# game/script9.rpy:1214
translate brazil trial3b_d020d8e6:

#   tho "Friends..."
    tho "Amigos..."

# game/script9.rpy:1215
translate brazil trial3b_f4d62f50:

#   tho "You. With the Princess of Hyril'ar."
    tho "Você. Com a Princesa de Hyril'ar."

# game/script9.rpy:1217
translate brazil trial3b_a0689c47:

#   mc "Think whatever you want."
    mc "Pense o que quiser."

# game/script9.rpy:1219
translate brazil trial3b_d273bc27:

#   mc "She literally said it herself. She sees me as an equal."
    mc "Ela literalmente disse isso sozinha. Ela me vê como um igual."

# game/script9.rpy:1221
translate brazil trial3b_7003301a:

#   mc "That's the truth."
    mc "Essa é a verdade."

# game/script9.rpy:1223
translate brazil trial3b_3db85261:

#   syl "You? The Princess’ equal? You must think we are fools."
    syl "Você? A princesa é igual? Você deve pensar que somos tolos."

# game/script9.rpy:1226
translate brazil trial3c_d49c3595:

#   mc "I am the Princess' servant." with dis
    mc "Eu sou o servo da princesa." with dis

# game/script9.rpy:1227
translate brazil trial3c_1539d8f8:

#   mc "I swore to protect her and serve her until she could find her way back home to Hyril'ar."
    mc "Jurei protegê-la e servi-la até que ela pudesse encontrar o caminho de volta para casa, em Hyril'ar."

# game/script9.rpy:1229
translate brazil trial3c_ef6a2a28:

#   ele "Ahh... I suppose that explains it."
    ele "Ahh... suponho que isso explica tudo."

# game/script9.rpy:1231
translate brazil trial3c_bbc6e527:

#   syl "No, it does not."
    syl "Não, isso não acontece."

# game/script9.rpy:1232
translate brazil trial3c_4fba8d4f:

#   syl "As if the Princess would ever accept a filthy human as her protector."
    syl "Como se a princesa algum dia aceitasse um humano imundo como seu protetor."

# game/script9.rpy:1233
translate brazil trial3c_d25cc16e:

#   syl "She bested the greatest warriors and mages in the Realm long ago — how could a mere mortal be of any use to her?"
    syl "Ela derrotou os maiores guerreiros e magos do Reino há muito tempo – como um mero mortal poderia ser útil para ela?"

# game/script9.rpy:1234
translate brazil trial3c_d2ce1545:

#   syl "He is lying..."
    syl "Ele está mentindo..."

# game/script9.rpy:1238
translate brazil ptrial3_ea6fc145:

#   tho "Hmph."
    tho "Hmph."

# game/script9.rpy:1240
translate brazil ptrial3_f69f7855:

#   tho "And... when and how did your paths cross?" with dis
    tho "E... quando e como seus caminhos se cruzaram?" with dis

# game/script9.rpy:1245
translate brazil trial4a_a2d22972:

#   mc "I found her by accident when I was looking for the Weapons of Atlas." with dis
    mc "Eu a encontrei por acidente quando procurava as Armas de Atlas." with dis

# game/script9.rpy:1246
translate brazil trial4a_31cfeb50:

#   mc "She was trapped inside some kind of magic box on a server run by Ulysses — the organization trying to control Eternum."
    mc "Ela estava presa dentro de uma espécie de caixa mágica em um servidor administrado por Ulysses – a organização que tenta controlar Eternum."

# game/script9.rpy:1248
translate brazil trial4a_3771a564:

#   syl "Eternum?"
    syl "Eterno?"

# game/script9.rpy:1250
translate brazil trial4a_57821bcb:

#   mc "Oh... uh..."
    mc "Ah... uh..."

# game/script9.rpy:1251
translate brazil trial4a_db7d85ba:

#   mc "Yeah... that’s probably a story for another time."
    mc "Sim... isso provavelmente é uma história para outra hora."

# game/script9.rpy:1253
translate brazil trial4a_e7b95ee5:

#   ele "Please, enlighten us."
    ele "Por favor, nos esclareça."

# game/script9.rpy:1255
translate brazil trial4a_c14c584c:

#   mc "Well..."
    mc "Bem..."

# game/script9.rpy:1256
translate brazil trial4a_3be03f7e:

#   mc "To sum it up in one sentence, your world is part of a... system of different interconnected astral planes."
    mc "Resumindo em uma frase, seu mundo faz parte de um... sistema de diferentes planos astrais interconectados."

# game/script9.rpy:1257
translate brazil trial4a_e58f409c:

#   mc "Calypso can travel between them using her portals, but not to my world."
    mc "Calipso pode viajar entre eles usando seus portais, mas não para o meu mundo."

# game/script9.rpy:1259
translate brazil trial4a_b374c075:

#   tho "We told you not to speak the Princess’ name."
    tho "Dissemos para você não falar o nome da princesa."

# game/script9.rpy:1261
translate brazil trial4a_b9c54c0b:

#   mct "Shit, I keep forgetting."
    mct "Merda, eu continuo esquecendo."

# game/script9.rpy:1262
translate brazil trial4a_f1f81cfa:

#   mc "S-Sorry."
    mc "S-Desculpe."

# game/script9.rpy:1264
translate brazil trial4a_e6c61e87:

#   tho "But regardless, we have no time to philosophize over the tenets of your religion."
    tho "Mas, independentemente disso, não temos tempo para filosofar sobre os princípios da sua religião."

# game/script9.rpy:1265
translate brazil trial4a_d92ebb25:

#   tho "Again, keep your answers brief."
    tho "Novamente, mantenha suas respostas breves."

# game/script9.rpy:1267
translate brazil trial4a_96c54ae0:

#   mc "Yes... I will."
    mc "Sim, eu vou."

# game/script9.rpy:1268
translate brazil trial4a_7ec87797:

#   mct "It was they who asked..."
    mct "Foram eles que perguntaram..."

# game/script9.rpy:1273
translate brazil trial4b_c36984f6:

#   mc "I broke her out of captivity myself." with dis
    mc "Eu mesmo a libertei do cativeiro." with dis

# game/script9.rpy:1274
translate brazil trial4b_c2d89f2c:

#   mc "The Immortals abducted her and were keeping her locked up in a camp far from here."
    mc "Os Imortais a sequestraram e a mantiveram trancada em um acampamento longe daqui."

# game/script9.rpy:1275
translate brazil trial4b_0be0d6fd:

#   mc "Since then, we’ve been on a long journey to get back to Hyril’ar."
    mc "Desde então, fizemos uma longa jornada para voltar a Hyril'ar."

# game/script9.rpy:1277
translate brazil trial4b_b56c9dad:

#   syl "And why did you do that, hmm?"
    syl "E por que você fez isso, hum?"

# game/script9.rpy:1278
translate brazil trial4b_5fe0f04a:

#   syl "Were you expecting a reward? Because all you will receive is the punishment you undoubtedly deserve, scum."
    syl "Você estava esperando uma recompensa? Porque tudo o que você receberá é o castigo que sem dúvida merece, escória."

# game/script9.rpy:1280
translate brazil trial4b_9056469b:

#   ele "And why was the Princess in such a deplorable state when you were found with her?"
    ele "E por que a princesa estava em um estado tão deplorável quando você foi encontrado com ela?"

# game/script9.rpy:1281
translate brazil trial4b_2e308a96:

#   ele "Even now, the druids remain uncertain if she will survive."
    ele "Mesmo agora, os druidas permanecem incertos se ela sobreviverá."

# game/script9.rpy:1286
translate brazil trial5a_5e268df3:

#   mc "She gave it everything she had to save me from a monster of an enemy." with dis
    mc "Ela deu tudo o que tinha para me salvar de um monstro inimigo." with dis

# game/script9.rpy:1287
translate brazil trial5a_174e884a:

#   mc "He was about to finish me off when she channeled all her magic into one powerful blast against him."
    mc "Ele estava prestes a acabar comigo quando ela canalizou toda a sua magia em uma explosão poderosa contra ele."

# game/script9.rpy:1289
translate brazil trial5a_790274da:

#   ele "Hah."
    ele "Hah."

# game/script9.rpy:1290
translate brazil trial5a_24c65750:

#   ele "And I am to believe the Princess would risk her life for an insignificant human like you?"
    ele "E devo acreditar que a princesa arriscaria a vida por um humano insignificante como você?"

# game/script9.rpy:1291
translate brazil trial5a_5db41e6f:

#   ele "Spare me your jest."
    ele "Poupe-me da sua brincadeira."

# game/script9.rpy:1295
translate brazil trial5b_eec27cc2:

#   mc "We were attacked by a very powerful enemy, a warrior from my realm who's been chasing us for a while now." with dis
    mc "Fomos atacados por um inimigo muito poderoso, um guerreiro do meu reino que já nos persegue há algum tempo." with dis

# game/script9.rpy:1296
translate brazil trial5b_c2f9a974:

#   mc "The Princess had to channel all her magic to take him down, even while chained with dimeritium."
    mc "A Princesa teve que canalizar toda a sua magia para derrubá-lo, mesmo acorrentada com dimerício."

# game/script9.rpy:1298
translate brazil trial5b_d4024811:

#   ele "A human warrior?"
    ele "Um guerreiro humano?"

# game/script9.rpy:1299
translate brazil trial5b_6384c75f:

#   ele "Are you expecting me to believe the Princess would struggle against a mere human?"
    ele "Você está esperando que eu acredite que a Princesa lutaria contra um mero humano?"

# game/script9.rpy:1301
translate brazil trial5b_66b583bd:

#   mc "You should see him."
    mc "Você deveria vê-lo."

# game/script9.rpy:1302
translate brazil trial5b_a6aa30eb:

#   mc "He's... barely human anymore."
    mc "Ele... quase não é mais humano."

# game/script9.rpy:1304
translate brazil trial5b_c4664823:

#   ele "Please. I witnessed her defeat some of Hyril’ar’s most powerful mages when she was but forty."
    ele "Por favor. Eu a testemunhei derrotar alguns dos magos mais poderosos de Hyril'ar quando ela tinha apenas quarenta anos."

# game/script9.rpy:1305
translate brazil trial5b_1e3bdf14:

#   ele "Do not insult my intelligence."
    ele "Não insulte minha inteligência."

# game/script9.rpy:1308
translate brazil trial5c_5dd779e6:

#   mc "I... don't know." with dis
    mc "Não sei." with dis

# game/script9.rpy:1309
translate brazil trial5c_3d2ad0fa:

#   mc "This is how I found her when I came back to where she was."
    mc "Foi assim que a encontrei quando voltei para onde ela estava."

# game/script9.rpy:1310
translate brazil trial5c_1a71f336:

#   mc "I picked her up right away and was searching for help when I ran into General Arannis in the forest."
    mc "Eu a peguei imediatamente e estava procurando ajuda quando encontrei o General Arannis na floresta."

# game/script9.rpy:1312
translate brazil trial5c_46df09db:

#   ele "Of course..."
    ele "Claro..."

# game/script9.rpy:1313
translate brazil trial5c_8f0b081c:

#   ele "How very convenient."
    ele "Muito conveniente."

# game/script9.rpy:1317
translate brazil ptrial4_148e9446:

#   syl "Even if your claims are true and you truly aided her escape from her captivity, the Princess would never lower herself enough to allow a human near her." with dis
    syl "Mesmo que suas afirmações sejam verdadeiras e você realmente a tenha ajudado a escapar do cativeiro, a Princesa nunca se rebaixaria o suficiente para permitir que um humano se aproximasse dela." with dis

# game/script9.rpy:1318
translate brazil ptrial4_87022311:

#   syl "At best, you would be nothing more than a slave, and as such, touching her is strictly forbidden."
