#   ca "Yes, yes, I know..."
    ca "Sim, sim, eu sei..."

# game/script9.rpy:8654
translate brazil guardwin09_6b13001a:

#   ca "I know..."
    ca "Eu sei..."

# game/script9.rpy:8662
translate brazil guardwin09_3d36aa53:

#   mc "General Arannis said only you could prevent this realm from falling into darkness." with dis
    mc "O General Arannis disse que só você poderia evitar que este reino caísse na escuridão." with dis

# game/script9.rpy:8663
translate brazil guardwin09_7050a341:

#   mc "He believed in you, even with everything falling apart."
    mc "Ele acreditou em você, mesmo com tudo desmoronando."

# game/script9.rpy:8664
translate brazil guardwin09_584bc5fe:

#   mc "And so do I."
    mc "E eu também."

# game/script9.rpy:8666
translate brazil guardwin09_c81b7376:

#   ca ". . ." with dis
    ca ". . ." with dis

# game/script9.rpy:8667
translate brazil guardwin09_013a6766:

#   ca "Yes..."
    ca "Sim..."

# game/script9.rpy:8673
translate brazil guardwin09_dc9f5bf9:

#   ca "*Standing up* Y-Yes." with dis12
    ca "*Levantando-se* S-Sim." with dis12

# game/script9.rpy:8674
translate brazil guardwin09_fe102680:

#   ca "Enough!" with hpunchsubtle
    ca "Suficiente!" with hpunchsubtle

# game/script9.rpy:8675
translate brazil guardwin09_ffb38268:

#   ca "You are right. I am the Princess of the Sy-tel-quessir!"
    ca "Você está certo. Eu sou a Princesa do Sy-tel-quessir!"

# game/script9.rpy:8676
translate brazil guardwin09_ee9a6b9e:

#   ca "We need to move, and we need to move now."
    ca "Precisamos nos mover e precisamos nos mover agora."

# game/script9.rpy:8677
translate brazil guardwin09_6a621460:

#   ca "I will not let them win."
    ca "Não vou deixá-los vencer."

# game/script9.rpy:8679
translate brazil guardwin09_779c051a:

#   mc "Yes!"
    mc "Sim!"

# game/script9.rpy:8680
translate brazil guardwin09_8ecfe705:

#   mc "That's the Calypso I know!"
    mc "Esse é o Calipso que eu conheço!"

# game/script9.rpy:8682
translate brazil guardwin09_eeb37db4:

#   ca "Lorelei, go fetch whatever supplies you can from the horse breeders’ pantry."
    ca "Lorelei, vá buscar todos os suprimentos que puder na despensa dos criadores de cavalos."

# game/script9.rpy:8683
translate brazil guardwin09_f1551304:

#   ca "And quickly!"
    ca "E rapidamente!"

# game/script9.rpy:8684
translate brazil guardwin09_56097a05:

#   ca "We will depart the moment you return."
    ca "Partiremos no momento em que você retornar."

# game/script9.rpy:8686
translate brazil guardwin09_50423c2f:

#   lo "Y-Yes! At once, Your Grace!"
    lo "S-Sim! Imediatamente, Vossa Graça!"

# game/script9.rpy:8692
translate brazil guardwin09_8bf1f72a:

#   bla "As Lorelei leaves to get the supplies, a portal flares open behind you." with dis12
    bla "Enquanto Lorelei sai para pegar os suprimentos, um portal se abre atrás de você." with dis12

# game/script9.rpy:8694
translate brazil guardwin09_82f15133:

#   mc "Nice!"
    mc "Legal!"

# game/script9.rpy:8695
translate brazil guardwin09_7fa541d9:

#   mc "Where is this portal going? Ekabar?"
    mc "Para onde vai esse portal? Ekabar?"

# game/script9.rpy:8697
translate brazil guardwin09_c4921ec2:

#   ca "Yes. Same as the one I opened this morning."
    ca "Sim. Igual ao que abri esta manhã."

# game/script9.rpy:8699
translate brazil guardwin09_877163e8:

#   mc "Perfect! From there, I should be able to teleport back to Earth."
    mc "Perfeito! De lá, eu deveria ser capaz de me teletransportar de volta para a Terra."

# game/script9.rpy:8700
translate brazil guardwin09_aea3affe:

#   mc "Once we gather everyone, we’ll have more than enough brainpower to figure out a counterattack."
    mc "Assim que reunirmos todos, teremos inteligência mais que suficiente para planejar um contra-ataque."

# game/script9.rpy:8701
translate brazil guardwin09_7018c8a5:

#   mc "In the meantime, you and Lorelei can stay at the same inn where you–"
    mc "Enquanto isso, você e Lorelei podem ficar na mesma pousada onde você–"

# game/script9.rpy:8703
translate brazil guardwin09_aaae8f8d:

#   ca "The portal is only for you, [mc]."
    ca "O portal é só para você, [mc]."

# game/script9.rpy:8705
translate brazil guardwin09_68e5e7cf:

#   mc "Eh...?" with dis
    mc "Eh...?" with dis

# game/script9.rpy:8706
translate brazil guardwin09_42bd829d:

#   mc "Wait, what?"
    mc "Espere, o que?"

# game/script9.rpy:8709
translate brazil guardwin09_e4dcf450:

#   ca "Have you already forgotten the struggle I endured attempting to return to Hyril’ar after you freed me from my imprisonment?"
    ca "Você já se esqueceu da luta que enfrentei ao tentar retornar a Hyril'ar depois que você me libertou da prisão?"

# game/script9.rpy:8710
translate brazil guardwin09_14c7a110:

#   ca "I do not even recall how I managed it in the end."
    ca "Eu nem me lembro como consegui no final."

# game/script9.rpy:8711
translate brazil guardwin09_70701b60:

#   ca "I... I cannot risk becoming trapped on the other side again."
    ca "Eu... não posso correr o risco de ficar preso do outro lado novamente."

# game/script9.rpy:8713
translate brazil guardwin09_9cc3c67e:

#   mc "B-But... you can't stay here!"
    mc "M-Mas... você não pode ficar aqui!"

# game/script9.rpy:8714
translate brazil guardwin09_5db9d94c:

#   mc "They want to kill you, Calypso!"
    mc "Eles querem matar você, Calipso!"

# game/script9.rpy:8716
translate brazil guardwin09_73d889ef:

#   ca "There is no guarantee I could return here once more."
    ca "Não há garantia de que eu possa voltar aqui mais uma vez."

# game/script9.rpy:8717
translate brazil guardwin09_dae6878c:

#   ca "At least, not immediately. It could take months of meditation to find the path back, if I find it at all."
    ca "Pelo menos, não imediatamente. Poderia levar meses de meditação para encontrar o caminho de volta, se é que eu o encontraria."

# game/script9.rpy:8718
translate brazil guardwin09_a0814079:

#   ca "I will not abandon my people to save myself."
    ca "Não abandonarei meu povo para me salvar."

# game/script9.rpy:8719
translate brazil guardwin09_2d1b7794:

#   ca "That decision is final."
    ca "Essa decisão é final."

# game/script9.rpy:8721
translate brazil guardwin09_fc896afd:

#   mc "But..."
    mc "Mas..."

# game/script9.rpy:8726
translate brazil guardwin09_9e7d12d7:

#   mc "*Approaching her* Aggh..." with dis17
    mc "*se aproximando dela* Agh..." with dis17

# game/script9.rpy:8727
translate brazil guardwin09_29f88632:

#   mc "Alright, fine!"
    mc "Tudo bem, tudo bem!"

# game/script9.rpy:8728
translate brazil guardwin09_3bf60e66:

#   mc "I know you well enough to know once your mind's made up, there's no point in arguing."
    mc "Conheço-te suficientemente bem para saber que, uma vez tomada a decisão, não vale a pena discutir."

# game/script9.rpy:8729
translate brazil guardwin09_ed9747f1:

#   mc "Okay... listen carefully — I was saving this for after we were safe in Ekabar, but I guess the plans just changed."
    mc "Ok... ouça com atenção - eu estava guardando isso para depois que estivéssemos seguros em Ekabar, mas acho que os planos simplesmente mudaram."

# game/script9.rpy:8730
translate brazil guardwin09_9ec9d8b2:

#   mc "Arannis told me where to go."
    mc "Arannis me disse para onde ir."

# game/script9.rpy:8731
translate brazil guardwin09_b7df78ef:

#   mc "We need to head towards..."
    mc "Precisamos ir em direção..."

# game/script9.rpy:8736
translate brazil guardwin09_7ae19c6e:

#   mc "Vael’Thalas Hold? I think that was the name." with dis
    mc "Fortaleza Vael'Thalas? Acho que esse era o nome." with dis

# game/script9.rpy:8738
translate brazil guardwin09_a535128d:

#   mc "...Andor Vale? I think that was the name." with dis
    mc "...Andor Vale? Acho que esse era o nome." with dis

# game/script9.rpy:8740
translate brazil guardwin09_10181996:

#   mc "Thalorin Enclave? I think that was the name." with dis
    mc "Enclave Thalorin? Acho que esse era o nome." with dis

# game/script9.rpy:8741
translate brazil guardwin09_1bd4194c:

#   mc "He said you'd find allies there. People you can trust."
    mc "Ele disse que você encontraria aliados lá. Pessoas em quem você pode confiar."

# game/script9.rpy:8742
translate brazil guardwin09_5b791a14:

#   mc "He was sure some of the old families would never betray the crown. Ilvenmyr and..."
    mc "Ele tinha certeza de que algumas das antigas famílias nunca trairiam a coroa. Ilvenmyr e..."

# game/script9.rpy:8746
translate brazil guardwin09_6ddf5476:

#   mc "Ysion." with dis
    mc "Ysion." with dis

# game/script9.rpy:8749
translate brazil guardwin09_e751040f:

#   mc "Redveil." with dis
    mc "Véu Vermelho." with dis

# game/script9.rpy:8751
translate brazil guardwin09_5e1073d3:

#   mc "Thirinvale." with dis
    mc "Thirinvale." with dis

# game/script9.rpy:8752
translate brazil guardwin09_c2bd5642:

#   ca "Hmph."
    ca "Hmph."

# game/script9.rpy:8754
translate brazil guardwin09_6367bb3e:

#   ca "I see..."
    ca "Eu vejo..."

# game/script9.rpy:8755
translate brazil guardwin09_645395f4:

#   ca "That is valuable information."
    ca "Essa é uma informação valiosa."

# game/script9.rpy:8757
translate brazil guardwin09_b81e5e62:

#   mc "Still, don’t let your guard down. Trust no one."
    mc "Mesmo assim, não baixe a guarda. Não confie em ninguém."

# game/script9.rpy:8758
translate brazil guardwin09_c83df5ef:

#   mc "Only me. And Lorelei."
    mc "Só eu. E Lorelei."

# game/script9.rpy:8760
translate brazil guardwin09_1580bc08:

#   ca "Yes. I shall be cautious."
    ca "Sim. Serei cauteloso."

# game/script9.rpy:8761
translate brazil guardwin09_fb6820f5:

#   ca "Thank you, [mc]."
    ca "Obrigado, [mc]."

# game/script9.rpy:8762
translate brazil guardwin09_221c9e13:

#   ca "I will..."
    ca "Eu vou..."

# game/script9.rpy:8765
translate brazil guardwin09_3fb388a5:

#   bla "Calypso turns away, her voice quieter now." with dis15
    bla "Calipso se vira, sua voz agora mais baixa." with dis15

# game/script9.rpy:8767
translate brazil guardwin09_34e326ad:

#   ca "I will never forget what you have done for us."
    ca "Nunca esquecerei o que você fez por nós."

# game/script9.rpy:8768
translate brazil guardwin09_a5202ae2:

#   ca "For me."
    ca "Para mim."

# game/script9.rpy:8770
translate brazil guardwin09_1932e436:

#   ca "Thank you."
    ca "Obrigado."

# game/script9.rpy:8771
translate brazil guardwin09_213294a4:

#   ca "Now go."
    ca "Agora vá."

# game/script9.rpy:8773
translate brazil guardwin09_8523998e:

#   ca "Use the portal, and return to your world."
    ca "Use o portal e retorne ao seu mundo."

# game/script9.rpy:8774
translate brazil guardwin09_d2f1b449:

#   mc "You don't get it, do you?"
    mc "Você não entende, não é?"

# game/script9.rpy:8775
translate brazil guardwin09_9b17f6f4:

#   mc "I wanted to leave through a portal because I thought it was the safest option for you."
    mc "Queria sair por um portal porque achei que era a opção mais segura para você."

# game/script9.rpy:8776
translate brazil guardwin09_d4abd4e3:

#   mc "But if you’re afraid you might not find your way back to Hyril’ar..."
    mc "Mas se você tem medo de não encontrar o caminho de volta para Hyril'ar..."

# game/script9.rpy:8777
translate brazil guardwin09_17217c3b:

#   mc "Then fine. We’re not leaving. I’m not leaving."
    mc "Então tudo bem. Não vamos embora. Eu não vou embora."

# game/script9.rpy:8778
translate brazil guardwin09_257c2cea:

#   mc "We'll fix this. Together."
    mc "Nós vamos consertar isso. Junto."

# game/script9.rpy:8779
translate brazil guardwin09_b0aba28c:

#   ca "Please. Do not make this harder than it needs to be."
    ca "Por favor. Não torne isso mais difícil do que o necessário."

# game/script9.rpy:8780
translate brazil guardwin09_f25c7ff9:

#   mc "I'm not going anywhere, Calypso."
    mc "Não vou a lugar nenhum, Calipso."

# game/script9.rpy:8781
translate brazil guardwin09_04df733b:

#   mc "You're not doing this alone."
    mc "Você não está fazendo isso sozinho."

# game/script9.rpy:8783
translate brazil guardwin09_0c55de63:

#   ca "*Snorts* Hmph."
    ca "* Bufa * Hmph."

# game/script9.rpy:8787
translate brazil guardwin09_7f6e483d:

#   bla "Calypso leans against the wall, a wistful smirk on her face." with dis17
    bla "Calypso se inclina contra a parede, com um sorriso melancólico no rosto." with dis17

# game/script9.rpy:8788
translate brazil guardwin09_981df446:

#   ca "*Chuckles* Mmh-mph..."
    ca "*Risos* Mmh-mph..."

# game/script9.rpy:8789
translate brazil guardwin09_0c8b1e7e:

#   mc "Calypso...?"
    mc "Calipso...?"

# game/script9.rpy:8796
translate brazil guardwin09_e6097c3a:

#   ca "Heavens..."
    ca "Céus..."

# game/script9.rpy:8797
translate brazil guardwin09_78a8d1f2:

#   ca "I am pathetic."
    ca "Eu sou patético."

# game/script9.rpy:8799
translate brazil guardwin09_5a334f8a:

#   mc "What? No, you're not."
    mc "O que? Não, você não está."

# game/script9.rpy:8800
translate brazil guardwin09_140bb3a6:

#   mc "Why do you say that?"
    mc "Por que você diz isso?"

# game/script9.rpy:8803
translate brazil guardwin09_b50a63d0:

#   ca "This burden is too heavy for me, [mc]."
    ca "Este fardo é pesado demais para mim, [mc]."

# game/script9.rpy:8804
translate brazil guardwin09_b9606358:

#   ca "My father reigned for centuries, you know? Unshaken."
    ca "Meu pai reinou durante séculos, sabe? Inabalável."

# game/script9.rpy:8805
translate brazil guardwin09_ab054589:

#   ca "And I... I have managed to unravel it all in less than a decade."
    ca "E eu... consegui desvendar tudo em menos de uma década."

# game/script9.rpy:8807
translate brazil guardwin09_f17a3518:

#   mc "This is not your fault."
    mc "Isso não é culpa sua."

# game/script9.rpy:8809
translate brazil guardwin09_84cf8a02:

#   ca "How is it not?"
    ca "Como não é?"

# game/script9.rpy:8810
translate brazil guardwin09_cee23e21:

#   ca "I possess everything others could only dream of. A kingdom. Wealth beyond measure. The blood of Anima herself flows through me."
    ca "Possuo tudo o que os outros só poderiam sonhar. Um reino. Riqueza além da medida. O sangue da própria Anima flui através de mim."

# game/script9.rpy:8811
translate brazil guardwin09_a5fb1ea8:

#   ca "And yet... look at what I did with it."
    ca "E ainda assim... veja o que eu fiz com isso."

# game/script9.rpy:8812
translate brazil guardwin09_f6382155:

#   ca "If it had not been for a human who stumbled onto my path by accident, I would still be caged."
    ca "Se não fosse por um humano que tropeçou no meu caminho por acidente, eu ainda estaria enjaulado."

# game/script9.rpy:8814
translate brazil guardwin09_07ce2175:

#   mc "People like to call it luck when they don’t want to admit their own strength. Or fate, when they can’t accept they fought their way through hell to get where they are."
    mc "As pessoas gostam de chamar isso de sorte quando não querem admitir sua própria força. Ou o destino, quando eles não conseguem aceitar que abriram caminho através do inferno para chegar onde estão."

# game/script9.rpy:8815
translate brazil guardwin09_2f914e37:

#   mc "But remember, if you’re standing where you are right now, it’s because you deserve to be here."
    mc "Mas lembre-se, se você está onde está agora, é porque merece estar aqui."

# game/script9.rpy:8816
translate brazil guardwin09_c7f3a0aa:

#   mc "It’s okay to feel overwhelmed. It’s okay to lean on someone else — hell, I’ve done it more times than I can count."
    mc "Não há problema em se sentir sobrecarregado. Não há problema em confiar em outra pessoa - caramba, já fiz isso mais vezes do que consigo contar."

# game/script9.rpy:8817
translate brazil guardwin09_230c3de0:

#   mc "But even when you need help... don’t forget, it’s {i}you{/i} who has gotten yourself this far. People step in because of who you are."
    mc "Mas mesmo quando precisar de ajuda... não se esqueça, foi {i}você{/i} quem chegou até aqui. As pessoas intervêm por causa de quem você é."

# game/script9.rpy:8818
translate brazil guardwin09_e5da9156:

#   mc "And I'm here, Calypso. Whatever happens... I've got you."
    mc "E eu estou aqui, Calipso. Aconteça o que acontecer... eu tenho você."

# game/script9.rpy:8822
translate brazil guardwin09_f93f87a5:

#   ca ". . ." with dis2
    ca ". . ." with dis2

# game/script9.rpy:8823
translate brazil guardwin09_aa1c37bb:

#   ca "Why do you insist so much, [mc]?"
    ca "Por que você insiste tanto, [mc]?"

# game/script9.rpy:8824
translate brazil guardwin09_6640c607:

#   ca "This is not your war."
    ca "Esta não é a sua guerra."

# game/script9.rpy:8825
translate brazil guardwin09_eb1fd76f:

#   ca "You already have your own battles to fight. The Founder. Lord Bardot. Thanatos... the Gems."
    ca "Você já tem suas próprias batalhas para travar. O Fundador. Senhor Bardot. Thanatos... as joias."

# game/script9.rpy:8826
translate brazil guardwin09_33365f39:

#   mc "Your war became mine the moment you became part of my life."
    mc "Sua guerra se tornou minha no momento em que você se tornou parte da minha vida."

# game/script9.rpy:8828
translate brazil guardwin09_aaeca147:

#   ca "Hah..."
    ca "Hah..."

# game/script9.rpy:8829
translate brazil guardwin09_2b12b808:

#   ca "I would leave it all behind, you know?"
    ca "Eu deixaria tudo para trás, sabe?"

# game/script9.rpy:8830
translate brazil guardwin09_70b7e248:

#   ca "*Her voice trembles* The crown. The halls of my ancestors. Even the stars above Hyril’ar that have watched over me since my birth."
    ca "*Sua voz treme* A coroa. Os salões dos meus antepassados. Até as estrelas acima de Hyril'ar que cuidam de mim desde o meu nascimento."

# game/script9.rpy:8831
translate brazil guardwin09_03ef8435:

#   ca "Everything."
    ca "Tudo."

# game/script9.rpy:8832
translate brazil guardwin09_8a93d6b7:

#   mc "Then... do it. Come with me!"
    mc "Então... faça. Venha comigo!"

# game/script9.rpy:8834
translate brazil guardwin09_1c15bd51:

#   ca "I do not want to be a Princess, [mc]. I never did."
    ca "Eu não quero ser uma princesa, [mc]. Eu nunca fiz isso."

# game/script9.rpy:8835
translate brazil guardwin09_d5221a63:

#   ca "All my life I have felt like I do not belong here."
    ca "Durante toda a minha vida senti que não pertenço a este lugar."

# game/script9.rpy:8836
translate brazil guardwin09_933102d3:

#   ca "And yet..."
    ca "E ainda assim..."

# game/script9.rpy:8837
translate brazil guardwin09_b7369a90:

#   ca "I have to save Hyril'ar. For my people."
    ca "Eu tenho que salvar Hyril'ar. Para o meu povo."

# game/script9.rpy:8838
translate brazil guardwin09_208bccb2:

#   ca "I cannot run from the smoke when I was born to put out the flames."
    ca "Não posso fugir da fumaça quando nasci para apagar as chamas."

# game/script9.rpy:8839
translate brazil guardwin09_9596dbf0:

#   mc "You shouldn't have to burn just because someone decided it was your role to carry the torch."
    mc "Você não deveria queimar só porque alguém decidiu que era seu papel carregar a tocha."

# game/script9.rpy:8840
translate brazil guardwin09_be7bda97:

#   mc "You don't owe anything to anyone."
    mc "Você não deve nada a ninguém."

# game/script9.rpy:8841
translate brazil guardwin09_c6098c53:

#   ca "But... I do. Even if you cannot understand."
    ca "Mas... eu quero. Mesmo que você não consiga entender."

# game/script9.rpy:8842
translate brazil guardwin09_23a0b233:

#   ca "I..."
    ca "EU..."

# game/script9.rpy:8846
translate brazil guardwin09_db4d29d5:

#   ca "I-I must still thank you, you know?" with dis2
    ca "E-eu ainda devo agradecer, sabe?" with dis2

# game/script9.rpy:8847
translate brazil guardwin09_854aa259:

#   ca "Thanks to you... I now know I can be something else."
    ca "Graças a você... agora sei que posso ser outra coisa."

# game/script9.rpy:8849
translate brazil guardwin09_b1a77725:

#   mc "Calypso..."
    mc "Calipso..."

# game/script9.rpy:8851
translate brazil guardwin09_0a8cbf88:

#   ca "Lady Alexandra teaching me how to kick. Lady Dalia, to bake. Lady Annie, to whistle like a mockingbird." with dis12
    ca "Lady Alexandra me ensinando a chutar. Lady Dalia, para assar. Lady Annie, para assobiar como um rouxinol." with dis12

# game/script9.rpy:8852
translate brazil guardwin09_ccf5d1c8:

#   ca "Every... absurd, beautiful moment I spent with you, [mc]..."
    ca "Cada... momento lindo e absurdo que passei com você, [mc]..."

# game/script9.rpy:8853
translate brazil guardwin09_269292fc:

#   ca "I laughed. I stumbled. I... lived."
    ca "Eu ri. Eu tropecei. Eu... vivi."

# game/script9.rpy:8855
translate brazil guardwin09_63230192:

#   ca "I have..." with dis12
    ca "Eu tenho..." with dis12

# game/script9.rpy:8856
translate brazil guardwin09_4efa293d:

#   ca "I have walked this world for eighty years, yet all of them felt like a quiet, endless void."
    ca "Andei neste mundo durante oitenta anos, mas todos eles pareciam um vazio silencioso e sem fim."

# game/script9.rpy:8857
translate brazil guardwin09_2ca04200:

#   ca "A thousand sunrises, and not one of them warmed me."
    ca "Mil amanheceres, e nenhum deles me aqueceu."

# game/script9.rpy:8859
translate brazil guardwin09_354e468e:

#   ca "Until... you." with dis
    ca "Até... você." with dis

# game/script9.rpy:8860
translate brazil guardwin09_31cfdb2c:

#   ca "You showed me that life can be different."
    ca "Você me mostrou que a vida pode ser diferente."

# game/script9.rpy:8861
translate brazil guardwin09_2de0ed35:

#   ca "That it does not have to be a prison."
    ca "Que não precisa ser uma prisão."

# game/script9.rpy:8862
translate brazil guardwin09_827d7043:

#   ca "You showed me that... the chain can be broken."
    ca "Você me mostrou que... a corrente pode ser quebrada."

# game/script9.rpy:8866
translate brazil guardwin09_60f80839:

#   ca "*Approaching you* So..." with dis22
    ca "*Aproximando-se de você* Então..." with dis22

# game/script9.rpy:8867
translate brazil guardwin09_d33c0991:

#   ca "I-If you truly mean the things you say..."
    ca "E-Se você realmente quer dizer o que diz..."

# game/script9.rpy:8868
translate brazil guardwin09_062dd207:

#   ca "When this is all over..."
    ca "Quando tudo isso acabar..."

# game/script9.rpy:8869
translate brazil guardwin09_cfa786c6:

#   ca "When Hyril'ar is saved..."
    ca "Quando Hyril'ar for salvo..."

# game/script9.rpy:8870
translate brazil guardwin09_4ba55506:

#   ca "I will walk away from everything."
    ca "Vou me afastar de tudo."

# game/script9.rpy:8871
translate brazil guardwin09_88ae2f2b:

