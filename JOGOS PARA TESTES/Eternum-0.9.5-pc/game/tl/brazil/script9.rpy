translate brazil guardwin09_6b7f3e68:

#   mct "So... overwhelmed. So anxious."
    mct "Então... sobrecarregado. Tão ansioso."

# game/script9.rpy:8633
translate brazil guardwin09_d74f118a:

#   ca "*Muttering* How did it come to this..."
    ca "*Murmurando* Como chegou a isso..."

