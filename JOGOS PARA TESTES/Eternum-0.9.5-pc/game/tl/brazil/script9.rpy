    mct "O problema é que Powell parece querer que essas entrevistas acabem rapidamente." with dis12

# game/script9.rpy:17740
translate brazil ulyssesheistlunachang_15b407a8:

#   mct "We need to believe in her now..."
    mct "Precisamos acreditar nela agora..."

# game/script9.rpy:17741
translate brazil ulyssesheistlunachang_abf1760c:

#   adr "Sit down, gentlemen!"
    adr "Sente-se, senhores!"

# game/script9.rpy:17742
translate brazil ulyssesheistlunachang_7bf75181:

#   adr "Please, don't be shy."
    adr "Por favor, não seja tímido."

# game/script9.rpy:17746
translate brazil ulyssesheistlunachang_012e7ec4:

#   adr "*Reading your resumes* Alright, alright, alright..." with dis17
    adr "*Lendo seus currículos* Tudo bem, tudo bem, tudo bem..." with dis17

# game/script9.rpy:17747
translate brazil ulyssesheistlunachang_ad357817:

#   adr "You two have some {i}impressive{/i} resumes. Haven’t seen ones this polished since that guy who faked his diploma."
    adr "Vocês dois têm currículos {i}impressionantes{/i} . Não via uns tão polidos desde aquele cara que falsificou o diploma."

# game/script9.rpy:17748
translate brazil ulyssesheistlunachang_5089ea52:

#   adr "We ended up bringing up a frivolous lawsuit and landing him in jail."
    adr "Acabamos abrindo um processo frívolo e levando-o à prisão."

# game/script9.rpy:17750
translate brazil ulyssesheistlunachang_730de99f:

#   mc "*Gulps* . . ."
    mc "*Golpes*. . ."

# game/script9.rpy:17753
translate brazil ulyssesheistlunachang_e1dca978:

#   adr "But let’s cut the boring crap, yeah? I don’t care about your GPA or which programming language you dream in." with dis
    adr "Mas vamos parar com essa porcaria chata, certo? Não me importo com seu GPA ou com qual linguagem de programação você sonha." with dis

# game/script9.rpy:17754
translate brazil ulyssesheistlunachang_2ee24f86:

#   adr "I’m here to figure out what kind of people I’m letting into my kingdom."
    adr "Estou aqui para descobrir que tipo de pessoas estou deixando entrar no meu reino."

# game/script9.rpy:17755
translate brazil ulyssesheistlunachang_b083af4a:

#   adr "So... tell me, do you even know why you’re here?"
    adr "Então... me diga, você sabe por que está aqui?"

# game/script9.rpy:17757
translate brazil ulyssesheistlunachang_b0e179c3:

#   mc2 "Uh... here... at Ulysses?"
    mc2 "Uh... aqui... no Ulisses?"

# game/script9.rpy:17759
translate brazil ulyssesheistlunachang_0ab4d283:

#   adr "No. I mean..."
    adr "Não, quero dizer..."

# game/script9.rpy:17762
translate brazil ulyssesheistlunachang_e0e71eaa:

#   adr "HERE IN MY DAMN OFFICE!" with hpunch
    adr "AQUI NO MEU ESCRITÓRIO!" with hpunch

# game/script9.rpy:17764
translate brazil ulyssesheistlunachang_34b96abf:

#   adr "Why would I, Adrian Powell, allow two peasants into my own ridiculous, unnecessarily lavish office instead of just letting HR interrogate you in some sad little cubicle?!" with hpunch
    adr "Por que eu, Adrian Powell, permitiria que dois camponeses entrassem em meu escritório ridículo e desnecessariamente luxuoso, em vez de apenas deixar o RH interrogá-lo em algum cubículo triste?!" with hpunch

# game/script9.rpy:17766
translate brazil ulyssesheistlunachang_5c5c016e:

#   adr "WHY?!" with hpunch
    adr "POR QUE?!" with hpunch

# game/script9.rpy:17767
translate brazil ulyssesheistlunachang_11f8c54d:

#   mc2 "To... motivate us?"
    mc2 "Para... nos motivar?"

# game/script9.rpy:17770
translate brazil ulyssesheistlunachang_850209f8:

#   adr "Exactly." with hpunchsubtle
    adr "Exatamente." with hpunchsubtle

# game/script9.rpy:17771
translate brazil ulyssesheistlunachang_e0899939:

#   adr "To help you see your potential future. To show you what’s waiting for you if you work hard enough. If you’re talented enough. And if you’re lucky enough."
    adr "Para ajudá-lo a ver seu futuro potencial. Para mostrar o que está esperando por você se você trabalhar duro o suficiente. Se você for talentoso o suficiente. E se você tiver sorte o suficiente."

# game/script9.rpy:17774
translate brazil ulyssesheistlunachang_ac331a4a:

#   adr "You’re quick, Mr. Claimant. I like that. Fast mind. Sharp tongue." with dis
    adr "Você é rápido, Sr. Requerente. Eu gosto disso. Mente rápida. Língua afiada." with dis

# game/script9.rpy:17775
translate brazil ulyssesheistlunachang_6d183f76:

#   adr "Twenty-one years old and already two degrees?"
    adr "Vinte e um anos e já dois diplomas?"

# game/script9.rpy:17776
translate brazil ulyssesheistlunachang_3ea3db47:

#   adr "From MIT, no less."
    adr "Do MIT, nada menos."

# game/script9.rpy:17778
translate brazil ulyssesheistlunachang_ef8d4c8a:

#   mc2 "Yes, sir."
    mc2 "Sim, senhor."

# game/script9.rpy:17779
translate brazil ulyssesheistlunachang_2ece6745:

#   mc2 "CS and Artificial Intelligence."
    mc2 "CS e Inteligência Artificial."

# game/script9.rpy:17781
translate brazil ulyssesheistlunachang_320899e0:

#   adr "Impressive, impressive."
    adr "Impressionante, impressionante."

# game/script9.rpy:17782
translate brazil ulyssesheistlunachang_8d14dbe1:

#   adr "Some would say you lack experience, but I say — what’s more impressive? Someone who runs ten miles in forty minutes, or someone who does it in a hundred?"
    adr "Alguns diriam que falta experiência, mas eu digo – o que é mais impressionante? Alguém que corre dezesseis quilômetros em quarenta minutos ou alguém que faz isso em cem?"

# game/script9.rpy:17784
translate brazil ulyssesheistlunachang_44c85533:

#   mc2 "Mm-hm."
    mc2 "Hum-hm."

# game/script9.rpy:17786
translate brazil ulyssesheistlunachang_93302e36:

#   adr ". . ."
    adr ". . ."

# game/script9.rpy:17788
translate brazil ulyssesheistlunachang_59c2bc4e:

#   mc2 ". . ."
    mc2 ". . ."

# game/script9.rpy:17790
translate brazil ulyssesheistlunachang_8f02e6ff:

#   adr "It's a question."
    adr "É uma pergunta."

# game/script9.rpy:17792
translate brazil ulyssesheistlunachang_b0c8e187:

#   mc2 "O-Oh."
    mc2 "Ah, ah."

# game/script9.rpy:17793
translate brazil ulyssesheistlunachang_65e5dd79:

#   mc2 "Uh..."
    mc2 "Uh..."

# game/script9.rpy:17800
translate brazil ulyssesheistlunachang_061c94ac:

#   mc2 "The one who does it in forty minutes?" with dis
    mc2 "Aquele que faz isso em quarenta minutos?" with dis

# game/script9.rpy:17804
translate brazil ulyssesheistlunachang_fc3a1b9c:

#   adr "Efficiency. Speed. Results."
    adr "Eficiência. Velocidade. Resultados."

# game/script9.rpy:17807
translate brazil ulyssesheistlunachang_b58d3d75:

#   mc2 "The one who does it in a hundred minutes?" with dis
    mc2 "Aquele que faz isso em cem minutos?" with dis

# game/script9.rpy:17809
translate brazil ulyssesheistlunachang_d1eb2247:

#   adr "...What? No. Why would that be more meritorious?"
    adr "...O que? Não. Por que isso seria mais meritório?"

# game/script9.rpy:17810
translate brazil ulyssesheistlunachang_a998562d:

#   adr "He's a damn slow motherfucker."
    adr "Ele é um filho da puta muito lento."

# game/script9.rpy:17811
translate brazil ulyssesheistlunachang_fb513f76:

#   adr "The fatso was practically walking."
    adr "O gordo estava praticamente andando."

# game/script9.rpy:17814
translate brazil ulyssesheistlunachang_09e54c65:

#   adr "But anyway, what do we have over here..." with dis
    adr "Mas de qualquer forma, o que temos aqui..." with dis

# game/script9.rpy:17815
translate brazil ulyssesheistlunachang_b118ff9f:

#   adr "Mr. Canchez! Whoa."
    adr "Sr. Canchez! Uau."

# game/script9.rpy:17817
translate brazil ulyssesheistlunachang_67c089e4:

#   adr "You’re no slouch either, huh? Three languages?"
    adr "Você também não é desleixado, né? Três idiomas?"

# game/script9.rpy:17819
translate brazil ulyssesheistlunachang_0f11047b:

#   c2 "Indeed, sir. I'm fluent in English, Russian, and Spanish."
    c2 "Na verdade, senhor. Sou fluente em inglês, russo e espanhol."

# game/script9.rpy:17821
translate brazil ulyssesheistlunachang_102905ef:

#   adr "Spanish!"
    adr "Espanhol!"

# game/script9.rpy:17822
translate brazil ulyssesheistlunachang_9b6c92e2:

#   adr "What a coincidence!"
    adr "Que coincidência!"

# game/script9.rpy:17823
translate brazil ulyssesheistlunachang_84c02e67:

#   adr "Resulta que pasé un tiempo viviendo en Buenos Aires cuando era joven, viste. Te molesta si seguimos la entrevista en español?" (what_style='textsp')
    adr "Acontece que passei algum tempo morando em Buenos Aires quando era jovem, sabe. Você se importa se continuarmos a entrevista em espanhol?" (what_style='textsp')

# game/script9.rpy:17825
translate brazil ulyssesheistlunachang_fd9ea434:

#   c2 ". . ."
    c2 ". . ."

# game/script9.rpy:17827
translate brazil ulyssesheistlunachang_93353143:

#   c2 "Que...?" (what_style='textsp')
    c2 "Que...?" (what_style='textsp')

# game/script9.rpy:17829
translate brazil ulyssesheistlunachang_d4fbd774:

#   adr "AAAAAh! Jesus, my accent's rustier than I thought!" with dis
    adr "AAAAAh! Jesus, meu sotaque é mais enferrujado do que eu pensava!" with dis

# game/script9.rpy:17830
translate brazil ulyssesheistlunachang_aeb9fdf0:

#   adr "Forgive me, that was probably so bad you barely understood what I was trying to say!"
    adr "Perdoe-me, isso provavelmente foi tão ruim que você mal entendeu o que eu estava tentando dizer!"

# game/script9.rpy:17832
translate brazil ulyssesheistlunachang_91b4ce6f:

#   c2 "Y-Yeah, it was pretty bad."
    c2 "S-Sim, foi muito ruim."

# game/script9.rpy:17834
translate brazil ulyssesheistlunachang_771ddb1a:

#   adr "Alright, alright! Enough of my linguistic disasters." with dis
    adr "Tudo bem, tudo bem! Chega de meus desastres linguísticos." with dis

# game/script9.rpy:17835
translate brazil ulyssesheistlunachang_53b2177d:

#   adr "Time is money, gentlemen, so I'm only going to ask a couple questions to each of you, and I expect complete honesty."
    adr "Tempo é dinheiro, senhores, por isso vou apenas fazer algumas perguntas a cada um de vocês e espero total honestidade."

# game/script9.rpy:17837
translate brazil ulyssesheistlunachang_152c8935:

#   adr "But first! Do you want a drink?"
    adr "Mas primeiro! Você quer uma bebida?"

# game/script9.rpy:17838
translate brazil ulyssesheistlunachang_928dcdc0:

#   adr "Whiskey? Brandy?"
    adr "Uísque? Conhaque?"

# game/script9.rpy:17845
translate brazil ulyssesheistlunachang_166cb77f:

#   mc2 "Yeah, I'll have whiskey, thank you." with dis
    mc2 "Sim, quero uísque, obrigado." with dis

# game/script9.rpy:17849
translate brazil ulyssesheistlunachang_99da8743:

#   mc2 "Yeah, I'll have brandy, thank you." with dis
    mc2 "Sim, quero conhaque, obrigado." with dis

# game/script9.rpy:17853
translate brazil ulyssesheistlunachang_f3c62207:

#   mc "Uh... no, thank you. I don't drink." with dis
    mc "Uh... não, obrigado. Eu não bebo." with dis

# game/script9.rpy:17856
translate brazil ulyssesheistlunachang_99052b52:

#   adr "Good man!" with hpunchsubtle
    adr "Bom cara!" with hpunchsubtle

# game/script9.rpy:17857
translate brazil ulyssesheistlunachang_24b9144d:

#   adr "Alcohol and tobacco are poison! Filth!"
    adr "Álcool e tabaco são venenosos! Sujeira!"

# game/script9.rpy:17858
translate brazil ulyssesheistlunachang_02186f69:

#   adr "Only fools dull their edge with that crap."
    adr "Só os tolos entorpecem o limite com essa porcaria."

# game/script9.rpy:17861
translate brazil ulyssesheistlunachang_a228675c:

#   adr "Tsk. Are you seriously asking for a drink in the middle of a damn job interview?"
    adr "Tsk. Você está seriamente pedindo uma bebida no meio de uma maldita entrevista de emprego?"

# game/script9.rpy:17862
translate brazil ulyssesheistlunachang_74cc5262:

#   adr "What the hell’s wrong with you, Claimant?"
    adr "O que há de errado com você, Requerente?"

# game/script9.rpy:17863
translate brazil ulyssesheistlunachang_9ffc7a53:

#   adr "Alcohol is fucking poison. Filth!"
    adr "O álcool é um maldito veneno. Sujeira!"

# game/script9.rpy:17866
translate brazil ulyssesheistlunachang_81375662:

#   adr "Everyone knows {i}real{/i} businessmen only use cocaine anyway. Or microdoses of LSD." with dis
    adr "Todo mundo sabe {i}real{/i} de qualquer maneira, os empresários só usam cocaína. Ou microdoses de LSD." with dis

# game/script9.rpy:17868
translate brazil ulyssesheistlunachang_db3c52a3:

#   mc2 "W-What?"
    mc2 "O-o quê?"

# game/script9.rpy:17870
translate brazil ulyssesheistlunachang_2f4af4f2:

#   adr "Anyway... let's begin!"
    adr "Enfim... vamos começar!"

# game/script9.rpy:17873
translate brazil ulyssesheistlunachang_b8f68d76:

#   adr "Mr. Claimant... tell me, how did you end up here at Ulysses?" with dis
    adr "Sr. Requerente... diga-me, como você veio parar aqui em Ulisses?" with dis

# game/script9.rpy:17874
translate brazil ulyssesheistlunachang_ddf96f6a:

#   adr "What's your story?"
    adr "Qual é a sua história?"

# game/script9.rpy:17881
translate brazil ulyssesheistlunachang_d65ec801:

#   mc2 "Honestly? Everyone knows Ulysses pays its senior staff more than some countries pay their presidents." with dis
    mc2 "Honestamente? Todo mundo sabe que a Ulisses paga mais aos seus funcionários seniores do que alguns países pagam aos seus presidentes." with dis

# game/script9.rpy:17882
translate brazil ulyssesheistlunachang_44167a3f:

#   mc2 "I want that money. That power. The freedom that comes with it."
    mc2 "Eu quero esse dinheiro. Esse poder. A liberdade que vem com isso."

# game/script9.rpy:17883
translate brazil ulyssesheistlunachang_784bb7dd:

#   mc2 "So I worked my ass off until I was good enough to enter this company."
    mc2 "Então trabalhei duro até ser bom o suficiente para entrar nesta empresa."

# game/script9.rpy:17886
translate brazil ulyssesheistlunachang_5c1814ca:

#   adr "Hah! I love honesty. No bullshit, no sugarcoating." with hpunchsubtle
    adr "Hah! Eu amo a honestidade. Sem besteira, sem adoçar." with hpunchsubtle

# game/script9.rpy:17887
translate brazil ulyssesheistlunachang_53e95273:

#   adr "Money runs the world. Everyone wants it."
    adr "O dinheiro governa o mundo. Todo mundo quer isso."

# game/script9.rpy:17888
translate brazil ulyssesheistlunachang_13882a3a:

#   adr "Keep your goals updated and your greed healthy and you’ll go far."
    adr "Mantenha seus objetivos atualizados e sua ganância saudável e você irá longe."

# game/script9.rpy:17892
translate brazil ulyssesheistlunachang_758c41a1:

#   mc2 "Ulysses’ reputation precedes it, sir." with dis
    mc2 "A reputação de Ulisses precede-o, senhor." with dis

# game/script9.rpy:17893
translate brazil ulyssesheistlunachang_4e8c5fcb:

#   mc2 "My dream’s always been to work for a company respected across every industry. A place where achievement speaks for itself, with worldwide prestige."
    mc2 "Meu sonho sempre foi trabalhar para uma empresa respeitada em todos os setores. Um lugar onde as conquistas falam por si, com prestígio mundial."

# game/script9.rpy:17894
translate brazil ulyssesheistlunachang_d3ef6838:

#   mc2 "So I studied and trained for years just to get here. The top of the top."
    mc2 "Então estudei e treinei durante anos só para chegar aqui. O topo do topo."

# game/script9.rpy:17897
translate brazil ulyssesheistlunachang_dd3f118e:

#   adr "You're not wrong there." with hpunchsubtle
    adr "Você não está errado aí." with hpunchsubtle

# game/script9.rpy:17898
translate brazil ulyssesheistlunachang_33d94661:

#   adr "Flash a business card with a senior title, subtle off-white coloring and a Ulysses watermark, and any table at a five-star restaurant will be yours. Even the ones already taken."
    adr "Mostre um cartão de visita com título sênior, cor esbranquiçada sutil e marca d'água Ulysses, e qualquer mesa em um restaurante cinco estrelas será sua. Mesmo os que já foram levados."

# game/script9.rpy:17899
translate brazil ulyssesheistlunachang_46022cfb:

#   adr "I like your ambition, kid."
    adr "Gosto da sua ambição, garoto."

# game/script9.rpy:17902
translate brazil ulyssesheistlunachang_ad091bd0:

#   mc2 "Ulysses is everywhere. Entertainment, finance, technology, medicine, energy. A global conglomerate." with dis
    mc2 "Ulisses está em toda parte. Entretenimento, finanças, tecnologia, medicina, energia. Um conglomerado global." with dis

# game/script9.rpy:17903
translate brazil ulyssesheistlunachang_0f498b68:

#   mc2 "I believe that if I climb high enough here, I can actually help steer that power toward something good. Something that makes the world better for everyone."
    mc2 "Acredito que se eu subir alto o suficiente aqui, poderei realmente ajudar a direcionar esse poder para algo bom. Algo que torne o mundo melhor para todos."

# game/script9.rpy:17905
translate brazil ulyssesheistlunachang_00d91a57:

#   adr "Hah! You might’ve walked into the wrong lion’s den for that, son."
    adr "Hah! Você pode ter entrado na cova dos leões errado por causa disso, filho."

# game/script9.rpy:17906
translate brazil ulyssesheistlunachang_2cc3b3aa:

#   adr "But hey, someone’s gotta believe in something, right? The world needs a few idealists to balance out the sharks."
    adr "Mas ei, alguém tem que acreditar em alguma coisa, certo? O mundo precisa de alguns idealistas para equilibrar os tubarões."

# game/script9.rpy:17907
translate brazil ulyssesheistlunachang_74e303b4:

#   adr "Admirable."
    adr "Admirável."

# game/script9.rpy:17910
translate brazil ulyssesheistlunachang_ddbb5033:

#   adr "Which reminds me..." with dis
    adr "O que me lembra..." with dis

# game/script9.rpy:17911
translate brazil ulyssesheistlunachang_29d8ce85:

#   adr "In your cover letter, you said you’ve been following Ulysses’ expansion for years."
    adr "Em sua carta de apresentação, você disse que acompanha a expansão da Ulysses há anos."

# game/script9.rpy:17912
translate brazil ulyssesheistlunachang_e6311c71:

#   adr "Obviously, our beloved Founder gets all the fan mail, but..."
    adr "Obviamente, nosso querido Fundador recebe todas as cartas dos fãs, mas..."

# game/script9.rpy:17914
translate brazil ulyssesheistlunachang_8e1b7810:

#   adr "What about the senior partners?" with dis
    adr "E os sócios seniores?" with dis

# game/script9.rpy:17915
translate brazil ulyssesheistlunachang_3a053be4:

#   adr "Did you know me before walking in here?"
    adr "Você me conhecia antes de entrar aqui?"

# game/script9.rpy:17922
translate brazil ulyssesheistlunachang_7d8f7469:

#   mc2 "Of course, sir." with dis
    mc2 "Claro, senhor." with dis

# game/script9.rpy:17923
translate brazil ulyssesheistlunachang_d160e44e:

#   mc2 "Your trajectory within Ulysses is legendary. I’ve read about your work in several of the company’s major projects."
    mc2 "Sua trajetória dentro de Ulisses é lendária. Li sobre seu trabalho em vários dos principais projetos da empresa."

# game/script9.rpy:17925
translate brazil ulyssesheistlunachang_af00adc6:

#   adr "I see, I see..."
    adr "Eu vejo, eu vejo..."

# game/script9.rpy:17926
translate brazil ulyssesheistlunachang_29ac3fea:

#   adr "And what about William Bardot?"
    adr "E quanto a William Bardot?"

# game/script9.rpy:17929
translate brazil ulyssesheistlunachang_6e0d581c:

#   mc2 "Uh... I'm sorry, sir. I hadn't heard of you before this." with dis
    mc2 "Uh... sinto muito, senhor. Eu não tinha ouvido falar de você antes disso." with dis

# game/script9.rpy:17931
translate brazil ulyssesheistlunachang_cab3b0fd:

#   adr "Huh... I see."
    adr "Huh... entendo."

# game/script9.rpy:17932
translate brazil ulyssesheistlunachang_f9b90c1d:

#   adr "Honest."
    adr "Honesto."

# game/script9.rpy:17934
translate brazil ulyssesheistlunachang_ecb7892b:

#   adr "And what about William Bardot?" with dis08
    adr "E quanto a William Bardot?" with dis08

# game/script9.rpy:17935
translate brazil ulyssesheistlunachang_ecd351f0:

#   adr "You surely know him. What's your opinion of the man?"
    adr "Você certamente o conhece. Qual a sua opinião sobre o homem?"

# game/script9.rpy:17939
translate brazil ulyssesheistlunachang_87db9b84:

#   mc2 "Uhm..." with dis08
    mc2 "Hum..." with dis08

# game/script9.rpy:17941
translate brazil ulyssesheistlunachang_d7bd9567:

#   mc2 "He's..."
    mc2 "Ele é..."

# game/script9.rpy:17942
translate brazil ulyssesheistlunachang_d7eb7e75:

#   mc2 "Uhh..."
    mc2 "Uh..."

# game/script9.rpy:17946
translate brazil ulyssesheistlunachang_6ce6ed79:

#   mc2 "He's definitely a role model." with dis
    mc2 "Ele é definitivamente um modelo." with dis

# game/script9.rpy:17947
translate brazil ulyssesheistlunachang_675a6f71:

#   mc2 "He might not have founded Ulysses, but he elevated it, expanded it globally."
    mc2 "Ele pode não ter fundado a Ulisses, mas elevou-a e expandiu-a globalmente."

# game/script9.rpy:17948
translate brazil ulyssesheistlunachang_7e2dc188:

#   mc2 "Professionally, I respect him a lot."
    mc2 "Profissionalmente, eu o respeito muito."

# game/script9.rpy:17951
translate brazil ulyssesheistlunachang_ba29226a:

#   adr "HAHAHA!" with vpunch
    adr "HAHAHA!" with vpunch

# game/script9.rpy:17952
translate brazil ulyssesheistlunachang_54323928:

#   adr "*Laughs* Bardot a ROLE MODEL!"
    adr "*Risos* Bardot é um modelo!"

# game/script9.rpy:17954
translate brazil ulyssesheistlunachang_69bfb145:

#   adr "*Chuckles* Oh, t-that's rich, kid. Thank you for the laugh." with dis12
    adr "*Risos* Oh, isso é rico, garoto. Obrigado pela risada." with dis12

# game/script9.rpy:17955
translate brazil ulyssesheistlunachang_07e3a101:

#   adr "B-But I agree he's a damn genius, that's true. The man would sell his family to a human-trafficking ring if it got him a better interest rate."
    adr "M-Mas eu concordo que ele é um gênio, é verdade. O homem venderia sua família para uma quadrilha de tráfico humano se isso lhe rendesse uma taxa de juros melhor."

# game/script9.rpy:17956
translate brazil ulyssesheistlunachang_9368688a:

#   adr "A true white shark."
    adr "Um verdadeiro tubarão branco."

# game/script9.rpy:17959
translate brazil ulyssesheistlunachang_eed1f9b0:

#   mc2 "I... actually even had a brief interaction with him once." with dis
    mc2 "Eu... na verdade até tive uma breve interação com ele uma vez." with dis

# game/script9.rpy:17960
translate brazil ulyssesheistlunachang_c219c7de:

#   mc2 "And from that, and what I've read, I'd say he's..."
    mc2 "E a partir disso, e do que li, eu diria que ele é..."

# game/script9.rpy:17961
translate brazil ulyssesheistlunachang_824153f4:

#   adr "Go ahead. Be honest."
    adr "Vá em frente. Seja honesto."

# game/script9.rpy:17963
translate brazil ulyssesheistlunachang_f887c10d:

#   mc2 "...I'd say he's a total psychopath. A soulless son of a bitch."
    mc2 "...Eu diria que ele é um psicopata total. Um filho da puta sem alma."

# game/script9.rpy:17964
translate brazil ulyssesheistlunachang_a97c587c:

#   mc2 "The absolute worst kind of human being."
    mc2 "O pior tipo de ser humano."

# game/script9.rpy:17965
translate brazil ulyssesheistlunachang_a1c934b1:

#   mc2 "A monster."
    mc2 "Um monstro."

# game/script9.rpy:17969
translate brazil ulyssesheistlunachang_197aaecf:

#   adr "*Laughs* You've got balls, Claimant!"
    adr "*Risos* Você tem coragem, Requerente!"

# game/script9.rpy:17971
translate brazil ulyssesheistlunachang_12e3c3c0:

#   adr "*Chuckles* Y-You really got the old baldy pegged, you son of a bitch. Must have been one hell of an interaction!" with dis12
    adr "*Risos* V-Você realmente acertou o velho careca, seu filho da puta. Deve ter sido uma interação e tanto!" with dis12

# game/script9.rpy:17972
translate brazil ulyssesheistlunachang_2f52848b:

#   adr "Bardot is a damn sociopath. No friends, no empathy, and I'm pretty sure his family's just a prop for photo ops."
    adr "Bardot é um maldito sociopata. Sem amigos, sem empatia, e tenho certeza de que a família dele é apenas um suporte para fotos."

# game/script9.rpy:17973
translate brazil ulyssesheistlunachang_b1d64ce1:

#   adr "The PERFECT businessman! Gotta love the guy."
    adr "O empresário PERFEITO! Tenho que amar o cara."

# game/script9.rpy:17975
translate brazil ulyssesheistlunachang_7def2c4f:

#   adr "Alright, but enough about Baldy Bardot..." with dis08
    adr "Tudo bem, mas chega de Baldy Bardot..." with dis08

# game/script9.rpy:17976
translate brazil ulyssesheistlunachang_991fbe0c:

#   adr "Let's move on..."
    adr "Vamos em frente..."

# game/script9.rpy:17979
translate brazil ulyssesheistlunachang_90026be0:

#   adr "—to the math test!" with hpunchsubtle
    adr "– para a prova de matemática!" with hpunchsubtle

# game/script9.rpy:17980
translate brazil ulyssesheistlunachang_2998eeca:

#   adr "How much is 25%% of 40%% of 160?"
    adr "Quanto é 25%% de 40%% de 160?"

# game/script9.rpy:17982
translate brazil ulyssesheistlunachang_d0ba6b92:

#   mc2 "U-Um..."
    mc2 "U-Um..."

# game/script9.rpy:17989
translate brazil ulyssesheistlunachang_19e92161:

#   mc2 "Uhh... 16?" with dis
    mc2 "Uh... 16?" with dis

# game/script9.rpy:17992
translate brazil ulyssesheistlunachang_82b30b33:

#   mc2 "Uhh... 24?" with dis
    mc2 "Uh... 24?" with dis

# game/script9.rpy:17995
translate brazil ulyssesheistlunachang_d717c68e:

#   mc2 "Uhh... 32?" with dis
    mc2 "Uh... 32?" with dis

# game/script9.rpy:17998
translate brazil ulyssesheistlunachang_4f6812c5:

#   mc2 "Uhh... 40?" with dis
    mc2 "Uh... 40?" with dis

# game/script9.rpy:18003
translate brazil ulyssesheistlunachang_c2971229:

#   adr "Uhhh... it's possible. I'm not sure." with dis
    adr "Uhhh... é possível. Eu não tenho certeza." with dis

# game/script9.rpy:18004
translate brazil ulyssesheistlunachang_df63ac99:

#   adr "Numbers are for accountants anyway. I'll check later."
    adr "De qualquer forma, os números são para contadores. Vou verificar mais tarde."

# game/script9.rpy:18006
translate brazil ulyssesheistlunachang_71817a25:

#   adr "But in any case, I think I’ve got you figured out, Mr. Claimant." with dis
    adr "Mas, de qualquer forma, acho que já entendi tudo, Sr. Requerente." with dis

# game/script9.rpy:18007
translate brazil ulyssesheistlunachang_230cb0e3:

#   adr "Your story’s simple, but direct. Straight to the point. Determined. I like that."
    adr "Sua história é simples, mas direta. Direto ao ponto. Determinado. Eu gosto disso."

# game/script9.rpy:18009
translate brazil ulyssesheistlunachang_9e78774e:

#   adr "It's Mr. Canchez's turn to answer the same questions now."
    adr "Agora é a vez de Canchez responder às mesmas perguntas."

# game/script9.rpy:18011
translate brazil ulyssesheistlunachang_cf343a68:

#   mct "Damn it, we're running out of time..."
    mct "Droga, estamos ficando sem tempo..."

# game/script9.rpy:18012
translate brazil ulyssesheistlunachang_bbc9de3c:

#   mct "If Luna doesn’t cut the power soon, we’re screwed..."
    mct "Se Luna não cortar a energia logo, estamos ferrados..."

# game/script9.rpy:18014
translate brazil ulyssesheistlunachang_9ef60d74:

#   adr "Tell me, Roberto, how did you end up here at Ulysses?"
    adr "Diga-me, Roberto, como você veio parar aqui no Ulisses?"

# game/script9.rpy:18015
translate brazil ulyssesheistlunachang_ab268193:

#   adr "What's {i}your{/i} story?"
    adr "Qual é a {i}sua{/i} história?"

# game/script9.rpy:18019
translate brazil ulyssesheistlunachang_6ccac617:

#   c2 "February 17th, 2010." with dis14
    c2 "17 de fevereiro de 2010." with dis14

# game/script9.rpy:18020
translate brazil ulyssesheistlunachang_0d1ee4be:

#   c2 "The small Russian village of Tigoryakhovgrad, bordering North Korea."
    c2 "A pequena aldeia russa de Tigoryakhovgrad, na fronteira com a Coreia do Norte."

# game/script9.rpy:18021
translate brazil ulyssesheistlunachang_500b6c6e:

#   mct "What...?"
    mct "O que...?"

# game/script9.rpy:18022
translate brazil ulyssesheistlunachang_6aa7670e:

#   c2 "Up until that point, my entire life had been nothing but war."
    c2 "Até aquele momento, toda a minha vida não passava de guerra."

# game/script9.rpy:18023
translate brazil ulyssesheistlunachang_69f20518:

#   c2 "I had fought for causes I didn’t believe in, carried flags I didn’t recognize, and buried brothers whose names I never learned."
    c2 "Lutei por causas nas quais não acreditava, carreguei bandeiras que não reconheci e enterrei irmãos cujos nomes nunca soube."

# game/script9.rpy:18024
translate brazil ulyssesheistlunachang_3d1ad38c:

#   c2 "But when even the echo of gunfire started to feel like home... I left. I deserted. I ran to the edge of the world, to a village no one could find, to be alone. To disappear. To finally... rest."
    c2 "Mas quando até o eco dos tiros começou a me fazer sentir em casa... eu fui embora. Eu desertei. Corri para o fim do mundo, para uma aldeia que ninguém conseguia encontrar, para ficar sozinho. Para desaparecer. Para finalmente... descansar."

# game/script9.rpy:18025
translate brazil ulyssesheistlunachang_1bbe16df:

#   c2 "But destiny... ohh... destiny has a cruel sense of humor."
    c2 "Mas o destino... ahh... o destino tem um senso de humor cruel."

# game/script9.rpy:18026
translate brazil ulyssesheistlunachang_af31b657:

#   c2 "Her name was Yuliana. I taught her Spanish. She taught me Russian."
    c2 "O nome dela era Juliana. Eu ensinei espanhol para ela. Ela me ensinou russo."

# game/script9.rpy:18027
translate brazil ulyssesheistlunachang_0c3605fc:

#   c2 "And somehow, between broken words and shy smiles... something grew. Something fragile. Something... beautiful."
    c2 "E de alguma forma, entre palavras quebradas e sorrisos tímidos... algo cresceu. Algo frágil. Algo... lindo."

# game/script9.rpy:18028
translate brazil ulyssesheistlunachang_7ba7fba6:

#   c2 "For the first time, life made sense. I was happy."
    c2 "Pela primeira vez, a vida fez sentido. Eu estava feliz."

# game/script9.rpy:18029
translate brazil ulyssesheistlunachang_554f087a:

#   c2 "But then... as it always does... fate came to collect its debt."
    c2 "Mas então... como sempre acontece... o destino veio cobrar sua dívida."

# game/script9.rpy:18030
translate brazil ulyssesheistlunachang_9a32ac47:

#   c2 "The winter of 2014, the North Korean army declared Tigoryakhovgrad a strategic border zone. There were no warnings. No diplomacy. Only... fire."
    c2 "No inverno de 2014, o exército norte-coreano declarou Tigoryakhovgrad uma zona fronteiriça estratégica. Não houve avisos. Sem diplomacia. Apenas... fogo."

# game/script9.rpy:18031
translate brazil ulyssesheistlunachang_c43b49d1:

#   c2 "They didn't ask questions. They wanted no witnesses."
    c2 "Eles não fizeram perguntas. Eles não queriam testemunhas."

# game/script9.rpy:18032
translate brazil ulyssesheistlunachang_6e7ccfe2:

#   c2 "The villagers fought back with hunting rifles and kitchen knives. Brave. Foolish. Yet... useless."
    c2 "Os aldeões reagiram com rifles de caça e facas de cozinha. Corajoso. Tolice. No entanto... inútil."

# game/script9.rpy:18033
translate brazil ulyssesheistlunachang_0a94eef7:

#   c2 "They burned everything. Old men. Mothers. Children. No one was spared."
    c2 "Eles queimaram tudo. Velhos. Mães. Crianças. Ninguém foi poupado."

# game/script9.rpy:18034
translate brazil ulyssesheistlunachang_eca872da:

#   c2 "I'll never forget the screams and the smell of burning flesh."
    c2 "Nunca esquecerei os gritos e o cheiro de carne queimada."

# game/script9.rpy:18035
translate brazil ulyssesheistlunachang_d884c4b4:

#   c2 "A single ship was docked at the harbor. People were shoving, crying, praying. I was almost aboard... when I heard it."
    c2 "Um único navio estava atracado no porto. As pessoas estavam empurrando, chorando, rezando. Eu estava quase a bordo... quando ouvi."

# game/script9.rpy:18036
translate brazil ulyssesheistlunachang_a32a5685:

#   c2 "A cry. High and thin. Coming from the local orphanage engulfed in flames."
    c2 "Um grito. Alto e fino. Vindo do orfanato local envolto em chamas."

# game/script9.rpy:18037
translate brazil ulyssesheistlunachang_77a89e99:

#   mc ". . ."
    mc ". . ."

# game/script9.rpy:18038
translate brazil ulyssesheistlunachang_43f62d70:

#   c2 "I didn't think. I just moved."
    c2 "Eu não pensei. Acabei de me mudar."

# game/script9.rpy:18039
translate brazil ulyssesheistlunachang_58840b31:

#   c2 "I kicked through the burning door and found a baby. Alive, somehow untouched, lying in a cradle of ash."
    c2 "Chutei a porta em chamas e encontrei um bebê. Vivo, de alguma forma intocado, deitado num berço de cinzas."

# game/script9.rpy:18040
translate brazil ulyssesheistlunachang_9040bcc8:

#   c2 "I wrapped him in my jacket, shielded him with my body, and ran. My lungs were fire. My vision... only smoke."
    c2 "Envolvi-o em minha jaqueta, protegi-o com meu corpo e corri. Meus pulmões eram fogo. Minha visão... só fumaça."

# game/script9.rpy:18041
translate brazil ulyssesheistlunachang_8d0fd9b0:

#   c2 "I reached the docks. The ship was leaving. Soldiers were closing in."
    c2 "Cheguei às docas. O navio estava partindo. Os soldados estavam se aproximando."

# game/script9.rpy:18042
translate brazil ulyssesheistlunachang_90e96275:

#   c2 "I knew what I had to do."
    c2 "Eu sabia o que tinha que fazer."

# game/script9.rpy:18043
translate brazil ulyssesheistlunachang_adc66256:

#   c2 "I threw the baby in a perfect spiral like an elite Super Bowl quarterback, right onto the boat, landing safely in Yuliana's arms."
    c2 "Joguei o bebê em uma espiral perfeita, como um quarterback de elite do Super Bowl, direto no barco, caindo em segurança nos braços de Yuliana."

# game/script9.rpy:18044
translate brazil ulyssesheistlunachang_939f2bf0:

#   mct "W-What?"
    mct "O-o quê?"

# game/script9.rpy:18045
translate brazil ulyssesheistlunachang_fd602b9e:

#   c2 "I turned around and raised my hands. Tried to speak."
    c2 "Eu me virei e levantei minhas mãos. Tentei falar."

# game/script9.rpy:18046
translate brazil ulyssesheistlunachang_a1b9aeb8:

#   c2 "...But they didn't let me."
    c2 "...Mas eles não me deixaram."

# game/script9.rpy:18047
translate brazil ulyssesheistlunachang_0b43b540:

#   c2 "I fell. The cold wood beneath me soaking red. My eyes heavy. My body numb."
    c2 "Caí. A madeira fria abaixo de mim está encharcada de vermelho. Meus olhos estão pesados. Meu corpo entorpecido."

# game/script9.rpy:18048
translate brazil ulyssesheistlunachang_2fe08760:

#   c2 "*Sad chuckle* In the end... war caught up to me."
    c2 "*Risada triste* No final... a guerra me alcançou."

# game/script9.rpy:18049
translate brazil ulyssesheistlunachang_d983ff0e:

#   c2 "With my last breath, I saw the boat vanishing into the mist."
    c2 "Com meu último suspiro, vi o barco desaparecendo na névoa."

# game/script9.rpy:18050
translate brazil ulyssesheistlunachang_d1a52321:

#   c2 "And... I smiled."
    c2 "E... eu sorri."

# game/script9.rpy:18051
translate brazil ulyssesheistlunachang_acc3a973:

#   c2 "Because that day, even as I died, I had finally done something right."
    c2 "Porque naquele dia, mesmo quando morri, finalmente fiz algo certo."

# game/script9.rpy:18052
translate brazil ulyssesheistlunachang_b18ca2bf:

#   c2 "I saved one life. One boy who would live. Who would see the West. Who would study, dream... and join a big company like Ulysses one day."
    c2 "Salvei uma vida. Um menino que sobreviveria. Quem veria o Ocidente. Que estudaria, sonharia... e um dia ingressaria em uma grande empresa como a Ulisses."

# game/script9.rpy:18053
translate brazil ulyssesheistlunachang_150fc4f5:

#   c2 "Or at least..."
    c2 "Ou pelo menos..."

# game/script9.rpy:18054
translate brazil ulyssesheistlunachang_cd600da5:

#   c2 "That's the story my mother Yuliana told me."
    c2 "Essa é a história que minha mãe Yuliana me contou."

# game/script9.rpy:18055
translate brazil ulyssesheistlunachang_82c0e356:

#   c2 "The story of the man who saved my life and gave me my name."
    c2 "A história do homem que salvou minha vida e me deu meu nome."

# game/script9.rpy:18056
translate brazil ulyssesheistlunachang_c66afd83:

#   c2 "That was the story... of Fernando Canchez."
    c2 "Essa foi a história... de Fernando Canchez."

# game/script9.rpy:18061
translate brazil ulyssesheistlunachang_56bed799:

#   c2 "{size=47}I was that baby." with dis15
    c2 "{size=47}Eu era aquele bebê." with dis15

# game/script9.rpy:18070
translate brazil ulyssesheistlunachang_f472e30b:

#   adr "*Sobbing* G-Gg-ggh..." with dis
    adr "*Soluçando* G-Gg-ggh..." with dis

# game/script9.rpy:18072
translate brazil ulyssesheistlunachang_1e4d5d6f:

#   adr "*Sobbing* God... what a story."
    adr "*Soluçando* Deus... que história."

# game/script9.rpy:18073
translate brazil ulyssesheistlunachang_67fe469f:

#   adr "*Sobbing* Y-Your namesake was a true hero, Canchez."
    adr "*Soluçando* S-Seu homônimo foi um verdadeiro herói, Canchez."

# game/script9.rpy:18074
translate brazil ulyssesheistlunachang_a3ea37da:

#   adr "*Sobbing* He gave his life... for yours. A baby he didn't even know."
    adr "*Soluçando* Ele deu a vida dele... pela sua. Um bebê que ele nem conhecia."

# game/script9.rpy:18077
translate brazil ulyssesheistlunachang_f8001f08:

#   c2 "I’ve fought ever since to honor his memory and fulfill his dream of me joining Ulysses someday."
    c2 "Lutei desde então para honrar sua memória e realizar seu sonho de me juntar a Ulysses algum dia."

# game/script9.rpy:18079
translate brazil ulyssesheistlunachang_63166719:

#   adr "You will honor his memory, young man."
    adr "Você honrará a memória dele, meu jovem."

# game/script9.rpy:18081
translate brazil ulyssesheistlunachang_539838f9:

#   adr "I'll make sure of it."
    adr "Eu vou ter certeza disso."

# game/script9.rpy:18082
translate brazil ulyssesheistlunachang_2a2570d9:

#   adr "The memory of Tigoryakhovgrad will prevail as long as we remember it."
    adr "A memória de Tigoryakhovgrad prevalecerá enquanto nos lembrarmos dela."

# game/script9.rpy:18084
translate brazil ulyssesheistlunachang_74614b65:

#   adr "*Clears throat* A-AHEM!" with dis
    adr "*limpa a garganta* A-AHEM!" with dis

# game/script9.rpy:18085
translate brazil ulyssesheistlunachang_ef3643f5:

#   adr "J-Jesus! Sorry, gentlemen."
    adr "J-Jesus! Desculpe, senhores."

# game/script9.rpy:18086
translate brazil ulyssesheistlunachang_bc280900:

#   adr "I usually don't get emotional so easily. Let me just..."
    adr "Normalmente não me emociono tão facilmente. Deixe-me apenas..."

# game/script9.rpy:18087
translate brazil ulyssesheistlunachang_080b55f1:

#   adr "OOF!" with hpunch
    adr "UAU!" with hpunch

# game/script9.rpy:18090
translate brazil ulyssesheistlunachang_6bf1f810:

#   adr "Alright. ALRIGHT!" with dis12
    adr "Tudo bem. TUDO BEM!" with dis12

# game/script9.rpy:18091
translate brazil ulyssesheistlunachang_dc0d11f8:

#   adr "Sorry about that."
    adr "Desculpe por isso."

# game/script9.rpy:18092
translate brazil ulyssesheistlunachang_50a752db:

#   adr "Erm... Alright, I guess we—"
    adr "Erm... Tudo bem, acho que nós..."

# game/script9.rpy:18097
translate brazil ulyssesheistlunachang_6f492ef2:

#   adr ". . ." with dis04
    adr ". . ." with dis04

# game/script9.rpy:18098
translate brazil ulyssesheistlunachang_67a10179:

#   mct "YES! Just in time!"
    mct "SIM! Bem na hora!"

# game/script9.rpy:18099
translate brazil ulyssesheistlunachang_ea410ae0:

#   mct "I knew we could count on Luna!"
    mct "Eu sabia que poderíamos contar com a Luna!"

# game/script9.rpy:18100
translate brazil ulyssesheistlunachang_da71bd00:

#   adr "What the hell...?"
    adr "Que diabos...?"

# game/script9.rpy:18103
translate brazil ulyssesheistlunachang_c9721488:

#   adr "Um... Dorothy?" with dis12
    adr "Um... Dorothy?" with dis12

# game/script9.rpy:18104
translate brazil ulyssesheistlunachang_ee1f29bd:

#   adr "What the hell is going on? Why did the light go–"
    adr "O que diabos está acontecendo? Por que a luz se apagou?"

# game/script9.rpy:18108
translate brazil ulyssesheistlunachang_17746d63:

#   adr "Oh... I-I guess the intercom's dead too." with dis
    adr "Oh... acho que o intercomunicador também está mudo." with dis

# game/script9.rpy:18111
translate brazil ulyssesheistlunachang_53cc6155:

#   adr "*Standing up* Forgive me, gentlemen." with dis14
    adr "*Levantando-se* Perdoem-me, senhores." with dis14

# game/script9.rpy:18112
translate brazil ulyssesheistlunachang_36fc4455:

#   adr "This... never happens at Ulysses. I have no idea what could have happened."
    adr "Isso... nunca acontece em Ulisses. Não tenho ideia do que poderia ter acontecido."

# game/script9.rpy:18114
translate brazil ulyssesheistlunachang_031f07bc:

#   c2 "It's not a problem, sir."
    c2 "Não é um problema, senhor."

# game/script9.rpy:18115
translate brazil ulyssesheistlunachang_b42bb585:

#   c2 "Accidents happen."
    c2 "Acidentes acontecem."

# game/script9.rpy:18117
