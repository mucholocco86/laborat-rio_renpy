#   l "I did!"
    l "Eu fiz!"

# game/script9.rpy:20817
translate brazil ga_luna3_55fd721d:

#   l "Let me show you..."
    l "Deixe-me mostrar a você..."

# game/script9.rpy:20819
translate brazil ga_luna3_7dfea4bd:

#   bla "Yet... despite your words, neither of you move. Luna continues to twirl her finger on your chest, giving you little bites on the shoulder." with dis25
    bla "No entanto... apesar de suas palavras, nenhum de vocês se move. Luna continua girando o dedo em seu peito, dando pequenas mordidas em seu ombro." with dis25

# game/script9.rpy:20820
translate brazil ga_luna3_5624f79a:

#   bla "You both decide to stay like this a little longer."
    bla "Vocês dois decidem ficar assim mais um pouco."

