translate brazil mcisback_4caf1d9d:

#   bla "Without saying another word, you gently wrap Luna in your arms, as she starts crying inconsolably on your shoulder." with dis
    bla "Sem dizer mais nada, você gentilmente envolve Luna em seus braços, enquanto ela começa a chorar inconsolavelmente em seu ombro." with dis

