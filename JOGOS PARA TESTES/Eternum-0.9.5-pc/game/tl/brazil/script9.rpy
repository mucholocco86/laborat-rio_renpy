#   bla "A blinding light suddenly floods the terrace." with dis22
    bla "Uma luz ofuscante inunda subitamente o terraço." with dis22

# game/script9.rpy:9707
translate brazil cafe09poshy_bf8c4701:

#   mc "Hmm...?"
    mc "Hum...?"

# game/script9.rpy:9709
