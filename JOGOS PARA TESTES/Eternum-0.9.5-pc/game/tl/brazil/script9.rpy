translate brazil guardwin09_90238252:

#   mc "I promised him I'd get you to safety."
    mc "Eu prometi a ele que levaria você para um lugar seguro."

# game/script9.rpy:8621
translate brazil guardwin09_8561de0e:

#   bla "Calypso drops onto a nearby chest, her leg trembling from anxiety." with dis15
    bla "Calipso cai em um baú próximo, com a perna tremendo de ansiedade." with dis15

# game/script9.rpy:8622
translate brazil guardwin09_6cdc1b4e:

#   ca "AgGgghh..."
    ca "Aggghh..."

# game/script9.rpy:8623
translate brazil guardwin09_e5f2b858:

#   ca "*Muttering* {i}Vell’arai..."
    ca "*Resmungando* {i}Vell'arai..."

# game/script9.rpy:8624
translate brazil guardwin09_cbc94dd6:

#   ca "*Muttering* What am I supposed to do now...?"
    ca "*Murmurando* O que devo fazer agora...?"

# game/script9.rpy:8626
translate brazil guardwin09_cc6140cb:

#   casc "Sylax... you... wretched, honorless {size=33}SCUM!" with hpunchsubtle
    casc "Sylax... seu... miserável e sem honra {size=33}SCUM!" with hpunchsubtle

# game/script9.rpy:8627
translate brazil guardwin09_3ef9e4b9:

#   casc "I should have had you killed a long time ago!" with hpunch
    casc "Eu deveria ter matado você há muito tempo!" with hpunch

# game/script9.rpy:8629
translate brazil guardwin09_ac138910:

#   lo "Lady Calypso..." with dis12
    lo "Senhora Calipso..." with dis12

