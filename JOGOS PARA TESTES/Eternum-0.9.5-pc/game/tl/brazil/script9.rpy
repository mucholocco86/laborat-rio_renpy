#   mc "*Standing up* (And... Calypso was right.)" with dis15
    mc "*Levantando-se* (E... Calypso estava certo.)" with dis15

# game/script9.rpy:9000
translate brazil mcisback_0eef816b:

#   mct "I can feel it..."
    mct "Eu posso sentir isso..."

# game/script9.rpy:9001
translate brazil mcisback_458749fa:

#   mct "My teleport power's back. I can jump in and out of Eternum again."
    mct "Meu poder de teletransporte voltou. Posso entrar e sair de Eternum novamente."

# game/script9.rpy:9002
translate brazil mcisback_69c6f72d:

#   mct "But... I can't sense Hyril'ar."
    mct "Mas... não consigo sentir Hyril'ar."

# game/script9.rpy:9003
translate brazil mcisback_fb302ae1:

#   mct "It’s that same weird feeling... like when I was stuck there, cut off from both Eternum and Earth."
    mct "É a mesma sensação estranha... como quando eu estava preso lá, isolado de Eternum e da Terra."

# game/script9.rpy:9004
translate brazil mcisback_037d9971:

#   mct "Now I'm cut off from there."
    mct "Agora estou isolado de lá."

# game/script9.rpy:9005
translate brazil mcisback_73d1a20d:

#   mct "Why is Hyril'ar different...?"
    mct "Por que Hyril'ar é diferente...?"

# game/script9.rpy:9010
translate brazil mcisback_389e46df:

#   mct "Well..." with dis14
    mct "Bem..." with dis14

# game/script9.rpy:9011
translate brazil mcisback_74d62929:

#   mct "Not much I can do about it right now, I guess."
    mct "Não há muito que eu possa fazer sobre isso agora, eu acho."

# game/script9.rpy:9012
translate brazil mcisback_4600515e:

#   mct "And I can't simply retain Calypso forever. She needs to be with their people, in her homeland."
    mct "E não posso simplesmente manter Calypso para sempre. Ela precisa estar com seu povo, em sua terra natal."

# game/script9.rpy:9014
translate brazil mcisback_7beb61f0:

#   mct "I can only hope she can handle those “problems” and come back to us soon."
    mct "Só posso esperar que ela consiga lidar com esses \"problemas\" e volte para nós em breve."

# game/script9.rpy:9018
translate brazil mcisback_aa9e6fb3:

#   mct "Although..." with dis14
    mct "Embora..." with dis14

# game/script9.rpy:9019
translate brazil mcisback_217da8d5:

#   mct "I can't help but feel like that goodbye was kinda... awkward?"
    mct "Não posso deixar de sentir que aquela despedida foi meio... estranha?"

# game/script9.rpy:9020
translate brazil mcisback_cd08e737:

#   mct "Was she really hinting at... something sexual?"
    mct "Ela estava realmente insinuando... algo sexual?"

# game/script9.rpy:9021
translate brazil mcisback_ade67fd1:

#   mct "No... no way. “Horny Calypso” doesn't even sound like a real thing."
    mct "Não... de jeito nenhum. “Horny Calypso” nem parece algo real."

# game/script9.rpy:9022
translate brazil mcisback_502ed4d5:

#   mct "Not our Calypso."
    mct "Não é o nosso Calipso."

# game/script9.rpy:9023
translate brazil mcisback_77a89e99:

#   mc ". . ."
    mc ". . ."

# game/script9.rpy:9024
translate brazil mcisback_e38c4739:

#   mct "Right...?"
    mct "Certo...?"

# game/script9.rpy:9028
translate brazil mcisback_18446446:

#   mct "Hmph, well, I guess I can only hope that she can handle those “problems” and come back to us soon." with dis14
    mct "Hmph, bem, acho que só posso esperar que ela consiga lidar com esses \"problemas\" e volte para nós em breve." with dis14

# game/script9.rpy:9031
translate brazil mcisback_a2064204:

#   mct "Damn you, princess..." with dis14
    mct "Maldita seja, princesa..." with dis14

# game/script9.rpy:9032
translate brazil mcisback_75930bf6:

#   mct "In the end you always have to get your way, huh?"
    mct "No final você sempre tem que conseguir o que quer, né?"

# game/script9.rpy:9035
translate brazil mcisback_bfa165b0:

#   mc "*Sighs* Ahh..." with dis14
    mc "*Suspiro* Ah..." with dis14

# game/script9.rpy:9036
translate brazil mcisback_3d499215:

#   mct "I guess now we have another reason to get those damn Gems of Doom."
    mct "Acho que agora temos outro motivo para conseguir aquelas malditas Gems of Doom."

# game/script9.rpy:9037
translate brazil mcisback_b564bb69:

#   mct "The Founder, Bardot... even Thanatos. I'm sure they’re all after Hyril’ar."
    mct "O Fundador, Bardot... até mesmo Thanatos. Tenho certeza de que todos estão atrás de Hyril'ar."

# game/script9.rpy:9038
translate brazil mcisback_0caefafa:

#   mct "They want Calypso. They want her power."
    mct "Eles querem Calipso. Eles querem o poder dela."

# game/script9.rpy:9041
translate brazil mcisback_7ec39b2b:

#   mct "But I won’t let them." with dis14
    mct "Mas não vou deixá-los." with dis14

# game/script9.rpy:9042
translate brazil mcisback_a90f505e:

#   mct "I’ll pull her out of that life, no matter what."
    mct "Vou tirá-la dessa vida, não importa o que aconteça."

# game/script9.rpy:9045
translate brazil mcisback_1cf33b2d:

#   mc "*Sighs* (But for now, I guess all I can do is wait... and hope she can hold her own in that war and get back to us soon.)" with dis14
    mc "*Suspiros* (Mas por enquanto, acho que tudo que posso fazer é esperar... e torcer para que ela consiga se virar nessa guerra e voltar para nós em breve.)" with dis14

# game/script9.rpy:9046
translate brazil mcisback_6f59f280:

#   mct "If anyone can do it... it's her."
    mct "Se alguém pode fazer isso... é ela."

# game/script9.rpy:9048
translate brazil mcisback_a6816a7a:

#   mct "In any case... now I need to get back home immediately." with dis15
    mct "De qualquer forma... agora preciso voltar para casa imediatamente." with dis15

# game/script9.rpy:9049
translate brazil mcisback_49783539:

#   mct "I lost track of time while I was there, but I've been gone way too long, that's for sure."
    mct "Perdi a noção do tempo enquanto estava lá, mas já fiquei muito tempo fora, isso é certo."

# game/script9.rpy:9050
translate brazil mcisback_82a8702e:

#   mct "God, I can't wait to see the girls again."
    mct "Deus, mal posso esperar para ver as meninas novamente."

# game/script9.rpy:9051
translate brazil mcisback_de12fccd:

#   mct "Please don’t let it be one of those “time-dilation” nightmares where it’s actually been ten years and they’ve all moved on..."
    mct "Por favor, não deixe que seja um daqueles pesadelos de “dilatação do tempo” em que já se passaram dez anos e todos seguiram em frente…"

# game/script9.rpy:9061
translate brazil mcisback_d9973dec:

#   mct "Man..." with dis14
    mct "Homem..." with dis14

# game/script9.rpy:9062
translate brazil mcisback_be2acef5:

#   mct "It feels good to be back in Kredon."
    mct "É bom estar de volta a Kredon."

# game/script9.rpy:9063
translate brazil mcisback_6591cf09:

#   mct "Feels like it’s been forever, even if it really hasn’t."
    mct "Parece que já faz uma eternidade, mesmo que realmente não tenha acontecido."

# game/script9.rpy:9064
translate brazil mcisback_024b6670:

#   mct "There’s SO much I need to tell them. Like, where do I even start...?"
    mct "Há tanta coisa que preciso contar a eles. Tipo, por onde eu começo...?"

# game/script9.rpy:9066
translate brazil mcisback_3ff4e13f:

#   mc "*Sighs* (I just hope things didn’t get rough while I was gone.)" with dis15
    mc "* Suspiros * (Só espero que as coisas não tenham ficado difíceis enquanto eu estive fora.)" with dis15

# game/script9.rpy:9067
translate brazil mcisback_473b2eda:

#   mct "I always figured they'd assume I got caught up in some last-minute mission or something, so I hope that's the case."
    mct "Sempre imaginei que eles presumiriam que fui pego em alguma missão de última hora ou algo assim, então espero que seja esse o caso."

# game/script9.rpy:9068
translate brazil mcisback_34e1dc3e:

#   mct "Who knows, maybe they didn't even notice I was missing."
    mct "Quem sabe eles nem perceberam que eu estava desaparecida."

# game/script9.rpy:9070
