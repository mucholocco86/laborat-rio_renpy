translate brazil guardwin09_46f6d9d7:

#   gua2 "Do you stand with us... or do you die with the human?"
    gua2 "Você fica conosco... ou morre com o humano?"

# game/script9.rpy:8272
translate brazil guardwin09_15c1a872:

#   gua2 "Your choice..." with dis17
    gua2 "Sua escolha..." with dis17

# game/script9.rpy:8273
translate brazil guardwin09_19ab67bb:

#   ara ". . ."
    ara ". . ."

# game/script9.rpy:8274
translate brazil guardwin09_39fd622e:

#   mc "G-General?"
    mc "G-General?"

# game/script9.rpy:8277
translate brazil guardwin09_6bab14b2:

#   ara "...How fast can you run in that... demonic form, [mc]?"
    ara "...Quão rápido você consegue correr nessa... forma demoníaca, [mc]?"

# game/script9.rpy:8279
translate brazil guardwin09_00ba439b:

#   ara "...How fast can you run in that demonic form, human?"
    ara "...Quão rápido você consegue correr nessa forma demoníaca, humano?"

# game/script9.rpy:8280
translate brazil guardwin09_4e5f0581:

#   mc "Fast enough that they won’t even see me strike."
    mc "Rápido o suficiente para que eles nem me vejam atacar."

# game/script9.rpy:8281
translate brazil guardwin09_cf0b0370:

#   mc "We can take them down."
    mc "Podemos derrubá-los."

# game/script9.rpy:8283
translate brazil guardwin09_198dcb39:

#   ara "...Good."
    ara "...Bom."

# game/script9.rpy:8284
translate brazil guardwin09_8c0881f6:

#   ara "I need you to slip past their lines and head straight for the Princess."
    ara "Preciso que você ultrapasse as linhas deles e vá direto para a princesa."

# game/script9.rpy:8285
translate brazil guardwin09_e4be5b3b:

#   ara "Tell her to flee to Vael’Thalas Hold. She’ll find sanctuary there and... allies loyal to the crown. Redveil and Ilvenmyr will not turn against us."
    ara "Diga a ela para fugir para o Forte Vael'Thalas. Ela encontrará refúgio lá e... aliados leais à coroa. Redveil e Ilvenmyr não se voltarão contra nós."

# game/script9.rpy:8286
translate brazil guardwin09_df3408e1:

#   mc "What?? No! I'm not going anywhere!"
    mc "O que?? Não! Eu não vou a lugar nenhum!"

# game/script9.rpy:8287
translate brazil guardwin09_6d5c703b:

#   mc "I will fight!"
    mc "Eu vou lutar!"

# game/script9.rpy:8288
translate brazil guardwin09_057c9af4:

#   ara "You might be fast and strong, human, but you're not invincible."
    ara "Você pode ser rápido e forte, humano, mas não é invencível."

# game/script9.rpy:8289
translate brazil guardwin09_d1b04d26:

#   ara "There could be hundreds of them. Maybe even thousands."
    ara "Poderia haver centenas deles. Talvez até milhares."

# game/script9.rpy:8290
translate brazil guardwin09_b68e3af6:

#   ara "Every second you hesitate, the danger upon the Princess and my daughter grows bigger."
    ara "A cada segundo que você hesita, o perigo para a princesa e minha filha fica maior."

# game/script9.rpy:8291
translate brazil guardwin09_8d1c80ad:

#   mc "No!"
    mc "Não!"

# game/script9.rpy:8292
translate brazil guardwin09_7405b8c6:

#   mc "I won't let you fight alo–"
    mc "Eu não vou deixar você lutar sozinho–"

# game/script9.rpy:8295
translate brazil guardwin09_c8f16fae:

#   ara "ENOUGH!" with hpunch
    ara "SUFICIENTE!" with hpunch

# game/script9.rpy:8297
translate brazil guardwin09_7f22572a:

#   ara "Have you already forgotten what I taught you?" with hpunchsubtle
    ara "Você já esqueceu o que eu te ensinei?" with hpunchsubtle

# game/script9.rpy:8298
translate brazil guardwin09_1d3de4fa:

#   ara "To fight is not to always swing your blade! The right decision must be made in the right moment!" with hpunchsubtle
    ara "Lutar não é balançar sempre a lâmina! A decisão certa deve ser tomada no momento certo!" with hpunchsubtle

# game/script9.rpy:8299
translate brazil guardwin09_c29a479d:

#   ara "I..."
    ara "EU..."

# game/script9.rpy:8302
translate brazil guardwin09_83e096d6:

#   ara "I am... I am begging you."
    ara "Eu estou... eu estou te implorando."

# game/script9.rpy:8304
translate brazil guardwin09_38619289:

#   ara "I am giving you an order, human!" with hpunchsubtle
    ara "Estou te dando uma ordem, humano!" with hpunchsubtle

# game/script9.rpy:8308
translate brazil guardwin09_56a954cc:

#   ara "Without the Princess, this entire realm will fall into darkness."
    ara "Sem a Princesa, todo este reino cairá na escuridão."

# game/script9.rpy:8309
translate brazil guardwin09_f0cae604:

#   ara "My daughter... our future..."
    ara "Minha filha... nosso futuro..."

# game/script9.rpy:8310
translate brazil guardwin09_f0d8ae57:

#   ara "You must..."
    ara "Você deve..."

# game/script9.rpy:8311
translate brazil guardwin09_f76e3153:

#   ara "You must save them. Only you can."
    ara "Você deve salvá-los. Só você pode."

# game/script9.rpy:8312
translate brazil guardwin09_2485f494:

#   mc "I..."
    mc "EU..."

# game/script9.rpy:8318
translate brazil guardwin09_530cef64:

#   mc ". . ." with dis
    mc ". . ." with dis

# game/script9.rpy:8320
translate brazil guardwin09_7279b992:

#   mc "*Nods*"
    mc "*Acena com a cabeça*"

# game/script9.rpy:8324
translate brazil guardwin09_84abb5fc:

#   ara "*Nods*"
    ara "*Acena com a cabeça*"

# game/script9.rpy:8333
translate brazil guardwin09_f3f8e71b:

#   bla "At Arannis' urging, you use your powers to slip through the guards like a bolt of lightning, racing towards Calypso." with dis25
    bla "A pedido de Arannis, você usa seus poderes para escapar dos guardas como um raio, correndo em direção a Calypso." with dis25

# game/script9.rpy:8334
translate brazil guardwin09_9f1e6c6b:

#   gua "W-What in the realms..."
    gua "O-O que nos reinos..."

# game/script9.rpy:8335
translate brazil guardwin09_52bae9d7:

#   gua2 "He disappeared!"
    gua2 "Ele desapareceu!"

# game/script9.rpy:8336
translate brazil guardwin09_dd82a66b:

#   gua "Demon! No human can wield such magic!"
    gua "Demônio! Nenhum humano pode exercer tal magia!"

# game/script9.rpy:8339
translate brazil guardwin09_7a048516:

#   bla "Arannis raises his sword and retreats a few steps until he finds himself trapped in the corner." with dis25
    bla "Arannis levanta a espada e recua alguns passos até ficar preso em um canto." with dis25

# game/script9.rpy:8341
translate brazil guardwin09_01e400fb:

#   ara "Forget about the human! Do you want my head? Come get it!" with hpunch
    ara "Esqueça o humano! Você quer minha cabeça? Venha pegar!" with hpunch

# game/script9.rpy:8342
translate brazil guardwin09_7316d286:

#   ara "Which one of you has the courage to stain his hands with blood?" with hpunch
    ara "Qual de vocês tem coragem de manchar as mãos de sangue?" with hpunch

# game/script9.rpy:8343
translate brazil guardwin09_c667b328:

#   ara "Strike me now before the eyes of the Ancients!" with hpunch
    ara "Golpeie-me agora diante dos olhos dos Antigos!" with hpunch

# game/script9.rpy:8344
translate brazil guardwin09_26ea845d:

#   ara "Let the gods bear witness to your treason!" with hpunch
    ara "Deixe os deuses testemunharem sua traição!" with hpunch

# game/script9.rpy:8347
translate brazil guardwin09_797a11f2:

#   bla "A slow wave of uncertain glances and trembling hands ripples through the soldiers as they face their former General." with dis15
    bla "Uma onda lenta de olhares incertos e mãos trêmulas percorre os soldados enquanto eles enfrentam seu ex-general." with dis15

# game/script9.rpy:8348
translate brazil guardwin09_00f207ab:

#   gua2 ". . ."
    gua2 ". . ."

# game/script9.rpy:8349
translate brazil guardwin09_bcadaef2:

#   gua ". . . . ."
    gua ". . . . ."

# game/script9.rpy:8350
translate brazil guardwin09_4d43081b:

#   syl "Halt!" with hpunch
    syl "Pare!" with hpunch

# game/script9.rpy:8353
translate brazil guardwin09_1a0f7f4f:

#   bla "The soldiers suddenly fall into formation in perfect unison, swiftly clearing a path for their new commander." with dis2
    bla "Os soldados repentinamente entram em formação em perfeita uníssono, abrindo rapidamente caminho para seu novo comandante." with dis2

# game/script9.rpy:8357
translate brazil guardwin09_bed5246f:

#   syl "Aaahh..." with dis17
    syl "Aaaah..." with dis17

# game/script9.rpy:8359
translate brazil guardwin09_1bc6bfa9:

#   syl "We meet again, Morning Sword." with dis15
    syl "Nos encontramos novamente, Morning Sword." with dis15

# game/script9.rpy:8361
translate brazil guardwin09_ac4ae49d:

#   ara "Sylax... you parasite..." with dis
    ara "Sylax... seu parasita..." with dis

# game/script9.rpy:8362
translate brazil guardwin09_e3ee9743:

#   ara "Are you the architect of this madness?!"
    ara "Você é o arquiteto dessa loucura?!"

# game/script9.rpy:8364
translate brazil guardwin09_e4377c22:

#   syl "The time has come for a change, Arannis."
    syl "Chegou a hora de mudar, Arannis."

# game/script9.rpy:8365
translate brazil guardwin09_8c05a0c3:

#   syl "And deep down, you know it as well as I do."
    syl "E no fundo você sabe disso tão bem quanto eu."

# game/script9.rpy:8367
translate brazil guardwin09_0a4f667b:

#   syl "But let it never be said that Lord Sylax lacks mercy." with dis
    syl "Mas nunca se diga que falta misericórdia a Lord Sylax." with dis

# game/script9.rpy:8368
translate brazil guardwin09_7db5937e:

#   syl "Drop your weapon now, and I shall spare your life... and your daughter’s."
    syl "Largue sua arma agora e pouparei sua vida... e a de sua filha."

# game/script9.rpy:8370
translate brazil guardwin09_9c3d5fce:

#   ara "You have already proven your word is as solid as ash, traitor."
    ara "Você já provou que sua palavra é sólida como cinzas, traidor."

# game/script9.rpy:8371
translate brazil guardwin09_77cfa78d:

#   ara "I will not heed the words of one who turned against his kin."
    ara "Não darei ouvidos às palavras de alguém que se voltou contra os seus parentes."

# game/script9.rpy:8373
translate brazil guardwin09_58235a68:

#   syl "We bear no hatred for you, nor for your bloodline, General."
    syl "Não sentimos ódio por você, nem por sua linhagem, General."

# game/script9.rpy:8374
translate brazil guardwin09_7b41eabd:

#   syl "Any elf who would stand with us... for the salvation of Hyril'ar... shall be treated with honor and welcomed into the new dawn we will forge."
    syl "Qualquer elfo que esteja conosco... pela salvação de Hyril'ar... será tratado com honra e recebido no novo amanhecer que forjaremos."

# game/script9.rpy:8377
translate brazil guardwin09_f987ede1:

#   ara "Hmph."
    ara "Hmph."

# game/script9.rpy:8379
translate brazil guardwin09_a8267433:

#   ara "Speak then. What are your terms?" with dis
    ara "Fale então. Quais são os seus termos?" with dis

# game/script9.rpy:8381
translate brazil guardwin09_fc469028:

#   syl "You will be stripped of all rank and title, but you and your daughter shall be granted safe passage beyond our borders."
    syl "Você será destituído de toda posição e título, mas você e sua filha terão passagem segura além de nossas fronteiras."

# game/script9.rpy:8382
translate brazil guardwin09_85e51a6d:

#   syl "You have my word, bound by the old rites."
    syl "Você tem minha palavra, vinculada aos antigos ritos."

# game/script9.rpy:8384
translate brazil guardwin09_4124e122:

#   ara "The Old Houses will never bow to you."
    ara "As Casas Velhas nunca se curvarão diante de você."

# game/script9.rpy:8385
translate brazil guardwin09_8b972b5a:

#   ara "They will remain loyal to the true heir."
    ara "Eles permanecerão leais ao verdadeiro herdeiro."

# game/script9.rpy:8387
translate brazil guardwin09_61b8371e:

#   syl "*Mocking chuckle* Mm-hm."
    syl "*Risada zombeteira* Mm-hm."

# game/script9.rpy:8389
translate brazil guardwin09_1264afe6:

#   syl "I hold dominion over nearly the entire Royal Guard."
    syl "Eu mantenho domínio sobre quase toda a Guarda Real."

# game/script9.rpy:8390
translate brazil guardwin09_fd939eb0:

#   syl "Thirinvale and Ysion have already pledged allegiance to our cause."
    syl "Thirinvale e Ysion já juraram lealdade à nossa causa."

# game/script9.rpy:8391
translate brazil guardwin09_2bc170a1:

#   syl "And as we speak, dissidents are being rooted out from the capital."
    syl "E enquanto falamos, os dissidentes estão a ser erradicados da capital."

# game/script9.rpy:8392
translate brazil guardwin09_0d8a209f:

#   syl "By the break of day, a new banner shall fly across every bastion of Hyril'ar."
    syl "Ao amanhecer, um novo estandarte voará sobre cada bastião de Hyril'ar."

# game/script9.rpy:8394
translate brazil guardwin09_af02fe2e:

#   ara "A throne won by blood and treachery is a throne cursed to ruin."
    ara "Um trono conquistado por sangue e traição é um trono amaldiçoado à ruína."

# game/script9.rpy:8395
translate brazil guardwin09_61344d8d:

#   ara "You will all destroy this realm from within."
    ara "Todos vocês destruirão este reino por dentro."

# game/script9.rpy:8396
translate brazil guardwin09_c1de2c54:

#   ara "And when you realize that... it shall already be too late."
    ara "E quando você perceber isso... já será tarde demais."

# game/script9.rpy:8399
translate brazil guardwin09_90f124c5:

#   syl "Do not mistake rebirth for ruin." with dis
    syl "Não confunda renascimento com ruína." with dis

# game/script9.rpy:8400
translate brazil guardwin09_5e5a7fcc:

#   syl "It was Raewyn who doomed this realm... not me."
    syl "Foi Raewyn quem condenou este reino... não eu."

# game/script9.rpy:8401
translate brazil guardwin09_00f7ecd6:

#   syl "I will raise it anew from the ashes he and his daughter left behind."
    syl "Vou ressuscitá-lo das cinzas que ele e sua filha deixaram para trás."

# game/script9.rpy:8404
translate brazil guardwin09_1a7d0ee5:

#   syl "But... enough words." with dis
    syl "Mas... palavras suficientes." with dis

# game/script9.rpy:8406
translate brazil guardwin09_0fb0096b:

#   syl "Your own men have betrayed you, Arannis." with dis
    syl "Os seus próprios homens traíram-no, Arannis." with dis

# game/script9.rpy:8407
translate brazil guardwin09_e60cd4fb:

#   syl "You stand alone."
    syl "Você está sozinho."

# game/script9.rpy:8409
translate brazil guardwin09_5f4b772c:

#   syl "Surrender and tell us where the Princess and that human went to..." with dis
    syl "Renda-se e conte-nos para onde a Princesa e aquele humano foram..." with dis

# game/script9.rpy:8410
translate brazil guardwin09_e15686cd:

#   syl "...or die."
    syl "...ou morrer."

# game/script9.rpy:8412
translate brazil guardwin09_d0c52370:

#   ara "If you seek blood, then draw your blade, Sylax!"
    ara "Se você procura sangue, então saque sua lâmina, Sylax!"

# game/script9.rpy:8413
translate brazil guardwin09_3e85c092:

#   ara "I will show you the true strength of Hyril'ar!" with hpunch
    ara "Vou te mostrar a verdadeira força de Hyril'ar!" with hpunch

# game/script9.rpy:8415
translate brazil guardwin09_f7117916:

#   syl "*Laughs coldly* How brave..."
    syl "*Ri friamente* Que corajoso..."

# game/script9.rpy:8416
translate brazil guardwin09_60f81d50:

#   syl "Ahh..."
    syl "Ahh..."

# game/script9.rpy:8417
translate brazil guardwin09_ccc94eda:

#   syl "Arannis, Hammer of Iron. The Morning Sword."
    syl "Arannis, Martelo de Ferro. A Espada da Manhã."

# game/script9.rpy:8418
translate brazil guardwin09_6b1d6705:

#   syl "General of the legions of Hyril’ar since the end of the Second Era."
    syl "General das legiões de Hyril'ar desde o final da Segunda Era."

# game/script9.rpy:8420
translate brazil guardwin09_977fe0b3:

#   syl "They said no blade could touch you." with dis12
    syl "Eles disseram que nenhuma lâmina poderia tocar em você." with dis12

# game/script9.rpy:8421
translate brazil guardwin09_dac355b8:

#   syl "They said you were able to end a cavalry battalion single-handedly with but a sword in hand."
    syl "Eles disseram que você foi capaz de acabar com um batalhão de cavalaria sozinho, apenas com uma espada na mão."

# game/script9.rpy:8422
translate brazil guardwin09_b7c002c9:

#   syl "You were a legend, once."
    syl "Você já foi uma lenda."

# game/script9.rpy:8423
translate brazil guardwin09_946767a7:

#   syl "But..."
    syl "Mas..."

# game/script9.rpy:8425
translate brazil guardwin09_bc447aae:

#   syl "That was long ago, was it not, my friend?" with dis12
    syl "Isso foi há muito tempo, não foi, meu amigo?" with dis12

# game/script9.rpy:8426
translate brazil guardwin09_265815dd:

#   syl "Your prime lies buried in the past."
    syl "Seu auge está enterrado no passado."

# game/script9.rpy:8428
translate brazil guardwin09_59503508:

#   syl "You have grown old, Arannis... even for an elf." with dis12
    syl "Você envelheceu, Arannis... mesmo para um elfo." with dis12

# game/script9.rpy:8430
translate brazil guardwin09_45128b3b:

#   syl "We both know how this ends."
    syl "Nós dois sabemos como isso termina."

# game/script9.rpy:8431
translate brazil guardwin09_570b105a:

#   syl "You cannot win. {i}She{/i} cannot win."
    syl "Você não pode vencer. {i}Ela{/i} não pode vencer."

# game/script9.rpy:8432
translate brazil guardwin09_54f38539:

#   syl "Hyril'ar demands rebirth."
    syl "Hyril'ar exige renascimento."

# game/script9.rpy:8434
translate brazil guardwin09_ec642ca8:

#   syl "Now lay down your weapon... and tell us where the human has gone."
    syl "Agora largue a sua arma... e diga-nos para onde foi o humano."

# game/script9.rpy:8435
translate brazil guardwin09_e512bc26:

#   syl "This is your final chance to save your life... and your daughter's."
    syl "Esta é a sua última chance de salvar a sua vida... e a da sua filha."

# game/script9.rpy:8436
translate brazil guardwin09_9d99ea28:

#   ara "Hmh–"
    ara "Hm-"

# game/script9.rpy:8442
translate brazil guardwin09_0905435a:

#   bla "After some hesitation, Arannis finally lowers his sword." with dis2
    bla "Depois de alguma hesitação, Arannis finalmente abaixa a espada." with dis2

# game/script9.rpy:8444
translate brazil guardwin09_d8214df3:

#   ara "Forgive me... Your Grace."
    ara "Perdoe-me... Vossa Graça."

# game/script9.rpy:8446
translate brazil guardwin09_c6e70b56:

#   syl "*Chuckles* Hmph."
    syl "*Risos* Hmph."

# game/script9.rpy:8448
translate brazil guardwin09_cf377c28:

#   syl "You made the right choice, Arannis."
    syl "Você fez a escolha certa, Arannis."

# game/script9.rpy:8449
translate brazil guardwin09_b76c985e:

#   syl "I promise you that–"
    syl "Eu prometo a você isso-"

# game/script9.rpy:8450
translate brazil guardwin09_97a411de:

#   ara "Three thousand six hundred and thirty."
    ara "Três mil seiscentos e trinta."

# game/script9.rpy:8452
translate brazil guardwin09_2f12aa8f:

#   syl "Huh?" with dis
    syl "Huh?" with dis

# game/script9.rpy:8455
translate brazil guardwin09_fdefc521:

#   ara ". . ." with dis22
    ara ". . ." with dis22

# game/script9.rpy:8459
translate brazil guardwin09_d05267e9:

#   ara "Three thousand six hundred and thirty years have I walked this world."
    ara "Há três mil seiscentos e trinta anos que ando neste mundo."

# game/script9.rpy:8460
translate brazil guardwin09_ab13d20f:

#   ara "I have traversed lands whose names no longer remain on the tongues of men, orcs, dwarves, or elves."
    ara "Atravessei terras cujos nomes não permanecem mais na língua de homens, orcs, anões ou elfos."

# game/script9.rpy:8461
translate brazil guardwin09_62118d93:

#   ara "I have known power, glory, and the respect of nations."
    ara "Conheci o poder, a glória e o respeito das nações."

# game/script9.rpy:8462
translate brazil guardwin09_6e23306f:

#   ara "I have had everything I could have ever wished for."
    ara "Eu tive tudo que poderia ter desejado."

# game/script9.rpy:8463
translate brazil guardwin09_fba99e38:

#   ara "And yet..."
    ara "E ainda assim..."

# game/script9.rpy:8465
translate brazil guardwin09_ec71c349:

#   ara "Never have I felt more alive than in these final years." with dis17
    ara "Nunca me senti mais vivo do que nestes últimos anos." with dis17

# game/script9.rpy:8466
translate brazil guardwin09_9cfb4ff3:

#   ara "Never have I known greater joy than the day my daughter first opened her eyes to the world."
    ara "Nunca conheci maior alegria do que o dia em que minha filha abriu os olhos para o mundo pela primeira vez."

# game/script9.rpy:8468
translate brazil guardwin09_bed578e3:

#   ara "And..." with dis17
    ara "E..." with dis17

# game/script9.rpy:8469
translate brazil guardwin09_1e24cab4:

#   ara "Never have I felt such honor as when King Raewyn, with his dying breath, entrusted me with the protection of his only daughter..."
    ara "Nunca senti tanta honra como quando o Rei Raewyn, em seu último suspiro, me confiou a proteção de sua única filha..."

# game/script9.rpy:8470
translate brazil guardwin09_69a5efc5:

#   ara "...the rightful heir to Hyril'ar..."
    ara "...o legítimo herdeiro de Hyril'ar..."

# game/script9.rpy:8471
translate brazil guardwin09_ab85f938:

#   ara "Lady Calypso."
    ara "Senhora Calipso."

# game/script9.rpy:8474
translate brazil guardwin09_9112788f:

#   ara "Three thousand six hundred and thirty years in this world..."
    ara "Três mil seiscentos e trinta anos neste mundo..."

# game/script9.rpy:8478
translate brazil guardwin09_65a11555:

#   ara "And not once did I imagine that my last stand would be shielding the retreat of a human." with dis2
    ara "E nem uma vez imaginei que minha última resistência seria proteger a retirada de um humano." with dis2

# game/script9.rpy:8479
translate brazil guardwin09_ded7f98b:

#   ara "But... I will gladly lay down my life without hesitation..."
    ara "Mas... com prazer darei minha vida sem hesitação..."

# game/script9.rpy:8481
translate brazil guardwin09_05932076:

#   ara "...if it means watching you dragged into the pit from which you came." with dis17
    ara "...se isso significar ver você sendo arrastado para o buraco de onde veio." with dis17

# game/script9.rpy:8482
translate brazil guardwin09_a139253b:

#   ara "As long as Lady Calypso is alive..."
    ara "Enquanto Lady Calypso estiver viva..."

# game/script9.rpy:8483
translate brazil guardwin09_3a514042:

#   ara "Hyril'ar shall never be yours."
    ara "Hyril'ar nunca será seu."

# game/script9.rpy:8484
translate brazil guardwin09_a7b249a0:

#   syl ". . ."
    syl ". . ."

# game/script9.rpy:8487
translate brazil guardwin09_87c57e01:

#   syl "You have made your choice, old fool." with dis12
    syl "Você fez sua escolha, velho tolo." with dis12

# game/script9.rpy:8488
translate brazil guardwin09_72f36ced:

#   syl "I will see your head impaled beside your wretched daughter’s... and the Princess’ as well."
    syl "Verei sua cabeça empalada ao lado da de sua filha miserável... e da princesa também."

# game/script9.rpy:8489
translate brazil guardwin09_1810d966:

#   syl "I always knew you'd meet your end heeding the commands of that whore you so blindly pledged to protect."
    syl "Eu sempre soube que você chegaria ao seu fim obedecendo aos comandos daquela prostituta que você tão cegamente prometeu proteger."

# game/script9.rpy:8490
translate brazil guardwin09_a1dab4fa:

#   syl "Even if it meant shielding a nauseating human... or drowning in a pit of filth."
    syl "Mesmo que isso significasse proteger um humano nauseante... ou se afogar em um poço de sujeira."

# game/script9.rpy:8492
translate brazil guardwin09_67c9b6fb:

#   ara "Oh, well..."
    ara "Ah bem..."

# game/script9.rpy:8493
translate brazil guardwin09_4ad3a823:

#   ara "I never once doubted that, either."
    ara "Também nunca duvidei disso."

# game/script9.rpy:8499
translate brazil guardwin09_0cb1b6c7:

#   syl "*Grinding his teeth* You insufferable relic..." with dis15
    syl "*Ringando os dentes* Sua relíquia insuportável..." with dis15

# game/script9.rpy:8500
translate brazil guardwin09_83688d0e:

#   syl "{sc=3}{b}{size=30}Kill him."
    syl "{sc=3}{b}{size=30}Mate-o."

# game/script9.rpy:8517
translate brazil guardwin09_22f87f31:

#   mc "*Panting* (O-Okay... I made it...)" with dis15
    mc "* Ofegante * (O-Ok... eu consegui...)" with dis15

# game/script9.rpy:8518
translate brazil guardwin09_97370f41:

#   mct "This is where I trained with Arannis the first day..."
    mct "Foi aqui que treinei com Arannis no primeiro dia..."

# game/script9.rpy:8519
translate brazil guardwin09_976cc041:

#   mct "But..."
    mct "Mas..."

# game/script9.rpy:8520
translate brazil guardwin09_9ecf9fb7:

#   mct "F-Fuck, there's no one here."
    mct "Porra, não tem ninguém aqui."

# game/script9.rpy:8521
translate brazil guardwin09_fd25829f:

#   mct "Did Calypso and Lorelei escape already? Or... were they caught...?"
    mct "Calypso e Lorelei já escaparam? Ou... eles foram pegos...?"

# game/script9.rpy:8522
translate brazil guardwin09_8a553403:

#   mc "*Shouting* P-Princess Calypso...?!" with hpunchsubtle
    mc "*Gritando* P-Princesa Calypso...?!" with hpunchsubtle

# game/script9.rpy:8524
translate brazil guardwin09_7b62a6c8:

#   mct "Goddammit... there's no way they can hear me over this fucking rain." with dis12
    mct "Droga... não tem como eles me ouvirem com essa porra de chuva." with dis12

# game/script9.rpy:8525
translate brazil guardwin09_02e5fa80:

#   mct "And I can forget about finding footsteps or horse tracks."
    mct "E posso esquecer de encontrar pegadas ou pegadas de cavalos."

# game/script9.rpy:8528
translate brazil guardwin09_90a0ab07:

#   mct "The ground's already turning to sludge."
    mct "O chão já está virando lama."

# game/script9.rpy:8529
translate brazil guardwin09_92079ea8:

#   mct "And of course, to top it off, now the storm's picking up..."
    mct "E, claro, para completar, agora a tempestade está aumentando..."

# game/script9.rpy:8530
translate brazil guardwin09_b5b3cd9c:

#   mct "Fucking great..."
    mct "Fodidamente ótimo..."

# game/script9.rpy:8531
translate brazil guardwin09_71f879d7:

#   mcsc "CALYPSO!!!" with hpunch
    mcsc "CALIPSO!!!" with hpunch

# game/script9.rpy:8532
translate brazil guardwin09_eee01e56:

#   ca "You see? I told you it was not simply thunder."
    ca "Você vê? Eu lhe disse que não era simplesmente um trovão."

# game/script9.rpy:8534
translate brazil guardwin09_1c6853d5:

#   mc "Huh??" with dis
    mc "Huh??" with dis

# game/script9.rpy:8537
translate brazil guardwin09_32fa41be:

#   ca "Hmm?" with dis12
    ca "Hum?" with dis12

# game/script9.rpy:8539
translate brazil guardwin09_dcbf5de4:

#   ca "What are you doing out there in this downpour, [mc]?"
    ca "O que você está fazendo aí com essa chuva torrencial, [mc]?"

# game/script9.rpy:8541
translate brazil guardwin09_33e27b4e:

#   mc "Oh, thank god!"
    mc "Ah, graças a Deus!"

# game/script9.rpy:8543
translate brazil guardwin09_c7778679:

#   ca "Come here, you fool, before you fall ill standing out there like that."
    ca "Venha aqui, seu idiota, antes que você adoeça parado aí desse jeito."

# game/script9.rpy:8545
translate brazil guardwin09_14bbc7fc:

#   mc "Y-Yes!"
    mc "S-Sim!"

# game/script9.rpy:8550
translate brazil guardwin09_6ac4f1fc:

#   bla "You walk to where Calypso and Lorelei shelter from the rain." with dis22
    bla "Você caminha até onde Calypso e Lorelei se protegem da chuva." with dis22

# game/script9.rpy:8551
translate brazil guardwin09_2b6e5fc7:

#   mc "*Still catching your breath* Oh thank f-fucking god..."
    mc "*Ainda recuperando o fôlego* Oh, graças a Deus..."

# game/script9.rpy:8552
translate brazil guardwin09_024feb43:

#   mc "*Still catching your breath* You're still alright..."
    mc "*Ainda recuperando o fôlego* Você ainda está bem..."

# game/script9.rpy:8554
translate brazil guardwin09_88ada11a:

#   ca "By the ancients, [mc], you are completely drenched."
    ca "Pelos antigos, [mc], você está completamente encharcado."

# game/script9.rpy:8555
translate brazil guardwin09_a2b00191:

#   ca "You should change out of those wet clothes at once."
    ca "Você deveria tirar essas roupas molhadas imediatamente."

# game/script9.rpy:8557
translate brazil guardwin09_700f4756:

#   mc "T-There's no time for that!"
    mc "T-Não há tempo para isso!"

# game/script9.rpy:8558
translate brazil guardwin09_928c486a:

#   mc "Listen, we... we need to move. Now."
    mc "Ouça, nós... precisamos nos mudar. Agora."

# game/script9.rpy:8559
translate brazil guardwin09_1a2c3e9c:

#   mc "I don't even know where to start, but..."
    mc "Nem sei por onde começar, mas..."

# game/script9.rpy:8560
translate brazil guardwin09_74d68e43:

#   mc "W-We were attacked. Hyril'ar... is under attack."
    mc "Fomos atacados. Hyril'ar... está sob ataque."

# game/script9.rpy:8563
translate brazil guardwin09_f0d51e10:

#   ca "Excuse me...?" (multiple=2)
    ca "Com licença...?" (multiple=2)

# game/script9.rpy:8564
translate brazil guardwin09_c123892b:

#   lo "What?!" (multiple=2) with dis12
    lo "O que?!" (multiple=2) with dis12

# game/script9.rpy:8565
translate brazil guardwin09_e5ee1ad3:

#   ca "By whom?!"
    ca "Por quem?!"

# game/script9.rpy:8567
translate brazil guardwin09_2ad3467d:

#   mc "It's... it's coming from the inside. A coup."
    mc "Está... está vindo de dentro. Um golpe."

# game/script9.rpy:8569
translate brazil guardwin09_087ad6d9:

#   mc "The regent... that motherfucker, Sylax, from the trial!"
    mc "O regente... aquele filho da puta, Sylax, do julgamento!"

# game/script9.rpy:8570
translate brazil guardwin09_75ae8089:

#   mc "He’s the one behind the coup. He rallied most of the royal guard to his side."
    mc "Ele é quem está por trás do golpe. Ele reuniu a maior parte da guarda real ao seu lado."

# game/script9.rpy:8571
translate brazil guardwin09_7b2e1376:

#   mc "They launched a coordinated strike across the realm tonight, all at once."
    mc "Eles lançaram um ataque coordenado em todo o reino esta noite, de uma só vez."

# game/script9.rpy:8572
translate brazil guardwin09_3ea2236e:

#   mc "I don’t know how many turned, but it’s bad. Really bad."
    mc "Não sei quantos viraram, mas é ruim. Muito ruim."

# game/script9.rpy:8574
translate brazil guardwin09_a2bb007c:

#   ca "B-But how..."
    ca "M-Mas como..."

# game/script9.rpy:8575
translate brazil guardwin09_2003e5ae:

#   ca "I mean, my advisors warned me that this could happen, but..."
    ca "Quer dizer, meus conselheiros me avisaram que isso poderia acontecer, mas..."

# game/script9.rpy:8576
translate brazil guardwin09_e6540a2c:

#   ca "...Never so soon."
    ca "...Nunca tão cedo."

# game/script9.rpy:8577
translate brazil guardwin09_a896d9f0:

#   ca "They said they were a negligible minority."
    ca "Eles disseram que eram uma minoria insignificante."

# game/script9.rpy:8579
translate brazil guardwin09_7e0e8801:

#   mc "I don’t know how deep it goes. I don’t know who we can trust."
    mc "Não sei até que ponto isso vai. Não sei em quem podemos confiar."

# game/script9.rpy:8580
translate brazil guardwin09_90138756:

#   mc "But I know this much — they’re after {i}you{/i}, Calypso."
    mc "Mas uma coisa eu sei: eles estão atrás de {i}você{/i}, Calipso."

# game/script9.rpy:8581
translate brazil guardwin09_b0d2a8dc:

#   mc "You're the only one standing in their way. They want you dead."
    mc "Você é o único que está no caminho deles. Eles querem você morto."

# game/script9.rpy:8583
translate brazil guardwin09_5d473864:

#   ca "By the ancestors..."
    ca "Pelos ancestrais..."

# game/script9.rpy:8584
translate brazil guardwin09_3189bffc:

#   ca "We must return to the palace immediately."
    ca "Devemos voltar ao palácio imediatamente."

# game/script9.rpy:8585
translate brazil guardwin09_855ad79e:

#   ca "We need to stop this."
    ca "Precisamos parar com isso."

# game/script9.rpy:8588
translate brazil guardwin09_cd4fc9be:

#   mc "You can’t go back! Not now!"
    mc "Você não pode voltar! Agora não!"

# game/script9.rpy:8589
translate brazil guardwin09_f43d12fe:

#   mc "We don’t know who’s loyal and who’s waiting to stab you in the back!"
    mc "Não sabemos quem é leal e quem está esperando para apunhalar você pelas costas!"

# game/script9.rpy:8590
translate brazil guardwin09_7e1f093b:

#   mc "I saw it myself. They have no honor!"
    mc "Eu mesmo vi. Eles não têm honra!"

# game/script9.rpy:8591
translate brazil guardwin09_ba2f85bb:

#   mc "We need to flee and come up with a plan. NOW."
    mc "Precisamos fugir e bolar um plano. AGORA."

# game/script9.rpy:8593
translate brazil guardwin09_9e118e50:

#   lo "B-But..." with dis12
    lo "M-Mas..." with dis12

# game/script9.rpy:8594
translate brazil guardwin09_89c1d8bf:

#   lo "That is not possible."
    lo "Isso não é possível."

# game/script9.rpy:8595
translate brazil guardwin09_d31f8c4f:

#   lo "The royal guard answers to my father."
    lo "A guarda real responde ao meu pai."

# game/script9.rpy:8596
translate brazil guardwin09_a4771888:

#   lo "He would never turn against Princess Calypso."
    lo "Ele nunca se voltaria contra a princesa Calypso."

# game/script9.rpy:8598
translate brazil guardwin09_4525f57e:

#   mc "I know. And he didn't. He was betrayed."
    mc "Eu sei. E ele não o fez. Ele foi traído."

# game/script9.rpy:8599
translate brazil guardwin09_ed194e31:

#   mc "He’s the one who told me to warn you and to get you out of here."
    mc "Foi ele quem me disse para avisar você e tirar você daqui."

# game/script9.rpy:8600
translate brazil guardwin09_d43bfdba:

#   mc "When the attack started, the other soldiers turned on us, and he..."
    mc "Quando o ataque começou, os outros soldados viraram-se contra nós, e ele..."

# game/script9.rpy:8601
translate brazil guardwin09_f2f033a7:

#   mc "He... stayed behind. Bought me enough time to reach you."
    mc "Ele... ficou para trás. Ganhei tempo suficiente para entrar em contato com você."

# game/script9.rpy:8604
translate brazil guardwin09_880498c4:

#   lo "W-What?!" with dis
    lo "O-O que?!" with dis

# game/script9.rpy:8605
translate brazil guardwin09_6c637de9:

#   lo "Where is he now?! My father!"
    lo "Onde ele está agora?! Meu pai!"

# game/script9.rpy:8607
translate brazil guardwin09_ffcea0e4:

#   mc "I-I don't know."
    mc "Eu-eu não sei."

# game/script9.rpy:8609
translate brazil guardwin09_25cccbc0:

#   lo "What do you mean you don't know?!"
    lo "O que quer dizer com você não sabe?!"

# game/script9.rpy:8610
translate brazil guardwin09_8b059894:

#   lo "Sylax will have him killed!"
    lo "Sylax vai matá-lo!"

# game/script9.rpy:8612
translate brazil guardwin09_11bfb7a2:

#   mc "General Arannis wouldn’t go down like that."
    mc "O General Arannis não cairia assim."

# game/script9.rpy:8613
translate brazil guardwin09_c19d7668:

#   mc "And... even if he was captured, he’s too valuable to kill outright!"
    mc "E... mesmo que ele tenha sido capturado, ele é valioso demais para ser morto imediatamente!"

# game/script9.rpy:8614
translate brazil guardwin09_a82621ac:

#   mc "If you go back and get caught too, we won't be able to help him!"
    mc "Se você voltar e for pego também, não poderemos ajudá-lo!"

