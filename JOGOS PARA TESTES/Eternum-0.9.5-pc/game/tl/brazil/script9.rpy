    mc "Ah, você não tem ideia..."

# game/script9.rpy:9321
translate brazil mcisback_f5b7e09f:

#   mc "Go prepare some coffee for everyone, Nancy."
    mc "Vá preparar um café para todos, Nancy."

# game/script9.rpy:9322
translate brazil mcisback_2da09bb1:

#   mc "This is going to be one hell of a story."
    mc "Esta vai ser uma história e tanto."

# game/script9.rpy:9324
translate brazil mcisback_ab10c6d1:

#   n "You got it."
    n "Você entendeu."

# game/script9.rpy:9327
translate brazil mcisback_51704373:

#   n "But first... you should go find Luna."
    n "Mas primeiro... você deveria encontrar Luna."

# game/script9.rpy:9328
translate brazil mcisback_228b2189:

#   n "She should be on her way back by now."
    n "Ela já deveria estar voltando."

# game/script9.rpy:9330
translate brazil mcisback_85d475fe:

#   mc "Of course!"
    mc "Claro!"

# game/script9.rpy:9331
translate brazil mcisback_1b5558e3:

#   mc "Where is she?"
    mc "Onde ela está?"

# game/script9.rpy:9333
translate brazil mcisback_8aaf275d:

#   n "She went to her father’s place to get some food for all of us."
    n "Ela foi até a casa do pai buscar comida para todos nós."

# game/script9.rpy:9334
translate brazil mcisback_ba54cf0d:

#   n "You’ll probably run into her if you head that way."
    n "Você provavelmente vai topar com ela se for por ali."

# game/script9.rpy:9336
translate brazil mcisback_59d5da21:

#   n "We... we owe her more than we can ever repay, [mc]."
    n "Nós... nós devemos a ela mais do que podemos pagar, [mc]."

# game/script9.rpy:9337
translate brazil mcisback_7df4daa6:

#   n "Every time someone broke down, Luna was there."
    n "Cada vez que alguém desabava, Luna estava lá."

# game/script9.rpy:9338
translate brazil mcisback_21e0c71d:

#   n "She held us all together with just... a smile. Like it was nothing."
    n "Ela nos manteve unidos com apenas... um sorriso. Como se não fosse nada."

# game/script9.rpy:9339
translate brazil mcisback_16eb3775:

#   n "She never stopped smiling. She never cried."
    n "Ela nunca parou de sorrir. Ela nunca chorou."

# game/script9.rpy:9340
translate brazil mcisback_63ab0194:

#   n "That gave us strength. It gave us... hope."
    n "Isso nos deu força. Isso nos deu... esperança."

# game/script9.rpy:9342
translate brazil mcisback_90a3d07d:

#   mc "She’s always had that gift."
    mc "Ela sempre teve esse dom."

# game/script9.rpy:9343
translate brazil mcisback_c01246aa:

#   mc "The world can be crumbling, but somehow, when she smiles... it feels like everything’s okay again."
    mc "O mundo pode estar desmoronando, mas de alguma forma, quando ela sorri... parece que tudo está bem novamente."

# game/script9.rpy:9344
translate brazil mcisback_e58297ce:

#   mc "I'm..."
    mc "Eu sou..."

# game/script9.rpy:9345
translate brazil mcisback_3aaf108b:

#   mc "I'm so happy to see you all again, Nancy. You have no idea."
    mc "Estou muito feliz em ver todos vocês novamente, Nancy. Você não tem ideia."

# game/script9.rpy:9347
translate brazil mcisback_6bf04887:

#   n "And we’re happy to have you back, [mc]."
    n "E estamos felizes por ter você de volta, [mc]."

# game/script9.rpy:9348
translate brazil mcisback_d7f179c4:

#   n "Now go, go!"
    n "Agora vá, vá!"

# game/script9.rpy:9349
translate brazil mcisback_c720a8a5:

#   n "And don’t take too long! We {i}need{/i} to hear everything you’ve been through!"
    n "E não demore muito! Nós {i}precisamos{/i} ouvir tudo o que você passou!"

# game/script9.rpy:9351
translate brazil mcisback_0696afa4:

#   mc "I will! I promise!"
    mc "Eu vou! Eu prometo!"

# game/script9.rpy:9352
translate brazil mcisback_c084b97e:

#   mc "I'll be right back!"
    mc "Já volto!"

# game/script9.rpy:9355
translate brazil mcisback_30269786:

#   bla "You quickly make your way towards Loco's Cafe." with dis2
    bla "Você rapidamente segue em direção ao Loco's Cafe." with dis2

# game/script9.rpy:9356
translate brazil mcisback_5f32b865:

#   mct "God..."
    mct "Deus..."

# game/script9.rpy:9357
translate brazil mcisback_76063732:

#   mct "I knew I missed them..."
    mct "Eu sabia que sentia falta deles..."

# game/script9.rpy:9358
translate brazil mcisback_489dbfe0:

#   mct "But seeing their faces again, hearing their voices, feeling their hugs... it made me realize just {i}how{/i} much I missed them."
    mct "Mas ver seus rostos novamente, ouvir suas vozes, sentir seus abraços... isso me fez perceber que {i}como{/i} senti muita falta deles."

# game/script9.rpy:9359
translate brazil mcisback_e49ad78e:

#   mct "I need to find Luna and head back to tell them everything."
    mct "Preciso encontrar Luna e voltar para contar tudo a eles."

# game/script9.rpy:9361
translate brazil mcisback_7d11e9dd:

#   mct "Mr. Hernandez's restaurant is that way..." with dis17
    mct "O restaurante do Sr. Hernandez fica ali..." with dis17

# game/script9.rpy:9362
translate brazil mcisback_a9cf1897:

#   mct "If she’s already heading home, she should be coming down this street."
    mct "Se ela já está indo para casa, deveria vir por esta rua."

# game/script9.rpy:9363
translate brazil mcisback_382c084e:

#   mct "Unless she–"
    mct "A menos que ela–"

# game/script9.rpy:9366
translate brazil mcisback_1d9ffcd9:

#   bla "The bus in front of you finally drives off, leaving the lane open." with dis25
    bla "O ônibus à sua frente finalmente parte, deixando a pista aberta." with dis25

# game/script9.rpy:9367
translate brazil mcisback_36340650:

#   mc "Huh...?"
    mc "Huh...?"

# game/script9.rpy:9369
translate brazil mcisback_41dda3af:

#   mct "I think I know that girl!" with dis15
    mct "Acho que conheço aquela garota!" with dis15

