#   l "I'm really looking forward to it."
    l "Estou realmente ansioso por isso."

# game/script9.rpy:9677
translate brazil cafe09poshy_6ec71793:

#   l "See you on Wednesday, [mc]!" with dis12
    l "Vejo você na quarta-feira, [mc]!" with dis12

