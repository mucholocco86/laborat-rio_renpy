#   mc "There's nothing to forgive, Princess."
    mc "Não há nada a perdoar, Princesa."

# game/script9.rpy:4989
translate brazil calyhug2_e9ac7450:

#   mc "I'm glad if it helped you in some way."
    mc "Fico feliz se isso ajudou você de alguma forma."

# game/script9.rpy:4991
translate brazil calyhug2_8ae45a45:

#   ca "It... certainly helped clear my mind for a moment. I must thank you."
    ca "Isso... certamente ajudou a clarear minha mente por um momento. Devo agradecer a você."

# game/script9.rpy:4992
translate brazil calyhug2_d3adc4bb:

#   ca "But... anyway, I have taken enough of your time."
    ca "Mas... de qualquer forma, já tomei bastante do seu tempo."

# game/script9.rpy:4993
translate brazil calyhug2_3d7e84ee:

#   ca "I imagine you must be eager to return to your world."
    ca "Imagino que você deva estar ansioso para retornar ao seu mundo."

# game/script9.rpy:4995
translate brazil calyhug2_b4358d48:

#   mc "I am!"
    mc "Eu sou!"

# game/script9.rpy:4999
translate brazil portalleave_e1d57f0c:

#   ca "*Deep exhale* . . ." with dis17
    ca "*Expire profundamente*. . ." with dis17

# game/script9.rpy:5000
translate brazil portalleave_fdf010bc:

#   ca "{i}Glem ni sa' eradin..."
    ca "{i}Esqueça ni sa' eradin..."

# game/script9.rpy:5005
translate brazil portalleave_e3298fc2:

#   mc "HELL YEAH!" with dis
    mc "INFERNO, SIM!" with dis

# game/script9.rpy:5006
translate brazil portalleave_e3398304:

#   mc "You really did it!"
    mc "Você realmente conseguiu!"

# game/script9.rpy:5008
translate brazil portalleave_85abbc8c:

#   ca "Naturally. Did you doubt me?" with dis12
    ca "Naturalmente. Você duvidou de mim?" with dis12

# game/script9.rpy:5010
translate brazil portalleave_3cdcee64:

#   mc "Not for a second!"
    mc "Nem por um segundo!"

# game/script9.rpy:5011
translate brazil portalleave_c2bd5642:

#   ca "Hmph."
    ca "Hmph."

# game/script9.rpy:5012
translate brazil portalleave_c69631be:

#   mc "Where's this portal going to take me?"
    mc "Para onde esse portal vai me levar?"

# game/script9.rpy:5014
translate brazil portalleave_5b5beda7:

#   ca "To Ekabar. After spending so much time there, it proved to be the easiest destination."
    ca "Para Ekabar. Depois de passar tanto tempo lá, provou ser o destino mais fácil."

# game/script9.rpy:5015
translate brazil portalleave_bb365830:

#   ca "I am still not at full strength, I must admit."
    ca "Ainda não estou com força total, devo admitir."

# game/script9.rpy:5017
translate brazil portalleave_4fc5af57:

#   mc "That works just fine!"
    mc "Isso funciona muito bem!"

# game/script9.rpy:5018
translate brazil portalleave_2d2cca1e:

#   mc "I should be able to teleport back to Kredon from there."
    mc "De lá, eu deveria ser capaz de me teletransportar de volta para Kredon."

# game/script9.rpy:5019
translate brazil portalleave_edd2875b:

#   mc "Or... at least I hope so. Worst case, I can get in touch with the girls and we’ll figure something out."
    mc "Ou... pelo menos espero que sim. Na pior das hipóteses, posso entrar em contato com as meninas e pensaremos em alguma coisa."

# game/script9.rpy:5021
translate brazil portalleave_0e022f43:

#   ca "Good. Please, give them all my warm regards."
    ca "Bom. Por favor, dê-lhes todos os meus cumprimentos calorosos."

# game/script9.rpy:5023
translate brazil portalleave_85acabed:

#   mc "There’s just one thing I’m wondering, though..."
    mc "Só há uma coisa que estou me perguntando..."

# game/script9.rpy:5024
translate brazil portalleave_8ef2b8fb:

#   mc "What if I can’t come back to Hyril’ar on my own? I can't use my “plane-shifting” power from here, so maybe it's the same from the other way."
    mc "E se eu não puder voltar para Hyril'ar sozinho? Não posso usar meu poder de “mudança de plano” daqui, então talvez seja a mesma coisa do outro lado."

# game/script9.rpy:5026
translate brazil portalleave_b95a33ac:

#   ca "There is much I must resolve here — disputes within the realm, tensions between the houses..."
    ca "Há muita coisa que preciso resolver aqui — disputas dentro do reino, tensões entre as casas..."

# game/script9.rpy:5027
translate brazil portalleave_2843eb31:

#   ca "But once everything is solved..."
    ca "Mas assim que tudo estiver resolvido..."

# game/script9.rpy:5028
translate brazil portalleave_023fbcf6:

#   ca "I will come to you myself."
    ca "Eu mesmo irei até você."

# game/script9.rpy:5029
translate brazil portalleave_209d6259:

#   ca "I promise."
    ca "Eu prometo."

# game/script9.rpy:5031
translate brazil portalleave_51870af1:

#   ca "At the very least... for a visit."
    ca "No mínimo... para uma visita."

# game/script9.rpy:5033
translate brazil portalleave_dd18bf00:

#   mc "I will be looking forward to it."
    mc "Estarei ansioso por isso."

# game/script9.rpy:5034
translate brazil portalleave_4d1f4223:

#   mc "Please, take care, Calypso."
    mc "Por favor, tome cuidado, Calipso."

# game/script9.rpy:5035
translate brazil portalleave_54141a16:

#   mc "And thank you for... everything."
    mc "E obrigado por... tudo."

# game/script9.rpy:5037
translate brazil portalleave_04c990f9:

#   ca "Thank you for showing me that not all humans are insufferable, [mc]."
    ca "Obrigado por me mostrar que nem todos os humanos são insuportáveis, [mc]."

# game/script9.rpy:5038
translate brazil portalleave_ab87ce74:

#   ca "Turns out one or two of you might actually be... tolerable."
    ca "Acontece que um ou dois de vocês podem realmente ser... toleráveis."

# game/script9.rpy:5040
translate brazil portalleave_1485f324:

#   ca "Maybe even... more than that."
    ca "Talvez até... mais do que isso."

# game/script9.rpy:5042
translate brazil portalleave_a15e00f7:

#   mc "Well, most of us are still terrible."
    mc "Bem, a maioria de nós ainda é terrível."

# game/script9.rpy:5043
translate brazil portalleave_a7a7ce9c:

#   mc "I'm just an exception."
    mc "Sou apenas uma exceção."

# game/script9.rpy:5045
translate brazil portalleave_98cd0f94:

#   ca "*Chuckles* A rare one, indeed."
    ca "*Risos* Um caso raro, de fato."

# game/script9.rpy:5047
translate brazil portalleave_ec2b6fa0:

#   mc "*Chuckles* Indeed."
    mc "*Risos* De fato."

# game/script9.rpy:5048
translate brazil portalleave_3f547ff8:

#   mc "Until next time, Princess."
    mc "Até a próxima, princesa."

# game/script9.rpy:5050
translate brazil portalleave_d7f47192:

#   ca "Until next time."
    ca "Até a próxima."

# game/script9.rpy:5053
translate brazil portalleave_2c3be191:

#   bla "You slowly walk towards the portal." with dis22
    bla "Você caminha lentamente em direção ao portal." with dis22

# game/script9.rpy:5054
translate brazil portalleave_7c36830f:

#   mc "Aahh..."
    mc "Ahh..."

# game/script9.rpy:5055
translate brazil portalleave_1d034bbe:

#   mct "Beaten by an elven general, nearly executed, thrown in prison for days... and honestly, it doesn’t even feel that bad."
    mct "Espancado por um general élfico, quase executado, jogado na prisão por dias... e honestamente, nem parece tão ruim assim."

# game/script9.rpy:5056
translate brazil portalleave_9870e04e:

#   mct "Either I’m still in shock from finding out Hyril’ar is real... or maybe I’ve got a thing for pain without realizing it."
    mct "Ou ainda estou em choque ao descobrir que Hyril'ar é real... ou talvez eu tenha uma queda pela dor sem perceber."

# game/script9.rpy:5057
translate brazil portalleave_2614230d:

#   mct "Just another episode in the crazy story of our lives, I guess..."
    mct "Apenas mais um episódio da louca história de nossas vidas, eu acho..."

# game/script9.rpy:5058
translate brazil portalleave_526187a8:

#   mod "Stay for Calypso's path and more content."
    mod "Fique para conhecer o caminho do Calypso e mais conteúdo."

# game/script9.rpy:5068
translate brazil hyrilarenter_2f043dea:

#   mct "Time to move on to the next chapter." with dis
    mct "É hora de passar para o próximo capítulo." with dis

# game/script9.rpy:5076
translate brazil hyrilarnoenter_5ca76535:

#   mct "And yet..." with dis
    mct "E ainda assim..." with dis

# game/script9.rpy:5077
translate brazil hyrilarnoenter_2a33dfd4:

#   mct "Why do I feel like this chapter isn't finished yet...?"
    mct "Por que sinto que este capítulo ainda não terminou...?"

# game/script9.rpy:5078
translate brazil hyrilarnoenter_77a89e99:

#   mc ". . ."
    mc ". . ."

# game/script9.rpy:5081
translate brazil hyrilarnoenter_63b1c52c:

#   bla "You take a few steps back." with dis17
    bla "Você dá alguns passos para trás." with dis17

# game/script9.rpy:5083
translate brazil hyrilarnoenter_25ea2c7c:

#   ca "I do not want to rush you, but..."
    ca "Não quero te apressar, mas..."

# game/script9.rpy:5084
translate brazil hyrilarnoenter_e8ae6e03:

#   ca "As I mentioned, I am still not at full strength."
    ca "Como mencionei, ainda não estou com força total."

# game/script9.rpy:5085
translate brazil hyrilarnoenter_a92f0411:

#   ca "Keeping the portal open is... more taxing than it once was."
    ca "Manter o portal aberto é... mais desgastante do que antes."

# game/script9.rpy:5087
translate brazil hyrilarnoenter_d4a0e8dc:

#   mc "You can close it."
    mc "Você pode fechá-lo."

# game/script9.rpy:5088
translate brazil hyrilarnoenter_628844cf:

#   mc "I'm not leaving just yet."
    mc "Eu não vou embora ainda."

# game/script9.rpy:5094
translate brazil hyrilarnoenter_839b95b4:

#   ca "What...?" with dis
    ca "O que...?" with dis

# game/script9.rpy:5096
translate brazil hyrilarnoenter_766b6e4c:

#   mc "I'll go with you to that whole... “husband choosing” thing."
    mc "Irei com você naquela coisa toda de \"escolha do marido\"."

# game/script9.rpy:5097
translate brazil hyrilarnoenter_f4e738a5:

#   mc "It sounds like a recipe for disaster, and I’m not gonna let you walk into it alone."
    mc "Parece uma receita para o desastre, e não vou deixar você entrar nisso sozinho."

# game/script9.rpy:5098
translate brazil hyrilarnoenter_d2a5aa7d:

#   mc "You need your bodyguard. Physical backup, moral support, and personal advice — the whole package."
    mc "Você precisa do seu guarda-costas. Apoio físico, apoio moral e aconselhamento pessoal – o pacote completo."

# game/script9.rpy:5100
translate brazil hyrilarnoenter_79ecba73:

#   ca "But... why?"
    ca "Mas por que?"

# game/script9.rpy:5101
translate brazil hyrilarnoenter_24da40fa:

#   ca "You are not obligated to accompany me. I have not asked you to stay."
    ca "Você não é obrigado a me acompanhar. Eu não pedi para você ficar."

# game/script9.rpy:5103
translate brazil hyrilarnoenter_f3a67681:

#   mc "So...?"
    mc "Então...?"

# game/script9.rpy:5104
translate brazil hyrilarnoenter_6d63b7c6:

#   mc "You don’t stick around for someone just because they {i}ask{/i} you to."
    mc "Você não fica por perto de alguém só porque essa pessoa {i}pede{/i}."

# game/script9.rpy:5105
translate brazil hyrilarnoenter_b06c3c70:

#   mc "You do it because you care. That’s what people do when someone matters to them."
    mc "Você faz isso porque se importa. Isso é o que as pessoas fazem quando alguém é importante para elas."

# game/script9.rpy:5106
translate brazil hyrilarnoenter_a9c11f61:

#   mc "And besides... the girls would tear me apart if they found out I left you behind to deal with all this crap on your own."
    mc "E além disso... as meninas iriam me despedaçar se descobrissem que te deixei para trás para lidar com toda essa merda sozinha."

# game/script9.rpy:5107
translate brazil hyrilarnoenter_cc91153e:

#   mc "You’re one of us now. Whether you like it or not."
    mc "Você é um de nós agora. Quer você goste ou não."

# game/script9.rpy:5109
translate brazil hyrilarnoenter_dae618e8:

#   ca "A-Are you... certain of this?"
    ca "A-Você tem... certeza disso?"

# game/script9.rpy:5111
translate brazil hyrilarnoenter_de2592d5:

#   mc "Of course! I've been here for like a week, what's a few more hours?"
    mc "Claro! Estou aqui há uma semana, o que são mais algumas horas?"

# game/script9.rpy:5112
translate brazil hyrilarnoenter_43a2db55:

#   mc "Let's go before we're late!"
    mc "Vamos antes que atrase!"

# game/script9.rpy:5113
translate brazil hyrilarnoenter_d950011c:

#   ca ". . ."
    ca ". . ."

# game/script9.rpy:5114
translate brazil hyrilarnoenter_53ad9663:

#   mc "Come on, Princess! What are we waiting for?!"
    mc "Vamos, princesa! O que estamos esperando?!"

# game/script9.rpy:5116
translate brazil hyrilarnoenter_0663b1fe:

#   ca "Uh... w-well..."
    ca "Uh... bem..."

# game/script9.rpy:5118
translate brazil hyrilarnoenter_e2523d8a:

#   ca "A-Alright, I accept, but... perhaps you ought to consider putting on some clothes before we leave this room, would you not agree?" with dis15
    ca "R-Tudo bem, eu aceito, mas... talvez você devesse pensar em vestir algumas roupas antes de sairmos deste quarto, não concorda?" with dis15

# game/script9.rpy:5120
translate brazil hyrilarnoenter_ad0498f4:

#   mc "Oh... fair point."
    mc "Ah... ponto justo."

# game/script9.rpy:5121
translate brazil hyrilarnoenter_57735150:

#   mc "We wouldn’t want the noble people of your kingdom to see their beloved Princess walking around with some half-naked human guy."
    mc "Não gostaríamos que o povo nobre do seu reino visse sua amada princesa andando por aí com um humano seminu."

# game/script9.rpy:5124
translate brazil hyrilarnoenter_585c4c71:

#   ca "*Chuckles* Most certainly not." with dis15
    ca "*Risos* Certamente não." with dis15

# game/script9.rpy:5125
translate brazil hyrilarnoenter_a3c7165d:

#   ca "What would they say?"
    ca "O que eles diriam?"

# game/script9.rpy:5129
translate brazil hyrilarnoenter_cfcbb8d3:

#   mc "*Putting your shirt on* Surely nothing good. Scandal of the century."
    mc "*Colocando sua camisa* Certamente nada de bom. Escândalo do século."

# game/script9.rpy:5131
translate brazil hyrilarnoenter_6b60ade4:

#   ca "*Chuckles* Surely..."
    ca "*Risos* Certamente..."

# game/script9.rpy:5133
translate brazil hyrilarnoenter_97e227ba:

#   ca "*Taking a deep breath* . . ."
    ca "*Respirando fundo*. . ."

# game/script9.rpy:5135
translate brazil hyrilarnoenter_fb2097f0:

#   ca "Thank you for accompanying me to this dreadful affair, [mc]. It makes me feel more at ease."
    ca "Obrigado por me acompanhar neste caso terrível, [mc]. Isso me faz sentir mais à vontade."

# game/script9.rpy:5137
translate brazil hyrilarnoenter_bbb5886f:

#   mc "It's the very least I could do, Princess."
    mc "É o mínimo que posso fazer, Princesa."

# game/script9.rpy:5139
translate brazil hyrilarnoenter_1d4b92b7:

#   ca "You are wearing it upside down."
    ca "Você está usando de cabeça para baixo."

# game/script9.rpy:5141
translate brazil hyrilarnoenter_11455b53:

#   mc "What?"
    mc "O que?"

# game/script9.rpy:5142
translate brazil hyrilarnoenter_116c74b3:

#   mc "*Glancing down at your shirt* Oh, for fuck's sake–"
    mc "*Olhando para sua camisa* Oh, pelo amor de Deus–"

# game/script9.rpy:5145
translate brazil hyrilarnoenter_0709c2b4:

#   mc "Why are elven robes for guys so confusing?!"
    mc "Por que as vestes élficas para os rapazes são tão confusas?!"

# game/script9.rpy:5147
translate brazil hyrilarnoenter_0043777a:

#   ca "{i}Fuck{/i}... I noticed you seem to use that word quite often." with dis15
    ca "{i}Foda-se{/i}... Percebi que você usa essa palavra com bastante frequência." with dis15

# game/script9.rpy:5149
translate brazil hyrilarnoenter_38337a1e:

#   mc "*Chuckles* Oh, yeah... the mighty {i}fuck{/i}!"
    mc "*Ri* Ah, sim... o poderoso {i}porra{/i}!"

# game/script9.rpy:5150
translate brazil hyrilarnoenter_11a9b729:

#   mc "Humanity’s most versatile contribution to language!"
    mc "A contribuição mais versátil da humanidade para a linguagem!"

# game/script9.rpy:5152
translate brazil hyrilarnoenter_9a835f61:

#   ca "What is its exact meaning?"
    ca "Qual é o seu significado exato?"

# game/script9.rpy:5154
translate brazil hyrilarnoenter_8d3bba89:

#   mc "Well, you can use it in literally any situation. Angry? {i}Fuck{/i}! Shocked? What the {i}fuck{/i}?! Excited? Let's {i}fucking{/i} go!"
    mc "Bem, você pode usá-lo literalmente em qualquer situação. Nervoso? {i}Foda-se{/i}! Chocado? Que {i}foda-se{/i}?! Excitado? Vamos {i}porra{/i}!"

# game/script9.rpy:5155
translate brazil hyrilarnoenter_0bb5ced5:

#   mc "It’s all about tone and context."
    mc "É tudo uma questão de tom e contexto."

# game/script9.rpy:5156
translate brazil hyrilarnoenter_76c34592:

#   mc "Like, if you say you wanna {i}fuck{/i} with someone, it means you want to mess with them. Tease them. Cause a little trouble."
    mc "Tipo, se você diz que quer {i}foder{/i} com alguém, significa que você quer mexer com essa pessoa. Provoque-os. Causar alguns problemas."

# game/script9.rpy:5159
translate brazil hyrilarnoenter_c42f9c3c:

#   mc "But if you drop the {i}with{/i}, and just say you wanna {i}fuck{/i} someone..." with dis15
    mc "Mas se você largar o {i}com{/i} e apenas dizer que quer {i}foder{/i} alguém..." with dis15

# game/script9.rpy:5160
translate brazil hyrilarnoenter_f77405f2:

#   mc "Well... that means you want to have some fun with them."
    mc "Bem... isso significa que você quer se divertir com eles."

# game/script9.rpy:5161
translate brazil hyrilarnoenter_217322a5:

#   mc "{i}That{/i} kind of fun."
    mc "{i}Isso{/i} é divertido."

# game/script9.rpy:5163
translate brazil hyrilarnoenter_c2bd5642:

#   ca "Hmph."
    ca "Hmph."

# game/script9.rpy:5165
translate brazil hyrilarnoenter_0d7faedf:

#   ca "Interesting. How... nuanced."
    ca "Interessante. Como... matizado."

# game/script9.rpy:5166
translate brazil hyrilarnoenter_8b6159d3:

#   ca "You humans do seem especially gifted at concealing layers of meaning beneath even your crudest expressions... despite your general lack of refinement in poetry and prose."
    ca "Vocês, humanos, parecem especialmente talentosos em esconder camadas de significado até mesmo sob suas expressões mais grosseiras... apesar de sua falta geral de refinamento em poesia e prosa."

# game/script9.rpy:5167
translate brazil hyrilarnoenter_4dc519a2:

#   ca "It is... rather fascinating."
    ca "É... bastante fascinante."

# game/script9.rpy:5169
translate brazil hyrilarnoenter_820b42e8:

#   ca "Do you think you could teach me more of your... human expressions on the way to the hall?" with dis12
    ca "Você acha que poderia me ensinar mais sobre suas... expressões humanas no caminho para o salão?" with dis12

# game/script9.rpy:5171
translate brazil hyrilarnoenter_11da90ff:

#   mc "It’d be my absolute pleasure, Princess."
    mc "Seria um prazer absoluto, Princesa."

# game/script9.rpy:5172
translate brazil hyrilarnoenter_56abb613:

#   mc "You’ve got yourself the most foul-mouthed human in the entire court."
    mc "Você tem o humano mais desbocado de toda a corte."

# game/script9.rpy:5174
translate brazil hyrilarnoenter_7aecbe4d:

#   ca "Excellent then."
    ca "Excelente então."

# game/script9.rpy:5175
translate brazil hyrilarnoenter_9d012453:

#   ca "Now, please, remain at my side as we walk."
    ca "Agora, por favor, fique ao meu lado enquanto caminhamos."

# game/script9.rpy:5176
translate brazil hyrilarnoenter_1455d5d3:

#   ca "I will grant you one of the royal armors. From this moment on, you shall serve as my... protector."
    ca "Eu lhe darei uma das armaduras reais. A partir deste momento, você servirá como meu... protetor."

# game/script9.rpy:5178
translate brazil hyrilarnoenter_3d216b95:

#   mc "Nothing would make me happier, Your Grace..."
    mc "Nada me faria mais feliz, Vossa Graça..."

# game/script9.rpy:5190
translate brazil hyrilarnoenter_38e81851:

#   ca "*Leaning back* So then..." with dis12
    ca "*Inclinando-se para trás* Então..." with dis12

# game/script9.rpy:5191
translate brazil hyrilarnoenter_a8500eed:

#   ca "These Gems of yours, are they the only things you are unable to carry between “Eternum” and Earth?"
    ca "Essas suas joias são as únicas coisas que você não consegue carregar entre “Eternum” e a Terra?"

# game/script9.rpy:5192
translate brazil hyrilarnoenter_08c1feff:

#   mc "I can bring most stuff from the real world into Eternum as long as I'm holding it, or... if I’ve got it in my pocket or whatever."
    mc "Posso trazer a maioria das coisas do mundo real para Eternum, desde que o esteja segurando, ou... se o tiver no bolso ou algo assim."

# game/script9.rpy:5194
translate brazil hyrilarnoenter_1d9d88e4:

#   mc "But... it doesn’t work the other way around. Stuff from here, like the Gems, Nova's gun, or any magic items, just... don’t come with me." with dis12
    mc "Mas... não funciona ao contrário. Coisas daqui, como as joias, a arma de Nova ou quaisquer itens mágicos, só... não venham comigo." with dis12

# game/script9.rpy:5195
translate brazil hyrilarnoenter_eef6a5e9:

#   mc "They stay exactly where I left 'em."
    mc "Eles ficam exatamente onde os deixei."

# game/script9.rpy:5197
translate brazil hyrilarnoenter_54492640:

#   ca "Also the Gems?" with dis
    ca "Também as joias?" with dis

# game/script9.rpy:5199
translate brazil hyrilarnoenter_1556b6b8:

#   mc "Well... the Gems are different, actually. They somehow just reappear with me, whatever server I end up in." with dis
    mc "Bem... as Gems são diferentes, na verdade. De alguma forma, eles simplesmente reaparecem comigo, seja qual for o servidor em que eu estiver." with dis

# game/script9.rpy:5200
translate brazil hyrilarnoenter_bf304ed8:

#   mc "I don’t control it, I’ve got no idea how it works... but it happens every time."
    mc "Eu não controlo, não tenho ideia de como funciona... mas acontece sempre."

# game/script9.rpy:5202
translate brazil hyrilarnoenter_fb49a110:

#   ca "And what about living beings? Can you bring people with you?"
    ca "E os seres vivos? Você pode trazer pessoas com você?"

# game/script9.rpy:5204
translate brazil hyrilarnoenter_997ff028:

#   mc "Yeah, as long as I’m touching them when I jump into Eternum."
    mc "Sim, desde que eu os toque quando pulo para Eternum."

# game/script9.rpy:5205
translate brazil hyrilarnoenter_9c389787:

#   mc "But as I learned the hard way, it's insanely risky."
    mc "Mas como aprendi da maneira mais difícil, é extremamente arriscado."

# game/script9.rpy:5206
translate brazil hyrilarnoenter_69918b43:

#   mc "Eternum makes Earth look like a playground."
    mc "Eternum faz a Terra parecer um playground."

# game/script9.rpy:5208
translate brazil hyrilarnoenter_13ac0dc8:

#   ca "Who did you bring?"
    ca "Quem você trouxe?"

# game/script9.rpy:5210
translate brazil hyrilarnoenter_ebbc5850:

#   mc "Nova and then Dalia, but that was a one-time thing."
    mc "Nova e depois Dalia, mas isso foi uma coisa única."

# game/script9.rpy:5211
translate brazil hyrilarnoenter_d6b869e8:

#   mc "I’m not planning on doing it ever again — way too dangerous."
    mc "Não pretendo fazer isso nunca mais – é muito perigoso."

# game/script9.rpy:5214
translate brazil hyrilarnoenter_1aeb7e9a:

#   mc "...Well, okay, technically Alex too. B-But that was an accident."
    mc "...Bem, ok, tecnicamente Alex também. M-Mas isso foi um acidente."

# game/script9.rpy:5215
translate brazil hyrilarnoenter_0aa1cc6f:

#   mc "Kinda."
    mc "Tipo."

# game/script9.rpy:5217
translate brazil hyrilarnoenter_237ba890:

#   ca "What about the reverse, then? Could you... take someone from Eternum back with you? To your world?"
    ca "E o inverso, então? Você poderia... levar alguém de Eternum de volta com você? Para o seu mundo?"

# game/script9.rpy:5219
translate brazil hyrilarnoenter_45d1e1ee:

#   mc "I tried it once with an NPC. Didn’t work."
    mc "Eu tentei uma vez com um NPC. Não funcionou."

# game/script9.rpy:5220
translate brazil hyrilarnoenter_66fc92d0:

#   mc "Just like the artifacts and everything else that’s native to Eternum... they can’t cross over. They stay behind."
    mc "Assim como os artefatos e tudo mais que é nativo de Eternum... eles não podem atravessar. Eles ficam para trás."

# game/script9.rpy:5222
translate brazil hyrilarnoenter_c999fce5:

#   ca "I see." with dis
    ca "Eu vejo." with dis

# game/script9.rpy:5224
translate brazil hyrilarnoenter_fccb9547:

#   mc "Why do you ask?"
    mc "Por que você pergunta?"

# game/script9.rpy:5225
translate brazil hyrilarnoenter_2a8056e5:

#   mc "Were you... thinking about visiting Earth?"
    mc "Você estava... pensando em visitar a Terra?"

# game/script9.rpy:5227
translate brazil hyrilarnoenter_d8760b97:

#   ca "Uh..."
    ca "Uh..."

# game/script9.rpy:5228
translate brazil hyrilarnoenter_37c2aca2:

#   ca "Well, I must admit I have listened to you speak of it so often that I found myself wondering what it might be like."
    ca "Bem, devo admitir que ouvi você falar sobre isso com tanta frequência que me perguntei como seria."

# game/script9.rpy:5229
translate brazil hyrilarnoenter_9c9d8a2a:

#   ca "But... it was just a fleeting thought. I have no time for such distractions."
    ca "Mas... foi apenas um pensamento passageiro. Não tenho tempo para tais distrações."

# game/script9.rpy:5230
translate brazil hyrilarnoenter_140ded31:

#   ca "And I doubt I could remain there for long, even if I could visit."
    ca "E duvido que conseguiria permanecer lá por muito tempo, mesmo que pudesse visitá-lo."

# game/script9.rpy:5231
translate brazil hyrilarnoenter_1f3b1e8d:

#   ca "This is my place. The life I was born into."
    ca "Este é o meu lugar. A vida em que nasci."

# game/script9.rpy:5232
translate brazil hyrilarnoenter_a15db8f2:

#   ca "The... life I must live."
    ca "A... vida que devo viver."

# game/script9.rpy:5234
translate brazil hyrilarnoenter_5daad2ba:

#   mct "Mmmh..."
    mct "Hmmm..."

# game/script9.rpy:5235
translate brazil hyrilarnoenter_601a1d41:

#   mct "Now that I know Calypso doesn’t actually enjoy ruling, it makes me want to bring her to Earth even more."
    mct "Agora que sei que Calypso não gosta de governar, tenho ainda mais vontade de trazê-la para a Terra."

# game/script9.rpy:5236
translate brazil hyrilarnoenter_03d2c430:

#   mct "There's gotta be a way, right?"
    mct "Tem que haver um jeito, certo?"

# game/script9.rpy:5237
translate brazil hyrilarnoenter_1c590bfc:

#   mct "But how...?"
    mct "Mas como...?"

# game/script9.rpy:5241
translate brazil hyrilarnoenter_2d1652ce:

#   ara "*Bowing down* Your Highness." with dis12
    ara "*Curvando-se* Vossa Alteza." with dis12

# game/script9.rpy:5243
translate brazil hyrilarnoenter_a1725a8a:

#   ara "Preparations are complete." with dis
    ara "Os preparativos estão completos." with dis

# game/script9.rpy:5244
translate brazil hyrilarnoenter_616f21b9:

#   ara "The suitors are assembled and await your summon."
    ara "Os pretendentes estão reunidos e aguardam sua convocação."

# game/script9.rpy:5246
translate brazil hyrilarnoenter_46230254:

#   ca "Good. Thank you, General."
    ca "Bom. Obrigado, General."

# game/script9.rpy:5247
translate brazil hyrilarnoenter_6634c691:

#   ca "You may allow them entry, but have their delegations remain by the gates."
    ca "Você pode permitir a entrada deles, mas fazer com que suas delegações permaneçam nos portões."

# game/script9.rpy:5249
translate brazil hyrilarnoenter_557fff3e:

#   ara "As you wish, Your Grace."
    ara "Como desejar, Vossa Graça."

# game/script9.rpy:5251
translate brazil hyrilarnoenter_bf731d53:

#   ca "And... I am aware our forces are stretched thin, but assign the majority of the guard to greet the suitors’ delegations."
    ca "E... estou ciente de que nossas forças estão sobrecarregadas, mas designe a maioria da guarda para cumprimentar as delegações dos pretendentes."

# game/script9.rpy:5252
translate brazil hyrilarnoenter_c97f26ff:

#   ca "We must project strength."
    ca "Devemos projetar força."

# game/script9.rpy:5254
translate brazil hyrilarnoenter_75d59592:

#   ara "A prudent decision, my Lady."
    ara "Uma decisão prudente, minha senhora."

# game/script9.rpy:5255
translate brazil hyrilarnoenter_87ac5f4e:

#   ara "It shall be carried out as instructed."
    ara "Deve ser realizado conforme as instruções."

# game/script9.rpy:5258
translate brazil hyrilarnoenter_204cc18f:

#   mc "*Watching Arannis leave the hall* So..." with dis15
    mc "*Assistindo Arannis sair do salão* Então..." with dis15

# game/script9.rpy:5259
translate brazil hyrilarnoenter_8d3592c7:

#   mc "Have you had many suitors knocking on the door before today?"
    mc "Você já teve muitos pretendentes batendo na porta antes de hoje?"

# game/script9.rpy:5261
translate brazil hyrilarnoenter_4f5d108b:

#   ca "Well... Lord Thorund has persistently sought to find me a spouse ever since my parents passed."
    ca "Bem... Lorde Thorund tem procurado persistentemente encontrar uma esposa para mim desde que meus pais faleceram."

# game/script9.rpy:5262
translate brazil hyrilarnoenter_0e8a54ef:

#   ca "But there was little urgency back then. Our realm stood far above any threat, so I could afford to dismiss them all."
    ca "Mas havia pouca urgência naquela época. Nosso reino estava muito acima de qualquer ameaça, então eu poderia me dar ao luxo de dispensar todos eles."

# game/script9.rpy:5263
translate brazil hyrilarnoenter_94aa5bab:

#   ca "None were... worthy."
    ca "Nenhum era... digno."

# game/script9.rpy:5265
translate brazil hyrilarnoenter_70725fd6:

#   mc "Whoa, not even an elven prince made the cut? He needs more?"
    mc "Uau, nem mesmo um príncipe élfico passou na lista? Ele precisa de mais?"

# game/script9.rpy:5267
translate brazil hyrilarnoenter_bedd2f8f:

#   ca "Naturally."
    ca "Naturalmente."

# game/script9.rpy:5268
translate brazil hyrilarnoenter_da207e8a:

#   ca "The King of Hyril’ar must hail from a house of equal or near-equal standing to my own."
    ca "O Rei de Hyril'ar deve vir de uma casa de posição igual ou quase igual à minha."

# game/script9.rpy:5269
translate brazil hyrilarnoenter_2f6d3ad2:

#   ca "He must possess strength in battle, be noble in bearing, and {i}equally{/i} excel in the three sacred arts."
    ca "Ele deve possuir força na batalha, ser nobre no porte e {i}igualmente{/i} se destacar nas três artes sagradas."

# game/script9.rpy:5271
translate brazil hyrilarnoenter_06a469a0:

#   mc "Damn, that's quite the resume."
    mc "Droga, esse é o currículo."

# game/script9.rpy:5272
translate brazil hyrilarnoenter_ff5d1d3c:

#   mc "Would I even stand a chance...?"
    mc "Será que eu teria alguma chance...?"

# game/script9.rpy:5273
translate brazil hyrilarnoenter_1c991d08:

#   mc "I can certainly fight. And I don't know about those three arts, but I'm a nice guy. Funny sometimes, too."
    mc "Eu certamente posso lutar. E não sei sobre essas três artes, mas sou um cara legal. Engraçado às vezes também."

# game/script9.rpy:5275
translate brazil hyrilarnoenter_ab5632f0:

#   ca "Please, [mc]. The mere idea of a human romancing the Princess of Hyril’ar, let alone being granted power or status, would plunge the realm into outright war."
    ca "Por favor, [mc]. A mera ideia de um humano namorando a Princesa de Hyril'ar, e muito menos de receber poder ou status, mergulharia o reino em uma guerra total."

# game/script9.rpy:5277
translate brazil hyrilarnoenter_1fd13c4f:

#   mc "Okay, but... imagine I had pointy ears and a fancy family crest for a second."
    mc "Ok, mas... imagine que eu tivesse orelhas pontudas e um brasão de família chique por um segundo."

# game/script9.rpy:5278
translate brazil hyrilarnoenter_295bce5a:

#   mc "Would I make the shortlist then?"
    mc "Eu faria a lista então?"

# game/script9.rpy:5281
translate brazil hyrilarnoenter_04ed8ace:

#   ca "Hmph." with dis08
    ca "Hmph." with dis08

# game/script9.rpy:5283
translate brazil hyrilarnoenter_f71bd338:

#   ca "Perhaps... if your tunes were sweet enough."
    ca "Talvez... se suas músicas fossem doces o suficiente."

# game/script9.rpy:5285
translate brazil hyrilarnoenter_8187d466:

#   mc "I'll take that..."
    mc "Eu vou levar isso..."

# game/script9.rpy:5289
translate brazil hyrilarnoenter_810c434e:

#   bla "Calypso’s maids take their seats along one side of the throne platform." with dis15
    bla "As criadas de Calipso sentam-se ao longo de um dos lados da plataforma do trono." with dis15

# game/script9.rpy:5290
translate brazil hyrilarnoenter_6f60bde9:

#   mct "Ah, there's Lorelei."
    mct "Ah, ali está a Lorelei."

# game/script9.rpy:5291
translate brazil hyrilarnoenter_b630ac14:

#   mct "Probably the only person here other than Calypso who doesn’t look at me like the palace needs to be fumigated after I leave."
    mct "Provavelmente a única pessoa aqui além de Calypso que não olha para mim como se o palácio precisasse ser fumigado depois que eu saísse."

# game/script9.rpy:5292
translate brazil hyrilarnoenter_4d060c12:

#   mct "Though, to be fair... I think her father is starting to warm up to me too."
    mct "Porém, para ser justo... acho que o pai dela também está começando a gostar de mim."

# game/script9.rpy:5293
translate brazil hyrilarnoenter_08e64611:

#   mct "I'm sure that by the time we’ve collected all ten Gems, we’ll be best friends."
    mct "Tenho certeza de que quando coletarmos todas as dez joias seremos melhores amigos."

# game/script9.rpy:5294
translate brazil hyrilarnoenter_c45d1322:

#   mct "Legolas and Gimli 2.0."
    mct "Legolas e Gimli 2.0."

# game/script9.rpy:5305
translate brazil hyrilarnoenter_9d9c3ee6:

#   lo "*Whispers* D-Did you see that?!" with dis
    lo "*Sussurra* V-Você viu isso?!" with dis

# game/script9.rpy:5306
translate brazil hyrilarnoenter_3404c5d1:

#   lo "*Whispers* They also wave! Just as we do!"
    lo "*Sussurros* Eles também acenam! Assim como nós!"

# game/script9.rpy:5307
translate brazil hyrilarnoenter_5f030983:

#   lo2 "Hmm?"
    lo2 "Hum?"

# game/script9.rpy:5313
translate brazil hyrilarnoenter_799ef3ea:

#   mct "Ugh, and on the other side... the exact opposite." with dis
    mct "Ugh, e do outro lado... exatamente o oposto." with dis

# game/script9.rpy:5314
translate brazil hyrilarnoenter_fb958db4:

#   mct "These assholes again... They nearly got me killed last time."
    mct "Esses idiotas de novo... Eles quase me mataram da última vez."

# game/script9.rpy:5315
translate brazil hyrilarnoenter_c9274fce:

#   mct "Well, at least that Sylax prick isn't here."
    mct "Bem, pelo menos aquele idiota do Sylax não está aqui."

# game/script9.rpy:5316
translate brazil hyrilarnoenter_fbb7ea06:

#   mct "Hmph."
    mct "Hmph."

# game/script9.rpy:5317
translate brazil hyrilarnoenter_01f7185f:

#   mct "Strange... why isn't he here...?"
    mct "Estranho... por que ele não está aqui...?"

# game/script9.rpy:5321
translate brazil hyrilarnoenter_f0e222f1:

#   cc "It is an honor to stand in your presence, My Lady." with dis14
    cc "É uma honra estar na sua presença, minha senhora." with dis14

# game/script9.rpy:5322
translate brazil hyrilarnoenter_c20d58f7:

#   ca "The pleasure is mine, Chamberlain."
    ca "O prazer é meu, Chamberlain."

# game/script9.rpy:5324
translate brazil hyrilarnoenter_274b1403:

#   cc "All has been prepared according to tradition." with dis
    cc "Tudo foi preparado de acordo com a tradição." with dis

# game/script9.rpy:5325
translate brazil hyrilarnoenter_7460525e:

#   cc "Three suitors have answered the call, each seeking your favor. They will present themselves before the Crown and attempt to prove their worth."
    cc "Três pretendentes atenderam ao chamado, cada um buscando seu favor. Eles se apresentarão perante a Coroa e tentarão provar o seu valor."

# game/script9.rpy:5326
translate brazil hyrilarnoenter_5fac944c:

#   cc "Then the regents, guided by my counsel, will deliberate on which of them stands most fit."
    cc "Então os regentes, guiados pelo meu conselho, deliberarão sobre qual deles será o mais adequado."

# game/script9.rpy:5328
translate brazil hyrilarnoenter_f93f290d:

#   ca "And I am to have no voice in the matter?"
    ca "E não devo ter voz no assunto?"

# game/script9.rpy:5330
translate brazil hyrilarnoenter_0e07f794:

#   cc "Oh, but of course, Your Grace."
    cc "Ah, mas é claro, Vossa Graça."

# game/script9.rpy:5331
translate brazil hyrilarnoenter_5f952417:

#   cc "We serve merely as advisors. The final choice shall rest solely with you... as long as a choice {i}is{/i} made."
    cc "Servimos apenas como conselheiros. A escolha final caberá exclusivamente a você... contanto que uma escolha {i}seja{/i} feita."

# game/script9.rpy:5332
translate brazil hyrilarnoenter_bd4b9157:

#   cc "Your Grace is, no doubt, aware of the dire need for a King and for the alliance his house might bring in these... turbulent times."
    cc "Vossa Graça está, sem dúvida, ciente da extrema necessidade de um rei e da aliança que sua casa pode trazer nestes... tempos turbulentos."

# game/script9.rpy:5334
translate brazil hyrilarnoenter_013a6766:

#   ca "Yes..."
    ca "Sim..."

# game/script9.rpy:5335
translate brazil hyrilarnoenter_1364b170:

#   ca "I am well aware."
    ca "Estou bem ciente."

# game/script9.rpy:5337
translate brazil hyrilarnoenter_eed24be1:

#   cc "Excellent! Then, in accordance with custom, we must appoint a champion to stand in your name."
    cc "Excelente! Então, de acordo com o costume, devemos nomear um campeão para ficar em seu nome."

# game/script9.rpy:5338
translate brazil hyrilarnoenter_ddca7fd5:

#   cc "A proxy to represent your royal standard in the ceremonial trials."
    cc "Um procurador para representar seu estandarte real nos julgamentos cerimoniais."

# game/script9.rpy:5339
translate brazil hyrilarnoenter_f31ffd8f:

#   cc "Shall we presume General Arannis will fulfill the role once again?"
    cc "Devemos presumir que o General Arannis cumprirá o papel mais uma vez?"

# game/script9.rpy:5341
translate brazil hyrilarnoenter_0681b1c3:

#   ca "I have sent General Arannis to entertain the suitors' entourages."
    ca "Enviei o General Arannis para entreter a comitiva dos pretendentes."

# game/script9.rpy:5342
translate brazil hyrilarnoenter_bd421c13:

#   ca "He will not be available today."
    ca "Ele não estará disponível hoje."

# game/script9.rpy:5344
translate brazil hyrilarnoenter_9ec9c1cf:

#   cc "Oh... I see."
    cc "Oh, eu vejo."

# game/script9.rpy:5345
translate brazil hyrilarnoenter_ac25a5ed:

#   cc "Then, may I suggest Lord Lyond’or of the Royal Guard? A trusted blade and a lover of poetry."
    cc "Então, posso sugerir Lorde Lyond'or da Guarda Real? Uma lâmina confiável e amante da poesia."

# game/script9.rpy:5346
translate brazil hyrilarnoenter_d8b24576:

#   cc "Or perhaps Lord Stannis, of the cavalry?"
    cc "Ou talvez Lorde Stannis, da cavalaria?"

# game/script9.rpy:5350
translate brazil hyrilarnoenter_b75dbc7d:

#   ca "Mmmh." with dis08
    ca "Hmmm." with dis08

# game/script9.rpy:5352
translate brazil hyrilarnoenter_6c4b6269:

#   ca "Hmmm..." with dis08
    ca "Hmmm..." with dis08

# game/script9.rpy:5354
translate brazil hyrilarnoenter_fbb7729b:

#   ca "Actually..."
    ca "Na verdade..."

# game/script9.rpy:5355
translate brazil hyrilarnoenter_344f646f:

#   ca "Lord [mc] shall serve as my champion today."
    ca "Senhor [mc] servirá como meu campeão hoje."

# game/script9.rpy:5357
translate brazil hyrilarnoenter_579bd585:

#   cc "Lord..." with dis
    cc "Senhor..." with dis

# game/script9.rpy:5359
translate brazil hyrilarnoenter_6e1c41a7:

#   cc "[mc]...?" with dis08
    cc "[mc]...?" with dis08

# game/script9.rpy:5360
translate brazil hyrilarnoenter_64166c04:

#   cc "You mean... the human...?"
    cc "Você quer dizer... o humano...?"

# game/script9.rpy:5362
translate brazil hyrilarnoenter_e620cefd:

#   tho "By the Ancients, my Lady!" with dis
    tho "Pelos Antigos, minha Senhora!" with dis

# game/script9.rpy:5363
translate brazil hyrilarnoenter_df858f24:

#   tho "Surely you do not intend to place your human servant as our court’s champion?!"
    tho "Certamente você não pretende colocar seu servo humano como campeão da nossa corte?!"

# game/script9.rpy:5364
translate brazil hyrilarnoenter_aecce09c:

#   tho "It would be seen as a mockery!"
    tho "Seria visto como uma zombaria!"

# game/script9.rpy:5367
translate brazil hyrilarnoenter_34c2f019:

#   bla "A wave of murmurs sweeps through the Court, as loud as protocol permits. Shock, disbelief, and disdain flicker across every face." with dis15
    bla "Uma onda de murmúrios varre o Tribunal, tão alto quanto o protocolo permite. Choque, descrença e desdém brilham em todos os rostos." with dis15

# game/script9.rpy:5370
translate brazil hyrilarnoenter_ca86367c:

#   ca "We shall give him a helmet to conceal his identity." with dis12
    ca "Daremos a ele um capacete para esconder sua identidade." with dis12

# game/script9.rpy:5371
translate brazil hyrilarnoenter_95c4069d:

#   ca "No one needs to know who fights in my name."
    ca "Ninguém precisa saber quem luta em meu nome."

# game/script9.rpy:5373
translate brazil hyrilarnoenter_ecce5731:

#   cc "B-But, Your Grace..."
    cc "M-mas, Vossa Graça..."

# game/script9.rpy:5374
translate brazil hyrilarnoenter_460dc010:

#   cc "With all due respect, the purpose of the champion is to {i}outshine{/i} the suitors and grant us greater leverage in the marriage negotiations."
    cc "Com todo o respeito, o propósito do campeão é {i}ofuscar{/i} os pretendentes e nos conceder maior influência nas negociações matrimoniais."

# game/script9.rpy:5375
translate brazil hyrilarnoenter_10ae61a1:

#   cc "If the human performs poorly, or is recognized, it will humiliate the court and place us in an inferior position."
    cc "Se o humano tiver um mau desempenho ou for reconhecido, isso humilhará o tribunal e nos colocará numa posição inferior."

# game/script9.rpy:5377
translate brazil hyrilarnoenter_45b66fdf:

#   ca "I fully understand, Lord Chamberlain."
    ca "Compreendo perfeitamente, Lorde Chamberlain."

# game/script9.rpy:5378
translate brazil hyrilarnoenter_8447be6d:

#   ca "And my decision is final."
    ca "E minha decisão é final."

# game/script9.rpy:5379
translate brazil hyrilarnoenter_a251842f:

#   ca "You are not attempting to overrule me, I trust?"
    ca "Você não está tentando me ignorar, eu acredito?"

# game/script9.rpy:5381
translate brazil hyrilarnoenter_b38e2bef:

#   cc "A-Ahh... uh..."
    cc "A-Ahh... uh..."

# game/script9.rpy:5382
translate brazil hyrilarnoenter_47e53555:

#   cc "N-No, Your Grace. Of course not."
    cc "N-Não, Vossa Graça. Claro que não."

# game/script9.rpy:5383
translate brazil hyrilarnoenter_8939773f:

#   cc "It..."
    cc "Isto..."

# game/script9.rpy:5384
translate brazil hyrilarnoenter_ec27bcb9:

#   cc "It shall be done as your command."
    cc "Isso será feito conforme seu comando."

# game/script9.rpy:5386
translate brazil hyrilarnoenter_03dbc0c3:

#   cc ". . ." with dis12
    cc ". . ." with dis12

# game/script9.rpy:5387
translate brazil hyrilarnoenter_6b0ed824:

#   mc "Um..."
    mc "Um..."

# game/script9.rpy:5388
translate brazil hyrilarnoenter_74d027eb:

#   mc "So... what exactly am I supposed to do now?"
    mc "Então... o que exatamente devo fazer agora?"

# game/script9.rpy:5390
translate brazil hyrilarnoenter_bf652ca8:

#   cc "For starters, do not speak unless you are given permission, human."
    cc "Para começar, não fale a menos que tenha permissão, humano."

# game/script9.rpy:5392
translate brazil hyrilarnoenter_07da91cb:

#   mc "R-Right. Got it."
    mc "R-Certo. Entendi."

# game/script9.rpy:5394
translate brazil hyrilarnoenter_cfd079f8:

#   cc "Now come with me. We'll hide your identity with a helm."
    cc "Agora venha comigo. Esconderemos sua identidade com um elmo."

# game/script9.rpy:5395
translate brazil hyrilarnoenter_d609bf93:

#   cc "Then, the suitors will arrive and present themselves before Her Grace and demonstrate their merit through combat and the three noble arts."
    cc "Então, os pretendentes chegarão e se apresentarão diante de Sua Graça e demonstrarão seus méritos através do combate e das três nobres artes."

# game/script9.rpy:5396
translate brazil hyrilarnoenter_4b3beb62:

#   cc "You just..."
    cc "Você apenas..."

# game/script9.rpy:5397
translate brazil hyrilarnoenter_4550bbf3:

#   cc "Bah, I will explain later. Just try not to disgrace the court."
    cc "Bah, explicarei mais tarde. Apenas tente não desonrar o tribunal."

# game/script9.rpy:5399
translate brazil hyrilarnoenter_06eb03ff:

#   mc "I'll do my best."
    mc "Eu farei o meu melhor."

# game/script9.rpy:5401
translate brazil hyrilarnoenter_53d6f8dc:

#   cc "Follow me..."
    cc "Me siga..."

# game/script9.rpy:5403
translate brazil hyrilarnoenter_e90e0ec3:

#   ele "*Whispering* Do you see it now, Thorund?" with dis15
    ele "*Sussurrando* Você vê isso agora, Thorund?" with dis15

# game/script9.rpy:5404
translate brazil hyrilarnoenter_cd73b4f4:

#   ele "*Whispering* Sylax was right."
    ele "*Sussurrando* Sylax estava certo."

# game/script9.rpy:5405
translate brazil hyrilarnoenter_c645aed3:

#   ele "*Whispering* That... is our only option."
    ele "*Sussurrando* Essa... é nossa única opção."

# game/script9.rpy:5407
translate brazil hyrilarnoenter_5bd29b88:

#   tho ". . ."
    tho ". . ."

# game/script9.rpy:5418
translate brazil hyrilarnoenter_e61e41e2:

#   cc "*Clears throat* Attention, please!" with dis15
    cc "*limpa a garganta* Atenção, por favor!" with dis15

# game/script9.rpy:5419
translate brazil hyrilarnoenter_52c229df:

#   cc "We are most grateful for your patience, ladies and gentlemen."
    cc "Estamos muito gratos pela sua paciência, senhoras e senhores."

# game/script9.rpy:5420
translate brazil hyrilarnoenter_037fde0a:

#   cc "At last, all preparations are complete, and our honored guests are here."
    cc "Finalmente, todos os preparativos foram concluídos e nossos convidados de honra estão aqui."

# game/script9.rpy:5422
translate brazil hyrilarnoenter_23e648b2:

#   cc "Therefore, without further delay, let the three suitors step forth!" with dis
    cc "Portanto, sem mais delongas, que os três pretendentes avancem!" with dis

# game/script9.rpy:5423
translate brazil hyrilarnoenter_a68b18ec:

#   cc "Those who seek the throne of our realm and the hand of Lady Calypso, First of Her Name and Princess of the Sy-tel-quessir..."
    cc "Aqueles que buscam o trono do nosso reino e a mão de Lady Calypso, Primeira de Seu Nome e Princesa do Sy-tel-quessir..."

# game/script9.rpy:5424
translate brazil hyrilarnoenter_42ac8a60:

#   cc "Introduce yourselves!"
    cc "Apresente-se!"

# game/script9.rpy:5428
translate brazil hyrilarnoenter_7f476b20:

#   bla "A young-looking elf enters the hall and dips into a fluid, elegant bow." with dis14
    bla "Um elfo de aparência jovem entra no salão e faz uma reverência fluida e elegante." with dis14

# game/script9.rpy:5430
translate brazil hyrilarnoenter_a4e2dc20:

#   gua2 "*Whispering* That is the heir of Thirinvale!"
    gua2 "*Sussurrando* Esse é o herdeiro de Thirinvale!"

# game/script9.rpy:5431
translate brazil hyrilarnoenter_561112fc:

#   enoble "*Whispering* They say he mastered thirteen instruments!"
    enoble "*Sussurrando* Dizem que ele domina treze instrumentos!"

# game/script9.rpy:5432
translate brazil hyrilarnoenter_732049a9:

#   ewoman "*Whispering* By the Ancients... he is even more handsome than they say..."
    ewoman "*Sussurrando* Pelos Antigos... ele é ainda mais bonito do que dizem..."

# game/script9.rpy:5436
translate brazil hyrilarnoenter_a9391740:

#   sui1 "Even the most vivid accounts of your beauty, Lady Calypso, have proven woefully incorrect in the presence of the truth." with dis12
    sui1 "Mesmo os relatos mais vívidos sobre a sua beleza, Lady Calypso, revelaram-se lamentavelmente incorretos na presença da verdade." with dis12

# game/script9.rpy:5437
translate brazil hyrilarnoenter_e187da9f:

#   sui1 "I am Fael of Thirinvale — scion of a lineage as old as the stars, victor of the Sunlance Tournament, and the youngest elf in recorded history to claim such honor before his first century."
    sui1 "Eu sou Fael de Thirinvale – descendente de uma linhagem tão antiga quanto as estrelas, vencedor do Torneio Sunlance, e o mais jovem elfo registrado na história a reivindicar tal honra antes de seu primeiro século."

# game/script9.rpy:5439
translate brazil hyrilarnoenter_e28d05d3:

#   ca "We bid you welcome, Lord Fael."
    ca "Damos-lhe as boas-vindas, Lorde Fael."

# game/script9.rpy:5440
translate brazil hyrilarnoenter_4ac7d915:

#   ca "It is an honor to have you in our presence."
    ca "É uma honra ter você em nossa presença."

# game/script9.rpy:5442
translate brazil hyrilarnoenter_7f79a9fc:

#   sui1 "I stand before you to take your hand, Lady Calypso."
    sui1 "Estou diante de você para pegar sua mão, Lady Calypso."

# game/script9.rpy:5443
translate brazil hyrilarnoenter_074ee18d:

#   sui1 "I seek to unite our noble houses, usher Hyril’ar into an era of brilliance it has yet to behold, and if I may be bold..."
    sui1 "Procuro unir nossas casas nobres, conduzir Hyril'ar a uma era de brilho que ainda não foi vista, e se me permitem ser ousado..."

# game/script9.rpy:5445
translate brazil hyrilarnoenter_5e22d307:

#   sui1 "...to see that the most beautiful woman in the realm is never without music, laughter, and... the kind of {i}attention{/i} that leaves her yearning for the night to never end." with dis
    sui1 "...ver que a mulher mais bonita do reino nunca fica sem música, risadas e... o tipo de {i}atenção{/i} que a deixa com saudades de que a noite nunca acabe." with dis

# game/script9.rpy:5447
translate brazil hyrilarnoenter_9f8fdf5a:

#   ca "U-Uh... I thank you, Lord Fael."
    ca "U-Uh... Obrigado, Lorde Fael."

# game/script9.rpy:5448
translate brazil hyrilarnoenter_3d939fee:

#   ca "It would seem your reputation for wit and eloquence is most deserved."
    ca "Parece que a sua reputação de inteligência e eloquência é muito merecida."

# game/script9.rpy:5452
translate brazil hyrilarnoenter_7a2ccfa5:

#   sui2 "I tremble before your radiance, Your Grace." with dis14
    sui2 "Tremo diante de seu esplendor, Vossa Graça." with dis14

# game/script9.rpy:5454
translate brazil hyrilarnoenter_fbc9e702:

#   enoble "*Whispering* The House of Ilvenmyr! They came!"
    enoble "*Sussurrando* A Casa de Ilvenmyr! Eles vieram!"

# game/script9.rpy:5455
translate brazil hyrilarnoenter_6c0a7af9:

#   gua2 "*Whispering* I heard he led the charge at Maer’n Rock with nothing but a banner and blade."
    gua2 "*Sussurrando* Ouvi dizer que ele liderou o ataque em Maer'n Rock com nada além de um estandarte e uma lâmina."

# game/script9.rpy:5456
translate brazil hyrilarnoenter_6c56762b:

#   gua "*Whispering* If there’s any justice left in this world, he will be king."
    gua "*Sussurrando* Se sobrar alguma justiça neste mundo, ele será rei."

# game/script9.rpy:5460
translate brazil hyrilarnoenter_a47a2555:

#   sui2 "I am Orym of Ilvenmyr, sworn sword of honor, heir to a house that has never bent knee to tyranny nor turned away from duty." with dis12
    sui2 "Eu sou Orym de Ilvenmyr, espada de honra juramentada, herdeiro de uma casa que nunca se dobrou diante da tirania nem se afastou do dever." with dis12

# game/script9.rpy:5461
translate brazil hyrilarnoenter_2f19cfd8:

#   sui2 "Long before Queen Anima the Radiant, our Houses were seen as one — united by blood, valor, and sacred vows."
    sui2 "Muito antes da Rainha Anima, a Radiante, nossas Casas eram vistas como uma só — unidas por sangue, valor e votos sagrados."

# game/script9.rpy:5462
translate brazil hyrilarnoenter_72d3bf69:

#   sui2 "I seek your hand not for glory, nor gain, but to restore that ancient bond which time has cruelly let wither!"
    sui2 "Procuro sua mão não para glória, nem ganho, mas para restaurar aquele antigo vínculo que o tempo cruelmente deixou murchar!"

# game/script9.rpy:5464
translate brazil hyrilarnoenter_d09efc71:

#   ca "We thank you and bid you welcome, Lord Orym."
    ca "Agradecemos e lhe damos as boas-vindas, Lorde Orym."

# game/script9.rpy:5465
translate brazil hyrilarnoenter_effb8d75:

#   ca "It is an honor no less great to receive you within these halls."
    ca "É uma honra não menos grande recebê-los nestes salões."

# game/script9.rpy:5467
translate brazil hyrilarnoenter_897e5994:

#   lo "I remember my father speaking of the House of Ilvenmyr and their prince."
    lo "Lembro-me de meu pai falando sobre a Casa de Ilvenmyr e seu príncipe."

# game/script9.rpy:5468
translate brazil hyrilarnoenter_030a55df:

#   lo "He praised his integrity and said he bore the spirit of a true leader."
    lo "Ele elogiou sua integridade e disse que tinha o espírito de um verdadeiro líder."

# game/script9.rpy:5472
translate brazil hyrilarnoenter_3c680322:

#   sui3 "My Lady." with dis14
    sui3 "Minha senhora." with dis14

# game/script9.rpy:5474
translate brazil hyrilarnoenter_891f2e77:

#   ewoman "*Whispering* Mother of Turska, do you see the size of that man?!"
    ewoman "*Sussurrando* Mãe de Turska, você vê o tamanho daquele homem?!"

# game/script9.rpy:5475
translate brazil hyrilarnoenter_9d060296:

#   enoble "*Whispering* He is massive!"
    enoble "*Sussurrando* Ele é enorme!"

# game/script9.rpy:5479
translate brazil hyrilarnoenter_4add6eb5:

#   sui3 "I am Torion of Redveil, only son of the blood-hardened House of Redveil." with dis12
    sui3 "Eu sou Torion de Redveil, filho único da sanguinária Casa de Redveil." with dis12

# game/script9.rpy:5480
translate brazil hyrilarnoenter_f0b4671b:

#   sui3 "Choose me, Princess, and I shall give you sons and daughters born of fire and fury."
    sui3 "Escolha-me, Princesa, e eu lhe darei filhos e filhas nascidos do fogo e da fúria."

# game/script9.rpy:5481
translate brazil hyrilarnoenter_a5145b6c:

#   sui3 "Children who will tower like oaks and march like storms!"
    sui3 "Crianças que se erguerão como carvalhos e marcharão como tempestades!"

# game/script9.rpy:5482
translate brazil hyrilarnoenter_a362a8fb:

#   sui3 "Commanders of legions!" with hpunchsubtle
    sui3 "Comandantes de legiões!" with hpunchsubtle

# game/script9.rpy:5483
translate brazil hyrilarnoenter_d72fc682:

#   sui3 "Slayers of kings!" with hpunch
    sui3 "Matadores de reis!" with hpunch

# game/script9.rpy:5484
translate brazil hyrilarnoenter_67640a09:

#   sui3 "{sc=2}Heirs to a realm reborn in strength!" with hpunch
    sui3 "{sc=2}Herdeiros de um reino renascido em força!" with hpunch

# game/script9.rpy:5486
translate brazil hyrilarnoenter_5d292ee3:

#   ca "U-Uh... th-thank you for your... most generous offer, Lord Torion."
    ca "U-Uh... obrigado pela sua... mais generosa oferta, Lorde Torion."

# game/script9.rpy:5487
translate brazil hyrilarnoenter_b4930a27:

#   ca "It will be... taken under careful consideration."
    ca "Será... levado sob consideração cuidadosa."

# game/script9.rpy:5489
translate brazil hyrilarnoenter_2fe2eeeb:

#   cc "Thank you all for your presentations." with dis
    cc "Obrigado a todos pelas vossas apresentações." with dis

# game/script9.rpy:5490
translate brazil hyrilarnoenter_93e1ae52:

#   cc "Now, in accordance with ancient tradition, you shall demonstrate your prowess by contending against a chosen champion of Hyril’ar."
    cc "Agora, de acordo com a tradição antiga, você demonstrará sua coragem lutando contra um campeão escolhido por Hyril'ar."

# game/script9.rpy:5491
translate brazil hyrilarnoenter_f220629a:

#   cc "Through this rite, Her Highness shall name the one deemed most worthy to claim her hand in union, securing the honor of your house and begetting heirs bearing the sacred bloodline of Queen Anima herself."
    cc "Através deste rito, Sua Alteza nomeará aquele que for considerado mais digno de reivindicar sua mão em união, assegurando a honra de sua casa e gerando herdeiros com a linhagem sagrada da própria Rainha Anima."

# game/script9.rpy:5493
translate brazil hyrilarnoenter_95888e4d:

#   cc "So..." with dis
    cc "Então..." with dis

# game/script9.rpy:5494
translate brazil hyrilarnoenter_466cee13:

#   cc "Yes, let the... {i}Champion{/i} enter."
    cc "Sim, deixe o... {i}Campeão{/i} entrar."

# game/script9.rpy:5495
translate brazil hyrilarnoenter_e486c521:

#   cc "Sir... Grothelborn."
    cc "Senhor... Grothelborn."

# game/script9.rpy:5499
translate brazil hyrilarnoenter_396ef4af:

#   bla "The crowd steps aside to let you pass, as whispers quickly ripple through the onlookers like a rising wave." with dis15
    bla "A multidão se afasta para deixar você passar, enquanto sussurros rapidamente percorrem os espectadores como uma onda crescente." with dis15

# game/script9.rpy:5500
translate brazil hyrilarnoenter_fa2d7f0f:

#   mct "I can feel the hate in their eyes. They can't stand me."
    mct "Posso sentir o ódio em seus olhos. Eles não me suportam."

# game/script9.rpy:5501
translate brazil hyrilarnoenter_46fc6528:

#   mct "But Calypso's putting everything on the line for me. The least I can do is not screw this up, and prove them all wrong."
    mct "Mas Calypso está colocando tudo em risco por mim. O mínimo que posso fazer é não estragar tudo e provar que todos estão errados."

# game/script9.rpy:5503
translate brazil hyrilarnoenter_8c492078:

#   mc "*Bowing down* My Lady." with dis12
    mc "*Curvando-se* Minha Senhora." with dis12

# game/script9.rpy:5504
translate brazil hyrilarnoenter_1bd12fc6:

#   mc "You have my solemn vow — so long as I, Sir Grothelborn of Kredon, draw breath, I shall do all within my power to bring honor to our realm."
    mc "Você tem meu voto solene: enquanto eu, Sir Grothelborn de Kredon, respirar, farei tudo ao meu alcance para trazer honra ao nosso reino."

# game/script9.rpy:5508
translate brazil hyrilarnoenter_d6adc907:

#   ca "Of that I have no doubt, Sir Grothelborn."
    ca "Disso não tenho dúvidas, Sir Grothelborn."

# game/script9.rpy:5510
translate brazil hyrilarnoenter_8d91fc86:

#   cc "Remember that, regardless of the valor of our Champion, each of you must demonstrate your worthiness to stand beside the Princess."
    cc "Lembrem-se que, independentemente do valor do nosso Campeão, cada um de vocês deve demonstrar o seu valor para ficar ao lado da Princesa."

# game/script9.rpy:5512
translate brazil hyrilarnoenter_fe478460:

#   cc "The future King of Hyril’ar must be a master of combat — graceful, precise, and unshakable in the heart of battle!" with dis
    cc "O futuro Rei de Hyril'ar deve ser um mestre em combate — gracioso, preciso e inabalável no coração da batalha!" with dis

# game/script9.rpy:5514
translate brazil hyrilarnoenter_ba94f493:

#   mct "Alright, I got this."
    mct "Tudo bem, eu entendi."

# game/script9.rpy:5515
translate brazil hyrilarnoenter_29d9b931:

#   mct "I can already use my powers for a few seconds. Combine that with everything Arannis drilled into me, and this should be easy enough."
    mct "Já posso usar meus poderes por alguns segundos. Combine isso com tudo o que Arannis me ensinou e isso deve ser bastante fácil."

# game/script9.rpy:5517
translate brazil hyrilarnoenter_e180b73b:

#   cc "So... today, to prove it, they will all demonstrate their expertise in archery with a longbow!"
    cc "Então... hoje, para provar isso, todos eles vão demonstrar seus conhecimentos no tiro com arco e flecha com arco longo!"

# game/script9.rpy:5519
translate brazil hyrilarnoenter_e9389240:

#   mct "A longbow?!"
    mct "Um arco longo?!"

# game/script9.rpy:5520
translate brazil hyrilarnoenter_d8490b4c:

#   mct "Fuck, then why the hell did I even bother grabbing a longsword?"
    mct "Porra, então por que diabos eu me preocupei em pegar uma espada longa?"

# game/script9.rpy:5522
translate brazil hyrilarnoenter_75341cb5:

#   cc "And... of course, the chosen suitor will also have to prove their worth in the three noble arts."
    cc "E... claro, o pretendente escolhido também terá que provar o seu valor nas três nobres artes."

# game/script9.rpy:5524
translate brazil hyrilarnoenter_5c2eb429:

#   mct "Noble arts...?"
    mct "Artes nobres...?"

# game/script9.rpy:5526
translate brazil hyrilarnoenter_3e67553c:

#   cc "Poetry." with dis
    cc "Poesia." with dis

# game/script9.rpy:5528
translate brazil hyrilarnoenter_c72cd2be:

#   mct "Okay... things might be a bit more complicated than I thought after all."
    mct "Ok... as coisas podem ser um pouco mais complicadas do que eu pensava, afinal."

# game/script9.rpy:5530
translate brazil hyrilarnoenter_1db8b8e9:

#   cc "Painting." with dis
    cc "Pintura." with dis

# game/script9.rpy:5532
translate brazil hyrilarnoenter_a71be525:

#   mct "...Yes, this is starting to look bad."
    mct "...Sim, isso está começando a ficar ruim."

# game/script9.rpy:5534
translate brazil hyrilarnoenter_7f0877c6:

#   cc "And... music." with dis
    cc "E... música." with dis

# game/script9.rpy:5537
translate brazil hyrilarnoenter_b542200f:

#   mct "I'm so fucking cooked."
    mct "Estou tão cozido."

# game/script9.rpy:5539
translate brazil hyrilarnoenter_23d19c0b:

#   cc "So, my Lady... we await your signal to begin." with dis
    cc "Então, minha senhora... aguardamos o seu sinal para começar." with dis

# game/script9.rpy:5541
translate brazil hyrilarnoenter_6ac16729:

#   ca "You may proceed, Lord Chamberlain."
    ca "Você pode prosseguir, Lorde Chamberlain."

# game/script9.rpy:5542
translate brazil hyrilarnoenter_255e83bd:

#   ca "I am most eager to witness what they shall bring forth."
    ca "Estou muito ansioso para testemunhar o que eles trarão."

# game/script9.rpy:5545
translate brazil hyrilarnoenter_92f94aa5:

#   cc "Excellent!" with hpunch
    cc "Excelente!" with hpunch

# game/script9.rpy:5546
translate brazil hyrilarnoenter_5a11158e:

#   cc "Then, without further delay, let the first challenge commence!"
    cc "Então, sem mais delongas, que comece o primeiro desafio!"

# game/script9.rpy:5547
translate brazil hyrilarnoenter_36cd3c6c:

#   cc "I present to you..."
    cc "Eu apresento a você..."

# game/script9.rpy:5556
translate brazil hyrilarnoenter_309afc1c:

#   cc "Each of you, including our Champion, shall compose a single verse — four lines in total — dedicated to the Princess." with dis15
    cc "Cada um de vocês, inclusive nosso Campeão, deverá compor um único verso — quatro versos no total — dedicado à Princesa." with dis15

# game/script9.rpy:5558
translate brazil hyrilarnoenter_62df167a:

#   cc "The theme, rhyme scheme, and meter are left entirely to your discretion, and you shall have but one minute to prepare." with dis
    cc "O tema, o esquema de rima e a métrica ficam inteiramente a seu critério, e você terá apenas um minuto para se preparar." with dis

# game/script9.rpy:5559
translate brazil hyrilarnoenter_cc861c98:

#   cc "Bare your soul before us!"
    cc "Descubra sua alma diante de nós!"

# game/script9.rpy:5561
translate brazil hyrilarnoenter_cbdeec26:

#   mct "One minute?!"
    mct "Um minuto?!"

# game/script9.rpy:5562
translate brazil hyrilarnoenter_8a53c9ae:

#   mct "What the hell is “scheme and meter” supposed to mean?!"
    mct "O que diabos “esquema e medidor” significa?!"

# game/script9.rpy:5564
translate brazil hyrilarnoenter_ec6911ff:

#   bla "Barely a few seconds pass before the first suitor steps forward." with dis15
    bla "Apenas alguns segundos se passam antes que o primeiro pretendente dê um passo à frente." with dis15

