    mct "Hmmm..."

# game/script9.rpy:6400
translate brazil lyreend_4c860bef:

#   mct "This thing’s way heavier than any bow I’ve used before."
    mct "Essa coisa é muito mais pesada do que qualquer arco que já usei."

# game/script9.rpy:6401
translate brazil lyreend_c6d8de77:

#   mct "Not that I’ve had much practice anyway... just a handful of days at most."
    mct "Não que eu tenha praticado muito... apenas alguns dias, no máximo."

# game/script9.rpy:6402
translate brazil lyreend_365de361:

#   mct "Still, I’ve gotta give it my all."
    mct "Ainda assim, tenho que dar tudo de mim."

# game/script9.rpy:6403
translate brazil lyreend_77553949:

#   mct "My life’s not on the line, sure, but Calypso stuck her neck out for me... right in front of the whole court."
    mct "Minha vida não está em risco, claro, mas Calypso arriscou o pescoço por mim... bem na frente de toda a quadra."

# game/script9.rpy:6404
translate brazil lyreend_40c93bae:

#   mct "So... if you're out there, goddess of fortune..."
    mct "Então... se você estiver aí, deusa da fortuna..."

# game/script9.rpy:6405
translate brazil lyreend_76713ee3:

#   mct "Imma need your help once more."
    mct "Vou precisar da sua ajuda mais uma vez."

# game/script9.rpy:6409
translate brazil lyreend_6cad9450:

#   mc ". . ." with dis12
    mc ". . ." with dis12

# game/script9.rpy:6410
translate brazil lyreend_ed868dcf:

#   mct "H-Holy fuck. T-This thing's so hard to pull all the way back."
    mct "C-Puta merda. É-Essa coisa é tão difícil de puxar totalmente para trás."

# game/script9.rpy:6411
translate brazil lyreend_2ccbf35a:

#   mct "A-And why the hell is it so heavy??"
    mct "A-E por que diabos é tão pesado??"

# game/script9.rpy:6412
translate brazil lyreend_3c8bae2e:

#   mct "What is this made of, platinum?!"
    mct "Do que é feito isso, platina?!"

# game/script9.rpy:6419
translate brazil lyreend_7cbabc8d:

#   mct "Yes... that's better." with dis
    mct "Sim... assim é melhor." with dis

# game/script9.rpy:6420
translate brazil lyreend_9c611b9d:

#   mct "My pulse is perfectly steady now."
    mct "Meu pulso está perfeitamente estável agora."

# game/script9.rpy:6421
translate brazil lyreend_24ab3b5f:

#   mct "I can see... everything more clearly."
    mct "Posso ver... tudo com mais clareza."

# game/script9.rpy:6423
translate brazil lyreend_3b3da6a4:

#   mct "F-Fuck no." with dis
    mct "F-Foda-se, não." with dis

# game/script9.rpy:6425
translate brazil lyreend_fba3d52d:

#   mct "I-I'm not using my p-powers for this."
    mct "E-eu não estou usando meus poderes p para isso."

# game/script9.rpy:6426
translate brazil lyreend_0f8bff86:

#   mct "I-It's a matter of... f-fucking pride now."
    mct "E-É uma questão de... orgulho agora."

# game/script9.rpy:6228
translate brazil lyreend_e0593b7c_1:

#   id "{sc=8}Break the chain.{w=0.02}{nw}"
    id "{sc=8}Quebre a corrente.{w=0.02}{nw}"

# game/script9.rpy:6449
translate brazil ballbowafter_03dbc0c3:

#   cc ". . ." with dis12
    cc ". . ." with dis12

# game/script9.rpy:6450
translate brazil ballbowafter_c58a10fb:

#   cc "U-Unbelievable..."
    cc "U-Inacreditável..."

# game/script9.rpy:6451
translate brazil ballbowafter_8f35b8fb:

#   cc "The hu..."
    cc "O hu..."

# game/script9.rpy:6452
translate brazil ballbowafter_06d06f44:

#   cc "T-The Champion struck the very center of the target."
    cc "T-O Campeão acertou bem no centro do alvo."

# game/script9.rpy:6454
translate brazil ballbowafter_b6036bfc:

#   ca "Not bad, Sir Grothelborn... not bad at all."
    ca "Nada mal, Sir Grothelborn... nada mal."

# game/script9.rpy:6455
translate brazil ballbowafter_b415e8c8:

#   ca "That was..."
    ca "Isso foi..."

# game/script9.rpy:6457
translate brazil ballbowafter_cf45b834:

#   ca "Very impressive, I must admit." with dis
    ca "Muito impressionante, devo admitir." with dis

# game/script9.rpy:6458
translate brazil ballbowafter_7e0ac504:

#   ca "You have truly proven yourself worthy as the Champion of Hyril’ar."
    ca "Você realmente provou ser digno como Campeão de Hyril'ar."

# game/script9.rpy:6461
translate brazil ballbowafter_09c2b978:

#   mc "*Bowing down* It was my honor, Your Grace." with dis14
    mc "*Curvando-se* Foi uma honra, Vossa Graça." with dis14

# game/script9.rpy:6462
translate brazil ballbowafter_9a0bfa39:

#   mc "No knight of Hyril’ar could fail to be moved when the Princess chooses him as her Champion."
    mc "Nenhum cavaleiro de Hyril'ar poderia deixar de se emocionar quando a Princesa o escolhe como seu Campeão."

# game/script9.rpy:6464
translate brazil ballbowafter_75372a12:

#   ca "A decision I find myself regretting less with each passing moment."
    ca "Uma decisão da qual me arrependo menos a cada momento que passa."

# game/script9.rpy:6466
translate brazil ballbowafter_fed67bbe:

#   cc "The perfect center..." with dis
    cc "O centro perfeito..." with dis

# game/script9.rpy:6467
translate brazil ballbowafter_e23ecd30:

#   cc "He even displaced Lord Torion’s arrow with his own."
    cc "Ele até deslocou a flecha de Lord Torion pela sua."

# game/script9.rpy:6468
translate brazil ballbowafter_9ce94823:

#   cc ". . ."
    cc ". . ."

# game/script9.rpy:6470
translate brazil ballbowafter_e322c339:

#   cc "B-But this is no mere stroke of fate, of course!" with dis12
    cc "M-Mas isso não é um mero golpe do destino, é claro!" with dis12

# game/script9.rpy:6471
translate brazil ballbowafter_fa8c50c3:

#   cc "Let that stand as a testament to the skill of Hyril’ar’s archers!"
    cc "Que isso seja uma prova da habilidade dos arqueiros de Hyril'ar!"

# game/script9.rpy:6472
translate brazil ballbowafter_1ac79864:

#   cc "The three suitors have proven themselves worthy of seeking the Princess’ hand... and yet, it seems Hyril’ar always stands a step above!"
    cc "Os três pretendentes provaram ser dignos de buscar a mão da Princesa... e ainda assim, parece que Hyril'ar está sempre um passo à frente!"

# game/script9.rpy:6475
translate brazil ballbowafter_780962d8:

#   cc "And... as was expected, our Champion's arrow struck beyond the outer ring." with dis12
    cc "E... como era de se esperar, a flecha do nosso Campeão atingiu além do anel externo." with dis12

# game/script9.rpy:6476
translate brazil ballbowafter_516306c2:

#   mct "Dammit..."
    mct "Droga..."

# game/script9.rpy:6478
translate brazil ballbowafter_4e1ed1f8:

#   cc "But this is no mere stroke of fate!" with dis12
    cc "Mas isto não é um mero golpe do destino!" with dis12

# game/script9.rpy:6479
translate brazil ballbowafter_499a4bb8:

#   cc "Let this serve as a testament to the skill and valor of the noble knights who have graced our lands today!"
    cc "Que isto sirva como um testemunho da habilidade e do valor dos nobres cavaleiros que agraciaram nossas terras hoje!"

# game/script9.rpy:6480
translate brazil ballbowafter_0bc4cdfb:

#   cc "All three suitors have proven themselves worthy of the Princess’ hand!"
    cc "Todos os três pretendentes provaram ser dignos da mão da Princesa!"

# game/script9.rpy:6481
translate brazil ballbowafter_4eb5b86e:

#   cc "Congratulations!" with hpunchsubtle
    cc "Parabéns!" with hpunchsubtle

# game/script9.rpy:6483
translate brazil ballbowafter_d8735b61:

#   cc "Now, let us raise our cups and partake in the feast, my lords and ladies!" with dis12
    cc "Agora, vamos levantar nossas taças e participar da festa, meus senhores e senhoras!" with dis12

# game/script9.rpy:6484
translate brazil ballbowafter_c32a821d:

#   cc "For today is a day of celebration!"
    cc "Pois hoje é dia de celebração!"

# game/script9.rpy:6485
translate brazil ballbowafter_647b8744:

#   cc "Rejoice!" with hpunchsubtle
    cc "Alegrar!" with hpunchsubtle

# game/script9.rpy:6490
translate brazil ballbowafter_0469eac6:

#   bla "As servants begin to arrive bearing platters of food and nobles gather around Calypso, you quietly slip to the edge of the room." with dis22
    bla "À medida que os servos começam a chegar trazendo travessas de comida e os nobres se reúnem ao redor de Calypso, você desliza silenciosamente para a borda da sala." with dis22

# game/script9.rpy:6491
translate brazil ballbowafter_cd501f2f:

#   mct "Well, I guess my job here's done."
    mct "Bem, acho que meu trabalho aqui está feito."

# game/script9.rpy:6492
translate brazil ballbowafter_7e5d4406:

#   mct "At the very least, Calypso looked relieved to have me by her side through all this thing."
    mct "No mínimo, Calipso parecia aliviada por me ter ao seu lado durante tudo isso."

# game/script9.rpy:6493
translate brazil ballbowafter_207d3bac:

#   mct "But now I should head back to my chambers until she's done with all the talking, before one of the suitors figures out I'm not actually an elf."
    mct "Mas agora devo voltar para meus aposentos até que ela termine de falar, antes que um dos pretendentes descubra que não sou realmente um elfo."

# game/script9.rpy:6495
translate brazil ballbowafter_ff733686:

#   sui3 "Sir Grothelborn."
    sui3 "Senhor Grothelborn."

# game/script9.rpy:6497
translate brazil ballbowafter_4fa59815:

#   mc "*Turning around* Hmm?" with dis12
    mc "*Virando-se* Hmm?" with dis12

# game/script9.rpy:6498
translate brazil ballbowafter_c41d2067:

#   mc "A-Ah, Sir Torion."
    mc "Ah, senhor Torion."

# game/script9.rpy:6499
translate brazil ballbowafter_352fe7a6:

#   mc "I’d love to stay and enjoy the feast, but... I, uh... made a vow never to remove my helm in public."
    mc "Eu adoraria ficar e aproveitar o banquete, mas... eu, uh... fiz uma promessa de nunca tirar meu elmo em público."

# game/script9.rpy:6500
translate brazil ballbowafter_af1e3432:

#   mc "To... my late wife."
    mc "Para... minha falecida esposa."

# game/script9.rpy:6501
translate brazil ballbowafter_b7c43387:

#   mc "Hope you understand."
    mc "Espero que você entenda."

# game/script9.rpy:6503
translate brazil ballbowafter_d05cca00:

#   sui3 "I understand."
    sui3 "Eu entendo."

# game/script9.rpy:6504
translate brazil ballbowafter_c52ad3ba:

#   sui3 "I merely wished to commend you on your skill with the bow."
    sui3 "Queria apenas elogiá-lo pela sua habilidade com o arco."

# game/script9.rpy:6505
translate brazil ballbowafter_7ee5a0ef:

#   sui3 "Your shot was exceptional. Especially while bearing such heavy armor."
    sui3 "Seu chute foi excepcional. Especialmente enquanto carrega uma armadura tão pesada."

# game/script9.rpy:6507
translate brazil ballbowafter_5b188f66:

#   mc "Oh, why, thank you."
    mc "Ah, por que, obrigado."

# game/script9.rpy:6509
translate brazil ballbowafter_6f948a6d:

#   sui3 "I am aware my chances of being chosen by the Princess are slim, as my family does not hold the stature of Sir Fael's or Lord Orym's."
    sui3 "Estou ciente de que minhas chances de ser escolhido pela Princesa são mínimas, já que minha família não tem a estatura de Sir Fael ou de Lorde Orym."

# game/script9.rpy:6510
translate brazil ballbowafter_cd98ef37:

#   sui3 "Still, should your path ever lead you to Redveil, you would be most welcome."
    sui3 "Ainda assim, se o seu caminho o levar a Redveil, você será muito bem-vindo."

# game/script9.rpy:6511
translate brazil ballbowafter_c7fafb5c:

#   sui3 "We always open our gates to knights of your caliber."
    sui3 "Sempre abrimos nossos portões para cavaleiros do seu calibre."

# game/script9.rpy:6513
translate brazil ballbowafter_c1dff962:

#   mc "Oh..."
    mc "Oh..."

# game/script9.rpy:6514
translate brazil ballbowafter_d9fe96bd:

#   mc "Thank you kindly. I shall remember your generous offer."
    mc "Obrigado gentilmente. Vou me lembrar de sua generosa oferta."

# game/script9.rpy:6515
translate brazil ballbowafter_8f72ef0c:

#   mct "Wow, I was not expecting that."
    mct "Nossa, eu não esperava por isso."

# game/script9.rpy:6516
translate brazil ballbowafter_0093c3f8:

#   mct "Maybe this guy’s not such a bad dude after all."
    mct "Talvez esse cara não seja tão ruim assim, afinal."

# game/script9.rpy:6517
translate brazil ballbowafter_723d7b4a:

#   mct "Aside from the whole “murder humans” part, maybe."
    mct "Além de toda a parte de “humanos assassinos”, talvez."

# game/script9.rpy:6519
translate brazil ballbowafter_9ea9654a:

#   sui3 "If the rumors of civil war prove true, Redveil will stand with the crown."
    sui3 "Se os rumores de uma guerra civil se confirmarem, Redveil ficará ao lado da coroa."

# game/script9.rpy:6520
translate brazil ballbowafter_862a9a8e:

#   sui3 "We will not abandon our old allies."
    sui3 "Não abandonaremos os nossos antigos aliados."

# game/script9.rpy:6522
translate brazil ballbowafter_8114a09f:

#   mc "Uh..."
    mc "Uh..."

# game/script9.rpy:6523
translate brazil ballbowafter_c74ab11f:

#   mc "Thank you, my Lord."
    mc "Obrigado, meu Senhor."

# game/script9.rpy:6525
translate brazil ballbowafter_0e614c43:

#   sui3 "Farewell, good sir."
    sui3 "Adeus, bom senhor."

# game/script9.rpy:6527
translate brazil ballbowafter_2c669eb9:

#   mc "Farewell."
    mc "Até a próxima."

# game/script9.rpy:6528
translate brazil ballbowafter_e766ed1a:

#   mct "Rumors of civil war? What was that about?"
    mct "Rumores de guerra civil? O que foi isso?"

# game/script9.rpy:6529
translate brazil ballbowafter_6f15d695:

#   cc "*Clears throat* Sir Grothelborn?"
    cc "*Limpa a garganta* Sir Grothelborn?"

# game/script9.rpy:6531
translate brazil ballbowafter_d82153d6:

#   mc "*Turning around* Ah... Lord Chamberlain..." with dis12
    mc "*Virando-se* Ah... Lorde Chamberlain..." with dis12

# game/script9.rpy:6535
translate brazil ballbowafter_64f95949:

#   cc "Well, well, well..." with dis15
    cc "Bem, bem, bem..." with dis15

# game/script9.rpy:6537
translate brazil ballbowafter_4453f3ee:

#   mc "Yes, yes, I'm leaving."
    mc "Sim, sim, estou indo embora."

# game/script9.rpy:6538
translate brazil ballbowafter_a65bd674:

#   mc "You don't have to worry about me anymore."
    mc "Você não precisa mais se preocupar comigo."

# game/script9.rpy:6540
translate brazil ballbowafter_ccbf02cb:

#   cc "Actually, I come bearing a message from the Princess."
    cc "Na verdade, venho trazendo uma mensagem da Princesa."

# game/script9.rpy:6541
translate brazil ballbowafter_47890aba:

#   cc "She will spend the next few hours entertaining our guests and becoming better acquainted with the suitors, in order to make the most appropriate decision."
    cc "Ela passará as próximas horas entretendo nossos convidados e conhecendo melhor os pretendentes, para tomar a decisão mais adequada."

# game/script9.rpy:6542
translate brazil ballbowafter_02e5282b:

#   cc "So she asked me to inform you that she will meet with you later in your chambers to... open a passageway to your homeland, before the day’s end."
    cc "Então ela me pediu para informá-lo que ela se encontrará com você mais tarde em seus aposentos para... abrir uma passagem para sua terra natal, antes do final do dia."

# game/script9.rpy:6544
translate brazil ballbowafter_ab1487ff:

#   mc "Ah, nice! That works for me."
    mc "Ah, legal! Isso funciona para mim."

# game/script9.rpy:6545
translate brazil ballbowafter_3857a5ef:

#   mc "I'm looking forward to going back home."
    mc "Estou ansioso para voltar para casa."

# game/script9.rpy:6546
translate brazil ballbowafter_99253d94:

#   cc "Mmh."
    cc "Ed."

# game/script9.rpy:6548
translate brazil ballbowafter_350e7fde:

#   cc "I, too, look forward to your departure."
    cc "Eu também estou ansioso pela sua partida."

# game/script9.rpy:6550
translate brazil ballbowafter_bc3ad5b7:

#   mc "Oh, come on..."
    mc "Ah, vamos lá..."

# game/script9.rpy:6551
translate brazil ballbowafter_720b52aa:

#   mc "I didn't do that bad."
    mc "Eu não fiz tão mal."

# game/script9.rpy:6552
translate brazil ballbowafter_af74b18d:

#   cc "Hmph."
    cc "Hmph."

# game/script9.rpy:6556
translate brazil ballbowafter_538b2b31:

#   cc "Your painting was dreadful, and I am still recovering from your lyre “performance”."
    cc "Sua pintura foi horrível, e ainda estou me recuperando da sua \"performance\" de lira."

# game/script9.rpy:6557
translate brazil ballbowafter_f8768358:

#   cc "But... your poem was not entirely awful, and your archery skills were surprisingly impressive, I will give you that."
    cc "Mas... seu poema não foi totalmente horrível, e suas habilidades com arco e flecha foram surpreendentemente impressionantes, isso eu admito."

# game/script9.rpy:6558
translate brazil ballbowafter_1d28e34e:

#   cc "Or, at least... impressively lucky."
    cc "Ou, pelo menos... uma sorte impressionante."

# game/script9.rpy:6560
translate brazil ballbowafter_dd9a63a1:

#   cc "Your painting was dreadful, your poem worse, and I am still recovering from your lyre “performance”."
    cc "Sua pintura foi horrível, seu poema pior, e ainda estou me recuperando da sua “performance” de lira."

# game/script9.rpy:6561
translate brazil ballbowafter_cddcfc09:

#   cc "But... your archery skills were surprisingly impressive, I will give you that."
    cc "Mas... suas habilidades com arco e flecha foram surpreendentemente impressionantes, isso eu admito."

# game/script9.rpy:6565
translate brazil ballbowafter_adcabd5f:

#   cc "Your painting was dreadful, your archery mediocre, and I am still recovering from your lyre “performance”."
    cc "Sua pintura foi horrível, seu arco e flecha medíocre, e ainda estou me recuperando da sua \"atuação\" de lira."

# game/script9.rpy:6566
translate brazil ballbowafter_85ed809d:

#   cc "But your poem was... surprisingly tolerable, I suppose."
    cc "Mas o seu poema foi... surpreendentemente tolerável, suponho."

# game/script9.rpy:6567
translate brazil ballbowafter_552567da:

#   cc "For a human."
    cc "Para um humano."

# game/script9.rpy:6569
translate brazil ballbowafter_cadc1626:

#   cc "Your painting was dreadful, your poem worse, your archery mediocre, and I am still recovering from your lyre “performance”."
    cc "Sua pintura foi horrível, seu poema pior, seu arco e flecha medíocre, e ainda estou me recuperando da sua \"atuação\" de lira."

# game/script9.rpy:6570
translate brazil ballbowafter_15d60364:

#   cc "But... at least you did not kill anyone."
    cc "Mas... pelo menos você não matou ninguém."

# game/script9.rpy:6571
translate brazil ballbowafter_eca8e9fb:

#   cc "I should be thankful for that, I suppose."
    cc "Eu deveria estar grato por isso, suponho."

# game/script9.rpy:6573
translate brazil ballbowafter_affe532e:

#   mc "I'll take that as a compliment."
    mc "Vou considerar isso um elogio."

# game/script9.rpy:6574
translate brazil ballbowafter_37c13ada:

#   mc "Thank you, Lord Chamberlain."
    mc "Obrigado, Lorde Chamberlain."

# game/script9.rpy:6577
translate brazil ballbowafter_ab0d6d19:

#   cc "Farewell... Sir Grothelborn."
    cc "Adeus... Sir Grothelborn."

# game/script9.rpy:6580
translate brazil ballbowafter_67ce8465:

#   mct "Alright then." with dis12
    mct "Tudo bem então." with dis12

# game/script9.rpy:6581
translate brazil ballbowafter_05c84ee0:

#   mct "Guess I'll go take a nap until Calypso's done here."
    mct "Acho que vou tirar uma soneca até Calypso terminar aqui."

# game/script9.rpy:6582
translate brazil ballbowafter_30e8d8fd:

#   mct "Or... maybe I could squeeze in some longbow practice. I could use a bit more skill and a bit less luck next time."
    mct "Ou... talvez eu pudesse praticar um pouco de arco longo. Eu poderia usar um pouco mais de habilidade e um pouco menos de sorte da próxima vez."

# game/script9.rpy:6583
translate brazil ballbowafter_a9e08fc6:

#   mct "Never a bad time to train."
    mct "Nunca é um mau momento para treinar."

# game/script9.rpy:6596
translate brazil ballbowafter_c21ed0e5:

#   ca "*Sitting down* Oh, heavens..." with dis14
    ca "*Sentando-se* Oh, céus..." with dis14

# game/script9.rpy:6597
translate brazil ballbowafter_d4271ee0:

#   ca "Finally, they've all left."
    ca "Finalmente, todos eles foram embora."

# game/script9.rpy:6598
translate brazil ballbowafter_55d2b7f2:

#   ca "I never imagined that mere conversation could be so draining."
    ca "Nunca imaginei que uma mera conversa pudesse ser tão desgastante."

# game/script9.rpy:6600
translate brazil ballbowafter_228a9100:

#   lo "It often is, Your Grace." with dis
    lo "Muitas vezes é, Vossa Graça." with dis

# game/script9.rpy:6601
translate brazil ballbowafter_fed91e3d:

#   lo "Especially when your heart is not invested in the words being exchanged."
    lo "Principalmente quando seu coração não está investido nas palavras trocadas."

# game/script9.rpy:6603
translate brazil ballbowafter_661e50df:

#   ca "Yes... that is very true, indeed."
    ca "Sim... isso é verdade, de fato."

# game/script9.rpy:6604
translate brazil ballbowafter_cd1aea25:

#   ca "Thank you for staying by my side through every tedious moment, Lorelei."
    ca "Obrigado por ficar ao meu lado em todos os momentos tediosos, Lorelei."

# game/script9.rpy:6606
translate brazil ballbowafter_2ed30f27:

#   lo "But of course, Your Grace!"
    lo "Mas é claro, Vossa Graça!"

# game/script9.rpy:6607
translate brazil ballbowafter_6e3b1ca9:

#   lo "I would have stayed even if it was not my sworn duty!"
    lo "Eu teria ficado mesmo que não fosse meu dever juramentado!"

# game/script9.rpy:6609
translate brazil ballbowafter_828d4858:

#   ca "Are you sure about that? Or is it the allure of royal privileges that keeps you close?"
    ca "Você tem certeza disso? Ou é o fascínio dos privilégios reais que o mantém por perto?"

# game/script9.rpy:6610
translate brazil ballbowafter_3642f0a3:

#   ca "I did notice you indulging in more than one glass of the Rivanor wine Sir Fael brought."
    ca "Notei que você estava se entregando a mais de uma taça do vinho Rivanor que Sir Fael trouxe."

# game/script9.rpy:6612
translate brazil ballbowafter_83257441:

#   lo "Absolutely not!"
    lo "Absolutamente não!"

# game/script9.rpy:6613
translate brazil ballbowafter_e6db512d:

#   lo "I could have been here just as the general’s daughter, if I'd wanted!"
    lo "Eu poderia estar aqui como filha do general, se quisesse!"

# game/script9.rpy:6614
translate brazil ballbowafter_d60c04dd:

#   lo "Suggesting otherwise wounds me deeply, Your Grace."
    lo "Sugerir o contrário me fere profundamente, Vossa Graça."

# game/script9.rpy:6616
translate brazil ballbowafter_b2ca84bd:

#   ca "*Chuckles* Alright, alright, I take it back."
    ca "*Risos* Tudo bem, tudo bem, retiro o que disse."

# game/script9.rpy:6617
translate brazil ballbowafter_a7fa392b:

#   ca "My thanks, Lorelei... all the more heartfelt now."
    ca "Meus agradecimentos, Lorelei... ainda mais sinceros agora."

# game/script9.rpy:6618
translate brazil ballbowafter_dba1a853:

#   ca "You are free to retire for today. You have done more than enough."
    ca "Você está livre para se aposentar hoje. Você fez mais do que suficiente."

# game/script9.rpy:6620
translate brazil ballbowafter_d95ddf27:

#   lo "Do you need anything else before I go? I can stay longer if you wish."
    lo "Você precisa de mais alguma coisa antes de eu ir? Posso ficar mais tempo se você quiser."

# game/script9.rpy:6622
translate brazil ballbowafter_28c7cfe0:

#   ca "No... there’s nothing left for you to do. The rest depends solely on me now."
    ca "Não... não há mais nada para você fazer. O resto depende exclusivamente de mim agora."

# game/script9.rpy:6623
translate brazil ballbowafter_945297bc:

#   ca "I must choose one of the three suitors to be... my husband."
    ca "Devo escolher um dos três pretendentes para ser... meu marido."

# game/script9.rpy:6625
translate brazil ballbowafter_2c793cba:

#   ca "The future king of Hyril'ar..."
    ca "O futuro rei de Hyril'ar..."

# game/script9.rpy:6627
translate brazil ballbowafter_c5f97cc6:

#   lo "How did your time with them go?"
    lo "Como foi seu tempo com eles?"

# game/script9.rpy:6628
translate brazil ballbowafter_c84efaeb:

#   lo "I saw you speaking with each for quite a while."
    lo "Eu vi você conversando com cada um por um bom tempo."

# game/script9.rpy:6630
translate brazil ballbowafter_176f19c1:

#   ca "It was all terribly... ceremonial."
    ca "Foi tudo terrivelmente... cerimonial."

# game/script9.rpy:6631
translate brazil ballbowafter_f428c08b:

#   ca "Each encounter, a different performance."
    ca "Cada encontro, uma atuação diferente."

# game/script9.rpy:6634
translate brazil ballbowafter_46bba311:

#   ca "{i}Lord Fael could hardly speak five sentences without hiding some crude innuendo in them. He promised me “passion and pleasure the likes of which I’d never known”."
    ca "{i}Lorde Fael dificilmente poderia falar cinco frases sem esconder nelas alguma insinuação grosseira. Ele me prometeu \"paixão e prazer como eu nunca conheci\"."

# game/script9.rpy:6637
translate brazil ballbowafter_a248453c:

#   ca "{i}Lord Orym was... dutiful. Almost too formal. He spoke of our families' ancient ties and how marriage would honor and restore them."
    ca "{i}Lorde Orym era... obediente. Quase muito formal. Ele falou dos antigos laços de nossas famílias e de como o casamento iria honrá-los e restaurá-los."

# game/script9.rpy:6640
translate brazil ballbowafter_8b473514:

#   ca "{i}And Lord Torion... he delivered a lecture more fitting for a war council."
    ca "{i}E Lord Torion... ele deu uma palestra mais adequada para um conselho de guerra."

# game/script9.rpy:6641
translate brazil ballbowafter_642fd26e:

#   ca "{i}His every word was about strength, blood, glory, and the training of his warriors from the age of ten."
    ca "{i}Cada palavra sua era sobre força, sangue, glória e o treinamento de seus guerreiros desde os dez anos de idade."

# game/script9.rpy:6642
translate brazil ballbowafter_714d3549:

#   lo "Oh..."
    lo "Oh..."

# game/script9.rpy:6644
translate brazil ballbowafter_1d1fcd85:

#   lo "I... see none of them exactly swept you off your feet, then." with dis14
    lo "Eu... vejo que nenhum deles exatamente te surpreendeu, então." with dis14

# game/script9.rpy:6645
translate brazil ballbowafter_6087dde2:

#   lo "Why not simply refuse them all? You have turned down proposals before."
    lo "Por que não simplesmente recusar todos eles? Você já recusou propostas antes."

# game/script9.rpy:6647
translate brazil ballbowafter_b2832c3a:

#   ca "Because the stakes are different this time."
    ca "Porque as apostas são diferentes desta vez."

# game/script9.rpy:6648
translate brazil ballbowafter_748d615c:

#   ca "My advisors told me that Hyril’ar stands on the brink of war. My absence has only exacerbated the unrest."
    ca "Meus conselheiros me disseram que Hyril'ar está à beira da guerra. Minha ausência apenas exacerbou a agitação."

# game/script9.rpy:6649
translate brazil ballbowafter_b3460d9c:

#   ca "Tensions rise on all borders, and there are whispers that some of the old Houses may soon turn against us."
    ca "As tensões aumentam em todas as fronteiras e há rumores de que algumas das antigas Casas poderão em breve voltar-se contra nós."

# game/script9.rpy:6650
translate brazil ballbowafter_631884f3:

#   ca "If I marry the heir of one of those Houses, I might... be able to hold the unity of the kingdom."
    ca "Se eu me casar com o herdeiro de uma dessas Casas, talvez... consiga manter a unidade do reino."

# game/script9.rpy:6651
translate brazil ballbowafter_2266c9f3:

#   ca "And perhaps... it is what I owe after all these years away."
    ca "E talvez... seja isso que devo depois de todos estes anos afastado."

# game/script9.rpy:6653
translate brazil ballbowafter_00d59eb4:

#   lo "But Hyril'ar is still strong."
    lo "Mas Hyril'ar ainda é forte."

# game/script9.rpy:6654
translate brazil ballbowafter_c7cf57fa:

#   lo "Not to mention you alone could defeat an army of hundreds with your magic, if it came to that!"
    lo "Sem mencionar que você sozinho poderia derrotar um exército de centenas de pessoas com sua magia, se fosse esse o caso!"

# game/script9.rpy:6656
translate brazil ballbowafter_a6cdb359:

#   ca "My magic..."
    ca "Minha magia..."

# game/script9.rpy:6658
translate brazil ballbowafter_fcdab9bd:

#   ca "Yes, well, about that..." with dis
    ca "Sim, bem, sobre isso..." with dis

# game/script9.rpy:6659
translate brazil ballbowafter_98c334b2:

#   ca "Uh... apparently, I also need to wed one of the suitors to... preserve the balance of my magic."
    ca "Uh... aparentemente, eu também preciso me casar com um dos pretendentes para... preservar o equilíbrio da minha magia."

# game/script9.rpy:6661
translate brazil ballbowafter_b6eb0848:

#   lo "How do you mean, Your Grace?"
    lo "O que você quer dizer, Vossa Graça?"

# game/script9.rpy:6663
translate brazil ballbowafter_d8760b97:

#   ca "Uh..."
    ca "Uh..."

# game/script9.rpy:6664
translate brazil ballbowafter_e9e85c13:

#   ca "Well, according to the Grand Druid, Anima’s power..."
    ca "Bem, de acordo com o Grande Druida, o poder da Anima..."

# game/script9.rpy:6665
translate brazil ballbowafter_c3abd401:

#   ca "{i}My{/i} power... is yearning to be passed on."
    ca "{i}Meu{/i} poder... anseia por ser transmitido."

# game/script9.rpy:6666
translate brazil ballbowafter_b1f66603:

#   ca "Which is making it grow volatile within me. Making me... weaker."
    ca "O que está tornando isso volátil dentro de mim. Me deixando... mais fraco."

# game/script9.rpy:6668
translate brazil ballbowafter_788de104:

#   lo "Oh, I see..."
    lo "Oh, eu vejo..."

# game/script9.rpy:6670
translate brazil ballbowafter_a27c0b25:

#   ca "But she believes that..."
    ca "Mas ela acredita que..."

# game/script9.rpy:6671
translate brazil ballbowafter_ef554504:

#   ca "P-Physical intimacy may anchor it once more."
    ca "A intimidade P-física pode ancorá-lo novamente."

# game/script9.rpy:6673
translate brazil ballbowafter_5afc18a6:

#   lo "Oh."
    lo "Oh."

# game/script9.rpy:6677
translate brazil ballbowafter_5ab587af:

#   lo "Oh..." with dis
    lo "Oh..." with dis

# game/script9.rpy:6678
translate brazil ballbowafter_f30c31e2:

#   lo "I-I understand."
    lo "E-eu entendo."

# game/script9.rpy:6680
translate brazil ballbowafter_d950011c:

#   ca ". . ."
    ca ". . ."

# game/script9.rpy:6682
translate brazil ballbowafter_66e30414:

#   ca "So... yes, that is yet another reason why a suitor must be chosen."
    ca "Então... sim, essa é mais uma razão pela qual um pretendente deve ser escolhido."

# game/script9.rpy:6684
translate brazil ballbowafter_268112f5:

#   lo ". . ."
    lo ". . ."

# game/script9.rpy:6686
translate brazil ballbowafter_41f276af:

#   lo "And... could Your Grace not simply..."
    lo "E... poderia Vossa Graça não simplesmente..."

# game/script9.rpy:6687
translate brazil ballbowafter_3e8a5ca0:

#   lo "Huh..."
    lo "Huh..."

# game/script9.rpy:6689
translate brazil ballbowafter_456da0b2:

#   lo "N-No, no, of course not."
    lo "N-Não, não, claro que não."

# game/script9.rpy:6690
translate brazil ballbowafter_db584816:

#   lo "Please, forgive me. I overstep."
    lo "Por favor me perdoe. Eu ultrapassei."

# game/script9.rpy:6692
translate brazil ballbowafter_9ec701b7:

#   ca "Speak, Lorelei."
    ca "Fala, Lorelei."

# game/script9.rpy:6694
translate brazil ballbowafter_1f4f4683:

#   lo "I have nothing to say, Your Grace."
    lo "Não tenho nada a dizer, Vossa Graça."

# game/script9.rpy:6696
translate brazil ballbowafter_fae92f90:

#   ca "Yes, you do."
    ca "Sim, você quer."

# game/script9.rpy:6697
translate brazil ballbowafter_a6c4e494:

#   ca "I command you to speak."
    ca "Eu ordeno que você fale."

# game/script9.rpy:6698
translate brazil ballbowafter_1636ce78:

#   ca "Cast aside formalities... at least for this moment."
    ca "Deixe de lado as formalidades... pelo menos por enquanto."

# game/script9.rpy:6702
translate brazil ballbowafter_52bd7ced:

#   lo "W-Well, if that is your will..."
    lo "B-Bem, se essa for a sua vontade..."

# game/script9.rpy:6704
translate brazil ballbowafter_2d75a25d:

#   lo "I just thought..."
    lo "Eu apenas pensei..."

# game/script9.rpy:6705
translate brazil ballbowafter_520f8b95:

#   lo "Could Your Grace not simply... lie with someone?"
    lo "Vossa Graça não poderia simplesmente... mentir com alguém?"

# game/script9.rpy:6707
translate brazil ballbowafter_b755f15b:

#   lo "Surely, the act itself is what is required, not the ceremony around it."
    lo "Certamente, o ato em si é o que é necessário, e não a cerimônia em torno dele."

# game/script9.rpy:6709
translate brazil ballbowafter_809f055f:

#   lo "And... I cannot imagine a single noble in all Hyril’ar who would... decline such a proposal."
    lo "E... não consigo imaginar um único nobre em toda Hyril'ar que... recusaria tal proposta."

# game/script9.rpy:6711
translate brazil ballbowafter_6f9754d3:

#   ca "That is out of the question."
    ca "Isso está fora de questão."

# game/script9.rpy:6712
translate brazil ballbowafter_07afa736:

#   ca "We elves may carry the air of dignity, but beneath that, we are creatures of whispers and rumors."
    ca "Nós, elfos, podemos ter um ar de dignidade, mas por baixo disso somos criaturas de sussurros e rumores."

# game/script9.rpy:6714
translate brazil ballbowafter_146110a7:

#   ca "If I were to share my bed with a simple noble, every soul in the realm would know by nightfall."
    ca "Se eu compartilhasse minha cama com um simples nobre, todas as almas do reino saberiam ao anoitecer."

# game/script9.rpy:6715
translate brazil ballbowafter_f2550698:

#   ca "And they would surely use that against me."
    ca "E eles certamente usariam isso contra mim."

# game/script9.rpy:6717
translate brazil ballbowafter_da1f3679:

#   lo "Oh... of course."
    lo "Ah... claro."

# game/script9.rpy:6719
translate brazil ballbowafter_c20800a2:

#   ca "And before you suggest it..."
    ca "E antes que você sugira isso..."

# game/script9.rpy:6721
translate brazil ballbowafter_5e8136bb:

#   ca "Yes, I have already tried... tending to it myself. Alone."
    ca "Sim, eu já tentei... cuidar disso sozinho. Sozinho."

# game/script9.rpy:6722
translate brazil ballbowafter_56e4f023:

#   ca "But I cannot... reach the..."
    ca "Mas não consigo... alcançar o..."

# game/script9.rpy:6723
translate brazil ballbowafter_80d82f5d:

#   ca "*Clears throat* I do not seem to be able to find release on my own."
    ca "*Limpa a garganta* Parece que não consigo encontrar a libertação sozinho."

# game/script9.rpy:6724
translate brazil ballbowafter_cdaa89a6:

#   ca "My mind is blocked, somehow."
    ca "Minha mente está bloqueada, de alguma forma."

# game/script9.rpy:6726
translate brazil ballbowafter_f3aa38cf:

#   lo "Oh... I-I understand."
    lo "Oh... eu-eu entendo."

# game/script9.rpy:6730
translate brazil ballbowafter_951625c5:

#   lo "Then... perhaps..."
    lo "Então... talvez..."

# game/script9.rpy:6731
translate brazil ballbowafter_de9d6b81:

#   lo "What if..."
    lo "E se..."

# game/script9.rpy:6732
translate brazil ballbowafter_06695e83:

#   lo "What if Your Grace... asked Lord [mc] for... assistance?"
    lo "E se Vossa Graça... pedisse... ajuda ao Senhor [mc]?"

# game/script9.rpy:6734
translate brazil ballbowafter_257ccc9e:

#   ca "Lorelei!" with hpunchsubtle
    ca "Lorelei!" with hpunchsubtle

# game/script9.rpy:6735
translate brazil ballbowafter_b01ef247:

#   ca "[mc] again?" with hpunchsubtle
    ca "[mc] de novo?" with hpunchsubtle

# game/script9.rpy:6737
translate brazil ballbowafter_4548b3ec:

#   lo "W-W-What I mean is..."
    lo "O-O que eu quero dizer é..."

# game/script9.rpy:6738
translate brazil ballbowafter_8a522461:

#   lo "P-Perhaps the... touch of a man could help Your Grace reach–"
    lo "P-Talvez o... toque de um homem possa ajudar Vossa Graça a alcançar–"

# game/script9.rpy:6741
translate brazil ballbowafter_5589f35e:

#   ca "He is a human!" with hpunchsubtle
    ca "Ele é um humano!" with hpunchsubtle

# game/script9.rpy:6742
translate brazil ballbowafter_24970a2b:

#   ca "What you are suggesting is a crime both under our laws and the commandments of the Ancients! Akin to bestiality!"
    ca "O que você está sugerindo é um crime tanto sob nossas leis quanto sob os mandamentos dos Antigos! Semelhante à bestialidade!"

# game/script9.rpy:6744
translate brazil ballbowafter_3939505d:

#   lo "I-I know, I do! I just..."
    lo "Eu-eu sei, eu sei! Eu acabei de..."

# game/script9.rpy:6746
translate brazil ballbowafter_0298e6d3:

#   lo "Well, I thought that being a stranger to the court, there would be no risk of anyone discovering it."
    lo "Bem, pensei que sendo um estranho no tribunal, não haveria risco de alguém descobrir."

# game/script9.rpy:6747
translate brazil ballbowafter_984c6b0d:

#   lo "A-And you mentioned yourself having grown fond of him, so..."
    lo "E-E você mencionou que começou a gostar dele, então..."

# game/script9.rpy:6749
translate brazil ballbowafter_66bacfb2:

#   ca "U-Uh..."
    ca "U-Uh..."

# game/script9.rpy:6751
translate brazil ballbowafter_966362e8:

#   ca "Y-Yes, well, I... I mean, I am fond of my horse as well, but that does not mean I intend to bed it."
    ca "S-Sim, bem, eu... quero dizer, eu também gosto do meu cavalo, mas isso não significa que pretendo dormir com ele."

# game/script9.rpy:6753
translate brazil ballbowafter_5b9446af:

#   ca "Do you not remember Lady Arwil? When she was caught with a human, she was stripped of name and exiled!"
    ca "Você não se lembra de Lady Arwil? Quando ela foi pega com um humano, seu nome foi despojado e exilada!"

# game/script9.rpy:6754
translate brazil ballbowafter_d73a2073:

#   ca "She was never seen again!"
    ca "Ela nunca mais foi vista!"

# game/script9.rpy:6756
translate brazil ballbowafter_fb09ebb8:

#   lo "But... that was because she was... discovered. She was careless."
    lo "Mas... isso foi porque ela foi... descoberta. Ela foi descuidada."

# game/script9.rpy:6758
translate brazil ballbowafter_6dadf4c0:

#   lo "Had she been more discreet..."
    lo "Se ela tivesse sido mais discreta..."

# game/script9.rpy:6760
translate brazil ballbowafter_fe102680:

#   ca "Enough!" with hpunchsubtle
    ca "Suficiente!" with hpunchsubtle

# game/script9.rpy:6761
translate brazil ballbowafter_10072fad:

#   ca "I will not allow a human to lay a hand upon me!"
    ca "Não permitirei que um humano coloque a mão em mim!"

# game/script9.rpy:6762
translate brazil ballbowafter_23a0b233:

#   ca "I..."
    ca "EU..."

# game/script9.rpy:6764
translate brazil ballbowafter_3941d9c6:

#   ca "I... I cannot."
    ca "Eu... eu não posso."

# game/script9.rpy:6766
translate brazil ballbowafter_f2a3c412:

#   lo "I-I know, Your Grace."
    lo "Eu-eu sei, Vossa Graça."

# game/script9.rpy:6767
translate brazil ballbowafter_8215509d:

#   lo "I am well aware your body is sacred. More than any other in the realm!"
    lo "Estou bem ciente de que seu corpo é sagrado. Mais do que qualquer outro no reino!"

# game/script9.rpy:6768
translate brazil ballbowafter_25550d17:

#   lo "I merely thought he could... assist you... without touching you."
    lo "Eu simplesmente pensei que ele poderia... ajudar você... sem tocar em você."

# game/script9.rpy:6772
translate brazil ballbowafter_6b5280d9:

#   ca "What do you mean by that...?"
    ca "O que você quer dizer com isso...?"

# game/script9.rpy:6774
translate brazil ballbowafter_ccb012e2:

#   lo "Y-You said your thoughts distract you when you... try alone."
    lo "V-Você disse que seus pensamentos te distraem quando você... tenta sozinho."

# game/script9.rpy:6775
translate brazil ballbowafter_e794f5af:

#   lo "But perhaps... if your eyes were granted a certain indulgence..."
    lo "Mas talvez... se aos seus olhos fosse concedida uma certa indulgência..."

# game/script9.rpy:6776
translate brazil ballbowafter_40e7b495:

#   lo "If you were to simply... watch... To allow his presence to ignite something within..."
    lo "Se você simplesmente... observasse... Para permitir que a presença dele acendesse algo dentro de você..."

# game/script9.rpy:6780
translate brazil ballbowafter_0d878898:

#   ca "Explain yourself. Precisely."
    ca "Explique-se. Precisamente."

# game/script9.rpy:6784
translate brazil ballbowafter_98c24c40:

#   lo "Well... I only mean..."
    lo "Bem... eu só quero dizer..."

# game/script9.rpy:6786
translate brazil ballbowafter_2d81f90c:

#   lo "I surely would do anything for you, Your Grace. You know it."
    lo "Eu certamente faria qualquer coisa por você, Vossa Graça. Você sabe disso."

# game/script9.rpy:6787
translate brazil ballbowafter_9d4f5ed4:

#   ca "Hmph..."
    ca "Hmmm..."

# game/script9.rpy:6793
translate brazil ballbowafter_17b7a07e:

#   mct "Ahhh... this fire hits the spot." with dis
    mct "Ahhh... esse fogo atinge o local." with dis

# game/script9.rpy:6794
translate brazil ballbowafter_4ea19ca6:

#   mct "This place gets cold as hell when the sun goes down."
    mct "Este lugar fica muito frio quando o sol se põe."

# game/script9.rpy:6795
translate brazil ballbowafter_d2ffe806:

#   mct "Which makes me wonder... is it winter here? Do Hyril’ar and Earth even have the same seasons...?"
    mct "O que me faz pensar... é inverno aqui? Hyril'ar e a Terra têm as mesmas estações...?"

# game/script9.rpy:6796
translate brazil ballbowafter_e4116925:

#   mct "Like... do they even use months? Days of the week?"
    mct "Tipo... eles usam meses? Dias da semana?"

# game/script9.rpy:6797
translate brazil ballbowafter_6fec8247:

#   mct "Mmh, there's still so much I don't know about this world. I really have to come back with the girls once this whole “Gem War” is over."
    mct "Mmh, ainda há tanta coisa que não sei sobre este mundo. Eu realmente tenho que voltar com as meninas assim que toda essa “Guerra das Gemas” acabar."

# game/script9.rpy:6798
translate brazil ballbowafter_c82b07bf:

#   mct "I wonder if being the CEO of Ulysses would earn me some kind of royal title at the court..."
    mct "Eu me pergunto se ser o CEO da Ulysses me daria algum tipo de título real na corte..."

# game/script9.rpy:6800
translate brazil ballbowafter_44def47e:

#   lo "*Knocking on the door* Um... Lord [mc]?"
    lo "*Batendo na porta* Hum... Senhor [mc]?"

# game/script9.rpy:6802
translate brazil ballbowafter_469cbc1b:

#   mc "Hmm?" with dis08
    mc "Hum?" with dis08

# game/script9.rpy:6803
translate brazil ballbowafter_3f023da7:

#   mc "Lorelei? Is that you?"
    mc "Lorelei? É você?"

# game/script9.rpy:6804
translate brazil ballbowafter_86c8a55d:

#   lo "Yes!"
    lo "Sim!"

