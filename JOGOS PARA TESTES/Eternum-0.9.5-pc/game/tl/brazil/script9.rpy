#   l "*Deep exhale* Mmmmh..."
    l "*Expire profundamente* Hummm..."

# game/script9.rpy:20812
translate brazil ga_luna3_b6660ed9:

#   l "How long until the train comes back?"
    l "Quanto tempo até o trem voltar?"

# game/script9.rpy:20813
translate brazil ga_luna3_8cc251f2:

#   mc "Well, I’m not even sure how long we’ve been here, but we should probably start heading to the station."
    mc "Bem, nem tenho certeza de há quanto tempo estamos aqui, mas provavelmente deveríamos começar a ir para a estação."

# game/script9.rpy:20814
translate brazil ga_luna3_a0b0db9c:

#   l "Yeah, I guess so..."
    l "Sim, acho que sim..."

# game/script9.rpy:20815
translate brazil ga_luna3_ff3d036c:

#   mc "You said you found something to protect us from the rain?"
    mc "Você disse que encontrou algo para nos proteger da chuva?"

# game/script9.rpy:20816
