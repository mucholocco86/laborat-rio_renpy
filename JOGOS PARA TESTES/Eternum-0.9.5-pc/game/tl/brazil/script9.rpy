translate brazil guardwin09_4b21278c:

#   ca "*Muttering* Every one of them swore an oath before the gods themselves..."
    ca "*Murmurando* Cada um deles fez um juramento diante dos próprios deuses..."

# game/script9.rpy:8635
translate brazil guardwin09_8c2a8899:

#   ca "*Muttering* Traitors..."
    ca "*Resmungando* Traidores..."

# game/script9.rpy:8636
translate brazil guardwin09_d950011c:

#   ca ". . ."
    ca ". . ."

# game/script9.rpy:8637
translate brazil guardwin09_25065058:

#   ca "*Muttering* I need to... find allies..."
    ca "*Murmurando* Eu preciso... encontrar aliados..."

# game/script9.rpy:8638
translate brazil guardwin09_aa76df87:

#   ca "*Muttering* Someone must still be loyal..."
    ca "*Murmurando* Alguém ainda deve ser leal..."

# game/script9.rpy:8639
translate brazil guardwin09_570eb0a1:

#   ca "*Muttering* But how can I know who to trust...?"
    ca "*Resmungando* Mas como posso saber em quem confiar...?"

# game/script9.rpy:8644
translate brazil guardwin09_6dc6aa5a:

#   ca "*Muttering* Okay..."
    ca "*Murmurando* Ok..."

# game/script9.rpy:8645
translate brazil guardwin09_bf5393c9:

#   ca "*Muttering* I must act..."
    ca "*Murmurando* Eu devo agir..."

# game/script9.rpy:8646
translate brazil guardwin09_84aca85c:

#   ca "*Muttering* I will not... let my realm fall..."
    ca "*Murmurando* Eu não vou... deixar meu reino cair..."

# game/script9.rpy:8647
translate brazil guardwin09_decc661b:

#   ca "*Muttering* Not like this..."
    ca "*Murmurando* Não é assim..."

# game/script9.rpy:8648
translate brazil guardwin09_90f7798d:

#   ca "Enough."
    ca "Suficiente."

# game/script9.rpy:8650
translate brazil guardwin09_7530f743:

#   mc "I don't want to push you, Princess, but..." with dis
    mc "Não quero pressioná-la, Princesa, mas..." with dis

# game/script9.rpy:8651
translate brazil guardwin09_e90872de:

#   mc "Every second we spend here, they get closer."
    mc "Cada segundo que passamos aqui, eles se aproximam."

# game/script9.rpy:8652
translate brazil guardwin09_f3817596:

#   mc "We need to leave {i}now."
    mc "Precisamos sair {i}agora."

# game/script9.rpy:8653
