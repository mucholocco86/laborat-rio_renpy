#   mct "Phew, I hope she likes the little outing I've planned." with dis12
    mct "Ufa, espero que ela goste do pequeno passeio que planejei." with dis12

# game/script9.rpy:9689
translate brazil cafe09poshy_7d5e2f43:

#   mct "While I was in Hyril’ar, she's the one who kept everyone grounded, even though she was just as scared."
    mct "Enquanto eu estava em Hyril'ar, foi ela quem manteve todos com os pés no chão, embora estivesse igualmente assustada."

# game/script9.rpy:9690
translate brazil cafe09poshy_b8987881:

#   mct "She’s spent her whole life hiding her pain just to protect the people around her."
    mct "Ela passou a vida inteira escondendo sua dor apenas para proteger as pessoas ao seu redor."

# game/script9.rpy:9691
translate brazil cafe09poshy_fa63b905:

#   mct "If anyone deserves a perfect day, it’s her."
    mct "Se alguém merece um dia perfeito, é ela."

# game/script9.rpy:9693
translate brazil cafe09poshy_00b476c0:

#   mc "*Grabbing your phone* Hmm..." with dis17
    mc "*Pegando seu telefone* Hmm..." with dis17

# game/script9.rpy:9695
translate brazil cafe09poshy_8fea2db2:

#   mc "Hmm..."
    mc "Hum..."

# game/script9.rpy:9696
