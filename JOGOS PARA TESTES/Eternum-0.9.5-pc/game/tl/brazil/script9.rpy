#   mc "I saved her life when I freed her from captivity." with dis
    mc "Salvei a vida dela quando a libertei do cativeiro." with dis

# game/script9.rpy:1340
translate brazil trial6b_7db44e9d:

#   mc "The Princess felt she owed me for it, so she insisted on staying close and helping me in return."
    mc "A princesa sentiu que me devia isso, então insistiu em ficar por perto e me ajudar em troca."

# game/script9.rpy:1342
