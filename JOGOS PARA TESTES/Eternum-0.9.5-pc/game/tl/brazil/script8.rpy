#   zap "I fought off Davy Jones' cruel crew in the Bay of the Undead."
    zap "Lutei contra a tripulação cruel de Davy Jones na Baía dos Mortos-Vivos."

# game/script8.rpy:2647
translate brazil jumpoff_dedfff96:

#   no "We didn't even see them."
    no "Nós nem os vimos."

# game/script8.rpy:2649
translate brazil jumpoff_298dc111:

#   zap "AND I WILL TAKE YOU TO THE ISLAND OF THE LOST SOULS!"
    zap "E EU TE LEVAREI À ILHA DAS ALMAS PERDIDAS!"

# game/script8.rpy:2650
translate brazil jumpoff_3a6878eb:

#   zap "TRUST ME AND WE WILL PREVAIL!" with hpunch
    zap "CONFIE EM MIM E VAMOS PREVALECER!" with hpunch

# game/script8.rpy:2652
translate brazil jumpoff_30f29837:

#   mc "Okay, okay!"
    mc "Ok, ok!"

# game/script8.rpy:2653
translate brazil jumpoff_ca3d2c12:

#   mc "I guess it's worth a try."
    mc "Acho que vale a pena tentar."

# game/script8.rpy:2657
