translate brazil arabialogoff_ca940225:

#   mc "If you were trying to pull that rhetoric to convince me to bring you into Eternum with your real body again, forget it, miss."
    mc "Se você estava tentando usar aquela retórica para me convencer a trazê-la para Eternum com seu corpo real novamente, esqueça, senhorita."

# game/script8.rpy:16272
translate brazil arabialogoff_8fc9dd93:

#   mc "If anyone's gonna put their life on the line from now on, it's gonna be me and only me."
    mc "Se alguém vai colocar a vida em risco de agora em diante, serei eu e só eu."

# game/script8.rpy:16274
