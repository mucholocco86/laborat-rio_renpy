#   d "I won't insist, I promise."
    d "Não vou insistir, prometo."

# game/script8.rpy:16277
translate brazil arabialogoff_37124bbe:

#   mc "And speaking of putting your life in danger, you better get home quick before you freeze to death out here!"
    mc "E por falar em colocar sua vida em perigo, é melhor você chegar em casa rápido antes de morrer congelado aqui!"

# game/script8.rpy:16279
translate brazil arabialogoff_3bdeb95c:

#   d "Oh, no need to tell me twice!"
    d "Oh, não há necessidade de me dizer duas vezes!"

