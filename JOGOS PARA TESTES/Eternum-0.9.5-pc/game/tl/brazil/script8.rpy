#   sam "I quit. I'm so out."
    sam "Eu desisto. Estou tão fora."

# game/script8.rpy:16180
translate brazil ga_dalia4_092d0e08:

#   sam "Tell the Empress that she can take control of everything! Or... you can!"
    sam "Diga à Imperatriz que ela pode controlar tudo! Ou... você pode!"

# game/script8.rpy:16181
translate brazil ga_dalia4_42592b9e:

#   sam "I officially name you the new Leader of the Ishari!"
    sam "Eu oficialmente nomeio você como o novo Líder dos Ishari!"

