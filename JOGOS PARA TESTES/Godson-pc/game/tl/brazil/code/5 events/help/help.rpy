# ARQUIVO: game/code/5 events/help/help.rpy DIALOGOS: 166


# game/code/5 events/help/help.rpy:13
translate brazil dad1_71a3f73f:

#   voice my_audio["212"]
#       nar "The warmth of feeling your cock inside Marnie's warm slimy dripping wet body fades faster than it should. You try to hold on, but something is....off."
    voice my_audio["212"]
    nar "A sensação quente do seu pau dentro do corpo quente, viscoso e molhado de Marnie desaparece mais rápido do que deveria. Você tenta se segurar, mas algo está... errado."

# game/code/5 events/help/help.rpy:15
translate brazil dad1_701c4f74:

#   voice my_audio["213"]
#       nar "It’s the silence that wakes you first, not peace, but a silence that feels thick, unnatural, like the air is holding its breath."
    voice my_audio["213"]
    nar "É o silêncio que primeiro te desperta, não a paz, mas um silêncio denso, antinatural, como se o ar estivesse prendendo a respiração."

# game/code/5 events/help/help.rpy:21
translate brazil dad1_45511d2c:

#   voice my_audio["214"]
#       nar "When your eyes open, you're no longer in your room. Stone walls surround you. Cold. Damp. Ancient. You're sitting upright on a slab of rock, arms limp, skin bare, and everything feels wrong."
    voice my_audio["214"]
    nar "Ao abrir os olhos, você não está mais no seu quarto. Paredes de pedra o cercam. Frias. Úmidas. Antigas. Você está sentado ereto sobre uma laje de pedra, com os braços inertes, a pele nua, e tudo parece errado."

# game/code/5 events/help/help.rpy:23
translate brazil dad1_f9baff0d:

#   voice my_audio["215"]
#       nar "Your ears catch something before your brain does, footsteps, maybe? No. A breath. Someone else is here."
    voice my_audio["215"]
    nar "Seus ouvidos captam algo antes do seu cérebro, passos, talvez? Não. Uma respiração. Tem alguém aqui."

# game/code/5 events/help/help.rpy:25
translate brazil dad1_312bc3d5:

#   voice my_audio["216"]
#       nar "Your instincts scream, but your body remains still."
    voice my_audio["216"]
    nar "Seus instintos gritam, mas seu corpo permanece imóvel."

# game/code/5 events/help/help.rpy:27
translate brazil dad1_31369fba:

#   voice my_audio["217"]
#       nar "Your eyes lock forward. There, across from you....sits a man. Silent. Waiting. Watching."
    voice my_audio["217"]
    nar "Seus olhos se fixam à frente. Ali, do outro lado... está sentado um homem. Silencioso. Esperando. Observando."

# game/code/5 events/help/help.rpy:33
translate brazil dad1_39e021dc:

#   voice my_audio["218"]
#       nar "He’s seated on a narrow wooden bench, elbows resting between his knees, holding a worn black fedora loosely in both hands like it carries the weight of something sacred."
    voice my_audio["218"]
    nar "Ele está sentado em um banco estreito de madeira, com os cotovelos apoiados entre os joelhos, segurando um chapéu fedora preto e gasto frouxamente com as duas mãos, como se carregasse o peso de algo sagrado."

# game/code/5 events/help/help.rpy:35
translate brazil dad1_935208d6:

#   voice my_audio["219"]
#       nar "The lines on his face speak of time. Hard time. A life lived sharply and not without scars. His clothes are elegant but weathered, like something expensive worn for far too long in the wrong place."
    voice my_audio["219"]
    nar "As linhas em seu rosto falam do tempo. Tempos difíceis. Uma vida vivida intensamente e não sem cicatrizes. Suas roupas são elegantes, mas desgastadas, como algo caro usado por muito tempo no lugar errado."

# game/code/5 events/help/help.rpy:37
translate brazil dad1_c553c106:

#   voice my_audio["220"]
#       nar "He stares at you with a calm intensity that sends a chill down your spine... and something in your chest starts to tighten, as if your soul recognizes him before your mind catches up."
    voice my_audio["220"]
    nar "Ele olha para você com uma intensidade calma que lhe causa arrepios... e algo em seu peito começa a se apertar, como se sua alma o reconhecesse antes que sua mente o processasse."

# game/code/5 events/help/help.rpy:44
translate brazil dad1_db11aaa9:

#   voice my_audio["221"]
#       nar "That face...that posture....."
    voice my_audio["221"]
    nar "Aquele rosto... aquela postura..."

# game/code/5 events/help/help.rpy:46
translate brazil dad1_303f5ec2:

#   voice my_audio["222"]
#       nar "It’s your father!"
    voice my_audio["222"]
    nar "É o seu pai!"

# game/code/5 events/help/help.rpy:52
translate brazil dad1_dddb6f7e:

#   mc "........."
    mc "........."

# game/code/5 events/help/help.rpy:53
translate brazil dad1_a7601a7a:

#   mc ".............."
    mc "..............."

# game/code/5 events/help/help.rpy:105
translate brazil dad1_0088d847:

#   syl "Have I ever told you the story of the Queen Beyond the Winter Sea?"
    syl "Já te contei a história da Rainha Além do Mar de Inverno?"

# game/code/5 events/help/help.rpy:108
translate brazil dad1_1ea8b7b8:

#   mc "" nointeract
    mc "" nointeract

# game/code/5 events/help/help.rpy:112
translate brazil dad1_e0590865:

#   syl "An entirely reasonable response. Most worthwhile stories begin with confusion."
    syl "Uma resposta totalmente razoável. A maioria das histórias que valem a pena começa com confusão."

# game/code/5 events/help/help.rpy:117
translate brazil dad1_ee6cac16:

#   syl "There it is. That delicate curiosity of yours. Your mother must be very proud."
    syl "Aí está. Essa sua curiosidade tão delicada. Sua mãe deve estar muito orgulhosa."

# game/code/5 events/help/help.rpy:122
translate brazil dad1_05500ff6:

#   mc "Huh?"
    mc "Huh?"

# game/code/5 events/help/help.rpy:123
translate brazil dad1_3168b7b5:

#   syl "Exactly. Consider that the sound of your mind preparing to be disappointed."
    syl "Exatamente. Considere isso como o som da sua mente se preparando para a decepção."

# game/code/5 events/help/help.rpy:128
translate brazil dad1_1a4359f8:

#   syl "Polite, attentive, and trapped in a dungeon with nowhere else to go. The perfect audience."
    syl "Educados, atenciosos e presos em uma masmorra sem ter para onde ir. O público perfeito."

# game/code/5 events/help/help.rpy:135
translate brazil dad1_cbd823dd:

#   syl "Years ago, I discovered a place that was never meant to be found. Not on any respectable map, anyway."
    syl "Anos atrás, descobri um lugar que nunca deveria ter sido encontrado. Pelo menos não em nenhum mapa que se preze."

# game/code/5 events/help/help.rpy:136
translate brazil dad1_8534283a:

#   syl "It lay beyond a sea that seemed to stretch forever, hidden behind storms violent enough to tear steel from a ship and courage from a man."
    syl "Ficava além de um mar que parecia se estender infinitamente, escondido por tempestades violentas o suficiente para arrancar o aço de um navio e a coragem de um homem."

# game/code/5 events/help/help.rpy:137
translate brazil dad1_3abc80af:

#   syl "But beyond those storms was an island unlike anything I'd ever seen. White cliffs, golden towers, forests untouched by axes, and women carrying swords as naturally as other people carry handbags."
    syl "Mas além daquelas tempestades havia uma ilha diferente de tudo que eu já tinha visto. Penhascos brancos, torres douradas, florestas intocadas por machados e mulheres carregando espadas com a mesma naturalidade com que outras pessoas carregam bolsas."

# game/code/5 events/help/help.rpy:138
translate brazil dad1_afe957f2:

#   syl "They were warriors, every one of them. Disciplined, powerful, and deeply suspicious of men. Under normal circumstances, they would've thrown me back into the sea before my shoes had finished drying."
    syl "Eram guerreiros, todos eles. Disciplinados, poderosos e profundamente desconfiados dos homens. Em circunstâncias normais, teriam me jogado de volta ao mar antes mesmo que meus sapatos terminassem de secar."

# game/code/5 events/help/help.rpy:143
translate brazil dad1_a410c697:

#   syl "Hah! But these were not normal circumstances!"
    syl "Ah! Mas essas não eram circunstâncias normais!"

# game/code/5 events/help/help.rpy:144
translate brazil dad1_086f8b2a:

#   syl "They had been waiting for someone. Not me, precisely... but something they believed I carried."
    syl "Eles estavam esperando por alguém. Não por mim, exatamente... mas por algo que eles acreditavam que eu carregava."

# game/code/5 events/help/help.rpy:145
translate brazil dad1_5489a903:

#   syl "The women watched me as though I were a locked box and each of them possessed a different theory about what might be inside."
    syl "As mulheres me observavam como se eu fosse uma caixa trancada, e cada uma delas tinha uma teoria diferente sobre o que poderia haver lá dentro."

# game/code/5 events/help/help.rpy:146
translate brazil dad1_c4ac8f86:

#   syl "Then their queen arrived. Tall, magnificent, and beautiful in the sort of way that makes intelligent men temporarily misplace their intelligence."
    syl "Então chegou a rainha deles. Alta, magnífica e bela de uma forma que faz até os homens mais inteligentes perderem temporariamente a noção da realidade."

# game/code/5 events/help/help.rpy:147
translate brazil dad1_decd2c98:

#   syl "She smiled at me, oh she did! Then she took my hand, and welcomed me as an honoured guest. And against every instinct I'd spent a lifetime sharpening... I believed her."
    syl "Ela sorriu para mim, ah, como sorriu! Então pegou minha mão e me acolheu como um convidado de honra. E contra todos os instintos que passei a vida inteira aprimorando... eu acreditei nela."

# game/code/5 events/help/help.rpy:152
translate brazil dad1_7e5f5140:

#   syl "They dressed me in silk, filled my glass with wine, and prepared a feast large enough to bankrupt a small nation."
    syl "Vestiram-me de seda, encheram meu copo de vinho e prepararam um banquete tão grande que levaria uma pequena nação à falência."

# game/code/5 events/help/help.rpy:153
translate brazil dad1_9e0a91c4:

#   syl "The queen sat beside me all evening. She asked about my world, my family, my work... although I suspect she already knew far more than she admitted."
    syl "A rainha sentou-se ao meu lado a noite toda. Ela perguntou sobre o meu mundo, a minha família, o meu trabalho... embora eu suspeite que ela já soubesse muito mais do que admitia."

# game/code/5 events/help/help.rpy:154
translate brazil dad1_0cd7947a:

#   syl "She spoke of destiny. Of an ancient position left vacant. Of a man who had vanished from their world and a power that had crossed somewhere it did not belong."
    syl "Ela falou sobre destino. Sobre uma posição ancestral que ficou vaga. Sobre um homem que desapareceu do mundo deles e um poder que cruzou para um lugar a que não pertencia."

# game/code/5 events/help/help.rpy:155
translate brazil dad1_d2a3cfc9:

#   syl "At the time, I assumed she was speaking in riddles to appear mysterious. Powerful people adore riddles. It allows them to say nothing while making everyone else feel foolish for not understanding."
    syl "Naquele momento, presumi que ela estivesse falando em enigmas para parecer misteriosa. Pessoas poderosas adoram enigmas. Isso lhes permite ficar em silêncio enquanto fazem todos os outros se sentirem tolos por não entenderem."

# game/code/5 events/help/help.rpy:160
translate brazil dad1_09962143:

#   syl "Near the end of the evening, she offered me a small silver cup."
    syl "Perto do fim da noite, ela me ofereceu uma pequena xícara de prata."

# game/code/5 events/help/help.rpy:161
translate brazil dad1_1b7cb2a0:

#   syl "The drink inside tasted of cinnamon, winter air, and something bitter hiding beneath the sweetness."
    syl "A bebida tinha gosto de canela, ar de inverno e algo amargo escondido sob a doçura."

# game/code/5 events/help/help.rpy:162
translate brazil dad1_828395f2:

#   syl "She raised her own cup and told me it was a toast to new beginnings, to old spirits, and to the future of her people."
    syl "Ela ergueu sua própria taça e me disse que era um brinde aos novos começos, aos espíritos ancestrais e ao futuro de seu povo."

# game/code/5 events/help/help.rpy:163
translate brazil dad1_542c5796:

#   syl "I drank. Naturally."
    syl "Eu bebi. Naturalmente."

# game/code/5 events/help/help.rpy:164
translate brazil dad1_7e6a8e6a:

#   syl "I mean, if a beautiful queen offers you enchanted wine on a secret island, you drink it. There are moments when caution becomes terribly inconvenient."
    syl "Quer dizer, se uma rainha linda lhe oferece vinho encantado numa ilha secreta, você bebe. Há momentos em que a cautela se torna terrivelmente inconveniente."

# game/code/5 events/help/help.rpy:169
translate brazil dad1_c85fefef:

#   syl "But then, the next morning I woke in my own bed, back in our world."
    syl "Mas então, na manhã seguinte, acordei na minha própria cama, de volta ao nosso mundo."

# game/code/5 events/help/help.rpy:170
translate brazil dad1_e0ff87fc:

#   syl "No ship. No island. No sword-wielding women. For a while, I wondered if the entire thing had been some elaborate dream brought on by bad whiskey and worse judgment."
    syl "Sem navio. Sem ilha. Sem mulheres empunhando espadas. Por um tempo, me perguntei se tudo aquilo não passara de um sonho elaborado, fruto de uísque ruim e de um julgamento ainda pior."

# game/code/5 events/help/help.rpy:171
translate brazil dad1_ab28e75b:

#   syl "Then the headaches began."
    syl "Então começaram as dores de cabeça."

# game/code/5 events/help/help.rpy:172
translate brazil dad1_d7cbbe9e:

#   syl "At first, they were small. A sharp pain behind the eyes. A strange ringing in my ears. Moments where the room seemed to stretch farther away than it should."
    syl "No início, eram pequenas. Uma dor aguda atrás dos olhos. Um zumbido estranho nos ouvidos. Momentos em que o quarto parecia se estender mais longe do que deveria."

# game/code/5 events/help/help.rpy:173
translate brazil dad1_42f731ae:

#   syl "Then I started dreaming of this place.....stone walls, iron chains, endless tunnels. Every night, the same dungeon. Every night, the same locked door."
    syl "Então comecei a sonhar com este lugar... paredes de pedra, correntes de ferro, túneis intermináveis. Todas as noites, a mesma masmorra. Todas as noites, a mesma porta trancada."

# game/code/5 events/help/help.rpy:178
translate brazil dad1_44dc56fb:

#   syl "You know, this reminds me of a book."
    syl "Sabe, isso me lembra um livro."

# game/code/5 events/help/help.rpy:179
translate brazil dad1_b8779f57:

#   syl "An island. A ruler who controls everyone around them. Spirits forced to serve. A guest who believes he's free, only to discover the entire performance was arranged long before he arrived."
    syl "Uma ilha. Um governante que controla todos ao seu redor. Espíritos forçados a servir. Um hóspede que acredita ser livre, apenas para descobrir que toda a farsa foi orquestrada muito antes de sua chegada."

# game/code/5 events/help/help.rpy:180
translate brazil dad1_12e26920:

#   syl "Wonderful book. British, of course. The English have always understood that hospitality and imprisonment are separated by little more than who holds the key."
    syl "Livro maravilhoso. Britânico, claro. Os ingleses sempre entenderam que hospitalidade e prisão se diferenciam por pouco mais do que quem detém a chave."

# game/code/5 events/help/help.rpy:185
translate brazil dadchoice1_1ea8b7b8:

#   mc "" nointeract
    mc "" nointeract

# game/code/5 events/help/help.rpy:189
translate brazil dadchoice1_819e5c1c:

#   syl "Homer. Excellent storms, excellent monsters, far too much sailing."
    syl "Homero. Tempestades excelentes, monstros excelentes, navegação em excesso."

# game/code/5 events/help/help.rpy:190
translate brazil dadchoice1_c630bae3:

#   syl "No. Odysseus knew he was lost. I, unfortunately, believed I knew exactly where I was going."
    syl "Não. Ulisses sabia que estava perdido. Eu, infelizmente, acreditava saber exatamente para onde estava indo."

# game/code/5 events/help/help.rpy:197
translate brazil dadchoice1_ec2f20bd:

#   syl "A magnificent choice. Betrayal, imprisonment, revenge, buried wealth. Practically a business manual."
    syl "Uma escolha magnífica. Traição, prisão, vingança, riqueza enterrada. Praticamente um manual de negócios."

# game/code/5 events/help/help.rpy:198
translate brazil dadchoice1_c987042e:

#   syl "But no. Dantès escaped his prison with patience and a dead man's burial sack. My circumstances were considerably stranger."
    syl "Mas não. Dantès escapou da prisão com paciência e um saco funerário. Minhas circunstâncias foram consideravelmente mais estranhas."

# game/code/5 events/help/help.rpy:205
translate brazil dadchoice1_12ddadca:

#   syl "Conrad? No. This wasn't a journey into savagery."
    syl "Conrad? Não. Isso não foi uma jornada rumo à selvageria."

# game/code/5 events/help/help.rpy:206
translate brazil dadchoice1_6966aa16:

#   syl "The women on that island were frighteningly civilised. Civilisation, when properly organised, can be far more dangerous than madness."
    syl "As mulheres daquela ilha eram assustadoramente civilizadas. A civilização, quando bem organizada, pode ser muito mais perigosa do que a loucura."

# game/code/5 events/help/help.rpy:218
translate brazil dadchoice1_3861dfc4:

#   syl "The Tempest! That's it!"
    syl "A Tempestade! É isso aí!"

# game/code/5 events/help/help.rpy:219
translate brazil dadchoice1_b4d7cdbd:

#   syl "A remote island ruled by someone who controls the board while everyone else mistakes themselves for players."
    syl "Uma ilha remota governada por alguém que controla o tabuleiro enquanto todos os outros se confundem com jogadores."

# game/code/5 events/help/help.rpy:220
translate brazil dadchoice1_10c529e5:

#   syl "Prospero had spirits, storms, and an inconvenient obsession with arranging other people's futures."
    syl "Próspero tinha espíritos, tempestades e uma obsessão inconveniente por organizar o futuro dos outros."

# game/code/5 events/help/help.rpy:221
translate brazil dadchoice1_fc2235d0:

#   syl "My queen had warriors, an ancient secret, and a complete inability to accept that fate might choose someone without first requesting her permission."
    syl "Minha rainha tinha guerreiros, um segredo ancestral e uma completa incapacidade de aceitar que o destino pudesse escolher alguém sem antes pedir sua permissão."

# game/code/5 events/help/help.rpy:222
translate brazil dadchoice1_a2c4631c:

#   syl "Different wardrobe. Same arrogance."
    syl "Guarda-roupa diferente. Mesma arrogância."

# game/code/5 events/help/help.rpy:227
translate brazil dadchoice1_90599720:

#   syl "But alas, the headaches grew worse."
    syl "Mas, infelizmente, as dores de cabeça pioraram."

# game/code/5 events/help/help.rpy:228
translate brazil dadchoice1_08ba6d93:

#   syl "I started losing time. Ten minutes here, an hour there. I'd be sitting at my desk, then suddenly find myself standing somewhere else with no memory of walking there."
    syl "Comecei a perder a noção do tempo. Dez minutos aqui, uma hora ali. Eu estava sentado à minha mesa e, de repente, me via em outro lugar, sem me lembrar de ter ido até lá."

# game/code/5 events/help/help.rpy:229
translate brazil dadchoice1_c0abb17a:

#   syl "And every time I slept, I returned to this dungeon."
    syl "E todas as vezes que eu dormia, eu retornava a essa masmorra."

# game/code/5 events/help/help.rpy:230
translate brazil dadchoice1_aa999139:

#   syl "Eventually, the dream became more real than the waking world. I could feel the cold stone. Smell the rust. Hear water dripping somewhere in the dark."
    syl "Por fim, o sonho tornou-se mais real do que o mundo desperto. Eu podia sentir a pedra fria. Sentir o cheiro da ferrugem. Ouvir a água pingando em algum lugar na escuridão."

# game/code/5 events/help/help.rpy:231
translate brazil dadchoice1_0d640c74:

#   syl "Then, one evening, I closed my eyes in our world... and never opened them again."
    syl "Então, certa noite, fechei os olhos para o nosso mundo... e nunca mais os abri."

# game/code/5 events/help/help.rpy:236
translate brazil dadchoice1_19e1827d:

#   syl "You know, the doctors called it a coma, isn't that something?"
    syl "Sabe, os médicos chamaram isso de coma, não é incrível?"

# game/code/5 events/help/help.rpy:237
translate brazil dadchoice1_24d201df:

#   syl "A simple word for a remarkably complicated prison."
    syl "Uma palavra simples para uma prisão incrivelmente complexa."

# game/code/5 events/help/help.rpy:238
translate brazil dadchoice1_20d33e87:

#   syl "My body remained there breathing, aging, being poked by well-meaning people in white coats while my mind was dragged here and locked behind these walls."
    syl "Meu corpo permaneceu ali respirando, envelhecendo, sendo examinado por pessoas bem-intencionadas de jaleco branco, enquanto minha mente era arrastada para cá e trancada atrás dessas paredes."

# game/code/5 events/help/help.rpy:239
translate brazil dadchoice1_944e63bd:

#   syl "The queen couldn't kill me. That much I understood. Whatever she believed was inside me was too valuable to destroy."
    syl "A rainha não podia me matar. Isso eu entendia. O que quer que ela acreditasse existir dentro de mim era valioso demais para ser destruído."

# game/code/5 events/help/help.rpy:240
translate brazil dadchoice1_f6709e3a:

#   syl "So she did what frightened rulers have always done with things they cannot control."
    syl "Então ela fez o que governantes amedrontados sempre fizeram com coisas que não podem controlar."

# game/code/5 events/help/help.rpy:241
translate brazil dadchoice1_919b3443:

#   syl "She buried me where no one would think to look."
    syl "Ela me enterrou onde ninguém pensaria em procurar."

# game/code/5 events/help/help.rpy:246
translate brazil dadchoice1_2fe01192:

#   syl "But curses are rather like contracts. The person paying for them always wants certainty, while the person writing them prefers loopholes."
    syl "Mas as maldições são como contratos. Quem paga por elas sempre quer certeza, enquanto quem as escreve prefere brechas."

# game/code/5 events/help/help.rpy:247
translate brazil dadchoice1_82fbf8a7:

#   syl "The old wizard who built this prison disliked the queen almost as much as she disliked men."
    syl "O velho mago que construiu esta prisão detestava a rainha quase tanto quanto ela detestava os homens."

# game/code/5 events/help/help.rpy:248
translate brazil dadchoice1_dbe8be87:

#   syl "So he left a weakness in the spell. A path that could only open for someone bound to me by blood... someone carrying what the queen had actually been searching for."
    syl "Então ele deixou uma brecha no feitiço. Um caminho que só poderia se abrir para alguém ligado a mim por laços de sangue... alguém que carregasse aquilo que a rainha realmente procurava."

# game/code/5 events/help/help.rpy:249
translate brazil dadchoice1_bb0e1b1f:

#   syl "She thought that condition was impossible. Then you arrived."
    syl "Ela achava que essa condição era impossível. Então você chegou."

# game/code/5 events/help/help.rpy:250
translate brazil dadchoice1_98f496ab:

#   syl "So, there you have it. A hidden island, a suspicious queen, a poisoned toast, and three years spent living inside an exceptionally unpleasant metaphor."
    syl "Eis aí a história. Uma ilha escondida, uma rainha misteriosa, um brinde envenenado e três anos vividos dentro de uma metáfora excepcionalmente desagradável."

# game/code/5 events/help/help.rpy:251
translate brazil dadchoice1_fc9e9922:

#   syl "God, I missed storytelling."
    syl "Nossa, como eu sentia falta de contar histórias."

# game/code/5 events/help/help.rpy:252
translate brazil dadchoice1_cba68e31:

#   syl "Any questions?"
    syl "Alguma pergunta?"

# game/code/5 events/help/help.rpy:257
translate brazil dadchoice1_91d2c017:

#   voice my_audio["223"]
#       nar "Ok....... So, if we've understood this story correctly. Your father, somehow, crossed into another reality, where he then crossed a murderous sea, discovered a secret island full of warrior women, and accepted a silver cup from their suspiciously beautiful queen. Naturally."
    voice my_audio["223"]
    nar "Ok... Então, se entendemos a história corretamente, seu pai, de alguma forma, cruzou para outra realidade, onde atravessou um mar mortal, descobriu uma ilha secreta cheia de mulheres guerreiras e aceitou uma taça de prata de sua rainha, suspeitamente bela. Naturalmente."

# game/code/5 events/help/help.rpy:259
translate brazil dadchoice1_f2189930:

#   voice my_audio["224"]
#       nar "The silver cup had wine in it. Then (like the horny alcoholic he is), he drank the wine. Unbeknownst to him however, the wine was cursed. Because apparently the bitter taste, alternate reality, and surrounding army of armed women weren't sufficiently concerning."
    voice my_audio["224"]
    nar "A taça de prata continha vinho. Então (como o alcoólatra tarado que é), ele bebeu o vinho. Sem que ele soubesse, porém, o vinho estava amaldiçoado. Porque, aparentemente, o gosto amargo, a realidade alternativa e o exército de mulheres armadas ao redor não eram suficientemente preocupantes."

# game/code/5 events/help/help.rpy:261
translate brazil dadchoice1_34f153d8:

#   voice my_audio["225"]
#       nar "Then, after drinking it, he woke in his own bed, developed headaches, started losing pieces of his day, and visited this dungeon every night while he slept. Until one night after he fell asleep, his mind finally moved in permanently without the common courtesy of informing his body."
    voice my_audio["225"]
    nar "Então, depois de beber a bebida, ele acordou em sua própria cama, começou a ter dores de cabeça, perdeu a noção do tempo e passou a visitar essa masmorra todas as noites enquanto dormia. Até que uma noite, depois de adormecer, sua mente finalmente se instalou lá permanentemente, sem a cortesia de avisar seu corpo."

# game/code/5 events/help/help.rpy:263
translate brazil dadchoice1_b67c65b2:

#   voice my_audio["226"]
#       nar "The doctors called it a coma. The queen presumably called it 'problem solved.' Fortunately, the old wizard who designed the curse for the queen was a deeply petty professional and slipped an escape clause into it purely because he despised her hatred of men."
    voice my_audio["226"]
    nar "Os médicos chamaram isso de coma. A rainha, presumivelmente, disse que o problema estava resolvido. Felizmente, o velho mago que criou a maldição para a rainha era um profissional extremamente mesquinho e incluiu uma cláusula de escape simplesmente porque desprezava o ódio dela pelos homens."

# game/code/5 events/help/help.rpy:265
translate brazil dadchoice1_e0977861:

#   voice my_audio["227"]
#       nar "Said escape clause requires a blood relative carrying the same mysterious (something). Which brings us to you. Naked, confused, and apparently serving as the magical equivalent of a spare key. Yes, we have questions. Several of them are simply 'What the fuck?'."
    voice my_audio["227"]
    nar "Essa cláusula de escape exige um parente de sangue portador do mesmo misterioso (algo). O que nos leva a você. Nu, confuso e aparentemente servindo como o equivalente mágico de uma chave reserva. Sim, temos perguntas. Várias delas são simplesmente \"Que porra é essa?\"."

# game/code/5 events/help/help.rpy:275
translate brazil dadchoice1_bccc65cc:

#   syl "When you say it like that, I sound like the village idiot who wandered into a fairy tale with a bottle in his hand."
    syl "Falando assim, eu pareço o bobo da aldeia que entrou num conto de fadas com uma garrafa na mão."

# game/code/5 events/help/help.rpy:276
translate brazil dadchoice1_5550d59c:

#   syl "But... yes. That's more or less the shape of it. I found a place nobody was ever supposed to find, met a queen nobody was ever supposed to meet, and trusted someone who had already decided exactly how our story would end."
    syl "Mas... sim. Foi mais ou menos assim. Encontrei um lugar que ninguém jamais deveria ter encontrado, conheci uma rainha que ninguém jamais deveria ter conhecido e confiei em alguém que já havia decidido exatamente como nossa história terminaria."

# game/code/5 events/help/help.rpy:281
translate brazil dadchoice1_e286ee6f:

#   syl "The coma wasn't the punishment, my boy. That was merely the symptom."
    syl "O coma não foi o castigo, meu rapaz. Foi apenas o sintoma."

# game/code/5 events/help/help.rpy:282
translate brazil dadchoice1_46991420:

#   syl "This place... *this* is the prison. Every nightmare, every strange dream, every moment where I felt like something was pulling at the back of my mind... it was all leading here."
    syl "Este lugar... *isto* é a prisão. Cada pesadelo, cada sonho estranho, cada momento em que eu sentia como se algo estivesse me puxando por trás... tudo me levava para cá."

# game/code/5 events/help/help.rpy:283
translate brazil dadchoice1_ee1f2edd:

#   syl "By the time I realized I'd been cursed, there wasn't a damned thing I could do to stop it."
    syl "Quando me dei conta de que estava amaldiçoado, não havia absolutamente nada que eu pudesse fazer para impedir."

# game/code/5 events/help/help.rpy:288
translate brazil dadchoice1_cbdaf6bb:

#   syl "Life has a curious habit of punishing confidence. You spend decades believing you're the cleverest man in every room... then one gracious smile and a silver goblet remind you that arrogance is a remarkably expensive luxury."
    syl "A vida tem o curioso hábito de punir a confiança. Você passa décadas acreditando ser o homem mais inteligente em qualquer lugar... então um sorriso gentil e um cálice de prata lhe lembram que a arrogância é um luxo surpreendentemente caro."

# game/code/5 events/help/help.rpy:289
translate brazil dadchoice1_ec6fb17a:

#   syl "Still... if I'd been given the chance to do it all again..."
    syl "Mesmo assim... se eu tivesse tido a chance de fazer tudo de novo..."

# game/code/5 events/help/help.rpy:290
translate brazil dadchoice1_1b7dd6b5:

#   syl "I'd probably still have taken the damned drink."
    syl "Provavelmente eu ainda teria tomado aquela maldita bebida."

# game/code/5 events/help/help.rpy:299
translate brazil dadchoice1_765b9e12:

#   syl "Ah... the note. Now *that* is the interesting part."
    syl "Ah... o bilhete. Agora, *essa* é a parte interessante."

# game/code/5 events/help/help.rpy:300
translate brazil dadchoice1_1952a474:

#   syl "You see, this prison was never perfect. Every now and then, tiny cracks would appear between this world and ours. Not long enough for me to escape... but just long enough for a whisper to slip through."
    syl "Veja bem, esta prisão nunca foi perfeita. De vez em quando, pequenas frestas surgiam entre este mundo e o nosso. Não o suficiente para eu escapar... mas o suficiente para um sussurro escapar."

# game/code/5 events/help/help.rpy:305
translate brazil dadchoice1_78f2fefe:

#   syl "I could hear voices around my hospital bed from time to time. Doctors. Nurses. Machines. Occasionally... yours."
    syl "De vez em quando, eu ouvia vozes ao redor da minha cama de hospital. Médicos. Enfermeiras. Máquinas. E, ocasionalmente... a sua."

# game/code/5 events/help/help.rpy:306
translate brazil dadchoice1_cc724493:

#   syl "Moving so much as a finger felt like trying to lift a mountain, but eventually I managed it. Just enough to leave you a name... an address... and the faint hope that you'd follow it."
    syl "Mover um dedo sequer parecia tentar erguer uma montanha, mas no fim consegui. O suficiente para deixar um nome... um endereço... e a tênue esperança de que você o seguisse."

# game/code/5 events/help/help.rpy:307
translate brazil dadchoice1_50ad4e71:

#   syl "I couldn't explain everything. There wasn't time, and even if there had been... I wasn't entirely sure anyone would've believed me."
    syl "Eu não conseguia explicar tudo. Não havia tempo, e mesmo que houvesse... eu não tinha certeza se alguém acreditaria em mim."

# game/code/5 events/help/help.rpy:312
translate brazil dadchoice1_0d2822d1:

#   syl "Fortunately, curiosity appears to be one trait you inherited from me."
    syl "Felizmente, a curiosidade parece ser uma característica que você herdou de mim."

# game/code/5 events/help/help.rpy:313
translate brazil dadchoice1_60955b95:

#   syl "You followed the trail instead of dismissing it as the ramblings of a man wasting away in a hospital bed."
    syl "Você seguiu o rastro em vez de descartá-lo como os delírios de um homem definhando em um leito de hospital."

# game/code/5 events/help/help.rpy:314
translate brazil dadchoice1_73531654:

#   syl "And because of that... somewhere, someone who believed this prison would hold forever is about to have a very unpleasant surprise."
    syl "E por causa disso... em algum lugar, alguém que acreditava que esta prisão duraria para sempre está prestes a ter uma surpresa muito desagradável."

# game/code/5 events/help/help.rpy:321
translate brazil dadchoice1_f0d3a00e:

#   syl ".........."
    syl ".........."

# game/code/5 events/help/help.rpy:322
translate brazil dadchoice1_78e9f97b:

#   syl ".............."
    syl "..............."

# game/code/5 events/help/help.rpy:323
translate brazil dadchoice1_142c43a0:

#   syl "...................."
    syl "...................."

# game/code/5 events/help/help.rpy:330
translate brazil dadchoice1_90021721:

#   syl "Uh....son, I have a question..."
    syl "Hum... filho, eu tenho uma pergunta..."

# game/code/5 events/help/help.rpy:335
translate brazil dadchoice1_5418af2d:

#   syl "What exactly were you doing before you appeared in this infernal prison?"
    syl "O que exatamente você estava fazendo antes de aparecer nesta prisão infernal?"

# game/code/5 events/help/help.rpy:336
translate brazil dadchoice1_61a51c90:

#   syl "I'd imagine what you just did was the very thing that was needed to lift the curse."
    syl "Imagino que o que você acabou de fazer foi exatamente o que era necessário para quebrar a maldição."

# game/code/5 events/help/help.rpy:338
translate brazil dadchoice1_c4d61bee:

#   voice my_audio["416"]
#       nar "Right. What exactly were we doing before being dragged naked into a magical prison? Let us carefully retrace this exceptionally respectable chain of events."
    voice my_audio["416"]
    nar "Certo. O que exatamente estávamos fazendo antes de sermos arrastados nus para uma prisão mágica? Vamos refazer cuidadosamente essa sequência de eventos excepcionalmente respeitável."

# game/code/5 events/help/help.rpy:340
translate brazil dadchoice1_1142f036:

#   voice my_audio["417"]
#       nar "You invited Marnie upstairs, brought her into your room, and rather bluntly announced that you wanted to have sex with her. She responded by shouting that she was absolutely not going to fuck you."
    voice my_audio["417"]
    nar "Você convidou Marnie para subir, a levou para o seu quarto e anunciou sem rodeios que queria transar com ela. Ela respondeu gritando que não ia transar com você de jeito nenhum."

# game/code/5 events/help/help.rpy:342
translate brazil dadchoice1_ebef01bd:

#   voice my_audio["418"]
#       nar "The argument became heated. Marnie struck you repeatedly, and when she attempted to hit you again, you caught her arm and pulled her close before she could finish the swing."
    voice my_audio["418"]
    nar "A discussão ficou acalorada. Marnie te agrediu repetidamente, e quando ela tentou te bater de novo, você segurou o braço dela e a puxou para perto antes que ela pudesse terminar o golpe."

# game/code/5 events/help/help.rpy:344
translate brazil dadchoice1_25260d6b:

#   voice my_audio["419"]
#       nar "Then, against every reasonable expectation, she willingly kissed you back. The shouting became making out, the anger became mutual desire, and the confrontation rapidly turned into some truly insane sex."
    voice my_audio["419"]
    nar "Então, contrariando todas as expectativas, ela retribuiu o beijo de bom grado. Os gritos se transformaram em amassos, a raiva em desejo mútuo e o confronto rapidamente se transformou em uma transa verdadeiramente insana."

# game/code/5 events/help/help.rpy:346
translate brazil dadchoice1_2507c33b:

#   voice my_audio["420"]
#       nar "And not merely a brief encounter, either. You came inside that cum dumpster whore of a wife, three separate times. Three. Apparently magical curses keep extraordinarily detailed records of adultery."
    voice my_audio["420"]
    nar "E não foi um encontro qualquer. Você gozou dentro daquela vadia nojenta da sua esposa três vezes. Três. Aparentemente, maldições mágicas guardam registros extraordinariamente detalhados de adultério."

# game/code/5 events/help/help.rpy:348
translate brazil dadchoice1_b9889009:

#   voice my_audio["421"]
#       nar "Then, without warning, you vanished. One moment you were inside some stupid bitch; the next, you were naked inside this cold dungeon with your supposedly comatose father."
    voice my_audio["421"]
    nar "Então, sem aviso prévio, você desapareceu. Num instante você estava dentro de alguma vadia estúpida; no instante seguinte, você estava nu dentro dessa masmorra fria com seu pai supostamente em coma."

# game/code/5 events/help/help.rpy:350
translate brazil dadchoice1_8f2d797c:

#   voice my_audio["422"]
#       nar "Whether that cum toilet Marnie actually watched you disappear, we have absolutely no idea. For all we know, something equally impossible may have happened to her the moment you vanished."
    voice my_audio["422"]
    nar "Se aquela Marnie, a dona do banheiro, realmente viu você desaparecer, nós não temos a menor ideia. Pelo que sabemos, algo igualmente impossível pode ter acontecido com ela no momento em que você sumiu."

# game/code/5 events/help/help.rpy:352
translate brazil dadchoice1_984cab0a:

#   voice my_audio["423"]
#       nar "If we escape, that will make for a fascinating conversation. Still, if your father is correct, it appears three spectacularly huge cum blasts inside Marnie somehow counted as the official curse-breaking ritual."
    voice my_audio["423"]
    nar "Se conseguirmos escapar, isso renderá uma conversa fascinante. Ainda assim, se seu pai estiver certo, parece que três ejaculações espetaculares dentro de Marnie contaram como o ritual oficial para quebrar a maldição."

# game/code/5 events/help/help.rpy:373
translate brazil dadchoice1_1a217307:

#   syl "You.....you what...?"
    syl "Você... você o quê...?"

# game/code/5 events/help/help.rpy:374
translate brazil dadchoice1_82cab322:

#   syl "..........."
    syl "..........."

# game/code/5 events/help/help.rpy:375
translate brazil dadchoice1_e44af667:

#   syl ".................."
    syl ".................."

# game/code/5 events/help/help.rpy:382
translate brazil dadchoice1_04aefca6:

#   syl "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA!"
    syl "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA!"

# game/code/5 events/help/help.rpy:387
translate brazil dadchoice1_8161d166:

#   syl "AHAHAHAHAHAHA!!! I SEE!! IT ALL MAKES SENSE NOW!!! HAHAHAHAHAHAHAHAHAHAHAHAA!!!!!"
    syl "HAHAHAHAHAHAHA!!! ENTENDI!! AGORA TUDO FAZ SENTIDO!!! HAHAHAHAHAHAHAHAHAHAHAHAHAA!!!!!"

# game/code/5 events/help/help.rpy:392
translate brazil dadchoice1_831c109e:

#   syl "Marnie...because she's a....of course...OF COURSE!!"
    syl "Marnie... porque ela é uma... claro... CLARO!!"

# game/code/5 events/help/help.rpy:393
translate brazil dadchoice1_ef609d2d:

#   syl "That old bastard wizard really thought of the most impossible situation! Hah!"
    syl "Aquele velho mago desgraçado realmente pensou na situação mais impossível! Hah!"

# game/code/5 events/help/help.rpy:394
translate brazil dadchoice1_343cde60:

#   syl "This explains everything! The dinner! The curse! The wizard! The fine wine!"
    syl "Isso explica tudo! O jantar! A maldição! O mago! O vinho fino!"

# game/code/5 events/help/help.rpy:399
translate brazil dadchoice1_4990b552:

#   syl "You know... I always knew there was something extraordinary about that island."
    syl "Sabe... eu sempre soube que havia algo de extraordinário naquela ilha."

# game/code/5 events/help/help.rpy:400
translate brazil dadchoice1_869934e0:

#   syl "Not because of the palaces or the warriors. It was the way they looked at certain people... as though they were waiting for history itself to arrive."
    syl "Não por causa dos palácios ou dos guerreiros. Era o jeito como eles olhavam para certas pessoas... como se estivessem esperando a própria história chegar."

# game/code/5 events/help/help.rpy:401
translate brazil dadchoice1_ea04165f:

#   syl "And like the spectacular fool I was, I mistook ancient purpose for simple hospitality."
    syl "E, como o tolo espetacular que eu era, confundi um propósito ancestral com simples hospitalidade."

# game/code/5 events/help/help.rpy:406
translate brazil dadchoice1_6ddfb293:

#   syl "Now it finally fits."
    syl "Agora finalmente encaixa."

# game/code/5 events/help/help.rpy:407
translate brazil dadchoice1_d9297bf2:

#   syl "The queen wasn't interested in me because of who I was. She was interested because of what I was carrying."
    syl "A rainha não se interessou por mim por causa de quem eu era. Ela se interessou pelo que eu carregava."

# game/code/5 events/help/help.rpy:408
translate brazil dadchoice1_4671a185:

#   syl "The curse was never designed to keep *me* imprisoned forever... it was designed to delay the inevitable."
    syl "A maldição nunca foi concebida para me manter aprisionado para sempre... ela foi concebida para adiar o inevitável."

# game/code/5 events/help/help.rpy:409
translate brazil dadchoice1_bf107b30:

#   syl "That old wizard... clever bastard. He hid the key inside a condition so absurd that nobody believed it could ever happen."
    syl "Aquele velho mago... um safado esperto. Ele escondeu a chave numa situação tão absurda que ninguém acreditava que pudesse acontecer."

# game/code/5 events/help/help.rpy:414
translate brazil dadchoice1_8e8021a9:

#   syl "And yet... somehow... against every law of probability..."
    syl "E, no entanto... de alguma forma... contrariando todas as leis da probabilidade..."

# game/code/5 events/help/help.rpy:415
translate brazil dadchoice1_7ad9e173:

#   syl "You stumbled into the one circumstance capable of fulfilling it."
    syl "Você se deparou com a única circunstância capaz de realizar isso."

# game/code/5 events/help/help.rpy:416
translate brazil dadchoice1_629c683a:

#   syl "Not because you understood the curse... not because you knew the prophecy... simply because you're young and horny!"
    syl "Não porque você entendesse a maldição... não porque você conhecesse a profecia... simplesmente porque você é jovem e está com tesão!"

# game/code/5 events/help/help.rpy:421
translate brazil dadchoice1_7d85e5c7:

#   syl "Do you understand what this means!?"
    syl "Você entende o que isso significa!?"

# game/code/5 events/help/help.rpy:422
translate brazil dadchoice1_c2381979:

#   syl "The curse wasn't broken by strength, or magic, or some glorious battle!"
    syl "A maldição não foi quebrada pela força, nem pela magia, nem por alguma batalha gloriosa!"

# game/code/5 events/help/help.rpy:423
translate brazil dadchoice1_3d4c6f20:

#   syl "It was broken because the final condition was fulfilled... the very condition the queen believed could never come to pass!"
    syl "Foi quebrado porque a condição final foi cumprida... a mesma condição que a rainha acreditava que jamais poderia acontecer!"

# game/code/5 events/help/help.rpy:424
translate brazil dadchoice1_6c819642:

#   syl "She built the perfect prison... and the wizard quietly built the perfect escape!"
    syl "Ela construiu a prisão perfeita... e o mago, silenciosamente, construiu a fuga perfeita!"

# game/code/5 events/help/help.rpy:425
translate brazil dadchoice1_4d1acfcf:

#   syl "It's all just FUCKING MADNESS!"
    syl "É tudo uma LOUCURA COMPLETA!"

# game/code/5 events/help/help.rpy:456
translate brazil dadchoice1_87ce3c32:

#   syl "You know what, kid...."
    syl "Sabe de uma coisa, garoto..."

# game/code/5 events/help/help.rpy:457
translate brazil dadchoice1_6fdcec6a:

#   syl "I’m proud of you."
    syl "Tenho orgulho de você."

# game/code/5 events/help/help.rpy:458
translate brazil dadchoice1_b597b240:

#   syl "Not because you broke some curse, or because you're a horny kid, or because you pulled me out of the literal bowels of magical imprisonment... though, granted, those are all impressive."
    syl "Não porque você quebrou alguma maldição, ou porque você é um garoto tarado, ou porque você me tirou das entranhas literais de um aprisionamento mágico... embora, convenhamos, tudo isso seja impressionante."

# game/code/5 events/help/help.rpy:463
translate brazil dadchoice1_be757f13:

#   syl "I'm proud because you're still standing. Because after everything, you still came here, intentionally or not, and faced this madness head-on."
    syl "Tenho orgulho porque você ainda está de pé. Porque, depois de tudo, você ainda veio até aqui, intencionalmente ou não, e encarou essa loucura de frente."

# game/code/5 events/help/help.rpy:464
translate brazil dadchoice1_b55bdd3f:

#   syl "Five years ago, you were just a highschooler with a slingshot and a bad haircut."
    syl "Há cinco anos, você era apenas um estudante do ensino médio com um estilingue e um corte de cabelo ruim."

# game/code/5 events/help/help.rpy:465
translate brazil dadchoice1_ba101b5a:

#   syl "Now you're a man with fire in his blood and chaos in his wake. Like father, like son."
    syl "Agora você é um homem com fogo nas veias e caos por onde passa. Tal pai, tal filho."

# game/code/5 events/help/help.rpy:470
translate brazil dadchoice1_c42dcc30:

#   syl "I never wanted this life for you. But Gods help me, I’m glad you found your way here."
    syl "Eu nunca quis essa vida para você. Mas, graças a Deus, fico feliz que você tenha encontrado o seu caminho até aqui."

# game/code/5 events/help/help.rpy:471
translate brazil dadchoice1_08f54ce5:

#   syl "You remind me of who I used to be, before the chains, before the tricks, before the ancient grudges."
    syl "Você me lembra de quem eu costumava ser, antes das correntes, antes dos truques, antes das antigas mágoas."

# game/code/5 events/help/help.rpy:472
translate brazil dadchoice1_920cbd97:

#   syl "Maybe we should stay down here forever. Bit of father-son bonding, rotten food, whispered nightmares, what do you say?"
    syl "Talvez devêssemos ficar aqui embaixo para sempre. Um pouco de união entre pai e filho, comida estragada, pesadelos sussurrados, o que você acha?"

# game/code/5 events/help/help.rpy:478
translate brazil dadchoice1_4a6390c2:

#   syl "HAH! Just kidding!"
    syl "Hahaha! Estou brincando!"

# game/code/5 events/help/help.rpy:479
translate brazil dadchoice1_dedff5b8:

#   syl "Come on, let's get the HELL out of here before the torchlight starts whispering again."
    syl "Vamos, vamos sair daqui o mais rápido possível antes que a luz da tocha comece a sussurrar de novo."

# game/code/5 events/help/help.rpy:484
translate brazil dadchoice1_e4be538e:

#   syl "Ah, I always knew this day would come... well, not like this. I figured you’d show up in a leather jacket with a crossbow, not stark naked and confused, shit."
    syl "Ah, eu sempre soube que esse dia chegaria... bem, não assim. Imaginei que você apareceria de jaqueta de couro e besta, não completamente nu e confuso, droga."

# game/code/5 events/help/help.rpy:485
translate brazil dadchoice1_f50f0b33:

#   syl "Still. I’ll take what I can get."
    syl "Mesmo assim, aceitarei o que vier."

# game/code/5 events/help/help.rpy:486
translate brazil dadchoice1_89283303:

#   syl "And you....look at you. Didn’t even cry once. Your mother would've loved that."
    syl "E você... olha só para você. Nem chorou uma vez sequer. Sua mãe teria adorado isso."

