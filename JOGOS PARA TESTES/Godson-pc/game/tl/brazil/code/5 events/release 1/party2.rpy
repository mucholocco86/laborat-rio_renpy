# game/code/5 events/release 1/party2.rpy:160
translate brazil theparty_d9ef4696:

#   my "You post up, check out the room, let the music hit, and see what kind of energy everybody's on."
    my "Você se posiciona, observa o ambiente, deixa a música tocar e vê que tipo de energia está rolando entre as pessoas."

# game/code/5 events/release 1/party2.rpy:161
