#   hen "Sir, please! Just give me a chance to explain! I swear this isn't what it looked like!"
    hen "Senhor, por favor! Me dê uma chance para explicar! Juro que não foi nada parecido com isso!"

# game/code/5 events/release 1/marnie2.rpy:4288
translate brazil henrytrouble_bc5e3fd2:

#   boss "SAVE YOUR ENERGY! Because you're going to need to while spending the next two months unloading trucks at Warehouse Seven!"
    boss "ECONOMIZE ENERGIA! Porque você vai precisar dela durante os próximos dois meses descarregando caminhões no Armazém Sete!"

# game/code/5 events/release 1/marnie2.rpy:4293
translate brazil henrytrouble_e76d99e9:

#   hen "TWO MONTHS!?"
    hen "DOIS MESES!?"

# game/code/5 events/release 1/marnie2.rpy:4294
