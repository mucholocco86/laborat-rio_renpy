translate brazil cor5_1fabcc30:

#   lor "Oh, you're quite forward, aren't you? But I'm not complaining."
    lor "Ah, você é bem atrevido, não é? Mas não estou reclamando."

# game/code/5 events/release 1/marnie2.rpy:1144
translate brazil cor5_476afd09:

#   lor "I do put in the effort to keep it....'fruitful', I'd say. It's nice to know it's appreciated."
    lor "Eu me esforço para mantê-la... 'produtiva', eu diria. É bom saber que isso é apreciado."

# game/code/5 events/release 1/marnie2.rpy:1145
