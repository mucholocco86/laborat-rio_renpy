    hen "..........."

# game/code/5 events/release 1/marnie2.rpy:4310
translate brazil henrytrouble_bacad8d6:

#   hen "Do you have any idea what you just did!?"
    hen "Você tem ideia do que acabou de fazer!?"

# game/code/5 events/release 1/marnie2.rpy:4311
translate brazil henrytrouble_a35d9ea8:

#   hen "You may have just cost me my job!"
    hen "Você pode ter acabado de me custar o emprego!"

# game/code/5 events/release 1/marnie2.rpy:4315
translate brazil henrytrouble_1ea8b7b8:

#   mc "" nointeract
    mc "" nointeract

# game/code/5 events/release 1/marnie2.rpy:4319
translate brazil henrytrouble_bf2b519e:

#   hen "Don't you dare turn this around on me!"
    hen "Não ouse inverter a situação comigo!"

# game/code/5 events/release 1/marnie2.rpy:4320
translate brazil henrytrouble_de48eb41:

#   hen "I asked you to look inside and tell me what was happening, not storm in there and blow up the entire interview!"
    hen "Eu pedi que você desse uma olhada lá dentro e me dissesse o que estava acontecendo, não que invadisse o local e arruinasse toda a entrevista!"

# game/code/5 events/release 1/marnie2.rpy:4321
translate brazil henrytrouble_f9bc3394:

#   hen "You took a bad situation and made it ten times worse!"
    hen "Você pegou uma situação ruim e a piorou dez vezes!"

# game/code/5 events/release 1/marnie2.rpy:4325
translate brazil henrytrouble_e77303bb:

#   hen "I know what I asked you to do!"
    hen "Eu sei o que te pedi para fazer!"

# game/code/5 events/release 1/marnie2.rpy:4326
translate brazil henrytrouble_1dff30b5:

#   hen "But I needed information, not a confrontation!"
    hen "Mas eu precisava de informação, não de confronto!"

# game/code/5 events/release 1/marnie2.rpy:4327
translate brazil henrytrouble_e9b20002:

#   hen "You should've come back and told me what you saw before everything spiraled out of control!"
    hen "Você deveria ter voltado e me contado o que viu antes que tudo saísse do controle!"

# game/code/5 events/release 1/marnie2.rpy:4331
translate brazil henrytrouble_6718ac01:

#   hen "Sure, and now I'm the one who has to deal with the consequences!"
    hen "Claro, e agora sou eu quem tem que lidar com as consequências!"

# game/code/5 events/release 1/marnie2.rpy:4332
translate brazil henrytrouble_90105a19:

#   hen "I was worried, yes, but that doesn't mean I wanted the entire situation to explode in my face!"
    hen "Sim, eu estava preocupada, mas isso não significa que eu queria que toda a situação explodisse na minha cara!"

# game/code/5 events/release 1/marnie2.rpy:4333
translate brazil henrytrouble_204dcab4:

#   hen "I needed you to help me understand what was happening, not make the decision for me!"
    hen "Eu precisava que você me ajudasse a entender o que estava acontecendo, não que tomasse a decisão por mim!"

# game/code/5 events/release 1/marnie2.rpy:4335
translate brazil henrytrouble_eed6e4d0:

#   hen "You know what? I can't do this right now."
    hen "Sabe de uma coisa? Não posso fazer isso agora."

# game/code/5 events/release 1/marnie2.rpy:4336
translate brazil henrytrouble_2d8a6d33:

#   hen "I need some space before I say something I'm going to regret."
    hen "Preciso de um tempo antes de dizer algo de que vou me arrepender."

# game/code/5 events/release 1/marnie2.rpy:4337
translate brazil henrytrouble_4891a07b:

#   hen "I'm going outside."
    hen "Vou sair."

# game/code/5 events/release 1/marnie2.rpy:4338
translate brazil henrytrouble_b026a63b:

#   hen "Just... stay the fuck away from me for a while."
    hen "Só... fique bem longe de mim por um tempo."

