#   boss "MAKE IT THREE!"
    boss "QUE SEJAM TRÊS!"

# game/code/5 events/release 1/marnie2.rpy:4295
translate brazil henrytrouble_a76bbd7d:

#   boss "And if I hear one more word out of your mouth, I'll find something even WORSE for you to do!"
    boss "E se eu ouvir mais uma palavra da sua boca, vou encontrar algo ainda PIOR para você fazer!"

# game/code/5 events/release 1/marnie2.rpy:4296
translate brazil henrytrouble_f9ffb41e:

#   hen "Sir! Please! Don't do this!"
    hen "Senhor! Por favor! Não faça isso!"

# game/code/5 events/release 1/marnie2.rpy:4297
translate brazil henrytrouble_f118524a:

#   hen "Sir! Wait! Please, just hear me out! Sir!"
    hen "Senhor! Espere! Por favor, me ouça! Senhor!"

