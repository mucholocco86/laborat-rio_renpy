#   bia "They tried to say goodnight to you."
    bia "Eles tentaram te dar boa noite."

# game/code/5 events/release 1/nina1.rpy:120
translate brazil nina1alt_0274904f:

#   bia "They said you wouldn't even look up from the computer."
    bia "Disseram que você nem sequer levantaria os olhos do computador."

# game/code/5 events/release 1/nina1.rpy:121
translate brazil nina1alt_bc07a7b3:

#   bia "Robert, they weren't asking for the whole evening. They wanted five minutes with their father."
    bia "Robert, eles não pediram a noite toda. Eles queriam cinco minutos com o pai."

# game/code/5 events/release 1/nina1.rpy:122
translate brazil nina1alt_266d0bdd:

#   bia "They miss you."
    bia "Eles sentem sua falta."

# game/code/5 events/release 1/nina1.rpy:127
translate brazil nina1alt_e151cdb7:

#   bia "And tonight, one of them asked if we were getting divorced."
    bia "E hoje à noite, um deles perguntou se estávamos nos divorciando."

# game/code/5 events/release 1/nina1.rpy:128
translate brazil nina1alt_14425129:

#   bia "They see you in this room all day. They see us barely speaking."
    bia "Eles te veem nesta sala o dia todo. Eles nos veem quase sem nos falarmos."

# game/code/5 events/release 1/nina1.rpy:129
translate brazil nina1alt_d95c7a3d:

#   bia "I told them nobody was leaving, but I need you to help me make that feel true."
    bia "Eu disse a eles que ninguém ia embora, mas preciso da sua ajuda para que isso pareça verdade."

# game/code/5 events/release 1/nina1.rpy:130
translate brazil nina1alt_733bedf2:

#   bia "This cannot keep being my job alone."
    bia "Não posso continuar a ser apenas minha responsabilidade."

