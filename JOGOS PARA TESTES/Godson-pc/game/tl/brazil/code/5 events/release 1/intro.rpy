translate brazil thestart_cf234a38:

#   myles_nvl "Anyway, go see what this chick has to say."
    myles_nvl "Enfim, vá ver o que essa garota tem a dizer."

# game/code/5 events/release 1/intro.rpy:2575
translate brazil thestart_41aba7d5:

#   myles_nvl "Maybe your dad left that note because he knew she'd be able to explain something."
    myles_nvl "Talvez seu pai tenha deixado aquele bilhete porque sabia que ela seria capaz de explicar alguma coisa."

# game/code/5 events/release 1/intro.rpy:2576
translate brazil thestart_e2b0e3ec:

#   myles_nvl "And if the whole thing feels wrong, leave. You don't owe anybody in that house shit."
    myles_nvl "E se tudo parecer errado, vá embora. Você não deve nada a ninguém naquela casa."

# game/code/5 events/release 1/intro.rpy:2582
translate brazil thestart_95ad1a64:

#   mc_nvl "I'll let you know what happens."
    mc_nvl "Eu te informarei o que acontecer."

# game/code/5 events/release 1/intro.rpy:2583
translate brazil thestart_ff18a6ca:

#   myles_nvl "You better."
    myles_nvl "É melhor que sim."

# game/code/5 events/release 1/intro.rpy:2584
translate brazil thestart_06d19dd8:

#   myles_nvl "Don't have me sitting here wondering whether you got kidnapped by some suburban cult."
    myles_nvl "Não me deixe aqui me perguntando se você foi sequestrado por algum culto suburbano."

# game/code/5 events/release 1/intro.rpy:2585
translate brazil thestart_c00d64dd:

#   myles_nvl "Text me when you get inside."
    myles_nvl "Me mande uma mensagem quando você entrar."

# game/code/5 events/release 1/intro.rpy:2589
translate brazil thestart_c7ed5a05:

#   mc_nvl "You really think I should go in?"
    mc_nvl "Você acha mesmo que eu deveria entrar?"

# game/code/5 events/release 1/intro.rpy:2590
translate brazil thestart_ab79c792:

#   myles_nvl "You took the bus all the way there."
    myles_nvl "Você foi de ônibus até lá."

# game/code/5 events/release 1/intro.rpy:2591
translate brazil thestart_1ac0a279:

#   myles_nvl "Might as well find out why your dad wanted you to come."
    myles_nvl "É melhor descobrir por que seu pai queria que você viesse."

# game/code/5 events/release 1/intro.rpy:2592
translate brazil thestart_c059c855:

#   myles_nvl "Just don't ignore your gut if something feels off."
    myles_nvl "Simplesmente não ignore sua intuição se algo parecer errado."

# game/code/5 events/release 1/intro.rpy:2596
translate brazil thestart_c53813d8:

#   mc_nvl "Part of me wants to just leave."
    mc_nvl "Uma parte de mim só quer ir embora."

# game/code/5 events/release 1/intro.rpy:2597
translate brazil thestart_85981aea:

#   myles_nvl "You can."
    myles_nvl "Você pode."

# game/code/5 events/release 1/intro.rpy:2598
translate brazil thestart_8d209b79:

#   myles_nvl "But you'll probably spend the whole bus ride home wondering what was behind that door."
    myles_nvl "Mas você provavelmente passará toda a viagem de ônibus para casa se perguntando o que havia atrás daquela porta."

# game/code/5 events/release 1/intro.rpy:2599
translate brazil thestart_7c9f422d:

#   myles_nvl "At least talk to her first. Then decide."
    myles_nvl "Pelo menos fale com ela primeiro. Depois decida."

# game/code/5 events/release 1/intro.rpy:2601
translate brazil thestart_937d9b36:

#   myles_nvl "Anyway bro, I'm gonna let you handle that."
    myles_nvl "Enfim, mano, vou deixar você cuidar disso."

# game/code/5 events/release 1/intro.rpy:2602
translate brazil thestart_3f9a634a:

#   myles_nvl "But seriously, call me if you need anything."
    myles_nvl "Mas falando sério, me liga se precisar de alguma coisa."

# game/code/5 events/release 1/intro.rpy:2603
translate brazil thestart_058b6ee2:

#   myles_nvl "I don't care if it's about your dad, this random chick, or you just need somebody to talk shit with."
    myles_nvl "Não me importa se é sobre seu pai, essa garota aleatória, ou se você só precisa desabafar com alguém."

# game/code/5 events/release 1/intro.rpy:2604
translate brazil thestart_e8cd64bd:

#   myles_nvl "I'm here. You already know that."
    myles_nvl "Estou aqui. Você já sabe disso."

