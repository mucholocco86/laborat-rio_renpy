#   hen "..."
    hen "..."

# game/code/5 events/release 1/intro.rpy:2721
translate brazil knoc1_f2f1a0e9:

#   hen "Well, that's definitely not something I hear every day."
    hen "Bom, definitivamente não é algo que eu ouça todos os dias."

# game/code/5 events/release 1/intro.rpy:2722
translate brazil knoc1_0bd889d8:

#   hen "How does your father know my wife?"
    hen "Como seu pai conhece minha esposa?"

# game/code/5 events/release 1/intro.rpy:2730
translate brazil knoc1_ee7a3b3e:

#   hen "That's pretty convenient."
    hen "Isso é bem conveniente."

# game/code/5 events/release 1/intro.rpy:2734
