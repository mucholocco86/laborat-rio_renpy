#   hen "This has nothing to do with you! Stay out of my marriage!"
    hen "Isso não é da sua conta! Fique fora do meu casamento!"

# game/code/5 events/release 1/intro.rpy:71
translate brazil intro_1_b79fb3dc:

#   mar "Stop! Please, don't make this any worse than it already is!"
    mar "Pare! Por favor, não piore ainda mais a situação!"

# game/code/5 events/release 1/intro.rpy:72
translate brazil intro_1_59679942:

#   mar "Just let me handle Henry. I don't need you fighting with him."
    mar "Deixe que eu cuide do Henry. Não preciso que você brigue com ele."

# game/code/5 events/release 1/intro.rpy:80
translate brazil intro_1_3bb888d8:

#   mar "Because he's my husband, and this is between us. You need to back off."
    mar "Porque ele é meu marido, e isso é entre nós. Você precisa se afastar."

# game/code/5 events/release 1/intro.rpy:81
translate brazil intro_1_2a60b260:

#   mar "Please... just give me a moment to speak with him."
    mar "Por favor... me dê apenas um momento para falar com ele."

# game/code/5 events/release 1/intro.rpy:86
translate brazil intro_1_5ed84893:

#   mar "That isn't helping right now. You've already done more than enough."
    mar "Isso não está ajudando agora. Você já fez mais do que o suficiente."

# game/code/5 events/release 1/intro.rpy:87
translate brazil intro_1_739a93bf:

#   mar "Just stop talking and let me deal with this before someone gets hurt."
    mar "Pare de falar e deixe-me resolver isso antes que alguém se machuque."

# game/code/5 events/release 1/intro.rpy:92
translate brazil intro_1_a094c656:

#   mar "Are you serious? Henry just caught us, and you're asking me to keep dancing?"
    mar "Você está falando sério? O Henry acabou de nos flagrar, e você está me pedindo para continuar dançando?"

# game/code/5 events/release 1/intro.rpy:93
translate brazil intro_1_0f006d77:

#   mar "Stop pushing this. You're only making everything worse."
    mar "Pare de insistir nisso. Você só está piorando tudo."

# game/code/5 events/release 1/intro.rpy:98
translate brazil intro_1_91dda540:

#   hen "You have a lot of nerve speaking to me like that while standing in MY home!"
    hen "Você tem muita audácia de falar comigo desse jeito estando na MINHA casa!"

# game/code/5 events/release 1/intro.rpy:102
translate brazil intro_1_81dbc9f9:

#   mar "Stop it! Don't speak to Henry like that!"
    mar "Pare com isso! Não fale assim com o Henry!"

# game/code/5 events/release 1/intro.rpy:103
translate brazil intro_1_52daaf31:

#   mar "You've made your point, but this has gone far enough!"
    mar "Você já deixou sua opinião clara, mas isso já foi longe demais!"

# game/code/5 events/release 1/intro.rpy:111
translate brazil intro_1_a9e6bdde:

#   mar "Because whatever has happened between us, he is still my husband!"
    mar "Porque, independentemente do que tenha acontecido entre nós, ele continua sendo meu marido!"

# game/code/5 events/release 1/intro.rpy:112
translate brazil intro_1_7b01b8e7:

#   mar "You don't get to stand there and tell me how I should speak to him!"
    mar "Você não tem o direito de ficar aí me dizendo como eu devo falar com ele!"

# game/code/5 events/release 1/intro.rpy:117
translate brazil intro_1_56daa8a0:

#   mar "You have no idea what I'm afraid to say!"
    mar "Você não faz ideia do que eu tenho medo de dizer!"

# game/code/5 events/release 1/intro.rpy:118
translate brazil intro_1_e1d0307a:

#   mar "Stay out of this and let me speak for myself!"
    mar "Não se meta nisso e deixe-me falar por mim!"

# game/code/5 events/release 1/intro.rpy:123
translate brazil intro_1_5c589767:

#   mar "You don't know anything about our marriage!"
    mar "Você não sabe nada sobre o nosso casamento!"

# game/code/5 events/release 1/intro.rpy:124
translate brazil intro_1_c988ad5e:

#   mar "Don't use what happened between us as an excuse to tear my life apart!"
    mar "Não use o que aconteceu entre nós como desculpa para destruir minha vida!"

# game/code/5 events/release 1/intro.rpy:130
translate brazil intro_1_b1d4442d:

#   hen "What the fuck did you just say to me!?"
    hen "Que porra você acabou de me dizer!?"

# game/code/5 events/release 1/intro.rpy:134
translate brazil intro_1_2b0fe791:

#   mar "Stop! Both of you, stop this right now!"
    mar "Parem! Vocês dois, parem com isso agora mesmo!"

# game/code/5 events/release 1/intro.rpy:135
translate brazil intro_1_465cfdfd:

#   mar "I am NOT letting this turn into a fight in the middle of the party!"
    mar "Eu NÃO vou deixar isso virar uma briga no meio da festa!"

# game/code/5 events/release 1/intro.rpy:143
translate brazil intro_1_fb74fb2b:

#   mar "STOP! Don't provoke him. This isn't some game!"
    mar "PARE! Não o provoque. Isto não é uma brincadeira!"

# game/code/5 events/release 1/intro.rpy:144
translate brazil intro_1_94cc2745:

#   mar "Back off and keep your mouth shut before this gets completely out of control."
    mar "Afaste-se e fique de boca fechada antes que a situação saia completamente do controle."

# game/code/5 events/release 1/intro.rpy:149
translate brazil intro_1_a3045ef1:

#   mar "Enough! I won't stand here while you deliberately try to humiliate him!"
    mar "Chega! Não vou ficar aqui parado enquanto você tenta humilhá-lo deliberadamente!"

# game/code/5 events/release 1/intro.rpy:150
translate brazil intro_1_d694f667:

#   mar "Whatever you think this is, you need to stop now!"
    mar "Seja lá o que você esteja pensando que isso seja, pare agora mesmo!"

# game/code/5 events/release 1/intro.rpy:155
translate brazil intro_1_188f11d4:

#   mar "[playerName], don't you dare speak for me!"
    mar "[playerName] Não ouse falar por mim!"

# game/code/5 events/release 1/intro.rpy:156
translate brazil intro_1_9b694874:

#   mar "You don't get to decide what I want, and you certainly don't get to dismiss my husband for me!"
    mar "Você não tem o direito de decidir o que eu quero, e certamente não tem o direito de demitir meu marido por minha causa!"

# game/code/5 events/release 1/intro.rpy:164
translate brazil intro_1_8d896ccb:

#   mar "Okay, Henry. Let's go talk."
    mar "Certo, Henry. Vamos conversar."

