    rob "Henry, escute o que você está dizendo! Você está perdendo o controle!"

# game/code/5 events/release 1/intro.rpy:2182
translate brazil after1_b4de510d:

#   hen "I trusted you around my family you son of a bitch!"
    hen "Eu confiei em você perto da minha família, seu filho da puta!"

