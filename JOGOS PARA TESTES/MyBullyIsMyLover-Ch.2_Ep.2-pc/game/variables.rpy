transform move_slide:
    xalign 1.0 yalign 0.9
    easein 1.0 xalign 0.05
    pause 1.0

transform blur_slide_left:
    on show:
        xoffset -1920 blur 18
        easeout 0.15 xoffset 0 blur 0
    on replace:
        xoffset 0 blur 0
        easein 0.15 xoffset 1920 blur 18

transform blur_slide_right:
    on show:
        xoffset 1920 blur 18
        easeout 0.15 xoffset 0 blur 0
    on replace:
        xoffset 0 blur 0
        easein 0.15 xoffset -1920 blur 18

