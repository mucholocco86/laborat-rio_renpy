#   m "{i}Why...?"
    m "{i}Por que...?"

# game/ch1ep4.rpy:158
translate Portugues ch1ep4_a81ce81d:

#   m "{i}Why does it have to be always like this...?"
    m "{i}Por que tem que ser sempre assim...?"

