#   yt "The way she's talking right now is nothing like I've ever heard from her before..."
    yt "A maneira como ela está falando agora não é nada como eu já ouvi dela antes..."

#game\ep6.rpy:4353
translate Portugues lilyannepause_363d8e56:

#   yt "What's with me? Why am I feeling like this towards her?"
    yt "O que há comigo? Por que estou me sentindo assim por ela?"

#game\ep6.rpy:4354
