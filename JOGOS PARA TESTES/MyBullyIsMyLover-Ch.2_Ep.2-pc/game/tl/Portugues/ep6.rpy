#   mc "Ahh..."
    mc "Ahh..."

#game\ep6.rpy:4257
translate Portugues lilyannepause_1ffe798c:

#   mc "Damn it, I can't even remember what she exactly looks like. Let alone her name."
    mc "Droga, nem consigo me lembrar exatamente como ela é. Muito menos o nome dela."

#game\ep6.rpy:4260
translate Portugues lilyannepause_f81a964d:

#   e "{i}That's enough..."
    e "{i}Isso é o suficiente..."

#game\ep6.rpy:4261
translate Portugues lilyannepause_db8db05e:

#   mc "I'm just... a piece of trash who couldn't keep his promise to the girl he loved."
    mc "Sou apenas... um pedaço de lixo que não conseguiu cumprir a promessa que fez à garota que amava."

#game\ep6.rpy:4262
translate Portugues lilyannepause_07c3818d:

#   e "{i}That's enough... Please..."
    e "{i}Já chega... Por favor..."

