    e "{i}Isso é tudo que eu queria saber..."

#game\ep6.rpy:4303
translate Portugues lilyannepause_b3aa1537:

#   e "{i}I deeply regret my decision to move on, but now that we're in this situation, there is no turning back time anymore."
    e "{i}Lamento profundamente minha decisão de Avançar, mas agora que estamos nessa situação, não há mais como voltar atrás."

#game\ep6.rpy:4304
translate Portugues lilyannepause_93c1502b:

#   e "{i}If I can comfort you like this any time you are in distress, then I will never ask for more."
    e "{i}Se eu puder confortá-lo assim sempre que você estiver em perigo, nunca pedirei mais."

#game\ep6.rpy:4305
translate Portugues lilyannepause_f9332de7:

#   e "{i}I'm here now... I'll be here for you."
    e "{i}Estou aqui agora... Estarei aqui para ajudá-lo."

#game\ep6.rpy:4308
translate Portugues lilyannepause_17284d70:

#   e "{i}It's not bad to wish for it twice, right?"
    e "{i}Não é ruim desejar isso duas vezes, certo?"

#game\ep6.rpy:4309
