#   e "{i}Then..."
    e "{i}Então..."

#game\ep6.rpy:4310
translate Portugues lilyannepause_a6ce0bd2:

#   e "{i}Please let us fix our past mistakes and guide us to the right path this time."
    e "{i}Por favor, deixe-nos corrigir nossos erros do passado e nos guiar para o caminho certo desta vez."

#game\ep6.rpy:4311
