#   mc "Argh! This is why I don't want to recall that time! I just get too emotional!"
    mc "Argh! É por isso que não quero me lembrar daquela época! Eu simplesmente fico muito emocionado!"

#game\ep6.rpy:4270
translate Portugues lilyannepause_3204e995:

#   e "...Do you... still miss her?"
