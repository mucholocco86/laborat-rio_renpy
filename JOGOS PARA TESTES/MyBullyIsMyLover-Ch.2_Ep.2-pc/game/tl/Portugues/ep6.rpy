#   e "So if you have a lot of things to do now, then focus on them."
    e "Portanto, se você tem muitas coisas para fazer agora, concentre-se nelas."

#game\ep6.rpy:4347
translate Portugues lilyannepause_9a48d0af:

#   e "You said to me that you're not like you were back then, right? Then stand for it."
    e "Você me disse que não é mais como era naquela época, certo? Então defenda isso."

#game\ep6.rpy:4348
