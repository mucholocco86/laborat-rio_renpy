#   le "Are you sure? You seem to have forgotten that it's almost time for dinner!"
    le "Tem certeza? Você parece ter esquecido que está quase na hora do jantar!"

#game\emmasoloending.rpy:5192
translate Portugues emmapreggospecial_9453594e:

#   mc "Oh, is it already time?"
    mc "Ah, já está na hora?"

#game\emmasoloending.rpy:5193
