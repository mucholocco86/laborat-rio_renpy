    un "{i}Tudo o que ela fez foi me cumprimentar e olhar para minhas velhas pelúcias.{/i}"

#game\emmasoloending.rpy:423
translate Portugues emmasoloending_e4fbe5b8:

#   un "{i}She paused for a second, then entered our house.{/i}"
    un "{i}Ela parou por um segundo e depois entrou em nossa casa.{/i}"

#game\emmasoloending.rpy:426
translate Portugues emmasoloending_3d86526c:

#   un "{i}She looked like terrible news, but she's extremely cool! I wonder if she'd be willing to play with me...{/i}"
    un "{i}Ela parecia uma péssima notícia, mas é extremamente legal! Eu me pergunto se ela estaria disposta a brincar comigo...{/i}"

