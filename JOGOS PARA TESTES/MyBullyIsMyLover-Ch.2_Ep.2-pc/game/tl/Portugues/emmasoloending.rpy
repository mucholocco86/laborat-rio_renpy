#   le "There~!"
    le "Aí~!"

#game\emmasoloending.rpy:5196
translate Portugues emmapreggospecial_9712c098:

#   le "Come, come! I'm hungry already!"
    le "Vem vem! Já estou com fome!"

#game\emmasoloending.rpy:5197
translate Portugues emmapreggospecial_a984083e:

#   mc "Hold on, let me put this back first."
    mc "Espere, deixe-me colocar isso de volta primeiro."

#game\emmasoloending.rpy:5198
translate Portugues emmapreggospecial_fc8b5d33:

#   le "Oh..."
    le "Oh..."

#game\emmasoloending.rpy:5199
translate Portugues emmapreggospecial_dfbe69b7:

#   le "Let me help you."
    le "Deixe-me ajudá-lo."

#game\emmasoloending.rpy:5203
translate Portugues emmapreggospecial_61a15f78:

#   mc "That's right... Where's your sister, Leah? Isn't she coming back soon?"
    mc "Isso mesmo... Onde está sua irmã, Leah? Ela não vai voltar logo?"

#game\emmasoloending.rpy:5204
translate Portugues emmapreggospecial_1dde8de2:

#   le "Come on, she's in the kitchen cooking!"
    le "Vamos, ela está na cozinha cozinhando!"

#game\emmasoloending.rpy:5205
translate Portugues emmapreggospecial_4cd1e93d:

#   mc "Is she now...?"
    mc "Ela está agora...?"

#game\emmasoloending.rpy:5206
translate Portugues emmapreggospecial_50538808:

#   mc "Uhh, I must be getting old."
    mc "Uhh, devo estar ficando velho."

#game\emmasoloending.rpy:5207
translate Portugues emmapreggospecial_b437f3e1:

#   le "\"My MeMoRy MiGhT bE FuNcTiOnInG bEtTeR tHaN yOuRs\", my ass..."
    le "\"Minha memória pode estar funcionando melhor que a sua\", minha bunda..."

#game\emmasoloending.rpy:5210
translate Portugues emmapreggospecial_cafb09d8:

#   le "Hey, Sol, sis! Can you come here for a sec?"
    le "Ei, Sol, mana! Você pode vir aqui por um segundo?"

#game\emmasoloending.rpy:5213
translate Portugues emmapreggospecial_ad409644:

#   so "Never mind him, but aren't you getting younger and younger?! You're supposed to be in your 60's! What's wrong with you?!"
    so "Não ligue para ele, mas você não está ficando cada vez mais jovem?! Você deveria estar na casa dos 60 anos! O que você tem?!"

#game\emmasoloending.rpy:5214
translate Portugues emmapreggospecial_06fcbee0:

#   le "Yeah, ask me like I know..."
    le "Sim, pergunte-me como eu sei..."

#game\emmasoloending.rpy:5215
translate Portugues emmapreggospecial_98849e47:

#   so "Also, you should be the one cooking. I just came back from abroad. I need some rest, you know?"
    so "Além disso, você deve cozinhar. Acabei de voltar do exterior. Preciso descansar um pouco, sabe?"

#game\emmasoloending.rpy:5216
translate Portugues emmapreggospecial_16bfd6a2:

#   le "Ahaha! We both know you're the best cook here, and I'm sure dad already misses your food."
    le "Ahaha! Nós dois sabemos que você é o melhor cozinheiro daqui e tenho certeza que papai já sente falta da sua comida."

#game\emmasoloending.rpy:5217
translate Portugues emmapreggospecial_c390e2a9:

#   mc "Ahh, Sol, my dear daughter! There you are!"
    mc "Ahh, Sol, minha querida filha! Aí está você!"

#game\emmasoloending.rpy:5220
translate Portugues emmapreggospecial_ec56a110:

#   so "*giggles* Why if it isn't my Papa~!"
    so "*risos* Por que se não é meu papai~!"

#game\emmasoloending.rpy:5221
translate Portugues emmapreggospecial_41d47663:

#   mc "M-my back, my back!"
    mc "M-minhas costas, minhas costas!"

#game\emmasoloending.rpy:5236
translate Portugues emmapreggospecial_b07923ff:

#   le "Shall we eat?"
    le "Vamos comer?"

#game\emmasoloending.rpy:5237
translate Portugues emmapreggospecial_5ee9eaa1:

#   mc "Let's go."
    mc "Vamos."

#game\emmasoloending.rpy:5375
translate Portugues emmapreggospecial_436873a4:

#   le "{i}Hi~! My name is Leah Meyer!{/i}"
    le "{i}Olá~! Meu nome é Leah Meyer!{/i}"

#game\emmasoloending.rpy:5376
translate Portugues emmapreggospecial_7e07f39d:

#   le "{i}When I reached eighteen, I decided to become a writer.{/i}"
    le "{i}Quando completei dezoito anos, decidi me tornar escritor.{/i}"

#game\emmasoloending.rpy:5379
translate Portugues emmapreggospecial_c5d8f2de:

#   le "{i}I can't say that I am a successful one because things got weird for me when I reached that magical age.{/i}"
    le "{i}Não posso dizer que sou um sucesso porque as coisas ficaram estranhas para mim quando cheguei a essa idade mágica.{/i}"

#game\emmasoloending.rpy:5380
translate Portugues emmapreggospecial_f3cea18d:

#   le "{i}Mentally... physically... There was a lot that I couldn't understand ever since then...{/i}"
    le "{i}Mentalmente... fisicamente... Havia muita coisa que eu não conseguia entender desde então...{/i}"

#game\emmasoloending.rpy:5381
translate Portugues emmapreggospecial_74f794b5:

#   le "{i}I'm already sixty years old, yet I'm...{/i}"
    le "{i}Já tenho sessenta anos, mas estou...{/i}"

#game\emmasoloending.rpy:5390
translate Portugues emmapreggospecial_c2d472e0:

#   le "{i}*sighs* I guess I'll-{/i}{w=0.8}{nw}"
    le "{i}*suspira* Acho que vou-{/i}{w=0.8}{nw}"

#game\emmasoloending.rpy:5397
translate Portugues emmapreggospecial_2e05d0a9:

#   le "What... on earth was that?!"
    le "O que... diabos foi isso?!"

#game\emmasoloending.rpy:5398
translate Portugues emmapreggospecial_a07c0266:

#   le "I can't feel or hear anything!"
    le "Não consigo sentir ou ouvir nada!"

#game\emmasoloending.rpy:5402
translate Portugues emmapreggospecial_dd2b003a:

#   le "Kuh!"
    le "Uau!"

#game\emmasoloending.rpy:5414
translate Portugues emmapreggospecial_00c7a772:

#   le "W-who are y-"
    le "Quem é você-"

#game\emmasoloending.rpy:5417
translate Portugues emmapreggospecial_dd99cf4b:

#   le "No, were you the ones who did {i}that{/i}?"
    le "Não, foram vocês que fizeram {i}isso{/i}?"

#game\emmasoloending.rpy:5418
translate Portugues emmapreggospecial_65c7f9a4:

#   un "I apologize for we must do this. But it was me who did that, Princess."
    un "Peço desculpas porque devemos fazer isso. Mas fui eu quem fez isso, Princesa."

#game\emmasoloending.rpy:5419
translate Portugues emmapreggospecial_171965af:

#   le "What did you just call me?"
    le "Do que você acabou de me ligar?"

#game\emmasoloending.rpy:5422
translate Portugues emmapreggospecial_cdef3d9a:

#   ma "You have no idea who you are? How peculiar..."
    ma "Você não tem ideia de quem você é? Que peculiar..."

#game\emmasoloending.rpy:5425
translate Portugues emmapreggospecial_342fb0e5:

#   le "I don't know you and your intentions, but I can't..."
    le "Não conheço você e suas intenções, mas não posso..."

#game\emmasoloending.rpy:5434
translate Portugues emmapreggospecial_208a5ed9:

#   le "... Let you touch my family!"
    le "...Deixe você tocar minha família!"

#game\emmasoloending.rpy:5437
translate Portugues emmapreggospecial_28f7a7c0:

#   un "Oh, wow..."
    un "Ah, uau..."

#game\emmasoloending.rpy:5438
translate Portugues emmapreggospecial_8024d14c:

#   ma "*nervously laughs* Those eyes..."
    ma "*ri nervosamente* Aqueles olhos..."

#game\emmasoloending.rpy:5439
translate Portugues emmapreggospecial_d99305ca:

#   ma "One is swallowed by darkness, and the other is glowing with the light of eternal slumber..."
    ma "Um é engolido pela escuridão e o outro brilha com a luz do sono eterno..."

#game\emmasoloending.rpy:5440
translate Portugues emmapreggospecial_dd8ec474:

#   ma "You, girl, are indeed {i}her daughter{/i}."
    ma "Você, garota, é de fato {i}filha dela{/i}."

#game\emmasoloending.rpy:5441
translate Portugues emmapreggospecial_27b7c2a1:

#   un "No need for such hostility. We are not here to fight, Princess."
    un "Não há necessidade de tal hostilidade. Não estamos aqui para lutar, Princesa."

#game\emmasoloending.rpy:5442
translate Portugues emmapreggospecial_ea27441c:

#   ma "Losing your cool now, E? You were pretty pumped about this."
    ma "Perdendo a calma agora, E? Você estava muito animado com isso."

#game\emmasoloending.rpy:5443
translate Portugues emmapreggospecial_368c2967:

#   ee "She said we can, as long as we are not the ones who start it, but I don't really want to."
    ee "Ela disse que podemos, desde que não sejamos nós que começamos, mas eu realmente não quero."

#game\emmasoloending.rpy:5444
translate Portugues emmapreggospecial_913a20e5:

#   ee "Also, I don't have such a thing as \"pumped\" in my data. Mind telling me what that is?"
    ee "Além disso, não tenho \"bombeado\" em meus dados. Importa-se de me dizer o que é isso?"

#game\emmasoloending.rpy:5445
translate Portugues emmapreggospecial_64776010:

#   ma "Yeah, you're losing your cool, alright."
    ma "Sim, você está perdendo a calma, certo."

#game\emmasoloending.rpy:5446
translate Portugues emmapreggospecial_6ef7dc19:

#   ee "I can't take my eyes off of this. It's beautiful."
    ee "Não consigo tirar os olhos disso. É lindo."

#game\emmasoloending.rpy:5447
translate Portugues emmapreggospecial_a3164575:

#   ma "Hah! Sure... You can't see it, though..."
    ma "Hah! Claro... Mas você não pode ver..."

#game\emmasoloending.rpy:5456
translate Portugues emmapreggospecial_6de893d6:

#   le "Again, who are you, and what are your intentions? Answer me."
    le "Novamente, quem é você e quais são suas intenções? Responda-me."

#game\emmasoloending.rpy:5457
translate Portugues emmapreggospecial_9426b731:

#   ma "*sighs* Where the hell is she, anyway?"
    ma "*suspira* Onde diabos ela está, afinal?"

#game\emmasoloending.rpy:5460
translate Portugues emmapreggospecial_76b3a035:

#   ma "Mistreeeeeeeess?!"
    ma "Mistereeeeess?!"

#game\emmasoloending.rpy:5468
translate Portugues emmapreggospecial_e0b15998:

#   am "Ahh, it's been a while. That felt... not too good!"
    am "Ah, já faz um tempo. Isso não foi muito bom!"

#game\emmasoloending.rpy:5472
translate Portugues emmapreggospecial_00a2b0de:

#   ma "Oh, of course... But the problem is... Why do I always have to call you like this?"
    ma "Ah, claro... Mas o problema é... Por que eu sempre tenho que te ligar assim?"

#game\emmasoloending.rpy:5475
translate Portugues emmapreggospecial_c844c7ca:

#   le "Y-you're..."
    le "V-você é..."

#game\emmasoloending.rpy:5483
translate Portugues emmapreggospecial_7dde45d0:

#   am "I believe we've already met once, but it's good to see you again, Leah."
    am "Acredito que já nos encontramos uma vez, mas é bom ver você de novo, Leah."

#game\emmasoloending.rpy:5487
translate Portugues emmapreggospecial_e2a07554:

#   ma "It's been a century since I last saw {i}you{/i}, Mistress. Please, pardon my audacity."
    ma "Já se passou um século desde a última vez que vi {i}você{/i}, Senhora. Por favor, perdoe minha audácia."

#game\emmasoloending.rpy:5488
translate Portugues emmapreggospecial_cba69cd8:

#   ee "Mistress..."
    ee "Amante..."

#game\emmasoloending.rpy:5489
translate Portugues emmapreggospecial_261f1e7a:

#   am "I told you to stop doing that, Maya. I'm still {i}me{/i}, no matter what form."
    am "Eu disse para você parar de fazer isso, Maya. Ainda sou {i}eu{/i}, não importa de que forma."

#game\emmasoloending.rpy:5490
translate Portugues emmapreggospecial_7fdca207:

#   ma "But..."
    ma "Mas..."

#game\emmasoloending.rpy:5491
translate Portugues emmapreggospecial_c23ab73a:

#   am "Come on. Please, stand up. We should not waste time."
    am "Vamos. Por favor, levante-se. Não devemos perder tempo."

#game\emmasoloending.rpy:5494
translate Portugues emmapreggospecial_d04c8822:

#   am "I've returned for you, and you must come with us, Leah."
    am "Voltei para buscá-la e você deve vir conosco, Leah."

#game\emmasoloending.rpy:5495
translate Portugues emmapreggospecial_a09428c2:

#   am "I know you have many questions, and I'll explain all of this later, but we should not stay here for long."
    am "Sei que você tem muitas dúvidas e explicarei tudo isso mais tarde, mas não devemos ficar aqui por muito tempo."

#game\emmasoloending.rpy:5496
translate Portugues emmapreggospecial_c95aa634:

#   le "And what if I don't want to? I have a family here. I don't need anything else."
    le "E se eu não quiser? Eu tenho uma família aqui. Eu não preciso de mais nada."

#game\emmasoloending.rpy:5499
translate Portugues emmapreggospecial_a3b20cc0:

#   am "You must. The longer you stay here, the higher the chance this place will become chaos."
    am "Você deve. Quanto mais tempo você ficar aqui, maior será a chance de este lugar se tornar um caos."

#game\emmasoloending.rpy:5503
translate Portugues emmapreggospecial_ad918c0d:

#   am "Furthermore, this is the future that Emma and [mc] chose for you years ago, Leah."
    am "Além disso, este é o futuro que Emma e [mc] escolheram para você anos atrás, Leah."

#game\emmasoloending.rpy:5079
translate Portugues emmapreggospecial_af9e0a50_1:

#   em "..."
    em "..."

#game\emmasoloending.rpy:5246
translate Portugues emmapreggospecial_0573424f_1:

#   d "(Dear Emy...)"
    d "(Querida Emy...)"

#game\emmasoloending.rpy:5247
translate Portugues emmapreggospecial_b1d33d62_1:

#   d "(This has to be the most painful letter I've ever had to write.)"
    d "(Esta deve ser a carta mais dolorosa que já escrevi.)"

#game\emmasoloending.rpy:5248
translate Portugues emmapreggospecial_5db48023_1:

#   d "(Because by the time you read this, I'll no longer be around to guide you and watch you grow up.)"
    d "(Porque quando você ler isto, não estarei mais por perto para orientá-lo e ver você crescer.)"

#game\emmasoloending.rpy:5249
translate Portugues emmapreggospecial_3568a153_1:

#   d "(I wish I could have stayed with you just a little bit longer.)"
    d "(Eu gostaria de ter ficado com você um pouco mais.)"

#game\emmasoloending.rpy:5250
translate Portugues emmapreggospecial_e82b3192_1:

#   d "(I wish I was able to hold you close through illness and heartache.)"
    d "(Eu gostaria de poder mantê-lo por perto durante a doença e a dor de cabeça.)"

#game\emmasoloending.rpy:5251
translate Portugues emmapreggospecial_1745d0b2_1:

#   d "(I wish I could hold your hands as you face new experiences and assure you a certain level of safety.)"
    d "(Gostaria de poder segurar suas mãos enquanto você enfrenta novas experiências e garantir um certo nível de segurança.)"

#game\emmasoloending.rpy:5252
translate Portugues emmapreggospecial_15b7a012_1:

#   d "(But I guess, life had different plans for us.)"
    d "(Mas acho que a vida tinha planos diferentes para nós.)"

#game\emmasoloending.rpy:5253
translate Portugues emmapreggospecial_e27a371e_1:

#   d "(I'm writing this last letter to tell you what I could not. And I hope you are old enough to understand what I'm going to say...)"
    d "(Estou escrevendo esta última carta para lhe dizer o que não pude. E espero que você tenha idade suficiente para entender o que vou dizer...)"

#game\emmasoloending.rpy:5254
translate Portugues emmapreggospecial_9c2e6308_1:

#   d "(Emy... I want you to know that you are the best thing that ever happened to me.)"
    d "(Emy... quero que saiba que você é a melhor coisa que já aconteceu comigo.)"

#game\emmasoloending.rpy:5255
translate Portugues emmapreggospecial_8797e8cb_1:

#   d "(When I first held you in my arms, one of my dreams came true.)"
    d "(Quando segurei você em meus braços pela primeira vez, um dos meus sonhos se tornou realidade.)"

#game\emmasoloending.rpy:5256
translate Portugues emmapreggospecial_bc96ef8d_1:

#   d "(I remember staring at your perfect little features and feeling overjoyed at each sound and expression you made.)"
    d "(Lembro-me de olhar para seus pequenos traços perfeitos e me sentir muito feliz com cada som e expressão que você fazia.)"

#game\emmasoloending.rpy:5257
translate Portugues emmapreggospecial_ce92d428_1:

#   d "(A fierce need to protect and guide you came over me then, and has never left.)"
    d "(Uma necessidade feroz de proteger e guiar você tomou conta de mim e nunca mais foi embora.)"

#game\emmasoloending.rpy:5258
translate Portugues emmapreggospecial_903e875e_1:

#   d "(One of these days, you are going to feel the same.)"
    d "(Um dia desses, você sentirá o mesmo.)"

#game\emmasoloending.rpy:5261
translate Portugues emmapreggospecial_57eb72c4_1:

#   d "(Have a family of your own, and even have your first newborn.)"
    d "(Tenha sua própria família e até mesmo seu primeiro recém-nascido.)"

#game\emmasoloending.rpy:5262
translate Portugues emmapreggospecial_5adb517f_1:

#   d "(But without me, obstacles may prove difficult for you on your way there.)"
    d "(Mas sem mim, os obstáculos podem ser difíceis para você no caminho até lá.)"

#game\emmasoloending.rpy:5263
translate Portugues emmapreggospecial_082f4fd5_1:

#   d "(Emy, know that being a mother is not something you know, but it is a skill you learn and acquire.)"
    d "(Emy, saiba que ser mãe não é algo que você conhece, mas é uma habilidade que você aprende e adquire.)"

#game\emmasoloending.rpy:5264
translate Portugues emmapreggospecial_ee5f3ed9_1:

#   d "(Being a mother doesn't mean you have to be perfect.)"
    d "(Ser mãe não significa que você precisa ser perfeita.)"

#game\emmasoloending.rpy:5265
translate Portugues emmapreggospecial_dd4c2562_1:

#   d "(Being a mother means sacrificing things, even the ones you value the most for your child.)"
    d "(Ser mãe significa sacrificar coisas, mesmo aquelas que você mais valoriza para seu filho.)"

#game\emmasoloending.rpy:5266
translate Portugues emmapreggospecial_046d9691_1:

#   d "(Do not be afraid to let go, Emy.)"
    d "(Não tenha medo de deixar ir, Emy.)"

#game\emmasoloending.rpy:5267
translate Portugues emmapreggospecial_b97b2507_1:

#   d "(Only then you will know what it means to become a mother...)"
    d "(Só então você saberá o que significa ser mãe...)"

#game\emmasoloending.rpy:5268
translate Portugues emmapreggospecial_11b3ec0d_1:

#   d "(Only then you will know what it means to love...)"
    d "(Só então você saberá o que significa amar...)"

#game\emmasoloending.rpy:5272
translate Portugues emmapreggospecial_362ede01_1:

#   d "(As you grow old, and you start to forget, please don't ever forget those who stayed by your side.)"
    d "(À medida que você envelhece e começa a esquecer, por favor, nunca se esqueça daqueles que ficaram ao seu lado.)"

#game\emmasoloending.rpy:5278
translate Portugues emmapreggospecial_4672bed8_1:

#   d "(Value them like your own family.)"
    d "(Valorize-os como sua própria família.)"

#game\emmasoloending.rpy:5281
translate Portugues emmapreggospecial_e63d9157_1:

#   d "(I wish I could've met the people who helped my little Emy grow as a person.)"
    d "(Eu gostaria de ter conhecido as pessoas que ajudaram minha pequena Emy a crescer como pessoa.)"

#game\emmasoloending.rpy:5284
translate Portugues emmapreggospecial_13e0b83c_1:

#   d "(But please, thank them in my name.)"
    d "(Mas, por favor, agradeça-lhes em meu nome.)"

#game\emmasoloending.rpy:5285
translate Portugues emmapreggospecial_221d34f9_1:

#   d "(Lastly, from me to my little Emy...)"
    d "(Por último, de mim para minha pequena Emy...)"

#game\emmasoloending.rpy:5288
translate Portugues emmapreggospecial_0266af93_1:

#   d "({b}I loved you long before you were born...{/b})" with dissolve
    d "({b}Eu te amei muito antes de você nascer...{/b})" with dissolve

#game\emmasoloending.rpy:5303
translate Portugues emmapreggospecial_bb5a74ce_1:

#   yt "We met a little girl who eventually became our child."
    yt "Conhecemos uma garotinha que eventualmente se tornou nossa filha."

#game\emmasoloending.rpy:5304
translate Portugues emmapreggospecial_6fdc0e7e_1:

#   yt "Emma and I thought we were going to be the ones to fill the void in her heart, but it was the other way around."
    yt "Emma e eu pensamos que seríamos nós que preencheríamos o vazio em seu coração, mas foi o contrário."

#game\emmasoloending.rpy:5305
translate Portugues emmapreggospecial_3735b2e1_1:

#   yt "She filled the emptiness inside us that we didn't even know was there. She completed us..."
    yt "Ela preencheu o vazio dentro de nós que nem sabíamos que existia. Ela nos completou..."

#game\emmasoloending.rpy:5306
translate Portugues emmapreggospecial_a64a37c8_1:

#   yt "And that... was the best thing that ever happened in our lives..."
    yt "E isso... foi a melhor coisa que já aconteceu em nossas vidas..."

#game\emmasoloending.rpy:5310
