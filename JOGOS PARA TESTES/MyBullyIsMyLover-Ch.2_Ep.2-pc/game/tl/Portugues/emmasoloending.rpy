#   e "Ah, I'm sorry."
    e "Ah, me desculpe."

#game\emmasoloending.rpy:469
translate Portugues emmasoloending_472d9ea5:

#   nad "Please, take a seat."
    nad "Por favor, sente-se."

#game\emmasoloending.rpy:471
