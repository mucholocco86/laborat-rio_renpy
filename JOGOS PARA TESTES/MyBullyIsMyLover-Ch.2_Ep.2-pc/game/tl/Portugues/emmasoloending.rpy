    e "{i}Então, alguns anos mais velho que eu quando estive aqui...{/i}"

#game\emmasoloending.rpy:532
translate Portugues emmasoloending_1eb0df34:

#   nad "She's a bit stubborn, yet a kind and sweet little girl."
    nad "Ela é um pouco teimosa, mas é uma menina gentil e doce."

#game\emmasoloending.rpy:535
translate Portugues emmasoloending_16f61cde:

#   nad "It pains me that I can't take care of her as much as I did when she was younger."
    nad "Dói-me não poder cuidar dela tanto quanto fazia quando ela era mais jovem."

