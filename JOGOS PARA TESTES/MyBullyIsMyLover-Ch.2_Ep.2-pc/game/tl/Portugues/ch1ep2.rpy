#   mil "That person didn't exist, nor was she ever born."
    mil "Essa pessoa não existia, nem nunca nasceu."

#game\ch1ep2.rpy:926
translate Portugues ch1ep2_263ead34:

#   mil "You shall be called... {b}\"Subject Number Four\"{/b}."
    mil "Você será chamado... {b}\"Assunto Número Quatro\"{/b}."

#game\ch1ep2.rpy:927
translate Portugues ch1ep2_c772f1c3:

#   mil "You are nothing but a weapon. A tool to help us win this war."
    mil "Você não passa de uma arma. Uma ferramenta para nos ajudar a vencer esta guerra."

#game\ch1ep2.rpy:928
translate Portugues ch1ep2_6d5bf563:

#   mil "Glabia's military now owns you. You don't have any freedom until you've served your purpose."
    mil "Os militares de Glabia agora são seus donos. Você não tem nenhuma liberdade até que tenha servido ao seu propósito."

#game\ch1ep2.rpy:929
translate Portugues ch1ep2_c7b14b44:

#   mil "And that is to die fighting for his territory."
    mil "E isso é morrer lutando pelo seu território."

#game\ch1ep2.rpy:933
translate Portugues ch1ep2_e9c930fb:

#   mil "I'm under your squad. Let's enjoy our time here while we are still alive, yeah?"
    mil "Estou sob o seu esquadrão. Vamos aproveitar nosso tempo aqui enquanto ainda estamos vivos, certo?"

#game\ch1ep2.rpy:936
translate Portugues ch1ep2_2acbc28a:

#   mil "Unlike you, I'm nothing but a normal human being, so don't mind me trying to act all high and mighty once in a while."
    mil "Ao contrário de você, não sou nada além de um ser humano normal, então não se importe que eu tente agir de forma altiva e poderosa de vez em quando."

#game\ch1ep2.rpy:937
translate Portugues ch1ep2_b0716631:

#   mil "I'll be in your care, {i}Captain Number Four{/i}."
    mil "Estarei sob seus cuidados, {i}Capitão Número Quatro{/i}."

#game\ch1ep2.rpy:941
translate Portugues ch1ep2_f03d0a86:

#   m "The existence I entered into... was even worse."
    m "A existência em que entrei... foi ainda pior."

#game\ch1ep2.rpy:942
