#   m "Successful... subjects...?"
    m "Sucesso... assuntos...?"

#game\ch1ep2.rpy:924
translate Portugues ch1ep2_7c484afc:

#   mil "From now on, Lee Ha-Jeong is no longer of this world."
    mil "De agora em diante, Lee Ha-Jeong não é mais deste mundo."

#game\ch1ep2.rpy:925
