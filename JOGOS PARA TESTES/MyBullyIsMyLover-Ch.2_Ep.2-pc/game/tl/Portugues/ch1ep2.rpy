#game\ch1ep2.rpy:3502
translate Portugues klaradrunkshow_d7399ae6_1:

#   mc "Indeed. You had fun drinking all that wine and scaring the shit out of me."
    mc "De fato. Você se divertiu bebendo todo aquele vinho e me assustando."

#game\ch1ep2.rpy:3503
translate Portugues klaradrunkshow_fce58d2a_1:

#   k "Haah! I got you, didn't I?"
    k "Haah! Eu peguei você, não foi?"

#game\ch1ep2.rpy:3504
translate Portugues klaradrunkshow_eff3f577_1:

#   mc "Alright, alright, you did."
    mc "Tudo bem, tudo bem, você fez."

#game\ch1ep2.rpy:3505
translate Portugues klaradrunkshow_4423f75b_1:

#   mc "Now, rest. We both still have work tomorrow."
    mc "Agora, descanse. Nós dois ainda temos trabalho amanhã."

#game\ch1ep2.rpy:4678
translate Portugues gwenfamilyreconcilecontinue_8d3535c9:

#   emi "Sit, and sit properly."
    emi "Sente-se e sente-se corretamente."

#game\ch1ep2.rpy:4682
translate Portugues gwenfamilyreconcilecontinue_35caffc8:

#   emi "Your cooking was impressive given that you are not a chef."
    emi "Sua culinária foi impressionante, visto que você não é chef."

#game\ch1ep2.rpy:4683
translate Portugues gwenfamilyreconcilecontinue_85350c24:

#   emi "You know your ingredients and your flavors. Where did you learn?"
    emi "Você conhece seus ingredientes e seus sabores. Onde você aprendeu?"

#game\ch1ep2.rpy:4687
translate Portugues gwenfamilyreconcilecontinue_b38ae699:

#   mc "Ah, [landlady] used to work abroad when we were kids, so my [roommate] and I were forced to cook on our own."
    mc "Ah, [landlady] costumava trabalhar no exterior quando éramos crianças, então minha [roommate] e eu éramos forçados a cozinhar sozinhos."

#game\ch1ep2.rpy:4688
translate Portugues gwenfamilyreconcilecontinue_061115c4:

#   mc "We'd look into her secret recipes or through cookbooks. Sometimes, we'd search online."
    mc "Veríamos suas receitas secretas ou livros de receitas. Às vezes, pesquisávamos online."

#game\ch1ep2.rpy:4689
translate Portugues gwenfamilyreconcilecontinue_80753a6d:

#   mc "All those years of trial and error provided me with the knowledge I have for food."
    mc "Todos esses anos de tentativa e erro me proporcionaram o conhecimento que tenho sobre alimentação."

#game\ch1ep2.rpy:4692
translate Portugues gwenfamilyreconcilecontinue_c5e6c711:

#   emi "I see, that's interesting."
    emi "Entendo, isso é interessante."

#game\ch1ep2.rpy:4693
translate Portugues gwenfamilyreconcilecontinue_8cac4b4f:

#   emi "If given a chance, I would like to meet your [landlady]."
    emi "Se tiver uma chance, gostaria de conhecer seu [landlady]."

#game\ch1ep2.rpy:4694
translate Portugues gwenfamilyreconcilecontinue_0a81678e:

#   mc "I can arrange something."
    mc "Posso arranjar alguma coisa."

#game\ch1ep2.rpy:4695
translate Portugues gwenfamilyreconcilecontinue_3b5a6e27:

#   emi "Don't bother for now."
    emi "Não se preocupe por enquanto."

#game\ch1ep2.rpy:4696
translate Portugues gwenfamilyreconcilecontinue_ef1eab9d:

#   emi "So, I assume you want to know what happened?"
    emi "Então, presumo que você queira saber o que aconteceu?"

#game\ch1ep2.rpy:4697
translate Portugues gwenfamilyreconcilecontinue_95b9dfec:

#   mc "Glenn already told me what happened to you guys back then and that it was because of me."
    mc "Glenn já me contou o que aconteceu com vocês naquela época e que foi por minha causa."

#game\ch1ep2.rpy:4700
translate Portugues gwenfamilyreconcilecontinue_a17c044a:

#   mc "Sorry if I sound condescending, but I want to know your reason for casting Gwen out and going as far as to divorce Glenn."
    mc "Desculpe se pareço condescendente, mas quero saber o motivo para expulsar Gwen e chegar ao ponto de se divorciar de Glenn."

#game\ch1ep2.rpy:4701
translate Portugues gwenfamilyreconcilecontinue_e8444d54:

#   mc "What was on your mind? What did you think when you made those decisions?"
    mc "O que estava em sua mente? O que você pensou quando tomou essas decisões?"

#game\ch1ep2.rpy:4702
translate Portugues gwenfamilyreconcilecontinue_e70fcc3b:

#   mc "I got the gist of it, but I want to hear it from you directly without any pride in the way."
    mc "Entendi a essência, mas quero ouvi-la diretamente de você, sem nenhum orgulho."

#game\ch1ep2.rpy:4705
translate Portugues gwenfamilyreconcilecontinue_e86fd17c:

#   emi "Are you planning to reconcile my family? If so, I'd suggest you give it up."
    emi "Você está planejando reconciliar minha família? Se sim, sugiro que você desista."

#game\ch1ep2.rpy:4706
translate Portugues gwenfamilyreconcilecontinue_b057f41d:

#   emi "You saw our current state. I can't see a bright side to any of this."
    emi "Você viu nosso estado atual. Não consigo ver um lado positivo em nada disso."

#game\ch1ep2.rpy:4707
translate Portugues gwenfamilyreconcilecontinue_451eac65:

#   emi "So there is no point in telling you."
    emi "Portanto, não faz sentido contar a você."

#game\ch1ep2.rpy:4710
translate Portugues gwenfamilyreconcilecontinue_25356c1b:

#   mc "Perhaps.{w} But what's important to me is to know you better."
    mc "Talvez.{w} Mas o que é importante para mim é conhecer você melhor."

#game\ch1ep2.rpy:4711
translate Portugues gwenfamilyreconcilecontinue_ae82690b:

#   mc "I've come to understand both Gwen and Glenn. The only person left is you."
    mc "Passei a entender Gwen e Glenn. A única pessoa que resta é você."

#game\ch1ep2.rpy:4714
translate Portugues gwenfamilyreconcilecontinue_197f5721:

#   emi "And what are you going to do after this?"
    emi "E o que você vai fazer depois disso?"

#game\ch1ep2.rpy:4715
translate Portugues gwenfamilyreconcilecontinue_2d58d572:

#   mc "*chuckles* Nothing but celebrate your birthday. All three of us came here for that reason."
    mc "*risos* Nada além de comemorar seu aniversário. Nós três viemos aqui por esse motivo."

#game\ch1ep2.rpy:4718
translate Portugues gwenfamilyreconcilecontinue_3eb0bf33:

#   emi "..."
    emi "..."

#game\ch1ep2.rpy:4721
translate Portugues gwenfamilyreconcilecontinue_c26d9b37:

#   emi "Why bother?"
    emi "Porque se importar?"

#game\ch1ep2.rpy:4722
translate Portugues gwenfamilyreconcilecontinue_b2f1cfd0:

#   emi "I stopped celebrating my birthday so long ago that I forgot it was tomorrow."
    emi "Parei de comemorar meu aniversário há tanto tempo que esqueci que era amanhã."

#game\ch1ep2.rpy:4723
translate Portugues gwenfamilyreconcilecontinue_c7939c46:

#   yt "I was right."
    yt "Eu tinha razão."

#game\ch1ep2.rpy:4726
translate Portugues gwenfamilyreconcilecontinue_b73ca366:

#   mc "... You've got no one to celebrate it with, do you?"
    mc "... Você não tem com quem comemorar, não é?"

#game\ch1ep2.rpy:4729
translate Portugues gwenfamilyreconcilecontinue_6e28ef0d:

#   emi "There is still a thick wall between you and me, [mc]. Don't forget."
    emi "Ainda existe uma parede espessa entre você e eu, [mc]. Não se esqueça."

#game\ch1ep2.rpy:4732
translate Portugues gwenfamilyreconcilecontinue_8ac63fcc:

#   yt "That's the tone I want. Let's say something to bait her in..."
    yt "Esse é o tom que eu quero. Vamos dizer algo para atraí-la..."

#game\ch1ep2.rpy:4735
translate Portugues gwenfamilyreconcilecontinue_19a2e593:

#   mc "I apologize. I stepped out of line."
    mc "Peço desculpas. Saí da linha."

#game\ch1ep2.rpy:4736
translate Portugues gwenfamilyreconcilecontinue_f89214d2:

#   mc "However, you said you don't see a bright side. But if you ask me, {i}you{/i} are the bright side of your family."
    mc "No entanto, você disse que não vê o lado bom. Mas se você me perguntar, {i}você{/i} é o lado bom da sua família."

#game\ch1ep2.rpy:4737
translate Portugues gwenfamilyreconcilecontinue_d8ca5e39:

#   emi "What are you trying to say?"
    emi "O que você está tentando dizer?"

#game\ch1ep2.rpy:4740
translate Portugues gwenfamilyreconcilecontinue_bc0c964e:

#   yt "I need something that will contradict her beliefs to crack her open..."
    yt "Preciso de algo que contradiga suas crenças para quebrá-la..."

#game\ch1ep2.rpy:4741
translate Portugues gwenfamilyreconcilecontinue_12fdd4dd:

#   yt "Let's go [landlady] mode."
    yt "Vamos para o modo [landlady]."

#game\ch1ep2.rpy:4744
translate Portugues gwenfamilyreconcilecontinue_c0c69ff9:

#   mc "If you spoon-feed your student, they will never learn, Emilda."
    mc "Se você alimentar seu aluno com colher, ele nunca aprenderá, Emilda."

#game\ch1ep2.rpy:4745
translate Portugues gwenfamilyreconcilecontinue_4cc441ef:

#   emi "Hm, alright, keep your secrets. Regardless, I'm afraid I have to disagree."
    emi "Hm, tudo bem, guarde seus segredos. Independentemente disso, receio ter que discordar."

#game\ch1ep2.rpy:4748
translate Portugues gwenfamilyreconcilecontinue_6ec5ac02:

#   emi "Making someone learn should always be systematic. A course that everyone can follow."
    emi "Fazer alguém aprender deve ser sempre sistemático. Um curso que todos podem seguir."

#game\ch1ep2.rpy:4749
translate Portugues gwenfamilyreconcilecontinue_ee5592ad:

#   emi "I grew up in a family where systems, rules, and discipline were the keys to one's future and well-being."
    emi "Cresci em uma família onde sistemas, regras e disciplina eram as chaves para o futuro e o bem-estar."

#game\ch1ep2.rpy:4750
translate Portugues gwenfamilyreconcilecontinue_49f78bff:

#   emi "In my family, we believe that by adhering to these systems, one can achieve success and happiness."
    emi "Na minha família, acreditamos que aderindo a esses sistemas é possível alcançar sucesso e felicidade."

#game\ch1ep2.rpy:4753
translate Portugues gwenfamilyreconcilecontinue_29a952db:

#   emi "Perhaps my methods were too rigid, but I truly believed that by enforcing discipline, I was doing what was best for my family."
    emi "Talvez meus métodos fossem rígidos demais, mas eu realmente acreditava que, ao impor a disciplina, estava fazendo o que era melhor para minha família."

#game\ch1ep2.rpy:4754
translate Portugues gwenfamilyreconcilecontinue_a3782fc8:

#   emi "I never thought my strictness would push them away, leaving me all alone."
    emi "Nunca pensei que meu rigor iria afastá-los, deixando-me sozinho."

#game\ch1ep2.rpy:4755
translate Portugues gwenfamilyreconcilecontinue_ec133b82:

#   emi "Maybe it's hard for you to understand, but that is how I was raised."
    emi "Talvez seja difícil para você entender, mas foi assim que fui criado."

#game\ch1ep2.rpy:4756
translate Portugues gwenfamilyreconcilecontinue_9e331168:

#   emi "I thought it was the only way to secure a bright future for Gwen."
    emi "Achei que era a única maneira de garantir um futuro brilhante para Gwen."

#game\ch1ep2.rpy:4759
translate Portugues gwenfamilyreconcilecontinue_385b3f74:

#   emi "If you don't follow our ways, you'll never have friends, support, or the connections needed to thrive in this world."
    emi "Se você não seguir nossos caminhos, nunca terá amigos, apoio ou as conexões necessárias para prosperar neste mundo."

#game\ch1ep2.rpy:4760
translate Portugues gwenfamilyreconcilecontinue_0e7b903e:

#   emi "People like you who refuse to conform may find temporary happiness."
    emi "Pessoas como você, que se recusam a se conformar, podem encontrar felicidade temporária."

#game\ch1ep2.rpy:4761
translate Portugues gwenfamilyreconcilecontinue_e65f3f55:

#   emi "But in the long run, you'll be left behind, struggling to catch up with those who played by the rules."
    emi "Mas, no longo prazo, você ficará para trás, lutando para alcançar aqueles que seguiram as regras."

#game\ch1ep2.rpy:4764
translate Portugues gwenfamilyreconcilecontinue_bb8011e7:

#   emi "Now look what Gwen has become."
    emi "Agora veja o que Gwen se tornou."

#game\ch1ep2.rpy:4765
translate Portugues gwenfamilyreconcilecontinue_cc14d468:

#   emi "A vulgar woman with a major lack of respect."
    emi "Uma mulher vulgar com uma grande falta de respeito."

#game\ch1ep2.rpy:4766
translate Portugues gwenfamilyreconcilecontinue_c403a88b:

#   emi "I wanted to protect her from the harsh realities of the world, from being taken advantage of or making mistakes that would affect her future."
    emi "Eu queria protegê-la das duras realidades do mundo, de ser aproveitada ou de cometer erros que afetariam seu futuro."

#game\ch1ep2.rpy:4767
translate Portugues gwenfamilyreconcilecontinue_bcc98109:

#   emi "But instead, my attempts to control her only pushed her further away."
    emi "Mas em vez disso, minhas tentativas de controlá-la apenas a afastaram ainda mais."

#game\ch1ep2.rpy:4770
translate Portugues gwenfamilyreconcilecontinue_b65c4f87:

#   emi "When I heard about Gwen losing her maidenhood to a no-name high schooler without any reputation, I was devastated."
    emi "Quando soube que Gwen perdeu a virgindade para um estudante do ensino médio sem nome e sem qualquer reputação, fiquei arrasado."

#game\ch1ep2.rpy:4771
translate Portugues gwenfamilyreconcilecontinue_f926f390:

#   emi "I had done everything in my power up to that point to guide her on the right path, yet she still made choices I couldn't accept."
    emi "Eu tinha feito tudo ao meu alcance até aquele momento para guiá-la no caminho certo, mas ela ainda fez escolhas que não pude aceitar."

#game\ch1ep2.rpy:4772
translate Portugues gwenfamilyreconcilecontinue_e5c8c45a:

#   emi "I felt like a failure as a mother, and I couldn't fathom why my system didn't work with her."
    emi "Eu me sentia um fracasso como mãe e não conseguia entender por que meu sistema não funcionava com ela."

#game\ch1ep2.rpy:4773
translate Portugues gwenfamilyreconcilecontinue_90f1d941:

#   emi "Maybe I was too harsh, but I only wanted the best for her, for our family."
    emi "Talvez eu tenha sido muito duro, mas só queria o melhor para ela, para nossa família."

#game\ch1ep2.rpy:4774
translate Portugues gwenfamilyreconcilecontinue_7ff23ccc:

#   emi "I didn't want them to suffer the consequences of poor decisions, and I didn't want them to be left behind in a competitive world."
    emi "Eu não queria que eles sofressem as consequências de decisões erradas e não queria que fossem deixados para trás num mundo competitivo."

#game\ch1ep2.rpy:4775
translate Portugues gwenfamilyreconcilecontinue_a80babc5:

#   emi "But now I realize that in my quest to protect them, I might have done more harm than good."
    emi "Mas agora percebo que na minha busca para protegê-los, posso ter feito mais mal do que bem."

#game\ch1ep2.rpy:4778
translate Portugues gwenfamilyreconcilecontinue_5d8beb97:

#   emi "That being said, I never considered my ways as wrong, and I never will."
    emi "Dito isto, nunca considerei meus métodos errados e nunca considerarei."

#game\ch1ep2.rpy:4779
translate Portugues gwenfamilyreconcilecontinue_bee4ccb5:

#   emi "That is my {i}pride{/i} as-{w=0.7}{nw}"
    emi "Esse é o meu {i}orgulho{/i} como-{w=0.7}{nw}"

#game\ch1ep2.rpy:4785
translate Portugues gwenfamilyreconcilecontinue_dfdd7cc2:

#   emi "How did you..."
    emi "Como você..."

#game\ch1ep2.rpy:4786
translate Portugues gwenfamilyreconcilecontinue_72ae8b4c:

#   mc "I baited you in and triggered you with a point of contention."
    mc "Eu atraí você e desencadeei um ponto de discórdia."

#game\ch1ep2.rpy:4787
translate Portugues gwenfamilyreconcilecontinue_94f01c7a:

#   mc "Getting someone riled up gives them a reason to respond, especially when they have a strong sense of pride."
    mc "Irritar alguém dá-lhe um motivo para responder, especialmente quando tem um forte sentimento de orgulho."

#game\ch1ep2.rpy:4788
translate Portugues gwenfamilyreconcilecontinue_f08898d8:

#   mc "I just nudged you into sharing what I wanted to hear since our conversation started, and you did."
    mc "Acabei de incentivá-lo a compartilhar o que eu queria ouvir desde que nossa conversa começou, e você o fez."

#game\ch1ep2.rpy:4791
translate Portugues gwenfamilyreconcilecontinue_1a12119a:

#   e "Yes, you'll need it, but once you learn the methods behind it, please use this technique wisely and responsibly."
    e "Sim, você precisará dela, mas depois de aprender os métodos por trás dela, use essa técnica com sabedoria e responsabilidade."

#game\ch1ep2.rpy:4792
translate Portugues gwenfamilyreconcilecontinue_e5f13dcc:

#   e "It can backfire if the other person feels they've been tricked or forced into revealing more than they were comfortable with."
    e "O tiro pode sair pela culatra se a outra pessoa sentir que foi enganada ou forçada a revelar mais do que se sentia confortável."

#game\ch1ep2.rpy:4793
translate Portugues gwenfamilyreconcilecontinue_2051d66a:

#   mc "Understood."
    mc "Entendido."

#game\ch1ep2.rpy:4796
translate Portugues gwenfamilyreconcilecontinue_c2c6a127:

#   emi "Hahahahaa~! How amusing!"
    emi "Hahahaha ~! Que divertido!"

#game\ch1ep2.rpy:4799
translate Portugues gwenfamilyreconcilecontinue_661e6a59:

#   emi "*sighs* \"Eliciting information\". Very bold, but I must admit, it's impressive."
    emi "*suspira* \"Obtendo informações\". Muito ousado, mas devo admitir, é impressionante."

#game\ch1ep2.rpy:4800
translate Portugues gwenfamilyreconcilecontinue_6e9f0d19:

#   emi "Alright, you've triumphed over me again and, yet again, obtained what you wanted."
    emi "Tudo bem, você triunfou sobre mim novamente e, mais uma vez, obteve o que queria."

#game\ch1ep2.rpy:4801
translate Portugues gwenfamilyreconcilecontinue_a2f7c9f3:

#   emi "You're starting to earn my respect, so I'll allow you to converse with me more casually. But watch your words, dear."
    emi "Você está começando a ganhar meu respeito, então permitirei que converse comigo de maneira mais casual. Mas cuidado com suas palavras, querido."

#game\ch1ep2.rpy:4802
translate Portugues gwenfamilyreconcilecontinue_c2cf2978:

#   yt "Thanks, Em. All your advice and training paid off... Somehow."
    yt "Obrigado, Em. Todos os seus conselhos e treinamento valeram a pena... De alguma forma."

#game\ch1ep2.rpy:4805
translate Portugues gwenfamilyreconcilecontinue_dc4579dd:

#   mc "So it's \"dear\" now? I'm not sure I've earned that yet."
    mc "Então é \"querido\" agora? Não tenho certeza se mereci isso ainda."

#game\ch1ep2.rpy:4806
translate Portugues gwenfamilyreconcilecontinue_155755f4:

#   emi "Believe me, nobody -and I mean nobody- has ever made my mouth open up like that. You've earned it."
    emi "Acredite em mim, ninguém - e quero dizer ninguém - jamais fez minha boca se abrir assim. Você ganhou."

#game\ch1ep2.rpy:4807
translate Portugues gwenfamilyreconcilecontinue_2a725cd6:

#   mc "Thanks, Emilda. But... aren't you upset by what I did?"
    mc "Obrigado, Emilda. Mas... você não está chateado com o que eu fiz?"

#game\ch1ep2.rpy:4810
translate Portugues gwenfamilyreconcilecontinue_91d39761:

#   emi "That's the reaction you were expecting?"
    emi "Essa é a reação que você esperava?"

#game\ch1ep2.rpy:4811
translate Portugues gwenfamilyreconcilecontinue_06097ca0:

#   mc "Well, yeah..."
    mc "Bem, sim..."

#game\ch1ep2.rpy:4812
translate Portugues gwenfamilyreconcilecontinue_29abf1f3:

#   emi "Under different circumstances, I might have been."
    emi "Em circunstâncias diferentes, eu poderia ter sido."

#game\ch1ep2.rpy:4813
translate Portugues gwenfamilyreconcilecontinue_03a51343:

#   emi "However, candidly speaking, your food offering softened me up to your wiles."
    emi "No entanto, falando francamente, sua oferta de comida me amoleceu às suas artimanhas."

#game\ch1ep2.rpy:4814
translate Portugues gwenfamilyreconcilecontinue_2a35a1bc:

#   emi "Whether that was intentional or not, it deserves recognition."
    emi "Quer isso tenha sido intencional ou não, merece reconhecimento."

#game\ch1ep2.rpy:4815
translate Portugues gwenfamilyreconcilecontinue_a49715db:

#   emi "So, what can this old lady do for you now?"
    emi "Então, o que essa velha senhora pode fazer por você agora?"

#game\ch1ep2.rpy:4819
translate Portugues gwenfamilyreconcilecontinue_48708482:

#   mc "Like you said, I got what I wanted. So how about I do something for you instead?"
    mc "Como você disse, consegui o que queria. Então, que tal eu fazer algo por você?"

#game\ch1ep2.rpy:4820
translate Portugues gwenfamilyreconcilecontinue_bfd02199:

#   mc "I heard from Gwen you enjoy massages, apart from food."
    mc "Ouvi de Gwen que você gosta de massagens, além de comida."

#game\ch1ep2.rpy:4821
translate Portugues gwenfamilyreconcilecontinue_abb27215:

#   mc "I'm not an expert, but my technique can still help you relax."
    mc "Não sou especialista, mas minha técnica ainda pode ajudá-lo a relaxar."

#game\ch1ep2.rpy:4822
translate Portugues gwenfamilyreconcilecontinue_ad0eadba:

#   emi "Is that so? You've certainly done your homework."
    emi "É assim mesmo? Você certamente fez sua lição de casa."

#game\ch1ep2.rpy:4830
translate Portugues gwenfamilyreconcilecontinue_f9783631:

#   mc "She fell asleep while I gave her a shoulder massage."
    mc "Ela adormeceu enquanto eu lhe fazia uma massagem nos ombros."

#game\ch1ep2.rpy:4831
translate Portugues gwenfamilyreconcilecontinue_ce17a725:

#   gl "Well, she likes that. Didn't Gwen tell you?"
    gl "Bem, ela gosta disso. Gwen não te contou?"

#game\ch1ep2.rpy:4832
translate Portugues gwenfamilyreconcilecontinue_613a4ad9:

#   mc "She did."
    mc "Ela fez."

#game\ch1ep2.rpy:4835
translate Portugues gwenfamilyreconcilecontinue_65556b99:

#   gl "I'm quite impressed you lasted that long talking to her. Not everybody can."
    gl "Estou bastante impressionado por você ter durado tanto tempo conversando com ela. Nem todo mundo pode."

#game\ch1ep2.rpy:4836
translate Portugues gwenfamilyreconcilecontinue_67e209d0:

#   mc "Must be because I didn't find her that intimidating to begin with, so I wasn't afraid."
    mc "Deve ser porque eu não a achei tão intimidante para começar, então não tive medo."

#game\ch1ep2.rpy:4837
translate Portugues gwenfamilyreconcilecontinue_24c78c3f:

#   mc "Gwen also told me that she can sense fear and use that to her advantage during arguments."
    mc "Gwen também me disse que pode sentir o medo e usar isso a seu favor durante as discussões."

#game\ch1ep2.rpy:4838
translate Portugues gwenfamilyreconcilecontinue_5b3c027e:

#   gl "Hah, all the time. Don't I know it."
    gl "Hah, o tempo todo. Eu não sei disso."

#game\ch1ep2.rpy:4839
translate Portugues gwenfamilyreconcilecontinue_640a7b61:

#   gl "Anyway, let's take her to her room."
    gl "De qualquer forma, vamos levá-la para o quarto dela."

#game\ch1ep2.rpy:4850
translate Portugues gwenfamilyreconcilecontinue_bf12004b:

#   gl "*sighs* Still as beautiful as the day I lost you..."
    gl "*suspira* Ainda tão lindo quanto no dia em que perdi você..."

#game\ch1ep2.rpy:4853
translate Portugues gwenfamilyreconcilecontinue_47532556:

#   yt "So their feelings are mutual..."
