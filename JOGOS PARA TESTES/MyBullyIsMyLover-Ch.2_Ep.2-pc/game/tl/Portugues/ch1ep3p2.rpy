    a "Ah, você já escolheu uma mesa..."


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:3348
translate Portugues crackinganaineopen_fd37c85c:

#   m "It's the most secure spot here."
