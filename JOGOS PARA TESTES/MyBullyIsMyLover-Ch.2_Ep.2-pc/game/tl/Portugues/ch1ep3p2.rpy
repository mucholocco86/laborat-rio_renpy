# game/ch1ep3p2.rpy:4545
translate Portugues ainepubtensionbuildup_705efbf4:

#   a "Mom, wait!"
    a "Mãe, espere!"


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4546
