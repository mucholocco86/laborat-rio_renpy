    a "E-eu não sei, ok?! Eu acabei de..."

#game\ch1ep3p2.rpy:4775
translate Portugues aineonsteroids_2a1c4e90:

#   "Before Aine can finish her words, your hand shoots out and grabs her waist, pulling her roughly towards you."
    "Antes que Aine possa terminar suas palavras, sua mão dispara e agarra a cintura dela, puxando-a bruscamente em sua direção."

#game\ch1ep3p2.rpy:4776
