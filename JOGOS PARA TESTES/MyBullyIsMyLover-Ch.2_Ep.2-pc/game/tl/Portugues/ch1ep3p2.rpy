    a "Você... CADELA!"


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4599
translate Portugues ainepubtensionbuildup_c57a6bbe:

#   h "See? That's more like it."
    h "Ver? É mais assim."


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4600
translate Portugues ainepubtensionbuildup_1b5bec66:

#   a "I will never become like you! Remember that!"
    a "Eu nunca serei como você! Lembre-se disso!"


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4601
translate Portugues ainepubtensionbuildup_c31bf144:

#   h "Mm, at this point, you're already a cheap imitation of me!"
    h "Mm, neste ponto, você já é uma imitação barata de mim!"


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4602
