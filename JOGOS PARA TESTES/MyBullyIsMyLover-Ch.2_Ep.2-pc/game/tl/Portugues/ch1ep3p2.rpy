#   a "I may have the same personality as you, but I swear, I will never become a monster!"
    a "Posso ter a mesma personalidade que você, mas juro que nunca me tornarei um monstro!"


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4606
translate Portugues ainepubtensionbuildup_14a34921:

#   h "A fine kisser. Tell your [landlady] I said \"Hi\"."
    h "Um bom beijador. Diga ao seu [landlady] que eu disse \"Oi\"."


