#   h "Yes?"
    h "Sim?"


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4549
translate Portugues ainepubtensionbuildup_66a0d7d7:

#   a "After everything I've done for you..."
    a "Depois de tudo que fiz por você..."


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4550
translate Portugues ainepubtensionbuildup_c54e2135:

#   a "Were you... ever proud of me?"
    a "Você... já teve orgulho de mim?"


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4556
translate Portugues ainepubtensionbuildup_6a8e970e:

#   a "Mnh..."
    a "Hum..."


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4557
translate Portugues ainepubtensionbuildup_5c95de68:

#   h "You still love that, I see... I'm glad."
    h "Você ainda ama isso, eu vejo... estou feliz."


# NEW DIALOGUE 02/07/2024 18:23:08

# game/ch1ep3p2.rpy:4560
