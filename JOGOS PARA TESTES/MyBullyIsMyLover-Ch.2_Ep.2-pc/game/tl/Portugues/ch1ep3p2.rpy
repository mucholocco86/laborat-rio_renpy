#game\ch1ep3p2.rpy:4790
translate Portugues aineonsteroids_4774a43a:

#   "Your lips crash against hers in a desperate kiss as you stumble into the room, slamming the door shut behind you."
    "Seus lábios colidem contra os dela em um beijo desesperado enquanto você entra no quarto, batendo a porta atrás de você."

#game\ch1ep3p2.rpy:4791
translate Portugues aineonsteroids_e41baaa3:

