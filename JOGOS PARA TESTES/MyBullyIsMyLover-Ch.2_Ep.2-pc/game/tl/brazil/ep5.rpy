translate brazil ep5_355992af:

#   d "Emy~? Are you awake?"
    d "Emy? Você está acordada?"

# game/ep5.rpy:937
translate brazil ep5_5e775a4f:

#   em "Uhm... Yes, mom!"
    em "Hum... Sim, mãe!"

# game/ep5.rpy:938
