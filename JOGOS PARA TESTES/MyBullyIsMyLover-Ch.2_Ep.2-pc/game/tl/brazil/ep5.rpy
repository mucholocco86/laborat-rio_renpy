translate brazil ep5_5b644812:

#   em "Don't you like me too? You told me that I'm cute so many times already."
    em "Você também não gosta de mim? Você já me disse tantas vezes que sou fofa."

# game/ep5.rpy:2812
translate brazil ep5_348fbb38:

#   mc "I-I know! B-b-but that doesn't mean that I-"
    mc "Eu sei! Mas isso não significa que eu..."

