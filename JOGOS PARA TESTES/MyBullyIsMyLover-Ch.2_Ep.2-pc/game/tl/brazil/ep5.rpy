#   em "{i}*giggles* I think it's time! I'm really excited!{/i}"
    em "{i}*risinhos* Acho que chegou a hora! Estou muito animada!{/i}"

# game/ep5.rpy:946
translate brazil ep5_f0a9169b:

#   em "Hmm..."
    em "Hum..."

# game/ep5.rpy:956
translate brazil ep5_a331a00d:

#   em "There! You two just watch me, okay?"
    em "Pronto! Vocês dois fiquem só me observando, tá bom?"

