#   em "And... like this?"
    em "E... assim?"

# game/ep5.rpy:991
translate brazil ep5_c5a863c0:

#   d "Yes, but move your thumb to the middle of the blade a little bit."
    d "Sim, mas mova o polegar um pouco para o meio da lâmina."

# game/ep5.rpy:994
