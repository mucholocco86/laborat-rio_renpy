translate brazil ep5_1b5639ea:

#   em "Yes... I do. I want to follow the same path as my mother. I also want to be by Aine's side."
    em "Sim... quero. Quero seguir o mesmo caminho da minha mãe. Também quero estar ao lado da Aine."

# game/ep5.rpy:3270
translate brazil ep5_0dd9483b:

