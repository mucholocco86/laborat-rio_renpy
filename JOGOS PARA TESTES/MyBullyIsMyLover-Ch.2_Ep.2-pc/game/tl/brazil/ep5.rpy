    em "Ah, espere! Você trouxe sua câmera?"

# game/ep5.rpy:2840
translate brazil ep5_4bc50d4c:

#   mc "Hmmm... yeah, I think so. Why?"
    mc "Hum... sim, acho que sim. Por quê?"

