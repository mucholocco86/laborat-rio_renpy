translate brazil ep5_5c981cd5:

#   mc "S-s-stop kissing me! You're getting weird now, Emy! No one kissed me before!"
    mc "P-pare de me beijar! Você está ficando estranha, Emy! Ninguém nunca me beijou antes!"

# game/ep5.rpy:2802
translate brazil ep5_57e879d3:

#   em "Eh? But you just told me to be myself. So there you go!"
    em "Hein? Mas você acabou de me dizer para ser eu mesma. Então, pronto!"

# game/ep5.rpy:2803
translate brazil ep5_4519dfcf:

#   mc "B-b-but, why would you kiss me then?!"
    mc "M-mas, por que você me beijaria então?!"

