    h "Eu te conheço e sei o quanto você é sensível. Mas não precisamos dessas emoções, nem lá fora, nem aqui dentro. Entendeu?"

# game/ep5.rpy:3299
translate brazil ep5_6d3520f2:

#   em "Understood, madam."
    em "Entendido, senhora."

