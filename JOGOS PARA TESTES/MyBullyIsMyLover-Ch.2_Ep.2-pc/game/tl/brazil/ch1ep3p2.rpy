    mc "Sim. Cuide-se, Lily."

# game/ch1ep3p2.rpy:122
translate brazil ep3part2_2c0eac7c:

#   l "See you later, guys."
    l "Até mais, pessoal."

# game/ch1ep3p2.rpy:123
