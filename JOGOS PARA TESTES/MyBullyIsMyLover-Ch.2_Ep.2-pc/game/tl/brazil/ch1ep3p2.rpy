translate brazil aineonsteroids_5ed99f63:

#   mc "-Perhaps then, someone might brave the world you've created out of selfishness."
    mc "—Talvez então, alguém se aventure no mundo que você criou por puro egoísmo."

# game/ch1ep3p2.rpy:6024
translate brazil aineonsteroids_99094f6a:

#   mc "Tell her that."
    mc "Diga isso a ela."

# game/ch1ep3p2.rpy:6027
