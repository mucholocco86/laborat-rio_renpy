translate brazil moonpause3_61d7a612:

#   a "{i}It has nothing to do with recharging my energy."
    a "{i}Não tem nada a ver com recarregar minhas energias."

# game/ch1ep3p2.rpy:1829
translate brazil moonpause3_0aacd790:

#   a "{i}I just want him here with me so I don't feel so alone."
    a "{i}Eu só quero que ele esteja aqui comigo para que eu não me sinta tão sozinha."

# game/ch1ep3p2.rpy:1830
translate brazil moonpause3_a539938b:

#   a "{i}... Am I satisfied with this? Is this enough?"
    a "{i}...Estou satisfeito com isso? Isso é suficiente?"

# game/ch1ep3p2.rpy:1831
translate brazil moonpause3_fe95629b:

#   a "{i}... Yeah, this is all I could ever ask for."
    a "{i}... Sim, isso é tudo que eu poderia pedir."

# game/ch1ep3p2.rpy:1834
translate brazil moonpause3_c945c56f:

#   a "{i}But..."
    a "{i}Mas..."

# game/ch1ep3p2.rpy:1835
translate brazil moonpause3_36dfca31:

#   a "{i}That doesn't change the fact that he..."
    a "{i}Isso não muda o fato de que ele..."

# game/ch1ep3p2.rpy:1836
translate brazil moonpause3_a33fd0ef:

#   a "{i}... Was hurt by my actions and words in the past."
    a "{i}...Foi magoado(a) por minhas ações e palavras no passado."

# game/ch1ep3p2.rpy:1839
translate brazil moonpause3_369ebea9:

#   a "{i}Though we've settled it, this constant state of confusion never fades away."
    a "{i}Embora tenhamos resolvido a questão, esse estado constante de confusão nunca desaparece."

# game/ch1ep3p2.rpy:1840
translate brazil moonpause3_0ca7d4b9:

#   a "{i}Do I really know who I am?"
    a "{i}Será que eu realmente sei quem eu sou?"

# game/ch1ep3p2.rpy:1841
translate brazil moonpause3_e49995dd:

#   a "{i}Or am I... the person my mother shaped for her selfish goals?"
    a "{i}Ou será que sou eu... a pessoa que minha mãe moldou para atingir seus objetivos egoístas?"

# game/ch1ep3p2.rpy:1842
translate brazil moonpause3_43fd5443:

#   a "{i}Even after everything I said to him on the island..."
    a "{i}Mesmo depois de tudo que eu lhe disse na ilha..."

# game/ch1ep3p2.rpy:1843
translate brazil moonpause3_5b8e9187:

