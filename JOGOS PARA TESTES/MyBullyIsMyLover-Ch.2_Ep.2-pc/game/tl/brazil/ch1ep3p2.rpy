translate brazil moonpause3_ce4c5737:

#   a "Yeah, I'm halfway through the kids' final grades and assessments. I can do this."
    a "Sim, estou na metade das notas e avaliações finais das crianças. Eu consigo fazer isso."

# game/ch1ep3p2.rpy:1869
translate brazil moonpause3_00001359:

#   s "You're halfway, and yet look at your eyes. That's not normal."
    s "Você está na metade do caminho, e olhe para os seus olhos. Isso não é normal."

# game/ch1ep3p2.rpy:1872
translate brazil moonpause3_cfb78170:

#   a "{i}And if I stop, then what?!"
    a "{i}E se eu parar, o que acontece?!"

