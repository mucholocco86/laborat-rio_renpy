    mc "Mais tarde, vou te dar algo mais do que apenas um reforço de energia, ok?"

# game/ch1ep3p2.rpy:1851
translate brazil moonpause3_6e0d0286:

#   a "Yeah... alright..."
    a "Sim... tudo bem..."

