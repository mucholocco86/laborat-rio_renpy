translate brazil moonpause3_4076a738:

#   mc "Don't push yourself too hard, Aine. Rest when you need it. I'm sure Sky will understand."
    mc "Não se esforce demais, Aine. Descanse quando precisar. Tenho certeza de que Sky vai entender."

# game/ch1ep3p2.rpy:1824
translate brazil moonpause3_911a1aad:

#   a "{i}... Am I actually regaining energy from this?"
    a "{i}... Será que estou realmente recuperando energia com isso?"

# game/ch1ep3p2.rpy:1825
translate brazil moonpause3_25c4b8ec:

#   a "{i}No, not really."
    a "{i}Não, na verdade não."

