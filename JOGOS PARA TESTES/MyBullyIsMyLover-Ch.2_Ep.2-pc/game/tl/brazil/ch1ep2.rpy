#   mc "*deeply exhales*"
    mc "*expira profundamente*"

# game/ch1ep2.rpy:5629
translate brazil gwenfamilyreconcilecontinue_7016de74:

#   mc "... I ruined the moment, didn't I?"
    mc "... Eu estraguei o momento, não foi?"

# game/ch1ep2.rpy:5632
translate brazil gwenfamilyreconcilecontinue_dcf82223:

#   emi "Yes. Yes, you did."
    emi "Sim. Sim, você fez."

