translate brazil gwenfamilyreconcilecontinue_75e2040a:

#   mc "Ah, Klara used to work abroad, so Sky and I were forced to cook on our own."
    mc "Ah, a Klara trabalhava no exterior, então eu e a Sky éramos obrigadas a cozinhar sozinhas."

# game/ch1ep2.rpy:4680
