    mc "Bem, não está descartado. Mas o que você pretende fazer?"

# game/ch1ep2.rpy:5150
translate brazil gwenfamilyreconcilecontinue_faf14b5e:

#   g "I will make her understand..."
    g "Vou fazê-la entender..."

# game/ch1ep2.rpy:5151
