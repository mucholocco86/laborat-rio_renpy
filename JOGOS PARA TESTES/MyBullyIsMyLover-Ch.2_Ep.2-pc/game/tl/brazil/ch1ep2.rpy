#   g "It has to be me..."
    g "Tem que ser eu..."

# game/ch1ep2.rpy:5166
translate brazil gwenfamilyreconcilecontinue_6eff54d2:

#   shu "Ahoy, lads and lasses! The almighty gang has arrived!"
    shu "Olá, rapazes e moças! A turma toda chegou!"

