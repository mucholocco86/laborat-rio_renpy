# game/ch1ep2.rpy:5573
translate brazil gwenfamilyreconcilecontinue_3ee21aa5:

#   emi "Glenn, I..."
    emi "Glenn, eu..."

# game/ch1ep2.rpy:5574
translate brazil gwenfamilyreconcilecontinue_2b81e592:

#   gl "There's no need to explain, Emilda. I already know."
    gl "Não precisa explicar, Emilda. Eu já sei."

