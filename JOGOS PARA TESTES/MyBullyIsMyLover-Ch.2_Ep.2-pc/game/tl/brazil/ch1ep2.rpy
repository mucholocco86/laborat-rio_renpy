#   mil "I'll take that as a no."
    mil "Vou considerar isso como um não."

# game/ch1ep2.rpy:870
translate brazil ch1ep2_77f3c0de:

#   mf "And my money?"
    mf "E o meu dinheiro?"

# game/ch1ep2.rpy:876
