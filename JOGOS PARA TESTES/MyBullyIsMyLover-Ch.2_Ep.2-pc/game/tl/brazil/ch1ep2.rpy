translate brazil gwenfamilyreconcilecontinue_b2ed53f1:

#   shu "She's a streamer and does cosplay. Aside from Gwen, nobody else here has such impeccable fashion sense."
    shu "Ela é streamer e faz cosplay. Além da Gwen, ninguém mais aqui tem um senso de moda tão impecável."

# game/ch1ep2.rpy:5400
translate brazil gwenfamilyreconcilecontinue_01af35d6:

#   emi "Your name is Freya, right? Come give me a hand, dear."
    emi "Seu nome é Freya, certo? Venha me dar uma mão, querida."

