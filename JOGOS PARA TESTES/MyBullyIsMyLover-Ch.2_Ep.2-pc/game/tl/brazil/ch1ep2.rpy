    mc "Huh?"

# game/ch1ep2.rpy:5917
translate brazil gwenfamilyreconcilecontinue_dc8f68bb:

#   g "First, you got my dad on your side, which I did not expect."
    g "Primeiro, você conseguiu o apoio do meu pai, o que eu não esperava."

