translate brazil gwenfamilyreconcilecontinue_a6e5e621:

#   mc "... It's important."
    mc "... É importante."

# game/ch1ep2.rpy:5626
translate brazil gwenfamilyreconcilecontinue_849e71ea:

#   gl "..."
    gl "..."

# game/ch1ep2.rpy:5628
