translate brazil ch1ep2_a4208fd3:

#   mc "I don't usually come within seconds. So, I'm not that weak, you know?"
    mc "Eu geralmente não chego ao clímax em segundos. Então, eu não sou tão fraco assim, sabe?"

# game/ch1ep2.rpy:819
translate brazil ch1ep2_a596aff2:

