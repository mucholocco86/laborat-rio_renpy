translate brazil gwenfamilyreconcilecontinue_f4685d89:

#   emi "That sounds interesting. It's rare for a woman to take that kind of job nowadays."
    emi "Isso parece interessante. É raro uma mulher aceitar esse tipo de trabalho hoje em dia."

