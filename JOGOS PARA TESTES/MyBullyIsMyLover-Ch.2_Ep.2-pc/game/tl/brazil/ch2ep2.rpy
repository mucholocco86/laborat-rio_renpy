    nad "Quando era pequena, ela tinha pesadelos. Eu cantava para ela — sempre a mesma música. Ela se acalmava antes mesmo de eu terminar o primeiro verso."

# game/ch2ep2.rpy:3251
translate brazil sktabdinwikcont_d6ee86ca:

#   nad "Does she still get them?"
    nad "Ela ainda os recebe?"

# game/ch2ep2.rpy:3257
