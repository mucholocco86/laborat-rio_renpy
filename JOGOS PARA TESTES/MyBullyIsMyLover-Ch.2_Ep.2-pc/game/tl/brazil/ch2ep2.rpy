translate brazil sktabdinwikcont_d3aa3e28:

#   ela "You wanted to, but...?"
    ela "Você queria, mas...?"

# game/ch2ep2.rpy:3212
translate brazil sktabdinwikcont_b4ece550:

#   ela "Regardless, you took the money."
    ela "Independentemente disso, você aceitou o dinheiro."

