translate brazil sktabdinwikcont_c64b76de:

#   e "I'm going to see Leah."
    e "Vou visitar a Leah."

# game/ch2ep2.rpy:3286
translate brazil sktabdinwikcont_9ce9e735:

#   ela "Hey! Can I come?"
    ela "Ei! Posso ir junto?"

# game/ch2ep2.rpy:3287
translate brazil sktabdinwikcont_4c224c7c:

#   e "No. Do your job."
    e "Não. Faça o seu trabalho."

# game/ch2ep2.rpy:3290
translate brazil sktabdinwikcont_072cad4f:

#   ela "Damn it."
    ela "Caramba."

# game/ch2ep2.rpy:3314
translate brazil sktabdinwikcont_fc67d5f8:

#   e "What are you working on?"
    e "Em que você está trabalhando?"

# game/ch2ep2.rpy:3318
translate brazil sktabdinwikcont_d52693ad:

#   le "Nothing."
    le "Nada."

