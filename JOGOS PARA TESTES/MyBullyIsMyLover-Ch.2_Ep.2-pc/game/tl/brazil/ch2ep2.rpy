translate brazil sktabdinwikcont_fdcbacab:

#   ela "Did you believe him?"
    ela "Você acreditou nele?"

# game/ch2ep2.rpy:3209
translate brazil sktabdinwikcont_f2a7395d:

#   nad "I wanted to."
    nad "Eu queria."

