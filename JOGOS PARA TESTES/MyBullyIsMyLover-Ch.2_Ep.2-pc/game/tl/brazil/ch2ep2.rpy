translate brazil sktabdinwikcont_9f50831d:

#   ju "Alright. I'll send the forms tonight. Fill them out, don't skip anything, don't embellish. We clear?"
    ju "Certo. Enviarei os formulários hoje à noite. Preencha-os, não omita nada, não acrescente nada. Combinado?"

