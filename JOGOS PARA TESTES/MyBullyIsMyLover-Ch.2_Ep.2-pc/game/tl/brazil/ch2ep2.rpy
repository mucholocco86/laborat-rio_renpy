translate brazil sktabdinwikcont_84ea19db:

#   e "We're getting you out of here, okay?"
    e "Vamos tirar você daqui, ok?"

# game/ch2ep2.rpy:1137
translate brazil sktabdinwikcont_e0bb2415:

#   un "*nods*"
    un "*acena com a cabeça*"

# game/ch2ep2.rpy:1140
translate brazil sktabdinwikcont_20fd191c:

#   e "What's your name?"
    e "Qual o seu nome?"

# game/ch2ep2.rpy:1141
translate brazil sktabdinwikcont_d530ca92:

#   le "L-Leah..."
    le "L-Leah..."

# game/ch2ep2.rpy:1144
translate brazil sktabdinwikcont_b962a53c:

#   mc "Em! More coming!"
    mc "Eba! Mais novidades em breve!"

# game/ch2ep2.rpy:1145
translate brazil sktabdinwikcont_91c9b664:

#   e "Cover us!"
    e "Nos proteja!"

# game/ch2ep2.rpy:1162
translate brazil sktabdinwikcont_26360879:

#   e "Your arm."
    e "Seu braço."

# game/ch2ep2.rpy:1163
translate brazil sktabdinwikcont_24bbcd9f:

#   mc "I'm fine. Nothing vital. Just a graze."
    mc "Estou bem. Nada grave. Só um arranhão."

# game/ch2ep2.rpy:1166
translate brazil sktabdinwikcont_bb509e3a:

#   e "*sighs in relief*"
    e "*suspiros de alívio*"

# game/ch2ep2.rpy:1167
translate brazil sktabdinwikcont_3bae2f81:

#   e "Toss me the radio, please."
    e "Me passa o rádio, por favor."

# game/ch2ep2.rpy:1170
translate brazil sktabdinwikcont_82af8b70:

#   mc "Yeah, here."
    mc "Sim, aqui."

# game/ch2ep2.rpy:1174
translate brazil sktabdinwikcont_2971485a:

#   e "10-13! 10-13! This is Detective Meyer, badge 4-7-2-9. Code 3, requesting immediate backup."
    e "10-13! 10-13! Aqui é o Detetive Meyer, distintivo 4-7-2-9. Código 3, solicitando reforço imediato."

# game/ch2ep2.rpy:1176
translate brazil sktabdinwikcont_b9fc7971:

#   dis "Copy, 4-7-2-9. What's your 20?"
    dis "Cópia, 4-7-2-9. Qual é o seu 20?"

# game/ch2ep2.rpy:1178
translate brazil sktabdinwikcont_df02f9d3:

#   e "Club Ashen, industrial district off Harlow. We have a 10-34S, shots fired at officer, multiple suspects still inside."
    e "Clube Ashen, zona industrial perto de Harlow. Temos um caso de um policial com arma de fogo (10-34S), disparos contra um agente, vários suspeitos ainda dentro do local."

# game/ch2ep2.rpy:1180
translate brazil sktabdinwikcont_f5cea3b5:

#   dis "10-4. Nature of the incident?"
    dis "10-4. Qual a natureza do incidente?"

# game/ch2ep2.rpy:1182
translate brazil sktabdinwikcont_72bed6d4:

#   e "Suspected abduction of a tender age victim in progress. One juvenile recovered, currently in our custody."
    e "Suspeita-se de sequestro de uma vítima menor de idade em andamento. Um menor foi encontrado e encontra-se sob nossa custódia."

# game/ch2ep2.rpy:1183
translate brazil sktabdinwikcont_9ffcda52:

#   e "We have a multiple armed suspects shooting at officer on scene, approximately four to six individuals. Requesting units for a 10-34, Code 3."
    e "Temos vários suspeitos armados atirando contra policiais no local, aproximadamente quatro a seis indivíduos. Solicitamos reforços para uma ocorrência de código 3 (10-34)."

# game/ch2ep2.rpy:1187
translate brazil sktabdinwikcont_b9addad4:

#   dis "Copy that. Units en route. ETA three minutes. Do you need medical?"
    dis "Entendido. Unidades a caminho. Previsão de chegada em três minutos. Precisa de atendimento médico?"

# game/ch2ep2.rpy:1189
translate brazil sktabdinwikcont_f3c9512a:

#   e "Affirmative. We're transporting the victim to HC General now. Juvenile female, approximately ten years old, no visible injuries but needs evaluation."
    e "Afirmativo. Estamos encaminhando a vítima para o Hospital Geral de Houston neste momento. Trata-se de uma menina, com aproximadamente dez anos de idade, sem ferimentos visíveis, mas que precisa ser avaliada."

# game/ch2ep2.rpy:1191
translate brazil sktabdinwikcont_28102d84:

#   dis "10-4. I'll notify the hospital. Do you need an escort?"
    dis "Entendido. Vou avisar o hospital. Precisa de acompanhante?"

# game/ch2ep2.rpy:1193
translate brazil sktabdinwikcont_56a349c2:

#   e "Negative. We're clear of the scene, en route now."
    e "Negativo. Já saímos da área e estamos a caminho."

# game/ch2ep2.rpy:1195
translate brazil sktabdinwikcont_3df29ad9:

#   dis "Copy. Be advised, SWAT is rolling for building sweep. They'll secure the location."
    dis "Entendido. Atenção, a SWAT está a caminho para uma varredura no prédio. Eles irão isolar o local."

# game/ch2ep2.rpy:1197
translate brazil sktabdinwikcont_db0c8b2f:

#   e "Roger. Suspects are all armed. VIP section, basement level."
    e "Entendido. Todos os suspeitos estão armados. Área VIP, subsolo."

# game/ch2ep2.rpy:1199
translate brazil sktabdinwikcont_692f47c9:

#   dis "Confirmed. All available units, Code 3 to Club Ashen, industrial district. 10-34 in progress, suspects on scene are to be considered armed and dangerous."
    dis "Confirmado. Todas as unidades disponíveis, Código 3 para Club Ashen, zona industrial. Operação 10-34 em andamento, suspeitos no local devem ser considerados armados e perigosos."

# game/ch2ep2.rpy:1202
translate brazil sktabdinwikcont_3397b2ca:

#   mc "Hospital's twenty minutes out."
    mc "O hospital fica a vinte minutos daqui."

# game/ch2ep2.rpy:1203
translate brazil sktabdinwikcont_14e31841:

#   e "Let's move fast."
    e "Vamos agir rápido."

# game/ch2ep2.rpy:1208
translate brazil sktabdinwikcont_0f2bf8c3:

#   mc "You hear that? Help's coming. But we're getting you checked out first, okay?"
    mc "Você ouviu isso? A ajuda está a caminho. Mas primeiro vamos verificar se você está bem, ok?"

# game/ch2ep2.rpy:1219
translate brazil sktabdinwikcont_71b7e1c6:

#   e "We got her."
    e "Nós a pegamos."

# game/ch2ep2.rpy:1220
translate brazil sktabdinwikcont_4a1a43bc:

#   ela "Yeah, we caught the broadcast. Nice work, Em. You guys good?"
    ela "Sim, conseguimos captar a transmissão. Bom trabalho, Em. Vocês estão bem?"

# game/ch2ep2.rpy:1221
translate brazil sktabdinwikcont_4bb7cc3e:

#   e "We're all fine. Captain say anything?"
    e "Estamos todos bem. O capitão tem alguma coisa a dizer?"

# game/ch2ep2.rpy:1226
translate brazil sktabdinwikcont_3f644edc:

#   ela "Pfft. Not a word. But his mood's a little less murderous, so there's that."
    ela "Pff. Nem uma palavra. Mas o humor dele está um pouco menos assassino, então isso já é alguma coisa."

# game/ch2ep2.rpy:1227
translate brazil sktabdinwikcont_b70182d9:

#   ela "What are you gonna do after this?"
    ela "O que você vai fazer depois disso?"

# game/ch2ep2.rpy:1230
translate brazil sktabdinwikcont_711838f8:

#   e "Not sure yet. Still got a few things to sort out."
    e "Ainda não tenho certeza. Ainda tenho algumas coisas para resolver."

# game/ch2ep2.rpy:1231
translate brazil sktabdinwikcont_76c35da1:

#   ela "Alright. Take it easy."
    ela "Certo. Fique tranquilo."

# game/ch2ep2.rpy:1243
translate brazil sktabdinwikcont_4136e9fa:

#   mc "So what happens next?"
    mc "E agora, o que acontece?"

# game/ch2ep2.rpy:1247
translate brazil sktabdinwikcont_3c355718:

#   e "Medical check. Standard intake protocol."
    e "Exame médico. Protocolo padrão de admissão."

# game/ch2ep2.rpy:1248
translate brazil sktabdinwikcont_d98e5b9a:

#   e "Someone from CPS will talk—"
    e "Alguém do CPS falará —"

# game/ch2ep2.rpy:1256
translate brazil sktabdinwikcont_5f154800:

#   le "Am I going to be okay?"
    le "Eu vou ficar bem?"

# game/ch2ep2.rpy:1259
translate brazil sktabdinwikcont_fbb5f9f7:

#   e "You're..."
    e "Você é..."

# game/ch2ep2.rpy:1262
translate brazil sktabdinwikcont_844cd85d:

#   mc "You're going to be fine. We won't let anyone else hurt you."
    mc "Você vai ficar bem. Não vamos deixar ninguém mais te machucar."

# game/ch2ep2.rpy:1263
translate brazil sktabdinwikcont_462f2584:

#   le "*nods*"
    le "*acena com a cabeça*"

# game/ch2ep2.rpy:1270
translate brazil sktabdinwikcont_ba34b964:

#   e "Ah—"
    e "Ah—"

# game/ch2ep2.rpy:1286
translate brazil sktabdinwikcont_b93daa80:

#   nur "Detective Meyer?"
    nur "Detetive Meyer?"

# game/ch2ep2.rpy:1287
translate brazil sktabdinwikcont_92f16cc0:

#   e "Yeah."
    e "Sim."

# game/ch2ep2.rpy:1290
translate brazil sktabdinwikcont_7de6ee13:

#   nur "What do we have?"
    nur "O que temos?"

# game/ch2ep2.rpy:1291
translate brazil sktabdinwikcont_fe2568b5:

#   e "Juvenile female, approximately ten years old. Possible trafficking victim. No visible injuries, but she needs a full workup."
    e "Menina menor de idade, aproximadamente dez anos. Possível vítima de tráfico humano. Sem ferimentos visíveis, mas necessita de avaliação médica completa."

# game/ch2ep2.rpy:1294
translate brazil sktabdinwikcont_3c5143c6:

#   nur "Alright, let's get her to Exam Room 3."
    nur "Muito bem, vamos levá-la para a Sala de Exames 3."

# game/ch2ep2.rpy:1297
translate brazil sktabdinwikcont_0e5edbd1:

#   cara "Hey, sweetie. I'm Cara. We're gonna take a look at you, okay? Make sure everything's alright."
    cara "Oi, querida. Eu sou a Cara. Vamos te dar uma olhada, tá bom? Para garantir que está tudo bem."

# game/ch2ep2.rpy:1303
translate brazil sktabdinwikcont_a5ca0b37:

#   e "Hey, I'll be right here. I'm not going anywhere."
    e "Ei, eu vou ficar aqui. Não vou a lugar nenhum."

# game/ch2ep2.rpy:1304
translate brazil sktabdinwikcont_d34a812a:

#   le "Okay..."
    le "OK..."

# game/ch2ep2.rpy:1328
translate brazil sktabdinwikcont_6225666a:

#   mc "*exhales*"
    mc "*expira*"

# game/ch2ep2.rpy:1331
translate brazil sktabdinwikcont_0abc758b:

#   e "You shouldn't have told her that."
    e "Você não deveria ter contado isso para ela."

# game/ch2ep2.rpy:1332
translate brazil sktabdinwikcont_09152885:

#   mc "Em...?"
    mc "Em...?"

# game/ch2ep2.rpy:1335
translate brazil sktabdinwikcont_4831fc90:

#   e "In the car. You told her she'd be fine."
    e "No carro. Você disse a ela que tudo ficaria bem."

# game/ch2ep2.rpy:1338
translate brazil sktabdinwikcont_563d9fc3:

#   mc "What was I supposed to do? Tell her she's not?"
    mc "O que eu deveria ter feito? Dizer a ela que não era?"

# game/ch2ep2.rpy:1339
translate brazil sktabdinwikcont_ace504d1:

#   e "You don't lie to a kid who just crawled out of hell, [mc]. That's—"
    e "Você não mente para uma criança que acabou de sair do inferno. [mc]. Isso é-"

# game/ch2ep2.rpy:1340
translate brazil sktabdinwikcont_c6a1650e:

#   mc "What? I didn't lie."
    mc "O quê? Eu não menti."

# game/ch2ep2.rpy:1343
translate brazil sktabdinwikcont_f3b4b140:

#   e "You promised her something we can't guarantee."
    e "Você prometeu a ela algo que não podemos garantir."

# game/ch2ep2.rpy:1344
translate brazil sktabdinwikcont_97c62c49:

#   mc "I promised her we'd try."
    mc "Eu prometi a ela que tentaríamos."

# game/ch2ep2.rpy:1345
translate brazil sktabdinwikcont_ef84fab8:

#   e "And when trying isn't enough? What then?"
    e "E quando tentar não basta? O que fazer então?"

# game/ch2ep2.rpy:1346
translate brazil sktabdinwikcont_83d204fb:

#   mc "Then at least she knows someone gave a damn about her."
    mc "Assim, pelo menos, ela saberá que alguém se importou com ela."

# game/ch2ep2.rpy:1349
translate brazil sktabdinwikcont_217df29d:

#   e "[mc], that's... that's not how this works."
    e "[mc] Não é assim que funciona."

# game/ch2ep2.rpy:1350
translate brazil sktabdinwikcont_5f9f194a:

#   mc "Then how does it work, Em? Walk me through it."
    mc "Então, como funciona, Em? Me explica."

# game/ch2ep2.rpy:1352
translate brazil sktabdinwikcont_aa1f843c:

#   mc "Because from where I'm standing, you wanted me to tell a kid who just \"crawled out of hell\" that she's safe tonight, but tomorrow brings another hell of its own."
    mc "Porque, do meu ponto de vista, você queria que eu dissesse a uma criança que acabou de \"sair rastejando do inferno\" que ela está segura esta noite, mas que amanhã trará outro inferno."

# game/ch2ep2.rpy:1353
translate brazil sktabdinwikcont_aeefc00d:

#   mc "Paperwork, interviews, therapy, maybe a foster home she'll probably age out of."
    mc "Documentação, entrevistas, terapia, talvez um lar adotivo do qual ela provavelmente sairá ao atingir a maioridade."

# game/ch2ep2.rpy:1354
translate brazil sktabdinwikcont_09a99e1c:

#   mc "Is that what you had in mind?"
    mc "Era isso que você tinha em mente?"

# game/ch2ep2.rpy:1355
translate brazil sktabdinwikcont_e767ddfc:

#   e "I just wanted you to be honest with her."
    e "Eu só queria que você fosse honesto com ela."

# game/ch2ep2.rpy:1356
translate brazil sktabdinwikcont_aeec484c:

#   mc "I was."
    mc "Eu era."

# game/ch2ep2.rpy:1357
translate brazil sktabdinwikcont_841267c2:

#   e "You told her she'd be fine."
    e "Você disse a ela que tudo ficaria bem."

# game/ch2ep2.rpy:1358
translate brazil sktabdinwikcont_986f8ad6:

#   mc "Yeah. And maybe she will be."
    mc "Sim. E talvez ela seja."

# game/ch2ep2.rpy:1361
translate brazil sktabdinwikcont_762e50fa:

#   e "You don't know that. WE don't know that."
    e "Você não sabe disso. Nós não sabemos disso."

# game/ch2ep2.rpy:1362
translate brazil sktabdinwikcont_a23c8019:

#   mc "So we just say nothing? Let her sit there wondering if she's about to get thrown back into the same nightmare?"
    mc "Então, simplesmente não dizemos nada? Deixamos ela sentada lá, se perguntando se vai ser jogada de volta no mesmo pesadelo?"

# game/ch2ep2.rpy:1363
translate brazil sktabdinwikcont_807277d5:

#   e "We tell her what's real. That's the job."
    e "Dizemos a ela o que é real. Esse é o nosso trabalho."

# game/ch2ep2.rpy:1366
translate brazil sktabdinwikcont_5eb5d592:

#   mc "Then I must've missed the memo, because for all I know, the JOB is to protect her."
    mc "Então devo ter perdido o memorando, porque, pelo que sei, o TRABALHO é protegê-la."

# game/ch2ep2.rpy:1367
translate brazil sktabdinwikcont_7b1b0bca:

#   mc "And right now, that means not dumping the full weight of the system on her shoulders while she's still shaking."
    mc "E neste momento, isso significa não despejar todo o peso do sistema sobre os ombros dela enquanto ela ainda está abalada."

# game/ch2ep2.rpy:1368
translate brazil sktabdinwikcont_a420b8b5:

#   e "She deserves to know what's coming."
    e "Ela merece saber o que está por vir."

# game/ch2ep2.rpy:1369
translate brazil sktabdinwikcont_9c55a606:

#   mc "No. More than anything, she deserves to feel safe first."
    mc "Não. Acima de tudo, ela merece se sentir segura."

# game/ch2ep2.rpy:1370
translate brazil sktabdinwikcont_6eee5103:

#   e "And tomorrow? When reality hits?"
    e "E amanhã? Quando a realidade bater à porta?"

# game/ch2ep2.rpy:1371
translate brazil sktabdinwikcont_033c9475:

#   mc "Tomorrow she's stronger. Tomorrow she'll have had one night where she knew there were people in her corner, looking out for her."
    mc "Amanhã ela estará mais forte. Amanhã ela terá tido uma noite em que soube que havia pessoas ao seu lado, cuidando dela."

# game/ch2ep2.rpy:1372
translate brazil sktabdinwikcont_068d2a81:

#   mc "That matters."
    mc "Isso importa."

# game/ch2ep2.rpy:1375
translate brazil sktabdinwikcont_2ece9e2b:

#   e "Until it doesn't. Until she's sitting in some intake office realizing we fed her the same line everyone else did."
    e "Até que não funcione mais. Até que ela esteja sentada em alguma sala de triagem, percebendo que lhe dissemos a mesma coisa que a todos os outros."

# game/ch2ep2.rpy:1376
translate brazil sktabdinwikcont_55802b67:

#   mc "Or—hear me out, Em—she remembers that two people pulled her out of that place and didn't treat her like a case number."
    mc "Ou então... me escuta, Em... ela se lembra de que duas pessoas a tiraram daquele lugar e não a trataram como um número de caso."

# game/ch2ep2.rpy:1377
translate brazil sktabdinwikcont_a0f7e8ad:

#   e "She IS a case number, [mc]! The second CPS gets involved, that's exactly what she becomes!"
    e "Ela É um número de processo, [mc] Assim que o Conselho Tutelar se envolve, é exatamente nisso que ela se transforma!"

# game/ch2ep2.rpy:1378
translate brazil sktabdinwikcont_c90e3940:

#   mc "To them, maybe. Not to me. What about you?"
    mc "Para eles, talvez. Para mim, não. E para você?"

# game/ch2ep2.rpy:1379
translate brazil sktabdinwikcont_3a7eeafe:

#   e "I don't know. Because we're not different. We're part of the same machine."
    e "Não sei. Porque não somos diferentes. Fazemos parte da mesma máquina."

# game/ch2ep2.rpy:1382
translate brazil sktabdinwikcont_d8157073:

#   mc "Well fuck the machine then!"
    mc "Então que se dane a máquina!"

# game/ch2ep2.rpy:1388
translate brazil sktabdinwikcont_d6dfa63c:

#   e "In this line of work, we don't get to choose what they need. We only—ONLY—tell them what's real."
    e "Neste ramo de atividade, não podemos escolher o que eles precisam. Nós apenas — SOMENTE — dizemos a eles o que é real."

# game/ch2ep2.rpy:1391
translate brazil sktabdinwikcont_ee4283c3:

#   mc "And that's exactly why they stop trusting cops."
    mc "E é exatamente por isso que eles param de confiar na polícia."

# game/ch2ep2.rpy:1395
translate brazil sktabdinwikcont_b0d177f1:

#   mc "You think I don't know how this ends? I know the numbers. I know most of these kids don't get happy endings."
    mc "Você acha que eu não sei como isso termina? Eu conheço os números. Sei que a maioria dessas crianças não tem finais felizes."

# game/ch2ep2.rpy:1396
translate brazil sktabdinwikcont_ee37194b:

#   mc "But she didn't need to hear that tonight."
    mc "Mas ela não precisava ouvir isso esta noite."

# game/ch2ep2.rpy:1399
translate brazil sktabdinwikcont_6b804554:

#   e "So we lie? That's where we're at?"
    e "Então mentimos? É essa a situação em que nos encontramos?"

# game/ch2ep2.rpy:1400
translate brazil sktabdinwikcont_17537692:

#   mc "We give her hope, Em. Even if only a sliver."
    mc "Damos a ela esperança, Em. Mesmo que seja apenas uma pequena parcela."

# game/ch2ep2.rpy:1401
translate brazil sktabdinwikcont_e0b82230:

#   e "Hope without a foundation is just another word for false comfort."
    e "Esperança sem fundamento é apenas outra palavra para falso conforto."

# game/ch2ep2.rpy:1402
translate brazil sktabdinwikcont_0bc0b3c2:

#   e "You run a charity. You of all people know that."
    e "Você dirige uma instituição de caridade. Você, mais do que ninguém, sabe disso."

# game/ch2ep2.rpy:1406
translate brazil sktabdinwikcont_98dc506b:

#   e "They told me she'd be fine."
    e "Disseram-me que ela ficaria bem."

# game/ch2ep2.rpy:1407
translate brazil sktabdinwikcont_1ef706f6:

#   mc "Who?"
    mc "Quem?"

# game/ch2ep2.rpy:1408
translate brazil sktabdinwikcont_877ba26e:

#   e "My mom. The doctors. All of them."
    e "Minha mãe. Os médicos. Todos eles."

# game/ch2ep2.rpy:1409
translate brazil sktabdinwikcont_c01f8dcf:

#   e "And I just... sat there. Believing it like an idiot."
    e "E eu simplesmente... fiquei lá sentado. Acreditando nisso como um idiota."

# game/ch2ep2.rpy:1410
translate brazil sktabdinwikcont_4ea90856:

#   mc "Em..."
    mc "Em..."

# game/ch2ep2.rpy:1411
translate brazil sktabdinwikcont_4ea2c7c2:

#   e "She wasn't fine."
    e "Ela não estava bem."

# game/ch2ep2.rpy:1414
translate brazil sktabdinwikcont_ebd3028c:

#   e "What happens when she figures out we couldn't keep that promise?"
    e "O que acontece quando ela perceber que não conseguimos cumprir essa promessa?"

# game/ch2ep2.rpy:1418
translate brazil sktabdinwikcont_d0896963:

#   e "*shaking* Why am I like this?"
    e "*tremendo* Por que sou assim?"

# game/ch2ep2.rpy:1419
translate brazil sktabdinwikcont_05adefbe:

#   e "Maybe I... shouldn't have taken this case, after all."
    e "Talvez eu... não devesse ter aceitado esse caso, afinal."

# game/ch2ep2.rpy:1424
translate brazil sktabdinwikcont_83b6c10b:

#   mc "Alright... that's enough."
    mc "Muito bem... já chega."

# game/ch2ep2.rpy:1425
translate brazil sktabdinwikcont_5ec9622f:

#   mc "Listen to me."
    mc "Escute-me."

# game/ch2ep2.rpy:1426
translate brazil sktabdinwikcont_42b8dc40:

#   mc "You're not your mom. And Leah's not you."
    mc "Você não é sua mãe. E Leah não é você."

# game/ch2ep2.rpy:1427
translate brazil sktabdinwikcont_5f61ad06:

#   mc "What happened to your mom—that wasn't about hope. That was about something nobody could control."
    mc "O que aconteceu com sua mãe não teve nada a ver com esperança. Teve a ver com algo que ninguém podia controlar."

# game/ch2ep2.rpy:1428
translate brazil sktabdinwikcont_09236b9f:

#   mc "This? This is different."
    mc "Isto? Isto é diferente."

# game/ch2ep2.rpy:1439
translate brazil sktabdinwikcont_fc11ed78:

#   mc "What happened to your mom—that wasn't about hope. That was something nobody could control."
    mc "O que aconteceu com sua mãe não teve nada a ver com esperança. Foi algo que ninguém podia controlar."

# game/ch2ep2.rpy:1444
translate brazil sktabdinwikcont_0078bc37:

#   doc "Detective Meyer?"
    doc "Detetive Meyer?"

# game/ch2ep2.rpy:1447
