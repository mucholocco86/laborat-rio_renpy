# game/ch2ep2.rpy:5284
translate brazil sktabdinwikcont_a3026c19:

#   mc "Moon."
    mc "Lua."

# game/ch2ep2.rpy:5286
translate brazil sktabdinwikcont_1ecf1d2e:

#   mc "Not a word."
    mc "Nem uma palavra."

# game/ch2ep2.rpy:5287
translate brazil sktabdinwikcont_b08b2993:

#   m "I didn't say anything."
    m "Eu não disse nada."

# game/ch2ep2.rpy:5317
translate brazil sktabdinwikcont_23740f66:

#   un "Temporary placement. Seems like that didn't pan out your way."
    un "Colocação temporária. Parece que não deu certo para você."

# game/ch2ep2.rpy:5322
translate brazil sktabdinwikcont_7306aa27:

#   fr "You look tired."
    fr "Você parece cansado(a)."

# game/ch2ep2.rpy:5323
translate brazil sktabdinwikcont_6bd6a2b4:

#   mc "Francis."
    mc "Francisco."

# game/ch2ep2.rpy:5324
translate brazil sktabdinwikcont_e6cd57cf:

#   fr "Glad you didn't run."
    fr "Que bom que você não fugiu."

# game/ch2ep2.rpy:5325
translate brazil sktabdinwikcont_0bf63b55:

#   mc "I don't. Never had the tail and legs for it like you did."
    mc "Não. Nunca tive a cauda e as pernas como você."

# game/ch2ep2.rpy:5331
translate brazil sktabdinwikcont_c65eb5e3:

#   fr "There's a man outside. Blue sedan, second from the corner."
    fr "Tem um homem lá fora. Sedan azul, o segundo da esquina."

# game/ch2ep2.rpy:5332
translate brazil sktabdinwikcont_e3bd7154:

#   fr "If I don't walk out of here in the next five minutes, he makes a call."
    fr "Se eu não sair daqui nos próximos cinco minutos, ele vai fazer uma ligação."

# game/ch2ep2.rpy:5333
translate brazil sktabdinwikcont_4fb23f57:

#   fr "Not to the police."
    fr "Não à polícia."

# game/ch2ep2.rpy:5339
translate brazil sktabdinwikcont_f5482047:

#   mc "Nobody asked."
    mc "Ninguém perguntou."

# game/ch2ep2.rpy:5340
translate brazil sktabdinwikcont_4d57247d:

#   fr "A year later and you're still just as annoying."
    fr "Um ano depois e você continua tão irritante quanto antes."

# game/ch2ep2.rpy:5343
translate brazil sktabdinwikcont_09b07226:

#   fr "I'm not saying it as a threat."
    fr "Não estou dizendo isso como uma ameaça."

# game/ch2ep2.rpy:5344
translate brazil sktabdinwikcont_ddadc9b1:

#   fr "I'm saying it so you know exactly why you're going to sit there and hear me out."
    fr "Estou dizendo isso para que você saiba exatamente por que vai ficar aí sentado me ouvindo."

# game/ch2ep2.rpy:5351
translate brazil sktabdinwikcont_9466e04d:

#   mc "Sure. Just try not to breathe too hard. I can smell the money from here."
    mc "Claro. Só tente não respirar muito forte. Consigo sentir o cheiro do dinheiro daqui."

# game/ch2ep2.rpy:5357
translate brazil sktabdinwikcont_212c5ea0:

#   fr "You followed the rules."
    fr "Você seguiu as regras."

# game/ch2ep2.rpy:5359
translate brazil sktabdinwikcont_60892bb9:

#   fr "Submitted the request. Went through the proper channels."
    fr "O pedido foi submetido e encaminhado pelos canais adequados."

# game/ch2ep2.rpy:5360
translate brazil sktabdinwikcont_3ae6e0ba:

#   fr "And yet... there it is."
    fr "E, no entanto... lá está."

# game/ch2ep2.rpy:5361
translate brazil sktabdinwikcont_679ccfc1:

#   fr "The rules told you no."
    fr "As regras diziam que não."

# game/ch2ep2.rpy:5362
translate brazil sktabdinwikcont_a2040074:

#   mc "The rules exist for a reason."
    mc "As regras existem por um motivo."

# game/ch2ep2.rpy:5363
translate brazil sktabdinwikcont_1b828a7f:

#   fr "They exist to protect the system, not the child."
    fr "Eles existem para proteger o sistema, não a criança."

# game/ch2ep2.rpy:5364
translate brazil sktabdinwikcont_18d93e86:

#   mc "That's not—"
    mc "Isso não é—"

# game/ch2ep2.rpy:5365
translate brazil sktabdinwikcont_e7ccfd5c:

#   fr "You filled out forms, [mc]."
    fr "Você preencheu formulários, [mc]."

# game/ch2ep2.rpy:5366
translate brazil sktabdinwikcont_115bafc6:

#   fr "While she was sitting in a hospital room waiting for someone to decide what happens to her next."
    fr "Enquanto ela estava sentada em um quarto de hospital, aguardando que alguém decidisse o que aconteceria com ela em seguida."

# game/ch2ep2.rpy:5367
translate brazil sktabdinwikcont_3aef90ae:

#   fr "You filled out forms."
    fr "Você preencheu formulários."

# game/ch2ep2.rpy:5371
translate brazil sktabdinwikcont_b7299ed5:

#   fr "I don't fill out forms."
    fr "Eu não preencho formulários."

# game/ch2ep2.rpy:5372
translate brazil sktabdinwikcont_4559a97d:

#   mc "Of course not. Paperwork's beneath you. You've got children to collect."
    mc "Claro que não. Burocracia é coisa para você. Você tem filhos para buscar na escola."

# game/ch2ep2.rpy:5373
translate brazil sktabdinwikcont_ba016906:

#   fr "I find them. I take them somewhere safe."
    fr "Eu os encontro. Eu os levo para um lugar seguro."

# game/ch2ep2.rpy:5374
translate brazil sktabdinwikcont_ebe5faba:

#   fr "I don't wait for a system to tell me whether I'm allowed to care."
    fr "Eu não espero que um sistema me diga se tenho permissão para me importar."

# game/ch2ep2.rpy:5375
translate brazil sktabdinwikcont_a6f15df2:

#   mc "Keep telling yourself that, Francis."
    mc "Continue repetindo isso para si mesmo, Francis."

# game/ch2ep2.rpy:5376
translate brazil sktabdinwikcont_96a1a768:

#   fr "I intend to."
    fr "Pretendo fazer isso."

# game/ch2ep2.rpy:5385
translate brazil sktabdinwikcont_c76bdd0c:

#   fr "I heard about Club Ashen."
    fr "Ouvi falar do Club Ashen."

# game/ch2ep2.rpy:5386
translate brazil sktabdinwikcont_28adf5dd:

#   fr "... She cried when I first brought her in, you know."
    fr "... Ela chorou quando a trouxe pela primeira vez, sabe?"

# game/ch2ep2.rpy:5387
translate brazil sktabdinwikcont_54748201:

#   fr "She gets overwhelmed by kindness. Most of them do, at first."
    fr "Ela fica impressionada com a gentileza. A maioria delas fica assim, no começo."

# game/ch2ep2.rpy:5394
translate brazil sktabdinwikcont_44409e1c:

#   fr "She is not yours."
    fr "Ela não é sua."

# game/ch2ep2.rpy:5395
translate brazil sktabdinwikcont_0d292ecf:

#   mc "Nor is she yours."
    mc "Ela também não é sua."

# game/ch2ep2.rpy:5396
translate brazil sktabdinwikcont_ff35d4b4:

#   fr "That's where you're wrong."
    fr "É aí que você se engana."

# game/ch2ep2.rpy:5397
translate brazil sktabdinwikcont_f10b9d44:

#   fr "I spent four months with her."
    fr "Passei quatro meses com ela."

# game/ch2ep2.rpy:5398
translate brazil sktabdinwikcont_5ad2b33b:

#   fr "Four months of her learning to trust a place. Learning to trust a voice."
    fr "Quatro meses aprendendo a confiar em um lugar. Aprendendo a confiar em uma voz."

# game/ch2ep2.rpy:5399
translate brazil sktabdinwikcont_2717d645:

#   fr "You had her for a few days."
    fr "Você a teve por alguns dias."

# game/ch2ep2.rpy:5400
translate brazil sktabdinwikcont_2831dd49:

#   mc "A few days were enough to see what four months looked like on her."
    mc "Bastaram alguns dias para ver como quatro meses de gravidez a afetavam."

# game/ch2ep2.rpy:5403
translate brazil sktabdinwikcont_c3017b75:

#   fr "She reminds me of my sister."
    fr "Ela me lembra minha irmã."

# game/ch2ep2.rpy:5407
translate brazil sktabdinwikcont_0bb516ae:

#   fr "She used to follow me everywhere. Wanted to do everything I did."
    fr "Ela costumava me seguir para todo lado. Queria fazer tudo o que eu fazia."

# game/ch2ep2.rpy:5408
translate brazil sktabdinwikcont_637ff282:

#   fr "I told her to wait inside once. I told her I'd be right back."
    fr "Eu disse para ela esperar lá dentro. Disse que já voltava."

# game/ch2ep2.rpy:5411
translate brazil sktabdinwikcont_10554933:

#   wait "Can I get you anything?"
    wait "Posso lhe oferecer alguma coisa?"

# game/ch2ep2.rpy:5412
translate brazil sktabdinwikcont_dc44d798:

#   fr "Coffee. Black, please."
    fr "Café. Preto, por favor."

# game/ch2ep2.rpy:5413
translate brazil sktabdinwikcont_c3297c2e:

#   wait "Sure thing."
    wait "Claro que sim."

# game/ch2ep2.rpy:5416
translate brazil sktabdinwikcont_4a2d1dbf:

#   wait "Refill for you, hon?"
    wait "Mais um copo para você, querida?"

# game/ch2ep2.rpy:5417
translate brazil sktabdinwikcont_34cd6e17:

#   mc "I'm good."
    mc "Estou bem."

# game/ch2ep2.rpy:5418
translate brazil sktabdinwikcont_d8dd3e2e:

#   wait "Be right back."
    wait "Volto logo."

# game/ch2ep2.rpy:5424
translate brazil sktabdinwikcont_57ecbc71:

#   mc "What do you really want?"
    mc "O que você realmente quer?"

# game/ch2ep2.rpy:5426
translate brazil sktabdinwikcont_0c91e40d:

#   fr "I want you to understand something."
    fr "Quero que você entenda uma coisa."

# game/ch2ep2.rpy:5427
translate brazil sktabdinwikcont_52372e69:

#   mc "You went above and beyond to find me just to tell me \"something\"?"
    mc "Você se esforçou ao máximo para me encontrar só para me dizer \"algo\"?"

# game/ch2ep2.rpy:5428
translate brazil sktabdinwikcont_dc435192:

#   fr "I'm not hurting them."
    fr "Eu não estou lhes fazendo mal."

# game/ch2ep2.rpy:5429
translate brazil sktabdinwikcont_39a1e144:

#   mc "A ten-year-old girl, basement, candy jar. Yeah, real homey setup you had going."
    mc "Uma menina de dez anos, porão, pote de doces. É, um ambiente bem aconchegante que você tinha montado."

# game/ch2ep2.rpy:5432
translate brazil sktabdinwikcont_7231ecf0:

#   fr "I gave her somewhere safe and quiet. I took care of her."
    fr "Eu a levei para um lugar seguro e tranquilo. Eu cuidei dela."

# game/ch2ep2.rpy:5433
translate brazil sktabdinwikcont_be683774:

#   mc "Right. Because nothing says \"taken care of\" like a cheap mattress in an isolated room."
    mc "Certo. Porque nada demonstra mais cuidado do que um colchão barato em um quarto isolado."

# game/ch2ep2.rpy:5434
translate brazil sktabdinwikcont_25079b86:

#   fr "Until I could find what was missing."
    fr "Até que eu conseguisse encontrar o que estava faltando."

# game/ch2ep2.rpy:5437
translate brazil sktabdinwikcont_0e574dce:

#   yt "He's different."
    yt "Ele é diferente."

# game/ch2ep2.rpy:5438
translate brazil sktabdinwikcont_b5847bd7:

#   yt "Not the same guy who stood over me and made speeches like he was reading from a script."
    yt "Não é o mesmo cara que ficava me encarando e discursava como se estivesse lendo um roteiro."

# game/ch2ep2.rpy:5439
translate brazil sktabdinwikcont_fd5a65e4:

#   yt "That Francis wanted a reaction. This one doesn't. What the hell happened to him?"
    yt "Aquele Francisco queria uma reação. Este não. Que diabos aconteceu com ele?"

# game/ch2ep2.rpy:5443
translate brazil sktabdinwikcont_ec7e0a37:

#   wait "Here you go."
    wait "Aqui você vai."

# game/ch2ep2.rpy:5444
translate brazil sktabdinwikcont_90a640e6:

#   fr "Thank you."
    fr "Obrigado."

# game/ch2ep2.rpy:5447
translate brazil sktabdinwikcont_b7cb868b:

#   mc "Those children are not a missing piece, Francis. Leah's just a kid."
    mc "Essas crianças não são uma peça que falta, Francis. Leah é apenas uma criança."

# game/ch2ep2.rpy:5448
translate brazil sktabdinwikcont_81acee0e:

#   fr "I know what she is. I also know what she carries, whether she knows it or not."
    fr "Eu sei o que ela é. Também sei o que ela carrega, quer ela saiba disso ou não."

# game/ch2ep2.rpy:5449
translate brazil sktabdinwikcont_bfeb7989:

#   mc "Yeah? She carries what happens when the person who was supposed to protect her puts a price tag on her instead."
    mc "É mesmo? Ela carrega o fardo de quando a pessoa que deveria protegê-la, em vez disso, coloca um preço nela."

# game/ch2ep2.rpy:5450
translate brazil sktabdinwikcont_21269668:

#   mc "That's her whole load right there. Nothing else."
    mc "Essa é toda a carga dela. Nada mais."

# game/ch2ep2.rpy:5456
translate brazil sktabdinwikcont_ef15e217:

#   fr "Father used to tell me that there's more to this world than what it lets on."
    fr "Meu pai costumava me dizer que este mundo é muito mais do que aparenta."

# game/ch2ep2.rpy:5457
translate brazil sktabdinwikcont_2e010b6a:

#   fr "That some people are born carrying things they didn't choose."
    fr "Que algumas pessoas nascem carregando coisas que não escolheram."

# game/ch2ep2.rpy:5458
translate brazil sktabdinwikcont_f6dbde3b:

#   fr "Old debts, names, even memories. He said most of them never even figure it out."
    fr "Dívidas antigas, nomes, até mesmo memórias. Ele disse que a maioria deles nunca chega a descobrir."

# game/ch2ep2.rpy:5459
translate brazil sktabdinwikcont_aa966543:

#   fr "You strike me as one of those people."
    fr "Você me parece ser uma dessas pessoas."

# game/ch2ep2.rpy:5467
translate brazil sktabdinwikcont_e67fe030:

#   fr "You know what the difference is between you and me?"
    fr "Sabe qual é a diferença entre você e eu?"

# game/ch2ep2.rpy:5469
translate brazil sktabdinwikcont_f2450d92:

#   fr "When the rules said no..."
    fr "Quando as regras diziam não..."

# game/ch2ep2.rpy:5470
translate brazil sktabdinwikcont_0569fa34:

#   fr "You stopped."
    fr "Você parou."

# game/ch2ep2.rpy:5481
translate brazil sktabdinwikcont_17b85725:

#   mc "*scoffs*"
    mc "*bufa*"

# game/ch2ep2.rpy:5487
translate brazil sktabdinwikcont_2f6427ea:

#   mc "Didn't know you could hide your serum signature like that. You really are dangerous, like Moon said."
    mc "Não sabia que dava para esconder a assinatura do soro desse jeito. Você é realmente perigoso, como disse Moon."

# game/ch2ep2.rpy:5488
translate brazil sktabdinwikcont_3864a381:

#   ao "..."
    ao "..."

# game/ch2ep2.rpy:5491
translate brazil sktabdinwikcont_925ce11f:

#   mc "You work here?"
    mc "Você trabalha aqui?"

# game/ch2ep2.rpy:5492
translate brazil sktabdinwikcont_8a64aa2f:

#   ao "Part-time..."
    ao "Tempo parcial..."

# game/ch2ep2.rpy:5493
translate brazil sktabdinwikcont_d40673bb:

#   mc "Right. Part-time."
    mc "Certo. Meio período."

# game/ch2ep2.rpy:5496
translate brazil sktabdinwikcont_128b7462:

#   ao "Relax... Jess asked me to keep an eye out on this side of the city... You just happen to be in it..."
    ao "Relaxa... A Jess me pediu para ficar de olho nessa parte da cidade... E você está justamente aqui..."

# game/ch2ep2.rpy:5500
translate brazil sktabdinwikcont_29fa3d40:

#   mc "Hm, convenient."
    mc "Hum, conveniente."

# game/ch2ep2.rpy:5501
translate brazil sktabdinwikcont_dbd8dd86:

#   ao "Very..."
    ao "Muito..."

# game/ch2ep2.rpy:5502
translate brazil sktabdinwikcont_d9f461e3:

#   ao "I'm telling you... I actually do work here... You can keep your guard down..."
    ao "Estou te dizendo... Eu realmente trabalho aqui... Pode baixar a guarda..."

# game/ch2ep2.rpy:5505
translate brazil sktabdinwikcont_47369fcf:

#   mc "How much of that did you hear?"
    mc "Quanto disso você ouviu?"

# game/ch2ep2.rpy:5506
translate brazil sktabdinwikcont_fca35fc1:

#   ao "Just enough to know he walked out on his own legs... That was generous..."
    ao "Apenas o suficiente para saber que ele saiu andando com as próprias pernas... Isso foi generoso..."

# game/ch2ep2.rpy:5507
translate brazil sktabdinwikcont_7c4e3f0b:

#   mc "He had men outside. Can't really risk the customers here."
    mc "Havia homens do lado de fora. Não dá para arriscar os clientes aqui."

# game/ch2ep2.rpy:5511
translate brazil sktabdinwikcont_b1432ac3:

#   ao "So you filed through DFCS... got rejected... and now you're sitting here with a cold coffee and a crease in your forehead..."
    ao "Então você deu entrada no processo pelo DFCS... foi rejeitado... e agora está aí sentado com um café frio e uma ruga na testa..."

# game/ch2ep2.rpy:5512
translate brazil sktabdinwikcont_926010ac:

#   mc "That... about covers it, yeah."
    mc "Isso... basicamente resume tudo, né?"

# game/ch2ep2.rpy:5513
translate brazil sktabdinwikcont_c01dae9d:

#   ao "I take it you're here because you want to file an appeal...?"
    ao "Imagino que você esteja aqui porque deseja apresentar um recurso...?"

# game/ch2ep2.rpy:5514
translate brazil sktabdinwikcont_e9170068:

#   mc "After that one? \"Wanted\"."
    mc "Depois dessa? \"Procurado\"."

# game/ch2ep2.rpy:5517
translate brazil sktabdinwikcont_6ecaf7ba:

#   ao "You know... we don't go through those channels..."
    ao "Sabe... nós não seguimos esses canais..."

# game/ch2ep2.rpy:5518
translate brazil sktabdinwikcont_329bb0b3:

#   mc "I don't really want to tell a kid that I got her through questionable means."
    mc "Eu realmente não quero dizer para uma criança que a consegui por meios questionáveis."

# game/ch2ep2.rpy:5519
translate brazil sktabdinwikcont_734e4c05:

#   mc "In that case, I'd be no different from Francis."
    mc "Nesse caso, eu não seria diferente de Francisco."

# game/ch2ep2.rpy:5520
translate brazil sktabdinwikcont_def7a4e6:

#   ao "You know what they say back in the military...? Clean is a nice word for slow..."
    ao "Sabe o que dizem no exército...? Limpo é um eufemismo para lento..."

# game/ch2ep2.rpy:5523
translate brazil sktabdinwikcont_ebf75fac:

#   mc "... Like the way you talk?"
    mc "...Gostou do seu jeito de falar?"

# game/ch2ep2.rpy:5527
translate brazil sktabdinwikcont_e3e4fb96:

#   ao "Not my intention to tell you what to do... Sorry..."
    ao "Não era minha intenção dizer o que você deveria fazer... Desculpe..."

# game/ch2ep2.rpy:5528
translate brazil sktabdinwikcont_214fa582:

#   mc "Nah... You're good. Just yanking your chain."
    mc "Não... Você está bem. Só estou brincando."

# game/ch2ep2.rpy:5529
translate brazil sktabdinwikcont_7b4e3700:

#   mc "Besides, I already know who I'm calling."
    mc "Além disso, eu já sei para quem vou ligar."

# game/ch2ep2.rpy:5532
translate brazil sktabdinwikcont_514484d2:

#   ao "Then drink your coffee... I brewed it for you... It's been cold for ten minutes..."
    ao "Então tome seu café... Eu preparei para você... Está frio há dez minutos..."

# game/ch2ep2.rpy:5533
translate brazil sktabdinwikcont_18b82544:

#   mc "I take you're here just to tell me to drink my coffee? You hate it when people reject your food, huh?"
    mc "Imagino que você só veio aqui para me dizer para tomar meu café? Você odeia quando as pessoas rejeitam sua comida, né?"

# game/ch2ep2.rpy:5536
translate brazil sktabdinwikcont_ebf408d2:

#   ao "Try me..."
    ao "Experimente..."

# game/ch2ep2.rpy:5537
translate brazil sktabdinwikcont_ed07ce86:

#   mc "*scoffs* I'll take that as a yes."
    mc "*bufa* Vou considerar isso como um sim."

# game/ch2ep2.rpy:5541
translate brazil sktabdinwikcont_49d53c05:

#   ao "Anyway... good luck..."
    ao "Enfim... boa sorte..."

# game/ch2ep2.rpy:5544
translate brazil sktabdinwikcont_d9a5ae36:

#   mc "What you said about the whiskey. Does that still stand?"
    mc "O que você disse sobre o uísque. Isso ainda se aplica?"

# game/ch2ep2.rpy:5547
translate brazil sktabdinwikcont_b0c90ec7:

#   ao "Once you figure it out... anytime..."
    ao "Depois que você descobrir... a qualquer momento..."

# game/ch2ep2.rpy:5560
translate brazil sktabdinwikcont_b4daca8c:

#   j "[mc]."
    j "[mc]."

# game/ch2ep2.rpy:5561
translate brazil sktabdinwikcont_37bdc632:

#   mc "I need Eliza again."
    mc "Preciso da Eliza de novo."

# game/ch2ep2.rpy:5562
translate brazil sktabdinwikcont_ab200dc8:

#   j "What's going on?"
    j "O que está acontecendo?"

# game/ch2ep2.rpy:5563
translate brazil sktabdinwikcont_80c6c28d:

#   mc "Our unfinished business."
    mc "Nossos assuntos inacabados."

# game/ch2ep2.rpy:5564
translate brazil sktabdinwikcont_55fe65cd:

#   j "Ours... or yours?"
    j "Nossas... ou suas?"

# game/ch2ep2.rpy:5566
translate brazil sktabdinwikcont_b4fa3fc0:

#   j "..."
    j "..."

# game/ch2ep2.rpy:5567
translate brazil sktabdinwikcont_2779f5ab:

#   j "I'll get her down. Come when you're ready."
    j "Eu vou ajudá-la a descer. Venha quando estiver pronto."

# game/ch2ep2.rpy:5596
translate brazil sktabdinwikcont_8ea907fc:

#   el "[mc]."
    el "[mc]."

# game/ch2ep2.rpy:5599
translate brazil sktabdinwikcont_bf4711a0:

#   el "Here."
    el "Aqui."

# game/ch2ep2.rpy:5602
translate brazil sktabdinwikcont_cff8c2a2:

#   el "A message from Jess."
    el "Uma mensagem de Jess."

# game/ch2ep2.rpy:5603
translate brazil sktabdinwikcont_8878c09d:

#   mc "What'd she say?"
    mc "O que ela disse?"

# game/ch2ep2.rpy:5604
translate brazil sktabdinwikcont_ca4be637:

#   el "\"Don't go thinking there's always an easy way through.\""
    el "\"Não pense que sempre existe um caminho mais fácil.\""

# game/ch2ep2.rpy:5608
translate brazil sktabdinwikcont_ebea1e68:

#   mc "Believe me. I tried to do it the right way this time."
    mc "Acredite em mim. Desta vez, tentei fazer da maneira correta."

# game/ch2ep2.rpy:5609
translate brazil sktabdinwikcont_db11fc91:

#   mc "Besides... I've always been the side character. Always have been."
    mc "Além disso... eu sempre fui o personagem secundário. Sempre fui."

# game/ch2ep2.rpy:5610
translate brazil sktabdinwikcont_a48c208f:

#   el "Glad to hear that. Good enough for me."
    el "Que bom ouvir isso. Para mim, está ótimo."

# game/ch2ep2.rpy:5611
translate brazil sktabdinwikcont_165df710:

#   mc "The President going to have a problem with this?"
    mc "O presidente vai ter algum problema com isso?"

# game/ch2ep2.rpy:5612
translate brazil sktabdinwikcont_6a3d148a:

#   el "He'll ask questions. But Francis has been on our radar long before yours. This was always ours to close."
    el "Ele fará perguntas. Mas Francis já estava em nosso radar muito antes do seu. Esta oportunidade sempre foi nossa para concluir."

# game/ch2ep2.rpy:5620
translate brazil sktabdinwikcont_139786ba:

#   e "You've been cooperative so far."
    e "Você tem cooperado até agora."

# game/ch2ep2.rpy:5621
translate brazil sktabdinwikcont_28cb42b3:

#   tim "Don't see a reason in not being at this point."
    tim "Não vejo razão para não estarmos neste ponto."

# game/ch2ep2.rpy:5622
translate brazil sktabdinwikcont_cdc6d337:

#   e "Smart."
    e "Inteligente."

# game/ch2ep2.rpy:5625
translate brazil sktabdinwikcont_f8d87799:

#   tim "... The kid. She okay?"
    tim "...A criança. Ela está bem?"

# game/ch2ep2.rpy:5626
translate brazil sktabdinwikcont_6498fc3b:

#   e "Why do you ask?"
    e "Por que você pergunta?"

# game/ch2ep2.rpy:5627
translate brazil sktabdinwikcont_6f52ede8:

#   tim "I just wanna know. I was the one feeding her. Making sure she had what she needed."
    tim "Eu só quero saber. Era eu quem a alimentava. Quem se certificava de que ela tinha o que precisava."

# game/ch2ep2.rpy:5628
translate brazil sktabdinwikcont_940e5bc7:

#   tim "Wasn't much, but... I made sure she ate."
    tim "Não foi muita coisa, mas... eu me certifiquei de que ela comesse."

# game/ch2ep2.rpy:5630
translate brazil sktabdinwikcont_e7e0d27e:

#   tim "She used to save half her food."
    tim "Ela costumava guardar metade da comida."

# game/ch2ep2.rpy:5631
translate brazil sktabdinwikcont_0f829ce4:

#   e "What for?"
    e "Para quê?"

# game/ch2ep2.rpy:5632
translate brazil sktabdinwikcont_f65b68f8:

#   tim "Don't know. She just always did. Maybe she just doesn't like the food."
    tim "Não sei. Ela sempre fez isso. Talvez ela simplesmente não goste da comida."

# game/ch2ep2.rpy:5634
translate brazil sktabdinwikcont_06d57ee7:

#   tim "She okay or not?"
    tim "Ela está bem ou não?"

# game/ch2ep2.rpy:5635
translate brazil sktabdinwikcont_cb67fe18:

#   e "She's safe."
    e "Ela está segura."

# game/ch2ep2.rpy:5636
translate brazil sktabdinwikcont_e275190d:

#   tim "Detective... I need to know. Please."
    tim "Detetive... preciso saber. Por favor."

# game/ch2ep2.rpy:5642
translate brazil sktabdinwikcont_996ea6e0:

#   e "She's okay."
    e "Ela está bem."

# game/ch2ep2.rpy:5643
translate brazil sktabdinwikcont_73fb2e84:

#   tim "*exhales* Good. Good..."
    tim "*expira* Bom. Bom..."

# game/ch2ep2.rpy:5646
translate brazil sktabdinwikcont_efa58b33:

#   tim "... She's a smart kid. Weird, but smart."
    tim "... Ela é uma criança inteligente. Estranha, mas inteligente."

# game/ch2ep2.rpy:5647
translate brazil sktabdinwikcont_97f252d9:

#   e "Weird how?"
    e "Estranho como?"

# game/ch2ep2.rpy:5648
translate brazil sktabdinwikcont_4c9bf64b:

#   tim "The way she talked. It's like she was always thinking three things at once."
    tim "O jeito como ela falava. Era como se ela estivesse sempre pensando em três coisas ao mesmo tempo."

# game/ch2ep2.rpy:5649
translate brazil sktabdinwikcont_6a8d5752:

#   tim "Asked me once why I was doing this job."
    tim "Uma vez me perguntaram por que eu estava fazendo esse trabalho."

# game/ch2ep2.rpy:5650
translate brazil sktabdinwikcont_79649566:

#   e "What did you tell her?"
    e "O que você disse a ela?"

# game/ch2ep2.rpy:5653
translate brazil sktabdinwikcont_6b8724e5:

#   tim "The truth. Money."
    tim "A verdade. Dinheiro."

# game/ch2ep2.rpy:5654
translate brazil sktabdinwikcont_364fa104:

#   tim "She thought about it for a second and said, \"that makes sense, I guess.\""
    tim "Ela pensou nisso por um segundo e disse: \"Faz sentido, eu acho.\""

# game/ch2ep2.rpy:5655
translate brazil sktabdinwikcont_6d49aa9a:

#   tim "*soft laugh* Ten years old. Just... \"that makes sense.\""
    tim "*risada suave* Dez anos. Simplesmente... \"faz sentido.\""

# game/ch2ep2.rpy:5674
translate brazil sktabdinwikcont_f5c434e7:

#   el "Okay. Talk to me."
    el "Certo. Fale comigo."

# game/ch2ep2.rpy:5675
translate brazil sktabdinwikcont_b3777eb0:

#   mc "Hospital database. HC General."
    mc "Banco de dados hospitalar. HC Geral."

# game/ch2ep2.rpy:5677
translate brazil sktabdinwikcont_40c0fedc:

#   el "Patient records?"
    el "Registros de pacientes?"

# game/ch2ep2.rpy:5678
translate brazil sktabdinwikcont_4a7d423e:

#   mc "All of it. Access logs, file movement, copy requests."
    mc "Tudo. Registros de acesso, movimentação de arquivos, solicitações de cópia."

# game/ch2ep2.rpy:5679
translate brazil sktabdinwikcont_445071c2:

#   el "Copy requests specifically?"
    el "Solicitações de cópia específicas?"

# game/ch2ep2.rpy:5680
translate brazil sktabdinwikcont_da5fe03f:

#   mc "Someone inside that hospital is feeding information out. I need to know who."
    mc "Alguém dentro daquele hospital está vazando informações. Preciso saber quem é."

# game/ch2ep2.rpy:5681
translate brazil sktabdinwikcont_76a50bf4:

#   el "You got a name? Ward? Department?"
    el "Você tem um nome? Ala? Departamento?"

# game/ch2ep2.rpy:5682
translate brazil sktabdinwikcont_76451744:

#   mc "Pediatric recovery. Let's go with last two weeks."
    mc "Recuperação pediátrica. Vamos considerar as últimas duas semanas."

# game/ch2ep2.rpy:5683
translate brazil sktabdinwikcont_ab8706ae:

#   el "Patient?"
    el "Paciente?"

# game/ch2ep2.rpy:5684
translate brazil sktabdinwikcont_32f31aa6:

#   mc "Leah Warren. Trafficking case, protective custody."
    mc "Leah Warren. Caso de tráfico de pessoas, custódia protetiva."

# game/ch2ep2.rpy:5688
translate brazil sktabdinwikcont_885597a0:

#   el "..."
    el "..."

# game/ch2ep2.rpy:5689
translate brazil sktabdinwikcont_90f2c898:

#   el "Sensitive file. That's going to have extra encryption layers on top of the standard hospital network."
    el "Arquivo sensível. Ele terá camadas extras de criptografia além da rede padrão do hospital."

# game/ch2ep2.rpy:5690
translate brazil sktabdinwikcont_c1767362:

#   el "HC General runs Medicore V4 on their backend. Government-adjacent, not government-grade."
    el "A HC General utiliza o Medicore V4 em seu sistema de backend. É um sistema semelhante ao governamental, mas não de nível governamental."

# game/ch2ep2.rpy:5691
translate brazil sktabdinwikcont_826b5892:

#   mc "Meaning?"
    mc "Significado?"

# game/ch2ep2.rpy:5692
translate brazil sktabdinwikcont_7eba7423:

#   el "Meaning I can get in. Just won't be in the next thirty seconds."
    el "Isso significa que eu consigo entrar. Só que não será nos próximos trinta segundos."

# game/ch2ep2.rpy:5693
translate brazil sktabdinwikcont_56c974f3:

#   mc "How long?"
    mc "Quanto tempo?"

# game/ch2ep2.rpy:5694
translate brazil sktabdinwikcont_308ff8fb:

#   el "Depends on whether they patched their north node since we last had reason to look at them."
    el "Depende se eles corrigiram o nó norte desde a última vez que tivemos motivo para analisá-lo."

# game/ch2ep2.rpy:5695
translate brazil sktabdinwikcont_cb14b2b9:

#   el "If they didn't, five to ten minutes. If they did, longer."
    el "Se não o fizessem, de cinco a dez minutos. Se o fizessem, mais tempo."

# game/ch2ep2.rpy:5696
translate brazil sktabdinwikcont_19e9ac30:

#   mc "Get started."
    mc "Comece já."

# game/ch2ep2.rpy:5704
translate brazil sktabdinwikcont_8f9708bb:

#   el "Going in through the auxiliary network first. Less traffic, easier to bury the entry point."
    el "Entrando primeiro pela rede auxiliar. Menos tráfego, mais fácil de enterrar o ponto de entrada."

# game/ch2ep2.rpy:5705
translate brazil sktabdinwikcont_e6b0428b:

#   el "Once I'm past the outer firewall I can pull the access logs directly."
    el "Assim que ultrapasso o firewall externo, consigo obter os registros de acesso diretamente."

# game/ch2ep2.rpy:5706
translate brazil sktabdinwikcont_e8d9f86d:

#   el "You're looking for anomalous access patterns. Someone pulling a file they have no clinical reason to pull."
    el "Você está procurando por padrões de acesso anômalos. Alguém acessando um arquivo sem nenhuma justificativa clínica para isso."

# game/ch2ep2.rpy:5707
translate brazil sktabdinwikcont_d187ae5d:

#   mc "And copying it."
    mc "E copiando-o."

# game/ch2ep2.rpy:5708
translate brazil sktabdinwikcont_42f56f8b:

#   el "Copying is a different flag entirely."
    el "Copiar é uma infração completamente diferente."

# game/ch2ep2.rpy:5709
translate brazil sktabdinwikcont_4e791f26:

#   el "If someone copied that file, there'll be a shadow log. Hospitals keep those for liability."
    el "Se alguém copiou esse arquivo, haverá um registro paralelo. Os hospitais mantêm esses registros por questões de responsabilidade."

# game/ch2ep2.rpy:5710
translate brazil sktabdinwikcont_35d13fc5:

#   el "Most people don't know that."
    el "A maioria das pessoas não sabe disso."

# game/ch2ep2.rpy:5711
translate brazil sktabdinwikcont_229fb293:

#   mc "Does Francis?"
    mc "Será que Francisco faz isso?"

# game/ch2ep2.rpy:5712
translate brazil sktabdinwikcont_836b2558:

#   el "Doesn't matter if he does. His possible contact inside won't. People get sloppy when they think they're invisible."
    el "Não importa se ele fizer isso ou não. O possível contato dele lá dentro não fará diferença. As pessoas ficam descuidadas quando acham que são invisíveis."

# game/ch2ep2.rpy:5715
translate brazil sktabdinwikcont_e8321bc5:

#   el "I'm past the outer layer. Routing through a blind relay so the trace dies at the node."
    el "Já ultrapassei a camada externa. O roteamento passa por um relay cego, então o rastreamento se perde no nó."

# game/ch2ep2.rpy:5716
translate brazil sktabdinwikcont_2f537aea:

#   el "Give me a few minutes on the inner partition."
    el "Me dê alguns minutos para analisar a divisória interna."

# game/ch2ep2.rpy:5724
translate brazil sktabdinwikcont_811e2015:

#   e "Francis Mentzelopoutous."
    e "Francisco Mentzelopoutous."

# game/ch2ep2.rpy:5725
translate brazil sktabdinwikcont_3468d0ac:

#   tim "That's right."
    tim "Isso mesmo."

# game/ch2ep2.rpy:5726
translate brazil sktabdinwikcont_4e505ebe:

#   e "How long have you worked for him?"
    e "Há quanto tempo você trabalha para ele?"

# game/ch2ep2.rpy:5727
translate brazil sktabdinwikcont_55e2ade8:

#   tim "Eight months. Almost nine."
    tim "Oito meses. Quase nove."

# game/ch2ep2.rpy:5728
translate brazil sktabdinwikcont_4855a159:

#   e "How did you get recruited?"
    e "Como você foi recrutado?"

# game/ch2ep2.rpy:5729
translate brazil sktabdinwikcont_96eb7ae8:

#   tim "Same way everyone does. Someone knows someone. Money's good. You don't ask questions."
    tim "Da mesma forma que todo mundo faz. Alguém conhece alguém. Dinheiro é bom. Você não faz perguntas."

# game/ch2ep2.rpy:5730
translate brazil sktabdinwikcont_f72ee04b:

#   e "Did you know what the operation was before you signed on?"
    e "Você sabia qual era o procedimento antes de assinar o contrato?"

# game/ch2ep2.rpy:5731
translate brazil sktabdinwikcont_db9bcfdb:

#   tim "... I had a pretty good idea."
    tim "... Eu tive uma ideia muito boa."

# game/ch2ep2.rpy:5732
translate brazil sktabdinwikcont_953efdff:

#   e "And you still took the job."
    e "E mesmo assim você aceitou o emprego."

# game/ch2ep2.rpy:5735
translate brazil sktabdinwikcont_6821f804:

#   tim "Do you have kids, Detective?"
    tim "Você tem filhos, detetive?"

# game/ch2ep2.rpy:5736
translate brazil sktabdinwikcont_3ea87455:

#   e "... No."
    e "... Não."

# game/ch2ep2.rpy:5737
translate brazil sktabdinwikcont_5a2300da:

#   tim "Well, I've got two and a landlord who doesn't give a shit about either of them."
    tim "Bem, eu tenho dois e um senhorio que não dá a mínima para nenhum deles."

# game/ch2ep2.rpy:5738
translate brazil sktabdinwikcont_28fc6b8b:

#   tim "So yeah. I took the job."
    tim "Sim, eu aceitei o emprego."

# game/ch2ep2.rpy:5742
translate brazil sktabdinwikcont_abc4786c:

#   e "What can you tell me about him?"
    e "O que você pode me dizer sobre ele?"

# game/ch2ep2.rpy:5743
translate brazil sktabdinwikcont_c29dc753:

#   tim "What do you want to know?"
    tim "O que você quer saber?"

# game/ch2ep2.rpy:5744
translate brazil sktabdinwikcont_31acc078:

#   e "Everything."
    e "Tudo."

# game/ch2ep2.rpy:5747
translate brazil sktabdinwikcont_e35a6d4a:

#   tim "..."
    tim "..."

# game/ch2ep2.rpy:5748
translate brazil sktabdinwikcont_86ffb175:

#   tim "He's... not right."
    tim "Ele... não está bem."

# game/ch2ep2.rpy:5749
translate brazil sktabdinwikcont_b75c5c16:

#   e "Elaborate."
    e "Elaborar."

# game/ch2ep2.rpy:5752
translate brazil sktabdinwikcont_bc7ae638:

#   tim "In the head. He's not right in the head."
    tim "Na cabeça. Ele não está bem da cabeça."

# game/ch2ep2.rpy:5755
translate brazil sktabdinwikcont_806e7b6a:

#   tim "You see, most guys running an operation like this, they're businessmen. Cold, yeah, but businessmen."
    tim "Veja bem, a maioria dos caras que administram um negócio como esse são homens de negócios. Frios, sim, mas homens de negócios."

# game/ch2ep2.rpy:5756
translate brazil sktabdinwikcont_30eb6d86:

#   tim "Francis isn't running a business. It's something personal."
    tim "Francis não está administrando um negócio. É algo pessoal."

# game/ch2ep2.rpy:5757
translate brazil sktabdinwikcont_59f59c44:

#   tim "He doesn't care about the money. Barely touches it."
    tim "Ele não se importa com o dinheiro. Quase não toca nele."

# game/ch2ep2.rpy:5758
translate brazil sktabdinwikcont_4018c761:

#   tim "The whole thing—the network, the locations, all of it—it's just infrastructure for whatever he's actually after."
    tim "Tudo isso — a rede, as localizações, tudo — é apenas infraestrutura para o que quer que ele esteja buscando."

# game/ch2ep2.rpy:5759
translate brazil sktabdinwikcont_f3a123dd:

#   e "Which is?"
    e "Qual é?"

# game/ch2ep2.rpy:5760
translate brazil sktabdinwikcont_dfe86501:

#   tim "Looking for someone."
    tim "Estou procurando alguém."

# game/ch2ep2.rpy:5761
translate brazil sktabdinwikcont_0617fdd7:

#   e "Who?"
    e "Quem?"

# game/ch2ep2.rpy:5764
translate brazil sktabdinwikcont_ebed53be:

#   tim "His sister."
    tim "Sua irmã."

# game/ch2ep2.rpy:5766
translate brazil sktabdinwikcont_47b4943e:

#   tim "She's dead. Has been for a long time, from what I gathered."
    tim "Ela está morta. Já faz um bom tempo, pelo que eu entendi."

# game/ch2ep2.rpy:5767
translate brazil sktabdinwikcont_ee4bcc09:

#   tim "Fire. He was a kid. Got out. She didn't."
    tim "Fogo. Ele era criança. Conseguiu sair. Ela não."

# game/ch2ep2.rpy:5768
translate brazil sktabdinwikcont_e8857347:

#   tim "He never got over it."
    tim "Ele nunca superou isso."

# game/ch2ep2.rpy:5769
translate brazil sktabdinwikcont_a0b7e473:

#   e "And the children? What's he really after?"
    e "E as crianças? O que ele realmente quer?"

# game/ch2ep2.rpy:5770
translate brazil sktabdinwikcont_f227abf6:

#   tim "He's trying to put her back together."
    tim "Ele está tentando ajudá-la a se recuperar."

# game/ch2ep2.rpy:5774
translate brazil sktabdinwikcont_07e694cd:

#   tim "That's the best way I can describe it."
    tim "Essa é a melhor maneira que consigo descrever."

# game/ch2ep2.rpy:5775
translate brazil sktabdinwikcont_403cceda:

#   tim "Every kid that came through, he'd sit with them. Talk to them. Real quiet, real patient."
    tim "Com todas as crianças que apareciam, ele se sentava com elas. Conversava com elas. Bem quieto, muito paciente."

# game/ch2ep2.rpy:5776
translate brazil sktabdinwikcont_add7bee3:

#   tim "Looking for something specific. The way she moved. Something she said. The way she laughed. Like he was collecting pieces."
    tim "Procurando por algo específico. O jeito como ela se movia. Algo que ela disse. O jeito como ela ria. Como se ele estivesse colecionando fragmentos."

# game/ch2ep2.rpy:5777
translate brazil sktabdinwikcont_99eda18e:

#   e "Pieces?"
    e "Peças?"

# game/ch2ep2.rpy:5778
translate brazil sktabdinwikcont_aa0e6687:

#   tim "One had the right voice. One had the right eyes. One remembered something she shouldn't have."
    tim "Uma tinha a voz certa. Uma tinha os olhos certos. Uma se lembrava de algo que não deveria."

# game/ch2ep2.rpy:5779
translate brazil sktabdinwikcont_cd9a7760:

#   tim "None of them were ever... enough."
    tim "Nenhuma delas jamais foi... suficiente."

# game/ch2ep2.rpy:5780
translate brazil sktabdinwikcont_93ef63f5:

#   tim "And when they weren't..."
    tim "E quando eles não estavam..."

# game/ch2ep2.rpy:5781
translate brazil sktabdinwikcont_29119fb4:

#   e "He lost interest."
    e "Ele perdeu o interesse."

# game/ch2ep2.rpy:5782
translate brazil sktabdinwikcont_e802950e:

#   tim "Yeah."
    tim "Sim."

# game/ch2ep2.rpy:5785
translate brazil sktabdinwikcont_e599524a:

#   e "And then what happened to them?"
    e "E depois, o que aconteceu com eles?"

# game/ch2ep2.rpy:5787
translate brazil sktabdinwikcont_e6a286b2:

#   tim "Moved on. That's all I know."
    tim "Segui em frente. É tudo o que sei."

# game/ch2ep2.rpy:5788
translate brazil sktabdinwikcont_a2106ff0:

#   e "Moved on where?"
    e "Mudou-se para onde?"

# game/ch2ep2.rpy:5789
translate brazil sktabdinwikcont_e3c4d8ae:

#   tim "I didn't ask. You learn real fast not to ask."
    tim "Eu não perguntei. A gente aprende rapidinho a não perguntar."

# game/ch2ep2.rpy:5791
translate brazil sktabdinwikcont_b079d30c:

#   e "The sister. Did she actually exist?"
    e "A irmã. Ela realmente existiu?"

# game/ch2ep2.rpy:5798
translate brazil sktabdinwikcont_daea9950:

#   el "I'm in the access logs."
    el "Estou nos registros de acesso."

# game/ch2ep2.rpy:5799
translate brazil sktabdinwikcont_49321285:

#   el "Pulling pediatric recovery. Last fourteen days."
    el "Recuperação pediátrica com retirada de medicamentos. Últimos quatorze dias."

# game/ch2ep2.rpy:5802
translate brazil sktabdinwikcont_f2087395:

#   el "Okay. I've got twenty-three unique access events on the file you're looking for."
    el "Certo. Encontrei vinte e três eventos de acesso únicos no arquivo que você está procurando."

# game/ch2ep2.rpy:5803
translate brazil sktabdinwikcont_14c79159:

#   el "Seventeen are clinical. Doctors, nurses, attending staff. All timestamped within standard shift hours."
    el "Dezessete são clínicos. Médicos, enfermeiros, equipe médica. Todos com registro de horário dentro do turno padrão."

# game/ch2ep2.rpy:5804
translate brazil sktabdinwikcont_a4a49220:

#   el "The other six..."
    el "Os outros seis..."

# game/ch2ep2.rpy:5805
translate brazil sktabdinwikcont_c63e49c1:

#   mc "What about them?"
    mc "E quanto a eles?"

# game/ch2ep2.rpy:5806
translate brazil sktabdinwikcont_edce20c7:

#   el "Off-hours. Three between midnight and 4 AM. Two during shift change—lowest surveillance window in any hospital."
    el "Fora do horário de expediente. Três entre meia-noite e 4 da manhã. Duas durante a troca de turno — a menor janela de vigilância em qualquer hospital."

# game/ch2ep2.rpy:5807
translate brazil sktabdinwikcont_4b37301c:

#   el "One this morning. About two hours ago."
    el "Uma esta manhã. Há cerca de duas horas."

# game/ch2ep2.rpy:5813
translate brazil sktabdinwikcont_7b0be15d:

#   el "And there's your copy flag."
    el "E aí está a sua bandeira de cópia."

# game/ch2ep2.rpy:5814
translate brazil sktabdinwikcont_773412ff:

#   el "Someone used a local terminal on the pediatric floor to export the file. Not to an external drive, but to an encrypted relay address."
    el "Alguém usou um terminal local no andar pediátrico para exportar o arquivo. Não para um disco rígido externo, mas para um endereço de retransmissão criptografado."

# game/ch2ep2.rpy:5815
translate brazil sktabdinwikcont_31e912d0:

#   el "Whoever set this up knew what they were doing."
    el "Quem quer que tenha organizado isso sabia o que estava fazendo."

# game/ch2ep2.rpy:5816
translate brazil sktabdinwikcont_e3c6dccf:

#   el "But they used the same terminal every time."
    el "Mas eles usavam sempre o mesmo terminal."

# game/ch2ep2.rpy:5817
translate brazil sktabdinwikcont_1bc09cae:

#   mc "Can you get a name from the terminal ID?"
    mc "É possível obter o nome a partir do ID do terminal?"

# game/ch2ep2.rpy:5818
translate brazil sktabdinwikcont_4a414ca0:

#   el "Already running it."
    el "Já está em execução."

# game/ch2ep2.rpy:5823
translate brazil sktabdinwikcont_527dc5dd:

#   el "Staff login tied to that terminal."
    el "O login da equipe está vinculado a esse terminal."

# game/ch2ep2.rpy:5828
translate brazil sktabdinwikcont_516979d5:

#   el "Cara Voss. Registered nurse. Pediatric recovery."
    el "Cara Voss. Enfermeira registrada. Recuperação pediátrica."

# game/ch2ep2.rpy:5829
translate brazil sktabdinwikcont_a98d5871:

#   mc "She's been in the room with Leah since the first night."
    mc "Ela está no quarto com Leah desde a primeira noite."

# game/ch2ep2.rpy:5830
translate brazil sktabdinwikcont_c89551a1:

#   el "You want me to pull her full profile?"
    el "Você quer que eu busque o perfil completo dela?"

# game/ch2ep2.rpy:5831
translate brazil sktabdinwikcont_bf1c7709:

#   mc "Everything you can get."
    mc "Tudo o que você puder conseguir."

# game/ch2ep2.rpy:5832
translate brazil sktabdinwikcont_d76a7e33:

#   el "Give me a minute."
    el "Só me dê um minuto."

# game/ch2ep2.rpy:5835
translate brazil sktabdinwikcont_13748cd7:

#   tim "I don't know."
    tim "Não sei."

# game/ch2ep2.rpy:5836
translate brazil sktabdinwikcont_e5c9da4c:

#   tim "Eight months working for this man and I've never seen a photo. Never heard a last name. Never heard anyone else mention her."
    tim "Trabalhei oito meses para esse homem e nunca vi uma foto dela. Nunca ouvi o sobrenome dele. Nunca ouvi ninguém mais mencioná-la."

# game/ch2ep2.rpy:5837
translate brazil sktabdinwikcont_f08423b2:

#   tim "Just him. Talking to himself about her like she's standing right there."
    tim "Só ele. Falando sozinho sobre ela como se ela estivesse bem ali na frente dele."

# game/ch2ep2.rpy:5838
translate brazil sktabdinwikcont_23416d61:

#   tim "I think..."
    tim "Eu penso..."

# game/ch2ep2.rpy:5841
translate brazil sktabdinwikcont_5a4b7700:

#   tim "I think she might just be something he built in his head to survive whatever happened to him."
    tim "Acho que ela pode ser apenas algo que ele criou na cabeça para sobreviver ao que quer que lhe acontecesse."

# game/ch2ep2.rpy:5842
translate brazil sktabdinwikcont_5989d014:

#   tim "But good luck telling him that."
    tim "Mas boa sorte tentando dizer isso para ele."

# game/ch2ep2.rpy:5846
translate brazil sktabdinwikcont_f180ce5f:

#   tim "The creepy part isn't that he's looking for her. The creepy part is he genuinely believes he's close."
    tim "O que é assustador não é ele estar procurando por ela. O que é assustador é que ele realmente acredita que está perto."

# game/ch2ep2.rpy:5847
translate brazil sktabdinwikcont_444592bb:

#   tim "Every single time. Always thinks he's close."
    tim "Todas as vezes. Sempre acha que está perto."

# game/ch2ep2.rpy:5848
translate brazil sktabdinwikcont_67dfe6c8:

#   e "And Leah?"
    e "E Leah?"

# game/ch2ep2.rpy:5849
translate brazil sktabdinwikcont_49c60746:

#   tim "Closest he's ever gotten, far as I could tell."
    tim "Pelo que pude perceber, foi o mais perto que ele já chegou."

# game/ch2ep2.rpy:5851
translate brazil sktabdinwikcont_dc094078:

#   e "He spent more time with her than the others?"
    e "Ele passou mais tempo com ela do que com os outros?"

# game/ch2ep2.rpy:5853
translate brazil sktabdinwikcont_1ea97b2d:

#   e "Why?"
    e "Por que?"

# game/ch2ep2.rpy:5856
translate brazil sktabdinwikcont_e6773dac:

#   tim "Don't know. But he was different with her."
    tim "Não sei. Mas com ela ele era diferente."

# game/ch2ep2.rpy:5857
translate brazil sktabdinwikcont_3140ff6e:

#   tim "He was calmer. Like he thought she was it—or whatever it is that's going on in that head of his."
    tim "Ele estava mais calmo. Como se pensasse que ela fosse a culpada — ou seja lá o que estiver passando pela cabeça dele."

# game/ch2ep2.rpy:5858
translate brazil sktabdinwikcont_447b50f1:

#   tim "But the thing is... he's never really talked to her in person. Always just talked or watched her in front of a camera."
    tim "Mas o fato é que... ele nunca conversou com ela pessoalmente. Sempre conversaram ou a observaram em frente a uma câmera."

# game/ch2ep2.rpy:5859
translate brazil sktabdinwikcont_e087d39f:

#   tim "Like getting up close and personal would taint her or something. Really weird."
    tim "Como se chegar muito perto dela pudesse corrompê-la ou algo assim. Muito estranho."

# game/ch2ep2.rpy:5861
translate brazil sktabdinwikcont_e4b5c39b:

#   e "The men who stayed. Why?"
    e "Os homens que ficaram. Por quê?"

# game/ch2ep2.rpy:5864
translate brazil sktabdinwikcont_f34a30b2:

#   tim "Same reason I did. He pays well and on time."
    tim "O mesmo motivo que eu. Ele paga bem e em dia."

# game/ch2ep2.rpy:5865
translate brazil sktabdinwikcont_cb69d0fc:

#   tim "Nobody's really loyal to him. He just keeps the money flowing and people keep showing up."
    tim "Ninguém é realmente leal a ele. Ele simplesmente mantém o dinheiro fluindo e as pessoas continuam aparecendo."

# game/ch2ep2.rpy:5866
translate brazil sktabdinwikcont_25ca02ae:

#   tim "Pull the money out and the whole thing falls apart overnight."
    tim "Basta retirar o dinheiro e tudo desmorona da noite para o dia."

# game/ch2ep2.rpy:5867
translate brazil sktabdinwikcont_64cf238a:

#   tim "But him? He'd keep going with nothing. I genuinely believe that."
    tim "Mas ele? Ele continuaria mesmo sem nada. Acredito sinceramente nisso."

# game/ch2ep2.rpy:5874
translate brazil sktabdinwikcont_b728fd37:

#   e "Where is he?"
    e "Onde ele está?"

# game/ch2ep2.rpy:5875
translate brazil sktabdinwikcont_ac8f0e6a:

#   tim "... You're going to find him anyway."
    tim "...Você vai encontrá-lo de qualquer maneira."

# game/ch2ep2.rpy:5876
translate brazil sktabdinwikcont_e26741b8:

#   e "Faster with your help."
    e "Mais rápido com a sua ajuda."

# game/ch2ep2.rpy:5878
translate brazil sktabdinwikcont_e92e538a:

#   tim "Funny thing is, he's close to Ashen. Near the train station. He's got an office there."
    tim "O engraçado é que ele mora perto de Ashen. Perto da estação de trem. Ele tem um escritório lá."

# game/ch2ep2.rpy:5879
translate brazil sktabdinwikcont_4739dc47:

#   tim "31 Veyne Plaza, East End, Golden City."
    tim "31 Veyne Plaza, East End, Golden City."

# game/ch2ep2.rpy:5880
translate brazil sktabdinwikcont_21366114:

#   tim "He moves around but he keeps coming back. It's where he feels safe, I think."
    tim "Ele se desloca, mas sempre volta. Acho que é onde ele se sente seguro."

# game/ch2ep2.rpy:5881
translate brazil sktabdinwikcont_ff250a81:

#   e "How many men?"
    e "Quantos homens?"

# game/ch2ep2.rpy:5882
translate brazil sktabdinwikcont_cb74c714:

#   tim "Skeleton crew by now. After Ashen, most of them probably scattered."
    tim "A tripulação está reduzida ao mínimo. Depois de Ashen, a maioria provavelmente se dispersou."

# game/ch2ep2.rpy:5883
translate brazil sktabdinwikcont_06e87e04:

#   tim "Maybe seven. Maybe less."
    tim "Talvez sete. Talvez menos."

# game/ch2ep2.rpy:5887
translate brazil sktabdinwikcont_0af36474:

#   e "Thank you."
    e "Obrigado."

# game/ch2ep2.rpy:5890
translate brazil sktabdinwikcont_8148763d:

#   tim "Detective."
    tim "Detetive."

# game/ch2ep2.rpy:5892
translate brazil sktabdinwikcont_00ff8c5b:

#   tim "Thank you for getting her out of there."
    tim "Obrigado por tirá-la de lá."

# game/ch2ep2.rpy:5894
translate brazil sktabdinwikcont_47f9988b:

#   e "She saved herself. We just opened the door."
    e "Ela se salvou sozinha. Nós apenas abrimos a porta."

# game/ch2ep2.rpy:5908
translate brazil sktabdinwikcont_7f7f7a93:

#   el "Okay. Cara Voss. Licensed RN, seven years. She's got a clean record, no flags."
    el "Certo. Cara Voss. Enfermeira licenciada, sete anos de experiência. Ela tem ficha limpa, sem nenhuma ocorrência."

# game/ch2ep2.rpy:5909
translate brazil sktabdinwikcont_9e0485ac:

#   el "Hired at HC General fourteen months ago."
    el "Contratado pela HC General há quatorze meses."

# game/ch2ep2.rpy:5910
translate brazil sktabdinwikcont_88a63528:

#   el "Previous employer—private medical contractor. Dissolution Medical Services."
    el "Empregador anterior: prestador de serviços médicos privado. Dissolution Medical Services."

# game/ch2ep2.rpy:5911
translate brazil sktabdinwikcont_128ec3e3:

#   el "Which is interesting, because Dissolution Medical Services doesn't exist anymore."
    el "O que é interessante, porque a Dissolution Medical Services não existe mais."

# game/ch2ep2.rpy:5912
translate brazil sktabdinwikcont_f82b7b2c:

#   el "Dissolved—right there in the name—eighteen months ago."
    el "Dissolvida — está no próprio nome — há dezoito meses."

# game/ch2ep2.rpy:5913
translate brazil sktabdinwikcont_c4f6c6a5:

#   el "But here's the thing... The registered address for Dissolution Medical Services?"
    el "Mas eis a questão... Qual é o endereço registrado da Dissolution Medical Services?"

# game/ch2ep2.rpy:5916
translate brazil sktabdinwikcont_71bfe3f9:

#   el "Few miles from Club Ashen."
    el "A poucos quilômetros do Club Ashen."

# game/ch2ep2.rpy:5918
translate brazil sktabdinwikcont_a4dfb4e4:

#   mc "He planted her before Leah even got there."
    mc "Ele a plantou antes mesmo de Leah chegar lá."

# game/ch2ep2.rpy:5919
translate brazil sktabdinwikcont_f7f75036:

#   el "Looks that way."
    el "Parece que sim."

# game/ch2ep2.rpy:5920
translate brazil sktabdinwikcont_725f2ef1:

#   el "I'd say she wasn't placed for Leah specifically. She was already there. Waiting for whoever came through."
    el "Eu diria que ela não foi designada especificamente para substituir Leah. Ela já estava lá, esperando por quem quer que aparecesse."

# game/ch2ep2.rpy:5922
translate brazil sktabdinwikcont_981b8d4d:

#   el "You want us to act on this? Just say the word. I'll roll everyone in."
    el "Querem que façamos algo a respeito? É só dizer. Eu envolvo todo mundo."

# game/ch2ep2.rpy:5923
translate brazil sktabdinwikcont_31b7c429:

#   mc "Give me a minute."
    mc "Só me dê um minuto."

# game/ch2ep2.rpy:5943
translate brazil sktabdinwikcont_e16f5e87:

#   e "[mc]."
    e "[mc]."

# game/ch2ep2.rpy:5944
translate brazil sktabdinwikcont_11130935:

#   mc "Where are you?"
    mc "Onde você está?"

# game/ch2ep2.rpy:5945
translate brazil sktabdinwikcont_43c83faf:

#   e "At the precinct. Just wrapped up an interrogation. I've got Francis's location—"
    e "Na delegacia. Acabei de terminar um interrogatório. Tenho a localização de Francis—"

# game/ch2ep2.rpy:5948
translate brazil sktabdinwikcont_b080cd3c:

#   mc "Em. Hold on."
    mc "Hum. Aguarde."

# game/ch2ep2.rpy:5952
translate brazil sktabdinwikcont_bc1759fb:

#   mc "The nurse. Cara Voss."
    mc "A enfermeira. Cara Voss."

# game/ch2ep2.rpy:5953
translate brazil sktabdinwikcont_4e93c1f6:

#   mc "She's Francis's contact. Has been since before Leah even got there."
    mc "Ela é o contato do Francis. Tem sido assim desde antes mesmo da Leah chegar lá."

# game/ch2ep2.rpy:5954
translate brazil sktabdinwikcont_2e0f82aa:

#   mc "She's been copying Leah's file. Placement details. Visitor logs. Everything."
    mc "Ela andou copiando o arquivo da Leah. Detalhes da colocação. Registros de visitantes. Tudo."

# game/ch2ep2.rpy:5958
translate brazil sktabdinwikcont_ec9415d1:

#   e "Where are you right now?"
    e "Onde você está agora?"

# game/ch2ep2.rpy:5959
translate brazil sktabdinwikcont_e79dd879:

#   mc "Sicae HQ."
    mc "Sede da Sicae."

# game/ch2ep2.rpy:5960
translate brazil sktabdinwikcont_5b13668c:

#   e "[mc], I told you—"
    e "[mc], Eu te disse-"

# game/ch2ep2.rpy:5961
translate brazil sktabdinwikcont_ae0bc091:

#   mc "Let me explain—Francis found me earlier. We talked, but he rambled {b}{i}too much{/i}{/b}."
    mc "Deixe-me explicar: Francis me encontrou mais cedo. Conversamos, mas ele divagou. {b}{i}demais{/i}{/b}."

# game/ch2ep2.rpy:5962
translate brazil sktabdinwikcont_c481402d:

#   e "He what?"
    e "Ele o quê?"

# game/ch2ep2.rpy:5963
translate brazil sktabdinwikcont_03bb18f2:

#   mc "He had men outside. It wasn't a conversation I chose. I didn't have a clean option, Em. This was the fastest way to confirm what he already knew."
    mc "Havia homens lá fora. Não foi uma conversa que eu escolhi. Eu não tinha uma opção limpa, Em. Essa era a maneira mais rápida de confirmar o que ele já sabia."

# game/ch2ep2.rpy:5965
translate brazil sktabdinwikcont_9785c4ae:

#   e "The foster family... They're moving Leah right now."
    e "A família acolhedora... Eles estão mudando a Leah de casa agora."

# game/ch2ep2.rpy:5966
translate brazil sktabdinwikcont_bd6e41d9:

#   mc "Yeah, but let us—"
    mc "Sim, mas deixe-nos—"

# game/ch2ep2.rpy:5967
translate brazil sktabdinwikcont_1de969fa:

#   e "He knows where they're taking her."
    e "Ele sabe para onde estão levando-a."

# game/ch2ep2.rpy:5969
translate brazil sktabdinwikcont_1feed147:

#   mc "Em, I know what you're thinking—"
    mc "Hum, eu sei o que você está pensando—"

# game/ch2ep2.rpy:5972
translate brazil sktabdinwikcont_cf9c7326:

#   e "Francis is a few miles east of Ashen. Office near the train station. 31 Veyne Plaza, East End, Golden City."
    e "Francis fica a poucos quilômetros a leste de Ashen. Escritório perto da estação de trem. 31 Veyne Plaza, East End, Golden City."

# game/ch2ep2.rpy:5973
translate brazil sktabdinwikcont_ed93ab23:

#   e "File that report along with the information you got. Make sure the evidence is airtight. Do it now."
    e "Arquive esse relatório junto com as informações que você obteve. Certifique-se de que as provas sejam irrefutáveis. Faça isso agora."

# game/ch2ep2.rpy:5977
translate brazil sktabdinwikcont_2cc98b66:

#   e "Hale. Go straight to Hale. He won't sit on it if Sicae's backing it."
    e "Hale. Vá direto ao Hale. Ele não vai ficar parado se o Sicae estiver apoiando."

# game/ch2ep2.rpy:5978
translate brazil sktabdinwikcont_5093c6a2:

#   mc "Emma—"
    mc "Emma—"

# game/ch2ep2.rpy:5979
translate brazil sktabdinwikcont_f3b38e9d:

#   e "[mc]. Please."
    e "[mc]. Por favor."

# game/ch2ep2.rpy:5983
translate brazil sktabdinwikcont_1284c607:

#   e "File it. I'll buy you time."
    e "Arquive isso. Eu te dou tempo."

# game/ch2ep2.rpy:5986
translate brazil sktabdinwikcont_f7dde690:

#   mc "Em, if you go there now—"
    mc "Hum, se você for lá agora—"

# game/ch2ep2.rpy:5987
translate brazil sktabdinwikcont_76d3b639:

#   e "I know what it'll cost..."
    e "Eu sei quanto isso vai custar..."

# game/ch2ep2.rpy:5988
translate brazil sktabdinwikcont_3410ea8e:

#   mc "Let us handle this."
    mc "Vamos cuidar disso."

# game/ch2ep2.rpy:5989
translate brazil sktabdinwikcont_62c7d423:

#   e "You already are..."
    e "Você já é..."

# game/ch2ep2.rpy:5992
translate brazil sktabdinwikcont_a92ea2af:

#   el "So?"
    el "Então?"

# game/ch2ep2.rpy:5993
translate brazil sktabdinwikcont_6b7aedb8:

#   mc "Yeah. Do it."
    mc "Sim. Faça isso."

# game/ch2ep2.rpy:6019
translate brazil sktabdinwikcont_688d332c:

#   ju "What are you doing?"
    ju "O que você está fazendo?"

# game/ch2ep2.rpy:6020
translate brazil sktabdinwikcont_a9300c08:

#   e "Buying time."
    e "Ganhando tempo."

# game/ch2ep2.rpy:6021
translate brazil sktabdinwikcont_f93d7574:

#   ju "You were removed from this case, Emma."
    ju "Você foi afastada deste caso, Emma."

# game/ch2ep2.rpy:6022
translate brazil sktabdinwikcont_637715b6:

#   e "Yeah. I know."
    e "Sim, eu sei."

# game/ch2ep2.rpy:6025
translate brazil sktabdinwikcont_2a38350a:

#   le "Emma."
    le "Emma."

# game/ch2ep2.rpy:6027
translate brazil sktabdinwikcont_b929cca8:

#   le "I read your letter."
    le "Eu li sua carta."

# game/ch2ep2.rpy:6033
translate brazil sktabdinwikcont_36089d2f:

#   ju "Emma. Step aside. Right now."
    ju "Emma. Afaste-se. Agora mesmo."

# game/ch2ep2.rpy:6034
translate brazil sktabdinwikcont_897e8c54:

#   e "There's a report being filed with Hale as we speak."
    e "Neste momento, está sendo encaminhado um relatório para Hale."

# game/ch2ep2.rpy:6035
translate brazil sktabdinwikcont_33a5fbdb:

#   ju "That doesn't give you the authority to—"
    ju "Isso não lhe dá autoridade para—"

# game/ch2ep2.rpy:6038
translate brazil sktabdinwikcont_8e830dbe:

#   e "Cara Voss."
    e "Via Voss."

# game/ch2ep2.rpy:6040
translate brazil sktabdinwikcont_3904a7a5:

#   e "She's Francis's contact. She's been copying Leah's file."
    e "Ela é o contato do Francis. Ela tem copiado o arquivo da Leah."

# game/ch2ep2.rpy:6041
translate brazil sktabdinwikcont_5b696a23:

#   e "Visitor logs. Transfer schedule... and the placement details. He knows where you're taking her, June."
    e "Registros de visitantes. Cronograma de transferências... e detalhes da alocação. Ele sabe para onde você a está levando, June."

# game/ch2ep2.rpy:6044
translate brazil sktabdinwikcont_d1324c95:

#   lo "What? June, is this—"
    lo "O quê? Junho, é isso—"

# game/ch2ep2.rpy:6045
translate brazil sktabdinwikcont_b321032d:

#   ju "Lois. Give me a moment, please."
    ju "Lois. Só um instante, por favor."

# game/ch2ep2.rpy:6048
translate brazil sktabdinwikcont_82cb7d9a:

#   ju "Where is this coming from?"
    ju "De onde vem isso?"

# game/ch2ep2.rpy:6049
translate brazil sktabdinwikcont_275a0466:

#   e "[mc]. He's the one filing the report with Hale."
    e "[mc] É ele quem está apresentando o relatório a Hale."

# game/ch2ep2.rpy:6050
translate brazil sktabdinwikcont_46ff508c:

#   ju "Then let the report do its job. Step aside and give me ten minutes. I'll make the call myself."
    ju "Então deixe o relatório fazer o seu trabalho. Afaste-se e me dê dez minutos. Eu mesmo tomarei a decisão."

# game/ch2ep2.rpy:6051
translate brazil sktabdinwikcont_ffab4064:

#   e "She doesn't have ten minutes. You can't guarantee she will, since we don't know what Francis might do. But I will make sure to give her that time."
    e "Ela não tem dez minutos. Não dá para garantir que ela terá, já que não sabemos o que Francis pode fazer. Mas vou me certificar de que ela tenha esse tempo."

# game/ch2ep2.rpy:6052
translate brazil sktabdinwikcont_c344e72e:

#   ju "I am trying to work with you here. But I can't halt a federal transfer on the word of an officer who was pulled from this case for emotional compromise."
    ju "Estou tentando colaborar com você. Mas não posso impedir uma transferência federal com base na palavra de um agente que foi afastado do caso por questões emocionais."

# game/ch2ep2.rpy:6053
translate brazil sktabdinwikcont_3c9cd91b:

#   ju "That is exactly the reason you were removed. You know why I can't act on this. Not from you."
    ju "Exatamente por esse motivo você foi removido. Você sabe por que não posso tomar nenhuma providência a respeito. Não por sua causa."

# game/ch2ep2.rpy:6057
translate brazil sktabdinwikcont_63e5290e:

#   ju "Emma. I'm going to make the call. But you need to step aside while I do."
    ju "Emma, ​​eu vou tomar a decisão. Mas você precisa se afastar enquanto eu faço isso."

# game/ch2ep2.rpy:6058
translate brazil sktabdinwikcont_a2b3bfdd:

#   e "You can make the call, but I am not stepping aside until Hale confirms the report."
    e "Você pode tomar a decisão, mas eu não vou me afastar até que Hale confirme o relatório."

# game/ch2ep2.rpy:6059
translate brazil sktabdinwikcont_69f32884:

#   ju "Emma... please. I am trying to protect you. Why do you have to do this?"
    ju "Emma... por favor. Estou tentando te proteger. Por que você tem que fazer isso?"

# game/ch2ep2.rpy:6062
translate brazil sktabdinwikcont_14c3cdc2:

#   e "... Because I'm not about to make the same mistake I did before."
    e "... Porque não vou cometer o mesmo erro que cometi antes."

# game/ch2ep2.rpy:6063
translate brazil sktabdinwikcont_46f00044:

#   e "I have a friend. She would've walked into that club herself."
    e "Eu tenho uma amiga. Ela teria entrado naquela boate por conta própria."

# game/ch2ep2.rpy:6064
translate brazil sktabdinwikcont_e0520160:

#   e "No badge. No backup. Not even a sliver of hesitation."
    e "Sem distintivo. Sem apoio. Nem mesmo um resquício de hesitação."

# game/ch2ep2.rpy:6065
translate brazil sktabdinwikcont_f1d4cdf6:

#   e "Because that's just who she is."
    e "Porque é simplesmente quem ela é."

# game/ch2ep2.rpy:6066
translate brazil sktabdinwikcont_26bb4a1a:

#   e "She's stronger than me. Faster. Better equipped for all of it."
    e "Ela é mais forte do que eu. Mais rápida. Melhor preparada para tudo isso."

# game/ch2ep2.rpy:6067
translate brazil sktabdinwikcont_22b217bc:

#   e "And I used to tell myself that was fine."
    e "E eu costumava dizer a mim mesma que estava tudo bem."

# game/ch2ep2.rpy:6068
translate brazil sktabdinwikcont_942a8195:

#   e "That there were people better suited. That I'd done what I could."
    e "Que havia pessoas mais adequadas. Que eu tinha feito o que podia."

# game/ch2ep2.rpy:6071
translate brazil sktabdinwikcont_8adedfad:

#   e "I told myself that when [mc] got taken."
    e "Eu disse a mim mesmo que quando [mc] Foi levado."

# game/ch2ep2.rpy:6072
translate brazil sktabdinwikcont_40791b9e:

#   e "I knew something was wrong and convinced myself it wasn't my place."
    e "Eu sabia que algo estava errado e me convenci de que não era da minha conta."

# game/ch2ep2.rpy:6073
translate brazil sktabdinwikcont_2275141b:

#   e "That the right people were handling it."
    e "Que as pessoas certas estavam cuidando disso."

# game/ch2ep2.rpy:6074
translate brazil sktabdinwikcont_fc23d89b:

#   e "He got out. Everything was fine. But I should've been there."
    e "Ele conseguiu sair. Estava tudo bem. Mas eu deveria ter estado lá."

# game/ch2ep2.rpy:6077
translate brazil sktabdinwikcont_ef21ef6f:

#   e "It should've been me."
    e "Deveria ter sido eu."

# game/ch2ep2.rpy:6078
translate brazil sktabdinwikcont_5bed0e19:

#   ju "Emma..."
    ju "Emma..."

# game/ch2ep2.rpy:6079
translate brazil sktabdinwikcont_b2acbbd2:

#   e "I'm not like her, June."
    e "Eu não sou como ela, June."

# game/ch2ep2.rpy:6080
translate brazil sktabdinwikcont_464fddd4:

#   e "I can't move faster than a bullet or take a hit that would put anyone else in the ground."
    e "Não consigo me mover mais rápido que uma bala nem aguentar um golpe que derrubaria qualquer outra pessoa."

# game/ch2ep2.rpy:6081
translate brazil sktabdinwikcont_5da94a9d:

#   e "All I have is this job."
    e "Tudo o que eu tenho é este emprego."

# game/ch2ep2.rpy:6082
translate brazil sktabdinwikcont_4ca9c4a1:

#   e "And if I can't use it to protect one child..."
    e "E se eu não puder usá-lo para proteger uma única criança..."

# game/ch2ep2.rpy:6083
translate brazil sktabdinwikcont_f2964186:

#   e "Then what am I even doing here?"
    e "Então, o que é que eu estou fazendo aqui?"

# game/ch2ep2.rpy:6084
translate brazil sktabdinwikcont_a96b23a7:

#   e "What was any of it for?"
    e "Para que serviu tudo isso?"

# game/ch2ep2.rpy:6086
translate brazil sktabdinwikcont_92d75199:

#   ju "Look, I get you. But that still doesn't mean you have to risk your—"
    ju "Olha, eu te entendo. Mas isso não significa que você precise arriscar sua—"

# game/ch2ep2.rpy:6089
translate brazil sktabdinwikcont_5d60f01a:

#   e "I fell in love with her, June." with Dissolve(2.0)
    e "Eu me apaixonei por ela, June." with Dissolve(2.0)

# game/ch2ep2.rpy:6093
translate brazil sktabdinwikcont_8e0800a9:

#   el "You should tell her she left the call on."
    el "Você deveria dizer a ela que ela deixou a chamada ligada."

# game/ch2ep2.rpy:6096
translate brazil sktabdinwikcont_8266de4e:

#   e "I didn't plan it. I didn't even see it coming. But by the time I did... I didn't want to stop it."
    e "Eu não planejei isso. Nem sequer vi acontecer. Mas quando vi... não quis mais impedir."

# game/ch2ep2.rpy:6097
translate brazil sktabdinwikcont_64b5f6af:

#   e "You asked me what's different with Leah. That's your answer. That's why I'm standing here."
    e "Você me perguntou o que Leah tem de diferente. Essa é a resposta. É por isso que estou aqui."

# game/ch2ep2.rpy:6103
translate brazil sktabdinwikcont_19d67f58:

#   ph "June... if what she's saying is true, we can't risk the transfer now."
    ph "Junho... se o que ela está dizendo for verdade, não podemos arriscar a transferência agora."

# game/ch2ep2.rpy:6104
translate brazil sktabdinwikcont_a45a5a20:

#   ju "I know, Phillip. I know."
    ju "Eu sei, Phillip. Eu sei."

# game/ch2ep2.rpy:6107
translate brazil sktabdinwikcont_924b3eac:

#   e "By the time it clears the right desks, she could already be back in his hands."
    e "Quando o processo terminar e ela chegar às mesas certas, ela já poderá estar de volta em suas mãos."

# game/ch2ep2.rpy:6108
translate brazil sktabdinwikcont_1cf4b251:

#   e "I'm not taking that chance. Not with Leah."
    e "Não vou correr esse risco. Não com a Leah."

# game/ch2ep2.rpy:6124
translate brazil sktabdinwikcont_d1ddaffa:

#   "........"
    "........"

# game/ch2ep2.rpy:6125
translate brazil sktabdinwikcont_da41589f:

#   ju "Yeah. She's here."
    ju "Sim. Ela está aqui."

# game/ch2ep2.rpy:6128
translate brazil sktabdinwikcont_9ea6b0e1:

#   ".............."
    "..............."

# game/ch2ep2.rpy:6129
translate brazil sktabdinwikcont_79667eac:

#   ju "You're certain, sir?"
    ju "Tem certeza, senhor?"

# game/ch2ep2.rpy:6130
translate brazil sktabdinwikcont_a20cefa7:

#   "..."
    "..."

# game/ch2ep2.rpy:6131
translate brazil sktabdinwikcont_be697db9:

#   ju "Okay."
    ju "OK."

# game/ch2ep2.rpy:6145
translate brazil sktabdinwikcont_ac101ae9:

#   y "Cara Voss."
    y "Via Voss."

# game/ch2ep2.rpy:6146
translate brazil sktabdinwikcont_e618e1e1:

#   cara "... Yes?"
    cara "... Sim?"

# game/ch2ep2.rpy:6147
translate brazil sktabdinwikcont_63b5e84f:

#   y "Sicae. You're coming with us."
    y "Sicae. Você vem conosco."

# game/ch2ep2.rpy:6151
translate brazil sktabdinwikcont_cf436002:

#   cara "I— what? Why?"
    cara "Eu... o quê? Por quê?"

# game/ch2ep2.rpy:6152
translate brazil sktabdinwikcont_a9d4aeb9:

#   li "Oh, please... don't make things harder for yourself."
    li "Ah, por favor... não complique as coisas para você."

# game/ch2ep2.rpy:6155
translate brazil sktabdinwikcont_505527fa:

#   cara "What— I don't— what is this?! I haven't done anything!"
    cara "O quê?! Eu não... o que é isso?! Eu não fiz nada!"

# game/ch2ep2.rpy:6156
translate brazil sktabdinwikcont_e4085cd6:

#   y "*sighs* Why do they always lead with that...?"
    y "*suspiro* Por que eles sempre começam com isso...?"

# game/ch2ep2.rpy:6157
translate brazil sktabdinwikcont_97a87ceb:

#   li "Beats me."
    li "Não faço a mínima ideia."

# game/ch2ep2.rpy:6158
translate brazil sktabdinwikcont_883ed8da:

#   cara "I want a lawyer!"
    cara "Quero um advogado!"

# game/ch2ep2.rpy:6159
translate brazil sktabdinwikcont_d9739f1d:

#   li "That's not really how we work, hon."
    li "Não é bem assim que trabalhamos, querida."

# game/ch2ep2.rpy:6162
translate brazil sktabdinwikcont_d6fc17ff:

#   drp "What's— Cara?"
    drp "O que é— Cara?"

# game/ch2ep2.rpy:6163
translate brazil sktabdinwikcont_1d5ea238:

#   cara "Dr. Park, help me! I don't know what's happening!"
    cara "Dr. Park, me ajude! Eu não sei o que está acontecendo!"

# game/ch2ep2.rpy:6164
translate brazil sktabdinwikcont_6cefe1ab:

#   drp "What did she do?!"
    drp "O que ela fez?!"

# game/ch2ep2.rpy:6165
translate brazil sktabdinwikcont_02c996e4:

#   y "Above your pay grade, Doctor."
    y "Doutor, isso está acima da sua alçada."

# game/ch2ep2.rpy:6168
translate brazil sktabdinwikcont_58918190:

#   li "Have a good one."
    li "Tenha um bom dia."

# game/ch2ep2.rpy:6169
translate brazil sktabdinwikcont_76df25f7:

#   cara "Wait— where are you taking me?!"
    cara "Espere—para onde você está me levando?!"

# game/ch2ep2.rpy:6178
translate brazil sktabdinwikcont_d985784d:

#   ju "I'm sorry for the disruption."
    ju "Peço desculpas pelo transtorno."

# game/ch2ep2.rpy:6179
translate brazil sktabdinwikcont_6c47e03a:

#   ju "Phillip. Lois. Please wait for me in the lobby."
    ju "Phillip. Lois. Por favor, esperem por mim no saguão."

# game/ch2ep2.rpy:6182
translate brazil sktabdinwikcont_d412eb76:

#   ph "*nods*"
    ph "*acena com a cabeça*"

# game/ch2ep2.rpy:6185
translate brazil sktabdinwikcont_a8b50de5:

#   e "Whatever you're going to say... don't pity me. I chose this."
    e "Seja lá o que você for dizer... não tenha pena de mim. Eu escolhi isso."

# game/ch2ep2.rpy:6188
translate brazil sktabdinwikcont_771712cf:

#   ju "Hale forced me to file a report. About the placement... and what you did. You know this goes on record."
    ju "Hale me obrigou a registrar uma queixa. Sobre a colocação... e o que você fez. Você sabe que isso fica registrado."

# game/ch2ep2.rpy:6189
translate brazil sktabdinwikcont_fff7c655:

#   e "... I already know that, June."
    e "... Eu já sei disso, June."

# game/ch2ep2.rpy:6190
translate brazil sktabdinwikcont_761404df:

#   ju "... And you'd do it again."
    ju "...E você faria tudo de novo."

# game/ch2ep2.rpy:6193
translate brazil sktabdinwikcont_6361c8c3:

#   e "Yeah..."
    e "Sim..."

# game/ch2ep2.rpy:6199
translate brazil sktabdinwikcont_7448e222:

#   ju "Stay away from her, Emma. Until this is sorted. Stay away."
    ju "Fique longe dela, Emma. Até que isso se resolva. Fique longe."

# game/ch2ep2.rpy:6201
translate brazil sktabdinwikcont_cf1b8d4b:

#   ju "I mean it."
    ju "Quero dizer."

# game/ch2ep2.rpy:6205
translate brazil sktabdinwikcont_0cf41711:

#   e "Leah... I need you to go with Aunt June for now."
    e "Leah... Preciso que você vá com a tia June por enquanto."

# game/ch2ep2.rpy:6206
translate brazil sktabdinwikcont_5dd3e9ac:

#   le "Are you in trouble?"
    le "Você está em apuros?"

# game/ch2ep2.rpy:6207
translate brazil sktabdinwikcont_f0f9be8d:

#   e "*softly nods*"
    e "*acena levemente com a cabeça*"

# game/ch2ep2.rpy:6208
translate brazil sktabdinwikcont_8aec87d7:

#   le "Because of me?"
    le "Por minha causa?"

# game/ch2ep2.rpy:6212
translate brazil sktabdinwikcont_3e06f71b:

#   e "Because of {i}me{/i}."
    e "Por causa de {i} meu{/i}."

# game/ch2ep2.rpy:6215
translate brazil sktabdinwikcont_ffa47f51:

#   le "... I'm sorry." with Dissolve(1.0)
    le "... Desculpe." with Dissolve(1.0)

# game/ch2ep2.rpy:6216
translate brazil sktabdinwikcont_070958bc:

#   e "No, no... Don't be. It's my fault."
    e "Não, não... Não fique assim. A culpa é minha."

# game/ch2ep2.rpy:6224
translate brazil sktabdinwikcont_bde2d829:

#   e "Yeah. I promise."
    e "Sim. Eu prometo."

# game/ch2ep2.rpy:6225
translate brazil sktabdinwikcont_a8da2bee:

#   le "*nods* Okay..."
    le "*acena com a cabeça* Ok..."

# game/ch2ep2.rpy:6266
translate brazil sktabdinwikcont_35402734:

#   cap "Badge. Weapon. ID."
    cap "Distintivo. Arma. Identificação."

# game/ch2ep2.rpy:6316
translate brazil sktabdinwikcont_42129614:

#   cap "As of this moment, you are terminated from the department."
    cap "A partir deste momento, você está desligado(a) do departamento."

# game/ch2ep2.rpy:6317
translate brazil sktabdinwikcont_54ab8ef0:

#   cap "Grounds: insubordination, obstruction of an official DFCS proceeding, and conduct unbecoming of a sworn officer."
    cap "Motivos: insubordinação, obstrução de um processo oficial do DFCS e conduta incompatível com a de um agente juramentado."

# game/ch2ep2.rpy:6318
translate brazil sktabdinwikcont_ca280cb0:

#   cap "Your record will reflect all three."
    cap "Seu registro refletirá os três."

# game/ch2ep2.rpy:6320
translate brazil sktabdinwikcont_16fff1de:

#   cap "Any future application to law enforcement—any department, any jurisdiction—will require a full disclosure review."
    cap "Qualquer solicitação futura às autoridades policiais — qualquer departamento, qualquer jurisdição — exigirá uma análise completa de antecedentes."

# game/ch2ep2.rpy:6321
translate brazil sktabdinwikcont_b6b31bb9:

#   cap "You'll likely never hold a badge again."
    cap "É provável que você nunca mais volte a usar um distintivo."

# game/ch2ep2.rpy:6324
translate brazil sktabdinwikcont_59ee0508:

#   cap "..."
    cap "..."

# game/ch2ep2.rpy:6325
translate brazil sktabdinwikcont_17691451:

#   cap "Is that the Francis location?"
    cap "É aquele lugar chamado Francis?"

# game/ch2ep2.rpy:6330
translate brazil sktabdinwikcont_00ba4d98:

#   cap "Good work."
    cap "Bom trabalho."

# game/ch2ep2.rpy:6331
translate brazil sktabdinwikcont_58cb631e:

#   cap "For what it's worth."
    cap "Pelo que isso possa valer."

# game/ch2ep2.rpy:6336
translate brazil sktabdinwikcont_3f119295:

#   cap "The Francis case will be handed to Sicae."
    cap "O caso Francis será entregue à Sicae."

# game/ch2ep2.rpy:6337
translate brazil sktabdinwikcont_71e065fc:

#   cap "Should've been theirs from the off, if I'm being honest."
    cap "Para ser sincero, deveriam ter sido deles desde o início."

# game/ch2ep2.rpy:6338
translate brazil sktabdinwikcont_ece03b7a:

#   cap "The trafficking network, the sister, whatever he's actually after—"
    cap "A rede de tráfico, a irmã, seja lá o que ele esteja realmente procurando—"

# game/ch2ep2.rpy:6339
translate brazil sktabdinwikcont_e5404963:

#   cap "That's not our standard jurisdiction. That's their world. We were always just on the fringes."
    cap "Essa não é a nossa jurisdição padrão. Esse é o mundo deles. Nós sempre estivemos à margem."

# game/ch2ep2.rpy:6340
translate brazil sktabdinwikcont_c0f9e00c:

#   cap "They'll see it through."
    cap "Eles vão levar isso adiante."

# game/ch2ep2.rpy:6347
translate brazil sktabdinwikcont_2bd0d4ef:

#   cap "I've got four kids, Meyer."
    cap "Eu tenho quatro filhos, Meyer."

# game/ch2ep2.rpy:6348
translate brazil sktabdinwikcont_615c7648:

#   cap "Four."
    cap "Quatro."

# game/ch2ep2.rpy:6349
translate brazil sktabdinwikcont_6bdf790f:

#   cap "And I'd like to think I'd have done exactly what you did."
    cap "E eu gostaria de pensar que teria feito exatamente o que você fez."

# game/ch2ep2.rpy:6353
translate brazil sktabdinwikcont_c668ba64:

#   cap "But I wouldn't have."
    cap "Mas eu não teria feito isso."

# game/ch2ep2.rpy:6354
translate brazil sktabdinwikcont_d4328a0e:

#   cap "Because I know what this job demands. And so did you. That's what makes this particularly hard to stomach."
    cap "Porque eu sei o que este trabalho exige. E você também sabia. É isso que torna tudo isso particularmente difícil de aceitar."

# game/ch2ep2.rpy:6360
translate brazil sktabdinwikcont_24a91fc9:

#   cap "I came up under a detective named Garcia. Twenty-two years on the force. Best I've ever seen."
    cap "Comecei a trabalhar com um detetive chamado Garcia. Vinte e dois anos na polícia. O melhor que já vi."

# game/ch2ep2.rpy:6361
translate brazil sktabdinwikcont_1cba758d:

#   cap "Lost his badge over a case not entirely unlike this one."
    cap "Perdeu o distintivo num caso não muito diferente deste."

# game/ch2ep2.rpy:6362
translate brazil sktabdinwikcont_6f7cab3d:

#   cap "I watched him hand it over."
    cap "Eu o vi entregar."

# game/ch2ep2.rpy:6363
translate brazil sktabdinwikcont_827c7f4b:

#   cap "Told myself I'd never be the one on the other side of that desk."
    cap "Disse a mim mesma que nunca seria eu a pessoa do outro lado daquela mesa."

# game/ch2ep2.rpy:6366
translate brazil sktabdinwikcont_d02ba5e3:

#   cap "But here we are."
    cap "Mas aqui estamos nós."

# game/ch2ep2.rpy:6370
translate brazil sktabdinwikcont_0f6567d0:

#   cap "Whatever happens with the child, that's no longer your concern. Professionally."
    cap "Aconteça o que acontecer com a criança, isso não é mais da sua conta. Profissionalmente."

# game/ch2ep2.rpy:6371
translate brazil sktabdinwikcont_af52dc39:

#   cap "I trust you understand the distinction."
    cap "Confio que você compreenda a distinção."

# game/ch2ep2.rpy:6372
translate brazil sktabdinwikcont_358d1a49:

#   e "Yes, sir."
    e "Sim, senhor."

# game/ch2ep2.rpy:6376
translate brazil sktabdinwikcont_35e9669a:

#   cap "You were one of the best I had, Meyer. Don't make me regret saying that."
    cap "Você foi um dos melhores que eu tive, Meyer. Não me faça me arrepender de ter dito isso."

# game/ch2ep2.rpy:6398
translate brazil sktabdinwikcont_6958a743:

#   nic "Lycoris. Do you copy?"
    nic "Lycoris. Câmbio?"

# game/ch2ep2.rpy:6399
translate brazil sktabdinwikcont_c61384bd:

#   la "*comms* Go ahead."
    la "*comunicações* Pode prosseguir."

# game/ch2ep2.rpy:6400
translate brazil sktabdinwikcont_40fec2f0:

#   nic "He's not here."
    nic "Ele não está aqui."

# game/ch2ep2.rpy:6401
translate brazil sktabdinwikcont_15c68774:

#   nic "Most of his men stood down. One didn't. He's been handled. The rest are with the police."
    nic "A maioria dos seus homens se rendeu. Um não. Ele já foi detido. Os demais estão sob custódia da polícia."

# game/ch2ep2.rpy:6402
translate brazil sktabdinwikcont_2128807f:

#   mc "*comms* What about the location?"
    mc "*comunicações* E quanto à localização?"

# game/ch2ep2.rpy:6405
translate brazil sktabdinwikcont_e0996aac:

#   nic "..."
    nic "..."

# game/ch2ep2.rpy:6406
translate brazil sktabdinwikcont_4e8c9817:

#   nic "You're going to want to see this yourself."
    nic "Você vai querer ver isso com seus próprios olhos."

# game/ch2ep2.rpy:6407
translate brazil sktabdinwikcont_49338710:

#   mc "*comms* Talk to me, Nicky."
    mc "*comunicação* Fale comigo, Nicky."

# game/ch2ep2.rpy:6408
translate brazil sktabdinwikcont_728d6b67:

#   nic "... Photos. Mostly children. Every face scratched out except one."
    nic "... Fotos. Principalmente de crianças. Todos os rostos riscados, exceto um."

# game/ch2ep2.rpy:6409
translate brazil sktabdinwikcont_f1dde69a:

#   nic "The center photo. No scratch marks."
    nic "A foto do meio. Sem arranhões."

# game/ch2ep2.rpy:6410
translate brazil sktabdinwikcont_6fb85146:

#   mc "*comms* Leah?"
    mc "*comunicações* Leah?"

# game/ch2ep2.rpy:6411
translate brazil sktabdinwikcont_06fcaad3:

#   nic "Yeah."
    nic "Sim."

# game/ch2ep2.rpy:6414
translate brazil sktabdinwikcont_40ea2a16:

#   nic "There's a mirror too. Cracked. Empty polaroid film tucked into the frame."
    nic "Há também um espelho. Rachado. Um filme Polaroid vazio enfiado na moldura."

# game/ch2ep2.rpy:6415
translate brazil sktabdinwikcont_351bd29d:

#   nic "No photo. Just the film."
    nic "Sem foto. Apenas o filme."

# game/ch2ep2.rpy:6416
translate brazil sktabdinwikcont_27ac2118:

#   nic "What the hell is going on in this guy's head?"
    nic "Que diabos se passa na cabeça desse cara?"

# game/ch2ep2.rpy:6419
translate brazil sktabdinwikcont_4bed1728:

#   nic "And there's books."
    nic "E há livros."

# game/ch2ep2.rpy:6420
translate brazil sktabdinwikcont_2d393eab:

#   nic "Human Anatomy. Medical Practices. An Analysis of Healthcare. The Human Mind."
    nic "Anatomia Humana. Práticas Médicas. Uma Análise da Assistência à Saúde. A Mente Humana."

# game/ch2ep2.rpy:6423
translate brazil sktabdinwikcont_743a19aa:

#   nic "Ooh, can I—"
    nic "Ah, posso—"

# game/ch2ep2.rpy:6424
translate brazil sktabdinwikcont_9c97607a:

#   y " *comms* Not the time for shopping, Princess."
    y " *comunicação* Não é hora para compras, Princesa."

# game/ch2ep2.rpy:6425
translate brazil sktabdinwikcont_7dcecc3b:

#   nic "Damn it."
    nic "Caramba."

# game/ch2ep2.rpy:6426
translate brazil sktabdinwikcont_f3e5a156:

#   la "*comms* Bag everything. Don't touch anything else."
    la "*comunicações* Embale tudo. Não toque em mais nada."

# game/ch2ep2.rpy:6427
translate brazil sktabdinwikcont_7abef0b9:

#   nic "Copy."
    nic "Cópia."

# game/ch2ep2.rpy:6431
translate brazil sktabdinwikcont_8c5dce78:

#   la "If he's not there, then..."
    la "Se ele não estiver lá, então..."

# game/ch2ep2.rpy:6432
translate brazil sktabdinwikcont_361b5749:

#   mc "His composure's gotten better. His thinking hasn't. He always figures he's the smartest guy in the room."
    mc "Sua compostura melhorou. Seu raciocínio, não. Ele sempre acha que é o cara mais inteligente da sala."

# game/ch2ep2.rpy:6433
translate brazil sktabdinwikcont_4bb0dd90:

#   mc "He'll be here."
    mc "Ele estará aqui."

# game/ch2ep2.rpy:6445
translate brazil sktabdinwikcont_e53a0baa:

#   mc "And... there he is."
    mc "E... lá está ele."

# game/ch2ep2.rpy:6446
translate brazil sktabdinwikcont_ddb6fabb:

#   la "*chuckles*"
    la "*risos*"

# game/ch2ep2.rpy:6450
translate brazil sktabdinwikcont_d493c1d1:

#   fr "I was wondering why the street was empty."
    fr "Eu estava me perguntando por que a rua estava vazia."

# game/ch2ep2.rpy:6451
translate brazil sktabdinwikcont_efdeffdc:

#   mc "You should've stayed in your cave."
    mc "Você devia ter ficado na sua caverna."

# game/ch2ep2.rpy:6454
translate brazil sktabdinwikcont_bc5ca370:

#   fr "And miss this?"
    fr "E perder isso?"

# game/ch2ep2.rpy:6469
translate brazil sktabdinwikcont_f4d71cd8:

#   fr "You found the location through her, didn't you? The detective."
    fr "Você descobriu a localização por meio dela, não foi? A detetive."

# game/ch2ep2.rpy:6470
translate brazil sktabdinwikcont_586a271b:

#   fr "She's something. You should hold onto her."
    fr "Ela é especial. Você deveria valorizá-la."

# game/ch2ep2.rpy:6471
translate brazil sktabdinwikcont_e044abe8:

#   mc "Maybe. Could've also used men who don't roll over the second someone flashes a badge."
    mc "Talvez. Também poderiam ter usado homens que não se acovardam ao menor sinal de que alguém mostre um distintivo."

# game/ch2ep2.rpy:6473
translate brazil sktabdinwikcont_4d2dc734:

#   mc "Take him in."
    mc "Acolha-o."

# game/ch2ep2.rpy:6476
translate brazil sktabdinwikcont_1e73152e:

#   fr "I'll find another one, you know."
    fr "Eu vou encontrar outro, sabe?"

# game/ch2ep2.rpy:6477
translate brazil sktabdinwikcont_eb259930:

#   fr "I always do."
    fr "Eu sempre faço isso."

# game/ch2ep2.rpy:6478
translate brazil sktabdinwikcont_4c260920:

#   mc "Good luck with that. Hope your \"sister\" finally gets some rest."
    mc "Boa sorte com isso. Espero que sua \"irmã\" finalmente consiga descansar."

# game/ch2ep2.rpy:6482
translate brazil sktabdinwikcont_09396fec:

#   cl "Shall we see how long that bravado lasts, boy?"
    cl "Vamos ver quanto tempo dura essa bravata, rapaz?"

# game/ch2ep2.rpy:6509
translate brazil sktabdinwikcont_afc0de79:

#   ju "I'm sorry, Emma."
    ju "Sinto muito, Emma."

# game/ch2ep2.rpy:6510
translate brazil sktabdinwikcont_18db495f:

#   e "... You did what you had to do."
    e "...Você fez o que tinha que fazer."

# game/ch2ep2.rpy:6511
translate brazil sktabdinwikcont_989ff1c0:

#   ju "So did you."
    ju "Você também."

# game/ch2ep2.rpy:6516
translate brazil sktabdinwikcont_0c76a500:

#   ju "I shouldn't be telling you this, but the placement is void."
    ju "Não deveria estar te dizendo isso, mas a vaga está cancelada."

# game/ch2ep2.rpy:6517
translate brazil sktabdinwikcont_a8266700:

#   e "Cara."
    e "Método."

# game/ch2ep2.rpy:6518
translate brazil sktabdinwikcont_d7616361:

#   ju "Yeah. Family's been sent home. Case is flagged for reassessment."
    ju "Sim. A família foi mandada para casa. O caso foi sinalizado para reavaliação."

# game/ch2ep2.rpy:6519
translate brazil sktabdinwikcont_b244b92d:

#   ju "Leah's back at the hospital for now. Same room."
    ju "Leah está de volta ao hospital por enquanto. No mesmo quarto."

# game/ch2ep2.rpy:6520
translate brazil sktabdinwikcont_ab22d685:

#   ju "We added some extra security measures, but it's not like we can just lock her in there."
    ju "Adicionamos algumas medidas de segurança extras, mas não é como se pudéssemos simplesmente trancá-la lá dentro."

# game/ch2ep2.rpy:6524
translate brazil sktabdinwikcont_bb2d26be:

#   ju "She asked about you while we were sorting things out."
    ju "Ela perguntou por você enquanto estávamos resolvendo as coisas."

# game/ch2ep2.rpy:6526
translate brazil sktabdinwikcont_eef9ae35:

#   ju "Asked if you were going to be okay."
    ju "Perguntaram se você ficaria bem."

# game/ch2ep2.rpy:6527
translate brazil sktabdinwikcont_bb7acdee:

#   ju "Just that."
    ju "Exatamente isso."

# game/ch2ep2.rpy:6528
translate brazil sktabdinwikcont_bcbbf6fd:

#   ju "... I didn't have an answer for her."
    ju "... Eu não tinha resposta para ela."

# game/ch2ep2.rpy:6534
translate brazil sktabdinwikcont_6fff46d7:

#   ju "Get some sleep. Both of you."
    ju "Durmam um pouco. Vocês dois."

# game/ch2ep2.rpy:6540
translate brazil sktabdinwikcont_dd61c100:

#   mc "Come on. You need to eat."
    mc "Vamos lá. Você precisa comer."

# game/ch2ep2.rpy:6541
translate brazil sktabdinwikcont_df24c661:

#   e "I'm not really hungry."
    e "Eu não estou com fome."

# game/ch2ep2.rpy:6542
translate brazil sktabdinwikcont_ad8db0d5:

#   mc "When's the last time you ate?"
    mc "Quando foi a última vez que você comeu?"

# game/ch2ep2.rpy:6543
translate brazil sktabdinwikcont_2de3bcfe:

#   e "I... don't remember."
    e "Eu... não me lembro."

# game/ch2ep2.rpy:6548
translate brazil sktabdinwikcont_ecf61e0e:

#   mc "Come on."
    mc "Vamos."

# game/ch2ep2.rpy:6572
translate brazil sktabdinwikcont_8992003a:

#   mc "Talk to me."
    mc "Fale comigo."

# game/ch2ep2.rpy:6573
translate brazil sktabdinwikcont_40ee61b1:

#   e "About what?"
    e "Sobre o quê?"

# game/ch2ep2.rpy:6574
translate brazil sktabdinwikcont_8175543d:

#   mc "About whatever's been eating you alive since you walked out of that hospital."
    mc "Seja lá o que for que esteja te consumindo desde que você saiu daquele hospital."

# game/ch2ep2.rpy:6578
translate brazil sktabdinwikcont_4cfc14f3:

#   e "There's nothing to talk about. The placement fell through. June will find another family. That's it."
    e "Não há nada a comentar. A colocação não se concretizou. June encontrará outra família. É isso."

# game/ch2ep2.rpy:6579
translate brazil sktabdinwikcont_ee8d0e6c:

#   mc "Is that what you want?"
    mc "É isso que você quer?"

# game/ch2ep2.rpy:6580
translate brazil sktabdinwikcont_a73c8506:

#   e "What I want doesn't factor into this."
    e "O que eu quero não entra em questão."

# game/ch2ep2.rpy:6581
translate brazil sktabdinwikcont_d0ff56a6:

#   mc "You said that last time too. Cut it out, Em."
    mc "Você disse isso da última vez também. Pare com isso, Em."

# game/ch2ep2.rpy:6582
translate brazil sktabdinwikcont_16b04d09:

#   e "... Because it's true."
    e "... Porque é verdade."

# game/ch2ep2.rpy:6583
translate brazil sktabdinwikcont_12031422:

#   mc "You blocked a DFCS transfer. Told June you fell in love with Leah in front of her supposed foster family."
    mc "Você bloqueou uma transferência do DFCS. Disse a June que se apaixonou por Leah na frente da suposta família adotiva dela."

# game/ch2ep2.rpy:6584
translate brazil sktabdinwikcont_721f811e:

#   mc "If what you want doesn't factor in, you've got a real strange way of showing it."
    mc "Se o que você quer não entra em jogo, você tem uma maneira muito estranha de demonstrar isso."

# game/ch2ep2.rpy:6587
translate brazil sktabdinwikcont_59245d7c:

#   e "What do you want me to say, [mc]?"
    e "O que você quer que eu diga? [mc]?"

# game/ch2ep2.rpy:6588
translate brazil sktabdinwikcont_7662583c:

#   mc "Whatever you've been choking on."
    mc "Seja lá o que for que esteja te engasgando."

# game/ch2ep2.rpy:6592
translate brazil sktabdinwikcont_73c087dd:

#   e "The truth is, I lost my badge, my career, and probably my credibility in one afternoon."
    e "A verdade é que perdi meu distintivo, minha carreira e provavelmente minha credibilidade em uma única tarde."

# game/ch2ep2.rpy:6593
translate brazil sktabdinwikcont_4c7f0540:

#   e "The truth is, June pulled me off the case and I still showed up."
    e "A verdade é que June me afastou do caso, mas mesmo assim eu apareci."

# game/ch2ep2.rpy:6594
translate brazil sktabdinwikcont_99419079:

#   e "The truth is, I can't stop thinking about a ten-year-old we pulled out of a trafficking ring."
    e "A verdade é que não consigo parar de pensar em uma menina de dez anos que tiramos de uma rede de tráfico humano."

# game/ch2ep2.rpy:6595
translate brazil sktabdinwikcont_a966427e:

#   mc "I'm not asking about those. I'm asking what's underneath all of it."
    mc "Não estou perguntando sobre isso. Estou perguntando o que está por trás de tudo isso."

# game/ch2ep2.rpy:6599
translate brazil sktabdinwikcont_b196867d:

#   e "If I say it out loud, I can't take it back."
    e "Se eu disser em voz alta, não posso voltar atrás."

# game/ch2ep2.rpy:6600
translate brazil sktabdinwikcont_cf0490b6:

#   mc "Em... What am I to you? Don't you trust me?"
    mc "Hum... O que eu sou para você? Você não confia em mim?"

# game/ch2ep2.rpy:6602
translate brazil sktabdinwikcont_fb43015c:

#   mc "Then say it."
    mc "Então diga isso."

# game/ch2ep2.rpy:6609
translate brazil sktabdinwikcont_8af34539:

#   e "I want to adopt her."
    e "Quero adotá-la."

# game/ch2ep2.rpy:6610
translate brazil sktabdinwikcont_f962bb7e:

#   mc "Oh. Okay."
    mc "Oh, tudo bem."

# game/ch2ep2.rpy:6618
translate brazil sktabdinwikcont_1fb167ea:

#   e "Because I'll have to feed her. Take her to school. Help with homework. Deal with the tantrums, the questions, the nights she can't sleep."
    e "Porque terei que alimentá-la. Levá-la para a escola. Ajudá-la com a lição de casa. Lidar com as birras, as perguntas, as noites em que ela não consegue dormir."

# game/ch2ep2.rpy:6621
translate brazil sktabdinwikcont_5c5d9188:

#   mc "By the gods... you've already thought it through."
    mc "Pelos deuses... você já pensou em tudo."

# game/ch2ep2.rpy:6622
translate brazil sktabdinwikcont_1a932eb1:

#   e "[mc]... I'm being serious."
    e "[mc]... Estou falando sério."

# game/ch2ep2.rpy:6623
translate brazil sktabdinwikcont_b1195c8c:

#   mc "What? So am I."
    mc "O quê? Eu também."

# game/ch2ep2.rpy:6624
translate brazil sktabdinwikcont_2f85c9a1:

#   e "It's not that. It's just..."
    e "Não é isso. É só que..."

# game/ch2ep2.rpy:6625
translate brazil sktabdinwikcont_023eb8c7:

#   e "... I've never done any of that. I don't know how."
    e "... Nunca fiz nada disso. Não sei como."

# game/ch2ep2.rpy:6626
translate brazil sktabdinwikcont_9ff68c96:

#   mc "Nobody does the first time."
    mc "Ninguém consegue na primeira vez."

# game/ch2ep2.rpy:6629
translate brazil sktabdinwikcont_8a935555:

#   e "So you know how?"
    e "Então você sabe como?"

# game/ch2ep2.rpy:6631
translate brazil sktabdinwikcont_fca52711:

#   mc "No."
    mc "Não."

# game/ch2ep2.rpy:6634
translate brazil sktabdinwikcont_fbde0904:

#   e "And my record. That follows me everywhere now."
    e "E meu histórico. Isso me persegue por todo lado agora."

# game/ch2ep2.rpy:6635
translate brazil sktabdinwikcont_b8904a9b:

#   e "CPS will see it. The judge will see it. Any lawyer worth half their salt will use it against me."
    e "O Conselho Tutelar verá isso. O juiz verá isso. Qualquer advogado minimamente competente usará isso contra mim."

# game/ch2ep2.rpy:6636
translate brazil sktabdinwikcont_780231fb:

#   e "June said the reassessment opens a door, but it's probably one I'll get turned away from."
    e "June disse que a reavaliação abre uma porta, mas provavelmente é uma porta da qual serei rejeitada."

# game/ch2ep2.rpy:6637
translate brazil sktabdinwikcont_b3c4ce76:

#   mc "So you'd rather not try?"
    mc "Então você prefere não tentar?"

# game/ch2ep2.rpy:6639
translate brazil sktabdinwikcont_0bea442f:

#   mc "Em. The paperwork, the record, the logistics—you'd grind through all of it. I've seen you do harder things on less sleep."
    mc "Hum. A papelada, os registros, a logística — você daria conta de tudo isso. Eu já vi você fazer coisas mais difíceis com menos horas de sono."

# game/ch2ep2.rpy:6640
translate brazil sktabdinwikcont_3aa22ce9:

#   mc "That's not what's stopping you."
    mc "Não é isso que está te impedindo."

# game/ch2ep2.rpy:6644
translate brazil sktabdinwikcont_0b74d035:

#   e "You know what I told you at the hospital. About my mom. About the promise."
    e "Você sabe o que eu te contei no hospital. Sobre minha mãe. Sobre a promessa."

# game/ch2ep2.rpy:6646
translate brazil sktabdinwikcont_f6b81232:

#   e "That was about Leah getting hurt. This is totally different."
    e "Aquilo era sobre a Leah ter se machucado. Isso é totalmente diferente."

# game/ch2ep2.rpy:6647
translate brazil sktabdinwikcont_957c816e:

#   e "If I adopt her, I'm choosing it. On purpose."
    e "Se eu a adotar, será uma escolha minha. De propósito."

# game/ch2ep2.rpy:6648
translate brazil sktabdinwikcont_df5d5886:

#   e "I'm walking into a room and saying, \"Depend on me. Build your life around me. I'll be the person you come home to.\""
    e "Entro numa sala e digo: \"Dependa de mim. Construa sua vida ao meu redor. Serei a pessoa para quem você voltará para casa.\""

# game/ch2ep2.rpy:6649
translate brazil sktabdinwikcont_677616b0:

#   e "And then one day, I won't be there."
    e "E então, um dia, eu não estarei mais lá."

# game/ch2ep2.rpy:6651
translate brazil sktabdinwikcont_3d24ddac:

#   e "My mom didn't choose it either."
    e "Minha mãe também não escolheu essa opção."

# game/ch2ep2.rpy:6652
translate brazil sktabdinwikcont_4caa9cdf:

#   e "But this would be worse. I'd be looking at a kid who's already been abandoned and saying, \"Trust me,\" knowing full well what I am."
    e "Mas isso seria pior. Eu estaria olhando para uma criança que já foi abandonada e dizendo: \"Confie em mim\", sabendo muito bem quem eu sou."

# game/ch2ep2.rpy:6653
translate brazil sktabdinwikcont_cc6e65f1:

#   mc "What you are?"
    mc "O que você é?"

# game/ch2ep2.rpy:6654
translate brazil sktabdinwikcont_8d3808d8:

#   e "Temporary. I know everyone is."
    e "Temporário. Eu sei que todos estão."

# game/ch2ep2.rpy:6655
translate brazil sktabdinwikcont_225fb21c:

#   e "But do I really want to do that to a child who's already learned that lesson the hard way?"
    e "Mas será que eu realmente quero fazer isso com uma criança que já aprendeu essa lição da maneira mais difícil?"

# game/ch2ep2.rpy:6659
translate brazil sktabdinwikcont_48277ae6:

#   e "She's already afraid that people will leave her, [mc]."
    e "Ela já tem medo de que as pessoas a abandonem. [mc]."

# game/ch2ep2.rpy:6660
translate brazil sktabdinwikcont_042c5a62:

#   e "Her mom sold her. The system shuffled her around. Every adult in her life has been a revolving door."
    e "A mãe dela a vendeu. O sistema a transferiu de um lado para o outro. Todos os adultos em sua vida foram como uma porta giratória."

# game/ch2ep2.rpy:6661
translate brazil sktabdinwikcont_2308161d:

#   e "And I'm supposed to walk through it and tell her this time is different?"
    e "E eu deveria atravessar tudo isso e dizer a ela que desta vez é diferente?"

# game/ch2ep2.rpy:6662
translate brazil sktabdinwikcont_a6d34b68:

#   e "What makes me different? Because I care? My mom cared. Caring didn't keep her alive."
    e "O que me torna diferente? O fato de eu me importar? Minha mãe se importava. Mas se importar não a manteve viva."

# game/ch2ep2.rpy:6665
translate brazil sktabdinwikcont_87a390c3:

#   mc "... You're right."
    mc "... Você tem razão."

# game/ch2ep2.rpy:6666
translate brazil sktabdinwikcont_9142bb71:

#   mc "You will leave her."
    mc "Você vai deixá-la."

# game/ch2ep2.rpy:6670
translate brazil sktabdinwikcont_a11f06a4:

#   mc "One day, for whatever reason, you won't be there. Could be years. Could be decades. Doesn't matter."
    mc "Um dia, por algum motivo, você não estará mais lá. Podem ser anos. Podem ser décadas. Não importa."

# game/ch2ep2.rpy:6671
translate brazil sktabdinwikcont_b2bccb12:

#   mc "You'll leave. Everyone does."
    mc "Você vai embora. Todo mundo vai."

# game/ch2ep2.rpy:6672
translate brazil sktabdinwikcont_a13a0a27:

#   mc "Your mom left. Jovian left. The world doesn't hand out exceptions for the people who love the hardest."
    mc "Sua mãe foi embora. Jovian foi embora. O mundo não abre exceções para quem ama com mais intensidade."

# game/ch2ep2.rpy:6673
translate brazil sktabdinwikcont_cc46c79b:

#   e "Then why would I put her through that?"
    e "Então por que eu a faria passar por isso?"

# game/ch2ep2.rpy:6676
translate brazil sktabdinwikcont_c49f6e9c:

#   mc "Because your mom had the greatest time of her life with you anyway."
    mc "Porque, de qualquer forma, sua mãe se divertiu muito com você."

# game/ch2ep2.rpy:6677
translate brazil sktabdinwikcont_1cd32f84:

#   mc "I never got to meet her, but I know she wouldn't have traded a single day."
    mc "Nunca cheguei a conhecê-la, mas sei que ela não trocaria um único dia por nada."

# game/ch2ep2.rpy:6679
translate brazil sktabdinwikcont_99b258d1:

#   mc "She knew she was dying. She knew she couldn't keep that promise. Yet she still made it."
    mc "Ela sabia que estava morrendo. Sabia que não conseguiria cumprir aquela promessa. Mesmo assim, ela a fez."

# game/ch2ep2.rpy:6680
translate brazil sktabdinwikcont_2eac7039:

#   mc "She gave you something to hold onto when she couldn't hold you anymore."
    mc "Ela te deu algo para se agarrar quando não pôde mais te abraçar."

# game/ch2ep2.rpy:6681
translate brazil sktabdinwikcont_48509d69:

#   mc "It's been seventeen years since and you still carry it. You carried it into that club. You carried it into Leah's hospital room."
    mc "Já se passaram dezessete anos e você ainda carrega isso. Você o carregou até aquele clube. Você o carregou até o quarto de hospital da Leah."

# game/ch2ep2.rpy:6682
translate brazil sktabdinwikcont_1b3e13c9:

#   mc "From what I see, that promise didn't break you, Em. It kept you standing."
    mc "Pelo que vejo, essa promessa não te destruiu, Em. Ela te manteve de pé."

# game/ch2ep2.rpy:6684
translate brazil sktabdinwikcont_5ba52a63:

#   mc "You can't give Leah forever. Nobody gets to do that."
    mc "Você não pode dar Leah para sempre. Ninguém tem esse direito."

# game/ch2ep2.rpy:6685
translate brazil sktabdinwikcont_34882c36:

#   mc "But you can be there until you can't. And that's what she'll carry."
    mc "Mas você pode estar lá até não poder mais. E é isso que ela carregará consigo."

# game/ch2ep2.rpy:6686
translate brazil sktabdinwikcont_e1a21be5:

#   mc "You hear me?"
    mc "Você me ouve?"

# game/ch2ep2.rpy:6698
translate brazil sktabdinwikcont_186ed532:

#   e "I need to talk to June."
    e "Preciso falar com June."

# game/ch2ep2.rpy:6699
translate brazil sktabdinwikcont_41d1bc87:

#   mc "Uhh... It's almost past midnight."
    mc "Hum... Já passa da meia-noite."

# game/ch2ep2.rpy:6700
translate brazil sktabdinwikcont_e04eeaae:

#   e "Then I'll be at her door first thing in the morning."
    e "Então estarei à porta dela logo pela manhã."

# game/ch2ep2.rpy:6708
translate brazil sktabdinwikcont_2c08ee1f:

#   mc "Whatever happens, I'm with you."
    mc "Aconteça o que acontecer, estou contigo."

# game/ch2ep2.rpy:6747
translate brazil sktabdinwikcont_f1435f5e:

#   ju "Jesus, Emma... It's four in the morning."
    ju "Jesus, Emma... São quatro da manhã."

# game/ch2ep2.rpy:6748
translate brazil sktabdinwikcont_cee36124:

#   e "Sorry. I couldn't sleep."
    e "Desculpe. Não consegui dormir."

# game/ch2ep2.rpy:6750
translate brazil sktabdinwikcont_8be37e24:

#   ju "This better be worth it."
    ju "Isso tem que valer a pena."

# game/ch2ep2.rpy:6753
translate brazil sktabdinwikcont_8bde3d8d:

#   e "I want to submit an adoption application for Leah."
    e "Quero submeter um pedido de adoção para Leah."

# game/ch2ep2.rpy:6763
translate brazil sktabdinwikcont_3252b5b9:

#   ju "... I'm listening."
    ju "... Estou ouvindo."

# game/ch2ep2.rpy:6764
translate brazil sktabdinwikcont_4e50242b:

#   e "The placement is void. The review's still open."
    e "A vaga foi cancelada. A avaliação ainda está em aberto."

# game/ch2ep2.rpy:6765
translate brazil sktabdinwikcont_f12a91f1:

#   e "My record says what it says. I'm not here to argue that."
    e "Meu histórico fala por si só. Não estou aqui para discutir isso."

# game/ch2ep2.rpy:6766
translate brazil sktabdinwikcont_8fd95e79:

#   e "I've got [mc]'s charity behind me. Whatever the board needs to see."
    e "Eu tenho [mc] A instituição de caridade está ao meu lado. Tudo o que o conselho precisar ver."

# game/ch2ep2.rpy:6767
translate brazil sktabdinwikcont_1447c000:

#   ju "Knowing her isn't a legal qualification."
    ju "Conhecê-la não é uma qualificação legal."

# game/ch2ep2.rpy:6770
translate brazil sktabdinwikcont_7e878cd7:

#   e "No. But it's the only thing that's actually worked."
    e "Não. Mas é a única coisa que realmente funcionou."

# game/ch2ep2.rpy:6771
translate brazil sktabdinwikcont_93a3ee48:

#   e "She eats because she thinks I'll ask about it. She stays up late so she can be next to me a little longer."
    e "Ela come porque acha que eu vou perguntar sobre isso. Ela fica acordada até tarde para poder ficar um pouco mais perto de mim."

# game/ch2ep2.rpy:6772
translate brazil sktabdinwikcont_e597648a:

#   e "That doesn't happen for the system, June. It happens because of me."
    e "Isso não acontece por causa do sistema, June. Acontece por minha causa."

# game/ch2ep2.rpy:6776
translate brazil sktabdinwikcont_9e1dc207:

#   e "I don't have a badge anymore. I can't pull rank or call in favors."
    e "Eu não tenho mais distintivo. Não posso usar minha posição hierárquica nem pedir favores."

# game/ch2ep2.rpy:6777
translate brazil sktabdinwikcont_adbad8e9:

#   e "All I've got is a disqualifying record and a kid who drew me holding a coffee cup before she even knew my name."
    e "Tudo o que me resta é uma ficha criminal desqualificante e uma criança que me desenhou segurando uma xícara de café antes mesmo de saber meu nome."

# game/ch2ep2.rpy:6778
translate brazil sktabdinwikcont_097629f9:

#   e "If that's not enough, tell me now and I'll go home."
    e "Se isso não for suficiente, diga-me agora e eu irei para casa."

# game/ch2ep2.rpy:6781
translate brazil sktabdinwikcont_d4f280e8:

#   ju "Adoption is a longer road than placement. You understand that."
    ju "A adoção é um caminho mais longo do que a colocação familiar. Você entende isso."

# game/ch2ep2.rpy:6782
translate brazil sktabdinwikcont_b9de53ef:

#   e "I do."
    e "Eu faço."

# game/ch2ep2.rpy:6785
translate brazil sktabdinwikcont_64fdfc0a:

#   ju "Background checks. Home evaluation. Psych review. Financial assessment."
    ju "Verificação de antecedentes. Avaliação domiciliar. Avaliação psicológica. Avaliação financeira."

# game/ch2ep2.rpy:6786
translate brazil sktabdinwikcont_df38e73b:

#   ju "Your termination record gets scrutinized at every stage."
    ju "Seu histórico de demissões é analisado minuciosamente em todas as etapas."

# game/ch2ep2.rpy:6787
translate brazil sktabdinwikcont_dfab8f28:

#   ju "And after all of that, it still goes before a judge."
    ju "E depois de tudo isso, o caso ainda vai parar nas mãos de um juiz."

# game/ch2ep2.rpy:6792
translate brazil sktabdinwikcont_31215116:

#   ju "Submit through proper channels."
    ju "Envie a solicitação pelos canais adequados."

# game/ch2ep2.rpy:6793
translate brazil sktabdinwikcont_78bf6ba4:

#   ju "Don't knock on my door about it. Don't fish for updates."
    ju "Não bata na minha porta para falar sobre isso. Não fique procurando informações."

# game/ch2ep2.rpy:6794
translate brazil sktabdinwikcont_c716a1d8:

#   ju "Let. The process. Run."
    ju "Deixe o processo correr."

# game/ch2ep2.rpy:6795
translate brazil sktabdinwikcont_f8af6d4a:

#   ju "God... I sound like a broken record and this point."
    ju "Meu Deus... eu pareço um disco riscado nesse ponto."

# game/ch2ep2.rpy:6798
translate brazil sktabdinwikcont_ce8b8e11:

#   ju "I'm saying this because there's a Sicae operative—or whatever they call themselves—who might be listening right there."
    ju "Digo isso porque há um agente da Sicae — ou seja lá como eles se autodenominam — que pode estar ouvindo ali mesmo."

# game/ch2ep2.rpy:6802
translate brazil sktabdinwikcont_d445644b:

#   ju "Same review as anyone else. No exceptions."
    ju "A mesma avaliação que a de qualquer outra pessoa. Sem exceções."

# game/ch2ep2.rpy:6804
translate brazil sktabdinwikcont_3435c7e5:

#   ju "... And don't do this to me again at this hour. Please..."
    ju "... E não faça isso comigo de novo a esta hora. Por favor..."

# game/ch2ep2.rpy:6805
translate brazil sktabdinwikcont_7256839b:

#   e "Sorry..."
    e "Desculpe..."

# game/ch2ep2.rpy:6807
translate brazil sktabdinwikcont_2d7fff30:

#   e "No. That's all."
    e "Não. É só isso."

# game/ch2ep2.rpy:6810
translate brazil sktabdinwikcont_46207020:

#   ju "*yawns* Good night, Emma..."
    ju "*boceja* Boa noite, Emma..."

# game/ch2ep2.rpy:6811
translate brazil sktabdinwikcont_8c5ff027:

#   e "Good... morning...?"
    e "Bom dia...?"

# game/ch2ep2.rpy:6821
translate brazil sktabdinwikcont_3710037d:

#   mc "Well?"
    mc "Bem?"

# game/ch2ep2.rpy:6822
translate brazil sktabdinwikcont_8676f7f5:

#   e "She didn't say no."
    e "Ela não disse não."

# game/ch2ep2.rpy:6825
translate brazil sktabdinwikcont_140afc1c:

#   e "I promised her I'd see her again."
    e "Eu prometi a ela que a veria novamente."

# game/ch2ep2.rpy:6826
translate brazil sktabdinwikcont_74e8d221:

#   e "I'm going to keep that."
    e "Vou guardar isso."

# game/ch2ep2.rpy:6980
translate brazil sktabdinwikcont_4f12636d:

#   shu "EEEEY! MERRY FUCKING CHRISTMAS!"
    shu "EEEEY! FELIZ NATAL, PORRA!"

# game/ch2ep2.rpy:6981
translate brazil sktabdinwikcont_9893c448:

#   shu "Did the party start without the main event, or were y'all just standing around waiting for me to grace this street with my presence?"
    shu "A festa começou sem a atração principal, ou vocês estavam aí parados esperando que eu aparecesse nesta rua com a minha presença?"

# game/ch2ep2.rpy:6982
translate brazil sktabdinwikcont_137472b8:

#   shu "The name's Shu, but today you can call me Santa—because I have arrived bearing the single greatest gift this miserable neighborhood has ever had the privilege of witnessing!"
    shu "Meu nome é Shu, mas hoje podem me chamar de Papai Noel, porque cheguei trazendo o maior presente que este bairro miserável já teve o privilégio de presenciar!"

# game/ch2ep2.rpy:6985
translate brazil sktabdinwikcont_ddde7651:

#   shu "Behold! Feast your peasant eyes upon perfection!"
    shu "Contemplem! Deleitem seus olhos plebeus com a perfeição!"

# game/ch2ep2.rpy:6986
translate brazil sktabdinwikcont_60673aea:

#   shu "Flew halfway across the planet for this beauty."
    shu "Viajei meio planeta para ver essa beleza."

# game/ch2ep2.rpy:6989
translate brazil sktabdinwikcont_407402ce:

#   shu "Half. Way. Across. The. Planet."
    shu "Metade do caminho através do planeta."

# game/ch2ep2.rpy:6990
translate brazil sktabdinwikcont_ae0b52a1:

#   shu "And before any of you ask—no, you cannot get this pretty thing in Quinara."
    shu "E antes que alguém pergunte: não, você não encontrará essa belezinha em Quinara."

# game/ch2ep2.rpy:6991
translate brazil sktabdinwikcont_17d29c7f:

#   shu "They told me, \"Sir, it's not available here.\""
    shu "Eles me disseram: \"Senhor, não está disponível aqui.\""

# game/ch2ep2.rpy:6992
translate brazil sktabdinwikcont_004f8efe:

#   shu "I said, \"Then clearly your country lacks vision.\""
    shu "Eu disse: \"Então, claramente, seu país carece de visão.\""

# game/ch2ep2.rpy:6993
translate brazil sktabdinwikcont_a4f23ebe:

#   shu "Three weeks to process, two layovers, one very confused customs officer, and here we are."
    shu "Três semanas para processar o pedido, duas escalas, um funcionário da alfândega muito confuso, e aqui estamos nós."

# game/ch2ep2.rpy:6994
translate brazil sktabdinwikcont_63ffa233:

#   shu "Style doesn't wait for availability, people. Write that down."
    shu "Estilo não espera pela disponibilidade, pessoal. Anotem isso."

# game/ch2ep2.rpy:6997
translate brazil sktabdinwikcont_5a0573b9:

#   mc "Who the hell are you talking to?"
    mc "Com quem diabos você pensa que está falando?"

# game/ch2ep2.rpy:7000
translate brazil sktabdinwikcont_2ff0f2dd:

#   mc "Where the hell have you been? I've been trying to reach you."
    mc "Onde diabos você esteve? Estou tentando entrar em contato com você."

# game/ch2ep2.rpy:7001
translate brazil sktabdinwikcont_ba2a84a1:

#   shu "Ah. Busy."
    shu "Ah. Ocupado."

# game/ch2ep2.rpy:7002
translate brazil sktabdinwikcont_9bde95b6:

#   mc "For two weeks?"
    mc "Por duas semanas?"

# game/ch2ep2.rpy:7003
translate brazil sktabdinwikcont_8ed60bd1:

#   shu "Greatness takes time, [mc]."
    shu "A grandeza leva tempo. [mc]."

# game/ch2ep2.rpy:7006
translate brazil sktabdinwikcont_07885e09:

#   shu "Also the signal in Solvern was terrible."
    shu "Além disso, o sinal em Solvern estava péssimo."

# game/ch2ep2.rpy:7007
translate brazil sktabdinwikcont_f8a2c513:

#   shu "And Mashiro."
    shu "E Mashiro."

# game/ch2ep2.rpy:7008
translate brazil sktabdinwikcont_34fa951b:

#   shu "And wherever else I ended up."
    shu "E onde quer que eu tenha ido parar."

# game/ch2ep2.rpy:7009
translate brazil sktabdinwikcont_d2d2dbfe:

#   mc "You went to Solvern AND Mashiro."
    mc "Você foi a Solvern E Mashiro."

# game/ch2ep2.rpy:7010
translate brazil sktabdinwikcont_e97e9ff2:

#   shu "The car had to clear two separate ports. Not my fault the world isn't more efficient."
    shu "O carro teve que passar por dois portos diferentes. Não é minha culpa que o mundo não seja mais eficiente."

# game/ch2ep2.rpy:7013
translate brazil sktabdinwikcont_a91115f2:

#   shu "Anyway..."
    shu "De qualquer forma..."

# game/ch2ep2.rpy:7014
translate brazil sktabdinwikcont_a44e6817:

#   shu "Is that Klara's cooking? Because if it is, my timing is immaculate."
    shu "Essa comida é da Klara? Porque se for, meu timing é impecável."

# game/ch2ep2.rpy:7015
translate brazil sktabdinwikcont_047fbac9:

#   shu "Just like me. But you already knew that."
    shu "Assim como eu. Mas você já sabia disso."

# game/ch2ep2.rpy:7019
translate brazil sktabdinwikcont_a67627c0:

#   mc "Merry Christmas, Shu."
    mc "Feliz Natal, Shu."

# game/ch2ep2.rpy:7022
translate brazil sktabdinwikcont_bd931598:

#   shu "There's my guy!"
    shu "Esse é o meu cara!"

# game/ch2ep2.rpy:7023
translate brazil sktabdinwikcont_dee8e289:

#   shu "Happy birthday, buddy. Don't make it weird."
    shu "Feliz aniversário, amigo. Não deixe a situação ficar estranha."

# game/ch2ep2.rpy:7032
translate brazil sktabdinwikcont_0632202c:

#   shu "Oh, man... Smells like Christmas in here!"
    shu "Nossa... Cheira a Natal aqui!"

# game/ch2ep2.rpy:7035
translate brazil sktabdinwikcont_407b9cb8:

#   f "Look what the cat dragged in."
    f "Olha só o que o gato trouxe."

# game/ch2ep2.rpy:7036
translate brazil sktabdinwikcont_99188e00:

#   shu "Ouch."
    shu "Ai!"

# game/ch2ep2.rpy:7037
translate brazil sktabdinwikcont_ec4f384b:

#   s "Hey, welcome back!"
    s "Olá, seja bem-vindo de volta!"

# game/ch2ep2.rpy:7038
translate brazil sktabdinwikcont_d77a6946:

#   shu "Sky! Looking radiant as always."
    shu "Céu! Radiante como sempre."

# game/ch2ep2.rpy:7044
translate brazil sktabdinwikcont_b16872b2:

#   shu "*whispers* Hey."
    shu "*sussurra* Ei."

# game/ch2ep2.rpy:7045
translate brazil sktabdinwikcont_d927fb09:

#   mc "*whispers* Hm?"
    mc "*sussurra* Hm?"

# game/ch2ep2.rpy:7046
translate brazil sktabdinwikcont_7583c674:

#   shu "*whispers* What's going on with her?"
    shu "*sussurra* O que está acontecendo com ela?"

# game/ch2ep2.rpy:7049
translate brazil sktabdinwikcont_7292f270:

#   mc "*whispers* It's... a long story. There was a kid."
    mc "*sussurra* É... uma longa história. Havia uma criança."

# game/ch2ep2.rpy:7050
translate brazil sktabdinwikcont_a34576fb:

#   shu "*whispers* A what?"
    shu "*sussurra* O quê?"

# game/ch2ep2.rpy:7053
translate brazil sktabdinwikcont_407b1fae:

#   g "Nobody breathe too hard. I almost dropped this twice already."
    g "Ninguém respire muito fundo. Eu quase deixei cair duas vezes."

# game/ch2ep2.rpy:7054
translate brazil sktabdinwikcont_9b37b490:

#   g "Come on, gather up. Let's get this done before the wax goes everywhere."
    g "Vamos lá, juntem-se. Vamos terminar isso antes que a cera se espalhe por todo lado."

# game/ch2ep2.rpy:7057
translate brazil sktabdinwikcont_c5487673:

#   mc "Oh boy... I'm not used to this."
    mc "Nossa... Não estou acostumado com isso."

# game/ch2ep2.rpy:7058
translate brazil sktabdinwikcont_7bfe1d2e:

#   g "What do you mean? We did the same thing last year."
    g "Como assim? Nós fizemos a mesma coisa no ano passado."

# game/ch2ep2.rpy:7062
translate brazil sktabdinwikcont_8fc08781:

#   g "Okay. On three."
    g "Certo. No três."

# game/ch2ep2.rpy:7063
translate brazil sktabdinwikcont_7babe20c:

#   g "One."
    g "Um."

# game/ch2ep2.rpy:7064
translate brazil sktabdinwikcont_8c680a69:

#   g "Two..."
    g "Dois..."

# game/ch2ep2.rpy:7067
translate brazil sktabdinwikcont_ba68e85e:

#   ev "Happy birthday to you~"
    ev "Feliz aniversário para você!"

# game/ch2ep2.rpy:7073
translate brazil sktabdinwikcont_d9651dec:

#   ev "Happy birthday dear [mc]~"
    ev "Feliz aniversário, querido(a) [mc] ~"

# game/ch2ep2.rpy:7076
translate brazil sktabdinwikcont_ee2d6195:

#   ev "Happy birthday to youuuu~!"
    ev "Feliz aniversário para você!"

# game/ch2ep2.rpy:7077
translate brazil sktabdinwikcont_db3e56a2:

#   f "AND MANY MOOORE~!"
    f "E MUITO MAIS~!"

# game/ch2ep2.rpy:7078
translate brazil sktabdinwikcont_7c187207:

#   mc "... And many more."
    mc "... E muito mais."

# game/ch2ep2.rpy:7084
translate brazil sktabdinwikcont_1c9bdcae:

#   mc "*takes a breath*"
    mc "*respira fundo*"

# game/ch2ep2.rpy:7090
translate brazil sktabdinwikcont_007f4b46:

#   s "Who's that?"
    s "Quem é aquele?"

# game/ch2ep2.rpy:7091
translate brazil sktabdinwikcont_28c4e385:

#   k "Anyone expecting someone?"
    k "Alguém está esperando alguém?"

# game/ch2ep2.rpy:7096
translate brazil sktabdinwikcont_8dc7f5bc:

#   a "Em..."
    a "Em..."

# game/ch2ep2.rpy:7099
translate brazil sktabdinwikcont_5600b251:

#   a "Em!"
    a "Em!"

# game/ch2ep2.rpy:7132
translate brazil sktabdinwikcont_26d9be52:

#   le "Aunt June said my name is Leah Meyer now."
    le "Tia June disse que meu nome agora é Leah Meyer."

# game/ch2ep2.rpy:7138
translate brazil sktabdinwikcont_9100b91d:

#   ju "*slowly nods*"
    ju "*acena lentamente com a cabeça*"

# game/ch2ep2.rpy:7149
translate brazil sktabdinwikcont_82eb1659:

#   e "*softly* Leah..."
    e "*suavemente* Leah..."

# game/ch2ep2.rpy:7152
translate brazil sktabdinwikcont_1e5ab892:

#   le "*wails*"
    le "*chora*"

# game/ch2ep2.rpy:7153
translate brazil sktabdinwikcont_d0d4e8e9:

#   e "It's okay... it's okay... I'm here now."
    e "Está tudo bem... está tudo bem... eu estou aqui agora."

# game/ch2ep2.rpy:7172
translate brazil sktabdinwikcont_6bd55f14:

#   ju "Your application went through the standard review, and your termination record flagged at every stage like I told you it would."
    ju "Sua solicitação passou pela análise padrão e seu histórico de rescisão foi sinalizado em todas as etapas, como eu havia previsto."

# game/ch2ep2.rpy:7173
translate brazil sktabdinwikcont_e9f615d7:

#   ju "But then the testimonies came in and... that changed things."
    ju "Mas aí começaram a chegar os depoimentos e... isso mudou tudo."

# game/ch2ep2.rpy:7174
translate brazil sktabdinwikcont_b6e1adf9:

#   ju "Especially Park's."
    ju "Especialmente o do Parque."

# game/ch2ep2.rpy:7177
translate brazil sktabdinwikcont_90d2d937:

#   e "Dr. Park?"
    e "Dr. Park?"

# game/ch2ep2.rpy:7178
translate brazil sktabdinwikcont_b852a460:

#   ju "*nods* Mm."
    ju "*acena com a cabeça* Hum."

# game/ch2ep2.rpy:7179
translate brazil sktabdinwikcont_06eae6f0:

#   ju "Said she'd never seen a child respond to someone the way Leah responded to you."
    ju "Ela disse que nunca tinha visto uma criança reagir a alguém da maneira como Leah reagiu a você."

# game/ch2ep2.rpy:7180
translate brazil sktabdinwikcont_48ed0d4c:

#   ju "She believed it wasn't attachment damage, but... purely an attachment."
    ju "Ela acreditava que não se tratava de um dano relacionado ao apego, mas... puramente um problema de apego."

# game/ch2ep2.rpy:7181
translate brazil sktabdinwikcont_92ae058a:

#   ju "Elaine submitted one too. Unsolicited."
    ju "Elaine também enviou uma. Sem que ninguém tivesse pedido."

# game/ch2ep2.rpy:7182
translate brazil sktabdinwikcont_90ab3530:

#   ju "She said, and I'm quoting directly, \"If you don't give that kid to Meyer I will personally make sure you have hell to pay.\""
    ju "Ela disse, e estou citando diretamente: \"Se você não entregar essa criança para Meyer, eu mesma vou garantir que você pague caro por isso.\""

# game/ch2ep2.rpy:7183
translate brazil sktabdinwikcont_9bbaa2dd:

#   e "*laughs softly*"
    e "*ri baixinho*"

# game/ch2ep2.rpy:7184
translate brazil sktabdinwikcont_ce6d862b:

#   ju "She also included three pages of supporting documentation, so... very thorough of her."
    ju "Ela também incluiu três páginas de documentação comprobatória, então... muito minuciosa da parte dela."

# game/ch2ep2.rpy:7185
translate brazil sktabdinwikcont_cb8c3895:

#   ju "[mc] submitted his the same day you filed."
    ju "[mc] Apresentou a dele no mesmo dia em que você deu entrada no processo."

# game/ch2ep2.rpy:7188
translate brazil sktabdinwikcont_5988d028:

#   ju "You broke protocol as an officer."
    ju "Você quebrou o protocolo como oficial."

# game/ch2ep2.rpy:7189
translate brazil sktabdinwikcont_7b6c544a:

#   ju "As a civilian?"
    ju "Como civil?"

# game/ch2ep2.rpy:7190
translate brazil sktabdinwikcont_2ee9b298:

#   ju "You did everything right."
    ju "Você fez tudo certo."

# game/ch2ep2.rpy:7194
translate brazil sktabdinwikcont_15378463:

#   ju "There's still a hearing. But that's just red tape at this point."
    ju "Ainda haverá uma audiência. Mas, neste momento, isso é apenas burocracia."

# game/ch2ep2.rpy:7195
translate brazil sktabdinwikcont_2eefa6f8:

#   ju "Merry Christmas, Emma."
    ju "Feliz Natal, Emma."

# game/ch2ep2.rpy:7196
translate brazil sktabdinwikcont_3a25079b:

#   e "... Merry Christmas, June..."
    e "... Feliz Natal, June..."

# game/ch2ep2.rpy:7200
translate brazil sktabdinwikcont_19766e3a:

#   ju "Alright. Let's go inside before I actually start crying out here."
