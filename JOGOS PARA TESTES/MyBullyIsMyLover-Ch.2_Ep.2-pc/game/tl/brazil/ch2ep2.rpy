translate brazil sktabdinwikcont_44892105:

#   le "You smell like coffee again. You should try smelling like something else for a change."
    le "Você está cheirando a café de novo. Deveria experimentar cheirar a outra coisa, para variar."

# game/ch2ep2.rpy:3323
translate brazil sktabdinwikcont_1fb7213d:

#   e "Like...?"
    e "Como...?"

# game/ch2ep2.rpy:3324
translate brazil sktabdinwikcont_12c44903:

#   le "I don't know. Flowers? Or like... a bakery. So when you walk in, it smells like something good is about to happen."
