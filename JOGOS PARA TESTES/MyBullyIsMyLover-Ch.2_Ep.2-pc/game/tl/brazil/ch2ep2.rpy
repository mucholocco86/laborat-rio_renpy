translate brazil sktabdinwikcont_19fd5322:

#   nad "I know."
    nad "Eu sei."

# game/ch2ep2.rpy:3228
translate brazil sktabdinwikcont_fb66cb6e:

#   ela "Anything else about the man who approached you?"
    ela "Há mais alguma coisa a dizer sobre o homem que se aproximou de você?"

# game/ch2ep2.rpy:3229
translate brazil sktabdinwikcont_eaca42ed:

#   nad "He was quiet. Soft-spoken. He didn't look like what he was."
    nad "Ele era quieto. Falava baixo. Não aparentava ser quem era."

# game/ch2ep2.rpy:3230
translate brazil sktabdinwikcont_d85ea084:

#   ela "They almost never do."
    ela "Eles quase nunca fazem isso."

# game/ch2ep2.rpy:3233
translate brazil sktabdinwikcont_fd4778e5:

#   nad "Is she okay?"
    nad "Ela está bem?"

# game/ch2ep2.rpy:3242
translate brazil sktabdinwikcont_f4424bb8:

#   ela "She's safe."
    ela "Ela está segura."

# game/ch2ep2.rpy:3245
translate brazil sktabdinwikcont_7f360981:

#   nad "That's not what I asked, Officer."
    nad "Não foi isso que eu perguntei, policial."

