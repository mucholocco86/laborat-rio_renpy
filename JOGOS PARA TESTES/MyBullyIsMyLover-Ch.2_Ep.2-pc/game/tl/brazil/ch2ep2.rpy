translate brazil sktabdinwikcont_d9130cf2:

#   ela "What changed?"
    ela "O que mudou?"

# game/ch2ep2.rpy:3196
translate brazil sktabdinwikcont_d3921f8f:

#   nad "Everything."
    nad "Tudo."

