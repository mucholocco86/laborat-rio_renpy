translate brazil sktabdinwikcont_6cf9b7d3:

#   le "... Okay."
    le "... OK."

# game/ch2ep2.rpy:2987
translate brazil sktabdinwikcont_a1d35655:

#   e "How did you do that?"
    e "Como você fez isso?"

# game/ch2ep2.rpy:2988
translate brazil sktabdinwikcont_6083f58d:

