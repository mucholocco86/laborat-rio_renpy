# ARQUIVO: game/emmasoloending.rpy DIALOGOS: 2432


# game/emmasoloending.rpy:2
translate brazil emmasoloending_53254867:

#   yt "No, I shouldn't even think like that. I made a promise, and I must keep it."
    yt "Não, eu nem deveria pensar assim. Fiz uma promessa e preciso cumpri-la."

# game/emmasoloending.rpy:3
translate brazil emmasoloending_bc62081d:

#   yt "We have both been waiting for this. And if I have to sacrifice everything to achieve it, so be it. But, there's still something she doesn't know..."
    yt "Nós dois estávamos esperando por isso. E se eu tiver que sacrificar tudo para conseguir, que assim seja. Mas ainda há algo que ela não sabe..."

# game/emmasoloending.rpy:6
translate brazil emmasoloending_c4655ec4:

#   mc "Look, Em..."
    mc "Olha, Em..."

# game/emmasoloending.rpy:7
translate brazil emmasoloending_491cb946:

#   mc "There's something that I need to tell you."
    mc "Tem algo que eu preciso te contar."

# game/emmasoloending.rpy:8
translate brazil emmasoloending_565287dc:

#   mc "It's about Jovian..."
    mc "É sobre Joviano..."

# game/emmasoloending.rpy:17
translate brazil emmasoloending_2d80cbec:

#   mc "He's... the one who started this mess."
    mc "Foi ele... quem começou toda essa confusão."

# game/emmasoloending.rpy:18
translate brazil emmasoloending_ec8ece70:

#   mc "Everything that happened in the past was because of him."
    mc "Tudo o que aconteceu no passado foi por causa dele."

# game/emmasoloending.rpy:19
translate brazil emmasoloending_9d6bcede:

#   mc "Me, Klara, Aine, Hera, and you became victims of his actions."
    mc "Eu, Klara, Aine, Hera e você nos tornamos vítimas de suas ações."

# game/emmasoloending.rpy:20
translate brazil emmasoloending_1617c1a8:

#   e "Huh? W-what did he do?"
    e "Hã? O que ele fez?"

# game/emmasoloending.rpy:21
translate brazil emmasoloending_c939c180:

#   mc "He killed Aine's father and..."
    mc "Ele matou o pai de Aine e..."

# game/emmasoloending.rpy:22
translate brazil emmasoloending_4ba80ad1:

#   mc "*squirms*"
    mc "*se contorce*"

# game/emmasoloending.rpy:23
translate brazil emmasoloending_ad14f8d4:

#   mc "... Her little brother..."
    mc "... Seu irmãozinho..."

# game/emmasoloending.rpy:26
translate brazil emmasoloending_ee8e4389:

#   e "{b}*gasps*{/b}"
    e "{b}*suspiros*{/b}"

# game/emmasoloending.rpy:27
translate brazil emmasoloending_2ddb8854:

#   e "So, that's why Hera..."
    e "Então, é por isso que Hera..."

# game/emmasoloending.rpy:28
translate brazil emmasoloending_0d9cd5f2:

#   mc "Yes, she changed because of that."
    mc "Sim, ela mudou por causa disso."

# game/emmasoloending.rpy:29
translate brazil emmasoloending_bba20d64:

#   e "I... never knew."
    e "Eu... nunca soube."

# game/emmasoloending.rpy:32
translate brazil emmasoloending_1af12ec2:

#   mc "Well, the old woman decided to keep it to herself."
    mc "Bem, a velha decidiu guardar isso para si mesma."

# game/emmasoloending.rpy:33
translate brazil emmasoloending_57c4ba7b:

#   mc "That's also the reason why she tormented me."
    mc "Essa também é a razão pela qual ela me atormentava."

# game/emmasoloending.rpy:34
translate brazil emmasoloending_71e2337a:

#   mc "Part of it was for revenge, and the rest was in hopes of bringing Jovian out of hiding."
    mc "Parte disso foi por vingança, e o restante na esperança de fazer Jovian sair do esconderijo."

# game/emmasoloending.rpy:35
translate brazil emmasoloending_72a33094:

#   e "..."
    e "..."

# game/emmasoloending.rpy:36
translate brazil emmasoloending_e317f2da:

#   mc "That's why I want to find him and make him finish what he started."
    mc "Por isso quero encontrá-lo e fazê-lo terminar o que começou."

# game/emmasoloending.rpy:39
translate brazil emmasoloending_e96f6a5a:

#   e "It's going to be a challenge, [mc]. You don't have any clues about his whereabouts, right?"
    e "Vai ser um desafio. [mc] Você não tem nenhuma pista sobre o paradeiro dele, certo?"

# game/emmasoloending.rpy:40
translate brazil emmasoloending_408167d3:

#   mc "I don't..."
    mc "Eu não..."

# game/emmasoloending.rpy:41
translate brazil emmasoloending_59724911:

#   mc "And... I don't think I need to do that anymore..."
    mc "E... acho que não preciso mais fazer isso..."

# game/emmasoloending.rpy:42
translate brazil emmasoloending_2b40a022:

#   e "Huh?"
    e "Huh?"

# game/emmasoloending.rpy:43
translate brazil emmasoloending_18c03d8f:

#   mc "I made a promise and want to keep it, now that I have an opportunity. I don't care what the circumstances are."
    mc "Fiz uma promessa e quero cumpri-la, agora que tenho a oportunidade. Não me importo com as circunstâncias."

# game/emmasoloending.rpy:44
translate brazil emmasoloending_de02ca88:

#   mc "This is such a heavy choice I'm about to make, and I know I'm going to hurt a lot of people in the process..."
    mc "Esta é uma decisão muito difícil que estou prestes a tomar, e sei que vou magoar muita gente no processo..."

# game/emmasoloending.rpy:45
translate brazil emmasoloending_1ea4ecde:

#   mc "But, let's run away, Em. Run away from all of this."
    mc "Mas vamos fugir, Em. Fugir de tudo isso."

# game/emmasoloending.rpy:46
translate brazil emmasoloending_3b0f7a22:

#   mc "Let's establish our own life. The life that we both wanted since we were kids."
    mc "Vamos construir nossa própria vida. A vida que ambos desejávamos desde crianças."

# game/emmasoloending.rpy:49
translate brazil emmasoloending_6a9c910b:

#   e "R-run away? But... how about..."
    e "Fugir? Mas... e se..."

# game/emmasoloending.rpy:50
translate brazil emmasoloending_34a20107:

#   mc "Yeah, I know..."
    mc "Sim, eu sei..."

# game/emmasoloending.rpy:51
translate brazil emmasoloending_23f5005f:

#   mc "I have a lot to do after hearing what Hera said. But, now that you're here, I don't care anymore."
    mc "Tenho muito o que fazer depois de ouvir o que Hera disse. Mas, agora que você está aqui, não me importo mais."

# game/emmasoloending.rpy:52
translate brazil emmasoloending_ad655e3e:

#   mc "All I want to think about is you and our future together."
    mc "Tudo em que quero pensar é em você e no nosso futuro juntos."

# game/emmasoloending.rpy:58
translate brazil emmasoloending_d0d033b9:

#   e "I'm so happy to hear that, [mc]."
    e "Fico muito feliz em ouvir isso! [mc]."

# game/emmasoloending.rpy:59
translate brazil emmasoloending_cce6af05:

#   e "I want to be with you – I said that many times. Too many to even count. But, there is a lot that we must sacrifice if we are to leave everything behind..."
    e "Quero estar com você – já disse isso muitas vezes. Tantas que nem consigo contar. Mas, há muito que precisamos sacrificar se quisermos deixar tudo para trás..."

# game/emmasoloending.rpy:62
translate brazil emmasoloending_54f34176:

#   e "I can't just leave Aine and Gwen to fend for themselves. I am the reason why they are here in the first place."
    e "Não posso simplesmente deixar Aine e Gwen à própria sorte. Eu sou o motivo de elas estarem aqui, em primeiro lugar."

# game/emmasoloending.rpy:63
translate brazil emmasoloending_d2b7a74f:

#   e "How will the others adjust if we're not around?"
    e "Como os outros irão se adaptar se não estivermos por perto?"

# game/emmasoloending.rpy:64
translate brazil emmasoloending_e6a638f2:

#   e "I'm not sure if it's worth it..."
    e "Não sei se vale a pena..."

# game/emmasoloending.rpy:65
translate brazil emmasoloending_ffe79941:

#   mc "Why don't you go and talk to Aine? We can't be sure until we try. Right now, all I want is your resolve and trust. Leave everything else to me."
    mc "Por que você não vai falar com a Aine? Não podemos ter certeza até tentarmos. Agora, tudo o que eu quero é a sua determinação e confiança. Deixe o resto comigo."

# game/emmasoloending.rpy:66
translate brazil emmasoloending_665c1394:

#   mc "That said, I'm sure it will be worth it. We'll just have to persevere one more time."
    mc "Dito isso, tenho certeza de que valerá a pena. Só precisamos perseverar mais uma vez."

# game/emmasoloending.rpy:69
translate brazil emmasoloending_52674ebf:

#   e "... One more time."
    e "... Mais uma vez."

# game/emmasoloending.rpy:73
translate brazil emmasoloending_2302acd8:

#   e "I'll talk to her. She's still my best friend – I can't leave her without any heads up."
    e "Vou falar com ela. Ela ainda é minha melhor amiga – não posso deixá-la sem avisar."

# game/emmasoloending.rpy:74
translate brazil emmasoloending_8c1c823a:

#   mc "Yeah, you do that, and I'll handle the rest."
    mc "Sim, faça isso, e eu cuido do resto."

# game/emmasoloending.rpy:75
translate brazil emmasoloending_91ad3b94:

#   mc "After that, I want you to pack your stuff. I will send you an address. Wait for me there."
    mc "Depois disso, quero que você arrume suas coisas. Vou te enviar um endereço. Me espere lá."

# game/emmasoloending.rpy:76
translate brazil emmasoloending_9d2f2d12:

#   e "Alright."
    e "Tudo bem."

# game/emmasoloending.rpy:91
translate brazil emmasoloending_669664cb:

#   mc "Hey."
    mc "Ei."

# game/emmasoloending.rpy:94
translate brazil emmasoloending_7c4523c9:

#   g "So, why call me out here? I've been waiting for you in my room. I was expecting you to come."
    g "Então, por que me chamar aqui? Eu estava te esperando no meu quarto. Eu esperava que você viesse."

# game/emmasoloending.rpy:95
translate brazil emmasoloending_2b35b6fe:

#   mc "..."
    mc "..."

# game/emmasoloending.rpy:96
translate brazil emmasoloending_31c1bda8:

#   g "What's with that face?"
    g "Que cara é essa?"

# game/emmasoloending.rpy:99
translate brazil emmasoloending_e44a3760:

#   mc "I need to talk to you before I go..."
    mc "Preciso falar com você antes de ir..."

# game/emmasoloending.rpy:100
translate brazil emmasoloending_3f26d5f8:

#   g "Before... you go?"
    g "Antes de... você ir?"

# game/emmasoloending.rpy:101
translate brazil emmasoloending_ec8dcdeb:

#   g "[mc], what's going on..."
    g "[mc] O que está acontecendo...?"

# game/emmasoloending.rpy:104
translate brazil emmasoloending_5547ec87:

#   mc "You know I've never, ever lied to you before. So, I'll be honest and get straight to the point."
    mc "Você sabe que eu nunca, jamais menti para você antes. Então, serei honesto e irei direto ao ponto."

# game/emmasoloending.rpy:110
translate brazil emmasoloending_507a9bdf:

#   mc "Gwen... Emma and I are leaving. For good..."
    mc "Gwen... Emma e eu estamos indo embora. Para sempre..."

# game/emmasoloending.rpy:111
translate brazil emmasoloending_4986f2c1:

#   mc "Even now, I know I'm a jerk to leave just like that. But I'm not an asshole, so I will also talk to your father about this."
    mc "Mesmo agora, sei que fui um idiota por ir embora assim, sem mais nem menos. Mas não sou um babaca, então também vou conversar com seu pai sobre isso."

# game/emmasoloending.rpy:112
translate brazil emmasoloending_42d4d982:

#   mc "... I'm really sorry."
    mc "... Sinto muito mesmo."

# game/emmasoloending.rpy:115
translate brazil emmasoloending_ceeb6b2e:

#   g "Yeah... So, this is it, huh?"
    g "É... Então é isso, né?"

# game/emmasoloending.rpy:116
translate brazil emmasoloending_96dba21d:

#   g "Honestly, I already saw this coming after what Emma told me, but..."
    g "Sinceramente, eu já esperava por isso depois do que a Emma me contou, mas..."

# game/emmasoloending.rpy:117
translate brazil emmasoloending_6674439b:

#   g "Shit... I never thought it would hurt this much..."
    g "Droga... Nunca pensei que fosse doer tanto..."

# game/emmasoloending.rpy:118
translate brazil emmasoloending_e9cb2c16:

#   mc "Are you... crying?"
    mc "Você está... chorando?"

# game/emmasoloending.rpy:119
translate brazil emmasoloending_4b340443:

#   g "..."
    g "..."

# game/emmasoloending.rpy:120
translate brazil emmasoloending_ff4eceec:

#   g "It's not me who's crying. It's my eyes..."
    g "Não sou eu que estou chorando. São meus olhos..."

# game/emmasoloending.rpy:123
translate brazil emmasoloending_a15152f5:

#   mc "Gwen, listen-"
    mc "Gwen, escuta..."

# game/emmasoloending.rpy:124
translate brazil emmasoloending_3aba5658:

#   g "-No need to explain, [mc]. I already know..."
    g "-Não precisa explicar, [mc] Eu já sei..."

# game/emmasoloending.rpy:125
translate brazil emmasoloending_3a4de7dd:

#   g "I knew all of the short time we were together. You proved that you loved me..."
    g "Eu sabia, durante todo o pouco tempo que passamos juntos, que você me amava..."

# game/emmasoloending.rpy:128
translate brazil emmasoloending_7968adcb:

#   g "It's just that... why do you have to be so unfair?"
    g "É que... por que você precisa ser tão injusto?"

# game/emmasoloending.rpy:129
translate brazil emmasoloending_6b6c0280:

#   g "Why do you have to leave me at a time like this?"
    g "Por que você tem que me deixar numa hora dessas?"

# game/emmasoloending.rpy:130
translate brazil emmasoloending_6a176908:

#   g "Why do you have to leave me when I already made so many plans for the both of us?"
    g "Por que você tem que me deixar se eu já fiz tantos planos para nós dois?"

# game/emmasoloending.rpy:131
translate brazil emmasoloending_652c4b56:

#   g "I haven't even introduced you to my mother yet."
    g "Eu ainda nem te apresentei à minha mãe."

# game/emmasoloending.rpy:132
translate brazil emmasoloending_bfe15e81:

#   g "I'm not all that vocal when it comes to my feelings, but... I've... already thought out so, so much..."
    g "Não costumo expressar muito meus sentimentos, mas... eu... já pensei em tanta coisa..."

# game/emmasoloending.rpy:133
translate brazil emmasoloending_c862b4c7:

#   yt "That's right, she's not the most emotionally expressive person."
    yt "É verdade, ela não é a pessoa mais expressiva emocionalmente."

# game/emmasoloending.rpy:134
translate brazil emmasoloending_51248436:

#   yt "She would usually shrug it off and joke around. That's the trait that makes her so strong."
    yt "Ela geralmente dava de ombros e fazia piada. Essa é a característica que a torna tão forte."

# game/emmasoloending.rpy:135
translate brazil emmasoloending_ee73bbd5:

#   yt "So, for her to be reduced to tears like this... I can't imagine the pain she's feeling."
    yt "Então, vê-la reduzida às lágrimas desse jeito... Não consigo imaginar a dor que ela está sentindo."

# game/emmasoloending.rpy:136
translate brazil emmasoloending_35e94589:

#   yt "But I've already made my choice, and there is no turning back now."
    yt "Mas eu já fiz a minha escolha e não há como voltar atrás agora."

# game/emmasoloending.rpy:137
translate brazil emmasoloending_4cbd04b1:

#   mc "Life has never been fair to any of us, Gwen. But whether we accept the unjust is up to us to decide. Otherwise, we can never push through."
    mc "A vida nunca foi justa com nenhum de nós, Gwen. Mas aceitar ou não a injustiça é uma decisão nossa. Caso contrário, jamais conseguiremos seguir em frente."

# game/emmasoloending.rpy:138
translate brazil emmasoloending_ae01e29f:

#   mc "This might be too hypocritical of me to say at this point, but I've never seen you once in this state. It hurts me to see you like this."
    mc "Talvez seja muita hipocrisia da minha parte dizer isso agora, mas eu nunca te vi nesse estado. Dói-me ver você assim."

# game/emmasoloending.rpy:139
translate brazil emmasoloending_f8b05a34:

#   mc "But I've confidently, perhaps recklessly, chosen this pain. To make things right..."
    mc "Mas escolhi essa dor com convicção, talvez até de forma imprudente. Para consertar as coisas..."

# game/emmasoloending.rpy:143
translate brazil emmasoloending_ccadb820:

#   g "Before you go, let me ask you one thing."
    g "Antes de você ir, deixe-me lhe pedir uma coisa."

# game/emmasoloending.rpy:144
translate brazil emmasoloending_af353eb6:

#   mc "Go ahead."
    mc "Vá em frente."

# game/emmasoloending.rpy:145
translate brazil emmasoloending_766c6115:

#   g "If we were to meet in a world where Emma and Aine didn't exist, would you still love me then?"
    g "Se nos encontrássemos num mundo onde Emma e Aine não existissem, você ainda me amaria?"

# game/emmasoloending.rpy:146
translate brazil emmasoloending_0919d368:

#   mc "Yes, without a doubt."
    mc "Sim, sem dúvida."

# game/emmasoloending.rpy:147
translate brazil emmasoloending_823a81e8:

#   mc "You never judged me for who I was. You always picked me up whenever I was down."
    mc "Você nunca me julgou por quem eu era. Você sempre me animou quando eu estava triste."

# game/emmasoloending.rpy:148
translate brazil emmasoloending_70b1f562:

#   mc "And I would still drink that wine you offered me, even knowing how bad it tastes."
    mc "E eu ainda beberia aquele vinho que você me ofereceu, mesmo sabendo o quão ruim ele é."

# game/emmasoloending.rpy:149
translate brazil emmasoloending_986df748:

#   g "*chuckles* Damn you."
    g "*risos* Maldito seja você."

# game/emmasoloending.rpy:152
translate brazil emmasoloending_714946a1:

#   g "*hugs tightly*"
    g "*abraça forte*"

# game/emmasoloending.rpy:153
translate brazil emmasoloending_d5562051:

#   g "Go, but never say goodbye..."
    g "Vá, mas nunca diga adeus..."

# game/emmasoloending.rpy:154
translate brazil emmasoloending_921a26ed:

#   g "Emma is still my friend, and I know we will one day meet again."
    g "Emma continua sendo minha amiga, e sei que um dia nos encontraremos novamente."

# game/emmasoloending.rpy:155
translate brazil emmasoloending_37971af5:

#   g "Don't forget about me, [mc]..."
    g "Não se esqueça de mim, [mc]..."

# game/emmasoloending.rpy:158
translate brazil emmasoloending_674270ca:

#   mc "Argh!"
    mc "Argh!"

# game/emmasoloending.rpy:161
translate brazil emmasoloending_9f9abbc5:

#   mc "I won't, I promise!"
    mc "Não vou, prometo!"

# game/emmasoloending.rpy:162
translate brazil emmasoloending_432ad1d7:

#   g "Now, turn around slowly, and don't show me your face. It will... just hurt more."
    g "Agora, vire-se devagar e não me mostre seu rosto. Vai... doer ainda mais."

# game/emmasoloending.rpy:177
translate brazil emmasoloending_9dc4f142:

#   g "See you next time, [mc]..."
    g "Até a próxima! [mc]..."

# game/emmasoloending.rpy:178
translate brazil emmasoloending_1ebce7b9:

#   mc "*hics*"
    mc "*soluços*"

# game/emmasoloending.rpy:179
translate brazil emmasoloending_f1eab10a:

#   mc "Yeah... until next time..."
    mc "Sim... até a próxima..."

# game/emmasoloending.rpy:196
translate brazil emmasoloending_0f1e7100:

#   g "One stick won't hurt..."
    g "Um graveto não vai fazer mal..."

# game/emmasoloending.rpy:197
translate brazil emmasoloending_cd4f0f40:

#   g "Right, [mc]?"
    g "Certo, [mc]?"

# game/emmasoloending.rpy:203
translate brazil emmasoloending_1f975aea:

#   g "*whimpers*"
    g "*choraminga*"

# game/emmasoloending.rpy:206
translate brazil emmasoloending_0e3bc851:

#   g "{i}Goodbye... [mc].{/i}"
    g "{i}Adeus... [mc].{/i}"

# game/emmasoloending.rpy:238
translate brazil emmasoloending_9b70c2bf:

#   un "Did you walk all the way here with that face? Must've been tough, huh?"
    un "Você caminhou até aqui com essa cara? Deve ter sido difícil, né?"

# game/emmasoloending.rpy:241
translate brazil emmasoloending_f2316b97:

#   mc "Ah."
    mc "Ah."

# game/emmasoloending.rpy:242
translate brazil emmasoloending_831ee5ce:

#   yt "Shit, I didn't expect him to be here."
    yt "Puxa, eu não esperava que ele estivesse aqui."

# game/emmasoloending.rpy:243
translate brazil emmasoloending_ad884418:

#   yt "But, this is my chance. I'll settle this here and now."
    yt "Mas esta é a minha chance. Vou resolver isso aqui e agora."

# game/emmasoloending.rpy:246
translate brazil emmasoloending_250d9399:

#   mc "Glenn, we need to talk."
    mc "Glenn, precisamos conversar."

# game/emmasoloending.rpy:247
translate brazil emmasoloending_29f9d566:

#   gl "Yes, we do indeed."
    gl "Sim, com certeza."

# game/emmasoloending.rpy:251
translate brazil emmasoloending_a3c8ba72:

#   gl "One day over a glass of whisky, when you're telling me your story."
    gl "Um dia, enquanto tomávamos um copo de uísque e você me contava a sua história."

# game/emmasoloending.rpy:252
translate brazil emmasoloending_334b3094:

#   mc "H-huh?"
    mc "Hã?"

# game/emmasoloending.rpy:255
translate brazil emmasoloending_e5611a63:

#   gl "Save those words for later. What I heard from the young lass was more than enough."
    gl "Guarde essas palavras para depois. O que ouvi da jovem foi mais do que suficiente."

# game/emmasoloending.rpy:256
translate brazil emmasoloending_26d83765:

#   gl "That lingering pain from your expression already told me what I needed to know."
    gl "Aquela dor persistente em sua expressão já me disse tudo o que eu precisava saber."

# game/emmasoloending.rpy:260
translate brazil emmasoloending_b8d6e330:

#   gl "*chuckles* You know, I wasn't expecting you to ask me back then. Did you think it was the \"perfect opportunity\"?"
    gl "*risos* Sabe, eu não esperava que você me perguntasse isso naquela época. Você achou que era a \"oportunidade perfeita\"?"

# game/emmasoloending.rpy:261
translate brazil emmasoloending_7c8da23a:

#   mc "Yes. I thought the mood was right, and I didn't know if I'd still have a chance if I let it slip through my fingers."
    mc "Sim. Achei que o clima estava certo e não sabia se ainda teria uma chance se deixasse escapar."

# game/emmasoloending.rpy:270
translate brazil emmasoloending_75fb78b5:

#   gl "Ahh, I thought as much."
    gl "Ah, eu já imaginava."

# game/emmasoloending.rpy:271
translate brazil emmasoloending_b4f537b5:

#   gl "And what would you have done if I did not agree?"
    gl "E o que você teria feito se eu não concordasse?"

# game/emmasoloending.rpy:272
translate brazil emmasoloending_9f8c0aa9:

#   mc "I'd have never stopped asking. Even if you pointed that gun at my head, I'd negotiate with my life on the line if I had to."
    mc "Eu jamais teria parado de perguntar. Mesmo que apontassem aquela arma para a minha cabeça, eu negociaria, mesmo que minha vida estivesse em risco, se fosse preciso."

# game/emmasoloending.rpy:273
translate brazil emmasoloending_d7e4c595:

#   gl "How did you..."
    gl "Como você..."

# game/emmasoloending.rpy:274
translate brazil emmasoloending_67d1c4de:

#   mc "I barely picked it up, but I heard Gwen whisper when she hugged you."
    mc "Eu mal consegui ouvir, mas ouvi Gwen sussurrar quando te abraçou."

# game/emmasoloending.rpy:275
translate brazil emmasoloending_de7f2028:

#   gl "I see..."
    gl "Eu vejo..."

# game/emmasoloending.rpy:276
translate brazil emmasoloending_256d2c95:

#   gl "You're a better man than I am, [mc]."
    gl "Você é um homem melhor do que eu. [mc]."

# game/emmasoloending.rpy:277
translate brazil emmasoloending_6782a48f:

#   gl "Unfortunately, you and Gwen will never end up together. I like you, and how you think, you know?"
    gl "Infelizmente, você e a Gwen nunca ficarão juntos. Eu gosto de você e do seu jeito de pensar, sabe?"

# game/emmasoloending.rpy:280
translate brazil emmasoloending_d1b60494:

#   mc "Your daughter-"
    mc "Sua filha-"

# game/emmasoloending.rpy:281
translate brazil emmasoloending_524dbefe:

#   mc "No – Gwen – is the strongest woman I've ever known! She's a big reason for who I became!"
    mc "Não, a Gwen é a mulher mais forte que eu já conheci! Ela é uma grande responsável por quem eu me tornei!"

# game/emmasoloending.rpy:282
translate brazil emmasoloending_140ad8bd:

#   mc "Wherever my life leads me, she will always be a part of me!"
    mc "Para onde quer que a vida me leve, ela sempre fará parte de mim!"

# game/emmasoloending.rpy:283
translate brazil emmasoloending_853511bb:

#   mc "So, I apologize for becoming a reason of your disappointment!"
    mc "Portanto, peço desculpas por ter sido motivo de sua decepção!"

# game/emmasoloending.rpy:286
translate brazil emmasoloending_8dc1cb76:

#   gl "*inhales deeply*"
    gl "*inspira profundamente*"

# game/emmasoloending.rpy:287
translate brazil emmasoloending_849e71ea:

#   gl "..."
    gl "..."

# game/emmasoloending.rpy:290
translate brazil emmasoloending_c5dbd972:

#   gl "Do you know how often I've heard those words being said in my office?"
    gl "Você sabe quantas vezes já ouvi essas palavras sendo ditas no meu escritório?"

# game/emmasoloending.rpy:291
translate brazil emmasoloending_e0f3a6fe:

#   mc "No, sir... I do not..."
    mc "Não, senhor... Eu não..."

# game/emmasoloending.rpy:292
translate brazil emmasoloending_70767aa3:

#   gl "Never."
    gl "Nunca."

# game/emmasoloending.rpy:293
translate brazil emmasoloending_c1dff962:

#   mc "Oh..."
    mc "Oh..."

# game/emmasoloending.rpy:296
translate brazil emmasoloending_59676515:

#   gl "Come on, pick your head back up."
    gl "Vamos lá, levante a cabeça."

# game/emmasoloending.rpy:297
translate brazil emmasoloending_12cdcd06:

#   gl "You made a choice – now face it with your head up high. Good luck."
    gl "Você fez uma escolha – agora encare-a de cabeça erguida. Boa sorte."

# game/emmasoloending.rpy:298
translate brazil emmasoloending_4167684b:

#   mc "T-thank you!"
    mc "O-obrigado!"

# game/emmasoloending.rpy:302
translate brazil emmasoloending_6515c649:

#   gl "Go on now, the girls are waiting for you."
    gl "Vamos lá, as garotas estão esperando por você."

# game/emmasoloending.rpy:303
translate brazil emmasoloending_bc8ce9c0:

#   gl "Oh, I don't know if working in a construction company fancies you, but if you want a job – come and find me."
    gl "Ah, não sei se trabalhar em uma construtora te agrada, mas se você quer um emprego, venha me procurar."

# game/emmasoloending.rpy:304
translate brazil emmasoloending_6d4279c9:

#   gl "I'll have that glass of whisky ready for you."
    gl "Vou deixar aquele copo de uísque pronto para você."

# game/emmasoloending.rpy:323
translate brazil emmasoloending_82091822:

#   k "..."
    k "..."

# game/emmasoloending.rpy:326
translate brazil emmasoloending_052fd87c:

#   k "I guess I don't have to ask anymore. You two already made up your mind."
    k "Acho que não preciso mais perguntar. Vocês dois já se decidiram."

# game/emmasoloending.rpy:327
translate brazil emmasoloending_851d19de:

#   k "Do you have a place to stay?"
    k "Você tem onde ficar?"

# game/emmasoloending.rpy:328
translate brazil emmasoloending_5178b796:

#   mc "No, but we'll find somewhere we can stay for the time being."
    mc "Não, mas vamos encontrar um lugar para ficar por enquanto."

# game/emmasoloending.rpy:329
translate brazil emmasoloending_05ac8ecf:

#   k "*sighs*"
    k "*suspiros*"

# game/emmasoloending.rpy:332
translate brazil emmasoloending_14c955d3:

#   k "Well then, take this."
    k "Então, tome isto."

# game/emmasoloending.rpy:333
translate brazil emmasoloending_daa752da:

#   mc "A key?"
    mc "Uma chave?"

# game/emmasoloending.rpy:334
translate brazil emmasoloending_d57f8add:

#   k "A key to the house where I used to stay... alone. Back in my younger days."
    k "A chave da casa onde eu costumava ficar... sozinho. Nos meus tempos de juventude."

# game/emmasoloending.rpy:337
translate brazil emmasoloending_f7627240:

#   k "Just do me a favor and don't ask about it. It is something that I don't want to remember any longer."
    k "Por favor, não me pergunte sobre isso. É algo que eu não quero mais lembrar."

# game/emmasoloending.rpy:338
translate brazil emmasoloending_77afd32e:

#   mc "O-okay..."
    mc "Tá bem..."

# game/emmasoloending.rpy:339
translate brazil emmasoloending_246c94dc:

#   k "The place is a bit run-down, but it will provide you peace."
    k "O lugar está um pouco decadente, mas lhe proporcionará paz."

# game/emmasoloending.rpy:340
translate brazil emmasoloending_f7e9e23d:

#   k "Don't worry, I will not bother you. Just remember that there will still be a place you called {i}home{/i}, waiting for you to come back."
    k "Não se preocupe, não vou incomodá-lo. Apenas lembre-se de que ainda haverá um lugar que você chamou. {i} lar{/i}, esperando que você volte."

# game/emmasoloending.rpy:341
translate brazil emmasoloending_fd084526:

#   mc "I will. Thanks, Klara..."
    mc "Sim, obrigada, Klara..."

# game/emmasoloending.rpy:344
translate brazil emmasoloending_dd4e262f:

#   j "So? What about your job?"
    j "E aí? E o seu emprego?"

# game/emmasoloending.rpy:345
translate brazil emmasoloending_8534529c:

#   mc "Well, I'd like to keep it, if that's okay. Although I know the time will come when I must leave it behind, too."
    mc "Bem, eu gostaria de ficar com ele, se não se importar. Embora eu saiba que chegará o momento em que também terei que deixá-lo para trás."

# game/emmasoloending.rpy:348
translate brazil emmasoloending_8417041c:

#   j "*chuckles* I get it."
    j "*risos* Entendi."

# game/emmasoloending.rpy:349
translate brazil emmasoloending_6ac9af14:

#   j "In any case, whatever happens, you know where to find me."
    j "Em todo caso, aconteça o que acontecer, você sabe onde me encontrar."

# game/emmasoloending.rpy:350
translate brazil emmasoloending_3e432a99:

#   j "Take care, and good luck."
    j "Cuide-se e boa sorte."

# game/emmasoloending.rpy:353
translate brazil emmasoloending_f9ad0d94:

#   mc "Shall we go?"
    mc "Vamos?"

# game/emmasoloending.rpy:356
translate brazil emmasoloending_94a92282:

#   e "Mhm!"
    e "Sim!"

# game/emmasoloending.rpy:377
translate brazil emmasoloending_3bd9e9a1:

#   yt "It's been a year since then..."
    yt "Já faz um ano desde então..."

# game/emmasoloending.rpy:378
translate brazil emmasoloending_2e755c45:

#   yt "We immediately moved into the house that Klara offered."
    yt "Nos mudamos imediatamente para a casa que Klara nos ofereceu."

# game/emmasoloending.rpy:379
translate brazil emmasoloending_92ef20cf:

#   yt "To this day, it remains a mystery where she got it."
    yt "Até hoje, permanece um mistério onde ela o conseguiu."

# game/emmasoloending.rpy:380
translate brazil emmasoloending_b0e534a8:

#   yt "But it's a place that no one knows, aside from her. So it was challenging for us to start anew with no outside connections."
    yt "Mas é um lugar que ninguém conhece, além dela. Então foi um desafio para nós recomeçar do zero sem nenhuma conexão externa."

# game/emmasoloending.rpy:381
translate brazil emmasoloending_9ac1758d:

#   yt "Despite that, I kept my promise, and we married about three months later."
    yt "Apesar disso, cumpri minha promessa e nos casamos cerca de três meses depois."

# game/emmasoloending.rpy:382
translate brazil emmasoloending_3bdd4275:

#   yt "Roughly a month after we left our old lives, I resigned from the burger shack."
    yt "Aproximadamente um mês depois de termos deixado nossas vidas antigas, pedi demissão da lanchonete."

# game/emmasoloending.rpy:383
translate brazil emmasoloending_b7cc24da:

#   yt "I felt so empty quitting the job that I loved, as well as leaving the people I called {i}friends{/i}..."
    yt "Senti um vazio enorme ao deixar o emprego que amava, assim como ao me despedir das pessoas com quem convivia. {i} amigos{/i}..."

# game/emmasoloending.rpy:384
translate brazil emmasoloending_980c8c40:

#   yt "But, I thought I could explore my childhood hobby, and became a freelance photographer."
    yt "Mas pensei que poderia explorar meu hobby de infância e me tornei fotógrafo freelancer."

# game/emmasoloending.rpy:385
translate brazil emmasoloending_5af6b990:

#   yt "I was hesitant to do so at first, but honestly, I once again found my passion in photography. It was something that I did not expect."
    yt "Inicialmente, hesitei em fazê-lo, mas, honestamente, redescobri minha paixão pela fotografia. Foi algo que eu não esperava."

# game/emmasoloending.rpy:386
translate brazil emmasoloending_57b9a553:

#   yt "Also, I had this curiosity about Emma's line of work that eventually bloomed into an interest. So, she recruited me to her Private Investigations Agency as her sidekick."
    yt "Além disso, eu tinha curiosidade sobre a área de atuação da Emma, ​​o que acabou se transformando em interesse. Então, ela me recrutou para sua Agência de Investigações Particulares como seu parceiro."

# game/emmasoloending.rpy:387
translate brazil emmasoloending_ba098456:

#   yt "Yes, my wife and I worked two jobs simultaneously. She continued working as a detective while doing private investigations on the side."
    yt "Sim, minha esposa e eu tínhamos dois empregos simultaneamente. Ela continuou trabalhando como detetive enquanto fazia investigações particulares por fora."

# game/emmasoloending.rpy:388
translate brazil emmasoloending_4081c708:

#   yt "I initially thought I wouldn't be able to handle two jobs, but boy... it was fun! A husband and wife detective duo, how about that?"
    yt "Inicialmente pensei que não conseguiria conciliar dois trabalhos, mas nossa... foi divertido! Uma dupla de detetives, marido e mulher, que tal?"

# game/emmasoloending.rpy:389
translate brazil emmasoloending_c15a3889:

#   yt "Although, we've faced some hurdles as we tried to live independently."
    yt "Embora tenhamos enfrentado alguns obstáculos ao tentarmos viver de forma independente."

# game/emmasoloending.rpy:390
translate brazil emmasoloending_7cbe011f:

#   yt "Emma hadn't had a new case for weeks while I struggled to find new clients."
    yt "Emma não tinha um novo caso há semanas, enquanto eu me esforçava para encontrar novos clientes."

# game/emmasoloending.rpy:391
translate brazil emmasoloending_f0ea64f1:

#   yt "The past few months were tough, and we've considered finding a new line of work."
    yt "Os últimos meses foram difíceis e chegamos a considerar a possibilidade de mudar de emprego."

# game/emmasoloending.rpy:392
translate brazil emmasoloending_258addf1:

#   yt "That was until... something unexpected happened..."
    yt "Isso até que... algo inesperado aconteceu..."

# game/emmasoloending.rpy:396
translate brazil emmasoloending_d8730a5a:

#   yt "{i}Spring, 20th of March..."
    yt "{i}Primavera, 20 de março..."

# game/emmasoloending.rpy:407
translate brazil emmasoloending_2977c0c3:

#   un "{i}A doll came walking towards me.{/i}"
    un "{i}Uma boneca veio caminhando em minha direção.{/i}"

# game/emmasoloending.rpy:410
translate brazil emmasoloending_3cd4dfbb:

#   un "{i}She never smiled...{/i}"
    un "{i}Ela nunca sorria...{/i}"

# game/emmasoloending.rpy:411
translate brazil emmasoloending_bc6f8952:

#   un "{i}She never talked...{/i}"
    un "{i}Ela nunca falava...{/i}"

# game/emmasoloending.rpy:414
translate brazil emmasoloending_0221f952:

#   un "{i}All she did, was greet me and look at my old plushies.{/i}"
    un "{i}Tudo o que ela fez foi me cumprimentar e olhar para meus antigos bichinhos de pelúcia.{/i}"

# game/emmasoloending.rpy:421
translate brazil emmasoloending_e4fbe5b8:

#   un "{i}She paused for a second, then entered our house.{/i}"
    un "{i}Ela hesitou por um segundo e então entrou em nossa casa.{/i}"

# game/emmasoloending.rpy:424
translate brazil emmasoloending_3d86526c:

#   un "{i}She looked like terrible news, but she's extremely cool! I wonder if she'd be willing to play with me...{/i}"
    un "{i}Ela parecia uma péssima notícia, mas é super legal! Será que ela toparia brincar comigo...?{/i}"

# game/emmasoloending.rpy:463
translate brazil emmasoloending_fcc6ee53:

#   nad "... Officer Meyer?"
    nad "...O policial Meyer?"

# game/emmasoloending.rpy:464
translate brazil emmasoloending_46a0012c:

#   e "Ah, I'm sorry."
    e "Ah, me desculpe."

# game/emmasoloending.rpy:467
translate brazil emmasoloending_472d9ea5:

#   nad "Please, take a seat."
    nad "Por favor, sente-se."

# game/emmasoloending.rpy:469
translate brazil emmasoloending_421bf061:

#   e "{i}She looks... pale."
    e "{i}Ela parece... pálida."

# game/emmasoloending.rpy:472
translate brazil emmasoloending_f4ef781d:

#   nad "Can I offer you anything?"
    nad "Posso lhe oferecer algo?"

# game/emmasoloending.rpy:473
translate brazil emmasoloending_17e43748:

#   e "Please, don't bother."
    e "Por favor, não se incomode."

# game/emmasoloending.rpy:476
translate brazil emmasoloending_4c5841cb:

#   un "*whispers* Hmn... What are they talking about? This is the first time mom had any visitors..."
    un "*sussurra* Hum... Do que eles estão falando? É a primeira vez que a mamãe recebe visitas..."

# game/emmasoloending.rpy:479
translate brazil emmasoloending_40d55f5e:

#   un "*whispers* Could she be a relative? My auntie, perhaps? She doesn't look like mom, though..."
    un "*sussurrando* Será que ela é alguma parente? Minha tia, talvez? Ela não se parece com a minha mãe..."

# game/emmasoloending.rpy:480
translate brazil emmasoloending_83edb716:

#   un "*whispers* But all relatives already abandoned us... Then, who is she?"
    un "*sussurra* Mas todos os parentes já nos abandonaram... Então, quem é ela?"

# game/emmasoloending.rpy:486
translate brazil emmasoloending_82b8a088:

#   un "Ah!"
    un "Ah!"

# game/emmasoloending.rpy:489
translate brazil emmasoloending_02f7a362:

#   e "{i}*chuckles*{/i}"
    e "{i}*risos*{/i}"

# game/emmasoloending.rpy:492
translate brazil emmasoloending_c9dda023:

#   nad "We can hear you, Leah! Where are your manners?"
    nad "Nós conseguimos te ouvir, Leah! Onde estão seus bons modos?"

# game/emmasoloending.rpy:493
translate brazil emmasoloending_3f060f86:

#   nad "Come and say \"good morning\"!"
    nad "Venha dar \"bom dia\"!"

# game/emmasoloending.rpy:496
translate brazil emmasoloending_2a327a61:

#   le "Eek~!"
    le "Eita!"

# game/emmasoloending.rpy:499
translate brazil emmasoloending_0dd075cf:

#   le "Uhm... Good morning."
    le "Hum... Bom dia."

# game/emmasoloending.rpy:500
translate brazil emmasoloending_2838f70c:

#   e "Mhm."
    e "Hum."

# game/emmasoloending.rpy:503
translate brazil emmasoloending_98741ac3:

#   le "..."
    le "..."

# game/emmasoloending.rpy:504
translate brazil emmasoloending_8d34fbb2:

#   e "...."
    e "..."

# game/emmasoloending.rpy:507
translate brazil emmasoloending_f51ab96b:

#   le "Here!"
    le "Aqui!"

# game/emmasoloending.rpy:508
translate brazil emmasoloending_19e3a5a4:

#   e "I-"
    e "EU-"

# game/emmasoloending.rpy:509
translate brazil emmasoloending_78052016:

#   le "He's my least favorite, so I'm letting you borrow him for a while! But, you must return him to me later!"
    le "Ele é o meu menos favorito, então vou deixar você pegá-lo emprestado por um tempo! Mas você precisa me devolvê-lo depois!"

# game/emmasoloending.rpy:512
translate brazil emmasoloending_f4531741:

#   e "{i}Her... least favorite? Why?{/i}"
    e "{i}A... sua favorita menos favorita? Por quê?{/i}"

# game/emmasoloending.rpy:519
translate brazil emmasoloending_8a0151f2:

#   e "*sighs*"
    e "*suspiros*"

# game/emmasoloending.rpy:522
translate brazil emmasoloending_c2154c33:

#   nad "You're not a socialite, are you?"
    nad "Você não é uma pessoa da alta sociedade, é?"

# game/emmasoloending.rpy:523
translate brazil emmasoloending_0b43fb75:

#   e "Well, it helps from time to time."
    e "Bem, isso ajuda de vez em quando."

# game/emmasoloending.rpy:524
translate brazil emmasoloending_c3df74e1:

#   nad "I have no idea how you do it, but I'll leave it at that."
    nad "Não faço ideia de como você faz isso, mas vou parar por aqui."

# game/emmasoloending.rpy:527
translate brazil emmasoloending_07a93a5f:

#   e "How old is she?"
    e "Quantos anos ela tem?"

# game/emmasoloending.rpy:528
translate brazil emmasoloending_adc84b9d:

#   nad "She's turning ten this year..."
    nad "Ela completa dez anos este ano..."

# game/emmasoloending.rpy:529
translate brazil emmasoloending_4b30d2df:

#   e "{i}So, a few years older than me when I was here...{/i}"
    e "{i}Então, alguns anos mais velho do que eu quando estive aqui...{/i}"

# game/emmasoloending.rpy:530
translate brazil emmasoloending_1eb0df34:

#   nad "She's a bit stubborn, yet a kind and sweet little girl."
    nad "Ela é um pouco teimosa, mas ao mesmo tempo uma menina gentil e doce."

# game/emmasoloending.rpy:533
translate brazil emmasoloending_16f61cde:

#   nad "It pains me that I can't take care of her as much as I did when she was younger."
    nad "Me dói não poder cuidar dela tanto quanto cuidava quando ela era mais nova."

# game/emmasoloending.rpy:537
translate brazil emmasoloending_34eda977:

#   e "Why is that?"
    e "Por que é que?"

# game/emmasoloending.rpy:541
translate brazil emmasoloending_db7e3ab7:

#   nad "I'm at my wit's end, officer Meyer. All I can think about is him and the possibility that..."
    nad "Estou no meu limite, policial Meyer. Tudo em que consigo pensar é nele e na possibilidade de que..."

# game/emmasoloending.rpy:542
translate brazil emmasoloending_53ad39ca:

#   nad "*sobs*"
    nad "*soluços*"

# game/emmasoloending.rpy:543
translate brazil emmasoloending_8cc48767:

#   nad "I don't know what to do anymore. If I lose him, my... I mean, {i}our{/i} future is lost..."
    nad "Eu não sei mais o que fazer. Se eu o perder, meu... quer dizer, {i} nosso{/i} O futuro está perdido..."

# game/emmasoloending.rpy:549
translate brazil emmasoloending_529bcac7:

#   e "I understand. Please, take a deep breath and tell me what I can do for you."
    e "Entendo. Por favor, respire fundo e me diga o que posso fazer por você."

# game/emmasoloending.rpy:562
translate brazil emmasoloending_b7dc0642:

#   le "Hmm? You don't think the doll will come?"
    le "Hum? Você acha que a boneca não vai chegar?"

# game/emmasoloending.rpy:563
translate brazil emmasoloending_4a55034f:

#   le "Trust me, she will! I let her borrow Mr. Penguin, so she must return him!"
    le "Pode ter certeza, ela vai devolver! Eu emprestei o Sr. Pinguim para ela, então ela precisa devolvê-lo!"

# game/emmasoloending.rpy:566
translate brazil emmasoloending_1d4403d9:

#   le "You still don't think so?"
    le "Você ainda acha que não?"

# game/emmasoloending.rpy:567
translate brazil emmasoloending_6f7e03ea:

#   le "You don't trust Mr. Penguin? Come on, now... Why would you hate him?"
    le "Você não confia no Sr. Pinguim? Ora, vamos lá... Por que você o odiaria?"

# game/emmasoloending.rpy:569
translate brazil emmasoloending_774e4b54:

#   "*knocks*"
    "*bate na porta*"

# game/emmasoloending.rpy:572
translate brazil emmasoloending_c81ce0a4:

#   le "Mom?"
    le "Mãe?"

# game/emmasoloending.rpy:573
translate brazil emmasoloending_593631ef:

