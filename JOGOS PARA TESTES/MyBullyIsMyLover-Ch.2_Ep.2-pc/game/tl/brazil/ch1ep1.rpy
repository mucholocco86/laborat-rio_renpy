#   mc "Yow, Miss Security, slash Cashier, slash Receptionist!"
    mc "E aí, senhorita Segurança,/Caixa,/Recepcionista!"

# game/ch1ep1.rpy:2122
translate brazil klarapause3_c556b909:

#   am "Hm?"
    am "Hum?"

# game/ch1ep1.rpy:2123
