# game/ch1ep3.rpy:3417
translate brazil freyafirstarcend_aaedc684:

#   fr "I haven't yet, but-"
    fr "Eu ainda não, mas-"

# game/ch1ep3.rpy:3418
translate brazil freyafirstarcend_37c8c1c6:

#   un "Ah, \"but\"; the same word your weak-willed sister was so fond of using."
    un "Ah, \"mas\"; a mesma palavra que sua irmã de vontade fraca tanto gostava de usar."

# game/ch1ep3.rpy:3419
translate brazil freyafirstarcend_bbc874e0:

#   un "I detest that word, Francis. All I asked was for you to locate and bring Aine to me. A task apparently too monumental for you."
    un "Detesto essa palavra, Francis. Tudo o que pedi foi que você localizasse Aine e me trouxesse. Uma tarefa aparentemente monumental demais para você."

# game/ch1ep3.rpy:3422
translate brazil freyafirstarcend_325a933f:

#   fr "I'm not entirely convinced that she's at the reported location, Father."
    fr "Não estou totalmente convencido de que ela esteja no local indicado, padre."

# game/ch1ep3.rpy:3423
translate brazil freyafirstarcend_15003857:

#   un "Are you trying to question my power?"
    un "Você está tentando questionar o meu poder?"

# game/ch1ep3.rpy:3424
translate brazil freyafirstarcend_5db142d9:

#   fr "No, father..."
    fr "Não, pai..."

# game/ch1ep3.rpy:3425
translate brazil freyafirstarcend_a63c2fca:

#   un "Did I raise a son who can't even ascertain a simple fact?"
    un "Será que criei um filho que não consegue nem sequer discernir um fato simples?"

# game/ch1ep3.rpy:3426
translate brazil freyafirstarcend_1315f18c:

#   fr "No... father..."
    fr "Não... pai..."

# game/ch1ep3.rpy:3427
translate brazil freyafirstarcend_a986f872:

#   un "You are trying my patience, Francis."
    un "Você está testando minha paciência, Francis."

# game/ch1ep3.rpy:3428
translate brazil freyafirstarcend_da52d1fd:

#   un "Do you want your sister back? Or would you prefer dawdling?"
    un "Você quer sua irmã de volta? Ou prefere prolongar o processo?"

# game/ch1ep3.rpy:3429
translate brazil freyafirstarcend_8512c317:

#   un "If you can't manage this simple task, tell me now. I have no qualms about handling it myself."
    un "Se você não conseguir realizar essa tarefa simples, me avise agora. Não tenho nenhum problema em resolvê-la eu mesmo."

# game/ch1ep3.rpy:3432
translate brazil freyafirstarcend_88aa7752:

#   fr "No! Just..."
    fr "Não! Apenas..."

# game/ch1ep3.rpy:3433
translate brazil freyafirstarcend_ef3a5f5d:

#   fr "Just give me a bit more time! I have a strategy in mind and won't disappoint you!"
    fr "Só me dê mais um pouco de tempo! Tenho uma estratégia em mente e não vou te decepcionar!"

# game/ch1ep3.rpy:3434
translate brazil freyafirstarcend_a4d6a972:

#   un "... This is your final chance. And remember, I have no use for failures."
    un "... Esta é a sua última chance. E lembre-se, não tenho paciência para fracassos."

# game/ch1ep3.rpy:3438
translate brazil freyafirstarcend_aa4e93c1:

#   un "Repeat it back, so I know it's sunk in."
    un "Repita para mim, para que eu saiba que você entendeu."

# game/ch1ep3.rpy:3441
translate brazil freyafirstarcend_54325499:

#   fr "You dispose of useless people, just like you did with my sister..."
    fr "Você se livra de pessoas inúteis, assim como fez com a minha irmã..."

# game/ch1ep3.rpy:3442
translate brazil freyafirstarcend_72972aeb:

#   un "Precisely. Keep that in mind, lest you wish to be erased from this lineage."
    un "Exatamente. Lembre-se disso, a menos que queira ser apagado desta linhagem."

# game/ch1ep3.rpy:3445
translate brazil freyafirstarcend_c9b95c37:

#   fr "{i}Tsk!"
    fr "{i}Tsc!"

# game/ch1ep3.rpy:3448
translate brazil freyafirstarcend_671c08e3:

#   fr "One question, which is what I came here for."
    fr "Uma pergunta, que é o motivo da minha visita."

# game/ch1ep3.rpy:3449
translate brazil freyafirstarcend_87750646:

#   un "What is it?"
    un "O que é?"

# game/ch1ep3.rpy:3450
translate brazil freyafirstarcend_113bf0e3:

#   fr "What's the endgame once I find her? You've slated us for marriage, but to what end?"
    fr "Qual é o objetivo final depois que eu a encontrar? Você nos destinou ao casamento, mas com que propósito?"

# game/ch1ep3.rpy:3451
translate brazil freyafirstarcend_1fdb32e3:

#   un "Always with the curiosity, I see."
    un "Sempre com curiosidade, pelo que vejo."

# game/ch1ep3.rpy:3452
translate brazil freyafirstarcend_369b813f:

#   un "The motive? Merely to elevate our family's legacy. That's all you need to concern yourself with."
    un "O motivo? Simplesmente enaltecer o legado da nossa família. É só com isso que você precisa se preocupar."

# game/ch1ep3.rpy:3454
translate brazil freyafirstarcend_15b7ff71:

#   fr "Ensure you keep your end of the bargain. Return my sister to me."
    fr "Cumpra sua parte do acordo. Devolva minha irmã para mim."

# game/ch1ep3.rpy:3455
translate brazil freyafirstarcend_f429f4b0:

#   un "She will be returned if, and only if, you deliver on your part."
    un "Ela será devolvida se, e somente se, você cumprir sua parte."

# game/ch1ep3.rpy:3458
translate brazil freyafirstarcend_13014dc0:

#   un "Time is of the essence, Francis. Do whatever it takes. Use force if necessary."
    un "O tempo urge, Francis. Faça o que for preciso. Use a força, se necessário."

# game/ch1ep3.rpy:3459
translate brazil freyafirstarcend_599c190e:

#   un "Achieve this for Olivia's sake."
    un "Faça isso pelo bem de Olivia."

# game/ch1ep3.rpy:3462
translate brazil freyafirstarcend_763cf761:

#   fr "Understood..."
    fr "Entendido..."

# game/ch1ep3.rpy:3465
translate brazil freyafirstarcend_3a225f6e:

#   un "..."
    un "..."

# game/ch1ep3.rpy:3468
translate brazil freyafirstarcend_a043ebd6:

#   un "That boy..."
    un "Aquele menino..."

# game/ch1ep3.rpy:3469
translate brazil freyafirstarcend_7681eea0:

#   un "Be careful of him."
    un "Tenha cuidado com ele."

# game/ch1ep3.rpy:3470
translate brazil freyafirstarcend_b07a5906:

#   fr "You know him? Who is he?"
    fr "Você o conhece? Quem é ele?"

# game/ch1ep3.rpy:3471
translate brazil freyafirstarcend_434e9963:

#   un "Someone who's in debt to me. Or rather... the person who took him was."
    un "Alguém que me devia dinheiro. Ou melhor... a pessoa que o levou era."

# game/ch1ep3.rpy:3472
translate brazil freyafirstarcend_44c3781e:

#   un "Take him out first, then getting Aine should be easy enough for you."
    un "Elimine-o primeiro, depois conseguir a Aine será bem fácil para você."

# game/ch1ep3.rpy:3473
translate brazil freyafirstarcend_8ba806e3:

#   un "You can do it, right?"
    un "Você consegue, não é?"

# game/ch1ep3.rpy:3474
translate brazil freyafirstarcend_f9678ecd:

#   fr "O-of course."
    fr "Claro."

# game/ch1ep3.rpy:3475
translate brazil freyafirstarcend_589c73b4:

#   un "Then you should take your leave. You are only wasting time."
    un "Então você deveria ir embora. Você só está perdendo tempo."

# game/ch1ep3.rpy:3478
translate brazil freyafirstarcend_24430811:

#   fr "{i}Every moment I was there, I was humiliated..."
    fr "{i}Em todos os momentos que estive lá, fui humilhado..."

# game/ch1ep3.rpy:3479
translate brazil freyafirstarcend_ee48f920:

#   fr "{i}I will set things right this time."
    fr "{i}Desta vez, vou consertar as coisas."

# game/ch1ep3.rpy:3480
translate brazil freyafirstarcend_26c52b09:

#   fr "{i}Just hold on a little longer, Vi."
    fr "{i}Aguente firme mais um pouco, Vi."

# game/ch1ep3.rpy:3483
translate brazil freyafirstarcend_fbaec136:

#   un "*chuckles* Looks like your plan is just as blinded as you are, Hera."
    un "*risos* Parece que seu plano é tão cego quanto você, Hera."

# game/ch1ep3.rpy:3484
translate brazil freyafirstarcend_362b194f:

#   un "Perhaps I should thank you for making my world smaller."
    un "Talvez eu devesse te agradecer por tornar meu mundo menor."

# game/ch1ep3.rpy:3437
translate brazil freyafirstarcend_c3a70392_1:

#   fr "..."
    fr "..."

# game/ch1ep3.rpy:3453
translate brazil freyafirstarcend_c3a70392_2:

#   fr "..."
    fr "..."

