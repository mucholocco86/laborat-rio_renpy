# game/ch1ep3.rpy:2236
translate brazil freyastitchcosplay_c62e2b4f:

#   f "Thanks. It means a lot."
    f "Obrigado. Significa muito para mim."

# game/ch1ep3.rpy:2237
translate brazil freyastitchcosplay_aa18b593:

#   mc "How're you holding up?"
    mc "Como você está?"

