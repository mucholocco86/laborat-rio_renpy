translate brazil ep7_078b0f5d:

#   mc "Oh, hey, uhh... Sorry, we were just arguing about something."
    mc "Ah, olá, uh... Desculpe, estávamos discutindo sobre algo."

# game/ep7.rpy:472
translate brazil ep7_ccc07b87:

#   j "Yes, that's what I just said, [mc]."
    j "Sim, foi exatamente isso que eu acabei de dizer. [mc]."

