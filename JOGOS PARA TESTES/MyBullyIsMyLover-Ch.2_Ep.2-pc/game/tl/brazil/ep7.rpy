translate brazil ep7_3825b1a9:

#   mc "Did you hear everything?"
    mc "Você ouviu tudo?"

# game/ep7.rpy:474
translate brazil ep7_480760d7:

#   j "Just from the moment she mentioned Agnor Family."
    j "Logo no momento em que ela mencionou a Família Agnor."

# game/ep7.rpy:475
translate brazil ep7_c2efa5fa:

#   j "{b}My{/b} family."
    j "{b}Meu{/b} família."

# game/ep7.rpy:476
translate brazil ep7_82d0ec0d:

#   j "But I suppose I shouldn't say that."
    j "Mas acho que não deveria dizer isso."

