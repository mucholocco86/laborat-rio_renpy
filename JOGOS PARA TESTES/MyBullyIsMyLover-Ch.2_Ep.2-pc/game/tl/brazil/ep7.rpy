#   mc "Wait, what?!"
    mc "Espera, o quê?!"

# game/ep7.rpy:462
translate brazil ep7_388c32af:

#   mc "Mafia?!"
    mc "Máfia?!"

# game/ep7.rpy:463
translate brazil ep7_045e969a:

#   a "Uh-huh?"
    a "Hum-hum?"

