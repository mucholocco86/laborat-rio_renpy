translate brazil ep7_b6d5acf1:

#   mc "Well, yeah. I have too many doubts about this, thus I have a question for you, Miss Jess."
    mc "Bem, sim. Tenho muitas dúvidas sobre isso, por isso tenho uma pergunta para você, Srta. Jess."

# game/ep7.rpy:487
translate brazil ep7_1cef3976:

#   mc "No... Jess."
    mc "Não... Jess."

