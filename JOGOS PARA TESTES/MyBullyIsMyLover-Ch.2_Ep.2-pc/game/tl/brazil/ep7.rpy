translate brazil ep7_a99b4090:

#   m "But don't get it wrong, I am your servant, but I won't stick around you like what you think."
    m "Mas não me interprete mal, sou seu servo, mas não ficarei por perto como você pensa."

# game/ep7.rpy:2162
translate brazil ep7_c09f4020:

#   m "I have a responsibility in this place and I can't leave just like that."
    m "Tenho uma responsabilidade neste lugar e não posso simplesmente ir embora assim."

