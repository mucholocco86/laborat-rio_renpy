translate brazil ep7_039dcfbc:

#   j "I'm pretty much done with what I have to do, all that's left for me is to help Klara with her company."
    j "Já terminei praticamente tudo o que tinha para fazer, só me resta ajudar a Klara com a empresa dela."

# game/ep7.rpy:2031
translate brazil ep7_0d0cc581:

#   j "Whatever you want to do, stand up for it like a man."
    j "Faça o que quiser, defenda isso como um homem."

