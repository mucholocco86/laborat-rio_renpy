translate brazil ep7_73858cc8:

#   mc "Why didn't you tell me that beforehand?!"
    mc "Por que você não me disse isso antes?!"

# game/ep7.rpy:465
translate brazil ep7_73448be5:

#   a "Well, because you never asked!"
    a "Bem, porque você nunca perguntou!"

