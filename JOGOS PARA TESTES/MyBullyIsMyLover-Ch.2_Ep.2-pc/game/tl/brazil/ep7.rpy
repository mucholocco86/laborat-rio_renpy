#   a "You're... my aunt, right?"
    a "Você é... minha tia, certo?"

# game/ep7.rpy:2055
translate brazil ep7_0587eecb:

#   j "Your mother's only sister. My name is Jess, it's nice to see you all grown up now, Aine."
    j "Sou a única irmã da sua mãe. Meu nome é Jess, que bom te ver crescida agora, Aine."

