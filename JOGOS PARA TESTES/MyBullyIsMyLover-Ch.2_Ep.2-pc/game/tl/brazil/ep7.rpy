translate brazil ep7_5a18e86b:

#   yt "Emy..."
    yt "Emy..."

# game/ep7.rpy:2036
translate brazil ep7_135ea619:

#   mc "So you want me to stay here with you?"
    mc "Então você quer que eu fique aqui com você?"

