    mc "Ele ainda está por aí, escondido. Ou pelo menos, é o que sabemos."

# game/ep7.rpy:1944
translate brazil ep7_de021b16:

#   mc "There's no certainty if he's actually still alive."
    mc "Não há certeza se ele ainda está vivo."

