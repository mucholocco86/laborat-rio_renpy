translate brazil ep7_cf646dcb:

#   mc "I don't have an informant, but I'm not that stupid, Jess."
    mc "Eu não tenho um informante, mas não sou tão burro assim, Jess."

# game/ep7.rpy:496
translate brazil ep7_f284ffd6:

#   mc "These girls coming here was way too much of a coincidence for Emma to pick."
    mc "A vinda dessas garotas para cá foi uma coincidência grande demais para Emma ter previsto."

