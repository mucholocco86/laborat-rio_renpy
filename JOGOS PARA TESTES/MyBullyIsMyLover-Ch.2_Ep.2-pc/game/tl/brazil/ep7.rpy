#   a "Who are you calling? You know I can just-"
    a "Para quem você está ligando? Você sabe que eu posso simplesmente..."

# game/ep7.rpy:435
translate brazil ep7_ac62cc36:

#   mc "Shhhhh..."
    mc "Shhhh..."

# game/ep7.rpy:436
translate brazil ep7_542e77a0:

#   mc "It's who I hope will be my secret weapon... who also happens to be your aunt."
    mc "É aquela que eu espero que seja minha arma secreta... e que por acaso é sua tia."

