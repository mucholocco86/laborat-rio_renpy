translate brazil ep7_910a4d7a:

#   mc "... Are you guys using me?"
    mc "... Vocês estão me usando?"

# game/ep7.rpy:494
translate brazil ep7_76016e37:

#   j "*chuckles* And where did you get that idea?"
    j "*risos* E de onde você tirou essa ideia?"

