    un "Hum... Olá?"

# game/ep7.rpy:586
translate brazil ep7_6b4259e2:

#   j "Intelligence encrypted call, relax."
    j "Chamada criptografada inteligente, fique tranquilo."

# game/ep7.rpy:587
translate brazil ep7_697659b5:

#   un "Oh, hey, Jessy! What's up?"
    un "Ah, oi, Jessy! Tudo bem?"

# game/ep7.rpy:588
translate brazil ep7_3e1cb03c:

#   j "Tell them to come to Fang's hideout please, Eliza."
    j "Diga a eles para irem ao esconderijo de Fang, por favor, Eliza."

# game/ep7.rpy:589
translate brazil ep7_9e5060e6:

#   un "Right away!"
    un "Agora mesmo!"

# game/ep7.rpy:590
translate brazil ep7_62cc4839:

#   j "*click*"
    j "*clique*"

# game/ep7.rpy:593
translate brazil ep7_3f5e2ca0:

#   j "I'll be back."
    j "Eu voltarei."

# game/ep7.rpy:594
translate brazil ep7_91de72d6:

#   k "Mhm."
    k "Hum."

# game/ep7.rpy:612
translate brazil ep7_9318d03d:

#   "*car door closes*"
    "*a porta do carro fecha*"

# game/ep7.rpy:615
translate brazil ep7_29b3ad1b:

#   cl "You must be [mc] and Lady Aine."
    cl "Você deve ser [mc] e Lady Aine."

# game/ep7.rpy:616
translate brazil ep7_7c1b8714:

#   cl "It's nice to meet you two. We will be your bodyguards today."
    cl "É um prazer conhecer vocês dois. Seremos seus guarda-costas hoje."

# game/ep7.rpy:620
translate brazil ep7_501a3ab1:

#   yt "Wait, isn't she that girl from last time?"
    yt "Espera aí, ela não é aquela garota da última vez?"

# game/ep7.rpy:621
translate brazil ep7_7449f2da:

#   yt "She looks hella nice in that hair, though."
    yt "Ela fica muito bonita com esse cabelo."

# game/ep7.rpy:626
translate brazil ep7_d951a44f:

#   yt "Oh boy..."
    yt "Nossa..."

# game/ep7.rpy:629
translate brazil ep7_1842db45:

#   a "Please don't address me like that, I'm nothing but an ordinary person."
    a "Por favor, não se dirija a mim dessa forma, eu não sou nada além de uma pessoa comum."

# game/ep7.rpy:630
translate brazil ep7_6e5d516d:

#   cl "I insist. We all know that you are not, Lady Aine."
    cl "Insisto. Todos sabemos que não é, Lady Aine."

# game/ep7.rpy:633
translate brazil ep7_4f2d1928:

#   a "Tch! So be it, I'm not in the mood for this."
    a "Tch! Que seja, não estou com paciência para isso."

# game/ep7.rpy:634
translate brazil ep7_45977132:

#   yt "Hooo... She's really intimidating me, I should be careful not to annoy her from now on."
    yt "Uau... Ela está me intimidando mesmo, devo tomar cuidado para não irritá-la daqui para frente."

# game/ep7.rpy:638
translate brazil ep7_0f077bd2:

#   cl "*chuckles* Like mother, like daughter..."
    cl "*risos* Tal mãe, tal filha..."

