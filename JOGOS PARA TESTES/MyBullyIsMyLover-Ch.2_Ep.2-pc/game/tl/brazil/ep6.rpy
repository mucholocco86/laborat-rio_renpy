translate brazil lilyannepause_3e466916:

#   e "{i}That's all I wanted to know..."
    e "{i}Era só isso que eu queria saber..."

# game/ep6.rpy:4303
translate brazil lilyannepause_b3aa1537:

#   e "{i}I deeply regret my decision to move on, but now that we're in this situation, there is no turning back time anymore."
    e "{i}Lamento profundamente minha decisão de seguir em frente, mas agora que estamos nessa situação, não há mais como voltar atrás."

# game/ep6.rpy:4304
translate brazil lilyannepause_93c1502b:

#   e "{i}If I can comfort you like this any time you are in distress, then I will never ask for more."
    e "{i}Se eu puder te confortar assim sempre que você estiver aflito, então nunca pedirei mais nada."

# game/ep6.rpy:4305
translate brazil lilyannepause_f9332de7:

#   e "{i}I'm here now... I'll be here for you."
    e "{i}Estou aqui agora... Estarei aqui por você."

# game/ep6.rpy:4308
translate brazil lilyannepause_17284d70:

#   e "{i}It's not bad to wish for it twice, right?"
    e "{i}Não é ruim desejar algo duas vezes, certo?"

# game/ep6.rpy:4309
translate brazil lilyannepause_9cad5c51:

#   e "{i}Then..."
    e "{i}Então..."

# game/ep6.rpy:4310
translate brazil lilyannepause_a6ce0bd2:

#   e "{i}Please let us fix our past mistakes and guide us to the right path this time."
    e "{i}Por favor, permita-nos corrigir nossos erros do passado e nos guie para o caminho certo desta vez."

# game/ep6.rpy:4311
translate brazil lilyannepause_7e050082:

#   e "{i}That's all I could ever wish for."
    e "{i}Isso é tudo que eu poderia desejar."

# game/ep6.rpy:4314
translate brazil lilyannepause_4189ace3:

#   e "[mc]...? Can you face me, please?"
    e "[mc]...? Você pode me encarar, por favor?"

# game/ep6.rpy:4315
