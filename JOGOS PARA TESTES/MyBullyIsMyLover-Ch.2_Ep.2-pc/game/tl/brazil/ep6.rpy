    mc "Espere... Este fica bem em frente ao nosso, não é...?"

# game/ep6.rpy:6063
translate brazil freyapantstease_93ac5b82:

#   mc "Then that means..."
    mc "Então isso significa..."

# game/ep6.rpy:6067
translate brazil freyapantstease_eefe9cdc:

#   tbot "HUUUUUUUUHH......??!!"
    tbot "HUUUUUUUUUHH......??!!"

