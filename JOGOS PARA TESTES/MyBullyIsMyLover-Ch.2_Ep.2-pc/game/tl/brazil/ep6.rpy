translate brazil freyapantstease_2fab282b:

#   mc "It's not that I'm cold, I just decided to be a better guy, Shu. Set my life straight, you know?"
    mc "Não é que eu seja frio, eu só decidi ser uma pessoa melhor, Shu. Colocar minha vida em ordem, sabe?"

