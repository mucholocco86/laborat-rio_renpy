#   yt "How is she drunk already?"
    yt "Como ela já está bêbada?"

# game/ep6.rpy:1186
translate brazil naomipause2_99498d50:

#   mc "Well? You don't have any choice now, do you?"
    mc "E então? Você não tem escolha agora, não é?"

# game/ep6.rpy:1190
translate brazil naomipause2_50e61a50:

#   g "Heheee~! You cheeky little girl, I almost forgot it's your birthday today, Em!"
    g "Hehehe~! Sua garotinha atrevida, quase me esqueci que hoje é seu aniversário, Em!"

# game/ep6.rpy:1193
translate brazil naomipause2_e38dc5bf:

#   g "Come and give big sister a kiss, will you?"
    g "Venha dar um beijo na irmã mais velha, tá bom?"

# game/ep6.rpy:1194
