translate brazil emmapause3_cbd677e7:

#   gl "I understand, I have no complaints about it. Seems a pretty secluded place."
    gl "Entendo, não tenho queixas. Parece um lugar bem isolado."

# game/ep6.rpy:5535
translate brazil emmapause3_4e8bd9d1:

#   m "You'll be away for a while, huh?"
    m "Você vai ficar fora por um tempo, né?"

