# game/ep6.rpy:5967
translate brazil freyapantstease_f0efef16:

#   mc "Uh, no? Why would I?"
    mc "Hum, não? Por que eu faria isso?"

# game/ep6.rpy:5968
translate brazil freyapantstease_d5307874:

#   shu "Isn't it obvious?"
    shu "Não é óbvio?"

# game/ep6.rpy:5971
