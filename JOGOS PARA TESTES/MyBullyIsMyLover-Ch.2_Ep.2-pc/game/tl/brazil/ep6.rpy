    e "*apertar*"

# game/ep6.rpy:4289
translate brazil lilyannepause_0fbea230:

#   e "{i}Even just this one time..."
    e "{i}Mesmo que seja só desta vez..."

# game/ep6.rpy:4290
translate brazil lilyannepause_33b3cae2:

#   e "{i}With all the courage I have..."
    e "{i}Com toda a coragem que tenho..."

# game/ep6.rpy:4291
