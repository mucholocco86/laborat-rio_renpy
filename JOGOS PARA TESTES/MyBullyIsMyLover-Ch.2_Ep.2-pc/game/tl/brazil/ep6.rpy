#   e "{i}I..."
    e "{i}EU..."

# game/ep6.rpy:4292
translate brazil lilyannepause_d58da4dd:

#   e "{i}...want to hug him..."
    e "{i}...quero abraçá-lo..."

# game/ep6.rpy:4295
translate brazil lilyannepause_fb9e7f48:

#   mc "Aha haaa... Man... Why am I even telling you all-"
    mc "Ahá... Nossa... Por que estou contando tudo isso para vocês?"

# game/ep6.rpy:4298
translate brazil lilyannepause_f86b6f24:

#   mc "...!!!"
    mc "...!!!"

# game/ep6.rpy:4301
translate brazil lilyannepause_504ff118:

#   e "{i}Don't ever blame yourself. Knowing that you came back for me is enough."
    e "{i}Nunca se culpe. Saber que você voltou por mim já é o suficiente."

