#   mc "Well, don't be sad now! It's your birthday, isn't it?"
    mc "Bem, não fique triste agora! É o seu aniversário, não é?"

# game/ep6.rpy:48
translate brazil ep6_8612b981:

#   mc "Just keep on smiling! Haha!"
    mc "Continue sorrindo! Haha!"

# game/ep6.rpy:49
