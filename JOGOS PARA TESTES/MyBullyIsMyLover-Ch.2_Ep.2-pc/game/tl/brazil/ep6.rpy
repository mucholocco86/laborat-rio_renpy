#   cl "Don't start."
    cl "Não comece."

# game/ep6.rpy:5537
translate brazil emmapause3_d7f45292:

#   gl "By the way, who are those two? I've never seen them before."
    gl "A propósito, quem são esses dois? Nunca os vi antes."

