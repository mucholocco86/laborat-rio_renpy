translate brazil ep6_6bb48998:

#   mc "Like... everyone would celebrate theirs. I thought yours was outside of the school year."
    mc "Tipo... todo mundo comemoraria o seu. Eu pensei que o seu fosse fora do período letivo."

# game/ep6.rpy:39
translate brazil ep6_cb4e5ae9:

