#   mc "Ah, jeez... Just... Nevermind..."
    mc "Ah, puxa... Deixa pra lá..."

# game/ep6.rpy:1163
translate brazil naomipause2_839c8ff8:

#   mc "Well... I won't force you if you really don't want to."
    mc "Bem... eu não vou te forçar se você realmente não quiser."

# game/ep6.rpy:1173
