translate brazil emmapause3_3a5c2de3:

#   gl "I'm glad to meet you, my name is Glenn."
    gl "Prazer em conhecê-lo(a), meu nome é Glenn."

# game/ep6.rpy:5573
translate brazil emmapause3_1f0756ef:

#   gl "Let's forget about the handshake for now. I don't tend to do it with unfinished business."
    gl "Vamos esquecer o aperto de mãos por enquanto. Não costumo fazê-lo quando tenho assuntos pendentes."

# game/ep6.rpy:5574
translate brazil emmapause3_0e688d5a:

#   k "No worries. Glad to meet you too, Glenn. My name is Klara."
    k "Sem problemas. Prazer em conhecê-lo também, Glenn. Meu nome é Klara."

