    # k "¡Mmmnn! ¡No... me beses! Huelo como una... vieja apestosa que se baña en alcohol..."
    k "{font=tl/chinese/font/adeb.ttf}¡Mmmnn! ¡No... me beses! Huelo como una... vieja apestosa que se baña en alcohol...{/font}"

# game/ch1ep2.rpy:3568
translate chinese klaradrunkshow_70441779:

    # mc "... Tu forma de hablar ciertamente se vuelve colorida cuando estás borracha."
    mc "{font=tl/chinese/font/adeb.ttf}……Tu forma de hablar ciertamente se vuelve colorida cuando estás borracha.{/font}"

# game/ch1ep2.rpy:3571
