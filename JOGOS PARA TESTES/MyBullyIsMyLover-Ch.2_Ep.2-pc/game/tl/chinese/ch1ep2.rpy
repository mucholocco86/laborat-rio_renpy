    # m "By the way, do you know someone named Maya from your squad?"
    m "对了，你们的小队里有叫玛雅的人吗？"

# game/ch1ep2.rpy:678
translate chinese ch1ep2_9b59f22d:

    # si "Maya?"
    si "玛雅？"

# game/ch1ep2.rpy:679
translate chinese ch1ep2_1c9a97de:

    # eg "Nope, never heard of that name before."
    eg "没有，从来没听过这个名字。"

# game/ch1ep2.rpy:682
translate chinese ch1ep2_c94fb190:

    # m "...{w=0.8}{nw}"
    m "……{w=0.8}{nw}"

# game/ch1ep2.rpy:696
translate chinese ch1ep2_079b76ec_1:

    # m "Six!"
    m "六号！"

# game/ch1ep2.rpy:697
translate chinese ch1ep2_f987885a:

    # eg "No! Don’t fucking move! They're using her as bait!"
    eg "不要！千万别动！他们在拿她当诱饵！"

# game/ch1ep2.rpy:698
translate chinese ch1ep2_652a91ba:

    # m "But!"
    m "可是！"

# game/ch1ep2.rpy:704
translate chinese ch1ep2_4766dfa7:

    # si "{cps=20}H-huh...?{w} Why can't I...{w} feel my leg?"
    si "{cps=20}啊-啊……？{w}我为什么……{w}感觉不到我的腿了？"

# game/ch1ep2.rpy:711
translate chinese ch1ep2_7c3f1ef1:

    # si "{cps=20}What... What happened...?"
    si "{cps=20}发生……发生什么了……？"

# game/ch1ep2.rpy:718
translate chinese ch1ep2_e9477767:

    # si "{cps=20}Four...?{w} Eight...?"
    si "{cps=20}四号……？{w}八号……？"

# game/ch1ep2.rpy:719
translate chinese ch1ep2_e5878a72:

    # si "{cps=20}H-help...{w} my leg...{w} I can't..."
    si "{cps=20}救-救我……{w}我的腿……{w}我没法……"

# game/ch1ep2.rpy:720
translate chinese ch1ep2_f948de14:

    # eg "Throw a smoke, Four! I'll drag her out of there!"
    eg "扔个烟雾弹，四号！我把她拖过来！"

# game/ch1ep2.rpy:721
translate chinese ch1ep2_2a9ed9e7:

    # m "I... I don't have any!"
    m "我……我没有啊！"

# game/ch1ep2.rpy:722
translate chinese ch1ep2_f75d7a6b:

    # eg "Urh, damn it!"
    eg "操！"

# game/ch1ep2.rpy:725
translate chinese ch1ep2_1d9b07c4:

    # m "C-crawl towards us, Six! Hurry!"
    m "爬-爬过来，六号！快点！"

# game/ch1ep2.rpy:726
translate chinese ch1ep2_2aae3493:

    # si "{cps=20}Crawl...?{w} I..."
    si "{cps=20}爬……？{w}我……"

# game/ch1ep2.rpy:727
translate chinese ch1ep2_9a56d01c:

    # m "Hurry, Six! Hurry!"
    m "快点啊，六号！快点！"

# game/ch1ep2.rpy:728
translate chinese ch1ep2_35bfd310:

    # eg "Keep your fucking head down, Four!"
    eg "你他妈把头低着，四号！"

# game/ch1ep2.rpy:731
translate chinese ch1ep2_765b7928:

    # si "{cps=20}Am I...{w} going to..."
    si "{cps=20}我是不是……{w}要……"

# game/ch1ep2.rpy:733
translate chinese ch1ep2_c67d7bda:

    # m "You are not!"
    m "才不是！"

# game/ch1ep2.rpy:735
translate chinese ch1ep2_0a2f97ef:

    # m "Come on, reach my hand!"
    m "加油啊，抓住我的手！"

# game/ch1ep2.rpy:825
translate chinese ch1ep2_f4bbaf84:

    # si "{cps=15}I... I don't want to die...{w=0.8}{nw}" with Dissolve(1.0)
    si "{cps=15}我……我不想死……{w=0.8}{nw}" with Dissolve(1.0)

# game/ch1ep2.rpy:827
translate chinese ch1ep2_bb8a3735:

    # m "Si-{w=0.4}{nw}"
    m "六——{w=0.4}{nw}"

# game/ch1ep2.rpy:832
translate chinese ch1ep2_ba54fbbb:

    # m "*screaming in anguish*"
    m "*痛苦地尖叫*"

# game/ch1ep2.rpy:859
translate chinese ch1ep2_f0139694:

    # m "Ah..."
    m "啊……"

# game/ch1ep2.rpy:862
translate chinese ch1ep2_e612037c_1:

    # m "..."
    m "……"

# game/ch1ep2.rpy:863
translate chinese ch1ep2_6c26d86e:

    # m "... Where are you?"
    m "……你在哪？"

# game/ch1ep2.rpy:873
translate chinese ch1ep2_5c9f994a:

    # mc "What are you doing? You'll get sick."
    mc "你在干嘛？会生病的。"

# game/ch1ep2.rpy:874
translate chinese ch1ep2_55a55daf:

    # m "... 'Sup."
    m "……你好啊。"

# game/ch1ep2.rpy:877
translate chinese ch1ep2_aa1f24d6:

    # gu "[mc], the rain's pouring harder! You should take shelter inside for now!"
    gu "[mc!t]，雨又变大了！你们进去躲一会吧！"

# game/ch1ep2.rpy:880
translate chinese ch1ep2_ecf61e0e:

    # mc "Come on."
    mc "走吧。"

# game/ch1ep2.rpy:883
translate chinese ch1ep2_5310044d:

    # m "Did you walk all the way here?"
    m "你一路走过来的吗？"

# game/ch1ep2.rpy:884
translate chinese ch1ep2_8ec7dbb7:

    # mc "Well, I could have, but it would not be that convenient, especially at this hour."
    mc "倒是可以，不过那就太不方便了，特别是这种情况。"

# game/ch1ep2.rpy:885
translate chinese ch1ep2_b85c63e0:

    # mc "The truck is in the parking lot. I went through the other side. I thought you would be there since most students use that entrance."
    mc "卡车在停车场里呢。我从另一边过来的。我还以为你在那边，因为大部分的学生都会走那个门。"

# game/ch1ep2.rpy:886
