    jud "*喘气* 你到底跑到哪去了？我找你都找了5个小时了！"

# game/ch1ep2.rpy:3827
translate chinese klaradrunkshow_3fc2a697:

    # mc "Five hours?!"
    mc "五个小时？！"

# game/ch1ep2.rpy:3828
translate chinese klaradrunkshow_1fb86495:

    # mc "So you were lost for five hours?!"
    mc "你迷路迷了五个小时？！"

# game/ch1ep2.rpy:3829
