    mc "嗯？"

# game/ch1ep2.rpy:3523
translate chinese klaradrunkshow_8888c7d7:

    # k "Can you... remove my stockings, please, [mc]...? I don't think I'll be able to right now."
    k "你能……帮我脱掉丝袜吗，[mc!t]……？我现在的样子估计是没法脱了。"

# game/ch1ep2.rpy:3524
translate chinese klaradrunkshow_cfce055e:

    # mc "Are you sure?"
    mc "你确定吗？"

# game/ch1ep2.rpy:3525
translate chinese klaradrunkshow_014e717e:

    # k "Just... don't touch anything down there."
    k "只要……别碰其他地方就行。"

