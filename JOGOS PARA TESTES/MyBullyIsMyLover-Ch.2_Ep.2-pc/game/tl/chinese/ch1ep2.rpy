# game/ch1ep2.rpy:3557
translate chinese klaradrunkshow_90c267c1:

    # yt "The alcohol seems to be making her forget I'm her [tenant]."
    yt "酒精似乎让她忘了我是她[tenant!t]。"

# game/ch1ep2.rpy:3558
translate chinese klaradrunkshow_85f6ad1a:

    # k "Anyway, that's enough excitement for one night... Off to bed with you..."
    k "好了，今晚就玩到这里吧……你去睡觉吧……"

# game/ch1ep2.rpy:3564
translate chinese klaradrunkshow_031bf618:

    # mc "Alright. Goodnight, [landlady]."
