    # mc "There is still a guard on patrol!"
    mc "还有门卫巡逻呢！"

# game/ep4.rpy:89
translate chinese ep4_a1af9d2d:

    # g "Oh, the guard? Don't worry about him."
    g "门卫？不用管他。"

# game/ep4.rpy:90
