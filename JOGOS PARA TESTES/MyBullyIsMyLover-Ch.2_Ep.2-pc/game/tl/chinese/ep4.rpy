    # gu "Hey there, you two!"
    gu "你们两个！站住！"

# game/ep4.rpy:111
translate chinese ep4_b02650a0:

    # mc "Eek!!"
    mc "完了！"

# game/ep4.rpy:112
translate chinese ep4_438635e4:

    # yt "Uh-oh... We're done for! It's just my second day here! Awww~!"
    yt "糟糕……搞砸了！我才刚来第二天！啊啊啊~！"

# game/ep4.rpy:115
translate chinese ep4_5055624c:

    # gu "What do you think you're doing?! It's almost-"
    gu "你们在这干什么？！都已经——"

