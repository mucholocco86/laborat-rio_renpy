translate chinese ep4_3e88f91c:

    # gu "Oh, young lady?"
    gu "噢，小姐？"

# game/ep4.rpy:119
translate chinese ep4_7d2c4194:

    # yt "Young lady?!"
    yt "小姐？！"

# game/ep4.rpy:122
translate chinese ep4_93f467b5:

    # gu "Ahh-uhh... Your father would be disappointed if he learned that you still keep doing this. You brought someone else with you this time, too."
    gu "嗯……您父亲要是知道您还在这么干，肯定会伤心的。这次您还带了个人一起。"

# game/ep4.rpy:123
translate chinese ep4_4c3c54b7:

    # g "*slap* *slap* Ah hahaa! Oh, come on, Johnny~! I know you won't tell dad, right? Right?"
    g "啊哈哈哈哈！得了吧，强尼~！我知道你不会跟我爸说的，对吧？对吧？"

# game/ep4.rpy:124
translate chinese ep4_d41f3bf7:

    # mc "Ehh?"
    mc "啊？"

# game/ep4.rpy:125
translate chinese ep4_7c225220:

    # g "*giggles*"
    g "*笑*"

# game/ep4.rpy:128
translate chinese ep4_5eb036c4:

    # gu "Of course, young lady. You have my full loyalty. But it's not me or your father that you need to worry about. It's the disciplinary committee."
    gu "当然，小姐。我完全听命于您。但您该操心的不是我或者您父亲，而是学校的纪律委员会。"

# game/ep4.rpy:129
translate chinese ep4_acc19021:

    # gu "If they catch you, it's way beyond my power to help you anymore. I'm just a guard here, after all."
    gu "要是被他们抓到了，我是没有能力帮您的。毕竟我只是个普通的门卫。"

# game/ep4.rpy:130
translate chinese ep4_69ce630e:

    # mc "Ehhhh?!"
    mc "啊~~~？！"

