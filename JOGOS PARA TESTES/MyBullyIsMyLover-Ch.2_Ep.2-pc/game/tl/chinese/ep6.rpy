translate chinese naomipause2_2a0aef07:

    # un "You're not supposed to tell me that when you're actually the same."
    un "你其实跟我一样，所以没资格说我。"

# game/ep6.rpy:1822
translate chinese naomipause2_5a44df99:

    # un "I need to go. Remember what I told you."
    un "我该走了。要牢记我跟你说过的话。"

