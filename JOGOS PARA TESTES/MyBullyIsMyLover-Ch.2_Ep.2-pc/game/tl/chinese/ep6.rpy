    # un "......"
    un "......"

# game/ep6.rpy:1807
translate chinese naomipause2_d8bde25f:

    # un "Such as they are to me. I'm not worthy of being one of them any longer."
    un "我没有那个资格。我再也不配成为他们中的一员了。"

