    # a "Take it."
    a "给你。"

# game/ch1ep1.rpy:4557
translate chinese freyatitplay_a64e8bc0:

    # mc "Thanks."
    mc "谢谢。"

# game/ch1ep1.rpy:4558
translate chinese freyatitplay_b7250713:

    # a "*smiles* You're welcome."
    a "*微笑* 不客气。"

# game/ch1ep1.rpy:4559
translate chinese freyatitplay_d2e0d04d:

    # a "Can I sit with you for a minute?"
    a "我能坐在你旁边吗？"

# game/ch1ep1.rpy:4560
translate chinese freyatitplay_dfee274a:

    # mc "Uhm... Yeah, sure..."
    mc "呃……好啊，当然可以……"

# game/ch1ep1.rpy:4563
translate chinese freyatitplay_ce8826d3:

    # a "{i}Ahh... These heels are a pain. Why did I even choose to wear these?"
    a "{i}啊……这高跟鞋穿着真不舒服。我干嘛要穿高跟鞋出来？"

# game/ch1ep1.rpy:4566
translate chinese freyatitplay_3b21f354_5:

    # mc "......"
    mc "……"

# game/ch1ep1.rpy:4569
translate chinese freyatitplay_32fb53c2:

    # a "Hm?"
    a "嗯？"

# game/ch1ep1.rpy:4570
translate chinese freyatitplay_0e8ee204:

    # mc "I... I did not see anything, alright?"
    mc "我……我什么也没看见！"

# game/ch1ep1.rpy:4571
translate chinese freyatitplay_68886d93:

    # a "Uhh... What do you mean?"
    a "呃……什么意思？"

# game/ch1ep1.rpy:4572
translate chinese freyatitplay_754a4d6e:

    # mc "Nothing!"
    mc "没事！"

# game/ch1ep1.rpy:4575
translate chinese freyatitplay_3b21f354_6:

    # mc "......"
    mc "……"

# game/ch1ep1.rpy:4576
translate chinese freyatitplay_da0f4999:

    # mc "Do your feet hurt?"
    mc "你的脚很疼吗？"

# game/ch1ep1.rpy:4577
translate chinese freyatitplay_8f5931b7:

    # a "A bit. I shouldn't have worn these."
    a "有点。我不该穿高跟鞋的。"

# game/ch1ep1.rpy:4578
translate chinese freyatitplay_4142d554:

    # mc "Then why did you wear them?"
    mc "那你为什么要穿？"

# game/ch1ep1.rpy:4579
translate chinese freyatitplay_9439bdd4:

    # a "Hmm... Aren't you asking too many questions for a stranger?"
    a "嗯……你对着一个陌生人问太多问题了吧？"

# game/ch1ep1.rpy:4582
translate chinese freyatitplay_205f9af2:

    # mc "Well, what's your name?"
    mc "你叫什么名字？"

# game/ch1ep1.rpy:4583
translate chinese freyatitplay_f84cedb8:

    # a "Aine..."
    a "艾妮……"

# game/ch1ep1.rpy:4584
translate chinese freyatitplay_47c37a7b:

    # a "Oof! I should've just worn my sneakers instead!"
    a "唉！应该穿运动鞋出来的！"

# game/ch1ep1.rpy:4585
translate chinese freyatitplay_b3c558a0:

    # mc "My name is [mc]. Nice to meet you, Aine! There you have it; we're acquaintances!"
    mc "我叫[mc!t]。很高兴认识你，艾妮！我们互相认识过了；那现在就算是朋友了！"

# game/ch1ep1.rpy:4588
translate chinese freyatitplay_732a8756_6:

    # a "......"
    a "……"

# game/ch1ep1.rpy:4589
translate chinese freyatitplay_0231d991:

    # a "{i}I can't do this with him. I'll probably just go home."
    a "{i}我不忍心害他。还是回家吧。"

# game/ch1ep1.rpy:4590
translate chinese freyatitplay_87c70280:

    # a "{i}If he comes here every day, then I'll have another chance tomorrow."
    a "{i}如果他每天都来，那我明天还有机会。"

# game/ch1ep1.rpy:4591
translate chinese freyatitplay_024d1c2a:

    # mc "Were you going somewhere?"
    mc "你要去哪？"

# game/ch1ep1.rpy:4592
translate chinese freyatitplay_1d7b1f23:

    # a "{i}Urrhh... What's with these questions~?!"
    a "{i}他哪来这么多问题~？！"

# game/ch1ep1.rpy:4595
translate chinese freyatitplay_87ce3826:

    # a "Well... I just finished a visit with a relative. I was on my way home when I saw you."
    a "嗯……我刚看完一个亲戚。在回家的路上看到你了。"

# game/ch1ep1.rpy:4596
translate chinese freyatitplay_9ca88cc3:

    # a "{i}That was such a shallow reason to make up!"
    a "{i}我这理由编得真蹩脚！"

# game/ch1ep1.rpy:4597
translate chinese freyatitplay_3494cc4b:

    # mc "Oh, I see..."
    mc "哦，这样啊……"

# game/ch1ep1.rpy:4598
translate chinese freyatitplay_1ff20ad0:

    # mc "Anyway, I have my own, but thanks for the hanky."
    mc "总之，我自己也有，不过谢谢你的手帕。"

# game/ch1ep1.rpy:4602
translate chinese freyatitplay_57cef55a:

    # a "Then why aren't you using it~! You were crying, weren't you?!"
    a "那你为什么不用啊~！你不是在哭吗？！"

# game/ch1ep1.rpy:4603
translate chinese freyatitplay_2fe56ce9:

    # mc "Boy, that was loud as heck..."
    mc "你这吼的声音可真大……"

# game/ch1ep1.rpy:4606
translate chinese freyatitplay_0ac4657a:

    # a "*gasps*"
    a "*惊讶*"

# game/ch1ep1.rpy:4609
translate chinese freyatitplay_b8aeeba6:

    # a "I'm s-sorry."
    a "对-对不起。"

# game/ch1ep1.rpy:4610
translate chinese freyatitplay_5b30d955:

    # mc "So you're the type to speak your mind when your irritation meter reaches a hundred percent, huh? That was quick, too."
    mc "所以你是那种在被烦够了之后会大声把内心的想法说出来的类型啊。而且你也很容易就会被人烦到。"

# game/ch1ep1.rpy:4612
translate chinese freyatitplay_8ac8ea9f:

    # a "Eek!"
    a "我……！"

# game/ch1ep1.rpy:4615
translate chinese freyatitplay_c9392117:

    # a "I-I'm going home now!"
    a "我-我回家了！"

# game/ch1ep1.rpy:4616
translate chinese freyatitplay_c0e5d7d1:

    # mc "H-hey, can I maybe ask for your phone number?"
    mc "等-等等，你……能把你的电话号码告诉我吗？"

# game/ch1ep1.rpy:4619
translate chinese freyatitplay_09db9eaf_1:

    # a "Huh?"
    a "啊？"

# game/ch1ep1.rpy:4620
translate chinese freyatitplay_8335f839:

    # a "My phone number?"
    a "我的号码？"

# game/ch1ep1.rpy:4623
translate chinese freyatitplay_5fc7411d:

    # mc "Uhm... Yup! If it's alright. You don't have to if it's too much."
    mc "呃……对啊！如果你不介意的话。要是觉得太过分了，就算了吧。"

# game/ch1ep1.rpy:4624
translate chinese freyatitplay_76c4395b:

    # a "Well..."
    a "嗯……"

# game/ch1ep1.rpy:4627
translate chinese freyatitplay_9951e9f6:

    # a "{i}There it is... Asking for my phone number whenever they see me for the first time. He's just the same as mother's past targets..."
    a "{i}果然……第一次见到我，就立马想要我的号码。他就跟妈妈过去的目标一样……"

# game/ch1ep1.rpy:4628
translate chinese freyatitplay_81b4c36b:

    # a "{i}The only difference is..."
    a "{i}唯一的区别是……"

# game/ch1ep1.rpy:4629
translate chinese freyatitplay_9277f5d5:

    # a "{i}My reaction towards him was genuine..."
    a "{i}我对他的反应不是刻意装出来的……"

# game/ch1ep1.rpy:4630
translate chinese freyatitplay_65a20f71:

    # a "{i}For a moment, I forgot about mother's plan..."
    a "{i}刚才有一瞬间，我甚至忘记了妈妈的计划……"

# game/ch1ep1.rpy:4632
translate chinese freyatitplay_ccfb4f3f:

    # a "{i}But he irritates me fast~! I won't be able to stand him if he's going to be like this!"
    a "{i}但他特别烦人~！他要一直这样，我肯定受不了他！"

# game/ch1ep1.rpy:4635
translate chinese freyatitplay_732a8756_7:

    # a "......"
    a "……"

# game/ch1ep1.rpy:4638
translate chinese freyatitplay_5fa596c5:

    # a "{i}Although, he's kinda cute, getting shy and all. *giggles*"
    a "{i}不过，他倒挺可爱的，很容易就害羞了之类的。 *笑*"

# game/ch1ep1.rpy:4641
translate chinese freyatitplay_84c7fa01:

    # a "Alright~! You can have my number!"
    a "好吧~！我把号码给你！"

# game/ch1ep1.rpy:4642
translate chinese freyatitplay_fe13b30d_1:

    # mc "Really?!"
    mc "真的吗？！"

# game/ch1ep1.rpy:4643
translate chinese freyatitplay_e62181bb:

    # a "Mhm!"
    a "嗯！"

# game/ch1ep1.rpy:4644
translate chinese freyatitplay_9afccb82:

    # a "{i}Somehow... Even though slightly, this is the first time I could genuinely give my phone number away..."
    a "{i}不知道为什么……哪怕只有一点点，这也是我第一次心甘情愿地把我的号码告诉别人……"

# game/ch1ep1.rpy:4653
translate chinese freyatitplay_e5590e42:

    # a "(Hmmm... Why were you in that park all alone anyway? Then the weird thing is, you were crying.)"
    a "（嗯……你为什么要一个人坐在公园里呢？更奇怪的是，还在哭。）"

# game/ch1ep1.rpy:4654
translate chinese freyatitplay_9c9df4dd:

    # mc "(Did I really look that weird?)"
    mc "（我看着真有那么怪吗？）"

# game/ch1ep1.rpy:4655
translate chinese freyatitplay_d81c24b9:

    # a "(Yeah.)"
    a "（是啊。）"

# game/ch1ep1.rpy:4656
translate chinese freyatitplay_6b0717a1:

    # mc "(Well, I came back for a girl that I can't even remember any more. Her face, her name, everything.)"
    mc "（我是为了一个我根本都不记得的女孩回来的。她的脸，她的名字，她的一切，我全都忘了。）"

# game/ch1ep1.rpy:4659
translate chinese freyatitplay_ddc14bdc:

    # a "{i}Why would he come back for someone he can't remember? He really is weird!"
    a "{i}他为什么要为了一个已经不记得的人回来？真是个怪人！"

# game/ch1ep1.rpy:4660
translate chinese freyatitplay_53aee0fe:

    # mc "(I keep coming to Central Park for months hoping I could somehow see her there, but I'm already losing hope.)"
    mc "（我连着几个月，每天都去中央公园，希望能碰到她，但我已经开始失去希望了。）"

# game/ch1ep1.rpy:4661
translate chinese freyatitplay_167edda9:

    # a "(Then why not go to her house instead? How will you be able to recognize her if you can't even remember what she looked like?)"
    a "（为什么不直接去她家看看呢？你都已经不记得她的样子了，还怎么能认出来她呢？）"

# game/ch1ep1.rpy:4662
translate chinese freyatitplay_3ee0578d:

    # mc "(I did, but she's... No longer there...)"
    mc "（我去看过了，但是她……已经不在那里了……）"

# game/ch1ep1.rpy:4663
translate chinese freyatitplay_29a2c9d9:

    # a "(Oh... I'm sorry to hear that.)"
    a "（哦……我很抱歉。）"

# game/ch1ep1.rpy:4664
translate chinese freyatitplay_9ceafd83:

    # a "(Was she your girlfriend or something?)"
    a "（她是你的女朋友吗？）"

# game/ch1ep1.rpy:4665
translate chinese freyatitplay_71fa127c:

    # mc "(Hm, not really. But I made a promise that I would come back, though it seems that I'm already too late.)"
    mc "（嗯，不算是。不过我许下过承诺，一定会回来的。可是现在看来，我回来得太迟了。）"

# game/ch1ep1.rpy:4666
translate chinese freyatitplay_366ce256:

    # a "(When was the last time you saw her?)"
    a "（你最后一次见她是在什么时候？）"

# game/ch1ep1.rpy:4667
translate chinese freyatitplay_4893ed03:

    # mc "(Now you're the one asking too many questions.)"
    mc "（现在是你一直在问问题了。）"

# game/ch1ep1.rpy:4668
translate chinese freyatitplay_732a8756_8:

    # a "......"
    a "……"

# game/ch1ep1.rpy:4671
translate chinese freyatitplay_50538228:

    # a "(Wait, how did you know what I was thinking earlier?!)"
    a "（等等，你怎么知道我之前在想什么？！）"

# game/ch1ep1.rpy:4672
translate chinese freyatitplay_ef4d2c5e:

    # mc "(That's because I intentionally annoyed you to find your patience level. You sure have a short fuse, huh?)"
    mc "（因为我是故意气你，想知道你的耐心程度。你还真是一点就着啊。）"

# game/ch1ep1.rpy:4673
translate chinese freyatitplay_2ebb216f:

    # a "(Why would you do that to a girl you just met?!)"
    a "（你怎么会对刚见面的女生做这种事啊？！）"

# game/ch1ep1.rpy:4674
translate chinese freyatitplay_1a93a3ca:

    # mc "(That's my way of gauging a person. Because I know I could naturally come across as irritating to some.)"
    mc "（这就是我看人的方式。因为我知道我很容易就会让别人觉得烦。）"

# game/ch1ep1.rpy:4675
translate chinese freyatitplay_0c96d0c2:

    # mc "(You handled me pretty well, though. Congrats!)"
    mc "（不过你倒挺会对付我的。恭喜你！）"

# game/ch1ep1.rpy:4676
translate chinese freyatitplay_59dadb36:

    # a "(You are weird! Just so weird!)"
    a "（你可真怪！太怪了！）"

# game/ch1ep1.rpy:4677
translate chinese freyatitplay_7d868e53:

    # mc "(Well, that's what I am. You can stop talking to me if you find me too much.)"
    mc "（我就是这种人。你要是觉得受不了，不跟我说话就好了。）"

# game/ch1ep1.rpy:4680
translate chinese freyatitplay_468224e7:

    # a "{i}But I can't~! That's the thing!"
    a "{i}但是我必须跟你说话~！这才是关键！"

# game/ch1ep1.rpy:4683
translate chinese freyatitplay_c5b46259:

    # mc "(Anyway, the last time we saw each other was probably... ten years ago, about eleven, now.)"
    mc "（总之，我们最后一次见面估计是……十年前了，现在都快有十一年了。）"

# game/ch1ep1.rpy:4684
translate chinese freyatitplay_40034953:

    # a "(Whoa! Are you serious?)"
    a "（哇！真的吗？）"

# game/ch1ep1.rpy:4685
translate chinese freyatitplay_3e5d7c7a:

    # mc "(Yeah. It was a bit hard to communicate at that time, so we didn't get to talk to each other after the day I moved overseas.)"
    mc "（是啊。以前互相交流没那么方便，所以在我出国之后，我们就一句话都没有再说过了。）"

# game/ch1ep1.rpy:4686
translate chinese freyatitplay_014fe47a:

    # a "(Wait, overseas?!)"
    a "（出国？！）"

# game/ch1ep1.rpy:4687
translate chinese freyatitplay_d744b572:

    # mc "(Yup!)"
    mc "（是的！）"

# game/ch1ep1.rpy:4690
translate chinese freyatitplay_bc26c41a:

    # a "(I see, then that totally makes sense now. Did you study there too?)"
    a "（我明白了，那一切就都说得通了。你也在国外上的学吗？）"

# game/ch1ep1.rpy:4691
translate chinese freyatitplay_01e6dc9d:

    # mc "(Yeah. It was hard to communicate with my classmates at first because they have a different language there.)"
    mc "（是的。刚开始语言不通，跟同学们交流非常困难。）"

# game/ch1ep1.rpy:4692
translate chinese freyatitplay_347b78e8:

    # mc "(But I eventually understood and learned the language.)"
    mc "（但后来我也学会他们的语言了。）"

# game/ch1ep1.rpy:4693
translate chinese freyatitplay_3e71e7fe:

    # mc "(They were all friendly towards me, so I didn't have that much trouble.)"
    mc "（他们都对我很友好，所以我没遇上什么麻烦。）"

# game/ch1ep1.rpy:4694
translate chinese freyatitplay_a80db9e2:

    # a "(You're lucky. I did not have many friends growing up.)"
    a "（你很幸运。我这些年来没有多少朋友。）"

# game/ch1ep1.rpy:4695
translate chinese freyatitplay_107735c4:

    # mc "(Huh? Why?)"
    mc "（啊？为什么？）"

# game/ch1ep1.rpy:4696
translate chinese freyatitplay_902b0561:

    # a "(I was homeschooled up until middle school.)"
    a "（我在上中学之前，都是在家里上课的。）"

# game/ch1ep1.rpy:4697
translate chinese freyatitplay_49b96fd5:

    # mc "(Isn't that kinda special? Why do you sound like you don't like it?)"
    mc "（这不是挺特别的吗？怎么感觉你很不喜欢一样？）"

# game/ch1ep1.rpy:4698
translate chinese freyatitplay_5403698f:

    # a "(Oh, you have no idea...)"
    a "（你根本不懂……）"

# game/ch1ep1.rpy:4699
translate chinese freyatitplay_aa77c0dd:

    # mc "(Can I ask about it?)"
    mc "（那你讲讲呗？）"

# game/ch1ep1.rpy:4702
translate chinese freyatitplay_81629b94:

    # a "(No, you can't!)"
    a "（我不想讲！）"

# game/ch1ep1.rpy:4703
translate chinese freyatitplay_1515dcdb:

    # mc "(Bummer...)"
    mc "（没劲……）"

# game/ch1ep1.rpy:4706
translate chinese freyatitplay_2c213207:

    # a "(Your name is [mc], was it?)"
    a "（你的名字是叫[mc!t]吗？）"

# game/ch1ep1.rpy:4707
translate chinese freyatitplay_bb1b36a5:

    # mc "(Uhm... yeah? I told you earlier. Did you just forget it?!)"
    mc "（呃……对啊？我之前告诉过你了。你已经忘了？！）"

# game/ch1ep1.rpy:4710
translate chinese freyatitplay_9754fb5d:

    # a "(Because you were irritating me so much that I almost missed it! It came out of nowhere, too!)"
    a "（因为你快把我烦死了，我都没注意听！）"

# game/ch1ep1.rpy:4711
translate chinese freyatitplay_03802b5f:

    # mc "(This is surely the most fun I've had trying to annoy someone. Hahaha!)"
    mc "（这次是我烦人烦得最开心的一次。哈哈哈！）"

# game/ch1ep1.rpy:4712
translate chinese freyatitplay_977c117d:

    # a "(Well then, stop~!)"
    a "（别再烦我了~！）"

# game/ch1ep1.rpy:4713
translate chinese freyatitplay_c28d89e3:

    # mc "(Why stop if it's fun?)"
    mc "（既然很开心，为什么要停下？）"

# game/ch1ep1.rpy:4714
translate chinese freyatitplay_4624c014:

    # mc "(No, you are fun!)"
    mc "（不，应该说你让我很开心！）"

# game/ch1ep1.rpy:4715
translate chinese freyatitplay_c0813adc:

    # a "(I am not your entertainment!)"
    a "（我不是用来给你找乐子的！）"

# game/ch1ep1.rpy:4716
translate chinese freyatitplay_b332ad8a:

    # a "{i}Urrh... I better change the topic before I blow up again!"
    a "{i}唉……最好趁我再发火之前换个话题！"

# game/ch1ep1.rpy:4719
translate chinese freyatitplay_a864b6ee:

    # a "(Let's just change the topic, okay?!)"
    a "（我们就换个话题吧，行不行？！）"

# game/ch1ep1.rpy:4720
translate chinese freyatitplay_951b5613:

    # mc "(Alright, if you say so...)"
    mc "（好吧，听你的……）"

# game/ch1ep1.rpy:4721
translate chinese freyatitplay_0b180778:

    # a "(Since you mentioned that you came back, then are you transferring schools, too?)"
    a "（既然你已经回来了，那是不是也要在这里上学呢？）"

# game/ch1ep1.rpy:4722
translate chinese freyatitplay_020ac0a8:

    # mc "(Yep! Drealerra Academy. I'm spending my last year in high school there.)"
    mc "（是的！德列拉学院。我会在那里上高中最后一年。）"

# game/ch1ep1.rpy:4725
translate chinese freyatitplay_418e1b2e:

    # a "(For real?!)"
    a "（真的吗？！）"

# game/ch1ep1.rpy:4726
translate chinese freyatitplay_107735c4_1:

    # mc "(Huh? Why?)"
    mc "（啊？怎么了？）"

# game/ch1ep1.rpy:4727
translate chinese freyatitplay_60fbb596:

    # a "(I study there too!)"
    a "（我也在那上学！）"

# game/ch1ep1.rpy:4728
translate chinese freyatitplay_f7ed26c1:

    # mc "(In your last year as well?)"
    mc "（你也是最后一年？）"

# game/ch1ep1.rpy:4729
translate chinese freyatitplay_c9d982dd:

    # a "(Yeah!)"
    a "（是啊！）"

# game/ch1ep1.rpy:4730
