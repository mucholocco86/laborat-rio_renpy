# game/ch1ep1.rpy:2022
translate chinese skypause2_a2352927:

    # mc "Oh, really..."
    mc "真的啊……"

# game/ch1ep1.rpy:2025
translate chinese skypause2_1dde0411:

    # f "Hey, Emma-chan, Gwenny, Moon~! I'm doing a live stream. Come and join us!"
    f "嘿，艾玛酱，格温温，还有月~！我在直播呢。过来一起呀！"

# game/ch1ep1.rpy:2027
translate chinese skypause2_7a18710b:

    # yt "Don't think I forgot about that time, though..."
    yt "你可别以为我忘了那次的事……"

# game/ch1ep1.rpy:2028
translate chinese skypause2_7874d0b1:

    # yt "Now is the perfect moment to unleash my inner evil!"
    yt "现在是我释放内心邪恶的最好机会！"

# game/ch1ep1.rpy:2031
translate chinese skypause2_dc4dd60f:

    # yt "Nah... I'd better leave her be. I don't want to get into trouble."
    yt "算了……还是别理她了。我可不想惹上麻烦。"

# game/ch1ep1.rpy:2033
translate chinese skypause2_55b74679:

    # yt "Alright, here goes nothing!"
    yt "好，试试也不损失什么！"

# game/ch1ep1.rpy:2038
translate chinese skypause2_663f07d3:

    # f "*softly moans* Ohhh~!"
    f "*轻轻呻吟* 啊~~！"

# game/ch1ep1.rpy:2043
translate chinese skypause2_d9984f2d:

    # f "*whispers* You... son of...!"
    f "*低语* 你……王八蛋……！"

# game/ch1ep1.rpy:2044
translate chinese skypause2_f841a4ff:

    # mc "*whispers* Now we're even. I'm your number one fan, after all."
    mc "*低语* 我们现在扯平了。毕竟我可是你的头号粉丝呢。"

# game/ch1ep1.rpy:2048
translate chinese skypause2_811bd663:

    # g "Hey, what's up?"
    g "哎，什么情况？"

# game/ch1ep1.rpy:2049
translate chinese skypause2_35bbe50b:

    # mc "She's doing a live-"
    mc "她正在直——"

# game/ch1ep1.rpy:2054
translate chinese skypause2_29a9aab1:

    # mc "Whoa~! What the... heck?"
    mc "我去~！搞……搞什么？"

# game/ch1ep1.rpy:2057
translate chinese skypause2_d650195c:

    # k "That's how it's done."
    k "就该这么教才对。"

# game/ch1ep1.rpy:2058
translate chinese skypause2_f2a35047:

    # mc "I literally spent the past fifteen minutes trying to teach her just to float, then you take over in ten seconds and get her swimming laps?"
    mc "我教了十五分钟都没教会她怎么飘，你刚教她十秒，她就已经会游了？"

# game/ch1ep1.rpy:2061
translate chinese skypause2_50e66e65:

    # k "There are times when you don't need to teach someone the technicalities, [mc]."
    k "有时候是没有必要教别人全部的技巧和细节的，[mc!t]。"

# game/ch1ep1.rpy:2062
translate chinese skypause2_a385d31f:

    # k "Just give them clues and let them do it on their own, especially at {b}your{/b} age."
    k "只要给他们一点提示，然后让他们靠自己摸索就好了，特别是对{b}你这种年纪{/b}的人来说更是这样。"

# game/ch1ep1.rpy:2063
translate chinese skypause2_99c326ff:

    # k "If you try to spoon-feed your student, they will quickly forget about the lessons they were taught."
    k "要是一点点教，他们很快就会忘掉已经学到的东西的。"

# game/ch1ep1.rpy:2064
translate chinese skypause2_f4f7a049:

    # k "Remember that and apply it to what you'll be doing from here on out."
    k "记住这点，以后做事的时候也要考虑到。"

# game/ch1ep1.rpy:2065
translate chinese skypause2_f7fdfbf1:

    # mc "Are you trying to point out that what you did to us was right?"
    mc "你是想说你对我们做的事是正确的吗？"

# game/ch1ep1.rpy:2066
translate chinese skypause2_36e583dd:

    # k "Exactly."
    k "没错。"

# game/ch1ep1.rpy:2067
translate chinese skypause2_d98fe8f6:

    # k "If you are going to quibble with me over that, feel free to do so."
    k "你要是想和我争的话，也是你的自由。"

# game/ch1ep1.rpy:2068
translate chinese skypause2_e776e858:

    # k "You're my [tenant], and I love you, but you will never change my mindset."
    k "你是我[tenant!t]，我爱你，但你永远没法改变我的想法。"

# game/ch1ep1.rpy:2072
translate chinese skypause2_d84e7c25:

    # k "That is my pride as your [landlady]."
    k "这是我作为你的[landlady!t]的尊严。"

# game/ch1ep1.rpy:2073
translate chinese skypause2_2badb1d0:

    # mc "Sheeeesh..."
    mc "行吧……"

# game/ch1ep1.rpy:2096
translate chinese klarapause3_93cedd3d:

    # "Thirty minutes later..."
    "半个小时后……"

# game/ch1ep1.rpy:2106
translate chinese klarapause3_b87592b5:

    # yt "I'm getting thirsty..."
    yt "我好渴……"

# game/ch1ep1.rpy:2107
translate chinese klarapause3_e773c119:

    # yt "I'll grab something to drink..."
    yt "去拿点喝的吧……"

# game/ch1ep1.rpy:2108
translate chinese klarapause3_0fba19b8:

    # e "Hm?"
    e "嗯？"

# game/ch1ep1.rpy:2111
translate chinese klarapause3_8864685a:

    # e "Are you going somewhere?"
    e "你要去哪里？"

# game/ch1ep1.rpy:2112
translate chinese klarapause3_22b9f941:

    # mc "I'm really thirsty, just going to get something to drink; I'll be back."
    mc "我很渴，要去拿点东西喝；很快就回来。"

# game/ch1ep1.rpy:2113
translate chinese klarapause3_9d2f2d12:

    # e "Alright."
    e "好的。"

# game/ch1ep1.rpy:2116
translate chinese klarapause3_0ce8b5b4:

    # yt "Let's see if they have something here. I want to save our booze for later."
    yt "看看他们这有没有什么东西吧。我想把我们带的酒留到后面再喝。"

# game/ch1ep1.rpy:2120
translate chinese klarapause3_42ae3cbd:

    # mc "Yow, Miss Security, slash Cashier, slash Receptionist!"
    mc "哟，保安兼收银员兼前台小姐！"

# game/ch1ep1.rpy:2123
translate chinese klarapause3_c556b909:

    # am "Hm?"
    am "嗯？"

# game/ch1ep1.rpy:2124
translate chinese klarapause3_da4a92f6:

    # mc "...Were you sleeping?"
    mc "……你睡着了？"

# game/ch1ep1.rpy:2127
translate chinese klarapause3_0ce17622:

    # am "Hello, [mc]. How may I help you?"
    am "你好，[mc!t]。有什么事吗？"

# game/ch1ep1.rpy:2128
translate chinese klarapause3_58dd3139:

    # mc "I'm looking for a drink. Do you guys, by any chance, have anything here?"
    mc "我在找东西喝。你们这里提供饮品吗？"

# game/ch1ep1.rpy:2129
translate chinese klarapause3_262835ea:

    # mc "Something alcoholic if possible?"
    mc "最好是含酒精的。"

# game/ch1ep1.rpy:2130
translate chinese klarapause3_d40f46e3:

    # am "We do. What would you like?"
    am "有的。你想要什么呢？"

# game/ch1ep1.rpy:2131
translate chinese klarapause3_8360cb22:

    # mc "Uhh... You don't have any menus, so... I guess I'll leave it up to you?"
    mc "呃……你们也没有个菜单什么的，所以……我要不就交给你选了？"

# game/ch1ep1.rpy:2132
translate chinese klarapause3_55aa558a:

    # am "Got it. I'll be back in five minutes."
    am "好的。我很快就回来。"

# game/ch1ep1.rpy:2140
translate chinese klarapause3_ec2f8c8b:

    # am "Here you go. Please enjoy!"
    am "给你。请用吧！"

# game/ch1ep1.rpy:2141
translate chinese klarapause3_44c51121:

    # mc "Bloody Mary, nice!"
    mc "血腥玛丽啊，不错！"

# game/ch1ep1.rpy:2144
translate chinese klarapause3_660c7437:

    # mc "So how much for this?"
    mc "这一杯要多少钱？"

# game/ch1ep1.rpy:2147
translate chinese klarapause3_9582f125:

    # am "All your expenses will be charged to Mr. Shu's account. Everything you buy, break, anything that costs you money."
    am "你们的所有花费都会从修先生的账户里扣除。不管是买东西，还是弄坏了东西，或者是任何其他需要花钱的地方，都不需要掏钱。"

# game/ch1ep1.rpy:2148
translate chinese klarapause3_446bcf0f:

    # am "He said I should never let you guys pay for it."
    am "他吩咐我，绝对不能让你们掏一分钱。"

# game/ch1ep1.rpy:2151
translate chinese klarapause3_fb48858f:

    # mc "Oh damn... Now I feel bad..."
    mc "天呐……现在我感觉欠他不少了……"

# game/ch1ep1.rpy:2152
translate chinese klarapause3_33990c5c:

    # am "Don't be. It was his orders. If you're happy, then he's happy. That's what he said."
    am "没事的。这是他的命令。如果你们开心，那他就开心。这是他的原话。"

# game/ch1ep1.rpy:2155
translate chinese klarapause3_3b21f354:

    # mc "......"
    mc "……"

# game/ch1ep1.rpy:2159
translate chinese klarapause3_896b161c:

    # am "He's a good friend, [mc]. His life does not revolve around himself."
    am "他是个不可多得的朋友，[mc]。他的生活里不是只有他一个人。"

# game/ch1ep1.rpy:2160
translate chinese klarapause3_798aea3b:

    # mc "That doesn't contradict the fact that he's a narcissistic bastard, but I agree that his happiness lies somewhere else."
    mc "这并不能改变他是个自恋狂的事实，但确实，他的幸福和快乐是来自别处的。"

# game/ch1ep1.rpy:2161
translate chinese klarapause3_45de2f75:

    # am "In the people around him, it seems."
    am "在我看来，是来自于他身边的人。"

# game/ch1ep1.rpy:2162
translate chinese klarapause3_f3337617:

    # mc "Mhm..."
    mc "嗯……"

# game/ch1ep1.rpy:2163
translate chinese klarapause3_f39fc963:

    # mc "We trash-talk each other most of the time, but, yeah... He's my best friend."
    mc "我们俩大部分时间都在互飙垃圾话，但是，没错……他是我最好的朋友。"

# game/ch1ep1.rpy:2167
translate chinese klarapause3_ccb452a2:

    # mc "Hey, thanks for this!"
    mc "对了，谢谢你给我做这个！"

# game/ch1ep1.rpy:2168
translate chinese klarapause3_29e8b5cf:

    # am "No worries."
    am "不用客气。"

# game/ch1ep1.rpy:2183
translate chinese klarapause3_cd6fc219:

    # mc "Oof... That's spicy!"
    mc "哇……好辣啊！"

# game/ch1ep1.rpy:2184
translate chinese klarapause3_7976c4ba:

    # am "I guess you like it."
    am "我想你会喜欢这种味道的。"

# game/ch1ep1.rpy:2187
translate chinese klarapause3_df1429fd:

    # mc "Yeah, spicy yet refreshing! Should I add 'Bartender' to your description too?"
    mc "是啊，很辣，又很提神！我要不要给你的简历里再加一个“调酒师”啊？"

# game/ch1ep1.rpy:2188
translate chinese klarapause3_765d3fe0:

    # am "Mmm... No need. I will be moving on to another job soon anyway."
    am "嗯……不用了。反正我很快又会换一个工作的。"

# game/ch1ep1.rpy:2190
translate chinese klarapause3_bd891ca9:

    # mc "Are you for real?"
    mc "你认真的？"

# game/ch1ep1.rpy:2191
translate chinese klarapause3_4ba76479:

    # am "I have always been this way, [mc]. You should know this by now."
    am "我一直都是这样的，[mc!t]。你应该也已经很清楚了。"

# game/ch1ep1.rpy:2192
translate chinese klarapause3_5e44a000:

    # mc "Right..."
    mc "好吧……"

# game/ch1ep1.rpy:2195
translate chinese klarapause3_07085131:

    # am "So, how is {b}life{/b} so far?"
    am "最近{b}日子{/b}怎么样？"

# game/ch1ep1.rpy:2196
translate chinese klarapause3_582359ea:

    # mc "Hm?"
    mc "嗯？"

# game/ch1ep1.rpy:2197
translate chinese klarapause3_5d5881e5:

    # mc "Frankly speaking, I don't know..."
    mc "说实话，我不好说……"

# game/ch1ep1.rpy:2198
translate chinese klarapause3_2c246d25:

    # mc "But if there were a way to describe it, it would be 'bittersweet'."
    mc "但要是找个词描述的话，那就是“苦乐参半”。"

# game/ch1ep1.rpy:2199
translate chinese klarapause3_ccadbbdf:

    # am "You don't say."
    am "真的吗？"

# game/ch1ep1.rpy:2200
translate chinese klarapause3_f2c2957c:

    # mc "Pain, sorrow, regret. That's how my life started. At least, that's what I wanted myself to believe. I was drowning in my ego."
    mc "痛苦，悲伤，遗憾。我的生活就是这么开始的。至少我是逼我自己这么相信的。我一直被我自己欺骗着。"

# game/ch1ep1.rpy:2201
translate chinese klarapause3_5d2ed848:

    # mc "Eventually, the day I realized it finally arrived."
    mc "最后，我醒悟过来的那天还是到了。"

# game/ch1ep1.rpy:2202
translate chinese klarapause3_04802740:

    # mc "That day was just a couple of days ago."
    mc "实际上就是在前几天。"

# game/ch1ep1.rpy:2203
translate chinese klarapause3_5f6775e2:

    # am "Mmm..."
    am "嗯……"

# game/ch1ep1.rpy:2204
translate chinese klarapause3_182c38e1:

    # am "Then, are you happy?"
    am "那，你现在开心吗？"

# game/ch1ep1.rpy:2207
translate chinese klarapause3_91e24189:

    # mc "*chuckles* Yes, I am."
    mc "*轻笑* 是啊，开心。"

# game/ch1ep1.rpy:2208
translate chinese klarapause3_d7bb47de:

    # am "That's all that matters."
    am "这才是最重要的。"

# game/ch1ep1.rpy:2209
translate chinese klarapause3_540cecd3:

    # mc "But only time will tell how long it will last."
    mc "但也只有时间才知道我能开心多久了。"

# game/ch1ep1.rpy:2212
translate chinese klarapause3_8e12fae1:

    # am "Time, huh? Why is that?"
    am "时间？为什么？"

# game/ch1ep1.rpy:2213
translate chinese klarapause3_0bf5cafa:

    # mc "Well... How should I put this...?"
    mc "嗯……该怎么说呢……？"

# game/ch1ep1.rpy:2214
translate chinese klarapause3_dff38668:

    # mc "Let's say that... I have a new challenge to face, sooner or later."
    mc "应该说……我迟早都要面临新的挑战。"

# game/ch1ep1.rpy:2215
translate chinese klarapause3_e0a97dfe:

    # mc "That is why I wanted us to unwind and refresh our minds, which led us here."
    mc "所以我才想让大家放松一下，把压力释放出来，于是就带他们来这里了。"

# game/ch1ep1.rpy:2218
translate chinese klarapause3_8897ab22:

    # am "Is that so?"
    am "是这样吗？"

# game/ch1ep1.rpy:2219
translate chinese klarapause3_13eda2e8:

    # am "Good luck. That's all I can say."
    am "祝你们好运。我只能说这么多了。"

# game/ch1ep1.rpy:2220
translate chinese klarapause3_a64e8bc0:

    # mc "Thanks."
    mc "谢谢。"

# game/ch1ep1.rpy:2221
translate chinese klarapause3_c673894c:

    # am "In the meantime, let me tell you a little tale about this place."
    am "趁这个机会，我给你讲一下有关这里的故事吧。"

# game/ch1ep1.rpy:2224
translate chinese klarapause3_6d6d6e95:

    # mc "Huh? Does this place have its lore? I never knew about that!"
    mc "啊？这里竟然还有故事的吗？我从来都不知道！"

# game/ch1ep1.rpy:2225
translate chinese klarapause3_abdec943:

    # am "Mhm. Its start was not too different to how your life began, with pain, sorrow, and regret."
    am "嗯。这里的开始跟你的人生的开始没有区别，也是充满了痛苦，悲伤和遗憾。"

# game/ch1ep1.rpy:2226
translate chinese klarapause3_f5bc5f9d:

    # am "They say that thousands of years ago this place was an enormous island. A {b}continent{/b}, is what we'd call it now."
    am "他们说几千年之前，这里是一个广袤的岛屿。按现在的说法来说，就是{b}大陆{/b}。"

# game/ch1ep1.rpy:2227
translate chinese klarapause3_fe13b30d:

    # mc "Really?!"
    mc "真的吗？！"

# game/ch1ep1.rpy:2228
translate chinese klarapause3_0123d019:

    # am "Do you believe in Deities?"
    am "你相信神吗？"

# game/ch1ep1.rpy:2229
translate chinese klarapause3_642a6c66:

    # mc "Deities? Like those godly beings with powers and stuff?"
    mc "神？是有各种神力，特别厉害的那种类型吗？"

# game/ch1ep1.rpy:2230
translate chinese klarapause3_001426f0:

    # am "Yes."
    am "是的。"

# game/ch1ep1.rpy:2231
translate chinese klarapause3_783e4808:

    # mc "Uhh... No, not really. But you commonly find stories about them in books."
    mc "呃……不，不信。不过书里有很多这种故事。"

# game/ch1ep1.rpy:2232
translate chinese klarapause3_9564fcf3:

    # mc "Although, there's nothing much these days."
    mc "尽管现在连故事也不多了。"

# game/ch1ep1.rpy:2233
translate chinese klarapause3_ada41429:

    # am "That's to be expected."
    am "我想也是。"

# game/ch1ep1.rpy:2234
translate chinese klarapause3_414f8aaf:

    # mc "What about them, though?"
    mc "神怎么了？"

# game/ch1ep1.rpy:2239
translate chinese klarapause3_f40e8278:

    # am "Well..."
    am "这个嘛……"

# game/ch1ep1.rpy:2240
translate chinese klarapause3_c2328726:

    # am "It is said that there were two {b}Conceptual Deities{/b} that fought on this island over their clash of ideals and beliefs."
    am "据说有两位{b}概念化身成的神{/b}，因为理念不合在这座岛上展开了大战。"

# game/ch1ep1.rpy:2241
translate chinese klarapause3_8c9795b0:

    # am "One was the {b}Deity of Death{/b}, and the other... was the {b}Deity of Life{/b}."
    am "一位是{b}死亡之神{/b}，另一位……是{b}生命之神{/b}。"

# game/ch1ep1.rpy:2242
translate chinese klarapause3_7f007b4e:

    # am "Their immense battle resulted in the death of every living being on this island."
    am "他们之间激烈的战斗杀死了这座岛上的所有生灵。"

# game/ch1ep1.rpy:2243
translate chinese klarapause3_b0c94288:

    # mc "Whoa..."
    mc "天啊……"

# game/ch1ep1.rpy:2246
translate chinese klarapause3_c8f30cde:

    # am "At several points, it seemed like one Deity was finally gaining the upper hand..."
    am "有好几次关键时刻，眼看着其中一位神灵就要占据上风……"

# game/ch1ep1.rpy:2247
translate chinese klarapause3_c39dfd2a:

    # am "But just before they could land the final blow, the other would battle back, causing even more damage to the already-scarred terrain..."
    am "但就在他打出最后一击之前，另一位神又会反击，给这片本就满目疮痍的土地带来更多的伤害……"

# game/ch1ep1.rpy:2248
translate chinese klarapause3_2aa964a1:

    # am "So the fight raged on endlessly for centuries; that is, until one day when the Deity of Life realized that all of this fighting was futile."
    am "这场惨烈的战斗无休止地持续了几个世纪；直到有一天，生命之神意识到，所有这些战斗都只是徒劳罢了。"

# game/ch1ep1.rpy:2249
translate chinese klarapause3_3418d97e:

    # am "So, she decided to end it."
    am "所以，她决定结束战斗。"

# game/ch1ep1.rpy:2252
translate chinese klarapause3_0908412e:

    # am "Sacrificing a portion of her life-force, she released a single powerful strike that sent shock waves throughout the world."
    am "她牺牲了自己本身的一部分生命力量，使出极其强悍的一击，攻击带来的冲击波传遍了整个世界。"

# game/ch1ep1.rpy:2253
translate chinese klarapause3_1741adf7:

    # am "The blast created a spatial fissure that sent the Deity of Death into another dimension."
    am "这一击在空间中撕开了裂口，把死亡之神送到了另一个维度。"

# game/ch1ep1.rpy:2254
translate chinese klarapause3_7667f305:

    # am "Since then, the Deity of Death has been striving to return to our world to claim its influence again."
    am "从那以后，死亡之神就一直在想办法回到我们的世界，企图卷土重来。"

# game/ch1ep1.rpy:2257
translate chinese klarapause3_34e79914:

    # am "But the Deity of Life has been guarding our world, ensuring that the Deity of Death could never return."
    am "但生命之神一直在守护着我们的世界，坚决不会让死亡之神回来。"

# game/ch1ep1.rpy:2258
translate chinese klarapause3_494021b3:

    # am "As for the continent, most of it sank to the bottom of the ocean. This small island... is all that remains."
    am "至于这片大陆，大部分都已经沉到海底去了。现在这座小小的岛屿……是唯一剩下的部分了。"

# game/ch1ep1.rpy:2261
translate chinese klarapause3_f7e7ec5d:

    # am "This island is where the two Deities were standing at the very last moment."
    am "这座岛就是两位神在最后一刻站立对峙的地方。"

# game/ch1ep1.rpy:2266
translate chinese klarapause3_a8c75ede:

    # mc "That's... quite interesting..."
    mc "还……挺有意思……"

# game/ch1ep1.rpy:2267
translate chinese klarapause3_32c499c4:

    # am "Is it?"
    am "是吧？"

# game/ch1ep1.rpy:2268
translate chinese klarapause3_fe062765:

    # mc "So, what happened next? How did the fight end?"
    mc "之后怎么样了呢？战斗到底是怎么结束的？"

# game/ch1ep1.rpy:2271
translate chinese klarapause3_d2b3eb0e:

    # am "That's all there is to this story, but sometimes..."
    am "故事就只有这么多了，但有时候……"

# game/ch1ep1.rpy:2272
