# game/emmasoloending.rpy:5420
translate chinese emmapreggospecial_cdef3d9a:

    # ma "You have no idea who you are? How peculiar..."
    ma "你不知道你的身份？真是奇怪……"

# game/emmasoloending.rpy:5423
translate chinese emmapreggospecial_342fb0e5:

    # le "I don't know you and your intentions, but I can't..."
    le "我不知道你们是谁，有什么来意，但是我不能……"

# game/emmasoloending.rpy:5432
translate chinese emmapreggospecial_208a5ed9:

    # le "... Let you touch my family!"
