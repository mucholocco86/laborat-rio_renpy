translate chinese emmaroleplay_72a33094_22:

    # e "..."
    e "……"

# game/emmasoloending.rpy:3765
translate chinese emmaroleplay_5c090e89_2:

    # mc "...."
    mc "……"

# game/emmasoloending.rpy:3766
translate chinese emmaroleplay_085722e2_1:

    # mc "What?!"
    mc "怎么了？！"

# game/emmasoloending.rpy:3769
translate chinese emmaroleplay_b8ab534c_1:

    # e "What does the penguin say?"
    e "企鹅是怎么叫的？"

# game/emmasoloending.rpy:3772
translate chinese emmaroleplay_ea07c285_1:

    # mc "Huh? What does... I mean, I don't know..."
    mc "啊？企鹅是……我也不知道啊……？"

# game/emmasoloending.rpy:3773
translate chinese emmaroleplay_9c891922_1:

    # mc "You've been the one playing with him before. You're supposed to know that, right?"
    mc "以前是你一直在跟他玩啊。你应该知道的，对吧？"

# game/emmasoloending.rpy:3776
translate chinese emmaroleplay_72a33094_23:

    # e "..."
    e "……"

# game/emmasoloending.rpy:3779
translate chinese emmaroleplay_43b8d10c_1:

    # mc "... You're supposed to know that, right?"
    mc "……你应该知道的，对吧？"

# game/emmasoloending.rpy:3782
translate chinese emmaroleplay_72a33094_24:

    # e "..."
    e "……"

# game/emmasoloending.rpy:3788
translate chinese emmaroleplay_e88ec44d_1:

    # k "[mc]!"
    k "[mc!t]！"

# game/emmasoloending.rpy:3789
translate chinese emmaroleplay_f13e2142_1:

    # mc "Oh, here she is!"
    mc "噢，她来了！"

# game/emmasoloending.rpy:3792
translate chinese emmaroleplay_f9d1e1c6:

    # e "Right, it's the time of the month for her visit."
    e "对了，她每个月的这个时候都会来看我们。"

# game/emmasoloending.rpy:3793
translate chinese emmaroleplay_e4f1fd0c_1:

    # mc "Yeah, I kind of miss-"
    mc "是啊，我有点想——"

# game/emmasoloending.rpy:3796
translate chinese emmaroleplay_4f966234_1:

    # k "Oh, good heavens~! What's with this angelic adorableness~?!"
    k "噢，老天啊~！这是谁家的小可爱啊~？"

# game/emmasoloending.rpy:3797
translate chinese emmaroleplay_d886e7ea_1:

    # le "Ehe hehehe..."
    le "哎嘿嘿嘿……"

# game/emmasoloending.rpy:3798
translate chinese emmaroleplay_b54d9373_1:

    # k "Who is she? I like her!"
    k "她是谁呀？我好喜欢她！"

# game/emmasoloending.rpy:3801
translate chinese emmaroleplay_878c1332_1:

    # mc "Her name is Leah. We are her foster parents."
    mc "她叫莉娅。寄住在我们家里。"

# game/emmasoloending.rpy:3802
translate chinese emmaroleplay_d1658acc_1:

    # k "Foster parents? You didn't tell me about this."
    k "寄住？你们没跟我提过这事啊。"

# game/emmasoloending.rpy:3803
translate chinese emmaroleplay_6a222117_1:

    # mc "We'll explain, of course. But, why don't you hug your [tenant] and his wife first?"
    mc "当然，我们会解释的。不过你不先抱抱你[tenant!t]和他老婆吗？"

# game/emmasoloending.rpy:3806
translate chinese emmaroleplay_98d6975c_1:

    # k "Jeez... I'm sorry. She sure caught my attention. *giggles*"
    k "哎呀……不好意思。她一下子就把我的注意力全吸引走了。*笑*"

# game/emmasoloending.rpy:3809
translate chinese emmaroleplay_02246aaf_1:

    # mc "Well, I don't blame you. She did the same to us."
    mc "嗯，不能怪你。我们也是一样。"

# game/emmasoloending.rpy:3810
translate chinese emmaroleplay_d0a4e789_1:

    # k "*whispers* How are you, my dear?"
    k "*低语* 你还好吗，亲爱的？"

# game/emmasoloending.rpy:3811
translate chinese emmaroleplay_b1f876d9_1:

    # e "*whispers* I'm doing fine, Klara. Thanks."
    e "*低语* 我很好，克拉拉。谢谢。"

# game/emmasoloending.rpy:3814
translate chinese emmaroleplay_44d109f4_1:

    # e "Why don't you go to your room for now? We'll continue later, okay? Bring your plushies with you."
    e "你先回房间吧？我们之后再继续，好吗？把你的玩具也带上。"

# game/emmasoloending.rpy:3815
translate chinese emmaroleplay_f5927883_3:

    # le "Okay~!"
    le "好~！"

# game/emmasoloending.rpy:3822
translate chinese emmaroleplay_2d3429aa_1:

    # k "It seems that she likes you two a lot."
    k "看来她很喜欢你们俩啊。"

# game/emmasoloending.rpy:3823
translate chinese emmaroleplay_f5ccf223_1:

    # mc "Yeah, the thing is..."
    mc "是啊，其实……"

# game/emmasoloending.rpy:3833
translate chinese emmaroleplay_ad64190a_1:

    # k "Oh... my..."
    k "我的……天……"

# game/emmasoloending.rpy:3834
translate chinese emmaroleplay_5499533f_1:

    # k "Do you usually come across this type of case?"
    k "你们经常遇见这种案子吗？"

# game/emmasoloending.rpy:3835
translate chinese emmaroleplay_eb635e3f_1:

    # e "Infidelity investigations are pretty common. But what happened after was a first, even for me."
    e "调查外遇的案子很普遍。但之后发生的事，就连我也是第一次遇见。"

# game/emmasoloending.rpy:3836
translate chinese emmaroleplay_cb035fb1_1:

    # mc "I thought we just had it easy, but we would never expect it to end this way."
    mc "我本以为我们遇到了一桩简单差事，但怎么也想不到后来会变成那样。"

# game/emmasoloending.rpy:3837
translate chinese emmaroleplay_ffa030d6_1:

    # k "Children typically forget their early childhood memories over time. But this... I'm sure it will haunt her forever."
    k "小孩一般都会慢慢忘记更早的记忆，但这些……我敢肯定，会折磨她一辈子的。"

# game/emmasoloending.rpy:3838
translate chinese emmaroleplay_e2321d60_1:

    # k "My... I feel so sorry for her."
    k "天啊……我好心疼她。"

# game/emmasoloending.rpy:3839
translate chinese emmaroleplay_e473e78c_1:

    # mc "We know, but there's not much we can do about it now. In any case, she's in safe hands now."
    mc "我们也是，但现在也没太多能做的。不管怎么说，她现在是安全了。"

# game/emmasoloending.rpy:3840
translate chinese emmaroleplay_4c1e03c8_1:

    # k "That is good to know."
    k "这就好。"

# game/emmasoloending.rpy:3843
translate chinese emmaroleplay_b80a4a19:

    # k "Anyway... There is something I have to tell you."
    k "总之……我有事要告诉你们。"

# game/emmasoloending.rpy:3844
translate chinese emmaroleplay_f449f932_1:

    # mc "And that is?"
    mc "什么事呢……？"

# game/emmasoloending.rpy:3845
translate chinese emmaroleplay_97d7bdeb_1:

    # k "Aine and Freya went missing."
    k "艾妮和芙蕾雅失踪了。"

# game/emmasoloending.rpy:3849
translate chinese emmaroleplay_c1ef8a09:

    # e "......." (multiple=2)
    e "……" (multiple=2)

# game/emmasoloending.rpy:3850
translate chinese emmaroleplay_4e98d299_1:

    # mc "{b}Huh?!{/b}" (multiple=2)
    mc "{b}啊？！{/b}" (multiple=2)

# game/emmasoloending.rpy:3851
translate chinese emmaroleplay_17f8a921_1:

    # mc "When did that happen?!"
    mc "什么时候的事？！"

# game/emmasoloending.rpy:3852
translate chinese emmaroleplay_d04b20b1_1:

    # k "Just a couple of days ago. Everyone panicked because not even Jess could tell where they went."
    k "就几天之前。大家都急坏了，因为连婕斯都不知道她们去哪了。"

# game/emmasoloending.rpy:3853
translate chinese emmaroleplay_ddf21192_1:

    # k "We are now assuming that Hera took them or they went back to her on their own."
    k "我们现在想着是不是赫拉把她们带走了，或者她们主动回去了。"

# game/emmasoloending.rpy:3856
translate chinese emmaroleplay_553b04c4_1:

    # e "... Aine would never do that. Not for that reason."
    e "……艾妮永远不可能那样的。"

# game/emmasoloending.rpy:3857
translate chinese emmaroleplay_bfa3df4e_1:

    # mc "Do you have any idea where they are, then?"
    mc "你知道她们去哪了吗？"

# game/emmasoloending.rpy:3858
translate chinese emmaroleplay_c1f8381d_1:

    # e "When I talked to her {i}that{/i} afternoon, I told her everything she had to know..."
    e "我{i}那天{/i}下午去找她的时候，把她需要知道的东西都告诉她了……"

# game/emmasoloending.rpy:3862
translate chinese emmaroleplay_a9c67781_1:

    # e "*hics*"
    e "*抽泣*"

# game/emmasoloending.rpy:3863
translate chinese emmaroleplay_0828abfe_1:

    # a "I know... I know..."
    a "我懂……我懂……"

# game/emmasoloending.rpy:3866
translate chinese emmaroleplay_0748c994_1:

    # a "I am not the most mature friend you have, but you made your choice, and I understand."
    a "我虽然算不上特别成熟，但你已经做出了决定，我理解你。"

# game/emmasoloending.rpy:3867
translate chinese emmaroleplay_3c4d82ae_1:

    # a "So, stop crying, Em. Because I am happy for you. You two deserve to be with each other more than anything else."
    a "别哭啦，小艾。因为我为你感到很高兴。你们俩值得永远在一起。"

# game/emmasoloending.rpy:3868
translate chinese emmaroleplay_d84a1d6d_1:

    # a "You know, I agree with [mc]. If there is a perfect time to take the shot, this is it. Not tomorrow or the day after."
    a "知道吗，我同意[mc!t]的看法。最合适的机会就是现在。不能再晚了。"

# game/emmasoloending.rpy:3869
translate chinese emmaroleplay_9db6d6fd_1:

    # a "Also, while I appreciate your thoughts, please forfeit your plans for me."
    a "还有呢，我很感谢你能为我着想，但不用给我制定什么计划了。"

# game/emmasoloending.rpy:3870
translate chinese emmaroleplay_e6c88014_1:

    # a "I'll be fine on my own, Em. I may look helpless, but I'm no longer the same Aine from back then."
    a "我靠自己也没问题的，小艾。我虽然现在看着很孤立无援，但我已经不是以前的艾妮了。"

# game/emmasoloending.rpy:3871
translate chinese emmaroleplay_254d0023_1:

    # a "Like you, I'll just have to find where I belong."
    a "跟你一样，我也需要找到我的归宿。"

# game/emmasoloending.rpy:3872
translate chinese emmaroleplay_b5595623_1:

    # a "But, with you leaving, that place is not here."
    a "但在你走之后，那个归宿就肯定不是这里了。"

# game/emmasoloending.rpy:3875
translate chinese emmaroleplay_8a007abe_1:

    # e "H-huh? But... where will you go?"
    e "什-什么？那……你要去哪里？"

# game/emmasoloending.rpy:3876
translate chinese emmaroleplay_845c0e6c_1:

    # a "Overseas, and I'm going to take Freya with me."
    a "到国外去，我要带上芙蕾雅和我一起。"

# game/emmasoloending.rpy:3877
translate chinese emmaroleplay_f3868621_1:

    # a "It's better to start over from nothing than to go back to mother."
    a "哪怕一无所有，重新开始，也比回妈妈身边去要好。"

# game/emmasoloending.rpy:3878
translate chinese emmaroleplay_8ce010c2_1:

    # a "I don't know where, but I want a place where no one can find us."
    a "我也不知道要去哪，但我想去一个没人能找得到我们的地方。"

# game/emmasoloending.rpy:3879
translate chinese emmaroleplay_13884380_1:

    # a "I have no clue what awaits us by the time we disappear. So, until then, I'll have to keep hiding and save enough money."
    a "我不知道我们消失之后，会遇到什么。所以在那之前我会一直躲着，还有存钱。"

# game/emmasoloending.rpy:3880
translate chinese emmaroleplay_edee2a99_1:

    # e "Disappear? You won't tell anyone about it?"
    e "消失？你不打算告诉别人吗？"

# game/emmasoloending.rpy:3881
translate chinese emmaroleplay_d6f9a43c_1:

    # a "No, I won't. That will reduce the possibility of her finding us."
    a "是的，我不会说的。这样她就更不容易找到我们。"

# game/emmasoloending.rpy:3882
translate chinese emmaroleplay_e8dbe250_1:

    # a "I also want you to keep it only between us. As your best friend, this is my one last favor."
    a "我也想让你替我保守这个秘密。作为你最好的朋友，我再请你帮我这最后一个忙。"

# game/emmasoloending.rpy:3883
translate chinese emmaroleplay_0a971051_1:

    # a "Can you promise that to me?"
    a "你能向我保证吗？"

# game/emmasoloending.rpy:3884
translate chinese emmaroleplay_51fe8b95_1:

    # e "I... I promise!"
    e "我……我保证！"

# game/emmasoloending.rpy:3887
translate chinese emmaroleplay_5c513772_1:

    # a "Thanks, Em..."
    a "谢谢，小艾……"

# game/emmasoloending.rpy:3888
translate chinese emmaroleplay_0556f0f7_1:

    # a "Oh, and don't you worry. I will come back for you. That's {i}my{/i} promise."
    a "哦，你也不用担心。我会回来找你的。这是{i}我的{/i}保证。"

# game/emmasoloending.rpy:3891
translate chinese emmaroleplay_a86c6adb_1:

    # a "Oh, one last thing..."
    a "哦，还有最后一件事……"

# game/emmasoloending.rpy:3892
translate chinese emmaroleplay_0b658c72_1:

    # a "Can I..."
    a "我能……"

# game/emmasoloending.rpy:3895
translate chinese emmaroleplay_95b40942_1:

    # a "... At least, send off my best friend?"
    a "……至少去送一下我最好的朋友吗？"

# game/emmasoloending.rpy:3902
translate chinese emmaroleplay_b7d2c6ef_1:

    # mc "Phew... At least that gives us comfort, knowing they are safe."
    mc "还好……至少知道她们是安全的，我们也能安心了"

# game/emmasoloending.rpy:3903
translate chinese emmaroleplay_e2fc9377_1:

    # k "Do you have any contact with them right now?"
    k "你现在能联系上她们吗？"

# game/emmasoloending.rpy:3904
translate chinese emmaroleplay_288e55f3_1:

    # e "I don't, but she emailed me using a dummy account yesterday."
    e "不能，但是她昨天用临时账户给我发了一封邮件。"

# game/emmasoloending.rpy:3907
translate chinese emmaroleplay_a3d0cc04_1:

    # e "She told me that they met someone from here."
    e "她告诉我，她们在那边遇到了一位这里的熟人。"

# game/emmasoloending.rpy:3908
translate chinese emmaroleplay_2b4f8e73_1:

    # mc "Someone from here? Who?"
    mc "熟人？谁啊？"

# game/emmasoloending.rpy:3913
translate chinese emmaroleplay_fdf387dd_1:

    # a "{b}Achooo~!{/b}"
    a "{b}阿嚏~！！{/b}"

# game/emmasoloending.rpy:3916
translate chinese emmaroleplay_14e2760c_1:

    # a "*sniffs* Ugh... I will never get used to this cold..."
    a "*吸鼻子* 唉……我永远也受不了这么冷的天……"

# game/emmasoloending.rpy:3917
translate chinese emmaroleplay_a1cb576b_1:

    # f "What? I, for one, like it better, you know?"
    f "什么？我可是更喜欢这里。"

# game/emmasoloending.rpy:3920
translate chinese emmaroleplay_3cec547c_1:

    # un "Here."
    un "给。"

# game/emmasoloending.rpy:3921
translate chinese emmaroleplay_dd18b1c2_1:

    # a "Thanks."
    a "谢谢。"

# game/emmasoloending.rpy:3922
translate chinese emmaroleplay_5d86fbba_1:

    # f "Thanks, Lily!"
    f "谢了，莉莉！"

# game/emmasoloending.rpy:3925
translate chinese emmaroleplay_ef354762_1:

    # l "You better be prepared, then. Winter has yet to come."
    l "那你可得准备好了。冬天还没到呢。"

# game/emmasoloending.rpy:3929
translate chinese emmaroleplay_4a3ec829_1:

    # mc "Oh... Lily, huh? She left the burger shack before me, so I guess it must've been Freya's idea to follow her."
    mc "噢……是莉莉啊？她比我还先离开汉堡店，那应该是芙蕾雅提议去她那边的。"

# game/emmasoloending.rpy:3930
translate chinese emmaroleplay_29782e6e_1:

    # k "I see. While I respect their choice, I'll have to tell Jess about this. She was worried about them."
    k "我明白了。虽然我尊重她们的选择，但我必须把这事告诉婕斯。她可是担心坏了。"

# game/emmasoloending.rpy:3931
translate chinese emmaroleplay_38a18b83_1:

    # mc "If it's Jess, I think it's alright."
    mc "如果是婕斯的话，我觉得没问题。"

# game/emmasoloending.rpy:3934
translate chinese emmaroleplay_baa635e0_1:

    # e "How about the others?"
    e "那其他人呢？"

# game/emmasoloending.rpy:3935
translate chinese emmaroleplay_e5561875_1:

    # k "Before you left, Glenn told me that I could use Gwen's help, so I eventually hired her to work for me."
    k "你们离开之前，格伦跟我说，格温可以帮我的忙，所以我后来让她到我这里工作了。"

# game/emmasoloending.rpy:3939
translate chinese emmaroleplay_ad7174ae_1:

    # k "She's been incredibly consistent over the past few years."
    k "可以说……她这几年来始终如一。"

# game/emmasoloending.rpy:3940
translate chinese emmaroleplay_b53f281d_1:

    # k "An excellent, overachieving employee that doesn't create any workplace drama. What's more to like?"
    k "她是个勤奋努力的杰出员工。在公司里不会惹出任何麻烦。还能要求更多吗？"

# game/emmasoloending.rpy:3941
translate chinese emmaroleplay_f9855f49_1:

    # mc "*chuckles* That sounds like Gwen, alright..."
    mc "*轻笑* 确实一听就知道是格温……"

# game/emmasoloending.rpy:3942
translate chinese emmaroleplay_60cbca51_1:

    # e "Which is why I wonder how she lost her company."
    e "所以我才奇怪为什么她丢掉了她的公司。"

# game/emmasoloending.rpy:3943
translate chinese emmaroleplay_9a364fd1_1:

    # mc "You don't know?"
    mc "你不知道吗？"

# game/emmasoloending.rpy:3944
translate chinese emmaroleplay_01886727_1:

    # e "No, she never talked about it with me, but Aine may have some idea. After all, she worked under Gwen for quite some time."
    e "嗯，她从来没跟我说过。不过艾妮可能了解一些，毕竟她在格温那边工作过很久。"

# game/emmasoloending.rpy:3945
translate chinese emmaroleplay_5693a819_1:

    # mc "Huh..."
    mc "嗯……"

# game/emmasoloending.rpy:3948
translate chinese emmaroleplay_3bb22729_1:

    # k "Sky was really heartbroken when you left, you know?"
    k "你走的时候，斯凯心都碎了，你知道吗？"

# game/emmasoloending.rpy:3949
translate chinese emmaroleplay_24b25b0f_3:

    # mc "*sighs*"
    mc "*叹气*"

# game/emmasoloending.rpy:3950
translate chinese emmaroleplay_8e542298_1:

    # k "She moved on, but visit her when you have time, [mc]. I'm sure she will be happy to see you."
    k "她已经放下了，但有时间的时候一定去看看她，[mc!t]。她看到你肯定会很高兴的。"

# game/emmasoloending.rpy:3951
translate chinese emmaroleplay_566f3e14_1:

    # mc "Mhm, I will."
    mc "嗯，我会的。"

# game/emmasoloending.rpy:3955
translate chinese emmaroleplay_086ce272_1:

    # k "Aside from Gwen and Sky, there's nothing noteworthy. Everyone is carrying on with their lives as usual."
    k "除了格温和斯凯，其他没什么值得说的了。大家都过着和往常一样的生活。"

# game/emmasoloending.rpy:3956
translate chinese emmaroleplay_f5094ce1_1:

    # mc "How about... Hera?"
    mc "那……赫拉呢？"

# game/emmasoloending.rpy:3959
translate chinese emmaroleplay_7406f7dc_1:

    # k "It's my fight now. Whatever happens, it is my responsibility to carry it. So, take her off your worries."
    k "这现在是我一个人的战斗了。不管发生什么，我都有责任去承担。所以你不要再去想她的事了。"

# game/emmasoloending.rpy:3960
translate chinese emmaroleplay_f16c798b_1:

    # mc "If you say so."
    mc "好吧。"

# game/emmasoloending.rpy:3968
translate chinese emmaroleplay_ae8a6ff6:

    # "Several days later..."
    "几天后……"

# game/emmasoloending.rpy:3977
translate chinese emmaroleplay_c22a414a:

    # ju "Hey, hey!"
    ju "你好啊！"

# game/emmasoloending.rpy:3978
translate chinese emmaroleplay_f57ce201:

    # mc "Yo!"
    mc "哟！"

# game/emmasoloending.rpy:3981
translate chinese emmaroleplay_648954e0:

    # un "Good morning."
    un "早上好。"

# game/emmasoloending.rpy:3982
translate chinese emmaroleplay_32c4022a:

    # mc "Oh, good morning!"
    mc "啊，早上好！"

# game/emmasoloending.rpy:3983
translate chinese emmaroleplay_bde8a219:

    # un "I apologize if we disturbed you this early in the morning."
    un "抱歉，一大早就来打扰你们。"

# game/emmasoloending.rpy:3987
translate chinese emmaroleplay_a38eb6ae:

    # e "Ow, ow, ow! Hold on. I have to talk to-"
    e "好了，好了！等一下。我得去和——"

# game/emmasoloending.rpy:3990
translate chinese emmaroleplay_7479c033:

    # le "Miss June!"
    le "琼小姐！"

# game/emmasoloending.rpy:3991
translate chinese emmaroleplay_275d4ff5:

    # ju "Heeey~! If it isn't my little Leah!"
    ju "来来来~！这不是我的小莉娅吗！"

# game/emmasoloending.rpy:3994
translate chinese emmaroleplay_fa1bef4c:

    # le "Hey, Emma, you didn't tell me we had visitors!"
    le "艾玛，你没跟我说会有客人呀！"

# game/emmasoloending.rpy:3995
translate chinese emmaroleplay_72b72b96:

    # le "Hi, visitors! I'm Leah, Emma's dau- best friend!"
    le "你好，客人！我是莉娅，艾玛的女——最好的朋友！"

# game/emmasoloending.rpy:3998
translate chinese emmaroleplay_16d6b9c1:

    # un "Aww~! I like her, hon!"
    un "呀！我喜欢她，亲爱的！"

# game/emmasoloending.rpy:3999
translate chinese emmaroleplay_41d34b5b:

    # e "Who are they?"
    e "这两位是？"

# game/emmasoloending.rpy:4002
translate chinese emmaroleplay_31ac6538:

    # ju "This is Philip and his wife, Lois."
    ju "这是菲利普，和他的妻子，露易丝。"

# game/emmasoloending.rpy:4003
translate chinese emmaroleplay_954a794f:

    # ju "Philip, Lois, this is Emma and [mc]."
    ju "菲利普，露易丝，这是艾玛和[mc!t]。"

# game/emmasoloending.rpy:4004
translate chinese emmaroleplay_b90314c3:

    # lo "Hello, nice to meet you."
    lo "你们好，很高兴见到你们。"

# game/emmasoloending.rpy:4005
translate chinese emmaroleplay_2838f70c:

    # e "Mhm."
    e "嗯。"

# game/emmasoloending.rpy:4006
translate chinese emmaroleplay_cb405bad:

    # mc "Shall we sit down first?"
    mc "我们先进去坐下吧？"

# game/emmasoloending.rpy:4016
translate chinese emmaroleplay_c23f6a33:

    # mc "So, you couldn't find any relatives that could take her in and thus set her up for adoption. Did I get that right?"
    mc "所以，你们找不到能收养她的亲属，就开始招募能收养她的家庭。是这样的吗？"

# game/emmasoloending.rpy:4017
translate chinese emmaroleplay_cce77092:

    # ju "That summarizes everything, yes."
    ju "没错，简单来说就是这样。"

# game/emmasoloending.rpy:4020
translate chinese emmaroleplay_2da9e864:

    # lo "Philip and I have been trying for a couple of years, but with no results."
    lo "我和菲利普已经尝试了好几年，但就是没有结果。"

# game/emmasoloending.rpy:4021
translate chinese emmaroleplay_0b3b6b46:

    # lo "Later, we discovered that it was due to my infertility."
    lo "之后，才发现我没有生育能力。"

# game/emmasoloending.rpy:4022
translate chinese emmaroleplay_a8af08ad:

    # lo "I suffered from menstrual disorders when I was younger. My doctor told me that's where it started, but I didn't pay it any mind at that time."
    lo "我年轻的时候就有月经不调的毛病。医生告诉我，情况就是从那时候开始慢慢恶化的，但我当时太傻了，没有放在心上。"

# game/emmasoloending.rpy:4023
translate chinese emmaroleplay_74f4be79:

    # lo "So adoption is our only option now."
    lo "所以我们现在就只剩下收养这一个选项了。"

# game/emmasoloending.rpy:4024
translate chinese emmaroleplay_3f9f558f:

    # lo "We don't want to grow old without having someone on our side now, do we?"
    lo "我们到老了之后可不想身边没人陪着，对吧？"

# game/emmasoloending.rpy:4025
translate chinese emmaroleplay_740631b2:

    # mc "That's unfortunate, and I agree with your sentiment."
    mc "真是遗憾的遭遇，我也同意你们的看法。"

# game/emmasoloending.rpy:4028
translate chinese emmaroleplay_399aaceb:

    # ju "We won't force anything on either party, so I want to have a mutual agreement between you all before they can finally adopt Leah."
    ju "我们两方都不想强迫，所以在他们正式收养莉娅之前，想让你们达成一致。"

# game/emmasoloending.rpy:4029
translate chinese emmaroleplay_1545372f:

    # ju "Thus, starting today, I'd like to give them a chance to visit her as often as possible."
    ju "因此，从今天开始，我想让他们两个尽可能多地来看她。"

# game/emmasoloending.rpy:4032
translate chinese emmaroleplay_8de36fa0:

    # ph "We just want to talk to her for now. There's no need to rush."
    ph "我们现在只想跟她说说话，没必要赶太急。"

# game/emmasoloending.rpy:4033
translate chinese emmaroleplay_03021e2d:

    # lo "Mhm."
    lo "嗯。"

# game/emmasoloending.rpy:4036
translate chinese emmaroleplay_b8fc7b88:

    # ju "[mc], can you get her down here for me, please?"
    ju "[mc!t]，你能帮我把她喊下来吗？"

# game/emmasoloending.rpy:4037
translate chinese emmaroleplay_52e4f359:

    # mc "Sure!"
    mc "好啊！"

# game/emmasoloending.rpy:4040
translate chinese emmaroleplay_72a33094_25:

    # e "..."
    e "……"

# game/emmasoloending.rpy:4041
translate chinese emmaroleplay_8d34fbb2:

    # e "...."
    e "…………"

# game/emmasoloending.rpy:4044
translate chinese emmaroleplay_b7fa8e51:

    # e "If you'll excuse me."
    e "我先失陪了。"

# game/emmasoloending.rpy:4047
translate chinese emmaroleplay_52fc4ea2_1:

    # ju "..."
    ju "……"

# game/emmasoloending.rpy:4057
translate chinese emmaroleplay_2c3dcfb2:

    # d "My... my... You're such a sweet little girl~. Of course, mom will always be here for you."
    d "哈哈，宝贝，你可真乖。当然啦，妈妈会一直陪在你身边的。"

# game/emmasoloending.rpy:4058
translate chinese emmaroleplay_667a0f7b:

    # d "Even on the day you marry your prince, mom and Emy will still be together."
    d "你跟你的王子结婚以后，妈妈也不会跟艾米分开的。"

# game/emmasoloending.rpy:4059
translate chinese emmaroleplay_961494b6:

    # em "Forever?"
    em "永远在一起吗？"

# game/emmasoloending.rpy:4060
translate chinese emmaroleplay_e27180a1:

    # d "Yes, Emy... Forever."
    d "是的，艾米……永远。"

# game/emmasoloending.rpy:4063
translate chinese emmaroleplay_6e5a129d:

    # d "Emy... Emy!"
    d "艾米……艾米！"

# game/emmasoloending.rpy:4064
translate chinese emmaroleplay_e9283d5f:

    # em "M-mom? Why are you crying?"
    em "妈妈？你怎么哭了？"

# game/emmasoloending.rpy:4065
translate chinese emmaroleplay_557c352a:

    # d "*crying* I... won't go away... I promise! Mom will be with you forever... That's a promise!"
    d "*哭泣* 我……不会丢下你的……我保证！妈妈会永远陪着你……我们说好了……"

# game/emmasoloending.rpy:4072
translate chinese emmaroleplay_72a33094_26:

    # e "..."
    e "……"

# game/emmasoloending.rpy:4073
translate chinese emmaroleplay_426a1736:

    # e "Mom..."
    e "妈妈……"

# game/emmasoloending.rpy:4080
translate chinese emmaroleplay_4e4677a5:

    # le "I hate the night sky."
    le "我讨厌夜空。"

# game/emmasoloending.rpy:4081
translate chinese emmaroleplay_f49ad8f8:

    # e "... Why?"
    e "……为什么？"

# game/emmasoloending.rpy:4082
translate chinese emmaroleplay_c4c9fe97:

    # le "Those tiny shining dots always gather around... like one happy family."
    le "那些小小的星星们总是聚在一起……就像幸福的一家人一样。"

# game/emmasoloending.rpy:4083
translate chinese emmaroleplay_dc457712:

    # le "I'm jealous..."
    le "我嫉妒它们……"

# game/emmasoloending.rpy:4084
translate chinese emmaroleplay_b2f97a01:

    # le "What does it mean to have a father?"
    le "有爸爸是什么感觉？"

# game/emmasoloending.rpy:4085
translate chinese emmaroleplay_e47c1512:

    # le "What does it mean to have a mother?"
    le "有妈妈是什么感觉？"

# game/emmasoloending.rpy:4086
translate chinese emmaroleplay_d94ef7b7:

    # le "A sister? Or maybe a brother?"
    le "兄弟姐妹呢？又是什么感觉？"

# game/emmasoloending.rpy:4089
translate chinese emmaroleplay_d9f0b64e:

    # le "So, maybe... if it's alright, will you become my mother instead?"
    le "所以，假如……假如可以的话，你愿意做我的妈妈吗？"

# game/emmasoloending.rpy:4092
translate chinese emmaroleplay_cc7552db:

    # e "!!!"
    e "！！！"

# game/emmasoloending.rpy:4093
translate chinese emmaroleplay_d2cbebe9:

    # le "You and partner were the first people who treated me so kindly, and I don't want to-"
    le "你和搭档是最先对我好的人，我不想——"

# game/emmasoloending.rpy:4096
translate chinese emmaroleplay_5d25027a:

    # e "No..."
    e "不……"

# game/emmasoloending.rpy:4097
translate chinese emmaroleplay_8386f960:

    # e "... I can't..."
    e "……我做不到……"

# game/emmasoloending.rpy:4098
translate chinese emmaroleplay_98741ac3_11:

    # le "..."
    le "……"

# game/emmasoloending.rpy:4099
translate chinese emmaroleplay_2ba73118:

    # le "I'm sorry..."
    le "对不起……"

# game/emmasoloending.rpy:4102
translate chinese emmaroleplay_2b35b6fe_5:

    # mc "..."
    mc "……"

# game/emmasoloending.rpy:4113
translate chinese emmaroleplay_9d88440d:

    # ju "Hey, what's wrong with Emma?"
    ju "哎，艾玛怎么回事？"

# game/emmasoloending.rpy:4114
translate chinese emmaroleplay_e30f3f2c:

    # ju "She's... been really out of it these past couple of days. I also noticed she hasn't been talking to Leah either. What happened?"
    ju "她……最近几天一直都不对劲，而且我也发现她都不跟莉娅说话了。出什么事了？"

# game/emmasoloending.rpy:4115
translate chinese emmaroleplay_1311949a:

    # mc "Remember how I told you she had issues getting close to the kid?"
    mc "还记得我告诉你，她没法跟那孩子变得亲密吗？"

# game/emmasoloending.rpy:4116
translate chinese emmaroleplay_71f62369:

    # ju "No, you only told me she had issues understanding her stance on Leah. What changed? I saw how close they already were. Did they fight or something?"
    ju "不，你只跟我说她没法理解她对那个孩子的感受。出什么变化了吗？不管怎么说，我之前都亲眼看见过她们两个关系很好。她们是吵架了还是怎么着？"

# game/emmasoloending.rpy:4119
translate chinese emmaroleplay_7a5622aa:

    # ju "Wait a sec... If {i}that's{/i} her issue, then..."
    ju "等一下……如果她的问题是{i}那个{/i}的话，那么……"

# game/emmasoloending.rpy:4120
translate chinese emmaroleplay_2e2aeda4:

    # mc "I think I already know why..."
    mc "我想我已经知道为什么了……"

# game/emmasoloending.rpy:4123
translate chinese emmaroleplay_11b12f4e:

    # ju "Hey now..."
    ju "你……"

# game/emmasoloending.rpy:4124
translate chinese emmaroleplay_437861fa:

    # mc "It's my fault. I shouldn't have pushed for Leah to come here..."
    mc "是我的错。我不该强行让莉娅住进来的……"

# game/emmasoloending.rpy:4127
translate chinese emmaroleplay_b82bd0d8:

    # ju "No, you did the right thing, [mc]."
    ju "不，你做得很对，[mc!t]。"

# game/emmasoloending.rpy:4128
translate chinese emmaroleplay_aa421703:

    # ju "As much as they need a hero in their lives, let them fix this one on their own."
    ju "尽管她们需要一个英雄出现帮助她们，但这个问题还是让她们靠自己解决吧。"

# game/emmasoloending.rpy:4129
translate chinese emmaroleplay_72a07eb6:

    # ju "Sometimes, realizing this kind of thing by yourself can shake you up in a good way."
    ju "有时候，自己想通这种事，才会真正明白。"

# game/emmasoloending.rpy:4130
translate chinese emmaroleplay_6b1541d3:

    # ju "I know it may sound stupid, coming from someone like me... But I've been through something similar, and I know what it feels like."
    ju "我知道，像我这种人这么说，很傻……但我也经历过类似的事情，也知道到底是什么感觉。"

# game/emmasoloending.rpy:4133
translate chinese emmaroleplay_52762c02:

    # ju "And you just need to hold your ground. Don't intervene, but be there if they need you."
    ju "你只要在旁边看着就好。不要干预，但她们需要你的时候，一定要在她们身边。"

# game/emmasoloending.rpy:4134
translate chinese emmaroleplay_46f77ca7:

    # mc "Yeah... I know."
    mc "嗯……我懂。"

# game/emmasoloending.rpy:4145
translate chinese emmaroleplay_98741ac3_12:

    # le "..."
    le "……"

# game/emmasoloending.rpy:4148
translate chinese emmaroleplay_0907b325:

    # le "Ah..."
    le "啊……"

# game/emmasoloending.rpy:4151
translate chinese emmaroleplay_8d9e3e73:

    # le "Hey, hey, Emma~! Wanna play with me again~? I'll bring my plushies and-"
    le "那个，那个，艾玛~！要再和我玩吗~？我去把我的毛绒玩具拿来，然后——"

# game/emmasoloending.rpy:4152
translate chinese emmaroleplay_3ea87455:

    # e "... No."
    e "……不。"

# game/emmasoloending.rpy:4153
translate chinese emmaroleplay_1f6d9dd8:

    # le "But-"
    le "但是——"

# game/emmasoloending.rpy:4154
translate chinese emmaroleplay_9e059d7b:

    # e "I said... {b}NO{/b}."
    e "我说了……{b}不行{/b}。"

# game/emmasoloending.rpy:4157
translate chinese emmaroleplay_632993db_2:

    # le "...."
    le "……"

# game/emmasoloending.rpy:4158
translate chinese emmaroleplay_d34a812a_2:

    # le "Okay..."
    le "好吧……"

# game/emmasoloending.rpy:4161
translate chinese emmaroleplay_2b35b6fe_6:

    # mc "..."
    mc "……"

# game/emmasoloending.rpy:4173
translate chinese emmaroleplay_5bb28004:

    # le "*sniffs* *sniffs*"
    le "*闻* *闻*"

# game/emmasoloending.rpy:4176
