# game/emmasoloending.rpy:5454
translate chinese emmapreggospecial_6de893d6:

    # le "Again, who are you, and what are your intentions? Answer me."
    le "你们到底是谁，又是来干什么的？回答我。"

# game/emmasoloending.rpy:5455
translate chinese emmapreggospecial_9426b731:

