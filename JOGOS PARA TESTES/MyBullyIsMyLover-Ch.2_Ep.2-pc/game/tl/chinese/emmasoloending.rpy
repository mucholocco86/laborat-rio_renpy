# game/emmasoloending.rpy:5435
translate chinese emmapreggospecial_28f7a7c0:

    # un "Oh, wow..."
    un "哇……"

# game/emmasoloending.rpy:5436
translate chinese emmapreggospecial_8024d14c:

    # ma "*nervously laughs* Those eyes..."
    ma "*紧张地笑* 那双眼睛……"

# game/emmasoloending.rpy:5437
translate chinese emmapreggospecial_d99305ca:

    # ma "One is swallowed by darkness, and the other is glowing with the light of eternal slumber..."
    ma "一只被黑暗所吞噬，另一只则闪耀着永恒的沉睡之光……"

# game/emmasoloending.rpy:5438
translate chinese emmapreggospecial_dd8ec474:

    # ma "You, girl, are indeed {i}her daughter{/i}."
    ma "你，姑娘，确实是{i}她的女儿{/i}。"

# game/emmasoloending.rpy:5439
translate chinese emmapreggospecial_27b7c2a1:

    # un "No need for such hostility. We are not here to fight, Princess."
    un "没必要这么有敌意。我们不是来战斗的，公主。"

# game/emmasoloending.rpy:5440
translate chinese emmapreggospecial_ea27441c:

    # ma "Losing your cool now, E? You were pretty pumped about this."
