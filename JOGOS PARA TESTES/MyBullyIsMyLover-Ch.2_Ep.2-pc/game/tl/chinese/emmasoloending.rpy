    # e "... Yeah, you're right."
    e "……是啊，你说得对。"

# game/emmasoloending.rpy:1996
translate chinese emmaroleplay_a826ef78:

    # e "That won't work, Dispatch. The victim needs medical attention ASAP."
    e "调度中心，这样不行。受害人必须立刻接受治疗。"

# game/emmasoloending.rpy:1997
translate chinese emmaroleplay_f3f03cff:

    # e "My partner will take the victim to GT Hospital while I remain at the crime scene to secure it."
    e "我的搭档会把受害人送往GT医院，我留下来保护犯罪现场。"

# game/emmasoloending.rpy:1999
translate chinese emmaroleplay_c56e1acb:

    # dis "Understood, detective. Notifying GT's ER of the arrival of a minor victim and the suspect's situation to dispatched units, over."
    dis "明白，警探。正在通知GT医院的急诊室有一名未成年受害人在路上，以及将嫌疑人的状态更新给了已派遣的警力，完毕。"

# game/emmasoloending.rpy:2003
translate chinese emmaroleplay_5d5b5769:

    # e "Go... I'll catch up to you after I sort this out..."
    e "走吧……我把这里的事处理完之后就去找你……"

# game/emmasoloending.rpy:2004
translate chinese emmaroleplay_3368fefc:

    # mc "Alright, be careful, Em."
    mc "好，小心点，小艾。"

# game/emmasoloending.rpy:2006
translate chinese emmaroleplay_501e80f9:

    # nad "Where are you taking-"
    nad "你要把她——"

# game/emmasoloending.rpy:2013
translate chinese emmaroleplay_83e63b5d:

    # e "{b}Shut... the fuck... up...{/b}"
    e "{b}闭上……你的臭嘴……{/b}"

# game/emmasoloending.rpy:2026
translate chinese emmaroleplay_4ea90856:

    # mc "Em..."
    mc "小艾……"

# game/emmasoloending.rpy:2027
translate chinese emmaroleplay_481c5850:

    # e "Sorry I took so long."
    e "抱歉，我来晚了。"

# game/emmasoloending.rpy:2028
translate chinese emmaroleplay_eb58d824:

    # mc "How did it go?"
    mc "怎么样了？"

# game/emmasoloending.rpy:2031
translate chinese emmaroleplay_4be673df:

    # e "They took Nadine into custody for further investigation."
    e "他们把娜丁带走做进一步调查了。"

# game/emmasoloending.rpy:2032
translate chinese emmaroleplay_a875cad4:

    # mc "How about her husband?"
    mc "她老公呢？"

# game/emmasoloending.rpy:2033
translate chinese emmaroleplay_e0b42a61:

    # e "He was dead on arrival. The Domestic Crimes and Homicide departments will take care of the case from now on, but they might call me for questioning..."
    e "他在我们到的时候就已经死了。这个案子之后就移交给家庭犯罪科和谋杀科的人了，但他们可能会传唤我，问一些问题……"

# game/emmasoloending.rpy:2034
translate chinese emmaroleplay_837e96fc:

    # mc "She's... deranged, Em. Did you notice anything peculiar about her when she hired you?"
    mc "她……完全疯了，小艾。你之前有注意到什么异常吗？"

# game/emmasoloending.rpy:2035
translate chinese emmaroleplay_944cb881:

    # e "When she told me that she was at her wit's end, her sudden change of expression was the only thing that stood out."
    e "她之前跟我说过她快疯了，当时突然变换的表情也不正常。"

# game/emmasoloending.rpy:2036
translate chinese emmaroleplay_99181812:

    # e "I didn't pay enough attention... I should've..."
    e "但我没太放在心上……我不该那样的……"

# game/emmasoloending.rpy:2039
translate chinese emmaroleplay_8a0151f2:

    # e "*sighs*"
    e "*叹气*"

# game/emmasoloending.rpy:2042
translate chinese emmaroleplay_fe4ab509:

    # e "But, more importantly, how's Leah?"
    e "现在更重要的是，莉娅怎么样了？"

# game/emmasoloending.rpy:2043
translate chinese emmaroleplay_e82b81c2:

    # mc "She's in the emergency room. It's been more than two hours, and I'm still waiting for someone to come out."
    mc "还在抢救室里。已经过了两个多小时了，我还在等里面的人出来。"

# game/emmasoloending.rpy:2046
translate chinese emmaroleplay_72a33094_3:

    # e "..."
    e "……"

# game/emmasoloending.rpy:2052
translate chinese emmaroleplay_a97951b7:

    # mc "Here."
    mc "给。"

# game/emmasoloending.rpy:2053
translate chinese emmaroleplay_54ccf6a1:

    # mc "Leah was holding that when I picked her up."
    mc "莉娅的手里一直抓着这个。"

# game/emmasoloending.rpy:2056
translate chinese emmaroleplay_72a33094_4:

    # e "..."
    e "……"

# game/emmasoloending.rpy:2061
translate chinese emmaroleplay_59f48cb0:

    # e "{i}I'm sorry we couldn't play. I think that was for the best.{/i}"
    e "{i}很抱歉，我们没法一起玩了。我想这样最好。{/i}"

# game/emmasoloending.rpy:2062
translate chinese emmaroleplay_ccd1357f:

    # e "{i}But maybe... Just maybe, we can meet each other again.{/i}"
    e "{i}但说不定……只是说不定，我们还能再见。{/i}"

# game/emmasoloending.rpy:2065
translate chinese emmaroleplay_258c6ee1:

    # e "{i}I look forward to it, so hold on to this letter till then. Be strong.{/i}"
    e "{i}我很期待那天，所以在那之前，你要好好珍惜这封信。要坚强。{/i}"

# game/emmasoloending.rpy:2066
translate chinese emmaroleplay_658c8a44:

    # e "{i}Sincerely,{/i}"
    e "{i}真诚的，{/i}"

# game/emmasoloending.rpy:2067
translate chinese emmaroleplay_3cfd4d08:

    # e "{i}Emma the Doll.{/i}"
    e "{i}娃娃艾玛{/i}"

# game/emmasoloending.rpy:2071
translate chinese emmaroleplay_2b35b6fe:

    # mc "..."
    mc "……"

# game/emmasoloending.rpy:2074
translate chinese emmaroleplay_0628f07b:

    # nur "Good morning. My name is Jinn. I am the nurse assisting with Leah's treatment."
    nur "你们好。我叫金。我是帮助抢救莉娅的护士。"

# game/emmasoloending.rpy:2075
translate chinese emmaroleplay_8ed3e946:

    # mc "How is she doing?"
    mc "她情况怎么样了？"

# game/emmasoloending.rpy:2078
translate chinese emmaroleplay_561d28d3:

    # ji "She's stable, and more importantly, is conscious and responsive."
    ji "已经稳定了，更重要的是，已经恢复了意识，有反应了。"

# game/emmasoloending.rpy:2079
translate chinese emmaroleplay_bb0eb213:

    # ji "Fortunately, the suffocation didn't appear to cause any severe or permanent damage, but we will keep her overnight for observation."
    ji "很幸运，窒息没有造成永久或者严重的损伤，但是她要在这里住一晚，进一步观察情况。"

# game/emmasoloending.rpy:2080
translate chinese emmaroleplay_670e727a:

    # ji "Just to give you a heads up, if everything is clear, we will contact the child's relatives."
    ji "给你们提个醒，等事情都解决完之后，我们会联系孩子的亲属。"

# game/emmasoloending.rpy:2081
translate chinese emmaroleplay_abce2138:

    # ji "If none exist, the Department of Social Services will take care of her until they can find a foster family to put her in."
    ji "如果没有亲属的话，就要交给社会福利部，直到找到能收养她的家庭。"

# game/emmasoloending.rpy:2082
translate chinese emmaroleplay_0b8503b5:

    # mc "We understand."
    mc "我们明白。"

# game/emmasoloending.rpy:2083
translate chinese emmaroleplay_9e8f037a:

    # ji "It seems like you two had a rough night."
    ji "看来你们俩刚经历了一个难熬的夜晚啊。"

# game/emmasoloending.rpy:2084
translate chinese emmaroleplay_1e8cda4c:

    # ji "Take it easy and go home. We'll take care of Leah for now."
    ji "放轻松点，回家吧。莉娅就先交给我们来照顾。"

# game/emmasoloending.rpy:2085
translate chinese emmaroleplay_bb0eeaf4:

    # mc "Thank you."
    mc "谢谢你。"

# game/emmasoloending.rpy:2090
translate chinese emmaroleplay_7f7f3ad6:

    # ji "*whispers* Hey, E... I found her. But I don't think she's ready yet."
    ji "*低语* 喂，E……我找到她了。但我觉得她还没准备好。"

# game/emmasoloending.rpy:2091
translate chinese emmaroleplay_f370e154:

    # ji "*whispers* Please tell Mistress we should give her a few more years with them."
    ji "*低语* 请告诉主人，我们应该让她在他们身边再留几年。"

# game/emmasoloending.rpy:2092
translate chinese emmaroleplay_0b0fc55e:

    # ji "*whispers* By few, I mean..."
    ji "*低语* 说是几年，实际上……"

# game/emmasoloending.rpy:2093
translate chinese emmaroleplay_aabdabae:

    # ji "*whispers* I don't know... I'll leave that to her judgment. She trusts them, it seems."
    ji "*低语* 我也不好说……这就交给她自己判断吧。似乎她很相信他们。"

# game/emmasoloending.rpy:2096
translate chinese emmaroleplay_818d96eb:

    # ji "*whispers* Also, I look silly in these glasses. I better have good compensation for this."
    ji "*低语* 还有，我戴这副眼镜的样子很傻。之后可得好好补偿我一下。"

# game/emmasoloending.rpy:2099
translate chinese emmaroleplay_f30f55bc:

    # mc "*exhales deeply*"
    mc "*长叹一口气*"

# game/emmasoloending.rpy:2102
translate chinese emmaroleplay_857a7696:

    # mc "Now then..."
    mc "好了……"

# game/emmasoloending.rpy:2103
translate chinese emmaroleplay_ed91b2e1:

    # mc "She was involved in your case, so what do you want to do?"
    mc "她被牵扯进你的案子里了，接下来你要怎么办？"

# game/emmasoloending.rpy:2104
translate chinese emmaroleplay_ccb447f6:

    # mc "I don't know much about legalities and stuff, but the system will be brutal for the kid, that much is certain."
    mc "我不太懂那些法律上的东西，但这孩子进了系统之后不会好过的，这我很确定。"

# game/emmasoloending.rpy:2105
translate chinese emmaroleplay_6b4d13a9:

    # e "I... I don't know, [mc]."
    e "我……我不知道，[mc!t]。"

# game/emmasoloending.rpy:2106
translate chinese emmaroleplay_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/emmasoloending.rpy:2109
translate chinese emmaroleplay_23a1b7d1:

    # mc "Hey, Em?"
    mc "小艾？"

# game/emmasoloending.rpy:2110
translate chinese emmaroleplay_6b8e9f1c:

    # mc "I didn't notice it right away, but why does it seem like you want to avoid her?"
    mc "我之前没立马注意到这一点，但为什么总感觉你是想躲着她呢？"

# game/emmasoloending.rpy:2111
translate chinese emmaroleplay_60d477ac:

    # mc "I know you told me you're afraid to break down your walls, but what's behind them, really?"
    mc "你是跟我说过你不想卸下心防，但背后真正的原因到底是什么呢？"

# game/emmasoloending.rpy:2112
translate chinese emmaroleplay_121bdc84:

    # mc "Tell me, because if you don't, I will never be able to understand you. You know that I'm here for you."
    mc "告诉我吧，你不说的话，我永远都不会知道啊。你也知道我会一直陪着你的。"

# game/emmasoloending.rpy:2113
translate chinese emmaroleplay_fc401198:

    # e "... I don't know."
    e "……我不知道。"

# game/emmasoloending.rpy:2114
translate chinese emmaroleplay_512ac1a9:

    # mc "Alright then, I will decide for you."
    mc "好吧，那我就替你做决定了。"

# game/emmasoloending.rpy:2117
translate chinese emmaroleplay_2b40a022:

    # e "Huh?"
    e "啊？"

# game/emmasoloending.rpy:2118
translate chinese emmaroleplay_7ba2fa6f:

    # mc "Have Leah stay with us while they look for her relatives."
    mc "想办法在找到她的亲戚之前，让莉娅住在我们家里。"

# game/emmasoloending.rpy:2119
translate chinese emmaroleplay_38bc0732:

    # e "B-but-"
    e "但-但是——"

# game/emmasoloending.rpy:2122
translate chinese emmaroleplay_4a9755da:

    # mc "No... make it happen."
    mc "不行……必须想办法。"

# game/emmasoloending.rpy:2123
translate chinese emmaroleplay_5d5ea28a:

    # mc "Since you can't decide for yourself, then I will, as your husband."
    mc "既然你自己没法决定，那我作为你的丈夫就要替你决定。"

# game/emmasoloending.rpy:2126
translate chinese emmaroleplay_9c803576:

    # mc "I'm not sure about you yet, but I care for the kid."
    mc "你怎么想我现在还不好说，但我非常担心这个孩子。"

# game/emmasoloending.rpy:2127
translate chinese emmaroleplay_64f9ca25:

    # mc "I may not be a champion of justice, but at least I can make it easier for Leah."
    mc "我算不上什么正义的伙伴，但至少我能让莉娅好过一点。"

# game/emmasoloending.rpy:2128
translate chinese emmaroleplay_459c2480:

    # mc "She's been through a lot. I won't be able to sleep soundly, knowing she's still suffering."
    mc "她经历了太多了。心里明知道她在受苦，我是不可能睡得着觉的。"

# game/emmasoloending.rpy:2131
translate chinese emmaroleplay_72a33094_5:

    # e "..."
    e "……"

# game/emmasoloending.rpy:2134
translate chinese emmaroleplay_8a0151f2_1:

    # e "*sighs*"
    e "*叹气*"

# game/emmasoloending.rpy:2137
translate chinese emmaroleplay_72a33094_6:

    # e "..."
    e "……"

# game/emmasoloending.rpy:2141
translate chinese emmaroleplay_a20cefa7:

    # "..."
    "……"

# game/emmasoloending.rpy:2142
translate chinese emmaroleplay_5f9b772e:

    # "...."
    "…………"

# game/emmasoloending.rpy:2144
translate chinese emmaroleplay_5c493b63:

    # e "Hey, uhhh... Sorry to call you at this hour."
    e "喂，呃……抱歉啊，这么晚给你打电话。"

# game/emmasoloending.rpy:2152
translate chinese emmaroleplay_b33d6fdf:

    # "Two days later..."
    "两天后……"

# game/emmasoloending.rpy:2162
translate chinese emmaroleplay_c2c1786c:

    # un "Stay here, okay?"
    un "先待在这，好吗？"

# game/emmasoloending.rpy:2163
translate chinese emmaroleplay_0c3d6397:

    # un "I just have to take care of uhhh..."
    un "我得先去算一笔，呃……"

# game/emmasoloending.rpy:2164
translate chinese emmaroleplay_7a057a3c:

    # un "... Some past business."
    un "……旧账。"

# game/emmasoloending.rpy:2165
translate chinese emmaroleplay_c9d40717:

    # le "\"Past business\"?"
    le "旧账？"

# game/emmasoloending.rpy:2166
translate chinese emmaroleplay_0fdbcae8:

    # un "*chuckles* Nothing to be concerned about. Just stay here. I'll be right back."
    un "*轻笑* 不用担心。先待在这，我很快回来。"

# game/emmasoloending.rpy:2167
translate chinese emmaroleplay_d34a812a:

    # le "Okay..."
    le "好吧……"

# game/emmasoloending.rpy:2178
translate chinese emmaroleplay_0ceec08b:

    # mc "H-hold on! I know that face!"
    mc "等-等下！我认识她啊！"

# game/emmasoloending.rpy:2179
translate chinese emmaroleplay_7e5be565:

    # e "What?"
    e "什么？"

# game/emmasoloending.rpy:2180
translate chinese emmaroleplay_e9e4b7a0:

    # mc "Isn't that..."
    mc "这不是……"

# game/emmasoloending.rpy:2184
translate chinese emmaroleplay_8c781cd1:

    # mc "{b}June?!{/b}"
    mc "{b}琼吗？！{/b}"

# game/emmasoloending.rpy:2185
translate chinese emmaroleplay_c2a1a4f3:

    # ju "Hm... Hm-hmmm!"
    ju "哼……哼哼！"

# game/emmasoloending.rpy:2201
translate chinese emmaroleplay_bffba88c:

    # mc "Eeek! Em, help me!"
    mc "妈呀！小艾，救我！"

# game/emmasoloending.rpy:2202
translate chinese emmaroleplay_ed113b44:

    # e "But, why? You know her?"
    e "怎么回事？你认识她？"

# game/emmasoloending.rpy:2203
translate chinese emmaroleplay_13cd6a71:

    # mc "Yeah! She's a spawn of evil! A masochist! She kills everyone she knows!"
    mc "是啊！她是恶魔的后裔！虐待狂！会杀掉她认识的每个人！"

# game/emmasoloending.rpy:2204
translate chinese emmaroleplay_9b07297c:

    # e "But, I'm still alive..."
    e "但我还活着啊……"

# game/emmasoloending.rpy:2205
translate chinese emmaroleplay_3a951fd4:

    # e "You told me to make it happen, so I called her. She's the only connection I have in DFCS."
    e "你让我想办法，所以我就去找她了。她是我在DFCS里唯一的人脉了。（译注：DFCS，Divison of Family and Chilren Services，家庭与儿童服务部，主要调查虐待儿童相关的案例以及为受到虐待的儿童寻找新的寄宿家庭。）"

# game/emmasoloending.rpy:2206
translate chinese emmaroleplay_187d24fc:

    # e "And well... we're close."
    e "而且呢……我们关系很好。"

# game/emmasoloending.rpy:2207
translate chinese emmaroleplay_d4488b21:

    # mc "She works with DFCS?! You could've called anyone but her!"
    mc "她在DFCS上班？！你找谁都行，就她不行！"

# game/emmasoloending.rpy:2210
translate chinese emmaroleplay_f56b3809:

    # ju "{b}RAAAAAAH!{/b}"
    ju "{b}惹啊啊啊啊！{/b}"

# game/emmasoloending.rpy:2214
translate chinese emmaroleplay_1ffe3865:

    # ju "{b}HAAH!{/b}"
    ju "{b}哈啊！{/b}"

# game/emmasoloending.rpy:2215
translate chinese emmaroleplay_a2871fe2:

    # e "Hey, stop that, or I won't talk to you again..."
    e "停下，不然我就不理你了……"

# game/emmasoloending.rpy:2218
translate chinese emmaroleplay_cb09e3e5:

    # le "So, is that how you take care of \"past business\"? Hmm..."
    le "原来这就是“算旧账”呀？嗯……"

# game/emmasoloending.rpy:2222
translate chinese emmaroleplay_19d922cb:

    # mc "What the hell was that?! What did I ever do to you?!"
    mc "这到底什么情况啊？！我有对不起你吗？！"

# game/emmasoloending.rpy:2223
translate chinese emmaroleplay_6c514cf3:

    # ju "Oh, my poor, precious Emma~! What has this guy done to you~?"
    ju "噢，我可怜，亲爱的艾玛~！这个男人对你做了什么~？"

# game/emmasoloending.rpy:2226
translate chinese emmaroleplay_9a695108:

    # ju "What did you do to my Emma?!"
    ju "你都对我的艾玛干什么了？！"

# game/emmasoloending.rpy:2229
translate chinese emmaroleplay_f337be98:

    # mc "Hm-hmmm! {b}My{/b} Emma..."
    mc "哼哼！是{b}我的{/b}艾玛……！"

# game/emmasoloending.rpy:2232
translate chinese emmaroleplay_286517e0:

    # ju "You..."
    ju "你……"

# game/emmasoloending.rpy:2233
translate chinese emmaroleplay_1a70c907:

    # e "Yes, [mc] is my husband."
    e "对，[mc!t]是我丈夫。"

# game/emmasoloending.rpy:2234
translate chinese emmaroleplay_609ce0c0:

    # ju "But why {i}him{/i}?"
    ju "但为什么是{i}他{/i}？"

# game/emmasoloending.rpy:2235
translate chinese emmaroleplay_51618101:

    # e "I love him, of course. Now, can you get off of me, please?"
    e "当然是因为我爱他。能请你放开我了吗？"

# game/emmasoloending.rpy:2238
translate chinese emmaroleplay_376c68ff:

    # ju "Hm-hmmm!"
    ju "哼哼！"

# game/emmasoloending.rpy:2239
translate chinese emmaroleplay_8dd509f5:

    # mc "Uhh... what?"
    mc "呃……干啥啊？"

# game/emmasoloending.rpy:2243
translate chinese emmaroleplay_e8be63ad:

    # ju "Are you blind?! Look here, you dimwit!"
    ju "你瞎了吗？！往这看，弱智！"

# game/emmasoloending.rpy:2244
translate chinese emmaroleplay_32a41c85:

    # mc "Uhh... a wedding ring?"
    mc "呃……结婚戒指？"

# game/emmasoloending.rpy:2245
translate chinese emmaroleplay_6410ac01:

    # ju "Yes!"
    ju "对！"

# game/emmasoloending.rpy:2248
translate chinese emmaroleplay_ca4427b9:

    # mc "How the hell am I supposed to know?! You've always worn a shit ton of rings, you bite-size!"
    mc "我上哪知道去啊？！你一直都戴一大堆戒指，你个小矮子！"

# game/emmasoloending.rpy:2249
translate chinese emmaroleplay_8b716f39:

    # e "Why you two are the way you are..."
    e "你俩这是搞什么啊……"

# game/emmasoloending.rpy:2252
translate chinese emmaroleplay_2c165948:

    # "*incomprehensible quarreling*"
    "*无法辨认的吵架声*"

