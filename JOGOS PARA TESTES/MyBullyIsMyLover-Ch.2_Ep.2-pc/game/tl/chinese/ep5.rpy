    # mc "{i}Eh? More than just a friend...?{/i}"
    mc "{i}啊？不止是朋友……？{/i}"

# game/ep5.rpy:2732
translate chinese ep5_b9c75c4d:

    # mc "{i}Ahhh... She means like her prince or something, right?{/i}"
    mc "{i}啊……她的意思是我是她的王子还是什么来着，对吧？{/i}"

