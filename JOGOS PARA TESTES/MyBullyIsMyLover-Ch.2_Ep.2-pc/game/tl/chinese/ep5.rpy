translate chinese ep5_8de38b2b:

    # h "Aine and I will leave for now. We will come back later in the afternoon, alright?"
    h "我和艾妮现在要先走了。我们下午会再回来，好吗？"

# game/ep5.rpy:1350
translate chinese ep5_98988565_4:

    # em "Mhm..."
    em "嗯……"

# game/ep5.rpy:1351
