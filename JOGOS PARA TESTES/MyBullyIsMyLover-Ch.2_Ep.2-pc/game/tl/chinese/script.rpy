    # yt "*sigh*...Why the hell did it have to rain all of a sudden? Now I'm drenched!"
    yt "*叹气*……怎么突然就下雨了？我都成落汤鸡了！"

# game/script.rpy:347
translate chinese ep1_6b5624c1:

    # yt "I better take a bath right away or I'll catch a cold for sure."
    yt "得赶紧洗个澡，不然肯定要感冒。"

# game/script.rpy:355
translate chinese ep1_a2ab453b:

    # yt "Alright, let's give these burgers to Sky."
    yt "OK，把汉堡给斯凯送去吧。"

# game/script.rpy:364
translate chinese ep1_774e4b54_1:

    # "*knocks*"
    "*敲门*"

# game/script.rpy:365
translate chinese ep1_afdd6450:

    # mc "Sky? Are you in there?"
    mc "斯凯？你在吗？"

# game/script.rpy:366
translate chinese ep1_fbf00421:

    # s "Yeah! Just come in!"
    s "在！进来吧！"

# game/script.rpy:367
translate chinese ep1_21c40418:

    # mc "Oh, alright..."
    mc "好……"

# game/script.rpy:378
translate chinese ep1_eb87a6b7:

    # mc "W-what the hell, Sky?! Why did you let me in when you're naked?!"
    mc "你——你搞什么啊，斯凯？！你怎么衣服都没穿就让我进来啊？！"

# game/script.rpy:381
translate chinese ep1_f887f885:

    # s "Why are you reacting like that? You've seen me naked several times before! I'm just changing my clothes!"
    s "你这什么反应啊？你都看过我光着身子多少遍了！我只是换个衣服！"

# game/script.rpy:382
translate chinese ep1_fd7762ed:

    # s "In fact, we already-"
    s "再说了，我们连——"

# game/script.rpy:385
translate chinese ep1_20b680f9:

    # mc "Shhhh! Don't remind me of that! That was just an accident, right?! An accident!"
    mc "停！你可别再提那事了！那纯粹是意外，好吧？！意外！"

# game/script.rpy:386
translate chinese ep1_c7878314:

    # s "Alright, if you say so~"
    s "行吧行吧，你说是就是咯~"

# game/script.rpy:389
translate chinese ep1_dc1cd401:

    # s "Hm?"
    s "嗯？"

# game/script.rpy:390
translate chinese ep1_af30783d:

