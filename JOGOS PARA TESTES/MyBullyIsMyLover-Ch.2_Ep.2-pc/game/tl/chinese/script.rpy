# game/script.rpy:1289
translate chinese skyfirsttime_732a8756_1:

    # a "......"
    a "…………"

# game/script.rpy:1293
translate chinese skyfirsttime_907a5170:

    # mc "WHAT?!!" with hpunch
    mc "什么？！！！" with hpunch

# game/script.rpy:1302
translate chinese skyfirsttime_88831506:

    # a "*whispers* Be quiet!"
    a "*低语* 小声点！"

# game/script.rpy:1342
translate chinese skyfirsttime_f9156af2:

    # e "Hey there, fatso..."
    e "你好啊，肥仔……"

# game/script.rpy:1350
translate chinese skyfirsttime_eceef044:

    # e "Stop it, I know it's you."
    e "别装了，我知道是你。"

# game/script.rpy:1351
translate chinese skyfirsttime_8ed72226:

    # mc "So, you knew all along?!"
    mc "所以，你一直都知道？！"

# game/script.rpy:1353
translate chinese skyfirsttime_e1cd00ac:

    # mc "Then, why are you here?! Are you going to-"
    mc "那，你来这是干嘛的？你是要——"

# game/script.rpy:1355
translate chinese skyfirsttime_0e638d89:

    # mc "I haven't even finished my sentence, yet!"
    mc "我的话还没说完呢！"

# game/script.rpy:1356
translate chinese skyfirsttime_6bc5ff22:

    # mc "Then why come and move in here?"
    mc "那为什么要搬来？"

# game/script.rpy:1371
translate chinese skyfirsttime_794c237f:

    # e "Aine, changed? You just misunderstood her, fatso."
    e "艾妮，变了？是你误会她了，肥仔。"

# game/script.rpy:1374
translate chinese skyfirsttime_91bd7801:

    # e "The Aine that you're seeing right now is the real her."
    e "你现在看到的艾妮才是真正的艾妮。"

# game/script.rpy:1375
translate chinese skyfirsttime_7f8b3e64:

    # e "She didn't change, fatso."
    e "她一点也没变，肥仔。"

# game/script.rpy:1380
translate chinese skyfirsttime_ac7a5ddb:

    # mc "Pff... Bummer."
    mc "啧……烦人。"

# game/script.rpy:1382
translate chinese skyfirsttime_1849ee1f:

    # e "Just what the words say."
    e "就是字面意思。"

# game/script.rpy:1383
translate chinese skyfirsttime_4ea48b6e:

    # e "She did all those things to hide her real self away."
    e "她做的所有事都是为了隐藏真正的自我。"

# game/script.rpy:1384
translate chinese skyfirsttime_c0e2b35e:

    # mc "Hide her real self? You're not making any sense, Emma."
    mc "隐藏真正的她？你这话说得狗屁不通，艾玛。"

# game/script.rpy:1385
translate chinese skyfirsttime_4861e0e2:

    # mc "How are bullying me and hurting every guy's feelings relevant to that?"
    mc "每天霸凌我还有羞辱别的男生跟你说的那些有什么关系？！"

# game/script.rpy:1392
translate chinese skyfirsttime_12ae734d:

    # e "Kind of..."
    e "算是吧……"

# game/script.rpy:1394
translate chinese skyfirsttime_51d793c7:

    # yt "I don't want to believe her, but now that I've interacted with Aine without her knowing who I am..."
    yt "我不想相信她的话，但刚刚在艾妮没有认出我的情况下跟她说过话之后……"

# game/script.rpy:1395
translate chinese skyfirsttime_0c112ee9:

    # yt "...she may actually be right."
    yt "……她可能确实没有骗我。"

# game/script.rpy:1402
translate chinese skyfirsttime_6c47ab15:

    # mc "After everything that happened?!"
    mc "她们那时候那么对我，现在居然把我忘了？！"

# game/script.rpy:1404
translate chinese skyfirsttime_626644aa:

    # mc "Well, no. But something..."
    mc "好吧，是没有。但也有……"

# game/script.rpy:1406
translate chinese skyfirsttime_8026e3f2:

    # mc "...Nevermind."
    mc "……算了。"

# game/script.rpy:1407
translate chinese skyfirsttime_14088c86:

    # e "Time flies. As the days and years go by, people forget about things and people change."
    e "光阴似箭啊。时间流逝，人就是会遗忘和改变的。"

# game/script.rpy:1409
translate chinese skyfirsttime_302af83e:

    # e "I know you are not that stupid."
    e "我知道你没那么蠢。"

# game/script.rpy:1412
translate chinese skyfirsttime_0a0c7584:

    # mc "*chuckles* So I was actually right about you being her servant."
    mc "*笑* 那看来我猜的还真没错，你果然是她的仆人。 "

# game/script.rpy:1414
translate chinese skyfirsttime_b92963fd:

    # e "I was appointed by her mother to serve her, as members of my family have done for generations."
    e "她的母亲指派我去服侍她，这也是我的家族数代以来的传统。"

# game/script.rpy:1416
translate chinese skyfirsttime_5d99a938:

    # mc "Jeez, what a bigshot! I never thought of Aine having a family like that!"
    mc "天啊，这么劲爆！我从来不知道艾妮还有这样的家庭背景！"

# game/script.rpy:1418
translate chinese skyfirsttime_c33c18d4:

    # e "Aine never liked how her family does things."
    e "艾妮一点也不喜欢她的家族的行事风格。"

# game/script.rpy:1419
translate chinese skyfirsttime_f55f2d72:

    # e "She might have lived in a mansion with the power to get anything she wanted, but she was like a prisoner."
    e "虽然她住在大宅子里，想要什么就有什么，但她其实只是被关在家里的囚徒。"

# game/script.rpy:1422
translate chinese skyfirsttime_e155d6f4:

    # e "So, when she finished her college degree, she decided to force herself out of that place."
    e "所以，在大学毕业以后，她决定跟家里一刀两断。"

# game/script.rpy:1423
translate chinese skyfirsttime_b0dfe69e:

    # e "As her servant, I must be always by her side."
    e "作为她的仆人，我必须时刻伴她左右。"

# game/script.rpy:1426
translate chinese skyfirsttime_82aedbff:

    # e "Her mother agreed to it."
    e "她的母亲也同意了。"

# game/script.rpy:1427
translate chinese skyfirsttime_eb972265:

    # e "...Somehow."
    e "……也不知道为什么她会同意。"

# game/script.rpy:1433
translate chinese skyfirsttime_b742b102:

    # e "You were part of it since the start."
    e "你从一开始就已经是这一切的一部分了。"

# game/script.rpy:1434
translate chinese skyfirsttime_d6f7cf0f:

    # e "Furthermore, it wasn't a coincidence that we chose to live here."
    e "而且，我们会住到这里来也不是巧合。"

# game/script.rpy:1449
translate chinese skyfirsttime_a431d8c6:

    # e "I want to save y-"
    e "我想救你——"

# game/script.rpy:1450
translate chinese skyfirsttime_ffae5429:

    # e "I want to save Aine and you're going to help me. Even if you turn me down, I will still bug you until you say yes."
    e "……我想救……妮……艾妮。你必须帮我。即使你拒绝了我，我也会每天来找你，直到你同意为止。"

# game/script.rpy:1455
translate chinese skyfirsttime_ad6e165b_1:

    # e "......"
    e "…………"

# game/script.rpy:1502
translate chinese emmapause_e8c53f77:

    # mc "WHAT THE HECK DID YOU JUST SAY?!" with hpunch
    mc "你说什么玩意儿？！" with hpunch

# game/script.rpy:1506
translate chinese emmapause_6191a4e5:

    # mc "Me? Marrying the girl who bullied me in highschool?! That's the most ridiculous idea I've heard in my entire life, you know that?!"
    mc "我？跟高中一直霸凌我的女生结婚？！这是我长这么大听到的最扯淡的事了，你知道吗？！"

# game/script.rpy:1508
translate chinese emmapause_d20dc88d:

    # e "No, I'm serious."
    e "不，我很认真。"

# game/script.rpy:1510
translate chinese emmapause_15161530:

    # mc "You're really serious about it?!"
    mc "你真的没在开玩笑？！"

# game/script.rpy:1511
translate chinese emmapause_3c86734a:

    # mc "Why me?! There are a lot of people out there who have a lot more potential to be her husband! I'm just a nobody, Emma!"
    mc "为什么是我？！这世界上更适合做她老公的男人多了去了！我就是个普通人，艾玛！"

# game/script.rpy:1519
translate chinese emmapause_e3f0d5df:

    # e "I plan to hide Aine after you get married."
    e "我打算在你们结婚之后把艾妮藏起来。"

# game/script.rpy:1520
translate chinese emmapause_1ff17cc4:

    # e "You don't have a name in industry or commerce, so it will be hard for her family to find her."
    e "你在商界和各种行当里都默默无闻，所以她的家人更不容易找到她。"

# game/script.rpy:1521
translate chinese emmapause_57df5402:

    # mc "Is that the whole reason?"
    mc "原因就这些？"

# game/script.rpy:1522
translate chinese emmapause_ff356ffa:

    # mc "I find that plan stupid! You're an investigator, aren't you?"
    mc "那你这个计划可真蠢！你这样也算是个侦探吗？"

# game/script.rpy:1523
translate chinese emmapause_ffb91b16:

    # e "No, that's not all."
    e "不，还不止这些。"

# game/script.rpy:1525
translate chinese emmapause_86090e8f:

    # e "She made you suffer, but you didn't try to refuse and fight back."
    e "她让你吃了很多苦，但你没有拒绝过她，也没有反击过。"

# game/script.rpy:1526
translate chinese emmapause_488f08c2:

    # e "Because deep down, your feelings for her were, and still are stronger than your anger."
    e "因为在你心里，你对她的感情不管是过去还是现在都压过了你的愤怒。"

# game/script.rpy:1531
translate chinese emmapause_f8cd6032:

    # mc "However, I'm not that guy anymore, Emma. The {b}me{/b} of the past is long gone, and that includes my feelings for Aine."
    mc "但是，我不再跟以前一样了，艾玛。过去的那个{b}我{/b}早就消失了，我对艾妮的感情也是一样。"

# game/script.rpy:1534
translate chinese emmapause_1289edb0:

    # mc "I know I should've done that because of what you guys did to me."
    mc "我知道就凭你们之前那样对我，我就该轰走你们。"

# game/script.rpy:1535
translate chinese emmapause_990a1390:

    # mc "But I'm not a douchebag who'd do that."
    mc "但我不是个能做出那种事情的烂人。"

# game/script.rpy:1536
translate chinese emmapause_208e01b8:

    # mc "However, I can't just let you enter here and suddenly tell me that I need to marry the girl who once made me suffer, Emma!"
    mc "无论如何，我都不可能就这么答应跟以前让我吃尽苦头的女生结婚，艾玛！"

# game/script.rpy:1554
translate chinese emmapause_0b5b378b:

    # yt "That is, if she hadn't done anything to me back then."
    yt "当然了，那得是她以前没有那样欺负过我才行。"

# game/script.rpy:1555
translate chinese emmapause_9b96bd65:

    # yt "I can't just marry a girl that I have a bad history with! That's just... weird!"
    yt "我怎么可能跟以前欺负我的那个女生结婚！那也太……奇怪了！"

# game/script.rpy:1556
translate chinese emmapause_9d886fcf:

    # yt "What's more..."
    yt "而且……"

# game/script.rpy:1557
translate chinese emmapause_91854c89:

    # yt "Everything is just too sudden. And I bet she doesn't even know about this plan at all..."
    yt "一切都太突然了。我甚至可以肯定艾妮根本对艾玛的计划一无所知……"

# game/script.rpy:1580
translate chinese emmapause_7f03be9a:

    # e "I know that. But I told you, she doesn't have any control over her life decisions."
    e "我知道。但我已经告诉过你了，艾妮对自己的人生完全没有决定权。"

# game/script.rpy:1581
translate chinese emmapause_c17d94e5:

    # e "Her family will eventually force her to agree with it."
    e "她家里人总会想办法强迫她同意的。"

# game/script.rpy:1582
translate chinese emmapause_5ed59b1e:

    # e "No one could stop them from doing so, they always have a way through the law. That's how powerful her family is."
    e "谁也阻止不了他们，他们总能想办法钻法律的空子。她的家族就是这么有权势。"

# game/script.rpy:1583
translate chinese emmapause_23a894a5:

    # mc "What a messed-up family she has!"
    mc "她家里都是些什么人啊！"

# game/script.rpy:1584
translate chinese emmapause_cd37c2d4:

    # mc "Then, how about you? You were appointed by her family right? Are you okay with betraying their trust?"
    mc "那你呢？你不是被她的家族派去服侍艾妮的吗？你就这么背叛她们对你的信任？"

# game/script.rpy:1592
translate chinese emmapause_a63a43df:

    # mc "I may be soft hearted..."
    mc "我确实心肠很软……"

# game/script.rpy:1593
translate chinese emmapause_a3e2af3e:

    # mc "But, that doesn't deny the fact that you two gave me a hard time before. So I can't trust you in any way."
    mc "但这也改变不了你们俩以前霸凌我的事实。所以我怎么也不能信任你们。"

# game/script.rpy:1594
translate chinese emmapause_54d4952d:

    # e "Fair enough."
    e "我理解。"

# game/script.rpy:1595
translate chinese emmapause_aa18c12f:

    # mc "Also, I have a few conditions if you want me in this stupid plan of yours."
    mc "还有，如果你想让我也加入你这蠢计划的话，我还有几个条件。"

# game/script.rpy:1601
translate chinese emmapause_3adcc12d:

    # mc "Lastly, stop calling me 'fatso' and call me by my name."
    mc "还有，不准再叫我“肥仔”，用我的名字称呼我。"

# game/script.rpy:1604
translate chinese emmapause_a1779025:

    # e "H-huh? B-but... I..."
    e "啊？可——可是……我……"

# game/script.rpy:1606
translate chinese emmapause_a8a52dae:

    # mc "Then, you won't see me do anything."
    mc "那我什么忙也不会帮的。"

# game/script.rpy:1607
translate chinese emmapause_929bdd6d:

    # e "A-alright... I will..."
    e "好——好吧……我答应你……"

# game/script.rpy:1608
translate chinese emmapause_f913bced:

    # e "[mc!t]..."
    e "[mc!t]……"

# game/script.rpy:1610
translate chinese emmapause_ccc61f78:

    # e "{i}Saying his name once was okay, but twice is just..."
    e "{i}只说一次他的名字，我倒还能忍得住……但假如要说第二次，就……"

# game/script.rpy:1611
translate chinese emmapause_ebd64060:

    # e "{i}I-I can't let him see me like this, but I don't have a choice..."
    e "{i}我——我不能让他看见我这样，但我也别无选择了……"

# game/script.rpy:1624
translate chinese emmapause_0668e85b:

    # e "{i}......{/i}"
    e "{i}…………{/i}"

# game/script.rpy:1627
translate chinese emmapause_7d9d137a:

    # e "{i}That was... the first time I ever talked to him without Aine beside me. That took all the courage I have...{/i}"
    e "{i}这是……我第一次在艾妮不在身边的情况下跟他说话。花光了我所有的勇气……{/i}"

# game/script.rpy:1628
translate chinese emmapause_62c8004b:

    # e "{i}I feel so spent..."
    e "{i}我甚至觉得都累坏了……"

# game/script.rpy:1635
translate chinese emmapause_b9dc28c9:

    # k "I didn't expect you to ask my permission for something like that."
    k "我可没想到你会求我同意那种事。"

# game/script.rpy:1636
translate chinese emmapause_b6916665:

    # k "You're a strange one, aren't you?"
    k "你可真奇怪。"

# game/script.rpy:1641
translate chinese emmapause_e4ceaa91:

    # k "I am a grown up woman, Emma."
    k "我可是过来人了，艾玛。"

# game/script.rpy:1642
translate chinese emmapause_9e3baabc:

    # k "Did you think I wouldn't notice as you kept checking on [mc!t] before?"
    k "你以为你以前经常来问[mc!t]的近况的时候我没有注意到吗？"

# game/script.rpy:1643
translate chinese emmapause_75d20cab:

    # k "I agreed on keeping your secret as I thought you would do something about it yourself, but you failed..."
    k "我同意保守你的秘密，是因为我觉得你会自己想到什么办法，但你失败了……"

# game/script.rpy:1644
translate chinese emmapause_bf6e04ad:

    # k "You are intelligent, yet too innocent."
    k "你很聪明，但太单纯了。"

# game/script.rpy:1648
translate chinese emmapause_9c14ffd6:

    # k "I wasn't able to personally confront you girls about [mc!t] before, since I was always away due to the nature of my work."
    k "因为我工作的原因，那时候我没法去和你们当面对质，谈[mc!t]的事。"

# game/script.rpy:1649
translate chinese emmapause_ba97aa03:

    # k "And that... is something I deeply and will forever regret as his [landlady!t]."
    k "而那也是我作为他的[landlady!t]一辈子都难以忘怀、深深后悔的事。"

# game/script.rpy:1650
translate chinese emmapause_ac01c5fb:

    # k "Even after everything stopped when I escalated it to the school's deciplinary committee, you still contacted me and kept on apologizing."
    k "在我向学校的纪律委员会举报，一切都已经停止以后，你还是来联系了我，不停向我道歉。"

# game/script.rpy:1652
translate chinese emmapause_8aaa60dd:

    # k "That is enough for me to know that you have something for my [tenant!t]."
    k "这就足够让我看出你对我的[tenant!t]有特别的感情了。"

# game/script.rpy:1656
translate chinese emmapause_efd26731:

    # k "You can't even deny it."
    k "你根本没法否认吧。"

# game/script.rpy:1657
translate chinese emmapause_c6af00eb:

    # k "I was extremely confused by you. You were giving my [tenant!t] a hard time, so why did you show concern for him."
    k "一开始我真的搞不懂你在想什么。明明你一直在欺负我[tenant!t]，干嘛还要一直关心他？"

# game/script.rpy:1658
translate chinese emmapause_580af4ee:

    # k "However, I understood as soon as I did some research and learned about you and your family's history."
    k "但是，在我研究了你和你家族的历史之后，立马就明白了一切。"

# game/script.rpy:1660
translate chinese emmapause_4529adc3:

    # k "If ever [mc!t] and your friend get married, then what about you?"
    k "假如你的朋友和[mc!t]真的结婚了，那你怎么办呢？"

# game/script.rpy:1661
translate chinese emmapause_af3cfb74:

    # k "You can't just hide it away forever, Emma."
    k "你不可能一辈子都藏着掖着的，艾玛。"

# game/script.rpy:1662
translate chinese emmapause_c496178d:

    # k "That will only make you suffer."
    k "只会让你不断地痛苦而已。"

# game/script.rpy:1665
translate chinese emmapause_dab2289f:

    # e "I did this to myself, Miss Klara. I am nothing but a servant now..."
    e "这都是我自找的，克拉拉太太。我现在只是个低贱的奴仆……"

# game/script.rpy:1666
translate chinese emmapause_26296101:

    # k "What do you mean?"
    k "你这是什么意思？"

# game/script.rpy:1669
translate chinese emmapause_d094b044:

    # k "*sighs* Well then, about the marriage..."
    k "*叹气* 好吧，关于结婚的事……"

# game/script.rpy:1672
translate chinese emmapause_3b6cf9b4:

    # k "What's more... how can they even get married if their relationship is in such a mess?"
    k "而且……以他们现在的关系，怎么可能结婚呢？"

# game/script.rpy:1673
translate chinese emmapause_3f88a4cf:

    # e "I... don't know..."
    e "我……不知道……"

# game/script.rpy:1675
translate chinese emmapause_721fff29:

    # k "......"
    k "…………"

# game/script.rpy:1676
translate chinese emmapause_adba05f8:

    # k "..........."
    k "……………………"

# game/script.rpy:1677
translate chinese emmapause_9bff093b:

    # e "Miss Klara?"
    e "克拉拉太太？"

# game/script.rpy:1681
translate chinese emmapause_0bfacd8d:

    # k "I will open my doors to you."
    k "你们就住到我家去。"

# game/script.rpy:1685
translate chinese emmapause_a11ff884:

    # k "Right now, he's a bit blinded with what you did to him, but there is something he did wrong himself and he needs to realize that."
    k "现在，他有些被你们以前对他做的事情蒙蔽了双眼。但他也有不对的地方，必须要让他认识到这一点。"

# game/script.rpy:1686
translate chinese emmapause_aad040b5:

    # k "So this is a chance to fix your mistakes and redeem yourselves to each other."
    k "这就是你们弥补错误，互相救赎的机会。"

# game/script.rpy:1687
translate chinese emmapause_f2fda7fa:

    # k "You are all grown up now, be mature."
    k "你们都已经是大人了，要成熟。"

# game/script.rpy:1688
translate chinese emmapause_acb0c8c6:

    # k "And I just want to let you know that I do not agree with your idea."
