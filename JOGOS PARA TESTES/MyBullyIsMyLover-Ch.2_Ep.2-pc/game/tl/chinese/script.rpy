    # l "Shina~! Wait for meee~!"
    l "希娜~！等等我~！"

# game/script.rpy:333
translate chinese ep1_c63fd5d8:

    # sh "Hi, Lily!"
    sh "嗨，莉莉！"

# game/script.rpy:334
translate chinese ep1_6f510449:

    # l "Are we heading to class now?"
    l "我们现在要去上课吗？"

# game/script.rpy:335
translate chinese ep1_6540a484:

    # sh "Of course, you silly. Where else would we go? *giggles*"
    sh "肯定啊，笨蛋。不然去干嘛？ *笑*"

# game/script.rpy:336
translate chinese ep1_fc15b24d:

    # l "Well, you might want to watch a series on Netflix on your cell phone before we head to class. We still have an hour and a half."
    l "上课之前我们可以一起看网飞上的电视剧！还有一个半小时的时间呢。"

# game/script.rpy:337
translate chinese ep1_76ae6834:

    # sh "Oh, right! Now that you mention it, there's this series my boyfriend and I discovered just yesterday, and it's pretty amazing! I'm sure you'll like it."
    sh "哦，对啊！你一说我想起来了，我跟我男朋友昨天发现了一部剧，特别特别好看！你肯定也爱看！"

# game/script.rpy:338
translate chinese ep1_c70e2df4:

    # l "Yeah, sure! Let's try it!"
    l "那当然啊！一起看吧！"

# game/script.rpy:346
