translate chinese ch2ep2_eea934f2:

    # e "Which part?"
    e "哪里跟你一样？"

# game/ch2ep2.rpy:106
translate chinese ch2ep2_bc7c549b:

    # e "Is that supposed to help me guess?"
    e "你这算是在回答我的问题吗？"

# game/ch2ep2.rpy:109
translate chinese ch2ep2_53d3333f:

