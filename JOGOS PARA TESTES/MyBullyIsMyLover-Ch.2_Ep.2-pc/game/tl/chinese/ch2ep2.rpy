    # g "I AM blinking, Moon! Just quit asking if I'm fine!" with hpunch
    g "我有眨眼，月！别再问我有没有事了！" with hpunch

# game/ch2ep2.rpy:260
translate chinese ch2ep2_d4ceaded:

    # m "... Okay."
    m "……好。"

# game/ch2ep2.rpy:266
translate chinese ch2ep2_2376fac5:

    # g "Sorry."
    g "对不起。"

# game/ch2ep2.rpy:272
translate chinese ch2ep2_352b9c44:

    # g "Claire didn't even sugarcoat it."
    g "克莱尔说得太直白了。"

# game/ch2ep2.rpy:273
