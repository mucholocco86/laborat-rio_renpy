    # e "Yeah..."
    e "是啊……"

# game/ch2ep2.rpy:5675
translate chinese sktabdinwikcont_b44f8a58:

    # ju "Stay away from her, Emma."
    ju "先不要管她了，艾玛。"

# game/ch2ep2.rpy:5676
translate chinese sktabdinwikcont_f9a344a8:

    # ju "Until this is sorted. Stay away."
    ju "直到这件事被完全解决为止。"

# game/ch2ep2.rpy:5677
translate chinese sktabdinwikcont_72a33094_96:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5678
translate chinese sktabdinwikcont_cf1b8d4b:

    # ju "I mean it."
    ju "我是认真的。"

# game/ch2ep2.rpy:5680
