    e "因为{b}我{/b}。"

# game/ch2ep2.rpy:5684
translate chinese sktabdinwikcont_86eadbbc:

    # le "... I'm sorry."
    le "……对不起。"

# game/ch2ep2.rpy:5685
translate chinese sktabdinwikcont_48fd1dcf:

    # e "Don't be."
    e "不用道歉。"

# game/ch2ep2.rpy:5687
translate chinese sktabdinwikcont_23967e54_1:

    # le "Will I see you again?"
    le "我还能再见到你吗？"

# game/ch2ep2.rpy:5688
translate chinese sktabdinwikcont_72a33094_97:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5690
translate chinese sktabdinwikcont_92f16cc0_6:

    # e "Yeah."
    e "会的。"

# game/ch2ep2.rpy:5691
