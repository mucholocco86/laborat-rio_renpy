translate chinese ch2ep2_7a1ebb7b:

    # e "Why? What about her?"
    e "为什么？她怎么了？"

# game/ch2ep2.rpy:101
translate chinese ch2ep2_75204f30:

    # mc "Just... trying to teach her not to be me."
    mc "我只是……不想让她跟我一样。"

