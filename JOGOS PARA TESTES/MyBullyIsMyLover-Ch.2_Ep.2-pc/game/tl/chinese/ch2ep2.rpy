    # e "..."
    e "……"

# game/ch2ep2.rpy:5670
translate chinese sktabdinwikcont_04352a80:

    # ju "I'm still required to file the report. About the placement, and what you did."
    ju "我还是得交一份报告上去。这次寄养的结果，还有你做的事，都会写进去。"

# game/ch2ep2.rpy:5671
