    # ju "I'll be in touch."
    ju "我之后再联系你们。"

# game/ch2ep2.rpy:5668
translate chinese sktabdinwikcont_869080e4:

    # ju "You know this goes on record."
    ju "你想必很清楚，这件事会写进你的档案里。"

# game/ch2ep2.rpy:5669
