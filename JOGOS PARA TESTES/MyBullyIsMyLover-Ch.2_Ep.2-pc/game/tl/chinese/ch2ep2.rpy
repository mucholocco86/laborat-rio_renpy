# game/ch2ep2.rpy:3790
translate chinese sktabdinwikcont_6225666a_2:

    # mc "*exhales*"
    mc "*叹气*"

# game/ch2ep2.rpy:3791
translate chinese sktabdinwikcont_b7a951a7:

    # ju "Is she inside?"
    ju "她在里面吗？"

# game/ch2ep2.rpy:3792
translate chinese sktabdinwikcont_cf1adef2_4:

    # mc "Yeah."
    mc "嗯。"

# game/ch2ep2.rpy:3793
translate chinese sktabdinwikcont_6274dc51:

    # ju "Did they talk?"
    ju "她们聊了没？"

# game/ch2ep2.rpy:3794
translate chinese sktabdinwikcont_c4c6ef13:

    # mc "Don't know. Doubt it."
    mc "不知道。估计没有。"

# game/ch2ep2.rpy:3797
translate chinese sktabdinwikcont_7863c8f0:

    # ju "Leah."
    ju "莉娅。"

# game/ch2ep2.rpy:3798
translate chinese sktabdinwikcont_8f6f5bdf_3:

    # le "Mm."
    le "嗯。"

# game/ch2ep2.rpy:3799
translate chinese sktabdinwikcont_4d61a7aa:

    # ju "I need to talk to you about something. Is that okay?"
    ju "我有事想和你说。可以吗？"

# game/ch2ep2.rpy:3800
translate chinese sktabdinwikcont_69f6b145_7:

    # le "Okay."
    le "可以。"

# game/ch2ep2.rpy:3802
translate chinese sktabdinwikcont_da686fb4:

    # ju "So... I've got some news."
    ju "我……有消息要告诉你。"

# game/ch2ep2.rpy:3803
translate chinese sktabdinwikcont_c3c32ef0:

    # ju "Good news, actually."
    ju "是好消息。"

# game/ch2ep2.rpy:3804
translate chinese sktabdinwikcont_98741ac3_17:

    # le "..."
    le "……"

# game/ch2ep2.rpy:3805
translate chinese sktabdinwikcont_b4a30f0b:

    # ju "You know how we've been looking for a place for you to stay, right? Somewhere a little more... permanent than here."
    ju "你也知道我们一直在给你找去处，对吧？比这里……更能待得长久的地方。"

# game/ch2ep2.rpy:3806
translate chinese sktabdinwikcont_8f6f5bdf_4:

    # le "Mm."
    le "嗯。"

# game/ch2ep2.rpy:3807
translate chinese sktabdinwikcont_8e91415e:

    # ju "Well, we found one. A family. They live up on the north side—really nice neighborhood."
    ju "我们找到了。是住在北边的一家人——那一带环境很不错的。"

# game/ch2ep2.rpy:3808
translate chinese sktabdinwikcont_6b363dd0:

    # ju "I've met them myself. They're really good people, Leah."
    ju "我亲眼见过他们。他们都是很好的人，莉娅。"

# game/ch2ep2.rpy:3809
translate chinese sktabdinwikcont_b332b0ce:

    # ju "They've had kids stay with them before. Kids who've been through a lot, same as you."
    ju "他们以前也照顾过其他小朋友。跟你一样经历过很多的小朋友。"

# game/ch2ep2.rpy:3810
translate chinese sktabdinwikcont_5f6c78c4:

    # ju "And they're... really excited to meet you."
    ju "他们……都等不及想见到你了。"

# game/ch2ep2.rpy:3811
translate chinese sktabdinwikcont_f0dd35a2:

    # ju "You'd have your own room. You can bring everything with you—Gerald, your diary, all of it."
    ju "你会有个自己的房间。可以把东西都带过去——杰罗德，你的日记，全都可以。"

# game/ch2ep2.rpy:3812
translate chinese sktabdinwikcont_c71f2639:

    # ju "It's not forever. Just... for now, until we find the right permanent fit."
    ju "你不会一直待在那里的。只是……暂时的，直到我们给你找到合适的归宿。"

# game/ch2ep2.rpy:3813
translate chinese sktabdinwikcont_cbc62ccc:

    # ju "Think of it like... the next step."
    ju "你就当……是个过渡。"

# game/ch2ep2.rpy:3814
translate chinese sktabdinwikcont_98741ac3_18:

    # le "..."
    le "……"

# game/ch2ep2.rpy:3815
translate chinese sktabdinwikcont_52272d2a:

    # le "When?"
    le "什么时候走？"

# game/ch2ep2.rpy:3816
translate chinese sktabdinwikcont_e679aa83:

    # ju "It's tomorrow."
    ju "明天。"

# game/ch2ep2.rpy:3817
translate chinese sktabdinwikcont_98741ac3_19:

    # le "..."
    le "……"

# game/ch2ep2.rpy:3820
translate chinese sktabdinwikcont_2a375933:

    # ju "Do you have any questions?"
    ju "你有什么问题吗？"

# game/ch2ep2.rpy:3821
translate chinese sktabdinwikcont_c99d2e07:

    # le "... Can you leave us?"
    le "……可以让我们两个单独说话吗？"

# game/ch2ep2.rpy:3822
translate chinese sktabdinwikcont_52fc4ea2_7:

    # ju "..."
    ju "……"

# game/ch2ep2.rpy:3826
translate chinese sktabdinwikcont_c36f8e07:

    # ju "I'll be right outside."
    ju "我就在门外等着。"

# game/ch2ep2.rpy:3827
translate chinese sktabdinwikcont_69f6b145_8:

    # le "Okay."
    le "好。"

# game/ch2ep2.rpy:3830
translate chinese sktabdinwikcont_34e886c3:

    # le "You said I'd be okay."
    le "你说过我会没事的。"

# game/ch2ep2.rpy:3831
translate chinese sktabdinwikcont_72a33094_58:

    # e "..."
    e "……"

# game/ch2ep2.rpy:3832
translate chinese sktabdinwikcont_88683938:

    # le "Did you lie?"
    le "你是在骗我吗？"

# game/ch2ep2.rpy:3833
translate chinese sktabdinwikcont_89ec08e7_2:

    # e "Leah?"
    e "莉娅？"

# game/ch2ep2.rpy:3834
translate chinese sktabdinwikcont_7cbe0f6d:

    # le "Did you lie to me?"
    le "你有没有骗我？"

# game/ch2ep2.rpy:3835
translate chinese sktabdinwikcont_f4fe4a45:

    # e "The placement is temporary. June vetted the family personally—"
    e "只是暂时住在那里。琼亲自确认过那一家——"

# game/ch2ep2.rpy:3836
translate chinese sktabdinwikcont_07f80eaf:

    # le "I don't care about the family."
    le "我不在乎那一家人。"

# game/ch2ep2.rpy:3837
translate chinese sktabdinwikcont_14e546ab:

    # e "They have experience with kids who've been through—"
    e "他们有经验，知道怎么照顾——"

# game/ch2ep2.rpy:3838
translate chinese sktabdinwikcont_a2762689:

    # le "I don't care."
    le "我不在乎。"

# game/ch2ep2.rpy:3839
translate chinese sktabdinwikcont_d8013bdf:

    # e "It's a safe environment. You'll have your own room, your things—"
    e "那里很安全。你有自己的房间，你的东西也——"

# game/ch2ep2.rpy:3840
translate chinese sktabdinwikcont_93de312f:

    # le "Emma... I don't care about the room."
    le "艾玛……我不在乎什么房间。"

# game/ch2ep2.rpy:3841
translate chinese sktabdinwikcont_72a33094_59:

    # e "..."
    e "……"

# game/ch2ep2.rpy:3843
translate chinese sktabdinwikcont_74c3b941:

    # le "Why are they moving me so fast?"
    le "为什么他们这么快就想让我走？"

# game/ch2ep2.rpy:3844
translate chinese sktabdinwikcont_d88df9db:

    # e "It's standard procedure for—"
    e "这是标准的流程——"

# game/ch2ep2.rpy:3845
translate chinese sktabdinwikcont_adbe671a:

    # le "Stop."
    le "别这样。"

# game/ch2ep2.rpy:3846
translate chinese sktabdinwikcont_7e5be565_3:

    # e "What?"
    e "什么？"

# game/ch2ep2.rpy:3847
translate chinese sktabdinwikcont_89bd4a64:

    # le "Stop talking like that."
    le "别这样说话。"

# game/ch2ep2.rpy:3848
translate chinese sktabdinwikcont_3d9faf40:

    # e "Leah, I'm trying to—"
    e "莉娅，我是在——"

# game/ch2ep2.rpy:3849
translate chinese sktabdinwikcont_071e94fc:

    # le "Stop talking like I'm work!"
    le "别说得好像我只是要解决的工作一样！"

# game/ch2ep2.rpy:3851
translate chinese sktabdinwikcont_d5ed613f:

    # e "Leah, I want you to understand that this decision was made with your best interests—"
    e "莉娅，我希望你能明白，这个决定完全是为了你——"

# game/ch2ep2.rpy:3852
translate chinese sktabdinwikcont_2adc92cd:

    # le "You promised."
    le "你保证过的。"

# game/ch2ep2.rpy:3853
translate chinese sktabdinwikcont_1c30c471:

    # e "I didn't promise—"
    e "我没有保证——"

# game/ch2ep2.rpy:3854
translate chinese sktabdinwikcont_e71beee0:

    # le "You said I'd be okay!"
    le "你明明说过我会没事！"

# game/ch2ep2.rpy:3855
translate chinese sktabdinwikcont_18b40a44:

    # e "And you will be. The placement is—"
    e "你当然会没事啊。这也只是——"

# game/ch2ep2.rpy:3856
translate chinese sktabdinwikcont_f9e0cf09:

    # le "STOP SAYING THAT!"
    le "{b}别再说了！"

# game/ch2ep2.rpy:3858
translate chinese sktabdinwikcont_99111fae:

    # le "You keep saying the same things over and over and none of it is what I'm asking!"
    le "你总是一遍又一遍地重复着同样的话，而且那些话也根本没有回答我的问题！"

# game/ch2ep2.rpy:3859
translate chinese sktabdinwikcont_1e880103:

    # le "I'm asking why you're letting them take me!"
    le "我是问你为什么要同意让他们带走我！"

# game/ch2ep2.rpy:3860
translate chinese sktabdinwikcont_a2c799a1:

    # e "It's not my call to make. That's not how this works—"
    e "这不是我能决定的事。不是你想的——"

# game/ch2ep2.rpy:3861
translate chinese sktabdinwikcont_f7e2ab35:

    # le "Then whose is?!"
    le "那谁可以决定？！"

# game/ch2ep2.rpy:3862
translate chinese sktabdinwikcont_0796255c:

    # e "June's. The system's. There are people whose job it is to—"
    e "琼可以。体制可以。有些人的工作就是——"

# game/ch2ep2.rpy:3863
translate chinese sktabdinwikcont_9d61914b:

    # le "You're a person!"
    le "你也是人啊！"

# game/ch2ep2.rpy:3864
translate chinese sktabdinwikcont_72a33094_60:

    # e "..."
    e "……"

# game/ch2ep2.rpy:3865
translate chinese sktabdinwikcont_ac41a4cb:

    # le "You're right there and you keep saying it's somebody else's job!"
    le "你就在我身边，可却总是说这是别人的工作！"

# game/ch2ep2.rpy:3867
translate chinese sktabdinwikcont_d7ea2518:

    # e "I know this is hard—"
    e "我知道这很难——"

# game/ch2ep2.rpy:3868
translate chinese sktabdinwikcont_390da3ef:

    # le "Then do something!"
    le "那你就做点什么啊！"

# game/ch2ep2.rpy:3869
translate chinese sktabdinwikcont_13df1b24:

    # e "Leah, there's nothing I can—"
    e "莉娅，我什么事都没法——"

# game/ch2ep2.rpy:3870
translate chinese sktabdinwikcont_1e741863:

    # le "YES THERE IS~!"
    le "{b}明明就有！！"

# game/ch2ep2.rpy:3871
translate chinese sktabdinwikcont_72a33094_61:

    # e "..."
    e "……"

# game/ch2ep2.rpy:3872
translate chinese sktabdinwikcont_185dd704:

    # le "You can tell them no!"
    le "你跟他们说你不同意啊！"

# game/ch2ep2.rpy:3873
translate chinese sktabdinwikcont_73091057:

    # le "You can do SOMETHING instead of just standing there talking about procedures and families and ROOMS!"
    le "你明明可以行动起来，却只会在这里说什么程序，家庭，还有{b}房间！"

# game/ch2ep2.rpy:3874
translate chinese sktabdinwikcont_49c77818:

    # le "I don't even know what half of that means!"
    le "我根本都不知道那些词是什么意思！"

# game/ch2ep2.rpy:3876
translate chinese sktabdinwikcont_6b0426fc:

    # e "What do you want from me, Leah?! I said there's nothing—!"
    e "你到底想让我干什么，莉娅？！我说了我无能为力——！"

# game/ch2ep2.rpy:3877
translate chinese sktabdinwikcont_d696863c:

    # le "I want you to fight for me!"
    le "我想让你为了我挺身而出！"

# game/ch2ep2.rpy:3878
translate chinese sktabdinwikcont_72a33094_62:

    # e "..."
    e "……"

# game/ch2ep2.rpy:3879
translate chinese sktabdinwikcont_5a605910:

    # le "You already did once! You ran into that place and got me out!"
    le "已经不是第一次了！你闯进那个地方把我救了出来！"

# game/ch2ep2.rpy:3880
translate chinese sktabdinwikcont_092a25eb:

    # le "So why can't you do it again?!"
    le "为什么就不能再来一次呢？！"

# game/ch2ep2.rpy:3881
translate chinese sktabdinwikcont_38603a44:

    # le "Why won't you, huh...?! Tell me! WHY WON'T YOU~?!"
    le "你为什么不愿意，啊……？！告诉我！{b}为什么你就是不行动？！！！"

# game/ch2ep2.rpy:3883
translate chinese sktabdinwikcont_ca66285d:

    # e "That's the thing..."
    e "你说到点子上了……"

# game/ch2ep2.rpy:3884
translate chinese sktabdinwikcont_a8a59434:

    # e "I wish I never took this case..."
    e "我真希望我从来都没有接手这个案子……"

# game/ch2ep2.rpy:3885
translate chinese sktabdinwikcont_98741ac3_20:

    # le "..."
    le "……"

# game/ch2ep2.rpy:3886
translate chinese sktabdinwikcont_14ed7ed4:

    # e "I wish I never pulled you out of that place..."
    e "我希望我没有把你从那里救出来……"

# game/ch2ep2.rpy:3887
translate chinese sktabdinwikcont_22dc00f5:

    # e "Because then none of this—"
    e "因为这一切全都——"

# game/ch2ep2.rpy:3889
translate chinese sktabdinwikcont_98741ac3_21:

    # le "..."
    le "……"

# game/ch2ep2.rpy:3890
translate chinese sktabdinwikcont_ce752ac8:

    # le "You wish you never saved me?"
    le "你希望你没有把我救出来？"

# game/ch2ep2.rpy:3891
translate chinese sktabdinwikcont_052b88b6:

    # e "That's not what I—"
    e "我不是那个——"

# game/ch2ep2.rpy:3892
translate chinese sktabdinwikcont_dd2279d7:

    # le "That's what you said..."
    le "你就是那么说的……"

# game/ch2ep2.rpy:3893
translate chinese sktabdinwikcont_f03a66df:

    # e "Leah, listen to me—"
    e "莉娅，听我说——"

# game/ch2ep2.rpy:3894
translate chinese sktabdinwikcont_f1c6c900:

    # le "You said you wished you never saved me..."
    le "你说你希望你没有把我救出来……"

# game/ch2ep2.rpy:3895
translate chinese sktabdinwikcont_ffabcb84:

    # e "I meant that I wish I wasn't the one who—"
    e "我的意思是我希望救你的人不是我——"

# game/ch2ep2.rpy:3896
translate chinese sktabdinwikcont_976a299f_1:

    # le "How come?"
    le "为什么？"

# game/ch2ep2.rpy:3897
translate chinese sktabdinwikcont_bf3b18ee:

    # le "How come you wish that?"
    le "你为什么会这么想？"

# game/ch2ep2.rpy:3899
translate chinese sktabdinwikcont_eb59bf4c:

    # e "... Because one day I won't be there anymore. And you'll be the one left behind."
    e "……因为总有一天我会没办法继续陪着你。又会只剩下你一个人。"

# game/ch2ep2.rpy:3900
translate chinese sktabdinwikcont_98741ac3_22:

    # le "..."
    le "……"

# game/ch2ep2.rpy:3901
translate chinese sktabdinwikcont_424266ba:

    # le "I already know people leave..."
    le "已经有不少人离开了……"

# game/ch2ep2.rpy:3902
translate chinese sktabdinwikcont_57a4e905:

    # le "My mom left..."
    le "我妈妈走了……"

# game/ch2ep2.rpy:3903
translate chinese sktabdinwikcont_d4fde4a3:

    # le "My friends didn't want me around just because I'm a little different..."
    le "我的朋友不愿意跟我一起玩，因为我不太合群……"

# game/ch2ep2.rpy:3904
translate chinese sktabdinwikcont_804e83f4:

    # le "But that's not the same as you... You're not leaving because you want to, right?"
    le "可是他们跟你都不一样……你离开不是出于自己的想法，对吗？"

# game/ch2ep2.rpy:3905
translate chinese sktabdinwikcont_72a33094_63:

    # e "..."
    e "……"

# game/ch2ep2.rpy:3906
translate chinese sktabdinwikcont_c30532c8:

    # e "Why, Leah?"
    e "为什么，莉娅？"

# game/ch2ep2.rpy:3907
translate chinese sktabdinwikcont_6772382f:

    # e "Why me?"
    e "为什么偏偏是我？"

# game/ch2ep2.rpy:3908
translate chinese sktabdinwikcont_1f540416:

    # le "Because you feel like you're hurting too."
    le "因为你明明也很难受。"

# game/ch2ep2.rpy:3909
translate chinese sktabdinwikcont_72a33094_64:

    # e "..."
    e "……"

# game/ch2ep2.rpy:3911
translate chinese sktabdinwikcont_2e33ba5b:

    # le "I just want that feeling to stay."
    le "我只是不想让这种感觉消失。"

# game/ch2ep2.rpy:3916
translate chinese sktabdinwikcont_c26a0c62:

    # ju "Leah?"
    ju "莉娅？"

# game/ch2ep2.rpy:3917
translate chinese sktabdinwikcont_dd5984b4:

    # ju "Leah, wait!"
    ju "莉娅，等等！"

# game/ch2ep2.rpy:3918
translate chinese sktabdinwikcont_f1a2da02:

    # ju "You stay here."
    ju "你留在这。"

# game/ch2ep2.rpy:3922
translate chinese sktabdinwikcont_a07099b0:

    # mc "Em? What happened—"
    mc "小艾？怎么回事——"

# game/ch2ep2.rpy:3927
translate chinese sktabdinwikcont_b88ca4b6:

    # le "If something was too big to say out loud, write it down first."
    le "如果有什么事情大到没法好好说出来，就先写下来。"

# game/ch2ep2.rpy:3928
translate chinese sktabdinwikcont_dbea8225_1:

    # le "Words find their way out whether you want them to or not, so it's better to give them somewhere to go."
    le "不管你愿不愿意，文字都会找上门来，所以最好给它们找一个去处。"

# game/ch2ep2.rpy:3931
translate chinese sktabdinwikcont_16b36af0:

    # d "Listen, Emy... Someday, if you can't express what you want to say through words, write a letter just like this."
    d "听好了，艾米……要是有一天，你没法用话语表达自己的感受，就可以像我这样写信。"

# game/ch2ep2.rpy:3932
translate chinese sktabdinwikcont_1a12963e:

    # d "You can say anything you want in a letter. Express your feelings, tell it your problems, anything you want. It's like your friend!"
    d "信里你可以写任何你想说的东西。发泄情绪，倾诉遇到的困难，什么都可以。就像跟你的朋友在说话一样！"

# TODO: Translation updated at 2026-04-22 17:50

# game/ch2ep2.rpy:2661
translate chinese sktabdinwikcont_5e49da24:

    # le "Mm-hm. It feels like I'm sinking."
    le "嗯哼。感觉自己在下沉。"

# game/ch2ep2.rpy:3177
translate chinese sktabdinwikcont_2f5c508c:

    # ela "Okay. Let's keep it simple. How long was Leah with them?"
    ela "很好。那就开门见山吧。莉娅落入他们手里多久了？"

# game/ch2ep2.rpy:3181
translate chinese sktabdinwikcont_d9130cf2:

    # ela "What changed?"
    ela "出了什么变故？"

# game/ch2ep2.rpy:3198
translate chinese sktabdinwikcont_d3aa3e28:

    # ela "You wanted to, but...?"
    ela "你很想相信他，但是……？"

# game/ch2ep2.rpy:3200
translate chinese sktabdinwikcont_b4ece550:

    # ela "Regardless, you took the money."
    ela "总之，你还是收了钱。"

# game/ch2ep2.rpy:3208
translate chinese sktabdinwikcont_3f03d3f5:

    # nad "I tried the number he gave me. Disconnected after the first week. I also went to the address, but it was empty. I didn't know what to do."
    nad "我试着给那个男人留的号码打过电话。一个星期之后就打不通了。我还去了他留的地址，但地址是假的。我不知道该怎么办了。"

# game/ch2ep2.rpy:3238
translate chinese sktabdinwikcont_13f53a15_2:

    # nad "..."
    nad "……"

# game/ch2ep2.rpy:3245
translate chinese sktabdinwikcont_9b7a1a5c:

    # ela "We'll leave it here for now. Someone else will be in shortly to go over next steps."
    ela "就聊到这里吧。之后的事情会有其他人来跟你说。"

# game/ch2ep2.rpy:3310
translate chinese sktabdinwikcont_44892105:

    # le "You smell like coffee again. You should try smelling like something else for a change."
    le "你身上又是咖啡的味道。你应该偶尔也弄点其他的味道。"

# game/ch2ep2.rpy:3331
