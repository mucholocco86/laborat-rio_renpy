# game/ch2ep2.rpy:78
translate chinese ch2ep2_95379fe7:

    # f "Fine, fine... You got it, boss."
    f "行吧行吧……听你的，老板。"

# game/ch2ep2.rpy:79
translate chinese ch2ep2_7b471f6f:

    # mc "Good."
    mc "很好。"

# game/ch2ep2.rpy:82
translate chinese ch2ep2_8ae44548:

    # mc "Alright, we're heading out."
    mc "好了，我们要走了。"

# game/ch2ep2.rpy:83
translate chinese ch2ep2_15259611:

    # f "Yeah, take care."
    f "嗯，慢走。"

