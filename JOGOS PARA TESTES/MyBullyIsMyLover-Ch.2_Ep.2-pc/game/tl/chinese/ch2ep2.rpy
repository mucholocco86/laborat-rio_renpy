translate chinese sktabdinwikcont_5b97f022:

    # e "You could've mentioned she was coming."
    e "你怎么不说她要来。"

# game/ch2ep2.rpy:2441
translate chinese sktabdinwikcont_8f5da0cc:

    # mc "I didn't know she was."
    mc "我也不知道她会来。"

# game/ch2ep2.rpy:2444
