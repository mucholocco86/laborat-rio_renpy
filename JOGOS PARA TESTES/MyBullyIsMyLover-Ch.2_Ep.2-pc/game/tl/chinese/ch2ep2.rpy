translate chinese ch2ep2_c0a24198:

    # e "Thanks. I'll let you off the hook for good behavior this time."
    e "谢谢。看你表现好，这次就放你一马。"

# game/ch2ep2.rpy:118
translate chinese ch2ep2_6d5c6b10:

    # mc "Why, I appreciate it, detective."
    mc "哎呦，谢谢警官。"

# game/ch2ep2.rpy:129
translate chinese ch2ep2_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/ch2ep2.rpy:132
translate chinese ch2ep2_9904f8ad:

