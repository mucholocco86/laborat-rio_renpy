    s "算了。可能是我太久没睡，脑子糊涂了。"

# game/ch2ep2.rpy:220
translate chinese ch2ep2_b0fbcd50:

    # mc "Make sure you get some proper rest tonight."
    mc "你今晚一定要好好休息。"

# game/ch2ep2.rpy:221
translate chinese ch2ep2_1e926fb2:

    # s "*laughs* I hope so."
    s "*笑* 但愿吧。"

# game/ch2ep2.rpy:224
translate chinese ch2ep2_82091822:

    # k "..."
    k "……"

# game/ch2ep2.rpy:227
translate chinese ch2ep2_309d668f:

    # e "Mm! This is so good. I need to stop eating before dinner."
    e "嗯！味道真棒。我以后晚饭之前真的不能再吃东西了。"

# game/ch2ep2.rpy:228
translate chinese ch2ep2_a7cbae10:

    # k "Glad you like it. Want some wine with that?"
    k "你能喜欢就好。要不要配点酒？"

# game/ch2ep2.rpy:229
translate chinese ch2ep2_ebc9fd65:

    # e "I'm good."
    e "不用了。"

# game/ch2ep2.rpy:230
translate chinese ch2ep2_badbfc5a:

    # k "Suit yourself."
    k "听你的。"

# game/ch2ep2.rpy:240
translate chinese ch2ep2_4b5e0e96:

    # m "You okay?"
    m "你没事吧？"

# game/ch2ep2.rpy:243
translate chinese ch2ep2_7edafb73:

    # g "No. I'd be lying if I said I was."
    g "有事。怎么可能没事。"

# game/ch2ep2.rpy:244
translate chinese ch2ep2_89165ff4:

    # m "Want me to drive?"
    m "要不换我开车？"

# game/ch2ep2.rpy:245
translate chinese ch2ep2_94d4e432:

    # g "I'm fine."
    g "不用。"

