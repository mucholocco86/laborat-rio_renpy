    # mc "Hey."
    mc "嘿。"

# game/ch2ep2.rpy:2379
translate chinese sktabdinwikcont_0fba19b8:

    # e "Hm?"
    e "嗯？"

# game/ch2ep2.rpy:2382
translate chinese sktabdinwikcont_1e7b4507:

    # mc "I talked to June."
    mc "我和琼聊了聊。"

# game/ch2ep2.rpy:2383
translate chinese sktabdinwikcont_a3b3b6ab:

    # e "June? About what?"
    e "琼？聊什么？"

# game/ch2ep2.rpy:2384
translate chinese sktabdinwikcont_0d981a1e:

    # mc "About Leah. Whether my charity could take her in. Temporary placement, protective custody."
    mc "聊莉娅。看看能不能让我的慈善组织收养她。暂时的保护性措施。"

# game/ch2ep2.rpy:2387
translate chinese sktabdinwikcont_aa53e115:

    # e "You what?"
    e "你什么？"

# game/ch2ep2.rpy:2388
