    # la "Go ahead."
    la "请讲。"

# game/ch2ep2.rpy:5774
translate chinese sktabdinwikcont_40fec2f0:

    # nic "He's not here."
    nic "他不在这。"

# game/ch2ep2.rpy:5775
translate chinese sktabdinwikcont_7488874f:

    # nic "Most of his men stood down. One didn't. He's been handled."
    nic "他的手下基本都投降了。只有一个反抗，已经处理掉了。"

# game/ch2ep2.rpy:5776
translate chinese sktabdinwikcont_d0b44ad9:

    # mc "What about the location?"
    mc "办公室里是什么情况？"

# game/ch2ep2.rpy:5777
translate chinese sktabdinwikcont_e0996aac:

    # nic "..."
    nic "……"

# game/ch2ep2.rpy:5778
translate chinese sktabdinwikcont_4e8c9817:

    # nic "You're going to want to see this yourself."
    nic "你还是亲自来看吧。"

# game/ch2ep2.rpy:5779
translate chinese sktabdinwikcont_69356c83:

    # mc "Talk to me, Nicky."
    mc "跟我讲讲，妮可。"

# game/ch2ep2.rpy:5780
translate chinese sktabdinwikcont_0d7f6b0f:

    # nic "Photos. Mostly children. Every face scratched out except one."
    nic "有很多照片，基本都是小孩子。每张照片上的脸都被划掉了，只有一张例外。"

# game/ch2ep2.rpy:5781
translate chinese sktabdinwikcont_f1dde69a:

    # nic "The center photo. No scratch marks."
    nic "最中心的那一张没有被划掉。"

# game/ch2ep2.rpy:5782
translate chinese sktabdinwikcont_be70a7c1_1:

    # mc "Leah?"
    mc "是莉娅？"

# game/ch2ep2.rpy:5783
translate chinese sktabdinwikcont_06fcaad3:

    # nic "Yeah."
    nic "对。"

# game/ch2ep2.rpy:5784
translate chinese sktabdinwikcont_40ea2a16:

    # nic "There's a mirror too. Cracked. Empty polaroid film tucked into the frame."
    nic "还有一面镜子。已经碎了。镜框里塞着一张空的拍立得胶卷。"

# game/ch2ep2.rpy:5785
translate chinese sktabdinwikcont_351bd29d:

    # nic "No photo. Just the film."
    nic "没有照片，只有胶卷。"

# game/ch2ep2.rpy:5786
translate chinese sktabdinwikcont_27ac2118:

    # nic "What the hell is going on in this guy's head?"
    nic "这家伙的脑子到底有什么毛病？"

# game/ch2ep2.rpy:5787
translate chinese sktabdinwikcont_4bed1728:

    # nic "And there's books."
    nic "还有书。"

# game/ch2ep2.rpy:5788
translate chinese sktabdinwikcont_2d393eab:

    # nic "Human Anatomy. Medical Practices. An Analysis of Healthcare. The Human Mind."
    nic "人体解剖学。医疗实践。医疗分析。人类心理学。"

# game/ch2ep2.rpy:5789
translate chinese sktabdinwikcont_743a19aa:

    # nic "Ooh, can I—"
    nic "噢，我能不能——"

# game/ch2ep2.rpy:5790
translate chinese sktabdinwikcont_f10bcc56:

    # y "Not the time for shopping, Princess."
    y "现在不是逛商店的时候，公主。"

# game/ch2ep2.rpy:5791
translate chinese sktabdinwikcont_7dcecc3b:

    # nic "Damn it."
    nic "唉。"

# game/ch2ep2.rpy:5792
translate chinese sktabdinwikcont_ca4e8df8:

    # la "Bag everything. Don't touch anything else."
    la "把东西都打包带走。剩下的统统不要碰。"

# game/ch2ep2.rpy:5793
translate chinese sktabdinwikcont_7abef0b9:

    # nic "Copy."
    nic "明白。"

# game/ch2ep2.rpy:5796
translate chinese sktabdinwikcont_8c5dce78:

    # la "If he's not there, then..."
    la "如果他不在那个地方，那……"

# game/ch2ep2.rpy:5797
translate chinese sktabdinwikcont_361b5749:

    # mc "His composure's gotten better. His thinking hasn't. He always figures he's the smartest guy in the room."
    mc "他是更能沉得住气了，但智商还是没跟上。总是觉得别人没他聪明。"

# game/ch2ep2.rpy:5798
translate chinese sktabdinwikcont_4bb0dd90:

    # mc "He'll be here."
    mc "他会来的。"

# game/ch2ep2.rpy:5801
translate chinese sktabdinwikcont_e53a0baa:

    # mc "And... there he is."
    mc "看吧……来了。"

# game/ch2ep2.rpy:5802
translate chinese sktabdinwikcont_ddb6fabb:

    # la "*chuckles*"
    la "*轻笑*"

# game/ch2ep2.rpy:5804
translate chinese sktabdinwikcont_d493c1d1:

    # fr "I was wondering why the street was empty."
    fr "我还正在想为什么街上没有人呢。"

# game/ch2ep2.rpy:5805
translate chinese sktabdinwikcont_4e5e6c62:

    # mc "You should've stayed hidden."
    mc "你不该露头的。"

# game/ch2ep2.rpy:5806
translate chinese sktabdinwikcont_c3a70392_7:

    # fr "..."
    fr "……"

# game/ch2ep2.rpy:5807
translate chinese sktabdinwikcont_bc5ca370:

    # fr "And miss this?"
    fr "要是躲着，不就错过这场好戏了吗？"

# game/ch2ep2.rpy:5810
translate chinese sktabdinwikcont_f4d71cd8:

    # fr "You found the location through her, didn't you? The detective."
    fr "你是靠着她找到这个地方的，对吧？那个警察。"

# game/ch2ep2.rpy:5811
translate chinese sktabdinwikcont_586a271b:

    # fr "She's something. You should hold onto her."
    fr "她有点本事。你该好好珍惜她。"

# game/ch2ep2.rpy:5812
translate chinese sktabdinwikcont_e044abe8:

    # mc "Maybe. Could've also used men who don't roll over the second someone flashes a badge."
    mc "或许吧。也有可能是你的手下一看到警察就全都招了的原因。"

# game/ch2ep2.rpy:5813
translate chinese sktabdinwikcont_c3a70392_8:

    # fr "..."
    fr "……"

# game/ch2ep2.rpy:5814
translate chinese sktabdinwikcont_4d2dc734:

    # mc "Take him in."
    mc "把他带走。"

# game/ch2ep2.rpy:5815
translate chinese sktabdinwikcont_1e73152e:

    # fr "I'll find another one, you know."
    fr "我还会再找到其他人的。"

# game/ch2ep2.rpy:5816
translate chinese sktabdinwikcont_eb259930:

    # fr "I always do."
    fr "我一定能找到。"

# game/ch2ep2.rpy:5817
translate chinese sktabdinwikcont_4c260920:

    # mc "Good luck with that. Hope your \"sister\" finally gets some rest."
    mc "祝你好运吧。希望你的“妹妹”终于能好好休息一下了。"

# game/ch2ep2.rpy:5834
translate chinese sktabdinwikcont_afc0de79:

    # ju "I'm sorry, Emma."
    ju "对不起，艾玛。"

# game/ch2ep2.rpy:5835
translate chinese sktabdinwikcont_18db495f:

    # e "... You did what you had to do."
    e "……你只是做了该做的事。"

# game/ch2ep2.rpy:5836
translate chinese sktabdinwikcont_989ff1c0:

    # ju "So did you."
    ju "你也一样。"

# game/ch2ep2.rpy:5837
translate chinese sktabdinwikcont_72a33094_107:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5839
translate chinese sktabdinwikcont_940f3660_1:

    # ju "*exhales*"
    ju "*叹气*"

# game/ch2ep2.rpy:5840
translate chinese sktabdinwikcont_0c76a500:

    # ju "I shouldn't be telling you this, but the placement is void."
    ju "我不该告诉你这事的，不过……寄养的事黄了。"

# game/ch2ep2.rpy:5841
translate chinese sktabdinwikcont_a8266700:

    # e "Cara."
    e "因为卡拉吧。"

# game/ch2ep2.rpy:5842
translate chinese sktabdinwikcont_d7616361:

    # ju "Yeah. Family's been sent home. Case is flagged for reassessment."
    ju "对。那一家人已经回去了。这个案子要重新评估。"

# game/ch2ep2.rpy:5843
translate chinese sktabdinwikcont_b244b92d:

    # ju "Leah's back at the hospital for now. Same room."
    ju "莉娅暂时又回到医院了。还是那个病房。"

# game/ch2ep2.rpy:5844
translate chinese sktabdinwikcont_72a33094_108:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5845
translate chinese sktabdinwikcont_bb2d26be:

    # ju "She asked about you while we were sorting things out."
    ju "我们在处理这件事的时候，她还问了你的情况。"

# game/ch2ep2.rpy:5846
translate chinese sktabdinwikcont_e5a2c2ca_1:

    # e "What did she say?"
    e "她怎么说的？"

# game/ch2ep2.rpy:5847
translate chinese sktabdinwikcont_eef9ae35:

    # ju "Asked if you were going to be okay."
    ju "她问你之后会不会没事。"

# game/ch2ep2.rpy:5848
translate chinese sktabdinwikcont_bb7acdee:

    # ju "Just that."
    ju "只问了这一句。"

# game/ch2ep2.rpy:5849
translate chinese sktabdinwikcont_52fc4ea2_13:

    # ju "..."
    ju "……"

# game/ch2ep2.rpy:5850
translate chinese sktabdinwikcont_9d5da41a:

    # ju "I didn't have an answer for her."
    ju "我没法回答她。"

# game/ch2ep2.rpy:5852
translate chinese sktabdinwikcont_47aecc55:

    # ju "What I said at the hospital still stands. You're off the case, Emma."
    ju "我在医院说的话依旧算数。你不能插手这个案子，艾玛。"

# game/ch2ep2.rpy:5853
translate chinese sktabdinwikcont_6fff46d7:

    # ju "Get some sleep. Both of you."
    ju "你们两个都去睡一觉吧。"

# game/ch2ep2.rpy:5856
translate chinese sktabdinwikcont_dd61c100:

    # mc "Come on. You need to eat."
    mc "走吧。你得吃点东西。"

# game/ch2ep2.rpy:5857
translate chinese sktabdinwikcont_df24c661:

    # e "I'm not really hungry."
    e "我不饿。"

# game/ch2ep2.rpy:5858
translate chinese sktabdinwikcont_ad8db0d5:

    # mc "When's the last time you ate?"
    mc "你上次吃东西是什么时候？"

# game/ch2ep2.rpy:5859
translate chinese sktabdinwikcont_2de3bcfe:

    # e "I... don't remember."
    e "我……不记得了。"

# game/ch2ep2.rpy:5860
translate chinese sktabdinwikcont_4ea90856_1:

    # mc "Em..."
    mc "小艾……"

# game/ch2ep2.rpy:5861
translate chinese sktabdinwikcont_72a33094_109:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5862
translate chinese sktabdinwikcont_ecf61e0e:

    # mc "Come on."
    mc "走吧。"

# game/ch2ep2.rpy:5872
translate chinese sktabdinwikcont_8992003a:

    # mc "Talk to me."
    mc "跟我聊聊吧。"

# game/ch2ep2.rpy:5873
translate chinese sktabdinwikcont_40ee61b1:

    # e "About what?"
    e "聊什么？"

# game/ch2ep2.rpy:5874
translate chinese sktabdinwikcont_8175543d:

    # mc "About whatever's been eating you alive since you walked out of that hospital."
    mc "聊聊你自从离开医院之后，就一直魂不守舍这件事。"

# game/ch2ep2.rpy:5875
translate chinese sktabdinwikcont_72a33094_110:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5876
translate chinese sktabdinwikcont_4cfc14f3:

    # e "There's nothing to talk about. The placement fell through. June will find another family. That's it."
    e "没什么可聊的。寄养的事黄了。但琼会找到其他家庭的。就这样。"

# game/ch2ep2.rpy:5877
translate chinese sktabdinwikcont_ee8d0e6c:

    # mc "Is that what you want?"
    mc "你心里真的想这样吗？"

# game/ch2ep2.rpy:5878
translate chinese sktabdinwikcont_a73c8506:

    # e "What I want doesn't factor into this."
    e "我怎么想对情况没有影响。"

# game/ch2ep2.rpy:5879
translate chinese sktabdinwikcont_d0ff56a6:

    # mc "You said that last time too. Cut it out, Em."
    mc "你上次也是这么说的。省省吧，小艾。"

# game/ch2ep2.rpy:5880
translate chinese sktabdinwikcont_8b9bd91a:

    # e "Because it's true."
    e "因为事实如此。"

# game/ch2ep2.rpy:5881
translate chinese sktabdinwikcont_1d9343cf:

    # mc "You walked forty minutes in the dark. Again."
    mc "你又在夜里走了四十分钟。"

# game/ch2ep2.rpy:5882
translate chinese sktabdinwikcont_72a33094_111:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5883
translate chinese sktabdinwikcont_12031422:

    # mc "You blocked a DFCS transfer. Told June you fell in love with Leah in front of her supposed foster family."
    mc "你刻意阻止了DFCS的转移程序。还当着那个寄养家庭的面告诉琼你爱上了莉娅。"

# game/ch2ep2.rpy:5884
translate chinese sktabdinwikcont_721f811e:

    # mc "If what you want doesn't factor in, you've got a real strange way of showing it."
    mc "这就是你嘴里说的“我怎么想对情况没有影响”？"

# game/ch2ep2.rpy:5887
translate chinese sktabdinwikcont_59245d7c:

    # e "What do you want me to say, [mc]?"
    e "你想让我说什么，[mc!t]？"

# game/ch2ep2.rpy:5888
translate chinese sktabdinwikcont_7662583c:

    # mc "Whatever you've been choking on."
    mc "说你一直想说的话。"

# game/ch2ep2.rpy:5889
translate chinese sktabdinwikcont_72a33094_112:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5890
translate chinese sktabdinwikcont_73c087dd:

    # e "The truth is, I lost my badge, my career, and probably my credibility in one afternoon."
    e "事实就是，一个下午的时间，我就失去了我的警徽，事业，可能还有全部的信誉。"

# game/ch2ep2.rpy:5891
translate chinese sktabdinwikcont_4c7f0540:

    # e "The truth is, June pulled me off the case and I still showed up."
    e "事实就是，琼让我别再插手，但我还是去了。"

# game/ch2ep2.rpy:5892
translate chinese sktabdinwikcont_99419079:

    # e "The truth is, I can't stop thinking about a ten-year-old we pulled out of a trafficking ring."
    e "事实就是，我怎么也忘不掉那个我们从人贩子手里救出来的十岁小孩。"

# game/ch2ep2.rpy:5893
translate chinese sktabdinwikcont_a966427e:

    # mc "I'm not asking about those. I'm asking what's underneath all of it."
    mc "我问的不是那些。我问的是背后真正的原因。"

# game/ch2ep2.rpy:5894
translate chinese sktabdinwikcont_72a33094_113:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5896
translate chinese sktabdinwikcont_b196867d:

    # e "If I say it out loud, I can't take it back."
    e "如果我说出来了，就再也没法收回去了。"

# game/ch2ep2.rpy:5897
translate chinese sktabdinwikcont_cf0490b6:

    # mc "Em... What am I to you? Don't you trust me?"
    mc "小艾……我对你来说是什么人？你难道不信任我吗？"

# game/ch2ep2.rpy:5898
translate chinese sktabdinwikcont_f0f9be8d_1:

    # e "*softly nods*"
    e "*轻轻点头*"

# game/ch2ep2.rpy:5899
translate chinese sktabdinwikcont_fb43015c:

    # mc "Then say it."
    mc "那就说吧。"

# game/ch2ep2.rpy:5901
translate chinese sktabdinwikcont_8af34539:

    # e "I want to adopt her."
    e "我想收养她。"

# game/ch2ep2.rpy:5902
translate chinese sktabdinwikcont_f962bb7e:

    # mc "Oh. Okay."
    mc "噢。可以啊。"

# game/ch2ep2.rpy:5903
translate chinese sktabdinwikcont_ee8ec4b0_1:

    # e "Not okay."
    e "不可以。"

# game/ch2ep2.rpy:5904
translate chinese sktabdinwikcont_2876efd9_2:

    # mc "Why?"
    mc "为什么？"

# game/ch2ep2.rpy:5906
translate chinese sktabdinwikcont_1fb167ea:

    # e "Because I'll have to feed her. Take her to school. Help with homework. Deal with the tantrums, the questions, the nights she can't sleep."
    e "因为那样我就得让她吃饱饭。送她上学。辅导她做作业。要忍受她的小性子，回答她各种各样的问题，在她睡不着的时候陪着她。"

# game/ch2ep2.rpy:5907
translate chinese sktabdinwikcont_5c5d9188:

    # mc "By the gods... you've already thought it through."
    mc "我的天啊……你居然都想到那么远了。"

# game/ch2ep2.rpy:5908
translate chinese sktabdinwikcont_1a932eb1:

    # e "[mc]... I'm being serious."
    e "[mc!t]……我是认真的。"

# game/ch2ep2.rpy:5909
translate chinese sktabdinwikcont_b1195c8c:

    # mc "What? So am I."
    mc "怎么？我也是认真的啊。"

# game/ch2ep2.rpy:5910
translate chinese sktabdinwikcont_2f85c9a1:

    # e "It's not that. It's just..."
    e "我不是那个意思。我只是……"

# game/ch2ep2.rpy:5911
translate chinese sktabdinwikcont_023eb8c7:

    # e "... I've never done any of that. I don't know how."
    e "……我从来没做过那些事。我不知道该怎么办。"

# game/ch2ep2.rpy:5912
translate chinese sktabdinwikcont_9ff68c96:

    # mc "Nobody does the first time."
    mc "没人一开始就会啊。"

# game/ch2ep2.rpy:5913
translate chinese sktabdinwikcont_8a935555:

    # e "So you know how?"
    e "那你知道怎么办吗？"

# game/ch2ep2.rpy:5914
translate chinese sktabdinwikcont_2b35b6fe_36:

    # mc "..."
    mc "……"

# game/ch2ep2.rpy:5915
translate chinese sktabdinwikcont_fca52711:

    # mc "No."
    mc "不知道。"

# game/ch2ep2.rpy:5916
translate chinese sktabdinwikcont_fbde0904:

    # e "And my record. That follows me everywhere now."
    e "还有我的档案。会跟着我一辈子。"

# game/ch2ep2.rpy:5917
translate chinese sktabdinwikcont_b8904a9b:

    # e "CPS will see it. The judge will see it. Any lawyer worth half their salt will use it against me."
    e "CPS会看到。法官会看到。随便一个律师都会拿这件事来对付我。"

# game/ch2ep2.rpy:5918
translate chinese sktabdinwikcont_780231fb:

    # e "June said the reassessment opens a door, but it's probably one I'll get turned away from."
    e "琼说案子在重新评估，是一扇新的大门，但这扇门可能永远不会对我打开。"

# game/ch2ep2.rpy:5919
translate chinese sktabdinwikcont_b3c4ce76:

    # mc "So you'd rather not try?"
    mc "所以你宁愿试都不试一下吗？"

# game/ch2ep2.rpy:5921
translate chinese sktabdinwikcont_0bea442f:

    # mc "Em. The paperwork, the record, the logistics—you'd grind through all of it. I've seen you do harder things on less sleep."
    mc "小艾。程序也好，档案也好，这些杂事你都可以克服的。我亲眼见过你在更艰难的情况下做成更困难的事情。"

# game/ch2ep2.rpy:5922
translate chinese sktabdinwikcont_3aa22ce9:

    # mc "That's not what's stopping you."
    mc "这些事挡不住你。"

# game/ch2ep2.rpy:5923
translate chinese sktabdinwikcont_72a33094_114:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5924
translate chinese sktabdinwikcont_0b74d035:

    # e "You know what I told you at the hospital. About my mom. About the promise."
    e "你还记得我在医院跟你说过的话吧。有关我妈妈，还有承诺的事情。"

# game/ch2ep2.rpy:5925
translate chinese sktabdinwikcont_cf1adef2_6:

    # mc "Yeah."
    mc "嗯。"

# game/ch2ep2.rpy:5926
translate chinese sktabdinwikcont_f6b81232:

    # e "That was about Leah getting hurt. This is totally different."
    e "那次是因为怕莉娅受伤。这次完全不一样。"

# game/ch2ep2.rpy:5927
translate chinese sktabdinwikcont_957c816e:

    # e "If I adopt her, I'm choosing it. On purpose."
    e "如果我收养她，那就是我自己选择的。是故意的。"

# game/ch2ep2.rpy:5928
translate chinese sktabdinwikcont_df5d5886:

    # e "I'm walking into a room and saying, \"Depend on me. Build your life around me. I'll be the person you come home to.\""
    e "是我主动去找她说：“依赖我吧。让你的生活围绕着我吧。我就是一直在家里等着你的那个人。”"

# game/ch2ep2.rpy:5929
translate chinese sktabdinwikcont_677616b0:

    # e "And then one day, I won't be there."
    e "然后到某一天，我就不在了。"

# game/ch2ep2.rpy:5930
translate chinese sktabdinwikcont_2b35b6fe_37:

    # mc "..."
    mc "……"

# game/ch2ep2.rpy:5931
translate chinese sktabdinwikcont_3d24ddac:

    # e "My mom didn't choose it either."
    e "我妈妈也不是自己选的。"

# game/ch2ep2.rpy:5932
translate chinese sktabdinwikcont_4caa9cdf:

    # e "But this would be worse. I'd be looking at a kid who's already been abandoned and saying, \"Trust me,\" knowing full well what I am."
    e "可这样会更糟糕。我要在明知道自己的身份的情况下，对一个已经被抛弃过的孩子说：“相信我吧。”"

# game/ch2ep2.rpy:5933
translate chinese sktabdinwikcont_cc6e65f1:

    # mc "What you are?"
    mc "你是什么身份？"

# game/ch2ep2.rpy:5934
translate chinese sktabdinwikcont_8d3808d8:

    # e "Temporary. I know everyone is."
    e "过客。我知道每个人都是过客。"

# game/ch2ep2.rpy:5935
translate chinese sktabdinwikcont_225fb21c:

    # e "But do I really want to do that to a child who's already learned that lesson the hard way?"
    e "真的要让已经切身经历过这个教训的孩子再经历一次吗？"

# game/ch2ep2.rpy:5936
translate chinese sktabdinwikcont_2b35b6fe_38:

    # mc "..."
    mc "……"

# game/ch2ep2.rpy:5937
translate chinese sktabdinwikcont_48277ae6:

    # e "She's already afraid that people will leave her, [mc]."
    e "她已经非常害怕别人会离开她了，[mc!t]。"

# game/ch2ep2.rpy:5938
translate chinese sktabdinwikcont_042c5a62:

    # e "Her mom sold her. The system shuffled her around. Every adult in her life has been a revolving door."
    e "她妈妈把她卖了。儿童福利系统把她当皮球一样来回踢。她生活中的每个大人都只是一个旋转门。"

# game/ch2ep2.rpy:5939
translate chinese sktabdinwikcont_2308161d:

    # e "And I'm supposed to walk through it and tell her this time is different?"
    e "难道我还要走进这个旋转门，告诉她这次不一样吗？"

# game/ch2ep2.rpy:5940
translate chinese sktabdinwikcont_a6d34b68:

    # e "What makes me different? Because I care? My mom cared. Caring didn't keep her alive."
    e "我凭什么不一样？因为我爱她？我妈妈也爱我。可爱我也保不住她的命。"

# game/ch2ep2.rpy:5941
translate chinese sktabdinwikcont_87a390c3:

    # mc "... You're right."
    mc "……你说得对。"

# game/ch2ep2.rpy:5942
translate chinese sktabdinwikcont_9142bb71:

    # mc "You will leave her."
    mc "你会离开她。"

# game/ch2ep2.rpy:5944
translate chinese sktabdinwikcont_a11f06a4:

    # mc "One day, for whatever reason, you won't be there. Could be years. Could be decades. Doesn't matter."
    mc "不管什么原因，总有一天，你会离开。可能是几年后，可能是几十年后。不重要。"

# game/ch2ep2.rpy:5945
translate chinese sktabdinwikcont_b2bccb12:

    # mc "You'll leave. Everyone does."
    mc "你会离开。所有人都会离开。"

# game/ch2ep2.rpy:5946
translate chinese sktabdinwikcont_a13a0a27:

    # mc "Your mom left. Jovian left. The world doesn't hand out exceptions for the people who love the hardest."
    mc "你妈妈走了。乔维安走了。这个世界不会特别优待那些最爱别人的人。"

# game/ch2ep2.rpy:5947
translate chinese sktabdinwikcont_cc46c79b:

    # e "Then why would I put her through that?"
    e "那我为什么还要让她经历这些？"

# game/ch2ep2.rpy:5948
translate chinese sktabdinwikcont_c49f6e9c:

    # mc "Because your mom had the greatest time of her life with you anyway."
    mc "因为尽管如此，你妈妈还是和你一起度过了最幸福的人生。"

# game/ch2ep2.rpy:5949
translate chinese sktabdinwikcont_1cd32f84:

    # mc "I never got to meet her, but I know she wouldn't have traded a single day."
    mc "我从来没见过她，但我知道她绝不会错过和你在一起的哪怕一天。"

# game/ch2ep2.rpy:5950
translate chinese sktabdinwikcont_72a33094_115:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5951
translate chinese sktabdinwikcont_da437386:

    # mc "She knew she was dying. She knew she couldn't keep that promise."
    mc "她知道她时日不多了。她知道她没法兑现承诺。"

# game/ch2ep2.rpy:5952
translate chinese sktabdinwikcont_0a1efb48:

    # mc "Yet she still made it."
    mc "可她还是许下了承诺。"

# game/ch2ep2.rpy:5953
translate chinese sktabdinwikcont_2eac7039:

    # mc "She gave you something to hold onto when she couldn't hold you anymore."
    mc "那是为了让你在她没法再抱着你的时候，依然可以有个依靠。"

# game/ch2ep2.rpy:5954
translate chinese sktabdinwikcont_48509d69:

    # mc "It's been seventeen years since and you still carry it. You carried it into that club. You carried it into Leah's hospital room."
    mc "已经过去了十七年，你依然记得那个承诺。你心里带着那个承诺走进了那家俱乐部。走进了莉娅的病房。"

# game/ch2ep2.rpy:5955
translate chinese sktabdinwikcont_1b3e13c9:

    # mc "From what I see, that promise didn't break you, Em. It kept you standing."
    mc "在我看来，那个承诺没有打垮你，小艾。它一直支撑着你。"

# game/ch2ep2.rpy:5956
translate chinese sktabdinwikcont_72a33094_116:

    # e "..."
    e "……"

# game/ch2ep2.rpy:5957
translate chinese sktabdinwikcont_5ba52a63:

    # mc "You can't give Leah forever. Nobody gets to do that."
    mc "你没法给莉娅永远。没人能做到。"

# game/ch2ep2.rpy:5958
translate chinese sktabdinwikcont_34882c36:

    # mc "But you can be there until you can't. And that's what she'll carry."
    mc "但你可以直到最后一刻都陪着她。她会一直记住这件事。"

# game/ch2ep2.rpy:5959
translate chinese sktabdinwikcont_e1a21be5:

    # mc "You hear me?"
    mc "你听懂了吗？"

# game/ch2ep2.rpy:5961
translate chinese sktabdinwikcont_186ed532:

    # e "I need to talk to June."
    e "我要和琼聊聊。"

# game/ch2ep2.rpy:5962
translate chinese sktabdinwikcont_42fdccf6:

    # mc "Uhh... It's past midnight."
    mc "呃……都已经半夜了。"

# game/ch2ep2.rpy:5963
translate chinese sktabdinwikcont_e04eeaae:

    # e "Then I'll be at her door first thing in the morning."
    e "那我就让她明天早上一开门就看见我。"

# game/ch2ep2.rpy:5970
translate chinese sktabdinwikcont_2c08ee1f:

    # mc "Whatever happens, I'm with you."
    mc "不管发生什么，我都支持你。"

# game/ch2ep2.rpy:5973
translate chinese sktabdinwikcont_1c3741a1_2:

    # e "Thanks."
    e "谢谢。"

# game/ch2ep2.rpy:5975
translate chinese sktabdinwikcont_2b35b6fe_39:

    # mc "..."
    mc "……"

# game/ch2ep2.rpy:5990
translate chinese sktabdinwikcont_f1435f5e:

    # ju "Jesus, Emma... It's four in the morning."
    ju "天啊，艾玛……现在是凌晨四点。"

# game/ch2ep2.rpy:5991
translate chinese sktabdinwikcont_cee36124:

    # e "Sorry. I couldn't sleep."
    e "对不起。我睡不着觉。"

# game/ch2ep2.rpy:5992
translate chinese sktabdinwikcont_52fc4ea2_14:

    # ju "..."
    ju "……"

# game/ch2ep2.rpy:5993
translate chinese sktabdinwikcont_8be37e24:

    # ju "This better be worth it."
    ju "最好是什么重要的事。"

# game/ch2ep2.rpy:5994
translate chinese sktabdinwikcont_8bde3d8d:

    # e "I want to submit an adoption application for Leah."
    e "我想提交收养莉娅的申请。"

# game/ch2ep2.rpy:5997
translate chinese sktabdinwikcont_3252b5b9:

    # ju "... I'm listening."
    ju "……你继续说。"

# game/ch2ep2.rpy:5998
translate chinese sktabdinwikcont_4e50242b:

    # e "The placement is void. The review's still open."
    e "寄养的事暂时行不通了。案子还在重新评估阶段。"

# game/ch2ep2.rpy:5999
translate chinese sktabdinwikcont_f12a91f1:

    # e "My record says what it says. I'm not here to argue that."
    e "我的档案上写了什么我很清楚。这点我不想争论。"

# game/ch2ep2.rpy:6000
translate chinese sktabdinwikcont_8fd95e79:

    # e "I've got [mc]'s charity behind me. Whatever the board needs to see."
    e "[mc!t]的慈善机构也会支持我。无论委员会需要看到什么，我都能提供。"

# game/ch2ep2.rpy:6001
translate chinese sktabdinwikcont_1447c000:

    # ju "Knowing her isn't a legal qualification."
    ju "跟她关系好在法律上并不算数。"

# game/ch2ep2.rpy:6002
