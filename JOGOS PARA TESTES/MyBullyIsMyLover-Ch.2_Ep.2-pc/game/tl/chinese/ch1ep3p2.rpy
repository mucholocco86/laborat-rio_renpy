translate chinese ainepubtensionbuildup_bb8e4b4e_1:

    # a "..."
    a "……"

# game/ch1ep3p2.rpy:3724
translate chinese ainepubtensionbuildup_d6fba94f:

    # h "What's the issue?"
    h "怎么了？"

# game/ch1ep3p2.rpy:3725
translate chinese ainepubtensionbuildup_7df5b359:

    # wai "Well, the thing is-"
    wai "嗯，是这样的——"

# game/ch1ep3p2.rpy:3728
translate chinese ainepubtensionbuildup_d8889a91:

    # a "We've been waiting an hour, and our orders are still wrong. Not just once, but multiple times."
    a "我们等了一个小时，但上的菜还是错的。而且不止一次，是好几次。"

# game/ch1ep3p2.rpy:3731
translate chinese ainepubtensionbuildup_a9e8d3d1:

    # h "And where is the manager?"
    h "经理在哪？"

# game/ch1ep3p2.rpy:3732
translate chinese ainepubtensionbuildup_e502afd8:

    # wai "He's... um..."
    wai "他……呃……"

# game/ch1ep3p2.rpy:3733
translate chinese ainepubtensionbuildup_56e0b0bd:

    # h "Spit it out."
    h "说啊。"

# game/ch1ep3p2.rpy:3734
translate chinese ainepubtensionbuildup_4ab4a8af:

    # wai "He's asleep in the back..."
    wai "他在后面睡觉……"

# game/ch1ep3p2.rpy:3737
translate chinese ainepubtensionbuildup_7c3b4ca3:

    # h "Incompetence. You, the manager, and anyone else responsible - you're all fired."
    h "废物。你，经理，还有其他有责任的人——全部开除。"

# game/ch1ep3p2.rpy:3738
translate chinese ainepubtensionbuildup_846dfc42:

    # wai "Madam?"
    wai "老板？"

# game/ch1ep3p2.rpy:3739
translate chinese ainepubtensionbuildup_92cbb0a4:

    # h "Did I stutter?"
    h "我没说清楚吗？"

# game/ch1ep3p2.rpy:3742
translate chinese ainepubtensionbuildup_3a341d29:

    # wai "B-but it's just one customer! How can you decide just like that based on a simple mistake?!"
    wai "可-可是就这一个客人啊！只是一个小错，没必要这样吧？！"

# game/ch1ep3p2.rpy:3743
translate chinese ainepubtensionbuildup_65fdac25:

    # h "A simple mistake..."
    h "小错……"

# game/ch1ep3p2.rpy:3744
translate chinese ainepubtensionbuildup_d18bc06f:

    # h "How about I pull a gun out and shoot you in the head? That's a simple mistake."
    h "我一枪把你的头打烂怎么样？那也只是个小错。"

# game/ch1ep3p2.rpy:3747
translate chinese ainepubtensionbuildup_360023c9:

    # wai "I'm sorry. I didn't mean to insult you!"
    wai "对不起。我不是想侮辱你！"

# game/ch1ep3p2.rpy:3750
translate chinese ainepubtensionbuildup_597989c6:

    # h "One customer? Do you realize who you're serving?"
    h "就一个客人？你不知道她是谁吗？"

# game/ch1ep3p2.rpy:3751
translate chinese ainepubtensionbuildup_e775aa00:

    # wai "I... a regular customer?"
    wai "我……就一个普通的客人啊？"

# game/ch1ep3p2.rpy:3752
translate chinese ainepubtensionbuildup_f7f40c68:

    # h "My daughter."
    h "是我的女儿。"

# game/ch1ep3p2.rpy:3755
translate chinese ainepubtensionbuildup_543f5ad1:

    # wai "Your... daughter?!"
    wai "你的……女儿？！"

# game/ch1ep3p2.rpy:3756
translate chinese ainepubtensionbuildup_533787e7:

    # wai "That ugly piece of shit is your daughter?! Haha, surely you're joking!"
    wai "那个丑逼是你的女儿？！哈哈，你肯定是在开玩笑吧！"

# game/ch1ep3p2.rpy:3767
translate chinese ainepubtensionbuildup_87e1fe47:

    # mc "That's it. How about we let my fist add a few words to this discussion?"
    mc "好了好了，要不要让我的拳头也加入讨论啊？"

# game/ch1ep3p2.rpy:3768
translate chinese ainepubtensionbuildup_4a11fcc8:

    # mc "Oh, look at that, it already made its point."
    mc "啊，不好意思，它已经把想说的话说完了。"

# game/ch1ep3p2.rpy:3769
translate chinese ainepubtensionbuildup_bd5f015e:

    # mc "And to think I almost gave you a chance to explain yourself..."
    mc "我居然还差点给了你解释清楚的机会……"

# game/ch1ep3p2.rpy:3781
translate chinese ainepubtensionbuildup_0328699a:

    # a "Wait, mom!"
    a "等一下，妈！"

# game/ch1ep3p2.rpy:3782
translate chinese ainepubtensionbuildup_76bb65a2:

    # h "... After all this time, you still have it in you to call me your mother. I'm flattered."
    h "……都过了这么久，你居然还能喊我妈。我真是受宠若惊。"

# game/ch1ep3p2.rpy:3783
translate chinese ainepubtensionbuildup_3ceeb9c4:

    # a "You're just going to walk away?! Like always?!"
    a "你打算就这么走掉吗？！就和以前一样？！"

# game/ch1ep3p2.rpy:3784
translate chinese ainepubtensionbuildup_4638f422:

    # h "I have other matters to attend to, Aine."
    h "我有其他事要处理，艾妮。"

# game/ch1ep3p2.rpy:3787
translate chinese ainepubtensionbuildup_e9e231a1:

    # a "You always prioritize business! Always business, business, business!"
    a "你总是把生意放在第一位！一直都是生意，生意，生意！"

# game/ch1ep3p2.rpy:3788
translate chinese ainepubtensionbuildup_be0309e7:

    # a "Can't you stop and listen?! Just this once?! I have questions, things I need to understand!"
    a "你就不能停下来听我说吗？！就这一次就好？！我有问题，有事情想弄明白！"

# game/ch1ep3p2.rpy:3794
translate chinese ainepubtensionbuildup_a27dfa5a:

    # a "Tsk!"
    a "啧！"

# game/ch1ep3p2.rpy:3797
translate chinese ainepubtensionbuildup_6c0228e5:

    # mc "Let's get out of here, Aine. This isn't worth it."
    mc "我们走吧，艾妮。不值得。"

# game/ch1ep3p2.rpy:3808
translate chinese ainepubtensionbuildup_7d3f228f:

    # mc "I still can't believe how I reacted back there. That's not who I am."
    mc "我还是不敢相信我刚刚居然打了他。我不是这种人。"

# game/ch1ep3p2.rpy:3809
translate chinese ainepubtensionbuildup_8a375f79:

    # a "You stood up for me. That's what matters."
    a "你替我出了头。这才是重点。"

# game/ch1ep3p2.rpy:3810
translate chinese ainepubtensionbuildup_bbbc16fa:

    # mc "But resorting to violence? That's not the solution. We're supposed to be better than that."
    mc "可是暴力并不是解决方案。我们应该做得更好才对。"

# game/ch1ep3p2.rpy:3813
translate chinese ainepubtensionbuildup_0a40c352:

    # a "Better? [mc], sometimes you have to fight back!"
    a "更好？[mc!t]，有时候必须反击才行！"

# game/ch1ep3p2.rpy:3814
translate chinese ainepubtensionbuildup_0dbb0d84:

    # a "It's not just about us, or good morality: it's about not being trampled on!"
    a "重要的不是我们，或者什么要品德高尚；重要的是不能被欺负！"

# game/ch1ep3p2.rpy:3817
translate chinese ainepubtensionbuildup_bf98ec47:

    # mc "There's a difference between standing our ground and losing control. We should be handling these things maturely."
    mc "争取权益和失控是有差别的。我们要用成熟的手段解决问题。"

# game/ch1ep3p2.rpy:3820
translate chinese ainepubtensionbuildup_66a3032c:

    # a "Maturely? Since when did we become these paragons of virtue? The world isn't always so black and white!"
    a "成熟？我们什么时候变成美德的化身了？这个世界可不总是非黑即白的！"

# game/ch1ep3p2.rpy:3821
translate chinese ainepubtensionbuildup_32db94b5:

    # a "You think I had the luxury of being \"mature\" growing up?"
    a "你觉得我长大的过程里有“成熟”的资格吗？"

# game/ch1ep3p2.rpy:3822
translate chinese ainepubtensionbuildup_245ce26e:

    # a "The world doesn't always allow you the luxury of being the \"better person\", [mc]! I, myself, have never had that chance!"
    a "这个世界不会总让你当“好人”的，[mc!t]！我，就从来没有那个机会！"

# game/ch1ep3p2.rpy:3825
translate chinese ainepubtensionbuildup_32308535:

    # mc "That's not the point, Aine! I'm saying we could've handled the situation without letting our emotions take over!"
    mc "那不是重点，艾妮！我想说的是，我们明明是可以不让情绪失控就解决问题的！"

# game/ch1ep3p2.rpy:3829
translate chinese ainepubtensionbuildup_bc9a3d86:

    # a "And that's the problem with you! You're always so calm, so forgiving!"
    a "这就是你的毛病！你总是很冷静，很大度！"

# game/ch1ep3p2.rpy:3830
translate chinese ainepubtensionbuildup_48ca9d9a:

    # a "You never would've suffered if you had it in you to just punch me in the face!"
    a "你以前要是能直接给我一拳，就不用吃那么多苦了！"

# game/ch1ep3p2.rpy:3831
translate chinese ainepubtensionbuildup_d2bc9ef6:

    # mc "Why are you bringing up old wounds? The past is behind us, Aine! We agreed to move forward!"
    mc "你怎么又开始提以前了？过去的事已经过去了，艾妮！我们已经说好向前看了！"

# game/ch1ep3p2.rpy:3832
translate chinese ainepubtensionbuildup_f29dd651:

    # a "Because it matters! You are not the only one affected by what happened, [mc]!"
    a "因为这很重要！那时候的事不止影响了你一个人，[mc!t]！"

# game/ch1ep3p2.rpy:3835
translate chinese ainepubtensionbuildup_9df34099:

    # mc "So what, are you saying you don't want this? Our relationship? That you regret meeting me?"
    mc "那又怎样，你是想说你不想这样吗？不想和我在一起？后悔遇见我？"

# game/ch1ep3p2.rpy:3836
translate chinese ainepubtensionbuildup_40c44837:

    # a "It's not about regret! It's about what's healthy! And right now, this... this isn't!"
    a "跟后悔没关系！是我们现在的样子……我们……这样不健康！不正常！"

# game/ch1ep3p2.rpy:3837
translate chinese ainepubtensionbuildup_aa21234e:

    # mc "So, you're giving up on us?"
    mc "所以，你是想分手？"

# game/ch1ep3p2.rpy:3840
translate chinese ainepubtensionbuildup_3c0ce0fc:

    # a "No, I'm saying we both need to think, to consider if this is what we want."
    a "不，我是觉得我们两个都需要思考一下，想想这是不是真的是我们想要的。"

# game/ch1ep3p2.rpy:3841
translate chinese ainepubtensionbuildup_2b8dab3a:

    # mc "Time apart, then. Is that your solution?"
    mc "那就是暂时分开呗。这就是你的解决办法？"

# game/ch1ep3p2.rpy:3842
translate chinese ainepubtensionbuildup_4787d861:

    # a "Maybe. Maybe we both need space to figure ourselves out."
    a "可能吧。可能我们两个都需要一点空间，把事情想清楚。"

# game/ch1ep3p2.rpy:3845
translate chinese ainepubtensionbuildup_e5f3ee43:

    # mc "Fine. But don't lump me in with \"we\". It seems like you're the one who needs to sort things out."
    mc "好吧。但不要说什么“我们”。我觉得只有你需要把事情想清楚。"

# game/ch1ep3p2.rpy:3848
translate chinese ainepubtensionbuildup_746d0f1a:

    # a "Maybe you're right..."
    a "可能吧……"

# game/ch1ep3p2.rpy:3851
translate chinese ainepubtensionbuildup_1497197c:

    # m "Are you really okay with this decision?"
    m "你真的能接受这个决定吗？"

# game/ch1ep3p2.rpy:3852
translate chinese ainepubtensionbuildup_b4f7a820:

    # mc "I'm not, but Aine needs the space. I know her well enough to understand."
    mc "我接受不了，但是艾妮需要一个人静静。我了解她。"

# game/ch1ep3p2.rpy:3853
translate chinese ainepubtensionbuildup_c2225ec5:

    # mc "When she's not herself, what you say goes in one ear and out the other."
    mc "她变得不是自己之后，对她说的话全都是左耳进右耳出。"

# game/ch1ep3p2.rpy:3854
translate chinese ainepubtensionbuildup_d0745445:

    # mc "Usually, I'd just tell her to snap out of it or cut the conversation short. It works most of the time."
    mc "一般来说，我只会让她清醒点，或者直接不理她。大部分时候都有用。"

# game/ch1ep3p2.rpy:3855
translate chinese ainepubtensionbuildup_470238c6:

    # mc "But this... was different. Things went too far."
    mc "但这次……不一样。事情闹太大了。"

# game/ch1ep3p2.rpy:3858
translate chinese ainepubtensionbuildup_87554f88:

    # m "I'm not one to interject, but you should consider taking time for yourself, too."
    m "我一般不爱插嘴，但你也应该花点时间仔细想想了。"

# game/ch1ep3p2.rpy:3859
translate chinese ainepubtensionbuildup_140bb3a6:

    # mc "Why do you say that?"
    mc "为什么？"

# game/ch1ep3p2.rpy:3860
translate chinese ainepubtensionbuildup_910ad872:

    # m "From what I've observed, it seems like you're still unsure about why you let her back into your life."
    m "根据我的观察，你似乎也还没彻底确定你为什么会让她回到你的生活里。"

# game/ch1ep3p2.rpy:3863
translate chinese ainepubtensionbuildup_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/ch1ep3p2.rpy:3866
translate chinese ainepubtensionbuildup_cb3a715a:

    # mc "You're pretty observant for someone who claims to have no experience in these matters."
    mc "你嘴上说对这种事没有经验，看得却很清楚啊。"

# game/ch1ep3p2.rpy:3867
translate chinese ainepubtensionbuildup_ca02d5a8:

    # m "I don't. But I heard everything back on the beach."
    m "我是没经验，但你们在沙滩上的话我都听到了。"

# game/ch1ep3p2.rpy:3868
translate chinese ainepubtensionbuildup_4273d34e:

    # m "I don't need experience to see that your relationship lacks a solid foundation."
    m "我不需要经验也能看出来你们的感情缺失坚实的基础。"

# game/ch1ep3p2.rpy:3869
translate chinese ainepubtensionbuildup_7b66918b:

    # m "Your relationship began almost like some elaborate charade that you had to go along with; not out of choice, but necessity."
    m "你们的感情的开始，是因为你们必须参与一场虚假的表演；也就是说，被逼的。"

# game/ch1ep3p2.rpy:3870
translate chinese ainepubtensionbuildup_5ed51673:

    # m "It's as if you both have followed a path neither of you chose, but one you felt compelled to follow."
    m "你们两个走的都不是自己选的路，而是自己必须走的路。"

# game/ch1ep3p2.rpy:3871
translate chinese ainepubtensionbuildup_b2e2cec0:

    # m "Like you're each other's shield and weapon, but there's no deeper connection."
    m "就好像你们互为对方的盾牌和武器，但却没有更深的联系了。"

# game/ch1ep3p2.rpy:3872
translate chinese ainepubtensionbuildup_d5b3b971:

    # m "If you two had a real understanding, this fallout almost certainly would not have happened."
    m "如果你们真的互相理解，刚刚的事基本也就不可能发生了。"

# game/ch1ep3p2.rpy:3875
translate chinese ainepubtensionbuildup_19765d05:

    # mc "... You might be right. I've always had the feeling that this was inevitable."
    mc "……你说的可能是对的。我一直都觉得大吵一架是不可避免的。"

# game/ch1ep3p2.rpy:3878
translate chinese ainepubtensionbuildup_d84f8c4a:

    # m "In my experience, respect and admiration among comrades are common, but it's not the same as a true bond."
    m "以我的经验，在战友之间，尊重和钦佩非常普遍，但却不算是真正的牵绊。"

# game/ch1ep3p2.rpy:3879
translate chinese ainepubtensionbuildup_fb2024ab:

    # m "We rely on each other, but when we lose someone, it's the role we miss, not the person."
    m "我们互相依赖，但失去某个人之后，想念的只是一个角色，而不是具体的人。"

# game/ch1ep3p2.rpy:3880
translate chinese ainepubtensionbuildup_1f04c673:

    # m "It's a harsh reality, and I wish I could go back and change that. But I can't."
    m "这是很残酷的现实，我也希望我能回去，改变这一切。可我做不到。"

# game/ch1ep3p2.rpy:3883
translate chinese ainepubtensionbuildup_b98b136b:

    # m "So, [mc], you and Aine have a chance to make things right. Don't waste it, or else I'll feel sad."
    m "所以，[mc!t]，你和艾妮是有机会重回正轨的。不要浪费，不然我会伤心的。"

# game/ch1ep3p2.rpy:3886
translate chinese ainepubtensionbuildup_9811dbd2:

    # m "You two look good together, after all."
    m "毕竟你们两个很般配。"

# game/ch1ep3p2.rpy:3888
translate chinese ainepubtensionbuildup_99df6ddb:

    # yt "She doesn't smile often, but when she does, it's surprisingly captivating."
    yt "她不经常笑，但是笑的时候，真是意外的迷人。"

# game/ch1ep3p2.rpy:3889
translate chinese ainepubtensionbuildup_ddf181db:

    # yt "Maybe it's the rarity of her smiles that makes each one seem so earnest and heartfelt."
    yt "或许正是因为她不常笑，才让她的每次笑容如此真诚、动人。"

# game/ch1ep3p2.rpy:3892
translate chinese ainepubtensionbuildup_34a20107:

    # mc "Yeah, I know..."
    mc "嗯，我明白……"

# game/ch1ep3p2.rpy:3893
translate chinese ainepubtensionbuildup_75f66456:

    # mc "It's just... this will be much more painful than I thought."
    mc "只是……这会比我预想的痛苦很多。"

# game/ch1ep3p2.rpy:3896
translate chinese ainepubtensionbuildup_e95ccfc1:

    # m "No time for regrets, commander. Remember: you're still living under the same roof. What are you going to do now?"
    m "没时间后悔了，指挥官。记住：你们依然生活在同一个屋檐下。你还能怎么办呢？"

# game/ch1ep3p2.rpy:3897
translate chinese ainepubtensionbuildup_a2a5a2f1:

    # mc "Damn, that's true..."
    mc "操，对啊……"

# game/ch1ep3p2.rpy:3900
translate chinese ainepubtensionbuildup_48fd7b9d:

    # shu "Whoa, did I just walk into a breakup scene? That's rough, man."
    shu "哇，我是目击了分手现场吗？难受啊，兄弟。"

# game/ch1ep3p2.rpy:3901
translate chinese ainepubtensionbuildup_ef2830ec:

    # shu "You know you can crash at my place, right?"
    shu "你随时可以来我家睡的。"

# game/ch1ep3p2.rpy:3902
translate chinese ainepubtensionbuildup_66b69c4d:

    # mc "No, thanks."
    mc "不用了，谢谢。"

# game/ch1ep3p2.rpy:3905
translate chinese ainepubtensionbuildup_f827f6da:

    # shu "Of course not! Right, right!"
    shu "啊对对对！当然不用了！"

# game/ch1ep3p2.rpy:3906
translate chinese ainepubtensionbuildup_fb324998:

    # shu "And hey, you could just kick her out, you know?"
    shu "要不，你把她赶出去也行？"

# game/ch1ep3p2.rpy:3907
translate chinese ainepubtensionbuildup_ee147bfd:

    # mc "I don't want to escalate things further. It's complicated enough as it is."
    mc "我不想闹得更大了。现在就已经够复杂了。"

# game/ch1ep3p2.rpy:3910
translate chinese ainepubtensionbuildup_fb42e683:

    # m "If you need it, our couch is always available."
    m "你需要的话，随时可以来睡我们这的沙发。"

# game/ch1ep3p2.rpy:3913
translate chinese ainepubtensionbuildup_1c4d4ba6:

    # shu "Don't worry, dude. That's what your best neighbors are here for. We got you."
    shu "别担心，哥们。有你最好的邻居们在呢。没问题的。"

# game/ch1ep3p2.rpy:3914
translate chinese ainepubtensionbuildup_00802db7:

    # m "*chuckles* Thanks."
    m "*笑* 谢谢。"

# game/ch1ep3p2.rpy:3921
translate chinese ainepubtensionbuildup_1f90de75:

    # g "Hey, you're back."
    g "啊，你回来了。"

# game/ch1ep3p2.rpy:3924
translate chinese ainepubtensionbuildup_bb8e4b4e_2:

    # a "..."
    a "……"

# game/ch1ep3p2.rpy:3925
translate chinese ainepubtensionbuildup_31a50dc8:

    # g "What's this?"
    g "怎么了？"

# game/ch1ep3p2.rpy:3928
translate chinese ainepubtensionbuildup_326662b2:

    # g "Hm, let me guess... A fallout?"
    g "嗯，我猜猜……吵架了？"

# game/ch1ep3p2.rpy:3929
translate chinese ainepubtensionbuildup_bb8e4b4e_3:

    # a "..."
    a "……"

# game/ch1ep3p2.rpy:3930
translate chinese ainepubtensionbuildup_62266c5e:

