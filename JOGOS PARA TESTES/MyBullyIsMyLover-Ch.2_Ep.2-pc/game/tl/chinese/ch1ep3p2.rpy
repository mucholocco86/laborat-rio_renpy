    old "Go home for lunch"
    new "回家吃午饭"

    # game/ch1ep3p2.rpy:226
    old "Satisfy your curiosity"
    new "满足你的好奇心"

    # game/ch1ep3p2.rpy:342
    old "Dodge Challenger SRT 392"
    new "道奇挑战者SRT392"

    # game/ch1ep3p2.rpy:342
    old "Dodge Challenger SRT Demon"
