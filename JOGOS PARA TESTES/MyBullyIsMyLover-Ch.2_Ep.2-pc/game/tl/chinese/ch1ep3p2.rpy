translate chinese crackinganaineopen_e1178710:

    # a "What's your name? Why are you doing this?"
    a "你叫什么名字？为什么要做这种事？"

# game/ch1ep3p2.rpy:3026
translate chinese crackinganaineopen_7c23fad5:

    # gun "Shut up and get over here!"
    gun "闭嘴，给我过来！"

