translate chinese crackinganaineopen_bd59eafc:

    # a "Not until you answer the question."
    a "那要等你回答我的问题才行。"

# game/ch1ep3p2.rpy:3030
translate chinese crackinganaineopen_a0bb2258:

    # gun "..."
    gun "……"

# game/ch1ep3p2.rpy:3033
translate chinese crackinganaineopen_bb8e4b4e_9:

    # a "..."
    a "……"

# game/ch1ep3p2.rpy:3035
translate chinese crackinganaineopen_b17706c2:

    # gun "... F-fine."
    gun "……行-行吧。"

# game/ch1ep3p2.rpy:3036
translate chinese crackinganaineopen_2a1b7809:

    # gun "Names don't matter. And I..."
    gun "我叫什么都无所谓。我……"

