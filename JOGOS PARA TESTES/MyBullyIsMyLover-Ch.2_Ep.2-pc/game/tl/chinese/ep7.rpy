    # h "Bastard!" with hpunch
    h "混蛋！" with hpunch

# game/ep7.rpy:824
translate chinese ep7_f3a532bf:

    # h "You assassin clan members are nothing but a goddamn annoyance!"
    h "你们这些刺客氏族的人没一个好东西！净会添麻烦！"

# game/ep7.rpy:825
translate chinese ep7_673048cd:

    # yt "Assassin clan members?"
    yt "刺客氏族？"

# game/ep7.rpy:828
translate chinese ep7_ceaa906d:

    # yt "Is she talking about those two? Or..."
    yt "她是在说那两个人吗？还是……"

# game/ep7.rpy:830
translate chinese ep7_917f7f70:

    # a "Where are Emma's papers? Give them to me."
    a "艾玛的文件在哪？全都给我。"

# game/ep7.rpy:831
translate chinese ep7_b914be02:

    # h "Is that how you ask your mother for a favor? It's such a pity seeing what this guy turned you into, my dear daughter."
    h "你就是这样求你妈妈帮忙的吗？我亲爱的女儿啊，没想到这男的把你变成了这样子。"

# game/ep7.rpy:832
translate chinese ep7_76a25523:

    # a "I never once asked you for a favor, I'm telling you to do it."
    a "我从来没求过你帮忙，我是在要求你。"

# game/ep7.rpy:833
translate chinese ep7_b602753f:

    # a "And no, you are wrong..."
    a "还有，你错了……"

# game/ep7.rpy:834
translate chinese ep7_49d1d144:

    # a "It is {b}you{/b} who turned me into this, mother."
    a "是{b}你{/b}把我变成这样的，妈妈。"

# game/ep7.rpy:835
translate chinese ep7_23e36dfc:

    # a "I should've done this long ago, but despite what you did, I still had a little respect for you because you are the one who gave birth to me."
    a "我早就该这样了，但尽管你做过那么多错事，我还是因为你毕竟是我的亲生母亲，对你有一点点尊重。"

# game/ep7.rpy:838
translate chinese ep7_d7f6db11:

    # a "I was hoping that one day... you'd change, because I've always missed the old you."
    a "我希望有一天……你会变回去，因为我一直很想念从前的你。"

# game/ep7.rpy:839
translate chinese ep7_934d601a:

    # a "You would always pat my head every time I did something good."
    a "你在我表现好的时候总会摸我的头。"

# game/ep7.rpy:840
translate chinese ep7_681978b6:

    # a "They might have been {b}nothing{/b} to you, but I deeply cherished those moments."
    a "可能对你来说那{b}什么都不算{/b}，但我非常珍惜以前的那段时光。"

# game/ep7.rpy:841
translate chinese ep7_09a89860:

    # a "But after I learned that you are the one playing with our fates..."
    a "但是在我知道就是你在践踏我们的人生之后……"

# game/ep7.rpy:842
translate chinese ep7_042cf673:

    # a "I lost it, mother..."
    a "那些回忆全都消失了，妈妈……"

# game/ep7.rpy:843
translate chinese ep7_b282c67e:

    # a "No... you are not my mother. She is already long gone."
    a "不……你不是我妈妈。她早就已经不在了。"

# game/ep7.rpy:846
translate chinese ep7_a5f4dfec:

    # f "Hm? What with all the commotion out there?"
    f "嗯？外面在闹什么呢？"

# game/ep7.rpy:847
translate chinese ep7_59ae362f:

    # f "Wait, isn't that sis?!"
    f "等等，那不是姐姐吗？！"

# game/ep7.rpy:851
translate chinese ep7_774e4b54:

    # "*knocks*"
    "*敲门*"

# game/ep7.rpy:852
translate chinese ep7_01702a03:

    # f "Uhm... Yes?"
    f "呃……谁啊？"

# game/ep7.rpy:853
translate chinese ep7_b8a5b3d8:

    # j "Freya, dear. It's me."
    j "芙蕾雅，亲爱的。是我。"

# game/ep7.rpy:854
translate chinese ep7_c9793da4:

    # f "Jess?! What are you doing here? I mean, come in!"
    f "婕斯？！你怎么在这？快进来！"

# game/ep7.rpy:858
translate chinese ep7_79c3aebd:

    # j "Come with me. You have to know something."
    j "跟我来，有些事你必须知道。"

# game/ep7.rpy:866
translate chinese ep7_301f3104:

    # f "*gasps*"
    f "*惊讶*"

# game/ep7.rpy:867
translate chinese ep7_4c7ffcc4:

    # f "Sis?! [mc!t]?! What in the hell are you all doing here?! What's happening?!"
    f "姐姐？！[mc!t]？！你们俩怎么在这啊？！到底什么情况？！"

# game/ep7.rpy:870
translate chinese ep7_af5385fa:

    # m "'Sup. Do you guys have some popcorn? I forgot to bring some lollipops."
    m "你好啊。你们家有爆米花吗？我来的时候忘带棒棒糖了。"

# game/ep7.rpy:871
translate chinese ep7_378775ad:

    # cl "Fang, quiet."
    cl "安静，獠牙。"

# game/ep7.rpy:874
translate chinese ep7_38e35450:

    # h "*chuckles*"
    h "*笑*"

# game/ep7.rpy:877
translate chinese ep7_6ba4b5a4:

    # h "AHAHAHAHAHAHAHAAA!!"
    h "哈哈哈哈哈哈！！"

# game/ep7.rpy:879
translate chinese ep7_b297d21b:

    # h "AAAHAHAHAHAHAHAHAHAHAHAHAHAAAA~!!"
    h "啊哈哈哈哈哈哈哈~！！"

# game/ep7.rpy:880
translate chinese ep7_54f758c6:

    # h "Yes! You are right, the old me is long gone!"
    h "是啊！你说得对，过去的我早就消失了！"

# game/ep7.rpy:881
translate chinese ep7_3c2e0022:

    # h "I lost everything from the day I lost this family's hopes, Aine!"
    h "从我失去这个家的希望那一天开始，我就什么也不剩了，艾妮！"

# game/ep7.rpy:882
translate chinese ep7_55c02367:

    # a "......."
    a "……"

# game/ep7.rpy:885
translate chinese ep7_838bd2ad:

    # h "You know, boy..."
    h "知道吗，小子……"

# game/ep7.rpy:886
translate chinese ep7_4d19fde9:

    # h "Your [landlady!t] and I used to be close friends."
    h "你[landlady!t]和我是很亲密的朋友。"

# game/ep7.rpy:887
translate chinese ep7_d8b8865f:

    # h "...No, we were {b}best friends{/b}."
    h "……不，我跟她曾经是{b}最好的朋友{/b}。"

# game/ep7.rpy:890
translate chinese ep7_b14f1788:

    # h "(I chose to be a lone wolf thinking that nobody would have the guts to get close to me because of my name, but I was wrong.)"
    h "（我以为大家都会怕我，不敢靠近我，会一直一个人下去，但我错了。）"

# game/ep7.rpy:893
translate chinese ep7_fc61ab81:

    # k "Hey, you're that Mafia gal everyone is talking about, yes?"
    k "嘿，你就是大家都在说的那个黑手党，对吧？"

# game/ep7.rpy:894
translate chinese ep7_d9f54b9a:

    # k "Damn, girl, you are pretty!"
    k "可以啊，你长得真漂亮！"

# game/ep7.rpy:895
translate chinese ep7_5be04572:

    # k "By the way, is this seat taken?"
    k "这位子有人吗？"

# game/ep7.rpy:896
translate chinese ep7_5601ad40:

    # h "Uhh... No."
    h "呃……没有。"

# game/ep7.rpy:899
translate chinese ep7_7d72d897:

    # k "Phew~! I thought I was going to be late."
    k "太好了~！我还以为我要迟到了。"

# game/ep7.rpy:900
translate chinese ep7_8bbc22d1:

    # h "(I used to stare at her wondering why she was not afraid of me.)"
    h "（我经常盯着她看，思考她为什么不怕我。）"

# game/ep7.rpy:901
translate chinese ep7_eb5f22e5:

    # h "(Hell, no one even wanted to sit in the same row with me, but she was different.)"
    h "（之前甚至都没有人愿意跟我坐在同一排，但她不一样。）"

# game/ep7.rpy:902
translate chinese ep7_7b3f251f:

    # h "(Things like status or names don't matter to her.)"
    h "（地位、名声这些东西对她来说什么都不算。）"

# game/ep7.rpy:905
translate chinese ep7_199f64fc:

    # h "(And so I accepted her into my life.)"
    h "（所以我就欣然接受了她。）"

# game/ep7.rpy:908
translate chinese ep7_a0f66840:

    # k "What?! Did you forgot what the professor said yesterday?!"
    k "什么？！你忘了老师昨天怎么说的吗？！"

# game/ep7.rpy:909
translate chinese ep7_e8b02166:

    # k "Girl, you are mentally challenged!"
    k "姐妹，你这题绝对做错了！"

# game/ep7.rpy:910
translate chinese ep7_8ba45367:

    # h "Excuse me?! I'm taking notes, you bitch! There is no way I'm wrong!"
    h "你说什么？！我都做过笔记了，臭女人！我不可能错！"

# game/ep7.rpy:911
translate chinese ep7_7cd5df8b:

    # k "You took the wrong notes then!"
    k "那你的笔记也记错了！"

# game/ep7.rpy:912
translate chinese ep7_8bb6807a:

    # h "(We used to fight often. However, that did not stop our friendship — rather, it brought us even closer.)"
    h "（我们那时候经常吵架。但是，那完全没有影响到我们的友谊——甚至可以说让我们更亲近了。）"

# game/ep7.rpy:915
translate chinese ep7_e83be907:

    # h "(...Until we fell in love with the same guy... Jovian.)"
    h "（……直到后来我们爱上了同一个人……乔维安。）"

# game/ep7.rpy:916
translate chinese ep7_ba134f2a:

    # h "(Jovian was my personal bodyguard who treated me with the utmost respect.)"
    h "（乔维安是我的私人保镖，对我非常尊重。）"

# game/ep7.rpy:917
translate chinese ep7_16845a39:

    # h "(Not long after he got appointed, I came to fall in love with him.)"
    h "（他被派到我身边不久，我就爱上他了。）"

# game/ep7.rpy:918
translate chinese ep7_7488b8e7:

    # h "(My feelings for him made me ignore the reality...)"
    h "（我对他的感情让我忘记了现实……）"

# game/ep7.rpy:919
translate chinese ep7_34ca7929:

    # h "(But I learned that it's not always going to be about you...)"
    h "（但后来我发现，世界并不是绕着我转的……）"

# game/ep7.rpy:920
translate chinese ep7_7755b324:

    # h "(That there is always someone better than you out there...)"
    h "（总会有人比自己更好，更优秀……）"

# game/ep7.rpy:921
translate chinese ep7_0ee05f8d:

    # h "(Years later, after we graduated from college... it finally came down to it.)"
    h "（几年后，我们大学毕业了……也终于结束了。）"

# game/ep7.rpy:924
translate chinese ep7_5af9cb14:

    # jov "I'm really sorry, Hera..."
    jov "我很抱歉，赫拉……"

# game/ep7.rpy:925
translate chinese ep7_d3de70ce:

    # jov "Klara is pregnant and I have to take responsibility for it."
    jov "克拉拉怀孕了，我必须负起责任来。"

# game/ep7.rpy:926
translate chinese ep7_5c8efd64:

    # jov "I'm going to quit my job, so this might be the last day we'll see each other."
    jov "我要辞职了，所以今天可能是我们最后一次见面了。"

# game/ep7.rpy:927
translate chinese ep7_3c7dd326:

    # jov "I already asked your father about it."
    jov "我已经跟你父亲说过了。"

# game/ep7.rpy:928
translate chinese ep7_548b6bdd:

    # h "After everything I did for you, this is a sorry excuse, Jovian."
    h "我为了你做过那么多，你这个理由也显得有些苍白啊，乔维安。"

# game/ep7.rpy:932
translate chinese ep7_1fd6fda8:

    # h "Honestly, it wasn't hard for me to let go. I wasn't so heartless as to not understand the situation."
    h "说实话，我当时选择放手也没有很困难。我没有无情到不理解他们的处境。"

# game/ep7.rpy:935
translate chinese ep7_79842c98:

    # h "And so, I let them have the life they wanted."
    h "所以，我就让他们去过他们想要的生活了。"

# game/ep7.rpy:938
translate chinese ep7_c1528aee:

    # h "A year later, I eventually found the man that completed my missing piece — Richard, Aine and Freya's father."
    h "一年之后，我最终遇到了能填补我内心的空白的男人——理查德，艾妮和芙蕾雅的父亲。"

# game/ep7.rpy:939
translate chinese ep7_18a10fab:

    # h "We were happy with what we had and couldn't have asked for anything more..."
    h "我们对一切都很满意，也别无他求了……"

# game/ep7.rpy:940
translate chinese ep7_f3bcb1b9:

    # h "Now, you two listen carefully."
    h "现在，你们两个给我听好了。"

# game/ep7.rpy:943
translate chinese ep7_5cbd24b3:

    # h "In our family, bearing a male offspring is considered our hope — the next heir of the group."
    h "在我们家，生出男性后代——组织的下一位领导者，就是我们的希望。"

# game/ep7.rpy:944
translate chinese ep7_b1a54b3e:

    # h "However, it also carries great danger."
    h "然而，其中也有很大的风险。"

# game/ep7.rpy:945
translate chinese ep7_de9b96a1:

    # h "After finding out that I was pregnant with a boy, your father and I decided and told you that we would temporarily live away."
    h "在发现我肚子里怀上了男孩之后，我和你爸爸决定暂时搬出去住。"

# game/ep7.rpy:946
translate chinese ep7_4eb4fbf0:

    # h "For you... and your brother's safety."
    h "那是为了你……和你弟弟的安全着想。"

# game/ep7.rpy:949
translate chinese ep7_8aad0355:

    # h "But..."
    h "但是……"

# game/ep7.rpy:952
translate chinese ep7_266d320b:

    # ri "......"
    ri "……"

# game/ep7.rpy:955
translate chinese ep7_c249bd15:

    # h "Don't stare at him like that, or he'll melt."
    h "别老盯着他看了，我们的儿子都要被你看化了。"

# game/ep7.rpy:956
translate chinese ep7_46839e3b:

    # ri "He's so lovely..."
    ri "他太可爱了……"

# game/ep7.rpy:957
translate chinese ep7_29f9f7c8:

    # ri "Too bad, seems he got everything from you. He doesn't even have my nose."
    ri "真可惜，看来他什么东西都是从你那遗传来的。他连鼻子都跟我不像。"

# game/ep7.rpy:958
translate chinese ep7_634afd00:

    # h "Well, he's got your hair color, at least. And I reckon he got his personality from you."
    h "至少他头发的颜色是随你的。我估计他的性格肯定也跟你一样。"

# game/ep7.rpy:961
translate chinese ep7_4922d47e:

    # ri "Heeh... How can you tell?"
    ri "哈哈……你怎么知道？"

# game/ep7.rpy:962
translate chinese ep7_05976b30:

    # h "Never underestimate a mother's instinct, Richard."
    h "不要低估母亲的直觉，理查德。"

# game/ep7.rpy:963
translate chinese ep7_e67ffb9a:

    # ri "Alright, alright. I'll give it to you."
    ri "好吧，好吧。那就听你的。"

# game/ep7.rpy:966
translate chinese ep7_53f3c4de:

    # h "I can't wait to show him to his sisters. Aine was so excited when I told her that we're finally coming home."
    h "我等不及要把他带给他的两个姐姐们看看了。我说我们终于要回家了的时候，艾妮可兴奋了。"

# game/ep7.rpy:967
translate chinese ep7_c079f4fa:

    # ri "They will love him for sure."
    ri "她们肯定也会爱他的。"

# game/ep7.rpy:968
translate chinese ep7_cab51fab:

    # ri "After my time, he'll be the one to lead the group, no?"
    ri "在我之后，就该让他来带领组织了，对吧？"

# game/ep7.rpy:969
translate chinese ep7_1785b969:

    # h "Exactly..."
    h "没错……"

# game/ep7.rpy:970
translate chinese ep7_9f42626e:

    # h "Father may still be alive, but when it's our time, we'll change the group into something better."
    h "爸爸虽然还活着，但到了我们的时代，我们会把组织变得更好的。"

# game/ep7.rpy:971
translate chinese ep7_1c4df334:

    # h "Something that will help our people achieve their dreams."
    h "变成一个能帮我们的人实现梦想的组织。"

# game/ep7.rpy:974
translate chinese ep7_bf6897c6:

    # ri "Oof... That will be a challenge considering the current state of the group."
    ri "哈哈……考虑到组织的现状，这可是个不简单的事啊。"

# game/ep7.rpy:975
translate chinese ep7_cbb56c22:

    # h "Don't worry, you have me."
    h "不用担心，你有我呢。"

# game/ep7.rpy:978
translate chinese ep7_279b49d0:

    # ri "...Yeah... For Simon."
    ri "……是啊……为了西蒙。"

# game/ep7.rpy:979
translate chinese ep7_0adea557:

    # ri "I'm sure he'll be the greatest leader among us."
    ri "我敢说，他会是我们之中最杰出的领导者。"

# game/ep7.rpy:980
translate chinese ep7_030277cb:

    # h "I never thought that you would be this kind of dreamer, Richard."
    h "我从来没想过你有这种梦想，理查德。"

# game/ep7.rpy:981
translate chinese ep7_577cb441:

    # ri "Well, despite the fact that I was just a simple man without any knowledge of your family, your father accepted me for who I am."
    ri "嗯，尽管我只是个对你家的事一无所知的普通人，你爸爸还是接受了这样的我。"

# game/ep7.rpy:982
translate chinese ep7_ac340ac8:

    # ri "So in return, I'll be a good son-in-law and a father to his grandchildren."
    ri "所以作为回报，我会尽力做个尽职的女婿，给他的孙子做一个好爸爸。"

# game/ep7.rpy:985
translate chinese ep7_6cb1ee23:

    # h "Mmm..."
    h "嗯……"

# game/ep7.rpy:986
translate chinese ep7_7bce48e2:

    # h "But don't think about it for now."
    h "但现在就先不用考虑这些事了。"

# game/ep7.rpy:987
translate chinese ep7_fadc9978:

    # ri "Although... There was a time where I thought of taking you all away from this kind of living and just having a simple life like any other family out there..."
    ri "尽管……有时候我也会想带着你们抛下这一切，去像其他人一样过普通的生活……"

# game/ep7.rpy:988
translate chinese ep7_dc5f1758:

    # h "I thought we already talked about that?"
    h "我们不是谈过这事了吗？"

# game/ep7.rpy:989
translate chinese ep7_b1655f50:

    # h "Even if we hide, you know that my father will always find us no matter how far we go."
    h "哪怕我们躲到天涯海角，我爸爸也有办法找到我们的。"

# game/ep7.rpy:990
translate chinese ep7_72457f06:

    # h "As long as he's alive, we can never fully break away from his grasp."
    h "只要他活着，我们永远没法脱离他的掌控的。"

# game/ep7.rpy:991
translate chinese ep7_86ca4985:

    # h "Don't worry, Richard. We'll be fine, trust me."
    h "没事的，理查德。我们会没事的，相信我。"

# game/ep7.rpy:992
translate chinese ep7_69251bba:

    # ri "Yeah..."
    ri "嗯，好……"

# game/ep7.rpy:995
translate chinese ep7_a78e1627:

    # ri "*chuckles* Jovian once told me about his son."
    ri "*笑* 乔维安之前也跟我说过他的儿子。"

# game/ep7.rpy:996
translate chinese ep7_76095fbb:

    # ri "I'm sure that someday, we will have a time where we can have fun together..."
    ri "将来肯定有一天，我们会一起出去好好玩玩……"

# game/ep7.rpy:999
translate chinese ep7_d138eb02:

    # h "Just his son, huh?"
    h "就他的儿子吗？"

# game/ep7.rpy:1000
translate chinese ep7_41cf226b:

    # h "So it's just all you boys?"
    h "所以只有你们几个大男人能参加？"

# game/ep7.rpy:1001
translate chinese ep7_639c64a5:

    # ri "W-well... Ahaha!"
    ri "这-这个嘛……啊哈哈！"

# game/ep7.rpy:1002
translate chinese ep7_0c596933:

    # ri "Of course, you're going to be with us. From time to time maybe?"
    ri "当然，你也会跟我们一起的。说不定偶尔可以让你跟来？"

# game/ep7.rpy:1003
translate chinese ep7_d309ee1d:

    # h "I'm going to kill you if one of our kids turns out to be like you!"
    h "要是我们的孩子长大了跟你一样，我饶不了你！"

# game/ep7.rpy:1004
translate chinese ep7_808a7788:

    # ri "I'm just kidding, just kidding!"
    ri "我开个玩笑，开个玩笑嘛！"

# game/ep7.rpy:1005
translate chinese ep7_3e306717:

    # ri "You'll be with me wherever I go, Hera. You and the girls."
    ri "我去哪都会带着你的，赫拉。你，还有女儿们。"

# game/ep7.rpy:1008
translate chinese ep7_6254552b:

    # h "And of course, our handsome little Simon."
    h "当然，还有我们帅气的小西蒙。"

# game/ep7.rpy:1011
translate chinese ep7_19008bde:

    # h "I love you, Richard."
    h "我爱你，理查德。"

# game/ep7.rpy:1012
translate chinese ep7_2a667481:

    # ri "I love you too, Hera."
    ri "我也爱你，赫拉。"

# game/ep7.rpy:1013
translate chinese ep7_5aa7f254:

    # h "Time to go home?"
    h "那我们回家吧？"

# game/ep7.rpy:1014
translate chinese ep7_273e78fa:

    # ri "Yeah, let's go."
    ri "好啊，走吧。"

# game/ep7.rpy:1024
translate chinese ep7_268c83e4:

    # ri "Jeez... I'm so excited. I can't wait to show him to the girls."
    ri "天啊……我好兴奋啊。等不及要把他带给女儿们看了。"

# game/ep7.rpy:1025
translate chinese ep7_21b8db09:

    # h "Yes, me either. It's been more than a year since we last saw them too."
    h "是啊，我也是。我们都有一年多没回家了。"

# game/ep7.rpy:1026
translate chinese ep7_8b0c1287:

    # ri "I'm sure they will be losing their minds. Haha!"
    ri "她们肯定会疯到睡不着觉的。哈哈！"

# game/ep7.rpy:1027
translate chinese ep7_bd515b63:

    # h "Hmhmm... I know."
    h "嗯嗯……我知道。"

# game/ep7.rpy:1030
translate chinese ep7_0da509ba:

    # ri "Hera, let's-"
    ri "赫拉，我们——"

# game/ep7.rpy:1039
translate chinese ep7_11109a46:

    # ri "Uugh... Shit...!"
    ri "呃……怎么会……！"

# game/ep7.rpy:1040
translate chinese ep7_56f8319b:

    # ri "What..."
    ri "什么……"

# game/ep7.rpy:1042
translate chinese ep7_a07120f3:

    # ri "What just... happened...?"
    ri "到底……怎么回事……？"

# game/ep7.rpy:1047
translate chinese ep7_c045c5a0:

    # ri "Hera!" with hpunch
