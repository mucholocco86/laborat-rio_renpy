translate chinese ep7_04204403:

    # cl "Hm, I expected a different reaction."
    cl "嗯，我没想到你会是这种反应。"

# game/ep7.rpy:3470
translate chinese emmarevert_8c981231:

    # g "Well shit, [mc]..."
    g "我操，[mc!t]……"

