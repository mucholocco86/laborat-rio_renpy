    # k "Do you mind telling me the truth?"
    k "你能把实话告诉我吗？"

# game/ep7.rpy:576
translate chinese ep7_f0d2b3b1:

    # j "I simply want to mend both sides, Klara."
    j "我想兼顾你们两方，克拉拉。"

