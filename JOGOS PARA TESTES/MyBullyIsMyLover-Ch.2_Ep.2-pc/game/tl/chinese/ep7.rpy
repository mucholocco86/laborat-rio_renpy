translate chinese ep7_b59077a1:

    # mc "I'm really looking forward to that."
    mc "我很期待。"

# game/ep7.rpy:547
translate chinese ep7_b4013c1e:

    # j "Go easy on your [landlady!t], will you?"
    j "对你[landlady!t]温柔点，好吧？"

