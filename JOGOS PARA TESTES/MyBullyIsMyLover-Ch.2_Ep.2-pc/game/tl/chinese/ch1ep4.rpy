# game/ch1ep4.rpy:3
translate chinese ch1ep4_a2a253be:

    # f "[mc]~!!"
    f "[mc!t]~！！"

# game/ch1ep4.rpy:4
translate chinese ch1ep4_487a1850:

    # m "Hm?"
    m "嗯？"

# game/ch1ep4.rpy:6
translate chinese ch1ep4_0b88e3b2:

    # f "[mc]!"
    f "[mc!t]！"

# game/ch1ep4.rpy:7
translate chinese ch1ep4_f1da8720:

    # mc "Freya? I thought you were..."
    mc "芙蕾雅？我还以为你……"

# game/ch1ep4.rpy:8
translate chinese ch1ep4_cd5bf441:

    # f "Forget about that! L...look at this!"
    f "别管别的了！快……快看！"

# game/ch1ep4.rpy:9
translate chinese ch1ep4_9de8b9cd:

    # mc "A letter? Who's it from?"
    mc "是信吗？谁写的？"

# game/ch1ep4.rpy:10
translate chinese ch1ep4_bec78d10:

    # f "It's from Mom!"
    f "我妈！"

# game/ch1ep4.rpy:11
translate chinese ch1ep4_2384c5f0:

    # m "What's happening here?"
    m "怎么了？"

# game/ch1ep4.rpy:12
translate chinese ch1ep4_6f7c9a73:

    # f "I woke up just before you left, and I found the gift... I thought it was only a dress, but then..."
    f "你们走的时候我正好醒了，就看见了那份礼物……我以为里面只有衣服，结果……"

# game/ch1ep4.rpy:13
translate chinese ch1ep4_130e86a2:

    # f "I found that letter at the bottom."
    f "就在下面找到了这封信。"

# game/ch1ep4.rpy:14
translate chinese ch1ep4_dc4bb565:

    # f "What do you think?"
    f "你怎么想？"

# game/ch1ep4.rpy:15
translate chinese ch1ep4_2b35b6fe:

    # mc "..."
    mc "……"

# game/ch1ep4.rpy:16
translate chinese ch1ep4_82b23f80:

    # mc "We need to talk about this immediately. Let's gather everyone. Now..."
    mc "我们要立马开个会。把大家都喊来。"

# game/ch1ep4.rpy:17
translate chinese ch1ep4_f9fb445e:

    # mc "Get everyone up and have them meet in the living room."
    mc "快让所有人都起床，在客厅集合。"

# game/ch1ep4.rpy:18
translate chinese ch1ep4_7d1858b4:

    # f "Got it!"
    f "好的！"

# game/ch1ep4.rpy:19
translate chinese ch1ep4_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/ch1ep4.rpy:20
translate chinese ch1ep4_1d020fa0:

    # m "Is everything alright?"
    m "你没事吧？"

# game/ch1ep4.rpy:22
translate chinese ch1ep4_4972e2d5:

    # mc "Yeah, I'm going to be fine."
    mc "嗯。我不会有事的。"

# game/ch1ep4.rpy:23
translate chinese ch1ep4_71d410af:

    # mc "First, let's bring this to everyone's attention."
    mc "先把这件事告诉大家吧。"

# game/ch1ep4.rpy:24
translate chinese ch1ep4_e612037c:

    # m "..."
    m "……"

# game/ch1ep4.rpy:25
translate chinese ch1ep4_bdfab4e4:

    # m "{i}I thought I wasn't afraid of anything in this world, but that smile just now... is making me nervous."
    m "{i}我还以为这世上已经没有什么能让我害怕，但刚刚那个微笑……真的让我紧张了。"

# game/ch1ep4.rpy:26
translate chinese ch1ep4_9801691d:

    # m "{i}What's on your mind, Commander? I thought we had a plan?"
    m "{i}你在想什么，指挥官？我们不是已经有计划了吗？"

# game/ch1ep4.rpy:32
translate chinese ch1ep4_e4bf93eb:

    # mc "Sorry, I know it's late, but I hope I didn't bother you too much."
    mc "抱歉，我知道很晚了，希望没有太打扰你们。"

# game/ch1ep4.rpy:33
translate chinese ch1ep4_c1705a3d:

    # g "Don't worry about it, [mc]. This is a pressing matter, sleeping can come later."
    g "没关系的，[mc!t]。事态紧急，睡觉当然可以等等。"

# game/ch1ep4.rpy:35
translate chinese ch1ep4_18871714:

    # yt "[landlady]..."
    yt "[landlady!t]……"

# game/ch1ep4.rpy:36
translate chinese ch1ep4_5d23c194:

    # k "Alright, let's hear it. Whatever she has to say."
    k "好了，来听听她想说什么吧。"

# game/ch1ep4.rpy:37
translate chinese ch1ep4_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/ch1ep4.rpy:39
translate chinese ch1ep4_d7fbd3ac:

    # h "{i}To those I have wronged, especially Aine and [mc]..."
    h "{i}致所有被我伤害过的人，特别是艾妮和[mc!t]……"

# game/ch1ep4.rpy:40
translate chinese ch1ep4_0fc64055:

    # h "{i}As I pen this letter, I find myself at a crossroads, one paved with decisions that have irrevocably altered the course of our lives."
    h "{i}就在我提笔写下这封信时，我发现自己已站在命运的十字路口，过去的决定已永远地更改了我们的人生轨迹。"

# game/ch1ep4.rpy:41
translate chinese ch1ep4_0decab69:

    # h "{i}My actions, born from a place of desperation, blindness and control, have cast long shadows over us all."
    h "{i}我的行为，现在想来是出于绝望、盲目和控制欲，已在我们每个人的人生中都留下了阴影。"

# game/ch1ep4.rpy:42
translate chinese ch1ep4_b1ae365f:

    # h "{i}I stand before you, not as a figure of authority or power, but as someone who has been brought to her knees by the weight of her own choices."
    h "{i}我眼下已失去所有权威的形象，只是一个被自己的选择压倒的可怜人。"

# game/ch1ep4.rpy:43
translate chinese ch1ep4_cc57cbfd:

    # h "{i}I am ensnared, my options dwindling, my freedom a mere illusion. The path I chose was one I believed necessary, yet I recognize now the pain it has inflicted."
    h "{i}我被困住了，能选的路越来越少，我所谓的自由只不过是幻象而已。我选择了我认为是必要的那条路，但我现在已认识到这条路带来的痛苦。"

# game/ch1ep4.rpy:44
translate chinese ch1ep4_6a6ca002:

    # h "{i}For the hurt I have caused, particularly to Aine and [mc], words of apology may seem hollow."
    h "{i}对那些我伤害过的人，特别是艾妮和[mc!t]，道歉的话语似乎只显得苍白无力。"

# game/ch1ep4.rpy:45
translate chinese ch1ep4_09e00bf7:

    # h "{i}But know that my intent now is to mend what has been broken, in the only way I know how."
    h "{i}但我想让你们知道，我现在只想用我唯一知道的方式，来修补这破碎的一切。"

# game/ch1ep4.rpy:46
translate chinese ch1ep4_7b42e4ac:

    # h "{i}This is not a plea for absolution, nor do I write this seeking redemption in your eyes."
    h "{i}我无意寻求赦免，写这封信也不是为了得到你们的原谅。"

# game/ch1ep4.rpy:47
translate chinese ch1ep4_5f28b960:

    # h "{i}Rather, it is an acknowledgment of the web I have woven, and a step towards untangling it, if such a thing is still possible."
    h "{i}相反，这是对我织出的罪恶之网的承认，并且如果还有机会的话，是毁掉这张网的第一步。"

# game/ch1ep4.rpy:48
translate chinese ch1ep4_ca900e06:

    # h "{i}Now, on the less formal part..."
    h "{i}接下来，就到语气不用那么正式的部分……"

# game/ch1ep4.rpy:49
translate chinese ch1ep4_22d63815:

    # h "{i}About Jovian... I've got some information that could help."
    h "{i}乔维安这边……我找到了一些有用的情报。"

# game/ch1ep4.rpy:50
translate chinese ch1ep4_f1abb8d1:

    # h "{i}I believe I have mentiond that I conducted a search in hopes of finding him, and the last solid lead I had was the old Winters' place, out of town."
    h "{i}我应该提到过，我组织过对他的搜寻，其中找到的最后一条有价值的线索指向城外的老温特斯家。"

# game/ch1ep4.rpy:51
translate chinese ch1ep4_7f066e3a:

    # h "{i}Someone among you knows exactly where that place is."
    h "{i}你们之中有人很清楚那个地方在哪。"

# game/ch1ep4.rpy:52
translate chinese ch1ep4_d5a3ca7c:

    # h "{i}After that, nothing. He might as well have disappeared off the face of the earth. If you're clueless about his vanishing, I get it."
    h "{i}除此之外就没有其他的了。他简直就像从地球上消失了一样。如果你们完全不知道他已经失踪这事，我也理解。"

# game/ch1ep4.rpy:53
translate chinese ch1ep4_4ed52ff1:

    # h "{i}My hands were and are still tied. I didn't have the reach or power to dig deeper."
    h "{i}从过去开始，我能做的事就不多，现在依然如此。我没有足够的能力深入调查。"

# game/ch1ep4.rpy:54
translate chinese ch1ep4_d6d6179a:

    # h "{i}Bonheur has taken a big chunk of the Mafia's power and resources. He's got more pull than I do."
    h "{i}博纳尔已经抢走了黑手党内大部分的权力和资源。他说话比我更有分量。"

# game/ch1ep4.rpy:55
translate chinese ch1ep4_fbf9fc7c:

    # h "{i}What he's planning with that kind of power, I can't say. But him having control over half of the Mafia means trouble for me. For everyone entangled in this mess."
    h "{i}他想用这些权力做什么，我不知道。但已经控制了大半黑手党的他就是我的眼中钉。"

# game/ch1ep4.rpy:56
translate chinese ch1ep4_ede33bdd:

    # h "{i}Lastly, I'm asking something big of you, Aine. I know it might be too much."
    h "{i}最后，我对你有个很大的请求，艾妮。我知道这事可能会很过分。"

# game/ch1ep4.rpy:57
translate chinese ch1ep4_02485c91:

    # h "{i}I'm hoping you'll consider taking my place in the Mafia as soon as possible. Not to keep things the same, but to change them for the better."
    h "{i}我希望你能考虑一下，尽快接替我在黑手党里的位置。不是为了保持原样，而是为了做出改变。"

# game/ch1ep4.rpy:58
translate chinese ch1ep4_073f4b75:

    # h "{i}You may not know, but there are people in the group that are looking into its brighter future. Those people need someone to hold them together."
    h "{i}你可能不知道，组织里还是有人盼望着光明的未来。那些人需要一个能把他们凝聚在一起的领袖。"

# game/ch1ep4.rpy:59
translate chinese ch1ep4_11d2f06a:

    # h "{i}Use this to your advantage. Or whatever you decide for it, is all up to you two. I will not stop you."
    h "{i}就用这一点给你们创造优势。或者随你们两个的意，怎样都行。我不会阻止你们。"

# game/ch1ep4.rpy:60
translate chinese ch1ep4_1deb2f5b:

    # h "{i}Although, I suggest..."
    h "{i}不过，我想说……"

# game/ch1ep4.rpy:61
translate chinese ch1ep4_dc502070:

    # h "{i}Why don't you two get married already? What are you waiting for, Christmas?"
    h "{i}你们两个怎么还没结婚？要等到什么时候，圣诞节吗？"

# game/ch1ep4.rpy:62
translate chinese ch1ep4_5c2420dc:

    # h "{i}Yes, I know what you have been planning. Jess is behind you and I was informed before writing this letter."
    h "{i}我知道你们在计划什么。是婕斯在背后给你们出谋划策，她在我写这封信之前就已经全告诉我了。"

# game/ch1ep4.rpy:63
translate chinese ch1ep4_fac26ab4:

    # h "{i}[mc] has shown he's strong enough for this. With you two, I believe you can make things better."
    h "{i}[mc!t]的表现已经证明他足够坚强。有你们两个在，我相信你们能让情况变得更好。"

# game/ch1ep4.rpy:64
translate chinese ch1ep4_dc83ed48:

    # h "{i}I've been a problem for you both. So, on [mc]'s advice, I'm stepping back. This way, you can move forward without me in the way."
    h "{i}我一直让你们两个头疼。所以，应[mc!t]的建议，我不再插手。这样你们就能在没有我的情况下大步前进。"

# game/ch1ep4.rpy:65
translate chinese ch1ep4_c4ffe9db:

    # h "{i}I never planned to get you involved like this, but now I see the mess I've made. I'm ready to give up everything if it means you can have the life you deserve."
    h "{i}我从没想过让你们这样子卷进来，但现实是我把情况搞得一团糟。如果能让你们过上你们应得的生活，我情愿放弃一切。"

# game/ch1ep4.rpy:66
translate chinese ch1ep4_f4c27bee:

    # h "{i}Use what I leave behind to start something new. It's your turn now, not mine."
    h "{i}用我留下的东西开创全新的未来吧。现在是你们的回合了。"

# game/ch1ep4.rpy:67
translate chinese ch1ep4_e06888c2:

    # h "{i}To my daughters, you mean everything to me. Despite all the mess, my love for you hasn't changed."
    h "{i}我的两个女儿，你们是我的一切。尽管现状已是一团乱麻，我对你们的爱丝毫没有改变。"

# game/ch1ep4.rpy:68
translate chinese ch1ep4_638f2f00:

    # h "{i}I hope you can find it in your hearts to move past the chaos I've caused. Be happy."
    h "{i}我希望你们能找到跨越我引起的这么多混乱的力量。要过得开心。"

# game/ch1ep4.rpy:69
translate chinese ch1ep4_10513a59:

    # h "{i}With love, Hera."
    h "{i}爱你们的，赫拉。"

# game/ch1ep4.rpy:73
translate chinese ch1ep4_e612037c_1:

    # m "..."
    m "……"

# game/ch1ep4.rpy:75
translate chinese ch1ep4_d33f3328:

    # m "{i}Yet again, everyone around me is in pain..."
    m "{i}我周围的人，又陷入了痛苦……"

# game/ch1ep4.rpy:76
translate chinese ch1ep4_94339bd8:

    # m "{i}Why...?"
    m "{i}为什么……？"

# game/ch1ep4.rpy:77
translate chinese ch1ep4_704badb8:

    # m "{i}Why does this... remind me of the past...?"
    m "{i}为什么这让我……想起了过去……？"

# game/ch1ep4.rpy:81
translate chinese ch1ep4_d332f83f:

    # fi "{size=-15}Four!"
    fi "{size=-15}四号！"

# game/ch1ep4.rpy:82
translate chinese ch1ep4_40c8ebb1:

    # fi "{size=-9}Four! Are you alright there, buddy?!"
    fi "{size=-9}四号！你没事吧？！"

# game/ch1ep4.rpy:83
translate chinese ch1ep4_e0ade14b:

    # m "H...huh?"
    m "什……什么？"

# game/ch1ep4.rpy:84
translate chinese ch1ep4_4c9ff92b:

    # fi "Are you alright?!"
    fi "你没事吧？！"

# game/ch1ep4.rpy:86
translate chinese ch1ep4_ee2bfff9:

    # si "Fuck, they really brought the calvary on us this time, that RPG almost took us out if it wasn't for your reflexes Five."
    si "操，他们真是倾巢出动了！要不是五号你反应快，那发RPG就把我们全轰上天了！"

# game/ch1ep4.rpy:87
translate chinese ch1ep4_34765e5e:

    # eg "Way too close... Is Four alright?"
    eg "太险了……四号没事吧？"

# game/ch1ep4.rpy:88
translate chinese ch1ep4_1ff06ab1:

    # si "Eight! Targets 3 o'clock! They are trying to flank us!"
    si "八号！三点钟方向有敌人！他们想包抄我们！"

# game/ch1ep4.rpy:90
translate chinese ch1ep4_dac83fc8:

    # fi "Four?"
    fi "四号？"

# game/ch1ep4.rpy:92
translate chinese ch1ep4_9132b5b2:

    # m "I am fine. Nothing to worry about."
    m "我没事。不用担心。"

# game/ch1ep4.rpy:93
translate chinese ch1ep4_0d0ed23d:

    # si "Five bring yourself here! We need support, NOW!"
    si "五号，过来！我们需要支援！"

# game/ch1ep4.rpy:94
translate chinese ch1ep4_39aed1af:

    # m "Maybe I can..."
    m "说不定我可以……"

# game/ch1ep4.rpy:95
translate chinese ch1ep4_ff790aae:

    # fi "Negative, I need you to do something first."
    fi "不行，我有事要拜托你。"

# game/ch1ep4.rpy:96
translate chinese ch1ep4_58cdfb23:

    # fi "Listen, we won't be able to hold them off forever, I need you to call for evac first while we return fire. Give them our coordinates."
    fi "听着，我们不可能一直挡住他们的，你趁我们还能守住，快去请求撤离。把我们的坐标告诉他们。"

# game/ch1ep4.rpy:97
translate chinese ch1ep4_59ee1967:

    # eg "Five! It's getting a bit crowded here!"
    eg "五号！敌人越来越多了！"

# game/ch1ep4.rpy:98
translate chinese ch1ep4_5a09d5e2:

    # fi "Got it?"
    fi "明白了吗？"

# game/ch1ep4.rpy:99
translate chinese ch1ep4_c8cc7f1f:

    # m "Got it."
    m "明白。"

# game/ch1ep4.rpy:102
translate chinese ch1ep4_ba2ef307:

    # m "Command, this is Replace Element, callsign Four, how copy? Over."
    m "总部，这里是敢死队，我是四号，收到请回答，完毕。"

# game/ch1ep4.rpy:103
translate chinese ch1ep4_59755946:

    # comms "Four, this is HQ, comms are five by five. Report status, over."
    comms "四号，这里是总部，通讯良好。汇报情况，完毕。"

# game/ch1ep4.rpy:104
translate chinese ch1ep4_ff1138f8:

    # m "Encountering heavy enemy engagement, surprise assault compromising our perimeter. Risk of encirclement imminent, over."
    m "遭遇大批敌军偷袭，防线快被攻破。有被包围的风险，完毕。"

# game/ch1ep4.rpy:105
translate chinese ch1ep4_7b906d73:

    # m "Request immediate extraction to avoid entrapment. Awaiting instructions, over."
    m "请求立即撤离，避免被围攻。等待命令，完毕。"

# game/ch1ep4.rpy:106
translate chinese ch1ep4_1dc59cc8:

    # comms "... Running request to command, hold the line. over."
    comms "……正在请求上级，不要挂断。完毕。"

# game/ch1ep4.rpy:110
translate chinese ch1ep4_eec6710e:

    # comms "Four, this is HQ, are you still here, over?"
    comms "四号，这里是总部，还能收到吗，完毕。"

# game/ch1ep4.rpy:111
translate chinese ch1ep4_eeb3e06f:

    # m "Solid copy, still here. Was request for exfil granted, over?"
    m "非常清楚，我们还在。撤离请求批准了吗，完毕。"

# game/ch1ep4.rpy:112
translate chinese ch1ep4_ec82af88:

    # comms "... Confirm completion of primary directives, over?"
    comms "……确认主要目标已完成了吗，完毕。"

# game/ch1ep4.rpy:113
translate chinese ch1ep4_b6b7d94e:

    # m "Affirmative HQ. HVT neutralized, sensitive materials destroyed, over."
    m "确认，总部。高价值目标已消灭，敏感资料已销毁，完毕。"

# game/ch1ep4.rpy:114
translate chinese ch1ep4_41ce98d2:

    # comms "Excellent. Request for exfil granted, relay your current grid, over."
    comms "很好。批准撤离，汇报当前坐标，完毕。"

# game/ch1ep4.rpy:115
translate chinese ch1ep4_a8e01e18:

    # m "Current grid is Point Kilo One-Two, how copy? Over."
    m "现在的坐标是K12，收到了吗？完毕。"

# game/ch1ep4.rpy:116
translate chinese ch1ep4_2a6fed50:

    # comms "Solid copy, Four. Extraction bird's inbound, ETA five mikes. Maintain position and prepare for immediate exfil. Out."
    comms "收到，四号。撤离飞机已经起飞，预计5分钟内抵达。原地坚守，准备立即撤离。完毕。"

# game/ch1ep4.rpy:119
translate chinese ch1ep4_0e31c3b3:

    # eg "Took you long enough, what did command say?"
    eg "终于来了，总部怎么说？"

# game/ch1ep4.rpy:120
translate chinese ch1ep4_38816535:

    # m "They asked us if we completed the mission, then agreed to extract us. Helo is coming in 5."
    m "先是问了任务完成了没有，然后同意让我们撤离了。直升机五分钟就到。"

# game/ch1ep4.rpy:121
translate chinese ch1ep4_0d2f2359:

    # si "Typical. If we hadn't, they would have left us to rot here, I am sure of it."
    si "真经典。如果任务没完成，我们的尸体肯定就要烂在这个地方了。"

# game/ch1ep4.rpy:122
translate chinese ch1ep4_4ea0319d:

    # fi "Does it really matter now Six? What matters is that we did it and we are all getting out of here in 5 minutes, we just need to hold on a bit longer."
    fi "现在这些还重要吗，六号？重要的是我们完成了任务，5分钟之后就可以一起离开了。我们只要再坚持一小会儿就行。"

# game/ch1ep4.rpy:123
translate chinese ch1ep4_acf08c08:

    # eg "You Odd Numbers are always so optimistic, so forgiving. If not, Seven would still be here."
    eg "你们奇数真是一直这么乐观，这么大度。七号就是这么死的。"

# game/ch1ep4.rpy:124
translate chinese ch1ep4_bc6df3c9:

    # fi "Ack, I'm not having this discussion with you again, Eight. We decided to move past it."
    fi "唉，我不想再跟你说这些，八号。已经说好了不再提的。"

# game/ch1ep4.rpy:125
translate chinese ch1ep4_09f9fb56:

    # si "That's enough! Let's just get this done, okay?"
    si "够了！我们赶紧完事儿，好吗？"

# game/ch1ep4.rpy:126
translate chinese ch1ep4_cf102d3e:

    # fi "Everyone focus! We are all going home together, you hear me?"
    fi "大家都集中精神！我们一起回家，听见没有？"

# game/ch1ep4.rpy:127
translate chinese ch1ep4_9bd0b1f8:

    # eg "Far easier said than done, man! but I ain't ready to die here! Let's do it!"
    eg "说得轻巧，哥们！不过我也不想死在这！干就完了！"

# game/ch1ep4.rpy:128
translate chinese ch1ep4_fa91dd26:

    # fi "That's more like it Eight."
    fi "这才像话，八号。"

# game/ch1ep4.rpy:129
translate chinese ch1ep4_e21c21ed:

    # fi "Four, while you were gone, some managed to sneak out on our right flank. They are probably going through the ruined buildings trying to surprise us."
    fi "四号，你晕过去的时候，有几个人偷偷绕到了我们的右翼。他们可能想穿过那边的废墟，给我们来个惊喜。"

# game/ch1ep4.rpy:130
translate chinese ch1ep4_d22e8342:

    # fi "Mind giving them a warm welcome?"
    fi "要不去热烈欢迎一下他们？"

# game/ch1ep4.rpy:131
translate chinese ch1ep4_9d23bd43:

    # m "Sure."
    m "好啊。"

# game/ch1ep4.rpy:132
translate chinese ch1ep4_c0f5977f:

    # si "Atta girl, don't be late, though!"
    si "真是我的好姑娘，不过你可别迟到！"

# game/ch1ep4.rpy:133
translate chinese ch1ep4_7bcbabd0:

    # m "*nods*"
    m "*点头*"

# game/ch1ep4.rpy:134
translate chinese ch1ep4_0e821f75:

    # sol1 "Gunshots are getting louder. We are getting there, those insects won't even know what hit them."
    sol1 "枪声越来越响了。我们离得很近了，那些害虫待会肯定会连被谁打了都弄不清楚。"

# game/ch1ep4.rpy:135
translate chinese ch1ep4_17637093:

    # sol2 "I don't know, man. I have a bad feeling about this. It's only four of them but they managed to take out tens of us."
    sol2 "不好说啊，兄弟。我有不好的预感。他们才四个人，却干掉了我们几十个人。"

# game/ch1ep4.rpy:136
translate chinese ch1ep4_b02ab52b:

    # sol3 "They even got Jernandez, and god knows how tough that dude was."
    sol3 "连吉尔南德兹都挂了，他可是厉害得很。"

# game/ch1ep4.rpy:137
translate chinese ch1ep4_1e3667ac:

    # sol1 "Exactly why we will make sure those whores pay for what they did."
    sol1 "所以我们才要让那群臭婊子付出代价。"

# game/ch1ep4.rpy:138
translate chinese ch1ep4_5dc40f50:

    # sol2 "*laughs* dibs on the least blown up one."
    sol2 "*大笑* 完事之后，尸体最完整的小妞归我。"

# game/ch1ep4.rpy:139
translate chinese ch1ep4_fc736a5a:

    # sol2 "What about you Ray?"
    sol2 "你呢，雷？"

# game/ch1ep4.rpy:140
translate chinese ch1ep4_65c53c48:

    # sol3 "Honestly, I just wanna..."
    sol3 "说实话，我只想……"

# game/ch1ep4.rpy:142
translate chinese ch1ep4_a097a84b:

    # sol1 "Shit! it's one of th-"
    sol1 "操！那不是——"

# game/ch1ep4.rpy:146
translate chinese ch1ep4_57880a46:

    # m "Amen..."
    m "阿门……"

# game/ch1ep4.rpy:148
translate chinese ch1ep4_01a7f863:

    # eg "I'm black on ammo!"
    eg "我子弹打光了！"

# game/ch1ep4.rpy:149
translate chinese ch1ep4_c3f2d27c:

    # si "Same, last mag here."
    si "我也是，最后一个弹匣了。"

# game/ch1ep4.rpy:150
translate chinese ch1ep4_c1563edf:

    # fi "Don't give in! Use your sidearm if you have too!"
    fi "别放弃！要是有手枪就用手枪！"

# game/ch1ep4.rpy:151
translate chinese ch1ep4_5cdac9e8:

    # si "Hey, Four's back!"
    si "喂，四号回来了！"

# game/ch1ep4.rpy:152
translate chinese ch1ep4_0d3117d7:

    # eg "Perfect timing, give us a hand Four!"
    eg "来得正好，快来帮忙，四号！"

# game/ch1ep4.rpy:154
translate chinese ch1ep4_c082a5a7:

    # m "Six, throw a flashbang."
    m "六号，扔闪光弹。"

# game/ch1ep4.rpy:155
translate chinese ch1ep4_6d7b746f:

    # si "Copy that, it's my last one."
    si "明白，最后一个了。"

# game/ch1ep4.rpy:157
translate chinese ch1ep4_64e71adc:

    # si "Flash out! Look away!"
    si "丢闪光弹了！小心！"

# game/ch1ep4.rpy:162
translate chinese ch1ep4_06b2f470:

    # pil "To any Replace Element, this is Silverbird 1, we have arrived."
    pil "敢死队，这里是银鸟一号，我们到了。"

# game/ch1ep4.rpy:163
translate chinese ch1ep4_ee867a34:

    # pil "LZ is hot, I repeat LZ is hot. Get in immediately, we are leaving in 1 mikes, out."
    pil "降落区有敌人，重复，降落区有敌人。立马过来，我们1分钟之后就走。完毕。"

# game/ch1ep4.rpy:164
translate chinese ch1ep4_30150bb0:

    # fi "Let's go everyone, pop smokes to cover our retreat."
    fi "大家快走，扔烟雾弹掩护撤退。"

# game/ch1ep4.rpy:165
translate chinese ch1ep4_9b71772f:

    # eg "Copy! Smokes out!"
    eg "明白！烟雾弹！"

# game/ch1ep4.rpy:171
translate chinese ch1ep4_24e723d0:

    # m "RPG!"
    m "RPG！"

# game/ch1ep4.rpy:176
translate chinese ch1ep4_fcb79239:

    # si "NO! FIVE!"
    si "不！五号！"

# game/ch1ep4.rpy:177
translate chinese ch1ep4_2faaf017:

    # eg "SHIT!"
    eg "妈的！"

# game/ch1ep4.rpy:179
translate chinese ch1ep4_3256963d:

    # eg "Moon! Grab Five and get into the helo already!"
    eg "月！快拉上五号上直升机！"

# game/ch1ep4.rpy:180
translate chinese ch1ep4_5930a395:

    # m "Y-Yes!"
    m "好-好的！"

# game/ch1ep4.rpy:182
translate chinese ch1ep4_d23990cd:

    # m "It's gonna be okay Five, just a bit further, we are almost there."
    m "没事的五号，最后一段路了，马上就到了。"

# game/ch1ep4.rpy:184
translate chinese ch1ep4_0c4b74f8:

    # eg "We are all here! Go, go, go!"
    eg "我们都上来了！快走，快走！"

# game/ch1ep4.rpy:185
translate chinese ch1ep4_8e40fd96:

    # pil "Solid copy. All elements on board. Silverbird 1's departing. RTB."
    pil "明白。所有队员已登记。银鸟一号起飞。返回基地。"

# game/ch1ep4.rpy:187
translate chinese ch1ep4_372596d7:

    # si "Five it's okay, we are in the helo, we are going home!"
    si "五号，没事了，我们在直升机上了，马上回家！"

# game/ch1ep4.rpy:189
translate chinese ch1ep4_49e8f14e:

    # si "No, no, no! Don't you dare Five! You can't leave us like that! You can't leave me!"
    si "不，不，不！你不准死，五号！不要离开我们！不要离开我！"

# game/ch1ep4.rpy:192
translate chinese ch1ep4_75075349:

    # eg "Six, he's..."
    eg "六号，他……"

# game/ch1ep4.rpy:193
translate chinese ch1ep4_962d8d31:

    # si "NO! He's gonna be okay, you will see!"
    si "胡说！他没事的，你等着瞧吧！"

# game/ch1ep4.rpy:194
translate chinese ch1ep4_33a1cf98:

    # eg "Six! He's dead, man! It's over!"
    eg "六号！他死了！死了！"

# game/ch1ep4.rpy:195
translate chinese ch1ep4_3b67f44c:

    # si "*sniffs* You said... we would all go home together..."
    si "*抽泣* 你明明说……我们会一起回家的……"

# game/ch1ep4.rpy:202
translate chinese ch1ep4_612d07af:

    # mc "{size=-10}Moon."
    mc "{size=10}月。"

# game/ch1ep4.rpy:203
translate chinese ch1ep4_707e85d0:

    # mc "Moon!"
    mc "月！"

# game/ch1ep4.rpy:204
translate chinese ch1ep4_988a5f3d:

    # m "Hm? Huh?"
    m "嗯？怎么了？"

# game/ch1ep4.rpy:205
translate chinese ch1ep4_835663be:

    # mc "Everything alright? You've been zoned out there for a bit."
    mc "你没事吧？你发呆发了好久。"

# game/ch1ep4.rpy:206
translate chinese ch1ep4_c748506f:

    # m "Ah, yeah, I'm fine, just lost in thought for a moment."
    m "啊，没事，没事，就是在想别的事情。"

# game/ch1ep4.rpy:208
translate chinese ch1ep4_6b070586:

    # a "Hold up, are you guys actually coordinating this somehow?"
    a "等一下，你们难道一直有在互相通气吗？"

# game/ch1ep4.rpy:209
translate chinese ch1ep4_06ae5a08:

    # a "Why does everything seem like it's unfolding exactly as you planned?"
    a "怎么一切都跟你计划好了一样？"

# game/ch1ep4.rpy:210
translate chinese ch1ep4_509fb7e1:

    # mc "No direct communication, but Hera's silence was a giveaway. It hinted she was concealing something crucial, something she couldn't share."
    mc "没有直接交流，但赫拉的沉默就是线索。这代表她在隐瞒很重要的事，这事她绝对不能告诉别人。"

# game/ch1ep4.rpy:211
translate chinese ch1ep4_f3459c52:

    # mc "That led me to believe there's more to her past actions than meets the eye."
    mc "我由此推断她过去的行为背后有更多隐情。"

# game/ch1ep4.rpy:212
translate chinese ch1ep4_16c2031a:

    # mc "I've been anticipating this moment. She really took her sweet time."
    mc "我一直在等这一刻。真是花了她够久的。"

# game/ch1ep4.rpy:213
translate chinese ch1ep4_7a572749:

    # mc "Raiding her safe house? If I wanted revenge, I had bigger plans than that."
    mc "去她的安全屋里闹一场算得上什么？我真想报仇的话，就不会只是那样了。"

# game/ch1ep4.rpy:214
translate chinese ch1ep4_bac1f30a:

    # mc "Checking off this part of our plan. With her backed into a corner, I knew she'd eventually spill the beans."
    mc "计划的这一部分完成了。只要把她逼到墙角，我就知道她总有一天会说实话。"

# game/ch1ep4.rpy:215
translate chinese ch1ep4_e612037c_2:

    # m "..."
    m "……"

# game/ch1ep4.rpy:216
translate chinese ch1ep4_88cf9e77:

    # a "I see... Now that I think of it, it makes sense..."
    a "原来如此……现在想想，的确都说得通了……"

# game/ch1ep4.rpy:217
translate chinese ch1ep4_e409ba92:

    # a "Having her power cut doesn't make her totally powerless. She could've done so much more either..."
    a "她的权力只是被削弱了，并非完全无能为力。她本可以做到更多事的……"

# game/ch1ep4.rpy:218
translate chinese ch1ep4_a2dd29b0:

    # mc "Moving on to our next move."
    mc "该进行下一步行动了。"

# game/ch1ep4.rpy:219
translate chinese ch1ep4_e42b4045:

    # mc "Em?"
    mc "小艾？"

# game/ch1ep4.rpy:220
translate chinese ch1ep4_ed6d9e8c:

    # e "Mhm. It's about time you revisit your roots, Aine."
    e "嗯。该回你的根看看了，艾妮。"

# game/ch1ep4.rpy:221
translate chinese ch1ep4_bb8e4b4e:

    # a "..."
    a "……"

# game/ch1ep4.rpy:222
translate chinese ch1ep4_75003d95:

    # mc "Think you're up for it?"
    mc "你能行吗？"

# game/ch1ep4.rpy:223
translate chinese ch1ep4_f9b81ad2:

    # a "I'm the least of your worries, [mc]. The real question is, are you prepared? What's your plan from here?"
    a "我是最不需要你担心的，[mc!t]。真正的问题是，你准备好了吗？你之后的计划是什么？"

# game/ch1ep4.rpy:224
translate chinese ch1ep4_a5710021:

    # mc "More ready than ever. Nothing but to push forward and track down my [landlord], for real this time."
    mc "完全准备好了。一定要大举前进，找到我[landlord!t]。"

# game/ch1ep4.rpy:225
translate chinese ch1ep4_7a148161:

    # shu "Who's joining the expedition? Need any help? Just say the word."
    shu "都有谁参加这次行动？需要帮忙吗？尽管开口。"

# game/ch1ep4.rpy:226
translate chinese ch1ep4_88af5235:

    # mc "Definitely need you on board, buddy. Especially since I'm not sure how long this will take."
    mc "绝对需要你帮忙，兄弟。特别是我也不好说这一趟要花多久。"

# game/ch1ep4.rpy:227
translate chinese ch1ep4_bb67aa0f:

    # mc "Given your connections, reach out to Jess. Ask her to arrange someone to watch over everyone here. ASAP."
    mc "正好你可以联系上婕斯。请让她安排人来照料留下来的人。"

# game/ch1ep4.rpy:228
translate chinese ch1ep4_79142d09:

    # shu "You got it, boss!"
    shu "明白，老大！"

# game/ch1ep4.rpy:229
translate chinese ch1ep4_42c65e19:

    # mc "As for the team-"
    mc "至于和我——"

# game/ch1ep4.rpy:230
translate chinese ch1ep4_2176e359:

    # k "Count me in."
    k "我要去。"

# game/ch1ep4.rpy:231
translate chinese ch1ep4_a4b881b0:

    # k "Emma, how long will it take for you to obtain a search warrant?"
    k "艾玛，你要花多久才能拿到搜查令？"

# game/ch1ep4.rpy:232
translate chinese ch1ep4_6d2eb9c3:

    # e "Thankfully, this case has been written for a while already. If I have the information I need, I can have it ready by tomorrow."
    e "好消息是这个案子立案的时间不短了。只要有所有必要的信息，明天就能拿到搜查令。"

# game/ch1ep4.rpy:233
translate chinese ch1ep4_8cb18201:

    # k "Good. After this, come to my room. I have a few things to discuss with you."
    k "很好。待会来我的房间。我有事要和你商量。"

# game/ch1ep4.rpy:234
translate chinese ch1ep4_862916c6:

    # mc "[landlady], you sure about this?"
    mc "[landlady!t]，你确定吗？"

# game/ch1ep4.rpy:235
translate chinese ch1ep4_77b3ebc5:

    # k "No question, [mc]. I've been on the sidelines too long. It's about time I step up."
    k "不用问了，[mc!t]。我已经在台下看了太久。是时候上台了。"

# game/ch1ep4.rpy:236
translate chinese ch1ep4_f6e2d8e9:

    # k "Needless to say, I'm the only one who knows where that place is."
    k "更不用说，只有我一个人知道那个地方在哪。"

# game/ch1ep4.rpy:237
translate chinese ch1ep4_eb0e63e4:

    # mc "I see... She did mention one of us knows the location. So it's you."
    mc "这样啊……她的确说了我们之中有一个人知道位置。原来是你。"

# game/ch1ep4.rpy:238
translate chinese ch1ep4_14172351:

    # k "Yes. It's where your [landlord] and I temporarily stayed long ago."
    k "是的。我和你[landlord!t]很久之前在那里暂时住过。"

# game/ch1ep4.rpy:239
translate chinese ch1ep4_30a68951:

    # k "You said I'd lay low, but when it comes to Jovian, I can't sit this out. If he's out there, I want first dibs to land a palm on his face."
    k "你说要让我保持低调，可是对于和乔维安有关的事，我没法袖手旁观。我要第一个给他一耳光。"

# game/ch1ep4.rpy:240
translate chinese ch1ep4_24b25b0f:

    # mc "*sighs*"
    mc "*叹气*"

# game/ch1ep4.rpy:241
translate chinese ch1ep4_48981a50:

    # mc "I doubt a confrontation will solve everything, but I'll make sure you'll get that chance."
    mc "我觉得当面对质估计没法解决一切，不过我会给你机会的。"

# game/ch1ep4.rpy:242
translate chinese ch1ep4_b3c1b400:

    # mc "And for the others, I think it's pretty clear."
    mc "至于其他人，应该都很清楚了。"

# game/ch1ep4.rpy:243
translate chinese ch1ep4_6c0efa87:

    # mc "Moon..."
    mc "月……"

# game/ch1ep4.rpy:244
translate chinese ch1ep4_a6140599:

    # mc "And Emma..."
    mc "还有艾玛……"

# game/ch1ep4.rpy:245
translate chinese ch1ep4_fdeb3891:

    # mc "You're with me."
    mc "你们两个跟我一起。"

# game/ch1ep4.rpy:246
translate chinese ch1ep4_2e8a5fe0:

    # e "Of course."
    e "没问题。"

# game/ch1ep4.rpy:247
translate chinese ch1ep4_4ffde15b:

    # m "Absolutely."
    m "遵命。"

# game/ch1ep4.rpy:248
translate chinese ch1ep4_d2698f38:

    # mc "For the others, Gwen, Aine, I'll leave you in charge for the time being."
    mc "剩下的人，格温，艾妮，就交给你们了。"

# game/ch1ep4.rpy:249
translate chinese ch1ep4_c8a25f9e:

    # g "You got it."
    g "没问题。"

# game/ch1ep4.rpy:250
translate chinese ch1ep4_ded586b0:

    # mc "Alright, we should head out-"
    mc "好了，我们出去——"

# game/ch1ep4.rpy:251
translate chinese ch1ep4_78a76a52:

    # m "Wait, [mc]."
    m "等等，[mc!t]。"

# game/ch1ep4.rpy:252
translate chinese ch1ep4_cb4bb921:

    # mc "Moon?"
    mc "月？"

# game/ch1ep4.rpy:253
translate chinese ch1ep4_b5d0cfe3:

    # m "I think we should wait until tomorrow to head out, no? We all need a good night's rest."
    m "我觉得我们还是等到明天再出发吧？大家都需要好好休息一晚上。"

# game/ch1ep4.rpy:254
translate chinese ch1ep4_19416240:

    # mc "... You read my mind or something?"
    mc "……你是能读我的心吗？"

# game/ch1ep4.rpy:255
translate chinese ch1ep4_3b2d65f5:

    # m "Not exactly. But I know we've all been preparing up for this. However, facing what's ahead requires us at our best, and that means being well-rested."
    m "算不上。但是我知道我们都在为了这事做准备。可是，那就代表我们要用最好的状态迎接挑战，也就是必须好好休息。"

# game/ch1ep4.rpy:256
translate chinese ch1ep4_2485f494:

    # mc "I..."
    mc "我……"

# game/ch1ep4.rpy:257
translate chinese ch1ep4_8452cdf9:

    # mc "... Yeah, you're right. It's been a long day for everyone."
    mc "……是啊，你说得对。大家今天都累了。"

# game/ch1ep4.rpy:258
translate chinese ch1ep4_864084d0:

    # m "Exactly. Let's give ourselves the best chance by starting fresh tomorrow. We've waited this long; one more night won't hurt."
    m "没错。我们明天用最好的面貌出击。已经等了很久；再多一晚上也不算什么。"

# game/ch1ep4.rpy:259
translate chinese ch1ep4_df4cb502:

    # mc "Thanks, Moon."
    mc "谢谢，月。"

# game/ch1ep4.rpy:260
translate chinese ch1ep4_7762b16d:

    # mc "Okay, everyone, let's rest up. Tomorrow, we move."
    mc "好了，各位，去休息吧。明天，我们行动。"

# game/ch1ep4.rpy:261
translate chinese ch1ep4_e1554201:

    # s "..."
    s "……"

# game/ch1ep4.rpy:269
translate chinese ch1ep4_07184dcf:

    # mc "Ah, fuck... I can't sleep..."
    mc "啊，操……睡不着啊……"

# game/ch1ep4.rpy:270
translate chinese ch1ep4_d99f856b:

    # mc "What time is it?"
    mc "几点了？"

# game/ch1ep4.rpy:271
translate chinese ch1ep4_2b35b6fe_3:

    # mc "..."
    mc "……"

# game/ch1ep4.rpy:272
translate chinese ch1ep4_0dba505e:

    # mc "Man... already midnight."
    mc "唉……都半夜了。"

# game/ch1ep4.rpy:273
translate chinese ch1ep4_9e54df66:

    # mc "I told myself I was ready, but the pressure is just too much."
    mc "我告诉我自己已经准备好了，但是压力实在太大。"

# game/ch1ep4.rpy:274
