# game/ch1ep4.rpy:5293
translate chinese skystressrelief_4e243e6a:

    # g "It's over now-you did it."
    g "现在都结束了——你成功了。"

# game/ch1ep4.rpy:5370
translate chinese skystressrelief_4a5dfafb:

    # n "Once you've set your sights on somethin', no one's changin' yer mind, huh? That, we both have in common."
    n "你一旦下定了决心，那谁也拦不住你，对吧？这一点，我们两个是一样的。"

# game/ch1ep4.rpy:5382
translate chinese skystressrelief_be3195ba:

    # n "What I'm tryin' t'say is... when you pull through, I'll have a cold one waiting for ya."
    n "我想说的是……等你挺过去之后，我要跟你好好喝一杯。"

# game/ch1ep4.rpy:5453
translate chinese skystressrelief_bb2b0108:

    # m "[mc], I love you..." with Dissolve(1.0)
    m "[mc!t]，我爱你……" with Dissolve(1.0)

# game/ch1ep4.rpy:5782
translate chinese kaitosorareunion_8fd7e032:

    # bo "This Olivia person does not exist." with Dissolve(1.0)
    bo "那个叫奥莉薇娅的人根本不存在。" with Dissolve(1.0)

# game/ch1ep4.rpy:5855
translate chinese kaitosorareunion_a12bf687:

    # m "I will still love you from the bottom of my heart." with Dissolve(1.0)
    m "我都会发自心底地爱你。" with Dissolve(1.0)

# game/ch1ep4.rpy:5897
translate chinese kaitosorareunion_c1dff962:

    # mc "Oh..."
    mc "哦……"

# game/ch1ep4.rpy:5898
translate chinese kaitosorareunion_98d7ad37:

    # mc "Yeah... I forgot about it..."
    mc "是啊……我都忘了……"

# game/ch1ep4.rpy:5911
translate chinese kaitosorareunion_3adcf9e5:

    # shu "And we're staying there, not just for one day, but for several days!"
    shu "而且我们可不是只在那里待一天，要住上好几天才走！"

# game/ch1ep4.rpy:6005
translate chinese kaitosorareunion_6ddeef6a:

    # nee "{b}My Bully is My Lover{/b} will soon continue with Chapter 2, its final chapter.\n{i}(Will contain an estimate of 6-7 Episodes){/i}"
    nee "{b}《我的爱人是霸凌女》{/b}的故事很快就会在第二章，也是最后一个章节里继续！\n{i}（这一章大概会有6到7次更新）{/i}"

