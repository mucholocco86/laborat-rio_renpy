    # m "So, am I hired?"
    m "所以，我合格了没？"

# game/ch1ep4.rpy:1671
translate chinese skystressrelief_5b5d2239:

    # kai "*coughing* Yeah, I think you're good enough..."
    kai "*咳嗽* 嗯，我觉得你没问题……"

# game/ch1ep4.rpy:1672
translate chinese skystressrelief_104e9bdf:

    # m "Thank-"
    m "谢——"

# game/ch1ep4.rpy:1673
translate chinese skystressrelief_290c1c4c:

    # mill "Hold on!"
    mill "等等！"

# game/ch1ep4.rpy:1674
translate chinese skystressrelief_487a1850_1:

    # m "Hm?"
    m "嗯？"

# game/ch1ep4.rpy:1675
translate chinese skystressrelief_b4bcb652:

    # mill "Hi there, miss. I'm Millie, the gym manager."
    mill "你好，小姐。我是米莉，这家健身房的经理。"

# game/ch1ep4.rpy:1676
translate chinese skystressrelief_504780ac:

    # mill "You're applying for the combat instructor role? Unfortunately, we just filled that position yesterday."
    mill "你是来应聘格斗教练的吗？很抱歉，昨天这个岗位已经招到人了。"

# game/ch1ep4.rpy:1677
translate chinese skystressrelief_ace1b1e5:

    # m "I see... That's disappointing..."
    m "这样啊……真遗憾……"

# game/ch1ep4.rpy:1678
translate chinese skystressrelief_45dcfffe:

    # kai "Filled? But you haven't closed the job advertisement yet!"
    kai "招到人了？但是招聘的广告还没撤下来呢！"

# game/ch1ep4.rpy:1679
translate chinese skystressrelief_cf50eb86:

    # mill "Well... my mistake..."
    mill "这个……是我的疏忽……"

# game/ch1ep4.rpy:1680
translate chinese skystressrelief_c73e3cb3:

    # kai "It was a guy, wasn't it?"
    kai "招了个男的，对吧？"

# game/ch1ep4.rpy:1681
translate chinese skystressrelief_3fc53c20:

    # mill "Yes."
    mill "对。"

# game/ch1ep4.rpy:1682
translate chinese skystressrelief_2944565c:

    # kai "Come on, Millie! She just showed she's more than qualified! Kick him out, I don't like him already! We need more women in here!"
    kai "拜托，米莉！她刚刚已经证明她的能力很强了！让那个男的走人吧，我都已经不喜欢他了！我们这需要更多女性！"

# game/ch1ep4.rpy:1683
translate chinese skystressrelief_daab90bc:

    # mill "*sighs* You know I can't just do that..."
    mill "*叹气* 你也知道我没法那样做……"

# game/ch1ep4.rpy:1684
translate chinese skystressrelief_88b72017:

    # mill "However, the new hire is only on a five-month contract. It's not permanent."
    mill "不过呢，新来的人只签了五个月的合同。不是长期的。"

# game/ch1ep4.rpy:1685
translate chinese skystressrelief_e7d3c6a5:

    # m "So, there's a possibility it'll open up again?"
    m "所以，将来还会再招人？"

# game/ch1ep4.rpy:1686
translate chinese skystressrelief_4d717095:

    # mill "Exactly. And given what I've just seen, I'd be very interested in having you join us then."
    mill "没错。考虑到你刚刚的表现，我非常欢迎你到时加入我们。"

# game/ch1ep4.rpy:1687
translate chinese skystressrelief_bb5d30f6:

    # kai "Seriously, Millie, consider making a switch now! Nikolay, tell her!"
    kai "讲真，米莉，你现在就让她来嘛！尼古莱，你劝劝她！"

# game/ch1ep4.rpy:1688
translate chinese skystressrelief_f61c5d49:

    # nik "Нет."
    nik "Нет."

# game/ch1ep4.rpy:1689
translate chinese skystressrelief_6823905b:

    # mill "Kai, as much as I share your enthusiasm, we need to honor our commitments."
    mill "凯，我跟你一样激动，但我们必须有契约精神才行。"

# game/ch1ep4.rpy:1690
translate chinese skystressrelief_6a9f929e:

    # mill "But... what was your name?"
    mill "你……叫什么名字？"

# game/ch1ep4.rpy:1691
translate chinese skystressrelief_7299dfff:

    # m "Moon. Moon Chi."
    m "月。气月。"

# game/ch1ep4.rpy:1692
translate chinese skystressrelief_bd481db3:

    # mill "Moon, please consider coming back once the position reopens. With your skills, you'd be an excellent addition."
    mill "月，等到岗位再次开放的时候，请你一定考虑再来一次。凭你的本领，一定能表现得很出色的。"

# game/ch1ep4.rpy:1693
translate chinese skystressrelief_e612037c_17:

    # m "..."
    m "……"

# game/ch1ep4.rpy:1694
translate chinese skystressrelief_80680982:

    # m "... Alright, I'll consider it."
    m "……好吧，我会考虑一下的。"

# game/ch1ep4.rpy:1695
translate chinese skystressrelief_794594b4:

    # kai "You're making a mistake, Millie!"
    kai "你会后悔的，米莉！"

# game/ch1ep4.rpy:1696
translate chinese skystressrelief_f2ea2aba:

    # mill "Let it go, Kai. Let's be professional."
    mill "到此为止吧，凯。别跟小孩似的。"

# game/ch1ep4.rpy:1697
translate chinese skystressrelief_1bc5707e:

    # mill "I'll be sure to reach out as soon as there's an opening, Moon. It was a pleasure meeting you. Sorry for any confusion today."
    mill "等到一有机会我就会联系你的，月。很高兴认识你。抱歉给你添麻烦了。"

# game/ch1ep4.rpy:1698
translate chinese skystressrelief_ec931228:

    # m "It's okay."
    m "没事的。"

# game/ch1ep4.rpy:1705
translate chinese skystressrelief_e612037c_18:

    # m "..."
    m "……"

# game/ch1ep4.rpy:1711
translate chinese skystressrelief_5b7fb8b0:

    # m "{b}AOIFEEEEEEEEE!!!"
    m "{b}艾法！！！！！！"

# game/ch1ep4.rpy:1714
translate chinese skystressrelief_51ac0cc0:

    # mc "Frey, are you done yet? Let's hurry! It's getting late!"
    mc "芙蕾，你弄完了没？快点！很晚了！"

# game/ch1ep4.rpy:1715
translate chinese skystressrelief_0243806d:

    # f "Hold your horses! I'm almost ready!"
    f "等一下下！我马上就好！"

# game/ch1ep4.rpy:1718
translate chinese skystressrelief_2b35b6fe_14:

    # mc "..."
    mc "……"

# game/ch1ep4.rpy:1719
translate chinese skystressrelief_ca12c4ce:

    # yt "So, the circus is in town. Just as I predicted..."
    yt "呵，马戏团进城了。如我所料……"

# game/ch1ep4.rpy:1720
translate chinese skystressrelief_bccb4249:

    # yt "And look who's playing ringmaster..."
    yt "再瞧瞧这位领衔小丑……"

# game/ch1ep4.rpy:1721
translate chinese skystressrelief_33b97cf9:

    # yt "Frey, I swear, if you jump out now..."
    yt "芙蕾，拜托，千万别出来……"

# game/ch1ep4.rpy:1722
translate chinese skystressrelief_3ec57d49:

    # f "..."
    f "……"

# game/ch1ep4.rpy:1723
translate chinese skystressrelief_301f3104:

    # f "*gasps*"
    f "*惊讶*"

# game/ch1ep4.rpy:1724
translate chinese skystressrelief_5e2f68fb:

    # mc "Ah, if it isn't Mr. Pretzel-Octopus himself. Can't stay away from me, huh?"
    mc "啊，这不是大名鼎鼎的装逼啥啥斯先生嘛。离了我就活不下去了，是吧？"

# game/ch1ep4.rpy:1725
translate chinese skystressrelief_42ce6dc1:

    # mc "What's the matter? Run out of people to annoy, so you brought your fan club here to impress me?"
    mc "怎么了？身边的人都被你烦跑了，只好带着你的粉丝团来给我表演一下？"

# game/ch1ep4.rpy:1726
translate chinese skystressrelief_d39e1a0b:

    # mc "Really, I'm dying to know—what kind of stick got wedged up your ass this time? What do you want from me now?"
    mc "真的，我非常想知道——你的大黑屁股这次又准备放什么屁？你找我干嘛？"

# game/ch1ep4.rpy:1727
translate chinese skystressrelief_9dc08fdd:

    # fr "Ugh, your sarcasm is like nails on a chalkboard!"
    fr "啧，你的阴阳怪气就跟用指甲挠黑板一样刺耳！"

# game/ch1ep4.rpy:1728
translate chinese skystressrelief_df92d3ca:

    # fr "What do I want? Revenge, my dear simpleton!"
    fr "我想干嘛？我想报仇，我亲爱的傻瓜！"

# game/ch1ep4.rpy:1729
translate chinese skystressrelief_b02a49c7:

    # fr "Did you think I'd forget how you made a fool out of me? I'm here to make you regret it, tenfold!"
    fr "你以为我会忘记你上次羞辱我的事情吗？我要让你后悔，十倍奉还！"

# game/ch1ep4.rpy:1730
translate chinese skystressrelief_d36bd7f0:

    # mc "Oh, look at little Pretzel-O-Pus Junior..."
    mc "噢，亲爱的小装逼啥啥斯啊……"

# game/ch1ep4.rpy:1731
translate chinese skystressrelief_9d752c28:

    # mc "Gonna cry?"
    mc "你急了？"

# game/ch1ep4.rpy:1732
translate chinese skystressrelief_94b1e4ae:

    # fr "Seize him!"
    fr "抓住他！"

# game/ch1ep4.rpy:1733
translate chinese skystressrelief_72e92a40:

    # fr "Ack!"
    fr "啊！"

# game/ch1ep4.rpy:1735
translate chinese skystressrelief_7defc940:

    # fr "M-m-my face! Do you have any idea how much my beauty routine costs?!"
    fr "我-我-我的脸啊！你知道我每天光美容就要花多少钱吗？！"

# game/ch1ep4.rpy:1736
translate chinese skystressrelief_81c06d37:

    # fr "What are you imbeciles waiting for? Get him!"
    fr "你们这群废物还愣着干嘛？抓住他啊！"

# game/ch1ep4.rpy:1737
translate chinese skystressrelief_3d8cb56e:

    # yt "Moon..."
    yt "月……"

# game/ch1ep4.rpy:1738
translate chinese skystressrelief_229744da:

    # yt "... I'm sorry."
    yt "……对不起。"

# game/ch1ep4.rpy:1741
translate chinese skystressrelief_1618dd93:

    # fr "*nervous chuckle*"
    fr "*紧张地笑*"

# game/ch1ep4.rpy:1742
translate chinese skystressrelief_f9070876:

    # fr "HAHAHAHAHA!!"
    fr "哈哈哈哈哈哈！！"

# game/ch1ep4.rpy:1743
translate chinese skystressrelief_d57c1eb4:

    # fr "Let's see if you can crack jokes now, wise guy!"
    fr "看你现在还怎么说笑话，大聪明！"

# game/ch1ep4.rpy:1744
translate chinese skystressrelief_d050b6e4:

    # fr "Drag him in!"
    fr "带上车！"

# game/ch1ep4.rpy:1747
translate chinese skystressrelief_9ad37c3b:

    # f "Did they..."
    f "他们居然……"

# game/ch1ep4.rpy:1748
translate chinese skystressrelief_b0392505:

    # f "No..."
    f "不……"

# game/ch1ep4.rpy:1749
translate chinese skystressrelief_9a0b0ffa:

    # f "No, no, no, NO!"
    f "不，不，不，不！"

# game/ch1ep4.rpy:1754
translate chinese skystressrelief_f046688e:

    # m "Her aim is just as sharp as it was back then. Did she intentionally miss that second shot, or..."
    m "她的枪法还跟以前一样准。她的第二枪是故意打偏的，还是……"

# game/ch1ep4.rpy:1755
translate chinese skystressrelief_0da45f36:

    # m "... What is she plotting now?"
    m "……她在耍什么把戏？"

# game/ch1ep4.rpy:1757
translate chinese skystressrelief_0b4a2d55:

    # m "This feels just like back then."
    m "这感觉就和以前一样。"

# game/ch1ep4.rpy:1758
translate chinese skystressrelief_53bcf893:

    # m "Once she has you in her sights, there's no escaping."
    m "一旦暴露在她的视野里，就无处可逃。"

# game/ch1ep4.rpy:1759
translate chinese skystressrelief_95313564:

    # m "Her only weakness is close combat. I need to find a way to-"
    m "她唯一的弱点就是近身战。我得想办法——"

# game/ch1ep4.rpy:1761
translate chinese skystressrelief_6de27618:

    # m "Ugh!"
    m "啧！"

# game/ch1ep4.rpy:1762
translate chinese skystressrelief_f2d051ed:

    # m "How are you still alive, Aoife? After all these years, why show your face to me now?!"
    m "你怎么还活着，艾法？过了这么多年，为什么现在又来找我？！"

# game/ch1ep4.rpy:1763
translate chinese skystressrelief_3864a381_4:

    # ao "..."
    ao "……"

# game/ch1ep4.rpy:1764
translate chinese skystressrelief_da8bec6f:

    # m "... You're still mouthless, I see. Why did I even bother asking."
    m "……看来你还是不肯张口。我干嘛费事问你呢。"

# game/ch1ep4.rpy:1766
translate chinese skystressrelief_9f4cae7f:

    # m "Tsk!"
    m "啧！"

# game/ch1ep4.rpy:1774
translate chinese skystressrelief_08d678d2:

    # fr "Well, well, well. Not so cocky now, are we?"
    fr "瞧瞧你现在的样子。怎么不嚣张了呢？"

# game/ch1ep4.rpy:1775
translate chinese skystressrelief_f4986711:

    # fr "I do hope you're enjoying our deluxe accommodations. Only the best for my esteemed guest!"
    fr "我诚挚地希望你能喜欢我们安排的豪华套房。一定要把最好的地方给尊贵的客人才行！"

# game/ch1ep4.rpy:1776
translate chinese skystressrelief_2803a592:

    # mc "Francis, you spineless worm. If you're going to bore me to death, just get it over with already."
    mc "弗朗西斯，你个没胆子的孬种。你要是想让我无聊到死，就给我赶紧完事。"

# game/ch1ep4.rpy:1777
translate chinese skystressrelief_d29c5dc0:

    # fr "Oh no, no, no! We have far more exciting plans in store for you."
    fr "噢，不不不！我们可是为你准备了刺激得多的计划。"

# game/ch1ep4.rpy:1778
translate chinese skystressrelief_d7b27691:

    # fr "Allow me to introduce you to my associate here. This is Malice. He's positively brilliant at extracting information. But we won't need that from you."
    fr "向你介绍一下我的助手。他叫马利斯。他在获取情报这件事上非常有天赋。不过我们不需要你的情报。"

# game/ch1ep4.rpy:1779
translate chinese skystressrelief_eea1dbb7:

    # fr "I'm looking forward to your screams. Lots of delightful screams."
    fr "我很期待听到你的惨叫。让人愉悦的惨叫。"

# game/ch1ep4.rpy:1780
translate chinese skystressrelief_6477ef37:

    # mal "Hello, [mc]. We're going to become very... intimately acquainted."
    mal "你好，[mc!t]。我们接下来……要好好亲热一下。"

# game/ch1ep4.rpy:1781
translate chinese skystressrelief_a81ae646:

    # mal "I can't tell you how much I'm eager to take care of you."
    mal "我等不及要让你知道我有多想跟你亲密接触了。"

# game/ch1ep4.rpy:1783
translate chinese skystressrelief_b6e3e873:

    # mal "Shall we begin? I have so many wonderful toys to show you."
    mal "我们开始吧？我有非常多好玩的玩具要给你看看。"

# game/ch1ep4.rpy:1784
translate chinese skystressrelief_2b35b6fe_15:

    # mc "..."
    mc "……"

# game/ch1ep4.rpy:1785
translate chinese skystressrelief_d6875ef3:

    # fr "Not so chatty anymore, hm? No matter. You'll be singing soon enough."
    fr "没话说了，嗯？没关系。很快你就会放声高歌了。"

# game/ch1ep4.rpy:1786
translate chinese skystressrelief_7023a543:

    # fr "I'll leave you two to get better acquainted."
    fr "我就不打扰你们两个的私人时间了。"

# game/ch1ep4.rpy:1787
translate chinese skystressrelief_09c1aaca:

    # fr "Remember, my friend - make it hurt."
    fr "记住了，我的朋友——越疼越好。"

# game/ch1ep4.rpy:1788
translate chinese skystressrelief_7495a12c:

    # mal "With pleasure. This one seems like he'll last a while. The tough ones are always more fun to break."
    mal "非常乐意。他看起来像是能坚持挺久的样子。把结实的人弄坏总是更有意思。"

# game/ch1ep4.rpy:1790
translate chinese skystressrelief_2020ab9f:

    # mal "*chuckles* Now then. Let's put a lovely smile on that face, shall we?"
    mal "*笑* 好啦。先让你露出一个可爱的微笑怎么样？"

# game/ch1ep4.rpy:1797
translate chinese skystressrelief_29a4f6ab_1:

    # m "!!!"
    m "！！！"

# game/ch1ep4.rpy:1801
translate chinese skystressrelief_a50d97cb:

    # m "Please be in there, please be in there...!"
    m "请一定要在里面，一定要在里面啊……！"

# game/ch1ep4.rpy:1803
translate chinese skystressrelief_36c6017b:

    # shu "Shit, shit, shit!"
    shu "完了，完了，完蛋了！"

# game/ch1ep4.rpy:1804
translate chinese skystressrelief_0cf9c049:

    # e "I should've been there with him."
    e "我应该去陪着他的……"

# game/ch1ep4.rpy:1805
translate chinese skystressrelief_651c7752:

    # s "*crying* [mc]...!"
    s "*哭泣* [mc!t]……！"

# game/ch1ep4.rpy:1806
translate chinese skystressrelief_09807373:

    # k "Huh? C-can you say that again? I couldn't hear you."
    k "啊？你-你能再说一遍吗？我听不清。"

# game/ch1ep4.rpy:1807
translate chinese skystressrelief_ec01f1c2:

    # g "Ugh..."
    g "唉……"

# game/ch1ep4.rpy:1808
translate chinese skystressrelief_5f1a19da:

    # g "EVERYBODY, SHUT THE FUCK UP! YOU'RE CRIES ARE NOT HELPING!"
    g "{b}各位，都他妈闭嘴！再哭也没用！"

# game/ch1ep4.rpy:1809
translate chinese skystressrelief_361daa9a:

    # k "Thank you, dear."
    k "谢谢你，亲爱的。"

# game/ch1ep4.rpy:1810
translate chinese skystressrelief_f334c89f:

    # k "Yes, I'm sorry about that..."
    k "是的，很抱歉……"

# game/ch1ep4.rpy:1811
translate chinese skystressrelief_07bdde05_1:

    # "....."
    "……"

# game/ch1ep4.rpy:1812
translate chinese skystressrelief_0981883a:

    # k "Yes, yes! We're all safe! Please hurry!"
    k "是的，是的！我们都没事！拜托快点来！"

# game/ch1ep4.rpy:1813
translate chinese skystressrelief_d1ddaffa_2:

    # "........"
    "…………"

# game/ch1ep4.rpy:1814
translate chinese skystressrelief_b0251fbe:

    # k "You're almost here? Okay, I understand!"
    k "你们快到了？好的，我明白了！"

# game/ch1ep4.rpy:1815
translate chinese skystressrelief_a4386b0d:

    # f "I'm so sorry, I couldn't do anything~!"
    f "真对不起，我什么都做不到~！"

# game/ch1ep4.rpy:1816
translate chinese skystressrelief_cc84209a:

    # g "It wasn't your fault, Freya. We're just thankful you didn't get involved too. It could have been much worse."
    g "不是你的错，芙蕾雅。没有连你一起带走就已经是万幸了。不然只会糟糕得多。"

# game/ch1ep4.rpy:1818
translate chinese skystressrelief_687c11dc:

    # a "You! Where the hell have you-!"
    a "你！你他妈跑哪去——！"

# game/ch1ep4.rpy:1819
translate chinese skystressrelief_bb8e4b4e:

    # a "..."
    a "……"

# game/ch1ep4.rpy:1822
translate chinese skystressrelief_62e8e963:

    # e "Moon..."
    e "月……"

# game/ch1ep4.rpy:1823
translate chinese skystressrelief_1c638a1c:

    # m "Where is he?"
    m "他在哪？"

# game/ch1ep4.rpy:1824
translate chinese skystressrelief_bb8e4b4e_1:

    # a "..."
    a "……"

# game/ch1ep4.rpy:1825
translate chinese skystressrelief_88ef2b5d:

    # f "... That Francis guy. They took him..."
    f "……那个叫弗朗西斯的。被他们抓走了……"

# game/ch1ep4.rpy:1826
translate chinese skystressrelief_4f7ed5df:

    # f "*sobs* I'm sorry, Moon! I was with him, but I couldn't do anything!"
    f "*抽泣* 对不起，月！我跟他在一起的，可是我也没办法！"

# game/ch1ep4.rpy:1829
translate chinese skystressrelief_5068ea5c:

    # m "*wailing* HHNNK~! AAAHK~!"
    m "*哭号* 啊啊啊啊啊啊！！"

# game/ch1ep4.rpy:1830
translate chinese skystressrelief_76ba2c0d:

    # m "Why...? Why does this pain in my chest hurst unlike any wounds I've had? It hurts more than the scar on my back, more than losing Six and Eight."
    m "为什么……？为什么这心里的疼痛跟以往的伤口都不一样？比我背上的伤疤还要痛苦，比失去六号和八号还要难受。"

# game/ch1ep4.rpy:1831
translate chinese skystressrelief_de203d62:

    # m "Why is this happening to me? I don't understand! I shouldn't be feeling this way...!"
    m "为什么我会这样？我不明白啊！我不应该有这种感觉的……！"

# game/ch1ep4.rpy:1833
translate chinese skystressrelief_918cbe32:

    # m "These feelings aren't mine; they're from the ones inside me. But..."
    m "这些感觉不是我的；而是属于我体内的那个人。可是……"

# game/ch1ep4.rpy:1834
translate chinese skystressrelief_edf4af32:

    # m "But... deep down in my own heart... I'm desperately yearning for him..."
    m "可是……在我自己的内心深处……我也疯狂的渴望着他……"

# game/ch1ep4.rpy:1835
translate chinese skystressrelief_c01573f5:

    # m "No, I can't bear the thought of losing him~! I need to be by his side~!"
    m "不行，我绝对不能失去他……！我需要他在我身边！"

# game/ch1ep4.rpy:1836
translate chinese skystressrelief_e0a88c6c:

    # e "This is... I've never seen her break down like that..."
    e "这……我从来没见过她崩溃成这样……"

# game/ch1ep4.rpy:1837
translate chinese skystressrelief_4c73781f:

    # j "I bet no one ever has... Even her."
    j "我想没有任何人见过……包括她自己。"

# game/ch1ep4.rpy:1838
translate chinese skystressrelief_a2418643:

    # cl "Aveline and Lucien have a different kind of relationship, so I can't say I completely relate to her."
    cl "艾芙琳和卢希恩的关系跟他们俩不一样，所以我没法说我完全理解她。"

# game/ch1ep4.rpy:1839
translate chinese skystressrelief_ee1f8708:

    # cl "But if there's one thing that's common in all serum users, it's their conflicting emotions."
    cl "不过所有的血清使用者都有一个共同点，那就是内心冲突的情感。"

# game/ch1ep4.rpy:1840
translate chinese skystressrelief_7aaca4c9:

    # cl "It's an extremely complicated feeling where you experience multiple emotions at once in that very same moment."
    cl "在同一时刻感到好几种不同的情绪，是种非常复杂的感觉。"

# game/ch1ep4.rpy:1841
translate chinese skystressrelief_4acad194:

    # cl "Aveline tends to push her emotions towards me, making them mine. At the same time, my own emotion triggers along with it, fighting Aveline's back."
    cl "艾芙琳喜欢把她的情绪推给我，让我也感受到那些情绪。与此同时，我自己的情绪也会被调动起来，跟艾芙琳对抗。"

# game/ch1ep4.rpy:1842
translate chinese skystressrelief_10b1d334:

    # cl "However, in Fang's case, her and Lady Sora's emotions aren't colliding..."
    cl "不过，獠牙的情况就不一样了，她跟空姬的情绪并没有出现冲突……"

# game/ch1ep4.rpy:1843
translate chinese skystressrelief_c064750f:

    # cl "Her bond with [mc] eventually made her feelings align with Lady Sora's, which means Fang feels twice the intensity when it triggers."
    cl "她跟[mc!t]之间的感情反而与空姬的感情达成了一致，也就是说，她现在正承受着两倍强度的情感冲击。"

# game/ch1ep4.rpy:1844
translate chinese skystressrelief_c8924c23:

    # cl "And I believe this is a first for her..."
    cl "我想这对她来说也是第一次……"

# game/ch1ep4.rpy:1846
translate chinese skystressrelief_27d2c2eb:

    # j "Don't worry. We haven't lost him just yet."
    j "没事的。还有机会救他。"

# game/ch1ep4.rpy:1847
translate chinese skystressrelief_e789f298:

    # j "Thanks to Freya's swift action, we were alerted immediately."
    j "多亏了芙蕾雅行动及时，我们第一时间就接到了通知。"

# game/ch1ep4.rpy:1848
translate chinese skystressrelief_a3e2dbd9:

    # e "Uh, if I may."
    e "呃，我有话要说。"

# game/ch1ep4.rpy:1849
translate chinese skystressrelief_321561ea:

    # e "Take a look at this..."
    e "你们看一下这个……"

# game/ch1ep4.rpy:1850
translate chinese skystressrelief_188978a8:

    # e "By leveraging my comprehensive integration with the urban closed-circuit television network architecture, I methodically derived the vehicular trajectory employing advanced tracking algorithms."
    e "通过充分利用我对城市闭路电视网络架构的了解，我系统地利用先进追踪算法推导出了车辆的行动轨迹。"

# game/ch1ep4.rpy:1851
translate chinese skystressrelief_ca663972:

    # j "English, please, Eliza."
    j "请说人话，伊莉莎。"

# game/ch1ep4.rpy:1852
translate chinese skystressrelief_3f2c9fc8:

    # e "Oh, sorry."
    e "噢，抱歉。"

# game/ch1ep4.rpy:1853
translate chinese skystressrelief_9671ce29:

    # e "Well, I tapped into the city's CCTV network and managed to track their van."
    e "嗯，我看了那一片的监控，找到了那辆车。"

# game/ch1ep4.rpy:1854
translate chinese skystressrelief_574013ec:

    # e "Based on their last known location, he's here."
    e "根据他们最后的已知地点来看，他在这里。"

# game/ch1ep4.rpy:1855
translate chinese skystressrelief_0449ef9e:

    # shu "So you're a hacker."
    shu "原来你是个黑客啊。"

# game/ch1ep4.rpy:1856
translate chinese skystressrelief_8c4b00f0:

    # e "Yeah!"
    e "是的！"

# game/ch1ep4.rpy:1857
translate chinese skystressrelief_f007fcc4:

    # m "Where is that?"
    m "那是什么地方？"

# game/ch1ep4.rpy:1858
translate chinese skystressrelief_7250086e:

    # j "It's an unmarked site in our records. Likely one of Mentzelopoutous' hideouts as we had no information about them."
    j "是个我们的记录里没有的地方。估计是门泽拉普图斯家的藏身处之一吧，毕竟我们对他们一无所知。"

# game/ch1ep4.rpy:1859
translate chinese skystressrelief_6743844e:

    # e "That area lacks CCTV coverage, but given the layout, there's only one way in and out. They must have taken him there."
    e "那个区域没有摄像头，不过根据这布局来看，出入口只有一个。他们肯定是把他带到那里去了。"

# game/ch1ep4.rpy:1860
translate chinese skystressrelief_d189617a:

    # e "I'm currently monitoring all nearby cameras, so if they move, we'll catch it."
    e "我现在正在盯着附近所有的摄像头，如果他们移动了的话，我们也能第一时间知道。"

# game/ch1ep4.rpy:1862
translate chinese skystressrelief_aa38d16f:

    # cl "And where do you think you're heading?"
    cl "你要去哪？"

# game/ch1ep4.rpy:1863
translate chinese skystressrelief_55d6b948:

    # m "This is my responsibility, Owl. I failed to do my job. I will fix this alone."
    m "这是我的责任，枭。我没有做好我的工作。我要自己去弥补。"

# game/ch1ep4.rpy:1864
translate chinese skystressrelief_a964ae64:

    # cl "That's not happening, Fang. At a time like this, we should be working together."
    cl "不可能的，獠牙。这种情况下我们一定要团队合作。"

# game/ch1ep4.rpy:1865
translate chinese skystressrelief_184559df:

    # m "Since when did \"teamwork\" become part of your lexicon?"
    m "“合作”这个词是什么时候跑到你的词典里的？"

# game/ch1ep4.rpy:1866
translate chinese skystressrelief_2af26976:

    # m "I said it's my burden to bear. Besides, what the hell could you possibly do to help?"
    m "我说了这是我自己的事。再说了，你又能帮上什么忙？"

# game/ch1ep4.rpy:1867
translate chinese skystressrelief_e5a08b01:

    # cl "Are you mocking me?"
    cl "你这是看不起我吗？"

# game/ch1ep4.rpy:1868
translate chinese skystressrelief_8cb62253_2:

    # m "Yes."
    m "没错。"

# game/ch1ep4.rpy:1869
translate chinese skystressrelief_66f7a545:

    # cl "Really now?"
    cl "你认真的？"

# game/ch1ep4.rpy:1870
translate chinese skystressrelief_37ea64a3:

    # m "Stand down, Aveline..."
    m "你就原地待命吧，艾芙琳……"

# game/ch1ep4.rpy:1871
translate chinese skystressrelief_aa0a05fe:

    # cl "Stand down? This isn't the military, Fang."
    cl "待命？你还以为你在军队里啊，獠牙？"

# game/ch1ep4.rpy:1874
translate chinese skystressrelief_e637ed72:

    # cl "Lance's strength? No, even stronger..."
    cl "这力量，和长矛相当吗？不，还要更强……"

# game/ch1ep4.rpy:1875
translate chinese skystressrelief_36b51985:

    # cl "Tch... Damn you, Yuna..."
    cl "啧……都他妈怪你，由奈……"

# game/ch1ep4.rpy:1876
translate chinese skystressrelief_cc60ec14:

    # m "Now tell me again, what can you do?"
    m "我再问你一遍，你能帮上什么忙？"

# game/ch1ep4.rpy:1877
translate chinese skystressrelief_a76427b6:

    # cl "*chuckles* Even Aveline would shake at that...?"
    cl "*笑* 就连艾芙琳都会怕吗……？"

# game/ch1ep4.rpy:1878
translate chinese skystressrelief_ecf62fef:

    # cl "I see... So this is why Lance picked you."
    cl "原来如此……怪不得长矛选了你。"

# game/ch1ep4.rpy:1879
translate chinese skystressrelief_c004bacc:

    # cl "Fine, I'll back off. Arguing with you is pointless, as always."
    cl "好吧，我不插手。一如既往，跟你争论没有意义。"

# game/ch1ep4.rpy:1880
translate chinese skystressrelief_03657258:

    # m "That's right... You're weak."
    m "没错……你太弱了。"

# game/ch1ep4.rpy:1881
translate chinese skystressrelief_27ddbd77:

    # m "You're all weak. Always relying on others to solve your problems. You can't do anything on your own."
    m "你们所有人都太弱。总是靠别人来解决自己的问题。自己一个人就什么都做不到。"

# game/ch1ep4.rpy:1882
translate chinese skystressrelief_4bfe5f56:

    # m "But I'm different. I'm stronger. Stronger than all of you."
    m "但我不一样。我更强。比你们所有人都强。"

# game/ch1ep4.rpy:1883
translate chinese skystressrelief_aefe86d1:

    # m "So go ahead, sit here and bawl your eyes out. I'll handle this myself."
    m "你们就继续坐在这里，把眼睛哭瞎吧。我自己去解决。"

# game/ch1ep4.rpy:1885
translate chinese skystressrelief_f19afc08:

    # a "Is she serious?! Doing it on her own?!"
    a "她是认真的吗？！自己一个人去？！"

# game/ch1ep4.rpy:1886
translate chinese skystressrelief_f61c2831:

    # j "To protect you all."
    j "这是为了保护你们。"

# game/ch1ep4.rpy:1887
translate chinese skystressrelief_a7304cbb:

    # a "I mean, I get it, but still..."
    a "我明白，可是……"

# game/ch1ep4.rpy:1888
translate chinese skystressrelief_8cc50133:

    # j "Fang is not one to mock other people's capabilities. I think, in her own way, it's her means of coping with the pressure."
    j "獠牙不是会嘲讽别人的能力的人。我想，这是她发泄压力的方式吧。"

# game/ch1ep4.rpy:1889
translate chinese skystressrelief_51224225:

    # j "She's always been uncertain of what she wants to do. For once, she's making a choice on her own."
    j "她总是搞不明白自己想做什么。这是她第一次自己做出选择。"

# game/ch1ep4.rpy:1890
translate chinese skystressrelief_dd32e108:

    # j "Let her go. We can only hope for the best."
    j "让她去吧。我们只能希望一切顺利。"

# game/ch1ep4.rpy:1891
translate chinese skystressrelief_bb8e4b4e_2:

    # a "..."
    a "……"

# game/ch1ep4.rpy:1892
translate chinese skystressrelief_2793cbba:

    # a "... No, I can't just sit by. Regardless of her strength, she's still human. And this is [mc]'s life at stake."
    a "……不，我没法坐视不管。哪怕她再强，她也只是个人类。现在[mc!t]可是危在旦夕。"

# game/ch1ep4.rpy:1893
translate chinese skystressrelief_ed454ad1:

    # a "Em, are you coming with me?"
    a "小艾，你跟我一起吗？"

# game/ch1ep4.rpy:1894
translate chinese skystressrelief_dfe43d05:

    # e "Anywhere."
    e "当然。"

# game/ch1ep4.rpy:1895
translate chinese skystressrelief_bfa7ac35:

    # a "Get ready, we're leaving."
    a "做好准备，我们马上就走。"

# game/ch1ep4.rpy:1896
translate chinese skystressrelief_a80dde76:

    # j "Where are you going?"
    j "你们要去哪？"

# game/ch1ep4.rpy:1897
translate chinese skystressrelief_5076593f:

    # a "Back to where I came from."
    a "去我来的地方。"

# game/ch1ep4.rpy:1898
translate chinese skystressrelief_33cfc3e6:

    # j "I understand. Do as you think best. I entrust them to you."
    j "我明白了。你就按你想的做吧。我把他们交给你了。"

# game/ch1ep4.rpy:1899
translate chinese skystressrelief_2d3c6443:

    # k "Aine, please... bring them back safe."
    k "艾妮，拜托……一定要把他们平安带回来。"

# game/ch1ep4.rpy:1900
translate chinese skystressrelief_6ac2259c:

    # a "Mhm, I will. You have my word."
    a "嗯，好的。我向你保证。"

# game/ch1ep4.rpy:1908
translate chinese skystressrelief_dc2eddd1:

    # mal "Wakey, wakey!"
    mal "起床啦！起床啦！"

# game/ch1ep4.rpy:1910
translate chinese skystressrelief_5070b771:

    # mc "*huff* *huff*"
    mc "*喘气* *喘气*"

# game/ch1ep4.rpy:1911
translate chinese skystressrelief_79437763:

    # yt "Huh...? How long have I been stuck here...?"
    yt "啊……？我在这……待了多久了……？"

# game/ch1ep4.rpy:1912
translate chinese skystressrelief_eb36b7be:

    # yt "Is this the price I have to pay for wanting to uncover the truth...?"
    yt "这就是为了触及真相要付出的代价吗……？"

# game/ch1ep4.rpy:1913
translate chinese skystressrelief_507703db:

    # yt "I just wanted answers, to understand why the world can be so cruel and unfair..."
    yt "我只想要答案，想弄清楚为什么这个世界会如此残酷、不公平……"

# game/ch1ep4.rpy:1914
translate chinese skystressrelief_72277432:

    # yt "But now, here I am, caught in this bad dream, hurting more than I ever thought possible..."
    yt "可现在，我却被困在这场噩梦里，体会着我永远都想象不到的痛苦……"

# game/ch1ep4.rpy:1915
translate chinese skystressrelief_b86c73fc:

    # yt "Why does wanting to know more and find peace end up like this...?"
    yt "为什么追求答案，追求平静，会让我落到这种下场……？"

# game/ch1ep4.rpy:1916
translate chinese skystressrelief_d4612649:

    # yt "My body's giving up, and it's hard to keep hoping, but I can't stop wanting to know..."
    yt "我的身体要撑不住了，连奢望本身都成了一种奢望，可我却依然想知道……"

# game/ch1ep4.rpy:1917
translate chinese skystressrelief_e1447a5d:

    # yt "I have to find out the truth, to make sense of all this, even if it hurts..."
    yt "我一定要找到真相，要理解这一切，哪怕会如此痛苦……"

# game/ch1ep4.rpy:1918
translate chinese skystressrelief_8fb07ccf:

    # yt "But every new pain makes me wonder if it's worth it..."
    yt "但每一丝新的疼痛都会让我搞不明白这是否值得……"

# game/ch1ep4.rpy:1919
translate chinese skystressrelief_4f3e7bec:

    # yt "Is this what happens to people who dare to question...? To those who look for a little bit of light...?"
    yt "胆敢提出问题的人，想寻求一丝光明的人，都会遭受这种待遇吗……？"

# game/ch1ep4.rpy:1920
translate chinese skystressrelief_e58f82d7:

    # yt "Or am I just another casualty of the cruelty and injustice that pervades this world...?"
    yt "还是说我只是这笼罩世界的残酷与不公的另一个受害者……？"

# game/ch1ep4.rpy:1921
translate chinese skystressrelief_4ba37972:

    # yt "I don't know how much more I can handle, but I can't give up. I have to believe there's a reason for all this pain..."
    yt "我不知道我还能承受多少，但是我不能放弃。我必须坚信这一切痛苦的背后都是有原因的……"

# game/ch1ep4.rpy:1922
translate chinese skystressrelief_369ada51:

    # yt "... I wonder how Moon is doing without me..."
    yt "……不知道我不在的时候，月怎么样了……"

# game/ch1ep4.rpy:1923
translate chinese skystressrelief_22a9815e:

    # yt "*chuckles* She's been like a baby... seeking for my presence all the time..."
    yt "*笑* 她像个小婴儿一样……一直都想让我陪着……"

# game/ch1ep4.rpy:1924
translate chinese skystressrelief_58e6dfd3:

    # mal "Ah, there you are! Back from your little dream world, are we?"
    mal "啊，你醒了！从梦幻世界里回来了？"

# game/ch1ep4.rpy:1925
translate chinese skystressrelief_acf6fe8b:

    # mal "You know, you're quite a fascinating one. Most people would have broken by now, but not you."
    mal "知道吗，你真是挺厉害的。一般人到这种时候都已经不行了，但你不一样。"

# game/ch1ep4.rpy:1926
translate chinese skystressrelief_4ff2b3dc:

    # mal "It's almost like you enjoy the pain, like you're clinging to it as some twisted lifeline."
    mal "就好像你很享受痛苦，好像你把它当做一种扭曲的生命线，死抱着不松手一样。"

# game/ch1ep4.rpy:1927
translate chinese skystressrelief_16b7f30a:

    # mal "But I can see it in your eyes, the desperation, the fear. You're wondering how long you can hold out, aren't you?"
    mal "但是我能在你的眼睛里看到绝望和恐惧。你在想你到底还能撑多久，对吧？"

# game/ch1ep4.rpy:1928
translate chinese skystressrelief_59680b92:

    # mal "Well, let me tell you a little secret..."
    mal "好吧，那我告诉你一个小秘密……"

# game/ch1ep4.rpy:1929
translate chinese skystressrelief_ccd18b25:

    # mal "I'm just getting started. We've got plenty of time to explore the depths of your suffering."
    mal "我才刚开始呢。我们还有大把时间来研究一下你能忍到什么程度。"

# game/ch1ep4.rpy:1930
translate chinese skystressrelief_0dbdc9ea:

    # mal "And I've got a special treat for you..."
    mal "而且我还给你准备了特别惊喜……"

# game/ch1ep4.rpy:1931
translate chinese skystressrelief_0f7b5693:

    # mal "You see, I've been thinking about how to make this even more exquisite for you."
    mal "你看，我一直在想要怎么才能让这场晚会更优美。"

# game/ch1ep4.rpy:1932
translate chinese skystressrelief_2f0ef2c1:

    # mal "So, I've decided to let the room cool down a bit."
    mal "所以，我决定让房间里的温度降下来。"

# game/ch1ep4.rpy:1933
translate chinese skystressrelief_69534e1e:

    # mal "The chill will seep into your bones, making every cut, every burn, every broken piece of you scream in agony."
    mal "寒冷会渗进你的骨头里，让每处割伤，烧伤，你身上所有破碎的地方，都痛苦地大叫起来。"

# game/ch1ep4.rpy:1934
translate chinese skystressrelief_1f1ca5db:

    # mal "It's a delightful contrast, don't you think? The searing heat of pain against the icy grip of despair."
    mal "多么令人愉悦的反差啊，你不觉得吗？疼痛带来的灼烧，配上让人绝望的寒意。"

# game/ch1ep4.rpy:1935
translate chinese skystressrelief_ad80df19:

    # mal "And just when you think you can't take anymore, when you're ready to beg for mercy, I'll bring you back from the brink, only to start all over again."
    mal "而就在你觉得自己要承受不住的时候，就在你要开口求饶的时候，我会带你回到起点，从头再来一次。"

# game/ch1ep4.rpy:1936
translate chinese skystressrelief_0d8241d8:

    # mal "Because you can't give up just yet, [mc]. We've got so much more playtime ahead of us. And I intend to savor every moment of your suffering."
    mal "你现在可还不能放弃啊，[mc!t]。我们还要一起玩很久很久呢。我要仔细品尝你受苦的每一秒钟。"

# game/ch1ep4.rpy:1937
translate chinese skystressrelief_b73f7b50:

    # mal "So, go ahead, cling to your precious truth, your pathetic hopes. They'll only make your fall that much sweeter."
    mal "所以你就继续为了你那宝贵的真相，为了你那可悲的希望坚持下去吧。这样只会让你最终的崩溃更加甜美啊。"

# game/ch1ep4.rpy:1938
translate chinese skystressrelief_f2f7340a:

    # mal "*laughs maniacally*"
    mal "*疯狂地大笑*"

# game/ch1ep4.rpy:1939
translate chinese skystressrelief_4685b3c0:

    # mal "Now, let's see how long you can last in the cold embrace of my love, yeah?"
    mal "好了，来看看你能在我冰冷爱意的怀抱里坚持多久吧。"

# game/ch1ep4.rpy:1941
translate chinese skystressrelief_1498e431:

    # yt "Everyone... I'm sorry... I don't know if I can make it back to you..."
    yt "大家……对不起……我可能没法回去找你们了……"

# game/ch1ep4.rpy:1949
translate chinese skystressrelief_e612037c_19:

    # m "..."
    m "……"

# game/ch1ep4.rpy:1951
translate chinese skystressrelief_e1573ed5:

    # cl "You can run as far as you like, but escaping who you are is impossible. You've taken thousands of lives."
    cl "不管你逃多远，都不可能逃避你自己。你夺走过千百条生命。"

# game/ch1ep4.rpy:1952
translate chinese skystressrelief_9b034cee:

    # cl "Struggle as you might to distance yourself from your past, it won't change a thing."
    cl "不管你再怎么远离你的过去，也什么都不会改变。"

# game/ch1ep4.rpy:1953
translate chinese skystressrelief_ab548ba5:

    # cl "You can try to be a bodyguard... a savior..."
    cl "你大可以去扮演保镖……扮演救星……"

# game/ch1ep4.rpy:1954
translate chinese skystressrelief_16a277f1:

    # cl "... A lover."
    cl "……扮演成爱人。"

# game/ch1ep4.rpy:1955
translate chinese skystressrelief_e612037c_20:

    # m "..."
    m "……"

# game/ch1ep4.rpy:1956
translate chinese skystressrelief_2fdd0704:

    # cl "Yet, there is a truth that clings to you, one that you cannot simply forget..."
    cl "但是，赤裸裸的事实会永远跟着你，你怎么也摆脱不掉……"

# game/ch1ep4.rpy:1957
translate chinese skystressrelief_44a706fb:

    # cl "Despite your efforts, you cannot erase the fact that you are..."
    cl "不管你再怎么努力，你也没法否认你是个……"

# game/ch1ep4.rpy:1958
translate chinese skystressrelief_b1946763:

    # cl "A monster..."
    cl "怪物……"

# game/ch1ep4.rpy:1959
translate chinese skystressrelief_1faa796b:

    # m "I know what I've done, Aveline. I live with the weight of my actions every single day."
    m "我知道我做过什么，艾芙琳。我每天都活在我过去的行为的重担之下。"

# game/ch1ep4.rpy:1960
translate chinese skystressrelief_841844db:

    # cl "Please, save the dramatics. You forfeited the right to sympathy the moment you walked through your path."
    cl "省省吧。从你选择了这条路那天开始，就已经没有得到同情的资格了。"

# game/ch1ep4.rpy:1961
translate chinese skystressrelief_8ecd2e20:

    # cl "And now, [mc] is in peril because of your mistake, the one soul who managed to look beyond the monster that you are..."
    cl "现在，[mc!t]，唯一一个能不把你当怪物看待的人……却因为你的失误，生命垂危。"

# game/ch1ep4.rpy:1962
translate chinese skystressrelief_fd7bd441:

    # m "I never wanted any of this. I'll risk everything to protect him, even if it's the last thing I do."
    m "我丝毫不想让这种事发生。我为了保护他甘愿付出一切，哪怕是要献出生命。"

# game/ch1ep4.rpy:1963
translate chinese skystressrelief_48919e5e:

    # cl "You'd better. Should death come to him, you'll find yourself drowning in blame."
    cl "你最好说到做到。如果死神带走了他，你就要被骂名淹没了。"

# game/ch1ep4.rpy:1964
translate chinese skystressrelief_128ed4eb:

    # m "I don't need your words, Aveline..."
    m "我不需要你在这说三道四，艾芙琳……"

# game/ch1ep4.rpy:1965
translate chinese skystressrelief_ab515cdb:

    # m "After all, you're not that any different than me."
    m "说到底，你跟我也没有什么区别。"

# game/ch1ep4.rpy:1966
translate chinese skystressrelief_e68c45bc:

    # cl "*chuckles*"
    cl "*笑*"

# game/ch1ep4.rpy:1972
translate chinese skystressrelief_4bebc1db:

    # j "Good luck."
    j "祝你好运。"

# game/ch1ep4.rpy:1973
translate chinese skystressrelief_fdca996c:

    # m "After everything's settled, I want to be [mc]'s full-time aide."
    m "在事情结束之后，我想做[mc!t]的全职助手。"

# game/ch1ep4.rpy:1974
translate chinese skystressrelief_44f30911:

    # j "Is that a lifeline to grasp at, or a duty you feel compelled to take?"
    j "这是你觉得自己必须抓住的救命稻草，还是你觉得自己必须遵从的使命？"

# game/ch1ep4.rpy:1975
translate chinese skystressrelief_e6d8b85f:

    # m "Neither..."
    m "都不是……"

# game/ch1ep4.rpy:1976
translate chinese skystressrelief_0aa0c34d:

    # m "It's a decision I've made because it is what I want."
    m "这是我出于自己的意志做出的决定。"

# game/ch1ep4.rpy:1977
translate chinese skystressrelief_b4fa3fc0_1:

    # j "..."
    j "……"

# game/ch1ep4.rpy:1978
translate chinese skystressrelief_e866d1fd:

    # j "Seriously, waking up now of all times."
    j "搞什么啊，偏偏这时候开窍。"

# game/ch1ep4.rpy:1979
translate chinese skystressrelief_510fbd80:

    # j "I understand, but... it's unnecessary. The call wasn't mine to make in the first place."
    j "我明白了，不过……没有那个必要。这种事本来也不该让我来决定。"

# game/ch1ep4.rpy:1980
translate chinese skystressrelief_d16c4d95:

    # j "Ultimately, Lance chose you to lead the clan..."
    j "毕竟，长矛选了你来领导氏族……"

# game/ch1ep4.rpy:1988
translate chinese skystressrelief_0cab9776:

    # m "Beneath the suffocating grip of twilight's gloom..."
    m "阴暗的暮色几乎要击溃人的神经……"

# game/ch1ep4.rpy:1989
translate chinese skystressrelief_039a8445:

    # m "I stand, a sentinel in fate's unyielding tomb."
    m "我孑然独立，是乃命运不变坟墓中的哨兵。"

# game/ch1ep4.rpy:1990
translate chinese skystressrelief_0f495f12:

    # m "Moon aloft, a silent witness to my plight..."
    m "圆月高悬，静静注视着我的苦难……"

# game/ch1ep4.rpy:1991
translate chinese skystressrelief_2a9db552:

    # m "Through shadows' menace, in darkness I ignite."
    m "我穿过凶狠的夜色，将这黑暗点燃。"

# game/ch1ep4.rpy:1993
translate chinese skystressrelief_10f21092:

    # m "As a huntsman revels in the chase's bloody wake..."
    m "身为猎人，内心为这血腥的追逐而荡漾……"

# game/ch1ep4.rpy:1994
translate chinese skystressrelief_6065c3f3:

    # m "I offer thanks for the power thou dost make."
    m "我感谢你赐予我的力量。"

# game/ch1ep4.rpy:1995
translate chinese skystressrelief_85f6def8:

    # m "For foes laid waste and victories hard-won..."
    m "敌人尸横遍野，胜利来之不易……"

# game/ch1ep4.rpy:1996
translate chinese skystressrelief_1bc91141:

    # m "A feast of carnage, when the hunt is done."
    m "在这狩猎之夜，上演屠杀的宴席。"

# game/ch1ep4.rpy:1998
translate chinese skystressrelief_8dd3df17:

    # m "In this eerie calm, before the tempest's roar..."
    m "诡异的宁静过后，风暴将要来临……"

# game/ch1ep4.rpy:1999
translate chinese skystressrelief_fd3a9b2a:

    # m "I am the stalker, and the night's grim core."
    m "我是地上行者，也是冷夜的核心。"

# game/ch1ep4.rpy:2000
translate chinese skystressrelief_cbbb01f7:

    # m "Bless the steel I bear, merciless and cold..."
    m "我手中这把利刃，冰冷而又无情……"

# game/ch1ep4.rpy:2001
translate chinese skystressrelief_5d3d68c6:

    # m "Let my strike be lethal, my resolve untold."
    m "我的决心难以言说，但我必一刀毙命。"

# game/ch1ep4.rpy:2003
translate chinese skystressrelief_bae2436d:

    # m "For the lives I reap, like the harvest moon's blight..."
    m "如同收获月的疫病，我收割无数生命……"

# game/ch1ep4.rpy:2004
translate chinese skystressrelief_0a2e0003:

    # m "I pray their end be brutal, devoid of light."
    m "我祈祷他们的结局凄惨无比，永世不得安宁。"

# game/ch1ep4.rpy:2005
translate chinese skystressrelief_872d849a:

    # m "Grant me dominion as I tip the scales..."
    m "赐予我支配之力，让我能操控天平……"

# game/ch1ep4.rpy:2006
translate chinese skystressrelief_8c6b9625:

    # m "In the dance of blades, where terror prevails."
    m "在这刀光剑影之中，只有恐怖横行。"

# game/ch1ep4.rpy:2008
translate chinese skystressrelief_10787b58:

    # m "I thank thee for the curse, the savage might I bear..."
    m "感谢你下达的诅咒，给我带来这破坏的力量……"

# game/ch1ep4.rpy:2009
translate chinese skystressrelief_eef888e5:

    # m "In this waltz of ruin, upon the field of despair."
    m "我随毁灭翩翩起舞，在这充盈绝望的战场上。"

# game/ch1ep4.rpy:2010
translate chinese skystressrelief_da1850d8:

    # m "May the wailing night choke on their final breath..."
    m "愿号哭的夜吞没他们临终的悲鸣与畏惧……"

# game/ch1ep4.rpy:2011
translate chinese skystressrelief_6733be60:

    # m "As I embrace my fate, the harbinger of death."
    m "我会接受命运，化身死神的先驱。"

# game/ch1ep4.rpy:2045
translate chinese skystressrelief_9fec93e8:

    # m "*huff*... *huff*..."
    m "*喘气*…… *喘气*……"

# game/ch1ep4.rpy:2046
translate chinese skystressrelief_e612037c_21:

    # m "..."
    m "……"

# game/ch1ep4.rpy:2050
translate chinese skystressrelief_1a0b8807:

    # m "*huff*... *huff*... *huff*..."
    m "*喘气*…… *喘气*…… *喘气*……"

# game/ch1ep4.rpy:2051
translate chinese skystressrelief_e612037c_22:

    # m "..."
    m "……"

# game/ch1ep4.rpy:2055
translate chinese skystressrelief_bb2593cd:

    # m "{i}We're in close quarters. She should be at a disadvantage. But why do I feel..."
    m "{i}我们离得很近。她应该处于不利才对。可为什么我感觉……"

# game/ch1ep4.rpy:2056
translate chinese skystressrelief_aa793de0:

    # m "{i}No, now is not the time to underestimate anybody."
    m "{i}不行，现在绝对不能小瞧任何人。"

# game/ch1ep4.rpy:2057
translate chinese skystressrelief_c5d09c24:

    # m "{i}Her real strength was always her endurance and patience... A quality of a real marksman."
    m "{i}她真正强的地方一直都是耐力和耐心……这是真正的射手才有的品质。"

# game/ch1ep4.rpy:2058
translate chinese skystressrelief_a67ba6c6:

    # m "{i}I wonder how will she-"
    m "{i}不知道她会怎么——"

# game/ch1ep4.rpy:2059
translate chinese skystressrelief_1254e896:

    # ao "I remember the time when we were friends, Four... You, me, Six, and Eight..."
    ao "我还记得我们依旧是朋友的时候，四号……你，我，六号，还有八号……"

# game/ch1ep4.rpy:2060
translate chinese skystressrelief_29a4f6ab_2:

    # m "!!!"
    m "！！！"

# game/ch1ep4.rpy:2061
translate chinese skystressrelief_af27f97f:

    # ao "Yes, I can speak..."
    ao "是的，我会说话……"

# game/ch1ep4.rpy:2062
translate chinese skystressrelief_a0d47c84:

    # ao "Back then, only One ever heard my voice... He loved it..."
    ao "以前，只有一号听过我的声音……他很喜欢……"

# game/ch1ep4.rpy:2063
translate chinese skystressrelief_958acf93:

    # ao "Seeing his smile after hearing me felt like déjà vu... I thought I recognized that smile..."
    ao "他在听到我的声音之后露出了微笑，让我有种似曾相识的感觉……我总觉得我认得那个笑容……"

# game/ch1ep4.rpy:2064
translate chinese skystressrelief_963bf592:

    # ao "And I was right..."
    ao "我想得没错……"

# game/ch1ep4.rpy:2065
translate chinese skystressrelief_08ecebc6:

    # ao "You weren't the only person searching for answers, Four..."
    ao "你不是唯一一个在寻找答案的人，四号……"

# game/ch1ep4.rpy:2066
translate chinese skystressrelief_28bac138:

    # ao "One... was my little brother..."
    ao "一号……是我的弟弟……"

# game/ch1ep4.rpy:2067
translate chinese skystressrelief_e612037c_23:

    # m "..."
    m "……"

# game/ch1ep4.rpy:2068
translate chinese skystressrelief_60d3de21:

    # ao "And you took him away from me..."
    ao "而你让我再也见不到他了……"

# game/ch1ep4.rpy:2069
translate chinese skystressrelief_b9361297:

    # m "We both chose our paths, Aoife. His fate was sealed the moment we picked sides."
    m "我们都选择了自己的路，艾法。他的命运在我们选边站的时候就已经注定了。"

# game/ch1ep4.rpy:2070
translate chinese skystressrelief_50c3462a:

    # ao "I could say the same about your friends..."
    ao "我可以对你的朋友们说一样的话……"

# game/ch1ep4.rpy:2071
translate chinese skystressrelief_02b0bfcb:

    # m "{i}Your{/i} friends."
    m "也是{i}你的{/i}朋友。"

# game/ch1ep4.rpy:2072
translate chinese skystressrelief_9180fef5:

    # ao "They were no longer mine when they chose to follow you..."
    ao "她们选择追随你的时候就已经不是我的朋友了……"

# game/ch1ep4.rpy:2073
translate chinese skystressrelief_b7d5b1c5:

    # m "Aoife...!"
    m "艾法……！"

# game/ch1ep4.rpy:2074
translate chinese skystressrelief_79cd0e54:

    # ao "But enough of the past..."
    ao "不过过去的事聊得够多了……"

# game/ch1ep4.rpy:2075
translate chinese skystressrelief_daa1a426:

    # ao "I know you're here for your... friend..."
    ao "我知道你是来这里找你的……朋友的……"

# game/ch1ep4.rpy:2076
translate chinese skystressrelief_ca18b1e1:

    # m "He's not just a friend, he's my husband!"
    m "他不是什么朋友，他是我的丈夫！"

# game/ch1ep4.rpy:2077
translate chinese skystressrelief_e4524f0c:

    # ao "Oh... Well... I guess you already know..."
    ao "噢……好吧……看来你已经知道了……"

# game/ch1ep4.rpy:2078
translate chinese skystressrelief_ea764165:

    # m "Where is he?!"
    m "他在哪？！"

# game/ch1ep4.rpy:2079
translate chinese skystressrelief_abee9caa:

    # ao "Right now, he's being tortured for nothing... But that's all I can tell you..."
    ao "现在，他正被毫无目的地折磨着呢……不过我只能告诉你这么多了……"

# game/ch1ep4.rpy:2080
translate chinese skystressrelief_4856c0d8:

    # m "[mc]!"
    m "[mc!t]！"

# game/ch1ep4.rpy:2082
translate chinese skystressrelief_9f4cae7f_1:

    # m "Tsk!"
    m "啧！"

# game/ch1ep4.rpy:2083
translate chinese skystressrelief_7bac3bc6:

    # ao "I'm afraid I can't let you do that... Four..."
    ao "我可没法就这样放你走……四号……"

# game/ch1ep4.rpy:2084
translate chinese skystressrelief_cec8e99b:

    # m "What do you want from us?! Why join them?!"
    m "你到底有什么目的？！为什么要加入他们？！"

# game/ch1ep4.rpy:2085
translate chinese skystressrelief_1833e362:

    # ao "I wasn't choosing sides or anything... I joined them because of you..."
    ao "我没有支持任何一方的意思……我加入他们都是因为你……"

# game/ch1ep4.rpy:2086
translate chinese skystressrelief_989a3c3d:

    # ao "When I heard you were still alive, I took every chances I could get just to look for you..."
    ao "我听说你还活着之后，就用尽一切办法找你……"

# game/ch1ep4.rpy:2087
translate chinese skystressrelief_f8ac3724:

    # ao "And now, here we are..."
    ao "最后就变成了现在这样……"

# game/ch1ep4.rpy:2088
translate chinese skystressrelief_0ffcc3a4:

    # ao "I have no interest in him, or in any benefits from the creator's organization..."
    ao "我对他没有兴趣，对制造血清的人的组织给的好处也没有兴趣……"

# game/ch1ep4.rpy:2089
translate chinese skystressrelief_1a21824e:

    # ao "My focus is solely on you... and ending your life..."
    ao "我唯一想做的事……就是杀了你……"

# game/ch1ep4.rpy:2090
translate chinese skystressrelief_170e8d1a:

    # m "... Then let's settle it here."
    m "……那就在这里让一切结束吧。"

# game/ch1ep4.rpy:2091
translate chinese skystressrelief_aae5815a:

    # ao "Our pasts no longer matter... Right now, this is a fight between vengeance..."
    ao "我们的过去已经无关紧要了……现在，这是复仇者之间的战斗……"

# game/ch1ep4.rpy:2092
translate chinese skystressrelief_167b8119:

    # m "You sure talk too much for a mouthless bitch."
    m "你个哑巴婊子，话还挺多啊。"

# game/ch1ep4.rpy:2093
translate chinese skystressrelief_b56f84fc:

    # ao "Only when I choose to open up... But you know, I really hate that word..."
    ao "只有在我愿意的时候才会这样……不过，我真的很讨厌那个词……"

# game/ch1ep4.rpy:2094
translate chinese skystressrelief_10a7fd5e:

    # m "See if I care."
    m "关我屁事。"

# game/ch1ep4.rpy:2095
translate chinese skystressrelief_3864a381_5:

    # ao "..."
    ao "……"

# game/ch1ep4.rpy:2096
translate chinese skystressrelief_e612037c_24:

    # m "..."
    m "……"

# game/ch1ep4.rpy:2106
translate chinese skystressrelief_9f4cae7f_2:

    # m "Tsk!"
    m "啧！"

# game/ch1ep4.rpy:2107
translate chinese skystressrelief_1063541a:

    # m "{i}I shouldn't have done that!"
    m "{i}我不该踢开她的！"

# game/ch1ep4.rpy:2108
translate chinese skystressrelief_0d9e0f6f:

    # m "{i}All I did was give her the distance she wants. But if I hadn't, her knife would've pierced my neck."
    m "{i}这样反而如她所愿，拉开了距离。但要是不踢开她，她的刀就要扎穿我的脖子了。"

# game/ch1ep4.rpy:2109
translate chinese skystressrelief_6af8f7ee:

    # m "{i}So she trained herself with knives to counter close-quarters combat. She doesn't have an opening now..."
    m "{i}原来她为了应对近身战，学会了用刀啊。她现在没有弱点了……"

# game/ch1ep4.rpy:2110
translate chinese skystressrelief_d129b286:

    # m "{i}Regardless, I have no way to counter her bullets. My best chance is still up close. I have to keep the distance tight."
    m "{i}不管怎么说，我都不可能躲过她的子弹。最好的办法依然是近身。我得靠近她。"

# game/ch1ep4.rpy:2111
translate chinese skystressrelief_3165e946:

    # ao "Hearing your tongue clicks is still so satisfying... just like old times..."
    ao "听到你咂嘴依然让我很满足啊……就和以前一样……"

# game/ch1ep4.rpy:2112
translate chinese skystressrelief_10da8e30:

    # ao "We were created with specific abilities, but that doesn't mean we can't learn new ones..."
    ao "我们被创造出来的时候各有不同的专长，但这不代表我们不能学新的本领……"

# game/ch1ep4.rpy:2113
translate chinese skystressrelief_d90cf785:

    # m "You're right..."
    m "说得对……"

# game/ch1ep4.rpy:2114
translate chinese skystressrelief_8aabf478:

    # m "So let's see how this goes."
    m "那就让我看看你的新本领吧。"

# game/ch1ep4.rpy:2115
translate chinese skystressrelief_3864a381_6:

    # ao "..."
    ao "……"

# game/ch1ep4.rpy:2116
translate chinese skystressrelief_f859bd78:

    # ao "Trying something new, huh? Throwing away your only defense against me..."
    ao "要耍新的把戏吗？居然在我面前丢掉你唯一的防御手段……"

# game/ch1ep4.rpy:2117
translate chinese skystressrelief_ca817d39:

    # ao "I take that as an insult..."
    ao "这是对我的侮辱……"

# game/ch1ep4.rpy:2119
translate chinese skystressrelief_aa263f7a:

    # ao "{i}She didn't lose her speed; in fact, she's..."
    ao "{i}她没有失去她的速度；应该说，她……"

# game/ch1ep4.rpy:2120
translate chinese skystressrelief_caef30ed:

    # ao "{i}Much faster...!"
    ao "{i}比以前快得多了……！"

# game/ch1ep4.rpy:2124
translate chinese skystressrelief_c6649d31:

    # m "You can't keep avoiding me, Aoife!"
    m "你不可能一直躲下去，艾法！"

# game/ch1ep4.rpy:2125
translate chinese skystressrelief_11fd7c12:

    # ao "I don't have to. I just need one clear shot..."
    ao "也没有那个必要。我只需要一枪……"

# game/ch1ep4.rpy:2128
translate chinese skystressrelief_2f8c99be:

    # m "Ngh! Is that all you've got?!"
    m "嗯啊！你就这点本事？！"

# game/ch1ep4.rpy:2132
translate chinese skystressrelief_7dc545de:

    # ao "Agh...! Damn you, Four...!"
    ao "啊……！去死吧，四号……！"

# game/ch1ep4.rpy:2138
translate chinese skystressrelief_6ea56784:

    # m "It's over, Aoife! Yield!"
    m "结束了，艾法！投降吧！"

# game/ch1ep4.rpy:2139
translate chinese skystressrelief_d6c986a4:

    # ao "Never...!"
    ao "不可能……！"

# game/ch1ep4.rpy:2141
translate chinese skystressrelief_3c64e3fe:

    # m "It's over, Aoife!"
    m "结束了，艾法！"

# game/ch1ep4.rpy:2142
translate chinese skystressrelief_cf6f3953:

    # ao "Not yet...!"
    ao "还早着呢……！"

# game/ch1ep4.rpy:2147
translate chinese skystressrelief_dee7ba5b:

    # ao "Goodbye, Four..."
    ao "再见了，四号……"

# game/ch1ep4.rpy:2150
translate chinese skystressrelief_660fbaff:

    # m "No... Goodbye, Aoife..."
    m "不……再见，艾法……"

# game/ch1ep4.rpy:2153
translate chinese skystressrelief_64b65bab:

    # ao "... You win, Four... Finish it..."
    ao "……你赢了，四号……动手吧……"

# game/ch1ep4.rpy:2154
translate chinese skystressrelief_7bb9142c:

    # m "Any last words?"
    m "有什么遗言吗？"

# game/ch1ep4.rpy:2155
translate chinese skystressrelief_4877084f:

    # ao "Not much left to say, but... I'll say the words I couldn't tell you back then..."
    ao "没什么要说的，不过……我就把当初没能告诉你的话说出来吧……"

# game/ch1ep4.rpy:2156
translate chinese skystressrelief_c3c503af:

    # ao "... Thank you... for giving me my name..."
    ao "……谢谢你……给了我这个名字……"

# game/ch1ep4.rpy:2157
translate chinese skystressrelief_29a4f6ab_3:

    # m "!!!"
    m "！！！"

# game/ch1ep4.rpy:2160
translate chinese skystressrelief_7b6df27a:

    # eg "Huh? Give each other names? Where did you get that idea?"
    eg "啊？互相起名字？怎么突然说这个？"

# game/ch1ep4.rpy:2161
translate chinese skystressrelief_1704bfa9:

    # si "Hey, it's not my fault we woke up without names! The others did it too, you know?"
    si "毕竟我们全都没有名字啊！其他人都已经起完名字了。"

# game/ch1ep4.rpy:2162
translate chinese skystressrelief_b0f7373e:

    # m "We do have names."
    m "我们实际上是有名字的。"

# game/ch1ep4.rpy:2163
translate chinese skystressrelief_40f9700b:

    # si "Yeah, but... didn't they erase our past identities?"
    si "这倒是，不过……他们不是把我们过去的身份都抹除了吗？"

# game/ch1ep4.rpy:2164
translate chinese skystressrelief_2806cede:

    # si "Besides, I don't really want to call you guys by your numbers outside the battlefield!"
    si "而且，我可不想在战场以外的地方也用编号喊你们！"

# game/ch1ep4.rpy:2165
translate chinese skystressrelief_764cc1c1:

    # eg "It makes sense, but I don't want anyone giving me names. I'll choose my own."
    eg "可以是可以，不过我不想让别人给我起名。我要自己起一个。"

# game/ch1ep4.rpy:2166
translate chinese skystressrelief_02309aab:

    # eg "Starting today, I'll go by \"Enigma\"!"
    eg "从今往后，我就叫“伊尼格玛”！（译注：原文Enigma，意为谜团。）"

# game/ch1ep4.rpy:2167
translate chinese skystressrelief_f8f5ff99:

    # si "... Are you crazy?"
    si "……你疯了？"

# game/ch1ep4.rpy:2168
translate chinese skystressrelief_01b65181:

    # eg "What? You don't like it?"
    eg "怎么？你不喜欢？"

# game/ch1ep4.rpy:2169
translate chinese skystressrelief_0756197b:

    # si "Come on, be serious! At least give yourself a proper name!"
    si "拜托，认真点！至少起个正常的名字吧！"

# game/ch1ep4.rpy:2170
translate chinese skystressrelief_87a671c7:

    # er "... How about \"Erma\"? It's pretty close to Enigma."
    er "……那“伊尔玛”怎么样？跟伊尼格玛还挺接近的。"

# game/ch1ep4.rpy:2171
translate chinese skystressrelief_e857974e:

    # si "There you go! Was that so hard?"
    si "这不就行了嘛！起个名字有那么难吗？"

# game/ch1ep4.rpy:2172
translate chinese skystressrelief_38b2cd43:

    # er "Are you calling me dumb?!"
    er "你是说我傻吗？！"

# game/ch1ep4.rpy:2173
translate chinese skystressrelief_9de695b3:

    # si "Hey, nice to meet you, Erma."
    si "嘿，很高兴认识你，伊尔玛。"

# game/ch1ep4.rpy:2174
translate chinese skystressrelief_f4fdaee1:

    # er "..."
    er "……"

# game/ch1ep4.rpy:2175
translate chinese skystressrelief_2c8ae7f7:

    # er "... Nice to meet you too."
    er "……我也很高兴认识你。"

# game/ch1ep4.rpy:2176
translate chinese skystressrelief_9f3877f8:

    # si "Hmm, how about me, though? I've been thinking about it, but I couldn't come up with one."
    si "嗯，那我呢？我想了很久，但是想不出来。"

# game/ch1ep4.rpy:2177
translate chinese skystressrelief_52915cda:

    # er "How about \"Lumi\"? It is derived from the word \"lumen\", which means light."
    er "“卢米”怎么样？是“lumen”这个词的变种，意思是光。"

# game/ch1ep4.rpy:2178
translate chinese skystressrelief_aa880464:

    # er "You're not the calm, tranquil type, but your presence always brings everyone smiles."
    er "你不是冷静、内敛的人，不过你的存在总能给其他人带来笑容。"

# game/ch1ep4.rpy:2179
translate chinese skystressrelief_5948a5ec:

    # lu "*gasps* So you do love me~?"
    lu "*惊讶* 原来你还是爱我的啊~？"

# game/ch1ep4.rpy:2180
translate chinese skystressrelief_1ca7084e:

    # er "Get out of my face!"
    er "离我远点！"

# game/ch1ep4.rpy:2181
translate chinese skystressrelief_97f4663b:

    # lu "Whooops!"
    lu "哎呀，疼！"

# game/ch1ep4.rpy:2182
translate chinese skystressrelief_8046ab06:

    # two "..."
    two "……"

# game/ch1ep4.rpy:2183
translate chinese skystressrelief_487a1850_2:

    # m "Hm?"
    m "嗯？"

# game/ch1ep4.rpy:2184
translate chinese skystressrelief_60ec0e83:

    # lu "Now it's your turn!"
    lu "轮到你啦！"

# game/ch1ep4.rpy:2185
translate chinese skystressrelief_e8565b82:

    # m "Me?"
    m "我？"

# game/ch1ep4.rpy:2186
translate chinese skystressrelief_e99725c8:

    # lu "Yeah! Want to choose a name for yourself, Four?"
    lu "是啊！要给自己起个名字吗，四号？"

# game/ch1ep4.rpy:2187
translate chinese skystressrelief_710a1a1e:

    # m "I don't know. I'm not sure I want one."
    m "不知道。我感觉我用不上名字。"

# game/ch1ep4.rpy:2188
translate chinese skystressrelief_c15cc7d6:

    # lu "..."
    lu "……"

# game/ch1ep4.rpy:2189
translate chinese skystressrelief_c15cc7d6_1:

    # lu "..."
    lu "……"

# game/ch1ep4.rpy:2190
translate chinese skystressrelief_53b8500a:

    # lu "... Moon."
    lu "……月。"

# game/ch1ep4.rpy:2191
translate chinese skystressrelief_fd4b9f40:

    # m "Moon? Why?"
    m "月？为什么？"

# game/ch1ep4.rpy:2192
translate chinese skystressrelief_c2436dc6:

    # lu "Because you don't have an Odd."
    lu "因为你没有奇数。"

# game/ch1ep4.rpy:2193
translate chinese skystressrelief_99293691:

    # er "Hey!"
    er "喂！"

# game/ch1ep4.rpy:2194
translate chinese skystressrelief_c87fb0de:

    # lu "I'm not insulting her!"
    lu "我不是在说她坏话！"

# game/ch1ep4.rpy:2195
translate chinese skystressrelief_9d1eede9:

    # lu "But you know, the moon is a solitary sentinel, always hangs alone in the night sky. Independet of the twinkling stars that keep it company."
    lu "因为月亮是个孤独的哨兵，总是孤零零地挂在天上。跟宇宙里其他闪闪发光的星星都没有关系。"

# game/ch1ep4.rpy:2196
translate chinese skystressrelief_09f01ec1:

    # lu "Right now, you're a lightless moon, but one day, you will eventually find your sun that will make you shine. I really believe in that."
    lu "现在，你还是一个不会发光的月亮，但是总有一天，你会找到能让你闪亮的太阳的。一定会的。"

# game/ch1ep4.rpy:2197
translate chinese skystressrelief_e612037c_25:

    # m "..."
    m "……"

# game/ch1ep4.rpy:2198
translate chinese skystressrelief_f45b1836:

    # m "Okay. I like it."
    m "好吧。我喜欢这个名字。"

# game/ch1ep4.rpy:2199
translate chinese skystressrelief_d21440be:

    # lu "Hm-hmmm!"
    lu "哼哼！"

# game/ch1ep4.rpy:2200
translate chinese skystressrelief_c7e6a272:

    # er "I'll never understand your sense pride."
    er "我永远也理解不了你这莫名其妙的骄傲是哪来的。"

# game/ch1ep4.rpy:2201
translate chinese skystressrelief_b037d1cb:

    # lu "And lastly, Two-"
    lu "那还有最后一个，二号——"

# game/ch1ep4.rpy:2202
translate chinese skystressrelief_f3457243:

    # m "Aoife."
    m "艾法。"

# game/ch1ep4.rpy:2203
translate chinese skystressrelief_c668dd27:

    # ao "!!!"
    ao "！！！"

# game/ch1ep4.rpy:2204
translate chinese skystressrelief_7e0fd9e2:

    # lu "Huh?"
    lu "啊？"

# game/ch1ep4.rpy:2205
translate chinese skystressrelief_b555b63a:

    # m "Her name should be Aoife."
    m "就叫她艾法吧。"

# game/ch1ep4.rpy:2206
translate chinese skystressrelief_7e28dacc:

    # er "Care to explain?"
    er "能解释一下吗？"

# game/ch1ep4.rpy:2207
translate chinese skystressrelief_2c13689c:

    # m "Just because she's beautiful. More so than any of us."
    m "因为她很漂亮。比我们每个人都漂亮。（译注：Aoife这个名字是“美丽”的意思。）"

# game/ch1ep4.rpy:2208
translate chinese skystressrelief_40231f7f:

    # lu "Well, that's true! Shame she doesn't talk, though."
    lu "嗯，说得对！可惜她不会说话。"

# game/ch1ep4.rpy:2209
translate chinese skystressrelief_bbad83e0:

    # m "Do you like it?"
    m "你喜欢吗？"

# game/ch1ep4.rpy:2210
translate chinese skystressrelief_5c7d3be4:

    # ao "*nods*"
    ao "*点头*"

# game/ch1ep4.rpy:2211
translate chinese skystressrelief_55983ba6:

    # m "I'm glad."
    m "那就好。"

# game/ch1ep4.rpy:2213
translate chinese skystressrelief_f0139694:

    # m "Ah..."
    m "啊……"

# game/ch1ep4.rpy:2214
translate chinese skystressrelief_8524f5b3:

    # eg "She really liked it, huh?"
    eg "看来她真的很喜欢啊。"

# game/ch1ep4.rpy:2215
translate chinese skystressrelief_38afc600:

    # lu "I guess that's her way of saying thank you."
    lu "大概那就是她说谢谢你的方式吧。"

# game/ch1ep4.rpy:2219
translate chinese skystressrelief_b0d7e76a:

    # m "Hnngkk...! Khhhkkk...!"
    m "咕唔唔……！呜呜呜呜……！"

# game/ch1ep4.rpy:2220
translate chinese skystressrelief_06c064b6:

    # ao "... You're tired of fighting, aren't you...?"
    ao "……你已经厌倦战斗了，对吧……？"

# game/ch1ep4.rpy:2221
translate chinese skystressrelief_7f04677e:

    # m "*cracking voice* Y...Yes!"
    m "*声音发抖* 是……是啊……！"

# game/ch1ep4.rpy:2223
translate chinese skystressrelief_6f163653:

    # ao "Don't be afraid..."
    ao "不用害怕……"

# game/ch1ep4.rpy:2224
translate chinese skystressrelief_c20b07b3:

    # ao "When this is over, you'll have avenged Lumi and Erma, saved your partner... and I'll finally be reunited with One..."
    ao "只要动手，就能给卢米和伊尔玛报仇，救下你的爱人……我也终于能和一号团圆了……"

# game/ch1ep4.rpy:2225
translate chinese skystressrelief_9a883158:

    # ao "This is the end of the line for me, Moon... I don't have the will to live on, but I couldn't bring myself to end it..."
    ao "我的生命已经到此为止了，月……我根本不想继续活下去了，但是又做不到自我了结……"

# game/ch1ep4.rpy:2226
translate chinese skystressrelief_96357c22:

    # ao "If I'm to die, I'd rather it be by your hand..."
    ao "要死的话，我宁愿死在你的手里……"

# game/ch1ep4.rpy:2229
translate chinese skystressrelief_926f3362_1:

    # mc "I'm not saying you have to forgive her. But if there's a chance to stop the fighting, don't let it go."
    mc "我不是说让你原谅她。可是如果有机会结束战斗的话，就不要错过。"

# game/ch1ep4.rpy:2230
translate chinese skystressrelief_6fa08fc5_1:

    # mc "You have me now, Moon. Just think about that."
    mc "你现在有我了，月。仔细想想吧。"

# game/ch1ep4.rpy:2232
translate chinese skystressrelief_47ba7d94:

    # m "No."
    m "不。"

# game/ch1ep4.rpy:2234
translate chinese skystressrelief_02d10048:

    # ao "Why...?"
    ao "为什么……？"

# game/ch1ep4.rpy:2235
translate chinese skystressrelief_5688a464:

    # m "Sometimes, I wonder if this is really what Lumi, Erma, or even One would have wanted—us fighting over what's left of their memories. Over their long lifeless bodies."
    m "有时候我会想，这一切战斗，厮杀，为了他们留下的记忆，为了他们早就没了生命的尸体争个你死我活——这真的是卢米，伊尔玛，甚至是一号想要的吗？"

# game/ch1ep4.rpy:2236
translate chinese skystressrelief_102b9a98:

    # m "If I were to kill you, would they be proud and commend me for doing the right thing? If you killed me, are you sure One would appreciate it?"
    m "如果我杀了你，卢米和伊尔玛会感到骄傲，会夸奖我做了对的事吗？如果你杀了我，你确定一号会感激你吗？"

# game/ch1ep4.rpy:2237
translate chinese skystressrelief_3864a381_7:

    # ao "..."
    ao "……"

# game/ch1ep4.rpy:2238
translate chinese skystressrelief_97d42234:

    # m "Every year, we mourn for their deaths, the pain comes back."
    m "每一年，我们都为他们的死哀悼，与之相伴的痛苦也就阴魂不散。"

# game/ch1ep4.rpy:2239
translate chinese skystressrelief_e209b641:

    # m "Will it matter in the end? We are the ones still alive, not them. The choice is ours to make, not theirs."
    m "这样做到头来会有意义吗？他们已经不在了，只剩我们继续活着。做出选择的是我们，不是他们。"

# game/ch1ep4.rpy:2240
translate chinese skystressrelief_730b3344:

    # m "And if they could see us now, I'm sure Lumi and Erma will do everything to stop us."
    m "如果她们能看到这一切的话，我想卢米和伊尔玛一定会全力阻止我们的。"

# game/ch1ep4.rpy:2241
translate chinese skystressrelief_c60d00c3:

    # m "Right now, I'm devoted to one person, and I intend to be his and his alone."
    m "现在，我的心只属于一个人，我只想和他共度余生。"

# game/ch1ep4.rpy:2242
translate chinese skystressrelief_fe3d13ee:

    # m "I refuse to be chained by grievances, or to be forced to do something against my will, so I will choose for myself."
    m "我不想再被仇恨束缚，不想再被逼着做不想做的事。所以我要为我自己做出选择。"

# game/ch1ep4.rpy:2243
translate chinese skystressrelief_ed4974e2:

    # m "And I choose to stop the fighting."
    m "我选择让战斗到此为止。"

# game/ch1ep4.rpy:2244
translate chinese skystressrelief_63d9f2c2:

    # ao "You just can't help but bring up your husband, can you...?"
    ao "你就是非要提一嘴你老公啊……"

# game/ch1ep4.rpy:2245
translate chinese skystressrelief_0ed7e0f1:

    # m "He's all that matters to me now."
    m "他是我现在唯一在乎的人。"

# game/ch1ep4.rpy:2246
translate chinese skystressrelief_c3ee0001:

    # ao "He's #3, right...?"
    ao "他是三号，对吧……？"

# game/ch1ep4.rpy:2247
translate chinese skystressrelief_8cb62253_3:

    # m "Yes."
    m "对。"

# game/ch1ep4.rpy:2248
translate chinese skystressrelief_746a2c49:

    # ao "I see... I won't ask how that came to be..."
    ao "好吧……我就不问具体的情况了……"

# game/ch1ep4.rpy:2249
translate chinese skystressrelief_de682654:

    # m "In exchange for letting you live, find a person named Jess Agnor."
    m "我可以饶你一命，但你必须去找一个叫婕斯·阿格诺的人。"

# game/ch1ep4.rpy:2250
translate chinese skystressrelief_3a3f390b:

    # m "I was lost once, and she helped me find my footing again. If you have questions, she's the one you want to talk to."
    m "我曾经迷失过，是她帮我又找到了方向。如果你有问题，就去跟她聊聊吧。"

# game/ch1ep4.rpy:2251
translate chinese skystressrelief_d61772c7:

    # m "Find a purpose and live, just like I did. It's not the end yet, Aoife."
    m "跟我一样，找到活下去的意义吧。还没有到终点，艾法。"

# game/ch1ep4.rpy:2252
translate chinese skystressrelief_e92f3faa:

    # ao "What's your plan from here...?"
    ao "你接下来打算怎么办……？"

# game/ch1ep4.rpy:2253
translate chinese skystressrelief_1988c205:

    # m "Rescue my husband. I need any information you can give me."
    m "去救我的丈夫。我需要你把你知道的事情都告诉我。"

# game/ch1ep4.rpy:2254
translate chinese skystressrelief_a2509c17:

    # ao "Honestly, I don't know anything... But the creator is in his office..."
    ao "说实话，我什么都不知道……不过，血清的制造者就在他的办公室里……"

# game/ch1ep4.rpy:2255
translate chinese skystressrelief_52e08f31:

    # ao "When you reach the second floor, turn right... It should be the only room in that corridor..."
    ao "上二楼之后，右转……那条走廊里只有一个房间……"

# game/ch1ep4.rpy:2256
translate chinese skystressrelief_49cfd404:

    # ao "And... watch out for that Francis guy..."
    ao "还有……小心那个叫弗朗西斯的人……"

# game/ch1ep4.rpy:2257
translate chinese skystressrelief_86782f79:

    # m "Why?"
    m "为什么？"

# game/ch1ep4.rpy:2258
translate chinese skystressrelief_cbebb0d3:

    # ao "I'm not sure, but... he's got major issues..."
    ao "我也说不清楚，但是……他有大问题……"

# game/ch1ep4.rpy:2259
translate chinese skystressrelief_a122873f:

    # m "I'll keep that in mind."
    m "我会记住的。"

# game/ch1ep4.rpy:2260
translate chinese skystressrelief_692c0d3e:

    # ao "Good luck..."
    ao "祝你好运……"

# game/ch1ep4.rpy:2262
translate chinese skystressrelief_557d892f:

    # m "Khhhkkk...! C...close your eyes, Aoife..."
    m "咕唔唔唔……！把……把眼睛闭上，艾法……"

# game/ch1ep4.rpy:2263
translate chinese skystressrelief_6e377f20:

    # ao "Thank you..."
    ao "谢谢你……"

# game/ch1ep4.rpy:2264
translate chinese skystressrelief_90dcc0b4:

    # m "AAAAAAAHHHHH!!"
    m "啊啊啊啊啊啊啊！！"

# game/ch1ep4.rpy:2267
translate chinese skystressrelief_d6dfa478:

    # m "AAAAAAAAAAAAHHHHHHHHHH!!!"
    m "啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！！"

# game/ch1ep4.rpy:2274
translate chinese skystressrelief_00038c1d:

    # bo "A splendid fight. I must say, I'm thoroughly entertained. I'm glad to be alive to see my strongest creations clash."
    bo "非常精彩的战斗。实在是顶级的娱乐项目。很高兴能看到我最强的两个造物互相碰撞。"

# game/ch1ep4.rpy:2275
translate chinese skystressrelief_2ed67075:

    # m "... Entertainment. Is that all we are to you? Us Numbers and the people around you?"
    m "……娱乐……在你眼里，我们编号者，还有你身边的人，都只是娱乐而已吗？"

# game/ch1ep4.rpy:2276
translate chinese skystressrelief_64ed4f3d:

    # bo "Not entirely."
    bo "不完全是。"

# game/ch1ep4.rpy:2277
translate chinese skystressrelief_7449a643:

    # bo "The Chimera Genesis Project began with noble intentions, albeit for my own benefit."
    bo "嵌合体创生计划在设立之初，尽管是为了我个人的利益，但也有着高尚的目的。"

# game/ch1ep4.rpy:2278
translate chinese skystressrelief_b7f6b27e:

    # bo "When the war between Sha Crea and Glabia erupted, my family was among those poor souls who did not survive."
    bo "沙克雷亚和格拉比亚的战争爆发之后，我的家人惨遭毒手。"

# game/ch1ep4.rpy:2279
translate chinese skystressrelief_869d676c:

    # bo "I was young and couldn't face the reality, so I sought knowledge that was beyond anyone's imagination."
    bo "我当时还年轻，没法接受，于是就去寻求远超常人想象的知识。"

# game/ch1ep4.rpy:2280
translate chinese skystressrelief_10a77127:

    # bo "Reviving the dead seemed like an impossible dream. Yet, I never ceased my pursuit."
    bo "起死回生似乎是永远无法实现的妄想。不过，我从来没有停下脚步。"

# game/ch1ep4.rpy:2281
translate chinese skystressrelief_8e31bff8:

    # bo "Perhaps I reached a point where I was willing to give up everything, even my soul, to acquire the power to reverse fate."
    bo "可以说我当时甘愿为了获得逆天改命的力量放弃一切，哪怕是我自己的灵魂。"

# game/ch1ep4.rpy:2282
translate chinese skystressrelief_cb876129:

    # bo "And so, I did..."
    bo "所以，我成功了……"

# game/ch1ep4.rpy:2283
translate chinese skystressrelief_39c83d03:

    # m "So your goal really was to revive the dead."
    m "原来你的目标确实是复活死人。"

# game/ch1ep4.rpy:2284
translate chinese skystressrelief_6c33890d:

    # bo "With the power of science, I managed to bring my family back. But they were no longer the people I once loved."
    bo "凭借科学的力量，我真的让我的家人复活了。但是他们已经不是我曾经爱着的人了。"

# game/ch1ep4.rpy:2285
translate chinese skystressrelief_3884116c:

    # bo "I thought they could harness another's consciousness as their own, but their minds were unstable, and I couldn't control them."
    bo "我以为他们能掌控体内另一个人的意识，然而他们的心理状态过于不稳定，我无法控制。"

# game/ch1ep4.rpy:2286
translate chinese skystressrelief_1945855d:

    # bo "I had no choice but to end their lives once more."
    bo "我别无选择，只能再次结束他们的生命。"

# game/ch1ep4.rpy:2287
translate chinese skystressrelief_e612037c_26:

    # m "..."
    m "……"

# game/ch1ep4.rpy:2288
translate chinese skystressrelief_1ae3f70b:

    # bo "However, the potential of my discovery was undeniable."
    bo "不过，我的成果依然有着难以否认的潜力。"

# game/ch1ep4.rpy:2289
translate chinese skystressrelief_e245dbff:

    # bo "The power to grant strength, heal the wounded, cure any disease, to perform miracles... Do you know what we call that?"
    bo "这种能让人力大无穷，让伤口愈合，包治百病的力量……这种实现奇迹的力量……你知道人们会怎么形容吗？"

# game/ch1ep4.rpy:2290
translate chinese skystressrelief_926faa32:

    # bo "A God."
    bo "是神啊。"

# game/ch1ep4.rpy:2291
translate chinese skystressrelief_e3a361f7:

    # bo "I joined the military of Glabia, offering them this power, which they eagerly accepted."
    bo "我加入了格拉比亚的军队，向他们提供这项技术，他们欣然接受了。"

# game/ch1ep4.rpy:2292
translate chinese skystressrelief_5a4112a8:

    # bo "I searched every corner of the world for individuals with remarkable histories."
    bo "我走遍了全世界，寻找青史留名的伟大人物。"

# game/ch1ep4.rpy:2293
translate chinese skystressrelief_96dbb66b:

    # bo "And so, I made those individuals fight my battles... That's how you \"Numbers\" came to be."
    bo "然后，我让那些人为我而战……这也就是你们“编号者”的来源。"

# game/ch1ep4.rpy:2294
translate chinese skystressrelief_1fdd60c7:

    # m "... Why did you separate me from my Odd?"
    m "……为什么你要让我和我的奇数分开？"

# game/ch1ep4.rpy:2295
translate chinese skystressrelief_7b646def:

    # bo "Ahh... Emperor Kaito and Lady Sora. A truly facinating piece of history."
    bo "啊……海人皇帝和空姬。历史上的一段佳话。"

# game/ch1ep4.rpy:2296
translate chinese skystressrelief_1963026d:

    # bo "Not just any history, but a love story that marked the world for generations."
    bo "他们之间的爱情故事在全世界都代代相传呢。"

# game/ch1ep4.rpy:2297
translate chinese skystressrelief_668a691a:

    # bo "Out of all my experiments, you two are the pinnacle. So much so that I'd say..."
    bo "在我所有的实验里，你们两个是顶峰。我甚至可以说……"

# game/ch1ep4.rpy:2298
translate chinese skystressrelief_a52e007b:

    # bo "... You are my masterpieces. With your love for each other, nothing could ever tear you apart."
    bo "……你们是我最棒的杰作。你们之间的爱是任何东西都无法拆散的。"

# game/ch1ep4.rpy:2299
translate chinese skystressrelief_139fecde:

    # bo "But on the battlefield, your connection could become a liability."
    bo "但是在战场上，这就未必是一件好事了。"

# game/ch1ep4.rpy:2300
translate chinese skystressrelief_8099ed41:

    # bo "Considering how Kaito protected Sora, I knew Sora would never allow that to happen again. Disrupting the patterns of your creation."
    bo "海人是为保护空而死，我知道空绝对不会允许这种事再次发生。这就违背了你们的设计目的。"

# game/ch1ep4.rpy:2301
translate chinese skystressrelief_bb923ff7:

    # m "Patterns?"
    m "目的？"

# game/ch1ep4.rpy:2302
translate chinese skystressrelief_b570bdc5:

    # bo "I designed the Odds to protect the Evens. It's their destiny to die for this cause."
    bo "奇数被设计出来的目的就是保护偶数。他们每个人都注定为此而死。"

# game/ch1ep4.rpy:2303
translate chinese skystressrelief_09008768:

    # bo "That's how they were created, and that's the purpose of their existence."
    bo "这是他们被创造出来的原因，是他们存在的意义。"

# game/ch1ep4.rpy:2304
translate chinese skystressrelief_0c99eb47:

    # bo "In sacrificing his life, One saved Two from the fire you caused."
    bo "一号为了救二号，死在了那场你引发的大火里。"

# game/ch1ep4.rpy:2305
translate chinese skystressrelief_2535e416:

    # bo "Five and Seven did the same for Six and Eight. All to protect them."
    bo "五号和七号也为六号和八号做了同样的事。都是为了保护她们。"

# game/ch1ep4.rpy:2306
translate chinese skystressrelief_2bdf81ee:

    # bo "[mc] deliberately planned this and made Francis dance in his palm. All to discover our location. To end this once and for all."
    bo "[mc!t]故意策划了今天的事，把弗朗西斯耍得团团转。都是为了找到我们的藏身处。为了一次性地解决一切。"

# game/ch1ep4.rpy:2307
translate chinese skystressrelief_79e5141a:

    # bo "I aknowledge his strong will to pull this off, but he will die for you in exchange for all this information, Moon Chi. There's no escaping that fate."
    bo "我钦佩他能够做到这些事的坚强意志，但作为代价，他会为你而死，气月。这是他无法逃脱的命运。"

# game/ch1ep4.rpy:2308
translate chinese skystressrelief_a1db4f28:

    # m "All this... just for..."
    m "这全都……是为了……"

# game/ch1ep4.rpy:2309
translate chinese skystressrelief_a75a29b8:

    # m "{i}I knew your plan was too convenient for me to believe. So all that was just to put our minds at ease?"
    m "{i}我就知道你的计划太过想当然了。原来那都只是为了让我们安心而已？"

# game/ch1ep4.rpy:2311
translate chinese skystressrelief_4972e2d5:

    # mc "Yeah, I'm going to be fine."
    mc "嗯。我不会有事的。"

# game/ch1ep4.rpy:2313
translate chinese skystressrelief_01ed53e9:

    # m "{i}Tsk! You're a liar, Commander..."
    m "{i}你这个骗子，指挥官……"

# game/ch1ep4.rpy:2314
translate chinese skystressrelief_abc52c93:

    # bo "Now then, what will you do? Should you entertain me-"
    bo "好了，你打算怎么办？你要满足我——"

# game/ch1ep4.rpy:2317
translate chinese skystressrelief_918c39c2:

    # m "I couldn't care less about you and your damn sob story."
    m "我根本不在乎你和你那悲惨的破故事。"

# game/ch1ep4.rpy:2318
translate chinese skystressrelief_9de3692a:

    # m "What you've told me isn't enough, and killing you would be a mercy. Instead, I'm going to take you into Sicae's custody."
    m "你还有太多东西没交代清楚，杀了你都算是便宜你了。我要把你带回西卡关起来。"

# game/ch1ep4.rpy:2319
translate chinese skystressrelief_b483821f:

    # bo "You think you can—"
    bo "你以为你能——"

# game/ch1ep4.rpy:2321
translate chinese skystressrelief_bdd3ba4b:

    # bo "GAAAAAAAHHKKK!!!"
    bo "啊啊啊啊啊啊啊啊！！！"

# game/ch1ep4.rpy:2322
translate chinese skystressrelief_2eec0ffe:

    # m "These hands have toyed with our fates, our lives..."
    m "就是这双手玩弄了我们的命运，我们的生活……"

# game/ch1ep4.rpy:2323
translate chinese skystressrelief_aea557c0:

    # m "What's left is your brain, but I see no way to strip all that knowledge from you without killing you."
    m "剩下的就是你的脑子，但我觉得除非杀了你，不然没办法把你脑子里的知识全给挤出来。"

# game/ch1ep4.rpy:2324
translate chinese skystressrelief_e9c4607d:

    # m "However, I'll make sure you lose your sanity."
    m "不过呢，我保证，我一定会把你折磨得痛不欲生的。"

# game/ch1ep4.rpy:2325
translate chinese skystressrelief_abebeb46:

    # m "And don't worry, you'll find it far more enjoyable than anything the depths of hell could offer you."
    m "也不用太担心，我们那的待遇可比地狱里好多了。"

# game/ch1ep4.rpy:2326
translate chinese skystressrelief_1c11427d:

    # bo "*pained chuckle* You'll never be his savior, Moon Chi—no, Lady Sora!"
    bo "*痛苦地笑* 你永远也救不了他，气月——不，空姬！"

# game/ch1ep4.rpy:2327
translate chinese skystressrelief_1efc9640:

    # m "I never intended to be."
    m "我也不打算救。"

# game/ch1ep4.rpy:2328
translate chinese skystressrelief_5cc07c28:

    # m "[mc] is the one who forgives, and I thought I'd be the one to bear his sins."
    m "[mc!t]才是愿意原谅别人的人，我本来想着我就负责背负他的罪过。"

# game/ch1ep4.rpy:2329
translate chinese skystressrelief_1b600c3e:

    # m "But that will change today, now that you made him experience what true hell is like."
    m "不过今天不一样了，因为你让他体会到了真正的地狱。"

# game/ch1ep4.rpy:2330
translate chinese skystressrelief_12ed6996:

    # bo "You...! Lady Soraaaaaa!"
    bo "你……！空姬啊啊啊啊啊啊啊！！"

# game/ch1ep4.rpy:2331
translate chinese skystressrelief_b932b3af:

    # m "So, where's your God now?"
    m "现在不扯什么神的力量了？"

# game/ch1ep4.rpy:2332
translate chinese skystressrelief_45380749:

    # bo "Khhkk!"
    bo "咕啊啊啊啊！！"

# game/ch1ep4.rpy:2333
translate chinese skystressrelief_29a4f6ab_4:

    # m "!!!"
    m "！！！"

# game/ch1ep4.rpy:2334
translate chinese skystressrelief_54123ad2:

    # m "C...Commander?!"
    m "指……指挥官？！"

# game/ch1ep4.rpy:2335
translate chinese skystressrelief_ee5e5b02:

    # bo "*pained chuckle* It's finally happened. He should be dead by now! I told you, there's no escaping his fate!"
    bo "*痛苦地笑* 终于来了。他死了！我都说了，这是他逃不过的宿命！"

# game/ch1ep4.rpy:2342
translate chinese skystressrelief_c4508cbe:

    # mc "*huff*... *huff*..."
    mc "*喘气*…… *喘气*……"

# game/ch1ep4.rpy:2344
translate chinese skystressrelief_6e63e323:

    # mal "Ah, [mc]. Looking rather worse for wear, I see."
    mal "啊，[mc!t]。看起来状态不太好呀。"

# game/ch1ep4.rpy:2345
translate chinese skystressrelief_d87e06d2:

    # mal "But cheer up, I have news that will... pique your interest."
    mal "开心点，我给你带来了……你可能会感兴趣的消息。"

# game/ch1ep4.rpy:2346
translate chinese skystressrelief_c4508cbe_1:

    # mc "*huff*... *huff*..."
    mc "*喘气*…… *喘气*……"

# game/ch1ep4.rpy:2347
translate chinese skystressrelief_b329e67a:

    # mal "You see, it seems your precious little girlfriend has decided to play the hero."
    mal "你的小女朋友来当英雄了。"

# game/ch1ep4.rpy:2348
translate chinese skystressrelief_7559c7f8:

    # mal "She's fighting her way through Bonheur's men as we speak, trying to save you."
    mal "她现在就正在外面跟博纳尔的手下大战，想来救你呢。"

# game/ch1ep4.rpy:2349
translate chinese skystressrelief_6c0efa87_1:

    # mc "Moon..."
    mc "月……"

# game/ch1ep4.rpy:2350
translate chinese skystressrelief_2ed80a73:

    # mal "It's quite the spectacle. Her futile efforts, all for you, knowing well it's all in vain."
    mal "打得真激烈呐。她明知道一切都是徒劳，还是为了你在拼尽全力呢。"

# game/ch1ep4.rpy:2351
translate chinese skystressrelief_e6066bd4:

    # mc "You bastard... if you lay a hand on her, I'll..."
    mc "你个混蛋……你要是敢碰她，我就……"

# game/ch1ep4.rpy:2352
translate chinese skystressrelief_fbea3d2c:

    # mal "You'll what? You can barely keep yourself conscious, let alone fight back."
    mal "你就怎么样？你现在连保持清醒都困难，更别说还手了。"

# game/ch1ep4.rpy:2353
translate chinese skystressrelief_9eace5cf:

    # mal "Worry not. I don't plan to harm her... not immediately, anyway."
    mal "不用担心。我不打算伤害她……至少不是现在。"

# game/ch1ep4.rpy:2354
translate chinese skystressrelief_489952d3:

    # mal "In fact, I've got special plans for when we capture her."
    mal "等抓住她之后，我可是给她做了特别的安排。"

# game/ch1ep4.rpy:2355
translate chinese skystressrelief_3405681d:

    # mal "I'll take my time with her, make her scream in ways you never could. And you'll have a front-row seat to the whole show."
    mal "我要好好跟她玩玩，让她发出你永远不可能发出的尖叫。到时候你还会在第一排看整场表演哦。"

# game/ch1ep4.rpy:2356
translate chinese skystressrelief_d7da65d4:

    # mc "No... Moon... I won't let you touch her!"
    mc "不……月……我不会让你碰她的！"

# game/ch1ep4.rpy:2358
translate chinese skystressrelief_c1751ff3:

    # mal "Ah, there's that spirit! That fire, that anger. I was wondering if I'd see any fight left in you."
    mal "啊，就是这样！就是这种熊熊燃烧的怒火。我还以为我再也看不见你的反抗了呢。"

# game/ch1ep4.rpy:2359
translate chinese skystressrelief_42802a5e:

    # mal "But it's pointless, [mc]. You can't save her, much less yourself."
    mal "不过没用的，[mc!t]。你救不了她，更救不了你自己。"

# game/ch1ep4.rpy:2360
translate chinese skystressrelief_78523e52:

    # mal "All you can do is sit there and watch as I break her, piece by piece."
    mal "你只能在旁边看着我一点点地搞坏她。"

# game/ch1ep4.rpy:2361
translate chinese skystressrelief_7f730731:

    # mc "I'll kill you... I swear, I'll rip you apart with my bare hands..."
    mc "我要杀了你……我发誓，我会亲手把你撕碎……"

# game/ch1ep4.rpy:2362
translate chinese skystressrelief_cd95f9f7:

    # mal "Big words from a man who can't even stand. But by all means, keep struggling. It makes victory all the sweeter."
    mal "连站都站不起来，还真敢说啊。不过请便，继续挣扎吧。只会让最终的胜利更加甜美。"

# game/ch1ep4.rpy:2363
translate chinese skystressrelief_4166c172:

    # mal "And when she's finally broken, she'll know just how much of a failure you are."
    mal "等她终于坏掉之后，她就会明白你到底有多无能了。"

# game/ch1ep4.rpy:2364
translate chinese skystressrelief_7c40f402:

    # mal "How you couldn't protect her, couldn't save her from what awaits her."
    mal "你没法保护她，没法拯救她免遭厄运。"

# game/ch1ep4.rpy:2365
translate chinese skystressrelief_e612037c_27:

    # m "..."
    m "……"

# game/ch1ep4.rpy:2366
translate chinese skystressrelief_a922b43a:

    # mal "She's a virgin, isn't she? I could tell from a glance."
    mal "她还是处女，对吧？我一眼就能看出来。"

# game/ch1ep4.rpy:2367
translate chinese skystressrelief_ca1929be:

    # mal "*laughs* Oh man... I'm going to enjoy my time with her!"
    mal "*大笑* 天啊……那我要玩得超级开心了！"

# game/ch1ep4.rpy:2368
translate chinese skystressrelief_a4d1305b:

    # mal "And you... will watch every single second of me exploring the depths of her!"
    mal "而你呢……就好好看着我慢慢享用她的身体吧！"

# game/ch1ep4.rpy:2370
translate chinese skystressrelief_a15d334c:

    # mc "Hey..."
    mc "过来一下……"

# game/ch1ep4.rpy:2371
translate chinese skystressrelief_23d973cd:

    # mal "Hm? Wanna say your last words, eh? Okay, I'm listening."
    mal "嗯？要说遗言吗？好啊，我洗耳恭听。"

# game/ch1ep4.rpy:2372
translate chinese skystressrelief_bb344dab:

    # mc "You forgot one thing... my legs aren't tied."
    mc "你是不是忘了……我的腿没被绑起来？"

# game/ch1ep4.rpy:2373
translate chinese skystressrelief_1974cc4f:

    # mal "Huh?"
    mal "啊？"

# game/ch1ep4.rpy:2381
translate chinese skystressrelief_a054f3c6:

    # mal "W-what are you?!"
    mal "你-你是什么怪物啊？！"

# game/ch1ep4.rpy:2382
translate chinese skystressrelief_644a6adc:

    # m "What am I? Sounds something I could answer..."
    m "什么怪物？这我倒可以回答你……"

# game/ch1ep4.rpy:2383
translate chinese skystressrelief_1f295b92:

    # mal "W-wait! Hold on! Let's talk about this!"
    mal "等-等等！等一下！我们聊几句好吗！"

# game/ch1ep4.rpy:2384
translate chinese skystressrelief_16bb0263:

    # mc "Talk? You want to talk now, you piece of shit...?"
    mc "聊？你个狗杂种，现在想聊了……？"

# game/ch1ep4.rpy:2385
translate chinese skystressrelief_1059332e:

    # mal "P-please! I was just following orders! None of it was personal!"
    mal "求-求你了！我只是在执行命令！我跟你没有私仇啊！"

# game/ch1ep4.rpy:2386
translate chinese skystressrelief_9df7e511:

    # mc "Not personal? You threatened to assault my wife, now you're pleading for your life...?"
    mc "没有私仇？你放话说要搞我老婆，现在又求饶说没有私仇了……？"

# game/ch1ep4.rpy:2387
translate chinese skystressrelief_2cf6745b:

    # mc "We were smooth sailing back there, but you know, I don't take any threats to my girls so kindly..."
    mc "之前的事都只是小打小闹，不过呢，敢威胁我的女人，那我可不会随便就算了……"

# game/ch1ep4.rpy:2388
translate chinese skystressrelief_32e2e793:

    # mal "I-I'm sorry! I won't touch her, I swear! Just let me go!"
    mal "对-对不起！我绝对不会碰她的，我发誓！求你放了我吧！"

# game/ch1ep4.rpy:2389
translate chinese skystressrelief_cfc3a096:

    # mc "Let you go...? After everything you've done...? After all the pain you've given me...?"
    mc "放了你……？你把我折磨成那个样子，还觉得我会放了你……？"

# game/ch1ep4.rpy:2390
translate chinese skystressrelief_77d0de6c:

    # mal "I'll do anything! I'll tell you where Bonheur is! I'll help you save her!"
    mal "让我做什么都可以！我可以告诉你博纳尔在哪！我可以帮你救她！"

# game/ch1ep4.rpy:2391
translate chinese skystressrelief_ff1a5560:

    # mc "Save her? No, you don't get to save anyone else after this..."
    mc "救她？还是先想想怎么救你自己吧……"

