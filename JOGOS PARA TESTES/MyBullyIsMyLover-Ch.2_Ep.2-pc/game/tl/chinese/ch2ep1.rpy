# game/ch2ep1.rpy:3846
translate chinese gwencumback_e10fa42c_1:

    # mc "Go ask the ghost yourself."
    mc "你去问那个鬼不就知道了。"

# game/ch2ep1.rpy:3847
translate chinese gwencumback_e9836ae9_1:

    # a "*sighs* I can talk to her later..."
    a "*叹气* 之后再跟她聊吧……"

# game/ch2ep1.rpy:3850
translate chinese gwencumback_b8458a66_2:

    # a "Anyway... you okay?"
    a "总之……你还好吧？"

# game/ch2ep1.rpy:3851
translate chinese gwencumback_3602c61a_2:

    # mc "Whoa, where's this coming from?"
    mc "怎么问这个？"

# game/ch2ep1.rpy:3852
translate chinese gwencumback_63b5b972_1:

    # a "[mc]... we've been around each other long enough that I can spot even your smallest tells."
    a "[mc!t]……我们在一起这么久，不管多不明显的迹象我都能发现。"

# game/ch2ep1.rpy:3853
translate chinese gwencumback_45ed29e0_2:

    # mc "You mean the paperwork?"
    mc "你说文件吗？"

# game/ch2ep1.rpy:3854
translate chinese gwencumback_01872ad0_2:

    # a "The paperwork."
    a "嗯，文件。"

# game/ch2ep1.rpy:3855
translate chinese gwencumback_fe265a1f_2:

    # mc "Yeah. I'm fine. Just... still getting used to juggling two jobs at once."
    mc "嗯，我没关系的。只是……还在习惯同时干两份工作。"

# game/ch2ep1.rpy:3856
translate chinese gwencumback_1092ae7a_1:

    # a "Maybe that wasn't the smartest move. Let me take more of the load."
    a "或许那样并不明智。让我做更多的工作吧。"

# game/ch2ep1.rpy:3857
translate chinese gwencumback_73d84c64_2:

    # mc "Aren't you already doing that?"
    mc "现在不就是这样吗？"

# game/ch2ep1.rpy:3858
translate chinese gwencumback_4e42522c_2:

    # a "Nope, only half."
    a "不，现在是你我一人一半。"

# game/ch2ep1.rpy:3859
translate chinese gwencumback_f945bec8_2:

    # mc "I'll be fine, Aine. If you can handle it, I can handle it too."
    mc "我没事的，艾妮。既然你可以，我肯定也能行。"

# game/ch2ep1.rpy:3862
translate chinese gwencumback_2b35b6fe_7:

    # mc "..."
    mc "……"

# game/ch2ep1.rpy:3863
translate chinese gwencumback_11226236_2:

    # a "Oh—that? I was on my way to Emma's office. Sky said she skipped breakfast again."
    a "噢，那个？我正打算去艾玛的办公室。斯凯说她又没吃早饭。"

# game/ch2ep1.rpy:3866
translate chinese gwencumback_2b4e79e8_2:

    # mc "You know she doesn't like visitors."
    mc "你知道她不喜欢别人找她。"

# game/ch2ep1.rpy:3867
translate chinese gwencumback_97e2973d_2:

    # a "Yeah, I remember."
    a "嗯，我还记得。"

# game/ch2ep1.rpy:3868
translate chinese gwencumback_ebd54034_2:

    # mc "Let me take it."
    mc "我去送吧。"

# game/ch2ep1.rpy:3869
translate chinese gwencumback_7dc231b3_2:

    # a "... Actually, that's a great idea. She's more lenient when you drop by her office."
    a "……也好。她更能容忍你去她的办公室。"

# game/ch2ep1.rpy:3882
translate chinese gwencumback_f3fb34c6:

    # l "Megan! You're not even halfway through—don't tell me you're dying already!"
    l "梅根！你连一半都没跑完呢。别跟我说你已经不行了。"

# game/ch2ep1.rpy:3883
translate chinese gwencumback_e3809bf7:

    # meg "Ugh, spare me, Lily. Nobody's watching."
    meg "唉，饶了我吧，莉莉。又没人看着。"

# game/ch2ep1.rpy:3884
translate chinese gwencumback_64c01189:

    # l "I am! And when we're training, it's Coach, not Lily!"
    l "我在看啊！而且训练的时候要叫我教练，不能叫莉莉！"

# game/ch2ep1.rpy:3885
translate chinese gwencumback_8202d2cb:

    # meg "Sure, Lily."
    meg "收到，莉莉。"

# game/ch2ep1.rpy:3896
translate chinese gwencumback_1a89d8d3:

    # l "... What's this?"
    l "……这是？"

# game/ch2ep1.rpy:3901
translate chinese gwencumback_5b071d7d:

    # news "This is a final advisory from the Quinara Weather Authority."
    news "这是奎纳拉气象局发出的最后警告。"

# game/ch2ep1.rpy:3903
translate chinese gwencumback_59f4e1ef:

    # news "Tropical Storm \"Pot\" is expected to make landfall along Quinara's eastern coastline within the next two hours."
    news "热带风暴“波特”预计两小时在奎纳拉东部沿海地区登陆。"

# game/ch2ep1.rpy:3905
translate chinese gwencumback_098fee56:

    # news "The cities of Chardos and Estora, including the provinces of Velaris and Highmarsh, are now under the highest warning level."
    news "查多斯与埃斯托拉两城，包括维拉里斯省及高沼省，现已提升至最高预警级别。"

# game/ch2ep1.rpy:3907
translate chinese gwencumback_d268c183:

    # news "Severe winds, torrential rain, and widespread flooding are anticipated in these regions."
    news "上述地区预计将出现强风、暴雨及大范围洪涝。"

# game/ch2ep1.rpy:3909
translate chinese gwencumback_58344092:

    # news "Residents are urged to shelter indoors, secure belongings, and avoid travel until authorities declare it safe."
    news "敦促居民留在室内避难，固定好户外物品，在官方宣布安全前避免出行。"

# game/ch2ep1.rpy:3911
translate chinese gwencumback_4c1ad2f2:

    # news "Other areas of Quinara will experience moderate to heavy rainfall, but no evacuation orders are currently in place."
    news "奎纳拉其他地区将出现中到大雨，但目前未发布疏散指令。"

# game/ch2ep1.rpy:3915
translate chinese gwencumback_a3492bca:

    # l "... Forgot to turn off the Quinara alerts."
    l "……忘记关掉奎纳拉的警报了。"

# game/ch2ep1.rpy:3916
translate chinese gwencumback_82822a0c:

    # l "..."
    l "……"

# game/ch2ep1.rpy:3917
translate chinese gwencumback_a2b84d89:

    # l "I hope they're safe."
    l "希望他们没事。"

# game/ch2ep1.rpy:3932
translate chinese gwencumback_d926ebc8:

    # e "Come in."
    e "请进。"

# game/ch2ep1.rpy:3936
translate chinese gwencumback_669664cb:

    # mc "Hey."
    mc "嘿。"

# game/ch2ep1.rpy:3939
translate chinese gwencumback_3388a208:

    # e "Oh..."
    e "噢……"

# game/ch2ep1.rpy:3942
translate chinese gwencumback_597ad522:

    # mc "Figured I'd crash your cave. Haven't seen daylight on your face since yesterday."
    mc "昨天开始就没见过阳光照在你脸上的样子了。所以想着来你的洞穴里看看。"

# game/ch2ep1.rpy:3943
translate chinese gwencumback_8414a67f:

    # mc "And lately, you've been married to those case files."
    mc "而且最近你更是一心扑在这些档案上。"

# game/ch2ep1.rpy:3944
translate chinese gwencumback_d8603719:

    # e "You know I can still kick you out?"
    e "你觉得我不会把你赶出去？"

# game/ch2ep1.rpy:3945
translate chinese gwencumback_0ed56d8d:

    # mc "Yeah, but you won't. You've always had a soft spot for me."
    mc "嗯，你不会的。你永远都会对我心软。"

# game/ch2ep1.rpy:3955
translate chinese gwencumback_98dc7eac:

    # mc "Here, breakfast and lunch."
    mc "给，早饭和午饭。"

# game/ch2ep1.rpy:3956
translate chinese gwencumback_00089999:

    # e "[mc]—"
    e "[mc!t]——"

# game/ch2ep1.rpy:3957
translate chinese gwencumback_85c79b3c:

    # mc "Ah-ah, don't. I already know what you're about to say."
    mc "不行。我已经知道你要说什么了。"

# game/ch2ep1.rpy:3960
translate chinese gwencumback_9d407890:

    # e "*soft laugh* Fine... I'll eat it all."
    e "*轻笑* 好吧……我会吃完的。"

# game/ch2ep1.rpy:3961
translate chinese gwencumback_d650061e:

    # mc "So... what's the damage?"
    mc "情况怎么样？"

# game/ch2ep1.rpy:3966
translate chinese gwencumback_623b4c4c:

    # mc "Another dead end?"
    mc "又是死胡同？"

# game/ch2ep1.rpy:3967
translate chinese gwencumback_98413ae8:

    # e "Mm. Yeah. Unfortunately."
    e "嗯。很可惜。"

# game/ch2ep1.rpy:3970
translate chinese gwencumback_147aeba2:

    # e "I keep thinking I'm closing in, but every lead turns into a brick wall."
    e "我一直觉得我很接近了，可每条线索追到最后都没有结果。"

# game/ch2ep1.rpy:3971
translate chinese gwencumback_4e52b516:

    # mc "Feels like you're chasing shadows, Em. At what point do you let them go?"
    mc "感觉你在做无用功啊，小艾。你到底什么时候才肯罢休？"

# game/ch2ep1.rpy:3974
translate chinese gwencumback_edadba82:

    # e "That's exactly why I can't stop: because as you can see, I'm still nowhere close."
    e "正因为没有进展，才不能停下。"

# game/ch2ep1.rpy:3975
translate chinese gwencumback_038e7a13:

    # mc "Don't grind yourself down over this. It was never your responsibility."
    mc "别太为这事费心了。这本就不是你的职责。"

# game/ch2ep1.rpy:3976
translate chinese gwencumback_748bd7a9:

    # e "If not mine, then whose?"
    e "如果不是我的，那是谁的？"

# game/ch2ep1.rpy:3977
translate chinese gwencumback_68b61d66:

    # e "Saving you should've been my duty. And I didn't. I couldn't."
    e "那时候应该是我去救你的。可我没有去。我无能为力。"

# game/ch2ep1.rpy:3978
translate chinese gwencumback_6fd6e2a8:

    # e "Why else take this job if I can't even do it right?"
    e "连这都做不到，我干嘛还要干这一行呢？"

# game/ch2ep1.rpy:3981
translate chinese gwencumback_d40d451f:

    # mc "Nobody's ever put that blame on you."
    mc "没有人怪你。"

# game/ch2ep1.rpy:3984
translate chinese gwencumback_9a941dbf:

    # e "I did."
    e "我怪我自己。"

# game/ch2ep1.rpy:3985
translate chinese gwencumback_9a046c97:

    # mc "Em... you couldn't have stopped it."
    mc "小艾……你那时候也没办法阻止他们的。"

# game/ch2ep1.rpy:3986
translate chinese gwencumback_86a8bc70:

    # e "I know. That's why I'm doing everything now."
    e "我知道。所以我现在才要做这些事。"

# game/ch2ep1.rpy:3987
translate chinese gwencumback_3868227c:

    # e "Even if it takes a hundred years, I'll find him."
    e "哪怕花上一百年，我也要找到他。"

# game/ch2ep1.rpy:3990
translate chinese gwencumback_ca37cfe7:

    # mc "*exhales* So...? Where does that leave us?"
    mc "*叹气* 好吧……那我们接下来要去哪？"

# game/ch2ep1.rpy:3991
translate chinese gwencumback_ca3cc78a:

    # e "... You're not joining my op again, are you?"
    e "……你不会又想跟我一起行动吧？"

# game/ch2ep1.rpy:3994
translate chinese gwencumback_477fd415:

    # mc "Well... I dipped my toe in once. Used a contact to help you."
    mc "嗯……我之前就已经插过手了。派了个熟人去帮你。"

# game/ch2ep1.rpy:3997
translate chinese gwencumback_32dafa59:

    # mc "Okay, maybe it was twice."
    mc "好吧，可能不止一次，是两次。"

# game/ch2ep1.rpy:4000
translate chinese gwencumback_89268767:

    # e "And this is why I hate you guys walking in here. You always find yourselves neck-deep before you realize how dangerous this is."
    e "所以我才不想让你们过来我这。你们总是在搞清楚事情有多危险之前就已经牵扯进来了。"

# game/ch2ep1.rpy:4001
translate chinese gwencumback_d42c26de:

    # mc "Not always, but... fair point."
    mc "也不总是很危险，不过……你说得对。"

# game/ch2ep1.rpy:4002
translate chinese gwencumback_a45b4836:

    # mc "But tell me, what do you actually have?"
    mc "但是你跟我说说，你现在有什么线索？"

# game/ch2ep1.rpy:4005
translate chinese gwencumback_2b0c4bbb:

    # e "*sighs* Nothing solid yet."
    e "*叹气* 还没有确凿的证据。"

# game/ch2ep1.rpy:4006
translate chinese gwencumback_c896ffcb:

    # e "Just rumors. Reports of people vanishing, movements across borders that don't add up."
    e "只有各种传言。一些关于人员失踪的报告，外加些对不上号的出入边境的动向。"

# game/ch2ep1.rpy:4007
translate chinese gwencumback_0b41b159:

    # e "On paper, they're scattered cases. Different names, different operators."
    e "纸面上看，这些都是互不关联的事件。名字不同，作案手法也不一样。"

# game/ch2ep1.rpy:4008
translate chinese gwencumback_7965bfed:

    # mc "But you think it's him."
    mc "但你觉得是他。"

# game/ch2ep1.rpy:4009
translate chinese gwencumback_e7404025:

    # e "I can't prove it. But it has his fingerprints all over it."
    e "我没法证明。但到处都有他的痕迹。"

# game/ch2ep1.rpy:4010
translate chinese gwencumback_40f3f277:

    # e "Vanishing people under cover, moving through shells... it's his style."
    e "借着掩护让人消失，不断变换假身份……这是他的风格。"

# game/ch2ep1.rpy:4013
translate chinese gwencumback_c7fc9ea6:

    # mc "So it's a hunch."
    mc "也就是说，是你的直觉。"

# game/ch2ep1.rpy:4014
translate chinese gwencumback_ef96a77d:

    # e "One that won't leave me. Every missing name I read feels like another failure stamped with mine. Because he's still out there."
    e "是个怎么都摆脱不掉的直觉。我每看到一个失踪者的名字，就感觉自己又失败了一次。因为他还在逍遥法外。"

# game/ch2ep1.rpy:4015
translate chinese gwencumback_c6dfa786:

    # mc "Em... again, you're chasing someone who knows how to disappear."
    mc "小艾……你在追一个很会躲藏的人。"

# game/ch2ep1.rpy:4016
translate chinese gwencumback_7ccc84b5:

    # e "*bitter laugh* Disappearing or not, someone's pulling strings. And until I'm sure it isn't him, I'm not stopping."
    e "*苦笑* 不管会不会躲，这背后都一定有人搞鬼。我在能确定不是他之前，是不会停下的。"

# game/ch2ep1.rpy:4019
translate chinese gwencumback_1e358490:

    # mc "Hold up..."
    mc "等等……"

# game/ch2ep1.rpy:4020
translate chinese gwencumback_e951ac9a:

    # mc "Em, these are all—"
    mc "小艾，这些全都是——"

# game/ch2ep1.rpy:4023
translate chinese gwencumback_8c1a41a5:

    # e "Mm. The part that eats at me most... most of the missing are kids."
    e "嗯。这是最让我心碎的……大部分失踪者都是儿童。"

# game/ch2ep1.rpy:4024
translate chinese gwencumback_6dab522e:

    # e "Harvest? Traffic? I don't know yet."
    e "是为了摘取器官？还是拐卖？我还不能断言。"

# game/ch2ep1.rpy:4025
translate chinese gwencumback_c588fabf:

    # e "All I know is something vile is crawling through this city right now."
    e "我只知道城里现在潜藏着毒蛇。"

# game/ch2ep1.rpy:4028
translate chinese gwencumback_60bef15a:

    # mc "... I don't care if it's him or not. What do you want to do?"
    mc "……我不在乎到底是不是他了。你打算怎么办？"

# game/ch2ep1.rpy:4031
translate chinese gwencumback_72a33094:

    # e "..."
    e "……"

# game/ch2ep1.rpy:4043
translate chinese gwencumback_9376eac6:

    # mc "Perfect. And guess who left the umbrella at the office?"
    mc "太棒了。猜猜谁把伞忘在办公室里了？"

# game/ch2ep1.rpy:4044
translate chinese gwencumback_8fb7cbd9:

    # g "Good thing I grabbed that ticket early... didn't even know a storm was sneaking in."
    g "还好我买票及时……根本都不知道会有风暴啊。"

# game/ch2ep1.rpy:4045
translate chinese gwencumback_3ecd33f4:

    # mc "Don't you have your Quinara weather alerts on?"
    mc "你没打开奎纳拉的天气警报吗？"

# game/ch2ep1.rpy:4046
translate chinese gwencumback_3a537102:

    # g "I turned it off for... travel reasons."
    g "四处出差……就给它关了。"

# game/ch2ep1.rpy:4054
translate chinese gwencumback_28941b31:

    # mc "Well, here comes our savior."
    mc "哦，我们的救星来了。"

# game/ch2ep1.rpy:4059
translate chinese gwencumback_cd745aa7:

    # g "Hey."
    g "嘿。"

# game/ch2ep1.rpy:4060
translate chinese gwencumback_2e2cdca9:

    # m "'Sup! Back already, or just passing through?"
    m "你们好啊！这就要回家了吗？还是说待会还要出门？"

# game/ch2ep1.rpy:4061
translate chinese gwencumback_b2802bcb:

    # g "Mm... plans fell apart."
    g "嗯……计划被毁了。"

# game/ch2ep1.rpy:4064
translate chinese gwencumback_e6fb380e:

    # mc "I swear, I've lost count of how many times you've had to rescue my dumb ass."
    mc "我都已经数不清你救过我多少次了。"

# game/ch2ep1.rpy:4067
translate chinese gwencumback_ee13e4d6:

    # m "Two of you this time."
    m "这次是救了你们两个。"

# game/ch2ep1.rpy:4068
translate chinese gwencumback_46531a37:

    # m "And yeah... still no garage of our own."
    m "……到现在还是没有我们自己的车库啊。"

# game/ch2ep1.rpy:4069
translate chinese gwencumback_69461411:

    # mc "One thing at a time."
    mc "慢慢来嘛。"

# game/ch2ep1.rpy:4073
translate chinese gwencumback_fc43d982:

    # mc "Anyone else around besides you?"
    mc "还有其他人在吗？"

# game/ch2ep1.rpy:4074
translate chinese gwencumback_3e09e2a5:

    # m "Doesn't look like it."
    m "应该没有了。"

# game/ch2ep1.rpy:4075
translate chinese gwencumback_95727141:

    # g "Not even Shu?"
    g "连修都不在？"

# game/ch2ep1.rpy:4076
translate chinese gwencumback_02978cd3:

    # m "Haven't seen him since morning."
    m "早上之后就没见过他。"

# game/ch2ep1.rpy:4077
translate chinese gwencumback_45564652:

    # mc "Shu disappearing without a word... that's new."
    mc "修居然一声不吭地消失了……这倒新鲜。"

# game/ch2ep1.rpy:4091
translate chinese gwencumback_77e4ae94:

    # k "{i}Rain never asks permission. It just presses on the glass until you notice."
    k "{i}雨滴从不征求同意。它只会不断敲在玻璃上，直到你注意到它。"

# game/ch2ep1.rpy:4092
translate chinese gwencumback_c6a646a3:

    # k "{i}Like it knows a window's still cracked open somewhere."
    k "{i}就好像它知道，在某个地方总有一扇开着缝的窗。"

# game/ch2ep1.rpy:4093
translate chinese gwencumback_b660a15a:

    # k "{i}Back then, weather like this erased me. I'd let the darkness take sound, thought... even the hours."
    k "{i}以前，这样的天气会把我抹去。我会让黑暗吞噬声音，思考……甚至时间。"

# game/ch2ep1.rpy:4096
translate chinese gwencumback_7e00cd41:

    # k "{i}I grew up breathing in this color."
    k "{i}我就是在这种色调里长大的。"

# game/ch2ep1.rpy:4097
translate chinese gwencumback_29d80c22:

    # k "{i}On the worst days, it was pitch. On the better ones, a kind of washed-out gray. Never white. Never bright."
    k "{i}最糟糕的日子里，是漆黑一片。稍好一点的时候，是一种褪了色的灰。从来不是白色。从来没有明亮过。"

# game/ch2ep1.rpy:4098
translate chinese gwencumback_82224de5:

    # k "{i}Then I met people who made the world look... almost lit from the inside."
    k "{i}之后我遇到的一些人……能让世界光亮无比。"

# game/ch2ep1.rpy:4101
translate chinese gwencumback_3f804c16:

    # k "{i}And yet, even then... I kept asking myself—"
    k "{i}可即使如此……我还是一直问我自己——"

# game/ch2ep1.rpy:4102
translate chinese gwencumback_d04ad631:

    # k "{i}Is this me? Is this who I want to be?"
    k "{i}这就是我吗？这就是我想成为的样子吗？"

# game/ch2ep1.rpy:4103
translate chinese gwencumback_362cfb82:

    # k "{i}Because when despair found me, I still looked for the dark. Every time."
    k "{i}因为当绝望造访时，我还是会寻求黑暗。无一例外。"

# game/ch2ep1.rpy:4104
translate chinese gwencumback_162a9edd:

    # k "{i}Because it was familiar. It fit like an old coat."
    k "{i}因为黑暗更熟悉。就像被穿旧的大衣。"

# game/ch2ep1.rpy:4105
translate chinese gwencumback_aee27d76:

    # k "{i}So I learned to put on a mask instead. A face people could live with. Respectable. Palatable."
    k "{i}所以我学会了戴面具。换上一张可敬，可口，让人能接受的脸。"

# game/ch2ep1.rpy:4106
translate chinese gwencumback_9b7e6eaa:

    # k "{i}The real one—mine—always sent people running. In disgust. Or in fear."
    k "{i}真正的我——总会让人跑开。让人恶心。或者害怕。"

# game/ch2ep1.rpy:4109
translate chinese gwencumback_692a33f2:

    # k "{i}And now... there's him. He burns bright, but somehow I can look straight at him. Like his light is asking me not to turn away."
    k "{i}而现在……他来了。他光芒四射，但不知为何，我却能直视他。好像他的光在请求我，不要移开视线。"

# game/ch2ep1.rpy:4110
translate chinese gwencumback_67d2bb60:

    # k "{i}It doesn't hurt. It doesn't blind. It simply settles over me."
    k "{i}那光不会伤害我。不会刺眼。只是笼罩着我。"

# game/ch2ep1.rpy:4113
translate chinese gwencumback_21ee767f:

    # k "{i}Even silence changes shape with him. The creak of the floorboards. The hinge sighing at the door. The scrape of a plate."
    k "{i}哪怕沉默也会因他而改变形状。地板的吱呀声。门铰链的叹息。盘子的刮擦声。"

# game/ch2ep1.rpy:4114
translate chinese gwencumback_2ae50b2c:

    # k "{i}And me... pretending I don't wait for his presence. Pretending I don't leave the door open."
    k "{i}而我……在假装着我并没有在等待他出现。假装着我没有故意让门开着。"

# game/ch2ep1.rpy:4117
translate chinese gwencumback_3832cd2a:

    # k "{i}I set the tray down before my tea's even steeped. Two plates are coming. One candle I may or may not light."
    k "{i}我的茶还没泡好，我就已经放好了托盘。有两个盘子要来了。还有一支我或许会，又或许不会点燃的蜡烛。"

# game/ch2ep1.rpy:4120
translate chinese gwencumback_0b1b7208:

    # k "{i}He should be here... right about now."
    k "{i}他……马上就要来了。"

# game/ch2ep1.rpy:4127
translate chinese gwencumback_5fd8655d:

    # k "{i}At this hour, he isn't tired yet. He always comes with a smile... and food that still holds its warmth."
    k "{i}在这个时间，他还不累。他总是微笑着过来……还带着依旧热着的食物。"

# game/ch2ep1.rpy:4128
translate chinese gwencumback_5c9a2add:

    # k "{i}And somehow..."
    k "{i}可这些不知为何……"

# game/ch2ep1.rpy:4129
translate chinese gwencumback_4bfbfec7:

    # k "{i}... it unsettles me."
    k "{i}……会让我不安。"

# game/ch2ep1.rpy:4130
translate chinese gwencumback_64bdadf5:

    # k "{i}Why?"
    k "{i}为什么？"

# game/ch2ep1.rpy:4133
translate chinese gwencumback_ba1f4e74:

    # k "You're dripping on the floor."
    k "水都滴到地板上了。"

# game/ch2ep1.rpy:4137
translate chinese gwencumback_3e53fc51:

    # mc "Well, if I was, I'd change. Wouldn't wanna ruin your holy dust shrine."
    mc "要是我身上真有水，肯定会换好衣服再来。不能毁掉你屋里各种神圣的灰尘啊。"

# game/ch2ep1.rpy:4138
translate chinese gwencumback_e39a4dbb:

    # k "{i}These odd little exchanges... they pull at me in ways I can't admit."
    k "{i}这些稀奇古怪的对话……会以难以言说的方式牵动着我。"

# game/ch2ep1.rpy:4139
translate chinese gwencumback_89efdbe5:

    # k "That's not what I meant."
    k "我不是那个意思。"

# game/ch2ep1.rpy:4142
translate chinese gwencumback_77e4ae94_1:

    # k "{i}Rain never asks permission. It just presses on the glass until you notice."
    k "{i}雨滴从不征求同意。它只会不断敲在玻璃上，直到你注意到它。"

# game/ch2ep1.rpy:4145
translate chinese gwencumback_7ff2165d:

    # k "{i}And like the rain... here you are."
    k "{i}你就像雨一样……来了。"

# game/ch2ep1.rpy:4149
translate chinese gwencumback_68b54da5:

    # k "{i}He sets both plates down..."
    k "{i}他把两个盘子放下……"

# game/ch2ep1.rpy:4150
translate chinese gwencumback_d052a596:

    # k "{i}... then sits across from me without a word—"
    k "{i}……然后一言不发地坐在我对面——"

# game/ch2ep1.rpy:4154
translate chinese gwencumback_d7c1a069:

    # mc "So... not much business today. Why don't you tell me some of your pastimes?"
    mc "今天事情不多。要不你跟我说说你是怎么打发时间的？"

# game/ch2ep1.rpy:4158
translate chinese gwencumback_eac4eda2:

    # mc "What? Don't tell me that after all these months, you've done nothing in here?"
    mc "怎么？可别跟我说这么长时间，你在这里面什么都不干？"

# game/ch2ep1.rpy:4159
translate chinese gwencumback_c2a21e4b:

    # k "*nods* Mm-hm."
    k "*点头* 嗯。"

# game/ch2ep1.rpy:4160
translate chinese gwencumback_224efc52:

    # mc "Oh, Jesus..."
    mc "老天爷啊……"

# game/ch2ep1.rpy:4163
translate chinese gwencumback_4cb5d343:

    # k "Time just pass. But... I do miss the piano."
    k "时间自然而然地就过去了。不过……我挺想那架钢琴的。"

# game/ch2ep1.rpy:4164
translate chinese gwencumback_45b84986:

    # mc "Well, if we could squeeze one in here, I'd carry it myself. Heck, I'd even join you."
    mc "呵，要是这里能摆得下钢琴，我亲自给你搬来。甚至会跟你一起弹。"

# game/ch2ep1.rpy:4167
translate chinese gwencumback_0b8ccfb5:

    # mc "That's why I keep saying—step outside, just once."
    mc "所以我才一直说——出去吧，一次也好。"

# game/ch2ep1.rpy:4168
translate chinese gwencumback_3d6c2a15:

    # mc "Just once, explore the world outside these four walls, lady."
    mc "看看房间外的世界，哪怕一次也好，这位女士。"

# game/ch2ep1.rpy:4171
translate chinese gwencumback_f158fc4c:

    # k "Moon's at home. Why not spend your time with her instead of me?"
    k "月在家。为什么不去找她，而是来我这？"

# game/ch2ep1.rpy:4176
translate chinese gwencumback_65d2cd57:

    # mc "I mean... I could."
    mc "我……找她也行啊。"

# game/ch2ep1.rpy:4177
translate chinese gwencumback_958d8ce4:

    # mc "But it's a lot more interesting here."
    mc "但是这里更有趣。"

# game/ch2ep1.rpy:4178
translate chinese gwencumback_fa9d36c2:

    # k "There's nothing interesting here, [mc]."
    k "这里一点也不有趣，[mc!t]。"

# game/ch2ep1.rpy:4179
translate chinese gwencumback_25be642d:

    # mc "Maybe. But like I said—I'd still rather be here."
    mc "可能吧。但我说了——我更想在这里。"

# game/ch2ep1.rpy:4183
translate chinese gwencumback_65d2cd57_1:

    # mc "I mean... I could."
    mc "我……找她也行啊。"

# game/ch2ep1.rpy:4184
translate chinese gwencumback_7ca670a7:

    # mc "But I'd rather spend time with you."
    mc "但是我更想跟你在一块。"

# game/ch2ep1.rpy:4185
translate chinese gwencumback_fb039015:

    # k "There's nothing here worth staying for, [mc]. Just dark, dull quiet."
    k "你没有理由待在这里，[mc!t]。这里只有黑暗和无聊的沉默。"

# game/ch2ep1.rpy:4186
translate chinese gwencumback_ba1ed256:

    # mc "I told you, Klara. I'd rather spend time with {i}you{/i}."
    mc "我说了，克拉拉。我更想跟{i}你{/i}在一块。"

# game/ch2ep1.rpy:4192
translate chinese gwencumback_abf07973:

    # mc "*winces*" with hpunch
    mc "*酸到呲牙*" with hpunch

# game/ch2ep1.rpy:4193
translate chinese gwencumback_313434ed:

    # mc "Damn citrus... smug little bastard. I swear that one just shaved a year off my life."
    mc "这破橙子……烦死人了。这一口起码酸掉我一年阳寿。"

# game/ch2ep1.rpy:4199
translate chinese gwencumback_fa60284c:

    # k "{i}I want to ask him why. Why me. But I'm afraid of the answer..."
    k "{i}我想问他为什么。为什么选我。可是我害怕他的答案……"

# game/ch2ep1.rpy:4200
translate chinese gwencumback_1f1a62ef:

    # k "{i}... and the truth behind it."
    k "{i}……和答案背后的真相。"

# game/ch2ep1.rpy:4217
translate chinese gwencumback_208699f0:

    # kmother "{sc}{font=Beowolf.ttf}Your sister never stumbled like this. At least she made something of herself."
    kmother "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}你姐姐从来没有这样失误过。至少她闯出了一点名堂。"

# game/ch2ep1.rpy:4220
translate chinese gwencumback_5fda44d5:

    # kfather "{sc}{font=Beowolf.ttf}Leaving the clan?"
    kfather "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}你居然想离开氏族？"

# game/ch2ep1.rpy:4221
translate chinese gwencumback_57ac5912:

    # kfather "{sc}{font=Beowolf.ttf}After everything we carved into you, you're just spitting it back in our faces?"
    kfather "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}我们教了你那么多，你就是这样回报我们的？"

# game/ch2ep1.rpy:4224
translate chinese gwencumback_81b22b36:

    # kstranger "{sc}{font=Beowolf.ttf}What the hell are you supposed to be?"
    kstranger "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}你他妈是哪位啊？"

# game/ch2ep1.rpy:4225
translate chinese gwencumback_36c93ee4:

    # kstranger "{sc}{font=Beowolf.ttf}Don't touch me. Don't even breathe near me."
    kstranger "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}别碰我。最好别在我旁边呼吸。"

# game/ch2ep1.rpy:4228
translate chinese gwencumback_a42b5000:

    # kteacher "{sc}{font=Beowolf.ttf}Silence again? It's disturbing. What's wrong with you?"
    kteacher "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}又不说话了？真烦人。你到底什么毛病？"

# game/ch2ep1.rpy:4231
translate chinese gwencumback_022034f9:

    # k "{i}Every note I held back scraped against my throat like glass."
    k "{i}每句我忍住没说的话都是架在我喉咙上的一把刀。"

# game/ch2ep1.rpy:4232
translate chinese gwencumback_bd320fd2:

    # k "{i}Every smile I put on was a truce I never agreed to."
    k "{i}每个我挤出来的微笑都是我从来没同意过的停战。"

# game/ch2ep1.rpy:4233
translate chinese gwencumback_152b41be:

    # k "{i}Every silence... was me slipping further out of sight."
    k "{i}每次沉默……都是我在逐渐消失。"

# game/ch2ep1.rpy:4236
translate chinese gwencumback_d7e310c8:

    # k "{i}And even now... their voices drown out anything I could've dared to play."
    k "{i}即使到了现在……他们的声音都会压过任何我想听到的声音。"

# game/ch2ep1.rpy:4239
translate chinese gwencumback_17e6ce21:

    # k "{i}Every sharp glance, every unsaid word, still caught in me like score left hanging—"
    k "{i}每一道尖锐的目光，每一句没说出口的话，都留在我的脑海里，像是一段没写完的乐谱——"

# game/ch2ep1.rpy:4245
translate chinese gwencumback_b1e50435:

    # mc "The rain's not letting up anytime soon, huh?"
    mc "这雨感觉一时半会停不了吧？"

# game/ch2ep1.rpy:4248
translate chinese gwencumback_b259bc2d:

    # k "I don't want it to. Let it stay."
    k "我不想雨停。一直下着吧。"

# game/ch2ep1.rpy:4252
translate chinese gwencumback_69952858:

    # k "... Did you just roll your eyes at me?"
    k "……你朝我翻了个白眼？"

# game/ch2ep1.rpy:4255
translate chinese gwencumback_955806f5:

    # mc "Yeah. That was a little much."
    mc "是啊。你刚刚有点太做作了。"

# game/ch2ep1.rpy:4256
translate chinese gwencumback_683ee0d2:

    # k "{b}{i}You{/i}{/b} started it. Stop enabling me."
    k "是{b}{i}你{/i}{/b}开始的。别惯着我了。"

# game/ch2ep1.rpy:4257
translate chinese gwencumback_1057e1e0:

    # mc "I wasn't trying to. Put the fangs away."
    mc "少耍性子了。我也没想惯着你。"

# game/ch2ep1.rpy:4261
translate chinese gwencumback_e136e3c0:

    # k "Then what—was that your way of saying you want to leave as soon as you can?"
    k "那你是想尽快离开的意思吗？"

# game/ch2ep1.rpy:4264
translate chinese gwencumback_21a4692c:

    # mc "Do you want me to?"
    mc "你想让我走吗？"

# game/ch2ep1.rpy:4265
translate chinese gwencumback_82091822:

    # k "..."
    k "……"

# game/ch2ep1.rpy:4266
translate chinese gwencumback_cfaae932:

    # mc "Do you?"
    mc "想吗？"

# game/ch2ep1.rpy:4267
translate chinese gwencumback_82091822_1:

    # k "..."
    k "……"

# game/ch2ep1.rpy:4268
translate chinese gwencumback_27bb7259:

    # mc "Say it."
    mc "说出来。"

# game/ch2ep1.rpy:4271
translate chinese gwencumback_b8ae7df3:

    # k "{size=-15}Stay...{/size}"
    k "{size=-15}别走……{/size}"

# game/ch2ep1.rpy:4272
translate chinese gwencumback_6e6a85cf:

    # mc "Didn't catch that."
    mc "听不见。"

# game/ch2ep1.rpy:4275
translate chinese gwencumback_ea30aec6:

    # k "I want you to stay."
    k "我想让你留下。"

# game/ch2ep1.rpy:4278
translate chinese gwencumback_ad921afa:

    # mc "*nods* Good."
    mc "*点头* 很好。"

# game/ch2ep1.rpy:4282
translate chinese gwencumback_30fa8481:

    # k "What are you doing?"
    k "你干什么？"

# game/ch2ep1.rpy:4283
translate chinese gwencumback_384d6562:

    # mc "Relax. Just making space."
    mc "没事。只是腾一下地方。"

# game/ch2ep1.rpy:4294
translate chinese gwencumback_e9d98611:

    # mc "Bad news. Our old vinyl's shot."
    mc "坏消息。我们那张老唱片坏了。"

# game/ch2ep1.rpy:4295
translate chinese gwencumback_3cda7c1b:

    # k "Our vinyl? And why would you even need that?"
    k "我们的唱片？你用那个干嘛？"

# game/ch2ep1.rpy:4298
translate chinese gwencumback_0e3680a7:

    # mc "Doesn't matter. We'll improvise."
    mc "没关系。我们将就一下。"

# game/ch2ep1.rpy:4304
translate chinese gwencumback_f3aec8db:

    # mc "Since you don't have a pastime, let's make one."
    mc "既然你没有打发时间的方式，就教你一个。"

# game/ch2ep1.rpy:4308
translate chinese gwencumback_b037c37c:

    # k "Wait—hey!"
    k "等一下——喂！"

# game/ch2ep1.rpy:4312
translate chinese gwencumback_777ffbbc:

    # k "What the hell, [mc]?!"
    k "干嘛啊，[mc!t]？！"

# game/ch2ep1.rpy:4313
translate chinese gwencumback_8cf41c64:

    # mc "Thought you'd forgotten how. Guess not."
    mc "还以为你已经忘了。看来没有。"

# game/ch2ep1.rpy:4314
translate chinese gwencumback_84dcd325:

    # k "This is insane!"
    k "真是疯了！"

# game/ch2ep1.rpy:4315
translate chinese gwencumback_580efc49:

    # mc "And yet your hands don't look so eager to leave mine."
    mc "可是你的手看着不太想松开啊。"

# game/ch2ep1.rpy:4316
translate chinese gwencumback_4ef7ba29:

    # k "They're here because you forced them!"
    k "都是因为你强迫的啊！"

# game/ch2ep1.rpy:4317
translate chinese gwencumback_23ef38eb:

    # mc "But you're holding on."
    mc "可是你抓得很紧。"

# game/ch2ep1.rpy:4318
translate chinese gwencumback_0e59e96b:

    # k "Don't flatter yourself! If my back snaps, you're paying for it!"
    k "别自恋了！要是我闪到了背，你就等着吧！"

# game/ch2ep1.rpy:4319
translate chinese gwencumback_75feb143:

    # mc "Then I'll hold you steadier than anyone else could."
    mc "那我只要搂你搂得比其他人都紧就好了。"

# game/ch2ep1.rpy:4322
translate chinese gwencumback_9f503120:

    # mc "See? Your body remembers—even if you'd rather it didn't."
    mc "看吧？你的身体还记得——哪怕你自己并不愿意。"

# game/ch2ep1.rpy:4323
translate chinese gwencumback_de01c6a2:

    # k "[mc]... I'm too old for this."
    k "[mc!t]……我的年纪已经不适合做这种事了。"

# game/ch2ep1.rpy:4324
translate chinese gwencumback_944123e2:

    # mc "And yet..."
    mc "可是……"

# game/ch2ep1.rpy:4327
translate chinese gwencumback_22fe0fb3:

    # mc "... you're still moving with me."
    mc "……你依然在跟我一同起舞。"

# game/ch2ep1.rpy:4328
translate chinese gwencumback_806b9fd2:

    # k "Only because you won't let go."
    k "只是因为你不肯放开我。"

# game/ch2ep1.rpy:4329
translate chinese gwencumback_81e7d814:

    # mc "You would've fallen. Don't worry, I'd catch you anyway."
    mc "放开了你就摔倒了。没事，反正我会接住你的。"

# game/ch2ep1.rpy:4332
translate chinese gwencumback_c7f170ec:

    # k "You shouldn't talk to me like that."
    k "你不应该这么跟我说话。"

# game/ch2ep1.rpy:4333
translate chinese gwencumback_3acbe686:

    # mc "Would you rather I sound like a stranger, instead of a partner?"
    mc "比起伴侣，你更想让我说话像个陌生人吗？"

# game/ch2ep1.rpy:4334
translate chinese gwencumback_7fb4506b:

    # k "You're not my partner."
    k "你不是我的伴侣。"

# game/ch2ep1.rpy:4335
translate chinese gwencumback_1f04c82f:

    # mc "At this moment? I am."
    mc "此时此刻，我就是。"

# game/ch2ep1.rpy:4338
translate chinese gwencumback_4d8f5bd5:

    # mc "And you match me better than anyone else ever could."
    mc "而你是和我最般配的。"

# game/ch2ep1.rpy:4339
translate chinese gwencumback_bd282e25:

    # k "... Oh, [mc]... Don't make me feel like this."
    k "……[mc!t]……不要让我有这种感觉。"

# game/ch2ep1.rpy:4340
translate chinese gwencumback_09621226:

    # mc "Don't think. Just move. Trust me."
    mc "不要思考。只要跳舞就好。相信我。"

# game/ch2ep1.rpy:4343
translate chinese gwencumback_3eeb70a7:

    # k "... Too close, [mc]."
    k "……太近了，[mc!t]。"

# game/ch2ep1.rpy:4344
translate chinese gwencumback_0c9b3a16:

    # mc "Close is the whole point. You taught me that."
    mc "不近就没有意义了。这是你教我的。"

# game/ch2ep1.rpy:4345
translate chinese gwencumback_ba32739e:

    # k "Yes, but right now..."
    k "是的，可是现在……"

# game/ch2ep1.rpy:4348
translate chinese gwencumback_82091822_2:

    # k "..."
    k "……"

# game/ch2ep1.rpy:4349
translate chinese gwencumback_46e71cda:

    # mc "Do you want me to stop?"
    mc "你想让我停下吗？"

# game/ch2ep1.rpy:4350
translate chinese gwencumback_82091822_3:

    # k "..."
    k "……"

# game/ch2ep1.rpy:4353
translate chinese gwencumback_652650d3:

    # mc "...?"
    mc "……？"

# game/ch2ep1.rpy:4356
translate chinese gwencumback_109e72d3:

    # k "... Just... slow down."
    k "……你……慢点来。"

# game/ch2ep1.rpy:4359
translate chinese gwencumback_4fcb057f:

    # mc "Alright. Hey Google, play us something easy, yeah?"
    mc "好。嘿谷歌，给我们来一首舒缓点的。"

# game/ch2ep1.rpy:4365
translate chinese gwencumback_1b55ecdc:

    # mc "Did my boredom get the better of me?"
    mc "这首会不会太无聊？"

# game/ch2ep1.rpy:4366
translate chinese gwencumback_8f744d00:

    # k "Just a little. Still... I like this better."
    k "一点点。不过……我还是更喜欢这个。"

# game/ch2ep1.rpy:4367
translate chinese gwencumback_1889008e:

    # k "... I know you were just trying to drag me back to... normalcy."
    k "……我知道你只是想让我变回……正常的样子。"

# game/ch2ep1.rpy:4368
translate chinese gwencumback_f9e6a8ec:

    # mc "No. Not really."
    mc "不。不是的。"

# game/ch2ep1.rpy:4369
translate chinese gwencumback_e3e3012e:

    # k "Then what—"
    k "那你是——"

# game/ch2ep1.rpy:4370
translate chinese gwencumback_f4db1711:

    # mc "I told you. I'm not here for the food."
    mc "我说了。我来这里不是为了食物。"

# game/ch2ep1.rpy:4371
translate chinese gwencumback_fd0e1091:

    # k "Tea?"
    k "茶？"

# game/ch2ep1.rpy:4372
translate chinese gwencumback_0800a22c:

    # mc "Not for the tea either. You always make it too sweet."
    mc "也不是为了茶。你总是弄太甜。"

# game/ch2ep1.rpy:4373
translate chinese gwencumback_0c7963db:

    # k "I want it sweet."
    k "我喜欢喝甜的。"

# game/ch2ep1.rpy:4374
translate chinese gwencumback_15991f91:

    # mc "Yeah. I figured."
    mc "是啊。我知道。"

# game/ch2ep1.rpy:4377
translate chinese gwencumback_2b35b6fe_8:

    # mc "..."
    mc "……"

# game/ch2ep1.rpy:4380
translate chinese gwencumback_1a1cf218:

    # mc "I'm not here because someone told me to check in. I'm not here out of pity, either."
    mc "我不是因为别人说要来看你才来的。也不是出于同情。"

# game/ch2ep1.rpy:4381
translate chinese gwencumback_4a54a3b6:

    # mc "I'm not here to repair you, or diagnose you. You're not some problem I have to solve."
    mc "我不是来修复你，或者给你下诊断书。你不是什么我必须解决的问题。"

# game/ch2ep1.rpy:4382
translate chinese gwencumback_c4648a49:

    # mc "And I'm not here to pry you open like a locked door."
    mc "我也不是为了打开你这扇锁着的门。"

# game/ch2ep1.rpy:4390
translate chinese gwencumback_de76ad57:

    # mc "I'm here because... this is the only room that doesn't feel empty when I walk into it."
    mc "我来这里，是因为……只有这个房间，在我走进来的时候，不会让我觉得空旷。"

# game/ch2ep1.rpy:4391
translate chinese gwencumback_003dc0b0:

    # mc "Even when you don't say a word... it still feels like you're saying something."
    mc "哪怕你一个字也不说……还是感觉你在对我说话。"

# game/ch2ep1.rpy:4394
translate chinese gwencumback_f1b38199:

    # k "... Again, you shouldn't say things like that. It makes me want to believe them."
    k "……我再说一次，你不应该说这种话。你会……让我当真的。"

# game/ch2ep1.rpy:4395
translate chinese gwencumback_127c1abf:

    # mc "Then believe."
    mc "那就当真吧。"

# game/ch2ep1.rpy:4398
translate chinese gwencumback_9f73f7ad:

    # mc "This past year... this room's been my salvation."
    mc "过去这一年……这个房间是我的救赎。"

# game/ch2ep1.rpy:4399
translate chinese gwencumback_366a4fba:

    # mc "I wasn't longing for the dark, but I was searching for the quiet. For your kind of presence."
    mc "我并不渴求黑暗，但我却会寻求宁静。寻求你那种陪伴。"

# game/ch2ep1.rpy:4400
translate chinese gwencumback_905a2894:

    # mc "*chuckles softly* There's nothing better than the kind of comfort I grew up craving."
    mc "*轻笑* 没什么比我从小到大都渴求着的陪伴更能安慰我了。"

# game/ch2ep1.rpy:4401
translate chinese gwencumback_f05b2db4:

    # mc "This is the one place that doesn't drag me back into the bad dreams, that doesn't pull me back to the past."
    mc "只有这个地方能让我不再回到噩梦里，不再回到过去。"

# game/ch2ep1.rpy:4402
translate chinese gwencumback_e7896f23:

    # mc "I like it here. I like being here... with you. And I'm glad you keep the door open for me."
    mc "我喜欢这里。我喜欢待在这里……跟你一起。而且我很开心你能一直为我开着门。"

# game/ch2ep1.rpy:4405
translate chinese gwencumback_948630e0:

    # k "[mc], I—"
    k "[mc!t]，我——"

# game/ch2ep1.rpy:4406
translate chinese gwencumback_e90082e1:

    # mc "I know... I know."
    mc "我知道……我知道。"

# game/ch2ep1.rpy:4407
translate chinese gwencumback_fcc59b9d:

    # mc "I don't care what anyone else thinks. I don't care how they paint you."
    mc "我不在乎其他人怎么想。我不在乎他们对你的描绘。"

# game/ch2ep1.rpy:4408
translate chinese gwencumback_11f82798:

    # mc "You're not perfect—and who even wants perfect?"
    mc "你并不完美——又有谁需要完美？"

# game/ch2ep1.rpy:4409
translate chinese gwencumback_e8f9fe86:

    # mc "I don't know which Klara's real—the one here, or the one \"they\" think they know—but I love them both just the same."
    mc "我不知道哪个克拉拉才是真的——是这里的你，还是“别人”眼中自以为了解的你——但我一样都爱。"

# game/ch2ep1.rpy:4410
translate chinese gwencumback_f01c9a02:

    # mc "And I'd still keep coming back here, just the same."
    mc "而且我也会一直回到这里来找你。"

# game/ch2ep1.rpy:4419
translate chinese gwencumback_208699f0_1:

    # kmother "{sc}{font=Beowolf.ttf}Your sister never stumbled like this. At least she made something of herself."
    kmother "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}你姐姐从来没有这样失误过。至少她闯出了一点名堂。"

# game/ch2ep1.rpy:4422
translate chinese gwencumback_5fda44d5_1:

    # kfather "{sc}{font=Beowolf.ttf}Leaving the clan?"
    kfather "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}你居然想离开氏族？"

# game/ch2ep1.rpy:4423
translate chinese gwencumback_57ac5912_1:

    # kfather "{sc}{font=Beowolf.ttf}After everything we carved into you, you're just spitting it back in our faces?"
    kfather "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}我们教了你那么多，你就是这样回报我们的？"

# game/ch2ep1.rpy:4424
translate chinese gwencumback_fa4b9a8a:

    # k "{i}Stop..."
    k "{i}停下……"

# game/ch2ep1.rpy:4427
translate chinese gwencumback_81b22b36_1:

    # kstranger "{sc}{font=Beowolf.ttf}What the hell are you supposed to be?"
    kstranger "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}你他妈是哪位啊？"

# game/ch2ep1.rpy:4428
translate chinese gwencumback_36c93ee4_1:

    # kstranger "{sc}{font=Beowolf.ttf}Don't touch me. Don't even breathe near me."
    kstranger "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}别碰我。最好别在我旁边呼吸。"

# game/ch2ep1.rpy:4431
translate chinese gwencumback_a42b5000_1:

    # kteacher "{sc}{font=Beowolf.ttf}Silence again? It's disturbing. What's wrong with you?"
    kteacher "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}又不说话了？真烦人。你到底什么毛病？"

# game/ch2ep1.rpy:4432
translate chinese gwencumback_b46d19fc:

    # k "{i}I said—"
    k "{i}我说了——"

# game/ch2ep1.rpy:4433
translate chinese gwencumback_f88a5f6e:

    # k "{i}{sc}{font=Beowolf.ttf}STOP!"
    k "{i}{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}停下！"

# game/ch2ep1.rpy:4452
translate chinese gwencumback_d8af67d4:

    # k "{i}I don't understand..."
    k "{i}我不明白……"

# game/ch2ep1.rpy:4456
translate chinese gwencumback_0db1e1ce:

    # k "{i}Even here... you still... find me."
    k "{i}即使我躲在这里……你还是……能找到我。"

# game/ch2ep1.rpy:4460
translate chinese gwencumback_4c12a1fb:

    # k "... You shouldn't hold me like that. It makes it harder to pretend I don't care."
    k "……你不该这样抱着我。这样我会更难假装自己不在乎。"

# game/ch2ep1.rpy:4461
translate chinese gwencumback_d5700236:

    # mc "Then stop pretending." with Dissolve(2.0)
    mc "那就不要假装了。" with Dissolve(2.0)

# game/ch2ep1.rpy:4489
translate chinese gwencumback_51ae7323:

    # mc "Why now?"
    mc "为什么现在才有行动？"

# game/ch2ep1.rpy:4492
translate chinese gwencumback_f314d57a:

    # k "... After a year of you sitting here, you really need to ask?"
    k "……你在这里坐了一年，还需要问吗？"

# game/ch2ep1.rpy:4493
translate chinese gwencumback_09d58e30:

    # mc "I do. Because I've sat across from you for three hundred dinners, and you never once crossed that line."
    mc "需要。因为我坐在你对面，陪你吃了三百顿晚饭，可你从来没有跨过那条线。"

# game/ch2ep1.rpy:4494
translate chinese gwencumback_01db1aa3:

    # k "... You never left. Not once."
    k "……你没有离开过。一次也没有。"

# game/ch2ep1.rpy:4495
translate chinese gwencumback_a2030b9e:

    # mc "I told you I wouldn't."
    mc "我说过我不会走。"

# game/ch2ep1.rpy:4496
translate chinese gwencumback_f3aba974:

    # k "That's why."
    k "这就是原因。"

# game/ch2ep1.rpy:4497
translate chinese gwencumback_cd4dd98b:

    # mc "That's not an answer."
    mc "这不算是答案。"

# game/ch2ep1.rpy:4500
translate chinese gwencumback_d38fdec7:

    # k "It is. You outlasted me."
    k "这就是。你比我能坚持。"

# game/ch2ep1.rpy:4501
translate chinese gwencumback_01a8cf90:

    # k "Every morning, every night, I waited for you to stop coming. But you never did."
    k "每个早上，每个夜晚，我都等着你不再来了那一次。可是你没有放弃过。"

# game/ch2ep1.rpy:4502
translate chinese gwencumback_9789d3dd:

    # k "Today... the silence was too heavy to keep pretending it meant {b}nothing{/b}."
    k "今天……今天的沉默太沉重了，{b}没法{/b}再假装下去。"

# game/ch2ep1.rpy:4505
translate chinese gwencumback_76f65af7:

    # k "And don't act like I'm the only one sitting on this, every single time you walked through that door."
    k "而且你每次推门进来的时候，不要装得好像只有我一个人在故意拖着一样。"

# game/ch2ep1.rpy:4506
translate chinese gwencumback_4b429039:

    # k "We're not children, [mc]. We don't get to hide behind ignorance anymore."
    k "我们不是小孩子了，[mc!t]。我们没法再假装不懂。"

# game/ch2ep1.rpy:4510
translate chinese gwencumback_7051a604:

    # mc "... So, what now?"
    mc "……那现在怎么办？"

# game/ch2ep1.rpy:4512
translate chinese gwencumback_23ddc827:

    # k "Now? Nothing."
    k "现在？什么也不办。"

# game/ch2ep1.rpy:4515
translate chinese gwencumback_6e0cbc41:

    # mc "Nothing?"
    mc "什么都不做吗？"

# game/ch2ep1.rpy:4516
translate chinese gwencumback_6c4c3910:

    # k "Don't look at me like that. You wanted the truth. You dragged it out of me. Well, now you have it."
    k "别这样看着我。是你想听实话。你让我说出口的。你也听到了。"

# game/ch2ep1.rpy:4517
translate chinese gwencumback_860525f1:

    # mc "And you expect me to just—"
    mc "那你想让我——"

# game/ch2ep1.rpy:4518
translate chinese gwencumback_d9c18946:

    # k "Leave it here."
    k "到此为止吧。"

# game/ch2ep1.rpy:4519
translate chinese gwencumback_91129cde:

    # mc "Klara—"
    mc "克拉拉——"

# game/ch2ep1.rpy:4520
translate chinese gwencumback_f7d2ef40:

    # k "Don't, [mc]. If we keep tugging at this thread, the whole thing unravels."
    k "别说了，[mc!t]。如果继续下去，就真的要把一切都暴露出来了。"

# game/ch2ep1.rpy:4521
translate chinese gwencumback_1a7afaa8:

    # mc "So you'd rather go back to—?"
    mc "所以你更希望回到——？"

# game/ch2ep1.rpy:4522
translate chinese gwencumback_08216964:

    # k "I'd rather you go before I make a mistake I can't undo."
    k "我更希望你在我犯下不可挽回的错误之前出去。"

# game/ch2ep1.rpy:4531
translate chinese gwencumback_c5cc73f0:

    # mc "... That's it?"
    mc "……就这样？"

# game/ch2ep1.rpy:4532
translate chinese gwencumback_064bf477:

    # k "Mm... that's it."
    k "嗯……就这样。"

# game/ch2ep1.rpy:4533
translate chinese gwencumback_8e359492:

    # mc "Fine."
    mc "好吧。"

# game/ch2ep1.rpy:4543
translate chinese gwencumback_38d7bd5c:

    # kmother "{sc}{font=Beowolf.ttf}He'll leave too. That's what they do when the recital ends."
    kmother "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}他也会离开的。所有人在演奏结束之后都会离场。"

# game/ch2ep1.rpy:4544
translate chinese gwencumback_8bdee702:

    # kstranger "{sc}{font=Beowolf.ttf}Quiet looks better on you. Keep it that way."
    kstranger "{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}你更适合寂静。继续保持下去吧。"

# game/ch2ep1.rpy:4550
translate chinese gwencumback_c0cbd0a3:

    # k "The chair still remembers your weight... and I hate that I'm jealous of it."
    k "那把椅子还记得你的重量……我好讨厌嫉妒它的自己。"

# game/ch2ep1.rpy:4553
translate chinese gwencumback_59ca1e3b:

    # k "If I had a drink left, I'd raise it to my own stupidity."
    k "如果还有喝的剩下，我真要敬一杯给自己的愚蠢。"

# game/ch2ep1.rpy:4556
translate chinese gwencumback_5fe055c1:

    # k "... Why does it have to be you?"
    k "……为什么偏偏是你？"

# game/ch2ep1.rpy:4573
translate chinese gwencumback_89322884:

    # g "And there he goes—the tireless savior himself."
    g "哦，我们不知疲倦的救世主来了。"

# game/ch2ep1.rpy:4576
translate chinese gwencumback_a521be3e:

    # g "Saint [mc], healer of the broken and tamer of gloomy women."
    g "大圣人[mc!t]，专门拯救心碎、忧郁的女人。"

# game/ch2ep1.rpy:4577
translate chinese gwencumback_a0f2f9f7:

    # g "With his soft heart, that stupidly patient face..."
    g "全靠他那温柔的心和充满耐心的小笨脸蛋……"

# game/ch2ep1.rpy:4578
translate chinese gwencumback_c799ccc7:

    # g "A walking invitation for every lost soul to chase."
    g "让每个迷途少女都对他神魂颠倒。"

# game/ch2ep1.rpy:4581
translate chinese gwencumback_3b3823fe:

    # g "God, it's almost poetic. Almost."
    g "天啊，这几乎都能算是诗了。"

# game/ch2ep1.rpy:4582
translate chinese gwencumback_d23a9827:

    # g "For the record, I came up with that. And I'm not drunk, before you even ask."
    g "郑重声明，这几句话是我原创的。而且你不用问了，我没喝醉。"

# game/ch2ep1.rpy:4585
translate chinese gwencumback_4e0ab21a:

    # mc "*sighs* Shit went down while you were gone."
    mc "*叹气* 你不在的时候，出事了。"

# game/ch2ep1.rpy:4587
translate chinese gwencumback_38c9d0a4:

    # g "I can tell."
    g "看得出来。"

# game/ch2ep1.rpy:4588
translate chinese gwencumback_6d2e8669:

    # mc "Nothing too dramatic... just time doing what it does..."
    mc "没什么太夸张的……只是时光从中作梗……"

# game/ch2ep1.rpy:4591
translate chinese gwencumback_ad6c1cac:

    # g "[mc]... you know I'm not the philosophical type. Explain."
    g "[mc!t]……你知道我不喜欢文绉绉的。给我解释一下。"

# game/ch2ep1.rpy:4592
translate chinese gwencumback_27d006bc:

    # mc "Kept showing up in her room. Breakfast into lunch, lunch into dinner."
    mc "我一直去她的房间。从早饭到午饭，午饭到晚饭。"

# game/ch2ep1.rpy:4593
translate chinese gwencumback_bf6c5556:

    # mc "After a while, the quietude started feeling less like silence and more like... well... a routine."
    mc "过一段时间，安静就不太像是安静，而更像是……嗯……日常。"

# game/ch2ep1.rpy:4594
translate chinese gwencumback_ff247652:

    # g "\"Nothing dramatic,\" huh? Sure."
    g "这就是“没什么太夸张的”？"

# game/ch2ep1.rpy:4595
translate chinese gwencumback_4d432b05:

    # mc "Yeah, I don't really know how else to put it."
    mc "是啊，我真的不知道其他形容的方法。"

# game/ch2ep1.rpy:4596
translate chinese gwencumback_b6c734cc:

    # g "You two talked?"
    g "你们俩聊过吗？"

# game/ch2ep1.rpy:4599
translate chinese gwencumback_4b054789:

    # mc "Not much. She's not the kind you {i}talk with{/i} anymore—not since... well, you know."
    mc "没聊太多。她已经不是靠聊就行的了——毕竟她……你也知道的。"

# game/ch2ep1.rpy:4600
translate chinese gwencumback_500fd1f9:

    # mc "Now she's the kind you learn from by just sitting beside her. Some days she barely says a word. Other days, she asks how I'm doing and pretends she doesn't care about the answer."
    mc "现在你得坐在她身边才能了解她。有时候她一天都不会说几句话。其他日子里，她只会问问我过得怎么样，然后假装对答案不感兴趣。"

# game/ch2ep1.rpy:4601
translate chinese gwencumback_17b9b24e:

    # g "And you kept going back anyway?"
    g "然后你不管这些，一直去找她？"

# game/ch2ep1.rpy:4602
translate chinese gwencumback_a8763104:

    # mc "Every day. For a year. Didn't even notice when it stopped being obligation and turned into habit."
    mc "每天都去。坚持了一年。我都没注意到去找她这事是什么时候从职责变成习惯的。"

# game/ch2ep1.rpy:4603
translate chinese gwencumback_070612fa:

    # g "*laughs* That's one hell of an unhealthy habit, [mc]. Oh, my poor boy..."
    g "*大笑* 真是个不健康的习惯啊，[mc!t]。唉，我可怜的宝贝……"

# game/ch2ep1.rpy:4606
translate chinese gwencumback_5485daaf:

    # mc "Typical you—laughing at my fumbles."
    mc "你就这样——爱笑话我的狼狈。"

# game/ch2ep1.rpy:4607
translate chinese gwencumback_67cf9883:

    # g "Because you sound like a man who got too comfortable living in someone else's storm."
    g "因为我感觉你像是一个把别人的痛苦当成自己的安逸的男人。"

# game/ch2ep1.rpy:4608
translate chinese gwencumback_f6d4375a:

    # mc "... I found something in that storm, Gwen. Something precious I don't want to let go of."
    mc "……我在那痛苦里发现了一些东西，格温。是我不愿意放手的珍贵之物。"

# game/ch2ep1.rpy:4620
translate chinese gwencumback_290ad2ec:

    # g "Like you always do, huh?"
    g "你不一直这样吗？"

# game/ch2ep1.rpy:4621
translate chinese gwencumback_f4ae03aa:

    # mc "Oh, cut it out."
    mc "得了，别提了。"

# game/ch2ep1.rpy:4625
translate chinese gwencumback_c88f94ba:

    # g "So... who kissed who first?"
    g "所以……谁先亲的谁？"

# game/ch2ep1.rpy:4626
translate chinese gwencumback_95cd15d6:

    # mc "She did. Right before I left."
    mc "她先的。就在我走之前。"

# game/ch2ep1.rpy:4627
translate chinese gwencumback_4b075371:

    # g "And...?"
    g "然后呢……？"

# game/ch2ep1.rpy:4628
translate chinese gwencumback_6196bde1:

    # mc "She's acting like it never happened. And I'm matching her pace."
    mc "她假装什么都没发生。我配合她演戏。"

# game/ch2ep1.rpy:4629
translate chinese gwencumback_59a550e2:

    # g "Figures."
    g "我就知道。"

# game/ch2ep1.rpy:4632
translate chinese gwencumback_bbeeb44e:

    # mc "What's that supposed to mean?"
    mc "你这什么意思？"

# game/ch2ep1.rpy:4633
translate chinese gwencumback_f8c022bd:

    # g "You're the kind who keeps things intact by holding your breath."
    g "你就是那种靠忍耐来维持表面的平静的人。"

# game/ch2ep1.rpy:4634
translate chinese gwencumback_7f56fd90:

    # mc "*chuckles softly* Guilty as charged."
    mc "*轻笑* 我没法反驳。"

# game/ch2ep1.rpy:4637
translate chinese gwencumback_2b35b6fe_9:

    # mc "..."
    mc "……"

# game/ch2ep1.rpy:4640
translate chinese gwencumback_b3294999:

    # mc "She looks more beautiful every time I see her. Why is that?"
    mc "我每次见她，都感觉她更漂亮了。为什么会这样？"

# game/ch2ep1.rpy:4641
translate chinese gwencumback_be42703f:

    # g "That's one way to say you've got it bad. No, both of you. And probably Sky, too."
    g "无非就是你迷上她了呗。不，应该说你俩互相痴迷。哦，可能还得再加上斯凯。"

# game/ch2ep1.rpy:4642
translate chinese gwencumback_98c6ac70:

    # g "Anyway, go on—wherever you're heading. I won't keep you."
    g "总之，你去做你的事吧。我不耽误你了。"

# game/ch2ep1.rpy:4645
translate chinese gwencumback_30aecf7d:

    # mc "Yeah. I'm heading back to Emma's office."
    mc "好。我正打算回艾玛的办公室。"

# game/ch2ep1.rpy:4646
translate chinese gwencumback_9bbf472e:

    # g "Oh? Mind if I tag along? Haven't seen her in ages."
    g "噢？我能一起吗？好久没见她了。"

# game/ch2ep1.rpy:4649
translate chinese gwencumback_9bce751c:

    # mc "She'd probably throw you out before you finish saying hi."
    mc "估计你连招呼都没打完就会被她轰出去。"

# game/ch2ep1.rpy:4650
translate chinese gwencumback_c62b255a:

    # g "Still?"
    g "她还这样？"

# game/ch2ep1.rpy:4651
translate chinese gwencumback_bc09f12b:

    # mc "Still. Your best friend still hates having visitors—even her own friends."
    mc "是啊。你最好的朋友依然不喜欢有人找她——哪怕是她的朋友也不行。"

# game/ch2ep1.rpy:4652
translate chinese gwencumback_de859e3a:

    # g "Guess some habits die harder than roaches."
    g "看来旧习惯就像打不死的小强啊。"

# game/ch2ep1.rpy:4654
translate chinese gwencumback_209c0971:

    # g "Oh I don't even wanna ask."
    g "唉，都懒得问你怎么回事了。"

# game/ch2ep1.rpy:4655
translate chinese gwencumback_b8dd94e8:

    # g "Go on—wherever you're heading. I won't keep you."
    g "你去做你的事吧。我不耽误你了。"

# game/ch2ep1.rpy:4658
translate chinese gwencumback_30aecf7d_1:

    # mc "Yeah. I'm heading back to Emma's office."
    mc "好。我正打算回艾玛的办公室。"

# game/ch2ep1.rpy:4659
translate chinese gwencumback_9bbf472e_1:

    # g "Oh? Mind if I tag along? Haven't seen her in ages."
    g "噢？我能一起吗？好久没见她了。"

# game/ch2ep1.rpy:4662
translate chinese gwencumback_9bce751c_1:

    # mc "She'd probably throw you out before you finish saying hi."
    mc "估计你连招呼都没打完就会被她轰出去。"

# game/ch2ep1.rpy:4663
translate chinese gwencumback_c62b255a_1:

    # g "Still?"
    g "她还这样？"

# game/ch2ep1.rpy:4664
translate chinese gwencumback_bc09f12b_1:

    # mc "Still. Your best friend still hates having visitors—even her own friends."
    mc "是啊。你最好的朋友依然不喜欢有人找她——哪怕是她的朋友也不行。"

# game/ch2ep1.rpy:4665
translate chinese gwencumback_de859e3a_1:

    # g "Guess some habits die harder than roaches."
    g "看来旧习惯就像打不死的小强啊。"

# game/ch2ep1.rpy:4681
translate chinese gwencumback_dc77caba:

    # mc "Ugh... when did it get this cold? It was warmer when I was in—"
    mc "唉……什么时候变这么冷了？以前我在——"

# game/ch2ep1.rpy:4684
translate chinese gwencumback_2b35b6fe_10:

    # mc "..."
    mc "……"

# game/ch2ep1.rpy:4705
translate chinese gwencumback_f0cdd948:

    # mc "Oh man..."
    mc "我去……"

# game/ch2ep1.rpy:4708
translate chinese gwencumback_6a8ae94e:

    # e "You're catching something again, aren't you?"
    e "你又生病了吧？"

# game/ch2ep1.rpy:4709
translate chinese gwencumback_0f629b7f:

    # mc "Probably just the rain."
    mc "可能只是因为下雨了。"

# game/ch2ep1.rpy:4710
translate chinese gwencumback_fdd93757:

    # e "You've been running on fumes for days."
    e "你都连轴转好几天了。"

# game/ch2ep1.rpy:4711
translate chinese gwencumback_10dee4ef:

    # mc "You think so?"
    mc "你怎么知道？"

# game/ch2ep1.rpy:4712
translate chinese gwencumback_9cd86ab7:

    # e "I can see it. I was the one who told Aine. Doing two huge jobs at once is insane, [mc]."
    e "我看得出来。就是我告诉艾妮的。同时干两份工作简直是疯了，[mc!t]。"

# game/ch2ep1.rpy:4715
translate chinese gwencumback_3b430ca7:

    # mc "Figures you'd notice..."
    mc "我也想着你会发现……"

# game/ch2ep1.rpy:4716
translate chinese gwencumback_7db1fdc9:

    # e "And now you've got that same look again—the one that means you haven't slept properly."
    e "而且你现在又是那幅一看就没有好好睡觉的样子了。"

# game/ch2ep1.rpy:4717
translate chinese gwencumback_9ba73d5b:

    # mc "Relax, detective. I'm clean."
    mc "别着急，大侦探。我没问题的。"

# game/ch2ep1.rpy:4718
translate chinese gwencumback_c40118af:

    # e "Sure. Until your body files a complaint."
    e "行啊，看你的身体还能撑多久。"

# game/ch2ep1.rpy:4721
translate chinese gwencumback_8264a8e1:

    # e "*sighs* Go home, [mc]. Get some rest before you short-circuit."
    e "*叹气* 回家吧，[mc!t]。好好休息，免得累倒。"

# game/ch2ep1.rpy:4722
translate chinese gwencumback_bfe32463:

    # mc "You usually tell me to keep pushing."
    mc "你一般都是会让我加把劲的。"

# game/ch2ep1.rpy:4723
translate chinese gwencumback_9c5a808c:

    # e "Not when you're running yourself into the ground."
    e "那时候你又没有逼自己硬撑。"

# game/ch2ep1.rpy:4727
translate chinese gwencumback_d094ae6c:

    # e "And since I'm not one to disobey my own preaching, I'm packing up too. Okay?"
    e "而且，我也不是个光说不练的人。我也收拾东西回去。这样可以吧？"

# game/ch2ep1.rpy:4728
translate chinese gwencumback_d1fb0878:

    # mc "Deal. I think the office lights will miss you, though."
    mc "可以。不过我觉得办公室的灯会想你的。"

# game/ch2ep1.rpy:4729
translate chinese gwencumback_0e7eddeb:

    # e "*chuckles* They'll live."
    e "*笑* 它们离了我也活得下去。"

# game/ch2ep1.rpy:4732
translate chinese gwencumback_51f89ad9:

    # e "Here, take this. It's colder out there than it looks."
    e "给，喝点吧。外面挺冷的。"

# game/ch2ep1.rpy:4736
translate chinese gwencumback_a153f4bb:

    # e "Wait—hold on, that's coffee."
    e "等等——拿错了，那是咖啡。"

# game/ch2ep1.rpy:4737
translate chinese gwencumback_cfd538e3:

    # mc "Coffee? At this hour?"
    mc "这个点还喝咖啡？"

# game/ch2ep1.rpy:4740
translate chinese gwencumback_9dea96dc:

    # e "Well... I needed my fuel."
    e "嗯……我需要燃料。"

# game/ch2ep1.rpy:4743
translate chinese gwencumback_f989aedf:

    # e "Hold on, I'll grab you something actually hot."
    e "等一下，我给你拿点热的去。"

# game/ch2ep1.rpy:4748
translate chinese gwencumback_c52215db:

    # mc "No need. There's nothing hotter than this thing right here."
    mc "不用了。这里的东西就足够让我保持燥热。"

# game/ch2ep1.rpy:4754
translate chinese gwencumback_6749e5ba:

    # e "HAAAAHHHNG~!!!"
    e "哈啊啊啊嗯嗯~！！！"

# game/ch2ep1.rpy:4757
translate chinese gwencumback_1749909e:

    # mc "Easy, officer. The suspect might hear us."
    mc "小点声，警官。会被嫌疑人听见的。"

# game/ch2ep1.rpy:4761
translate chinese gwencumback_fcad51e4:

    # mc "Starting to enjoy it now, huh?"
    mc "开始喜欢上这样了？"

# game/ch2ep1.rpy:4764
translate chinese gwencumback_39b3ce37:

    # e "I never stopped... Do it more often, bad boy..."
    e "从来没讨厌过……以后多来几次，坏蛋……"

# game/ch2ep1.rpy:4767
translate chinese gwencumback_ac1be95f:

    # e "W-We should head home! And you—don't you dare try that again!"
    e "我-我们该回家了！还有你——以后不准再这样"

# game/ch2ep1.rpy:4768
translate chinese gwencumback_575206e5:

    # yt "*chuckles* I'll never get tired of flustered Emma."
    yt "*笑* 害羞的艾玛我永远也看不腻。"

# game/ch2ep1.rpy:4771
translate chinese gwencumback_2ca61ffd:

    # e "Give me one minute. I'll be right back."
    e "等我一分钟。马上回来。"

# game/ch2ep1.rpy:4784
translate chinese gwencumback_4a364724:

    # k "{i}He's late."
    k "{i}他迟到了。"

# game/ch2ep1.rpy:4785
translate chinese gwencumback_7e13eecf:

    # k "{i}I told him to go. So why does it feel wrong that he actually did?"
    k "{i}是我让他走的。那为什么他真走了，却感觉不对劲？"

# game/ch2ep1.rpy:4786
translate chinese gwencumback_dc0295ce:

    # k "{i}The room feels... wrong too."
    k "{i}这个房间……也感觉不对劲。"

# game/ch2ep1.rpy:4801
translate chinese gwencumback_ad87dcbb:

    # k "{i}I should be glad. I said what I had to say. I broke the silence. Pushed him out before it got worse."
    k "{i}我应该高兴。我说了必须说的话。我打破了沉默。在情况恶化之前赶走了他。"

# game/ch2ep1.rpy:4802
translate chinese gwencumback_0db4fef2:

    # k "{i}So why does it feel like I just made it worse anyway?"
    k "{i}可为什么我感觉我让事情变得更糟了？"

# game/ch2ep1.rpy:4805
translate chinese gwencumback_5f34bb62:

    # k "{i}What if he doesn't come back?"
    k "{i}万一他不回来了怎么办？"

# game/ch2ep1.rpy:4806
translate chinese gwencumback_a58c5ea8:

    # k "{i}No. He will. He always does..."
    k "{i}不会的。他会来的。他总是会来……"

# game/ch2ep1.rpy:4809
translate chinese gwencumback_8dea5b69:

    # k "{i}And if he does—what then? What do I even say to him?"
    k "{i}就算他来了——之后呢？我该怎么开口？"

# game/ch2ep1.rpy:4810
translate chinese gwencumback_553319db:

    # k "{i}I don't want this. I shouldn't. But I do. God, I do."
    k "{i}我不想这样。我不该这样。可是我想让他来。天啊，我好想让他来。"

# game/ch2ep1.rpy:4814
translate chinese gwencumback_f5ccb894:

    # k "{i}... No. Don't—"
    k "{i}……不要。不要——"

# game/ch2ep1.rpy:4818
translate chinese gwencumback_15189d6e:

    # mc "Hey, sorry I'm late—"
    mc "抱歉我来晚——"

# game/ch2ep1.rpy:4825
translate chinese gwencumback_e9af605e:

    # mc "AAAAHHHH!"
    mc "啊啊啊啊啊！"

# game/ch2ep1.rpy:4826
translate chinese gwencumback_e303657c:

    # mc "Goddamn it, Klara!" with hpunch
    mc "我操啊，克拉拉！" with hpunch

# game/ch2ep1.rpy:4829
translate chinese gwencumback_ba69bb13:

    # k "*laughs* I...I'm sorry. I couldn't help myself."
    k "*大笑* 对……对不起。我忍不住。"

# game/ch2ep1.rpy:4830
translate chinese gwencumback_2b35b6fe_11:

    # mc "..."
    mc "……"

# game/ch2ep1.rpy:4833
translate chinese gwencumback_c50fbd83:

    # mc "Don't do that."
    mc "不用这样的。"

# game/ch2ep1.rpy:4834
translate chinese gwencumback_05fab382:

    # k "Don't do what?"
    k "不用哪样？"

# game/ch2ep1.rpy:4838
translate chinese gwencumback_b5ff6a11:

    # mc "Look... I know what this is."
    mc "我知道是怎么回事。"

# game/ch2ep1.rpy:4839
translate chinese gwencumback_7c68f424:

    # mc "You don't have to talk to me if you don't want to. You can be mad at me for breaking your silence."
    mc "你不想跟我说话的话，不说也没关系。你也可以生我的气，气我打破了你的沉默。"

# game/ch2ep1.rpy:4840
translate chinese gwencumback_b5c4b99a:

    # mc "But no matter what face you show the world, this is the last thing I want—seeing you force a mask when you're with me."
    mc "但不管你用哪副面具面对外面的世界，我最不想看到的就是——你连在我身边都要被迫假装自己。"

# game/ch2ep1.rpy:4843
translate chinese gwencumback_82091822_4:

    # k "..."
    k "……"

# game/ch2ep1.rpy:4844
translate chinese gwencumback_59563f85:

    # k "People think being quiet is empty space. It's not. It's the only place where no one can get at you."
    k "人们都觉得沉默是一片虚无。不是那样的。那是一个场所，是唯一一个别人找不到你的地方。"

# game/ch2ep1.rpy:4845
translate chinese gwencumback_bd3eb232:

    # k "And when it finally breaks... you don't feel lighter. You just feel... exposed."
    k "而当沉默终于被打破的时候……你不会感觉更轻松。只会觉得……脆弱。"

# game/ch2ep1.rpy:4846
translate chinese gwencumback_c164b58d:

    # k "And once it's gone, you can't stuff it back. The air changes. Everything sounds different. You start wondering what's left to hide behind."
    k "而沉默消失之后，是没办法修补的。就连空气都变了。一切的声音都不一样了。你想破脑袋也想不到接下来还能躲在什么东西后面。"

# game/ch2ep1.rpy:4847
translate chinese gwencumback_f941f68a:

    # k "They all say talking helps. But no one ever tells you about the quiet after, and how much it hurts knowing you broke your silence."
    k "他们都说，开口说话是有用的。可是没有人会告诉你说完话之后还会有寂静，还有打破沉默的感觉有多难受。"

# game/ch2ep1.rpy:4850
translate chinese gwencumback_a2472837:

    # k "That's what I gave up, [mc]..."
    k "所以我放弃了，[mc!t]……"

# game/ch2ep1.rpy:4851
translate chinese gwencumback_2cc70d2a:

    # k "And now, I know I won't feel safe without it."
    k "现在，我知道没了沉默以后，我不会再觉得安全。"

# game/ch2ep1.rpy:4854
translate chinese gwencumback_387b7301:

    # k "But with you... it doesn't feel like that. And I don't know why."
    k "可你在的时候……却没有那种感觉。我不知道原因。"

# game/ch2ep1.rpy:4857
translate chinese gwencumback_b0e64b5e:

    # k "[mc], you and I..."
    k "[mc!t]，你和我……"

# game/ch2ep1.rpy:4860
translate chinese gwencumback_b7a14214:

    # k "*exhales* We're not supposed to blur lines like this."
    k "*叹气* 我们不该这样暧昧不清。"

# game/ch2ep1.rpy:4861
translate chinese gwencumback_7e458027:

    # k "So why does it feel like every part of me is saying it's okay? That it's already been this way for a long time?"
    k "可为什么我的内心却一直说这样是没问题的？为什么我总觉得很久以来一直如此？"

# game/ch2ep1.rpy:4864
translate chinese gwencumback_fdda0a71:

    # k "Why you? Why does it have to be you?"
    k "为什么是你？为什么偏偏是你才行？"

# game/ch2ep1.rpy:4865
translate chinese gwencumback_8d489ff2:

    # k "I hate it! I hate that it's you!"
    k "我讨厌这样！我讨厌那个人是你！"

# game/ch2ep1.rpy:4866
translate chinese gwencumback_72deeb7d:

    # k "But I'm happy at the same time! Because whatever {i}this{/i} is, you make something in me feel so—"
    k "可我同时又很开心！因为不管这是什么感觉，你都让我觉得那么——"

# game/ch2ep1.rpy:4869
translate chinese gwencumback_40b816bc:

    # k "[mc], what is this? Tell me, because I don't know how to name it!"
    k "[mc!t]，这到底是怎么回事？求你告诉我吧，我自己真的不知道怎么说出来！"

# game/ch2ep1.rpy:4872
translate chinese gwencumback_ac3aa459:

    # mc "Klara..."
    mc "克拉拉……"

# game/ch2ep1.rpy:4873
translate chinese gwencumback_f7064fa1:

    # mc "You don't have to make sense of it right now."
    mc "你现在不用把这些都搞明白。"

# game/ch2ep1.rpy:4874
translate chinese gwencumback_7cf323f2:

    # k "When, then? When it's too late?"
    k "那要到什么时候？等到来不及的时候吗？"

# game/ch2ep1.rpy:4875
translate chinese gwencumback_b230145b:

    # mc "It's already too late for pretending. You feel it too—I know you do."
    mc "现在已经来不及再假装了。你也感觉到了，我很确定。"

# game/ch2ep1.rpy:4881
translate chinese gwencumback_261e9cdd:

    # mc "Whatever this is... I don't want to wreck it by saying the wrong thing."
    mc "这感觉很复杂……我不想说错话，毁掉一切。"

# game/ch2ep1.rpy:4882
translate chinese gwencumback_4552e2a4:

    # k "There isn't a \"right\" thing in any of this, [mc]."
    k "这所有的一切都是错的，[mc!t]。"

# game/ch2ep1.rpy:4883
translate chinese gwencumback_f36e5aec:

    # mc "Exactly."
    mc "确实如此。"

# game/ch2ep1.rpy:4886
translate chinese gwencumback_b70d43ae:

    # mc "Look, I'm not running. But if I stay any longer, I'll just..."
    mc "我不是想逃跑。只是如果我继续留在这，我也只会……"

# game/ch2ep1.rpy:4887
translate chinese gwencumback_89e42fcf:

    # mc "... make a bigger mess."
    mc "……闯出更大的祸。"

# game/ch2ep1.rpy:4888
translate chinese gwencumback_4dcadbc8:

    # k "You already did. {b}We{/b} already did."
    k "你已经闯祸了。{b}我们{/b}都已经闯祸了。"

# game/ch2ep1.rpy:4892
translate chinese gwencumback_69c25b65_1:

    # mc "Yeah..."
    mc "是啊……"

# game/ch2ep1.rpy:4893
translate chinese gwencumback_876c1655:

    # mc "Sky's making dinner. Try to rest, if you can. I'll be here in the morning."
    mc "斯凯正在做晚饭。你尽量多休息一下吧。我明早再来。"

# game/ch2ep1.rpy:4899
translate chinese gwencumback_1cf7018f:

    # mc "And, Klara..."
    mc "还有，克拉拉……"

# game/ch2ep1.rpy:4902
translate chinese gwencumback_9d434d60:

    # mc "Whatever you think this is... you're not the only one feeling it."
    mc "不管你认为这是什么感觉……有这些想法的不止你一个人。"

# game/ch2ep1.rpy:4918
translate chinese gwencumback_6c706d5b:

    # mc "\"You don't have to make sense of it right now.\""
    mc "“你现在不用把这些都搞明白。”"

# game/ch2ep1.rpy:4921
translate chinese gwencumback_92c8f66c:

    # mc "Yeah... right."
    mc "呵……真对。"

# game/ch2ep1.rpy:4926
translate chinese gwencumback_5d9a6e2b:

    # mc "Damn. Figures. All this rain has to land somewhere."
    mc "妈的。就知道。到处都是雨。"

# game/ch2ep1.rpy:4929
translate chinese gwencumback_f3c6d61f:

    # mc "\"Whatever you think this is... you're not the only one feeling it.\""
    mc "“不管你认为这是什么感觉……有这些想法的不止你一个人。”"

# game/ch2ep1.rpy:4930
translate chinese gwencumback_dd1f9606:

    # mc "*mutters* Brilliant. Real fucking smooth."
    mc "*嘟囔* 真厉害。太他妈会说话了。"

# game/ch2ep1.rpy:4934
translate chinese gwencumback_0bd82ba3:

    # mc "Just one night where my head shuts up. Please."
    mc "只要让我的脑子消停一晚就好。拜托了。"

# game/ch2ep1.rpy:4937
translate chinese gwencumback_7c59c734:

    # mc "Don't... send me back... to that white room..."
    mc "不要……再让我……回那个……"

# game/ch2ep1.rpy:4940
translate chinese gwencumback_8dc08b77:

    # mc "... again."
    mc "……白房间了……"

# game/ch2ep1.rpy:4959
translate chinese gwencumback_df3ae27a:

    # k "{i}Something's off...{/i}"
    k "{i}有什么地方不对劲……{/i}"

# game/ch2ep1.rpy:4960
translate chinese gwencumback_a161cd81:

    # k "{i}Do I call him? What do I—{/i}"
    k "{i}我直接给他打电话？可我该——{/i}"

# game/ch2ep1.rpy:4972
translate chinese gwencumback_82091822_5:

    # k "..."
    k "……"

# game/ch2ep1.rpy:4973
translate chinese gwencumback_b7a8d42b:

    # k "{i}He's just within arm's reach. He's right there... in the next room."
    k "{i}他离我非常近。就在那里……在隔壁房间。"

# game/ch2ep1.rpy:4974
translate chinese gwencumback_7ad11127:

    # k "{i}Why am I sitting here like this?"
    k "{i}为什么我还坐在这里？"

# game/ch2ep1.rpy:4993
translate chinese gwencumback_aa2e9d76:

    # k "{i}He's late.{/i}"
    k "{i}他迟到了。{/i}"

# game/ch2ep1.rpy:5015
translate chinese gwencumback_cb80ff17:

    # mc "H-hey... sorry... I—"
    mc "抱-抱歉……对不起啊……我——"

# game/ch2ep1.rpy:5021
translate chinese gwencumback_e88ec44d:

    # k "[mc]!"
    k "[mc!t]！"

# game/ch2ep1.rpy:5025
translate chinese gwencumback_3e6c251a:

    # k "[mc], you're burning up—"
    k "[mc!t]，你烧得好厉害——"

# game/ch2ep1.rpy:5034
translate chinese gwencumback_0e914231:

    # k "{i}I was so wrapped up in my own pain that I didn't even notice he was burning..."
    k "{i}我光顾着沉浸在自己的痛苦里，都没注意到他发烧了……"

# game/ch2ep1.rpy:5035
translate chinese gwencumback_7f401761:

    # k "{i}What's wrong with me...?"
    k "{i}我到底是怎么了……？"

# game/ch2ep1.rpy:5038
translate chinese gwencumback_f26727cc:

    # mc "*weak chuckle* Must've... left the window open."
    mc "*虚弱地笑* 肯定是……窗户没关严。"

# game/ch2ep1.rpy:5039
translate chinese gwencumback_2ea95f95:

    # k "There's a time for jokes, [mc]—and now isn't it! You shouldn't even be standing right now."
    k "之后再开玩笑吧，[mc!t]！你现在都不该继续站着。"

# game/ch2ep1.rpy:5040
translate chinese gwencumback_80a2bd6c:

    # mc "Told you I'd... be here in the morning."
    mc "我说了我……早上会来。"

# game/ch2ep1.rpy:5041
translate chinese gwencumback_f27fcd89:

    # k "This isn't morning: it's the middle of the damn night! What are you—"
    k "现在不是早上，是半夜啊！你这是——"

# game/ch2ep1.rpy:5042
translate chinese gwencumback_a4887acd:

    # mc "Close enough..."
    mc "也不差多少……"

# game/ch2ep1.rpy:5043
translate chinese gwencumback_4dfa0424:

    # k "I can't tell if you're trying to be funny, or if you're—"
    k "我都分不清你是在开玩笑还是你——"

# game/ch2ep1.rpy:5046
translate chinese gwencumback_3321d086:

    # k "Damn it, come here!"
    k "天啊，快过来！"

# game/ch2ep1.rpy:5047
translate chinese gwencumback_c2203d72:

    # k "Slowly. Don't talk."
    k "慢点。不要说话。"

# game/ch2ep1.rpy:5048
translate chinese gwencumback_ae1d6710:

    # mc "Didn't... want to worry you..."
    mc "不想……让你担心……"

# game/ch2ep1.rpy:5049
translate chinese gwencumback_57901e42:

    # k "Too late for that."
    k "我已经担心了。"

# game/ch2ep1.rpy:5057
translate chinese gwencumback_c0ae4bd9:

    # k "Hold on..."
    k "等一下……"

# game/ch2ep1.rpy:5061
translate chinese gwencumback_2e308fdb:

    # k "{i}Where the hell are my meds when I need them—"
    k "{i}这么要紧的时候，我的药都他妈跑到——"

# game/ch2ep1.rpy:5067
translate chinese gwencumback_82091822_6:

    # k "..."
    k "……"

# game/ch2ep1.rpy:5068
translate chinese gwencumback_0fcd2f59:

    # k "{i}Right..."
    k "{i}也对……"

# game/ch2ep1.rpy:5081
translate chinese gwencumback_40eed616:

    # k "{i}Someone. Please. Just one person awake at this hour—"
    k "{i}拜托。来个人吧。只要有一个人在这时候醒着——"

# game/ch2ep1.rpy:5087
translate chinese gwencumback_82091822_7:

    # k "..."
    k "……"

# game/ch2ep1.rpy:5088
translate chinese gwencumback_d4e8c2a9:

    # k "{i}What did I ever give him? A chair to sit on... a silent room... and a woman who never knew how to show up at the right time."
    k "{i}我给过他什么？一把能坐的椅子……一个沉默的房间……还有一个从来没法在对的时间伴他左右的女人。"

# game/ch2ep1.rpy:5089
translate chinese gwencumback_016c4df7:

    # k "{i}He was hurting, and I froze. Like I always do. Like my bones were carved for running and not standing beside anyone."
    k "{i}他如此痛苦，我却手足无措。我向来如此。好像我的身体只会逃跑，从来没办法陪伴别人。"

# game/ch2ep1.rpy:5090
translate chinese gwencumback_3fe24814:

    # k "{i}And still, he kept coming back. Every day. Like that meant something worth keeping."
    k "{i}尽管如此，他也一直会回来。每天都来。好像这是什么很有意义的事情。"

# game/ch2ep1.rpy:5093
translate chinese gwencumback_6687ddc2:

    # k "{i}I tell myself he deserves better... but that's not the truth, is it?"
    k "{i}我告诉自己他值得更好的人……可这并非事实吧？"

# game/ch2ep1.rpy:5094
translate chinese gwencumback_0a18f23a:

    # k "{i}The truth is... I don't know how to be better."
    k "{i}事实是……我不知道如何变得更好。"

# game/ch2ep1.rpy:5095
translate chinese gwencumback_a6032663:

    # k "{i}But he walked into my quiet and never flinched."
    k "{i}可他丝毫没有退缩，走进了我的沉默。"

# game/ch2ep1.rpy:5098
translate chinese gwencumback_5a9242d0:

    # k "{i}So maybe... maybe the least I can do is take one step back toward him."
    k "{i}那么，说不定……说不定我至少也可以向他靠近一步。"

# game/ch2ep1.rpy:5102
translate chinese gwencumback_6b2b99b6:

    # k "{i}If he can walk into my silence without fear..."
    k "{i}如果他可以毫无畏惧地闯进我的寂静……"

# game/ch2ep1.rpy:5103
translate chinese gwencumback_640847dd:

    # k "{i}Then I can stop treating these walls like they're sacred."
    k "{i}那我也可以不再把这些墙壁当做神圣之物。"

# game/ch2ep1.rpy:5106
translate chinese gwencumback_086fc60a:

    # k "{i}{sc}{font=Beowolf.ttf}Even if I have to tear these four walls down myself!"
    k "{i}{sc}{font=tl/chinese/font/XiangCuiLingDuHei.ttf}哪怕我要把这几面墙亲手毁掉！"

# game/ch2ep1.rpy:5109
translate chinese gwencumback_8cf83759:

    # k "Stay here. I'll be back."
    k "等我。我马上回来。"

# game/ch2ep1.rpy:5142
translate chinese gwencumback_1ba84fe5:

    # k "{i}If this is just coincidence... why does it feel like punishment?"
    k "{i}这是巧合……还是对我的惩罚呢？"

# game/ch2ep1.rpy:5157
translate chinese gwencumback_272e1019:

    # mc "... Not again..."
    mc "……又来……"

# game/ch2ep1.rpy:5160
translate chinese gwencumback_74a7e2b2:

    # eee "You keep coming back sooner each time."
    eee "你回来的间隔越来越短了。"

# game/ch2ep1.rpy:5161
translate chinese gwencumback_9973ddf7:

    # mc "Where am I this time—the real one, or here?"
    mc "我这次是在哪——是真的地方，还是这里？"

# game/ch2ep1.rpy:5164
translate chinese gwencumback_fc62b70c:

    # eee "You ask that like there's a real answer."
    eee "你明知道这问题并没有答案。"

# game/ch2ep1.rpy:5165
translate chinese gwencumback_6116a660:

    # mc "You said every step I take is a surrender. So what did I give up this time?"
    mc "你说过每一步都是一次屈服。我这次又放弃了什么？"

# game/ch2ep1.rpy:5168
translate chinese gwencumback_932c8293:

    # eee "A promise."
    eee "一个承诺。"

# game/ch2ep1.rpy:5169
translate chinese gwencumback_7250f4b6:

    # mc "To who?"
    mc "给谁的承诺？"

# game/ch2ep1.rpy:5170
translate chinese gwencumback_3e691e8c:

    # eee "To yourself. The one who swore to keep his distance."
    eee "给你自己的。你发过誓要保持距离。"

# game/ch2ep1.rpy:5171
translate chinese gwencumback_29f0146c:

    # mc "I never said that."
    mc "我从来没说过那话。"

# game/ch2ep1.rpy:5172
translate chinese gwencumback_78134a9e:

    # eee "Exactly."
    eee "正是如此。"

# game/ch2ep1.rpy:5175
translate chinese gwencumback_886f4048:

    # mc "I don't really get what you're trying to tell me."
    mc "我搞不懂你想对我说什么。"

# game/ch2ep1.rpy:5178
translate chinese gwencumback_c053f7e6:

    # eee "I told you before... what you face, I face. What you turn away from, I can't reach."
    eee "我跟你说过……你所面对的，即是我所面对的。而你转身回避的，我便无法企及。"

# game/ch2ep1.rpy:5179
translate chinese gwencumback_09185e09:

    # eee "Strange how it works: you move forward, and this place takes something from you in return."
    eee "这机制真是奇怪——你每前进一步，这个地方就会从你身上拿走一些东西。"

# game/ch2ep1.rpy:5182
translate chinese gwencumback_eb6f77a5:

    # eee "And the more you walk, the less of you there'll be to find." with Dissolve(2.0)
    eee "你走得越多，剩下的自我就越少。" with Dissolve(2.0)

# game/ch2ep1.rpy:5194
translate chinese gwencumback_f89ec6bb:

    # mc "*murmurs* ... Klara?"
    mc "*喃喃自语* ……克拉拉？"

# game/ch2ep1.rpy:5197
translate chinese gwencumback_aa66e2f1:

    # k "Careful. You'll spill it."
    k "小心点。别弄洒了。"

# game/ch2ep1.rpy:5201
translate chinese gwencumback_da6d39b8:

    # mc "Medicine?"
    mc "药吗？"

# game/ch2ep1.rpy:5202
translate chinese gwencumback_ccf7327a:

    # k "Just water. You were coughing. I already gave you your meds earlier, don't you remember?"
    k "只是水。你刚刚在咳嗽。我已经给你吃过药了，你忘了吗？"

# game/ch2ep1.rpy:5203
translate chinese gwencumback_2252dfa9:

    # mc "... Still a bit foggy."
    mc "……我脑子还不太清醒。"

# game/ch2ep1.rpy:5207
translate chinese gwencumback_44047af4:

    # k "Your fever dropped fast, but you scared the hell out of me. You always do."
    k "你退烧退得很快，但还是要把我吓死了。你总是这样。"

# game/ch2ep1.rpy:5208
translate chinese gwencumback_9b39a791:

    # mc "You went out... in the rain?"
    mc "你冒着雨……出去了？"

# game/ch2ep1.rpy:5209
translate chinese gwencumback_a422a370:

    # k "Please, don't make it sound so noble. You're my responsibility."
    k "不用把我说得那么高尚。照顾你是我的责任。"

# game/ch2ep1.rpy:5217
translate chinese gwencumback_7bbfb73c:

    # mc "You've been here the whole time?"
    mc "你一直都在旁边陪着我吗？"

# game/ch2ep1.rpy:5218
translate chinese gwencumback_df806840:

    # k "Mhm. Watching you like you might stop breathing at any second."
    k "嗯。一直看着你，生怕你下一秒就停止呼吸了。"

# game/ch2ep1.rpy:5221
translate chinese gwencumback_9fde4d07:

    # k "You talk in your sleep."
    k "你还说梦话了。"

# game/ch2ep1.rpy:5222
translate chinese gwencumback_c5c09466:

    # mc "That bad?"
    mc "这么严重？"

# game/ch2ep1.rpy:5223
translate chinese gwencumback_16c0ceca:

    # k "You kept saying my name."
    k "一直在说我的名字。"

# game/ch2ep1.rpy:5224
translate chinese gwencumback_4bbe5891:

    # mc "Sorry..."
    mc "对不起……"

# game/ch2ep1.rpy:5225
translate chinese gwencumback_f6e7223b:

    # k "Don't be. I don't hate hearing it."
    k "不必。我并不讨厌。"

# game/ch2ep1.rpy:5231
translate chinese gwencumback_23108cac:

    # k "When my parents died, I waited for something to break—a tear, a scream, anything. But nothing came."
    k "我父母死去的时候，我一直在等待着我的反应——眼泪，尖叫，什么都好。可最终什么都没有。"

# game/ch2ep1.rpy:5232
translate chinese gwencumback_33319508:

    # k "It felt like reading the news about strangers. I used to think that made me strong."
    k "感觉就像是在新闻里看到陌生人死去一样。我以前觉得那是我坚强的表现。"

# game/ch2ep1.rpy:5233
translate chinese gwencumback_7b255105:

    # k "Every time someone left, I just—"
    k "每次有人离开，我只会——"

# game/ch2ep1.rpy:5234
translate chinese gwencumback_6bc3248d:

    # k "*shaking her head* I just adjusted. Like grief was a room I redecorated every few years."
    k "*摇头* 我只会适应。好像悲伤只是每隔几年造访一次的老朋友。"

# game/ch2ep1.rpy:5237
translate chinese gwencumback_eb117294:

    # k "Except for one person."
    k "只有一个人是例外。"

# game/ch2ep1.rpy:5238
translate chinese gwencumback_69c25b65_2:

    # mc "Yeah..."
    mc "是啊……"

# game/ch2ep1.rpy:5241
translate chinese gwencumback_3810ac92:

    # k "It scares me because I don't know what that makes me."
    k "这让我很害怕，因为我不知道我这样算不算正常。"

# game/ch2ep1.rpy:5242
translate chinese gwencumback_072e712f:

    # k "Maybe I'm just wired wrong. Maybe I was never built for loving people the way they need."
    k "或许我就是不正常。或许我天生就不能用正常的方式爱别人。"

# game/ch2ep1.rpy:5243
translate chinese gwencumback_a3b0e19b:

    # k "Sometimes I wonder if I'm missing something people are born with—a pulse, a switch, whatever makes them care without trying."
    k "有时候我会疑惑，自己是不是缺失了一些别人与生俱来的东西——心跳也好，开关也好，总之就是能让他们不费力气就可以关心别人的事物。"

# game/ch2ep1.rpy:5244
translate chinese gwencumback_68a371fb:

    # k "And then you show up. Every damn day. Sitting here like I'm worth the wait."
    k "然后你出现了。每天都来。坐在这里，好像我值得你等待一样。"

# game/ch2ep1.rpy:5245
translate chinese gwencumback_c4bd8595:

    # k "You make me feel like I've been asleep my whole life."
    k "你让我觉得我这一生都在沉睡。"

# game/ch2ep1.rpy:5248
translate chinese gwencumback_d6d3414a:

    # k "You made time start moving again."
    k "你让时间又开始流动。"

# game/ch2ep1.rpy:5250
translate chinese gwencumback_636be723:

    # k "Just when I'd learned to live without it."
    k "就在我学会不靠那些也能活下去之后。"

# game/ch2ep1.rpy:5251
translate chinese gwencumback_fe67033a:

    # k "Just when I thought I'd buried the part of me that looked at you... differently."
    k "就在我以为我已经把对你有异样感觉的那部分埋葬之后。"

# game/ch2ep1.rpy:5261
translate chinese forbiddenfruit_7cdc6adf:

    # k "*whispers* I don't care anymore."
    k "*低语* 我已经不在乎了。"

# game/ch2ep1.rpy:5262
translate chinese forbiddenfruit_76c190e9:

    # k "I don't even need to understand it right now."
    k "我现在甚至根本都不需要理解这些。"

# game/ch2ep1.rpy:5263
translate chinese forbiddenfruit_ebf979ad:

    # k "All I know is I want this. I want you to {i}stay{/i}."
    k "我只知道我渴望这样。我想让你{i}留下{/i}。"

# game/ch2ep1.rpy:5266
translate chinese forbiddenfruit_56326364:

    # "Klara leans in—hesitant at first, like she's still asking permission. Her breath brushes yours before the space between you disappears."
    "克拉拉靠了过来——一开始有些犹豫，像是依旧在征求同意。然后你们之间的距离逐渐消失，她的呼吸开始拂过你的皮肤。"

# game/ch2ep1.rpy:5267
translate chinese forbiddenfruit_b223c977:

    # "Her hand finds your cheek, unsteady, but she doesn't pull away."
    "她的手触碰你的脸颊，有些许颤抖，但她没有松开。"

# game/ch2ep1.rpy:5271
translate chinese forbiddenfruit_9dedc1cb:

    # "She guides you down with the kind of care that feels learned, gentle, searching, and real."
    "她搀你躺下，举手投足间是一种经年累月的温柔，体贴又真诚。"

# game/ch2ep1.rpy:5272
translate chinese forbiddenfruit_aede3476:

    # "Her lips brush against yours—soft, steady, and tender, yet laced with a quiet hunger: a need she's too shy to name."
    "她的嘴唇掠过你的双唇——那触感轻柔又坚定，还带有一丝隐秘的饥渴，显然那是她羞于启齿的欲求。"

# game/ch2ep1.rpy:5275
translate chinese forbiddenfruit_329db200:

    # "You both pull away slowly, deliberately, as if the moment itself might shatter. It feels fragile—borrowed from a dream you're afraid to wake from."
    "你们两个缓慢又刻意的分开，好似这一刻会破碎一般。那感觉很脆弱——仿佛是从梦中借来的，而你又害怕从梦中醒来。"

# game/ch2ep1.rpy:5276
translate chinese forbiddenfruit_4b6c52a6:

    # "Still, a flicker of hesitation crosses your face."
    "然而，你的脸上还是有一丝犹豫。"

# game/ch2ep1.rpy:5279
translate chinese forbiddenfruit_05ba2bd6:

    # k "Tell me if you want me to stop."
    k "如果你想让我停下，就跟我说。"

# game/ch2ep1.rpy:5280
translate chinese forbiddenfruit_249bd282:

